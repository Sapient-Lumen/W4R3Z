environment.etc."bashrc.user".text = ''
[[ $- != *i* ]] && return

# paste-anything: disable history expansion so "!" doesn't explode
set +H

# history / ergonomics
shopt -s histappend checkwinsize cmdhist
shopt -s progcomp 2>/dev/null || true
export HISTSIZE=1000000
export HISTFILESIZE=2000000
export HISTCONTROL=ignoreboth:erasedups
export PROMPT_DIRTRIM=3

# prefer the system bashInteractive when you type "bash"
# (prevents accidentally running a non-readline bash from a profile earlier in PATH)
alias bash='/run/current-system/sw/bin/bash'

# your PATH extras (root stays clean via environment.shellInit)
export PATH="$PATH:$HOME/bin:$HOME/scripts:$HOME/admin/junest/bin"
export EDITOR=micro
export VISUAL=micro

# ---------- /etc/bashrc.user.d snippets ----------
if [[ -d /etc/bashrc.user.d ]]; then
  shopt -s nullglob
  for f in /etc/bashrc.user.d/*.sh; do
    source "$f"
  done
  shopt -u nullglob
fi

# ---------- “easy flip” controls ----------
panic() { exec bash --noprofile --norc; }

# ---------- helpers ----------
#@MNX-PART id=30.40.bashrc.user.function.ks_rt_to_ms kind=function title="Function __ks_rt_to_ms"
__ks_rt_to_ms() {
  local rt="$1" s us
  s="''${rt%.*}"
  us="''${rt#*.}"
  us="''${us:0:6}"
  [[ "''${us}" == "''${rt}" ]] && us="0"
  REPLY=$((10#''${s} * 1000 + 10#''${us} / 1000))
}

#@MNX-PART id=30.40.bashrc.user.function.ks_fmt_ms kind=function title="Function __ks_fmt_ms"
__ks_fmt_ms() {
  local ms="$1"
  if (( ms < 1000 )); then REPLY="''${ms}ms"; return; fi
  local s=$((ms/1000)) r=$((ms%1000))
  if (( s < 60 )); then REPLY="''${s}.''${r:0:1}s"; return; fi
  local m=$((s/60)) rs=$((s%60))
  REPLY="''${m}m''${rs}s"
}

# ---------- Starship prompt ----------
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

# ---------- zoxide ----------
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi

# avoid accidental ';;' in PROMPT_COMMAND when multiple tools append
while [[ "''${PROMPT_COMMAND-}" == *";;"* ]]; do
  PROMPT_COMMAND="''${PROMPT_COMMAND//;;/; }"
done

# ---------- tealdeer shortcuts ----------
alias tldr-update='tldr --update'
alias tldr-clear='tldr --clear-cache'
h() { tldr "$1" 2>/dev/null || man "$1"; }

# ---------- navi widget ----------
command -v navi >/dev/null 2>&1 && source <(navi widget bash)

# ---------- Atuin ----------
command -v atuin >/dev/null 2>&1 && eval "$(atuin init bash)"

# ---------- carapace completions (only if bash supports `complete`) ----------
if type complete >/dev/null 2>&1 && command -v carapace >/dev/null 2>&1; then
  source <(carapace _carapace bash)
fi

# ---------- fzf (readline keybinds/completion, only if bash supports `bind`) ----------
#@MNX-PART id=30.40.bashrc.user.function.init_fzf_readline kind=function title="Function __init_fzf_readline"
__init_fzf_readline() {
  type bind >/dev/null 2>&1 || return 0
  if command -v fzf-share >/dev/null 2>&1; then
    source "$(fzf-share)/completion.bash"
    source "$(fzf-share)/key-bindings.bash"
    export FZF_DEFAULT_COMMAND='fd --hidden --follow --exclude .git'

    # if atuin exists, put it on Ctrl-R
    if command -v atuin >/dev/null 2>&1; then
      __atuin_history() { atuin search -i; }
      bind -x '"\C-r":__atuin_history'
    fi
  fi
}

  # ---------- Accurate timers (no ble.sh; no PS0; no stdout spew) ----------
  # Opt-in long-command notification:
  #   export LONGCMD_NOTIFY=1
  # Optional threshold (seconds, default 10):
  #   export LONGCMD_SECS=10

  __ks_start=""
  __ks_last_ms=0
  __ks_last_rc=0
  __ks_running=0

  #@MNX-PART id=30.40.bashrc.user.function.ks_maybe_longcmd_notify kind=function title="Function __ks_maybe_longcmd_notify"
  __ks_maybe_longcmd_notify() {
    [[ -z "''${LONGCMD_NOTIFY-}" ]] && return 0
    local th="''${LONGCMD_SECS-10}"
    local s=$(( __ks_last_ms / 1000 ))
    (( s >= th )) || return 0
    printf '\a' 2>/dev/null || true
  }

  #@MNX-PART id=30.40.bashrc.user.function.ks_fmt_ms-2 kind=function title="Function __ks_fmt_ms"
  __ks_fmt_ms() {
    # input ms -> REPLY like 12ms / 1.234s / 2m03s
    local ms="$1"
    if (( ms < 1000 )); then REPLY="''${ms}ms"; return; fi
    local s=$((ms/1000)) r=$((ms%1000))
    if (( s < 60 )); then REPLY="''${s}.''${r:0:3}s"; return; fi
    local m=$((s/60)) ss=$((s%60))
    REPLY="''${m}m''${ss}s"
  }

  #@MNX-PART id=30.40.bashrc.user.function.ks_postcmd kind=function title="Function __ks_postcmd"
  __ks_postcmd() {
    local rc=$?
    __ks_last_rc=$rc
    local end="''${EPOCHREALTIME}"
    local s="''${end%.*}" us="''${end#*.}"
    local s0="''${__ks_start%.*}" us0="''${__ks_start#*.}"
    us="''${us:0:6}"; us0="''${us0:0:6}"
    local end_ms=$((10#''${s}*1000 + 10#''${us}/1000))
    local start_ms=$((10#''${s0}*1000 + 10#''${us0}/1000))
    __ks_last_ms=$(( end_ms - start_ms ))
    __ks_running=0

    __ks_fmt_ms "''${__ks_last_ms}"
    export KS_LAST="⏱ ''${REPLY} rc:''${rc}"
    __ks_maybe_longcmd_notify
  }

  #@MNX-PART id=30.40.bashrc.user.function.ks_pc_prepend kind=function title="Function __ks_pc_prepend"
  __ks_pc_prepend() {
    # Prepend a command to PROMPT_COMMAND without creating ";;" sequences.
    local add="$1"
    local pc="''${PROMPT_COMMAND-}"

    # trim leading/trailing whitespace/semicolons
    pc="''${pc#''${pc%%[![:space:];]*}}"
    pc="''${pc%''${pc##*[![:space:];]}}"

    if [[ -n "''${pc}" ]]; then
      PROMPT_COMMAND="''${add}; ''${pc}"
    else
      PROMPT_COMMAND="''${add}"
    fi
  }

  #@MNX-PART id=30.40.bashrc.user.function.ks_has_postcmd kind=function title="Function __ks_has_postcmd"
  __ks_has_postcmd() {
    case " ''${PROMPT_COMMAND-} " in
      *"__ks_postcmd"*) return 0 ;;
    esac
    return 1
  }

  #@MNX-PART id=30.40.bashrc.user.function.ks_ensure_postcmd kind=function title="Function __ks_ensure_postcmd"
  __ks_ensure_postcmd() {
    __ks_has_postcmd && return 0
    __ks_pc_prepend '__ks_postcmd'
  }

  #@MNX-PART id=30.40.bashrc.user.function.ks_preexec kind=function title="Function __ks_preexec"
  __ks_preexec() {
    # Keep the postcmd hook installed even if user dotfiles overwrite PROMPT_COMMAND later.
    __ks_ensure_postcmd

    # don't treat our own plumbing as a "command"
    case "''${BASH_COMMAND}" in
      __ks_preexec|__ks_postcmd|__ks_pc_prepend|__ks_has_postcmd|__ks_ensure_postcmd) return 0 ;;
    esac

    [[ "''${__ks_running}" -eq 1 ]] && return 0
    __ks_running=1
    __ks_start="''${EPOCHREALTIME}"
  }

  # install hooks (and keep starship/zoxide PROMPT_COMMAND behavior intact)
  if type bind >/dev/null 2>&1 && type complete >/dev/null 2>&1; then
    __init_fzf_readline
  fi
  trap '__ks_preexec' DEBUG
  __ks_ensure_postcmd

'';

