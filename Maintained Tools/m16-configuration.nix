#@MNX-CHUNK id=80.20 slug=independent-file-jobs title="Independent publishing, copy, organizer, wake, cleanup, and archiver jobs"
#######################################################################################################
# SECTION 80 CONTINUED — INDEPENDENT FILE-HANDLING AND OPERATOR-SCHEDULED JOBS
#######################################################################################################

  #services.atd.enable = true;

  #########################################################################
  # Small, independent scheduled jobs
  #
  # Each job below is intentionally narrow and comment-outable on its own.
  # These replace the formerly active cron lines, giving each task journal logs,
  # dependency ordering, failure hooks, and less background spam.
  #########################################################################

#@MNX-CHUNK id=80.21 slug=hypertext-i2p-publisher title="Quiesced Hypertext to Java-I2P publisher"
#@MNX-DEF path=systemd.services.hypertext-i2p-sync section=80.21 role=service ordinal=242
  systemd.services.hypertext-i2p-sync = {
    description = "Quiesce and sync Hypertext h0p3 eepsite into the Java I2P docroot";
    wants = [ "i2p.service" "local-fs.target" ];
    after = [ "i2p.service" "local-fs.target" ];
    onFailure = [ "mnx-job-failure-notify@%n.service" ];
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Nice = 10;
      IOSchedulingClass = "idle";
      StandardOutput = "journal";
      StandardError = "journal";
      NoNewPrivileges = true;
      PrivateTmp = true;
      TimeoutStartSec = "10min";
    };
    path = [ pkgs.coreutils pkgs.findutils pkgs.rsync ];
    script = ''
      set -euo pipefail
      JOB_START="$(date +%s)"
      JOB_SKIPPED=0
      JOB_REASON=none
      CHANGES=""
      #@MNX-PART id=80.21.hypertext-i2p-sync.function.finish kind=function title="Function finish"
      finish() {
        rc="$?"
        [[ -z "$CHANGES" ]] || rm -f -- "$CHANGES"
        /etc/monsternix/bin/mnx-job-metric hypertext-i2p-sync "$rc" "$(( $(date +%s) - JOB_START ))" "$JOB_SKIPPED" "$JOB_REASON" || true
        exit "$rc"
      }
      trap finish EXIT

      SRC="/home/h0p3/syncs/hypertext-h0p3/h0p3-wiki-index.html/"
      DST="/var/lib/i2p/.i2p/eepsite/docroot/"

      if [[ ! -d "$SRC" ]]; then
        JOB_SKIPPED=1
        JOB_REASON=source-missing
        exit 0
      fi

      # MNX_HYPERTEXT_QUIESCENCE=5s
      # Syncthing/editors can publish this tree in bursts. Invocation is timer-only so raw
      # source inotify traffic never feeds PID 1; once invoked, keep this oneshot active until
      # the source fingerprint is stable for one five-second window, bounded to one minute.
      SOURCE_FINGERPRINT=""
      SOURCE_STABLE=0
      for attempt in $(seq 1 12); do
        NEXT_FINGERPRINT="$(
          find "$SRC" -xdev -printf '%P\0%y\0%s\0%T@\0' 2>/dev/null |
            sort -z |
            sha256sum |
            cut -d' ' -f1
        )"
        if [[ -n "$SOURCE_FINGERPRINT" && "$NEXT_FINGERPRINT" == "$SOURCE_FINGERPRINT" ]]; then
          SOURCE_STABLE=1
          break
        fi
        SOURCE_FINGERPRINT="$NEXT_FINGERPRINT"
        sleep 5
      done
      printf 'hypertext_source_quiescent=%s\n' "$SOURCE_STABLE"
      if (( SOURCE_STABLE == 0 )); then
        JOB_SKIPPED=1
        JOB_REASON=source-not-quiescent
        exit 0
      fi

      mkdir -p "$DST"
      CHANGES="$(mktemp)"
      rsync -acrn --delete --force --chown=i2p:i2p --itemize-changes --out-format='%i %n%L' "$SRC" "$DST" > "$CHANGES"

      if [[ ! -s "$CHANGES" ]]; then
        JOB_SKIPPED=1
        JOB_REASON=no-destination-changes
        exit 0
      fi

      printf 'hypertext_i2p_pending_changes=%s\n' "$(wc -l < "$CHANGES")"
      sed -n '1,80p' "$CHANGES"
      rsync -acr --delete --force --chown=i2p:i2p "$SRC" "$DST"
    '';
  };

#@MNX-DEF path=systemd.timers.hypertext-i2p-sync section=80.21 role=timer ordinal=243
  systemd.timers.hypertext-i2p-sync = {
    description = "Periodic Hypertext h0p3 eepsite sync without a PID-1 path-event feed";
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnBootSec = "5min";
      OnUnitActiveSec = "10min";
      RandomizedDelaySec = "1min";
      Persistent = false;
      Unit = "hypertext-i2p-sync.service";
    };
  };

#@MNX-CHUNK id=80.22 slug=configuration-admin-copy title="configuration.nix copy into the operator admin tree"
