      #@MNX-PART id=99.80.mnx-config-audit.phase.monster-key-integration kind=phase title="Phase: MONSTER KEY DEDICATED MOD3 PRESSLOG CONTROL"
      section 'MONSTER KEY DEDICATED MOD3 PRESSLOG CONTROL'
      MONSTER_KEY_FAIL_BEFORE="$FAIL"
      MONSTER_KEY_LIVE=/etc/monsternix/bin/mnx-monsterkey
      MONSTER_KEY_CLOSURE="$RUNNING_SYSTEM/etc/monsternix/bin/mnx-monsterkey"
      MONSTER_KEY_CLOSURE_RESOLVED="$(readlink -f -- "$MONSTER_KEY_CLOSURE" 2>/dev/null || true)"
      [[ -x "$MONSTER_KEY_LIVE" && -f "$MONSTER_KEY_LIVE" ]] || fail 'Monster Key live helper projection is missing'
      [[ -x "$MONSTER_KEY_CLOSURE" && -n "$MONSTER_KEY_CLOSURE_RESOLVED" && -f "$MONSTER_KEY_CLOSURE_RESOLVED" ]] || fail 'Monster Key closure projection is missing'
      case "$MONSTER_KEY_CLOSURE_RESOLVED" in /nix/store/*) ;; *) fail 'Monster Key closure projection resolves outside Nix store' ;; esac
      MONSTER_KEY_LIVE_SHA="$(sha256sum "$MONSTER_KEY_LIVE" 2>/dev/null | awk '{print $1}')"
      MONSTER_KEY_CLOSURE_SHA="$(sha256sum "$MONSTER_KEY_CLOSURE_RESOLVED" 2>/dev/null | awk '{print $1}')"
      MONSTER_KEY_LIVE_META="$(stat -Lc '%U:%G:%a' "$MONSTER_KEY_LIVE" 2>/dev/null || true)"
      printf 'monster_key_projection_sha256=%s metadata=%s\n' "$MONSTER_KEY_LIVE_SHA" "''${MONSTER_KEY_LIVE_META:-unreadable}"
      [[ "$MONSTER_KEY_LIVE_SHA" == "$MONSTER_KEY_CLOSURE_SHA" ]] || fail 'Monster Key live helper differs from its running closure member'
      [[ "$MONSTER_KEY_LIVE_META" == root:root:755 ]] || fail 'Monster Key live helper metadata differs'
      MONSTER_KEY_PUBLIC=/run/current-system/sw/bin/monsterkey
      MONSTER_KEY_PUBLIC_RESOLVED="$(readlink -f -- "$MONSTER_KEY_PUBLIC" 2>/dev/null || true)"
      [[ -x "$MONSTER_KEY_PUBLIC" && -f "$MONSTER_KEY_PUBLIC_RESOLVED" ]] || fail 'Monster Key public wrapper is missing'
      case "$MONSTER_KEY_PUBLIC_RESOLVED" in /nix/store/*) ;; *) fail 'Monster Key public wrapper resolves outside Nix store' ;; esac
      grep -Fq 'exec /etc/monsternix/bin/mnx-monsterkey "$@"' "$MONSTER_KEY_PUBLIC_RESOLVED" || fail 'Monster Key public wrapper delegation differs'
      MONSTER_KEY_SELF_TEST="$(MNX_MONSTERKEY_ALLOW_ROOT_FOR_TESTS=1 "$MONSTER_KEY_LIVE" self-test 2>&1)" || fail "Monster Key pure self-test failed: $MONSTER_KEY_SELF_TEST"
      printf '%s\n' "$MONSTER_KEY_SELF_TEST"
      for marker in \
        '# MNX_MONSTER_KEY_SCHEMA=1' \
        '# MNX_MONSTER_KEY_RUNTIME_SCHEMA=2' \
        '# MNX_MONSTER_KEY_ACTION_SCHEMA=1' \
        '# MNX_MONSTER_KEY_POLICY=caps-lock-is-donated-to-monsternix-in-h0p3-x11-as-hyper-l-mod3-with-no-caps-lock-toggle-and-no-super-alias' \
        '# MNX_MONSTER_KEY_BINDING_POLICY=mod3-plus-escape-release-edge-toggles-one-active-presslog-recorder-from-a-read-only-home-context-with-debounce-confirmed-transition-bounded-action-receipt-and-no-i3-file-edit' \
        '# MNX_MONSTER_KEY_NOTIFICATION_POLICY=confirmed-paused-and-recording-states-produce-local-screen-notice-every-attempt-publishes-bounded-current-service-action-truth-and-failure-never-invents-transition' \
        '# MNX_MONSTER_KEY_ENGINE_POLICY=python-xlib-direct-core-mapping-xkb-lock-control-and-passive-grab-no-xkbcomp-xmodmap-or-sxhkd' \
        '# MNX_MONSTER_KEY_LIVE_MAP_POLICY=system-manager-runs-one-h0p3-python-xlib-service-with-direct-keycode66-mod3-mapping-passive-escape-grab-and-caps-only-rollback' \
        '# MNX_MONSTER_KEY_ACTIVATION_POLICY=type-simple-service-stays-active-with-explicit-ready-or-review-runtime-state-restart-no-immutable-exec-path-and-rollback-safe-caps-restoration' \
        '# MNX_MONSTER_KEY_ROLLBACK_POLICY=pre-service-keysyms-modifier-membership-and-lock-latch-restored-without-full-map-replay-synthetic-input-or-restart-tombstone' \
        '#@MNX-FLOW id=monster-key-presslog-control ' \
        '#@MNX-LAW id=monster-key-is-dedicated-monsternix-modifier '; do
        grep -Fq "$marker" "$CFG" || fail "Monster Key source contract is missing: $marker"
      done
      grep -Fq 'services.xserver.xkb.layout = "us";' "$CFG" || fail 'Monster Key changed the operator keyboard layout instead of applying a surgical Caps overlay'
      grep -Eq '^#@MNX-DEF path=systemd[.]services[.]mnx-monsterkey ' "$CFG" || fail 'Monster Key transaction-owned system service definition is missing'
      if grep -Eq '^#@MNX-DEF path=systemd[.]user[.]services[.]mnx-monsterkey ' "$CFG"; then
        fail 'Monster Key regained the user-unit-only activation path that stayed inactive in a live session'
      fi
      grep -Fq 'from Xlib import X, XK' "$MONSTER_KEY_LIVE" || fail 'Monster Key direct X11 client is missing'
      grep -Fq 'change_keyboard_mapping' "$MONSTER_KEY_LIVE" || fail 'Monster Key direct keycode mapping path is missing'
      grep -Fq 'set_modifier_mapping' "$MONSTER_KEY_LIVE" || fail 'Monster Key direct modifier-map path is missing'
      grep -Fq 'XkbLockModifiers' "$MONSTER_KEY_LIVE" || fail 'Monster Key Caps latch control is missing'
      grep -Fq 'root.grab_key(' "$MONSTER_KEY_LIVE" || fail 'Monster Key passive Escape grab is missing'
      grep -Fq 'event.type == X.KeyRelease' "$MONSTER_KEY_LIVE" || fail 'Monster Key release-edge event gate is missing'
      grep -Fq 'status="review-required"' "$MONSTER_KEY_LIVE" || fail 'Monster Key startup review-state publication is missing'
      grep -Fq 'MNX_MONSTER_KEY_PYTHON_XLIB_IMPORT_SELF_TEST=PASS' "$MONSTER_KEY_LIVE" || fail 'Monster Key Python-Xlib import witness is missing'
      grep -Fq 'MNX_MONSTER_KEY_PYTHON_XLIB_IMPORT_SELF_TEST=PASS' <<<"$MONSTER_KEY_SELF_TEST" || fail 'Monster Key Python-Xlib import self-test did not pass'
      grep -Fq 'MNX_MONSTER_KEY_DIRECT_X11_MAPPING_SELF_TEST=PASS' "$MONSTER_KEY_LIVE" || fail 'Monster Key direct-map witness is missing'
      grep -Fq 'MNX_MONSTER_KEY_CAPS_LATCH_SELF_TEST=PASS' "$MONSTER_KEY_LIVE" || fail 'Monster Key lock-latch witness is missing'
      grep -Fq 'MNX_MONSTER_KEY_PASSIVE_GRAB_SELF_TEST=PASS' "$MONSTER_KEY_LIVE" || fail 'Monster Key passive-grab witness is missing'
      grep -Fq 'MNX_MONSTER_KEY_SHARED_MODIFIER_PRESERVATION_SELF_TEST=PASS' "$MONSTER_KEY_LIVE" || fail 'Monster Key shared-modifier preservation witness is missing'
      grep -Fq 'MNX_MONSTER_KEY_SYSTEM_SERVICE_SELF_TEST=PASS' "$MONSTER_KEY_LIVE" || fail 'Monster Key system-service witness is missing'
      grep -Fq 'monster_key_unrelated_live_xkb_changes_preserved=yes' "$MONSTER_KEY_LIVE" || fail 'Monster Key helper no longer proves unrelated keymap preservation'
      grep -Fq '[str(PRESSLOG), "toggle"]' "$MONSTER_KEY_LIVE" || fail 'Monster Key helper no longer dispatches the Presslog toggle command'
      grep -Fq 'PRESSLOG_CONTROL_CONTEXT' "$MONSTER_KEY_LIVE" || fail 'Monster Key helper does not declare its read-only-home Presslog context'
      grep -Fq 'ACTION_SCHEMA = "mnx.monster-key.action.v1"' "$MONSTER_KEY_LIVE" || fail 'Monster Key action receipt schema is missing'
      grep -Fq 'def write_action_receipt' "$MONSTER_KEY_LIVE" || fail 'Monster Key bounded action receipt writer is missing'
      grep -Fq 'MNX_MONSTER_KEY_ACTION_RECEIPT_SELF_TEST=PASS' <<<"$MONSTER_KEY_SELF_TEST" || fail 'Monster Key action receipt self-test did not pass'
      grep -Fq 'MNX_MONSTER_KEY_READ_ONLY_HOME_CONTROL_SELF_TEST=PASS' <<<"$MONSTER_KEY_SELF_TEST" || fail 'Monster Key read-only-home control self-test did not pass'
      grep -Fq 'MONSTER KEY + ESC: recording OFF' "$MONSTER_KEY_LIVE" || fail 'Monster Key paused-state notice is missing'
      grep -Fq 'MONSTER KEY + ESC: recording ON' "$MONSTER_KEY_LIVE" || fail 'Monster Key recording-state notice is missing'
      ! grep -Fq 'XKBCOMP = Path(' "$MONSTER_KEY_LIVE" || fail 'Monster Key regained full-map xkbcomp machinery'
      ! grep -Fq 'XMODMAP = Path(' "$MONSTER_KEY_LIVE" || fail 'Monster Key regained xmodmap parsing machinery'
      ! grep -Fq 'SXHKD = Path(' "$MONSTER_KEY_LIVE" || fail 'Monster Key regained the separate sxhkd listener'
      ! grep -Fq 'notify_systemd' "$MONSTER_KEY_LIVE" || fail 'Monster Key regained Type=notify readiness coupling'
      ! grep -Fq 'from Xlib.ext import xtest' "$MONSTER_KEY_LIVE" || fail 'Monster Key acceptance helper gained synthetic-input authority'
      ! grep -Fq 'fake_input(' "$MONSTER_KEY_LIVE" || fail 'Monster Key acceptance helper gained synthetic-input authority'
      grep -Fq 'command_toggle' /etc/monsternix/bin/presslog || fail 'Presslog wrapper lacks the Monster Key toggle target'
      grep -Fq 'PRESSLOG_TOGGLE=PASS' /etc/monsternix/bin/presslog || fail 'Presslog wrapper lacks confirmed toggle completion'

      MONSTER_KEY_SERVICE_FAIL_BEFORE="$FAIL"
      MONSTER_KEY_LOAD="$(systemctl show mnx-monsterkey.service -p LoadState --value 2>/dev/null || true)"
      MONSTER_KEY_ACTIVE="$(systemctl show mnx-monsterkey.service -p ActiveState --value 2>/dev/null || true)"
      MONSTER_KEY_SUB="$(systemctl show mnx-monsterkey.service -p SubState --value 2>/dev/null || true)"
      MONSTER_KEY_RESULT="$(systemctl show mnx-monsterkey.service -p Result --value 2>/dev/null || true)"
      MONSTER_KEY_PID="$(systemctl show mnx-monsterkey.service -p MainPID --value 2>/dev/null || true)"
      MONSTER_KEY_EXEC="$(systemctl show mnx-monsterkey.service -p ExecStart --value 2>/dev/null || true)"
      MONSTER_KEY_EXEC_STOP_POST="$(systemctl show mnx-monsterkey.service -p ExecStopPost --value 2>/dev/null || true)"
      MONSTER_KEY_USER="$(systemctl show mnx-monsterkey.service -p User --value 2>/dev/null || true)"
      MONSTER_KEY_TYPE="$(systemctl show mnx-monsterkey.service -p Type --value 2>/dev/null || true)"
      MONSTER_KEY_RESTART="$(systemctl show mnx-monsterkey.service -p Restart --value 2>/dev/null || true)"
      MONSTER_KEY_RUNTIME_PRESERVE="$(systemctl show mnx-monsterkey.service -p RuntimeDirectoryPreserve --value 2>/dev/null || true)"
      MONSTER_KEY_PROTECT_HOME="$(systemctl show mnx-monsterkey.service -p ProtectHome --value 2>/dev/null || true)"
      MONSTER_KEY_PROTECT_SYSTEM="$(systemctl show mnx-monsterkey.service -p ProtectSystem --value 2>/dev/null || true)"
      MONSTER_KEY_RUNTIME_DIRECTORY="$(systemctl show mnx-monsterkey.service -p RuntimeDirectory --value 2>/dev/null || true)"
      printf 'monster_key_service_manager=system load=%s active=%s sub=%s result=%s pid=%s user=%s type=%s restart=%s runtime_directory_preserve=%s protect_home=%s protect_system=%s runtime_directory=%s\n' "$MONSTER_KEY_LOAD" "$MONSTER_KEY_ACTIVE" "$MONSTER_KEY_SUB" "$MONSTER_KEY_RESULT" "$MONSTER_KEY_PID" "$MONSTER_KEY_USER" "$MONSTER_KEY_TYPE" "$MONSTER_KEY_RESTART" "$MONSTER_KEY_RUNTIME_PRESERVE" "$MONSTER_KEY_PROTECT_HOME" "$MONSTER_KEY_PROTECT_SYSTEM" "$MONSTER_KEY_RUNTIME_DIRECTORY"
      [[ "$MONSTER_KEY_LOAD" == loaded && "$MONSTER_KEY_ACTIVE" == active && "$MONSTER_KEY_SUB" == running && "$MONSTER_KEY_RESULT" == success && "$MONSTER_KEY_PID" =~ ^[1-9][0-9]*$ ]] || fail 'Monster Key transaction-owned system service is not healthy and active'
      [[ "$MONSTER_KEY_USER" == h0p3 ]] || fail 'Monster Key system service does not run as h0p3'
      [[ "$MONSTER_KEY_TYPE" == simple && "$MONSTER_KEY_RESTART" == no ]] || fail 'Monster Key service may create an activation failure or automatic-restart tombstone'
      [[ "$MONSTER_KEY_RUNTIME_PRESERVE" == yes ]] || fail 'Monster Key rollback snapshot is not retained for bounded recovery'
      [[ "$MONSTER_KEY_PROTECT_HOME" == read-only ]] || fail 'Monster Key service lost its read-only home boundary'
      [[ "$MONSTER_KEY_PROTECT_SYSTEM" == strict ]] || fail 'Monster Key service lost its strict system boundary'
      [[ "$MONSTER_KEY_RUNTIME_DIRECTORY" == *monsternix-monsterkey* ]] || fail 'Monster Key service lost its dedicated writable RuntimeDirectory'
      MONSTER_KEY_UNIT_FRAGMENT="$(systemctl cat mnx-monsterkey.service 2>/dev/null || true)"
      ! grep -Fq 'ReadWritePaths=/home/h0p3/.local/state/presslog' <<<"$MONSTER_KEY_UNIT_FRAGMENT" || fail 'Monster Key service gained a writable Presslog-home exception'
      ! grep -Fq 'ReadWritePaths=/run/user/1000/monsternix' <<<"$MONSTER_KEY_UNIT_FRAGMENT" || fail 'Monster Key service gained a writable user-runtime exception instead of its RuntimeDirectory'
      MONSTER_KEY_EXPECTED_SOURCE=${config.environment.etc."monsternix/bin/mnx-monsterkey".source}
      grep -Fq "$MONSTER_KEY_EXPECTED_SOURCE" <<<"$MONSTER_KEY_EXEC" || fail 'Monster Key ExecStart is not the current immutable source-owned helper'
      grep -Fq "$MONSTER_KEY_EXPECTED_SOURCE" <<<"$MONSTER_KEY_EXEC_STOP_POST" || fail 'Monster Key ExecStopPost is not the current immutable source-owned restore helper'
      grep -Fq 'X-Restart-Triggers=' <<<"$MONSTER_KEY_UNIT_FRAGMENT" || fail 'Monster Key unit lacks an immutable-helper restart trigger'
      MONSTER_KEY_STATE=/run/monsternix-monsterkey/state.json
      MONSTER_KEY_STATE_META="$(stat -Lc '%U:%G:%a:%s' "$MONSTER_KEY_STATE" 2>/dev/null || true)"
      printf 'monster_key_runtime_state=%s\n' "''${MONSTER_KEY_STATE_META:-missing}"
      [[ "$MONSTER_KEY_STATE_META" =~ ^h0p3:[^:]+:600:[1-9][0-9]+$ ]] || fail 'Monster Key runtime state is absent or unsafe'
      if [[ "$MONSTER_KEY_PID" =~ ^[1-9][0-9]*$ && -f "$MONSTER_KEY_STATE" && ! -L "$MONSTER_KEY_STATE" ]]; then
        ${pkgs.jq}/bin/jq -e --argjson pid "$MONSTER_KEY_PID" --arg program "$MONSTER_KEY_EXPECTED_SOURCE" --arg build "stage121-kodi-generation-v4" --arg receipt_schema "mnx.kodi.output-follow.v4" '.schema == "mnx.monster-key.runtime.v2" and .pid == $pid and .ready == true and .status == "active" and .error == "none" and .keycode == 66 and .keysym == "Hyper_L" and .modifier == "Mod3" and .binding == "release:mod3+Escape" and (.key_grab_count | type == "number" and . >= 1) and .program_path == $program and .guardian_build_revision == $build and .kodi_output_receipt_schema == $receipt_schema' "$MONSTER_KEY_STATE" >/dev/null || fail 'Monster Key runtime state is not ready, PID-bound, and current-program-bound'
      fi
      MONSTER_KEY_ACTION=/run/monsternix-monsterkey/last-action.json
      if [[ -e "$MONSTER_KEY_ACTION" || -L "$MONSTER_KEY_ACTION" ]]; then
        MONSTER_KEY_ACTION_META="$(stat -Lc '%U:%G:%a:%s' "$MONSTER_KEY_ACTION" 2>/dev/null || true)"
        printf 'monster_key_last_action=%s\n' "''${MONSTER_KEY_ACTION_META:-unsafe}"
        [[ "$MONSTER_KEY_ACTION_META" =~ ^h0p3:[^:]+:600:[1-9][0-9]+$ && -f "$MONSTER_KEY_ACTION" && ! -L "$MONSTER_KEY_ACTION" ]] || fail 'Monster Key action receipt is unsafe'
        ${pkgs.jq}/bin/jq -e '.schema == "mnx.monster-key.action.v1" and (.service_pid | type == "number" and . > 0) and (.dispatcher_pid | type == "number" and . > 0) and (.source == "mod3-escape-release" or .source == "manual-command") and (.outcome == "pass" or .outcome == "review" or .outcome == "fail") and (.action == "pause" or .action == "resume" or .action == "none") and (.paused == null or (.paused | type == "boolean")) and (.presslog_rc | type == "number") and (.notification == "shown" or .notification == "failed" or .notification == "not-attempted") and (.detail | type == "string" and length > 0 and length <= 96)' "$MONSTER_KEY_ACTION" >/dev/null || fail 'Monster Key action receipt contract differs'
      else
        echo 'monster_key_last_action=none'
      fi
      KODI_OUTPUT_RECEIPT=/run/monsternix-monsterkey/kodi-output.json
      if [[ -e "$KODI_OUTPUT_RECEIPT" || -L "$KODI_OUTPUT_RECEIPT" ]]; then
        KODI_OUTPUT_RECEIPT_META="$(stat -Lc '%U:%G:%a:%s' "$KODI_OUTPUT_RECEIPT" 2>/dev/null || true)"
        printf 'kodi_output_follow_receipt_metadata=%s\n' "''${KODI_OUTPUT_RECEIPT_META:-unsafe}"
        [[ "$KODI_OUTPUT_RECEIPT_META" =~ ^h0p3:[^:]+:600:([1-9][0-9]*)$ && -f "$KODI_OUTPUT_RECEIPT" && ! -L "$KODI_OUTPUT_RECEIPT" ]] || fail 'Kodi output-follow receipt is unsafe'
        (( ''${BASH_REMATCH[1]} <= 65536 )) || fail 'Kodi output-follow receipt exceeds the 64 KiB bound'
        KODI_OUTPUT_RECEIPT_SCHEMA_VALUE="$(${pkgs.jq}/bin/jq -r '.schema // ""' "$KODI_OUTPUT_RECEIPT" 2>/dev/null || true)"
        case "$KODI_OUTPUT_RECEIPT_SCHEMA_VALUE" in
          mnx.kodi.output-follow.v4)
            ${pkgs.jq}/bin/jq -e --argjson pid "$MONSTER_KEY_PID" --arg program "$MONSTER_KEY_EXPECTED_SOURCE" --arg build "stage121-kodi-generation-v4" '
              .schema == "mnx.kodi.output-follow.v4"
              and .service_pid == $pid
              and .guardian_program == $program
              and .guardian_build_revision == $build
              and (.status == "baseline" or .status == "pass" or .status == "review")
              and (.event == "initial-observation" or .event == "cross-output")
              and (.target_output | type == "string" and length > 0 and length <= 64)
              and (.target_mode | type == "string" and length > 0 and length <= 32)
              and (.fullscreen_before | type == "boolean")
              and (.fullscreen_current_observed | type == "boolean")
              and (.fullscreen_prior_observed == null or (.fullscreen_prior_observed | type == "boolean"))
              and (.fullscreen_prior_identity_matched | type == "boolean")
              and (.fullscreen_prior_observation_age_seconds == null or ((.fullscreen_prior_observation_age_seconds | type) == "number" and .fullscreen_prior_observation_age_seconds >= 0 and .fullscreen_prior_observation_age_seconds <= 3600))
              and (.fullscreen_reentry_authority == "initial-current-state" or .fullscreen_reentry_authority == "current-x11-state" or .fullscreen_reentry_authority == "prior-same-window-fullscreen-observation" or .fullscreen_reentry_authority == "none")
              and (.fullscreen_cycle_attempted | type == "boolean")
              and (.fullscreen_removed | type == "boolean")
              and (.fullscreen_restored | type == "boolean")
              and (.target_geometry_matched | type == "boolean")
              and ((.target_window_coverage_ratio | type) == "number" and .target_window_coverage_ratio >= 0 and .target_window_coverage_ratio <= 1)
              and ((.target_output_coverage_ratio | type) == "number" and .target_output_coverage_ratio >= 0 and .target_output_coverage_ratio <= 1)
              and (.fullscreen_like_geometry | type == "boolean")
              and (if .event == "initial-observation" then .fullscreen_reentry_authority == "initial-current-state" else true end)
              and (if .fullscreen_reentry_authority == "prior-same-window-fullscreen-observation" then (.fullscreen_prior_observed == true and .fullscreen_prior_identity_matched == true and .fullscreen_cycle_attempted == true) else true end)
              and .qbittorrent_mutated == false
              and .i3_configuration_mutated == false
              and .kodi_configuration_mutated == false
              and .display_layout_mutated == false
              and .synthetic_input_used == false
            ' "$KODI_OUTPUT_RECEIPT" >/dev/null || fail 'Kodi v4 current-generation output-follow receipt contract differs'
            echo 'kodi_output_follow_runtime_legacy=false'
            ;;
          mnx.kodi.output-follow.v2|mnx.kodi.output-follow.v3)
            fail 'Kodi output-follow receipt belongs to a prior guardian generation'
            ;;
          *) fail 'Kodi output-follow receipt schema differs' ;;
        esac
        printf 'kodi_output_follow_runtime_schema=%s\n' "$KODI_OUTPUT_RECEIPT_SCHEMA_VALUE"
        printf 'kodi_output_follow_runtime=%s\n' "$(${pkgs.jq}/bin/jq -cS . "$KODI_OUTPUT_RECEIPT")"
      else
        echo 'kodi_output_follow_runtime_schema=none'
        echo 'kodi_output_follow_runtime=none'
      fi
      if (( FAIL == MONSTER_KEY_SERVICE_FAIL_BEFORE )); then
        echo 'MONSTER_KEY_SERVICE=PASS'
      else
        echo 'MONSTER_KEY_SERVICE=FAIL'
      fi

      MONSTER_KEY_X11_FAIL_BEFORE="$FAIL"
      MONSTER_KEY_UID="$(id -u h0p3 2>/dev/null || true)"
      MONSTER_KEY_USER_RUNTIME="/run/user/$MONSTER_KEY_UID"
      if [[ "$MONSTER_KEY_UID" =~ ^[0-9]+$ && -S "$MONSTER_KEY_USER_RUNTIME/bus" ]]; then
        MONSTER_KEY_ENV=(env HOME=/home/h0p3 DISPLAY=:0 XAUTHORITY=/home/h0p3/.Xauthority XDG_RUNTIME_DIR="$MONSTER_KEY_USER_RUNTIME" DBUS_SESSION_BUS_ADDRESS="unix:path=$MONSTER_KEY_USER_RUNTIME/bus" MNX_MONSTERKEY_RUNTIME_ROOT=/run/monsternix-monsterkey)
        MONSTER_KEY_X11="$(${pkgs.util-linux}/bin/runuser -u h0p3 -- "''${MONSTER_KEY_ENV[@]}" "$MONSTER_KEY_LIVE" x11-status 2>&1)" || fail "Monster Key live X11 map verification failed: $MONSTER_KEY_X11"
        printf '%s\n' "$MONSTER_KEY_X11"
        grep -Fxq 'keysym=Hyper_L' <<<"$MONSTER_KEY_X11" || fail 'Monster Key live Caps keysym differs'
        grep -Fxq 'modifier=Mod3' <<<"$MONSTER_KEY_X11" || fail 'Monster Key live modifier differs'
        grep -Fxq 'caps_lock_behavior=disabled' <<<"$MONSTER_KEY_X11" || fail 'Caps Lock behavior remains active'
        grep -Fxq 'caps_lock_latched=false' <<<"$MONSTER_KEY_X11" || fail 'Caps Lock remained latched after donation'
        grep -Fxq 'binding=release:mod3+Escape' <<<"$MONSTER_KEY_X11" || fail 'Monster Key live binding identity differs'
        MONSTER_KEY_SNAPSHOT=/run/monsternix-monsterkey/pre-monster-key.json
        MONSTER_KEY_SNAPSHOT_META="$(stat -Lc '%U:%G:%a:%s' "$MONSTER_KEY_SNAPSHOT" 2>/dev/null || true)"
        printf 'monster_key_pre_service_snapshot=%s\n' "''${MONSTER_KEY_SNAPSHOT_META:-missing}"
        [[ "$MONSTER_KEY_SNAPSHOT_META" =~ ^h0p3:[^:]+:600:[1-9][0-9]+$ ]] || fail 'Monster Key pre-service JSON snapshot is absent or unsafe'
        if [[ -f "$MONSTER_KEY_SNAPSHOT" && ! -L "$MONSTER_KEY_SNAPSHOT" ]]; then
          ${pkgs.jq}/bin/jq -e '.schema == "mnx.monster-key.snapshot.v2" and .keycode == 66 and (.keysyms | type == "array" and length >= 1 and length <= 32) and (.modifier_slots | type == "array") and (.lock_active | type == "boolean")' "$MONSTER_KEY_SNAPSHOT" >/dev/null || fail 'Monster Key pre-service JSON snapshot contract differs'
        fi
      else
        fail 'h0p3 user manager bus is unavailable for Monster Key notification and Presslog control verification'
      fi
      if (( FAIL == MONSTER_KEY_X11_FAIL_BEFORE )); then
        echo 'MONSTER_KEY_X11=PASS'
      else
        echo 'MONSTER_KEY_X11=FAIL'
      fi
      if (( FAIL == MONSTER_KEY_FAIL_BEFORE )); then
        echo 'MONSTER_KEY_SOURCE_POLICY=PASS'
        echo 'MNX_MONSTER_KEY_INTEGRATION=PASS'
      else
        echo 'MNX_MONSTER_KEY_INTEGRATION=FAIL'
      fi

      #@MNX-PART id=99.80.mnx-config-audit.phase.timer-old-storage-policy kind=phase title="Phase: TIMER / OLD-STORAGE POLICY"
      section 'TIMER / OLD-STORAGE POLICY'
      #@MNX-PART id=99.80.mnx-config-audit.function.show_timer_policy kind=function title="Function show_timer_policy"
      show_timer_policy() {
        local timer="$1"
        printf '%s active=%s sub=%s persistent=%s next=%s\n' \
          "$timer" \
          "$(systemctl show "$timer" -p ActiveState --value 2>/dev/null || true)" \
          "$(systemctl show "$timer" -p SubState --value 2>/dev/null || true)" \
          "$(systemctl show "$timer" -p Persistent --value 2>/dev/null || true)" \
          "$(systemctl show "$timer" -p NextElapseUSecRealtime --value 2>/dev/null || true)"
      }
      show_timer_policy mnx-storage-catchup.timer
      show_timer_policy mnx-logbook-prune.timer
      RAW_UPGRADE_ACTIVE="$(systemctl is-active nixos-upgrade.timer 2>/dev/null || true)"
      RAW_UPGRADE_ENABLED="$(systemctl is-enabled nixos-upgrade.timer 2>/dev/null || true)"
      printf 'raw_nixos_upgrade_timer_active=%s\n' "''${RAW_UPGRADE_ACTIVE:-unknown}"
      printf 'raw_nixos_upgrade_timer_enabled=%s\n' "''${RAW_UPGRADE_ENABLED:-unknown}"
      case "$RAW_UPGRADE_ACTIVE" in active|activating|reloading) fail 'raw nixos-upgrade.timer is active' ;; esac
      case "$RAW_UPGRADE_ENABLED" in enabled|enabled-runtime|linked|linked-runtime|alias) fail 'raw nixos-upgrade.timer is enabled' ;; esac
      [[ "$(systemctl show mnx-storage-catchup.timer -p ActiveState --value 2>/dev/null || true)" == active ]] || fail 'mnx-storage-catchup.timer is not active'
      [[ "$(systemctl show mnx-storage-catchup.timer -p SubState --value 2>/dev/null || true)" == waiting ]] || fail 'mnx-storage-catchup.timer is not waiting'
      case "$(systemctl show mnx-storage-catchup.timer -p Persistent --value 2>/dev/null || true)" in no|false|0) ;; *) fail 'mnx-storage-catchup.timer is unexpectedly persistent' ;; esac
      [[ "$(systemctl show mnx-logbook-prune.timer -p ActiveState --value 2>/dev/null || true)" == active ]] || fail 'mnx-logbook-prune.timer is not active'
      [[ "$(systemctl show mnx-logbook-prune.timer -p SubState --value 2>/dev/null || true)" == waiting ]] || fail 'mnx-logbook-prune.timer is not waiting'
      case "$(systemctl show mnx-logbook-prune.timer -p Persistent --value 2>/dev/null || true)" in yes|true|1) ;; *) fail 'mnx-logbook-prune.timer is unexpectedly non-persistent' ;; esac
      case "$(systemctl is-active duperemove-m16-old-storage.timer 2>/dev/null || true)" in active|activating|reloading) fail 'old-storage duperemove timer is active' ;; esac
      case "$(systemctl is-active 'btrfs-scrub-mnt-m16\x2dold\x2dstorage.timer' 2>/dev/null || true)" in active|activating|reloading) fail 'old-storage scrub timer is active' ;; esac
      case "$(systemctl show duperemove-m16-old-storage.service -p RefuseManualStart --value 2>/dev/null || true)" in yes|true|1) ;; *) fail 'old-storage duperemove does not refuse manual starts' ;; esac
      OLD_STORAGE_OPTIONS="$(findmnt -rn -T /mnt/m16-old-storage -o OPTIONS 2>/dev/null || true)"
      printf 'old_storage_host_mount_options=%s\n' "''${OLD_STORAGE_OPTIONS:-unresolved}"
      case ",$OLD_STORAGE_OPTIONS," in *,ro,*) echo 'old_storage_host_mount_mode=ro' ;; *) fail "old-storage host mount is not read-only: $OLD_STORAGE_OPTIONS" ;; esac
      case "$(systemctl show rsync-m16-new-to-old.service -p PrivateMounts --value 2>/dev/null || true)" in yes|true|1) echo 'old_storage_rsync_private_mounts=yes' ;; *) fail 'old-storage rsync lacks PrivateMounts=yes' ;; esac
      case "$(systemctl show rsync-m16-new-to-old.service -p KillMode --value 2>/dev/null || true)" in control-group) echo 'old_storage_rsync_kill_mode=control-group' ;; *) fail 'old-storage rsync lost whole-cgroup manager stop semantics' ;; esac
      case "$(systemctl show rsync-m16-new-to-old.service -p Restart --value 2>/dev/null || true)" in no) echo 'old_storage_rsync_restart=no' ;; *) fail 'old-storage rsync may restart during operator preemption' ;; esac
      grep -Fq 'SuccessExitStatus=75' "$(systemctl show rsync-m16-new-to-old.service -p FragmentPath --value 2>/dev/null || true)" 2>/dev/null || case "$(systemctl show rsync-m16-new-to-old.service -p SuccessExitStatus --value 2>/dev/null || true)" in *75*) : ;; *) fail 'old-storage rsync manager-stop exit 75 is not accepted' ;; esac

      #@MNX-PART id=99.80.mnx-config-audit.phase.storage-metric-invariants kind=phase title="Phase: STORAGE / METRIC INVARIANTS"
      section 'STORAGE / METRIC INVARIANTS'
      grep -Fq 'RefuseManualStart = true; # old-storage may only be written by the new->old rsync mirror' "$CFG" || fail 'old-storage duperemove refusal is missing'
      grep -Fq '# MNX_OLD_STORAGE_MOUNT_POLICY=host-read-only-private-rsync-remount-transaction' "$CFG" || fail 'old-storage mount policy marker is missing'
      grep -Fq '# MNX_HEALTH_DOMAIN_POLICY=storage-state-is-storage-only-memory-pressure-events-belong-to-incident-pipeline' "$CFG" || fail 'health-domain policy marker is missing'
      grep -Fxq '# MNX_UPGRADE_POLICY=immutable-cross-series-check-and-build-no-unattended-activation-channel-or-profile-mutation' "$CFG" || fail 'MNX-owned upgrade policy marker is missing'
