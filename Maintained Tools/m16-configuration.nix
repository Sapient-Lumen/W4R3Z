              value=health_m21_inventory(cache_root,os.getuid(),now+1)
              if value["recursive_inventory_available"] is not True or value["enumeration_scope"] != "recursive-container-parent-id-closure":
                  raise OfficeError("m21 graph failed its current cache roundtrip")
          if "PRIVATE" in json.dumps(graph) or graph["dataset_contents_inspected"] or graph["names_used_as_authority"]:
              raise OfficeError("m21 graph exported private names or overstated authority")
          print("MNX_M21_RECURSIVE_SUBVOLUME_GRAPH_SELF_TEST=PASS")
          print("MNX_M21_RECURSIVE_SUBVOLUME_GRAPH_CASES="+str(valid_graphs+len(changed_samples)+len(graph_mutations)+2))
          print("MNX_M21_LEGACY_NONRECURSIVE_CACHE_SELF_TEST=PASS")

          m21_inventory_discovery_self_test()
          print("MNX_M21_SOURCE_INVENTORY_SELF_TEST=PASS")
          print("MNX_M21_SOURCE_INVENTORY_FRAMING_AND_PRIVACY_CASES="+str(len(cases)+len(mutations)))
          print("MNX_M21_SOURCE_INVENTORY_REMOTE_SHELL_FIXTURE=PASS")
          print("MNX_M21_SOURCE_INVENTORY_SUBPROCESS_BOUNDS=PASS")


      #@MNX-PART id=99.08.mnx-office.function.health-build-evidence kind=function title="Python function health_build_evidence"
      def health_build_evidence(*, root: Path = Path('/'), uid: int = 0, now: int | None = None) -> dict[str, Any]:
          now = int(dt.datetime.now(dt.timezone.utc).timestamp()) if now is None else now
          metric_state, metric_text = health_read_file(root / 'var/lib/node-exporter-textfile/monsternix_storage.prom', 65536, root=root, uid=uid)
          metrics = health_parse_metrics(metric_text)
          epoch = metrics['observation_epoch']
          age = now - epoch if epoch is not None else None
          sample_state = 'fresh'
          if metric_state != 'read':
              sample_state = metric_state
          elif metrics['parse_state'] != 'valid':
              sample_state = metrics['parse_state']
          elif age is not None and age < 0:
              sample_state = 'future-timestamp'
          elif age is not None and age > 21600:
              sample_state = 'stale'
          mismatch_state, mismatch_text = health_read_file(root / 'var/lib/m21-btrfs-pull-backup/last-helper-mismatch', 16384, root=root, uid=uid)
          mismatch: dict[str, Any] = {'read_state': mismatch_state, 'state': 'no-readable-block-record',
                                     'current_remote_identity_verified': False, 'approval_performed': False,
                                     'scope': 'legacy-btrfs-helper-only-not-restic', 'restic_prerequisite': False,
                                     'schedule_policy': 'masked-timer-manual-service-retained',
                                     'schedule_state_verified_here': False, 'history_deleted': False}
          if mismatch_state == 'read':
              mismatch['state'] = 'recorded-block-not-a-new-remote-probe'
              for key in ('expected_helper_sha256', 'observed_helper_sha256'):
                  found = re.findall(r'(?m)^' + key + r'=([0-9a-f]{64})$', mismatch_text)
                  mismatch[key] = found[0] if len(found) == 1 else None
              epochs = re.findall(r'(?m)^epoch=([0-9]{1,15})$', mismatch_text)
              mismatch['observation_epoch'] = int(epochs[0]) if len(epochs) == 1 else None
              mismatch['age_seconds'] = now - int(epochs[0]) if len(epochs) == 1 else None
              sources = re.findall(r'(?m)^helper_trust_source=(source-default|operator-enrolled)$', mismatch_text)
              mismatch['helper_trust_source'] = sources[0] if len(sources) == 1 else None
              flags = re.findall(r'(?m)^data_work_started=(yes|no)$', mismatch_text)
              mismatch['data_work_started'] = flags[0] == 'yes' if len(flags) == 1 else None
              if any(mismatch.get(key) is None for key in ('expected_helper_sha256', 'observed_helper_sha256', 'observation_epoch', 'helper_trust_source', 'data_work_started')):
                  mismatch['state'] = 'malformed-block-record'
          restic = health_restic_evidence(root, uid, now)
          recovery = health_recovery_evidence(root, uid, now)
          residue = health_restore_residue(root, uid, now, recovery)
          return {
              'schema': 'mnx.officer-health-evidence.v1', 'observed_epoch': now,
              'storage': {'sample_state': sample_state, 'age_seconds': age, 'metrics': metrics,
                          'report': health_read_report(root, uid, epoch, metrics['report_hint'])},
              'backup': health_backup_evidence(root, uid, now, restic_evidence=restic), 'm21_helper': mismatch,
              'm21_restic': restic, 'm21_recovery': recovery, 'm21_local_residue': residue,
              'm21_source_inventory': health_m21_inventory(root, uid, now),
              'network_used': False, 'services_started': False, 'state_mutated': False,
              'home_content_read': False, 'presslog_material_read': False, 'raw_report_text_exported': False,
              'evidence_semantics': 'bounded-local-publications-and-restore-directory-metadata-no-payload-or-remote-probes',
          }


      #@MNX-PART id=99.08.mnx-office.function.command-health-evidence kind=function title="Python function command_health_evidence"
      def command_health_evidence(args: argparse.Namespace) -> int:
          record = health_build_evidence()
          if args.json:
              print(json.dumps(record, sort_keys=True, separators=(',', ':')))
              return 0
          storage = record['storage']
          fields = {
              'schema': record['schema'], 'sample_state': storage['sample_state'],
              'sample_epoch': storage['metrics']['observation_epoch'],
              'sample_age_seconds': storage['age_seconds'], 'nvme': storage['metrics']['nvme'],
              'storage_report': storage['report'], 'backup': record['backup'], 'm21_helper': record['m21_helper'],
              'm21_restic': record['m21_restic'], 'm21_recovery': record['m21_recovery'],
              'm21_local_residue': record['m21_local_residue'],
              'm21_source_inventory': record['m21_source_inventory'],
              'read_policy': record['evidence_semantics'],
          }
          for key, value in fields.items():
              print('officer_health_' + key + '=' + json.dumps(value, sort_keys=True, separators=(',', ':')))
          return 0


      #@MNX-PART id=99.08.mnx-office.function.health-evidence-self-test kind=function title="Python function health_evidence_self_test"
      def health_evidence_self_test() -> None:
          with tempfile.TemporaryDirectory(prefix='mnx-office-health-test-') as temp:
              root = Path(temp)
              uid = os.getuid()
              for name in ('var/lib/node-exporter-textfile', 'var/lib/logbook/daily', 'var/lib/logbook/backups',
                           'var/lib/monsternix/job-state/authoritative', 'var/lib/m21-btrfs-pull-backup'):
                  (root / name).mkdir(parents=True, exist_ok=True)
              metric = root / 'var/lib/node-exporter-textfile/monsternix_storage.prom'
              sample = '\n'.join([
                  'monsternix_storage_health_observation_timestamp_seconds 10000',
                  'monsternix_storage_health_problem 0', 'monsternix_storage_health_warning 1',
                  'monsternix_storage_health_advisory 0', 'monsternix_storage_health_history_problem 0',
                  'monsternix_memory_pressure_seen_last_24h 0', 'monsternix_btrfs_baseline_problem 0',
                  'monsternix_nvme_temperature_celsius{device="nvme0"} 45',
                  'monsternix_nvme_critical_warning{device="nvme0"} 0',
              ]) + '\n'
              metric.write_text(sample)
              report = root / 'var/lib/logbook/daily/storage-health-20260905T000000.txt'
              report.write_text('observation_epoch=10000\nWARN: nvme0 temperature changed from 60C to 45C since the last health run\nWARN: PRIVATE-UNMAPPED-CONTENT\nraw PRIVATE-PAYLOAD\n')
              mismatch = root / 'var/lib/m21-btrfs-pull-backup/last-helper-mismatch'
              mismatch.write_text('epoch=9900\nexpected_helper_sha256=' + 'a' * 64 + '\nobserved_helper_sha256=' + 'b' * 64 + '\nhelper_trust_source=source-default\ndata_work_started=no\npassword=PRIVATE-SECRET\n')
              fresh = root / 'var/lib/logbook/backups/freshness-current.txt'
              fresh.write_text('epoch=9000\nbtrbk-main\tbtrbk-main.service\t8000\t1000\t900\t1\t0\t1\tmarker\tinactive\n')
              success = root / 'var/lib/monsternix/job-state/authoritative/btrbk-main.last-success'
              success.write_text('epoch=9500\n')
              record = health_build_evidence(root=root, uid=uid, now=10100)
              if record['storage']['sample_state'] != 'fresh' or record['storage']['metrics']['nvme']['nvme0']['temperature_celsius'] != 45:
                  raise OfficeError('health evidence lost numeric NVMe data')
              report_record = record['storage']['report']
              if report_record['state'] != 'matched' or report_record['causes'][0]['direction'] != 'cooling' or report_record['unmapped_cause_count'] != 1:
                  raise OfficeError('health evidence report correlation or cause projection failed')
              metric.write_text(sample + '# MNX_STORAGE_REPORT=' + report.name + '\n')
              if health_build_evidence(root=root, uid=uid, now=10100)['storage']['report']['state'] != 'matched':
                  raise OfficeError('health evidence failed the producer-linked report path')
              if health_parse_metrics(sample + '# MNX_STORAGE_REPORT=../../private\n')['parse_state'] != 'invalid-report-hint':
                  raise OfficeError('health evidence accepted report path traversal')
              metric.write_text(sample)
              if record['storage']['metrics']['nvme']['nvme1']['temperature_celsius'] is not None:
                  raise OfficeError('health evidence fabricated a missing device measurement')
              if 'PRIVATE' in json.dumps(record) or record['m21_helper']['data_work_started'] is not False:
                  raise OfficeError('health evidence leaked unselected report or trust-record text')
              if record['backup']['jobs']['btrbk-main']['evaluated_row_superseded'] is not True:
                  raise OfficeError('health evidence hid a newer success receipt')
              if health_build_evidence(root=root, uid=uid, now=40000)['storage']['sample_state'] != 'stale':
                  raise OfficeError('health evidence accepted stale data')
              if health_build_evidence(root=root, uid=uid, now=9999)['storage']['sample_state'] != 'future-timestamp':
                  raise OfficeError('health evidence accepted a future timestamp')
              report.write_text('observation_epoch=9999\nWARN: one or more essential backup flows are stale and queued for catch-up\n')
              if health_build_evidence(root=root, uid=uid, now=10100)['storage']['report']['state'] == 'matched':
                  raise OfficeError('health evidence joined different observation epochs')
              duplicate = health_parse_metrics(sample + 'monsternix_storage_health_warning 0\n')
              if duplicate['parse_state'] != 'invalid-or-duplicate-metric':
                  raise OfficeError('health evidence accepted duplicate metrics')
              if health_parse_metrics(''')['problem'] is not None:
                  raise OfficeError('health evidence converted missing data to healthy zero')
              metric.unlink()
              metric.symlink_to(mismatch)
              if health_read_file(metric, 65536, root=root, uid=uid)[0] == 'read':
                  raise OfficeError('health evidence followed a symlink')
              metric.unlink()
              metric.write_text(sample)
              os.link(metric, metric.with_suffix('.link'))
              if health_read_file(metric, 65536, root=root, uid=uid)[0] != 'untrusted-file':
                  raise OfficeError('health evidence accepted a hard link')
              metric.with_suffix('.link').unlink()
              metric.chmod(0o666)
              if health_read_file(metric, 65536, root=root, uid=uid)[0] != 'untrusted-file':
                  raise OfficeError('health evidence accepted writable evidence')
              metric.chmod(0o600)
              if health_read_file(metric, 2, root=root, uid=uid)[0] != 'size-refused':
                  raise OfficeError('health evidence failed its read budget')
              if health_read_file(metric, 65536, root=root, uid=uid, after_read=lambda: metric.write_text('changed'))[0] != 'changed-during-read':
                  raise OfficeError('health evidence accepted an in-place change')
              metric.unlink()
              os.mkfifo(metric, 0o600)
              if health_read_file(metric, 65536, root=root, uid=uid)[0] != 'untrusted-file':
                  raise OfficeError('health evidence accepted a FIFO')
              # Regression: one attempt's completion is later than its source bound,
              # but that must not be reported as a newly superseding backup.
              success = root / 'var/lib/monsternix/job-state/authoritative/m16-restic-m21.last-success'
              completion = 1788512935
              source = 1788506744
              now = 1788590067
              receipt = 'epoch=1788512935\nresult=pull-complete\ndetail=evidence=/var/lib/logbook/backups/m16-restic-backup-20260904T072544Z-55173\n'
              success.write_text(receipt)
              fresh.write_text('epoch=1788589813\nm16-restic-m21\tm16-backup-m21.service\t1788506744\t83069\t86400\t0\t0\t1\troot-restic-success-source-bound\tinactive\n')
              shared = health_restic_evidence(root, uid, now)
              value = health_backup_evidence(root, uid, now, restic_evidence=shared)['jobs']['m16-restic-m21']
              if (value['evaluated_row_superseded'] is not False or value['supersession_comparison'] != 'same-basis-equal' or
                      value['success_receipt_epoch'] != completion or value['success_receipt_source_epoch'] != source or
                      value['evaluated_time_basis'] != 'backup-attempt-start-lower-bound'):
                  raise OfficeError('backup summary confused source and completion timestamps')
              # A late completion with the same source does not make newer data.
              success.write_text(receipt.replace('1788512935', str(now)))
              if health_backup_evidence(root, uid, now)['jobs']['m16-restic-m21']['evaluated_row_superseded'] is not False:
                  raise OfficeError('backup summary treated late completion as newer source')
              # A genuinely newer successful source does supersede the old evaluation.
              newer = receipt.replace('1788512935', str(now)).replace('20260904T072544Z', '20260905T060000Z')
              success.write_text(newer)
              value = health_backup_evidence(root, uid, now)['jobs']['m16-restic-m21']
              if value['evaluated_row_superseded'] is not True or value['supersession_comparison'] != 'same-basis-newer':
                  raise OfficeError('backup summary hid newer same-basis source evidence')
              # The explicitly shared sample wins over a later publication: both views
              # of a single report must describe the same receipt, not two instants.
              if health_backup_evidence(root, uid, now, restic_evidence=shared)['jobs']['m16-restic-m21']['evaluated_row_superseded'] is not False:
                  raise OfficeError('backup summary reread an explicitly shared Restic sample')
              # A legacy marker row uses completion semantics, unlike the new source row.
              success.write_text(receipt)
              source_row = fresh.read_text()
              legacy_row = source_row.replace('\t1788506744\t83069\t', '\t1788512935\t76878\t').replace('root-restic-success-source-bound', 'marker')
              fresh.write_text(legacy_row)
              value = health_backup_evidence(root, uid, now)['jobs']['m16-restic-m21']
              if value['evaluated_row_superseded'] is not False or value['evaluated_time_basis'] != 'backup-completion':
                  raise OfficeError('backup summary lost legacy completion-basis compatibility')
              for label in ('observed-data', 'missing', 'PRIVATE-UNKNOWN-BASIS'):
                  fresh.write_text(source_row.replace('root-restic-success-source-bound', label))
                  value = health_backup_evidence(root, uid, now)['jobs']['m16-restic-m21']
                  if value['evaluated_row_superseded'] is not None or 'PRIVATE' in json.dumps(value):
                      raise OfficeError('backup summary compared unknown bases or exported raw metadata')
              fresh.write_text(source_row)
              for bad in (receipt.replace('1788512935', str(now + 1)),
                          receipt.replace('result=pull-complete', 'result=fail'),
                          receipt.replace('epoch=1788512935', 'epoch=1788512935\nepoch=1788512935'),
                          'epoch=1788512935\nresult=pull-complete\ndetail=PRIVATE-UNPARSEABLE\n'):
                  success.write_text(bad)
                  value = health_backup_evidence(root, uid, now)['jobs']['m16-restic-m21']
                  if value['evaluated_row_superseded'] is not None or 'PRIVATE' in json.dumps(value):
                      raise OfficeError('backup summary accepted invalid source evidence')
              success.write_text(receipt)
              for bad in (source_row.replace('epoch=1788589813', 'epoch=' + str(now + 1)),
                          source_row + source_row.split('\n')[1] + '\n',
                          source_row.replace('\t1788506744\t', '\t' + str(now + 1) + '\t')):
                  fresh.write_text(bad)
                  if health_backup_evidence(root, uid, now)['jobs']['m16-restic-m21']['evaluated_row_superseded'] is not None:
                      raise OfficeError('backup summary accepted invalid or duplicated evaluation evidence')
              fresh.write_text(source_row)
              success.unlink()
              if health_backup_evidence(root, uid, now)['jobs']['m16-restic-m21']['evaluated_row_superseded'] is not None:
                  raise OfficeError('backup summary invented a missing successful source')
              success.symlink_to(mismatch)
              if health_backup_evidence(root, uid, now)['jobs']['m16-restic-m21']['evaluated_row_superseded'] is not None:
                  raise OfficeError('backup summary followed an unsafe success publication')
          print('MNX_OFFICER_BACKUP_TIME_BASIS_SELF_TEST=PASS')
          print('MNX_OFFICER_HEALTH_EVIDENCE_SELF_TEST=PASS')

      #@MNX-PART id=99.08.mnx-office.function.health-summary kind=function title="Python function health_summary"
      def health_summary(path: Path) -> dict[str, Any]:
          self_test = os.environ.get('MNX_OFFICE_SELF_TEST') == '1'
          try:
              info = path.lstat()
          except OSError:
              return {
                  'health_state': 'UNKNOWN_MISSING',
                  'health_observation_age_seconds': 'unknown',
                  'storage_problem': 'unknown',
                  'storage_warning': 'unknown',
                  'storage_advisory': 'unknown',
                  'memory_pressure_seen_last_24h': 'unknown',
              }
          if not stat.S_ISREG(info.st_mode) or path.is_symlink() or info.st_mode & 0o022 or (not self_test and info.st_uid != 0):
              return {
                  'health_state': 'UNKNOWN_UNTRUSTED',
                  'health_observation_age_seconds': 'unknown',
                  'storage_problem': 'unknown',
                  'storage_warning': 'unknown',
                  'storage_advisory': 'unknown',
                  'memory_pressure_seen_last_24h': 'unknown',
              }
          metrics = read_metric_file(path)
          observation = int(metrics.get('monsternix_storage_health_observation_timestamp_seconds', 0))
          now = int(dt.datetime.now().timestamp())
          age = max(0, now - observation) if observation > 0 else None
          problem = int(metrics.get('monsternix_storage_health_problem', 0))
          warning = int(metrics.get('monsternix_storage_health_warning', 0))
          advisory = int(metrics.get('monsternix_storage_health_advisory', 0))
          memory = int(metrics.get('monsternix_memory_pressure_seen_last_24h', 0))
          if age is None:
              state = 'UNKNOWN_NO_TIMESTAMP'
          elif age > 21_600:
              state = 'UNKNOWN_STALE'
          elif problem:
              state = 'FAIL'
          elif warning:
              state = 'PASS_WITH_WARNING'
          else:
              state = 'PASS'
          return {
              'health_state': state,
              'health_observation_age_seconds': age if age is not None else 'unknown',
              'storage_problem': problem,
              'storage_warning': warning,
              'storage_advisory': advisory,
              'memory_pressure_seen_last_24h': memory,
          }
      
      
      #@MNX-PART id=99.08.mnx-office.function.exposure-summary kind=function title="Python function exposure_summary"
      def exposure_summary(path: Path) -> dict[str, Any]:
          numeric_fields = (
              'raw_listener_row_total', 'canonical_listener_total', 'duplicate_listener_row_total',
              'stable_listener_total', 'declared_listener_total', 'known_listener_total',
              'review_listener_total', 'undeclared_listener_total', 'unattributed_listener_total',
              'rpc_attributed_listener_total', 'rpc_program_endpoint_total',
              'wildcard_listener_total', 'public_listener_total', 'review_group_total',
              'zone_conforming_total', 'zone_firewall_required_total', 'zone_mismatch_total',
              'zone_review_total', 'new_listener_total', 'recurring_listener_total',
              'persistent_listener_total',
          )
          default = {
              'exposure_state': 'UNKNOWN_MISSING',
              'exposure_observation_age_seconds': 'unknown',
              'policy_mode': 'unknown',
              'census_scope': 'unknown',
              'rpcinfo_state': 'unknown',
              'attention_required': 'unknown',
              **{field: 'unknown' for field in numeric_fields},
          }
          try:
              info = path.lstat()
              if not stat.S_ISREG(info.st_mode) or path.is_symlink() or info.st_mode & 0o022:
                  default['exposure_state'] = 'UNKNOWN_UNTRUSTED'
                  return default
              value = json.loads(path.read_text(encoding='utf-8'))
              summary = value.get('summary', {})
              observed = int(value.get('observation_epoch', 0))
              age = max(0, int(dt.datetime.now().timestamp()) - observed) if observed > 0 else None
              state = str(summary.get('result', 'UNKNOWN'))
              if age is None:
                  state = 'UNKNOWN_NO_TIMESTAMP'
              elif age > 14_400:
                  state = 'UNKNOWN_STALE'
              result = {
                  'exposure_state': state,
                  'exposure_observation_age_seconds': age if age is not None else 'unknown',
                  'policy_mode': value.get('policy_mode', 'unknown'),
                  'census_scope': summary.get('census_scope', value.get('census_scope', 'unknown')),
                  'rpcinfo_state': summary.get('rpcinfo_state', value.get('rpcinfo_state', 'unknown')),
                  'attention_required': summary.get('attention_required', 'unknown'),
              }
              for field in numeric_fields:
                  result[field] = summary.get(field, 'unknown')
              return result
          except (OSError, ValueError, TypeError, json.JSONDecodeError):
              return default
      
      #@MNX-PART id=99.08.mnx-office.function.render-resume kind=function title="Python function render_resume"
      def render_resume(record: dict[str, Any], source: dict[str, Any], runtime: dict[str, Any], health: dict[str, Any], exposure: dict[str, Any]) -> dict[str, Any]:
          agenda = source['agenda']
          capsule = source['amnesia_capsule']
          capsule_fields = capsule['fields']
          overlay = continuation_overlay(
              record,
              source,
              require_root=os.environ.get('MNX_OFFICE_SELF_TEST') != '1',
          )
          runtime_attention = (
              runtime['system_state'] != 'running'
              or runtime['failed_unit_count'] != 0
              or health['health_state'] != 'PASS'
              or exposure['exposure_state'] in {'FAIL', 'UNKNOWN_MISSING', 'UNKNOWN_UNTRUSTED', 'UNKNOWN_NO_TIMESTAMP', 'UNKNOWN_STALE'}
              or overlay['attention_required']
          )
          return {
              'MNX_OFFICE_RESUME_VERSION': OFFICE_VERSION,
              'office_record_schema': record['record_schema'],
              'acceptance_state': 'accepted',
              'runtime_attention_required': 'yes' if runtime_attention else 'no',
              'accepted_at': record['accepted_at'],
              'accepted_stage': record['accepted_stage'],
              'accepted_predecessor_stage': agenda['accepted_predecessor_stage'],
              'accepted_predecessor_sha256': agenda['accepted_predecessor_sha256'],
              'accepted_source_sha256': record['source_sha256'],
              'source_bytes': record['source_bytes'],
              'document_schema': record['document_schema'],
              'agenda_sha256': record['agenda_sha256'],
              'amnesia_capsule_present': 'yes' if capsule['present'] else 'no',
              'amnesia_capsule_schema': capsule['schema'],
              'amnesia_capsule_sha256': capsule['sha256'],
              'amnesia_capsule_bytes': capsule['bytes'],
              'amnesia_authority': capsule_fields['AUTHORITY'],
              'amnesia_state': capsule_fields['STATE'],
              'amnesia_intent': capsule_fields['INTENT'],
              'amnesia_open': capsule_fields['OPEN'],
              'amnesia_next': capsule_fields['NEXT'],
              'amnesia_hold': capsule_fields['HOLD'],
              'amnesia_operator': capsule_fields['OPERATOR'],
              'editable_source_matches_active': 'yes',
              'running_system_is_boot_default': 'yes',
              'system_state': runtime['system_state'],
              'failed_unit_count': runtime['failed_unit_count'],
              'latest_test_result': record['test_result'],
              'latest_core_switch_result': overlay['core_switch_result'],
              'latest_switch_result': overlay['final_switch_result'],
              'post_acceptance_plan': overlay['post_acceptance_plan'],
              'post_acceptance_status': overlay['post_acceptance_status'],
              'post_acceptance_action_results': overlay['post_acceptance_action_results'],
              'post_acceptance_mutation_proof': overlay['post_acceptance_mutation_proof'],
              'post_acceptance_receipt': overlay['post_acceptance_receipt'],
              'post_acceptance_receipt_status': overlay['post_acceptance_receipt_status'],
              'continuation_attention_reasons': ','.join(overlay['attention_reasons']) or 'none',
              'switch_evidence_digest_mode': runtime['switch_evidence_digest_mode'],
