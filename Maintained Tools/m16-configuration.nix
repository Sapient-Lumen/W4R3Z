              "# HELP monsternix_network_wildcard_listeners Count of stable canonical endpoints bound to wildcard addresses.",
              "# TYPE monsternix_network_wildcard_listeners gauge",
              f"monsternix_network_wildcard_listeners {summary['wildcard_listener_total']}",
              "# HELP monsternix_network_udp_ephemeral_listeners Count of canonical UDP endpoints in the kernel ephemeral range.",
              "# TYPE monsternix_network_udp_ephemeral_listeners gauge",
