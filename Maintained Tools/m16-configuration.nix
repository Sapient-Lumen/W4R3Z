          original_keysyms = [CAPS_LOCK, 0, CAPS_LOCK, 0]
          snapshot = snapshot_record(original_keysyms, caps_modifier_slots(fixture_rows), True)
          patched_rows = rewrite_caps_modifiers(fixture_rows, [MONSTER_MODIFIER_INDEX])
          if caps_modifier_slots(patched_rows) != [MONSTER_MODIFIER_INDEX]:
              raise MonsterKeyError("direct modifier rewrite did not donate Caps to Mod3")
          for index, row in enumerate(fixture_rows):
              expected = [value for value in row if value not in {0, CAPS_KEYCODE}]
              observed = [value for value in patched_rows[index] if value not in {0, CAPS_KEYCODE}]
              if expected != observed:
                  raise MonsterKeyError("direct modifier rewrite changed an unrelated keycode")
          restored_rows = rewrite_caps_modifiers(patched_rows, list(snapshot["modifier_slots"]))
          if caps_modifier_slots(restored_rows) != list(snapshot["modifier_slots"]):
              raise MonsterKeyError("direct modifier rollback did not restore the Caps memberships")
          for index, row in enumerate(fixture_rows):
