          return sha256_bytes(canonical_json(payload))
            
            
      #@MNX-PART id=40.31.mnx-exposure.function.attribution-identity kind=function title="Python function attribution_identity"
      def attribution_identity(listener: dict[str, Any]) -> str:
          owners = []
          for owner in listener.get("owners", []):
              owners.append({
                  "uid": owner.get("uid", "unknown"),
                  "comm": owner.get("comm", "unknown"),
                  "unit": owner.get("unit", "unknown"),
                  "package": owner.get("package", "unknown"),
                  "executable_id": owner.get("executable_id", "unknown"),
                  "cgroup": owner.get("cgroup", "unknown"),
                  "netns_class": owner.get("netns_class", "unknown"),
              })
          payload = {"endpoint_id": listener["endpoint_id"], "owners": owners}
          return sha256_bytes(canonical_json(payload))
            
            
      #@MNX-PART id=40.31.mnx-exposure.function.zone-status kind=function title="Python function zone_status"
      def zone_status(listener: dict[str, Any], zone: dict[str, Any] | None) -> str:
          if zone is None:
              return "unknown-zone"
          if zone["bind_policy"] == "review" or zone["id"] == "review":
              return "review"
          if listener["address_class"] not in zone["address_classes"]:
              return "overbroad"
          interfaces = listener.get("interfaces", []) or ["unknown"]
          interface_match = any(
              pattern_matches(zone["interface_patterns"], interface)
              for interface in interfaces
          )
          if listener["address_class"] == "wildcard":
              if zone["bind_policy"] == "firewall-gated":
                  return "firewall-required"
              if zone["bind_policy"] == "any":
                  return "conforming"
              return "overbroad"
          if not interface_match:
              return "interface-mismatch"
          return "conforming"
            
      #@MNX-PART id=40.31.mnx-exposure.function.apply-policy kind=function title="Python function apply_policy"
      def apply_policy(listeners: list[dict[str, Any]], policy: dict[str, Any], mode: str, ephemeral_range: tuple[int, int]) -> dict[str, Any]:
          matched_policy_ids: set[str] = set()
          volatility_order = {"persistent": 0, "dynamic": 1, "transient": 2}
          for listener in listeners:
              owners = policy_relevant_owners(listener)
              matched_by_id: dict[str, dict[str, Any]] = {}
              owner_match_records: list[dict[str, Any]] = []
              ambiguous_owner_matches: list[list[str]] = []
              unmatched_owner_count = 0
              for owner in owners:
                  matches = [entry for entry in policy["entries"] if entry_matches_owner(entry, listener, mode, owner)]
                  ids = sorted(entry["id"] for entry in matches)
                  owner_match_records.append({
                      "unit": str(owner.get("unit", "unknown")),
                      "process": str(owner.get("comm", "unknown")),
                      "policy_ids": ids,
                  })
                  if len(matches) > 1:
                      ambiguous_owner_matches.append(ids)
                  elif len(matches) == 1:
                      matched_by_id[matches[0]["id"]] = matches[0]
                  else:
                      unmatched_owner_count += 1
              matches = [matched_by_id[key] for key in sorted(matched_by_id)]
              listener["policy_owner_matches"] = owner_match_records
              listener["policy_unmatched_owner_count"] = unmatched_owner_count
              listener["policy_matches"] = [entry["id"] for entry in matches]
              if ambiguous_owner_matches:
                  listener["policy_status"] = "ambiguous"
                  listener["policy_id"] = ",".join(sorted({item for group in ambiguous_owner_matches for item in group}))
                  listener["disposition"] = "review"
                  listener["intent"] = "ambiguous-policy"
                  listener["zone"] = "review"
                  listener["volatility"] = "dynamic"
              elif matches:
                  matched_policy_ids.update(entry["id"] for entry in matches)
                  listener["policy_status"] = "declared"
                  listener["policy_id"] = ",".join(entry["id"] for entry in matches)
                  dispositions = {entry["disposition"] for entry in matches}
                  if "forbidden" in dispositions:
                      listener["disposition"] = "forbidden"
                  elif "review" in dispositions or unmatched_owner_count:
                      listener["disposition"] = "review"
                  else:
                      listener["disposition"] = "known"
                  intents = sorted({entry["intent"] for entry in matches})
                  zones = sorted({entry["zone"] for entry in matches})
                  listener["intent"] = intents[0] if len(intents) == 1 else "multi-owner-policy"
                  listener["zone"] = zones[0] if len(zones) == 1 else "review"
                  listener["volatility"] = max(
                      (entry["volatility"] for entry in matches),
                      key=lambda value: volatility_order[value],
                  )
                  if unmatched_owner_count:
                      listener["intent"] = "mixed-owner-policy"
                      listener["zone"] = "review"
                      listener["volatility"] = "dynamic"
              else:
                  listener["policy_status"] = "undeclared"
                  listener["policy_id"] = "none"
                  listener["disposition"] = policy["default_disposition"]
                  listener["intent"] = "unclassified"
                  listener["zone"] = "review"
                  listener["volatility"] = "dynamic"
              listener["zone_status"] = zone_status(listener, policy["zone_by_id"].get(listener["zone"]))
              port = int(listener["local_port"])
              listener["ephemeral_udp"] = listener["protocol"] == "udp" and ephemeral_range[0] <= port <= ephemeral_range[1]
              listener["stable"] = not (listener["ephemeral_udp"] and listener["policy_status"] == "undeclared")
              listener["endpoint_id"] = endpoint_identity(listener)
              listener["attribution_id"] = attribution_identity(listener)
              listener["stable_id"] = listener["attribution_id"]
              listener["attributed"] = bool(listener["owners"])
          missing_required = sorted(
              entry["id"] for entry in policy["entries"] if entry["required_bool"] and entry["id"] not in matched_policy_ids
          )
          return {"missing_required_policy_ids": missing_required}
      
      #@MNX-PART id=40.31.mnx-exposure.function.read-ephemeral-range kind=function title="Python function read_ephemeral_range"
      def read_ephemeral_range() -> tuple[int, int]:
          try:
              fields = pathlib.Path("/proc/sys/net/ipv4/ip_local_port_range").read_text(encoding="utf-8").split()
              if len(fields) == 2:
                  low, high = int(fields[0]), int(fields[1])
                  if 1 <= low <= high <= 65535:
                      return low, high
          except (OSError, ValueError):
              pass
          return 32768, 60999
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.read-mode kind=function title="Python function read_mode"
      def read_mode() -> str:
          for path in (pathlib.Path("/run/monsternix/mode"), pathlib.Path("/etc/monsternix/mode")):
              try:
                  value = path.read_text(encoding="utf-8").strip()
              except OSError:
                  continue
              if value:
                  return value
          return "normal"
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.load-ledger kind=function title="Python function load_ledger"
      def load_ledger(state_root: pathlib.Path, current_listeners: list[dict[str, Any]], now_epoch: int) -> tuple[dict[str, Any], str]:
          path = state_root / "ledger.json"
          try:
              value = json.loads(path.read_text(encoding="utf-8"))
              if value.get("schema") != LEDGER_SCHEMA or not isinstance(value.get("entries"), dict):
                  raise ValueError("wrong ledger schema")
              return value, "existing"
          except (OSError, ValueError, TypeError, json.JSONDecodeError):
              pass
          # Seed one prior sighting from the predecessor current record when possible.
          seed_epoch = now_epoch
          seed_entries: dict[str, Any] = {}
          current_path = state_root / "current.json"
          try:
              old = json.loads(current_path.read_text(encoding="utf-8"))
              seed_epoch = int(old.get("observation_epoch", now_epoch))
              for listener in old.get("listeners", []):
                  if not listener.get("stable", True):
                      continue
                  endpoint_id = listener.get("endpoint_id") or endpoint_identity(listener)
                  seed_entries[endpoint_id] = {
                      "first_seen_epoch": seed_epoch,
                      "last_seen_epoch": seed_epoch,
                      "seen_count": 1,
                      "consecutive_seen": 1,
                  }
          except (OSError, ValueError, TypeError, json.JSONDecodeError, KeyError):
              seed_entries = {}
          return {
              "schema": LEDGER_SCHEMA,
              "last_observation_epoch": seed_epoch,
              "last_observation_endpoint_ids": sorted(seed_entries),
              "entries": seed_entries,
          }, "seeded-predecessor-current" if seed_entries else "new"
            
            
      #@MNX-PART id=40.31.mnx-exposure.function.update-ledger kind=function title="Python function update_ledger"
      def update_ledger(ledger: dict[str, Any], listeners: list[dict[str, Any]], now_epoch: int) -> dict[str, Any]:
          previous_ids = set(ledger.get("last_observation_endpoint_ids", []))
          entries = dict(ledger.get("entries", {}))
          current_ids: set[str] = set()
          for listener in listeners:
              if not listener["stable"]:
                  listener["persistence"] = "ephemeral"
                  listener["seen_count"] = 0
                  continue
              endpoint_id = listener["endpoint_id"]
              current_ids.add(endpoint_id)
              old = entries.get(endpoint_id, {})
              first_seen = int(old.get("first_seen_epoch", now_epoch))
              seen_count = int(old.get("seen_count", 0)) + 1
              consecutive = int(old.get("consecutive_seen", 0)) + 1 if endpoint_id in previous_ids else 1
              span = max(0, now_epoch - first_seen)
              persistence = "persistent" if seen_count >= 3 and span >= 86_400 else "recurring" if seen_count >= 3 else "new"
              entries[endpoint_id] = {
                  "first_seen_epoch": first_seen,
                  "last_seen_epoch": now_epoch,
                  "seen_count": seen_count,
                  "consecutive_seen": consecutive,
                  "last_attribution_id": listener["attribution_id"],
                  "policy_id": listener["policy_id"],
                  "zone": listener["zone"],
              }
              listener["first_seen_epoch"] = first_seen
              listener["last_seen_epoch"] = now_epoch
              listener["seen_count"] = seen_count
              listener["consecutive_seen"] = consecutive
              listener["persistence"] = persistence
          cutoff = now_epoch - LEDGER_RETENTION_SECONDS
          entries = {
              key: value for key, value in entries.items()
              if int(value.get("last_seen_epoch", 0)) >= cutoff or key in current_ids
          }
          if len(entries) > MAX_LEDGER_ENTRIES:
              raise ExposureError(f"exposure ledger ceiling exceeded: {len(entries)} > {MAX_LEDGER_ENTRIES}")
          return {
              "schema": LEDGER_SCHEMA,
              "last_observation_epoch": now_epoch,
              "last_observation_endpoint_ids": sorted(current_ids),
              "entries": entries,
          }
            
            
      #@MNX-PART id=40.31.mnx-exposure.function.primary-owner kind=function title="Python function primary_owner"
      def primary_owner(listener: dict[str, Any]) -> dict[str, Any]:
          owners = listener.get("owners", [])
          if not owners:
              return {"unit": "unknown", "comm": "unknown", "package": "unknown", "cgroup": "unknown"}
          preferred = [owner for owner in owners if owner.get("unit") not in {"init.scope", "unknown"} and owner.get("comm") != "systemd"]
          return (preferred or owners)[0]
            
            
      #@MNX-PART id=40.31.mnx-exposure.function.review-reasons kind=function title="Python function review_reasons"
      def review_reasons(listener: dict[str, Any]) -> list[str]:
          reasons: list[str] = []
          if listener["policy_status"] == "undeclared":
              reasons.append("undeclared")
          if listener["policy_status"] == "ambiguous":
              reasons.append("ambiguous")
          if listener["disposition"] == "review":
              reasons.append("policy-review")
          if int(listener.get("policy_unmatched_owner_count", 0)) > 0:
              reasons.append("partially-declared-owners")
          if not listener["attributed"]:
              reasons.append("unattributed")
          if listener["zone_status"] in ZONE_STATUS_ATTENTION:
              reasons.append(f"zone-{listener['zone_status']}")
          return sorted(set(reasons))
            
            
      #@MNX-PART id=40.31.mnx-exposure.function.review-groups kind=function title="Python function review_groups"
      def review_groups(listeners: list[dict[str, Any]]) -> list[dict[str, Any]]:
          groups: dict[tuple[str, ...], dict[str, Any]] = {}
          for listener in listeners:
              if not listener["stable"]:
                  continue
              reasons = review_reasons(listener)
              if not reasons:
                  continue
              owner = primary_owner(listener)
              key = (
                  str(owner.get("unit", "unknown")), str(owner.get("comm", "unknown")),
                  str(owner.get("package", "unknown")), listener["policy_status"], listener["policy_id"],
                  listener["disposition"], listener["intent"], listener["zone"], listener["zone_status"],
                  listener.get("volatility", "dynamic"), ",".join(reasons),
              )
              group = groups.setdefault(key, {
                  "unit": key[0], "process": key[1], "package": key[2], "policy_status": key[3],
                  "policy_id": key[4], "disposition": key[5], "intent": key[6], "zone": key[7],
                  "zone_status": key[8], "volatility": key[9], "reasons": reasons,
                  "endpoint_ids": [], "protocols": set(), "ports": set(), "address_classes": set(),
                  "interfaces": set(), "persistence": set(),
              })
              group["endpoint_ids"].append(listener["endpoint_id"])
              group["protocols"].add(listener["protocol"])
              group["ports"].add(int(listener["local_port"]))
              group["address_classes"].add(listener["address_class"])
              group["interfaces"].update(listener.get("interfaces", []))
              group["persistence"].add(listener.get("persistence", "new"))
          output: list[dict[str, Any]] = []
          for key, group in groups.items():
              payload = {"key": key, "endpoint_ids": sorted(group["endpoint_ids"])}
              output.append({
                  **{name: value for name, value in group.items() if not isinstance(value, set)},
                  "group_id": sha256_bytes(canonical_json(payload))[:16],
                  "endpoint_count": len(set(group["endpoint_ids"])),
                  "endpoint_ids": sorted(set(group["endpoint_ids"])),
                  "protocols": sorted(group["protocols"]),
                  "ports": sorted(group["ports"]),
                  "address_classes": sorted(group["address_classes"]),
                  "interfaces": sorted(group["interfaces"]),
                  "persistence": sorted(group["persistence"]),
              })
          output.sort(key=lambda item: (-int(item["endpoint_count"]), item["unit"], item["process"], item["group_id"]))
          return output
            
            
      #@MNX-PART id=40.31.mnx-exposure.function.summarize kind=function title="Python function summarize"
      def summarize(observation: dict[str, Any]) -> dict[str, Any]:
          listeners = observation["listeners"]
          stable = [item for item in listeners if item["stable"]]
          declared = [item for item in stable if item["policy_status"] == "declared"]
          undeclared = [item for item in stable if item["policy_status"] == "undeclared"]
          ambiguous = [item for item in stable if item["policy_status"] == "ambiguous"]
          forbidden = [item for item in stable if item["disposition"] == "forbidden"]
          policy_review = [item for item in stable if item["disposition"] == "review"]
          unattributed = [item for item in stable if not item["attributed"]]
          rpc_attributed = [
              item for item in stable
              if any(owner.get("socket_lookup") == "rpcinfo" for owner in item.get("owners", []))
          ]
          wildcard = [item for item in stable if item["address_class"] == "wildcard"]
          public = [item for item in stable if item["address_class"] == "public"]
          nonhost = [item for item in stable if "nonhost" in item["netns_classes"]]
          zone_attention = [item for item in stable if item["zone_status"] in ZONE_STATUS_ATTENTION]
          missing_required = observation.get("missing_required_policy_ids", [])
          groups = observation.get("review_groups", review_groups(listeners))
          rpcinfo_state = str(observation.get("rpcinfo_state", "unknown"))
          rpcinfo_ok = rpc_registry_satisfied(rpcinfo_state)
          rpcinfo_problem = not rpcinfo_ok
          hard_problem = bool(forbidden or ambiguous or missing_required)
          review = bool(policy_review or undeclared or unattributed or zone_attention or rpcinfo_problem)
          result = "FAIL" if hard_problem else "PASS_WITH_REVIEW" if review else "PASS"
          persistence_counts = collections.Counter(item.get("persistence", "new") for item in stable)
          zone_counts = collections.Counter(item.get("zone_status", "unknown-zone") for item in stable)
          return {
              "observation_timestamp_seconds": int(observation["observation_epoch"]),
              "observation_time": observation["observed_at"],
              "source_sha256": observation["source_sha256"],
              "policy_sha256": observation["policy_sha256"],
              "policy_mode": observation["policy_mode"],
              "default_disposition": observation["default_disposition"],
              "census_scope": observation.get("census_scope", "host-network-namespace-listeners"),
              "host_netns_inode": observation.get("host_netns_inode", "unknown"),
              "listener_limit": MAX_LISTENERS,
              "owner_pid_limit": MAX_OWNER_PIDS,
              "systemd_unit_lookup_limit": MAX_SYSTEMD_UNIT_LOOKUPS,
              "raw_ss_bytes": int(observation.get("raw_ss_bytes", 0)),
              "raw_listener_row_total": int(observation.get("raw_listener_row_total", len(listeners))),
              "canonical_listener_total": len(listeners),
              "duplicate_listener_row_total": int(observation.get("duplicate_listener_row_total", 0)),
              "listener_total": len(listeners),
              "stable_listener_total": len(stable),
              "declared_listener_total": len(declared),
              "known_listener_total": sum(1 for item in declared if item["disposition"] == "known"),
              "review_listener_total": len(policy_review),
              "undeclared_listener_total": len(undeclared),
              "ambiguous_listener_total": len(ambiguous),
              "forbidden_listener_total": len(forbidden),
              "missing_required_policy_total": len(missing_required),
              "attributed_listener_total": len(stable) - len(unattributed),
              "unattributed_listener_total": len(unattributed),
              "rpcinfo_state": rpcinfo_state,
              "rpc_registry_required": bool(observation.get("rpc_registry_required", False)),
              "rpc_registry_satisfied": "yes" if rpcinfo_ok else "no",
              "rpc_active_unit_total": int(observation.get("rpc_active_unit_total", 0)),
              "rpc_attributed_listener_total": len(rpc_attributed),
              "rpc_program_endpoint_total": int(observation.get("rpc_program_endpoint_total", 0)),
              "wildcard_listener_total": len(wildcard),
              "public_listener_total": len(public),
              "nonhost_netns_listener_total": len(nonhost),
              "ephemeral_udp_listener_total": sum(1 for item in listeners if item["ephemeral_udp"]),
              "review_group_total": len(groups),
              "zone_conforming_total": zone_counts["conforming"],
              "zone_firewall_required_total": zone_counts["firewall-required"],
              "zone_mismatch_total": sum(zone_counts[name] for name in ("overbroad", "interface-mismatch", "unknown-zone")),
              "zone_review_total": zone_counts["review"],
              "new_listener_total": persistence_counts["new"],
              "recurring_listener_total": persistence_counts["recurring"],
              "persistent_listener_total": persistence_counts["persistent"],
              "endpoint_changed": int(observation.get("endpoint_changed", 0)),
              "attribution_changed": int(observation.get("attribution_changed", 0)),
              "stable_changed": int(observation.get("stable_changed", 0)),
              "all_changed": int(observation.get("all_changed", 0)),
              "ephemeral_udp_only_changed": int(observation.get("ephemeral_udp_only_changed", 0)),
              "attention_required": "yes" if (hard_problem or review) else "no",
              "result": result,
              "latest_report": observation.get("latest_report", "unknown"),
              "current_json": observation.get("current_json", "unknown"),
          }
            
