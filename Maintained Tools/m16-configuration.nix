      #@MNX-PART id=99.91.mnx-presslog-observe.class.observer-error kind=class title="Python class ObserverError"
      class ObserverError(RuntimeError):
          pass
      
      #@MNX-PART id=99.91.mnx-presslog-observe.function.canonical kind=function title="Python function canonical"
      def canonical(value: object) -> str:
          return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False) + '\n'
      
      #@MNX-PART id=99.91.mnx-presslog-observe.function.utc-now kind=function title="Python function utc_now"
      def utc_now() -> str:
