      def candidate_metadata(path: Path, expected_sha256: str, require_root: bool) -> dict[str, Any]:
          require(HEX64_RE.fullmatch(expected_sha256) is not None, "expected candidate SHA-256 is malformed")
          raw = stable_read_regular(path, MAX_CANDIDATE_BYTES, require_root=require_root, require_single_link=False)
          actual_sha256 = sha256_bytes(raw)
          require(actual_sha256 == expected_sha256, f"candidate SHA-256 changed or was misreported: expected={expected_sha256} actual={actual_sha256}")
