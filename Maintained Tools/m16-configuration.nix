  systemd.services.monsternix-config-copy = {
    description = "Copy /etc/nixos/configuration.nix into the user admin tree";
    wants = [ "local-fs.target" ];
    after = [ "local-fs.target" ];
    onFailure = [ "mnx-job-failure-notify@%n.service" ];
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      StandardOutput = "journal";
      StandardError = "journal";
      NoNewPrivileges = true;
      PrivateTmp = true;
    };
    path = [ pkgs.coreutils ];
    script = ''
      set -euo pipefail
      JOB_START="$(date +%s)"; trap 'rc="$?"; /etc/monsternix/bin/mnx-job-metric monsternix-config-copy "$rc" "$(( $(date +%s) - JOB_START ))" 0 none || true; exit "$rc"' EXIT
      install -d -m 0755 -o h0p3 -g users /home/h0p3/admin/nixos
      cp /etc/nixos/configuration.nix /home/h0p3/admin/nixos/configuration.nix
      chown h0p3:users /home/h0p3/admin/nixos/configuration.nix
      chmod 0644 /home/h0p3/admin/nixos/configuration.nix
    '';
  };

