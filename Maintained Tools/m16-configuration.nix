      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.archive-check kind=function title="Portable Python function archive_check"
      def archive_check(path:Path,expected_root:str|None=None,materialize:bool=True)->dict:
          raw=stable_regular_bytes(path,MAX_ARCHIVE_COMPRESSED_BYTES,'cloudtainer archive')
          members:dict[str,tuple[str,bytes|None]]={}; roots:set[str]=set(); expanded=0
          try:
              archive=tarfile.open(fileobj=io.BytesIO(raw),mode='r:gz')
          except (tarfile.TarError,OSError) as exc:
              raise Error(f'archive is unreadable: {exc}') from exc
          with archive:
              if archive.pax_headers: raise Error('archive global PAX metadata is forbidden')
              infos=archive.getmembers()
              if not infos or len(infos)>MAX_ARCHIVE_MEMBERS: raise Error(f'archive member count invalid: {len(infos)}')
              for info in infos:
                  if info.pax_headers: raise Error(f'archive member PAX metadata forbidden: {info.name}')
                  if info.name.startswith('/') or '\\' in info.name or any(ord(c)<32 or ord(c)==127 for c in info.name): raise Error(f'archive member path unsafe: {info.name!r}')
                  pure=PurePosixPath(info.name)
                  if pure.is_absolute() or any(part in {"",".",".."} for part in pure.parts) or pure.as_posix()!=info.name: raise Error(f'archive member path noncanonical: {info.name!r}')
                  root=pure.parts[0]; roots.add(root)
                  if info.name in members: raise Error(f'archive duplicate member: {info.name}')
                  if info.issym() or info.islnk() or info.isdev() or info.isfifo() or not (info.isdir() or info.isreg()): raise Error(f'archive member type forbidden: {info.name}')
                  if info.size>MAX_ARCHIVE_MEMBER_BYTES: raise Error(f'archive member too large: {info.name}')
                  if info.isreg():
                      expanded+=info.size
                      if expanded>MAX_ARCHIVE_EXPANDED_BYTES: raise Error('archive expanded size exceeds bound')
                      stream=archive.extractfile(info); require(stream is not None,f'archive member unreadable: {info.name}')
                      payload=stream.read(info.size+1); require(len(payload)==info.size,f'archive member size mismatch: {info.name}')
                      members[info.name]=('file',payload)
                  else: members[info.name]=('dir',None)
          require(len(roots)==1,'archive must have exactly one root')
          root_name=next(iter(roots)); require(root_name in {PACKET_ARCHIVE_ROOT,PROPOSAL_ARCHIVE_ROOT},f'archive root unsupported: {root_name}')
          if expected_root is not None: require(root_name==expected_root,f'archive root differs: {root_name} != {expected_root}')
          require(members.get(root_name)==('dir',None),'archive root directory missing')
          relative_files={name[len(root_name)+1:]:payload for name,(kind,payload) in members.items() if kind=='file' and name.startswith(root_name+'/')}
          relative_dirs={name[len(root_name)+1:] for name,(kind,_) in members.items() if kind=='dir' and name.startswith(root_name+'/')}
          require(relative_dirs==parent_directories(set(relative_files)),'archive directory inventory is not closed')
          with tempfile.TemporaryDirectory(prefix='mnx-cloudtainer-archive-check.') as directory:
              materialized=Path(directory)/root_name; materialized.mkdir(mode=0o700)
              for relative in sorted(relative_dirs): (materialized/relative).mkdir(mode=0o700,parents=True,exist_ok=True)
              for relative,payload in relative_files.items(): atomic_write(materialized/relative,payload or b"",0o700 if relative=='bin/mnx-cloudtainer' else 0o600)
              result=packet_verify(materialized) if root_name==PACKET_ARCHIVE_ROOT else proposal_verify(materialized)
          return {'schema':'mnx.cloudtainer.archive-check.v1','status':'pass','archive':str(path.resolve()),'archive_sha256':sha256_bytes(raw),'archive_root':root_name,'member_count':len(members),'expanded_bytes':expanded,'contained_verifier_status':result['status'],'network_used':False,'ambient_network_sandbox_proved':False,'materialization':'private-after-member-verification'}
      
