      #@MNX-PART id=99.92.mnx-monsterkey.function.runtime-root kind=function title="Python function runtime_root"
      def runtime_root() -> Path:
          root = Path(os.environ.get("MNX_MONSTERKEY_RUNTIME_ROOT", str(MONSTERKEY_RUNTIME_ROOT)))
          if not root.is_absolute() or root != MONSTERKEY_RUNTIME_ROOT:
              raise MonsterKeyError(f"unexpected Monster Key runtime root: {root}")
          return root


      #@MNX-PART id=99.92.mnx-monsterkey.function.ensure-runtime-root kind=function title="Python function ensure_runtime_root"
      def ensure_runtime_root() -> Path:
          root = runtime_root()
          root.mkdir(mode=0o700, parents=True, exist_ok=True)
          info = root.lstat()
          if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
              raise MonsterKeyError(f"runtime root is unsafe: {root}")
          if info.st_uid != EXPECTED_UID or stat.S_IMODE(info.st_mode) != 0o700:
              raise MonsterKeyError(
                  f"runtime root metadata differs: uid={info.st_uid} mode={stat.S_IMODE(info.st_mode):o}"
              )
          return root


      #@MNX-PART id=99.92.mnx-monsterkey.function.atomic-write kind=function title="Python function atomic_write"
      def atomic_write(path: Path, payload: bytes, mode: int = 0o600) -> None:
          if not payload or len(payload) > MAX_FILE_BYTES:
              raise MonsterKeyError(f"refusing unsafe runtime payload size: {len(payload)}")
          directory = path.parent
          temporary = directory / f".{path.name}.tmp.{os.getpid()}.{time.monotonic_ns()}"
          flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
          if hasattr(os, "O_NOFOLLOW"):
              flags |= os.O_NOFOLLOW
          descriptor = os.open(temporary, flags, mode)
          try:
              with os.fdopen(descriptor, "wb", closefd=False) as stream:
                  stream.write(payload)
                  stream.flush()
                  os.fsync(stream.fileno())
              os.close(descriptor)
              descriptor = -1
              os.replace(temporary, path)
              os.chmod(path, mode)
              directory_fd = os.open(directory, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
              try:
                  os.fsync(directory_fd)
              finally:
                  os.close(directory_fd)
          finally:
              if descriptor >= 0:
                  os.close(descriptor)
              try:
                  temporary.unlink()
              except FileNotFoundError:
                  pass


      #@MNX-PART id=99.92.mnx-monsterkey.function.validated-regular kind=function title="Python function validated_regular"
      def validated_regular(path: Path) -> bytes:
          before = path.lstat()
          if not stat.S_ISREG(before.st_mode) or stat.S_ISLNK(before.st_mode):
              raise MonsterKeyError(f"unsafe Monster Key runtime object: {path}")
          if before.st_uid != EXPECTED_UID or stat.S_IMODE(before.st_mode) != 0o600:
              raise MonsterKeyError(f"unsafe Monster Key runtime metadata: {path}")
          if before.st_size <= 0 or before.st_size > MAX_FILE_BYTES:
              raise MonsterKeyError(f"unsafe Monster Key runtime size: {before.st_size}")
          flags = os.O_RDONLY
          if hasattr(os, "O_NOFOLLOW"):
              flags |= os.O_NOFOLLOW
          descriptor = os.open(path, flags)
          try:
              current = os.fstat(descriptor)
              chunks: list[bytes] = []
              total = 0
              while True:
                  chunk = os.read(descriptor, min(65536, MAX_FILE_BYTES + 1 - total))
                  if not chunk:
                      break
                  chunks.append(chunk)
                  total += len(chunk)
                  if total > MAX_FILE_BYTES:
                      raise MonsterKeyError(f"Monster Key runtime object exceeds the read bound: {path}")
              payload = b"".join(chunks)
              after = os.fstat(descriptor)
          finally:
              os.close(descriptor)
          before_identity = (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns)
          current_identity = (current.st_dev, current.st_ino, current.st_size, current.st_mtime_ns, current.st_ctime_ns)
          after_identity = (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns)
          if before_identity != current_identity or current_identity != after_identity or len(payload) != before.st_size:
              raise MonsterKeyError(f"Monster Key runtime object changed while reading: {path}")
          return payload


      #@MNX-PART id=99.92.mnx-monsterkey.function.x11-environment kind=function title="Python function x11_environment"
      def x11_environment() -> dict[str, str]:
          environment = dict(os.environ)
          environment.setdefault("HOME", "/home/h0p3")
          environment.setdefault("DISPLAY", ":0")
          environment.setdefault("XAUTHORITY", "/home/h0p3/.Xauthority")
          environment.setdefault("XDG_RUNTIME_DIR", f"/run/user/{EXPECTED_UID}")
          environment.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path=/run/user/{EXPECTED_UID}/bus")
          authority = Path(environment["XAUTHORITY"])
          if not authority.is_absolute() or not authority.is_file() or authority.is_symlink():
              raise MonsterKeyError(f"Xauthority is unavailable or unsafe: {authority}")
          return environment


      #@MNX-PART id=99.92.mnx-monsterkey.function.open-display kind=function title="Python function open_display"
      def open_display(environment: dict[str, str]) -> xdisplay.Display:
          for key in ("HOME", "DISPLAY", "XAUTHORITY", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS"):
              os.environ[key] = environment[key]
          try:
              connection = xdisplay.Display(environment["DISPLAY"])
              connection.sync()
              return connection
          except Exception as error:
              raise MonsterKeyError(f"X11 display connection failed: {error}") from error


      #@MNX-PART id=99.92.mnx-monsterkey.function.wait-for-x11 kind=function title="Python function wait_for_x11"
      def wait_for_x11(timeout_seconds: int = 120) -> tuple[dict[str, str], xdisplay.Display]:
          deadline = time.monotonic() + timeout_seconds
          next_notice = 0.0
          last_error = "X11 session has not been examined"
          while time.monotonic() < deadline:
              try:
                  environment = x11_environment()
                  display_number_match = re.match(r"^:([0-9]+)(?:[.][0-9]+)?$", environment["DISPLAY"])
                  if not display_number_match:
                      raise MonsterKeyError(f"unsupported local X11 display spelling: {environment['DISPLAY']}")
                  socket_path = Path(f"/tmp/.X11-unix/X{display_number_match.group(1)}")
                  socket_info = socket_path.lstat()
                  if not stat.S_ISSOCK(socket_info.st_mode):
                      raise MonsterKeyError(f"X11 socket is not a socket: {socket_path}")
                  return environment, open_display(environment)
              except (MonsterKeyError, OSError) as error:
                  last_error = str(error)
              now = time.monotonic()
              if now >= next_notice:
                  print(f"monster_key_x11_wait={last_error}", flush=True)
                  next_notice = now + 15.0
              time.sleep(1.0)
          raise MonsterKeyError(f"X11 session did not become ready within {timeout_seconds}s: {last_error}")


      #@MNX-PART id=99.92.mnx-monsterkey.function.keysyms-for-keycode kind=function title="Python function keysyms_for_keycode"
      def keysyms_for_keycode(connection: xdisplay.Display, keycode: int = CAPS_KEYCODE) -> list[int]:
          rows = connection.get_keyboard_mapping(keycode, 1)
          if len(rows) != 1:
              raise MonsterKeyError(f"X11 returned an unexpected keymap row count for keycode {keycode}")
          values = [int(value) for value in rows[0]]
          if not values or len(values) > 32:
              raise MonsterKeyError(f"X11 returned an unsafe keysym width for keycode {keycode}: {len(values)}")
          return values


      #@MNX-PART id=99.92.mnx-monsterkey.function.modifier-rows kind=function title="Python function modifier_rows"
      def modifier_rows(connection: xdisplay.Display) -> list[list[int]]:
          rows = [[int(value) for value in row] for row in connection.get_modifier_mapping()]
          if len(rows) != 8:
              raise MonsterKeyError(f"X11 returned {len(rows)} modifier rows rather than 8")
          widths = {len(row) for row in rows}
          if not widths or len(widths) != 1 or next(iter(widths)) <= 0 or next(iter(widths)) > 64:
              raise MonsterKeyError(f"X11 returned unsafe modifier-row widths: {sorted(widths)}")
          for row in rows:
              nonzero = [value for value in row if value != 0]
              if len(nonzero) != len(set(nonzero)):
                  raise MonsterKeyError("X11 returned a modifier row with duplicate nonzero keycodes")
          return rows


      #@MNX-PART id=99.92.mnx-monsterkey.function.caps-modifier-slots kind=function title="Python function caps_modifier_slots"
      def caps_modifier_slots(rows: list[list[int]]) -> list[int]:
          return [index for index, row in enumerate(rows) if CAPS_KEYCODE in row]


      #@MNX-PART id=99.92.mnx-monsterkey.function.rewrite-caps-modifiers kind=function title="Python function rewrite_caps_modifiers"
      def rewrite_caps_modifiers(rows: list[list[int]], target_slots: list[int]) -> list[list[int]]:
          if len(rows) != 8:
              raise MonsterKeyError("modifier rewrite requires exactly eight rows")
          widths = {len(row) for row in rows}
          if not widths or len(widths) != 1:
              raise MonsterKeyError("modifier rewrite requires equal-width rows")
          if any(slot < 0 or slot >= 8 for slot in target_slots) or len(target_slots) != len(set(target_slots)):
              raise MonsterKeyError(f"invalid Caps modifier slots: {target_slots}")
          rewritten = [[0 if keycode == CAPS_KEYCODE else keycode for keycode in row] for row in rows]
          for slot in target_slots:
              try:
                  position = rewritten[slot].index(0)
              except ValueError:
                  for row in rewritten:
                      row.append(0)
                  position = len(rewritten[slot]) - 1
              rewritten[slot][position] = CAPS_KEYCODE
          for row in rewritten:
              nonzero = [value for value in row if value != 0]
              if len(nonzero) != len(set(nonzero)):
                  raise MonsterKeyError("modifier rewrite created a duplicate nonzero keycode")
          return rewritten


      #@MNX-PART id=99.92.mnx-monsterkey.function.monster-keysyms kind=function title="Python function monster_keysyms"
      def monster_keysyms(width: int) -> list[int]:
          if width <= 0 or width > 32:
              raise MonsterKeyError(f"unsafe Monster Key keysym width: {width}")
          return [HYPER_L] + [0] * (width - 1)


      #@MNX-PART id=99.92.mnx-monsterkey.function.lock-active kind=function title="Python function lock_active"
      def lock_active(connection: xdisplay.Display) -> bool:
          return bool(int(connection.screen().root.query_pointer().mask) & X.LockMask)


      #@MNX-PART id=99.92.mnx-monsterkey.function.set-lock-active kind=function title="Python function set_lock_active"
      def set_lock_active(active: bool) -> None:
          if not LIBX11.is_file():
              raise MonsterKeyError(f"libX11 is unavailable: {LIBX11}")
          library = ctypes.CDLL(str(LIBX11))
          library.XOpenDisplay.argtypes = [ctypes.c_char_p]
          library.XOpenDisplay.restype = ctypes.c_void_p
          library.XkbLockModifiers.argtypes = [
              ctypes.c_void_p,
              ctypes.c_uint,
              ctypes.c_uint,
              ctypes.c_uint,
          ]
          library.XkbLockModifiers.restype = ctypes.c_int
          library.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
          library.XSync.restype = ctypes.c_int
          library.XCloseDisplay.argtypes = [ctypes.c_void_p]
          library.XCloseDisplay.restype = ctypes.c_int
          handle = library.XOpenDisplay(None)
          if not handle:
              raise MonsterKeyError("libX11 could not open the current X11 display for modifier-lock control")
          try:
              values = X.LockMask if active else 0
              if library.XkbLockModifiers(handle, XKB_USE_CORE_KBD, X.LockMask, values) == 0:
                  raise MonsterKeyError("XkbLockModifiers rejected the Caps Lock state transition")
              library.XSync(handle, 0)
          finally:
              library.XCloseDisplay(handle)


      #@MNX-PART id=99.92.mnx-monsterkey.function.monster-state kind=function title="Python function monster_state"
      def monster_state(connection: xdisplay.Display) -> bool:
          keysyms = keysyms_for_keycode(connection)
          nonzero = [value for value in keysyms if value != 0]
          return (
              bool(nonzero)
              and all(value == HYPER_L for value in nonzero)
              and caps_modifier_slots(modifier_rows(connection)) == [MONSTER_MODIFIER_INDEX]
              and not lock_active(connection)
          )


      #@MNX-PART id=99.92.mnx-monsterkey.function.set-modifier-rows kind=function title="Python function set_modifier_rows"
      def set_modifier_rows(connection: xdisplay.Display, rows: list[list[int]], *, attempts: int = 30) -> None:
          for attempt in range(attempts):
              status = connection.set_modifier_mapping(rows)
              connection.sync()
              if status == X.MappingSuccess:
                  return
              if status == X.MappingBusy:
                  time.sleep(0.1)
                  continue
              raise MonsterKeyError(f"X11 rejected the modifier map with status {status}")
          raise MonsterKeyError("X11 modifier map remained busy; release modifier keys and retry")


      #@MNX-PART id=99.92.mnx-monsterkey.function.snapshot-record kind=function title="Python function snapshot_record"
      def snapshot_record(keysyms: list[int], slots: list[int], lock_was_active: bool) -> dict[str, Any]:
          record: dict[str, Any] = {
              "schema": SNAPSHOT_SCHEMA,
              "keycode": CAPS_KEYCODE,
              "keysyms": keysyms,
              "modifier_slots": slots,
              "lock_active": lock_was_active,
              "captured_monotonic_ns": time.monotonic_ns(),
          }
          validate_snapshot(record)
          return record


      #@MNX-PART id=99.92.mnx-monsterkey.function.validate-snapshot kind=function title="Python function validate_snapshot"
      def validate_snapshot(record: Any) -> dict[str, Any]:
          if not isinstance(record, dict) or record.get("schema") != SNAPSHOT_SCHEMA:
              raise MonsterKeyError("Monster Key snapshot schema differs")
          if record.get("keycode") != CAPS_KEYCODE:
              raise MonsterKeyError("Monster Key snapshot keycode differs")
          keysyms = record.get("keysyms")
          slots = record.get("modifier_slots")
          lock_was_active = record.get("lock_active")
          if not isinstance(keysyms, list) or not keysyms or len(keysyms) > 32:
              raise MonsterKeyError("Monster Key snapshot keysyms are invalid")
          if any(not isinstance(value, int) or value < 0 or value > 0xFFFFFFFF for value in keysyms):
              raise MonsterKeyError("Monster Key snapshot contains an invalid keysym")
          if not isinstance(slots, list) or any(not isinstance(value, int) for value in slots):
              raise MonsterKeyError("Monster Key snapshot modifier slots are invalid")
          if any(value < 0 or value >= 8 for value in slots) or len(slots) != len(set(slots)):
              raise MonsterKeyError("Monster Key snapshot modifier slots differ")
          if not isinstance(lock_was_active, bool):
              raise MonsterKeyError("Monster Key snapshot Caps Lock state is invalid")
          return record


      #@MNX-PART id=99.92.mnx-monsterkey.function.read-snapshot kind=function title="Python function read_snapshot"
      def read_snapshot(path: Path) -> dict[str, Any]:
          try:
              record = json.loads(validated_regular(path).decode("utf-8"))
          except (UnicodeDecodeError, json.JSONDecodeError) as error:
              raise MonsterKeyError(f"Monster Key snapshot is not canonical JSON: {error}") from error
          return validate_snapshot(record)


      #@MNX-PART id=99.92.mnx-monsterkey.function.write-runtime-state kind=function title="Python function write_runtime_state"
      def write_runtime_state(*, ready: bool, status: str, error: str = "none", key_grab_count: int = 0) -> None:
          root = ensure_runtime_root()
          payload = {
              "schema": STATE_SCHEMA,
              "pid": os.getpid(),
              "ready": ready,
              "status": status,
              "error": error[:2000],
              "keycode": CAPS_KEYCODE,
              "keysym": "Hyper_L",
              "modifier": "Mod3",
              "binding": "release:mod3+Escape",
              "key_grab_count": key_grab_count,
              "program_path": str(PROGRAM_PATH),
              "guardian_build_revision": GUARDIAN_BUILD_REVISION,
              "kodi_output_receipt_schema": KODI_OUTPUT_RECEIPT_SCHEMA,
              "updated_monotonic_ns": time.monotonic_ns(),
          }
          atomic_write(root / STATE_NAME, (json.dumps(payload, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8"))


      #@MNX-PART id=99.92.mnx-monsterkey.function.classify-toggle-failure kind=function title="Python function classify_toggle_failure"
      def classify_toggle_failure(stdout: str, stderr: str, returncode: int) -> str:
          combined = (stdout + "\n" + stderr).lower()
          if "resume refused while a monsternix secret prompt is active" in combined:
              return "secret-prompt-active"
          if "active control layout remained transiently unavailable after two seconds" in combined:
              return "control-layout-transition"
          if "active control refused symlink directory" in combined or "active control refused existing directory metadata" in combined:
              return "control-layout-unsafe"
          if "read-only file system" in combined or "active control requires an existing safe directory" in combined:
              return "control-layout-read-only-mismatch"
          if "no presslog recorder is active" in combined or "not recording" in combined:
              return "not-recording"
          if "signal delivery through the user manager failed" in combined:
              return "user-manager-signal-failed"
          if "recorder pid changed" in combined:
              return "recorder-pid-changed"
          if "transition was not confirmed" in combined:
              return "transition-unconfirmed"
          if "unsafe presslog status metadata" in combined or "status belongs to a different recorder pid" in combined:
              return "status-identity-invalid"
          if returncode == 75:
              return "transition-timeout-or-contention"
          return "presslog-toggle-nonzero"


      #@MNX-PART id=99.92.mnx-monsterkey.function.write-action-receipt kind=function title="Python function write_action_receipt"
      def write_action_receipt(
          *,
          source: str,
          outcome: str,
          action: str,
          paused: bool | None,
          presslog_rc: int,
          notification: str,
          detail: str,
      ) -> None:
          state = read_runtime_state()
          service_pid = state.get("pid")
          if not isinstance(service_pid, int) or service_pid <= 0:
              raise MonsterKeyError("Monster Key runtime service PID is invalid for the action receipt")
          allowed_sources = {"mod3-escape-release", "manual-command"}
          allowed_outcomes = {"pass", "review", "fail"}
          allowed_actions = {"pause", "resume", "none"}
          allowed_notifications = {"shown", "failed", "not-attempted"}
          if source not in allowed_sources or outcome not in allowed_outcomes or action not in allowed_actions:
              raise MonsterKeyError("Monster Key action receipt token is invalid")
          if notification not in allowed_notifications or not re.fullmatch(r"[a-z0-9-]{1,96}", detail):
              raise MonsterKeyError("Monster Key action receipt detail is invalid")
          if paused is not None and not isinstance(paused, bool):
              raise MonsterKeyError("Monster Key action receipt paused value is invalid")
          payload = {
              "schema": ACTION_SCHEMA,
              "service_pid": service_pid,
              "dispatcher_pid": os.getpid(),
              "source": source,
              "outcome": outcome,
              "action": action,
              "paused": paused,
              "presslog_rc": int(presslog_rc),
              "notification": notification,
              "detail": detail,
              "updated_monotonic_ns": time.monotonic_ns(),
          }
          atomic_write(
              ensure_runtime_root() / ACTION_NAME,
              (json.dumps(payload, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8"),
          )


      #@MNX-PART id=99.92.mnx-monsterkey.function.read-action-receipt kind=function title="Python function read_action_receipt"
      def read_action_receipt() -> dict[str, Any] | None:
          path = ensure_runtime_root() / ACTION_NAME
          if not path.exists():
              return None
          try:
              record = json.loads(validated_regular(path).decode("utf-8"))
          except (UnicodeDecodeError, json.JSONDecodeError) as error:
              raise MonsterKeyError(f"Monster Key action receipt is invalid: {error}") from error
          if not isinstance(record, dict) or record.get("schema") != ACTION_SCHEMA:
              raise MonsterKeyError("Monster Key action receipt schema differs")
          required = {
              "service_pid": int,
              "dispatcher_pid": int,
              "source": str,
              "outcome": str,
              "action": str,
              "presslog_rc": int,
              "notification": str,
              "detail": str,
              "updated_monotonic_ns": int,
          }
          for key, expected_type in required.items():
              if not isinstance(record.get(key), expected_type):
                  raise MonsterKeyError(f"Monster Key action receipt field differs: {key}")
          if record.get("paused") is not None and not isinstance(record.get("paused"), bool):
              raise MonsterKeyError("Monster Key action receipt paused field differs")
          return record


      #@MNX-PART id=99.92.mnx-monsterkey.function.apply-on-connection kind=function title="Python function apply_on_connection"
      def apply_on_connection(connection: xdisplay.Display) -> None:
          root = ensure_runtime_root()
          snapshot_path = root / SNAPSHOT_NAME
          current_keysyms = keysyms_for_keycode(connection)
          current_rows = modifier_rows(connection)
          currently_monster = monster_state(connection)
          if snapshot_path.exists():
              read_snapshot(snapshot_path)
          elif currently_monster:
              raise MonsterKeyError("Caps is already Monster-mapped but the pre-service snapshot is absent")
          else:
              record = snapshot_record(current_keysyms, caps_modifier_slots(current_rows), lock_active(connection))
              atomic_write(snapshot_path, (json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8"))
              print(f"monster_key_rollback_snapshot={snapshot_path}", flush=True)
          if currently_monster:
              return
          target_rows = rewrite_caps_modifiers(current_rows, [MONSTER_MODIFIER_INDEX])
          current_lock = lock_active(connection)
          try:
              set_lock_active(False)
              connection.change_keyboard_mapping(CAPS_KEYCODE, [monster_keysyms(len(current_keysyms))])
              set_modifier_rows(connection, target_rows)
              connection.sync()
              if not monster_state(connection):
                  raise MonsterKeyError("direct X11 mapping completed without the required live Monster Key state")
          except Exception:
              try:
                  connection.change_keyboard_mapping(CAPS_KEYCODE, [current_keysyms])
                  set_modifier_rows(connection, current_rows)
                  set_lock_active(current_lock)
                  connection.sync()
              except Exception as rollback_error:
                  print(f"monster_key_apply_rollback_error={rollback_error}", file=sys.stderr, flush=True)
              raise


      #@MNX-PART id=99.92.mnx-monsterkey.function.restore-on-connection kind=function title="Python function restore_on_connection"
      def restore_on_connection(connection: xdisplay.Display) -> str:
          root = ensure_runtime_root()
          snapshot_path = root / SNAPSHOT_NAME
          if not snapshot_path.exists():
              return "no-snapshot"
          snapshot = read_snapshot(snapshot_path)
          current_rows = modifier_rows(connection)
          connection.change_keyboard_mapping(CAPS_KEYCODE, [list(snapshot["keysyms"])])
          set_modifier_rows(connection, rewrite_caps_modifiers(current_rows, list(snapshot["modifier_slots"])))
          set_lock_active(bool(snapshot["lock_active"]))
          connection.sync()
          restored_keysyms = keysyms_for_keycode(connection)
          restored_slots = caps_modifier_slots(modifier_rows(connection))
          restored_lock = lock_active(connection)
          if (
              restored_keysyms != list(snapshot["keysyms"])
              or restored_slots != list(snapshot["modifier_slots"])
              or restored_lock is not bool(snapshot["lock_active"])
          ):
              raise MonsterKeyError(
                  "restored Caps semantics differ from the pre-service snapshot: "
                  f"keysyms={restored_keysyms} expected_keysyms={list(snapshot['keysyms'])} "
                  f"modifier_slots={restored_slots} expected_modifier_slots={list(snapshot['modifier_slots'])} "
                  f"lock_active={restored_lock} expected_lock_active={bool(snapshot['lock_active'])}"
              )
          snapshot_path.unlink()
          return "pre-service-keycode-and-modifier-membership-only"


      #@MNX-PART id=99.92.mnx-monsterkey.function.inspect-live-x11 kind=function title="Python function inspect_live_x11"
      def inspect_live_x11(connection: xdisplay.Display, *, emit: bool) -> dict[str, str]:
          if not monster_state(connection):
              keysyms = keysyms_for_keycode(connection)
              slots = caps_modifier_slots(modifier_rows(connection))
              raise MonsterKeyError(f"live Monster Key state differs: keysyms={keysyms} modifier_slots={slots}")
          result = {
              "schema": "mnx.monster-key.x11.v2",
              "physical_key": "Caps_Lock",
              "xkb_key": "<CAPS>",
              "keycode": str(CAPS_KEYCODE),
              "keysym": "Hyper_L",
              "modifier": "Mod3",
              "caps_lock_behavior": "disabled",
              "caps_lock_latched": "false",
              "binding": "release:mod3+Escape",
              "mapping_engine": "python-xlib-direct-keycode-and-modifier-map",
          }
          if emit:
              for key, value in result.items():
                  print(f"{key}={value}")
              print("MNX_MONSTER_KEY_X11=PASS")
          return result


      #@MNX-PART id=99.92.mnx-monsterkey.function.command-apply kind=function title="Python function command_apply"
      def command_apply() -> int:
          environment, connection = wait_for_x11()
          try:
              apply_on_connection(connection)
              inspect_live_x11(connection, emit=True)
          finally:
              connection.close()
          print("MNX_MONSTER_KEY_APPLY=PASS")
          return 0


      #@MNX-PART id=99.92.mnx-monsterkey.function.command-restore kind=function title="Python function command_restore"
      def command_restore() -> int:
          root = ensure_runtime_root()
          caps_result = 'no-snapshot'
          eye_result = 'unsupported-or-absent'
          environment = x11_environment()
          connection = open_display(environment)
          try:
              if (root / SNAPSHOT_NAME).exists():
                  caps_result = restore_on_connection(connection)
              eye_result = restore_monster_eye_from_record()
          finally:
