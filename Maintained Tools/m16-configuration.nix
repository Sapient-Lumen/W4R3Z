          require(hashlib.sha256(Path(packet['archive']).read_bytes()).hexdigest() == prior_archive_digest, 'prior completed archive was not restored after injected failure')
          cloudtainer_pack_record(fixture, Path(packet['packet']), replace=True, test_mode=True)
