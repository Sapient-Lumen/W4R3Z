        grep -Fq 'qbittorrent-cutover)' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: qBittorrent cutover continuation handler is missing' >&2; return 1; }
        grep -Fq '/run/current-system/sw/bin/monsterdesk qbittorrent-cutover' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: qBittorrent cutover does not invoke the accepted Monsterdesk implementation' >&2; return 1; }
