        TEST_REPORT="$report"
        TEST_CANDIDATE=
        TESTED_SYSTEM=
        TEST_BEHAVIOR_CHANGE_ALLOWED=0
        TEST_TEMPORARY_CODE_REGION_COUNT=0

        secure_evidence_file "$report" || { EVIDENCE_ERROR="test transcript is not a secure root-owned regular file: $report"; return 1; }

        if grep -q '^mnx_test_result=' "$report"; then
          TEST_KIND=mnx-test
          result="$(field_from_file "$report" mnx_test_result)"
          candidate="$(field_from_file "$report" candidate_snapshot)"
          candidate_sha="$(field_from_file "$report" candidate_configuration_sha256)"
          source_rc="$(field_from_file "$report" source_audit_rc)"
          post_rc="$(field_from_file "$report" post_test_audit_rc)"
          boot_changed="$(field_from_file "$report" boot_default_changed_by_mnx_test)"
          old_write="$(field_from_file "$report" old_storage_direct_write_by_mnx_test)"
          safe="$(field_from_file "$report" safe_to_run_operator_normal_switch)"
          contract_rc="$(field_from_file "$report" behavior_contract_rc)"
          rebuild_rc="$(field_from_file "$report" nixos_rebuild_test_rc)"
          tested_system="$(field_from_file "$report" temporary_running_system)"
          temporary_count="$(field_from_file "$report" temporary_code_region_count)"
          [[ -n "$temporary_count" ]] || temporary_count=0
          [[ "$temporary_count" == 0 ]] || { EVIDENCE_ERROR="test contains candidate-only temporary code and cannot be switched: count=$temporary_count"; return 1; }
          TEST_TEMPORARY_CODE_REGION_COUNT="$temporary_count"

          [[ "$result" == PASS* ]] || { EVIDENCE_ERROR="newest completed test for this source did not pass: $result"; return 1; }
          [[ "$source_rc" == 0 ]] || { EVIDENCE_ERROR="test source audit did not pass: $source_rc"; return 1; }
          [[ "$post_rc" == 0 ]] || { EVIDENCE_ERROR="test postflight did not pass: $post_rc"; return 1; }
          case "$rebuild_rc" in
            0|skipped-already-active) ;;
            *) EVIDENCE_ERROR="test did not complete a valid temporary activation: $rebuild_rc"; return 1 ;;
          esac
          [[ "$boot_changed" == no ]] || { EVIDENCE_ERROR="test did not prove the boot default remained unchanged: $boot_changed"; return 1; }
          [[ "$old_write" == no ]] || { EVIDENCE_ERROR="test did not prove old-storage remained untouched: $old_write"; return 1; }
          case "$safe" in
            yes*|not-needed*) ;;
            *) EVIDENCE_ERROR="test did not authorize a permanent switch: $safe"; return 1 ;;
          esac
          case "$contract_rc" in
            0|not-configured|"") ;;
            1)
              [[ "$result" == *WITH_BEHAVIOR_CHANGE* ]] || { EVIDENCE_ERROR="behavior contract differed without an explicit behavior-change result"; return 1; }
              TEST_BEHAVIOR_CHANGE_ALLOWED=1
              ;;
            *) EVIDENCE_ERROR="unexpected behavior-contract result: $contract_rc"; return 1 ;;
          esac
        elif grep -q '^mnx_bootstrap_test_result=' "$report"; then
          TEST_KIND=bootstrap-test
          result="$(field_from_file "$report" mnx_bootstrap_test_result)"
          candidate="$(field_from_file "$report" candidate)"
          candidate_sha="$(field_from_file "$report" candidate_sha256)"
          post_rc="$(field_from_file "$report" post_test_audit_rc)"
          rollback_rc="$(field_from_file "$report" rollback_rc)"
          old_write="$(field_from_file "$report" old_storage_direct_write_by_bootstrap)"
          safe="$(field_from_file "$report" safe_to_run_operator_normal_switch)"
          tested_system="$(field_from_file "$report" current_running_system)"
          temporary_count="$(field_from_file "$report" temporary_code_region_count)"
          [[ -n "$temporary_count" ]] || temporary_count=0
          [[ "$temporary_count" == 0 ]] || { EVIDENCE_ERROR="bootstrap contains candidate-only temporary code and cannot be switched: count=$temporary_count"; return 1; }
          TEST_TEMPORARY_CODE_REGION_COUNT="$temporary_count"
          behavior_allowed="$(field_from_file "$report" test_behavior_change_allowed)"
          case "$behavior_allowed" in
            0|1) TEST_BEHAVIOR_CHANGE_ALLOWED="$behavior_allowed" ;;
            *) EVIDENCE_ERROR="bootstrap behavior-change allowance is absent or invalid: $behavior_allowed"; return 1 ;;
          esac

          [[ "$result" == PASS ]] || { EVIDENCE_ERROR="candidate-owned bootstrap did not pass: $result"; return 1; }
          [[ "$post_rc" == 0 ]] || { EVIDENCE_ERROR="bootstrap postflight did not pass: $post_rc"; return 1; }
          [[ "$rollback_rc" == not-needed ]] || { EVIDENCE_ERROR="bootstrap required rollback: $rollback_rc"; return 1; }
          [[ "$old_write" == no ]] || { EVIDENCE_ERROR="bootstrap did not prove old-storage remained untouched: $old_write"; return 1; }
          if [[ -n "$safe" && "$safe" != yes* ]]; then
            EVIDENCE_ERROR="bootstrap did not authorize a permanent switch: $safe"
            return 1
          fi
        else
          EVIDENCE_ERROR="test transcript has no completed result marker"
          return 1
        fi

        [[ "$candidate_sha" == "$source_sha" ]] || { EVIDENCE_ERROR="test candidate hash differs from the live source"; return 1; }
        [[ -n "$candidate" ]] || { EVIDENCE_ERROR="test transcript does not identify its frozen candidate"; return 1; }
        secure_evidence_file "$candidate" || { EVIDENCE_ERROR="frozen candidate is not a secure root-owned regular file: $candidate"; return 1; }
        [[ "$(sha256sum "$candidate" | cut -d' ' -f1)" == "$source_sha" ]] || { EVIDENCE_ERROR="frozen candidate bytes differ from the tested source hash"; return 1; }
        [[ -n "$tested_system" ]] || { EVIDENCE_ERROR="test transcript does not identify the exact activated system closure"; return 1; }

        TEST_RESULT="$result"
        TEST_CANDIDATE="$candidate"
        TESTED_SYSTEM="$tested_system"
        return 0
      }

      #@MNX-PART id=99.20.mnx-switch.function.run-accepted-office-audit kind=function title="Function run_accepted_office_audit"
      run_accepted_office_audit() {
        env -u MNX_OFFICE_COMMIT_PENDING -u MNX_OFFICE_POST_COMMIT_SEAL \
          MNX_CONFIG="$CFG" "$CONFIG_AUDIT_BIN" quick > "$POST_AUDIT_LOG" 2>&1
      }

      #@MNX-PART id=99.20.mnx-switch.function.run-candidate-pending-audit kind=function title="Function run_candidate_pending_audit"
      run_candidate_pending_audit() {
        env -u MNX_OFFICE_POST_COMMIT_SEAL MNX_OFFICE_COMMIT_PENDING=1 \
          MNX_CONFIG="$CFG" "$CONFIG_AUDIT_BIN" quick > "$POST_AUDIT_LOG" 2>&1
      }

      #@MNX-PART id=99.20.mnx-switch.function.self_test kind=function title="Function self_test"
      self_test() {
        local tmp cfg invalid_cfg candidate tested sha pass fail bootstrap_pass selected uid fake_nix fake_audit activation_log activation_output already_active_slice accepted_audit_env candidate_audit_env
        tmp="$(mktemp -d)"
        trap 'rm -rf "$tmp"' RETURN
        cfg="$tmp/configuration.nix"
        candidate="$tmp/candidate.nix"
        printf '# MNX_POST_ACCEPTANCE_PLAN=presslog-rearm,presslog-recovery-qualify,desktop-audit,upgrade-build,restic-adopt-existing,restic-qualify-first-pair,restic-qualify-and-enable,restic-maintenance-recover,journal-integrity-anchor,journal-integrity-evidence,journal-integrity-recover-forward,nicotine-cutover,qbittorrent-cutover,cloudtainer-pack\n{ }\n' > "$cfg"
        invalid_cfg="$tmp/invalid-configuration.nix"
        printf '# MNX_POST_ACCEPTANCE_PLAN=desktop-audit,unknown-action\n{ }\n' > "$invalid_cfg"
        load_post_acceptance_plan "$cfg"
        [[ "$POST_ACCEPTANCE_PLAN" == presslog-rearm,presslog-recovery-qualify,desktop-audit,upgrade-build,restic-adopt-existing,restic-qualify-first-pair,restic-qualify-and-enable,restic-maintenance-recover,journal-integrity-anchor,journal-integrity-evidence,journal-integrity-recover-forward,nicotine-cutover,qbittorrent-cutover,cloudtainer-pack ]] || { echo 'MNX_SWITCH_SELF_TEST_ERROR: valid post-acceptance plan was not parsed' >&2; return 1; }
        if load_post_acceptance_plan "$invalid_cfg" >/dev/null 2>&1; then
          echo 'MNX_SWITCH_SELF_TEST_ERROR: unsupported post-acceptance action was accepted' >&2
          return 1
        fi
        load_post_acceptance_plan "$cfg"
        cp "$cfg" "$candidate"
        chmod 0600 "$cfg" "$candidate"
        tested="$tmp/nixos-system-tested"
        mkdir -p "$tested/bin"
        cp "$cfg" "$tested/configuration.nix"
        cat > "$tested/bin/switch-to-configuration" <<'FAKE_SWITCH'
      #!/bin/sh
      printf 'switch-to-configuration:%s\n' "$*" >> "$MNX_SWITCH_SELF_TEST_LOG"
      exit 0
      FAKE_SWITCH
        chmod 0755 "$tested/bin/switch-to-configuration"
        fake_nix="$tmp/nix-env"
        cat > "$fake_nix" <<'FAKE_NIX'
      #!/bin/sh
      printf 'nix-env:%s\n' "$*" >> "$MNX_SWITCH_SELF_TEST_LOG"
      exit 0
      FAKE_NIX
        chmod 0755 "$fake_nix"
        fake_audit="$tmp/mnx-config-audit"
        cat > "$fake_audit" <<'FAKE_AUDIT'
      #!/bin/sh
      {
        printf 'args=%s\n' "$*"
        env | grep '^MNX_OFFICE_' | sort || true
        printf 'MNX_CONFIG=%s\n' "''${MNX_CONFIG:-}"
      } > "$MNX_SWITCH_SELF_TEST_AUDIT_ENV"
      exit 0
      FAKE_AUDIT
        chmod 0755 "$fake_audit"
        uid="$(id -u)"
        export MNX_SWITCH_SELF_TEST_UID="$uid"
        REPORT_DIR="$tmp"
        sha="$(sha256sum "$cfg" | cut -d' ' -f1)"

        pass="$tmp/mnx-test-pass.txt"
        cat > "$pass" <<PASS
      mnx_test_result=PASS_ALREADY_ACTIVE_TEMPORARY_WITH_BEHAVIOR_CHANGE
      source_audit_rc=0
      post_test_audit_rc=0
      behavior_contract_rc=1
      nixos_rebuild_test_rc=0
      temporary_running_system=$tested
      candidate_snapshot=$candidate
      candidate_configuration_sha256=$sha
      safe_to_run_operator_normal_switch=yes
      boot_default_changed_by_mnx_test=no
      old_storage_direct_write_by_mnx_test=no
      temporary_code_region_count=0
      PASS
        chmod 0600 "$pass"

        fail="$tmp/mnx-test-fail.txt"
        cat > "$fail" <<FAIL
      mnx_test_result=FAIL_POSTFLIGHT
      candidate_snapshot=$candidate
      candidate_configuration_sha256=$sha
      FAIL
        chmod 0600 "$fail"
        touch -d '2 seconds ago' "$pass"
        touch "$fail"

        selected="$(find_latest_matching_test "$sha")"
        [[ "$selected" == "$fail" ]] || { echo "MNX_SWITCH_SELF_TEST_ERROR: newest matching transcript was not selected" >&2; return 1; }
        if load_test_evidence "$selected" "$sha"; then
          echo 'MNX_SWITCH_SELF_TEST_ERROR: failed test evidence was accepted' >&2
          return 1
        fi

        rm -f "$fail"
        selected="$(find_latest_matching_test "$sha")"
        [[ "$selected" == "$pass" ]] || { echo "MNX_SWITCH_SELF_TEST_ERROR: passing transcript was not selected" >&2; return 1; }
        load_test_evidence "$selected" "$sha" || { echo "MNX_SWITCH_SELF_TEST_ERROR: $EVIDENCE_ERROR" >&2; return 1; }
        [[ "$TEST_BEHAVIOR_CHANGE_ALLOWED" == 1 ]] || { echo 'MNX_SWITCH_SELF_TEST_ERROR: explicit behavior-change evidence was not recognized' >&2; return 1; }
        [[ "$TESTED_SYSTEM" == "$tested" ]] || { echo "MNX_SWITCH_SELF_TEST_ERROR: tested closure was not recovered: $TESTED_SYSTEM" >&2; return 1; }
        sed -i 's/^temporary_code_region_count=0$/temporary_code_region_count=1/' "$pass"
        if load_test_evidence "$pass" "$sha"; then
          echo 'MNX_SWITCH_SELF_TEST_ERROR: temporary-code evidence was accepted' >&2
          return 1
        fi
        sed -i 's/^temporary_code_region_count=1$/temporary_code_region_count=0/' "$pass"
        load_test_evidence "$pass" "$sha" || { echo "MNX_SWITCH_SELF_TEST_ERROR: clean evidence did not recover after temp rejection: $EVIDENCE_ERROR" >&2; return 1; }

        bootstrap_pass="$tmp/mnx-bootstrap-test-pass.txt"
        cat > "$bootstrap_pass" <<BOOTSTRAP_PASS
      mnx_bootstrap_test_result=PASS
      candidate=$candidate
      candidate_sha256=$sha
      current_running_system=$tested
      post_test_audit_rc=0
      test_behavior_change_allowed=1
      temporary_code_region_count=0
      rollback_rc=not-needed
      old_storage_direct_write_by_bootstrap=no
      safe_to_run_operator_normal_switch=yes
      BOOTSTRAP_PASS
        chmod 0600 "$bootstrap_pass"
        load_test_evidence "$bootstrap_pass" "$sha" || { echo "MNX_SWITCH_SELF_TEST_ERROR: bootstrap behavior evidence failed: $EVIDENCE_ERROR" >&2; return 1; }
        [[ "$TEST_KIND" == bootstrap-test && "$TEST_BEHAVIOR_CHANGE_ALLOWED" == 1 && "$TESTED_SYSTEM" == "$tested" ]] || {
          echo 'MNX_SWITCH_SELF_TEST_ERROR: bootstrap behavior-change evidence was not preserved' >&2
          return 1
        }

        activation_log="$tmp/activation.log"
        activation_output="$tmp/activation.out"
        export MNX_SWITCH_NIX_ENV="$fake_nix" MNX_SWITCH_SELF_TEST_LOG="$activation_log"
        export -f exact_activate
        ${pkgs.bash}/bin/bash -c 'exact_activate "$1"' mnx-switch-self-test "$tested" > "$activation_output"
        grep -Fxq 'mnx_profile_set_rc=0' "$activation_output" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: exact activation did not report profile success' >&2; return 1; }
        grep -Fxq 'mnx_switch_to_configuration_rc=0' "$activation_output" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: exact activation did not report switch success' >&2; return 1; }
        grep -Fq "nix-env:--profile /nix/var/nix/profiles/system --set $tested" "$activation_log" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: exact system profile assignment was not exercised' >&2; return 1; }
        grep -Fxq 'switch-to-configuration:switch' "$activation_log" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: exact switch-to-configuration action was not exercised' >&2; return 1; }
        unset MNX_SWITCH_NIX_ENV MNX_SWITCH_SELF_TEST_LOG

        chmod 0666 "$candidate"
        if load_test_evidence "$pass" "$sha"; then
          echo 'MNX_SWITCH_SELF_TEST_ERROR: writable candidate evidence was accepted' >&2
          return 1
        fi

        grep -Fq 'CORE_ACCEPTANCE_RESULT="$intended_result"' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: core acceptance result is not assigned only after seal success' >&2; return 1; }
        grep -Fq 'FAIL_POST_ACCEPTANCE_CONTRACT_AFTER_ACCEPTANCE' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: post-acceptance contract failure result is missing' >&2; return 1; }
        local forbidden_post_acceptance_rollback
        forbidden_post_acceptance_rollback='fail_core FAIL_POST_'"ACCEPTANCE_CONTRACT"
        if grep -Fq "$forbidden_post_acceptance_rollback" "$0"; then
          echo 'MNX_SWITCH_SELF_TEST_ERROR: post-acceptance still routes through the rollback-capable fail_core path' >&2
          return 1
        fi
        local finalize_slice
        finalize_slice="$(sed -n '/^finalize_accepted_switch()/,/^}/p' "$0")"
        if printf '%s\n' "$finalize_slice" | grep -Eq '^[[:space:]]*set [+-]e[[:space:]]*$'; then
          echo 'MNX_SWITCH_SELF_TEST_ERROR: accepted-switch finalization mutates the caller errexit option' >&2
          return 1
        fi
        grep -Fq 'if run_post_acceptance_plan; then' <<< "$finalize_slice" || {
          echo 'MNX_SWITCH_SELF_TEST_ERROR: continuation status is not captured through an errexit-safe conditional' >&2
          return 1
        }
        echo 'MNX_SWITCH_EVIDENCE_SELF_TEST=PASS'
        echo 'MNX_SWITCH_BOOTSTRAP_BEHAVIOR_EVIDENCE_SELF_TEST=PASS'
        echo 'MNX_SWITCH_EXACT_ACTIVATION_SELF_TEST=PASS'
        grep -Fq 'post_commit_seal "$base_result"' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: explicit base result is not passed into the seal' >&2; return 1; }
        grep -Fq 'MNX_OFFICE_POST_COMMIT_SEAL=1' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: explicit open-report seal authority is missing' >&2; return 1; }
        grep -Fq 'wait_for_heavy_units()' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: bounded maintenance wait is missing' >&2; return 1; }
        grep -Fq 'restartable_rsync_success_receipt_identity()' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: rsync success-receipt identity helper is missing' >&2; return 1; }
        grep -Fq 'request_restartable_rsync_preemption()' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: rsync-only preemption helper is missing' >&2; return 1; }
        grep -Fq 'refused-restart-policy' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: rsync restart-policy refusal is missing' >&2; return 1; }
        grep -Fq 'systemctl --no-block stop "$unit"' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: asynchronous manager-stop request is missing' >&2; return 1; }
        grep -Fq 'unexpected-main-exit' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: post-stop main-exit classifier is missing' >&2; return 1; }
        grep -Fq 'operator_preemption_success_receipt_advanced=false' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: retryable mirror interruption receipt is missing' >&2; return 1; }
        local heavy_slice lock_protected_slice contention_slice
        heavy_slice="$(sed -n '/^heavy_units()/,/^}/p' "$0")"
        lock_protected_slice="$(sed -n '/^lock_protected_maintenance_units()/,/^}/p' "$0")"
        contention_slice="$(sed -n '/^contention_only_units()/,/^}/p' "$0")"
        if grep -Fq 'fstrim.service' <<< "$heavy_slice"; then echo 'MNX_SWITCH_SELF_TEST_ERROR: fstrim remains an exclusive maintenance blocker' >&2; return 1; fi
        if grep -Fq 'btrfs-scrub-mnt-m16\x2dnew\x2dstorage.service' <<< "$heavy_slice"; then echo 'MNX_SWITCH_SELF_TEST_ERROR: throttled new-storage scrub remains an exclusive maintenance blocker' >&2; return 1; fi
        grep -Fq 'btrfs-scrub--.service' <<< "$heavy_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: root-filesystem scrub lost exclusion' >&2; return 1; }
        grep -Fq 'btrbk-main.service' <<< "$lock_protected_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: lock-protected maintenance classifier is missing' >&2; return 1; }
        grep -Fq 'fstrim.service' <<< "$contention_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: fstrim contention classifier is missing' >&2; return 1; }
        grep -Fq 'btrfs-scrub-mnt-m16\x2dnew\x2dstorage.service' <<< "$contention_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: new-storage scrub contention classifier is missing' >&2; return 1; }
        grep -Fq 'flock -w "$MAINTENANCE_POLL_SECONDS" -x 9' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: operator lane is not lock-first and bounded' >&2; return 1; }
        echo 'MNX_SWITCH_OPERATOR_MAINTENANCE_LANE_SELF_TEST=PASS'
        echo 'MNX_SWITCH_OPERATOR_PRIORITY_LANE_SELF_TEST=PASS'
                grep -Fq "grep -Fxq 'status=pass'" "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: successful continuation receipt skip rule is missing' >&2; return 1; }
        local continuation_slice rearm_slice recovery_qualify_slice
        continuation_slice="$(sed -n '/^run_post_acceptance_plan()/,/^}/p' "$0")"
        rearm_slice="$(sed -n '/^run_presslog_rearm_action()/,/^}/p' "$0")"
        recovery_qualify_slice="$(sed -n '/^run_presslog_recovery_qualify_action()/,/^}/p' "$0")"
        if grep -Fq "status=(pass|completed-with-blocker)" <<< "$continuation_slice"; then
          echo 'MNX_SWITCH_SELF_TEST_ERROR: a blocked continuation would be incorrectly treated as complete' >&2
          return 1
        fi
        grep -Fq 'presslog-recovery-qualify)' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification continuation handler is missing' >&2; return 1; }
        grep -Fq 'run_presslog_recovery_qualify_action()' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification proof function is missing' >&2; return 1; }
        grep -Fq '/etc/monsternix/bin/presslog recovery-drill' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification does not use the source-owned drill' >&2; return 1; }
        grep -Fq '${pkgs.coreutils}/bin/timeout --signal=TERM --kill-after=30s 3600s' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification lacks a bounded process-group timeout' >&2; return 1; }
        if grep -Fq '${pkgs.coreutils}/bin/timeout --foreground' <<< "$recovery_qualify_slice"; then echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification timeout would not own the process group' >&2; return 1; fi
        grep -Fq 'presslog_recovery_qualification_baseline_policy=normalize-safe-arm-to-clean-idle-before-any-secret-prompt' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification clean-idle baseline policy is missing' >&2; return 1; }
        grep -Fq 'presslog_recovery_qualification_baseline=armed-clean-idle' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification does not prove the clean-idle armed baseline' >&2; return 1; }
        grep -Fq 'presslog_recovery_qualification_pre_prompt_capture=stopped' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification does not prove capture stopped before prompts' >&2; return 1; }
        grep -Fq 'presslog_recovery_qualification_drill_prompt_count=5' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification drill prompt count is undisclosed' >&2; return 1; }
        grep -Fq 'presslog_recovery_qualification_post_success_rearm_prompt_count=1' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification final rearm prompt count is undisclosed' >&2; return 1; }
        grep -Fq 'presslog_recovery_qualification_post_success_rearm_attempt_limit=1' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification final rearm attempt is not bounded' >&2; return 1; }
        grep -Fq 'presslog_recovery_qualification_successful_first_try_dialog_count=6' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification first-try dialog count is missing' >&2; return 1; }
        grep -Fq 'presslog_recovery_qualification_original_password_attempt_limit=3' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification original-password attempt bound is missing' >&2; return 1; }
        grep -Fq 'presslog_recovery_qualification_maximum_dialog_count=8' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification maximum dialog count is missing' >&2; return 1; }
        grep -Fq 'presslog_recovery_qualification_retry_scope=verify-original-rc65-only' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification retry scope is missing' >&2; return 1; }
        grep -Fq 'max_original_attempts=3 max_rearm_attempts=1' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification implementation bounds differ' >&2; return 1; }
        if grep -Fq 'presslog_recovery_qualification_preliminary_rearm_prompt=' <<< "$recovery_qualify_slice"; then echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification regained a prompt before clean-idle normalization' >&2; return 1; fi
        grep -Fq '.recorder_active_before==false and .recorder_paused_before==false' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification does not bind the drill to an idle baseline' >&2; return 1; }
        grep -Fq '.recorder_active_restored==false and .recorder_paused_restored==false' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification permits drill-owned recorder restoration' >&2; return 1; }
        grep -Fq 'presslog_recovery_qualification_receipt_parse_stability=pass' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification receipt parse stability proof is missing' >&2; return 1; }
        grep -Fq 'run_presslog_rearm_action >"$rearm_out"' <<< "$recovery_qualify_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog recovery qualification lacks final paused rearm' >&2; return 1; }
