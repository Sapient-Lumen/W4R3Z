        "$PRESSLOG_GREP" -Fq -- '--no-auto-expire' /etc/monsternix/bin/presslog-service || die 'service wrapper lost durability switch' 70
        "$PRESSLOG_GREP" -Fq -- '--start-paused' /etc/monsternix/bin/presslog-service || die 'service wrapper lost start-paused privacy switch' 70
        "$PRESSLOG_GREP" -Fq -- '--foreground' /etc/monsternix/bin/presslog-service || die 'service wrapper lost foreground contract' 70
        "$PRESSLOG_GREP" -Fq -- '--asker tty' /etc/monsternix/bin/presslog-service || die 'service wrapper lost pipe-fed tty contract' 70
        "$PRESSLOG_GREP" -Fq '< <(' /etc/monsternix/bin/presslog-service || die 'service wrapper lost anonymous pipe transport' 70
        forbidden_asker='--asker ro'; forbidden_asker+='fi'
        ! "$PRESSLOG_GREP" -Fq -- "$forbidden_asker" /etc/monsternix/bin/presslog-service || die 'service wrapper regained rofi prompting' 70
        [[ -x $PRESSLOG_PINENTRY ]] || die 'source-owned pinentry adapter is unavailable' 70
        "$PRESSLOG_PINENTRY" --self-test
        (
          arm_test_root="$($PRESSLOG_MKTEMP -d)"
          trap '"$PRESSLOG_RM" -rf -- "$arm_test_root"' EXIT
          arm_test_marker="$arm_test_root/armed"
          arm_test_uid="$($PRESSLOG_ID -u)"
          arm_test_gid="$($PRESSLOG_ID -g)"
          [[ "$(classify_armed_marker_path "$arm_test_marker" "$arm_test_uid" "$arm_test_gid" /fixture/state)" == absent ]] || die 'armed-marker classifier absent fixture failed' 70
          {
            printf 'schema=mnx.presslog.arm.v1\n'
            printf 'state=/fixture/state\n'
            printf 'armed_at=2026-01-01T00:00:00Z\n'
            printf 'auto_expire=no\n'
            printf 'network=no\n'
          } > "$arm_test_marker"
          "$PRESSLOG_CHMOD" 0600 "$arm_test_marker"
          [[ "$(classify_armed_marker_path "$arm_test_marker" "$arm_test_uid" "$arm_test_gid" /fixture/state)" == safe ]] || die 'armed-marker classifier safe fixture failed' 70
          "$PRESSLOG_CHMOD" 0640 "$arm_test_marker"
          [[ "$(classify_armed_marker_path "$arm_test_marker" "$arm_test_uid" "$arm_test_gid" /fixture/state)" == unsafe ]] || die 'armed-marker classifier metadata fixture failed' 70
          "$PRESSLOG_CHMOD" 0600 "$arm_test_marker"
          printf 'extra=forbidden\n' >> "$arm_test_marker"
          [[ "$(classify_armed_marker_path "$arm_test_marker" "$arm_test_uid" "$arm_test_gid" /fixture/state)" == unsafe ]] || die 'armed-marker classifier extra-line fixture failed' 70
          "$PRESSLOG_RM" -f -- "$arm_test_marker"
          "$PRESSLOG_LN" -s /dev/null "$arm_test_marker"
          [[ "$(classify_armed_marker_path "$arm_test_marker" "$arm_test_uid" "$arm_test_gid" /fixture/state)" == unsafe ]] || die 'armed-marker classifier symlink fixture failed' 70
        )
        "$PRESSLOG_GREP" -Fq 'wait_for_recording' "$0" || die 'arm lost bounded recording confirmation' 70
        "$PRESSLOG_GREP" -Fq 'PRESSLOG_STATUS=REVIEW' "$0" || die 'failed status no longer reports review' 70
        "$PRESSLOG_GREP" -Fq 'command_pause_resume' "$0" || die 'pause/resume lost active-recorder control gate' 70
        "$PRESSLOG_GREP" -Fq 'require_existing_control_layout' "$0" || die 'hotkey control lost existing-layout-only preflight' 70
        "$PRESSLOG_GREP" -Fq 'presslog_control_layout=existing-read-only-home-compatible' "$0" || die 'hotkey control lost its read-only-home witness' 70
        "$PRESSLOG_GREP" -Fq 'presslog_control_layout_retry_count=' "$0" || die 'hotkey control lost bounded transient-layout retry evidence' 70
        "$PRESSLOG_GREP" -Fq 'active control layout remained transiently unavailable after two seconds' "$0" || die 'hotkey control lost bounded transient-layout failure classification' 70
        "$PRESSLOG_GREP" -Fq 'PRESSLOG_MONSTERKEY_RUNTIME_ROOT=/run/monsternix-monsterkey' "$0" || die 'hotkey control lost the shared service-runtime lock root' 70
        "$PRESSLOG_GREP" -Fq 'control_lock_path()' "$0" || die 'hotkey control lost shared lock selection' 70
        "$PRESSLOG_GREP" -Fq 'timed out acquiring the shared Presslog/Monster Key control lock' "$0" || die 'hotkey control lost shared lock enforcement' 70
        "$PRESSLOG_GREP" -Fq 'user_systemctl kill --kill-whom=main --signal="$signal" "$unit"' "$0" || die 'pause/resume lost user-manager signal delivery' 70
        direct_core_control='"$PRESSLOG_CORE" --state "$PRESSLOG_STATE_ROOT" '
        direct_core_control+='"$command"'
        ! "$PRESSLOG_GREP" -Fq "$direct_core_control" "$0" || die 'pause/resume regained direct helper invocation instead of user-manager PID control' 70
        "$PRESSLOG_GREP" -Fq 'command_toggle' "$0" || die 'toggle lost active-recorder state derivation' 70
        "$PRESSLOG_GREP" -Fq 'command_prompt_guard' "$0" || die 'secret-prompt PID-bound pause guard is missing' 70
        "$PRESSLOG_GREP" -Fq 'resume refused while a Monsternix secret prompt is active' "$0" || die 'secret-prompt resume refusal is missing' 70
        "$PRESSLOG_GREP" -Fq 'PRESSLOG_PROMPT_GUARD=PASS' "$0" || die 'secret-prompt guard completion marker is missing' 70
        "$PRESSLOG_GREP" -Fq 'PRESSLOG_TOGGLE=PASS' "$0" || die 'toggle lost confirmed completion marker' 70
        "$PRESSLOG_GREP" -Fq 'toggle refused because no Presslog recorder is active' "$0" || die 'stopped toggle no longer fails explicitly' 70
        "$PRESSLOG_GREP" -Fq 'PRESSLOG_PAUSE' "$0" || die 'pause lost confirmed completion marker' 70
        "$PRESSLOG_GREP" -Fq 'PRESSLOG_RESUME' "$0" || die 'resume lost confirmed completion marker' 70
        "$PRESSLOG_GREP" -Fq 'no Presslog recorder is active' "$0" || die 'stopped pause/resume no longer fails explicitly' 70
        "$PRESSLOG_GREP" -Fq 'presslog_failure_journal_payload_printed=false' "$0" || die 'failure summary content boundary is missing' 70
        "$PRESSLOG_GREP" -Fq 'InvocationID' "$0" || die 'failure summary lost exact systemd invocation identity' 70
        "$PRESSLOG_GREP" -Fq '_SYSTEMD_INVOCATION_ID' "$0" || die 'failure journal is not scoped to the exact invocation' 70
        "$PRESSLOG_GREP" -Fq 'presslog_failure_invocation_id=' "$0" || die 'failure summary omits invocation metadata' 70
        "$PRESSLOG_GREP" -Fq 'presslog_failure_journal_scope=' "$0" || die 'failure summary omits journal scope' 70
        "$PRESSLOG_GREP" -Fq 'run_core_with_prompt' "$0" || die 'inspection commands lost source-owned pinentry transport' 70
        "$PRESSLOG_GREP" -Fq 'wait_for_stopped' "$0" || die 'stop lost bounded process-death verification' 70
        "$PRESSLOG_GREP" -Fq 'unit_main_pid' "$0" || die 'stop lost main-process identity verification' 70
        "$PRESSLOG_GREP" -Fq 'persistent auto-start was removed' "$0" || die 'failed first arm no longer revokes newly created persistence' 70
        "$PRESSLOG_GREP" -Fq 'existing persistent auto-start was retained' "$0" || die 'failed reauthentication no longer preserves a preexisting arm' 70
        "$PRESSLOG_GREP" -Fq 'a concurrent explicit disarm remains authoritative' "$0" || die 'failed reauthentication would no longer respect explicit disarm' 70
        "$PRESSLOG_GREP" -Fq 'blocked-stopped-explicitly-disarmed' "$0" || die 'accepted recovery lost its explicit-disarm blocker state' 70
        "$PRESSLOG_GREP" -Fq 'classify_armed_marker_path' "$0" || die 'stable armed-marker classifier is missing' 70
        "$PRESSLOG_GREP" -Fq 'command_recover_armed' "$0" || die 'accepted armed recovery command is missing' 70
        "$PRESSLOG_GREP" -Fq 'PRESSLOG_RECOVER_ARMED=PASS' "$0" || die 'accepted armed recovery completion marker is missing' 70
        "$PRESSLOG_GREP" -Fq 'PRESSLOG_RECOVER_ARMED=SKIP_NOT_ARMED' "$0" || die 'explicit disarm recovery skip marker is missing' 70
        "$PRESSLOG_GREP" -Fq 'prior private state restored atomically' "$0" || die 'import rollback lost staged atomic restore' 70
        "$PRESSLOG_GREP" -Fq '"$PRESSLOG_SYNC" -f "$backup"' "$0" || die 'import backup lost durability sync' 70
        "$PRESSLOG_GREP" -Fq 'return "$restart_rc"' "$0" || die 'import no longer propagates recorder restart failure' 70
        "$PRESSLOG_GREP" -Fq 'canonical_status_document' "$0" || die 'canonical status generator is missing' 70
        "$PRESSLOG_GREP" -Fq 'mnx.presslog.wrapper-status.v3' "$0" || die 'canonical status schema is missing' 70
        "$PRESSLOG_GREP" -Fq 'command_recovery_drill' "$0" || die 'recovery drill command is missing' 70
        "$PRESSLOG_GREP" -Fq 'recovery_drill_finalize() {' "$0" || die 'recovery drill finalizer function is missing' 70
        "$PRESSLOG_GREP" -Fq 'trap recovery_drill_finalize EXIT' "$0" || die 'recovery drill lost guaranteed finalization' 70
        stale_recovery_trap='trap finalize_recovery_'
        stale_recovery_trap+='drill EXIT'
        ! "$PRESSLOG_GREP" -Fq "$stale_recovery_trap" "$0" || die 'recovery drill regained the stale nonexistent finalizer name' 70
        "$PRESSLOG_GREP" -Fq 'disposable-deep-verify' "$0" || die 'recovery drill disposable verification is missing' 70
        "$PRESSLOG_GREP" -Fq 'plaintext_exported:false' "$0" || die 'recovery receipt content boundary is missing' 70
        printf 'PRESSLOG_CANONICAL_STATUS_SELF_TEST=PASS\n'
        printf 'PRESSLOG_RECOVERY_DRILL_SELF_TEST=PASS\n'
        printf 'PRESSLOG_FAILURE_CLASSIFIER_SELF_TEST=PASS\n'
        printf 'PRESSLOG_READ_ONLY_HOTKEY_CONTROL_SELF_TEST=PASS\n'
        printf 'PRESSLOG_CONTROL_LAYOUT_RETRY_SELF_TEST=PASS\n'
        printf 'PRESSLOG_SHARED_RUNTIME_LOCK_SELF_TEST=PASS\n'
        printf 'PRESSLOG_STATUS_NEWLINE_SELF_TEST=PASS\n'
        printf 'PRESSLOG_START_PAUSED_SELF_TEST=PASS\n'
        printf 'PRESSLOG_SECRET_PROMPT_GUARD_SELF_TEST=PASS\n'
        printf 'PRESSLOG_ARMED_RECOVERY_SELF_TEST=PASS\n'
        printf 'PRESSLOG_WRAPPER_SELF_TEST=PASS\n'
      }

      #@MNX-PART id=99.88.presslog.function.usage kind=function title="Bash function usage"
      usage() {
        "$PRESSLOG_CAT" <<'USAGE'
      usage: presslog COMMAND [ARGS...]

      Lifecycle:
        arm | start       Persistently arm and start the normal encrypted recorder.
                          Pinentry-qt asks before capture; the recorder then starts paused.
                          First use asks twice, requires explicit later resume, and retains no armed marker on failure.
        stop | lock       Stop and zeroize keys; keep the armed marker for next login.
        disarm            Stop and remove the persistent armed marker.
        burn              Start an unpersisted-key burn session paused; unreadable after stop.
        pause | resume    Require one active recorder, signal its user-service MainPID, and confirm the same PID-bound transition.
        toggle            Derive that recorder's confirmed state and switch pause/resume without mutating home layout.
        mark              Add a SIGHUP marker to the encrypted journal.
        status [--json]   Print one canonical human or JSON metadata record; failed state is REVIEW/nonzero.
        recovery-drill    Stop safely, deep-verify/export/import/deep-verify, then restore an active recorder paused.
        recover-armed --switch-owned
                          Recover only a preexisting safe arm into a confirmed paused recorder; never creates consent.
        armed-status      Validate only the nonsecret armed marker grammar and metadata.

      Inspection and recovery (recorder is stopped first and restarted if necessary):
        read [ARGS...]    Verify manifests, then decrypt to this terminal.
        grep [ARGS...]    Verify manifests, then decrypt and search.
        verify [--deep]   Verify manifests; --deep authenticates every encrypted frame.
        pin ARGS...       Extend key retention.
        archive-export --out FILE   Deep-verify, then make a separately encrypted private-state archive.
        archive-import --in FILE    Explicitly gated private-state replacement with automatic local rollback copy.
        expire [--yes]    Dry-run freely; --yes requires the exact destructive capability token.
        gc [--yes]        Dry-run freely; --yes requires the exact destructive capability token.

      Diagnostics:
        doctor | policy | self-test | self-test-prompt-lock | help

      This is a local encrypted keystroke journal. While active it records everything
      h0p3 types, including passwords entered into other applications. Passwords move
      from source-owned pinentry-qt to the core only through an anonymous pipe while
      capture is stopped. Capture begins only after a later explicit resume. Monsternix evidence sees metadata only and never reads or exports
      journal, salt, keystore, password, archive passphrase, or decrypted content.
      USAGE
      }

      #@MNX-PART id=99.88.presslog.function.main kind=function title="Bash function main"
      main() {
        local command initial_marker_state
        command="$(requested_command "''${1:-help}")"
        if [[ $command == self-test-prompt-lock ]]; then
          [[ $# == 1 ]] || die 'self-test-prompt-lock takes no arguments' 64
          command_prompt_lock_self_test
          return $?
        fi
        require_operator "$command"
        require_fixed_state
        case "$command" in
          help|-h|--help) usage; return 0 ;;
          policy) command_policy; return 0 ;;
          self-test) command_self_test; return 0 ;;
          armed-status)
            shift
            [[ $# == 0 ]] || die 'armed-status takes no arguments' 64
            command_armed_status
            return $?
            ;;
        esac
        if [[ $command == recover-armed ]]; then
          [[ $# == 2 && ''${2:-} == --switch-owned ]] || die 'recover-armed requires the exact --switch-owned capability spelling' 64
          initial_marker_state="$(armed_marker_state)"
          case "$initial_marker_state" in
            absent)
              printf 'presslog_recover_armed_state=not-armed\nmanual_resume_required=true\nPRESSLOG_RECOVER_ARMED=SKIP_NOT_ARMED\n'
              return 0
              ;;
            safe) ensure_state_layout ;;
            *) die 'recover-armed refused an unsafe armed marker without mutating state' 74 ;;
          esac
        else
          case "$command" in
            pause|resume|toggle|mark)
              require_existing_control_layout
              ;;
            prompt-guard)
              prompt_lock_path >/dev/null
              ;;
            *)
              ensure_state_layout
              ;;
          esac
        fi
        acquire_control_lock
        case "$command" in
          resume|toggle) require_prompt_resume_allowed ;;
          prompt-guard) require_prompt_guard_lease ;;
        esac
        case "$command" in
          arm|start)
            shift
            [[ $# == 0 ]] || die "$command takes no arguments" 64
            start_normal
            ;;
          stop|lock)
            shift
            [[ $# == 0 ]] || die "$command takes no arguments" 64
            stop_units
            printf 'PRESSLOG_STOP=PASS\n'
            ;;
          disarm)
            shift
            [[ $# == 0 ]] || die 'disarm takes no arguments' 64
            stop_units
            "$PRESSLOG_RM" -f -- "$PRESSLOG_ARMED_MARKER"
            printf 'PRESSLOG_DISARM=PASS\n'
            ;;
          burn)
            shift
            [[ $# == 0 ]] || die 'burn takes no arguments' 64
            start_burn
            ;;
          pause|resume)
            shift
            [[ $# == 0 ]] || die "$command takes no arguments" 64
            command_pause_resume "$command"
            ;;
          toggle)
            shift
            [[ $# == 0 ]] || die 'toggle takes no arguments' 64
            command_toggle
            ;;
          prompt-guard)
            shift
            [[ $# == 0 ]] || die 'prompt-guard takes no arguments' 64
            command_prompt_guard
            ;;
          mark)
            shift
            [[ $# == 0 ]] || die 'mark takes no arguments' 64
            if unit_active "$PRESSLOG_NORMAL_UNIT"; then
              user_systemctl kill --kill-whom=main --signal=HUP "$PRESSLOG_NORMAL_UNIT"
            elif unit_active "$PRESSLOG_BURN_UNIT"; then
              user_systemctl kill --kill-whom=main --signal=HUP "$PRESSLOG_BURN_UNIT"
            else
              die 'not recording' 69
            fi
            printf 'PRESSLOG_MARK=PASS\n'
            ;;
          status)
            shift
            [[ $# -le 1 ]] || die 'status accepts at most --json' 64
            command_status "''${1:-human}"
            ;;
          recovery-drill)
            shift
            [[ $# == 0 ]] || die 'recovery-drill takes no arguments' 64
            command_recovery_drill
            ;;
          recover-armed)
            shift
            [[ $# == 1 && ''${1:-} == --switch-owned ]] || die 'recover-armed requires --switch-owned' 64
            command_recover_armed
            ;;
          doctor)
            shift
            [[ $# == 0 ]] || die 'doctor takes no arguments' 64
            command_doctor
            ;;
          read|grep)
            shift
            run_stopped_core shallow presslog "$command" "$@"
            ;;
          verify)
            shift
            if [[ " $* " == *' --deep '* ]]; then run_stopped_core none presslog verify "$@"; else run_stopped_core none none verify "$@"; fi
            ;;
          pin)
            shift
            run_stopped_core shallow none pin "$@"
            ;;
          archive-export)
            shift
            run_stopped_core deep archive-create archive-export "$@"
            ;;
          archive-import)
            shift
            command_import "$@"
            ;;
          expire)
            shift
            if [[ " $* " == *' --yes '* ]]; then require_destructive_token; run_stopped_core deep none expire "$@"; else run_stopped_core shallow none expire "$@"; fi
            ;;
          gc)
            shift
            if [[ " $* " == *' --yes '* ]]; then require_destructive_token; run_stopped_core shallow none gc "$@"; else run_stopped_core shallow none gc "$@"; fi
            ;;
          *) die "unknown command: $command" 64 ;;
        esac
      }

      main "$@"
      '';
      checkPhase = ''
        set -Eeuo pipefail
        ${pkgs.bash}/bin/bash -n "$out"
        "$out" self-test-prompt-lock
        ${pkgs.gnugrep}/bin/grep -Fq 'automatic_expiry=false' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'backup_wide_crypto_shred_claim=false' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'PRESSLOG_STATUS=REVIEW' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'mnx.presslog.wrapper-status.v3' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'PRESSLOG_RECOVERY_DRILL=PASS' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'disposable-deep-verify' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'startup_record_state' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'current_boot_id' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'recovery_drill_finalize() {' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'trap recovery_drill_finalize EXIT' "$out"
        PRESSLOG_STALE_RECOVERY_TRAP='trap finalize_recovery_'
        PRESSLOG_STALE_RECOVERY_TRAP+='drill EXIT'
        ! ${pkgs.gnugrep}/bin/grep -Fq "$PRESSLOG_STALE_RECOVERY_TRAP" "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'PRESSLOG_RECOVERY_DRILL=FAIL' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'command_pause_resume' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'command_toggle' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'PRESSLOG_CONTROL_LAYOUT_RETRY_SELF_TEST=PASS' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'active control layout remained transiently unavailable after two seconds' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'command_prompt_guard' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'classify_armed_marker_path' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'command_armed_status' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'command_recover_armed' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'PRESSLOG_ARMED_RECOVERY_SELF_TEST=PASS' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'PRESSLOG_RECOVER_ARMED=PASS' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'PRESSLOG_RECOVER_ARMED=SKIP_NOT_ARMED' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'existing persistent auto-start was retained' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'PRESSLOG_PROMPT_GUARD=PASS' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'resume refused while a Monsternix secret prompt is active' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'PRESSLOG_TOGGLE=PASS' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'toggle refused because no Presslog recorder is active' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'PRESSLOG_PAUSE' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'PRESSLOG_RESUME' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'no Presslog recorder is active' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'presslog_failure_journal_payload_printed=false' "$out"
        PRESSLOG_BOUNDED_JOURNAL_FUNCTION="$(${pkgs.gawk}/bin/awk '
          /^#@MNX-PART id=99[.]88[.]presslog[.]function[.]bounded-unit-journal / { capture=1 }
          capture && /^#@MNX-PART id=99[.]88[.]presslog[.]function[.]classify-unit-failure / { exit }
          capture { print }
        ' "$out")"
        ${pkgs.gnugrep}/bin/grep -Fq 'invocation="$(unit_property "$unit" InvocationID)"' <<<"$PRESSLOG_BOUNDED_JOURNAL_FUNCTION"
        ${pkgs.gnugrep}/bin/grep -Fq '"_SYSTEMD_INVOCATION_ID=$invocation"' <<<"$PRESSLOG_BOUNDED_JOURNAL_FUNCTION"
        [[ "$(${pkgs.gnugrep}/bin/grep -Fc '"_SYSTEMD_INVOCATION_ID=$invocation"' <<<"$PRESSLOG_BOUNDED_JOURNAL_FUNCTION")" == 1 ]]
        PRESSLOG_FAILURE_SUMMARY_FUNCTION="$(${pkgs.gawk}/bin/awk '
          /^#@MNX-PART id=99[.]88[.]presslog[.]function[.]print-unit-failure-summary / { capture=1 }
          capture && /^#@MNX-PART id=99[.]88[.]presslog[.]function[.]unit-active / { exit }
          capture { print }
        ' "$out")"
        ${pkgs.gnugrep}/bin/grep -Fq 'presslog_failure_invocation_id=%s' <<<"$PRESSLOG_FAILURE_SUMMARY_FUNCTION"
        ${pkgs.gnugrep}/bin/grep -Fq 'presslog_failure_journal_scope=%s' <<<"$PRESSLOG_FAILURE_SUMMARY_FUNCTION"
        ${pkgs.gnugrep}/bin/grep -Fq 'scope=exact-invocation' <<<"$PRESSLOG_FAILURE_SUMMARY_FUNCTION"
        ${pkgs.gnugrep}/bin/grep -Fq 'run_core_with_prompt' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq -- '--archive-create' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq -- '--thumbdrive-existing-presslog-existing' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'persistent auto-start was removed' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'return "$restart_rc"' "$out"
        forbidden_asker='--asker ro'; forbidden_asker+='fi'
        ! ${pkgs.gnugrep}/bin/grep -Fq -- "$forbidden_asker" "$out"
        ! ${pkgs.gnugrep}/bin/grep -Fq -- '--force' "$out"
        echo 'PRESSLOG_WRAPPER_DERIVATION_CHECK=PASS'
      '';
    };
    mode = "0755";
