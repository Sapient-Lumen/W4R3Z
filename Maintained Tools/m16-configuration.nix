        grep -Fq '[[ "$POST_ACCEPTANCE_PLAN" != restic-backup-reconcile,cloudtainer-pack ]]' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Restic backup reconciliation lacks its exact plan gate' >&2; return 1; }
        grep -Fq 'post_acceptance_continue_after_blocker=restic-backup-reconcile:76,next=cloudtainer-pack' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Restic backup blocker does not continue only to Cloudtainer' >&2; return 1; }
        grep -Fq 'mnx restic maintenance-recover --switch-owned' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Restic maintenance recovery does not use the source-owned accepted-switch command' >&2; return 1; }
        grep -Fq 'post_acceptance_continue_after_blocker=restic-maintenance-recover:%s,next=cloudtainer-pack' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Restic maintenance blocker does not continue only to Cloudtainer' >&2; return 1; }
        grep -Fq 'journal-integrity-recover-forward)' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: journal recovery continuation handler is missing' >&2; return 1; }
        grep -Fq 'mnx incident journal recover-forward --switch-owned' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: journal recovery does not use the source-owned accepted-switch command' >&2; return 1; }
        grep -Fq 'MNX_JOURNAL_OBSERVER_PROOF=PASS' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: accepted journal recovery does not prove the periodic observer through systemd' >&2; return 1; }
        grep -Fq 'journal_observer_verification_rerun=yes' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: accepted journal recovery does not disclose its observer rerun' >&2; return 1; }
        grep -Fq 'journal_observer_notification_expected=none-for-known-clean-forward-state' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: accepted journal observer proof lacks its notification expectation' >&2; return 1; }
        grep -Fq 'journal_observer_namespace_wide_verify_run=no' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: accepted journal observer proof does not prohibit namespace-wide live verification' >&2; return 1; }
        grep -Fq 'journal_observer_namespace_identity_stability_checked=yes' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: accepted journal observer proof lacks namespace identity stability evidence' >&2; return 1; }
        grep -Fq '[[ "$POST_ACCEPTANCE_PLAN" != restic-maintenance-recover,journal-integrity-recover-forward,cloudtainer-pack && "$POST_ACCEPTANCE_PLAN" != journal-integrity-recover-forward,cloudtainer-pack ]]' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: journal recovery continuation lacks its exact accepted plan gate' >&2; return 1; }
        grep -Fq 'post_acceptance_continue_after_blocker=journal-integrity-recover-forward:76,next=cloudtainer-pack' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: journal recovery blocker does not continue only to Cloudtainer' >&2; return 1; }
        grep -Fq 'post_acceptance_short_circuit=journal-integrity-recover-forward:unexpected-plan' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: journal recovery cannot fail closed on an unexpected continuation plan' >&2; return 1; }
        CONFIG_AUDIT_BIN="$fake_audit"
        CFG="$cfg"
        accepted_audit_env="$tmp/accepted-audit.env"
        candidate_audit_env="$tmp/candidate-audit.env"
        POST_AUDIT_LOG="$tmp/accepted-audit.log"
        export MNX_SWITCH_SELF_TEST_AUDIT_ENV="$accepted_audit_env"
        MNX_OFFICE_COMMIT_PENDING=poison MNX_OFFICE_POST_COMMIT_SEAL=poison run_accepted_office_audit
        grep -Fxq 'args=quick' "$accepted_audit_env" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: accepted-state audit command was not exercised' >&2; return 1; }
        grep -Fxq "MNX_CONFIG=$cfg" "$accepted_audit_env" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: accepted-state audit did not receive the candidate path' >&2; return 1; }
        if grep -Eq '^MNX_OFFICE_(COMMIT_PENDING|POST_COMMIT_SEAL)=' "$accepted_audit_env"; then
          echo 'MNX_SWITCH_SELF_TEST_ERROR: accepted-state audit leaked candidate or open-seal authority' >&2
          return 1
        fi
        POST_AUDIT_LOG="$tmp/candidate-audit.log"
        export MNX_SWITCH_SELF_TEST_AUDIT_ENV="$candidate_audit_env"
        MNX_OFFICE_COMMIT_PENDING=poison MNX_OFFICE_POST_COMMIT_SEAL=poison run_candidate_pending_audit
        grep -Fxq 'MNX_OFFICE_COMMIT_PENDING=1' "$candidate_audit_env" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: candidate audit lacks explicit commit-pending authority' >&2; return 1; }
        if grep -q '^MNX_OFFICE_POST_COMMIT_SEAL=' "$candidate_audit_env"; then
          echo 'MNX_SWITCH_SELF_TEST_ERROR: candidate audit leaked post-commit seal authority' >&2
          return 1
        fi
        unset MNX_SWITCH_SELF_TEST_AUDIT_ENV
        already_active_slice="$(sed -n '/^if \[\[ .*ACTIVE_SHA_BEFORE.*DEFAULT_SHA_BEFORE/,/^echo .activation_policy=profile-set-and-switch-exact-tested-closure-without-channel-reevaluation./p' "$0")"
        grep -Fq 'already_active_office_audit_mode=accepted' <<< "$already_active_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: already-active accepted-state audit marker is missing' >&2; return 1; }
        grep -Fq 'run_accepted_office_audit' <<< "$already_active_slice" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: already-active accepted-state audit invocation is missing' >&2; return 1; }
        if grep -Fq 'run_candidate_pending_audit' <<< "$already_active_slice"; then
          echo 'MNX_SWITCH_SELF_TEST_ERROR: already-active branch still invokes candidate commit-pending audit' >&2
          return 1
        fi
        grep -Fq 'activation_office_audit_mode=commit-pending' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: real activation commit-pending audit marker is missing' >&2; return 1; }
        echo 'MNX_SWITCH_ALREADY_ACTIVE_OFFICE_SELF_TEST=PASS'
        echo 'MNX_SWITCH_CORE_FINAL_RESULT_SELF_TEST=PASS'
        echo 'MNX_SWITCH_MAINTENANCE_WAIT_SELF_TEST=PASS'
        echo 'MNX_POST_ACCEPTANCE_SELF_TEST=PASS' 
      }

      case "$SUBCOMMAND" in
        self-test)
          self_test
          exit 0
          ;;
        help|-h|--help)
          cat <<'USAGE'
      mnx switch
          Permanently activate only the exact frozen candidate accepted by the newest completed
          successful `mnx test` for the current configuration.nix hash. The command serializes
          against testing and storage maintenance, saves a complete transcript, rolls back the
          boot profile and running system on activation/postflight failure, and adopts a new
          behavior baseline only when the accepted test explicitly used --allow-behavior-change.
          It never re-evaluates the channel: it pins and activates the exact NixOS closure left
          running by the successful test. A deliberate behavior change gets a new immutable
          accepted-* baseline; the previous pinned baseline remains historical evidence. Before taking
          transaction locks, switch queues for the shared storage lock first; scheduled jobs skip instead of overtaking it, while root scrub remains boundedly exclusive and new-storage scrub is advisory. It requires the
          source and tested running closure to remain exact. After core acceptance and a strict office/doctor seal,
          switch releases its transaction and storage locks
          and runs the source-declared bounded post-acceptance plan. Ordinary continuation blockers are
          recorded as next-stage evidence and do not roll back the accepted system.

      Rare recovery/inspection commands for ChatGPT:
          mnx switch --rerun-post-acceptance
          mnx switch-status
          mnx switch-cancel
          mnx switch-recover
          mnx switch-summary
          mnx switch-errors
          mnx switch-raw [activation|audit|baseline|office|support|state|report]
      USAGE
          exit 0
          ;;
      esac

      if [[ "''${EUID:-$(id -u)}" -ne 0 ]]; then
        [[ -x /run/wrappers/bin/sudo ]] || { echo '/run/wrappers/bin/sudo is unavailable' >&2; exit 126; }
        exec /run/wrappers/bin/sudo -- /etc/monsternix/bin/mnx-switch "''${RAW_ARGS[@]}"
      fi

      case "$SUBCOMMAND" in
        status)
          if [[ -s "$RUNTIME_STATE" ]]; then
            cat "$RUNTIME_STATE"
            pid="$(field_from_file "$RUNTIME_STATE" pid)"
            if process_is_mnx_switch "$pid"; then echo 'state=active'; else echo 'state=stale'; fi
          else
            echo 'state=idle'
          fi
          latest="$(latest_switch_report)"
          [[ -z "$latest" ]] || { printf 'latest_report=%s\n' "$latest"; grep -E '^(mnx_switch_result|phase|candidate_configuration_sha256|test_result|switch_rebuild_rc|switch_profile_set_rc|switch_activation_rc|tested_system|post_switch_audit_rc|behavior_contract_rc|behavior_baseline_replaced|accepted_behavior_baseline|baseline_adoption_started|baseline_adoption_committed|baseline_adoption_rc|office_commit_rc|office_record|office_commit_committed|post_commit_seal_rc|core_acceptance_result|post_acceptance_plan|post_acceptance_status|post_acceptance_rc|post_acceptance_action_results|post_acceptance_mutation_proof|post_acceptance_receipt|post_acceptance_locks_released|rollback_rc|running_system|default_system|MNX_SWITCH=)' "$latest" | tail -n 60 || true; }
          exit 0
          ;;
        cancel)
          [[ -s "$RUNTIME_STATE" ]] || { echo 'no active mnx switch state exists'; exit 0; }
          pid="$(field_from_file "$RUNTIME_STATE" pid)"
          process_is_mnx_switch "$pid" || { echo 'mnx switch state is stale; use mnx switch-recover' >&2; exit 1; }
          kill -TERM "$pid"
          echo "cancellation_requested_for_pid=$pid"
          exit 0
          ;;
        summary)
          latest="$(latest_switch_report)"
          [[ -n "$latest" && -r "$latest" ]] || { echo 'no completed mnx switch transcript exists' >&2; exit 1; }
          grep -E '^(mnx_switch_result|phase|candidate_configuration_sha256|test_report|test_result|switch_rebuild_rc|switch_profile_set_rc|switch_activation_rc|tested_system|post_switch_audit_rc|behavior_contract_rc|behavior_baseline_replaced|accepted_behavior_baseline|baseline_adoption_started|baseline_adoption_committed|baseline_adoption_rc|office_commit_rc|office_record|office_commit_committed|post_commit_seal_rc|core_acceptance_result|post_acceptance_plan|post_acceptance_status|post_acceptance_rc|post_acceptance_action_results|post_acceptance_mutation_proof|post_acceptance_receipt|post_acceptance_locks_released|support_report_rc|rollback_rc|running_system|default_system|source_mutated_during_switch|old_storage_direct_write_by_mnx_switch|MNX_SWITCH=)' "$latest"
          exit 0
          ;;
        errors)
          latest="$(latest_switch_report)"
          [[ -n "$latest" && -r "$latest" ]] || { echo 'no completed mnx switch transcript exists' >&2; exit 1; }
          grep -E '^(mnx_switch_result|phase|.*_rc=|.*_log=|rollback_|MNX_SWITCH_)' "$latest" | tail -n 120 || true
          log="$(field_from_file "$latest" rebuild_log)"
          [[ -z "$log" || ! -r "$log" ]] || tail -n 220 "$log"
          exit 0
          ;;
        raw)
          latest="$(latest_switch_report)"
          [[ -n "$latest" && -r "$latest" ]] || { echo 'no completed mnx switch transcript exists' >&2; exit 1; }
          which="''${1:-report}"
          case "$which" in
            report) target="$latest" ;;
            activation|rebuild) target="$(field_from_file "$latest" rebuild_log)" ;;
            audit) target="$(field_from_file "$latest" post_audit_log)" ;;
            baseline) target="$(field_from_file "$latest" baseline_log)" ;;
            support) target="$(field_from_file "$latest" support_log)" ;;
            office) target="$(field_from_file "$latest" office_log)" ;;
            state) target="$(field_from_file "$latest" state_file)" ;;
            *) echo "unknown switch raw phase: $which" >&2; exit 64 ;;
          esac
          [[ -n "$target" && -r "$target" ]] || { echo "switch artifact is unavailable: ''${target:-unknown}" >&2; exit 1; }
          cat "$target"
          exit 0
          ;;
      esac

      install -d -m 2750 -o root -g logbook "$REPORT_DIR"
      install -d -m 0755 -o root -g root "$RUNTIME_DIR"

      if [[ "$SUBCOMMAND" == recover ]]; then
        [[ -s "$RUNTIME_STATE" ]] || { echo 'no stale mnx switch state exists'; exit 0; }
        parent="$(field_from_file "$RUNTIME_STATE" pid)"
        if process_is_mnx_switch "$parent"; then
          echo "mnx switch is still active as pid $parent; use mnx switch-cancel" >&2
          exit 1
        fi
        prior_default="$(field_from_file "$RUNTIME_STATE" prior_default)"
        prior_pinned_behavior="$(field_from_file "$RUNTIME_STATE" prior_pinned_behavior)"
        prior_office_record="$(field_from_file "$RUNTIME_STATE" prior_office_record)"
        office_commit_committed="$(field_from_file "$RUNTIME_STATE" office_commit_committed)"
        baseline_adoption_started="$(field_from_file "$RUNTIME_STATE" baseline_adoption_started)"
        behavior_baseline_replaced="$(field_from_file "$RUNTIME_STATE" behavior_baseline_replaced)"
        accepted_baseline_dir="$(field_from_file "$RUNTIME_STATE" accepted_baseline_dir)"
        child_pgid="$(field_from_file "$RUNTIME_STATE" child_pgid)"
        [[ -z "$child_pgid" || ! "$child_pgid" =~ ^[0-9]+$ ]] || kill -TERM -- "-$child_pgid" 2>/dev/null || true
        systemctl stop nixos-rebuild-switch-to-configuration.service 2>/dev/null || true
        [[ -n "$prior_default" && -x "$prior_default/bin/switch-to-configuration" ]] || { echo 'stale state has no usable prior boot-default closure' >&2; exit 1; }
        nix-env --profile /nix/var/nix/profiles/system --set "$prior_default"
        "$prior_default/bin/switch-to-configuration" switch
        if [[ "$baseline_adoption_started" == 1 || "$behavior_baseline_replaced" == yes ]]; then
          if [[ -n "$prior_pinned_behavior" && -s "$prior_pinned_behavior/manifest.txt" ]]; then
            ln -sfn "$(basename "$prior_pinned_behavior")" /var/lib/logbook/baselines/pinned
          else
            rm -f /var/lib/logbook/baselines/pinned
          fi
          if [[ -n "$accepted_baseline_dir" && "$accepted_baseline_dir" != none && "$accepted_baseline_dir" != "$prior_pinned_behavior" ]]; then
            rm -rf -- "$accepted_baseline_dir"
          fi
        fi
        current_office_record="$(readlink -f /var/lib/monsternix/office/current.json 2>/dev/null || true)"
        install -d -m 0750 -o root -g logbook /var/lib/monsternix/office /var/lib/monsternix/office/records
        rm -f /var/lib/monsternix/office/.current.recover.$$
        if [[ -n "$prior_office_record" && -f "$prior_office_record" && "$prior_office_record" == /var/lib/monsternix/office/records/* ]]; then
          ln -s "records/$(basename "$prior_office_record")" /var/lib/monsternix/office/.current.recover.$$
          mv -Tf /var/lib/monsternix/office/.current.recover.$$ /var/lib/monsternix/office/current.json
        else
          rm -f /var/lib/monsternix/office/current.json
        fi
        if [[ -n "$current_office_record" && "$current_office_record" != "$prior_office_record" && -f "$current_office_record" && "$current_office_record" == /var/lib/monsternix/office/records/* ]]; then
          rm -f -- "$current_office_record"
        fi
        rm -f "$RUNTIME_STATE"
        echo 'MNX_SWITCH_RECOVERY=PASS'
        exit 0
      fi

      STAMP="$(date +%Y%m%dT%H%M%S)-$$"
      REPORT_BASE="$REPORT_DIR/mnx-switch-$STAMP"
      REPORT="$REPORT_BASE.txt"
      REBUILD_LOG="$REPORT_BASE.rebuild.log"
      POST_AUDIT_LOG="$REPORT_BASE.post-audit.log"
      BASELINE_LOG="$REPORT_BASE.baseline.log"
      SUPPORT_LOG="$REPORT_BASE.support.log"
      OFFICE_LOG="$REPORT_BASE.office.log"
      POST_COMMIT_SEAL_LOG="$REPORT_BASE.post-commit-seal.log"
      POST_ACCEPTANCE_LOG="$REPORT_BASE.post-acceptance.log"
      STATE_FILE="$REPORT_BASE.state"
      START_EPOCH="$(date +%s)"

      PHASE=preflight
      FINAL_RESULT=INCOMPLETE
      EXIT_CODE=1
      CHILD_PID=
      CHILD_PGID=
      TAIL_PID=
      INTERRUPTED_SIGNAL=none
      PRIOR_RUNNING="$(readlink -f /run/current-system 2>/dev/null || true)"
      PRIOR_DEFAULT="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
      PRIOR_PINNED_BEHAVIOR="$(readlink -f /var/lib/logbook/baselines/pinned 2>/dev/null || true)"
      PRIOR_OFFICE_RECORD="$(readlink -f /var/lib/monsternix/office/current.json 2>/dev/null || true)"
      SOURCE_SHA=
      CANONICAL_LINEAGE_CHECKPOINTS=none
      ACTIVE_SHA_BEFORE=
      TEST_REPORT=none
      TEST_RESULT=none
      TEST_CANDIDATE=none
      TEST_KIND=none
      TEST_BEHAVIOR_CHANGE_ALLOWED=0
      SWITCH_REBUILD_RC=not-run
      PROFILE_SET_RC=not-run
      SWITCH_ACTIVATION_RC=not-run
      SWITCH_STARTED=0
      POST_AUDIT_RC=not-run
      BEHAVIOR_CONTRACT_RC=not-run
      BEHAVIOR_BASELINE_REPLACED=no
      BASELINE_ADOPTION_STARTED=0
      BASELINE_ADOPTION_COMMITTED=0
      ACCEPTED_BASELINE_NAME=none
      ACCEPTED_BASELINE_DIR=none
      BASELINE_ADOPTION_RC=not-needed
      SUPPORT_RC=not-run
      OFFICE_COMMIT_RC=not-run
      OFFICE_RECORD=none
      OFFICE_COMMIT_COMMITTED=0
      POST_COMMIT_SEAL_RC=not-run
      CORE_ACCEPTANCE_RESULT=not-committed
      POST_ACCEPTANCE_PLAN=unknown
      POST_ACCEPTANCE_STATUS=not-run
      POST_ACCEPTANCE_RC=not-run
      POST_ACCEPTANCE_ACTION_RESULTS=none
      POST_ACCEPTANCE_MUTATION_PROOF=unknown
      POST_ACCEPTANCE_RECEIPT=none
      POST_ACCEPTANCE_LOCKS_RELEASED=no
      ROLLBACK_RC=not-needed
      SOURCE_MUTATED=unknown
      MAINTENANCE_WAITED_SECONDS=0
      MAINTENANCE_WAIT_UNITS=none
      CONTENTION_ADVISORY_UNITS=none
      OPERATOR_PREEMPTION_ATTEMPTED=no
      OPERATOR_PREEMPTION_REQUESTED=no
      OPERATOR_PREEMPTION_RESULT=not-needed
      OPERATOR_PREEMPTION_UNIT=none
      OPERATOR_PREEMPTION_MAIN_PID=0
      OPERATOR_PREEMPTION_INVOCATION_ID=none
      OPERATOR_PREEMPTION_SUCCESS_RECEIPT_BEFORE=not-observed
      OPERATOR_PREEMPTION_SUCCESS_RECEIPT_AFTER=not-observed

      exec > >(tee "$REPORT") 2>&1

      #@MNX-PART id=99.20.mnx-switch.function.write_state kind=function title="Function write_state"
      write_state() {
        local tmp="$RUNTIME_STATE.tmp.$$"
        {
          printf 'pid=%s\n' "$$"
          printf 'phase=%s\n' "$PHASE"
          printf 'child_pid=%s\n' "$CHILD_PID"
          printf 'child_pgid=%s\n' "$CHILD_PGID"
          printf 'prior_running=%s\n' "$PRIOR_RUNNING"
          printf 'prior_default=%s\n' "$PRIOR_DEFAULT"
          printf 'prior_pinned_behavior=%s\n' "$PRIOR_PINNED_BEHAVIOR"
          printf 'prior_office_record=%s\n' "$PRIOR_OFFICE_RECORD"
          printf 'office_commit_committed=%s\n' "$OFFICE_COMMIT_COMMITTED"
          printf 'office_record=%s\n' "$OFFICE_RECORD"
          printf 'post_commit_seal_rc=%s\n' "$POST_COMMIT_SEAL_RC"
          printf 'core_acceptance_result=%s\n' "$CORE_ACCEPTANCE_RESULT"
          printf 'post_acceptance_plan=%s\n' "$POST_ACCEPTANCE_PLAN"
          printf 'post_acceptance_status=%s\n' "$POST_ACCEPTANCE_STATUS"
          printf 'post_acceptance_rc=%s\n' "$POST_ACCEPTANCE_RC"
          printf 'post_acceptance_action_results=%s\n' "$POST_ACCEPTANCE_ACTION_RESULTS"
          printf 'post_acceptance_mutation_proof=%s\n' "$POST_ACCEPTANCE_MUTATION_PROOF"
          printf 'post_acceptance_receipt=%s\n' "$POST_ACCEPTANCE_RECEIPT"
          printf 'maintenance_waited_seconds=%s\n' "$MAINTENANCE_WAITED_SECONDS"
          printf 'maintenance_wait_units=%s\n' "$MAINTENANCE_WAIT_UNITS"
          printf 'contention_advisory_units=%s\n' "$CONTENTION_ADVISORY_UNITS"
          printf 'operator_preemption_requested=%s\n' "$OPERATOR_PREEMPTION_REQUESTED"
          printf 'operator_preemption_result=%s\n' "$OPERATOR_PREEMPTION_RESULT"
          printf 'operator_preemption_unit=%s\n' "$OPERATOR_PREEMPTION_UNIT"
          printf 'operator_preemption_main_pid=%s\n' "$OPERATOR_PREEMPTION_MAIN_PID"
          printf 'operator_preemption_invocation_id=%s\n' "$OPERATOR_PREEMPTION_INVOCATION_ID"
          printf 'operator_preemption_success_receipt_before=%s\n' "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_BEFORE"
          printf 'operator_preemption_success_receipt_after=%s\n' "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_AFTER"
          printf 'behavior_baseline_replaced=%s\n' "$BEHAVIOR_BASELINE_REPLACED"
          printf 'baseline_adoption_started=%s\n' "$BASELINE_ADOPTION_STARTED"
          printf 'baseline_adoption_committed=%s\n' "$BASELINE_ADOPTION_COMMITTED"
          printf 'accepted_baseline_name=%s\n' "$ACCEPTED_BASELINE_NAME"
          printf 'accepted_baseline_dir=%s\n' "$ACCEPTED_BASELINE_DIR"
          printf 'candidate=%s\n' "$TEST_CANDIDATE"
          printf 'source_sha256=%s\n' "$SOURCE_SHA"
          printf 'report=%s\n' "$REPORT"
          printf 'rebuild_log=%s\n' "$REBUILD_LOG"
          printf 'post_commit_seal_log=%s\n' "$POST_COMMIT_SEAL_LOG"
          printf 'post_acceptance_log=%s\n' "$POST_ACCEPTANCE_LOG"
        } > "$tmp"
        chmod 0600 "$tmp"
        mv -f "$tmp" "$RUNTIME_STATE"
        cp -f "$RUNTIME_STATE" "$STATE_FILE" 2>/dev/null || true
      }

      #@MNX-PART id=99.20.mnx-switch.function.set_phase kind=function title="Function set_phase"
      set_phase() {
        PHASE="$1"
        write_state
      }

      #@MNX-PART id=99.20.mnx-switch.function.stop_tail kind=function title="Function stop_tail"
      stop_tail() {
        [[ -z "$TAIL_PID" ]] || { kill "$TAIL_PID" 2>/dev/null || true; wait "$TAIL_PID" 2>/dev/null || true; TAIL_PID=; }
      }

      #@MNX-PART id=99.20.mnx-switch.function.terminate_child_group kind=function title="Function terminate_child_group"
      terminate_child_group() {
        stop_tail
        systemctl stop nixos-rebuild-switch-to-configuration.service 2>/dev/null || true
        if [[ -n "$CHILD_PGID" && "$CHILD_PGID" =~ ^[0-9]+$ ]]; then
          kill -TERM -- "-$CHILD_PGID" 2>/dev/null || true
          sleep 2
          kill -KILL -- "-$CHILD_PGID" 2>/dev/null || true
        elif [[ -n "$CHILD_PID" ]]; then
          kill -TERM "$CHILD_PID" 2>/dev/null || true
        fi
        [[ -z "$CHILD_PID" ]] || wait "$CHILD_PID" 2>/dev/null || true
        CHILD_PID=
        CHILD_PGID=
        write_state
      }

      #@MNX-PART id=99.20.mnx-switch.function.restore_prior_behavior_baseline kind=function title="Function restore_prior_behavior_baseline"
      restore_prior_behavior_baseline() {
        (( BASELINE_ADOPTION_STARTED == 1 )) || [[ "$BEHAVIOR_BASELINE_REPLACED" == yes ]] || return 0
        if [[ -n "$PRIOR_PINNED_BEHAVIOR" && -s "$PRIOR_PINNED_BEHAVIOR/manifest.txt" ]]; then
          ln -sfn "$(basename "$PRIOR_PINNED_BEHAVIOR")" /var/lib/logbook/baselines/pinned
        else
          rm -f /var/lib/logbook/baselines/pinned
        fi
        if [[ -n "$ACCEPTED_BASELINE_DIR" && "$ACCEPTED_BASELINE_DIR" != none && "$ACCEPTED_BASELINE_DIR" != "$PRIOR_PINNED_BEHAVIOR" ]]; then
          rm -rf -- "$ACCEPTED_BASELINE_DIR"
        fi
        BEHAVIOR_BASELINE_REPLACED=no
        BASELINE_ADOPTION_STARTED=0
        BASELINE_ADOPTION_COMMITTED=0
        write_state
      }

      #@MNX-PART id=99.20.mnx-switch.function.restore_prior_office_record kind=function title="Function restore_prior_office_record"
      restore_prior_office_record() {
        local current=/var/lib/monsternix/office/current.json
        local root=/var/lib/monsternix/office
        local tmp="$root/.current.restore.$$"
        local superseded
        superseded="$(readlink -f "$current" 2>/dev/null || true)"
        install -d -m 0750 -o root -g logbook "$root" "$root/records"
        rm -f "$tmp"
        if [[ -n "$PRIOR_OFFICE_RECORD" && -f "$PRIOR_OFFICE_RECORD" && "$PRIOR_OFFICE_RECORD" == "$root/records/"* ]]; then
          ln -s "records/$(basename "$PRIOR_OFFICE_RECORD")" "$tmp"
          mv -Tf "$tmp" "$current"
        else
          rm -f "$current"
        fi
        if [[ -n "$superseded" && "$superseded" != "$PRIOR_OFFICE_RECORD" && -f "$superseded" && "$superseded" == "$root/records/"* ]]; then
          rm -f -- "$superseded"
        fi
        OFFICE_COMMIT_COMMITTED=0
        OFFICE_RECORD=none
        write_state
      }

      #@MNX-PART id=99.20.mnx-switch.function.rollback_prior_default kind=function title="Function rollback_prior_default"
      rollback_prior_default() {
        local profile_rc=0 activate_rc=0 current_default current_running
        if (( ROLLBACK_ON_FAILURE == 0 )); then
          ROLLBACK_RC=disabled
          return 0
        fi
        [[ -n "$PRIOR_DEFAULT" && -x "$PRIOR_DEFAULT/bin/switch-to-configuration" ]] || { ROLLBACK_RC=unavailable; return 1; }
        set_phase rollback
        systemctl stop nixos-rebuild-switch-to-configuration.service 2>/dev/null || true
        set +e
        nix-env --profile /nix/var/nix/profiles/system --set "$PRIOR_DEFAULT"
        profile_rc=$?
        "$PRIOR_DEFAULT/bin/switch-to-configuration" switch
        activate_rc=$?
        set -e
        current_default="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
        current_running="$(readlink -f /run/current-system 2>/dev/null || true)"
        if (( profile_rc == 0 && activate_rc == 0 )) && [[ "$current_default" == "$PRIOR_DEFAULT" && "$current_running" == "$PRIOR_DEFAULT" ]]; then
          restore_prior_behavior_baseline || true
          restore_prior_office_record || true
          ROLLBACK_RC=0
          return 0
        fi
        ROLLBACK_RC="profile-$profile_rc-activate-$activate_rc"
        return 1
      }

      #@MNX-PART id=99.20.mnx-switch.function.run_logged_child kind=function title="Function run_logged_child"
      run_logged_child() {
        local phase_name="$1" logfile="$2"
        shift 2
        local rc start now bytes lastline
        set_phase "$phase_name"
        : > "$logfile"
        start="$(date +%s)"
        if [[ "$SWITCH_TIMEOUT" == 0 ]]; then
          setsid --wait "$@" > "$logfile" 2>&1 &
        else
          setsid --wait timeout --signal=TERM --kill-after=30s "$SWITCH_TIMEOUT" "$@" > "$logfile" 2>&1 &
        fi
        CHILD_PID="$!"
        CHILD_PGID="$(ps -o pgid= -p "$CHILD_PID" 2>/dev/null | tr -d ' ' || true)"
        write_state
        if (( VERBOSE == 1 )); then
          tail -n +1 -F --pid="$CHILD_PID" "$logfile" &
          TAIL_PID="$!"
        fi
        while kill -0 "$CHILD_PID" 2>/dev/null; do
          for _ in $(seq 1 20); do sleep 1; kill -0 "$CHILD_PID" 2>/dev/null || break; done
          kill -0 "$CHILD_PID" 2>/dev/null || break
          if (( VERBOSE == 0 )); then
            now="$(date +%s)"
            bytes="$(stat -c '%s' "$logfile" 2>/dev/null || echo 0)"
            lastline="$(tail -n 1 "$logfile" 2>/dev/null || true)"
            printf '%s phase=%s elapsed=%ss log_bytes=%s last=%s\n' "$(date -Is)" "$phase_name" "$((now-start))" "$bytes" "$lastline"
          fi
        done
        set +e
        wait "$CHILD_PID"
        rc=$?
        set -e
        stop_tail
        CHILD_PID=
        CHILD_PGID=
        write_state
        return "$rc"
      }

      #@MNX-PART id=99.20.mnx-switch.function.run_support kind=function title="Function run_support"
      run_support() {
        [[ "$SUPPORT_POLICY" != never ]] || { SUPPORT_RC=skipped-policy-never; return 0; }
        set_phase support
        set +e
        SINCE="@$START_EPOCH" MAX_JOURNAL=180 /etc/monsternix/bin/mnx-support-report > "$SUPPORT_LOG" 2>&1
        SUPPORT_RC=$?
        set -e
        printf 'support_report_rc=%s\nsupport_log=%s\n' "$SUPPORT_RC" "$SUPPORT_LOG"
        grep -E '^(system_state=|old_storage_written=|[0-9]+ loaded units listed|selected_reachable_endpoint=|MNX_SUPPORT_REPORT_COMPLETE=)' "$SUPPORT_LOG" 2>/dev/null | tail -n 40 || true
      }

      #@MNX-PART id=99.20.mnx-switch.function.show_failure_context kind=function title="Function show_failure_context"
      show_failure_context() {
        local file="$1"
        [[ -r "$file" ]] || return 0
        printf '\n--- selected error contexts from %s ---\n' "$file"
        grep -nE -B4 -A10 '(^|[^[:alpha:]])(error|failed|failure|fatal|traceback|assertion)([^[:alpha:]]|$)|command not found|syntax error' "$file" | tail -n 240 || true
        printf '\n--- final 220 lines from %s ---\n' "$file"
        tail -n 220 "$file" || true
      }

      #@MNX-PART id=99.20.mnx-switch.function.fail_core kind=function title="Function fail_core"
      fail_core() {
        local result="$1" message="$2" code="''${3:-1}"
        FINAL_RESULT="$result"
        printf 'MNX_SWITCH_ERROR: %s\n' "$message" >&2
        terminate_child_group
        if (( SWITCH_STARTED == 1 )); then rollback_prior_default || true; fi
        show_failure_context "$REBUILD_LOG"
        show_failure_context "$POST_AUDIT_LOG"
        show_failure_context "$POST_COMMIT_SEAL_LOG"
        show_failure_context "$POST_ACCEPTANCE_LOG"
        run_support || true
        EXIT_CODE="$code"
        exit "$code"
      }

      #@MNX-PART id=99.20.mnx-switch.function.handle_signal kind=function title="Function handle_signal"
      handle_signal() {
        local signal="$1" code="$2"
        INTERRUPTED_SIGNAL="$signal"
        terminate_child_group
        if [[ "$PHASE" == post-acceptance && "$POST_COMMIT_SEAL_RC" == 0 && "$OFFICE_COMMIT_COMMITTED" == 1 ]]; then
          POST_ACCEPTANCE_STATUS=interrupted
          POST_ACCEPTANCE_RC="$code"
          FINAL_RESULT="''${CORE_ACCEPTANCE_RESULT}_WITH_POST_ACCEPTANCE_INTERRUPTED"
          EXIT_CODE="$code"
          write_state
          exit "$code"
        fi
        FINAL_RESULT="INTERRUPTED_''${PHASE^^}"
        if (( SWITCH_STARTED == 1 )); then rollback_prior_default || true; fi
        EXIT_CODE="$code"
        exit "$code"
      }

      #@MNX-PART id=99.20.mnx-switch.function.finish kind=function title="Function finish"
      finish() {
        local rc="$?"
        trap - EXIT INT TERM HUP
        stop_tail
        [[ -z "$CHILD_PID" ]] || terminate_child_group
        PHASE=finished
        for artifact in "$REPORT" "$REBUILD_LOG" "$POST_AUDIT_LOG" "$BASELINE_LOG" "$SUPPORT_LOG" "$OFFICE_LOG" "$POST_COMMIT_SEAL_LOG" "$POST_ACCEPTANCE_LOG" "$STATE_FILE"; do
          [[ -e "$artifact" ]] || continue
          chown root:logbook "$artifact" 2>/dev/null || true
          chmod 0640 "$artifact" 2>/dev/null || true
        done
        ln -sfn "$(basename "$REPORT")" "$REPORT_DIR/mnx-switch-latest.txt" 2>/dev/null || true
        if [[ -f "$RUNTIME_STATE" ]] && grep -Fxq "pid=$$" "$RUNTIME_STATE" 2>/dev/null; then rm -f "$RUNTIME_STATE"; fi
        [[ "$FINAL_RESULT" != INCOMPLETE ]] || FINAL_RESULT=FAIL_HARNESS
        printf '\n################################################################################\n# MNX SWITCH TRANSCRIPT END\n################################################################################\n'
        printf 'mnx_switch_result=%s\n' "$FINAL_RESULT"
        printf 'phase=%s\ninterrupted_signal=%s\n' "$PHASE" "$INTERRUPTED_SIGNAL"
        printf 'configuration=%s\ncandidate_configuration_sha256=%s\n' "$CFG" "''${SOURCE_SHA:-unknown}"
        printf 'canonical_lineage_checkpoints=%s\n' "$CANONICAL_LINEAGE_CHECKPOINTS"
        printf 'test_report=%s\ntest_kind=%s\ntest_result=%s\ntested_candidate=%s\ntested_system=%s\n' "$TEST_REPORT" "$TEST_KIND" "$TEST_RESULT" "$TEST_CANDIDATE" "$TESTED_SYSTEM"
        printf 'test_behavior_change_allowed=%s\ntest_temporary_code_region_count=%s\n' "$TEST_BEHAVIOR_CHANGE_ALLOWED" "$TEST_TEMPORARY_CODE_REGION_COUNT"
        printf 'switch_rebuild_rc=%s\nswitch_profile_set_rc=%s\nswitch_activation_rc=%s\npost_switch_audit_rc=%s\nbehavior_contract_rc=%s\n' "$SWITCH_REBUILD_RC" "$PROFILE_SET_RC" "$SWITCH_ACTIVATION_RC" "$POST_AUDIT_RC" "$BEHAVIOR_CONTRACT_RC"
        printf 'behavior_baseline_replaced=%s\naccepted_behavior_baseline=%s\nbaseline_adoption_started=%s\nbaseline_adoption_committed=%s\nbaseline_adoption_rc=%s\n' "$BEHAVIOR_BASELINE_REPLACED" "$ACCEPTED_BASELINE_NAME" "$BASELINE_ADOPTION_STARTED" "$BASELINE_ADOPTION_COMMITTED" "$BASELINE_ADOPTION_RC"
        printf 'support_report_rc=%s\noffice_commit_rc=%s\noffice_record=%s\noffice_commit_committed=%s\npost_commit_seal_rc=%s\ncore_acceptance_result=%s\nrollback_rc=%s\n' "$SUPPORT_RC" "$OFFICE_COMMIT_RC" "$OFFICE_RECORD" "$OFFICE_COMMIT_COMMITTED" "$POST_COMMIT_SEAL_RC" "$CORE_ACCEPTANCE_RESULT" "$ROLLBACK_RC"
        printf 'post_acceptance_plan=%s\npost_acceptance_status=%s\npost_acceptance_rc=%s\npost_acceptance_action_results=%s\npost_acceptance_mutation_proof=%s\npost_acceptance_receipt=%s\npost_acceptance_locks_released=%s\n' \
          "$POST_ACCEPTANCE_PLAN" "$POST_ACCEPTANCE_STATUS" "$POST_ACCEPTANCE_RC" "$POST_ACCEPTANCE_ACTION_RESULTS" "$POST_ACCEPTANCE_MUTATION_PROOF" "$POST_ACCEPTANCE_RECEIPT" "$POST_ACCEPTANCE_LOCKS_RELEASED"
        printf 'report=%s\nrebuild_log=%s\npost_audit_log=%s\nbaseline_log=%s\nsupport_log=%s\noffice_log=%s\npost_commit_seal_log=%s\npost_acceptance_log=%s\nstate_file=%s\n' "$REPORT" "$REBUILD_LOG" "$POST_AUDIT_LOG" "$BASELINE_LOG" "$SUPPORT_LOG" "$OFFICE_LOG" "$POST_COMMIT_SEAL_LOG" "$POST_ACCEPTANCE_LOG" "$STATE_FILE"
        printf 'running_system=%s\ndefault_system=%s\n' "$(readlink -f /run/current-system 2>/dev/null || true)" "$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
        printf 'source_mutated_during_switch=%s\n' "$SOURCE_MUTATED"
        printf 'maintenance_waited_seconds=%s\n' "$MAINTENANCE_WAITED_SECONDS"
        printf 'maintenance_wait_units=%s\n' "$MAINTENANCE_WAIT_UNITS"
        printf 'contention_advisory_units=%s\n' "$CONTENTION_ADVISORY_UNITS"
        printf 'operator_preemption_requested=%s\noperator_preemption_result=%s\noperator_preemption_unit=%s\noperator_preemption_main_pid=%s\noperator_preemption_invocation_id=%s\noperator_preemption_success_receipt_before=%s\noperator_preemption_success_receipt_after=%s\n' "$OPERATOR_PREEMPTION_REQUESTED" "$OPERATOR_PREEMPTION_RESULT" "$OPERATOR_PREEMPTION_UNIT" "$OPERATOR_PREEMPTION_MAIN_PID" "$OPERATOR_PREEMPTION_INVOCATION_ID" "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_BEFORE" "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_AFTER"
        printf 'old_storage_direct_write_by_mnx_switch=no\n'
        [[ "$FINAL_RESULT" == PASS* ]] && printf 'MNX_SWITCH=%s\n' "$FINAL_RESULT"
        exit "$rc"
      }

      trap finish EXIT
      trap 'handle_signal INT 130' INT
      trap 'handle_signal TERM 143' TERM
      trap 'handle_signal HUP 129' HUP

      printf '################################################################################\n# MNX SWITCH — PERMANENTLY ACTIVATE THE EXACT TESTED CANDIDATE\n################################################################################\n'
      date -Is
      printf 'implementation_version=%s\nconfiguration=%s\nreport=%s\n' "$MNX_SWITCH_IMPLEMENTATION_VERSION" "$CFG" "$REPORT"
      printf 'source_integrity_owner=monsternix\noperator_checksum_step=not-required\n'
      printf 'test_policy=exact-newest-completed-matching-hash\n'
      printf 'rollback_policy=restore-prior-boot-default-profile-and-running-closure\n'
      printf 'behavior_policy=adopt-only-after-test-explicitly-allowed-change\n'
      printf 'maintenance_wait_policy=operator-lock-first-rsync-only-preemptible-root-scrub-exclusive-background-lock-users-nonblocking\n'
      printf 'maintenance_wait_limit_seconds=%s\n' "$MAINTENANCE_WAIT_SECONDS"
      printf 'old_storage_direct_write_by_mnx_switch=no\n'

      [[ -f "$CFG" && ! -L "$CFG" ]] || { FINAL_RESULT=FAIL_SOURCE; EXIT_CODE=1; echo "$CFG must be a regular non-symlink file" >&2; exit 1; }
      SOURCE_SHA="$(sha256sum "$CFG" | cut -d' ' -f1)"
      printf 'configuration_sha256=%s\n' "$SOURCE_SHA"
      LINEAGE_DEFAULT_PREFLIGHT="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
      [[ "$LINEAGE_DEFAULT_PREFLIGHT" == "$PRIOR_DEFAULT" ]] || { FINAL_RESULT=FAIL_CANDIDATE_LINEAGE; EXIT_CODE=1; echo 'boot-default closure changed before switch lineage preflight' >&2; exit 1; }
      if ! candidate_lineage_checkpoint switch-preflight "$CFG" "$SOURCE_SHA" "$LINEAGE_DEFAULT_PREFLIGHT"; then FINAL_RESULT=FAIL_CANDIDATE_LINEAGE; EXIT_CODE=1; exit 1; fi
      STRICT_TEMP_OUTPUT="$(mktemp)"
      set +e
      /etc/monsternix/bin/mnx-atlas --config "$CFG" verify > "$STRICT_TEMP_OUTPUT" 2>&1
      STRICT_ATLAS_VERIFY_RC=$?
      if (( STRICT_ATLAS_VERIFY_RC == 0 )); then
        /etc/monsternix/bin/mnx-atlas --config "$CFG" temp-gate switch >> "$STRICT_TEMP_OUTPUT" 2>&1
        STRICT_ATLAS_TEMP_RC=$?
      else
        STRICT_ATLAS_TEMP_RC=not-run
      fi
      set -e
      cat "$STRICT_TEMP_OUTPUT"
      CURRENT_TEMPORARY_CODE_REGION_COUNT="$(sed -n 's/^temporary_code_region_count=//p' "$STRICT_TEMP_OUTPUT" | tail -n 1)"
      [[ -n "$CURRENT_TEMPORARY_CODE_REGION_COUNT" ]] || CURRENT_TEMPORARY_CODE_REGION_COUNT=unknown
      printf 'current_source_temporary_code_region_count=%s\n' "$CURRENT_TEMPORARY_CODE_REGION_COUNT"
      rm -f "$STRICT_TEMP_OUTPUT"
      [[ "$STRICT_ATLAS_VERIFY_RC" == 0 ]] || { FINAL_RESULT=FAIL_SOURCE_ATLAS; echo 'strict source atlas verification failed' >&2; exit 1; }
      [[ "$STRICT_ATLAS_TEMP_RC" == 0 ]] || { FINAL_RESULT=FAIL_TEMPORARY_CODE_PRESENT; echo 'strict temporary-code switch gate rejected the source' >&2; exit 1; }

      CURRENT_RUNNING="$(readlink -f /run/current-system 2>/dev/null || true)"
      CURRENT_DEFAULT="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
      CURRENT_STATE="$(systemctl is-system-running 2>/dev/null || true)"
      FAILED_UNITS="$(systemctl --failed --no-legend --plain 2>/dev/null || true)"
      ACTIVE_SHA_BEFORE="$(sha256sum /run/current-system/configuration.nix 2>/dev/null | cut -d' ' -f1 || true)"
      DEFAULT_SHA_BEFORE="$(sha256sum "$CURRENT_DEFAULT/configuration.nix" 2>/dev/null | cut -d' ' -f1 || true)"
      printf 'before_running_system=%s\nbefore_default_system=%s\nbefore_system_state=%s\n' "$CURRENT_RUNNING" "$CURRENT_DEFAULT" "$CURRENT_STATE"
      printf 'before_active_configuration_sha256=%s\nbefore_default_configuration_sha256=%s\n' "''${ACTIVE_SHA_BEFORE:-unreadable}" "''${DEFAULT_SHA_BEFORE:-unreadable}"
      [[ "$CURRENT_STATE" == running ]] || { FINAL_RESULT=FAIL_BASELINE; echo "system state is $CURRENT_STATE" >&2; exit 1; }
      [[ -z "$FAILED_UNITS" ]] || { FINAL_RESULT=FAIL_BASELINE; printf '%s\n' "$FAILED_UNITS" >&2; exit 1; }
      [[ -n "$PRIOR_DEFAULT" && -x "$PRIOR_DEFAULT/bin/switch-to-configuration" ]] || { FINAL_RESULT=FAIL_BASELINE; echo 'prior boot-default closure is unusable' >&2; exit 1; }

      ALREADY_ACTIVE_DEFAULT=0
      if [[ "$CURRENT_RUNNING" == "$CURRENT_DEFAULT" && "$ACTIVE_SHA_BEFORE" == "$SOURCE_SHA" && "$DEFAULT_SHA_BEFORE" == "$SOURCE_SHA" ]]; then
        ALREADY_ACTIVE_DEFAULT=1
      fi

      MATCHING_TEST="$(find_latest_matching_test "$SOURCE_SHA" || true)"
      if [[ -n "$MATCHING_TEST" ]]; then
        if load_test_evidence "$MATCHING_TEST" "$SOURCE_SHA"; then
          printf 'test_report=%s\ntest_kind=%s\ntest_result=%s\ntested_candidate=%s\ntested_system=%s\n' "$TEST_REPORT" "$TEST_KIND" "$TEST_RESULT" "$TEST_CANDIDATE" "$TESTED_SYSTEM"
          printf 'test_behavior_change_allowed=%s\n' "$TEST_BEHAVIOR_CHANGE_ALLOWED"
        elif (( ALREADY_ACTIVE_DEFAULT == 1 )); then
          printf 'test_evidence_ignored_for_noop=%s\n' "$EVIDENCE_ERROR"
          TEST_REPORT=none
          TEST_KIND=none
          TEST_RESULT=none
          TEST_CANDIDATE="$CFG"
          TESTED_SYSTEM="$CURRENT_RUNNING"
          TEST_BEHAVIOR_CHANGE_ALLOWED=0
        else
          FINAL_RESULT=FAIL_TEST_EVIDENCE
          printf 'MNX_SWITCH_ERROR: %s\n' "$EVIDENCE_ERROR" >&2
          exit 1
        fi
      elif (( ALREADY_ACTIVE_DEFAULT == 1 )); then
        echo 'test_evidence=not-required-no-state-change'
        TEST_CANDIDATE="$CFG"
        TESTED_SYSTEM="$CURRENT_RUNNING"
      else
        FINAL_RESULT=FAIL_NO_MATCHING_TEST
        echo 'No completed successful test evidence exists for the exact current source. Run: mnx test' >&2
        exit 1
      fi

      [[ -n "$TESTED_SYSTEM" ]] || { FINAL_RESULT=FAIL_TEST_EVIDENCE; echo 'test evidence did not identify an activated closure' >&2; exit 1; }
      TESTED_SYSTEM="$(readlink -f "$TESTED_SYSTEM" 2>/dev/null || true)"
      case "$TESTED_SYSTEM" in
        /nix/store/*-nixos-system-*) ;;
        *) FINAL_RESULT=FAIL_TESTED_SYSTEM; echo "tested closure is not a NixOS system path: $TESTED_SYSTEM" >&2; exit 1 ;;
      esac
      [[ -d "$TESTED_SYSTEM" && -x "$TESTED_SYSTEM/bin/switch-to-configuration" ]] || { FINAL_RESULT=FAIL_TESTED_SYSTEM; echo "tested closure is unavailable or incomplete: $TESTED_SYSTEM" >&2; exit 1; }
      TESTED_SYSTEM_SHA="$(sha256sum "$TESTED_SYSTEM/configuration.nix" 2>/dev/null | cut -d' ' -f1 || true)"
      [[ "$TESTED_SYSTEM_SHA" == "$SOURCE_SHA" ]] || { FINAL_RESULT=FAIL_TESTED_SYSTEM; echo "tested closure embeds $TESTED_SYSTEM_SHA rather than $SOURCE_SHA" >&2; exit 1; }
      [[ "$CURRENT_RUNNING" == "$TESTED_SYSTEM" ]] || { FINAL_RESULT=FAIL_TESTED_SYSTEM_NOT_ACTIVE; echo "tested closure is no longer the running system; rerun mnx test before mnx switch" >&2; exit 1; }
      printf 'tested_system=%s\ntested_system_configuration_sha256=%s\n' "$TESTED_SYSTEM" "$TESTED_SYSTEM_SHA"

      #@MNX-PART id=99.20.mnx-switch.function.heavy_units kind=function title="Function heavy_units"
      heavy_units() {
        local unit state
        for unit in nixos-upgrade.service nix-gc.service 'btrfs-scrub--.service' nixos-rebuild-switch-to-configuration.service; do
          state="$(systemctl is-active "$unit" 2>/dev/null || true)"
          case "$state" in active|activating|reloading|deactivating) printf '%s\n' "$unit" ;; esac
        done
      }

      #@MNX-PART id=99.20.mnx-switch.function.lock-protected-maintenance-units kind=function title="Function lock_protected_maintenance_units"
      lock_protected_maintenance_units() {
        local unit state
        for unit in \
          btrbk-main.service btrbk-archive-to-new-storage.service m21-btrfs-pull-backup.service \
          m16-backup-m21.service m16-restic-maintenance.service \
          rsync-m16-new-to-old.service duperemove-home.service duperemove-m16-new-storage.service
        do
          state="$(systemctl is-active "$unit" 2>/dev/null || true)"
          case "$state" in active|activating|reloading|deactivating) printf '%s\n' "$unit" ;; esac
        done
      }

      #@MNX-PART id=99.20.mnx-switch.function.contention-only-units kind=function title="Function contention_only_units"
      contention_only_units() {
        local unit state
        for unit in fstrim.service 'btrfs-scrub-mnt-m16\x2dnew\x2dstorage.service'; do
          state="$(systemctl is-active "$unit" 2>/dev/null || true)"
          case "$state" in active|activating|reloading|deactivating) printf '%s\n' "$unit" ;; esac
        done
      }

      #@MNX-PART id=99.20.mnx-switch.function.restartable-rsync-success-receipt-identity kind=function title="Function restartable_rsync_success_receipt_identity"
      restartable_rsync_success_receipt_identity() {
        local receipt=/var/lib/monsternix/job-state/authoritative/rsync-m16-new-to-old.last-success before after digest
        if [[ ! -e "$receipt" && ! -L "$receipt" ]]; then
          printf 'absent\n'
          return 0
        fi
        [[ -f "$receipt" && ! -L "$receipt" ]] || return 1
        before="$(stat -c '%d:%i:%s:%Y:%Z:%u:%g:%a:%h' "$receipt" 2>/dev/null)" || return 1
        digest="$(sha256sum "$receipt" 2>/dev/null | awk 'NR == 1 { print $1 }')" || return 1
        [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || return 1
        after="$(stat -c '%d:%i:%s:%Y:%Z:%u:%g:%a:%h' "$receipt" 2>/dev/null)" || return 1
        [[ "$before" == "$after" ]] || return 1
        printf '%s:%s\n' "$before" "$digest"
      }

      #@MNX-PART id=99.20.mnx-switch.function.request-restartable-rsync-preemption kind=function title="Function request_restartable_rsync_preemption"
      request_restartable_rsync_preemption() {
        local unit=rsync-m16-new-to-old.service state load main_pid invocation private_mounts kill_mode restart_policy
        state="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
        case "$state" in active|activating|reloading) ;; *) return 0 ;; esac
        OPERATOR_PREEMPTION_ATTEMPTED=yes
        load="$(systemctl show "$unit" -p LoadState --value 2>/dev/null || true)"
        main_pid="$(systemctl show "$unit" -p MainPID --value 2>/dev/null || true)"
        invocation="$(systemctl show "$unit" -p InvocationID --value 2>/dev/null || true)"
        private_mounts="$(systemctl show "$unit" -p PrivateMounts --value 2>/dev/null || true)"
        kill_mode="$(systemctl show "$unit" -p KillMode --value 2>/dev/null || true)"
        restart_policy="$(systemctl show "$unit" -p Restart --value 2>/dev/null || true)"
        [[ "$load" == loaded ]] || { OPERATOR_PREEMPTION_RESULT=refused-load-state; return 6; }
        [[ "$main_pid" =~ ^[1-9][0-9]*$ ]] || { OPERATOR_PREEMPTION_RESULT=refused-main-pid; return 6; }
        [[ "$invocation" =~ ^[0-9a-f]{32}$ ]] || { OPERATOR_PREEMPTION_RESULT=refused-invocation-id; return 6; }
        case "$private_mounts" in yes|true|1) ;; *) OPERATOR_PREEMPTION_RESULT=refused-private-mounts; return 6 ;; esac
        [[ "$kill_mode" == control-group ]] || { OPERATOR_PREEMPTION_RESULT=refused-kill-mode; return 6; }
        [[ "$restart_policy" == no ]] || { OPERATOR_PREEMPTION_RESULT=refused-restart-policy; return 6; }
        OPERATOR_PREEMPTION_SUCCESS_RECEIPT_BEFORE="$(restartable_rsync_success_receipt_identity)" || { OPERATOR_PREEMPTION_RESULT=unsafe-success-receipt-before; return 6; }
        OPERATOR_PREEMPTION_REQUESTED=yes
        OPERATOR_PREEMPTION_UNIT="$unit"
        OPERATOR_PREEMPTION_MAIN_PID="$main_pid"
        OPERATOR_PREEMPTION_INVOCATION_ID="$invocation"
        printf 'operator_preemption_request=manager-stop-retryable\noperator_preemption_unit=%s\noperator_preemption_main_pid=%s\noperator_preemption_invocation_id=%s\noperator_preemption_private_mounts=%s\noperator_preemption_kill_mode=%s\noperator_preemption_restart_policy=%s\noperator_preemption_success_receipt_before=%s\n' \
          "$unit" "$main_pid" "$invocation" "$private_mounts" "$kill_mode" "$restart_policy" "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_BEFORE"
        if ! systemctl --no-block stop "$unit"; then
          OPERATOR_PREEMPTION_RESULT=stop-request-failed
          return 6
        fi
        OPERATOR_PREEMPTION_RESULT=requested
        return 0
      }

      #@MNX-PART id=99.20.mnx-switch.function.wait-for-heavy-units kind=function title="Function wait_for_heavy_units"
      wait_for_heavy_units() {
        local started now elapsed remaining last_notice=-60 busy="" seen="" lock_holders="" current_source current_running current_default current_state current_failed invariant_rc preempt_state preempt_invocation preempt_result preempt_exec_code preempt_exec_status old_options final_failed
        started="$(date +%s)"

        while ! flock -w "$MAINTENANCE_POLL_SECONDS" -x 9; do
          lock_holders="$(lock_protected_maintenance_units)"
          if [[ "$OPERATOR_PREEMPTION_ATTEMPTED" == no ]]; then
            request_restartable_rsync_preemption || return "$?"
          fi
          busy="''${lock_holders:-storage-maintenance.lock}"
          seen+=$'\n'"$busy"
          now="$(date +%s)"
          elapsed=$(( now - started ))
          remaining=$(( MAINTENANCE_WAIT_SECONDS - elapsed ))
          MAINTENANCE_WAIT_UNITS="$(printf '%s\n' "$seen" | sed '/^$/d' | sort -u | paste -sd, -)"
          if (( elapsed >= MAINTENANCE_WAIT_SECONDS )); then
            MAINTENANCE_WAITED_SECONDS="$elapsed"
            printf 'deferred_units=%s\nmaintenance_waited_seconds=%s\n' "$MAINTENANCE_WAIT_UNITS" "$elapsed"
            return 75
          fi
          if (( elapsed - last_notice >= 60 )); then
            printf '%s phase=maintenance-wait elapsed=%ss remaining=%ss units=%s policy=operator-lock-first\n' \
              "$(date -Is)" "$elapsed" "$remaining" "$MAINTENANCE_WAIT_UNITS"
            last_notice="$elapsed"
          fi
          invariant_rc=0
          current_source="$(sha256sum "$CFG" 2>/dev/null | cut -d' ' -f1 || true)"
          [[ "$current_source" == "$SOURCE_SHA" ]] || invariant_rc=2
          current_running="$(readlink -f /run/current-system 2>/dev/null || true)"
          [[ "$invariant_rc" != 0 || "$current_running" == "$TESTED_SYSTEM" ]] || invariant_rc=3
          current_default="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
          [[ "$invariant_rc" != 0 || "$current_default" == "$CURRENT_DEFAULT" ]] || invariant_rc=4
          current_state="$(systemctl is-system-running 2>/dev/null || true)"
          current_failed="$(systemctl --failed --no-legend --plain 2>/dev/null | grep -Ev '^[[:space:]]*$|^[0-9]+ loaded units listed[.]$' || true)"
          if [[ "$OPERATOR_PREEMPTION_REQUESTED" == yes ]]; then
            current_failed="$(printf '%s\n' "$current_failed" | grep -Ev '^[[:space:]]*rsync-m16-new-to-old[.]service([[:space:]]|$)' || true)"
          fi
          [[ "$invariant_rc" != 0 || ( ( "$current_state" == running || ( "$OPERATOR_PREEMPTION_REQUESTED" == yes && "$current_state" == degraded ) ) && -z "$current_failed" ) ]] || invariant_rc=5
          (( invariant_rc == 0 )) || return "$invariant_rc"
        done

        while :; do
          busy="$(heavy_units)"
          lock_holders="$(lock_protected_maintenance_units)"
          if [[ -n "$lock_holders" ]]; then
            busy+="''${busy:+$'\n'}$lock_holders"
          fi
          [[ -n "$busy" ]] || break
          seen+=$'\n'"$busy"
          now="$(date +%s)"
          elapsed=$(( now - started ))
          remaining=$(( MAINTENANCE_WAIT_SECONDS - elapsed ))
          MAINTENANCE_WAIT_UNITS="$(printf '%s\n' "$seen" | sed '/^$/d' | sort -u | paste -sd, -)"
          if (( elapsed >= MAINTENANCE_WAIT_SECONDS )); then
            MAINTENANCE_WAITED_SECONDS="$elapsed"
            printf 'deferred_units=%s\nmaintenance_waited_seconds=%s\n' "$MAINTENANCE_WAIT_UNITS" "$elapsed"
            flock -u 9
            return 75
          fi
          if (( elapsed - last_notice >= 60 )); then
            printf '%s phase=maintenance-wait elapsed=%ss remaining=%ss units=%s policy=operator-lock-held\n' \
              "$(date -Is)" "$elapsed" "$remaining" "$MAINTENANCE_WAIT_UNITS"
            last_notice="$elapsed"
          fi
          invariant_rc=0
          current_source="$(sha256sum "$CFG" 2>/dev/null | cut -d' ' -f1 || true)"
          [[ "$current_source" == "$SOURCE_SHA" ]] || invariant_rc=2
          current_running="$(readlink -f /run/current-system 2>/dev/null || true)"
          [[ "$invariant_rc" != 0 || "$current_running" == "$TESTED_SYSTEM" ]] || invariant_rc=3
          current_default="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
          [[ "$invariant_rc" != 0 || "$current_default" == "$CURRENT_DEFAULT" ]] || invariant_rc=4
          current_state="$(systemctl is-system-running 2>/dev/null || true)"
          current_failed="$(systemctl --failed --no-legend --plain 2>/dev/null | grep -Ev '^[[:space:]]*$|^[0-9]+ loaded units listed[.]$' || true)"
          if [[ "$OPERATOR_PREEMPTION_REQUESTED" == yes ]]; then
            current_failed="$(printf '%s\n' "$current_failed" | grep -Ev '^[[:space:]]*rsync-m16-new-to-old[.]service([[:space:]]|$)' || true)"
          fi
          [[ "$invariant_rc" != 0 || ( ( "$current_state" == running || ( "$OPERATOR_PREEMPTION_REQUESTED" == yes && "$current_state" == degraded ) ) && -z "$current_failed" ) ]] || invariant_rc=5
          if (( invariant_rc != 0 )); then
            flock -u 9
            return "$invariant_rc"
          fi
          sleep "$MAINTENANCE_POLL_SECONDS"
        done

        if [[ "$OPERATOR_PREEMPTION_REQUESTED" == yes ]]; then
          preempt_state="$(systemctl show "$OPERATOR_PREEMPTION_UNIT" -p ActiveState --value 2>/dev/null || true)"
          case "$preempt_state" in inactive|failed) ;; *) OPERATOR_PREEMPTION_RESULT=unit-not-stopped; return 6 ;; esac
          preempt_invocation="$(systemctl show "$OPERATOR_PREEMPTION_UNIT" -p InvocationID --value 2>/dev/null || true)"
          [[ -z "$preempt_invocation" || "$preempt_invocation" == "$OPERATOR_PREEMPTION_INVOCATION_ID" ]] || { OPERATOR_PREEMPTION_RESULT=invocation-changed-during-stop; return 6; }
          [[ -n "$preempt_invocation" ]] || preempt_invocation=cleared-after-stop
          preempt_result="$(systemctl show "$OPERATOR_PREEMPTION_UNIT" -p Result --value 2>/dev/null || true)"
          preempt_exec_code="$(systemctl show "$OPERATOR_PREEMPTION_UNIT" -p ExecMainCode --value 2>/dev/null || true)"
          preempt_exec_status="$(systemctl show "$OPERATOR_PREEMPTION_UNIT" -p ExecMainStatus --value 2>/dev/null || true)"
          case "$preempt_result" in success|exit-code) ;; *) OPERATOR_PREEMPTION_RESULT=unexpected-unit-result; return 6 ;; esac
          case "$preempt_exec_code:$preempt_exec_status" in 0:0|1:0|1:75|1:143) ;; *) OPERATOR_PREEMPTION_RESULT=unexpected-main-exit; return 6 ;; esac
          old_options="$(findmnt -rn -T /mnt/m16-old-storage -o OPTIONS 2>/dev/null || true)"
          case ",$old_options," in *,ro,*) ;; *) OPERATOR_PREEMPTION_RESULT=host-old-storage-not-read-only; return 6 ;; esac
          OPERATOR_PREEMPTION_SUCCESS_RECEIPT_AFTER="$(restartable_rsync_success_receipt_identity)" || { OPERATOR_PREEMPTION_RESULT=unsafe-success-receipt-after; return 6; }
          [[ "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_AFTER" == "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_BEFORE" ]] || { OPERATOR_PREEMPTION_RESULT=success-receipt-advanced; return 6; }
          systemctl reset-failed "$OPERATOR_PREEMPTION_UNIT" || { OPERATOR_PREEMPTION_RESULT=reset-failed-error; return 6; }
          if systemctl is-failed --quiet "$OPERATOR_PREEMPTION_UNIT"; then OPERATOR_PREEMPTION_RESULT=failed-state-remains; return 6; fi
          final_failed="$(systemctl --failed --no-legend --plain 2>/dev/null | grep -Ev '^[[:space:]]*$|^[0-9]+ loaded units listed[.]$' || true)"
          [[ -z "$final_failed" ]] || { OPERATOR_PREEMPTION_RESULT=other-failed-unit; return 5; }
          OPERATOR_PREEMPTION_RESULT=pass
          printf 'operator_preemption_result=pass\noperator_preemption_final_state=%s\noperator_preemption_final_invocation_id=%s\noperator_preemption_unit_result=%s\noperator_preemption_exec_main_code=%s\noperator_preemption_exec_main_status=%s\noperator_preemption_host_old_storage=read-only\noperator_preemption_success_receipt_after=%s\noperator_preemption_success_receipt_advanced=false\n' "$preempt_state" "$preempt_invocation" "$preempt_result" "$preempt_exec_code" "$preempt_exec_status" "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_AFTER"
        fi

        now="$(date +%s)"
        MAINTENANCE_WAITED_SECONDS=$(( now - started ))
        if [[ -n "$seen" ]]; then
          MAINTENANCE_WAIT_UNITS="$(printf '%s\n' "$seen" | sed '/^$/d' | sort -u | paste -sd, -)"
        else
          MAINTENANCE_WAIT_UNITS=none
        fi
        printf 'operator_storage_lane=acquired-lock-first-and-held\nmaintenance_waited_seconds=%s\nmaintenance_wait_units=%s\n' "$MAINTENANCE_WAITED_SECONDS" "$MAINTENANCE_WAIT_UNITS"
        return 0
      }


      touch /run/storage-maintenance.lock
      exec 9<>/run/storage-maintenance.lock
      set +e
      wait_for_heavy_units
      maintenance_wait_rc="$?"
      set -e
      case "$maintenance_wait_rc" in
        0) ;;
        75)
          FINAL_RESULT=DEFERRED_MAINTENANCE_TIMEOUT
          printf 'retry_command=mnx switch\n'
          EXIT_CODE=75
          exit 75
          ;;
        2)
          FINAL_RESULT=FAIL_SOURCE_MUTATED_DURING_MAINTENANCE_WAIT
          echo 'configuration.nix changed during the bounded maintenance wait' >&2
          EXIT_CODE=1
          exit 1
          ;;
        3)
          FINAL_RESULT=FAIL_TESTED_SYSTEM_CHANGED_DURING_MAINTENANCE_WAIT
          echo 'the exact tested closure stopped being the running system during maintenance wait' >&2
          EXIT_CODE=1
          exit 1
          ;;
        4)
          FINAL_RESULT=FAIL_BOOT_DEFAULT_CHANGED_DURING_MAINTENANCE_WAIT
          echo 'the boot-default closure changed during maintenance wait' >&2
          EXIT_CODE=1
          exit 1
          ;;
        5)
          FINAL_RESULT=FAIL_BASELINE_CHANGED_DURING_MAINTENANCE_WAIT
          echo 'system health changed during maintenance wait' >&2
          EXIT_CODE=1
          exit 1
          ;;
        6)
          FINAL_RESULT=FAIL_OPERATOR_RSYNC_PREEMPTION
          echo "restartable rsync preemption failed closed: $OPERATOR_PREEMPTION_RESULT" >&2
          EXIT_CODE=1
          exit 1
          ;;
        *)
          FINAL_RESULT=FAIL_MAINTENANCE_WAIT
          echo "unexpected maintenance wait result: $maintenance_wait_rc" >&2
          EXIT_CODE=1
          exit 1
          ;;
      esac

      CONTENTION_ADVISORY_UNITS="$(contention_only_units | paste -sd, -)"
      [[ -n "$CONTENTION_ADVISORY_UNITS" ]] || CONTENTION_ADVISORY_UNITS=none
      printf 'contention_advisory_units=%s\n' "$CONTENTION_ADVISORY_UNITS"
      printf 'contention_policy=online-fstrim-and-throttled-new-storage-scrub-may-overlap-switch-without-becoming-an-operator-retry\n'

      exec 7<>"$RUNTIME_DIR/mnx-switch.lock"
      flock -n -x 7 || { FINAL_RESULT=DEFERRED_SWITCH_BUSY; echo 'another mnx switch is active' >&2; EXIT_CODE=75; exit 75; }
      exec 8<>"$RUNTIME_DIR/mnx-test.lock"
      flock -n -x 8 || { FINAL_RESULT=DEFERRED_TEST_BUSY; echo 'mnx test is still active' >&2; EXIT_CODE=75; exit 75; }
      LINEAGE_DEFAULT_LOCKED="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
      [[ "$LINEAGE_DEFAULT_LOCKED" == "$LINEAGE_DEFAULT_PREFLIGHT" ]] || { FINAL_RESULT=FAIL_CANDIDATE_LINEAGE; EXIT_CODE=1; echo 'boot-default closure changed before switch-lock lineage verification' >&2; exit 1; }
      if ! candidate_lineage_checkpoint switch-lock "$CFG" "$SOURCE_SHA" "$LINEAGE_DEFAULT_LOCKED"; then FINAL_RESULT=FAIL_CANDIDATE_LINEAGE; EXIT_CODE=1; exit 1; fi
      write_state

      BUSY="$(heavy_units)"
      if [[ -n "$BUSY" ]]; then
        FINAL_RESULT=DEFERRED_MAINTENANCE_RACE
        printf 'deferred_units=%s\n' "$(tr '\n' ',' <<<"$BUSY" | sed 's/,$//')"
        EXIT_CODE=75
        exit 75
      fi

      #@MNX-PART id=99.20.mnx-switch.function.adopt_behavior_if_needed kind=function title="Function adopt_behavior_if_needed"
      adopt_behavior_if_needed() {
        local compare_rc capture_rc baseline_name
        set_phase behavior-contract
        set +e
        /etc/monsternix/bin/mnx-behavior-manifest compare pinned > "$BASELINE_LOG" 2>&1
        compare_rc=$?
        set -e
        BEHAVIOR_CONTRACT_RC="$compare_rc"
        if (( compare_rc == 0 )); then
          grep -E '^(behavior_contract=|baseline=|current_manifest=)' "$BASELINE_LOG" | tail -n 20 || true
          return 0
        fi
        if (( TEST_BEHAVIOR_CHANGE_ALLOWED == 0 )); then
          show_failure_context "$BASELINE_LOG"
          return 1
        fi

        baseline_name="accepted-$STAMP-''${SOURCE_SHA:0:12}"
        ACCEPTED_BASELINE_NAME="$baseline_name"
        ACCEPTED_BASELINE_DIR="/var/lib/logbook/baselines/$baseline_name"
        BASELINE_ADOPTION_STARTED=1
        write_state

        set +e
        /etc/monsternix/bin/mnx-behavior-manifest capture "$baseline_name" --pin >> "$BASELINE_LOG" 2>&1
        capture_rc=$?
        set -e
        BASELINE_ADOPTION_RC=$capture_rc
        if (( capture_rc != 0 )); then
          restore_prior_behavior_baseline || true
          show_failure_context "$BASELINE_LOG"
          return 2
        fi

        set +e
        /etc/monsternix/bin/mnx-behavior-manifest compare "$baseline_name" >> "$BASELINE_LOG" 2>&1
        BEHAVIOR_CONTRACT_RC=$?
        set -e
        if (( BEHAVIOR_CONTRACT_RC != 0 )); then
          restore_prior_behavior_baseline || true
          show_failure_context "$BASELINE_LOG"
          return 2
        fi

        BEHAVIOR_BASELINE_REPLACED=yes
        BASELINE_ADOPTION_COMMITTED=1
        # Keep baseline_adoption_started=1 in the live state until the whole switch
        # reaches its PASS result. A hard kill after capture but before final success
        # must leave enough evidence for `mnx switch-recover` to restore the prior pin.
        write_state
        grep -E '^(behavior_contract=|manifest_sha256=|baseline=|pinned=)' "$BASELINE_LOG" | tail -n 40 || true
        return 0
      }

      #@MNX-PART id=99.20.mnx-switch.function.commit_office_acceptance kind=function title="Function commit_office_acceptance"
      commit_office_acceptance() {
        local intended_result="$1" rc accepted_running accepted_default attempt
        set_phase office-commit

        if [[ "$intended_result" == PASS_ALREADY_ACTIVE_DEFAULT ]]; then
          set +e
          MNX_OFFICE_CONFIG="$CFG" /etc/monsternix/bin/mnx-office verify > "$OFFICE_LOG" 2>&1
          rc=$?
          set -e
          if (( rc == 0 )); then
            cat "$OFFICE_LOG" || true
            OFFICE_COMMIT_RC=skipped-existing-accepted-record
            OFFICE_RECORD="$(readlink -f /var/lib/monsternix/office/current.json 2>/dev/null || true)"
            [[ -n "$OFFICE_RECORD" && -f "$OFFICE_RECORD" ]] || return 1
            OFFICE_COMMIT_COMMITTED=0
            write_state
            return 0
          fi
          if [[ "$TEST_REPORT" == none ]]; then
            cat "$OFFICE_LOG" || true
            OFFICE_COMMIT_RC=missing-valid-record-and-test-evidence
            return 1
          fi
        fi

        accepted_running="$(readlink -f /run/current-system 2>/dev/null || true)"
        accepted_default="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
        printf 'office_acceptance_ready=yes\n'
        printf 'office_acceptance_intended_result=%s\n' "$intended_result"
        printf 'office_acceptance_running_system=%s\n' "$accepted_running"
        printf 'office_acceptance_default_system=%s\n' "$accepted_default"
        printf 'office_acceptance_post_audit_rc=%s\n' "$POST_AUDIT_RC"
        printf 'office_acceptance_behavior_contract_rc=%s\n' "$BEHAVIOR_CONTRACT_RC"
        printf 'office_acceptance_old_storage_write=no\n'

        # The transcript is written through tee; wait until the semantic acceptance gate is durable enough to parse.
        for attempt in $(seq 1 100); do
          if grep -Fxq 'office_acceptance_ready=yes' "$REPORT" 2>/dev/null &&
             grep -Fxq "office_acceptance_intended_result=$intended_result" "$REPORT" 2>/dev/null
          then
            break
          fi
          sleep 0.05
        done
        grep -Fxq 'office_acceptance_ready=yes' "$REPORT" || return 1
        grep -Fxq "office_acceptance_intended_result=$intended_result" "$REPORT" || return 1

        set +e
        MNX_OFFICE_SWITCH_TRANSACTION=1 MNX_OFFICE_CONFIG="$CFG" /etc/monsternix/bin/mnx-office commit \
          --test-report "$TEST_REPORT" \
          --switch-report "$REPORT" \
          --switch-result "$intended_result" > "$OFFICE_LOG" 2>&1
        rc=$?
        set -e
        OFFICE_COMMIT_RC="$rc"
        cat "$OFFICE_LOG" || true
        (( rc == 0 )) || return "$rc"
        OFFICE_RECORD="$(sed -n 's/^office_record=//p' "$OFFICE_LOG" | tail -n 1)"
        [[ -n "$OFFICE_RECORD" && -f "$OFFICE_RECORD" ]] || return 1
        OFFICE_COMMIT_COMMITTED=1
        write_state
        return 0
      }

      #@MNX-PART id=99.20.mnx-switch.function.finalize-accepted-switch kind=function title="Function finalize_accepted_switch"
      finalize_accepted_switch() {
        local base_result="$1" continuation_call_rc=0
        if ! post_commit_seal "$base_result"; then
          restore_prior_behavior_baseline || true
          restore_prior_office_record || true
          fail_core FAIL_POST_COMMIT_SEAL 'strict office/doctor seal failed after office commit'
        fi
        release_transaction_locks
        set_phase post-acceptance
        if run_post_acceptance_plan; then
          continuation_call_rc=0
        else
          continuation_call_rc="$?"
        fi
        if (( continuation_call_rc == 2 )); then
          FINAL_RESULT=FAIL_POST_ACCEPTANCE_CONTRACT_AFTER_ACCEPTANCE
          EXIT_CODE=1
          write_state
          return 1
        fi
        case "$POST_ACCEPTANCE_STATUS" in
          completed-with-blocker)
            FINAL_RESULT="''${base_result}_WITH_POST_ACCEPTANCE_BLOCKER"
            ;;
          deferred)
            FINAL_RESULT="''${base_result}_WITH_POST_ACCEPTANCE_DEFERRED"
            ;;
          *)
            FINAL_RESULT="$base_result"
            ;;
        esac
        EXIT_CODE=0
        write_state
        return 0
      }

      if [[ "$CURRENT_RUNNING" == "$CURRENT_DEFAULT" && "$ACTIVE_SHA_BEFORE" == "$SOURCE_SHA" && "$DEFAULT_SHA_BEFORE" == "$SOURCE_SHA" ]]; then
        echo 'switch_rebuild_skipped_reason=already-active-and-boot-default'
        echo 'already_active_office_audit_mode=accepted'
        SWITCH_REBUILD_RC=skipped-already-active
        set_phase post-audit
        set +e
        run_accepted_office_audit
        POST_AUDIT_RC=$?
        set -e
        (( POST_AUDIT_RC == 0 )) || { FINAL_RESULT=FAIL_ALREADY_ACTIVE_AUDIT; show_failure_context "$POST_AUDIT_LOG"; run_support || true; exit 1; }
        set +e
        adopt_behavior_if_needed
        adoption_rc=$?
        set -e
        if (( adoption_rc != 0 )); then
          if (( adoption_rc == 1 )); then
            FINAL_RESULT=FAIL_BEHAVIOR_CONTRACT
            run_support || true
            exit 1
          fi
          FINAL_RESULT=FAIL_BASELINE_ADOPTION
          SUPPORT_POLICY=always
          run_support || true
          EXIT_CODE=1
          exit 1
        fi
        SOURCE_MUTATED=no
        if ! commit_office_acceptance PASS_ALREADY_ACTIVE_DEFAULT; then
          restore_prior_behavior_baseline || true
          restore_prior_office_record || true
          FINAL_RESULT=FAIL_OFFICE_COMMIT
          show_failure_context "$OFFICE_LOG"
          run_support || true
          EXIT_CODE=1
          exit 1
        fi
        finalize_accepted_switch PASS_ALREADY_ACTIVE_DEFAULT || exit "$EXIT_CODE"
        exit 0
      fi

      echo 'activation_policy=profile-set-and-switch-exact-tested-closure-without-channel-reevaluation'
      SWITCH_STARTED=1
      SWITCH_REBUILD_RC=not-used-exact-tested-closure
      export -f exact_activate
      set +e
      run_logged_child activation "$REBUILD_LOG" ${pkgs.bash}/bin/bash -c 'exact_activate "$1"' mnx-switch-exact "$TESTED_SYSTEM"
      exact_activation_rc=$?
      set -e
      PROFILE_SET_RC="$(sed -n 's/^mnx_profile_set_rc=//p' "$REBUILD_LOG" | tail -n 1)"
      SWITCH_ACTIVATION_RC="$(sed -n 's/^mnx_switch_to_configuration_rc=//p' "$REBUILD_LOG" | tail -n 1)"
      [[ -n "$PROFILE_SET_RC" ]] || PROFILE_SET_RC=unknown
      [[ -n "$SWITCH_ACTIVATION_RC" ]] || SWITCH_ACTIVATION_RC=unknown
      printf 'switch_profile_set_rc=%s\nswitch_activation_rc=%s\n' "$PROFILE_SET_RC" "$SWITCH_ACTIVATION_RC"
      (( exact_activation_rc == 0 )) || fail_core FAIL_ACTIVATION "exact tested closure activation failed with status $exact_activation_rc"

      LIVE_SHA_AFTER="$(sha256sum "$CFG" 2>/dev/null | cut -d' ' -f1 || true)"
      [[ "$LIVE_SHA_AFTER" == "$SOURCE_SHA" ]] && SOURCE_MUTATED=no || SOURCE_MUTATED=yes
      [[ "$SOURCE_MUTATED" == no ]] || fail_core FAIL_SOURCE_MUTATED 'configuration.nix changed during the permanent switch'

      AFTER_RUNNING="$(readlink -f /run/current-system 2>/dev/null || true)"
      AFTER_DEFAULT="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
      AFTER_ACTIVE_SHA="$(sha256sum /run/current-system/configuration.nix 2>/dev/null | cut -d' ' -f1 || true)"
      AFTER_DEFAULT_SHA="$(sha256sum "$AFTER_DEFAULT/configuration.nix" 2>/dev/null | cut -d' ' -f1 || true)"
      AFTER_STATE="$(systemctl is-system-running 2>/dev/null || true)"
      printf 'after_running_system=%s\nafter_default_system=%s\nafter_system_state=%s\n' "$AFTER_RUNNING" "$AFTER_DEFAULT" "$AFTER_STATE"
      printf 'after_active_configuration_sha256=%s\nafter_default_configuration_sha256=%s\n' "$AFTER_ACTIVE_SHA" "$AFTER_DEFAULT_SHA"
      [[ -n "$AFTER_RUNNING" && "$AFTER_RUNNING" == "$AFTER_DEFAULT" ]] || fail_core FAIL_POSTFLIGHT 'running and boot-default closures differ after switch'
      [[ "$AFTER_ACTIVE_SHA" == "$SOURCE_SHA" && "$AFTER_DEFAULT_SHA" == "$SOURCE_SHA" ]] || fail_core FAIL_POSTFLIGHT 'active/default embedded source does not match the tested candidate'
      [[ "$AFTER_STATE" == running ]] || fail_core FAIL_POSTFLIGHT "system state is $AFTER_STATE after switch"
      [[ -z "$(systemctl --failed --no-legend --plain 2>/dev/null || true)" ]] || fail_core FAIL_POSTFLIGHT 'failed units exist after switch'

      set_phase post-audit
      echo 'activation_office_audit_mode=commit-pending'
      set +e
      run_candidate_pending_audit
      POST_AUDIT_RC=$?
      set -e
      (( POST_AUDIT_RC == 0 )) || fail_core FAIL_POSTFLIGHT 'post-switch MNX audit failed'
      grep -E '^(officer_health_|kodi_output_follow_|MNX_CONFIG_AUDIT=|warnings=|failures=|failure_[0-9]+=|warning_[0-9]+=|generated_program_count=|verified_fragment_count=)' "$POST_AUDIT_LOG" | tail -n 64 || true

      set +e
      adopt_behavior_if_needed
      adoption_rc=$?
      set -e
      if (( adoption_rc != 0 )); then
        if (( adoption_rc == 1 )); then
          fail_core FAIL_BEHAVIOR_CONTRACT 'permanent system differs from the pinned behavior contract without explicit test approval'
        fi
        fail_core FAIL_BASELINE_ADOPTION 'new behavior baseline could not be captured and verified after the exact tested closure was switched'

      fi

      commit_office_acceptance PASS || fail_core FAIL_OFFICE_COMMIT 'accepted office record could not be committed after exact switch acceptance'

      finalize_accepted_switch PASS || exit "$EXIT_CODE"
      printf 'MNX_SWITCH_SUCCESS: exact tested closure is active and boot-default; no channel re-evaluation occurred.\n'
      exit 0
      '';
      checkPhase = ''
        set -Eeuo pipefail
        err="$(${pkgs.coreutils}/bin/mktemp)"
        trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
        if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
          ${pkgs.coreutils}/bin/cat "$err" >&2
          exit 1
        fi
        if [ -s "$err" ]; then
          ${pkgs.coreutils}/bin/cat "$err" >&2
          exit 1
        fi
        "$out" self-test
      '';
    };
  };

#@MNX-CHUNK id=99.30 slug=mnx-test-transaction title="Candidate test, rollback, interruption, and evidence transaction"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-test" section=99.30 role=generated-program ordinal=268
  environment.etc."monsternix/bin/mnx-test" = {
    source = pkgs.writeTextFile {
      name = "mnx-test";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      export PATH=/run/wrappers/bin:${pkgs.bash}/bin:${pkgs.coreutils}/bin:${pkgs.findutils}/bin:${pkgs.gawk}/bin:${pkgs.gnugrep}/bin:${pkgs.gnused}/bin:${pkgs.util-linux}/bin:${pkgs.systemd}/bin:${pkgs.python3}/bin:${pkgs.jq}/bin:${pkgs.nix}/bin:${pkgs.btrfs-progs}/bin:${pkgs.procps}/bin:/run/current-system/sw/bin
      set -Eeuo pipefail
      export LC_ALL=C SYSTEMD_PAGER=cat SYSTEMD_COLORS=0 PAGER=cat
      umask 027

      MNX_TEST_IMPLEMENTATION_VERSION=16
      CFG=/etc/nixos/configuration.nix
      SUPPORT_POLICY=failure
      ROLLBACK_ON_FAILURE=1
      ALLOW_DIRTY_BASELINE=0
      ALLOW_BEHAVIOR_CHANGE=0
      BASELINE_RECONCILIATION=none
      VERBOSE=0
      TEST_TIMEOUT=0
      MAINTENANCE_WAIT_SECONDS="''${MNX_TEST_MAINTENANCE_WAIT_SECONDS:-7200}"
      MAINTENANCE_POLL_SECONDS="''${MNX_TEST_MAINTENANCE_POLL_SECONDS:-15}"
      [[ "$MAINTENANCE_WAIT_SECONDS" =~ ^[0-9]+$ && "$MAINTENANCE_POLL_SECONDS" =~ ^[1-9][0-9]*$ ]] || { echo "invalid test maintenance wait configuration" >&2; exit 64; }
      (( MAINTENANCE_WAIT_SECONDS <= 86400 && MAINTENANCE_POLL_SECONDS <= 300 )) || { echo "test maintenance wait configuration exceeds bounds" >&2; exit 64; }
      SUBCOMMAND=test

      if [[ "''${1:-}" == status || "''${1:-}" == --status ]]; then
        SUBCOMMAND=status
        shift || true
      elif [[ "''${1:-}" == cancel || "''${1:-}" == --cancel ]]; then
        SUBCOMMAND=cancel
        shift || true
      elif [[ "''${1:-}" == recover || "''${1:-}" == --recover ]]; then
        SUBCOMMAND=recover
        shift || true
      elif [[ "''${1:-}" == errors || "''${1:-}" == --errors ]]; then
        SUBCOMMAND=errors
        shift || true
      elif [[ "''${1:-}" == raw || "''${1:-}" == --raw ]]; then
        SUBCOMMAND=raw
        shift || true
      fi

      while (( $# > 0 )); do
        case "$1" in
          --config)
            [[ $# -ge 2 ]] || { echo '--config requires a path' >&2; exit 64; }
            CFG="$2"
            shift 2
            ;;
          --verbose|-v)
            VERBOSE=1
            shift
            ;;
          --support=always|--full-support)
            SUPPORT_POLICY=always
            shift
            ;;
          --support=failure)
            SUPPORT_POLICY=failure
            shift
            ;;
          --support=never|--no-support)
            SUPPORT_POLICY=never
            shift
            ;;
          --no-rollback)
            ROLLBACK_ON_FAILURE=0
            shift
            ;;
          --allow-dirty-baseline)
            ALLOW_DIRTY_BASELINE=1
            shift
            ;;
          --allow-behavior-change)
            ALLOW_BEHAVIOR_CHANGE=1
            shift
            ;;
          --timeout)
            [[ $# -ge 2 ]] || { echo '--timeout requires a duration such as 45m or 2h' >&2; exit 64; }
            TEST_TIMEOUT="$2"
            shift 2
            ;;
          help|-h|--help)
            cat <<'USAGE'
      Usage:
        mnx test [OPTIONS]
        mnx test-status
        mnx test-cancel
        mnx test-recover
        mnx test-errors
        mnx test-raw [rebuild|source|post|support|contract|state]

      Options:
        --config PATH                 test this source file (default: /etc/nixos/configuration.nix)
        --verbose, -v                 stream full phase logs to the terminal
        --support=always|failure|never
                                      default: failure; complete report is always saved when run
        --no-support                  alias for --support=never
        --no-rollback                 do not restore the prior running closure after activation failure
        --allow-dirty-baseline        permit an already-degraded/failed-unit baseline
        --allow-behavior-change       permit a mismatch with a pinned refactor behavior baseline
        --timeout DURATION            bound nixos-rebuild, for example 45m or 2h (default: no timeout)

      A candidate test waits up to two hours for exclusion-required maintenance while proving that
      source, running closure, boot-default closure, and baseline health remain exact. Online fstrim
      is contention-only and never forces an operator retry. The wait remains signal-cancellable.

      Default output is intentionally concise on success and detailed on failure. Every phase's
      complete raw output is retained beside the transcript under /var/lib/logbook/support.
      Ctrl-C/TERM/HUP are first-class outcomes: the active child process group is terminated;
      rollback occurs only if activation began; the optional support report is not launched.
      `mnx test-recover` handles the exceptional SIGKILL/orphan-state case using the persisted
      runtime state and restores the exact prior closure when a partial activation is detected.
      USAGE
            exit 0
            ;;
          *)
            printf 'unknown mnx test option: %s\n' "$1" >&2
            exit 64
            ;;
        esac
      done

      REPORT_DIR=/var/lib/logbook/support
      RUNTIME_DIR=/run/monsternix
      RUNTIME_STATE="$RUNTIME_DIR/mnx-test.current"

      #@MNX-PART id=99.30.mnx-test.function.latest_report kind=function title="Function latest_report"
      latest_report() {
        local result
        result="$(readlink -f "$REPORT_DIR/mnx-test-latest.txt" 2>/dev/null || true)"
        if [[ -z "$result" || ! -f "$result" ]]; then
          result="$(find "$REPORT_DIR" -maxdepth 1 -type f -name 'mnx-test-*.txt' -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -n 1 | sed -E 's/^[^ ]+ //')"
        fi
        printf '%s\n' "$result"
      }

      #@MNX-PART id=99.30.mnx-test.function.field_from_file kind=function title="Function field_from_file"
      field_from_file() {
        local file="$1" key="$2"
        sed -n "s/^''${key}=//p" "$file" 2>/dev/null | tail -n 1
      }

      #@MNX-PART id=99.30.mnx-test.function.process_cmdline kind=function title="Function process_cmdline"
      process_cmdline() {
        local pid="$1"
        [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]] || return 1
        tr '\0' ' ' < "/proc/$pid/cmdline"
      }

      #@MNX-PART id=99.30.mnx-test.function.process_is_mnx_test kind=function title="Function process_is_mnx_test"
      process_is_mnx_test() {
        local pid="$1" cmd
        cmd="$(process_cmdline "$pid" 2>/dev/null || true)"
        [[ "$cmd" == *mnx-test* || "$cmd" == *"configuration.nix test"* ]]
      }

      #@MNX-PART id=99.30.mnx-test.function.child_identity_is_expected kind=function title="Function child_identity_is_expected"
      child_identity_is_expected() {
        local pid="$1" expected_pgid="$2" cmd actual_pgid
        [[ "$pid" =~ ^[0-9]+$ && "$expected_pgid" =~ ^[0-9]+$ ]] || return 1
        kill -0 "$pid" 2>/dev/null || return 1
        actual_pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
        [[ "$actual_pgid" == "$expected_pgid" ]] || return 1
        cmd="$(process_cmdline "$pid" 2>/dev/null || true)"
        [[ "$cmd" =~ (nixos-rebuild|mnx-config-audit|mnx-support-report|mnx-behavior-manifest|systemctl[[:space:]]+is-system-running) ]]
      }

      if [[ "$SUBCOMMAND" == status ]]; then
        if [[ ! -s "$RUNTIME_STATE" ]]; then
          echo 'mnx_test_running=no'
          LATEST="$(latest_report)"
          [[ -z "$LATEST" ]] || { printf 'latest_report=%s\n' "$LATEST"; grep -E '^(mnx_test_result|terminal_phase|interrupted_signal|candidate_configuration_sha256|safe_to_run_operator_normal_switch)=' "$LATEST" | tail -n 20 || true; }
          exit 0
        fi
        cat "$RUNTIME_STATE"
        PID="$(field_from_file "$RUNTIME_STATE" pid)"
        CHILD_PID_STATE="$(field_from_file "$RUNTIME_STATE" child_pid)"
        CHILD_PGID_STATE="$(field_from_file "$RUNTIME_STATE" child_pgid)"
        if [[ "$PID" =~ ^[0-9]+$ ]] && kill -0 "$PID" 2>/dev/null && process_is_mnx_test "$PID"; then
          echo 'mnx_test_running=yes'
          ps -o pid,ppid,pgid,etime,stat,cmd -p "$PID" 2>/dev/null || true
          [[ ! "$CHILD_PID_STATE" =~ ^[0-9]+$ ]] || ps -o pid,ppid,pgid,etime,stat,cmd -p "$CHILD_PID_STATE" 2>/dev/null || true
          exit 0
        fi
        echo 'mnx_test_running=no'
        echo 'mnx_test_state=stale'
        if child_identity_is_expected "$CHILD_PID_STATE" "$CHILD_PGID_STATE"; then
          echo 'mnx_test_orphan_child=yes'
          ps -o pid,ppid,pgid,etime,stat,cmd -p "$CHILD_PID_STATE" 2>/dev/null || true
        else
          echo 'mnx_test_orphan_child=no-or-unverified'
        fi
        echo 'recovery_command=mnx test-recover'
        exit 1
      fi

      if [[ "$SUBCOMMAND" == cancel ]]; then
        if [[ ''${EUID:-$(id -u)} -ne 0 ]]; then
          [[ -x /run/wrappers/bin/sudo ]] || { echo '/run/wrappers/bin/sudo is unavailable' >&2; exit 126; }
          exec /run/wrappers/bin/sudo -- /etc/monsternix/bin/mnx-test cancel
        fi
        [[ -s "$RUNTIME_STATE" ]] || { echo 'no active mnx test state exists'; exit 0; }
        PID="$(field_from_file "$RUNTIME_STATE" pid)"
        PHASE_NOW="$(field_from_file "$RUNTIME_STATE" phase)"
        if [[ "$PID" =~ ^[0-9]+$ ]] && kill -0 "$PID" 2>/dev/null && process_is_mnx_test "$PID"; then
          printf 'sending_TERM_to_mnx_test_pid=%s phase=%s\n' "$PID" "$PHASE_NOW"
          kill -TERM "$PID"
          for _ in $(seq 1 120); do
            kill -0 "$PID" 2>/dev/null || { echo 'mnx_test_cancelled=yes'; exit 0; }
            sleep 0.5
          done
          echo 'mnx_test_cancel_timeout=yes' >&2
          echo 'recovery_command=mnx test-recover' >&2
          exit 1
        fi
        echo "stale_mnx_test_pid=''${PID:-missing}"
        echo 'escalating_to_stale_recovery=yes'
        SUBCOMMAND=recover
      fi

      if [[ "$SUBCOMMAND" == recover ]]; then
        if [[ ''${EUID:-$(id -u)} -ne 0 ]]; then
          [[ -x /run/wrappers/bin/sudo ]] || { echo '/run/wrappers/bin/sudo is unavailable' >&2; exit 126; }
          exec /run/wrappers/bin/sudo -- /etc/monsternix/bin/mnx-test recover
        fi
        [[ -s "$RUNTIME_STATE" ]] || { echo 'mnx_test_recovery=NOT_NEEDED'; echo 'runtime_state=absent'; exit 0; }
        install -d -m 2750 -o root -g logbook "$REPORT_DIR"
        RECOVERY_STAMP="$(date +%Y%m%dT%H%M%S)-$$"
        RECOVERY_REPORT="$REPORT_DIR/mnx-test-recovery-$RECOVERY_STAMP.txt"
        exec > >(tee "$RECOVERY_REPORT") 2>&1
        echo '################################################################################'
        echo '# MNX TEST STALE/ORPHAN RECOVERY'
        echo '################################################################################'
        date -Is
        printf 'runtime_state=%s\nrecovery_report=%s\n' "$RUNTIME_STATE" "$RECOVERY_REPORT"
        cat "$RUNTIME_STATE"
        PID="$(field_from_file "$RUNTIME_STATE" pid)"
        CHILD_PID_STATE="$(field_from_file "$RUNTIME_STATE" child_pid)"
        CHILD_PGID_STATE="$(field_from_file "$RUNTIME_STATE" child_pgid)"
        BEFORE_STATE_SYSTEM="$(field_from_file "$RUNTIME_STATE" before_running_system)"
        BEFORE_STATE_DEFAULT="$(field_from_file "$RUNTIME_STATE" before_default_system)"
        PHASE_NOW="$(field_from_file "$RUNTIME_STATE" phase)"
        ORIGINAL_REPORT="$(field_from_file "$RUNTIME_STATE" report)"
        RECOVERY_RC=0
        ORPHAN_TERMINATED=no
        ROLLBACK_RECOVERY_RC=not-needed

        if [[ "$PID" =~ ^[0-9]+$ ]] && kill -0 "$PID" 2>/dev/null && process_is_mnx_test "$PID"; then
          printf 'active_parent_detected=%s phase=%s\n' "$PID" "$PHASE_NOW"
          kill -TERM "$PID" 2>/dev/null || true
          for _ in $(seq 1 120); do
            kill -0 "$PID" 2>/dev/null || break
            sleep 0.5
          done
          if kill -0 "$PID" 2>/dev/null; then
            echo 'parent_did_not_exit_after_TERM=yes'
            kill -KILL "$PID" 2>/dev/null || true
            sleep 1
          fi
          if [[ ! -s "$RUNTIME_STATE" ]]; then
            echo 'parent_completed_its_own_cleanup=yes'
            echo 'mnx_test_recovery=PASS'
            exit 0
          fi
        fi

        if child_identity_is_expected "$CHILD_PID_STATE" "$CHILD_PGID_STATE"; then
          printf 'terminating_orphan_child_pid=%s child_pgid=%s\n' "$CHILD_PID_STATE" "$CHILD_PGID_STATE"
          kill -TERM -- "-$CHILD_PGID_STATE" 2>/dev/null || true
          for _ in $(seq 1 80); do
            kill -0 "$CHILD_PID_STATE" 2>/dev/null || break
            sleep 0.25
          done
          if kill -0 "$CHILD_PID_STATE" 2>/dev/null; then
            kill -KILL -- "-$CHILD_PGID_STATE" 2>/dev/null || true
            sleep 1
          fi
          if kill -0 "$CHILD_PID_STATE" 2>/dev/null; then
            echo 'orphan_child_still_alive=yes' >&2
            RECOVERY_RC=1
          else
            ORPHAN_TERMINATED=yes
          fi
        elif [[ "$CHILD_PID_STATE" =~ ^[0-9]+$ ]] && kill -0 "$CHILD_PID_STATE" 2>/dev/null; then
          echo "refusing_unverified_child_pid=$CHILD_PID_STATE expected_pgid=''${CHILD_PGID_STATE:-missing}" >&2
          RECOVERY_RC=1
        else
          echo 'orphan_child=absent'
        fi

        CURRENT_SYSTEM="$(readlink -f /run/current-system 2>/dev/null || true)"
        CURRENT_DEFAULT="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
        printf 'current_running_system=%s\ncurrent_default_system=%s\n' "$CURRENT_SYSTEM" "$CURRENT_DEFAULT"
        if [[ -n "$BEFORE_STATE_SYSTEM" && "$CURRENT_SYSTEM" != "$BEFORE_STATE_SYSTEM" ]]; then
          echo 'partial_or_unverified_activation_detected=yes'
          if [[ -x "$BEFORE_STATE_SYSTEM/bin/switch-to-configuration" ]]; then
            if "$BEFORE_STATE_SYSTEM/bin/switch-to-configuration" test; then
              ROLLBACK_RECOVERY_RC=0
            else
              ROLLBACK_RECOVERY_RC="$?"
              RECOVERY_RC=1
            fi
          else
            ROLLBACK_RECOVERY_RC=126
            RECOVERY_RC=1
            echo "prior closure is unavailable: $BEFORE_STATE_SYSTEM" >&2
          fi
        fi
        FINAL_RUNNING="$(readlink -f /run/current-system 2>/dev/null || true)"
        FINAL_DEFAULT="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
        [[ -z "$BEFORE_STATE_SYSTEM" || "$FINAL_RUNNING" == "$BEFORE_STATE_SYSTEM" ]] || RECOVERY_RC=1
        if [[ -n "$BEFORE_STATE_DEFAULT" && "$FINAL_DEFAULT" != "$BEFORE_STATE_DEFAULT" ]]; then
          echo 'boot_default_changed_since_test=YES' >&2
          RECOVERY_RC=1
        else
          echo 'boot_default_changed_since_test=no'
        fi
        printf 'orphan_child_terminated=%s\nrollback_recovery_rc=%s\n' "$ORPHAN_TERMINATED" "$ROLLBACK_RECOVERY_RC"
        printf 'final_running_system=%s\nfinal_default_system=%s\n' "$FINAL_RUNNING" "$FINAL_DEFAULT"
        printf 'original_report=%s\n' "''${ORIGINAL_REPORT:-unknown}"
        chown root:logbook "$RECOVERY_REPORT" 2>/dev/null || true
        chmod 0640 "$RECOVERY_REPORT" 2>/dev/null || true
        if (( RECOVERY_RC == 0 )); then
          rm -f "$RUNTIME_STATE"
          echo 'mnx_test_recovery=PASS'
          exit 0
        fi
        echo 'mnx_test_recovery=FAIL' >&2
        echo 'runtime_state_retained_for_manual_review=yes' >&2
        exit 1
      fi

      if [[ "$SUBCOMMAND" == errors || "$SUBCOMMAND" == raw ]]; then
        LATEST="$(latest_report)"
        [[ -n "$LATEST" && -f "$LATEST" ]] || { echo 'no MNX test transcript exists' >&2; exit 1; }
        if [[ "$SUBCOMMAND" == errors ]]; then
          printf 'latest_report=%s\n' "$LATEST"
          grep -E '^(mnx_test_result|terminal_phase|interrupted_signal|interrupted_phase|source_audit_rc|source_bootstrap_rc|source_program_compatibility_rc|source_full_compatibility_rc|source_handoff_mode|source_handoff_live_probe|candidate_authoritative_source_gate|candidate_temporary_code_gate_rc|nixos_rebuild_test_rc|post_test_audit_rc|behavior_contract_rc|support_report_rc|rollback_rc|safe_to_run_operator_normal_switch|.*_log=)' "$LATEST" | tail -n 100 || true
          REBUILD="$(field_from_file "$LATEST" rebuild_log)"
          [[ -n "$REBUILD" && -r "$REBUILD" ]] || exit 0
          printf '\n--- rebuild error context ---\n'
          grep -n -C 4 -E -i '(^|[[:space:]])error:|trace:|failed|assertion|undefined variable|option .* does not exist|No space left|Read-only file system|Permission denied|collision' "$REBUILD" | head -n 300 || true
          printf '\n--- rebuild tail ---\n'
          tail -n 160 "$REBUILD" || true
          exit 0
        fi
        WHICH="''${1:-rebuild}"
        case "$WHICH" in
          rebuild) KEY=rebuild_log ;;
          source) KEY=source_audit_log ;;
          post) KEY=post_audit_log ;;
          support) KEY=support_log ;;
          contract) KEY=contract_log ;;
          state) KEY=state_file ;;
          *) echo "unknown raw log selector: $WHICH" >&2; exit 64 ;;
        esac
        FILE="$(field_from_file "$LATEST" "$KEY")"
        [[ -n "$FILE" && -r "$FILE" ]] || { echo "$KEY is absent or unreadable: ''${FILE:-<none>}" >&2; exit 1; }
        exec cat "$FILE"
      fi

      if [[ ''${EUID:-$(id -u)} -ne 0 ]]; then
        [[ -x /run/wrappers/bin/sudo ]] || { echo '/run/wrappers/bin/sudo is unavailable' >&2; exit 126; }
        SUDO_ARGS=( /etc/monsternix/bin/mnx-test --config "$CFG" "--support=$SUPPORT_POLICY" )
        [[ "$ROLLBACK_ON_FAILURE" == 1 ]] || SUDO_ARGS+=( --no-rollback )
        [[ "$ALLOW_DIRTY_BASELINE" == 0 ]] || SUDO_ARGS+=( --allow-dirty-baseline )
        [[ "$ALLOW_BEHAVIOR_CHANGE" == 0 ]] || SUDO_ARGS+=( --allow-behavior-change )
        [[ "$VERBOSE" == 0 ]] || SUDO_ARGS+=( --verbose )
        [[ "$TEST_TIMEOUT" == 0 ]] || SUDO_ARGS+=( --timeout "$TEST_TIMEOUT" )
        exec /run/wrappers/bin/sudo -- "''${SUDO_ARGS[@]}"
      fi

      STAMP="$(date +%Y%m%dT%H%M%S)-$$"
      REPORT_BASE="$REPORT_DIR/mnx-test-$STAMP"
      REPORT="$REPORT_BASE.txt"
      CANDIDATE_SNAPSHOT="$REPORT_BASE.candidate.nix"
      SOURCE_AUDIT_LOG="$REPORT_BASE.source-audit.log"
      SOURCE_PROGRAM_COMPAT_LOG="$REPORT_BASE.source-program-compat.log"
      SOURCE_FULL_COMPAT_LOG="$REPORT_BASE.source-full-compat.log"
      TEMP_GATE_LOG="$REPORT_BASE.temp-gate.log"
      REBUILD_LOG="$REPORT_BASE.rebuild.log"
      POST_AUDIT_LOG="$REPORT_BASE.post-audit.log"
      SUPPORT_LOG="$REPORT_BASE.support.log"
      CONTRACT_LOG="$REPORT_BASE.contract.log"
      SETTLE_LOG="$REPORT_BASE.settle.log"
      STATE_FILE="$REPORT_BASE.state"

      FINAL_RESULT=INCOMPLETE
      PHASE=initializing
      TERMINAL_PHASE=initializing
      BOOT_DEFAULT_CHANGED=unknown
      REBUILD_RC=not-run
      SOURCE_AUDIT_RC=not-run
      SOURCE_BOOTSTRAP_RC=not-run
      SOURCE_PROGRAM_COMPAT_RC=not-run
      SOURCE_FULL_COMPAT_RC=not-run
      SOURCE_HANDOFF_MODE=not-run
      CANDIDATE_TEMP_GATE_RC=not-run
      POST_AUDIT_RC=not-run
      SUPPORT_RC=not-run
      CONTRACT_RC=not-configured
      ROLLBACK_RC=not-needed
      SETTLE_RC=not-run
      BEFORE_SYSTEM=
      BEFORE_DEFAULT=
      AFTER_SYSTEM=
      AFTER_DEFAULT=
      BASELINE_KIND=unknown
      BASELINE_RUNNING_IS_BOOT_DEFAULT=unknown
      CANDIDATE_HASH=unknown
      LINEAGE_DEFAULT_BEFORE=
      CANONICAL_LINEAGE_CHECKPOINTS=none
      ORIGINAL_HASH=unknown
      LIVE_SOURCE_HASH_AFTER=not-checked
      SOURCE_MUTATED=unknown
      ACTIVATED_EMBEDDED_HASH=not-checked
      ACTIVATED_EMBEDDED_MATCH=unknown
      ACTIVE_EMBEDDED_HASH=unknown
      DEFERRED_REASON=none
      DEFERRED_UNITS=none
      RETRY_RECOMMENDED=no
      SAFE_TO_SWITCH=no
      INTERRUPTED_SIGNAL=none
      INTERRUPTED_PHASE=none
      CHILD_PID=
      CHILD_PGID=
      TAIL_PID=
      CORE_VALIDATED=no
      ACTIVATION_STARTED=no
      SIGNAL_HANDLING=0
      TEST_LOCK_HELD=0
      BEHAVIOR_CHANGE_ALLOWED_RESULT=no
      TEMPORARY_CODE_REGION_COUNT=0
      TEMPORARY_CODE_REGION_IDS=none
      START_EPOCH="$(date +%s)"
      TEST_STARTED=not-started
      TEST_ENDED=not-ended
      LAST_CHILD_RC=not-run
      MAINTENANCE_WAITED_SECONDS=0
      MAINTENANCE_WAIT_UNITS=none
      CONTENTION_ADVISORY_UNITS=none
      OPERATOR_PREEMPTION_ATTEMPTED=no
      OPERATOR_PREEMPTION_REQUESTED=no
      OPERATOR_PREEMPTION_RESULT=not-needed
      OPERATOR_PREEMPTION_UNIT=none
      OPERATOR_PREEMPTION_MAIN_PID=0
      OPERATOR_PREEMPTION_INVOCATION_ID=none
      OPERATOR_PREEMPTION_SUCCESS_RECEIPT_BEFORE=not-observed
      OPERATOR_PREEMPTION_SUCCESS_RECEIPT_AFTER=not-observed

      install -d -m 2750 -o root -g logbook "$REPORT_DIR"
      install -d -m 0755 -o root -g root "$RUNTIME_DIR"
      # Keep the file sink alive for the signal finalizer after terminal loss.
      exec > >(trap "" INT TERM HUP; exec tee --output-error=warn-nopipe "$REPORT") 2>&1

      #@MNX-PART id=99.30.mnx-test.function.section kind=function title="Function section"
      section() {
        printf '\n\n################################################################################\n# %s\n################################################################################\n' "$1"
      }

      #@MNX-PART id=99.30.mnx-test.function.sanitize_phase kind=function title="Function sanitize_phase"
      sanitize_phase() {
        printf '%s' "$1" | tr '[:lower:]- ' '[:upper:]__' | tr -cd 'A-Z0-9_'
      }

      #@MNX-PART id=99.30.mnx-test.function.write_state kind=function title="Function write_state"
      write_state() {
        local tmp="$STATE_FILE.tmp.$$"
        {
          printf 'state_version=2\n'
          printf 'pid=%s\n' "$$"
          printf 'phase=%s\n' "$PHASE"
          printf 'result=%s\n' "$FINAL_RESULT"
          printf 'started_epoch=%s\n' "$START_EPOCH"
          printf 'updated_epoch=%s\n' "$(date +%s)"
          printf 'configuration=%s\n' "$CFG"
          printf 'candidate_snapshot=%s\n' "$CANDIDATE_SNAPSHOT"
          printf 'candidate_configuration_sha256=%s\n' "$CANDIDATE_HASH"
          printf 'report=%s\n' "$REPORT"
          printf 'source_audit_log=%s\n' "$SOURCE_AUDIT_LOG"
          printf 'source_program_compat_log=%s\n' "$SOURCE_PROGRAM_COMPAT_LOG"
          printf 'source_full_compat_log=%s\n' "$SOURCE_FULL_COMPAT_LOG"
          printf 'temporary_code_gate_log=%s\n' "$TEMP_GATE_LOG"
          printf 'source_bootstrap_rc=%s\n' "$SOURCE_BOOTSTRAP_RC"
          printf 'source_program_compatibility_rc=%s\n' "$SOURCE_PROGRAM_COMPAT_RC"
          printf 'source_full_compatibility_rc=%s\n' "$SOURCE_FULL_COMPAT_RC"
          printf 'source_handoff_mode=%s\n' "$SOURCE_HANDOFF_MODE"
          printf 'rebuild_log=%s\n' "$REBUILD_LOG"
          printf 'post_audit_log=%s\n' "$POST_AUDIT_LOG"
          printf 'support_log=%s\n' "$SUPPORT_LOG"
          printf 'contract_log=%s\n' "$CONTRACT_LOG"
          printf 'before_running_system=%s\n' "$BEFORE_SYSTEM"
          printf 'before_default_system=%s\n' "$BEFORE_DEFAULT"
          printf 'child_pid=%s\n' "$CHILD_PID"
          printf 'child_pgid=%s\n' "$CHILD_PGID"
          printf 'interrupted_signal=%s\n' "$INTERRUPTED_SIGNAL"
          printf 'temporary_code_region_count=%s\n' "$TEMPORARY_CODE_REGION_COUNT"
          printf 'temporary_code_region_ids=%s\n' "$TEMPORARY_CODE_REGION_IDS"
          printf 'interrupted_phase=%s\n' "$INTERRUPTED_PHASE"
          printf 'maintenance_waited_seconds=%s\n' "$MAINTENANCE_WAITED_SECONDS"
          printf 'maintenance_wait_units=%s\n' "$MAINTENANCE_WAIT_UNITS"
          printf 'contention_advisory_units=%s\n' "$CONTENTION_ADVISORY_UNITS"
          printf 'operator_preemption_requested=%s\n' "$OPERATOR_PREEMPTION_REQUESTED"
          printf 'operator_preemption_result=%s\n' "$OPERATOR_PREEMPTION_RESULT"
          printf 'operator_preemption_unit=%s\n' "$OPERATOR_PREEMPTION_UNIT"
          printf 'operator_preemption_main_pid=%s\n' "$OPERATOR_PREEMPTION_MAIN_PID"
          printf 'operator_preemption_invocation_id=%s\n' "$OPERATOR_PREEMPTION_INVOCATION_ID"
          printf 'operator_preemption_success_receipt_before=%s\n' "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_BEFORE"
          printf 'operator_preemption_success_receipt_after=%s\n' "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_AFTER"
        } > "$tmp" || return 1
        chown root:logbook "$tmp" || return 1
        chmod 0640 "$tmp" || return 1
        mv -f "$tmp" "$STATE_FILE" || return 1
        # A rejected contender owns only its private attempt record.
        if [[ "$TEST_LOCK_HELD" == 1 ]]; then
          cp -f "$STATE_FILE" "$RUNTIME_STATE.tmp.$$" || return 1
          chmod 0644 "$RUNTIME_STATE.tmp.$$" || return 1
          mv -f "$RUNTIME_STATE.tmp.$$" "$RUNTIME_STATE" || return 1
        fi
      }

      #@MNX-PART id=99.30.mnx-test.function.set_phase kind=function title="Function set_phase"
      set_phase() {
        PHASE="$1"
        write_state
      }

      #@MNX-PART id=99.30.mnx-test.function.fatal kind=function title="Function fatal"
      fatal() {
        local result="$1"
        shift
        FINAL_RESULT="$result"
        printf 'MNX_TEST_FATAL: %s\n' "$*" >&2
        exit 1
      }

      #@MNX-PART id=99.30.mnx-test.function.die kind=function title="Function die"
      die() {
        fatal FAIL "$@"
      }

      #@MNX-PART id=99.30.mnx-test.function.show_busy_unit kind=function title="Function show_busy_unit"
      show_busy_unit() {
        local unit="$1"
        printf '\n--- busy unit: %s ---\n' "$unit"
        systemctl show "$unit" \
          -p ActiveState -p SubState -p Result \
          -p ExecMainStartTimestamp -p ExecMainExitTimestamp \
          -p MemoryCurrent -p MemoryPeak -p IOReadBytes -p IOWriteBytes \
          --no-pager 2>&1 || true
        journalctl -u "$unit" --no-pager -o short-iso -n 30 2>&1 || true
      }

      #@MNX-PART id=99.30.mnx-test.function.defer_test kind=function title="Function defer_test"
      defer_test() {
        local result="$1"
        local reason="$2"
        shift 2
        FINAL_RESULT="$result"
        DEFERRED_REASON="$reason"
        if (( $# > 0 )); then DEFERRED_UNITS="$*"; fi
        RETRY_RECOMMENDED=yes
        if [[ "$reason" == another-mnx-test ]]; then
          printf 'existing_test_state_preserved=yes\ncompeting_attempt_action=inspect-existing-run-not-immediate-retry\n'
          if [[ -f "$RUNTIME_STATE" && ! -L "$RUNTIME_STATE" ]]; then
            grep -E '^(pid|phase|started_epoch|report|candidate_configuration_sha256)=' "$RUNTIME_STATE" || true
          fi
        fi
        #@MNX-PART id=99.30.mnx-test.phase.mnx-test-deferred-safe-to-retry kind=phase title="Phase: MNX TEST DEFERRED — SAFE TO RETRY"
        section 'MNX TEST DEFERRED — SAFE TO RETRY'
        printf 'deferred_reason=%s\n' "$DEFERRED_REASON"
        printf 'deferred_units=%s\n' "$DEFERRED_UNITS"
        for unit in "$@"; do show_busy_unit "$unit"; done
        printf '\nStorage/test lock holders:\n'
        timeout 15s lslocks -o COMMAND,PID,TYPE,MODE,PATH 2>&1 | grep -E 'COMMAND|mnx-test|storage-maintenance' || true
        printf '\nRelevant processes:\n'
        pgrep -af 'btrbk|btrfs (send|receive|scrub|subvolume sync)|rsync|duperemove|m21-btrfs|fstrim|mnx-test' 2>&1 || true
        printf 'retry_recommended=yes\nretry_command=mnx test\n'
        exit 75
      }

      #@MNX-PART id=99.30.mnx-test.function.exclusive-maintenance-units kind=function title="Function exclusive_maintenance_units"
      exclusive_maintenance_units() {
        local unit state
        for unit in nixos-upgrade.service nix-gc.service 'btrfs-scrub--.service'; do
          state="$(systemctl is-active "$unit" 2>/dev/null || true)"
          case "$state" in active|activating|reloading|deactivating) printf '%s\n' "$unit" ;; esac
        done
      }

      #@MNX-PART id=99.30.mnx-test.function.lock-protected-maintenance-units kind=function title="Function lock_protected_maintenance_units"
      lock_protected_maintenance_units() {
        local unit state
        for unit in \
          btrbk-main.service btrbk-archive-to-new-storage.service m21-btrfs-pull-backup.service \
          m16-backup-m21.service m16-restic-maintenance.service \
          rsync-m16-new-to-old.service duperemove-home.service duperemove-m16-new-storage.service
        do
          state="$(systemctl is-active "$unit" 2>/dev/null || true)"
          case "$state" in active|activating|reloading|deactivating) printf '%s\n' "$unit" ;; esac
        done
      }

      #@MNX-PART id=99.30.mnx-test.function.contention-only-units kind=function title="Function contention_only_units"
      contention_only_units() {
        local unit state
        for unit in fstrim.service 'btrfs-scrub-mnt-m16\x2dnew\x2dstorage.service'; do
          state="$(systemctl is-active "$unit" 2>/dev/null || true)"
          case "$state" in active|activating|reloading|deactivating) printf '%s\n' "$unit" ;; esac
        done
      }

      #@MNX-PART id=99.30.mnx-test.function.restartable-rsync-success-receipt-identity kind=function title="Function restartable_rsync_success_receipt_identity"
      restartable_rsync_success_receipt_identity() {
        local receipt=/var/lib/monsternix/job-state/authoritative/rsync-m16-new-to-old.last-success before after digest
        if [[ ! -e "$receipt" && ! -L "$receipt" ]]; then
          printf 'absent\n'
          return 0
        fi
        [[ -f "$receipt" && ! -L "$receipt" ]] || return 1
        before="$(stat -c '%d:%i:%s:%Y:%Z:%u:%g:%a:%h' "$receipt" 2>/dev/null)" || return 1
        digest="$(sha256sum "$receipt" 2>/dev/null | awk 'NR == 1 { print $1 }')" || return 1
        [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || return 1
        after="$(stat -c '%d:%i:%s:%Y:%Z:%u:%g:%a:%h' "$receipt" 2>/dev/null)" || return 1
        [[ "$before" == "$after" ]] || return 1
        printf '%s:%s\n' "$before" "$digest"
      }

      #@MNX-PART id=99.30.mnx-test.function.request-restartable-rsync-preemption kind=function title="Function request_restartable_rsync_preemption"
      request_restartable_rsync_preemption() {
        local unit=rsync-m16-new-to-old.service state load main_pid invocation private_mounts kill_mode restart_policy
        state="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
        case "$state" in active|activating|reloading) ;; *) return 0 ;; esac
        OPERATOR_PREEMPTION_ATTEMPTED=yes
        load="$(systemctl show "$unit" -p LoadState --value 2>/dev/null || true)"
        main_pid="$(systemctl show "$unit" -p MainPID --value 2>/dev/null || true)"
        invocation="$(systemctl show "$unit" -p InvocationID --value 2>/dev/null || true)"
        private_mounts="$(systemctl show "$unit" -p PrivateMounts --value 2>/dev/null || true)"
        kill_mode="$(systemctl show "$unit" -p KillMode --value 2>/dev/null || true)"
        restart_policy="$(systemctl show "$unit" -p Restart --value 2>/dev/null || true)"
        [[ "$load" == loaded ]] || { OPERATOR_PREEMPTION_RESULT=refused-load-state; return 6; }
        [[ "$main_pid" =~ ^[1-9][0-9]*$ ]] || { OPERATOR_PREEMPTION_RESULT=refused-main-pid; return 6; }
        [[ "$invocation" =~ ^[0-9a-f]{32}$ ]] || { OPERATOR_PREEMPTION_RESULT=refused-invocation-id; return 6; }
        case "$private_mounts" in yes|true|1) ;; *) OPERATOR_PREEMPTION_RESULT=refused-private-mounts; return 6 ;; esac
        [[ "$kill_mode" == control-group ]] || { OPERATOR_PREEMPTION_RESULT=refused-kill-mode; return 6; }
        [[ "$restart_policy" == no ]] || { OPERATOR_PREEMPTION_RESULT=refused-restart-policy; return 6; }
        OPERATOR_PREEMPTION_SUCCESS_RECEIPT_BEFORE="$(restartable_rsync_success_receipt_identity)" || { OPERATOR_PREEMPTION_RESULT=unsafe-success-receipt-before; return 6; }
        OPERATOR_PREEMPTION_REQUESTED=yes
        OPERATOR_PREEMPTION_UNIT="$unit"
        OPERATOR_PREEMPTION_MAIN_PID="$main_pid"
        OPERATOR_PREEMPTION_INVOCATION_ID="$invocation"
        printf 'operator_preemption_request=manager-stop-retryable\noperator_preemption_unit=%s\noperator_preemption_main_pid=%s\noperator_preemption_invocation_id=%s\noperator_preemption_private_mounts=%s\noperator_preemption_kill_mode=%s\noperator_preemption_restart_policy=%s\noperator_preemption_success_receipt_before=%s\n' \
          "$unit" "$main_pid" "$invocation" "$private_mounts" "$kill_mode" "$restart_policy" "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_BEFORE"
        if ! systemctl --no-block stop "$unit"; then
          OPERATOR_PREEMPTION_RESULT=stop-request-failed
          return 6
        fi
        OPERATOR_PREEMPTION_RESULT=requested
        return 0
      }

      #@MNX-PART id=99.30.mnx-test.function.acquire-operator-storage-lane kind=function title="Function acquire_operator_storage_lane"
      acquire_operator_storage_lane() {
        local started now elapsed remaining last_notice=-60 busy="" seen="" lock_holders="" current_source current_running current_default current_state current_failed invariant_rc preempt_state preempt_invocation preempt_result preempt_exec_code preempt_exec_status old_options final_failed
        started="$(date +%s)"

        # Queue for the shared mutation lock. Once acquired, retain it through
        # evaluation, build, activation, audit, behavior comparison, and evidence.
        while ! flock -w "$MAINTENANCE_POLL_SECONDS" -x 9; do
          lock_holders="$(lock_protected_maintenance_units)"
          if [[ "$OPERATOR_PREEMPTION_ATTEMPTED" == no ]]; then
            request_restartable_rsync_preemption || return "$?"
          fi
          busy="''${lock_holders:-storage-maintenance.lock}"
          seen+=$'\n'"$busy"
          now="$(date +%s)"
          elapsed=$(( now - started ))
          remaining=$(( MAINTENANCE_WAIT_SECONDS - elapsed ))
          MAINTENANCE_WAIT_UNITS="$(printf '%s\n' "$seen" | sed '/^$/d' | sort -u | paste -sd, -)"
          if (( elapsed >= MAINTENANCE_WAIT_SECONDS )); then
            MAINTENANCE_WAITED_SECONDS="$elapsed"
            return 75
          fi
          if (( elapsed - last_notice >= 60 )); then
            printf '%s phase=maintenance-wait elapsed=%ss remaining=%ss units=%s policy=operator-lock-first\n' \
              "$(date -Is)" "$elapsed" "$remaining" "$MAINTENANCE_WAIT_UNITS"
            last_notice="$elapsed"
          fi
          invariant_rc=0
          current_source="$(sha256sum "$CFG" 2>/dev/null | awk '{print $1}')"
          [[ "$current_source" == "$CANDIDATE_HASH" ]] || invariant_rc=2
          current_running="$(readlink -f /run/current-system 2>/dev/null || true)"
          [[ "$invariant_rc" != 0 || "$current_running" == "$BEFORE_SYSTEM" ]] || invariant_rc=3
          current_default="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
          [[ "$invariant_rc" != 0 || "$current_default" == "$BEFORE_DEFAULT" ]] || invariant_rc=4
          current_state="$(systemctl is-system-running 2>/dev/null || true)"
          current_failed="$(systemctl --failed --no-legend --plain 2>/dev/null | grep -Ev '^[[:space:]]*$|^[0-9]+ loaded units listed[.]$' || true)"
          if [[ "$OPERATOR_PREEMPTION_REQUESTED" == yes ]]; then
            current_failed="$(printf '%s\n' "$current_failed" | grep -Ev '^[[:space:]]*rsync-m16-new-to-old[.]service([[:space:]]|$)' || true)"
          fi
          [[ "$invariant_rc" != 0 || ( ( "$current_state" == running || ( "$OPERATOR_PREEMPTION_REQUESTED" == yes && "$current_state" == degraded ) ) && -z "$current_failed" ) ]] || invariant_rc=5
          (( invariant_rc == 0 )) || return "$invariant_rc"
        done

        # Keep the lock while non-lock-aware exclusions finish. Scheduled jobs now
        # fail their nonblocking lock attempt instead of overtaking this transaction.
        while :; do
          busy="$(exclusive_maintenance_units)"
          lock_holders="$(lock_protected_maintenance_units)"
          if [[ -n "$lock_holders" ]]; then
            busy+="''${busy:+$'\n'}$lock_holders"
          fi
          [[ -n "$busy" ]] || break
          seen+=$'\n'"$busy"
          now="$(date +%s)"
          elapsed=$(( now - started ))
          remaining=$(( MAINTENANCE_WAIT_SECONDS - elapsed ))
          MAINTENANCE_WAIT_UNITS="$(printf '%s\n' "$seen" | sed '/^$/d' | sort -u | paste -sd, -)"
          if (( elapsed >= MAINTENANCE_WAIT_SECONDS )); then
            MAINTENANCE_WAITED_SECONDS="$elapsed"
            flock -u 9
            return 75
          fi
          if (( elapsed - last_notice >= 60 )); then
            printf '%s phase=maintenance-wait elapsed=%ss remaining=%ss units=%s policy=operator-lock-held\n' \
              "$(date -Is)" "$elapsed" "$remaining" "$MAINTENANCE_WAIT_UNITS"
            last_notice="$elapsed"
          fi
          invariant_rc=0
          current_source="$(sha256sum "$CFG" 2>/dev/null | awk '{print $1}')"
          [[ "$current_source" == "$CANDIDATE_HASH" ]] || invariant_rc=2
          current_running="$(readlink -f /run/current-system 2>/dev/null || true)"
          [[ "$invariant_rc" != 0 || "$current_running" == "$BEFORE_SYSTEM" ]] || invariant_rc=3
          current_default="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
          [[ "$invariant_rc" != 0 || "$current_default" == "$BEFORE_DEFAULT" ]] || invariant_rc=4
          current_state="$(systemctl is-system-running 2>/dev/null || true)"
          current_failed="$(systemctl --failed --no-legend --plain 2>/dev/null | grep -Ev '^[[:space:]]*$|^[0-9]+ loaded units listed[.]$' || true)"
          if [[ "$OPERATOR_PREEMPTION_REQUESTED" == yes ]]; then
            current_failed="$(printf '%s\n' "$current_failed" | grep -Ev '^[[:space:]]*rsync-m16-new-to-old[.]service([[:space:]]|$)' || true)"
          fi
          [[ "$invariant_rc" != 0 || ( ( "$current_state" == running || ( "$OPERATOR_PREEMPTION_REQUESTED" == yes && "$current_state" == degraded ) ) && -z "$current_failed" ) ]] || invariant_rc=5
          if (( invariant_rc != 0 )); then
            flock -u 9
            return "$invariant_rc"
          fi
          sleep "$MAINTENANCE_POLL_SECONDS"
        done

        if [[ "$OPERATOR_PREEMPTION_REQUESTED" == yes ]]; then
          preempt_state="$(systemctl show "$OPERATOR_PREEMPTION_UNIT" -p ActiveState --value 2>/dev/null || true)"
          case "$preempt_state" in inactive|failed) ;; *) OPERATOR_PREEMPTION_RESULT=unit-not-stopped; return 6 ;; esac
          preempt_invocation="$(systemctl show "$OPERATOR_PREEMPTION_UNIT" -p InvocationID --value 2>/dev/null || true)"
          [[ -z "$preempt_invocation" || "$preempt_invocation" == "$OPERATOR_PREEMPTION_INVOCATION_ID" ]] || { OPERATOR_PREEMPTION_RESULT=invocation-changed-during-stop; return 6; }
          [[ -n "$preempt_invocation" ]] || preempt_invocation=cleared-after-stop
          preempt_result="$(systemctl show "$OPERATOR_PREEMPTION_UNIT" -p Result --value 2>/dev/null || true)"
          preempt_exec_code="$(systemctl show "$OPERATOR_PREEMPTION_UNIT" -p ExecMainCode --value 2>/dev/null || true)"
          preempt_exec_status="$(systemctl show "$OPERATOR_PREEMPTION_UNIT" -p ExecMainStatus --value 2>/dev/null || true)"
          case "$preempt_result" in success|exit-code) ;; *) OPERATOR_PREEMPTION_RESULT=unexpected-unit-result; return 6 ;; esac
          case "$preempt_exec_code:$preempt_exec_status" in 0:0|1:0|1:75|1:143) ;; *) OPERATOR_PREEMPTION_RESULT=unexpected-main-exit; return 6 ;; esac
          old_options="$(findmnt -rn -T /mnt/m16-old-storage -o OPTIONS 2>/dev/null || true)"
          case ",$old_options," in *,ro,*) ;; *) OPERATOR_PREEMPTION_RESULT=host-old-storage-not-read-only; return 6 ;; esac
          OPERATOR_PREEMPTION_SUCCESS_RECEIPT_AFTER="$(restartable_rsync_success_receipt_identity)" || { OPERATOR_PREEMPTION_RESULT=unsafe-success-receipt-after; return 6; }
          [[ "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_AFTER" == "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_BEFORE" ]] || { OPERATOR_PREEMPTION_RESULT=success-receipt-advanced; return 6; }
          systemctl reset-failed "$OPERATOR_PREEMPTION_UNIT" || { OPERATOR_PREEMPTION_RESULT=reset-failed-error; return 6; }
          if systemctl is-failed --quiet "$OPERATOR_PREEMPTION_UNIT"; then OPERATOR_PREEMPTION_RESULT=failed-state-remains; return 6; fi
          final_failed="$(systemctl --failed --no-legend --plain 2>/dev/null | grep -Ev '^[[:space:]]*$|^[0-9]+ loaded units listed[.]$' || true)"
          [[ -z "$final_failed" ]] || { OPERATOR_PREEMPTION_RESULT=other-failed-unit; return 5; }
          OPERATOR_PREEMPTION_RESULT=pass
          printf 'operator_preemption_result=pass\noperator_preemption_final_state=%s\noperator_preemption_final_invocation_id=%s\noperator_preemption_unit_result=%s\noperator_preemption_exec_main_code=%s\noperator_preemption_exec_main_status=%s\noperator_preemption_host_old_storage=read-only\noperator_preemption_success_receipt_after=%s\noperator_preemption_success_receipt_advanced=false\n' "$preempt_state" "$preempt_invocation" "$preempt_result" "$preempt_exec_code" "$preempt_exec_status" "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_AFTER"
        fi

        now="$(date +%s)"
        MAINTENANCE_WAITED_SECONDS=$(( now - started ))
        if [[ -n "$seen" ]]; then
          MAINTENANCE_WAIT_UNITS="$(printf '%s\n' "$seen" | sed '/^$/d' | sort -u | paste -sd, -)"
        else
          MAINTENANCE_WAIT_UNITS=none
        fi
        printf 'operator_storage_lane=acquired-lock-first-and-held\nmaintenance_waited_seconds=%s\nmaintenance_wait_units=%s\n' "$MAINTENANCE_WAITED_SECONDS" "$MAINTENANCE_WAIT_UNITS"
        return 0
      }

      #@MNX-PART id=99.30.mnx-test.function.stop_tail kind=function title="Function stop_tail"
      stop_tail() {
        if [[ -n "$TAIL_PID" ]]; then
          kill "$TAIL_PID" 2>/dev/null || true
          wait "$TAIL_PID" 2>/dev/null || true
          TAIL_PID=
        fi
      }

      #@MNX-PART id=99.30.mnx-test.function.terminate_child_group kind=function title="Function terminate_child_group"
      terminate_child_group() {
        stop_tail
        [[ -n "$CHILD_PID" ]] || return 0
        if kill -0 "$CHILD_PID" 2>/dev/null; then
          printf 'terminating_child_pid=%s child_pgid=%s\n' "$CHILD_PID" "''${CHILD_PGID:-unknown}"
          if [[ "$CHILD_PGID" =~ ^[0-9]+$ ]]; then
            kill -TERM -- "-$CHILD_PGID" 2>/dev/null || kill -TERM "$CHILD_PID" 2>/dev/null || true
          else
            kill -TERM "$CHILD_PID" 2>/dev/null || true
          fi
          for _ in $(seq 1 40); do
            kill -0 "$CHILD_PID" 2>/dev/null || break
            sleep 0.25
          done
          if kill -0 "$CHILD_PID" 2>/dev/null; then
            if [[ "$CHILD_PGID" =~ ^[0-9]+$ ]]; then kill -KILL -- "-$CHILD_PGID" 2>/dev/null || true; else kill -KILL "$CHILD_PID" 2>/dev/null || true; fi
          fi
          wait "$CHILD_PID" 2>/dev/null || true
        fi
        CHILD_PID=
        CHILD_PGID=
      }

      #@MNX-PART id=99.30.mnx-test.function.activation_has_started kind=function title="Function activation_has_started"
      activation_has_started() {
        local current
        current="$(readlink -f /run/current-system 2>/dev/null || true)"
        if [[ -n "$BEFORE_SYSTEM" && -n "$current" && "$current" != "$BEFORE_SYSTEM" ]]; then return 0; fi
        [[ -s "$REBUILD_LOG" ]] && grep -Eq 'activating the configuration\.\.\.|switch-to-configuration' "$REBUILD_LOG"
      }

      #@MNX-PART id=99.30.mnx-test.function.rollback_previous kind=function title="Function rollback_previous"
      rollback_previous() {
        if [[ "$ROLLBACK_ON_FAILURE" != 1 ]]; then
          ROLLBACK_RC=disabled
          echo 'automatic rollback disabled by operator option'
          return 0
        fi
        if ! activation_has_started; then
          ROLLBACK_RC=not-needed-no-activation
          echo 'rollback_not_needed=no_activation_observed'
          return 0
        fi
        #@MNX-PART id=99.30.mnx-test.phase.restore-exact-prior-running-closure kind=phase title="Phase: RESTORE EXACT PRIOR RUNNING CLOSURE"
        section 'RESTORE EXACT PRIOR RUNNING CLOSURE'
        if [[ -n "$BEFORE_SYSTEM" && -x "$BEFORE_SYSTEM/bin/switch-to-configuration" ]]; then
          if "$BEFORE_SYSTEM/bin/switch-to-configuration" test; then ROLLBACK_RC=0; else ROLLBACK_RC="$?"; fi
        else
          ROLLBACK_RC=126
          echo "prior switch-to-configuration is unavailable: $BEFORE_SYSTEM" >&2
        fi
        printf 'rollback_running_system=%s\n' "$(readlink -f /run/current-system 2>/dev/null || true)"
        printf 'rollback_default_system=%s\n' "$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
        printf 'rollback_system_state=%s\n' "$(systemctl is-system-running 2>/dev/null || true)"
        systemctl --failed --no-pager --full 2>&1 || true
      }

      #@MNX-PART id=99.30.mnx-test.function.compact_diagnostics kind=function title="Function compact_diagnostics"
      compact_diagnostics() {
        #@MNX-PART id=99.30.mnx-test.phase.bounded-test-window-diagnostics kind=phase title="Phase: BOUNDED TEST-WINDOW DIAGNOSTICS"
        section 'BOUNDED TEST-WINDOW DIAGNOSTICS'
        printf 'running_system=%s\n' "$(readlink -f /run/current-system 2>/dev/null || true)"
        printf 'default_system=%s\n' "$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
        printf 'system_state=%s\n' "$(systemctl is-system-running 2>/dev/null || true)"
        printf '\nFailed units:\n'
        timeout 20s systemctl --failed --no-pager --full 2>&1 || true
        printf '\nPending jobs:\n'
        timeout 20s systemctl list-jobs --no-pager 2>&1 || true
        printf '\nRelevant processes:\n'
        pgrep -af 'nixos-rebuild|nix build|switch-to-configuration|btrbk|btrfs (send|receive|scrub)|rsync|duperemove|m21-btrfs|mnx-test' 2>&1 || true
        printf '\nWarning..alert since test start:\n'
        timeout 30s journalctl -b --since "@$START_EPOCH" -p warning..alert --no-pager -o short-iso -n 160 2>&1 || true
        printf '\nKernel warning..alert since test start:\n'
        timeout 30s journalctl -k -b --since "@$START_EPOCH" -p warning..alert --no-pager -o short-iso -n 100 2>&1 || true
      }

      #@MNX-PART id=99.30.mnx-test.function.handle_signal kind=function title="Function handle_signal"
      handle_signal() {
        local name="$1" code="$2"
        if (( SIGNAL_HANDLING != 0 )); then exit "$code"; fi
        SIGNAL_HANDLING=1
        trap - INT TERM HUP
        INTERRUPTED_SIGNAL="$name"
        INTERRUPTED_PHASE="$PHASE"
        RETRY_RECOMMENDED=yes
        #@MNX-PART id=99.30.mnx-test.phase.mnx-test-interrupted-by-name kind=phase title="Phase: MNX TEST INTERRUPTED BY $name"
        section "MNX TEST INTERRUPTED BY $name"
        printf 'interrupted_phase=%s\ninterrupted_signal=%s\n' "$PHASE" "$name"
        terminate_child_group
        AFTER_SYSTEM="$(readlink -f /run/current-system 2>/dev/null || true)"
        AFTER_DEFAULT="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
        if [[ "$CORE_VALIDATED" == yes ]]; then
          FINAL_RESULT=PASS_CORE_DIAGNOSTICS_INTERRUPTED
          ROLLBACK_RC=not-needed-core-validated
          echo 'core_validation_complete=yes'
          echo 'optional_diagnostics_cancelled=yes'
          exit 0
        fi
        FINAL_RESULT="INTERRUPTED_$(sanitize_phase "$PHASE")"
        rollback_previous
        compact_diagnostics
        exit "$code"
      }

      #@MNX-PART id=99.30.mnx-test.function.unexpected_error kind=function title="Function unexpected_error"
      unexpected_error() {
        local rc="$1" line="$2" command="$3"
        if [[ "$FINAL_RESULT" == INCOMPLETE ]]; then
          FINAL_RESULT=FAIL_HARNESS
          printf 'MNX_TEST_HARNESS_ERROR: rc=%s line=%s phase=%s command=%q\n' "$rc" "$line" "$PHASE" "$command" >&2
        fi
        return 0
      }

      trap 'unexpected_error "$?" "$LINENO" "$BASH_COMMAND"' ERR
      trap 'handle_signal INT 130' INT
      trap 'handle_signal TERM 143' TERM
      trap 'handle_signal HUP 129' HUP

      #@MNX-PART id=99.30.mnx-test.function.finish kind=function title="Function finish"
      finish() {
        local rc="$?"
        trap - EXIT ERR
        trap "" INT TERM HUP
        set +e
        TERMINAL_PHASE="$PHASE"
        stop_tail
        if [[ -n "$CHILD_PID" ]]; then terminate_child_group; fi
        PHASE=finished
        for artifact in "$REPORT" "$STATE_FILE" "$SOURCE_AUDIT_LOG" "$SOURCE_PROGRAM_COMPAT_LOG" "$SOURCE_FULL_COMPAT_LOG" "$TEMP_GATE_LOG" "$REBUILD_LOG" "$POST_AUDIT_LOG" "$SUPPORT_LOG" "$CONTRACT_LOG" "$SETTLE_LOG"; do
          [[ -e "$artifact" ]] || continue
          chown root:logbook "$artifact" 2>/dev/null || true
          chmod 0640 "$artifact" 2>/dev/null || true
        done
        if [[ "$FINAL_RESULT" == INCOMPLETE ]]; then
          FINAL_RESULT=FAIL_HARNESS
          printf 'MNX_TEST_HARNESS_ERROR: unexpected shell exit rc=%s terminal_phase=%s\n' "$rc" "$TERMINAL_PHASE" >&2
        fi
        if (( TEMPORARY_CODE_REGION_COUNT > 0 )) && [[ "$FINAL_RESULT" == PASS* && "$FINAL_RESULT" != *WITH_TEMPORARY_CODE* ]]; then
          FINAL_RESULT="''${FINAL_RESULT}_WITH_TEMPORARY_CODE"
        fi
        case "$FINAL_RESULT" in
          *WITH_TEMPORARY_CODE*) SAFE_TO_SWITCH=no-temporary-code ;;
          PASS_ALREADY_ACTIVE_DEFAULT*) SAFE_TO_SWITCH=not-needed-already-active-and-default ;;
          PASS_WITH_SUPPORT_WARNING|PASS_CORE_DIAGNOSTICS_INTERRUPTED) SAFE_TO_SWITCH=yes-core-validated ;;
          PASS*) SAFE_TO_SWITCH=yes ;;
          *) SAFE_TO_SWITCH=no ;;
        esac
        if [[ "$FINAL_RESULT" != PASS* ]] && (( rc == 0 )); then
          printf 'MNX_TEST_EXIT_CONTRACT_ERROR: non-PASS semantic result attempted a zero process exit\n' >&2
          rc=1
        fi
        if ! write_state; then
          rc=1
          printf 'MNX_TEST_STATE_PUBLICATION=FAIL\n' >&2
        fi
        if [[ "$TEST_LOCK_HELD" == 1 ]]; then
          ln -sfn "$(basename "$REPORT")" "$REPORT_DIR/mnx-test-latest.txt" 2>/dev/null || true
          [[ ! -f "$CANDIDATE_SNAPSHOT" ]] || ln -sfn "$(basename "$CANDIDATE_SNAPSHOT")" "$REPORT_DIR/mnx-test-candidate-latest.nix" 2>/dev/null || true
          if [[ -f "$RUNTIME_STATE" ]] && grep -Fxq "pid=$$" "$RUNTIME_STATE" 2>/dev/null; then rm -f "$RUNTIME_STATE"; fi
        fi
        printf '\n################################################################################\n# MNX TEST TRANSCRIPT END\n################################################################################\n'
        printf 'mnx_test_result=%s\n' "$FINAL_RESULT"
        printf 'mnx_process_exit_status=%s\n' "$rc"
        printf 'phase=%s\nterminal_phase=%s\n' "$PHASE" "$TERMINAL_PHASE"
        printf 'interrupted_signal=%s\ninterrupted_phase=%s\n' "$INTERRUPTED_SIGNAL" "$INTERRUPTED_PHASE"
        printf 'source_audit_rc=%s\nnixos_rebuild_test_rc=%s\npost_test_audit_rc=%s\n' "$SOURCE_AUDIT_RC" "$REBUILD_RC" "$POST_AUDIT_RC"
        printf 'source_bootstrap_rc=%s\nsource_program_compatibility_rc=%s\nsource_full_compatibility_rc=%s\n' "$SOURCE_BOOTSTRAP_RC" "$SOURCE_PROGRAM_COMPAT_RC" "$SOURCE_FULL_COMPAT_RC"
        printf 'source_handoff_mode=%s\ncandidate_authoritative_source_gate=activation-and-postflight\ncandidate_temporary_code_gate_rc=%s\n' "$SOURCE_HANDOFF_MODE" "$CANDIDATE_TEMP_GATE_RC"
        printf 'behavior_contract_rc=%s\nsupport_report_rc=%s\nrollback_rc=%s\n' "$CONTRACT_RC" "$SUPPORT_RC" "$ROLLBACK_RC"
        printf 'report=%s\ncandidate_snapshot=%s\ncandidate_configuration_sha256=%s\n' "$REPORT" "$CANDIDATE_SNAPSHOT" "$CANDIDATE_HASH"
        printf 'canonical_lineage_checkpoints=%s\n' "$CANONICAL_LINEAGE_CHECKPOINTS"
        printf 'source_audit_log=%s\nsource_program_compat_log=%s\nsource_full_compat_log=%s\ntemporary_code_gate_log=%s\n' "$SOURCE_AUDIT_LOG" "$SOURCE_PROGRAM_COMPAT_LOG" "$SOURCE_FULL_COMPAT_LOG" "$TEMP_GATE_LOG"
        printf 'rebuild_log=%s\npost_audit_log=%s\nsupport_log=%s\ncontract_log=%s\nstate_file=%s\n' "$REBUILD_LOG" "$POST_AUDIT_LOG" "$SUPPORT_LOG" "$CONTRACT_LOG" "$STATE_FILE"
        printf 'live_source_sha256_after=%s\nsource_mutated_during_test=%s\n' "$LIVE_SOURCE_HASH_AFTER" "$SOURCE_MUTATED"
        printf 'activated_embedded_configuration_sha256=%s\nactivated_embedded_configuration_matches_candidate=%s\n' "$ACTIVATED_EMBEDDED_HASH" "$ACTIVATED_EMBEDDED_MATCH"
        printf 'baseline_kind=%s\nbaseline_running_is_boot_default=%s\nbaseline_reconciliation=%s\n' "$BASELINE_KIND" "$BASELINE_RUNNING_IS_BOOT_DEFAULT" "$BASELINE_RECONCILIATION"
        printf 'prior_running_system=%s\nprior_boot_default_system=%s\n' "$BEFORE_SYSTEM" "$BEFORE_DEFAULT"
        printf 'temporary_running_system=%s\nunchanged_boot_default_system=%s\n' "$AFTER_SYSTEM" "$AFTER_DEFAULT"
        printf 'deferred_reason=%s\ndeferred_units=%s\n' "$DEFERRED_REASON" "$DEFERRED_UNITS"
        printf 'maintenance_waited_seconds=%s\nmaintenance_wait_units=%s\ncontention_advisory_units=%s\n' "$MAINTENANCE_WAITED_SECONDS" "$MAINTENANCE_WAIT_UNITS" "$CONTENTION_ADVISORY_UNITS"
        printf 'operator_preemption_requested=%s\noperator_preemption_result=%s\noperator_preemption_unit=%s\noperator_preemption_main_pid=%s\noperator_preemption_invocation_id=%s\noperator_preemption_success_receipt_before=%s\noperator_preemption_success_receipt_after=%s\n' "$OPERATOR_PREEMPTION_REQUESTED" "$OPERATOR_PREEMPTION_RESULT" "$OPERATOR_PREEMPTION_UNIT" "$OPERATOR_PREEMPTION_MAIN_PID" "$OPERATOR_PREEMPTION_INVOCATION_ID" "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_BEFORE" "$OPERATOR_PREEMPTION_SUCCESS_RECEIPT_AFTER"
        printf 'retry_recommended=%s\nretry_command=mnx test\n' "$RETRY_RECOMMENDED"
        printf 'temporary_code_region_count=%s\ntemporary_code_region_ids=%s\n' "$TEMPORARY_CODE_REGION_COUNT" "$TEMPORARY_CODE_REGION_IDS"
        printf 'safe_to_run_operator_normal_switch=%s\n' "$SAFE_TO_SWITCH"
        case "$SAFE_TO_SWITCH" in yes*) echo 'switch_command=mnx switch' ;; not-needed*) echo 'switch_command=not-needed' ;; no-temporary-code) echo 'switch_command=blocked-remove-or-promote-temporary-code-and-rerun-mnx-test' ;; *) echo 'switch_command=blocked' ;; esac
        printf 'boot_default_changed_by_mnx_test=%s\n' "$BOOT_DEFAULT_CHANGED"
        printf 'old_storage_direct_write_by_mnx_test=no\n'
        printf 'paste_this_entire_terminal_transcript_to_chatgpt=yes\n'
        [[ "$FINAL_RESULT" == PASS* ]] && printf 'MNX_TEST=%s\n' "$FINAL_RESULT"
        exit "$rc"
      }
      trap finish EXIT

      #@MNX-PART id=99.30.mnx-test.function.reconcile-expected-journal-review-baseline kind=function title="Function reconcile_expected_journal_review_baseline"
      reconcile_expected_journal_review_baseline() {
        local initial_state="$1" initial_failed="$2"
        local journal_unit=logbook-journal-verify.service restic_unit=m16-restic-maintenance.service backup_unit=m16-backup-m21.service
        local running_source default_source evidence_root state_root stamp staging final failed_json units_file unit safe candidate_plan required_action
        local load active sub result code status invocation accepted_source accepted_system intake_tmp manifest_sha attempt after_state after_failed backup_invocation=none
        local -a failed_names=()
        [[ "$initial_state" == degraded ]] || return 1
        mapfile -t failed_names < <(awk 'NF { print $1 }' <<< "$initial_failed")
        [[ "''${#failed_names[@]}" -ge 1 && "''${#failed_names[@]}" -le 3 ]] || return 1
        candidate_plan="$(sed -n 's/^# MNX_POST_ACCEPTANCE_PLAN=//p' "$CANDIDATE_SNAPSHOT" | tail -n 1)"
        [[ -n "$candidate_plan" ]] || {
          echo 'baseline_reconciliation_refused=candidate-post-acceptance-plan-is-absent'
          return 1
        }
        for unit in "''${failed_names[@]}"; do
          case "$unit" in
            "$journal_unit") required_action=journal-integrity-recover-forward ;;
            "$restic_unit") required_action=restic-maintenance-recover ;;
            "$backup_unit") required_action=restic-backup-reconcile ;;
            *) printf 'baseline_reconciliation_refused=unsupported-failed-unit unit=%q\n' "$unit"; return 1 ;;
          esac
          case ",$candidate_plan," in
            *,"$required_action",*) ;;
            *) printf 'baseline_reconciliation_refused=candidate-does-not-declare-required-repair unit=%q action=%q plan=%q\n' "$unit" "$required_action" "$candidate_plan"; return 1 ;;
          esac
        done
        [[ "$(printf '%s\n' "''${failed_names[@]}" | LC_ALL=C sort -u | wc -l)" -eq "''${#failed_names[@]}" ]] || {
          echo 'baseline_reconciliation_refused=duplicate-failed-unit-name'
          return 1
        }
        [[ "$BEFORE_SYSTEM" == "$BEFORE_DEFAULT" ]] || {
          echo 'baseline_reconciliation_refused=repair-candidate-requires-accepted-running-default-baseline'
          return 1
        }
        running_source="$(sha256sum /run/current-system/configuration.nix 2>/dev/null | awk '{print $1}')"
        default_source="$(sha256sum "$BEFORE_DEFAULT/configuration.nix" 2>/dev/null | awk '{print $1}')"
        [[ "$running_source" =~ ^[0-9a-f]{64}$ && "$running_source" == "$default_source" ]] || {
          echo 'baseline_reconciliation_refused=accepted-closure-source-identity-differs'
          return 1
        }
        [[ "$CANDIDATE_HASH" != "$running_source" ]] || {
          echo 'baseline_reconciliation_refused=identical-source-may-not-clear-controller-failure'
          return 1
        }

        exec 7<>/run/monsternix/mnx-degraded-reconciliation.lock
        flock -n -x 7 || {
          echo 'baseline_reconciliation_refused=another-degraded-reconciliation-is-active'
          return 1
        }
        evidence_root=/var/lib/logbook/incidents
        state_root=/var/lib/monsternix/degraded-background
        [[ -d "$evidence_root" && ! -L "$evidence_root" && "$(stat -Lc '%U:%G %a' "$evidence_root" 2>/dev/null || true)" == 'root:logbook 2750' ]] || {
          echo 'baseline_reconciliation_refused=incident-root-is-absent-or-unsafe'
          return 1
        }
        if [[ -e "$state_root" || -L "$state_root" ]]; then
          [[ -d "$state_root" && ! -L "$state_root" && "$(stat -Lc '%U:%G %a' "$state_root" 2>/dev/null || true)" == 'root:logbook 750' ]] || {
            echo 'baseline_reconciliation_refused=degraded-background-state-root-is-unsafe'
            return 1
          }
        else
          install -d -o root -g logbook -m 0750 "$state_root"
        fi

        stamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"
        final="$evidence_root/mnx-test-degraded-background-$stamp"
        staging="$evidence_root/.mnx-test-degraded-background-$stamp.staging"
        [[ ! -e "$final" && ! -L "$final" && ! -e "$staging" && ! -L "$staging" ]] || {
          echo 'baseline_reconciliation_refused=evidence-path-collision'
          return 1
        }
        install -d -o root -g logbook -m 0750 "$staging"
        units_file="$staging/units.ndjson"
        : > "$units_file"
        failed_json="$(printf '%s\n' "''${failed_names[@]}" | LC_ALL=C sort -u | jq -Rsc 'split("\n") | map(select(length>0))')"
        {
          echo 'schema=mnx.degraded-background.provenance.v2'
          printf 'recorded_at=%s\n' "$(date --iso-8601=seconds)"
          printf 'candidate_source_sha256=%s\n' "$CANDIDATE_HASH"
          printf 'accepted_source_sha256=%s\n' "$running_source"
          printf 'accepted_system=%s\n' "$BEFORE_SYSTEM"
          printf 'candidate_post_acceptance_plan=%s\n' "$candidate_plan"
          echo 'authority=candidate-owned-mnx-test-repair-baseline'
          echo 'evidence_first=yes'
          echo 'status_assumption=none'
          echo 'service_started=no'
          echo 'journal_verification_run=no'
          echo 'restic_operation_run=no'
          echo 'credential_read=no'
          echo 'repository_accessed=no'
          echo 'journal_mutated=no'
          echo 'backup_filesystems_written=no'
          echo 'profile_mutated=no'
          echo 'network_used=no'
        } > "$staging/provenance.txt"
        printf '%s\n' "$initial_failed" > "$staging/failed-units.txt"
        printf 'system_state=%s\n' "$initial_state" > "$staging/system-state.txt"
        cp -- "$CANDIDATE_SNAPSHOT" "$staging/candidate.nix"
        chmod 0640 "$staging/candidate.nix"
        for unit in "''${failed_names[@]}"; do
          safe="''${unit//[^A-Za-z0-9_.@-]/_}"
          load="$(systemctl show "$unit" --property=LoadState --value 2>/dev/null || true)"
          active="$(systemctl show "$unit" --property=ActiveState --value 2>/dev/null || true)"
          sub="$(systemctl show "$unit" --property=SubState --value 2>/dev/null || true)"
          result="$(systemctl show "$unit" --property=Result --value 2>/dev/null || true)"
          code="$(systemctl show "$unit" --property=ExecMainCode --value 2>/dev/null || true)"
          status="$(systemctl show "$unit" --property=ExecMainStatus --value 2>/dev/null || true)"
          invocation="$(systemctl show "$unit" --property=InvocationID --value 2>/dev/null || true)"
          [[ "$unit" != "$backup_unit" ]] || backup_invocation="$invocation"
          [[ "$load" == loaded && "$active" == failed && "$sub" == failed && "$code" =~ ^[0-9]+$ && "$status" =~ ^[0-9]+$ && "$invocation" =~ ^[0-9a-fA-F-]{16,64}$ ]] || {
            rm -rf -- "$staging"
            printf 'baseline_reconciliation_refused=failed-unit-state-changed unit=%q load=%q active=%q sub=%q code=%q status=%q invocation=%q\n' "$unit" "$load" "$active" "$sub" "$code" "$status" "$invocation"
            return 1
          }
          systemctl show "$unit" --no-pager > "$staging/$safe.show.txt" 2>&1 || true
          systemctl status "$unit" --no-pager -l > "$staging/$safe.status.txt" 2>&1 || true
          systemctl cat "$unit" --no-pager > "$staging/$safe.cat.txt" 2>&1 || true
          journalctl -u "$unit" -b --no-pager -o short-iso -n 500 > "$staging/$safe.default-journal.txt" 2>&1 || true
          journalctl --namespace=logbook -u "$unit" -b --no-pager -o short-iso -n 500 > "$staging/$safe.logbook-journal.txt" 2>&1 || true
          jq -cnS --arg unit "$unit" --arg load_state "$load" --arg active_state "$active" --arg sub_state "$sub" --arg result "$result" --arg invocation_id "$invocation" --argjson exec_main_code "$code" --argjson exec_main_status "$status" '{unit:$unit,load_state:$load_state,active_state:$active_state,sub_state:$sub_state,result:$result,invocation_id:$invocation_id,exec_main_code:$exec_main_code,exec_main_status:$exec_main_status}' >> "$units_file"
        done
        jq -sS . "$units_file" > "$staging/units.json"
        rm -f -- "$units_file"
        for optional in \
          /var/lib/monsternix/journal-integrity/current.json \
          /var/lib/monsternix/journal-integrity/anchor.json \
          /var/lib/monsternix/restic-maintenance/current.json \
          /var/lib/monsternix/job-state/authoritative/m16-restic-m21.current.json; do
          if [[ -f "$optional" && ! -L "$optional" ]]; then
            cp -- "$optional" "$staging/$(basename "$(dirname "$optional")")-$(basename "$optional")"
          fi
        done
        jq -cnS \
          --arg schema mnx.degraded-background.evidence.v2 \
          --arg observed_at "$(date --iso-8601=seconds)" \
          --arg candidate_source_sha256 "$CANDIDATE_HASH" \
          --arg accepted_source_sha256 "$running_source" \
          --arg accepted_system "$BEFORE_SYSTEM" \
          --arg candidate_post_acceptance_plan "$candidate_plan" \
          --argjson failed_units "$failed_json" \
          --slurpfile units "$staging/units.json" \
          '{schema:$schema,observed_at:$observed_at,candidate_source_sha256:$candidate_source_sha256,accepted_source_sha256:$accepted_source_sha256,accepted_system:$accepted_system,candidate_post_acceptance_plan:$candidate_post_acceptance_plan,system_state_before:"degraded",failed_units:$failed_units,units:$units[0],evidence_first:true,status_assumption:"none",service_started:false,journal_verification_run:false,restic_operation_run:false,credential_read:false,repository_accessed:false,journal_mutated:false,backup_filesystems_written:false,profile_mutated:false,network_used:false}' > "$staging/summary.json"
        chown -R root:logbook "$staging"
        find "$staging" -type d -exec chmod 0750 {} +
        find "$staging" -type f -exec chmod 0640 {} +
        /etc/monsternix/bin/mnx-bundle-manifest create "$staging" 2 >/dev/null || {
          rm -rf -- "$staging"
          echo 'baseline_reconciliation_refused=evidence-manifest-create-failed'
          return 1
        }
        /etc/monsternix/bin/mnx-bundle-manifest verify "$staging" >/dev/null || {
          rm -rf -- "$staging"
          echo 'baseline_reconciliation_refused=evidence-manifest-verify-failed'
          return 1
        }
        mv -T -- "$staging" "$final"
        manifest_sha="$(sha256sum "$final/SHA256SUMS" | awk '{print $1}')"
        intake_tmp="$state_root/.intake-$stamp.json.$$"
        jq -cnS \
          --arg schema mnx.degraded-background.intake.v2 \
          --arg recorded_at "$(date --iso-8601=seconds)" \
          --arg candidate_source_sha256 "$CANDIDATE_HASH" \
          --arg accepted_source_sha256 "$running_source" \
          --arg accepted_system "$BEFORE_SYSTEM" \
          --arg candidate_post_acceptance_plan "$candidate_plan" \
          --arg evidence_bundle "$final" \
          --arg evidence_manifest_sha256 "$manifest_sha" \
          --arg failed_unit_invocation_id "$backup_invocation" \
          --argjson failed_units "$failed_json" \
          '{schema:$schema,recorded_at:$recorded_at,candidate_source_sha256:$candidate_source_sha256,accepted_source_sha256:$accepted_source_sha256,accepted_system:$accepted_system,candidate_post_acceptance_plan:$candidate_post_acceptance_plan,evidence_bundle:$evidence_bundle,evidence_manifest_sha256:$evidence_manifest_sha256,failed_units:$failed_units,failed_unit_invocation_id:$failed_unit_invocation_id,system_state_before:"degraded",system_state_after:"pending",bridge_mutation:"pending-reset-failed",evidence_first:true,status_assumption:"none",service_started:false,journal_verification_run:false,restic_operation_run:false,credential_read:false,repository_accessed:false,journal_mutated:false,backup_filesystems_written:false,profile_mutated:false,network_used:false}' > "$intake_tmp"
        chown root:logbook "$intake_tmp"; chmod 0640 "$intake_tmp"
        mv -f -- "$intake_tmp" "$state_root/intake-$stamp.json"

        systemctl reset-failed "''${failed_names[@]}"
        for attempt in $(seq 1 40); do
          after_state="$(systemctl is-system-running 2>/dev/null || true)"
          after_failed="$(systemctl --failed --no-legend --plain 2>/dev/null | grep -Ev '^[[:space:]]*$|^[0-9]+ loaded units listed[.]$' || true)"
          [[ "$after_state" == running && -z "$after_failed" ]] && break
          sleep 0.25
        done
        [[ "$after_state" == running && -z "$after_failed" ]] || {
          printf 'baseline_reconciliation_error=reset-failed-postcondition state=%q failed=%q evidence=%q\n' "$after_state" "$after_failed" "$final" >&2
          return 1
        }
        intake_tmp="$state_root/.intake-$stamp.json.$$"
        jq -S --arg completed_at "$(date --iso-8601=seconds)" '.completed_at=$completed_at | .system_state_after="running" | .bridge_mutation="systemd-failure-bookkeeping-only"' "$state_root/intake-$stamp.json" > "$intake_tmp"
        chown root:logbook "$intake_tmp"; chmod 0640 "$intake_tmp"
        mv -f -- "$intake_tmp" "$state_root/intake-$stamp.json"
        BASELINE_RECONCILIATION=background-failure-evidence-first-reset-failed
        printf 'baseline_reconciliation=%s\n' "$BASELINE_RECONCILIATION"
        printf 'baseline_reconciliation_evidence=%s\n' "$final"
        printf 'baseline_reconciliation_intake=%s\n' "$state_root/intake-$stamp.json"
        printf 'baseline_reconciliation_candidate_post_acceptance_plan=%s\n' "$candidate_plan"
        echo 'baseline_reconciliation_status_assumption=none'
        echo 'baseline_reconciliation_service_started=no'
        echo 'baseline_reconciliation_journal_verification_run=no'
        echo 'baseline_reconciliation_restic_operation_run=no'
        echo 'baseline_reconciliation_journal_mutated=no'
        echo 'baseline_reconciliation_backup_filesystems_written=no'
        echo 'baseline_reconciliation_profile_mutated=no'
        echo 'MNX_TEST_BACKGROUND_FAILURE_BASELINE_RECONCILIATION=PASS'
        return 0
      }

      #@MNX-PART id=99.30.mnx-test.function.bootstrap_temporary_code_gate kind=function title="Function bootstrap_temporary_code_gate"
      bootstrap_temporary_code_gate() {
        local source="$1" output="$2"
        local section_start section_end line_number line open_id="" id expires today
        local count=0 ids=()
        section_start="$(grep -nF '#@MNX-CHUNK id=98.00 ' "$source" | head -n 1 | cut -d: -f1 || true)"
        section_end="$(awk -v start="''${section_start:-0}" 'NR > start && /^#@MNX-CHUNK / { print NR; exit }' "$source" 2>/dev/null || true)"
        : > "$output"
        {
          printf 'temporary_code_bootstrap_policy=exact-marker-pairs-section-98-expiry-and-metadata\n'
          [[ "$section_start" =~ ^[0-9]+$ && "$section_end" =~ ^[0-9]+$ && "$section_end" -gt "$section_start" ]] || {
            echo 'TEMP_GATE_ERROR: Section 98 chunk boundaries are missing or malformed' >&2
            return 1
          }
          today="$(date +%F)"
          while IFS=: read -r line_number line; do
            [[ "$line_number" =~ ^[0-9]+$ ]] || continue
            (( line_number > section_start && line_number < section_end )) || {
              echo "TEMP_GATE_ERROR: active TEMP marker lies outside Section 98 at line $line_number" >&2
              return 1
            }
            case "$line" in
              '#@MNX-TEMP-BEGIN '*)
                [[ -z "$open_id" ]] || { echo "TEMP_GATE_ERROR: nested TEMP region at line $line_number" >&2; return 1; }
                id="$(sed -nE 's/^#@MNX-TEMP-BEGIN id=([^ ]+) .*/\1/p' <<<"$line")"
                expires="$(sed -nE 's/^.* expires=([0-9]{4}-[0-9]{2}-[0-9]{2})( |$).*$/\1/p' <<<"$line")"
                [[ -n "$id" && "$id" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || { echo "TEMP_GATE_ERROR: invalid TEMP id at line $line_number" >&2; return 1; }
                grep -Eq ' purpose="[^"]+"' <<<"$line" || { echo "TEMP_GATE_ERROR: TEMP purpose is missing at line $line_number" >&2; return 1; }
                grep -Eq ' cleanup="[^"]+"' <<<"$line" || { echo "TEMP_GATE_ERROR: TEMP cleanup is missing at line $line_number" >&2; return 1; }
                grep -Eq ' owner=[^ ]+' <<<"$line" || { echo "TEMP_GATE_ERROR: TEMP owner is missing at line $line_number" >&2; return 1; }
                [[ -n "$expires" ]] || { echo "TEMP_GATE_ERROR: TEMP expiry is missing at line $line_number" >&2; return 1; }
                date -d "$expires" +%F >/dev/null 2>&1 || { echo "TEMP_GATE_ERROR: TEMP expiry is invalid at line $line_number" >&2; return 1; }
                [[ "$expires" > "$today" || "$expires" == "$today" ]] || { echo "TEMP_GATE_ERROR: TEMP region $id expired on $expires" >&2; return 1; }
                printf '%s\n' "''${ids[@]:-}" | grep -Fxq "$id" && { echo "TEMP_GATE_ERROR: duplicate TEMP id $id" >&2; return 1; }
                open_id="$id"
                ids+=( "$id" )
                count=$((count + 1))
                ;;
              '#@MNX-TEMP-END '*)
                id="$(sed -nE 's/^#@MNX-TEMP-END id=([^ ]+)$/\1/p' <<<"$line")"
                [[ -n "$open_id" ]] || { echo "TEMP_GATE_ERROR: orphan TEMP end at line $line_number" >&2; return 1; }
                [[ "$id" == "$open_id" ]] || { echo "TEMP_GATE_ERROR: TEMP end id $id does not match $open_id at line $line_number" >&2; return 1; }
                open_id=""
                ;;
            esac
          done < <(grep -nE '^#@MNX-TEMP-(BEGIN|END) ' "$source" || true)
          [[ -z "$open_id" ]] || { echo "TEMP_GATE_ERROR: TEMP region $open_id is unterminated" >&2; return 1; }
          printf 'temporary_code_region_count=%s\n' "$count"
          if (( count == 0 )); then
            echo 'temporary_code_region_ids=none'
          else
            printf 'temporary_code_region_ids=%s\n' "$(IFS=,; echo "''${ids[*]}")"
          fi
          echo 'MNX_TEMPORARY_CODE_BOOTSTRAP_GATE=PASS'
        } >> "$output" 2>&1
      }

      #@MNX-PART id=99.30.mnx-test.function.run_source_handoff_audit kind=function title="Function run_source_handoff_audit"
      run_source_handoff_audit() {
        local source="$1" payload_tmp
        local bootstrap_rc=0
        : > "$SOURCE_AUDIT_LOG"
        : > "$SOURCE_PROGRAM_COMPAT_LOG"
        : > "$SOURCE_FULL_COMPAT_LOG"
        {
          echo '################################################################################'
          echo '# MNX CANDIDATE SOURCE HANDOFF'
          echo '################################################################################'
          printf 'source_handoff_policy=generic-bootstrap-active-compatibility-advisory-candidate-activation-authoritative\n'
          printf 'source_handoff_live_probe=timer-only-json-organizer-removes-stage19-required-path-landmark\n'
          if nix-instantiate --parse "$source" >/dev/null; then
            echo 'bootstrap_nix_parse=PASS'
          else
            echo 'bootstrap_nix_parse=FAIL' >&2
            bootstrap_rc=1
          fi
          payload_tmp="$(mktemp)"
          sed -n '/^#@MNX-BASH-BEGIN$/,/^#@MNX-BASH-END$/p' "$source" | sed -e '1d' -e '$d' -e 's/^#@MNX-BASH //' > "$payload_tmp"
          if [[ -s "$payload_tmp" ]] && bash -n "$payload_tmp" && grep -Fq 'MNX_CONFIGURATION_AS_BASH_PAYLOAD=1' "$payload_tmp"; then
            echo 'bootstrap_embedded_bash_payload=PASS'
          else
            echo 'bootstrap_embedded_bash_payload=FAIL' >&2
            bootstrap_rc=1
          fi
          rm -f "$payload_tmp"

        } >> "$SOURCE_AUDIT_LOG" 2>&1
        run_logged_child source-program-compat "$SOURCE_PROGRAM_COMPAT_LOG" timeout 180s /etc/monsternix/bin/mnx-source-program-audit source "$source"
        SOURCE_PROGRAM_COMPAT_RC="$LAST_CHILD_RC"
        run_logged_child source-full-compat "$SOURCE_FULL_COMPAT_LOG" timeout 300s env MNX_CONFIG="$source" /etc/monsternix/bin/mnx-config-audit source
        SOURCE_FULL_COMPAT_RC="$LAST_CHILD_RC"
        set_phase source-handoff
        {
          printf 'source_program_compatibility_rc=%s\n' "$SOURCE_PROGRAM_COMPAT_RC"
          printf 'source_program_compat_log=%s\n' "$SOURCE_PROGRAM_COMPAT_LOG"
          printf 'source_full_compatibility_rc=%s\n' "$SOURCE_FULL_COMPAT_RC"
          printf 'source_full_compat_log=%s\n' "$SOURCE_FULL_COMPAT_LOG"
          if (( SOURCE_PROGRAM_COMPAT_RC == 0 && SOURCE_FULL_COMPAT_RC == 0 )); then
            SOURCE_HANDOFF_MODE=active-generation-compatible
          else
            SOURCE_HANDOFF_MODE=candidate-authoritative-deferred
            echo 'active_generation_compatibility=advisory-rejection-retained-for-review'
            echo 'candidate_authoritative_source_gate=activation-and-postflight'
          fi
          printf 'source_handoff_mode=%s\n' "$SOURCE_HANDOFF_MODE"
          if (( bootstrap_rc == 0 )); then
            echo 'MNX_SOURCE_HANDOFF=PASS'
          else
            echo 'MNX_SOURCE_HANDOFF=FAIL' >&2
          fi
        } >> "$SOURCE_AUDIT_LOG" 2>&1
        SOURCE_BOOTSTRAP_RC="$bootstrap_rc"
        (( bootstrap_rc == 0 ))
      }

      #@MNX-PART id=99.30.mnx-test.function.candidate_temporary_code_gate kind=function title="Function candidate_temporary_code_gate"
      candidate_temporary_code_gate() {
        local output="$TEMP_GATE_LOG" rc count ids
        if /etc/monsternix/bin/mnx-atlas --config "$CANDIDATE_SNAPSHOT" temp-gate test > "$output" 2>&1; then
          rc=0
        else
          rc=$?
        fi
        CANDIDATE_TEMP_GATE_RC="$rc"
        cat "$output" || true
        (( rc == 0 )) || return 1
        count="$(sed -n 's/^temporary_code_region_count=//p' "$output" | tail -n 1)"
        ids="$(sed -n 's/^temporary_code_region_ids=//p' "$output" | tail -n 1)"
        [[ "$count" =~ ^[0-9]+$ ]] || return 1
        [[ -n "$ids" ]] || ids=none
        [[ "$count" == "$TEMPORARY_CODE_REGION_COUNT" ]] || {
          printf 'candidate TEMP count differs from bootstrap count: bootstrap=%s candidate=%s\n' "$TEMPORARY_CODE_REGION_COUNT" "$count" >&2
          return 1
        }
        [[ "$ids" == "$TEMPORARY_CODE_REGION_IDS" ]] || {
          printf 'candidate TEMP IDs differ from bootstrap IDs: bootstrap=%s candidate=%s\n' "$TEMPORARY_CODE_REGION_IDS" "$ids" >&2
          return 1
        }
        echo 'candidate_temporary_code_gate=PASS'
      }

      #@MNX-PART id=99.30.mnx-test.function.run_logged_child kind=function title="Function run_logged_child"
      run_logged_child() {
        local phase_name="$1" logfile="$2"
        shift 2
        local rc start now bytes lastline
        set_phase "$phase_name"
        : > "$logfile"
        start="$(date +%s)"
        setsid --wait "$@" </dev/null > "$logfile" 2>&1 &
        CHILD_PID="$!"
        CHILD_PGID="$CHILD_PID"
        write_state
        if (( VERBOSE == 1 )); then
          tail -n +1 -F --pid="$CHILD_PID" "$logfile" &
          TAIL_PID="$!"
        fi
        while kill -0 "$CHILD_PID" 2>/dev/null; do
          for _ in $(seq 1 20); do
            sleep 1
            kill -0 "$CHILD_PID" 2>/dev/null || break
          done
          kill -0 "$CHILD_PID" 2>/dev/null || break
          if (( VERBOSE == 0 )); then
            now="$(date +%s)"
            bytes="$(stat -c '%s' "$logfile" 2>/dev/null || echo 0)"
            lastline="$(tail -n 1 "$logfile" 2>/dev/null | tr '\t' ' ' | cut -c1-240 || true)"
            printf '%s phase=%s elapsed=%ss log_bytes=%s last=%s\n' "$(date -Is)" "$phase_name" "$((now-start))" "$bytes" "''${lastline:-<no-output-yet>}"
          fi
        done
        trap - ERR
        if wait "$CHILD_PID"; then rc=0; else rc="$?"; fi
        trap 'unexpected_error "$?" "$LINENO" "$BASH_COMMAND"' ERR
        stop_tail
        CHILD_PID=
        CHILD_PGID=
        LAST_CHILD_RC="$rc"
        write_state
        return 0
      }

      #@MNX-PART id=99.30.mnx-test.function.print_log_summary kind=function title="Function print_log_summary"
      print_log_summary() {
        local label="$1" logfile="$2" rc="$3" summary
        printf '%s_rc=%s\n' "$label" "$rc"
        printf '%s_log=%s\n' "$label" "$logfile"
        printf '%s_log_lines=%s\n' "$label" "$(wc -l 2>/dev/null < "$logfile" || echo unknown)"
        printf '%s_log_bytes=%s\n' "$label" "$(stat -c '%s' "$logfile" 2>/dev/null || echo unknown)"
        printf '%s_log_summary_schema=mnx.log-summary.v1\n' "$label"
        printf '%s_log_summary_authority=diagnostic-only-process-exit-status-remains-authoritative\n' "$label"
        # Stream the log without retaining payload text. Lexical hints are not failed checks.
        # Only the last explicit AUDIT RESULT section supplies reported aggregate totals.
        if summary="$(awk -v prefix="$label" '
          {
            lower = tolower($0)
            if (lower ~ /(^|[[:space:]])(warning:|evaluation warning|deprecated([[:space:]:]|$))/) warnings++
            if (lower ~ /(^|[[:space:]])(error:|fail:|fatal:|failed([[:space:]:]|$)|assertion[[:space:]].*failed|[[:alpha:]_][[:alnum:]_]*(error|exception)([[:space:]:]|$))/ ||
                $0 ~ /^[A-Z][A-Z0-9_]*=(FAIL|FAIL_[A-Z0-9_]+)([[:space:]:]|$)/) errors++
            if ($0 ~ /^# AUDIT RESULT[[:space:]]*$/) {
              section_seen = 1; nf = 0; nw = 0; nr = 0; invalid = 0
              failures = ""; audit_warnings = ""; result = ""
              next
            }
            if (!section_seen) next
            if ($0 ~ /^failures=/) {
              nf++; if (nr || ($0 !~ /^failures=(0|[1-9][0-9]*)$/ || length($0) > 18)) invalid = 1
              failures = substr($0, 10)
            }
            if ($0 ~ /^warnings=/) {
              nw++; if (nr || ($0 !~ /^warnings=(0|[1-9][0-9]*)$/ || length($0) > 18)) invalid = 1
              audit_warnings = substr($0, 10)
            }
            if ($0 ~ /^MNX_CONFIG_AUDIT=/) {
              nr++; if (nf != 1 || nw != 1) invalid = 1
              result = substr($0, 18)
              if (result !~ /^(PASS|PASS_WITH_WARNINGS|FAIL)$/) invalid = 1
            }
          }
          END {
            state = "absent"
            if (section_seen) {
              state = "incomplete"
              if (invalid || nf > 1 || nw > 1 || nr > 1) state = "invalid"
              else if (nf == 1 && nw == 1 && nr == 1) {
                state = "complete"
                if ((result == "PASS" && (failures != 0 || audit_warnings != 0)) ||
                    (result == "PASS_WITH_WARNINGS" && (failures != 0 || audit_warnings == 0)) ||
                    (result == "FAIL" && failures == 0)) state = "invalid"
              }
            }
            printf "%s_diagnostic_scan=complete\n", prefix
            printf "%s_warning_hint_lines=%d\n", prefix, warnings + 0
            printf "%s_error_hint_lines=%d\n", prefix, errors + 0
            printf "%s_reported_audit_summary=%s\n", prefix, state
            printf "%s_reported_audit_failures=%s\n", prefix, state == "complete" ? failures : "unknown"
            printf "%s_reported_audit_warnings=%s\n", prefix, state == "complete" ? audit_warnings : "unknown"
            printf "%s_reported_audit_result=%s\n", prefix, state == "complete" ? result : "unknown"
          }
        ' "$logfile" 2>/dev/null)"; then
          printf '%s\n' "$summary"
        else
          printf '%s_diagnostic_scan=unreadable\n' "$label"
          printf '%s_warning_hint_lines=unknown\n%s_error_hint_lines=unknown\n' "$label" "$label"
          printf '%s_reported_audit_summary=unreadable\n' "$label"
          printf '%s_reported_audit_failures=unknown\n%s_reported_audit_warnings=unknown\n%s_reported_audit_result=unknown\n' "$label" "$label" "$label"
        fi
      }

      #@MNX-PART id=99.30.mnx-test.function.print_failure_excerpt kind=function title="Function print_failure_excerpt"
      print_failure_excerpt() {
        local logfile="$1"
        printf '\n--- error contexts from %s ---\n' "$logfile"
        grep -n -C 4 -E -i '(^|[[:space:]])error:|trace:|(^|[[:space:]])failed([[:space:]:]|$)|assertion|undefined variable|option .* does not exist|No space left|Read-only file system|Permission denied|collision|timed out' "$logfile" 2>/dev/null | head -n 360 || true
        printf '\n--- final 180 lines from %s ---\n' "$logfile"
        tail -n 180 "$logfile" 2>/dev/null || true
      }

      #@MNX-PART id=99.30.mnx-test.function.print_success_excerpt kind=function title="Function print_success_excerpt"
      print_success_excerpt() {
        local logfile="$1"
        grep -E '^(evaluation warning:|warning:|these [0-9]+ derivations will be built:|building .*/nixos-system-|activating the configuration|Done\. The new configuration is )' "$logfile" 2>/dev/null | tail -n 100 || true
      }

      #@MNX-PART id=99.30.mnx-test.function.run_support_if_policy_allows kind=function title="Function run_support_if_policy_allows"
      run_support_if_policy_allows() {
        local outcome="$1"
        if [[ "$SUPPORT_POLICY" == never || ( "$SUPPORT_POLICY" == failure && "$outcome" == success ) ]]; then
          SUPPORT_RC="skipped-policy-$SUPPORT_POLICY"
          return 0
        fi
        if [[ ! -x /etc/monsternix/bin/mnx-support-report ]]; then
          SUPPORT_RC=127
          echo 'mnx-support-report is absent' >&2
          return 0
        fi
        run_logged_child support "$SUPPORT_LOG" env SINCE="@$START_EPOCH" MAX_JOURNAL=180 /etc/monsternix/bin/mnx-support-report
        SUPPORT_RC="$LAST_CHILD_RC"
        print_log_summary support "$SUPPORT_LOG" "$SUPPORT_RC"
        if (( VERBOSE == 0 )); then
          printf '\n--- selected support findings ---\n'
          grep -E '^(saved_report=|MNX_SUPPORT_REPORT_COMPLETE=|old_storage_written=|system_state=|configuration_sha256=|selected_reachable_endpoint=|freshness_|monsternix_.*(problem|warning)|[[:space:]]*[0-9]+ loaded units listed\.|WARN:|CRIT:|ERROR:)' "$SUPPORT_LOG" 2>/dev/null | tail -n 240 || true
        fi
      }

      #@MNX-PART id=99.30.mnx-test.function.require_free_bytes kind=function title="Function require_free_bytes"
      require_free_bytes() {
        local path="$1" minimum="$2" label="$3" available
        available="$(df -B1 --output=avail "$path" 2>/dev/null | tail -n 1 | tr -d ' ')"
        [[ "$available" =~ ^[0-9]+$ ]] || fatal FAIL_PREFLIGHT "could not determine free bytes for $path"
        printf 'free_bytes[%s]=%s minimum=%s\n' "$label" "$available" "$minimum"
        (( available >= minimum )) || fatal FAIL_NO_SPACE "$label has only $available free bytes; requires at least $minimum"
      }

      #@MNX-PART id=99.30.mnx-test.function.verify_document_sentinel kind=function title="Function verify_document_sentinel"
      verify_document_sentinel() {
        local input="$1" declaration_count valid_count sentinel_count schema final_nonblank expected
        declaration_count="$(grep -Ec '^# MNX_DOCUMENT_SCHEMA=' "$input" 2>/dev/null || true)"
        valid_count="$(grep -Ec '^# MNX_DOCUMENT_SCHEMA=[1-9][0-9]*$' "$input" 2>/dev/null || true)"
        [[ "$declaration_count" == 1 && "$valid_count" == 1 ]] || fatal FAIL_SOURCE_SCHEMA "configuration must contain exactly one valid MNX_DOCUMENT_SCHEMA declaration; declarations=$declaration_count valid=$valid_count"
        schema="$(sed -n -E 's/^# MNX_DOCUMENT_SCHEMA=([1-9][0-9]*)$/\1/p' "$input")"
        expected="# MNX-END-OF-MONOLITH schema=$schema copy-paste-sentinel=present"
        sentinel_count="$(grep -Fxc "$expected" "$input" 2>/dev/null || true)"
        [[ "$sentinel_count" == 1 ]] || fatal FAIL_SOURCE_TRUNCATED "configuration must contain exactly one sentinel for schema $schema; found $sentinel_count"
        final_nonblank="$(awk 'NF { last=$0 } END { print last }' "$input")"
        [[ "$final_nonblank" == "$expected" ]] || fatal FAIL_SOURCE_TRUNCATED "end-of-monolith sentinel does not match declared document schema $schema"
        printf 'candidate_document_schema=%s\n' "$schema"
      }


      #@MNX-PART id=99.30.mnx-test.function.candidate-lineage-checkpoint kind=function title="Function candidate_lineage_checkpoint"
      candidate_lineage_checkpoint() {
        local checkpoint="$1" candidate="$2" expected_sha="$3" expected_default="$4"
        local output rc state observed_sha observed_default lineage_bin lineage_resolved
        case "$checkpoint" in pre-parse|test-lock) ;; *) fatal FAIL_CANDIDATE_LINEAGE "unsupported candidate-lineage checkpoint: $checkpoint" ;; esac
        [[ -n "$expected_default" && "$expected_default" == /nix/store/* ]] || fatal FAIL_CANDIDATE_LINEAGE 'accepted boot-default closure is unresolved before lineage verification'
        lineage_bin="$expected_default/etc/monsternix/bin/mnx-lineage"
        [[ -x "$lineage_bin" ]] || fatal FAIL_CANDIDATE_LINEAGE 'accepted boot-default closure has no executable mnx-lineage verifier'
        lineage_resolved="$(readlink -f -- "$lineage_bin" 2>/dev/null || true)"
        [[ -n "$lineage_resolved" && "$lineage_resolved" == /nix/store/* && -x "$lineage_resolved" ]] || fatal FAIL_CANDIDATE_LINEAGE 'accepted mnx-lineage verifier does not resolve to an executable Nix-store object'
        set +e
        output="$("$lineage_resolved" check "$candidate" "$expected_sha" --expected-accepted-default "$expected_default" 2>&1)"
        rc=$?
        set -e
        printf '%s\n' "$output"
        (( rc == 0 )) || fatal FAIL_CANDIDATE_LINEAGE "accepted-closure candidate-lineage verifier refused checkpoint $checkpoint"
        state="$(printf '%s\n' "$output" | sed -n 's/^candidate_lineage_state=//p' | tail -n 1)"
        observed_sha="$(printf '%s\n' "$output" | sed -n 's/^candidate_source_sha256=//p' | tail -n 1)"
        observed_default="$(printf '%s\n' "$output" | sed -n 's/^accepted_office_default_system=//p' | tail -n 1)"
        case "$state" in accepted-exact|direct-successor) ;; *) fatal FAIL_CANDIDATE_LINEAGE "unsupported passing lineage state: $state" ;; esac
        [[ "$observed_sha" == "$expected_sha" ]] || fatal FAIL_CANDIDATE_LINEAGE 'candidate-lineage verifier returned a different candidate SHA-256'
        [[ "$observed_default" == "$expected_default" ]] || fatal FAIL_CANDIDATE_LINEAGE 'candidate-lineage verifier returned a different accepted boot-default closure'
        printf '%s\n' "$output" | grep -Fxq 'candidate_lineage_writes_performed=false' || fatal FAIL_CANDIDATE_LINEAGE 'candidate-lineage verifier did not prove read-only behavior'
        printf '%s\n' "$output" | grep -Fxq 'candidate_lineage_mutation_authority=none' || fatal FAIL_CANDIDATE_LINEAGE 'candidate-lineage verifier claimed mutation authority'
        printf '%s\n' "$output" | grep -Fxq 'MNX_CANDIDATE_LINEAGE=PASS' || fatal FAIL_CANDIDATE_LINEAGE 'candidate-lineage verifier omitted its PASS record'
        if [[ "$CANONICAL_LINEAGE_CHECKPOINTS" == none ]]; then
          CANONICAL_LINEAGE_CHECKPOINTS="$checkpoint"
        else
          CANONICAL_LINEAGE_CHECKPOINTS+=",$checkpoint"
        fi
        printf 'candidate_lineage_checkpoint=%s\ncandidate_lineage_engine=accepted-default-closure-mnx-lineage\ncandidate_lineage_verifier=%s\ncandidate_lineage_authoritative_writes=false\ncandidate_lineage_mutation_authority=none\nMNX_CANONICAL_LINEAGE_CHECKPOINT=PASS\n' "$checkpoint" "$lineage_resolved"
      }

      #@MNX-PART id=99.30.mnx-test.phase.mnx-test-compact-success-verbose-failure kind=phase title="Phase: MNX TEST — COMPACT SUCCESS / VERBOSE FAILURE"
      section 'MNX TEST — COMPACT SUCCESS / VERBOSE FAILURE'
      date -Is
      printf 'implementation_version=%s\nconfiguration=%s\nreport=%s\n' "$MNX_TEST_IMPLEMENTATION_VERSION" "$CFG" "$REPORT"
      printf 'source_integrity_owner=monsternix\noperator_checksum_step=not-required\n'
      printf 'support_policy=%s\nverbose=%s\nrollback_on_failure=%s\n' "$SUPPORT_POLICY" "$VERBOSE" "$ROLLBACK_ON_FAILURE"
      printf 'signal_policy=terminate-child-group;conditional-rollback;never-auto-support-on-interrupt\n'
      printf 'candidate_freeze_policy=exact-root-owned-copy-before-evaluation\n'
      printf 'identical_candidate_policy=source-and-runtime-audit-without-rebuild\n'
      printf 'behavior_contract_policy=pinned-baseline-enforced-unless-explicitly-allowed\n'
      printf 'maintenance_wait_policy=operator-lock-first-rsync-only-preemptible-root-scrub-exclusive-background-lock-users-nonblocking\n'
      printf 'maintenance_wait_limit_seconds=%s\n' "$MAINTENANCE_WAIT_SECONDS"
      printf 'fstrim_arbitration=contention-only-nonblocking\nnew_storage_scrub_arbitration=throttled-contention-only-no-operator-deferral\nbackground_storage_lock_policy=single-nonblocking-attempt-freshness-retry\noperator_preemption_policy=rsync-m16-new-to-old-only-manager-stop-retryable\n'

      set_phase source-freeze
      [[ -r "$CFG" ]] || fatal FAIL_SOURCE "configuration is unreadable: $CFG"
      [[ -f "$CFG" && ! -L "$CFG" ]] || fatal FAIL_SOURCE 'configuration must be a regular non-symlink file'
      MODE="$(stat -c '%a' "$CFG")"
      OWNER="$(stat -c '%U:%G' "$CFG")"
      printf 'configuration_owner=%s\nconfiguration_mode=%s\n' "$OWNER" "$MODE"
      MODE_DECIMAL=$((8#$MODE))
      (( (MODE_DECIMAL & 0022) == 0 )) || fatal FAIL_SOURCE_PERMISSIONS 'configuration is group- or world-writable'
      head -n 1 "$CFG" | grep -Eq '^#!/usr/bin/env .*bash' || fatal FAIL_SOURCE 'polyglot Bash shebang is missing'
      verify_document_sentinel "$CFG"
      ORIGINAL_HASH="$(sha256sum "$CFG" | awk '{print $1}')"
      CANDIDATE_TMP="$CANDIDATE_SNAPSHOT.$$"
      install -m 0640 -o root -g logbook "$CFG" "$CANDIDATE_TMP"
      mv -f "$CANDIDATE_TMP" "$CANDIDATE_SNAPSHOT"
      CANDIDATE_HASH="$(sha256sum "$CANDIDATE_SNAPSHOT" | awk '{print $1}')"
      [[ "$CANDIDATE_HASH" == "$ORIGINAL_HASH" ]] || fatal FAIL_CANDIDATE_FREEZE 'frozen candidate hash differs from source at capture time'
      printf 'candidate_snapshot=%s\ncandidate_configuration_sha256=%s\n' "$CANDIDATE_SNAPSHOT" "$CANDIDATE_HASH"
      printf 'configuration_lines=%s\nconfiguration_bytes=%s\n' "$(wc -l < "$CANDIDATE_SNAPSHOT")" "$(stat -c '%s' "$CANDIDATE_SNAPSHOT")"
      LINEAGE_DEFAULT_BEFORE="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
      candidate_lineage_checkpoint pre-parse "$CANDIDATE_SNAPSHOT" "$CANDIDATE_HASH" "$LINEAGE_DEFAULT_BEFORE"
      if bootstrap_temporary_code_gate "$CANDIDATE_SNAPSHOT" "$TEMP_GATE_LOG"; then
        CANDIDATE_TEMP_GATE_RC=bootstrap-only
      else
        cat "$TEMP_GATE_LOG" >&2 || true
        fatal FAIL_TEMPORARY_CODE_POLICY 'forward-stable temporary-code bootstrap gate rejected the candidate'
      fi
      cat "$TEMP_GATE_LOG"
      TEMPORARY_CODE_REGION_COUNT="$(sed -n 's/^temporary_code_region_count=//p' "$TEMP_GATE_LOG" | tail -n 1)"
      TEMPORARY_CODE_REGION_IDS="$(sed -n 's/^temporary_code_region_ids=//p' "$TEMP_GATE_LOG" | tail -n 1)"
      [[ "$TEMPORARY_CODE_REGION_COUNT" =~ ^[0-9]+$ ]] || fatal FAIL_TEMPORARY_CODE_POLICY 'bootstrap TEMP gate did not emit a numeric temporary-code count'
      [[ -n "$TEMPORARY_CODE_REGION_IDS" ]] || TEMPORARY_CODE_REGION_IDS=none
      printf 'temporary_code_region_count=%s\ntemporary_code_region_ids=%s\n' "$TEMPORARY_CODE_REGION_COUNT" "$TEMPORARY_CODE_REGION_IDS"
      if (( TEMPORARY_CODE_REGION_COUNT > 0 )); then
        echo 'temporary_code_policy=test-allowed-switch-blocked'
      fi

      BEFORE_SYSTEM="$(readlink -f /run/current-system 2>/dev/null || true)"
      BEFORE_DEFAULT="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
      [[ "$BEFORE_DEFAULT" == "$LINEAGE_DEFAULT_BEFORE" ]] || fatal FAIL_CANDIDATE_LINEAGE 'boot-default closure changed after the pre-parse lineage checkpoint'
      BASELINE_STATE_INITIAL="$(systemctl is-system-running 2>/dev/null || true)"
      BASELINE_FAILED_INITIAL="$(systemctl --failed --no-legend --plain 2>/dev/null | grep -Ev '^[[:space:]]*$|^[0-9]+ loaded units listed[.]$' || true)"
      printf 'before_running_system=%s\nbefore_default_system=%s\n' "$BEFORE_SYSTEM" "$BEFORE_DEFAULT"
      printf 'baseline_initial_system_state=%s\nbaseline_initial_failed_units=%s\n' "$BASELINE_STATE_INITIAL" "''${BASELINE_FAILED_INITIAL:-none}"
      [[ -n "$BEFORE_SYSTEM" ]] || fatal FAIL_BASELINE 'running system closure is unresolved'
      [[ -x "$BEFORE_SYSTEM/bin/switch-to-configuration" ]] || fatal FAIL_BASELINE "prior running closure cannot be restored: $BEFORE_SYSTEM"
      if [[ "$ALLOW_DIRTY_BASELINE" != 1 ]]; then
        reconcile_expected_journal_review_baseline "$BASELINE_STATE_INITIAL" "$BASELINE_FAILED_INITIAL" || true
      fi
      BASELINE_STATE="$(systemctl is-system-running 2>/dev/null || true)"
      BASELINE_FAILED="$(systemctl --failed --no-legend --plain 2>/dev/null | grep -Ev '^[[:space:]]*$|^[0-9]+ loaded units listed[.]$' || true)"
      printf 'before_system_state=%s\nbefore_failed_units=%s\n' "$BASELINE_STATE" "''${BASELINE_FAILED:-none}"
      if [[ "$BEFORE_SYSTEM" == "$BEFORE_DEFAULT" ]]; then BASELINE_KIND=boot-default; BASELINE_RUNNING_IS_BOOT_DEFAULT=yes; else BASELINE_KIND=temporary; BASELINE_RUNNING_IS_BOOT_DEFAULT=no; fi
      printf 'baseline_kind=%s\nbaseline_running_is_boot_default=%s\nbaseline_reconciliation=%s\n' "$BASELINE_KIND" "$BASELINE_RUNNING_IS_BOOT_DEFAULT" "$BASELINE_RECONCILIATION"
      if [[ "$ALLOW_DIRTY_BASELINE" != 1 ]]; then
        [[ "$BASELINE_STATE" == running ]] || fatal FAIL_BASELINE "baseline system state is $BASELINE_STATE rather than running"
        [[ -z "$BASELINE_FAILED" ]] || fatal FAIL_BASELINE 'baseline already has failed units; use --allow-dirty-baseline only when deliberate'
      fi

      exec 8<>"$RUNTIME_DIR/mnx-test.lock"
      flock -n -x 8 || defer_test DEFERRED_TEST_BUSY another-mnx-test
      TEST_LOCK_HELD=1
      write_state
      LINEAGE_DEFAULT_LOCKED="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
      [[ "$LINEAGE_DEFAULT_LOCKED" == "$LINEAGE_DEFAULT_BEFORE" ]] || fatal FAIL_CANDIDATE_LINEAGE 'boot-default closure changed before the test-lock lineage checkpoint'
      candidate_lineage_checkpoint test-lock "$CANDIDATE_SNAPSHOT" "$CANDIDATE_HASH" "$LINEAGE_DEFAULT_LOCKED"

      #@MNX-PART id=99.30.mnx-test.phase.source-audit-raw-output-saved-full-outp-d0e2a8c2 kind=phase title="Phase: CANDIDATE SOURCE HANDOFF — BOOTSTRAP GATE PLUS COMPATIBILITY EVIDENCE"
      section 'CANDIDATE SOURCE HANDOFF — BOOTSTRAP GATE PLUS COMPATIBILITY EVIDENCE'
      set_phase source-handoff
      if run_source_handoff_audit "$CANDIDATE_SNAPSHOT"; then
        SOURCE_AUDIT_RC=0
      else
        SOURCE_AUDIT_RC=1
      fi
      print_log_summary source_audit "$SOURCE_AUDIT_LOG" "$SOURCE_AUDIT_RC"
      cat "$SOURCE_AUDIT_LOG"
      if [[ "$SOURCE_AUDIT_RC" != 0 ]]; then
        FINAL_RESULT=FAIL_SOURCE_BOOTSTRAP
        print_failure_excerpt "$SOURCE_AUDIT_LOG"
        run_support_if_policy_allows failure
        exit 1
      fi
      if [[ "$SOURCE_HANDOFF_MODE" == candidate-authoritative-deferred ]]; then
        printf 'active_source_compatibility=deferred\n'
        printf 'candidate_authoritative_source_gate=activation-and-postflight\n'
      fi

      ACTIVE_EMBEDDED_HASH=missing
      if [[ -r /run/current-system/configuration.nix ]]; then ACTIVE_EMBEDDED_HASH="$(sha256sum /run/current-system/configuration.nix | awk '{print $1}')"; fi
      printf 'active_embedded_configuration_sha256=%s\n' "$ACTIVE_EMBEDDED_HASH"
      if [[ "$ACTIVE_EMBEDDED_HASH" == "$CANDIDATE_HASH" ]]; then
        #@MNX-PART id=99.30.mnx-test.phase.identical-candidate-rebuild-skipped kind=phase title="Phase: IDENTICAL CANDIDATE — REBUILD SKIPPED"
        section 'IDENTICAL CANDIDATE — REBUILD SKIPPED'
        REBUILD_RC=skipped-already-active
        AFTER_SYSTEM="$BEFORE_SYSTEM"
        AFTER_DEFAULT="$BEFORE_DEFAULT"
        BOOT_DEFAULT_CHANGED=no
        LIVE_SOURCE_HASH_AFTER="$(sha256sum "$CFG" | awk '{print $1}')"
        [[ "$LIVE_SOURCE_HASH_AFTER" == "$CANDIDATE_HASH" ]] && SOURCE_MUTATED=no || SOURCE_MUTATED=YES
        ACTIVATED_EMBEDDED_HASH="$ACTIVE_EMBEDDED_HASH"
        ACTIVATED_EMBEDDED_MATCH=yes
        run_logged_child post-audit "$POST_AUDIT_LOG" env MNX_CONFIG="$CANDIDATE_SNAPSHOT" /etc/monsternix/bin/mnx-config-audit test
        POST_AUDIT_RC="$LAST_CHILD_RC"
        print_log_summary post_audit "$POST_AUDIT_LOG" "$POST_AUDIT_RC"
        grep -E '^officer_health_' "$POST_AUDIT_LOG" || true
        if [[ "$POST_AUDIT_RC" != 0 ]]; then
          FINAL_RESULT=FAIL_ALREADY_ACTIVE_RUNTIME_AUDIT
          print_failure_excerpt "$POST_AUDIT_LOG"
          run_support_if_policy_allows failure
          exit 1
        fi
        if ! candidate_temporary_code_gate; then
          FINAL_RESULT=FAIL_CANDIDATE_TEMPORARY_CODE_GATE
          print_failure_excerpt "$TEMP_GATE_LOG"
          exit 1
        fi
        if [[ -L /var/lib/logbook/baselines/pinned && -x /etc/monsternix/bin/mnx-behavior-manifest ]]; then
          run_logged_child contract "$CONTRACT_LOG" /etc/monsternix/bin/mnx-behavior-manifest compare pinned
          CONTRACT_RC="$LAST_CHILD_RC"
          if [[ "$CONTRACT_RC" != 0 ]]; then
            cat "$CONTRACT_LOG" || true
            if [[ "$ALLOW_BEHAVIOR_CHANGE" != 1 ]]; then
              FINAL_RESULT=FAIL_BEHAVIOR_CONTRACT
              exit 1
            fi
            BEHAVIOR_CHANGE_ALLOWED_RESULT=yes
          fi
        fi
        CORE_VALIDATED=yes
        if [[ "$BEFORE_SYSTEM" == "$BEFORE_DEFAULT" ]]; then
          FINAL_RESULT=PASS_ALREADY_ACTIVE_DEFAULT
        else
          FINAL_RESULT=PASS_ALREADY_ACTIVE_TEMPORARY
        fi
        [[ "$BEHAVIOR_CHANGE_ALLOWED_RESULT" == no ]] || FINAL_RESULT="''${FINAL_RESULT}_WITH_BEHAVIOR_CHANGE"
        run_support_if_policy_allows success
        #@MNX-PART id=99.30.mnx-test.phase.mnx-test-success-candidate-already-active kind=phase title="Phase: MNX TEST SUCCESS — CANDIDATE ALREADY ACTIVE"
        section 'MNX TEST SUCCESS — CANDIDATE ALREADY ACTIVE'
        printf 'rebuild_skipped_reason=identical-to-active-generation\n'
        printf 'MNX_TEST=%s\n' "$FINAL_RESULT"
        exit 0
      fi

      #@MNX-PART id=99.30.mnx-test.phase.preflight-for-actual-rebuild kind=phase title="Phase: PREFLIGHT FOR ACTUAL REBUILD"
      section 'PREFLIGHT FOR ACTUAL REBUILD'
      set_phase preflight
      require_free_bytes /nix/store $((8 * 1024 * 1024 * 1024)) nix-store
      require_free_bytes /var/lib/logbook $((1 * 1024 * 1024 * 1024)) logbook
      BOOT_FREE="$(df -B1 --output=avail /boot 2>/dev/null | tail -n 1 | tr -d ' ' || true)"
      printf 'free_bytes[boot]=%s advisory_minimum=%s\n' "''${BOOT_FREE:-unknown}" "$((128 * 1024 * 1024))"
      if [[ "$BOOT_FREE" =~ ^[0-9]+$ ]] && (( BOOT_FREE < 128 * 1024 * 1024 )); then echo 'WARNING: /boot has less than 128 MiB free'; fi
      nix store info --store daemon >/dev/null || fatal FAIL_NIX_DAEMON 'nix daemon store info failed'
      touch /run/storage-maintenance.lock
      exec 9<>/run/storage-maintenance.lock
      set_phase maintenance-wait
      set +e
      acquire_operator_storage_lane
      maintenance_wait_rc="$?"
      set -e
      case "$maintenance_wait_rc" in
        0) ;;
        75)
          DEFERRED_UNITS="$MAINTENANCE_WAIT_UNITS"
          defer_test DEFERRED_STORAGE_BUSY operator-storage-lane-timeout
          ;;
        2) fatal FAIL_SOURCE_MUTATED_DURING_MAINTENANCE_WAIT 'configuration.nix changed during the bounded maintenance wait' ;;
        3) fatal FAIL_RUNNING_SYSTEM_CHANGED_DURING_MAINTENANCE_WAIT 'the accepted running closure changed during the bounded maintenance wait' ;;
        4) fatal FAIL_BOOT_DEFAULT_CHANGED_DURING_MAINTENANCE_WAIT 'the boot-default closure changed during the bounded maintenance wait' ;;
        5) fatal FAIL_BASELINE_CHANGED_DURING_MAINTENANCE_WAIT 'system health changed during the bounded maintenance wait' ;;
        6) fatal FAIL_OPERATOR_RSYNC_PREEMPTION "restartable rsync preemption failed closed: $OPERATOR_PREEMPTION_RESULT" ;;
        *) fatal FAIL_MAINTENANCE_WAIT "unexpected maintenance wait result: $maintenance_wait_rc" ;;
      esac

      CONTENTION_ADVISORY_UNITS="$(contention_only_units | paste -sd, -)"
      [[ -n "$CONTENTION_ADVISORY_UNITS" ]] || CONTENTION_ADVISORY_UNITS=none
      printf 'contention_advisory_units=%s\n' "$CONTENTION_ADVISORY_UNITS"
      printf 'contention_policy=online-fstrim-and-throttled-new-storage-scrub-may-overlap-test-without-becoming-an-operator-retry\n'
      printf 'storage_preflight=operator-lock-held-root-exclusions-idle\n'
      printf 'storage_maintenance_lock=acquired\n'

      NIXOS_REBUILD="$(command -v nixos-rebuild || true)"
      [[ -n "$NIXOS_REBUILD" ]] || fatal FAIL_REBUILD_TOOL 'nixos-rebuild is unavailable'
      NIXOS_REBUILD="$(readlink -f "$NIXOS_REBUILD")"
      printf 'nixos_rebuild=%s\n' "$NIXOS_REBUILD"
      REBUILD_CMD=( "$NIXOS_REBUILD" test --show-trace -I "nixos-config=$CANDIDATE_SNAPSHOT" )
      if [[ "$TEST_TIMEOUT" != 0 ]]; then REBUILD_CMD=( timeout --signal=TERM --kill-after=2m "$TEST_TIMEOUT" "''${REBUILD_CMD[@]}" ); fi

      #@MNX-PART id=99.30.mnx-test.phase.nixos-rebuild-test-full-raw-log-saved kind=phase title="Phase: NIXOS-REBUILD TEST — FULL RAW LOG SAVED"
      section 'NIXOS-REBUILD TEST — FULL RAW LOG SAVED'
      TEST_STARTED="$(date -Is)"
      run_logged_child rebuild "$REBUILD_LOG" "''${REBUILD_CMD[@]}"
      REBUILD_RC="$LAST_CHILD_RC"
      TEST_ENDED="$(date -Is)"
      AFTER_SYSTEM="$(readlink -f /run/current-system 2>/dev/null || true)"
      AFTER_DEFAULT="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
      [[ "$AFTER_DEFAULT" == "$BEFORE_DEFAULT" ]] && BOOT_DEFAULT_CHANGED=no || BOOT_DEFAULT_CHANGED=YES
      printf 'test_started=%s\ntest_ended=%s\nnixos_rebuild_test_rc=%s\n' "$TEST_STARTED" "$TEST_ENDED" "$REBUILD_RC"
      printf 'after_running_system=%s\nafter_default_system=%s\nboot_default_unchanged=%s\n' "$AFTER_SYSTEM" "$AFTER_DEFAULT" "$([[ "$BOOT_DEFAULT_CHANGED" == no ]] && echo yes || echo NO)"
      [[ -s "$REBUILD_LOG" ]] && grep -Fq 'activating the configuration...' "$REBUILD_LOG" && ACTIVATION_STARTED=yes || true
      print_log_summary rebuild "$REBUILD_LOG" "$REBUILD_RC"

      if [[ "$BOOT_DEFAULT_CHANGED" != no ]]; then
        FINAL_RESULT=FAIL_BOOT_DEFAULT
        print_failure_excerpt "$REBUILD_LOG"
        compact_diagnostics
        rollback_previous
        run_support_if_policy_allows failure
        exit 1
      fi
      if [[ "$REBUILD_RC" == 124 ]]; then
        FINAL_RESULT=FAIL_REBUILD_TIMEOUT
        print_failure_excerpt "$REBUILD_LOG"
        compact_diagnostics
        rollback_previous
        run_support_if_policy_allows failure
        exit 1
      fi
      if [[ "$REBUILD_RC" != 0 ]]; then
        FINAL_RESULT=FAIL_REBUILD
        print_failure_excerpt "$REBUILD_LOG"
        compact_diagnostics
        rollback_previous
        run_support_if_policy_allows failure
        exit 1
      fi
      print_success_excerpt "$REBUILD_LOG"

      LIVE_SOURCE_HASH_AFTER="$(sha256sum "$CFG" 2>/dev/null | awk '{print $1}')"
      [[ "$LIVE_SOURCE_HASH_AFTER" == "$CANDIDATE_HASH" ]] && SOURCE_MUTATED=no || SOURCE_MUTATED=YES
      if [[ -r "$AFTER_SYSTEM/configuration.nix" ]]; then ACTIVATED_EMBEDDED_HASH="$(sha256sum "$AFTER_SYSTEM/configuration.nix" | awk '{print $1}')"; else ACTIVATED_EMBEDDED_HASH=missing; fi
      [[ "$ACTIVATED_EMBEDDED_HASH" == "$CANDIDATE_HASH" ]] && ACTIVATED_EMBEDDED_MATCH=yes || ACTIVATED_EMBEDDED_MATCH=NO
