#@MNX-DEF path=services.xserver.autorun section=30.50 role=policy ordinal=090
  services.xserver.autorun = true;
#@MNX-DEF path=services.xserver.desktopManager.xterm.enable section=30.50 role=policy ordinal=091
  services.xserver.desktopManager.xterm.enable = false;
#@MNX-DEF path=services.displayManager.autoLogin.enable section=30.50 role=policy ordinal=092
  services.displayManager.autoLogin.enable = true;
#@MNX-DEF path=services.displayManager.autoLogin.user section=30.50 role=policy ordinal=093
  services.displayManager.autoLogin.user = "h0p3";
#@MNX-DEF path=services.displayManager.defaultSession section=30.50 role=policy ordinal=094
  services.displayManager.defaultSession = "none+i3";
#@MNX-DEF path=services.xserver.displayManager.lightdm.enable section=30.50 role=policy ordinal=095
  services.xserver.displayManager.lightdm.enable = true;
#@MNX-DEF path=services.xserver.enable section=30.50 role=policy ordinal=096
  services.xserver.enable = true;
#@MNX-DEF path=services.xserver.xkb.layout section=30.50 role=policy ordinal=097
  services.xserver.xkb.layout = "us";
#@MNX-DEF path=services.xserver.dpi section=30.50 role=policy ordinal=098
  services.xserver.dpi = 96;
#@MNX-DEF path=services.xserver.windowManager.i3.enable section=30.50 role=policy ordinal=099
  services.xserver.windowManager.i3.enable = true;
#@MNX-DEF path=services.picom.enable section=30.50 role=policy ordinal=100
  services.picom.enable = true;
  # probably need to make it easy to comment in autolocking, i3lock, and autologin off
  # sddm for i3 and sway?

  #fake impossible not real option services.xserver.windowManager.i3.config = ''
  #  # Paste the contents of your i3.conf here
  #'';
  # keep the configuration file contents here, inject it into /home/h0p3/admin/i3/read-only_i3.config 
  #services.xserver.windowManager.i3.configFile = "/home/h0p3/admin/i3/read-only_i3.config";
  # services.xserver.windowManager.i3.extraSessionCommands

#@MNX-DEF path=programs.dconf.enable section=30.50 role=policy ordinal=101
  programs.dconf.enable = true;

#@MNX-DEF path=xdg.portal section=30.50 role=policy ordinal=102
  xdg.portal = {
    enable = true;
    extraPortals = [ pkgs.xdg-desktop-portal-gtk ];

    config.common.default = [ "gtk" ];
  };

#@MNX-DEF path=xdg.menus.enable section=30.50 role=policy ordinal=103
  xdg.menus.enable = true;
#@MNX-DEF path=xdg.mime.enable section=30.50 role=policy ordinal=104
  xdg.mime.enable = true; 

#@MNX-DEF path=environment.etc."xdg/menus/applications.menu".text section=30.50 role=generated-config ordinal=105
  environment.etc."xdg/menus/applications.menu".text = ''
    <!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
     "http://www.freedesktop.org/standards/menu-spec/1.0/menu.dtd">
    <Menu>
      <Name>Applications</Name>
      <DefaultAppDirs/>
      <DefaultDirectoryDirs/>
      <Include>
        <All/>
      </Include>
    </Menu>
  '';

#@MNX-DEF path=environment.etc."xdg/gtk-4.0/settings.ini".text section=30.50 role=generated-config ordinal=106
  environment.etc."xdg/gtk-4.0/settings.ini".text = ''
    [Settings]
    gtk-application-prefer-dark-theme=1
    gtk-icon-theme-name=Adwaita
    gtk-font-name=Noto Sans 10
  '';


## gaming
#@MNX-DEF path=programs.steam.enable section=30.50 role=policy ordinal=107
programs.steam.enable = true;
#@MNX-DEF path=programs.gamescope.enable section=30.50 role=policy ordinal=108
programs.gamescope.enable = true;   # for the 4K font/mouse issues later


