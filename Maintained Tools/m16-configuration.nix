      #@MNX-PART id=99.55.mnx-atlas.function.build-parser kind=function title="Python function build_parser"
      def build_parser() -> argparse.ArgumentParser:
          parser = argparse.ArgumentParser(
              prog="mnx-atlas",
              description=(
                  "Strict chunk, definition, internal-part, search, and candidate-only temporary-code atlas "
                  "for the Monsternix monolith"
              ),
          )
          parser.add_argument("--config", default=str(Path("/etc/nixos/configuration.nix")))
          sub = parser.add_subparsers(dest="command", required=True)
          index = sub.add_parser("index", help="hierarchical chunk and definition map")
          index.add_argument("--parts", action="store_true", help="include every internal part")
          sub.add_parser("manifest", help="complete JSON atlas manifest")
          sub.add_parser("verify", help="validate actual assignments, DEF/PART truth, TEMP containment, and bytes")
          definitions_parser = sub.add_parser("definitions", help="list definitions, optionally filtered")
          definitions_parser.add_argument("selector", nargs="?")
          definition_parser = sub.add_parser("definition", help="print one exact top-level definition")
          definition_parser.add_argument("selector")
          parts_parser = sub.add_parser("parts", help="list parts, optionally within one definition")
          parts_parser.add_argument("selector", nargs="?")
          part_parser = sub.add_parser("part", help="print one exact internal part")
          part_parser.add_argument("selector")
          search_parser = sub.add_parser("search", help="regex search with chunk/definition/part context")
          search_parser.add_argument("pattern")
          search_parser.add_argument("--context", type=int, default=2)
          search_parser.add_argument("--max", type=int, default=100)
          temp_parser = sub.add_parser("temp", help="candidate-only temporary-code status")
          temp_parser.add_argument("--show", action="store_true")
          temp_gate_parser = sub.add_parser("temp-gate", help="enforce candidate-only temporary-code policy")
          temp_gate_parser.add_argument("mode", choices=["test", "switch", "audit"])
          sub.add_parser("temp-template", help="print the inert SECTION-98 template")
          bundle_parser = sub.add_parser("bundle", help="create a byte-exact source, definition, and part tar.gz")
          bundle_parser.add_argument("--out", type=Path)
          sub.add_parser("self-test")
          return parser
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.main kind=function title="Python function main"
      def main(argv: Sequence[str] | None = None) -> int:
          args = build_parser().parse_args(argv)
          try:
              if args.command == "self-test":
                  return command_navigation_self_test()
              navigation = build_navigation(Path(args.config))
              if args.command == "index":
                  print_navigation_index(navigation, include_parts=args.parts)
                  return 0
              if args.command == "manifest":
                  return command_navigation_manifest(navigation)
              if args.command == "verify":
                  print(f"source={navigation.source}")
                  print(f"source_sha256={navigation.sha256}")
                  print(f"source_bytes={len(navigation.raw_bytes)}")
                  print(f"chunk_count={len(navigation.core.chunks)}")
                  print(f"definition_count={len(navigation.core.definitions)}")
                  print(f"part_count={len(navigation.policy.parts)}")
                  print(f"temporary_code_region_count={len(navigation.policy.temporary_regions)}")
                  print("all_top_level_assignments_anchored=yes")
                  print("all_definition_markers_truthful=yes")
                  print("all_definition_ordinals_contiguous=yes")
                  print("no_chunk_marker_splits_definition=yes")
                  print("all_internal_function_class_phase_anchors_truthful=yes")
                  print("section_98_temporary_code_containment=yes")
                  print("exact_source_byte_identity=yes")
                  print("MNX_ATLAS_DEFENSE=PASS")
                  print("MNX_ATLAS=PASS")
                  return 0
              if args.command == "definitions":
                  items = navigation.core.definitions
                  if args.selector:
                      query = args.selector.casefold()
                      items = tuple(
                          item for item in items
                          if query in item.marker.path.casefold()
                          or query in str(item.marker.ordinal)
                      )
                  for item in items:
                      count = sum(
                          1 for part in navigation.policy.parts
                          if part.definition_ordinal == item.marker.ordinal
                      )
                      print(
                          f"{item.marker.ordinal:03d}\t{item.marker.section}\t{item.marker.role}\t"
                          f"lines={item.marker.line}-{item.assignment.end_line}\tparts={count}\t{item.marker.path}"
                      )
                  return 0 if items else 1
              if args.command == "definition":
                  sys.stdout.buffer.write(definition_bytes(navigation, resolve_navigation_definition(navigation, args.selector)))
                  return 0
              if args.command == "parts":
                  items = navigation.policy.parts
                  if args.selector:
                      definition = resolve_navigation_definition(navigation, args.selector)
                      items = tuple(
                          item for item in items
                          if item.definition_ordinal == definition.marker.ordinal
                      )
                  for item in items:
                      print(
                          f"{item.part_id}\t{item.kind}\tlines={item.marker_line}-{item.end_line}\t"
                          f"def={item.definition_ordinal:03d}\t{item.title}"
                      )
                  return 0 if items else 1
              if args.command == "part":
                  sys.stdout.buffer.write(part_bytes(navigation, resolve_navigation_part(navigation, args.selector)))
                  return 0
              if args.command == "search":
                  return command_navigation_search(
                      navigation,
                      args.pattern,
                      max(args.context, 0),
                      max(args.max, 1),
                  )
              if args.command == "temp":
                  return command_navigation_temp(navigation, args.show)
              if args.command == "temp-gate":
                  return command_navigation_temp_gate(navigation, args.mode)
              if args.command == "temp-template":
                  return command_navigation_temp_template()
              if args.command == "bundle":
                  return command_navigation_bundle(navigation, args.out)
              raise PolicyError(f"unsupported command: {args.command}")
          except BrokenPipeError:
              try:
                  sys.stdout.close()
              except OSError:
                  pass
              return 0
          except (PolicyError, AtlasError, OSError) as exc:
              print(f"MNX_ATLAS_ERROR: {exc}", file=sys.stderr)
              return 1
      
      
      if __name__ == "__main__":
          raise SystemExit(main())
      '';
      checkPhase = ''
        set -Eeuo pipefail
        ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
        "$out" self-test
      '';
    };
  };

