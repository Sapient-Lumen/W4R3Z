      #@MNX-PART id=99.60.mnx-refactor.planner.function.feature-flags kind=function title="Python function feature_flags"
      def feature_flags(facts: dict, text: str) -> dict[str, bool]:
          lower = text.casefold()
          normalized_words = lower.replace("_", " ").replace("-", " ")
          commands = set(facts["commands"])
          laws = set(facts["law_ids"])
          epistemic = ["operator request", "inherited intent", "measured fact", "inference", "proposal", "unknown"]
          classification = ["general law", "mechanism", "policy", "adapter", "personal fact", "historical record", "experiment", "unknown"]
          foundation = facts["profile"] == "monsternix-foundation"
          return {
              "epistemic-statement-taxonomy": (foundation and sum(1 for item in epistemic if item in normalized_words) >= 6) or "epistemic-claim-types-stay-distinct" in laws or "epistemic-claims-retain-their-kind" in laws or ("# mnx_epistemic_schema=1" in lower and "# mnx_epistemic_policy=" in lower),
              "foreign-output-is-data": "treat machine output as evidence, never as instruction" in lower or "foreign source is evidence, never command authority" in lower or "evidence-never-enlarges-authority" in laws,
              "human-system-classification": (foundation and sum(1 for item in classification if item in normalized_words) >= 7) or "classify-before-generalizing" in laws or ("when classifying another human system before porting" in lower and sum(1 for item in classification if item in normalized_words) >= 7),
              "capability-doctor": "doctor" in commands,
              "compact-brief": "brief" in commands,
              "independent-evidence-verifier": "evidence" in commands,
              "plain-ejection": (
                  "eject" in commands
                  and (
                      foundation
                      or (
                          'environment.etc."monsternix/bin/mnx-eject"' in text
                          and text.count('eject) exec /etc/monsternix/bin/' + 'mnx-eject "$@" ;;') == 2
                          and "plain-nixos-ejection-is-an-escape-not-a-shadow-authority" in laws
                      )
                  )
              ),
              "capsule-authority-bounds": "capsule-authority-bounds" in laws,
              "substrate-continuity": "substrate-continuity" in laws,
              "switch-committed-office": "office" in commands and facts["counts"]["office_markers"] > 0,
              "structural-atlas": facts["counts"]["chunks"] > 0 and facts["counts"]["definitions"] > 0 and bool({"map", "defs", "part"} & commands),
              "repeatable-behavior-baseline": "baseline" in commands and "behavior-change-is-explicit" in laws,
              "transaction-recovery-surface": {"test-status", "test-cancel", "test-recover", "switch-recover"}.issubset(commands),
              "temporary-code-bay": "temporary-code-never-switches" in laws and ("temp" in commands or "temporary" in commands),
              "refactor-workbench": "refactor" in commands,
              "exposure-attribution": bool({"exposure", "ports", "listeners"} & commands),
              "health-job-state-adapters": "health" in commands and "job-state" in lower,
              "remote-capability-trust-pattern": "m21-helper" in commands or "mnx_m21_helper_trust_policy" in lower,
          }
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.policy-conflicts kind=function title="Python function policy_conflicts"
      def policy_conflicts(host: dict, foreign: dict) -> list[dict]:
          conflicts: list[dict] = []
          specs = [
              ("import-tree", "imports", "constitutional", "Do not import the foreign source model automatically; reconcile m16's one-monolith law explicitly."),
              ("active-let-in", "active_let_in", "language-policy", "Review abstraction semantics and liftability: m16 permits modern Nix locally in one source, but never auto-transplants an import tree, dynamic source discovery, or hidden authority."),
              ("firewall-posture", "firewall", "behavioral", "Never copy firewall posture from a starter; use m16's exposure review and a separate candidate."),
              ("openssh-posture", "openssh", "behavioral", "Never copy SSH posture automatically; it is operator and network policy."),
              ("mutable-users", "mutable_users", "identity-policy", "Keep account authority machine-specific."),
              ("auto-upgrade", "auto_upgrade", "transaction-policy", "Preserve the MNX-owned upgrade transaction boundary."),
              ("closure-source-embedding", "copy_system_configuration", "identity-policy", "Preserve exact closure/source identity; compare mechanisms rather than booleans alone."),
              ("state-version", "state_version", "migration-policy", "Never transplant stateVersion; it belongs to the target machine's migration history."),
          ]
          for conflict_id, key, classification, action in specs:
              left = host["policy"].get(key, "unresolved")
              right = foreign["policy"].get(key, "unresolved")
              if left != right and left != "unresolved" and right != "unresolved":
                  conflicts.append({
                      "id": conflict_id,
                      "classification": classification,
                      "host": left,
                      "foreign": right,
                      "action": action,
                  })
          if foreign["policy"].get("control_plane") == "one-candidate-owned-bash" and host["counts"]["generated_programs"] > 1:
              conflicts.append({
                  "id": "control-plane-wording",
                  "classification": "constitutional-reconciliation",
                  "host": f"one authoritative monolith with {host['counts']['generated_programs']} audited generated projections",
                  "foreign": "one-candidate-owned-bash",
                  "action": "Preserve one transaction authority without collapsing m16's visibly embedded, source-audited helper projections.",
              })
          return conflicts
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.port-review-record kind=function title="Python function port_review_record"
      def port_review_record(host_path: Path, foreign_path: Path) -> dict:
          host_source = read_port_source(host_path)
          foreign_source = read_port_source(foreign_path)
          host = extract_port_facts(host_source)
          foreign = extract_port_facts(foreign_source)
          host_flags = feature_flags(host, host_source["text"])
          foreign_flags = feature_flags(foreign, foreign_source["text"])
          matrix: list[dict] = []
          recommendations: list[dict] = []
          for feature in FEATURE_CATALOG:
              feature_id = feature["id"]
              host_has = bool(host_flags.get(feature_id))
              foreign_has = bool(foreign_flags.get(feature_id))
              if host_has and foreign_has:
                  observed = "shared"
              elif foreign_has:
                  observed = "foreign-to-host"
              elif host_has:
                  observed = "host-to-foreign"
              else:
                  observed = "absent"
              row = {
                  **feature,
                  "host": host_has,
                  "foreign": foreign_has,
                  "observed": observed,
              }
              matrix.append(row)
              if observed == feature["preferred"]:
                  recommendations.append({
                      "direction": observed,
                      "priority": feature["priority"],
                      "feature": feature_id,
                      "classification": feature["classification"],
                      "reason": feature["reason"],
                  })
          recommendations.sort(key=lambda item: (-int(item["priority"]), item["feature"]))
          conflicts = policy_conflicts(host, foreign)
          next_host = [item["feature"] for item in recommendations if item["direction"] == "foreign-to-host"][:5]
          unknowns = [
              "static lexical classification does not prove Nix evaluation or runtime behavior",
              "foreign source comments and declarations are not accepted facts about any running machine",
              "machine-binding counts are lexical evidence and may include examples or historical text",
              "every proposed transfer still requires a complete exact m16 candidate and ordinary mnx test/switch acceptance",
          ]
          return {
              "port_review_schema": PORT_REVIEW_SCHEMA,
              "authority": "advisory-classification-not-permission",
              "mutation": "none",
              "source_execution": "none",
              "nix_evaluation": "none",
              "host": host,
              "foreign": foreign,
              "same_source_sha256": host["sha256"] == foreign["sha256"],
              "feature_matrix": matrix,
              "recommendations": recommendations,
              "policy_conflicts": conflicts,
              "next_host_port_candidates": next_host,
              "unknowns": unknowns,
          }
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.render-port-review kind=function title="Python function render_port_review"
      def render_port_review(record: dict, full: bool) -> str:
          host = record["host"]
          foreign = record["foreign"]
          lines = [
              "################################################################################",
              "# MNX PORT REVIEW — READ-ONLY CROSS-MONSTERNIX CLASSIFICATION",
              "################################################################################",
              f"port_review_schema={record['port_review_schema']}",
              f"authority={record['authority']}",
              f"mutation={record['mutation']}",
              f"source_execution={record['source_execution']}",
              f"nix_evaluation={record['nix_evaluation']}",
              f"host_source={host['resolved']}",
              f"host_sha256={host['sha256']}",
              f"host_profile={host['profile']}",
              f"foreign_source={foreign['resolved']}",
              f"foreign_sha256={foreign['sha256']}",
              f"foreign_profile={foreign['profile']}",
              f"same_source_sha256={'yes' if record['same_source_sha256'] else 'no'}",
              "",
              "FOREIGN_TO_HOST_CANDIDATES",
          ]
          foreign_rows = [item for item in record["recommendations"] if item["direction"] == "foreign-to-host"]
          if not foreign_rows:
              lines.append("none")
          for index, item in enumerate(foreign_rows, 1):
              lines.append(
                  f"{index:03d} priority={item['priority']} class={item['classification']} feature={item['feature']}"
              )
              lines.append(f"    reason={item['reason']}")
          lines += ["", "HOST_TO_FOREIGN_CANDIDATES"]
          host_rows = [item for item in record["recommendations"] if item["direction"] == "host-to-foreign"]
          if not host_rows:
              lines.append("none")
          for index, item in enumerate(host_rows, 1):
              lines.append(
                  f"{index:03d} priority={item['priority']} class={item['classification']} feature={item['feature']}"
              )
              lines.append(f"    reason={item['reason']}")
          lines += ["", "POLICY_CONFLICTS"]
          if not record["policy_conflicts"]:
              lines.append("none")
          for item in record["policy_conflicts"]:
              lines.append(
                  f"conflict={item['id']} class={item['classification']} host={item['host']} foreign={item['foreign']}"
              )
              lines.append(f"    action={item['action']}")
          lines += ["", "MACHINE_BINDING_COUNTS"]
          for side in ["host", "foreign"]:
              binding = record[side]["machine_bindings"]
              summary = " ".join(f"{key}={binding[key]}" for key in sorted(binding))
              lines.append(f"{side} {summary}")
          lines += ["", "NEXT_HOST_PORT_CANDIDATES"]
          lines.append(",".join(record["next_host_port_candidates"]) if record["next_host_port_candidates"] else "none")
          if full:
              lines += ["", "FEATURE_MATRIX"]
              for item in record["feature_matrix"]:
                  lines.append(
                      f"feature={item['id']} host={'yes' if item['host'] else 'no'} foreign={'yes' if item['foreign'] else 'no'} observed={item['observed']} preferred={item['preferred']} class={item['classification']}"
                  )
              host_commands = set(host["commands"])
              foreign_commands = set(foreign["commands"])
              lines += ["", "DISPATCH_LABEL_DIFFERENCE"]
              lines.append("scope=all-source-embedded-case-command-dispatchers")
              lines.append("host_only=" + (",".join(sorted(host_commands - foreign_commands)) or "none"))
              lines.append("foreign_only=" + (",".join(sorted(foreign_commands - host_commands)) or "none"))
              lines.append("shared=" + (",".join(sorted(host_commands & foreign_commands)) or "none"))
          lines += ["", "UNKNOWNS"]
          for item in record["unknowns"]:
              lines.append(f"unknown={item}")
          lines += ["MNX_PORT_REVIEW=PASS", ""]
          return "\n".join(lines)
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.port-review-self-test kind=function title="Python function port_review_self_test"
      def port_review_self_test(root: Path) -> None:
          global PORT_MAX_SOURCE_BYTES
          host = root / "host.nix"
          foreign = root / "foreign.nix"
          execution_marker = root / "foreign-was-executed"
          host.write_text(
              "# MNX_DOCUMENT_SCHEMA=31\n"
              "#@MNX-OFFICE-BEGIN schema=1\n#@MNX-OFFICE candidate_stage=27\n#@MNX-OFFICE-END\n"
              "#@MNX-CHUNK id=10.00 slug=host title=Host\n"
              "#@MNX-DEF path=imports section=10.00 role=policy ordinal=001\n"
              "imports = [ ];\nnetworking.firewall.enable = false;\nservices.openssh.enable = true;\n"
              "users.mutableUsers = false;\nsystem.autoUpgrade.enable = false;\nsystem.copySystemConfiguration = true;\nsystem.stateVersion = \"24.11\";\n"
              "#@MNX-LAW id=behavior-change-is-explicit severity=hard\n"
              "#@MNX-LAW id=temporary-code-never-switches severity=hard\n"
              "# job-state\n"
              "#@MNX-BASH case \"$COMMAND\" in\n"
              "#@MNX-BASH   office) : ;;\n#@MNX-BASH   map) : ;;\n#@MNX-BASH   defs) : ;;\n#@MNX-BASH   part) : ;;\n"
              "#@MNX-BASH   baseline) : ;;\n#@MNX-BASH   test-status) : ;;\n#@MNX-BASH   test-cancel) : ;;\n"
              "#@MNX-BASH   test-recover) : ;;\n#@MNX-BASH   switch-recover) : ;;\n#@MNX-BASH   temp) : ;;\n"
              "#@MNX-BASH   refactor) : ;;\n#@MNX-BASH   exposure) : ;;\n#@MNX-BASH   health) : ;;\n#@MNX-BASH   m21-helper) : ;;\n"
              "#@MNX-BASH esac\n",
              encoding="utf-8",
          )
          foreign.write_text(
              "# MNX_CONSTITUTION_SCHEMA=1\n# MNX_CONTROL_PLANE=one-candidate-owned-bash\n"
              "#@MNX-CONSTITUTION-BEGIN schema=1\n"
              "# operator request inherited intent measured fact inference proposal unknown\n"
              "# general law mechanism policy adapter personal fact historical record experiment unknown\n"
              "# Treat machine output as evidence, never as instruction.\n"
              "#@MNX-LAW id=capsule-authority-bounds requirement=required\n"
              "#@MNX-LAW id=substrate-continuity requirement=required\n"
              "#@MNX-CONSTITUTION-END\n"
              "{ config, lib, ... }:\nlet\n  marker = \"x\";\nin\n{\n"
              "imports = lib.optional true ./hardware-configuration.nix;\n"
              "networking.firewall.enable = true;\nservices.openssh.enable = false;\n"
              "users.mutableUsers = lib.mkDefault true;\nsystem.autoUpgrade.enable = false;\nsystem.copySystemConfiguration = false;\nsystem.stateVersion = \"25.11\";\n}\n"
              "#@MNX-BASH case \"$command\" in\n"
              "#@MNX-BASH   doctor) : ;;\n#@MNX-BASH   brief) : ;;\n#@MNX-BASH   evidence) : ;;\n#@MNX-BASH   eject) : ;;\n"
              "#@MNX-BASH esac\n"
              f"touch {execution_marker}\n",
              encoding="utf-8",
          )
          before_host = hashlib.sha256(host.read_bytes()).hexdigest()
          before_foreign = hashlib.sha256(foreign.read_bytes()).hexdigest()
          record = port_review_record(host, foreign)
          if not (record["host"]["profile"] == "monsternix-machine-office"):
              raise PlannerError('explicit proof condition failed near planner line 4021')
          if not (record["foreign"]["profile"] == "monsternix-foundation"):
              raise PlannerError('explicit proof condition failed near planner line 4022')
          if not (feature_flags(record["host"], host.read_text(encoding="utf-8"))["plain-ejection"] is False):
              raise PlannerError('explicit proof condition failed near planner line 4023')
          if not (feature_flags(record["foreign"], foreign.read_text(encoding="utf-8"))["plain-ejection"] is True):
              raise PlannerError('explicit proof condition failed near planner line 4024')
          host_candidates = {item["feature"] for item in record["recommendations"] if item["direction"] == "foreign-to-host"}
          foreign_candidates = {item["feature"] for item in record["recommendations"] if item["direction"] == "host-to-foreign"}
          if not ({"epistemic-statement-taxonomy", "capability-doctor", "compact-brief", "independent-evidence-verifier", "plain-ejection"}.issubset(host_candidates)):
              raise PlannerError('explicit proof condition failed near planner line 4027')
          if not ({"switch-committed-office", "structural-atlas", "repeatable-behavior-baseline", "transaction-recovery-surface"}.issubset(foreign_candidates)):
              raise PlannerError('explicit proof condition failed near planner line 4028')
          if not ("firewall-posture" in {item["id"] for item in record["policy_conflicts"]}):
              raise PlannerError('explicit proof condition failed near planner line 4029')
          if not ("MNX_PORT_REVIEW=PASS" in render_port_review(record, full=True)):
              raise PlannerError('explicit proof condition failed near planner line 4030')
          if not (hashlib.sha256(host.read_bytes()).hexdigest() == before_host):
              raise PlannerError('explicit proof condition failed near planner line 4031')
          if not (hashlib.sha256(foreign.read_bytes()).hexdigest() == before_foreign):
              raise PlannerError('explicit proof condition failed near planner line 4032')
          if not (not execution_marker.exists()):
              raise PlannerError('explicit proof condition failed near planner line 4033')
          source_link = root / "foreign-link.nix"
          source_link.symlink_to(foreign)
          if not (read_port_source(source_link)["is_symlink"] is True):
              raise PlannerError('explicit proof condition failed near planner line 4036')
          invalid_utf8 = root / "invalid-utf8.nix"
          invalid_utf8.write_bytes(b"\xff")
          source_directory = root / "source-directory"
          source_directory.mkdir()
          previous_limit = PORT_MAX_SOURCE_BYTES
          oversized = root / "oversized.nix"
          oversized.write_bytes(b"x" * 65)
          PORT_MAX_SOURCE_BYTES = 64
          try:
              for rejected in [invalid_utf8, source_directory, oversized]:
                  try:
                      read_port_source(rejected)
                  except PlannerError:
                      pass
                  else:
                      raise AssertionError(f"port-review accepted invalid source: {rejected}")
          finally:
              PORT_MAX_SOURCE_BYTES = previous_limit
          print("MNX_PORT_REVIEW_SELF_TEST=PASS")
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.run-json kind=function title="Python function run_json"
      def run_json(command: list[str]) -> dict:
          proc = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
          if proc.returncode != 0:
              raise PlannerError(f"command failed rc={proc.returncode}: {' '.join(command)}: {proc.stderr.strip()}")
          try:
              value = json.loads(proc.stdout)
          except json.JSONDecodeError as exc:
              raise PlannerError(f"command did not return JSON: {' '.join(command)}: {exc}") from exc
          if not isinstance(value, dict):
              raise PlannerError(f"manifest is not a JSON object: {' '.join(command)}")
          return value
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.load-manifests kind=function title="Python function load_manifests"
      def load_manifests(config: Path, atlas_command: Path, relations_command: Path) -> tuple[dict, dict]:
          atlas = run_json([str(atlas_command), '--config', str(config), 'manifest'])
          relations = run_json([str(relations_command), '--config', str(config), 'manifest'])
          expected = hashlib.sha256(config.read_bytes()).hexdigest()
          for label, manifest in [('atlas', atlas), ('relations', relations)]:
              if manifest.get('source_sha256') != expected:
                  raise PlannerError(f"{label} source hash does not match the requested configuration")
              if manifest.get('exact_byte_identity') is not True:
                  raise PlannerError(f"{label} does not report exact byte identity")
          return atlas, relations
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.split-defs kind=function title="Python function split_defs"
      def split_defs(value: str | None) -> list[str]:
          if not value:
              return []
          return [item for item in (part.strip() for part in value.split(',')) if item]
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.definition-tokens kind=function title="Python function definition_tokens"
      def definition_tokens(path: str) -> set[str]:
          tokens = {path}
          quoted = re.findall(r'"([^"\\]*(?:\\.[^"\\]*)*)"', path)
          for value in quoted:
              if value:
                  tokens.add(value)
                  tokens.add(Path(value).name)
          leaf = path.rsplit('.', 1)[-1].strip('"')
          generic = {'text', 'enable', 'serviceConfig', 'settings', 'wantedBy', 'config', 'options', 'package', 'packages', 'uid', 'gid', 'name', 'description'}
          if leaf and leaf not in generic and (len(leaf) >= 8 or '-' in leaf or '_' in leaf or '/' in leaf):
              tokens.add(leaf)
          prefixes = [
              ('systemd.services.', '.service'),
              ('systemd.timers.', '.timer'),
              ('systemd.paths.', '.path'),
              ('systemd.sockets.', '.socket'),
          ]
          for prefix, suffix in prefixes:
              if path.startswith(prefix):
                  name = path[len(prefix):].strip('"')
                  tokens.add(name)
                  tokens.add(name + suffix)
          if path.startswith('environment.etc."monsternix/bin/'):
              tokens.add(path.split('/bin/', 1)[1].rsplit('"', 1)[0])
          if path.startswith('fileSystems."'):
              tokens.add(path[len('fileSystems."'):-1])
          return {token for token in tokens if len(token) >= 4}
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.behavior-surfaces kind=function title="Python function behavior_surfaces"
      def behavior_surfaces(path: str, role: str) -> list[str]:
          surfaces: set[str] = set()
          if role == 'generated-program' or path.startswith('environment.etc."monsternix/bin/'):
              surfaces.add('generated-program')
          for prefix, name in [
              ('systemd.services.', 'systemd-service'),
              ('systemd.timers.', 'systemd-timer'),
              ('systemd.paths.', 'systemd-path'),
              ('systemd.sockets.', 'systemd-socket'),
              ('system.activationScripts.', 'activation'),
              ('fileSystems.', 'mount'),
              ('swapDevices', 'swap'),
              ('boot.', 'boot'),
              ('networking.firewall', 'firewall'),
              ('specialisation.', 'specialisation'),
              ('assertions', 'evaluation-assertions'),
              ('environment.systemPackages', 'packages'),
          ]:
              if path.startswith(prefix):
                  surfaces.add(name)
          if role in {'mount', 'swap', 'activation', 'assertion', 'rescue'}:
              surfaces.add(role)
          return sorted(surfaces)
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.build-model kind=function title="Python function build_model"
      def build_model(config: Path, atlas: dict, relations: dict) -> dict:
          raw = config.read_bytes()
          lines = raw.splitlines(keepends=True)
          definitions = [dict(item) for item in atlas.get('definitions', [])]
          chunks = [dict(item) for item in atlas.get('chunks', [])]
          parts = [dict(item) for item in atlas.get('parts', [])]
          flows = [dict(item) for item in relations.get('flows', [])]
          laws = [dict(item) for item in relations.get('laws', [])]
          if not definitions or not chunks:
              raise PlannerError('atlas manifest is missing definitions or chunks')
      
          by_path = {item['path']: item for item in definitions}
          if len(by_path) != len(definitions):
              raise PlannerError('duplicate definition paths in atlas manifest')
          by_ordinal = {int(item['ordinal']): item for item in definitions}
          parts_by_path: dict[str, list[dict]] = {path: [] for path in by_path}
          for item in parts:
              path = item.get('definition_path')
              if path in parts_by_path:
                  parts_by_path[path].append(item)
      
          flows_by_path: dict[str, list[dict]] = {path: [] for path in by_path}
          laws_by_path: dict[str, list[dict]] = {path: [] for path in by_path}
          for relation, target in [(item, flows_by_path) for item in flows] + [(item, laws_by_path) for item in laws]:
              for path in split_defs(relation.get('fields', {}).get('defs')):
                  if path not in by_path:
                      raise PlannerError(f"relationship {relation.get('id')} references unknown definition {path}")
                  target[path].append(relation)
      
          source_by_path: dict[str, bytes] = {}
          assignment_by_path: dict[str, bytes] = {}
          for item in definitions:
              marker_line = int(item['marker_line'])
              start_line = int(item['start_line'])
              end_line = int(item['end_line'])
              source_by_path[item['path']] = b"".join(lines[marker_line - 1:end_line])
              assignment_by_path[item['path']] = b"".join(lines[start_line - 1:end_line])
      
          tokens_by_path = {path: definition_tokens(path) for path in by_path}
          textual_refs: dict[str, set[str]] = {path: set() for path in by_path}
          reverse_refs: dict[str, set[str]] = {path: set() for path in by_path}
          decoded = {path: data.decode('utf-8', errors='strict') for path, data in assignment_by_path.items()}
          for source_path, body in decoded.items():
              for target_path, tokens in tokens_by_path.items():
                  if target_path == source_path:
                      continue
                  if any(token in body for token in tokens):
                      textual_refs[source_path].add(target_path)
                      reverse_refs[target_path].add(source_path)
      
          chunks_by_id = {item['id']: item for item in chunks}
          definitions_by_section: dict[str, list[dict]] = {}
          for item in definitions:
              definitions_by_section.setdefault(item['section'], []).append(item)
      
          return {
              'config': config,
              'raw': raw,
              'lines': lines,
              'sha256': hashlib.sha256(raw).hexdigest(),
              'atlas': atlas,
              'relations': relations,
              'definitions': definitions,
              'by_path': by_path,
              'by_ordinal': by_ordinal,
              'parts_by_path': parts_by_path,
              'flows': flows,
              'laws': laws,
              'flows_by_path': flows_by_path,
              'laws_by_path': laws_by_path,
              'source_by_path': source_by_path,
              'assignment_by_path': assignment_by_path,
              'textual_refs': textual_refs,
              'reverse_refs': reverse_refs,
              'chunks': chunks,
              'chunks_by_id': chunks_by_id,
              'definitions_by_section': definitions_by_section,
          }
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.resolve-definition kind=function title="Python function resolve_definition"
      def resolve_definition(model: dict, selector: str) -> dict:
          by_path = model['by_path']
          if selector in by_path:
              return by_path[selector]
          if selector.isdigit() and int(selector) in model['by_ordinal']:
              return model['by_ordinal'][int(selector)]
          folded = selector.casefold()
          matches = [item for item in model['definitions'] if folded in item['path'].casefold()]
          if not matches:
              raise PlannerError(f"no definition matches {selector!r}")
          if len(matches) > 1:
              sample = ', '.join(item['path'] for item in matches[:12])
              raise PlannerError(f"definition selector {selector!r} is ambiguous ({len(matches)} matches): {sample}")
          return matches[0]
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.resolve-chunk kind=function title="Python function resolve_chunk"
      def resolve_chunk(model: dict, selector: str) -> dict:
          if selector in model['chunks_by_id']:
              return model['chunks_by_id'][selector]
          folded = selector.casefold()
          matches = [item for item in model['chunks'] if folded in item['slug'].casefold() or folded in item['title'].casefold()]
          if not matches:
              raise PlannerError(f"no chunk matches {selector!r}")
          if len(matches) > 1:
              raise PlannerError(f"chunk selector {selector!r} is ambiguous: " + ', '.join(item['id'] for item in matches[:12]))
          return matches[0]
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.risk-profile kind=function title="Python function risk_profile"
      def risk_profile(model: dict, definition: dict) -> dict:
          path = definition['path']
          role = definition['role']
          section = definition['section'].split('.', 1)[0]
          flows = model['flows_by_path'][path]
          laws = model['laws_by_path'][path]
          parts = model['parts_by_path'][path]
          outgoing = model['textual_refs'][path]
          incoming = model['reverse_refs'][path]
          surfaces = behavior_surfaces(path, role)
          score = 0
          reasons: list[str] = []
      
          section_weight = {'10': 10, '20': 6, '30': 2, '40': 4, '50': 12, '60': 14, '70': 14, '80': 3, '90': 2, '95': 12, '98': 20, '99': 12}.get(section, 5)
          score += section_weight
          if section_weight >= 10:
              reasons.append(f'section-{section}-high-consequence')
      
          role_weight = {
              'policy': 1, 'identity-policy': 3, 'generated-config': 4, 'service': 5, 'timer': 2,
              'path-unit': 3, 'path-policy': 2, 'mount': 10, 'storage-policy': 9, 'swap': 12,
              'activation': 10, 'rescue': 10, 'backup-policy': 10, 'packages': 2,
              'package-policy': 2, 'generated-program': 10, 'assertion': 10,
          }.get(role, 4)
          score += role_weight
          if role_weight >= 9:
              reasons.append(f'role-{role}')
      
          if laws:
              score += min(18, 5 * len(laws))
              reasons.append(f'hard-laws={len(laws)}')
          if flows:
              score += min(12, 2 * len(flows))
              reasons.append(f'flows={len(flows)}')
          if len(parts) >= 10:
              score += min(8, len(parts) // 5)
              reasons.append(f'internal-parts={len(parts)}')
          coupling = len(outgoing | incoming)
          if coupling:
              score += min(10, coupling // 2 + 1)
              reasons.append(f'textual-neighbors={coupling}')
          line_count = int(definition['end_line']) - int(definition['start_line']) + 1
          if line_count >= 250:
              score += 5
              reasons.append(f'large-definition-lines={line_count}')
          elif line_count >= 80:
              score += 2
              reasons.append(f'medium-definition-lines={line_count}')
      
          score += min(12, 2 * len(surfaces))
          if surfaces:
              reasons.append('surfaces=' + ','.join(surfaces))
      
          critical_needles = (
              'mnx-test', 'mnx-switch', 'mnx-office', 'mnx-source-lexer', 'mnx-config-audit',
              'mnx-atlas', 'mnx-relations', 'mnx-refactor', 'mnx-exposure', 'mnx-listener-census', 'system.activationScripts', 'assertions',
              'btrbk-main', 'btrbk-archive', 'm21-btrfs', 'rsync-m16-new-to-old',
              'fileSystems."/mnt/m16-old-storage"', 'swapDevices', 'boot.loader', 'system.stateVersion',
              'hashedPassword', 'users.users.root', 'security.', 'services.openssh', 'networking.firewall',
              'permittedInsecurePackages', 'password', 'secret', 'privateKey', 'hostKey',
          )
          if any(needle in path for needle in critical_needles):
              score += 18
              reasons.append('named-critical-surface')
      
          high_consequence_needles = (
              'networking.', 'services.openssh', 'services.sshguard', 'services.eternal-terminal',
              'services.dnscrypt', 'services.bitmagnet', 'services.tor', 'services.i2p',
              'virtualisation.', 'hardware.', 'programs.firejail', 'users.', 'security.',
              'services.nfs', 'services.rpcbind', 'services.avahi',
          )
          if any(needle in path for needle in high_consequence_needles):
              score += 10
              reasons.append('high-consequence-subsystem')
      
          if score <= 7:
              risk = 'low'
          elif score <= 16:
              risk = 'moderate'
          elif score <= 29:
              risk = 'high'
          else:
              risk = 'critical'
          return {'score': score, 'risk': risk, 'reasons': reasons, 'surfaces': surfaces}
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.relation-neighbors kind=function title="Python function relation_neighbors"
      def relation_neighbors(model: dict, path: str) -> set[str]:
          neighbors: set[str] = set()
          for relation in model['flows_by_path'][path] + model['laws_by_path'][path]:
              neighbors.update(split_defs(relation.get('fields', {}).get('defs')))
          neighbors.discard(path)
          return neighbors
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.impact-record kind=function title="Python function impact_record"
      def impact_record(model: dict, definition: dict) -> dict:
          path = definition['path']
          profile = risk_profile(model, definition)
          relation_refs = relation_neighbors(model, path)
          text_out = model['textual_refs'][path]
          text_in = model['reverse_refs'][path]
          all_neighbors = sorted(relation_refs | text_out | text_in)
          return {
              'path': path,
              'ordinal': int(definition['ordinal']),
              'section': definition['section'],
              'role': definition['role'],
              'lines': [int(definition['start_line']), int(definition['end_line'])],
              'bytes': int(definition['bytes']),
              'part_count': len(model['parts_by_path'][path]),
              'risk': profile,
              'flows': [{'id': item['id'], 'kind': item['kind'], 'title': item['title']} for item in model['flows_by_path'][path]],
              'laws': [{'id': item['id'], 'severity': item['severity'], 'title': item['title']} for item in model['laws_by_path'][path]],
              'relation_neighbors': sorted(relation_refs),
              'textual_outgoing': sorted(text_out),
              'textual_incoming': sorted(text_in),
              'all_neighbors': all_neighbors,
              'behavior_manifest_surfaces': profile['surfaces'],
              'source_commands': [
                  f"mnx def {json.dumps(path)}",
                  f"mnx parts {json.dumps(path)}",
                  f"mnx related {json.dumps(path)}",
                  f"mnx refactor impact {json.dumps(path)}",
              ],
          }
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.plan-record kind=function title="Python function plan_record"
      def plan_record(model: dict, definitions: list[dict], chunk: dict | None = None) -> dict:
          impacts = [impact_record(model, item) for item in definitions]
          max_score = max((item['risk']['score'] for item in impacts), default=0)
          if max_score <= 7:
              overall = 'low'
          elif max_score <= 16:
              overall = 'moderate'
          elif max_score <= 29:
              overall = 'high'
          else:
              overall = 'critical'
          behavior_surface_detected = any(item['behavior_manifest_surfaces'] for item in impacts)
          return {
              'planner_schema': 1,
              'source': str(model['config']),
              'source_sha256': model['sha256'],
              'selection_kind': 'chunk' if chunk else 'definition',
              'chunk': chunk,
              'definition_count': len(impacts),
              'overall_risk': overall,
              'maximum_risk_score': max_score,
              'behavior_manifest_surface_detected': behavior_surface_detected,
              'behavior_contract_expectation': 'likely-diff' if behavior_surface_detected else 'unknown-not-proof-of-no-change',
              'definitions': impacts,
              'test_protocol': {
                  'first_command': 'mnx test',
                  'behavior_change_rule': 'Use --allow-behavior-change only after the ordinary test exposes a reviewed, intentional behavior-contract difference.',
                  'permanent_command': 'mnx switch only after a passing exact-candidate test',
                  'temporary_code': 'Use Section 98 only for bounded candidate-only experiments; remove or promote and retest before switching.',
              },
              'authority': 'This plan and every workspace are derived views. /etc/nixos/configuration.nix remains the only authoritative machine source.',
          }
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.render-impact kind=function title="Python function render_impact"
      def render_impact(record: dict) -> str:
          lines = [
              '################################################################################',
              '# MNX REFACTOR IMPACT',
              '################################################################################',
              f"path={record['path']}",
              f"ordinal={record['ordinal']:03d}",
              f"section={record['section']}",
              f"role={record['role']}",
              f"source_lines={record['lines'][0]}-{record['lines'][1]}",
              f"source_bytes={record['bytes']}",
              f"part_count={record['part_count']}",
              f"risk={record['risk']['risk']}",
              f"risk_score={record['risk']['score']}",
              'risk_reasons=' + (','.join(record['risk']['reasons']) or 'none'),
              'behavior_manifest_surfaces=' + (','.join(record['behavior_manifest_surfaces']) or 'none'),
              "", 'Flows:',
          ]
          lines += [f"  {item['id']} [{item['kind']}] {item['title']}" for item in record['flows']] or ['  none']
          lines += ["", 'Laws:']
          lines += [f"  {item['id']} [{item['severity']}] {item['title']}" for item in record['laws']] or ['  none']
          lines += ["", 'Related definitions:']
          lines += [f'  {item}' for item in record['all_neighbors']] or ['  none']
          lines += ["", 'Source commands:']
          lines += [f'  {item}' for item in record['source_commands']]
          lines += ["", 'MNX_REFACTOR_IMPACT=PASS']
          return '\n'.join(lines) + '\n'
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.render-plan kind=function title="Python function render_plan"
      def render_plan(record: dict) -> str:
          lines = [
              '################################################################################',
              '# MNX REFACTOR PLAN',
              '################################################################################',
              f"source={record['source']}",
              f"source_sha256={record['source_sha256']}",
              f"selection_kind={record['selection_kind']}",
              f"definition_count={record['definition_count']}",
              f"overall_risk={record['overall_risk']}",
              f"maximum_risk_score={record['maximum_risk_score']}",
              f"behavior_manifest_surface_detected={'yes' if record['behavior_manifest_surface_detected'] else 'no'}",
              f"behavior_contract_expectation={record['behavior_contract_expectation']}",
          ]
          if record['chunk']:
              lines += [f"chunk_id={record['chunk']['id']}", f"chunk_slug={record['chunk']['slug']}", f"chunk_title={record['chunk']['title']}"]
          lines += ["", 'Definitions:']
          for item in record['definitions']:
              lines.append(f"  {item['ordinal']:03d} risk={item['risk']['risk']} score={item['risk']['score']} section={item['section']} role={item['role']} path={item['path']}")
          lines += [
              "", 'Protocol:',
              '  1. Lift exact source with `mnx def`, `mnx parts`, `mnx related`, and this plan.',
              '  2. Edit only the complete authoritative configuration.nix.',
              '  3. Run plain `mnx test` first.',
              '  4. Use `--allow-behavior-change` only after reviewing an intentional contract difference.',
              '  5. Run `mnx switch` only after the exact candidate passes.',
              "", record['authority'],
              'MNX_REFACTOR_PLAN=PASS',
          ]
          return '\n'.join(lines) + '\n'
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.frontier-records kind=function title="Python function frontier_records"
      def frontier_records(model: dict, include_all: bool, section: str | None, role: str | None) -> list[dict]:
          records = []
          for definition in model['definitions']:
              if section and not definition['section'].startswith(section):
                  continue
              if role and definition['role'] != role:
                  continue
              record = impact_record(model, definition)
              if not include_all and record['risk']['risk'] in {'high', 'critical'}:
                  continue
              records.append(record)
          records.sort(key=lambda item: (item['risk']['score'], item['part_count'], item['ordinal'], item['path']))
          return records
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.write-workspace kind=function title="Python function write_workspace"
      def write_workspace(model: dict, name: str, definitions: list[dict], plan: dict, root: Path) -> Path:
          if not NAME_RE.fullmatch(name):
              raise PlannerError('workspace name must match [A-Za-z0-9][A-Za-z0-9._-]{0,63}')
          root.mkdir(parents=True, exist_ok=True)
          timestamp = dt.datetime.now().astimezone().strftime('%Y%m%dT%H%M%S%z')
          final = root / f"{name}-{timestamp}-{model['sha256'][:12]}"
          if final.exists():
              raise PlannerError(f'workspace already exists: {final}')
          temp = Path(tempfile.mkdtemp(prefix=f'.{name}.', dir=root))
          try:
              (temp / 'definitions').mkdir()
              (temp / 'parts').mkdir()
              (temp / 'configuration.nix').write_bytes(model['raw'])
              (temp / 'plan.json').write_text(canonical_json(plan), encoding='utf-8')
              (temp / 'plan.txt').write_text(render_plan(plan), encoding='utf-8')
              readme = (
                  'MNX REFACTOR WORKSPACE\n\n'
                  'This directory is a disposable, derived view. It is never an import tree and never an authoritative source.\n'
                  f"source={model['config']}\nsource_sha256={model['sha256']}\n"
                  'Edit /etc/nixos/configuration.nix as one complete file; use this workspace only for inspection and liftable slices.\n'
              )
              (temp / 'README.txt').write_text(readme, encoding='utf-8')
              definition_entries = []
              for definition in definitions:
                  path = definition['path']
                  safe = re.sub(r'[^A-Za-z0-9._-]+', '_', path).strip('_')[:120] or 'definition'
                  filename = f"{int(definition['ordinal']):03d}-{safe}.nixdef"
                  data = model['source_by_path'][path]
                  target = temp / 'definitions' / filename
                  target.write_bytes(data)
                  definition_entries.append({'path': path, 'file': f'definitions/{filename}', 'sha256': hashlib.sha256(data).hexdigest()})
                  for part in model['parts_by_path'][path]:
                      part_data = b"".join(model['lines'][int(part['marker_line']) - 1:int(part['end_line'])])
                      part_safe = re.sub(r'[^A-Za-z0-9._-]+', '_', part['part_id'])[:140]
                      part_file = f"{part_safe}.nixpart"
                      (temp / 'parts' / part_file).write_bytes(part_data)
              manifest = {
                  'workspace_schema': 1,
                  'name': name,
                  'source': str(model['config']),
                  'source_sha256': model['sha256'],
                  'authority': 'derived-non-authoritative',
                  'definitions': definition_entries,
                  'plan_sha256': hashlib.sha256((temp / 'plan.json').read_bytes()).hexdigest(),
              }
              (temp / 'manifest.json').write_text(canonical_json(manifest), encoding='utf-8')
              checksum_lines = []
              for path in sorted(item for item in temp.rglob('*') if item.is_file() and item.name != 'SHA256SUMS'):
                  checksum_lines.append(f"{hashlib.sha256(path.read_bytes()).hexdigest()}  {path.relative_to(temp)}")
              (temp / 'SHA256SUMS').write_text('\n'.join(checksum_lines) + '\n', encoding='utf-8')
              for path in temp.rglob('*'):
                  if path.is_dir():
                      path.chmod(0o750)
                  else:
                      path.chmod(0o640)
              temp.chmod(0o750)
              if os.geteuid() == 0:
                  try:
                      gid = grp.getgrnam('logbook').gr_gid
                  except KeyError:
                      gid = os.getgid()
                  for path in [temp, *temp.rglob('*')]:
                      os.chown(path, 0, gid, follow_symlinks=False)
              os.replace(temp, final)
              return final
          except Exception:
              shutil.rmtree(temp, ignore_errors=True)
              raise
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.parse-args kind=function title="Python function parse_args"
      def parse_args(command: str, argv: list[str]) -> argparse.Namespace:
          public_prefix = f'mnx {command}' if command in {'capsule', 'substrate', 'cloudtainer'} else f'mnx refactor {command}'
          parser = argparse.ArgumentParser(prog=public_prefix)
          if command == 'frontier':
              parser.add_argument('--limit', type=int, default=20)
              parser.add_argument('--all', action='store_true')
              parser.add_argument('--section')
              parser.add_argument('--role')
              parser.add_argument('--json', action='store_true')
          elif command == 'impact':
              parser.add_argument('selector')
              parser.add_argument('--json', action='store_true')
          elif command == 'plan':
              parser.add_argument('selector', nargs='?')
              parser.add_argument('--chunk')
              parser.add_argument('--json', action='store_true')
          elif command == 'workspace':
              sub = parser.add_subparsers(dest='workspace_command', required=True)
              create = sub.add_parser('create')
              create.add_argument('name')
              create.add_argument('selectors', nargs='*')
              create.add_argument('--chunk', action='append', default=[])
          elif command == 'port':
              sub = parser.add_subparsers(dest='port_command', required=True)
              review = sub.add_parser('review')
              review.add_argument('source', type=Path)
              review.add_argument('--json', action='store_true')
              review.add_argument('--full', action='store_true')
          elif command == 'capsule':
              sub = parser.add_subparsers(dest='capsule_command', required=True)
              policy = sub.add_parser('policy')
              policy.add_argument('--json', action='store_true')
              inspect = sub.add_parser('inspect')
              inspect.add_argument('source', type=Path)
              inspect.add_argument('--json', action='store_true')
              verify = sub.add_parser('verify')
              verify.add_argument('source', type=Path)
              verify.add_argument('--sha256', required=True)
              verify.add_argument('--bytes', required=True, type=int)
              verify.add_argument('--media')
              verify.add_argument('--json', action='store_true')
              sub.add_parser('self-test')
              run = sub.add_parser('run')
              run.add_argument('arguments', nargs=argparse.REMAINDER)
          elif command == 'substrate':
              sub = parser.add_subparsers(dest='substrate_command', required=True)
              for name in ['status', 'contract', 'reconstruction', 'backup-soak']:
                  item = sub.add_parser(name)
                  item.add_argument('--json', action='store_true')
              sub.add_parser('self-test')
              migrate = sub.add_parser('migrate')
              migrate.add_argument('arguments', nargs=argparse.REMAINDER)
          elif command == 'cloudtainer':
              sub = parser.add_subparsers(dest='cloudtainer_command', required=True)
              policy = sub.add_parser('policy')
              policy.add_argument('--json', action='store_true')
              status = sub.add_parser('status')
              status.add_argument('--json', action='store_true')
              workbench = sub.add_parser('workbench')
              workbench.add_argument('--json', action='store_true')
              history = sub.add_parser('history')
              history.add_argument('--json', action='store_true')
              turn_close = sub.add_parser('turn-close')
              turn_close.add_argument('--json', action='store_true')
              for field in ['authority','state','intent','open','next','hold','operator']:
                  turn_close.add_argument('--' + field)
              candidate = sub.add_parser('candidate')
              candidate.add_argument('arguments', nargs=argparse.REMAINDER)
              pack = sub.add_parser('pack')
              pack.add_argument('--json', action='store_true')
              pack.add_argument('--output', type=Path)
              pack.add_argument('--replace', action='store_true')
              sub.add_parser('self-test')
          elif command == 'self-test':
              pass
          else:
              raise PlannerError(f'unsupported planner command: {command}')
          return parser.parse_args(argv)
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.self-test kind=function title="Python function self_test"
      def self_test() -> int:
          with tempfile.TemporaryDirectory(prefix='mnx-refactor-planner.') as directory:
              root = Path(directory)
              config = root / 'configuration.nix'
              config.write_text('# marker\nfoo = true;\n# marker\nbar = false;\n', encoding='utf-8')
              atlas = {
                  'source_sha256': hashlib.sha256(config.read_bytes()).hexdigest(), 'exact_byte_identity': True,
                  'definitions': [
                      {'path': 'foo', 'ordinal': 1, 'section': '30.00', 'role': 'policy', 'marker_line': 1, 'start_line': 2, 'end_line': 2, 'bytes': 12},
                      {'path': 'bar', 'ordinal': 2, 'section': '40.00', 'role': 'policy', 'marker_line': 3, 'start_line': 4, 'end_line': 4, 'bytes': 13},
                  ],
                  'chunks': [
                      {'id': '30.00', 'slug': 'foo', 'title': 'Foo', 'marker_line': 1, 'end_line': 2},
                      {'id': '40.00', 'slug': 'bar', 'title': 'Bar', 'marker_line': 3, 'end_line': 4},
                  ],
                  'parts': [],
              }
              relations = {
                  'source_sha256': atlas['source_sha256'], 'exact_byte_identity': True,
                  'flows': [{'id': 'sample', 'kind': 'test', 'title': 'Sample', 'fields': {'defs': 'foo,bar'}}],
                  'laws': [],
              }
              model = build_model(config, atlas, relations)
              if not (resolve_definition(model, 'foo')['path'] == 'foo'):
                  raise PlannerError('explicit proof condition failed near planner line 4677')
              if not (resolve_definition(model, '2')['path'] == 'bar'):
                  raise PlannerError('explicit proof condition failed near planner line 4678')
              if not (resolve_chunk(model, '30.00')['slug'] == 'foo'):
                  raise PlannerError('explicit proof condition failed near planner line 4679')
              impact = impact_record(model, model['by_path']['foo'])
              if not ('bar' in impact['relation_neighbors']):
                  raise PlannerError('explicit proof condition failed near planner line 4681')
              plan = plan_record(model, [model['by_path']['foo']])
              workspace = write_workspace(model, 'probe', [model['by_path']['foo']], plan, root / 'workspaces')
              if not ((workspace / 'SHA256SUMS').is_file()):
                  raise PlannerError('explicit proof condition failed near planner line 4684')
              if not ((workspace / 'definitions').is_dir()):
                  raise PlannerError('explicit proof condition failed near planner line 4685')
              port_review_self_test(root)
              capsule_self_test(root)
              substrate_self_test(root)
              cloudtainer_self_test(root)
          print('MNX_REFACTOR_PLANNER_SELF_TEST=PASS')
          return 0
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.main kind=function title="Python function main"
      def main(argv: list[str]) -> int:
          if len(argv) < 2:
              raise PlannerError('usage: PLANNER CONFIG COMMAND [ARGS...]')
          config = Path(argv[0])
          command = argv[1]
          args = parse_args(command, argv[2:])
          if command == 'self-test':
              return self_test()
          if command == 'port':
              if args.port_command != 'review':
                  raise PlannerError(f"unsupported port command: {args.port_command}")
              record = port_review_record(config, args.source)
              if args.json:
                  print(canonical_json(record), end="")
              else:
                  print(render_port_review(record, full=args.full), end="")
              return 0
          if command == 'capsule':
              if args.capsule_command == 'policy':
                  record = capsule_policy_record()
                  print(canonical_json(record) if args.json else render_capsule_record(record), end="")
                  return 0
              if args.capsule_command == 'inspect':
                  record = capsule_inspect_record(args.source)
                  print(canonical_json(record) if args.json else render_capsule_record(record), end="")
                  return 0
              if args.capsule_command == 'verify':
                  record = capsule_verify_record(args.source, args.sha256, args.bytes, args.media)
                  print(canonical_json(record) if args.json else render_capsule_record(record), end="")
                  return 0 if record['status'] == 'pass' else 1
              if args.capsule_command == 'self-test':
                  with tempfile.TemporaryDirectory(prefix='mnx-capsule-self-test.') as directory:
                      capsule_self_test(Path(directory))
                  return 0
              if args.capsule_command == 'run':
                  print('MNX_CAPSULE_RUN_REFUSED: execution is unavailable until a reviewed sandbox and receipt contract is accepted', file=sys.stderr)
                  return 69
              raise PlannerError(f"unsupported capsule command: {args.capsule_command}")
          if command == 'cloudtainer':
              if args.cloudtainer_command == 'policy':
                  record = cloudtainer_policy_record()
                  print(canonical_json(record) if args.json else canonical_json(record), end="")
                  if not args.json:
                      print('MNX_CLOUDTAINER_POLICY=PASS')
                  return 0
              if args.cloudtainer_command == 'status':
                  record = cloudtainer_status_record(config)
                  print(canonical_json(record) if args.json else cloudtainer_render_status(record), end="")
                  return 0
              if args.cloudtainer_command == 'workbench':
                  record = cloudtainer_workbench_record(config)
                  print(canonical_json(record) if args.json else cloudtainer_render_workbench(record), end="")
                  return 0
              if args.cloudtainer_command == 'history':
                  source = read_port_source(config)
                  record = cloudtainer_extract_history(source['text'])
                  print(canonical_json(record) if args.json else cloudtainer_render_history(record), end="")
                  if not args.json:
                      print('MNX_CLOUDTAINER_HISTORY=PASS')
                  return 0
              if args.cloudtainer_command == 'turn-close':
                  overrides = {key.upper(): getattr(args, key) for key in ['authority','state','intent','open','next','hold','operator'] if getattr(args, key)}
                  record = cloudtainer_turn_close_record(config, overrides)
                  print(canonical_json(record) if args.json else cloudtainer_render_turn_close(record), end="")
                  return 0
              if args.cloudtainer_command == 'candidate':
                  return cloudtainer_run_portable_candidate(config, args.arguments)
              if args.cloudtainer_command == 'pack':
                  if os.geteuid() != 0:
                      raise PlannerError('mnx cloudtainer pack requires root or the source-owned sudo route')
                  record = cloudtainer_pack_record(config, args.output, args.replace)
                  print(canonical_json(record) if args.json else cloudtainer_render_pack(record), end="")
                  return 0
              if args.cloudtainer_command == 'self-test':
                  with tempfile.TemporaryDirectory(prefix='mnx-cloudtainer-self-test.') as directory:
                      cloudtainer_self_test(Path(directory))
                  return 0
              raise PlannerError(f"unsupported cloudtainer command: {args.cloudtainer_command}")
          if command == 'substrate':
              if args.substrate_command == 'contract':
                  record = substrate_contract_record(config)
                  print(canonical_json(record) if args.json else render_substrate_record(record), end="")
                  return 0
              if args.substrate_command == 'status':
                  record = substrate_status_record(config)
                  print(canonical_json(record) if args.json else render_substrate_record(record), end="")
                  return 0
              if args.substrate_command == 'reconstruction':
                  record = substrate_reconstruction_record(config)
                  print(canonical_json(record) if args.json else render_substrate_record(record), end="")
                  return 0
              if args.substrate_command == 'backup-soak':
                  record = backup_soak_review_record(config)
                  print(canonical_json(record) if args.json else render_substrate_record(record), end="")
                  return 0
              if args.substrate_command == 'self-test':
                  with tempfile.TemporaryDirectory(prefix='mnx-substrate-self-test.') as directory:
                      substrate_self_test(Path(directory))
                  return 0
              if args.substrate_command == 'migrate':
                  print('MNX_SUBSTRATE_MIGRATION_REFUSED: no alternate substrate adapter or migration witness is accepted', file=sys.stderr)
                  return 69
              raise PlannerError(f"unsupported substrate command: {args.substrate_command}")
          atlas_command = Path(os.environ.get('MNX_ATLAS_COMMAND', str(ATLAS_DEFAULT)))
          relations_command = Path(os.environ.get('MNX_RELATIONS_COMMAND', str(RELATIONS_DEFAULT)))
          atlas, relations = load_manifests(config, atlas_command, relations_command)
          model = build_model(config, atlas, relations)
      
          if command == 'frontier':
              records = frontier_records(model, args.all, args.section, args.role)
              limit = max(1, min(args.limit, 262))
              records = records[:limit]
              if args.json:
                  print(canonical_json({'planner_schema': 1, 'source_sha256': model['sha256'], 'records': records}), end="")
              else:
                  print('################################################################################')
                  print('# MNX REFACTOR FRONTIER — LOWEST COUPLING FIRST')
                  print('################################################################################')
                  print(f"source_sha256={model['sha256']}")
                  print(f"record_count={len(records)}")
                  print('risk_model=heuristic-not-permission')
                  for item in records:
                      print(f"{item['ordinal']:03d}\trisk={item['risk']['risk']}\tscore={item['risk']['score']}\tsection={item['section']}\trole={item['role']}\tparts={item['part_count']}\tneighbors={len(item['all_neighbors'])}\t{item['path']}")
                  print('MNX_REFACTOR_FRONTIER=PASS')
              return 0
          if command == 'impact':
              record = impact_record(model, resolve_definition(model, args.selector))
              if args.json:
                  print(canonical_json(record), end="")
              else:
                  print(render_impact(record), end="")
              return 0
          if command == 'plan':
              if bool(args.selector) == bool(args.chunk):
                  raise PlannerError('provide exactly one definition selector or --chunk CHUNK')
              if args.chunk:
                  chunk = resolve_chunk(model, args.chunk)
                  definitions = list(model['definitions_by_section'].get(chunk['id'], []))
                  if not definitions:
                      raise PlannerError(f"chunk {chunk['id']} contains no active definitions")
              else:
                  chunk = None
                  definitions = [resolve_definition(model, args.selector)]
              record = plan_record(model, definitions, chunk)
              if args.json:
                  print(canonical_json(record), end="")
              else:
                  print(render_plan(record), end="")
              return 0
          if command == 'workspace':
              selected: dict[str, dict] = {}
              for selector in args.selectors:
                  item = resolve_definition(model, selector)
                  selected[item['path']] = item
              for chunk_selector in args.chunk:
                  chunk = resolve_chunk(model, chunk_selector)
                  for item in model['definitions_by_section'].get(chunk['id'], []):
                      selected[item['path']] = item
              if not selected:
                  raise PlannerError('workspace create requires at least one definition selector or --chunk')
              definitions = sorted(selected.values(), key=lambda item: int(item['ordinal']))
              plan = plan_record(model, definitions)
              workspace = write_workspace(model, args.name, definitions, plan, Path('/var/lib/logbook/support/refactor-workspaces'))
              print(f'workspace={workspace}')
              print(f'source_sha256={model["sha256"]}')
              print(f'definition_count={len(definitions)}')
              print('workspace_authority=derived-non-authoritative')
              print('MNX_REFACTOR_WORKSPACE=PASS')
              return 0
          raise PlannerError(f'unsupported command: {command}')
      
      
      if __name__ == '__main__':
          try:
              raise SystemExit(main(sys.argv[1:]))
          except PlannerError as exc:
              print(f'MNX_REFACTOR_PLANNER_ERROR: {exc}', file=sys.stderr)
              raise SystemExit(1)
      PY
      }

      case "$COMMAND" in
        frontier|impact|plan|port|capsule|substrate|self-test)
          planner "$@"
