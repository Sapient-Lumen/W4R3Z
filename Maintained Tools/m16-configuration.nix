                  start = tokens[path_start]
                  raise AtlasError(f"top-level assignment {path} from {start.line}:{start.column} has no terminating semicolon")
              terminator = tokens[terminator_index]
              assignments.append(
                  Assignment(
                      path=path,
                      start=tokens[path_start].start,
                      end=terminator.end,
                      start_line=tokens[path_start].line,
                      end_line=terminator.line,
                      terminator=terminator.start,
                  )
