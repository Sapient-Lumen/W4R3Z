      #@MNX-PART id=99.55.mnx-atlas.function.matching-delimiters kind=function title="Python function matching_delimiters"
      def matching_delimiters(tokens: Sequence[Token]) -> dict[int, int]:
          stack: list[tuple[str, int]] = []
          pairs = {"}": "{", "]": "[", ")": "("}
          matching: dict[int, int] = {}
          for index, token in enumerate(tokens):
              if token.raw in "{[(":
                  stack.append((token.raw, index))
              elif token.raw in "}])":
                  if not stack or stack[-1][0] != pairs[token.raw]:
                      raise AtlasError(f"mismatched delimiter {token.raw!r} at {token.line}:{token.column}")
                  _, opening_index = stack.pop()
                  matching[opening_index] = index
                  matching[index] = opening_index
          if stack:
              token, index = stack[-1]
              location = tokens[index]
              raise AtlasError(f"unclosed delimiter {token!r} from {location.line}:{location.column}")
          return matching
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.top-level-depths kind=function title="Python function top_level_depths"
      def top_level_depths(tokens: Sequence[Token]) -> list[int]:
          depths: list[int] = []
          depth = 0
          for token in tokens:
              depths.append(depth)
              if token.raw in "{[(":
                  depth += 1
              elif token.raw in "}])":
                  depth -= 1
          return depths
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.find-module-body kind=function title="Python function find_module_body"
      def find_module_body(tokens: Sequence[Token], matching: dict[int, int]) -> tuple[int, int]:
          if not tokens or tokens[0].raw != "{":
              raise AtlasError("outer module argument set is absent")
          argument_close = matching.get(0)
          if argument_close is None:
              raise AtlasError("outer module argument set has no matching close")
          colon = argument_close + 1
          if colon >= len(tokens) or tokens[colon].raw != ":":
              where = tokens[argument_close]
              raise AtlasError(f"outer module function colon is absent after {where.line}:{where.column}")
          expression = colon + 1
          if expression >= len(tokens):
              raise AtlasError("outer module function has no body expression")
          if tokens[expression].raw == "{":
              root_open = expression
          elif tokens[expression].raw == "let":
              bracket_depth = 0
              let_depth = 0
              root_open = -1
              for index in range(expression, len(tokens)):
                  raw = tokens[index].raw
                  if raw in "{[(":
                      bracket_depth += 1
                      continue
                  if raw in "}])":
                      bracket_depth -= 1
                      if bracket_depth < 0:
                          raise AtlasError("outer let envelope delimiter depth became negative")
                      continue
                  if bracket_depth != 0:
                      continue
                  if raw == "let":
                      let_depth += 1
                  elif raw == "in":
                      let_depth -= 1
                      if let_depth == 0:
                          root_open = index + 1
                          break
                      if let_depth < 0:
                          raise AtlasError("outer let envelope has an orphan in token")
              if root_open < 0:
                  raise AtlasError("outer let envelope has no matching in token")
              if root_open >= len(tokens) or tokens[root_open].raw != "{":
                  where = tokens[root_open - 1]
                  raise AtlasError(f"outer let envelope does not yield an attribute set after {where.line}:{where.column}")
          else:
              where = tokens[expression]
              raise AtlasError(f"module body is neither a direct attribute set nor a scoped let envelope at {where.line}:{where.column}")
          root_close = matching.get(root_open)
          if root_close is None:
              raise AtlasError("module body opening brace has no matching close")
          if root_close != len(tokens) - 1:
              trailing = tokens[root_close + 1]
              raise AtlasError(f"active Nix tokens follow the module body at {trailing.line}:{trailing.column}")
          return root_open, root_close
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.canonical-attr-path kind=function title="Python function canonical_attr_path"
      def canonical_attr_path(tokens: Sequence[Token], start: int, stop: int) -> str:
          if start >= stop:
              raise AtlasError("empty attribute path")
          parts: list[str] = []
          index = start
          expect_segment = True
          while index < stop:
              token = tokens[index]
              if expect_segment:
                  if token.kind == "IDENT":
                      parts.append(token.raw)
                  elif token.kind == "STRING" and not token.interpolated:
                      parts.append(token.raw)
                  else:
                      raise AtlasError(f"unsupported attribute-path segment {token.raw!r} at {token.line}:{token.column}")
                  expect_segment = False
              else:
                  if token.raw != ".":
                      raise AtlasError(f"expected '.' in attribute path at {token.line}:{token.column}")
                  parts.append(".")
                  expect_segment = True
              index += 1
          if expect_segment:
              token = tokens[stop - 1]
              raise AtlasError(f"attribute path ends with '.' at {token.line}:{token.column}")
          return "".join(parts)
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.parse-assignments kind=function title="Python function parse_assignments"
      def parse_assignments(tokens: Sequence[Token], matching: dict[int, int], root_open: int, root_close: int) -> list[Assignment]:
          assignments: list[Assignment] = []
          index = root_open + 1
          while index < root_close:
              first = tokens[index]
              if first.kind == "IDENT" and first.raw == "inherit":
                  raise AtlasError(f"top-level inherit is unsupported by the definition atlas at {first.line}:{first.column}")
