                  print(f"mnxcrypt-pinentry: {exc}", file=sys.stderr)
                  return 1
          if argv not in ([], ["--"]):
              print("usage: mnxcrypt-pinentry [--] | --self-test | --check-program", file=sys.stderr)
              return 64

          password = bytearray()
          prompt_lock_fd = -1
          try:
              require_secret_pipe()
              prompt_lock_fd = acquire_prompt_lock()
              pause_presslog_for_prompt()
              password = request_password(resolve_pinentry())
              sys.stdout.buffer.write(password)
              sys.stdout.buffer.write(b"\n")
              sys.stdout.buffer.flush()
              return 0
          except (OSError, PinentryError, subprocess.SubprocessError) as exc:
              print(f"mnxcrypt-pinentry: {exc}", file=sys.stderr)
              return 1
          finally:
              for index in range(len(password)):
                  password[index] = 0
              if prompt_lock_fd >= 0:
                  release_prompt_lock(prompt_lock_fd)


      if __name__ == "__main__":
          raise SystemExit(main(sys.argv[1:]))
      '';
      checkPhase = ''
        set -Eeuo pipefail
        ${pkgs.python3}/bin/python3 -m py_compile "$out"
        self_out="$(${pkgs.coreutils}/bin/mktemp)"
        trap '${pkgs.coreutils}/bin/rm -f "$self_out"' EXIT
        "$out" --self-test >"$self_out"
        ${pkgs.gnugrep}/bin/grep -Fx 'MNXCRYPT_PINENTRY_SELF_TEST=PASS' "$self_out"
        ${pkgs.gnugrep}/bin/grep -Fx 'MNXCRYPT_PINENTRY_PIPE_POLICY_SELF_TEST=PASS' "$self_out"
        ${pkgs.gnugrep}/bin/grep -Fx 'MNXCRYPT_PINENTRY_ENVIRONMENT_POLICY_SELF_TEST=PASS' "$self_out"
        ${pkgs.gnugrep}/bin/grep -Fx 'MNXCRYPT_SECRET_PROMPT_GUARD_SELF_TEST=PASS' "$self_out"
        ${pkgs.gnugrep}/bin/grep -Fq -- 'b"GETPIN"' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'stat.S_ISFIFO' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'pinentry_environment' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'fcntl.LOCK_EX' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'PRESSLOG_PROMPT_GUARD=PASS' "$out"
        ! ${pkgs.gnugrep}/bin/grep -Fq 'os.environ.copy()' "$out"
      '';
    };
    mode = "0755";
  };
#@MNX-DEF path=environment.etc."monsternix/bin/mnxcrypt" section=99.87 role=generated-program ordinal=283
  environment.etc."monsternix/bin/mnxcrypt" = {
    source = pkgs.writeTextFile {
      name = "mnxcrypt";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      set -Eeuo pipefail
      IFS=$'\n\t'
      umask 077

      PROGRAM=''${0##*/}
      READLINK_BOOTSTRAP=''${MNXCRYPT_READLINK:-${pkgs.coreutils}/bin/readlink}
      SELF=$($READLINK_BOOTSTRAP -f -- "$0" 2>/dev/null || printf '%s' "$0")
      DIRNAME_BOOTSTRAP=''${MNXCRYPT_DIRNAME:-${pkgs.coreutils}/bin/dirname}
      SELF_DIR=$(cd -- "$($DIRNAME_BOOTSTRAP -- "$SELF")" && pwd -P)

      # Nix derivation and root activation probes may intentionally omit HOME. Keep
      # nonmutating help/policy/self-test startup total without borrowing operator
      # paths; real vault commands below still require normal HOME or both explicit
      # path variables. /var/empty is never accepted as implicit operator storage.
      HOME_WAS_SET=1
      if [[ -z ''${HOME+x} || -z ''${HOME} ]]; then
        HOME_WAS_SET=0
        HOME=/var/empty
      fi

      # Vault selection. The defaults are a convenience profile; the three public
      # MNXCRYPT_* path variables are the supported per-invocation interface for a
      # specific gocryptfs vault. They are intentionally usable in one rofi command.
      VAULT_ID=''${MNXCRYPT_VAULT_ID:-private-files}
      CIPHER_DIR=''${MNXCRYPT_CIPHER_DIR:-"$HOME/.local/share/mnxcrypt/''${VAULT_ID}.cipher"}
      MOUNT_DIR=''${MNXCRYPT_MOUNT_DIR:-"$HOME/''${VAULT_ID}"}
      FSNAME=''${MNXCRYPT_FSNAME:-"mnxcrypt-''${VAULT_ID}"}
      ASKPASS=''${MNXCRYPT_ASKPASS:-"/etc/monsternix/bin/mnxcrypt-pinentry"}
      # `open` has no implicit application. The operator-supplied command is the
      # exact lifetime authority whose transient cgroup keeps the plaintext view open.
      CLEANUP_RETRY_SECONDS=''${MNXCRYPT_CLEANUP_RETRY_SECONDS:-5}
      # Zero means retry indefinitely. A busy normal unmount is safer than a forced one.
      CLEANUP_MAX_SECONDS=''${MNXCRYPT_CLEANUP_MAX_SECONDS:-0}
      SESSION_POLL_SECONDS=''${MNXCRYPT_SESSION_POLL_SECONDS:-1}

      GOCRYPTFS=''${MNXCRYPT_GOCRYPTFS:-${pkgs.gocryptfs}/bin/gocryptfs}
      FUSERMOUNT=''${MNXCRYPT_FUSERMOUNT:-/run/wrappers/bin/fusermount3}
      FINDMNT=''${MNXCRYPT_FINDMNT:-${pkgs.util-linux}/bin/findmnt}
      FLOCK=''${MNXCRYPT_FLOCK:-${pkgs.util-linux}/bin/flock}
      INSTALL=''${MNXCRYPT_INSTALL:-${pkgs.coreutils}/bin/install}
      STAT=''${MNXCRYPT_STAT:-${pkgs.coreutils}/bin/stat}
      READLINK=''${MNXCRYPT_READLINK:-${pkgs.coreutils}/bin/readlink}
      DIRNAME=''${MNXCRYPT_DIRNAME:-${pkgs.coreutils}/bin/dirname}
      CHMOD=''${MNXCRYPT_CHMOD:-${pkgs.coreutils}/bin/chmod}
      RM=''${MNXCRYPT_RM:-${pkgs.coreutils}/bin/rm}
      MKDIR=''${MNXCRYPT_MKDIR:-${pkgs.coreutils}/bin/mkdir}
      MV=''${MNXCRYPT_MV:-${pkgs.coreutils}/bin/mv}
      SYNC=''${MNXCRYPT_SYNC:-${pkgs.coreutils}/bin/sync}
      CAT=''${MNXCRYPT_CAT:-${pkgs.coreutils}/bin/cat}
      SYSTEMCTL=''${MNXCRYPT_SYSTEMCTL:-${pkgs.systemd}/bin/systemctl}
      SYSTEMD_RUN=''${MNXCRYPT_SYSTEMD_RUN:-${pkgs.systemd}/bin/systemd-run}
      NOTIFY_SEND=''${MNXCRYPT_NOTIFY_SEND:-${pkgs.libnotify}/bin/notify-send}
      SIRIKALI=''${MNXCRYPT_SIRIKALI:-${pkgs.sirikali}/bin/sirikali}
      DATE=''${MNXCRYPT_DATE:-${pkgs.coreutils}/bin/date}
      SLEEP=''${MNXCRYPT_SLEEP:-${pkgs.coreutils}/bin/sleep}

      RUNTIME_PARENT=''${XDG_RUNTIME_DIR:-/run/user/$UID}
      RUNTIME_ROOT=''${MNXCRYPT_RUNTIME_ROOT:-"$RUNTIME_PARENT/mnxcrypt"}
      LOCK_FILE="$RUNTIME_ROOT/''${VAULT_ID}.lock"
      LEASE_FILE="$RUNTIME_ROOT/''${VAULT_ID}.leases"
      OWNER_FILE="$RUNTIME_ROOT/''${VAULT_ID}.owner"
      CONTROL_SOCKET="$RUNTIME_ROOT/''${VAULT_ID}.socket"
      SESSION_PREFIX="mnxcrypt-''${VAULT_ID}-session-"
      CLEANUP_UNIT="mnxcrypt-''${VAULT_ID}-cleanup"
      LOCK_FD=
      LEASE_FD=
      EXCLUSIVE_LEASE_FD=

      MOUNT_ID=
      MOUNT_TARGET=
      MOUNT_FSTYPE=
      MOUNT_SOURCE=
      MOUNT_OPTIONS=
      OPEN_MOUNT_OWNERSHIP=

      #@MNX-PART id=99.87.mnxcrypt.function.die kind=function title="Bash function die"
      die() {
        local message=$1 code=''${2:-1}
        printf '%s: %s\n' "$PROGRAM" "$message" >&2
        exit "$code"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.log kind=function title="Bash function log"
      log() {
        printf '%s: %s\n' "$PROGRAM" "$*" >&2
      }

      #@MNX-PART id=99.87.mnxcrypt.function.resolve-tool kind=function title="Bash function resolve_tool"
      resolve_tool() {
        local variable_name=$1 value=''${!1}
        if [[ $value != */* ]]; then
          value=$(command -v -- "$value") || die "required command is unavailable: ''${!variable_name}" 127
        fi
        [[ -x $value ]] || die "required command is not executable: $value" 126
        printf -v "$variable_name" '%s' "$value"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.validate-settings kind=function title="Bash function validate_settings"
      validate_settings() {
        [[ $EUID -ne 0 || ''${MNXCRYPT_ALLOW_ROOT_FOR_TESTS:-0} == 1 ]] || \
          die 'refusing to run as root; this vault is a rootless user FUSE mount' 77
        [[ $VAULT_ID =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || die "invalid vault id: $VAULT_ID" 64
        [[ $FSNAME =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid filesystem name: $FSNAME" 64
        [[ $CLEANUP_RETRY_SECONDS =~ ^[1-9][0-9]*$ ]] || die 'cleanup retry seconds must be a positive integer' 64
        [[ $CLEANUP_MAX_SECONDS =~ ^[0-9]+$ ]] || die 'cleanup maximum seconds must be zero (unbounded) or a positive integer' 64
        [[ $SESSION_POLL_SECONDS =~ ^[1-9][0-9]*$ ]] || die 'session poll seconds must be a positive integer' 64
        [[ $CIPHER_DIR == /* && $MOUNT_DIR == /* && $RUNTIME_ROOT == /* ]] || \
          die 'cipher, mount, and runtime paths must be absolute' 64
        [[ $CIPHER_DIR != *$'\n'* && $CIPHER_DIR != *$'\r'* && $CIPHER_DIR != *$'\t'* ]] || \
          die 'cipher path contains a prohibited control character' 64
        [[ $MOUNT_DIR != *$'\n'* && $MOUNT_DIR != *$'\r'* && $MOUNT_DIR != *$'\t'* ]] || \
          die 'mount path contains a prohibited control character' 64
        [[ $RUNTIME_ROOT != *$'\n'* && $RUNTIME_ROOT != *$'\r'* && $RUNTIME_ROOT != *$'\t'* ]] || \
          die 'runtime path contains a prohibited control character' 64
      }

      #@MNX-PART id=99.87.mnxcrypt.function.resolve-common-tools kind=function title="Bash function resolve_common_tools"
      resolve_common_tools() {
        local tool
        for tool in FINDMNT FLOCK INSTALL STAT READLINK DIRNAME CHMOD RM MKDIR MV SYNC CAT SYSTEMCTL SYSTEMD_RUN DATE SLEEP; do
          resolve_tool "$tool"
        done
      }

      #@MNX-PART id=99.87.mnxcrypt.function.validate-runtime-object kind=function title="Bash function validate_runtime_object"
      validate_runtime_object() {
        local path=$1 label=$2 uid mode
        [[ ! -L $path ]] || die "$label is a symlink: $path" 77
        [[ -e $path ]] || return 0
        [[ -f $path ]] || die "$label is not a regular file: $path" 77
        uid=$($STAT -c %u -- "$path") || die "$label metadata is unreadable: $path" 77
        mode=$($STAT -c %a -- "$path") || die "$label mode is unreadable: $path" 77
        [[ $uid == "$UID" ]] || die "$label is not owned by uid $UID: $path" 77
        [[ $mode == 600 ]] || die "$label has unsafe mode $mode (expected 600): $path" 77
      }

      #@MNX-PART id=99.87.mnxcrypt.function.ensure-runtime kind=function title="Bash function ensure_runtime"
      ensure_runtime() {
        [[ ! -L $RUNTIME_ROOT ]] || die "runtime directory is a symlink: $RUNTIME_ROOT" 77
        "$INSTALL" -d -m 0700 -- "$RUNTIME_ROOT"
        local uid mode
        uid=$($STAT -c %u -- "$RUNTIME_ROOT")
        mode=$($STAT -c %a -- "$RUNTIME_ROOT")
        [[ $uid == "$UID" ]] || die "runtime directory is not owned by uid $UID: $RUNTIME_ROOT" 77
        [[ $mode == 700 ]] || "$CHMOD" 0700 -- "$RUNTIME_ROOT"
        validate_runtime_object "$LOCK_FILE" 'runtime lock file'
        validate_runtime_object "$LEASE_FILE" 'runtime lease file'
        validate_runtime_object "$OWNER_FILE" 'runtime owner file'
        [[ ! -L $CONTROL_SOCKET ]] || die "runtime control socket is a symlink: $CONTROL_SOCKET" 77
        if [[ -e $CONTROL_SOCKET ]]; then
          [[ -S $CONTROL_SOCKET ]] || die "runtime control-socket path is not a socket: $CONTROL_SOCKET" 77
          uid=$($STAT -c %u -- "$CONTROL_SOCKET") || die "runtime control-socket metadata is unreadable: $CONTROL_SOCKET" 77
          [[ $uid == "$UID" ]] || die "runtime control socket is not owned by uid $UID: $CONTROL_SOCKET" 77
        fi
      }

      #@MNX-PART id=99.87.mnxcrypt.function.lock kind=function title="Bash function lock"
      lock() {
        if [[ -z ''${LOCK_FD-} ]]; then
          exec {LOCK_FD}>"$LOCK_FILE"
        fi
        "$FLOCK" "$LOCK_FD"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.unlock kind=function title="Bash function unlock"
      unlock() {
        [[ -n ''${LOCK_FD-} ]] || return 0
        "$FLOCK" -u "$LOCK_FD"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.acquire-open-lease kind=function title="Bash function acquire_open_lease"
      acquire_open_lease() {
        [[ -z ''${LEASE_FD-} ]] || return 0
        exec {LEASE_FD}<>"$LEASE_FILE"
        "$FLOCK" -s "$LEASE_FD"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.release-open-lease kind=function title="Bash function release_open_lease"
      release_open_lease() {
        [[ -n ''${LEASE_FD-} ]] || return 0
        "$FLOCK" -u "$LEASE_FD" || true
        exec {LEASE_FD}>&-
        LEASE_FD=
      }

      #@MNX-PART id=99.87.mnxcrypt.function.try-exclusive-lease kind=function title="Bash function try_exclusive_lease"
      try_exclusive_lease() {
        [[ -z ''${EXCLUSIVE_LEASE_FD-} ]] || return 0
        exec {EXCLUSIVE_LEASE_FD}<>"$LEASE_FILE"
        if ! "$FLOCK" -n "$EXCLUSIVE_LEASE_FD"; then
          exec {EXCLUSIVE_LEASE_FD}>&-
          EXCLUSIVE_LEASE_FD=
          return 1
        fi
      }

      #@MNX-PART id=99.87.mnxcrypt.function.release-exclusive-lease kind=function title="Bash function release_exclusive_lease"
      release_exclusive_lease() {
        [[ -n ''${EXCLUSIVE_LEASE_FD-} ]] || return 0
        "$FLOCK" -u "$EXCLUSIVE_LEASE_FD" || true
        exec {EXCLUSIVE_LEASE_FD}>&-
        EXCLUSIVE_LEASE_FD=
      }

      #@MNX-PART id=99.87.mnxcrypt.function.notify kind=function title="Bash function notify"
      notify() {
        local urgency=$1 title=$2 body=$3 command_path=$NOTIFY_SEND
        if [[ $command_path != */* ]]; then command_path=$(command -v -- "$command_path" 2>/dev/null || true); fi
        if [[ -n $command_path && -x $command_path ]]; then
          "$command_path" -u "$urgency" -- "$title" "$body" >/dev/null 2>&1 || true
        fi
      }

      #@MNX-PART id=99.87.mnxcrypt.function.canonical-path kind=function title="Bash function canonical_path"
      canonical_path() {
        "$READLINK" -f -- "$1"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.directory-empty kind=function title="Bash function directory_empty"
      directory_empty() {
        local directory=$1 had_nullglob=0 had_dotglob=0
        shopt -q nullglob && had_nullglob=1
        shopt -q dotglob && had_dotglob=1
        shopt -s nullglob dotglob
        local -a entries=( "$directory"/* )
        (( had_nullglob == 1 )) || shopt -u nullglob
        (( had_dotglob == 1 )) || shopt -u dotglob
        (( ''${#entries[@]} == 0 ))
      }

      #@MNX-PART id=99.87.mnxcrypt.function.validate-private-directory kind=function title="Bash function validate_private_directory"
      validate_private_directory() {
        local path=$1 label=$2 uid mode
        [[ ! -L $path ]] || die "$label is a symlink: $path" 77
        [[ -d $path ]] || die "$label is not a directory: $path" 77
        uid=$($STAT -c %u -- "$path") || die "$label owner is unreadable: $path" 77
        mode=$($STAT -c %a -- "$path") || die "$label mode is unreadable: $path" 77
        [[ $uid == "$UID" ]] || die "$label is not owned by uid $UID: $path" 77
        [[ $mode == 700 ]] || "$CHMOD" 0700 -- "$path"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.prepare-new-cipher-directory kind=function title="Bash function prepare_new_cipher_directory"
      prepare_new_cipher_directory() {
        [[ ! -L $CIPHER_DIR ]] || die "encrypted directory is a symlink: $CIPHER_DIR" 77
        [[ ! -e $CIPHER_DIR || -d $CIPHER_DIR ]] || die "encrypted path is not a directory: $CIPHER_DIR" 66
        if [[ ! -e $CIPHER_DIR ]]; then
          "$MKDIR" -p -- "$CIPHER_DIR"
        fi
        validate_private_directory "$CIPHER_DIR" 'encrypted directory'
        directory_empty "$CIPHER_DIR" || die "refusing to initialize a nonempty encrypted directory: $CIPHER_DIR" 73
      }

      #@MNX-PART id=99.87.mnxcrypt.function.validate-created-cipher-directory kind=function title="Bash function validate_created_cipher_directory"
      validate_created_cipher_directory() {
        local path uid
        validate_cipher_directory
        for path in "$CIPHER_DIR/gocryptfs.conf" "$CIPHER_DIR/gocryptfs.diriv"; do
          [[ -f $path && ! -L $path ]] || return 1
          uid=$($STAT -c %u -- "$path") || return 1
          [[ $uid == "$UID" ]] || return 1
        done
      }

      #@MNX-PART id=99.87.mnxcrypt.function.prepare-mountpoint kind=function title="Bash function prepare_mountpoint"
      prepare_mountpoint() {
        [[ ! -L $MOUNT_DIR ]] || die "mountpoint is a symlink: $MOUNT_DIR" 77
        [[ ! -e $MOUNT_DIR || -d $MOUNT_DIR ]] || die "mountpoint is not a directory: $MOUNT_DIR" 77
        "$INSTALL" -d -m 0700 -- "$MOUNT_DIR"
        validate_private_directory "$MOUNT_DIR" 'mountpoint'
      }

      #@MNX-PART id=99.87.mnxcrypt.function.validate-cipher-directory kind=function title="Bash function validate_cipher_directory"
      validate_cipher_directory() {
        [[ -e $CIPHER_DIR ]] || die "encrypted directory does not exist: $CIPHER_DIR" 66
        [[ -d $CIPHER_DIR ]] || die "encrypted path is not a directory: $CIPHER_DIR" 66
        [[ -f $CIPHER_DIR/gocryptfs.conf && ! -L $CIPHER_DIR/gocryptfs.conf ]] || \
          die "regular gocryptfs.conf is missing: $CIPHER_DIR" 66
      }

      #@MNX-PART id=99.87.mnxcrypt.function.validate-path-relationship kind=function title="Bash function validate_path_relationship"
      validate_path_relationship() {
        local cipher_real mount_real
        cipher_real=$("$READLINK" -m -- "$CIPHER_DIR") || die "cannot canonicalize encrypted directory: $CIPHER_DIR" 66
        mount_real=$("$READLINK" -m -- "$MOUNT_DIR") || die "cannot canonicalize mountpoint: $MOUNT_DIR" 66
        [[ $cipher_real != "$mount_real" ]] || die 'encrypted directory and mountpoint resolve to the same path' 64
        case "$mount_real/" in "$cipher_real/"*) die 'mountpoint may not be inside the encrypted directory' 64 ;; esac
        case "$cipher_real/" in "$mount_real/"*) die 'encrypted directory may not be inside the mountpoint' 64 ;; esac
      }

      #@MNX-PART id=99.87.mnxcrypt.function.prepare-paths kind=function title="Bash function prepare_paths"
      prepare_paths() {
        validate_cipher_directory
        prepare_mountpoint
        validate_path_relationship
      }

      #@MNX-PART id=99.87.mnxcrypt.function.read-mount-record kind=function title="Bash function read_mount_record"
      read_mount_record() {
        MOUNT_ID= MOUNT_TARGET= MOUNT_FSTYPE= MOUNT_SOURCE= MOUNT_OPTIONS=
        local first_id last_id
        first_id=$($FINDMNT -rn -f -M "$MOUNT_DIR" -o ID 2>/dev/null) || return 1
        MOUNT_TARGET=$($FINDMNT -rn -f -M "$MOUNT_DIR" -o TARGET 2>/dev/null) || return 1
        MOUNT_FSTYPE=$($FINDMNT -rn -f -M "$MOUNT_DIR" -o FSTYPE 2>/dev/null) || return 1
        MOUNT_SOURCE=$($FINDMNT -rn -f -M "$MOUNT_DIR" -o SOURCE 2>/dev/null) || return 1
        MOUNT_OPTIONS=$($FINDMNT -rn -f -M "$MOUNT_DIR" -o OPTIONS 2>/dev/null) || return 1
        last_id=$($FINDMNT -rn -f -M "$MOUNT_DIR" -o ID 2>/dev/null) || return 1
        [[ -n $first_id && $first_id == "$last_id" && -n $MOUNT_TARGET && -n $MOUNT_FSTYPE && -n $MOUNT_SOURCE && -n $MOUNT_OPTIONS ]] || return 1
        MOUNT_ID=$first_id
      }

      #@MNX-PART id=99.87.mnxcrypt.function.mount-present kind=function title="Bash function mount_present"
      mount_present() {
        read_mount_record
      }

      #@MNX-PART id=99.87.mnxcrypt.function.private-mount-options kind=function title="Bash function private_mount_options"
      private_mount_options() {
        # Never reuse or lifecycle-manage a mount deliberately exposed beyond its
        # mounting user. Match comma-delimited mount options, not arbitrary substrings.
        case ",$MOUNT_OPTIONS," in
          *,allow_other,*|*,allow_root,*) return 1 ;;
        esac
      }

      #@MNX-PART id=99.87.mnxcrypt.function.expected-mount kind=function title="Bash function expected_mount"
      expected_mount() {
        read_mount_record || return 1
        local expected_target cipher_real
        expected_target=$(canonical_path "$MOUNT_DIR") || return 1
        [[ $MOUNT_TARGET == "$expected_target" ]] || return 1
        [[ $MOUNT_FSTYPE == fuse.gocryptfs ]] || return 1
        private_mount_options || return 1
        # A mount created here remains identifiable by its dedicated FSNAME even if
        # the ciphertext path later becomes unavailable. External SiriKali/manual
        # mounts are reusable only while their CIPHERDIR identity is still provable.
        [[ $MOUNT_SOURCE == "$FSNAME" ]] && return 0
        [[ -d $CIPHER_DIR ]] || return 1
        cipher_real=$(canonical_path "$CIPHER_DIR") || return 1
        [[ $MOUNT_SOURCE == "$CIPHER_DIR" || $MOUNT_SOURCE == "$cipher_real" ]]
      }

      #@MNX-PART id=99.87.mnxcrypt.function.created-mount-identity kind=function title="Bash function created_mount_identity"
      created_mount_identity() {
        read_mount_record || return 1
        local expected_target
        expected_target=$(canonical_path "$MOUNT_DIR") || return 1
        [[ $MOUNT_TARGET == "$expected_target" ]] || return 1
        [[ $MOUNT_FSTYPE == fuse.gocryptfs ]] || return 1
        private_mount_options || return 1
        [[ $MOUNT_SOURCE == "$FSNAME" ]]
      }

      #@MNX-PART id=99.87.mnxcrypt.function.mount-owner-record kind=function title="Bash function mount_owner_record"
      mount_owner_record() {
        [[ -f $OWNER_FILE && ! -L $OWNER_FILE ]] || return 1
        local uid mode_bits key value owner_schema= owner_vault= owner_mode= owner_mount= owner_source= owner_socket= line_count=0
        uid=$($STAT -c %u -- "$OWNER_FILE") || return 1
        mode_bits=$($STAT -c %a -- "$OWNER_FILE") || return 1
        [[ $uid == "$UID" && $mode_bits == 600 ]] || return 1
        while IFS='=' read -r key value; do
          line_count=$((line_count + 1))
          case "$key" in
            schema) owner_schema=$value ;;
            vault_id) owner_vault=$value ;;
            ownership) owner_mode=$value ;;
            mount_id) owner_mount=$value ;;
            source) owner_source=$value ;;
            control_socket) owner_socket=$value ;;
            *) return 1 ;;
          esac
        done < "$OWNER_FILE"
        [[ $line_count -eq 6 ]] || return 1
        [[ $owner_schema == mnxcrypt.mount-owner.v2 ]] || return 1
        [[ $owner_vault == "$VAULT_ID" ]] || return 1
        [[ $owner_mode == created ]] || return 1
        [[ $owner_mount =~ ^[0-9]+$ ]] || return 1
        [[ -n $owner_source && -n $owner_socket ]] || return 1
        printf '%s\t%s\t%s\t%s\n' "$owner_mode" "$owner_mount" "$owner_source" "$owner_socket"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.managed-mount-mode kind=function title="Bash function managed_mount_mode"
      managed_mount_mode() {
        created_mount_identity || return 1
        local record owner_mode owner_mount owner_source owner_socket
        record=$(mount_owner_record) || return 1
        IFS=$'\t' read -r owner_mode owner_mount owner_source owner_socket <<< "$record"
        [[ $owner_mount == "$MOUNT_ID" && $owner_source == "$MOUNT_SOURCE" ]] || return 1
        case "$owner_mode" in
          created)
            [[ $MOUNT_SOURCE == "$FSNAME" && $owner_socket == "$CONTROL_SOCKET" ]] || return 1
            ;;
          *) return 1 ;;
        esac
        printf '%s\n' "$owner_mode"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.managed-mount kind=function title="Bash function managed_mount"
      managed_mount() {
        managed_mount_mode >/dev/null
      }

      #@MNX-PART id=99.87.mnxcrypt.function.write-owner-record kind=function title="Bash function write_owner_record"
      write_owner_record() {
        local owner_mode=$1 socket=$2 temporary
        if ! created_mount_identity; then
          log 'cannot record lifecycle ownership of a non-mnxcrypt-created mount'
          return 1
        fi
        case "$owner_mode" in
          created)
            if [[ $MOUNT_SOURCE != "$FSNAME" ]]; then
              log 'created mount lacks the expected filesystem name'
              return 1
            fi
            if [[ $socket != "$CONTROL_SOCKET" || ! -S $CONTROL_SOCKET || -L $CONTROL_SOCKET ]]; then
              log "gocryptfs control socket is unavailable: $CONTROL_SOCKET"
              return 1
            fi
            ;;
          *)
            log "invalid mount ownership mode: $owner_mode"
            return 1
            ;;
        esac

        temporary="$OWNER_FILE.$$.tmp"
        "$RM" -f -- "$temporary"
        if ! {
          printf 'schema=mnxcrypt.mount-owner.v2\n'
          printf 'vault_id=%s\n' "$VAULT_ID"
          printf 'ownership=%s\n' "$owner_mode"
          printf 'mount_id=%s\n' "$MOUNT_ID"
          printf 'source=%s\n' "$MOUNT_SOURCE"
          printf 'control_socket=%s\n' "$socket"
        } > "$temporary"; then
          "$RM" -f -- "$temporary"
          log "could not write temporary lifecycle record: $temporary"
          return 1
        fi
        if ! "$CHMOD" 0600 -- "$temporary"; then
          "$RM" -f -- "$temporary"
          log "could not secure temporary lifecycle record: $temporary"
          return 1
        fi
        "$SYNC" -f "$temporary" 2>/dev/null || true
        if ! "$MV" -f -- "$temporary" "$OWNER_FILE"; then
          "$RM" -f -- "$temporary"
          log "could not publish lifecycle record: $OWNER_FILE"
          return 1
        fi
        "$SYNC" -f "$RUNTIME_ROOT" 2>/dev/null || true
        if ! mount_owner_record >/dev/null; then
          "$RM" -f -- "$OWNER_FILE"
          log "published lifecycle record failed verification: $OWNER_FILE"
          return 1
        fi
      }

      #@MNX-PART id=99.87.mnxcrypt.function.write-created-owner kind=function title="Bash function write_created_owner"
      write_created_owner() {
        write_owner_record created "$CONTROL_SOCKET"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.recover-created-owner kind=function title="Bash function recover_created_owner"
      recover_created_owner() {
        created_mount_identity || return 1
        [[ -S $CONTROL_SOCKET && ! -L $CONTROL_SOCKET ]] || return 1
        write_created_owner
      }

      #@MNX-PART id=99.87.mnxcrypt.function.clear-owner kind=function title="Bash function clear_owner"
      clear_owner() {
        "$RM" -f -- "$OWNER_FILE"
        if [[ -e $CONTROL_SOCKET || -L $CONTROL_SOCKET ]]; then "$RM" -f -- "$CONTROL_SOCKET"; fi
      }

      #@MNX-PART id=99.87.mnxcrypt.function.session-state kind=function title="Bash function session_state"
      session_state() {
        local output compact
        if output=$("$SYSTEMCTL" --user list-units --type=service --state=active,activating,deactivating \
            --no-legend --plain "''${SESSION_PREFIX}*.service" 2>&1); then
          compact=''${output//[[:space:]]/}
          if [[ -n $compact ]]; then printf 'active\n'; else printf 'none\n'; fi
        else
          log "user manager session census failed closed: ''${output: -1000}"
          printf 'unknown\n'
        fi
      }

      #@MNX-PART id=99.87.mnxcrypt.function.sessions-block-unmount kind=function title="Bash function sessions_block_unmount"
      sessions_block_unmount() {
        [[ $(session_state) != none ]]
      }

      #@MNX-PART id=99.87.mnxcrypt.function.rollback-created-mount kind=function title="Bash function rollback_created_mount"
      rollback_created_mount() {
        # Roll back only the exact FSNAME/FSTYPE/target identity this invocation asked
        # gocryptfs to create. Never broaden a cleanup path to an unexpected mount.
        if ! mount_present; then
          clear_owner
          return 0
        fi
        created_mount_identity || return 1
        "$FUSERMOUNT" -u -- "$MOUNT_DIR" >/dev/null 2>&1 || return 1
        if mount_present; then return 1; fi
        clear_owner
      }

      #@MNX-PART id=99.87.mnxcrypt.function.mount-vault kind=function title="Bash function mount_vault"
      mount_vault() {
        resolve_tool GOCRYPTFS
        resolve_tool FUSERMOUNT
        [[ -x $ASKPASS ]] || die "pinentry adapter is not executable: $ASKPASS" 126
        if [[ -e $CONTROL_SOCKET || -L $CONTROL_SOCKET ]]; then
          [[ -S $CONTROL_SOCKET && ! -L $CONTROL_SOCKET ]] || die "unsafe control-socket object: $CONTROL_SOCKET" 77
          "$RM" -f -- "$CONTROL_SOCKET"
        fi
        directory_empty "$MOUNT_DIR" || die "refusing to mount over a nonempty directory: $MOUNT_DIR" 73

        MNXCRYPT_PINENTRY_TITLE=''${MNXCRYPT_PINENTRY_TITLE:-"Unlock private files"} \
        MNXCRYPT_PINENTRY_DESCRIPTION=''${MNXCRYPT_PINENTRY_DESCRIPTION:-"Enter the password for $VAULT_ID."} \
        MNXCRYPT_PINENTRY_PROMPT=''${MNXCRYPT_PINENTRY_PROMPT:-"Password:"} \
          "$GOCRYPTFS" -q -fsname "$FSNAME" -ctlsock "$CONTROL_SOCKET" \
            -extpass "$ASKPASS" -extpass "--" -- "$CIPHER_DIR" "$MOUNT_DIR" || {
              local rc=$?
              "$RM" -f -- "$CONTROL_SOCKET" "$OWNER_FILE"
              case "$rc" in
                9) notify normal 'Private files' 'Unlock cancelled or password prompt failed.' ;;
                12) notify normal 'Private files' 'Incorrect password.' ;;
                *) notify critical 'Private files' "Unlock failed (gocryptfs exit $rc)." ;;
              esac
              return "$rc"
            }

        if ! created_mount_identity; then
          rollback_created_mount || true
          die 'gocryptfs returned success but the exact newly-created mount identity is absent' 70
        fi
        if [[ ! -S $CONTROL_SOCKET || -L $CONTROL_SOCKET ]]; then
          rollback_created_mount || notify critical 'Private files left mounted' "Unlock succeeded but safe lifecycle setup failed for $MOUNT_DIR."
          die "gocryptfs control socket is unavailable after mount: $CONTROL_SOCKET" 70
        fi
        if ! write_created_owner; then
          rollback_created_mount || notify critical 'Private files left mounted' "Unlock succeeded but the lifecycle record could not be published for $MOUNT_DIR."
          die 'new mount could not be bound to a verified lifecycle record' 70
        fi
      }

      #@MNX-PART id=99.87.mnxcrypt.function.ensure-mounted kind=function title="Bash function ensure_mounted"
      ensure_mounted() {
        OPEN_MOUNT_OWNERSHIP=
        if mount_present; then
          expected_mount || die "refusing unexpected filesystem at $MOUNT_DIR (source=$MOUNT_SOURCE type=$MOUNT_FSTYPE)" 73
          if managed_mount; then
            OPEN_MOUNT_OWNERSHIP=created
            return 0
          fi
          if recover_created_owner; then
            OPEN_MOUNT_OWNERSHIP=created
            return 0
          fi
          # Reuse an exact SiriKali/manual CIPHERDIR-sourced mount without taking
          # lifecycle ownership. The GUI/manual actor that opened it remains the
          # actor responsible for closing it; mnxcrypt never surprises it later.
          local cipher_real
          cipher_real=$(canonical_path "$CIPHER_DIR") || die "cannot canonicalize encrypted directory: $CIPHER_DIR" 66
          if [[ $MOUNT_SOURCE == "$CIPHER_DIR" || $MOUNT_SOURCE == "$cipher_real" ]]; then
            OPEN_MOUNT_OWNERSHIP=external
            return 0
          fi
          die "expected gocryptfs mount has no safe reusable ownership identity: source=$MOUNT_SOURCE" 77
        fi
        mount_vault
        OPEN_MOUNT_OWNERSHIP=created
      }

      #@MNX-PART id=99.87.mnxcrypt.function.build-command kind=function title="Bash function build_command"
      build_command() {
        local -n destination=$1
        shift
        [[ $# -gt 0 ]] || die 'open requires an explicit COMMAND after --; no file manager or other default is injected' 64
        destination=( "$@" )
        if [[ ''${destination[0]} != */* ]]; then
          destination[0]=$(command -v -- "''${destination[0]}") || die "open command is unavailable: ''${destination[0]}" 127
        fi
        [[ -x ''${destination[0]} ]] || die "open command is not executable: ''${destination[0]}" 126

        local replaced=0 index
        for index in "''${!destination[@]}"; do
          if [[ ''${destination[$index]} == @MOUNT@ ]]; then
            destination[$index]=$MOUNT_DIR
            replaced=1
          fi
        done
        if [[ $replaced -eq 0 ]]; then destination+=( "$MOUNT_DIR" ); fi
      }

      #@MNX-PART id=99.87.mnxcrypt.function.new-unit-name kind=function title="Bash function new_unit_name"
      new_unit_name() {
        local stamp
        stamp=$($DATE +%s%N)
        printf '%s%s-%s\n' "$SESSION_PREFIX" "$stamp" "$$"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.append-session-environment kind=function title="Bash function append_session_environment"
      append_session_environment() {
        local -n destination=$1
        local unit=$2 name
        for name in HOME USER LOGNAME SHELL PATH LANG LC_ALL LC_CTYPE DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_RUNTIME_DIR XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME XDG_STATE_HOME TMPDIR SSH_AUTH_SOCK; do
          if [[ -v $name ]]; then destination+=( --setenv="$name=''${!name}" ); fi
        done
        # These are public path/identity facts, not credentials. Supplying them directly to
        # the tracked cgroup lets launchers use one stable rofi command without duplicating
        # mount paths or relying on @MOUNT@ string replacement inside shell source.
        destination+=(
          --setenv="MNXCRYPT_VAULT_ID=$VAULT_ID"
          --setenv="MNXCRYPT_CIPHER_DIR=$CIPHER_DIR"
          --setenv="MNXCRYPT_MOUNT_DIR=$MOUNT_DIR"
          --setenv="MNXCRYPT_FSNAME=$FSNAME"
          --setenv="MNXCRYPT_SESSION_UNIT=$unit.service"
        )
      }

      #@MNX-PART id=99.87.mnxcrypt.function.launch-session kind=function title="Bash function launch_session"
      launch_session() {
        local -a command=( "$@" ) environment_args=()
        local unit
        unit=$(new_unit_name)
        append_session_environment environment_args "$unit"
        "$SYSTEMD_RUN" --user --quiet --collect --unit="$unit" \
          --description="mnxcrypt $VAULT_ID open-files session" --service-type=exec \
          --property=ExitType=cgroup --property=KillMode=control-group \
          --working-directory="$MOUNT_DIR" "''${environment_args[@]}" -- "''${command[@]}" || return $?
        printf '%s\n' "$unit"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.wait-session kind=function title="Bash function wait_session"
      wait_session() {
        local unit=$1 output lower rc
        while true; do
          set +e
          output=$("$SYSTEMCTL" --user show "$unit.service" --property=ActiveState --value 2>&1)
          rc=$?
          set -e
          if [[ $rc -eq 0 ]]; then
            case "$output" in
              active|activating|reloading|deactivating) "$SLEEP" "$SESSION_POLL_SECONDS"; continue ;;
              inactive|failed) return 0 ;;
              *) log "unknown ActiveState for $unit.service; retaining lease and mount: $output" ;;
            esac
          else
            lower=''${output,,}
            if [[ $lower == *'could not be found'* || $lower == *'not found'* || $lower == *'does not exist'* || $lower == *'no such unit'* ]]; then
              return 0
            fi
            log "user manager state query failed closed for $unit.service: ''${output: -1000}"
          fi
          "$SLEEP" "$SESSION_POLL_SECONDS"
        done
      }

      #@MNX-PART id=99.87.mnxcrypt.function.try-unmount-managed kind=function title="Bash function try_unmount_managed"
      try_unmount_managed() {
        resolve_tool FUSERMOUNT
        created_mount_identity || {
          if ! mount_present; then clear_owner; return 0; fi
          return 2
        }
        managed_mount || return 3

        if ! "$SYNC" -f "$MOUNT_DIR" >/dev/null 2>&1; then
          log "syncfs failed; leaving the plaintext view mounted: $MOUNT_DIR"
          return 4
        fi

        if "$FUSERMOUNT" -u -- "$MOUNT_DIR" >/dev/null 2>&1; then
          if mount_present; then
            created_mount_identity && managed_mount && return 1
            return 2
          fi
          clear_owner
          notify low 'Private files locked' "$MOUNT_DIR"
          return 0
        fi

        # The unmount command may report failure after another actor completed the
        # same normal unmount. Re-observe before classifying the result as busy.
        if ! mount_present; then
          clear_owner
          notify low 'Private files locked' "$MOUNT_DIR"
          return 0
        fi
        created_mount_identity || return 2
        managed_mount || return 3
        return 1
      }

      #@MNX-PART id=99.87.mnxcrypt.function.cleanup-watcher-active kind=function title="Bash function cleanup_watcher_active"
      cleanup_watcher_active() {
        local output
        if output=$("$SYSTEMCTL" --user show "$CLEANUP_UNIT.service" --property=ActiveState --value 2>/dev/null); then
          case "$output" in active|activating|reloading|deactivating) return 0 ;; esac
        fi
        return 1
      }

      #@MNX-PART id=99.87.mnxcrypt.function.start-cleanup-watch kind=function title="Bash function start_cleanup_watch"
      start_cleanup_watch() {
        local -a environment_args=(
          --setenv="HOME=$HOME"
          --setenv="PATH=$PATH"
          --setenv="MNXCRYPT_VAULT_ID=$VAULT_ID"
          --setenv="MNXCRYPT_CIPHER_DIR=$CIPHER_DIR"
          --setenv="MNXCRYPT_MOUNT_DIR=$MOUNT_DIR"
          --setenv="MNXCRYPT_FSNAME=$FSNAME"
          --setenv="MNXCRYPT_RUNTIME_ROOT=$RUNTIME_ROOT"
          --setenv="MNXCRYPT_ASKPASS=$ASKPASS"
          --setenv="MNXCRYPT_GOCRYPTFS=$GOCRYPTFS"
          --setenv="MNXCRYPT_FUSERMOUNT=$FUSERMOUNT"
          --setenv="MNXCRYPT_FINDMNT=$FINDMNT"
          --setenv="MNXCRYPT_FLOCK=$FLOCK"
          --setenv="MNXCRYPT_INSTALL=$INSTALL"
          --setenv="MNXCRYPT_STAT=$STAT"
          --setenv="MNXCRYPT_READLINK=$READLINK"
          --setenv="MNXCRYPT_DIRNAME=$DIRNAME"
          --setenv="MNXCRYPT_CHMOD=$CHMOD"
          --setenv="MNXCRYPT_RM=$RM"
          --setenv="MNXCRYPT_MV=$MV"
          --setenv="MNXCRYPT_SYNC=$SYNC"
          --setenv="MNXCRYPT_CAT=$CAT"
          --setenv="MNXCRYPT_SYSTEMCTL=$SYSTEMCTL"
          --setenv="MNXCRYPT_SYSTEMD_RUN=$SYSTEMD_RUN"
          --setenv="MNXCRYPT_NOTIFY_SEND=$NOTIFY_SEND"
          --setenv="MNXCRYPT_SIRIKALI=$SIRIKALI"
          --setenv="MNXCRYPT_DATE=$DATE"
          --setenv="MNXCRYPT_SLEEP=$SLEEP"
          --setenv="MNXCRYPT_CLEANUP_RETRY_SECONDS=$CLEANUP_RETRY_SECONDS"
          --setenv="MNXCRYPT_CLEANUP_MAX_SECONDS=$CLEANUP_MAX_SECONDS"
          --setenv="MNXCRYPT_SESSION_POLL_SECONDS=$SESSION_POLL_SECONDS"
        )
        [[ -v XDG_RUNTIME_DIR ]] && environment_args+=( --setenv="XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" )
        [[ -v DBUS_SESSION_BUS_ADDRESS ]] && environment_args+=( --setenv="DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS" )
        if (
            # A real transient service receives a clean descriptor table from the user
            # manager. Closing our private flock descriptors here also makes that
            # boundary explicit and keeps test doubles from inheriting lease authority.
            [[ -z ''${LEASE_FD-} ]] || exec {LEASE_FD}>&-
            [[ -z ''${LOCK_FD-} ]] || exec {LOCK_FD}>&-
            [[ -z ''${EXCLUSIVE_LEASE_FD-} ]] || exec {EXCLUSIVE_LEASE_FD}>&-
            "$SYSTEMD_RUN" --user --quiet --collect --unit="$CLEANUP_UNIT" \
              --description="mnxcrypt $VAULT_ID deferred safe unmount" --service-type=exec \
              --property=Nice=10 --property=IOSchedulingClass=idle "''${environment_args[@]}" -- "$SELF" cleanup-watch \
              >/dev/null 2>&1
          ); then
          return 0
        fi
        # A fixed unit name intentionally collapses duplicate watchers. Distinguish
        # that expected collision from a controller failure when possible.
        cleanup_watcher_active && return 0
        notify normal 'Private files still mounted' "Safe cleanup watcher was not started for $MOUNT_DIR."
        return 1
      }

      #@MNX-PART id=99.87.mnxcrypt.function.cleanup-after-session kind=function title="Bash function cleanup_after_session"
      cleanup_after_session() {
        # Every open invocation holds a shared lease before waiting on the state lock.
        # Exclusive acquisition prevents last-client cleanup from racing an already
        # arriving second invocation that has not created its transient service yet.
        try_exclusive_lease || return 0
        lock
        if sessions_block_unmount; then unlock; release_exclusive_lease; return 0; fi
        if ! mount_present; then clear_owner; unlock; release_exclusive_lease; return 0; fi
        if ! created_mount_identity; then
          unlock
          release_exclusive_lease
          notify critical 'Private files left mounted' "Managed filesystem identity changed at $MOUNT_DIR."
          return 0
        fi
        if ! managed_mount; then
          unlock
          release_exclusive_lease
          notify critical 'Private files left mounted' "Expected mount lost its exact mnxcrypt lifecycle record: $MOUNT_DIR."
          return 0
        fi
        if try_unmount_managed; then unlock; release_exclusive_lease; return 0; fi
        unlock
        release_exclusive_lease
        start_cleanup_watch
      }

      #@MNX-PART id=99.87.mnxcrypt.function.command-open kind=function title="Bash function command_open"
      command_open() {
        if [[ ''${1-} == -- ]]; then shift; fi
        local -a open_command
        local mount_ownership unit
        build_command open_command "$@"
        prepare_mountpoint
        acquire_open_lease
        lock
        # A mount created by this controller is still usable and safely identifiable
        # by target/FSTYPE/FSNAME/owner state even if its ciphertext backing path has
        # become temporarily unavailable. A new mount or external CIPHERDIR-sourced
        # mount still requires the ciphertext directory and path relationship proof.
        if ! created_mount_identity; then
          validate_cipher_directory
          validate_path_relationship
        fi
        ensure_mounted
        mount_ownership=$OPEN_MOUNT_OWNERSHIP
        unit=$(launch_session "''${open_command[@]}") || {
          local rc=$?
          unlock
          release_open_lease
          if [[ $mount_ownership == created ]]; then cleanup_after_session || true; fi
          return "$rc"
        }
        unlock
        if [[ $mount_ownership == created ]]; then
          # Start a source-bound supervisor while this invocation still owns its shared
          # lease. If the foreground launcher is later killed, the watcher survives and
          # still waits for tracked cgroups and a normal non-busy unmount.
          start_cleanup_watch || true
        fi
        wait_session "$unit"
        release_open_lease
        if [[ $mount_ownership == created ]]; then
          # Fast-path cleanup and fallback if the detached watcher could not start.
          cleanup_after_session
        fi
      }

      #@MNX-PART id=99.87.mnxcrypt.function.command-cleanup-watch kind=function title="Bash function command_cleanup_watch"
      command_cleanup_watch() {
        local busy_started=0 now result
        while true; do
          # Wait rather than exit while an open invocation holds an intent lease. This
          # makes the detached watcher survive loss of the foreground launcher.
          if ! try_exclusive_lease; then
            "$SLEEP" "$CLEANUP_RETRY_SECONDS"
            continue
          fi
          lock
          if sessions_block_unmount; then
            unlock
            release_exclusive_lease
            "$SLEEP" "$CLEANUP_RETRY_SECONDS"
            continue
          fi
          if ! mount_present; then clear_owner; unlock; release_exclusive_lease; return 0; fi
          if ! created_mount_identity; then
            unlock; release_exclusive_lease
            notify critical 'Private files left mounted' "Managed filesystem identity changed at $MOUNT_DIR."
            return 77
          fi
          if ! managed_mount; then
            unlock; release_exclusive_lease
            notify critical 'Private files left mounted' "Lifecycle record is absent or stale for $MOUNT_DIR."
            return 77
          fi
          set +e
          try_unmount_managed
          result=$?
          set -e
          if [[ $result -eq 0 ]]; then unlock; release_exclusive_lease; return 0; fi
          unlock
          release_exclusive_lease
          if [[ $result -eq 4 ]]; then
            notify critical 'Private files left mounted' "syncfs failed before close; the plaintext view remains mounted at $MOUNT_DIR."
            return 74
          fi
          if [[ $result -ne 1 ]]; then
            notify critical 'Private files left mounted' "Safe unmount identity changed while cleaning $MOUNT_DIR."
            return 77
          fi
          now=$($DATE +%s)
          if (( busy_started == 0 )); then busy_started=$now; fi
          if (( CLEANUP_MAX_SECONDS > 0 && now - busy_started >= CLEANUP_MAX_SECONDS )); then
            notify normal 'Private files still mounted' "Safe unmount remained busy for ''${CLEANUP_MAX_SECONDS}s: $MOUNT_DIR"
            return 75
          fi
          "$SLEEP" "$CLEANUP_RETRY_SECONDS"
        done
      }

      #@MNX-PART id=99.87.mnxcrypt.function.command-status kind=function title="Bash function command_status"
      command_status() {
        [[ ! -L $MOUNT_DIR ]] || die "mountpoint is a symlink: $MOUNT_DIR" 77
        lock
        local state=closed ownership=none source=none fstype=none mount_id=none sessions cipher_state=missing
        if [[ -d $CIPHER_DIR && -f $CIPHER_DIR/gocryptfs.conf && ! -L $CIPHER_DIR/gocryptfs.conf ]]; then
          cipher_state=ready
        elif [[ -e $CIPHER_DIR || -L $CIPHER_DIR ]]; then
          cipher_state=invalid
        fi
        if mount_present; then
          source=$MOUNT_SOURCE fstype=$MOUNT_FSTYPE mount_id=$MOUNT_ID
          if created_mount_identity; then
            state=open
            ownership=$(managed_mount_mode 2>/dev/null || true)
            if [[ -z $ownership ]] && recover_created_owner; then ownership=created; fi
            [[ -n $ownership ]] || ownership=unmanaged
          elif expected_mount; then
            state=open
            ownership=external
          else
            state=unexpected-mount
          fi
        else
          clear_owner
        fi
        sessions=$(session_state)
        unlock
        printf 'schema=mnxcrypt.status.v3\n'
        printf 'vault_id=%s\n' "$VAULT_ID"
        printf 'state=%s\n' "$state"
        printf 'ownership=%s\n' "$ownership"
        printf 'cipher_state=%s\n' "$cipher_state"
        printf 'cipher_dir=%s\n' "$CIPHER_DIR"
        printf 'mount_dir=%s\n' "$MOUNT_DIR"
        printf 'source=%s\n' "$source"
        printf 'fstype=%s\n' "$fstype"
        printf 'mount_options=%s\n' "''${MOUNT_OPTIONS:-none}"
        printf 'mount_id=%s\n' "$mount_id"
        printf 'tracked_sessions=%s\n' "$sessions"
        printf 'MNXCRYPT_STATUS=PASS\n'
        [[ $state != unexpected-mount && $sessions != unknown ]]
      }

      #@MNX-PART id=99.87.mnxcrypt.function.command-unmount kind=function title="Bash function command_unmount"
      command_unmount() {
        prepare_mountpoint
        try_exclusive_lease || die 'refusing manual unmount while an open invocation is arriving or active' 75
        lock
        if sessions_block_unmount; then unlock; release_exclusive_lease; die 'refusing manual unmount while tracked sessions are active or unknown' 75; fi
        if ! mount_present; then clear_owner; unlock; release_exclusive_lease; return 0; fi
        if ! created_mount_identity; then
          if expected_mount; then
            unlock; release_exclusive_lease
            die 'refusing to unmount an exact externally-owned SiriKali/manual mount; close it with the actor that mounted it' 77
          fi
          unlock; release_exclusive_lease
          die "refusing unexpected filesystem at $MOUNT_DIR" 73
        fi
        managed_mount || recover_created_owner || {
          unlock; release_exclusive_lease
          die 'refusing created mount without an exact lifecycle record or recoverable control socket' 77
        }
        local result
        set +e
        try_unmount_managed
        result=$?
        set -e
        unlock
        release_exclusive_lease
        case "$result" in
          0) return 0 ;;
          1) die 'safe normal unmount reported the mount busy' 75 ;;
          4) die 'syncfs failed before close; the plaintext view remains mounted' 74 ;;
          *) die 'safe unmount identity or ownership changed during the operation' 77 ;;
        esac
      }

      #@MNX-PART id=99.87.mnxcrypt.function.command-create kind=function title="Bash function command_create"
      command_create() {
        [[ $# -eq 0 ]] || die 'create takes no arguments; select the vault through MNXCRYPT_VAULT_ID, MNXCRYPT_CIPHER_DIR, and MNXCRYPT_MOUNT_DIR' 64
        resolve_tool GOCRYPTFS
        [[ -x $ASKPASS ]] || die "pinentry adapter is not executable: $ASKPASS" 126
        if [[ ! -t 1 || ! -t 2 ]]; then
          [[ ''${MNXCRYPT_ALLOW_NONTTY_CREATE_FOR_TESTS:-0} == 1 ]] || \
            die 'create must run in an interactive terminal so the one-time recovery master key is displayed directly and is not captured by mnxcrypt' 64
        fi
        try_exclusive_lease || die 'refusing vault creation while an open invocation is arriving or active' 75
        lock
        if sessions_block_unmount; then
          unlock; release_exclusive_lease
          die 'refusing vault creation while tracked sessions are active or unknown' 75
        fi
        validate_path_relationship
        prepare_mountpoint
        if mount_present; then
          local detail="source=$MOUNT_SOURCE type=$MOUNT_FSTYPE"
          unlock; release_exclusive_lease
          die "refusing vault creation while the mountpoint is in use ($detail)" 75
        fi
        clear_owner
        prepare_new_cipher_directory
        unlock

        printf '%s\n' \
          'mnxcrypt create: gocryptfs will show two graphical password prompts.' \
          'mnxcrypt create: enter the same new password both times.' \
          'mnxcrypt create: keep this terminal visible; gocryptfs prints the recovery master key here exactly once.' \
          'mnxcrypt create: record that key on independently protected offline media before closing the terminal.' >&2

        local rc partial=no
        set +e
        MNXCRYPT_PINENTRY_TITLE=''${MNXCRYPT_PINENTRY_TITLE:-"Create encrypted vault"} \
        MNXCRYPT_PINENTRY_DESCRIPTION=''${MNXCRYPT_PINENTRY_DESCRIPTION:-"Choose the password for $VAULT_ID. You will be asked twice; enter the same password both times."} \
        MNXCRYPT_PINENTRY_PROMPT=''${MNXCRYPT_PINENTRY_PROMPT:-"New password:"} \
        MNXCRYPT_PINENTRY_OK=''${MNXCRYPT_PINENTRY_OK:-"Continue"} \
          "$GOCRYPTFS" -init -extpass "$ASKPASS" -extpass "--" -- "$CIPHER_DIR"
        rc=$?
        set -e

        lock
        if [[ $rc -ne 0 ]]; then
          directory_empty "$CIPHER_DIR" || partial=yes
          unlock
          release_exclusive_lease
          if [[ $partial == yes ]]; then
            notify critical 'Encrypted vault creation incomplete' "gocryptfs exited $rc after writing into $CIPHER_DIR; mnxcrypt did not delete or overwrite the partial state."
            printf 'MNXCRYPT_CREATE=FAIL_PARTIAL_%s\n' "$rc" >&2
            return 70
          fi
          notify normal 'Encrypted vault creation cancelled' "gocryptfs initialization exited $rc without creating vault files."
          printf 'MNXCRYPT_CREATE=FAIL_%s\n' "$rc" >&2
          return "$rc"
        fi
        if ! validate_created_cipher_directory; then
          unlock
          release_exclusive_lease
          notify critical 'Encrypted vault creation incomplete' "gocryptfs returned success but the expected regular user-owned config and root diriv are not both present in $CIPHER_DIR."
          die 'created vault failed post-initialization identity checks; state was preserved for review' 70
        fi
        unlock
        release_exclusive_lease
        if ! "$GOCRYPTFS" -info -- "$CIPHER_DIR"; then
          notify critical 'Encrypted vault created but verification incomplete' "The vault files were preserved at $CIPHER_DIR, but gocryptfs -info failed."
          die 'vault was created but post-create information verification failed; state was preserved for review' 70
        fi
        printf 'MNXCRYPT_CREATE=PASS\n'
      }

      #@MNX-PART id=99.87.mnxcrypt.function.command-fsck kind=function title="Bash function command_fsck"
      command_fsck() {
        prepare_paths
        resolve_tool GOCRYPTFS
        [[ -x $ASKPASS ]] || die "pinentry adapter is not executable: $ASKPASS" 126
        try_exclusive_lease || die 'refusing fsck while an open invocation is arriving or active' 75
        lock
        if sessions_block_unmount; then unlock; release_exclusive_lease; die 'refusing fsck while tracked sessions are active or unknown' 75; fi
        if mount_present; then
          local detail="source=$MOUNT_SOURCE type=$MOUNT_FSTYPE"
          unlock; release_exclusive_lease
          die "refusing fsck while the mountpoint is in use ($detail)" 75
        fi
        unlock
        local rc
        set +e
        MNXCRYPT_PINENTRY_TITLE=''${MNXCRYPT_PINENTRY_TITLE:-"Check private files"} \
        MNXCRYPT_PINENTRY_DESCRIPTION=''${MNXCRYPT_PINENTRY_DESCRIPTION:-"Enter the password to verify $VAULT_ID."} \
        MNXCRYPT_PINENTRY_PROMPT=''${MNXCRYPT_PINENTRY_PROMPT:-"Password:"} \
          "$GOCRYPTFS" -q -fsck -extpass "$ASKPASS" -extpass "--" -- "$CIPHER_DIR"
        rc=$?
        set -e
        release_exclusive_lease
        case "$rc" in
          0) printf 'MNXCRYPT_FSCK=PASS\n'; return 0 ;;
          9) notify normal 'Private files check' 'Check cancelled or password prompt failed.' ;;
          12) notify normal 'Private files check' 'Incorrect password.' ;;
          26) notify critical 'Private files check found damage' "gocryptfs reported filesystem corruption in $CIPHER_DIR." ;;
          *) notify critical 'Private files check failed' "gocryptfs fsck failed (exit $rc)." ;;
        esac
        printf 'MNXCRYPT_FSCK=FAIL_%s\n' "$rc" >&2
        return "$rc"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.command-info kind=function title="Bash function command_info"
      command_info() {
        validate_cipher_directory
        resolve_tool GOCRYPTFS
        "$GOCRYPTFS" -info -- "$CIPHER_DIR"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.command-gui kind=function title="Bash function command_gui"
      command_gui() {
        resolve_tool SIRIKALI
        exec "$SIRIKALI" "$@"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.command-doctor kind=function title="Bash function command_doctor"
      command_doctor() {
        local failed=0 tool value
        printf 'schema=mnxcrypt.doctor.v3\n'
        printf 'vault_id=%s\n' "$VAULT_ID"
        printf 'cipher_dir=%s\n' "$CIPHER_DIR"
        printf 'mount_dir=%s\n' "$MOUNT_DIR"
        for tool in GOCRYPTFS FUSERMOUNT FINDMNT FLOCK INSTALL STAT READLINK DIRNAME CHMOD RM MKDIR MV SYNC CAT SYSTEMCTL SYSTEMD_RUN DATE SLEEP SIRIKALI; do
          value=''${!tool}
          if [[ $value != */* ]]; then value=$(command -v -- "$value" 2>/dev/null || true); fi
          if [[ -n $value && -x $value ]]; then
            printf 'tool_%s=%s\n' "''${tool,,}" "$value"
          else
            printf 'tool_%s=unavailable\n' "''${tool,,}"
            failed=1
          fi
        done
        if [[ -x $ASKPASS ]] && "$ASKPASS" --self-test >/dev/null 2>&1; then
          printf 'pinentry_adapter=%s\n' "$ASKPASS"
          local pinentry_check
          if pinentry_check=$("$ASKPASS" --check-program 2>/dev/null); then
            printf '%s\n' "$pinentry_check"
          else
            printf 'pinentry_program=unavailable-or-invalid\n'
            failed=1
          fi
        else
          printf 'pinentry_adapter=unavailable-or-self-test-failed\n'
          failed=1
        fi
        if [[ -d $CIPHER_DIR && -f $CIPHER_DIR/gocryptfs.conf && ! -L $CIPHER_DIR/gocryptfs.conf ]]; then
          printf 'cipher_directory=ready\n'
        else
          printf 'cipher_directory=not-initialized\n'
          failed=1
        fi
        printf 'MNXCRYPT_DOCTOR=%s\n' "$([[ $failed -eq 0 ]] && printf PASS || printf REVIEW)"
        return "$failed"
      }

      #@MNX-PART id=99.87.mnxcrypt.function.command-policy kind=function title="Bash function command_policy"
      command_policy() {
        resolve_tool CAT
        "$CAT" <<'POLICY'
      schema=mnxcrypt.policy.v6
      activation_probe_environment=home-may-be-unset-for-policy-and-self-test-real-vault-commands-require-home-or-both-explicit-paths
      engine=gocryptfs
      gui=sirikali
      launcher=rofi-or-any-desktop-launcher
      password_prompt=pinentry-qt-via-assuan-adapter
      password_transport=gocryptfs-repeated-extpass
      root_required=no
      allow_other=no
      external_allow_other_mount_reused=no
      lazy_unmount=no
      forced_unmount=no
      normal_busy_unmount=defer-and-retry
      created_mount_autolock=yes
      exact_external_mount_reused_without_prompt_or_remount=yes
      external_mount_lifecycle_takeover=no
      external_mount_autolock=no
      vault_selection=public-environment-vault-id-cipher-directory-mount-directory-or-default
      vault_creation=interactive-terminal-only-empty-user-owned-cipherdir
      create_password_prompts=two-graphical-pinentry-invocations-enforced-by-gocryptfs
      create_recovery_key=printed-once-directly-by-gocryptfs-to-operator-terminal-never-captured-by-mnxcrypt
      create_partial_failure=preserve-and-review-never-auto-delete
      open_requires_explicit_command=yes
      default_open_command=none
      custom_command_mount_token=@MOUNT@
      tracked_lifetime=systemd-user-transient-service-exittype-cgroup-all-descendants-that-remain-in-the-cgroup
      tracked_command_environment=MNXCRYPT_VAULT_ID-MNXCRYPT_CIPHER_DIR-MNXCRYPT_MOUNT_DIR-MNXCRYPT_FSNAME-MNXCRYPT_SESSION_UNIT
      plaintext_write_semantics=encrypted-into-cipherdir-continuously-while-mounted
      managed_close_condition=last-tracked-session-cgroup-exits-syncfs-succeeds-and-normal-unmount-is-not-busy
      managed_close_semantics=syncfs-then-remove-plaintext-view-by-normal-unmount-no-bulk-reencrypt-pass
      pre_close_flush_failure=leave-mounted-critical-notification-and-no-false-lock-claim
      busy_close_behavior=detached-normal-unmount-retry-never-force-or-lazy
      foreground-launcher-loss_supervised=yes
      real_vault_qualification=operator-run-required-after-accepted-switch
      file_manager_integration=none
      fsck=closed-vault-only-graphical-pinentry
      mnx_dispatcher_route=not-added-standalone-command-is-intentional
      POLICY
        printf 'MNXCRYPT_POLICY=PASS\n'
      }

      #@MNX-PART id=99.87.mnxcrypt.function.command-self-test kind=function title="Bash function command_self_test"
      command_self_test() {
        [[ $HOME_WAS_SET =~ ^[01]$ ]] || die 'HOME startup-state grammar differs' 70
        [[ $CLEANUP_MAX_SECONDS =~ ^[0-9]+$ ]] || die 'cleanup maximum grammar differs' 70
        [[ $FSNAME == mnxcrypt-* || -n ''${MNXCRYPT_FSNAME-} ]] || die 'filesystem name policy differs' 70
        [[ $MOUNT_DIR == /* && $CIPHER_DIR == /* ]] || die 'tracked command path environment is not absolute' 70
        [[ ''${MNXCRYPT_ALLOW_NONTTY_CREATE_FOR_TESTS:-0} =~ ^[01]$ ]] || die 'create test-only nonterminal override grammar differs' 70
        printf 'MNXCRYPT_SELF_TEST=PASS\n'
      }

      #@MNX-PART id=99.87.mnxcrypt.function.usage kind=function title="Bash function usage"
      usage() {
        resolve_tool CAT
        "$CAT" <<'USAGE'
      usage: mnxcrypt COMMAND [ARGS...]

      Commands:
        create                       Initialize a new empty gocryptfs CIPHER_DIR.
                                     Must run in a terminal: two graphical password
                                     prompts appear, then gocryptfs prints the one-time
                                     recovery master key directly to that terminal.
        open -- COMMAND [ARGS...]    Mount if needed, launch the explicit tracked command,
                                     and auto-lock the managed mount after the final
                                     tracked cgroup exits and normal unmount is idle.
                                     @MOUNT@ is replaced; otherwise the mountpoint is
                                     appended as the final argument. No file manager or
                                     other application is injected by default.
        status                       Show exact mount identity, lifecycle ownership,
                                     and tracked-session state. Does not take
                                     ownership of an external SiriKali mount.
        unmount                      Normally unmount an idle mnxcrypt-created mount.
                                     Refuses force/lazy behavior and external mounts.
        cleanup-watch                Internal busy-mount normal-unmount retry worker.
        fsck                         Verify a closed vault with gocryptfs -fsck and
                                     the same graphical pinentry password path.
        info                         Print gocryptfs's non-secret volume information.
        gui [ARGS...]                Launch SiriKali for optional manual management.
        doctor                       Check tools, pinentry adapter, and vault readiness.
        policy                       Print the source-owned behavioral policy.
        self-test                    Run non-mutating source-owned checks.
        help                         Show this help.

      One-time creation (run in a terminal and record the displayed recovery key):
        env MNXCRYPT_VAULT_ID=NAME \
            MNXCRYPT_CIPHER_DIR=/absolute/path/to/Vault.cipher \
            MNXCRYPT_MOUNT_DIR=/absolute/path/to/plaintext-mount \
            mnxcrypt create

      Rofi-ready FOOBAR launch:
        env MNXCRYPT_VAULT_ID=NAME \
            MNXCRYPT_CIPHER_DIR=/absolute/path/to/Vault.cipher \
            MNXCRYPT_MOUNT_DIR=/absolute/path/to/plaintext-mount \
            mnxcrypt open -- bash -lc 'cd -- "$1" && exec FOOBAR' bash @MOUNT@

      If closed, open displays a graphical password prompt and mounts first. If already
      open, it reuses the exact mount without prompting. Each FOOBAR launch is a separate
      transient user-service cgroup. The mnxcrypt-created mount closes only after all
      tracked cgroups exit, syncfs succeeds, and a normal unmount is no longer busy. gocryptfs encrypts
      writes into CIPHER_DIR continuously; close removes the plaintext mount view rather
      than performing a later bulk re-encryption pass. A program that deliberately moves
      itself into another scope or forwards work into a pre-existing daemon is outside
      the cgroup lifetime boundary and needs program-specific treatment.
      USAGE
      }

      #@MNX-PART id=99.87.mnxcrypt.function.main kind=function title="Bash function main"
      main() {
        local requested_command=''${1:-help}
        if [[ $HOME_WAS_SET == 0 && ( -z ''${MNXCRYPT_CIPHER_DIR+x} || -z ''${MNXCRYPT_MOUNT_DIR+x} ) ]]; then
          case "$requested_command" in
            help|-h|--help|policy|self-test) ;;
            *) die 'HOME is unset; set HOME or both MNXCRYPT_CIPHER_DIR and MNXCRYPT_MOUNT_DIR' 64 ;;
          esac
        fi
        validate_settings
        case "$requested_command" in
          help|-h|--help) usage ;;
          policy) shift; [[ $# -eq 0 ]] || die 'policy takes no arguments' 64; command_policy ;;
          self-test) shift; [[ $# -eq 0 ]] || die 'self-test takes no arguments' 64; command_self_test ;;
          gui) shift; command_gui "$@" ;;
          doctor) shift; [[ $# -eq 0 ]] || die 'doctor takes no arguments' 64; command_doctor ;;
          create|open|status|unmount|cleanup-watch|fsck|info)
            local command=$1
            shift
            resolve_common_tools
            ensure_runtime
            case "$command" in
              create) command_create "$@" ;;
              open) command_open "$@" ;;
              status) [[ $# -eq 0 ]] || die 'status takes no arguments' 64; command_status ;;
              unmount) [[ $# -eq 0 ]] || die 'unmount takes no arguments' 64; command_unmount ;;
              cleanup-watch) [[ $# -eq 0 ]] || die 'cleanup-watch takes no arguments' 64; command_cleanup_watch ;;
              fsck) [[ $# -eq 0 ]] || die 'fsck takes no arguments' 64; command_fsck ;;
              info) [[ $# -eq 0 ]] || die 'info takes no arguments' 64; command_info ;;
            esac
            ;;
          *) die "unknown command: $1" 64 ;;
        esac
      }

      main "$@"
      '';
      checkPhase = ''
        set -Eeuo pipefail
        err="$(${pkgs.coreutils}/bin/mktemp)"
        self_out="$(${pkgs.coreutils}/bin/mktemp)"
        policy_out="$(${pkgs.coreutils}/bin/mktemp)"
        trap '${pkgs.coreutils}/bin/rm -f "$err" "$self_out" "$policy_out"' EXIT
        if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
          ${pkgs.coreutils}/bin/cat "$err" >&2
          exit 1
        fi
        [ ! -s "$err" ] || { ${pkgs.coreutils}/bin/cat "$err" >&2; exit 1; }
        ${pkgs.coreutils}/bin/env -u HOME MNXCRYPT_ALLOW_ROOT_FOR_TESTS=1 "$out" self-test >"$self_out"
        ${pkgs.gnugrep}/bin/grep -Fx 'MNXCRYPT_SELF_TEST=PASS' "$self_out"
        ${pkgs.coreutils}/bin/env -u HOME MNXCRYPT_ALLOW_ROOT_FOR_TESTS=1 "$out" policy >"$policy_out"
        ${pkgs.gnugrep}/bin/grep -Fxq 'schema=mnxcrypt.policy.v6' "$policy_out"
        ${pkgs.gnugrep}/bin/grep -Fxq 'activation_probe_environment=home-may-be-unset-for-policy-and-self-test-real-vault-commands-require-home-or-both-explicit-paths' "$policy_out"
        ${pkgs.gnugrep}/bin/grep -Fxq 'open_requires_explicit_command=yes' "$policy_out"
        ${pkgs.gnugrep}/bin/grep -Fxq 'vault_creation=interactive-terminal-only-empty-user-owned-cipherdir' "$policy_out"
        ${pkgs.gnugrep}/bin/grep -Fxq 'file_manager_integration=none' "$policy_out"
        ${pkgs.gnugrep}/bin/grep -Fxq 'MNXCRYPT_POLICY=PASS' "$policy_out"
        ${pkgs.gnugrep}/bin/grep -Fq -- '--property=ExitType=cgroup' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq -- 'FUSERMOUNT=''${MNXCRYPT_FUSERMOUNT:-/run/wrappers/bin/fusermount3}' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq -- '-extpass "$ASKPASS" -extpass "--"' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq -- '"$GOCRYPTFS" -init -extpass "$ASKPASS" -extpass "--"' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq -- '-fsck -extpass "$ASKPASS" -extpass "--"' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq -- "open requires an explicit COMMAND after --" "$out"
        ! ${pkgs.gnugrep}/bin/grep -Fq -- 'mnxcrypt-open-files' "$out"
        ! ${pkgs.gnugrep}/bin/grep -Fq -- 'pcmanfm' "$out"
        ! ${pkgs.gnugrep}/bin/grep -Fq -- 'adopt_external_mount' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq -- 'external_mount_lifecycle_takeover=no' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq -- 'external_allow_other_mount_reused=no' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq -- 'try_exclusive_lease' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq -- '"$SYNC" -f "$MOUNT_DIR"' "$out"
        ! ${pkgs.gnugrep}/bin/grep -Fq -- '-passfile' "$out"
        ! ${pkgs.gnugrep}/bin/grep -Fq -- '-forcedecode' "$out"
        ! ${pkgs.gnugrep}/bin/grep -Fq -- '-noprealloc' "$out"
        ! ${pkgs.gnugrep}/bin/grep -Fq -- 'sudo' "$out"
        ! ${pkgs.gnugrep}/bin/grep -Fq -- '--lazy' "$out"
        ! ${pkgs.gnugrep}/bin/grep -Fq -- '--force' "$out"
      '';
    };
    mode = "0755";
  };

#@MNX-CHUNK id=99.88 slug=presslog-input-controller title="Presslog keyboard ACL, operator controller, and durability boundary"
#######################################################################################################
# SECTION 99.88 — PRESSLOG INPUT ACCESS AND OPERATOR CONTROLLER
#######################################################################################################
#@MNX-DEF path=services.udev.extraRules section=99.88 role=policy ordinal=284
  services.udev.extraRules = ''
    # Monsternix Presslog input grant: the plain-ejection contract removes this rule with the recorder services.
    SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", RUN+="${pkgs.acl}/bin/setfacl -m u:h0p3:r-- /dev/input/%k"
  '';
#@MNX-DEF path=security.pam.loginLimits section=99.88 role=policy ordinal=285
  security.pam.loginLimits = [
    { domain = "h0p3"; type = "soft"; item = "memlock"; value = "262144"; }
    { domain = "h0p3"; type = "hard"; item = "memlock"; value = "262144"; }
  ];
#@MNX-DEF path=systemd.services.mnx-presslog-input-access section=99.88 role=service ordinal=286
  systemd.services.mnx-presslog-input-access = {
    description = "Grant h0p3 read-only ACLs on keyboard event devices";
    wantedBy = [ "multi-user.target" ];
    after = [ "systemd-udev-trigger.service" ];
    before = [ "display-manager.service" ];
    unitConfig.ConditionPathExists = "/dev/input";
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStart = pkgs.writeShellScript "mnx-presslog-input-access" ''
        set -Eeuo pipefail
        found=0
        for node in /dev/input/event*; do
          [ -c "$node" ] || continue
          if ${pkgs.systemd}/bin/udevadm info --query=property --name="$node" | ${pkgs.gnugrep}/bin/grep -Fx 'ID_INPUT_KEYBOARD=1' >/dev/null; then
            ${pkgs.acl}/bin/setfacl -m u:h0p3:r "$node"
            ${pkgs.acl}/bin/getfacl -cp "$node" | ${pkgs.gnugrep}/bin/grep -Fx 'user:h0p3:r--' >/dev/null
            found=$((found + 1))
          fi
        done
        [ "$found" -gt 0 ] || { echo 'MNX_PRESSLOG_INPUT_ACCESS=FAIL_NO_KEYBOARD' >&2; exit 1; }
        printf 'keyboard_event_acl_count=%s\nMNX_PRESSLOG_INPUT_ACCESS=PASS\n' "$found"
      '';
      ExecStop = pkgs.writeShellScript "mnx-presslog-input-access-cleanup" ''
        set -Eeuo pipefail
        residual=0
        for node in /dev/input/event*; do
          [ -c "$node" ] || continue
          if ${pkgs.systemd}/bin/udevadm info --query=property --name="$node" | ${pkgs.gnugrep}/bin/grep -Fx 'ID_INPUT_KEYBOARD=1' >/dev/null; then
            ${pkgs.acl}/bin/setfacl -x u:h0p3 "$node" 2>/dev/null || true
            if ${pkgs.acl}/bin/getfacl -cp "$node" 2>/dev/null | ${pkgs.gnugrep}/bin/grep -Eq '^user:h0p3:'; then
              printf 'MNX_PRESSLOG_INPUT_ACCESS_CLEANUP=FAIL node=%s\n' "$node" >&2
              residual=$((residual + 1))
            fi
          fi
        done
        [ "$residual" -eq 0 ] || exit 1
        echo 'MNX_PRESSLOG_INPUT_ACCESS_CLEANUP=PASS'
      '';
      NoNewPrivileges = true;
      CapabilityBoundingSet = [ ];
      PrivateTmp = true;
      ProtectSystem = "strict";
      ProtectHome = true;
      ProtectKernelLogs = true;
      ProtectKernelModules = true;
      ProtectKernelTunables = true;
      ProtectControlGroups = true;
      RestrictAddressFamilies = [ "AF_UNIX" ];
      RestrictRealtime = true;
      RestrictSUIDSGID = true;
      LockPersonality = true;
      UMask = "0077";
    };
  };
#@MNX-DEF path=environment.etc."monsternix/bin/presslog-pinentry" section=99.88 role=generated-program ordinal=287
  environment.etc."monsternix/bin/presslog-pinentry" = {
    source = pkgs.writeTextFile {
      name = "presslog-pinentry";
      executable = true;
      text = ''
      #!${pkgs.python3}/bin/python3
      from __future__ import annotations

      import hmac
      import os
      import stat
      import subprocess
      import sys
      from dataclasses import dataclass
      from typing import BinaryIO, Iterable

      DEFAULT_PINENTRY = "${pkgs.pinentry-qt}/bin/pinentry-qt"
      MAX_PROTOCOL_LINE = 1024 * 1024


      #@MNX-PART id=99.88.presslog-pinentry.class.error kind=class title="Python class PinentryError"
      class PinentryError(RuntimeError):
          pass


      #@MNX-PART id=99.88.presslog-pinentry.class.cancelled kind=class title="Python class PinentryCancelled"
      class PinentryCancelled(PinentryError):
          pass


      @dataclass(frozen=True)
      #@MNX-PART id=99.88.presslog-pinentry.class.prompt kind=class title="Python class Prompt"
      class Prompt:
          title: str
          description: str
          prompt: str
          ok: str = "Continue"


      #@MNX-PART id=99.88.presslog-pinentry.function.resolve kind=function title="Python function resolve_pinentry"
      def resolve_pinentry() -> str:
          configured = DEFAULT_PINENTRY
          if os.environ.get("PRESSLOG_PINENTRY_ALLOW_TEST_OVERRIDE") == "1":
              configured = os.environ.get("PRESSLOG_PINENTRY_TEST_PROGRAM", configured)
          if not os.path.isabs(configured):
              raise PinentryError("graphical pinentry path is not absolute")
          if not os.path.isfile(configured) or not os.access(configured, os.X_OK):
              raise PinentryError(f"graphical pinentry program is not executable: {configured}")
          return configured


      #@MNX-PART id=99.88.presslog-pinentry.function.environment kind=function title="Python function pinentry_environment"
      def pinentry_environment() -> dict[str, str]:
          allowed = {
              "DBUS_SESSION_BUS_ADDRESS",
              "DISPLAY",
              "HOME",
              "LANG",
              "LC_ALL",
              "LOCALE_ARCHIVE",
              "PATH",
              "QT_QPA_PLATFORM",
              "WAYLAND_DISPLAY",
              "XAUTHORITY",
              "XDG_CACHE_HOME",
              "XDG_CONFIG_HOME",
              "XDG_DATA_HOME",
              "XDG_RUNTIME_DIR",
              "XDG_STATE_HOME",
          }
          return {key: value for key, value in os.environ.items() if key in allowed}


      #@MNX-PART id=99.88.presslog-pinentry.function.assuan-escape kind=function title="Python function assuan_escape"
      def assuan_escape(value: str) -> bytes:
          output = bytearray()
          for byte in value.encode("utf-8"):
              if byte <= 0x20 or byte >= 0x7F or byte == 0x25:
                  output.extend(f"%{byte:02X}".encode("ascii"))
              else:
                  output.append(byte)
          return bytes(output)


      #@MNX-PART id=99.88.presslog-pinentry.function.assuan-unescape kind=function title="Python function assuan_unescape"
      def assuan_unescape(value: bytes) -> bytearray:
          output = bytearray()
          index = 0
          while index < len(value):
              if value[index] == 0x25:
                  if index + 2 >= len(value):
                      raise PinentryError("pinentry returned malformed Assuan data")
                  try:
                      output.append(int(value[index + 1 : index + 3].decode("ascii"), 16))
                  except (UnicodeDecodeError, ValueError) as exc:
                      raise PinentryError("pinentry returned malformed Assuan data") from exc
                  index += 3
              else:
                  output.append(value[index])
                  index += 1
          return output


      #@MNX-PART id=99.88.presslog-pinentry.function.read-protocol-line kind=function title="Python function read_protocol_line"
      def read_protocol_line(stream: BinaryIO) -> bytes:
          line = stream.readline(MAX_PROTOCOL_LINE + 1)
          if not line:
              raise PinentryError("pinentry closed its protocol stream unexpectedly")
          if len(line) > MAX_PROTOCOL_LINE:
              raise PinentryError("pinentry protocol line exceeded the safety bound")
          return line.rstrip(b"\r\n")


      #@MNX-PART id=99.88.presslog-pinentry.function.read-reply kind=function title="Python function read_reply"
      def read_reply(process: subprocess.Popen[bytes], collect_data: bool = False) -> bytearray:
          if process.stdout is None:
              raise PinentryError("pinentry stdout pipe is unavailable")
          collected = bytearray()
          while True:
              line = read_protocol_line(process.stdout)
              if line == b"OK" or line.startswith(b"OK "):
                  return collected
              if line == b"ERR" or line.startswith(b"ERR "):
                  raise PinentryCancelled("password prompt was cancelled or refused")
              if line == b"D":
                  if collect_data:
                      continue
                  raise PinentryError("pinentry returned unexpected data")
              if line.startswith(b"D "):
                  if not collect_data:
                      raise PinentryError("pinentry returned unexpected data")
                  collected.extend(assuan_unescape(line[2:]))
                  continue
              if line.startswith(b"S ") or line.startswith(b"#") or line == b"":
                  continue
              raise PinentryError("pinentry returned an unknown Assuan response")


      #@MNX-PART id=99.88.presslog-pinentry.function.send-command kind=function title="Python function send_command"
      def send_command(
          process: subprocess.Popen[bytes],
          command: bytes,
          argument: str | None = None,
          collect_data: bool = False,
      ) -> bytearray:
          if process.stdin is None:
              raise PinentryError("pinentry stdin pipe is unavailable")
          line = bytearray(command)
          if argument is not None:
              line.extend(b" ")
              line.extend(assuan_escape(argument))
          line.extend(b"\n")
          process.stdin.write(line)
          process.stdin.flush()
          return read_reply(process, collect_data=collect_data)


      #@MNX-PART id=99.88.presslog-pinentry.function.zeroize kind=function title="Python function zeroize"
      def zeroize(secret: bytearray) -> None:
          for index in range(len(secret)):
              secret[index] = 0


      #@MNX-PART id=99.88.presslog-pinentry.function.request-password kind=function title="Python function request_password"
      def request_password(pinentry: str, prompt: Prompt) -> bytearray:
          process = subprocess.Popen(
              [pinentry],
              stdin=subprocess.PIPE,
              stdout=subprocess.PIPE,
              stderr=subprocess.DEVNULL,
              env=pinentry_environment(),
          )
          password = bytearray()
          try:
              read_reply(process)
              send_command(process, b"SETTITLE", prompt.title)
              send_command(process, b"SETDESC", prompt.description)
              send_command(process, b"SETPROMPT", prompt.prompt)
              send_command(process, b"SETOK", prompt.ok)
              send_command(process, b"SETCANCEL", "Cancel")
              password = send_command(process, b"GETPIN", collect_data=True)
              if not password:
                  raise PinentryError("pinentry returned an empty password")
              if b"\x00" in password or b"\n" in password or b"\r" in password:
                  raise PinentryError("pinentry returned a password containing a prohibited byte")
              try:
                  send_command(process, b"BYE")
              except PinentryError:
                  pass
              try:
                  process.wait(timeout=5)
              except subprocess.TimeoutExpired:
                  process.terminate()
                  process.wait(timeout=5)
              return password
          except Exception:
              if process.poll() is None:
                  process.terminate()
                  try:
                      process.wait(timeout=5)
                  except subprocess.TimeoutExpired:
                      process.kill()
                      process.wait(timeout=5)
              zeroize(password)
              raise


      #@MNX-PART id=99.88.presslog-pinentry.function.require-secret-pipe kind=function title="Python function require_secret_pipe"
      def require_secret_pipe(fd: int = 1) -> None:
          if os.environ.get("PRESSLOG_PINENTRY_ALLOW_TEST_NONPIPE") == "1":
              return
          mode = os.fstat(fd).st_mode
          if not stat.S_ISFIFO(mode):
              raise PinentryError("secret output must be an anonymous pipe")


      #@MNX-PART id=99.88.presslog-pinentry.function.confirmed-pair kind=function title="Python function confirmed_pair"
      def confirmed_pair(pinentry: str, first_prompt: Prompt, second_prompt: Prompt) -> bytearray:
          first = bytearray()
          second = bytearray()
          try:
              first = request_password(pinentry, first_prompt)
              second = request_password(pinentry, second_prompt)
              if not hmac.compare_digest(first, second):
                  raise PinentryError("passwords differ")
              return first
          except Exception:
              zeroize(first)
              raise
          finally:
              zeroize(second)


      #@MNX-PART id=99.88.presslog-pinentry.function.emit-lines kind=function title="Python function emit_lines"
      def emit_lines(secrets: Iterable[bytearray]) -> None:
          require_secret_pipe()
          for secret in secrets:
              os.write(1, secret)
              os.write(1, b"\n")


      #@MNX-PART id=99.88.presslog-pinentry.function.prompts-for kind=function title="Python function prompts_for"
      def prompts_for(mode: str) -> tuple[list[Prompt], list[int]]:
          presslog = Prompt(
              "Unlock Presslog encrypted journal",
              "Enter the Presslog password. Keyboard capture is stopped and will remain paused until you explicitly resume it.",
              "Presslog password:",
              "Unlock",
          )
          presslog_new = Prompt(
              "Create Presslog encrypted journal",
              "Choose a new Presslog password. Keyboard capture is stopped and will remain paused until you explicitly resume it.",
              "New Presslog password:",
              "Continue",
          )
          presslog_confirm = Prompt(
              "Confirm Presslog encrypted journal",
              "Repeat the new Presslog password. Keyboard capture is stopped and will remain paused until you explicitly resume it.",
              "Confirm Presslog password:",
              "Create",
          )
          archive = Prompt(
              "Unlock Presslog archive",
              "Enter the passphrase protecting this Presslog archive.",
              "Archive passphrase:",
              "Unlock",
          )
          archive_new = Prompt(
              "Create Presslog archive",
              "Choose a separate passphrase for the exported Presslog archive.",
              "New archive passphrase:",
              "Continue",
          )
          archive_confirm = Prompt(
              "Confirm Presslog archive",
              "Repeat the new Presslog archive passphrase.",
              "Confirm archive passphrase:",
              "Create archive",
          )
          thumb = Prompt(
              "Unlock Presslog thumbdrive wrap",
              "Enter the passphrase protecting the wrapped Presslog keystore.",
              "Thumbdrive passphrase:",
              "Unlock",
          )
          thumb_new = Prompt(
              "Create Presslog thumbdrive wrap",
              "Choose a passphrase for the wrapped Presslog keystore.",
              "New thumbdrive passphrase:",
              "Continue",
          )
          thumb_confirm = Prompt(
              "Confirm Presslog thumbdrive wrap",
              "Repeat the new thumbdrive passphrase.",
              "Confirm thumbdrive passphrase:",
              "Create wrap",
          )
          table: dict[str, tuple[list[Prompt], list[int]]] = {
              "--presslog-existing": ([presslog], [0]),
              "--presslog-create": ([presslog_new, presslog_confirm], [0, 0]),
              "--archive-existing": ([archive], [0]),
              "--archive-create": ([archive_new, archive_confirm], [0, 0]),
              "--thumbdrive-existing-presslog-existing": ([thumb, presslog], [0, 1]),
              "--presslog-existing-thumbdrive-create": ([presslog, thumb_new, thumb_confirm], [0, 1, 1]),
              "--presslog-create-thumbdrive-create": ([presslog_new, presslog_confirm, thumb_new, thumb_confirm], [0, 0, 1, 1]),
          }
          try:
              return table[mode]
          except KeyError as exc:
              raise PinentryError(f"unknown secret mode: {mode}") from exc


      #@MNX-PART id=99.88.presslog-pinentry.function.emit-mode kind=function title="Python function emit_mode"
      def emit_mode(mode: str) -> int:
          pinentry = resolve_pinentry()
          prompts, output_indexes = prompts_for(mode)
          secrets: list[bytearray] = []
          try:
              index = 0
              while index < len(prompts):
                  if index + 1 < len(prompts) and output_indexes[index] == output_indexes[index + 1]:
                      secret = confirmed_pair(pinentry, prompts[index], prompts[index + 1])
                      secrets.append(secret)
                      index += 2
                  else:
                      secrets.append(request_password(pinentry, prompts[index]))
                      index += 1
              # output_indexes names the logical secret to emit for each core prompt.
              emit_lines(secrets[logical] for logical in output_indexes)
              return 0
          finally:
              for secret in secrets:
                  zeroize(secret)


      #@MNX-PART id=99.88.presslog-pinentry.function.check-program kind=function title="Python function check_program"
      def check_program() -> int:
          print(f"pinentry_program={resolve_pinentry()}")
          print("PRESSLOG_PINENTRY_PROGRAM_CHECK=PASS")
          return 0


      #@MNX-PART id=99.88.presslog-pinentry.function.self-test kind=function title="Python function self_test"
      def self_test() -> int:
          sample = " leading space, percent %, newline\n, snowman ☃ "
          encoded = assuan_escape(sample)
          decoded = assuan_unescape(encoded)
          if decoded != sample.encode("utf-8"):
              raise PinentryError("Assuan escape roundtrip failed")
          if b"%25" not in encoded or b"%0A" not in encoded or b"%E2%98%83" not in encoded:
              raise PinentryError("Assuan escaping did not cover protected bytes")
          if not hmac.compare_digest(bytearray(b"same"), bytearray(b"same")):
              raise PinentryError("constant-time comparison fixture failed")
          read_fd, write_fd = os.pipe()
          try:
              require_secret_pipe(write_fd)
          finally:
              os.close(read_fd)
              os.close(write_fd)
          expected_lines = {
              "--presslog-existing": 1,
              "--presslog-create": 2,
              "--archive-existing": 1,
              "--archive-create": 2,
              "--thumbdrive-existing-presslog-existing": 2,
              "--presslog-existing-thumbdrive-create": 3,
              "--presslog-create-thumbdrive-create": 4,
          }
          for mode, line_count in expected_lines.items():
              prompts, output_indexes = prompts_for(mode)
              if len(output_indexes) != line_count or not prompts:
                  raise PinentryError(f"mode contract failed: {mode}")
          os.environ["PRESSLOG_SELF_TEST_SECRET"] = "must-not-cross"
          if "PRESSLOG_SELF_TEST_SECRET" in pinentry_environment() or "must-not-cross" in pinentry_environment().values():
              raise PinentryError("pinentry environment allowlist leaked an unapproved variable")
          zeroize(decoded)
          print("PRESSLOG_PINENTRY_PIPE_POLICY_SELF_TEST=PASS")
          print("PRESSLOG_PINENTRY_ENVIRONMENT_POLICY_SELF_TEST=PASS")
          print("PRESSLOG_START_PAUSED_PROMPT_POLICY_SELF_TEST=PASS")
          print("PRESSLOG_PINENTRY_SELF_TEST=PASS")
          return 0


      #@MNX-PART id=99.88.presslog-pinentry.function.usage kind=function title="Python function usage"
      def usage() -> None:
          print(
              "usage: presslog-pinentry MODE | --self-test | --check-program\n"
              "modes: --presslog-existing --presslog-create --archive-existing --archive-create\n"
              "       --thumbdrive-existing-presslog-existing\n"
              "       --presslog-existing-thumbdrive-create\n"
              "       --presslog-create-thumbdrive-create",
              file=sys.stderr,
          )


      #@MNX-PART id=99.88.presslog-pinentry.function.main kind=function title="Python function main"
      def main(argv: list[str]) -> int:
          try:
              if argv == ["--self-test"]:
                  return self_test()
              if argv == ["--check-program"]:
                  return check_program()
              if len(argv) == 1 and argv[0].startswith("--"):
                  return emit_mode(argv[0])
              usage()
              return 64
          except PinentryCancelled as exc:
              print(f"presslog-pinentry: {exc}", file=sys.stderr)
              return 65
          except PinentryError as exc:
              print(f"presslog-pinentry: {exc}", file=sys.stderr)
              return 65
          except (OSError, subprocess.SubprocessError) as exc:
              print(f"presslog-pinentry: internal prompt failure: {exc}", file=sys.stderr)
              return 70


      if __name__ == "__main__":
          raise SystemExit(main(sys.argv[1:]))
      '';
      checkPhase = ''
        set -Eeuo pipefail
        ${pkgs.python3}/bin/python3 -m py_compile "$out"
        "$out" --self-test | ${pkgs.gnugrep}/bin/grep -Fx 'PRESSLOG_PINENTRY_SELF_TEST=PASS'
        "$out" --self-test | ${pkgs.gnugrep}/bin/grep -Fx 'PRESSLOG_PINENTRY_PIPE_POLICY_SELF_TEST=PASS'
        "$out" --self-test | ${pkgs.gnugrep}/bin/grep -Fx 'PRESSLOG_PINENTRY_ENVIRONMENT_POLICY_SELF_TEST=PASS'
        "$out" --self-test | ${pkgs.gnugrep}/bin/grep -Fx 'PRESSLOG_START_PAUSED_PROMPT_POLICY_SELF_TEST=PASS'
        "$out" --check-program | ${pkgs.gnugrep}/bin/grep -Fx 'PRESSLOG_PINENTRY_PROGRAM_CHECK=PASS'
        ${pkgs.gnugrep}/bin/grep -Fq 'stat.S_ISFIFO' "$out"
