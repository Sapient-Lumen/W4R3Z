#@MNX-DEF path=programs.firejail.enable section=30.60 role=policy ordinal=133
  programs.firejail.enable = true;

#@MNX-DEF path=environment.etc section=30.60 role=policy ordinal=134
  environment.etc = {
    "firejail/common.profile".text = ''
      caps.drop all
      nonewprivs
      noroot
      protocol unix,inet,inet6
      seccomp

      private-tmp
      private-dev
      read-only /usr
      read-only /etc

      # GPU / rendering devices
      whitelist /dev/dri
      noblacklist /dev/dri/card*

      # VPN/TAP support
      whitelist /dev/net/tun

      # Preserve PulseAudio / PipeWire / Wayland / D-Bus sockets
      include ${pkgs.firejail}/etc/firejail/whitelist-runuser-common.inc

      include ${pkgs.firejail}/etc/firejail/disable-common.inc
      include ${pkgs.firejail}/etc/firejail/disable-programs.inc
    '';

    "firejail/filesharing.profile".text = ''
      whitelist /mnt/torrents
      whitelist /mnt/m16-new-storage/public-share
    '';
  };

