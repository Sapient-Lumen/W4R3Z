  ####### Virtualization #######
  # virtualbox
#@MNX-DEF path=virtualisation.virtualbox.host.enableHardening section=30.60 role=policy ordinal=118
  virtualisation.virtualbox.host.enableHardening = true;  #3D acceleration issue:  https://github.com/NixOS/nixpkgs/issues/22760
#@MNX-DEF path=virtualisation.virtualbox.host.enableExtensionPack section=30.60 role=policy ordinal=119
  virtualisation.virtualbox.host.enableExtensionPack = true;

#@MNX-DEF path=virtualisation.libvirtd.enable section=30.60 role=policy ordinal=120
  virtualisation.libvirtd.enable = true;
#@MNX-DEF path=virtualisation.libvirtd.onShutdown section=30.60 role=policy ordinal=121
  virtualisation.libvirtd.onShutdown = "shutdown";
#@MNX-DEF path=virtualisation.libvirtd.qemu.runAsRoot section=30.60 role=policy ordinal=122
