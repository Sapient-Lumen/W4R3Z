      #@MNX-PART id=99.57.mnx-relations.class.relationerror kind=class title="Python class RelationError"
      class RelationError(RuntimeError):
          pass
            
            
      @dataclass(frozen=True)
      #@MNX-PART id=99.57.mnx-relations.class.chunkanchor kind=class title="Python class ChunkAnchor"
      class ChunkAnchor:
          chunk_id: str
