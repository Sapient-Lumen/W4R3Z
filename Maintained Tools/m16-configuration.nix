      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.candidate-dispatch kind=function title="Portable Python function candidate_dispatch"
      def candidate_dispatch(accepted: dict, args: argparse.Namespace) -> int:
          if not args.arguments:
              raise Error('candidate requires an action: init, import, status, check, diff, review, apply-capsule, apply-history, apply-turn-close, package, proposal-check, or self-test')
          action = args.arguments[0]
          rest = args.arguments[1:]
          if action == 'self-test':
              candidate_self_test()
              return 0
          if action == 'init':
              if rest:
                  raise Error('candidate init accepts no positional arguments; use --workspace')
              result = workspace_init(accepted, args.workspace)
              print(canonical(result) if args.json else candidate_render_status(result), end="")
              return 0
          if action == 'import':
              if len(rest) != 1:
                  raise Error('candidate import requires one complete source path')
              result = workspace_import(accepted, args.workspace, Path(rest[0]))
              print(canonical(result) if args.json else candidate_render_status(result), end="")
              return 0
          if action == 'status':
              workspace = workspace_load(args.workspace, accepted)
              raw = workspace['candidate_path'].read_bytes()
              result = {
                  'schema': 'mnx.cloudtainer.candidate-status.v1',
                  'status': 'present',
                  'workspace': str(workspace['root']),
                  'accepted_source_sha256': accepted['source_sha256'],
                  'accepted_stage': accepted['candidate_stage'],
                  'next_stage': int(accepted['office_agenda']['after_acceptance_next_stage']),
                  'candidate': str(workspace['candidate_path']),
                  'candidate_sha256': sha256_bytes(raw),
                  'candidate_bytes': len(raw),
                  'candidate_differs_from_accepted': sha256_bytes(raw) != accepted['source_sha256'],
                  'network_used': False,
                  'source_executed': False,
                  'host_state_mutated': False,
              }
              print(canonical(result) if args.json else candidate_render_status(result), end="")
              return 0
          if action == 'check':
              result = candidate_check(accepted, args.workspace)
              if args.json:
                  print(canonical(result), end="")
              else:
                  print(candidate_render_status({
                      'status': result['status'],
                      'workspace': result['workspace'],
                      'accepted_source_sha256': result['accepted_source_sha256'],
                      'accepted_stage': result['accepted_stage'],
                      'next_stage': result['expected_candidate_stage'],
                      'candidate_sha256': result['candidate_source_sha256'],
                  }), end="")
                  for failure in result['failures']:
                      print(f'failure={failure}')
                  for warning in result['warnings']:
                      print(f'warning={warning}')
                  print('MNX_CLOUDTAINER_CANDIDATE_CHECK=' + ('PASS' if result['status'] == 'pass' else 'FAIL'))
              return 0 if result['status'] == 'pass' else 1
          if action == 'review':
              result = candidate_review(accepted, args.workspace)
              print(canonical(result) if args.json else candidate_render_review(result), end="")
              return 0 if result['status'] == 'ready-for-host-test' else 1
          if action == 'diff':
              result = candidate_diff(accepted, args.workspace, args.full)
              print(canonical(result) if args.json else result['diff'], end="")
              if not args.json and result['truncated']:
                  print(f"\nMNX_CLOUDTAINER_DIFF_TRUNCATED shown={result['shown_line_count']} total={result['diff_line_count']} use=--full")
              return 0
          if action in {'apply-capsule', 'apply-history', 'apply-turn-close'}:
              if len(rest) > 1:
                  raise Error(f'candidate {action} accepts at most one block file')
              if rest:
                  payload = Path(rest[0])
              elif action == 'apply-capsule':
                  payload = packet_root() / 'TURN-CLOSE.txt'
              elif action == 'apply-history':
                  payload = packet_root() / 'TURN-CLOSE.txt'
              else:
                  payload = packet_root() / 'TURN-CLOSE.txt'
              mode = {'apply-capsule': 'capsule', 'apply-history': 'history', 'apply-turn-close': 'turn-close'}[action]
              result = workspace_apply_blocks(accepted, args.workspace, payload, mode)
              print(canonical(result) if args.json else candidate_render_status(result), end="")
              return 0
          if action == 'package':
              if rest:
                  raise Error('candidate package accepts no positional arguments; use --output')
              result = proposal_package(accepted, args.workspace, args.output)
              print(canonical(result) if args.json else '\n'.join([
                  '################################################################################',
                  '# MNX CLOUDTAINER — COMPLETE CANDIDATE PROPOSAL READY',
                  '################################################################################',
                  f"proposal={result['proposal']}",
                  f"archive={result['archive']}",
                  f"archive_sha256={result['archive_sha256']}",
                  f"candidate_source_sha256={result['candidate_source_sha256']}",
                  f"candidate_stage={result['candidate_stage']}",
                  'manifest_status=verified',
                  'host_validation_required=yes',
                  'operator_commands=mnx-test-then-mnx-switch',
                  'MNX_CLOUDTAINER_CANDIDATE_PACKAGE=PASS',
                  "",
              ]), end="")
              return 0
          if action == 'proposal-check':
              if len(rest) != 1:
                  raise Error('candidate proposal-check requires one proposal directory')
              result = archive_check(Path(rest[0])) if rest[0].endswith(('.tar.gz','.tgz')) else proposal_verify(Path(rest[0]))
              print(canonical(result) if args.json else '\n'.join(f'{key}={value}' for key, value in result.items()) + '\nMNX_CLOUDTAINER_CANDIDATE_PROPOSAL_CHECK=PASS\n', end="")
              return 0
          raise Error(f'unsupported candidate action: {action}')
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.wake-verification kind=function title="Portable Python function wake_verification"
      def wake_verification() -> dict:
          root = packet_root()
          packet_metadata = root / 'packet.json'
          proposal_metadata = root / 'proposal.json'
          manifest_signals = [root / SHA_MANIFEST_NAME, root / TREE_MANIFEST_NAME]
          if packet_metadata.exists() or packet_metadata.is_symlink():
              return {'mode':'verified-closed-tree','status':'pass','result':packet_verify(root)}
          if proposal_metadata.exists() or proposal_metadata.is_symlink():
              return {'mode':'verified-proposal-closed-tree','status':'pass','result':proposal_verify(root)}
          if any(item.exists() or item.is_symlink() for item in manifest_signals):
              raise Error('manifested cloudtainer object lacks recognized packet.json or proposal.json metadata')
          return {'mode':'source-only-stable-read','status':'pass','result':None}

      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.wake-payload kind=function title="Portable Python function wake_payload"
      def wake_payload(record: dict, verification: dict) -> dict:
          brief_wrapper = packet_json('BRIEF.json')
          office_wrapper = packet_json('OFFICE-RESUME.json')
          runtime_wrapper = packet_json('RUNTIME-OVERLAY.json')
          brief = brief_wrapper.get('payload', {}) if brief_wrapper.get('status') == 'pass' and isinstance(brief_wrapper.get('payload'), dict) else {}
          office_outer = office_wrapper.get('payload', {}) if office_wrapper.get('status') == 'pass' and isinstance(office_wrapper.get('payload'), dict) else {}
          office = office_outer.get('payload', {}) if office_outer.get('status') == 'pass' and isinstance(office_outer.get('payload'), dict) else office_outer
          runtime = runtime_wrapper.get('payload', {}) if runtime_wrapper.get('status') == 'pass' and isinstance(runtime_wrapper.get('payload'), dict) else {}
          wake = brief.get('wake', {}) if isinstance(brief.get('wake'), dict) else {}
          agenda = record['office_agenda']
          latest_switch = runtime.get('latest_switch', {}) if isinstance(runtime.get('latest_switch'), dict) else {}
          unknowns = wake.get('unknowns', []) if isinstance(wake.get('unknowns'), list) else []
          effective_stage = wake.get('effective_next_stage') or office.get('effective_next_stage') or agenda.get('after_acceptance_next_stage', 'unknown')
          effective_objective = wake.get('effective_next_objective') or office.get('effective_next_objective') or agenda.get('after_acceptance_next_objective', 'unknown')
          identity_state = wake.get('identity_state') or ('carried-object-verified' if verification['mode'].startswith('verified') else 'source-only-stable-read')
          identity_verified = wake.get('identity_verified') if isinstance(wake.get('identity_verified'), bool) else verification['mode'].startswith('verified')
          return {
              'schema':'mnx.cloudtainer.portable-wake.v1',
              'packet_verification':verification['mode'],
              'identity_verified':identity_verified,
              'identity_state':identity_state,
              'source_sha256':record['source_sha256'],
              'document_schema':record['document_schema'],
              'accepted_stage':wake.get('accepted_stage') or office.get('accepted_stage') or record['candidate_stage'],
              'candidate_stage':wake.get('candidate_stage') or agenda.get('candidate_stage') or record['candidate_stage'],
              'runtime_state':runtime.get('system_state', 'unavailable'),
              'final_switch_result':latest_switch.get('mnx_switch_result', 'unknown'),
              'authority':'current-operator-request-outranks-inherited-intent;carried-evidence-is-not-permission',
              'operator_request':'current-conversation-only-not-carried-in-packet',
              'effective_next_stage':effective_stage,
              'effective_next_objective':effective_objective,
              'blocking_state':wake.get('blocking_state', 'none'),
              'review_state':wake.get('review_state', 'none'),
              'unknowns':unknowns,
              'officer_action':'deliver-one-complete-configuration.nix',
              'operator_commands':{'routine_command_count':2,'test':'sudo mnx test','switch':'sudo mnx switch','third_routine_command':False},
              'progressive_disclosure':['bin/mnx-cloudtainer brief --full','bin/mnx-cloudtainer history','bin/mnx-cloudtainer next','bin/mnx-cloudtainer issues','bin/mnx-cloudtainer commands'],
              'network_used':False,
              'mutation':'none',
          }

