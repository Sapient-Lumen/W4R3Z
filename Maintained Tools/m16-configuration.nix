  ##### Fonts #####

#@MNX-DEF path=i18n.defaultLocale section=30.50 role=policy ordinal=109
  i18n.defaultLocale = "en_US.UTF-8";
#@MNX-DEF path=console section=30.50 role=policy ordinal=110
  console = {
    font = "Lat2-Terminus16";
    keyMap = "us";
  };

#@MNX-DEF path=fonts section=30.50 role=policy ordinal=111
  fonts = {
    enableGhostscriptFonts = true;
    fontDir.enable = true;
    packages = with pkgs; [
      open-fonts
      google-fonts
      powerline-fonts
      vista-fonts
      corefonts
      redhat-official-fonts
      liberation_ttf
      freefont_ttf
      roboto
      roboto-mono
      ultimate-oldschool-pc-font-pack
      libre-caslon
      noto-fonts
      noto-fonts-cjk-sans
      noto-fonts-cjk-serif
      twitter-color-emoji
      noto-fonts-color-emoji
      libertine
      dejavu_fonts
      nerd-fonts.symbols-only
      unifont
      cantarell-fonts
    ];
    fontconfig = {
      enable = true;
      antialias = true;
      allowBitmaps = true;
      useEmbeddedBitmaps = true;
      cache32Bit = true;
      hinting = {
        enable = true;
        style = "slight";
      };
      defaultFonts = {
        serif = [ "Noto Serif" "Noto Serif CJK SC" "DejaVu Serif" ];
        sansSerif = [ "Noto Sans" "Noto Sans CJK SC" "DejaVu Sans" ];
        monospace = [ "Noto Sans Mono" "Noto Sans Mono CJK SC" "DejaVu Sans Mono" ];
        emoji = [ "Twitter Color Emoji" "Noto Color Emoji" ];
      };
    };
  };
#@MNX-DEF path=environment.etc."xdg/gtk-3.0/settings.ini".text section=30.50 role=generated-config ordinal=112
  environment.etc."xdg/gtk-3.0/settings.ini".text = ''
    [Settings]
    gtk-application-prefer-dark-theme=1
    gtk-icon-theme-name=Adwaita
    gtk-font-name=Noto Sans 10
  '';


