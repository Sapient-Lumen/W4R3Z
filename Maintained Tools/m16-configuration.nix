#@MNX-CHUNK id=20.10 slug=nixos-core title="Core NixOS policy, upgrades, and garbage collection"
#######################################################################################################
# SECTION 20 — CORE NIXOS POLICY
#######################################################################################################

  ########## NixOS ##########

#@MNX-DEF path=system.stateVersion section=20.10 role=policy ordinal=017
  system.stateVersion = "24.11"; # Set the NixOS version to ensure state compatibility.
#@MNX-DEF path=system.copySystemConfiguration section=20.10 role=policy ordinal=018
  system.copySystemConfiguration = true; # Embed this exact monolith in each closure. /run/current-system/configuration.nix is intentionally a symlink; MNX resolves and audits its /nix/store target.

#@MNX-DEF path=nixpkgs.config.allowUnfree section=20.10 role=policy ordinal=019
  nixpkgs.config.allowUnfree = true; # Permit installation of packages not meeting the free software definition.
#@MNX-DEF path=nix.settings section=20.10 role=policy ordinal=020
  nix.settings = {
    experimental-features = [ "nix-command" "flakes" ];
    auto-optimise-store = true; # Enable Nix store optimization for efficiency.
  };

  ### Reserve the former 06:00 window for a future MNX-owned upgrade transaction; keep GC and backups separated.
#@MNX-DEF path=nix.gc.automatic section=20.10 role=policy ordinal=021
  nix.gc.automatic = true; # Activate automatic garbage collection to manage disk space.
#@MNX-DEF path=nix.gc.dates section=20.10 role=policy ordinal=022
  nix.gc.dates = "06:45"; # Retain the established GC window before backup work; raw auto-upgrade switching is disabled.
#@MNX-DEF path=nix.gc.options section=20.10 role=policy ordinal=023
  nix.gc.options = "--delete-older-than 200d"; # Clean up generations older than 200 days (because I don't switch nearly as often anymore, though there's something to be said for filesystem level versioning)

#@MNX-DEF path=system.autoUpgrade.enable section=20.10 role=policy ordinal=024
  system.autoUpgrade.enable = false; # Raw nixos-upgrade switching bypasses mnx test/switch, behavior review, and office acceptance; keep disabled until an MNX-owned upgrade transaction exists.
#@MNX-DEF path=system.autoUpgrade.dates section=20.10 role=policy ordinal=025
  system.autoUpgrade.dates = "6:00"; # Inert historical preferred schedule; system.autoUpgrade is intentionally disabled by the MNX upgrade contract.
#@MNX-DEF path=system.autoUpgrade.randomizedDelaySec section=20.10 role=policy ordinal=026
  system.autoUpgrade.randomizedDelaySec = "15min"; # Inert historical jitter retained for a future MNX-owned upgrade advisory/transaction.
  #system.autoUpgrade.allowReboot = true; # Allow the system to reboot automatically if required by the upgrade.
  #system.autoUpgrade.rebootWindow = { lower = "06:30";  upper = "06:45"; }; # Define a specific time window for when reboots can occur, minimizing downtime.

  # Keep unattended Nix work polite. The 2026-06-15 incident was not caused by Nix,
  # but GC + btrbk starting at the exact same second made the morning harder to reason about.
#@MNX-DEF path=systemd.services.nix-gc.serviceConfig section=20.10 role=service ordinal=027
  systemd.services.nix-gc.serviceConfig = {
    Nice = 10;
    IOSchedulingClass = "idle";
  };

#@MNX-DEF path=systemd.services.nixos-upgrade.enable section=20.10 role=policy ordinal=028
  systemd.services.nixos-upgrade.enable = false; # Retire the stale no-ExecStart stub left behind after raw auto-upgrade was disabled; future upgrades must be MNX-owned.



#@MNX-CHUNK id=30.10 slug=users-authentication title="Users, groups, authentication, and privilege policy"
