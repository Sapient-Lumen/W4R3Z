          ]) + '\n'
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.cloudtainer-latest-completed kind=function title="Python function cloudtainer_latest_completed"
      def cloudtainer_latest_completed(root: Path, pattern: str, marker: str) -> Path | None:
          try:
              candidates = sorted((path for path in root.glob(pattern) if path.is_file()), key=lambda path: path.stat().st_mtime_ns, reverse=True)
          except OSError:
              return None
          for path in candidates:
              try:
                  if marker in path.read_text(encoding='utf-8', errors='replace'):
                      return path
              except OSError:
                  continue
          return None
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.cloudtainer-key-values kind=function title="Python function cloudtainer_key_values"
      def cloudtainer_key_values(path: Path | None, keys: tuple[str, ...] | None = None) -> dict:
          if path is None:
              return {'status': 'unavailable'}
          data: dict[str, str] = {'path': str(path)}
          try:
              for line in path.read_text(encoding='utf-8', errors='replace').splitlines():
                  if '=' not in line:
                      continue
                  key, value = line.split('=', 1)
                  if keys is None or key in keys:
                      data[key] = value
          except OSError as exc:
              return {'status': 'unreadable', 'path': str(path), 'error': str(exc)}
          data['status'] = 'present'
          return data
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.cloudtainer-run-json kind=function title="Python function cloudtainer_run_json"
      def cloudtainer_run_json(command: list[str]) -> dict:
          try:
              completed = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=120, check=False)
          except (OSError, subprocess.TimeoutExpired) as exc:
              return {'status': 'unavailable', 'command': command, 'error': str(exc)}
          if completed.returncode != 0:
              return {'status': 'nonzero', 'command': command, 'returncode': completed.returncode, 'stderr': completed.stderr[-4096:]}
          try:
              payload = json.loads(completed.stdout)
          except json.JSONDecodeError as exc:
              return {'status': 'invalid-json', 'command': command, 'error': str(exc), 'stdout_tail': completed.stdout[-4096:]}
          return {'status': 'pass', 'payload': payload}
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.cloudtainer-failed-units kind=function title="Python function cloudtainer_failed_units"
      def cloudtainer_failed_units() -> list[str]:
          systemctl = shutil.which('systemctl')
          if not systemctl:
              return []
          try:
              completed = subprocess.run([systemctl, '--failed', '--no-legend', '--plain', '--no-pager'], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=20, check=False)
          except (OSError, subprocess.TimeoutExpired):
              return []
          units = []
          for line in completed.stdout.splitlines():
              fields = line.split()
              if fields and fields[0].endswith(('.service','.socket','.mount','.timer','.target')):
                  units.append(fields[0])
          return sorted(set(units))
      
      
