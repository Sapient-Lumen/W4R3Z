#@MNX-PART id=90.00.monsterdesk.function.f023kj1-qbittorrent-reviewed-paths kind=function title="Python function qbittorrent_reviewed_paths"
def qbittorrent_reviewed_paths(configured: dict[str, Any]) -> dict[str, str]:
    result = {str(item.get("kind")): str(item.get("path")) for item in configured.get("paths", [])}
    expected = {
        "save-path": str(EXPECTED_QBITTORRENT_SAVE_PATH),
        "temporary-path": str(EXPECTED_QBITTORRENT_TEMP_PATH),
        "finished-torrent-export-path": str(EXPECTED_QBITTORRENT_FINISHED_EXPORT_PATH),
    }
    if result != expected:
        raise MonsterdeskError(
            "qBittorrent reviewed path semantics differ: "
            + canonical({"observed": result, "expected": expected})
        )
    return result


#@MNX-PART id=90.00.monsterdesk.function.f023kj2-qbittorrent-source-semantics kind=function title="Python function qbittorrent_source_config_semantics"
def qbittorrent_source_config_semantics(raw: bytes) -> dict[str, Any]:
    configured = parse_qbittorrent_config(raw)
    if configured.get("listen_port") != EXPECTED_QBITTORRENT_LISTEN_PORT:
        raise MonsterdeskError("qBittorrent source config changed the reviewed peer port")
    if configured.get("interface_name") != "" or configured.get("interface_address") != "":
        raise MonsterdeskError("qBittorrent source config changed the reviewed interface policy")
    if configured.get("anonymous_mode") is not True:
        raise MonsterdeskError("qBittorrent source config changed anonymous mode")
    webui = configured.get("web_ui", {})
    if (webui.get("enabled") is not True
            or webui.get("address") != EXPECTED_QBITTORRENT_WEBUI_ADDRESS
            or webui.get("port") != EXPECTED_QBITTORRENT_WEBUI_PORT):
        raise MonsterdeskError("qBittorrent source config changed the reviewed Web UI endpoint")
    qbittorrent_reviewed_paths(configured)
    return configured


#@MNX-PART id=90.00.monsterdesk.function.f023kj3-qbittorrent-private-semantics kind=function title="Python function qbittorrent_private_config_semantics"
def qbittorrent_private_config_semantics(raw: bytes) -> dict[str, Any]:
    configured = parse_qbittorrent_config(raw)
    if configured.get("listen_port") != EXPECTED_QBITTORRENT_LISTEN_PORT:
        raise MonsterdeskError("qBittorrent private config changed the peer port")
    if configured.get("interface_name") != "" or configured.get("interface_address") != "":
        raise MonsterdeskError("qBittorrent private config changed the interface policy")
    if configured.get("port_forwarding_enabled") is not False:
        raise MonsterdeskError("qBittorrent private config did not disable in-application port forwarding")
    if configured.get("random_port_on_start") is not False:
        raise MonsterdeskError("qBittorrent private config did not disable random listen ports")
    if configured.get("dht_enabled") is not True or configured.get("pex_enabled") is not True:
        raise MonsterdeskError("qBittorrent private config did not preserve DHT and PeX")
    if configured.get("lsd_enabled") is not False:
        raise MonsterdeskError("qBittorrent private config did not disable LSD")
    if configured.get("anonymous_mode") is not True:
        raise MonsterdeskError("qBittorrent private config changed anonymous mode")
    if configured.get("startup_window_state") != EXPECTED_QBITTORRENT_PRIVATE_STARTUP_WINDOW_STATE:
        raise MonsterdeskError("qBittorrent private config did not force a normal startup window")
    if configured.get("ui_locked") is not False:
        raise MonsterdeskError("qBittorrent private config did not clear the copied UI locked state")
    webui = configured.get("web_ui", {})
    if (webui.get("enabled") is not True
            or webui.get("address") != "127.0.0.1"
            or webui.get("port") != EXPECTED_QBITTORRENT_WEBUI_PORT):
        raise MonsterdeskError("qBittorrent private Web UI is not loopback-only on the reviewed port")
    qbittorrent_reviewed_paths(configured)
    return configured


#@MNX-PART id=90.00.monsterdesk.function.f023kj4-qbittorrent-set-ini-option kind=function title="Python function qbittorrent_set_ini_option"
def qbittorrent_set_ini_option(text: str, section: str, option: str, value: str,
                                   *, create_section: bool = False) -> str:
    lines = text.splitlines(keepends=True)
    section_pattern = re.compile(r"^\s*\[([^]\r\n]+)\]\s*(?:[;#].*)?(?:\r?\n)?$")
    headers: list[tuple[int, str]] = []
    for index, line in enumerate(lines):
        match = section_pattern.match(line)
        if match is not None:
            headers.append((index, match.group(1).strip()))
    matching = [index for index, name in headers if name.lower() == section.lower()]
    if not matching and create_section:
        newline = "\r\n" if any(line.endswith("\r\n") for line in lines) else "\n"
        if lines and not lines[-1].endswith(("\n", "\r")):
            lines[-1] += newline
        if lines and lines[-1].strip():
            lines.append(newline)
        lines.extend([f"[{section}]{newline}", f"{option}={value}{newline}"])
        return "".join(lines)
    if len(matching) != 1:
        raise MonsterdeskError(
            f"qBittorrent private config expected one [{section}] section, found {len(matching)}"
        )
    start = matching[0]
    end = next((index for index, _name in headers if index > start), len(lines))
    option_pattern = re.compile(
        rf"^(\s*{re.escape(option)}\s*=\s*)([^\r\n]*?)(\r?\n)?$",
        re.IGNORECASE,
    )
    matches = [index for index in range(start + 1, end) if option_pattern.match(lines[index])]
    if len(matches) > 1:
        raise MonsterdeskError(
            f"qBittorrent private config duplicated [{section}] {option}"
        )
    if matches:
        index = matches[0]
        match = option_pattern.match(lines[index])
        if match is None:
            raise MonsterdeskError("qBittorrent private option disappeared during rewrite")
        lines[index] = f"{match.group(1)}{value}{match.group(3) or '''}"
    else:
        newline = "\r\n" if any(line.endswith("\r\n") for line in lines) else "\n"
        lines.insert(start + 1, f"{option}={value}{newline}")
    return "".join(lines)


#@MNX-PART id=90.00.monsterdesk.function.f023kj5-render-qbittorrent-private-config kind=function title="Python function render_qbittorrent_private_config"
def render_qbittorrent_private_config(raw: bytes) -> str:
    qbittorrent_source_config_semantics(raw)
    try:
        rendered = raw.decode("utf-8", errors="strict")
    except UnicodeDecodeError as exc:
        raise MonsterdeskError("qBittorrent private source config is not strict UTF-8") from exc
    mutations = (
        ("BitTorrent", r"Session\Port", str(EXPECTED_QBITTORRENT_LISTEN_PORT)),
        ("BitTorrent", r"Session\PortForwardingEnabled", "false"),
        ("BitTorrent", r"Session\UseRandomPort", "false"),
        ("BitTorrent", r"Session\DHTEnabled", "true"),
        ("BitTorrent", r"Session\PeXEnabled", "true"),
        ("BitTorrent", r"Session\LSDEnabled", "false"),
        ("BitTorrent", r"Session\AnonymousModeEnabled", "true"),
        ("Preferences", r"WebUI\Enabled", "true"),
        ("Preferences", r"WebUI\Address", "127.0.0.1"),
        ("Preferences", r"WebUI\Port", str(EXPECTED_QBITTORRENT_WEBUI_PORT)),
    )
    for section, option, value in mutations:
        rendered = qbittorrent_set_ini_option(rendered, section, option, value)
    rendered = qbittorrent_set_ini_option(
        rendered, "GUI", "StartUpWindowState",
        EXPECTED_QBITTORRENT_PRIVATE_STARTUP_WINDOW_STATE, create_section=True
    )
    rendered = qbittorrent_set_ini_option(
        rendered, "Locking", "locked", "false", create_section=True
    )
    qbittorrent_private_config_semantics(rendered.encode("utf-8"))
    return rendered


#@MNX-PART id=90.00.monsterdesk.function.f023kj6-scan-qbittorrent-live-seed kind=function title="Python function scan_qbittorrent_live_seed_source"
def scan_qbittorrent_live_seed_source(source: Path) -> dict[str, int]:
    selected = source.expanduser()
    root = selected.resolve(strict=True)
    root_st = selected.lstat()
    if stat.S_ISLNK(root_st.st_mode) or not stat.S_ISDIR(root_st.st_mode) or root_st.st_uid != USER_UID:
        raise MonsterdeskError(f"qBittorrent private-state source is unsafe: {selected}")
    objects = 0
    directories = 1
    logical_bytes = 0
    symlinks = 0
    for base, dirs, names in os.walk(selected, followlinks=False):
        base_path = Path(base)
        retained: list[str] = []
        for name in dirs:
            path = base_path / name
            st = path.lstat()
            if st.st_uid != USER_UID:
                raise MonsterdeskError(f"qBittorrent private-state object has foreign owner: {path}")
            objects += 1
            if objects > MAX_QBITTORRENT_LIVE_SEED_FILES:
                raise MonsterdeskError("qBittorrent private-state exceeds object-count limit")
            if stat.S_ISLNK(st.st_mode):
                target = os.readlink(path)
                if os.path.isabs(target):
                    raise MonsterdeskError(f"qBittorrent private-state has absolute directory symlink: {path}")
                resolved = (path.parent / target).resolve(strict=False)
                try:
                    resolved.relative_to(root)
                except ValueError as exc:
                    raise MonsterdeskError(f"qBittorrent private-state directory symlink escapes source: {path}") from exc
                symlinks += 1
            elif stat.S_ISDIR(st.st_mode):
                directories += 1
                retained.append(name)
            else:
                raise MonsterdeskError(f"qBittorrent private-state contains a special directory entry: {path}")
        dirs[:] = retained
        for name in names:
            path = base_path / name
            st = path.lstat()
            if st.st_uid != USER_UID:
                raise MonsterdeskError(f"qBittorrent private-state object has foreign owner: {path}")
            objects += 1
            if objects > MAX_QBITTORRENT_LIVE_SEED_FILES:
                raise MonsterdeskError("qBittorrent private-state exceeds object-count limit")
            if stat.S_ISREG(st.st_mode):
                logical_bytes += int(st.st_size)
                if logical_bytes > MAX_QBITTORRENT_LIVE_SEED_BYTES:
                    raise MonsterdeskError("qBittorrent private-state exceeds logical-byte limit")
            elif stat.S_ISLNK(st.st_mode):
                target = os.readlink(path)
                if os.path.isabs(target):
                    raise MonsterdeskError(f"qBittorrent private-state has absolute symlink: {path}")
                resolved = (path.parent / target).resolve(strict=False)
                try:
                    resolved.relative_to(root)
                except ValueError as exc:
                    raise MonsterdeskError(f"qBittorrent private-state symlink escapes source: {path}") from exc
                symlinks += 1
            else:
                raise MonsterdeskError(f"qBittorrent private-state contains a special file: {path}")
    return {
        "objects": objects,
        "directories": directories,
        "logical_bytes": logical_bytes,
        "symlinks": symlinks,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kj7-copy-qbittorrent-live-seed kind=function title="Python function copy_qbittorrent_live_seed"
def copy_qbittorrent_live_seed(source: Path, destination: Path) -> dict[str, Any]:
    inventory = scan_qbittorrent_live_seed_source(source)
    source_device = int(source.resolve(strict=True).stat().st_dev)
    if destination.exists() or destination.is_symlink():
        raise MonsterdeskError(f"qBittorrent private-state destination already exists: {destination}")
    destination.mkdir(parents=True, mode=0o700)
    os.chmod(destination, 0o700)
    destination_device = int(destination.lstat().st_dev)
    result = run_checked([
        str(CP), "-a", "--reflink=auto", "--sparse=always", "--",
        str(source) + "/.", str(destination),
    ], timeout=900)
    if result.stdout or result.stderr:
        raise MonsterdeskError("qBittorrent adaptive private-state copy emitted unexpected output")
    st = destination.lstat()
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode) or st.st_uid != USER_UID:
        raise MonsterdeskError("qBittorrent private-state destination is unsafe after copy")
    destination_inventory = scan_qbittorrent_live_seed_source(destination)
    if destination_inventory != inventory:
        raise MonsterdeskError(
            "qBittorrent private-state copy inventory differs: "
            + canonical({"source": inventory, "destination": destination_inventory})
        )
    return {
        **inventory,
        "copy_mode": "archive-reflink-auto",
        "source_device": source_device,
        "destination_device": destination_device,
        "cross_filesystem": source_device != destination_device,
        "clone_required": False,
        "byte_copy_fallback_allowed": True,
        "destination_inventory_matched": True,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kj8-rewrite-qbittorrent-private-config kind=function title="Python function rewrite_qbittorrent_private_config"
def rewrite_qbittorrent_private_config(config_path: Path, *, expected_source_sha256: str) -> dict[str, Any]:
    raw, before = stable_regular_read(config_path, MAX_QBITTORRENT_CONFIG_BYTES, expected_uid=USER_UID)
    if before["sha256"] != expected_source_sha256:
        raise MonsterdeskError("qBittorrent source config changed during private migration")
    rendered = render_qbittorrent_private_config(raw)
    atomic_text(config_path, rendered, 0o600)
    os.chmod(config_path, 0o600)
    private_raw, private_meta = stable_regular_read(
        config_path, MAX_QBITTORRENT_CONFIG_BYTES, expected_uid=USER_UID
    )
    qbittorrent_private_config_semantics(private_raw)
    if int(private_meta["mode"]) != 0o600:
        raise MonsterdeskError("qBittorrent private config mode did not become 0600")
    return {
        "source_sha256": before["sha256"],
        "private_sha256": private_meta["sha256"],
        "private_mode": int(private_meta["mode"]),
        "credential_values_exported": False,
        "rewrite_scope": "reviewed-network-webui-and-private-gui-visibility-options-only",
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kj9-prepare-qbittorrent-live-home kind=function title="Python function prepare_qbittorrent_live_home"
def prepare_qbittorrent_live_home(home: Path, *, source_config_sha256: str) -> dict[str, Any]:
    marker = home / ".monsterdesk-qbittorrent-live.json"
    if marker.exists():
        return verify_qbittorrent_live_seed(home)
    if any(home.iterdir()):
        raise MonsterdeskError("qBittorrent live private home is not empty before first migration")
    config_target = home / ".config/qBittorrent"
    data_target = home / ".local/share/qBittorrent"
    config_copy = copy_qbittorrent_live_seed(EXPECTED_QBITTORRENT_CONFIG_PATH.parent, config_target)
    data_copy = copy_qbittorrent_live_seed(EXPECTED_QBITTORRENT_DATA_PATH, data_target)
    rewritten = rewrite_qbittorrent_private_config(
        config_target / "qBittorrent.conf", expected_source_sha256=source_config_sha256
    )
    secure_dir(home / ".cache")
    secure_dir(home / ".local/state")
    value = {
        "schema": "mnx.monsterdesk.qbittorrent-live-seed.v1",
        "profile": "qbittorrent-live",
        "created_at": time.time(),
        "source_config_sha256": source_config_sha256,
        "accepted_stage115_config_sha256": EXPECTED_QBITTORRENT_STAGE115_CONFIG_SHA256,
        "private_config_sha256": rewritten["private_sha256"],
        "private_config_mode": rewritten["private_mode"],
        "private_policy_applied": True,
        "credential_values_exported": False,
        "source_state_deleted": False,
        "config_copy": config_copy,
        "data_copy": data_copy,
    }
    atomic_json(marker, value)
    os.chmod(marker, 0o600)
    return value


#@MNX-PART id=90.00.monsterdesk.function.f023kka-verify-qbittorrent-live-seed kind=function title="Python function verify_qbittorrent_live_seed"
def verify_qbittorrent_live_seed(home: Path) -> dict[str, Any]:
    marker = home / ".monsterdesk-qbittorrent-live.json"
    try:
        st = marker.lstat()
    except OSError as exc:
        raise MonsterdeskError(f"qBittorrent live seed marker is unavailable: {exc}") from exc
    if (stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode)
            or st.st_uid != USER_UID or stat.S_IMODE(st.st_mode) != 0o600 or st.st_nlink != 1):
        raise MonsterdeskError("qBittorrent live seed marker ownership, mode, type, or link count differs")
    try:
        value = json.loads(marker.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise MonsterdeskError(f"qBittorrent live seed marker is unreadable: {exc}") from exc
    if (not isinstance(value, dict)
            or value.get("schema") != "mnx.monsterdesk.qbittorrent-live-seed.v1"
            or value.get("profile") != "qbittorrent-live"
            or not re.fullmatch(r"[0-9a-f]{64}", str(value.get("source_config_sha256", "")))
            or value.get("accepted_stage115_config_sha256") != EXPECTED_QBITTORRENT_STAGE115_CONFIG_SHA256
            or value.get("private_policy_applied") is not True
            or value.get("credential_values_exported") is not False
            or value.get("source_state_deleted") is not False):
        raise MonsterdeskError("qBittorrent live seed contract differs")
    raw, metadata = stable_regular_read(
        home / ".config/qBittorrent/qBittorrent.conf",
        MAX_QBITTORRENT_CONFIG_BYTES,
        expected_uid=USER_UID,
    )
    qbittorrent_private_config_semantics(raw)
    if int(metadata["mode"]) != 0o600:
        raise MonsterdeskError("qBittorrent live private config is not mode 0600")
    return {
        **value,
        "private_config_current_sha256": metadata["sha256"],
        "private_config_current_mode": int(metadata["mode"]),
        "semantic_boundary_matched": True,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kkb-qbittorrent-live-bind-specs kind=function title="Python function qbittorrent_live_bind_specs"
def qbittorrent_live_bind_specs() -> list[tuple[Path, str, bool]]:
    roots = (EXPECTED_QBITTORRENT_SAVE_PATH, EXPECTED_QBITTORRENT_TEMP_PATH)
    if any(not path.is_absolute() or path == Path("/") for path in roots) or len(set(roots)) != 2:
        raise MonsterdeskError("canonical qBittorrent writable roots are invalid")
    if not EXPECTED_QBITTORRENT_FINISHED_EXPORT_PATH.is_relative_to(EXPECTED_QBITTORRENT_SAVE_PATH):
        raise MonsterdeskError("qBittorrent finished-export path is outside the save root")
    return [(path, "read-write", True) for path in roots]


#@MNX-PART id=90.00.monsterdesk.function.f023kkc-qbittorrent-cutover-lock kind=function title="Python function acquire_qbittorrent_cutover_lock"
def acquire_qbittorrent_cutover_lock() -> int:
    path = runtime_base() / "monsterdesk-qbittorrent-cutover.lock"
    flags = os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags, 0o600)
    try:
        st = os.fstat(fd)
        if (not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid()
                or stat.S_IMODE(st.st_mode) != 0o600 or st.st_nlink != 1):
            raise MonsterdeskError("qBittorrent cutover lock ownership, mode, type, or link count differs")
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except Exception:
        os.close(fd)
        raise
    return fd


#@MNX-PART id=90.00.monsterdesk.function.f023kkd-release-qbittorrent-cutover-lock kind=function title="Python function release_qbittorrent_cutover_lock"
def release_qbittorrent_cutover_lock(fd: int) -> None:
    with contextlib.suppress(OSError):
        fcntl.flock(fd, fcntl.LOCK_UN)
    with contextlib.suppress(OSError):
        os.close(fd)


