          /etc/monsternix/bin/mnx-btrfs-baseline status 2>/dev/null || true
          /etc/monsternix/bin/mnx-monolith --config "$CFG" index
          /etc/monsternix/bin/mnx-relations --config "$CFG" index
          planner frontier --limit 12
          ;;

        bundle)
          need_root "$@"
          STAMP="$(date +%Y%m%dT%H%M%S)"
          SOURCE_HASH="$(sha256sum "$CFG" | awk '{print $1}')"
          OUTPUT="/var/lib/logbook/support/monolith-bundle-$STAMP-''${SOURCE_HASH:0:12}.tar.gz"
          /etc/monsternix/bin/mnx-monolith --config "$CFG" bundle --out "$OUTPUT"
          chown root:logbook "$OUTPUT"
          chmod 0640 "$OUTPUT"
          ;;

        help|-h|--help)
          cat <<'USAGE'
      mnx refactor frontier [--limit N] [--all] [--section NN] [--role ROLE] [--json]
          Rank the lowest-coupling definitions first. The score is navigation evidence, never permission.

      mnx refactor impact DEFINITION [--json]
          Show source range, parts, flows, laws, direct/reverse textual references, and behavior-manifest surfaces.

      mnx refactor plan DEFINITION [--json]
      mnx refactor plan --chunk CHUNK [--json]
          Produce a bounded definition- or subsystem-scoped edit/test plan.

      mnx refactor workspace create NAME DEFINITION... [--chunk CHUNK]
          Create a root-owned disposable exact-source workspace under /var/lib/logbook/support/refactor-workspaces.

      mnx port review SOURCE [--json] [--full]
          Compare this exact m16 source with one bounded foreign source as data only. No foreign content is executed,
          evaluated, imported, or written; recommendations are advisory evidence, never transfer permission.

      mnx capsule policy [--json]
      mnx capsule inspect SOURCE [--json]
      mnx capsule verify SOURCE --sha256 HASH --bytes N [--media TYPE] [--json]
      mnx capsule self-test
          Inspect or verify stable bounded bytes without executing the source, using the network, or writing state.
          `mnx capsule run` is deliberately refused until a later sandbox and receipt contract is accepted.

      mnx substrate status [--json]
      mnx substrate contract [--json]
      mnx substrate self-test
          Name NixOS as the current replaceable adapter and report portable contracts and migration-witness limits.
          `mnx substrate migrate` is deliberately refused because no alternate adapter has been accepted.

      mnx cloudtainer policy [--json]
      mnx cloudtainer status [--json]
      mnx cloudtainer workbench [--json]
      mnx cloudtainer history [--json]
      mnx cloudtainer turn-close [--json] [--authority TEXT] [--state TEXT] [--intent TEXT] [--open TEXT] [--next TEXT] [--hold TEXT] [--operator TEXT]
      mnx cloudtainer pack [--json] [--output DIR] [--replace]
      mnx cloudtainer self-test
          Build a posh, exact, manifested ChatGPT command center with source, capsule, office/runtime overlay,
          maps, compact handoff, and a standard-library portable helper. Inspection is read-only; pack is explicit.

      mnx refactor prepare [--name NAME] [--replace]
          Verify the active monolith, create a split/upload bundle and chunk map, and capture/pin the behavior contract.

      mnx refactor verify
          Require exact monolith roundtrip and a matching pinned behavior contract.

      mnx refactor status
          Show source/runtime identity, baseline state, chunk/relationship maps, and a short refactor frontier.

      mnx refactor bundle
          Create a full-source plus exact-chunks tar.gz under /var/lib/logbook/support.

      This tool never writes configuration.nix and never makes derived files authoritative. Plain `mnx test` is always the first validation command.
      USAGE
          ;;

        *)
          printf 'unknown mnx refactor command: %s\n' "$COMMAND" >&2
          exit 64
          ;;
      esac
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            MNX_ATLAS_COMMAND=/nonexistent MNX_RELATIONS_COMMAND=/nonexistent "$out" self-test
            ;;
          '#!'*python*)
            ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
            ;;
          *)
            echo "unsupported generated-script interpreter: $first" >&2
            exit 1
            ;;
        esac
      '';
    };
  };

#@MNX-CHUNK id=99.70 slug=source-lexer title="Nix-aware source lexer and monolith constitution checks"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-source-lexer" section=99.70 role=generated-program ordinal=274
  environment.etc."monsternix/bin/mnx-source-lexer" = {
    source = pkgs.writeTextFile {
      name = "mnx-source-lexer";
      executable = true;
      text = ''
      #!${pkgs.python3}/bin/python3
      from __future__ import annotations
      
      import base64
      import bisect
      import hashlib
      import io
      import re
      import tarfile
      import shlex
      import sys
      from pathlib import Path
      
      if len(sys.argv) != 2 or sys.argv[1] in {'-h', '--help'}:
          print('usage: mnx-source-lexer CONFIGURATION.NIX', file=sys.stderr if len(sys.argv) != 2 else sys.stdout)
          raise SystemExit(64 if len(sys.argv) != 2 else 0)
      
      path = Path(sys.argv[1])
      text = path.read_text(encoding="utf-8")
      self_start_marker = 'environment.etc."monsternix/bin/mnx-source-lexer" = {'
      self_end_marker = '\n  environment.etc."monsternix/bin/mnx-config-audit" = {'
      self_start = text.find(self_start_marker)
      self_end = text.find(self_end_marker, self_start + 1) if self_start >= 0 else -1
      if self_start >= 0 and self_end > self_start:
          policy_text = text[:self_start] + self_start_marker + text[self_end:]
      else:
          policy_text = text
      newlines = [-1] + [index for index, char in enumerate(text) if char == "\n"]
      errors: list[str] = []
      words: list[tuple[str, int, int]] = []
      stack: list[tuple[str, int, int]] = []
      pairs = {"}": "{", "]": "[", ")": "("}
      S2 = chr(39) * 2
      S3 = chr(39) * 3
      DOLLAR_OPEN = "$" + "{"
      
      
      #@MNX-PART id=99.70.mnx-source-lexer.function.line_col kind=function title="Python function line_col"
      def line_col(index: int) -> tuple[int, int]:
          line = bisect.bisect_right(newlines, index)
          return line, index - newlines[line - 1]
      
      
      #@MNX-PART id=99.70.mnx-source-lexer.function.skip_line_comment kind=function title="Python function skip_line_comment"
      def skip_line_comment(index: int) -> int:
          end = text.find("\n", index)
          return len(text) if end < 0 else end + 1
      
      
      #@MNX-PART id=99.70.mnx-source-lexer.function.skip_block_comment kind=function title="Python function skip_block_comment"
      def skip_block_comment(index: int) -> int:
          start = index
          depth = 1
          index += 2
          while index < len(text) and depth:
              if text.startswith("/*", index):
                  depth += 1
                  index += 2
              elif text.startswith("*/", index):
                  depth -= 1
                  index += 2
              else:
                  index += 1
          if depth:
              line, col = line_col(start)
              errors.append(f"unterminated block comment at {line}:{col}")
          return index
      
      
      #@MNX-PART id=99.70.mnx-source-lexer.function.scan_double_string kind=function title="Python function scan_double_string"
      def scan_double_string(index: int) -> int:
          start = index - 1
          while index < len(text):
              if text[index] == "\\":
                  index += 2
              elif text.startswith(DOLLAR_OPEN, index):
                  index = scan_code(index + 2, interpolation=True)
              elif text[index] == '"':
                  return index + 1
              else:
                  index += 1
          line, col = line_col(start)
          errors.append(f"unterminated double string at {line}:{col}")
          return index
      
      
      #@MNX-PART id=99.70.mnx-source-lexer.function.scan_indented_string kind=function title="Python function scan_indented_string"
      def scan_indented_string(index: int) -> int:
          start = index - 2
          while index < len(text):
              if text.startswith(S2 + DOLLAR_OPEN, index):
                  index += 4
              elif text.startswith(S3, index):
                  index += 3
              elif text.startswith(S2 + "\\", index):
                  index += 3
              elif text.startswith(DOLLAR_OPEN, index):
                  index = scan_code(index + 2, interpolation=True)
              elif text.startswith(S2, index):
                  return index + 2
              else:
                  index += 1
          line, col = line_col(start)
          errors.append(f"unterminated indented string at {line}:{col}")
          return index
      
      
      #@MNX-PART id=99.70.mnx-source-lexer.function.scan_code kind=function title="Python function scan_code"
      def scan_code(index: int, interpolation: bool = False) -> int:
          local_braces = 0
          while index < len(text):
              char = text[index]
              if char == "#":
                  index = skip_line_comment(index)
                  continue
              if text.startswith("/*", index):
                  index = skip_block_comment(index)
                  continue
              if char == '"':
                  index = scan_double_string(index + 1)
                  continue
              if text.startswith(S2, index):
                  index = scan_indented_string(index + 2)
                  continue
              if char.isalpha() or char == "_":
                  end = index + 1
                  while end < len(text) and (text[end].isalnum() or text[end] in "_-'?"):
                      end += 1
                  line, col = line_col(index)
                  words.append((text[index:end], line, col))
                  index = end
                  continue
              if char == "{" and interpolation:
                  local_braces += 1
                  line, col = line_col(index)
                  stack.append((char, line, col))
                  index += 1
                  continue
              if char == "}" and interpolation:
                  if local_braces == 0:
                      return index + 1
                  local_braces -= 1
                  if not stack or stack[-1][0] != "{":
                      line, col = line_col(index)
                      errors.append(f"unmatched interpolation brace at {line}:{col}")
                  else:
                      stack.pop()
                  index += 1
                  continue
              if char in "{[(":
                  line, col = line_col(index)
                  stack.append((char, line, col))
                  index += 1
                  continue
              if char in "}])":
                  line, col = line_col(index)
                  if not stack or stack[-1][0] != pairs[char]:
                      errors.append(f"unmatched {char!r} at {line}:{col}")
                  else:
                      stack.pop()
                  index += 1
                  continue
              index += 1
          if interpolation:
              errors.append("unterminated Nix string interpolation")
          return index
      
      
      scan_code(0)
      if stack:
          errors.extend(f"unclosed {token!r} from {line}:{col}" for token, line, col in stack[-20:])
      active_let_words = [(line, col) for word, line, col in words if word == "let"]
      active_in_words = [(line, col) for word, line, col in words if word == "in"]
      active_inherit_words = [(line, col) for word, line, col in words if word == "inherit"]
      active_rec_words = [(line, col) for word, line, col in words if word == "rec"]
      if not active_let_words or not active_in_words or not active_inherit_words:
          errors.append("document schema 98 requires an evaluated top-level let/function/inherit Nix-language witness")
      first_line = text.splitlines()[0] if text.splitlines() else ""
      if not (first_line.startswith("#!/usr/bin/env") and "bash" in first_line):
          errors.append("polyglot Bash shebang is missing")
      if "imports = [ ];" not in text:
          errors.append("single-file imports = [ ]; invariant is missing")
      if re.search(r"(?m)^\s*imports\s*=\s*\[(?!\s*\]\s*;)", text):
          errors.append("a non-empty imports declaration appears present")
      if "####################################################################################mnx##Monsternix####" not in text:
          errors.append("primary Monsternix ASCII-art landmark is missing")
      for section in ["SECTION 00", *(f"SECTION {number:02d}" for number in range(1, 10)), "SECTION 98", "SECTION 99"]:
          if section not in text:
              errors.append(f"required office/test landmark is missing: {section}")
      if "#@MNX-BASH-BEGIN" not in text or "#@MNX-BASH-END" not in text:
          errors.append("configuration-as-bash payload markers are missing")
      chunk_markers: list[tuple[str, str, str, int]] = []
      chunk_ids: set[str] = set()
      chunk_slugs: set[str] = set()
      for line_number, line in enumerate(text.splitlines(), start=1):
          if not line.startswith("#@MNX-CHUNK "):
              continue
          try:
              tokens = shlex.split(line[len("#@MNX-CHUNK "):], posix=True)
          except ValueError as exc:
              errors.append(f"invalid MNX chunk marker at line {line_number}: {exc}")
              continue
          fields: dict[str, str] = {}
          for token in tokens:
              if "=" not in token:
                  errors.append(f"invalid MNX chunk marker token at line {line_number}: {token}")
                  continue
              key, value = token.split("=", 1)
              fields[key] = value
          chunk_id = fields.get("id", "")
          slug = fields.get("slug", "")
          title = fields.get("title", "")
          if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", chunk_id):
              errors.append(f"invalid or missing chunk id at line {line_number}: {chunk_id!r}")
          if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", slug):
              errors.append(f"invalid or missing chunk slug at line {line_number}: {slug!r}")
          if not title:
              errors.append(f"missing chunk title at line {line_number}")
          if chunk_id in chunk_ids:
              errors.append(f"duplicate chunk id: {chunk_id}")
          if slug in chunk_slugs:
              errors.append(f"duplicate chunk slug: {slug}")
          chunk_ids.add(chunk_id)
          chunk_slugs.add(slug)
          chunk_markers.append((chunk_id, slug, title, line_number))
      required_chunk_ids = {
          "00.00", "00.10", "01.00", "02.00", "03.00", "04.00", "05.00", "06.00", "07.00", "08.00", "09.00",
          "10.00", "20.10", "20.20", "40.10", "40.20", "30.10", "50.10", "30.20", "30.30", "30.40", "30.50",
          "30.60", "80.10", "40.30", "60.10", "70.10", "70.14", "90.00", "90.90", "95.00", "98.00", "99.00", "99.08", "99.55", "99.90", "99.93", "99.99",
      }
      missing_chunk_ids = sorted(required_chunk_ids - chunk_ids)
      if missing_chunk_ids:
          errors.append("required MNX chunks are missing: " + ", ".join(missing_chunk_ids))
      
      
      # Definition, internal-part, and candidate-only temporary-code atlas.
      definition_re = re.compile(r'^#@MNX-DEF\s+path=(.*?)\s+section=([^\s]+)\s+role=([^\s]+)\s+ordinal=([0-9]+)\s*$')
      part_re = re.compile(r'^\s*#@MNX-PART\s+(.*)$')
      temp_begin_re = re.compile(r'^#@MNX-TEMP-BEGIN\s+(.*)$')
      temp_end_re = re.compile(r'^#@MNX-TEMP-END\s+(.*)$')
      definition_paths: set[str] = set()
      definition_ordinals: list[int] = []
      part_ids: set[str] = set()
      part_count_by_definition: dict[str, int] = {}
      temporary_ids: set[str] = set()
      temporary_regions: list[tuple[str, int, int]] = []
      current_chunk = ""
      current_definition = ""
      active_temporary: tuple[str, int, dict[str, str]] | None = None
      
      #@MNX-PART id=99.70.mnx-source-lexer.function.marker_fields kind=function title="Python function marker_fields"
      def marker_fields(payload: str, line_number: int, marker_name: str) -> dict[str, str]:
          try:
              tokens = shlex.split(payload, posix=True)
          except ValueError as exc:
              errors.append(f"invalid {marker_name} marker at line {line_number}: {exc}")
              return {}
          fields: dict[str, str] = {}
          for token in tokens:
              if "=" not in token:
                  errors.append(f"invalid {marker_name} token at line {line_number}: {token}")
                  continue
              key, value = token.split("=", 1)
              if key in fields:
                  errors.append(f"duplicate {marker_name} field {key!r} at line {line_number}")
              fields[key] = value
          return fields

      # This deliberately duplicates only the exposure language's cheap,
      # safety-critical grammar. The full mnx-exposure parser remains
      # authoritative; this nanocheck gives no-Nix cloudtainers an early,
      # deterministic rejection surface for common policy footguns.
      #@MNX-PART id=99.70.mnx-source-lexer.function.nanocheck-exposure-policy kind=function title="Python function nanocheck_exposure_policy"
      def nanocheck_exposure_policy() -> None:
          lines = text.splitlines()
          begin_line = "#@MNX-EXPOSURE-BEGIN schema=2 policy_mode=observe-only default_disposition=review"
          end_line = "#@MNX-EXPOSURE-END"
          begins = [index for index, line in enumerate(lines) if line == begin_line]
          ends = [index for index, line in enumerate(lines) if line == end_line]
          error_start = len(errors)
          if len(begins) != 1 or len(ends) != 1 or ends[0] <= begins[0]:
              errors.append(f"exposure nanocheck expected one ordered policy block: begin={len(begins)} end={len(ends)}")
              print("mnx_exposure_nanocheck=FAIL")
              return

          zone_fields = {"id", "interfaces", "address", "bind_policy", "sources", "enforcement"}
          entry_fields = {
              "id", "proto", "port", "address", "interfaces", "netns", "unit", "process",
              "package", "cgroup", "mode", "disposition", "intent", "zone", "required", "volatility",
          }
          address_classes = {"wildcard", "loopback", "link-local", "multicast", "lan", "public", "unknown"}
          zone_ids: set[str] = set()
          entry_ids: set[str] = set()
          entries: list[tuple[int, dict[str, str]]] = []

          for index in range(begins[0] + 1, ends[0]):
              line = lines[index]
              line_number = index + 1
              if not line:
                  continue
              if line.startswith("#@MNX-ZONE "):
                  fields = marker_fields(line[len("#@MNX-ZONE "):], line_number, "exposure zone")
                  missing = sorted(zone_fields - set(fields))
                  unknown = sorted(set(fields) - zone_fields)
                  if missing or unknown:
                      errors.append(f"exposure zone fields at line {line_number}: missing={missing} unknown={unknown}")
                      continue
                  zone_id = fields["id"]
                  if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", zone_id) or zone_id in zone_ids:
                      errors.append(f"invalid or duplicate exposure zone id at line {line_number}: {zone_id!r}")
                  zone_ids.add(zone_id)
                  addresses = {value for value in fields["address"].split(",") if value}
                  if not addresses or not addresses <= address_classes:
                      errors.append(f"invalid exposure zone address classes at line {line_number}: {fields['address']!r}")
                  if fields["bind_policy"] not in {"exact", "firewall-gated", "any", "review"}:
                      errors.append(f"invalid exposure zone bind policy at line {line_number}: {fields['bind_policy']!r}")
                  if fields["enforcement"] != "observe-only":
                      errors.append(f"invalid exposure zone enforcement at line {line_number}: {fields['enforcement']!r}")
                  continue
              if line.startswith("#@MNX-EXPOSURE "):
                  fields = marker_fields(line[len("#@MNX-EXPOSURE "):], line_number, "exposure")
                  missing = sorted(entry_fields - set(fields))
                  unknown = sorted(set(fields) - entry_fields)
                  if missing or unknown:
                      errors.append(f"exposure fields at line {line_number}: missing={missing} unknown={unknown}")
                      continue
                  entry_id = fields["id"]
                  if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", entry_id) or entry_id in entry_ids:
                      errors.append(f"invalid or duplicate exposure id at line {line_number}: {entry_id!r}")
                  entry_ids.add(entry_id)
                  entries.append((line_number, fields))
                  continue
              errors.append(f"unexpected exposure policy line {line_number}: {line!r}")

          for line_number, fields in entries:
              protocols = {value for value in fields["proto"].split(",") if value}
              addresses = {value for value in fields["address"].split(",") if value}
              namespaces = {value for value in fields["netns"].split(",") if value}
              if not protocols or not protocols <= {"tcp", "udp", "any"}:
                  errors.append(f"invalid exposure protocols at line {line_number}: {fields['proto']!r}")
              if not addresses or not addresses <= address_classes:
                  errors.append(f"invalid exposure address classes at line {line_number}: {fields['address']!r}")
              if not namespaces or not namespaces <= {"host", "nonhost", "unknown", "any"}:
                  errors.append(f"invalid exposure namespaces at line {line_number}: {fields['netns']!r}")
              if fields["disposition"] not in {"known", "review", "forbidden"}:
                  errors.append(f"invalid exposure disposition at line {line_number}: {fields['disposition']!r}")
              if fields["required"] not in {"yes", "no"}:
                  errors.append(f"invalid exposure required flag at line {line_number}: {fields['required']!r}")
              if fields["volatility"] not in {"persistent", "dynamic", "transient"}:
                  errors.append(f"invalid exposure volatility at line {line_number}: {fields['volatility']!r}")
              for key in ("intent", "zone"):
                  if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", fields[key]):
                      errors.append(f"invalid exposure {key} at line {line_number}: {fields[key]!r}")
              if fields["zone"] not in zone_ids:
                  errors.append(f"unknown exposure zone at line {line_number}: {fields['zone']!r}")
              if fields["port"] != "*":
                  for item in fields["port"].split(","):
                      match = re.fullmatch(r"([0-9]+)(?:-([0-9]+))?", item)
                      if match is None:
                          errors.append(f"invalid exposure port expression at line {line_number}: {item!r}")
