        sha256sum "$program" 2>/dev/null || true
        if head -n 1 "$program" | grep -Eq 'bash'; then
          bash -n "$program" || fail "bash syntax failed: $program"
        elif head -n 1 "$program" | grep -Eq 'python'; then
          python3 -c 'import pathlib,sys; path=pathlib.Path(sys.argv[1]); compile(path.read_text(encoding="utf-8"), str(path), "exec")' "$program" || fail "python syntax failed: $program"
        else
          warn "generated executable has an unrecognized interpreter: $program"
        fi
      done < <(find -L /etc/monsternix/bin -maxdepth 1 -type f -perm -0100 -print 2>/dev/null | sort)
      printf 'generated_program_count=%s\n' "$PROGRAM_COUNT"
      (( PROGRAM_COUNT > 0 )) || fail 'no generated Monsternix programs were discovered through /etc symlinks'

      if [[ -x /etc/monsternix/bin/mnx-source-lexer ]]; then
        /etc/monsternix/bin/mnx-source-lexer --help >/dev/null || fail 'source-lexer help self-test failed'
      else
        fail 'mnx-source-lexer is missing'
      fi

      if [[ -x /etc/monsternix/bin/mnx-rsync-log-report ]]; then
        /etc/monsternix/bin/mnx-rsync-log-report self-test || fail 'rsync log parser self-test failed'
      else
        fail 'mnx-rsync-log-report is missing'
      fi

      if [[ -x /etc/monsternix/bin/mnx-configuration-as-bash ]]; then
        /etc/monsternix/bin/mnx-configuration-as-bash self-test || fail 'configuration-as-bash self-test failed'
      else
        fail 'mnx-configuration-as-bash is missing'
      fi

      if [[ -x /etc/monsternix/bin/mnx-bundle-manifest ]]; then
        /etc/monsternix/bin/mnx-bundle-manifest self-test || fail 'bundle-manifest self-test failed'
      else
        fail 'mnx-bundle-manifest is missing'
      fi

      if [[ -x /etc/monsternix/bin/mnx-restic ]]; then
        /etc/monsternix/bin/mnx-restic self-test || fail 'm16 Restic qualification office self-test failed'
        /etc/monsternix/bin/mnx-restic policy | grep -q '^cutover=authorized-only-after-complete-switch-owned-proof-chain$' || fail 'm16 Restic qualification gated-cutover policy is missing'
        /etc/monsternix/bin/mnx-restic enroll adoption-preflight || fail 'existing m16 pull-identity adoption preflight failed'
        grep -Fq 'backup-source@192.168.100.119 receipt' /etc/monsternix/bin/mnx-restic || fail 'm21 forced-command source probe implementation is missing'
        grep -Fq 'StrictHostKeyChecking=yes' /etc/monsternix/bin/mnx-restic || fail 'm21 source probe lost strict host-key enforcement'
        grep -Fq 'MNX_RESTIC_SOURCE_PROBE=PASS' /etc/monsternix/bin/mnx-restic || fail 'm21 source probe completion contract is missing'
        echo 'm21_source_probe_acceptance_gate=disabled-live-network-is-explicit-diagnostic'
        echo 'm21_source_probe_explicit_command=mnx-restic:enroll:source-probe'
        echo 'm21_source_probe_network_used=no'
        /etc/monsternix/bin/mnx-restic qualify capacity-preflight || fail 'm16 Restic free-space measurement failed'
      else
        fail 'mnx-restic qualification office is missing'
      fi

      if [[ -x /etc/monsternix/bin/mnx-eject && -x /etc/monsternix/bin/mnx ]]; then
        /etc/monsternix/bin/mnx command-surface-self-test || fail 'mnx command-surface self-test failed'
        /etc/monsternix/bin/mnx eject verify "$CFG" || fail 'plain-NixOS ejection fixture/contract/preview verification failed through mnx dispatcher'
        EJECT_PLAN_TMP="$(mktemp)"
        EJECT_TRANSFORMS_TMP="$(mktemp)"
        EJECT_PREVIEW_TMP="$(mktemp)"
        if /etc/monsternix/bin/mnx eject plan --json "$CFG" > "$EJECT_PLAN_TMP"; then
          ${pkgs.jq}/bin/jq -e '
            .schema == "mnx.eject.plan.v2" and
            .ejection_schema == 2 and
            .publication_enabled == false and
            .publication_ready == false and
            .mutation == "none" and
            .network_used == false and
            .source_execution == false and
            .source.sha256 != null and
            .definitions.total > 0 and
            .definitions.counts["transform-required"] > 0 and
            .definitions.counts.unclassified == 0 and
            .ownership.shebang == 1 and
            .ownership.owned_region_count >= 1 and
            .transformation_contracts.total == .definitions.counts["transform-required"] and
            .transformation_contracts.covered == .transformation_contracts.total and
            .transformation_contracts.body_hashes_exact == true and
            .transformation_contracts.behavior_gap_count == 20 and
            .transformation_contracts.residual_rewrite_count == 3 and
            .preview.nix_parse == "PASS" and
            .preview.residual_language_tokens == [] and
            .preview.persistent_output_written == false
          ' "$EJECT_PLAN_TMP" >/dev/null || fail 'plain-NixOS ejection plan JSON contract failed'
          EJECT_PLAN_SHA="$(${pkgs.jq}/bin/jq -r '.source.sha256' "$EJECT_PLAN_TMP")"
          EJECT_EXPECTED_CONTRACTS="$(${pkgs.jq}/bin/jq -r '.definitions.counts["transform-required"]' "$EJECT_PLAN_TMP")"
          [[ "$EJECT_PLAN_SHA" == "$(sha256sum "$CFG" | awk '{print $1}')" ]] || fail 'plain-NixOS ejection plan source identity differs from the audited source'
          [[ "$EJECT_EXPECTED_CONTRACTS" =~ ^[1-9][0-9]*$ ]] || fail 'plain-NixOS ejection plan transform-required count is not a positive integer'
        else
          fail 'plain-NixOS ejection real-source plan failed'
        fi
        if /etc/monsternix/bin/mnx eject transforms --json "$CFG" > "$EJECT_TRANSFORMS_TMP"; then
          ${pkgs.jq}/bin/jq -e --arg source "$EJECT_PLAN_SHA" --argjson expected "$EJECT_EXPECTED_CONTRACTS" '
            .schema == "mnx.eject.transforms.v1" and
            .ejection_schema == 2 and
            .publication_enabled == false and
            .mutation == "none" and
            .network_used == false and
            .source.sha256 == $source and
            .contracts.total == $expected and
            .contracts.covered == .contracts.total and
            .contracts.body_hashes_exact == true and
            .contracts.behavior_gap_count == 20 and
            (.contracts.items | length) == .contracts.total
          ' "$EJECT_TRANSFORMS_TMP" >/dev/null || fail 'plain-NixOS transformation-contract JSON failed'
          echo 'MNX_EJECT_TRANSFORM_CONTRACTS=PASS'
        else
          fail 'plain-NixOS transformation-contract command failed'
        fi
        if /etc/monsternix/bin/mnx eject preview --json "$CFG" > "$EJECT_PREVIEW_TMP"; then
          ${pkgs.jq}/bin/jq -e --arg source "$EJECT_PLAN_SHA" --argjson expected "$EJECT_EXPECTED_CONTRACTS" '
            .schema == "mnx.eject.preview.v1" and
            .ejection_schema == 2 and
            .publication_enabled == false and
            .behavior_equivalence_proved == false and
            .mutation == "none" and
            .network_used == false and
            .source.sha256 == $source and
            .preview.nix_parse == "PASS" and
            .preview.residual_language_tokens == [] and
            .preview.persistent_output_written == false and
            .transformation_contracts.total == $expected and
            .transformation_contracts.covered == .transformation_contracts.total
          ' "$EJECT_PREVIEW_TMP" >/dev/null || fail 'plain-NixOS preview JSON contract failed'
          echo 'MNX_EJECT_PREVIEW=PASS'
        else
          fail 'plain-NixOS preview command failed'
        fi
        echo 'ejection_publication_enabled=no'
        printf 'ejection_publication_ready=%s\n' "$(${pkgs.jq}/bin/jq -r 'if .publication_ready then "yes" else "no" end' "$EJECT_PLAN_TMP")"
        printf 'ejection_transform_required_count=%s\n' "$(${pkgs.jq}/bin/jq -r '.definitions.counts["transform-required"]' "$EJECT_PLAN_TMP")"
        printf 'ejection_transformation_contract_count=%s\n' "$(${pkgs.jq}/bin/jq -r '.transformation_contracts.total' "$EJECT_PLAN_TMP")"
        printf 'ejection_behavior_gap_count=%s\n' "$(${pkgs.jq}/bin/jq -r '.transformation_contracts.behavior_gap_count' "$EJECT_PLAN_TMP")"
        printf 'ejection_preview_sha256=%s\n' "$(${pkgs.jq}/bin/jq -r '.preview.sha256' "$EJECT_PLAN_TMP")"
        echo 'MNX_EJECT_GROUNDWORK=PASS'
        rm -f "$EJECT_PLAN_TMP" "$EJECT_TRANSFORMS_TMP" "$EJECT_PREVIEW_TMP"
      else
        fail 'mnx or mnx-eject is missing'
      fi

      if [[ -x /etc/monsternix/bin/mnx-btrfs-baseline ]]; then
        /etc/monsternix/bin/mnx-btrfs-baseline --help >/dev/null || fail 'Btrfs baseline help self-test failed'
      else
        fail 'mnx-btrfs-baseline is missing'
      fi

      if [[ -x /etc/monsternix/bin/mnx-m21-identity ]]; then
        /etc/monsternix/bin/mnx-m21-identity --help >/dev/null 2>&1 || fail 'mnx-m21-identity help failed'
        /etc/monsternix/bin/mnx-m21-identity self-test || fail 'mnx-m21 helper-trust self-test failed'
      else
        fail 'mnx-m21-identity is missing'
      fi

      if [[ -x /etc/monsternix/bin/mnx ]]; then
        /etc/monsternix/bin/mnx help >/dev/null || fail 'mnx dispatcher help self-test failed'
        HAS_COMPLETED_TEST=0
        while IFS= read -r evidence; do
          if grep -Eq '^(mnx_test_result|mnx_bootstrap_test_result)=' "$evidence" 2>/dev/null; then HAS_COMPLETED_TEST=1; break; fi
        done < <(find /var/lib/logbook/support -maxdepth 1 -type f \( -name 'mnx-test-*.txt' -o -name 'mnx-bootstrap-test-*.txt' \) -print 2>/dev/null)
        if (( HAS_COMPLETED_TEST == 1 )); then
          /etc/monsternix/bin/mnx test-summary >/dev/null || fail 'mnx test-summary dispatcher path failed'
        fi
        HAS_COMPLETED_SWITCH=0
        while IFS= read -r evidence; do
          if grep -q '^mnx_switch_result=' "$evidence" 2>/dev/null; then HAS_COMPLETED_SWITCH=1; break; fi
        done < <(find /var/lib/logbook/support -maxdepth 1 -type f -name 'mnx-switch-*.txt' -print 2>/dev/null)
        if (( HAS_COMPLETED_SWITCH == 1 )); then
          /etc/monsternix/bin/mnx switch-summary >/dev/null || fail 'mnx switch-summary dispatcher path failed'
        fi
      else
        fail 'mnx dispatcher is missing'
      fi

      if [[ -x /etc/monsternix/bin/mnx-test ]]; then
        /etc/monsternix/bin/mnx-test --help >/dev/null || fail 'mnx test help self-test failed'
      else
        fail 'mnx-test harness is missing'
      fi

      if [[ -x /etc/monsternix/bin/mnx-manager-loop-report ]]; then
        /etc/monsternix/bin/mnx-manager-loop-report self-test || fail 'mnx manager-loop reporter self-test failed'
      else
        fail 'mnx-manager-loop-report is missing'
      fi

      if [[ -x /etc/monsternix/bin/mnx-switch ]]; then
        /etc/monsternix/bin/mnx-switch self-test || fail 'mnx switch evidence/self-test failed'
        /etc/monsternix/bin/mnx-switch --help >/dev/null || fail 'mnx switch help self-test failed'
      else
        fail 'mnx-switch harness is missing'
      fi

      if [[ -x /etc/monsternix/bin/mnx-behavior-manifest ]]; then
        /etc/monsternix/bin/mnx-behavior-manifest --help >/dev/null || fail 'behavior-manifest help self-test failed'
        /etc/monsternix/bin/mnx-behavior-manifest repeatability || fail 'behavior-manifest three-sample repeatability failed'
      else
        fail 'mnx-behavior-manifest is missing'
      fi

      if [[ -L /var/lib/monsternix/btrfs-baselines/pinned ]]; then
        /etc/monsternix/bin/mnx-btrfs-baseline status || fail 'pinned Btrfs counter baseline comparison failed'
      else
        warn 'no pinned Btrfs counter baseline exists yet'
      fi

      STATUS_TMP="$(mktemp)"
      if /etc/monsternix/bin/mnx status > "$STATUS_TMP" 2>&1; then
        cat "$STATUS_TMP"
        while IFS='=' read -r key value; do
          case "$key" in
            'nvme_temperature_celsius['*']'|hottest_nvme_temperature_celsius)
              [[ "$value" == unreadable ]] && continue
              [[ "$value" =~ ^[0-9]+$ ]] || fail "mnx status emitted a nonnumeric NVMe temperature: $key=$value"
              (( value > 0 && value < 200 )) || fail "mnx status emitted an impossible NVMe temperature: $key=$value"
              ;;
            old_storage_mount_mode)
              [[ "$value" == ro ]] || fail "mnx status reports old-storage host mount mode as $value instead of ro"
              ;;
          esac
        done < "$STATUS_TMP"
      else
        cat "$STATUS_TMP" >&2 || true
        fail 'mnx status failed'
      fi
      rm -f "$STATUS_TMP"

      #@MNX-PART id=99.80.mnx-config-audit.function.legacy-m21-timer-retired kind=function title="Bash function legacy_m21_timer_retired"
      legacy_m21_timer_retired() {
        [[ $# == 3 && $1 == masked && $2 == inactive && $3 == masked ]]
      }

      #@MNX-PART id=99.80.mnx-config-audit.phase.legacy-m21-timer-retirement kind=phase title="Phase: LEGACY M21 TIMER RETIREMENT"
      section 'LEGACY M21 TIMER RETIREMENT'
      LEGACY_RETIREMENT_FAILURES_BEFORE=$FAIL
      legacy_m21_timer_retired masked inactive masked || fail 'legacy timer retirement predicate rejected the exact safe state'
      if legacy_m21_timer_retired loaded active enabled ||
         legacy_m21_timer_retired masked active masked ||
         legacy_m21_timer_retired not-found inactive not-found ||
         legacy_m21_timer_retired masked inactive disabled ||
         legacy_m21_timer_retired masked inactive; then
        fail 'legacy timer retirement predicate accepted a missing, active or nonmasked timer'
      fi
      LEGACY_TIMER_LOAD="$(systemctl show m21-btrfs-pull-backup.timer -p LoadState --value 2>/dev/null || true)"
      LEGACY_TIMER_ACTIVE="$(systemctl show m21-btrfs-pull-backup.timer -p ActiveState --value 2>/dev/null || true)"
      LEGACY_TIMER_ENABLED="$(systemctl is-enabled m21-btrfs-pull-backup.timer 2>/dev/null || true)"
      LEGACY_TIMER_RETIRED=no
      if legacy_m21_timer_retired "$LEGACY_TIMER_LOAD" "$LEGACY_TIMER_ACTIVE" "$LEGACY_TIMER_ENABLED" &&
         [[ "$(readlink -f /etc/systemd/system/m21-btrfs-pull-backup.timer 2>/dev/null || true)" == /dev/null ]]; then
        LEGACY_TIMER_RETIRED=yes
      else
        fail 'legacy m21 Btrfs timer is not both masked and inactive in the real system'
      fi
      printf 'm21_legacy_timer_load=%s\nm21_legacy_timer_active=%s\nm21_legacy_timer_enablement=%s\n' "$LEGACY_TIMER_LOAD" "$LEGACY_TIMER_ACTIVE" "$LEGACY_TIMER_ENABLED"
      printf 'm21_legacy_timer_retired=%s\nm21_legacy_retirement_scope=timer-only\nm21_legacy_history_deletion=none\nm21_legacy_manual_service=retained-not-invoked\n' "$LEGACY_TIMER_RETIRED"
      if (( FAIL == LEGACY_RETIREMENT_FAILURES_BEFORE )); then
        echo 'MNX_M21_LEGACY_TIMER_RETIREMENT=PASS'
      else
        echo 'MNX_M21_LEGACY_TIMER_RETIREMENT=FAIL'
      fi

      #@MNX-PART id=99.80.mnx-config-audit.phase.m21-helper-trust-state kind=phase title="Phase: M21 HELPER TRUST STATE"
      section 'M21 HELPER TRUST STATE'
      M21_TRUST_FILE=/var/lib/m21-btrfs-pull-backup/trusted-helper-sha256
      if [[ -e "$M21_TRUST_FILE" ]]; then
        M21_TRUST_META="$(stat -Lc '%U:%G %a' "$M21_TRUST_FILE" 2>/dev/null || true)"
        M21_TRUST_VALUE="$(awk 'NF { count += 1; value=$0 } END { if (count == 1) print value; else exit 1 }' "$M21_TRUST_FILE" 2>/dev/null || true)"
        printf 'm21_helper_trust_source=operator-enrolled\n'
        printf 'm21_helper_trust_metadata=%s\n' "''${M21_TRUST_META:-unreadable}"
        printf 'm21_expected_helper_sha256=%s\n' "''${M21_TRUST_VALUE:-unreadable}"
        [[ -f "$M21_TRUST_FILE" && ! -L "$M21_TRUST_FILE" ]] || fail 'm21 helper trust override is not a regular non-symlink file'
        [[ "$M21_TRUST_META" == 'root:root 600' ]] || fail "m21 helper trust override has unsafe metadata: ''${M21_TRUST_META:-unreadable}"
        [[ "$M21_TRUST_VALUE" =~ ^[0-9a-f]{64}$ ]] || fail 'm21 helper trust override does not contain exactly one lowercase SHA-256'
      else
        echo 'm21_helper_trust_source=source-default'
        echo 'm21_expected_helper_sha256=67c62343861040656ec61923301eacdfb4261703501345890edbc6a619ba954f'
      fi
      if [[ -r /var/lib/m21-btrfs-pull-backup/last-helper-mismatch ]]; then
        cat /var/lib/m21-btrfs-pull-backup/last-helper-mismatch
        if [[ $LEGACY_TIMER_RETIRED == yes ]]; then
          echo 'm21_helper_block_class=preserved-historical-manual-service-trust-block-not-nightly-failure'
          echo 'm21_helper_approval_performed=no'
        else
          warn 'legacy m21 Btrfs helper is blocked and the timer retirement is not proven; Restic is evaluated separately'
        fi
      else
        echo 'm21_helper_block_state=clear'
      fi
      /etc/monsternix/bin/mnx-m21-identity self-test || fail 'm21 helper-trust self-test failed'
      /etc/monsternix/bin/mnx-journal-integrity self-test || fail 'journal integrity classifier self-test failed'

      #@MNX-PART id=99.80.mnx-config-audit.phase.path-watch-anti-loop-policy kind=phase title="Phase: PATH-WATCH ANTI-LOOP POLICY"
      section 'PATH-WATCH ANTI-LOOP POLICY'
      HYPER_PATH_LOAD="$(systemctl show hypertext-i2p-sync.path -p LoadState --value 2>/dev/null || true)"
      HYPER_TIMER_FRAGMENT="$(systemctl show hypertext-i2p-sync.timer -p FragmentPath --value 2>/dev/null || true)"
      HYPER_TRIGGERED_BY="$(systemctl show hypertext-i2p-sync.service -p TriggeredBy --value 2>/dev/null || true)"
      JSON_PATH_LOAD="$(systemctl show savetrail-jsons.path -p LoadState --value 2>/dev/null || true)"
      JSON_TIMER_FRAGMENT="$(systemctl show savetrail-jsons.timer -p FragmentPath --value 2>/dev/null || true)"
      JSON_TRIGGERED_BY="$(systemctl show savetrail-jsons.service -p TriggeredBy --value 2>/dev/null || true)"
      case "$HYPER_PATH_LOAD" in
        ""|not-found|error) ;;
        *) fail "hypertext-i2p-sync.path still exists with LoadState=$HYPER_PATH_LOAD" ;;
      esac
      case "$JSON_PATH_LOAD" in
        ""|not-found|error) ;;
        *) fail "savetrail-jsons.path still exists with LoadState=$JSON_PATH_LOAD" ;;
      esac
      [[ -r "$HYPER_TIMER_FRAGMENT" ]] || fail 'hypertext-i2p-sync.timer fragment is unreadable'
      [[ -r "$JSON_TIMER_FRAGMENT" ]] || fail 'savetrail-jsons.timer fragment is unreadable'
      grep -Fq 'OnUnitActiveSec=10min' "$HYPER_TIMER_FRAGMENT" || fail 'Hypertext timer lost its bounded ten-minute interval'
      grep -Fq 'OnUnitActiveSec=5min' "$JSON_TIMER_FRAGMENT" || fail 'loose-JSON timer lost its bounded five-minute interval'
      [[ "$HYPER_TRIGGERED_BY" != *hypertext-i2p-sync.path* ]] || fail 'Hypertext publisher is still triggered by a path unit'
      [[ "$JSON_TRIGGERED_BY" != *savetrail-jsons.path* ]] || fail 'loose-JSON organizer is still triggered by a path unit'

      LOOP_TMP="$(mktemp)"
      if /etc/monsternix/bin/mnx-manager-loop-report audit > "$LOOP_TMP" 2>&1; then
        cat "$LOOP_TMP"
        LOOP_WINDOW_START="$(sed -n 's/^pid1_loop_window_start=//p' "$LOOP_TMP" | tail -n 1)"
        LOOP_RECENT_START="$(sed -n 's/^pid1_loop_recent_window_start=//p' "$LOOP_TMP" | tail -n 1)"
        LOOP_CLOCK_ANOMALY="$(sed -n 's/^pid1_loop_clock_anomaly=//p' "$LOOP_TMP" | tail -n 1)"
        LOOP_COUNT="$(sed -n 's/^pid1_loop_throttle_since_activation_count=//p' "$LOOP_TMP" | tail -n 1)"
        LOOP_RECENT="$(sed -n 's/^pid1_loop_throttle_last_2m_count=//p' "$LOOP_TMP" | tail -n 1)"
        LOOP_LATEST="$(sed -n 's/^pid1_loop_throttle_latest=//p' "$LOOP_TMP" | tail -n 1)"
        LOOP_CONSISTENCY="$(sed -n 's/^pid1_loop_window_consistency=//p' "$LOOP_TMP" | tail -n 1)"
        LOOP_JSON_MATCHES="$(sed -n 's/^savetrail_json_top_level_match_count=//p' "$LOOP_TMP" | tail -n 1)"
        LOOP_STARTS="$(awk -F= '/^manager_start_count\[/ && ($2 + 0) > 0 { key=$1; sub(/^manager_start_count\[/, "", key); sub(/\]$/, "", key); if (out != "") out=out ","; out=out key ":" $2 } END { print (out == "" ? "none" : out) }' "$LOOP_TMP")"
        [[ -n "$LOOP_WINDOW_START" ]] || fail 'manager-loop reporter omitted its activation window start'
        [[ -n "$LOOP_RECENT_START" ]] || fail 'manager-loop reporter omitted its recent window start'
        [[ -n "$LOOP_CLOCK_ANOMALY" ]] || fail 'manager-loop reporter omitted clock-anomaly state'
        [[ "$LOOP_CONSISTENCY" == pass ]] || fail "manager-loop reporter did not certify window consistency: $LOOP_CONSISTENCY"
        if [[ "$LOOP_CLOCK_ANOMALY" != none && -n "$LOOP_CLOCK_ANOMALY" ]]; then
          warn "manager-loop reporter observed a clock anomaly: $LOOP_CLOCK_ANOMALY"
        fi
        if [[ "$LOOP_COUNT" =~ ^[0-9]+$ && "$LOOP_RECENT" =~ ^[0-9]+$ ]]; then
          (( LOOP_RECENT <= LOOP_COUNT )) || fail "manager-loop reporter emitted an impossible tuple: recent=$LOOP_RECENT activation=$LOOP_COUNT"
          if (( LOOP_COUNT == 0 )); then
            [[ "$LOOP_LATEST" == none ]] || fail "manager-loop reporter emitted latest=$LOOP_LATEST with zero activation events"
          else
            [[ -n "$LOOP_LATEST" && "$LOOP_LATEST" != none ]] || fail "manager-loop reporter omitted latest event for activation_count=$LOOP_COUNT"
          fi
          if (( LOOP_RECENT > 0 )); then
            warn "PID 1 is currently emitting manager-loop throttle warnings: last_2m=$LOOP_RECENT since_activation=$LOOP_COUNT latest=$LOOP_LATEST recent_start=$LOOP_RECENT_START starts=$LOOP_STARTS loose_json_matches=''${LOOP_JSON_MATCHES:-unknown}"
          elif (( LOOP_COUNT > 0 )); then
            printf 'pid1_manager_loop_history_since_activation=present-but-not-current\n'
          else
            printf 'pid1_manager_loop_history_since_activation=none\n'
          fi
        else
          [[ "$LOOP_COUNT" =~ ^[0-9]+$ ]] || fail "manager-loop reporter emitted a nonnumeric activation count: $LOOP_COUNT"
          [[ "$LOOP_RECENT" =~ ^[0-9]+$ ]] || fail "manager-loop reporter emitted a nonnumeric freshness count: $LOOP_RECENT"
        fi
      else
        cat "$LOOP_TMP" >&2 || true
        fail 'mnx-manager-loop-report failed'
      fi
      rm -f "$LOOP_TMP"

      if [[ -x /etc/monsternix/bin/mnx-monolith ]]; then
        /etc/monsternix/bin/mnx-monolith self-test || fail 'mnx-monolith self-test failed'
        /etc/monsternix/bin/mnx-monolith --config "$CFG" verify || fail 'mnx-monolith source roundtrip failed'
      else
        fail 'mnx-monolith is missing'
      fi

      if [[ -x /etc/monsternix/bin/mnx-atlas ]]; then
        /etc/monsternix/bin/mnx-atlas self-test || fail 'mnx-atlas runtime self-test failed'
        /etc/monsternix/bin/mnx-atlas --config "$CFG" verify || fail 'mnx-atlas runtime source verification failed'
      else
        fail 'mnx-atlas is missing'
      fi
      if [[ -x /etc/monsternix/bin/mnx-relations ]]; then
        /etc/monsternix/bin/mnx-relations self-test || fail 'mnx-relations runtime self-test failed'
        /etc/monsternix/bin/mnx-relations --config "$CFG" verify || fail 'mnx-relations runtime source verification failed'
      else
        fail 'mnx-relations is missing'
      fi

      if [[ -x /etc/monsternix/bin/mnx-refactor ]]; then
        /etc/monsternix/bin/mnx-refactor --help | grep -Fq 'mnx refactor frontier' || fail 'mnx-refactor help/frontier self-test failed'
        /etc/monsternix/bin/mnx-refactor --help | grep -Fq 'mnx port review SOURCE' || fail 'mnx-refactor help/port-review self-test failed'
      else
        fail 'mnx-refactor is missing'
      fi

      #@MNX-PART id=99.80.mnx-config-audit.phase.systemd-unit-verification kind=phase title="Phase: SYSTEMD UNIT VERIFICATION"
      section 'SYSTEMD UNIT VERIFICATION'
      FRAGMENTS=()
      while IFS= read -r unit; do
        [[ -n "$unit" ]] || continue
        fragment="$(systemctl show "$unit" -p FragmentPath --value 2>/dev/null || true)"
        [[ -n "$fragment" && -f "$fragment" ]] || continue
        FRAGMENTS+=("$fragment")
      done < <(
        systemctl list-unit-files --no-legend --no-pager 2>/dev/null |
          awk '{print $1}' |
          grep -E '^(mnx-|logbook-|btrbk-|m21-btrfs-|rsync-m16-|duperemove-).*[.](service|timer|path)$' |
          sort -u
      )
      if (( ''${#FRAGMENTS[@]} > 0 )); then
        systemd-analyze verify "''${FRAGMENTS[@]}" || fail 'systemd-analyze verify failed'
      else
        fail 'no relevant systemd fragments were resolved'
      fi
      printf 'verified_fragment_count=%s\n' "''${#FRAGMENTS[@]}"

      #@MNX-PART id=99.80.mnx-config-audit.phase.optional-service-policy kind=phase title="Phase: OPTIONAL SERVICE RETIREMENT / ON-DEMAND LIBVIRT"
      section 'OPTIONAL SERVICE RETIREMENT / ON-DEMAND LIBVIRT'
      OPTIONAL_POLICY_FAIL_BEFORE="$FAIL"

      #@MNX-PART id=99.80.mnx-config-audit.optional-service-policy.function.check-unit-off kind=function title="Function check_unit_off"
      check_unit_off() {
        local unit="$1" enabled active
        enabled="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
        active="$(systemctl is-active "$unit" 2>/dev/null || true)"
        printf 'optional_unit[%s]_enabled=%s\noptional_unit[%s]_active=%s\n' "$unit" "''${enabled:-unknown}" "$unit" "''${active:-unknown}"
        case "$enabled" in enabled|enabled-runtime|linked|linked-runtime|alias) fail "$unit is enabled despite the optional-service retirement policy" ;; esac
        case "$active" in active|activating|reloading|failed) fail "$unit is not cleanly inactive: ''${active:-unknown}" ;; esac
      }

      for unit in \
        avahi-daemon.service avahi-daemon.socket \
        rpcbind.service rpcbind.socket nfs-server.service nfs-mountd.service nfs-idmapd.service \
        rpc-statd.service rpc-statd-notify.service rpc-rquotad.service \
        fwupd.service fwupd-refresh.service fwupd-refresh.timer; do
        check_unit_off "$unit"
      done
      [[ ! -x /run/current-system/sw/bin/sysdig ]] || fail 'Sysdig remains installed in the active system profile'
      echo 'system_profile_sysdig=absent'

      LIBVIRTD_SERVICE_ENABLED="$(systemctl is-enabled libvirtd.service 2>/dev/null || true)"
      LIBVIRT_GUESTS_ENABLED="$(systemctl is-enabled libvirt-guests.service 2>/dev/null || true)"
      LIBVIRTD_SOCKET_ENABLED="$(systemctl is-enabled libvirtd.socket 2>/dev/null || true)"
      LIBVIRTD_SOCKET_ACTIVE="$(systemctl is-active libvirtd.socket 2>/dev/null || true)"
      LIBVIRTD_SERVICE_ACTIVE="$(systemctl is-active libvirtd.service 2>/dev/null || true)"
      LIBVIRT_GUESTS_ACTIVE="$(systemctl is-active libvirt-guests.service 2>/dev/null || true)"
      LIBVIRTD_WANT=/etc/systemd/system/multi-user.target.wants/libvirtd.service
      LIBVIRT_GUESTS_WANT=/etc/systemd/system/multi-user.target.wants/libvirt-guests.service
      printf 'libvirtd_service_unit_file_state=%s\nlibvirt_guests_unit_file_state=%s\nlibvirtd_socket_enabled=%s\nlibvirtd_socket_active=%s\nlibvirtd_service_active=%s\nlibvirt_guests_active=%s\n' \
        "''${LIBVIRTD_SERVICE_ENABLED:-unknown}" "''${LIBVIRT_GUESTS_ENABLED:-unknown}" "''${LIBVIRTD_SOCKET_ENABLED:-unknown}" "''${LIBVIRTD_SOCKET_ACTIVE:-unknown}" "''${LIBVIRTD_SERVICE_ACTIVE:-unknown}" "''${LIBVIRT_GUESTS_ACTIVE:-unknown}"
      if [[ -e "$LIBVIRTD_WANT" || -L "$LIBVIRTD_WANT" ]]; then echo 'libvirtd_multi_user_want=present'; fail 'libvirtd.service remains wanted by multi-user.target'; else echo 'libvirtd_multi_user_want=absent'; fi
      if [[ -e "$LIBVIRT_GUESTS_WANT" || -L "$LIBVIRT_GUESTS_WANT" ]]; then echo 'libvirt_guests_multi_user_want=present'; fail 'libvirt-guests.service remains wanted by multi-user.target'; else echo 'libvirt_guests_multi_user_want=absent'; fi
      case "$LIBVIRTD_SERVICE_ENABLED" in enabled|enabled-runtime) fail 'libvirtd.service has explicit systemctl enablement outside the source-owned target-want policy' ;; esac
      case "$LIBVIRT_GUESTS_ENABLED" in enabled|enabled-runtime) fail 'libvirt-guests.service has explicit systemctl enablement outside the source-owned target-want policy' ;; esac
      case "$LIBVIRTD_SOCKET_ENABLED" in enabled|enabled-runtime|linked|linked-runtime|alias) ;; *) fail "libvirtd.socket is not enabled for on-demand readiness: ''${LIBVIRTD_SOCKET_ENABLED:-unknown}" ;; esac
      [[ "$LIBVIRTD_SOCKET_ACTIVE" == active ]] || fail "libvirtd.socket is not active for on-demand readiness: ''${LIBVIRTD_SOCKET_ACTIVE:-unknown}"
      [[ "$LIBVIRTD_SERVICE_ACTIVE" != failed ]] || fail 'libvirtd.service is failed'
      [[ "$LIBVIRT_GUESTS_ACTIVE" != failed ]] || fail 'libvirt-guests.service is failed'
      if (( FAIL == OPTIONAL_POLICY_FAIL_BEFORE )); then
        echo 'MNX_OPTIONAL_SERVICE_POLICY=PASS'
      else
        echo 'MNX_OPTIONAL_SERVICE_POLICY=FAIL'
      fi

      #@MNX-PART id=99.80.mnx-config-audit.phase.mnxcrypt-integration kind=phase title="Phase: MNXCRYPT ROOTLESS VAULT INTEGRATION"
      section 'MNXCRYPT ROOTLESS VAULT INTEGRATION'
      MNXCRYPT_FAIL_BEFORE="$FAIL"
      for name in mnxcrypt mnxcrypt-pinentry; do
        MNXCRYPT_LIVE_PROGRAM="/etc/monsternix/bin/$name"
        MNXCRYPT_CLOSURE_PROGRAM="$RUNNING_SYSTEM/etc/monsternix/bin/$name"
        MNXCRYPT_CLOSURE_RESOLVED="$(readlink -f -- "$MNXCRYPT_CLOSURE_PROGRAM" 2>/dev/null || true)"
        [[ -x "$MNXCRYPT_LIVE_PROGRAM" && -f "$MNXCRYPT_LIVE_PROGRAM" ]] || fail "mnxcrypt live projection is missing or non-executable: $MNXCRYPT_LIVE_PROGRAM"
        [[ -x "$MNXCRYPT_CLOSURE_PROGRAM" && -n "$MNXCRYPT_CLOSURE_RESOLVED" && -f "$MNXCRYPT_CLOSURE_RESOLVED" ]] || fail "mnxcrypt running-closure projection is missing or non-executable: $MNXCRYPT_CLOSURE_PROGRAM"
        case "$MNXCRYPT_CLOSURE_RESOLVED" in /nix/store/*) ;; *) fail "mnxcrypt closure projection resolves outside the Nix store: $MNXCRYPT_CLOSURE_PROGRAM -> ''${MNXCRYPT_CLOSURE_RESOLVED:-unresolved}" ;; esac
        MNXCRYPT_LIVE_SHA="$(sha256sum "$MNXCRYPT_LIVE_PROGRAM" | awk '{print $1}')"
        MNXCRYPT_CLOSURE_SHA="$(sha256sum "$MNXCRYPT_CLOSURE_RESOLVED" | awk '{print $1}')"
        MNXCRYPT_LIVE_META="$(stat -Lc '%U:%G:%a' "$MNXCRYPT_LIVE_PROGRAM" 2>/dev/null || true)"
        printf 'mnxcrypt_projection[%s]_live=%s\nmnxcrypt_projection[%s]_closure=%s\nmnxcrypt_projection[%s]_sha256=%s\nmnxcrypt_projection[%s]_metadata=%s\n' \
          "$name" "$MNXCRYPT_LIVE_PROGRAM" "$name" "$MNXCRYPT_CLOSURE_RESOLVED" "$name" "$MNXCRYPT_LIVE_SHA" "$name" "''${MNXCRYPT_LIVE_META:-unreadable}"
        [[ "$MNXCRYPT_LIVE_SHA" == "$MNXCRYPT_CLOSURE_SHA" ]] || fail "mnxcrypt live projection differs from the running closure: $name"
        [[ "$MNXCRYPT_LIVE_META" == root:root:755 ]] || fail "mnxcrypt live projection metadata differs from root:root:755: $name -> ''${MNXCRYPT_LIVE_META:-unreadable}"
      done
      MNXCRYPT_PUBLIC_PROGRAM=/run/current-system/sw/bin/mnxcrypt
      MNXCRYPT_PUBLIC_RESOLVED="$(readlink -f -- "$MNXCRYPT_PUBLIC_PROGRAM" 2>/dev/null || true)"
      [[ -x "$MNXCRYPT_PUBLIC_PROGRAM" && -n "$MNXCRYPT_PUBLIC_RESOLVED" && -f "$MNXCRYPT_PUBLIC_RESOLVED" ]] || fail 'mnxcrypt public wrapper is missing or non-executable'
      case "$MNXCRYPT_PUBLIC_RESOLVED" in /nix/store/*) ;; *) fail "mnxcrypt public wrapper resolves outside the Nix store: ''${MNXCRYPT_PUBLIC_RESOLVED:-unresolved}" ;; esac
      grep -Fq 'exec /etc/monsternix/bin/mnxcrypt "$@"' "$MNXCRYPT_PUBLIC_RESOLVED" || fail 'mnxcrypt public wrapper does not delegate to the source-owned /etc projection'
      printf 'mnxcrypt_public_wrapper=%s\n' "$MNXCRYPT_PUBLIC_RESOLVED"
      [[ ! -e /etc/monsternix/bin/mnxcrypt-open-files && ! -L /etc/monsternix/bin/mnxcrypt-open-files ]] || fail 'retired mnxcrypt-open-files helper remains installed'
      if [[ -x /run/wrappers/bin/fusermount3 ]]; then
        printf 'mnxcrypt_fusermount3=%s\n' "$(stat -Lc '%U:%G:%a' /run/wrappers/bin/fusermount3 2>/dev/null || echo unreadable)"
        [[ -u /run/wrappers/bin/fusermount3 ]] || fail 'fusermount3 wrapper is not setuid for rootless FUSE unmount'
      else
        fail 'NixOS fusermount3 wrapper is unavailable'
      fi
      for program in '${pkgs.gocryptfs}/bin/gocryptfs' '${pkgs.sirikali}/bin/sirikali' '${pkgs.pinentry-qt}/bin/pinentry-qt'; do
        [[ -x "$program" ]] || fail "mnxcrypt closure dependency is unavailable: $program"
      done
      [[ ! -x /run/current-system/sw/bin/pcmanfm ]] || fail 'operator-retired PCManFM remains in the active system profile'
      env -u HOME MNXCRYPT_ALLOW_ROOT_FOR_TESTS=1 /etc/monsternix/bin/mnxcrypt self-test || fail 'mnxcrypt installed HOME-unset self-test failed'
      MNXCRYPT_POLICY_OUTPUT="$(env -u HOME MNXCRYPT_ALLOW_ROOT_FOR_TESTS=1 /etc/monsternix/bin/mnxcrypt policy 2>&1)" || fail "mnxcrypt installed HOME-unset policy failed: $MNXCRYPT_POLICY_OUTPUT"
      printf '%s\n' "$MNXCRYPT_POLICY_OUTPUT"
      for field in \
        'schema=mnxcrypt.policy.v6' \
        'activation_probe_environment=home-may-be-unset-for-policy-and-self-test-real-vault-commands-require-home-or-both-explicit-paths' \
        'vault_selection=public-environment-vault-id-cipher-directory-mount-directory-or-default' \
        'vault_creation=interactive-terminal-only-empty-user-owned-cipherdir' \
        'create_password_prompts=two-graphical-pinentry-invocations-enforced-by-gocryptfs' \
        'create_recovery_key=printed-once-directly-by-gocryptfs-to-operator-terminal-never-captured-by-mnxcrypt' \
        'open_requires_explicit_command=yes' \
        'default_open_command=none' \
        'custom_command_mount_token=@MOUNT@' \
        'tracked_lifetime=systemd-user-transient-service-exittype-cgroup-all-descendants-that-remain-in-the-cgroup' \
        'plaintext_write_semantics=encrypted-into-cipherdir-continuously-while-mounted' \
        'managed_close_condition=last-tracked-session-cgroup-exits-syncfs-succeeds-and-normal-unmount-is-not-busy' \
        'managed_close_semantics=syncfs-then-remove-plaintext-view-by-normal-unmount-no-bulk-reencrypt-pass' \
        'pre_close_flush_failure=leave-mounted-critical-notification-and-no-false-lock-claim' \
        'busy_close_behavior=detached-normal-unmount-retry-never-force-or-lazy' \
        'file_manager_integration=none' \
        'real_vault_qualification=operator-run-required-after-accepted-switch' \
        'MNXCRYPT_POLICY=PASS'; do
        grep -Fxq "$field" <<<"$MNXCRYPT_POLICY_OUTPUT" || fail "mnxcrypt policy field is missing: $field"
      done
      /etc/monsternix/bin/mnxcrypt-pinentry --self-test || fail 'mnxcrypt pinentry adapter self-test failed'
      /etc/monsternix/bin/mnxcrypt-pinentry --check-program || fail 'mnxcrypt pinentry executable check failed'

      MNXCRYPT_DOCTOR_OUTPUT="$(env HOME=/var/empty MNXCRYPT_ALLOW_ROOT_FOR_TESTS=1 MNXCRYPT_VAULT_ID=audit-uninitialized MNXCRYPT_CIPHER_DIR=/var/empty/mnxcrypt-audit-uninitialized.cipher MNXCRYPT_MOUNT_DIR=/var/empty/mnxcrypt-audit-uninitialized.mount /etc/monsternix/bin/mnxcrypt doctor 2>&1)" && MNXCRYPT_DOCTOR_RC=0 || MNXCRYPT_DOCTOR_RC=$?
      printf '%s\n' "$MNXCRYPT_DOCTOR_OUTPUT"
      [[ "$MNXCRYPT_DOCTOR_RC" == 1 ]] || fail "mnxcrypt uninitialized-vault doctor returned an unexpected status: $MNXCRYPT_DOCTOR_RC"
      grep -Fxq 'cipher_directory=not-initialized' <<<"$MNXCRYPT_DOCTOR_OUTPUT" || fail 'mnxcrypt doctor did not classify the synthetic vault as uninitialized'
      grep -Fxq 'MNXCRYPT_DOCTOR=REVIEW' <<<"$MNXCRYPT_DOCTOR_OUTPUT" || fail 'mnxcrypt doctor did not preserve review semantics for an uninitialized vault'

      MNXCRYPT_USER_UID="$(id -u h0p3 2>/dev/null || true)"
      MNXCRYPT_USER_RUNTIME="/run/user/$MNXCRYPT_USER_UID"
      if [[ "$MNXCRYPT_USER_UID" =~ ^[0-9]+$ && -S "$MNXCRYPT_USER_RUNTIME/bus" ]]; then
        MNXCRYPT_PROBE_UNIT="mnxcrypt-audit-$$"
        if ${pkgs.util-linux}/bin/runuser -u h0p3 -- env XDG_RUNTIME_DIR="$MNXCRYPT_USER_RUNTIME" DBUS_SESSION_BUS_ADDRESS="unix:path=$MNXCRYPT_USER_RUNTIME/bus" ${pkgs.systemd}/bin/systemd-run --user --quiet --wait --collect --unit="$MNXCRYPT_PROBE_UNIT" --property=Type=exec --property=ExitType=cgroup --property=KillMode=control-group -- ${pkgs.coreutils}/bin/true; then
          echo 'mnxcrypt_systemd_user_cgroup_probe=pass'
        else
          fail 'mnxcrypt could not prove a transient ExitType=cgroup user-service backend for h0p3'
        fi
      else
        fail 'h0p3 user-manager D-Bus is unavailable despite explicit automatic-login desktop policy'
      fi

      MNXCRYPT_TMP="$(mktemp -d /tmp/mnxcrypt-audit.XXXXXX)"
      install -d -m 0700 "$MNXCRYPT_TMP/home" "$MNXCRYPT_TMP/runtime" "$MNXCRYPT_TMP/mount"
      cat > "$MNXCRYPT_TMP/mock-gocryptfs" <<'MOCK_GOCRYPTFS'
      #!${pkgs.bash}/bin/bash
      set -Eeuo pipefail
      printf '%s\n' '--- invocation ---' "$@" >> "$MNXCRYPT_TEST_ROOT/gocryptfs.args"
      action=mount
      for arg in "$@"; do
        case "$arg" in -init) action=init ;; -info) action=info ;; esac
      done
      cipher_dir="''${!#}"
      case "$action" in
        init)
          case "''${MNXCRYPT_TEST_CREATE_MODE:-success}" in
            success)
              mkdir -p -- "$cipher_dir"
              printf '%s\n' '{"Creator":"mock"}' > "$cipher_dir/gocryptfs.conf"
              printf '0123456789abcdef' > "$cipher_dir/gocryptfs.diriv"
              printf '%s\n' 'Your master key is:' 'TEST-ONLY-NOT-A-REAL-KEY' 'The gocryptfs filesystem has been created successfully.'
              ;;
            cancel) exit 9 ;;
            partial)
              mkdir -p -- "$cipher_dir"
              printf 'partial-state-preserved' > "$cipher_dir/partial"
              exit 44
              ;;
            *) exit 64 ;;
          esac
          ;;
        info)
          printf '%s\n' 'Creator: mock gocryptfs' 'FeatureFlags: GCMIV128 HKDF DirIV'
          ;;
        *) exit 64 ;;
      esac
      MOCK_GOCRYPTFS
      cat > "$MNXCRYPT_TMP/mock-systemctl" <<'MOCK_SYSTEMCTL'
      #!${pkgs.bash}/bin/bash
      set -Eeuo pipefail
      case " $* " in
        *' --user list-units '*) exit 0 ;;
        *' --user show '*) printf 'inactive\n'; exit 0 ;;
        *) exit 0 ;;
      esac
      MOCK_SYSTEMCTL
      chmod 0700 "$MNXCRYPT_TMP/mock-gocryptfs" "$MNXCRYPT_TMP/mock-systemctl"
      # A redirected/nonterminal create must refuse before creating or prompting.
      set +e
      env \
          HOME="$MNXCRYPT_TMP/home" \
          XDG_RUNTIME_DIR="$MNXCRYPT_TMP/runtime" \
          MNXCRYPT_RUNTIME_ROOT="$MNXCRYPT_TMP/runtime/state-nonterminal" \
          MNXCRYPT_ALLOW_ROOT_FOR_TESTS=1 \
          MNXCRYPT_TEST_ROOT="$MNXCRYPT_TMP" \
          MNXCRYPT_VAULT_ID=audit-nonterminal \
          MNXCRYPT_CIPHER_DIR="$MNXCRYPT_TMP/nonterminal.cipher" \
          MNXCRYPT_MOUNT_DIR="$MNXCRYPT_TMP/nonterminal.mount" \
          MNXCRYPT_GOCRYPTFS="$MNXCRYPT_TMP/mock-gocryptfs" \
          MNXCRYPT_SYSTEMCTL="$MNXCRYPT_TMP/mock-systemctl" \
          MNXCRYPT_SYSTEMD_RUN='${pkgs.coreutils}/bin/true' \
          MNXCRYPT_FINDMNT='${pkgs.coreutils}/bin/false' \
          MNXCRYPT_NOTIFY_SEND='${pkgs.coreutils}/bin/true' \
          /etc/monsternix/bin/mnxcrypt create >"$MNXCRYPT_TMP/nonterminal.out" 2>&1
      MNXCRYPT_NONTERMINAL_RC=$?
      set -e
      [[ "$MNXCRYPT_NONTERMINAL_RC" == 64 ]] || fail "mnxcrypt nonterminal create refusal returned $MNXCRYPT_NONTERMINAL_RC rather than 64"
      grep -Fq 'must run in an interactive terminal' "$MNXCRYPT_TMP/nonterminal.out" || fail 'mnxcrypt nonterminal create refusal diagnostic is missing'
      [[ ! -e "$MNXCRYPT_TMP/nonterminal.cipher" && ! -L "$MNXCRYPT_TMP/nonterminal.cipher" ]] || fail 'mnxcrypt nonterminal create mutated the cipher path'

      if ! env \
          HOME="$MNXCRYPT_TMP/home" \
          XDG_RUNTIME_DIR="$MNXCRYPT_TMP/runtime" \
          MNXCRYPT_RUNTIME_ROOT="$MNXCRYPT_TMP/runtime/state" \
          MNXCRYPT_ALLOW_ROOT_FOR_TESTS=1 \
          MNXCRYPT_ALLOW_NONTTY_CREATE_FOR_TESTS=1 \
          MNXCRYPT_TEST_ROOT="$MNXCRYPT_TMP" \
          MNXCRYPT_VAULT_ID=audit-create \
          MNXCRYPT_CIPHER_DIR="$MNXCRYPT_TMP/new-vault.cipher" \
          MNXCRYPT_MOUNT_DIR="$MNXCRYPT_TMP/mount" \
          MNXCRYPT_GOCRYPTFS="$MNXCRYPT_TMP/mock-gocryptfs" \
          MNXCRYPT_SYSTEMCTL="$MNXCRYPT_TMP/mock-systemctl" \
          MNXCRYPT_SYSTEMD_RUN='${pkgs.coreutils}/bin/true' \
          MNXCRYPT_FINDMNT='${pkgs.coreutils}/bin/false' \
          MNXCRYPT_NOTIFY_SEND='${pkgs.coreutils}/bin/true' \
          /etc/monsternix/bin/mnxcrypt create >"$MNXCRYPT_TMP/create.out" 2>&1; then
        cat "$MNXCRYPT_TMP/create.out" >&2 || true
        fail 'mnxcrypt synthetic terminal-create contract failed'
      else
        cat "$MNXCRYPT_TMP/create.out"
        grep -Fxq 'MNXCRYPT_CREATE=PASS' "$MNXCRYPT_TMP/create.out" || fail 'mnxcrypt synthetic create did not publish PASS'
        grep -Fq 'TEST-ONLY-NOT-A-REAL-KEY' "$MNXCRYPT_TMP/create.out" || fail 'mnxcrypt synthetic create swallowed the direct recovery-key output'
        [[ -f "$MNXCRYPT_TMP/new-vault.cipher/gocryptfs.conf" && ! -L "$MNXCRYPT_TMP/new-vault.cipher/gocryptfs.conf" ]] || fail 'mnxcrypt synthetic create lacks regular gocryptfs.conf'
        [[ -f "$MNXCRYPT_TMP/new-vault.cipher/gocryptfs.diriv" && ! -L "$MNXCRYPT_TMP/new-vault.cipher/gocryptfs.diriv" ]] || fail 'mnxcrypt synthetic create lacks regular gocryptfs.diriv'
        [[ "$(stat -c %a "$MNXCRYPT_TMP/new-vault.cipher")" == 700 ]] || fail 'mnxcrypt synthetic cipher directory is not mode 0700'
        [[ "$(stat -c %a "$MNXCRYPT_TMP/mount")" == 700 ]] || fail 'mnxcrypt synthetic mount directory is not mode 0700'
        grep -Fxq -- '-init' "$MNXCRYPT_TMP/gocryptfs.args" || fail 'mnxcrypt synthetic create did not invoke gocryptfs -init'
        [[ "$(grep -c '^-extpass$' "$MNXCRYPT_TMP/gocryptfs.args")" == 2 ]] || fail 'mnxcrypt synthetic create did not pass exactly two extpass option occurrences'
        ! grep -Fq -- '-passfile' "$MNXCRYPT_TMP/gocryptfs.args" || fail 'mnxcrypt synthetic create used a password file'
      fi

      # There is no injected/default application: open without FOOBAR refuses before gocryptfs.
      MNXCRYPT_INVOCATIONS_BEFORE="$(grep -c '^--- invocation ---$' "$MNXCRYPT_TMP/gocryptfs.args")"
      set +e
      env \
          HOME="$MNXCRYPT_TMP/home" \
          XDG_RUNTIME_DIR="$MNXCRYPT_TMP/runtime" \
          MNXCRYPT_RUNTIME_ROOT="$MNXCRYPT_TMP/runtime/state" \
          MNXCRYPT_ALLOW_ROOT_FOR_TESTS=1 \
          MNXCRYPT_TEST_ROOT="$MNXCRYPT_TMP" \
          MNXCRYPT_VAULT_ID=audit-create \
          MNXCRYPT_CIPHER_DIR="$MNXCRYPT_TMP/new-vault.cipher" \
          MNXCRYPT_MOUNT_DIR="$MNXCRYPT_TMP/mount" \
          MNXCRYPT_GOCRYPTFS="$MNXCRYPT_TMP/mock-gocryptfs" \
          MNXCRYPT_SYSTEMCTL="$MNXCRYPT_TMP/mock-systemctl" \
          MNXCRYPT_SYSTEMD_RUN='${pkgs.coreutils}/bin/true' \
          MNXCRYPT_FINDMNT='${pkgs.coreutils}/bin/false' \
          MNXCRYPT_NOTIFY_SEND='${pkgs.coreutils}/bin/true' \
          /etc/monsternix/bin/mnxcrypt open -- >"$MNXCRYPT_TMP/open-no-command.out" 2>&1
      MNXCRYPT_NO_COMMAND_RC=$?
      set -e
      [[ "$MNXCRYPT_NO_COMMAND_RC" == 64 ]] || fail "mnxcrypt open-without-command returned $MNXCRYPT_NO_COMMAND_RC rather than 64"
      grep -Fq 'open requires an explicit COMMAND' "$MNXCRYPT_TMP/open-no-command.out" || fail 'mnxcrypt explicit-command refusal diagnostic is missing'
      [[ "$(grep -c '^--- invocation ---$' "$MNXCRYPT_TMP/gocryptfs.args")" == "$MNXCRYPT_INVOCATIONS_BEFORE" ]] || fail 'mnxcrypt open-without-command invoked gocryptfs'

      # A failed init that wrote anything is preserved and escalated as review, never deleted.
      set +e
      env \
          HOME="$MNXCRYPT_TMP/home" \
          XDG_RUNTIME_DIR="$MNXCRYPT_TMP/runtime" \
          MNXCRYPT_RUNTIME_ROOT="$MNXCRYPT_TMP/runtime/state-partial" \
          MNXCRYPT_ALLOW_ROOT_FOR_TESTS=1 \
          MNXCRYPT_ALLOW_NONTTY_CREATE_FOR_TESTS=1 \
          MNXCRYPT_TEST_CREATE_MODE=partial \
          MNXCRYPT_TEST_ROOT="$MNXCRYPT_TMP" \
          MNXCRYPT_VAULT_ID=audit-partial \
          MNXCRYPT_CIPHER_DIR="$MNXCRYPT_TMP/partial-vault.cipher" \
          MNXCRYPT_MOUNT_DIR="$MNXCRYPT_TMP/partial.mount" \
          MNXCRYPT_GOCRYPTFS="$MNXCRYPT_TMP/mock-gocryptfs" \
          MNXCRYPT_SYSTEMCTL="$MNXCRYPT_TMP/mock-systemctl" \
          MNXCRYPT_SYSTEMD_RUN='${pkgs.coreutils}/bin/true' \
          MNXCRYPT_FINDMNT='${pkgs.coreutils}/bin/false' \
          MNXCRYPT_NOTIFY_SEND='${pkgs.coreutils}/bin/true' \
          /etc/monsternix/bin/mnxcrypt create >"$MNXCRYPT_TMP/partial.out" 2>&1
      MNXCRYPT_PARTIAL_RC=$?
      set -e
      [[ "$MNXCRYPT_PARTIAL_RC" == 70 ]] || fail "mnxcrypt partial-create returned $MNXCRYPT_PARTIAL_RC rather than 70"
      grep -Fxq 'MNXCRYPT_CREATE=FAIL_PARTIAL_44' "$MNXCRYPT_TMP/partial.out" || fail 'mnxcrypt partial-create marker is missing'
      [[ -f "$MNXCRYPT_TMP/partial-vault.cipher/partial" ]] || fail 'mnxcrypt deleted partial vault state after failed initialization'

      rm -rf -- "$MNXCRYPT_TMP"
      if (( FAIL == MNXCRYPT_FAIL_BEFORE )); then
        echo 'MNXCRYPT_INTEGRATION=PASS'
      else
        echo 'MNXCRYPT_INTEGRATION=FAIL'
      fi

      #@MNX-PART id=99.80.mnx-config-audit.phase.presslog-integration kind=phase title="Phase: PRESSLOG DURABLE ENCRYPTED INPUT JOURNAL"
      section 'PRESSLOG DURABLE ENCRYPTED INPUT JOURNAL'
      PRESSLOG_FAIL_BEFORE="$FAIL"
      for name in presslog-pinentry presslog presslog-service mnx-presslog-observe; do
        PRESSLOG_LIVE_PROGRAM="/etc/monsternix/bin/$name"
