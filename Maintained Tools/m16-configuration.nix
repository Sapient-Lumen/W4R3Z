          ])
          return ("\n".join(lines) + "\n").encode("utf-8")
            
      #@MNX-PART id=40.31.mnx-exposure.function.capture kind=function title="Python function capture"
      def capture(config: pathlib.Path, log_root: pathlib.Path, state_root: pathlib.Path, prom: pathlib.Path, *, quiet: bool) -> dict[str, Any]:
          root_required = os.environ.get("MNX_EXPOSURE_SELF_TEST") != "1"
          if root_required and os.geteuid() != 0:
              raise ExposureError("exposure capture requires root")
          policy = parse_policy(config)
          listeners, raw_ss, collection = collect_listeners()
          auxiliary = collect_auxiliary_context()
          ephemeral_range = read_ephemeral_range()
          mode = read_mode()
          policy_result = apply_policy(listeners, policy, mode, ephemeral_range)
          now = dt.datetime.now().astimezone()
          now_epoch = int(now.timestamp())
          safe_stamp = now.strftime("%Y%m%dT%H%M%S")
          secure_directory(log_root, 0o2750, root_required=root_required)
          secure_directory(state_root, 0o750, root_required=root_required)
          secure_directory(prom.parent, 0o755, root_required=False)
          ledger, ledger_bootstrap = load_ledger(state_root, listeners, now_epoch)
          ledger = update_ledger(ledger, listeners, now_epoch)
          groups = review_groups(listeners)
          observation: dict[str, Any] = {
              "schema": VERSION, "observed_at": now.isoformat(timespec="seconds"), "observation_epoch": now_epoch,
              "source_sha256": sha256_file(config), "source_path": str(config), "policy_sha256": policy["policy_sha256"],
              "policy_mode": policy["policy_mode"], "default_disposition": policy["default_disposition"], "mode": mode,
              "census_scope": "host-network-namespace-listeners", "host_netns_inode": host_netns_inode() or "unknown",
              "raw_ss_bytes": len(raw_ss.encode("utf-8")), "boot_id": pathlib.Path("/proc/sys/kernel/random/boot_id").read_text(encoding="utf-8").strip(),
              "system": os.path.realpath("/run/current-system"), "ephemeral_udp_range": list(ephemeral_range),
              "listeners": listeners, "zones": [{key: value for key, value in zone.items() if key in REQUIRED_ZONE_FIELDS} for zone in policy["zones"]],
              "review_groups": groups, "ledger_bootstrap": ledger_bootstrap, **collection, **policy_result,
          }
          current_json = state_root / "current.json"
          current_tsv = state_root / "current.tsv"
          current_review_tsv = state_root / "review.tsv"
          current_summary = state_root / "current.txt"
          ledger_path = state_root / "ledger.json"
          previous_endpoint_ids = state_root / "previous-endpoint-ids.txt"
          previous_attribution_ids = state_root / "previous-attribution-ids.txt"
          previous_all_ids = state_root / "previous-all-ids.txt"
          previous_stable_ids = state_root / "previous-stable-ids.txt"
          endpoint_ids = sorted(item["endpoint_id"] for item in listeners if item["stable"])
          attribution_ids = sorted(item["attribution_id"] for item in listeners if item["stable"])
          all_attribution_ids = sorted(item["attribution_id"] for item in listeners)
            
          #@MNX-PART id=40.31.mnx-exposure.capture.function.read-ids kind=function title="Python nested function read_ids"
          def read_ids(path: pathlib.Path) -> list[str]:
              try:
                  return [line.strip() for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]
              except OSError:
                  return []
            
          previous_endpoints = read_ids(previous_endpoint_ids)
          previous_attributions = read_ids(previous_attribution_ids) or read_ids(previous_stable_ids)
          previous_all = read_ids(previous_all_ids)
          observation["endpoint_changed"] = int(bool(previous_endpoints) and previous_endpoints != endpoint_ids)
          observation["attribution_changed"] = int(bool(previous_attributions) and previous_attributions != attribution_ids)
          observation["stable_changed"] = observation["attribution_changed"]
          observation["all_changed"] = int(bool(previous_all) and previous_all != all_attribution_ids)
          observation["ephemeral_udp_only_changed"] = int(observation["all_changed"] == 1 and observation["stable_changed"] == 0)
          report_path = log_root / f"listeners-{safe_stamp}.txt"
          history_json = log_root / f"listeners-{safe_stamp}.json"
          history_tsv = log_root / f"listeners-{safe_stamp}.normalized.tsv"
          history_stable_tsv = log_root / f"listeners-{safe_stamp}.stable.tsv"
          history_review_tsv = log_root / f"listeners-{safe_stamp}.review.tsv"
          diff_endpoint_path = log_root / f"listeners-{safe_stamp}.endpoint.diff.txt"
          diff_attribution_path = log_root / f"listeners-{safe_stamp}.attribution.diff.txt"
          observation["latest_report"] = str(report_path)
          observation["current_json"] = str(current_json)
          observation["diff_endpoint"] = str(diff_endpoint_path)
          observation["diff_attribution"] = str(diff_attribution_path)
          observation["summary"] = summarize(observation)
            
          #@MNX-PART id=40.31.mnx-exposure.capture.function.diff-lines kind=function title="Python nested function diff_lines"
          def diff_lines(previous: list[str], current: list[str]) -> list[str]:
              if not previous:
                  return ["initial_capture=yes"]
              lines: list[str] = []
              lines.extend(f"- {item}" for item in sorted(set(previous) - set(current)))
              lines.extend(f"+ {item}" for item in sorted(set(current) - set(previous)))
              return lines or ["changed=no"]
            
          atomic_write(history_json, canonical_json(observation), 0o640, root_required=root_required)
          atomic_write(history_tsv, tsv_bytes(listeners, stable_only=False), 0o640, root_required=root_required)
          atomic_write(history_stable_tsv, tsv_bytes(listeners, stable_only=True), 0o640, root_required=root_required)
          atomic_write(history_review_tsv, review_tsv_bytes(groups), 0o640, root_required=root_required)
          atomic_write(report_path, render_report(observation, raw_ss, auxiliary), 0o640, root_required=root_required)
          atomic_write(diff_endpoint_path, ("\n".join(diff_lines(previous_endpoints, endpoint_ids)) + "\n").encode("utf-8"), 0o640, root_required=root_required)
          atomic_write(diff_attribution_path, ("\n".join(diff_lines(previous_attributions, attribution_ids)) + "\n").encode("utf-8"), 0o640, root_required=root_required)
          atomic_write(current_json, canonical_json(observation), 0o640, root_required=root_required)
          atomic_write(current_tsv, tsv_bytes(listeners, stable_only=True), 0o640, root_required=root_required)
          atomic_write(current_review_tsv, review_tsv_bytes(groups), 0o640, root_required=root_required)
          atomic_write(current_summary, ("\n".join(f"{key}={value}" for key, value in observation["summary"].items()) + "\n").encode("utf-8"), 0o640, root_required=root_required)
          atomic_write(ledger_path, canonical_json(ledger), 0o640, root_required=root_required)
          atomic_write(previous_endpoint_ids, ("\n".join(endpoint_ids) + "\n").encode("utf-8"), 0o640, root_required=root_required)
          atomic_write(previous_attribution_ids, ("\n".join(attribution_ids) + "\n").encode("utf-8"), 0o640, root_required=root_required)
          atomic_write(previous_all_ids, ("\n".join(all_attribution_ids) + "\n").encode("utf-8"), 0o640, root_required=root_required)
          atomic_write(previous_stable_ids, ("\n".join(attribution_ids) + "\n").encode("utf-8"), 0o640, root_required=root_required)
          atomic_write(prom, prometheus_bytes(observation), 0o644, root_required=False)
          if root_required:
              cutoff = now.timestamp() - LEDGER_RETENTION_SECONDS
              for candidate in log_root.glob("listeners-*"):
                  try:
                      if candidate.is_file() and candidate.stat().st_mtime < cutoff:
                          candidate.unlink()
                  except OSError:
                      pass
          if not quiet:
              print_summary(observation["summary"])
          return observation
            
      #@MNX-PART id=40.31.mnx-exposure.function.load-current kind=function title="Python function load_current"
      def load_current(state_root: pathlib.Path) -> dict[str, Any]:
          path = state_root / "current.json"
          try:
              info = path.lstat()
          except OSError as exc:
              raise ExposureError(f"current exposure record is missing: {path}: {exc}") from exc
          if not stat.S_ISREG(info.st_mode) or path.is_symlink() or info.st_mode & 0o022:
              raise ExposureError(f"current exposure record is unsafe: {path}")
          try:
              value = json.loads(path.read_text(encoding="utf-8"))
          except (OSError, json.JSONDecodeError) as exc:
              raise ExposureError(f"cannot parse current exposure record: {path}: {exc}") from exc
          if not isinstance(value, dict) or value.get("schema") != VERSION or not isinstance(value.get("listeners"), list):
              raise ExposureError(f"current exposure record has an invalid schema: {path}")
          value["current_json"] = str(path)
          return value
            
      #@MNX-PART id=40.31.mnx-exposure.function.print-summary kind=function title="Python function print_summary"
      def print_summary(summary: dict[str, Any]) -> None:
          print("################################################################################")
          print("# MNX EXPOSURE — CANONICAL ENDPOINT, ZONE, AND SOURCE-POLICY SUMMARY")
          print("################################################################################")
          print(f"MNX_EXPOSURE_VERSION={VERSION}")
          now = int(dt.datetime.now().timestamp())
          age = max(0, now - int(summary["observation_timestamp_seconds"]))
          print(f"observation_time={summary['observation_time']}")
          print(f"observation_age_seconds={age}")
          keys = (
              "source_sha256", "policy_sha256", "policy_mode", "default_disposition", "census_scope", "host_netns_inode",
              "listener_limit", "owner_pid_limit", "systemd_unit_lookup_limit", "raw_ss_bytes", "raw_listener_row_total",
              "canonical_listener_total", "duplicate_listener_row_total", "stable_listener_total", "declared_listener_total",
              "known_listener_total", "review_listener_total", "undeclared_listener_total", "ambiguous_listener_total",
              "forbidden_listener_total", "missing_required_policy_total", "attributed_listener_total", "unattributed_listener_total",
              "rpcinfo_state", "rpc_registry_required", "rpc_registry_satisfied", "rpc_active_unit_total",
              "rpc_attributed_listener_total", "rpc_program_endpoint_total", "wildcard_listener_total", "public_listener_total",
              "nonhost_netns_listener_total", "ephemeral_udp_listener_total",
              "review_group_total", "zone_conforming_total", "zone_firewall_required_total", "zone_mismatch_total", "zone_review_total",
              "new_listener_total", "recurring_listener_total", "persistent_listener_total", "endpoint_changed", "attribution_changed",
              "stable_changed", "attention_required", "latest_report", "current_json",
          )
          for key in keys:
              print(f"{key}={summary[key]}")
          print("firewall_enforcement=none-stage26-observe-only")
          print("observed_listener_auto_authorization=no")
          print(f"MNX_EXPOSURE={summary['result']}")
            
      #@MNX-PART id=40.31.mnx-exposure.function.render-full kind=function title="Python function render_full"
      def render_full(observation: dict[str, Any]) -> None:
          print_summary(summarize(observation))
          print("\n== canonical stable listener endpoints ==")
          sys.stdout.flush()
          sys.stdout.buffer.write(tsv_bytes(observation["listeners"], stable_only=True))
          sys.stdout.buffer.flush()
          print("\n== grouped review ledger ==")
          sys.stdout.flush()
          sys.stdout.buffer.write(review_tsv_bytes(observation.get("review_groups", [])))
          sys.stdout.buffer.flush()
          print("\n== missing required policy entries ==")
          for item in observation.get("missing_required_policy_ids", []):
              print(item)
          if not observation.get("missing_required_policy_ids"):
              print("none")
            
      #@MNX-PART id=40.31.mnx-exposure.function.command-policy kind=function title="Python function command_policy"
      def command_policy(args: argparse.Namespace) -> int:
          policy = parse_policy(pathlib.Path(args.config))
          payload = {
              "schema": policy["schema"], "zone_schema": policy["zone_schema"], "policy_mode": policy["policy_mode"],
              "default_disposition": policy["default_disposition"], "policy_sha256": policy["policy_sha256"],
              "zones": [{key: value for key, value in zone.items() if key in REQUIRED_ZONE_FIELDS or key == "line"} for zone in policy["zones"]],
              "entries": [{key: value for key, value in entry.items() if key in REQUIRED_ENTRY_FIELDS or key == "line"} for entry in policy["entries"]],
          }
          if args.json:
              sys.stdout.buffer.write(canonical_json(payload))
          else:
              print(f"policy_schema={payload['schema']}")
              print(f"zone_schema={payload['zone_schema']}")
              print(f"policy_mode={payload['policy_mode']}")
              print(f"default_disposition={payload['default_disposition']}")
              print(f"policy_sha256={payload['policy_sha256']}")
              print(f"zone_count={len(payload['zones'])}")
              for zone in payload["zones"]:
                  print("\t".join([zone["id"], f"interfaces={zone['interfaces']}", f"address={zone['address']}", f"bind_policy={zone['bind_policy']}", f"sources={zone['sources']}"]))
              print(f"policy_entry_count={len(payload['entries'])}")
              for entry in payload["entries"]:
                  print("\t".join([entry["id"], f"proto={entry['proto']}", f"port={entry['port']}", f"address={entry['address']}", f"unit={entry['unit']}", f"process={entry['process']}", f"disposition={entry['disposition']}", f"intent={entry['intent']}", f"zone={entry['zone']}", f"volatility={entry['volatility']}"]))
              print("firewall_allowlist_generated=no")
              print("MNX_EXPOSURE_POLICY=PASS")
          return 0
            
            
      #@MNX-PART id=40.31.mnx-exposure.function.command-zones kind=function title="Python function command_zones"
      def command_zones(args: argparse.Namespace) -> int:
          policy = parse_policy(pathlib.Path(args.config))
          if args.json:
              sys.stdout.buffer.write(canonical_json({"schema": ZONE_SCHEMA, "zones": [{key: value for key, value in zone.items() if key in REQUIRED_ZONE_FIELDS} for zone in policy["zones"]]}))
          else:
              print("zone_id\tinterfaces\taddress_classes\tbind_policy\tsources\tenforcement")
              for zone in policy["zones"]:
                  print("\t".join(zone[key] for key in ("id", "interfaces", "address", "bind_policy", "sources", "enforcement")))
              print("firewall_enforcement=none-stage26-observe-only")
              print("MNX_EXPOSURE_ZONES=PASS")
          return 0
            
            
      #@MNX-PART id=40.31.mnx-exposure.function.command-review kind=function title="Python function command_review"
      def command_review(args: argparse.Namespace) -> int:
          observation = load_current(pathlib.Path(args.state_root))
          groups = observation.get("review_groups", review_groups(observation["listeners"]))
          if args.json:
              sys.stdout.buffer.write(canonical_json({"schema": VERSION, "review_groups": groups}))
          else:
              sys.stdout.buffer.write(review_tsv_bytes(groups))
              sys.stdout.buffer.flush()
              print(f"review_group_total={len(groups)}")
              print("MNX_EXPOSURE_REVIEW=PASS")
          return 1 if summarize(observation)["result"] == "FAIL" else 0
            
      #@MNX-PART id=40.31.mnx-exposure.function.command-summary kind=function title="Python function command_summary"
      def command_summary(args: argparse.Namespace) -> int:
          observation = load_current(pathlib.Path(args.state_root))
          summary = summarize(observation)
          if args.json:
              payload = {**summary, "age_seconds": max(0, int(dt.datetime.now().timestamp()) - int(summary["observation_timestamp_seconds"]))}
              sys.stdout.buffer.write(canonical_json(payload))
          else:
              print_summary(summary)
          return 1 if summary["result"] == "FAIL" else 0
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.command-full kind=function title="Python function command_full"
      def command_full(args: argparse.Namespace) -> int:
          observation = load_current(pathlib.Path(args.state_root))
          if args.json:
              sys.stdout.buffer.write(canonical_json(observation))
          else:
              render_full(observation)
          return 1 if summarize(observation)["result"] == "FAIL" else 0
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.command-verify-current kind=function title="Python function command_verify_current"
      def command_verify_current(args: argparse.Namespace) -> int:
          observation = load_current(pathlib.Path(args.state_root))
          source = pathlib.Path(args.config)
          policy = parse_policy(source)
          if observation.get("source_sha256") != sha256_file(source):
              raise ExposureError("current exposure source hash differs from configuration.nix")
          if observation.get("policy_sha256") != policy["policy_sha256"]:
              raise ExposureError("current exposure policy hash differs from configuration.nix")
          summary = summarize(observation)
          if summary["rpc_registry_satisfied"] != "yes":
              raise ExposureError(f"current exposure RPC registry evidence is incomplete: rpcinfo_state={summary['rpcinfo_state']}")
          if summary["ambiguous_listener_total"] or summary["forbidden_listener_total"] or summary["missing_required_policy_total"]:
              raise ExposureError(
                  "current exposure contains a hard policy problem: "
                  f"ambiguous={summary['ambiguous_listener_total']} forbidden={summary['forbidden_listener_total']} "
                  f"missing_required={summary['missing_required_policy_total']}"
              )
          for key in (
              "policy_mode", "canonical_listener_total", "stable_listener_total", "declared_listener_total",
              "review_listener_total", "undeclared_listener_total", "unattributed_listener_total",
              "rpcinfo_state", "rpc_registry_required", "rpc_registry_satisfied", "rpc_active_unit_total",
              "rpc_attributed_listener_total", "rpc_program_endpoint_total", "review_group_total",
              "zone_firewall_required_total", "zone_mismatch_total", "attention_required",
          ):
              print(f"exposure_{key}={summary[key]}")
          print("MNX_EXPOSURE_CURRENT_VERIFY=PASS")
          return 0
            
