          try:
              before = configuration.lstat()
              target_text = os.readlink(configuration)
              after = configuration.lstat()
          except OSError as exc:
              raise LineageError(f"cannot read accepted office embedded configuration symlink: {configuration}: {exc}") from exc
          before_identity = (before.st_dev, before.st_ino, before.st_mode, before.st_uid, before.st_gid, before.st_size, before.st_mtime_ns, before.st_ctime_ns)
          after_identity = (after.st_dev, after.st_ino, after.st_mode, after.st_uid, after.st_gid, after.st_size, after.st_mtime_ns, after.st_ctime_ns)
          require(before_identity == after_identity, f"accepted office embedded configuration symlink changed during read: {configuration}")
          target = Path(target_text)
          lexical = target if target.is_absolute() else configuration.parent / target
          try:
              resolved = lexical.resolve(strict=True)
          except OSError as exc:
              raise LineageError(f"accepted office embedded configuration target is unavailable: {configuration}: {exc}") from exc
          if require_root:
              require(str(resolved).startswith("/nix/store/"), f"accepted office embedded configuration target is outside the Nix store: {resolved}")
          return stable_read_regular(resolved, MAX_CANDIDATE_BYTES, require_root=require_root, require_single_link=False)
      
      
      #@MNX-PART id=99.93.mnx-lineage.function.office-metadata kind=function title="Python function office_metadata"
      def office_metadata(root: Path, require_root: bool, expected_accepted_default: Path | None) -> dict[str, Any]:
          record_path = office_record_path(root, require_root=require_root)
          raw = stable_read_regular(record_path, MAX_RECORD_BYTES, require_root=require_root, require_single_link=True)
          try:
              value = json.loads(raw.decode("utf-8"))
          except (UnicodeDecodeError, json.JSONDecodeError) as exc:
              raise LineageError(f"accepted office record is not valid JSON: {record_path}") from exc
          require(isinstance(value, dict), "accepted office record is not a JSON object")
          canonical = (json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True) + "\n").encode("utf-8")
          require(raw == canonical, "accepted office record is not canonical JSON")
          accepted_stage = value.get("accepted_stage")
          accepted_sha256 = value.get("source_sha256")
          running_system = value.get("running_system")
          default_system = value.get("default_system")
          tested_system = value.get("tested_system")
          require(isinstance(accepted_stage, int) and accepted_stage > 0, "accepted office stage is invalid")
          require(isinstance(accepted_sha256, str) and HEX64_RE.fullmatch(accepted_sha256) is not None, "accepted office source SHA-256 is invalid")
          require(value.get("record_schema") == 1, "accepted office record schema is not 1")
          require(isinstance(running_system, str) and running_system.startswith("/"), "accepted office running system is invalid")
          if require_root:
              require(running_system.startswith("/nix/store/"), "accepted office running system is outside the Nix store")
          require(default_system == running_system and tested_system == running_system, "accepted office closure identities differ")
          if expected_accepted_default is not None:
              require(str(expected_accepted_default) == default_system, f"accepted office default differs from transaction baseline: office={default_system} transaction={expected_accepted_default}")
          embedded_raw = embedded_configuration_bytes(Path(default_system), require_root=require_root)
          require(sha256_bytes(embedded_raw) == accepted_sha256, "accepted office default closure embeds a different source")
          return {
              "path": str(record_path),
              "stage": accepted_stage,
              "source_sha256": accepted_sha256,
              "default_system": default_system,
          }
      
      
      #@MNX-PART id=99.93.mnx-lineage.function.classify-lineage kind=function title="Python function classify_lineage"
      def classify_lineage(candidate: dict[str, Any], office: dict[str, Any]) -> str:
          candidate_stage = int(candidate["stage"])
          candidate_sha256 = str(candidate["sha256"])
          predecessor_stage = int(candidate["predecessor_stage"])
          predecessor_sha256 = str(candidate["predecessor_sha256"])
          accepted_stage = int(office["stage"])
          accepted_sha256 = str(office["source_sha256"])
          if candidate_sha256 == accepted_sha256:
              require(candidate_stage == accepted_stage, "exact accepted source hash carries a different candidate stage")
              return "accepted-exact"
          if candidate_stage < accepted_stage + 1:
              raise LineageError(f"stale candidate stage: candidate={candidate_stage} accepted={accepted_stage}")
          if candidate_stage > accepted_stage + 1:
              raise LineageError(f"skipped candidate stage: candidate={candidate_stage} expected={accepted_stage + 1}")
          require(predecessor_stage == accepted_stage, f"forked predecessor stage: candidate={predecessor_stage} accepted={accepted_stage}")
          require(predecessor_sha256 == accepted_sha256, f"forked predecessor SHA-256: candidate={predecessor_sha256} accepted={accepted_sha256}")
          return "direct-successor"
      
      
      #@MNX-PART id=99.93.mnx-lineage.function.check kind=function title="Python function check"
      def check(candidate_path: Path, expected_sha256: str, office_root: Path, require_root: bool, expected_accepted_default: Path | None = None) -> dict[str, Any]:
          candidate_before = candidate_metadata(candidate_path, expected_sha256, require_root=require_root)
          office_before = office_metadata(office_root, require_root=require_root, expected_accepted_default=expected_accepted_default)
          candidate_after = candidate_metadata(candidate_path, expected_sha256, require_root=require_root)
          office_after = office_metadata(office_root, require_root=require_root, expected_accepted_default=expected_accepted_default)
          require(candidate_before == candidate_after, "candidate identity changed across lineage verification")
          require(office_before == office_after, "accepted office identity changed across lineage verification")
          state = classify_lineage(candidate_before, office_before)
          return {
              "schema": "mnx.candidate-lineage.v1",
              "state": state,
              "candidate": candidate_before,
              "accepted_office": office_before,
              "writes_performed": False,
              "mutation_authority": "none",
          }
      
      
      #@MNX-PART id=99.93.mnx-lineage.function.print-record kind=function title="Python function print_record"
      def print_record(record: dict[str, Any]) -> None:
          candidate = record["candidate"]
          office = record["accepted_office"]
          print(f"candidate_lineage_schema={record['schema']}")
          print(f"candidate_lineage_state={record['state']}")
          print(f"candidate_stage={candidate['stage']}")
          print(f"candidate_source_sha256={candidate['sha256']}")
          print(f"candidate_predecessor_stage={candidate['predecessor_stage']}")
          print(f"candidate_predecessor_sha256={candidate['predecessor_sha256']}")
          print(f"accepted_office_record={office['path']}")
          print(f"accepted_office_stage={office['stage']}")
          print(f"accepted_office_source_sha256={office['source_sha256']}")
          print(f"accepted_office_default_system={office['default_system']}")
          print("candidate_lineage_writes_performed=false")
          print("candidate_lineage_mutation_authority=none")
          print("MNX_CANDIDATE_LINEAGE=PASS")
      
      
      #@MNX-PART id=99.93.mnx-lineage.function.fixture-source kind=function title="Python function fixture_source"
      def fixture_source(stage: int, predecessor_stage: int, predecessor_sha256: str) -> bytes:
          return (
              "# MNX_DOCUMENT_SCHEMA=97\n"
              "#@MNX-OFFICE-BEGIN schema=1\n"
              f"#@MNX-OFFICE candidate_stage={stage}\n"
              f"#@MNX-OFFICE accepted_predecessor_stage={predecessor_stage}\n"
              f"#@MNX-OFFICE accepted_predecessor_sha256={predecessor_sha256}\n"
              "#@MNX-OFFICE-END\n"
              "{}\n"
              "# MNX-END-OF-MONOLITH schema=97 copy-paste-sentinel=present\n"
          ).encode("utf-8")
      
      
      #@MNX-PART id=99.93.mnx-lineage.function.write-fixture-office kind=function title="Python function write_fixture_office"
      def write_fixture_office(root: Path, stage: int, source_sha256: str, accepted_source: Path) -> Path:
          records = root / "records"
          records.mkdir(parents=True, exist_ok=True)
          closure = root / "nix" / "store" / "fixture-system"
          closure.mkdir(parents=True, exist_ok=True)
          (closure / "configuration.nix").write_bytes(accepted_source.read_bytes())
          (closure / "configuration.nix").chmod(0o600)
          record = {
              "accepted_stage": stage,
              "default_system": str(closure),
              "record_schema": 1,
              "running_system": str(closure),
              "source_sha256": source_sha256,
              "tested_system": str(closure),
          }
          destination = records / f"accepted-20260903T000000-{source_sha256[:12]}.json"
          destination.write_bytes((json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8"))
          destination.chmod(0o600)
          current = root / "current.json"
          current.unlink(missing_ok=True)
          current.symlink_to(Path("records") / destination.name)
          return destination
      
      
      #@MNX-PART id=99.93.mnx-lineage.function.expect-refusal kind=function title="Python function expect_refusal"
      def expect_refusal(action: Any, label: str) -> None:
          try:
              action()
          except LineageError:
              return
          raise LineageError(f"self-test expected refusal: {label}")
      
      
      #@MNX-PART id=99.93.mnx-lineage.function.self-test kind=function title="Python function self_test"
      def self_test() -> int:
          with tempfile.TemporaryDirectory(prefix="mnx-lineage-") as temporary_text:
              temporary = Path(temporary_text)
              office_root = temporary / "office"
              accepted_source = temporary / "accepted.nix"
              accepted_source.write_bytes(fixture_source(74, 73, "1" * 64))
              accepted_source.chmod(0o600)
              accepted_sha256 = sha256_bytes(accepted_source.read_bytes())
              record_path = write_fixture_office(office_root, 74, accepted_sha256, accepted_source)
              accepted_default = office_root / "nix" / "store" / "fixture-system"
              exact = check(accepted_source, accepted_sha256, office_root, require_root=False, expected_accepted_default=accepted_default)
              require(exact["state"] == "accepted-exact", "self-test exact accepted source was not recognized")
      
              successor = temporary / "successor.nix"
              successor.write_bytes(fixture_source(75, 74, accepted_sha256))
              successor.chmod(0o600)
              successor_sha256 = sha256_bytes(successor.read_bytes())
              direct = check(successor, successor_sha256, office_root, require_root=False, expected_accepted_default=accepted_default)
              require(direct["state"] == "direct-successor", "self-test direct successor was not recognized")
      
              embedded = accepted_default / "configuration.nix"
              embedded_target = accepted_default / "configuration-source.nix"
              embedded.rename(embedded_target)
              embedded.symlink_to(embedded_target.name)
              direct_symlink = check(successor, successor_sha256, office_root, require_root=False, expected_accepted_default=accepted_default)
              require(direct_symlink["state"] == "direct-successor", "self-test safe embedded configuration symlink was not accepted")
              embedded.unlink()
              embedded_target.rename(embedded)
      
              stale = temporary / "stale.nix"
              stale.write_bytes(fixture_source(73, 72, "2" * 64))
              stale.chmod(0o600)
              expect_refusal(lambda: check(stale, sha256_bytes(stale.read_bytes()), office_root, require_root=False), "stale stage")
      
              skipped = temporary / "skipped.nix"
              skipped.write_bytes(fixture_source(76, 74, accepted_sha256))
              skipped.chmod(0o600)
              expect_refusal(lambda: check(skipped, sha256_bytes(skipped.read_bytes()), office_root, require_root=False), "skipped stage")
      
              forked = temporary / "forked.nix"
              forked.write_bytes(fixture_source(75, 74, "f" * 64))
              forked.chmod(0o600)
              expect_refusal(lambda: check(forked, sha256_bytes(forked.read_bytes()), office_root, require_root=False), "forked predecessor")
              expect_refusal(lambda: check(successor, "0" * 64, office_root, require_root=False), "candidate hash mismatch")
              expect_refusal(lambda: check(successor, successor_sha256, office_root, require_root=False, expected_accepted_default=Path("/wrong")), "wrong transaction default")
      
              record_path.chmod(0o666)
              expect_refusal(lambda: check(successor, successor_sha256, office_root, require_root=False), "writable office record")
              record_path.chmod(0o600)
      
              embedded = accepted_default / "configuration.nix"
              embedded.write_bytes(b"tampered\n")
              expect_refusal(lambda: check(successor, successor_sha256, office_root, require_root=False), "office closure source mismatch")
              embedded.write_bytes(accepted_source.read_bytes())
      
              mutating = temporary / "mutating.bin"
              mutating.write_bytes(b"stable-read-fixture")
              mutating.chmod(0o600)
              real_read = os.read
              mutated = False
      
              #@MNX-PART id=99.93.mnx-lineage.function.self-test.mutating-read kind=function title="Python nested function mutating_read"
              def mutating_read(descriptor: int, count: int) -> bytes:
                  nonlocal mutated
                  data = real_read(descriptor, count)
                  if data and not mutated:
                      with mutating.open("ab", buffering=0) as stream:
                          stream.write(b"!")
                          os.fsync(stream.fileno())
                      mutated = True
                  return data
      
              os.read = mutating_read
              try:
                  expect_refusal(
                      lambda: stable_read_regular(mutating, MAX_RECORD_BYTES, require_root=False, require_single_link=True),
                      "mid-read mutation",
                  )
              finally:
                  os.read = real_read
              require(mutated, "self-test did not exercise mid-read mutation")
      
              current = office_root / "current.json"
              current.unlink()
              current.symlink_to(Path("..") / "outside.json")
              expect_refusal(lambda: check(successor, successor_sha256, office_root, require_root=False), "escaping current link")
      
          print("MNX_CANDIDATE_LINEAGE_EXACT_SELF_TEST=PASS")
          print("MNX_CANDIDATE_LINEAGE_DIRECT_SUCCESSOR_SELF_TEST=PASS")
          print("MNX_CANDIDATE_LINEAGE_STALE_FORK_SKIP_SELF_TEST=PASS")
          print("MNX_CANDIDATE_LINEAGE_OFFICE_CLOSURE_SELF_TEST=PASS")
          print("MNX_CANDIDATE_LINEAGE_EMBEDDED_SYMLINK_SELF_TEST=PASS")
          print("MNX_CANDIDATE_LINEAGE_STABLE_READ_SELF_TEST=PASS")
          print("MNX_CANDIDATE_LINEAGE_SELF_TEST=PASS")
          return 0
      
      
      #@MNX-PART id=99.93.mnx-lineage.function.build-parser kind=function title="Python function build_parser"
      def build_parser() -> argparse.ArgumentParser:
          parser = argparse.ArgumentParser(prog="mnx-lineage")
          subparsers = parser.add_subparsers(dest="command", required=True)
          check_parser = subparsers.add_parser("check", help="verify candidate succession against the accepted office")
          check_parser.add_argument("candidate", type=Path)
          check_parser.add_argument("expected_sha256")
          check_parser.add_argument("--expected-accepted-default", type=Path)
          subparsers.add_parser("self-test")
          return parser
      
      
      #@MNX-PART id=99.93.mnx-lineage.function.main kind=function title="Python function main"
      def main(argv: Sequence[str] | None = None) -> int:
          arguments = build_parser().parse_args(argv)
          try:
              if arguments.command == "self-test":
                  return self_test()
              record = check(
                  arguments.candidate,
                  arguments.expected_sha256,
                  OFFICE_ROOT,
                  require_root=True,
                  expected_accepted_default=arguments.expected_accepted_default,
              )
              print_record(record)
              return 0
          except (LineageError, OSError) as exc:
              print(f"MNX_CANDIDATE_LINEAGE=FAIL: {exc}", file=sys.stderr)
              return 1
      
      
      if __name__ == "__main__":
          raise SystemExit(main())
      #@MNX-LINEAGE-PY-END
      '';
      checkPhase = ''
        set -Eeuo pipefail
        ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
        ${pkgs.coreutils}/bin/head -n 1 "$out" | ${pkgs.gnugrep}/bin/grep -Fx '#!${pkgs.python3}/bin/python3'
        ${pkgs.gnugrep}/bin/grep -Fxc '#@MNX-LINEAGE-PY-BEGIN' "$out" | ${pkgs.gnugrep}/bin/grep -Fx 1
        ${pkgs.gnugrep}/bin/grep -Fxc '#@MNX-LINEAGE-PY-END' "$out" | ${pkgs.gnugrep}/bin/grep -Fx 1
        "$out" self-test | ${pkgs.gnugrep}/bin/grep -Fx 'MNX_CANDIDATE_LINEAGE_SELF_TEST=PASS' 
      '';
    };
    mode = "0755";
  };

}
