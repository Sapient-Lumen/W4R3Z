#@MNX-PART id=90.00.monsterdesk.function.f070-mcp-result kind=function title="Python function mcp_result"
def mcp_result(value: Any) -> dict[str, Any]:
    image: dict[str, Any] | None = None
    if isinstance(value, dict):
        if isinstance(value.get("image"), dict):
            image = value["image"]
            text_value = dict(value)
            text_value["image"] = {key: item for key, item in image.items() if key != "data_base64"}
        elif "data_base64" in value:
            image = value
            text_value = {key: item for key, item in value.items() if key != "data_base64"}
        else:
            text_value = value
    else:
        text_value = value
    content: list[dict[str, Any]] = [{"type": "text", "text": canonical(text_value)}]
    if image is not None:
        content.append({"type": "image", "data": image["data_base64"], "mimeType": image["mime_type"]})
    return {"content": content, "structuredContent": text_value, "isError": False}


#@MNX-PART id=90.00.monsterdesk.function.f071-mcp-error kind=function title="Python function mcp_error"
def mcp_error(message: str) -> dict[str, Any]:
    return {"content": [{"type": "text", "text": message}], "isError": True}


#@MNX-PART id=90.00.monsterdesk.function.f072-mcp-main kind=function title="Python function mcp_main"
def mcp_main() -> int:
    start_session(show=False)
    tools = mcp_tools()
    names = {item["name"] for item in tools}
    for raw in sys.stdin.buffer:
        if len(raw) > MAX_REQUEST_BYTES:
            continue
        try:
            message = json.loads(raw.decode("utf-8", errors="strict"))
            if not isinstance(message, dict):
                continue
            method = message.get("method")
            request_id = message.get("id")
            if method == "notifications/initialized":
                continue
            if request_id is None:
                continue
            if method == "initialize":
                result = {
                    "protocolVersion": MCP_PROTOCOL,
                    "capabilities": {"tools": {"listChanged": False}},
                    "serverInfo": {"name": "monsterdesk", "version": VERSION},
                    "instructions": (
                        "Control only the private nested Monsterdesk X11 workstation, never the host desktop. "
                        "Human and agent input may overlap. Observe again after unexpected motion or focus changes, "
                        "and pass frame.sha256 as expected_frame_sha256 for consequential input. "
                        "The MCP-exposed capsules remain network-disabled proof profiles. The dedicated persistent "
                        "Nicotine service is outside the MCP launch enum and has only its reviewed pasta TCP-2234 grant. "
                        "The nested Openbox menu is source-owned and exposes only fixed Monsterdesk profiles."
                    ),
                }
                response = {"jsonrpc": "2.0", "id": request_id, "result": result}
            elif method == "ping":
                response = {"jsonrpc": "2.0", "id": request_id, "result": {}}
            elif method == "tools/list":
                response = {"jsonrpc": "2.0", "id": request_id, "result": {"tools": tools}}
            elif method == "tools/call":
                params = message.get("params", {})
                name = params.get("name") if isinstance(params, dict) else None
                arguments = params.get("arguments", {}) if isinstance(params, dict) else {}
                if name not in names or not isinstance(arguments, dict):
                    result = mcp_error("unknown tool or invalid arguments")
                else:
                    action, _has_image = TOOL_TO_ACTION[name]
                    try:
                        value = call_daemon(action, arguments)
                        result = mcp_result(value)
                    except MonsterdeskError as exc:
                        result = mcp_error(str(exc))
                response = {"jsonrpc": "2.0", "id": request_id, "result": result}
            else:
                response = {"jsonrpc": "2.0", "id": request_id,
                            "error": {"code": -32601, "message": "Method not found"}}
        except Exception as exc:
            response = {"jsonrpc": "2.0", "id": None,
                        "error": {"code": -32700, "message": f"Parse error: {exc}"}}
        payload = (canonical(response) + "\n").encode("utf-8")
        if len(payload) <= MAX_RESPONSE_BYTES:
            sys.stdout.buffer.write(payload)
            sys.stdout.buffer.flush()
    return 0


#@MNX-PART id=90.00.monsterdesk.function.f073-doctor kind=function title="Python function doctor"
def doctor() -> dict[str, Any]:
    checks: dict[str, Any] = {}
    for name, path in DEPENDENCIES.items():
        checks[name] = {"path": str(path), "executable": path.is_file() and os.access(path, os.X_OK)}
    checks["uid"] = {"expected": USER_UID, "observed": os.getuid(), "pass": os.getuid() == USER_UID}
    checks["home"] = {"expected": str(USER_HOME), "observed": str(Path.home()), "pass": Path.home() == USER_HOME}
    try:
        host = current_host_environment()
        checks["host_x11"] = {"pass": True, **host}
    except MonsterdeskError as exc:
        checks["host_x11"] = {"pass": False, "error": str(exc)}
    try:
        runtime = runtime_base()
        checks["runtime"] = {"pass": True, "path": str(runtime)}
    except MonsterdeskError as exc:
        checks["runtime"] = {"pass": False, "error": str(exc)}
    bwrap_pass = False
    bwrap_detail = "not-run"
    if checks["bwrap"]["executable"] and Path("/nix/store").is_dir():
        command = [
            str(BWRAP), "--die-with-parent", "--new-session", "--unshare-user", "--unshare-pid",
            "--unshare-ipc", "--unshare-uts", "--unshare-net", "--cap-drop", "ALL",
            "--ro-bind", "/nix/store", "/nix/store", "--proc", "/proc", "--dev", "/dev",
            "--tmpfs", "/tmp", "--dir", "/bin", "--symlink", str(BASH), "/bin/sh",
            "--clearenv", "--setenv", "PATH", f"{COREUTILS_BIN}:{BASH.parent}", "--", str(BASH), "-c",
            'test "$(id -u)" = 1000 && test -r /nix/store && test ! -e /home/h0p3 && test ! -e /run/user/1000/bus && test -d /proc/1',
        ]
        try:
            run_checked(command, timeout=20)
            bwrap_pass = True
            bwrap_detail = "empty-root-networkless-probe-passed"
        except MonsterdeskError as exc:
            bwrap_detail = str(exc)
    checks["bubblewrap_probe"] = {"pass": bwrap_pass, "detail": bwrap_detail}
    passed = all(
        item.get("executable", True) and item.get("pass", True)
