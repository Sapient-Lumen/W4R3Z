#@MNX-DEF path=systemd.services.duperemove-m16-old-storage section=70.12 role=service ordinal=226
  systemd.services.duperemove-m16-old-storage = {
    description = "duperemove m16-old-storage (locked)";
    wants = [ "local-fs.target" ];
    after = [ "local-fs.target" ];
    unitConfig = {
      ConditionPathIsMountPoint = "/mnt/m16-old-storage";
      RequiresMountsFor = [ "/mnt/m16-old-storage" "/home/h0p3/admin/duperemove" ];
      OnFailure = "mnx-job-failure-notify@%n.service";
      RefuseManualStart = true; # old-storage may only be written by the new->old rsync mirror
    };
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Nice = 19;
      CPUSchedulingPolicy = "idle";
      IOSchedulingClass = "idle";
      TimeoutStartSec = "12h";
      TimeoutStopSec = "10min";
      KillMode = "control-group";
      UMask = "0077";
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectSystem = "full";
      RestrictSUIDSGID = true;
    };
    path = [ pkgs.bash pkgs.util-linux pkgs.duperemove ];
    script = ''
      set -euo pipefail
      JOB_START="$(date +%s)"
      JOB_SKIPPED=0
      JOB_REASON=none
      finish() { rc="$?"; /etc/monsternix/bin/mnx-job-metric duperemove-m16-old-storage "$rc" "$(( $(date +%s) - JOB_START ))" "$JOB_SKIPPED" "$JOB_REASON" || true; exit "$rc"; }
      trap finish EXIT
      L=/run/storage-maintenance.lock
      exec 9<>"$L"
      if ! flock -n -x 9; then JOB_SKIPPED=1; JOB_REASON=lock-busy; exit 0; fi
      if ! /etc/monsternix/bin/mnx-storage-preflight duperemove-m16-old-storage /mnt/m16-old-storage; then JOB_SKIPPED=1; JOB_REASON=preflight; exit 0; fi

      H=/home/h0p3/admin/duperemove/duperemove-m16-old-storage.hashfile
      duperemove -drq -r --io-threads=1 --dedupe-options=same \
        --exclude "/mnt/m16-old-storage/admin/backups" \
        --exclude "/mnt/m16-old-storage/admin/backups/*" \
        --exclude "/mnt/m16-old-storage/syncs/m21" \
        --exclude "/mnt/m16-old-storage/syncs/m21/*" \
        --hashfile="$H" /mnt/m16-old-storage
      /etc/monsternix/bin/mnx-storage-postflight duperemove-m16-old-storage
    '';
  };

#@MNX-DEF path=systemd.timers.duperemove-m16-old-storage section=70.12 role=timer ordinal=227
  systemd.timers.duperemove-m16-old-storage = {
    # Disabled: old-storage is a mirror-only target. The service remains defined
    # only so historical unit references remain understandable.
    wantedBy = lib.mkForce [ ];
    timerConfig = {
      OnCalendar = "*-01,04,07,10-15 08:30:00";
      Persistent = false;
      AccuracySec = "10min";
      RandomizedDelaySec = "30min";
    };
  };



#@MNX-CHUNK id=70.13 slug=m21-btrfs-pull title="Strict wired-first m21 Btrfs snapshot pull"
#@MNX-DEF path=systemd.services.m21-btrfs-pull-backup section=70.13 role=service ordinal=228
    systemd.services.m21-btrfs-pull-backup = {
      description = "Pull Btrfs snapshots from comfy-m21";
      wants = [ "network-online.target" ];
      after = [ "network-online.target" ];
      onFailure = [ "mnx-job-failure-notify@%n.service" ];

      unitConfig = {
        ConditionPathIsMountPoint = "/mnt/m16-new-storage";
        RequiresMountsFor = [ "/mnt/m16-new-storage" ];
      };

      path = [
        pkgs.btrfs-progs
        pkgs.coreutils
        pkgs.findutils
        pkgs.gawk # used by received-subvolume verification
        pkgs.gnugrep # classify endpoint reachability vs identity/authentication failures
        pkgs.openssh
        pkgs.util-linux
      ];

      preStart = ''
        set -euo pipefail
        umask 077

        STATE="''${STATE_DIRECTORY:-/var/lib/m21-btrfs-pull-backup}"

        install -d -m 0700 -o root -g root "$STATE"

        [ ! -L "$STATE/id_ed25519" ] || { echo "$STATE/id_ed25519 must not be a symlink" >&2; exit 1; }
        [ ! -L "$STATE/known_hosts" ] || { echo "$STATE/known_hosts must not be a symlink" >&2; exit 1; }
        if [ ! -f "$STATE/id_ed25519" ]; then
          ssh-keygen -t ed25519 -N "" -f "$STATE/id_ed25519" -C "m21-btrfs-pull-backup@$(hostname)"
        fi

        touch "$STATE/known_hosts"
        chmod 0600 "$STATE/id_ed25519" "$STATE/known_hosts"

        if [ -f "$STATE/id_ed25519.pub" ]; then
          chmod 0644 "$STATE/id_ed25519.pub"
        fi
      '';

      script = ''
        set -euo pipefail
        umask 077

        STATE="''${STATE_DIRECTORY:-/var/lib/m21-btrfs-pull-backup}"
        MOUNT_ROOT="/mnt/m16-new-storage"
        DEST="$MOUNT_ROOT/syncs/m21"
        JOB_START="$(date +%s)"
        JOB_SKIPPED=0
        JOB_REASON=starting

        # Prefer m21's wired Ethernet address, then Wi-Fi. The selected endpoint
        # is fixed for the entire Btrfs stream. Ordinary reachability failures are
        # clean skips for the freshness controller; host-key/authentication errors
        # remain hard failures.
        REMOTE_USER="h0p3"
        REMOTE_HOSTS=( "192.168.100.119" "192.168.1.25" )
        REMOTE_HOST=""
        REMOTE=""

        REMOTE_HELPER="sudo -n /etc/sandworm/m21-btrfs-backup-source"
        EXPECTED_REMOTE_HOSTNAME="comfy-m21"
        DEFAULT_REMOTE_HELPER_SHA256="67c62343861040656ec61923301eacdfb4261703501345890edbc6a619ba954f"
        EXPECTED_REMOTE_HELPER_SHA256="$DEFAULT_REMOTE_HELPER_SHA256"
        REMOTE_HELPER_TRUST_SOURCE=source-default
        HELPER_TRUST_FILE="$STATE/trusted-helper-sha256"
        EXPECTED_REMOTE_SOURCE_UUID="5c208c49-1b6c-411e-899c-fca29e2d5d9b"
        EXPECTED_REMOTE_HOST_KEY_FINGERPRINT="SHA256:BfdYWZn5Qiaw5c3nzteZzKp47VQExA333A5LcgrYiHc"
        SSH_KEY="$STATE/id_ed25519"
        KNOWN_HOSTS="$STATE/known_hosts"
        KEEP_LOCAL=7
        KEEP_REMOTE=8
        SNAP="home-$(date -u +%Y%m%dT%H%M%SZ)"
        RECEIVE_PATH=""
        RECEIVE_COMPLETE=0
        PARENT=""

        #@MNX-PART id=70.13.m21-btrfs-pull-backup.function.load-helper-trust kind=function title="Function load_helper_trust"
        load_helper_trust() {
          local metadata value nonblank
          EXPECTED_REMOTE_HELPER_SHA256="$DEFAULT_REMOTE_HELPER_SHA256"
          REMOTE_HELPER_TRUST_SOURCE=source-default
          [ -e "$HELPER_TRUST_FILE" ] || return 0
          [ -f "$HELPER_TRUST_FILE" ] && [ ! -L "$HELPER_TRUST_FILE" ] || { echo "$HELPER_TRUST_FILE must be a regular non-symlink file" >&2; return 1; }
          metadata="$(stat -Lc '%U:%G %a' "$HELPER_TRUST_FILE" 2>/dev/null || true)"
          [ "$metadata" = 'root:root 600' ] || { echo "$HELPER_TRUST_FILE has unsafe metadata: ''${metadata:-unreadable}" >&2; return 1; }
          nonblank="$(awk 'NF { count += 1; value=$0 } END { if (count == 1) print value; else exit 1 }' "$HELPER_TRUST_FILE")" || {
            echo "$HELPER_TRUST_FILE must contain exactly one nonblank SHA-256 line" >&2
            return 1
          }
          value="$nonblank"
          printf '%s' "$value" | grep -Eq '^[0-9a-f]{64}$' || { echo "$HELPER_TRUST_FILE does not contain exactly one canonical lowercase SHA-256" >&2; return 1; }
          EXPECTED_REMOTE_HELPER_SHA256="$value"
          REMOTE_HELPER_TRUST_SOURCE=operator-enrolled
        }

        #@MNX-PART id=70.13.m21-btrfs-pull-backup.function.record-helper-block kind=function title="Function record_helper_block"
        record_helper_block() {
          local observed="$1" now fingerprint notify=1 previous_fingerprint previous_epoch tmp
          now="$(date +%s)"
          fingerprint="$EXPECTED_REMOTE_HELPER_SHA256:$observed:$REMOTE_HELPER_TRUST_SOURCE:$REMOTE_HOST"
          if [ -r "$STATE/last-helper-mismatch" ]; then
            previous_fingerprint="$(awk -F= '$1 == "fingerprint" { print $2; exit }' "$STATE/last-helper-mismatch" 2>/dev/null || true)"
            previous_epoch="$(awk -F= '$1 == "epoch" { print $2; exit }' "$STATE/last-helper-mismatch" 2>/dev/null || true)"
            if [ "$previous_fingerprint" = "$fingerprint" ] && printf '%s' "$previous_epoch" | grep -Eq '^[0-9]+$' && [ $((now - previous_epoch)) -lt 21600 ]; then
              notify=0
            fi
          fi
          tmp="$(mktemp "$STATE/.last-helper-mismatch.XXXXXX")"
          {
            printf 'timestamp=%s\n' "$(date -Is)"
            printf 'epoch=%s\n' "$now"
            printf 'fingerprint=%s\n' "$fingerprint"
            printf 'endpoint=%s\n' "$REMOTE_HOST"
            printf 'hostname=%s\n' "$REMOTE_HOSTNAME"
            printf 'source_uuid=%s\n' "$REMOTE_SOURCE_UUID"
            printf 'helper_trust_source=%s\n' "$REMOTE_HELPER_TRUST_SOURCE"
            printf 'expected_helper_sha256=%s\n' "$EXPECTED_REMOTE_HELPER_SHA256"
            printf 'observed_helper_sha256=%s\n' "$observed"
            printf 'data_work_started=no\n'
            printf 'approval_command=mnx m21-helper approve %s\n' "$observed"
          } > "$tmp"
          chown root:root "$tmp"
          chmod 0600 "$tmp"
          mv -f "$tmp" "$STATE/last-helper-mismatch"
          if [ "$notify" -eq 1 ]; then
            /etc/monsternix/bin/mnx-notify warning \
              'm21 backup blocked before data work' \
              "Untrusted helper $observed; expected $EXPECTED_REMOTE_HELPER_SHA256 ($REMOTE_HELPER_TRUST_SOURCE). Review with: mnx m21-helper status" || true
          fi
        }

        #@MNX-PART id=70.13.m21-btrfs-pull-backup.function.cleanup_receive kind=function title="Function cleanup_receive"
        cleanup_receive() {
          if [ "$RECEIVE_COMPLETE" -eq 0 ] \
             && [ -n "$RECEIVE_PATH" ] \
             && btrfs subvolume show "$RECEIVE_PATH" >/dev/null 2>&1; then
            btrfs subvolume delete "$RECEIVE_PATH" >/dev/null 2>&1 || true
            btrfs subvolume sync "$MOUNT_ROOT" >/dev/null 2>&1 || true
          fi
        }

        #@MNX-PART id=70.13.m21-btrfs-pull-backup.function.finish kind=function title="Function finish"
        finish() {
          rc="$?"
          trap - EXIT
          cleanup_receive
          /etc/monsternix/bin/mnx-job-metric \
            m21-btrfs-pull-backup "$rc" "$(( $(date +%s) - JOB_START ))" \
            "$JOB_SKIPPED" "$JOB_REASON" || true
          if [ "$rc" -eq 76 ]; then
            echo 'm21_helper_blocked=yes'
            echo 'm21_data_work_started=no'
          fi
          exit "$rc"
        }
        trap finish EXIT

        #@MNX-PART id=70.13.m21-btrfs-pull-backup.function.verify_pinned_host_key kind=function title="Function verify_pinned_host_key"
        verify_pinned_host_key() {
          local host="$1" lines fingerprint found keyline
          lines="$STATE/probe-errors/$host.ed25519"
          ssh-keygen -F "$host" -f "$KNOWN_HOSTS" 2>/dev/null \
            | awk '$1 !~ /^#/ && $2 == "ssh-ed25519" && NF >= 3 { print $2 " " $3 }' \
            > "$lines" || true
          [ -s "$lines" ] || { echo "no enrolled ED25519 host key for $host" >&2; return 1; }
          found=0
          while IFS= read -r keyline; do
            fingerprint="$(printf '%s\n' "$keyline" | ssh-keygen -lf - 2>/dev/null | awk '{print $2; exit}')"
            [ "$fingerprint" = "$EXPECTED_REMOTE_HOST_KEY_FINGERPRINT" ] && found=1
          done < "$lines"
          rm -f "$lines"
          [ "$found" -eq 1 ] || { echo "pinned ED25519 host-key fingerprint mismatch for $host" >&2; return 1; }
        }

        #@MNX-PART id=70.13.m21-btrfs-pull-backup.function.select_remote kind=function title="Function select_remote"
        select_remote() {
          local host err rc
          install -d -m 0700 -o root -g root "$STATE/probe-errors"

          for host in "''${REMOTE_HOSTS[@]}"; do
            verify_pinned_host_key "$host" || return 2
            err="$STATE/probe-errors/$host.err"
            : > "$err"
            echo "Probing m21 backup endpoint $host" >&2

            set +e
            ssh \
              -T \
              -i "$SSH_KEY" \
              -o IdentitiesOnly=yes \
              -o BatchMode=yes \
              -o StrictHostKeyChecking=yes \
              -o UserKnownHostsFile="$KNOWN_HOSTS" \
              -o ConnectTimeout=8 \
              -o ConnectionAttempts=1 \
              -o ServerAliveInterval=15 \
              -o ServerAliveCountMax=2 \
              -o TCPKeepAlive=yes \
              -o Compression=no \
              "$REMOTE_USER@$host" \
              true \
              </dev/null 2>"$err"
            rc="$?"
            set -e

            if [ "$rc" -eq 0 ]; then
              rm -f "$err"
              REMOTE_HOST="$host"
              REMOTE="$REMOTE_USER@$host"
              printf '%s\n' "$REMOTE_HOST" > "$STATE/last-endpoint"

              if [ "$REMOTE_HOST" = "192.168.100.119" ]; then
                echo "Selected preferred wired m21 endpoint $REMOTE_HOST" >&2
              else
                echo "Wired m21 endpoint unavailable; selected Wi-Fi fallback $REMOTE_HOST" >&2
              fi
              return 0
            fi

            cat "$err" >&2 || true
            if grep -Eqi \
              'REMOTE HOST IDENTIFICATION HAS CHANGED|Host key verification failed|Permission denied|Bad owner or permissions|identity file.*not accessible|no matching host key' \
              "$err"; then
              return 2
            fi
          done

          return 75
        }

        #@MNX-PART id=70.13.m21-btrfs-pull-backup.function.run_remote kind=function title="Function run_remote"
        run_remote() {
          [ -n "$REMOTE" ] || select_remote
          ssh \
            -T \
            -i "$SSH_KEY" \
            -o IdentitiesOnly=yes \
            -o BatchMode=yes \
            -o StrictHostKeyChecking=yes \
            -o UserKnownHostsFile="$KNOWN_HOSTS" \
            -o ConnectTimeout=30 \
            -o ConnectionAttempts=3 \
            -o ServerAliveInterval=60 \
            -o ServerAliveCountMax=10 \
            -o TCPKeepAlive=yes \
            -o Compression=no \
            "$REMOTE" \
            "$@" \
            </dev/null
        }

        exec 9>"$STATE/lock"
        if ! flock -n 9; then
          echo "m21 backup already running"
          JOB_SKIPPED=1
          JOB_REASON=already-running
          exit 0
        fi

        exec 8<>/run/storage-maintenance.lock
        if ! flock -n -x 8; then
          echo "operator or another storage job owns /run/storage-maintenance.lock; freshness controller will retry" >&2
          JOB_SKIPPED=1
          JOB_REASON=lock-busy
          exit 0
        fi

        if ! /etc/monsternix/bin/mnx-storage-preflight m21-btrfs-pull-backup "$MOUNT_ROOT"; then
          echo "m21 backup skipped by storage preflight" >&2
          JOB_SKIPPED=1
          JOB_REASON=preflight
          exit 0
        fi

        mountpoint -q "$MOUNT_ROOT" || { JOB_REASON=mount; echo "$MOUNT_ROOT is not mounted" >&2; exit 1; }
        [ "$(findmnt -n -o FSTYPE --target "$MOUNT_ROOT")" = btrfs ] || { JOB_REASON=filesystem; echo "$MOUNT_ROOT is not btrfs" >&2; exit 1; }
        if [ -e "$DEST" ] && [ ! -d "$DEST" ]; then
          JOB_REASON=destination
          echo "$DEST exists but is not a directory" >&2
          exit 1
        fi
        [ -d "$DEST" ] || install -d -m 0700 -o root -g root "$DEST"

        JOB_REASON=helper-trust-state
        load_helper_trust
        printf 'helper_trust_source=%s\n' "$REMOTE_HELPER_TRUST_SOURCE"
        printf 'expected_helper_sha256=%s\n' "$EXPECTED_REMOTE_HELPER_SHA256"

        JOB_REASON=endpoint
        set +e
        select_remote
        SELECT_RC="$?"
        set -e
        case "$SELECT_RC" in
          0) ;;
          75)
            JOB_SKIPPED=1
            JOB_REASON=endpoint-unreachable
            echo "Neither m21 endpoint is currently reachable; freshness controller will retry" >&2
            exit 0
            ;;
          *)
            JOB_REASON=endpoint-identity-or-auth
            echo "m21 endpoint probe found a host-key, identity, or authentication failure" >&2
            exit 1
            ;;
        esac

        JOB_REASON=remote-identity
        REMOTE_IDENTITY="$(run_remote 'set -eu; printf "hostname=%s\n" "$(hostname)"; printf "helper_sha256=%s\n" "$(sha256sum /etc/sandworm/m21-btrfs-backup-source | awk "{print \$1}")"; printf "source_uuid=%s\n" "$(findmnt -rn -T /home -o UUID)"')"
        { printf 'host_key_fingerprint=%s\n' "$EXPECTED_REMOTE_HOST_KEY_FINGERPRINT"; printf '%s\n' "$REMOTE_IDENTITY"; } > "$STATE/last-remote-identity"
        REMOTE_HOSTNAME="$(printf '%s\n' "$REMOTE_IDENTITY" | awk -F= '$1 == "hostname" { print $2; exit }')"
        REMOTE_HELPER_SHA256="$(printf '%s\n' "$REMOTE_IDENTITY" | awk -F= '$1 == "helper_sha256" { print $2; exit }')"
        REMOTE_SOURCE_UUID="$(printf '%s\n' "$REMOTE_IDENTITY" | awk -F= '$1 == "source_uuid" { print $2; exit }')"
        [ "$REMOTE_HOSTNAME" = "$EXPECTED_REMOTE_HOSTNAME" ] || { echo "m21 hostname mismatch: $REMOTE_HOSTNAME" >&2; exit 1; }
        [ "$REMOTE_SOURCE_UUID" = "$EXPECTED_REMOTE_SOURCE_UUID" ] || { echo "m21 source UUID mismatch: $REMOTE_SOURCE_UUID" >&2; exit 1; }
        if [ "$REMOTE_HELPER_SHA256" != "$EXPECTED_REMOTE_HELPER_SHA256" ]; then
          JOB_REASON=remote-helper-untrusted
          record_helper_block "$REMOTE_HELPER_SHA256"
          echo "m21 helper SHA-256 is not trusted: observed=$REMOTE_HELPER_SHA256 expected=$EXPECTED_REMOTE_HELPER_SHA256 trust_source=$REMOTE_HELPER_TRUST_SOURCE" >&2
          echo "Review without data work: mnx m21-helper status" >&2
          echo "Approve only after review: mnx m21-helper approve $REMOTE_HELPER_SHA256" >&2
          exit 76
        fi
        rm -f "$STATE/last-helper-mismatch"

        JOB_REASON=source-init
        run_remote "$REMOTE_HELPER init"
        JOB_REASON=snapshot
        run_remote "$REMOTE_HELPER snapshot $SNAP"

        PARENT="$(find "$DEST" -maxdepth 1 -mindepth 1 -type d -name 'home-[0-9]*T[0-9]*Z' -printf '%f\n' | sort | tail -n 1 || true)"
        [ ! -e "$DEST/$SNAP" ] || { JOB_REASON=destination-exists; echo "$DEST/$SNAP already exists" >&2; exit 1; }
        RECEIVE_PATH="$DEST/$SNAP"

        JOB_REASON=parent-check
        if [ -n "$PARENT" ]; then
          set +e
          run_remote "$REMOTE_HELPER has $PARENT"
          PARENT_RC="$?"
          set -e

          case "$PARENT_RC" in
            0)
              JOB_REASON=receive
              echo "Receiving incremental snapshot $SNAP with parent $PARENT"
              run_remote "$REMOTE_HELPER send $SNAP $PARENT" | btrfs receive "$DEST"
              ;;
            1)
              PARENT=""
              JOB_REASON=receive
              echo "Remote no longer has the local parent; receiving full snapshot $SNAP"
              run_remote "$REMOTE_HELPER send $SNAP" | btrfs receive "$DEST"
              ;;
            *)
              echo "Could not reliably determine whether remote parent $PARENT exists (status $PARENT_RC); refusing an accidental full transfer" >&2
              exit "$PARENT_RC"
              ;;
          esac
        else
          JOB_REASON=receive
          echo "No local parent exists; receiving full snapshot $SNAP"
          run_remote "$REMOTE_HELPER send $SNAP" | btrfs receive "$DEST"
        fi

        JOB_REASON=verify
        [ -d "$RECEIVE_PATH" ] || { echo "receive completed without creating $RECEIVE_PATH" >&2; exit 1; }
        [ "$(btrfs property get -ts "$RECEIVE_PATH" ro | awk -F= '$1 == "ro" { print $2 }')" = true ] || { echo "$RECEIVE_PATH is not read-only" >&2; exit 1; }
        RECEIVED_UUID="$(btrfs subvolume show "$RECEIVE_PATH" | awk -F: '/Received UUID:/ { gsub(/^[ \t]+/, "", $2); print $2; exit }')"
        [ -n "$RECEIVED_UUID" ] && [ "$RECEIVED_UUID" != - ] || { echo "$RECEIVE_PATH has no Received UUID" >&2; exit 1; }
        RECEIVE_COMPLETE=1

        JOB_REASON=local-retention
        find "$DEST" -maxdepth 1 -mindepth 1 -type d -name 'home-[0-9]*T[0-9]*Z' -printf '%f\n' | sort > "$STATE/local-snaps"
        COUNT="$(wc -l < "$STATE/local-snaps" | tr -d ' ')"
        DELETE_COUNT=$((COUNT - KEEP_LOCAL))
        if [ "$DELETE_COUNT" -gt 0 ]; then
          head -n "$DELETE_COUNT" "$STATE/local-snaps" | while IFS= read -r OLD; do
            [ -d "$DEST/$OLD" ] && btrfs subvolume delete "$DEST/$OLD"
          done
        fi
        rm -f "$STATE/local-snaps"

        JOB_REASON=postflight
        btrfs subvolume sync "$MOUNT_ROOT"
        if ! /etc/monsternix/bin/mnx-storage-postflight m21-btrfs-pull-backup; then
          echo "local storage postflight failed; preserving all remote snapshots" >&2
          exit 1
        fi

        JOB_REASON=remote-retention
        run_remote "$REMOTE_HELPER prune $KEEP_REMOTE"

        DETAIL="endpoint=$REMOTE_HOST hostname=$REMOTE_HOSTNAME helper_sha256=$REMOTE_HELPER_SHA256 helper_trust_source=$REMOTE_HELPER_TRUST_SOURCE source_uuid=$REMOTE_SOURCE_UUID parent=$PARENT received_uuid=$RECEIVED_UUID"
        [ -n "$PARENT" ] || DETAIL="endpoint=$REMOTE_HOST hostname=$REMOTE_HOSTNAME helper_sha256=$REMOTE_HELPER_SHA256 helper_trust_source=$REMOTE_HELPER_TRUST_SOURCE source_uuid=$REMOTE_SOURCE_UUID parent=full received_uuid=$RECEIVED_UUID"
        /etc/monsternix/bin/mnx-job-success m21-btrfs-pull-backup "$SNAP" "$DETAIL"
        JOB_REASON=none
      '';

      serviceConfig = {
        Type = "oneshot";
        SuccessExitStatus = [ 75 76 ]; # 75=temporary reachability; 76=untrusted helper blocked before data work
        User = "root";
        Group = "root";
        StateDirectory = "m21-btrfs-pull-backup";
        StateDirectoryMode = "0700";
        UMask = "0077";
        Nice = 19;
        IOSchedulingClass = "idle";

        # A first full Btrfs send can take much longer than eight hours.
        # An eight-hour timeout kills btrfs receive, deletes the partial
        # subvolume, and forces the next run to restart from zero.
        TimeoutStartSec = "infinity";
        TimeoutStopSec = "10min";
        KillMode = "control-group";
        StandardOutput = "journal";
        StandardError = "journal";
      };
    };

#@MNX-DEF path=systemd.timers.m21-btrfs-pull-backup section=70.13 role=timer ordinal=229
    systemd.timers.m21-btrfs-pull-backup = {
      description = "Retired automatic m21 Btrfs pull; Restic is primary and history is preserved";

      # Stage85: native NixOS mask, not a mutable systemctl disable override.
      # Only scheduling retires. The manual service, snapshots and shared SSH
      # credentials remain intact; no source or destination cleanup runs here.
      enable = false;
      wantedBy = lib.mkForce [ ];

      timerConfig = {
        Unit = "m21-btrfs-pull-backup.service";
        OnCalendar = "03:25";
        RandomizedDelaySec = "30m";
        Persistent = false;
      };
    };

#@MNX-CHUNK id=70.14 slug=m21-restic-control-plane title="Enrollment-gated m16-controlled Restic replacement lane"
  # Restic is the qualified mandatory primary. Its original bootstrap proof
  # remains retained; Stage85 retires only the old Btrfs timer, not its history.
  # An empty root-owned `enabled` file remains the enrollment prerequisite;
  # without it every Restic data-bearing unit is condition-skipped.
#@MNX-DEF path=users.groups.m16-backup section=70.14 role=identity-policy ordinal=230
  users.groups.m16-backup = { };

#@MNX-DEF path=users.users.m16-backup section=70.14 role=identity-policy ordinal=231
  users.users.m16-backup = {
    isSystemUser = true;
    group = "m16-backup";
    home = "/var/lib/m16-backup-control";
    extraGroups = [ "btrbk" ];
  };

#@MNX-DEF path=systemd.services.m16-restic-enrollment-check section=70.14 role=service ordinal=232
  systemd.services.m16-restic-enrollment-check = {
    description = "Validate m16 Restic enrollment against the existing pull identity";
    unitConfig.ConditionPathExists = "/etc/nixos/secrets/m16-restic/enabled";
    serviceConfig = {
      Type = "oneshot";
      ExecStart = pkgs.writeShellScript "m16-restic-enrollment-check" ''
        set -euo pipefail
        export LC_ALL=C
        secret_root=/etc/nixos/secrets/m16-restic
        existing_root=/var/lib/m21-btrfs-pull-backup
        expected_host_fingerprint=SHA256:BfdYWZn5Qiaw5c3nzteZzKp47VQExA333A5LcgrYiHc
        expected_pull_fingerprint=SHA256:n4Kvw4B9XxRy9l43RBPFfPgR5cQUGgCtqbAJJLuTzzA

        metadata="$(${pkgs.coreutils}/bin/stat -Lc '%U:%G %a' "$secret_root")"
        [ "$metadata" = 'root:root 700' ] || {
          echo "unsafe m16 Restic secret-directory metadata: $metadata" >&2
          exit 78
        }
        [ ! -L "$secret_root" ] || { echo "$secret_root must not be a symlink" >&2; exit 78; }

        for name in enabled repository-password; do
          path="$secret_root/$name"
          [ -f "$path" ] && [ ! -L "$path" ] || {
            echo "$path must be a regular non-symlink file" >&2
            exit 78
          }
          metadata="$(${pkgs.coreutils}/bin/stat -Lc '%U:%G %a' "$path")"
          [ "$metadata" = 'root:root 600' ] || {
            echo "unsafe credential metadata for $path: $metadata" >&2
            exit 78
          }
        done
        [ ! -s "$secret_root/enabled" ] || { echo 'enabled marker must be empty' >&2; exit 78; }
        for name in repository-password; do
          [ -s "$secret_root/$name" ] || { echo "$name must not be empty" >&2; exit 78; }
        done

        password_bytes="$(${pkgs.coreutils}/bin/wc -c < "$secret_root/repository-password")"
        [ "$password_bytes" -ge 24 ] || { echo 'repository password is implausibly short' >&2; exit 78; }

        for name in id_ed25519 known_hosts; do
          path="$existing_root/$name"
          [ -f "$path" ] && [ ! -L "$path" ] || { echo "$path must be a regular non-symlink file" >&2; exit 78; }
          owner="$(${pkgs.coreutils}/bin/stat -Lc '%U:%G' "$path")"
          mode="$(${pkgs.coreutils}/bin/stat -Lc '%a' "$path")"
          [ "$owner" = root:root ] && { [ "$mode" = 400 ] || [ "$mode" = 600 ]; } || {
            echo "unsafe existing pull credential metadata for $path: $owner $mode" >&2
            exit 78
          }
        done
        observed_pull_fingerprint="$(${pkgs.openssh}/bin/ssh-keygen -y -f "$existing_root/id_ed25519" \
          | ${pkgs.openssh}/bin/ssh-keygen -lf - | ${pkgs.gawk}/bin/awk 'NF { print $2; exit }')"
        [ "$observed_pull_fingerprint" = "$expected_pull_fingerprint" ] || {
          echo 'existing m16 pull private key has the wrong public fingerprint' >&2
          exit 78
        }
        host_key_lines="$(${pkgs.openssh}/bin/ssh-keygen -F 192.168.100.119 -f "$existing_root/known_hosts" \
          | ${pkgs.gawk}/bin/awk '$1 !~ /^#/ { print }')"
        [ "$(printf '%s\n' "$host_key_lines" | ${pkgs.gawk}/bin/awk 'NF { count += 1 } END { print count + 0 }')" -eq 1 ] || {
          echo 'existing known_hosts must contain exactly one key for the wired endpoint' >&2
          exit 78
        }
        printf '%s\n' "$host_key_lines" | ${pkgs.gawk}/bin/awk '$2 == "ssh-ed25519" && NF >= 3 { found=1 } END { exit found ? 0 : 1 }' || {
          echo 'the sole m21 wired host identity must be ED25519' >&2
          exit 78
        }
        observed_host_fingerprint="$(printf '%s\n' "$host_key_lines" \
          | ${pkgs.openssh}/bin/ssh-keygen -lf - \
          | ${pkgs.gawk}/bin/awk 'NF { print $2; exit }')"
        [ "$observed_host_fingerprint" = "$expected_host_fingerprint" ] || {
          echo 'existing known_hosts does not contain the exact pinned wired ED25519 identity' >&2
          exit 78
        }

        [ "$(${pkgs.coreutils}/bin/wc -l < "$existing_root/known_hosts")" -le 8 ] || {
          echo 'existing known_hosts is unexpectedly large' >&2
          exit 78
        }
        echo 'MNX_M16_RESTIC_ENROLLMENT=PASS'
      '';
      NoNewPrivileges = true;
      PrivateDevices = true;
      PrivateTmp = true;
      ProtectHome = true;
      ProtectSystem = "strict";
    };
  };

#@MNX-DEF path=systemd.services.m16-restic-storage-prepare section=70.14 role=service ordinal=233
  systemd.services.m16-restic-storage-prepare = {
    description = "Prepare the Restic repository only on mounted m16 storage";
    after = [ "m16-restic-enrollment-check.service" ];
    requires = [ "m16-restic-enrollment-check.service" ];
    unitConfig = {
      ConditionPathExists = "/etc/nixos/secrets/m16-restic/enabled";
      ConditionPathIsMountPoint = "/mnt/m16-new-storage";
      RequiresMountsFor = [ "/mnt/m16-new-storage" ];
    };
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStart = "${pkgs.coreutils}/bin/install -d -o m16-backup -g m16-backup -m 0700 /mnt/m16-new-storage/admin/backups/restic";
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectHome = true;
      ProtectSystem = "strict";
      ReadWritePaths = [ "/mnt/m16-new-storage" ];
    };
  };

#@MNX-DEF path=systemd.services.m16-restic-repository-init section=70.14 role=service ordinal=234
  systemd.services.m16-restic-repository-init = {
    description = "Initialize the m21 Restic repository under m16-only authority";
    after = [ "m16-restic-enrollment-check.service" "m16-restic-storage-prepare.service" ];
    requires = [ "m16-restic-enrollment-check.service" "m16-restic-storage-prepare.service" ];
    unitConfig = {
      ConditionPathExists = "/etc/nixos/secrets/m16-restic/enabled";
      ConditionPathIsMountPoint = "/mnt/m16-new-storage";
      RequiresMountsFor = [ "/mnt/m16-new-storage" ];
    };
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      User = "m16-backup";
      Group = "m16-backup";
      UMask = "0077";
      LoadCredential = [ "repository-password:/etc/nixos/secrets/m16-restic/repository-password" ];
      ExecStart = pkgs.writeShellScript "m16-restic-repository-init" ''
        set -euo pipefail
        repository=/mnt/m16-new-storage/admin/backups/restic/m21
        if [ ! -f "$repository/config" ]; then
          ${pkgs.restic}/bin/restic --repo "$repository" \
            --password-file "$CREDENTIALS_DIRECTORY/repository-password" init
        fi
        exec ${pkgs.restic}/bin/restic --repo "$repository" \
          --password-file "$CREDENTIALS_DIRECTORY/repository-password" cat config >/dev/null
      '';
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectHome = true;
      ProtectSystem = "strict";
      ReadWritePaths = [ "/mnt/m16-new-storage/admin/backups/restic" ];
    };
  };

#@MNX-DEF path=systemd.services.m16-rest-server section=70.14 role=service ordinal=235
  systemd.services.m16-rest-server = {
    description = "Permanently retired reverse-direction Restic receiver guard";
    # MNX_COMPATIBILITY_TOMBSTONE: this preserves structural/ejection identity while
    # making the former m21-to-m16 connection mechanically impossible.
    unitConfig = {
      RefuseManualStart = true;
      RefuseManualStop = true;
    };
    serviceConfig = {
      Type = "oneshot";
      ExecStart = "${pkgs.coreutils}/bin/false";
      NoNewPrivileges = true;
      PrivateDevices = true;
      PrivateTmp = true;
      ProtectHome = true;
      ProtectSystem = "strict";
      RestrictAddressFamilies = [ "AF_UNIX" ];
      RestrictNamespaces = true;
    };
  };

#@MNX-DEF path=systemd.services.m16-backup-m21 section=70.14 role=service ordinal=236
  systemd.services.m16-backup-m21 = {
    description = "Pull one immutable m21 snapshot into m16's local Restic repository and publish manifested product state";
    wants = [ "network-online.target" ];
    after = [ "network-online.target" "m16-restic-enrollment-check.service" "m16-restic-repository-init.service" ];
    requires = [ "m16-restic-enrollment-check.service" "m16-restic-repository-init.service" ];
    onFailure = [ "mnx-job-failure-notify@%n.service" ];
    unitConfig = {
      ConditionPathExists = "/etc/nixos/secrets/m16-restic/enabled";
      ConditionPathIsMountPoint = "/mnt/m16-new-storage";
      RequiresMountsFor = [ "/mnt/m16-new-storage" ];
    };
    serviceConfig = {
      Type = "oneshot";
      User = "m16-backup";
      Group = "m16-backup";
      UMask = "0077";
      StateDirectory = "m16-backup-control";
      StateDirectoryMode = "0700";
      LoadCredential = [
        "ssh-key:/var/lib/m21-btrfs-pull-backup/id_ed25519"
        "known-hosts:/var/lib/m21-btrfs-pull-backup/known_hosts"
        "repository-password:/etc/nixos/secrets/m16-restic/repository-password"
      ];
      ExecStart = "+${pkgs.writeTextFile {
        name = "m16-backup-m21";
        executable = true;
        text = ''
        #!${pkgs.bash}/bin/bash
        set -Eeuo pipefail
        export LC_ALL=C SYSTEMD_PAGER=cat SYSTEMD_COLORS=0 PAGER=cat
        umask 027
        
        job_start="$(${pkgs.coreutils}/bin/date +%s)"
        repository=/mnt/m16-new-storage/admin/backups/restic/m21
        receipt=/var/lib/m16-backup-control/m21-last-source-receipt
        state_file=/var/lib/monsternix/job-state/authoritative/m16-restic-m21.current.json
        metric_file=/var/lib/node-exporter-textfile/monsternix_restic_backup.prom
        evidence_root=/var/lib/logbook/backups
        run_tag="m16-pull-$(${pkgs.coreutils}/bin/date -u +%Y%m%dT%H%M%SZ)-$$"
        stamp="$(${pkgs.coreutils}/bin/date -u +%Y%m%dT%H%M%SZ)-$$"
        staging="$evidence_root/.m16-restic-backup-$stamp.staging"
        final="$evidence_root/m16-restic-backup-$stamp"
        phase=starting
        reason=starting
        command_rc=0
        product_status=unknown
        controller_status=running
        committed=0
        network_used=false
        source_receipt_result=not-attempted
        snapshot_id=none
        snapshot_time=none
        snapshot_archive_bytes=0
        snapshot_metadata_status=not-attempted
        rebuild_bundle_status=not-attempted
        rebuild_bundle_sha256=none
        rebuild_bundle_bytes=0
        cleanup_snapshot_count=0
        cleanup_failure_count=0
        repository_cleanup_authorized=0
        manifest_sha=none
        evidence_committed=0
        
        # Nix derivation/source self-tests do not run under systemd and therefore have no
        # CREDENTIALS_DIRECTORY. Capture it safely; only the real service path validates and
        # expands credential members after the explicit nonmutating --self-test branch.
        credentials_directory="''${CREDENTIALS_DIRECTORY:-}"
        
        #@MNX-PART id=70.14.m16-backup-m21.function.source-sha kind=function title="Function source_sha"
        source_sha() {
          ${pkgs.coreutils}/bin/sha256sum /run/current-system/configuration.nix 2>/dev/null | ${pkgs.gawk}/bin/awk '{print $1}'
        }
        #@MNX-PART id=70.14.m16-backup-m21.function.running-system kind=function title="Function running_system"
        running_system() {
          ${pkgs.coreutils}/bin/readlink -f /run/current-system
        }
        #@MNX-PART id=70.14.m16-backup-m21.function.default-system kind=function title="Function default_system"
        default_system() {
          ${pkgs.coreutils}/bin/readlink -f /nix/var/nix/profiles/system
        }
        
        # This fixed root wrapper alone owns the maintenance lock, evidence publication,
        # product-state publication, and Btrfs counter pre/postflight. Network and
        # repository data operations always run as the dedicated unprivileged account.
        #@MNX-PART id=70.14.m16-backup-m21.function.as-backup kind=function title="Function as_backup"
        as_backup() {
          ${pkgs.util-linux}/bin/setpriv \
            --reuid=m16-backup --regid=m16-backup --init-groups \
            --bounding-set=-all --inh-caps=-all --ambient-caps=-all -- "$@"
        }
        
        #@MNX-PART id=70.14.m16-backup-m21.function.stage-rebuild-bundle kind=function title="Function stage_rebuild_bundle"
        stage_rebuild_bundle() {
          local rc=0 metadata
          local rebuild_ssh=("''${ssh_args[@]}")
          rebuild_ssh["$((''${#rebuild_ssh[@]}-1))"]=h0p3@192.168.100.119
          as_backup ${pkgs.coreutils}/bin/timeout --kill-after=10s 6m \
            ${pkgs.openssh}/bin/ssh "''${rebuild_ssh[@]}" \
            "/run/wrappers/bin/sudo -n -- /run/current-system/sw/bin/env -i PATH=/run/current-system/sw/bin:/run/wrappers/bin LC_ALL=C /run/current-system/sw/bin/bash --noprofile --norc -s -- $run_tag" \
            >"$staging/rebuild-bundle.stdout.log" 2>"$staging/rebuild-bundle.stderr.log" <<'MNX_REBUILD_SOURCE' || rc=$?
        set -Eeuo pipefail
        export LC_ALL=C
        umask 077
        [[ $# == 1 && $1 =~ ^m16-pull-[0-9]{8}T[0-9]{6}Z-[0-9]+$ ]] || exit 64
        attempt=$1
        [[ $(id -u) == 0 && $(hostname) == comfy-m21 ]] || exit 78
        expected_uuid=5c208c49-1b6c-411e-899c-fca29e2d5d9b
        [[ $(findmnt -rn -T /home -o UUID) == "$expected_uuid" ]] || exit 78
        btrfs subvolume show /home >/dev/null
        # The existing source lock serializes capture with the normal home exporter.
        # No cleanup handler exists until this process has acquired the lock.
        [[ -f /home/.snapshots/.m16-backup.lock && ! -L /home/.snapshots/.m16-backup.lock ]] || exit 78
        exec 9<>/home/.snapshots/.m16-backup.lock
        flock -n -x 9 || exit 75
        # Preserve only the existing deliberate nested build-cache/snapshot exclusions.
        # Direct children suffice: descendants of an excluded child are excluded with it.
        # Any other child is an unreviewed omission and must block this backup attempt.
        listing=$(btrfs subvolume list -o /home)
        while IFS= read -r row; do
          [[ -n $row ]] || continue
          [[ $row == ID\ *\ path\ * ]] || exit 78
          relative=''${row#* path }
          relative=''${relative#@home/}
          case "$relative" in
            h0p3/projects/AnonSSH/target|h0p3/projects/NATrav/target|h0p3/projects/0opschan/target|.snapshots/*) ;;
            *) printf 'Unreviewed nested home subvolume: %s\n' "$relative" >&2; exit 78 ;;
          esac
        done <<< "$listing"
        mounts=$(findmnt -rn -o TARGET)
        if printf '%s\n' "$mounts" | grep -q '^/home/'; then
          echo 'A mount beneath /home needs explicit backup coverage review.' >&2; exit 78
        fi
        bundle=/home/.monsternix-rebuild
        if [[ ! -e $bundle && ! -L $bundle ]]; then mkdir -m 0700 -- "$bundle"; fi
        [[ -d $bundle && ! -L $bundle && $(stat -Lc '%u:%g:%a' "$bundle") == 0:0:700 ]] || exit 78
        if [[ -e $bundle/m21-nixos.tar || -L $bundle/m21-nixos.tar ]]; then
          [[ -f $bundle/m21-nixos.tar && ! -L $bundle/m21-nixos.tar &&
             $(stat -Lc '%u:%g:%a:%h' "$bundle/m21-nixos.tar") == 0:0:600:1 ]] || exit 78
        fi
        [[ -d /home/.snapshots && ! -L /home/.snapshots && $(stat -Lc '%u' /home/.snapshots) == 0 ]] || exit 78
        mode=$(stat -Lc %a /home/.snapshots)
        (( (8#$mode & 8#022) == 0 )) || exit 78
        work=$(mktemp -d /home/.snapshots/m21-rebuild.XXXXXXXX)
        temporary=
        snapshot_created=no
        interrupted=no
        #@MNX-PART id=70.14.m16-backup-m21.rebuild-source.function.cleanup-rebuild kind=function title="Function cleanup_rebuild"
        cleanup_rebuild() {
          local rc=$? cleanup_rc=0
          trap - EXIT
          trap "" INT TERM HUP
          if [[ -d $work/root && ! -L $work/root ]]; then
            btrfs subvolume delete "$work/root" >&2 || cleanup_rc=1
          fi
          if [[ $snapshot_created == yes ]]; then
            btrfs subvolume sync "$work" >&2 || cleanup_rc=1
          fi
          [[ -z $temporary ]] || rm -f -- "$temporary" || cleanup_rc=1
          rm -f -- "$work/REBUILD.txt" "$work/member-list" || cleanup_rc=1
          rmdir -- "$work" || cleanup_rc=1
          if (( rc != 0 && cleanup_rc == 0 )) && [[ $interrupted == no ]]; then
            # This typed result can exist only after home identity/topology/lock preflight.
            # Never turn transport failure or unresolved snapshot cleanup into permission.
            printf 'schema=mnx.m21.rebuild-bundle.v2\nattempt=%s\nresult=unavailable-home-only\nhome_export_safe=yes\narchive_sha256=none\narchive_bytes=0\nconfiguration_sha256=none\nsource_snapshot_removed=yes\narchive_path=/home/.monsternix-rebuild/m21-nixos.tar\n' "$attempt"
            exit 0
          fi
          (( rc != 0 )) || rc=$cleanup_rc
          exit "$rc"
        }
        trap cleanup_rebuild EXIT
        trap 'interrupted=yes; exit 130' INT
        trap 'interrupted=yes; exit 143' TERM
        trap 'interrupted=yes; exit 129' HUP
        # Optional rebuild inputs: only after the mandatory home-source guard has passed.
        for path in / /etc/nixos; do
          [[ $(findmnt -rn -T "$path" -o UUID) == "$expected_uuid" ]] || exit 78
        done
        [[ -d /etc/nixos && ! -L /etc/nixos && -f /etc/nixos/configuration.nix ]] || exit 78
        [[ $(btrfs inspect-internal rootid /etc/nixos) == $(btrfs inspect-internal rootid /) ]] || exit 78
        snapshot_created=yes
        btrfs subvolume snapshot -r / "$work/root" >&2
        [[ -f $work/root/etc/nixos/configuration.nix ]] || exit 78
        configuration_sha=$(sha256sum "$work/root/etc/nixos/configuration.nix"); configuration_sha=''${configuration_sha%% *}
        cat > "$work/REBUILD.txt" <<INFO
        Monsternix m21 rebuild inputs
        Source: comfy-m21 /etc/nixos, captured from a read-only root-filesystem snapshot.
        Capture attempt: $attempt
        Capture time: $(date -Is)
        Running system: $(readlink -f /run/current-system)
        configuration.nix SHA256: $configuration_sha
        Archive paths: nixos/ contains the complete /etc/nixos tree, not just *.nix files.
        Symlinks and filesystem metadata are preserved; external symlink targets are not copied.
        Working source dependencies in /home/h0p3/projects travel in the enclosing home archive.
        No Nix package store is included. No application was stopped for this capture.
        Restore into a disposable directory first; do not extract over a live /etc/nixos.
        INFO
        temporary=$(mktemp "$bundle/.m21-nixos.XXXXXXXX")
        # Bound this small administrative bundle, never the home backup itself.
        (
          ulimit -f 262144
          tar --create --file="$temporary" --numeric-owner --acls --xattrs --xattrs-include='*' --sparse \
              --one-file-system --sort=name --directory="$work/root/etc" nixos --directory="$work" REBUILD.txt
        )
        bytes=$(stat -Lc %s "$temporary")
        [[ $bytes -gt 0 && $bytes -le 268435456 ]] || exit 78
        tar --list --file="$temporary" > "$work/member-list"
        grep -Fxq nixos/configuration.nix "$work/member-list"
        grep -Fxq REBUILD.txt "$work/member-list"
        archive_sha=$(sha256sum "$temporary"); archive_sha=''${archive_sha%% *}
        # A cleanup failure preserves the previous published bundle and stops this attempt.
        btrfs subvolume delete "$work/root" >&2
        btrfs subvolume sync "$work" >&2
        sync -f "$temporary"
        mv -T -- "$temporary" "$bundle/m21-nixos.tar"
        temporary=
        sync -f "$bundle"
        # Cleanup of this invocation's work area must finish before reporting success.
        rm -f -- "$work/REBUILD.txt" "$work/member-list"
        rmdir -- "$work"
        trap - EXIT
        printf 'schema=mnx.m21.rebuild-bundle.v2\nattempt=%s\nresult=staged-before-home-export\nhome_export_safe=yes\narchive_sha256=%s\narchive_bytes=%s\nconfiguration_sha256=%s\nsource_snapshot_removed=yes\narchive_path=/home/.monsternix-rebuild/m21-nixos.tar\n' \
          "$attempt" "$archive_sha" "$bytes" "$configuration_sha"
        MNX_REBUILD_SOURCE
          (( rc == 0 )) || return "$rc"
          metadata="$(${pkgs.python3}/bin/python3 - "$staging/rebuild-bundle.stdout.log" "$run_tag" <<'PY_REBUILD_RECEIPT'
        import pathlib, re, sys
        raw = pathlib.Path(sys.argv[1]).read_bytes()
        if len(raw) > 2048:
            raise SystemExit("rebuild receipt exceeds bound")
        fields = {}
        for line in raw.decode("ascii").splitlines():
            key, sep, value = line.partition("=")
            if not sep or key in fields:
                raise SystemExit("invalid rebuild receipt")
            fields[key] = value
        if set(fields) != {"schema", "attempt", "result", "home_export_safe", "archive_sha256", "archive_bytes", "configuration_sha256", "source_snapshot_removed", "archive_path"}:
            raise SystemExit("unexpected rebuild receipt fields")
        if (fields["schema"] != "mnx.m21.rebuild-bundle.v2" or fields["attempt"] != sys.argv[2] or
                fields["home_export_safe"] != "yes" or fields["source_snapshot_removed"] != "yes" or
                fields["archive_path"] != "/home/.monsternix-rebuild/m21-nixos.tar"):
            raise SystemExit("rebuild receipt disagrees with requested capture")
        if fields["result"] == "staged-before-home-export":
            if (any(not re.fullmatch(r"[0-9a-f]{64}", fields[k]) for k in ("archive_sha256", "configuration_sha256")) or
                    not re.fullmatch(r"[1-9][0-9]{0,8}", fields["archive_bytes"]) or int(fields["archive_bytes"]) > 268435456):
                raise SystemExit("invalid successful rebuild capture")
        elif fields["result"] == "unavailable-home-only":
            if (fields["archive_sha256"], fields["configuration_sha256"], fields["archive_bytes"]) != ("none", "none", "0"):
                raise SystemExit("home-only receipt invented a fresh configuration archive")
        else:
            raise SystemExit("unknown rebuild capture result")
        print(fields["result"], fields["archive_sha256"], fields["archive_bytes"])
        PY_REBUILD_RECEIPT
          )" || return 1
          read -r rebuild_bundle_status rebuild_bundle_sha256 rebuild_bundle_bytes <<< "$metadata"
          printf 'm21_rebuild_bundle_status=%s\nm21_rebuild_bundle_sha256=%s\nm21_rebuild_bundle_bytes=%s\n' \
            "$rebuild_bundle_status" "$rebuild_bundle_sha256" "$rebuild_bundle_bytes"
        }

        #@MNX-PART id=70.14.m16-backup-m21.function.validate-source-receipt kind=function title="Function validate_source_receipt"
        validate_source_receipt() {
          local expected="$1" file="$2"
          ${pkgs.gnugrep}/bin/grep -qx 'schema=mnx.m21.pull-source.receipt.v1' "$file" &&
          ${pkgs.gnugrep}/bin/grep -qx "result=$expected" "$file" &&
          ${pkgs.gnugrep}/bin/grep -qx 'source_hostname=comfy-m21' "$file" &&
          ${pkgs.gnugrep}/bin/grep -qx 'source_uuid=5c208c49-1b6c-411e-899c-fca29e2d5d9b' "$file" &&
          ${pkgs.gnugrep}/bin/grep -qx 'snapshot_absent=yes' "$file" &&
          ${pkgs.gnugrep}/bin/grep -qx 'network_initiator=m16' "$file" &&
          ${pkgs.gnugrep}/bin/grep -qx 'm21_outbound_connection=none' "$file" &&
          [ "$(${pkgs.coreutils}/bin/wc -c <"$file")" -le 2048 ]
        }
        
        #@MNX-PART id=70.14.m16-backup-m21.function.fetch-source-receipt kind=function title="Function fetch_source_receipt"
        fetch_source_receipt() {
          local expected="$1"
          source_receipt_result="''${expected}-requested"
          if ! as_backup ${pkgs.openssh}/bin/ssh "''${ssh_args[@]}" receipt >"$receipt.tmp" 2>"$staging/source-receipt.stderr.log"; then
            ${pkgs.coreutils}/bin/rm -f -- "$receipt.tmp"
            source_receipt_result="''${expected}-transport-failed"
            return 1
          fi
          if ! validate_source_receipt "$expected" "$receipt.tmp"; then
            ${pkgs.coreutils}/bin/rm -f -- "$receipt.tmp"
            source_receipt_result="''${expected}-invalid"
            return 1
          fi
          ${pkgs.coreutils}/bin/mv -f -- "$receipt.tmp" "$receipt" || {
            ${pkgs.coreutils}/bin/rm -f -- "$receipt.tmp"
            source_receipt_result="''${expected}-publish-failed"
            return 1
          }
          ${pkgs.coreutils}/bin/cp -- "$receipt" "$staging/source-receipt.txt"
          source_receipt_result="''${expected}-verified"
        }
        
        #@MNX-PART id=70.14.m16-backup-m21.function.identify-repository-snapshot kind=function title="Function identify_repository_snapshot"
        identify_repository_snapshot() {
          local metadata observed_now
          local -a query_rc
          snapshot_metadata_status=querying
          # The run tag is unique to this attempt. Do not use latest, a short ID, or
          # a success receipt from another run as the recovery-point identity.
          as_backup ${pkgs.coreutils}/bin/timeout --kill-after=5s 90s \
            ${pkgs.restic}/bin/restic --repo "$repository" \
              --password-file "$credentials_directory/repository-password" \
              snapshots --tag "$run_tag" --json \
              2>"$staging/repository-snapshot.stderr.log" \
            | ${pkgs.coreutils}/bin/head -c 1048577 >"$staging/repository-snapshot.json"
          query_rc=("''${PIPESTATUS[@]}")
          if (( query_rc[0] != 0 || query_rc[1] != 0 )); then
            snapshot_metadata_status=query-failed
            return 1
          fi
          observed_now="$(${pkgs.coreutils}/bin/date +%s)" || return 1
          metadata="$(${pkgs.python3}/bin/python3 - "$staging/repository-snapshot.json" "$run_tag" "$job_start" "$observed_now" <<'PY_SNAPSHOT_IDENTITY'
        import datetime as dt
        import json
        import re
        import sys

        #@MNX-PART id=70.14.m16-backup-m21.snapshot-identity.function.unique-fields kind=function title="Python function unique_fields"
        def unique_fields(pairs):
            result = {}
            for key, value in pairs:
                if key in result:
                    raise ValueError("duplicate JSON field")
                result[key] = value
            return result

        try:
            with open(sys.argv[1], "rb") as source:
                raw = source.read(1048577)
            if not 0 < len(raw) <= 1048576:
                raise ValueError("snapshot metadata exceeds bound or is empty")
            rows = json.loads(raw, object_pairs_hook=unique_fields)
            if not isinstance(rows, list) or len(rows) != 1 or not isinstance(rows[0], dict):
                raise ValueError("expected exactly one snapshot for this run")
            row = rows[0]
            run_tag = sys.argv[2]
            if not re.fullmatch(r"m16-pull-[0-9]{8}T[0-9]{6}Z-[0-9]+", run_tag):
                raise ValueError("invalid attempt identity")
            if (row.get("hostname") != "comfy-m21" or row.get("paths") != ["/m21-home.tar"] or
                    not isinstance(row.get("tags"), list) or len(row["tags"]) != 2 or
                    set(row["tags"]) != {"m16-pull", run_tag}):
                raise ValueError("snapshot host, path or tags disagree with the completed stream")
            for key in ("id", "tree"):
                if not isinstance(row.get(key), str) or not re.fullmatch(r"[0-9a-f]{64}", row[key]):
                    raise ValueError("snapshot or tree identity is not a full digest")
            timestamp = row.get("time")
            if not isinstance(timestamp, str) or not re.fullmatch(
                    r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})", timestamp):
                raise ValueError("snapshot time is not a timezone-qualified timestamp")
            snapshot_epoch = dt.datetime.fromisoformat(timestamp.replace("Z", "+00:00")).timestamp()
            started, observed = int(sys.argv[3]), int(sys.argv[4])
            if not 0 < started <= snapshot_epoch < observed + 1 or observed < started:
                raise ValueError("snapshot time is outside this attempt")
            summary = row.get("summary")
            if not isinstance(summary, dict) or type(summary.get("total_files_processed")) is not int or summary["total_files_processed"] != 1:
                raise ValueError("snapshot does not describe the single exported archive")
            size = summary.get("total_bytes_processed")
            if type(size) is not int or not 0 < size <= 9223372036854775807:
                raise ValueError("archive byte count is missing or invalid")
            print(row["id"], timestamp, size)
        except (ValueError, TypeError, KeyError, OverflowError, OSError) as error:
            print("MNX_RESTIC_SNAPSHOT_IDENTITY_ERROR: " + str(error), file=sys.stderr)
            raise SystemExit(1)
        PY_SNAPSHOT_IDENTITY
          )" || { snapshot_metadata_status=invalid; return 1; }
          read -r snapshot_id snapshot_time snapshot_archive_bytes <<< "$metadata" || return 1
          snapshot_metadata_status=matched-run
          printf 'repository_snapshot_id=%s\nrepository_snapshot_time=%s\nrepository_snapshot_archive_bytes=%s\nrepository_snapshot_proof=metadata-matched-to-completed-run-not-payload-readback\n' \
            "$snapshot_id" "$snapshot_time" "$snapshot_archive_bytes"
        }

        #@MNX-PART id=70.14.m16-backup-m21.function.begin-evidence kind=function title="Function begin_evidence"
        begin_evidence() {
          ${pkgs.coreutils}/bin/install -d -o root -g logbook -m 2750 "$evidence_root"
          [[ ! -e "$final" && ! -L "$final" && ! -e "$staging" && ! -L "$staging" ]] || {
            echo "m16 Restic backup evidence path collision: $final" >&2
            exit 1
          }
          ${pkgs.coreutils}/bin/install -d -o root -g logbook -m 0750 "$staging"
          {
            echo 'schema=mnx.restic.backup.provenance.v1'
            printf 'started_at=%s\n' "$(${pkgs.coreutils}/bin/date --iso-8601=seconds)"
            printf 'run_tag=%s\n' "$run_tag"
            echo 'network_initiator=m16'
            echo 'm21_outbound_connection=none'
            echo 'repository_authority=m16-local-only'
            echo 'secrets_recorded=false'
          } > "$staging/provenance.txt"
        }
        
        #@MNX-PART id=70.14.m16-backup-m21.function.cleanup-uncommitted-snapshots kind=function title="Function cleanup_uncommitted_snapshots"
        cleanup_uncommitted_snapshots() {
          local id
          [[ "$committed" -eq 0 && "$repository_cleanup_authorized" -eq 1 && -f "$repository/config" ]] || return 0
          while IFS= read -r id; do
            [[ -n "$id" ]] || continue
            cleanup_snapshot_count=$((cleanup_snapshot_count + 1))
            if ! as_backup ${pkgs.restic}/bin/restic --repo "$repository" \
              --password-file "$credentials_directory/repository-password" \
              forget "$id" >>"$staging/cleanup-forget.log" 2>&1; then
              cleanup_failure_count=$((cleanup_failure_count + 1))
            fi
          done < <(
            as_backup ${pkgs.restic}/bin/restic --repo "$repository" \
              --password-file "$credentials_directory/repository-password" \
              snapshots --tag "$run_tag" --json 2>"$staging/cleanup-snapshots.stderr.log" \
              | ${pkgs.jq}/bin/jq -r '.[].id' 2>/dev/null || true
          )
        }
        
        #@MNX-PART id=70.14.m16-backup-m21.function.write-summary kind=function title="Function write_summary"
        write_summary() {
          local now source running default duration
          now="$(${pkgs.coreutils}/bin/date --iso-8601=seconds)"
          source="$(source_sha || true)"
          running="$(running_system || true)"
          default="$(default_system || true)"
          duration="$(( $(${pkgs.coreutils}/bin/date +%s) - job_start ))"
          ${pkgs.jq}/bin/jq -cnS \
            --arg schema mnx.restic.backup.attempt.v1 \
            --arg recorded_at "$now" --arg source_sha256 "$source" \
            --arg running_system "$running" --arg default_system "$default" \
            --arg run_tag "$run_tag" --arg controller_status "$controller_status" \
            --arg product_status "$product_status" --arg phase "$phase" --arg reason "$reason" \
            --arg source_receipt_result "$source_receipt_result" \
            --argjson command_rc "$command_rc" --argjson duration_seconds "$duration" \
            --argjson cleanup_snapshot_count "$cleanup_snapshot_count" \
            --argjson cleanup_failure_count "$cleanup_failure_count" \
            --arg rebuild_bundle_status "$rebuild_bundle_status" --arg rebuild_bundle_sha256 "$rebuild_bundle_sha256" \
            --argjson rebuild_bundle_bytes "$rebuild_bundle_bytes" \
            --arg snapshot_id "$snapshot_id" --arg snapshot_time "$snapshot_time" \
            --arg snapshot_metadata_status "$snapshot_metadata_status" --argjson snapshot_archive_bytes "$snapshot_archive_bytes" \
            --argjson network_used "$network_used" \
            '{schema:$schema,recorded_at:$recorded_at,source_sha256:$source_sha256,running_system:$running_system,default_system:$default_system,run_tag:$run_tag,controller_status:$controller_status,product_status:$product_status,phase:$phase,reason:$reason,command_rc:$command_rc,duration_seconds:$duration_seconds,source_receipt_result:$source_receipt_result,cleanup_snapshot_count:$cleanup_snapshot_count,cleanup_failure_count:$cleanup_failure_count,network_used:$network_used,rebuild_bundle_status:$rebuild_bundle_status,rebuild_bundle_sha256:$rebuild_bundle_sha256,rebuild_bundle_bytes:$rebuild_bundle_bytes,snapshot_id:(if $snapshot_id=="none" then null else $snapshot_id end),snapshot_time:(if $snapshot_time=="none" then null else $snapshot_time end),snapshot_archive_bytes:$snapshot_archive_bytes,snapshot_metadata_status:$snapshot_metadata_status,secrets_recorded:false,repository:"/mnt/m16-new-storage/admin/backups/restic/m21",m21_outbound_connection:false}' > "$staging/summary.json"
        }
        
        #@MNX-PART id=70.14.m16-backup-m21.function.commit-evidence kind=function title="Function commit_evidence"
        commit_evidence() {
          write_summary || return 1
          ${pkgs.coreutils}/bin/chown -R root:logbook "$staging" || return 1
          ${pkgs.findutils}/bin/find "$staging" -type d -exec ${pkgs.coreutils}/bin/chmod 0750 {} + || return 1
          ${pkgs.findutils}/bin/find "$staging" -type f -exec ${pkgs.coreutils}/bin/chmod 0640 {} + || return 1
          /etc/monsternix/bin/mnx-bundle-manifest create "$staging" 2 >/dev/null || return 1
          /etc/monsternix/bin/mnx-bundle-manifest verify "$staging" >/dev/null || return 1
          ${pkgs.coreutils}/bin/mv -T -- "$staging" "$final" || return 1
          manifest_sha="$(${pkgs.coreutils}/bin/sha256sum "$final/SHA256SUMS" | ${pkgs.gawk}/bin/awk '{print $1}')"
          evidence_committed=1
        }
        
        #@MNX-PART id=70.14.m16-backup-m21.function.publish-state-and-metric kind=function title="Function publish_state_and_metric"
        publish_state_and_metric() {
          local state_tmp metric_tmp now source running default duration value
          now="$(${pkgs.coreutils}/bin/date --iso-8601=seconds)"
          source="$(source_sha || true)"
          running="$(running_system || true)"
          default="$(default_system || true)"
          duration="$(( $(${pkgs.coreutils}/bin/date +%s) - job_start ))"
          state_tmp="$state_file.tmp.$$"
          metric_tmp="$metric_file.tmp.$$"
          ${pkgs.jq}/bin/jq -cnS \
            --arg schema mnx.restic.backup.state.v1 --arg recorded_at "$now" \
            --arg source_sha256 "$source" --arg running_system "$running" --arg default_system "$default" \
            --arg controller_status "$controller_status" --arg product_status "$product_status" \
            --arg phase "$phase" --arg reason "$reason" --arg evidence_bundle "$final" \
            --arg evidence_manifest_sha256 "$manifest_sha" --arg source_receipt_result "$source_receipt_result" \
            --argjson command_rc "$command_rc" --argjson duration_seconds "$duration" \
            --argjson cleanup_snapshot_count "$cleanup_snapshot_count" \
            --argjson cleanup_failure_count "$cleanup_failure_count" \
            --arg rebuild_bundle_status "$rebuild_bundle_status" --arg rebuild_bundle_sha256 "$rebuild_bundle_sha256" \
            --argjson rebuild_bundle_bytes "$rebuild_bundle_bytes" \
            --arg snapshot_id "$snapshot_id" --arg snapshot_time "$snapshot_time" \
            --arg snapshot_metadata_status "$snapshot_metadata_status" --argjson snapshot_archive_bytes "$snapshot_archive_bytes" \
            --argjson network_used "$network_used" \
            '{schema:$schema,recorded_at:$recorded_at,source_sha256:$source_sha256,running_system:$running_system,default_system:$default_system,controller_status:$controller_status,product_status:$product_status,phase:$phase,reason:$reason,command_rc:$command_rc,duration_seconds:$duration_seconds,evidence_bundle:$evidence_bundle,evidence_manifest_sha256:$evidence_manifest_sha256,source_receipt_result:$source_receipt_result,cleanup_snapshot_count:$cleanup_snapshot_count,cleanup_failure_count:$cleanup_failure_count,network_used:$network_used,rebuild_bundle_status:$rebuild_bundle_status,rebuild_bundle_sha256:$rebuild_bundle_sha256,rebuild_bundle_bytes:$rebuild_bundle_bytes,snapshot_id:(if $snapshot_id=="none" then null else $snapshot_id end),snapshot_time:(if $snapshot_time=="none" then null else $snapshot_time end),snapshot_archive_bytes:$snapshot_archive_bytes,snapshot_metadata_status:$snapshot_metadata_status,secrets_recorded:false,repository:"/mnt/m16-new-storage/admin/backups/restic/m21",m21_outbound_connection:false}' > "$state_tmp" || return 1
          ${pkgs.coreutils}/bin/chown root:logbook "$state_tmp" || return 1
          ${pkgs.coreutils}/bin/chmod 0640 "$state_tmp" || return 1
          case "$product_status" in pass) value=0 ;; skipped) value=1 ;; review-required) value=2 ;; *) value=3 ;; esac
          {
            echo '# HELP monsternix_restic_backup_product_status Current m21 Restic backup product state: pass=0 skipped=1 review-required=2 malfunction=3.'
            echo '# TYPE monsternix_restic_backup_product_status gauge'
            printf 'monsternix_restic_backup_product_status %s\n' "$value"
            echo '# HELP monsternix_restic_backup_last_command_rc Last underlying SSH, Restic, lock, or controller status.'
            echo '# TYPE monsternix_restic_backup_last_command_rc gauge'
            printf 'monsternix_restic_backup_last_command_rc %s\n' "$command_rc"
            echo '# HELP monsternix_restic_backup_last_duration_seconds Duration of the latest controlled attempt.'
            echo '# TYPE monsternix_restic_backup_last_duration_seconds gauge'
            printf 'monsternix_restic_backup_last_duration_seconds %s\n' "$duration"
          } > "$metric_tmp" || return 1
          ${pkgs.coreutils}/bin/chown root:root "$metric_tmp" || return 1
          ${pkgs.coreutils}/bin/chmod 0644 "$metric_tmp" || return 1
          ${pkgs.coreutils}/bin/mv -f -- "$metric_tmp" "$metric_file" || return 1
          ${pkgs.coreutils}/bin/mv -f -- "$state_tmp" "$state_file" || return 1
        }
        
        #@MNX-PART id=70.14.m16-backup-m21.function.classify-storage-preflight-failure kind=function title="Function classify_storage_preflight_failure"
        classify_storage_preflight_failure() {
          local rc="$1"
          [[ "$rc" =~ ^[0-9]+$ && "$rc" -ne 0 ]] || return 1
          case "$rc" in
            75) printf '%s %s\n' skipped storage-preflight-refused ;;
            *) printf '%s %s\n' malfunction storage-preflight-failed ;;
          esac
        }

        #@MNX-PART id=70.14.m16-backup-m21.function.finish kind=function title="Function finish"
        finish() {
          local rc="$?" skipped=0 metric_rc skip_marker
          trap - EXIT INT TERM HUP
          set +e
          ${pkgs.coreutils}/bin/rm -f -- "$receipt.tmp"
          cleanup_uncommitted_snapshots
          if [[ "$cleanup_failure_count" -gt 0 && "$product_status" == pass ]]; then
            product_status=review-required
            reason=uncommitted-snapshot-cleanup-incomplete
            command_rc=1
          fi
          if [[ "$product_status" == unknown ]]; then
            product_status=malfunction
            controller_status=malfunction
            reason="controller-failed-''${phase}"
            command_rc="$rc"
          fi
          if [[ "$product_status" == malfunction ]]; then controller_status=malfunction; else controller_status=pass; fi
          if ! commit_evidence; then
            echo 'MNX_RESTIC_BACKUP_CONTROLLER_ERROR: evidence publication failed' >&2
            /etc/monsternix/bin/mnx-job-metric m16-restic-m21 1 "$(( $(${pkgs.coreutils}/bin/date +%s) - job_start ))" 0 evidence-publication-failed || true
            exit 1
          fi
          if ! publish_state_and_metric; then
            echo 'MNX_RESTIC_BACKUP_CONTROLLER_ERROR: current-state publication failed' >&2
            /etc/monsternix/bin/mnx-job-metric m16-restic-m21 1 "$(( $(${pkgs.coreutils}/bin/date +%s) - job_start ))" 0 state-publication-failed || true
            exit 1
          fi
          metric_rc="$command_rc"
          case "$product_status" in
            pass)
              if ! /etc/monsternix/bin/mnx-job-success m16-restic-m21 pull-complete "initiator=m16 endpoint=192.168.100.119 repository=$repository source_snapshot=transient snapshot_id=$snapshot_id snapshot_archive_bytes=$snapshot_archive_bytes m21_outbound=none rebuild_bundle_status=$rebuild_bundle_status evidence=$final"; then
                echo 'MNX_RESTIC_BACKUP_CONTROLLER_ERROR: authoritative success publication failed' >&2
                exit 1
              fi
              /etc/monsternix/bin/mnx-job-metric m16-restic-m21 0 "$(( $(${pkgs.coreutils}/bin/date +%s) - job_start ))" 0 none || true
              printf 'backup_evidence=%s\nMNX_RESTIC_BACKUP=PASS\n' "$final"
              exit 0
              ;;
            skipped)
              skipped=1
              /etc/monsternix/bin/mnx-job-metric m16-restic-m21 0 "$(( $(${pkgs.coreutils}/bin/date +%s) - job_start ))" "$skipped" "$reason" || true
              case "$reason" in
                storage-lock-busy) skip_marker='MNX_RESTIC_BACKUP=SKIPPED_LOCK_BUSY' ;;
                storage-preflight-refused) skip_marker='MNX_RESTIC_BACKUP=SKIPPED_STORAGE_PREFLIGHT' ;;
                m21-source-lock-busy) skip_marker='MNX_RESTIC_BACKUP=SKIPPED_SOURCE_LOCK_BUSY' ;;
                *) skip_marker='MNX_RESTIC_BACKUP=SKIPPED_RETRYABLE' ;;
              esac
              printf 'backup_evidence=%s\nbackup_skip_reason=%s\n%s\n' "$final" "$reason" "$skip_marker"
              exit 75
              ;;
            review-required)
              /etc/monsternix/bin/mnx-job-metric m16-restic-m21 "$metric_rc" "$(( $(${pkgs.coreutils}/bin/date +%s) - job_start ))" 0 "$reason" || true
              echo "backup_notification=deferred-to-one-week-supervision phase=$phase rc=$command_rc reason=$reason evidence=$final" >&2
              printf 'backup_evidence=%s\nMNX_RESTIC_BACKUP_PRODUCT_FAILURE=REVIEW_REQUIRED\n' "$final"
              exit 76
              ;;
            malfunction)
              /etc/monsternix/bin/mnx-job-metric m16-restic-m21 "$metric_rc" "$(( $(${pkgs.coreutils}/bin/date +%s) - job_start ))" 0 "$reason" || true
              printf 'backup_evidence=%s\nMNX_RESTIC_BACKUP_CONTROLLER=FAIL\n' "$final" >&2
              [[ "$rc" -ne 0 ]] || rc=1
              exit "$rc"
              ;;
            *) echo "invalid m16 Restic backup product status: $product_status" >&2; exit 1 ;;
          esac
        }
        
        if [[ "''${1:-}" == --self-test ]]; then
          [[ -z "$credentials_directory" ]]
          [[ "$state_file" == /var/lib/monsternix/job-state/authoritative/m16-restic-m21.current.json ]]
          [[ "$metric_file" == /var/lib/node-exporter-textfile/monsternix_restic_backup.prom ]]
          [[ "$evidence_root" == /var/lib/logbook/backups ]]
          [[ "$product_status" == unknown && "$network_used" == false && "$repository_cleanup_authorized" -eq 0 ]]
          [[ "$(classify_storage_preflight_failure 75)" == 'skipped storage-preflight-refused' ]]
          [[ "$(classify_storage_preflight_failure 74)" == 'malfunction storage-preflight-failed' ]]
          if classify_storage_preflight_failure 0 >/dev/null 2>&1; then
            echo 'zero storage-preflight status was accepted as a failure classification' >&2
            exit 1
          fi
          echo 'MNX_RESTIC_BACKUP_CREDENTIALS_UNSET_SELF_TEST=PASS'
          echo 'MNX_RESTIC_BACKUP_STORAGE_PREFLIGHT_SKIP_SELF_TEST=PASS'
          echo 'MNX_RESTIC_BACKUP_CONTROLLER_SELF_TEST=PASS'
          exit 0
        fi
        
        trap finish EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        trap 'exit 129' HUP
        
        begin_evidence
        phase=credential-preflight
        if [[ -z "$credentials_directory" || "$credentials_directory" != /* || ! -d "$credentials_directory" || -L "$credentials_directory" ]]; then
          controller_status=malfunction
          product_status=malfunction
          reason=credentials-directory-missing-or-unsafe
          command_rc=1
          echo 'm16 Restic backup credential directory is absent, relative, or unsafe' >&2
          exit 1
        fi
        for credential_name in ssh-key known-hosts repository-password; do
          credential_path="$credentials_directory/$credential_name"
          if [[ ! -f "$credential_path" || -L "$credential_path" || ! -r "$credential_path" ]] || ! as_backup ${pkgs.coreutils}/bin/test -r "$credential_path"; then
            controller_status=malfunction
            product_status=malfunction
            reason="credential-$credential_name-missing-or-unsafe"
            command_rc=1
            echo "m16 Restic backup credential is absent, unsafe, or unreadable by m16-backup: $credential_name" >&2
            exit 1
          fi
        done
        ssh_args=(
          -F /dev/null -T -i "$credentials_directory/ssh-key"
          -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes
          -o HostKeyAlgorithms=ssh-ed25519
          -o UserKnownHostsFile="$credentials_directory/known-hosts"
          -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no
          -o ConnectTimeout=15 -o ServerAliveInterval=30 -o ServerAliveCountMax=3
          backup-source@192.168.100.119
        )
        exec 9<>/run/storage-maintenance.lock
        phase=storage-lock
        lock_started="$(${pkgs.coreutils}/bin/date +%s)"
        set +e
        ${pkgs.util-linux}/bin/flock -n -x 9 2>"$staging/storage-lock.log"
        lock_rc="$?"
        set -e
        lock_elapsed="$(( $(${pkgs.coreutils}/bin/date +%s) - lock_started ))"
        printf 'lock_rc=%s\nlock_elapsed_seconds=%s\nlock_policy=single-nonblocking-attempt\n' "$lock_rc" "$lock_elapsed" >> "$staging/storage-lock.log"
        if [[ "$lock_rc" -ne 0 ]]; then
          command_rc="$lock_rc"
          if [[ "$lock_rc" -eq 1 ]]; then
            product_status=skipped
            reason=storage-lock-busy
            exit 75
          fi
          controller_status=malfunction
          product_status=malfunction
          reason=storage-lock-controller-failed
          exit 1
        fi
        
        phase=storage-preflight
        set +e
        /etc/monsternix/bin/mnx-storage-preflight m16-restic-m21 /mnt/m16-new-storage >"$staging/storage-preflight.log" 2>&1
        command_rc="$?"
        set -e
        if [[ "$command_rc" -ne 0 ]]; then
          if ! read -r product_status reason < <(classify_storage_preflight_failure "$command_rc"); then
            controller_status=malfunction
            product_status=malfunction
            reason=storage-preflight-classification-failed
            exit 1
          fi
          if [[ "$product_status" == skipped ]]; then
            exit 75
          fi
          controller_status=malfunction
          exit "$command_rc"
        fi
        
        phase=rebuild-bundle
        network_used=true
        set +e
        stage_rebuild_bundle
        command_rc="$?"
        set -e
        if [[ "$command_rc" -ne 0 ]]; then
          rebuild_bundle_status=preparation-failed
          reason=m21-rebuild-bundle-failed
          product_status=review-required
          if [[ "$command_rc" -eq 75 ]]; then
            reason=m21-source-lock-busy
            product_status=skipped
            exit 75
          fi
          exit 76
        fi

        # A receipt is evidence for exactly one attempt. Invalidate the prior witness
        # immediately before data work so an unreachable source cannot make a later
        # qualification phase accept stale cleanup evidence.
        ${pkgs.coreutils}/bin/rm -f -- "$receipt.tmp" "$receipt"
        phase=pull-stream
        reason=pull-stream
        repository_cleanup_authorized=1
        network_used=true
        set +e
        as_backup ${pkgs.openssh}/bin/ssh "''${ssh_args[@]}" export 2>"$staging/source-export.stderr.log" \
          | as_backup ${pkgs.restic}/bin/restic --repo "$repository" \
              --password-file "$credentials_directory/repository-password" \
              backup --stdin --stdin-filename m21-home.tar \
              --host comfy-m21 --tag m16-pull --tag "$run_tag" --no-scan \
              >"$staging/restic-backup.stdout.log" 2>"$staging/restic-backup.stderr.log"
        pipeline_rc=("''${PIPESTATUS[@]}")
        set -e
        if [[ "''${pipeline_rc[0]}" -ne 0 ]]; then
          command_rc="''${pipeline_rc[0]}"
          reason=source-export-failed
          fetch_source_receipt failure || true
          product_status=review-required
          exit 76
        fi
        if [[ "''${pipeline_rc[1]}" -ne 0 ]]; then
          command_rc="''${pipeline_rc[1]}"
          reason=local-restic-ingest-failed
          fetch_source_receipt success || true
