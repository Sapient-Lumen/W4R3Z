        root="$runtime/monsternix"
        if [[ ! -e $root && ! -L $root ]]; then
          printf '%s/%s\n' "$root" "$PRESSLOG_PROMPT_LOCK_NAME"
          return 0
        fi
        [[ -d $root && ! -L $root ]] || die 'Monsternix secret-prompt runtime directory is unsafe' 74
        meta="$($PRESSLOG_STAT -Lc '%u:%g:%a' "$root" 2>/dev/null || true)"
        [[ $meta == "$uid:$gid:700" ]] || die 'Monsternix secret-prompt runtime directory metadata differs' 74
        printf '%s/%s\n' "$root" "$PRESSLOG_PROMPT_LOCK_NAME"
      }

      #@MNX-PART id=99.88.presslog.function.open-prompt-lock-fd kind=function title="Bash function open_prompt_lock_fd"
      open_prompt_lock_fd() {
        local lock_path=$1 before after_path after_fd uid gid fd_pid=$BASHPID
        uid="$($PRESSLOG_ID -u)"
        gid="$($PRESSLOG_ID -g)"
        [[ -f $lock_path && ! -L $lock_path ]] || die 'Monsternix secret-prompt lock is absent or unsafe' 74
        before="$($PRESSLOG_STAT -Lc '%d:%i:%u:%g:%a:%h' "$lock_path" 2>/dev/null || true)"
        [[ $before == *":$uid:$gid:600:1" ]] || die 'Monsternix secret-prompt lock metadata differs' 74
        # Shared flock observes the existing inode; never ask the sandbox for write access.
        exec 8<"$lock_path" || die 'Monsternix secret-prompt lock read-only open failed' 74
        after_path="$($PRESSLOG_STAT -Lc '%d:%i:%u:%g:%a:%h' "$lock_path" 2>/dev/null || true)"
        after_fd="$($PRESSLOG_STAT -Lc '%d:%i:%u:%g:%a:%h' "/proc/$fd_pid/fd/8" 2>/dev/null || true)"
        [[ $before == "$after_path" && $after_path == "$after_fd" ]] || die 'Monsternix secret-prompt lock identity changed during open' 74
      }

      #@MNX-PART id=99.88.presslog.function.command-prompt-lock-self-test kind=function title="Bash function command_prompt_lock_self_test"
      command_prompt_lock_self_test() {
        (
          local fixture lock before after flags
          fixture="$($PRESSLOG_MKTEMP -d)" || die 'prompt-lock fixture allocation failed' 70
          trap '"$PRESSLOG_RM" -rf -- "$fixture"' EXIT
          lock="$fixture/lock"
          printf '%s' "" > "$lock"
          "$PRESSLOG_CHMOD" 0600 "$lock"
          before="$($PRESSLOG_STAT -Lc '%d:%i:%u:%g:%a:%h:%s:%Y' "$lock")"
          open_prompt_lock_fd "$lock"
          flags="$($PRESSLOG_AWK '$1 == "flags:" { print $2 }' /proc/self/fdinfo/8)"
          [[ $flags =~ ^[0-7]+$ ]] || die 'prompt-lock descriptor flags missing' 70
          (( (8#$flags & 3) == 0 )) || die 'prompt-lock observer descriptor is not read-only' 70
          "$PRESSLOG_FLOCK" -n -s 8 || die 'uncontended read-only prompt lock was rejected' 70
          exec 7<>"$lock"
          if "$PRESSLOG_FLOCK" -n -x 7; then die 'shared observer failed to exclude a secret prompt' 70; fi
          exec 8<&-
          "$PRESSLOG_FLOCK" -n -x 7 || die 'exclusive prompt fixture could not acquire its lock' 70
          open_prompt_lock_fd "$lock"
          if "$PRESSLOG_FLOCK" -n -s 8; then die 'read-only observer failed to detect an active secret prompt' 70; fi
          exec 7>&-
          "$PRESSLOG_FLOCK" -n -s 8 || die 'closed prompt still blocked the read-only observer' 70
          exec 8<&-
          after="$($PRESSLOG_STAT -Lc '%d:%i:%u:%g:%a:%h:%s:%Y' "$lock")"
          [[ $before == "$after" ]] || die 'prompt-lock fixture metadata was mutated' 70
          "$PRESSLOG_LN" -s "$lock" "$fixture/link"
          if ( open_prompt_lock_fd "$fixture/link" ) >/dev/null 2>&1; then die 'prompt-lock symlink was accepted' 70; fi
          "$PRESSLOG_LN" "$lock" "$fixture/hardlink"
          if ( open_prompt_lock_fd "$lock" ) >/dev/null 2>&1; then die 'prompt-lock hardlink was accepted' 70; fi
          "$PRESSLOG_RM" "$fixture/hardlink"
          "$PRESSLOG_CHMOD" 0644 "$lock"
          if ( open_prompt_lock_fd "$lock" ) >/dev/null 2>&1; then die 'prompt-lock unsafe mode was accepted' 70; fi
          printf 'PRESSLOG_SECRET_PROMPT_READ_ONLY_FD_SELF_TEST=PASS\n'
          printf 'PRESSLOG_SECRET_PROMPT_LOCK_EXCLUSION_SELF_TEST=PASS\n'
        )
      }

      #@MNX-PART id=99.88.presslog.function.require-prompt-resume-allowed kind=function title="Bash function require_prompt_resume_allowed"
      require_prompt_resume_allowed() {
        local lock_path
        lock_path="$(prompt_lock_path)"
        if [[ ! -e $lock_path && ! -L $lock_path ]]; then return 0; fi
        open_prompt_lock_fd "$lock_path"
        "$PRESSLOG_FLOCK" -n -s 8 || die 'resume refused while a Monsternix secret prompt is active; recorder remains paused until an explicit later resume' 75
        printf 'presslog_secret_prompt_resume_gate=clear\n'
      }

      #@MNX-PART id=99.88.presslog.function.require-prompt-guard-lease kind=function title="Bash function require_prompt_guard_lease"
      require_prompt_guard_lease() {
        local lock_path
        lock_path="$(prompt_lock_path)"
        open_prompt_lock_fd "$lock_path"
        if "$PRESSLOG_FLOCK" -n -s 8; then
          die 'prompt-guard requires the caller to hold the exclusive Monsternix secret-prompt lease' 75
        fi
        printf 'presslog_secret_prompt_lease=exclusive-active\n'
      }

      #@MNX-PART id=99.88.presslog.function.user-systemctl kind=function title="Bash function user_systemctl"
      user_systemctl() {
        "$PRESSLOG_SYSTEMCTL" --user "$@"
      }

      #@MNX-PART id=99.88.presslog.function.import-session-environment kind=function title="Bash function import_session_environment"
      import_session_environment() {
        local -a names=()
        local name
        [[ -n ''${XDG_RUNTIME_DIR:-} ]] || export XDG_RUNTIME_DIR=/run/user/1000
        [[ -n ''${DBUS_SESSION_BUS_ADDRESS:-} ]] || export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
        [[ -n ''${DISPLAY:-} ]] || export DISPLAY=:0
        if [[ -z ''${XAUTHORITY:-} && -f /home/h0p3/.Xauthority && ! -L /home/h0p3/.Xauthority ]]; then
          export XAUTHORITY=/home/h0p3/.Xauthority
        fi
        for name in DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR WAYLAND_DISPLAY; do
          [[ -n ''${!name:-} ]] && names+=("$name")
        done
        if (( ''${#names[@]} > 0 )); then
          user_systemctl import-environment "''${names[@]}"
        fi
        printf 'presslog_session_environment_names=%s\n' "$(IFS=,; printf '%s' "''${names[*]}")"
      }

      #@MNX-PART id=99.88.presslog.function.unit-property kind=function title="Bash function unit_property"
      unit_property() {
        user_systemctl show "$1" -p "$2" --value 2>/dev/null || true
      }

      #@MNX-PART id=99.88.presslog.function.bounded-unit-journal kind=function title="Bash function bounded_unit_journal"
      bounded_unit_journal() {
        local unit=$1 invocation
        invocation="$(unit_property "$unit" InvocationID)"
        if [[ $invocation =~ ^[0-9a-f]{32}$ ]]; then
          "$PRESSLOG_JOURNALCTL" --user -b -u "$unit" "_SYSTEMD_INVOCATION_ID=$invocation" --no-pager -o cat -n 120 2>/dev/null || true
        else
          "$PRESSLOG_JOURNALCTL" --user -b -u "$unit" --no-pager -o cat -n 120 2>/dev/null || true
        fi
      }

      #@MNX-PART id=99.88.presslog.function.classify-unit-failure kind=function title="Bash function classify_unit_failure"
      classify_unit_failure() {
        local unit=$1 status journal
        status="$(unit_property "$unit" ExecMainStatus)"
        journal="$(bounded_unit_journal "$unit")"
        case "$journal" in
          *'rofi cancelled or failed'*) printf 'legacy-rofi-prompt-failed\n' ;;
          *'presslog-pinentry: password prompt was cancelled or refused'*|*'password prompt was cancelled or refused'*) printf 'password-prompt-cancelled\n' ;;
          *'presslog-pinentry: passwords differ'*|*'passwords differ'*) printf 'password-confirmation-mismatch\n' ;;
          *'presslog-pinentry: graphical pinentry program is not executable'*|*'presslog-pinentry: internal prompt failure'*) printf 'pinentry-unavailable\n' ;;
          *'secret output must be an anonymous pipe'*) printf 'password-transport-refused\n' ;;
          *'eof on password read'*) printf 'password-prompt-produced-no-secret\n' ;;
          *'password incorrect'*) printf 'incorrect-password\n' ;;
          *'no keyboard evdev devices found'*|*'permission denied opening /dev/input/'*) printf 'keyboard-access\n' ;;
          *'could not connect to display'*|*'cannot open display'*|*'QXcbConnection'*|*'qt.qpa.xcb'*) printf 'graphical-session-environment\n' ;;
          *'state metadata differs'*|*'unsafe state directory'*|*'keystore is not a regular nonsymlink file'*) printf 'state-metadata\n' ;;
          *'another process holds this state'*) printf 'state-lock\n' ;;
          *'journal present but keystore missing'*|*'keystore present but static salt is missing'*) printf 'private-state-recovery-required\n' ;;
          *)
            case "$status" in
              65) printf 'authentication-or-data-error\n' ;;
              66) printf 'keyboard-or-input-unavailable\n' ;;
              74) printf 'state-or-io-error\n' ;;
              75) printf 'state-lock\n' ;;
              *) printf 'unclassified\n' ;;
            esac
            ;;
        esac
      }

      #@MNX-PART id=99.88.presslog.function.print-unit-failure-summary kind=function title="Bash function print_unit_failure_summary"
      print_unit_failure_summary() {
        local unit=$1 class invocation scope
        class="$(classify_unit_failure "$unit")"
        invocation="$(unit_property "$unit" InvocationID)"
        if [[ $invocation =~ ^[0-9a-f]{32}$ ]]; then scope=exact-invocation; else scope=current-boot-fallback; fi
        printf 'presslog_failure_unit=%s\n' "$unit"
        printf 'presslog_failure_invocation_id=%s\n' "''${invocation:-unavailable}"
        printf 'presslog_failure_journal_scope=%s\n' "$scope"
        printf 'presslog_failure_load_state=%s\n' "$(unit_property "$unit" LoadState)"
        printf 'presslog_failure_active_state=%s\n' "$(unit_property "$unit" ActiveState)"
        printf 'presslog_failure_sub_state=%s\n' "$(unit_property "$unit" SubState)"
        printf 'presslog_failure_result=%s\n' "$(unit_property "$unit" Result)"
        printf 'presslog_failure_exec_code=%s\n' "$(unit_property "$unit" ExecMainCode)"
        printf 'presslog_failure_exec_status=%s\n' "$(unit_property "$unit" ExecMainStatus)"
        printf 'presslog_failure_class=%s\n' "$class"
        case "$class" in
          legacy-rofi-prompt-failed) echo 'presslog_failure_hint=the-accepted-stage68-rofi-prompt-failed-this-stage-replaces-it-with-pinentry-qt' ;;
          password-prompt-cancelled) echo 'presslog_failure_hint=the-pinentry-dialog-was-cancelled-or-refused-before-capture' ;;
          password-confirmation-mismatch) echo 'presslog_failure_hint=the-two-new-password-entries-differed-no-vault-was-created' ;;
          pinentry-unavailable) echo 'presslog_failure_hint=the-source-owned-pinentry-program-could-not-run-in-the-graphical-session' ;;
          password-transport-refused) echo 'presslog_failure_hint=the-secret-transport-was-not-the-required-anonymous-pipe' ;;
          password-prompt-produced-no-secret) echo 'presslog_failure_hint=the-prompt-adapter-ended-before-supplying-a-password-line' ;;
          incorrect-password) echo 'presslog_failure_hint=the-entered-presslog-password-did-not-unlock-the-existing-keystore' ;;
          keyboard-access|keyboard-or-input-unavailable) echo 'presslog_failure_hint=no-readable-keyboard-evdev-device-reached-the-core' ;;
          graphical-session-environment) echo 'presslog_failure_hint=pinentry-could-not-reach-the-current-graphical-session' ;;
          state-metadata|state-or-io-error) echo 'presslog_failure_hint=the-private-state-tree-has-unsafe-or-unreadable-metadata' ;;
          state-lock) echo 'presslog_failure_hint=another-recorder-or-inspector-holds-the-state-lock' ;;
          private-state-recovery-required) echo 'presslog_failure_hint=ciphertext-or-keystore-state-requires-recovery-review-before-a-new-vault' ;;
          authentication-or-data-error) echo 'presslog_failure_hint=the-core-returned-a-bounded-authentication-or-data-error' ;;
          *) echo 'presslog_failure_hint=bounded-classification-did-not-identify-the-cause' ;;
        esac
        echo 'presslog_failure_journal_lines_examined_max=120'
        echo 'presslog_failure_journal_payload_printed=false'
        echo 'presslog_failure_secret_printed=false'
      }

      #@MNX-PART id=99.88.presslog.function.unit-active kind=function title="Bash function unit_active"
      unit_active() {
        user_systemctl is-active --quiet "$1"
      }

      #@MNX-PART id=99.88.presslog.function.unit-failed kind=function title="Bash function unit_failed"
      unit_failed() {
        user_systemctl is-failed --quiet "$1"
      }

      #@MNX-PART id=99.88.presslog.function.wait-for-recording kind=function title="Bash function wait_for_recording"
      wait_for_recording() {
        local unit=$1 expected_burn=$2 elapsed=0 status=$PRESSLOG_STATE_ROOT/run/status.json main_pid
        while (( elapsed < 180 )); do
          if unit_failed "$unit"; then
            print_unit_failure_summary "$unit"
            return 1
          fi
          main_pid="$(unit_property "$unit" MainPID)"
          if [[ $main_pid =~ ^[1-9][0-9]*$ && -f $status && ! -L $status && "$($PRESSLOG_STAT -Lc '%u:%g:%a' "$status" 2>/dev/null || true)" == "$PRESSLOG_EXPECTED_UID:$($PRESSLOG_ID -g):600" ]]; then
            if "$PRESSLOG_JQ" -e --arg burn "$expected_burn" --arg pid "$main_pid" \
              '.pid == $pid and (.segment | type == "string" and length > 0) and .burn == $burn and .auto_expire == "false" and .paused == "true"' \
              "$status" >/dev/null 2>&1; then
              printf 'recording_confirmed=true\nrecording_unit=%s\nrecorder_started_paused=true\nmanual_resume_required=true\nauto_expire=false\n' "$unit"
              return 0
            fi
          fi
          if ! unit_active "$unit"; then
            print_unit_failure_summary "$unit"
            return 1
          fi
          "$PRESSLOG_SLEEP" 1
          elapsed=$((elapsed + 1))
        done
        stop_unit_verified "$unit" || true
        echo 'presslog_failure_class=recording-status-timeout'
        echo 'presslog_failure_hint=the-recorder-did-not-publish-a-valid-paused-active-segment-within-180-seconds'
        echo 'presslog_failure_journal_payload_printed=false'
        return 75
      }

      #@MNX-PART id=99.88.presslog.function.classify-armed-marker-path kind=function title="Bash function classify_armed_marker_path"
      classify_armed_marker_path() {
        local path=$1 expected_uid=$2 expected_gid=$3 expected_state=$4
        local before after_path after_fd last_byte nul_count state=unsafe
        local uid gid mode links size
        local -a lines=()
        if [[ ! -e $path && ! -L $path ]]; then
          printf 'absent\n'
          return 0
        fi
        if [[ ! -f $path || -L $path ]]; then
          printf 'unsafe\n'
          return 0
        fi
        before="$($PRESSLOG_STAT -Lc '%d:%i:%u:%g:%a:%h:%s' "$path" 2>/dev/null || true)"
        IFS=: read -r _ _ uid gid mode links size <<<"$before"
        if [[ ! $uid =~ ^[0-9]+$ || ! $gid =~ ^[0-9]+$ || ! $mode =~ ^[0-7]+$ || ! $links =~ ^[0-9]+$ || ! $size =~ ^[0-9]+$ ]]; then
          printf 'unsafe\n'
          return 0
        fi
        if [[ $uid != "$expected_uid" || $gid != "$expected_gid" || $mode != 600 || $links != 1 ]] || (( size < 1 || size > 1024 )); then
          printf 'unsafe\n'
          return 0
        fi
        if ! exec 7<"$path"; then
          printf 'unsafe\n'
          return 0
        fi
        after_path="$($PRESSLOG_STAT -Lc '%d:%i:%u:%g:%a:%h:%s' "$path" 2>/dev/null || true)"
        after_fd="$($PRESSLOG_STAT -Lc '%d:%i:%u:%g:%a:%h:%s' /proc/self/fd/7 2>/dev/null || true)"
        if [[ $before == "$after_path" && $after_path == "$after_fd" ]]; then
          mapfile -t lines <&7 || lines=()
          after_path="$($PRESSLOG_STAT -Lc '%d:%i:%u:%g:%a:%h:%s' "$path" 2>/dev/null || true)"
          after_fd="$($PRESSLOG_STAT -Lc '%d:%i:%u:%g:%a:%h:%s' /proc/self/fd/7 2>/dev/null || true)"
          last_byte="$($PRESSLOG_OD -An -v -t u1 -j "$((size - 1))" -N 1 /proc/self/fd/7 2>/dev/null | $PRESSLOG_AWK '{print $1}')"
          nul_count="$($PRESSLOG_OD -An -v -t u1 /proc/self/fd/7 2>/dev/null | $PRESSLOG_AWK '{for (i=1; i<=NF; i++) if ($i == 0) count++} END {print count + 0}')"
          if [[ $before == "$after_path" && $after_path == "$after_fd" ]] &&
             [[ $last_byte == 10 && $nul_count == 0 && ''${#lines[@]} == 5 ]] &&
             [[ ''${lines[0]} == 'schema=mnx.presslog.arm.v1' ]] &&
             [[ ''${lines[1]} == "state=$expected_state" ]] &&
             [[ ''${lines[2]} =~ ^armed_at=[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] &&
             [[ ''${lines[3]} == 'auto_expire=no' && ''${lines[4]} == 'network=no' ]]; then
            state=safe
          fi
        fi
        exec 7<&-
        printf '%s\n' "$state"
      }

      #@MNX-PART id=99.88.presslog.function.armed-marker-state kind=function title="Bash function armed_marker_state"
      armed_marker_state() {
        classify_armed_marker_path "$PRESSLOG_ARMED_MARKER" "$PRESSLOG_EXPECTED_UID" "$($PRESSLOG_ID -g)" "$PRESSLOG_STATE_ROOT"
      }

      #@MNX-PART id=99.88.presslog.function.write-armed-marker kind=function title="Bash function write_armed_marker"
      write_armed_marker() {
        local tmp
        [[ "$(armed_marker_state)" == absent ]] || die 'refusing to replace an existing or unsafe Presslog armed marker' 74
        tmp="$PRESSLOG_CONTROL_ROOT/.armed.$$"
        {
          printf 'schema=mnx.presslog.arm.v1\n'
          printf 'state=%s\n' "$PRESSLOG_STATE_ROOT"
          printf 'armed_at=%s\n' "$($PRESSLOG_DATE -u +%Y-%m-%dT%H:%M:%SZ)"
          printf 'auto_expire=no\n'
          printf 'network=no\n'
        } > "$tmp"
        "$PRESSLOG_CHMOD" 0600 "$tmp"
        "$PRESSLOG_SYNC" -f "$tmp"
        "$PRESSLOG_MV" -f -- "$tmp" "$PRESSLOG_ARMED_MARKER"
        "$PRESSLOG_SYNC" -f "$PRESSLOG_ARMED_MARKER"
      }

      #@MNX-PART id=99.88.presslog.function.unit-main-pid kind=function title="Bash function unit_main_pid"
      unit_main_pid() {
        user_systemctl show "$1" -p MainPID --value 2>/dev/null || printf 'unknown\n'
      }

      #@MNX-PART id=99.88.presslog.function.wait-for-stopped kind=function title="Bash function wait_for_stopped"
      wait_for_stopped() {
        local unit=$1 elapsed=0 active pid
        while (( elapsed < 60 )); do
          active="$(user_systemctl is-active "$unit" 2>/dev/null || true)"
          pid="$(unit_main_pid "$unit")"
          if [[ $active == inactive || $active == failed || $active == unknown ]] && [[ $pid == 0 || $pid == unknown || -z $pid ]]; then
            printf 'stopped_unit=%s\nstopped_state=%s\n' "$unit" "''${active:-unknown}"
            return 0
          fi
          "$PRESSLOG_SLEEP" 1
          elapsed=$((elapsed + 1))
        done
        die "$unit still has active state or a live main process after the bounded stop window" 75
      }

      #@MNX-PART id=99.88.presslog.function.stop-unit-verified kind=function title="Bash function stop_unit_verified"
      stop_unit_verified() {
        local unit=$1 stop_rc=0
        user_systemctl stop "$unit" >/dev/null 2>&1 || stop_rc=$?
        if ! wait_for_stopped "$unit"; then
          return 75
        fi
        if (( stop_rc != 0 )); then
          printf 'presslog: %s stop command returned %s but the unit is proved stopped\n' "$unit" "$stop_rc" >&2
        fi
      }

      #@MNX-PART id=99.88.presslog.function.stop-units kind=function title="Bash function stop_units"
      stop_units() {
        local rc=0
        stop_unit_verified "$PRESSLOG_NORMAL_UNIT" || rc=$?
        stop_unit_verified "$PRESSLOG_BURN_UNIT" || rc=$?
        (( rc == 0 )) || die 'one or more recorder units could not be proved stopped' "$rc"
      }

      #@MNX-PART id=99.88.presslog.function.start-normal kind=function title="Bash function start_normal"
      start_normal() {
        local rc=0 marker_state marker_origin
        marker_state="$(armed_marker_state)"
        case "$marker_state" in
          safe) marker_origin=preexisting ;;
          absent) marker_origin=created-for-this-arm ;;
          *) printf 'presslog: existing armed marker is unsafe; recorder start refused without mutation\n' >&2; return 74 ;;
        esac
        stop_units
        import_session_environment
        if [[ $marker_origin == created-for-this-arm ]]; then write_armed_marker; fi
        user_systemctl daemon-reload
        user_systemctl reset-failed "$PRESSLOG_NORMAL_UNIT" >/dev/null 2>&1 || true
        user_systemctl start "$PRESSLOG_NORMAL_UNIT" || rc=$?
        if (( rc != 0 )); then print_unit_failure_summary "$PRESSLOG_NORMAL_UNIT"; fi
        if (( rc == 0 )); then
          ( wait_for_recording "$PRESSLOG_NORMAL_UNIT" false ) || rc=$?
        fi
        if (( rc != 0 )); then
          stop_unit_verified "$PRESSLOG_NORMAL_UNIT" || true
          user_systemctl reset-failed "$PRESSLOG_NORMAL_UNIT" >/dev/null 2>&1 || true
          if [[ $marker_origin == created-for-this-arm ]]; then
            "$PRESSLOG_RM" -f -- "$PRESSLOG_ARMED_MARKER"
            "$PRESSLOG_SYNC" -f "$PRESSLOG_CONTROL_ROOT" 2>/dev/null || true
            printf 'presslog: Presslog arm did not reach a confirmed paused encrypted recorder; persistent auto-start was removed\n' >&2
          else
            marker_state="$(armed_marker_state)"
            case "$marker_state" in
              safe)
                printf 'presslog: Presslog reauthentication did not reach a confirmed paused encrypted recorder; existing persistent auto-start was retained\n' >&2
                ;;
              absent)
                printf 'presslog: Presslog reauthentication did not reach a confirmed paused encrypted recorder; a concurrent explicit disarm remains authoritative\n' >&2
                ;;
              *)
                printf 'presslog: Presslog start failed and the preexisting armed marker became unsafe\n' >&2
                return 74
                ;;
            esac
          fi
          return "$rc"
        fi
        printf 'arm_marker_origin=%s\nmanual_resume_required=true\nPRESSLOG_ARM=PASS\n' "$marker_origin"
      }

      #@MNX-PART id=99.88.presslog.function.start-burn kind=function title="Bash function start_burn"
      start_burn() {
        local rc=0
        stop_units
        import_session_environment
        user_systemctl reset-failed "$PRESSLOG_BURN_UNIT" >/dev/null 2>&1 || true
        user_systemctl start "$PRESSLOG_BURN_UNIT" || rc=$?
        if (( rc != 0 )); then print_unit_failure_summary "$PRESSLOG_BURN_UNIT"; fi
        if (( rc == 0 )); then wait_for_recording "$PRESSLOG_BURN_UNIT" true || rc=$?; fi
        if (( rc != 0 )); then
          stop_unit_verified "$PRESSLOG_BURN_UNIT" || true
          user_systemctl reset-failed "$PRESSLOG_BURN_UNIT" >/dev/null 2>&1 || true
          die 'Presslog burn did not reach a confirmed paused encrypted recorder' "$rc"
        fi
        printf 'manual_resume_required=true\nPRESSLOG_BURN_START=PASS\n'
      }

      #@MNX-PART id=99.88.presslog.function.restart-normal-if-needed kind=function title="Bash function restart_normal_if_needed"
      restart_normal_if_needed() {
        local active_before=$1 rc=0
        if [[ $active_before == yes ]]; then
          import_session_environment
          user_systemctl reset-failed "$PRESSLOG_NORMAL_UNIT" >/dev/null 2>&1 || true
          user_systemctl start "$PRESSLOG_NORMAL_UNIT" || rc=$?
          if (( rc != 0 )); then
            print_unit_failure_summary "$PRESSLOG_NORMAL_UNIT"
          else
            wait_for_recording "$PRESSLOG_NORMAL_UNIT" false || rc=$?
          fi
          if (( rc != 0 )); then
            stop_unit_verified "$PRESSLOG_NORMAL_UNIT" || true
            user_systemctl reset-failed "$PRESSLOG_NORMAL_UNIT" >/dev/null 2>&1 || true
            return "$rc"
          fi
          printf 'recorder_restarted_paused=true\nmanual_resume_required=true\n'
        fi
      }

      #@MNX-PART id=99.88.presslog.function.require-no-burn-session kind=function title="Bash function require_no_burn_session"
      require_no_burn_session() {
        unit_active "$PRESSLOG_BURN_UNIT" && die 'a burn session is active; stop it explicitly before inspecting durable history' 75
        return 0
      }

      #@MNX-PART id=99.88.presslog.function.has-journal-material kind=function title="Bash function has_journal_material"
      has_journal_material() {
        local found
        found="$($PRESSLOG_FIND "$PRESSLOG_STATE_ROOT/journal" "$PRESSLOG_STATE_ROOT/manifests" -maxdepth 1 -type f \( -name '*.plog' -o -name '*.sha256' \) -print -quit 2>/dev/null || true)"
        [[ -n $found ]]
      }

      #@MNX-PART id=99.88.presslog.function.wrap-file-from-args kind=function title="Bash function wrap_file_from_args"
      wrap_file_from_args() {
        local previous= arg
        for arg in "$@"; do
          if [[ $previous == --wrap-file ]]; then
            printf '%s\n' "$arg"
            return 0
          fi
          previous=$arg
        done
        return 1
      }

      #@MNX-PART id=99.88.presslog.function.require-private-unlock-state kind=function title="Bash function require_private_unlock_state"
      require_private_unlock_state() {
        local allow_wrapped=''${1:-no} keystore=$PRESSLOG_STATE_ROOT/private/keystore salt=$PRESSLOG_STATE_ROOT/private/salt
        [[ -f $salt && ! -L $salt ]] || die 'Presslog salt is missing or unsafe; restore private state before decrypting history' 74
        if [[ $allow_wrapped == yes ]]; then return 0; fi
        [[ -f $keystore && ! -L $keystore ]] || die 'Presslog keystore is missing or unsafe; restore private state before decrypting history' 74
      }

      #@MNX-PART id=99.88.presslog.function.presslog-prompt-mode kind=function title="Bash function presslog_prompt_mode"
      presslog_prompt_mode() {
        local wrap= keystore=$PRESSLOG_STATE_ROOT/private/keystore
        wrap="$(wrap_file_from_args "$@" 2>/dev/null || true)"
        if [[ -n $wrap ]]; then
          [[ $wrap == /* ]] || die '--wrap-file must be an absolute path under Monsternix control' 64
          if [[ -e $wrap || -L $wrap ]]; then
            [[ -f $wrap && ! -L $wrap ]] || die 'thumbdrive wrap path is not a regular nonsymlink file' 74
            require_private_unlock_state yes
            printf '%s\n' --thumbdrive-existing-presslog-existing
          elif [[ -f $keystore && ! -L $keystore ]]; then
            require_private_unlock_state no
            printf '%s\n' --presslog-existing-thumbdrive-create
          else
            has_journal_material && die 'journal exists without a usable keystore; restore private state before creating a thumbdrive wrap' 74
            printf '%s\n' --presslog-create-thumbdrive-create
          fi
          return 0
        fi
        require_private_unlock_state no
        printf '%s\n' --presslog-existing
      }

      #@MNX-PART id=99.88.presslog.function.run-core-with-prompt-state kind=function title="Bash function run_core_with_prompt_state"
      run_core_with_prompt_state() {
        local state=$1 prompt_mode=$2
        shift 2
        [[ $state == /* && -d $state && ! -L $state ]] || die 'alternate Presslog state is absent or unsafe' 74
        import_session_environment
        [[ -x $PRESSLOG_PINENTRY && -f $PRESSLOG_PINENTRY && ! -L $PRESSLOG_PINENTRY ]] || die 'source-owned Presslog pinentry adapter is unavailable or unsafe' 70
        "$PRESSLOG_CORE" --state "$state" --asker tty "$@" < <("$PRESSLOG_PINENTRY" "$prompt_mode")
      }

      #@MNX-PART id=99.88.presslog.function.run-core-with-prompt kind=function title="Bash function run_core_with_prompt"
      run_core_with_prompt() {
        local prompt_mode=$1
        shift
        run_core_with_prompt_state "$PRESSLOG_STATE_ROOT" "$prompt_mode" "$@"
      }

      #@MNX-PART id=99.88.presslog.function.run-presslog-authenticated-core kind=function title="Bash function run_presslog_authenticated_core"
      run_presslog_authenticated_core() {
        local prompt_mode
        prompt_mode="$(presslog_prompt_mode "$@")"
        run_core_with_prompt "$prompt_mode" "$@"
      }

      #@MNX-PART id=99.88.presslog.function.run-stopped-core kind=function title="Bash function run_stopped_core"
      run_stopped_core() {
        local preverify=$1 prompt_kind=$2
        shift 2
        local active_before=no rc=0 restart_rc=0
        require_no_burn_session
        if unit_active "$PRESSLOG_NORMAL_UNIT"; then active_before=yes; fi
        if [[ $active_before == yes ]]; then stop_unit_verified "$PRESSLOG_NORMAL_UNIT"; fi
        if [[ $preverify == shallow ]]; then
          "$PRESSLOG_CORE" --state "$PRESSLOG_STATE_ROOT" verify || rc=$?
        elif [[ $preverify == deep ]]; then
          if has_journal_material; then run_presslog_authenticated_core verify --deep || rc=$?; else "$PRESSLOG_CORE" --state "$PRESSLOG_STATE_ROOT" verify --deep || rc=$?; fi
        fi
        if (( rc == 0 )); then
          case "$prompt_kind" in
            none) "$PRESSLOG_CORE" --state "$PRESSLOG_STATE_ROOT" "$@" || rc=$? ;;
            presslog)
              if has_journal_material; then run_presslog_authenticated_core "$@" || rc=$?; else "$PRESSLOG_CORE" --state "$PRESSLOG_STATE_ROOT" "$@" || rc=$?; fi
              ;;
            archive-create) run_core_with_prompt --archive-create "$@" || rc=$? ;;
            *) die "unknown stopped-core prompt kind: $prompt_kind" 70 ;;
          esac
        fi
        if [[ $active_before == yes ]]; then restart_normal_if_needed yes || restart_rc=$?; fi
        if (( rc != 0 )); then return "$rc"; fi
        return "$restart_rc"
      }

      #@MNX-PART id=99.88.presslog.function.require-destructive-token kind=function title="Bash function require_destructive_token"
      require_destructive_token() {
        [[ ''${PRESSLOG_DESTRUCTIVE_AUTH:-} == "$PRESSLOG_DESTRUCTIVE_TOKEN" ]] ||
          die "destructive operation refused; set PRESSLOG_DESTRUCTIVE_AUTH to the exact token printed by 'presslog policy'" 77
      }

      #@MNX-PART id=99.88.presslog.function.require-import-token kind=function title="Bash function require_import_token"
      require_import_token() {
        [[ ''${PRESSLOG_IMPORT_AUTH:-} == "$PRESSLOG_IMPORT_TOKEN" ]] ||
          die "archive import refused; set PRESSLOG_IMPORT_AUTH to the exact token printed by 'presslog policy'" 77
      }

      #@MNX-PART id=99.88.presslog.function.command-import kind=function title="Bash function command_import"
      command_import() {
        local active_before=no stamp backup failed rc=0 restart_rc=0
        require_no_burn_session
        require_import_token
        [[ ''${PRESSLOG_IMPORT_CONFIRM:-} == yes ]] || die 'archive import additionally requires PRESSLOG_IMPORT_CONFIRM=yes' 77
        if unit_active "$PRESSLOG_NORMAL_UNIT"; then active_before=yes; stop_unit_verified "$PRESSLOG_NORMAL_UNIT"; fi
        stamp="$($PRESSLOG_DATE -u +%Y%m%dT%H%M%SZ)"
        backup="$PRESSLOG_RECOVERY_ROOT/private-before-import-$stamp"
        failed="$PRESSLOG_RECOVERY_ROOT/private-failed-import-$stamp"
        if [[ -d $PRESSLOG_STATE_ROOT/private && ! -L $PRESSLOG_STATE_ROOT/private ]]; then
          "$PRESSLOG_CP" -a --reflink=auto -- "$PRESSLOG_STATE_ROOT/private" "$backup"
          "$PRESSLOG_CHMOD" -R go-rwx "$backup"
          "$PRESSLOG_SYNC" -f "$backup"
        fi
        run_core_with_prompt --archive-existing archive-import "$@" || rc=$?
        if (( rc == 0 )); then
          if has_journal_material; then run_presslog_authenticated_core verify --deep || rc=$?; else "$PRESSLOG_CORE" --state "$PRESSLOG_STATE_ROOT" verify --deep || rc=$?; fi
        fi
        if (( rc != 0 )) && [[ -d $backup ]]; then
          local restore="$PRESSLOG_RECOVERY_ROOT/private-restore-$stamp"
          [[ ! -e $failed && ! -L $failed && ! -e $restore && ! -L $restore ]] || die 'failed-import recovery path already exists' 74
          "$PRESSLOG_CP" -a --reflink=auto -- "$backup" "$restore"
          "$PRESSLOG_CHMOD" -R go-rwx "$restore"
          if [[ -e $PRESSLOG_STATE_ROOT/private || -L $PRESSLOG_STATE_ROOT/private ]]; then "$PRESSLOG_MV" -- "$PRESSLOG_STATE_ROOT/private" "$failed"; fi
          "$PRESSLOG_MV" -- "$restore" "$PRESSLOG_STATE_ROOT/private"
          "$PRESSLOG_SYNC" -f "$PRESSLOG_STATE_ROOT/private"
          printf 'presslog: archive import failed verification; prior private state restored atomically, failed import preserved at %s\n' "$failed" >&2
        fi
        if [[ $active_before == yes ]]; then restart_normal_if_needed yes || restart_rc=$?; fi
        if (( rc != 0 )); then return "$rc"; fi
        return "$restart_rc"
      }

      #@MNX-PART id=99.88.presslog.function.command-pause-resume kind=function title="Bash function command_pause_resume"
      command_pause_resume() {
        local command=$1 bound_unit="" bound_pid="" unit= expected= marker= signal= elapsed=0 status=$PRESSLOG_STATE_ROOT/run/status.json main_pid current_pid
        if (( $# >= 2 )); then bound_unit=$2; fi
        if (( $# >= 3 )); then bound_pid=$3; fi
        if unit_failed "$PRESSLOG_NORMAL_UNIT"; then print_unit_failure_summary "$PRESSLOG_NORMAL_UNIT"; return 1; fi
        if unit_failed "$PRESSLOG_BURN_UNIT"; then print_unit_failure_summary "$PRESSLOG_BURN_UNIT"; return 1; fi
        if unit_active "$PRESSLOG_NORMAL_UNIT"; then unit=$PRESSLOG_NORMAL_UNIT; fi
        if unit_active "$PRESSLOG_BURN_UNIT"; then
          [[ -z $unit ]] || die 'both normal and burn recorders are active; control transition refused' 70
          unit=$PRESSLOG_BURN_UNIT
        fi
        [[ -n $unit ]] || die "$command refused because no Presslog recorder is active" 69
        [[ -z $bound_unit || $bound_unit == "$unit" ]] || die "$command recorder unit changed during control derivation" 74
        main_pid="$(unit_property "$unit" MainPID)"
        [[ $main_pid =~ ^[1-9][0-9]*$ ]] || die "$command could not bind the active recorder MainPID" 74
        [[ -z $bound_pid || $bound_pid == "$main_pid" ]] || die "$command recorder PID changed during control derivation" 74
        case "$command" in
          pause) expected=true; marker=PRESSLOG_PAUSE; signal=USR1 ;;
          resume) expected=false; marker=PRESSLOG_RESUME; signal=USR2 ;;
          *) die "unsupported recorder transition: $command" 70 ;;
        esac
        user_systemctl kill --kill-whom=main --signal="$signal" "$unit" ||
          die "$command signal delivery through the user manager failed" 74
        while (( elapsed < 100 )); do
          if unit_failed "$unit"; then print_unit_failure_summary "$unit"; return 1; fi
          unit_active "$unit" || die "$command signal was sent but the recorder stopped before publishing the transition" 74
          current_pid="$(unit_property "$unit" MainPID)"
          [[ $current_pid == "$main_pid" ]] || die "$command recorder PID changed before transition confirmation" 74
          if [[ -f $status && ! -L $status && "$($PRESSLOG_STAT -Lc '%u:%g:%a' "$status" 2>/dev/null || true)" == "$PRESSLOG_EXPECTED_UID:$($PRESSLOG_ID -g):600" ]]; then
            if "$PRESSLOG_JQ" -e --arg paused "$expected" --arg pid "$main_pid" '.pid == $pid and .paused == $paused' "$status" >/dev/null 2>&1; then
              printf 'control_signal=%s\npaused=%s\nrecording_pid=%s\nrecording_unit=%s\n%s=PASS\n' "$signal" "$expected" "$main_pid" "$unit" "$marker"
              return 0
            fi
          fi
          "$PRESSLOG_SLEEP" 0.1
          elapsed=$((elapsed + 1))
        done
        die "$command transition was not confirmed by the same PID-bound Presslog status within ten seconds" 75
      }

      #@MNX-PART id=99.88.presslog.function.command-toggle kind=function title="Bash function command_toggle"
      command_toggle() {
        local unit= status=$PRESSLOG_STATE_ROOT/run/status.json main_pid paused action expected
        if unit_failed "$PRESSLOG_NORMAL_UNIT"; then print_unit_failure_summary "$PRESSLOG_NORMAL_UNIT"; return 1; fi
        if unit_failed "$PRESSLOG_BURN_UNIT"; then print_unit_failure_summary "$PRESSLOG_BURN_UNIT"; return 1; fi
        if unit_active "$PRESSLOG_NORMAL_UNIT"; then unit=$PRESSLOG_NORMAL_UNIT; fi
        if unit_active "$PRESSLOG_BURN_UNIT"; then
          [[ -z $unit ]] || die 'both normal and burn recorders are active; toggle refused' 70
          unit=$PRESSLOG_BURN_UNIT
        fi
        [[ -n $unit ]] || die 'toggle refused because no Presslog recorder is active' 69
        main_pid="$(unit_property "$unit" MainPID)"
        [[ $main_pid =~ ^[1-9][0-9]*$ ]] || die 'toggle could not bind the active recorder MainPID' 74
        [[ -f $status && ! -L $status ]] || die 'toggle could not read the active recorder status' 74
        [[ "$($PRESSLOG_STAT -Lc '%u:%g:%a' "$status" 2>/dev/null || true)" == "$PRESSLOG_EXPECTED_UID:$($PRESSLOG_ID -g):600" ]] ||
          die 'toggle refused unsafe Presslog status metadata' 74
        paused="$($PRESSLOG_JQ -r --arg pid "$main_pid" 'if .pid != $pid then "pid-mismatch" elif .paused == "true" then "true" elif .paused == "false" then "false" else "unknown" end' "$status" 2>/dev/null || printf unknown)"
        case "$paused" in
          true) action=resume; expected=false ;;
          false) action=pause; expected=true ;;
          pid-mismatch) die 'toggle status belongs to a different recorder PID' 74 ;;
          *) die 'toggle could not establish the active recorder paused state' 74 ;;
        esac
        command_pause_resume "$action" "$unit" "$main_pid"
        printf 'toggle_action=%s\npaused=%s\nrecording_unit=%s\nPRESSLOG_TOGGLE=PASS\n' "$action" "$expected" "$unit"
      }

      #@MNX-PART id=99.88.presslog.function.command-prompt-guard kind=function title="Bash function command_prompt_guard"
      command_prompt_guard() {
        local unit= status=$PRESSLOG_STATE_ROOT/run/status.json main_pid paused
        if unit_active "$PRESSLOG_NORMAL_UNIT"; then unit=$PRESSLOG_NORMAL_UNIT; fi
        if unit_active "$PRESSLOG_BURN_UNIT"; then
          [[ -z $unit ]] || die 'both normal and burn recorders are active; secret prompt refused' 70
          unit=$PRESSLOG_BURN_UNIT
        fi
        if [[ -z $unit ]]; then
          printf 'presslog_prompt_guard_state=not-recording\nmanual_resume_required=true\nPRESSLOG_PROMPT_GUARD=PASS\n'
          return 0
        fi
        if unit_failed "$unit"; then print_unit_failure_summary "$unit"; return 1; fi
        main_pid="$(unit_property "$unit" MainPID)"
        [[ $main_pid =~ ^[1-9][0-9]*$ ]] || die 'secret prompt could not bind the active recorder MainPID' 74
        [[ -f $status && ! -L $status ]] || die 'secret prompt refused because active recorder status is unavailable' 74
        [[ "$($PRESSLOG_STAT -Lc '%u:%g:%a' "$status" 2>/dev/null || true)" == "$PRESSLOG_EXPECTED_UID:$($PRESSLOG_ID -g):600" ]] ||
          die 'secret prompt refused unsafe Presslog status metadata' 74
        paused="$($PRESSLOG_JQ -r --arg pid "$main_pid" 'if .pid != $pid then "pid-mismatch" elif .paused == "true" then "true" elif .paused == "false" then "false" else "unknown" end' "$status" 2>/dev/null || printf unknown)"
        case "$paused" in
          true) printf 'presslog_prompt_guard_state=already-paused\n' ;;
          false)
            command_pause_resume pause "$unit" "$main_pid"
            printf 'presslog_prompt_guard_state=paused-now\n'
            ;;
          pid-mismatch) die 'secret prompt status belongs to a different recorder PID' 74 ;;
          *) die 'secret prompt could not establish the active recorder paused state' 74 ;;
        esac
        printf 'manual_resume_required=true\nPRESSLOG_PROMPT_GUARD=PASS\n'
      }

      #@MNX-PART id=99.88.presslog.function.safe-json-record kind=function title="Bash function safe_json_record"
      safe_json_record() {
        local path=$1 identity=''${2:-user} metadata uid gid owner group mode size
        if [[ ! -e $path && ! -L $path ]]; then printf 'null\n'; return 0; fi
        if [[ ! -f $path || -L $path || ! -r $path ]]; then
          printf '{"_receipt_state":"unsafe"}\n'
          return 0
        fi
        metadata="$($PRESSLOG_STAT -Lc '%u:%g:%U:%G:%a:%s' "$path" 2>/dev/null || true)"
        IFS=: read -r uid gid owner group mode size <<<"$metadata"
        if [[ ! $size =~ ^[0-9]+$ || $size -le 0 || $size -gt 262144 ]]; then
          printf '{"_receipt_state":"unsafe-size"}\n'
          return 0
        fi
        case "$identity" in
          user)
            [[ $uid == "$PRESSLOG_EXPECTED_UID" && $mode == 600 ]] || {
              printf '{"_receipt_state":"unsafe-user-metadata"}\n'
              return 0
            }
            ;;
          officer)
            [[ $owner == root && $group == logbook && $mode == 640 ]] || {
              printf '{"_receipt_state":"unsafe-officer-metadata"}\n'
              return 0
            }
            ;;
          *) die "unknown metadata receipt identity: $identity" 70 ;;
        esac
        "$PRESSLOG_JQ" -cS 'if type == "object" then . else {"_receipt_state":"invalid-shape"} end' "$path" 2>/dev/null || printf '{"_receipt_state":"invalid-json"}\n'
      }
      #@MNX-PART id=99.88.presslog.function.preferred-json-record kind=function title="Bash function preferred_json_record"
      preferred_json_record() {
        local live=$1 persistent=$2 value
        value="$(safe_json_record "$live" user)"
        if [[ $value == null ]]; then value="$(safe_json_record "$persistent" officer)"; fi
        printf '%s\n' "$value"
      }
      #@MNX-PART id=99.88.presslog.function.current-boot-id kind=function title="Bash function current_boot_id"
      current_boot_id() {
        local value
        [[ -r $PRESSLOG_BOOT_ID_FILE && ! -L $PRESSLOG_BOOT_ID_FILE ]] || { printf 'unknown\n'; return 0; }
        IFS= read -r value < "$PRESSLOG_BOOT_ID_FILE" || value=unknown
        [[ $value =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || value=unknown
        printf '%s\n' "$value"
      }

      #@MNX-PART id=99.88.presslog.function.canonical-status-document kind=function title="Bash function canonical_status_document"
      canonical_status_document() {
        local armed=false normal_active=unknown burn_active=unknown normal_failed=false burn_failed=false running=false review=0 core_rc=0
        local normal_pid=0 burn_pid=0 service_pid=0 core_output=''' core_json=null core_running=unknown
        local segment_count=0 ciphertext_bytes=0 paused=unknown pid=none started=none active_segment=none active_events=unknown auto_expire=unknown
        local state_class=not-initialized health=pass closed_segments=0 startup heartbeat officer recovery now heartbeat_epoch=0 heartbeat_age=-1
        local current_boot startup_boot=unknown heartbeat_boot=unknown startup_state=missing heartbeat_state=missing
        local startup_outcome=unknown startup_confirmed=false startup_confirmed_at=unknown heartbeat_status=unknown heartbeat_pid_matches=false
        local backup_status=unknown backup_review=false recovery_status=never-run reasons_json receipt_state
        local -a reasons=()

        current_boot="$(current_boot_id)"
        [[ -f $PRESSLOG_ARMED_MARKER && ! -L $PRESSLOG_ARMED_MARKER ]] && armed=true
        normal_active="$(user_systemctl is-active "$PRESSLOG_NORMAL_UNIT" 2>/dev/null || true)"
        burn_active="$(user_systemctl is-active "$PRESSLOG_BURN_UNIT" 2>/dev/null || true)"
        normal_pid="$(unit_main_pid "$PRESSLOG_NORMAL_UNIT")"
        burn_pid="$(unit_main_pid "$PRESSLOG_BURN_UNIT")"
        [[ $normal_pid =~ ^[0-9]+$ ]] || normal_pid=0
        [[ $burn_pid =~ ^[0-9]+$ ]] || burn_pid=0
        unit_failed "$PRESSLOG_NORMAL_UNIT" && normal_failed=true
        unit_failed "$PRESSLOG_BURN_UNIT" && burn_failed=true
        [[ $normal_active == active || $burn_active == active ]] && running=true
        if [[ $normal_active == active ]]; then service_pid=$normal_pid
        elif [[ $burn_active == active ]]; then service_pid=$burn_pid
        fi

        core_output="$("$PRESSLOG_CORE" --state "$PRESSLOG_STATE_ROOT" status 2>/dev/null)" || core_rc=$?
        core_json="$(printf '%s\n' "$core_output" | "$PRESSLOG_GREP" -m1 -E '^\{.*\}$' || true)"
        [[ -n $core_json ]] || core_json=null
        core_running="$(printf '%s\n' "$core_output" | "$PRESSLOG_AWK" -F= '$1 == "running" { value=$2 } END { print value == "" ? "unknown" : value }')"
        segment_count="$(printf '%s\n' "$core_output" | "$PRESSLOG_AWK" -F= '$1 == "segments" && $2 ~ /^[0-9]+$/ { value=$2 } END { print value == "" ? 0 : value }')"
        ciphertext_bytes="$(printf '%s\n' "$core_output" | "$PRESSLOG_AWK" -F= '$1 == "bytes" && $2 ~ /^[0-9]+$/ { value=$2 } END { print value == "" ? 0 : value }')"
        if [[ $core_json != null ]] && "$PRESSLOG_JQ" -e 'type == "object"' <<<"$core_json" >/dev/null 2>&1; then
          paused="$("$PRESSLOG_JQ" -r '.paused // "unknown"' <<<"$core_json")"
          pid="$("$PRESSLOG_JQ" -r '.pid // "none"' <<<"$core_json")"
          started="$("$PRESSLOG_JQ" -r '.started // "none"' <<<"$core_json")"
          active_segment="$("$PRESSLOG_JQ" -r '.segment // "none"' <<<"$core_json")"
          active_events="$("$PRESSLOG_JQ" -r '.events // "unknown"' <<<"$core_json")"
          auto_expire="$("$PRESSLOG_JQ" -r '.auto_expire // "unknown"' <<<"$core_json")"
        fi
        closed_segments=$segment_count
        if [[ $running == true && $active_segment != none && $closed_segments -gt 0 ]]; then closed_segments=$((closed_segments - 1)); fi

        startup="$(preferred_json_record "$PRESSLOG_STARTUP_RUNTIME" "$PRESSLOG_STARTUP_CURRENT")"
        heartbeat="$(preferred_json_record "$PRESSLOG_HEARTBEAT_RUNTIME" "$PRESSLOG_HEARTBEAT_CURRENT")"
        officer="$(safe_json_record "$PRESSLOG_OFFICER_CURRENT" officer)"
        recovery="$(safe_json_record "$PRESSLOG_RECOVERY_DRILL_RECEIPT" user)"

        receipt_state="$("$PRESSLOG_JQ" -r '._receipt_state // "safe"' <<<"$startup" 2>/dev/null || printf invalid-json)"
        if [[ $receipt_state != safe ]]; then startup_state=$receipt_state; reasons+=(startup-receipt-$receipt_state)
        elif [[ "$("$PRESSLOG_JQ" -r '.schema // ""' <<<"$startup")" == mnx.presslog.startup.v1 ]]; then
          startup_boot="$("$PRESSLOG_JQ" -r '.boot_id // "unknown"' <<<"$startup")"
          if [[ $current_boot != unknown && $startup_boot == "$current_boot" ]]; then
            startup_state=current-boot
            startup_outcome="$("$PRESSLOG_JQ" -r '.unlock_outcome // "unknown"' <<<"$startup")"
            startup_confirmed="$("$PRESSLOG_JQ" -r 'if .recording_confirmed == true then "true" else "false" end' <<<"$startup")"
            startup_confirmed_at="$("$PRESSLOG_JQ" -r '.recording_confirmed_at // "unknown"' <<<"$startup")"
          else
            startup_state=stale-previous-boot
            startup_outcome=stale-previous-boot
          fi
        fi

        receipt_state="$("$PRESSLOG_JQ" -r '._receipt_state // "safe"' <<<"$heartbeat" 2>/dev/null || printf invalid-json)"
        if [[ $receipt_state != safe ]]; then heartbeat_state=$receipt_state; reasons+=(heartbeat-receipt-$receipt_state)
        elif [[ "$("$PRESSLOG_JQ" -r '.schema // ""' <<<"$heartbeat")" == mnx.presslog.heartbeat.v1 ]]; then
          heartbeat_boot="$("$PRESSLOG_JQ" -r '.boot_id // "unknown"' <<<"$heartbeat")"
          if [[ $current_boot != unknown && $heartbeat_boot == "$current_boot" ]]; then
            heartbeat_state=current-boot
            heartbeat_status="$("$PRESSLOG_JQ" -r '.status // "unknown"' <<<"$heartbeat")"
            heartbeat_pid_matches="$("$PRESSLOG_JQ" -r 'if .status_pid_matches == true then "true" else "false" end' <<<"$heartbeat")"
            heartbeat_epoch="$("$PRESSLOG_JQ" -r '.updated_epoch // 0' <<<"$heartbeat")"
          else
            heartbeat_state=stale-previous-boot
            heartbeat_status=stale-previous-boot
          fi
        fi
        now="$($PRESSLOG_DATE +%s)"
        if [[ $heartbeat_epoch =~ ^[0-9]+$ && $heartbeat_epoch -gt 0 && $now -ge $heartbeat_epoch ]]; then heartbeat_age=$((now - heartbeat_epoch)); fi

        backup_status="$("$PRESSLOG_JQ" -r '.backup_coverage.status // "unknown"' <<<"$officer" 2>/dev/null || printf unknown)"
        backup_review="$("$PRESSLOG_JQ" -r 'if .backup_coverage.review_required == true then "true" else "false" end' <<<"$officer" 2>/dev/null || printf false)"
        recovery_status="$("$PRESSLOG_JQ" -r '.outcome // "never-run"' <<<"$recovery" 2>/dev/null || printf never-run)"

        if [[ $normal_active == active && $paused == true ]]; then state_class=paused
        elif [[ $normal_active == active && $pid == "$normal_pid" ]]; then state_class=recording
        elif [[ $normal_active == active ]]; then state_class=recording-unconfirmed
        elif [[ $burn_active == active && $paused == true ]]; then state_class=burn-paused
        elif [[ $burn_active == active && $pid == "$burn_pid" ]]; then state_class=burn-recording
        elif [[ $burn_active == active ]]; then state_class=burn-recording-unconfirmed
        elif [[ $armed == true ]]; then state_class=armed-but-locked
        elif [[ -d $PRESSLOG_STATE_ROOT/private ]]; then state_class=idle
        fi

        [[ $normal_failed == true ]] && reasons+=(normal-service-failed)
        [[ $burn_failed == true ]] && reasons+=(burn-service-failed)
        [[ $normal_active == active && $burn_active == active ]] && reasons+=(both-recorders-active)
        [[ $normal_active == active && $armed != true ]] && reasons+=(recording-without-armed-marker)
        [[ $armed == true && $normal_active != active && $burn_active != active && $startup_outcome == failed ]] && reasons+=(armed-startup-failed)
        (( core_rc == 0 )) || reasons+=(core-status-nonzero)
        [[ $running == true && $core_running == true ]] || [[ $running == false && $core_running != true ]] || reasons+=(service-core-running-disagree)
        [[ $running != true || $pid == "$service_pid" ]] || reasons+=(service-core-pid-disagree)
        [[ $running != true || $auto_expire == false ]] || reasons+=(automatic-expiry-not-disabled)
        if [[ $running == true ]]; then
          [[ $heartbeat_state == current-boot ]] || reasons+=(current-boot-heartbeat-missing)
          [[ $heartbeat_pid_matches == true ]] || reasons+=(heartbeat-pid-unconfirmed)
          [[ $heartbeat_age -ge 0 && $heartbeat_age -le 120 ]] || reasons+=(supervisor-heartbeat-stale)
        fi
        [[ $backup_review != true ]] || reasons+=(backup-coverage-overdue)
        [[ $recovery_status != fail ]] || reasons+=(last-recovery-drill-failed)

        if (( ''${#reasons[@]} > 0 )); then health=review; review=1; fi
        reasons_json="$(printf '%s\n' "''${reasons[@]:-}" | "$PRESSLOG_JQ" -Rsc 'split("\n") | map(select(length > 0))')"
        "$PRESSLOG_JQ" -cnS \
          --arg schema mnx.presslog.wrapper-status.v3 \
          --arg state_root "$PRESSLOG_STATE_ROOT" \
          --arg state "$state_class" \
          --arg health "$health" \
          --arg current_boot_id "$current_boot" \
          --argjson armed "$armed" \
          --argjson running "$running" \
          --arg normal_unit "$normal_active" \
          --arg burn_unit "$burn_active" \
          --argjson normal_failed "$normal_failed" \
          --argjson burn_failed "$burn_failed" \
          --arg paused "$paused" \
          --arg recorder_pid "$pid" \
          --arg service_main_pid "$service_pid" \
          --arg started "$started" \
          --arg active_segment "$active_segment" \
          --arg active_events "$active_events" \
          --arg auto_expire "$auto_expire" \
          --argjson segment_count "$segment_count" \
          --argjson closed_segment_count "$closed_segments" \
          --argjson ciphertext_bytes "$ciphertext_bytes" \
          --arg startup_record_state "$startup_state" \
          --arg startup_outcome "$startup_outcome" \
          --argjson startup_confirmed "$startup_confirmed" \
          --arg startup_confirmed_at "$startup_confirmed_at" \
          --arg heartbeat_record_state "$heartbeat_state" \
          --arg heartbeat_status "$heartbeat_status" \
          --argjson heartbeat_age_seconds "$heartbeat_age" \
          --arg backup_coverage_status "$backup_status" \
          --arg recovery_drill_status "$recovery_status" \
          --argjson startup "$startup" \
          --argjson heartbeat "$heartbeat" \
          --argjson officer "$officer" \
          --argjson recovery "$recovery" \
          --argjson review_reasons "$reasons_json" \
          '{schema:$schema,state_root:$state_root,state:$state,health:$health,current_boot_id:$current_boot_id,armed:$armed,running:$running,normal_unit:$normal_unit,burn_unit:$burn_unit,normal_failed:$normal_failed,burn_failed:$burn_failed,paused:$paused,recorder_pid:$recorder_pid,service_main_pid:$service_main_pid,started:$started,active_segment:$active_segment,active_events:$active_events,auto_expire:$auto_expire,segment_count:$segment_count,closed_segment_count:$closed_segment_count,ciphertext_bytes:$ciphertext_bytes,startup_record_state:$startup_record_state,startup_outcome:$startup_outcome,startup_confirmed:$startup_confirmed,startup_confirmed_at:$startup_confirmed_at,heartbeat_record_state:$heartbeat_record_state,heartbeat_status:$heartbeat_status,heartbeat_age_seconds:$heartbeat_age_seconds,backup_coverage_status:$backup_coverage_status,recovery_drill_status:$recovery_drill_status,startup:$startup,heartbeat:$heartbeat,officer_record:$officer,recovery_drill:$recovery,review_reasons:$review_reasons,content_inspected:false,journal_payload_read:false,private_material_read:false,network_used:false}'
        return "$review"
      }
      #@MNX-PART id=99.88.presslog.function.write-recovery-drill-receipt kind=function title="Bash function write_recovery_drill_receipt"
      write_recovery_drill_receipt() {
        local outcome=$1 phase=$2 archive=''${3:-none} archive_sha=''${4:-none} active_before=''${5:-false} paused_before=''${6:-false}
        local original_verified=''${7:-false} archive_created=''${8:-false} disposable_imported=''${9:-false} disposable_verified=''${10:-false}
        local cleanup_completed=''${11:-false} restored_active=''${12:-false} restored_paused=''${13:-false} interrupted=''${14:-false}
        local tmp="$PRESSLOG_CONTROL_ROOT/.recovery-drill-current.$$" now
        now="$($PRESSLOG_DATE -u +%Y-%m-%dT%H:%M:%SZ)"
        "$PRESSLOG_JQ" -cnS \
          --arg schema mnx.presslog.recovery-drill.v1 \
          --arg recorded_at "$now" \
          --arg outcome "$outcome" \
          --arg phase "$phase" \
          --arg archive "$archive" \
          --arg archive_sha256 "$archive_sha" \
          --argjson recorder_active_before "$active_before" \
          --argjson recorder_paused_before "$paused_before" \
          --argjson original_deep_verified "$original_verified" \
          --argjson encrypted_archive_created "$archive_created" \
          --argjson disposable_import_completed "$disposable_imported" \
          --argjson disposable_deep_verified "$disposable_verified" \
          --argjson disposable_state_removed "$cleanup_completed" \
          --argjson recorder_active_restored "$restored_active" \
          --argjson recorder_paused_restored "$restored_paused" \
          --argjson interrupted "$interrupted" \
          '{schema:$schema,recorded_at:$recorded_at,outcome:$outcome,phase:$phase,archive:$archive,archive_sha256:$archive_sha256,recorder_active_before:$recorder_active_before,recorder_paused_before:$recorder_paused_before,original_deep_verified:$original_deep_verified,encrypted_archive_created:$encrypted_archive_created,disposable_import_completed:$disposable_import_completed,disposable_deep_verified:$disposable_deep_verified,disposable_state_removed:$disposable_state_removed,recorder_active_restored:$recorder_active_restored,recorder_paused_restored:$recorder_paused_restored,interrupted:$interrupted,plaintext_exported:false,journal_content_printed:false,password_recorded:false,network_used:false}' > "$tmp" || return 70
        "$PRESSLOG_CHMOD" 0600 "$tmp" || return 70
        "$PRESSLOG_SYNC" -f "$tmp" || return 70
        "$PRESSLOG_MV" -f -- "$tmp" "$PRESSLOG_RECOVERY_DRILL_RECEIPT" || return 70
        "$PRESSLOG_SYNC" -f "$PRESSLOG_RECOVERY_DRILL_RECEIPT" || return 70
      }
      #@MNX-PART id=99.88.presslog.function.recovery-drill-finalize kind=function title="Bash function recovery_drill_finalize"
      recovery_drill_finalize() {
        local incoming=$? failure_phase=$phase
        trap - EXIT HUP INT TERM
        if (( rc == 0 && incoming != 0 )); then rc=$incoming; failure_phase=$phase; fi
        if [[ $sandbox != none ]]; then
          "$PRESSLOG_RM" -rf --one-file-system -- "$sandbox"
          [[ ! -e $sandbox && ! -L $sandbox ]] && cleanup_completed=true
        else
          cleanup_completed=true
        fi
        if [[ $active_before == true ]]; then
          phase=restore-recorder
          ( restart_normal_if_needed yes )
          restart_rc=$?
          if (( restart_rc == 0 )); then
            restored_active=true
            restored_paused=true
          fi
        fi
        local outcome=fail final_rc=$rc final_phase=$failure_phase
        if (( rc == 0 && restart_rc == 0 )) && [[ $original_verified == true && $archive_created == true && $disposable_imported == true && $disposable_verified == true && $cleanup_completed == true ]]; then
          outcome=pass
          final_phase=complete
          final_rc=0
        elif (( rc != 0 )); then
          final_phase=$failure_phase
          if (( restart_rc != 0 )); then final_phase="$failure_phase+restore-recorder"; fi
        elif (( restart_rc != 0 )); then
          final_phase=restore-recorder
          final_rc=$restart_rc
        else
          final_phase=completion-invariant
          final_rc=70
        fi
        write_recovery_drill_receipt "$outcome" "$final_phase" "$archive" "$archive_sha" "$active_before" "$paused_before" "$original_verified" "$archive_created" "$disposable_imported" "$disposable_verified" "$cleanup_completed" "$restored_active" "$restored_paused" "$interrupted"
        receipt_rc=$?
        if (( receipt_rc != 0 && final_rc == 0 )); then final_rc=$receipt_rc; outcome=fail; final_phase=receipt-publication; fi
        if [[ $outcome == pass ]]; then
          printf 'recovery_archive=%s\nrecovery_archive_sha256=%s\noriginal_deep_verified=true\ndisposable_import_verified=true\ndisposable_state_removed=true\nrecorder_active_restored=%s\nrecorder_paused_restored=%s\nPRESSLOG_RECOVERY_DRILL=PASS\n' "$archive" "$archive_sha" "$restored_active" "$restored_paused"
        else
          printf 'presslog: recovery drill failed at phase %s; encrypted archive, when created, is preserved at %s\n' "$final_phase" "$archive" >&2
          printf 'PRESSLOG_RECOVERY_DRILL=FAIL\n' >&2
        fi
        exit "$final_rc"
      }

      #@MNX-PART id=99.88.presslog.function.recovery-drill-interrupt kind=function title="Bash function recovery_drill_interrupt"
      recovery_drill_interrupt() {
        interrupted=true
        phase=interrupted
        rc=130
        exit 130
      }

      #@MNX-PART id=99.88.presslog.function.command-recovery-drill kind=function title="Bash function command_recovery_drill"
      command_recovery_drill() {
        (
          set +e
          local active_before=false paused_before=false original_verified=false archive_created=false disposable_imported=false disposable_verified=false
          local cleanup_completed=false restored_active=false restored_paused=false interrupted=false rc=0 restart_rc=0 receipt_rc=0
          local status="$PRESSLOG_STATE_ROOT/run/status.json" stamp archive=none sandbox=none archive_sha=none phase=preflight

          trap recovery_drill_finalize EXIT
          trap recovery_drill_interrupt HUP INT TERM
          require_no_burn_session
          if ! has_journal_material; then phase=preflight-no-journal; rc=69; exit "$rc"; fi
          if unit_active "$PRESSLOG_NORMAL_UNIT"; then
            active_before=true
            if [[ -f $status && ! -L $status ]]; then
              paused_before="$("$PRESSLOG_JQ" -r 'if .paused == "true" then "true" else "false" end' "$status" 2>/dev/null || printf false)"
            fi
          fi
          stamp="$("$PRESSLOG_DATE" -u +%Y%m%dT%H%M%SZ)"
          archive="$PRESSLOG_RECOVERY_ROOT/presslog-recovery-drill-$stamp.plarch"
          sandbox="$PRESSLOG_RECOVERY_ROOT/.recovery-drill-$stamp.$$"
          if [[ -e $archive || -L $archive || -e $sandbox || -L $sandbox ]]; then phase=preflight-path-collision; rc=74; exit "$rc"; fi
          write_recovery_drill_receipt in-progress preflight none none "$active_before" "$paused_before" false false false false false false false false || { phase=initial-receipt; rc=70; exit "$rc"; }
          if [[ $active_before == true ]]; then
            phase=stop-recorder
            stop_unit_verified "$PRESSLOG_NORMAL_UNIT" || { rc=$?; exit "$rc"; }
          fi
          phase=verify-original
          run_presslog_authenticated_core verify --deep || { rc=$?; exit "$rc"; }
          original_verified=true
          phase=archive-export
          run_core_with_prompt --archive-create archive-export --out "$archive" || { rc=$?; exit "$rc"; }
          if [[ ! -f $archive || -L $archive ]]; then rc=74; exit "$rc"; fi
          archive_created=true
          archive_sha="$("$PRESSLOG_SHA256SUM" "$archive" | "$PRESSLOG_AWK" '{print $1}')" || { rc=$?; exit "$rc"; }
          phase=prepare-disposable-state
          "$PRESSLOG_INSTALL" -d -m 0700 "$sandbox" "$sandbox/journal" "$sandbox/manifests" "$sandbox/private" "$sandbox/run" || { rc=$?; exit "$rc"; }
          "$PRESSLOG_CP" -a --reflink=auto -- "$PRESSLOG_STATE_ROOT/journal/." "$sandbox/journal/" || { rc=$?; exit "$rc"; }
          "$PRESSLOG_CP" -a --reflink=auto -- "$PRESSLOG_STATE_ROOT/manifests/." "$sandbox/manifests/" || { rc=$?; exit "$rc"; }
          "$PRESSLOG_CHMOD" -R go-rwx "$sandbox" || { rc=$?; exit "$rc"; }
          phase=disposable-import
          PRESSLOG_IMPORT_CONFIRM=yes run_core_with_prompt_state "$sandbox" --archive-existing archive-import --in "$archive" || { rc=$?; exit "$rc"; }
          disposable_imported=true
          phase=disposable-deep-verify
          run_core_with_prompt_state "$sandbox" --presslog-existing verify --deep || { rc=$?; exit "$rc"; }
          disposable_verified=true
          phase=complete
          exit 0
        )
      }
      #@MNX-PART id=99.88.presslog.function.command-status kind=function title="Bash function command_status"
      command_status() {
        local mode=''${1:-human} document rc=0
        case "$mode" in human|--json) ;; *) die 'status accepts only --json' 64 ;; esac
        document="$(canonical_status_document)" || rc=$?
        if [[ $mode == --json ]]; then
          printf '%s\n' "$document"
          return "$rc"
        fi
        "$PRESSLOG_JQ" -r '
          "schema=" + .schema,
          "state=" + .state,
          "health=" + .health,
          "armed=" + (.armed|tostring),
          "running=" + (.running|tostring),
          "paused=" + .paused,
          "recorder_pid=" + .recorder_pid,
          "service_main_pid=" + .service_main_pid,
          "started=" + .started,
          "active_segment=" + .active_segment,
          "active_events=" + .active_events,
          "closed_segments=" + (.closed_segment_count|tostring),
          "ciphertext_bytes=" + (.ciphertext_bytes|tostring),
          "auto_expire=" + .auto_expire,
          "startup_record_state=" + .startup_record_state,
          "startup_outcome=" + .startup_outcome,
          "startup_confirmed=" + (.startup_confirmed|tostring),
          "startup_confirmed_at=" + .startup_confirmed_at,
          "heartbeat_record_state=" + .heartbeat_record_state,
          "heartbeat_status=" + .heartbeat_status,
          "heartbeat_age_seconds=" + (.heartbeat_age_seconds|tostring),
          "backup_coverage_status=" + .backup_coverage_status,
          "recovery_drill_status=" + .recovery_drill_status,
          "review_reasons=" + (if (.review_reasons|length) == 0 then "none" else (.review_reasons|join(",")) end)
        ' <<<"$document"
        if (( rc == 0 )); then printf 'PRESSLOG_STATUS=PASS\n'; return 0; fi
        printf 'PRESSLOG_STATUS=REVIEW\n'
        return "$rc"
      }
      #@MNX-PART id=99.88.presslog.function.command-doctor kind=function title="Bash function command_doctor"
      command_doctor() {
        local failed=0 keyboard=0 node xauthority
        printf 'schema=mnx.presslog.doctor.v2\n'
        printf 'state=%s\n' "$PRESSLOG_STATE_ROOT"
        [[ -x $PRESSLOG_CORE ]] || { printf 'core=unavailable\n'; failed=1; }
        if [[ -x $PRESSLOG_CORE ]]; then printf 'core=%s\n' "$PRESSLOG_CORE"; fi
        if [[ -d /dev/input ]]; then
          for node in /dev/input/event*; do
            [[ -c $node ]] || continue
            if "$PRESSLOG_UDEVADM" info --query=property --name="$node" 2>/dev/null | "$PRESSLOG_GREP" -Fx 'ID_INPUT_KEYBOARD=1' >/dev/null && [[ -r $node ]]; then
              keyboard=$((keyboard + 1))
            fi
          done
        fi
        printf 'readable_keyboard_events=%s\n' "$keyboard"
        (( keyboard > 0 )) || failed=1
        printf 'normal_unit_file=%s\n' "$(unit_property "$PRESSLOG_NORMAL_UNIT" LoadState)"
        [[ "$(unit_property "$PRESSLOG_NORMAL_UNIT" LoadState)" == loaded ]] || failed=1
        if [[ -x $PRESSLOG_PINENTRY ]]; then
          "$PRESSLOG_PINENTRY" --self-test || failed=1
          "$PRESSLOG_PINENTRY" --check-program || failed=1
        else
          printf 'pinentry_adapter=unavailable\n'
          failed=1
        fi
        printf 'password_prompt=pinentry-qt-assuan\npassword_transport=anonymous-pipe\n'
        printf 'DISPLAY=%s\nXDG_RUNTIME_DIR=%s\nDBUS_SESSION_BUS_ADDRESS=%s\n' "''${DISPLAY:-:0}" "''${XDG_RUNTIME_DIR:-/run/user/1000}" "''${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/1000/bus}"
        xauthority="''${XAUTHORITY:-/home/h0p3/.Xauthority}"
        if [[ -f $xauthority && ! -L $xauthority && -r $xauthority ]]; then printf 'xauthority_readable=yes\n'; else printf 'xauthority_readable=no\n'; failed=1; fi
        if unit_failed "$PRESSLOG_NORMAL_UNIT"; then print_unit_failure_summary "$PRESSLOG_NORMAL_UNIT"; failed=1; fi
        printf 'content_inspected=false\nnetwork_used=false\npassword_prompted=false\n'
        printf 'PRESSLOG_DOCTOR=%s\n' "$([[ $failed == 0 ]] && printf PASS || printf REVIEW)"
        return "$failed"
      }

      #@MNX-PART id=99.88.presslog.function.command-armed-status kind=function title="Bash function command_armed_status"
      command_armed_status() {
        local state
        state="$(armed_marker_state)"
        printf 'presslog_armed_marker_state=%s\n' "$state"
        case "$state" in
          safe|absent) printf 'PRESSLOG_ARMED_STATUS=PASS\n'; return 0 ;;
          *) printf 'PRESSLOG_ARMED_STATUS=REVIEW\n' >&2; return 76 ;;
        esac
      }

      #@MNX-PART id=99.88.presslog.function.command-recover-armed kind=function title="Bash function command_recover_armed"
      command_recover_armed() {
        local marker_state rc=0
        marker_state="$(armed_marker_state)"
        case "$marker_state" in
          absent)
            printf 'presslog_recover_armed_state=not-armed\nmanual_resume_required=true\nPRESSLOG_RECOVER_ARMED=SKIP_NOT_ARMED\n'
            return 0
            ;;
          safe) ;;
          *) die 'recover-armed refused an unsafe armed marker without starting or signaling a recorder' 74 ;;
        esac
        if unit_active "$PRESSLOG_BURN_UNIT"; then
          die 'recover-armed refuses to replace an active burn session' 75
        fi
        if unit_active "$PRESSLOG_NORMAL_UNIT"; then
          command_pause_resume pause "$PRESSLOG_NORMAL_UNIT" "$(unit_main_pid "$PRESSLOG_NORMAL_UNIT")"
          wait_for_recording "$PRESSLOG_NORMAL_UNIT" false
          printf 'presslog_recover_armed_state=already-active-forced-paused\nmanual_resume_required=true\nPRESSLOG_RECOVER_ARMED=PASS\n'
          return 0
        fi
        if start_normal; then
          printf 'presslog_recover_armed_state=started-paused\nmanual_resume_required=true\nPRESSLOG_RECOVER_ARMED=PASS\n'
          return 0
        else
          rc=$?
        fi
        wait_for_stopped "$PRESSLOG_NORMAL_UNIT" >/dev/null
        wait_for_stopped "$PRESSLOG_BURN_UNIT" >/dev/null
        marker_state="$(armed_marker_state)"
        case "$marker_state" in
          safe) marker_state=blocked-stopped-arm-retained ;;
          absent) marker_state=blocked-stopped-explicitly-disarmed ;;
          *) die 'recover-armed failed and the preexisting armed marker became unsafe' 74 ;;
        esac
        printf 'presslog_recover_armed_state=%s\npresslog_recover_armed_original_rc=%s\nmanual_resume_required=true\nPRESSLOG_RECOVER_ARMED=BLOCKED\n' "$marker_state" "$rc" >&2
        return 76
      }

