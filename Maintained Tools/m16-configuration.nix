#@MNX-PART id=90.00.monsterdesk.function.f023w1-acquire-cutover-lock kind=function title="Python function acquire_nicotine_cutover_lock"
def acquire_nicotine_cutover_lock() -> int:
    path = nicotine_cutover_lock_path()
    flags = os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags, 0o600)
    try:
        st = os.fstat(fd)
        if (not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid()
                or stat.S_IMODE(st.st_mode) != 0o600 or st.st_nlink != 1):
            raise MonsterdeskError("Nicotine cutover lock ownership, mode, type, or link count differs")
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except Exception:
        os.close(fd)
        raise
    return fd


#@MNX-PART id=90.00.monsterdesk.function.f023w2-release-cutover-lock kind=function title="Python function release_nicotine_cutover_lock"
def release_nicotine_cutover_lock(fd: int) -> None:
    with contextlib.suppress(OSError):
        fcntl.flock(fd, fcntl.LOCK_UN)
    with contextlib.suppress(OSError):
        os.close(fd)


