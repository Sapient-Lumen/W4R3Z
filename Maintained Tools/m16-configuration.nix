#@MNX-CHUNK id=60.10 slug=btrbk-backup-policy title="Btrbk policy and home-to-backup-NVMe/archive services"
#######################################################################################################
# SECTION 60 — BACKUP POLICY AND PRIMARY M16 SNAPSHOT FLOW
#######################################################################################################

  ### btrbk ###
  # Scheduling niceness/IO class is forced on the generated service below.
  # Doing it at serviceConfig with lib.mkForce avoids merge conflicts with
  # defaults from the upstream btrbk module on this channel.

#@MNX-DEF path=services.btrbk.instances.main section=60.10 role=backup-policy ordinal=215
  services.btrbk.instances.main = {
    onCalendar = "07:45";
    settings = {
      # Both btrbk services below run as root; call btrfs directly rather than
      # going back through sudo (important for the hardened archive unit).
      backend = "btrfs-progs";
      lockfile = "/run/btrbk-monsternix.lock";

      snapshot_preserve_min = "2d";
      snapshot_preserve = "7d 4w 6m 1y";
      target_preserve_min = "no";
      target_preserve = "7d 4w 6m 1y";

      # The weekly HDD archive is intentionally longer-lived than the fast NVMe
      # target. btrbk archive copies selected received snapshots incrementally.
      preserve_day_of_week = "sunday";
      archive_preserve_min = "latest";
      archive_preserve = "12w 24m 5y";

      # Keep a structured transaction trail and make retention deletions durable
      # before btrbk reports success.
      transaction_log = "/var/lib/btrbk/main-transactions.log";
      transaction_syslog = "daemon";
      btrfs_commit_delete = "yes";

      volume."/" = {
        subvolume = "/home";
        snapshot_dir = "/home/.btrbk-snapshots";
        target = "send-receive /mnt/m16-backup-nvme/btrbk-snapshots";
      };
    };
  };

#@MNX-DEF path=systemd.timers.btrbk-main.timerConfig section=60.10 role=timer ordinal=216
  systemd.timers.btrbk-main.timerConfig = {
    AccuracySec = "10min";
    RandomizedDelaySec = "20min";

    # The upstream btrbk timer sets Persistent=true. Force it off here.
    # Avoid surprise catch-up runs after boot/switch on this workstation; an
    # intentionally missed generation is preferable to an unplanned heavy IO burst.
    Persistent = lib.mkForce false;
  };

#@MNX-DEF path=systemd.services.btrbk-main section=60.10 role=service ordinal=217
  systemd.services.btrbk-main = {
    after = [ "local-fs.target" "nix-gc.service" "nixos-upgrade.service" ];
    wants = [ "local-fs.target" ];
    onFailure = [ "mnx-job-failure-notify@%n.service" ];

    unitConfig = {
      ConditionPathIsMountPoint = "/mnt/m16-backup-nvme";
      RequiresMountsFor = [
        "/home"
        "/mnt/m16-backup-nvme"
        "/mnt/m16-backup-nvme/btrbk-snapshots"
      ];
    };

    serviceConfig = {
      PermissionsStartOnly = true;
      User = lib.mkForce "root";
      Group = lib.mkForce "root";
      Type = "oneshot";
      TimeoutStartSec = "8h";
      TimeoutStopSec = "10min";
      KillMode = "control-group";
      CPUSchedulingPolicy = "idle";
      Nice = lib.mkForce 15;
      IOSchedulingClass = lib.mkForce "idle";
      StandardOutput = "journal";
      StandardError = "journal";

      # Guarded runner policy:
      #   - The backup target intentionally also hosts the active overflow swapfile.
      #   - Never swapoff live memory and never skip btrbk merely because swap is used.
      #   - Serialize storage maintenance and refuse an unavailable/read-only target.
      #   - Treat source and target Btrfs device counters as cumulative: record
      #     old non-zero values, but fail if either increases during this backup.
      ExecStart = lib.mkForce [
        "${pkgs.writeShellScript "btrbk-main-guarded-run" ''
          set -euo pipefail

          LOCK=/run/storage-maintenance.lock
          SOURCE=/home
          TARGET=/mnt/m16-backup-nvme
          JOB_START="$(${pkgs.coreutils}/bin/date +%s)"
          JOB_SKIPPED=0
          JOB_REASON=none

          #@MNX-PART id=60.10.btrbk-main.function.finish_metric kind=function title="Function finish_metric"
          finish_metric() {
            rc="$?"
            trap - EXIT
            now="$(${pkgs.coreutils}/bin/date +%s)"
            /etc/monsternix/bin/mnx-job-metric \
              btrbk-main "$rc" "$(( now - JOB_START ))" \
              "$JOB_SKIPPED" "$JOB_REASON" || true
            exit "$rc"
          }
          trap finish_metric EXIT

          #@MNX-PART id=60.10.btrbk-main.function.note kind=function title="Function note"
          note() {
            printf 'btrbk-main: %s\n' "$*"
            ${pkgs.util-linux}/bin/logger -t btrbk-main -p daemon.notice -- "$*" || true
          }

          #@MNX-PART id=60.10.btrbk-main.function.warn kind=function title="Function warn"
          warn() {
            printf 'btrbk-main: WARNING: %s\n' "$*" >&2
            ${pkgs.util-linux}/bin/logger -t btrbk-main -p daemon.warning -- "$*" || true
            /etc/monsternix/bin/mnx-notify warning "btrbk-main warning" "$*" || true
          }

          #@MNX-PART id=60.10.btrbk-main.function.btrfs_stats_output kind=function title="Function btrfs_stats_output"
          btrfs_stats_output() {
            ${pkgs.btrfs-progs}/bin/btrfs device stats "$1" 2>&1
          }

          #@MNX-PART id=60.10.btrbk-main.function.btrfs_stats_total kind=function title="Function btrfs_stats_total"
          btrfs_stats_total() {
            ${pkgs.gawk}/bin/awk '$1 ~ /\]\./ { total += $2 + 0 } END { print total + 0 }'
          }

          #@MNX-PART id=60.10.btrbk-main.function.mount_is_rw kind=function title="Function mount_is_rw"
          mount_is_rw() {
            ${pkgs.util-linux}/bin/findmnt -rn -no OPTIONS "$1" 2>/dev/null \
              | ${pkgs.gnugrep}/bin/grep -Eq '(^|,)rw(,|$)'
          }

          exec 9<>"$LOCK"
          if ! ${pkgs.util-linux}/bin/flock -n -x 9; then
            note "operator or another storage job owns $LOCK; skipping immediately so freshness can retry later"
            JOB_SKIPPED=1
            JOB_REASON=lock-busy
            exit 0
          fi

          for mp in "$SOURCE" "$TARGET"; do
            if ! ${pkgs.util-linux}/bin/mountpoint -q "$mp"; then
              warn "$mp is not mounted; refusing backup"
              exit 1
            fi
            if ! mount_is_rw "$mp"; then
              warn "$mp is not mounted read-write; refusing backup"
              exit 1
            fi
          done

          SOURCE_PRE_STATS="$(btrfs_stats_output "$SOURCE")" || {
            warn "cannot read Btrfs device stats for $SOURCE; refusing backup"
            exit 1
          }
          TARGET_PRE_STATS="$(btrfs_stats_output "$TARGET")" || {
            warn "cannot read Btrfs device stats for $TARGET; refusing backup"
            exit 1
          }
          SOURCE_PRE_TOTAL="$(printf '%s\n' "$SOURCE_PRE_STATS" | btrfs_stats_total)"
          TARGET_PRE_TOTAL="$(printf '%s\n' "$TARGET_PRE_STATS" | btrfs_stats_total)"
          if [ "$SOURCE_PRE_TOTAL" -gt 0 ] 2>/dev/null; then
            note "$SOURCE has cumulative Btrfs device-error counters totalling $SOURCE_PRE_TOTAL; continuing and watching for an increase"
            printf '%s\n' "$SOURCE_PRE_STATS"
          fi
          if [ "$TARGET_PRE_TOTAL" -gt 0 ] 2>/dev/null; then
            note "$TARGET has cumulative Btrfs device-error counters totalling $TARGET_PRE_TOTAL; continuing and watching for an increase"
            printf '%s\n' "$TARGET_PRE_STATS"
          fi

          ${pkgs.btrbk}/bin/btrbk -c /etc/btrbk/main.conf run || {
            rc="$?"
            warn "btrbk failed with exit status $rc"
            exit "$rc"
          }

          SOURCE_POST_STATS="$(btrfs_stats_output "$SOURCE")" || {
            warn "btrbk completed, but Btrfs device stats for $SOURCE are now unreadable"
            exit 1
          }
          TARGET_POST_STATS="$(btrfs_stats_output "$TARGET")" || {
            warn "btrbk completed, but Btrfs device stats for $TARGET are now unreadable"
            exit 1
          }
          SOURCE_POST_TOTAL="$(printf '%s\n' "$SOURCE_POST_STATS" | btrfs_stats_total)"
          TARGET_POST_TOTAL="$(printf '%s\n' "$TARGET_POST_STATS" | btrfs_stats_total)"
          if [ "$SOURCE_POST_TOTAL" -gt "$SOURCE_PRE_TOTAL" ] 2>/dev/null; then
            warn "$SOURCE Btrfs device-error counters increased during btrbk: $SOURCE_PRE_TOTAL -> $SOURCE_POST_TOTAL"
            printf '%s\n' "$SOURCE_POST_STATS" >&2
            exit 1
          fi
          if [ "$TARGET_POST_TOTAL" -gt "$TARGET_PRE_TOTAL" ] 2>/dev/null; then
            warn "$TARGET Btrfs device-error counters increased during btrbk: $TARGET_PRE_TOTAL -> $TARGET_POST_TOTAL"
            printf '%s\n' "$TARGET_POST_STATS" >&2
            exit 1
          fi

          LATEST_TARGET="$(${pkgs.findutils}/bin/find "$TARGET/btrbk-snapshots" -mindepth 1 -maxdepth 1 -type d -name 'home.[0-9]*T[0-9]*' -printf '%f\n' 2>/dev/null | ${pkgs.coreutils}/bin/sort | ${pkgs.coreutils}/bin/tail -n 1)"
          if [ -z "$LATEST_TARGET" ]; then
            warn "btrbk completed but no target snapshot could be identified"
            exit 1
          fi
          /etc/monsternix/bin/mnx-job-success \
            btrbk-main "$LATEST_TARGET" "target=$TARGET/btrbk-snapshots"
          note "backup completed successfully: $LATEST_TARGET"
        ''}"
      ];
    };

    preStart = ''
      set -euo pipefail
      ${pkgs.coreutils}/bin/mkdir -p /home/.btrbk-snapshots /mnt/m16-backup-nvme/btrbk-snapshots
      ${pkgs.coreutils}/bin/chown btrbk:btrbk /home/.btrbk-snapshots /mnt/m16-backup-nvme/btrbk-snapshots
      ${pkgs.coreutils}/bin/chmod 0750 /home/.btrbk-snapshots /mnt/m16-backup-nvme/btrbk-snapshots
    '';
  };

  # Weekly second copy of the backup-NVMe btrbk history onto the HDD-backed
  # m16-new-storage filesystem. Use btrbk archive rather than rsync so received
  # snapshots remain read-only Btrfs subvolumes and future runs are incremental.
#@MNX-DEF path=systemd.services.btrbk-archive-to-new-storage section=60.10 role=service ordinal=218
  systemd.services.btrbk-archive-to-new-storage = {
    description = "Archive backup-NVMe btrbk snapshots to m16-new-storage";
    wants = [ "local-fs.target" ];
    after = [ "local-fs.target" "btrbk-main.service" ];
    onFailure = [ "mnx-job-failure-notify@%n.service" ];

    unitConfig = {
      RequiresMountsFor = [
        "/mnt/m16-backup-nvme"
        "/mnt/m16-new-storage"
      ];
    };

    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Group = "root";
      UMask = "0027";
      Nice = 19;
      CPUSchedulingPolicy = "idle";
      IOSchedulingClass = "idle";
      TimeoutStartSec = "infinity";
      TimeoutStopSec = "30min";
      KillMode = "control-group";
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectSystem = "full";
      RestrictSUIDSGID = false; # preserve SUID/SGID metadata during btrfs receive
      StandardOutput = "journal";
      StandardError = "journal";
    };

    path = [
      pkgs.bash
      pkgs.btrbk
      pkgs.btrfs-progs
      pkgs.coreutils
      pkgs.findutils
      pkgs.gawk
      pkgs.gnugrep
      pkgs.gnused
      pkgs.util-linux
      pkgs.systemd
    ];

    script = ''
      set -euo pipefail
      umask 027

      JOB_START="$(date +%s)"
      JOB_SKIPPED=0
      JOB_REASON=none
      #@MNX-PART id=60.10.btrbk-archive-to-new-storage.function.finish_metric kind=function title="Function finish_metric"
      finish_metric() {
        rc="$?"
        trap - EXIT
        now="$(date +%s)"
        /etc/monsternix/bin/mnx-job-metric \
          btrbk-archive-to-new-storage "$rc" "$(( now - JOB_START ))" "$JOB_SKIPPED" "$JOB_REASON" || true
        exit "$rc"
      }
      trap finish_metric EXIT

      SOURCE_MOUNT=/mnt/m16-backup-nvme
      SOURCE="$SOURCE_MOUNT/btrbk-snapshots"
      DEST_MOUNT=/mnt/m16-new-storage
      DEST="$DEST_MOUNT/admin/backups"
      META="$DEST/.monsternix"
      LOCK=/run/storage-maintenance.lock

      #@MNX-PART id=60.10.btrbk-archive-to-new-storage.function.note kind=function title="Function note"
      note() {
        printf 'btrbk-archive-new-storage: %s\n' "$*"
        logger -t btrbk-archive-new-storage -p daemon.notice -- "$*" || true
      }

      #@MNX-PART id=60.10.btrbk-archive-to-new-storage.function.fail kind=function title="Function fail"
      fail() {
        if [ "$JOB_REASON" = none ]; then JOB_REASON=problem; fi
        printf 'btrbk-archive-new-storage: ERROR: %s\n' "$*" >&2
        logger -t btrbk-archive-new-storage -p daemon.err -- "$*" || true
        echo 'backup_notification=deferred-to-one-week-supervision' >&2
        exit 1
      }

      #@MNX-PART id=60.10.btrbk-archive-to-new-storage.function.stats_total kind=function title="Function stats_total"
      stats_total() {
        awk '$1 ~ /\]\./ { total += $2 + 0 } END { print total + 0 }'
      }

      #@MNX-PART id=60.10.btrbk-archive-to-new-storage.function.require_rw_btrfs_mount kind=function title="Function require_rw_btrfs_mount"
      require_rw_btrfs_mount() {
        mp="$1"
        mountpoint -q "$mp" || fail "$mp is not mounted"
        [ "$(findmnt -rn -T "$mp" -o FSTYPE)" = btrfs ] || \
          fail "$mp is not Btrfs"
        findmnt -rn -T "$mp" -o OPTIONS | grep -Eq '(^|,)rw(,|$)' || \
          fail "$mp is not mounted read-write"
      }

      exec 9<>"$LOCK"
      if ! flock -n -x 9; then
        JOB_SKIPPED=1
        JOB_REASON=lock-busy
        note "operator or another storage job owns $LOCK; skipping immediately so freshness can retry later"
        exit 0
      fi

      require_rw_btrfs_mount "$SOURCE_MOUNT"
      require_rw_btrfs_mount "$DEST_MOUNT"
      [ -d "$SOURCE" ] || fail "source directory is missing: $SOURCE"

      SOURCE_UUID="$(findmnt -rn -T "$SOURCE" -o UUID)"
      DEST_UUID="$(findmnt -rn -T "$DEST_MOUNT" -o UUID)"
      [ -n "$SOURCE_UUID" ] || fail "could not determine source filesystem UUID"
      [ -n "$DEST_UUID" ] || fail "could not determine destination filesystem UUID"
      [ "$SOURCE_UUID" != "$DEST_UUID" ] || \
        fail "source and destination resolve to the same Btrfs filesystem"

      SOURCE_COUNT="$(btrfs subvolume list -r -o "$SOURCE" | awk 'END { print NR + 0 }')"
      [ "$SOURCE_COUNT" -gt 0 ] || \
        fail "no read-only btrbk backup subvolumes were found below $SOURCE"

      DEST_PARENT="$(dirname "$DEST")"
      if [ ! -e "$DEST_PARENT" ]; then
        install -d -m 0750 -o root -g btrbk "$DEST_PARENT"
      fi
      [ -d "$DEST_PARENT" ] || fail "$DEST_PARENT exists but is not a directory"
      if [ ! -e "$DEST" ]; then
        note "creating destination subvolume $DEST"
        btrfs subvolume create "$DEST"
      fi
      [ -d "$DEST" ] || fail "$DEST exists but is not a directory"
      chown root:btrbk "$DEST"
      chmod 0750 "$DEST"

      AVAILABLE_BYTES="$(df -B1 --output=avail "$DEST_MOUNT" | tail -n 1 | tr -d '[:space:]')"
      [ -n "$AVAILABLE_BYTES" ] || fail "could not determine free space on $DEST_MOUNT"
      [ "$AVAILABLE_BYTES" -ge 10737418240 ] || \
        fail "$DEST_MOUNT has less than 10 GiB available"

      SOURCE_PRE_STATS="$(btrfs device stats "$SOURCE_MOUNT")" || \
        fail "could not read source Btrfs device counters"
      DEST_PRE_STATS="$(btrfs device stats "$DEST_MOUNT")" || \
        fail "could not read destination Btrfs device counters"
      SOURCE_PRE_TOTAL="$(printf '%s\n' "$SOURCE_PRE_STATS" | stats_total)"
      DEST_PRE_TOTAL="$(printf '%s\n' "$DEST_PRE_STATS" | stats_total)"

      if [ "$SOURCE_PRE_TOTAL" -gt 0 ]; then
        note "source has cumulative Btrfs device counters totalling $SOURCE_PRE_TOTAL; watching for an increase"
      fi
      if [ "$DEST_PRE_TOTAL" -gt 0 ]; then
        note "destination has cumulative Btrfs device counters totalling $DEST_PRE_TOTAL; watching for an increase"
      fi

      note "archiving $SOURCE to $DEST"
      btrbk -c /etc/btrbk/main.conf archive "$SOURCE" "$DEST"
      btrfs subvolume sync "$DEST_MOUNT"

      SOURCE_POST_STATS="$(btrfs device stats "$SOURCE_MOUNT")" || \
        fail "source Btrfs device counters became unreadable"
      DEST_POST_STATS="$(btrfs device stats "$DEST_MOUNT")" || \
        fail "destination Btrfs device counters became unreadable"
      SOURCE_POST_TOTAL="$(printf '%s\n' "$SOURCE_POST_STATS" | stats_total)"
      DEST_POST_TOTAL="$(printf '%s\n' "$DEST_POST_STATS" | stats_total)"

      [ "$SOURCE_POST_TOTAL" -le "$SOURCE_PRE_TOTAL" ] || \
        fail "source Btrfs device counters increased: $SOURCE_PRE_TOTAL -> $SOURCE_POST_TOTAL"
      [ "$DEST_POST_TOTAL" -le "$DEST_PRE_TOTAL" ] || \
        fail "destination Btrfs device counters increased: $DEST_PRE_TOTAL -> $DEST_POST_TOTAL"

      DEST_COUNT="$(btrfs subvolume list -r -o "$DEST" | awk 'END { print NR + 0 }')"
      [ "$DEST_COUNT" -gt 0 ] || \
        fail "archive completed but no read-only archive subvolumes were found below $DEST"

      LATEST="$(find "$DEST" -mindepth 1 -maxdepth 1 -type d -name 'home.*' -printf '%p\n' | LC_ALL=C sort | tail -n 1 || true)"
      [ -n "$LATEST" ] || fail "archive completed but no newest home archive path could be identified"

      install -d -m 0750 -o root -g btrbk "$META"
      REPORT_TMP="$META/last-success.txt.tmp"
      {
        echo "timestamp=$(date -Is)"
        echo "source=$SOURCE"
        echo "destination=$DEST"
        echo "source_filesystem_uuid=$SOURCE_UUID"
        echo "destination_filesystem_uuid=$DEST_UUID"
        echo "source_readonly_subvolumes=$SOURCE_COUNT"
        echo "destination_readonly_subvolumes=$DEST_COUNT"
        echo "latest_home_archive=$LATEST"
        echo "archive_retention=12w 24m 5y plus latest"
        echo "btrbk_version=$(btrbk --version | head -n 1)"
      } > "$REPORT_TMP"
      chown root:btrbk "$REPORT_TMP"
      chmod 0640 "$REPORT_TMP"
      mv -f "$REPORT_TMP" "$META/last-success.txt"

      install -m 0640 -o root -g btrbk \
        /etc/btrbk/main.conf "$META/btrbk-main.conf"
      install -m 0640 -o root -g btrbk \
        /etc/nixos/configuration.nix "$META/configuration.nix"
      if [ -f /var/lib/btrbk/main-transactions.log ]; then
        install -m 0640 -o root -g btrbk \
          /var/lib/btrbk/main-transactions.log "$META/main-transactions.log"
      fi
      btrbk -c /etc/btrbk/main.conf list all > "$META/btrbk-list.txt.tmp" || true
      chown root:btrbk "$META/btrbk-list.txt.tmp" 2>/dev/null || true
      chmod 0640 "$META/btrbk-list.txt.tmp" 2>/dev/null || true
      mv -f "$META/btrbk-list.txt.tmp" "$META/btrbk-list.txt" 2>/dev/null || true

      /etc/monsternix/bin/mnx-job-success \
        btrbk-archive-to-new-storage "$LATEST" "destination_count=$DEST_COUNT"
      note "archive completed successfully; $DEST_COUNT read-only subvolumes present"
    '';
  };

