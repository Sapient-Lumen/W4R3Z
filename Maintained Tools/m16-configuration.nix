#@MNX-DEF path=boot.extraModulePackages section=20.20 role=policy ordinal=013
  boot.extraModulePackages = with config.boot.kernelPackages; [
    v4l2loopback
  ];
#@MNX-DEF path=boot.kernelModules section=20.20 role=policy ordinal=014
  boot.kernelModules = [ "v4l2loopback" "kvm-amd" ];
#@MNX-DEF path=boot.extraModprobeConfig section=20.20 role=policy ordinal=015
  boot.extraModprobeConfig = ''
    options v4l2loopback devices=3 video_nr=2,3,4 card_label="Screen1","Screen2","Screen3" exclusive_caps=1
  '';

#@MNX-DEF path=boot.kernel.sysctl section=20.20 role=policy ordinal=016
  boot.kernel.sysctl = { 
    "fs.inotify.max_user_watches" = 10000000; # 524288 is recommended max, 2147483647 actual max
    "kernel.sysrq" = 244; # Sufficient REISUB

    # Hybrid zram + disk swap: make compressed swap useful before the machine is desperate.
    # 100 means anonymous and file-backed reclaim have equal nominal IO cost.
    "vm.swappiness" = 100;

    # Wake kswapd earlier so bursty allocations are less likely to fall into direct reclaim.
    # Units are 1/10000; 125 means 1.25% watermark spacing.
    "vm.watermark_scale_factor" = 125;
  }; 

