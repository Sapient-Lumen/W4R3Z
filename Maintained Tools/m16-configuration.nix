#@MNX-DEF path=systemd.services.mnx-listener-census section=40.31 role=service ordinal=175
  systemd.services.mnx-listener-census = {
    description = "Monsternix attributed listener census and source-policy comparison";
    wants = [ "network.target" ];
    after = [ "network.target" ];
    onFailure = [ "mnx-job-failure-notify@%n.service" ];
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Group = "logbook";
      UMask = "0027";
      StateDirectory = "logbook";
      StateDirectoryMode = "2750";
      Nice = 15;
      IOSchedulingClass = "idle";
      TimeoutStartSec = "5min";
      StandardOutput = "journal";
      StandardError = "journal";
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectSystem = "full";
      RestrictSUIDSGID = true;
      ReadWritePaths = [ "/var/lib/logbook" "/var/lib/monsternix/exposure" "/var/lib/node-exporter-textfile" ];
    };
    path = [ pkgs.bash pkgs.coreutils pkgs.gnugrep pkgs.gawk pkgs.iproute2 pkgs.python3 pkgs.rpcbind pkgs.systemd pkgs.util-linux ];
    script = ''
      set -Eeuo pipefail
      umask 027
      JOB_START="$(date +%s)"
      trap 'rc="$?"; /etc/monsternix/bin/mnx-job-metric mnx-listener-census "$rc" "$(( $(date +%s) - JOB_START ))" 0 none || true; exit "$rc"' EXIT

      /etc/monsternix/bin/mnx-exposure --config /run/current-system/configuration.nix capture --quiet
      SUMMARY="$(/etc/monsternix/bin/mnx-exposure summary)"
      printf '%s\n' "$SUMMARY"

      RESULT="$(printf '%s\n' "$SUMMARY" | awk -F= '$1 == "MNX_EXPOSURE" { print $2; exit }')"
      CHANGED="$(printf '%s\n' "$SUMMARY" | awk -F= '$1 == "stable_changed" { print $2; exit }')"
      CANONICAL="$(printf '%s\n' "$SUMMARY" | awk -F= '$1 == "canonical_listener_total" { print $2; exit }')"
      DUPLICATES="$(printf '%s\n' "$SUMMARY" | awk -F= '$1 == "duplicate_listener_row_total" { print $2; exit }')"
      UNDECLARED="$(printf '%s\n' "$SUMMARY" | awk -F= '$1 == "undeclared_listener_total" { print $2; exit }')"
      REVIEW="$(printf '%s\n' "$SUMMARY" | awk -F= '$1 == "review_listener_total" { print $2; exit }')"
      REVIEW_GROUPS="$(printf '%s\n' "$SUMMARY" | awk -F= '$1 == "review_group_total" { print $2; exit }')"
      AMBIGUOUS="$(printf '%s\n' "$SUMMARY" | awk -F= '$1 == "ambiguous_listener_total" { print $2; exit }')"
      FORBIDDEN="$(printf '%s\n' "$SUMMARY" | awk -F= '$1 == "forbidden_listener_total" { print $2; exit }')"
      MISSING="$(printf '%s\n' "$SUMMARY" | awk -F= '$1 == "missing_required_policy_total" { print $2; exit }')"
      RPCINFO_STATE="$(printf '%s\n' "$SUMMARY" | awk -F= '$1 == "rpcinfo_state" { print $2; exit }')"
      RPC_REGISTRY_SATISFIED="$(printf '%s\n' "$SUMMARY" | awk -F= '$1 == "rpc_registry_satisfied" { print $2; exit }')"
      RPC_ATTRIBUTED="$(printf '%s\n' "$SUMMARY" | awk -F= '$1 == "rpc_attributed_listener_total" { print $2; exit }')"
      FIREWALL_REQUIRED="$(printf '%s\n' "$SUMMARY" | awk -F= '$1 == "zone_firewall_required_total" { print $2; exit }')"
      ZONE_MISMATCH="$(printf '%s\n' "$SUMMARY" | awk -F= '$1 == "zone_mismatch_total" { print $2; exit }')"
      REPORT="$(printf '%s\n' "$SUMMARY" | sed -n 's/^latest_report=//p' | tail -n 1)"
      : "''${RESULT:=UNKNOWN}" "''${CHANGED:=0}" "''${CANONICAL:=0}" "''${DUPLICATES:=0}" \
        "''${UNDECLARED:=0}" "''${REVIEW:=0}" "''${REVIEW_GROUPS:=0}" "''${AMBIGUOUS:=0}" \
        "''${FORBIDDEN:=0}" "''${MISSING:=0}" "''${RPCINFO_STATE:=unknown}" \
        "''${RPC_REGISTRY_SATISFIED:=no}" "''${RPC_ATTRIBUTED:=0}" "''${FIREWALL_REQUIRED:=0}" "''${ZONE_MISMATCH:=0}" "''${REPORT:=unknown}"

      if [[ "$RPC_REGISTRY_SATISFIED" != yes || "$FORBIDDEN" =~ ^[1-9][0-9]*$ || "$AMBIGUOUS" =~ ^[1-9][0-9]*$ || "$MISSING" =~ ^[1-9][0-9]*$ ]]; then
        PRIORITY=4
      elif [[ "$CHANGED" == 1 || "$UNDECLARED" =~ ^[1-9][0-9]*$ || "$REVIEW" =~ ^[1-9][0-9]*$ || \
              "$FIREWALL_REQUIRED" =~ ^[1-9][0-9]*$ || "$ZONE_MISMATCH" =~ ^[1-9][0-9]*$ ]]; then
        PRIORITY=5
      else
        PRIORITY=6
      fi

      logger --journald <<JOURNAL_EOF || logger -t mnx-listener-census "Exposure census: $RESULT report=$REPORT" || true
MESSAGE_ID=6ee9b21d-4fc3-55e2-90ce-dfae9121f33b
PRIORITY=$PRIORITY
LOGBOOK_KIND=LISTENER_EXPOSURE_CENSUS
LOGBOOK_VER=4
MONSTERNIX_EXPOSURE_RESULT=$RESULT
LISTENER_CHANGED_STABLE=$CHANGED
CANONICAL_LISTENER_COUNT=$CANONICAL
DUPLICATE_LISTENER_ROW_COUNT=$DUPLICATES
UNDECLARED_LISTENER_COUNT=$UNDECLARED
REVIEW_LISTENER_COUNT=$REVIEW
REVIEW_GROUP_COUNT=$REVIEW_GROUPS
AMBIGUOUS_LISTENER_COUNT=$AMBIGUOUS
FORBIDDEN_LISTENER_COUNT=$FORBIDDEN
MISSING_REQUIRED_POLICY_COUNT=$MISSING
RPCINFO_STATE=$RPCINFO_STATE
RPC_REGISTRY_SATISFIED=$RPC_REGISTRY_SATISFIED
RPC_ATTRIBUTED_LISTENER_COUNT=$RPC_ATTRIBUTED
ZONE_FIREWALL_REQUIRED_COUNT=$FIREWALL_REQUIRED
ZONE_MISMATCH_COUNT=$ZONE_MISMATCH
BUNDLE_PATH=$REPORT
MESSAGE=Exposure census: $RESULT; canonical=$CANONICAL duplicates=$DUPLICATES undeclared=$UNDECLARED review=$REVIEW review_groups=$REVIEW_GROUPS rpcinfo=$RPCINFO_STATE rpc_satisfied=$RPC_REGISTRY_SATISFIED rpc_attributed=$RPC_ATTRIBUTED firewall_required=$FIREWALL_REQUIRED zone_mismatch=$ZONE_MISMATCH; see $REPORT
JOURNAL_EOF

      if [[ "$RPC_REGISTRY_SATISFIED" != yes ]]; then
        printf 'MNX_EXPOSURE_RPCINFO_ERROR: RPC registry evidence is incomplete: rpcinfo_state=%s\n' "$RPCINFO_STATE" >&2
        exit 1
      fi
    '';
  };


#@MNX-DEF path=systemd.timers.mnx-listener-census section=40.31 role=timer ordinal=176
  systemd.timers.mnx-listener-census = {
    description = "Run Monsternix listener census";
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnBootSec = "5min";
      OnUnitActiveSec = "1h";
      RandomizedDelaySec = "2min";
      Persistent = false;
      Unit = "mnx-listener-census.service";
    };
  };

#@MNX-CHUNK id=40.32 slug=timer-census-metric-reconcile title="Timer census and active-metric reconciliation"
#@MNX-DEF path=systemd.services.mnx-timer-census section=40.32 role=service ordinal=177
  systemd.services.mnx-timer-census = {
    description = "Monsternix timer/path census";
    wants = [ "local-fs.target" ];
    after = [ "local-fs.target" ];
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Group = "logbook";
      UMask = "0027";
      StateDirectory = "logbook";
      StateDirectoryMode = "2750";
      Nice = 15;
      IOSchedulingClass = "idle";
      StandardOutput = "journal";
      StandardError = "journal";
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectSystem = "full";
      RestrictSUIDSGID = true;
      ReadWritePaths = [ "/var/lib/logbook" "/var/lib/node-exporter-textfile" ];
    };
    path = [ pkgs.coreutils pkgs.gnugrep pkgs.gawk pkgs.findutils pkgs.systemd ];
    script = ''
      set -euo pipefail
      umask 027

      TS="$(date -Is)"
      SAFE_TS="$(date +%Y%m%dT%H%M%S)"
      MODE="$(cat /run/monsternix/mode 2>/dev/null || tr -d '\r\n' < /etc/monsternix/mode 2>/dev/null || echo normal)"
      [ -n "$MODE" ] || MODE=normal
      ROOT="/var/lib/logbook/timers"
      OUT="$ROOT/timers-$SAFE_TS.txt"
      PROM_TMP="/var/lib/node-exporter-textfile/monsternix_timers.prom.$$"
      PROM="/var/lib/node-exporter-textfile/monsternix_timers.prom"

      install -d -m 2750 -o root -g logbook "$ROOT"
      install -d -m 0755 -o root -g root /var/lib/node-exporter-textfile

      {
        echo "=== MONSTERNIX TIMER CENSUS ($TS) ==="
        echo "mode=$MODE"
        echo "boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
        echo ""
        echo "== failed units =="
        systemctl --failed --no-pager || true
        echo ""
        echo "== timers =="
        systemctl list-timers --all --no-pager || true
        echo ""
        echo "== path units =="
        systemctl list-units --type=path --all --no-pager || true
        echo ""
        echo "== monsternix-related units =="
        systemctl list-units --all --no-pager | grep -E 'mnx-|monsternix|logbook|btrbk|duperemove|rsync-m16|hypertext-i2p|archiver|savetrail|wol-tcsn|nix-result' || true
      } > "$OUT"

      TIMER_COUNT="$(systemctl list-timers --all --no-legend --no-pager 2>/dev/null | awk 'NF { c++ } END { print c + 0 }')"
      FAILED_COUNT="$(systemctl --failed --no-legend --no-pager 2>/dev/null | awk 'NF { c++ } END { print c + 0 }')"
      chown root:logbook "$OUT" 2>/dev/null || true
      chmod 0640 "$OUT" 2>/dev/null || true

      cat > "$PROM_TMP" <<EOF
# HELP monsternix_systemd_timer_count Count of systemd timers currently known.
# TYPE monsternix_systemd_timer_count gauge
monsternix_systemd_timer_count $TIMER_COUNT
# HELP monsternix_systemd_failed_units Count of currently failed systemd units.
# TYPE monsternix_systemd_failed_units gauge
monsternix_systemd_failed_units $FAILED_COUNT
EOF
      chmod 0644 "$PROM_TMP" 2>/dev/null || true
      mv -f "$PROM_TMP" "$PROM"
      chmod 0644 "$PROM" 2>/dev/null || true

      find "$ROOT" -maxdepth 1 -type f -name 'timers-*.txt' -mtime +45 -delete 2>/dev/null || true
      /etc/monsternix/bin/mnx-job-metric mnx-timer-census 0 0 0 none || true
    '';
  };

#@MNX-DEF path=systemd.timers.mnx-timer-census section=40.32 role=timer ordinal=178
  systemd.timers.mnx-timer-census = {
    description = "Run Monsternix timer census";
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnBootSec = "6min";
      OnCalendar = "*-*-* 05:30:00";
      RandomizedDelaySec = "10min";
      Persistent = false;
      Unit = "mnx-timer-census.service";
    };
  };


#@MNX-DEF path=systemd.services.mnx-metric-reconcile section=40.32 role=service ordinal=179
  systemd.services.mnx-metric-reconcile = {
    description = "Archive legacy Monsternix active metrics and refresh current health state";
    wantedBy = [ "multi-user.target" ];
    wants = [ "mnx-storage-health.service" ];
    before = [ "mnx-storage-health.service" ];
    after = [ "local-fs.target" ];
    onFailure = [ "mnx-job-failure-notify@%n.service" ];
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Group = "logbook";
      UMask = "0027";
      Nice = 19;
      IOSchedulingClass = "idle";
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectSystem = "full";
      ProtectHome = "read-only";
      RestrictSUIDSGID = true;
      ReadWritePaths = [
        "/var/lib/logbook"
        "/var/lib/monsternix"
        "/var/lib/node-exporter-textfile"
      ];
      StandardOutput = "journal";
      StandardError = "journal";
      ExecStart = "/etc/monsternix/bin/mnx-metric-reconcile";
    };
    path = [
      pkgs.bash
      pkgs.coreutils
      pkgs.findutils
      pkgs.gnugrep
      pkgs.gnused
      pkgs.util-linux
    ];
  };

  ### mnx-storage-health: independent storage/swap/metrics snapshot ###
#@MNX-CHUNK id=40.33 slug=storage-health-swap-audit title="Storage health and backup-NVMe swap audits"
#@MNX-DEF path=systemd.services.mnx-storage-health section=40.33 role=service ordinal=180
  systemd.services.mnx-storage-health = {
    description = "Monsternix storage health snapshot and notification";
    wants = [ "local-fs.target" ];
    after = [ "local-fs.target" "mnx-metric-reconcile.service" ];
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Group = "logbook";
      UMask = "0027";
      StateDirectoryMode = "2750";
      StateDirectory = "logbook";
      Nice = 15;
      IOSchedulingClass = "idle";
      StandardOutput = "journal";
      StandardError = "journal";
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectSystem = "full";
      RestrictSUIDSGID = true;
      ReadWritePaths = [ "/var/lib/logbook" "/var/lib/node-exporter-textfile" ];
    };
    path = [
      pkgs.coreutils
      pkgs.gnugrep
      pkgs.gawk
      pkgs.gnused
      pkgs.findutils
      pkgs.util-linux
      pkgs.systemd
      pkgs.btrfs-progs
      pkgs.nvme-cli
      pkgs.smartmontools
    ];
    script = ''
      set -euo pipefail
      umask 027

      TS="$(date -Is)"
      NOW_EPOCH="$(date +%s)"
      SAFE_TS="$(date +%Y%m%dT%H%M%S)"
      OUT="/var/lib/logbook/daily/storage-health-$SAFE_TS.txt"
      PROM_TMP="/var/lib/node-exporter-textfile/monsternix_storage.prom.$$"
      PROM="/var/lib/node-exporter-textfile/monsternix_storage.prom"
      PROBLEM=0
      WARN=0
      ADVISORY=0
      STORAGE_HISTORY=0
      MEMORY_SEEN=0
      BTRFS_BASELINE_PROBLEM=0
      BTRFS_BASELINE_ADVISORY=0

      mkdir -p /var/lib/logbook/daily /var/lib/logbook/state /var/lib/node-exporter-textfile
      chown root:logbook /var/lib/logbook /var/lib/logbook/daily /var/lib/logbook/state 2>/dev/null || true
      chmod 2750 /var/lib/logbook /var/lib/logbook/daily /var/lib/logbook/state 2>/dev/null || true

      echo "=== MONSTERNIX STORAGE HEALTH ($TS) ===" > "$OUT"
      echo "observation_epoch=$NOW_EPOCH" >> "$OUT"
      echo "# HELP monsternix_storage_health_observation_timestamp_seconds Unix timestamp of the current storage-health observation." > "$PROM_TMP"
      echo "# TYPE monsternix_storage_health_observation_timestamp_seconds gauge" >> "$PROM_TMP"
      echo "monsternix_storage_health_observation_timestamp_seconds $NOW_EPOCH" >> "$PROM_TMP"
      echo "# MNX_STORAGE_REPORT=storage-health-$SAFE_TS.txt" >> "$PROM_TMP"
      echo "# HELP monsternix_btrfs_device_errors Btrfs device error counters by mount and kind" >> "$PROM_TMP"
      echo "# TYPE monsternix_btrfs_device_errors gauge" >> "$PROM_TMP"

      echo "== Mounts ==" >> "$OUT"
      (findmnt -a || true) >> "$OUT"
      echo "" >> "$OUT"

      echo "== Swap ==" >> "$OUT"
      (cat /proc/swaps || true) >> "$OUT"
      OVERFLOW_SWAP="/mnt/m16-backup-nvme/swap/swapfile"
      OVERFLOW_SWAP_USED_BYTES="$(swapon --noheadings --bytes --show=NAME,USED 2>/dev/null | awk -v s="$OVERFLOW_SWAP" '$1 == s { print $2; found=1 } END { if (!found) print -1 }')"
      # Detailed overflow-swap metrics are emitted by mnx-swapfile-audit into
      # monsternix_swapfile.prom. Keep duplicates out of monsternix_storage.prom.
      if [ "$OVERFLOW_SWAP_USED_BYTES" -lt 0 ] 2>/dev/null; then
        WARN=1
        echo "WARN: backup-NVMe 128 GiB Btrfs overflow swap is not active" >> "$OUT"
      elif [ "$OVERFLOW_SWAP_USED_BYTES" -gt 0 ] 2>/dev/null; then
        echo "INFO: backup-NVMe overflow swap currently has $OVERFLOW_SWAP_USED_BYTES bytes in use (normal)" >> "$OUT"
      fi
      echo "" >> "$OUT"

      for mp in / /mnt/m16-backup-nvme /mnt/m16-new-storage /mnt/m16-old-storage; do
        if findmnt -rn "$mp" >/dev/null 2>&1; then
          echo "== btrfs device stats $mp ==" >> "$OUT"
          STATS="$(btrfs device stats "$mp" 2>&1 || true)"
          printf "%s\n" "$STATS" >> "$OUT"
          printf "%s\n" "$STATS" | awk -v mp="$mp" '
            $1 ~ /\]\./ {
              kind=$1
              sub(/^.*\]\./, "", kind)
              value=$2 + 0
              gsub(/\\/, "\\\\", mp)
              gsub(/"/, "\\\"", mp)
              printf "monsternix_btrfs_device_errors{mount=\"%s\",kind=\"%s\"} %d\n", mp, kind, value
            }
          ' >> "$PROM_TMP"
          echo "" >> "$OUT"
        fi
      done

      echo "== Btrfs pinned baseline comparison ==" >> "$OUT"
      set +e
      if [ -L /var/lib/monsternix/btrfs-baselines/pinned ]; then
        BTRFS_BASELINE_OUTPUT="$(/etc/monsternix/bin/mnx-btrfs-baseline compare pinned 2>&1)"
        BTRFS_BASELINE_RC="$?"
      else
        BTRFS_BASELINE_OUTPUT="$(/etc/monsternix/bin/mnx-btrfs-baseline check-zero 2>&1)"
        BTRFS_BASELINE_RC="$?"
      fi
      set -e
      printf "%s\n" "$BTRFS_BASELINE_OUTPUT" >> "$OUT"
      if [ "$BTRFS_BASELINE_RC" -ne 0 ]; then
        PROBLEM=1
        BTRFS_BASELINE_PROBLEM=1
        echo "CRIT: Btrfs device-counter baseline comparison failed" >> "$OUT"
      elif printf "%s\n" "$BTRFS_BASELINE_OUTPUT" | grep -q '^ADVISORY:'; then
        ADVISORY=1
        BTRFS_BASELINE_ADVISORY=1
        echo "INFO: Btrfs baseline contains unchanged historical nonzero or reset/decreased counters" >> "$OUT"
      fi
      echo "" >> "$OUT"

      echo "== NVMe health ==" >> "$OUT"
      (nvme list || true) >> "$OUT"
      echo "# HELP monsternix_nvme_temperature_celsius NVMe composite temperature in Celsius" >> "$PROM_TMP"
      echo "# TYPE monsternix_nvme_temperature_celsius gauge" >> "$PROM_TMP"
      echo "# HELP monsternix_nvme_critical_warning NVMe SMART critical_warning value" >> "$PROM_TMP"
      echo "# TYPE monsternix_nvme_critical_warning gauge" >> "$PROM_TMP"
      TEMP_STATE="/var/lib/logbook/state/nvme-temps-last"
      TEMP_STATE_NEW="/var/lib/logbook/state/nvme-temps-last.new"
      : > "$TEMP_STATE_NEW"
      for nd in /dev/nvme0 /dev/nvme1; do
        [ -e "$nd" ] || continue
        echo "" >> "$OUT"
        echo "== nvme smart-log $nd ==" >> "$OUT"
        SMART="$(nvme smart-log "$nd" 2>&1 || true)"
        printf "%s\n" "$SMART" >> "$OUT"
        DEV_LABEL="$(basename "$nd")"
        CRIT_WARN_RAW="$(printf "%s\n" "$SMART" | awk -F: 'tolower($1) ~ /critical_warning|critical warning/ { gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2; exit }')"
        case "$CRIT_WARN_RAW" in
          "")
            CRIT_WARN=1
            PROBLEM=1
            echo "CRIT: unable to read $DEV_LABEL SMART critical_warning" >> "$OUT"
            ;;
          0|0x0|0x00|0x00000000)
            CRIT_WARN=0
            ;;
          0x[0-9A-Fa-f]*)
            CRIT_WARN=$((CRIT_WARN_RAW))
            PROBLEM=1
            echo "CRIT: $DEV_LABEL SMART critical_warning is $CRIT_WARN_RAW" >> "$OUT"
            ;;
          *[!0-9]*)
            CRIT_WARN=1
            PROBLEM=1
            echo "CRIT: unreadable $DEV_LABEL SMART critical_warning value: $CRIT_WARN_RAW" >> "$OUT"
            ;;
          *)
            CRIT_WARN="$CRIT_WARN_RAW"
            if [ "$CRIT_WARN" -ne 0 ] 2>/dev/null; then
              PROBLEM=1
              echo "CRIT: $DEV_LABEL SMART critical_warning is $CRIT_WARN" >> "$OUT"
            fi
            ;;
        esac
        echo "monsternix_nvme_critical_warning{device=\"$DEV_LABEL\"} $CRIT_WARN" >> "$PROM_TMP"
        TEMP_K="$(printf "%s\n" "$SMART" | sed -n 's/.*(\([0-9][0-9]*\) K).*/\1/p' | head -n1)"
        TEMP_C=""
        if [ -n "$TEMP_K" ]; then
          TEMP_C=$((TEMP_K - 273))
        else
          TEMP_C="$(printf "%s\n" "$SMART" | sed -n 's/.*temperature[[:space:]]*:[[:space:]]*\([0-9][0-9]*\)[[:space:]]*C.*/\1/ip' | head -n1)"
        fi
        if [ -n "$TEMP_C" ]; then
          echo "monsternix_nvme_temperature_celsius{device=\"$DEV_LABEL\"} $TEMP_C" >> "$PROM_TMP"
          echo "$DEV_LABEL $TEMP_C" >> "$TEMP_STATE_NEW"
          if [ "$TEMP_C" -ge 80 ] 2>/dev/null; then
            PROBLEM=1
            echo "CRIT: $DEV_LABEL temperature is ''${TEMP_C}C" >> "$OUT"
          elif [ "$TEMP_C" -ge 70 ] 2>/dev/null; then
            WARN=1
            echo "WARN: $DEV_LABEL temperature is ''${TEMP_C}C" >> "$OUT"
          fi
          if [ -f "$TEMP_STATE" ]; then
            PREV_TEMP="$(awk -v d="$DEV_LABEL" '$1 == d { print $2; found=1 } END { if (!found) print "" }' "$TEMP_STATE" 2>/dev/null || true)"
            if [ -n "$PREV_TEMP" ]; then
              DELTA=$(( TEMP_C - PREV_TEMP ))
              [ "$DELTA" -lt 0 ] && DELTA=$(( 0 - DELTA ))
              if [ "$DELTA" -ge 10 ] 2>/dev/null; then
                WARN=1
                echo "WARN: $DEV_LABEL temperature changed from ''${PREV_TEMP}C to ''${TEMP_C}C since the last health run" >> "$OUT"
              fi
            fi
          fi
        fi
      done
      mv -f "$TEMP_STATE_NEW" "$TEMP_STATE" 2>/dev/null || true
      echo "" >> "$OUT"

      echo "== Failed units (global report; only storage-related failures affect this monitor) ==" >> "$OUT"
      FAILED_UNITS="$(systemctl --failed --no-legend --plain 2>/dev/null || true)"
      if [ -n "$FAILED_UNITS" ]; then
        printf "%s\n" "$FAILED_UNITS" >> "$OUT"
      else
        echo "none" >> "$OUT"
      fi
      STORAGE_FAILED_UNITS="$(printf "%s\n" "$FAILED_UNITS" | grep -E -i 'duperemove|btrfs-scrub|fstrim|mnx-storage-catchup|mnx-swapfile-audit|mnt-m16.*mount' || true)"
      if [ -n "$STORAGE_FAILED_UNITS" ]; then
        PROBLEM=1
        echo "CRIT: one or more storage-related systemd units are failed" >> "$OUT"
        printf "%s\n" "$STORAGE_FAILED_UNITS" >> "$OUT"
      fi
      echo "" >> "$OUT"

      STORAGE_RE='Read-error on swap-device|I/O error|Input/output error|blk_update_request|Buffer I/O error|rejecting I/O|resetting link|hard resetting link|SATA link down|nvme.*timeout|nvme.*controller.*down|nvme.*reset|Identify namespace failed|Device not ready|Disabling device after reset failure|CSTS|BTRFS.*(error|warning)|checksum verify failed|csum failed|transaction aborted|parent transid verify failed|read-only.*due to|read-only file system|AER:.*(Fatal|Uncorrected)|medium error|uncorrectable'
      MEMORY_RE='Out of memory|oom-kill|Killed process|Memory cgroup out of memory|systemd-oomd|earlyoom.*(sending|killing)'

      echo "== Storage incident strings (all boots, 24h, report-only; incident scanner owns event alerts) ==" >> "$OUT"
      STORAGE_EVENTS="$(journalctl --since '24 hours ago' -p warning..alert --no-pager 2>/dev/null | grep -E -i "$STORAGE_RE" | tail -n 120 || true)"
      if [ -n "$STORAGE_EVENTS" ]; then
        STORAGE_HISTORY=1
        printf "%s\n" "$STORAGE_EVENTS" >> "$OUT"
      else
        echo "none" >> "$OUT"
      fi
      echo "" >> "$OUT"

      echo "== Memory-pressure incident strings (current boot, 24h, report-only; incident scanner owns event alerts) ==" >> "$OUT"
      MEMORY_EVENTS="$(journalctl -b --since '24 hours ago' -p warning..alert --no-pager 2>/dev/null | grep -E -i "$MEMORY_RE" | tail -n 120 || true)"
      if [ -n "$MEMORY_EVENTS" ]; then
        MEMORY_SEEN=1
        printf "%s\n" "$MEMORY_EVENTS" >> "$OUT"
        echo "INFO: memory-pressure evidence does not set the storage critical metric; logbook-incident-scan owns new-event notification" >> "$OUT"
      else
        echo "none" >> "$OUT"
      fi

      echo "" >> "$OUT"
      DIRECT_STORAGE_WARN=$WARN
      echo "== Backup freshness and catch-up state ==" >> "$OUT"
      FRESHNESS=/var/lib/logbook/backups/freshness-current.txt
      if [ -s "$FRESHNESS" ]; then
        cat "$FRESHNESS" >> "$OUT"
        NEWER_SUCCESS="$(find /var/lib/monsternix/job-state/authoritative -maxdepth 1 -type f -name '*.last-success' -newer "$FRESHNESS" -print -quit 2>/dev/null || true)"
        if [ -n "$NEWER_SUCCESS" ]; then
          echo "INFO: cached freshness report is superseded by a newer success marker; deferring stale alert until the next catch-up evaluation" >> "$OUT"
        else
          FRESH_STALE="$(awk -F= '$1 == "overall_stale" { print $2; exit }' "$FRESHNESS" 2>/dev/null || true)"
          FRESH_CRITICAL="$(awk -F= '$1 == "overall_critical" { print $2; exit }' "$FRESHNESS" 2>/dev/null || true)"
          [ -n "$FRESH_STALE" ] || FRESH_STALE=0
          [ -n "$FRESH_CRITICAL" ] || FRESH_CRITICAL=0
          if [ "$FRESH_CRITICAL" -gt 0 ] 2>/dev/null; then
            WARN=1
            echo "CRIT: one or more essential backup flows are critically stale" >> "$OUT"
            echo "INFO: backup deadline evidence is separate from physical storage faults; the freshness controller owns its critical notification" >> "$OUT"
          elif [ "$FRESH_STALE" -gt 0 ] 2>/dev/null; then
            WARN=1
            echo "WARN: one or more essential backup flows are stale and queued for catch-up" >> "$OUT"
          fi
        fi
      else
        echo "not yet available; mnx-storage-catchup writes this about 45 minutes after timer activation" >> "$OUT"
      fi
      echo "" >> "$OUT"

      echo "# HELP monsternix_storage_health_problem 1 if current storage state has a critical problem" >> "$PROM_TMP"
      echo "# TYPE monsternix_storage_health_problem gauge" >> "$PROM_TMP"
      echo "monsternix_storage_health_problem $PROBLEM" >> "$PROM_TMP"
      echo "# HELP monsternix_storage_health_warning 1 if current storage state has a warning" >> "$PROM_TMP"
      echo "# TYPE monsternix_storage_health_warning gauge" >> "$PROM_TMP"
      echo "monsternix_storage_health_warning $WARN" >> "$PROM_TMP"
      echo "# HELP monsternix_storage_health_advisory 1 if report-only storage evidence needs review but is not a current problem" >> "$PROM_TMP"
      echo "# TYPE monsternix_storage_health_advisory gauge" >> "$PROM_TMP"
      echo "monsternix_storage_health_advisory $ADVISORY" >> "$PROM_TMP"
      echo "# HELP monsternix_storage_health_history_problem 1 if report-only storage incident strings were found in the last 24h" >> "$PROM_TMP"
      echo "# TYPE monsternix_storage_health_history_problem gauge" >> "$PROM_TMP"
      echo "monsternix_storage_health_history_problem $STORAGE_HISTORY" >> "$PROM_TMP"
      echo "# HELP monsternix_memory_pressure_seen_last_24h 1 if report-only OOM or memory-pressure evidence exists in the current boot window" >> "$PROM_TMP"
      echo "# TYPE monsternix_memory_pressure_seen_last_24h gauge" >> "$PROM_TMP"
      echo "monsternix_memory_pressure_seen_last_24h $MEMORY_SEEN" >> "$PROM_TMP"
      echo "# HELP monsternix_btrfs_baseline_problem 1 if the pinned per-device counter comparison failed" >> "$PROM_TMP"
      echo "# TYPE monsternix_btrfs_baseline_problem gauge" >> "$PROM_TMP"
      echo "monsternix_btrfs_baseline_problem $BTRFS_BASELINE_PROBLEM" >> "$PROM_TMP"
      echo "# HELP monsternix_btrfs_baseline_advisory 1 if unchanged historical nonzero or reset/decreased counters were observed" >> "$PROM_TMP"
      echo "# TYPE monsternix_btrfs_baseline_advisory gauge" >> "$PROM_TMP"
      echo "monsternix_btrfs_baseline_advisory $BTRFS_BASELINE_ADVISORY" >> "$PROM_TMP"
      chmod 0644 "$PROM_TMP" 2>/dev/null || true
      mv -f "$PROM_TMP" "$PROM"
      chmod 0644 "$PROM" 2>/dev/null || true
      /etc/monsternix/bin/mnx-job-metric mnx-storage-health 0 0 0 none || true

      NOTIFY_STATE=/var/lib/logbook/state/storage-health-notify-state
      NOTIFY_TMP="$NOTIFY_STATE.$$"
      NOTIFY_EVIDENCE="$(grep -E '^(CRIT|WARN|FAIL|ADVISORY):' "$OUT" || true)"
      NOTIFY_SIGNATURE="$(printf 'problem=%s\nwarning=%s\n%s\n' "$PROBLEM" "$WARN" "$NOTIFY_EVIDENCE" | sha256sum | awk '{print $1}')"
      PREVIOUS_NOTIFY_STATE="$(cat "$NOTIFY_STATE" 2>/dev/null || true)"
      NOTIFY_ACTION=none-healthy
      NOTIFY_LEVEL=healthy
      UPDATE_NOTIFY_STATE=1

      if [ "$PROBLEM" -eq 1 ]; then
        NOTIFY_LEVEL=critical
        if [ "$PREVIOUS_NOTIFY_STATE" = "$NOTIFY_LEVEL:$NOTIFY_SIGNATURE" ]; then
          NOTIFY_ACTION=suppressed-unchanged
        elif /etc/monsternix/bin/mnx-notify critical "Monsternix storage health problem" "See $OUT"; then
          NOTIFY_ACTION=sent
        else
          NOTIFY_ACTION=failed
          UPDATE_NOTIFY_STATE=0
        fi
      elif [ "$WARN" -eq 1 ] && [ "$DIRECT_STORAGE_WARN" -eq 1 ]; then
        NOTIFY_LEVEL=warning
        if [ "$PREVIOUS_NOTIFY_STATE" = "$NOTIFY_LEVEL:$NOTIFY_SIGNATURE" ]; then
          NOTIFY_ACTION=suppressed-unchanged
        elif /etc/monsternix/bin/mnx-notify warning "Monsternix storage health warning" "See $OUT"; then
          NOTIFY_ACTION=sent
        else
          NOTIFY_ACTION=failed
          UPDATE_NOTIFY_STATE=0
        fi
      fi

      if [ "$UPDATE_NOTIFY_STATE" -eq 1 ]; then
        printf '%s:%s\n' "$NOTIFY_LEVEL" "$NOTIFY_SIGNATURE" > "$NOTIFY_TMP"
        chown root:logbook "$NOTIFY_TMP"
        chmod 0640 "$NOTIFY_TMP"
        mv -f "$NOTIFY_TMP" "$NOTIFY_STATE"
      else
        rm -f "$NOTIFY_TMP"
      fi

      echo "storage_health_notification_level=$NOTIFY_LEVEL" >> "$OUT"
      echo "storage_health_notification_action=$NOTIFY_ACTION" >> "$OUT"
      echo "storage_health_notification_signature=$NOTIFY_SIGNATURE" >> "$OUT"

      logger --journald <<EOF || logger -t mnx-storage-health "Storage health snapshot written to $OUT" || true
MESSAGE_ID=38ef6264-4f38-5c81-b028-5c285b5a9c9f
PRIORITY=5
LOGBOOK_KIND=STORAGE_HEALTH_SNAPSHOT
LOGBOOK_VER=1
BUNDLE_PATH=$OUT
MESSAGE=Storage health snapshot written to $OUT
EOF
    '';
  };

#@MNX-DEF path=systemd.timers.mnx-storage-health section=40.33 role=timer ordinal=181
  systemd.timers.mnx-storage-health = {
    description = "Run Monsternix storage health snapshot within officer freshness budget";
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnBootSec = "20min";
      OnCalendar = "*-*-* 00/2:30:00";
      RandomizedDelaySec = "5min";
      Persistent = false;
    };
  };


  ### mnx-swapfile-audit: independent 128 GiB backup-NVMe Btrfs overflow-swap verifier ###
#@MNX-DEF path=systemd.services.mnx-swapfile-audit section=40.33 role=service ordinal=182
  systemd.services.mnx-swapfile-audit = {
    description = "Audit 128 GiB backup-NVMe Btrfs overflow swapfile";
    wants = [ "local-fs.target" ];
    after = [ "local-fs.target" ];
    onFailure = [ "mnx-job-failure-notify@%n.service" ];
    unitConfig = {
      ConditionPathIsMountPoint = "/mnt/m16-new-storage";
      RequiresMountsFor = [ "/mnt/m16-new-storage" ];
    };
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Group = "logbook";
      UMask = "0027";
      StateDirectory = "logbook";
      StateDirectoryMode = "2750";
      Nice = 15;
      IOSchedulingClass = "idle";
      NoNewPrivileges = true;
      PrivateTmp = true;
      LockPersonality = true;
      RestrictRealtime = true;
      ProtectSystem = "full";
      RestrictSUIDSGID = true;
      ReadWritePaths = [ "/var/lib/logbook" "/var/lib/node-exporter-textfile" ];
      StandardOutput = "journal";
      StandardError = "journal";
    };
    path = [
      pkgs.coreutils
      pkgs.gnugrep
      pkgs.gawk
      pkgs.gnused
      pkgs.util-linux
      pkgs.systemd
      pkgs.btrfs-progs
      pkgs.e2fsprogs
    ];
    script = ''
      set -euo pipefail
      umask 027
      START_EPOCH="$(date +%s)"
      MNX_JOB_REASON=none
      trap 'rc="$?"; dur=$(( $(date +%s) - START_EPOCH )); /etc/monsternix/bin/mnx-job-metric mnx-swapfile-audit "$rc" "$dur" 0 "$MNX_JOB_REASON" || true' EXIT

      TS="$(date -Is)"
      SAFE_TS="$(date +%Y%m%dT%H%M%S)"
      OUT="/var/lib/logbook/daily/swapfile-audit-$SAFE_TS.txt"
      PROM_TMP="/var/lib/node-exporter-textfile/monsternix_swapfile.prom.$$"
      PROM="/var/lib/node-exporter-textfile/monsternix_swapfile.prom"
      TARGET="/mnt/m16-backup-nvme"
      SWAPFILE="$TARGET/swap/swapfile"
      EXPECTED_BYTES=$((128 * 1024 * 1024 * 1024))
      PROBLEM=0
      WARN=0
      ACTIVE=0
      USED_BYTES=-1
      PRIO=-999
      SIZE_BYTES=-1
      ALLOC_BYTES=-1

      mkdir -p /var/lib/logbook/daily /var/lib/node-exporter-textfile
      chown root:logbook /var/lib/logbook /var/lib/logbook/daily 2>/dev/null || true
      chmod 2750 /var/lib/logbook /var/lib/logbook/daily 2>/dev/null || true

      echo "=== MONSTERNIX BACKUP-NVME BTRFS SWAPFILE AUDIT ($TS) ===" > "$OUT"
      echo "swapfile: $SWAPFILE" >> "$OUT"
      echo "expected_bytes: $EXPECTED_BYTES" >> "$OUT"

      if [ ! -e "$SWAPFILE" ]; then
        PROBLEM=1
        echo "CRIT: swapfile is missing" >> "$OUT"
      else
        SIZE_BYTES="$(stat -c %s "$SWAPFILE" 2>/dev/null || echo -1)"
        BLOCKS="$(stat -c %b "$SWAPFILE" 2>/dev/null || echo -1)"
        if [ "$BLOCKS" -ge 0 ] 2>/dev/null; then ALLOC_BYTES=$((BLOCKS * 512)); fi
        echo "size_bytes: $SIZE_BYTES" >> "$OUT"
        echo "allocated_bytes: $ALLOC_BYTES" >> "$OUT"

        if [ "$SIZE_BYTES" -ne "$EXPECTED_BYTES" ] 2>/dev/null; then
          PROBLEM=1
          echo "CRIT: expected exactly $EXPECTED_BYTES bytes (128 GiB), found $SIZE_BYTES" >> "$OUT"
        fi
      fi

      echo "" >> "$OUT"
      echo "== Mount for swapfile ==" >> "$OUT"
      (findmnt -T "$SWAPFILE" || true) >> "$OUT"
      FSTYPE="$(findmnt -rn -T "$SWAPFILE" -o FSTYPE 2>/dev/null || true)"
      if [ "$FSTYPE" != "btrfs" ]; then
        PROBLEM=1
        echo "CRIT: expected Btrfs backing filesystem, found ''${FSTYPE:-unknown}" >> "$OUT"
      fi

      echo "" >> "$OUT"
      echo "== Btrfs map-swapfile verification ==" >> "$OUT"
      if [ -e "$SWAPFILE" ]; then
        if ! btrfs inspect-internal map-swapfile "$SWAPFILE" >> "$OUT" 2>&1; then
          PROBLEM=1
          echo "CRIT: map-swapfile rejected the file; it may have holes, CoW/compression, or an unsupported extent layout" >> "$OUT"
        fi
      fi

      echo "" >> "$OUT"
      echo "== Swapfile attributes ==" >> "$OUT"
      if [ -e "$SWAPFILE" ]; then
        ATTRS="$(lsattr -d "$SWAPFILE" 2>&1 || true)"
        printf '%s\n' "$ATTRS" >> "$OUT"
        if ! printf '%s\n' "$ATTRS" | grep -q 'C'; then
          WARN=1
          echo "WARN: lsattr did not show NOCOW C; map-swapfile above is authoritative" >> "$OUT"
        fi
        (btrfs property get -t inode "$SWAPFILE" compression || true) >> "$OUT"
      fi

      echo "" >> "$OUT"
      echo "== Swap signature ==" >> "$OUT"
      SWAP_TYPE="$(blkid -p -s TYPE -o value "$SWAPFILE" 2>/dev/null || true)"
      echo "TYPE=''${SWAP_TYPE:-unknown}" >> "$OUT"
      if [ "$SWAP_TYPE" != "swap" ]; then
        PROBLEM=1
        echo "CRIT: blkid did not find a swap signature" >> "$OUT"
      fi

      echo "" >> "$OUT"
      echo "== Backup-NVMe Btrfs usage/profile ==" >> "$OUT"
      USAGE="$(btrfs filesystem usage "$TARGET" 2>&1 || true)"
      printf '%s\n' "$USAGE" >> "$OUT"
      if ! printf '%s\n' "$USAGE" | grep -q 'Data,single'; then
        PROBLEM=1
        echo "CRIT: expected a Btrfs Data,single profile for the swapfile filesystem" >> "$OUT"
      fi

      echo "" >> "$OUT"
      echo "== Active swap entries ==" >> "$OUT"
      (cat /proc/swaps || true) >> "$OUT"
      SWAP_LINE="$(swapon --noheadings --bytes --show=NAME,USED,PRIO 2>/dev/null | awk -v s="$SWAPFILE" '$1 == s { print $0; found=1 } END { if (!found) print "" }')"
      if [ -n "$SWAP_LINE" ]; then
        ACTIVE=1
        USED_BYTES="$(printf '%s\n' "$SWAP_LINE" | awk '{ print $2 + 0 }')"
        PRIO="$(printf '%s\n' "$SWAP_LINE" | awk '{ print $3 + 0 }')"
        if [ "$PRIO" -ne 10 ] 2>/dev/null; then
          WARN=1
          echo "WARN: expected priority 10, found $PRIO" >> "$OUT"
        fi
        if [ "$USED_BYTES" -gt 0 ] 2>/dev/null; then
          echo "INFO: backup-NVMe overflow swap currently has $USED_BYTES bytes in use (normal)" >> "$OUT"
        fi
      else
        WARN=1
        echo "WARN: 128 GiB backup-NVMe Btrfs overflow swapfile is not active" >> "$OUT"
      fi

      cat > "$PROM_TMP" <<EOF
# HELP monsternix_swapfile_audit_problem 1 if the backup-NVMe Btrfs swapfile audit found a critical problem.
# TYPE monsternix_swapfile_audit_problem gauge
monsternix_swapfile_audit_problem $PROBLEM
# HELP monsternix_swapfile_audit_warning 1 if the backup-NVMe Btrfs swapfile audit found a warning.
# TYPE monsternix_swapfile_audit_warning gauge
monsternix_swapfile_audit_warning $WARN
# HELP monsternix_overflow_swap_active 1 if the 128 GiB overflow swap is active.
# TYPE monsternix_overflow_swap_active gauge
monsternix_overflow_swap_active $ACTIVE
# HELP monsternix_overflow_swap_priority Priority of overflow swap, or -999 if inactive.
# TYPE monsternix_overflow_swap_priority gauge
monsternix_overflow_swap_priority $PRIO
# HELP monsternix_overflow_swap_used_bytes Bytes currently used by overflow swap.
# TYPE monsternix_overflow_swap_used_bytes gauge
monsternix_overflow_swap_used_bytes $USED_BYTES
# HELP monsternix_overflow_swap_size_bytes Logical size of the overflow swapfile.
# TYPE monsternix_overflow_swap_size_bytes gauge
monsternix_overflow_swap_size_bytes $SIZE_BYTES
EOF
      chmod 0644 "$PROM_TMP" 2>/dev/null || true
      mv -f "$PROM_TMP" "$PROM"
      chmod 0644 "$PROM" 2>/dev/null || true

      if [ "$PROBLEM" -eq 1 ]; then
        MNX_JOB_REASON=problem
        /etc/monsternix/bin/mnx-notify critical "Monsternix swapfile audit problem" "See $OUT" || true
        exit 1
      elif [ "$WARN" -eq 1 ]; then
        MNX_JOB_REASON=warning
        /etc/monsternix/bin/mnx-notify warning "Monsternix swapfile audit warning" "See $OUT" || true
      fi

      logger --journald <<EOF || logger -t mnx-swapfile-audit "Swapfile audit written to $OUT" || true
MESSAGE_ID=7f6d85f4-f421-54c9-a766-c3dcadf492cc
PRIORITY=5
LOGBOOK_KIND=SWAPFILE_AUDIT
LOGBOOK_VER=3
BUNDLE_PATH=$OUT
MESSAGE=Swapfile audit written to $OUT
EOF
    '';
  };

#@MNX-DEF path=systemd.timers.mnx-swapfile-audit section=40.33 role=timer ordinal=183
  systemd.timers.mnx-swapfile-audit = {
    description = "Run backup-NVMe Btrfs overflow swapfile audit";
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnBootSec = "30min";
      OnCalendar = "*-*-* 08:45:00";
      RandomizedDelaySec = "20min";
      Persistent = false;
    };
  };

  #########################################################################
  # Essential storage freshness, short retries, and bounded logbook growth
  #########################################################################

  # Calendar timers remain the preferred schedule. This lightweight controller
  # runs every thirty minutes, evaluates actual successful data state, and starts at
  # most one stale essential job. Maintenance is a lower-priority daytime fallback.
  # It never waits behind a heavy job and never
  # starts duperemove. It intentionally wants+orders after network-online because
  # one eligible action is the m21 pull; the target service still owns the lock.
#@MNX-CHUNK id=40.34 slug=storage-freshness-catchup title="Freshness controller and one-job catch-up policy"
#@MNX-DEF path=systemd.services.mnx-storage-catchup section=40.34 role=service ordinal=184
  systemd.services.mnx-storage-catchup = {
    description = "Evaluate essential backup freshness and start one catch-up job";
    wants = [ "local-fs.target" "network-online.target" ];
    after = [ "local-fs.target" "network-online.target" ];
    onFailure = [ "mnx-job-failure-notify@%n.service" ];
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Group = "logbook";
      UMask = "0027";
      Nice = 19;
      IOSchedulingClass = "idle";
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectSystem = "full";
      RestrictSUIDSGID = true;
      ReadWritePaths = [
        "/var/lib/logbook"
        "/var/lib/monsternix"
        "/var/lib/node-exporter-textfile"
        "/run/monsternix"
      ];
      StandardOutput = "journal";
      StandardError = "journal";
    };
    path = [
      pkgs.bash
      pkgs.btrfs-progs
      pkgs.coreutils
      pkgs.findutils
      pkgs.gawk
      pkgs.gnugrep
      pkgs.gnused
      pkgs.util-linux
      pkgs.systemd
      pkgs.jq
    ];
    script = ''
      set -euo pipefail
      umask 027

      START_EPOCH="$(date +%s)"
      NOW="$START_EPOCH"
      TS="$(date -Is)"
      SAFE_TS="$(date +%Y%m%dT%H%M%S)"
      ROOT=/var/lib/logbook/backups
      STATE=/var/lib/monsternix/job-state/authoritative
      PROM_TMP=/var/lib/node-exporter-textfile/monsternix_backup_freshness.prom.$$
      PROM=/var/lib/node-exporter-textfile/monsternix_backup_freshness.prom
      OUT_TMP="$ROOT/freshness-current.txt.$$"
      OUT="$ROOT/freshness-current.txt"
      ACTION=none
      CHOSEN_UNIT=""
      CHOSEN_JOB=""
      OVERALL_STALE=0
      OVERALL_CRITICAL=0
      OVERALL_BLOCKED=0
      BEST_DISPATCH=999999999999999
      DISPATCH_STATE=/var/lib/monsternix/catchup

      install -d -m 2750 -o root -g logbook "$ROOT"
      install -d -m 0750 -o root -g logbook "$STATE"
      install -d -m 0755 -o root -g root /var/lib/node-exporter-textfile

      install -d -m 0750 -o root -g root "$DISPATCH_STATE"
      RESTIC_NIGHTLY="$(/etc/monsternix/bin/mnx-office health-evidence --json | jq -ce '.m21_restic | select(.schema == "mnx.m21.restic-nightly.v1" and (.nightly.retry_due|type)=="boolean" and (.nightly.deadline_missed|type)=="boolean" and (.eligible|type)=="boolean")')"

      #@MNX-PART id=40.34.mnx-storage-catchup.function.dispatch-epoch kind=function title="Function dispatch_epoch"
      dispatch_epoch() {
        local file="$DISPATCH_STATE/$1.last-dispatch" value=0
        if [[ -e "$file" || -L "$file" ]]; then
          [[ -f "$file" && ! -L "$file" && $(stat -Lc '%u:%g:%a:%h' "$file") == 0:0:600:1 && $(stat -Lc %s "$file") -le 32 ]] || return 1
          IFS= read -r value < "$file"
          [[ "$value" =~ ^[0-9]{1,15}$ ]] || return 1
          # A wall-clock correction cannot turn fairness metadata into a backup outage.
          if [[ "$value" -gt "$NOW" ]]; then value="$NOW"; fi
        fi
        printf '%s\n' "$value"
      }

      #@MNX-PART id=40.34.mnx-storage-catchup.function.notify-backup-deadline kind=function title="Function notify_backup_deadline"
      notify_backup_deadline() {
        local job=$1 slot=$2 good=$3 unmet=$4 notice pending first=0 previous_good=0 last_notice=0 tmp
        [[ $job =~ ^[a-z0-9-]+$ && $slot =~ ^[0-9]+$ && $good =~ ^[0-9]+$ && $unmet =~ ^[01]$ ]] || return 1
        pending="$DISPATCH_STATE/$job.unmet-since"
        notice="$DISPATCH_STATE/$job.week-notified"
        if [[ -e "$pending" || -L "$pending" ]]; then
          [[ -f "$pending" && ! -L "$pending" && $(stat -Lc '%u:%g:%a:%h' "$pending") == 0:0:600:1 && $(stat -Lc %s "$pending") -le 64 ]] || return 1
          read -r first previous_good < "$pending"
          [[ $first =~ ^[0-9]{1,15}$ && $previous_good =~ ^[0-9]{1,15}$ ]] || return 1
          if (( good > previous_good )); then
            rm -f -- "$pending" "$notice"
            first=0
          fi
        fi
        if (( first == 0 )); then
          (( unmet == 1 )) || return 0
          first=$NOW
          tmp=$(mktemp "$DISPATCH_STATE/.unmet.XXXXXXXX")
          printf '%s %s\n' "$first" "$good" > "$tmp"
          chown root:root "$tmp"; chmod 0600 "$tmp"; mv -fT -- "$tmp" "$pending"
        fi
        # No pop-up for individual retries, and no fabricated old age for an absent receipt.
        (( unmet == 1 && NOW >= first && NOW - first >= 604800 )) || return 0
        if [[ -e "$notice" || -L "$notice" ]]; then
          [[ -f "$notice" && ! -L "$notice" && $(stat -Lc '%u:%g:%a:%h' "$notice") == 0:0:600:1 && $(stat -Lc %s "$notice") -le 32 ]] || return 1
          IFS= read -r last_notice < "$notice"
          [[ $last_notice =~ ^[0-9]{1,15}$ ]] || return 1
        fi
        (( NOW >= last_notice && NOW - last_notice >= 604800 )) || return 0
        if ! /etc/monsternix/bin/mnx-notify critical "$job unresolved for one week" 'Backup supervision has observed an unmet obligation for seven days. Inspect the officer evidence; automatic retries remain active.'; then
          printf 'backup_week_notification=delivery-deferred job=%s\n' "$job" >&2
          return 0
        fi
        tmp=$(mktemp "$DISPATCH_STATE/.notice.XXXXXXXX")
        printf '%s\n' "$NOW" > "$tmp"
        chown root:root "$tmp"; chmod 0600 "$tmp"; mv -fT -- "$tmp" "$notice"
      }

      #@MNX-PART id=40.34.mnx-storage-catchup.function.select-maintenance-catchup kind=function title="Function select_maintenance_catchup"
      select_maintenance_catchup() {
        local day day_start window_start window_end active
        MAINTENANCE_CATCHUP=not-due
        # Cleanup is lower priority than recoverable data, never a peer in its fair queue.
        # Calendar maintenance keeps the primary 11:15 + jitter attempt. Retry in daylight
        # only; the existing eight-hour service limit leaves room before the m21 night slot.
        day=$(TZ=${lib.escapeShellArg mnxM21NightlyPolicy.timezone} date -d "@$NOW" +%F) || return 1
        day_start=$(TZ=${lib.escapeShellArg mnxM21NightlyPolicy.timezone} date -d "$day 00:00:00" +%s) || return 1
        window_start=$(TZ=${lib.escapeShellArg mnxM21NightlyPolicy.timezone} date -d "$day 12:00:00" +%s) || return 1
        window_end=$(TZ=${lib.escapeShellArg mnxM21NightlyPolicy.timezone} date -d "$day 18:00:00" +%s) || return 1
        if (( maintenance_good > NOW )); then
          MAINTENANCE_CATCHUP=future-success-review
        elif (( maintenance_good >= day_start )); then
          MAINTENANCE_CATCHUP=completed-today
        elif (( NOW < window_start || NOW >= window_end )); then
          MAINTENANCE_CATCHUP=outside-daytime-window
        elif [[ -n $CHOSEN_UNIT ]]; then
          MAINTENANCE_CATCHUP=data-copy-priority
        elif ! jq -e '.eligible == true and .nightly.covered == true' <<< "$RESTIC_NIGHTLY" >/dev/null; then
          MAINTENANCE_CATCHUP=home-protection-or-qualification-pending
        elif ! mount_ready /mnt/m16-new-storage; then
          MAINTENANCE_CATCHUP=destination-unavailable
        else
          active=$(systemctl is-active m16-restic-maintenance.service 2>/dev/null || true)
          case "$active" in
            active|activating|reloading|deactivating) MAINTENANCE_CATCHUP=already-running ;;
            inactive|failed)
              MAINTENANCE_CATCHUP=due
              CHOSEN_JOB=m16-restic-maintenance
              CHOSEN_UNIT=m16-restic-maintenance.service
              ;;
            *) MAINTENANCE_CATCHUP=unit-state-review ;;
          esac
        fi
      }

      #@MNX-PART id=40.34.mnx-storage-catchup.function.marker_epoch kind=function title="Function marker_epoch"
      marker_epoch() {
        job="$1"
        file="$STATE/$job.last-success"
        [ -s "$file" ] || return 1
        awk -F= '$1 == "epoch" { print $2; exit }' "$file"
      }

      #@MNX-PART id=40.34.mnx-storage-catchup.function.parse_btrbk_name kind=function title="Function parse_btrbk_name"
      parse_btrbk_name() {
        name="$1"
        stamp="''${name#home.}"
        case "$stamp" in
          [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9])
            date -d "''${stamp:0:4}-''${stamp:4:2}-''${stamp:6:2} ''${stamp:9:2}:''${stamp:11:2}:00" +%s 2>/dev/null
            ;;
          *) return 1 ;;
        esac
      }

      #@MNX-PART id=40.34.mnx-storage-catchup.function.parse_m21_name kind=function title="Function parse_m21_name"
      parse_m21_name() {
        name="$1"
        stamp="''${name#home-}"
        case "$stamp" in
          [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z)
            date -u -d "''${stamp:0:4}-''${stamp:4:2}-''${stamp:6:2} ''${stamp:9:2}:''${stamp:11:2}:''${stamp:13:2} UTC" +%s 2>/dev/null
            ;;
          *) return 1 ;;
        esac
      }

      #@MNX-PART id=40.34.mnx-storage-catchup.function.valid_received kind=function title="Function valid_received"
      valid_received() {
        path="$1"
        [ -d "$path" ] || return 1
        btrfs subvolume show "$path" >/dev/null 2>&1 || return 1
        ro="$(btrfs property get -ts "$path" ro 2>/dev/null | awk -F= '$1 == "ro" { print $2; exit }')"
        received="$(btrfs subvolume show "$path" 2>/dev/null | awk -F: '/Received UUID:/ { gsub(/^[ \t]+/, "", $2); print $2; exit }')"
        [ "$ro" = true ] && [ -n "$received" ] && [ "$received" != - ]
      }

      #@MNX-PART id=40.34.mnx-storage-catchup.function.fallback_epoch kind=function title="Function fallback_epoch"
      fallback_epoch() {
        job="$1"
        latest=""
        case "$job" in
          btrbk-main)
            root=/mnt/m16-backup-nvme/btrbk-snapshots
            latest="$(find "$root" -mindepth 1 -maxdepth 1 -type d -name 'home.[0-9]*T[0-9]*' -printf '%f\n' 2>/dev/null | sort | tail -n 1)"
            [ -n "$latest" ] && valid_received "$root/$latest" && parse_btrbk_name "$latest"
            ;;
          m21-btrfs-pull-backup)
            root=/mnt/m16-new-storage/syncs/m21
            latest="$(find "$root" -mindepth 1 -maxdepth 1 -type d -name 'home-[0-9]*T[0-9]*Z' -printf '%f\n' 2>/dev/null | sort | tail -n 1)"
            [ -n "$latest" ] && valid_received "$root/$latest" && parse_m21_name "$latest"
            ;;
          btrbk-archive-to-new-storage)
            file=/mnt/m16-new-storage/admin/backups/.monsternix/last-success.txt
            if [ -s "$file" ]; then
              value="$(awk -F= '$1 == "timestamp" { print substr($0, index($0, "=") + 1); exit }' "$file")"
              latest_path="$(awk -F= '$1 == "latest_home_archive" { print substr($0, index($0, "=") + 1); exit }' "$file")"
              [ -n "$value" ] && [ -n "$latest_path" ] && valid_received "$latest_path" && date -d "$value" +%s 2>/dev/null
            fi
            ;;
          rsync-m16-new-to-old)
            file=/home/h0p3/admin/logs/root-rsync-storage-drives.log
            # Legacy bootstrap is accepted only when the complete parser finds a
            # fully successful run. A trailing "done" after rsync code 23 is not
            # success and deliberately yields no epoch, causing a real catch-up.
            /etc/monsternix/bin/mnx-rsync-log-report last-success-epoch "$file" 2>/dev/null || true
            ;;
        esac
      }

      #@MNX-PART id=40.34.mnx-storage-catchup.function.get_epoch kind=function title="Function get_epoch"
      get_epoch() {
        job="$1"
        if [[ "$job" == m16-restic-m21 ]]; then
          printf '%s\troot-restic-success-source-bound\n' "$(jq -r '.source_epoch // 0' <<< "$RESTIC_NIGHTLY")"
          return 0
        fi
        epoch="$(marker_epoch "$job" 2>/dev/null || true)"
        if [ -n "$epoch" ]; then
          printf '%s\tmarker\n' "$epoch"
          return 0
        fi
        epoch="$(fallback_epoch "$job" 2>/dev/null || true)"
        if [ -n "$epoch" ]; then
          printf '%s\tobserved-data\n' "$epoch"
          return 0
        fi
        printf '0\tmissing\n'
      }

      #@MNX-PART id=40.34.mnx-storage-catchup.function.mount_ready kind=function title="Function mount_ready"
      mount_ready() {
        mp="$1"
        mountpoint -q "$mp" || return 1
        findmnt -rn -T "$mp" -o OPTIONS 2>/dev/null | grep -Eq '(^|,)rw(,|$)'
      }

      #@MNX-PART id=40.34.mnx-storage-catchup.function.mount_read_only kind=function title="Function mount_read_only"
      mount_read_only() {
        mp="$1"
        mountpoint -q "$mp" || return 1
        findmnt -rn -T "$mp" -o OPTIONS 2>/dev/null | grep -Eq '(^|,)ro(,|$)'
      }

      #@MNX-PART id=40.34.mnx-storage-catchup.function.job_ready kind=function title="Function job_ready"
      job_ready() {
        job="$1"
        case "$job" in
          btrbk-main)
            mount_ready /home && mount_ready /mnt/m16-backup-nvme
            ;;
          m16-restic-m21)
            mount_ready /mnt/m16-new-storage && jq -e '.eligible == true' <<< "$RESTIC_NIGHTLY" >/dev/null
            ;;
          btrbk-archive-to-new-storage)
            mount_ready /mnt/m16-backup-nvme && mount_ready /mnt/m16-new-storage
            ;;
          rsync-m16-new-to-old)
            mount_ready /home && mount_ready /mnt/m16-new-storage && mount_read_only /mnt/m16-old-storage
            ;;
          *) return 1 ;;
        esac
      }

      HEAVY_BUSY=0
      for unit in \
        btrbk-main.service \
        btrbk-archive-to-new-storage.service \
        m21-btrfs-pull-backup.service \
        m16-backup-m21.service \
        m16-restic-maintenance.service \
        rsync-m16-new-to-old.service \
        duperemove-home.service \
        duperemove-m16-new-storage.service
      do
        case "$(systemctl is-active "$unit" 2>/dev/null || true)" in
          active|activating|reloading) HEAVY_BUSY=1 ;;
        esac
      done

      exec 9<>/run/storage-maintenance.lock
      LOCK_FREE=0
      if flock -n -x 9; then
        LOCK_FREE=1
        flock -u 9
      fi

      cat > "$OUT_TMP" <<EOF
=== MONSTERNIX ESSENTIAL BACKUP FRESHNESS ($TS) ===
timestamp=$TS
epoch=$NOW
heavy_job_active=$HEAVY_BUSY
storage_lock_free=$LOCK_FREE
overall_stale=0
overall_critical=0
overall_blocked=0
action=none

job\tunit\tlast_success_epoch\tage_seconds\tthreshold_seconds\tstale\tcritical\tready\tsource\tactive_state
EOF

      cat > "$PROM_TMP" <<EOF
# HELP monsternix_backup_freshness_age_seconds Age of the latest successful data state for an essential backup flow.
# TYPE monsternix_backup_freshness_age_seconds gauge
# HELP monsternix_backup_freshness_threshold_seconds Catch-up threshold for an essential backup flow.
# TYPE monsternix_backup_freshness_threshold_seconds gauge
# HELP monsternix_backup_freshness_stale 1 when an essential backup flow exceeds its catch-up threshold.
# TYPE monsternix_backup_freshness_stale gauge
# HELP monsternix_backup_freshness_critical 1 when an essential backup flow exceeds twice its catch-up threshold.
# TYPE monsternix_backup_freshness_critical gauge
EOF

      while IFS='|' read -r job unit threshold; do
        [ -n "$job" ] || continue
        record="$(get_epoch "$job")"
        epoch="$(printf '%s\n' "$record" | awk -F '\t' '{print $1}')"
        source="$(printf '%s\n' "$record" | awk -F '\t' '{print $2}')"
        [ -n "$epoch" ] || epoch=0
        if [ "$epoch" -gt 0 ] 2>/dev/null; then
          age=$(( NOW - epoch ))
          [ "$age" -ge 0 ] || age=0
        else
          age=$(( threshold * 10 ))
        fi

        stale=0
        critical=0
        retry_due=0
        [ "$age" -ge "$threshold" ] && stale=1
        [ "$age" -ge $(( threshold * 2 )) ] && critical=1
        retry_due="$stale"
        # m16 is the operator's primary life archive. Preserve the existing 36-hour
        # stale/critical health semantics, but retry a missed daily home snapshot once
        # its last success is 24 hours old. Dispatch remains subject to the same
        # readiness, heavy-job, fairness and shared-storage-lock arbitration below.
        if [[ "$job" == btrbk-main ]] && [ "$age" -ge 86400 ]; then
          retry_due=1
        fi
        if [[ "$job" == m16-restic-m21 ]]; then
          stale="$(jq -r 'if .nightly.retry_due then 1 else 0 end' <<< "$RESTIC_NIGHTLY")"
          critical="$(jq -r 'if .nightly.deadline_missed then 1 else 0 end' <<< "$RESTIC_NIGHTLY")"
          retry_due="$stale"
        fi
        OVERALL_STALE=$(( OVERALL_STALE + stale ))
        OVERALL_CRITICAL=$(( OVERALL_CRITICAL + critical ))
        notice_slot=$(( NOW / 86400 * 86400 ))
        notify_backup_deadline "$job" "$notice_slot" "$epoch" "$stale"
        active="$(systemctl is-active "$unit" 2>/dev/null || true)"
        ready=0
        if job_ready "$job"; then ready=1; fi
        if [ "$retry_due" -eq 1 ] && [ "$ready" -eq 0 ]; then
          OVERALL_BLOCKED=$(( OVERALL_BLOCKED + 1 ))
        fi

        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
          "$job" "$unit" "$epoch" "$age" "$threshold" "$stale" "$critical" "$ready" "$source" "$active" \
          >> "$OUT_TMP"

        printf 'monsternix_backup_freshness_age_seconds{job="%s",source="%s"} %s\n' "$job" "$source" "$age" >> "$PROM_TMP"
        printf 'monsternix_backup_freshness_threshold_seconds{job="%s"} %s\n' "$job" "$threshold" >> "$PROM_TMP"
        printf 'monsternix_backup_freshness_stale{job="%s"} %s\n' "$job" "$stale" >> "$PROM_TMP"
        printf 'monsternix_backup_freshness_critical{job="%s"} %s\n' "$job" "$critical" >> "$PROM_TMP"

        if [ "$retry_due" -eq 1 ] && [ "$ready" -eq 1 ]; then
          case "$active" in
            active|activating|reloading) ;;
            *)
              previous_dispatch="$(dispatch_epoch "$job")"
              if [[ "$previous_dispatch" -lt "$BEST_DISPATCH" ]]; then
                BEST_DISPATCH="$previous_dispatch"; CHOSEN_JOB="$job"; CHOSEN_UNIT="$unit"
              fi
              ;;
          esac
        fi
      done <<'EOF'
btrbk-main|btrbk-main.service|129600
m16-restic-m21|m16-backup-m21.service|86400
btrbk-archive-to-new-storage|btrbk-archive-to-new-storage.service|777600
rsync-m16-new-to-old|rsync-m16-new-to-old.service|3024000
EOF
      printf 'btrbk_main_retry_after_seconds=86400\nbtrbk_main_health_stale_after_seconds=129600\n' >> "$OUT_TMP"

      # Best-effort configuration capture has its own notification clock: a successful
      # home-only backup cannot erase a week of missing rebuild inputs.
      bundle_status=$(jq -r '.current_attempt.rebuild_bundle_status // "not-observed"' <<< "$RESTIC_NIGHTLY")
      bundle_good=0; bundle_unmet=0
      case "$bundle_status" in
        unavailable-home-only|preparation-failed) bundle_unmet=1 ;;
        staged-before-home-export)
          bundle_good=$(date -d "$(jq -r '.current_attempt.recorded_at' <<< "$RESTIC_NIGHTLY")" +%s 2>/dev/null || echo 0) ;;
      esac
      notify_backup_deadline m21-rebuild-inputs "$NOW" "$bundle_good" "$bundle_unmet"
      # Maintenance failure is separate from home-data freshness and remains visible.
      maintenance_good=$(marker_epoch m16-restic-maintenance 2>/dev/null || echo 0)
      [[ $maintenance_good =~ ^[0-9]{1,15}$ ]] || maintenance_good=0
      maintenance_unmet=0
      if (( maintenance_good == 0 || NOW - maintenance_good >= 172800 )); then maintenance_unmet=1; fi
      notify_backup_deadline m16-restic-maintenance "$NOW" "$maintenance_good" "$maintenance_unmet"
      select_maintenance_catchup
      printf 'maintenance_catchup=%s\nmaintenance_last_success_epoch=%s\nmaintenance_retry_window=12:00-18:00-America/New_York\nmaintenance_priority=after-ready-data-copies-and-covered-m21-home\n' \
        "$MAINTENANCE_CATCHUP" "$maintenance_good" >> "$OUT_TMP"
      printf 'backup_notification_policy=one-unresolved-week-weekly-reminder\n' >> "$OUT_TMP"

      if [ -n "$CHOSEN_UNIT" ] && [ "$HEAVY_BUSY" -eq 0 ] && [ "$LOCK_FREE" -eq 1 ]; then
        ACTION="start:$CHOSEN_UNIT"
        dispatch_tmp="$(mktemp "$DISPATCH_STATE/.dispatch.XXXXXXXX")"
        printf '%s\n' "$NOW" > "$dispatch_tmp"
        chown root:root "$dispatch_tmp"; chmod 0600 "$dispatch_tmp"
        mv -fT -- "$dispatch_tmp" "$DISPATCH_STATE/$CHOSEN_JOB.last-dispatch"
        # Dispatch history is fairness metadata, NEVER backup-success authority.
        systemctl start --no-block "$CHOSEN_UNIT"
      elif [ -n "$CHOSEN_UNIT" ]; then
        ACTION="defer:$CHOSEN_UNIT"
      elif [ "$OVERALL_BLOCKED" -gt 0 ]; then
        ACTION="blocked-prerequisites"
      fi

      printf 'm21_primary_backend=restic\nm21_nightly_evidence=%s\n' "$RESTIC_NIGHTLY" >> "$OUT_TMP"

      sed -i \
        -e "s/^overall_stale=.*/overall_stale=$OVERALL_STALE/" \
        -e "s/^overall_critical=.*/overall_critical=$OVERALL_CRITICAL/" \
        -e "s/^overall_blocked=.*/overall_blocked=$OVERALL_BLOCKED/" \
        -e "s#^action=.*#action=$ACTION#" \
        "$OUT_TMP"

      chmod 0644 "$PROM_TMP"
      mv -f "$PROM_TMP" "$PROM"
      chmod 0644 "$PROM"
      chown root:logbook "$OUT_TMP"
      chmod 0640 "$OUT_TMP"
      mv -f "$OUT_TMP" "$OUT"
      chown root:logbook "$OUT"
      chmod 0640 "$OUT"

      logger --journald <<EOF || true
MESSAGE_ID=0c4f66a7-156a-5991-8f54-4a2bb40f5a3b
PRIORITY=5
LOGBOOK_KIND=BACKUP_FRESHNESS
LOGBOOK_VER=1
BACKUP_STALE_COUNT=$OVERALL_STALE
BACKUP_CRITICAL_COUNT=$OVERALL_CRITICAL
BACKUP_BLOCKED_COUNT=$OVERALL_BLOCKED
BACKUP_CATCHUP_ACTION=$ACTION
BUNDLE_PATH=$OUT
MESSAGE=Backup freshness evaluated: stale=$OVERALL_STALE critical=$OVERALL_CRITICAL blocked=$OVERALL_BLOCKED action=$ACTION
EOF

      /etc/monsternix/bin/mnx-job-metric \
        mnx-storage-catchup 0 "$(( $(date +%s) - START_EPOCH ))" 0 "$ACTION" || true
    '';
  };

#@MNX-DEF path=systemd.timers.mnx-storage-catchup section=40.34 role=timer ordinal=185
  systemd.timers.mnx-storage-catchup = {
    description = "Re-evaluate essential backup freshness and retry one stale flow";
    wantedBy = [ "timers.target" ];
    timerConfig = {
      Unit = "mnx-storage-catchup.service";
      # Use OnActiveSec rather than OnBootSec so a configuration switch on a
      # long-running machine does not immediately surprise-start catch-up work.
      OnActiveSec = toString mnxM21NightlyPolicy.activationGraceMinutes + "min";
      OnUnitActiveSec = toString mnxM21NightlyPolicy.catchupEveryMinutes + "min";
      RandomizedDelaySec = toString mnxM21NightlyPolicy.catchupJitterMinutes + "min";
      Persistent = false;
    };
  };

  # Bound high-signal artifacts without touching pstore crash evidence. The
  # service stays entirely beneath /var/lib/logbook and never accesses any
  # mounted backup or mirror filesystem.
#@MNX-CHUNK id=40.35 slug=logbook-retention title="Bounded Logbook artifact retention"
#@MNX-DEF path=systemd.services.mnx-logbook-prune section=40.35 role=service ordinal=186
  systemd.services.mnx-logbook-prune = {
    description = "Prune old Monsternix logbook artifacts by family";
    wants = [ "local-fs.target" ];
    after = [ "local-fs.target" ];
    onFailure = [ "mnx-job-failure-notify@%n.service" ];
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Group = "logbook";
      UMask = "0027";
      Nice = 19;
      IOSchedulingClass = "idle";
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectSystem = "full";
      ProtectHome = "read-only";
      RestrictSUIDSGID = true;
      ReadWritePaths = [
        "/var/lib/logbook"
        "/var/lib/node-exporter-textfile"
        "/var/lib/monsternix"
      ];
      StandardOutput = "journal";
      StandardError = "journal";
    };
    path = [ pkgs.bash pkgs.coreutils pkgs.findutils pkgs.gawk pkgs.gnugrep pkgs.python3 pkgs.util-linux pkgs.systemd ];
    script = ''
      set -euo pipefail
      umask 027

      START_EPOCH="$(date +%s)"
      TS="$(date -Is)"
      SAFE_TS="$(date +%Y%m%dT%H%M%S)"
      ROOT=/var/lib/logbook
      OUT="$ROOT/maintenance/logbook-prune-$SAFE_TS.txt"
      DELETED_FILES=0
      DELETED_DIRS=0
      BYTES_BEFORE="$(du -sb "$ROOT" 2>/dev/null | awk '{print $1 + 0}')"

      install -d -m 2750 -o root -g logbook "$ROOT/maintenance"

      PROTECTED_OFFICE_EVIDENCE="$(mktemp)"
      python3 - /var/lib/monsternix/office/records "$ROOT/support" > "$PROTECTED_OFFICE_EVIDENCE" <<'PY'
import json
import pathlib
import stat
import sys

records = pathlib.Path(sys.argv[1])
support = pathlib.Path(sys.argv[2]).resolve()
protected: set[str] = set()
if records.exists():
    for record_path in sorted(records.glob('accepted-*.json')):
        info = record_path.lstat()
        if not stat.S_ISREG(info.st_mode) or record_path.is_symlink() or info.st_uid != 0 or info.st_mode & 0o022:
            raise SystemExit(f'untrusted office record during prune: {record_path}')
        try:
            record = json.loads(record_path.read_text(encoding='utf-8'))
        except (OSError, json.JSONDecodeError) as exc:
            raise SystemExit(f'unreadable office record during prune: {record_path}: {exc}')
        if not isinstance(record, dict):
            raise SystemExit(f'non-object office record during prune: {record_path}')
        for key in ('test_report', 'switch_report'):
            value = record.get(key)
            if not isinstance(value, str) or not value:
                raise SystemExit(f'office record lacks {key}: {record_path}')
            evidence = pathlib.Path(value).resolve()
            try:
                evidence.relative_to(support)
            except ValueError:
                raise SystemExit(f'office evidence escapes support root: {evidence}')
            if evidence.parent != support:
                raise SystemExit(f'office evidence is not a top-level support file: {evidence}')
            protected.add(str(evidence))
for value in sorted(protected):
    print(value)
PY
      PROTECTED_OFFICE_EVIDENCE_COUNT="$(wc -l < "$PROTECTED_OFFICE_EVIDENCE")"

      #@MNX-PART id=40.35.mnx-logbook-prune.function.delete_files kind=function title="Function delete_files"
      delete_files() {
        root="$1"
        days="$2"
        shift 2
        [ -d "$root" ] || return 0
        while IFS= read -r -d $'\0' path; do
          resolved="$(readlink -f -- "$path" 2>/dev/null || true)"
          if [[ "$root" == "$ROOT/support" && -n "$resolved" ]] &&
             grep -Fxq -- "$resolved" "$PROTECTED_OFFICE_EVIDENCE"
          then
            continue
          fi
          rm -f -- "$path"
          DELETED_FILES=$(( DELETED_FILES + 1 ))
        done < <(find -P "$root" -xdev -mindepth 1 -maxdepth 1 -type f "$@" -mtime "+$days" -print0)
      }

      #@MNX-PART id=40.35.mnx-logbook-prune.function.delete_dirs kind=function title="Function delete_dirs"
      delete_dirs() {
        root="$1"
        days="$2"
        regex="$3"
        [ -d "$root" ] || return 0
        while IFS= read -r -d $'\0' path; do
          rm -rf --one-file-system -- "$path"
          DELETED_DIRS=$(( DELETED_DIRS + 1 ))
        done < <(find -P "$root" -xdev -mindepth 1 -maxdepth 1 -type d -regextype posix-extended -regex "$regex" -mtime "+$days" -print0)
      }

      delete_dirs "$ROOT/boots" 180 '.*/[0-9a-fA-F-]{20,}'
      delete_dirs "$ROOT/incidents" 365 '.*/[0-9]{8}T[0-9]{6}'

      delete_files "$ROOT/daily" 365 \( -name '????-??-??.txt' -o -name '????-??-??.json' \)
      delete_files "$ROOT/daily" 180 -name 'storage-health-*.txt'
      delete_files "$ROOT/daily" 180 -name 'swapfile-audit-*.txt'
      delete_files "$ROOT/support" 90 -name 'support-*.txt'
      delete_files "$ROOT/support" 90 -name 'config-audit-*.txt'
      delete_files "$ROOT/support" 90 -name 'mnx-test-*'
      delete_files "$ROOT/support" 90 -name 'mnx-bootstrap-test-*'
      delete_files "$ROOT/support" 90 -name 'mnx-switch-*'
      delete_files "$ROOT/support" 90 -name 'monolith-map-*'
      delete_files "$ROOT/support" 90 -name 'monolith-bundle-*'
      delete_files "$ROOT/support" 90 -name 'refactor-prepare-*'
      delete_files "$ROOT/maintenance" 180 -name 'logbook-prune-*.txt'
      delete_files "$ROOT/maintenance" 180 -name 'metric-reconcile-*.txt'
      delete_files "$ROOT/unit-failures" 365 -name '*.txt'
      delete_files "$ROOT/metrics-history" 365 -name '*.prom'

      rm -f -- "$PROTECTED_OFFICE_EVIDENCE"

      BYTES_AFTER="$(du -sb "$ROOT" 2>/dev/null | awk '{print $1 + 0}')"
      RECLAIMED=$(( BYTES_BEFORE - BYTES_AFTER ))
      [ "$RECLAIMED" -ge 0 ] || RECLAIMED=0

      cat > "$OUT" <<EOF
=== MONSTERNIX LOGBOOK PRUNE ($TS) ===
timestamp=$TS
deleted_files=$DELETED_FILES
deleted_directories=$DELETED_DIRS
bytes_before=$BYTES_BEFORE
bytes_after=$BYTES_AFTER
bytes_reclaimed=$RECLAIMED
retention_boot_packets_days=180
retention_daily_health_days=365
retention_storage_health_days=180
retention_swap_audit_days=180
retention_incidents_days=365
retention_support_reports_days=90
office_acceptance_evidence_protected_files=$PROTECTED_OFFICE_EVIDENCE_COUNT
pstore_retention=indefinite
old_storage_written=no
EOF
      chown root:logbook "$OUT"
      chmod 0640 "$OUT"

      cat > /var/lib/node-exporter-textfile/monsternix_logbook_prune.prom.tmp <<EOF
# HELP monsternix_logbook_prune_deleted_files Files deleted by the latest logbook prune.
# TYPE monsternix_logbook_prune_deleted_files gauge
monsternix_logbook_prune_deleted_files $DELETED_FILES
# HELP monsternix_logbook_prune_deleted_directories Directories deleted by the latest logbook prune.
# TYPE monsternix_logbook_prune_deleted_directories gauge
monsternix_logbook_prune_deleted_directories $DELETED_DIRS
# HELP monsternix_logbook_prune_reclaimed_bytes Approximate bytes reclaimed by the latest logbook prune.
# TYPE monsternix_logbook_prune_reclaimed_bytes gauge
monsternix_logbook_prune_reclaimed_bytes $RECLAIMED
EOF
      chmod 0644 /var/lib/node-exporter-textfile/monsternix_logbook_prune.prom.tmp
      mv -f /var/lib/node-exporter-textfile/monsternix_logbook_prune.prom.tmp \
        /var/lib/node-exporter-textfile/monsternix_logbook_prune.prom

      logger --journald <<EOF || true
MESSAGE_ID=830a52fd-00a5-5842-83ce-f91a03f80aa0
PRIORITY=5
LOGBOOK_KIND=LOGBOOK_PRUNE
LOGBOOK_VER=1
DELETED_FILES=$DELETED_FILES
DELETED_DIRECTORIES=$DELETED_DIRS
BYTES_RECLAIMED=$RECLAIMED
BUNDLE_PATH=$OUT
MESSAGE=Logbook prune complete: files=$DELETED_FILES directories=$DELETED_DIRS reclaimed=$RECLAIMED
EOF

      /etc/monsternix/bin/mnx-job-metric \
        mnx-logbook-prune 0 "$(( $(date +%s) - START_EPOCH ))" 0 none || true
    '';
  };

#@MNX-DEF path=systemd.timers.mnx-logbook-prune section=40.35 role=timer ordinal=187
  systemd.timers.mnx-logbook-prune = {
    description = "Daily bounded retention for Monsternix logbook artifacts";
    wantedBy = [ "timers.target" ];
    timerConfig = {
      Unit = "mnx-logbook-prune.service";
      OnCalendar = "*-*-* 04:45:00";
      RandomizedDelaySec = "15min";
      Persistent = true;
    };
  };

#@MNX-CHUNK id=50.10 slug=storage-topology title="Filesystem topology, swap, mounts, and storage policy"
#######################################################################################################
# SECTION 50 — STORAGE TOPOLOGY AND SWAP
#######################################################################################################

  ########## IO, Filesystems, & Backups ##########

  # /tmp in RAM (tmpfs can spill to swap under pressure).
#@MNX-DEF path=boot.tmp.useTmpfs section=50.10 role=storage-policy ordinal=188
  boot.tmp.useTmpfs = true;
#@MNX-DEF path=boot.tmp.cleanOnBoot section=50.10 role=storage-policy ordinal=189
  boot.tmp.cleanOnBoot = true;

  # Cap /tmp so it doesn’t eat your remaining headroom on a “75% RAM all day” machine.
#@MNX-DEF path=boot.tmp.tmpfsSize section=50.10 role=storage-policy ordinal=190
  boot.tmp.tmpfsSize = "16G";  # or "20%" if you prefer percent-based 

  # Btrfs maintenance (scrub each Btrfs filesystem once).
  # The backup NVMe remains a manual scrub target for now: it had a 2026-06-15
  # I/O incident during btrfs receive, so do not surprise-hammer it monthly until
  # you have decided whether to retire, reseat, or keep trusting it.
#@MNX-DEF path=services.btrfs.autoScrub section=50.10 role=storage-policy ordinal=191
  services.btrfs.autoScrub = {
    enable = true;
    interval = "monthly";
    limit = "50M";  # keep scrubs from trashing interactive IO 
    fileSystems = [
      "/"                    # covers root/home/nix/syncs (same UUID)
      "/mnt/m16-new-storage"
      # /mnt/m16-old-storage is mirror-only: no automatic scrub/repair writes.
      # "/mnt/m16-backup-nvme" # manual for now after the 2026-06-15 incident
    ];
  };

  # Swap strategy:
  #  1) zram first (fast compressed RAM)
  #  2) a real 128 GiB overflow swapfile on the backup NVMe
  #
  # The backup-NVMe placement is intentional. The file is kept online during
  # ordinary btrbk send/receive work; backup jobs must never swapoff live pages
  # or skip merely because this overflow swap is in use. NixOS detects Btrfs
  # here and creates a NODATACOW, preallocated Btrfs-compatible swapfile.
  # Upstream Btrfs scrub/balance will still skip block groups pinned by active
  # swap extents; the backup NVMe therefore remains a manual-maintenance target.
#@MNX-DEF path=zramSwap section=50.10 role=swap ordinal=192
  zramSwap = {
    enable = true;
    algorithm = "zstd";
    memoryPercent = 100;
    priority = 100;
  };

#@MNX-DEF path=swapDevices section=50.10 role=swap ordinal=193
  swapDevices = [
    {
      # 128 * 1024 MiB = exactly 128 GiB. Higher priorities are preferred,
      # so zram (100) remains first and this disk-backed overflow is second.
      device = "/mnt/m16-backup-nvme/swap/swapfile";
      size = 128 * 1024;
      priority = 10;
      options = [ "nofail" ];
      discardPolicy = "once";
    }
  ];

  # earlyoom is the global, process-level last line of defence. It acts only when
  # BOTH available memory and free swap are low. The absolute -M/-S caps prevent
  # thresholds from becoming absurd merely because the machine has lots of RAM,
  # zram, or the new 128 GiB disk swap.
#@MNX-DEF path=services.earlyoom section=50.10 role=policy ordinal=194
  services.earlyoom = {
    enable = true;
    enableNotifications = true;
    reportInterval = 300;

    # Use 8%/4%, capped at 8 GiB/4 GiB by -M below.
    freeMemThreshold = 8;
    freeMemKillThreshold = 4;

    # The NixOS module requires percentage values. earlyoom uses the LOWER of
    # -s and -S, so 100/100 makes the absolute 16 GiB/8 GiB thresholds below
    # authoritative while still allowing almost all configured swap to be used.
    freeSwapThreshold = 100;
    freeSwapKillThreshold = 100;

    extraArgs = [
      "-M" "8388608,4194304"       # KiB: TERM <= 8 GiB, KILL <= 4 GiB
      "-S" "16777216,8388608"      # KiB: TERM <= 16 GiB, KILL <= 8 GiB

      # Prefer expendable build/LLM workers, not the Nix daemon itself. Regexes
      # match /proc/PID/comm, which earlyoom truncates to 15 bytes.
      "--prefer" "^(cc1plus|rustc|ld\\.gold|ld\\.lld|llama-server|llama-cli|ollama)$"

      # De-prioritize the control plane and graphical recovery path. --avoid is
      # deliberately softer than --ignore, so a genuine leak remains killable.
      "--avoid" "^(systemd|systemd-journal|systemd-logind|systemd-oomd|sshd|NetworkManager|dbus-daemon|Xorg|lightdm|i3|earlyoom)$"
    ];
  };

  # -M/-S are converted when earlyoom starts, so start it only after the normal
  # swap activation target has been reached.
#@MNX-DEF path=systemd.services.earlyoom section=50.10 role=service ordinal=195
  systemd.services.earlyoom = {
    wants = [ "swap.target" ];
    after = [ "swap.target" ];
  };

  # systemd-oomd is cgroup/PSI-aware but kills an entire selected cgroup with
  # SIGKILL. Broad user.slice monitoring is intentionally OFF: with an i3/X11
  # session, unrelated applications can share one session scope. Instead, use
  # `mnx-hog command ...` to opt a heavy command into the isolated slice below.
#@MNX-DEF path=systemd.oomd section=50.10 role=policy ordinal=196
  systemd.oomd = {
    enable = true;
    enableRootSlice = false;
    enableSystemSlice = false;
    enableUserSlices = false;
  };

  # systemd-oomd requires memory accounting for monitored cgroups. Make it
  # explicit in every per-user manager instead of relying on a changing default.
  # Use extraConfig for compatibility with the NixOS 24.11/25.11 user-manager module.
#@MNX-DEF path=systemd.user.extraConfig section=50.10 role=policy ordinal=197
  systemd.user.extraConfig = ''
    DefaultMemoryAccounting=yes
  '';

#@MNX-DEF path=systemd.user.units."mnx-memory-hogs.slice".text section=50.10 role=policy ordinal=198
  systemd.user.units."mnx-memory-hogs.slice".text = ''
    [Unit]
    Description=Opt-in Monsternix memory-pressure scopes

    [Slice]
    MemoryAccounting=yes
    ManagedOOMMemoryPressure=kill
    ManagedOOMMemoryPressureLimit=50%
    ManagedOOMMemoryPressureDurationSec=30s
  '';

#@MNX-DEF path=services.devmon.enable section=50.10 role=policy ordinal=199
  services.devmon.enable = true;
#@MNX-DEF path=services.udisks2.enable section=50.10 role=policy ordinal=200
  services.udisks2.enable = true;

#@MNX-DEF path=services.smartd.enable section=50.10 role=policy ordinal=201
  services.smartd.enable = true;
#@MNX-DEF path=services.smartd.notifications.x11.enable section=50.10 role=policy ordinal=202
  services.smartd.notifications.x11.enable = true;
#@MNX-DEF path=services.smartd.notifications.wall.enable section=50.10 role=policy ordinal=203
  services.smartd.notifications.wall.enable = true;

#@MNX-DEF path=services.fstrim section=50.10 role=policy ordinal=204
  services.fstrim = {
    enable = true;
    # Online discard is useful but is not an activation-atomicity boundary. Keep it away from the
    # daily 03:25 and 07:45 backup lanes and let the idle scheduler make it polite to interactive work.
    interval = "Wed *-*-* 12:30:00";
  };




