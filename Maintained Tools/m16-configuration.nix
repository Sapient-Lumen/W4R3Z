      #@MNX-PART id=99.60.mnx-refactor.planner.function.capsule-inspect-record kind=function title="Python function capsule_inspect_record"
      def capsule_inspect_record(path: Path) -> dict:
          source = read_capsule_source(path)
          media_type, shebang = capsule_media_type(source.pop("payload"))
          source["media_type"] = media_type
          source["shebang"] = shebang
          return {
              "schema": "mnx.capsule.inspect.v1",
              "capsule_schema": CAPSULE_SCHEMA,
              "status": "pass",
              "authority": "identity-evidence-not-permission",
              "source": source,
              "bounds": {
                  "maximum_source_bytes": CAPSULE_MAX_SOURCE_BYTES,
                  "source_execution": False,
                  "payload_execution": False,
                  "network_used": False,
                  "mutation": "none",
              },
              "limitations": [
                  "digest-is-not-author-signature",
                  "media-type-is-magic-and-text-heuristic",
                  "inspection-does-not-authorize-execution",
              ],
          }
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.capsule-verify-record kind=function title="Python function capsule_verify_record"
      def capsule_verify_record(path: Path, expected_sha256: str, expected_bytes: int, expected_media: str | None) -> dict:
          if not SHA256_RE.fullmatch(expected_sha256):
              raise PlannerError("capsule expected SHA-256 must be 64 lowercase hexadecimal characters")
          if expected_bytes < 0 or expected_bytes > CAPSULE_MAX_SOURCE_BYTES:
              raise PlannerError(f"capsule expected byte count must be between 0 and {CAPSULE_MAX_SOURCE_BYTES}")
          inspection = capsule_inspect_record(path)
          source = inspection["source"]
          checks = {
              "sha256": source["sha256"] == expected_sha256,
              "bytes": source["bytes"] == expected_bytes,
              "media_type": expected_media is None or source["media_type"] == expected_media,
          }
          return {
              "schema": "mnx.capsule.verify.v1",
              "capsule_schema": CAPSULE_SCHEMA,
              "status": "pass" if all(checks.values()) else "fail",
              "authority": "identity-match-not-execution-permission",
              "expected": {"sha256": expected_sha256, "bytes": expected_bytes, "media_type": expected_media},
              "observed": source,
              "checks": checks,
              "payload_execution": False,
              "network_used": False,
              "mutation": "none",
          }
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.render-capsule-record kind=function title="Python function render_capsule_record"
      def render_capsule_record(record: dict) -> str:
          lines = ["################################################################################", "# MNX CAPSULE — BOUNDED IDENTITY EVIDENCE", "################################################################################"]
          lines += [f"schema={record['schema']}", f"capsule_schema={record['capsule_schema']}", f"authority={record['authority']}"]
          if record["schema"] == "mnx.capsule.policy.v1":
              lines += [
                  f"maximum_source_bytes={record['maximum_source_bytes']}",
                  f"execution_enabled={'yes' if record['execution_enabled'] else 'no'}",
                  f"run_refusal_status={record['run_refusal_status']}",
                  f"digest_meaning={record['digest_meaning']}",
                  "payload_execution=no",
                  "network_used=no",
                  "persistent_mutation=none",
                  "MNX_CAPSULE_POLICY=PASS",
              ]
          elif record["schema"] == "mnx.capsule.inspect.v1":
              source = record["source"]
              for key in ["requested", "resolved", "is_symlink", "bytes", "sha256", "media_type", "shebang", "mode", "uid", "gid", "executable"]:
                  value = source.get(key)
                  if isinstance(value, bool):
                      value = "yes" if value else "no"
                  if value is None:
                      value = "none"
                  lines.append(f"source_{key}={value}")
              lines += ["payload_execution=no", "network_used=no", "mutation=none", "MNX_CAPSULE_INSPECT=PASS"]
          else:
              expected = record["expected"]
              observed = record["observed"]
              lines += [
                  f"verification_status={record['status']}",
                  f"expected_sha256={expected['sha256']}",
                  f"observed_sha256={observed['sha256']}",
                  f"expected_bytes={expected['bytes']}",
                  f"observed_bytes={observed['bytes']}",
                  f"expected_media_type={expected['media_type'] or 'not-required'}",
                  f"observed_media_type={observed['media_type']}",
                  f"check_sha256={'pass' if record['checks']['sha256'] else 'fail'}",
                  f"check_bytes={'pass' if record['checks']['bytes'] else 'fail'}",
                  f"check_media_type={'pass' if record['checks']['media_type'] else 'fail'}",
                  "payload_execution=no",
                  "network_used=no",
                  "mutation=none",
                  "MNX_CAPSULE_VERIFY=" + ("PASS" if record["status"] == "pass" else "FAIL"),
              ]
          return "\n".join(lines) + "\n"
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.capsule-self-test kind=function title="Python function capsule_self_test"
      def capsule_self_test(root: Path) -> None:
          capsule_root = root / "capsule"
          capsule_root.mkdir()
          sentinel = capsule_root / "must-not-exist"
          payload = capsule_root / "payload.sh"
          payload.write_text(f"#!/bin/sh\nprintf x > {sentinel}\n", encoding="utf-8")
          payload.chmod(0o755)
          inspection = capsule_inspect_record(payload)
          if not (inspection["source"]["media_type"] == "text/x-script"):
              raise PlannerError('explicit proof condition failed near planner line 482')
          if not (inspection["source"]["executable"] is True):
              raise PlannerError('explicit proof condition failed near planner line 483')
          if not (not sentinel.exists()):
              raise PlannerError('explicit proof condition failed near planner line 484')
          verified = capsule_verify_record(payload, inspection["source"]["sha256"], inspection["source"]["bytes"], "text/x-script")
          if not (verified["status"] == "pass"):
              raise PlannerError('explicit proof condition failed near planner line 486')
          if not (not sentinel.exists()):
              raise PlannerError('explicit proof condition failed near planner line 487')
          mismatch = capsule_verify_record(payload, "0" * 64, inspection["source"]["bytes"], None)
          if not (mismatch["status"] == "fail"):
              raise PlannerError('explicit proof condition failed near planner line 489')
          link = capsule_root / "payload-link"
          link.symlink_to(payload)
          if not (capsule_inspect_record(link)["source"]["is_symlink"] is True):
              raise PlannerError('explicit proof condition failed near planner line 492')
          oversized = capsule_root / "oversized"
          oversized.write_bytes(b"12345")
          try:
              read_capsule_source(oversized, max_bytes=4)
          except PlannerError:
              pass
          else:
              raise AssertionError("capsule size bound did not reject oversized input")
          if not (capsule_policy_record()["execution_enabled"] is False):
              raise PlannerError('explicit proof condition failed near planner line 501')
          print("MNX_CAPSULE_SELF_TEST=PASS")
      
      

      #@MNX-PART id=99.60.mnx-refactor.planner.function.local-state-evidence kind=function title="Python function local_state_evidence"
      def local_state_evidence(path: Path, allowed_fields: tuple[str, ...] = ()) -> dict:
          record: dict = {'path': str(path), 'status': 'absent'}
          try:
              initial = path.lstat()
          except FileNotFoundError:
              return record
          except OSError as exc:
              return {'path': str(path), 'status': 'unreadable', 'error': str(exc)}
          if stat.S_ISLNK(initial.st_mode):
              try:
                  target = os.readlink(path)
              except OSError as exc:
                  return {'path': str(path), 'status': 'unreadable-symlink', 'error': str(exc)}
              return {'path': str(path), 'status': 'symlink', 'target': target, 'payload_read': False, 'fields_extracted': False}
          if not stat.S_ISREG(initial.st_mode):
              return {'path': str(path), 'status': 'unsafe-type', 'mode': stat.S_IFMT(initial.st_mode), 'payload_read': False, 'fields_extracted': False}
          maximum = 1024 * 1024
          if initial.st_size > maximum:
              return {'path': str(path), 'status': 'oversized', 'bytes': initial.st_size, 'maximum_bytes': maximum, 'payload_read': False, 'fields_extracted': False}
          flags = os.O_RDONLY | getattr(os, 'O_CLOEXEC', 0) | getattr(os, 'O_NOFOLLOW', 0)
          try:
              descriptor = os.open(path, flags)
          except FileNotFoundError:
              return {'path': str(path), 'status': 'changed-before-open', 'payload_read': False, 'fields_extracted': False}
          except OSError as exc:
              return {'path': str(path), 'status': 'unreadable-or-symlink-race', 'error': str(exc), 'payload_read': False, 'fields_extracted': False}
          try:
              before = os.fstat(descriptor)
              if not stat.S_ISREG(before.st_mode):
                  return {'path': str(path), 'status': 'unsafe-type-after-open', 'mode': stat.S_IFMT(before.st_mode), 'payload_read': False, 'fields_extracted': False}
              if before.st_size > maximum:
                  return {'path': str(path), 'status': 'oversized', 'bytes': before.st_size, 'maximum_bytes': maximum, 'payload_read': False, 'fields_extracted': False}
              chunks: list[bytes] = []
              total = 0
              while True:
                  chunk = os.read(descriptor, min(65536, maximum + 1 - total))
                  if not chunk:
                      break
                  chunks.append(chunk)
                  total += len(chunk)
                  if total > maximum:
                      return {'path': str(path), 'status': 'oversized-during-read', 'bytes_read': total, 'maximum_bytes': maximum, 'payload_read': False, 'fields_extracted': False}
              raw = b"".join(chunks)
              after = os.fstat(descriptor)
          except OSError as exc:
              return {'path': str(path), 'status': 'unreadable', 'error': str(exc), 'payload_read': False, 'fields_extracted': False}
          finally:
              os.close(descriptor)
          try:
              final_path = path.lstat()
          except OSError:
              return {'path': str(path), 'status': 'changed-after-read', 'payload_read': True, 'fields_extracted': False}
          stable_before = (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns)
          stable_after = (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns)
          stable_path = (final_path.st_dev, final_path.st_ino, final_path.st_size, final_path.st_mtime_ns, final_path.st_ctime_ns)
          if stable_before != stable_after or stable_after != stable_path or len(raw) != after.st_size or not stat.S_ISREG(final_path.st_mode):
              return {'path': str(path), 'status': 'changed-while-reading', 'payload_read': True, 'fields_extracted': False}
          record = {
              'path': str(path),
              'status': 'present',
              'bytes': len(raw),
              'sha256': hashlib.sha256(raw).hexdigest(),
              'modified_utc': dt.datetime.fromtimestamp(after.st_mtime, dt.timezone.utc).isoformat(),
              'payload_read': True,
              'fields_extracted': bool(allowed_fields),
          }
          if allowed_fields:
              text_value = raw.decode('utf-8', errors='replace')
              fields: dict[str, object] = {}
              try:
                  payload = json.loads(text_value)
              except json.JSONDecodeError:
                  payload = None
              if isinstance(payload, dict):
                  for key in allowed_fields:
                      if key in payload and isinstance(payload[key], (str, int, float, bool, type(None))):
                          fields[key] = payload[key]
              else:
                  for line in text_value.splitlines():
                      if '=' not in line:
                          continue
                      key, value = line.split('=', 1)
                      if key in allowed_fields and len(value) <= 1024:
                          fields[key] = value
              record['fields'] = fields
          return record


      #@MNX-PART id=99.60.mnx-refactor.planner.function.systemd-unit-observation kind=function title="Python function systemd_unit_observation"
      def systemd_unit_observation(unit: str) -> dict:
          record = {'unit': unit, 'systemctl_present': False, 'enablement': 'unavailable', 'active_state': 'unavailable', 'result': 'unavailable'}
          systemctl = shutil.which('systemctl')
          if not systemctl:
              return record
          record['systemctl_present'] = True
          try:
              enabled = subprocess.run([systemctl, 'is-enabled', unit], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=20, check=False)
              shown = subprocess.run([systemctl, 'show', '--property=ActiveState', '--value', unit], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=20, check=False)
          except (OSError, subprocess.TimeoutExpired) as exc:
              record['error'] = str(exc)
              return record
          record['enablement'] = enabled.stdout.strip() or ('not-found' if enabled.returncode else 'unknown')
          record['active_state'] = shown.stdout.strip() or ('not-found' if shown.returncode else 'unknown')
          record['result'] = 'observed'
          return record


      #@MNX-PART id=99.60.mnx-refactor.planner.function.backup-soak-review-record kind=function title="Python function backup_soak_review_record"
      def backup_soak_review_record(config: Path) -> dict:
          source = read_port_source(config)
          public_state = {
              'restic_last_success': local_state_evidence(Path('/var/lib/monsternix/job-state/authoritative/m16-restic-m21.last-success')),
              'restic_backup_current': local_state_evidence(Path('/var/lib/monsternix/job-state/authoritative/m16-restic-m21.current.json'), ('schema','product_status','phase','reason','source_sha256','running_system','default_system','evidence_bundle','recorded_at','reconciliation_only','service_started','network_used','credential_read','repository_accessed','backup_filesystems_written')),
              'btrfs_last_success': local_state_evidence(Path('/var/lib/monsternix/job-state/authoritative/m21-btrfs-pull-backup.last-success')),
              'restic_maintenance': local_state_evidence(Path('/var/lib/monsternix/restic-maintenance/current.json'), ('schema','product_status','phase','reason','source_sha256','running_system','default_system','evidence_bundle','recorded_at')),
              'restic_qualification_current': local_state_evidence(Path('/var/lib/monsternix/restic-qualification/current')),
              'restic_automatic_enablement': local_state_evidence(Path('/var/lib/monsternix/restic-qualification/automatic-enabled'), ('schema','source_sha256','running_system','default_system','qualification_run','qualification_manifest_sha256','scheduling_receipt','old_btrfs_timer')),
          }
          units = {
              name: systemd_unit_observation(name)
              for name in ['m16-backup-m21.timer', 'm16-restic-maintenance.timer', 'm21-btrfs-pull-backup.timer']
          }
          unknowns = []
          for key, value in public_state.items():
              if value.get('status') != 'present':
                  unknowns.append(f'{key}:{value.get("status","unknown")}')
          for key, value in units.items():
              if value.get('result') != 'observed':
                  unknowns.append(f'{key}:unit-state-unavailable')
                  continue
              enablement = value.get('enablement', 'unknown')
              active_state = value.get('active_state', 'unknown')
              if enablement in {'unavailable', 'not-found', 'unknown'}:
                  unknowns.append(f'{key}:enablement-{enablement}')
              if active_state in {'unavailable', 'not-found', 'unknown'}:
                  unknowns.append(f'{key}:active-state-{active_state}')
          review_flags = []
          backup_status = public_state['restic_backup_current'].get('fields', {}).get('product_status')
          if backup_status == 'review-required':
              review_flags.append('restic-backup-product-review-required')
          maintenance_status = public_state['restic_maintenance'].get('fields', {}).get('product_status')
          if maintenance_status == 'review-required':
              review_flags.append('restic-maintenance-product-review-required')
          declarations = re.findall(r'(?m)^# MNX_M21_LEGACY_SCHEDULE_POLICY=(.+)$', source['text'])
          legacy_schedule_retired = declarations == ['timer-masked-manual-service-and-all-history-preserved']
          for timer_name, value in units.items():
              expected = 'masked' if timer_name == 'm21-btrfs-pull-backup.timer' and legacy_schedule_retired else 'enabled'
              if value.get('enablement') != expected:
                  review_flags.append(f'{timer_name}:enablement-{value.get("enablement","unknown")}')
              if timer_name == 'm21-btrfs-pull-backup.timer' and legacy_schedule_retired and value.get('active_state') != 'inactive':
                  review_flags.append('legacy-m21-timer:not-inactive')
          source_contracts = {
              'legacy_schedule_retirement_declared': legacy_schedule_retired,
              'legacy_manual_service_retained': 'systemd.services.m21-btrfs-pull-backup = {' in source['text'],
              'later_explicit_candidate_required_for_history_deletion': 'old-history deletion requires a later explicit candidate' in source['text'],
              'automatic_marker_binds_historical_initial_enablement': 'automatic scheduling marker lost the old Btrfs soak boundary' in source['text'],
          }
          for key, value in source_contracts.items():
              if not value:
                  review_flags.append(f'source-contract-missing:{key}')
          return {
              'schema': 'mnx.backup-soak.review.v1',
              'backup_soak_review_schema': BACKUP_SOAK_REVIEW_SCHEMA,
              'status': 'review' if review_flags or unknowns else 'observed',
              'authority': 'read-only-evidence-not-backup-operation-or-retirement-permission',
              'source_sha256': source['sha256'],
              'disposition': 'preserve-both-histories-restic-primary' if legacy_schedule_retired else 'continue-dual-path-soak',
              'legacy_schedule_retirement_declared': legacy_schedule_retired,
              'manual_legacy_service_retained': True,
              'retirement_authorized': False,
              'retirement_candidate_emitted': False,
              'evidence_sufficient_for_retirement': False,
              'backup_job_executed': False,
              'restore_executed': False,
              'maintenance_executed': False,
              'secret_path_read': False,
              'network_used': False,
              'timer_or_retention_mutation': False,
              'history_deleted': False,
              'configuration_mutated': False,
              'public_state': public_state,
              'unit_observations': units,
              'source_contracts': source_contracts,
              'review_flags': sorted(review_flags),
              'unknowns': sorted(unknowns),
