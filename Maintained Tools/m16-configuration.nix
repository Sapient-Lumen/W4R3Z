      HEARTBEAT_CURRENT = Path('/var/lib/monsternix/job-state/authoritative/presslog-heartbeat.current.json')
      RECOVERY_CURRENT = Path('/var/lib/monsternix/job-state/authoritative/presslog-recovery.current.json')
      STARTUP_RUNTIME = Path('/run/monsternix-monsterkey/presslog-startup.json')
      HEARTBEAT_RUNTIME = Path('/run/monsternix-monsterkey/presslog-heartbeat.json')
      RECOVERY_RECEIPT = STATE / 'monsternix/recovery-drill-current.json'
      BTRBK_MAIN_SUCCESS = Path('/var/lib/monsternix/job-state/authoritative/btrbk-main.last-success')
      BTRBK_ARCHIVE_SUCCESS = Path('/var/lib/monsternix/job-state/authoritative/btrbk-archive-to-new-storage.last-success')
      BOOT_ID_PATH = Path('/proc/sys/kernel/random/boot_id')
      PRIMARY_BACKUP_GRACE_SECONDS = 36 * 60 * 60
      SECONDARY_ARCHIVE_GRACE_SECONDS = 9 * 24 * 60 * 60
