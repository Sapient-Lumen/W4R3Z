              index += 1
              prefix_semicolons = 0
              let_depth = 0
              terminator_index: int | None = None
              previous_base = "="
              prefix_introducers = {
                  "=", ":", ";", "then", "else", "||", "&&", "->", "==", "!=",
                  "<", ">", "<=", ">=", "+", "-", "*", "//", "++", "!", "?",
              }
              while index < root_close:
                  token = tokens[index]
                  if token.raw in "{[(":
                      close = matching.get(index)
                      if close is None or close >= root_close:
                          raise AtlasError(f"definition {path} contains an unclosed nested delimiter at {token.line}:{token.column}")
                      previous_base = tokens[close].raw
                      index = close + 1
                      continue
                  if token.kind == "IDENT" and token.raw == "let":
                      let_depth += 1
                      previous_base = token.raw
                      index += 1
                      continue
                  if token.kind == "IDENT" and token.raw == "in" and let_depth:
                      let_depth -= 1
                      previous_base = token.raw
                      index += 1
                      continue
                  if (
                      token.kind == "IDENT"
                      and token.raw in {"with", "assert"}
                      and previous_base in prefix_introducers
                  ):
                      prefix_semicolons += 1
                      previous_base = token.raw
                      index += 1
                      continue
                  if token.raw == ";":
                      if prefix_semicolons:
                          prefix_semicolons -= 1
                          previous_base = ";"
                          index += 1
                          continue
                      if let_depth:
                          previous_base = ";"
                          index += 1
                          continue
                      terminator_index = index
                      break
