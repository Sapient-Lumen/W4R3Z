                      f'temporary_running_system={closure}',
                  ]) + '\n',
                  encoding='utf-8',
              )
              switch_report.write_text(
                  '\n'.join([
                      f'configuration_sha256={source["sha256"]}',
                      'office_acceptance_ready=yes',
                      'office_acceptance_intended_result=PASS',
                      f'office_acceptance_running_system={closure}',
                      f'office_acceptance_default_system={closure}',
                      'office_acceptance_post_audit_rc=0',
                      'office_acceptance_behavior_contract_rc=0',
                      'office_acceptance_old_storage_write=no',
                      'post_switch_audit_rc=0',
                      'behavior_contract_rc=0',
                      'old_storage_direct_write_by_mnx_switch=no',
                  ]) + '\n',
                  encoding='utf-8',
              )
              test_report.chmod(0o640)
              switch_report.chmod(0o640)
              (baseline / 'manifest.txt').chmod(0o640)
              health = root / 'storage.prom'
              health.write_text(f'monsternix_storage_health_observation_timestamp_seconds {int(dt.datetime.now().timestamp())}\nmonsternix_storage_health_problem 0\n', encoding='utf-8')
              overrides = {
                  'MNX_OFFICE_SELF_TEST': '1',
                  'MNX_OFFICE_SWITCH_TRANSACTION': '1',
                  'MNX_OFFICE_CONFIG': str(source_path),
                  'MNX_OFFICE_STATE_ROOT': str(state_root),
                  'MNX_OFFICE_RUNNING_LINK': str(running),
                  'MNX_OFFICE_DEFAULT_LINK': str(default),
                  'MNX_OFFICE_BASELINE_LINK': str(baseline),
                  'MNX_OFFICE_HEALTH_METRICS': str(health),
              }
              previous = {key: os.environ.get(key) for key in overrides}
              os.environ.update(overrides)
              try:
                  try:
                      build_record(
                          argparse.Namespace(
                              test_report=str(test_report),
                              switch_report=str(switch_report),
                              switch_result='FAIL_FAKE',
                          ),
                          source,
                      )
                  except OfficeError:
                      pass
                  else:
                      raise AssertionError('invalid office switch result was accepted')
                  arguments = argparse.Namespace(
                      test_report=str(test_report),
                      switch_report=str(switch_report),
                      switch_result='PASS',
                  )
                  acceptance = build_record(arguments, source)
                  validate_record_against_runtime(
                      acceptance,
                      source,
                      allow_incomplete_switch=True,
                      require_root=False,
                  )
                  canonical_before_finalization = switch_evidence_digest(parse_key_value_report(switch_report))
                  destination = atomic_write_record(state_root, acceptance)
                  assert destination.stat().st_mode & 0o777 == 0o640
                  loaded = load_record(record_path_from_current(state_root), require_root=False)

                  # The office is committed while the switch transcript is still open. Only the explicit
                  # post-commit-seal authority may validate that state, and strict verification still rejects it.
                  switch_report.write_text(
                      switch_report.read_text(encoding='utf-8')
                      + f'candidate_configuration_sha256={source["sha256"]}\n'
                      + 'post_commit_seal_intended_result=PASS\n',
                      encoding='utf-8',
                  )
                  os.environ.pop('MNX_OFFICE_SWITCH_TRANSACTION', None)
                  os.environ['MNX_OFFICE_POST_COMMIT_SEAL'] = '1'
                  runtime = validate_record_against_runtime(
                      loaded,
                      source,
                      allow_incomplete_switch=True,
                      require_root=False,
                  )
                  assert runtime['switch_evidence_digest_mode'] == 'canonical-semantic-source'
                  try:
                      validate_record_against_runtime(loaded, source, require_root=False)
                  except OfficeError:
                      pass
                  else:
                      raise AssertionError('strict office verification accepted an open switch report')
                  os.environ.pop('MNX_OFFICE_POST_COMMIT_SEAL', None)
                  try:
                      validate_record_against_runtime(
                          loaded,
                          source,
                          allow_incomplete_switch=True,
                          require_root=False,
                      )
                  except OfficeError:
                      pass
                  else:
                      raise AssertionError('open switch report was accepted without explicit seal authority')
                  print('MNX_OFFICE_OPEN_SWITCH_SEAL_SELF_TEST=PASS')

                  switch_report.write_text(
                      switch_report.read_text(encoding='utf-8')
                      + 'post_commit_seal_rc=0\n'
                      + 'core_acceptance_result=PASS\n'
                      + 'post_acceptance_status=pass\n'
                      + 'mnx_switch_result=PASS\n',
                      encoding='utf-8',
                  )
                  finalized_switch = parse_key_value_report(switch_report)
                  assert switch_evidence_digest(finalized_switch) == canonical_before_finalization
                  runtime = validate_record_against_runtime(loaded, source, require_root=False)
                  assert runtime['switch_evidence_digest_mode'] == 'canonical-semantic-source'

                  # The office continues to bind core PASS when continuation truthfully reports a blocker.
                  blocked_text = switch_report.read_text(encoding='utf-8').replace(
                      'post_acceptance_status=pass\n',
                      'post_acceptance_status=completed-with-blocker\n',
                  ).replace(
                      'mnx_switch_result=PASS\n',
                      'mnx_switch_result=PASS_WITH_POST_ACCEPTANCE_BLOCKER\n',
                  )
                  switch_report.write_text(blocked_text, encoding='utf-8')
                  runtime = validate_record_against_runtime(loaded, source, require_root=False)
                  assert runtime['switch_evidence_digest_mode'] == 'canonical-semantic-source'
                  switch_report.write_text(
                      blocked_text.replace(
                          'post_acceptance_status=completed-with-blocker\n',
                          'post_acceptance_status=pass\n',
                      ),
                      encoding='utf-8',
                  )
                  try:
                      validate_record_against_runtime(loaded, source, require_root=False)
                  except OfficeError:
                      pass
                  else:
                      raise AssertionError('inconsistent core/final switch result was accepted')
                  switch_report.write_text(blocked_text, encoding='utf-8')
                  print('MNX_OFFICE_CORE_FINAL_SWITCH_RESULT_SELF_TEST=PASS')

                  clean_overlay = continuation_overlay(loaded, source, require_root=False)
                  assert clean_overlay['effective_next_source'] == 'finalized-runtime-overlay'
                  assert clean_overlay['effective_next_objective'] == 'review-post-acceptance-blocker-before-declared-next-objective'
                  receipt = reports / 'post-acceptance.txt'
                  receipt.write_text(
                      '\n'.join([
                          f'source_sha256={source["sha256"]}',
                          'plan=upgrade-build',
                          'status=contract-violation',
                          'action_results=upgrade-build:1',
                          'mutation_proof=FAIL',
                      ]) + '\n',
                      encoding='utf-8',
                  )
                  receipt.chmod(0o640)
                  contract_text = blocked_text.replace(
                      'post_acceptance_status=completed-with-blocker\n',
                      'post_acceptance_plan=upgrade-build\npost_acceptance_status=contract-violation\n'
                      'post_acceptance_action_results=upgrade-build:1\npost_acceptance_mutation_proof=FAIL\n'
                      f'post_acceptance_receipt={receipt}\n',
                  ).replace(
                      'mnx_switch_result=PASS_WITH_POST_ACCEPTANCE_BLOCKER\n',
                      'mnx_switch_result=FAIL_POST_ACCEPTANCE_CONTRACT_AFTER_ACCEPTANCE\n',
                  )
                  switch_report.write_text(contract_text, encoding='utf-8')
                  contract_overlay = continuation_overlay(loaded, source, require_root=False)
                  assert contract_overlay['post_acceptance_receipt_status'] == 'verified'
                  assert contract_overlay['effective_next_source'] == 'finalized-runtime-overlay'
                  assert contract_overlay['effective_next_objective'] == 'reconcile-post-acceptance-contract-before-declared-next-objective'
                  receipt.write_text(receipt.read_text(encoding='utf-8').replace('mutation_proof=FAIL', 'mutation_proof=pass'), encoding='utf-8')
                  try:
                      continuation_overlay(loaded, source, require_root=False)
                  except OfficeError:
                      pass
                  else:
                      raise AssertionError('tampered post-acceptance receipt was accepted')
                  receipt.write_text(receipt.read_text(encoding='utf-8').replace('mutation_proof=pass', 'mutation_proof=FAIL'), encoding='utf-8')
                  switch_report.write_text(blocked_text, encoding='utf-8')
                  print('MNX_OFFICE_RUNTIME_OVERLAY_SELF_TEST=PASS')

                  successor_bytes = fixture_source()
                  successor_bytes = successor_bytes.replace(b'# MNX_DOCUMENT_SCHEMA=20\n', b'# MNX_DOCUMENT_SCHEMA=21\n')
                  successor_bytes = successor_bytes.replace(
                      b'# MNX-END-OF-MONOLITH schema=20 copy-paste-sentinel=present\n',
                      b'# MNX-END-OF-MONOLITH schema=21 copy-paste-sentinel=present\n',
                  )
                  successor_bytes = successor_bytes.replace(b'#@MNX-OFFICE candidate_stage=24\n', b'#@MNX-OFFICE candidate_stage=25\n')
                  successor_bytes = successor_bytes.replace(b'#@MNX-OFFICE accepted_predecessor_stage=23\n', b'#@MNX-OFFICE accepted_predecessor_stage=24\n')
                  successor_bytes = successor_bytes.replace(
                      b'#@MNX-OFFICE accepted_predecessor_sha256=' + (b'a' * 64) + b'\n',
                      b'#@MNX-OFFICE accepted_predecessor_sha256=' + source['sha256'].encode('ascii') + b'\n',
                  )
                  successor_path = root / 'successor-configuration.nix'
                  successor_path.write_bytes(successor_bytes)
                  successor_source = parse_source(successor_path)
                  candidate_closure = root / 'candidate-closure'
                  candidate_closure.mkdir()
                  (candidate_closure / 'configuration.nix').write_bytes(successor_bytes)
                  running.unlink()
                  default.unlink()
                  running.symlink_to(candidate_closure)
                  default.symlink_to(candidate_closure)
                  os.environ['MNX_OFFICE_CONFIG'] = str(successor_path)
                  os.environ['MNX_OFFICE_COMMIT_PENDING'] = '1'
                  pending = validate_commit_pending_record(loaded, successor_source, require_root=False)
                  assert pending['running_system'] == str(candidate_closure)
                  assert pending['default_system'] == str(candidate_closure)
                  assert pending['accepted_predecessor_system'] == str(closure)
                  assert pending['candidate_source_sha256'] == successor_source['sha256']
                  print('MNX_OFFICE_COMMIT_PENDING_RUNTIME_SELF_TEST=PASS')
                  running.unlink()
                  default.unlink()
                  running.symlink_to(closure)
                  default.symlink_to(closure)
                  os.environ['MNX_OFFICE_CONFIG'] = str(source_path)
                  os.environ.pop('MNX_OFFICE_COMMIT_PENDING', None)
      
                  # The already-written first Stage-23 record used the old digest while the candidate alias
                  # was still absent. It must be accepted only as a backward-transition predecessor.
                  legacy_digest = legacy_switch_evidence_digests(finalized_switch)['legacy-pre-finalization-alias-set']
                  legacy_mode = validate_switch_evidence_digest(
                      legacy_digest,
                      finalized_switch,
                      allow_legacy=True,
                  )
                  assert legacy_mode == 'legacy-pre-finalization-alias-set'
                  try:
                      validate_switch_evidence_digest(legacy_digest, finalized_switch)
                  except OfficeError:
                      pass
                  else:
                      raise AssertionError('legacy digest was accepted without the explicit compatibility gate')
      
                  packet = render_resume(loaded, source, runtime, health_summary(health), {
                      'exposure_state': 'PASS', 'exposure_observation_age_seconds': 0, 'policy_mode': 'observe-only',
                      'census_scope': 'host-network-namespace-listeners', 'rpcinfo_state': 'ok',
                      'raw_listener_row_total': 2, 'canonical_listener_total': 1, 'duplicate_listener_row_total': 1,
                      'stable_listener_total': 1, 'declared_listener_total': 1, 'known_listener_total': 1,
                      'review_listener_total': 0, 'undeclared_listener_total': 0, 'unattributed_listener_total': 0,
                      'rpc_attributed_listener_total': 0, 'rpc_program_endpoint_total': 0,
                      'wildcard_listener_total': 0, 'public_listener_total': 0, 'review_group_total': 0,
                      'zone_conforming_total': 1, 'zone_firewall_required_total': 0, 'zone_mismatch_total': 0,
                      'zone_review_total': 0, 'new_listener_total': 0, 'recurring_listener_total': 0,
                      'persistent_listener_total': 1, 'attention_required': 'no',
                  })
                  assert packet['acceptance_state'] == 'accepted'
                  assert packet['accepted_source_sha256'] == source['sha256']
                  assert len(canonical_json(packet)) < MAX_OUTPUT_BYTES
                  source_path.write_bytes(source_path.read_bytes() + b'# tamper\n')
                  tampered = parse_source(source_path)
                  try:
                      validate_record_against_runtime(loaded, tampered, require_root=False)
                  except OfficeError:
                      pass
                  else:
                      raise AssertionError('tampered editable source was accepted')
              finally:
                  for key, value in previous.items():
                      if value is None:
                          os.environ.pop(key, None)
                      else:
                          os.environ[key] = value
          print('MNX_OFFICE_SELF_TEST=PASS')
          return 0
      
      
      #@MNX-PART id=99.08.mnx-office.function.build-parser kind=function title="Python function build_parser"
      def build_parser() -> argparse.ArgumentParser:
          parser = argparse.ArgumentParser(prog='mnx-office', description='Monsternix source agenda and switch-committed acceptance office')
          sub = parser.add_subparsers(dest='command', required=True)
          agenda = sub.add_parser('agenda', help='print the source-owned office agenda')
          agenda.add_argument('--json', action='store_true')
          agenda.set_defaults(handler=command_agenda)
          verify = sub.add_parser('verify', help='validate the switch-committed acceptance record against runtime')
          verify.add_argument('--json', action='store_true')
          verify.add_argument('--allow-missing', action='store_true')
          verify.add_argument('--allow-incomplete-switch', action='store_true', help=argparse.SUPPRESS)
          verify.add_argument('--allow-predecessor', action='store_true')
          verify.add_argument('--allow-commit-pending', action='store_true', help=argparse.SUPPRESS)
          verify.set_defaults(handler=command_verify)
          resume = sub.add_parser('resume', help='print a bounded amnesiac-successor packet')
          resume.add_argument('--json', action='store_true')
          resume.set_defaults(handler=command_resume)
          commit = sub.add_parser('commit', help='atomically commit the accepted office record after a successful switch')
          commit.add_argument('--test-report', required=True)
          commit.add_argument('--switch-report', required=True)
          commit.add_argument('--switch-result', required=True)
          commit.set_defaults(handler=command_commit)
          evidence = sub.add_parser('health-evidence', help='read bounded local hardware and backup evidence without mutation or network')
          evidence.add_argument('--json', action='store_true')
          evidence.set_defaults(handler=command_health_evidence)
          inventory = sub.add_parser('m21-source-inventory', help='sealed-switch-only read-only pinned m21 topology action')
          inventory.add_argument('--switch-owned', action='store_true', required=True)
          inventory.set_defaults(handler=command_m21_source_inventory)
          self_test = sub.add_parser('self-test')
          self_test.set_defaults(handler=command_self_test)
          return parser
      
      
      #@MNX-PART id=99.08.mnx-office.function.main kind=function title="Python function main"
      def main(argv: list[str] | None = None) -> int:
          parser = build_parser()
          args = parser.parse_args(argv)
          try:
              return int(args.handler(args))
          except OfficeError as exc:
              print(f'MNX_OFFICE_ERROR: {exc}', file=sys.stderr)
              return 1
      
      
      if __name__ == '__main__':
          raise SystemExit(main())
      '';
      checkPhase = ''
        set -Eeuo pipefail
        ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; path=pathlib.Path(sys.argv[1]); compile(path.read_text(encoding="utf-8"), str(path), "exec")' "$out"
        "$out" self-test
      '';
    };
  };

  #####################################################################################################
  # SECTION 99 / OPERATOR COMMAND DISPATCHER
  #####################################################################################################

#@MNX-CHUNK id=99.10 slug=mnx-dispatcher title="Primary mnx operator command dispatcher"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx" section=99.10 role=generated-program ordinal=266
  environment.etc."monsternix/bin/mnx" = {
    source = pkgs.writeTextFile {
      name = "mnx";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      set -Eeuo pipefail
      export LC_ALL=C

      COMMAND="''${1:-wake}"
      shift || true

      #@MNX-PART id=99.10.mnx.function.latest_completed_test kind=function title="Function latest_completed_test"
      latest_completed_test() {
        local _stamp _candidate _selected=""
        while IFS=' ' read -r _stamp _candidate; do
          [[ -z "$_selected" ]] || continue
          [[ -n "$_candidate" && -r "$_candidate" ]] || continue
          if ${pkgs.gnugrep}/bin/grep -Eq '^(mnx_test_result|mnx_bootstrap_test_result)=' "$_candidate"; then
            _selected="$_candidate"
          fi
        done < <(
          ${pkgs.findutils}/bin/find /var/lib/logbook/support -maxdepth 1 -type f \
            \( -name 'mnx-test-*.txt' -o -name 'mnx-bootstrap-test-*.txt' \) \
            -printf '%T@ %p\n' 2>/dev/null | ${pkgs.coreutils}/bin/sort -nr
        )
        printf '%s\n' "$_selected"
      }

      #@MNX-PART id=99.10.mnx.function.latest_completed_switch kind=function title="Function latest_completed_switch"
      latest_completed_switch() {
        local _stamp _candidate _selected=""
        while IFS=' ' read -r _stamp _candidate; do
          [[ -z "$_selected" ]] || continue
          [[ -n "$_candidate" && -r "$_candidate" ]] || continue
          if ${pkgs.gnugrep}/bin/grep -q '^mnx_switch_result=' "$_candidate"; then
            _selected="$_candidate"
          fi
        done < <(
          ${pkgs.findutils}/bin/find /var/lib/logbook/support -maxdepth 1 -type f -name 'mnx-switch-*.txt' -printf '%T@ %p\n' 2>/dev/null | ${pkgs.coreutils}/bin/sort -nr
        )
        printf '%s\n' "$_selected"
      }

      #@MNX-PART id=99.10.mnx.function.parse_nvme_temperature kind=function title="Function parse_nvme_temperature"
      parse_nvme_temperature() {
        ${pkgs.gawk}/bin/awk -F: '$1 ~ /^temperature[[:space:]]*$/ && !found { value=$2; sub(/^[^0-9]*/,"",value); sub(/[^0-9].*$/,"",value); if (value ~ /^[0-9]+$/) { print value; found=1 } } END { if (!found) exit 1 }'
      }

      #@MNX-PART id=99.10.mnx.function.first_storage_lock_holder kind=function title="Function first_storage_lock_holder"
      first_storage_lock_holder() {
        ${pkgs.gawk}/bin/awk '$3 == "/run/storage-maintenance.lock" && !found { print $1 ":" $2; found=1 }'
      }

      #@MNX-PART id=99.10.mnx.function.status_self_test kind=function title="Function status_self_test"
      status_self_test() {
        local _temp _lock
        _temp="$(printf '%s\n' 'temperature : 55 °C (328 K)' | parse_nvme_temperature)"
        [[ "$_temp" == 55 ]] || { echo "MNX_STATUS_SELF_TEST_ERROR: Celsius parser returned $_temp" >&2; return 1; }
        _lock="$(printf '%s\n' 'bash 123 /run/storage-maintenance.lock' 'other 999 /elsewhere' 'bash 456 /run/storage-maintenance.lock' | first_storage_lock_holder)"
        [[ "$_lock" == bash:123 ]] || { echo "MNX_STATUS_SELF_TEST_ERROR: lock parser returned $_lock" >&2; return 1; }
        echo 'MNX_STATUS_SELF_TEST=PASS'
      }

      #@MNX-PART id=99.10.mnx.function.storage_health kind=function title="Function storage_health"
      storage_health() {
        if [[ ''${EUID:-$(${pkgs.coreutils}/bin/id -u)} -ne 0 ]]; then
          [[ -x /run/wrappers/bin/sudo ]] || { echo '/run/wrappers/bin/sudo is unavailable' >&2; return 126; }
          exec /run/wrappers/bin/sudo -- /etc/monsternix/bin/mnx health "$@"
        fi

        set +e
        ${pkgs.systemd}/bin/systemctl start mnx-storage-health.service
        local _service_rc="$?"
        set -e

        local _metric=/var/lib/node-exporter-textfile/monsternix_storage.prom
        local _report _problem _warning _history _memory _advisory _journal_state _journal_clean _journal_bundle _journal_anchor _journal_boundary _journal_review=0 _journal_new=0 _journal_legacy=0 _journal_archived=0
        _report="$(${pkgs.findutils}/bin/find /var/lib/logbook/daily -maxdepth 1 -type f -name 'storage-health-*.txt' -printf '%T@ %p\n' 2>/dev/null | ${pkgs.coreutils}/bin/sort -nr | ${pkgs.coreutils}/bin/head -n 1 | ${pkgs.gawk}/bin/awk '{ $1=""; sub(/^ /, ""); print }')"
        printf 'storage_health_service_rc=%s\n' "$_service_rc"
        printf 'storage_health_report=%s\n' "''${_report:-none}"

        if [[ ! -r "$_metric" ]]; then
          echo 'storage_health_metric=missing'
          echo 'MNX_HEALTH=FAIL'
          return 1
        fi

        ${pkgs.gnugrep}/bin/grep -E '^(monsternix_storage_health_|monsternix_memory_pressure_seen_last_24h|monsternix_btrfs_baseline_)' "$_metric" || true
        _problem="$(${pkgs.gawk}/bin/awk '$1 == "monsternix_storage_health_problem" { print $2; exit }' "$_metric")"
        _warning="$(${pkgs.gawk}/bin/awk '$1 == "monsternix_storage_health_warning" { print $2; exit }' "$_metric")"
        _history="$(${pkgs.gawk}/bin/awk '$1 == "monsternix_storage_health_history_problem" { print $2; exit }' "$_metric")"
        _memory="$(${pkgs.gawk}/bin/awk '$1 == "monsternix_memory_pressure_seen_last_24h" { print $2; exit }' "$_metric")"
        _advisory="$(${pkgs.gawk}/bin/awk '$1 == "monsternix_storage_health_advisory" { print $2; exit }' "$_metric")"
        printf 'storage_history_problem=%s\n' "''${_history:-unknown}"
        printf 'memory_pressure_seen_last_24h=%s\n' "''${_memory:-unknown}"
        printf 'storage_advisory=%s\n' "''${_advisory:-unknown}"
        /etc/monsternix/bin/mnx-office health-evidence || echo 'officer_health_collection=unavailable'

        if [[ -r /var/lib/monsternix/journal-integrity/current.json ]]; then
          _journal_state="$(${pkgs.jq}/bin/jq -r '.overall_status // "unknown"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo unknown)"
          _journal_clean="$(${pkgs.jq}/bin/jq -r '.clean_forward.status // (if .overall_status == "malfunction" then "unknown-observer-malfunction" elif .overall_status == "review-required" then "unanchored" else "unanchored" end)' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo unknown)"
          _journal_bundle="$(${pkgs.jq}/bin/jq -r '.evidence_bundle // "none"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo none)"
          _journal_anchor="$(${pkgs.jq}/bin/jq -r '.anchor.path // "none"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo none)"
          _journal_boundary="$(${pkgs.jq}/bin/jq -r '.recovery_boundary.path // "none"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo none)"
        else
          _journal_state=unknown
          _journal_clean=unknown
          _journal_bundle=none
          _journal_anchor=none
          _journal_boundary=none
        fi
        printf 'journal_integrity_state=%s\n' "$_journal_state"
        printf 'journal_integrity_clean_forward_status=%s\n' "$_journal_clean"
        printf 'journal_integrity_anchor=%s\n' "$_journal_anchor"
        printf 'journal_integrity_recovery_boundary=%s\n' "$_journal_boundary"
        printf 'journal_integrity_evidence=%s\n' "$_journal_bundle"
        case "$_journal_state:$_journal_clean" in
          malfunction:*|*:unknown-observer-malfunction) echo 'MNX_HEALTH=FAIL'; return 1 ;;
          *:new-damage-review-required) _journal_review=1; _journal_new=1 ;;
          *:legacy-damage-only) _journal_review=1; _journal_legacy=1 ;;
          *:known-archived-damage-clean-forward) _journal_review=1; _journal_archived=1 ;;
          *:known-damage-no-longer-observed-clean-forward) _journal_review=1; _journal_archived=1 ;;
          *:unanchored|review-required:unknown) _journal_review=1 ;;
          *:legacy-damage-no-longer-observed|*:clean|clean:unknown|unknown:unknown) ;;
          *) echo 'MNX_HEALTH=FAIL'; return 1 ;;
        esac

        [[ "$_service_rc" -eq 0 ]] || { echo 'MNX_HEALTH=FAIL'; return 1; }
        case "$_problem" in
          0) ;;
          *) echo 'MNX_HEALTH=FAIL'; return 1 ;;
        esac
        if [[ "$_warning" == 1 && "$_journal_new" == 1 ]]; then
          echo 'MNX_HEALTH=PASS_WITH_WARNING_AND_NEW_JOURNAL_DAMAGE_REVIEW'
        elif [[ "$_journal_new" == 1 ]]; then
          echo 'MNX_HEALTH=PASS_WITH_NEW_JOURNAL_DAMAGE_REVIEW'
        elif [[ "$_warning" == 1 && "$_journal_archived" == 1 ]]; then
          echo 'MNX_HEALTH=PASS_WITH_WARNING_AND_KNOWN_ARCHIVED_JOURNAL_REVIEW'
        elif [[ "$_journal_archived" == 1 ]]; then
          echo 'MNX_HEALTH=PASS_WITH_KNOWN_ARCHIVED_JOURNAL_REVIEW'
        elif [[ "$_warning" == 1 && "$_journal_legacy" == 1 ]]; then
          echo 'MNX_HEALTH=PASS_WITH_WARNING_AND_LEGACY_JOURNAL_REVIEW'
        elif [[ "$_journal_legacy" == 1 ]]; then
          echo 'MNX_HEALTH=PASS_WITH_LEGACY_JOURNAL_REVIEW'
        elif [[ "$_warning" == 1 && "$_journal_review" == 1 ]]; then
          echo 'MNX_HEALTH=PASS_WITH_WARNING_AND_REVIEW'
        elif [[ "$_warning" == 1 ]]; then
          echo 'MNX_HEALTH=PASS_WITH_WARNING'
        elif [[ "$_journal_review" == 1 ]]; then
          echo 'MNX_HEALTH=PASS_WITH_REVIEW'
        else
          echo 'MNX_HEALTH=PASS'
        fi
      }

      #@MNX-PART id=99.10.mnx.function.exposure_refresh kind=function title="Function exposure_refresh"
      exposure_refresh() {
        if [[ ''${EUID:-$(${pkgs.coreutils}/bin/id -u)} -ne 0 ]]; then
          [[ -x /run/wrappers/bin/sudo ]] || { echo '/run/wrappers/bin/sudo is unavailable' >&2; return 126; }
          exec /run/wrappers/bin/sudo -- /etc/monsternix/bin/mnx exposure refresh "$@"
        fi
        (( $# == 0 )) || { echo 'usage: mnx exposure refresh' >&2; return 64; }

        ${pkgs.systemd}/bin/systemctl reset-failed mnx-listener-census.service 2>/dev/null || true
        if ! ${pkgs.systemd}/bin/systemctl start mnx-listener-census.service; then
          echo 'MNX_EXPOSURE_REFRESH_ERROR: mnx-listener-census.service failed' >&2
          ${pkgs.systemd}/bin/systemctl status mnx-listener-census.service --no-pager --full >&2 || true
          ${pkgs.systemd}/bin/journalctl -u mnx-listener-census.service -n 120 --no-pager -o short-iso >&2 || true
          return 1
        fi
        exec /etc/monsternix/bin/mnx-exposure summary
      }

      #@MNX-PART id=99.10.mnx.function.mnx-office-verify-json kind=function title="Function mnx_office_verify_json"
      mnx_office_verify_json() {
        local _running _default _source
        _running="$(${pkgs.coreutils}/bin/readlink -f /run/current-system 2>/dev/null || true)"
        _default="$(${pkgs.coreutils}/bin/readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
        [[ -n "$_running" && -n "$_default" ]] || return 1
        if [[ "''${MNX_OFFICE_COMMIT_PENDING:-0}" == 1 ]]; then
          [[ "$_running" == "$_default" ]] || return 1
          _source="$_running/configuration.nix"
          MNX_OFFICE_CONFIG="$_source" /etc/monsternix/bin/mnx-office verify --allow-commit-pending --json
        elif [[ "''${MNX_OFFICE_POST_COMMIT_SEAL:-0}" == 1 ]]; then
          [[ "$_running" == "$_default" ]] || return 1
          _source="$_running/configuration.nix"
          MNX_OFFICE_POST_COMMIT_SEAL=1 MNX_OFFICE_CONFIG="$_source" /etc/monsternix/bin/mnx-office verify --allow-incomplete-switch --json
        elif [[ "$_running" == "$_default" ]]; then
          _source="$_running/configuration.nix"
          MNX_OFFICE_CONFIG="$_source" /etc/monsternix/bin/mnx-office verify --json
        else
          _source="$_default/configuration.nix"
          MNX_OFFICE_CONFIG="$_source" /etc/monsternix/bin/mnx-office verify --allow-predecessor --json
        fi
      }

      #@MNX-PART id=99.10.mnx.function.mnx-document-schema kind=function title="Function mnx_document_schema"
      mnx_document_schema() {
        ${pkgs.gnused}/bin/sed -n -E 's/^# MNX_DOCUMENT_SCHEMA=([1-9][0-9]*)$/\1/p' "$1" | ${pkgs.coreutils}/bin/tail -n 1
      }

      #@MNX-PART id=99.10.mnx.function.mnx-source-coherence kind=function title="Function mnx_source_coherence"
      mnx_source_coherence() {
        local _editable="$1" _active="$2" _default="$3" _running="$4" _boot_default="$5"
        if [[ -n "$_editable" && "$_editable" == "$_active" && "$_active" == "$_default" && "$_running" == "$_boot_default" ]]; then
          echo accepted
        elif [[ -n "$_editable" && "$_editable" == "$_active" && "$_active" != "$_default" && "$_running" != "$_boot_default" ]]; then
          echo candidate-temporarily-active
        elif [[ -n "$_editable" && "$_editable" != "$_active" && "$_active" == "$_default" && "$_running" == "$_boot_default" ]]; then
          echo editable-candidate-not-active
        else
          echo mismatch
        fi
      }

      #@MNX-PART id=99.10.mnx.function.mnx-boolish-digit kind=function title="Function mnx_boolish_digit"
      mnx_boolish_digit() {
        case "''${1:-unknown}" in
          1|yes|true|on) echo 1 ;;
          0|no|false|off) echo 0 ;;
          *) echo unknown ;;
        esac
      }

      #@MNX-PART id=99.10.mnx.function.mnx-brief-next-action kind=function title="Function mnx_brief_next_action"
      mnx_brief_next_action() {
        local _office_ok="$1" _failed="$2" _transaction="$3" _coherence="$4" _health="$5"
        local _critical="$6" _stale="$7" _m21="$8" _journal="$9" _temporary="''${10}" _exposure="''${11}"
        local _effective="''${12:-}" _effective_source="''${13:-}"
        if [[ "$_office_ok" != 1 ]]; then echo inspect-office-evidence
        elif [[ "$_failed" =~ ^[0-9]+$ ]] && (( _failed > 0 )); then echo inspect-failed-units
        elif [[ "$_transaction" == 1 ]]; then echo inspect-active-transaction
        elif [[ "$_coherence" == editable-candidate-not-active ]]; then echo run-mnx-test
        elif [[ "$_coherence" == candidate-temporarily-active ]]; then echo review-tested-candidate-then-run-mnx-switch
        elif [[ "$_coherence" == mismatch ]]; then echo investigate-source-closure-mismatch
        elif [[ "$_effective_source" == finalized-runtime-overlay && -n "$_effective" && "$_effective" != unknown ]]; then echo "$_effective"
        elif [[ "$_health" != 0 && "$_health" != unknown ]]; then echo run-mnx-health
        elif [[ "$_critical" == 1 ]]; then echo run-essential-backup-catchup
        elif [[ "$_stale" == 1 ]]; then echo inspect-backup-freshness
        elif [[ "$_m21" == review-required ]]; then echo review-m21-helper-trust
        elif [[ "$_journal" == unknown-observer-malfunction || "$_journal" == malfunction ]]; then echo inspect-journal-observer-malfunction
        elif [[ "$_journal" == new-damage-review-required ]]; then echo review-new-journal-damage
        elif [[ "$_journal" == unanchored ]]; then echo establish-journal-legacy-anchor
        elif [[ "$_journal" == review-required ]]; then echo review-journal-integrity
        elif [[ "$_temporary" =~ ^[0-9]+$ ]] && (( _temporary > 0 )); then echo remove-or-promote-temporary-code
        elif [[ "$_exposure" =~ ^[0-9]+$ ]] && (( _exposure > 0 )); then echo review-network-exposure
        else echo no-urgent-action
        fi
      }

      #@MNX-PART id=99.10.mnx.function.doctor-command kind=function title="Function doctor_command"
      doctor_command() {
        local _json=0 _required=none _config="''${MNX_DOCTOR_CONFIG:-/etc/nixos/configuration.nix}"
        local _kernel=unknown _architecture=unknown _schema=unknown _sentinel=unknown _entry_source=unreadable
        local _entry=0 _inspect=0 _source=0 _runtime=0 _office=0 _transaction=0 _machine=0 _requirement=1
        local _overall=partial _office_json='{}' _missing_json _missing_csv _first _expected _running _default
        local -a _missing=()

        while (( $# > 0 )); do
          case "$1" in
            --json) _json=1; shift ;;
            --require)
              [[ $# -ge 2 ]] || { echo 'mnx doctor --require needs a tier' >&2; return 64; }
              _required="$2"; shift 2 ;;
            help|-h|--help)
              echo 'mnx doctor [--json] [--require entry|inspect|source|runtime|office|transaction|machine]'
              return 0 ;;
            *) echo "unknown mnx doctor option: $1" >&2; return 64 ;;
          esac
        done

        _kernel="$(${pkgs.coreutils}/bin/uname -s 2>/dev/null || echo unknown)"
        _architecture="$(${pkgs.coreutils}/bin/uname -m 2>/dev/null || echo unknown)"
        if (( BASH_VERSINFO[0] >= 4 )) && [[ "$_kernel" == Linux ]] && ${pkgs.coreutils}/bin/env -S true >/dev/null 2>&1; then
          _entry=1
        else
          _missing+=(entry-runtime)
        fi

        if [[ -r "$_config" && -f "$_config" && ! -L "$_config" ]]; then
          IFS= read -r _first < "$_config" || true
          case "$_first" in
            '#!/usr/bin/env -S bash -c '*) _entry_source=recognized-mnx-polyglot ;;
            *) _entry_source=unrecognized ;;
          esac
        else
          _missing+=(editable-source)
        fi
        if (( _entry )) && [[ "$_entry_source" == recognized-mnx-polyglot ]] &&
           [[ -x ${pkgs.coreutils}/bin/sha256sum && -x ${pkgs.findutils}/bin/find && -x ${pkgs.gnugrep}/bin/grep && -x ${pkgs.gnused}/bin/sed && -x ${pkgs.gawk}/bin/awk ]]; then
          _inspect=1
        else
          _missing+=(inspection-surface)
        fi

        if (( _inspect )); then
          _schema="$(mnx_document_schema "$_config")"
          if [[ "$_schema" =~ ^[1-9][0-9]*$ ]]; then
            _expected="# MNX-END-OF-MONOLITH schema=$_schema copy-paste-sentinel=present"
            _sentinel="$(${pkgs.gawk}/bin/awk 'NF { last=$0 } END { print last }' "$_config")"
          fi
          if [[ "$_sentinel" == "$_expected" ]] && [[ -x /etc/monsternix/bin/mnx-source-lexer ]] &&
             [[ -x /etc/monsternix/bin/mnx-eject && -x /etc/monsternix/bin/mnx-upgrade ]] &&
             [[ -x ${pkgs.nix}/bin/nix-instantiate && -x ${pkgs.jq}/bin/jq ]] &&
             command_surface_self_test >/dev/null 2>&1 &&
             ${pkgs.nix}/bin/nix-instantiate --parse "$_config" >/dev/null 2>&1; then
            _source=1
          else
            _missing+=(source-tier)
          fi
        fi

        _running="$(${pkgs.coreutils}/bin/readlink -f /run/current-system 2>/dev/null || true)"
        _default="$(${pkgs.coreutils}/bin/readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
        if (( _source )) && [[ -d /run/systemd/system && -n "$_running" && -n "$_default" ]] &&
           [[ -x ${pkgs.systemd}/bin/systemctl && -x ${pkgs.systemd}/bin/journalctl && -x ${pkgs.iproute2}/bin/ss ]]; then
          _runtime=1
        else
          _missing+=(runtime-tier)
        fi

        if (( _runtime )) && _office_json="$(mnx_office_verify_json 2>/dev/null)" &&
           ${pkgs.jq}/bin/jq -e '.office_acceptance_state == "accepted" or .office_acceptance_state == "committed-pending-final-seal" or .office_acceptance_state == "predecessor-valid-during-candidate" or .office_acceptance_state == "predecessor-valid-during-switch-commit"' >/dev/null <<< "$_office_json"; then
          _office=1
        else
          _office_json='{}'
          _missing+=(office-tier)
        fi

        if (( _runtime && _office )) && [[ -x /run/wrappers/bin/sudo ]] &&
           [[ -x /etc/monsternix/bin/mnx-test && -x /etc/monsternix/bin/mnx-switch ]] &&
           [[ -x ${pkgs.util-linux}/bin/flock && -x ${pkgs.util-linux}/bin/setsid ]] &&
           [[ -x ${pkgs.nix}/bin/nix-env && -x ${pkgs.nix}/bin/nix-store ]] &&
           [[ -x ${pkgs.nixos-rebuild}/bin/nixos-rebuild ]]; then
          _transaction=1
        else
          _missing+=(transaction-tier)
        fi

        if (( _transaction )) && [[ -x /etc/monsternix/bin/mnx-exposure && -x /etc/monsternix/bin/mnx-m21-identity && -x /etc/monsternix/bin/mnx-btrfs-baseline && -x /etc/monsternix/bin/mnx-journal-integrity && -x /etc/monsternix/bin/mnx-upgrade ]] &&
           ${pkgs.util-linux}/bin/mountpoint -q /mnt/m16-backup-nvme &&
           ${pkgs.util-linux}/bin/mountpoint -q /mnt/m16-new-storage &&
           ${pkgs.util-linux}/bin/mountpoint -q /mnt/m16-old-storage; then
          _machine=1
          _overall=ready
        else
          _missing+=(machine-adapters)
        fi

        case "$_required" in
          none) _requirement=1 ;;
          entry) _requirement=$_entry ;;
          inspect) _requirement=$_inspect ;;
          source) _requirement=$_source ;;
          runtime) _requirement=$_runtime ;;
          office) _requirement=$_office ;;
          transaction) _requirement=$_transaction ;;
          machine) _requirement=$_machine ;;
          *) echo "unknown doctor tier: $_required" >&2; return 64 ;;
        esac

        _missing_json="$(printf '%s\n' "''${_missing[@]}" | ${pkgs.jq}/bin/jq -R -s 'split("\n") | map(select(length > 0)) | unique')"
        _missing_csv="$(IFS=,; echo "''${_missing[*]}")"
        if (( _json )); then
          ${pkgs.jq}/bin/jq -n \
            --arg schema mnx.doctor.v1 --arg status "$([[ $_requirement == 1 ]] && echo pass || echo insufficient)" \
            --arg overall "$_overall" --arg required "$_required" --arg kernel "$_kernel" --arg architecture "$_architecture" \
            --arg config "$_config" --arg source_kind "$_entry_source" --arg document_schema "$_schema" \
            --argjson entry "$_entry" --argjson inspect "$_inspect" --argjson source "$_source" \
            --argjson runtime "$_runtime" --argjson office_ready "$_office" --argjson transaction "$_transaction" \
            --argjson machine "$_machine" --argjson office "$_office_json" --argjson missing "$_missing_json" \
            '{schema:$schema,status:$status,overall:$overall,required_tier:$required,network_used:false,mutation:"none",host:{kernel:$kernel,architecture:$architecture},source:{path:$config,entry_kind:$source_kind,document_schema:$document_schema},tiers:{entry:($entry==1),inspect:($inspect==1),source:($source==1),runtime:($runtime==1),office:($office_ready==1),transaction:($transaction==1),machine:($machine==1)},office:$office,missing:$missing}'
        else
          printf 'schema=mnx.doctor.v1\noverall=%s\nrequired_tier=%s\n' "$_overall" "$_required"
          printf 'kernel=%s\narchitecture=%s\nsource=%s\nentry_source=%s\ndocument_schema=%s\n' "$_kernel" "$_architecture" "$_config" "$_entry_source" "$_schema"
          printf 'tier_entry=%s\ntier_inspect=%s\ntier_source=%s\ntier_runtime=%s\ntier_office=%s\ntier_transaction=%s\ntier_machine=%s\n' \
            "$([[ $_entry == 1 ]] && echo yes || echo no)" "$([[ $_inspect == 1 ]] && echo yes || echo no)" \
            "$([[ $_source == 1 ]] && echo yes || echo no)" "$([[ $_runtime == 1 ]] && echo yes || echo no)" \
            "$([[ $_office == 1 ]] && echo yes || echo no)" "$([[ $_transaction == 1 ]] && echo yes || echo no)" \
            "$([[ $_machine == 1 ]] && echo yes || echo no)"
          printf 'missing=%s\nnetwork_used=no\nmutation=none\n' "''${_missing_csv:-none}"
          [[ "$_requirement" == 1 ]] && echo 'MNX_DOCTOR=PASS' || echo 'MNX_DOCTOR=INSUFFICIENT'
        fi
        [[ "$_requirement" == 1 ]]
      }

      #@MNX-PART id=99.10.mnx.function.brief-collect-json kind=function title="Function brief_collect_json"
      brief_collect_json() {
        local _observed _editable_sha _active_sha _default_sha _schema _running _default _relation _coherence
        local _system_state _failed_text _failed_count _failed_json _office_json='{}' _office_ok=0 _agenda_json='{}'
        local _office_final_switch=unknown _office_post_status=unknown _office_mutation=unknown _office_effective_next=unknown _office_effective_source=unknown
        local _test_report _test_result _switch_report _switch_result _health_file _health_problem _health_warning _health_advisory
        local _fresh_file _fresh_stale _fresh_critical _fresh_action _exposure_output _exposure_status _exposure_review
        local _temp_output _temp_count _m21_block _journal_state _journal_clean _journal_bundle _journal_anchor_present _journal_anchor_path _journal_boundary_present _journal_boundary_path _journal_boundary_mode _journal_active_forward _journal_new_count
        local _transaction_active=0 _transaction_kind=none _transaction_phase=none _state _phase
        local _next _status _unknown_json
        local -a _unknowns=()

        _observed="$(${pkgs.coreutils}/bin/date -Is)"
        _editable_sha="$(${pkgs.coreutils}/bin/sha256sum /etc/nixos/configuration.nix 2>/dev/null | ${pkgs.gawk}/bin/awk '{print $1}' || true)"
        _active_sha="$(${pkgs.coreutils}/bin/sha256sum /run/current-system/configuration.nix 2>/dev/null | ${pkgs.gawk}/bin/awk '{print $1}' || true)"
        _default_sha="$(${pkgs.coreutils}/bin/sha256sum /nix/var/nix/profiles/system/configuration.nix 2>/dev/null | ${pkgs.gawk}/bin/awk '{print $1}' || true)"
        _schema="$(mnx_document_schema /etc/nixos/configuration.nix)"
        _running="$(${pkgs.coreutils}/bin/readlink -f /run/current-system 2>/dev/null || true)"
        _default="$(${pkgs.coreutils}/bin/readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
        [[ "$_running" == "$_default" ]] && _relation=running-is-boot-default || _relation=running-is-temporary
        _coherence="$(mnx_source_coherence "$_editable_sha" "$_active_sha" "$_default_sha" "$_running" "$_default")"
        _system_state="$(${pkgs.systemd}/bin/systemctl is-system-running 2>/dev/null || true)"
        _failed_text="$(${pkgs.systemd}/bin/systemctl --failed --no-legend --plain 2>/dev/null | ${pkgs.gawk}/bin/awk 'NF {print $1}' | ${pkgs.coreutils}/bin/head -n 5 || true)"
        _failed_count="$(printf '%s\n' "$_failed_text" | ${pkgs.gawk}/bin/awk 'NF {count++} END {print count+0}')"
        _failed_json="$(printf '%s\n' "$_failed_text" | ${pkgs.jq}/bin/jq -R -s 'split("\n") | map(select(length > 0))')"

        _agenda_json="$(MNX_OFFICE_CONFIG=/etc/nixos/configuration.nix /etc/monsternix/bin/mnx-office agenda --json 2>/dev/null || true)"
        if ! ${pkgs.jq}/bin/jq -e 'type == "object" and .amnesia_capsule.present == true' >/dev/null <<< "$_agenda_json"; then
          _agenda_json='{}'
          _unknowns+=(source-amnesia-capsule)
        fi

        if [[ "$_coherence" == accepted && "''${MNX_OFFICE_COMMIT_PENDING:-0}" != 1 && "''${MNX_OFFICE_POST_COMMIT_SEAL:-0}" != 1 ]]; then
          _office_json="$(MNX_OFFICE_CONFIG="$_running/configuration.nix" /etc/monsternix/bin/mnx-office resume --json 2>/dev/null || true)"
        else
          _office_json="$(mnx_office_verify_json 2>/dev/null || true)"
        fi
        if ${pkgs.jq}/bin/jq -e 'type == "object"' >/dev/null <<< "$_office_json"; then
          _office_ok=1
          _office_final_switch="$(${pkgs.jq}/bin/jq -r '.latest_switch_result // "unknown"' <<< "$_office_json")"
          _office_post_status="$(${pkgs.jq}/bin/jq -r '.post_acceptance_status // "unknown"' <<< "$_office_json")"
          _office_mutation="$(${pkgs.jq}/bin/jq -r '.post_acceptance_mutation_proof // "unknown"' <<< "$_office_json")"
          _office_effective_next="$(${pkgs.jq}/bin/jq -r '.effective_next_objective // "unknown"' <<< "$_office_json")"
          _office_effective_source="$(${pkgs.jq}/bin/jq -r '.effective_next_source // "unknown"' <<< "$_office_json")"
        else
          _office_json='{}'
          _unknowns+=(office-verification)
        fi
        if [[ "$_office_effective_next" == unknown ]]; then
          _office_effective_next="$(${pkgs.jq}/bin/jq -r '.after_acceptance_next_objective // "unknown"' <<< "$_agenda_json")"
          _office_effective_source=source-agenda
        fi

        _test_report="$(latest_completed_test)"
        _test_result="$(${pkgs.gnused}/bin/sed -n -E 's/^(mnx_test_result|mnx_bootstrap_test_result)=//p' "$_test_report" 2>/dev/null | ${pkgs.coreutils}/bin/tail -n 1 || true)"
        _switch_report="$(latest_completed_switch)"
        _switch_result="$(${pkgs.gnused}/bin/sed -n 's/^mnx_switch_result=//p' "$_switch_report" 2>/dev/null | ${pkgs.coreutils}/bin/tail -n 1 || true)"
        [[ -n "$_test_result" ]] || _unknowns+=(latest-test)
        [[ -n "$_switch_result" ]] || _unknowns+=(latest-switch)

        _health_file=/var/lib/node-exporter-textfile/monsternix_storage.prom
        if [[ -r "$_health_file" ]]; then
          _health_problem="$(mnx_metric_value monsternix_storage_health_problem "$_health_file")"
          _health_warning="$(mnx_metric_value monsternix_storage_health_warning "$_health_file")"
          _health_advisory="$(mnx_metric_value monsternix_storage_health_advisory "$_health_file")"
        else
          _health_problem=unknown; _health_warning=unknown; _health_advisory=unknown; _unknowns+=(storage-health)
        fi

        _fresh_file=/var/lib/logbook/backups/freshness-current.txt
        if [[ -r "$_fresh_file" ]]; then
          _fresh_stale="$(mnx_boolish_digit "$(${pkgs.gnused}/bin/sed -n 's/^overall_stale=//p' "$_fresh_file" | ${pkgs.coreutils}/bin/tail -n 1)")"
          _fresh_critical="$(mnx_boolish_digit "$(${pkgs.gnused}/bin/sed -n 's/^overall_critical=//p' "$_fresh_file" | ${pkgs.coreutils}/bin/tail -n 1)")"
          _fresh_action="$(${pkgs.gnused}/bin/sed -n 's/^action=//p' "$_fresh_file" | ${pkgs.coreutils}/bin/tail -n 1)"
        else
          _fresh_stale=unknown; _fresh_critical=unknown; _fresh_action=unknown; _unknowns+=(backup-freshness)
        fi

        _exposure_output="$(/etc/monsternix/bin/mnx-exposure summary 2>/dev/null || true)"
        _exposure_status="$(printf '%s\n' "$_exposure_output" | ${pkgs.gnused}/bin/sed -n 's/^MNX_EXPOSURE=//p' | ${pkgs.coreutils}/bin/tail -n 1)"
        _exposure_review="$(printf '%s\n' "$_exposure_output" | ${pkgs.gnused}/bin/sed -n 's/^review_listener_total=//p' | ${pkgs.coreutils}/bin/tail -n 1)"
        [[ -n "$_exposure_status" ]] || { _exposure_status=unknown; _unknowns+=(network-exposure); }
        [[ "$_exposure_review" =~ ^[0-9]+$ ]] || _exposure_review=unknown

        _temp_output="$(/etc/monsternix/bin/mnx-atlas --config /etc/nixos/configuration.nix temp 2>/dev/null || true)"
        _temp_count="$(printf '%s\n' "$_temp_output" | ${pkgs.gnused}/bin/sed -n 's/^temporary_code_region_count=//p' | ${pkgs.coreutils}/bin/tail -n 1)"
        [[ "$_temp_count" =~ ^[0-9]+$ ]] || { _temp_count=unknown; _unknowns+=(temporary-code); }

        [[ -r /var/lib/m21-btrfs-pull-backup/last-helper-mismatch ]] && _m21_block=review-required || _m21_block=clear
        if [[ -r /var/lib/monsternix/journal-integrity/current.json ]]; then
          _journal_state="$(${pkgs.jq}/bin/jq -r '.overall_status // "unknown"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo unknown)"
          _journal_clean="$(${pkgs.jq}/bin/jq -r '.clean_forward.status // (if .overall_status == "malfunction" then "unknown-observer-malfunction" elif .overall_status == "review-required" then "unanchored" elif .overall_status == "clean" then "clean" else "unknown" end)' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo unknown)"
          _journal_bundle="$(${pkgs.jq}/bin/jq -r '.evidence_bundle // "none"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo none)"
          _journal_anchor_present="$(${pkgs.jq}/bin/jq -r 'if .anchor.present == true then "yes" else "no" end' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo no)"
          _journal_anchor_path="$(${pkgs.jq}/bin/jq -r '.anchor.path // "none"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo none)"
          _journal_boundary_present="$(${pkgs.jq}/bin/jq -r 'if .recovery_boundary.present == true then "yes" else "no" end' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo no)"
          _journal_boundary_path="$(${pkgs.jq}/bin/jq -r '.recovery_boundary.path // "none"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo none)"
          _journal_boundary_mode="$(${pkgs.jq}/bin/jq -r '.recovery_boundary.mode // "none"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo none)"
          _journal_active_forward="$(${pkgs.jq}/bin/jq -r '.clean_forward.active_forward_status // "unknown"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo unknown)"
          _journal_new_count="$(${pkgs.jq}/bin/jq -r '.clean_forward.new_problem_count // 0' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo unknown)"
        else
          _journal_state=unknown; _journal_clean=unknown; _journal_bundle=none; _journal_anchor_present=no; _journal_anchor_path=none; _journal_boundary_present=no; _journal_boundary_path=none; _journal_boundary_mode=none; _journal_active_forward=unknown; _journal_new_count=unknown; _unknowns+=(journal-integrity)
        fi
        for _state in /run/monsternix/mnx-switch.current /run/monsternix/mnx-test.current; do
          [[ -r "$_state" ]] || continue
          _phase="$(${pkgs.gnused}/bin/sed -n 's/^phase=//p' "$_state" | ${pkgs.coreutils}/bin/tail -n 1)"
          if [[ -n "$_phase" && "$_phase" != finished ]]; then
            _transaction_active=1
            case "$_state" in *switch*) _transaction_kind=switch ;; *) _transaction_kind=test ;; esac
            _transaction_phase="$_phase"
            break
          fi
        done

        _next="$(mnx_brief_next_action "$_office_ok" "$_failed_count" "$_transaction_active" "$_coherence" "$_health_problem" "$_fresh_critical" "$_fresh_stale" "$_m21_block" "$_journal_clean" "$_temp_count" "$_exposure_review" "$_office_effective_next" "$_office_effective_source")"
        case "$_next" in
          no-urgent-action) _status=ready ;;
          review-network-exposure|review-journal-integrity) _status=ready-with-review ;;
          *) _status=attention ;;
        esac
        _unknown_json="$(printf '%s\n' "''${_unknowns[@]}" | ${pkgs.jq}/bin/jq -R -s 'split("\n") | map(select(length > 0)) | unique')"

        ${pkgs.jq}/bin/jq -n \
          --arg schema mnx.brief.v3 --arg status "$_status" --arg observed "$_observed" --arg next "$_next" \
          --arg editable_sha "$_editable_sha" --arg active_sha "$_active_sha" --arg default_sha "$_default_sha" \
          --arg document_schema "$_schema" --arg coherence "$_coherence" --arg running "$_running" --arg boot_default "$_default" \
          --arg relation "$_relation" --arg system_state "$_system_state" --arg test_report "$_test_report" --arg test_result "$_test_result" \
          --arg switch_report "$_switch_report" --arg switch_result "$_switch_result" --arg health_problem "$_health_problem" \
          --arg health_warning "$_health_warning" --arg health_advisory "$_health_advisory" --arg fresh_stale "$_fresh_stale" \
          --arg fresh_critical "$_fresh_critical" --arg fresh_action "$_fresh_action" --arg exposure_status "$_exposure_status" \
          --arg exposure_review "$_exposure_review" --arg temp_count "$_temp_count" --arg m21_block "$_m21_block" \
          --arg journal_state "$_journal_state" --arg journal_clean "$_journal_clean" --arg journal_bundle "$_journal_bundle" \
          --arg journal_anchor_present "$_journal_anchor_present" --arg journal_anchor_path "$_journal_anchor_path" \
          --arg journal_boundary_present "$_journal_boundary_present" --arg journal_boundary_path "$_journal_boundary_path" --arg journal_boundary_mode "$_journal_boundary_mode" --arg journal_active_forward "$_journal_active_forward" --arg journal_new_count "$_journal_new_count" \
          --arg transaction_kind "$_transaction_kind" --arg transaction_phase "$_transaction_phase" \
          --arg office_final_switch "$_office_final_switch" --arg office_post_status "$_office_post_status" --arg office_mutation "$_office_mutation" \
          --arg office_effective_next "$_office_effective_next" --arg office_effective_source "$_office_effective_source" \
          --argjson transaction_active "$_transaction_active" --argjson failed_count "$_failed_count" --argjson failed_units "$_failed_json" \
          --argjson office "$_office_json" --argjson agenda "$_agenda_json" --argjson unknowns "$_unknown_json" \
          'def num: if test("^[0-9]+$") then tonumber else null end;
           {schema:$schema,status:$status,authority:"handoff-evidence-not-permission",network_used:false,mutation:"none",
            epistemic:{operator_request:{kind:"operator-request",status:"unrecorded",value:null},
              inherited_intent:{kind:"inherited-intent",source:"switch-committed-office",accepted_stage:($office.accepted_stage // null),accepted_source_sha256:($office.accepted_source_sha256 // null)},
              measured_fact:{kind:"measured-fact",observed_at:$observed},
              inference:{kind:"inference",next_action:$next},proposal:{kind:"proposal",status:"none",value:null},
              unknown:{kind:"unknown",count:($unknowns|length),fields:$unknowns}},
            classification_vocabulary:["general-law","mechanism","policy","adapter","personal-fact","historical-record","experiment","unknown"],
            wake:{schema:"mnx.officer-wake.v1",identity_state:$coherence,
              identity_verified:(($office|type)=="object" and ($office|length)>0 and $coherence!="mismatch" and $editable_sha!="" and $active_sha!="" and $default_sha!=""),
              accepted_stage:($office.accepted_stage // $agenda.accepted_predecessor_stage // null),candidate_stage:($agenda.candidate_stage // null),
              authority:"current-operator-request-outranks-inherited-intent;handoff-evidence-not-permission",operator_request_status:"not-carried-in-machine-state-use-current-conversation",
              effective_next_stage:($office.effective_next_stage // $agenda.after_acceptance_next_stage // null),effective_next_objective:($office.effective_next_objective // $office_effective_next),
              blocking_state:(if $status=="attention" then $next else "none" end),review_state:(if $status=="ready-with-review" then $next else "none" end),unknowns:$unknowns,
              officer_action:"deliver-one-complete-configuration.nix",
              operator_commands:{routine_command_count:2,test:"sudo mnx test",test_reviewed_behavior_change:"sudo mnx test --allow-behavior-change",switch:"sudo mnx switch",combined_reviewed_behavior_change:"sudo mnx test --allow-behavior-change && sudo mnx switch",third_routine_command:false},
              progressive_disclosure:["mnx brief --full","mnx brief --json","mnx office","mnx help"]},
            source:{path:"/etc/nixos/configuration.nix",document_schema:$document_schema,editable_sha256:$editable_sha,active_sha256:$active_sha,boot_default_sha256:$default_sha,coherence:$coherence},
            runtime:{running_system:$running,boot_default_system:$boot_default,closure_relation:$relation,manager_state:$system_state,failed_unit_count:$failed_count,failed_units:$failed_units},
            office:$office,
            handoff:{source_capsule:{present:($agenda.amnesia_capsule.present // false),schema:($agenda.amnesia_capsule.schema // null),sha256:($agenda.amnesia_capsule.sha256 // "unknown"),authority:($agenda.amnesia_capsule.fields.AUTHORITY // "unknown"),state:($agenda.amnesia_capsule.fields.STATE // "unknown"),intent:($agenda.amnesia_capsule.fields.INTENT // "unknown"),open:($agenda.amnesia_capsule.fields.OPEN // "unknown"),next:($agenda.amnesia_capsule.fields.NEXT // "unknown"),hold:($agenda.amnesia_capsule.fields.HOLD // "unknown"),operator:($agenda.amnesia_capsule.fields.OPERATOR // "unknown")},runtime_overlay:{final_switch_result:$office_final_switch,post_acceptance_status:$office_post_status,mutation_proof:$office_mutation,effective_next_objective:$office_effective_next,effective_next_source:$office_effective_source},declared_next_stage:($agenda.after_acceptance_next_stage // null),declared_next_objective:($agenda.after_acceptance_next_objective // "unknown"),effective_next_stage:($office.effective_next_stage // $agenda.after_acceptance_next_stage // null),effective_next_objective:($office.effective_next_objective // $office_effective_next)},
            transaction:{active:($transaction_active==1),kind:$transaction_kind,phase:$transaction_phase,latest_test:{result:$test_result,report:$test_report},latest_switch:{result:$switch_result,report:$switch_report}},
            health:{storage_problem:$health_problem,storage_warning:$health_warning,storage_advisory:$health_advisory},
            backup:{stale:$fresh_stale,critical:$fresh_critical,action:$fresh_action},exposure:{status:$exposure_status,review_listener_total:($exposure_review|num)},
            m21:{helper_block_state:$m21_block},incidents:{journal_integrity_state:$journal_state,journal_clean_forward_status:$journal_clean,journal_anchor_present:($journal_anchor_present=="yes"),journal_anchor_path:$journal_anchor_path,journal_recovery_boundary_present:($journal_boundary_present=="yes"),journal_recovery_boundary_path:$journal_boundary_path,journal_recovery_boundary_mode:$journal_boundary_mode,journal_active_forward_status:$journal_active_forward,journal_new_problem_count:($journal_new_count|num),journal_integrity_evidence:$journal_bundle},temporary_code:{region_count:($temp_count|num)},evidence:{bundle:null}}'
      }

      #@MNX-PART id=99.10.mnx.function.mnx-metric-value kind=function title="Function mnx_metric_value"
      mnx_metric_value() {
        ${pkgs.gawk}/bin/awk -v key="$1" '$1 == key { print $2; found=1; exit } END { if (!found) print "unknown" }' "$2"
      }

      #@MNX-PART id=99.10.mnx.function.brief-render-text kind=function title="Function brief_render_text"
      brief_render_text() {
        ${pkgs.jq}/bin/jq -r '[
          "################################################################################",
          "# MNX WAKE — IDENTITY FIRST",
          "################################################################################",
          "wake_schema=" + .wake.schema,
          "identity_verified=" + (.wake.identity_verified|tostring),
          "identity_state=" + .wake.identity_state,
          "source=sha256:" + .source.editable_sha256 + " schema:" + .source.document_schema + " accepted_stage:" + ((.wake.accepted_stage // "unknown")|tostring) + " candidate_stage:" + ((.wake.candidate_stage // "unknown")|tostring),
          "source_hashes=editable:" + .source.editable_sha256 + " active:" + .source.active_sha256 + " boot-default:" + .source.boot_default_sha256,
          "runtime=state:" + .runtime.manager_state + " closure:" + .runtime.closure_relation + " failed_units:" + (.runtime.failed_unit_count|tostring),
          "authority=" + .wake.authority,
          "operator_request=" + .wake.operator_request_status,
          "effective_next=stage-" + ((.wake.effective_next_stage // "unknown")|tostring) + ":" + (.wake.effective_next_objective // "unknown"),
          "blocking_state=" + .wake.blocking_state,
          "review_state=" + .wake.review_state,
          "unknowns=" + (if (.wake.unknowns|length)==0 then "none" else (.wake.unknowns|join(",")) end),
          "officer_action=" + .wake.officer_action,
          "operator_command_1=" + .wake.operator_commands.test,
          "operator_command_2=" + .wake.operator_commands.switch,
          "progressive_disclosure=" + (.wake.progressive_disclosure|join(" | ")),
          "network_used=no",
          "MNX_OFFICER_WAKE=PASS"
        ] | .[]'
      }

      #@MNX-PART id=99.10.mnx.function.brief-render-full-text kind=function title="Function brief_render_full_text"
      brief_render_full_text() {
        ${pkgs.jq}/bin/jq -r '[
          "################################################################################",
