      #@MNX-PART id=40.31.mnx-exposure.function.build-parser kind=function title="Python function build_parser"
      def build_parser() -> argparse.ArgumentParser:
          parser = argparse.ArgumentParser(
              prog="mnx-exposure",
              description="Low-frequency canonical listener attribution, zone modeling, and source-declared exposure review",
          )
          parser.add_argument("--config", default=str(DEFAULT_CONFIG))
          parser.add_argument("--state-root", default=str(DEFAULT_STATE_ROOT))
          parser.add_argument("--log-root", default=str(DEFAULT_LOG_ROOT))
          parser.add_argument("--prom", default=str(DEFAULT_PROM))
          subparsers = parser.add_subparsers(dest="command")
          capture_parser = subparsers.add_parser("capture", help="capture canonical endpoints and atomically refresh current evidence")
          capture_parser.add_argument("--quiet", action="store_true")
          summary_parser = subparsers.add_parser("summary", help="print bounded current summary")
          summary_parser.add_argument("--json", action="store_true")
          full_parser = subparsers.add_parser("full", help="print summary, canonical endpoints, and grouped review ledger")
          full_parser.add_argument("--json", action="store_true")
          review_parser = subparsers.add_parser("review", help="print grouped unresolved exposure review ledger")
          review_parser.add_argument("--json", action="store_true")
          policy_parser = subparsers.add_parser("policy", help="print source-declared zones and exposure policy")
          policy_parser.add_argument("--json", action="store_true")
          zones_parser = subparsers.add_parser("zones", help="print source-declared network zone model")
          zones_parser.add_argument("--json", action="store_true")
          subparsers.add_parser("verify-current", help="verify current evidence against the exact source policy")
          subparsers.add_parser("self-test", help="run deterministic canonicalization, zone, policy, metric, and sandbox tests")
          return parser
            
      #@MNX-PART id=40.31.mnx-exposure.function.main kind=function title="Python function main"
      def main() -> int:
          parser = build_parser()
          args = parser.parse_args()
          command = args.command or "summary"
          try:
              if command == "capture":
                  observation = capture(pathlib.Path(args.config), pathlib.Path(args.log_root), pathlib.Path(args.state_root), pathlib.Path(args.prom), quiet=args.quiet)
                  return 1 if summarize(observation)["result"] == "FAIL" else 0
              if command == "summary":
                  return command_summary(args)
              if command == "full":
                  return command_full(args)
              if command == "review":
                  return command_review(args)
              if command == "policy":
                  return command_policy(args)
              if command == "zones":
                  return command_zones(args)
              if command == "verify-current":
                  return command_verify_current(args)
              if command == "self-test":
                  return command_self_test(args)
              raise ExposureError(f"unknown command: {command}")
          except ExposureError as exc:
              print(f"MNX_EXPOSURE_ERROR: {exc}", file=sys.stderr)
              return 1
            
      if __name__ == "__main__":
          raise SystemExit(main())
