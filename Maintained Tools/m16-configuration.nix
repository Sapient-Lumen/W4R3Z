      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.workspace-read-marker kind=function title="Portable Python function workspace_read_marker"
      def workspace_read_marker(root: Path) -> dict:
          marker = root / '.mnx-cloudtainer-workspace.json'
          if not marker.is_file() or marker.is_symlink():
              raise Error(f'candidate workspace marker is missing or unsafe: {marker}')
          try:
              payload = json.loads(marker.read_text(encoding='utf-8'))
          except (OSError, json.JSONDecodeError) as exc:
              raise Error(f'candidate workspace marker is unreadable: {marker}: {exc}') from exc
          if payload.get('schema') != 'mnx.cloudtainer.candidate-workspace.v1':
              raise Error(f'unsupported candidate workspace schema: {payload.get("schema")}')
          return payload
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.workspace-load kind=function title="Portable Python function workspace_load"
      def workspace_load(value: str | None, accepted: dict) -> dict:
          root = workspace_root(value, accepted, must_exist=True)
          if not root.is_dir() or root.is_symlink():
              raise Error(f'candidate workspace is not a real directory: {root}')
          marker = workspace_read_marker(root)
          manifest_check = workspace_verify_static_manifest(root)
          if marker.get('accepted_source_sha256') != accepted['source_sha256']:
              raise Error('candidate workspace was created from a different accepted source')
          if marker.get('accepted_stage') != accepted['candidate_stage']:
              raise Error('candidate workspace accepted stage differs from the packet source')
          if marker.get('next_stage') != int(accepted['office_agenda']['after_acceptance_next_stage']):
              raise Error('candidate workspace next stage differs from the packet agenda')
          accepted_path = root / 'accepted.nix'
          candidate_path = root / 'candidate.nix'
          for path in [accepted_path, candidate_path]:
              if not path.is_file() or path.is_symlink():
                  raise Error(f'candidate workspace source is missing or unsafe: {path}')
          accepted_record = parse(accepted_path)
          if accepted_record['source_sha256'] != accepted['source_sha256']:
              raise Error('candidate workspace accepted.nix no longer matches the packet source')
          return {
              'root': root,
              'marker': marker,
              'accepted_path': accepted_path,
              'candidate_path': candidate_path,
              'accepted': accepted_record,
              'workspace_manifest': manifest_check,
          }
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.workspace-readme kind=function title="Portable Python function workspace_readme"
      def workspace_readme(record: dict, root: Path) -> str:
          next_stage = int(record['office_agenda']['after_acceptance_next_stage'])
          return '\n'.join([
              '# MNX Cloudtainer Candidate Workspace',
              "",
