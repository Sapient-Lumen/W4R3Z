  #########################################################################
  # Per-device, per-counter Btrfs evidence baseline
  #########################################################################

#@MNX-CHUNK id=40.23 slug=btrfs-counter-baseline title="Pinned Btrfs device-counter evidence baseline"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-btrfs-baseline" section=40.23 role=generated-program ordinal=157
  environment.etc."monsternix/bin/mnx-btrfs-baseline" = {
    source = pkgs.writeTextFile {
      name = "mnx-btrfs-baseline";
      executable = true;
      text = ''
      #!${pkgs.python3}/bin/python3
      from __future__ import annotations

      import argparse
      import datetime as dt
      import json
      import os
      import pathlib
      import re
      import subprocess
      import sys
      import tempfile

      os.environ["PATH"] = "${pkgs.btrfs-progs}/bin:${pkgs.coreutils}/bin:${pkgs.util-linux}/bin:/run/current-system/sw/bin"

      if os.geteuid() != 0:
          sudo = "/run/wrappers/bin/sudo"
          if not os.path.exists(sudo):
              print("MNX_BTRFS_BASELINE_ERROR: /run/wrappers/bin/sudo is unavailable", file=sys.stderr)
              raise SystemExit(126)
          os.execv(sudo, [sudo, "--", "/etc/monsternix/bin/mnx-btrfs-baseline", *sys.argv[1:]])

      ROOT = pathlib.Path("/var/lib/monsternix/btrfs-baselines")
      BASELINES = ROOT / "baselines"
      PINNED = ROOT / "pinned"
      MOUNTS = ("/", "/mnt/m16-backup-nvme", "/mnt/m16-new-storage", "/mnt/m16-old-storage")
      NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
      STAT_RE = re.compile(r"^\[(?P<device>[^]]+)\]\.(?P<kind>[A-Za-z0-9_]+)\s+(?P<value>[0-9]+)\s*$")
      SHOW_RE = re.compile(r"^\s*devid\s+(?P<devid>[0-9]+)\s+.*\spath\s+(?P<path>.+?)\s*$")


      #@MNX-PART id=40.23.mnx-btrfs-baseline.class.baselineerror kind=class title="Python class BaselineError"
      class BaselineError(RuntimeError):
          pass


      #@MNX-PART id=40.23.mnx-btrfs-baseline.function.run kind=function title="Python function run"
      def run(command: list[str]) -> str:
          completed = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
          if completed.returncode != 0:
              raise BaselineError(f"command failed ({completed.returncode}): {' '.join(command)}\n{completed.stderr.strip()}")
          return completed.stdout


      #@MNX-PART id=40.23.mnx-btrfs-baseline.function.btrfs_device_ids kind=function title="Python function btrfs_device_ids"
      def btrfs_device_ids(mount: str) -> dict[str, str]:
          identities: dict[str, str] = {}
          for line in run(["btrfs", "filesystem", "show", "--raw", mount]).splitlines():
              match = SHOW_RE.match(line)
              if not match:
                  continue
              identities[os.path.realpath(match.group("path"))] = f"devid:{match.group('devid')}"
          if not identities:
              raise BaselineError(f"Btrfs device identities are unreadable: {mount}")
          return identities


      #@MNX-PART id=40.23.mnx-btrfs-baseline.function.current_snapshot kind=function title="Python function current_snapshot"
      def current_snapshot() -> dict[str, object]:
          mounts: list[dict[str, object]] = []
          for mount in MOUNTS:
              if subprocess.run(["mountpoint", "-q", mount]).returncode != 0:
                  raise BaselineError(f"required mount is absent: {mount}")
              fs_uuid = run(["findmnt", "-rn", "-T", mount, "-o", "UUID"]).strip()
              if not fs_uuid:
                  raise BaselineError(f"filesystem UUID is unreadable: {mount}")
              device_ids = btrfs_device_ids(mount)
              counters: list[dict[str, object]] = []
              for line in run(["btrfs", "device", "stats", mount]).splitlines():
                  match = STAT_RE.match(line.strip())
                  if not match:
                      continue
                  device_path = match.group("device")
                  device_realpath = os.path.realpath(device_path)
                  device_id = device_ids.get(device_realpath)
                  if device_id is None:
                      raise BaselineError(f"counter device is absent from Btrfs filesystem show: mount={mount} device={device_path}")
                  counters.append({
                      "device_id": device_id,
                      "device_path": device_path,
                      "kind": match.group("kind"),
                      "value": int(match.group("value")),
                  })
              if not counters:
                  raise BaselineError(f"Btrfs counters are unreadable: {mount}")
              counters.sort(key=lambda item: (str(item["device_id"]), str(item["kind"])))
              mounts.append({"mount": mount, "filesystem_uuid": fs_uuid, "counters": counters})
          return {
              "schema": 1,
              "captured_at": dt.datetime.now(dt.timezone.utc).astimezone().isoformat(),
              "epoch": int(dt.datetime.now(dt.timezone.utc).timestamp()),
              "system": os.path.realpath("/run/current-system"),
              "mounts": mounts,
          }


      #@MNX-PART id=40.23.mnx-btrfs-baseline.function.logbook_gid kind=function title="Python function logbook_gid"
      def logbook_gid() -> int:
          import grp
          return grp.getgrnam("logbook").gr_gid


      #@MNX-PART id=40.23.mnx-btrfs-baseline.function.write_baseline kind=function title="Python function write_baseline"
      def write_baseline(name: str, pin: bool) -> pathlib.Path:
          if os.geteuid() != 0:
              raise BaselineError("baseline capture requires root")
          if not NAME_RE.fullmatch(name):
              raise BaselineError(f"invalid baseline name: {name}")
          ROOT.mkdir(parents=True, exist_ok=True)
          BASELINES.mkdir(parents=True, exist_ok=True)
          os.chown(ROOT, 0, logbook_gid())
          os.chown(BASELINES, 0, logbook_gid())
          os.chmod(ROOT, 0o750)
          os.chmod(BASELINES, 0o750)
          target = BASELINES / f"{name}.json"
          if target.exists():
              raise BaselineError(f"baseline already exists: {target}")
          data = current_snapshot()
          data["name"] = name
          fd, tmp_name = tempfile.mkstemp(prefix=f".{name}.", suffix=".json", dir=BASELINES)
          try:
              with os.fdopen(fd, "w", encoding="utf-8") as handle:
                  json.dump(data, handle, sort_keys=True, indent=2)
                  handle.write("\n")
                  handle.flush()
                  os.fsync(handle.fileno())
              os.chown(tmp_name, 0, logbook_gid())
              os.chmod(tmp_name, 0o640)
              os.replace(tmp_name, target)
          finally:
              try:
                  os.unlink(tmp_name)
              except FileNotFoundError:
                  pass
          if pin:
              temporary = ROOT / f".pinned.{os.getpid()}"
              try:
                  temporary.unlink()
              except FileNotFoundError:
                  pass
              temporary.symlink_to(pathlib.Path("baselines") / target.name)
              os.replace(temporary, PINNED)
          return target


      #@MNX-PART id=40.23.mnx-btrfs-baseline.function.pin_baseline kind=function title="Python function pin_baseline"
      def pin_baseline(reference: str) -> pathlib.Path:
          if os.geteuid() != 0:
              raise BaselineError("pinning a baseline requires root")
          path = resolve_baseline(reference)
          ROOT.mkdir(parents=True, exist_ok=True)
          os.chown(ROOT, 0, logbook_gid())
          os.chmod(ROOT, 0o750)
          temporary = ROOT / f".pinned.{os.getpid()}"
          try:
              temporary.unlink()
          except FileNotFoundError:
              pass
          temporary.symlink_to(pathlib.Path("baselines") / path.name)
          os.replace(temporary, PINNED)
          return path


      #@MNX-PART id=40.23.mnx-btrfs-baseline.function.resolve_baseline kind=function title="Python function resolve_baseline"
      def resolve_baseline(reference: str) -> pathlib.Path:
          if reference == "pinned":
              if not PINNED.is_symlink():
                  raise BaselineError("no pinned Btrfs baseline exists")
              path = PINNED.resolve(strict=True)
          else:
              if not NAME_RE.fullmatch(reference):
                  raise BaselineError(f"invalid baseline reference: {reference}")
              path = BASELINES / f"{reference}.json"
          if not path.is_file():
              raise BaselineError(f"baseline is missing: {path}")
          resolved = path.resolve(strict=True)
          if resolved.parent != BASELINES.resolve(strict=True):
              raise BaselineError(f"baseline escapes the managed directory: {resolved}")
          return resolved


      #@MNX-PART id=40.23.mnx-btrfs-baseline.function.tuple_map kind=function title="Python function tuple_map"
      def tuple_map(snapshot: dict[str, object]) -> tuple[dict[str, str], dict[tuple[str, str, str], int]]:
          identities: dict[str, str] = {}
          counters: dict[tuple[str, str, str], int] = {}
          for mount_item in snapshot.get("mounts", []):
              mount = str(mount_item["mount"])
              identities[mount] = str(mount_item["filesystem_uuid"])
              for counter in mount_item.get("counters", []):
                  device_id = str(counter.get("device_id", counter.get("device", "unknown")))
                  counters[(mount, device_id, str(counter["kind"]))] = int(counter["value"])
          return identities, counters


      #@MNX-PART id=40.23.mnx-btrfs-baseline.function.compare kind=function title="Python function compare"
      def compare(reference: str) -> int:
          path = resolve_baseline(reference)
          baseline = json.loads(path.read_text(encoding="utf-8"))
          current = current_snapshot()
          base_ids, base_values = tuple_map(baseline)
          current_ids, current_values = tuple_map(current)
          failures: list[str] = []
          advisories: list[str] = []
          if base_ids != current_ids:
              failures.append(f"filesystem identity changed: baseline={base_ids} current={current_ids}")
          missing = sorted(set(base_values) - set(current_values))
          extra = sorted(set(current_values) - set(base_values))
          if missing:
              failures.append(f"counter tuples disappeared: {missing}")
          if extra:
              failures.append(f"new counter tuples appeared: {extra}")
          for key in sorted(set(base_values) & set(current_values)):
              before = base_values[key]
              now = current_values[key]
              mount, device_id, kind = key
              print(f"counter mount={mount} device_id={device_id} kind={kind} baseline={before} current={now}")
              if now > before:
                  failures.append(f"counter increased: {key} {before}->{now}")
              elif now < before:
                  advisories.append(f"counter decreased/reset: {key} {before}->{now}")
              elif now > 0:
                  advisories.append(f"historical nonzero unchanged: {key}={now}")
          print(f"baseline={path}")
          print(f"failure_count={len(failures)}")
          print(f"advisory_count={len(advisories)}")
          for item in advisories:
              print(f"ADVISORY: {item}")
          for item in failures:
              print(f"FAIL: {item}", file=sys.stderr)
          if failures:
              print("MNX_BTRFS_BASELINE=FAIL")
              return 1
          if advisories:
              print("MNX_BTRFS_BASELINE=PASS_WITH_ADVISORIES")
          else:
              print("MNX_BTRFS_BASELINE=PASS")
          return 0


      #@MNX-PART id=40.23.mnx-btrfs-baseline.function.check_zero kind=function title="Python function check_zero"
      def check_zero() -> int:
          snapshot = current_snapshot()
          _, counters = tuple_map(snapshot)
          nonzero = [(key, value) for key, value in sorted(counters.items()) if value != 0]
          for key, value in sorted(counters.items()):
              print(f"counter mount={key[0]} device_id={key[1]} kind={key[2]} current={value}")
          if nonzero:
              for key, value in nonzero:
                  print(f"FAIL: unpinned nonzero counter: {key}={value}", file=sys.stderr)
              print("MNX_BTRFS_ZERO_CHECK=FAIL")
              return 1
          print("MNX_BTRFS_ZERO_CHECK=PASS")
          return 0


      #@MNX-PART id=40.23.mnx-btrfs-baseline.function.main kind=function title="Python function main"
      def main() -> int:
          parser = argparse.ArgumentParser(prog="mnx-btrfs-baseline")
          sub = parser.add_subparsers(dest="command", required=True)
          capture = sub.add_parser("capture")
          capture.add_argument("name")
          capture.add_argument("--pin", action="store_true")
          compare_parser = sub.add_parser("compare")
          compare_parser.add_argument("reference", nargs="?", default="pinned")
          pin_parser = sub.add_parser("pin")
          pin_parser.add_argument("reference")
          sub.add_parser("status")
          show = sub.add_parser("show")
          show.add_argument("reference", nargs="?", default="pinned")
          sub.add_parser("check-zero")
          args = parser.parse_args()
          try:
              if args.command == "capture":
                  target = write_baseline(args.name, args.pin)
                  print(f"baseline={target}")
                  print(f"pinned={'yes' if args.pin else 'no'}")
                  print("MNX_BTRFS_BASELINE_CAPTURE=PASS")
                  return 0
              if args.command == "compare":
                  return compare(args.reference)
              if args.command == "pin":
                  target = pin_baseline(args.reference)
                  print(f"pinned={target}")
                  print("MNX_BTRFS_BASELINE_PIN=PASS")
                  return 0
              if args.command == "status":
                  print(f"root={ROOT}")
                  print(f"pinned={'none' if not PINNED.is_symlink() else PINNED.resolve(strict=False)}")
                  if PINNED.is_symlink() and PINNED.resolve(strict=False).is_file():
                      return compare("pinned")
                  return check_zero()
              if args.command == "show":
                  print(resolve_baseline(args.reference).read_text(encoding="utf-8"), end="")
                  return 0
              if args.command == "check-zero":
                  return check_zero()
          except (BaselineError, OSError, json.JSONDecodeError) as exc:
              print(f"MNX_BTRFS_BASELINE_ERROR: {exc}", file=sys.stderr)
              return 1
          return 64


      if __name__ == "__main__":
          raise SystemExit(main())
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            ;;
          '#!'*python*)
            ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
            ;;
          *)
            echo "unsupported generated-script interpreter: $first" >&2
            exit 1
            ;;
        esac
      '';
    };
  };


