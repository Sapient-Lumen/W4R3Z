#@MNX-DEF path=systemd.services.nix-result-root-cleanup section=80.24 role=service ordinal=251
  systemd.services.nix-result-root-cleanup = {
    description = "Remove stale /result gcroot links printed by nix-store";
    onFailure = [ "mnx-job-failure-notify@%n.service" ];
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Nice = 15;
      IOSchedulingClass = "idle";
      StandardOutput = "journal";
      StandardError = "journal";
      NoNewPrivileges = true;
      PrivateTmp = true;
    };
    path = [ config.nix.package pkgs.coreutils pkgs.gawk pkgs.gnugrep pkgs.findutils ];
    script = ''
      set -euo pipefail
      JOB_START="$(date +%s)"; trap 'rc="$?"; /etc/monsternix/bin/mnx-job-metric nix-result-root-cleanup "$rc" "$(( $(date +%s) - JOB_START ))" 0 none || true; exit "$rc"' EXIT
