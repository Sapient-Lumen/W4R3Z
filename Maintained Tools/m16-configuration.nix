  #  "--prefer" "\\.fsearch-wrapped"
  #  "--prefer" "\\.firefox-wrapped"
  #  "--avoid"  "VBoxHeadless"
  #  "--avoid"  "^systemd$"
  #  "--avoid"  "^Xorg$"
  #  "--avoid"  "^sshd$"
  #];


