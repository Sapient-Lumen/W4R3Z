      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-run kind=function title="Python function m21_inventory_run"
      def m21_inventory_run(argv: list[str], *, data: bytes | None = None, seconds: float = 30,
                            limit: int = 1048576, env: dict[str, str] | None = None) -> tuple[int, bytes, bytes]:
          import selectors
          import signal
          import time
          if not argv or seconds <= 0 or not 0 < limit <= 2097152:
              raise ValueError("invalid inventory subprocess bound")
          # Writing a fixed few-KiB program to a private input file avoids a blocking stdin pipe.
          with tempfile.TemporaryFile() as input_file:
              if data is not None:
                  input_file.write(data); input_file.seek(0)
              child = subprocess.Popen(argv, stdin=input_file, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                       env=env or {"PATH": "${pkgs.coreutils}/bin:${pkgs.util-linux}/bin:${pkgs.openssh}/bin",
                                                   "LC_ALL": "C", "HOME": "/root"}, start_new_session=True)
              streams = [bytearray(), bytearray()]
              selector = selectors.DefaultSelector()
              completed = False
              try:
                  for index, stream in enumerate((child.stdout, child.stderr)):
                      os.set_blocking(stream.fileno(), False)
                      selector.register(stream, selectors.EVENT_READ, index)
                  deadline = time.monotonic() + seconds
                  while selector.get_map():
                      if time.monotonic() >= deadline:
                          raise TimeoutError("inventory subprocess time bound")
                      for key, _ in selector.select(min(0.1, max(0, deadline-time.monotonic()))):
                          block = os.read(key.fileobj.fileno(), 65536)
                          if not block:
                              selector.unregister(key.fileobj)
                          else:
                              streams[key.data].extend(block)
                              if sum(map(len, streams)) > limit:
                                  raise ValueError("inventory subprocess output bound")
                  rc = child.wait(timeout=max(0.01, deadline-time.monotonic()))
                  completed = True
                  return rc, bytes(streams[0]), bytes(streams[1])
              finally:
                  if not completed or child.poll() is None:
                      # An exited leader may leave descendants holding our output pipes.
                      # This session belongs only to this diagnostic, never to a backup unit.
                      try: os.killpg(child.pid, signal.SIGTERM)
                      except ProcessLookupError: pass
                      try: child.wait(timeout=2)
                      except subprocess.TimeoutExpired: pass
                      finally:
                          try: os.killpg(child.pid, signal.SIGKILL)
                          except ProcessLookupError: pass
                      child.wait(timeout=2)
                  selector.close()
                  child.stdout.close(); child.stderr.close()

      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-frames kind=function title="Python function m21_inventory_frames"
      def m21_inventory_frames(raw: bytes) -> dict[str, tuple[bytes, tuple[int, int, int]]]:
          import base64
          labels = ("root", "home", "configuration", "application-state", "server-data", "boot")
          expected = ["hostname", "uid", "epoch", "home-before"]
          for label in labels: expected.extend(("stat-"+label, "mount-"+label))
          expected.extend(("mounts", "home-rootid-before", "subvolumes", "readonly-subvolumes", "subvolumes-after", "home-rootid-after", "home-after", "backup-sudo-policy"))
          lines = raw.splitlines()
          if len(raw) > 1048576 or len(lines) != len(expected)+2 or lines[0] != b"MNX_M21_TOPOLOGY_BEGIN=3" or lines[-1] != b"MNX_M21_TOPOLOGY_END=3":
              raise ValueError("inventory frame envelope")
          result = {}
          for name, line in zip(expected, lines[1:-1]):
              pieces = line.split(b"\t")
              if len(pieces) != 3 or pieces[0] != name.encode() or not re.fullmatch(rb"[0-9]{1,3},[0-9]{1,3},[0-9]{1,3}", pieces[2]):
                  raise ValueError("inventory frame membership")
              codes = tuple(map(int, pieces[2].split(b",")))
              body = base64.b64decode(pieces[1], validate=True)
              if any(code > 255 for code in codes) or len(body) > 262144:
                  raise ValueError("inventory frame bounds")
              result[name] = (body, codes)
          return result

      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-json kind=function title="Python function m21_inventory_json"
      def m21_inventory_json(raw: bytes) -> Any:
          #@MNX-PART id=99.08.mnx-office.m21-inventory-json.function.unique kind=function title="Python function unique"
          def unique(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
              value = {}
              for key, item in pairs:
                  if key in value: raise ValueError("duplicate inventory JSON key")
                  value[key] = item
              return value
          return json.loads(raw, object_pairs_hook=unique)

      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-mounts kind=function title="Python function m21_inventory_mounts"
      def m21_inventory_mounts(raw: bytes) -> list[dict[str, Any]]:
          parsed = m21_inventory_json(raw)
          if not isinstance(parsed, dict) or set(parsed) != {"filesystems"} or not isinstance(parsed["filesystems"], list) or not 1 <= len(parsed["filesystems"]) <= 1024:
              raise ValueError("inventory mount document")
          for row in parsed["filesystems"]:
              if not isinstance(row, dict) or set(row) != {"target", "fstype", "uuid", "fsroot"}:
                  raise ValueError("inventory mount row")
              if not isinstance(row["target"], str) or not row["target"].startswith("/") or len(row["target"]) > 4096:
                  raise ValueError("inventory mount target")
              if not isinstance(row["fstype"], str) or not re.fullmatch(r"[A-Za-z0-9_.-]{1,32}", row["fstype"]):
                  raise ValueError("inventory filesystem type")
              if row["uuid"] is not None and (not isinstance(row["uuid"], str) or not re.fullmatch(r"[A-Za-z0-9-]{1,64}", row["uuid"])):
                  raise ValueError("inventory UUID")
              if not isinstance(row["fsroot"], str) or not row["fsroot"].startswith("/") or len(row["fsroot"]) > 4096:
                  raise ValueError("inventory filesystem root")
          return parsed["filesystems"]

      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-subvolumes kind=function title="Python function m21_inventory_subvolumes"
      def m21_inventory_subvolumes(raw: bytes) -> dict[int, dict[str, Any]]:
          # Fixed -a -p -u -q -R field selection; field order may differ across btrfs-progs.
          # Paths stay private and are never used as command arguments or filesystem paths.
          rows = raw.decode("utf-8", "strict").splitlines()
          if len(raw) > 262144 or len(rows) > 512:
              raise ValueError("inventory subvolume listing")
          result = {}
          expected = {"ID", "gen", "parent", "top_level", "uuid", "parent_uuid", "received_uuid"}
          for line in rows:
              header, separator, path = line.partition(" path ")
              if not separator or not path or len(path) > 4096 or any(ord(ch) < 32 or ord(ch) == 127 for ch in path):
                  raise ValueError("inventory subvolume listing")
              tokens = header.replace("top level ", "top_level ").split()
              if len(tokens) != 14:
                  raise ValueError("inventory subvolume listing")
              fields = dict(zip(tokens[::2], tokens[1::2]))
              if set(fields) != expected:
                  raise ValueError("inventory subvolume listing")
              for key in ("ID", "gen", "parent", "top_level"):
                  if not re.fullmatch(r"[0-9]{1,20}", fields[key]) or int(fields[key]) >= 2**64:
                      raise ValueError("inventory subvolume listing")
              identifier, parent = int(fields["ID"]), int(fields["parent"])
              if identifier <= 5 or parent < 5 or parent == identifier or int(fields["top_level"]) < 5 or identifier in result:
                  raise ValueError("inventory subvolume listing")
              for key in ("uuid", "parent_uuid", "received_uuid"):
                  value = fields[key]
                  if value == "-" and key != "uuid":
                      fields[key] = None
                  elif not re.fullmatch(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}", value) or value == "00000000-0000-0000-0000-000000000000":
                      raise ValueError("inventory subvolume listing")
              result[identifier] = {"id": identifier, "parent_id": parent, "uuid": fields["uuid"],
                                    "snapshot_parent_uuid": fields["parent_uuid"], "received_uuid": fields["received_uuid"],
                                    "private_path": path}
          if len({row["uuid"] for row in result.values()}) != len(result):
              raise ValueError("inventory subvolume listing")
          return result


      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-lineage kind=function title="Python function m21_inventory_lineage"
      def m21_inventory_lineage(parent_uuid: str | None, home_uuid: str | None, descendant_uuids: set[str]) -> str:
          if parent_uuid is None:
              return "no-recorded-snapshot-parent"
          if parent_uuid == home_uuid:
              return "snapshot-of-home"
          if parent_uuid in descendant_uuids:
              return "snapshot-of-listed-home-descendant"
          return "snapshot-origin-outside-listed-home-lineage"


      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-graph kind=function title="Python function m21_inventory_graph"
      def m21_inventory_graph(before_raw: bytes, readonly_raw: bytes, after_raw: bytes,
                              root_before: bytes, root_after: bytes) -> dict[str, Any]:
          if not re.fullmatch(rb"[0-9]{1,20}\n?", root_before) or root_before != root_after:
              raise ValueError("inventory subvolume graph")
          home_id = int(root_before)
          before = m21_inventory_subvolumes(before_raw)
          after = m21_inventory_subvolumes(after_raw)
          readonly = m21_inventory_subvolumes(readonly_raw)
          # Generation counters may advance under ordinary live writes. Compare identity,
          # namespace membership, container parents and snapshot lineage, not generations.
          if before != after or home_id < 5 or (home_id != 5 and home_id not in before):
              raise ValueError("inventory subvolume graph")
          if any(identifier not in before or row != before[identifier] for identifier, row in readonly.items()):
              raise ValueError("inventory subvolume graph")
          depths = {}
          for identifier in before:
              seen = set()
              current = identifier
              depth_to_home = None
              distance = 0
              while current != 5:
                  if current in seen or current not in before:
                      raise ValueError("inventory subvolume graph")
                  seen.add(current)
                  if current == home_id:
                      depth_to_home = distance
                  current = before[current]["parent_id"]
                  distance += 1
              if home_id == 5: depth_to_home = distance
              if depth_to_home is not None and depth_to_home > 0:
                  depths[identifier] = depth_to_home
          if len(depths) > 64:
              # Keep the established 32-KiB public cache bound: never silently omit nodes.
              raise ValueError("inventory subvolume graph")
          home_uuid = None if home_id == 5 else before[home_id]["uuid"]
          descendant_uuids = {before[identifier]["uuid"] for identifier in depths}
          nodes = []
          for identifier, depth in sorted(depths.items()):
              row = before[identifier]
              nodes.append({"id": identifier, "parent_id": row["parent_id"], "uuid": row["uuid"],
                            "snapshot_parent_uuid": row["snapshot_parent_uuid"], "received_uuid": row["received_uuid"],
                            "read_only": identifier in readonly, "depth_below_home": depth,
                            "snapshot_named_path": ".snapshots" in row["private_path"].split("/"),
                            "lineage_class": m21_inventory_lineage(row["snapshot_parent_uuid"], home_uuid, descendant_uuids)})
          return {"schema": "mnx.m21.subvolume-graph.v1", "scope": "recursive-container-parent-id-closure",
                  "home_subvolume_id": home_id, "home_subvolume_uuid": home_uuid,
                  "filesystem_listing_count": len(before), "filesystem_listing_limit": 512,
                  "published_descendant_limit": 64, "descendant_count": len(nodes),
                  "direct_child_count": sum(row["depth_below_home"] == 1 for row in nodes),
                  "deeper_descendant_count": sum(row["depth_below_home"] > 1 for row in nodes),
                  "readonly_descendant_count": sum(row["read_only"] for row in nodes),
                  "snapshot_lineage_count": sum(row["snapshot_parent_uuid"] is not None for row in nodes),
                  "received_lineage_count": sum(row["received_uuid"] is not None for row in nodes),
                  "members": nodes, "identity_listings_agree": True,
                  "generations_used_as_stability_gate": False, "readonly_sample_is_atomic": False,
                  "names_used_as_authority": False, "dataset_contents_inspected": False,
                  "coverage_verified": False, "deletion_authorized": False}


      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-validate-graph kind=function title="Python function m21_inventory_validate_graph"
      def m21_inventory_validate_graph(graph: Any, total: int, snapshot_named: int) -> None:
          keys = {"schema", "scope", "home_subvolume_id", "home_subvolume_uuid", "filesystem_listing_count",
                  "filesystem_listing_limit", "published_descendant_limit", "descendant_count", "direct_child_count",
                  "deeper_descendant_count", "readonly_descendant_count", "snapshot_lineage_count", "received_lineage_count",
                  "members", "identity_listings_agree", "generations_used_as_stability_gate", "readonly_sample_is_atomic",
                  "names_used_as_authority", "dataset_contents_inspected", "coverage_verified", "deletion_authorized"}
          if not isinstance(graph, dict) or set(graph) != keys or graph["schema"] != "mnx.m21.subvolume-graph.v1" or graph["scope"] != "recursive-container-parent-id-closure":
              raise ValueError("inventory subvolume graph")
          if type(graph["filesystem_listing_count"]) is not int or not total <= graph["filesystem_listing_count"] <= 512:
              raise ValueError("inventory subvolume graph")
          if type(graph["filesystem_listing_limit"]) is not int or graph["filesystem_listing_limit"] != 512 or type(graph["published_descendant_limit"]) is not int or graph["published_descendant_limit"] != 64:
              raise ValueError("inventory subvolume graph")
          if graph["identity_listings_agree"] is not True:
              raise ValueError("inventory subvolume graph")
          for key in ("generations_used_as_stability_gate", "readonly_sample_is_atomic", "names_used_as_authority", "dataset_contents_inspected", "coverage_verified", "deletion_authorized"):
              if graph[key] is not False:
                  raise ValueError("inventory subvolume graph")
          home_id = graph["home_subvolume_id"]
          home_uuid = graph["home_subvolume_uuid"]
          uuid_pattern = r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}"
          if type(home_id) is not int or not 5 <= home_id < 2**64:
              raise ValueError("inventory subvolume graph")
          if (home_id == 5 and home_uuid is not None) or (home_id != 5 and (not isinstance(home_uuid, str) or not re.fullmatch(uuid_pattern, home_uuid) or home_uuid == "00000000-0000-0000-0000-000000000000")):
              raise ValueError("inventory subvolume graph")
          if home_id != 5 and graph["filesystem_listing_count"] <= total:
              raise ValueError("inventory subvolume graph")
          members = graph["members"]
          if not isinstance(members, list) or len(members) != total or not 0 <= total <= 64:
              raise ValueError("inventory subvolume graph")
          node_keys = {"id", "parent_id", "uuid", "snapshot_parent_uuid", "received_uuid", "read_only", "depth_below_home", "snapshot_named_path", "lineage_class"}
          ids = set(); uuids = set()
          for row in members:
              if not isinstance(row, dict) or set(row) != node_keys:
                  raise ValueError("inventory subvolume graph")
              for key in ("id", "parent_id"):
                  if type(row[key]) is not int or not (5 < row[key] < 2**64 if key == "id" else 5 <= row[key] < 2**64):
                      raise ValueError("inventory subvolume graph")
              if row["id"] == home_id or row["id"] in ids or row["uuid"] == home_uuid:
                  raise ValueError("inventory subvolume graph")
              for key in ("uuid", "snapshot_parent_uuid", "received_uuid"):
                  value = row[key]
                  if value is None and key != "uuid":
                      continue
                  if not isinstance(value, str) or not re.fullmatch(uuid_pattern, value) or value == "00000000-0000-0000-0000-000000000000":
                      raise ValueError("inventory subvolume graph")
              if row["uuid"] in uuids or type(row["read_only"]) is not bool or type(row["snapshot_named_path"]) is not bool or type(row["depth_below_home"]) is not int or not 1 <= row["depth_below_home"] <= 64:
                  raise ValueError("inventory subvolume graph")
              ids.add(row["id"]); uuids.add(row["uuid"])
          if [row["id"] for row in members] != sorted(ids):
              raise ValueError("inventory subvolume graph")
          lookup = {row["id"]: row for row in members}
          for row in members:
              current = row["id"]; seen = set(); depth = 0
              while current != home_id:
                  if current in seen or current not in lookup:
                      raise ValueError("inventory subvolume graph")
                  seen.add(current); current = lookup[current]["parent_id"]; depth += 1
              if row["depth_below_home"] != depth or row["lineage_class"] != m21_inventory_lineage(row["snapshot_parent_uuid"], home_uuid, uuids):
                  raise ValueError("inventory subvolume graph")
          counts = {"descendant_count": total, "direct_child_count": sum(row["depth_below_home"] == 1 for row in members),
                    "deeper_descendant_count": sum(row["depth_below_home"] > 1 for row in members),
                    "readonly_descendant_count": sum(row["read_only"] for row in members),
                    "snapshot_lineage_count": sum(row["snapshot_parent_uuid"] is not None for row in members),
                    "received_lineage_count": sum(row["received_uuid"] is not None for row in members)}
          if any(type(graph[key]) is not int or graph[key] != value for key,value in counts.items()) or snapshot_named != sum(row["snapshot_named_path"] for row in members):
              raise ValueError("inventory subvolume graph")


      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-executable-path kind=function title="Python function m21_inventory_executable_path"
      def m21_inventory_executable_path(value: Any) -> bool:
          # Only system-program locations may enter the public review list. Never executed.
          roots = ("/etc/monsternix/", "/etc/sandworm/", "/run/current-system/sw/bin/", "/run/wrappers/bin/", "/nix/store/")
          return (isinstance(value, str) and len(value) <= 256 and
                  re.fullmatch(r"/[A-Za-z0-9_./+-]+", value) is not None and
                  not any(part in ("", ".", "..") for part in value.split("/")[1:]) and
                  any(value.startswith(root) and len(value) > len(root) for root in roots))


      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-sudo-discovery kind=function title="Python function m21_inventory_sudo_discovery"
      def m21_inventory_sudo_discovery(body: bytes, codes: tuple[int, int, int]) -> dict[str, Any]:
          result = {"state": "query-unavailable", "command_candidates": [], "unrecognized_command_count": 0,
                    "unrestricted_command_entry_seen": False, "complete_policy_semantics_verified": False}
          if codes != (0, 0, 0):
              return result
          if len(body) > 65536:
              result["state"] = "output-bound"; return result
          try:
              text = body.decode("utf-8", "strict")
              if any(ord(ch) < 32 and ch not in "\n\t" or ord(ch) == 127 for ch in text):
                  raise ValueError("policy control character")
              lines = text.expandtabs(8).splitlines()
              if len(lines) > 512 or any(len(line) > 2048 for line in lines):
                  raise ValueError("policy line bound")
              entries = {}; unknown = 0; unrestricted = False; sections = 0; indent = None
              for line in lines:
                  if line.strip() == "Commands:":
                      indent = len(line) - len(line.lstrip()); sections += 1; continue
                  if not line.strip():
                      continue
                  if indent is None:
                      continue
                  if len(line) - len(line.lstrip()) <= indent:
                      indent = None; continue
                  words = line.strip().split(None, 1)
                  if words == ["ALL"]:
                      unrestricted = True; continue
                  if not m21_inventory_executable_path(words[0]):
                      unknown += 1; continue
                  # Keep only the executable, never its argument values or any raw policy line.
                  entries[words[0]] = entries.get(words[0], False) or len(words) > 1
              if len(entries) > 16:
                  result["state"] = "output-bound"; return result
              result.update(state="observed" if sections else "unrecognized-output",
                            command_candidates=[{"path": path, "arguments_present": arguments} for path, arguments in sorted(entries.items())],
                            unrecognized_command_count=unknown, unrestricted_command_entry_seen=unrestricted)
          except (UnicodeError, ValueError):
              result["state"] = "unrecognized-output"
          return result


      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-path-hint kind=function title="Python function m21_inventory_path_hint"
      def m21_inventory_path_hint(path: str) -> str:
          # Names are hints for review only. No named dataset is excluded or deleted here.
          parts = path.split("/")
          if ".snapshots" in parts:
              return "snapshot-directory-component"
          for sequence, hint in (((".local", "share", "containers", "storage"), "container-storage-path"),
                                 ((".local", "share", "flatpak"), "flatpak-path"),
                                 ((".local", "share", "libvirt"), "virtual-machine-path")):
              if any(tuple(parts[index:index+len(sequence)]) == sequence for index in range(len(parts))):
                  return hint
          if ".cache" in parts:
              return "cache-directory-component"
          if "VirtualBox VMs" in parts:
              return "virtual-machine-path"
          return "unclassified"


      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-discovery kind=function title="Python function m21_inventory_discovery"
      def m21_inventory_discovery(frames: dict[str, Any], graph: dict[str, Any]) -> dict[str, Any]:
          listing = m21_inventory_subvolumes(frames["subvolumes"][0])
          return {"schema": "mnx.m21.backup-source-discovery.v1",
                  "sudo_policy": m21_inventory_sudo_discovery(*frames["backup-sudo-policy"]),
                  "dataset_path_hints": [{"id": row["id"], "hint": m21_inventory_path_hint(listing[row["id"]]["private_path"])} for row in graph["members"]],
                  "query_account": "backup-source", "query_kind": "sudo-list-long-not-command-execution",
                  "effective_ssh_dispatch_verified": False, "exporter_content_reviewed": False,
                  "commands_executed_from_discovery": False, "names_used_as_authority": False,
                  "raw_sudo_policy_exported": False, "arbitrary_dataset_names_exported": False,
                  "backup_coverage_verified": False, "deletion_authorized": False}


      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-validate-discovery kind=function title="Python function m21_inventory_validate_discovery"
      def m21_inventory_validate_discovery(value: Any, graph: dict[str, Any]) -> None:
          fields = {"schema", "sudo_policy", "dataset_path_hints", "query_account", "query_kind", "effective_ssh_dispatch_verified",
                    "exporter_content_reviewed", "commands_executed_from_discovery", "names_used_as_authority", "raw_sudo_policy_exported",
                    "arbitrary_dataset_names_exported", "backup_coverage_verified", "deletion_authorized"}
          if not isinstance(value, dict) or set(value) != fields or value["schema"] != "mnx.m21.backup-source-discovery.v1":
              raise ValueError("inventory source discovery")
          if value["query_account"] != "backup-source" or value["query_kind"] != "sudo-list-long-not-command-execution":
              raise ValueError("inventory source discovery")
          for key in fields - {"schema", "sudo_policy", "dataset_path_hints", "query_account", "query_kind"}:
              if value[key] is not False: raise ValueError("inventory source discovery")
          policy = value["sudo_policy"]
          if (not isinstance(policy, dict) or set(policy) != {"state", "command_candidates", "unrecognized_command_count", "unrestricted_command_entry_seen", "complete_policy_semantics_verified"} or
                  policy["state"] not in ("observed", "query-unavailable", "output-bound", "unrecognized-output") or
                  policy["complete_policy_semantics_verified"] is not False or type(policy["unrestricted_command_entry_seen"]) is not bool or
                  type(policy["unrecognized_command_count"]) is not int or not 0 <= policy["unrecognized_command_count"] <= 512):
              raise ValueError("inventory source discovery")
          candidates = policy["command_candidates"]
          if not isinstance(candidates, list) or len(candidates) > 16:
              raise ValueError("inventory source discovery")
          paths = []
          for row in candidates:
              if (not isinstance(row, dict) or set(row) != {"path", "arguments_present"} or
                      not m21_inventory_executable_path(row["path"]) or type(row["arguments_present"]) is not bool):
                  raise ValueError("inventory source discovery")
              paths.append(row["path"])
          if paths != sorted(set(paths)) or (policy["state"] != "observed" and (candidates or policy["unrestricted_command_entry_seen"] or policy["unrecognized_command_count"])):
              raise ValueError("inventory source discovery")
          hints = value["dataset_path_hints"]
          if not isinstance(hints, list) or len(hints) != len(graph["members"]): raise ValueError("inventory source discovery")
          for row, member in zip(hints, graph["members"]):
              if (not isinstance(row, dict) or set(row) != {"id", "hint"} or type(row["id"]) is not int or row["id"] != member["id"] or
                      row["hint"] not in ("snapshot-directory-component", "container-storage-path", "flatpak-path", "virtual-machine-path", "cache-directory-component", "unclassified")):
                  raise ValueError("inventory source discovery")
              if (row["hint"] == "snapshot-directory-component") != member["snapshot_named_path"]:
                  raise ValueError("inventory source discovery")


      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-project kind=function title="Python function m21_inventory_project"
      def m21_inventory_project(raw: bytes, now: int) -> dict[str, Any]:
          frames = m21_inventory_frames(raw)
          #@MNX-PART id=99.08.mnx-office.m21-inventory-project.function.required kind=function title="Python function required"
          def required(name: str) -> bytes:
              body, codes = frames[name]
              if codes != (0, 0, 0): raise ValueError("required inventory command failed")
              return body
          if required("hostname").strip() != b"comfy-m21" or required("uid").strip() != b"0":
              raise ValueError("remote inventory identity")
          stamp = required("epoch").strip()
          if not re.fullmatch(rb"[0-9]{1,12}", stamp) or abs(int(stamp)-now) > 300:
              raise ValueError("remote inventory clock")
          before = m21_inventory_mounts(required("home-before"))
          after = m21_inventory_mounts(required("home-after"))
          if before != after or len(before) != 1 or before[0]["target"] != "/home" or before[0]["fstype"] != "btrfs" or before[0]["uuid"] != "5c208c49-1b6c-411e-899c-fca29e2d5d9b":
              raise ValueError("remote home identity or stability")
          rows = []
          labels = ("root", "home", "configuration", "application-state", "server-data", "boot")
          for label, path in zip(labels, M21_INVENTORY_PATHS):
              body, codes = frames["stat-"+label]
              row = {"path": path, "metadata_state": "unavailable", "stat_rc": codes[0],
                     "declared_home_export_scope": "home-source" if path == "/home" else "outside-declared-home-export",
                     "backup_coverage_verified": False}
              if codes[1:] != (0, 0) or (codes[0] == 0 and codes != (0,0,0)):
                  raise ValueError("inventory stat transport")
              if codes == (0, 0, 0):
                  if not re.fullmatch(rb"[0-9a-fA-F]{1,8}:[0-9]{1,10}:[0-9]{1,10}\n?", body):
                      raise ValueError("inventory stat fields")
                  mode, owner, group = body.strip().split(b":")
                  mode = int(mode, 16)
                  row.update(metadata_state="observed", kind="directory" if stat.S_ISDIR(mode) else "symlink" if stat.S_ISLNK(mode) else "other",
                             uid=int(owner), gid=int(group), mode=format(stat.S_IMODE(mode), "04o"))
                  mounts = m21_inventory_mounts(required("mount-"+label))
                  if len(mounts) != 1: raise ValueError("fixed-path mount ambiguity")
                  mount = mounts[0]
                  row.update(filesystem_type=mount["fstype"], filesystem_uuid=mount["uuid"],
                             mount_target=mount["target"] if mount["target"] in M21_INVENTORY_PATHS else "other-not-exported",
                             same_filesystem_as_home=mount["uuid"] == before[0]["uuid"],
                             same_mount_root_as_home=mount == before[0])
              rows.append(row)
          all_mounts = m21_inventory_mounts(required("mounts"))
          descendants = [m for m in all_mounts if m["target"].startswith("/home/")]
          graph = m21_inventory_graph(required("subvolumes"), required("readonly-subvolumes"),
                                      required("subvolumes-after"), required("home-rootid-before"),
                                      required("home-rootid-after"))
          snapshot_named = sum(row["snapshot_named_path"] for row in graph["members"])
          return {"remote_hostname": "comfy-m21", "remote_uid": 0, "remote_observed_epoch": int(stamp),
                  "home_filesystem_uuid": before[0]["uuid"], "home_mount_observations_agree": True,
                  "fixed_paths": rows, "home_descendant_mount_count": len(descendants),
                  "home_descendant_mount_types": sorted({m["fstype"] for m in descendants}),
                  "home_descendant_subvolume_count": graph["descendant_count"],
                  "snapshot_named_subvolume_count": snapshot_named,
                  "other_descendant_subvolume_count": graph["descendant_count"]-snapshot_named,
                  "subvolume_graph": graph, "backup_source_discovery": m21_inventory_discovery(frames, graph),
                  "subvolume_names_exported": False, "arbitrary_mount_paths_exported": False,
                  "topology_is_atomic_snapshot": False, "exporter_content_reviewed": False,
                  "home_nested_dataset_coverage_verified": False, "whole_machine_coverage_proven": False,
                  "remote_residue_disposability_verified": False}

      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-fingerprint kind=function title="Python function m21_inventory_fingerprint"
      def m21_inventory_fingerprint(public: bytes) -> str:
          import base64
          pieces = public.strip().split()
          if len(pieces) not in (2, 3) or pieces[0] != b"ssh-ed25519":
              raise ValueError("inventory public key encoding")
          blob = base64.b64decode(pieces[1], validate=True)
          if len(blob) != 51 or blob[:19] != b"\x00\x00\x00\x0bssh-ed25519\x00\x00\x00\x20":
              raise ValueError("inventory ED25519 key shape")
          return "SHA256:"+base64.b64encode(hashlib.sha256(blob).digest()).decode().rstrip("=")

      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-validate-record kind=function title="Python function m21_inventory_validate_record"
      def m21_inventory_validate_record(value: Any) -> None:
          required = {"schema", "observed_epoch", "source_sha256", "system", "state", "reason", "topology", "scope",
                      "network_initiator", "network_attempted", "ssh_private_identity_used", "repository_credentials_read",
                      "backup_payload_read", "configuration_content_read_on_m21", "backup_started", "remote_files_created_by_inventory",
                      "remote_state_mutation_requested", "deletion_authorized", "whole_machine_coverage_proven", "program_sha256",
                      "raw_remote_output_exported", "remote_authentication_logs_may_change", "probe_statuses", "diagnostic_code"}
          if not isinstance(value, dict) or not required <= set(value) or set(value)-required-{"remote_command_rc", "remote_diagnostic_bytes"}:
              raise ValueError("inventory cache fields")
          if value["schema"] not in ("mnx.m21.source-inventory.v1", "mnx.m21.source-inventory.v2", "mnx.m21.source-inventory.v3") or value["scope"] != "fixed-system-paths-and-home-nested-topology-not-file-content" or value["network_initiator"] != "m16":
              raise ValueError("inventory cache protocol")
          if value["state"] not in ("observed", "unavailable", "review-required") or value["reason"] not in ("none", "local-identity-preflight", "client-identity", "host-identity", "remote-command", "remote-document", "ssh-or-noninteractive-remote-command-unavailable", "interrupted", "time-bound"):
              raise ValueError("inventory cache classification")
          for name in ("source_sha256", "program_sha256"):
              if not isinstance(value[name], str) or not re.fullmatch(r"[0-9a-f]{64}", value[name]): raise ValueError("inventory cache digest")
          if not isinstance(value["system"], str) or not re.fullmatch(r"/nix/store/[0-9a-z]{32}-nixos-system-monster-16-[A-Za-z0-9.+_-]+", value["system"]):
              raise ValueError("inventory cache closure")
          if type(value["observed_epoch"]) is not int or not 0 < value["observed_epoch"] < 10**12:
              raise ValueError("inventory cache epoch")
          for name in ("network_attempted", "ssh_private_identity_used"):
              if type(value[name]) is not bool: raise ValueError("inventory cache boolean")
          for name in ("repository_credentials_read", "backup_payload_read", "configuration_content_read_on_m21", "backup_started", "remote_files_created_by_inventory", "remote_state_mutation_requested", "deletion_authorized", "whole_machine_coverage_proven", "raw_remote_output_exported"):
              if value[name] is not False: raise ValueError("inventory cache content boundary")
          if value["remote_authentication_logs_may_change"] is not True: raise ValueError("inventory authentication log semantics")
          for name in ("remote_command_rc", "remote_diagnostic_bytes"):
              if name in value and (type(value[name]) is not int or not 0 <= value[name] <= 1048576):
                  raise ValueError("inventory cache subprocess field")
          codes = {"none", "unclassified", "identity-directory", "identity-metadata", "host-identity-publication", "client-identity", "host-identity", "identity-changed", "remote inventory identity", "remote inventory clock", "remote home identity or stability", "required inventory command failed", "inventory frame envelope", "inventory frame membership", "inventory frame bounds", "inventory mount document", "inventory mount row", "inventory stat fields", "inventory stat transport", "fixed-path mount ambiguity", "subvolume count bound", "subvolume row", "inventory subvolume listing", "inventory subvolume graph", "inventory source discovery", "inventory subprocess output bound"}
          if value["diagnostic_code"] not in codes: raise ValueError("inventory diagnostic code")
          recursive = value["schema"] in ("mnx.m21.source-inventory.v2", "mnx.m21.source-inventory.v3")
          discovery = value["schema"] == "mnx.m21.source-inventory.v3"
          expected_labels = {"hostname", "uid", "epoch", "home-before", "mounts", "subvolumes", "home-after"}
          if recursive:
              expected_labels.update(("home-rootid-before", "readonly-subvolumes", "subvolumes-after", "home-rootid-after"))
          if discovery: expected_labels.add("backup-sudo-policy")
          for label in ("root", "home", "configuration", "application-state", "server-data", "boot"):
              expected_labels.update(("stat-"+label, "mount-"+label))
          probes = value["probe_statuses"]
          if not isinstance(probes, dict) or (probes and set(probes) != expected_labels): raise ValueError("inventory probe-status fields")
          for item in probes.values():
              if not isinstance(item,dict) or set(item) != {"command_rc","reader_rc","encoder_rc","bytes"}: raise ValueError("inventory probe-status row")
              for name, bound in (("command_rc",255),("reader_rc",255),("encoder_rc",255),("bytes",262144)):
                  if type(item[name]) is not int or not 0 <= item[name] <= bound: raise ValueError("inventory probe-status count")
          topology = value["topology"]
          if value["state"] != "observed":
              if topology is not None or value["reason"] == "none": raise ValueError("inventory incomplete observation")
              return
          if recursive:
              if set(probes) != expected_labels:
                  raise ValueError("inventory probe-status fields")
              essential = expected_labels - {key for key in expected_labels if key.startswith("stat-") or key.startswith("mount-")} - {"backup-sudo-policy"}
              if any(any(probes[key][code] != 0 for code in ("command_rc", "reader_rc", "encoder_rc")) for key in essential):
                  raise ValueError("inventory probe-status fields")
          expected = {"remote_hostname", "remote_uid", "remote_observed_epoch", "home_filesystem_uuid", "home_mount_observations_agree", "fixed_paths", "home_descendant_mount_count", "home_descendant_mount_types", "home_descendant_subvolume_count", "snapshot_named_subvolume_count", "other_descendant_subvolume_count", "subvolume_names_exported", "arbitrary_mount_paths_exported", "topology_is_atomic_snapshot", "exporter_content_reviewed", "home_nested_dataset_coverage_verified", "whole_machine_coverage_proven", "remote_residue_disposability_verified"}
          if recursive: expected.add("subvolume_graph")
          if discovery: expected.add("backup_source_discovery")
          if not isinstance(topology, dict) or set(topology) != expected or value["reason"] != "none" or value.get("remote_command_rc") != 0 or value["network_attempted"] is not True or value["ssh_private_identity_used"] is not True:
              raise ValueError("inventory observed topology")
          if topology["remote_hostname"] != "comfy-m21" or type(topology["remote_uid"]) is not int or topology["remote_uid"] != 0 or topology["home_filesystem_uuid"] != "5c208c49-1b6c-411e-899c-fca29e2d5d9b" or topology["home_mount_observations_agree"] is not True:
              raise ValueError("inventory topology identity")
          if type(topology["remote_observed_epoch"]) is not int or abs(topology["remote_observed_epoch"]-value["observed_epoch"]) > 540:
              raise ValueError("inventory topology epoch")
          for name in ("subvolume_names_exported", "arbitrary_mount_paths_exported", "topology_is_atomic_snapshot", "exporter_content_reviewed", "home_nested_dataset_coverage_verified", "whole_machine_coverage_proven", "remote_residue_disposability_verified"):
              if topology[name] is not False: raise ValueError("inventory topology proof scope")
          for name, bound in (("home_descendant_mount_count", 1024), ("home_descendant_subvolume_count", 512), ("snapshot_named_subvolume_count", 512), ("other_descendant_subvolume_count", 512)):
              if type(topology[name]) is not int or not 0 <= topology[name] <= bound: raise ValueError("inventory topology count")
          if topology["home_descendant_subvolume_count"] != topology["snapshot_named_subvolume_count"]+topology["other_descendant_subvolume_count"]:
              raise ValueError("inventory subvolume accounting")
          if recursive:
              m21_inventory_validate_graph(topology["subvolume_graph"], topology["home_descendant_subvolume_count"], topology["snapshot_named_subvolume_count"])
          if discovery:
              m21_inventory_validate_discovery(topology["backup_source_discovery"], topology["subvolume_graph"])
              policy_state = topology["backup_source_discovery"]["sudo_policy"]["state"]
              query = probes["backup-sudo-policy"]
              query_ok = all(query[field] == 0 for field in ("command_rc", "reader_rc", "encoder_rc"))
              if (policy_state == "query-unavailable") == query_ok:
                  raise ValueError("inventory source discovery")
          types = topology["home_descendant_mount_types"]
          if not isinstance(types, list) or len(types) > 1024 or any(not isinstance(x,str) or not re.fullmatch(r"[A-Za-z0-9_.-]{1,32}", x) for x in types) or types != sorted(set(types)):
              raise ValueError("inventory nested filesystem types")
          if not isinstance(topology["fixed_paths"], list) or len(topology["fixed_paths"]) != len(M21_INVENTORY_PATHS): raise ValueError("inventory fixed paths")
          base = {"path", "metadata_state", "stat_rc", "declared_home_export_scope", "backup_coverage_verified"}
          observed = {"kind", "uid", "gid", "mode", "filesystem_type", "filesystem_uuid", "mount_target", "same_filesystem_as_home", "same_mount_root_as_home"}
          for row, path in zip(topology["fixed_paths"], M21_INVENTORY_PATHS):
              if not isinstance(row, dict) or row.get("path") != path or row.get("backup_coverage_verified") is not False or row.get("declared_home_export_scope") != ("home-source" if path == "/home" else "outside-declared-home-export"):
                  raise ValueError("inventory fixed path semantics")
              if row.get("metadata_state") == "unavailable":
                  if set(row) != base or type(row.get("stat_rc")) is not int or not 1 <= row["stat_rc"] <= 255: raise ValueError("inventory unavailable stat")
                  continue
              if row.get("metadata_state") != "observed" or set(row) != base|observed or row["stat_rc"] != 0: raise ValueError("inventory observed stat")
              if row["kind"] not in ("directory", "symlink", "other") or not isinstance(row["mode"],str) or not re.fullmatch(r"[0-7]{4}",row["mode"]): raise ValueError("inventory stat encoding")
              for name in ("uid", "gid"):
                  if type(row[name]) is not int or not 0 <= row[name] <= 2**32-1: raise ValueError("inventory owner field")
              if row["mount_target"] not in (*M21_INVENTORY_PATHS, "other-not-exported") or not isinstance(row["filesystem_type"],str) or not re.fullmatch(r"[A-Za-z0-9_.-]{1,32}",row["filesystem_type"]): raise ValueError("inventory filesystem fields")
              if row["filesystem_uuid"] is not None and (not isinstance(row["filesystem_uuid"],str) or not re.fullmatch(r"[A-Za-z0-9-]{1,64}",row["filesystem_uuid"])): raise ValueError("inventory filesystem identity")
              if row["same_filesystem_as_home"] != (row["filesystem_uuid"] == topology["home_filesystem_uuid"]) or type(row["same_mount_root_as_home"]) is not bool: raise ValueError("inventory filesystem comparison")

      #@MNX-PART id=99.08.mnx-office.function.m21-inventory-cache-write kind=function title="Python function m21_inventory_cache_write"
      def m21_inventory_cache_write(value: dict[str, Any], destination: Path = M21_INVENTORY_CACHE) -> None:
          parent = destination.parent
          for part in (parent, *parent.parents):
              info = part.lstat()
              if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
                  raise ValueError("inventory publication parent")
          if destination.exists() or destination.is_symlink():
              secure_regular_file(destination)
              if destination.stat().st_nlink != 1: raise ValueError("inventory publication link count")
          m21_inventory_validate_record(value)
          raw = canonical_json(value)
          if len(raw) > 32768: raise ValueError("inventory publication size")
          fd, name = tempfile.mkstemp(prefix=".m21-inventory-", dir=parent)
          try:
              with os.fdopen(fd, "wb") as stream:
                  os.fchmod(stream.fileno(), 0o600)
                  stream.write(raw); stream.flush(); os.fsync(stream.fileno())
              os.replace(name, destination)
              directory = os.open(parent, os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
              try: os.fsync(directory)
              finally: os.close(directory)
          finally:
              Path(name).unlink(missing_ok=True)

      #@MNX-PART id=99.08.mnx-office.function.command-m21-source-inventory kind=function title="Python function command_m21_source_inventory"
      def command_m21_source_inventory(args: argparse.Namespace) -> int:
          import signal
          if not args.switch_owned or os.geteuid() != 0 or os.uname().nodename != "monster-16" or os.environ.get("MNX_OFFICE_POST_COMMIT_SEAL") != "1":
              raise OfficeError("m21 source inventory requires the sealed switch continuation")
          # No caller-selected host, paths, program, credentials, or test-environment authority.
          for key in tuple(os.environ):
              if key.startswith("MNX_OFFICE_") and key != "MNX_OFFICE_POST_COMMIT_SEAL":
                  os.environ.pop(key)
          source = parse_source(DEFAULT_CONFIG)
          record = load_record(record_path_from_current(DEFAULT_STATE_ROOT), require_root=True)
          runtime = validate_record_against_runtime(record, source, allow_incomplete_switch=True, require_root=True)
          now = int(dt.datetime.now(dt.timezone.utc).timestamp())
          result = {"schema": "mnx.m21.source-inventory.v3", "observed_epoch": now,
                    "source_sha256": source["sha256"], "system": runtime["running_system"],
                    "state": "unavailable", "reason": "not-attempted", "topology": None,
                    "scope": "fixed-system-paths-and-home-nested-topology-not-file-content",
                    "network_initiator": "m16", "network_attempted": False, "ssh_private_identity_used": False,
                    "repository_credentials_read": False, "backup_payload_read": False,
                    "configuration_content_read_on_m21": False, "backup_started": False,
                    "remote_files_created_by_inventory": False, "remote_state_mutation_requested": False,
                    "deletion_authorized": False, "whole_machine_coverage_proven": False,
                    "program_sha256": sha256_bytes(M21_INVENTORY_REMOTE.encode()),
                    "raw_remote_output_exported": False, "remote_authentication_logs_may_change": True,
                    "probe_statuses": {}, "diagnostic_code": "none"}
          key = Path("/var/lib/m21-btrfs-pull-backup/id_ed25519")
          known = key.with_name("known_hosts")
          #@MNX-PART id=99.08.mnx-office.m21-inventory-command.function.interrupt kind=function title="Python function interrupt"
          def interrupt(signum: int, frame: Any) -> None:
              raise InterruptedError("inventory interrupted")
          previous_handlers = {sig: signal.signal(sig, interrupt) for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)}
          rc = 76
          try:
              for parent in key.parents:
                  info = parent.lstat()
                  if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
                      raise ValueError("identity-directory")
              info = key.lstat()
              if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != 0 or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) not in (0o600, 0o400) or not 1 <= info.st_size <= 16384:
                  raise ValueError("identity-metadata")
              key_identity = (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
              state, known_text = health_read_file(known, 65536)
              if state != "read": raise ValueError("host-identity-publication")
              result["reason"] = "client-identity"
              key_rc, public, _ = m21_inventory_run(["${pkgs.openssh}/bin/ssh-keygen", "-y", "-P", "", "-f", str(key)], limit=16384)
              if key_rc or m21_inventory_fingerprint(public) != "SHA256:n4Kvw4B9XxRy9l43RBPFfPgR5cQUGgCtqbAJJLuTzzA":
                  raise ValueError("client-identity")
              with tempfile.TemporaryDirectory(prefix="mnx-m21-topology-") as directory:
                  host_file = Path(directory)/"known_hosts"
                  host_file.write_text(known_text); host_file.chmod(0o600)
                  result["reason"] = "host-identity"
                  host_rc, host_lines, _ = m21_inventory_run(["${pkgs.openssh}/bin/ssh-keygen", "-F", "192.168.100.119", "-f", str(host_file)], limit=65536)
                  entries = [line.split() for line in host_lines.splitlines() if line and not line.startswith(b"#")]
                  ed = [parts for parts in entries if len(parts) >= 3 and parts[1] == b"ssh-ed25519"]
                  if host_rc or len(ed) != 1 or m21_inventory_fingerprint(b" ".join(ed[0][1:3])) != "SHA256:BfdYWZn5Qiaw5c3nzteZzKp47VQExA333A5LcgrYiHc":
                      raise ValueError("host-identity")
                  host_file.write_bytes(b"192.168.100.119 "+b" ".join(ed[0][1:3])+b"\n")
                  ssh = ["${pkgs.openssh}/bin/ssh", "-F", "/dev/null", "-T", "-i", str(key)]
                  for option in ("BatchMode=yes", "IdentitiesOnly=yes", "IdentityAgent=none", "CertificateFile=none",
                                 "StrictHostKeyChecking=yes", "HostKeyAlgorithms=ssh-ed25519", "GlobalKnownHostsFile=/dev/null",
                                 "UserKnownHostsFile="+str(host_file), "UpdateHostKeys=no", "PasswordAuthentication=no",
                                 "KbdInteractiveAuthentication=no", "ForwardAgent=no", "ForwardX11=no", "ClearAllForwardings=yes",
                                 "ControlMaster=no", "ControlPath=none", "ProxyCommand=none", "ProxyJump=none", "PermitLocalCommand=no",
                                 "ConnectTimeout=10", "ServerAliveInterval=10", "ServerAliveCountMax=2"):
                      ssh.extend(("-o", option))
                  ssh.extend(("h0p3@192.168.100.119", "/run/wrappers/bin/sudo -n -- /run/current-system/sw/bin/env -i PATH=/run/current-system/sw/bin:/run/wrappers/bin LC_ALL=C /run/current-system/sw/bin/bash --noprofile --norc -s"))
                  result.update(reason="remote-command", network_attempted=True, ssh_private_identity_used=True)
                  remote_rc, raw, diagnostic = m21_inventory_run(ssh, data=M21_INVENTORY_REMOTE.encode(), seconds=240)
                  result["remote_command_rc"] = remote_rc if remote_rc >= 0 else 128-remote_rc
                  result["remote_diagnostic_bytes"] = len(diagnostic)
                  current = key.lstat()
                  if key_identity != (current.st_dev, current.st_ino, current.st_mode, current.st_uid, current.st_gid, current.st_size, current.st_mtime_ns, current.st_ctime_ns) or current.st_nlink != 1:
                      raise ValueError("identity-changed")
                  if remote_rc != 0:
                      result["reason"] = "ssh-or-noninteractive-remote-command-unavailable"
                      rc = 75
                  else:
                      result["reason"] = "remote-document"
                      frames = m21_inventory_frames(raw)
                      result["probe_statuses"] = {name: {"command_rc": codes[0], "reader_rc": codes[1], "encoder_rc": codes[2], "bytes": len(body)} for name, (body, codes) in frames.items()}
                      topology = m21_inventory_project(raw, int(dt.datetime.now(dt.timezone.utc).timestamp()))
                      result.update(state="observed", reason="none", topology=topology)
                      rc = 0
          except (InterruptedError, KeyboardInterrupt):
              result.update(state="unavailable", reason="interrupted"); rc = 75
          except (TimeoutError, subprocess.TimeoutExpired):
              result.update(state="unavailable", reason="time-bound"); rc = 75
          except (OSError, ValueError, TypeError, KeyError, UnicodeError) as exc:
              safe_codes = {"identity-directory", "identity-metadata", "host-identity-publication", "client-identity", "host-identity", "identity-changed", "remote inventory identity", "remote inventory clock", "remote home identity or stability", "required inventory command failed", "inventory frame envelope", "inventory frame membership", "inventory frame bounds", "inventory mount document", "inventory mount row", "inventory stat fields", "inventory stat transport", "fixed-path mount ambiguity", "subvolume count bound", "subvolume row", "inventory subvolume listing", "inventory subvolume graph", "inventory source discovery", "inventory subprocess output bound"}
              result["diagnostic_code"] = str(exc) if type(exc) is ValueError and str(exc) in safe_codes else "unclassified"
              result["state"] = "review-required"
              # Failure location, not exception text or remote stderr, is the public reason.
              if result["reason"] == "not-attempted": result["reason"] = "local-identity-preflight"
              rc = 76
          finally:
              for sig, handler in previous_handlers.items(): signal.signal(sig, handler)
          m21_inventory_cache_write(result)
          print("m21_source_inventory="+canonical_json(result).decode().rstrip())
          print("m21_source_inventory_cache="+str(M21_INVENTORY_CACHE))
          print("MNX_M21_SOURCE_INVENTORY="+("OBSERVED_NOT_COVERAGE_PROOF" if rc == 0 else "DEFERRED" if rc == 75 else "REVIEW"))
          return rc

      #@MNX-PART id=99.08.mnx-office.function.health-m21-inventory kind=function title="Python function health_m21_inventory"
      def health_m21_inventory(root: Path, uid: int, now: int) -> dict[str, Any]:
          state, raw = health_read_file(root/str(M21_INVENTORY_CACHE).lstrip("/"), 32768, root=root, uid=uid)
          result = {"state": "not-yet-observed", "read_state": state, "network_used_here": False,
                    "whole_machine_coverage_proven": False, "deletion_authorized": False}
          if state != "read": return result
          try:
              value = m21_inventory_json(raw.encode())
              m21_inventory_validate_record(value)
              if value.get("schema") not in ("mnx.m21.source-inventory.v1", "mnx.m21.source-inventory.v2", "mnx.m21.source-inventory.v3") or value.get("state") not in ("observed", "unavailable", "review-required"):
                  raise ValueError("cached inventory schema")
              if type(value.get("observed_epoch")) is not int or not 0 < value["observed_epoch"] <= now:
                  raise ValueError("cached inventory timestamp")
              for name in ("whole_machine_coverage_proven", "deletion_authorized", "repository_credentials_read", "backup_payload_read", "backup_started", "remote_state_mutation_requested", "raw_remote_output_exported"):
                  if value.get(name) is not False: raise ValueError("cached inventory boundary")
              # Only the bounded, validated projection written by this source-owned action is
              # returned from the root-owned cache. Raw remote text is never written there.
              if len(canonical_json(value)) > 32768: raise ValueError("cached inventory bound")
              result.update(state=value["state"], observation=value, age_seconds=now-value["observed_epoch"],
                            recursive_inventory_available=(value["schema"] in ("mnx.m21.source-inventory.v2", "mnx.m21.source-inventory.v3") and value["state"] == "observed"),
