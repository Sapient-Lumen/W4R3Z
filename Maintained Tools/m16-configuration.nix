      #@MNX-PART id=99.55.mnx-atlas.function.capture-navigation-output kind=function title="Python function capture_navigation_output"
      def capture_navigation_output(function) -> str:
          from io import StringIO
          handle = StringIO()
          previous = sys.stdout
          try:
              sys.stdout = handle
              function()
          finally:
              sys.stdout = previous
          return handle.getvalue()
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.command-navigation-bundle kind=function title="Python function command_navigation_bundle"
      def command_navigation_bundle(navigation: NavigationAtlas, output: Path | None) -> int:
          stamp = datetime.now().strftime("%Y%m%dT%H%M%S")
          output = (
              output
              or Path(tempfile.gettempdir()) / f"mnx-atlas-bundle-{stamp}-{navigation.sha256[:12]}.tar.gz"
          ).resolve()
          if output.exists():
              raise PolicyError(f"atlas bundle output already exists: {output}")
          output.parent.mkdir(parents=True, exist_ok=True)
          with tempfile.TemporaryDirectory(prefix="mnx-atlas-bundle-") as temporary:
              root = Path(temporary) / f"mnx-atlas-{navigation.sha256[:12]}"
              definitions_dir = root / "definitions"
              parts_dir = root / "parts"
              definitions_dir.mkdir(parents=True)
              parts_dir.mkdir(parents=True)
              (root / "configuration.nix").write_bytes(navigation.raw_bytes)
              (root / "manifest.json").write_text(
                  json.dumps(navigation_manifest(navigation), indent=2, sort_keys=True) + "\n",
                  encoding="utf-8",
              )
              (root / "atlas-map.txt").write_text(
                  capture_navigation_output(lambda: print_navigation_index(navigation, include_parts=True)),
                  encoding="utf-8",
              )
              for definition in navigation.core.definitions:
                  safe = re.sub(r"[^A-Za-z0-9._-]+", "-", definition.marker.path).strip("-")[:120]
                  (definitions_dir / f"{definition.marker.ordinal:03d}__{safe}.nixdef").write_bytes(
                      definition_bytes(navigation, definition)
                  )
              for order, part in enumerate(navigation.policy.parts, start=1):
                  (parts_dir / f"{order:04d}__{part.part_id}.nixpart").write_bytes(
                      part_bytes(navigation, part)
                  )
              (root / "README.txt").write_text(
                  "Derived navigation bundle. configuration.nix remains the only authoritative source. "
                  "Definitions and parts are exact byte-preserving source slices.\n",
                  encoding="utf-8",
              )
              with tarfile.open(output, "w:gz") as archive:
                  archive.add(root, arcname=root.name)
          print(f"bundle={output}")
          print(f"bundle_sha256={hashlib.sha256(output.read_bytes()).hexdigest()}")
          print(f"source_sha256={navigation.sha256}")
          print(f"definition_count={len(navigation.core.definitions)}")
          print(f"part_count={len(navigation.policy.parts)}")
          print("exact_source_bytes_preserved=yes")
          print("MNX_ATLAS_BUNDLE=PASS")
          return 0
      
      
