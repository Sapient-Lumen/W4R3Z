      @dataclass(frozen=True)
      #@MNX-PART id=99.57.mnx-relations.class.relationshipatlas kind=class title="Python class RelationshipAtlas"
      class RelationshipAtlas:
          source: Path
          raw_bytes: bytes
          text: str
          lines: tuple[str, ...]
          chunks: tuple[ChunkAnchor, ...]
          definitions: tuple[DefinitionAnchor, ...]
          flows: tuple[Flow, ...]
          laws: tuple[Law, ...]
            
          @property
          #@MNX-PART id=99.57.mnx-relations.function.sha256 kind=function title="Python function sha256"
          def sha256(self) -> str:
              return hashlib.sha256(self.raw_bytes).hexdigest()
            
            
      #@MNX-PART id=99.57.mnx-relations.function.parse-fields kind=function title="Python function parse_fields"
      def parse_fields(payload: str, line_number: int, marker: str) -> dict[str, str]:
          try:
              tokens = shlex.split(payload, posix=True)
          except ValueError as exc:
              raise RelationError(f'invalid {marker} marker at line {line_number}: {exc}') from exc
          fields: dict[str, str] = {}
          for token in tokens:
              if '=' not in token:
                  raise RelationError(f'invalid {marker} token at line {line_number}: {token}')
              key, value = token.split('=', 1)
              if key in fields:
                  raise RelationError(f'duplicate {marker} field {key!r} at line {line_number}')
              fields[key] = value
          return fields
            
            
      #@MNX-PART id=99.57.mnx-relations.function.split-refs kind=function title="Python function split_refs"
      def split_refs(value: str) -> tuple[str, ...]:
          if not value or value == 'none':
              return ()
          return tuple(item.strip() for item in value.split(',') if item.strip())
            
            
      #@MNX-PART id=99.57.mnx-relations.function.containing-chunk kind=function title="Python function containing_chunk"
      def containing_chunk(chunks: tuple[ChunkAnchor, ...], line_number: int) -> ChunkAnchor | None:
          selected: ChunkAnchor | None = None
          for chunk in chunks:
              if chunk.marker_line > line_number:
                  break
              selected = chunk
          return selected
            
            
      #@MNX-PART id=99.57.mnx-relations.function.parse-atlas kind=function title="Python function parse_atlas"
      def parse_atlas(path: Path) -> RelationshipAtlas:
          if not path.is_file():
              raise RelationError(f'configuration is not a regular file: {path}')
          try:
              raw_bytes = path.read_bytes()
              text = raw_bytes.decode('utf-8')
          except OSError as exc:
              raise RelationError(f'cannot read configuration: {path}: {exc}') from exc
          except UnicodeDecodeError as exc:
              raise RelationError(f'configuration is not valid UTF-8: {exc}') from exc
          lines = tuple(text.splitlines(keepends=True))
            
          schema_lines = [line.rstrip('\r\n') for line in lines if line.startswith('# MNX_RELATIONSHIP_ATLAS_SCHEMA=')]
          if schema_lines != ['# MNX_RELATIONSHIP_ATLAS_SCHEMA=1']:
              raise RelationError(f'expected exactly one relationship-atlas schema 1 declaration; found={schema_lines!r}')
            
          chunks: list[ChunkAnchor] = []
          chunk_ids: set[str] = set()
          for line_number, line in enumerate(lines, start=1):
              match = CHUNK_RE.match(line.rstrip('\r\n'))
              if not match:
                  continue
              fields = parse_fields(match.group(1), line_number, 'chunk')
              chunk_id = fields.get('id', "")
              slug = fields.get('slug', "")
              title = fields.get('title', "")
              if not ID_RE.fullmatch(chunk_id) or not ID_RE.fullmatch(slug) or not title:
                  raise RelationError(f'invalid chunk marker at line {line_number}')
              if chunk_id in chunk_ids:
                  raise RelationError(f'duplicate chunk id at line {line_number}: {chunk_id}')
              chunk_ids.add(chunk_id)
              chunks.append(ChunkAnchor(chunk_id, slug, title, line_number))
          chunk_tuple = tuple(chunks)
          if '09.10' not in chunk_ids:
              raise RelationError('relationship-office chunk 09.10 is missing')
            
          definitions: list[DefinitionAnchor] = []
          definition_paths: set[str] = set()
          for line_number, line in enumerate(lines, start=1):
              match = DEF_RE.match(line.rstrip('\r\n'))
              if not match:
                  continue
              path_value, section, role, ordinal_text = match.groups()
              if path_value in definition_paths:
                  raise RelationError(f'duplicate definition path at line {line_number}: {path_value}')
              definition_paths.add(path_value)
              definitions.append(DefinitionAnchor(path_value, section, role, int(ordinal_text), line_number))
            
          flows: list[Flow] = []
          flow_ids: set[str] = set()
          laws: list[Law] = []
          law_ids: set[str] = set()
          for line_number, line in enumerate(lines, start=1):
              flow_match = FLOW_RE.match(line.rstrip('\r\n'))
              law_match = LAW_RE.match(line.rstrip('\r\n'))
              if flow_match:
                  fields = parse_fields(flow_match.group(1), line_number, 'flow')
                  flow_id = fields.get('id', "")
                  kind = fields.get('kind', "")
                  title = fields.get('title', "")
                  source = fields.get('source', "")
                  destination = fields.get('destination', "")
                  defs = split_refs(fields.get('defs', ""))
                  if not ID_RE.fullmatch(flow_id) or not KIND_RE.fullmatch(kind) or not title or not source or not destination or not defs:
                      raise RelationError(f'invalid flow marker at line {line_number}: id={flow_id!r}')
                  if flow_id in flow_ids:
                      raise RelationError(f'duplicate flow id at line {line_number}: {flow_id}')
                  chunk = containing_chunk(chunk_tuple, line_number)
                  if chunk is None or chunk.chunk_id != '09.10':
                      raise RelationError(f'flow marker must live in chunk 09.10, line {line_number}')
                  missing = [item for item in defs if item not in definition_paths]
                  if missing:
                      raise RelationError(f'flow {flow_id} references missing definitions: {missing}')
                  flow_ids.add(flow_id)
                  flows.append(Flow(flow_id, kind, title, line_number, chunk.chunk_id, tuple(sorted(fields.items()))))
              elif law_match:
                  fields = parse_fields(law_match.group(1), line_number, 'law')
                  law_id = fields.get('id', "")
                  severity = fields.get('severity', "")
                  title = fields.get('title', "")
                  statement = fields.get('statement', "")
                  defs = split_refs(fields.get('defs', ""))
                  if not ID_RE.fullmatch(law_id) or severity not in SEVERITIES or not title or not statement or not defs:
                      raise RelationError(f'invalid law marker at line {line_number}: id={law_id!r}')
                  if law_id in law_ids:
                      raise RelationError(f'duplicate law id at line {line_number}: {law_id}')
                  chunk = containing_chunk(chunk_tuple, line_number)
                  if chunk is None or chunk.chunk_id != '09.10':
                      raise RelationError(f'law marker must live in chunk 09.10, line {line_number}')
                  missing = [item for item in defs if item not in definition_paths]
                  if missing:
                      raise RelationError(f'law {law_id} references missing definitions: {missing}')
                  law_ids.add(law_id)
                  laws.append(Law(law_id, severity, title, statement, line_number, chunk.chunk_id, tuple(sorted(fields.items()))))
            
          if not flows or not laws:
              raise RelationError('relationship atlas has no flows or no laws')
          return RelationshipAtlas(path.resolve(), raw_bytes, text, lines, chunk_tuple, tuple(definitions), tuple(flows), tuple(laws))
            
            
      #@MNX-PART id=99.57.mnx-relations.function.verify-required kind=function title="Python function verify_required"
      def verify_required(atlas: RelationshipAtlas) -> None:
          flow_ids = {item.flow_id for item in atlas.flows}
          law_ids = {item.law_id for item in atlas.laws}
          missing_flows = sorted(REQUIRED_FLOW_IDS - flow_ids)
          missing_laws = sorted(REQUIRED_LAW_IDS - law_ids)
          if missing_flows:
              raise RelationError(f'required flows are missing: {missing_flows}')
          if missing_laws:
              raise RelationError(f'required laws are missing: {missing_laws}')
            
            
      #@MNX-PART id=99.57.mnx-relations.function.definitions-for kind=function title="Python function definitions_for"
      def definitions_for(value: str, atlas: RelationshipAtlas) -> tuple[DefinitionAnchor, ...]:
          by_path = {item.path: item for item in atlas.definitions}
          return tuple(by_path[item] for item in split_refs(value))
            
            
      #@MNX-PART id=99.57.mnx-relations.function.flow-card kind=function title="Python function flow_card"
      def flow_card(flow: Flow, atlas: RelationshipAtlas) -> str:
          fields = dict(flow.fields)
          output = [
              f'FLOW id={flow.flow_id}',
              f'title={flow.title}',
              f'kind={flow.kind}',
              f'marker_line={flow.marker_line}',
              f'chunk={flow.chunk_id}',
          ]
          for key in sorted(fields):
              if key in {'id', 'kind', 'title', 'defs'}:
                  continue
              output.append(f'{key}={fields[key]}')
          output.append('definitions:')
          for definition in definitions_for(fields['defs'], atlas):
              output.append(f'  {definition.ordinal:03d} section={definition.section} role={definition.role} path={definition.path}')
              output.append(f'    source_command=mnx def {shlex.quote(definition.path)}')
          return '\n'.join(output) + '\n'
            
            
      #@MNX-PART id=99.57.mnx-relations.function.law-card kind=function title="Python function law_card"
      def law_card(law: Law, atlas: RelationshipAtlas) -> str:
          fields = dict(law.fields)
          output = [
              f'LAW id={law.law_id}',
              f'title={law.title}',
              f'severity={law.severity}',
              f'statement={law.statement}',
              f'marker_line={law.marker_line}',
              f'chunk={law.chunk_id}',
          ]
          for key in sorted(fields):
              if key in {'id', 'severity', 'title', 'statement', 'defs'}:
                  continue
              output.append(f'{key}={fields[key]}')
          output.append('definitions:')
          for definition in definitions_for(fields['defs'], atlas):
              output.append(f'  {definition.ordinal:03d} section={definition.section} role={definition.role} path={definition.path}')
              output.append(f'    source_command=mnx def {shlex.quote(definition.path)}')
          return '\n'.join(output) + '\n'
            
            
      #@MNX-PART id=99.57.mnx-relations.function.resolve-flow kind=function title="Python function resolve_flow"
      def resolve_flow(atlas: RelationshipAtlas, selector: str) -> Flow:
          exact = [item for item in atlas.flows if item.flow_id == selector]
          if len(exact) == 1:
              return exact[0]
          query = selector.lower()
          partial = [item for item in atlas.flows if query in item.flow_id.lower() or query in item.title.lower()]
          if len(partial) == 1:
              return partial[0]
          if not partial:
              raise RelationError(f'no flow matches: {selector}')
          raise RelationError('ambiguous flow selector: ' + selector + '\n' + '\n'.join(f'  {item.flow_id} {item.title}' for item in partial))
            
            
      #@MNX-PART id=99.57.mnx-relations.function.resolve-law kind=function title="Python function resolve_law"
      def resolve_law(atlas: RelationshipAtlas, selector: str) -> Law:
          exact = [item for item in atlas.laws if item.law_id == selector]
          if len(exact) == 1:
              return exact[0]
          query = selector.lower()
          partial = [item for item in atlas.laws if query in item.law_id.lower() or query in item.title.lower()]
          if len(partial) == 1:
              return partial[0]
          if not partial:
              raise RelationError(f'no law matches: {selector}')
          raise RelationError('ambiguous law selector: ' + selector + '\n' + '\n'.join(f'  {item.law_id} {item.title}' for item in partial))
            
            
      #@MNX-PART id=99.57.mnx-relations.function.command-index kind=function title="Python function command_index"
      def command_index(atlas: RelationshipAtlas) -> int:
          print(f'source={atlas.source}')
          print(f'source_sha256={atlas.sha256}')
          print(f'flow_count={len(atlas.flows)}')
          print(f'law_count={len(atlas.laws)}')
          print('\nFLOWS')
          for item in atlas.flows:
              fields = dict(item.fields)
              print(f'{item.flow_id}\t{item.kind}\tline={item.marker_line}\t{fields["source"]} -> {fields["destination"]}\t{item.title}')
          print('\nLAWS')
          for item in atlas.laws:
              print(f'{item.law_id}\t{item.severity}\tline={item.marker_line}\t{item.title}')
          return 0
            
            
      #@MNX-PART id=99.57.mnx-relations.function.command-related kind=function title="Python function command_related"
      def command_related(atlas: RelationshipAtlas, query: str) -> int:
          lowered = query.lower()
          count = 0
          for flow in atlas.flows:
              haystack = ' '.join([flow.flow_id, flow.title, *(value for _, value in flow.fields)]).lower()
              if lowered in haystack:
                  count += 1
                  print(f'flow\t{flow.flow_id}\t{flow.title}\tcommand=mnx flow {shlex.quote(flow.flow_id)}')
          for law in atlas.laws:
              haystack = ' '.join([law.law_id, law.title, law.statement, *(value for _, value in law.fields)]).lower()
              if lowered in haystack:
                  count += 1
                  print(f'law\t{law.law_id}\t{law.title}\tcommand=mnx law {shlex.quote(law.law_id)}')
          for definition in atlas.definitions:
              if lowered in definition.path.lower():
                  count += 1
                  print(f'definition\t{definition.ordinal:03d}\t{definition.path}\tcommand=mnx def {shlex.quote(definition.path)}')
          print(f'related_match_count={count}')
          return 0 if count else 1
            
            
      #@MNX-PART id=99.57.mnx-relations.function.command-explain kind=function title="Python function command_explain"
      def command_explain(atlas: RelationshipAtlas, selector: str) -> int:
          for flow in atlas.flows:
              if flow.flow_id == selector:
                  sys.stdout.write(flow_card(flow, atlas))
                  return 0
          for law in atlas.laws:
              if law.law_id == selector:
                  sys.stdout.write(law_card(law, atlas))
                  return 0
          exact_defs = [item for item in atlas.definitions if item.path == selector or str(item.ordinal) == selector]
          if len(exact_defs) == 1:
              definition = exact_defs[0]
              print(f'DEFINITION path={definition.path}')
              print(f'ordinal={definition.ordinal:03d}')
              print(f'section={definition.section}')
              print(f'role={definition.role}')
              print(f'marker_line={definition.marker_line}')
              print(f'source_command=mnx def {shlex.quote(definition.path)}')
              print('relationships:')
              matched = 0
              for flow in atlas.flows:
                  if definition.path in split_refs(flow.field('defs')):
                      matched += 1
                      print(f'  flow {flow.flow_id}: {flow.title}')
              for law in atlas.laws:
                  if definition.path in split_refs(law.field('defs')):
                      matched += 1
                      print(f'  law {law.law_id}: {law.title}')
              if matched == 0:
                  print('  none-declared')
              return 0
          return command_related(atlas, selector)
            
            
      #@MNX-PART id=99.57.mnx-relations.function.safe-node kind=function title="Python function safe_node"
      def safe_node(value: str) -> str:
          return 'n_' + hashlib.sha256(value.encode('utf-8')).hexdigest()[:12]
            
            
      #@MNX-PART id=99.57.mnx-relations.function.selected-flows kind=function title="Python function selected_flows"
      def selected_flows(atlas: RelationshipAtlas, selector: str | None) -> tuple[Flow, ...]:
          if selector is None:
              return atlas.flows
          return (resolve_flow(atlas, selector),)
            
            
      #@MNX-PART id=99.57.mnx-relations.function.command-graph kind=function title="Python function command_graph"
      def command_graph(atlas: RelationshipAtlas, selector: str | None, output_format: str) -> int:
          flows = selected_flows(atlas, selector)
          if output_format == 'text':
              for flow in flows:
                  fields = dict(flow.fields)
                  middle = fields.get('service') or fields.get('programs') or flow.flow_id
                  print(f'{flow.flow_id}: {fields["source"]} -> {middle} -> {fields["destination"]}')
                  if fields.get('timer') and fields['timer'] != 'none':
                      print(f'  timer {fields["timer"]} -> {middle}')
                  if fields.get('lock') and fields['lock'] != 'none':
                      print(f'  {middle} uses lock {fields["lock"]}')
                  if fields.get('state') and fields['state'] != 'none':
                      print(f'  {middle} records state {fields["state"]}')
              return 0
          if output_format == 'dot':
              print('digraph monsternix {')
              print('  rankdir=LR;')
              for flow in flows:
                  fields = dict(flow.fields)
                  source = fields['source']
                  destination = fields['destination']
                  middle = fields.get('service') or fields.get('programs') or flow.flow_id
                  for value in (source, middle, destination):
                      print(f'  {safe_node(value)} [label={json.dumps(value)}];')
                  print(f'  {safe_node(source)} -> {safe_node(middle)} [label={json.dumps(flow.flow_id)}];')
                  print(f'  {safe_node(middle)} -> {safe_node(destination)};')
              print('}')
              return 0
          print('flowchart LR')
          for flow in flows:
              fields = dict(flow.fields)
              source = fields['source']
              destination = fields['destination']
              middle = fields.get('service') or fields.get('programs') or flow.flow_id
              print(f'  {safe_node(source)}[{json.dumps(source)}] -->|{flow.flow_id}| {safe_node(middle)}[{json.dumps(middle)}] --> {safe_node(destination)}[{json.dumps(destination)}]')
          return 0
            
            
      #@MNX-PART id=99.57.mnx-relations.function.command-manifest kind=function title="Python function command_manifest"
      def command_manifest(atlas: RelationshipAtlas) -> int:
          payload = {
              'schema': 1,
              'source': str(atlas.source),
              'source_sha256': atlas.sha256,
              'source_bytes': len(atlas.raw_bytes),
              'exact_byte_identity': True,
              'flow_count': len(atlas.flows),
              'law_count': len(atlas.laws),
              'flows': [
                  {
                      'id': item.flow_id,
                      'kind': item.kind,
                      'title': item.title,
                      'marker_line': item.marker_line,
                      'chunk': item.chunk_id,
                      'fields': dict(item.fields),
                  }
                  for item in atlas.flows
              ],
              'laws': [
                  {
                      'id': item.law_id,
                      'severity': item.severity,
                      'title': item.title,
                      'statement': item.statement,
                      'marker_line': item.marker_line,
                      'chunk': item.chunk_id,
                      'fields': dict(item.fields),
                  }
                  for item in atlas.laws
              ],
          }
          json.dump(payload, sys.stdout, indent=2, sort_keys=True)
          print()
          return 0
            
            
      #@MNX-PART id=99.57.mnx-relations.function.command-bundle kind=function title="Python function command_bundle"
      def command_bundle(atlas: RelationshipAtlas, output: Path | None) -> int:
          stamp = datetime.now().strftime('%Y%m%dT%H%M%S')
          output = (output or Path(tempfile.gettempdir()) / f'mnx-relationship-bundle-{stamp}-{atlas.sha256[:12]}.tar.gz').resolve()
          if output.exists():
              raise RelationError(f'relationship bundle output already exists: {output}')
          output.parent.mkdir(parents=True, exist_ok=True)
          with tempfile.TemporaryDirectory(prefix='mnx-relationship-bundle-') as temp:
              root = Path(temp) / f'mnx-relationships-{atlas.sha256[:12]}'
              flow_dir = root / 'flows'
              law_dir = root / 'laws'
              flow_dir.mkdir(parents=True)
              law_dir.mkdir(parents=True)
              (root / 'configuration.nix').write_bytes(atlas.raw_bytes)
              (root / 'relationship-map.txt').write_text(capture_output(lambda: command_index(atlas)), encoding='utf-8')
              (root / 'manifest.json').write_text(capture_output(lambda: command_manifest(atlas)), encoding='utf-8')
              for flow in atlas.flows:
                  (flow_dir / f'{flow.flow_id}.flow.txt').write_text(flow_card(flow, atlas), encoding='utf-8')
              for law in atlas.laws:
                  (law_dir / f'{law.law_id}.law.txt').write_text(law_card(law, atlas), encoding='utf-8')
              (root / 'README.txt').write_text('Derived relationship bundle. configuration.nix remains the only authoritative source.\n', encoding='utf-8')
              with tarfile.open(output, 'w:gz') as archive:
                  archive.add(root, arcname=root.name)
          print(f'bundle={output}')
          print(f'bundle_sha256={hashlib.sha256(output.read_bytes()).hexdigest()}')
          print(f'source_sha256={atlas.sha256}')
          print(f'flow_count={len(atlas.flows)}')
          print(f'law_count={len(atlas.laws)}')
          print('MNX_RELATION_BUNDLE=PASS')
          return 0
            
            
      #@MNX-PART id=99.57.mnx-relations.function.capture-output kind=function title="Python function capture_output"
      def capture_output(function) -> str:
          from io import StringIO
          handle = StringIO()
          old = sys.stdout
          try:
              sys.stdout = handle
              function()
          finally:
              sys.stdout = old
          return handle.getvalue()
            
            
      #@MNX-PART id=99.57.mnx-relations.function.command-self-test kind=function title="Python function command_self_test"
      def command_self_test() -> int:
          sample = (
              '#!/usr/bin/env bash\n'
              '# MNX_RELATIONSHIP_ATLAS_SCHEMA=1\n'
              '#@MNX-CHUNK id=09.10 slug=relationship-atlas title="Relationships"\n'
              '#@MNX-FLOW id=sample-flow kind=test title="Sample flow" source="A" destination="B" defs="foo,bar" service=sample.service timer=none\n'
              '#@MNX-LAW id=sample-law severity=hard title="Sample law" statement="Keep it true" defs="foo" enforcement="self-test"\n'
              '#@MNX-CHUNK id=10.00 slug=definitions title="Definitions"\n'
              '#@MNX-DEF path=foo section=10.00 role=policy ordinal=001\n'
              'foo = true;\n'
              '#@MNX-DEF path=bar section=10.00 role=policy ordinal=002\n'
              'bar = false;\n'
          )
          with tempfile.TemporaryDirectory(prefix='mnx-relations-self-test-') as temp:
              path = Path(temp) / 'configuration.nix'
              path.write_text(sample, encoding='utf-8')
              atlas = parse_atlas(path)
              if len(atlas.flows) != 1 or len(atlas.laws) != 1:
                  raise RelationError('self-test relationship counts are wrong')
              if resolve_flow(atlas, 'sample-flow').title != 'Sample flow':
                  raise RelationError('self-test flow resolution failed')
              if resolve_law(atlas, 'sample-law').statement != 'Keep it true':
                  raise RelationError('self-test law resolution failed')
              if command_explain(atlas, 'foo') != 0:
                  raise RelationError('self-test definition explanation failed')
              duplicate = sample.replace('#@MNX-FLOW id=sample-flow', '#@MNX-FLOW id=sample-flow kind=test title="Duplicate" source="A" destination="B" defs="foo"\n#@MNX-FLOW id=sample-flow', 1)
              path.write_text(duplicate, encoding='utf-8')
              try:
                  parse_atlas(path)
              except RelationError:
                  pass
              else:
                  raise RelationError('self-test duplicate flow rejection failed')
              missing = sample.replace('defs="foo,bar"', 'defs="foo,missing"', 1)
              path.write_text(missing, encoding='utf-8')
              try:
                  parse_atlas(path)
              except RelationError:
                  pass
              else:
                  raise RelationError('self-test missing-definition rejection failed')
              raw = sample.encode('utf-8').replace(b'\n', b'\r\n')
              path.write_bytes(raw)
              crlf = parse_atlas(path)
              if crlf.sha256 != hashlib.sha256(raw).hexdigest():
                  raise RelationError('self-test CRLF source identity is not byte-exact')
          print('exact_source_byte_identity=yes')
          print('MNX_RELATION_ATLAS_SELF_TEST=PASS')
          return 0
            
            
      #@MNX-PART id=99.57.mnx-relations.function.build-parser kind=function title="Python function build_parser"
      def build_parser() -> argparse.ArgumentParser:
          parser = argparse.ArgumentParser(prog='mnx-relations', description='Explicit flow, law, ownership, and operational-neighborhood atlas for Monsternix')
          parser.add_argument('--config', default=str(DEFAULT_CONFIG))
          sub = parser.add_subparsers(dest='command', required=True)
          sub.add_parser('index', help='list all declared flows and laws')
          sub.add_parser('verify', help='validate schema, references, uniqueness, and required relationships')
          sub.add_parser('manifest', help='machine-readable JSON relationship manifest')
          flows = sub.add_parser('flows', help='list flows, optionally filtered')
          flows.add_argument('selector', nargs='?')
          flow = sub.add_parser('flow', help='show one flow card and its definitions')
          flow.add_argument('selector')
          laws = sub.add_parser('laws', help='list laws, optionally filtered')
          laws.add_argument('selector', nargs='?')
          law = sub.add_parser('law', help='show one law card and its definitions')
          law.add_argument('selector')
          related = sub.add_parser('related', help='find flows, laws, and definitions related to a string')
          related.add_argument('query')
          explain = sub.add_parser('explain', help='explain an exact flow, law, or definition; otherwise search related records')
          explain.add_argument('selector')
          graph = sub.add_parser('graph', help='render all or one flow as text, DOT, or Mermaid')
          graph.add_argument('selector', nargs='?')
          graph.add_argument('--format', choices=['text', 'dot', 'mermaid'], default='text')
          bundle = sub.add_parser('bundle', help='create a source-plus-relations tar.gz')
          bundle.add_argument('--out', type=Path)
          sub.add_parser('self-test')
          return parser
            
            
      #@MNX-PART id=99.57.mnx-relations.function.main kind=function title="Python function main"
      def main(argv: list[str] | None = None) -> int:
          args = build_parser().parse_args(argv)
          try:
              if args.command == 'self-test':
                  return command_self_test()
              atlas = parse_atlas(Path(args.config))
              if args.command == 'verify':
                  verify_required(atlas)
                  print(f'source={atlas.source}')
                  print(f'source_sha256={atlas.sha256}')
                  print(f'flow_count={len(atlas.flows)}')
                  print(f'law_count={len(atlas.laws)}')
                  print('MNX_RELATION_ATLAS=PASS')
                  return 0
              if args.command == 'index':
                  return command_index(atlas)
              if args.command == 'manifest':
                  return command_manifest(atlas)
              if args.command == 'flows':
                  items = atlas.flows
                  if args.selector:
                      query = args.selector.lower()
                      items = tuple(item for item in items if query in item.flow_id.lower() or query in item.title.lower())
                  for item in items:
                      fields = dict(item.fields)
                      print(f'{item.flow_id}\t{item.kind}\t{fields["source"]} -> {fields["destination"]}\t{item.title}')
                  return 0 if items else 1
              if args.command == 'flow':
                  sys.stdout.write(flow_card(resolve_flow(atlas, args.selector), atlas))
                  return 0
              if args.command == 'laws':
                  items = atlas.laws
                  if args.selector:
                      query = args.selector.lower()
                      items = tuple(item for item in items if query in item.law_id.lower() or query in item.title.lower() or query in item.statement.lower())
                  for item in items:
                      print(f'{item.law_id}\t{item.severity}\t{item.title}')
                  return 0 if items else 1
              if args.command == 'law':
                  sys.stdout.write(law_card(resolve_law(atlas, args.selector), atlas))
                  return 0
              if args.command == 'related':
                  return command_related(atlas, args.query)
              if args.command == 'explain':
                  return command_explain(atlas, args.selector)
              if args.command == 'graph':
                  return command_graph(atlas, args.selector, args.format)
              if args.command == 'bundle':
                  return command_bundle(atlas, args.out)
              raise RelationError(f'unsupported command: {args.command}')
          except BrokenPipeError:
              try:
                  sys.stdout.close()
              except OSError:
                  pass
              return 0
          except RelationError as exc:
              print(f'MNX_RELATION_ATLAS_ERROR: {exc}', file=sys.stderr)
              return 1
            
            
      if __name__ == '__main__':
          raise SystemExit(main())
      '';
      checkPhase = ''
        set -Eeuo pipefail
        ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
        "$out" self-test
      '';
    };
  };

#@MNX-CHUNK id=99.60 slug=refactor-workbench title="Pre-refactor preparation and pinned-contract workbench"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-refactor" section=99.60 role=generated-program ordinal=273
  environment.etc."monsternix/bin/mnx-refactor" = {
    source = pkgs.writeTextFile {
      name = "mnx-refactor";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      set -Eeuo pipefail
      export LC_ALL=C SYSTEMD_PAGER=cat SYSTEMD_COLORS=0 PAGER=cat

      COMMAND="''${1:-help}"
      shift || true
      CFG="''${MNX_CONFIG:-/etc/nixos/configuration.nix}"
      BASELINE_NAME="pre-refactor"
      REPLACE=0

      while (( $# > 0 )); do
        case "$1" in
          --config)
            CFG="$2"
            shift 2
            ;;
          --name)
            BASELINE_NAME="$2"
            shift 2
            ;;
          --replace)
            REPLACE=1
            shift
            ;;
          *)
            break
            ;;
        esac
      done

      #@MNX-PART id=99.60.mnx-refactor.function.need_root kind=function title="Function need_root"
      need_root() {
        if [[ ''${EUID:-$(id -u)} -ne 0 ]]; then
          [[ -x /run/wrappers/bin/sudo ]] || { echo '/run/wrappers/bin/sudo is unavailable' >&2; exit 126; }
          args=("$COMMAND" --config "$CFG" --name "$BASELINE_NAME")
          (( REPLACE == 0 )) || args+=(--replace)
          args+=("$@")
          exec /run/wrappers/bin/sudo -- /etc/monsternix/bin/mnx-refactor "''${args[@]}"
        fi
      }

      #@MNX-PART id=99.60.mnx-refactor.function.heavy_storage_active kind=function title="Function heavy_storage_active"
      heavy_storage_active() {
        local unit state
        for unit in \
          nixos-upgrade.service \
          nix-gc.service \
          btrbk-main.service \
          btrbk-archive-to-new-storage.service \
          m21-btrfs-pull-backup.service \
          m16-backup-m21.service \
          m16-restic-maintenance.service \
          rsync-m16-new-to-old.service \
          duperemove-home.service \
          duperemove-m16-new-storage.service \
          'btrfs-scrub--.service' \
          'btrfs-scrub-mnt-m16\x2dnew\x2dstorage.service'
        do
          state="$(systemctl is-active "$unit" 2>/dev/null || true)"
          case "$state" in
            active|activating|reloading)
              printf '%s\n' "$unit"
              ;;
          esac
        done
      }

      #@MNX-PART id=99.60.mnx-refactor.function.identity kind=function title="Function identity"
      identity() {
        local source_hash active_hash
        source_hash="$(sha256sum "$CFG" 2>/dev/null | awk '{print $1}' || true)"
        active_hash="$(sha256sum /run/current-system/configuration.nix 2>/dev/null | awk '{print $1}' || true)"
        printf 'configuration=%s\n' "$CFG"
        printf 'configuration_sha256=%s\n' "''${source_hash:-unreadable}"
        printf 'active_configuration_sha256=%s\n' "''${active_hash:-unreadable}"
        printf 'source_matches_active=%s\n' "$([[ -n "$source_hash" && "$source_hash" == "$active_hash" ]] && echo yes || echo no)"
        printf 'running_system=%s\n' "$(readlink -f /run/current-system 2>/dev/null || true)"
        printf 'default_system=%s\n' "$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
        printf 'system_state=%s\n' "$(systemctl is-system-running 2>/dev/null || true)"
      }

      #@MNX-PART id=99.60.mnx-refactor.function.planner kind=function title="Function planner"
      planner() {
        ${pkgs.python3}/bin/python3 - "$CFG" "$COMMAND" "$@" <<'PY'
      from __future__ import annotations
      
      import argparse
      import datetime as dt
      import grp
      import hashlib
      import ipaddress
      import json
      import os
      import platform
      import re
      import shutil
      import stat
      import subprocess
      import sys
      import tempfile
      from pathlib import Path
      
      ATLAS_DEFAULT = Path('/etc/monsternix/bin/mnx-atlas')
      RELATIONS_DEFAULT = Path('/etc/monsternix/bin/mnx-relations')
      NAME_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$')
      PORT_REVIEW_SCHEMA = 1
      CAPSULE_SCHEMA = 1
      CAPSULE_MAX_SOURCE_BYTES = 16 * 1024 * 1024
      SUBSTRATE_SCHEMA = 2
      RECONSTRUCTION_PACKET_SCHEMA = 1
      BACKUP_SOAK_REVIEW_SCHEMA = 1
      SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
      PORT_MAX_SOURCE_BYTES = 8 * 1024 * 1024
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.class.plannererror kind=class title="Python class PlannerError"
      class PlannerError(RuntimeError):
          pass
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.require kind=function title="Python function require"
      def require(condition: bool, message: str) -> None:
          if not condition:
              raise PlannerError(message)
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.canonical-json kind=function title="Python function canonical_json"
      def canonical_json(data: object) -> str:
          return json.dumps(data, sort_keys=True, separators=(',', ':'), ensure_ascii=False) + '\n'
      
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.read-port-source kind=function title="Python function read_port_source"
      def read_port_source(path: Path) -> dict:
          requested = path.expanduser()
          try:
              requested_lstat = requested.lstat()
              resolved = requested.resolve(strict=True)
              before = resolved.stat()
          except OSError as exc:
              raise PlannerError(f"port-review source is unavailable: {path}: {exc}") from exc
          if not stat.S_ISREG(before.st_mode):
              raise PlannerError(f"port-review source is not a regular file: {resolved}")
          if before.st_size > PORT_MAX_SOURCE_BYTES:
              raise PlannerError(
                  f"port-review source exceeds {PORT_MAX_SOURCE_BYTES} bytes: {before.st_size}"
              )
          try:
              with resolved.open("rb") as stream:
                  raw = stream.read(PORT_MAX_SOURCE_BYTES + 1)
              after = resolved.stat()
          except OSError as exc:
              raise PlannerError(f"port-review source could not be read: {resolved}: {exc}") from exc
          if len(raw) > PORT_MAX_SOURCE_BYTES:
              raise PlannerError(
                  f"port-review source exceeds {PORT_MAX_SOURCE_BYTES} bytes while reading: {resolved}"
              )
          stable_before = (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
          stable_after = (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
          if stable_before != stable_after or len(raw) != after.st_size:
              raise PlannerError(f"port-review source changed while it was being read: {resolved}")
          try:
              decoded = raw.decode("utf-8", errors="strict")
          except UnicodeDecodeError as exc:
              raise PlannerError(f"port-review source is not strict UTF-8: {resolved}: {exc}") from exc
          line_count = raw.count(b"\n") + (1 if raw and not raw.endswith(b"\n") else 0)
          return {
              "requested": str(requested),
              "resolved": str(resolved),
              "is_symlink": stat.S_ISLNK(requested_lstat.st_mode),
              "raw": raw,
              "text": decoded,
              "sha256": hashlib.sha256(raw).hexdigest(),
              "bytes": len(raw),
              "lines": line_count,
          }
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.normalized-bash-line kind=function title="Python function normalized_bash_line"
      def normalized_bash_line(line: str) -> str:
          match = re.match(r"^\s*#@MNX-BASH ?(.*)$", line)
          return match.group(1) if match else line
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.extract-dispatch-commands kind=function title="Python function extract_dispatch_commands"
      def extract_dispatch_commands(text: str) -> list[str]:
          lines = [normalized_bash_line(line) for line in text.splitlines()]
          start_re = re.compile(r'^\s*case\s+"\$(?:COMMAND|command)"\s+in\s*$')
          any_case_re = re.compile(r"^\s*case\b.*\bin\s*$")
          end_re = re.compile(r"^\s*esac\b")
          label_re = re.compile(r"^\s*([A-Za-z0-9][A-Za-z0-9_|-]*)\)\s*")
          commands: set[str] = set()
          for index, line in enumerate(lines):
              if not start_re.match(line):
                  continue
              depth = 1
              for candidate in lines[index + 1:]:
                  if depth == 1:
                      label = label_re.match(candidate)
                      if label:
                          for name in label.group(1).split("|"):
                              if name not in {"help"} and not name.startswith("-"):
                                  commands.add(name)
                  if any_case_re.match(candidate):
                      depth += 1
                  if end_re.match(candidate):
                      depth -= 1
                      if depth == 0:
                          break
          return sorted(commands)
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.marker-ids kind=function title="Python function marker_ids"
      def marker_ids(text: str, marker: str) -> list[str]:
          pattern = re.compile(
              rf"(?m)^\s*#@MNX-{re.escape(marker)}\s+[^\n]*?\bid=([A-Za-z0-9][A-Za-z0-9._-]*)"
          )
          return sorted(set(pattern.findall(text)))
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.assignment-boolean kind=function title="Python function assignment_boolean"
      def assignment_boolean(text: str, path: str) -> str:
          escaped = re.escape(path)
          match = re.search(
              rf"(?m)^\s*{escaped}\s*=\s*(?:lib\.mkDefault\s+)?(true|false)\s*;",
              text,
          )
          return match.group(1) if match else "unresolved"
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.active-nix-let-in kind=function title="Python function active_nix_let_in"
      def active_nix_let_in(text: str) -> str:
          lines = text.splitlines()
          header = re.compile(r"^\s*\{\s*config\b.*\}\s*:\s*$")
          for index, line in enumerate(lines):
              if not header.match(line):
                  continue
              window = [item.strip() for item in lines[index + 1:index + 50] if not item.lstrip().startswith("#")]
              return "yes" if "let" in window and "in" in window else "no"
          return "unresolved"
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.source-policy-summary kind=function title="Python function source_policy_summary"
      def source_policy_summary(text: str) -> dict:
          if re.search(r"(?m)^\s*imports\s*=\s*\[\s*\]\s*;", text):
              imports = "empty"
          elif re.search(r"(?m)^\s*imports\s*=", text):
              imports = "computed-or-nonempty"
          else:
              imports = "absent"
          state = re.search(r'(?m)^\s*system\.stateVersion\s*=\s*"([^"]+)"\s*;', text)
          control = re.search(r"(?m)^# MNX_CONTROL_PLANE=([^\n]+)$", text)
          firewall = assignment_boolean(text, "networking.firewall.enable")
          if firewall == "unresolved":
              firewall = assignment_boolean(text, "firewall.enable")
          return {
              "imports": imports,
              "active_let_in": active_nix_let_in(text),
              "firewall": firewall,
              "openssh": assignment_boolean(text, "services.openssh.enable"),
              "mutable_users": assignment_boolean(text, "users.mutableUsers"),
              "auto_upgrade": assignment_boolean(text, "system.autoUpgrade.enable"),
              "copy_system_configuration": assignment_boolean(text, "system.copySystemConfiguration"),
              "state_version": state.group(1) if state else "unresolved",
              "control_plane": control.group(1) if control else "unresolved",
          }
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.machine-binding-counts kind=function title="Python function machine_binding_counts"
      def machine_binding_counts(text: str) -> dict:
          ipv4: set[str] = set()
          for candidate in re.findall(r"(?<![0-9])(?:[0-9]{1,3}\.){3}[0-9]{1,3}(?![0-9])", text):
              try:
                  address = ipaddress.ip_address(candidate)
              except ValueError:
                  continue
              if isinstance(address, ipaddress.IPv4Address):
                  ipv4.add(str(address))
          uuids = set(re.findall(r"(?i)\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b", text))
          fingerprints = set(re.findall(r"\bSHA256:[A-Za-z0-9+/=]{16,}\b", text))
          mount_paths = set(re.findall(r"/mnt/[A-Za-z0-9._/@%+,:=-]+(?:/[A-Za-z0-9._/@%+,:=-]+)*", text))
          device_paths = set(re.findall(r"/dev/[A-Za-z0-9._/@%+,:=-]+(?:/[A-Za-z0-9._/@%+,:=-]+)*", text))
          user_names = set(re.findall(r"(?m)^\s*users\.users\.(?:\"([^\"]+)\"|([A-Za-z0-9_-]+))(?:\.|\s*=)", text))
          flattened_users = {left or right for left, right in user_names}
          host_names = set(re.findall(r'(?m)^\s*networking\.hostName\s*=\s*(?:lib\.mkDefault\s+)?"([^"]+)"', text))
          return {
              "ipv4_unique": len(ipv4),
              "ipv4_private": sum(1 for item in ipv4 if ipaddress.ip_address(item).is_private),
              "uuid_unique": len(uuids),
              "host_fingerprint_unique": len(fingerprints),
              "mount_path_unique": len(mount_paths),
              "device_path_unique": len(device_paths),
              "declared_user_unique": len(flattened_users),
              "declared_hostname_unique": len(host_names),
          }
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.source-profile kind=function title="Python function source_profile"
      def source_profile(text: str, counts: dict) -> str:
          if counts["chunks"] and counts["definitions"] and counts["office_markers"]:
              return "monsternix-machine-office"
          if "#@MNX-CONSTITUTION-BEGIN" in text and "# MNX_CONSTITUTION_SCHEMA=" in text:
              return "monsternix-foundation"
          if re.search(r"(?m)^# MNX_DOCUMENT_SCHEMA=", text):
              return "monsternix-monolith"
          return "unclassified-source"
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.extract-port-facts kind=function title="Python function extract_port_facts"
      def extract_port_facts(source: dict) -> dict:
          text = source["text"]
          generated = sorted(set(re.findall(r'environment\.etc\."monsternix/bin/([^"\n]+)"', text)))
          unit_pattern = re.compile(
              r'(?m)^\s*systemd\.(services|timers|paths|sockets)\.(?:"([^"]+)"|([A-Za-z0-9_.\\-]+))\s*='
          )
          units: dict[str, list[str]] = {name: [] for name in ["services", "timers", "paths", "sockets"]}
          for kind, quoted, bare in unit_pattern.findall(text):
              units[kind].append(quoted or bare)
          for kind in units:
              units[kind] = sorted(set(units[kind]))
          counts = {
              "chunks": len(re.findall(r"(?m)^#@MNX-CHUNK\s+", text)),
              "definitions": len(re.findall(r"(?m)^#@MNX-DEF\s+", text)),
              "parts": len(re.findall(r"(?m)^\s*#@MNX-PART\s+", text)),
              "flows": len(marker_ids(text, "FLOW")),
              "laws": len(marker_ids(text, "LAW")),
              "office_markers": len(re.findall(r"(?m)^#@MNX-OFFICE(?:-|\s)", text)),
              "generated_programs": len(generated),
              "services": len(units["services"]),
              "timers": len(units["timers"]),
              "paths": len(units["paths"]),
              "sockets": len(units["sockets"]),
          }
          document = re.search(r"(?m)^# MNX_DOCUMENT_SCHEMA=([0-9]+)$", text)
          constitution = re.search(r"(?m)^# MNX_CONSTITUTION_SCHEMA=([0-9]+)$", text)
          return {
              "requested": source["requested"],
              "resolved": source["resolved"],
              "is_symlink": source["is_symlink"],
              "sha256": source["sha256"],
              "bytes": source["bytes"],
              "lines": source["lines"],
              "profile": source_profile(text, counts),
              "document_schema": int(document.group(1)) if document else None,
              "constitution_schema": int(constitution.group(1)) if constitution else None,
              "counts": counts,
              "commands": extract_dispatch_commands(text),
              "generated_programs": generated,
              "units": units,
              "law_ids": marker_ids(text, "LAW"),
              "flow_ids": marker_ids(text, "FLOW"),
              "policy": source_policy_summary(text),
              "machine_bindings": machine_binding_counts(text),
          }
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.read-capsule-source kind=function title="Python function read_capsule_source"
      def read_capsule_source(path: Path, max_bytes: int = CAPSULE_MAX_SOURCE_BYTES) -> dict:
          requested = str(path)
          try:
              resolved = path.resolve(strict=True)
          except OSError as exc:
              raise PlannerError(f"capsule source is unavailable: {path}: {exc}") from exc
          try:
              before = resolved.stat()
          except OSError as exc:
              raise PlannerError(f"capsule source could not be statted: {resolved}: {exc}") from exc
          if not stat.S_ISREG(before.st_mode):
              raise PlannerError(f"capsule source is not a regular file: {resolved}")
          if before.st_size > max_bytes:
              raise PlannerError(f"capsule source exceeds {max_bytes} bytes: {before.st_size}")
          try:
              with resolved.open("rb") as stream:
                  payload = stream.read(max_bytes + 1)
          except OSError as exc:
              raise PlannerError(f"capsule source could not be read: {resolved}: {exc}") from exc
          if len(payload) > max_bytes:
              raise PlannerError(f"capsule source exceeds {max_bytes} bytes while reading: {resolved}")
          after = resolved.stat()
          identity_before = (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
          identity_after = (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
          if identity_before != identity_after or len(payload) != after.st_size:
              raise PlannerError(f"capsule source changed while it was being read: {resolved}")
          mode = stat.S_IMODE(after.st_mode)
          return {
              "requested": requested,
              "resolved": str(resolved),
              "is_symlink": path.is_symlink(),
              "bytes": len(payload),
              "sha256": hashlib.sha256(payload).hexdigest(),
              "mode": f"{mode:04o}",
              "uid": after.st_uid,
              "gid": after.st_gid,
              "executable": bool(mode & 0o111),
              "payload": payload,
          }
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.capsule-media-type kind=function title="Python function capsule_media_type"
      def capsule_media_type(payload: bytes) -> tuple[str, str | None]:
          if payload.startswith(b"\x7fELF"):
              return "application/x-elf", None
          if payload.startswith(b"MZ"):
              return "application/vnd.microsoft.portable-executable", None
          if payload.startswith(b"\x1f\x8b"):
              return "application/gzip", None
          if payload.startswith(b"\xfd7zXZ\x00"):
              return "application/x-xz", None
          if payload.startswith(b"PK\x03\x04"):
              return "application/zip", None
          if payload.startswith(b"#!"):
              first = payload.splitlines()[0][:256].decode("utf-8", errors="replace")
              return "text/x-script", first
          try:
              decoded = payload.decode("utf-8")
          except UnicodeDecodeError:
              return "application/octet-stream", None
          if "\x00" in decoded:
              return "application/octet-stream", None
          return "text/plain;charset=utf-8", None
      
      
