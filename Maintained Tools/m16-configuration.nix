#@MNX-CHUNK id=40.24 slug=m21-identity-tool title="Strict m21 machine, host-key, helper, and source identity"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-m21-identity" section=40.24 role=generated-program ordinal=158
  environment.etc."monsternix/bin/mnx-m21-identity" = {
    source = pkgs.writeTextFile {
      name = "mnx-m21-identity";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      export PATH=/run/wrappers/bin:${pkgs.bash}/bin:${pkgs.coreutils}/bin:${pkgs.diffutils}/bin:${pkgs.findutils}/bin:${pkgs.gawk}/bin:${pkgs.gnugrep}/bin:${pkgs.gnused}/bin:${pkgs.openssh}/bin:${pkgs.util-linux}/bin:/run/current-system/sw/bin
      set -Eeuo pipefail
      export LC_ALL=C

      DEFAULT_HELPER_SHA256=67c62343861040656ec61923301eacdfb4261703501345890edbc6a619ba954f
      EXPECTED_HOSTNAME=comfy-m21
      EXPECTED_SOURCE_UUID=5c208c49-1b6c-411e-899c-fca29e2d5d9b
      EXPECTED_HOST_KEY_FINGERPRINT=SHA256:BfdYWZn5Qiaw5c3nzteZzKp47VQExA333A5LcgrYiHc

      #@MNX-PART id=40.24.mnx-m21-identity.function.classify-helper-origin kind=function title="Function classify_helper_origin"
      classify_helper_origin() {
        local resolved="$1"
        local observed="$2"
        local expected="$3"

        case "$resolved" in
          /nix/store/*)
            printf 'declarative-nix-store\n'
            return 0
            ;;
        esac

        if [[ "$observed" == "$expected" ]]; then
          printf 'trusted-runtime-override\n'
          return 0
        fi

        printf 'untrusted-non-store\n'
        return 1
      }

      MODE="''${1:-verify}"
      if (( $# > 0 )); then
        shift
      fi

      if [[ "$MODE" == self-test ]]; then
        [[ "$DEFAULT_HELPER_SHA256" =~ ^[0-9a-f]{64}$ ]]
        [[ "$EXPECTED_SOURCE_UUID" =~ ^[0-9a-f-]{36}$ ]]
        [[ "$(classify_helper_origin /nix/store/example-helper "$DEFAULT_HELPER_SHA256" "$DEFAULT_HELPER_SHA256")" == declarative-nix-store ]]
        [[ "$(classify_helper_origin /etc/sandworm/m21-btrfs-backup-source "$DEFAULT_HELPER_SHA256" "$DEFAULT_HELPER_SHA256")" == trusted-runtime-override ]]
        if classify_helper_origin /etc/sandworm/m21-btrfs-backup-source 8fcef29ff0c7b0fcfbc1f9eb3f4fa72607347f36f60c3ae84e2a24de42a4bd1c "$DEFAULT_HELPER_SHA256" >/dev/null; then
          echo 'self-test accepted an untrusted non-store helper' >&2
          exit 1
        fi
        endpoint_status_probe() { return 75; }
        endpoint_status=0
        if endpoint_status_probe; then
          endpoint_status=0
        else
          endpoint_status="$?"
        fi
        [[ "$endpoint_status" -eq 75 ]]
        echo 'MNX_M21_HELPER_ORIGIN_SELF_TEST=PASS'
        echo 'MNX_M21_HELPER_TRUST_SELF_TEST=PASS'
        echo 'MNX_M21_ENDPOINT_STATUS_SELF_TEST=PASS'
        exit 0
      fi

      case "$MODE" in
        verify|enroll|helper-status|helper-approve|helper-reset)
          ;;
        help|-h|--help)
          cat <<'USAGE'
      mnx m21-identity                 strictly verify configured m21 identity and active helper trust
      mnx m21-enroll                   enroll missing endpoint ED25519 keys after fingerprint verification
      mnx m21-helper status            show source-default/enrolled trust and current observed helper identity
      mnx m21-helper approve SHA256    explicitly trust the currently observed full helper hash after evidence capture
      mnx m21-helper reset             remove the active operator enrollment and return to the source-default hash
      USAGE
          exit 0
          ;;
        *)
          echo "unknown m21 identity mode: $MODE" >&2
          exit 64
          ;;
      esac

      if [[ ''${EUID:-$(id -u)} -ne 0 ]]; then
        exec /run/wrappers/bin/sudo -- "$0" "$MODE" "$@"
      fi

      STATE=/var/lib/m21-btrfs-pull-backup
      KEY="$STATE/id_ed25519"
      KNOWN="$STATE/known_hosts"
      TRUST_FILE="$STATE/trusted-helper-sha256"
      TRUST_EVIDENCE_POINTER="$STATE/trusted-helper-evidence"
      SUPPORT=/var/lib/logbook/support
      HOSTS=( 192.168.100.119 192.168.1.25 )
      SELECTED=
      OBSERVED_HELPER_SHA256=
      OBSERVED_HELPER_RESOLVED=
      OBSERVED_HELPER_OWNER=
      OBSERVED_HELPER_MODE=
      OBSERVED_HELPER_BYTES=
      OBSERVED_HELPER_ORIGIN=
      OBSERVED_HELPER_APPROVAL_ELIGIBLE=no
      OBSERVED_HELPER_MOUNT_TARGET=
      OBSERVED_HELPER_MOUNT_SOURCE=
      OBSERVED_HELPER_MOUNT_OPTIONS=
      EXPECTED_HELPER_SHA256="$DEFAULT_HELPER_SHA256"
      HELPER_TRUST_SOURCE=source-default

      install -d -m 0700 -o root -g root "$STATE"
      [[ -f "$KEY" && ! -L "$KEY" && -r "$KEY" ]] || { echo 'm21 SSH private key is missing or unsafe' >&2; exit 1; }
      [[ -f "$KNOWN" && ! -L "$KNOWN" && -r "$KNOWN" ]] || { echo 'm21 known_hosts is missing or unsafe' >&2; exit 1; }

      #@MNX-PART id=40.24.mnx-m21-identity.function.load-helper-trust kind=function title="Function load_helper_trust"
      load_helper_trust() {
        local metadata value nonblank
        EXPECTED_HELPER_SHA256="$DEFAULT_HELPER_SHA256"
        HELPER_TRUST_SOURCE=source-default
        [[ -e "$TRUST_FILE" ]] || return 0
        [[ -f "$TRUST_FILE" && ! -L "$TRUST_FILE" ]] || { echo "$TRUST_FILE must be a regular non-symlink file" >&2; return 1; }
        metadata="$(stat -Lc '%U:%G %a' "$TRUST_FILE" 2>/dev/null || true)"
        [[ "$metadata" == 'root:root 600' ]] || { echo "$TRUST_FILE has unsafe metadata: ''${metadata:-unreadable}" >&2; return 1; }
        nonblank="$(awk 'NF { count += 1; value=$0 } END { if (count == 1) print value; else exit 1 }' "$TRUST_FILE")" || {
          echo "$TRUST_FILE must contain exactly one nonblank SHA-256 line" >&2
          return 1
        }
        value="$nonblank"
        [[ "$value" =~ ^[0-9a-f]{64}$ ]] || { echo "$TRUST_FILE does not contain exactly one canonical lowercase SHA-256" >&2; return 1; }
        EXPECTED_HELPER_SHA256="$value"
        HELPER_TRUST_SOURCE=operator-enrolled
      }

      #@MNX-PART id=40.24.mnx-m21-identity.function.enroll-endpoint kind=function title="Function enroll_endpoint"
      enroll_endpoint() {
        local host="$1" scan current merged expected_lines fingerprint keyline
        scan="$(mktemp "$STATE/.m21-keyscan.XXXXXX")"
        current="$(mktemp "$STATE/.m21-current.XXXXXX")"
        merged="$(mktemp "$STATE/.m21-known-hosts.XXXXXX")"
        ssh-keyscan -T 8 -t ed25519 "$host" > "$scan" 2>/dev/null || true
        [[ -s "$scan" ]] || { rm -f "$scan" "$current" "$merged"; echo "ssh-keyscan returned no ED25519 key for $host" >&2; return 1; }

        expected_lines=0
        while IFS= read -r keyline; do
          [[ "$keyline" == \#* || -z "$keyline" ]] && continue
          fingerprint="$(printf '%s\n' "$keyline" | ssh-keygen -lf - 2>/dev/null | awk '{print $2; exit}')"
          printf 'scanned_endpoint=%s scanned_fingerprint=%s\n' "$host" "''${fingerprint:-unreadable}"
          [[ "$fingerprint" == "$EXPECTED_HOST_KEY_FINGERPRINT" ]] && expected_lines=$((expected_lines + 1))
        done < "$scan"
        [[ "$expected_lines" -gt 0 ]] || { rm -f "$scan" "$current" "$merged"; echo "scanned ED25519 key does not match the pinned fingerprint for $host" >&2; return 1; }

        ssh-keygen -F "$host" -f "$KNOWN" 2>/dev/null | awk '$1 !~ /^#/ && $2 == "ssh-ed25519" && NF >= 3 { print $2 " " $3 }' > "$current" || true
        if [[ -s "$current" ]]; then
          while IFS= read -r keyline; do
            fingerprint="$(printf '%s\n' "$keyline" | ssh-keygen -lf - 2>/dev/null | awk '{print $2; exit}')"
            [[ "$fingerprint" == "$EXPECTED_HOST_KEY_FINGERPRINT" ]] || { rm -f "$scan" "$current" "$merged"; echo "refusing to replace a mismatched enrolled ED25519 key for $host" >&2; return 1; }
          done < "$current"
          echo "endpoint_already_enrolled=$host"
          rm -f "$scan" "$current" "$merged"
          return 0
        fi

        cat "$KNOWN" > "$merged"
        while IFS= read -r keyline; do
          [[ "$keyline" == \#* || -z "$keyline" ]] && continue
          fingerprint="$(printf '%s\n' "$keyline" | ssh-keygen -lf - 2>/dev/null | awk '{print $2; exit}')"
          [[ "$fingerprint" == "$EXPECTED_HOST_KEY_FINGERPRINT" ]] && printf '%s\n' "$keyline" >> "$merged"
        done < "$scan"
        chown root:root "$merged"
        chmod 0600 "$merged"
        mv -f "$merged" "$KNOWN"
        rm -f "$scan" "$current"
        echo "endpoint_enrolled=$host"
      }

      #@MNX-PART id=40.24.mnx-m21-identity.function.verify-pinned-host-key kind=function title="Function verify_pinned_host_key"
      verify_pinned_host_key() {
        local host="$1" lines fingerprint found keyline
        lines="$(mktemp "$STATE/.m21-known-lines.XXXXXX")"
        ssh-keygen -F "$host" -f "$KNOWN" 2>/dev/null | awk '$1 !~ /^#/ && $2 == "ssh-ed25519" && NF >= 3 { print $2 " " $3 }' > "$lines" || true
        if [[ ! -s "$lines" ]]; then
          rm -f "$lines"
          echo 'known_ed25519_entry=missing'
          return 1
        fi
        echo 'known_ed25519_entry=present'
        found=0
        while IFS= read -r keyline; do
          fingerprint="$(printf '%s\n' "$keyline" | ssh-keygen -lf - 2>/dev/null | awk '{print $2; exit}')"
          printf 'known_host_fingerprint=%s\n' "''${fingerprint:-unreadable}"
          [[ "$fingerprint" == "$EXPECTED_HOST_KEY_FINGERPRINT" ]] && found=1
        done < "$lines"
        rm -f "$lines"
        [[ "$found" -eq 1 ]] || { echo "pinned ED25519 host-key fingerprint mismatch for $host" >&2; return 1; }
      }

      #@MNX-PART id=40.24.mnx-m21-identity.function.ssh-host kind=function title="Function ssh_host"
      ssh_host() {
        local host="$1"
        shift
        ssh -T -n \
          -i "$KEY" \
          -o IdentitiesOnly=yes \
          -o BatchMode=yes \
          -o StrictHostKeyChecking=yes \
          -o UserKnownHostsFile="$KNOWN" \
          -o ConnectTimeout=8 \
          -o ConnectionAttempts=1 \
          -o Compression=no \
          -o LogLevel=ERROR \
          "h0p3@$host" \
          "$@"
      }

      #@MNX-PART id=40.24.mnx-m21-identity.function.probe-identity kind=function title="Function probe_identity"
      probe_identity() {
        local host="$1" identity rc hostname_value helper_value uuid_value resolved_value owner_value mode_value bytes_value err mode_decimal
        local origin_value approval_eligible mount_target_value mount_source_value mount_options_value
        err="$(mktemp "$STATE/.m21-probe-error.XXXXXX")"
        if identity="$(ssh_host "$host" 'set -eu; helper=/etc/sandworm/m21-btrfs-backup-source; helper_sha_line="$(sha256sum -- "$helper")"; helper_sha256="''${helper_sha_line%% *}"; printf "hostname=%s\n" "$(hostname)"; printf "helper_sha256=%s\n" "$helper_sha256"; printf "source_uuid=%s\n" "$(findmnt -rn -T /home -o UUID)"; printf "helper_resolved=%s\n" "$(readlink -f -- "$helper")"; printf "helper_owner=%s\n" "$(stat -Lc "%U:%G" "$helper")"; printf "helper_mode=%s\n" "$(stat -Lc "%a" "$helper")"; printf "helper_bytes=%s\n" "$(stat -Lc "%s" "$helper")"; printf "helper_mount_target=%s\n" "$(findmnt -rn -T "$helper" -o TARGET 2>/dev/null || true)"; printf "helper_mount_source=%s\n" "$(findmnt -rn -T "$helper" -o SOURCE 2>/dev/null || true)"; printf "helper_mount_options=%s\n" "$(findmnt -rn -T "$helper" -o OPTIONS 2>/dev/null || true)"' 2>"$err")"; then
          rc=0
        else
          rc="$?"
        fi
        printf 'ssh_rc=%s\n' "$rc"
        if [[ "$rc" -ne 0 ]]; then
          cat "$err" >&2 || true
          if grep -Eqi 'REMOTE HOST IDENTIFICATION HAS CHANGED|Host key verification failed|Permission denied|Bad owner or permissions|identity file.*not accessible|no matching host key' "$err"; then
            rm -f "$err"
            return 2
          fi
          rm -f "$err"
          return 75
        fi
        rm -f "$err"
        printf '%s\n' "$identity"

        hostname_value="$(printf '%s\n' "$identity" | awk -F= '$1 == "hostname" { print $2; exit }')"
        helper_value="$(printf '%s\n' "$identity" | awk -F= '$1 == "helper_sha256" { print $2; exit }')"
        uuid_value="$(printf '%s\n' "$identity" | awk -F= '$1 == "source_uuid" { print $2; exit }')"
        resolved_value="$(printf '%s\n' "$identity" | awk -F= '$1 == "helper_resolved" { sub(/^[^=]*=/, ""); print; exit }')"
        owner_value="$(printf '%s\n' "$identity" | awk -F= '$1 == "helper_owner" { print $2; exit }')"
        mode_value="$(printf '%s\n' "$identity" | awk -F= '$1 == "helper_mode" { print $2; exit }')"
        bytes_value="$(printf '%s\n' "$identity" | awk -F= '$1 == "helper_bytes" { print $2; exit }')"
        mount_target_value="$(printf '%s\n' "$identity" | awk -F= '$1 == "helper_mount_target" { sub(/^[^=]*=/, ""); print; exit }')"
        mount_source_value="$(printf '%s\n' "$identity" | awk -F= '$1 == "helper_mount_source" { sub(/^[^=]*=/, ""); print; exit }')"
        mount_options_value="$(printf '%s\n' "$identity" | awk -F= '$1 == "helper_mount_options" { sub(/^[^=]*=/, ""); print; exit }')"

        [[ "$hostname_value" == "$EXPECTED_HOSTNAME" ]] || { echo "hostname mismatch at $host" >&2; return 2; }
        [[ "$uuid_value" == "$EXPECTED_SOURCE_UUID" ]] || { echo "source UUID mismatch at $host" >&2; return 2; }
        [[ "$helper_value" =~ ^[0-9a-f]{64}$ ]] || { echo "helper SHA-256 is malformed at $host" >&2; return 2; }
        [[ "$owner_value" == root:root ]] || { echo "helper target is not root:root at $host: $owner_value" >&2; return 2; }
        [[ "$mode_value" =~ ^[0-7]{3,4}$ ]] || { echo "helper mode is malformed at $host: $mode_value" >&2; return 2; }
        mode_decimal=$((8#$mode_value))
        (( (mode_decimal & 0022) == 0 )) || { echo "helper target is group/world writable at $host: $mode_value" >&2; return 2; }
        [[ "$bytes_value" =~ ^[0-9]+$ ]] || { echo "helper byte count is malformed at $host: $bytes_value" >&2; return 2; }
        (( bytes_value > 0 && bytes_value <= 1048576 )) || { echo "helper byte count is outside policy at $host: $bytes_value" >&2; return 2; }

        if origin_value="$(classify_helper_origin "$resolved_value" "$helper_value" "$EXPECTED_HELPER_SHA256")"; then
          rc=0
        else
          rc="$?"
        fi
        if [[ "$rc" -ne 0 ]]; then
          echo "helper resolves outside /nix/store and does not exactly match active trust at $host: resolved=$resolved_value observed=$helper_value expected=$EXPECTED_HELPER_SHA256" >&2
          return 2
        fi

        approval_eligible=no
        [[ "$origin_value" == declarative-nix-store ]] && approval_eligible=yes

        if [[ -n "$OBSERVED_HELPER_SHA256" && "$OBSERVED_HELPER_SHA256" != "$helper_value" ]]; then
          echo "reachable endpoints disagree about helper SHA-256: $OBSERVED_HELPER_SHA256 vs $helper_value" >&2
          return 2
        fi
        if [[ -n "$OBSERVED_HELPER_ORIGIN" && "$OBSERVED_HELPER_ORIGIN" != "$origin_value" ]]; then
          echo "reachable endpoints disagree about helper origin: $OBSERVED_HELPER_ORIGIN vs $origin_value" >&2
          return 2
        fi

        OBSERVED_HELPER_SHA256="$helper_value"
        OBSERVED_HELPER_RESOLVED="$resolved_value"
        OBSERVED_HELPER_OWNER="$owner_value"
        OBSERVED_HELPER_MODE="$mode_value"
        OBSERVED_HELPER_BYTES="$bytes_value"
        OBSERVED_HELPER_ORIGIN="$origin_value"
        OBSERVED_HELPER_APPROVAL_ELIGIBLE="$approval_eligible"
        OBSERVED_HELPER_MOUNT_TARGET="$mount_target_value"
        OBSERVED_HELPER_MOUNT_SOURCE="$mount_source_value"
        OBSERVED_HELPER_MOUNT_OPTIONS="$mount_options_value"
        [[ -n "$SELECTED" ]] || SELECTED="$host"

        printf 'helper_origin=%s\n' "$origin_value"
        printf 'helper_approval_eligible=%s\n' "$approval_eligible"
        if [[ "$origin_value" == trusted-runtime-override ]]; then
          echo 'helper_runtime_override=yes'
          echo 'helper_runtime_override_persistence=until-reboot-or-explicit-unmount'
        else
          echo 'helper_runtime_override=no'
        fi
        if [[ "$helper_value" == "$EXPECTED_HELPER_SHA256" ]]; then
          echo 'helper_trusted=yes'
        else
          echo 'helper_trusted=no'
        fi
        return 0
      }

      if [[ "$MODE" == enroll ]]; then
        for host in "''${HOSTS[@]}"; do
          enroll_endpoint "$host"
        done
        MODE=verify
      fi

      if [[ "$MODE" == helper-reset ]]; then
        rm -f "$TRUST_FILE" "$TRUST_EVIDENCE_POINTER"
        printf 'helper_trust_source=source-default\n'
        printf 'effective_helper_sha256=%s\n' "$DEFAULT_HELPER_SHA256"
        echo 'MNX_M21_HELPER_RESET=PASS'
        exit 0
      fi

      load_helper_trust
      printf 'expected_hostname=%s\n' "$EXPECTED_HOSTNAME"
      printf 'source_default_helper_sha256=%s\n' "$DEFAULT_HELPER_SHA256"
      printf 'helper_trust_source=%s\n' "$HELPER_TRUST_SOURCE"
      printf 'expected_helper_sha256=%s\n' "$EXPECTED_HELPER_SHA256"
      printf 'expected_source_uuid=%s\n' "$EXPECTED_SOURCE_UUID"
      printf 'expected_host_key_fingerprint=%s\n' "$EXPECTED_HOST_KEY_FINGERPRINT"

      REACHABLE=0
      UNREACHABLE=0
      IDENTITY_FAILURE=0
      HELPER_MISMATCH=0
      for host in "''${HOSTS[@]}"; do
        printf '\nendpoint=%s\n' "$host"
        verify_pinned_host_key "$host" || exit 1
        if probe_identity "$host"; then
          rc=0
        else
          rc="$?"
        fi
        case "$rc" in
          0)
            REACHABLE=$((REACHABLE + 1))
            [[ "$OBSERVED_HELPER_SHA256" == "$EXPECTED_HELPER_SHA256" ]] || HELPER_MISMATCH=1
            ;;
          75)
            UNREACHABLE=$((UNREACHABLE + 1))
            echo 'identity_status=unreachable'
            ;;
          *)
            IDENTITY_FAILURE=1
            ;;
        esac
      done

      (( IDENTITY_FAILURE == 0 )) || { echo 'm21 host-key, machine, source, or helper-file metadata identity failed' >&2; exit 1; }
      (( REACHABLE > 0 )) || { echo 'no pinned m21 endpoint is reachable' >&2; exit 75; }
      printf '\nreachable_endpoint_total=%s\n' "$REACHABLE"
      printf 'unreachable_endpoint_total=%s\n' "$UNREACHABLE"
      printf 'selected_reachable_endpoint=%s\n' "$SELECTED"
      printf 'observed_helper_sha256=%s\n' "$OBSERVED_HELPER_SHA256"
      printf 'observed_helper_resolved=%s\n' "$OBSERVED_HELPER_RESOLVED"
      printf 'observed_helper_owner=%s\n' "$OBSERVED_HELPER_OWNER"
      printf 'observed_helper_mode=%s\n' "$OBSERVED_HELPER_MODE"
      printf 'observed_helper_bytes=%s\n' "$OBSERVED_HELPER_BYTES"
      printf 'observed_helper_origin=%s\n' "$OBSERVED_HELPER_ORIGIN"
      printf 'observed_helper_approval_eligible=%s\n' "$OBSERVED_HELPER_APPROVAL_ELIGIBLE"
      printf 'observed_helper_mount_target=%s\n' "$OBSERVED_HELPER_MOUNT_TARGET"
      printf 'observed_helper_mount_source=%s\n' "$OBSERVED_HELPER_MOUNT_SOURCE"
      printf 'observed_helper_mount_options=%s\n' "$OBSERVED_HELPER_MOUNT_OPTIONS"

      if [[ "$MODE" == helper-status ]]; then
        if (( HELPER_MISMATCH == 0 )); then
          if [[ "$OBSERVED_HELPER_ORIGIN" == trusted-runtime-override ]]; then
            echo 'helper_status_detail=trusted-runtime-override'
          else
            echo 'helper_status_detail=declarative-nix-store'
          fi
          echo 'MNX_M21_HELPER_STATUS=PASS'
        else
          echo "helper_approval_command=mnx m21-helper approve $OBSERVED_HELPER_SHA256"
          echo 'MNX_M21_HELPER_STATUS=REVIEW_REQUIRED'
        fi
        exit 0
      fi

      if [[ "$MODE" == helper-approve ]]; then
        APPROVE_SHA="''${1:-}"
        [[ "$APPROVE_SHA" =~ ^[0-9a-f]{64}$ ]] || { echo 'approval requires the complete observed canonical lowercase SHA-256' >&2; exit 64; }
        [[ "$OBSERVED_HELPER_APPROVAL_ELIGIBLE" == yes ]] || {
          echo "approval is forbidden for helper origin $OBSERVED_HELPER_ORIGIN; restore a declarative /nix/store helper before enrollment" >&2
          exit 1
        }
        [[ "$APPROVE_SHA" == "$OBSERVED_HELPER_SHA256" ]] || {
          echo "approval hash does not match the currently observed helper: approve=$APPROVE_SHA observed=$OBSERVED_HELPER_SHA256" >&2
          exit 1
        }

        SOURCE_TMP="$(mktemp "$STATE/.m21-helper-source.XXXXXX")"
        TRUST_TMP="$(mktemp "$STATE/.trusted-helper-sha256.XXXXXX")"
        POINTER_TMP="$(mktemp "$STATE/.trusted-helper-evidence.XXXXXX")"
        trap 'rm -f "$SOURCE_TMP" "$TRUST_TMP" "$POINTER_TMP"' EXIT
        ssh_host "$SELECTED" 'cat -- /etc/sandworm/m21-btrfs-backup-source' > "$SOURCE_TMP"
        [[ "$(sha256sum "$SOURCE_TMP" | awk '{print $1}')" == "$APPROVE_SHA" ]] || { echo 'captured helper source hash changed during enrollment' >&2; exit 1; }
        [[ "$(stat -c '%s' "$SOURCE_TMP")" -le 1048576 ]] || { echo 'captured helper source exceeds the one-MiB enrollment ceiling' >&2; exit 1; }
        bash -n "$SOURCE_TMP" || { echo 'captured helper source failed Bash syntax validation' >&2; exit 1; }

        install -d -m 2750 -o root -g logbook "$SUPPORT"
        STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
        EVIDENCE="$SUPPORT/m21-helper-enrollment-$STAMP-$APPROVE_SHA.sh"
        METADATA="$SUPPORT/m21-helper-enrollment-$STAMP-$APPROVE_SHA.txt"
        install -o root -g logbook -m 0640 "$SOURCE_TMP" "$EVIDENCE"
        {
          printf 'timestamp=%s\n' "$(date -Is)"
          printf 'selected_endpoint=%s\n' "$SELECTED"
          printf 'hostname=%s\n' "$EXPECTED_HOSTNAME"
          printf 'source_uuid=%s\n' "$EXPECTED_SOURCE_UUID"
          printf 'host_key_fingerprint=%s\n' "$EXPECTED_HOST_KEY_FINGERPRINT"
          printf 'helper_sha256=%s\n' "$APPROVE_SHA"
          printf 'helper_resolved=%s\n' "$OBSERVED_HELPER_RESOLVED"
          printf 'helper_owner=%s\n' "$OBSERVED_HELPER_OWNER"
          printf 'helper_mode=%s\n' "$OBSERVED_HELPER_MODE"
          printf 'helper_bytes=%s\n' "$OBSERVED_HELPER_BYTES"
          printf 'helper_source_evidence=%s\n' "$EVIDENCE"
          printf 'approval_scope=exact-current-helper-sha256-only\n'
          printf 'helper_commands_executed=no\n'
          printf 'backup_filesystems_written=no\n'
          printf 'old_storage_written=no\n'
        } > "$METADATA"
        chown root:logbook "$METADATA"
        chmod 0640 "$METADATA"

        printf '%s\n' "$APPROVE_SHA" > "$TRUST_TMP"
        chown root:root "$TRUST_TMP"
        chmod 0600 "$TRUST_TMP"
        mv -f "$TRUST_TMP" "$TRUST_FILE"
        printf '%s\n' "$METADATA" > "$POINTER_TMP"
        chown root:root "$POINTER_TMP"
        chmod 0600 "$POINTER_TMP"
        mv -f "$POINTER_TMP" "$TRUST_EVIDENCE_POINTER"
        rm -f "$STATE/last-helper-mismatch"
        trap - EXIT
        rm -f "$SOURCE_TMP"

        printf 'helper_trust_source=operator-enrolled\n'
        printf 'effective_helper_sha256=%s\n' "$APPROVE_SHA"
        printf 'helper_source_evidence=%s\n' "$EVIDENCE"
        printf 'helper_metadata_evidence=%s\n' "$METADATA"
        printf 'helper_commands_executed=no\n'
        printf 'backup_filesystems_written=no\n'
        printf 'old_storage_written=no\n'
        echo 'MNX_M21_HELPER_APPROVAL=PASS'
        exit 0
      fi

      if (( HELPER_MISMATCH != 0 )); then
        printf 'helper_approval_command=mnx m21-helper approve %s\n' "$OBSERVED_HELPER_SHA256" >&2
        echo 'MNX_M21_IDENTITY=HELPER_REVIEW_REQUIRED' >&2
        exit 1
      fi

      echo 'MNX_M21_IDENTITY=PASS'
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            self_test="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err" "$self_test"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            ${pkgs.bash}/bin/bash "$out" self-test | ${pkgs.coreutils}/bin/tee "$self_test"
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_M21_HELPER_ORIGIN_SELF_TEST=PASS' "$self_test"
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_M21_HELPER_TRUST_SELF_TEST=PASS' "$self_test"
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_M21_ENDPOINT_STATUS_SELF_TEST=PASS' "$self_test"
            ;;
          *) exit 1 ;;
        esac
      '';
    };
  };


  #########################################################################
  # Candidate-source renderer and generated-program syntax gate
  #########################################################################

#@MNX-CHUNK id=40.25 slug=rendered-source-audit title="Rendered generated-program and systemd shell audit"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-source-program-audit" section=40.25 role=generated-program ordinal=159
  environment.etc."monsternix/bin/mnx-source-program-audit" = {
    source = pkgs.writeTextFile {
      name = "mnx-source-program-audit";
      executable = true;
      text = ''
      #!${pkgs.python3}/bin/python3
      from __future__ import annotations

      import argparse
      import hashlib
      import os
      import pathlib
      import re
      import subprocess
      import sys
      import tempfile

      DECLARATION = re.compile(r'^\s*environment[.]etc[.]"monsternix/bin/(?P<name>[^"]+)"\s*=\s*\{\s*$')
      TEXT_START = re.compile(r'^(?P<indent>\s*)text\s*=\s*' + re.escape(chr(39) * 2) + r'\s*$')
      SHELL_START = re.compile(r'^(?P<indent>\s*)(?P<key>script|preStart|postStart|preStop|postStop)\s*=\s*' + re.escape(chr(39) * 2) + r'\s*$')
      SERVICE_DECLARATION = re.compile(r'^(?P<indent>\s*)systemd[.]services[.](?P<name>"[^"]+"|[A-Za-z0-9_.@-]+)\s*=\s*(?:lib[.]mkForce\s+)?\{\s*$')
      ACTIVATION_DECLARATION = re.compile(r'^(?P<indent>\s*)system[.]activationScripts[.](?P<name>[A-Za-z0-9_.@-]+)\s*=\s*(?:lib[.]mkForce\s+)?\{\s*$')
      PY_HEREDOC = re.compile(r"<<(?P<dash>-?)[ \t]*[\"']?(?P<tag>PY[A-Za-z0-9_]*)[\"']?")
      INDENTED_DOLLAR = chr(39) * 2 + "$" + "{"
      NIX_DOLLAR = "$" + "{"


      #@MNX-PART id=40.25.mnx-source-program-audit.class.auditerror kind=class title="Python class AuditError"
      class AuditError(RuntimeError):
          pass


      #@MNX-PART id=40.25.mnx-source-program-audit.function.nix_dedent kind=function title="Python function nix_dedent"
      def nix_dedent(lines: list[str]) -> str:
          candidates = []
          for line in lines:
              if line.strip():
                  candidates.append(len(line) - len(line.lstrip(" ")))
          amount = min(candidates) if candidates else 0
          rendered = "".join(line[amount:] if line.strip() else line for line in lines)
          first = rendered.splitlines()[0] if rendered.splitlines() else ""
          portable_prefix = "#!" + "/nix/store/mnx-nix-interpolation/bin/"
          if first.startswith(portable_prefix):
              raise AuditError("literal portable Nix-interpolation shebang is forbidden in authoritative source")
          token = "__MNX_" + "ESCAPED_SHELL_INTERPOLATION__"
          rendered = rendered.replace(INDENTED_DOLLAR, token)
          # Remaining interpolation belongs to Nix. Exact store paths do not matter for syntax.
          rendered = re.sub(r'\$\{[^{}\n]+\}', "/nix/store/mnx-nix-interpolation", rendered)
          rendered = rendered.replace(token, NIX_DOLLAR)
          rendered = rendered.replace(chr(39) * 3, chr(39) * 2)
          return rendered


      #@MNX-PART id=40.25.mnx-source-program-audit.function.extract kind=function title="Python function extract"
      def extract(path: pathlib.Path) -> list[tuple[str, str]]:
          lines = path.read_text(encoding="utf-8").splitlines(keepends=True)
          programs: list[tuple[str, str]] = []
          seen: set[str] = set()
          index = 0
          while index < len(lines):
              declaration = DECLARATION.match(lines[index].rstrip("\n"))
              if not declaration:
                  index += 1
                  continue
              name = declaration.group("name")
              if name in seen:
                  raise AuditError(f"duplicate generated-program declaration: {name}")
              seen.add(name)
              start = None
              close_indent = None
              probe = index + 1
              while probe < len(lines):
                  match = TEXT_START.match(lines[probe].rstrip("\n"))
                  if match:
                      start = probe + 1
                      close_indent = match.group("indent")
                      break
                  if re.match(r'^\s*environment[.]etc[.]"monsternix/bin/', lines[probe]):
                      break
                  probe += 1
              if start is None or close_indent is None:
                  raise AuditError(f"generated program lacks an embedded text string: {name}")
              close_line = close_indent + chr(39) * 2 + ";"
              end = start
              while end < len(lines) and lines[end].rstrip("\n") != close_line:
                  end += 1
              if end >= len(lines):
                  raise AuditError(f"generated program text is unterminated: {name}")
              body = lines[start:end]
              required_indent = len(close_indent)
              for line_number, body_line in enumerate(body, start=start + 1):
                  if body_line.strip() and len(body_line) - len(body_line.lstrip(" ")) < required_indent:
                      raise AuditError(f"{name}: source line {line_number} escapes the Nix indented-string margin")
              rendered = nix_dedent(body)
              programs.append((name, rendered))
              index = end + 1
          if not programs:
              raise AuditError("no generated Monsternix programs were extracted")
          return programs


      #@MNX-PART id=40.25.mnx-source-program-audit.function.compile_python_heredocs kind=function title="Python function compile_python_heredocs"
      def compile_python_heredocs(name: str, source: str) -> None:
          lines = source.splitlines()
          index = 0
          while index < len(lines):
              match = PY_HEREDOC.search(lines[index])
              if not match:
                  index += 1
                  continue
              tag = match.group("tag")
              strip_tabs = match.group("dash") == "-"
              body: list[str] = []
              index += 1
              while index < len(lines):
                  candidate = lines[index].lstrip("\t") if strip_tabs else lines[index]
                  if candidate == tag:
                      break
                  body.append(candidate if strip_tabs else lines[index])
                  index += 1
              if index >= len(lines):
                  raise AuditError(f"{name}: unterminated Python heredoc {tag}")
              python_source = "\n".join(body) + "\n"
              try:
                  compile(python_source, f"{name}:{tag}", "exec")
              except SyntaxError as exc:
                  raise AuditError(f"{name}: invalid Python heredoc {tag}: {exc}") from exc
              index += 1


      #@MNX-PART id=40.25.mnx-source-program-audit.function.check_program kind=function title="Python function check_program"
      def check_program(name: str, source: str) -> None:
          first = source.splitlines()[0] if source.splitlines() else ""
          digest = hashlib.sha256(source.encode("utf-8")).hexdigest()
          if not first.startswith("#!"):
              raise AuditError(f"{name}: shebang is not at byte zero: {first!r}")
          if "bash" in first:
              completed = subprocess.run(["${pkgs.bash}/bin/bash", "-n"], input=source, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
              if completed.returncode != 0 or completed.stderr:
                  raise AuditError(f"{name}: bash -n rejected rendered source: {completed.stderr.strip()}")
              compile_python_heredocs(name, source)
              interpreter = "bash"
          elif "python" in first:
              try:
                  compile(source, name, "exec")
              except SyntaxError as exc:
                  raise AuditError(f"{name}: Python compile failed: {exc}") from exc
              interpreter = "python"
          else:
              raise AuditError(f"{name}: unsupported shebang: {first}")
          print(f"program={name} interpreter={interpreter} bytes={len(source.encode('utf-8'))} sha256={digest}")


      #@MNX-PART id=40.25.mnx-source-program-audit.function.attrset_end kind=function title="Python function attrset_end"
      def attrset_end(lines: list[str], start: int, indent: str, label: str) -> int:
          closing = indent + "};"
          for index in range(start + 1, len(lines)):
              if lines[index].rstrip("\n") == closing:
                  return index
          raise AuditError(f"unterminated Nix attribute set for {label} at source line {start + 1}")


      #@MNX-PART id=40.25.mnx-source-program-audit.function.indented_string kind=function title="Python function indented_string"
      def indented_string(lines: list[str], start: int, indent: str, label: str) -> tuple[str, int]:
          close_pattern = re.compile(r'^\s*' + re.escape(chr(39) * 2) + r';\s*$')
          end = start + 1
          while end < len(lines) and not close_pattern.match(lines[end].rstrip("\n")):
              end += 1
          if end >= len(lines):
              raise AuditError(f"unterminated Nix shell string for {label} at source line {start + 1}")
          body = lines[start + 1:end]
          # Nix indented strings strip the minimum indentation of their content;
          # service scripts in this historical monolith intentionally use mixed
          # source indentation. Validate the rendered shell, not cosmetic columns.
          return nix_dedent(body), end


      #@MNX-PART id=40.25.mnx-source-program-audit.function.extract_shell_blocks kind=function title="Python function extract_shell_blocks"
      def extract_shell_blocks(path: pathlib.Path) -> list[tuple[str, str, int]]:
          lines = path.read_text(encoding="utf-8").splitlines(keepends=True)
          blocks: list[tuple[str, str, int]] = []

          for start, line in enumerate(lines):
              declaration = SERVICE_DECLARATION.match(line.rstrip("\n"))
              if not declaration:
                  continue
              service_name = declaration.group("name").strip(chr(34))
              end = attrset_end(lines, start, declaration.group("indent"), f"systemd service {service_name}")
              index = start + 1
              while index < end:
                  match = SHELL_START.match(lines[index].rstrip("\n"))
                  if not match:
                      index += 1
                      continue
                  label = f"systemd.services.{service_name}.{match.group('key')}"
                  source, string_end = indented_string(lines, index, match.group("indent"), label)
                  if string_end > end:
                      raise AuditError(f"{label}: shell string extends beyond its service attribute set")
                  blocks.append((label, source, index + 1))
                  index = string_end + 1

          for start, line in enumerate(lines):
              declaration = ACTIVATION_DECLARATION.match(line.rstrip("\n"))
              if not declaration:
                  continue
              activation_name = declaration.group("name")
              end = attrset_end(lines, start, declaration.group("indent"), f"activation script {activation_name}")
              text_start = None
              text_match = None
              for index in range(start + 1, end):
                  match = TEXT_START.match(lines[index].rstrip("\n"))
                  if match:
                      text_start = index
                      text_match = match
                      break
              if text_start is None or text_match is None:
                  raise AuditError(f"activation script {activation_name} lacks a text indented string")
              label = f"system.activationScripts.{activation_name}.text"
              source, string_end = indented_string(lines, text_start, text_match.group("indent"), label)
              if string_end > end:
                  raise AuditError(f"{label}: shell string extends beyond its activation attribute set")
              blocks.append((label, source, text_start + 1))

          if not blocks:
              raise AuditError("no NixOS service or activation shell blocks were extracted")
          return blocks


      #@MNX-PART id=40.25.mnx-source-program-audit.function.check_shell_block kind=function title="Python function check_shell_block"
      def check_shell_block(label: str, source: str, line_number: int) -> None:
          completed = subprocess.run(["${pkgs.bash}/bin/bash", "-n"], input=source, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
          if completed.returncode != 0 or completed.stderr:
              raise AuditError(f"{label} (source line {line_number}): bash -n rejected rendered shell: {completed.stderr.strip()}")
          compile_python_heredocs(label, source)
          digest = hashlib.sha256(source.encode("utf-8")).hexdigest()
          print(f"shell_block={label} source_line={line_number} bytes={len(source.encode('utf-8'))} sha256={digest}")


      #@MNX-PART id=40.25.mnx-source-program-audit.function.resolve_configuration kind=function title="Python function resolve_configuration"
      def resolve_configuration(mode: str, raw_path: str) -> pathlib.Path:
          original = pathlib.Path(raw_path)
          if mode == "source":
              if not original.is_file() or original.is_symlink():
                  raise AuditError(f"editable source must be a regular non-symlink file: {original}")
              if not os.access(original, os.R_OK):
                  raise AuditError(f"editable source is not readable: {original}")
              return original
          if mode == "closure":
              try:
                  resolved = original.resolve(strict=True)
              except (FileNotFoundError, RuntimeError, OSError) as exc:
                  raise AuditError(f"could not resolve closure configuration: {original}: {exc}") from exc
              if not resolved.is_file() or not os.access(resolved, os.R_OK):
                  raise AuditError(f"closure configuration target is not a readable regular file: {resolved}")
              try:
                  resolved.relative_to(pathlib.Path("/nix/store"))
              except ValueError as exc:
                  raise AuditError(f"closure configuration resolves outside /nix/store: {resolved}") from exc
              return resolved
          raise AuditError(f"unknown audit mode: {mode}")


      #@MNX-PART id=40.25.mnx-source-program-audit.function.expect_audit_error kind=function title="Python function expect_audit_error"
      def expect_audit_error(label: str, operation) -> None:
          try:
              operation()
          except AuditError:
              return
          raise AuditError(f"self-test expected rejection: {label}")


      #@MNX-PART id=40.25.mnx-source-program-audit.function.self_test_path_policy kind=function title="Python function self_test_path_policy"
      def self_test_path_policy() -> int:
          with tempfile.TemporaryDirectory(prefix="mnx-source-program-audit-") as temporary:
              root = pathlib.Path(temporary)
              editable = root / "configuration.nix"
              editable.write_text("{ }\n", encoding="utf-8")
              editable_link = root / "editable-link.nix"
              editable_link.symlink_to(editable)
              outside_closure_link = root / "outside-closure-link.nix"
              outside_closure_link.symlink_to(editable)
              store_target = pathlib.Path(__file__).resolve(strict=True)
              store_link = root / "closure-link.nix"
              store_link.symlink_to(store_target)

              if resolve_configuration("source", str(editable)) != editable:
                  raise AuditError("self-test source mode did not preserve the regular editable path")
              expect_audit_error("source mode symlink", lambda: resolve_configuration("source", str(editable_link)))
              if resolve_configuration("closure", str(store_link)) != store_target:
                  raise AuditError("self-test closure mode did not resolve the /nix/store target")
              expect_audit_error("closure target outside /nix/store", lambda: resolve_configuration("closure", str(outside_closure_link)))

              bad_shebang = "#!" + "/nix/store/mnx-nix-interpolation/bin/python3\n"
              expect_audit_error(
                  "literal portable interpolation shebang",
                  lambda: nix_dedent([bad_shebang, "print('never authoritative')\n"]),
              )

              shell_source = ["#!/bin/bash\n", "value=" + INDENTED_DOLLAR + "2:-1}\n"]
              rendered_shell = nix_dedent(shell_source)
              if NIX_DOLLAR + "2:-1}" not in rendered_shell:
                  raise AuditError("self-test shell parameter interpolation was rewritten as Nix")

          print("MNX_SOURCE_PROGRAM_AUDIT_PATH_POLICY_SELF_TEST=PASS")
          print("MNX_SOURCE_PROGRAM_AUDIT_INTERPRETER_POLICY_SELF_TEST=PASS")
          print("MNX_SOURCE_PROGRAM_AUDIT_SHELL_INTERPOLATION_SELF_TEST=PASS")
          return 0


      #@MNX-PART id=40.25.mnx-source-program-audit.function.main kind=function title="Python function main"
      def main() -> int:
          parser = argparse.ArgumentParser(prog="mnx-source-program-audit")
          parser.add_argument("arguments", nargs="*")
          parser.add_argument("--extract-dir")
          parser.add_argument("--self-test", action="store_true")
          args = parser.parse_args()

          if args.self_test:
              if args.arguments or args.extract_dir:
                  raise AuditError("--self-test does not accept a configuration or --extract-dir")
              return self_test_path_policy()

          mode = "source"
          raw_path = "/etc/nixos/configuration.nix"
          if args.arguments:
              if args.arguments[0] in {"source", "closure"}:
                  mode = args.arguments[0]
                  if len(args.arguments) > 2:
                      raise AuditError("too many positional arguments")
                  if len(args.arguments) == 2:
                      raw_path = args.arguments[1]
              else:
                  # Backward-compatible legacy spelling: a lone path means source mode.
                  if len(args.arguments) != 1:
                      raise AuditError("too many positional arguments")
                  raw_path = args.arguments[0]

          path = resolve_configuration(mode, raw_path)
          print(f"audit_mode={mode}")
          print(f"configuration_input={raw_path}")
          print(f"configuration_input_is_symlink={'yes' if pathlib.Path(raw_path).is_symlink() else 'no'}")
          print(f"configuration_resolved={path}")

          programs = extract(path)
          shell_blocks = extract_shell_blocks(path)
          if args.extract_dir:
              output = pathlib.Path(args.extract_dir)
              output.mkdir(parents=True, exist_ok=False)
          else:
              output = None
          for name, source in programs:
              check_program(name, source)
              if output is not None:
                  target = output / name
                  target.write_text(source, encoding="utf-8")
                  target.chmod(0o700)
          for label, source, line_number in shell_blocks:
              check_shell_block(label, source, line_number)
          print(f"generated_program_source_count={len(programs)}")
          print(f"nixos_shell_block_source_count={len(shell_blocks)}")
          print("MNX_SOURCE_PROGRAM_AUDIT=PASS")
          return 0


      if __name__ == "__main__":
          try:
              raise SystemExit(main())
          except AuditError as exc:
              print(f"MNX_SOURCE_PROGRAM_AUDIT_ERROR: {exc}", file=sys.stderr)
              raise SystemExit(1)
      '';
      checkPhase = ''
        set -Eeuo pipefail
        ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
        self_test_output="$TMPDIR/mnx-source-program-audit-self-test.txt"
        ${pkgs.python3}/bin/python3 "$out" --self-test | ${pkgs.coreutils}/bin/tee "$self_test_output"
        ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_SOURCE_PROGRAM_AUDIT_PATH_POLICY_SELF_TEST=PASS' "$self_test_output"
        ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_SOURCE_PROGRAM_AUDIT_INTERPRETER_POLICY_SELF_TEST=PASS' "$self_test_output"
      '';
    };
  };


  # Prometheus textfile + structured journal helper for independent oneshot jobs.
  # Every invocation also writes a tiny, paste-friendly last-run record beneath
  # /var/lib/monsternix/job-state. Successful data jobs separately call
  # mnx-job-success so freshness is based on completed work, not timer activity.
#@MNX-CHUNK id=40.26 slug=job-state-metrics title="Authoritative job state, success markers, and current metrics"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-job-metric" section=40.26 role=generated-program ordinal=160
  environment.etc."monsternix/bin/mnx-job-metric" = {
    source = pkgs.writeTextFile {
      name = "mnx-job-metric";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      export PATH=${pkgs.coreutils}/bin:${pkgs.gnused}/bin:${pkgs.util-linux}/bin:${pkgs.systemd}/bin
      set -uo pipefail
      export LC_ALL=C

      name="''${1:-unknown}"
      exit_code="''${2:-0}"
      duration="''${3:-0}"
      skipped="''${4:-0}"
      reason="''${5:-none}"

      safe_name="$(printf '%s' "$name" | sed -E 's/[^A-Za-z0-9_.-]+/_/g')"
      safe_reason="$(printf '%s' "$reason" | sed -E 's/[^A-Za-z0-9_.:-]+/_/g')"
      now="$(date +%s)"
      timestamp="$(date -Is)"
      success=0
      priority=5

      case "$safe_name" in
        *.service)
          logger -t mnx-job-metric -p daemon.warning -- \
            "refusing current logical-job metric with systemd unit name: $safe_name" || true
          exit 0
          ;;
      esac

      if [[ "$exit_code" == 0 && "$skipped" == 0 ]]; then
        success=1
      elif [[ "$exit_code" == 75 && "$skipped" == 1 && "$safe_reason" == manager-stop-retryable ]]; then
        # Preserve the real process exit while keeping an explicitly retryable,
        # operator-requested mirror interruption out of warning/error intake.
        priority=5
      elif [[ "$exit_code" != 0 ]]; then
        priority=3
      fi

      metric_dir=/var/lib/node-exporter-textfile
      metric_tmp="$metric_dir/monsternix_job_current_$safe_name.prom.$$"
      metric_out="$metric_dir/monsternix_job_current_$safe_name.prom"
      legacy_metric="$metric_dir/monsternix_job_$safe_name.prom"
      state_root=/var/lib/monsternix/job-state
      if [[ ''${EUID:-$(id -u)} -eq 0 ]]; then
        state_dir="$state_root/authoritative"
      else
        state_dir="$state_root/telemetry"
      fi
      state_tmp="$state_dir/$safe_name.last-run.$$"
      state_out="$state_dir/$safe_name.last-run"

      mkdir -p "$state_dir" || exit 0

      # Active node_exporter textfiles are root-authoritative. User jobs keep
      # telemetry and journal evidence but cannot publish scrapeable current state.
      if [[ ''${EUID:-$(id -u)} -eq 0 ]]; then
        mkdir -p "$metric_dir" || exit 0
        cat > "$metric_tmp" <<EOF_METRIC
      # HELP monsternix_job_last_run_timestamp_seconds Last observed run timestamp for a current Monsternix logical job.
      # TYPE monsternix_job_last_run_timestamp_seconds gauge
      monsternix_job_last_run_timestamp_seconds{name="$safe_name",reason="$safe_reason"} $now
      # HELP monsternix_job_last_exit_code Last observed exit code for a current Monsternix logical job.
      # TYPE monsternix_job_last_exit_code gauge
      monsternix_job_last_exit_code{name="$safe_name",reason="$safe_reason"} $exit_code
      # HELP monsternix_job_last_duration_seconds Last observed runtime for a current Monsternix logical job.
      # TYPE monsternix_job_last_duration_seconds gauge
      monsternix_job_last_duration_seconds{name="$safe_name",reason="$safe_reason"} $duration
      # HELP monsternix_job_last_success Last observed run completed successfully and was not skipped.
      # TYPE monsternix_job_last_success gauge
      monsternix_job_last_success{name="$safe_name",reason="$safe_reason"} $success
      # HELP monsternix_job_last_skipped Last observed run intentionally skipped work.
      # TYPE monsternix_job_last_skipped gauge
      monsternix_job_last_skipped{name="$safe_name",reason="$safe_reason"} $skipped
      EOF_METRIC
        chmod 0644 "$metric_tmp" 2>/dev/null || true
        mv -f "$metric_tmp" "$metric_out" || true
        chown root:root "$metric_out" 2>/dev/null || true
        chmod 0644 "$metric_out" 2>/dev/null || true
        rm -f "$legacy_metric" 2>/dev/null || true
      fi

      cat > "$state_tmp" <<EOF_STATE
      name=$safe_name
      timestamp=$timestamp
      epoch=$now
      exit_code=$exit_code
      duration_seconds=$duration
      skipped=$skipped
      reason=$safe_reason
      success=$success
      boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)
      system=$(readlink -f /run/current-system 2>/dev/null || true)
      EOF_STATE

      if [[ ''${EUID:-$(id -u)} -eq 0 ]]; then
        chown root:logbook "$state_tmp" 2>/dev/null || true
      fi
      chmod 0640 "$state_tmp" 2>/dev/null || true
      mv -f "$state_tmp" "$state_out" || true
      if [[ ''${EUID:-$(id -u)} -eq 0 ]]; then
        chown root:logbook "$state_out" 2>/dev/null || true
      fi
      chmod 0640 "$state_out" 2>/dev/null || true

      logger --journald <<EOF_JOURNAL || true
      MESSAGE_ID=c7dd62d9-727e-5ebd-9c2f-99600feeb1cf
      PRIORITY=$priority
      LOGBOOK_KIND=MNX_JOB_RESULT
      LOGBOOK_VER=4
      MNX_JOB_NAME=$safe_name
      MNX_JOB_EXIT_CODE=$exit_code
      MNX_JOB_DURATION_SECONDS=$duration
      MNX_JOB_SKIPPED=$skipped
      MNX_JOB_REASON=$safe_reason
      MNX_JOB_SUCCESS=$success
      MESSAGE=Monsternix job result: name=$safe_name exit=$exit_code skipped=$skipped reason=$safe_reason duration=''${duration}s
      EOF_JOURNAL

      printf '%s\n' \
        "job=$safe_name exit=$exit_code skipped=$skipped reason=$safe_reason duration=''${duration}s success=$success" |
        systemd-cat --namespace=logbook -t mnx-job-result -p "$priority" >/dev/null 2>&1 || true

      exit 0
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            ;;
          '#!'*python*)
            ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
            ;;
          *)
            echo "unsupported generated-script interpreter: $first" >&2
            exit 1
            ;;
        esac
      '';
    };
  };

  # Durable success marker for freshness-based catch-up. The result/detail fields
  # are deliberately line-oriented so a future support script can simply `cat`
  # every marker without needing a database or a JSON parser.
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-job-success" section=40.26 role=generated-program ordinal=161
  environment.etc."monsternix/bin/mnx-job-success" = {
    source = pkgs.writeTextFile {
      name = "mnx-job-success";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      set -euo pipefail

      if [ "$EUID" -ne 0 ]; then
        printf '%s\n' "mnx-job-success is an internal root-only helper" >&2
        exit 77
      fi

      name="''${1:-unknown}"
      result="''${2:-none}"
      detail="''${3:-none}"
      safe_name="$(printf '%s' "$name" | ${pkgs.gnused}/bin/sed -E 's/[^A-Za-z0-9_.-]+/_/g')"
      safe_result="$(printf '%s' "$result" | ${pkgs.coreutils}/bin/tr '\n\r\t' '   ')"
      safe_detail="$(printf '%s' "$detail" | ${pkgs.coreutils}/bin/tr '\n\r\t' '   ')"
      dir=/var/lib/monsternix/job-state/authoritative
      tmp="$dir/$safe_name.last-success.$$"
      out="$dir/$safe_name.last-success"
      epoch="$(${pkgs.coreutils}/bin/date +%s)"
      timestamp="$(${pkgs.coreutils}/bin/date -Is)"

      ${pkgs.coreutils}/bin/mkdir -p "$dir"
      cat > "$tmp" <<EOF
      name=$safe_name
      timestamp=$timestamp
      epoch=$epoch
      result=$safe_result
      detail=$safe_detail
      boot_id=$(${pkgs.coreutils}/bin/cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)
      system=$(${pkgs.coreutils}/bin/readlink -f /run/current-system 2>/dev/null || true)
      EOF
      ${pkgs.coreutils}/bin/chown root:logbook "$tmp"
      ${pkgs.coreutils}/bin/chmod 0640 "$tmp"
      ${pkgs.coreutils}/bin/mv -f "$tmp" "$out"
      ${pkgs.coreutils}/bin/chown root:logbook "$out"
      ${pkgs.coreutils}/bin/chmod 0640 "$out"

      ${pkgs.util-linux}/bin/logger --journald <<EOF || true
      MESSAGE_ID=529911d7-9386-58f7-9ba0-3a33de86f8c4
      PRIORITY=5
      LOGBOOK_KIND=MNX_JOB_SUCCESS
      LOGBOOK_VER=1
      MNX_JOB_NAME=$safe_name
      MNX_JOB_RESULT=$safe_result
      MNX_JOB_DETAIL=$safe_detail
      MNX_JOB_SUCCESS_EPOCH=$epoch
      BUNDLE_PATH=$out
      MESSAGE=Monsternix job success: $safe_name result=$safe_result
      EOF
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            ;;
          '#!'*python*)
            ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
            ;;
          *)
            echo "unsupported generated-script interpreter: $first" >&2
            exit 1
            ;;
        esac
      '';
    };
  };


