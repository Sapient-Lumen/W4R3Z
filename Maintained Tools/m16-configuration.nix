#@MNX-PART id=90.00.monsterdesk.function.f023r5-readiness-log kind=function title="Python function nicotine_readiness_log_evidence"
def nicotine_readiness_log_evidence(log_path: Any) -> dict[str, Any]:
    path = Path(str(log_path)) if log_path else None
    tail = bounded_log_tail(path)
    payload = tail.encode("utf-8", errors="replace")
    lines = [line.strip().casefold() for line in tail.splitlines()]
    port_text = str(EXPECTED_NICOTINE_PORT)
    server_port_text = str(EXPECTED_NICOTINE_SERVER[1])

    #@MNX-PART id=90.00.monsterdesk.function.f023r5-count-lines kind=function title="Python function count_lines"
    def count_lines(predicate: Any) -> int:
        return sum(1 for line in lines if predicate(line))

    listen_success_count = count_lines(lambda line: f"listening on port: {port_text}" in line)
    listen_failure_count = count_lines(lambda line: f"cannot listen on port {port_text}" in line)
    server_connect_attempt_count = count_lines(
        lambda line: "connecting to " in line and f":{server_port_text}" in line
    )
    server_connected_count = count_lines(
        lambda line: "connected to server " in line and f":{server_port_text}, logging in" in line
    )
    server_connect_failure_count = count_lines(
        lambda line: "cannot connect to server " in line and f":{server_port_text}:" in line
    )
    name_resolution_failure_count = count_lines(lambda line: any(token in line for token in (
        "name or service not known", "temporary failure in name resolution",
        "no address associated", "nodename nor servname provided", "getaddrinfo failed",
    )))
    address_in_use_count = count_lines(lambda line: "address already in use" in line)
    cannot_assign_address_count = count_lines(lambda line: "cannot assign requested address" in line)
    network_unreachable_count = count_lines(lambda line: "network is unreachable" in line)
    connection_refused_count = count_lines(lambda line: "connection refused" in line)
    timed_out_count = count_lines(lambda line: "timed out" in line or "timeout" in line)
    lowered = tail.casefold()
    return {
        "state": "available" if tail else "empty",
        "bytes": len(payload),
        "sha256": hashlib.sha256(payload).hexdigest(),
        "listen_success_count": listen_success_count,
        "listen_failure_count": listen_failure_count,
        "server_connect_attempt_count": server_connect_attempt_count,
        "server_connected_count": server_connected_count,
        "server_connect_failure_count": server_connect_failure_count,
        "name_resolution_failure_count": name_resolution_failure_count,
        "address_in_use_count": address_in_use_count,
        "cannot_assign_address_count": cannot_assign_address_count,
        "network_unreachable_count": network_unreachable_count,
        "connection_refused_count": connection_refused_count,
        "timed_out_count": timed_out_count,
        "listener_success_observed": listen_success_count >= 1,
        "server_connection_observed": server_connected_count >= 1,
        "keyword_counts": {
            word: lowered.count(word)
            for word in ("error", "fail", "warn", "dns", "resolve", "listen", "socket", "network", "connect")
        },
        "marker_authority": "exact-nicotine-3.3.10-english-log-markers-under-c-locale",
        "raw_log_exported": False,
        "diagnostic_text_exported": False,
        "credential_values_exported": False,
        "remote_peer_endpoints_exported": False,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023r6-tcp-connect-evidence kind=function title="Python function tcp_connect_evidence"
def tcp_connect_evidence(address: str, port: int, *, timeout: float = 0.75) -> dict[str, Any]:
    probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    probe.settimeout(timeout)
    try:
        probe.connect((address, port))
    except OSError as exc:
        number = exc.errno if isinstance(exc.errno, int) else None
        return {
            "attempted": True,
            "connectable": False,
            "error_errno": number,
            "error_class": type(exc).__name__,
            "raw_error_exported": False,
        }
    finally:
        probe.close()
    return {
        "attempted": True,
        "connectable": True,
        "error_errno": None,
        "error_class": None,
        "raw_error_exported": False,
    }


