#@MNX-CHUNK id=30.20 slug=sound-graphics-mobile title="Sound, graphics, and mobile integration"
  ########## Sound & Graphics ##########
#@MNX-DEF path=hardware.graphics section=30.20 role=policy ordinal=036
  hardware.graphics = {
    enable      = true;           # was hardware.opengl.enable :contentReference[oaicite:4]{index=4}
    enable32Bit = true;           # was hardware.opengl.driSupport32Bit :contentReference[oaicite:5]{index=5}
    extraPackages = with pkgs; [  # VA‑API ↔ VDPAU bridges for NVDEC/NVENC
      libva-vdpau-driver
      libvdpau-va-gl
    ];
  };

  # Proprietary NVIDIA driver settings
#@MNX-DEF path=hardware.nvidia section=30.20 role=policy ordinal=037
  hardware.nvidia = {
    package            = config.boot.kernelPackages.nvidiaPackages.stable;
    modesetting.enable = true;     # KMS support
    powerManagement.enable = false;# set true if you hit resume corruption
    open               = false;    # closed‑source kernel module
    nvidiaSettings     = true;     # installs `nvidia-settings`
  }; 

  # Global NVIDIA runtime policy: prefer NVIDIA VAAPI/VDPAU/GBM for the normal X/i3 desktop.
  # Kodi keeps a session-specific override below because VAAPI-via-NVIDIA can be touchy there.
  # Editor/tool defaults live here too, so there is only one environment.variables block.
#@MNX-DEF path=environment.variables section=30.20 role=policy ordinal=038
  environment.variables = {
    LIBVA_DRIVER_NAME = "nvidia";
    VDPAU_DRIVER      = "nvidia";
    GBM_BACKEND       = "nvidia-drm";

    EDITOR = "micro";
    VISUAL = "micro";
    RIPGREP_CONFIG_PATH = "/etc/rg.conf";
    TEALDEER_CONFIG_DIR = "/etc/tealdeer";
  };




  # Persist ALSA mixer settings across reboots
#@MNX-DEF path=hardware.alsa.enablePersistence section=30.20 role=policy ordinal=039
  hardware.alsa.enablePersistence        = true;

#@MNX-DEF path=security.rtkit.enable section=30.20 role=identity-policy ordinal=040
  security.rtkit.enable                  = true;

#@MNX-DEF path=services.pipewire section=30.20 role=policy ordinal=041
  services.pipewire = {
    enable           = true;
    wireplumber.enable = true;

    # ALSA support via PipeWire
    alsa.enable      = true;
    alsa.support32Bit = true;

    # PulseAudio compatibility layer
    pulse.enable     = true;

    # JACK compatibility
    jack.enable      = true;
  };

#@MNX-DEF path=services.pipewire.extraConfig.pipewire."92-echo-and-noise-cancel.conf" section=30.20 role=policy ordinal=042
  services.pipewire.extraConfig.pipewire."92-echo-and-noise-cancel.conf" = {
    "context.modules" = [
      {
        name = "libpipewire-module-echo-cancel";
        args = {
          "monitor.mode" = true;  # use default sink monitor as echo reference :contentReference[oaicite:3]{index=3}
          "library.name" = "aec/libspa-aec-webrtc"; # optional; default is webrtc :contentReference[oaicite:4]{index=4}

          "capture.props" = {
            "node.name" = "echo-cancel-capture";
          };

          "source.props" = {
            "node.name" = "echo-cancel-source";
            "node.description" = "Echo Cancelled Mic";
            "media.class" = "Audio/Source";
            "node.virtual" = true;
          };
        };
      }

      {
        name = "libpipewire-module-filter-chain";
        args = {
          "node.description" = "Echo + Noise Cancelled Mic";
          "media.name" = "Echo + Noise Cancelled Mic";

          "filter.graph" = {
            "nodes" = [
              {
                "type" = "ladspa";
                "name" = "rnnoise";
                "plugin" = "${pkgs.rnnoise-plugin}/lib/ladspa/librnnoise_ladspa.so";
                "label" = "noise_suppressor_mono";
              }
            ];
          };

          # capture stream: take audio FROM the echo-cancel virtual source
          "capture.props" = {
            "node.name" = "capture.ec_rnnoise";
            "node.passive" = true;                 # matches upstream example :contentReference[oaicite:5]{index=5}
            "target.object" = "echo-cancel-source";# preferred over node.target :contentReference[oaicite:6]{index=6}
          };

          # playback (main) node: expose the processed audio AS a virtual mic
          "playback.props" = {
            "node.name" = "ec_rnnoise_source";
            "media.class" = "Audio/Source";        # upstream “virtual source” pattern :contentReference[oaicite:7]{index=7}
            "node.virtual" = true;
          };
        };
      }
    ];
  };

#@MNX-DEF path=services.pipewire.extraConfig.pipewire."10-clock.conf" section=30.20 role=policy ordinal=043
  services.pipewire.extraConfig.pipewire."10-clock.conf" = { #decrackle deadbeef on max CPU
    "context.properties" = {
      "default.clock.rate" = 48000;
      "default.clock.quantum" = 2048;
      "default.clock.min-quantum" = 1024;
      "default.clock.max-quantum" = 4096;
    };
  };



