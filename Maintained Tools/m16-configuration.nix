      #@MNX-PART id=99.91.mnx-presslog-observe.function.publication-group-gid kind=function title="Python function publication_group_gid"
      def publication_group_gid(lookup: Any | None = None) -> int:
          resolver = grp.getgrnam if lookup is None else lookup
          try:
