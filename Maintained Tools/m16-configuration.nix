#@MNX-PART id=90.00.monsterdesk.function.f002-canonical kind=function title="Python function canonical"
def canonical(value: Any) -> str:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


#@MNX-PART id=90.00.monsterdesk.function.f003-atomic-json kind=function title="Python function atomic_json"
def atomic_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{secrets.token_hex(4)}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(tmp, flags, 0o600)
    try:
        payload = (canonical(value) + "\n").encode("utf-8")
        os.write(fd, payload)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)
    os.chmod(path, 0o600)


#@MNX-PART id=90.00.monsterdesk.function.f003a-atomic-text kind=function title="Python function atomic_text"
def atomic_text(path: Path, text: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{secrets.token_hex(4)}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(tmp, flags, mode)
    try:
        payload = text.encode("utf-8")
        view = memoryview(payload)
        while view:
            written = os.write(fd, view)
            if written <= 0:
                raise MonsterdeskError(f"short write while publishing {path}")
            view = view[written:]
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)
    os.chmod(path, mode)


#@MNX-PART id=90.00.monsterdesk.function.f003b-bounded-log-tail kind=function title="Python function bounded_log_tail"
def bounded_log_tail(path: Path | None) -> str:
    if path is None:
        return ""
    try:
        st = path.lstat()
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
            return "log-unavailable-unsafe-object"
        with path.open("rb") as handle:
            if st.st_size > MAX_LOG_TAIL_BYTES:
                handle.seek(-MAX_LOG_TAIL_BYTES, os.SEEK_END)
            raw = handle.read(MAX_LOG_TAIL_BYTES)
    except OSError as exc:
        return f"log-unavailable-{exc.__class__.__name__}"
    text = raw.decode("utf-8", errors="replace")
    text = "".join(character if character in "\n\r\t" or ord(character) >= 32 else "?" for character in text)
    return text[-4000:].strip()


#@MNX-PART id=90.00.monsterdesk.function.f003c-write-all-fd kind=function title="Python function write_all_fd"
def write_all_fd(fd: int, payload: bytes) -> None:
    view = memoryview(payload)
    while view:
        written = os.write(fd, view)
        if written <= 0:
            raise OSError("short write")
        view = view[written:]


#@MNX-PART id=90.00.monsterdesk.function.f003d-drain-bounded-log kind=function title="Python function drain_bounded_log"
def drain_bounded_log(stream: Any, path: Path) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(path, flags, 0o600)
    except OSError:
        with contextlib.suppress(Exception):
            stream.close()
        return
    retained = bytearray()
    try:
        while True:
            # BufferedReader.read(n) can wait for n bytes or EOF from a live child.
            # read1 returns the currently available chunk without waiting to fill n.
            chunk = stream.read1(8192)
            if not chunk:
                break
            retained.extend(chunk)
            if len(retained) > MAX_LOG_FILE_BYTES:
                del retained[:-MAX_LOG_FILE_BYTES]
            os.lseek(fd, 0, os.SEEK_SET)
            os.ftruncate(fd, 0)
            write_all_fd(fd, retained)
        os.fsync(fd)
    except (OSError, ValueError):
        pass
    finally:
        with contextlib.suppress(Exception):
            stream.close()
        os.close(fd)


#@MNX-PART id=90.00.monsterdesk.function.f003e-write-xauthority kind=function title="Python function write_xauthority"
def write_xauthority(path: Path, hostname: str, display_number: int, cookie: bytes) -> None:
    # Xau format: network-order uint16 family, then four uint16-length byte strings.
    # FamilyLocal matches the client UTS hostname; it is NOT a server-side ACL.
    # Both files contain only the fresh nested-server cookie, never host :0 authority.
    if not isinstance(hostname, str) or not re.fullmatch(r"[A-Za-z0-9_.-]{1,255}", hostname):
        raise MonsterdeskError("invalid local Xauthority hostname")
    if type(display_number) is not int or not DISPLAY_MIN <= display_number <= DISPLAY_MAX:
        raise MonsterdeskError("invalid private Xauthority display number")
    if not isinstance(cookie, bytes) or len(cookie) != 16:
        raise MonsterdeskError("invalid private Xauthority cookie size")
    fields = (hostname.encode("ascii"), str(display_number).encode("ascii"), b"MIT-MAGIC-COOKIE-1", cookie)
    payload = struct.pack(">H", 256)
    for field in fields:
        payload += struct.pack(">H", len(field)) + field
    tmp = path.with_name(f".{path.name}.{secrets.token_hex(4)}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.fchmod(fd, 0o600)
        write_all_fd(fd, payload)
        os.fsync(fd)
    finally:
        os.close(fd)
    try:
        os.replace(tmp, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            tmp.unlink()


#@MNX-PART id=90.00.monsterdesk.function.f004-secure-dir kind=function title="Python function secure_dir"
def secure_dir(path: Path, mode: int = 0o700) -> Path:
    path = path.expanduser()
    try:
        st = path.lstat()
    except FileNotFoundError:
        path.mkdir(parents=True, mode=mode)
        st = path.lstat()
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        raise MonsterdeskError(f"unsafe directory object: {path}")
    if st.st_uid != os.getuid():
        raise MonsterdeskError(f"directory is not owned by uid {os.getuid()}: {path}")
    if stat.S_IMODE(st.st_mode) & 0o077:
        os.chmod(path, mode)
        st = path.lstat()
    if stat.S_IMODE(st.st_mode) != mode:
        raise MonsterdeskError(f"directory mode is not {mode:o}: {path}")
    return path


#@MNX-PART id=90.00.monsterdesk.function.f005-runtime-base kind=function title="Python function runtime_base"
def runtime_base() -> Path:
    raw = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    path = Path(raw)
    try:
        st = path.lstat()
    except OSError as exc:
        raise MonsterdeskError(f"runtime directory unavailable: {path}: {exc}") from exc
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        raise MonsterdeskError(f"runtime directory is unsafe: {path}")
    if st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) != 0o700:
        raise MonsterdeskError(f"runtime directory ownership/mode differs: {path}")
    return path


#@MNX-PART id=90.00.monsterdesk.function.f005a-instance-name kind=function title="Python function instance_name"
def instance_name() -> str:
    value = os.environ.get("MONSTERDESK_INSTANCE", "main")
    if value in {"main", "nicotine", "qbittorrent"}:
        return value
    if not re.fullmatch(r"acceptance-[0-9]+-[0-9a-f]{8}", value):
        raise MonsterdeskError("MONSTERDESK_INSTANCE is not an owned main, nicotine, qbittorrent, or acceptance instance")
    return value


#@MNX-PART id=90.00.monsterdesk.function.f005b-instance-runtime-name kind=function title="Python function instance_runtime_name"
def instance_runtime_name(instance: str | None = None) -> str:
    selected = instance_name() if instance is None else instance
    if selected == "main":
        return "monsterdesk"
    if selected == "nicotine":
        return "monsterdesk-nicotine"
    if selected == "qbittorrent":
        return "monsterdesk-qbittorrent"
    return f"monsterdesk-{selected}"


#@MNX-PART id=90.00.monsterdesk.function.f005c-viewer-title kind=function title="Python function viewer_title"
def viewer_title(instance: str | None = None) -> str:
    selected = instance_name() if instance is None else instance
    if selected == "main":
        return "Monsterdesk"
    if selected == "nicotine":
        return "Monsterdesk Nicotine"
    if selected == "qbittorrent":
        return "Monsterdesk qBittorrent"
    return f"Monsterdesk Acceptance {selected[11:]}"


#@MNX-PART id=90.00.monsterdesk.function.f006-state-base kind=function title="Python function state_base"
def state_base() -> Path:
    selected = instance_name()
    state_home = Path(os.environ.get("XDG_STATE_HOME", USER_HOME / ".local/state"))
    if selected == "main":
        return secure_dir(state_home / "monsterdesk")
    if selected == "nicotine":
        return secure_dir(state_home / "monsterdesk-nicotine")
    if selected == "qbittorrent":
        return secure_dir(state_home / "monsterdesk-qbittorrent")
    return secure_dir(runtime_base() / f"{instance_runtime_name(selected)}-state")


