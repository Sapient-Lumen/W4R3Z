        cloudtainer)
          if [[ "''${1:-status}" == pack ]]; then
            need_root "$@"
          fi
          planner "$@"
          ;;

        workspace)
          need_root "$@"
          planner "$@"
          ;;

        prepare)
          need_root "$@"
          STAMP="$(date +%Y%m%dT%H%M%S)"
          SOURCE_HASH="$(sha256sum "$CFG" | awk '{print $1}')"
          REPORT_DIR=/var/lib/logbook/support
          REPORT="$REPORT_DIR/refactor-prepare-$STAMP-''${SOURCE_HASH:0:12}.txt"
          MAP="$REPORT_DIR/monolith-map-$STAMP-''${SOURCE_HASH:0:12}.txt"
          ATLAS_MAP="$REPORT_DIR/atlas-map-$STAMP-''${SOURCE_HASH:0:12}.txt"
          ATLAS_MANIFEST="$REPORT_DIR/atlas-manifest-$STAMP-''${SOURCE_HASH:0:12}.json"
          RELATION_MAP="$REPORT_DIR/relationship-map-$STAMP-''${SOURCE_HASH:0:12}.txt"
          RELATION_MANIFEST="$REPORT_DIR/relationship-manifest-$STAMP-''${SOURCE_HASH:0:12}.json"
          RELATION_BUNDLE="$REPORT_DIR/relationship-bundle-$STAMP-''${SOURCE_HASH:0:12}.tar.gz"
          BUNDLE="$REPORT_DIR/monolith-bundle-$STAMP-''${SOURCE_HASH:0:12}.tar.gz"
          install -d -m 2750 -o root -g logbook "$REPORT_DIR"
          exec > >(tee "$REPORT") 2>&1

          printf '################################################################################\n# MNX PRE-REFACTOR PREPARATION\n################################################################################\n'
          date -Is
          identity
          [[ -f "$CFG" && ! -L "$CFG" ]] || { echo 'configuration must be a regular non-symlink file' >&2; exit 1; }
          [[ "$(readlink -f /run/current-system)" == "$(readlink -f /nix/var/nix/profiles/system)" ]] || { echo 'running generation is not the boot default' >&2; exit 1; }
          [[ "$(systemctl is-system-running 2>/dev/null || true)" == running ]] || { echo 'system is not running cleanly' >&2; exit 1; }
          [[ -z "$(systemctl --failed --no-legend --plain 2>/dev/null || true)" ]] || { echo 'failed units exist' >&2; systemctl --failed --no-pager --full; exit 1; }
          cmp -s "$CFG" /run/current-system/configuration.nix || { echo 'source does not exactly match the active embedded configuration' >&2; exit 1; }
          BUSY="$(heavy_storage_active)"
          [[ -z "$BUSY" ]] || { printf 'heavy_storage_active=%s\n' "$(tr '\n' ',' <<<"$BUSY" | sed 's/,$//')"; exit 75; }

          MNX_CONFIG="$CFG" /etc/monsternix/bin/mnx-config-audit quick
          /etc/monsternix/bin/mnx-bundle-manifest self-test
          /etc/monsternix/bin/mnx-monolith --config "$CFG" verify
          /etc/monsternix/bin/mnx-atlas --config "$CFG" verify
          /etc/monsternix/bin/mnx-atlas --config "$CFG" temp-gate audit
          /etc/monsternix/bin/mnx-relations --config "$CFG" verify
          /etc/monsternix/bin/mnx-behavior-manifest repeatability

          BTRFS_BASELINE_DIR=/var/lib/monsternix/btrfs-baselines/baselines
          if [[ -L /var/lib/monsternix/btrfs-baselines/pinned ]]; then
            /etc/monsternix/bin/mnx-btrfs-baseline compare pinned
          elif [[ -s "$BTRFS_BASELINE_DIR/$BASELINE_NAME.json" ]]; then
            /etc/monsternix/bin/mnx-btrfs-baseline compare "$BASELINE_NAME"
            /etc/monsternix/bin/mnx-btrfs-baseline pin "$BASELINE_NAME"
          else
            /etc/monsternix/bin/mnx-btrfs-baseline check-zero
            /etc/monsternix/bin/mnx-btrfs-baseline capture "$BASELINE_NAME" --pin
          fi

          /etc/monsternix/bin/mnx-monolith --config "$CFG" index > "$MAP"
          /etc/monsternix/bin/mnx-atlas --config "$CFG" index --parts > "$ATLAS_MAP"
          /etc/monsternix/bin/mnx-atlas --config "$CFG" manifest > "$ATLAS_MANIFEST"
          /etc/monsternix/bin/mnx-relations --config "$CFG" index > "$RELATION_MAP"
          /etc/monsternix/bin/mnx-relations --config "$CFG" manifest > "$RELATION_MANIFEST"
          chown root:logbook "$MAP" "$ATLAS_MAP" "$ATLAS_MANIFEST" "$RELATION_MAP" "$RELATION_MANIFEST"
          chmod 0640 "$MAP" "$ATLAS_MAP" "$ATLAS_MANIFEST" "$RELATION_MAP" "$RELATION_MANIFEST"
          /etc/monsternix/bin/mnx-monolith --config "$CFG" bundle --out "$BUNDLE"
          /etc/monsternix/bin/mnx-relations --config "$CFG" bundle --out "$RELATION_BUNDLE"
          chown root:logbook "$BUNDLE" "$RELATION_BUNDLE"
          chmod 0640 "$BUNDLE" "$RELATION_BUNDLE"

          BASELINE_DIR="/var/lib/logbook/baselines/$BASELINE_NAME"
          if [[ -s "$BASELINE_DIR/manifest.txt" ]]; then
            if (( REPLACE == 1 )); then
              /etc/monsternix/bin/mnx-behavior-manifest capture "$BASELINE_NAME" --pin --replace
            else
              /etc/monsternix/bin/mnx-behavior-manifest pin "$BASELINE_NAME"
              /etc/monsternix/bin/mnx-behavior-manifest compare "$BASELINE_NAME" || {
                echo "baseline $BASELINE_NAME exists but differs; use --replace only after intentional review" >&2
                exit 1
              }
            fi
          else
            /etc/monsternix/bin/mnx-behavior-manifest capture "$BASELINE_NAME" --pin
          fi
          /etc/monsternix/bin/mnx-behavior-manifest compare "$BASELINE_NAME"

          printf 'refactor_baseline=%s\n' "$BASELINE_NAME"
          printf 'monolith_map=%s\n' "$MAP"
          printf 'atlas_map=%s\n' "$ATLAS_MAP"
          printf 'atlas_manifest=%s\n' "$ATLAS_MANIFEST"
          printf 'relationship_map=%s\n' "$RELATION_MAP"
          printf 'relationship_manifest=%s\n' "$RELATION_MANIFEST"
          printf 'relationship_bundle=%s\n' "$RELATION_BUNDLE"
          printf 'monolith_bundle=%s\n' "$BUNDLE"
          printf 'report=%s\n' "$REPORT"
          printf 'MNX_REFACTOR_READY=yes\n'
