        grep -Fq '[[ "$POST_ACCEPTANCE_PLAN" != presslog-rearm,cloudtainer-pack ]]' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: Presslog rearm lacks its exact continuation-plan gate' >&2; return 1; }
