    return env


#@MNX-PART id=90.00.monsterdesk.function.f018-peer-uid kind=function title="Python function peer_uid"
def peer_uid(connection: socket.socket) -> int:
    size = struct.calcsize("3i")
    raw = connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, size)
    _pid, uid, _gid = struct.unpack("3i", raw)
    return uid


#@MNX-PART id=90.00.monsterdesk.function.f019-recv-line kind=function title="Python function recv_line"
def recv_line(connection: socket.socket, limit: int = MAX_REQUEST_BYTES) -> bytes:
    data = bytearray()
    while len(data) <= limit:
        chunk = connection.recv(min(65536, limit + 1 - len(data)))
        if not chunk:
            break
        data.extend(chunk)
        if b"\n" in chunk:
            break
    if len(data) > limit:
        raise MonsterdeskError("request exceeds byte limit")
    line, _, trailing = bytes(data).partition(b"\n")
    if trailing.strip():
        raise MonsterdeskError("request contains trailing data")
    return line


#@MNX-PART id=90.00.monsterdesk.function.f020-send-json kind=function title="Python function send_json"
def send_json(connection: socket.socket, value: Any) -> None:
    payload = (canonical(value) + "\n").encode("utf-8")
    if len(payload) > MAX_RESPONSE_BYTES:
        raise MonsterdeskError("response exceeds byte limit")
    connection.sendall(payload)


#@MNX-PART id=90.00.monsterdesk.function.f021-png-dimensions kind=function title="Python function png_dimensions"
def png_dimensions(payload: bytes) -> tuple[int, int]:
    if len(payload) < 24 or payload[:8] != b"\x89PNG\r\n\x1a\n" or payload[12:16] != b"IHDR":
        raise MonsterdeskError("capture did not produce canonical PNG framing")
    width, height = struct.unpack(">II", payload[16:24])
    if width <= 0 or height <= 0 or width * height > MAX_SCREEN_PIXELS:
        raise MonsterdeskError("capture dimensions exceed policy")
    return width, height


#@MNX-PART id=90.00.monsterdesk.function.f022-copy-tree-bounded kind=function title="Python function copy_tree_bounded"
def copy_tree_bounded(source: Path, destination: Path) -> dict[str, int]:
    source = source.expanduser()
    if not source.exists():
        return {"files": 0, "bytes": 0, "special_skipped": 0}
    root_stat = source.lstat()
    if stat.S_ISLNK(root_stat.st_mode) or not stat.S_ISDIR(root_stat.st_mode):
        raise MonsterdeskError(f"seed source is not a real directory: {source}")
    destination.mkdir(parents=True, exist_ok=True, mode=0o700)
    files = 0
    total = 0
    special = 0
    for base, dirs, names in os.walk(source, followlinks=False):
        base_path = Path(base)
        relative = base_path.relative_to(source)
        target_base = destination / relative
        target_base.mkdir(parents=True, exist_ok=True, mode=0o700)
        retained_dirs: list[str] = []
        for name in dirs:
            path = base_path / name
            target = target_base / name
            st = path.lstat()
            files += 1
            if files > MAX_SEED_FILES:
                raise MonsterdeskError("private-home seed exceeds file-count limit")
            if stat.S_ISLNK(st.st_mode):
                with contextlib.suppress(FileExistsError):
                    target.symlink_to(os.readlink(path))
            elif stat.S_ISDIR(st.st_mode):
                target.mkdir(exist_ok=True, mode=0o700)
                retained_dirs.append(name)
            else:
                special += 1
        dirs[:] = retained_dirs
        for name in names:
            path = base_path / name
            target = target_base / name
            st = path.lstat()
            files += 1
            if files > MAX_SEED_FILES:
                raise MonsterdeskError("private-home seed exceeds file-count limit")
            if stat.S_ISREG(st.st_mode):
                total += st.st_size
                if total > MAX_SEED_BYTES:
                    raise MonsterdeskError("private-home seed exceeds byte limit")
                shutil.copy2(path, target, follow_symlinks=False)
            elif stat.S_ISLNK(st.st_mode):
                with contextlib.suppress(FileExistsError):
                    target.symlink_to(os.readlink(path))
            else:
                special += 1
    return {"files": files, "bytes": total, "special_skipped": special}


#@MNX-PART id=90.00.monsterdesk.function.f023-seed-nicotine-home kind=function title="Python function seed_nicotine_home"
def seed_nicotine_home(home: Path) -> dict[str, Any]:
    marker = home / ".monsterdesk-seed.json"
    if marker.exists():
        try:
            st = marker.lstat()
            if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
                raise MonsterdeskError("private-home seed marker is unsafe")
            value = json.loads(marker.read_text(encoding="utf-8"))
            if not isinstance(value, dict):
                raise MonsterdeskError("private-home seed marker is not an object")
            if value.get("schema") != "mnx.monsterdesk.seed.v1" or value.get("profile") != "nicotine-audit":
                raise MonsterdeskError("private-home seed marker identity differs")
            for key, limit in (("files", MAX_SEED_FILES), ("bytes", MAX_SEED_BYTES), ("special_skipped", MAX_SEED_FILES)):
                item = value.get(key)
                if not isinstance(item, int) or isinstance(item, bool) or item < 0 or item > limit:
                    raise MonsterdeskError(f"private-home seed marker field is invalid: {key}")
            sources = value.get("sources")
            if not isinstance(sources, list) or not all(isinstance(item, str) and item.startswith(str(USER_HOME)) for item in sources):
                raise MonsterdeskError("private-home seed marker sources are invalid")
            return {**value, "reused": True}
        except (OSError, UnicodeError, json.JSONDecodeError) as exc:
            raise MonsterdeskError(f"private-home seed marker is unreadable: {exc}") from exc
    mapping = [
        (USER_HOME / ".config/nicotine", home / ".config/nicotine"),
        (USER_HOME / ".local/share/nicotine", home / ".local/share/nicotine"),
        (USER_HOME / ".nicotine", home / ".nicotine"),
    ]
    aggregate = {"schema": "mnx.monsterdesk.seed.v1", "profile": "nicotine-audit", "files": 0, "bytes": 0,
                 "special_skipped": 0, "sources": [], "created_at": time.time(), "reused": False}
    for source, destination in mapping:
        if source.exists():
            result = copy_tree_bounded(source, destination)
            aggregate["files"] += result["files"]
            aggregate["bytes"] += result["bytes"]
            aggregate["special_skipped"] += result["special_skipped"]
            aggregate["sources"].append(str(source))
    atomic_json(marker, aggregate)
    return aggregate


#@MNX-PART id=90.00.monsterdesk.function.f023a-stable-regular-read kind=function title="Python function stable_regular_read"
def stable_regular_read(path: Path, maximum: int, *, expected_uid: int | None = None) -> tuple[bytes, dict[str, Any]]:
    selected = path.expanduser()
    try:
        before = selected.lstat()
    except OSError as exc:
        raise MonsterdeskError(f"file unavailable: {selected}: {exc}") from exc
    if stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode):
        raise MonsterdeskError(f"file is not a real regular file: {selected}")
    if expected_uid is not None and before.st_uid != expected_uid:
        raise MonsterdeskError(f"file owner differs: {selected}")
    if before.st_size > maximum:
        raise MonsterdeskError(f"file exceeds {maximum} bytes: {selected}")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(selected, flags)
    try:
        opened = os.fstat(fd)
        if (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino):
            raise MonsterdeskError(f"file identity changed before open: {selected}")
        chunks: list[bytes] = []
        total = 0
        while True:
            chunk = os.read(fd, min(65536, maximum + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
            if total > maximum:
                raise MonsterdeskError(f"file exceeds {maximum} bytes while reading: {selected}")
        after_fd = os.fstat(fd)
    finally:
        os.close(fd)
    after = selected.lstat()
    before_identity = (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
    if before_identity != (after_fd.st_dev, after_fd.st_ino, after_fd.st_size, after_fd.st_mtime_ns):
        raise MonsterdeskError(f"file changed while reading: {selected}")
    if before_identity != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
        raise MonsterdeskError(f"file path changed while reading: {selected}")
    raw = b"".join(chunks)
    if len(raw) != before.st_size:
        raise MonsterdeskError(f"file size changed while reading: {selected}")
    return raw, {
        "path": str(selected), "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest(),
        "uid": int(before.st_uid), "gid": int(before.st_gid),
        "mode": stat.S_IMODE(before.st_mode), "stable_read": True,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023b-proc-bytes kind=function title="Python function proc_bytes"
def proc_bytes(path: Path, maximum: int = 256 * 1024) -> bytes:
    try:
        with path.open("rb") as handle:
            value = handle.read(maximum + 1)
    except OSError:
        return b""
    return value[:maximum]


#@MNX-PART id=90.00.monsterdesk.function.f023c-command-option kind=function title="Python function command_option"
def command_option(arguments: list[str], short: str, long: str) -> str | None:
    for index, value in enumerate(arguments):
        if value in {short, long} and index + 1 < len(arguments):
            return arguments[index + 1]
        if value.startswith(long + "="):
            return value.split("=", 1)[1]
    return None


#@MNX-PART id=90.00.monsterdesk.function.f023d-decode-proc-address kind=function title="Python function decode_proc_address"
def decode_proc_address(value: str, family: int) -> str:
    try:
        if family == socket.AF_INET:
            packed = bytes.fromhex(value)[::-1]
        else:
            if len(value) != 32:
                raise ValueError("IPv6 field length differs")
            packed = b"".join(bytes.fromhex(value[index:index + 8])[::-1] for index in range(0, 32, 8))
        return socket.inet_ntop(family, packed)
    except (OSError, ValueError) as exc:
        raise MonsterdeskError(f"invalid proc network address: {value}") from exc


#@MNX-PART id=90.00.monsterdesk.function.f023e-process-socket-endpoints kind=function title="Python function process_socket_endpoints"
def process_socket_endpoints(process_root: Path) -> list[dict[str, Any]]:
    inodes: set[str] = set()
    try:
        descriptors = (process_root / "fd").iterdir()
    except OSError:
        descriptors = iter(())
    for descriptor_index, descriptor in enumerate(descriptors):
        if descriptor_index >= 8192:
            break
        try:
            target = os.readlink(descriptor)
        except OSError:
            continue
        match = re.fullmatch(r"socket:\[([0-9]+)\]", target)
        if match:
            inodes.add(match.group(1))
    endpoints: dict[tuple[Any, ...], dict[str, Any]] = {}
    tables = (
        ("tcp", socket.AF_INET, "tcp"), ("tcp6", socket.AF_INET6, "tcp6"),
        ("udp", socket.AF_INET, "udp"), ("udp6", socket.AF_INET6, "udp6"),
    )
    for protocol, family, filename in tables:
        text = proc_bytes(process_root / "net" / filename, 2 * 1024 * 1024).decode("ascii", errors="replace")
        for line in text.splitlines()[1:]:
            fields = line.split()
            if len(fields) < 10 or fields[9] not in inodes:
                continue
            try:
                address_hex, port_hex = fields[1].split(":", 1)
                address = decode_proc_address(address_hex, family)
                port = int(port_hex, 16)
            except (ValueError, MonsterdeskError):
                continue
            state = fields[3].upper()
            if protocol == "tcp" and state == "0A":
                kind = "listen"
            elif protocol == "tcp6" and state == "0A":
                kind = "listen"
            elif protocol.startswith("udp") and port:
                kind = "bound"
            else:
                kind = "connected-local"
            key = (protocol, address, port, state, kind)
            endpoints[key] = {
                "protocol": protocol, "address": address, "port": port,
                "state": state, "kind": kind,
            }
    return [endpoints[key] for key in sorted(endpoints)[:MAX_NICOTINE_ENDPOINTS]]


#@MNX-PART id=90.00.monsterdesk.function.f023e0-network-namespace-endpoints kind=function title="Python function network_namespace_socket_endpoints"
def network_namespace_socket_endpoints(process_root: Path) -> dict[str, Any]:
    endpoints: dict[tuple[Any, ...], dict[str, Any]] = {}
    table_readable = False
    tables = (
        ("tcp", socket.AF_INET, "tcp"), ("tcp6", socket.AF_INET6, "tcp6"),
        ("udp", socket.AF_INET, "udp"), ("udp6", socket.AF_INET6, "udp6"),
    )
    for protocol, family, filename in tables:
        raw = proc_bytes(process_root / "net" / filename, 2 * 1024 * 1024)
        if raw:
            table_readable = True
        text_value = raw.decode("ascii", errors="replace")
        for line in text_value.splitlines()[1:]:
            fields = line.split()
            if len(fields) < 4:
                continue
            try:
                address_hex, port_hex = fields[1].split(":", 1)
                address = decode_proc_address(address_hex, family)
                port = int(port_hex, 16)
            except (ValueError, MonsterdeskError):
                continue
            state = fields[3].upper()
            if protocol.startswith("tcp") and state == "0A":
                kind = "listen"
            elif protocol.startswith("udp") and port:
                kind = "bound"
            else:
                kind = "connected-local"
            key = (protocol, address, port, state, kind)
            endpoints[key] = {
                "protocol": protocol, "address": address, "port": port,
                "state": state, "kind": kind,
            }
    rows = [endpoints[key] for key in sorted(endpoints)[:MAX_NICOTINE_ENDPOINTS]]
    return {
        "table_readable": table_readable,
        "endpoints": rows,
        "remote_endpoints_exported": False,
        "authority": "isolated-network-namespace-local-endpoints",
    }


#@MNX-PART id=90.00.monsterdesk.function.f023e1-nicotine-process-command-matches kind=function title="Python function nicotine_process_command_matches"
def nicotine_process_command_matches(comm: str, executable: str, arguments: list[str]) -> bool:
    comm_name = comm.strip().lower()
    executable_name = Path(executable).name.lower()
    argument_names = [Path(value).name.lower() for value in arguments]
    return (
        comm_name == "nicotine"
        or executable_name in {"nicotine", "nicotine-plus"}
        or "nicotine-wrapped" in executable_name
        or any("nicotine-wrapped" in name for name in argument_names)
    )


#@MNX-PART id=90.00.monsterdesk.function.f023e2-nicotine-application-arguments kind=function title="Python function nicotine_application_arguments"
def nicotine_application_arguments(arguments: list[str]) -> list[str]:
    for index, value in enumerate(arguments):
        name = Path(value).name.lower()
        if name in {"nicotine", "nicotine-plus"} or "nicotine-wrapped" in name:
            return arguments[index + 1:]
    return []


#@MNX-PART id=90.00.monsterdesk.function.f023f-nicotine-process-inventory kind=function title="Python function nicotine_process_inventory"
def nicotine_process_inventory(*, expected_uid: int = USER_UID, include_runtime: bool = True) -> list[dict[str, Any]]:
    if not include_runtime:
        return []
    processes: list[dict[str, Any]] = []
    host_netns = os.readlink("/proc/self/ns/net")
    for entry in sorted(Path("/proc").iterdir(), key=lambda item: int(item.name) if item.name.isdigit() else 10**12):
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        try:
            identity = process_identity(pid)
        except (OSError, ValueError, MonsterdeskError):
            continue
        if identity["uid_set"] != [expected_uid, expected_uid, expected_uid, expected_uid]:
            continue
        if identity["state"] == "Z":
            continue
        comm = proc_bytes(entry / "comm", 4096).decode("utf-8", errors="replace").strip()
        raw_command = proc_bytes(entry / "cmdline", 65536)
        arguments = [item.decode("utf-8", errors="replace")[:512]
                     for item in raw_command.split(b"\0") if item][:24]
        try:
            executable = os.readlink(entry / "exe")
        except OSError:
            executable = "unavailable"
        if not nicotine_process_command_matches(comm, executable, arguments):
            continue
        start_ticks = int(identity["start_ticks"])
        if not process_matches(pid, start_ticks):
            continue
        environment: dict[str, str] = {}
        for item in proc_bytes(entry / "environ", 131072).split(b"\0"):
            if b"=" not in item:
                continue
            key_raw, value_raw = item.split(b"=", 1)
            key = key_raw.decode("ascii", errors="ignore")
            if key in {
                "HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "DISPLAY", "WAYLAND_DISPLAY",
                "DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR",
            }:
                environment[key] = value_raw.decode("utf-8", errors="replace")[:1024]
        namespaces: dict[str, str] = {}
        for name in ("net", "mnt", "pid", "user", "ipc", "uts"):
            try:
                namespaces[name] = os.readlink(entry / "ns" / name)
            except OSError:
                namespaces[name] = "unavailable"
        processes.append({
            "pid": pid, "start_ticks": start_ticks, "comm": comm, "executable": executable,
            "arguments": arguments, "environment": environment, "namespaces": namespaces,
            "host_network_namespace": namespaces.get("net") == host_netns,
            "cgroup": proc_bytes(entry / "cgroup", 8192).decode("utf-8", errors="replace").strip()[:2048],
            "local_endpoints": process_socket_endpoints(entry),
        })
        if len(processes) >= MAX_NICOTINE_PROCESSES:
            break
    return processes


#@MNX-PART id=90.00.monsterdesk.function.f023g-nicotine-layout kind=function title="Python function nicotine_layout"
def nicotine_layout(home: Path, processes: list[dict[str, Any]]) -> dict[str, Any]:
    selected_home = home.expanduser()
    config_arguments: list[str] = []
    data_arguments: list[str] = []
    xdg_config_roots: list[str] = []
    xdg_data_roots: list[str] = []
    for process in processes:
        if not nicotine_process_command_matches(
            str(process.get("comm", "")),
            str(process.get("executable", "")),
            [str(value) for value in process.get("arguments", [])],
        ):
            continue
        arguments = nicotine_application_arguments(
            [str(value) for value in process.get("arguments", [])]
        )
        if value := command_option(arguments, "-c", "--config"):
            config_arguments.append(value)
        if value := command_option(arguments, "-u", "--user-data"):
            data_arguments.append(value)
        environment = process.get("environment", {})
        if environment.get("XDG_CONFIG_HOME"):
            xdg_config_roots.append(environment["XDG_CONFIG_HOME"].split(":", 1)[0])
        if environment.get("XDG_DATA_HOME"):
            xdg_data_roots.append(environment["XDG_DATA_HOME"].split(":", 1)[0])

    #@MNX-PART id=90.00.monsterdesk.function.f023g1-unique kind=function title="Python function unique"
    def unique(values: list[str], description: str) -> str | None:
        selected = sorted(set(values))
        if len(selected) > 1:
            raise MonsterdeskError(f"live Nicotine processes disagree about {description}: {selected}")
        return selected[0] if selected else None

    command_config = unique(config_arguments, "configuration paths")
    command_data = unique(data_arguments, "data paths")
    legacy = selected_home / ".nicotine"
    if legacy.exists() and (legacy.is_symlink() or not legacy.is_dir()):
        raise MonsterdeskError(f"legacy Nicotine path is unsafe: {legacy}")
    if not selected_home.is_absolute():
        raise MonsterdeskError(f"Nicotine home is not absolute: {selected_home}")
    selected_xdg_config = unique(xdg_config_roots, "XDG config roots")
    selected_xdg_data = unique(xdg_data_roots, "XDG data roots")
    xdg_config_root = Path(selected_xdg_config).expanduser() if selected_xdg_config else None
    xdg_data_root = Path(selected_xdg_data).expanduser() if selected_xdg_data else None
    if xdg_config_root is not None and not xdg_config_root.is_absolute():
        xdg_config_root = None
    if xdg_data_root is not None and not xdg_data_root.is_absolute():
        xdg_data_root = None
    if command_config:
        config_path = Path(command_config).expanduser()
        selection = "live-command-line"
    elif legacy.is_dir():
        config_path = legacy / "config"
        selection = "legacy-home"
    else:
        root = xdg_config_root or selected_home / ".config"
        config_path = root / "nicotine" / "config"
        selection = "xdg-default-or-live-environment"
    if command_data:
        data_path = Path(command_data).expanduser()
    elif legacy.is_dir():
        data_path = legacy
    else:
        root = xdg_data_root or selected_home / ".local/share"
        data_path = root / "nicotine"
    if not config_path.is_absolute():
        raise MonsterdeskError(f"Nicotine command-line configuration path is not absolute: {config_path}")
    if not data_path.is_absolute():
        raise MonsterdeskError(f"Nicotine command-line data path is not absolute: {data_path}")
    return {
        "config_path": config_path, "data_path": data_path, "selection": selection,
        "legacy_directory_present": legacy.is_dir(),
    }


#@MNX-PART id=90.00.monsterdesk.function.f023h-nicotine-path-metadata kind=function title="Python function nicotine_path_metadata"
def nicotine_path_metadata(path_value: str, kind: str, *, data_path: Path,
                            virtual_name: str | None = None) -> dict[str, Any]:
    expanded_value = path_value.replace("''${NICOTINE_DATA_HOME}", str(data_path))
    if "\0" in expanded_value:
        raise MonsterdeskError("NUL in Nicotine path")
    path = Path(expanded_value).expanduser()
    if not path.is_absolute():
        raise MonsterdeskError(f"Nicotine path is not absolute: {path}")
    value: dict[str, Any] = {"kind": kind, "path": str(path)}
    if virtual_name is not None:
        value["virtual_name"] = virtual_name[:256]
    try:
        item_stat = path.lstat()
    except FileNotFoundError:
        value.update({"exists": False, "object_type": "missing"})
        return value
    if stat.S_ISLNK(item_stat.st_mode):
        object_type = "symlink"
    elif stat.S_ISDIR(item_stat.st_mode):
        object_type = "directory"
    elif stat.S_ISREG(item_stat.st_mode):
        object_type = "regular"
    else:
        object_type = "special"
    value.update({
        "exists": True, "object_type": object_type, "uid": int(item_stat.st_uid),
        "gid": int(item_stat.st_gid), "mode": stat.S_IMODE(item_stat.st_mode),
        "readable": os.access(path, os.R_OK), "writable": os.access(path, os.W_OK),
    })
    if object_type == "symlink":
        with contextlib.suppress(OSError):
            value["symlink_target"] = os.readlink(path)[:1024]
    with contextlib.suppress(OSError):
        value["resolved"] = str(path.resolve(strict=True))
    return value


#@MNX-PART id=90.00.monsterdesk.function.f023i-parse-nicotine-config kind=function title="Python function parse_nicotine_config"
def parse_nicotine_config(raw: bytes, *, data_path: Path) -> dict[str, Any]:
    try:
        text = raw.decode("utf-8", errors="strict")
    except UnicodeDecodeError as exc:
        raise MonsterdeskError(f"Nicotine config is not strict UTF-8: {exc}") from exc
    parser = configparser.ConfigParser(
        strict=False, interpolation=None, delimiters=("=",), comment_prefixes=None
    )
    try:
        parser.read_file(io.StringIO(text))
    except configparser.Error as exc:
        raise MonsterdeskError(f"Nicotine config parse failed: {exc}") from exc

    #@MNX-PART id=90.00.monsterdesk.function.f023i1-option kind=function title="Python function option"
    def option(section: str, name: str, default: Any) -> Any:
        if not parser.has_option(section, name):
            return default
        value = parser.get(section, name, raw=True)
        if isinstance(default, str):
            return value
        try:
            return ast.literal_eval(value)
        except (SyntaxError, ValueError):
            return default

    port_range = option("server", "portrange", (2234, 2234))
    if (not isinstance(port_range, (tuple, list)) or len(port_range) != 2
            or not all(type(item) is int and 1 <= item <= 65535 for item in port_range)):
        raise MonsterdeskError("Nicotine configured port range is invalid")
    low_port, high_port = int(port_range[0]), int(port_range[1])
    if low_port > high_port:
        raise MonsterdeskError("Nicotine configured port range is reversed")
    server = option("server", "server", ("server.slsknet.org", 2242))
    if (isinstance(server, (tuple, list)) and len(server) == 2
            and isinstance(server[0], str) and type(server[1]) is int
            and 1 <= server[1] <= 65535):
        server_value: dict[str, Any] = {"host": server[0][:255], "port": int(server[1])}
    else:
        server_value = {"state": "invalid"}
    paths: list[dict[str, Any]] = []
    for name, kind in (
        ("shared", "public-share"), ("buddyshared", "buddy-share"),
        ("trustedshared", "trusted-share"),
    ):
        entries = option("transfers", name, [])
        if not isinstance(entries, list):
            raise MonsterdeskError(f"Nicotine {name} is not a list")
        for entry in entries:
            if len(paths) >= MAX_NICOTINE_PATHS:
                raise MonsterdeskError("Nicotine path count exceeds policy")
            if (not isinstance(entry, (tuple, list)) or len(entry) != 2
                    or not all(isinstance(item, str) for item in entry)):
                raise MonsterdeskError(f"Nicotine {name} entry is invalid")
            paths.append(nicotine_path_metadata(
                entry[1], kind, data_path=data_path, virtual_name=entry[0]
            ))
    for name, kind in (
        ("incompletedir", "incomplete-dir"), ("downloaddir", "download-dir"),
        ("uploaddir", "received-dir"),
    ):
        value = option("transfers", name, "")
        if isinstance(value, str) and value:
            if len(paths) >= MAX_NICOTINE_PATHS:
                raise MonsterdeskError("Nicotine path count exceeds policy")
            paths.append(nicotine_path_metadata(value, kind, data_path=data_path))
    return {
        "server": server_value, "listen_port_range": [low_port, high_port],
        "interface": str(option("server", "interface", ""))[:256],
        "upnp": bool(option("server", "upnp", True)),
        "auto_connect_startup": bool(option("server", "auto_connect_startup", True)),
        "paths": paths,
        "share_count": sum(1 for item in paths if item["kind"].endswith("share")),
    }


#@MNX-PART id=90.00.monsterdesk.function.f023j-nicotine-launcher-inventory kind=function title="Python function nicotine_launcher_inventory"
def nicotine_launcher_inventory(home: Path, roots: list[Path] | None = None) -> list[dict[str, Any]]:
    selected_roots = roots if roots is not None else [
        Path("/run/current-system/sw/share/applications"),
        home / ".local/share/applications", home / ".config/autostart",
    ]
    launchers: list[dict[str, Any]] = []
    home_root = home.expanduser().resolve(strict=False)
    store_root = Path("/nix/store")
    for source_root in selected_roots:
        try:
            source_stat = source_root.lstat()
        except OSError:
            continue
        scan_root = source_root
        followed_root_symlink = False
        if stat.S_ISLNK(source_stat.st_mode):
            try:
                scan_root = source_root.resolve(strict=True)
            except OSError:
                continue
            followed_root_symlink = True
            if not (scan_root == store_root or scan_root.is_relative_to(store_root)
                    or scan_root == home_root or scan_root.is_relative_to(home_root)):
                continue
        if not scan_root.is_dir():
            continue
        for path in sorted(scan_root.rglob("*.desktop")):
            if len(launchers) >= MAX_NICOTINE_LAUNCHERS:
                return launchers
            try:
                relative = path.relative_to(scan_root)
                if len(relative.parts) > 4:
                    continue
                item_stat = path.lstat()
                if stat.S_ISLNK(item_stat.st_mode) or not stat.S_ISREG(item_stat.st_mode):
                    continue
                if item_stat.st_size > 512 * 1024:
                    continue
                text = path.read_text(encoding="utf-8", errors="strict")
            except (OSError, UnicodeError):
                continue
            if "nicotine" not in text.lower():
                continue
            fields: dict[str, str] = {}
            for line in text.splitlines():
                if "=" not in line:
                    continue
                key, value = line.split("=", 1)
                if key in {"Name", "Exec", "TryExec", "Hidden"} and key not in fields:
                    fields[key] = value[:1024]
            if "Exec" in fields:
                launchers.append({
                    "path": str(path), "source_root": str(source_root),
                    "resolved_root": str(scan_root), "followed_root_symlink": followed_root_symlink,
                    "uid": int(item_stat.st_uid), "mode": stat.S_IMODE(item_stat.st_mode),
                    "fields": fields,
                })
    return launchers


#@MNX-PART id=90.00.monsterdesk.function.f023k-inspect-nicotine-boundary kind=function title="Python function inspect_nicotine_boundary"
def inspect_nicotine_boundary(home: Path = USER_HOME, *, expected_uid: int = USER_UID,
                              include_runtime: bool = True,
                              launcher_roots: list[Path] | None = None) -> dict[str, Any]:
    processes = nicotine_process_inventory(expected_uid=expected_uid, include_runtime=include_runtime)
    layout = nicotine_layout(home, processes)
    raw, config_metadata = stable_regular_read(
        layout["config_path"], MAX_NICOTINE_CONFIG_BYTES, expected_uid=expected_uid
    )
    configured = parse_nicotine_config(raw, data_path=layout["data_path"])
    local_endpoints: dict[tuple[Any, ...], dict[str, Any]] = {}
    for process in processes:
        for endpoint in process.get("local_endpoints", []):
            key = (endpoint["protocol"], endpoint["address"], endpoint["port"], endpoint["state"], endpoint["kind"])
            local_endpoints[key] = endpoint
    low_port, high_port = configured["listen_port_range"]
    relevant_endpoints = [local_endpoints[key] for key in sorted(local_endpoints)]
    configured_port_bound = any(
        item["kind"] in {"listen", "bound"} and low_port <= int(item["port"]) <= high_port
        for item in relevant_endpoints
    ) if processes else None
    executable = shutil.which("nicotine")
    wrapper: dict[str, Any] = {
        "path_resolution": executable or "unavailable",
        "candidates": [],
    }
    for candidate in (
        Path("/run/wrappers/bin/nicotine"),
        Path("/run/current-system/sw/bin/nicotine"),
        NICOTINE_LEGACY,
    ):
        try:
            candidate_stat = candidate.lstat()
        except OSError:
            wrapper["candidates"].append({"path": str(candidate), "present": False})
            continue
        candidate_value: dict[str, Any] = {
            "path": str(candidate), "present": True, "uid": int(candidate_stat.st_uid),
            "gid": int(candidate_stat.st_gid), "mode": stat.S_IMODE(candidate_stat.st_mode),
            "object_type": "symlink" if stat.S_ISLNK(candidate_stat.st_mode) else (
                "regular" if stat.S_ISREG(candidate_stat.st_mode) else "other"
            ),
        }
        with contextlib.suppress(OSError):
            resolved = candidate.resolve(strict=True)
            candidate_value["resolved"] = str(resolved)
            resolved_stat = resolved.stat()
            if (candidate == Path("/run/current-system/sw/bin/nicotine")
                    and stat.S_ISREG(resolved_stat.st_mode)
                    and 0 < resolved_stat.st_size <= 65_536):
                launcher_bytes = resolved.read_bytes()
                candidate_value["source_owned_nicotine_launcher"] = (
                    b"/run/current-system/sw/bin/monsterdesk nicotine-live" in launcher_bytes
                )
                candidate_value["launcher_bytes"] = len(launcher_bytes)
                candidate_value["launcher_sha256"] = hashlib.sha256(launcher_bytes).hexdigest()
            if candidate == NICOTINE_LEGACY:
                candidate_value["source_owned_direct_legacy_binary"] = (
                    resolved == NICOTINE.resolve(strict=True)
                    and stat.S_ISREG(resolved_stat.st_mode)
                    and os.access(resolved, os.X_OK)
                )
                candidate_value["firejail_used"] = False
        wrapper["candidates"].append(candidate_value)
    report: dict[str, Any] = {
        "schema": "mnx.nicotine.preflight.v2",
        "authority": "candidate-owned-mnx-test-read-only",
        "network_api_or_tool_invoked": False,
        "router_probe_performed": False,
        "host_state_mutated": False,
        "live_application_stopped": False,
        "share_contents_read": False,
        "config_secret_values_exported": False,
        "layout": {
            "config_path": str(layout["config_path"]), "data_path": str(layout["data_path"]),
            "selection": layout["selection"],
            "legacy_directory_present": layout["legacy_directory_present"],
        },
        "config": config_metadata,
        "configured": configured,
        "live": {
            "process_count": len(processes), "processes": processes,
            "local_endpoints": relevant_endpoints,
            "configured_port_bound": configured_port_bound,
            "host_network_namespace": os.readlink("/proc/self/ns/net"),
        },
        "launchers": nicotine_launcher_inventory(home, launcher_roots),
        "wrapper": wrapper,
        "limitations": [
            "router mapping not probed", "peer remote endpoints omitted",
            "share contents not read", "live application not stopped",
        ],
    }
    if len(canonical(report).encode("utf-8")) > MAX_NICOTINE_REPORT_BYTES:
        raise MonsterdeskError("Nicotine preflight report exceeds byte policy")
    return report



#@MNX-PART id=90.00.monsterdesk.function.f023k1-qbittorrent-process-match kind=function title="Python function qbittorrent_process_command_matches"
def qbittorrent_process_command_matches(comm: str, executable: str, arguments: list[str]) -> bool:
    comm_name = comm.strip().lower()
    executable_name = Path(executable).name.lower()
    argument_names = [Path(value).name.lower() for value in arguments[:6]]
    accepted = {"qbittorrent", "qbittorrent-nox", ".qbittorrent-wrapped", ".qbittorrent-wrapped-wrapped"}
    return (
        comm_name in accepted
        or comm_name.startswith(".qbittorrent")
        or executable_name in accepted
        or executable_name.startswith(".qbittorrent-wrapped")
        or any(name in accepted or name.startswith(".qbittorrent-wrapped") for name in argument_names)
    )


#@MNX-PART id=90.00.monsterdesk.function.f023k2-qbittorrent-app-arguments kind=function title="Python function qbittorrent_application_arguments"
def qbittorrent_application_arguments(arguments: list[str]) -> list[str]:
    accepted = {"qbittorrent", "qbittorrent-nox", ".qbittorrent-wrapped", ".qbittorrent-wrapped-wrapped"}
    for index, value in enumerate(arguments[:12]):
        name = Path(value).name.lower()
        if name in accepted or name.startswith(".qbittorrent-wrapped"):
            return arguments[index + 1:]
    return []


#@MNX-PART id=90.00.monsterdesk.function.f023k2a-qbittorrent-profile-options kind=function title="Python function qbittorrent_profile_option_values"
def qbittorrent_profile_option_values(arguments: list[str]) -> list[str]:
    values: list[str] = []
    application_arguments = qbittorrent_application_arguments(arguments)
    for index, value in enumerate(application_arguments):
        if value == "--profile" and index + 1 < len(application_arguments):
            values.append(application_arguments[index + 1][:1024])
        elif value.startswith("--profile="):
            values.append(value.split("=", 1)[1][:1024])
    return values[:8]


#@MNX-PART id=90.00.monsterdesk.function.f023k2b-qbittorrent-argument-shape kind=function title="Python function qbittorrent_argument_shape"
def qbittorrent_argument_shape(arguments: list[str]) -> list[str]:
    application_arguments = qbittorrent_application_arguments(arguments)
    shape: list[str] = []
    value_options = {"--profile", "--configuration", "--webui-port", "--torrenting-port"}
    index = 0
    while index < len(application_arguments) and len(shape) < 24:
        value = application_arguments[index]
        if value in value_options:
            shape.append(value + "=<redacted>")
            index += 2
            continue
        if value.startswith("--"):
            option = value.split("=", 1)[0]
            shape.append(option + ("=<redacted>" if "=" in value else ""))
        elif value.startswith("-"):
            shape.append(value[:128])
        else:
            shape.append("<redacted-positional>")
        index += 1
    return shape


#@MNX-PART id=90.00.monsterdesk.function.f023k3-qbittorrent-process-inventory kind=function title="Python function qbittorrent_process_inventory"
def qbittorrent_process_inventory(*, expected_uid: int = USER_UID, include_runtime: bool = True) -> list[dict[str, Any]]:
    if not include_runtime:
        return []
    processes: list[dict[str, Any]] = []
    host_netns = os.readlink("/proc/self/ns/net")
    for entry in sorted(Path("/proc").iterdir(), key=lambda item: int(item.name) if item.name.isdigit() else 10**12):
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        try:
            identity = process_identity(pid)
        except (OSError, ValueError, MonsterdeskError):
            continue
        if identity["uid_set"] != [expected_uid, expected_uid, expected_uid, expected_uid]:
            continue
        if identity["state"] == "Z":
            continue
        comm = proc_bytes(entry / "comm", 4096).decode("utf-8", errors="replace").strip()
        raw_command = proc_bytes(entry / "cmdline", 65536)
        arguments = [item.decode("utf-8", errors="replace")[:512]
                     for item in raw_command.split(b"\0") if item][:24]
        try:
            executable = os.readlink(entry / "exe")
        except OSError:
            executable = "unavailable"
        if not qbittorrent_process_command_matches(comm, executable, arguments):
            continue
        start_ticks = int(identity["start_ticks"])
        if not process_matches(pid, start_ticks):
            continue
        environment: dict[str, str] = {}
        for item in proc_bytes(entry / "environ", 131072).split(b"\0"):
            if b"=" not in item:
                continue
            key_raw, value_raw = item.split(b"=", 1)
            key = key_raw.decode("ascii", errors="ignore")
            if key in {
                "HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "DISPLAY", "WAYLAND_DISPLAY",
                "DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR",
            }:
                environment[key] = value_raw.decode("utf-8", errors="replace")[:1024]
        namespaces: dict[str, str] = {}
        for name in ("net", "mnt", "pid", "user", "ipc", "uts"):
            try:
                namespaces[name] = os.readlink(entry / "ns" / name)
            except OSError:
                namespaces[name] = "unavailable"
        endpoints = process_socket_endpoints(entry)[:MAX_QBITTORRENT_ENDPOINTS]
        profile_values = qbittorrent_profile_option_values(arguments)
        processes.append({
            "pid": pid, "start_ticks": start_ticks, "comm": comm, "executable": executable,
            "argument_shape": qbittorrent_argument_shape(arguments),
            "raw_argument_values_exported": False,
            "profile_option_count": len(profile_values),
            "profile_option_absolute_count": sum(Path(value).expanduser().is_absolute() for value in profile_values),
            "profile_option_values_sha256": hashlib.sha256(canonical(sorted(profile_values)).encode("utf-8")).hexdigest(),
            "environment": environment, "namespaces": namespaces,
            "host_network_namespace": namespaces.get("net") == host_netns,
            "cgroup": proc_bytes(entry / "cgroup", 8192).decode("utf-8", errors="replace").strip()[:2048],
            "local_endpoints": endpoints,
        })
        if len(processes) >= MAX_QBITTORRENT_PROCESSES:
            break
    return processes


#@MNX-PART id=90.00.monsterdesk.function.f023k4-qbittorrent-layout kind=function title="Python function qbittorrent_layout"
def qbittorrent_layout(home: Path, processes: list[dict[str, Any]]) -> dict[str, Any]:
    selected_home = home.expanduser()
    if not selected_home.is_absolute():
        raise MonsterdeskError(f"qBittorrent home is not absolute: {selected_home}")
    config_roots: set[str] = set()
    data_roots: set[str] = set()
    profile_option_count = 0
    profile_option_absolute_count = 0
    profile_option_hashes: set[str] = set()
    for process in processes:
        environment = process.get("environment", {})
        if environment.get("XDG_CONFIG_HOME"):
            config_roots.add(str(environment["XDG_CONFIG_HOME"]).split(":", 1)[0])
        if environment.get("XDG_DATA_HOME"):
            data_roots.add(str(environment["XDG_DATA_HOME"]).split(":", 1)[0])
        profile_option_count += int(process.get("profile_option_count", 0))
        profile_option_absolute_count += int(process.get("profile_option_absolute_count", 0))
        if process.get("profile_option_count"):
            profile_option_hashes.add(str(process.get("profile_option_values_sha256", "")))
    ambiguous_roots = len(config_roots) > 1 or len(data_roots) > 1
    config_root = Path(next(iter(config_roots))).expanduser() if len(config_roots) == 1 else selected_home / ".config"
    data_root = Path(next(iter(data_roots))).expanduser() if len(data_roots) == 1 else selected_home / ".local/share"
    if not config_root.is_absolute():
        config_root = selected_home / ".config"
        ambiguous_roots = True
    if not data_root.is_absolute():
        data_root = selected_home / ".local/share"
        ambiguous_roots = True
    return {
        "config_path": config_root / "qBittorrent" / "qBittorrent.conf",
        "data_path": data_root / "qBittorrent",
        "selection": "live-xdg-default" if processes and not ambiguous_roots else "home-xdg-default",
        "profile_option_count": profile_option_count,
        "profile_option_absolute_count": profile_option_absolute_count,
        "profile_option_values_sha256": sorted(profile_option_hashes),
        "profile_option_values_exported": False,
        "profile_option_semantics_resolved": profile_option_count == 0,
        "ambiguous_live_xdg_roots": ambiguous_roots,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023k5-qbittorrent-path-metadata kind=function title="Python function qbittorrent_path_metadata"
def qbittorrent_path_metadata(path_value: str, kind: str) -> dict[str, Any]:
    value = path_value.strip()
    if "\0" in value:
        raise MonsterdeskError("NUL in qBittorrent path")
    path = Path(value).expanduser()
    result: dict[str, Any] = {"kind": kind, "path": str(path), "absolute": path.is_absolute()}
    if not path.is_absolute():
        result.update({"exists": None, "object_type": "relative-unresolved"})
        return result
    try:
        item_stat = path.lstat()
    except FileNotFoundError:
        result.update({"exists": False, "object_type": "missing"})
        return result
    if stat.S_ISLNK(item_stat.st_mode):
        object_type = "symlink"
    elif stat.S_ISDIR(item_stat.st_mode):
        object_type = "directory"
    elif stat.S_ISREG(item_stat.st_mode):
        object_type = "regular"
    else:
        object_type = "special"
    result.update({
        "exists": True, "object_type": object_type, "uid": int(item_stat.st_uid),
        "gid": int(item_stat.st_gid), "mode": stat.S_IMODE(item_stat.st_mode),
        "readable": os.access(path, os.R_OK), "writable": os.access(path, os.W_OK),
    })
    with contextlib.suppress(OSError):
        result["resolved"] = str(path.resolve(strict=True))
    return result


#@MNX-PART id=90.00.monsterdesk.function.f023k6-qbittorrent-config-value kind=function title="Python function qbittorrent_config_value"
def qbittorrent_config_value(parser: configparser.ConfigParser,
                              candidates: tuple[tuple[str, str], ...]) -> tuple[str | None, str | None]:
    sections = {section.lower(): section for section in parser.sections()}
    for requested_section, requested_option in candidates:
        section = sections.get(requested_section.lower())
        if section is None:
            continue
        options = {option.lower(): option for option in parser.options(section)}
        option = options.get(requested_option.lower())
        if option is not None:
            return parser.get(section, option, raw=True), f"{section}/{option}"
    return None, None


#@MNX-PART id=90.00.monsterdesk.function.f023k7-qbittorrent-bool kind=function title="Python function qbittorrent_bool_value"
def qbittorrent_bool_value(value: str | None) -> bool | None:
    if value is None:
        return None
    normalized = value.strip().lower()
    if normalized in {"1", "true", "yes", "on"}:
        return True
    if normalized in {"0", "false", "no", "off"}:
        return False
    return None


#@MNX-PART id=90.00.monsterdesk.function.f023k8-qbittorrent-int kind=function title="Python function qbittorrent_int_value"
def qbittorrent_int_value(value: str | None, minimum: int, maximum: int) -> int | None:
    if value is None:
        return None
    try:
        parsed = int(value.strip(), 10)
    except ValueError:
        return None
    return parsed if minimum <= parsed <= maximum else None


#@MNX-PART id=90.00.monsterdesk.function.f023k9-parse-qbittorrent-config kind=function title="Python function parse_qbittorrent_config"
def parse_qbittorrent_config(raw: bytes) -> dict[str, Any]:
    try:
        text_value = raw.decode("utf-8", errors="strict")
    except UnicodeDecodeError as exc:
        raise MonsterdeskError("qBittorrent configuration is not strict UTF-8") from exc
    parser = configparser.ConfigParser(strict=False, interpolation=None, delimiters=("=",),
                                       comment_prefixes=("#", ";"), inline_comment_prefixes=None)
    parser.optionxform = str
    try:
        parser.read_string(text_value)
    except configparser.Error as exc:
        raise MonsterdeskError("qBittorrent configuration is not valid bounded INI") from exc
    option_specs: dict[str, tuple[tuple[str, str], ...]] = {
        "listen_port": (("BitTorrent", r"Session\Port"), ("Preferences", r"Connection\PortRangeMin")),
        "interface_name": (("BitTorrent", r"Session\InterfaceName"), ("Preferences", r"Connection\InterfaceName")),
        "interface_address": (("BitTorrent", r"Session\Interface"), ("Preferences", r"Connection\Interface")),
        "port_forwarding": (("BitTorrent", r"Session\PortForwardingEnabled"), ("Preferences", r"Connection\UPnP")),
        "random_port": (("BitTorrent", r"Session\UseRandomPort"), ("Preferences", r"Connection\RandomPort")),
        "save_path": (("BitTorrent", r"Session\DefaultSavePath"), ("Preferences", r"Downloads\SavePath")),
        "temp_path": (("BitTorrent", r"Session\TempPath"), ("Preferences", r"Downloads\TempPath")),
        "temp_enabled": (("BitTorrent", r"Session\TempPathEnabled"), ("Preferences", r"Downloads\TempPathEnabled")),
        "torrent_export": (("BitTorrent", r"Session\TorrentExportDirectory"), ("Preferences", r"Downloads\TorrentExportDir")),
        "finished_export": (("BitTorrent", r"Session\FinishedTorrentExportDirectory"), ("Preferences", r"Downloads\FinishedTorrentExportDir")),
        "dht": (("BitTorrent", r"Session\DHTEnabled"), ("Preferences", r"Bittorrent\DHT")),
        "pex": (("BitTorrent", r"Session\PeXEnabled"), ("Preferences", r"Bittorrent\PeX")),
        "lsd": (("BitTorrent", r"Session\LSDEnabled"), ("Preferences", r"Bittorrent\LSD")),
        "anonymous": (("BitTorrent", r"Session\AnonymousModeEnabled"), ("Preferences", r"Bittorrent\AnonymousMode")),
        "encryption": (("BitTorrent", r"Session\Encryption"), ("Preferences", r"Bittorrent\Encryption")),
        "webui_enabled": (("Preferences", r"WebUI\Enabled"),),
        "webui_address": (("Preferences", r"WebUI\Address"),),
        "webui_port": (("Preferences", r"WebUI\Port"),),
        "startup_window_state": (("GUI", r"StartUpWindowState"),),
        "ui_locked": (("Locking", r"locked"),),
        "proxy_type": (("Preferences", r"Proxy\Type"),),
        "proxy_auth": (("Preferences", r"Proxy\Authentication"),),
        "proxy_peers": (("Preferences", r"Proxy\PeerConnections"),),
    }
    values: dict[str, str | None] = {}
    matched_options: dict[str, str] = {}
    for label, candidates in option_specs.items():
        value, matched = qbittorrent_config_value(parser, candidates)
        values[label] = value
        if matched is not None:
            matched_options[label] = matched
    path_values = (
        ("save-path", values["save_path"]),
        ("temporary-path", values["temp_path"] if qbittorrent_bool_value(values["temp_enabled"]) is not False else None),
        ("torrent-export-path", values["torrent_export"]),
        ("finished-torrent-export-path", values["finished_export"]),
    )
    paths = [qbittorrent_path_metadata(value, kind) for kind, value in path_values if value and value.strip()]
    total_option_count = sum(len(parser.options(section)) for section in parser.sections())
    secret_fragments = ("password", "username", "cookie", "token", "rss", "search", "tracker")
    secret_like_option_count = sum(
        1 for section in parser.sections() for option in parser.options(section)
        if any(fragment in option.lower() for fragment in secret_fragments)
    )
    return {
        "state": "parsed",
        "listen_port": qbittorrent_int_value(values["listen_port"], 1, 65535),
        "interface_name": values["interface_name"][:256] if values["interface_name"] else "",
        "interface_address": values["interface_address"][:256] if values["interface_address"] else "",
        "port_forwarding_enabled": qbittorrent_bool_value(values["port_forwarding"]),
        "random_port_on_start": qbittorrent_bool_value(values["random_port"]),
        "dht_enabled": qbittorrent_bool_value(values["dht"]),
        "pex_enabled": qbittorrent_bool_value(values["pex"]),
        "lsd_enabled": qbittorrent_bool_value(values["lsd"]),
        "anonymous_mode": qbittorrent_bool_value(values["anonymous"]),
        "encryption_mode": values["encryption"][:64] if values["encryption"] else None,
        "startup_window_state": (values["startup_window_state"][:64]
                                 if values["startup_window_state"] else None),
        "ui_locked": qbittorrent_bool_value(values["ui_locked"]),
        "web_ui": {
            "enabled": qbittorrent_bool_value(values["webui_enabled"]),
            "address": values["webui_address"][:256] if values["webui_address"] else None,
            "port": qbittorrent_int_value(values["webui_port"], 1, 65535),
            "credential_values_exported": False,
        },
        "proxy": {
            "type": values["proxy_type"][:64] if values["proxy_type"] else None,
            "authentication_enabled": qbittorrent_bool_value(values["proxy_auth"]),
            "peer_connections_proxied": qbittorrent_bool_value(values["proxy_peers"]),
            "address_exported": False,
            "credential_values_exported": False,
        },
        "paths": paths[:16],
        "matched_options": matched_options,
        "total_option_count": total_option_count,
        "secret_like_option_count": secret_like_option_count,
        "raw_config_exported": False,
        "torrent_resume_data_read": False,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023k9a-qbittorrent-desktop-exec-summary kind=function title="Python function qbittorrent_desktop_exec_summary"
def qbittorrent_desktop_exec_summary(value: str) -> dict[str, Any]:
    try:
        tokens = shlex.split(value, posix=True)
    except ValueError:
        tokens = []
    option_names = sorted({token.split("=", 1)[0][:128] for token in tokens if token.startswith("-")})[:32]
    field_code_count = sum(1 for token in tokens if re.fullmatch(r"%[A-Za-z%]", token))
    positional_count = sum(1 for token in tokens[1:] if not token.startswith("-") and not re.fullmatch(r"%[A-Za-z%]", token))
    return {
        "sha256": hashlib.sha256(value.encode("utf-8")).hexdigest(),
        "token_count": len(tokens),
        "executable_basename": Path(tokens[0]).name[:256] if tokens else None,
        "option_names": option_names,
        "field_code_count": field_code_count,
        "positional_value_count": positional_count,
        "raw_exec_exported": False,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023ka-qbittorrent-launchers kind=function title="Python function qbittorrent_launcher_inventory"
def qbittorrent_launcher_inventory(home: Path = USER_HOME) -> list[dict[str, Any]]:
    launchers: list[dict[str, Any]] = []
    exact_candidates = (
        Path("/run/wrappers/bin/qbittorrent"),
        Path("/run/current-system/sw/bin/qbittorrent"),
        QBITTORRENT,
    )
    for candidate in exact_candidates:
        if len(launchers) >= MAX_QBITTORRENT_LAUNCHERS:
            break
        try:
            item_stat = candidate.lstat()
        except OSError:
            launchers.append({"path": str(candidate), "present": False})
            continue
        item: dict[str, Any] = {
            "path": str(candidate), "present": True, "uid": int(item_stat.st_uid),
            "gid": int(item_stat.st_gid), "mode": stat.S_IMODE(item_stat.st_mode),
            "object_type": "symlink" if stat.S_ISLNK(item_stat.st_mode) else (
                "regular" if stat.S_ISREG(item_stat.st_mode) else "other"
            ),
        }
        with contextlib.suppress(OSError):
            resolved = candidate.resolve(strict=True)
            item["resolved"] = str(resolved)
            resolved_stat = resolved.stat()
            if stat.S_ISREG(resolved_stat.st_mode) and 0 < resolved_stat.st_size <= 65_536:
                payload = resolved.read_bytes()
                item["launcher_bytes"] = len(payload)
                item["launcher_sha256"] = hashlib.sha256(payload).hexdigest()
                item["firejail_reference_present"] = b"firejail" in payload.lower()
        launchers.append(item)
    desktop_roots = (
        home / ".local/share/applications",
        Path("/run/current-system/sw/share/applications"),
    )
    for root in desktop_roots:
        if len(launchers) >= MAX_QBITTORRENT_LAUNCHERS or not root.is_dir():
            continue
        for path in sorted(root.rglob("*.desktop")):
            if len(launchers) >= MAX_QBITTORRENT_LAUNCHERS:
                break
            try:
                relative = path.relative_to(root)
                if len(relative.parts) > 4:
                    continue
                item_stat = path.lstat()
                if stat.S_ISLNK(item_stat.st_mode) or not stat.S_ISREG(item_stat.st_mode) or item_stat.st_size > 512 * 1024:
                    continue
                payload = path.read_text(encoding="utf-8", errors="strict")
            except (OSError, UnicodeError):
                continue
            if "qbittorrent" not in payload.lower():
                continue
            fields: dict[str, str] = {}
            for line in payload.splitlines():
                if "=" not in line:
                    continue
                key, value = line.split("=", 1)
                if key in {"Name", "Exec", "TryExec", "Hidden"} and key not in fields:
                    fields[key] = value[:4096]
            launchers.append({
                "path": str(path), "source_root": str(root), "uid": int(item_stat.st_uid),
                "gid": int(item_stat.st_gid), "mode": stat.S_IMODE(item_stat.st_mode),
                "name_present": bool(fields.get("Name")),
                "name_sha256": hashlib.sha256(fields.get("Name", "").encode("utf-8")).hexdigest(),
                "try_exec_basename": Path(fields.get("TryExec", "")).name[:256] or None,
                "hidden": qbittorrent_bool_value(fields.get("Hidden")),
                "exec_summary": qbittorrent_desktop_exec_summary(fields.get("Exec", "")),
                "raw_desktop_fields_exported": False,
            })
    return launchers


#@MNX-PART id=90.00.monsterdesk.function.f023kb-inspect-qbittorrent kind=function title="Python function inspect_qbittorrent_boundary"
def inspect_qbittorrent_boundary(home: Path = USER_HOME, *, expected_uid: int = USER_UID,
                                  include_runtime: bool = True) -> dict[str, Any]:
    processes = qbittorrent_process_inventory(expected_uid=expected_uid, include_runtime=include_runtime)
    layout = qbittorrent_layout(home, processes)
    config_path = Path(layout["config_path"])
    configured: dict[str, Any]
    config_metadata: dict[str, Any]
    try:
        config_lstat = config_path.lstat()
    except FileNotFoundError:
        config_metadata = {"path": str(config_path), "state": "absent"}
        configured = {"state": "absent", "paths": [], "raw_config_exported": False,
                      "torrent_resume_data_read": False}
    else:
        if stat.S_ISLNK(config_lstat.st_mode) or not stat.S_ISREG(config_lstat.st_mode):
            raise MonsterdeskError("qBittorrent configuration path is not a real regular file")
        raw, config_metadata = stable_regular_read(
            config_path, MAX_QBITTORRENT_CONFIG_BYTES, expected_uid=expected_uid
        )
        try:
            configured = parse_qbittorrent_config(raw)
        except MonsterdeskError:
            configured = {
                "state": "unparsed", "reason": "invalid-ini-or-encoding",
                "paths": [], "raw_config_exported": False, "torrent_resume_data_read": False,
            }
    local_endpoints: dict[tuple[Any, ...], dict[str, Any]] = {}
    for process in processes:
        for endpoint in process.get("local_endpoints", []):
            key = (endpoint["protocol"], endpoint["address"], endpoint["port"], endpoint["state"], endpoint["kind"])
            local_endpoints[key] = endpoint
    endpoints = [local_endpoints[key] for key in sorted(local_endpoints)[:MAX_QBITTORRENT_ENDPOINTS]]
    listen_port = configured.get("listen_port")
    configured_port_bound = (
        any(item["kind"] in {"listen", "bound"} and int(item["port"]) == int(listen_port)
            for item in endpoints)
        if processes and isinstance(listen_port, int) else None
    )
    blockers: list[str] = []
    advisories: list[str] = []
    if configured.get("state") != "parsed":
        blockers.append("configuration-not-parsed")
    if layout.get("profile_option_semantics_resolved") is not True:
        blockers.append("live-profile-option-semantics-unresolved")
    if layout.get("ambiguous_live_xdg_roots") is True:
        blockers.append("live-xdg-roots-ambiguous")
    if len(processes) > 1:
        blockers.append("multiple-live-qbittorrent-processes")
    if configured.get("state") == "parsed" and not isinstance(listen_port, int):
        blockers.append("listening-port-unknown")
    if processes:
        advisories.append("live-host-network-client-observed")
    if configured.get("port_forwarding_enabled") is True:
        advisories.append("in-application-port-forwarding-enabled")
    if configured.get("random_port_on_start") is True:
        advisories.append("random-port-on-start-enabled")
    if configured.get("web_ui", {}).get("enabled") is True:
        advisories.append("web-ui-enabled")
    if config_metadata.get("mode") not in {None, 0o600}:
        advisories.append("credential-bearing-config-not-mode-0600")
    report: dict[str, Any] = {
        "schema": "mnx.qbittorrent.preflight.v1",
        "authority": "candidate-owned-mnx-test-read-only",
        "standing_p2p_security_authority_recorded": True,
        "network_api_or_tool_invoked": False,
        "router_probe_performed": False,
        "external_reachability_probed": False,
        "host_state_mutated": False,
        "live_application_stopped": False,
        "launcher_changed": False,
        "firewall_changed": False,
        "router_state_mutated": False,
        "torrent_resume_data_read": False,
        "payload_contents_read": False,
        "remote_peer_endpoints_exported": False,
        "config_secret_values_exported": False,
        "layout": {
            "config_path": str(layout["config_path"]), "data_path": str(layout["data_path"]),
            "selection": layout["selection"],
            "profile_option_count": layout["profile_option_count"],
            "profile_option_absolute_count": layout["profile_option_absolute_count"],
            "profile_option_values_sha256": layout["profile_option_values_sha256"],
            "profile_option_values_exported": False,
            "profile_option_semantics_resolved": layout["profile_option_semantics_resolved"],
            "ambiguous_live_xdg_roots": layout["ambiguous_live_xdg_roots"],
        },
        "config": config_metadata,
        "configured": configured,
        "data_path": qbittorrent_path_metadata(str(layout["data_path"]), "application-data-root"),
        "live": {
            "process_count": len(processes), "processes": processes,
            "local_endpoints": endpoints, "configured_port_bound": configured_port_bound,
            "host_network_namespace": os.readlink("/proc/self/ns/net"),
        },
        "launchers": qbittorrent_launcher_inventory(home),
        "migration": {
            "cutover_executed": False,
            "ready_for_transaction_design": not blockers,
            "blockers": blockers,
            "advisories": advisories,
            "next_authority": "future-complete-source-rollback-tested-candidate",
        },
        "limitations": [
            "router mapping not probed", "public reachability not probed",
            "remote peer endpoints omitted", "torrent and resume databases not read",
            "payload contents not read", "live application not stopped",
            "custom --profile semantics recorded but not guessed",
        ],
    }
    if len(canonical(report).encode("utf-8")) > MAX_QBITTORRENT_REPORT_BYTES:
        raise MonsterdeskError("qBittorrent preflight report exceeds byte policy")
    return report


#@MNX-PART id=90.00.monsterdesk.function.f023kc-qbittorrent-effective-features kind=function title="Python function qbittorrent_effective_features"
def qbittorrent_effective_features(configured: dict[str, Any]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, default_value in QBITTORRENT_SOURCE_DEFAULT_FEATURES.items():
        configured_value = configured.get(key)
        if isinstance(configured_value, bool):
            result[key] = {
                "effective": configured_value,
                "origin": "explicit-config",
                "configured_value": configured_value,
            }
        else:
            result[key] = {
                "effective": default_value,
                "origin": "qbittorrent-5.1.4-source-default",
                "configured_value": None,
            }
    return result


#@MNX-PART id=90.00.monsterdesk.function.f023kd-qbittorrent-cutover-inputs kind=function title="Python function qbittorrent_cutover_inputs"
def qbittorrent_cutover_inputs(report: dict[str, Any], *, interface_address: str | None = None) -> dict[str, Any]:
    if report.get("schema") != "mnx.qbittorrent.preflight.v1":
        raise MonsterdeskError("qBittorrent preflight schema differs from the Stage115 contract")
    config = report.get("config", {})
    configured = report.get("configured", {})
    layout = report.get("layout", {})
    live = report.get("live", {})
    if configured.get("state") != "parsed":
        raise MonsterdeskError("qBittorrent configuration is not parsed")
    observed_hash = str(config.get("sha256", ""))
    if not re.fullmatch(r"[0-9a-f]{64}", observed_hash):
        raise MonsterdeskError("qBittorrent configuration has no stable SHA-256 identity")
    if int(config.get("uid", -1)) != USER_UID or config.get("stable_read") is not True:
        raise MonsterdeskError("qBittorrent configuration ownership or stable-read evidence differs")
    if Path(str(layout.get("config_path", ""))) != EXPECTED_QBITTORRENT_CONFIG_PATH:
        raise MonsterdeskError("qBittorrent configuration path differs from Stage115 evidence")
    if Path(str(layout.get("data_path", ""))) != EXPECTED_QBITTORRENT_DATA_PATH:
        raise MonsterdeskError("qBittorrent data path differs from Stage115 evidence")
    if layout.get("profile_option_count") != 0 or layout.get("profile_option_semantics_resolved") is not True:
        raise MonsterdeskError("qBittorrent custom profile semantics are no longer empty and exact")
    if configured.get("listen_port") != EXPECTED_QBITTORRENT_LISTEN_PORT:
        raise MonsterdeskError("qBittorrent peer port differs from Stage115 evidence")
    if configured.get("interface_name") != "" or configured.get("interface_address") != "":
        raise MonsterdeskError("qBittorrent source interface policy differs from Stage115 evidence")
    if configured.get("anonymous_mode") is not True:
        raise MonsterdeskError("qBittorrent anonymous-mode policy differs from Stage115 evidence")
    web_ui = configured.get("web_ui", {})
    if (web_ui.get("enabled") is not True
            or web_ui.get("address") != EXPECTED_QBITTORRENT_WEBUI_ADDRESS
            or web_ui.get("port") != EXPECTED_QBITTORRENT_WEBUI_PORT):
        raise MonsterdeskError("qBittorrent WebUI endpoint differs from Stage115 evidence")
    paths = {str(item.get("kind")): item for item in configured.get("paths", [])}
    expected_paths = {
        "save-path": EXPECTED_QBITTORRENT_SAVE_PATH,
        "temporary-path": EXPECTED_QBITTORRENT_TEMP_PATH,
        "finished-torrent-export-path": EXPECTED_QBITTORRENT_FINISHED_EXPORT_PATH,
    }
    if set(paths) != set(expected_paths):
        raise MonsterdeskError(f"qBittorrent configured path kinds differ: {sorted(paths)}")
    for kind, expected_path in expected_paths.items():
        item = paths[kind]
        if (Path(str(item.get("path", ""))) != expected_path
                or item.get("absolute") is not True
                or item.get("exists") is not True
                or item.get("object_type") != "directory"
                or item.get("writable") is not True):
            raise MonsterdeskError(f"qBittorrent path boundary differs for {kind}")
    data_path = report.get("data_path", {})
    if (Path(str(data_path.get("path", ""))) != EXPECTED_QBITTORRENT_DATA_PATH
            or data_path.get("exists") is not True
            or data_path.get("object_type") != "directory"
            or int(data_path.get("uid", -1)) != USER_UID):
        raise MonsterdeskError("qBittorrent application-data root differs from Stage115 evidence")
    processes = live.get("processes", [])
    if len(processes) != 1 or processes[0].get("host_network_namespace") is not True:
        raise MonsterdeskError("expected one live host-network qBittorrent process")
    if live.get("configured_port_bound") is not True:
        raise MonsterdeskError("live qBittorrent no longer binds peer port 1429")
    endpoints = live.get("local_endpoints", [])
    peer_tcp = any(
        item.get("protocol") in {"tcp", "tcp6"}
        and item.get("kind") == "listen"
        and int(item.get("port", 0)) == EXPECTED_QBITTORRENT_LISTEN_PORT
        for item in endpoints
    )
    peer_udp = any(
        item.get("protocol") in {"udp", "udp6"}
        and item.get("kind") == "bound"
        and int(item.get("port", 0)) == EXPECTED_QBITTORRENT_LISTEN_PORT
        for item in endpoints
    )
    webui_tcp = any(
        item.get("protocol") in {"tcp", "tcp6"}
        and item.get("kind") == "listen"
        and int(item.get("port", 0)) == EXPECTED_QBITTORRENT_WEBUI_PORT
        for item in endpoints
    )
    if not peer_tcp or not peer_udp or not webui_tcp:
        raise MonsterdeskError("qBittorrent live TCP, UDP or WebUI listener evidence differs")
    launchers = report.get("launchers", [])
    exact_binary = next((item for item in launchers if item.get("path") == str(QBITTORRENT)), None)
    normal_binary = next((item for item in launchers
                          if item.get("path") == "/run/current-system/sw/bin/qbittorrent"), None)
    if exact_binary is None or normal_binary is None:
        raise MonsterdeskError("qBittorrent exact binary or normal launch surface is missing")
    if any(item.get("firejail_reference_present") is True for item in launchers):
        raise MonsterdeskError("qBittorrent launch surface unexpectedly references Firejail")
    selected_interface_address = interface_address
    if selected_interface_address is None:
        selected_interface_address = interface_ipv4_address(EXPECTED_QBITTORRENT_HOST_INTERFACE)
    if selected_interface_address != EXPECTED_QBITTORRENT_HOST_IPV4:
        raise MonsterdeskError(
            "qBittorrent host interface identity differs: "
            f"observed={selected_interface_address} expected={EXPECTED_QBITTORRENT_HOST_IPV4}"
        )
    nested_export = EXPECTED_QBITTORRENT_FINISHED_EXPORT_PATH.is_relative_to(EXPECTED_QBITTORRENT_SAVE_PATH)
    if not nested_export:
        raise MonsterdeskError("qBittorrent finished-export path is not nested under the save root")
    process = processes[0]
    return {
        "source_config_sha256": observed_hash,
        "accepted_stage115_config_sha256": EXPECTED_QBITTORRENT_STAGE115_CONFIG_SHA256,
        "source_config_sha256_matches_stage115": observed_hash == EXPECTED_QBITTORRENT_STAGE115_CONFIG_SHA256,
        "source_config_mode": int(config.get("mode", 0)),
        "config_path": str(EXPECTED_QBITTORRENT_CONFIG_PATH),
        "data_path": str(EXPECTED_QBITTORRENT_DATA_PATH),
        "peer_port": EXPECTED_QBITTORRENT_LISTEN_PORT,
        "webui_port": EXPECTED_QBITTORRENT_WEBUI_PORT,
        "webui_address_now": EXPECTED_QBITTORRENT_WEBUI_ADDRESS,
        "host_interface": EXPECTED_QBITTORRENT_HOST_INTERFACE,
        "host_interface_ipv4": selected_interface_address,
        "live_pid": int(process.get("pid", 0)),
        "live_start_ticks": int(process.get("start_ticks", 0)),
        "live_host_network_namespace": True,
        "peer_tcp_listener_observed": peer_tcp,
        "peer_udp_listener_observed": peer_udp,
        "webui_tcp_listener_observed": webui_tcp,
        "writable_roots": [str(EXPECTED_QBITTORRENT_SAVE_PATH), str(EXPECTED_QBITTORRENT_TEMP_PATH)],
        "finished_export_path": str(EXPECTED_QBITTORRENT_FINISHED_EXPORT_PATH),
        "finished_export_covered_by_save_root": nested_export,
        "custom_profile_present": False,
        "firejail_used": False,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023ke-qbittorrent-pasta-options kind=function title="Python function qbittorrent_pasta_options"
def qbittorrent_pasta_options(peer_port: int = EXPECTED_QBITTORRENT_LISTEN_PORT,
                               webui_port: int = EXPECTED_QBITTORRENT_WEBUI_PORT) -> list[str]:
    if peer_port != EXPECTED_QBITTORRENT_LISTEN_PORT or webui_port != EXPECTED_QBITTORRENT_WEBUI_PORT:
        raise MonsterdeskError("qBittorrent pasta plan requested an unreviewed port")
    return [
        str(PASTA), "--foreground", "--quiet", "--config-net",
        "--interface", EXPECTED_QBITTORRENT_HOST_INTERFACE,
        "--outbound-if4", EXPECTED_QBITTORRENT_HOST_INTERFACE,
        "--outbound-if6", EXPECTED_QBITTORRENT_HOST_INTERFACE,
        "--no-map-gw", "--map-host-loopback", "none", "--map-guest-addr", "none",
        "--dns-forward", NICOTINE_DNS_FORWARD, "--dns-host", "127.0.0.1",
        "--dns", NICOTINE_DNS_FORWARD, "--host-lo-to-ns-lo",
        "--tcp-ports", f"%{EXPECTED_QBITTORRENT_HOST_INTERFACE}/{peer_port}",
        "--tcp-ports", f"127.0.0.1/{webui_port}",
        "--udp-ports", f"%{EXPECTED_QBITTORRENT_HOST_INTERFACE}/{peer_port}",
        "--tcp-ns", "none", "--udp-ns", "none",
    ]


#@MNX-PART id=90.00.monsterdesk.function.f023kf-qbittorrent-pasta-probe-command kind=function title="Python function qbittorrent_pasta_probe_command"
def qbittorrent_pasta_probe_command(host_peer_port: int, namespace_peer_port: int,
                                     host_webui_port: int, namespace_webui_port: int,
                                     host_udp_port: int, namespace_udp_port: int,
                                     child_argv: list[str]) -> list[str]:
    ports = [host_peer_port, namespace_peer_port, host_webui_port, namespace_webui_port,
             host_udp_port, namespace_udp_port]
    if any(port < 1024 or port > 65535 for port in ports):
        raise MonsterdeskError("qBittorrent pasta fixture ports must be unprivileged")
    if len(set(ports)) != len(ports):
        raise MonsterdeskError("qBittorrent pasta fixture ports must be distinct")
    return [
        str(PASTA), "--foreground", "--quiet", "--ipv4-only", "--dns", "none",
        "--host-lo-to-ns-lo", "--no-map-gw", "--map-host-loopback", "none",
        "--map-guest-addr", "none",
        "--tcp-ports", f"127.0.0.1/{host_peer_port}:{namespace_peer_port}",
        "--tcp-ports", f"127.0.0.1/{host_webui_port}:{namespace_webui_port}",
        "--udp-ports", f"127.0.0.1/{host_udp_port}:{namespace_udp_port}",
        "--tcp-ns", "none", "--udp-ns", "none", "--", *child_argv,
    ]


#@MNX-PART id=90.00.monsterdesk.function.f023kg-reserve-udp-port kind=function title="Python function reserve_loopback_udp_port"
def reserve_loopback_udp_port() -> int:
    candidate = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        candidate.bind(("127.0.0.1", 0))
        return int(candidate.getsockname()[1])
    finally:
        candidate.close()


#@MNX-PART id=90.00.monsterdesk.function.f023kh-qbittorrent-combined-pasta-probe kind=function title="Python function qbittorrent_pasta_combined_namespace_probe"
def qbittorrent_pasta_combined_namespace_probe() -> dict[str, Any]:
    host_peer_port = reserve_loopback_port()
    namespace_peer_port = reserve_loopback_port()
    while namespace_peer_port == host_peer_port:
        namespace_peer_port = reserve_loopback_port()
    host_webui_port = reserve_loopback_port()
    while host_webui_port in {host_peer_port, namespace_peer_port}:
        host_webui_port = reserve_loopback_port()
    namespace_webui_port = reserve_loopback_port()
    while namespace_webui_port in {host_peer_port, namespace_peer_port, host_webui_port}:
        namespace_webui_port = reserve_loopback_port()
    host_udp_port = reserve_loopback_udp_port()
    while host_udp_port in {host_peer_port, namespace_peer_port, host_webui_port, namespace_webui_port}:
        host_udp_port = reserve_loopback_udp_port()
    namespace_udp_port = reserve_loopback_udp_port()
    while namespace_udp_port in {
        host_peer_port, namespace_peer_port, host_webui_port, namespace_webui_port, host_udp_port,
    }:
        namespace_udp_port = reserve_loopback_udp_port()
    allocated_ports = {
        host_peer_port, namespace_peer_port, host_webui_port, namespace_webui_port,
        host_udp_port, namespace_udp_port,
    }
    while True:
        blocked_listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        blocked_listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        blocked_listener.bind(("127.0.0.1", 0))
        blocked_port = int(blocked_listener.getsockname()[1])
        if blocked_port not in allocated_ports:
            blocked_listener.listen(1)
            break
        blocked_listener.close()
    peer_token = secrets.token_hex(24)
    webui_token = secrets.token_hex(24)
    udp_token = secrets.token_hex(24)
    child_code = r"""
import hashlib,json,os,socket,sys
ready_path,result_path,peer_token,webui_token,udp_token,peer_text,webui_text,udp_text,blocked_text = sys.argv[1:]
peer_port = int(peer_text)
webui_port = int(webui_text)
udp_port = int(udp_text)
blocked_port = int(blocked_text)
blocked = False
probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
probe.settimeout(0.5)
try:
    probe.connect(("127.0.0.1", blocked_port))
except OSError:
    blocked = True
finally:
    probe.close()
peer_server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
peer_server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
peer_server.bind(("127.0.0.1", peer_port))
peer_server.listen(1)
peer_server.settimeout(15)
webui_server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
webui_server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
webui_server.bind(("127.0.0.1", webui_port))
webui_server.listen(1)
webui_server.settimeout(15)
udp_server = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
udp_server.bind(("127.0.0.1", udp_port))
udp_server.settimeout(15)
ready_tmp = ready_path + ".tmp"
with open(ready_tmp, "w", encoding="utf-8") as handle:
    json.dump({"netns": os.readlink("/proc/self/ns/net"), "blocked_host_loopback": blocked}, handle, sort_keys=True)
os.replace(ready_tmp, ready_path)
peer_connection, _peer_address = peer_server.accept()
peer_connection.settimeout(5)
peer_received = peer_connection.recv(4096).decode("ascii")
peer_digest = hashlib.sha256(("peer:" + peer_received).encode("ascii")).hexdigest()
peer_connection.sendall(peer_digest.encode("ascii"))
peer_connection.close()
peer_server.close()
webui_connection, _webui_address = webui_server.accept()
webui_connection.settimeout(5)
webui_received = webui_connection.recv(4096).decode("ascii")
webui_digest = hashlib.sha256(("webui:" + webui_received).encode("ascii")).hexdigest()
webui_connection.sendall(webui_digest.encode("ascii"))
webui_connection.close()
webui_server.close()
udp_payload, udp_address = udp_server.recvfrom(4096)
udp_received = udp_payload.decode("ascii")
udp_digest = hashlib.sha256(("udp:" + udp_received).encode("ascii")).hexdigest()
udp_server.sendto(udp_digest.encode("ascii"), udp_address)
udp_server.close()
result = {
    "blocked_host_loopback": blocked,
    "peer_token_matched": peer_received == peer_token,
    "webui_token_matched": webui_received == webui_token,
    "udp_token_matched": udp_received == udp_token,
}
result_tmp = result_path + ".tmp"
with open(result_tmp, "w", encoding="utf-8") as handle:
    json.dump(result, handle, sort_keys=True)
os.replace(result_tmp, result_path)
raise SystemExit(0 if all(result.values()) else 3)
"""
    process: subprocess.Popen[bytes] | None = None
    try:
        with tempfile.TemporaryDirectory(prefix="monsterdesk-qbit-pasta-", dir=runtime_base()) as directory:
            root = Path(directory)
            ready = root / "ready.json"
            result_path = root / "result.json"
            child = [
                str(PYTHON), "-c", child_code, str(ready), str(result_path),
                peer_token, webui_token, udp_token, str(namespace_peer_port),
                str(namespace_webui_port), str(namespace_udp_port), str(blocked_port),
            ]
            command = qbittorrent_pasta_probe_command(
                host_peer_port, namespace_peer_port, host_webui_port, namespace_webui_port,
                host_udp_port, namespace_udp_port, child,
            )
            process = subprocess.Popen(
                command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                start_new_session=True,
            )
            wait_for(lambda: ready.is_file() or process.poll() is not None, 12,
                     "qBittorrent combined pasta fixture readiness")
            if not ready.is_file():
                _stdout, stderr = process.communicate(timeout=3)
                raise MonsterdeskError(
                    "qBittorrent combined pasta fixture exited before readiness: "
                    + stderr[:MAX_LOG_TAIL_BYTES].decode("utf-8", errors="replace")
                )
            ready_value = json.loads(ready.read_text(encoding="utf-8"))
            peer_response = b""
            deadline = time.monotonic() + 10
            while time.monotonic() < deadline:
                connection = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                connection.settimeout(1)
                try:
                    connection.connect(("127.0.0.1", host_peer_port))
                    connection.sendall(peer_token.encode("ascii"))
                    peer_response = connection.recv(4096)
                    break
                except OSError:
                    time.sleep(0.1)
                finally:
                    connection.close()
            expected_peer = hashlib.sha256(("peer:" + peer_token).encode("ascii")).hexdigest().encode("ascii")
            if peer_response != expected_peer:
                raise MonsterdeskError("qBittorrent pasta TCP peer fixture did not return the token digest")
            webui_response = b""
            deadline = time.monotonic() + 10
            while time.monotonic() < deadline:
                connection = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                connection.settimeout(1)
                try:
                    connection.connect(("127.0.0.1", host_webui_port))
                    connection.sendall(webui_token.encode("ascii"))
                    webui_response = connection.recv(4096)
                    break
                except OSError:
                    time.sleep(0.1)
                finally:
                    connection.close()
            expected_webui = hashlib.sha256(("webui:" + webui_token).encode("ascii")).hexdigest().encode("ascii")
            if webui_response != expected_webui:
                raise MonsterdeskError("qBittorrent pasta loopback WebUI fixture did not return the token digest")
            udp_response = b""
            deadline = time.monotonic() + 10
            while time.monotonic() < deadline:
                udp_client = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                udp_client.settimeout(1)
                try:
                    udp_client.sendto(udp_token.encode("ascii"), ("127.0.0.1", host_udp_port))
                    udp_response, _address = udp_client.recvfrom(4096)
                    break
                except OSError:
                    time.sleep(0.1)
                finally:
                    udp_client.close()
            expected_udp = hashlib.sha256(("udp:" + udp_token).encode("ascii")).hexdigest().encode("ascii")
            if udp_response != expected_udp:
                raise MonsterdeskError("qBittorrent pasta UDP peer fixture did not return the token digest")
            stdout, stderr = process.communicate(timeout=10)
            if process.returncode != 0:
                raise MonsterdeskError(
                    f"qBittorrent combined pasta fixture failed rc={process.returncode}: "
                    + stderr[:MAX_LOG_TAIL_BYTES].decode("utf-8", errors="replace")
                )
            result = json.loads(result_path.read_text(encoding="utf-8"))
            if ready_value.get("netns") == os.readlink("/proc/self/ns/net"):
                raise MonsterdeskError("qBittorrent pasta fixture did not create a distinct network namespace")
            if ready_value.get("blocked_host_loopback") is not True or result.get("blocked_host_loopback") is not True:
                raise MonsterdeskError("qBittorrent pasta fixture reached an unforwarded host-loopback service")
            if not all(result.get(key) is True for key in (
                "peer_token_matched", "webui_token_matched", "udp_token_matched",
            )):
                raise MonsterdeskError("qBittorrent combined pasta child did not receive every exact token")
            return {
                "schema": "mnx.qbittorrent.pasta-local-combined.v1",
                "state": "pass",
                "separate_network_namespace": True,
                "host_to_namespace_tcp_peer_forward": True,
                "host_to_namespace_tcp_webui_forward": True,
                "host_to_namespace_udp_peer_forward": True,
                "unforwarded_host_loopback_blocked": True,
                "external_network_attempted": False,
                "live_qbittorrent_ports_used": False,
                "host_bind_address": "127.0.0.1",
                "pasta_stdout_bytes": len(stdout),
                "pasta_stderr_bytes": len(stderr),
                "raw_output_exported": False,
            }
    finally:
        blocked_listener.close()
        if process is not None and process.poll() is None:
            with contextlib.suppress(OSError):
                os.killpg(process.pid, signal.SIGTERM)
            with contextlib.suppress(Exception):
                process.wait(timeout=2)
            if process.poll() is None:
                with contextlib.suppress(OSError):
                    os.killpg(process.pid, signal.SIGKILL)
                with contextlib.suppress(Exception):
                    process.wait(timeout=2)


#@MNX-PART id=90.00.monsterdesk.function.f023ki-qualify-qbittorrent-cutover kind=function title="Python function qualify_qbittorrent_cutover"
def qualify_qbittorrent_cutover(preflight: dict[str, Any], *,
                                 namespace_probe: dict[str, Any] | None = None,
                                 interface_address: str | None = None) -> dict[str, Any]:
    inputs = qbittorrent_cutover_inputs(preflight, interface_address=interface_address)
    probe = namespace_probe if namespace_probe is not None else qbittorrent_pasta_combined_namespace_probe()
