#@MNX-PART id=90.00.monsterdesk.function.f074a0-publish-qbittorrent-preflight kind=function title="Python function publish_qbittorrent_preflight_evidence"
def publish_qbittorrent_preflight_evidence(report: dict[str, Any]) -> str:
    payload = canonical(report)
    payload_bytes = payload.encode("utf-8")
    if len(payload_bytes) > MAX_QBITTORRENT_REPORT_BYTES:
        raise MonsterdeskError("final qBittorrent preflight evidence exceeds byte policy")
    digest = hashlib.sha256(payload_bytes).hexdigest()
    print("officer_health_qbittorrent_preflight=" + payload)
    print("officer_health_qbittorrent_preflight_sha256=" + digest)
    return payload


