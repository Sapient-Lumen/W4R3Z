          "schema=" + .schema,
          "status=" + .status,
          "authority=" + .authority,
          "operator_request=" + .epistemic.operator_request.status,
          "inherited_intent=accepted-stage-" + ((.epistemic.inherited_intent.accepted_stage // "unknown")|tostring),
          "measured_at=" + .epistemic.measured_fact.observed_at,
          "inference_next_action=" + .epistemic.inference.next_action,
          "proposal=" + .epistemic.proposal.status,
          "unknown_count=" + (.epistemic.unknown.count|tostring),
          (.epistemic.unknown.fields[]? | "unknown=" + .),
          "amnesia_capsule_sha256=" + (.handoff.source_capsule.sha256 // "unknown"),
          "amnesia_authority=" + (.handoff.source_capsule.authority // "unknown"),
          "amnesia_state=" + (.handoff.source_capsule.state // "unknown"),
          "amnesia_open=" + (.handoff.source_capsule.open // "unknown"),
          "amnesia_next=" + (.handoff.source_capsule.next // "unknown"),
          "declared_next_objective=" + (.handoff.declared_next_objective // "unknown"),
          "effective_next_objective=" + (.handoff.effective_next_objective // "unknown"),
          "effective_next_source=" + (.handoff.runtime_overlay.effective_next_source // "unknown"),
          "office_final_switch_result=" + (.handoff.runtime_overlay.final_switch_result // "unknown"),
          "post_acceptance_status=" + (.handoff.runtime_overlay.post_acceptance_status // "unknown"),
          "post_acceptance_mutation_proof=" + (.handoff.runtime_overlay.mutation_proof // "unknown"),
          "source_sha256=" + .source.editable_sha256,
          "active_source_sha256=" + .source.active_sha256,
          "boot_default_source_sha256=" + .source.boot_default_sha256,
          "source_coherence=" + .source.coherence,
          "running_system=" + .runtime.running_system,
          "boot_default_system=" + .runtime.boot_default_system,
          "closure_relation=" + .runtime.closure_relation,
          "system_state=" + .runtime.manager_state,
          "failed_unit_count=" + (.runtime.failed_unit_count|tostring),
          "latest_test_result=" + .transaction.latest_test.result,
          "latest_switch_result=" + .transaction.latest_switch.result,
          "transaction_active=" + (.transaction.active|tostring),
          "storage_health_problem=" + .health.storage_problem,
          "officer_health_evidence=" + ((.office.health_evidence // {state:"unavailable"})|tojson),
          "backup_stale=" + .backup.stale,
          "backup_critical=" + .backup.critical,
          "exposure_status=" + .exposure.status,
          "exposure_review_listener_total=" + ((.exposure.review_listener_total // "unknown")|tostring),
          "m21_helper_block_state=" + .m21.helper_block_state,
          "journal_integrity_state=" + .incidents.journal_integrity_state,
          "journal_integrity_clean_forward_status=" + .incidents.journal_clean_forward_status,
          "journal_integrity_anchor_present=" + (.incidents.journal_anchor_present|tostring),
          "journal_integrity_anchor_path=" + .incidents.journal_anchor_path,
          "journal_integrity_recovery_boundary_present=" + (.incidents.journal_recovery_boundary_present|tostring),
          "journal_integrity_recovery_boundary_path=" + .incidents.journal_recovery_boundary_path,
          "journal_integrity_recovery_boundary_mode=" + .incidents.journal_recovery_boundary_mode,
          "journal_integrity_active_forward_status=" + .incidents.journal_active_forward_status,
          "journal_integrity_new_problem_count=" + ((.incidents.journal_new_problem_count // "unknown")|tostring),
          "journal_integrity_evidence=" + .incidents.journal_integrity_evidence,
          "temporary_code_region_count=" + ((.temporary_code.region_count // "unknown")|tostring),
          "evidence_bundle=" + (.evidence.bundle // "ephemeral"),
          "network_used=no",
          "MNX_BRIEF=PASS"
        ] | .[]'
      }

      #@MNX-PART id=99.10.mnx.function.brief-command kind=function title="Function brief_command"
      brief_command() {
        local _json=0 _save=0 _full=0 _document _stamp _support _final _staging _manifest
        while (( $# > 0 )); do
          case "$1" in
            --json) _json=1; shift ;;
            --save) _save=1; shift ;;
            --full) _full=1; shift ;;
            help|-h|--help) echo 'mnx brief [--full] [--json] [--save]'; return 0 ;;
            *) echo "unknown mnx brief option: $1" >&2; return 64 ;;
          esac
        done
        if (( _save )) && [[ ''${EUID:-$(${pkgs.coreutils}/bin/id -u)} -ne 0 ]]; then
          local -a _args=(brief --save)
          (( _json )) && _args+=(--json)
          (( _full )) && _args+=(--full)
          exec /run/wrappers/bin/sudo -- /etc/monsternix/bin/mnx "''${_args[@]}"
        fi

        _document="$(brief_collect_json)"
        if (( _save )); then
          _support=/var/lib/logbook/support
          _stamp="$(${pkgs.coreutils}/bin/date +%Y%m%dT%H%M%S)-$$"
          _final="$_support/mnx-brief-$_stamp"
          _staging="$_support/.mnx-brief-$_stamp"
          [[ ! -e "$_final" && ! -e "$_staging" ]] || { echo 'brief evidence path collision' >&2; return 1; }
          ${pkgs.coreutils}/bin/install -d -o root -g logbook -m 0750 "$_staging"
          if ! (
            set -Eeuo pipefail
            _document="$(${pkgs.jq}/bin/jq --arg bundle "$_final" '.mutation="bounded-evidence-write" | .evidence.bundle=$bundle | .evidence.manifest=($bundle + "/SHA256SUMS")' <<< "$_document")"
            printf '%s\n' "$_document" > "$_staging/brief.json"
            printf '%s\n' "$_document" | brief_render_text > "$_staging/brief.txt"
            printf '%s\n' "$_document" | brief_render_full_text > "$_staging/brief.full.txt"
            printf 'schema=mnx.brief.provenance.v1\ncommand=mnx brief --save\nsource_sha256=%s\nnetwork_used=no\npayload_executed=no\n' \
              "$(${pkgs.jq}/bin/jq -r '.source.editable_sha256' <<< "$_document")" > "$_staging/provenance.txt"
            ${pkgs.coreutils}/bin/chown root:logbook "$_staging/brief.json" "$_staging/brief.txt" "$_staging/brief.full.txt" "$_staging/provenance.txt"
            ${pkgs.coreutils}/bin/chmod 0640 "$_staging/brief.json" "$_staging/brief.txt" "$_staging/brief.full.txt" "$_staging/provenance.txt"
            /etc/monsternix/bin/mnx-bundle-manifest create "$_staging" 2 >/dev/null
          ); then
            ${pkgs.coreutils}/bin/rm -rf -- "$_staging"
            return 1
          fi
          ${pkgs.coreutils}/bin/mv -- "$_staging" "$_final"
          _document="$(${pkgs.coreutils}/bin/cat "$_final/brief.json")"
          _manifest="$_final/SHA256SUMS"
          [[ -s "$_manifest" ]] || { echo 'saved brief manifest is missing' >&2; return 1; }
        else
          _document="$(${pkgs.jq}/bin/jq '.evidence.bundle=null | .evidence.manifest=null' <<< "$_document")"
        fi

        if (( _json )); then
          printf '%s\n' "$_document"
        elif (( _full )); then
          printf '%s\n' "$_document" | brief_render_full_text
        else
          printf '%s\n' "$_document" | brief_render_text
        fi
      }

      #@MNX-PART id=99.10.mnx.function.evidence-list kind=function title="Function evidence_list"
      evidence_list() {
        local _limit="''${1:-20}" _root
        [[ "$_limit" =~ ^[1-9][0-9]*$ ]] || { echo 'evidence list limit must be a positive integer' >&2; return 64; }
        {
          for _root in /var/lib/logbook/boots /var/lib/logbook/incidents /var/lib/logbook/support; do
            [[ -d "$_root" ]] || continue
            ${pkgs.findutils}/bin/find "$_root" -mindepth 2 -maxdepth 5 -type f -name SHA256SUMS -printf '%T@ %h\n' 2>/dev/null || true
          done
        } | ${pkgs.coreutils}/bin/sort -nr | ${pkgs.gawk}/bin/awk '!seen[$2]++ {print $2}' | ${pkgs.coreutils}/bin/head -n "$_limit"
      }

      #@MNX-PART id=99.10.mnx.function.evidence-command kind=function title="Function evidence_command"
      evidence_command() {
        local _sub="''${1:-verify}" _json=0 _bundle _latest _output _rc _manifest_sha _entry_count _tmp
        (( $# == 0 )) || shift
        case "$_sub" in
          list)
            evidence_list "''${1:-20}"
            ;;
          latest)
            _latest="$(evidence_list 1 | ${pkgs.coreutils}/bin/head -n 1)"
            [[ -n "$_latest" ]] || { echo 'MNX_EVIDENCE_ERROR: no manifested evidence bundle exists' >&2; return 1; }
            printf 'bundle=%s\nmanifest=%s/SHA256SUMS\nmanifest_sha256=%s\nMNX_EVIDENCE_LATEST=PASS\n' \
              "$_latest" "$_latest" "$(${pkgs.coreutils}/bin/sha256sum "$_latest/SHA256SUMS" | ${pkgs.gawk}/bin/awk '{print $1}')"
            ;;
          office)
            [[ "''${1:-}" == --json ]] && { _json=1; shift; }
            (( $# == 0 )) || { echo 'mnx evidence office [--json]' >&2; return 64; }
            if _output="$(mnx_office_verify_json)"; then
              if (( _json )); then
                ${pkgs.jq}/bin/jq -n --arg schema mnx.evidence.office.v1 --argjson office "$_output" '{schema:$schema,status:"pass",network_used:false,mutation:"none",office:$office}'
              else
                printf '%s\n' "$_output" | ${pkgs.jq}/bin/jq -r 'to_entries[] | "\(.key)=\(.value)"'
                echo 'MNX_EVIDENCE_OFFICE=PASS'
              fi
            else
              echo 'MNX_EVIDENCE_OFFICE=FAIL' >&2
              return 1
            fi
            ;;
          verify)
            while (( $# > 0 )); do
              case "$1" in
                --json) _json=1; shift ;;
                -*) echo "unknown evidence verify option: $1" >&2; return 64 ;;
                *) [[ -z "''${_bundle:-}" ]] || { echo 'mnx evidence verify accepts one bundle' >&2; return 64; }; _bundle="$1"; shift ;;
              esac
            done
            [[ -n "''${_bundle:-}" ]] || _bundle="$(evidence_list 1 | ${pkgs.coreutils}/bin/head -n 1)"
            [[ -n "$_bundle" ]] || { echo 'MNX_EVIDENCE_ERROR: no manifested evidence bundle exists' >&2; return 1; }
            _bundle="$(${pkgs.coreutils}/bin/readlink -f -- "$_bundle" 2>/dev/null || true)"
            [[ -d "$_bundle" ]] || { echo "MNX_EVIDENCE_ERROR: bundle is unavailable: $_bundle" >&2; return 66; }
            _tmp="$(${pkgs.coreutils}/bin/mktemp)"
            if /etc/monsternix/bin/mnx-bundle-manifest verify "$_bundle" >"$_tmp" 2>&1; then _rc=0; else _rc=$?; fi
            _output="$(${pkgs.coreutils}/bin/cat "$_tmp")"
            ${pkgs.coreutils}/bin/rm -f "$_tmp"
            _manifest_sha="$(${pkgs.coreutils}/bin/sha256sum "$_bundle/SHA256SUMS" 2>/dev/null | ${pkgs.gawk}/bin/awk '{print $1}' || true)"
            _entry_count="$(printf '%s\n' "$_output" | ${pkgs.gnused}/bin/sed -n 's/^manifest_entry_count=//p' | ${pkgs.coreutils}/bin/tail -n 1)"
            if (( _json )); then
              ${pkgs.jq}/bin/jq -n --arg schema mnx.evidence.verify.v1 --arg status "$([[ $_rc == 0 ]] && echo pass || echo fail)" \
                --arg bundle "$_bundle" --arg manifest "$_bundle/SHA256SUMS" --arg manifest_sha256 "$_manifest_sha" \
                --arg entries "''${_entry_count:-unknown}" --argjson rc "$_rc" \
                '{schema:$schema,status:$status,bundle:$bundle,manifest:$manifest,manifest_sha256:$manifest_sha256,entry_count:(if ($entries|test("^[0-9]+$")) then ($entries|tonumber) else null end),verifier_rc:$rc,network_used:false,mutation:"none",payload_executed:false}'
            else
              printf '%s\n' "$_output"
              printf 'bundle=%s\nmanifest=%s/SHA256SUMS\nmanifest_sha256=%s\npayload_executed=no\nnetwork_used=no\n' "$_bundle" "$_bundle" "$_manifest_sha"
              [[ "$_rc" == 0 ]] && echo 'MNX_EVIDENCE_VERIFY=PASS' || echo 'MNX_EVIDENCE_VERIFY=FAIL'
            fi
            return "$_rc"
            ;;
          help|-h|--help)
            echo 'mnx evidence verify [--json] [BUNDLE] | latest | list [LIMIT] | office [--json]'
            ;;
          *) echo "unknown mnx evidence command: $_sub" >&2; return 64 ;;
        esac
      }

      #@MNX-PART id=99.10.mnx.function.desktop-family-class kind=function title="Function desktop_family_class"
      desktop_family_class() {
        local _family="''${1%%,*}"
        case "$_family" in
          Noto\ Serif*|Source\ Serif*|DejaVu\ Serif*|Liberation\ Serif*|FreeSerif*|Nimbus\ Roman*) printf 'serif\n' ;;
          Noto\ Sans\ Mono*|DejaVu\ Sans\ Mono*|Liberation\ Mono*|FreeMono*|Nimbus\ Mono*) printf 'monospace\n' ;;
          Noto\ Sans*|Source\ Sans*|DejaVu\ Sans*|Liberation\ Sans*|FreeSans*|Cantarell*|Nimbus\ Sans*) printf 'sans-serif\n' ;;
          Twitter\ Color\ Emoji|Noto\ Color\ Emoji*|EmojiOne\ Color*|JoyPixels*) printf 'emoji\n' ;;
          *) printf 'other\n' ;;
        esac
      }

      #@MNX-PART id=99.10.mnx.function.desktop-family-is-cjk kind=function title="Function desktop_family_is_cjk"
      desktop_family_is_cjk() {
        case "$1" in
          *CJK*|*Han*|*Japanese*|*Korean*|*" JP"*|*" SC"*|*" TC"*|*" HK"*|*" KR"*) return 0 ;;
          *) return 1 ;;
        esac
      }

      #@MNX-PART id=99.10.mnx.function.desktop-policy-json kind=function title="Function desktop_policy_json"
      desktop_policy_json() {
        local _cfg="''${MNX_CONFIG:-/etc/nixos/configuration.nix}" _sha _marker
        [[ -r "$_cfg" ]] || { echo "MNX_DESKTOP_POLICY_ERROR: source is unreadable: $_cfg" >&2; return 1; }
        for _marker in \
          '# MNX_DESKTOP_BASELINE_SCHEMA=1' \
          '# MNX_FONT_COVERAGE_POLICY=maintained-broad-latin-greek-cyrillic-cjk-emoji-symbol-fallback-no-dead-textfonts-archive' \
          '# MNX_GTK_BASELINE_POLICY=gtk3-gtk4-xdg-system-defaults-dconf-and-portal-without-global-theme-or-adw-portal-disable' \
          '# MNX_GSETTINGS_SCHEMA_POLICY=source-owned-gsettings-desktop-schemas-store-path-not-ambient-session-discovery'
        do
          ${pkgs.gnugrep}/bin/grep -Fxq -- "$_marker" "$_cfg" || {
            echo "MNX_DESKTOP_POLICY_ERROR: source marker is missing: $_marker" >&2
            return 1
          }
        done
        _sha="$(${pkgs.coreutils}/bin/sha256sum "$_cfg" | ${pkgs.gawk}/bin/awk '{print $1}')"
        ${pkgs.jq}/bin/jq -n \
          --arg source "$_cfg" --arg sha "$_sha" \
          '{schema:"mnx.desktop.policy.v1",desktop_schema:1,authority:"source-declared-policy-not-runtime-proof",source:$source,source_sha256:$sha,
            font_policy:{dead_archive_package_removed:"textfonts",broad_coverage:["latin","greek","cyrillic","cjk-sans","cjk-serif","emoji","unicode-fallback","nerd-symbols","legacy-metric-compatibility","legacy-bitmap"],fontconfig_32bit_cache:true,bitmap_fonts_allowed:true,embedded_bitmaps_allowed:true,default_serif:"Noto Serif",default_sans:"Noto Sans",default_monospace:"Noto Sans Mono",default_emoji:"Twitter Color Emoji",emoji_fallbacks:["Twitter Color Emoji","Noto Color Emoji"]},
            gtk_policy:{gtk3_xdg_settings:"/etc/xdg/gtk-3.0/settings.ini",gtk4_xdg_settings:"/etc/xdg/gtk-4.0/settings.ini",prefer_dark:true,icon_theme:"Adwaita",dconf_enabled:true,portal:"gtk",gsettings_schema_authority:"source-owned-gsettings-desktop-schemas-store-path",global_gtk_theme_forced:false,adw_portal_disabled:false,user_overrides_allowed:true},
            network_used:false,mutation:"none"}'
      }

      #@MNX-PART id=99.10.mnx.function.desktop-self-test kind=function title="Function desktop_self_test"
      desktop_self_test() {
        local _fixture _schema_dir _schema_output
        [[ "$(desktop_family_class 'Noto Serif')" == serif ]]
        [[ "$(desktop_family_class 'Noto Sans')" == sans-serif ]]
        [[ "$(desktop_family_class 'Noto Sans Mono')" == monospace ]]
        [[ "$(desktop_family_class 'Twitter Color Emoji')" == emoji ]]
        [[ "$(desktop_family_class 'Some Unknown Family')" == other ]]
        _fixture="$(${pkgs.coreutils}/bin/mktemp)"
        trap '${pkgs.coreutils}/bin/rm -f -- "$_fixture"' RETURN
        ${pkgs.coreutils}/bin/cat >"$_fixture" <<'MNX_DESKTOP_POLICY_FIXTURE'
      # MNX_DESKTOP_BASELINE_SCHEMA=1
      # MNX_FONT_COVERAGE_POLICY=maintained-broad-latin-greek-cyrillic-cjk-emoji-symbol-fallback-no-dead-textfonts-archive
      # MNX_GTK_BASELINE_POLICY=gtk3-gtk4-xdg-system-defaults-dconf-and-portal-without-global-theme-or-adw-portal-disable
      # MNX_GSETTINGS_SCHEMA_POLICY=source-owned-gsettings-desktop-schemas-store-path-not-ambient-session-discovery
      MNX_DESKTOP_POLICY_FIXTURE
        MNX_CONFIG="$_fixture" desktop_policy_json | ${pkgs.jq}/bin/jq -e '.schema == "mnx.desktop.policy.v1" and .desktop_schema == 1 and .font_policy.dead_archive_package_removed == "textfonts" and .gtk_policy.gsettings_schema_authority == "source-owned-gsettings-desktop-schemas-store-path" and .gtk_policy.global_gtk_theme_forced == false and .gtk_policy.adw_portal_disabled == false and .network_used == false and .mutation == "none"' >/dev/null
        _schema_dir=${pkgs.gsettings-desktop-schemas}/share/gsettings-schemas/${pkgs.gsettings-desktop-schemas.name}/glib-2.0/schemas
        [[ -r "$_schema_dir/gschemas.compiled" ]]
        _schema_output="$(GSETTINGS_SCHEMA_DIR="$_schema_dir" XDG_DATA_DIRS="${pkgs.gsettings-desktop-schemas}/share/gsettings-schemas/${pkgs.gsettings-desktop-schemas.name}" ${lib.getBin pkgs.glib}/bin/gsettings list-schemas)"
        [[ "$(printf '%s\n' "$_schema_output" | ${pkgs.gnugrep}/bin/grep -Fxc 'org.gnome.desktop.interface' || true)" == 1 ]]
        trap - RETURN
        ${pkgs.coreutils}/bin/rm -f -- "$_fixture"
        echo 'MNX_DESKTOP_GSETTINGS_SELF_TEST=PASS'
        echo 'MNX_DESKTOP_SELF_TEST=PASS'
      }

      #@MNX-PART id=99.10.mnx.function.desktop-audit-json kind=function title="Function desktop_audit_json"
      desktop_audit_json() {
        local _policy _serif _sans _mono _emoji _cjk_sans _cjk_serif _schema_count _schema_output
        local _portal _symbols _unifont _settings _fontconfig_file=/etc/fonts/fonts.conf
        local _gsettings_data_dir=${pkgs.gsettings-desktop-schemas}/share/gsettings-schemas/${pkgs.gsettings-desktop-schemas.name}
        local _gsettings_schema_dir="$_gsettings_data_dir/glib-2.0/schemas"
        local _gsettings_compiled="$_gsettings_schema_dir/gschemas.compiled"
        local _xdg_data_dirs="$_gsettings_data_dir:/run/current-system/sw/share"
        local _failures=() _warnings=()
        _policy="$(desktop_policy_json)" || return 1

        [[ -r "$_fontconfig_file" ]] || _failures+=(fontconfig-system-configuration-missing)
        _serif="$(FONTCONFIG_FILE="$_fontconfig_file" ${pkgs.fontconfig}/bin/fc-match -f '%{family[0]}\n' serif 2>/dev/null || true)"
        _sans="$(FONTCONFIG_FILE="$_fontconfig_file" ${pkgs.fontconfig}/bin/fc-match -f '%{family[0]}\n' sans-serif 2>/dev/null || true)"
        _mono="$(FONTCONFIG_FILE="$_fontconfig_file" ${pkgs.fontconfig}/bin/fc-match -f '%{family[0]}\n' monospace 2>/dev/null || true)"
        _emoji="$(FONTCONFIG_FILE="$_fontconfig_file" ${pkgs.fontconfig}/bin/fc-match -f '%{family[0]}\n' 'emoji:charset=1f600' 2>/dev/null || true)"
        _cjk_sans="$(FONTCONFIG_FILE="$_fontconfig_file" ${pkgs.fontconfig}/bin/fc-match -f '%{family[0]}\n' 'sans-serif:charset=65e5' 2>/dev/null || true)"
        _cjk_serif="$(FONTCONFIG_FILE="$_fontconfig_file" ${pkgs.fontconfig}/bin/fc-match -f '%{family[0]}\n' 'serif:charset=4e2d' 2>/dev/null || true)"

        [[ -n "$_serif" && "$(desktop_family_class "$_serif")" == serif ]] || _failures+=(serif-default)
        [[ -n "$_sans" && "$(desktop_family_class "$_sans")" == sans-serif ]] || _failures+=(sans-default)
        [[ -n "$_mono" && "$(desktop_family_class "$_mono")" == monospace ]] || _failures+=(monospace-default)
        [[ -n "$_emoji" && "$(desktop_family_class "$_emoji")" == emoji ]] || _failures+=(emoji-default)
        desktop_family_is_cjk "$_cjk_sans" || _failures+=(cjk-sans-glyph-fallback)
        desktop_family_is_cjk "$_cjk_serif" || _failures+=(cjk-serif-glyph-fallback)

        for _settings in /etc/xdg/gtk-3.0/settings.ini /etc/xdg/gtk-4.0/settings.ini; do
          [[ -r "$_settings" ]] || { _failures+=("missing-''${_settings#/etc/}"); continue; }
          ${pkgs.gnugrep}/bin/grep -Fxq '[Settings]' "$_settings" || _failures+=("settings-section-''${_settings#/etc/}")
          ${pkgs.gnugrep}/bin/grep -Fxq 'gtk-application-prefer-dark-theme=1' "$_settings" || _failures+=("dark-default-''${_settings#/etc/}")
          ${pkgs.gnugrep}/bin/grep -Fxq 'gtk-icon-theme-name=Adwaita' "$_settings" || _failures+=("icon-default-''${_settings#/etc/}")
          ${pkgs.gnugrep}/bin/grep -Fxq 'gtk-font-name=Noto Sans 10' "$_settings" || _failures+=("font-default-''${_settings#/etc/}")
        done

        [[ -d "$_gsettings_schema_dir" ]] || _failures+=(gsettings-schema-directory-missing)
        [[ -r "$_gsettings_compiled" ]] || _failures+=(gsettings-compiled-schema-missing)
        _schema_output="$(GSETTINGS_SCHEMA_DIR="$_gsettings_schema_dir" XDG_DATA_DIRS="$_xdg_data_dirs" ${lib.getBin pkgs.glib}/bin/gsettings list-schemas 2>/dev/null || true)"
        _schema_count="$(printf '%s\n' "$_schema_output" | ${pkgs.gnugrep}/bin/grep -Fxc 'org.gnome.desktop.interface' || true)"
        [[ "$_schema_count" == 1 ]] || _failures+=(gsettings-desktop-interface-schema)

        _portal="$(${pkgs.findutils}/bin/find /run/current-system/sw/share -path '*/xdg-desktop-portal/portals/gtk.portal' -type f -print -quit 2>/dev/null || true)"
        [[ -n "$_portal" ]] || _warnings+=(gtk-portal-descriptor-not-in-system-share)
        _symbols="$(FONTCONFIG_FILE="$_fontconfig_file" ${pkgs.fontconfig}/bin/fc-list : family 2>/dev/null | ${pkgs.gnugrep}/bin/grep -Ec 'Symbols Nerd Font' || true)"
        _unifont="$(FONTCONFIG_FILE="$_fontconfig_file" ${pkgs.fontconfig}/bin/fc-list : family 2>/dev/null | ${pkgs.gnugrep}/bin/grep -Ec '(^|,)Unifont([,:]|$)' || true)"
        [[ "$_symbols" =~ ^[1-9][0-9]*$ ]] || _warnings+=(nerd-symbol-family-not-observed)
        [[ "$_unifont" =~ ^[1-9][0-9]*$ ]] || _warnings+=(unifont-family-not-observed)

        local _fail_json _warn_json
        _fail_json="$(printf '%s\n' "''${_failures[@]}" | ${pkgs.jq}/bin/jq -R -s 'split("\n") | map(select(length > 0))')"
        _warn_json="$(printf '%s\n' "''${_warnings[@]}" | ${pkgs.jq}/bin/jq -R -s 'split("\n") | map(select(length > 0))')"
        ${pkgs.jq}/bin/jq -n \
          --argjson policy "$_policy" --arg serif "$_serif" --arg sans "$_sans" --arg mono "$_mono" --arg emoji "$_emoji" \
          --arg cjk_sans "$_cjk_sans" --arg cjk_serif "$_cjk_serif" --arg portal "''${_portal:-none}" \
          --arg fontconfig_file "$_fontconfig_file" --arg gsettings_xdg_data_dirs "$_xdg_data_dirs" \
          --arg gsettings_schema_dir "$_gsettings_schema_dir" --arg gsettings_compiled "$_gsettings_compiled" --argjson gsettings_schema_count "$_schema_count" \
          --argjson failures "$_fail_json" --argjson warnings "$_warn_json" \
          '{schema:"mnx.desktop.audit.v1",desktop_schema:1,policy:$policy,runtime:{fontconfig_file:$fontconfig_file,gsettings_xdg_data_dirs:$gsettings_xdg_data_dirs,gsettings_schema_source:"source-owned-gsettings-desktop-schemas-store-path",gsettings_schema_dir:$gsettings_schema_dir,gsettings_compiled_schema:$gsettings_compiled,gsettings_schema_count:$gsettings_schema_count,serif:$serif,sans_serif:$sans,monospace:$mono,emoji:$emoji,cjk_sans:$cjk_sans,cjk_serif:$cjk_serif,gtk_portal_descriptor:$portal,gtk3_settings:"/etc/xdg/gtk-3.0/settings.ini",gtk4_settings:"/etc/xdg/gtk-4.0/settings.ini"},failure_count:($failures|length),failures:$failures,warning_count:($warnings|length),warnings:$warnings,network_used:false,mutation:"none"}'
        (( ''${#_failures[@]} == 0 ))
      }

      #@MNX-PART id=99.10.mnx.function.desktop-render-text kind=function title="Function desktop_render_text"
      desktop_render_text() {
        ${pkgs.jq}/bin/jq -r '[
          "schema=" + .schema,
          "source_sha256=" + .policy.source_sha256,
          "font_policy_removed=" + .policy.font_policy.dead_archive_package_removed,
          "fontconfig_file=" + .runtime.fontconfig_file,
          "gsettings_xdg_data_dirs=" + .runtime.gsettings_xdg_data_dirs,
          "gsettings_schema_source=" + .runtime.gsettings_schema_source,
          "gsettings_schema_dir=" + .runtime.gsettings_schema_dir,
          "gsettings_compiled_schema=" + .runtime.gsettings_compiled_schema,
          "gsettings_schema_count=" + (.runtime.gsettings_schema_count|tostring),
          "serif_family=" + .runtime.serif,
          "sans_serif_family=" + .runtime.sans_serif,
          "monospace_family=" + .runtime.monospace,
          "emoji_family=" + .runtime.emoji,
          "cjk_sans_family=" + .runtime.cjk_sans,
          "cjk_serif_family=" + .runtime.cjk_serif,
          "gtk3_settings=" + .runtime.gtk3_settings,
          "gtk4_settings=" + .runtime.gtk4_settings,
          "gtk_portal_descriptor=" + .runtime.gtk_portal_descriptor,
          "failure_count=" + (.failure_count|tostring),
          (.failures[]? | "failure=" + .),
          "warning_count=" + (.warning_count|tostring),
          (.warnings[]? | "warning=" + .),
          "network_used=no",
          "mutation=none",
          (if .failure_count == 0 and .warning_count == 0 then "MNX_DESKTOP_AUDIT=PASS" elif .failure_count == 0 then "MNX_DESKTOP_AUDIT=PASS_WITH_WARNINGS" else "MNX_DESKTOP_AUDIT=FAIL" end)
        ] | .[]'
      }

      #@MNX-PART id=99.10.mnx.function.desktop-command kind=function title="Function desktop_command"
      desktop_command() {
        local _command="''${1:-audit}" _json=0 _output _rc=0
        (( $# == 0 )) || shift
        if [[ "''${1:-}" == --json ]]; then _json=1; shift; fi
        (( $# == 0 )) || { echo 'usage: mnx desktop [policy|audit|self-test] [--json]' >&2; return 64; }
        case "$_command" in
          policy)
            _output="$(desktop_policy_json)" || return 1
            if (( _json == 1 )); then printf '%s\n' "$_output"; else printf '%s\n' "$_output" | ${pkgs.jq}/bin/jq -r '["schema="+.schema,"source_sha256="+.source_sha256,"dead_archive_package_removed="+.font_policy.dead_archive_package_removed,"default_serif="+.font_policy.default_serif,"default_sans="+.font_policy.default_sans,"default_monospace="+.font_policy.default_monospace,"default_emoji="+.font_policy.default_emoji,"gtk3_xdg_settings="+.gtk_policy.gtk3_xdg_settings,"gtk4_xdg_settings="+.gtk_policy.gtk4_xdg_settings,"global_gtk_theme_forced="+(.gtk_policy.global_gtk_theme_forced|tostring),"adw_portal_disabled="+(.gtk_policy.adw_portal_disabled|tostring),"network_used=no","mutation=none","MNX_DESKTOP_POLICY=PASS"]|.[]'; fi
            ;;
          audit)
            if _output="$(desktop_audit_json)"; then _rc=0; else _rc=$?; fi
            if (( _json == 1 )); then printf '%s\n' "$_output"; else printf '%s\n' "$_output" | desktop_render_text; fi
            return "$_rc"
            ;;
          self-test)
            (( _json == 0 )) || { echo 'desktop self-test has no JSON mode' >&2; return 64; }
            desktop_self_test
            ;;
          *) echo "unknown mnx desktop command: $_command" >&2; return 64 ;;
        esac
      }

      #@MNX-PART id=99.10.mnx.function.ejection-dispatch-self-test kind=function title="Function ejection_dispatch_self_test"
      ejection_dispatch_self_test() {
        local _route _route_count _help_token
        _route='eject) exec /etc/monsternix/bin/'"mnx-eject"' "$@" ;;'
        _route_count="$(${pkgs.gnugrep}/bin/grep -Fc -- "$_route" "$0" 2>/dev/null || true)"
        [[ "$_route_count" == 1 ]] || {
          echo "MNX_EJECT_DISPATCH_SELF_TEST_ERROR: expected one installed dispatcher route, found $_route_count" >&2
          return 1
        }
        for _help_token in           'mnx eject plan [--json] [--full] [SOURCE]'           'mnx eject transforms [--json] [--full] [SOURCE]'           'mnx eject preview [--json] [--show] [SOURCE]'           'mnx eject verify [SOURCE]'
        do
          ${pkgs.gnugrep}/bin/grep -Fq "$_help_token" "$0" || {
            echo "MNX_EJECT_DISPATCH_SELF_TEST_ERROR: help surface is missing $_help_token" >&2
            return 1
          }
        done
        echo 'MNX_EJECT_DISPATCH_SELF_TEST=PASS'
      }

      #@MNX-PART id=99.10.mnx.function.officer-wake-self-test kind=function title="Function officer_wake_self_test"
      officer_wake_self_test() {
        local _fixture _output _lines _identity_line _next_line _command_line
        _fixture='{"wake":{"schema":"mnx.officer-wake.v1","identity_verified":true,"identity_state":"accepted","accepted_stage":65,"candidate_stage":66,"authority":"current-operator-request-outranks-inherited-intent;handoff-evidence-not-permission","operator_request_status":"not-carried-in-machine-state-use-current-conversation","effective_next_stage":66,"effective_next_objective":"fixture-objective","blocking_state":"none","review_state":"none","unknowns":[],"officer_action":"deliver-one-complete-configuration.nix","operator_commands":{"test":"sudo mnx test","test_reviewed_behavior_change":"sudo mnx test --allow-behavior-change","switch":"sudo mnx switch"},"progressive_disclosure":["mnx brief --full","mnx brief --json","mnx office","mnx help"]},"source":{"editable_sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","active_sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","boot_default_sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","document_schema":"80"},"runtime":{"manager_state":"running","closure_relation":"running-is-boot-default","failed_unit_count":0}}'
        _output="$(printf '%s\n' "$_fixture" | brief_render_text)"
        _lines="$(printf '%s\n' "$_output" | ${pkgs.gawk}/bin/awk 'END {print NR+0}')"
        [[ "$_lines" -le 24 ]] || { echo "MNX_OFFICER_WAKE_SELF_TEST_ERROR: compact wake has $_lines lines" >&2; return 1; }
        ${pkgs.gnugrep}/bin/grep -Fxq 'identity_verified=true' <<< "$_output" || return 1
        ${pkgs.gnugrep}/bin/grep -Fxq 'operator_command_1=sudo mnx test' <<< "$_output" || return 1
        ${pkgs.gnugrep}/bin/grep -Fxq 'operator_command_2=sudo mnx switch' <<< "$_output" || return 1
        ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_OFFICER_WAKE=PASS' <<< "$_output" || return 1
        _identity_line="$(printf '%s\n' "$_output" | ${pkgs.gnugrep}/bin/grep -n '^identity_verified=' | ${pkgs.gawk}/bin/awk -F: '{print $1}')"
        _next_line="$(printf '%s\n' "$_output" | ${pkgs.gnugrep}/bin/grep -n '^effective_next=' | ${pkgs.gawk}/bin/awk -F: '{print $1}')"
        _command_line="$(printf '%s\n' "$_output" | ${pkgs.gnugrep}/bin/grep -n '^operator_command_1=' | ${pkgs.gawk}/bin/awk -F: '{print $1}')"
        [[ "$_identity_line" -lt "$_next_line" && "$_next_line" -lt "$_command_line" ]] || { echo 'MNX_OFFICER_WAKE_SELF_TEST_ERROR: identity/advice/command order differs' >&2; return 1; }
        echo 'MNX_OFFICER_WAKE_SELF_TEST=PASS'
      }

      #@MNX-PART id=99.10.mnx.function.command-surface-self-test kind=function title="Function command_surface_self_test"
      command_surface_self_test() {
        local _unknown_output _unknown_rc _route _needle _count
        ejection_dispatch_self_test
        ${pkgs.gnugrep}/bin/grep -Fq 'COMMAND="''${1:-wake}"' "$0" || { echo 'MNX_COMMAND_SURFACE_SELF_TEST_ERROR: bare mnx does not default to wake' >&2; return 1; }
        _count="$(${pkgs.gnugrep}/bin/grep -Fc '        wake)' "$0" 2>/dev/null || true)"
        [[ "$_count" == 1 ]] || { echo "MNX_COMMAND_SURFACE_SELF_TEST_ERROR: wake route count is $_count" >&2; return 1; }
        ${pkgs.gnugrep}/bin/grep -Fq 'mnx / mnx wake' "$0" || { echo 'MNX_COMMAND_SURFACE_SELF_TEST_ERROR: wake help surface is missing' >&2; return 1; }
        for _route in capsule substrate cloudtainer
        do
          printf -v _needle '%s) exec /etc/monsternix/bin/%s %s "$@" ;;'             "$_route" 'mnx-refactor' "$_route"
          _count="$(${pkgs.gnugrep}/bin/grep -Fc -- "$_needle" "$0" 2>/dev/null || true)"
          [[ "$_count" == 1 ]] || {
            echo "MNX_COMMAND_SURFACE_SELF_TEST_ERROR: expected one installed route for $_route, found $_count" >&2
            return 1
          }
        done
        ${pkgs.gnugrep}/bin/grep -Fq 'mnx capsule inspect SOURCE' "$0" || {
          echo 'MNX_COMMAND_SURFACE_SELF_TEST_ERROR: help surface is missing mnx capsule inspect' >&2
          return 1
        }
        ${pkgs.gnugrep}/bin/grep -Fq 'mnx substrate contract' "$0" || {
          echo 'MNX_COMMAND_SURFACE_SELF_TEST_ERROR: help surface is missing mnx substrate contract' >&2
          return 1
        }
        ${pkgs.gnugrep}/bin/grep -Fq 'mnx substrate reconstruction' "$0" || {
          echo 'MNX_COMMAND_SURFACE_SELF_TEST_ERROR: help surface is missing mnx substrate reconstruction' >&2
          return 1
        }
        ${pkgs.gnugrep}/bin/grep -Fq 'mnx substrate backup-soak' "$0" || {
          echo 'MNX_COMMAND_SURFACE_SELF_TEST_ERROR: help surface is missing mnx substrate backup-soak' >&2
          return 1
        }
        ${pkgs.gnugrep}/bin/grep -Fq 'mnx cloudtainer candidate' "$0" || {
          echo 'MNX_COMMAND_SURFACE_SELF_TEST_ERROR: help surface is missing mnx cloudtainer candidate' >&2
          return 1
        }
        ${pkgs.gnugrep}/bin/grep -Fq 'mnx cloudtainer pack' "$0" || {
          echo 'MNX_COMMAND_SURFACE_SELF_TEST_ERROR: help surface is missing mnx cloudtainer pack' >&2
          return 1
        }
        _needle='upgrade) exec /etc/monsternix/bin/'"mnx-upgrade"' "$@" ;;'
        _count="$(${pkgs.gnugrep}/bin/grep -Fc -- "$_needle" "$0" 2>/dev/null || true)"
        [[ "$_count" == 1 ]] || {
          echo "MNX_COMMAND_SURFACE_SELF_TEST_ERROR: expected one installed route for upgrade, found $_count" >&2
          return 1
        }
        ${pkgs.gnugrep}/bin/grep -Fq 'mnx upgrade build' "$0" || {
          echo 'MNX_COMMAND_SURFACE_SELF_TEST_ERROR: help surface is missing mnx upgrade build' >&2
          return 1
        }
        ${pkgs.gnugrep}/bin/grep -Fq 'mnx desktop audit' "$0" || {
          echo 'MNX_COMMAND_SURFACE_SELF_TEST_ERROR: help surface is missing mnx desktop audit' >&2
          return 1
        }
        _needle='restic) exec /etc/monsternix/bin/'"mnx-restic"' "$@" ;;'
        _count="$(${pkgs.gnugrep}/bin/grep -Fc -- "$_needle" "$0" 2>/dev/null || true)"
        [[ "$_count" == 1 ]] || {
          echo "MNX_COMMAND_SURFACE_SELF_TEST_ERROR: expected one installed route for restic, found $_count" >&2
          return 1
        }
        ${pkgs.gnugrep}/bin/grep -Fq 'mnx restic qualify finalize' "$0" || {
