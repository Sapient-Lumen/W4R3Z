#@MNX-PART id=90.00.monsterdesk.function.f010-process-start-ticks kind=function title="Python function process_start_ticks"
def process_start_ticks(pid: int) -> int:
    text = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
    right = text.rfind(")")
    if right < 0:
        raise MonsterdeskError(f"malformed proc stat for pid {pid}")
    fields = text[right + 2 :].split()
    if len(fields) < 20:
        raise MonsterdeskError(f"short proc stat for pid {pid}")
    return int(fields[19])


#@MNX-PART id=90.00.monsterdesk.function.f011-process-matches kind=function title="Python function process_matches"
def process_matches(pid: int, start_ticks: int) -> bool:
    if pid <= 1 or start_ticks <= 0:
        return False
    try:
        text = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
        right = text.rfind(")")
        if right < 0:
            return False
        fields = text[right + 2:].split()
        if len(fields) < 20:
            return False
        return int(fields[19]) == start_ticks and fields[0] != "Z"
    except (OSError, ValueError):
        return False


#@MNX-PART id=90.00.monsterdesk.function.f012-run-checked kind=function title="Python function run_checked"
def run_checked(argv: list[str], *, env: dict[str, str] | None = None, timeout: float = 15.0,
                input_bytes: bytes | None = None) -> subprocess.CompletedProcess[bytes]:
    try:
        completed = subprocess.run(
            argv,
            input=input_bytes,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise MonsterdeskError(f"command failed to run: {argv[0]}: {exc}") from exc
    if completed.returncode != 0:
        detail = completed.stderr.decode("utf-8", errors="replace")[:1000].strip()
        raise MonsterdeskError(f"command failed rc={completed.returncode}: {argv[0]}: {detail}")
    return completed


#@MNX-PART id=90.00.monsterdesk.function.f013-current-host-environment kind=function title="Python function current_host_environment"
def current_host_environment() -> dict[str, str]:
    display = os.environ.get("DISPLAY", "")
    if not re.fullmatch(r":[0-9]+(?:\.[0-9]+)?", display):
        raise MonsterdeskError("DISPLAY must name the local X11 server")
    xauthority = Path(os.environ.get("XAUTHORITY", str(USER_HOME / ".Xauthority")))
    try:
        st = xauthority.lstat()
    except OSError as exc:
        raise MonsterdeskError(f"Xauthority unavailable: {xauthority}: {exc}") from exc
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
        raise MonsterdeskError(f"Xauthority is unsafe: {xauthority}")
    if stat.S_IMODE(st.st_mode) & 0o077:
        raise MonsterdeskError(f"Xauthority is not private: {xauthority}")
    return {"DISPLAY": display, "XAUTHORITY": str(xauthority)}


#@MNX-PART id=90.00.monsterdesk.function.f014-clean-known-runtime kind=function title="Python function clean_known_runtime"
def clean_known_runtime(root: Path) -> None:
    if root.exists():
        st = root.lstat()
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
            raise MonsterdeskError(f"unsafe stale runtime root: {root}")
        shutil.rmtree(root)
    root.mkdir(mode=0o700)


#@MNX-PART id=90.00.monsterdesk.function.f015-wait-for kind=function title="Python function wait_for"
def wait_for(predicate, timeout: float, description: str) -> None:
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        if predicate():
            return
        time.sleep(0.05)
    raise MonsterdeskError(f"timed out waiting for {description}")


#@MNX-PART id=90.00.monsterdesk.function.f016-find-display-number kind=function title="Python function find_display_number"
def find_display_number() -> int:
    for number in range(DISPLAY_MIN, DISPLAY_MAX + 1):
        if not Path(f"/tmp/.X11-unix/X{number}").exists() and not Path(f"/tmp/.X{number}-lock").exists():
            return number
    raise MonsterdeskError("no private X display number is available")


#@MNX-PART id=90.00.monsterdesk.function.f017-display-env kind=function title="Python function display_env"
def display_env(display_name: str, auth: Path) -> dict[str, str]:
    env = {
        "PATH": str(BASH.parent),
        "HOME": str(USER_HOME),
        "USER": USER_NAME,
        "LOGNAME": USER_NAME,
        "DISPLAY": display_name,
        "XAUTHORITY": str(auth),
        "LANG": os.environ.get("LANG", "C.UTF-8"),
        "LC_ALL": os.environ.get("LC_ALL", "C.UTF-8"),
