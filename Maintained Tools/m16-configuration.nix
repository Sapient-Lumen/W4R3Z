#@MNX-PART id=90.00.monsterdesk.function.f023x-load-cutover-receipt kind=function title="Python function load_nicotine_cutover_receipt"
def load_nicotine_cutover_receipt() -> dict[str, Any] | None:
    path = nicotine_cutover_receipt_path()
    try:
        st = path.lstat()
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        raise MonsterdeskError("Nicotine cutover receipt is not a regular file")
    if st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) != 0o600 or st.st_nlink != 1:
        raise MonsterdeskError("Nicotine cutover receipt ownership, mode, or link count differs")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise MonsterdeskError(f"Nicotine cutover receipt is unreadable: {exc}") from exc
    if (not isinstance(value, dict)
            or value.get("schema") != "mnx.nicotine.cutover-receipt.v1"
            or value.get("committed") is not True
            or not re.fullmatch(r"[0-9a-f]{64}", str(value.get("source_config_sha256", "")))
            or value.get("accepted_stage109_config_sha256") != EXPECTED_NICOTINE_CONFIG_SHA256
            or value.get("port") != EXPECTED_NICOTINE_PORT
            or value.get("instance") != "nicotine"):
        raise MonsterdeskError("Nicotine cutover receipt identity differs")
    return value


#@MNX-PART id=90.00.monsterdesk.function.f023x1-verify-committed-cutover kind=function title="Python function verify_committed_nicotine_cutover"
def verify_committed_nicotine_cutover() -> dict[str, Any]:
    receipt = load_nicotine_cutover_receipt()
    if receipt is None:
        raise MonsterdeskError("committed Nicotine cutover receipt is absent")
    previous_instance = os.environ.get("MONSTERDESK_INSTANCE")
    try:
        os.environ["MONSTERDESK_INSTANCE"] = "nicotine"
        if control_socket_path().is_socket():
            status = call_daemon("status")
        elif unit_active():
            wait_for(lambda: control_socket_path().is_socket(), 12,
                     "committed Nicotine instance control socket")
            status = call_daemon("status")
        else:
            status = start_session(show=False)
        if status.get("instance") != "nicotine":
            raise MonsterdeskError("committed Nicotine daemon published the wrong instance identity")
        app_home = nicotine_cutover_state_root() / "apps/nicotine-live/home"
        seed = verify_nicotine_live_seed(app_home, repair_hardening=True)
        if seed.get("private_config_sha256") != receipt.get("private_config_sha256"):
            raise MonsterdeskError("committed Nicotine seed marker and receipt identities differ")
        launches = [item for item in status.get("launches", [])
                    if item.get("profile") == "nicotine-live" and item.get("alive")]
        if len(launches) > 1:
            raise MonsterdeskError(
                f"committed Nicotine instance has {len(launches)} live launches before hardening"
            )
        restart_evidence: dict[str, Any] | None = None
        if not launches:
            if status.get("version") != VERSION:
                raise MonsterdeskError(
                    "committed Nicotine daemon from another protocol version has no live application; "
                    "candidate test will not stop it without a reversible predecessor restart path"
                )
            launches = [call_daemon("launch", {"profile": "nicotine-live"})["launch"]]
            status = call_daemon("status")
        elif seed.get("private_config_hardening", {}).get("runtime_restart_required") is True:
            if status.get("version") != VERSION:
                raise MonsterdeskError(
                    "committed Nicotine content hardening requires restart but daemon protocol differs"
                )
            restart_evidence = restart_committed_nicotine_for_hardening(launches[0])
            launches = [restart_evidence["launch"]]
            status = call_daemon("status")
        if len(launches) != 1:
            raise MonsterdeskError(f"committed Nicotine instance has {len(launches)} live launches")
        launch = launches[0]
        runtime_before_post_launch_hardening = verify_isolated_nicotine(launch, expected_home=app_home)
        post_launch_hardening = stabilize_nicotine_live_private_config_after_launch(app_home)
        runtime = verify_isolated_nicotine(launch, expected_home=app_home)
        probe = status.get("x11_authentication", {}).get("probes", {}).get("nicotine-live", {})
        if probe.get("state") != "pass" or probe.get("wrong_cookie_rejected") is not True:
            raise MonsterdeskError("committed Nicotine native X authentication proof differs")
        return {
            "schema": "mnx.nicotine.committed-runtime.v2",
            "receipt_committed": True,
            "daemon_version": status.get("version"),
            "daemon_build_revision": status.get("build_revision"),
            "candidate_version_matches_daemon": status.get("version") == VERSION,
            "candidate_build_revision_matches_daemon": status.get("build_revision") == BUILD_REVISION,
            "launch": {
                "launch_id": launch.get("launch_id"),
                "pid": int(launch.get("pid", 0)),
                "start_ticks": int(launch.get("start_ticks", 0)),
                "window_id": int(launch.get("window_id", 0)),
            },
            "runtime_before_post_launch_hardening": runtime_before_post_launch_hardening,
            "runtime": runtime,
            "native_x11_probe": True,
            "private_seed_semantic_boundary": seed.get("semantic_boundary_matched") is True,
            "private_config_hardening": seed.get("private_config_hardening"),
            "post_launch_private_config_hardening": post_launch_hardening,
            "persistent_launch_identity_preserved_during_post_launch_hardening": True,
            "launch_restarted_for_content_hardening": restart_evidence is not None,
            "hardening_restart": restart_evidence,
            "source_state_retained": True,
            "router_state_mutated": False,
        }
    finally:
        if previous_instance is None:
            os.environ.pop("MONSTERDESK_INSTANCE", None)
        else:
            os.environ["MONSTERDESK_INSTANCE"] = previous_instance


#@MNX-PART id=90.00.monsterdesk.function.f023y-scan-live-seed kind=function title="Python function scan_nicotine_live_seed_source"
def scan_nicotine_live_seed_source(source: Path) -> dict[str, int]:
    selected = source.expanduser()
    root = selected.resolve(strict=True)
    root_st = selected.lstat()
    if stat.S_ISLNK(root_st.st_mode) or not stat.S_ISDIR(root_st.st_mode) or root_st.st_uid != USER_UID:
        raise MonsterdeskError(f"Nicotine live-state source is unsafe: {selected}")
    files = 0
    directories = 1
    logical_bytes = 0
    symlinks = 0
    for base, dirs, names in os.walk(selected, followlinks=False):
        base_path = Path(base)
        retained: list[str] = []
        for name in dirs:
            path = base_path / name
            st = path.lstat()
            if st.st_uid != USER_UID:
                raise MonsterdeskError(f"Nicotine live-state object has foreign owner: {path}")
            if stat.S_ISLNK(st.st_mode):
                target = os.readlink(path)
                if os.path.isabs(target):
                    raise MonsterdeskError(f"Nicotine live-state has absolute directory symlink: {path}")
                resolved = (path.parent / target).resolve(strict=False)
                try:
                    resolved.relative_to(root)
                except ValueError as exc:
                    raise MonsterdeskError(f"Nicotine live-state directory symlink escapes source: {path}") from exc
                symlinks += 1
            elif stat.S_ISDIR(st.st_mode):
                directories += 1
                retained.append(name)
            else:
                raise MonsterdeskError(f"Nicotine live-state contains a special directory entry: {path}")
            files += 1
            if files > MAX_NICOTINE_LIVE_SEED_FILES:
                raise MonsterdeskError("Nicotine live-state exceeds object-count limit")
        dirs[:] = retained
        for name in names:
            path = base_path / name
            st = path.lstat()
            if st.st_uid != USER_UID:
                raise MonsterdeskError(f"Nicotine live-state object has foreign owner: {path}")
            files += 1
            if files > MAX_NICOTINE_LIVE_SEED_FILES:
                raise MonsterdeskError("Nicotine live-state exceeds object-count limit")
            if stat.S_ISREG(st.st_mode):
                logical_bytes += st.st_size
                if logical_bytes > MAX_NICOTINE_LIVE_SEED_BYTES:
                    raise MonsterdeskError("Nicotine live-state exceeds logical-byte limit")
            elif stat.S_ISLNK(st.st_mode):
                target = os.readlink(path)
                if os.path.isabs(target):
                    raise MonsterdeskError(f"Nicotine live-state has absolute symlink: {path}")
                resolved = (path.parent / target).resolve(strict=False)
                try:
                    resolved.relative_to(root)
                except ValueError as exc:
                    raise MonsterdeskError(f"Nicotine live-state symlink escapes source: {path}") from exc
                symlinks += 1
            else:
                raise MonsterdeskError(f"Nicotine live-state contains a special file: {path}")
    return {"files": files, "directories": directories, "logical_bytes": logical_bytes, "symlinks": symlinks}


#@MNX-PART id=90.00.monsterdesk.function.f023z-copy-live-seed kind=function title="Python function copy_nicotine_live_seed"
def copy_nicotine_live_seed(source: Path, destination: Path) -> dict[str, Any]:
    inventory = scan_nicotine_live_seed_source(source)
    source_device = int(source.resolve(strict=True).stat().st_dev)
    if destination.exists() or destination.is_symlink():
        raise MonsterdeskError(f"Nicotine private-state destination already exists: {destination}")
    destination.mkdir(parents=True, mode=0o700)
    os.chmod(destination, 0o700)
    destination_device = int(destination.lstat().st_dev)
    result = run_checked([
        str(CP), "-a", "--reflink=auto", "--sparse=always", "--",
        str(source) + "/.", str(destination),
    ], timeout=600)
    if result.stdout or result.stderr:
        raise MonsterdeskError("Nicotine adaptive private-state copy emitted unexpected output")
    st = destination.lstat()
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode) or st.st_uid != USER_UID:
        raise MonsterdeskError("Nicotine private-state destination is unsafe after copy")
    destination_inventory = scan_nicotine_live_seed_source(destination)
    if destination_inventory != inventory:
        raise MonsterdeskError(
            "Nicotine private-state adaptive-copy inventory differs: "
            + canonical({"source": inventory, "destination": destination_inventory})
        )
    return {
        **inventory,
        "copy_mode": "archive-reflink-auto",
        "source": str(source),
        "destination": str(destination),
        "source_device": source_device,
        "destination_device": destination_device,
        "cross_filesystem": source_device != destination_device,
        "clone_required": False,
        "byte_copy_fallback_allowed": True,
        "destination_inventory_matched": True,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023za0-private-semantics kind=function title="Python function nicotine_live_private_config_semantics"
def nicotine_live_private_config_semantics(raw: bytes) -> dict[str, Any]:
    configured = parse_nicotine_config(raw, data_path=USER_HOME / ".local/share/nicotine")
    if configured.get("auto_connect_startup") is not True or configured.get("interface") != "":
        raise MonsterdeskError("Nicotine live private startup or interface policy differs")
    if configured.get("listen_port_range") != [EXPECTED_NICOTINE_PORT, EXPECTED_NICOTINE_PORT]:
        raise MonsterdeskError("Nicotine live private config changed the transfer port")
    server = configured.get("server", {})
    if (server.get("host"), server.get("port")) != EXPECTED_NICOTINE_SERVER:
        raise MonsterdeskError("Nicotine live private config changed the server endpoint")
    shares = sorted(
        (str(item.get("virtual_name", "")), str(item.get("path", "")))
        for item in configured.get("paths", []) if str(item.get("kind", "")).endswith("share")
    )
    if shares != sorted(EXPECTED_NICOTINE_SHARES):
        raise MonsterdeskError("Nicotine live private config changed the reviewed share set")
    by_kind = {str(item.get("kind")): str(item.get("path")) for item in configured.get("paths", [])
               if not str(item.get("kind", "")).endswith("share")}
    if by_kind != {
        "download-dir": str(EXPECTED_NICOTINE_DOWNLOAD),
        "incomplete-dir": str(EXPECTED_NICOTINE_INCOMPLETE),
        "received-dir": str(EXPECTED_NICOTINE_RECEIVED),
    }:
        raise MonsterdeskError("Nicotine live private config changed the reviewed transfer paths")
    return configured


#@MNX-PART id=90.00.monsterdesk.function.f023za1-render-upnp-false kind=function title="Python function render_nicotine_upnp_false"
def render_nicotine_upnp_false(raw: bytes) -> str:
    try:
        text = raw.decode("utf-8", errors="strict")
    except UnicodeDecodeError as exc:
        raise MonsterdeskError(f"private Nicotine config is not strict UTF-8: {exc}") from exc
    lines = text.splitlines(keepends=True)
    section_pattern = re.compile(r"^\s*\[([^]\r\n]+)\]\s*(?:[;#].*)?(?:\r?\n)?$")
    option_pattern = re.compile(r"^(\s*upnp\s*=\s*)([^\r\n]*?)(\r?\n)?$", re.IGNORECASE)
    server_headers: list[int] = []
    upnp_indexes: list[int] = []
    current_section = ""
    for index, line in enumerate(lines):
        section_match = section_pattern.match(line)
        if section_match is not None:
            current_section = section_match.group(1).strip().lower()
            if current_section == "server":
                server_headers.append(index)
            continue
        if current_section == "server" and option_pattern.match(line) is not None:
            upnp_indexes.append(index)
    if len(server_headers) != 1:
        raise MonsterdeskError(f"private Nicotine config expected one server section, found {len(server_headers)}")
    if len(upnp_indexes) > 1:
        raise MonsterdeskError(f"private Nicotine config expected at most one server.upnp option, found {len(upnp_indexes)}")
    if upnp_indexes:
        selected = upnp_indexes[0]
        match = option_pattern.match(lines[selected])
        if match is None:
            raise MonsterdeskError("private Nicotine UPnP option disappeared during rewrite")
        newline = match.group(3) or ""
        lines[selected] = f"{match.group(1)}False{newline}"
    else:
        newline = "\r\n" if any(line.endswith("\r\n") for line in lines) else "\n"
        lines.insert(server_headers[0] + 1, f"upnp = False{newline}")
    return "".join(lines)


#@MNX-PART id=90.00.monsterdesk.function.f023za-rewrite-private-config kind=function title="Python function rewrite_nicotine_private_config"
def rewrite_nicotine_private_config(config_path: Path, *, expected_uid: int = USER_UID) -> dict[str, Any]:
    raw, before = stable_regular_read(config_path, MAX_NICOTINE_CONFIG_BYTES, expected_uid=expected_uid)
    rewritten_text = render_nicotine_upnp_false(raw)
    try:
        original_text = raw.decode("utf-8", errors="strict")
    except UnicodeDecodeError as exc:
        raise MonsterdeskError(f"private Nicotine config is not strict UTF-8: {exc}") from exc
    if rewritten_text == original_text:
        raise MonsterdeskError("private Nicotine UPnP rewrite made no byte change")
    atomic_text(config_path, rewritten_text, 0o600)
    os.chmod(config_path, 0o600)
    private_raw, private_meta = stable_regular_read(config_path, MAX_NICOTINE_CONFIG_BYTES, expected_uid=expected_uid)
    configured = parse_nicotine_config(private_raw, data_path=USER_HOME / ".local/share/nicotine")
    if configured.get("upnp") is not False:
        raise MonsterdeskError("private Nicotine config did not disable UPnP")
    if configured.get("listen_port_range") != [EXPECTED_NICOTINE_PORT, EXPECTED_NICOTINE_PORT]:
        raise MonsterdeskError("private Nicotine config changed the transfer port")
    server = configured.get("server", {})
    if (server.get("host"), server.get("port")) != EXPECTED_NICOTINE_SERVER:
        raise MonsterdeskError("private Nicotine config changed the server endpoint")
    return {
        "source_sha256": before["sha256"], "private_sha256": private_meta["sha256"],
        "private_mode": private_meta["mode"], "upnp": False,
        "credentials_copied": True, "credential_values_exported": False,
        "rewrite_scope": "one-server-upnp-value-only",
    }


#@MNX-PART id=90.00.monsterdesk.function.f023zb-prepare-live-home kind=function title="Python function prepare_nicotine_live_home"
def prepare_nicotine_live_home(home: Path, *, source_config_sha256: str) -> dict[str, Any]:
    marker = home / ".monsterdesk-nicotine-live.json"
    if marker.exists():
        try:
            value = json.loads(marker.read_text(encoding="utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError) as exc:
            raise MonsterdeskError(f"Nicotine live seed marker is unreadable: {exc}") from exc
        if (not isinstance(value, dict)
                or value.get("schema") != "mnx.monsterdesk.nicotine-live-seed.v1"
                or value.get("source_config_sha256") != source_config_sha256
                or value.get("accepted_stage109_config_sha256") != EXPECTED_NICOTINE_CONFIG_SHA256
                or value.get("upnp_disabled") is not True):
            raise MonsterdeskError("Nicotine live seed marker identity differs")
        return {**value, "reused": True}
    if any(home.iterdir()):
        raise MonsterdeskError("Nicotine live private home is not empty before first migration")
    config_source = EXPECTED_NICOTINE_CONFIG_PATH.parent
    data_source = EXPECTED_NICOTINE_DATA_PATH
    config_target = home / ".config/nicotine"
    data_target = home / ".local/share/nicotine"
    config_copy = copy_nicotine_live_seed(config_source, config_target)
    data_copy = copy_nicotine_live_seed(data_source, data_target)
    private_config = config_target / "config"
    rewritten = rewrite_nicotine_private_config(private_config)
    if rewritten["source_sha256"] != source_config_sha256:
        raise MonsterdeskError("Nicotine source config changed during private migration")
    secure_dir(data_target / "received")
    for relative in (Path("downloads"), Path("projects"), Path("syncs/hypertext-h0p3")):
        target = home / relative
        target.mkdir(parents=True, exist_ok=True, mode=0o700)
        if target.is_symlink() or not target.is_dir():
            raise MonsterdeskError(f"Nicotine live mountpoint is unsafe: {target}")
    value = {
        "schema": "mnx.monsterdesk.nicotine-live-seed.v1",
        "profile": "nicotine-live", "created_at": time.time(),
        "source_config_sha256": source_config_sha256,
        "accepted_stage109_config_sha256": EXPECTED_NICOTINE_CONFIG_SHA256,
        "private_config_sha256": rewritten["private_sha256"],
        "private_config_mode": rewritten["private_mode"],
        "upnp_disabled": True, "credentials_copied": True,
        "credential_values_exported": False, "source_state_deleted": False,
        "config_copy": {key: config_copy[key] for key in ("files", "directories", "logical_bytes", "symlinks", "copy_mode", "cross_filesystem", "clone_required", "byte_copy_fallback_allowed")},
        "data_copy": {key: data_copy[key] for key in ("files", "directories", "logical_bytes", "symlinks", "copy_mode", "cross_filesystem", "clone_required", "byte_copy_fallback_allowed")},
        "reused": False,
    }
    atomic_json(marker, value)
    os.chmod(marker, 0o600)
    return value


#@MNX-PART id=90.00.monsterdesk.function.f023zc0-harden-live-private kind=function title="Python function harden_nicotine_live_private_config"
def harden_nicotine_live_private_config(home: Path, *, repair: bool) -> dict[str, Any]:
    config_path = home / ".config/nicotine/config"
    raw_before, meta_before = stable_regular_read(
        config_path, MAX_NICOTINE_CONFIG_BYTES, expected_uid=USER_UID
    )
    configured_before = nicotine_live_private_config_semantics(raw_before)
    upnp_before = configured_before.get("upnp")
    mode_before = int(meta_before["mode"])
    content_rewritten = upnp_before is not False
    mode_repaired = mode_before != 0o600
    drift = content_rewritten or mode_repaired
    if drift and not repair:
        raise MonsterdeskError(
            "Nicotine live private config hardening drift; "
            + canonical({
                "schema": "mnx.nicotine.private-config-hardening.v1",
                "mode_before": mode_before,
                "upnp_before": upnp_before,
                "content_rewrite_required": content_rewritten,
                "mode_repair_required": mode_repaired,
                "credential_values_exported": False,
            })
        )
    if content_rewritten:
        rewritten = render_nicotine_upnp_false(raw_before)
        atomic_text(config_path, rewritten, 0o600)
    elif mode_repaired:
        os.chmod(config_path, 0o600)
    raw_after, meta_after = stable_regular_read(
        config_path, MAX_NICOTINE_CONFIG_BYTES, expected_uid=USER_UID
    )
    configured_after = nicotine_live_private_config_semantics(raw_after)
    if configured_after.get("upnp") is not False or int(meta_after["mode"]) != 0o600:
        raise MonsterdeskError(
            "Nicotine live private config hardening repair did not converge; "
            + canonical({
                "mode_after": int(meta_after["mode"]),
                "upnp_after": configured_after.get("upnp"),
                "credential_values_exported": False,
            })
        )
    return {
        "schema": "mnx.nicotine.private-config-hardening.v1",
        "repair_authorized": repair,
        "changed": drift,
        "content_rewritten": content_rewritten,
        "mode_repaired": mode_repaired,
        "runtime_restart_required": content_rewritten,
        "mode_before": mode_before,
        "mode_after": int(meta_after["mode"]),
        "upnp_before": upnp_before,
        "upnp_after": False,
        "sha256_before": meta_before["sha256"],
        "sha256_after": meta_after["sha256"],
        "immutable_semantics_checked_before_mutation": True,
        "immutable_semantics_matched_after": True,
        "credential_values_exported": False,
        "router_state_mutated": False,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023zc-verify-live-seed kind=function title="Python function verify_nicotine_live_seed"
def verify_nicotine_live_seed(home: Path, *, repair_hardening: bool = True) -> dict[str, Any]:
    marker = home / ".monsterdesk-nicotine-live.json"
    try:
        st = marker.lstat()
    except OSError as exc:
        raise MonsterdeskError(f"Nicotine live seed marker is unavailable: {exc}") from exc
    if (stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode)
            or st.st_uid != USER_UID or stat.S_IMODE(st.st_mode) != 0o600 or st.st_nlink != 1):
        raise MonsterdeskError("Nicotine live seed marker ownership, mode, type, or link count differs")
    try:
        value = json.loads(marker.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise MonsterdeskError(f"Nicotine live seed marker is unreadable: {exc}") from exc
    if (not isinstance(value, dict)
            or value.get("schema") != "mnx.monsterdesk.nicotine-live-seed.v1"
            or not re.fullmatch(r"[0-9a-f]{64}", str(value.get("source_config_sha256", "")))
            or value.get("accepted_stage109_config_sha256") != EXPECTED_NICOTINE_CONFIG_SHA256
            or value.get("upnp_disabled") is not True
            or value.get("credentials_copied") is not True
            or value.get("credential_values_exported") is not False
            or value.get("source_state_deleted") is not False):
        raise MonsterdeskError("Nicotine live seed contract differs")
    hardening = harden_nicotine_live_private_config(home, repair=repair_hardening)
    return {
        **value,
        "semantic_boundary_matched": True,
        "private_config_current_sha256": hardening["sha256_after"],
        "private_config_hardening": hardening,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023zc1-restart-hardened-live kind=function title="Python function restart_committed_nicotine_for_hardening"
def restart_committed_nicotine_for_hardening(launch: dict[str, Any]) -> dict[str, Any]:
    launch_id = str(launch.get("launch_id", ""))
    if not launch_id:
        raise MonsterdeskError("committed Nicotine hardening restart lacks a launch identity")
    attempts: list[dict[str, Any]] = []
    result = call_daemon("terminate", {"launch_id": launch_id, "signal": "TERM"})
    attempts.append(result)
    if result.get("terminated") is not True:
        result = call_daemon("terminate", {"launch_id": launch_id, "signal": "KILL"})
        attempts.append(result)
    if result.get("terminated") is not True:
        raise MonsterdeskError("committed Nicotine content repair could not stop the exact launch")
    wait_for(
        lambda: not any(item.get("profile") == "nicotine-live" and item.get("alive")
                        for item in call_daemon("processes")["processes"]),
        15,
        "absence of the repaired committed Nicotine launch",
    )
    wait_for(nicotine_host_port_available, 20, "release of TCP 2234 before hardened Nicotine restart")
    launch_error: Exception | None = None
    restarted: dict[str, Any] | None = None
    for _attempt in range(2):
        try:
            restarted = call_daemon("launch", {"profile": "nicotine-live"})["launch"]
            break
        except Exception as exc:
            launch_error = exc
            time.sleep(0.5)
    if restarted is None:
        raise MonsterdeskError(f"committed Nicotine content repair could not relaunch the isolated client: {launch_error}")
    return {
        "restarted": True,
        "previous_launch_id": launch_id,
        "launch": restarted,
        "stop_attempts": attempts,
        "router_state_mutated": False,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023zc2-post-launch-hardening kind=function title="Python function stabilize_nicotine_live_private_config_after_launch"
def stabilize_nicotine_live_private_config_after_launch(
    home: Path, *, sample_delay_seconds: float = 0.5,
) -> dict[str, Any]:
    if not (0.0 <= sample_delay_seconds <= 1.0):
        raise MonsterdeskError("Nicotine post-launch hardening sample delay is outside policy")
    config_path = home / ".config/nicotine/config"
    samples: list[dict[str, Any]] = []
    stable_unchanged_samples = 0
    required_unchanged_samples = 3
    minimum_sample_count = 4
    maximum_sample_count = 8
    for sample_index in range(1, maximum_sample_count + 1):
        raw_before, meta_before = stable_regular_read(
            config_path, MAX_NICOTINE_CONFIG_BYTES, expected_uid=USER_UID
        )
        configured_before = nicotine_live_private_config_semantics(raw_before)
        mode_before = int(meta_before["mode"])
        upnp_before = configured_before.get("upnp")
        if upnp_before is not False:
            raise MonsterdeskError(
                "Nicotine changed security content after launch; post-launch convergence refuses "
                "content repair without a controlled restart; "
                + canonical({
                    "schema": "mnx.nicotine.post-launch-private-config.v1",
                    "sample_index": sample_index,
                    "mode_before": mode_before,
                    "upnp_before": upnp_before,
                    "content_rewrite_required": True,
                    "mode_repair_required": mode_before != 0o600,
                    "credential_values_exported": False,
                })
            )
        mode_repair_attempted = mode_before != 0o600
        if mode_repair_attempted:
            os.chmod(config_path, 0o600)
        raw_after, meta_after = stable_regular_read(
            config_path, MAX_NICOTINE_CONFIG_BYTES, expected_uid=USER_UID
        )
        configured_after = nicotine_live_private_config_semantics(raw_after)
        mode_after = int(meta_after["mode"])
        upnp_after = configured_after.get("upnp")
        if upnp_after is not False:
            raise MonsterdeskError(
                "Nicotine security content changed during post-launch mode convergence; "
                + canonical({
                    "schema": "mnx.nicotine.post-launch-private-config.v1",
                    "sample_index": sample_index,
                    "mode_after": mode_after,
                    "upnp_after": upnp_after,
                    "credential_values_exported": False,
                })
            )
        mode_repaired = mode_repair_attempted and mode_after == 0o600
        sample = {
            "sample_index": sample_index,
            "changed": mode_repair_attempted,
            "content_rewritten": False,
            "mode_repair_attempted": mode_repair_attempted,
            "mode_repaired": mode_repaired,
            "mode_before": mode_before,
            "mode_after": mode_after,
            "upnp_before": upnp_before,
            "upnp_after": upnp_after,
            "sha256_before": meta_before["sha256"],
            "sha256_after": meta_after["sha256"],
        }
        samples.append(sample)
        if mode_after != 0o600 or mode_repair_attempted:
            stable_unchanged_samples = 0
        else:
            stable_unchanged_samples += 1
        if (sample_index >= minimum_sample_count
                and stable_unchanged_samples >= required_unchanged_samples):
            final = harden_nicotine_live_private_config(home, repair=False)
            return {
                "schema": "mnx.nicotine.post-launch-private-config.v1",
                "converged": True,
                "sample_count": len(samples),
                "minimum_sample_count": minimum_sample_count,
                "maximum_sample_count": maximum_sample_count,
                "required_unchanged_samples": required_unchanged_samples,
                "observed_unchanged_samples": stable_unchanged_samples,
                "sample_delay_seconds": sample_delay_seconds,
                "mode_repair_attempt_count": sum(1 for item in samples if item["mode_repair_attempted"]),
                "mode_repair_count": sum(1 for item in samples if item["mode_repaired"]),
                "content_rewrite_count": 0,
                "runtime_restart_required": False,
                "final_mode": final.get("mode_after"),
                "final_upnp": final.get("upnp_after"),
                "final_sha256": final.get("sha256_after"),
                "samples": samples,
                "credential_values_exported": False,
                "router_state_mutated": False,
            }
        if sample_delay_seconds:
            time.sleep(sample_delay_seconds)
    raise MonsterdeskError(
        "Nicotine post-launch private-config mode did not stabilize; "
        + canonical({
            "schema": "mnx.nicotine.post-launch-private-config.v1",
            "sample_count": len(samples),
            "minimum_sample_count": minimum_sample_count,
            "maximum_sample_count": maximum_sample_count,
            "required_unchanged_samples": required_unchanged_samples,
            "observed_unchanged_samples": stable_unchanged_samples,
            "mode_repair_attempt_count": sum(1 for item in samples if item["mode_repair_attempted"]),
            "mode_repair_count": sum(1 for item in samples if item["mode_repaired"]),
            "content_rewrite_count": 0,
            "samples": samples,
            "credential_values_exported": False,
        })
    )


#@MNX-PART id=90.00.monsterdesk.function.f023zd-port-available kind=function title="Python function nicotine_host_port_available"
def nicotine_host_port_available() -> bool:
    candidate = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    candidate.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        candidate.bind((EXPECTED_NICOTINE_LISTENER_ADDRESS, EXPECTED_NICOTINE_PORT))
        return True
    except OSError:
        return False
    finally:
        candidate.close()


#@MNX-PART id=90.00.monsterdesk.function.f023zd1-process-identity kind=function title="Python function process_identity"
def process_identity(pid: int) -> dict[str, Any]:
    if pid <= 1:
        raise MonsterdeskError("process identity pid is invalid")
    stat_path = Path(f"/proc/{pid}/stat")
    status_path = Path(f"/proc/{pid}/status")
    raw_before = stat_path.read_text(encoding="utf-8")
    left_before = raw_before.find("(")
    right_before = raw_before.rfind(")")
    if left_before < 0 or right_before <= left_before:
        raise MonsterdeskError(f"malformed proc stat for pid {pid}")
    fields_before = raw_before[right_before + 2:].split()
    if len(fields_before) < 20:
        raise MonsterdeskError(f"short proc stat for pid {pid}")
    status_raw = status_path.read_text(encoding="utf-8", errors="strict")
    uid_line = next((line for line in status_raw.splitlines() if line.startswith("Uid:")), None)
    if uid_line is None:
        raise MonsterdeskError(f"proc status lacks Uid fields for pid {pid}")
    uid_tokens = uid_line.split()
    if len(uid_tokens) != 5 or uid_tokens[0] != "Uid:" or not all(token.isdigit() for token in uid_tokens[1:]):
        raise MonsterdeskError(f"malformed proc status Uid fields for pid {pid}")
    uid_values = [int(token) for token in uid_tokens[1:]]
    raw_after = stat_path.read_text(encoding="utf-8")
    left_after = raw_after.find("(")
    right_after = raw_after.rfind(")")
    if left_after < 0 or right_after <= left_after:
        raise MonsterdeskError(f"malformed second proc stat for pid {pid}")
    fields_after = raw_after[right_after + 2:].split()
    if len(fields_after) < 20:
        raise MonsterdeskError(f"short second proc stat for pid {pid}")
    if int(fields_before[19]) != int(fields_after[19]):
        raise MonsterdeskError(f"process identity changed during proc status read for pid {pid}")
    proc_stat_owner_uid = int(stat_path.stat().st_uid)
    return {
        "pid": pid,
        "uid": uid_values[1],
        "uid_real": uid_values[0],
        "uid_effective": uid_values[1],
        "uid_saved": uid_values[2],
        "uid_filesystem": uid_values[3],
        "uid_set": uid_values,
        "proc_stat_owner_uid": proc_stat_owner_uid,
        "proc_stat_owner_is_authority": False,
        "comm": raw_after[left_after + 1:right_after][:128],
        "state": fields_after[0],
        "ppid": int(fields_after[1]),
        "pgrp": int(fields_after[2]),
        "session": int(fields_after[3]),
        "start_ticks": int(fields_after[19]),
    }


#@MNX-PART id=90.00.monsterdesk.function.f023zd2-birth-pinned-alive kind=function title="Python function birth_pinned_process_alive"
def birth_pinned_process_alive(record: dict[str, Any]) -> bool:
    try:
        current = process_identity(int(record["pid"]))
    except (OSError, ValueError, KeyError, MonsterdeskError):
        return False
    expected_uid = int(record.get("uid", USER_UID))
    expected_uid_set = list(record.get("uid_set", [expected_uid, expected_uid, expected_uid, expected_uid]))
    return (current["uid_set"] == expected_uid_set
            and current["start_ticks"] == int(record["start_ticks"])
            and current["state"] != "Z")


#@MNX-PART id=90.00.monsterdesk.function.f023zd3-birth-pinned-tree kind=function title="Python function birth_pinned_process_tree"
def birth_pinned_process_tree(root_pid: int, root_ticks: int) -> list[dict[str, Any]]:
    root = process_identity(root_pid)
    if (root["uid_set"] != [USER_UID, USER_UID, USER_UID, USER_UID]
            or root["start_ticks"] != root_ticks or root["state"] == "Z"):
        raise MonsterdeskError("launch root identity changed before process-tree snapshot")
    snapshot: dict[int, dict[str, Any]] = {}
    for entry in sorted(Path("/proc").iterdir(), key=lambda item: int(item.name) if item.name.isdigit() else 10**12):
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        try:
            value = process_identity(pid)
        except (OSError, ValueError, MonsterdeskError):
            continue
        if value["uid_set"] == [USER_UID, USER_UID, USER_UID, USER_UID]:
            snapshot[pid] = value
    selected = {root_pid}
    changed = True
    while changed:
        changed = False
        for pid, value in snapshot.items():
            if pid not in selected and value["ppid"] in selected:
                selected.add(pid)
                changed = True
    if len(selected) > 256:
        raise MonsterdeskError(f"Nicotine launch tree exceeds process bound: {len(selected)}")
    records: list[dict[str, Any]] = []
    for pid in selected:
        value = dict(snapshot[pid])
        depth = 0
        cursor = pid
        seen: set[int] = set()
        while cursor != root_pid:
            if cursor in seen or cursor not in snapshot:
                raise MonsterdeskError("Nicotine launch tree ancestry is inconsistent")
            seen.add(cursor)
            cursor = int(snapshot[cursor]["ppid"])
            depth += 1
        value["depth"] = depth
        records.append(value)
    records.sort(key=lambda item: (int(item["depth"]), int(item["pid"])))
    return records


#@MNX-PART id=90.00.monsterdesk.function.f023zd4-terminate-birth-pinned-tree kind=function title="Python function terminate_birth_pinned_process_tree"
def terminate_birth_pinned_process_tree(records: list[dict[str, Any]]) -> dict[str, Any]:
    unique = {(int(item["pid"]), int(item["start_ticks"])): dict(item) for item in records}
    ordered = sorted(unique.values(), key=lambda item: (int(item.get("depth", 0)), int(item["pid"])), reverse=True)
    term_sent = 0
    kill_sent = 0
    for item in ordered:
        if not birth_pinned_process_alive(item):
            continue
        try:
            os.kill(int(item["pid"]), signal.SIGTERM)
            term_sent += 1
        except ProcessLookupError:
            pass
        except OSError as exc:
            raise MonsterdeskError(f"could not TERM birth-pinned cutover pid {item['pid']}: {exc}") from exc
    deadline = time.monotonic() + 2.0
    while time.monotonic() < deadline and any(birth_pinned_process_alive(item) for item in ordered):
        time.sleep(0.05)
    for item in ordered:
        if not birth_pinned_process_alive(item):
            continue
        try:
            os.kill(int(item["pid"]), signal.SIGKILL)
            kill_sent += 1
        except ProcessLookupError:
            pass
        except OSError as exc:
            raise MonsterdeskError(f"could not KILL birth-pinned cutover pid {item['pid']}: {exc}") from exc
    deadline = time.monotonic() + 4.0
    while time.monotonic() < deadline and any(birth_pinned_process_alive(item) for item in ordered):
        time.sleep(0.05)
    survivors = [item for item in ordered if birth_pinned_process_alive(item)]
    if survivors:
        raise MonsterdeskError("birth-pinned cutover processes survived bounded escalation: "
                               + canonical([{"pid": item["pid"], "comm": item["comm"]} for item in survivors]))
    return {
        "record_count": len(ordered),
        "term_sent": term_sent,
        "kill_sent": kill_sent,
        "survivor_count": 0,
        "birth_pinned": True,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023zd5-listener-holders kind=function title="Python function nicotine_listener_holders"
def nicotine_listener_holders() -> list[dict[str, Any]]:
    inodes: set[str] = set()
    target_port = f"{EXPECTED_NICOTINE_PORT:04X}"
    for table in (Path("/proc/net/tcp"), Path("/proc/net/tcp6")):
        try:
            rows = table.read_text(encoding="ascii", errors="strict").splitlines()[1:]
        except (OSError, UnicodeError):
            continue
        for row in rows[:4096]:
            fields = row.split()
            if len(fields) < 10 or fields[3] != "0A":
                continue
            local = fields[1].rsplit(":", 1)
            if len(local) == 2 and local[1].upper() == target_port:
                inodes.add(fields[9])
    if not inodes:
        return []
    holders: list[dict[str, Any]] = []
    for entry in sorted(Path("/proc").iterdir(), key=lambda item: int(item.name) if item.name.isdigit() else 10**12):
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        try:
            identity = process_identity(pid)
        except (OSError, ValueError, MonsterdeskError):
            continue
        if identity["uid_set"] != [USER_UID, USER_UID, USER_UID, USER_UID]:
            continue
        fd_root = entry / "fd"
        try:
            descriptors = list(fd_root.iterdir())[:4096]
        except OSError:
            continue
        owns = False
        for descriptor in descriptors:
            try:
                target = os.readlink(descriptor)
            except OSError:
                continue
            match = re.fullmatch(r"socket:\[([0-9]+)\]", target)
            if match and match.group(1) in inodes:
                owns = True
                break
        if not owns:
            continue
        try:
            executable = os.readlink(entry / "exe")
        except OSError:
            executable = "unavailable"
        holders.append({
            "pid": pid,
            "start_ticks": identity["start_ticks"],
            "comm": identity["comm"],
            "executable_name": Path(executable).name,
        })
        if len(holders) >= 16:
            break
    return holders


#@MNX-PART id=90.00.monsterdesk.function.f023zd6-stale-cutover-processes kind=function title="Python function stale_nicotine_cutover_processes"
def stale_nicotine_cutover_processes() -> list[dict[str, Any]]:
    isolated_nicotine = {
        int(item["pid"]) for item in nicotine_process_inventory()
        if nicotine_client_process(item) and item.get("host_network_namespace") is False
    }
    seeds: list[tuple[int, int]] = []
    pasta_port = f"{EXPECTED_NICOTINE_LISTENER_ADDRESS}/{EXPECTED_NICOTINE_PORT}"
    for entry in sorted(Path("/proc").iterdir(), key=lambda item: int(item.name) if item.name.isdigit() else 10**12):
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        try:
            identity = process_identity(pid)
        except (OSError, ValueError, MonsterdeskError):
            continue
        if identity["uid_set"] != [USER_UID, USER_UID, USER_UID, USER_UID]:
            continue
        raw = proc_bytes(entry / "cmdline", 131072)
        arguments = [item.decode("utf-8", errors="replace") for item in raw.split(b"\0") if item]
        joined = "\n".join(arguments)
        try:
            executable = os.readlink(entry / "exe")
        except OSError:
            executable = "unavailable"
        exact_pasta = ((str(PASTA) in arguments or executable == str(PASTA))
                       and "--tcp-ports" in arguments and pasta_port in arguments)
        owned_runtime = ("monsterdesk-acceptance-" in joined or "monsterdesk-nicotine" in joined)
        live_profile = "nicotine-live" in joined
        if pid in isolated_nicotine or exact_pasta or (owned_runtime and live_profile):
            seeds.append((pid, int(identity["start_ticks"])))
    records: dict[tuple[int, int], dict[str, Any]] = {}
    for pid, ticks in seeds:
        try:
            tree = birth_pinned_process_tree(pid, ticks)
        except (OSError, ValueError, MonsterdeskError):
            continue
        for item in tree:
            records[(int(item["pid"]), int(item["start_ticks"]))] = item
    return sorted(records.values(), key=lambda item: (int(item.get("depth", 0)), int(item["pid"])))


#@MNX-PART id=90.00.monsterdesk.function.f023zd7-cleanup-stale-cutover kind=function title="Python function cleanup_stale_nicotine_cutover_processes"
def cleanup_stale_nicotine_cutover_processes() -> dict[str, Any]:
    legacy_before = ready_legacy_nicotine()
    records = stale_nicotine_cutover_processes()
    result: dict[str, Any] = {
        "stale_record_count": len(records),
        "cleanup_performed": bool(records),
        "legacy_already_ready": legacy_before is not None,
    }
    if records:
        result["termination"] = terminate_birth_pinned_process_tree(records)
    wait_for(lambda: not any(nicotine_client_process(item) and item.get("host_network_namespace") is False
                             for item in nicotine_process_inventory()),
             10, "absence of stale isolated Nicotine clients")
    # A healthy legacy listener legitimately occupies TCP 2234. Otherwise the
    # exact stale-cutover cleanup must prove the port has become available.
    if legacy_before is None and ready_legacy_nicotine() is None:
        try:
            wait_for(nicotine_host_port_available, 15, "release of stale cutover TCP 2234")
        except MonsterdeskError as exc:
            raise MonsterdeskError(
                f"stale cutover cleanup did not release TCP 2234; holders={canonical(nicotine_listener_holders())}"
            ) from exc
    return result

#@MNX-PART id=90.00.monsterdesk.function.f023zd8-quiesce-launch kind=function title="Python function quiesce_nicotine_launch"
def quiesce_nicotine_launch(session: Any, launch_id: str | None,
                             tree: list[dict[str, Any]]) -> dict[str, Any]:
    tracked_kill: dict[str, Any] | None = None
    if launch_id is not None:
        with contextlib.suppress(Exception):
            if any(item.get("launch_id") == launch_id for item in session.processes()):
                tracked_kill = session.terminate(launch_id, "KILL")
    termination = terminate_birth_pinned_process_tree(tree) if tree else {
        "record_count": 0, "term_sent": 0, "kill_sent": 0,
        "survivor_count": 0, "birth_pinned": True,
    }
    stale = stale_nicotine_cutover_processes()
    if stale:
        followup = terminate_birth_pinned_process_tree(stale)
    else:
        followup = {"record_count": 0, "term_sent": 0, "kill_sent": 0,
                    "survivor_count": 0, "birth_pinned": True}
    wait_for(lambda: not any(nicotine_client_process(item) and item.get("host_network_namespace") is False
                             for item in nicotine_process_inventory()),
             10, "isolated Nicotine process-tree quiescence")
    try:
        wait_for(nicotine_host_port_available, 15, "release of host TCP 2234 after isolated close")
    except MonsterdeskError as exc:
        raise MonsterdeskError(
            f"isolated Nicotine close did not release TCP 2234; holders={canonical(nicotine_listener_holders())}"
        ) from exc
    return {
        "tracked_kill": tracked_kill,
        "initial_tree": termination,
        "followup_tree": followup,
        "host_port_released": True,
        "isolated_clients_remaining": 0,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023zd9-redact-legacy-log kind=function title="Python function redact_legacy_log"
def redact_legacy_log(text: str) -> str:
    value = re.sub(r"(?i)(login|passw|password|token|secret|credential)(\s*[:=]\s*)\S+",
                   r"\1\2<redacted>", text)
    value = re.sub(r"([A-Za-z][A-Za-z0-9+.-]*://)[^/@\s:]+(?::[^@\s]*)?@", r"\1<redacted>@", value)
    return value[-4000:]


#@MNX-PART id=90.00.monsterdesk.function.f023zda-bounded-pipe-logger kind=function title="Python function spawn_bounded_pipe_logger"
def spawn_bounded_pipe_logger(stream: Any, path: Path) -> subprocess.Popen[bytes]:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with contextlib.suppress(FileNotFoundError):
        path.unlink()
    logger_code = (
        "import os,sys\n"
        "path=sys.argv[1]\n"
        "limit=int(sys.argv[2])\n"
        "buf=bytearray()\n"
        "fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600)\n"
        "try:\n"
        " while True:\n"
        "  chunk=sys.stdin.buffer.read1(8192)\n"
        "  if not chunk: break\n"
        "  buf.extend(chunk)\n"
        "  if len(buf)>limit: del buf[:-limit]\n"
        "  os.lseek(fd,0,os.SEEK_SET); os.ftruncate(fd,0); os.write(fd,buf)\n"
        " os.fsync(fd)\n"
        "finally:\n"
        " os.close(fd)\n"
    )
    logger = subprocess.Popen(
        [str(PYTHON), "-c", logger_code, str(path), str(MAX_LOG_FILE_BYTES)],
        stdin=stream, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        close_fds=True, start_new_session=True,
    )
    stream.close()
    return logger

#@MNX-PART id=90.00.monsterdesk.function.f023ze-stop-legacy kind=function title="Python function stop_legacy_nicotine"
def stop_legacy_nicotine(inputs: dict[str, Any]) -> dict[str, Any]:
    pid = int(inputs["live_pid"])
    ticks = int(inputs["live_start_ticks"])
    if not process_matches(pid, ticks):
        raise MonsterdeskError("legacy Nicotine process identity changed before stop")
    method = "term"
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    except OSError as exc:
        raise MonsterdeskError(f"could not stop legacy Nicotine: {exc}") from exc
    deadline = time.monotonic() + 20
    while time.monotonic() < deadline and process_matches(pid, ticks):
        time.sleep(0.1)
    if process_matches(pid, ticks):
        method = "kill"
        with contextlib.suppress(ProcessLookupError):
            os.kill(pid, signal.SIGKILL)
        wait_for(lambda: not process_matches(pid, ticks), 5, "legacy Nicotine process exit")
    # The direct fallback can be a child of this audit. A clean exit may leave
    # it briefly in Z state until its parent reaps it; Z is already non-live,
    # and waitpid is attempted only for this exact birth-pinned pid.
    with contextlib.suppress(ChildProcessError, OSError):
        os.waitpid(pid, os.WNOHANG)
    wait_for(lambda: not any(nicotine_client_process(item) and item.get("host_network_namespace") is True
                             for item in nicotine_process_inventory()),
             10, "absence of host-network Nicotine clients")
    wait_for(nicotine_host_port_available, 10, "release of host TCP 2234")
    return {"stopped": True, "method": method, "pid": pid, "start_ticks": ticks}


#@MNX-PART id=90.00.monsterdesk.function.f023zf-start-legacy kind=function title="Python function start_legacy_nicotine"
def start_legacy_nicotine() -> dict[str, Any]:
    if not NICOTINE_LEGACY.is_file() or not os.access(NICOTINE_LEGACY, os.X_OK):
        raise MonsterdeskError(f"legacy Nicotine rollback launcher is unavailable: {NICOTINE_LEGACY}")
    existing = ready_legacy_nicotine()
    if existing is not None:
        return {**existing, "restored": True, "already_running": True,
                "startup_diagnostics_bounded": True}
    cleanup = cleanup_stale_nicotine_cutover_processes()
    existing = ready_legacy_nicotine()
    if existing is not None:
        return {**existing, "restored": True, "already_running": True,
                "stale_cleanup": cleanup, "startup_diagnostics_bounded": True}
    host_clients = [item for item in nicotine_process_inventory()
                    if nicotine_client_process(item) and item.get("host_network_namespace") is True]
    if host_clients:
        raise MonsterdeskError("a host-network Nicotine process exists without the reviewed TCP 2234 listener")
    try:
        wait_for(nicotine_host_port_available, 15, "host TCP 2234 availability before legacy restart")
    except MonsterdeskError as exc:
        raise MonsterdeskError(
            f"legacy Nicotine restart is blocked by TCP 2234 holders={canonical(nicotine_listener_holders())}"
        ) from exc
    host = current_host_environment()
    allowed_environment = {
        "XDG_SESSION_TYPE", "XDG_CURRENT_DESKTOP", "XDG_SESSION_DESKTOP", "DESKTOP_SESSION",
        "GDK_BACKEND", "GTK_THEME", "PULSE_SERVER", "PIPEWIRE_REMOTE",
        "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME", "LANG", "LC_ALL", "LC_CTYPE",
    }
    env = {key: value for key, value in os.environ.items()
           if key in allowed_environment and isinstance(value, str) and len(value) <= 4096}
    env.update({
        "HOME": str(USER_HOME), "USER": USER_NAME, "LOGNAME": USER_NAME,
        "SHELL": str(BASH), "PATH": "/run/current-system/sw/bin:/run/wrappers/bin",
        "DISPLAY": host["DISPLAY"], "XAUTHORITY": host["XAUTHORITY"],
        "XDG_RUNTIME_DIR": str(runtime_base()),
        "DBUS_SESSION_BUS_ADDRESS": f"unix:path={runtime_base()}/bus",
        "GDK_BACKEND": "x11",
        "LANG": env.get("LANG", "C.UTF-8"),
    })
    if "LC_ALL" not in env and "LC_CTYPE" not in env:
        env["LC_ALL"] = "C.UTF-8"
    log_root = secure_dir(runtime_base() / "monsterdesk-nicotine-rollback")
    log_path = log_root / f"legacy-start-{os.getpid()}-{secrets.token_hex(4)}.log"
    try:
        process = subprocess.Popen(
            [str(NICOTINE_LEGACY)], stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            env=env, cwd=str(USER_HOME), start_new_session=True, close_fds=True,
        )
    except OSError as exc:
        raise MonsterdeskError(f"could not execute legacy Nicotine rollback launcher: {exc}") from exc
    if process.stdout is None:
        raise MonsterdeskError("legacy Nicotine rollback launcher has no diagnostic stream")
    logger = spawn_bounded_pipe_logger(process.stdout, log_path)
    launcher_ticks = 0
    with contextlib.suppress(OSError, ValueError, MonsterdeskError):
        launcher_ticks = process_start_ticks(process.pid)
    deadline = time.monotonic() + 90
    while time.monotonic() < deadline:
        selected = ready_legacy_nicotine()
        if selected is not None:
            return {
                **selected,
                "restored": True,
                "already_running": False,
                "stale_cleanup": cleanup,
                "launcher_pid": process.pid,
                "launcher_start_ticks": launcher_ticks,
                "launcher_returncode": process.poll(),
                "diagnostic_log_path": str(log_path),
                "startup_diagnostics_bounded": True,
            }
        time.sleep(0.25)
    failed_clients = [item for item in nicotine_process_inventory()
                      if nicotine_client_process(item) and item.get("host_network_namespace") is True]
    failed_records: list[dict[str, Any]] = []
    for item in failed_clients:
        try:
            failed_records.append(process_identity(int(item["pid"])))
        except (OSError, ValueError, MonsterdeskError):
            continue
    if launcher_ticks and process_matches(process.pid, launcher_ticks):
        with contextlib.suppress(OSError):
            os.killpg(process.pid, signal.SIGTERM)
    if failed_records:
        with contextlib.suppress(Exception):
            terminate_birth_pinned_process_tree(failed_records)
    if launcher_ticks and process_matches(process.pid, launcher_ticks):
        with contextlib.suppress(OSError):
            os.killpg(process.pid, signal.SIGKILL)
    with contextlib.suppress(Exception):
        process.wait(timeout=3)
    with contextlib.suppress(Exception):
        logger.wait(timeout=3)
    diagnostic = {
        "launcher_returncode": process.poll(),
        "host_client_count": len(failed_clients),
        "host_clients": [{"pid": item.get("pid"), "comm": item.get("comm"),
                          "executable_name": Path(str(item.get("executable", ""))).name}
                         for item in failed_clients[:8]],
        "listener_holders": nicotine_listener_holders(),
        "log_tail": redact_legacy_log(bounded_log_tail(log_path)),
        "log_bytes_bounded": MAX_LOG_FILE_BYTES,
    }
    raise MonsterdeskError("legacy Nicotine rollback did not restore the host-network TCP 2234 listener; "
                           + canonical(diagnostic))

#@MNX-PART id=90.00.monsterdesk.function.f023zf1-ready-legacy kind=function title="Python function ready_legacy_nicotine"
def ready_legacy_nicotine() -> dict[str, Any] | None:
    clients = [item for item in nicotine_process_inventory()
               if nicotine_client_process(item) and item.get("host_network_namespace") is True]
    if len(clients) > 1:
        raise MonsterdeskError(f"multiple host-network Nicotine clients exist: {len(clients)}")
    if not clients:
        return None
    selected = clients[0]
    listener = any(endpoint.get("kind") == "listen"
                   and endpoint.get("protocol") in {"tcp", "tcp6"}
                   and str(endpoint.get("address")) == EXPECTED_NICOTINE_LISTENER_ADDRESS
                   and int(endpoint.get("port", 0)) == EXPECTED_NICOTINE_PORT
                   for endpoint in selected.get("local_endpoints", []))
    if not listener:
        return None
    return {
        "pid": int(selected["pid"]), "start_ticks": int(selected["start_ticks"]),
        "host_network_namespace": True, "listener_port": EXPECTED_NICOTINE_PORT,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023zf2-ensure-legacy kind=function title="Python function ensure_legacy_nicotine_running"
def ensure_legacy_nicotine_running() -> dict[str, Any]:
    selected = ready_legacy_nicotine()
    if selected is not None:
        return {**selected, "restored": True, "already_running": True,
                "startup_diagnostics_bounded": True}
    cleanup = cleanup_stale_nicotine_cutover_processes()
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        selected = ready_legacy_nicotine()
        if selected is not None:
            return {**selected, "restored": True, "already_running": True,
                    "stale_cleanup": cleanup, "startup_diagnostics_bounded": True}
        clients = [item for item in nicotine_process_inventory()
                   if nicotine_client_process(item) and item.get("host_network_namespace") is True]
        if not clients:
            break
        time.sleep(0.25)
    clients = [item for item in nicotine_process_inventory()
               if nicotine_client_process(item) and item.get("host_network_namespace") is True]
    if clients:
        records: list[dict[str, Any]] = []
        for item in clients:
            try:
                records.append(process_identity(int(item["pid"])))
            except (OSError, ValueError, MonsterdeskError):
                continue
        if records:
            terminate_birth_pinned_process_tree(records)
        wait_for(nicotine_host_port_available, 15, "release of partial legacy TCP 2234")
    return start_legacy_nicotine()


#@MNX-PART id=90.00.monsterdesk.function.f023zf2a-normalize-cutover-prestate kind=function title="Python function normalize_legacy_nicotine_cutover_prestate"
def normalize_legacy_nicotine_cutover_prestate(
    ensure_fn: Any = ensure_legacy_nicotine_running,
    inspect_fn: Any = inspect_nicotine_boundary,
    qualify_fn: Any = nicotine_cutover_inputs,
) -> dict[str, Any]:
    legacy = ensure_fn()
    preflight = inspect_fn()
    inputs = qualify_fn(preflight, require_accepted_hash=False)
    legacy_pid = int(legacy.get("pid", 0))
    legacy_ticks = int(legacy.get("start_ticks", 0))
    if (legacy_pid <= 0 or legacy_ticks <= 0
            or legacy.get("host_network_namespace") is not True
            or int(legacy.get("listener_port", 0)) != EXPECTED_NICOTINE_PORT
            or legacy.get("startup_diagnostics_bounded") is not True):
        raise MonsterdeskError("normalized legacy Nicotine prestate lacks reviewed process and listener evidence")
    if (int(inputs.get("live_pid", 0)) != legacy_pid
            or int(inputs.get("live_start_ticks", 0)) != legacy_ticks):
        raise MonsterdeskError("legacy Nicotine identity changed between prestate recovery and cutover qualification")
    evidence = {
        "schema": "mnx.nicotine.cutover-prestate.v1",
        "qualified": True,
        "legacy_already_running": legacy.get("already_running") is True,
        "legacy_started_for_cutover": legacy.get("already_running") is False,
        "host_network_namespace": True,
        "listener_port": EXPECTED_NICOTINE_PORT,
        "pid_birth_pin_matched": True,
        "startup_diagnostics_bounded": True,
        "source_config_sha256": str(inputs.get("config_sha256", "")),
        "original_state_deleted": False,
        "router_state_mutated": False,
    }
    return {"inputs": inputs, "evidence": evidence}


#@MNX-PART id=90.00.monsterdesk.function.f023zf3-parse-mountinfo kind=function title="Python function parse_mountinfo"
def parse_mountinfo(raw: bytes) -> dict[str, dict[str, Any]]:
    if len(raw) > MAX_NICOTINE_MOUNTINFO_BYTES:
        raise MonsterdeskError("Nicotine mountinfo exceeds byte policy")
    try:
        text = raw.decode("utf-8", errors="strict")
    except UnicodeDecodeError as exc:
        raise MonsterdeskError(f"Nicotine mountinfo is not strict UTF-8: {exc}") from exc

    #@MNX-PART id=90.00.monsterdesk.function.f023zf3a-mountinfo-decode kind=function title="Python function mountinfo decode"
    def decode(value: str) -> str:
        return re.sub(r"\\([0-7]{3})", lambda match: chr(int(match.group(1), 8)), value)

    mounts: dict[str, dict[str, Any]] = {}
    for line in text.splitlines():
        before, separator, after = line.partition(" - ")
        fields = before.split()
        trailing = after.split()
        if not separator or len(fields) < 6 or len(trailing) < 3:
            raise MonsterdeskError("Nicotine mountinfo row is malformed")
        try:
            mount_id = int(fields[0])
        except ValueError as exc:
            raise MonsterdeskError("Nicotine mountinfo mount id is invalid") from exc
        mountpoint = decode(fields[4])
        options = set(fields[5].split(","))
        mode = "ro" if "ro" in options else "rw" if "rw" in options else "unknown"
        current = mounts.get(mountpoint)
        if current is None or mount_id > int(current["mount_id"]):
            mounts[mountpoint] = {
                "mount_id": mount_id, "mode": mode, "filesystem": trailing[0],
            }
    return mounts


#@MNX-PART id=90.00.monsterdesk.function.f023zf3b-share-paths kind=function title="Python function nicotine_share_paths"
def nicotine_share_paths(entries: Any = EXPECTED_NICOTINE_SHARES) -> tuple[Path, ...]:
    if not isinstance(entries, tuple):
        raise MonsterdeskError("canonical Nicotine share set is not a tuple")
    names: set[str] = set()
    paths: set[Path] = set()
    ordered: list[Path] = []
    for entry in entries:
        if not isinstance(entry, tuple) or len(entry) != 2:
            raise MonsterdeskError("canonical Nicotine share entry is not a two-item tuple")
        virtual_name, raw_path = entry
        if (not isinstance(virtual_name, str)
                or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._ -]{0,127}", virtual_name)
                or virtual_name in names):
            raise MonsterdeskError("canonical Nicotine share virtual name is invalid or duplicated")
        if not isinstance(raw_path, str):
            raise MonsterdeskError("canonical Nicotine share path is not text")
        path = Path(raw_path)
        normalized = Path(os.path.normpath(raw_path))
        if not path.is_absolute() or path == Path("/") or normalized != path:
            raise MonsterdeskError("canonical Nicotine share path is not normalized absolute state")
        if path in paths:
            raise MonsterdeskError("canonical Nicotine share path is duplicated")
        names.add(virtual_name)
        paths.add(path)
        ordered.append(path)
    if len(ordered) != 4:
        raise MonsterdeskError("canonical Nicotine share set must contain exactly four paths")
    return tuple(ordered)


#@MNX-PART id=90.00.monsterdesk.function.f023zf3c-live-bind-specs kind=function title="Python function nicotine_live_bind_specs"
def nicotine_live_bind_specs() -> list[tuple[Path, str, bool]]:
    share_paths = nicotine_share_paths()
    if (not EXPECTED_NICOTINE_DOWNLOAD.is_absolute()
            or EXPECTED_NICOTINE_DOWNLOAD == Path("/")
            or EXPECTED_NICOTINE_DOWNLOAD in share_paths):
        raise MonsterdeskError("canonical Nicotine download path is invalid or overlaps a share")
    return [
        *((path, "read-only", True) for path in share_paths),
        (EXPECTED_NICOTINE_DOWNLOAD, "read-write", True),
    ]


#@MNX-PART id=90.00.monsterdesk.function.f023zf4-mount-boundary kind=function title="Python function verify_nicotine_mount_boundary"
def verify_nicotine_mount_boundary(pid: int, expected_home: Path) -> dict[str, Any]:
    if pid <= 0:
        raise MonsterdeskError("Nicotine mount-boundary pid is invalid")
    mountinfo_path = Path(f"/proc/{pid}/mountinfo")
    try:
        raw = mountinfo_path.read_bytes()
    except OSError as exc:
        raise MonsterdeskError(f"Nicotine mountinfo is unreadable: {exc}") from exc
    mounts = parse_mountinfo(raw)
    expected_modes: dict[str, str] = {
        str(USER_HOME): "rw",
        "/nix/store": "ro",
        "/run/monsterdesk-control": "ro",
        "/tmp/.X11-unix": "ro",
        "/etc/resolv.conf": "ro",
        str(EXPECTED_NICOTINE_DOWNLOAD): "rw",
    }
    share_paths = nicotine_share_paths()
    expected_modes.update({str(path): "ro" for path in share_paths})
    missing = sorted(path for path in expected_modes if path not in mounts)
    wrong = sorted(
        (
            {"path": path, "expected": mode, "observed": mounts[path]["mode"]}
            for path, mode in expected_modes.items()
            if path in mounts and mounts[path]["mode"] != mode
        ),
        key=lambda item: item["path"],
    )
    if missing or wrong:
        raise MonsterdeskError(
            "Nicotine mount boundary differs: " + canonical({"missing": missing, "wrong": wrong})
        )
    root = Path(f"/proc/{pid}/root")
    expected_stat = expected_home.stat()
    try:
        process_home_stat = (root / USER_HOME.relative_to("/")).stat()
        original_home_stat = USER_HOME.stat()
    except OSError as exc:
        raise MonsterdeskError(f"Nicotine private-home identity is unreadable: {exc}") from exc
    if (process_home_stat.st_dev, process_home_stat.st_ino) != (expected_stat.st_dev, expected_stat.st_ino):
        raise MonsterdeskError("Nicotine guest home is not the source-owned private home")
    if (process_home_stat.st_dev, process_home_stat.st_ino) == (original_home_stat.st_dev, original_home_stat.st_ino):
        raise MonsterdeskError("Nicotine guest received the ordinary host home")
    bind_sources = [*share_paths, EXPECTED_NICOTINE_DOWNLOAD]
    identity_mismatches: list[dict[str, Any]] = []
    for source in bind_sources:
        try:
            source_stat = source.stat()
            guest_stat = (root / source.relative_to("/")).stat()
        except OSError as exc:
            raise MonsterdeskError(f"Nicotine exact bind identity is unreadable for {source}: {exc}") from exc
        if (source_stat.st_dev, source_stat.st_ino) != (guest_stat.st_dev, guest_stat.st_ino):
            identity_mismatches.append({"path": str(source), "identity_matched": False})
    if identity_mismatches:
        raise MonsterdeskError("Nicotine exact bind source identities differ: " + canonical(identity_mismatches))
    forbidden = [
        USER_HOME / ".ssh", USER_HOME / ".gnupg", USER_HOME / ".mozilla",
        USER_HOME / ".config/i3", Path(f"/run/user/{USER_UID}/bus"),
    ]
    exposed: list[str] = []
    for path in forbidden:
        candidate = root / path.relative_to("/")
        try:
            candidate.lstat()
        except FileNotFoundError:
            continue
        except OSError as exc:
            raise MonsterdeskError(f"Nicotine forbidden-path probe failed for {path}: {exc}") from exc
        exposed.append(str(path))
    if exposed:
        raise MonsterdeskError("Nicotine private root exposes forbidden host paths: " + canonical(exposed))
    return {
        "matched": True, "private_home_identity_matched": True,
        "ordinary_host_home_donated": False, "host_session_bus_donated": False,
        "read_only_share_count": len(share_paths),
        "read_write_download_count": 1,
        "expected_mount_modes": expected_modes,
        "bind_source_identities_matched": True,
        "exact_bind_source_count": len(bind_sources),
        "raw_mountinfo_exported": False,
    }

#@MNX-PART id=90.00.monsterdesk.function.f023zg-verify-isolated kind=function title="Python function verify_isolated_nicotine"
def verify_isolated_nicotine(tracked: dict[str, Any], *, expected_home: Path) -> dict[str, Any]:
    pasta_pid = int(tracked.get("pid", 0))
    pasta_ticks = int(tracked.get("start_ticks", 0))
    if not process_matches(pasta_pid, pasta_ticks):
        raise MonsterdeskError("Nicotine pasta launch identity is not alive")
    selected: dict[str, Any] | None = None
    selected_pasta: dict[str, Any] = {}
    selected_namespace: dict[str, Any] = {}
    selected_log: dict[str, Any] = {}
    selected_forward: dict[str, Any] = {
        "attempted": False, "connectable": False, "raw_error_exported": False,
    }
    established_count = 0
    last_readiness: dict[str, Any] = {
        "pasta_birth_pinned_alive": True,
        "pasta_command_exact": False,
        "pasta_socket_table_listener_observed": False,
        "pasta_listener_addresses": [],
        "host_forward_connectable": False,
        "host_network_nicotine_count": 0,
        "isolated_nicotine_count": 0,
        "namespace_socket_table_readable": False,
        "guest_listener_observed": False,
        "guest_listener_source": "none",
        "outbound_established_socket_count": 0,
        "outbound_connection_observed": False,
        "outbound_connection_source": "none",
        "explicit_private_paths_observed": False,
        "remote_endpoints_exported": False,
    }
    deadline = time.monotonic() + 90
    next_forward_probe = 0.0
    while time.monotonic() < deadline:
        inventory = [item for item in nicotine_process_inventory() if nicotine_client_process(item)]
        host_clients = [item for item in inventory if item.get("host_network_namespace") is True]
        isolated = [item for item in inventory if item.get("host_network_namespace") is False]
        pasta_evidence = nicotine_pasta_runtime_evidence(pasta_pid, pasta_ticks)
        log_evidence = nicotine_readiness_log_evidence(tracked.get("log_path"))
        explicit_paths = False
        namespace_value: dict[str, Any] = {
            "table_readable": False, "endpoints": [], "remote_endpoints_exported": False,
        }
        candidate: dict[str, Any] | None = isolated[0] if len(isolated) == 1 else None
        guest_listener_table = False
        if candidate is not None:
            namespace_value = network_namespace_socket_endpoints(Path(f"/proc/{int(candidate['pid'])}"))
            namespace_endpoints = namespace_value.get("endpoints", [])
            guest_listener_table = any(
                item.get("protocol") in {"tcp", "tcp6"}
                and item.get("kind") == "listen"
                and int(item.get("port", 0)) == EXPECTED_NICOTINE_PORT
                for item in namespace_endpoints
            )
            established_count = nicotine_outbound_established_count(namespace_endpoints)
            arguments = candidate.get("arguments", [])
            explicit_paths = (str(USER_HOME / ".config/nicotine/config") in arguments
                              and str(USER_HOME / ".local/share/nicotine") in arguments)
        else:
            established_count = 0

        now = time.monotonic()
        if (candidate is not None
                and pasta_evidence.get("birth_pinned_command_exact") is True
                and (guest_listener_table or log_evidence.get("listener_success_observed") is True)
                and selected_forward.get("connectable") is not True
                and now >= next_forward_probe):
            selected_forward = nicotine_host_forward_connect_evidence()
            next_forward_probe = now + 1.0

        guest_listener_log = log_evidence.get("listener_success_observed") is True
        guest_listener_proved = guest_listener_table or (
            guest_listener_log and selected_forward.get("connectable") is True
        )
        outbound_log = log_evidence.get("server_connection_observed") is True
        outbound_proved = established_count >= 1 or outbound_log
        guest_source = "namespace-table" if guest_listener_table else (
            "exact-log-plus-active-host-forward" if guest_listener_proved else "none"
        )
        outbound_source = "namespace-table" if established_count >= 1 else (
            "exact-application-log" if outbound_log else "none"
        )
        last_readiness = {
            "pasta_birth_pinned_alive": pasta_evidence.get("birth_pinned_alive") is True,
            "pasta_command_exact": pasta_evidence.get("birth_pinned_command_exact") is True,
            "pasta_socket_table_listener_observed": pasta_evidence.get("listener_observed") is True,
            "pasta_listener_addresses": pasta_evidence.get("listener_addresses", []),
            "pasta_socket_table_observation_authority": "diagnostic-only",
            "host_forward_connectable": selected_forward.get("connectable") is True,
            "host_forward_error_errno": selected_forward.get("error_errno"),
            "host_network_nicotine_count": len(host_clients),
            "isolated_nicotine_count": len(isolated),
            "namespace_socket_table_readable": namespace_value.get("table_readable") is True,
            "guest_listener_observed": guest_listener_proved,
            "guest_listener_source": guest_source,
            "outbound_established_socket_count": established_count,
            "outbound_connection_observed": outbound_proved,
            "outbound_connection_source": outbound_source,
            "explicit_private_paths_observed": explicit_paths,
            "remote_endpoints_exported": False,
        }
        if (not host_clients and candidate is not None
                and pasta_evidence.get("birth_pinned_alive") is True
                and pasta_evidence.get("birth_pinned_command_exact") is True
                and selected_forward.get("connectable") is True
                and guest_listener_proved and outbound_proved and explicit_paths):
            selected = candidate
            selected_pasta = pasta_evidence
            selected_namespace = namespace_value
            selected_log = log_evidence
            break
        time.sleep(0.25)
    if selected is None:
        diagnostic = {
            "schema": "mnx.nicotine.isolated-readiness.v2",
            **last_readiness,
            "host_forward": selected_forward,
            "application_log": nicotine_readiness_log_evidence(tracked.get("log_path")),
            "credential_values_exported": False,
            "remote_peer_endpoints_exported": False,
        }
        raise MonsterdeskError("isolated Nicotine readiness timed out; " + canonical(diagnostic))
    namespaces = selected.get("namespaces", {})
    if namespaces.get("net") in {"unavailable", os.readlink("/proc/self/ns/net")}:
        raise MonsterdeskError("isolated Nicotine did not receive a distinct network namespace")
    if namespaces.get("mnt") in {"unavailable", os.readlink("/proc/self/ns/mnt")}:
        raise MonsterdeskError("isolated Nicotine did not receive a distinct mount namespace")
    filesystem = verify_nicotine_mount_boundary(int(selected["pid"]), expected_home)
    final_forward = nicotine_host_forward_connect_evidence()
    if final_forward.get("connectable") is not True:
        raise MonsterdeskError(
            "pasta TCP 2234 exact-address host-to-namespace forward is not connectable; "
            + canonical(final_forward)
        )
    return {
        "isolated": True,
        "pasta_host_listener": True,
        "pasta_command_exact": selected_pasta.get("birth_pinned_command_exact") is True,
        "pasta_interface": NICOTINE_HOST_INTERFACE,
        "pasta_address_bound_port_spec": (
            f"{EXPECTED_NICOTINE_LISTENER_ADDRESS}/{EXPECTED_NICOTINE_PORT}"
        ),
        "pasta_listener_addresses_diagnostic": selected_pasta.get("listener_addresses", []),
        "pasta_socket_table_observation_authority": "diagnostic-only",
        "host_connect_address": EXPECTED_NICOTINE_LISTENER_ADDRESS,
        "listener_port": EXPECTED_NICOTINE_PORT,
        "namespace_socket_table_readable": selected_namespace.get("table_readable") is True,
        "guest_listener_observed": True,
        "guest_listener_source": last_readiness.get("guest_listener_source"),
        "outbound_established_socket_count": established_count,
        "outbound_connection_observed": True,
        "outbound_connection_source": last_readiness.get("outbound_connection_source"),
        "listener_port_connections_excluded_from_outbound_count": True,
        "exact_log_listener_marker_observed": selected_log.get("listener_success_observed") is True,
        "exact_log_server_connection_marker_observed": selected_log.get("server_connection_observed") is True,
        "host_network_nicotine_count": 0, "isolated_nicotine_count": 1,
        "network_namespace_distinct": True, "mount_namespace_distinct": True,
        "filesystem_boundary": filesystem, "filesystem_boundary_matched": True,
        "host_to_namespace_tcp_connect": True,
        "remote_endpoints_exported": False, "credentials_exported": False,
        "share_contents_read": False,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023zga-runtime-evidence-contract kind=function title="Python function nicotine_runtime_evidence_complete"
