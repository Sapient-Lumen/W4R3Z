#@MNX-PART id=90.00.monsterdesk.function.f023s-pasta-local-namespace-probe kind=function title="Python function pasta_local_namespace_probe"
def pasta_local_namespace_probe() -> dict[str, Any]:
    host_port = reserve_loopback_port()
    namespace_port = reserve_loopback_port()
    while namespace_port == host_port:
        namespace_port = reserve_loopback_port()
    blocked_listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    blocked_listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    blocked_listener.bind(("127.0.0.1", 0))
    blocked_listener.listen(1)
    blocked_port = int(blocked_listener.getsockname()[1])
    token = secrets.token_hex(24)
    child_code = r"""
import hashlib,json,os,socket,sys
ready_path,result_path,token,namespace_port_text,blocked_port_text = sys.argv[1:]
namespace_port = int(namespace_port_text)
blocked_port = int(blocked_port_text)
blocked = False
probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
probe.settimeout(0.5)
try:
    probe.connect(("127.0.0.1", blocked_port))
except OSError:
    blocked = True
finally:
    probe.close()
server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
server.bind(("127.0.0.1", namespace_port))
server.listen(1)
server.settimeout(15)
ready_tmp = ready_path + ".tmp"
with open(ready_tmp, "w", encoding="utf-8") as handle:
    json.dump({"netns": os.readlink("/proc/self/ns/net"), "blocked_host_loopback": blocked}, handle, sort_keys=True)
os.replace(ready_tmp, ready_path)
connection, _address = server.accept()
connection.settimeout(5)
received = connection.recv(4096).decode("ascii")
digest = hashlib.sha256(received.encode("ascii")).hexdigest()
connection.sendall(digest.encode("ascii"))
connection.close()
server.close()
result_tmp = result_path + ".tmp"
with open(result_tmp, "w", encoding="utf-8") as handle:
    json.dump({"token_matched": received == token, "blocked_host_loopback": blocked, "digest": digest}, handle, sort_keys=True)
os.replace(result_tmp, result_path)
raise SystemExit(0 if received == token and blocked else 3)
"""
    process: subprocess.Popen[bytes] | None = None
    try:
        with tempfile.TemporaryDirectory(prefix="monsterdesk-pasta-", dir=runtime_base()) as directory:
            root = Path(directory)
            ready = root / "ready.json"
            result_path = root / "result.json"
            child = [str(PYTHON), "-c", child_code, str(ready), str(result_path), token,
                     str(namespace_port), str(blocked_port)]
            command = pasta_local_probe_command(host_port, namespace_port, child)
            process = subprocess.Popen(
                command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                start_new_session=True,
            )
            wait_for(lambda: ready.is_file() or process.poll() is not None, 12,
                     "pasta namespace probe readiness")
            if not ready.is_file():
                _stdout, stderr = process.communicate(timeout=3)
                raise MonsterdeskError(
                    "pasta namespace probe exited before readiness: "
                    + stderr[:MAX_LOG_TAIL_BYTES].decode("utf-8", errors="replace")
                )
            ready_value = json.loads(ready.read_text(encoding="utf-8"))
            response = b""
            deadline = time.monotonic() + 10
            while time.monotonic() < deadline:
                connection = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                connection.settimeout(1)
                try:
                    connection.connect(("127.0.0.1", host_port))
                    connection.sendall(token.encode("ascii"))
                    response = connection.recv(4096)
                    break
                except OSError:
                    time.sleep(0.1)
                finally:
                    connection.close()
            expected_digest = hashlib.sha256(token.encode("ascii")).hexdigest().encode("ascii")
            if response != expected_digest:
                raise MonsterdeskError("pasta host-to-namespace TCP forwarding probe did not return the token digest")
            stdout, stderr = process.communicate(timeout=10)
            if process.returncode != 0:
                raise MonsterdeskError(
                    f"pasta namespace probe failed rc={process.returncode}: "
                    + stderr[:MAX_LOG_TAIL_BYTES].decode("utf-8", errors="replace")
                )
            result = json.loads(result_path.read_text(encoding="utf-8"))
            host_netns = os.readlink("/proc/self/ns/net")
            if ready_value.get("netns") == host_netns:
                raise MonsterdeskError("pasta probe did not create a distinct network namespace")
            if ready_value.get("blocked_host_loopback") is not True or result.get("blocked_host_loopback") is not True:
                raise MonsterdeskError("pasta probe namespace could reach an unforwarded host-loopback service")
            if result.get("token_matched") is not True:
                raise MonsterdeskError("pasta probe child did not receive the exact token")
            return {
                "state": "pass", "schema": "mnx.monsterdesk.pasta-local-probe.v1",
                "separate_network_namespace": True,
                "host_to_namespace_tcp_forward": True,
                "unforwarded_host_loopback_blocked": True,
                "external_network_attempted": False,
                "protocol": "tcp", "host_bind_address": "127.0.0.1",
                "pasta_stdout_bytes": len(stdout), "pasta_stderr_bytes": len(stderr),
                "raw_output_exported": False,
            }
    finally:
        blocked_listener.close()
        if process is not None and process.poll() is None:
            with contextlib.suppress(OSError):
                os.killpg(process.pid, signal.SIGTERM)
            with contextlib.suppress(Exception):
                process.wait(timeout=2)
            if process.poll() is None:
                with contextlib.suppress(OSError):
                    os.killpg(process.pid, signal.SIGKILL)
                with contextlib.suppress(Exception):
                    process.wait(timeout=2)


