          return result
      #@MNX-PART id=99.91.mnx-presslog-observe.function.stable-read-status kind=function title="Python function stable_read_status"
      def stable_read_status(path: Path, uid: int, unsafe: list[str], after_read_hook: Any | None = None) -> tuple[bytes | None, bool]:
          flags = os.O_RDONLY | os.O_CLOEXEC | getattr(os, 'O_NOFOLLOW', 0)
          try:
              descriptor = os.open(path, flags)
          except FileNotFoundError:
              return None, False
          except OSError:
              note_unsafe(unsafe, 'status-open-failed')
              return None, False
          try:
              before = os.fstat(descriptor)
              if not stat.S_ISREG(before.st_mode):
                  note_unsafe(unsafe, 'status-type')
                  return None, False
              if before.st_uid != uid or stat.S_IMODE(before.st_mode) != 0o600 or before.st_size > MAX_STATUS_BYTES:
                  note_unsafe(unsafe, 'status-metadata')
                  return None, False
              chunks: list[bytes] = []
              remaining = MAX_STATUS_BYTES + 1
              while remaining > 0:
                  block = os.read(descriptor, min(remaining, 8192))
                  if not block:
                      break
                  chunks.append(block)
                  remaining -= len(block)
              raw = b'''.join(chunks)
              after = os.fstat(descriptor)
          finally:
              os.close(descriptor)
          descriptor_before = (before.st_dev, before.st_ino, before.st_uid, before.st_gid, stat.S_IMODE(before.st_mode), before.st_size, before.st_mtime_ns)
          descriptor_after = (after.st_dev, after.st_ino, after.st_uid, after.st_gid, stat.S_IMODE(after.st_mode), after.st_size, after.st_mtime_ns)
          if descriptor_before != descriptor_after:
              note_unsafe(unsafe, 'status-descriptor-mutated')
              return None, False
          if len(raw) > MAX_STATUS_BYTES:
              note_unsafe(unsafe, 'status-oversize')
              return None, False
          if after_read_hook is not None:
              after_read_hook()
          current = safe_lstat(path)
          if current is None:
              note_unsafe(unsafe, 'status-current-path-missing')
              return None, False
          if stat.S_ISLNK(current.st_mode) or not stat.S_ISREG(current.st_mode):
              note_unsafe(unsafe, 'status-current-path-type')
              return None, False
          if current.st_uid != uid or stat.S_IMODE(current.st_mode) != 0o600 or current.st_size > MAX_STATUS_BYTES:
              note_unsafe(unsafe, 'status-current-path-metadata')
              return None, False
          replaced = (current.st_dev, current.st_ino) != (after.st_dev, after.st_ino)
          return raw, replaced

      #@MNX-PART id=99.91.mnx-presslog-observe.function.read-status-metadata kind=function title="Python function read_status_metadata"
      def read_status_metadata(path: Path, uid: int, unsafe: list[str], after_read_hook: Any | None = None) -> tuple[dict[str, str], bool]:
          raw, replaced = stable_read_status(path, uid, unsafe, after_read_hook)
          if raw is None:
              return {}, replaced
          try:
              payload = json.loads(raw.decode('utf-8', errors='strict'))
          except (UnicodeDecodeError, json.JSONDecodeError):
              note_unsafe(unsafe, 'status-json-invalid')
              return {}, replaced
          if not isinstance(payload, dict):
              note_unsafe(unsafe, 'status-json-shape')
              return {}, replaced
          result: dict[str, str] = {}
          for key in ('pid', 'epoch', 'events'):
              value = payload.get(key)
              rendered = str(value) if isinstance(value, (str, int)) and not isinstance(value, bool) else '''
              if rendered and SAFE_INTEGER.fullmatch(rendered):
                  result[key] = rendered
          for key in ('paused', 'burn', 'auto_expire'):
              value = payload.get(key)
              if isinstance(value, bool):
                  result[key] = str(value).lower()
              elif isinstance(value, str) and value.lower() in {'true', 'false', '0', '1'}:
                  result[key] = value.lower()
          for key in ('started', 'version'):
              value = payload.get(key)
              if isinstance(value, str) and SAFE_TOKEN.fullmatch(value):
                  result[key] = value
          segment = payload.get('segment')
          if isinstance(segment, str) and SAFE_TOKEN.fullmatch(segment):
              result['segment'] = segment
          return result, replaced
      #@MNX-PART id=99.91.mnx-presslog-observe.function.user-unit-state kind=function title="Python function user_unit_state"
      def user_unit_state(unit: str) -> dict[str, str]:
          runtime = Path('/run/user/1000')
          bus = runtime / 'bus'
          if not bus.is_socket():
              return {'load': 'unavailable', 'active': 'unavailable', 'sub': 'unavailable', 'result': 'unavailable'}
          env = dict(os.environ)
          env.update({'HOME': '/home/h0p3', 'XDG_RUNTIME_DIR': str(runtime), 'DBUS_SESSION_BUS_ADDRESS': f'unix:path={bus}', 'LC_ALL': 'C'})
          command = [str(RUNUSER), '-u', EXPECTED_USER, '--', str(SYSTEMCTL), '--user', 'show', unit, '--property=LoadState,ActiveState,SubState,Result', '--value']
          try:
              completed = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, env=env, timeout=10, check=False)
          except (OSError, subprocess.TimeoutExpired):
              return {'load': 'unavailable', 'active': 'unavailable', 'sub': 'unavailable', 'result': 'unavailable'}
          values = completed.stdout.splitlines()
          while len(values) < 4:
              values.append('unknown')
          return {'load': values[0], 'active': values[1], 'sub': values[2], 'result': values[3]}
      
      #@MNX-PART id=99.91.mnx-presslog-observe.function.current-boot-id kind=function title="Python function current_boot_id"
      def current_boot_id() -> str:
          try:
              value = BOOT_ID_PATH.read_text(encoding='ascii').strip()
          except OSError as exc:
              raise ObserverError(f'boot id is unavailable: {exc}') from exc
          if not re.fullmatch(r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}', value):
              raise ObserverError('boot id format differs')
          return value

      #@MNX-PART id=99.91.mnx-presslog-observe.function.read-bounded-json kind=function title="Python function read_bounded_json"
      def read_bounded_json(path: Path, uid: int, allowed_modes: set[int], expected_schema: str | None = None) -> dict[str, Any] | None:
          flags = os.O_RDONLY | os.O_CLOEXEC | getattr(os, 'O_NOFOLLOW', 0)
          try:
              descriptor = os.open(path, flags)
          except FileNotFoundError:
              return None
          except OSError as exc:
              raise ObserverError(f'metadata receipt open failed: {path}: {exc}') from exc
          try:
              before = os.fstat(descriptor)
              if not stat.S_ISREG(before.st_mode) or before.st_uid != uid or stat.S_IMODE(before.st_mode) not in allowed_modes:
                  raise ObserverError(f'unsafe metadata receipt descriptor: {path}')
              if before.st_size <= 0 or before.st_size > MAX_STATUS_BYTES:
                  raise ObserverError(f'metadata receipt size differs: {path}')
              chunks: list[bytes] = []
              remaining = MAX_STATUS_BYTES + 1
              while remaining > 0:
                  chunk = os.read(descriptor, min(8192, remaining))
                  if not chunk:
                      break
                  chunks.append(chunk)
                  remaining -= len(chunk)
              payload = b'''.join(chunks)
              after = os.fstat(descriptor)
          finally:
              os.close(descriptor)
          identity = lambda value: (value.st_dev, value.st_ino, value.st_uid, value.st_gid, stat.S_IMODE(value.st_mode), value.st_size, value.st_mtime_ns)
          if identity(before) != identity(after) or len(payload) != before.st_size or len(payload) > MAX_STATUS_BYTES:
              raise ObserverError(f'metadata receipt changed while reading: {path}')
          current = safe_lstat(path)
          if current is None or stat.S_ISLNK(current.st_mode) or not stat.S_ISREG(current.st_mode) or current.st_uid != uid or stat.S_IMODE(current.st_mode) not in allowed_modes or current.st_size <= 0 or current.st_size > MAX_STATUS_BYTES:
              raise ObserverError(f'current metadata receipt path is unsafe: {path}')
          try:
              record = json.loads(payload.decode('utf-8', errors='strict'))
          except (UnicodeDecodeError, json.JSONDecodeError) as exc:
              raise ObserverError(f'metadata receipt JSON is invalid: {path}: {exc}') from exc
          if not isinstance(record, dict):
              raise ObserverError(f'metadata receipt is not an object: {path}')
          if expected_schema is not None and record.get('schema') != expected_schema:
              raise ObserverError(f'metadata receipt schema differs: {path}')
          return record
      #@MNX-PART id=99.91.mnx-presslog-observe.function.read-success-receipt kind=function title="Python function read_success_receipt"
      def read_success_receipt(path: Path, expected_name: str, logbook_gid: int) -> dict[str, Any]:
          flags = os.O_RDONLY | os.O_CLOEXEC | getattr(os, 'O_NOFOLLOW', 0)
          try:
              descriptor = os.open(path, flags)
          except FileNotFoundError:
              return {'present': False, 'epoch': 0, 'result': 'missing', 'timestamp': 'unknown'}
          except OSError as exc:
              raise ObserverError(f'backup success receipt open failed: {path}: {exc}') from exc
          try:
              before = os.fstat(descriptor)
              if not stat.S_ISREG(before.st_mode) or before.st_uid != 0 or before.st_gid != logbook_gid or stat.S_IMODE(before.st_mode) != 0o640:
                  raise ObserverError(f'backup success receipt metadata differs: {path}')
              if before.st_size <= 0 or before.st_size > 65536:
                  raise ObserverError(f'backup success receipt size differs: {path}')
              payload = os.read(descriptor, 65537)
              after = os.fstat(descriptor)
          finally:
              os.close(descriptor)
          identity = lambda value: (value.st_dev, value.st_ino, value.st_uid, value.st_gid, stat.S_IMODE(value.st_mode), value.st_size, value.st_mtime_ns)
          if identity(before) != identity(after) or len(payload) != before.st_size or len(payload) > 65536:
              raise ObserverError(f'backup success receipt changed while reading: {path}')
          current = safe_lstat(path)
          if current is None or stat.S_ISLNK(current.st_mode) or not stat.S_ISREG(current.st_mode) or current.st_uid != 0 or current.st_gid != logbook_gid or stat.S_IMODE(current.st_mode) != 0o640:
              raise ObserverError(f'current backup success receipt path is unsafe: {path}')
          try:
              rendered = payload.decode('utf-8', errors='strict')
          except UnicodeDecodeError as exc:
              raise ObserverError(f'backup success receipt encoding differs: {path}') from exc
          fields: dict[str, str] = {}
          for line in rendered.splitlines():
              if '=' not in line:
                  continue
              key, value = line.split('=', 1)
              if key in {'name', 'timestamp', 'epoch', 'result', 'detail', 'boot_id', 'system'}:
                  fields[key] = value[:4096]
          if fields.get('name') != expected_name or not SAFE_INTEGER.fullmatch(fields.get('epoch', ''')):
              raise ObserverError(f'backup success receipt contract differs: {path}')
          return {'present': True, 'epoch': int(fields['epoch']), 'result': fields.get('result', 'unknown'), 'timestamp': fields.get('timestamp', 'unknown')}
      #@MNX-PART id=99.91.mnx-presslog-observe.function.classify-backup-receipt kind=function title="Python function classify_backup_receipt"
      def classify_backup_receipt(receipt: dict[str, Any], grace_seconds: int, required_epoch: int, source_age_seconds: int) -> dict[str, Any]:
          receipt_epoch = int(receipt.get('epoch', 0))
          lag = max(0, required_epoch - receipt_epoch) if required_epoch else 0
          if required_epoch == 0:
              status = 'nothing-to-cover'
          elif receipt.get('present') and receipt_epoch >= required_epoch:
              status = 'covered-by-success-receipt-time'
          elif source_age_seconds <= grace_seconds:
              status = 'pending-next-scheduled-run'
          elif not receipt.get('present'):
              status = 'unknown-missing-receipt-overdue'
          else:
              status = 'overdue'
          return {**receipt, 'status': status, 'lag_seconds': lag, 'grace_seconds': grace_seconds, 'content_hash_verified': False}

      #@MNX-PART id=99.91.mnx-presslog-observe.function.backup-coverage kind=function title="Python function backup_coverage"
      def backup_coverage(
          required_mtime_ns: int,
          newest_closed_ns: int,
          private_ns: int,
          primary_path: Path = BTRBK_MAIN_SUCCESS,
          archive_path: Path = BTRBK_ARCHIVE_SUCCESS,
      ) -> dict[str, Any]:
          receipts_present = safe_lstat(primary_path) is not None or safe_lstat(archive_path) is not None
          logbook_gid = publication_group_gid() if receipts_present else -1
          primary = read_success_receipt(primary_path, 'btrbk-main', logbook_gid)
          archive = read_success_receipt(archive_path, 'btrbk-archive-to-new-storage', logbook_gid)
          required_epoch = required_mtime_ns // 1_000_000_000 if required_mtime_ns > 0 else 0
          source_age_seconds = max(0, int(dt.datetime.now(dt.timezone.utc).timestamp()) - required_epoch) if required_epoch else 0

          primary_result = classify_backup_receipt(primary, PRIMARY_BACKUP_GRACE_SECONDS, required_epoch, source_age_seconds)
          archive_result = classify_backup_receipt(archive, SECONDARY_ARCHIVE_GRACE_SECONDS, required_epoch, source_age_seconds)
          primary_covered = primary_result['status'] == 'covered-by-success-receipt-time'
          archive_covered = archive_result['status'] == 'covered-by-success-receipt-time'
          primary_overdue = primary_result['status'] in {'overdue', 'unknown-missing-receipt-overdue'}
          archive_overdue = archive_result['status'] in {'overdue', 'unknown-missing-receipt-overdue'}
          if required_epoch == 0:
              overall = 'nothing-to-cover'
          elif primary_covered and archive_covered:
              overall = 'primary-and-secondary-covered-by-receipt-time'
          elif primary_covered and archive_overdue:
              overall = 'primary-covered-secondary-overdue-or-unknown'
          elif primary_covered:
              overall = 'primary-covered-secondary-pending'
          elif primary_overdue:
              overall = 'primary-overdue-or-unknown'
          else:
              overall = 'pending-next-primary-backup'
          return {
              'schema': 'mnx.presslog.backup-coverage.v1',
              'status': overall,
              'model': 'successful-root-job-receipt-time-after-source-metadata-not-content-hash',
              'required_mtime_ns': required_mtime_ns,
              'required_epoch': required_epoch,
              'source_age_seconds': source_age_seconds,
              'newest_closed_segment_mtime_ns': newest_closed_ns,
              'private_recovery_state_mtime_ns': private_ns,
              'newest_closed_segment_backed_up': None if newest_closed_ns <= 0 else int(primary.get('epoch', 0)) >= newest_closed_ns // 1_000_000_000,
              'private_recovery_state_backed_up': None if private_ns <= 0 else int(primary.get('epoch', 0)) >= private_ns // 1_000_000_000,
              'primary_home_backup': primary_result,
              'secondary_hdd_archive': archive_result,
              'primary_covered': primary_covered,
              'secondary_covered': archive_covered,
              'review_required': required_epoch > 0 and (primary_overdue or (primary_covered and archive_overdue)),
              'content_hash_verified': False,
              'journal_payload_read': False,
              'private_material_read': False,
          }
      #@MNX-PART id=99.91.mnx-presslog-observe.function.build-record kind=function title="Python function build_record"
      def build_record(
          state: Path = STATE,
          normal_override: dict[str, str] | None = None,
          burn_override: dict[str, str] | None = None,
          startup_path: Path = STARTUP_RUNTIME,
          heartbeat_path: Path = HEARTBEAT_RUNTIME,
          recovery_path: Path = RECOVERY_RECEIPT,
          primary_backup_path: Path = BTRBK_MAIN_SUCCESS,
          archive_backup_path: Path = BTRBK_ARCHIVE_SUCCESS,
      ) -> dict[str, Any]:
          uid, gid = expected_identity()
          unsafe: list[str] = []
          boot = current_boot_id()
          state_present = check_directory(state, uid, gid, unsafe, 'state-directory')
          journal_present = check_directory(state / 'journal', uid, gid, unsafe, 'journal-directory') if state_present else False
          manifests_present = check_directory(state / 'manifests', uid, gid, unsafe, 'manifest-directory') if state_present else False
          private_present = check_directory(state / 'private', uid, gid, unsafe, 'private-directory') if state_present else False
          run_present = check_directory(state / 'run', uid, gid, unsafe, 'run-directory') if state_present else False
          control_present = check_directory(state / 'monsternix', uid, gid, unsafe, 'control-directory') if state_present else False
          journal = scan_regular_files(state / 'journal', '.plog', uid, unsafe, 'journal') if journal_present else {'count': 0, 'bytes': 0, 'newest_mtime_ns': 0, 'names': set(), 'mtimes': {}}
          manifests = scan_regular_files(state / 'manifests', '.sha256', uid, unsafe, 'manifest') if manifests_present else {'count': 0, 'bytes': 0, 'newest_mtime_ns': 0, 'names': set(), 'mtimes': {}}
          private = check_private(state / 'private', uid, unsafe) if private_present else {'salt_present': False, 'keystore_present': False, 'newest_mtime_ns': 0}
          status, status_snapshot_replaced = read_status_metadata(state / 'run/status.json', uid, unsafe) if run_present else ({}, False)
          armed_item = safe_lstat(state / 'monsternix/armed') if control_present else None
          armed = False
          if armed_item is not None:
              if stat.S_ISLNK(armed_item.st_mode) or not stat.S_ISREG(armed_item.st_mode) or armed_item.st_uid != uid or stat.S_IMODE(armed_item.st_mode) != 0o600:
                  note_unsafe(unsafe, 'armed-marker-metadata')
              else:
                  armed = True
          normal = dict(normal_override) if normal_override is not None else user_unit_state('presslog.service')
          burn = dict(burn_override) if burn_override is not None else user_unit_state('presslog-burn.service')
          service_active = normal['active'] == 'active'
          burn_active = burn['active'] == 'active'
          service_failed = normal['active'] == 'failed' or burn['active'] == 'failed' or normal['result'] not in {'success', 'unavailable', 'unknown'} or burn['result'] not in {'success', 'unavailable', 'unknown'}
          segment_names: set[str] = journal['names']
          manifested_segments = {name[:-len('.sha256')] for name in manifests['names']}
          missing_manifests = segment_names - manifested_segments
          orphan_manifests = manifested_segments - segment_names
          closed_segments = segment_names & manifested_segments
          newest_closed_segment_mtime_ns = max((int(journal['mtimes'].get(name, 0)) for name in closed_segments), default=0)
          startup = read_bounded_json(startup_path, uid, {0o600}, 'mnx.presslog.startup.v1')
          heartbeat = read_bounded_json(heartbeat_path, uid, {0o600}, 'mnx.presslog.heartbeat.v1')
          recovery_drill = read_bounded_json(recovery_path, uid, {0o600}, 'mnx.presslog.recovery-drill.v1') if control_present else None
          startup_current_boot = isinstance(startup, dict) and startup.get('boot_id') == boot
          heartbeat_current_boot = isinstance(heartbeat, dict) and heartbeat.get('boot_id') == boot
          heartbeat_age_seconds = -1
          if heartbeat_current_boot and isinstance(heartbeat.get('updated_epoch'), int):
              heartbeat_age_seconds = max(0, int(dt.datetime.now(dt.timezone.utc).timestamp()) - int(heartbeat['updated_epoch']))
          required_backup_mtime_ns = max(newest_closed_segment_mtime_ns, int(private.get('newest_mtime_ns', 0)))
          coverage = backup_coverage(required_backup_mtime_ns, newest_closed_segment_mtime_ns, int(private.get('newest_mtime_ns', 0)), primary_backup_path, archive_backup_path)
          for _ in orphan_manifests:
              note_unsafe(unsafe, 'orphan-manifest')
          if service_active or burn_active:
              active_name = status.get('segment', ''')
              if len(missing_manifests) > 1:
                  for _ in missing_manifests:
                      note_unsafe(unsafe, 'unmanifested-segment')
              elif len(missing_manifests) == 1 and active_name not in {''', next(iter(missing_manifests))}:
                  note_unsafe(unsafe, 'active-segment-metadata-mismatch')
          else:
              for _ in missing_manifests:
                  note_unsafe(unsafe, 'unmanifested-segment')
          review_reasons: list[str] = []
          if service_failed:
              review_reasons.append('service-failed')
          if armed and not service_active:
              review_reasons.append('armed-not-recording')
          if service_active or burn_active:
              if not status:
                  review_reasons.append('active-without-status')
              elif status.get('auto_expire') != 'false':
                  review_reasons.append('automatic-expiry-not-disabled')
              if burn_active and status.get('burn') not in {'true', '1'}:
                  review_reasons.append('burn-service-status-mismatch')
              if service_active and status.get('burn') not in {'false', '0'}:
                  review_reasons.append('normal-service-status-mismatch')
              if not heartbeat_current_boot:
                  review_reasons.append('current-boot-heartbeat-missing')
              elif heartbeat.get('status_pid_matches') is not True:
                  review_reasons.append('heartbeat-pid-unconfirmed')
              elif heartbeat_age_seconds > 120:
                  review_reasons.append('supervisor-heartbeat-stale')
          if coverage.get('review_required') is True:
              review_reasons.append('backup-coverage-overdue')
          if isinstance(recovery_drill, dict) and recovery_drill.get('outcome') == 'fail':
              review_reasons.append('last-recovery-drill-failed')
          if unsafe:
              product = 'malfunction'
          elif review_reasons:
              product = 'review-required'
          elif service_active or burn_active:
              product = 'recording'
          elif state_present:
              product = 'idle'
          else:
              product = 'not-initialized'
          return {
              'schema': 'mnx.presslog.current.v2',
              'observed_at': utc_now(),
              'boot_id': boot,
              'status': product,
              'state_scope': 'h0p3-private-home-state',
              'state_present': state_present,
              'armed': armed,
              'normal_service': normal,
              'burn_service': burn,
              'service_active': service_active,
              'burn_active': burn_active,
              'service_failed': service_failed,
              'review_reasons': sorted(set(review_reasons)),
              'paused': status.get('paused', 'unknown'),
              'burn': status.get('burn', 'unknown'),
              'auto_expire': status.get('auto_expire', 'unknown'),
              'started_reported': bool(status.get('started')),
              'events': status.get('events', 'unknown'),
              'active_segment_reported': bool(status.get('segment')),
              'status_snapshot_semantics': 'opened-fd-consistent-atomic-path-replacement-accepted',
              'status_snapshot_replaced_during_read': status_snapshot_replaced,
              'segment_count': journal['count'],
              'segment_bytes': journal['bytes'],
              'manifest_count': manifests['count'],
              'manifest_bytes': manifests['bytes'],
              'unmanifested_segment_count': len(missing_manifests),
              'orphan_manifest_count': len(orphan_manifests),
              'newest_segment_mtime_ns': journal['newest_mtime_ns'],
              'newest_closed_segment_mtime_ns': newest_closed_segment_mtime_ns,
              'startup_current_boot': startup_current_boot,
              'heartbeat_current_boot': heartbeat_current_boot,
              'heartbeat_age_seconds': heartbeat_age_seconds,
              'startup': startup,
              'heartbeat': heartbeat,
              'recovery_drill': recovery_drill,
              'backup_coverage': coverage,
              'salt_present': private['salt_present'],
              'keystore_present': private['keystore_present'],
              'private_recovery_state_mtime_ns': int(private.get('newest_mtime_ns', 0)),
              'unsafe_object_count': len(unsafe),
              'unsafe_objects': sorted(set(unsafe))[:32],
              'content_inspected': False,
              'private_material_read': False,
              'journal_payload_read': False,
              'network_used': False,
          }
      #@MNX-PART id=99.91.mnx-presslog-observe.function.require-publication-parent kind=function title="Python function require_publication_parent"
      def require_publication_parent(path: Path) -> os.stat_result:
          item = safe_lstat(path.parent)
          if item is None or stat.S_ISLNK(item.st_mode) or not stat.S_ISDIR(item.st_mode):
              raise ObserverError('preprovisioned publication parent is absent or unsafe')
          if item.st_uid != 0 or stat.S_IMODE(item.st_mode) & 0o022:
              raise ObserverError('preprovisioned publication parent metadata is unsafe')
          return item
      
      #@MNX-PART id=99.91.mnx-presslog-observe.function.atomic-write kind=function title="Python function atomic_write"
      def atomic_write(path: Path, data: bytes, mode: int, uid: int, gid: int) -> None:
          require_publication_parent(path)
          temporary = path.parent / f'.{path.name}.{os.getpid()}.tmp'
          descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
          try:
              os.fchmod(descriptor, mode)
              os.fchown(descriptor, uid, gid)
              with os.fdopen(descriptor, 'wb', closefd=True) as stream:
                  stream.write(data)
                  stream.flush()
                  os.fsync(stream.fileno())
              os.replace(temporary, path)
              directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
              try:
                  os.fsync(directory)
              finally:
                  os.close(directory)
          finally:
              try:
                  temporary.unlink()
              except FileNotFoundError:
                  pass
      
      #@MNX-PART id=99.91.mnx-presslog-observe.function.render-metrics kind=function title="Python function render_metrics"
      def render_metrics(record: dict[str, Any]) -> bytes:
          problem = int(record['status'] in {'malfunction', 'review-required'})
          coverage = record.get('backup_coverage') if isinstance(record.get('backup_coverage'), dict) else {}
          startup = record.get('startup') if isinstance(record.get('startup'), dict) else {}
          recovery = record.get('recovery_drill') if isinstance(record.get('recovery_drill'), dict) else {}
          paused = int(str(record.get('paused', 'false')) in {'true', '1'})
          lines = [
              '# HELP monsternix_presslog_armed Whether persistent encrypted capture is armed.',
              '# TYPE monsternix_presslog_armed gauge',
              f"monsternix_presslog_armed {int(record['armed'])}",
              '# HELP monsternix_presslog_active Whether normal or burn capture is active.',
              '# TYPE monsternix_presslog_active gauge',
              f"monsternix_presslog_active {int(record['service_active'] or record['burn_active'])}",
              '# HELP monsternix_presslog_paused Whether active capture is deliberately paused.',
              '# TYPE monsternix_presslog_paused gauge',
              f'monsternix_presslog_paused {paused}',
              '# HELP monsternix_presslog_problem Whether metadata or service state needs review.',
              '# TYPE monsternix_presslog_problem gauge',
              f'monsternix_presslog_problem {problem}',
              '# HELP monsternix_presslog_segments Encrypted segment count without reading content.',
              '# TYPE monsternix_presslog_segments gauge',
              f"monsternix_presslog_segments {record['segment_count']}",
              '# HELP monsternix_presslog_ciphertext_bytes Encrypted segment bytes without reading content.',
              '# TYPE monsternix_presslog_ciphertext_bytes gauge',
              f"monsternix_presslog_ciphertext_bytes {record['segment_bytes']}",
              '# HELP monsternix_presslog_unsafe_objects Unsafe state-tree object count.',
              '# TYPE monsternix_presslog_unsafe_objects gauge',
              f"monsternix_presslog_unsafe_objects {record['unsafe_object_count']}",
              '# HELP monsternix_presslog_unmanifested_segments Ciphertext segments without closed manifests.',
              '# TYPE monsternix_presslog_unmanifested_segments gauge',
              f"monsternix_presslog_unmanifested_segments {record['unmanifested_segment_count']}",
              '# HELP monsternix_presslog_startup_confirmed Whether current-boot startup reached PID-bound recording.',
              '# TYPE monsternix_presslog_startup_confirmed gauge',
              f"monsternix_presslog_startup_confirmed {int(record.get('startup_current_boot') is True and startup.get('recording_confirmed') is True)}",
              '# HELP monsternix_presslog_heartbeat_age_seconds Age of the current supervisor heartbeat, or -1 when absent.',
              '# TYPE monsternix_presslog_heartbeat_age_seconds gauge',
              f"monsternix_presslog_heartbeat_age_seconds {int(record.get('heartbeat_age_seconds', -1))}",
              '# HELP monsternix_presslog_primary_backup_covered Whether newest closed journal/private metadata predates the primary success receipt.',
              '# TYPE monsternix_presslog_primary_backup_covered gauge',
              f"monsternix_presslog_primary_backup_covered {int(coverage.get('primary_covered') is True)}",
              '# HELP monsternix_presslog_secondary_backup_covered Whether newest closed journal/private metadata predates the secondary archive receipt.',
              '# TYPE monsternix_presslog_secondary_backup_covered gauge',
              f"monsternix_presslog_secondary_backup_covered {int(coverage.get('secondary_covered') is True)}",
              '# HELP monsternix_presslog_backup_coverage_review Whether cadence-aware backup coverage needs review.',
              '# TYPE monsternix_presslog_backup_coverage_review gauge',
              f"monsternix_presslog_backup_coverage_review {int(coverage.get('review_required') is True)}",
              '# HELP monsternix_presslog_recovery_drill_pass Whether the newest recovery drill receipt passed.',
              '# TYPE monsternix_presslog_recovery_drill_pass gauge',
              f"monsternix_presslog_recovery_drill_pass {int(recovery.get('outcome') == 'pass')}",
          ]
          return ('\n'.join(lines) + '\n').encode()
      #@MNX-PART id=99.91.mnx-presslog-observe.function.publish kind=function title="Python function publish"
      def publish(record: dict[str, Any]) -> None:
          logbook_gid = publication_group_gid()
          current_parent = require_publication_parent(CURRENT)
          if current_parent.st_gid != logbook_gid:
              raise ObserverError('Presslog publication parent group differs from logbook')
          require_publication_parent(METRIC)
          atomic_write(CURRENT, canonical(record).encode(), 0o640, 0, logbook_gid)
          atomic_write(METRIC, render_metrics(record), 0o644, 0, 0)
          boot = str(record.get('boot_id', 'unknown'))
          startup = record.get('startup')
          if not isinstance(startup, dict):
              startup = {'schema': 'mnx.presslog.startup.v1', 'boot_id': boot, 'unlock_outcome': 'unavailable', 'recording_confirmed': False, 'observed_at': record.get('observed_at'), 'journal_content_read': False, 'password_recorded': False}
          heartbeat = record.get('heartbeat')
