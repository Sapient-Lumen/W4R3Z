          print(f"anchor_path={anchor.get('path', 'none')}")
          print(f"anchor_sha256={anchor.get('sha256', 'none')}")
          print(f"recovery_boundary_present={'yes' if boundary.get('present') else 'no'}")
          print(f"recovery_boundary_path={boundary.get('path', 'none')}")
          print(f"recovery_boundary_sha256={boundary.get('sha256', 'none')}")
          print(f"recovery_boundary_mode={boundary.get('mode', 'none')}")
          print(f"legacy_problem_count={clean_forward.get('legacy_problem_count', 0)}")
          print(f"known_problem_count={clean_forward.get('known_problem_count', 0)}")
          print(f"known_problem_present_count={clean_forward.get('known_problem_present_count', 0)}")
          print(f"new_problem_count={clean_forward.get('new_problem_count', 0)}")
          for namespace in ("default", "logbook"):
              item = by_namespace[namespace]
              print(f"{namespace}_namespace_status={item['status']}")
              print(f"{namespace}_verify_rc={item['verify_rc']}")
              print(f"{namespace}_problem_line_count={len(item['problem_lines'])}")
