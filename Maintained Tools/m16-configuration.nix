      OFFICE_PREDECESSOR_SHA_RE = re.compile(r"^#@MNX-OFFICE accepted_predecessor_sha256=([0-9a-f]{64})$", re.MULTILINE)
      
      
      #@MNX-PART id=99.93.mnx-lineage.class.lineage-error kind=class title="Python class LineageError"
      class LineageError(RuntimeError):
          pass
      
      
      #@MNX-PART id=99.93.mnx-lineage.function.require kind=function title="Python function require"
      def require(condition: bool, message: str) -> None:
          if not condition:
              raise LineageError(message)
      
      
      #@MNX-PART id=99.93.mnx-lineage.function.sha256-bytes kind=function title="Python function sha256_bytes"
      def sha256_bytes(data: bytes) -> str:
          return hashlib.sha256(data).hexdigest()
      
      
      #@MNX-PART id=99.93.mnx-lineage.function.stable-read-regular kind=function title="Python function stable_read_regular"
      def stable_read_regular(path: Path, maximum: int, require_root: bool, require_single_link: bool) -> bytes:
          flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
          try:
              descriptor = os.open(path, flags)
          except OSError as exc:
              raise LineageError(f"cannot open bounded regular file: {path}: {exc}") from exc
          try:
              before = os.fstat(descriptor)
              require(stat.S_ISREG(before.st_mode), f"path is not a regular file: {path}")
              require((before.st_mode & 0o022) == 0, f"path is group- or world-writable: {path}")
              if require_root:
                  require(before.st_uid == 0, f"path is not root-owned: {path}")
              if require_single_link:
                  require(before.st_nlink == 1, f"path has unexpected hard links: {path}")
              require(0 <= before.st_size <= maximum, f"path exceeds bounded size: {path}: {before.st_size} > {maximum}")
              chunks: list[bytes] = []
              remaining = before.st_size
              while remaining:
                  chunk = os.read(descriptor, min(remaining, 1024 * 1024))
                  require(bool(chunk), f"unexpected EOF while reading: {path}")
                  chunks.append(chunk)
                  remaining -= len(chunk)
              require(not os.read(descriptor, 1), f"path grew during bounded read: {path}")
              after = os.fstat(descriptor)
          finally:
              os.close(descriptor)
          identity_before = (
              before.st_dev,
              before.st_ino,
              before.st_mode,
              before.st_uid,
              before.st_gid,
              before.st_nlink,
              before.st_size,
              before.st_mtime_ns,
              before.st_ctime_ns,
          )
          identity_after = (
              after.st_dev,
              after.st_ino,
              after.st_mode,
              after.st_uid,
              after.st_gid,
              after.st_nlink,
              after.st_size,
              after.st_mtime_ns,
              after.st_ctime_ns,
          )
