      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.read-source kind=function title="Portable Python function read_source"
      def read_source(path: Path) -> tuple[Path, bytes, str]:
          try:
              resolved = path.expanduser().resolve(strict=True)
              before = resolved.stat()
          except OSError as exc:
              raise Error(f'source unavailable: {path}: {exc}') from exc
          if not resolved.is_file():
              raise Error(f'source is not a regular file: {resolved}')
          if before.st_size > MAX_SOURCE_BYTES:
              raise Error(f'source exceeds {MAX_SOURCE_BYTES} bytes: {before.st_size}')
          raw = resolved.read_bytes()
          after = resolved.stat()
          if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
              raise Error(f'source changed while reading: {resolved}')
          if len(raw) != after.st_size:
              raise Error(f'source size changed while reading: {resolved}')
          try:
