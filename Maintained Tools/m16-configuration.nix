      #@MNX-PART id=99.91.mnx-presslog-observe.function.safe-lstat kind=function title="Python function safe_lstat"
      def safe_lstat(path: Path) -> os.stat_result | None:
          try:
              return path.lstat()
          except FileNotFoundError:
              return None
          except OSError as exc:
              raise ObserverError(f'lstat failed for fixed Presslog object class: {exc}') from exc
      
      #@MNX-PART id=99.91.mnx-presslog-observe.function.note-unsafe kind=function title="Python function note_unsafe"
      def note_unsafe(unsafe: list[str], category: str) -> None:
          if not SAFE_TOKEN.fullmatch(category):
              raise ObserverError('internal unsafe-category token is invalid')
          unsafe.append(category)
      
      #@MNX-PART id=99.91.mnx-presslog-observe.function.check-directory kind=function title="Python function check_directory"
      def check_directory(path: Path, uid: int, gid: int, unsafe: list[str], category: str) -> bool:
          item = safe_lstat(path)
          if item is None:
              return False
          if stat.S_ISLNK(item.st_mode) or not stat.S_ISDIR(item.st_mode):
              note_unsafe(unsafe, f'{category}-type')
              return False
          if item.st_uid != uid or item.st_gid != gid or stat.S_IMODE(item.st_mode) != 0o700:
              note_unsafe(unsafe, f'{category}-metadata')
          return True
      
      #@MNX-PART id=99.91.mnx-presslog-observe.function.scan-regular-files kind=function title="Python function scan_regular_files"
      def scan_regular_files(path: Path, suffix: str, uid: int, unsafe: list[str], category: str) -> dict[str, Any]:
          count = 0
          total = 0
          newest_ns = 0
          names: set[str] = set()
          mtimes: dict[str, int] = {}
          try:
              iterator = os.scandir(path)
          except FileNotFoundError:
              return {'count': 0, 'bytes': 0, 'newest_mtime_ns': 0, 'names': set(), 'mtimes': {}}
          except OSError as exc:
              raise ObserverError(f'scandir failed for {category}: {exc}') from exc
          with iterator:
              for number, entry in enumerate(iterator, 1):
                  if number > MAX_DIRECTORY_ENTRIES:
                      note_unsafe(unsafe, f'{category}-entry-bound')
                      break
                  try:
                      item = entry.stat(follow_symlinks=False)
                  except OSError:
                      note_unsafe(unsafe, f'{category}-unstatable')
                      continue
                  if entry.is_symlink() or not stat.S_ISREG(item.st_mode):
                      note_unsafe(unsafe, f'{category}-object-type')
                      continue
                  if item.st_uid != uid or stat.S_IMODE(item.st_mode) & 0o077:
                      note_unsafe(unsafe, f'{category}-file-metadata')
                  name = entry.name
                  if name.endswith(suffix) and SAFE_TOKEN.fullmatch(name):
                      count += 1
                      total += item.st_size
                      newest_ns = max(newest_ns, item.st_mtime_ns)
                      names.add(name)
                      mtimes[name] = item.st_mtime_ns
                  elif name.startswith('.') or '.tmp' in name:
                      note_unsafe(unsafe, f'{category}-temporary-residue')
                  else:
                      note_unsafe(unsafe, f'{category}-unexpected-object')
          return {'count': count, 'bytes': total, 'newest_mtime_ns': newest_ns, 'names': names, 'mtimes': mtimes}
      #@MNX-PART id=99.91.mnx-presslog-observe.function.check-private kind=function title="Python function check_private"
      def check_private(path: Path, uid: int, unsafe: list[str]) -> dict[str, Any]:
          result: dict[str, Any] = {'salt_present': False, 'keystore_present': False, 'newest_mtime_ns': 0}
          try:
              iterator = os.scandir(path)
          except FileNotFoundError:
              return result
          except OSError as exc:
              raise ObserverError(f'scandir failed for private metadata: {exc}') from exc
          with iterator:
              for number, entry in enumerate(iterator, 1):
                  if number > MAX_DIRECTORY_ENTRIES:
                      note_unsafe(unsafe, 'private-entry-bound')
                      break
                  try:
