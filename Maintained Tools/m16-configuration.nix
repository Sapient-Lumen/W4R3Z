#@MNX-ZONE id=admin-public interfaces=* address=wildcard,lan,link-local,public bind_policy=any sources=any enforcement=observe-only
#@MNX-ZONE id=lan-services interfaces=enp4s0 address=wildcard,lan,link-local bind_policy=firewall-gated sources=192.168.100.0/24,fdc7:c425:e617::/48,fe80::/10 enforcement=observe-only
#@MNX-ZONE id=public-p2p interfaces=* address=wildcard,lan,link-local,public bind_policy=any sources=any enforcement=observe-only
#@MNX-ZONE id=host-control interfaces=enp4s0 address=link-local,lan bind_policy=exact sources=link-local enforcement=observe-only
