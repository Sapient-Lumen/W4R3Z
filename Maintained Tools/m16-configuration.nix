      grep -Fq 'MNX_RESTIC_BACKUP_LEGACY_PREFLIGHT_SKIP_BRIDGE_SELF_TEST=PASS' "$CFG" || fail 'm21 Restic backup legacy preflight compatibility self-test marker is missing'
      grep -Fq 'MNX_RESTIC_BACKUP_CONTROLLER_SELF_TEST=PASS' "$CFG" || fail 'm21 Restic backup controller self-test marker is missing'
      grep -Fq 'env -u CREDENTIALS_DIRECTORY "$out" --self-test' "$CFG" || fail 'm21 Restic backup derivation does not prove credential-free self-test startup'
      grep -Fq 'phase=credential-preflight' "$CFG" || fail 'm21 Restic backup runtime credential preflight is missing'
      grep -Fq 'credentials-directory-missing-or-unsafe' "$CFG" || fail 'm21 Restic backup lacks explicit missing/unsafe credential failure semantics'
      RESTIC_BACKUP_SOURCE_SLICE="$(${pkgs.gawk}/bin/awk '
        /^#@MNX-DEF path=systemd[.]services[.]m16-backup-m21 / { capture=1 }
        capture && /^#@MNX-DEF path=systemd[.]services[.]m16-restic-maintenance / { exit }
        capture { print }
      ' "$CFG")"
      [[ -n "$RESTIC_BACKUP_SOURCE_SLICE" ]] || fail 'm21 Restic backup definition could not be isolated by column-zero markers'
      if grep -Fq '$CREDENTIALS_DIRECTORY/' <<< "$RESTIC_BACKUP_SOURCE_SLICE"; then
        fail 'm21 Restic backup retains eager direct credential-path expansion'
      fi
      if RESTIC_NIGHTLY_AUDIT="$(/etc/monsternix/bin/mnx-office health-evidence --json)" &&
         jq -e '.m21_restic.schema == "mnx.m21.restic-nightly.v1" and .m21_restic.primary_backend == "restic" and .m21_restic.network_used == false and .m21_restic.repository_data_verified_here == false and (.m21_restic.nightly.retry_due|type)=="boolean"' <<< "$RESTIC_NIGHTLY_AUDIT" >/dev/null &&
         jq -e --slurpfile language /etc/monsternix/nix-language.json '
           ($language | length) == 1 and (.m21_restic.policy | type) == "object" and
           .m21_restic.policy == $language[0].nightlyBackupPolicy and
           .m21_restic.policy_origin == "nix-evaluated-embedded-no-runtime-policy-file"
         ' <<< "$RESTIC_NIGHTLY_AUDIT" >/dev/null; then
        printf 'm21_primary_backend=restic\nm21_legacy_data_deletion=none\n'
        echo 'MNX_M21_NIGHTLY_POLICY_CONSUMERS=PASS'
        if jq -e '.m21_restic.nightly.deadline_missed == true' <<< "$RESTIC_NIGHTLY_AUDIT" >/dev/null; then
          warn 'mandatory m21 Restic nightly deadline is missed; backup state requires action without disabling configuration repair'
        fi
        echo 'MNX_RESTIC_NIGHTLY_SUPERVISION=PASS'
      else
        fail 'Restic nightly evidence or native/compiled policy consumer contract failed'
        echo 'MNX_M21_NIGHTLY_POLICY_CONSUMERS=FAIL'
        echo 'MNX_RESTIC_NIGHTLY_SUPERVISION=FAIL'
      fi
      #@MNX-PART id=99.80.mnx-config-audit.phase.restic-recovery-evidence kind=phase title="Phase: HISTORICAL RESTIC RECOVERY EVIDENCE"
      section 'HISTORICAL RESTIC RECOVERY EVIDENCE'
      if jq -e '.m21_recovery.schema == "mnx.restic.recovery-evidence.v1" and
          (.m21_recovery.historical_qualification_verified | type) == "boolean" and
          .m21_recovery.repository_data_read == false and .m21_recovery.restore_performed == false and
          .m21_recovery.network_used == false and .m21_recovery.secrets_read == false and
          .m21_recovery.state_mutated == false and .m21_recovery.raw_receipt_or_log_text_exported == false and
          .m21_recovery.retirement_authorized == false' <<< "$RESTIC_NIGHTLY_AUDIT" >/dev/null; then
        if jq -e '.m21_recovery.historical_qualification_verified == true' <<< "$RESTIC_NIGHTLY_AUDIT" >/dev/null; then
          echo 'MNX_RESTIC_RECOVERY_EVIDENCE=HISTORICAL_VERIFIED_NOT_A_NEW_RESTORE'
        else
          warn 'historical Restic recovery evidence is unavailable or inconsistent; see officer_health_m21_recovery; nightly backup supervision remains active'
          echo 'MNX_RESTIC_RECOVERY_EVIDENCE=REVIEW'
        fi
      else
        fail 'historical Restic recovery evidence reader contract is invalid'
        echo 'MNX_RESTIC_RECOVERY_EVIDENCE=FAIL'
      fi
      #@MNX-PART id=99.80.mnx-config-audit.phase.restic-local-residue kind=phase title="Phase: LOCAL RESTIC RESTORE RESIDUE"
      section 'LOCAL RESTIC RESTORE RESIDUE'
      if jq -e --argjson operator_uid '${toString config.users.users.h0p3.uid}' '.m21_local_residue | .schema == "mnx.restic.local-residue.v1" and
          .scope == "m16-disposable-restore-area-immediate-entries-only" and
          .area == "/mnt/m16-new-storage/admin/restore-tests" and .entry_limit == 128 and
          (.directory_diagnostics | .schema == "mnx.restic.directory-diagnostics.v2" and
             .metadata_basis == "nofollow-stat-then-descriptor-identity" and
             .default_owner_uid == 0 and .operator_owner_uid == $operator_uid and
             .operator_owned_components == ["m16-new-storage","admin"] and
             .authority == "metadata-observation-not-root-exclusive-provenance" and
             .forbidden_write_mask == "0022" and .policy_changed == true and
             (.components | type) == "array" and (.components | length) <= 5 and
             ([.components[].component] | length) == ([.components[].component] | unique | length) and
             all(.components[];
                 (.component as $c | ["/","mnt","m16-new-storage","admin","restore-tests"] | index($c)) != null and
                 (.kind as $k | ["directory","regular-file","symlink","other"] | index($k)) != null and
                 (.uid | type) == "number" and .uid >= 0 and .uid == (.uid | floor) and
                 (.gid | type) == "number" and .gid >= 0 and .gid == (.gid | floor) and
                 (.mode | type) == "string" and (.mode | test("^[0-7]{4}$")) and
                 .allowed_owner_uids == (if .component == "m16-new-storage" or .component == "admin"
                     then [0,$operator_uid] | unique else [0] end) and
                 (.owner_matches | type) == "boolean" and
                 .owner_matches == (.uid as $owner | .allowed_owner_uids | index($owner) != null) and
                 (.write_mask_clear | type) == "boolean" and
                 (.opened_identity_matches == null or (.opened_identity_matches | type) == "boolean")) and
             (.failure == null or
                ((.failure.component == null or
                   (.failure.component as $c | ["/","mnt","m16-new-storage","admin","restore-tests"] | index($c)) != null) and
                 (.failure.operation as $op | ["metadata-stat","directory-policy","directory-open","descriptor-stat",
                     "mount-identity","descriptor-mount","entry-scan","entry-set-recheck","observation-stability","mount-stability"] | index($op)) != null and
                 (.failure.reason as $r | ["not-directory","owner-mismatch","write-permissions","directory-identity-changed",
                     "mount-directory-absent","observation-rejected","os-error","subprocess-timeout","subprocess-error"] | index($r)) != null and
                 (if .failure.errno == null then .failure.errno_name == null else
                    (.failure.errno | type) == "number" and .failure.errno > 0 and .failure.errno < 4096 and
                    .failure.errno == (.failure.errno | floor) and
                    (.failure.errno_name | type) == "string" and (.failure.errno_name | test("^[A-Z][A-Z0-9_]{0,31}$"))
                  end)))) and
          (if .scan_complete then
             .directory_diagnostics.failure == null and
             all(.directory_diagnostics.components[]; .kind == "directory" and .owner_matches and
                 .write_mask_clear and .opened_identity_matches == true)
           elif .state == "review-required" then .directory_diagnostics.failure != null else true end) and
          (.scan_complete | type) == "boolean" and (.mount_verified | type) == "boolean" and
          .restored_content_read == false and .repository_data_read == false and
          .credentials_read == false and .network_used == false and .state_mutated == false and
          .deletion_authorized == false and .remote_residue_inventoried == false and
          .all_historical_residue_removed == false and .whole_machine_coverage_proven == false and
          (if .qualified_run == null or .scan_complete == false then
             .qualified_target_state == "unknown" and .qualified_target_absent_now == null and
             .cleanup_receipt_contradicted_now == null
           elif .qualified_target_state == "absent" then
             .qualified_target_absent_now == true and .cleanup_receipt_contradicted_now == false and
             (.qualified_run as $run | all(.entries[]; .run != $run))
           else
             .qualified_target_absent_now == false and .cleanup_receipt_contradicted_now == true and
             (. as $r | any(.entries[]; .run == $r.qualified_run and ("present-" + .kind) == $r.qualified_target_state))
           end) and
          (if .scan_complete then
             .mount_verified == true and
             (.entry_count | type) == "number" and .entry_count >= 0 and .entry_count <= 128 and
             .entry_count == (.entry_count | floor) and
             (.entries | type) == "array" and
             (.unrecognized_entry_count | type) == "number" and .unrecognized_entry_count >= 0 and
             .entry_count == ((.entries | length) + .unrecognized_entry_count) and
             (.state == "area-absent" or .state == "empty" or .state == "entries-present") and
             (if .entry_count == 0 then .state != "entries-present" else .state == "entries-present" end)
           else
             .mount_verified == false and .entry_count == null and .qualified_target_absent_now == null and
             (.state == "review-required" or .state == "unavailable")
           end)' <<< "$RESTIC_NIGHTLY_AUDIT" >/dev/null; then
        if jq -e '.m21_local_residue.scan_complete == true and .m21_local_residue.entry_count == 0' <<< "$RESTIC_NIGHTLY_AUDIT" >/dev/null; then
          echo 'MNX_RESTIC_LOCAL_RESIDUE=NO_ENTRIES_OBSERVED'
        else
          warn 'local disposable restore inventory requires review; see officer_health_m21_local_residue; no content was read and no deletion is authorized'
          echo 'MNX_RESTIC_LOCAL_RESIDUE=REVIEW'
        fi
      else
        fail 'local disposable restore inventory returned an invalid observation contract'
        echo 'MNX_RESTIC_LOCAL_RESIDUE=FAIL'
      fi
      #@MNX-PART id=99.80.mnx-config-audit.phase.m21-source-inventory-cache kind=phase title="Phase: M21 SOURCE INVENTORY CACHE"
      section 'M21 SOURCE INVENTORY CACHE'
      if jq -e '.m21_source_inventory | .network_used_here == false and .whole_machine_coverage_proven == false and
          .deletion_authorized == false and (.read_state|type)=="string" and
          (.state == "not-yet-observed" or .state == "observed" or .state == "unavailable" or .state == "review-required" or .state == "invalid-cache")' <<< "$RESTIC_NIGHTLY_AUDIT" >/dev/null; then
        M21_INVENTORY_CACHED_STATE="$(jq -r '.m21_source_inventory.state' <<< "$RESTIC_NIGHTLY_AUDIT")"
        case "$M21_INVENTORY_CACHED_STATE" in
          not-yet-observed) echo 'MNX_M21_SOURCE_INVENTORY_CACHE=NOT_YET_OBSERVED' ;;
          observed)
            if jq -e '.m21_source_inventory.recursive_inventory_available == true and
                .m21_source_inventory.enumeration_scope == "recursive-container-parent-id-closure" and
                (.m21_source_inventory.observation.schema == "mnx.m21.source-inventory.v2" or
                 .m21_source_inventory.observation.schema == "mnx.m21.source-inventory.v3")' <<< "$RESTIC_NIGHTLY_AUDIT" >/dev/null; then
              echo 'MNX_M21_SOURCE_INVENTORY_CACHE=CACHED_RECURSIVE_TOPOLOGY_NOT_COVERAGE_PROOF'
              if jq -e '.m21_source_inventory.observation.schema == "mnx.m21.source-inventory.v3"' <<< "$RESTIC_NIGHTLY_AUDIT" >/dev/null; then
                if jq -e '.m21_source_inventory.observation.topology.backup_source_discovery |
                    .schema == "mnx.m21.backup-source-discovery.v1" and .commands_executed_from_discovery == false and
                    .effective_ssh_dispatch_verified == false and .backup_coverage_verified == false and .deletion_authorized == false' <<< "$RESTIC_NIGHTLY_AUDIT" >/dev/null; then
                  echo 'MNX_M21_BACKUP_SOURCE_DISCOVERY=CACHED_HINTS_NOT_EXECUTED'
                else
                  fail 'm21 source discovery cache overstated its authority'
                fi
              fi
            elif jq -e '.m21_source_inventory.recursive_inventory_available == false and
                .m21_source_inventory.enumeration_scope == "legacy-nonrecursive-list-o" and
                .m21_source_inventory.observation.schema == "mnx.m21.source-inventory.v1"' <<< "$RESTIC_NIGHTLY_AUDIT" >/dev/null; then
              echo 'MNX_M21_SOURCE_INVENTORY_CACHE=LEGACY_NONRECURSIVE_OBSERVATION'
            else
              fail 'm21 inventory enumeration scope contradicts its cached schema'
            fi ;;
          *) warn 'cached m21 source inventory is unavailable or requires review; nightly Restic authority is separate'
             echo 'MNX_M21_SOURCE_INVENTORY_CACHE=REVIEW' ;;
        esac
      else
        fail 'm21 source inventory cache returned an invalid no-network observation contract'
      fi
      echo 'MNX_RESTIC_BACKUP_DEFINITION_SLICE=PASS'
      echo 'MNX_RESTIC_BACKUP_CREDENTIAL_SELF_TEST_POLICY=PASS'
      grep -Fq 'MNX_RESTIC_BACKUP_RECONCILIATION=REVIEW_REQUIRED_NO_RERUN' /etc/monsternix/bin/mnx-restic || fail 'm21 Restic backup accepted reconciliation path is missing'
      grep -Fq 'verify_stage68_rejected_candidate_lineage' /etc/monsternix/bin/mnx-restic || fail 'm21 Restic backup rejected-candidate lineage verifier is missing'
      grep -Fq 'rollback_not_needed=no_activation_observed' /etc/monsternix/bin/mnx-restic || fail 'm21 Restic backup rejected-candidate no-activation proof is missing'
      grep -Fq 'evidence_candidate_source_sha256' /etc/monsternix/bin/mnx-restic || fail 'm21 Restic backup evidence-candidate provenance is missing'
      grep -Fq 'evidence_carry_forward' /etc/monsternix/bin/mnx-restic || fail 'm21 Restic backup carry-forward provenance is missing'
      echo 'restic_backup_reconciliation_service_started=no'
      echo 'restic_backup_reconciliation_network_used=no'
      echo 'restic_backup_reconciliation_repository_accessed=no'
      STAGE68_BRIDGE_SLICE="$(sed -n '/^#@MNX-BASH stage68_backup_baseline_bridge()/,/^#@MNX-BASH bootstrap_test()/p' "$CFG")"
      [[ -n "$STAGE68_BRIDGE_SLICE" ]] || fail 'Stage68 degraded-baseline bridge is absent'
      grep -Fq 'MNX_STAGE68_BACKUP_BASELINE_BRIDGE=PASS' <<< "$STAGE68_BRIDGE_SLICE" || fail 'Stage68 degraded-baseline bridge success marker is absent'
      grep -Fq 'exec /etc/monsternix/bin/mnx-test --config "$CFG" "$@"' "$CFG" || fail 'Stage68 degraded-baseline bridge does not delegate to canonical mnx-test'
      grep -Fq 'stage68_backup_baseline_bridge_status=already-reconciled-use-candidate-bootstrap-or-ordinary-mnx-test' <<< "$STAGE68_BRIDGE_SLICE" || fail 'Stage68 bridge lacks clean-baseline self-revocation path'
      grep -Fq 'systemctl reset-failed "$unit"' <<< "$STAGE68_BRIDGE_SLICE" || fail 'Stage68 degraded-baseline bridge lacks exact bookkeeping reset'
      grep -Fq 'm16-backup-m21.service' <<< "$STAGE68_BRIDGE_SLICE" || fail 'Stage68 degraded-baseline bridge lacks the exact unit boundary'
      if grep -Eq 'systemctl[[:space:]]+(start|restart|try-restart|reload-or-restart|enable|disable|mask|unmask)[[:space:]].*m16-backup-m21' <<< "$STAGE68_BRIDGE_SLICE"; then
        fail 'Stage68 degraded-baseline bridge gained backup service lifecycle authority'
      fi
      if grep -Fq '/etc/nixos/secrets/m16-restic' <<< "$STAGE68_BRIDGE_SLICE" || grep -Fq '/mnt/m16-new-storage/admin/backups/restic' <<< "$STAGE68_BRIDGE_SLICE"; then
        fail 'Stage68 degraded-baseline bridge gained credential or repository reachability'
      fi
      echo 'MNX_STAGE68_BACKUP_BASELINE_BRIDGE_POLICY=PASS'

      STAGE71_OBSERVER_BRIDGE_SLICE="$(${pkgs.gawk}/bin/awk '
        /^#@MNX-BASH stage71_presslog_observer_baseline_bridge[(][)] [(]$/ { capture=1 }
        capture && /^#@MNX-BASH stage68_backup_baseline_bridge[(][)] [(]$/ { exit }
        capture { print }
      ' "$CFG")"
      [[ -n "$STAGE71_OBSERVER_BRIDGE_SLICE" ]] || fail 'Stage71 Presslog observer baseline bridge is absent'
      for bridge_marker in         'local unit=mnx-presslog-observe.service'         'local accepted_sha=8a63bf92dcd1df6a89b4c729cab09d708367d6173840e33cc5f1b192346e2b6c'         'local accepted_system=/nix/store/mwyg2xjaf08v8rcqsd6pz0qm9qh6hmqj-nixos-system-monster-16-25.11pre-git'         'mnx.presslog-observer.baseline-evidence.v1'         'mnx.presslog-observer.baseline-intake.v1'         '_SYSTEMD_INVOCATION_ID=$invocation'         'MNX_STAGE71_OBSERVER_BRIDGE_ERROR: exact-invocation journal capture command failed'         'find "$staging" -mindepth 1 -type d -exec chmod 0750 {} +'         'chmod 2750 "$staging"'         'actual_journal_sha="$(sha256sum "$final/unit.journal"'         'actual_observer_sha="$(sha256sum /etc/monsternix/bin/mnx-presslog-observe'         'prior_current_metadata_present'         'systemctl reset-failed "$unit"'         'stage71_presslog_observer_bridge_service_started=no'         'stage71_presslog_observer_bridge_presslog_signaled=no'         'stage71_presslog_observer_bridge_presslog_home_read=no'         'stage71_presslog_observer_bridge_presslog_journal_payload_read=no'         'stage71_presslog_observer_bridge_profile_mutated=no'         'stage71_presslog_observer_bridge_network_used=no'         'MNX_STAGE71_PRESSLOG_OBSERVER_BASELINE_BRIDGE=PASS'; do
        grep -Fq "$bridge_marker" <<<"$STAGE71_OBSERVER_BRIDGE_SLICE" || fail "Stage71 Presslog observer bridge landmark is missing: $bridge_marker"
      done
      if grep -Eq 'systemctl[[:space:]]+(start|restart|try-restart|reload-or-restart)[[:space:]].*mnx-presslog-observe' <<<"$STAGE71_OBSERVER_BRIDGE_SLICE"; then
        fail 'Stage71 Presslog observer bridge gained service start authority'
      fi
      ! grep -Fq '/home/h0p3/.local/state/presslog' <<<"$STAGE71_OBSERVER_BRIDGE_SLICE" || fail 'Stage71 Presslog observer bridge gained private home reachability'
      ! grep -Fq 'presslog.service' <<<"$STAGE71_OBSERVER_BRIDGE_SLICE" || fail 'Stage71 Presslog observer bridge gained recorder signal authority'
      echo 'MNX_STAGE71_PRESSLOG_OBSERVER_BASELINE_BRIDGE_POLICY=PASS'

      #@MNX-PART id=99.80.mnx-config-audit.phase.restic-maintenance-state kind=phase title="Phase: RESTIC MAINTENANCE STATE"
      section 'RESTIC MAINTENANCE STATE'
      RESTIC_MAINT_ROOT=/var/lib/monsternix/restic-maintenance
      RESTIC_MAINT_CURRENT="$RESTIC_MAINT_ROOT/current.json"
      RESTIC_MAINT_INTAKE="$RESTIC_MAINT_ROOT/bridge-intake.json"
      RESTIC_MAINT_RECOVERY="$RESTIC_MAINT_ROOT/recovery.json"
      if [[ "$MODE" == source ]]; then
        echo 'restic_maintenance_state=not-applicable-source-audit'
      elif [[ -f "$RESTIC_MAINT_CURRENT" && ! -L "$RESTIC_MAINT_CURRENT" ]]; then
        RESTIC_MAINT_META="$(stat -Lc '%U:%G %a' "$RESTIC_MAINT_CURRENT" 2>/dev/null || true)"
        [[ "$RESTIC_MAINT_META" == 'root:logbook 640' ]] || fail "Restic maintenance current-state metadata differs: $RESTIC_MAINT_META"
        RESTIC_MAINT_PRODUCT="$(${pkgs.jq}/bin/jq -r '.product_status // "unknown"' "$RESTIC_MAINT_CURRENT" 2>/dev/null || echo unknown)"
        RESTIC_MAINT_PHASE="$(${pkgs.jq}/bin/jq -r '.phase // "unknown"' "$RESTIC_MAINT_CURRENT" 2>/dev/null || echo unknown)"
        RESTIC_MAINT_REASON="$(${pkgs.jq}/bin/jq -r '.reason // "unknown"' "$RESTIC_MAINT_CURRENT" 2>/dev/null || echo unknown)"
        RESTIC_MAINT_EVIDENCE="$(${pkgs.jq}/bin/jq -r '.evidence_bundle // "none"' "$RESTIC_MAINT_CURRENT" 2>/dev/null || echo none)"
        printf 'restic_maintenance_product_status=%s\nrestic_maintenance_phase=%s\nrestic_maintenance_reason=%s\nrestic_maintenance_evidence=%s\n' "$RESTIC_MAINT_PRODUCT" "$RESTIC_MAINT_PHASE" "$RESTIC_MAINT_REASON" "$RESTIC_MAINT_EVIDENCE"
        case "$RESTIC_MAINT_PRODUCT" in
          pass) ;;
          skipped) warn 'Restic maintenance most recently skipped because the shared storage lock remained busy; the product state is visible and systemd is not degraded' ;;
          review-required) warn 'Restic maintenance product failure is manifested and review-required; controller publication succeeded and systemd is not degraded' ;;
          *) fail "Restic maintenance current product status is unknown: $RESTIC_MAINT_PRODUCT" ;;
        esac
      elif [[ -f "$RESTIC_MAINT_INTAKE" && ! -L "$RESTIC_MAINT_INTAKE" && ! -e "$RESTIC_MAINT_RECOVERY" ]]; then
        echo 'restic_maintenance_product_status=pending-bridge-recovery'
        printf 'restic_maintenance_evidence=%s\n' "$(${pkgs.jq}/bin/jq -r '.evidence_bundle // "none"' "$RESTIC_MAINT_INTAKE" 2>/dev/null || echo none)"
        warn 'Restic maintenance failed under the accepted predecessor; exact bridge evidence is pending switch-owned retry after this candidate is accepted'
      else
        echo 'restic_maintenance_product_status=unknown-never-published'
        warn 'Restic maintenance has not yet published source-owned product state; accepted Stage58 continuation is expected to establish it'
      fi

      #@MNX-PART id=99.80.mnx-config-audit.phase.journal-integrity-state kind=phase title="Phase: JOURNAL INTEGRITY STATE"
      section 'JOURNAL INTEGRITY STATE'
      if [[ "$MODE" == source ]]; then
        echo 'journal_integrity_state=not-applicable-source-audit'
      elif [[ -r /var/lib/monsternix/journal-integrity/current.json ]]; then
        JOURNAL_STATE="$(${pkgs.jq}/bin/jq -r '.overall_status // "unknown"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo unknown)"
        JOURNAL_CLEAN_FORWARD="$(${pkgs.jq}/bin/jq -r '.clean_forward.status // (if .overall_status == "malfunction" then "unknown-observer-malfunction" elif .overall_status == "review-required" then "unanchored" elif .overall_status == "clean" then "clean" else "unknown" end)' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo unknown)"
        JOURNAL_BUNDLE="$(${pkgs.jq}/bin/jq -r '.evidence_bundle // "none"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo none)"
        JOURNAL_ANCHOR_PRESENT="$(${pkgs.jq}/bin/jq -r 'if .anchor.present == true then "yes" else "no" end' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo no)"
        JOURNAL_ANCHOR_PATH="$(${pkgs.jq}/bin/jq -r '.anchor.path // "none"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo none)"
        JOURNAL_BOUNDARY_PRESENT="$(${pkgs.jq}/bin/jq -r 'if .recovery_boundary.present == true then "yes" else "no" end' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo no)"
        JOURNAL_BOUNDARY_PATH="$(${pkgs.jq}/bin/jq -r '.recovery_boundary.path // "none"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo none)"
        JOURNAL_BOUNDARY_MODE="$(${pkgs.jq}/bin/jq -r '.recovery_boundary.mode // "none"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo none)"
        JOURNAL_ACTIVE_FORWARD="$(${pkgs.jq}/bin/jq -r '.clean_forward.active_forward_status // "unknown"' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo unknown)"
        JOURNAL_NEW_COUNT="$(${pkgs.jq}/bin/jq -r '.clean_forward.new_problem_count // 0' /var/lib/monsternix/journal-integrity/current.json 2>/dev/null || echo unknown)"
        printf 'journal_integrity_state=%s\n' "$JOURNAL_STATE"
        printf 'journal_integrity_clean_forward_status=%s\n' "$JOURNAL_CLEAN_FORWARD"
        printf 'journal_integrity_anchor_present=%s\n' "$JOURNAL_ANCHOR_PRESENT"
        printf 'journal_integrity_anchor_path=%s\n' "$JOURNAL_ANCHOR_PATH"
        printf 'journal_integrity_recovery_boundary_present=%s\n' "$JOURNAL_BOUNDARY_PRESENT"
        printf 'journal_integrity_recovery_boundary_path=%s\n' "$JOURNAL_BOUNDARY_PATH"
        printf 'journal_integrity_recovery_boundary_mode=%s\n' "$JOURNAL_BOUNDARY_MODE"
        printf 'journal_integrity_active_forward_status=%s\n' "$JOURNAL_ACTIVE_FORWARD"
        printf 'journal_integrity_new_problem_count=%s\n' "$JOURNAL_NEW_COUNT"
        printf 'journal_integrity_evidence=%s\n' "$JOURNAL_BUNDLE"
        case "$JOURNAL_STATE:$JOURNAL_CLEAN_FORWARD" in
          malfunction:*|*:unknown-observer-malfunction)
            fail 'journal integrity observer reports malfunction'
            ;;
          *:new-damage-review-required)
            warn 'new journal integrity damage exists outside the immutable legacy anchor; review the current manifested evidence'
            ;;
          *:legacy-damage-only)
            warn 'journal integrity shows only immutable anchored legacy damage; no new problem identity is present and no automatic deletion/repair is authorized'
            ;;
          *:legacy-damage-no-longer-observed)
            echo 'journal_integrity_note=anchored-legacy-problem-not-currently-observed-without-claim-of-repair'
            ;;
          *:known-archived-damage-clean-forward)
            warn 'known archived journal damage remains manifested while the active forward journal verifies clean; no automatic deletion, vacuum, or repair is authorized'
            ;;
          *:known-damage-no-longer-observed-clean-forward)
            echo 'journal_integrity_note=known-damage-not-currently-observed-active-forward-clean-without-claim-of-repair'
            ;;
          *:clean|clean:unknown)
            ;;
          *:unanchored|review-required:unknown)
            warn 'journal integrity damage is verified but the immutable legacy anchor is not yet established'
            ;;
          *)
            warn 'journal integrity current state is unreadable or unknown'
            ;;
        esac
      else
        echo 'journal_integrity_state=unknown'
        echo 'journal_integrity_clean_forward_status=unknown'
        echo 'journal_integrity_anchor_present=no'
        echo 'journal_integrity_anchor_path=none'
        echo 'journal_integrity_recovery_boundary_present=no'
        echo 'journal_integrity_recovery_boundary_path=none'
        echo 'journal_integrity_recovery_boundary_mode=none'
        echo 'journal_integrity_active_forward_status=unknown'
        echo 'journal_integrity_new_problem_count=unknown'
        warn 'journal integrity has not yet published a current state; the next editing candidate must collect the bounded evidence through mnx switch'
      fi

      #@MNX-PART id=99.80.mnx-config-audit.phase.current-machine-state kind=phase title="Phase: CURRENT MACHINE STATE"
      section 'CURRENT MACHINE STATE'
      FAILED_UNITS="$(systemctl --failed --no-legend --plain 2>/dev/null || true)"
      printf 'failed_units=%s\n' "''${FAILED_UNITS:-none}"
      [[ -z "$FAILED_UNITS" ]] || fail 'one or more systemd units are failed'

      if [[ -L /var/lib/monsternix/btrfs-baselines/pinned ]]; then
        set +e
        BTRFS_BASELINE_OUTPUT="$(/etc/monsternix/bin/mnx-btrfs-baseline compare pinned 2>&1)"
        BTRFS_BASELINE_RC="$?"
        set -e
        printf '%s\n' "$BTRFS_BASELINE_OUTPUT"
        [[ "$BTRFS_BASELINE_RC" -eq 0 ]] || fail 'Btrfs counters increased, identities changed, or tuples became unreadable relative to the pinned baseline'
        if grep -q '^ADVISORY:' <<<"$BTRFS_BASELINE_OUTPUT"; then
          warn 'Btrfs baseline has unchanged historical nonzero or decreased/reset counters; see tuple-level evidence above'
        fi
      else
        set +e
        BTRFS_BASELINE_OUTPUT="$(/etc/monsternix/bin/mnx-btrfs-baseline check-zero 2>&1)"
        BTRFS_BASELINE_RC="$?"
        set -e
        printf '%s\n' "$BTRFS_BASELINE_OUTPUT"
        [[ "$BTRFS_BASELINE_RC" -eq 0 ]] || fail 'Btrfs counters are nonzero before any baseline has been pinned'
        echo 'btrfs_baseline_state=unpinned-clean-zero'
      fi

      SWAP_NAMES="$(swapon --noheadings --show=NAME 2>/dev/null || true)"
      printf 'swap_names=%s\n' "$(tr '\n' ',' <<<"$SWAP_NAMES" | sed 's/,$//')"
      grep -Fxq /mnt/m16-backup-nvme/swap/swapfile <<<"$SWAP_NAMES" || fail '128 GiB backup-NVMe overflow swap is not active'
      awk '$1 == "/mnt/m16-backup-nvme/swap/swapfile" && $2 >= 137438900000 && $3 == 10 { found=1 } END { exit found ? 0 : 1 }' \
        < <(swapon --noheadings --bytes --show=NAME,SIZE,PRIO 2>/dev/null) || fail 'backup-NVMe overflow swap size or priority is wrong'

      #@MNX-PART id=99.80.mnx-config-audit.phase.runtime-acceptance kind=phase title="Phase: CANDIDATE RUNTIME ACCEPTANCE"
      section 'CANDIDATE RUNTIME ACCEPTANCE'
      run_monsterdesk_live_acceptance

      case "$MODE" in
        quick|test)
          ;;
        full)
          #@MNX-PART id=99.80.mnx-config-audit.phase.full-nixos-dry-build kind=phase title="Phase: FULL NIXOS DRY BUILD"
          section 'FULL NIXOS DRY BUILD'
          nixos-rebuild dry-build --show-trace || fail 'nixos-rebuild dry-build failed'
          ;;
        support)
          #@MNX-PART id=99.80.mnx-config-audit.phase.support-report kind=phase title="Phase: SUPPORT REPORT"
          section 'SUPPORT REPORT'
          /etc/monsternix/bin/mnx-support-report || fail 'mnx-support-report failed'
          ;;
        self-test)
          ;;
        *)
          fail "unknown mode: $MODE"
          ;;
      esac

      finish_audit
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            exact_output_log="$PWD/mnx-config-audit.exact-output-line-self-test.log"
            "$out" --exact-output-line-self-test >"$exact_output_log"
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_AUDIT_EXACT_OUTPUT_LINE_SELF_TEST=PASS' "$exact_output_log"
            ${pkgs.coreutils}/bin/cat "$exact_output_log"
            ${pkgs.gnugrep}/bin/grep -Fq 'exact_output_line() {' "$out"
            [ "$(${pkgs.gnugrep}/bin/grep -Fc 'exact_output_line "$CLOUDTAINER_SELF_TEST_OUTPUT"' "$out")" -eq 26 ]
            [ "$(${pkgs.gnugrep}/bin/grep -Fc 'exact_output_line "$CLOUDTAINER_CANDIDATE_SELF_TEST_OUTPUT"' "$out")" -eq 1 ]
            [ "$(${pkgs.gnugrep}/bin/grep -Fc 'exact_output_line "$UPGRADE_SELF_TEST_OUTPUT"' "$out")" -eq 4 ]
            [ "$(${pkgs.gnugrep}/bin/grep -Fc 'exact_output_line "$WAKE_TEXT"' "$out")" -eq 3 ]
            [ "$(${pkgs.gnugrep}/bin/grep -Fc 'exact_output_line "$CANDIDATE_LINEAGE_AUDIT_OUTPUT"' "$out")" -eq 3 ]
            restic_compat_log="$PWD/mnx-config-audit.restic-compat-self-test.log"
            "$out" --restic-backup-compat-self-test >"$restic_compat_log"
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_RESTIC_BACKUP_LEGACY_PREFLIGHT_SKIP_BRIDGE_SELF_TEST=PASS' "$restic_compat_log"
            ${pkgs.coreutils}/bin/cat "$restic_compat_log"
            obsolete_stage75_bridge='stage75_candidate_lineage_'
            obsolete_stage75_bridge+='bridge'
            if ${pkgs.gnugrep}/bin/grep -Fq "$obsolete_stage75_bridge" "$out"; then
              echo 'mnx-config-audit still names the revoked Stage75 bridge contiguously' >&2
              exit 1
            fi
            ${pkgs.gnugrep}/bin/grep -Fq 'source_definition_contains() {' "$out"
            ${pkgs.gnugrep}/bin/grep -Fq 'source_bash_contains() {' "$out"
            ${pkgs.gnugrep}/bin/grep -Fq 'MNX_SEMANTIC_KERNEL_CONTRACT=PASS' "$out"
            ${pkgs.gnugrep}/bin/grep -Fq 'MNX_CANDIDATE_LINEAGE_RUNTIME_AUDIT=PASS' "$out"
            ${pkgs.gnugrep}/bin/grep -Fq 'candidate_lineage_engine=accepted-default-closure-mnx-lineage' "$out"
            ${pkgs.gnugrep}/bin/grep -Fq 'lineage_bin="$expected_default/etc/monsternix/bin/mnx-lineage"' "$out"
            if ${pkgs.gnugrep}/bin/grep -Fq '/etc/monsternix/bin/mnx-restic enroll source-probe || fail' "$out"; then
              echo 'mnx-config-audit regained live m21 network authority during routine acceptance' >&2
              exit 1
            fi
            ${pkgs.gnugrep}/bin/grep -Fq 'm21_source_probe_acceptance_gate=disabled-live-network-is-explicit-diagnostic' "$out"
            ${pkgs.gnugrep}/bin/grep -Fq 'm21_source_probe_network_used=no' "$out"
            ${pkgs.gnugrep}/bin/grep -Fq 'run_monsterdesk_live_acceptance() {' "$out"
            ${pkgs.gnugrep}/bin/grep -Fq 'MONSTERDESK_LIVE_ACCEPTANCE=PASS' "$out"
            ${pkgs.gnugrep}/bin/grep -Fq '/run/current-system/sw/bin/monsterdesk live-acceptance' "$out"
            ;;
          '#!'*python*)
            ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
            ;;
          *)
            echo "unsupported generated-script interpreter: $first" >&2
            exit 1
            ;;
        esac
      '';
    };
  };

#@MNX-CHUNK id=99.85 slug=configuration-as-bash title="Generated extractor for the embedded configuration-as-Bash payload"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-configuration-as-bash" section=99.85 role=generated-program ordinal=276
  environment.etc."monsternix/bin/mnx-configuration-as-bash" = {
    source = pkgs.writeTextFile {
      name = "mnx-configuration-as-bash";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      export PATH=/run/wrappers/bin:${pkgs.bash}/bin:${pkgs.coreutils}/bin:${pkgs.findutils}/bin:${pkgs.gawk}/bin:${pkgs.gnugrep}/bin:${pkgs.gnused}/bin:${pkgs.util-linux}/bin:${pkgs.systemd}/bin:${pkgs.python3}/bin:${pkgs.nix}/bin:${pkgs.btrfs-progs}/bin:${pkgs.procps}/bin:/run/current-system/sw/bin
      set -Eeuo pipefail
      export LC_ALL=C

      CFG="''${MNX_CONFIG:-/etc/nixos/configuration.nix}"

      if [[ ''${1:-} == --config ]]; then
        CFG="$2"
        shift 2
      fi

      [[ -r "$CFG" ]] || { echo "configuration is unreadable: $CFG" >&2; exit 66; }

      TMP="$(mktemp)"
      trap 'rm -f "$TMP"' EXIT

      sed -n '/^#@MNX-BASH-BEGIN$/,/^#@MNX-BASH-END$/p' "$CFG" |
        sed -e '1d' -e '$d' -e 's/^#@MNX-BASH //' > "$TMP"

      [[ -s "$TMP" ]] || { echo 'embedded MNX Bash payload is absent' >&2; exit 65; }
      chmod 0700 "$TMP"
      bash -n "$TMP"

      if [[ ''${1:-audit} == self-test ]]; then
        grep -Fq 'MNX_CONFIGURATION_AS_BASH_PAYLOAD=1' "$TMP"
        echo 'MNX_CONFIGURATION_AS_BASH_SELF_TEST=PASS'
        exit 0
      fi

      export MNX_CONFIG="$CFG"
      exec bash "$TMP" "$@"
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            ;;
          '#!'*python*)
            ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
            ;;
          *)
            echo "unsupported generated-script interpreter: $first" >&2
            exit 1
            ;;
        esac
      '';
    };
  };


#@MNX-CHUNK id=99.86 slug=mnx-upgrade-build title="Immutable cross-series upgrade check, compatibility projection, and nonactivating build transaction"
  # These fstrim overrides are placed at the start of the final active Nix chunk so every predecessor
  # definition retains its exact ordinal and ejection body identity. They remain ordinary machine policy.
#@MNX-DEF path=systemd.timers.fstrim.timerConfig section=99.86 role=timer ordinal=277
  systemd.timers.fstrim.timerConfig = {
    AccuracySec = lib.mkForce "15min";
    RandomizedDelaySec = lib.mkForce "15min";
    Persistent = lib.mkForce false;
  };

#@MNX-DEF path=systemd.services.fstrim section=99.86 role=service ordinal=278
  systemd.services.fstrim = {
    # Online discard may overlap the operator lane. A candidate definition change must therefore
    # never stop or restart an in-flight trim during temporary or permanent activation.
    restartIfChanged = false;
    serviceConfig = {
      Nice = 19;
      CPUSchedulingPolicy = "idle";
      IOSchedulingClass = "idle";
    };
  };

  # Keep the NixOS libvirt module and its socket activation, but do not boot-want the idle daemon or guest lifecycle.
  # Placing these machine-policy overrides before the final generated program keeps ejection definition boundaries exact.
#@MNX-DEF path=systemd.services.libvirtd.wantedBy section=99.86 role=service ordinal=279
  systemd.services.libvirtd.wantedBy = lib.mkForce [ ];

#@MNX-DEF path=systemd.services.libvirt-guests.wantedBy section=99.86 role=service ordinal=280
  systemd.services.libvirt-guests.wantedBy = lib.mkForce [ ];

#@MNX-DEF path=environment.etc."monsternix/bin/mnx-upgrade" section=99.86 role=generated-program ordinal=281
  environment.etc."monsternix/bin/mnx-upgrade" = {
    source = pkgs.writeTextFile {
      name = "mnx-upgrade";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      export PATH=/run/wrappers/bin:${pkgs.bash}/bin:${pkgs.coreutils}/bin:${pkgs.findutils}/bin:${pkgs.gawk}/bin:${pkgs.gnugrep}/bin:${pkgs.gnused}/bin:${pkgs.util-linux}/bin:${pkgs.systemd}/bin:${pkgs.curl}/bin:${pkgs.jq}/bin:${pkgs.nix}/bin:/run/current-system/sw/bin
      set -Eeuo pipefail
      export LC_ALL=C SYSTEMD_PAGER=cat SYSTEMD_COLORS=0 PAGER=cat
      umask 0027

      UPGRADE_SCHEMA=2
      TARGET_SERIES=26.05
      CHANNEL_URL=https://channels.nixos.org/nixos-26.05
      RELEASE_NAME=nixos-26.05.6815.531670d871c0
      RELEASE_URL=https://releases.nixos.org/nixos/26.05/nixos-26.05.6815.531670d871c0
      RELEASE_REVISION=531670d871c0e29724a02f3cbcac170adc65b58c
      ARCHIVE_URL="$RELEASE_URL/nixexprs.tar.xz"
      ARCHIVE_SHA256_HEX=550629a2e2683a261ca5c24bc36e658ab0ad07d674851b6803570006f1b870ac
      ARCHIVE_FILE_HASH='sha256-VQYpouJoOiYcpcJLw25lirCtB9Z0hRtoA1cABvG4cKw='
      CONFIG="''${MNX_CONFIG:-/etc/nixos/configuration.nix}"
      SUPPORT_ROOT=/var/lib/logbook/support
      UPGRADE_LOCK=/run/monsternix/mnx-upgrade.lock
      STORAGE_LOCK=/run/storage-maintenance.lock
      RAW_TIMER=nixos-upgrade.timer

      #@MNX-PART id=99.86.mnx-upgrade.function.usage kind=function title="Function usage"
      usage() {
        cat <<'USAGE'
      usage:
        mnx upgrade policy [--json]
        mnx upgrade check [--json]
        mnx upgrade build
        mnx upgrade status [--json]
        mnx upgrade evidence [--full]
        mnx upgrade self-test
        mnx upgrade test       # deliberately refused in schema 2
        mnx upgrade switch     # deliberately refused in schema 2

      check uses the network but writes no persistent state. build may write the Nix store and one
      manifested support bundle, but never activates a closure, changes channel/system profiles,
      or grants reboot/promotion authority.
      USAGE
      }

      #@MNX-PART id=99.86.mnx-upgrade.function.section kind=function title="Function section"
      section() {
        printf '\n\n################################################################################\n# %s\n################################################################################\n' "$1"
      }

      #@MNX-PART id=99.86.mnx-upgrade.function.require-root kind=function title="Function require_root"
      require_root() {
        if [[ ''${EUID:-$(id -u)} -ne 0 ]]; then
          [[ -x /run/wrappers/bin/sudo ]] || { echo '/run/wrappers/bin/sudo is unavailable' >&2; exit 126; }
          exec /run/wrappers/bin/sudo -- /etc/monsternix/bin/mnx-upgrade "$@"
        fi
      }

      #@MNX-PART id=99.86.mnx-upgrade.function.sha-file kind=function title="Function sha_file"
      sha_file() {
        local line
        line="$(sha256sum -- "$1")" || return
        printf '%s\n' "''${line%% *}"
      }

      #@MNX-PART id=99.86.mnx-upgrade.function.normalize-url kind=function title="Function normalize_url"
      normalize_url() {
        local value="$1"
        while [[ "$value" == */ ]]; do value="''${value%/}"; done
        printf '%s\n' "$value"
      }

      #@MNX-PART id=99.86.mnx-upgrade.function.validate-release-url kind=function title="Function validate_release_url"
      validate_release_url() {
        local value
        value="$(normalize_url "$1")"
        [[ "$value" == "$RELEASE_URL" ]]
      }

      #@MNX-PART id=99.86.mnx-upgrade.function.latest-bundle kind=function title="Function latest_bundle"
      latest_bundle() {
        find "$SUPPORT_ROOT" -maxdepth 1 -mindepth 1 -type d -name 'mnx-upgrade-build-*' -printf '%T@ %p\n' 2>/dev/null |
          sort -nr | awk 'NR == 1 { $1=""; sub(/^ /, ""); print; exit }'
      }

      #@MNX-PART id=99.86.mnx-upgrade.function.installed-channel-snapshot kind=function title="Function installed_channel_snapshot"
      installed_channel_snapshot() {
        local profile=/nix/var/nix/profiles/per-user/root/channels
        printf 'channel_profile_target=%s\n' "$(readlink -f "$profile" 2>/dev/null || true)"
        printf 'channel_subscription_file_sha256=%s\n' "$(sha_file /root/.nix-channels 2>/dev/null || echo missing)"
        printf 'channel_subscription_list_begin\n'
        nix-channel --list 2>/dev/null || true
        printf 'channel_subscription_list_end\n'
      }

      #@MNX-PART id=99.86.mnx-upgrade.function.current-release-check kind=function title="Function current_release_check"
      current_release_check() {
        local effective revision feed_matches
        effective="$(curl --fail --silent --show-error --location --output /dev/null --write-out '%{url_effective}' "$CHANNEL_URL")" || return 1
        effective="$(normalize_url "$effective")"
        revision="$(curl --fail --silent --show-error --location "$RELEASE_URL/git-revision")" || return 1
        revision="''${revision//$'\r'/}"
        revision="''${revision//$'\n'/}"
        [[ "$revision" =~ ^[0-9a-f]{40}$ ]] || return 1
        if [[ "$effective" == "$RELEASE_URL" ]]; then feed_matches=yes; else feed_matches=no; fi
        printf 'channel_url=%s\nchannel_effective_url=%s\npinned_release_name=%s\npinned_release_url=%s\nfeed_matches_pinned_release=%s\nrelease_revision=%s\npinned_release_revision=%s\narchive_url=%s\npinned_archive_file_sha256=%s\npinned_archive_file_sha256_hex=%s\n' \
          "$CHANNEL_URL" "$effective" "$RELEASE_NAME" "$RELEASE_URL" "$feed_matches" "$revision" "$RELEASE_REVISION" "$ARCHIVE_URL" "$ARCHIVE_FILE_HASH" "$ARCHIVE_SHA256_HEX"
        [[ "$revision" == "$RELEASE_REVISION" ]]
      }

      #@MNX-PART id=99.86.mnx-upgrade.function.policy-command kind=function title="Function policy_command"
      policy_command() {
        local json=0
        [[ ''${1:-} != --json ]] || { json=1; shift; }
        (( $# == 0 )) || { usage >&2; return 64; }
        if (( json )); then
          jq -n \
            --argjson schema "$UPGRADE_SCHEMA" --arg series "$TARGET_SERIES" --arg channel "$CHANNEL_URL" \
            --arg release "$RELEASE_NAME" --arg release_url "$RELEASE_URL" --arg revision "$RELEASE_REVISION" \
            --arg archive "$ARCHIVE_URL" --arg archive_hash "$ARCHIVE_FILE_HASH" --arg archive_hex "$ARCHIVE_SHA256_HEX" \
            '{schema:"mnx.upgrade.policy.v2",upgrade_schema:$schema,target_series:$series,channel_url:$channel,pinned_release:$release,pinned_release_url:$release_url,pinned_revision:$revision,archive_url:$archive,pinned_archive_file_sha256:$archive_hash,pinned_archive_file_sha256_hex:$archive_hex,source_verification:"official-release-git-revision-and-flat-archive-sha256-before-local-unpack",unpacked_identity_recorded_at_build:true,network_used:false,activation_enabled:false,channel_mutation_enabled:false,system_profile_mutation_enabled:false,state_version_mutation_enabled:false,reboot_enabled:false,operator_reboot_permitted:false,promotion_authorized:false,target_dbus_implementation:"dbus",target_initrd_systemd:false,explicit_fuse_required:true,unattended_timer_enabled:false,old_storage_write:false}'
        else
          printf 'schema=mnx.upgrade.policy.v2\nupgrade_schema=%s\ntarget_series=%s\nchannel_url=%s\npinned_release=%s\npinned_release_url=%s\npinned_revision=%s\narchive_url=%s\npinned_archive_file_sha256=%s\npinned_archive_file_sha256_hex=%s\nsource_verification=official-release-git-revision-and-flat-archive-sha256-before-local-unpack\nunpacked_identity_recorded_at_build=yes\n' \
            "$UPGRADE_SCHEMA" "$TARGET_SERIES" "$CHANNEL_URL" "$RELEASE_NAME" "$RELEASE_URL" "$RELEASE_REVISION" "$ARCHIVE_URL" "$ARCHIVE_FILE_HASH" "$ARCHIVE_SHA256_HEX"
          printf 'network_used=no\nactivation_enabled=no\nchannel_mutation_enabled=no\nsystem_profile_mutation_enabled=no\nstate_version_mutation_enabled=no\nreboot_enabled=no\noperator_reboot_permitted=no\npromotion_authorized=no\ntarget_dbus_implementation=dbus\ntarget_initrd_systemd=false\nexplicit_fuse_required=yes\nunattended_timer_enabled=no\nold_storage_write=no\nMNX_UPGRADE_POLICY=PASS\n'
        fi
      }

      #@MNX-PART id=99.86.mnx-upgrade.function.check-command kind=function title="Function check_command"
      check_command() {
        local json=0 output feed
        [[ ''${1:-} != --json ]] || { json=1; shift; }
        (( $# == 0 )) || { usage >&2; return 64; }
        if [[ ''${EUID:-$(id -u)} -ne 0 ]]; then
          if (( json )); then
            require_root check --json
          else
            require_root check
          fi
        fi
        output="$(current_release_check)" || { echo 'MNX_UPGRADE_CHECK=FAIL_RELEASE_IDENTITY' >&2; return 1; }
        feed="$(sed -n 's/^feed_matches_pinned_release=//p' <<< "$output")"
        if (( json )); then
          jq -n --arg text "$output" --arg feed "$feed" --arg release "$RELEASE_NAME" --arg revision "$RELEASE_REVISION" --arg archive_hash "$ARCHIVE_FILE_HASH" \
            '{schema:"mnx.upgrade.check.v2",status:(if $feed=="yes" then "pass" else "pass-with-feed-drift" end),feed_matches_pinned_release:($feed=="yes"),pinned_release:$release,pinned_revision:$revision,pinned_archive_file_sha256:$archive_hash,network_used:true,mutation:"none",raw:$text}'
        else
          #@MNX-PART id=99.86.mnx-upgrade.phase.networked-identity-check kind=phase title="Phase: MNX UPGRADE CHECK — NETWORKED IDENTITY ONLY"
          section 'MNX UPGRADE CHECK — NETWORKED IDENTITY ONLY'
          printf '%s\n' "$output"
          installed_channel_snapshot
          printf 'network_used=yes\nmutation=none\n'
          [[ "$feed" == yes ]] && echo 'MNX_UPGRADE_CHECK=PASS' || echo 'MNX_UPGRADE_CHECK=PASS_WITH_FEED_DRIFT'
        fi
      }

      #@MNX-PART id=99.86.mnx-upgrade.function.resolve-staged-system-path kind=function title="Function resolve_staged_system_path"
      resolve_staged_system_path() {
        local input="$1" line
        local -a lines=()
        [[ -f "$input" && ! -L "$input" ]] || return 1
        while IFS= read -r line || [[ -n "$line" ]]; do
          line="''${line%$'\r'}"
          [[ -z "$line" ]] && continue
          lines+=("$line")
        done < "$input"
        [[ ''${#lines[@]} -eq 1 ]] || return 1
        line="''${lines[0]}"
        [[ "$line" =~ ^/nix/store/[0-9abcdfghijklmnpqrsvwxyz]{32}-nixos-system-[^/[:space:]]+$ ]] || return 1
        printf '%s\n' "$line"
      }

      #@MNX-PART id=99.86.mnx-upgrade.function.classify-build-log kind=function title="Function classify_build_log"
      classify_build_log() {
        local log="$1" out="$2"
        {
          printf 'insecure_marker_count=%s\n' "$(grep -aEc 'marked as insecure' "$log" 2>/dev/null || true)"
          printf 'diagnostic_hint_count=%s\n' "$(grep -aEc '(^|[[:space:]])error:|Failed to|does not exist|undefined variable|assertion([[:space:]].*)?[[:space:]]failed' "$log" 2>/dev/null || true)"
          printf '\nSelected contexts:\n'
          grep -anE -B4 -A18 'marked as insecure|(^|[[:space:]])error:|Failed to|does not exist|undefined variable|assertion([[:space:]].*)?[[:space:]]failed' "$log" 2>/dev/null | tail -n 600 || true
        } > "$out"
      }

      #@MNX-PART id=99.86.mnx-upgrade.function.validate-compatibility-json kind=function title="Function validate_compatibility_json"
      validate_compatibility_json() {
        local input="$1"
        jq -e --arg release "$TARGET_SERIES" '
          type == "object" and
          .targetRelease == $release and
          .stateVersion == "24.11" and
          .dbusImplementation == "dbus" and
          .fuseEnable == true and
          .fuseAllowOther == true and
          .flatpakEnable == true and
          .xserverEnable == true and
          .i3Enable == true and
          .lightdmEnable == true and
          .defaultSession == "none+i3" and
          .autoLoginEnable == true and
          .autoLoginUser == "h0p3" and
          (.videoDrivers | index("nvidia")) != null and
          .nvidiaModesetting == true and
          .nvidiaOpen == false and
          .systemdBootEnable == true and
          .initrdSystemd == false and
          (.specialisations | index("gui-rescue")) != null and
          (.specialisations | index("terminal-rescue")) != null and
          (["/","/boot","/home","/nix","/syncs","/mnt/btrfs-root","/mnt/m16-backup-nvme","/mnt/m16-new-storage","/mnt/m16-old-storage","/mnt/torrents"] - .fileSystems | length) == 0 and
          .swapDeviceCount == 1 and
          .luksDevices == [] and
          (.kernelVersion | type) == "string" and (.kernelVersion | length) > 0
        ' "$input" >/dev/null
      }

      #@MNX-PART id=99.86.mnx-upgrade.function.build-command kind=function title="Function build_command"
      build_command() {
        require_root build
        (( $# == 0 )) || { usage >&2; return 64; }

        install -d -o root -g logbook -m 2750 "$SUPPORT_ROOT"
        install -d -o root -g root -m 0755 /run/monsternix
        exec 8<>"$UPGRADE_LOCK"
        flock -n -x 8 || { echo 'MNX_UPGRADE_BUILD=DEFERRED_UPGRADE_LOCK_BUSY' >&2; return 75; }
        exec 9<>"$STORAGE_LOCK"
        flock -n -x 9 || { echo 'MNX_UPGRADE_BUILD=DEFERRED_STORAGE_LOCK_BUSY' >&2; return 75; }

        local stamp bundle candidate release_file prefetch_json prefetch_err compatibility_json build_stdout build_log diff_log path_info_log contexts summary
        local result=INCOMPLETE error=none body_rc=1 manifest_rc=not-run
        local before_running before_default before_source before_active before_channel_profile before_channel_file before_channel_list before_state before_old_mode
        local after_running after_default after_source after_active after_channel_profile after_channel_file after_channel_list after_state after_old_mode
        local feed_effective=unknown feed_matches=unknown observed_revision=unknown archive_store_path=unknown archive_store_hash=unknown archive_actual_sha=unknown prefetch_path=unknown prefetch_hash=unknown target_version=unknown
        local build_rc=not-run staged_system=none staged_source_sha=unknown staged_output_line_count=unknown build_stdout_sha=unknown insecure_count=unknown mutation_proof=unknown
        local build_child="" build_bytes=0 build_last="" manifest_log=""

        stamp="$(date +%Y%m%dT%H%M%S)-$$"
        bundle="$SUPPORT_ROOT/mnx-upgrade-build-$stamp"
        candidate="$bundle/candidate.nix"
        release_file="$bundle/release.txt"
        prefetch_json="$bundle/prefetch.json"
        prefetch_err="$bundle/prefetch.stderr"
        compatibility_json="$bundle/compatibility.json"
        build_stdout="$bundle/build.stdout"
        build_log="$bundle/build.log"
        diff_log="$bundle/diff.log"
        path_info_log="$bundle/path-info.log"
        contexts="$bundle/build-contexts.txt"
        summary="$bundle/summary.txt"
        install -d -o root -g logbook -m 0750 "$bundle"

        before_running="$(readlink -f /run/current-system 2>/dev/null || true)"
        before_default="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
        before_source="$(sha_file "$CONFIG" 2>/dev/null || true)"
        before_active="$(sha_file /run/current-system/configuration.nix 2>/dev/null || true)"
        before_channel_profile="$(readlink -f /nix/var/nix/profiles/per-user/root/channels 2>/dev/null || true)"
        before_channel_file="$(sha_file /root/.nix-channels 2>/dev/null || echo missing)"
        before_channel_list="$(nix-channel --list 2>/dev/null || true)"
        before_state="$(systemctl is-system-running 2>/dev/null || true)"
        before_old_mode="$(findmnt -rn -T /mnt/m16-old-storage -o OPTIONS 2>/dev/null | awk 'BEGIN{m="unresolved"} /(^|,)ro(,|$)/{m="ro"} /(^|,)rw(,|$)/{m="rw"} END{print m}')"

        #@MNX-PART id=99.86.mnx-upgrade.function.build-body kind=function title="Function build_body"
      build_body() {
          local failed effective revision archive_raw unpacked_raw version_raw compatibility_expr
          [[ -f "$CONFIG" && ! -L "$CONFIG" ]] || { result=FAIL_SOURCE; error=editable-source-is-not-regular-nonsymlink; return 1; }
          [[ "$before_running" == "$before_default" && -n "$before_running" ]] || { result=FAIL_BASELINE; error=running-and-default-differ; return 1; }
          [[ "$before_source" == "$before_active" && "$before_source" =~ ^[0-9a-f]{64}$ ]] || { result=FAIL_BASELINE; error=editable-and-active-source-differ; return 1; }
          [[ "$before_state" == running ]] || { result=FAIL_BASELINE; error=system-not-running; return 1; }
          failed="$(systemctl --failed --no-legend --plain 2>/dev/null || true)"
          [[ -z "$failed" ]] || { result=FAIL_BASELINE; error=failed-units-present; return 1; }
          case "$(systemctl is-active "$RAW_TIMER" 2>/dev/null || true)" in active|activating|reloading) result=FAIL_POLICY; error=raw-upgrade-timer-active; return 1 ;; esac
          case "$(systemctl is-enabled "$RAW_TIMER" 2>/dev/null || true)" in enabled|enabled-runtime|linked|linked-runtime|alias) result=FAIL_POLICY; error=raw-upgrade-timer-enabled; return 1 ;; esac
          [[ "$before_old_mode" == ro ]] || { result=FAIL_POLICY; error=old-storage-host-mount-not-read-only; return 1; }
          if [[ "''${MNX_OFFICE_POST_COMMIT_SEAL:-0}" == 1 ]]; then
            MNX_OFFICE_POST_COMMIT_SEAL=1 /etc/monsternix/bin/mnx-office verify --allow-incomplete-switch >/dev/null || { result=FAIL_OFFICE; error=accepted-office-invalid-during-post-commit-seal; return 1; }
          else
            /etc/monsternix/bin/mnx-office verify >/dev/null || { result=FAIL_OFFICE; error=accepted-office-invalid; return 1; }
          fi

          install -o root -g logbook -m 0640 "$CONFIG" "$candidate" || { result=FAIL_FREEZE; error=candidate-freeze-failed; return 1; }
          [[ "$(sha_file "$candidate")" == "$before_source" ]] || { result=FAIL_FREEZE; error=candidate-hash-mismatch; return 1; }

          effective="$(curl --fail --silent --show-error --location --output /dev/null --write-out '%{url_effective}' "$CHANNEL_URL")" || { result=FAIL_NETWORK; error=channel-resolution-failed; return 1; }
          feed_effective="$(normalize_url "$effective")"
          [[ "$feed_effective" == "$RELEASE_URL" ]] && feed_matches=yes || feed_matches=no
          revision="$(curl --fail --silent --show-error --location "$RELEASE_URL/git-revision")" || { result=FAIL_NETWORK; error=release-revision-fetch-failed; return 1; }
          revision="''${revision//$'\r'/}"; revision="''${revision//$'\n'/}"
          observed_revision="$revision"
          [[ "$observed_revision" == "$RELEASE_REVISION" ]] || { result=FAIL_RELEASE_IDENTITY; error=release-revision-mismatch; return 1; }
          {
            printf 'channel_url=%s\nchannel_effective_url=%s\nfeed_matches_pinned_release=%s\n' "$CHANNEL_URL" "$feed_effective" "$feed_matches"
            printf 'release_name=%s\nrelease_url=%s\nrelease_revision=%s\narchive_url=%s\n' "$RELEASE_NAME" "$RELEASE_URL" "$observed_revision" "$ARCHIVE_URL"
            printf 'pinned_archive_file_sha256=%s\npinned_archive_file_sha256_hex=%s\n' "$ARCHIVE_FILE_HASH" "$ARCHIVE_SHA256_HEX"
            printf 'source_verification=official-release-git-revision-and-flat-archive-sha256-before-local-unpack\n'
          } > "$release_file"

          archive_raw="$(nix --extra-experimental-features nix-command store prefetch-file --json --name nixexprs.tar.xz --expected-hash "$ARCHIVE_FILE_HASH" "$ARCHIVE_URL" 2>"$prefetch_err")" || { result=FAIL_PREFETCH; error=archive-prefetch-or-hash-check-failed; return 1; }
          jq -e 'type == "object" and (.storePath | type) == "string" and (.hash | type) == "string"' <<< "$archive_raw" >/dev/null || { result=FAIL_PREFETCH; error=archive-prefetch-json-invalid; return 1; }
          archive_store_path="$(jq -r '.storePath' <<< "$archive_raw")"
          archive_store_hash="$(jq -r '.hash' <<< "$archive_raw")"
          [[ "$archive_store_path" =~ ^/nix/store/[0-9abcdfghijklmnpqrsvwxyz]{32}-nixexprs[.]tar[.]xz$ && -f "$archive_store_path" && ! -L "$archive_store_path" ]] || { result=FAIL_RELEASE_IDENTITY; error=archive-store-path-invalid; return 1; }
          [[ "$archive_store_hash" == "$ARCHIVE_FILE_HASH" ]] || { result=FAIL_RELEASE_IDENTITY; error=archive-store-hash-mismatch; return 1; }
          archive_actual_sha="$(sha_file "$archive_store_path" 2>/dev/null || true)"
          [[ "$archive_actual_sha" == "$ARCHIVE_SHA256_HEX" ]] || { result=FAIL_RELEASE_IDENTITY; error=archive-flat-sha256-mismatch; return 1; }

          unpacked_raw="$(nix --extra-experimental-features nix-command store prefetch-file --json --unpack --name nixexprs.tar.xz "file://$archive_store_path" 2>>"$prefetch_err")" || { result=FAIL_PREFETCH; error=verified-archive-local-unpack-failed; return 1; }
          [[ "$(sha_file "$archive_store_path" 2>/dev/null || true)" == "$ARCHIVE_SHA256_HEX" ]] || { result=FAIL_RELEASE_IDENTITY; error=archive-changed-during-local-unpack; return 1; }
          jq -e 'type == "object" and (.storePath | type) == "string" and (.hash | type) == "string"' <<< "$unpacked_raw" >/dev/null || { result=FAIL_PREFETCH; error=unpacked-prefetch-json-invalid; return 1; }
          jq -n --argjson archive "$archive_raw" --argjson unpacked "$unpacked_raw" '{archive:$archive,unpacked:$unpacked}' > "$prefetch_json"
          prefetch_path="$(jq -r '.storePath' <<< "$unpacked_raw")"
          prefetch_hash="$(jq -r '.hash' <<< "$unpacked_raw")"
          [[ "$prefetch_path" =~ ^/nix/store/[0-9abcdfghijklmnpqrsvwxyz]{32}-nixexprs[.]tar[.]xz$ && -d "$prefetch_path" ]] || { result=FAIL_RELEASE_IDENTITY; error=unpacked-store-path-invalid; return 1; }
          [[ "$prefetch_hash" =~ ^sha256-[A-Za-z0-9+/]{43}=$ ]] || { result=FAIL_RELEASE_IDENTITY; error=unpacked-nar-hash-invalid; return 1; }
          [[ -f "$prefetch_path/default.nix" && -d "$prefetch_path/nixos" ]] || { result=FAIL_RELEASE_IDENTITY; error=unpacked-source-layout-invalid; return 1; }

          version_raw="$(env NIX_PATH="nixpkgs=$prefetch_path" nix-instantiate --eval --strict '<nixpkgs>' -A lib.version 2>>"$prefetch_err")" || { result=FAIL_EVALUATION; error=target-version-evaluation-failed; return 1; }
          target_version="$(jq -r . <<< "$version_raw" 2>>"$prefetch_err")" || { result=FAIL_EVALUATION; error=target-version-json-decode-failed; return 1; }
          [[ "$target_version" =~ ^26[.]05([.]|pre|$) ]] || { result=FAIL_RELEASE_IDENTITY; error=target-version-series-mismatch; return 1; }

          compatibility_expr='let evaluated = import <nixpkgs/nixos> {}; c = evaluated.config; in {
            targetRelease = c.system.nixos.release;
            targetVersion = c.system.nixos.version;
            stateVersion = c.system.stateVersion;
            initrdSystemd = c.boot.initrd.systemd.enable;
            dbusImplementation = c.services.dbus.implementation;
            fuseEnable = c.programs.fuse.enable;
            fuseAllowOther = c.programs.fuse.userAllowOther;
            flatpakEnable = c.services.flatpak.enable;
            xserverEnable = c.services.xserver.enable;
            i3Enable = c.services.xserver.windowManager.i3.enable;
            lightdmEnable = c.services.xserver.displayManager.lightdm.enable;
            defaultSession = c.services.displayManager.defaultSession;
            autoLoginEnable = c.services.displayManager.autoLogin.enable;
            autoLoginUser = c.services.displayManager.autoLogin.user;
            videoDrivers = c.services.xserver.videoDrivers;
            nvidiaModesetting = c.hardware.nvidia.modesetting.enable;
            nvidiaOpen = c.hardware.nvidia.open;
            systemdBootEnable = c.boot.loader.systemd-boot.enable;
            specialisations = builtins.attrNames c.specialisation;
            fileSystems = builtins.attrNames c.fileSystems;
            swapDeviceCount = builtins.length c.swapDevices;
            luksDevices = builtins.attrNames c.boot.initrd.luks.devices;
            kernelVersion = c.boot.kernelPackages.kernel.version;
          }'
          env NIX_PATH="nixpkgs=$prefetch_path:nixos-config=$candidate" nix-instantiate --eval --strict --json --expr "$compatibility_expr" > "$compatibility_json" 2>>"$prefetch_err" || { result=FAIL_EVALUATION; error=compatibility-projection-evaluation-failed; return 1; }
          validate_compatibility_json "$compatibility_json" || { result=FAIL_COMPATIBILITY; error=critical-compatibility-projection-mismatch; return 1; }

          : > "$build_stdout"
          : > "$build_log"
          setsid env NIX_PATH="nixpkgs=$prefetch_path:nixos-config=$candidate" \
            nix-build '<nixpkgs/nixos>' -A system --no-out-link --show-trace > "$build_stdout" 2> "$build_log" &
          build_child="$!"
          trap 'kill -TERM -- -"$build_child" 2>/dev/null || true; exit 130' INT
          trap 'kill -TERM -- -"$build_child" 2>/dev/null || true; exit 143' TERM
          while kill -0 "$build_child" 2>/dev/null; do
            sleep 20
            kill -0 "$build_child" 2>/dev/null || break
            build_bytes="$(( $(stat -c '%s' "$build_log" 2>/dev/null || echo 0) + $(stat -c '%s' "$build_stdout" 2>/dev/null || echo 0) ))"
            build_last="$(tail -c 65536 "$build_log" 2>/dev/null | tr '\000\r\n' '   ' | LC_ALL=C tr -cd '\11\40-\176' | tail -c 240)"
            printf '%s phase=upgrade-build log_bytes=%s last=%s\n' "$(date -Is)" "$build_bytes" "$build_last"
          done
          wait "$build_child"
          build_rc="$?"
          build_child=""
          trap - INT TERM
          classify_build_log "$build_log" "$contexts"
          insecure_count="$(sed -n 's/^insecure_marker_count=//p' "$contexts" | head -n 1)"
          staged_output_line_count="$(tr -d '\r' < "$build_stdout" | awk 'NF { count += 1 } END { print count + 0 }')"
          build_stdout_sha="$(sha_file "$build_stdout" 2>/dev/null || true)"
          if [[ "$build_rc" != 0 ]]; then result=FAIL_BUILD; error=staged-nixos-build-failed; return 1; fi

          staged_system="$(resolve_staged_system_path "$build_stdout" 2>/dev/null || true)"
          [[ "$staged_output_line_count" == 1 && "$staged_system" == /nix/store/* && -d "$staged_system" ]] || { result=FAIL_BUILD_OUTPUT; error=staged-system-stdout-not-one-exact-path; return 1; }
          [[ -x "$staged_system/bin/switch-to-configuration" ]] || { result=FAIL_BUILD_OUTPUT; error=staged-system-lacks-switch-program; return 1; }
          staged_source_sha="$(sha_file "$staged_system/configuration.nix" 2>/dev/null || true)"
          [[ "$staged_source_sha" == "$before_source" ]] || { result=FAIL_BUILD_OUTPUT; error=staged-system-embedded-source-mismatch; return 1; }
          nix --extra-experimental-features nix-command path-info -Sh "$before_running" "$staged_system" > "$path_info_log" 2>&1 || true
          nix --extra-experimental-features nix-command store diff-closures "$before_running" "$staged_system" > "$diff_log" 2>&1 || true
          result=PASS_BUILD
          error=none
          return 0
        }

        set +e
        build_body
        body_rc="$?"
        set -e

        after_running="$(readlink -f /run/current-system 2>/dev/null || true)"
        after_default="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
        after_source="$(sha_file "$CONFIG" 2>/dev/null || true)"
        after_active="$(sha_file /run/current-system/configuration.nix 2>/dev/null || true)"
        after_channel_profile="$(readlink -f /nix/var/nix/profiles/per-user/root/channels 2>/dev/null || true)"
        after_channel_file="$(sha_file /root/.nix-channels 2>/dev/null || echo missing)"
        after_channel_list="$(nix-channel --list 2>/dev/null || true)"
        after_state="$(systemctl is-system-running 2>/dev/null || true)"
        after_old_mode="$(findmnt -rn -T /mnt/m16-old-storage -o OPTIONS 2>/dev/null | awk 'BEGIN{m="unresolved"} /(^|,)ro(,|$)/{m="ro"} /(^|,)rw(,|$)/{m="rw"} END{print m}')"

        if [[ "$after_running" == "$before_running" && "$after_default" == "$before_default" &&
              "$after_source" == "$before_source" && "$after_active" == "$before_active" &&
              "$after_channel_profile" == "$before_channel_profile" && "$after_channel_file" == "$before_channel_file" &&
              "$after_channel_list" == "$before_channel_list" && "$after_state" == running && "$after_old_mode" == ro ]]; then
          mutation_proof=pass
        else
          mutation_proof=FAIL
          result=FAIL_MUTATION_PROOF
          error=nonactivating-build-changed-protected-state
          body_rc=1
        fi

        {
          printf 'schema=mnx.upgrade.build.v2\nupgrade_schema=%s\nresult=%s\nerror=%s\ntimestamp=%s\n' "$UPGRADE_SCHEMA" "$result" "$error" "$(date -Is)"
          printf 'configuration=%s\nconfiguration_sha256=%s\ncandidate=%s\n' "$CONFIG" "$before_source" "$candidate"
          printf 'target_series=%s\nchannel_url=%s\nchannel_effective_url=%s\nfeed_matches_pinned_release=%s\n' "$TARGET_SERIES" "$CHANNEL_URL" "$feed_effective" "$feed_matches"
          printf 'release_name=%s\nrelease_url=%s\nrelease_revision=%s\narchive_url=%s\npinned_archive_file_sha256=%s\narchive_store_path=%s\narchive_store_hash=%s\narchive_actual_sha256=%s\n' "$RELEASE_NAME" "$RELEASE_URL" "$observed_revision" "$ARCHIVE_URL" "$ARCHIVE_FILE_HASH" "$archive_store_path" "$archive_store_hash" "$archive_actual_sha"
          printf 'prefetch_store_path=%s\nprefetch_hash=%s\ntarget_nixpkgs_version=%s\ncompatibility_evidence=%s\n' "$prefetch_path" "$prefetch_hash" "$target_version" "$compatibility_json"
          printf 'staged_build_rc=%s\nstaged_system=%s\nstaged_embedded_configuration_sha256=%s\nstaged_output_line_count=%s\nbuild_stdout_sha256=%s\ninsecure_marker_count=%s\n' "$build_rc" "$staged_system" "$staged_source_sha" "$staged_output_line_count" "$build_stdout_sha" "$insecure_count"
          printf 'before_running_system=%s\nafter_running_system=%s\nbefore_default_system=%s\nafter_default_system=%s\n' "$before_running" "$after_running" "$before_default" "$after_default"
          printf 'before_channel_profile=%s\nafter_channel_profile=%s\nbefore_channel_file_sha256=%s\nafter_channel_file_sha256=%s\n' "$before_channel_profile" "$after_channel_profile" "$before_channel_file" "$after_channel_file"
          printf 'source_changed=%s\nchannel_subscription_changed=%s\nchannel_profile_changed=%s\nsystem_profile_changed=%s\nrunning_system_changed=%s\nboot_default_changed=%s\nactivation_attempted=no\noperator_reboot_permitted=no\npromotion_authorized=no\ntarget_dbus_implementation=dbus\ntarget_initrd_systemd=false\nold_storage_written=no\n' \
            "$([[ "$before_source" == "$after_source" ]] && echo no || echo YES)" \
            "$([[ "$before_channel_list" == "$after_channel_list" && "$before_channel_file" == "$after_channel_file" ]] && echo no || echo YES)" \
            "$([[ "$before_channel_profile" == "$after_channel_profile" ]] && echo no || echo YES)" \
            "$([[ "$before_default" == "$after_default" ]] && echo no || echo YES)" \
            "$([[ "$before_running" == "$after_running" ]] && echo no || echo YES)" \
            "$([[ "$before_default" == "$after_default" ]] && echo no || echo YES)"
          printf 'mutation_proof=%s\nbundle=%s\n' "$mutation_proof" "$bundle"
          [[ "$result" == PASS_BUILD ]] && echo 'MNX_UPGRADE_BUILD=PASS' || echo "MNX_UPGRADE_BUILD=$result"
        } > "$summary.tmp"
        chown root:logbook "$summary.tmp"; chmod 0640 "$summary.tmp"; mv -f "$summary.tmp" "$summary"

        for file in "$release_file" "$prefetch_json" "$prefetch_err" "$compatibility_json" "$build_stdout" "$build_log" "$diff_log" "$path_info_log" "$contexts"; do
          [[ ! -e "$file" ]] || { chown root:logbook "$file" 2>/dev/null || true; chmod 0640 "$file" 2>/dev/null || true; }
        done
        [[ ! -e "$candidate" ]] || { chown root:logbook "$candidate"; chmod 0640 "$candidate"; }

        manifest_log="$(mktemp /tmp/mnx-upgrade-manifest.XXXXXX)"
        set +e
        /etc/monsternix/bin/mnx-bundle-manifest create "$bundle" 2 > "$manifest_log" 2>&1
        manifest_rc="$?"
        set -e
        if [[ "$manifest_rc" != 0 ]]; then
          echo 'MNX_UPGRADE_BUILD=FAIL_EVIDENCE_MANIFEST' >&2
          cat "$manifest_log" >&2 || true
          rm -f -- "$manifest_log"
          cat "$summary"
          return 1
        fi
        rm -f -- "$manifest_log"

        #@MNX-PART id=99.86.mnx-upgrade.phase.build-result kind=phase title="Phase: MNX UPGRADE BUILD RESULT"
        section 'MNX UPGRADE BUILD RESULT'
        cat "$summary"
        printf 'manifest=%s/SHA256SUMS\nmanifest_status=verified\n' "$bundle"
        if [[ -s "$compatibility_json" ]]; then
          printf '\n--- compatibility projection ---\n'
          cat "$compatibility_json" 2>/dev/null || true
        fi
        if [[ "$result" == PASS_BUILD ]]; then
          printf '\n--- staged closure sizes ---\n'
          cat "$path_info_log" 2>/dev/null || true
          printf '\n--- selected build contexts ---\n'
          cat "$contexts" 2>/dev/null || true
          printf '\n--- bounded closure difference ---\n'
          tail -n 240 "$diff_log" 2>/dev/null || true
        else
          printf '\n--- staged build stdout ---\n'
          tr -d '\000' < "$build_stdout" 2>/dev/null || true
          printf '\n--- selected build contexts ---\n'
          cat "$contexts" 2>/dev/null || true
          printf '\n--- final 180 build-log lines ---\n'
          tail -n 180 "$build_log" 2>/dev/null || true
        fi
        [[ "$result" == PASS_BUILD && "$mutation_proof" == pass && "$body_rc" == 0 ]]
      }

      #@MNX-PART id=99.86.mnx-upgrade.function.status-command kind=function title="Function status_command"
      status_command() {
        local json=0 bundle summary
        [[ ''${1:-} != --json ]] || { json=1; shift; }
        (( $# == 0 )) || { usage >&2; return 64; }
        bundle="$(latest_bundle)"
        if [[ -z "$bundle" ]]; then
          (( json )) && jq -n '{schema:"mnx.upgrade.status.v1",status:"not-run",bundle:null,network_used:false,mutation:"none"}' || printf 'schema=mnx.upgrade.status.v1\nstatus=not-run\nnetwork_used=no\nmutation=none\nMNX_UPGRADE_STATUS=NOT_RUN\n'
          return 0
        fi
        summary="$bundle/summary.txt"
