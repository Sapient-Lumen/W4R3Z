      #@MNX-PART id=99.08.mnx-office.function.health-backup-evidence kind=function title="Python function health_backup_evidence"
      def health_backup_evidence(root: Path, uid: int, now: int, *, restic_evidence: dict[str, Any] | None = None) -> dict[str, Any]:
          jobs = ('btrbk-main', 'm16-restic-m21', 'm21-btrfs-pull-backup', 'btrbk-archive-to-new-storage', 'rsync-m16-new-to-old')
          state, text = health_read_file(root / 'var/lib/logbook/backups/freshness-current.txt', 65536, root=root, uid=uid)
          epochs = re.findall(r'(?m)^epoch=([0-9]{1,15})$', text)
          epoch = int(epochs[0]) if len(epochs) == 1 else None
          if state == 'read' and (epoch is None or not 0 < epoch <= now):
              state = 'invalid-evaluation-timestamp'
          # Both report views consume this same validated sample. Completion time is
          # retained as completion, never used as a substitute for the source bound.
          restic = health_restic_evidence(root, uid, now) if restic_evidence is None else restic_evidence
          result: dict[str, Any] = {'read_state': state, 'evaluation_epoch': epoch,
                                    'evaluation_age_seconds': now - epoch if epoch is not None else None,
                                    'proof': 'cached-freshness-and-success-receipts-not-repository-verification',
                                    'time_comparison_policy': 'matching-bases-only', 'jobs': {}}
          for job in jobs:
              row: dict[str, Any] = {'evaluated_time_basis': 'unknown', 'evaluated_row_state': 'missing-or-unreadable',
                                     'evaluated_row_superseded': None, 'supersession_comparison': 'not-comparable'}
              matches = [line.split('\t') for line in text.splitlines() if line.startswith(job + '\t')] if state == 'read' else []
              if len(matches) == 1 and len(matches[0]) == 10:
                  fields = matches[0]
                  expected_unit = 'm16-backup-m21.service' if job == 'm16-restic-m21' else job + '.service'
                  if (fields[1] == expected_unit and
                          all(re.fullmatch(r'[0-9]{1,15}', fields[index]) for index in (2, 3, 4)) and
                          fields[5] in ('0', '1') and fields[6] in ('0', '1') and
                          epoch is not None and int(fields[2]) <= epoch):
                      basis = {'marker': 'backup-completion', 'observed-data': 'observed-data-time',
                               'missing': 'missing'}.get(fields[8], 'unknown')
                      if job == 'm16-restic-m21' and fields[8] == 'root-restic-success-source-bound':
                          basis = 'backup-attempt-start-lower-bound'
                      row.update(evaluated_success_epoch=int(fields[2]), age_at_evaluation_seconds=int(fields[3]),
                                 threshold_seconds=int(fields[4]), stale_at_evaluation=int(fields[5]), critical_at_evaluation=int(fields[6]),
                                 evaluated_time_basis=basis, evaluated_row_state='read')
                  else:
                      row['evaluated_row_state'] = 'invalid-row'
              elif matches:
                  row['evaluated_row_state'] = 'duplicate-or-malformed-row'
              if job == 'm16-restic-m21':
                  success_state = restic['success_receipt_state']
                  success = restic['completion_epoch']
                  source = restic['source_epoch']
                  row.update(success_receipt_source_epoch=source,
                             success_receipt_source_age_seconds=now - source if source is not None else None,
                             success_receipt_source_time_basis='backup-attempt-start-lower-bound' if source is not None else 'unknown')
              else:
                  success_state, success_text = health_read_file(root / ('var/lib/monsternix/job-state/authoritative/' + job + '.last-success'), 4096, root=root, uid=uid)
                  success_epochs = re.findall(r'(?m)^epoch=([0-9]{1,15})$', success_text)
                  success = int(success_epochs[0]) if len(success_epochs) == 1 else None
                  source = None
                  if success_state == 'read' and (success is None or not 0 < success <= now):
                      success_state = 'invalid-success-timestamp'
              row.update(success_receipt_state=success_state, success_receipt_epoch=success,
                         success_receipt_age_seconds=now - success if success is not None else None,
                         success_receipt_time_basis='backup-completion')
              comparable = None
              if success_state == 'read':
                  if row['evaluated_time_basis'] == 'backup-completion':
                      comparable = success
                  elif row['evaluated_time_basis'] == 'backup-attempt-start-lower-bound' and job == 'm16-restic-m21':
                      comparable = source
              # A fallback observation, missing record or unknown basis is not a
              # completion receipt. Do not silently order two different meanings.
              row['latest_comparable_epoch'] = comparable
              evaluated = row.get('evaluated_success_epoch')
              if (type(comparable) is int and type(evaluated) is int and
                      0 < evaluated <= now and 0 < comparable <= now):
                  row['evaluated_row_superseded'] = comparable > evaluated
                  row['supersession_comparison'] = ('same-basis-newer' if comparable > evaluated else
                                                    'same-basis-equal' if comparable == evaluated else 'same-basis-older')
              result['jobs'][job] = row
          return result


      #@MNX-PART id=99.08.mnx-office.function.recovery-unique-pairs kind=function title="Python function recovery_unique_pairs"
      def recovery_unique_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
          result: dict[str, Any] = {}
          for key, value in pairs:
              if key in result:
                  raise ValueError('duplicate field')
              result[key] = value
          return result


      #@MNX-PART id=99.08.mnx-office.function.recovery-key-values kind=function title="Python function recovery_key_values"
      def recovery_key_values(text: str) -> dict[str, str]:
          fields: list[tuple[str, str]] = []
          for line in text.splitlines():
              match = re.fullmatch(r'([a-z][a-z0-9_]*)=([^\r\n]*)', line)
              if match is None:
                  raise ValueError('invalid field')
              fields.append((match[1], match[2]))
          return recovery_unique_pairs(fields)


      #@MNX-PART id=99.08.mnx-office.function.recovery-detail-value kind=function title="Python function recovery_detail_value"
      def recovery_detail_value(record: dict[str, Any], key: str, pattern: str) -> str | None:
          # Only callers' fixed key names and bounded value grammars reach public output.
          matches = re.findall(r'(?:^| )' + re.escape(key) + r'=([^ ]*)(?= |$)', record['details'])
          if len(matches) == 1 and re.fullmatch(pattern, matches[0]):
              return matches[0]
          return None


      #@MNX-PART id=99.08.mnx-office.function.health-recovery-evidence kind=function title="Python function health_recovery_evidence"
      def health_recovery_evidence(root: Path, uid: int, now: int) -> dict[str, Any]:
          """Authenticate existing local qualification evidence, never rerun qualification.

          These are historical controller witnesses, not current repository verification,
          an independent source-content comparison, or permission to remove recovery data.
          Unlike the legacy verifier, this reader never normalizes directory permissions.
          """
          result: dict[str, Any] = {
              'schema': 'mnx.restic.recovery-evidence.v1', 'state': 'unavailable',
              'historical_qualification_verified': False, 'qualification_run': None,
              'scope': 'existing-m21-home-tar-export', 'whole_machine_coverage_proven': False,
              'proof_scope': 'manifest-and-historical-controller-witness-consistency-not-reexecution',
              'carried_phase_provenance_reverified': False,
              'current_snapshot_restore_verified': False, 'repository_data_read': False,
              'restore_performed': False, 'network_used': False, 'secrets_read': False,
              'state_mutated': False, 'raw_receipt_or_log_text_exported': False,
              'all_historical_residue_removed': False, 'retirement_authorized': False,
          }
          base = root / 'var/lib/monsternix/restic-qualification'
          issue = 'qualification-pointer'
          try:
              pointer_state, pointer = health_read_file(base / 'current', 128, root=root, uid=uid)
              result['pointer_read_state'] = pointer_state
              if pointer_state != 'read':
                  result['state'] = pointer_state
                  return result
              run = pointer.removesuffix('\n')
              if not re.fullmatch(r'[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}', run):
                  raise ValueError('invalid run')
              issue = 'enablement-marker'
              marker_state, marker_text = health_read_file(base / 'automatic-enabled', 4096, root=root, uid=uid)
              if marker_state != 'read':
                  result.update(state='unavailable', issue=issue, marker_read_state=marker_state)
                  return result
              marker = recovery_key_values(marker_text)
              marker_keys = {'schema', 'source_sha256', 'running_system', 'default_system',
                             'qualification_run', 'qualification_manifest_sha256', 'scheduling_receipt', 'old_btrfs_timer'}
              if (set(marker) != marker_keys or marker['schema'] != 'mnx.restic.automatic-enablement.v1' or
                      marker['qualification_run'] != run or marker['scheduling_receipt'] != 'present' or
                      marker['old_btrfs_timer'] != 'enabled'):
                  raise ValueError('marker disagrees')
              directory = base / 'runs' / run
              issue = 'manifest'
              manifest_state, manifest_text = health_read_file(directory / 'SHA256SUMS', 16384, root=root, uid=uid)
              if manifest_state != 'read':
                  result.update(state='unavailable', issue=issue, manifest_read_state=manifest_state)
                  return result
              manifest_sha = hashlib.sha256(manifest_text.encode('utf-8')).hexdigest()
              if manifest_sha != marker['qualification_manifest_sha256']:
                  raise ValueError('unbound manifest')
              members: dict[str, str] = {}
              for line in manifest_text.splitlines():
                  match = re.fullmatch(r'([0-9a-f]{64})  (state|restic-check[.]log|[0-9]{3}-[a-z0-9-]{1,80}[.]json)', line)
                  if match is None or match[2] in members:
                      raise ValueError('invalid manifest member')
                  members[match[2]] = match[1]
              if not 3 <= len(members) <= 96 or not {'state', 'restic-check.log'} <= set(members):
                  raise ValueError('invalid manifest count')
              issue = 'closed-tree'
              info_before = directory.lstat()
              names: set[str] = set()
              with os.scandir(directory) as entries:
                  for entry in entries:
                      names.add(entry.name)
                      if len(names) > 97:
                          raise ValueError('too many entries')
              if names != set(members) | {'SHA256SUMS'}:
                  raise ValueError('unmanifested entry')
              issue = 'member-integrity'
              records: dict[str, dict[str, Any]] = {}
              by_phase: dict[str, dict[str, Any]] = {}
              identities: dict[str, tuple[int, ...]] = {}
              stat_keys = ('st_dev', 'st_ino', 'st_mode', 'st_uid', 'st_gid', 'st_nlink', 'st_size', 'st_mtime_ns', 'st_ctime_ns')
              total = 0
              state: dict[str, str] = {}
              check_log_size = 0
              for name, digest in members.items():
                  path = directory / name
                  before = path.lstat()
                  limit = 1048576 if name == 'restic-check.log' else 65536
                  read_state, text = health_read_file(path, limit, root=root, uid=uid, allow_empty=name == 'restic-check.log')
                  if read_state != 'read':
                      result.update(state='unavailable', issue=issue, member_read_state=read_state)
                      return result
                  raw = text.encode('utf-8')
                  total += len(raw)
                  if total > 2097152 or hashlib.sha256(raw).hexdigest() != digest:
                      raise ValueError('member size or digest')
                  identities[name] = tuple(getattr(before, field) for field in stat_keys)
                  after = path.lstat()
                  if identities[name] != tuple(getattr(after, field) for field in stat_keys):
                      raise ValueError('member changed')
                  if name == 'state':
                      state = recovery_key_values(text)
                  elif name == 'restic-check.log':
                      check_log_size = len(raw)  # Hash only: never interpret or publish log text.
                  else:
                      record = json.loads(text, object_pairs_hook=recovery_unique_pairs)
                      if (not isinstance(record, dict) or record.get('schema') != 'mnx.restic.qualification.receipt.v1' or
                              type(record.get('sequence')) is not int or not 1 <= record['sequence'] <= 999 or
                              not isinstance(record.get('phase'), str) or not re.fullmatch(r'[a-z0-9-]{1,80}', record['phase']) or
                              name != f"{record['sequence']:03d}-{record['phase']}.json" or
                              record.get('status') != 'pass' or record.get('secrets_recorded') is not False or
                              record.get('network_evidence_is_authority') is not False or
                              not isinstance(record.get('details'), str) or len(record['details']) > 16384):
                          raise ValueError('invalid receipt')
                      if record['phase'] in by_phase:
                          raise ValueError('duplicate phase')
                      recorded = record.get('recorded_at')
                      if not isinstance(recorded, str) or not re.fullmatch(r'[0-9TZ:+.-]{10,40}', recorded):
                          raise ValueError('invalid timestamp')
                      when = dt.datetime.fromisoformat(recorded)
                      if when.tzinfo is None or not 0 < int(when.timestamp()) <= now:
                          raise ValueError('invalid timestamp')
                      records[name] = record
                      by_phase[record['phase']] = record
              issue = 'qualification-identity'
              source = state.get('source_sha256', ''')
              closure = state.get('running_system', ''')
              if (state.get('run') != run or not re.fullmatch(r'[0-9a-f]{64}', source) or
                      not re.fullmatch(r'/nix/store/[0-9a-z]{32}-nixos-system-monster-16-[A-Za-z0-9.+_-]+', closure) or
                      state.get('default_system') != closure or marker['source_sha256'] != source or
                      marker['running_system'] != closure or marker['default_system'] != closure):
                  raise ValueError('identity mismatch')
              for record in records.values():
                  if record.get('source_sha256') != source or record.get('running_system') != closure or record.get('default_system') != closure:
                      raise ValueError('mixed receipt identity')
              required = ('begin', 'backup-1', 'backup-2', 'source-cleanup-success', 'failure-expected',
                          'source-cleanup-failure', 'recovery', 'check', 'restore', 'restore-accepted',
                          'restore-cleaned', 'final', 'scheduling-enabled')
              issue = 'qualification-phases'
              if any(phase not in by_phase for phase in required):
                  raise ValueError('required phase missing')
              sequences = [by_phase[phase]['sequence'] for phase in required]
              all_sequences = [record['sequence'] for record in records.values()]
              if sequences != sorted(sequences) or sorted(all_sequences) != list(range(1, len(all_sequences) + 1)):
                  raise ValueError('phase order or sequence differs')
              issue = 'restore-witness'
              restored, accepted, cleaned = (by_phase[p] for p in ('restore', 'restore-accepted', 'restore-cleaned'))
              target = '/mnt/m16-new-storage/admin/restore-tests/' + run
              if any(recovery_detail_value(row, 'target', re.escape(target)) != target for row in (restored, accepted, cleaned)):
                  raise ValueError('restore target differs')
              for row, flags in ((restored, ('restic_stream_verified', 'tar_extraction_verified')),
                                 (accepted, ('machine_verified', 'restic_stream_verified', 'successful_tar_extraction', 'measurements_unchanged')),
                                 (cleaned, ('absent',)),
                                 (by_phase['source-cleanup-success'], ('snapshot_absent',)),
                                 (by_phase['source-cleanup-failure'], ('snapshot_absent',))):
                  if any(recovery_detail_value(row, flag, 'yes') != 'yes' for flag in flags):
                      raise ValueError('required witness flag missing')
              projected: dict[str, Any] = {}
              for key in ('restored_bytes', 'restored_file_count', 'path_sample_sha256'):
                  pattern = r'[0-9a-f]{64}' if key.endswith('sha256') else r'[1-9][0-9]{0,19}'
                  value = recovery_detail_value(restored, key, pattern)
                  if value is None or recovery_detail_value(accepted, key, pattern) != value:
                      raise ValueError('restore measurements differ')
                  projected[key] = value if key.endswith('sha256') else int(value)
              if (recovery_detail_value(by_phase['check'], 'log_sha256', '[0-9a-f]{64}') != members['restic-check.log'] or
                      recovery_detail_value(by_phase['check'], 'log_bytes', '[0-9]{1,12}') != str(check_log_size) or
                      recovery_detail_value(by_phase['final'], 'all_required_phase_receipts', 'yes') != 'yes'):
                  raise ValueError('check or final witness differs')
              issue = 'publication-stability'
              # The immutable manifest binds each accepted observation. Recheck publication
              # identities before using the assembled record; concurrent renewal is review.
              if tuple(getattr(info_before, f) for f in stat_keys) != tuple(getattr(directory.lstat(), f) for f in stat_keys):
                  raise ValueError('directory changed')
              for name, identity in identities.items():
                  if identity != tuple(getattr((directory / name).lstat(), f) for f in stat_keys):
                      raise ValueError('member changed')
              for path, expected, limit in ((base / 'current', pointer, 128), (base / 'automatic-enabled', marker_text, 4096),
                                            (directory / 'SHA256SUMS', manifest_text, 16384)):
                  if health_read_file(path, limit, root=root, uid=uid) != ('read', expected):
                      raise ValueError('publication changed')
              restored_at = dt.datetime.fromisoformat(restored['recorded_at'])
              projected.update(recorded_at=restored['recorded_at'], age_seconds=now - int(restored_at.timestamp()),
                               method='restic-dump-tar-extraction-and-tree-measurement-recheck',
                               restored_snapshot_id=recovery_detail_value(restored, 'snapshot_id', '[0-9a-f]{64}'),
                               source_content_compared=False, path_sample_is_content_digest=False,
                               disposable_absence_recorded=True, disposable_absence_checked_now=False)
              result.update(state='historical-qualification-verified', historical_qualification_verified=True,
                            qualification_run=run, historical_source_sha256=source, historical_system=closure,
                            qualification_manifest_sha256=manifest_sha, manifest_members=len(members),
                            required_phases_verified=list(required), restore=projected,
                            check={'recorded_at': by_phase['check']['recorded_at'],
                                   'recorded_pass': True, 'all_repository_packs_read_proven': False},
                            cleanup={'success_source_snapshot_absence_recorded': True,
                                     'interrupted_source_snapshot_absence_recorded': True,
                                     'disposable_restore_absence_recorded': True,
                                     'old_residue_inventory_performed': False})
              return result
          except (OSError, ValueError, TypeError, KeyError, OverflowError, RecursionError):
              result.update(state='review-required', issue=issue)
              return result


      #@MNX-PART id=99.08.mnx-office.function.recovery-evidence-self-test kind=function title="Python function recovery_evidence_self_test"
      def recovery_evidence_self_test() -> None:
          # Synthetic controller witnesses only; no real repository, credential or dataset.
          phases = ('begin', 'backup-1', 'backup-2', 'source-cleanup-success', 'failure-expected',
                    'source-cleanup-failure', 'recovery', 'check', 'restore', 'restore-accepted',
                    'restore-cleaned', 'final', 'scheduling-enabled')
          run = '20260822T123214Z-352afe152753'
          closure = '/nix/store/' + 'a' * 32 + '-nixos-system-monster-16-test'
          source = 'a' * 64
          target = '/mnt/m16-new-storage/admin/restore-tests/' + run
