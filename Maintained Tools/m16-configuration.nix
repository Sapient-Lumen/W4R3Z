      #@MNX-PART id=99.92.mnx-monsterkey.function.ignored-modifier-masks kind=function title="Python function ignored_modifier_masks"
      def ignored_modifier_masks(connection: xdisplay.Display) -> list[int]:
          rows = modifier_rows(connection)
          nuisance_keysyms = {NUM_LOCK, SCROLL_LOCK, CAPS_LOCK}
          masks = {X.LockMask}
          for index, row in enumerate(rows):
              if index == MONSTER_MODIFIER_INDEX:
                  continue
              for keycode in row:
                  if keycode == 0:
                      continue
                  if any(value in nuisance_keysyms for value in keysyms_for_keycode(connection, keycode)):
                      masks.add(MODIFIER_MASKS[index])
          return sorted(mask for mask in masks if mask != 0)


      #@MNX-PART id=99.92.mnx-monsterkey.function.mask-combinations kind=function title="Python function mask_combinations"
      def mask_combinations(masks: list[int]) -> list[int]:
          combinations = {0}
          for mask in masks:
              combinations |= {value | mask for value in list(combinations)}
          return sorted(combinations)


      #@MNX-PART id=99.92.mnx-monsterkey.function.grab-escape kind=function title="Python function grab_escape"
      def grab_escape(connection: xdisplay.Display) -> tuple[int, list[int]]:
          escape_keycode = int(connection.keysym_to_keycode(ESCAPE))
          if escape_keycode <= 0:
              raise MonsterKeyError("X11 could not resolve the Escape keycode")
          extras = mask_combinations(ignored_modifier_masks(connection))
          errors: list[str] = []

          #@MNX-PART id=99.92.mnx-monsterkey.function.grab-escape.on-error kind=function title="Python nested function on_error"
          def on_error(error: object, request: object) -> None:
              errors.append(f"{type(error).__name__}:{error}")

          root = connection.screen().root
          for extra in extras:
              root.grab_key(
                  escape_keycode,
                  MONSTER_MASK | extra,
                  False,
                  X.GrabModeAsync,
                  X.GrabModeAsync,
                  onerror=on_error,
              )
          connection.sync()
          if errors:
              for extra in extras:
                  root.ungrab_key(escape_keycode, MONSTER_MASK | extra)
              connection.sync()
              raise MonsterKeyError(f"Monster Key Escape grab failed: {'; '.join(errors[:8])}")
          return escape_keycode, extras


      #@MNX-PART id=99.92.mnx-monsterkey.function.ungrab-escape kind=function title="Python function ungrab_escape"
      def ungrab_escape(connection: xdisplay.Display, escape_keycode: int, extras: list[int]) -> None:
          root = connection.screen().root
          for extra in extras:
              root.ungrab_key(escape_keycode, MONSTER_MASK | extra)
          connection.sync()


      #@MNX-PART id=99.92.mnx-monsterkey.function.notify kind=function title="Python function notify"
      def notify(title: str, body: str, urgency: str = "normal") -> bool:
          environment = x11_environment()
          completed = subprocess.run(
              [str(NOTIFY_SEND), "--app-name=Monsternix", f"--urgency={urgency}", "--expire-time=4500", title, body],
              env=environment,
              stdin=subprocess.DEVNULL,
              stdout=subprocess.DEVNULL,
              stderr=subprocess.PIPE,
              text=True,
              timeout=10,
              check=False,
          )
          if completed.returncode != 0:
              print(f"monster_key_notification_error={completed.stderr.strip()[-1000:] or completed.returncode}", file=sys.stderr)
              return False
          return True


      #@MNX-PART id=99.92.mnx-monsterkey.function.bounded-text kind=function title="Python function bounded_text"
      def bounded_text(text: str) -> str:
          encoded = text.encode("utf-8", errors="replace")
          if len(encoded) > MAX_COMMAND_OUTPUT:
              return encoded[:MAX_COMMAND_OUTPUT].decode("utf-8", errors="replace") + "\n[truncated]"
          return text


      #@MNX-PART id=99.92.mnx-monsterkey.function.command-toggle kind=function title="Python function command_toggle"
      def command_toggle(source: str = "manual-command") -> int:
          root = ensure_runtime_root()
          lock_path = root / "toggle.lock"
          flags = os.O_RDWR | os.O_CREAT
          if hasattr(os, "O_NOFOLLOW"):
              flags |= os.O_NOFOLLOW
          descriptor = os.open(lock_path, flags, 0o600)
          try:
              os.fchmod(descriptor, 0o600)
              try:
                  fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
              except BlockingIOError:
                  print("monster_key_toggle=debounced-busy")
                  return 0
              now = time.monotonic_ns()
              stamp_path = root / "last-toggle-monotonic-ns"
              previous = 0
              if stamp_path.exists():
                  try:
                      previous = int(validated_regular(stamp_path).decode("ascii").strip())
                  except Exception:
                      previous = 0
              if previous > 0 and 0 <= now - previous < DEBOUNCE_NS:
                  print("monster_key_toggle=debounced-repeat")
                  return 0
              atomic_write(stamp_path, f"{now}\n".encode("ascii"))
              control_environment = x11_environment()
              control_environment["PRESSLOG_CONTROL_CONTEXT"] = "monster-key-read-only-home"
              completed = subprocess.run(
                  [str(PRESSLOG), "toggle"],
                  env=control_environment,
                  stdin=subprocess.DEVNULL,
                  stdout=subprocess.PIPE,
                  stderr=subprocess.PIPE,
                  text=True,
                  timeout=20,
                  check=False,
              )
              stdout = bounded_text(completed.stdout)
              stderr = bounded_text(completed.stderr)
              if stdout:
                  print(stdout, end="" if stdout.endswith("\n") else "\n")
              if completed.returncode != 0:
                  if stderr:
                      print(stderr, end="" if stderr.endswith("\n") else "\n", file=sys.stderr)
                  detail = classify_toggle_failure(stdout, stderr, completed.returncode)
                  if detail == "secret-prompt-active":
                      shown = notify(
                          "Presslog remains paused",
                          "A Monsternix password prompt owns the privacy lock. Resume is blocked until it closes; press MONSTER KEY + ESC again afterward.",
                          "normal",
                      )
                      write_action_receipt(
                          source=source,
                          outcome="review",
                          action="none",
                          paused=True,
                          presslog_rc=completed.returncode,
                          notification="shown" if shown else "failed",
                          detail=detail,
                      )
                      print(f"monster_key_notification={'shown' if shown else 'failed'}")
                      print("MNX_MONSTER_KEY_TOGGLE=REVIEW_SECRET_PROMPT_ACTIVE")
                      return 75
                  if detail == "not-recording":
                      shown = notify(
                          "Presslog is not recording",
                          "MONSTER KEY + ESC: run presslog arm before using the pause toggle.",
                          "normal",
                      )
                      write_action_receipt(
                          source=source,
                          outcome="review",
                          action="none",
                          paused=None,
                          presslog_rc=completed.returncode,
                          notification="shown" if shown else "failed",
                          detail=detail,
                      )
                      print(f"monster_key_notification={'shown' if shown else 'failed'}")
                      print("MNX_MONSTER_KEY_TOGGLE=REVIEW_NOT_RECORDING")
                      return 69
                  if detail == "control-layout-transition":
                      shown = notify(
                          "Presslog state unchanged",
                          "MONSTER KEY + ESC: the read-only control layout was briefly transitioning. No recorder signal was sent; press again after the transition settles.",
                          "normal",
                      )
                      write_action_receipt(
                          source=source,
                          outcome="review",
                          action="none",
                          paused=None,
                          presslog_rc=completed.returncode,
                          notification="shown" if shown else "failed",
                          detail=detail,
                      )
                      print(f"monster_key_notification={'shown' if shown else 'failed'}")
                      print("MNX_MONSTER_KEY_TOGGLE=REVIEW_CONTROL_LAYOUT_TRANSITION")
                      return 75
                  shown = notify(
                      "Presslog toggle failed",
                      f"MONSTER KEY + ESC: {detail}. Run monsterkey status for bounded action truth.",
                      "critical",
                  )
                  write_action_receipt(
                      source=source,
                      outcome="fail",
                      action="none",
                      paused=None,
                      presslog_rc=completed.returncode,
                      notification="shown" if shown else "failed",
                      detail=detail,
                  )
                  print(f"monster_key_failure_class={detail}")
                  print(f"monster_key_notification={'shown' if shown else 'failed'}")
                  print("MNX_MONSTER_KEY_TOGGLE=FAIL")
                  return completed.returncode or 1
              fields: dict[str, str] = {}
              for line in stdout.splitlines():
                  if "=" in line:
                      key, value = line.split("=", 1)
                      fields[key] = value
              if fields.get("PRESSLOG_TOGGLE") != "PASS" or fields.get("paused") not in {"true", "false"}:
                  shown = notify(
                      "Presslog toggle ambiguous",
                      "MONSTER KEY + ESC returned without a confirmed paused/recording state. Run monsterkey status.",
                      "critical",
                  )
                  write_action_receipt(
                      source=source,
                      outcome="fail",
                      action="none",
                      paused=None,
                      presslog_rc=70,
                      notification="shown" if shown else "failed",
                      detail="presslog-toggle-ambiguous",
                  )
                  print("MNX_MONSTER_KEY_TOGGLE=FAIL_AMBIGUOUS")
                  return 70
              paused = fields["paused"] == "true"
              if paused:
                  title = "Presslog paused"
                  body = "MONSTER KEY + ESC: recording OFF. New keystrokes are being discarded."
                  action = "pause"
              else:
                  title = "Presslog recording"
                  body = "MONSTER KEY + ESC: recording ON. Encrypted capture resumed."
                  action = "resume"
              shown = notify(title, body, "normal")
              write_action_receipt(
                  source=source,
                  outcome="pass" if shown else "review",
                  action=action,
                  paused=paused,
                  presslog_rc=0,
                  notification="shown" if shown else "failed",
                  detail="confirmed-transition" if shown else "notification-failed-after-confirmed-transition",
              )
              print(f"monster_key_action={action}")
              print(f"monster_key_notification={'shown' if shown else 'failed'}")
              if not shown:
                  print("MNX_MONSTER_KEY_TOGGLE=REVIEW_NOTIFICATION_FAILED")
                  return 1
              print("MNX_MONSTER_KEY_TOGGLE=PASS")
              return 0
          finally:
              os.close(descriptor)


      #@MNX-PART id=99.92.mnx-monsterkey.function.utc-now kind=function title="Python function utc_now"
      def utc_now() -> str:
          return dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")

      #@MNX-PART id=99.92.mnx-monsterkey.function.boot-id kind=function title="Python function boot_id"
      def boot_id() -> str:
          try:
              value = BOOT_ID_PATH.read_text(encoding="ascii").strip()
          except OSError as error:
              raise MonsterKeyError(f"boot id is unavailable: {error}") from error
          if not re.fullmatch(r"[0-9a-f-]{36}", value):
