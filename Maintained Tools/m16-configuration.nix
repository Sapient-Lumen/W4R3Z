#@MNX-DEF path=boot.loader.systemd-boot.enable section=20.20 role=policy ordinal=007
  boot.loader.systemd-boot.enable = true; # Use systemd-boot as the bootloader.
#@MNX-DEF path=boot.loader.efi.canTouchEfiVariables section=20.20 role=policy ordinal=008
  boot.loader.efi.canTouchEfiVariables = true; # Allow bootloader to modify EFI variables.
#@MNX-DEF path=boot.loader.timeout section=20.20 role=policy ordinal=009
  boot.loader.timeout = 2; # Set bootloader timeout to 2 seconds.

#@MNX-DEF path=services.fwupd.enable section=20.20 role=policy ordinal=010
  services.fwupd.enable = false; # Unused; keep firmware updates operator-explicit rather than daemon-backed.

