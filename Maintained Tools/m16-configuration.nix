      #@MNX-PART id=99.05.mnx-eject.class.eject-error kind=class title="Python class EjectError"
      class EjectError(RuntimeError):
          pass
      
      
      #@MNX-PART id=99.05.mnx-eject.function.canonical-json kind=function title="Python function canonical_json"
      def canonical_json(data: object) -> str:
          return json.dumps(data, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n"
      
      
      #@MNX-PART id=99.05.mnx-eject.function.stable-source-read kind=function title="Python function stable_source_read"
      def stable_source_read(path: Path) -> dict:
          requested = path.expanduser()
          try:
              requested_lstat = requested.lstat()
              resolved = requested.resolve(strict=True)
              before = resolved.stat()
          except OSError as exc:
              raise EjectError(f"source is unavailable: {path}: {exc}") from exc
          if not stat.S_ISREG(before.st_mode):
              raise EjectError(f"source is not a regular file: {resolved}")
          if before.st_size > MAX_SOURCE_BYTES:
              raise EjectError(f"source exceeds {MAX_SOURCE_BYTES} bytes: {before.st_size}")
          try:
              with resolved.open("rb") as stream:
                  raw = stream.read(MAX_SOURCE_BYTES + 1)
              after = resolved.stat()
          except OSError as exc:
              raise EjectError(f"source could not be read: {resolved}: {exc}") from exc
          if len(raw) > MAX_SOURCE_BYTES:
              raise EjectError(f"source exceeds {MAX_SOURCE_BYTES} bytes while reading: {resolved}")
          before_id = (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
          after_id = (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
          if before_id != after_id or len(raw) != after.st_size:
              raise EjectError(f"source changed while it was being read: {resolved}")
          try:
              text = raw.decode("utf-8", errors="strict")
          except UnicodeDecodeError as exc:
              raise EjectError(f"source is not strict UTF-8: {resolved}: {exc}") from exc
          return {
              "requested": str(requested),
              "resolved": str(resolved),
              "is_symlink": stat.S_ISLNK(requested_lstat.st_mode),
              "raw": raw,
              "text": text,
              "sha256": hashlib.sha256(raw).hexdigest(),
              "bytes": len(raw),
              "lines": raw.count(b"\n") + (1 if raw and not raw.endswith(b"\n") else 0),
          }
      
      
      #@MNX-PART id=99.05.mnx-eject.function.validate-marker-line kind=function title="Python function validate_marker_line"
      def validate_marker_line(content: str) -> str | None:
          if SHEBANG_RE.fullmatch(content):
              return "shebang"
          if BEGIN_RE.fullmatch(content):
              return "begin"
          if END_RE.fullmatch(content):
              return "end"
          if "# MNX-EJECT-LINE owner=" in content and re.search(rf"# MNX-EJECT-LINE owner={OWNER}$", content):
              return "line"
          if RESERVED_RE.search(content):
              raise EjectError(f"malformed reserved ejection marker: {content}")
          return None
      
      
      #@MNX-PART id=99.05.mnx-eject.function.render-ejected kind=function title="Python function render_ejected"
      def render_ejected(raw: bytes) -> tuple[bytes, dict]:
          try:
              text = raw.decode("utf-8", errors="strict")
          except UnicodeDecodeError as exc:
              raise EjectError(f"source is not strict UTF-8: {exc}") from exc
          lines = text.splitlines(keepends=True)
          rendered: list[str] = []
          depth = 0
          counts = {"shebang": 0, "begin": 0, "end": 0, "line": 0}
          index = 0
          if lines and lines[0].startswith("#!") and "#@MNX-BASH" in lines[0]:
              if len(lines) < 2 or validate_marker_line(lines[1].rstrip("\r\n")) != "shebang":
                  raise EjectError("polyglot shebang lacks the immediately following ownership marker")
              counts["shebang"] = 1
              index = 2
          for line_number, line in enumerate(lines[index:], start=index + 1):
              content = line.rstrip("\r\n")
              kind = validate_marker_line(content)
              if kind == "shebang":
                  raise EjectError(f"shebang ownership marker is misplaced at line {line_number}")
              if kind == "begin":
                  depth += 1
                  counts["begin"] += 1
                  continue
              if kind == "end":
                  if depth == 0:
                      raise EjectError(f"orphan ejection end marker at line {line_number}")
                  depth -= 1
                  counts["end"] += 1
                  continue
              if kind == "line":
                  counts["line"] += 1
                  continue
              if depth == 0:
                  rendered.append(line)
          if depth != 0:
              raise EjectError(f"unclosed ejection ownership region depth={depth}")
          output = "".join(rendered).encode("utf-8")
          counts["balanced"] = counts["begin"] == counts["end"]
          counts["owned_region_count"] = counts["begin"]
          return output, counts
      
      
      #@MNX-PART id=99.05.mnx-eject.function.parse-definitions kind=function title="Python function parse_definitions"
      def parse_definitions(text: str) -> list[dict]:
          lines = text.splitlines(keepends=True)
          markers: list[tuple[int, re.Match[str]]] = []
          for index, line in enumerate(lines):
              match = DEF_RE.fullmatch(line.rstrip("\r\n"))
              if match:
                  markers.append((index, match))
          definitions: list[dict] = []
          for offset, (start, match) in enumerate(markers):
              end = markers[offset + 1][0] if offset + 1 < len(markers) else len(lines)
              body = "".join(lines[start:end])
              definitions.append({
                  "path": match.group("path"),
                  "section": match.group("section"),
                  "role": match.group("role"),
                  "ordinal": int(match.group("ordinal")),
                  "start_line": start + 1,
                  "end_line": end,
                  "body": body,
                  "body_sha256": hashlib.sha256(body.encode("utf-8")).hexdigest(),
              })
          ordinals = [item["ordinal"] for item in definitions]
          if ordinals != list(range(1, len(definitions) + 1)):
              raise EjectError("truthful DEF ordinals are absent or noncontiguous")
          return definitions
      
      
      #@MNX-PART id=99.05.mnx-eject.function.classify-definition kind=function title="Python function classify_definition"
      def classify_definition(definition: dict) -> tuple[str, str]:
          path = definition["path"]
          body = definition["body"]
          removal_prefixes = (
              'environment.etc."monsternix/bin/',
              "system.activationScripts.mnx-",
              "systemd.services.mnx-",
              "systemd.timers.mnx-",
              "systemd.paths.mnx-",
              "systemd.sockets.mnx-",
              "systemd.user.services.mnx-",
              "systemd.user.timers.mnx-",
          )
          removal_exact = {
              'environment.etc."monsternix/nix-language.json".text',
              'environment.etc."monsternix/semantic-kernel.json".text',
              "systemd.services.monsternix-config-copy",
              "systemd.paths.monsternix-config-copy",
              "systemd.timers.monsternix-config-copy",
          }
          if path.startswith(removal_prefixes) or path in removal_exact:
              return "remove-candidate", "definition is wholly source-owned control-plane machinery"
          transform_tokens = (
              "/etc/monsternix",
              "/var/lib/monsternix",
              "MNX_",
              "mnx-",
              "monsternix_",
              "monsternix-",
              "Monsternix",
          )
          hits = sorted({token for token in transform_tokens if token in body})
          if hits:
              return "transform-required", "mixed machine/control-plane definition contains " + ",".join(hits)
          return "keep-candidate", "definition contains no lexical control-plane dependency"
      
      
      #@MNX-PART id=99.05.mnx-eject.function.clean-body kind=function title="Python function clean_body"
      def clean_body(body: str) -> str:
          output: list[str] = []
          for line in body.splitlines(keepends=True):
              stripped = line.lstrip()
              if SOURCE_MARKER_RE.match(line):
                  continue
              if stripped.startswith("#"):
                  continue
              if "#" in line:
                  prefix, comment = line.split("#", 1)
                  if FORBIDDEN_LANGUAGE_RE.search(comment):
                      line = prefix.rstrip() + "\n"
              output.append(line)
          text = "".join(output)
          text = re.sub(r"\n{3,}", "\n\n", text)
          return text.strip("\n") + "\n"
      
      
      #@MNX-PART id=99.05.mnx-eject.function.disable-assignment kind=function title="Python function disable_assignment"
      def disable_assignment(path: str) -> str:
          return f"  {path}.enable = false;\n"
      
      
      #@MNX-PART id=99.05.mnx-eject.function.strip-service-hooks kind=function title="Python function strip_service_hooks"
      def strip_service_hooks(body: str) -> str:
          lines: list[str] = []
          for line in clean_body(body).splitlines(keepends=True):
              if "mnx-job-failure-notify@%n.service" in line:
                  continue
              if "/etc/monsternix/bin/mnx-job-metric" in line:
                  continue
              lines.append(line)
          output = "".join(lines)
          # Removing the metric line from the multiline finish function leaves the
          # cleanup and exact exit propagation intact. One-line metric traps vanish.
          output = re.sub(r"^[ \t]*JOB_START=.*?trap .*?\n", "", output, flags=re.MULTILINE)
          return output
      
      
      #@MNX-PART id=99.05.mnx-eject.function.filter-system-packages kind=function title="Python function filter_system_packages"
      def filter_system_packages(body: str) -> str:
          text = body
          start = text.find('(writeShellScriptBin "mnx"')
          end_marker = "      # dev"
          end = text.find(end_marker, start)
          if start < 0 or end < 0:
              raise EjectError("systemPackages wrapper range is absent")
          text = text[:start] + text[end:]
          return clean_body(text)
      
      
      #@MNX-PART id=99.05.mnx-eject.function.filter-assertions kind=function title="Python function filter_assertions"
      def filter_assertions(body: str) -> str:
          text = body
          blocks = re.findall(r"(?ms)^    \{\n.*?^    \}\n", text)
          if not blocks:
              raise EjectError("assertion blocks are absent")
          kept: list[str] = []
          for block in blocks:
              block = block.replace(
                  "Monsternix notification/session tooling requires h0p3 to remain UID 1000.",
                  "Session tooling requires h0p3 to remain UID 1000.",
              )
              block = block.replace(
                  "Raw system.autoUpgrade switching is forbidden because it bypasses mnx test, exact-closure promotion, behavior review, rollback evidence, and office acceptance.",
                  "Raw system.autoUpgrade switching remains disabled by operator policy.",
              )
              if FORBIDDEN_LANGUAGE_RE.search(block):
                  continue
              kept.append(block)
          if not kept:
              raise EjectError("all machine assertions were removed")
          return "  assertions = [\n" + "".join(kept) + "  ];\n"
      
      
      #@MNX-PART id=99.05.mnx-eject.function.transform-definition kind=function title="Python function transform_definition"
      def transform_definition(definition: dict, contract: dict) -> str:
          path = definition["path"]
          body = definition["body"]
          strategy = contract["strategy"]
          if strategy == "omit-definition":
              return ""
          if strategy in {"disable-service", "disable-timer"}:
              return disable_assignment(path)
          if strategy == "clean-keep":
              return clean_body(body)
          if strategy == "rewrite-catalog":
              output = clean_body(body)
              output = output.replace("Monsternix notification", "System notification")
              output = output.replace("Monsternix storage health snapshot", "Storage health snapshot")
              return output
          if strategy == "rename-rescue-modes":
              output = clean_body(body)
              output = output.replace(
                  'environment.etc."monsternix/rescue-modes.txt".text',
                  'environment.etc."rescue-modes.txt".text',
              )
              return output.replace("ordinary Monsternix workstation profile", "ordinary workstation profile")
          if strategy == "rename-memory-slice":
              output = clean_body(body)
              output = output.replace('systemd.user.units."mnx-memory-hogs.slice".text', 'systemd.user.units."memory-hogs.slice".text')
              return output.replace("Opt-in Monsternix memory-pressure scopes", "Opt-in memory-pressure scopes")
          if strategy == "filter-tmpfiles":
              output = "".join(line for line in clean_body(body).splitlines(keepends=True) if "/var/lib/monsternix" not in line and "/run/monsternix" not in line)
              return output
          if strategy == "strip-service-hooks":
              return strip_service_hooks(body)
          if strategy == "filter-system-packages":
              return filter_system_packages(body)
          if strategy == "strip-rescue-overrides":
              return "".join(
                  line for line in clean_body(body).splitlines(keepends=True)
                  if not re.search(r"(?i)(?:mnx|monsternix)", line)
              )
          if strategy == "filter-assertions":
              return filter_assertions(body)
          raise EjectError(f"unknown transformation strategy for {path}: {strategy}")
      
      
      #@MNX-PART id=99.05.mnx-eject.function.parse-nix-bytes kind=function title="Python function parse_nix_bytes"
      def parse_nix_bytes(raw: bytes) -> dict:
          with tempfile.TemporaryDirectory(prefix="mnx-eject-preview.") as directory:
              path = Path(directory) / "configuration.nix"
              path.write_bytes(raw)
              environment = dict(os.environ)
              environment.update({"HOME": directory, "NIX_REMOTE": "dummy://"})
              completed = subprocess.run(
                  [str(NIX_INSTANTIATE), "--store", "dummy://", "--parse", str(path)],
                  stdout=subprocess.DEVNULL,
                  stderr=subprocess.PIPE,
                  text=True,
                  env=environment,
                  timeout=60,
                  check=False,
              )
          return {
              "status": "PASS" if completed.returncode == 0 else "FAIL",
              "rc": completed.returncode,
              "stderr_tail": completed.stderr[-4000:],
          }
      
      
      #@MNX-PART id=99.05.mnx-eject.function.build-preview kind=function title="Python function build_preview"
      def build_preview(source: dict, definitions: list[dict]) -> dict:
          classes: dict[str, list[dict]] = {
              "keep-candidate": [],
              "remove-candidate": [],
              "transform-required": [],
              "unclassified": [],
          }
          transformed: list[dict] = []
          preview_parts = ["{ config, pkgs, lib, ... }:\n{\n"]
          observed_transform_paths: set[str] = set()
          for definition in definitions:
              classification, reason = classify_definition(definition)
              classes[classification].append({
                  "path": definition["path"],
                  "section": definition["section"],
                  "role": definition["role"],
                  "ordinal": definition["ordinal"],
                  "start_line": definition["start_line"],
                  "end_line": definition["end_line"],
                  "reason": reason,
              })
              if classification == "remove-candidate":
                  continue
              if classification == "keep-candidate":
                  preview_parts.append(clean_body(definition["body"]))
                  continue
              if classification != "transform-required":
                  raise EjectError(f"unclassified definition: {definition['path']}")
              contract = TRANSFORM_CONTRACTS.get(definition["path"])
              if contract is None:
                  raise EjectError(f"transformation contract is missing: {definition['path']}")
              observed_transform_paths.add(definition["path"])
              if definition["body_sha256"] != contract["body_sha256"]:
                  raise EjectError(
                      f"transformation contract body hash differs for {definition['path']}: "
                      f"expected={contract['body_sha256']} observed={definition['body_sha256']}"
                  )
              output = transform_definition(definition, contract)
              if FORBIDDEN_LANGUAGE_RE.search(output):
                  raise EjectError(f"transformed definition retains control-plane language: {definition['path']}")
              preview_parts.append(output)
              transformed.append({
                  "path": definition["path"],
                  "id": contract["id"],
                  "body_sha256": contract["body_sha256"],
                  "strategy": contract["strategy"],
                  "intent": contract["intent"],
                  "behavior_gap": contract["behavior_gap"],
                  "output_sha256": hashlib.sha256(output.encode("utf-8")).hexdigest(),
                  "output_bytes": len(output.encode("utf-8")),
              })
          contract_paths = set(TRANSFORM_CONTRACTS)
          if observed_transform_paths != contract_paths:
              missing = sorted(observed_transform_paths - contract_paths)
              stale = sorted(contract_paths - observed_transform_paths)
              raise EjectError(f"transformation contract coverage differs: missing={missing} stale={stale}")
          preview_parts.append("}\n")
          preview_text = "\n".join(part.rstrip("\n") for part in preview_parts) + "\n"
          residual_rewrites: list[dict] = []
          for contract in RESIDUAL_REWRITE_CONTRACTS:
              observed = preview_text.count(contract["old"])
              if observed != contract["expected_count"]:
                  raise EjectError(
                      f"residual rewrite count differs for {contract['id']}: "
                      f"expected={contract['expected_count']} observed={observed} token={contract['old']}"
                  )
              preview_text = preview_text.replace(contract["old"], contract["new"])
              residual_rewrites.append(dict(contract))
          raw = preview_text.encode("utf-8")
          residual = sorted(set(match.group(0).casefold() for match in FORBIDDEN_LANGUAGE_RE.finditer(raw.decode("utf-8"))))
          if residual:
              raise EjectError("transformed preview retains control-plane language: " + ",".join(residual))
          parse = parse_nix_bytes(raw)
          if parse["status"] != "PASS":
              raise EjectError("transformed preview Nix parse failed: " + parse["stderr_tail"])
          strategy_counts = Counter(item["strategy"] for item in transformed)
          behavior_gap_count = sum(1 for item in transformed if item["behavior_gap"])
          return {
              "raw": raw,
              "sha256": hashlib.sha256(raw).hexdigest(),
              "bytes": len(raw),
              "lines": raw.count(b"\n"),
              "nix_parse": parse,
              "residual_language_tokens": residual,
              "classes": classes,
              "transforms": transformed,
              "contract_count": len(TRANSFORM_CONTRACTS),
              "contract_covered_count": len(observed_transform_paths),
              "strategy_counts": dict(sorted(strategy_counts.items())),
              "behavior_gap_count": behavior_gap_count,
              "residual_rewrites": residual_rewrites,
          }
      
      
      #@MNX-PART id=99.05.mnx-eject.function.plan-record kind=function title="Python function plan_record"
      def plan_record(path: Path) -> dict:
          source = stable_source_read(path)
          rendered, markers = render_ejected(source["raw"])
          definitions = parse_definitions(source["text"])
          preview = build_preview(source, definitions)
          blockers = ["behavior-equivalence-witnesses-remain", "publication-surface-deliberately-disabled"]
          if preview["behavior_gap_count"]:
              blockers.insert(0, "disabled-machine-functions-require-reviewed-replacements")
          return {
              "schema": "mnx.eject.plan.v2",
              "ejection_schema": SCHEMA,
              "authority": "advisory-transformation-proof-not-publication",
              "publication_enabled": False,
              "publication_ready": False,
              "mutation": "none",
              "network_used": False,
              "source_execution": False,
              "real_source_nix_evaluation": False,
              "preview_nix_evaluation": False,
              "source": {key: source[key] for key in ("requested", "resolved", "is_symlink", "sha256", "bytes", "lines")},
              "ownership": markers,
              "ownership_rendered": {"sha256": hashlib.sha256(rendered).hexdigest(), "bytes": len(rendered)},
              "definitions": {
                  "total": len(definitions),
                  "counts": {key: len(value) for key, value in preview["classes"].items()},
                  "classes": preview["classes"],
              },
              "transformation_contracts": {
                  "total": preview["contract_count"],
                  "covered": preview["contract_covered_count"],
                  "body_hashes_exact": True,
                  "strategy_counts": preview["strategy_counts"],
                  "behavior_gap_count": preview["behavior_gap_count"],
                  "residual_rewrite_count": len(preview["residual_rewrites"]),
                  "residual_rewrites": preview["residual_rewrites"],
                  "items": preview["transforms"],
              },
              "preview": {
                  "sha256": preview["sha256"],
                  "bytes": preview["bytes"],
                  "lines": preview["lines"],
                  "nix_parse": preview["nix_parse"]["status"],
                  "residual_language_tokens": preview["residual_language_tokens"],
                  "persistent_output_written": False,
              },
              "blockers": blockers,
              "next_action": "review-preview-gaps-then-implement-behavior-witnesses-before-any-publication",
          }
      
      
      #@MNX-PART id=99.05.mnx-eject.function.render-plan-text kind=function title="Python function render_plan_text"
      def render_plan_text(record: dict, full: bool) -> str:
          source = record["source"]
          ownership = record["ownership"]
          counts = record["definitions"]["counts"]
          contracts = record["transformation_contracts"]
          preview = record["preview"]
          lines = [
              "################################################################################",
              "# MNX EJECT PLAN — EXACT CONTRACTS AND NONPUBLISHING PLAIN-NIXOS PREVIEW",
              "################################################################################",
              f"ejection_schema={record['ejection_schema']}",
              f"authority={record['authority']}",
              f"source={source['resolved']}",
              f"source_sha256={source['sha256']}",
              f"source_lines={source['lines']}",
              f"source_bytes={source['bytes']}",
              f"source_is_symlink={'yes' if source['is_symlink'] else 'no'}",
              f"ownership_shebang_marker_count={ownership['shebang']}",
              f"ownership_region_count={ownership['owned_region_count']}",
              f"ownership_line_marker_count={ownership['line']}",
              f"definition_count={record['definitions']['total']}",
              f"keep_candidate_count={counts['keep-candidate']}",
              f"remove_candidate_count={counts['remove-candidate']}",
              f"transform_required_count={counts['transform-required']}",
              f"unclassified_count={counts['unclassified']}",
              f"transformation_contract_count={contracts['total']}",
              f"transformation_contract_covered_count={contracts['covered']}",
              f"transformation_body_hashes_exact={'yes' if contracts['body_hashes_exact'] else 'no'}",
              f"transformation_behavior_gap_count={contracts['behavior_gap_count']}",
              f"residual_rewrite_contract_count={contracts['residual_rewrite_count']}",
              f"preview_sha256={preview['sha256']}",
              f"preview_lines={preview['lines']}",
              f"preview_bytes={preview['bytes']}",
              f"preview_nix_parse={preview['nix_parse']}",
              "preview_residual_language_tokens=" + (",".join(preview["residual_language_tokens"]) or "none"),
              "preview_persistent_output_written=no",
              f"publication_enabled={'yes' if record['publication_enabled'] else 'no'}",
              f"publication_ready={'yes' if record['publication_ready'] else 'no'}",
              "mutation=none",
              "network_used=no",
              "source_execution=no",
              "real_source_nix_evaluation=no",
              "",
              "BLOCKERS",
          ]
          lines.extend(f"blocker={item}" for item in record["blockers"])
          lines.extend(("", "TRANSFORMATION_STRATEGIES"))
          for strategy, count in contracts["strategy_counts"].items():
              lines.append(f"strategy={strategy} count={count}")
          limit = None if full else 30
          for classification in ("remove-candidate", "transform-required", "unclassified"):
              items = record["definitions"]["classes"][classification]
              lines.extend(("", classification.upper().replace("-", "_")))
              shown = items if limit is None else items[:limit]
              for item in shown:
                  lines.append(
                      f"path={item['path']} section={item['section']} role={item['role']} "
                      f"lines={item['start_line']}-{item['end_line']} reason={item['reason']}"
                  )
              if limit is not None and len(items) > limit:
                  lines.append(f"omitted={len(items) - limit} use=--full")
              if not items:
                  lines.append("none")
          lines.extend(("", f"next_action={record['next_action']}", "MNX_EJECT_PLAN=PASS"))
          return "\n".join(lines) + "\n"
      
      
      #@MNX-PART id=99.05.mnx-eject.function.render-transforms-text kind=function title="Python function render_transforms_text"
      def render_transforms_text(record: dict, full: bool) -> str:
          contracts = record["transformation_contracts"]
          lines = [
              "################################################################################",
              "# MNX EJECT TRANSFORMATIONS — EXACT BODY-BOUND CONTRACTS",
              "################################################################################",
              f"ejection_schema={record['ejection_schema']}",
              f"source_sha256={record['source']['sha256']}",
              f"contract_count={contracts['total']}",
              f"covered_count={contracts['covered']}",
              f"body_hashes_exact={'yes' if contracts['body_hashes_exact'] else 'no'}",
              f"behavior_gap_count={contracts['behavior_gap_count']}",
              f"residual_rewrite_contract_count={contracts['residual_rewrite_count']}",
              "publication_enabled=no",
              "mutation=none",
              "network_used=no",
          ]
          items = contracts["items"]
          shown = items if full else items[:30]
          for item in shown:
              lines.append(
                  f"id={item['id']} path={item['path']} strategy={item['strategy']} "
                  f"behavior_gap={'yes' if item['behavior_gap'] else 'no'} body_sha256={item['body_sha256']} "
                  f"output_sha256={item['output_sha256']} intent={item['intent']}"
              )
          if not full and len(items) > len(shown):
              lines.append(f"omitted={len(items)-len(shown)} use=--full")
          lines.append("MNX_EJECT_TRANSFORM_CONTRACTS=PASS")
          return "\n".join(lines) + "\n"
      
      
