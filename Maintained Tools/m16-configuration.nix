      #@MNX-PART id=99.60.mnx-refactor.planner.function.cloudtainer-self-test kind=function title="Python function cloudtainer_self_test"
      def cloudtainer_self_test(root: Path) -> None:
          policy = json.loads(canonical_json(cloudtainer_policy_record()))
          candidate_policy = policy['candidate_workspace']
          require(policy['schema'] == 'mnx.cloudtainer.policy.v6', 'cloudtainer policy schema differs')
          require(policy['cloudtainer_schema'] == 6, 'cloudtainer schema differs')
          require(candidate_policy['schema'] == 'mnx.cloudtainer.candidate-policy.v2', 'candidate policy schema differs')
          require(candidate_policy['workspace']['live_source_write'] is False, 'candidate policy permits live-source writes')
          require(candidate_policy['workspace']['static_manifest_verified_on_load'] is True, 'workspace manifest is not load-gated')
          require(candidate_policy['review']['host_validation_required'] is True, 'review does not require host validation')
          require(candidate_policy['proposal']['host_validation_required'] is True, 'proposal does not require host validation')
          require(policy['python']['assertions_are_acceptance_witnesses'] is False, 'policy permits assertion-based proof')
          require(policy['network_api_or_tool_invoked'] is False and policy['ambient_network_sandbox_proved'] is False, 'network claim is overstated')
          require(policy['wake']['bare_entrypoint'] is True and policy['wake']['packet_closed_tree_verified_before_output'] is True, 'wake policy does not verify before advice')
          require(policy['wake']['one_screen_max_lines'] == 24 and policy['wake']['operator_commands'] == ['mnx test','mnx switch'], 'wake policy command or line contract differs')
          require(policy['reconstruction']['current_source_portable'] is False and policy['reconstruction']['migration_permission'] is False, 'reconstruction policy overclaims portability or authority')
          require(policy['backup_soak']['read_only'] is True and policy['backup_soak']['retirement_authorized'] is False and policy['backup_soak']['disposition'] == 'preserve-both-histories-restic-primary', 'backup soak policy permits retirement or mutation')
          print('MNX_CLOUDTAINER_POLICY_CONTRACT_SELF_TEST=PASS')
          portable_lines = CLOUDTAINER_PORTABLE_SOURCE.splitlines()
          require(not any(re.match(r'^\s*assert\b', line) for line in portable_lines), 'portable helper still contains executable assert statements')
          portable_targets: list[tuple[int, str, str]] = []
          for index, line in enumerate(portable_lines):
              stripped = line.strip()
              if re.match(r'^class\s+[A-Za-z_][A-Za-z0-9_]*(?:\([^)]*\))?:$', stripped):
                  portable_targets.append((index, 'class', stripped))
              elif re.match(r'^(?:async\s+)?def\s+[A-Za-z_][A-Za-z0-9_]*\([^)]*\)(?:\s*->\s*[^:]+)?:$', stripped):
                  portable_targets.append((index, 'function', stripped))
          require(bool(portable_targets), 'portable cloudtainer helper has no class/function declaration to anchor-test')
          seen_ids: set[str] = set()
          for index, kind, declaration in portable_targets:
              require(index > 0, 'portable declaration occurs before any possible PART anchor')
              marker = portable_lines[index - 1].strip()
              match = re.fullmatch(r'#@MNX-PART id=([a-zA-Z0-9_.-]+) kind=' + kind + r' title="[^"]+"', marker)
              require(match is not None, f'portable cloudtainer {kind} lacks matching PART anchor: {declaration}')
              part_id = match.group(1)
              require(part_id not in seen_ids, f'duplicate portable cloudtainer PART id: {part_id}')
              seen_ids.add(part_id)
          print('MNX_CLOUDTAINER_STRUCTURE_ANCHOR_SELF_TEST=PASS')
          fixture = root / 'configuration.nix'
          fixture.write_text(
              '# MNX_DOCUMENT_SCHEMA=53\n'
