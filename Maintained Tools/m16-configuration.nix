      #@MNX-PART id=99.05.mnx-eject.function.self-test kind=function title="Python function self_test"
      def self_test() -> None:
          fixture = (
              "#!/usr/bin/env -S bash -c 'echo #@MNX-BASH'\n"
              "# MNX-EJECT-SHEBANG owner=monsternix.core\n"
              "# MNX-EJECT-BEGIN owner=monsternix.core\n"
              "# owned introduction\n"
              "# MNX-EJECT-BEGIN owner=monsternix.nested\n"
              "# nested owned prose\n"
