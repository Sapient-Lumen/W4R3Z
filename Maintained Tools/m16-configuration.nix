          'manager-stop-retryable',
          'bootstrap behavior-change allowance is absent or invalid',
          'MNX_SWITCH_BOOTSTRAP_BEHAVIOR_EVIDENCE_SELF_TEST=PASS',
      ):
          if required_lane_landmark not in policy_text:
              errors.append(f"operator-priority storage lane landmark is missing: {required_lane_landmark}")
      test_program_start = policy_text.find('environment.etc."monsternix/bin/mnx-test" = {')
      test_program_end = policy_text.find('#@MNX-DEF path=environment.etc."monsternix/bin/mnx-behavior-manifest" ', test_program_start + 1) if test_program_start >= 0 else -1
      switch_program_start = policy_text.find('environment.etc."monsternix/bin/mnx-switch" = {')
      switch_program_end = policy_text.find('#@MNX-DEF path=environment.etc."monsternix/bin/mnx-test" ', switch_program_start + 1) if switch_program_start >= 0 else -1
      if test_program_start < 0 or test_program_end < 0 or switch_program_start < 0 or switch_program_end < 0:
          errors.append("operator-priority test/switch definitions could not be isolated")
      else:
          test_program_block = policy_text[test_program_start:test_program_end]
          switch_program_block = policy_text[switch_program_start:switch_program_end]
          for name, block in (("test", test_program_block), ("switch", switch_program_block)):
              if name == "test":
                  exclusive_marker = '#@MNX-PART id=99.30.mnx-test.function.exclusive-maintenance-units '
                  contention_marker = '#@MNX-PART id=99.30.mnx-test.function.contention-only-units '
                  contention_end_marker = '#@MNX-PART id=99.30.mnx-test.function.acquire-operator-storage-lane '
              else:
                  exclusive_marker = '#@MNX-PART id=99.20.mnx-switch.function.heavy_units '
                  contention_marker = '#@MNX-PART id=99.20.mnx-switch.function.contention-only-units '
                  contention_end_marker = '#@MNX-PART id=99.20.mnx-switch.function.wait-for-heavy-units '
              exclusive_start = block.find(exclusive_marker)
              contention_start = block.find(contention_marker, exclusive_start + 1) if exclusive_start >= 0 else -1
              contention_end = block.find(contention_end_marker, contention_start + 1) if contention_start >= 0 else -1
              if exclusive_start < 0 or contention_start < 0 or contention_end < 0:
                  errors.append(f"{name} storage classifiers are missing or out of order")
                  continue
              exclusive_block = block[exclusive_start:contention_start]
              contention_block = block[contention_start:contention_end]
              if 'btrfs-scrub-mnt-m16\\x2dnew\\x2dstorage.service' in exclusive_block:
                  errors.append(f"{name} still treats throttled new-storage scrub as exclusive")
              if 'btrfs-scrub--.service' not in exclusive_block:
                  errors.append(f"{name} lost root-filesystem scrub exclusion")
              if 'btrfs-scrub-mnt-m16\\x2dnew\\x2dstorage.service' not in contention_block:
                  errors.append(f"{name} lost new-storage scrub contention classification")
              helper_signature = '\n      request_restartable_rsync_preemption() {\n'
              helper_start = block.find(helper_signature)
              helper_end = block.find('\n      }\n', helper_start + len(helper_signature)) if helper_start >= 0 else -1
              if helper_start < 0 or helper_end < 0:
                  errors.append(f"{name} rsync-only preemption helper is missing")
              else:
                  helper_block = block[helper_start:helper_end]
                  if helper_block.count('rsync-m16-new-to-old.service') != 1:
                      errors.append(f"{name} preemption helper does not have one literal rsync allowlist")
                  for required_helper in ('-p Restart --value', 'refused-restart-policy', 'restartable_rsync_success_receipt_identity'):
                      if required_helper not in helper_block:
                          errors.append(f"{name} preemption helper lost safety landmark: {required_helper}")
                  for forbidden in ('btrbk-main.service', 'btrbk-archive-to-new-storage.service', 'm21-btrfs-pull-backup.service', 'm16-backup-m21.service', 'm16-restic-maintenance.service', 'duperemove-home.service', 'duperemove-m16-new-storage.service', 'btrfs-scrub--.service'):
                      if forbidden in helper_block:
                          errors.append(f"{name} preemption helper illegally reaches nonpreemptible unit: {forbidden}")

      if errors:
          for error in errors:
              print(f"PARSER_FAIL: {error}")
          raise SystemExit(1)
      print(f"mnx_active_let_count={len(active_let_words)}")
      print(f"mnx_active_in_count={len(active_in_words)}")
      print(f"mnx_active_inherit_count={len(active_inherit_words)}")
      print(f"mnx_active_rec_count={len(active_rec_words)}")
      print("MNX_SOURCE_LANDMARK_LITERAL_SELF_TEST=PASS")
      print("MNX_SOURCE_PARSER=PASS")
      '';
      checkPhase = ''
        set -Eeuo pipefail
        ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
        ${pkgs.coreutils}/bin/head -n 1 "$out" | ${pkgs.gnugrep}/bin/grep -Eq '^#!.*/python'
        ${pkgs.gnugrep}/bin/grep -Fq 'RPCINFO = pathlib.Path("''${pkgs.rpcbind}/bin/rpcinfo")' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'export PATH=''${pkgs.coreutils}/bin:''${pkgs.findutils}/bin:''${pkgs.gnugrep}/bin:''${pkgs.gawk}/bin' "$out"
      '';
    };
  };

#@MNX-CHUNK id=99.80 slug=config-audit title="Source, temporary-generation, and post-switch runtime audit"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-config-audit" section=99.80 role=generated-program ordinal=275
  environment.etc."monsternix/bin/mnx-config-audit" = {
    source = pkgs.writeTextFile {
      name = "mnx-config-audit";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      export PATH=/run/wrappers/bin:${pkgs.bash}/bin:${pkgs.coreutils}/bin:${pkgs.findutils}/bin:${pkgs.gawk}/bin:${pkgs.gnugrep}/bin:${pkgs.gnused}/bin:${pkgs.util-linux}/bin:${pkgs.systemd}/bin:${pkgs.python3}/bin:${pkgs.nix}/bin:${pkgs.btrfs-progs}/bin:/run/current-system/sw/bin
      set -Eeuo pipefail
      export LC_ALL=C SYSTEMD_PAGER=cat SYSTEMD_COLORS=0 PAGER=cat

      MODE="''${1:-quick}"
      CFG="''${MNX_CONFIG:-/etc/nixos/configuration.nix}"

      #@MNX-PART id=99.80.mnx-config-audit.function.exact-output-line kind=function title="Function exact_output_line"
      exact_output_line() {
        local output="$1" expected="$2"
        ${pkgs.gnugrep}/bin/grep -Fxq -- "$expected" <<<"$output"
      }

      if [[ "$MODE" == --exact-output-line-self-test ]]; then
        MARKER_FIXTURE='MNX_AUDIT_EXACT_OUTPUT_LINE_FIRST=PASS'
        MARKER_FIXTURE+=$'\n'
        MARKER_FIXTURE+="$(${pkgs.coreutils}/bin/head -c 262144 /dev/zero | ${pkgs.coreutils}/bin/tr '\000' X)"
        MARKER_FIXTURE+=$'\nMNX_AUDIT_EXACT_OUTPUT_LINE_LAST=PASS'
        exact_output_line "$MARKER_FIXTURE" 'MNX_AUDIT_EXACT_OUTPUT_LINE_FIRST=PASS'
        exact_output_line "$MARKER_FIXTURE" 'MNX_AUDIT_EXACT_OUTPUT_LINE_LAST=PASS'
        if exact_output_line "$MARKER_FIXTURE" 'MNX_AUDIT_EXACT_OUTPUT_LINE_ABSENT=PASS'; then
          echo 'exact-output-line helper accepted an absent marker' >&2
          exit 1
        fi
        echo 'MNX_AUDIT_EXACT_OUTPUT_LINE_SELF_TEST=PASS'
        exit 0
      fi

      #@MNX-PART id=99.80.mnx-config-audit.function.restic-backup-legacy-preflight-skip-bridge kind=function title="Function restic_backup_legacy_preflight_skip_bridge"
      restic_backup_legacy_preflight_skip_bridge() {
        local file="$1"
        [[ -f "$file" && ! -L "$file" ]] || return 1
        ${pkgs.jq}/bin/jq -e '
          select(
            .schema == "mnx.restic.backup.state.v1" and
            .controller_status == "malfunction" and
            .product_status == "malfunction" and
            .phase == "storage-preflight" and
            .reason == "storage-preflight-failed" and
            .command_rc == 75 and
            .duration_seconds == 0 and
            .cleanup_snapshot_count == 0 and
            .cleanup_failure_count == 0 and
            .network_used == false and
            .source_receipt_result == "not-attempted" and
            .rebuild_bundle_status == "not-attempted" and
            .rebuild_bundle_sha256 == "none" and
            .rebuild_bundle_bytes == 0 and
            .snapshot_id == null and
            .snapshot_time == null and
            .snapshot_archive_bytes == 0 and
            .snapshot_metadata_status == "not-attempted" and
            .secrets_recorded == false and
            .m21_outbound_connection == false and
            .repository == "/mnt/m16-new-storage/admin/backups/restic/m21" and
            (.recorded_at | type) == "string" and
            (.running_system | type) == "string" and
            (.default_system | type) == "string" and
            (.evidence_bundle | type) == "string" and
            (.evidence_bundle | startswith("/var/lib/logbook/backups/m16-restic-backup-")) and
            (.evidence_manifest_sha256 | type) == "string" and
            (.evidence_manifest_sha256 | test("^[0-9a-f]{64}$")) and
            (
              .source_sha256 == "bc593f08a24658ec007fc625e86e7ed0d34153291490e4974396efbb994ec035" or
              .source_sha256 == "8e214373218710141b29f9d26d155ad2afee653657b2f9a39f2eb355ded04410" or
              .source_sha256 == "093636fec0e19e02d5d949dc0c503572f78a9de94945f78036da904cd54e0439" or
              .source_sha256 == "2c03886b40dc5ca2376c86ff85a335838b8bbdd91a2c349aa6817b1062d87eb5"
            )
          )
        ' "$file" >/dev/null 2>&1
      }

      if [[ "$MODE" == --restic-backup-compat-self-test ]]; then
        fixture_root="$(${pkgs.coreutils}/bin/mktemp -d)"
        trap '${pkgs.coreutils}/bin/rm -rf --one-file-system -- "$fixture_root"' EXIT
        valid="$fixture_root/valid.json"
        ${pkgs.jq}/bin/jq -cnS \
          --arg source_sha256 2c03886b40dc5ca2376c86ff85a335838b8bbdd91a2c349aa6817b1062d87eb5 \
          '{schema:"mnx.restic.backup.state.v1",recorded_at:"2026-09-21T12:05:08-04:00",source_sha256:$source_sha256,running_system:"/nix/store/fixture-running",default_system:"/nix/store/fixture-default",controller_status:"malfunction",product_status:"malfunction",phase:"storage-preflight",reason:"storage-preflight-failed",command_rc:75,duration_seconds:0,evidence_bundle:"/var/lib/logbook/backups/m16-restic-backup-fixture",evidence_manifest_sha256:"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",source_receipt_result:"not-attempted",cleanup_snapshot_count:0,cleanup_failure_count:0,network_used:false,rebuild_bundle_status:"not-attempted",rebuild_bundle_sha256:"none",rebuild_bundle_bytes:0,snapshot_id:null,snapshot_time:null,snapshot_archive_bytes:0,snapshot_metadata_status:"not-attempted",secrets_recorded:false,repository:"/mnt/m16-new-storage/admin/backups/restic/m21",m21_outbound_connection:false}' >"$valid"
        restic_backup_legacy_preflight_skip_bridge "$valid"
        for mutation in command-rc network-used unknown-source product-status; do
          candidate="$fixture_root/$mutation.json"
          case "$mutation" in
            command-rc) ${pkgs.jq}/bin/jq '.command_rc=74' "$valid" >"$candidate" ;;
            network-used) ${pkgs.jq}/bin/jq '.network_used=true' "$valid" >"$candidate" ;;
            unknown-source) ${pkgs.jq}/bin/jq '.source_sha256="ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"' "$valid" >"$candidate" ;;
            product-status) ${pkgs.jq}/bin/jq '.product_status="review-required"' "$valid" >"$candidate" ;;
          esac
          if restic_backup_legacy_preflight_skip_bridge "$candidate"; then
            echo "legacy Restic preflight bridge accepted adversarial mutation: $mutation" >&2
            exit 1
          fi
        done
        echo 'MNX_RESTIC_BACKUP_LEGACY_PREFLIGHT_SKIP_BRIDGE_SELF_TEST=PASS'
        exit 0
      fi

      if [[ ''${EUID:-$(id -u)} -ne 0 ]]; then
        [[ -x /run/wrappers/bin/sudo ]] || { echo '/run/wrappers/bin/sudo is unavailable' >&2; exit 126; }
        exec /run/wrappers/bin/sudo -- /run/current-system/sw/bin/env MNX_CONFIG="$CFG" "$0" "$@"
      fi

      STAMP="$(date +%Y%m%dT%H%M%S)"
      REPORT_DIR=/var/lib/logbook/support
      REPORT="$REPORT_DIR/config-audit-$STAMP.txt"
      FAIL=0
      WARN=0
      FAIL_MESSAGES=()
      WARN_MESSAGES=()

      install -d -m 2750 -o root -g logbook "$REPORT_DIR"
      exec > >(tee "$REPORT") 2>&1

      #@MNX-PART id=99.80.mnx-config-audit.function.section kind=function title="Function section"
      section() {
        printf '\n\n################################################################################\n# %s\n################################################################################\n' "$1"
      }

      #@MNX-PART id=99.80.mnx-config-audit.function.fail kind=function title="Function fail"
      fail() {
        local message="$*"
        printf 'FAIL: %s\n' "$message" >&2
        FAIL_MESSAGES+=( "$message" )
        FAIL=$((FAIL + 1))
      }

      #@MNX-PART id=99.80.mnx-config-audit.function.warn kind=function title="Function warn"
      warn() {
        local message="$*"
        printf 'WARN: %s\n' "$message" >&2
        WARN_MESSAGES+=( "$message" )
        WARN=$((WARN + 1))
      }

      #@MNX-PART id=99.80.mnx-config-audit.function.resolve-immutable-nixos-etc-projection kind=function title="Function resolve_immutable_nixos_etc_projection"
      resolve_immutable_nixos_etc_projection() {
        local live="$1" store_root="''${2:-/nix/store}" resolved link_metadata target_metadata uid gid mode size
        [[ -L "$live" ]] || return 1
        link_metadata="$(stat -c '%F:%u:%g' -- "$live" 2>/dev/null)" || return 1
        [[ "$link_metadata" == 'symbolic link:0:0' ]] || return 1
        resolved="$(readlink -f -- "$live" 2>/dev/null)" || return 1
        [[ -n "$resolved" && "$resolved" == "$store_root"/* ]] || return 1
        [[ -f "$resolved" && ! -L "$resolved" ]] || return 1
        target_metadata="$(stat -Lc '%u:%g:%a:%s' -- "$resolved" 2>/dev/null)" || return 1
        IFS=: read -r uid gid mode size <<<"$target_metadata"
        [[ "$uid" == 0 && "$gid" == 0 ]] || return 1
        [[ "$mode" =~ ^[0-7]{3,4}$ && "$size" =~ ^[0-9]+$ ]] || return 1
        (( (8#$mode & 0222) == 0 )) || return 1
        (( size > 0 && size <= 65536 )) || return 1
        printf '%s\n' "$resolved"
      }


      #@MNX-PART id=99.80.mnx-config-audit.function.source-definition-contains kind=function title="Function source_definition_contains"
      source_definition_contains() {
        local path="$1" needle="$2"
        awk -v marker="#@MNX-DEF path=$path " -v needle="$needle" '
          index($0, marker) == 1 { inside=1; next }
          inside && index($0, "#@MNX-DEF path=") == 1 { exit found ? 0 : 1 }
          inside && index($0, needle) > 0 { found=1 }
          END { exit found ? 0 : 1 }
        ' "$CFG"
      }

      #@MNX-PART id=99.80.mnx-config-audit.function.source-bash-contains kind=function title="Function source_bash_contains"
      source_bash_contains() {
        local needle="$1"
        awk -v needle="$needle" '
          $0 == "#@MNX-BASH-BEGIN" { inside=1; next }
          $0 == "#@MNX-BASH-END" { exit found ? 0 : 1 }
          inside && index($0, needle) > 0 { found=1 }
          END { exit found ? 0 : 1 }
        ' "$CFG"
      }

      #@MNX-PART id=99.80.mnx-config-audit.function.nix-language-projection-self-test kind=function title="Function nix_language_projection_self_test"
      nix_language_projection_self_test() {
        local root target live outside resolved rc=0
        root="$(mktemp -d)" || return 1
        target="$root/store/fixture-etc/etc/monsternix/nix-language.json"
        live="$root/etc/monsternix/nix-language.json"
        outside="$root/outside.json"
        install -d -m 0755 "$root/store/fixture-etc/etc/monsternix" "$root/etc/monsternix" || rc=1
        if (( rc == 0 )); then
          printf '%s\n' '{"schema":"fixture"}' >"$target" || rc=1
          chmod 0444 "$target" || rc=1
          ln -s "$root/store/fixture-etc/etc" "$root/etc/static" || rc=1
          ln -s '../static/monsternix/nix-language.json' "$live" || rc=1
        fi
        if (( rc == 0 )); then
          resolved="$(resolve_immutable_nixos_etc_projection "$live" "$root/store")" || rc=1
          [[ "$resolved" == "$target" ]] || rc=1
        fi
        if (( rc == 0 )); then
          chmod 0644 "$target" || rc=1
          if resolve_immutable_nixos_etc_projection "$live" "$root/store" >/dev/null 2>&1; then rc=1; fi
          chmod 0444 "$target" || rc=1
        fi
        if (( rc == 0 )); then
          rm -f -- "$live" || rc=1
          cp -- "$target" "$live" || rc=1
          chmod 0444 "$live" || rc=1
          if resolve_immutable_nixos_etc_projection "$live" "$root/store" >/dev/null 2>&1; then rc=1; fi
        fi
        if (( rc == 0 )); then
          rm -f -- "$live" || rc=1
          printf '%s\n' '{"schema":"outside"}' >"$outside" || rc=1
          chmod 0444 "$outside" || rc=1
          ln -s "$outside" "$live" || rc=1
          if resolve_immutable_nixos_etc_projection "$live" "$root/store" >/dev/null 2>&1; then rc=1; fi
        fi
        rm -rf --one-file-system -- "$root"
        return "$rc"
      }

      #@MNX-PART id=99.80.mnx-config-audit.function.run-office-check kind=function title="Function run_office_check"
      run_office_check() {
        local description="$1"
        local output
        local rc
        local detail
        shift

        set +e
        output="$("$@" 2>&1)"
        rc="$?"
        set -e

        if (( rc == 0 )); then
          printf '%s\n' "$output"
          return 0
        fi

        printf '%s\n' "$output" >&2
        detail="''${output//$'\n'/ }"
        detail="''${detail:0:1200}"
        fail "$description: ''${detail:-no-office-diagnostic-output}"
        return 0
      }

      #@MNX-PART id=99.80.mnx-config-audit.function.run-monsterdesk-live-acceptance kind=function title="Function run_monsterdesk_live_acceptance"
      run_monsterdesk_live_acceptance() {
        local count plan display xauthority runtime rc
        count="$(grep -Ec '^# MNX_TEST_RUNTIME_ACCEPTANCE_PLAN=' "$CFG" || true)"
        [[ "$count" == 1 ]] || { fail "runtime acceptance plan marker count differs: $count"; return 0; }
        plan="$(sed -n 's/^# MNX_TEST_RUNTIME_ACCEPTANCE_PLAN=//p' "$CFG")"
        printf 'runtime_acceptance_plan=%s\n' "$plan"
        case "$plan" in
          none)
            echo 'runtime_acceptance_state=not-requested'
            return 0
            ;;
          monsterdesk-live)
            ;;
          *)
            fail "unsupported runtime acceptance plan: $plan"
            return 0
            ;;
        esac
        if [[ "$MODE" != test ]]; then
          echo 'runtime_acceptance_state=deferred-to-mnx-test'
          return 0
        fi
        display=:0
        xauthority=/home/h0p3/.Xauthority
        runtime=/run/user/1000
        [[ -S /tmp/.X11-unix/X0 ]] || { fail 'Monsterdesk live acceptance requires the local :0 X socket'; return 0; }
        [[ -f "$xauthority" && ! -L "$xauthority" ]] || { fail 'Monsterdesk live acceptance Xauthority is absent or unsafe'; return 0; }
        local xauth_uid xauth_mode
        xauth_uid="$(stat -Lc '%u' "$xauthority" 2>/dev/null || true)"
        xauth_mode="$(stat -Lc '%a' "$xauthority" 2>/dev/null || true)"
        [[ "$xauth_uid" == 1000 && "$xauth_mode" =~ ^[0-7]{3,4}$ ]] && (( (8#$xauth_mode & 8#77) == 0 )) || {
          fail 'Monsterdesk live acceptance Xauthority ownership/mode differs'; return 0;
        }
        [[ -d "$runtime" && ! -L "$runtime" && "$(stat -Lc '%u:%a' "$runtime" 2>/dev/null || true)" == 1000:700 ]] || { fail 'Monsterdesk live acceptance runtime ownership/mode differs'; return 0; }
        [[ -x /run/current-system/sw/bin/monsterdesk ]] || { fail 'candidate-active Monsterdesk executable is unavailable'; return 0; }
        set +e
        ${pkgs.util-linux}/bin/runuser -u h0p3 -- ${pkgs.coreutils}/bin/env -i \
          HOME=/home/h0p3 USER=h0p3 LOGNAME=h0p3 SHELL=/run/current-system/sw/bin/bash \
          PATH=/run/current-system/sw/bin:/run/wrappers/bin \
          LANG=C.UTF-8 LC_ALL=C.UTF-8 DISPLAY="$display" XAUTHORITY="$xauthority" XDG_RUNTIME_DIR="$runtime" \
          MNX_MONSTERDESK_LIVE_ACCEPTANCE=1 \
          /run/current-system/sw/bin/monsterdesk live-acceptance
        rc="$?"
        set -e
        printf 'monsterdesk_live_acceptance_rc=%s\n' "$rc"
        if (( rc != 0 )); then
          fail "candidate-active Monsterdesk live acceptance failed rc=$rc"
          return 0
        fi
        echo 'MNX_MONSTERDESK_LIVE_ACCEPTANCE=PASS'
      }


      #@MNX-PART id=99.80.mnx-config-audit.function.finish_audit kind=function title="Function finish_audit"
      finish_audit() {
  
        :
      #@MNX-PART id=99.80.mnx-config-audit.phase.operator-priority-storage-lane kind=phase title="Phase: OPERATOR-PRIORITY STORAGE LANE"
        section 'OPERATOR-PRIORITY STORAGE LANE'
        grep -Fq '# MNX_OPERATOR_MAINTENANCE_LANE_SCHEMA=3' "$CFG" || fail 'operator maintenance lane schema is not v3'
        grep -Fq '# MNX_OPERATOR_PREEMPTIBLE_MAINTENANCE_POLICY=only-rsync-m16-new-to-old' "$CFG" || fail 'rsync-only operator preemption policy marker is missing'
        grep -Fq 'restartable_rsync_success_receipt_identity' /etc/monsternix/bin/mnx-test || fail 'mnx-test lost rsync success-receipt identity proof'
        grep -Fq 'restartable_rsync_success_receipt_identity' /etc/monsternix/bin/mnx-switch || fail 'mnx-switch lost rsync success-receipt identity proof'
        grep -Fq 'request_restartable_rsync_preemption' /etc/monsternix/bin/mnx-test || fail 'mnx-test lost rsync-only preemption helper'
        grep -Fq 'request_restartable_rsync_preemption' /etc/monsternix/bin/mnx-switch || fail 'mnx-switch lost rsync-only preemption helper'
        grep -Fq 'unexpected-main-exit' /etc/monsternix/bin/mnx-test || fail 'mnx-test lost post-stop main-exit classification'
        grep -Fq 'unexpected-main-exit' /etc/monsternix/bin/mnx-switch || fail 'mnx-switch lost post-stop main-exit classification'
        case "$(systemctl show rsync-m16-new-to-old.service -p SuccessExitStatus --value 2>/dev/null || true)" in *75*) echo 'rsync_operator_preemption_success_status=75' ;; *) fail 'rsync mirror lost clean retryable manager-stop status 75' ;; esac
        case "$(systemctl show rsync-m16-new-to-old.service -p Restart --value 2>/dev/null || true)" in no) echo 'rsync_operator_preemption_restart_policy=no' ;; *) fail 'rsync mirror may restart underneath an operator transaction' ;; esac
        grep -Fq 'manager-stop-retryable' /etc/monsternix/bin/mnx-job-metric || fail 'retryable rsync manager stop lost noncritical metric classification'
        grep -Fq 'operator_storage_lane=acquired-lock-first' /etc/monsternix/bin/mnx-test || fail 'mnx-test lost lock-first operator lane receipt'
        grep -Fq 'operator_storage_lane=acquired-lock-first' /etc/monsternix/bin/mnx-switch || fail 'mnx-switch lost lock-first operator lane receipt'
        grep -Fq 'btrfs-scrub-mnt-m16\x2dnew\x2dstorage.service' /etc/monsternix/bin/mnx-test || fail 'mnx-test lost new-storage scrub classifier'
        grep -Fq 'new_storage_scrub_arbitration=throttled-contention-only-no-operator-deferral' /etc/monsternix/bin/mnx-test || fail 'mnx-test lost new-storage scrub advisory contract'
        grep -Fq 'single-nonblocking-attempt' "$CFG" || fail 'background storage jobs lost nonblocking lock policy'
        if grep -Eq 'flock -w (60|300) -x [89]' "$CFG"; then fail 'an enabled background storage job still queues on the shared lock'; fi
        echo 'MNX_OPERATOR_PRIORITY_STORAGE_LANE=PASS'

      #@MNX-PART id=99.80.mnx-config-audit.phase.audit-result kind=phase title="Phase: AUDIT RESULT"
        section 'AUDIT RESULT'
        printf 'mode=%s\n' "$MODE"
        printf 'failures=%s\n' "$FAIL"
        printf 'warnings=%s\n' "$WARN"
        for index in "''${!FAIL_MESSAGES[@]}"; do printf 'failure_%03d=%s\n' "$((index + 1))" "''${FAIL_MESSAGES[$index]}"; done
        for index in "''${!WARN_MESSAGES[@]}"; do printf 'warning_%03d=%s\n' "$((index + 1))" "''${WARN_MESSAGES[$index]}"; done
        printf 'report=%s\n' "$REPORT"
        printf 'backup_filesystems_written=no\n'
        printf 'old_storage_written=no\n'
        chown root:logbook "$REPORT" 2>/dev/null || true
        chmod 0640 "$REPORT" 2>/dev/null || true
        if (( FAIL > 0 )); then
          echo 'MNX_CONFIG_AUDIT=FAIL'
          exit 1
        fi
        if (( WARN > 0 )); then
          echo 'MNX_CONFIG_AUDIT=PASS_WITH_WARNINGS'
        else
          echo 'MNX_CONFIG_AUDIT=PASS'
        fi
        exit 0
      }

      case "$MODE" in
        source|quick|test|full|support|self-test)
          ;;
        *)
          echo "unknown audit mode: $MODE" >&2
          exit 64
          ;;
      esac

      #@MNX-PART id=99.80.mnx-config-audit.phase.configuration-identity kind=phase title="Phase: CONFIGURATION IDENTITY"
      section 'CONFIGURATION IDENTITY'
      date -Is
      printf 'mode=%s\n' "$MODE"
      printf 'configuration=%s\n' "$CFG"
      RUNNING_SYSTEM="$(readlink -f /run/current-system 2>/dev/null || true)"
      DEFAULT_SYSTEM="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
      SYSTEM_STATE="$(systemctl is-system-running 2>/dev/null || true)"
      printf 'running_system=%s\n' "$RUNNING_SYSTEM"
      printf 'default_system=%s\n' "$DEFAULT_SYSTEM"
      printf 'system_state=%s\n' "$SYSTEM_STATE"
      [[ -r "$CFG" ]] || { fail "$CFG is unreadable"; finish_audit; }
      case "$MODE" in
        source)
          echo 'runtime_generation_requirement=not-applicable-for-source-audit'
          ;;
        test)
          [[ -n "$RUNNING_SYSTEM" ]] || fail 'running generation is unresolved'
          [[ "$SYSTEM_STATE" == running ]] || fail "system state is $SYSTEM_STATE rather than running"
          if [[ -n "$DEFAULT_SYSTEM" && "$RUNNING_SYSTEM" != "$DEFAULT_SYSTEM" ]]; then
            echo 'temporary_test_generation=yes'
          else
            warn 'test audit is running without a distinct temporary generation'
          fi
          ;;
        *)
          [[ -n "$RUNNING_SYSTEM" && "$RUNNING_SYSTEM" == "$DEFAULT_SYSTEM" ]] || fail 'running generation is not the boot-default generation'
          [[ "$SYSTEM_STATE" == running ]] || fail "system state is $SYSTEM_STATE rather than running"
          ;;
      esac
      if [[ "$MODE" != source && -e /etc/nixos/configuration.nix ]]; then
        LIVE_PATH=/etc/nixos/configuration.nix
        LIVE_OWNER="$(stat -c '%U:%G' "$LIVE_PATH" 2>/dev/null || true)"
        LIVE_MODE="$(stat -c '%a' "$LIVE_PATH" 2>/dev/null || true)"
        printf 'live_configuration_owner=%s\n' "''${LIVE_OWNER:-unreadable}"
        printf 'live_configuration_mode=%s\n' "''${LIVE_MODE:-unreadable}"
        [[ -f "$LIVE_PATH" && ! -L "$LIVE_PATH" ]] || fail 'live /etc/nixos/configuration.nix is not a regular non-symlink file'
        [[ "$LIVE_OWNER" == root:root ]] || fail 'live /etc/nixos/configuration.nix is not owned by root:root'
        case "$LIVE_MODE" in
          755|0755) ;;
          *) fail 'live /etc/nixos/configuration.nix is not mode 0755 after activation' ;;
        esac
        [[ -x "$LIVE_PATH" ]] || fail 'live /etc/nixos/configuration.nix is not executable after activation'
        echo 'live_configuration_executable=yes'
      else
        echo 'configuration_executable_requirement=not-applicable-to-source-only-or-frozen-candidate-copy'
      fi
      sha256sum "$CFG"
      wc -l -c "$CFG"

      #@MNX-PART id=99.80.mnx-config-audit.phase.source-lexer-structure-philosophy-check kind=phase title="Phase: SOURCE LEXER / STRUCTURE / PHILOSOPHY CHECK"
      section 'SOURCE LEXER / STRUCTURE / PHILOSOPHY CHECK'
      set +e
      /etc/monsternix/bin/mnx-source-lexer "$CFG"
      PARSER_RC=$?
      set -e
      [[ $PARSER_RC -eq 0 ]] || fail 'source lexer/structure check failed'
      #@MNX-PART id=99.80.mnx-config-audit.phase.nix-parse kind=phase title="Phase: NIX PARSE"
      section 'NIX PARSE'
      if command -v nix-instantiate >/dev/null 2>&1; then
        if nix-instantiate --parse "$CFG" >/dev/null; then
          echo 'nix_instantiate_parse=PASS'
        else
          fail 'nix-instantiate --parse failed'
        fi
      else
        warn 'nix-instantiate is unavailable in PATH'
      fi

      #@MNX-PART id=99.80.mnx-config-audit.phase.nix-language-and-candidate-lineage kind=phase title="Phase: NIX LANGUAGE / SEMANTIC KERNEL / CANDIDATE LINEAGE CONTRACT"
      section 'NIX LANGUAGE / SEMANTIC KERNEL / CANDIDATE LINEAGE CONTRACT'
      grep -Fxq '# MNX_NIX_LANGUAGE_SCHEMA=2' "$CFG" || fail 'Nix-language schema marker is not v2'
      grep -Fxq '# MNX_SEMANTIC_KERNEL_SCHEMA=1' "$CFG" || fail 'semantic-kernel schema marker is missing'
      grep -Fxq '# MNX_CANONICAL_LINEAGE_ENFORCEMENT=source-harness-pre-parse-and-test-lock-plus-mnx-test-pre-parse-and-test-lock-plus-mnx-switch-preflight-and-switch-lock' "$CFG" || fail 'canonical lineage enforcement marker differs'
      grep -Fxq '# MNX_STAGE75_LINEAGE_BRIDGE=revoked-after-accepted-stage75' "$CFG" || fail 'Stage75 bridge revocation marker is missing'
      OBSOLETE_STAGE75_BRIDGE='stage75_candidate_lineage_'
      OBSOLETE_STAGE75_BRIDGE+='bridge'
      if source_bash_contains "$OBSOLETE_STAGE75_BRIDGE"; then fail 'Stage75 source-extracted lineage bridge remains executable'; fi
      source_definition_contains 'environment.etc."monsternix/bin/mnx-test"' 'candidate_lineage_checkpoint() {' || fail 'canonical mnx-test lineage helper is missing from its source definition'
      source_definition_contains 'environment.etc."monsternix/bin/mnx-test"' 'candidate_lineage_checkpoint pre-parse' || fail 'canonical mnx-test pre-parse lineage checkpoint is missing'
      source_definition_contains 'environment.etc."monsternix/bin/mnx-test"' 'candidate_lineage_checkpoint test-lock' || fail 'canonical mnx-test test-lock lineage checkpoint is missing'
      source_definition_contains 'environment.etc."monsternix/bin/mnx-switch"' 'candidate_lineage_checkpoint switch-preflight' || fail 'canonical mnx-switch preflight lineage checkpoint is missing'
      source_definition_contains 'environment.etc."monsternix/bin/mnx-switch"' 'candidate_lineage_checkpoint switch-lock' || fail 'canonical mnx-switch lock-bound lineage checkpoint is missing'
      source_bash_contains 'candidate_lineage_checkpoint pre-parse' || fail 'source-as-Bash pre-parse lineage checkpoint is missing'
      source_bash_contains 'candidate_lineage_checkpoint test-lock' || fail 'source-as-Bash test-lock lineage checkpoint is missing'
      source_definition_contains 'environment.etc."monsternix/semantic-kernel.json".text' 'mnxCanonicalJSON mnxSemanticKernel' || fail 'semantic-kernel immutable projection definition differs'
      source_definition_contains 'environment.etc."monsternix/nix-language.json".text' 'schema = "mnx.nix-language.v2";' || fail 'Nix-language v2 contract definition differs'
      grep -Fxq '    mnxSemanticKernelType = lib.types.submodule {' "$CFG" || fail 'typed semantic-kernel submodule is missing'
      grep -Fxq '    mnxSemanticKernel = (lib.evalModules {' "$CFG" || fail 'semantic kernel is not evaluated through lib.evalModules'
      grep -Fxq '    mnxCanonicalJSON = value: builtins.toJSON value + "\n";' "$CFG" || fail 'canonical JSON constructor is missing'

      if [[ "$MODE" == source ]]; then
        echo 'semantic_kernel_runtime_contract=deferred-until-candidate-activation'
        echo 'nix_language_runtime_contract=deferred-until-candidate-activation'
        echo 'candidate_lineage_runtime_audit=deferred-until-candidate-activation'
      else
        PROJECTION_SELF_TEST_OK=true
        if nix_language_projection_self_test; then
          echo 'NIX_LANGUAGE_PROJECTION_SELF_TEST=PASS'
        else
          fail 'immutable NixOS /etc projection verifier self-test failed'
          PROJECTION_SELF_TEST_OK=false
        fi

        SEMANTIC_KERNEL_CONTRACT=/etc/monsternix/semantic-kernel.json
        SEMANTIC_KERNEL_OK="$PROJECTION_SELF_TEST_OK"
        if SEMANTIC_KERNEL_TARGET="$(resolve_immutable_nixos_etc_projection "$SEMANTIC_KERNEL_CONTRACT")"; then
          SEMANTIC_KERNEL_BEFORE="$(stat -Lc '%d:%i:%s:%Y:%Z:%f' -- "$SEMANTIC_KERNEL_TARGET" 2>/dev/null || true)"
          printf 'semantic_kernel_runtime_projection=%s\n' 'nixos-etc-symlink-chain-to-immutable-nix-store-file'
          printf 'semantic_kernel_contract_target=%s\n' "$SEMANTIC_KERNEL_TARGET"
          [[ -n "$SEMANTIC_KERNEL_BEFORE" ]] || { fail 'semantic-kernel target metadata is unreadable'; SEMANTIC_KERNEL_OK=false; }
          if ! ${pkgs.jq}/bin/jq -e '
            .schema == "mnx.semantic-kernel.v1" and
            .epoch == 1 and
            .machine == {"hostName":"monster-16","timeZone":"America/New_York"} and
            .operator == {"home":"/home/h0p3","name":"h0p3","uid":1000} and
            .paths == {"configuration":"/etc/nixos/configuration.nix","oldStorage":"/mnt/m16-old-storage","presslogState":"/home/h0p3/.local/state/presslog"} and
            .locks == {"storageMaintenance":"/run/storage-maintenance.lock"} and
            .source == {"dynamicImports":false,"importsEmpty":true,"oneFile":true}
          ' "$SEMANTIC_KERNEL_TARGET" >/dev/null; then
            fail 'rendered semantic-kernel contract differs from typed source facts'
            SEMANTIC_KERNEL_OK=false
          fi
          SEMANTIC_KERNEL_AFTER="$(stat -Lc '%d:%i:%s:%Y:%Z:%f' -- "$SEMANTIC_KERNEL_TARGET" 2>/dev/null || true)"
          if [[ -z "$SEMANTIC_KERNEL_AFTER" || "$SEMANTIC_KERNEL_BEFORE" != "$SEMANTIC_KERNEL_AFTER" ]]; then
            fail 'semantic-kernel target changed during verification'
            SEMANTIC_KERNEL_OK=false
          fi
        else
          fail 'semantic-kernel contract is not a safe immutable NixOS /etc projection'
          SEMANTIC_KERNEL_OK=false
        fi
        if [[ "$SEMANTIC_KERNEL_OK" == true ]]; then echo 'MNX_SEMANTIC_KERNEL_CONTRACT=PASS'; else echo 'MNX_SEMANTIC_KERNEL_CONTRACT=FAIL'; fi

        NIX_LANGUAGE_CONTRACT=/etc/monsternix/nix-language.json
        NIX_LANGUAGE_CONTRACT_OK="$PROJECTION_SELF_TEST_OK"
        if NIX_LANGUAGE_CONTRACT_TARGET="$(resolve_immutable_nixos_etc_projection "$NIX_LANGUAGE_CONTRACT")"; then
          NIX_LANGUAGE_CONTRACT_BEFORE="$(stat -Lc '%d:%i:%s:%Y:%Z:%f' -- "$NIX_LANGUAGE_CONTRACT_TARGET" 2>/dev/null || true)"
          printf 'nix_language_runtime_projection=%s\n' 'nixos-etc-symlink-chain-to-immutable-nix-store-file'
          printf 'nix_language_contract_target=%s\n' "$NIX_LANGUAGE_CONTRACT_TARGET"
          [[ -n "$NIX_LANGUAGE_CONTRACT_BEFORE" ]] || { fail 'Nix-language target metadata is unreadable'; NIX_LANGUAGE_CONTRACT_OK=false; }
          if ! ${pkgs.jq}/bin/jq -e '
            .schema == "mnx.nix-language.v2" and
            .nightlyBackupPolicy == {"activationGraceMinutes":45,"backend":"restic","catchupEveryMinutes":30,"catchupJitterMinutes":2,"deadline":"07:00","primaryJitterMinutes":30,"retryFrom":"04:00","schema":"mnx.m21.nightly-policy.v1","slot":"03:25","timezone":"America/New_York"} and
            .epoch == 2 and
            .sourceAuthority == "one-complete-configuration.nix" and
            .imports == "empty" and
            .importsPolicy == "empty-static-list" and
            .dynamicImports == false and
            .moduleEnvelope == "top-level-scoped-let-in" and
            .runtimeProjection == "nixos-etc-symlink-chain-to-root-owned-read-only-nix-store-regular-file" and
            .hiddenAuthority == false and
            .generatedProgramSource == "complete-and-visible" and
            .semanticKernel == {"authority":"typed-shadow-before-consumer-migration","epoch":1,"runtimeProjection":"/etc/monsternix/semantic-kernel.json","schema":"mnx.semantic-kernel.v1"} and
            (.allowedConstructs | type) == "array" and
            (.allowedConstructs | index("let-in")) != null and
            (.allowedConstructs | index("inherit")) != null and
            (.allowedConstructs | index("functions")) != null and
            (.allowedConstructs | index("recursive-attribute-sets")) != null and
            (.allowedConstructs | index("assertions")) != null and
            (.allowedConstructs | index("lib-combinators")) != null and
            (.allowedConstructs | index("option-types")) != null and
            (.allowedConstructs | index("submodules")) != null
          ' "$NIX_LANGUAGE_CONTRACT_TARGET" >/dev/null; then
            fail 'rendered Nix-language contract differs from source policy'
            NIX_LANGUAGE_CONTRACT_OK=false
          fi
          NIX_LANGUAGE_CONTRACT_AFTER="$(stat -Lc '%d:%i:%s:%Y:%Z:%f' -- "$NIX_LANGUAGE_CONTRACT_TARGET" 2>/dev/null || true)"
          if [[ -z "$NIX_LANGUAGE_CONTRACT_AFTER" || "$NIX_LANGUAGE_CONTRACT_BEFORE" != "$NIX_LANGUAGE_CONTRACT_AFTER" ]]; then
            fail 'Nix-language contract target changed during verification'
            NIX_LANGUAGE_CONTRACT_OK=false
          fi
        else
          fail 'Nix-language contract is not a safe immutable NixOS /etc projection'
          NIX_LANGUAGE_CONTRACT_OK=false
        fi
        if [[ "$NIX_LANGUAGE_CONTRACT_OK" == true ]]; then echo 'MNX_NIX_LANGUAGE_CONTRACT=PASS'; else echo 'MNX_NIX_LANGUAGE_CONTRACT=FAIL'; fi

        [[ -x /etc/monsternix/bin/mnx-lineage ]] || fail 'candidate-lineage verifier is not executable'
        /etc/monsternix/bin/mnx-lineage self-test || fail 'candidate-lineage verifier self-test failed'
        grep -Fq 'candidate_lineage_checkpoint pre-parse' /etc/monsternix/bin/mnx-test || fail 'installed mnx-test lacks its pre-parse lineage checkpoint'
        grep -Fq 'candidate_lineage_checkpoint test-lock' /etc/monsternix/bin/mnx-test || fail 'installed mnx-test lacks its lock-bound lineage checkpoint'
        grep -Fq 'candidate_lineage_checkpoint switch-preflight' /etc/monsternix/bin/mnx-switch || fail 'installed mnx-switch lacks its preflight lineage checkpoint'
        grep -Fq 'candidate_lineage_checkpoint switch-lock' /etc/monsternix/bin/mnx-switch || fail 'installed mnx-switch lacks its lock-bound lineage checkpoint'
        grep -Fq 'candidate_lineage_engine=accepted-default-closure-mnx-lineage' /etc/monsternix/bin/mnx-test || fail 'installed mnx-test does not identify its accepted-closure lineage engine'
        grep -Fq 'lineage_bin="$expected_default/etc/monsternix/bin/mnx-lineage"' /etc/monsternix/bin/mnx-test || fail 'installed mnx-test does not resolve lineage through the accepted default closure'
        grep -Fq 'candidate_lineage_engine=accepted-default-closure-mnx-lineage' /etc/monsternix/bin/mnx-switch || fail 'installed mnx-switch does not identify its accepted-closure lineage engine'
        grep -Fq 'lineage_bin="$expected_default/etc/monsternix/bin/mnx-lineage"' /etc/monsternix/bin/mnx-switch || fail 'installed mnx-switch does not resolve lineage through the accepted default closure'
        CANDIDATE_LINEAGE_AUDIT_SHA="$(sha256sum "$CFG" | awk 'NR == 1 { print $1 }')"
        set +e
        CANDIDATE_LINEAGE_AUDIT_OUTPUT="$(/etc/monsternix/bin/mnx-lineage check "$CFG" "$CANDIDATE_LINEAGE_AUDIT_SHA" 2>&1)"
        CANDIDATE_LINEAGE_AUDIT_RC=$?
        set -e
        printf '%s\n' "$CANDIDATE_LINEAGE_AUDIT_OUTPUT"
        (( CANDIDATE_LINEAGE_AUDIT_RC == 0 )) || fail 'candidate-lineage runtime audit refused the active candidate'
        CANDIDATE_LINEAGE_AUDIT_STATE="$(printf '%s\n' "$CANDIDATE_LINEAGE_AUDIT_OUTPUT" | sed -n 's/^candidate_lineage_state=//p' | tail -n 1)"
        case "$CANDIDATE_LINEAGE_AUDIT_STATE" in accepted-exact|direct-successor) ;; *) fail 'candidate-lineage runtime audit emitted an unsupported passing state' ;; esac
        exact_output_line "$CANDIDATE_LINEAGE_AUDIT_OUTPUT" 'candidate_lineage_writes_performed=false' || fail 'candidate-lineage runtime audit did not prove read-only behavior'
        exact_output_line "$CANDIDATE_LINEAGE_AUDIT_OUTPUT" 'candidate_lineage_mutation_authority=none' || fail 'candidate-lineage runtime audit claimed mutation authority'
        exact_output_line "$CANDIDATE_LINEAGE_AUDIT_OUTPUT" 'MNX_CANDIDATE_LINEAGE=PASS' || fail 'candidate-lineage runtime audit omitted PASS marker'
        printf 'candidate_lineage_runtime_state=%s\n' "$CANDIDATE_LINEAGE_AUDIT_STATE"
        echo 'MNX_CANDIDATE_LINEAGE_RUNTIME_AUDIT=PASS'
      fi

      #@MNX-PART id=99.80.mnx-config-audit.phase.embedded-configuration-as-bash-payload-syntax kind=phase title="Phase: EMBEDDED CONFIGURATION-AS-BASH PAYLOAD SYNTAX"
      section 'EMBEDDED CONFIGURATION-AS-BASH PAYLOAD SYNTAX'
      PAYLOAD_TMP="$(mktemp)"
      sed -n '/^#@MNX-BASH-BEGIN$/,/^#@MNX-BASH-END$/p' "$CFG" \
        | sed -e '1d' -e '$d' -e 's/^#@MNX-BASH //' > "$PAYLOAD_TMP"
      if [[ -s "$PAYLOAD_TMP" ]] && bash -n "$PAYLOAD_TMP"; then
        grep -Fq 'MNX_CONFIGURATION_AS_BASH_PAYLOAD=1' "$PAYLOAD_TMP" || fail 'embedded Bash payload identity marker is missing'
        echo 'embedded_bash_payload_syntax=PASS'
      else
        fail 'embedded configuration-as-Bash payload is absent or invalid'
      fi
      rm -f "$PAYLOAD_TMP"

      #@MNX-PART id=99.80.mnx-config-audit.phase.rendered-generated-program-source-check kind=phase title="Phase: RENDERED GENERATED-PROGRAM SOURCE CHECK"
      section 'RENDERED GENERATED-PROGRAM SOURCE CHECK'
      if [[ -x /etc/monsternix/bin/mnx-source-program-audit ]]; then
        /etc/monsternix/bin/mnx-source-program-audit --self-test || fail 'source/closure path-policy self-test failed'
        /etc/monsternix/bin/mnx-source-program-audit source "$CFG" || fail 'candidate generated-program source audit failed'
      else
        fail 'mnx-source-program-audit is missing'
      fi

      if [[ "$MODE" != source ]]; then
        #@MNX-PART id=99.80.mnx-config-audit.phase.active-closure-embedded-source-check kind=phase title="Phase: ACTIVE CLOSURE EMBEDDED-SOURCE CHECK"
        section 'ACTIVE CLOSURE EMBEDDED-SOURCE CHECK'
        /etc/monsternix/bin/mnx-source-program-audit closure /run/current-system/configuration.nix || fail 'active closure embedded-source audit failed'
      fi

      #@MNX-PART id=99.80.mnx-config-audit.phase.monolith-chunk-exact-roundtrip-check kind=phase title="Phase: MONOLITH CHUNK / EXACT ROUNDTRIP CHECK"
      section 'MONOLITH CHUNK / EXACT ROUNDTRIP CHECK'
      if [[ -x /etc/monsternix/bin/mnx-monolith ]]; then
        /etc/monsternix/bin/mnx-monolith --config "$CFG" verify || fail 'mnx-monolith exact roundtrip verification failed'
      else
        warn 'mnx-monolith is unavailable; marker validation still ran in the source parser'
      fi
      #@MNX-PART id=99.80.mnx-config-audit.phase.definition-internal-part-temporary-code-29932c67 kind=phase title="Phase: DEFINITION / INTERNAL-PART / RELATIONSHIP / TEMPORARY-CODE ATLAS CHECK"
      section 'DEFINITION / INTERNAL-PART / RELATIONSHIP / TEMPORARY-CODE ATLAS CHECK'
      if [[ -x /etc/monsternix/bin/mnx-atlas ]]; then
        /etc/monsternix/bin/mnx-atlas self-test || fail 'mnx-atlas defense self-test failed'
        /etc/monsternix/bin/mnx-atlas --config "$CFG" verify || fail 'mnx-atlas strict source verification failed'
        case "$MODE" in
          source|test) TEMP_GATE_MODE=test ;;
          *) TEMP_GATE_MODE=audit ;;
        esac
        ATLAS_TEMP_OUTPUT="$(mktemp)"
        set +e
        /etc/monsternix/bin/mnx-atlas --config "$CFG" temp-gate "$TEMP_GATE_MODE" > "$ATLAS_TEMP_OUTPUT" 2>&1
        ATLAS_TEMP_RC=$?
        set -e
        cat "$ATLAS_TEMP_OUTPUT"
        TEMPORARY_CODE_REGION_COUNT="$(sed -n 's/^temporary_code_region_count=//p' "$ATLAS_TEMP_OUTPUT" | tail -n 1)"
        TEMPORARY_CODE_REGION_IDS="$(sed -n 's/^temporary_code_region_ids=//p' "$ATLAS_TEMP_OUTPUT" | tail -n 1)"
        [[ "$TEMPORARY_CODE_REGION_COUNT" =~ ^[0-9]+$ ]] || fail 'mnx-atlas did not emit a numeric temporary-code count'
        [[ -n "$TEMPORARY_CODE_REGION_IDS" ]] || TEMPORARY_CODE_REGION_IDS=none
        rm -f "$ATLAS_TEMP_OUTPUT"
        (( ATLAS_TEMP_RC == 0 )) || fail "mnx-atlas temporary-code gate failed for mode $TEMP_GATE_MODE"
        if (( TEMPORARY_CODE_REGION_COUNT > 0 )); then
          warn "candidate-only temporary code is active; permanent switch must remain blocked"
        fi
      else
        fail 'mnx-atlas is missing'
      fi
      if [[ -x /etc/monsternix/bin/mnx-relations ]]; then
        /etc/monsternix/bin/mnx-relations self-test || fail 'mnx-relations self-test failed'
        /etc/monsternix/bin/mnx-relations --config "$CFG" verify || fail 'mnx-relations source verification failed'
      else
        fail 'mnx-relations is missing'
      fi

      #@MNX-PART id=99.80.mnx-config-audit.phase.refactor-planner kind=phase title="Phase: REFACTOR PLANNER"
      section 'REFACTOR PLANNER'
      if [[ -x /etc/monsternix/bin/mnx-refactor ]]; then
        /etc/monsternix/bin/mnx-refactor self-test || fail 'mnx-refactor planner self-test failed'
        MNX_CONFIG="$CFG" /etc/monsternix/bin/mnx-refactor frontier --limit 1 --json >/dev/null || fail 'mnx-refactor live frontier failed'
        MNX_CONFIG="$CFG" /etc/monsternix/bin/mnx-refactor plan environment.shellAliases --json >/dev/null || fail 'mnx-refactor live plan failed'
        MNX_CONFIG="$CFG" /etc/monsternix/bin/mnx-refactor port review "$CFG" --json >/dev/null || fail 'mnx port-review live self-comparison failed'
        echo 'MNX_REFACTOR_PLANNER=PASS'
        echo 'MNX_PORT_REVIEW=PASS'
      else
        fail 'mnx-refactor is missing'
      fi

      #@MNX-PART id=99.80.mnx-config-audit.phase.foundation-handoff-interfaces kind=phase title="Phase: FOUNDATION HANDOFF INTERFACES"
      section 'FOUNDATION HANDOFF INTERFACES'
      FOUNDATION_FAILURES_BEFORE="$FAIL"
      if [[ -x /etc/monsternix/bin/mnx ]]; then
        /etc/monsternix/bin/mnx foundation-port-self-test || fail 'Foundation handoff pure self-test failed'
        /etc/monsternix/bin/mnx capsule self-test || fail 'capsule authority self-test failed through public dispatcher'
        CAPSULE_POLICY_JSON="$(/etc/monsternix/bin/mnx capsule policy --json)" || fail 'capsule policy command failed'
        printf '%s\n' "$CAPSULE_POLICY_JSON" | ${pkgs.jq}/bin/jq -e '.schema == "mnx.capsule.policy.v1" and .capsule_schema == 1 and .execution_enabled == false and .run_refusal_status == 69 and .payload_execution == false and .network_used == false and .persistent_mutation == "none"' >/dev/null || fail 'capsule policy JSON contract failed'
        /etc/monsternix/bin/mnx substrate self-test || fail 'substrate continuity self-test failed through public dispatcher'
