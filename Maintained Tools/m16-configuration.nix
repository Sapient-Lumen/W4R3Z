#@MNX-CHUNK id=40.27 slug=rsync-failure-evidence title="Rsync history parser and unit-failure evidence"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-rsync-log-report" section=40.27 role=generated-program ordinal=162
  environment.etc."monsternix/bin/mnx-rsync-log-report" = {
    source = pkgs.writeTextFile {
      name = "mnx-rsync-log-report";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      export PATH=${pkgs.coreutils}/bin:${pkgs.gawk}/bin:${pkgs.gnugrep}/bin:${pkgs.gnused}/bin
      set -Eeuo pipefail
      export LC_ALL=C

      MODE="''${1:-summary}"
      LOG="''${2:-/home/h0p3/admin/logs/root-rsync-storage-drives.log}"

      #@MNX-PART id=40.27.mnx-rsync-log-report.function.usage kind=function title="Function usage"
      usage() {
        cat <<'USAGE'
      usage: mnx-rsync-log-report [summary|last-success-epoch|raw|self-test] [log-path]
      USAGE
      }

      #@MNX-PART id=40.27.mnx-rsync-log-report.function.records kind=function title="Function records"
      records() {
        awk '
          BEGIN { OFS="|"; inrun=0 }

          #@MNX-PART id=40.27.mnx-rsync-log-report.function.reset_run kind=function title="Function reset_run"
          function reset_run() {
            inrun=0
            start_line=0
            start_ts=""
            kind=""
            bad=0
            completed=0
            last_exit=""
            vanished=0
            errors=0
          }

          function close_run(end_line, end_ts, forced_status, forced_exit, status, exitcode) {
            if (!inrun) return
            status=forced_status
            exitcode=forced_exit

            if (status == "") {
              if (bad) status="failure"
              else if (completed) status="success"
              else status="incomplete"
            }

            if (exitcode == "") {
              if (status == "success") exitcode=0
              else if (last_exit != "") exitcode=last_exit
              else exitcode=-1
            }

            print start_line, end_line, start_ts, end_ts, status, exitcode, vanished, errors, kind
            reset_run()
          }

          function open_run(ts, run_kind, line_no) {
            if (inrun) close_run(line_no - 1, "", "incomplete", -1)
            reset_run()
            inrun=1
            start_line=line_no
            start_ts=ts
            kind=run_kind
          }

          {
            if ($0 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9] - BEGIN rsync-m16-new-to-old/) {
              open_run(substr($0, 1, 19), "structured", NR)
              next
            }

            if ($0 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9] - rsync full tree/) {
              open_run(substr($0, 1, 19), "legacy", NR)
              next
            }

            # A bounded log may have lost BEGIN while retaining the explicit structured
            # terminal record. That record is authoritative because only this service
            # writes it after rsync and postflight have completed.
            if (!inrun && $0 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9] - (SUCCESS|ERROR) rsync-m16-new-to-old/) {
              open_run(substr($0, 1, 19), "structured-tail", NR)
            }

            # Legacy logs can also begin in the middle after size bounding. Preserve
            # failure evidence, counts, and examples, but never promote an ambiguous
            # truncated legacy "done" to success.
            if (!inrun && ($0 ~ /file has vanished:/ || $0 ~ /rsync error:/ || $0 ~ /^Number of / || $0 ~ /^Total / || $0 ~ /^Literal data:/ || $0 ~ /^Matched data:/ || $0 ~ /^File list / || $0 ~ /^sent .* bytes/)) {
              open_run("", "legacy-truncated", NR)
            }

            if (!inrun) next

            if ($0 ~ /file has vanished:/) vanished++

            if ($0 ~ /rsync error:/ || $0 ~ / - ERROR rsync/ || $0 ~ /exited with status [1-9][0-9]*/ || $0 ~ / exit=[1-9][0-9]*/) {
              bad=1
              errors++
            }

            if (match($0, /\(code [0-9]+\)/)) { v=substr($0, RSTART + 6, RLENGTH - 7); last_exit=v }
            if (match($0, /status [0-9]+/)) { v=substr($0, RSTART + 7, RLENGTH - 7); last_exit=v }
            if (match($0, /exit=[0-9]+/)) { v=substr($0, RSTART + 5, RLENGTH - 5); last_exit=v }

            if ($0 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9] - ERROR rsync-m16-new-to-old/) {
              close_run(NR, substr($0, 1, 19), "failure", last_exit == "" ? -1 : last_exit)
              next
            }

            if ($0 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9] - SUCCESS rsync-m16-new-to-old .*exit=0/) {
              completed=1
              close_run(NR, substr($0, 1, 19), bad ? "failure" : "success", bad ? (last_exit == "" ? -1 : last_exit) : 0)
              next
            }

            if ($0 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9] - done$/) {
              completed=1
              if (kind == "legacy-truncated" && !bad) {
                close_run(NR, substr($0, 1, 19), "unknown-truncated", -1)
              } else {
                close_run(NR, substr($0, 1, 19), bad ? "failure" : "success", bad ? (last_exit == "" ? -1 : last_exit) : 0)
              }
              next
            }
          }

          END {
            if (inrun) close_run(NR, "", bad ? "failure" : "incomplete", last_exit == "" ? -1 : last_exit)
          }
        ' "$LOG"
      }

      #@MNX-PART id=40.27.mnx-rsync-log-report.function.last_success_row kind=function title="Function last_success_row"
      last_success_row() {
        records | awk -F '|' '$5 == "success" { row=$0 } END { if (row != "") print row }'
      }

      case "$MODE" in
        summary)
          printf 'log_path=%s\n' "$LOG"
          if [[ ! -f "$LOG" ]]; then
            echo 'log_state=missing'
            echo 'run_count=0'
            echo 'latest_run_status=missing'
            echo 'last_success_epoch=0'
            exit 0
          fi

          printf 'log_state=present\n'
          printf 'log_bytes=%s\n' "$(stat -c %s "$LOG" 2>/dev/null || echo 0)"

          TMP="$(mktemp)"
          trap 'rm -f "$TMP"' EXIT
          records > "$TMP"

          COUNT="$(wc -l < "$TMP" | tr -d ' ')"
          printf 'run_count=%s\n' "$COUNT"

          LAST="$(tail -n 1 "$TMP" 2>/dev/null || true)"
          SUCCESS="$(awk -F '|' '$5 == "success" { row=$0 } END { print row }' "$TMP")"

          if [[ -z "$LAST" ]]; then
            echo 'latest_run_status=unparseable'
            echo 'last_success_epoch=0'
            exit 0
          fi

          IFS='|' read -r START_LINE END_LINE START_TS END_TS STATUS EXIT_CODE VANISHED ERRORS KIND <<< "$LAST"
          printf 'latest_run_kind=%s\n' "$KIND"
          printf 'latest_run_start=%s\n' "''${START_TS:-unknown}"
          printf 'latest_run_end=%s\n' "''${END_TS:-unknown}"
          printf 'latest_run_status=%s\n' "$STATUS"
          printf 'latest_run_exit_code=%s\n' "$EXIT_CODE"
          printf 'latest_run_vanished_count=%s\n' "$VANISHED"
          printf 'latest_run_error_line_count=%s\n' "$ERRORS"
          printf 'latest_run_line_range=%s-%s\n' "$START_LINE" "$END_LINE"

          if [[ -n "$SUCCESS" ]]; then
            IFS='|' read -r _ _ SUCCESS_START SUCCESS_END _ _ _ _ _ <<< "$SUCCESS"
            SUCCESS_TS="''${SUCCESS_END:-$SUCCESS_START}"
            SUCCESS_EPOCH="$(date -d "$SUCCESS_TS" +%s 2>/dev/null || echo 0)"
            printf 'last_success_time=%s\n' "$SUCCESS_TS"
            printf 'last_success_epoch=%s\n' "$SUCCESS_EPOCH"
          else
            echo 'last_success_time=none'
            echo 'last_success_epoch=0'
          fi

          printf '\nlatest_run_key_lines:\n'
          sed -n "''${START_LINE},''${END_LINE}p" "$LOG" |
            grep -E '(^Number of files:|^Number of created files:|^Number of deleted files:|^Number of regular files transferred:|^Total file size:|^Total transferred file size:|^Literal data:|^Matched data:|^File list size:|^File list generation time:|^Total bytes sent:|^sent .* bytes|^rsync error:| - ERROR rsync| - (BEGIN|ERROR|SUCCESS|done)$| - (BEGIN|ERROR|SUCCESS) rsync-m16-new-to-old)' |
            tail -n 40 || true

          if (( VANISHED > 0 )); then
            printf '\nlatest_run_first_vanished_examples:\n'
            sed -n "''${START_LINE},''${END_LINE}p" "$LOG" |
              grep -F 'file has vanished:' |
              head -n 10 || true
            printf '\nlatest_run_last_vanished_examples:\n'
            sed -n "''${START_LINE},''${END_LINE}p" "$LOG" |
              grep -F 'file has vanished:' |
              tail -n 10 || true
          fi
          ;;

        last-success-epoch)
          [[ -f "$LOG" ]] || exit 1
          ROW="$(last_success_row)"
          [[ -n "$ROW" ]] || exit 1
          IFS='|' read -r _ _ START_TS END_TS _ _ _ _ _ <<< "$ROW"
          TS="''${END_TS:-$START_TS}"
          date -d "$TS" +%s
          ;;

        raw)
          [[ -f "$LOG" ]] || exit 1
          cat "$LOG"
          ;;

        self-test)
          TMPDIR="$(mktemp -d)"
          trap 'rm -rf "$TMPDIR"' EXIT
          SAMPLE="$TMPDIR/sample.log"
          cat > "$SAMPLE" <<'SAMPLE'
      2026-08-01 01:00:00 - rsync full tree (excluding Btrfs backup subvolume trees)
      Number of files: 3
      2026-08-01 01:10:00 - done
      2026-08-02 01:00:00 - rsync full tree (excluding Btrfs backup subvolume trees)
      file has vanished: "/x"
      rsync error: some files/attrs were not transferred (code 23) at main.c(1)
      2026-08-02 01:10:00 - ERROR rsync full tree exited with status 23
      2026-08-02 01:10:01 - done
      2026-08-03 01:00:00 - BEGIN rsync-m16-new-to-old run_id=x source=/a destination=/b
      Number of files: 4
      2026-08-03 01:20:00 - SUCCESS rsync-m16-new-to-old run_id=x exit=0
      2026-08-04 01:00:00 - BEGIN rsync-m16-new-to-old run_id=y source=/a destination=/b
      SAMPLE

          EXPECTED="$(date -d '2026-08-03 01:20:00' +%s)"
          ACTUAL="$($0 last-success-epoch "$SAMPLE")"
          [[ "$ACTUAL" == "$EXPECTED" ]]
          SUMMARY="$($0 summary "$SAMPLE")"
          grep -Fq 'run_count=4' <<< "$SUMMARY"
          grep -Fq 'latest_run_status=incomplete' <<< "$SUMMARY"
          grep -Fq 'last_success_time=2026-08-03 01:20:00' <<< "$SUMMARY"

          TRUNC_FAIL="$TMPDIR/truncated-failure.log"
          cat > "$TRUNC_FAIL" <<'TRUNC_FAIL_SAMPLE'
      file has vanished: "/x"
      rsync error: some files/attrs were not transferred (code 23) at main.c(1)
      2026-08-05 01:10:01 - done
      TRUNC_FAIL_SAMPLE
          if "$0" last-success-epoch "$TRUNC_FAIL" >/dev/null 2>&1; then
            echo 'truncated failed legacy run was incorrectly accepted as success' >&2
            exit 1
          fi
          grep -Fq 'latest_run_status=failure' <<< "$("$0" summary "$TRUNC_FAIL")"

          TRUNC_UNKNOWN="$TMPDIR/truncated-unknown.log"
          cat > "$TRUNC_UNKNOWN" <<'TRUNC_UNKNOWN_SAMPLE'
      Number of files: 9
      2026-08-06 01:10:01 - done
      TRUNC_UNKNOWN_SAMPLE
          if "$0" last-success-epoch "$TRUNC_UNKNOWN" >/dev/null 2>&1; then
            echo 'ambiguous truncated legacy done was incorrectly accepted as success' >&2
            exit 1
          fi
          grep -Fq 'latest_run_status=unknown-truncated' <<< "$("$0" summary "$TRUNC_UNKNOWN")"

          STRUCTURED_TAIL="$TMPDIR/structured-tail.log"
          printf '%s
      ' '2026-08-07 01:20:00 - SUCCESS rsync-m16-new-to-old run_id=z exit=0' > "$STRUCTURED_TAIL"
          EXPECTED_TAIL="$(date -d '2026-08-07 01:20:00' +%s)"
          ACTUAL_TAIL="$("$0" last-success-epoch "$STRUCTURED_TAIL")"
          [[ "$ACTUAL_TAIL" == "$EXPECTED_TAIL" ]]
          grep -Fq 'latest_run_kind=structured-tail' <<< "$("$0" summary "$STRUCTURED_TAIL")"

          echo 'MNX_RSYNC_LOG_REPORT_SELF_TEST=PASS'
          ;;

        -h|--help|help)
          usage
          ;;

        *)
          usage >&2
          exit 64
          ;;
      esac
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            ;;
          '#!'*python*)
            ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
            ;;
          *)
            echo "unsupported generated-script interpreter: $first" >&2
            exit 1
            ;;
        esac
      '';
    };
  };

#@MNX-DEF path=environment.etc."monsternix/bin/mnx-unit-failure-record" section=40.27 role=generated-program ordinal=163
  environment.etc."monsternix/bin/mnx-unit-failure-record" = {
    source = pkgs.writeTextFile {
      name = "mnx-unit-failure-record";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      export PATH=${pkgs.coreutils}/bin:${pkgs.gnused}/bin:${pkgs.util-linux}/bin:${pkgs.systemd}/bin
      set -Eeuo pipefail
      export LC_ALL=C

      if [[ ''${EUID:-$(id -u)} -ne 0 ]]; then
        echo 'mnx-unit-failure-record is an internal root-only helper' >&2
        exit 77
      fi

      UNIT="''${1:-unknown.service}"
      SAFE_UNIT="$(printf '%s' "$UNIT" | sed -E 's/[^A-Za-z0-9_.@-]+/_/g')"
      EPOCH="$(date +%s)"
      TS="$(date -Is)"
      SAFE_TS="$(date +%Y%m%dT%H%M%S)-$$"
      BOOT_ID="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
      SYSTEM="$(readlink -f /run/current-system 2>/dev/null || true)"
      HISTORY_DIR=/var/lib/logbook/unit-failures
      STATE_DIR=/var/lib/monsternix/job-state/authoritative
      EVENT_TMP="$HISTORY_DIR/$SAFE_TS-$SAFE_UNIT.txt.$$"
      EVENT="$HISTORY_DIR/$SAFE_TS-$SAFE_UNIT.txt"
      STATE_TMP="$STATE_DIR/$SAFE_UNIT.last-failure.$$"
      STATE="$STATE_DIR/$SAFE_UNIT.last-failure"

      install -d -m 2750 -o root -g logbook "$HISTORY_DIR"
      install -d -m 0750 -o root -g logbook "$STATE_DIR"

      {
        echo '=== MONSTERNIX UNIT FAILURE HISTORY ==='
        printf 'timestamp=%s\n' "$TS"
        printf 'epoch=%s\n' "$EPOCH"
        printf 'unit=%s\n' "$UNIT"
        printf 'boot_id=%s\n' "$BOOT_ID"
        printf 'system=%s\n' "$SYSTEM"
        echo
        systemctl show "$UNIT" \
          -p Id -p LoadState -p ActiveState -p SubState -p Result \
          -p ExecMainCode -p ExecMainStatus -p ExecMainStartTimestamp \
          -p ExecMainExitTimestamp -p StateChangeTimestamp -p FragmentPath \
          --no-pager 2>&1 || true
        echo
        echo '--- journal tail ---'
        journalctl -u "$UNIT" -b --no-pager -o short-iso -n 120 2>&1 || true
      } > "$EVENT_TMP"

      cat > "$STATE_TMP" <<EOF_STATE
      unit=$UNIT
      timestamp=$TS
      epoch=$EPOCH
      boot_id=$BOOT_ID
      system=$SYSTEM
      event=$EVENT
      EOF_STATE

      chown root:logbook "$EVENT_TMP" "$STATE_TMP"
      chmod 0640 "$EVENT_TMP" "$STATE_TMP"
      mv -f "$EVENT_TMP" "$EVENT"
      mv -f "$STATE_TMP" "$STATE"
      chown root:logbook "$EVENT" "$STATE"
      chmod 0640 "$EVENT" "$STATE"

      logger --journald <<EOF_JOURNAL || true
      MESSAGE_ID=32e6b44d-8426-51cf-9e25-642b6f60682b
      PRIORITY=3
      LOGBOOK_KIND=MNX_UNIT_FAILURE_HISTORY
      LOGBOOK_VER=1
      MNX_UNIT=$SAFE_UNIT
      MNX_FAILURE_EPOCH=$EPOCH
      BUNDLE_PATH=$EVENT
      MESSAGE=Monsternix unit failure recorded: $UNIT
      EOF_JOURNAL

      printf 'unit_failure_record=%s\n' "$EVENT"
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            ;;
          '#!'*python*)
            ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
            ;;
          *)
            echo "unsupported generated-script interpreter: $first" >&2
            exit 1
            ;;
        esac
      '';
    };
  };

#@MNX-DEF path=environment.etc."monsternix/bin/mnx-metric-reconcile" section=40.27 role=generated-program ordinal=164
  environment.etc."monsternix/bin/mnx-metric-reconcile" = {
    source = pkgs.writeTextFile {
      name = "mnx-metric-reconcile";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      export PATH=${pkgs.coreutils}/bin:${pkgs.findutils}/bin:${pkgs.gnugrep}/bin:${pkgs.gnused}/bin:${pkgs.util-linux}/bin
      set -Eeuo pipefail
      export LC_ALL=C

      if [[ ''${EUID:-$(id -u)} -ne 0 ]]; then
        echo 'mnx-metric-reconcile is root-only' >&2
        exit 77
      fi

      START_EPOCH="$(date +%s)"
      TS="$(date -Is)"
      SAFE_TS="$(date +%Y%m%dT%H%M%S)"
      ACTIVE=/var/lib/node-exporter-textfile
      HISTORY=/var/lib/logbook/metrics-history
      MAINT=/var/lib/logbook/maintenance
      REPORT_TMP="$MAINT/metric-reconcile-$SAFE_TS.txt.$$"
      REPORT="$MAINT/metric-reconcile-$SAFE_TS.txt"
      PROM_TMP="$ACTIVE/monsternix_metric_reconcile.prom.$$"
      PROM="$ACTIVE/monsternix_metric_reconcile.prom"
      ARCHIVED=0
      CURRENT=0

      install -d -m 0755 -o root -g root "$ACTIVE"
      install -d -m 2750 -o root -g logbook "$HISTORY" "$MAINT"

      #@MNX-PART id=40.27.mnx-metric-reconcile.function.archive_metric kind=function title="Function archive_metric"
      archive_metric() {
        local source="$1"
        local base stamp destination suffix target
        [[ -e "$source" || -L "$source" ]] || return 0
        base="$(basename "$source")"
        stamp="$(date -d "@$(stat -c %Y "$source" 2>/dev/null || date +%s)" +%Y%m%dT%H%M%S 2>/dev/null || echo "$SAFE_TS")"
        destination="$HISTORY/$stamp-$base"
        suffix=0
        while [[ -e "$destination" || -L "$destination" ]]; do
          suffix=$((suffix + 1))
          destination="$HISTORY/$stamp-$suffix-$base"
        done
        if [[ -L "$source" ]]; then
          target="$(readlink "$source" 2>/dev/null || true)"
          rm -f "$source"
          destination="$destination.rejected-symlink.txt"
          printf 'source=%s\nsymlink_target=%s\nreason=active-metric-symlink-rejected\n' "$source" "$target" > "$destination"
        elif [[ -f "$source" ]]; then
          mv -f "$source" "$destination"
        else
          echo "refusing unexpected active metric object: $source" >&2
          return 1
        fi
        chown root:logbook "$destination"
        chmod 0640 "$destination"
        printf 'archived=%s -> %s\n' "$source" "$destination" >> "$REPORT_TMP"
        ARCHIVED=$((ARCHIVED + 1))
      }

      {
        echo '=== MONSTERNIX METRIC RECONCILIATION ==='
        printf 'timestamp=%s\n' "$TS"
        printf 'active_directory=%s\n' "$ACTIVE"
        printf 'history_directory=%s\n' "$HISTORY"
        echo
      } > "$REPORT_TMP"

      shopt -s nullglob
      # The active directory was historically group-writable. Retire every
      # symlink or non-root-owned metric before enforcing root-only publication.
      for metric in "$ACTIVE"/*.prom; do
        if [[ -L "$metric" ]] || [[ "$(stat -c '%u' "$metric" 2>/dev/null || echo -1)" != 0 ]]; then
          archive_metric "$metric"
        fi
      done
      for metric in "$ACTIVE"/monsternix_job_*.prom; do
        case "$(basename "$metric")" in
          monsternix_job_current_*.prom)
            if grep -Eq 'name="[^"]*[.]service"' "$metric" 2>/dev/null; then
              archive_metric "$metric"
            else
              chown root:root "$metric"
              chmod 0644 "$metric"
              CURRENT=$((CURRENT + 1))
            fi
            ;;
          *)
            archive_metric "$metric"
            ;;
        esac
      done
      shopt -u nullglob

      cat >> "$REPORT_TMP" <<EOF_REPORT
      archived_legacy_metrics=$ARCHIVED
      current_job_metrics=$CURRENT
      result=success
      EOF_REPORT

      chown root:logbook "$REPORT_TMP"
      chmod 0640 "$REPORT_TMP"
      mv -f "$REPORT_TMP" "$REPORT"
      chown root:logbook "$REPORT"
      chmod 0640 "$REPORT"

      cat > "$PROM_TMP" <<EOF_PROM
      # HELP monsternix_metric_reconcile_timestamp_seconds Unix timestamp of the latest metric reconciliation.
      # TYPE monsternix_metric_reconcile_timestamp_seconds gauge
      monsternix_metric_reconcile_timestamp_seconds $START_EPOCH
      # HELP monsternix_metric_reconcile_archived_legacy_total Legacy active textfile metrics archived during the latest reconciliation.
      # TYPE monsternix_metric_reconcile_archived_legacy_total gauge
      monsternix_metric_reconcile_archived_legacy_total $ARCHIVED
      # HELP monsternix_metric_reconcile_current_job_files Current logical-job metric files retained after reconciliation.
      # TYPE monsternix_metric_reconcile_current_job_files gauge
      monsternix_metric_reconcile_current_job_files $CURRENT
      EOF_PROM
      chmod 0644 "$PROM_TMP"
      mv -f "$PROM_TMP" "$PROM"
      chown root:root "$PROM"
      chmod 0644 "$PROM"

      logger --journald <<EOF_JOURNAL || true
      MESSAGE_ID=1faea81c-5465-541b-b1c4-056ee85a1b6f
      PRIORITY=5
      LOGBOOK_KIND=MNX_METRIC_RECONCILE
      LOGBOOK_VER=1
      MNX_ARCHIVED_LEGACY_METRICS=$ARCHIVED
      MNX_CURRENT_JOB_METRICS=$CURRENT
      BUNDLE_PATH=$REPORT
      MESSAGE=Monsternix metrics reconciled: archived=$ARCHIVED current=$CURRENT
      EOF_JOURNAL

      /etc/monsternix/bin/mnx-job-metric mnx-metric-reconcile 0 "$(( $(date +%s) - START_EPOCH ))" 0 none || true
      printf 'metric_reconcile_report=%s\n' "$REPORT"
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            ;;
          '#!'*python*)
            ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
            ;;
          *)
            echo "unsupported generated-script interpreter: $first" >&2
            exit 1
            ;;
        esac
      '';
    };
  };

  # One command for a future ChatGPT support turn:
  #
  #   mnx-support-report
  #   SINCE="7 days ago" mnx-support-report
  #
  # It prints a bounded, paste-ready report and saves the same text beneath
  # /var/lib/logbook/support. It never starts/stops a service and never writes
  # to any storage mount, including old-storage.
#@MNX-CHUNK id=40.28 slug=support-report title="Bounded paste-ready future-ChatGPT support report"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-support-report" section=40.28 role=generated-program ordinal=165
  environment.etc."monsternix/bin/mnx-support-report" = {
    source = pkgs.writeTextFile {
      name = "mnx-support-report";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      set -uo pipefail
      export LC_ALL=C SYSTEMD_PAGER=cat SYSTEMD_COLORS=0 PAGER=cat

      SINCE="''${SINCE:-48 hours ago}"
      MAX_JOURNAL="''${MAX_JOURNAL:-120}"
      MNX_SUPPORT_RAW_RSYNC="''${MNX_SUPPORT_RAW_RSYNC:-0}"

      if [ "$EUID" -ne 0 ]; then
        [ -x /run/wrappers/bin/sudo ] || { echo '/run/wrappers/bin/sudo is unavailable' >&2; exit 126; }
        exec /run/wrappers/bin/sudo -- \
          ${pkgs.coreutils}/bin/env \
          SINCE="$SINCE" \
          MAX_JOURNAL="$MAX_JOURNAL" \
          MNX_SUPPORT_RAW_RSYNC="$MNX_SUPPORT_RAW_RSYNC" \
          /etc/monsternix/bin/mnx-support-report "$@"
      fi

      TS="$(${pkgs.coreutils}/bin/date +%Y%m%dT%H%M%S)"
      ROOT=/var/lib/logbook/support
      OUT="$ROOT/support-$TS.txt"
      ${pkgs.coreutils}/bin/install -d -m 2750 -o root -g logbook "$ROOT"
      exec > >(${pkgs.coreutils}/bin/tee "$OUT") 2>&1

      #@MNX-PART id=40.28.mnx-support-report.function.section kind=function title="Function section"
      section() {
        printf '\n\n================================================================================\n%s\n================================================================================\n' "$1"
      }

      #@MNX-PART id=40.28.mnx-support-report.function.show_unit kind=function title="Function show_unit"
      show_unit() {
        unit="$1"
        printf '\n--- %s ---\n' "$unit"
        ${pkgs.systemd}/bin/systemctl show "$unit" \
          -p Id -p LoadState -p ActiveState -p SubState -p UnitFileState \
          -p Result -p ExecMainCode -p ExecMainStatus \
          -p ExecMainStartTimestamp -p ExecMainExitTimestamp \
          -p MemoryPeak -p IOReadBytes -p IOWriteBytes \
          -p TriggeredBy -p Triggers -p OnFailure -p FragmentPath -p ExecStart \
          -p SuccessExitStatus -p ReadWritePaths -p RefuseManualStart \
          -p ProtectSystem -p NoNewPrivileges -p RestrictSUIDSGID \
          --no-pager 2>&1 || true
      }

      #@MNX-PART id=40.28.mnx-support-report.function.show_script_keys kind=function title="Function show_script_keys"
      show_script_keys() {
        unit="$1"
        raw="$(${pkgs.systemd}/bin/systemctl show "$unit" -p ExecStart --value 2>/dev/null || true)"
        path="$(printf '%s\n' "$raw" | ${pkgs.gnused}/bin/sed -n 's/.*path=\([^ ;}]*\).*/\1/p' | ${pkgs.coreutils}/bin/head -n 1)"
        printf '\n--- %s installed script ---\n' "$unit"
        printf 'path=%s\n' "''${path:-unresolved}"
        if [ -n "$path" ] && [ -r "$path" ]; then
          ${pkgs.coreutils}/bin/sha256sum "$path" 2>/dev/null || true
          ${pkgs.gnugrep}/bin/grep -nE \
            'storage-maintenance|flock -w|mnx-job-(metric|success)|mnx-storage-(preflight|postflight)|btrfs receive|REMOTE_HOSTS|KEEP_LOCAL|KEEP_REMOTE|admin/backups|syncs/m21|--exclude|overall_stale|retention_' \
            "$path" 2>/dev/null | ${pkgs.coreutils}/bin/head -n 160 || true
        fi
      }

      #@MNX-PART id=40.28.mnx-support-report.function.show_snaproot kind=function title="Function show_snaproot"
      show_snaproot() {
        label="$1"
        root="$2"
        pattern="$3"
        section "$label"
        ${pkgs.coreutils}/bin/stat -c 'type=%F owner=%U:%G mode=%a modified=%y path=%n' "$root" 2>&1 || true
        printf 'read_only_descendants='
        ${pkgs.btrfs-progs}/bin/btrfs subvolume list -r -o "$root" 2>/dev/null \
          | ${pkgs.gawk}/bin/awk 'END { print NR + 0 }'
        latest="$(${pkgs.findutils}/bin/find "$root" -mindepth 1 -maxdepth 1 -type d -name "$pattern" -printf '%f\n' 2>/dev/null | ${pkgs.coreutils}/bin/sort | ${pkgs.coreutils}/bin/tail -n 1)"
        printf 'latest=%s\n' "''${latest:-none}"
        if [ -n "$latest" ]; then
          ${pkgs.btrfs-progs}/bin/btrfs property get -ts "$root/$latest" ro 2>&1 || true
          ${pkgs.btrfs-progs}/bin/btrfs subvolume show "$root/$latest" 2>&1 \
            | ${pkgs.gnugrep}/bin/grep -E '^[[:space:]]*(Name|UUID|Parent UUID|Received UUID|Creation time|Flags|Subvolume ID)' || true
        fi
        printf 'top_level_tail:\n'
        ${pkgs.findutils}/bin/find "$root" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null \
          | ${pkgs.coreutils}/bin/sort | ${pkgs.coreutils}/bin/tail -n 30 || true
      }

      #@MNX-PART id=40.28.mnx-support-report.phase.report-identity kind=phase title="Phase: REPORT IDENTITY"
      section "REPORT IDENTITY"
      ${pkgs.coreutils}/bin/date -Is
      printf 'report=%s\n' "$OUT"
      printf 'hostname=%s\n' "$(${pkgs.coreutils}/bin/cat /proc/sys/kernel/hostname 2>/dev/null || true)"
      printf 'kernel=%s\n' "$(${pkgs.coreutils}/bin/uname -r)"
      printf 'nixos_version=%s\n' "$(/run/current-system/sw/bin/nixos-version 2>/dev/null || true)"
      printf 'boot_id=%s\n' "$(${pkgs.coreutils}/bin/cat /proc/sys/kernel/random/boot_id)"
      printf 'mode=%s\n' "$(${pkgs.coreutils}/bin/cat /run/monsternix/mode 2>/dev/null || echo unknown)"
      printf 'running_system=%s\n' "$(${pkgs.coreutils}/bin/readlink -f /run/current-system 2>/dev/null || true)"
      printf 'default_system=%s\n' "$(${pkgs.coreutils}/bin/readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
      printf 'configuration_sha256=%s\n' "$(${pkgs.coreutils}/bin/sha256sum /etc/nixos/configuration.nix 2>/dev/null | ${pkgs.gawk}/bin/awk '{print $1}')"
      printf 'system_state=%s\n' "$(${pkgs.systemd}/bin/systemctl is-system-running 2>/dev/null || true)"
      printf 'since=%s\n' "$SINCE"
      printf 'diagnostic_only=yes\nold_storage_written=no\n'
      printf 'raw_rsync_log_included=%s\n' "$MNX_SUPPORT_RAW_RSYNC"

      #@MNX-PART id=40.28.mnx-support-report.phase.latest-mnx-rebuild-test kind=phase title="Phase: LATEST MNX REBUILD TEST"
      section "LATEST MNX REBUILD TEST"
      LATEST_MNX_TEST="$(${pkgs.findutils}/bin/find /var/lib/logbook/support -maxdepth 1 -type f -name 'mnx-test-*.txt' -printf '%T@ %p\n' 2>/dev/null | ${pkgs.coreutils}/bin/sort -nr | ${pkgs.coreutils}/bin/head -n 1 | ${pkgs.gnused}/bin/sed -E 's/^[^ ]+ //')"
      printf 'latest_mnx_test=%s\n' "''${LATEST_MNX_TEST:-none}"
      if [ -n "$LATEST_MNX_TEST" ]; then
        ${pkgs.coreutils}/bin/stat -c 'owner=%U:%G mode=%a bytes=%s modified=%y path=%n' "$LATEST_MNX_TEST" 2>&1 || true
        ${pkgs.gnugrep}/bin/grep -E '^(mnx_test_result|mnx_process_exit_status|phase|terminal_phase|interrupted_signal|interrupted_phase|source_audit_rc|source_bootstrap_rc|source_program_compatibility_rc|source_full_compatibility_rc|source_handoff_mode|source_handoff_live_probe|candidate_authoritative_source_gate|candidate_temporary_code_gate_rc|nixos_rebuild_test_rc|post_test_audit_rc|behavior_contract_rc|support_report_rc|rollback_rc|baseline_kind|baseline_running_is_boot_default|prior_running_system|prior_boot_default_system|candidate_snapshot|candidate_configuration_sha256|source_audit_log|rebuild_log|post_audit_log|support_log|contract_log|state_file|live_source_sha256_after|source_mutated_during_test|activated_embedded_configuration_sha256|activated_embedded_configuration_matches_candidate|temporary_running_system|unchanged_boot_default_system|deferred_reason|deferred_units|retry_recommended|retry_command|temporary_code_region_count|temporary_code_region_ids|safe_to_run_operator_normal_switch|switch_command|MNX_TEST=)' "$LATEST_MNX_TEST" 2>&1 | ${pkgs.coreutils}/bin/tail -n 120 || true
      fi
      LATEST_MNX_CANDIDATE="$(${pkgs.findutils}/bin/find /var/lib/logbook/support -maxdepth 1 -type f -name 'mnx-test-*.candidate.nix' -printf '%T@ %p\n' 2>/dev/null | ${pkgs.coreutils}/bin/sort -nr | ${pkgs.coreutils}/bin/head -n 1 | ${pkgs.gnused}/bin/sed -E 's/^[^ ]+ //')"
      printf 'latest_mnx_candidate=%s\n' "''${LATEST_MNX_CANDIDATE:-none}"
      if [ -n "$LATEST_MNX_CANDIDATE" ]; then
        ${pkgs.coreutils}/bin/stat -c 'owner=%U:%G mode=%a bytes=%s modified=%y path=%n' "$LATEST_MNX_CANDIDATE" 2>&1 || true
        ${pkgs.coreutils}/bin/sha256sum "$LATEST_MNX_CANDIDATE" 2>&1 || true
      fi

      #@MNX-PART id=40.28.mnx-support-report.phase.latest-mnx-permanent-switch kind=phase title="Phase: LATEST MNX PERMANENT SWITCH"
      section "LATEST MNX PERMANENT SWITCH"
      LATEST_MNX_SWITCH="$(${pkgs.findutils}/bin/find /var/lib/logbook/support -maxdepth 1 -type f -name 'mnx-switch-*.txt' -printf '%T@ %p\n' 2>/dev/null | ${pkgs.coreutils}/bin/sort -nr | while IFS=' ' read -r _ file; do ${pkgs.gnugrep}/bin/grep -q '^mnx_switch_result=' "$file" 2>/dev/null && { printf '%s\n' "$file"; break; }; done)"
      printf 'latest_mnx_switch=%s\n' "''${LATEST_MNX_SWITCH:-none}"
      if [ -n "$LATEST_MNX_SWITCH" ]; then
        ${pkgs.coreutils}/bin/stat -c 'owner=%U:%G mode=%a bytes=%s modified=%y path=%n' "$LATEST_MNX_SWITCH" 2>&1 || true
        ${pkgs.gnugrep}/bin/grep -E '^(mnx_switch_result|phase|candidate_configuration_sha256|test_report|test_result|switch_rebuild_rc|switch_profile_set_rc|switch_activation_rc|tested_system|post_switch_audit_rc|behavior_contract_rc|behavior_baseline_replaced|accepted_behavior_baseline|baseline_adoption_started|baseline_adoption_committed|baseline_adoption_rc|office_commit_rc|office_record|office_commit_committed|post_commit_seal_rc|core_acceptance_result|post_acceptance_plan|post_acceptance_status|post_acceptance_rc|post_acceptance_action_results|post_acceptance_mutation_proof|post_acceptance_receipt|post_acceptance_locks_released|support_report_rc|rollback_rc|running_system|default_system|source_mutated_during_switch|old_storage_direct_write_by_mnx_switch|MNX_SWITCH=)' "$LATEST_MNX_SWITCH" 2>&1 | ${pkgs.coreutils}/bin/tail -n 100 || true
      fi

      #@MNX-PART id=40.28.mnx-support-report.phase.monolith-chunk-map-and-refactor-contract kind=phase title="Phase: MONOLITH CHUNK MAP AND REFACTOR CONTRACT"
      section "MONOLITH CHUNK MAP AND REFACTOR CONTRACT"
      if [ -x /etc/monsternix/bin/mnx-monolith ]; then
        /etc/monsternix/bin/mnx-monolith --config /etc/nixos/configuration.nix index 2>&1 || true
      else
        echo 'mnx-monolith is absent'
      fi
      if [ -x /etc/monsternix/bin/mnx-atlas ]; then
        /etc/monsternix/bin/mnx-atlas --config /etc/nixos/configuration.nix verify 2>&1 || true
        /etc/monsternix/bin/mnx-atlas --config /etc/nixos/configuration.nix temp 2>&1 || true
      else
        echo 'mnx-atlas is absent'
      fi
      if [ -x /etc/monsternix/bin/mnx-relations ]; then
        /etc/monsternix/bin/mnx-relations --config /etc/nixos/configuration.nix verify 2>&1 || true
        /etc/monsternix/bin/mnx-relations --config /etc/nixos/configuration.nix index 2>&1 | ${pkgs.coreutils}/bin/head -n 160 || true
      else
        echo 'mnx-relations is absent'
      fi
      printf '\nBehavior baseline state:\n'
      /etc/monsternix/bin/mnx-behavior-manifest status 2>&1 || true

      #@MNX-PART id=40.28.mnx-support-report.phase.mnx-test-harness-identity kind=phase title="Phase: MNX TEST HARNESS IDENTITY"
      section "MNX TEST HARNESS IDENTITY"
      for program in /etc/monsternix/bin/mnx /etc/monsternix/bin/mnx-test /etc/monsternix/bin/mnx-switch /etc/monsternix/bin/mnx-config-audit /etc/monsternix/bin/mnx-behavior-manifest /etc/monsternix/bin/mnx-atlas /etc/monsternix/bin/mnx-relations /etc/monsternix/bin/mnx-upgrade /etc/monsternix/bin/mnx-configuration-as-bash; do
        printf '\n--- %s ---\n' "$program"
        ${pkgs.coreutils}/bin/stat -L -c 'owner=%U:%G mode=%a bytes=%s modified=%y target=%N' "$program" 2>&1 || true
        ${pkgs.coreutils}/bin/sha256sum "$program" 2>&1 || true
        ${pkgs.bash}/bin/bash -n "$program" 2>&1 && echo 'bash_syntax=ok' || true
      done

      #@MNX-PART id=40.28.mnx-support-report.phase.pinned-behavior-baseline kind=phase title="Phase: PINNED BEHAVIOR BASELINE"
      section "PINNED BEHAVIOR BASELINE"
      if [ -x /etc/monsternix/bin/mnx-behavior-manifest ]; then
        /etc/monsternix/bin/mnx-behavior-manifest status 2>&1 || true
        if [ -L /var/lib/logbook/baselines/pinned ]; then
          /etc/monsternix/bin/mnx-behavior-manifest compare pinned 2>&1 || true
        fi
      else
        echo 'mnx-behavior-manifest is absent'
      fi

      #@MNX-PART id=40.28.mnx-support-report.phase.live-mnx-test-state kind=phase title="Phase: LIVE MNX TEST STATE"
      section "LIVE MNX TEST STATE"
      if [ -s /run/monsternix/mnx-test.current ]; then
        ${pkgs.coreutils}/bin/cat /run/monsternix/mnx-test.current 2>&1 || true
      else
        echo 'mnx_test_running=no'
      fi

      #@MNX-PART id=40.28.mnx-support-report.phase.failed-units-jobs-locks-and-storage-processes kind=phase title="Phase: FAILED UNITS, JOBS, LOCKS, AND STORAGE PROCESSES"
      section "FAILED UNITS, JOBS, LOCKS, AND STORAGE PROCESSES"
      ${pkgs.systemd}/bin/systemctl --failed --no-pager --full 2>&1 || true
      printf '\nPending jobs:\n'
      ${pkgs.systemd}/bin/systemctl list-jobs --no-pager 2>&1 || true
      printf '\nStorage lock holders:\n'
      ${pkgs.coreutils}/bin/timeout 15s ${pkgs.util-linux}/bin/lslocks -o COMMAND,PID,TYPE,MODE,PATH 2>&1 \
        | ${pkgs.gnugrep}/bin/grep -E 'COMMAND|storage-maintenance|btrbk-monsternix|m21-btrfs|m16-restic|rest-server|mnx-test' || true
      printf '\nRelevant processes:\n'
      ${pkgs.procps}/bin/pgrep -af 'btrbk|btrfs (send|receive|scrub|subvolume sync)|rsync|restic|rest-server|duperemove|m21-btrfs|mnx-storage-catchup' || true

      #@MNX-PART id=40.28.mnx-support-report.phase.relevant-timers kind=phase title="Phase: RELEVANT TIMERS"
      section "RELEVANT TIMERS"
      ${pkgs.systemd}/bin/systemctl list-timers --all --no-pager 2>&1 \
        | ${pkgs.gnugrep}/bin/grep -E 'NEXT|btrbk|m21-btrfs|m16-backup-m21|m16-restic|rsync-m16|duperemove|mnx-storage-catchup|mnx-logbook-prune|mnx-storage-health|mnx-swapfile-audit|btrfs-scrub|fstrim' || true

      #@MNX-PART id=40.28.mnx-support-report.phase.network-exposure-attribution kind=phase title="Phase: NETWORK EXPOSURE ATTRIBUTION"
      section "NETWORK EXPOSURE ATTRIBUTION"
      if [[ -x /etc/monsternix/bin/mnx-exposure ]]; then
        /etc/monsternix/bin/mnx-exposure summary 2>&1 || true
        echo 'full_command=mnx exposure full'
      else
        echo 'MNX_EXPOSURE=UNAVAILABLE'
      fi

      #@MNX-PART id=40.28.mnx-support-report.phase.pid-1-manager-loop-transaction-scope kind=phase title="Phase: PID 1 MANAGER-LOOP TRANSACTION SCOPE"
      section "PID 1 MANAGER-LOOP TRANSACTION SCOPE"
      if [[ -x /etc/monsternix/bin/mnx-manager-loop-report ]]; then
        /etc/monsternix/bin/mnx-manager-loop-report full || true
      else
        echo 'mnx-manager-loop-report is unavailable'
      fi

      #@MNX-PART id=40.28.mnx-support-report.phase.relevant-service-state kind=phase title="Phase: RELEVANT SERVICE STATE"
      section "RELEVANT SERVICE STATE"
      for unit in \
        btrbk-main.service \
        btrbk-archive-to-new-storage.service \
        m21-btrfs-pull-backup.service \
        m16-restic-enrollment-check.service \
        m16-rest-server.service \
        m16-backup-m21.service \
        m16-restic-maintenance.service \
        rsync-m16-new-to-old.service \
        duperemove-home.service \
        duperemove-m16-new-storage.service \
        mnx-storage-catchup.service \
        mnx-logbook-prune.service \
        mnx-storage-health.service \
        mnx-swapfile-audit.service \
        logbook-incident-scan.service
      do
        show_unit "$unit"
      done

      #@MNX-PART id=40.28.mnx-support-report.phase.installed-storage-script-keys kind=phase title="Phase: INSTALLED STORAGE SCRIPT KEYS"
      section "INSTALLED STORAGE SCRIPT KEYS"
      for unit in \
        btrbk-main.service \
        btrbk-archive-to-new-storage.service \
        m21-btrfs-pull-backup.service \
        m16-backup-m21.service \
        m16-restic-maintenance.service \
        rsync-m16-new-to-old.service \
        mnx-storage-catchup.service \
        mnx-logbook-prune.service
      do
        show_script_keys "$unit"
      done

      #@MNX-PART id=40.28.mnx-support-report.phase.monsternix-authoritative-job-state kind=phase title="Phase: MONSTERNIX AUTHORITATIVE JOB STATE"
      section "MONSTERNIX AUTHORITATIVE JOB STATE"
      for file in /var/lib/monsternix/job-state/authoritative/*.last-run /var/lib/monsternix/job-state/authoritative/*.last-success; do
        [ -f "$file" ] || continue
        printf '\n--- %s ---\n' "$file"
        ${pkgs.coreutils}/bin/cat "$file"
      done
      printf '\nUnprivileged telemetry records (not freshness authority):\n'
      ${pkgs.findutils}/bin/find /var/lib/monsternix/job-state/telemetry -maxdepth 1 -type f -name '*.last-run' -printf '%TY-%Tm-%TdT%TH:%TM:%TS %s %f\n' 2>/dev/null | ${pkgs.coreutils}/bin/sort || true

      #@MNX-PART id=40.28.mnx-support-report.phase.presslog-metadata kind=phase title="Phase: PRESSLOG ENCRYPTED JOURNAL METADATA"
      section "PRESSLOG ENCRYPTED JOURNAL METADATA"
      PRESSLOG_CURRENT=/var/lib/monsternix/job-state/authoritative/presslog.current.json
      PRESSLOG_META="$(stat -Lc '%U:%G:%a:%s' "$PRESSLOG_CURRENT" 2>/dev/null || true)"
      case "$PRESSLOG_META" in
        root:logbook:640:*)
          PRESSLOG_SIZE="''${PRESSLOG_META##*:}"
          if [[ "$PRESSLOG_SIZE" =~ ^[0-9]+$ && "$PRESSLOG_SIZE" -le 65536 && -f "$PRESSLOG_CURRENT" && ! -L "$PRESSLOG_CURRENT" ]]; then
            ${pkgs.coreutils}/bin/cat "$PRESSLOG_CURRENT"
          else
            echo 'presslog metadata record is unsafe or oversized'
          fi
          ;;
        "") echo 'presslog metadata record absent' ;;
        *) echo "presslog metadata record metadata differs: $PRESSLOG_META" ;;
      esac
      echo 'presslog_content_inspected=false'
      echo 'presslog_private_material_read=false'
      echo 'presslog_journal_payload_read=false'

      #@MNX-PART id=40.28.mnx-support-report.phase.m21-restic-backup-product-state kind=phase title="Phase: M21 RESTIC BACKUP PRODUCT STATE"
      section "M21 RESTIC BACKUP PRODUCT STATE"
      RESTIC_BACKUP_CURRENT=/var/lib/monsternix/job-state/authoritative/m16-restic-m21.current.json
      RESTIC_BACKUP_META="$(stat -Lc '%U:%G:%a:%s' "$RESTIC_BACKUP_CURRENT" 2>/dev/null || true)"
      case "$RESTIC_BACKUP_META" in
        root:logbook:640:*)
          RESTIC_BACKUP_SIZE="''${RESTIC_BACKUP_META##*:}"
          if [[ "$RESTIC_BACKUP_SIZE" =~ ^[0-9]+$ && "$RESTIC_BACKUP_SIZE" -le 65536 && -f "$RESTIC_BACKUP_CURRENT" && ! -L "$RESTIC_BACKUP_CURRENT" ]]; then
            ${pkgs.jq}/bin/jq -cS '{schema,recorded_at,source_sha256,running_system,default_system,controller_status,product_status,phase,reason,command_rc,evidence_bundle,reconciliation_only,service_started,network_used,credential_read,repository_accessed,backup_filesystems_written,secrets_recorded}' "$RESTIC_BACKUP_CURRENT" 2>/dev/null || echo 'm21 Restic backup current state JSON is invalid'
          else
            echo 'm21 Restic backup current state is unsafe or oversized'
          fi
          ;;
        "") echo 'm21 Restic backup current state absent' ;;
        *) echo "m21 Restic backup current state metadata differs: $RESTIC_BACKUP_META" ;;
      esac
      echo 'm21_restic_backup_payload_inspected=false'
      echo 'm21_restic_backup_credentials_read=false'

      #@MNX-PART id=40.28.mnx-support-report.phase.backup-freshness-and-catch-up kind=phase title="Phase: BACKUP FRESHNESS AND CATCH-UP"
      section "BACKUP FRESHNESS AND CATCH-UP"
      ${pkgs.coreutils}/bin/cat /var/lib/logbook/backups/freshness-current.txt 2>&1 || echo 'freshness report absent'
      printf '\nCatch-up journal:\n'
      ${pkgs.systemd}/bin/journalctl -u mnx-storage-catchup.service --since "$SINCE" --no-pager -o short-iso -n "$MAX_JOURNAL" 2>&1 || true

      #@MNX-PART id=40.28.mnx-support-report.phase.m21-ssh-endpoint-and-source-markers kind=phase title="Phase: M21 SSH ENDPOINT AND SOURCE MARKERS"
      section "M21 SSH ENDPOINT AND SOURCE MARKERS"
      M21_STATE=/var/lib/m21-btrfs-pull-backup
      M21_KEY="$M21_STATE/id_ed25519"
      M21_PUB="$M21_STATE/id_ed25519.pub"
      M21_KNOWN="$M21_STATE/known_hosts"
      M21_SELECTED=""
      for file in "$M21_KEY" "$M21_PUB" "$M21_KNOWN" "$M21_STATE/last-endpoint" "$M21_STATE/trusted-helper-sha256" "$M21_STATE/trusted-helper-evidence" "$M21_STATE/last-remote-identity" "$M21_STATE/last-helper-mismatch"; do
        ${pkgs.coreutils}/bin/stat -c 'owner=%U:%G mode=%a bytes=%s modified=%y path=%n' "$file" 2>&1 || true
      done
      if [ -r "$M21_PUB" ]; then
        ${pkgs.openssh}/bin/ssh-keygen -lf "$M21_PUB" 2>&1 || true
      fi
      if [ -r "$M21_KNOWN" ]; then
        printf '\nKnown m21 host-key fingerprints:\n'
        ${pkgs.openssh}/bin/ssh-keygen -lf "$M21_KNOWN" 2>&1 || true
      fi
      if [ -r "$M21_KEY" ] && [ -r "$M21_KNOWN" ]; then
        for host in 192.168.100.119 192.168.1.25; do
          printf 'probe=%s ' "$host"
          if ${pkgs.coreutils}/bin/timeout 12s \
            ${pkgs.openssh}/bin/ssh \
              -n -T \
              -i "$M21_KEY" \
              -o IdentitiesOnly=yes \
              -o BatchMode=yes \
              -o StrictHostKeyChecking=yes \
              -o UserKnownHostsFile="$M21_KNOWN" \
              -o ConnectTimeout=8 \
              -o ConnectionAttempts=1 \
              -o Compression=no \
              -o LogLevel=ERROR \
              "h0p3@$host" true \
              >/dev/null 2>&1
          then
            echo reachable
            [ -n "$M21_SELECTED" ] || M21_SELECTED="$host"
          else
            echo unreachable-or-untrusted
          fi
        done
      fi
      printf 'selected_reachable_endpoint=%s\n' "''${M21_SELECTED:-none}"
      if [ -n "$M21_SELECTED" ]; then
        ${pkgs.coreutils}/bin/timeout 20s \
          ${pkgs.openssh}/bin/ssh \
            -n -T \
            -i "$M21_KEY" \
            -o IdentitiesOnly=yes \
            -o BatchMode=yes \
            -o StrictHostKeyChecking=yes \
            -o UserKnownHostsFile="$M21_KNOWN" \
            -o ConnectTimeout=8 \
            -o ConnectionAttempts=1 \
            -o Compression=no \
            -o LogLevel=ERROR \
            "h0p3@$M21_SELECTED" \
            'set -u
             printf "remote_hostname="; hostname
             printf "helper_sha256="; sha256sum /etc/sandworm/m21-btrfs-backup-source 2>/dev/null | awk "{print \$1}" || echo unreadable
             printf "validated_marker="; cat /home/h0p3/.cache/m21-backup/validated-snapshot 2>/dev/null || echo missing
             printf "m16_received_marker="; cat /home/h0p3/.cache/m21-backup/m16-received-snapshot 2>/dev/null || echo missing' \
            2>&1 || true
      fi

      printf '\nLocal m21 helper trust state:\n'
      /etc/monsternix/bin/mnx-m21-identity helper-status 2>&1 || true
      printf '\nStrict enrolled m21 identity verification:\n'
      ${pkgs.coreutils}/bin/timeout 35s /etc/monsternix/bin/mnx-m21-identity 2>&1 || true

      show_snaproot "LOCAL /HOME BTRBK SNAPSHOTS" /home/.btrbk-snapshots 'home.[0-9]*T[0-9]*'
      show_snaproot "BACKUP-NVME RECEIVED SNAPSHOTS" /mnt/m16-backup-nvme/btrbk-snapshots 'home.[0-9]*T[0-9]*'
      show_snaproot "NEW-STORAGE LONG-TERM ARCHIVE" /mnt/m16-new-storage/admin/backups 'home.[0-9]*T[0-9]*'
      show_snaproot "M21 RECEIVED SNAPSHOTS" /mnt/m16-new-storage/syncs/m21 'home-[0-9]*T[0-9]*Z'
      printf '\nM16 Restic replacement lane:\n'
      printf 'enrollment_marker='; [ -e /etc/nixos/secrets/m16-restic/enabled ] && echo present || echo absent
      ${pkgs.systemd}/bin/systemctl is-enabled m16-backup-m21.timer m16-restic-maintenance.timer 2>&1 || true
      if [ -f /mnt/m16-new-storage/admin/backups/restic/m21/config ]; then
        printf 'repository_initialized=yes\n'
        ${pkgs.coreutils}/bin/du -sh /mnt/m16-new-storage/admin/backups/restic/m21 2>&1 || true
      else
        printf 'repository_initialized=no\n'
      fi

      #@MNX-PART id=40.28.mnx-support-report.phase.filesystem-space-btrfs-and-swap kind=phase title="Phase: FILESYSTEM, SPACE, BTRFS, AND SWAP"
      section "FILESYSTEM, SPACE, BTRFS, AND SWAP"
      ${pkgs.util-linux}/bin/lsblk -o NAME,KNAME,TYPE,SIZE,FSTYPE,UUID,ROTA,TRAN,MOUNTPOINTS,MODEL 2>&1 || true
      for mp in / /mnt/m16-backup-nvme /mnt/m16-new-storage /mnt/m16-old-storage; do
        printf '\n--- %s ---\n' "$mp"
        ${pkgs.util-linux}/bin/findmnt -T "$mp" -o TARGET,SOURCE,FSTYPE,UUID,OPTIONS 2>&1 || true
        ${pkgs.coreutils}/bin/df -hT "$mp" 2>&1 || true
        if ${pkgs.util-linux}/bin/findmnt -rn -T "$mp" >/dev/null 2>&1; then
          _mnx_fs_label="$(printf '%s' "$mp" | ${pkgs.gnused}/bin/sed 's#^/$#root#; s#^/##; s#[^A-Za-z0-9_.-]#_#g')"
          _mnx_fs_available="$(${pkgs.coreutils}/bin/df -B1 --output=avail "$mp" 2>/dev/null | ${pkgs.coreutils}/bin/tail -n 1 | ${pkgs.coreutils}/bin/tr -d '[:space:]' || true)"
          _mnx_fs_used_percent="$(${pkgs.coreutils}/bin/df --output=pcent "$mp" 2>/dev/null | ${pkgs.coreutils}/bin/tail -n 1 | ${pkgs.coreutils}/bin/tr -dc '0-9' || true)"
          printf 'filesystem_available_bytes[%s]=%s\n' "$_mnx_fs_label" "''${_mnx_fs_available:-unknown}"
          printf 'filesystem_used_percent[%s]=%s\n' "$_mnx_fs_label" "''${_mnx_fs_used_percent:-unknown}"
        fi
        if [ "$(${pkgs.util-linux}/bin/findmnt -rn -T "$mp" -o FSTYPE 2>/dev/null || true)" = btrfs ]; then
          ${pkgs.btrfs-progs}/bin/btrfs device stats "$mp" 2>&1 || true
          ${pkgs.btrfs-progs}/bin/btrfs scrub status "$mp" 2>&1 || true
        fi
      done
      printf '\nSwap:\n'
      ${pkgs.util-linux}/bin/swapon --show --bytes --output NAME,TYPE,SIZE,USED,PRIO 2>&1 || true

      #@MNX-PART id=40.28.mnx-support-report.phase.smart-headlines kind=phase title="Phase: SMART HEADLINES"
      section "SMART HEADLINES"
      for dev in /dev/nvme0 /dev/nvme1; do
        [ -e "$dev" ] || continue
        printf '\n--- %s ---\n' "$dev"
        ${pkgs.nvme-cli}/bin/nvme smart-log "$dev" 2>/dev/null \
          | ${pkgs.gnugrep}/bin/grep -E -i 'critical_warning|temperature|available_spare|percentage_used|media_errors|num_err_log_entries|warning temperature time|critical composite temperature time' || true
      done
      for dev in /dev/sda /dev/sdb; do
        [ -b "$dev" ] || continue
        printf '\n--- %s ---\n' "$dev"
        ${pkgs.smartmontools}/bin/smartctl -H -A "$dev" 2>/dev/null \
          | ${pkgs.gnugrep}/bin/grep -E 'SMART overall-health|Reallocated_Sector_Ct|Reported_Uncorrect|Command_Timeout|Current_Pending_Sector|Offline_Uncorrectable|UDMA_CRC_Error_Count|Temperature_Celsius' || true
      done

      #@MNX-PART id=40.28.mnx-support-report.phase.structured-monsternix-notifications-and-1c59b52c kind=phase title="Phase: STRUCTURED MONSTERNIX NOTIFICATIONS AND JOB RESULTS"
      section "STRUCTURED MONSTERNIX NOTIFICATIONS AND JOB RESULTS"
      ${pkgs.systemd}/bin/journalctl --since "$SINCE" \
        MESSAGE_ID=a1a93a94-fc5e-5ad8-8e47-4b581f4a0d6d \
        --no-pager -o short-iso -n 300 2>&1 || true
      ${pkgs.systemd}/bin/journalctl --since "$SINCE" \
        MESSAGE_ID=c7dd62d9-727e-5ebd-9c2f-99600feeb1cf \
        --no-pager -o short-iso -n 300 2>&1 || true

      #@MNX-PART id=40.28.mnx-support-report.phase.current-monsternix-metric-summary kind=phase title="Phase: CURRENT MONSTERNIX METRIC SUMMARY"
      section "CURRENT MONSTERNIX METRIC SUMMARY"
      printf 'active_textfile_directory=/var/lib/node-exporter-textfile\n'
      ${pkgs.coreutils}/bin/stat -c 'active_textfile_owner=%U:%G active_textfile_mode=%a' /var/lib/node-exporter-textfile 2>&1 || true
      printf 'current_logical_job_metric_count='
      ${pkgs.findutils}/bin/find /var/lib/node-exporter-textfile -maxdepth 1 -type f -name 'monsternix_job_current_*.prom' -printf '.\n' 2>/dev/null \
        | ${pkgs.gawk}/bin/awk 'END { print NR + 0 }'
      printf 'legacy_active_job_metric_count='
      ${pkgs.findutils}/bin/find /var/lib/node-exporter-textfile -maxdepth 1 -type f -name 'monsternix_job_*.prom' ! -name 'monsternix_job_current_*.prom' -printf '.\n' 2>/dev/null \
        | ${pkgs.gawk}/bin/awk 'END { print NR + 0 }'

      for metric in /var/lib/node-exporter-textfile/monsternix_job_current_*.prom; do
        [ -f "$metric" ] || continue
        printf '\n--- %s ---\n' "$metric"
        ${pkgs.coreutils}/bin/stat -c 'modified=%y bytes=%s' "$metric" 2>&1 || true
        ${pkgs.gnugrep}/bin/grep -E \
          '^(monsternix_job_last_run_timestamp_seconds|monsternix_job_last_exit_code|monsternix_job_last_duration_seconds|monsternix_job_last_success|monsternix_job_last_skipped)' \
          "$metric" 2>&1 || true
      done

      printf '\n--- storage health current sample ---\n'
      printf '\n--- job-state authority layout ---\n'
      for path in /var/lib/monsternix/job-state /var/lib/monsternix/job-state/authoritative /var/lib/monsternix/job-state/telemetry; do
        ${pkgs.coreutils}/bin/stat -c 'owner=%U:%G mode=%a bytes=%s path=%n' "$path" 2>&1 || true
      done
      printf 'legacy_root_job_state_entries=' 
      ${pkgs.findutils}/bin/find /var/lib/monsternix/job-state -maxdepth 1 \( -type f -o -type l \) -name '*.last-*' -printf '.\n' 2>/dev/null | ${pkgs.gawk}/bin/awk 'END { print NR + 0 }'
      printf '\nAuthoritative state:\n'
      ${pkgs.findutils}/bin/find /var/lib/monsternix/job-state/authoritative -maxdepth 1 -type f -name '*.last-*' -printf '%TY-%Tm-%TdT%TH:%TM:%TS %U:%G %m %f\n' 2>/dev/null | ${pkgs.coreutils}/bin/sort || true
      printf '\nUnprivileged telemetry:\n'
      ${pkgs.findutils}/bin/find /var/lib/monsternix/job-state/telemetry -maxdepth 1 -type f -name '*.last-run' -printf '%TY-%Tm-%TdT%TH:%TM:%TS %U:%G %m %f\n' 2>/dev/null | ${pkgs.coreutils}/bin/sort || true
      printf '\nBtrfs baseline state:\n'
      /etc/monsternix/bin/mnx-btrfs-baseline status 2>&1 || true

      STORAGE_METRIC=/var/lib/node-exporter-textfile/monsternix_storage.prom
      if [ -f "$STORAGE_METRIC" ]; then
        STORAGE_EPOCH="$(${pkgs.gawk}/bin/awk '$1 == "monsternix_storage_health_observation_timestamp_seconds" { print $2; exit }' "$STORAGE_METRIC" 2>/dev/null || true)"
        case "$STORAGE_EPOCH" in
          ""|*[!0-9]*)
            echo 'storage_health_observation_epoch=missing-or-malformed'
            ;;
          *)
            printf 'storage_health_observation_epoch=%s\n' "$STORAGE_EPOCH"
            printf 'storage_health_sample_age_seconds=%s\n' "$(( $(${pkgs.coreutils}/bin/date +%s) - STORAGE_EPOCH ))"
            ;;
        esac
        ${pkgs.gnugrep}/bin/grep -E \
          '^(monsternix_storage_health_|monsternix_memory_pressure_seen_last_24h|monsternix_btrfs_baseline_|monsternix_nvme_temperature_celsius|monsternix_nvme_critical_warning|monsternix_btrfs_device_errors)' \
          "$STORAGE_METRIC" 2>&1 || true
      else
        echo 'storage_health_metric=missing'
      fi

      printf '\n--- journal integrity current sample ---\n'
      JOURNAL_STATE_FILE=/var/lib/monsternix/journal-integrity/current.json
      JOURNAL_METRIC=/var/lib/node-exporter-textfile/monsternix_journal_integrity.prom
      if [ -r "$JOURNAL_STATE_FILE" ]; then
        JOURNAL_STATE="$(${pkgs.jq}/bin/jq -r '.overall_status // "unknown"' "$JOURNAL_STATE_FILE" 2>/dev/null || echo unknown)"
        JOURNAL_CLEAN_FORWARD="$(${pkgs.jq}/bin/jq -r '.clean_forward.status // (if .overall_status == "malfunction" then "unknown-observer-malfunction" elif .overall_status == "review-required" then "unanchored" elif .overall_status == "clean" then "clean" else "unknown" end)' "$JOURNAL_STATE_FILE" 2>/dev/null || echo unknown)"
        JOURNAL_ANCHOR="$(${pkgs.jq}/bin/jq -r '.anchor.path // "none"' "$JOURNAL_STATE_FILE" 2>/dev/null || echo none)"
        JOURNAL_ANCHOR_PRESENT="$(${pkgs.jq}/bin/jq -r 'if .anchor.present == true then "yes" else "no" end' "$JOURNAL_STATE_FILE" 2>/dev/null || echo no)"
        JOURNAL_NEW_COUNT="$(${pkgs.jq}/bin/jq -r '.clean_forward.new_problem_count // 0' "$JOURNAL_STATE_FILE" 2>/dev/null || echo unknown)"
        JOURNAL_EVIDENCE="$(${pkgs.jq}/bin/jq -r '.evidence_bundle // "none"' "$JOURNAL_STATE_FILE" 2>/dev/null || echo none)"
        printf 'journal_integrity_state=%s\n' "$JOURNAL_STATE"
        printf 'journal_integrity_clean_forward_status=%s\n' "$JOURNAL_CLEAN_FORWARD"
        printf 'journal_integrity_anchor_present=%s\n' "$JOURNAL_ANCHOR_PRESENT"
        printf 'journal_integrity_anchor_path=%s\n' "$JOURNAL_ANCHOR"
        printf 'journal_integrity_new_problem_count=%s\n' "$JOURNAL_NEW_COUNT"
        printf 'journal_integrity_evidence=%s\n' "$JOURNAL_EVIDENCE"
        ${pkgs.jq}/bin/jq -c '{observed_at,overall_status,clean_forward,anchor,namespaces,policy,evidence_bundle}' "$JOURNAL_STATE_FILE" 2>&1 || true
        if [ -d "$JOURNAL_EVIDENCE" ] && [ ! -L "$JOURNAL_EVIDENCE" ]; then
          ${pkgs.coreutils}/bin/stat -c 'journal_evidence_owner=%U:%G mode=%a bytes=%s path=%n' "$JOURNAL_EVIDENCE" 2>&1 || true
          ${pkgs.gnugrep}/bin/grep -hE 'FAIL:|File corruption detected|Invalid data object|Bad message|references invalid entry' "$JOURNAL_EVIDENCE"/*.verify.txt 2>/dev/null | ${pkgs.coreutils}/bin/head -n 40 || true
        fi
      else
        echo 'journal_integrity_state=unknown'
        echo 'journal_integrity_clean_forward_status=unknown'
        echo 'journal_integrity_anchor_present=no'
        echo 'journal_integrity_anchor_path=none'
        echo 'journal_integrity_new_problem_count=unknown'
        echo 'journal_integrity_evidence=none'
      fi
      if [ -r "$JOURNAL_METRIC" ]; then
        ${pkgs.gnugrep}/bin/grep -E '^monsternix_journal_integrity_' "$JOURNAL_METRIC" 2>&1 || true
      else
        echo 'journal_integrity_metric=missing'
      fi

      printf '\n--- backup freshness current sample ---\n'
      ${pkgs.gnugrep}/bin/grep -E '^monsternix_backup_freshness_' \
        /var/lib/node-exporter-textfile/monsternix_backup_freshness.prom 2>&1 || true

      #@MNX-PART id=40.28.mnx-support-report.phase.unit-failure-history-not-active-health kind=phase title="Phase: UNIT FAILURE HISTORY (NOT ACTIVE HEALTH)"
      section "UNIT FAILURE HISTORY (NOT ACTIVE HEALTH)"
      printf 'failure_state_records:\n'
      ${pkgs.findutils}/bin/find /var/lib/monsternix/job-state/authoritative -maxdepth 1 -type f -name '*.last-failure' -printf '%T@ %p\n' 2>/dev/null \
        | ${pkgs.coreutils}/bin/sort -nr | ${pkgs.coreutils}/bin/head -n 20 \
        | while read -r _ file; do
            [ -n "$file" ] || continue
            printf '\n--- %s ---\n' "$file"
            ${pkgs.coreutils}/bin/cat "$file" 2>&1 || true
          done
      printf '\nnewest_failure_events:\n'
      ${pkgs.findutils}/bin/find /var/lib/logbook/unit-failures -maxdepth 1 -type f -name '*.txt' -printf '%T@ %p\n' 2>/dev/null \
        | ${pkgs.coreutils}/bin/sort -nr | ${pkgs.coreutils}/bin/head -n 20 || true
      printf '\nretired_legacy_metric_count='
      ${pkgs.findutils}/bin/find /var/lib/logbook/metrics-history -maxdepth 1 -type f -printf '.\n' 2>/dev/null \
        | ${pkgs.gawk}/bin/awk 'END { print NR + 0 }'
      printf '\nnewest_retired_legacy_metrics:\n'
      ${pkgs.findutils}/bin/find /var/lib/logbook/metrics-history -maxdepth 1 -type f -printf '%T@ %p\n' 2>/dev/null \
        | ${pkgs.coreutils}/bin/sort -nr | ${pkgs.coreutils}/bin/head -n 20 || true

      #@MNX-PART id=40.28.mnx-support-report.phase.backup-success-metadata kind=phase title="Phase: BACKUP SUCCESS METADATA"
      section "BACKUP SUCCESS METADATA"
      printf '\n--- archive last-success ---\n'
      ${pkgs.coreutils}/bin/cat /mnt/m16-new-storage/admin/backups/.monsternix/last-success.txt 2>&1 || true
      printf '\n--- m21 selected endpoint ---\n'
      ${pkgs.coreutils}/bin/cat /var/lib/m21-btrfs-pull-backup/last-endpoint 2>&1 || true
      printf '\n--- rsync mirror summary ---\n'
      /etc/monsternix/bin/mnx-rsync-log-report summary /home/h0p3/admin/logs/root-rsync-storage-drives.log 2>&1 || true
      if [ "$MNX_SUPPORT_RAW_RSYNC" = 1 ]; then
        printf '\n--- opt-in raw rsync tail ---\n'
        ${pkgs.coreutils}/bin/tail -n 160 /home/h0p3/admin/logs/root-rsync-storage-drives.log 2>&1 || true
      fi
      printf '\n--- btrbk transaction tail ---\n'
      ${pkgs.coreutils}/bin/tail -n 160 /var/lib/btrbk/main-transactions.log 2>&1 || true

      #@MNX-PART id=40.28.mnx-support-report.phase.latest-health-report-summaries kind=phase title="Phase: LATEST HEALTH REPORT SUMMARIES"
      section "LATEST HEALTH REPORT SUMMARIES"
      for pattern in '????-??-??.txt' 'storage-health-*.txt' 'swapfile-audit-*.txt'; do
        latest_report="$(${pkgs.findutils}/bin/find /var/lib/logbook/daily -maxdepth 1 -type f -name "$pattern" -printf '%T@ %p\n' 2>/dev/null | ${pkgs.coreutils}/bin/sort -nr | ${pkgs.coreutils}/bin/head -n 1 | ${pkgs.gnused}/bin/sed -E 's/^[^ ]+ //')"
        [ -n "$latest_report" ] || continue
        printf '\n--- %s ---\n' "$latest_report"
        ${pkgs.coreutils}/bin/stat -c 'modified=%y bytes=%s' "$latest_report" 2>&1 || true
        ${pkgs.gawk}/bin/awk '
          NR == 1 { print; next }
          /^(WARN|CRIT|INFO):/ { print; next }
          /^== Failed/ { show=1; print; next }
          /^== Current boot/ { show=1; print; next }
          /^== Historical/ { show=1; print; next }
          /^== Backup freshness/ { show=1; print; next }
          /^== / { show=0 }
          show { print }
        ' "$latest_report" 2>&1 | ${pkgs.coreutils}/bin/head -n 220 || true
      done

      #@MNX-PART id=40.28.mnx-support-report.phase.recent-backup-and-health-journals kind=phase title="Phase: RECENT BACKUP AND HEALTH JOURNALS"
      section "RECENT BACKUP AND HEALTH JOURNALS"
      for unit in \
        btrbk-main.service \
        btrbk-archive-to-new-storage.service \
        m21-btrfs-pull-backup.service \
        m16-restic-enrollment-check.service \
        m16-rest-server.service \
        m16-backup-m21.service \
        m16-restic-maintenance.service \
        rsync-m16-new-to-old.service \
        mnx-storage-catchup.service \
        mnx-logbook-prune.service \
        mnx-storage-health.service \
        mnx-swapfile-audit.service
      do
        printf '\n--- %s ---\n' "$unit"
        ${pkgs.systemd}/bin/journalctl -u "$unit" --since "$SINCE" --no-pager -o short-iso -n "$MAX_JOURNAL" 2>&1 || true
      done

      #@MNX-PART id=40.28.mnx-support-report.phase.current-boot-warning-and-kernel-signals kind=phase title="Phase: CURRENT-BOOT WARNING AND KERNEL SIGNALS"
      section "CURRENT-BOOT WARNING AND KERNEL SIGNALS"
      ${pkgs.systemd}/bin/journalctl -b --since "$SINCE" -p warning..alert --no-pager -o short-iso 2>&1 \
        | ${pkgs.gnugrep}/bin/grep -E -i 'Monsternix|mnx-|Logbook|btrbk|btrfs|rsync|m21|swap|I/O error|Input/output error|Broken pipe|OOM|earlyoom|systemd-oomd' \
        | ${pkgs.coreutils}/bin/tail -n 500 || true
      printf '\nKernel warning..alert:\n'
      ${pkgs.systemd}/bin/journalctl -k -b --since "$SINCE" -p warning..alert --no-pager -o short-iso -n 300 2>&1 || true

      #@MNX-PART id=40.28.mnx-support-report.phase.logbook-inventory kind=phase title="Phase: LOGBOOK INVENTORY"
      section "LOGBOOK INVENTORY"
      ${pkgs.coreutils}/bin/du -sh /var/lib/logbook 2>&1 || true
      ${pkgs.findutils}/bin/find /var/lib/logbook -maxdepth 2 -type f -printf '%TY-%Tm-%Td %TH:%TM:%TS %s %p\n' 2>/dev/null \
        | ${pkgs.coreutils}/bin/sort -r | ${pkgs.coreutils}/bin/head -n 80 || true
      printf '\nNewest incident directories:\n'
      ${pkgs.findutils}/bin/find /var/lib/logbook/incidents -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null \
        | ${pkgs.coreutils}/bin/sort -nr | ${pkgs.coreutils}/bin/head -n 10 || true
      NEWEST_INCIDENT="$(${pkgs.findutils}/bin/find /var/lib/logbook/incidents -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null | ${pkgs.coreutils}/bin/sort -nr | ${pkgs.coreutils}/bin/head -n 1 | ${pkgs.gnused}/bin/sed -E 's/^[^ ]+ //')"
      if [ -n "$NEWEST_INCIDENT" ]; then
        printf '\nNewest incident details: %s\n' "$NEWEST_INCIDENT"
        for name in index.json matches.txt kernel-matches.txt journal-matches.txt systemctl.failed.txt; do
          [ -f "$NEWEST_INCIDENT/$name" ] || continue
          printf '\n--- %s ---\n' "$name"
          ${pkgs.gnused}/bin/sed -n '1,240p' "$NEWEST_INCIDENT/$name" 2>&1 || true
        done
      fi

      #@MNX-PART id=40.28.mnx-support-report.phase.configuration-policy-keys kind=phase title="Phase: CONFIGURATION POLICY KEYS"
      section "CONFIGURATION POLICY KEYS"
      ${pkgs.gnugrep}/bin/grep -nE \
        'mnx test|mnx-test|mnx-config-audit source|mnx-storage-catchup|mnx-logbook-prune|LOCK_WAIT|flock -w 300|mnx-job-success|admin/backups|syncs/m21|RefuseManualStart|StrictHostKeyChecking|OnCalendar = "03:25"|OnCalendar = "Sat .*11:15|OnCalendar = "\\*-\\*-03 12:00' \
        /etc/nixos/configuration.nix 2>&1 || true

      #@MNX-PART id=40.28.mnx-support-report.phase.report-complete kind=phase title="Phase: REPORT COMPLETE"
      section "REPORT COMPLETE"
      ${pkgs.coreutils}/bin/chown root:logbook "$OUT" 2>/dev/null || true
      ${pkgs.coreutils}/bin/chmod 0640 "$OUT" 2>/dev/null || true
      printf 'saved_report=%s\n' "$OUT"
      printf 'MNX_SUPPORT_REPORT_COMPLETE=yes\n'
      printf 'old_storage_written=no\n'
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            ;;
          '#!'*python*)
            ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
            ;;
          *)
            echo "unsupported generated-script interpreter: $first" >&2
            exit 1
            ;;
        esac
      '';
    };
  };

  # Conservative preflight for storage-heavy jobs. Recent current-boot
  # storage errors, missing mounts, or read-only mounts stop work. Btrfs device
  # counters are cumulative, so old non-zero values are recorded as a baseline
  # rather than creating a permanent maintenance lockout. Jobs call the matching
  # postflight helper under the same storage lock and fail if counters increase.
#@MNX-CHUNK id=40.29 slug=storage-flight-checks title="Shared storage preflight and postflight helpers"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-storage-preflight" section=40.29 role=generated-program ordinal=166
  environment.etc."monsternix/bin/mnx-storage-preflight" = {
    source = pkgs.writeTextFile {
      name = "mnx-storage-preflight";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      set -uo pipefail
      job="''${1:-storage-maintenance}"
      shift || true
      scary='Read-error on swap-device|I/O error|Input/output error|Identify namespace failed|Device not ready|Disabling device after reset failure|BTRFS.*(error|warning)|read-only file system|failed to read stream from kernel|Broken pipe'
      details=""
      cumulative=""
      problem=0
      state_dir=/run/monsternix/storage-preflight
      safe_job="$(printf '%s' "$job" | ${pkgs.gnused}/bin/sed -E 's/[^A-Za-z0-9_.-]+/_/g')"
      state="$state_dir/$safe_job.tsv"
      tmp="$state.$$"

      ${pkgs.coreutils}/bin/mkdir -p "$state_dir" || exit 75
      : > "$tmp" || exit 75
      trap '${pkgs.coreutils}/bin/rm -f "$tmp"' EXIT

      if ${pkgs.systemd}/bin/journalctl -b --since '30 minutes ago' -p warning..alert --no-pager 2>/dev/null | ${pkgs.gnugrep}/bin/grep -E -i "$scary" >/dev/null 2>&1; then
        problem=1
        details="$details recent current-boot storage incident strings;"
      fi

      for mp in "$@"; do
        [ -n "$mp" ] || continue
        if ! ${pkgs.util-linux}/bin/mountpoint -q "$mp"; then
          problem=1
          details="$details $mp not a mountpoint;"
          continue
        fi
        if ! ${pkgs.util-linux}/bin/findmnt -rn -no OPTIONS "$mp" | ${pkgs.gnugrep}/bin/grep -Eq '(^|,)rw(,|$)'; then
          problem=1
          details="$details $mp not read-write;"
        fi
        fstype="$(${pkgs.util-linux}/bin/findmnt -rn -no FSTYPE "$mp" 2>/dev/null || true)"
        if [ "$fstype" = "btrfs" ]; then
          if ! stats="$(${pkgs.btrfs-progs}/bin/btrfs device stats "$mp" 2>&1)"; then
            problem=1
            details="$details $mp Btrfs device stats unreadable;"
            continue
          fi
          set +e
          parsed="$(printf '%s\n' "$stats" | ${pkgs.gawk}/bin/awk -v mount="$mp" '
            match($0, /^\[([^]]+)\]\.([A-Za-z0-9_]+)[[:space:]]+([0-9]+)/, value) {
              printf "%s\t%s\t%s\t%s\n", mount, value[1], value[2], value[3]
              count++
            }
            END { exit count > 0 ? 0 : 1 }
          ')"
          parse_rc="$?"
          set -e
          if [ "$parse_rc" -ne 0 ] || [ -z "$parsed" ]; then
            problem=1
            details="$details $mp Btrfs counter tuples unreadable;"
            continue
          fi
          printf '%s\n' "$parsed" >> "$tmp"
        fi
      done

      ${pkgs.coreutils}/bin/sort -u -o "$tmp" "$tmp"
      cumulative="$(${pkgs.gawk}/bin/awk -F '\t' '$4 + 0 > 0 { printf " %s[%s].%s=%s;", $1, $2, $3, $4 }' "$tmp" 2>/dev/null || true)"

      if [ "$problem" -eq 1 ]; then
        msg="$job preflight refused maintenance:$details"
        ${pkgs.util-linux}/bin/logger -t mnx-storage-preflight -p daemon.warning -- "$msg" || true
        /etc/monsternix/bin/mnx-notify warning "Monsternix maintenance skipped" "$msg" || true
        ${pkgs.coreutils}/bin/rm -f "$tmp" "$state"
        trap - EXIT
        exit 75
      fi

      ${pkgs.coreutils}/bin/mv -f "$tmp" "$state"
      trap - EXIT
      if [ -n "$cumulative" ]; then
        ${pkgs.util-linux}/bin/logger -t mnx-storage-preflight -p daemon.notice -- \
          "$job continuing with cumulative Btrfs tuple baselines:$cumulative" || true
      fi
      exit 0
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            ;;
          '#!'*python*)
            ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
            ;;
          *)
            echo "unsupported generated-script interpreter: $first" >&2
            exit 1
            ;;
        esac
      '';
    };
  };

#@MNX-DEF path=environment.etc."monsternix/bin/mnx-storage-postflight" section=40.29 role=generated-program ordinal=167
  environment.etc."monsternix/bin/mnx-storage-postflight" = {
    source = pkgs.writeTextFile {
      name = "mnx-storage-postflight";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      set -uo pipefail
      job="''${1:-storage-maintenance}"
      state_dir=/run/monsternix/storage-preflight
      safe_job="$(printf '%s' "$job" | ${pkgs.gnused}/bin/sed -E 's/[^A-Za-z0-9_.-]+/_/g')"
      state="$state_dir/$safe_job.tsv"
      current="$state.current.$$"
      problem=0
      details=""

      if [ ! -f "$state" ] || [ -L "$state" ]; then
        msg="$job postflight has no safe counter baseline at $state"
        ${pkgs.util-linux}/bin/logger -t mnx-storage-postflight -p daemon.err -- "$msg" || true
        /etc/monsternix/bin/mnx-notify critical "Monsternix storage postflight failed" "$msg" || true
        exit 1
      fi

      : > "$current" || exit 1
      trap '${pkgs.coreutils}/bin/rm -f "$state" "$current"' EXIT
      mapfile -t mounts < <(${pkgs.coreutils}/bin/cut -f1 "$state" | ${pkgs.coreutils}/bin/sort -u)
      for mp in "''${mounts[@]}"; do
        [ -n "$mp" ] || continue
        if ! ${pkgs.util-linux}/bin/mountpoint -q "$mp"; then
          problem=1
          details="$details $mp became unmounted;"
          continue
        fi
        if ! stats="$(${pkgs.btrfs-progs}/bin/btrfs device stats "$mp" 2>&1)"; then
          problem=1
          details="$details $mp Btrfs device stats became unreadable;"
          continue
        fi
        set +e
        parsed="$(printf '%s\n' "$stats" | ${pkgs.gawk}/bin/awk -v mount="$mp" '
          match($0, /^\[([^]]+)\]\.([A-Za-z0-9_]+)[[:space:]]+([0-9]+)/, value) {
            printf "%s\t%s\t%s\t%s\n", mount, value[1], value[2], value[3]
            count++
          }
          END { exit count > 0 ? 0 : 1 }
        ')"
        parse_rc="$?"
        set -e
        if [ "$parse_rc" -ne 0 ] || [ -z "$parsed" ]; then
          problem=1
          details="$details $mp Btrfs counter tuples became unreadable;"
          continue
        fi
        printf '%s\n' "$parsed" >> "$current"
      done
      ${pkgs.coreutils}/bin/sort -u -o "$current" "$current"

      set +e
      comparison="$(${pkgs.gawk}/bin/awk -F '\t' '
        NR == FNR {
          key=$1 SUBSEP $2 SUBSEP $3
          before[key]=$4 + 0
          label[key]=$1 "[" $2 "]." $3
          next
        }
        {
          key=$1 SUBSEP $2 SUBSEP $3
          seen[key]=1
          if (!(key in before)) {
            printf "extra counter tuple appeared: %s[%s].%s=%s;", $1, $2, $3, $4
            bad=1
          } else if (($4 + 0) > before[key]) {
            printf "counter increased: %s %s->%s;", label[key], before[key], $4
            bad=1
          } else if (($4 + 0) < before[key]) {
            printf "counter decreased/reset during job: %s %s->%s;", label[key], before[key], $4
            bad=1
          }
        }
        END {
          for (key in before) {
            if (!(key in seen)) {
              printf "counter tuple disappeared: %s baseline=%s;", label[key], before[key]
              bad=1
            }
          }
          exit bad ? 1 : 0
        }
      ' "$state" "$current")"
      compare_rc="$?"
      set -e
      if [ "$compare_rc" -ne 0 ]; then
        problem=1
        details="$details $comparison"
      fi

      ${pkgs.coreutils}/bin/rm -f "$state" "$current"
      trap - EXIT
      if [ "$problem" -eq 1 ]; then
        msg="$job storage postflight failed:$details"
        ${pkgs.util-linux}/bin/logger -t mnx-storage-postflight -p daemon.err -- "$msg" || true
        /etc/monsternix/bin/mnx-notify critical "Monsternix storage postflight failed" "$msg" || true
        exit 1
      fi
      exit 0
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            ;;
          '#!'*python*)
            ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
            ;;
          *)
            echo "unsupported generated-script interpreter: $first" >&2
            exit 1
            ;;
        esac
      '';
    };
  };

#@MNX-CHUNK id=40.2A slug=failure-notification-delivery title="OnFailure notification delivery and operator usage notes"
#@MNX-DEF path=systemd.services."mnx-job-failure-notify@" section=40.2A role=service ordinal=168
  systemd.services."mnx-job-failure-notify@" = {
    description = "Notify and preserve history when a Monsternix unit fails (%i)";
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Group = "root";
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectSystem = "full";
      ProtectHome = "read-only";
      RestrictSUIDSGID = true;
      ReadWritePaths = [ "/var/lib/logbook" "/var/lib/monsternix" ];
      StandardOutput = "journal";
      StandardError = "journal";
      ExecStart = "${pkgs.writeShellScript "mnx-job-failure-notify" ''
        set -uo pipefail
        unit="''${1:-unknown.service}"
        /etc/monsternix/bin/mnx-unit-failure-record "$unit" || true
        case "$unit" in
          btrbk-main.service|btrbk-archive-to-new-storage.service|rsync-m16-new-to-old.service|m16-backup-m21.service|m16-restic-maintenance.service)
            echo "backup_notification=deferred-to-one-week-supervision unit=$unit" ;;
          *) /etc/monsternix/bin/mnx-notify critical "Monsternix job failed" "$unit failed; inspect with: journalctl -u $unit -b --no-pager" || true ;;
        esac
      ''} %i";
    };
  };

#@MNX-DEF path=environment.etc."monsternix/support-report-usage.txt".text section=40.2A role=generated-config ordinal=169
  environment.etc."monsternix/support-report-usage.txt".text = ''
    Canonical candidate evaluation after replacing /etc/nixos/configuration.nix:

      mnx test

    Bootstrap before the `mnx` dispatcher has ever been switched into the running system:

      sudo /etc/nixos/configuration.nix test

    Paste-ready ordinary support command:

