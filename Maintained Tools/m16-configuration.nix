              'host_state_mutated': False,
          }
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.block-extract kind=function title="Portable Python function block_extract"
      def block_extract(text: str, begin_re: re.Pattern[str], end_line: str, label: str) -> str:
          lines = text.splitlines(keepends=True)
          begins = [index for index, line in enumerate(lines) if begin_re.fullmatch(line.rstrip('\n'))]
          ends = [index for index, line in enumerate(lines) if line.rstrip('\n') == end_line]
          if len(begins) != 1 or len(ends) != 1 or begins[0] >= ends[0]:
              raise Error(f'expected exactly one ordered {label} block')
          return "".join(lines[begins[0]:ends[0] + 1])
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.block-replace kind=function title="Portable Python function block_replace"
      def block_replace(text: str, begin_re: re.Pattern[str], end_line: str, replacement: str, label: str) -> str:
          current = block_extract(text, begin_re, end_line, label)
          if not replacement.endswith('\n'):
              replacement += '\n'
          if replacement == current:
              return text
          if text.count(current) != 1:
              raise Error(f'{label} block does not resolve exactly once for replacement')
          return text.replace(current, replacement, 1)
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.capsule-block-validate kind=function title="Portable Python function capsule_block_validate"
      def capsule_block_validate(block: str, accepted: dict) -> dict:
          lines = block.splitlines()
          if len(lines) != 9:
              raise Error(f'candidate capsule must contain exactly nine lines: {len(lines)}')
          begin = BEGIN_RE.fullmatch(lines[0])
          if not begin or lines[-1] != '#@MNX-AMNESIA-END':
              raise Error('candidate capsule markers are malformed')
          fields: dict[str, str] = {}
          for line in lines[1:-1]:
              match = FIELD_RE.fullmatch(line)
              if not match or match.group(1) in fields:
                  raise Error(f'candidate capsule field is malformed or duplicate: {line}')
              fields[match.group(1)] = match.group(2)
          if list(fields) != ['AUTHORITY', 'STATE', 'INTENT', 'OPEN', 'NEXT', 'HOLD', 'OPERATOR']:
              raise Error('candidate capsule fields are missing or out of order')
          expected_stage = int(accepted['office_agenda']['after_acceptance_next_stage'])
          if int(begin.group(1)) != expected_stage:
              raise Error(f'candidate capsule stage must be {expected_stage}')
          if int(begin.group(2)) != accepted['candidate_stage'] or begin.group(3) != accepted['source_sha256']:
              raise Error('candidate capsule predecessor does not match the accepted packet source')
          operator = fields['OPERATOR']
          guarded_apply = re.search(r'(?<![A-Za-z0-9_-])mnx[ \t]+apply\b', operator) is not None
          explicit_test = re.search(r'(?<![A-Za-z0-9_-])mnx[ \t]+test\b', operator) is not None
          explicit_switch = re.search(r'(?<![A-Za-z0-9_-])mnx[ \t]+switch\b', operator) is not None
          if not (guarded_apply or (explicit_test and explicit_switch)):
              raise Error('candidate capsule lost every approved test-before-switch transaction entry')
          secret_re = re.compile(r'(-----BEGIN [A-Z ]*PRIVATE KEY-----|(?:password|passwd|token|api[_-]?key|authorization)\s*[:=])', re.I)
          for key, value in fields.items():
              if not value or len(value) > 1024 or '\r' in value or '\n' in value or secret_re.search(value):
                  raise Error(f'candidate capsule field is unsafe or invalid: {key}')
          return {
              'candidate_stage': expected_stage,
              'accepted_predecessor_stage': accepted['candidate_stage'],
              'accepted_predecessor_sha256': accepted['source_sha256'],
              'fields': fields,
              'sha256': sha256_bytes(block.encode('utf-8')),
          }
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.history-block-validate kind=function title="Portable Python function history_block_validate"
      def history_block_validate(block: str, accepted: dict) -> list[dict]:
          lines = block.splitlines()
          if len(lines) != 10 or lines[0] != '#@MNX-HISTORY-BEGIN schema=1 max_entries=8' or lines[-1] != '#@MNX-HISTORY-END':
              raise Error('candidate history ledger must contain one begin, eight records, and one end line')
          entries = []
          for line in lines[1:-1]:
              match = HISTORY_ENTRY_RE.fullmatch(line)
              if not match:
                  raise Error(f'candidate history record is malformed: {line}')
              entries.append({'stage': int(match.group(1)), 'source_sha256': match.group(2), 'closed_issue': match.group(3)})
          if entries != expected_history(accepted):
              raise Error('candidate history ledger is not the exact accepted-source rollover')
          return entries
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.workspace-apply-blocks kind=function title="Portable Python function workspace_apply_blocks"
      def workspace_apply_blocks(accepted: dict, value: str | None, payload: Path, mode: str) -> dict:
          workspace = workspace_load(value, accepted)
          try:
              replacement = payload.expanduser().read_text(encoding='utf-8')
          except OSError as exc:
              raise Error(f'candidate handoff block is unreadable: {payload}: {exc}') from exc
          candidate_text = workspace['candidate_path'].read_text(encoding='utf-8')
          changed: list[str] = []
          if mode in {'capsule', 'turn-close'}:
              capsule = block_extract(replacement, BEGIN_RE, '#@MNX-AMNESIA-END', 'replacement capsule')
              capsule_block_validate(capsule, accepted)
              candidate_text = block_replace(candidate_text, BEGIN_RE, '#@MNX-AMNESIA-END', capsule, 'candidate capsule')
              changed.append('capsule')
          if mode in {'history', 'turn-close'}:
              history = block_extract(replacement, HISTORY_BEGIN_RE, '#@MNX-HISTORY-END', 'replacement history')
              history_block_validate(history, accepted)
              candidate_text = block_replace(candidate_text, HISTORY_BEGIN_RE, '#@MNX-HISTORY-END', history, 'candidate history')
              changed.append('history')
          atomic_write(workspace['candidate_path'], candidate_text.encode('utf-8'), 0o600)
          return {
              'schema': 'mnx.cloudtainer.candidate-injection.v1',
              'status': 'applied',
              'workspace': str(workspace['root']),
              'changed_blocks': changed,
              'candidate_sha256': sha256_bytes(candidate_text.encode('utf-8')),
              'write_scope': 'workspace-candidate-only',
              'live_configuration_mutated': False,
              'network_used': False,
              'source_executed': False,
          }
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.marker-inventory kind=function title="Portable Python function marker_inventory"
      def marker_inventory(text: str) -> dict:
          patterns = {
              'chunks': r'(?m)^#@MNX-CHUNK ',
              'definitions': r'(?m)^#@MNX-DEF ',
              'parts': r'(?m)^\s*#@MNX-PART ',
              'flows': r'(?m)^#@MNX-FLOW ',
              'laws': r'(?m)^#@MNX-LAW ',
              'temporary_begin': r'(?m)^#@MNX-TEMP-BEGIN ',
              'temporary_end': r'(?m)^#@MNX-TEMP-END ',
          }
          return {key: len(re.findall(pattern, text)) for key, pattern in patterns.items()}
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.candidate-check kind=function title="Portable Python function candidate_check"
      def candidate_check(accepted: dict, value: str | None) -> dict:
          workspace = workspace_load(value, accepted)
          errors: list[str] = []
          warnings: list[str] = []
          candidate: dict | None = None
          try:
              candidate = parse(workspace['candidate_path'])
          except Error as exc:
              errors.append(f'candidate-source-parse:{exc}')
          expected_stage = int(accepted['office_agenda']['after_acceptance_next_stage'])
          if candidate is not None:
              if candidate['source_sha256'] == accepted['source_sha256']:
                  errors.append('candidate-source-is-byte-identical-to-accepted-source')
              if candidate['document_schema'] <= accepted['document_schema']:
                  errors.append('candidate-document-schema-did-not-advance')
              if candidate['candidate_stage'] != expected_stage:
                  errors.append(f'candidate-stage-is-not-{expected_stage}')
              if candidate['accepted_predecessor_stage'] != accepted['candidate_stage']:
                  errors.append('candidate-predecessor-stage-does-not-match-accepted-source')
              if candidate['accepted_predecessor_sha256'] != accepted['source_sha256']:
                  errors.append('candidate-predecessor-hash-does-not-match-accepted-source')
              if candidate['recent_history'] != expected_history(accepted):
                  errors.append('candidate-history-is-not-exact-rollover')
              ordinals = [item['ordinal'] for item in candidate['definitions']]
              if ordinals != list(range(1, len(ordinals) + 1)):
                  errors.append('candidate-definition-ordinals-are-not-contiguous')
              paths = [item['path'] for item in candidate['definitions']]
              if len(paths) != len(set(paths)):
                  errors.append('candidate-definition-paths-are-not-unique')
              _, _, candidate_text = read_source(workspace['candidate_path'])
              inventory = marker_inventory(candidate_text)
              if inventory['temporary_begin'] != inventory['temporary_end']:
                  errors.append('candidate-temporary-code-markers-are-unbalanced')
              if inventory['temporary_begin'] != 0:
                  errors.append('candidate-contains-switch-blocking-temporary-code')
              if candidate['counts']['definitions'] < accepted['counts']['definitions']:
                  errors.append('candidate-definition-inventory-shrank-without-explicit-review')
              if candidate['counts']['chunks'] < accepted['counts']['chunks']:
                  errors.append('candidate-chunk-inventory-shrank-without-explicit-review')
          else:
              inventory = {}
          if not shutil.which('nix-instantiate'):
              warnings.append('nix-parse-not-available-in-portable-cloudtainer-host-mnx-test-remains-authoritative')
          return {
              'schema': 'mnx.cloudtainer.candidate-check.v2',
              'status': 'pass' if not errors else 'fail',
              'workspace': str(workspace['root']),
              'workspace_manifest': workspace['workspace_manifest'],
              'accepted_source_sha256': accepted['source_sha256'],
              'accepted_stage': accepted['candidate_stage'],
              'expected_candidate_stage': expected_stage,
              'candidate_source_sha256': candidate['source_sha256'] if candidate else 'unavailable',
              'candidate_document_schema': candidate['document_schema'] if candidate else None,
              'candidate_stage': candidate['candidate_stage'] if candidate else None,
              'marker_inventory': inventory,
              'failure_count': len(errors),
              'failures': errors,
              'warning_count': len(warnings),
              'warnings': warnings,
              'host_validation_required': True,
              'authoritative_operator_commands': ['mnx test', 'mnx switch'],
              'network_used': False,
              'source_executed': False,
              'live_configuration_mutated': False,
          }
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.definition-hashes kind=function title="Portable Python function definition_hashes"
      def definition_hashes(record: dict) -> dict[str, dict]:
          _, _, text = read_source(Path(record['source']))
          lines = text.splitlines(keepends=True)
          definitions = sorted(record['definitions'], key=lambda item: item['line'])
          top_level_boundary = re.compile(r'^(?:#@MNX-(?:CHUNK|DEF|FLOW|LAW)\b|# MNX-END-OF-MONOLITH\b)')
          structural_starts = [index for index, line in enumerate(lines) if top_level_boundary.match(line)]
          result: dict[str, dict] = {}
          for index, item in enumerate(definitions):
              start = item['line'] - 1
              boundaries = [value for value in structural_starts if value > start]
              end = min(boundaries) if boundaries else len(lines)
              raw = "".join(lines[start:end]).encode('utf-8')
              result[item['path']] = {
                  'sha256': sha256_bytes(raw),
                  'bytes': len(raw),
                  'role': item['role'],
                  'section': item['section'],
                  'ordinal': item['ordinal'],
              }
          return result
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.diff-stats kind=function title="Portable Python function diff_stats"
      def diff_stats(before: str, after: str) -> dict:
          left = before.splitlines()
          right = after.splitlines()
          added = 0
          removed = 0
          replaced = 0
          for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(a=left, b=right, autojunk=False).get_opcodes():
              if tag == 'insert':
                  added += j2 - j1
              elif tag == 'delete':
                  removed += i2 - i1
              elif tag == 'replace':
                  removed += i2 - i1
                  added += j2 - j1
                  replaced += 1
          return {'added_lines': added, 'removed_lines': removed, 'replace_hunks': replaced}
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.candidate-review kind=function title="Portable Python function candidate_review"
      def candidate_review(accepted: dict, value: str | None) -> dict:
