              normal_pid="$("''${user_systemctl[@]}" show presslog.service -p MainPID --value 2>/dev/null || true)"
              normal_result="$("''${user_systemctl[@]}" show presslog.service -p Result --value 2>/dev/null || true)"
              burn_active="$("''${user_systemctl[@]}" show presslog-burn.service -p ActiveState --value 2>/dev/null || true)"
              burn_pid="$("''${user_systemctl[@]}" show presslog-burn.service -p MainPID --value 2>/dev/null || true)"
              burn_result="$("''${user_systemctl[@]}" show presslog-burn.service -p Result --value 2>/dev/null || true)"
              [[ "$normal_pid" =~ ^[0-9]+$ ]] || normal_pid=0
              [[ "$burn_pid" =~ ^[0-9]+$ ]] || burn_pid=0
              if [[ "$normal_active" == inactive && "$normal_pid" == 0 && "$normal_result" == success && "$burn_active" == inactive && "$burn_pid" == 0 && "$burn_result" == success ]]; then break; fi
              ${pkgs.coreutils}/bin/sleep 1
            done
            if [[ "$normal_active" != inactive || "$normal_pid" != 0 || "$normal_result" != success || "$burn_active" != inactive || "$burn_pid" != 0 || "$burn_result" != success ]]; then
              printf 'presslog_recovery_qualification_failure_cleanup=clean-idle-proof-failed normal=%q:%q:%q burn=%q:%q:%q\nMNX_PRESSLOG_RECOVERY_QUALIFICATION=FAIL_CONTRACT\n' "$normal_active" "$normal_pid" "$normal_result" "$burn_active" "$burn_pid" "$burn_result" >&2
              exit 2
            fi
            printf 'presslog_recovery_qualification_failure_cleanup=clean-idle\n'
          fi

          for attempt in $(${pkgs.coreutils}/bin/seq 1 120); do
            : >"$observer_out"
            : >"$observer_err"
            observer_settled=no
            if /etc/monsternix/bin/mnx-presslog-observe observe >"$observer_out" 2>"$observer_err"; then observer_rc=0; else observer_rc=$?; fi
            observer_json="$(${pkgs.gnused}/bin/sed -n '1p' "$observer_out")"
            if [[ "$observer_rc" == 0 || "$observer_rc" == 76 ]] &&
               ${pkgs.jq}/bin/jq -e 'select(.schema=="mnx.presslog.current.v2" and (.recovery_drill|type)=="object" and .recovery_drill.schema=="mnx.presslog.recovery-drill.v1" and .status_snapshot_semantics=="opened-fd-consistent-atomic-path-replacement-accepted" and (.status_snapshot_replaced_during_read|type)=="boolean" and .content_inspected==false and .private_material_read==false and .journal_payload_read==false and .network_used==false)' <<<"$observer_json" >/dev/null 2>&1; then
              receipt_outcome="$(${pkgs.jq}/bin/jq -r '.recovery_drill.outcome // ""' <<<"$observer_json")"
              if [[ "$receipt_outcome" == "$expected_receipt" ]]; then
                if [[ "$expected_receipt" == pass ]]; then
                  if ${pkgs.jq}/bin/jq -e '
                    select(
                      .armed==true and .service_active==true and .service_failed==false and .burn_active==false and
                      .normal_service.active=="active" and .normal_service.result=="success" and
                      .paused=="true" and .auto_expire=="false" and .active_segment_reported==true and
                      .heartbeat_current_boot==true and .heartbeat.status=="paused" and .heartbeat.paused==true and
                      .heartbeat.service_active==true and .heartbeat.service_result=="success" and
                      .heartbeat.status_pid_matches==true and .heartbeat.recorder_pid>0 and
                      .heartbeat_age_seconds>=0 and .heartbeat_age_seconds<=120 and .unsafe_object_count==0 and
                      .recovery_drill.phase=="complete" and .recovery_drill.disposable_state_removed==true and
                      ([.review_reasons[] | select(.!="backup-coverage-overdue")] | length)==0
                    )' <<<"$observer_json" >/dev/null 2>&1; then observer_settled=yes; fi
                elif ${pkgs.jq}/bin/jq -e '
                  select(
                    .burn_active==false and .service_failed==false and .unsafe_object_count==0 and
                    .service_active==false and .normal_service.active=="inactive" and .normal_service.result=="success" and
                    .recovery_drill.outcome=="fail" and .recovery_drill.disposable_state_removed==true
                  )' <<<"$observer_json" >/dev/null 2>&1; then observer_settled=yes; fi
              fi
            fi
            if [[ "$observer_settled" == yes ]]; then observer_ready=yes; break; fi
            ${pkgs.coreutils}/bin/sleep 1
          done

          if [[ "$observer_ready" != yes ]]; then
            ${pkgs.gnugrep}/bin/grep -E '^(MNX_PRESSLOG_OBSERVER=|mnx_presslog_observer_)' "$observer_err" >&2 || true
            printf 'presslog_recovery_qualification_observer_contract=receipt-not-published expected=%s rc=%s\nMNX_PRESSLOG_RECOVERY_QUALIFICATION=FAIL_CONTRACT\n' "$expected_receipt" "$observer_rc" >&2
            exit 2
          fi
          receipt_current="$(${pkgs.coreutils}/bin/stat -c '%d:%i:%u:%g:%a:%h:%s:%Y' "$receipt_path" 2>/dev/null || true)"
          if [[ "$receipt_current" != "$receipt_after" ]]; then
            printf 'presslog_recovery_qualification_receipt_stability=changed-after-command expected=%q observed=%q\nMNX_PRESSLOG_RECOVERY_QUALIFICATION=FAIL_CONTRACT\n' "$receipt_after" "$receipt_current" >&2
            exit 2
          fi
          printf 'presslog_recovery_qualification_receipt_stability=pass\n'

          if [[ "$observer_rc" == 0 ]]; then
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_PRESSLOG_OBSERVER=PASS' "$observer_out" || {
              echo 'presslog_recovery_qualification_observer_contract=missing-pass-marker' >&2
              echo 'MNX_PRESSLOG_RECOVERY_QUALIFICATION=FAIL_CONTRACT' >&2
              exit 2
            }
          else
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_PRESSLOG_OBSERVER=REVIEW_PUBLISHED_STATE' "$observer_err" || {
              echo 'presslog_recovery_qualification_observer_contract=missing-review-marker' >&2
              echo 'MNX_PRESSLOG_RECOVERY_QUALIFICATION=FAIL_CONTRACT' >&2
              exit 2
            }
          fi

          normal_pid="$("''${user_systemctl[@]}" show presslog.service -p MainPID --value 2>/dev/null || true)"
          [[ "$normal_pid" =~ ^[1-9][0-9]*$ ]] || normal_pid=0

          if (( drill_rc == 0 )); then
            if ! ${pkgs.jq}/bin/jq -e --argjson pid "$normal_pid" --arg archive "$drill_archive" --arg archive_sha "$drill_archive_sha" '
              select(
                .armed==true and .service_active==true and .service_failed==false and .burn_active==false and
                .normal_service.active=="active" and .normal_service.result=="success" and
                .paused=="true" and .auto_expire=="false" and .active_segment_reported==true and
                .heartbeat_current_boot==true and .heartbeat.status=="paused" and .heartbeat.paused==true and
                .heartbeat.service_active==true and .heartbeat.service_result=="success" and
                .heartbeat.status_pid_matches==true and .heartbeat.recorder_pid==$pid and
                .heartbeat_age_seconds>=0 and .heartbeat_age_seconds<=120 and .unsafe_object_count==0 and
                .recovery_drill.outcome=="pass" and .recovery_drill.phase=="complete" and
                .recovery_drill.recorder_active_before==false and .recovery_drill.recorder_paused_before==false and
                .recovery_drill.original_deep_verified==true and .recovery_drill.encrypted_archive_created==true and
                .recovery_drill.disposable_import_completed==true and .recovery_drill.disposable_deep_verified==true and
                .recovery_drill.disposable_state_removed==true and .recovery_drill.recorder_active_restored==false and
                .recovery_drill.recorder_paused_restored==false and .recovery_drill.interrupted==false and
                .recovery_drill.plaintext_exported==false and .recovery_drill.journal_content_printed==false and
                .recovery_drill.password_recorded==false and .recovery_drill.network_used==false and
                .recovery_drill.archive==$archive and .recovery_drill.archive_sha256==$archive_sha and
                ([.review_reasons[] | select(.!="backup-coverage-overdue")] | length)==0
              )' <<<"$observer_json" >/dev/null; then
              echo 'presslog_recovery_qualification_success_proof=failed' >&2
              echo 'MNX_PRESSLOG_RECOVERY_QUALIFICATION=FAIL_CONTRACT' >&2
              exit 2
            fi
            printf 'presslog_recovery_qualification_receipt=pass\npresslog_recovery_qualification_phase=complete\npresslog_recovery_qualification_archive_metadata=%s\npresslog_recovery_qualification_archive_content_read=false\npresslog_recovery_qualification_archive_hash_recomputed_by_switch=false\npresslog_recovery_qualification_observer_content_inspected=false\npresslog_recovery_qualification_restored_pid=%s\npresslog_recovery_qualification_restored_paused=true\npresslog_recovery_qualification_baseline_was_clean_idle=true\nmanual_resume_required=true\nMNX_PRESSLOG_RECOVERY_QUALIFICATION=PASS\n' "$archive_meta" "$normal_pid"
            exit 0
          fi

          phase="$(${pkgs.jq}/bin/jq -r '.recovery_drill.phase // "unknown"' <<<"$observer_json")"
          if ! ${pkgs.jq}/bin/jq -e '
            select(
              .burn_active==false and .service_failed==false and .unsafe_object_count==0 and
              .service_active==false and .normal_service.active=="inactive" and .normal_service.result=="success" and
              .recovery_drill.outcome=="fail" and .recovery_drill.disposable_state_removed==true and
              .recovery_drill.plaintext_exported==false and .recovery_drill.journal_content_printed==false and
              .recovery_drill.password_recorded==false and .recovery_drill.network_used==false and
              (.armed==true or .armed==false)
            )' <<<"$observer_json" >/dev/null; then
            echo 'presslog_recovery_qualification_failure_state_proof=failed' >&2
            echo 'MNX_PRESSLOG_RECOVERY_QUALIFICATION=FAIL_CONTRACT' >&2
            exit 2
          fi
          if [[ "$drill_rc" == 65 && "$phase" == verify-original ]]; then
            final_failure_class=original-authentication-boundary-rc65-exhausted
          else
            final_failure_class=nonretryable-drill-failure
          fi
          printf 'presslog_recovery_qualification_receipt=fail\npresslog_recovery_qualification_failure_phase=%s\npresslog_recovery_qualification_failure_class=%s\npresslog_recovery_qualification_original_rc=%s\npresslog_recovery_qualification_attempts_used=%s\npresslog_recovery_qualification_content_inspected=false\nmanual_resume_required=true\n' "$phase" "$final_failure_class" "$drill_rc" "$recovery_attempt" >&2
          case "$drill_rc" in
            124|130|137|143)
              echo 'MNX_PRESSLOG_RECOVERY_QUALIFICATION=DEFERRED' >&2
              exit 75
              ;;
            *)
              echo 'MNX_PRESSLOG_RECOVERY_QUALIFICATION=BLOCKED' >&2
              exit 76
              ;;
          esac
        )
      }

      #@MNX-PART id=99.20.mnx-switch.function.run-post-acceptance-plan kind=function title="Function run_post_acceptance_plan"
      run_post_acceptance_plan() {
        local root=/var/lib/monsternix/post-acceptance receipt tmp action rc=0 blocker=0 deferred=0 contract_violation=0 skip_to_cloudtainer=0
        local before_running before_default before_source before_active before_default_sha before_old_mode
        local after_running after_default after_source after_active after_default_sha after_old_mode after_state
        local actions=() results=()

        load_post_acceptance_plan "$CFG" || return 2
        printf 'post_acceptance_plan=%s\n' "$POST_ACCEPTANCE_PLAN"
        if [[ "$POST_ACCEPTANCE_PLAN" == none ]]; then
          POST_ACCEPTANCE_STATUS=none
          POST_ACCEPTANCE_RC=0
          POST_ACCEPTANCE_ACTION_RESULTS=none
          POST_ACCEPTANCE_MUTATION_PROOF=pass
          echo 'MNX_POST_ACCEPTANCE=NONE'
          return 0
        fi

        install -d -o root -g logbook -m 0750 "$root"
        receipt="$root/$SOURCE_SHA.txt"
        POST_ACCEPTANCE_RECEIPT="$receipt"
        if (( POST_ACCEPTANCE_FORCE == 0 )) && secure_evidence_file "$receipt" &&
           grep -Fxq "source_sha256=$SOURCE_SHA" "$receipt" 2>/dev/null &&
           grep -Fxq "plan=$POST_ACCEPTANCE_PLAN" "$receipt" 2>/dev/null &&
           grep -Fxq 'status=pass' "$receipt" 2>/dev/null
        then
          POST_ACCEPTANCE_STATUS=already-recorded
          POST_ACCEPTANCE_RC=0
          POST_ACCEPTANCE_ACTION_RESULTS="$(field_from_file "$receipt" action_results)"
          POST_ACCEPTANCE_MUTATION_PROOF="$(field_from_file "$receipt" mutation_proof)"
          [[ -n "$POST_ACCEPTANCE_ACTION_RESULTS" ]] || POST_ACCEPTANCE_ACTION_RESULTS=unknown
          [[ -n "$POST_ACCEPTANCE_MUTATION_PROOF" ]] || POST_ACCEPTANCE_MUTATION_PROOF=unknown
          cat "$receipt"
          echo 'MNX_POST_ACCEPTANCE=ALREADY_RECORDED'
          return 0
        fi

        before_running="$(readlink -f /run/current-system 2>/dev/null || true)"
        before_default="$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
        before_source="$(sha256sum "$CFG" 2>/dev/null | cut -d' ' -f1 || true)"
        before_active="$(sha256sum /run/current-system/configuration.nix 2>/dev/null | cut -d' ' -f1 || true)"
        before_default_sha="$(sha256sum "$before_default/configuration.nix" 2>/dev/null | cut -d' ' -f1 || true)"
        before_old_mode="$(findmnt -rn -T /mnt/m16-old-storage -o OPTIONS 2>/dev/null | awk 'BEGIN{m="unresolved"} /(^|,)ro(,|$)/{m="ro"} /(^|,)rw(,|$)/{m="rw"} END{print m}')"
        [[ "$before_running" == "$before_default" && "$before_source" == "$SOURCE_SHA" &&
           "$before_active" == "$SOURCE_SHA" && "$before_default_sha" == "$SOURCE_SHA" && "$before_old_mode" == ro ]] || {
          echo 'MNX_POST_ACCEPTANCE_ERROR: accepted-state preflight failed' >&2
          return 2
        }

        : > "$POST_ACCEPTANCE_LOG"
        chown root:logbook "$POST_ACCEPTANCE_LOG" 2>/dev/null || true
        chmod 0640 "$POST_ACCEPTANCE_LOG" 2>/dev/null || true
        IFS=, read -r -a actions <<< "$POST_ACCEPTANCE_PLAN"
        for action in "''${actions[@]}"; do
          if (( skip_to_cloudtainer == 1 )) && [[ "$action" != cloudtainer-pack ]]; then
            results+=("$action:skipped-after-restic-maintenance-blocker")
            printf 'post_acceptance_action_skipped=%s reason=restic-maintenance-blocker\n' "$action" | tee -a "$POST_ACCEPTANCE_LOG"
            continue
          fi
          printf '\n################################################################################\n# MNX POST-ACCEPTANCE ACTION — %s\n################################################################################\n' "$action" | tee -a "$POST_ACCEPTANCE_LOG"
          case "$action" in
            m21-source-inventory)
              if (
                set +e
                MNX_OFFICE_POST_COMMIT_SEAL=1 /etc/monsternix/bin/mnx-office m21-source-inventory --switch-owned 2>&1 | tee -a "$POST_ACCEPTANCE_LOG"
                exit "''${PIPESTATUS[0]}"
              ); then
                rc=0
              else
                rc="$?"
              fi
              ;;
            presslog-rearm)
              if (
                set +e
                run_presslog_rearm_action 2>&1 | tee -a "$POST_ACCEPTANCE_LOG"
                exit "''${PIPESTATUS[0]}"
              ); then
                rc=0
              else
                rc="$?"
              fi
              ;;
            presslog-recovery-qualify)
              if (
                set +e
                run_presslog_recovery_qualify_action 2>&1 | tee -a "$POST_ACCEPTANCE_LOG"
                exit "''${PIPESTATUS[0]}"
              ); then
                rc=0
              else
                rc="$?"
              fi
              ;;
            desktop-audit)
              if (
                set +e
                MNX_OFFICE_POST_COMMIT_SEAL=1 MNX_CONFIG="$CFG" /etc/monsternix/bin/mnx desktop audit 2>&1 | tee -a "$POST_ACCEPTANCE_LOG"
                exit "''${PIPESTATUS[0]}"
              ); then
                rc=0
              else
                rc="$?"
              fi
              ;;
            upgrade-build)
              if (
                set +e
                MNX_OFFICE_POST_COMMIT_SEAL=1 MNX_CONFIG="$CFG" /etc/monsternix/bin/mnx upgrade build 2>&1 | tee -a "$POST_ACCEPTANCE_LOG"
                exit "''${PIPESTATUS[0]}"
              ); then
                rc=0
              else
                rc="$?"
              fi
              ;;
            restic-adopt-existing)
              if (
                set +e
                MNX_OFFICE_POST_COMMIT_SEAL=1 MNX_CONFIG="$CFG" /etc/monsternix/bin/mnx restic enroll adopt-existing --switch-owned 2>&1 | tee -a "$POST_ACCEPTANCE_LOG"
                exit "''${PIPESTATUS[0]}"
              ); then
                rc=0
              else
                rc="$?"
              fi
              ;;
            restic-qualify-first-pair)
              if (
                set +e
                MNX_OFFICE_POST_COMMIT_SEAL=1 MNX_CONFIG="$CFG" /etc/monsternix/bin/mnx restic qualify first-pair --switch-owned 2>&1 | tee -a "$POST_ACCEPTANCE_LOG"
                exit "''${PIPESTATUS[0]}"
              ); then
                rc=0
              else
                rc="$?"
              fi
              ;;
            restic-qualify-and-enable)
              if (
                set +e
                MNX_OFFICE_POST_COMMIT_SEAL=1 MNX_CONFIG="$CFG" /etc/monsternix/bin/mnx restic qualify complete-and-enable --switch-owned 2>&1 | tee -a "$POST_ACCEPTANCE_LOG"
                exit "''${PIPESTATUS[0]}"
              ); then
                rc=0
              else
                rc="$?"
              fi
              ;;
            restic-maintenance-recover)
              if (
                set +e
                MNX_OFFICE_POST_COMMIT_SEAL=1 MNX_CONFIG="$CFG" /etc/monsternix/bin/mnx restic maintenance-recover --switch-owned 2>&1 | tee -a "$POST_ACCEPTANCE_LOG"
                exit "''${PIPESTATUS[0]}"
              ); then
                rc=0
              else
                rc="$?"
              fi
              ;;
            restic-backup-reconcile)
              if (
                set +e
                MNX_OFFICE_POST_COMMIT_SEAL=1 MNX_CONFIG="$CFG" /etc/monsternix/bin/mnx restic backup-reconcile --switch-owned 2>&1 | tee -a "$POST_ACCEPTANCE_LOG"
                exit "''${PIPESTATUS[0]}"
              ); then
                rc=0
              else
                rc="$?"
              fi
              ;;
            journal-integrity-anchor)
              if (
                set +e
                MNX_OFFICE_POST_COMMIT_SEAL=1 MNX_CONFIG="$CFG" /etc/monsternix/bin/mnx incident journal anchor --switch-owned 2>&1 | tee -a "$POST_ACCEPTANCE_LOG"
                exit "''${PIPESTATUS[0]}"
              ); then
                rc=0
              else
                rc="$?"
              fi
              ;;
            journal-integrity-recover-forward)
              if (
                set +e
                MNX_OFFICE_POST_COMMIT_SEAL=1 MNX_CONFIG="$CFG" /etc/monsternix/bin/mnx incident journal recover-forward --switch-owned 2>&1 | tee -a "$POST_ACCEPTANCE_LOG"
                recover_rc="''${PIPESTATUS[0]}"
                set -e
                if [[ "$recover_rc" -ne 0 ]]; then
                  exit "$recover_rc"
                fi

                echo '--- accepted journal observer proof after clean-forward recovery ---' | tee -a "$POST_ACCEPTANCE_LOG"
                if ! systemctl reset-failed logbook-journal-verify.service 2>&1 | tee -a "$POST_ACCEPTANCE_LOG"; then
                  echo 'MNX_JOURNAL_OBSERVER_PROOF=FAIL_RESET_BOOKKEEPING' | tee -a "$POST_ACCEPTANCE_LOG" >&2
                  exit 1
                fi
                set +e
                systemctl start logbook-journal-verify.service 2>&1 | tee -a "$POST_ACCEPTANCE_LOG"
                observer_start_rc="''${PIPESTATUS[0]}"
                set -e
                systemctl show logbook-journal-verify.service --no-pager -p LoadState -p ActiveState -p SubState -p Result -p ExecMainCode -p ExecMainStatus -p ExecMainStartTimestamp -p ExecMainExitTimestamp -p FragmentPath 2>&1 | tee -a "$POST_ACCEPTANCE_LOG" || true
                echo '--- logbook namespace observer journal ---' | tee -a "$POST_ACCEPTANCE_LOG"
                journalctl --namespace=logbook -u logbook-journal-verify.service -b --no-pager -o short-iso -n 260 2>&1 | tee -a "$POST_ACCEPTANCE_LOG" || true
                echo '--- default namespace observer journal ---' | tee -a "$POST_ACCEPTANCE_LOG"
                journalctl -u logbook-journal-verify.service -b --no-pager -o short-iso -n 120 2>&1 | tee -a "$POST_ACCEPTANCE_LOG" || true
                if [[ "$observer_start_rc" -ne 0 ]]; then
                  printf 'journal_observer_start_rc=%s\n' "$observer_start_rc" | tee -a "$POST_ACCEPTANCE_LOG" >&2
                  echo 'MNX_JOURNAL_OBSERVER_PROOF=BLOCKED_CONTROLLER_FAILURE' | tee -a "$POST_ACCEPTANCE_LOG" >&2
                  exit 76
                fi

                observer_load="$(systemctl show logbook-journal-verify.service --property=LoadState --value 2>/dev/null || true)"
                observer_active="$(systemctl show logbook-journal-verify.service --property=ActiveState --value 2>/dev/null || true)"
                observer_sub="$(systemctl show logbook-journal-verify.service --property=SubState --value 2>/dev/null || true)"
                observer_result="$(systemctl show logbook-journal-verify.service --property=Result --value 2>/dev/null || true)"
                observer_code="$(systemctl show logbook-journal-verify.service --property=ExecMainCode --value 2>/dev/null || true)"
                observer_status="$(systemctl show logbook-journal-verify.service --property=ExecMainStatus --value 2>/dev/null || true)"
                if [[ "$observer_load" != loaded || "$observer_active" != inactive || "$observer_sub" != dead || "$observer_result" != success || "$observer_code" != 1 || "$observer_status" != 0 ]]; then
                  printf 'journal_observer_postcondition=blocked load=%q active=%q sub=%q result=%q code=%q status=%q\n' "$observer_load" "$observer_active" "$observer_sub" "$observer_result" "$observer_code" "$observer_status" | tee -a "$POST_ACCEPTANCE_LOG" >&2
                  echo 'MNX_JOURNAL_OBSERVER_PROOF=BLOCKED_POSTCONDITION' | tee -a "$POST_ACCEPTANCE_LOG" >&2
                  exit 76
                fi

                observer_state=/var/lib/monsternix/journal-integrity/current.json
                if [[ ! -f "$observer_state" || -L "$observer_state" || "$(stat -Lc '%U:%G %a' "$observer_state" 2>/dev/null || true)" != 'root:logbook 640' ]]; then
                  echo 'MNX_JOURNAL_OBSERVER_PROOF=BLOCKED_STATE_METADATA' | tee -a "$POST_ACCEPTANCE_LOG" >&2
                  exit 76
                fi
                expected_source="$(sha256sum "$CFG" | awk '{print $1}')"
                expected_system="$(readlink -f /run/current-system)"
                if ! jq -e --arg source "$expected_source" --arg system "$expected_system" 'select(.schema=="mnx.journal-integrity.v4" and .policy.verification_model=="closed-archive-verify-active-query-v1" and .policy.active_journal_verify_run==false and .policy.archived_journal_verify_run==true and .policy.active_journal_query_run==true and .policy.namespace_wide_verify_run==false and .policy.namespace_identity_stability_checked==true and .policy.observation_max_attempts==3 and .source.sha256==$source and .source.running_system==$system and .source.boot_default_system==$system and .recovery_boundary.present==false and .clean_forward.ok==true and .clean_forward.new_problem_count==0 and (.clean_forward.status=="legacy-damage-only" or .clean_forward.status=="legacy-damage-no-longer-observed" or .clean_forward.status=="known-archived-damage-clean-forward" or .clean_forward.status=="known-damage-no-longer-observed-clean-forward" or .clean_forward.status=="clean") and (.overall_status=="clean" or .overall_status=="review-required") and ([.namespaces[] | select(.namespace=="default" or .namespace=="logbook") | (.verification_model=="closed-archive-verify-active-query-v1" and .active_journal_verify_run==false and .namespace_identity_stability_checked==true and (.observation_attempt_count>=1 and .observation_attempt_count<=3))] | length==2 and all))' "$observer_state" >/dev/null; then
                  echo '--- current journal observer state ---' | tee -a "$POST_ACCEPTANCE_LOG"
                  sed -n '1,260p' "$observer_state" | tee -a "$POST_ACCEPTANCE_LOG" || true
                  echo 'MNX_JOURNAL_OBSERVER_PROOF=BLOCKED_STATE_CONTRACT' | tee -a "$POST_ACCEPTANCE_LOG" >&2
                  exit 76
                fi
                observer_system_state="$(systemctl is-system-running 2>/dev/null || true)"
                observer_failed="$(systemctl --failed --no-legend --plain 2>/dev/null | grep -Ev '^[[:space:]]*$|^[0-9]+ loaded units listed[.]$' || true)"
                printf 'journal_observer_system_state=%s\n' "$observer_system_state" | tee -a "$POST_ACCEPTANCE_LOG"
                printf 'journal_observer_failed_units=%s\n' "''${observer_failed:-none}" | tee -a "$POST_ACCEPTANCE_LOG"
                if [[ "$observer_system_state" != running || -n "$observer_failed" ]]; then
                  echo 'MNX_JOURNAL_OBSERVER_PROOF=BLOCKED_SYSTEM_STATE' | tee -a "$POST_ACCEPTANCE_LOG" >&2
                  exit 76
                fi
