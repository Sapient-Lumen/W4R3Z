#@MNX-PART id=90.00.monsterdesk.function.f074a-live-acceptance kind=function title="Python function live_acceptance"
def live_acceptance() -> int:
    if os.getuid() != USER_UID or Path.home() != USER_HOME:
        raise MonsterdeskError(f"live acceptance must run as {USER_NAME} uid {USER_UID}")
    if instance_name() != "main":
        raise MonsterdeskError("live acceptance must begin from the main instance context")
    if os.environ.get("MNX_MONSTERDESK_LIVE_ACCEPTANCE") != "1":
        raise MonsterdeskError("live acceptance requires candidate-owned mnx test authority")
    main_socket = runtime_base() / "monsterdesk" / "control.sock"
    try:
        main_before_stat = main_socket.lstat()
    except FileNotFoundError:
        main_socket_before: dict[str, Any] = {"present": False}
    else:
        if stat.S_ISLNK(main_before_stat.st_mode) or not stat.S_ISSOCK(main_before_stat.st_mode):
            raise MonsterdeskError("main Monsterdesk control path is not an owned socket")
        main_socket_before = {
            "present": True,
            "device": int(main_before_stat.st_dev),
            "inode": int(main_before_stat.st_ino),
            "uid": int(main_before_stat.st_uid),
            "gid": int(main_before_stat.st_gid),
            "mode": stat.S_IMODE(main_before_stat.st_mode),
        }
    existing_qbittorrent_cutover_receipt = load_qbittorrent_cutover_receipt()
    if existing_qbittorrent_cutover_receipt is not None:
        raise MonsterdeskError(
            "qBittorrent zero-downtime hold found a persistent cutover receipt and refused to start a second client"
        )
    persistent_qbittorrent_before: dict[str, Any] | None = None
    persistent_qbittorrent_after: dict[str, Any] | None = None
    qbittorrent_legacy_entry = ensure_family_qbittorrent_available()
    qbittorrent_preflight = inspect_qbittorrent_boundary(
        USER_HOME, expected_uid=USER_UID, include_runtime=True
    )
    qbittorrent_qualification = qualify_qbittorrent_cutover(qbittorrent_preflight)
    if (qbittorrent_legacy_entry.get("qualified") is not True
            or qbittorrent_legacy_entry.get("healthy_client_stopped") is not False
            or qbittorrent_preflight.get("live", {}).get("process_count") != 1
            or qbittorrent_qualification.get("cutover_plan", {}).get("ready_for_rollback_rehearsal") is not True):
        raise MonsterdeskError("qBittorrent family availability or nondisruptive qualification evidence is incomplete")
    existing_cutover_receipt = load_nicotine_cutover_receipt()
    persistent_cutover_before: dict[str, Any] | None = None
    persistent_cutover_after: dict[str, Any] | None = None
    legacy_entry: dict[str, Any] = {}
    stale_recovery: dict[str, Any] = {}
    if existing_cutover_receipt is None:
        try:
            recovery_lock_fd = acquire_nicotine_cutover_lock()
        except BlockingIOError as exc:
            raise MonsterdeskError("another Nicotine cutover or launcher owns the recovery lock") from exc
        try:
            stale_recovery = cleanup_stale_nicotine_cutover_processes()
            legacy_entry = ensure_legacy_nicotine_running()
        finally:
            release_nicotine_cutover_lock(recovery_lock_fd)
        nicotine_preflight = inspect_nicotine_boundary(USER_HOME, expected_uid=USER_UID, include_runtime=True)
        nicotine_network = qualify_nicotine_network(nicotine_preflight)
        acceptance_mode = "pre-commit-rollback-rehearsal"
    else:
        persistent_cutover_before = verify_committed_nicotine_cutover()
        nicotine_preflight = inspect_nicotine_boundary(USER_HOME, expected_uid=USER_UID, include_runtime=False)
        nicotine_network = {
            "schema": "mnx.nicotine.accepted-cutover-runtime.v1",
            "authority": "accepted-receipt-plus-candidate-owned-mnx-test",
            "source_preflight_schema": nicotine_preflight.get("schema"),
            "persistent_cutover": persistent_cutover_before,
            "router_mapping_policy": "external-manual-no-source-owned-mutation",
            "network_api_or_tool_invoked": False,
            "external_reachability_probed": False,
            "remote_peer_endpoints_read": False,
            "share_contents_read": False,
            "host_state_mutated": False,
        }
        acceptance_mode = "accepted-cutover-idempotent-runtime-validation"
    nicotine_cutover_rehearsal: dict[str, Any] = {}
    qbittorrent_cutover_rehearsal: dict[str, Any] = {}
    prior_instance = os.environ.get("MONSTERDESK_INSTANCE")
    acceptance_instance = f"acceptance-{os.getpid()}-{secrets.token_hex(4)}"
    os.environ["MONSTERDESK_INSTANCE"] = acceptance_instance
    session: Session | None = None
    server_thread: threading.Thread | None = None
    acceptance_state: Path | None = None
    summary: dict[str, Any] = {
        "schema": "mnx.monsterdesk.live-acceptance.v10",
        "version": VERSION,
        "instance": acceptance_instance,
        "authority": "standing-p2p-security-delegation-plus-candidate-owned-mnx-test",
        "main_instance_socket_before": main_socket_before,
        "host_desktop_controlled": False,
        "network_mode": ("network-disabled-gui-preflight-plus-nondisruptive-qbittorrent-local-qualification"
                         if existing_cutover_receipt is None
                         else "network-disabled-gui-preflight-plus-accepted-persistent-nicotine-validation"),
        "acceptance_mode": acceptance_mode,
        "accepted_cutover_present": existing_cutover_receipt is not None,
        "nicotine_preflight_schema": nicotine_preflight.get("schema"),
        "nicotine_network_schema": nicotine_network.get("schema"),
        "qbittorrent_preflight_schema": qbittorrent_preflight.get("schema"),
        "qbittorrent_qualification_schema": qbittorrent_qualification.get("schema"),
        "qbittorrent_cutover_executed": False,
        "qbittorrent_rehearsal_required": False,
        "qbittorrent_zero_downtime_hold": True,
    }
    summary["qbittorrent_family_availability"] = {
        "qualified": qbittorrent_legacy_entry.get("qualified") is True,
        "legacy_already_running": qbittorrent_legacy_entry.get("legacy_already_running") is True,
        "legacy_started_for_availability": qbittorrent_legacy_entry.get("legacy_started_for_availability") is True,
        "healthy_client_stopped": qbittorrent_legacy_entry.get("healthy_client_stopped") is True,
        "process_cleanup_performed": qbittorrent_legacy_entry.get("process_cleanup_performed") is True,
        "state_copy_performed": qbittorrent_legacy_entry.get("state_copy_performed") is True,
        "startup_diagnostics_bounded": qbittorrent_legacy_entry.get("startup_diagnostics_bounded") is True,
    }
    if existing_cutover_receipt is None:
        summary["legacy_entry_recovery"] = {
            "already_running": legacy_entry.get("already_running"),
            "listener_port": legacy_entry.get("listener_port"),
            "startup_diagnostics_bounded": legacy_entry.get("startup_diagnostics_bounded") is True,
            "stale_cleanup_performed": bool(stale_recovery.get("cleanup_performed")),
        }
    else:
        summary["accepted_cutover_entry"] = {
            "receipt_committed": True,
            "persistent_runtime_verified": True,
            "candidate_version_matches_daemon": persistent_cutover_before.get("candidate_version_matches_daemon")
            if persistent_cutover_before else False,
        }
    try:
        host = current_host_environment()
        session = Session(host["DISPLAY"], Path(host["XAUTHORITY"]))
        acceptance_state = session.state
        session.setup()
        server_thread = threading.Thread(
            target=session.serve, name=f"monsterdesk-acceptance-{os.getpid()}", daemon=True
        )
        server_thread.start()
        wait_for(lambda: control_socket_path().is_socket() and server_thread.is_alive(), 5,
                 "ephemeral Monsterdesk acceptance control socket")
        initial = call_daemon("status")
        readiness = initial.get("openbox_policy", {}).get("readiness", {})
        if initial.get("instance") != acceptance_instance or readiness.get("ready") is not True:
            raise MonsterdeskError("ephemeral acceptance instance did not publish exact Openbox readiness")

        first_result = call_daemon("launch", {"profile": "terminal"})
        first = first_result["launch"]
        before_ids = {item["launch_id"] for item in call_daemon("processes")["processes"]}

        # A deliberately hidden Xephyr viewer is not a reliable focus surface for
        # synthetic host-independent key delivery. Prove the exact source-owned
        # command Openbox loaded instead: parse its active rc, require argv identity,
        # execute that command, and then verify the resulting managed application.
        binding_argv: dict[str, list[str]] = {}
        for keybind in ET.parse(session.openbox_files["rc"]).iter():
            if not keybind.tag.endswith("keybind"):
                continue
            chord = keybind.attrib.get("key", "")
            if chord not in {"C-S-F12", "C-S-F4"}:
                continue
            commands = [node.text for node in keybind.iter()
                        if node.tag.endswith("command") and node.text]
            if len(commands) != 1:
                raise MonsterdeskError(f"loaded Openbox binding {chord} does not contain one command")
            binding_argv[chord] = shlex.split(commands[0])
        expected_launch_argv = [str(BASH), "--noprofile", "--norc",
                                str(session.openbox_files["bridge"]), "terminal"]
        expected_close_argv = [str(BASH), "--noprofile", "--norc",
                               str(session.openbox_files["bridge"]), "close-active"]
        if binding_argv.get("C-S-F12") != expected_launch_argv:
            raise MonsterdeskError("loaded Openbox terminal binding argv differs from the source-owned bridge")
        if binding_argv.get("C-S-F4") != expected_close_argv:
            raise MonsterdeskError("loaded Openbox close binding argv differs from the source-owned bridge")

        bridge_launch = run_checked(binding_argv["C-S-F12"], timeout=35)
        bridge_launch_text = bridge_launch.stdout.decode("utf-8", errors="replace")[:MAX_LOG_TAIL_BYTES]
        if "MONSTERDESK_WM_LAUNCH profile=terminal" not in bridge_launch_text:
            raise MonsterdeskError("loaded Openbox terminal binding emitted no bridge receipt")
        deadline = time.monotonic() + 10
        second: dict[str, Any] | None = None
        while time.monotonic() < deadline:
            processes = call_daemon("processes")["processes"]
            second = next((item for item in processes if item["launch_id"] not in before_ids
                           and item["profile"] == "terminal" and item["alive"]
                           and item["window_ready"]), None)
            if second is not None:
                break
            time.sleep(0.2)
        if second is None:
            diagnostics = canonical(call_daemon("diagnostics"))[:2000]
            raise MonsterdeskError(
                "loaded Openbox terminal binding produced no second tracked terminal; "
                f"bridge_output={bridge_launch_text!r}; diagnostics={diagnostics}"
            )

        time.sleep(0.5)
        windows = call_daemon("windows")["windows"]
        by_id = {item["window_id"]: item for item in windows if item.get("managed") and item.get("mapped")}
        first_window = by_id.get(first["window_id"])
        second_window = by_id.get(second["window_id"])
        if first_window is None or second_window is None:
            raise MonsterdeskError("live acceptance terminals are not both mapped and managed")
        first_position = (first_window["x"], first_window["y"])
        second_position = (second_window["x"], second_window["y"])
        if first_position == second_position:
            raise MonsterdeskError(f"live acceptance windows still overlap at {first_position}")
        if abs(first_position[0] - second_position[0]) < 24 and abs(first_position[1] - second_position[1]) < 24:
            raise MonsterdeskError("live acceptance cascade offset is not visually meaningful")

        terminal_metrics = []
        for item in (first_window, second_window):
            cell_width = int(item.get("cell_width", 0))
            cell_height = int(item.get("cell_height", 0))
            base_width = int(item.get("base_width", 0))
            base_height = int(item.get("base_height", 0))
            if not (5 <= cell_width <= 20 and 10 <= cell_height <= 32):
                raise MonsterdeskError(
                    f"live xterm cell metrics are implausible: {cell_width}x{cell_height}"
                )
            columns = (int(item["width"]) - base_width) // cell_width
            rows = (int(item["height"]) - base_height) // cell_height
            if not (94 <= columns <= 98 and 29 <= rows <= 31):
                raise MonsterdeskError(f"live xterm geometry differs: columns={columns} rows={rows}")
            terminal_metrics.append({
                "window_id": item["window_id"], "x": item["x"], "y": item["y"],
                "cell_width": cell_width, "cell_height": cell_height,
                "columns": columns, "rows": rows,
            })

        second_pid = int(second["pid"])
        second_ticks = int(second["start_ticks"])
        call_daemon("focus", {"window_id": second["window_id"]})
        bridge_close = run_checked(binding_argv["C-S-F4"], timeout=25)
        bridge_close_text = bridge_close.stdout.decode("utf-8", errors="replace")[:MAX_LOG_TAIL_BYTES]
        if "MONSTERDESK_WM_CLOSE target=active" not in bridge_close_text:
            raise MonsterdeskError("loaded Openbox close binding emitted no bridge receipt")
        if "terminated=True" not in bridge_close_text or "close_method=" not in bridge_close_text:
            raise MonsterdeskError(
                f"loaded Openbox close binding did not report confirmed termination: {bridge_close_text!r}"
            )
        wait_for(lambda: not process_matches(second_pid, second_ticks), 3,
                 "loaded Openbox close binding to confirm the second birth-pinned terminal exited")
        remaining = call_daemon("processes")["processes"]
        if {item["launch_id"] for item in remaining} != {first["launch_id"]}:
            raise MonsterdeskError("loaded Openbox close binding did not leave exactly the first terminal alive")

        first_pid = int(first["pid"])
        first_ticks = int(first["start_ticks"])
        call_daemon("focus", {"window_id": first["window_id"]})
        direct_close = call_daemon("close-active")
        if direct_close.get("terminated") is not True or direct_close.get("close_method") not in {"wm-delete", "term", "kill"}:
            raise MonsterdeskError(f"direct close-active did not confirm termination: {canonical(direct_close)}")
        wait_for(lambda: not process_matches(first_pid, first_ticks), 3,
                 "direct close-active to confirm the first birth-pinned terminal exited")
        if call_daemon("processes")["processes"]:
            raise MonsterdeskError("tracked applications remain after live close acceptance")

        qb_after = ready_legacy_qbittorrent()
        qb_before_pid = int(qbittorrent_legacy_entry.get("pid", 0))
        qb_before_ticks = int(qbittorrent_legacy_entry.get("start_ticks", 0))
        if qb_after is None:
            raise MonsterdeskError("qBittorrent family client was not ready after nondisruptive acceptance")
        same_birth = (int(qb_after.get("pid", 0)), int(qb_after.get("start_ticks", 0))) == (
            qb_before_pid, qb_before_ticks
        )
        if same_birth is not True:
            raise MonsterdeskError("qBittorrent family client birth identity changed during candidate acceptance")
        qbittorrent_cutover_rehearsal = {
            "schema": "mnx.qbittorrent.availability-hold.v1",
            "status": "pass",
            "authority": "operator-family-service-continuity-plus-candidate-owned-mnx-test",
            "zero_downtime_hold": True,
            "host_client_ready_before": True,
            "host_client_ready_after": True,
            "host_client_birth_identity_preserved": True,
            "healthy_client_stopped": False,
            "signal_sent": False,
            "process_cleanup_performed": False,
            "state_copy_performed": False,
            "private_application_launched": False,
            "host_ports_released_or_rebound": False,
            "normal_launcher_replaced": False,
            "persistent_state_committed": False,
            "receipt_committed": False,
            "local_random_port_pasta_qualification": qbittorrent_qualification.get("namespace_probe", {}).get("state"),
            "family_peer_tcp_port": EXPECTED_QBITTORRENT_LISTEN_PORT,
            "family_peer_udp_port": EXPECTED_QBITTORRENT_LISTEN_PORT,
            "family_webui_tcp_port": EXPECTED_QBITTORRENT_WEBUI_PORT,
            "router_state_mutated": False,
            "firewall_changed": False,
            "torrent_resume_data_read": False,
            "payload_contents_read": False,
            "future_private_cutover_deferred": True,
            "future_cutover_requires_parallel_blue_green_proof": True,
        }


        nicotine_result = call_daemon("launch", {"profile": "nicotine-preflight"})
        nicotine_launch = nicotine_result["launch"]
        nicotine_boundary = nicotine_result.get("boundary", {})
        if (nicotine_boundary.get("network_mode") != "network-disabled-private-netns"
                or nicotine_boundary.get("filesystem_mode")
                != "empty-root-store-private-sanitized-nicotine-config-no-host-shares"):
            raise MonsterdeskError(f"Nicotine preflight capsule boundary differs: {canonical(nicotine_boundary)}")
        seed = nicotine_boundary.get("seed") or {}
        if (seed.get("source_sha256") != nicotine_preflight["config"]["sha256"]
                or seed.get("credentials_copied") is not False
                or seed.get("share_paths_copied") is not False
                or seed.get("host_share_binds") != 0):
            raise MonsterdeskError(f"Nicotine preflight seed identity differs: {canonical(seed)}")
        nicotine_window = next((item for item in call_daemon("windows")["windows"]
                                if item.get("window_id") == nicotine_launch.get("window_id")
                                and item.get("managed") and item.get("mapped")), None)
        if nicotine_window is None:
            raise MonsterdeskError("Nicotine preflight window is not mapped and managed")
        nicotine_pid = int(nicotine_launch["pid"])
        nicotine_ticks = int(nicotine_launch["start_ticks"])
        call_daemon("focus", {"window_id": nicotine_launch["window_id"]})
        nicotine_close = call_daemon("close-active")
        if nicotine_close.get("terminated") is not True:
            raise MonsterdeskError(f"Nicotine preflight close was not confirmed: {canonical(nicotine_close)}")
        wait_for(lambda: not process_matches(nicotine_pid, nicotine_ticks), 3,
                 "Nicotine preflight capsule to confirm exit")
        if call_daemon("processes")["processes"]:
            raise MonsterdeskError("tracked applications remain after Nicotine preflight close")
        nicotine_preflight["offline_capsule"] = {
            "launched": True, "managed_window": True,
            "network_mode": nicotine_boundary.get("network_mode"),
            "filesystem_mode": nicotine_boundary.get("filesystem_mode"),
            "credentials_copied": seed.get("credentials_copied"),
            "share_paths_copied": seed.get("share_paths_copied"),
            "host_share_binds": seed.get("host_share_binds"),
            "source_config_sha256_matched": seed.get("source_sha256") == nicotine_preflight["config"]["sha256"],
            "close_confirmed": True, "close_method": nicotine_close.get("close_method"),
        }

        if existing_cutover_receipt is None:
            # Before the first commit, exercise the real disruptive path and prove
            # legacy restoration before mnx test can succeed.
            nicotine_cutover_rehearsal = rehearse_nicotine_cutover(
                session, nicotine_preflight, nicotine_network
            )
            isolated = nicotine_cutover_rehearsal.get("isolated_runtime", {})
            legacy_restore = nicotine_cutover_rehearsal.get("legacy_restore", {})
            if (nicotine_cutover_rehearsal.get("isolated_close_confirmed") is not True
                    or nicotine_runtime_evidence_complete(isolated) is not True
                    or legacy_restore.get("confirmed") is not True
                    or legacy_restore.get("startup_diagnostics_bounded") is not True
                    or nicotine_cutover_rehearsal.get("host_port_released_before_restore") is not True
                    or nicotine_cutover_rehearsal.get("retry_used_current_stable_config_identity") is not True
                    or nicotine_cutover_rehearsal.get("source_config_semantic_boundary_preserved") is not True):
                raise MonsterdeskError(
                    "Nicotine rollback-tested cutover rehearsal evidence is incomplete: "
                    + canonical(nicotine_cutover_rehearsal)
                )
            if call_daemon("processes")["processes"]:
                raise MonsterdeskError("tracked applications remain after Nicotine cutover rehearsal")
        else:
            # Once the sealed receipt exists, a routine or successor test must not
            # tear down the accepted isolated service and silently restore legacy.
            persistent_cutover_after = verify_committed_nicotine_cutover()
            before_launch = persistent_cutover_before.get("launch", {}) if persistent_cutover_before else {}
            after_launch = persistent_cutover_after.get("launch", {})
            same_birth = (before_launch.get("pid"), before_launch.get("start_ticks")) == (
                after_launch.get("pid"), after_launch.get("start_ticks")
            )
            runtime = persistent_cutover_after.get("runtime", {})
            if (same_birth is not True
                    or nicotine_runtime_evidence_complete(runtime) is not True
                    or persistent_cutover_after.get("native_x11_probe") is not True):
                raise MonsterdeskError(
                    "accepted Nicotine cutover runtime evidence is incomplete: "
                    + canonical(persistent_cutover_after)
                )
            nicotine_cutover_rehearsal = {
                "schema": "mnx.nicotine.accepted-cutover-runtime.v1",
                "accepted_cutover_present": True,
                "receipt_committed": True,
                "persistent_launch_identity_preserved": same_birth,
                "runtime_before": persistent_cutover_before.get("runtime") if persistent_cutover_before else None,
                "runtime_after": runtime,
                "native_x11_probe": True,
                "legacy_application_started": False,
                "persistent_service_stopped": False,
                "router_state_mutated": False,
                "original_state_retained": True,
            }

        diagnostics = call_daemon("diagnostics")
        x11_probe = diagnostics.get("x11_probes", {}).get("terminal", {})
        nicotine_x11_probe = diagnostics.get("x11_probes", {}).get("nicotine-preflight", {})
        nicotine_live_x11_probe = diagnostics.get("x11_probes", {}).get("nicotine-live", {})
        qbittorrent_live_x11_probe = diagnostics.get("x11_probes", {}).get("qbittorrent-live", {})
        if x11_probe.get("state") != "pass" or x11_probe.get("wrong_cookie_rejected") is not True:
            raise MonsterdeskError("live native X authentication positive-negative-positive probe did not pass")
        if (nicotine_x11_probe.get("state") != "pass"
                or nicotine_x11_probe.get("wrong_cookie_rejected") is not True):
            raise MonsterdeskError("Nicotine preflight native X authentication probe did not pass")
        if qbittorrent_live_x11_probe:
            raise MonsterdeskError("qBittorrent zero-downtime hold unexpectedly launched a private GUI")
        if existing_cutover_receipt is None:
            if (nicotine_live_x11_probe.get("state") != "pass"
                    or nicotine_live_x11_probe.get("wrong_cookie_rejected") is not True):
                raise MonsterdeskError("Nicotine live native X authentication probe did not pass")
        elif persistent_cutover_after is None or persistent_cutover_after.get("native_x11_probe") is not True:
            raise MonsterdeskError("accepted persistent Nicotine native X authentication probe did not pass")
        summary.update({
            "display": initial.get("display"),
            "viewer_title": session.viewer_title,
            "openbox_ready": True,
            "terminal_metrics": terminal_metrics,
            "cascade_distinct": True,
            "loaded_binding_launch": True,
            "loaded_binding_close": True,
            "loaded_binding_launch_output_sha256": hashlib.sha256(bridge_launch.stdout).hexdigest(),
            "loaded_binding_close_output_sha256": hashlib.sha256(bridge_close.stdout).hexdigest(),
            "loaded_binding_close_confirmed": True,
            "synthetic_key_acceptance_required": False,
            "direct_close": bool(direct_close.get("terminated")),
            "direct_close_method": direct_close.get("close_method"),
            "native_x11_probe": "pass",
            "qbittorrent_preflight": "pass",
            "qbittorrent_cutover_qualification": "local-random-port-pass",
            "qbittorrent_ready_for_rollback_rehearsal": False,
            "qbittorrent_cutover_rehearsal": "not-run-zero-downtime-hold",
            "qbittorrent_cutover_rehearsal_legacy_restored": False,
            "qbittorrent_cutover_persistent_commit_deferred_to_successor": True,
            "qbittorrent_cutover_executed": False,
            "qbittorrent_accepted_runtime_reverified": False,
            "qbittorrent_persistent_launch_identity_preserved": False,
            "qbittorrent_family_client_birth_identity_preserved": True,
            "qbittorrent_host_state_mutated": qbittorrent_legacy_entry.get("legacy_started_for_availability") is True,
            "qbittorrent_healthy_client_stopped": False,
            "nicotine_preflight": "pass",
            "nicotine_preflight_close_method": nicotine_preflight["offline_capsule"]["close_method"],
            "nicotine_operator_authorization_recorded": True,
            "nicotine_standing_p2p_authority": True,
            "tracked_applications_after": 0,
        })
        if existing_cutover_receipt is None:
            summary.update({
                "nicotine_network_qualification": nicotine_network.get("namespace_probe", {}).get("state"),
                "nicotine_router_mapping_ready": nicotine_network.get("cutover_plan", {}).get("router_mapping_ready"),
                "nicotine_natpmp_capability": nicotine_network.get("natpmp", {}).get("state"),
                "nicotine_current_ingress_observed": nicotine_network.get("current_ingress", {}).get("current_listener_port_connection_observed"),
                "nicotine_cutover_rehearsal": "pass",
                "nicotine_cutover_rehearsal_legacy_restored": True,
                "nicotine_cutover_persistent_commit_deferred_to_sealed_switch": True,
                "nicotine_cutover_executed": False,
            })
        else:
            summary.update({
                "nicotine_network_qualification": "accepted-persistent-runtime",
                "nicotine_router_mapping_ready": False,
                "nicotine_natpmp_capability": "accepted-unavailable",
                "nicotine_current_ingress_observed": None,
                "nicotine_cutover_rehearsal": "not-repeated-after-commit",
                "nicotine_cutover_rehearsal_legacy_restored": False,
                "nicotine_cutover_persistent_commit_deferred_to_sealed_switch": False,
                "nicotine_cutover_executed": True,
                "nicotine_accepted_runtime_reverified": True,
                "nicotine_persistent_launch_identity_preserved": True,
            })
    finally:
        if session is not None:
            session.cleanup()
        if server_thread is not None:
            server_thread.join(timeout=3)
        if acceptance_state is not None:
            with contextlib.suppress(Exception):
                if acceptance_state.exists():
                    shutil.rmtree(acceptance_state)
        if prior_instance is None:
            os.environ.pop("MONSTERDESK_INSTANCE", None)
        else:
            os.environ["MONSTERDESK_INSTANCE"] = prior_instance
    try:
        main_after_stat = main_socket.lstat()
    except FileNotFoundError:
        main_socket_after: dict[str, Any] = {"present": False}
    else:
        if stat.S_ISLNK(main_after_stat.st_mode) or not stat.S_ISSOCK(main_after_stat.st_mode):
            raise MonsterdeskError("main Monsterdesk control path became unsafe")
        main_socket_after = {
            "present": True,
            "device": int(main_after_stat.st_dev),
            "inode": int(main_after_stat.st_ino),
            "uid": int(main_after_stat.st_uid),
            "gid": int(main_after_stat.st_gid),
            "mode": stat.S_IMODE(main_after_stat.st_mode),
        }
    if main_socket_after != main_socket_before:
        raise MonsterdeskError("ephemeral acceptance changed the main Monsterdesk socket identity")
    if server_thread is not None and server_thread.is_alive():
        raise MonsterdeskError("ephemeral acceptance server thread did not stop")
    summary["main_instance_socket_after"] = main_socket_after
    summary["main_instance_preserved"] = True
    summary["ephemeral_runtime_removed"] = not (runtime_base() / instance_runtime_name(acceptance_instance)).exists()
    summary["ephemeral_state_removed"] = acceptance_state is None or not acceptance_state.exists()
    if summary["ephemeral_runtime_removed"] is not True or summary["ephemeral_state_removed"] is not True:
        raise MonsterdeskError("ephemeral acceptance runtime or state remains after cleanup")
    publish_qbittorrent_preflight_evidence(qbittorrent_preflight)
    publish_qbittorrent_cutover_qualification_evidence(qbittorrent_qualification)
    qbittorrent_cutover_payload = canonical(qbittorrent_cutover_rehearsal)
    if len(qbittorrent_cutover_payload.encode("utf-8")) > MAX_QBITTORRENT_CUTOVER_REPORT_BYTES:
        raise MonsterdeskError("final qBittorrent availability-hold evidence exceeds byte policy")
    print("officer_health_qbittorrent_cutover_rehearsal=" + qbittorrent_cutover_payload)
    print("officer_health_qbittorrent_cutover_rehearsal_sha256="
          + hashlib.sha256(qbittorrent_cutover_payload.encode("utf-8")).hexdigest())
    nicotine_payload = canonical(nicotine_preflight)
    if len(nicotine_payload.encode("utf-8")) > MAX_NICOTINE_REPORT_BYTES:
        raise MonsterdeskError("final Nicotine preflight evidence exceeds byte policy")
    print("officer_health_nicotine_preflight=" + nicotine_payload)
    print("officer_health_nicotine_preflight_sha256=" + hashlib.sha256(nicotine_payload.encode("utf-8")).hexdigest())
    network_payload = canonical(nicotine_network)
    if len(network_payload.encode("utf-8")) > MAX_NICOTINE_NETWORK_REPORT_BYTES:
        raise MonsterdeskError("final Nicotine network qualification evidence exceeds byte policy")
    print("officer_health_nicotine_network_qualification=" + network_payload)
    print("officer_health_nicotine_network_qualification_sha256="
          + hashlib.sha256(network_payload.encode("utf-8")).hexdigest())
    cutover_payload = canonical(nicotine_cutover_rehearsal)
    if len(cutover_payload.encode("utf-8")) > MAX_NICOTINE_CUTOVER_REPORT_BYTES:
        raise MonsterdeskError("final Nicotine cutover rehearsal evidence exceeds byte policy")
    print("officer_health_nicotine_cutover_rehearsal=" + cutover_payload)
    print("officer_health_nicotine_cutover_rehearsal_sha256="
          + hashlib.sha256(cutover_payload.encode("utf-8")).hexdigest())
    print(canonical(summary))
    print("MONSTERDESK_LIVE_ACCEPTANCE=PASS")
    return 0


#@MNX-PART id=90.00.monsterdesk.function.f075-cli kind=function title="Python function cli"
def cli() -> int:
    parser = argparse.ArgumentParser(prog="monsterdesk")
    sub = parser.add_subparsers(dest="command", required=True)
    start_p = sub.add_parser("start")
    start_p.add_argument("--show", action="store_true")
    sub.add_parser("stop")
    status_p = sub.add_parser("status")
    status_p.add_argument("--json", action="store_true")
    sub.add_parser("show")
    sub.add_parser("hide")
    launch_p = sub.add_parser("launch")
    launch_p.add_argument("profile", choices=["terminal", "nicotine-audit"])
    observe_p = sub.add_parser("observe")
    observe_p.add_argument("--output")
    screenshot_p = sub.add_parser("screenshot")
    screenshot_p.add_argument("output")
    sub.add_parser("windows")
    move_p = sub.add_parser("move")
    move_p.add_argument("x", type=int)
    move_p.add_argument("y", type=int)
    click_p = sub.add_parser("click")
    click_p.add_argument("x", type=int)
    click_p.add_argument("y", type=int)
    click_p.add_argument("--button", type=int, default=1)
    type_p = sub.add_parser("type")
    type_p.add_argument("text")
    key_p = sub.add_parser("key")
    key_p.add_argument("chord")
    sub.add_parser("processes")
    sub.add_parser("diagnostics")
    terminate_p = sub.add_parser("terminate")
    terminate_p.add_argument("launch_id")
    terminate_p.add_argument("--signal", default="TERM", choices=["TERM", "INT", "KILL", "HUP"])
    sub.add_parser("close-active")
    sub.add_parser("doctor")
    sub.add_parser("demo")
    sub.add_parser("mcp")
    sub.add_parser("mcp-config")
    sub.add_parser("self-test")
    sub.add_parser("live-acceptance")
    sub.add_parser("nicotine-cutover")
    nicotine_live_p = sub.add_parser("nicotine-live")
    nicotine_live_p.add_argument("arguments", nargs=argparse.REMAINDER)
    sub.add_parser("qbittorrent-cutover")
    qbittorrent_live_p = sub.add_parser("qbittorrent-live")
    qbittorrent_live_p.add_argument("arguments", nargs=argparse.REMAINDER)
    sub.add_parser("daemon")
    args = parser.parse_args()

    if args.command == "daemon":
        return daemon_main()
    if args.command == "nicotine-cutover":
        print(canonical(commit_nicotine_cutover()))
        return 0
    if args.command == "nicotine-live":
        print_human(nicotine_launcher(list(args.arguments)))
        return 0
    if args.command == "qbittorrent-cutover":
        print(canonical(commit_qbittorrent_cutover()))
        return 0
    if args.command == "qbittorrent-live":
        print_human(qbittorrent_launcher(list(args.arguments)))
        return 0
    if args.command == "self-test":
        return self_test()
    if args.command == "live-acceptance":
        return live_acceptance()
    if args.command == "mcp":
        return mcp_main()
    if args.command == "mcp-config":
        print(canonical({"mcpServers": {"monsterdesk": {"command": str(Path(__file__).resolve()), "args": ["mcp"]}}}))
        return 0
    if args.command == "doctor":
        value = doctor()
        print(canonical(value))
        return 0 if value["pass"] else 1
    if args.command == "start":
        print_human(start_session(show=args.show))
        return 0
    if args.command == "stop":
        print_human(stop_session())
        return 0
    if args.command == "status":
        try:
            value = call_daemon("status")
        except MonsterdeskError:
            if status_path().is_file():
                value = json.loads(status_path().read_text(encoding="utf-8"))
            else:
                value = {"schema": SCHEMA, "version": VERSION, "state": "stopped"}
        print(canonical(value) if args.json else "\n".join(
            f"{key}={canonical(item) if isinstance(item, (dict, list)) else item}"
            for key, item in value.items()
        ))
        return 0
    if args.command == "show":
        print_human(call_daemon("show", start=True))
        return 0
    if args.command == "hide":
        print_human(call_daemon("hide"))
        return 0
    if args.command == "launch":
        print_human(call_daemon("launch", {"profile": args.profile}, start=True))
        return 0
    if args.command in {"observe", "screenshot"}:
        action = "observe" if args.command == "observe" else "screenshot"
        value = call_daemon(action, start=True)
        image = value.get("image") if action == "observe" else value
        output = args.output if args.command == "observe" else args.output
        if output:
            path = Path(output).expanduser()
            path.write_bytes(base64.b64decode(image["data_base64"], validate=True))
            os.chmod(path, 0o600)
            print(f"output={path}")
        text = dict(value)
        if action == "observe":
            text["image"] = {key: item for key, item in image.items() if key != "data_base64"}
        else:
            text.pop("data_base64", None)
        print(canonical(text))
        return 0
    if args.command == "windows":
        print(canonical(call_daemon("windows", start=True)))
        return 0
    if args.command == "move":
        print(canonical(call_daemon("move", {"x": args.x, "y": args.y}, start=True)))
        return 0
    if args.command == "click":
        print(canonical(call_daemon("click", {"x": args.x, "y": args.y, "button": args.button}, start=True)))
        return 0
    if args.command == "type":
        print(canonical(call_daemon("type", {"text": args.text}, start=True)))
        return 0
    if args.command == "key":
        print(canonical(call_daemon("key", {"chord": args.chord}, start=True)))
        return 0
    if args.command == "processes":
        print(canonical(call_daemon("processes")))
        return 0
    if args.command == "close-active":
        print_human(call_daemon("close-active"))
        return 0
    if args.command == "diagnostics":
        print(canonical(call_daemon("diagnostics")))
        return 0
    if args.command == "terminate":
        print(canonical(call_daemon("terminate", {"launch_id": args.launch_id, "signal": args.signal})))
        return 0
    if args.command == "demo":
        initial = start_session(show=True)
        print(canonical({"demo_openbox_readiness": initial.get("openbox_policy", {}).get("readiness")}))
        launch_result = call_daemon("launch", {"profile": "terminal"})
        print(canonical({"demo_launch": launch_result}))
        before = {item["launch_id"] for item in call_daemon("processes")["processes"]}
        # Focus the actual managed private client, not a raw early root-tree window.
        call_daemon("focus", {"window_id": launch_result["launch"]["window_id"]})
        key_result = call_daemon("key", {"chord": "ctrl+shift+F12"})
        print(canonical({"demo_key_delivery": key_result.get("key_delivery")}))
        deadline = time.monotonic() + 25
        bridge_launch = None
        while time.monotonic() < deadline:
            processes = call_daemon("processes")["processes"]
            bridge_launch = next((item for item in processes if item["launch_id"] not in before
                                  and item["profile"] == "terminal" and item["alive"] and item["window_ready"]), None)
            if bridge_launch is not None:
                break
            time.sleep(0.2)
        if bridge_launch is None:
            raise MonsterdeskError("Openbox Ctrl+Shift+F12 bridge produced no ready private terminal; inspect diagnostics")
        time.sleep(1)
        processes = call_daemon("processes")["processes"]
        windows = call_daemon("windows")["windows"]
        mapped_ids = {item["window_id"] for item in windows if item.get("mapped") and item.get("managed")}
        alive_ids = {item["launch_id"] for item in processes
                     if item["alive"] and item["window_ready"] and item.get("window_id") in mapped_ids}
        if launch_result["launch"]["launch_id"] not in alive_ids or bridge_launch["launch_id"] not in alive_ids:
            raise MonsterdeskError("a demo terminal exited after window readiness; inspect diagnostics")
        print(canonical({"demo_openbox_bridge_launch": bridge_launch, "nested_chord": "ctrl+shift+F12"}))
        print(canonical(call_daemon("observe", {"include_image": False})))
        print("MONSTERDESK_DEMO=PASS")
