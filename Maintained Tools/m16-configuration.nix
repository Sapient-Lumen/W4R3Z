#@MNX-CHUNK id=40.10 slug=journald-logbook title="Journald, coredumps, and Logbook observability"
#######################################################################################################
# SECTION 40 — OBSERVABILITY AND NOTIFICATIONS
#######################################################################################################

  ##### Logs & Monitoring #####
  ##### Logs & Monitoring #####
#@MNX-DEF path=services.journald section=40.10 role=policy ordinal=136
services.journald = {
  storage           = "persistent";        # /var/log/journal
  rateLimitInterval = "30s";
  rateLimitBurst    = 10000;
  extraConfig = ''
    # NOTE: keep this block free of inline comments; systemd config parsing is strict.

    # Tamper-evidence (requires keys; run: journalctl --setup-keys)
    Seal=yes

    # Local journald SplitMode supports: uid|none
    SplitMode=uid

    # Bound disk usage for the default namespace journal
    SystemMaxUse=2G
    SystemKeepFree=250M
    SystemMaxFileSize=64M

    # Runtime journal bounds (if any is kept in /run)
    RuntimeKeepFree=100M

    # Rotation/retention
    MaxFileSec=1day
    MaxRetentionSec=6month

    # Better crash forensics (more frequent sync → more writes)
    SyncIntervalSec=30s
  '';
};


  # Keep coredump useful for forensics without allowing a crash storm to eat the machine.
  # The 2026-06-15 incident produced a pile of GUI/process coredumps after swap-backed
  # pages failed, so cap both per-process and total external coredump storage.
  #
  # Use a coredump.conf.d drop-in instead of the newer NixOS option form because
  # this channel does not expose `systemd.coredump.settings`.
#@MNX-CHUNK id=40.11 slug=coredumps-logbook-foundation title="Coredumps and Logbook namespace foundation"
#@MNX-DEF path=environment.etc."systemd/coredump.conf.d/10-monsternix.conf".text section=40.11 role=generated-config ordinal=137
  environment.etc."systemd/coredump.conf.d/10-monsternix.conf".text = ''
    [Coredump]
    Storage=external
    Compress=yes
    ProcessSizeMax=512M
    ExternalSizeMax=512M
    JournalSizeMax=256M
    MaxUse=4G
    KeepFree=4G
  '';


    #########################################################################
  # Logbook: curated, high-signal journal stream (separate namespace)
  #
  # View it with:
  #   journalctl --namespace=logbook
  #   journalctl --namespace=logbook -x     (if catalog is enabled below)
  #########################################################################

  # Per-namespace journald config: /etc/systemd/journald@logbook.conf
#@MNX-DEF path=environment.etc."systemd/journald@logbook.conf".text section=40.11 role=generated-config ordinal=138
  environment.etc."systemd/journald@logbook.conf".text = ''
    [Journal]
    Storage=persistent
    SplitMode=none

    # Logbook is low volume; keep it longer, but cap it.
    SystemMaxUse=512M
    SystemMaxFileSize=64M
    MaxFileSec=1week
    MaxRetentionSec=2year

    # Disable rate limiting in logbook (it's supposed to be sparse and important)
    RateLimitIntervalSec=0
    RateLimitBurst=0

    # More durability for logbook
    SyncIntervalSec=30s
  '';

  #########################################################################
  # Logbook message catalog (optional, but nice): journalctl --namespace=logbook -x
  #
  # NOTE: This is intentionally short. You can expand these runbooks later.
  #########################################################################
#@MNX-DEF path=environment.etc."systemd/catalog/logbook.catalog".text section=40.11 role=generated-config ordinal=139
  environment.etc."systemd/catalog/logbook.catalog".text = ''
  -- bf8d42a9-6748-5166-9cbd-403df06f8e17
  Subject: Logbook boot packet written

  A boot forensics bundle was written to:
    @BUNDLE_PATH@

  Suggested next steps:
    journalctl -b -0 -p warning..alert
    journalctl -k -b -0 -p warning..alert
    systemctl --failed

  -- 7298caf8-c31d-569c-a39d-7df6e72a57b4
  Subject: Logbook daily health snapshot

  A daily health snapshot was written to:
    @BUNDLE_PATH@

  -- 6f2fac7c-c7dd-58be-9798-c9afafa166bc
  Subject: Logbook incident bundle written

  An incident bundle was written to:
    @BUNDLE_PATH@

  -- 9f3a0b1c-e1b7-5363-ba12-8db3aea0fff9
  Subject: Journal verification completed

  Journal verification completed with:
    @LOGBOOK_RESULT@

  -- a1a93a94-fc5e-5ad8-8e47-4b581f4a0d6d
  Subject: Monsternix notification

  @MESSAGE@

  -- 38ef6264-4f38-5c81-b028-5c285b5a9c9f
  Subject: Monsternix storage health snapshot

  A storage health snapshot was written to:
    @BUNDLE_PATH@
  '';

  # Ensure catalog is indexed (journalctl -x)
#@MNX-CHUNK id=40.12 slug=logbook-catalog title="Logbook message catalogue and refresh service"
#@MNX-DEF path=systemd.services.logbook-catalog-update section=40.12 role=service ordinal=140
  systemd.services.logbook-catalog-update = {
    description = "Update systemd journal message catalog (logbook)";
    wantedBy = [ "multi-user.target" ];
    after = [ "systemd-journald.service" ];
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      StandardOutput = "journal";
      StandardError = "journal";
    };
    path = [ pkgs.systemd ];
    script = ''
      set -euo pipefail
      journalctl --update-catalog || true
    '';
  };

  #########################################################################
  # Logbook storage on disk
  #########################################################################
  # (Directories also created by the scripts themselves; these are belt-and-suspenders.)

  #########################################################################
  # Logbook: boot packet (per boot)
  #########################################################################
#@MNX-CHUNK id=40.13 slug=logbook-boot-packet title="Per-boot forensic packet"
#@MNX-DEF path=systemd.services.logbook-boot-packet section=40.13 role=service ordinal=141
  systemd.services.logbook-boot-packet = {
    description = "Logbook boot packet (forensics bundle)";
    wantedBy = [ "multi-user.target" ];
    after = [ "local-fs.target" "systemd-journal-flush.service" ];
    wants = [ "systemd-journal-flush.service" ];
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Group = "logbook";
      UMask = "0027";
      StateDirectoryMode = "2750";
      LogNamespace = "logbook";
      StandardOutput = "journal";
      StandardError = "journal";

      # Keep it from competing with interactive work
      Nice = 10;
      IOSchedulingClass = "idle";
      StateDirectory = "logbook";
    };
    path = [
      pkgs.coreutils
      pkgs.gnugrep
      pkgs.gawk
      pkgs.gnused
      pkgs.findutils
      pkgs.util-linux
      pkgs.systemd
      pkgs.pciutils
      pkgs.usbutils
      pkgs.btrfs-progs
      pkgs.smartmontools
      pkgs.nvme-cli
      pkgs.zstd
    ];
      script = ''
    set -euo pipefail
    umask 027

    BOOT_ID="$(cat /proc/sys/kernel/random/boot_id)"
    TS="$(date -Is)"
    ROOT="/var/lib/logbook"
    DIR="$ROOT/boots/$BOOT_ID"
      # Ensure the base tree exists with sane perms.
      #  - dirs: 2750 root:logbook (setgid so new files inherit the group)
      #  - files: 0640 root:logbook (via umask 027)
      if true; then
        install -d -m 2750 -o root -g logbook "$ROOT" "$ROOT/boots" "$ROOT/daily" "$ROOT/incidents" "$ROOT/pstore" || true
        # install(1) does not change owner/group of existing dirs, so enforce it too.
        chown root:logbook "$ROOT" "$ROOT/boots" "$ROOT/daily" "$ROOT/incidents" "$ROOT/pstore" 2>/dev/null || true
        chmod 2750 "$ROOT" "$ROOT/boots" "$ROOT/daily" "$ROOT/incidents" "$ROOT/pstore" 2>/dev/null || true
      else
        install -d -m 0750 -o root -g root "$ROOT" "$ROOT/boots" "$ROOT/daily" "$ROOT/incidents" "$ROOT/pstore" || true
      fi

      mkdir -p "$DIR"
      if true; then
        chown root:logbook "$DIR" 2>/dev/null || true
        chmod 2750 "$DIR" 2>/dev/null || true
      fi

    # Don't re-run for the same boot id unless you manually delete the marker.
    if [ -f "$DIR/.done" ] && [ "''${LOGBOOK_FORCE:-0}" != "1" ]; then
      exit 0
    fi

    # Namespaces don't support journalctl --flush; rely on systemd-journal-flush.service ordering instead.
    journalctl --sync 2>/dev/null || true

    # Determine boot start epoch and define a bounded "early boot" window.
    # This avoids multi-GB bundles if the service is first enabled long after boot.
    BTIME_EPOCH="$(awk '/btime/ {print $2; exit}' /proc/stat 2>/dev/null || true)"
    EARLY_SECS=900  # 15 minutes
    EARLY_UNTIL=""
    if [ -n "$BTIME_EPOCH" ]; then
      EARLY_UNTIL="$((BTIME_EPOCH + EARLY_SECS))"
    fi

    # Exports (machine-readable, replayable) — bounded to avoid runaway size.
    if [ -n "$BTIME_EPOCH" ] && [ -n "$EARLY_UNTIL" ]; then
      journalctl -b -o export --since="@$BTIME_EPOCH" --until="@$EARLY_UNTIL" > "$DIR/journal.early.export" 2>/dev/null || true
      journalctl -k -b -o export --since="@$BTIME_EPOCH" --until="@$EARLY_UNTIL" > "$DIR/kernel.early.export" 2>/dev/null || true

      # LLM-friendly summaries (short + prioritized)
      journalctl -b -p warning..alert --since="@$BTIME_EPOCH" --until="@$EARLY_UNTIL" --no-pager -o short-iso > "$DIR/journal.early.warnings.txt" 2>/dev/null || true
      journalctl -k -p warning..alert --since="@$BTIME_EPOCH" --until="@$EARLY_UNTIL" --no-pager -o short-iso > "$DIR/kernel.early.warnings.txt" 2>/dev/null || true
    else
      # Fallback (shouldn't happen): keep it small.
      journalctl -b -o export --since="now-15min" > "$DIR/journal.recent.export" 2>/dev/null || true
      journalctl -k -o export --since="now-15min" > "$DIR/kernel.recent.export" 2>/dev/null || true
      journalctl -b -p warning..alert --since="now-15min" --no-pager -o short-iso > "$DIR/journal.recent.warnings.txt" 2>/dev/null || true
      journalctl -k -p warning..alert --since="now-15min" --no-pager -o short-iso > "$DIR/kernel.recent.warnings.txt" 2>/dev/null || true
    fi

    # Compress any export over 100MB (belt-and-suspenders)
    for f in "$DIR"/*.export; do
      [ -f "$f" ] || continue
      size="$(stat -c %s "$f" 2>/dev/null || echo 0)"
      if [ "$size" -gt 104857600 ]; then
        zstd -q -3 --rm "$f" 2>/dev/null || true
      fi
    done

    # Human-friendly summaries
    (uname -a || true) > "$DIR/uname.txt"
    (cat /proc/cmdline || true) > "$DIR/cmdline.txt"
    if [ -x /run/current-system/sw/bin/nixos-version ]; then
      (/run/current-system/sw/bin/nixos-version || true) > "$DIR/nixos-version.txt"
    else
      (/run/current-system/sw/bin/nixos-version || true) > "$DIR/nixos-version.txt"
    fi

    # systemd status: if the system never reaches "running" (e.g., long services), capture why.
    RUN_STATE="$(systemctl is-system-running 2>/dev/null || true)"
    echo "$RUN_STATE" > "$DIR/systemctl.is-system-running.txt"

    (systemd-analyze blame || true) > "$DIR/systemd-analyze.blame.txt"
    (systemctl --failed || true) > "$DIR/systemctl.failed.txt"
    (journalctl --disk-usage || true) > "$DIR/journal.disk-usage.txt"

    if [ "$RUN_STATE" = "running" ]; then
      (systemd-analyze time || true) > "$DIR/systemd-analyze.time.txt"
      (systemd-analyze critical-chain || true) > "$DIR/systemd-analyze.critical-chain.txt"
    else
      echo "Boot not finished; systemctl is-system-running=$RUN_STATE" > "$DIR/systemd-analyze.time.txt"
      echo "Boot not finished; systemctl is-system-running=$RUN_STATE" > "$DIR/systemd-analyze.critical-chain.txt"
      (systemctl list-jobs || true) > "$DIR/systemctl.list-jobs.txt"
      (systemctl list-units --all --state=activating || true) > "$DIR/systemctl.activating.txt"
    fi

    (lsblk -f || true) > "$DIR/lsblk-f.txt"
    (lsblk -o NAME,KNAME,TYPE,SIZE,FSTYPE,UUID,MOUNTPOINTS,MODEL,SERIAL,ROTA,TRAN || true) > "$DIR/lsblk.txt"
    (blkid || true) > "$DIR/blkid.txt"
    (findmnt -a || true) > "$DIR/findmnt.txt"
    (cat /proc/swaps || true) > "$DIR/proc.swaps.txt"
    (swapon --show --bytes || true) > "$DIR/swapon.show.txt"

    # Btrfs status (if applicable)
    if command -v btrfs >/dev/null 2>&1; then
      (btrfs filesystem show --mounted || true) > "$DIR/btrfs.filesystem.show.txt"
      for mp in / /mnt/m16-backup-nvme /mnt/m16-new-storage /mnt/m16-old-storage; do
        if findmnt -rn "$mp" >/dev/null 2>&1; then
          safe="$(echo "$mp" | sed 's#^/##; s#[/ ]#_#g; s#^$#root#')"
          [ -n "$safe" ] || safe="root"
          (btrfs device stats "$mp" || true) > "$DIR/btrfs.device.stats.$safe.txt"
          (btrfs scrub status "$mp" || true) > "$DIR/btrfs.scrub.status.$safe.txt"
        fi
      done
    fi

    # SMART/NVMe headlines
    if command -v smartctl >/dev/null 2>&1; then
      mkdir -p "$DIR/smart"
      lsblk -dn -o NAME,TYPE | awk '$2=="disk"{print "/dev/"$1}' | while read -r d; do
        out="$DIR/smart/$(basename "$d").txt"
        (smartctl -H -A -i "$d" || true) > "$out"
      done
    fi

    if command -v nvme >/dev/null 2>&1; then
      mkdir -p "$DIR/nvme"
      (nvme list || true) > "$DIR/nvme/list.txt"
      nvme list 2>/dev/null | awk 'NR>2 && $1 ~ /^\/dev\/nvme/ {print $1}' | while read -r nd; do
        (nvme smart-log "$nd" || true) > "$DIR/nvme/$(basename "$nd").smart-log.txt"
        (nvme error-log "$nd" || true) > "$DIR/nvme/$(basename "$nd").error-log.txt"
      done
    fi

    # Simple JSON index (LLM-friendly)
    cat > "$DIR/index.json" <<EOF
{"boot_id":"$BOOT_ID","timestamp":"$TS","path":"$DIR","nixos_version":"$(cat "$DIR/nixos-version.txt" 2>/dev/null | head -c 200 | tr -d '
' | sed 's/"/\"/g')","kernel":"$(uname -r | tr -d '
')","system_state":"$RUN_STATE"}
EOF

    # Checksums are created outside the bundle, atomically installed, and verified.
    /etc/monsternix/bin/mnx-bundle-manifest create "$DIR" 2

    touch "$DIR/.done"

    # Structured journal entry (logbook namespace)
    logger --journald <<EOF || logger -t logbook "Boot packet written to $DIR" || true
MESSAGE_ID=bf8d42a9-6748-5166-9cbd-403df06f8e17
PRIORITY=5
LOGBOOK_KIND=BOOT_PACKET_WRITTEN
LOGBOOK_VER=2
BOOT_ID=$BOOT_ID
BUNDLE_PATH=$DIR
MESSAGE=Boot packet written to $DIR
EOF
  '';
  };

  #########################################################################
  # Logbook: daily health snapshot
  #########################################################################
#@MNX-CHUNK id=40.14 slug=logbook-daily-health title="Daily health snapshot and timer"
#@MNX-DEF path=systemd.services.logbook-daily-health section=40.14 role=service ordinal=142
  systemd.services.logbook-daily-health = {
    description = "Logbook daily health snapshot";
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Group = "logbook";
      UMask = "0027";
      StateDirectoryMode = "2750";
      LogNamespace = "logbook";
      StandardOutput = "journal";
      StandardError = "journal";
      Nice = 10;
      IOSchedulingClass = "idle";
      StateDirectory = "logbook";
    };
    path = [
      pkgs.coreutils
      pkgs.gnugrep
      pkgs.gawk
      pkgs.gnused
      pkgs.util-linux
      pkgs.systemd
      pkgs.btrfs-progs
      pkgs.smartmontools
      pkgs.nvme-cli
    ];
    script = ''
      set -euo pipefail
      umask 027

      TS="$(date -Is)"
      DAY="$(date -I)"
      OUT="/var/lib/logbook/daily/$DAY.txt"
      JSON="/var/lib/logbook/daily/$DAY.json"
      PROBLEM=0
      WARN=0
      STORAGE_HISTORY=0
      MEMORY_SEEN=0
      BTRFS_ADVISORY=0

      mkdir -p /var/lib/logbook/daily
      chown root:logbook /var/lib/logbook /var/lib/logbook/daily 2>/dev/null || true
      chmod 2750 /var/lib/logbook /var/lib/logbook/daily 2>/dev/null || true

      echo "=== LOGBOOK DAILY HEALTH ($TS) ===" > "$OUT"
      echo "" >> "$OUT"

      echo "== Failed systemd units ==" >> "$OUT"
      FAILED_UNITS="$(systemctl --failed --no-legend --plain 2>/dev/null || true)"
      if [ -n "$FAILED_UNITS" ]; then
        printf "%s\n" "$FAILED_UNITS" >> "$OUT"
        IMMEDIATE_FAILED_UNITS=$(printf '%s\n' "$FAILED_UNITS" | awk '$1 !~ /^(btrbk-main|btrbk-archive-to-new-storage|rsync-m16-new-to-old|m16-backup-m21|m16-restic-maintenance)[.]service$/')
        if [ -n "$IMMEDIATE_FAILED_UNITS" ]; then PROBLEM=1; fi
        echo 'INFO: ordinary backup failure notification is owned by one-week supervision.' >> "$OUT"
      else
        echo "none" >> "$OUT"
      fi
      echo "" >> "$OUT"

      echo "== Swap posture ==" >> "$OUT"
      (cat /proc/swaps || true) >> "$OUT"
      OVERFLOW_SWAP="/mnt/m16-backup-nvme/swap/swapfile"
      OVERFLOW_SWAP_USED_BYTES="$(swapon --noheadings --bytes --show=NAME,USED 2>/dev/null | awk -v s="$OVERFLOW_SWAP" '$1 == s { print $2; found=1 } END { if (!found) print -1 }')"
      echo "overflow_swap_used_bytes=$OVERFLOW_SWAP_USED_BYTES" >> "$OUT"
      if [ "$OVERFLOW_SWAP_USED_BYTES" -lt 0 ] 2>/dev/null; then
        WARN=1
        echo "WARN: backup-NVMe 128 GiB Btrfs overflow swap is not active" >> "$OUT"
      elif [ "$OVERFLOW_SWAP_USED_BYTES" -gt 0 ] 2>/dev/null; then
        echo "INFO: backup-NVMe overflow swap currently has $OVERFLOW_SWAP_USED_BYTES bytes in use (normal)" >> "$OUT"
      fi
      echo "" >> "$OUT"

      echo "== Warning+ events in last 24h ==" >> "$OUT"
      WARN_COUNT="$(journalctl --since '24 hours ago' -p warning..alert 2>/dev/null | wc -l | awk '{print $1}' || true)"
      KERN_WARN_COUNT="$(journalctl -k --since '24 hours ago' -p warning..alert 2>/dev/null | wc -l | awk '{print $1}' || true)"
      echo "journal warning..alert lines: $WARN_COUNT" >> "$OUT"
      echo "kernel  warning..alert lines: $KERN_WARN_COUNT" >> "$OUT"
      echo "" >> "$OUT"

      STORAGE_RE='Read-error on swap-device|I/O error|Input/output error|blk_update_request|Buffer I/O error|rejecting I/O|resetting link|hard resetting link|SATA link down|nvme.*timeout|nvme.*controller.*down|nvme.*reset|Identify namespace failed|Device not ready|Disabling device after reset failure|CSTS|BTRFS.*(error|warning)|checksum verify failed|csum failed|transaction aborted|parent transid verify failed|read-only.*due to|read-only file system|AER:.*(Fatal|Uncorrected)|medium error|uncorrectable'
      MEMORY_RE='Out of memory|oom-kill|Killed process|Memory cgroup out of memory|systemd-oomd|earlyoom.*(sending|killing)'

      echo "== Storage incident strings (all boots, 24h, report-only; incident scanner owns event alerts) ==" >> "$OUT"
      STORAGE_EVENTS="$(journalctl -k --since '24 hours ago' -p warning..alert --no-pager 2>/dev/null | grep -E -i "$STORAGE_RE" | tail -n 200 || true)"
      if [ -n "$STORAGE_EVENTS" ]; then
        STORAGE_HISTORY=1
        printf "%s\n" "$STORAGE_EVENTS" >> "$OUT"
      else
        echo "none" >> "$OUT"
      fi
      echo "" >> "$OUT"

      echo "== Memory-pressure incident strings (current boot, 24h, report-only; incident scanner owns event alerts) ==" >> "$OUT"
      MEMORY_EVENTS="$(journalctl -b --since '24 hours ago' -p warning..alert --no-pager 2>/dev/null | grep -E -i "$MEMORY_RE" | tail -n 200 || true)"
      if [ -n "$MEMORY_EVENTS" ]; then
        MEMORY_SEEN=1
        printf "%s\n" "$MEMORY_EVENTS" >> "$OUT"
        echo "INFO: memory-pressure evidence is historical/report-only in this snapshot; logbook-incident-scan owns new-event notification" >> "$OUT"
      else
        echo "none" >> "$OUT"
      fi
      echo "" >> "$OUT"

      if command -v btrfs >/dev/null 2>&1; then
        for mp in / /mnt/m16-backup-nvme /mnt/m16-new-storage /mnt/m16-old-storage; do
          if findmnt -rn "$mp" >/dev/null 2>&1; then
            echo "== btrfs device stats $mp ==" >> "$OUT"
            STATS="$(btrfs device stats "$mp" 2>&1 || true)"
            printf "%s\n" "$STATS" >> "$OUT"
            echo "" >> "$OUT"

            echo "== btrfs scrub status $mp ==" >> "$OUT"
            (btrfs scrub status "$mp" || true) >> "$OUT"
            echo "" >> "$OUT"
          fi
        done
      fi

      echo "== Btrfs pinned baseline comparison ==" >> "$OUT"
      set +e
      if [ -L /var/lib/monsternix/btrfs-baselines/pinned ]; then
        BTRFS_BASELINE_OUTPUT="$(/etc/monsternix/bin/mnx-btrfs-baseline compare pinned 2>&1)"
        BTRFS_BASELINE_RC="$?"
      else
        BTRFS_BASELINE_OUTPUT="$(/etc/monsternix/bin/mnx-btrfs-baseline check-zero 2>&1)"
        BTRFS_BASELINE_RC="$?"
      fi
      set -e
      printf "%s\n" "$BTRFS_BASELINE_OUTPUT" >> "$OUT"
      if [ "$BTRFS_BASELINE_RC" -ne 0 ]; then
        PROBLEM=1
      elif printf "%s\n" "$BTRFS_BASELINE_OUTPUT" | grep -q '^ADVISORY:'; then
        BTRFS_ADVISORY=1
      fi
      echo "" >> "$OUT"

      if command -v nvme >/dev/null 2>&1; then
        echo "== nvme list ==" >> "$OUT"
        (nvme list || true) >> "$OUT"
        echo "" >> "$OUT"
        for nd in /dev/nvme0 /dev/nvme1; do
          [ -e "$nd" ] || continue
          echo "== nvme smart-log $nd ==" >> "$OUT"
          SMART="$(nvme smart-log "$nd" 2>&1 || true)"
          printf "%s\n" "$SMART" >> "$OUT"
          if printf "%s\n" "$SMART" | awk -F: 'tolower($1) ~ /critical_warning|critical warning/ { gsub(/^[ \t]+|[ \t]+$/, "", $2); if ($2 != "0" && $2 != "0x00") bad=1 } END { exit bad ? 0 : 1 }'; then
            PROBLEM=1
          fi
          echo "" >> "$OUT"
        done
      fi

      cat > "$JSON" <<EOF
{"date":"$DAY","timestamp":"$TS","journal_warning_alert_lines":$WARN_COUNT,"kernel_warning_alert_lines":$KERN_WARN_COUNT,"overflow_swap_used_bytes":$OVERFLOW_SWAP_USED_BYTES,"problem":$PROBLEM,"warning":$WARN,"storage_history_problem":$STORAGE_HISTORY,"memory_pressure_seen_last_24h":$MEMORY_SEEN,"btrfs_baseline_advisory":$BTRFS_ADVISORY,"path":"$OUT"}
EOF

      if [ "$PROBLEM" -eq 1 ]; then
        /etc/monsternix/bin/mnx-notify critical "Monsternix daily health problem" "See $OUT" || true
      elif [ "$WARN" -eq 1 ]; then
        /etc/monsternix/bin/mnx-notify warning "Monsternix daily health warning" "See $OUT" || true
      fi

      logger --journald <<EOF || logger -t logbook "Daily health snapshot written to $OUT" || true
MESSAGE_ID=7298caf8-c31d-569c-a39d-7df6e72a57b4
PRIORITY=5
LOGBOOK_KIND=DAILY_HEALTH_SNAPSHOT
LOGBOOK_VER=2
BUNDLE_PATH=$OUT
MESSAGE=Daily health snapshot written to $OUT
EOF
    '';
  };

#@MNX-DEF path=systemd.timers.logbook-daily-health section=40.14 role=timer ordinal=143
  systemd.timers.logbook-daily-health = {
    description = "Run logbook daily health snapshot";
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnCalendar = "daily";
      RandomizedDelaySec = "45min";
      Persistent = true;
    };
  };

  #########################################################################
  # Logbook: incident scan & bundle (every 15 minutes, cooldown 45 minutes)
  #########################################################################
#@MNX-CHUNK id=40.15 slug=logbook-incident-scanner title="Incident scanner, bundle creation, and cooldown"
#@MNX-DEF path=systemd.services.logbook-incident-scan section=40.15 role=service ordinal=144
  systemd.services.logbook-incident-scan = {
    description = "Scan for kernel/storage/session error bursts and write an incident bundle";
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Group = "logbook";
      UMask = "0027";
      StateDirectoryMode = "2750";
      LogNamespace = "logbook";
      StandardOutput = "journal";
      StandardError = "journal";
      Nice = 15;
      IOSchedulingClass = "idle";
      StateDirectory = "logbook";
    };
    path = [
      pkgs.coreutils
      pkgs.gnugrep
      pkgs.gawk
      pkgs.gnused
      pkgs.findutils
      pkgs.util-linux
      pkgs.systemd
      pkgs.btrfs-progs
      pkgs.smartmontools
      pkgs.nvme-cli
    ];
    script = ''
      set -euo pipefail
      umask 027

      WINDOW="15 minutes ago"
      COOLDOWN_SEC=$((45*60))
      ROOT="/var/lib/logbook"
      mkdir -p "$ROOT/incidents"
      chown root:logbook "$ROOT" "$ROOT/incidents" 2>/dev/null || true
      chmod 2750 "$ROOT" "$ROOT/incidents" 2>/dev/null || true

      COOLDOWN_FILE="$ROOT/incidents/.cooldown"
      now_epoch="$(date +%s)"
      last_epoch=0
      if [ -f "$COOLDOWN_FILE" ]; then
        last_epoch="$(cat "$COOLDOWN_FILE" 2>/dev/null || echo 0)"
      fi

      if [ $((now_epoch - last_epoch)) -lt "$COOLDOWN_SEC" ]; then
        exit 0
      fi

      KERN_RE='Read-error on swap-device|I/O error|Input/output error|blk_update_request|Buffer I/O error|rejecting I/O|resetting link|hard resetting link|SATA link down|nvme.*timeout|nvme.*controller.*down|nvme.*reset|Identify namespace failed|Device not ready|Disabling device after reset failure|CSTS|BTRFS.*(error|warning)|checksum verify failed|csum failed|transaction aborted|parent transid verify failed|read-only.*due to|read-only file system|failed to read stream from kernel|Broken pipe|AER:.*(Fatal|Uncorrected)|Out of memory|oom-kill|Killed process|Memory cgroup out of memory|systemd-oomd|earlyoom.*(sending|killing)'
      JOURNAL_RE='systemd-coredump.socket: Too many incoming connections|signal 7/BUS|Fatal IO error on X server|X connection error received|X connection to .* broken|lightdm.*session closed|Input/output error|Read-only file system|failed to read stream from kernel|Broken pipe|Out of memory|oom-kill|Killed process|Memory cgroup out of memory|systemd-oomd|earlyoom.*(sending|killing)'

      KERN_MATCHES="$(journalctl -k --since "$WINDOW" -p warning..alert 2>/dev/null | grep -E -i "$KERN_RE" | tail -n 100 || true)"
      JOURNAL_MATCHES="$(journalctl --since "$WINDOW" -p warning..alert 2>/dev/null \
        | grep -E -i "$JOURNAL_RE" \
        | grep -E -v -i 'logbook-incident-scan[.]service|Logbook incident bundle written|Incident bundle written to' \
        | tail -n 100 || true)"
      MATCHES="$(printf "%s\n%s\n" "$KERN_MATCHES" "$JOURNAL_MATCHES" | sed '/^[[:space:]]*$/d' | tail -n 160 || true)"

      if [ -z "$MATCHES" ]; then
        exit 0
      fi

      TS="$(date -Is)"
      ID="$(date +%Y%m%dT%H%M%S)"
      DIR="$ROOT/incidents/$ID"
      mkdir -p "$DIR"
      chown root:logbook "$DIR" 2>/dev/null || true
      chmod 2750 "$DIR" 2>/dev/null || true

      printf "%s\n" "$MATCHES" > "$DIR/matches.txt"
      printf "%s\n" "$KERN_MATCHES" > "$DIR/kernel-matches.txt"
      printf "%s\n" "$JOURNAL_MATCHES" > "$DIR/journal-matches.txt"

      journalctl --since "2 hours ago" -p warning..alert -o short-iso > "$DIR/journal.warn-alert.2h.txt" || true
      journalctl -k --since "2 hours ago" -p warning..alert -o short-iso > "$DIR/kernel.warn-alert.2h.txt" || true
      journalctl --since "2 hours ago" -o export > "$DIR/journal.2h.export" || true
      journalctl -k --since "2 hours ago" -o export > "$DIR/kernel.2h.export" || true

      (uname -a || true) > "$DIR/uname.txt"
      (cat /proc/cmdline || true) > "$DIR/cmdline.txt"
      (lsblk -f || true) > "$DIR/lsblk-f.txt"
      (findmnt -a || true) > "$DIR/findmnt.txt"
      (cat /proc/swaps || true) > "$DIR/proc.swaps.txt"
      (swapon --show --bytes || true) > "$DIR/swapon.show.txt"
      (systemctl --failed || true) > "$DIR/systemctl.failed.txt"

      if command -v btrfs >/dev/null 2>&1; then
        for mp in / /mnt/m16-backup-nvme /mnt/m16-new-storage /mnt/m16-old-storage; do
          if findmnt -rn "$mp" >/dev/null 2>&1; then
            safe="$(echo "$mp" | sed 's#^/##; s#[/ ]#_#g; s#^$#root#')"
            [ -n "$safe" ] || safe="root"
            (btrfs device stats "$mp" || true) > "$DIR/btrfs.device.stats.$safe.txt"
            (btrfs scrub status "$mp" || true) > "$DIR/btrfs.scrub.status.$safe.txt"
          fi
        done
      fi

      if command -v smartctl >/dev/null 2>&1; then
        mkdir -p "$DIR/smart"
        chown root:logbook "$DIR/smart" 2>/dev/null || true
        chmod 2750 "$DIR/smart" 2>/dev/null || true
        lsblk -dn -o NAME,TYPE | awk '$2=="disk"{print "/dev/"$1}' | while read -r d; do
          out="$DIR/smart/$(basename "$d").txt"
          (smartctl -H -A -i "$d" || true) > "$out"
        done
      fi

      if command -v nvme >/dev/null 2>&1; then
        mkdir -p "$DIR/nvme"
        chown root:logbook "$DIR/nvme" 2>/dev/null || true
        chmod 2750 "$DIR/nvme" 2>/dev/null || true
        (nvme list || true) > "$DIR/nvme/list.txt"
        for nd in /dev/nvme0 /dev/nvme1; do
          [ -e "$nd" ] || continue
          (nvme smart-log "$nd" || true) > "$DIR/nvme/$(basename "$nd").smart-log.txt"
          (nvme error-log "$nd" || true) > "$DIR/nvme/$(basename "$nd").error-log.txt"
        done
      fi

      cat > "$DIR/index.json" <<EOF
{"timestamp":"$TS","path":"$DIR","window":"$WINDOW","cooldown_sec":$COOLDOWN_SEC}
EOF

      /etc/monsternix/bin/mnx-bundle-manifest create "$DIR" 2

      COOLDOWN_TMP="$COOLDOWN_FILE.$$"
      printf '%s\n' "$now_epoch" > "$COOLDOWN_TMP"
      chown root:logbook "$COOLDOWN_TMP"
      chmod 0640 "$COOLDOWN_TMP"
      mv -f "$COOLDOWN_TMP" "$COOLDOWN_FILE"

      /etc/monsternix/bin/mnx-notify critical "Logbook incident bundle written" "$DIR" || true

      logger --journald <<EOF || logger -t logbook "Incident bundle written to $DIR" || true
MESSAGE_ID=6f2fac7c-c7dd-58be-9798-c9afafa166bc
PRIORITY=3
LOGBOOK_KIND=INCIDENT_BUNDLE_WRITTEN
LOGBOOK_VER=2
BUNDLE_PATH=$DIR
MESSAGE=Incident bundle written to $DIR
EOF
    '';
  };

#@MNX-DEF path=systemd.timers.logbook-incident-scan section=40.15 role=timer ordinal=145
  systemd.timers.logbook-incident-scan = {
    description = "Run logbook incident scan periodically";
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnBootSec = "10min";
      OnUnitActiveSec = "15min";
      RandomizedDelaySec = "2min";
    };
  };

  #########################################################################
  # Logbook: pstore collection (crash breadcrumbs, if present)
  #########################################################################
#@MNX-CHUNK id=40.16 slug=logbook-pstore title="Kernel pstore crash-artifact collection"
#@MNX-DEF path=systemd.services.logbook-pstore-collect section=40.16 role=service ordinal=146
  systemd.services.logbook-pstore-collect = {
    description = "Collect kernel pstore contents into logbook (if present)";
    wantedBy = [ "multi-user.target" ];
    after = [ "local-fs.target" ];
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Group = "logbook";
      UMask = "0027";
      StateDirectoryMode = "2750";
      LogNamespace = "logbook";
      StandardOutput = "journal";
      StandardError = "journal";
      StateDirectory = "logbook";
    };
    path = [ pkgs.coreutils pkgs.findutils pkgs.util-linux pkgs.systemd ];
    script = ''
      set -euo pipefail
      umask 027

      SRC="/sys/fs/pstore"
      [ -d "$SRC" ] || exit 0

      # If empty, do nothing
      if ! find "$SRC" -maxdepth 1 -type f -print -quit | grep -q .; then
        exit 0
      fi

      BOOT_ID="$(cat /proc/sys/kernel/random/boot_id)"
      TS="$(date -Is)"
      DIR="/var/lib/logbook/pstore/$BOOT_ID"
      if true; then
        install -d -m 2750 -o root -g logbook /var/lib/logbook/pstore || true
        chown root:logbook /var/lib/logbook /var/lib/logbook/pstore 2>/dev/null || true
        chmod 2750 /var/lib/logbook /var/lib/logbook/pstore 2>/dev/null || true
      fi
      mkdir -p "$DIR"
      if true; then
        chown root:logbook "$DIR" 2>/dev/null || true
        chmod 2750 "$DIR" 2>/dev/null || true
      fi

      cp -a "$SRC"/. "$DIR"/ 2>/dev/null || true

      logger --journald <<EOF || logger -t logbook "pstore artifacts copied to $DIR" || true
MESSAGE_ID=e623376f-1b33-50f1-898e-4e31b0f13f12
PRIORITY=4
LOGBOOK_KIND=PSTORE_FOUND
LOGBOOK_VER=1
BOOT_ID=$BOOT_ID
BUNDLE_PATH=$DIR
MESSAGE=pstore artifacts copied to $DIR
EOF
    '';
  };

  #########################################################################
  # Logbook: weekly journal verification (low priority)
  #########################################################################
#@MNX-CHUNK id=40.17 slug=logbook-journal-verify title="Journal verification and base metrics exporter"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-journal-integrity" section=40.17 role=generated-program ordinal=147
  environment.etc."monsternix/bin/mnx-journal-integrity" = {
    source = pkgs.writeTextFile {
      name = "mnx-journal-integrity";
      executable = true;
      text = ''
      #!${pkgs.python3}/bin/python3
      from __future__ import annotations
      
      import argparse
      import datetime as dt
      import grp
      import hashlib
      import json
      import os
      import pathlib
      import re
      import shutil
      import stat
      import subprocess
      import sys
      import tempfile
      import time
      from typing import Any
      
      SCHEMA = 4
      STATE_SCHEMA = "mnx.journal-integrity.v4"
      PREVIOUS_STATE_SCHEMA = "mnx.journal-integrity.v3"
      LEGACY_STATE_SCHEMA = "mnx.journal-integrity.v2"
      EARLIEST_STATE_SCHEMA = "mnx.journal-integrity.v1"
      ANCHOR_SCHEMA = "mnx.journal-integrity.anchor.v1"
      BOUNDARY_SCHEMA = "mnx.journal-integrity.recovery-boundary.v1"
      RESET_SCHEMA = "mnx.journal-integrity.default-reset.v1"
      RESET_ATTEMPT_SCHEMA = "mnx.journal-integrity.default-reset-attempt.v1"
      STATE_ROOT = pathlib.Path(os.environ.get("MNX_JOURNAL_STATE_ROOT", "/var/lib/monsternix/journal-integrity"))
      INCIDENT_ROOT = pathlib.Path(os.environ.get("MNX_JOURNAL_INCIDENT_ROOT", "/var/lib/logbook/incidents"))
      RECOVERY_ROOT = pathlib.Path(os.environ.get("MNX_JOURNAL_RECOVERY_ROOT", str(STATE_ROOT / "recovery")))
      METRIC_PATH = pathlib.Path(os.environ.get("MNX_JOURNAL_METRIC_PATH", "/var/lib/node-exporter-textfile/monsternix_journal_integrity.prom"))
      JOURNALCTL = pathlib.Path(os.environ.get("MNX_JOURNALCTL", "${pkgs.systemd}/bin/journalctl"))
      LOGGER = pathlib.Path(os.environ.get("MNX_LOGGER", "${pkgs.util-linux}/bin/logger"))
      NOTIFY = pathlib.Path(os.environ.get("MNX_NOTIFY", "/etc/monsternix/bin/mnx-notify"))
      BUNDLE_MANIFEST = pathlib.Path(os.environ.get("MNX_BUNDLE_MANIFEST", "/etc/monsternix/bin/mnx-bundle-manifest"))
      RUNNING_LINK = pathlib.Path(os.environ.get("MNX_RUNNING_LINK", "/run/current-system"))
      DEFAULT_LINK = pathlib.Path(os.environ.get("MNX_DEFAULT_LINK", "/nix/var/nix/profiles/system"))
      CONFIG_PATH = pathlib.Path(os.environ.get("MNX_CONFIG", "/etc/nixos/configuration.nix"))
      EXPECTED_LEGACY_EVIDENCE = pathlib.Path(os.environ.get("MNX_EXPECTED_LEGACY_JOURNAL_EVIDENCE", "/var/lib/logbook/incidents/journal-verify-20260816T121332122224Z"))
      EXPECTED_BLOCKER_EVIDENCE = pathlib.Path(os.environ.get("MNX_EXPECTED_BLOCKER_JOURNAL_EVIDENCE", "/var/lib/logbook/incidents/journal-verify-20260824T060416682362Z"))
      EXPECTED_ANCHOR_SHA256 = os.environ.get("MNX_EXPECTED_JOURNAL_ANCHOR_SHA256", "9651b6f6b0b40382ff3f3b76a5b498626acedf81c5cea1f5ce514534597df937")
      EXPECTED_BLOCKER_SOURCE_SHA256 = os.environ.get("MNX_EXPECTED_JOURNAL_BLOCKER_SOURCE_SHA256", "fe87a9ca960f3c2ae6da6dc49288173f15e8334795ce00713d4b3fcfcad23c66")
      EXPECTED_BLOCKER_SYSTEM = os.environ.get("MNX_EXPECTED_JOURNAL_BLOCKER_SYSTEM", "/nix/store/3nq0h18978ciazi5cwavacb8gx2qm21b-nixos-system-monster-16-25.11pre-git")
      EXPECTED_RESET_OWNER_STAGE = os.environ.get("MNX_EXPECTED_JOURNAL_RESET_OWNER_STAGE", "62")
      EXPECTED_RESET_OWNER_SOURCE_SHA256 = os.environ.get("MNX_EXPECTED_JOURNAL_RESET_OWNER_SOURCE_SHA256", "1fc3a1230e4726bfcdf1711ed648c3976b8c89a4039a231e28ac55324b33cd44")
      EXPECTED_RESET_OWNER_SYSTEM = os.environ.get("MNX_EXPECTED_JOURNAL_RESET_OWNER_SYSTEM", "/nix/store/zkj0gfkzpvdrf323j9irbc612jgrzr03-nixos-system-monster-16-25.11pre-git")
      ACTIVE_SYSTEM_JOURNAL = pathlib.Path(os.environ.get("MNX_ACTIVE_SYSTEM_JOURNAL", "/var/log/journal/dda3767314624f9890868a8fa18e887e/system.journal"))
      JOURNAL_SEARCH_ROOTS = tuple(pathlib.Path(item) for item in os.environ.get("MNX_JOURNAL_SEARCH_ROOTS", "/var/log/journal:/run/log/journal").split(":") if item)
      VERIFICATION_MODEL = "closed-archive-verify-active-query-v1"
      ACTIVE_QUERY_TIMEOUT_SECONDS = 2 * 60
      OBSERVATION_MAX_ATTEMPTS = 3
      OBSERVATION_RETRY_SECONDS = 0.25
      ANCHOR_PATH = STATE_ROOT / "anchor.json"
      BOUNDARY_PATH = STATE_ROOT / "recovery-boundary.json"
      RESET_PATH = STATE_ROOT / "default-reset.json"
      RESET_ATTEMPT_PATH = STATE_ROOT / "default-reset-attempt.json"
      GROUP_NAME = os.environ.get("MNX_JOURNAL_GROUP", "logbook")
      MAX_CAPTURE_BYTES = 4 * 1024 * 1024
      MAX_EVIDENCE_PRINT_BYTES = 256 * 1024
      VERIFY_TIMEOUT_SECONDS = 15 * 60
      ROTATE_TIMEOUT_SECONDS = 2 * 60
      ROTATE_WAIT_SECONDS = 45
      ROTATION_MAX_JOURNAL_DIR_BYTES = 3 * 1024 * 1024 * 1024
      ROTATION_MIN_FREE_BYTES = 2 * 1024 * 1024 * 1024
      PROBLEM_RE = re.compile(
          r"(?im)(^FAIL:|CORRUPT|File corruption detected|Bad message|Invalid data object|"
          r"references invalid entry|invalid entry at|unused data|truncated|unexpected EOF|"
          r"sequence number|sealing state|hash entry)"
      )
      ABSENT_RE = re.compile(r"(?im)(No journal files were found|No entries)")
      ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
      HEX64_RE = re.compile(r"^[0-9a-f]{64}$")
      INVALID_ENTRY_RE = re.compile(r"^(?P<object>[0-9a-fA-F]+): Data object references invalid entry at (?P<target>[0-9a-fA-F]+)$")
      CORRUPTION_RE = re.compile(r"^File corruption detected at (?P<path>/.*):(?P<offset>[0-9]+) \(of (?P<size>[0-9]+) bytes, (?P<percent>[^)]+)\)\.$")
      FAIL_BAD_MESSAGE_RE = re.compile(r"^FAIL: (?P<path>/.*) \(Bad message\)$")
      PASS_FILE_RE = re.compile(r"^PASS: (?P<path>/.*)$")
      SUMMARY_STATUSES = {"clean", "review-required", "malfunction"}
      NAMESPACE_STATUSES = {"clean", "review-required", "malfunction", "absent"}
      CLEAN_FORWARD_STATUSES = {
          "unanchored",
          "legacy-damage-only",
          "legacy-damage-no-longer-observed",
          "known-archived-damage-clean-forward",
          "known-damage-no-longer-observed-clean-forward",
          "new-damage-review-required",
          "clean",
          "unknown-observer-malfunction",
      }
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.class.journalintegrityerror kind=class title="Python class JournalIntegrityError"
      class JournalIntegrityError(RuntimeError):
          pass
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.require kind=function title="Python function require"
      def require(condition: bool, message: str) -> None:
          if not condition:
              raise JournalIntegrityError(message)
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.canonical_json kind=function title="Python function canonical_json"
      def canonical_json(value: Any) -> bytes:
          return (json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True) + "\n").encode("utf-8")
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.sha256_bytes kind=function title="Python function sha256_bytes"
      def sha256_bytes(data: bytes) -> str:
          return hashlib.sha256(data).hexdigest()
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.sha256_file kind=function title="Python function sha256_file"
      def sha256_file(path: pathlib.Path) -> str:
          digest = hashlib.sha256()
          with path.open("rb") as handle:
              while True:
                  chunk = handle.read(1024 * 1024)
                  if not chunk:
                      break
                  digest.update(chunk)
          return digest.hexdigest()
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.bounded_bytes kind=function title="Python function bounded_bytes"
      def bounded_bytes(data: bytes, limit: int = MAX_CAPTURE_BYTES) -> bytes:
          if len(data) <= limit:
              return data
          half = max(1, (limit - 128) // 2)
          marker = f"\n--- MNX OUTPUT TRUNCATED: original_bytes={len(data)} retained_bytes={half * 2} ---\n".encode("utf-8")
          return data[:half] + marker + data[-half:]
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.safe_resolve kind=function title="Python function safe_resolve"
      def safe_resolve(path: pathlib.Path) -> str:
          try:
              return str(path.resolve(strict=True))
          except OSError:
              return "unresolved"
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.read_source_sha kind=function title="Python function read_source_sha"
      def read_source_sha() -> str:
          try:
              return sha256_file(CONFIG_PATH)
          except OSError:
              return "unreadable"
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.read_candidate_stage kind=function title="Python function read_candidate_stage"
      def read_candidate_stage() -> str:
          try:
              text = CONFIG_PATH.read_text(encoding="utf-8")
          except OSError as exc:
              raise JournalIntegrityError(f"accepted journal anchor source is unreadable: {CONFIG_PATH}: {exc}") from exc
          matches = re.findall(r"(?m)^#@MNX-OFFICE candidate_stage=([1-9][0-9]*)$", text)
          require(len(matches) == 1, "accepted journal anchor source has no unique office stage")
          return matches[0]
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.classify_result kind=function title="Python function classify_result"
      def classify_result(namespace: str, rc: int, text: str) -> str:
          if namespace == "logbook" and ABSENT_RE.search(text):
              return "absent"
          if PROBLEM_RE.search(text):
              return "review-required"
          if rc == 0:
              return "clean"
          return "malfunction"
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.normalize_problem_line kind=function title="Python function normalize_problem_line"
      def normalize_problem_line(raw: str) -> str:
          line = ANSI_RE.sub("", raw.strip())
          line = re.sub(r"\s+", " ", line)
          line = re.sub(r"(?<![0-9])[0-9]{1,3}%(?![0-9])", "<percent>", line)
          return line[:2048]
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.problem_lines kind=function title="Python function problem_lines"
      def problem_lines(text: str) -> list[str]:
          selected: list[str] = []
          seen: set[str] = set()
          for raw in text.splitlines():
              if not PROBLEM_RE.search(raw):
                  continue
              line = normalize_problem_line(raw)
              if not line or line in seen:
                  continue
              seen.add(line)
              selected.append(line)
              if len(selected) >= 40:
                  break
          return selected
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.parse-file-results kind=function title="Python function parse_file_results"
      def parse_file_results(text: str) -> list[dict[str, str]]:
          records: dict[str, str] = {}
          for raw in text.splitlines():
              line = normalize_problem_line(raw)
              match = PASS_FILE_RE.fullmatch(line)
              if match:
                  records.setdefault(match.group("path"), "clean")
                  continue
              match = FAIL_BAD_MESSAGE_RE.fullmatch(line)
              if match:
                  records[match.group("path")] = "review-required"
          return [{"path": path, "status": records[path]} for path in sorted(records)]
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.semantic-identities-from-lines kind=function title="Python function semantic_identities_from_lines"
      def semantic_identities_from_lines(namespace: str, lines: list[str]) -> list[dict[str, Any]]:
          normalized = [normalize_problem_line(line) for line in lines if normalize_problem_line(line)]
          consumed: set[int] = set()
          identities: list[dict[str, Any]] = []
          for index, line in enumerate(normalized):
              corruption = CORRUPTION_RE.fullmatch(line)
              if corruption is None:
                  continue
              invalid_index = None
              invalid_match = None
              for candidate in range(index - 1, -1, -1):
                  if candidate in consumed:
                      continue
                  parsed = INVALID_ENTRY_RE.fullmatch(normalized[candidate])
                  if parsed is not None:
                      invalid_index = candidate
                      invalid_match = parsed
                      break
                  if PROBLEM_RE.search(normalized[candidate]):
                      break
              fail_index = None
              for candidate in range(index + 1, len(normalized)):
                  if candidate in consumed:
                      continue
                  parsed = FAIL_BAD_MESSAGE_RE.fullmatch(normalized[candidate])
                  if parsed is not None and parsed.group("path") == corruption.group("path"):
                      fail_index = candidate
                      break
                  if PROBLEM_RE.search(normalized[candidate]):
                      break
              if invalid_index is None or invalid_match is None or fail_index is None:
                  continue
              material = {
                  "namespace": namespace,
                  "kind": "journal-bad-message-invalid-entry",
                  "invalid_object": invalid_match.group("object").lower(),
                  "invalid_target": invalid_match.group("target").lower(),
                  "corruption_offset": int(corruption.group("offset")),
              }
              identities.append({
                  **material,
                  "sha256": sha256_bytes(canonical_json(material)),
                  "observed_path": corruption.group("path"),
                  "observed_size": int(corruption.group("size")),
                  "problem_lines": [normalized[invalid_index], line, normalized[fail_index]],
              })
              consumed.update({invalid_index, index, fail_index})
          for index, line in enumerate(normalized):
              if index in consumed:
                  continue
              material = {"namespace": namespace, "kind": "problem-line", "line": line}
              identities.append({
                  **material,
                  "sha256": sha256_bytes(canonical_json(material)),
                  "observed_path": "unknown",
                  "problem_lines": [line],
              })
          identities.sort(key=lambda item: (str(item["namespace"]), str(item["kind"]), str(item["sha256"]), str(item.get("observed_path", ""))))
          return identities
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.semantic-identities-from-records kind=function title="Python function semantic_identities_from_records"
      def semantic_identities_from_records(records: list[dict[str, Any]]) -> list[dict[str, Any]]:
          identities: list[dict[str, Any]] = []
          for item in sorted(records, key=lambda entry: str(entry.get("namespace", ""))):
              if item.get("status") != "review-required":
                  continue
              lines = item.get("problem_lines", [])
              require(isinstance(lines, list), "journal semantic identity source lines are invalid")
              identities.extend(semantic_identities_from_lines(str(item.get("namespace", "unknown")), [str(line) for line in lines]))
          return identities
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.semantic-problem-identities kind=function title="Python function semantic_problem_identities"
      def semantic_problem_identities(summary: dict[str, Any]) -> list[dict[str, Any]]:
          validate_summary(summary)
          return semantic_identities_from_records(summary["namespaces"])
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.semantic-identity-key kind=function title="Python function semantic_identity_key"
      def semantic_identity_key(identity: dict[str, Any]) -> str:
          return f"{identity['namespace']}:{identity['kind']}:{identity['sha256']}"
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.run-capture kind=function title="Python function run_capture"
      def run_capture(command: list[str], timeout: int = VERIFY_TIMEOUT_SECONDS, input_text: str | None = None) -> tuple[int, bytes, str | None]:
          try:
              completed = subprocess.run(
                  command,
                  input=input_text.encode("utf-8") if input_text is not None else None,
                  stdout=subprocess.PIPE,
                  stderr=subprocess.STDOUT,
                  timeout=timeout,
                  check=False,
              )
              return completed.returncode, bounded_bytes(completed.stdout or b""), None
          except (OSError, subprocess.TimeoutExpired) as exc:
              rc = 124 if isinstance(exc, subprocess.TimeoutExpired) else 127
              return rc, f"MNX_JOURNAL_COMMAND_ERROR: {exc}\n".encode("utf-8"), str(exc)
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.run-verify-path kind=function title="Python function run_verify_path"
      def run_verify_path(path: pathlib.Path, namespace: str) -> dict[str, Any]:
          rc, raw, command_error = run_capture([str(JOURNALCTL), f"--file={path}", "--verify"])
          text = raw.decode("utf-8", errors="replace")
          return {
              "path": str(path),
              "status": classify_result(namespace, rc, text),
              "verify_rc": rc,
              "output_bytes": len(raw),
              "output_sha256": sha256_bytes(raw),
              "problem_lines": problem_lines(text),
              "file_results": parse_file_results(text),
              "command_error": command_error,
              "output": text,
          }


      #@MNX-PART id=40.17.mnx-journal-integrity.function.run-journal-header kind=function title="Python function run_journal_header"
      def run_journal_header(path: pathlib.Path) -> dict[str, Any]:
          rc, raw, command_error = run_capture([str(JOURNALCTL), f"--file={path}", "--header"], timeout=ROTATE_TIMEOUT_SECONDS)
          return {
              "path": str(path),
              "rc": rc,
              "output_bytes": len(raw),
              "output_sha256": sha256_bytes(raw),
              "command_error": command_error,
              "output": raw.decode("utf-8", errors="replace"),
          }


      #@MNX-PART id=40.17.mnx-journal-integrity.class.journalobservationretry kind=class title="Python class JournalObservationRetry"
      class JournalObservationRetry(RuntimeError):
          pass


      #@MNX-PART id=40.17.mnx-journal-integrity.function.journal-object-identity kind=function title="Python function journal_object_identity"
      def journal_object_identity(path: pathlib.Path) -> tuple[int, int]:
          metadata = path.lstat()
          require(stat.S_ISREG(metadata.st_mode) and not path.is_symlink(), f"journal file object is unsafe: {path}")
          require(metadata.st_uid == 0, f"journal file is not root-owned: {path}")
          return int(metadata.st_dev), int(metadata.st_ino)


      #@MNX-PART id=40.17.mnx-journal-integrity.function.journal-namespace-files kind=function title="Python function journal_namespace_files"
      def journal_namespace_files(namespace: str) -> tuple[list[pathlib.Path], list[pathlib.Path], dict[str, tuple[int, int]]]:
          require(namespace in {"default", "logbook"}, f"unsupported journal namespace: {namespace}")
          active: list[pathlib.Path] = []
          archived: list[pathlib.Path] = []
          identities: dict[str, tuple[int, int]] = {}
          seen: set[str] = set()
          for root in JOURNAL_SEARCH_ROOTS:
              if not root.exists() and not root.is_symlink():
                  continue
              metadata = root.lstat()
              require(stat.S_ISDIR(metadata.st_mode) and not root.is_symlink(), f"journal search root is unsafe: {root}")
              require(metadata.st_uid == 0, f"journal search root is not root-owned: {root}")
              for directory in sorted(root.iterdir(), key=lambda item: item.name):
                  try:
                      directory_metadata = directory.lstat()
                  except OSError as exc:
                      raise JournalIntegrityError(f"journal namespace directory is unreadable: {directory}: {exc}") from exc
                  if not stat.S_ISDIR(directory_metadata.st_mode):
                      continue
                  require(not directory.is_symlink(), f"journal namespace directory is a symlink: {directory}")
                  require(directory_metadata.st_uid == 0, f"journal namespace directory is not root-owned: {directory}")
                  is_logbook = directory.name.endswith(".logbook")
                  if (namespace == "logbook") != is_logbook:
                      continue
                  for child in sorted(directory.iterdir(), key=lambda item: item.name):
                      if not (child.name.endswith(".journal") or child.name.endswith(".journal~")):
                          continue
                      try:
                          resolved = str(child.resolve(strict=True))
                          identity = journal_object_identity(child)
                      except (OSError, JournalIntegrityError) as exc:
                          raise JournalObservationRetry(f"journal file changed during enumeration: {child}: {exc}") from exc
                      if resolved in seen:
                          continue
                      seen.add(resolved)
                      identities[resolved] = identity
                      if child.name.endswith(".journal") and "@" not in child.name:
                          active.append(child)
                      else:
                          archived.append(child)
          return sorted(active, key=str), sorted(archived, key=str), identities


      #@MNX-PART id=40.17.mnx-journal-integrity.function.run-active-query kind=function title="Python function run_active_query"
      def run_active_query(path: pathlib.Path) -> dict[str, Any]:
          rc, raw, command_error = run_capture(
              [str(JOURNALCTL), f"--file={path}", "--no-pager", "--lines=1", "--output=export"],
              timeout=ACTIVE_QUERY_TIMEOUT_SECONDS,
          )
          text = raw.decode("utf-8", errors="replace")
          clean = rc == 0 or ABSENT_RE.search(text) is not None
          return {
              "path": str(path),
              "status": "clean" if clean else "malfunction",
              "query_rc": rc,
              "output_bytes": len(raw),
              "output_sha256": sha256_bytes(raw),
              "command_error": command_error,
              "output": text,
          }


      #@MNX-PART id=40.17.mnx-journal-integrity.function.run-verify-once kind=function title="Python function run_verify_once"
      def run_verify_once(namespace: str) -> dict[str, Any]:
          active_files, archived_files, before_identities = journal_namespace_files(namespace)
          if namespace == "logbook" and not active_files and not archived_files:
              empty = b"MNX_JOURNAL_NAMESPACE_ABSENT: logbook\n"
              return {
                  "namespace": namespace,
                  "status": "absent",
                  "verify_rc": 0,
                  "output_bytes": len(empty),
                  "output_sha256": sha256_bytes(empty),
                  "problem_lines": [],
                  "file_results": [],
                  "command_error": None,
                  "verification_model": VERIFICATION_MODEL,
                  "active_journal_verify_run": False,
                  "active_query_count": 0,
                  "archived_verify_count": 0,
                  "namespace_identity_stability_checked": True,
                  "observation_attempt_count": 1,
                  "output": empty.decode("utf-8"),
              }
          if namespace == "default" and not active_files and not archived_files:
              raise JournalIntegrityError("default journal namespace has no regular journal files")

          output_parts = [
              f"MNX_JOURNAL_VERIFICATION_MODEL={VERIFICATION_MODEL}\n",
              "active_journal_verify_run=no\n",
              "namespace_wide_verify_run=no\n",
              "namespace_identity_stability_checked=yes\n",
              f"active_query_count={len(active_files)}\n",
              f"archived_verify_count={len(archived_files)}\n",
          ]
          file_results: list[dict[str, str]] = []
          selected_problems: list[str] = []
          seen_problems: set[str] = set()
          errors: list[str] = []
          review_required = False
          malfunction = False

          for path in archived_files:
              resolved = str(path.resolve(strict=True))
              expected_identity = before_identities[resolved]
              if journal_object_identity(path) != expected_identity:
                  raise JournalObservationRetry(f"archived journal identity changed before verification: {path}")
              result = run_verify_path(path, namespace)
              output_parts.append(f"--- archived verify: {path} ---\n{result['output']}")
              try:
                  after_identity = journal_object_identity(path)
              except (OSError, JournalIntegrityError) as exc:
                  raise JournalObservationRetry(f"archived journal disappeared during verification: {path}: {exc}") from exc
              if after_identity != expected_identity:
                  raise JournalObservationRetry(f"archived journal identity changed during verification: {path}")
              if result["status"] == "malfunction":
                  malfunction = True
                  errors.append(f"archived verify failed: {path}: rc={result['verify_rc']} error={result['command_error'] or 'none'}")
              elif result["status"] == "review-required":
                  review_required = True
                  file_results.append({"path": str(path), "status": "review-required"})
              else:
                  file_results.append({"path": str(path), "status": "clean"})
              for line in result["problem_lines"]:
                  if line not in seen_problems:
                      seen_problems.add(line)
                      selected_problems.append(line)

          for path in active_files:
              resolved = str(path.resolve(strict=True))
              expected_identity = before_identities[resolved]
              if journal_object_identity(path) != expected_identity:
                  raise JournalObservationRetry(f"active journal identity changed before query: {path}")
              result = run_active_query(path)
              output_parts.append(f"--- active query (no verify): {path} ---\n{result['output']}")
              try:
                  after_identity = journal_object_identity(path)
              except (OSError, JournalIntegrityError) as exc:
                  raise JournalObservationRetry(f"active journal rotated during query: {path}: {exc}") from exc
              if after_identity != expected_identity:
                  raise JournalObservationRetry(f"active journal identity changed during query: {path}")
              if result["status"] != "clean":
                  malfunction = True
                  errors.append(f"active journal query failed: {path}: rc={result['query_rc']} error={result['command_error'] or 'none'}")
              else:
                  file_results.append({"path": str(path), "status": "clean"})

          _, _, after_identities = journal_namespace_files(namespace)
          if before_identities != after_identities:
              raise JournalObservationRetry(f"journal namespace identity set changed during observation: {namespace}")

          if malfunction:
              status_value = "malfunction"
              verify_rc = 2
          elif review_required:
              status_value = "review-required"
              verify_rc = 1
          else:
              status_value = "clean"
              verify_rc = 0
          output_raw = bounded_bytes("".join(output_parts).encode("utf-8"))
          return {
              "namespace": namespace,
              "status": status_value,
              "verify_rc": verify_rc,
              "output_bytes": len(output_raw),
              "output_sha256": sha256_bytes(output_raw),
              "problem_lines": selected_problems[:40],
              "file_results": sorted(file_results, key=lambda item: item["path"]),
              "command_error": "; ".join(errors) if errors else None,
              "verification_model": VERIFICATION_MODEL,
              "active_journal_verify_run": False,
              "active_query_count": len(active_files),
              "archived_verify_count": len(archived_files),
              "namespace_identity_stability_checked": True,
              "observation_attempt_count": 1,
              "output": output_raw.decode("utf-8", errors="replace"),
          }


      #@MNX-PART id=40.17.mnx-journal-integrity.function.run_verify kind=function title="Python function run_verify"
      def run_verify(namespace: str) -> dict[str, Any]:
          retry_reasons: list[str] = []
          for attempt in range(1, OBSERVATION_MAX_ATTEMPTS + 1):
              try:
                  result = run_verify_once(namespace)
                  result["observation_attempt_count"] = attempt
                  if retry_reasons:
                      result["output"] = (
                          "MNX_JOURNAL_OBSERVATION_RETRIED=yes\n"
                          + "\n".join(f"MNX_JOURNAL_RETRY_REASON={reason}" for reason in retry_reasons)
                          + "\n"
                          + str(result["output"])
                      )
                      raw = bounded_bytes(str(result["output"]).encode("utf-8"))
                      result["output"] = raw.decode("utf-8", errors="replace")
                      result["output_bytes"] = len(raw)
                      result["output_sha256"] = sha256_bytes(raw)
                  return result
              except JournalObservationRetry as exc:
                  retry_reasons.append(f"attempt={attempt} {exc}")
                  if attempt < OBSERVATION_MAX_ATTEMPTS:
                      time.sleep(OBSERVATION_RETRY_SECONDS)
                      continue
              except (JournalIntegrityError, OSError) as exc:
                  retry_reasons.append(f"attempt={attempt} {exc}")
                  break
          raw = bounded_bytes(("MNX_JOURNAL_OBSERVATION_RETRY_EXHAUSTED: " + " | ".join(retry_reasons) + "\n").encode("utf-8"))
          return {
              "namespace": namespace,
              "status": "malfunction",
              "verify_rc": 2,
              "output_bytes": len(raw),
              "output_sha256": sha256_bytes(raw),
              "problem_lines": [],
              "file_results": [],
              "command_error": "; ".join(retry_reasons),
              "verification_model": VERIFICATION_MODEL,
              "active_journal_verify_run": False,
              "active_query_count": 0,
              "archived_verify_count": 0,
              "namespace_identity_stability_checked": True,
              "observation_attempt_count": len(retry_reasons),
              "output": raw.decode("utf-8", errors="replace"),
          }


      #@MNX-PART id=40.17.mnx-journal-integrity.function.overall_status kind=function title="Python function overall_status"
      def overall_status(results: list[dict[str, Any]]) -> str:
          statuses = {str(item["status"]) for item in results}
          if "malfunction" in statuses:
              return "malfunction"
          if "review-required" in statuses:
              return "review-required"
          return "clean"
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.ensure_dir kind=function title="Python function ensure_dir"
      def ensure_dir(path: pathlib.Path, mode: int, gid: int) -> None:
          created = False
          if path.exists() or path.is_symlink():
              metadata = path.lstat()
              require(stat.S_ISDIR(metadata.st_mode) and not path.is_symlink(), f"unsafe directory object: {path}")
              require(metadata.st_uid == 0, f"directory is not root-owned: {path}")
          else:
              path.mkdir(parents=True, exist_ok=False)
              created = True
              metadata = path.lstat()
          if metadata.st_uid != 0 or metadata.st_gid != gid:
              os.chown(path, 0, gid)
              metadata = path.lstat()
          if stat.S_IMODE(metadata.st_mode) != mode:
              os.chmod(path, mode)
          if created and path.parent != path:
              fsync_directory(path.parent)
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.fsync-directory kind=function title="Python function fsync_directory"
      def fsync_directory(path: pathlib.Path) -> None:
          descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
          try:
              os.fsync(descriptor)
          finally:
              os.close(descriptor)
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.write_file kind=function title="Python function write_file"
      def write_file(path: pathlib.Path, data: bytes, mode: int, gid: int) -> None:
          with path.open("wb") as handle:
              handle.write(data)
              handle.flush()
              os.fsync(handle.fileno())
          os.chown(path, 0, gid)
          os.chmod(path, mode)
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.atomic_write kind=function title="Python function atomic_write"
      def atomic_write(path: pathlib.Path, data: bytes, mode: int, gid: int) -> None:
          ensure_dir(path.parent, 0o750, gid)
          descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
          temporary = pathlib.Path(temporary_name)
          try:
              with os.fdopen(descriptor, "wb") as handle:
                  handle.write(data)
                  handle.flush()
                  os.fsync(handle.fileno())
              os.chown(temporary, 0, gid)
              os.chmod(temporary, mode)
              os.replace(temporary, path)
              directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
              try:
                  os.fsync(directory_fd)
              finally:
                  os.close(directory_fd)
          finally:
              try:
                  temporary.unlink()
              except FileNotFoundError:
                  pass
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.atomic_create_once kind=function title="Python function atomic_create_once"
      def atomic_create_once(path: pathlib.Path, data: bytes, mode: int, gid: int) -> bool:
          ensure_dir(path.parent, 0o750, gid)
          descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
          temporary = pathlib.Path(temporary_name)
          try:
              with os.fdopen(descriptor, "wb") as handle:
                  handle.write(data)
                  handle.flush()
                  os.fsync(handle.fileno())
              os.chown(temporary, 0, gid)
              os.chmod(temporary, mode)
              try:
                  os.link(temporary, path, follow_symlinks=False)
                  created = True
              except FileExistsError:
                  created = False
              directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
              try:
                  os.fsync(directory_fd)
              finally:
                  os.close(directory_fd)
              return created
          finally:
              try:
                  temporary.unlink()
              except FileNotFoundError:
                  pass
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.secure_regular_file kind=function title="Python function secure_regular_file"
      def secure_regular_file(path: pathlib.Path, allowed_modes: set[int] | None = None) -> os.stat_result:
          metadata = path.lstat()
          require(stat.S_ISREG(metadata.st_mode) and not path.is_symlink(), f"unsafe non-regular evidence object: {path}")
          require(metadata.st_uid == 0, f"evidence object is not root-owned: {path}")
          if allowed_modes is not None:
              require(stat.S_IMODE(metadata.st_mode) in allowed_modes, f"unsafe evidence mode for {path}: {oct(stat.S_IMODE(metadata.st_mode))}")
          return metadata
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.validate-summary kind=function title="Python function validate_summary"
      def validate_summary(value: dict[str, Any]) -> dict[str, Any]:
          require(isinstance(value, dict), "journal summary is not an object")
          schema_value = value.get("schema")
          require(schema_value in {STATE_SCHEMA, PREVIOUS_STATE_SCHEMA, LEGACY_STATE_SCHEMA, EARLIEST_STATE_SCHEMA}, "journal summary has an unexpected schema")
          require(value.get("overall_status") in SUMMARY_STATUSES, "journal summary has an invalid overall status")
          namespaces = value.get("namespaces")
          require(isinstance(namespaces, list) and len(namespaces) == 2, "journal summary must contain exactly two namespace records")
          names: list[str] = []
          for item in namespaces:
              require(isinstance(item, dict), "journal namespace record is not an object")
              namespace = item.get("namespace")
              require(namespace in {"default", "logbook"}, "journal namespace name is invalid")
              names.append(str(namespace))
              require(item.get("status") in NAMESPACE_STATUSES, f"journal namespace status is invalid: {namespace}")
              require(isinstance(item.get("verify_rc"), int), f"journal verify rc is invalid: {namespace}")
              require(isinstance(item.get("output_bytes"), int) and 0 <= int(item["output_bytes"]) <= MAX_CAPTURE_BYTES + 256, f"journal output size is invalid: {namespace}")
              require(isinstance(item.get("output_sha256"), str) and HEX64_RE.fullmatch(str(item["output_sha256"])) is not None, f"journal output digest is invalid: {namespace}")
              lines = item.get("problem_lines")
              require(isinstance(lines, list) and len(lines) <= 40, f"journal problem line list is invalid: {namespace}")
              for line in lines:
                  require(isinstance(line, str) and 0 < len(line.encode("utf-8")) <= 4096, f"journal problem line is invalid: {namespace}")
              file_records = item.get("file_results", [])
              require(isinstance(file_records, list) and len(file_records) <= 4096, f"journal file result list is invalid: {namespace}")
              previous_path = ""
              for record in file_records:
                  require(isinstance(record, dict) and set(record) == {"path", "status"}, f"journal file result record is invalid: {namespace}")
                  path = record.get("path")
                  require(isinstance(path, str) and path.startswith("/") and len(path.encode("utf-8")) <= 4096, f"journal file result path is invalid: {namespace}")
                  require(record.get("status") in {"clean", "review-required"}, f"journal file result status is invalid: {namespace}")
                  require(path > previous_path, f"journal file results are not canonical: {namespace}")
                  previous_path = path
              if schema_value == STATE_SCHEMA:
                  require("file_results" in item, f"journal v4 namespace lacks file results: {namespace}")
                  require(item.get("verification_model") == VERIFICATION_MODEL, f"journal verification model differs: {namespace}")
                  require(item.get("active_journal_verify_run") is False, f"active journal verify must remain disabled: {namespace}")
                  require(isinstance(item.get("active_query_count"), int) and int(item["active_query_count"]) >= 0, f"active query count is invalid: {namespace}")
                  require(isinstance(item.get("archived_verify_count"), int) and int(item["archived_verify_count"]) >= 0, f"archived verify count is invalid: {namespace}")
                  require(item.get("namespace_identity_stability_checked") is True, f"journal namespace identity stability was not checked: {namespace}")
                  require(isinstance(item.get("observation_attempt_count"), int) and 1 <= int(item["observation_attempt_count"]) <= OBSERVATION_MAX_ATTEMPTS, f"journal observation attempt count is invalid: {namespace}")
          require(sorted(names) == ["default", "logbook"], "journal namespace records are duplicated or incomplete")
          return value
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.problem_tokens kind=function title="Python function problem_tokens"
      def problem_tokens(summary: dict[str, Any]) -> list[dict[str, str]]:
          validate_summary(summary)
          tokens: list[dict[str, str]] = []
          for item in sorted(summary["namespaces"], key=lambda entry: str(entry["namespace"])):
              if item["status"] != "review-required":
                  continue
              lines = [normalize_problem_line(str(line)) for line in item.get("problem_lines", []) if normalize_problem_line(str(line))]
              if lines:
                  for line in sorted(set(lines)):
                      tokens.append({
                          "namespace": str(item["namespace"]),
                          "kind": "problem-line",
                          "sha256": sha256_bytes(line.encode("utf-8")),
                          "line": line,
                      })
              else:
                  digest = str(item["output_sha256"])
                  tokens.append({
                      "namespace": str(item["namespace"]),
                      "kind": "review-output",
                      "sha256": digest,
                      "line": "",
                  })
          return tokens
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.token_key kind=function title="Python function token_key"
      def token_key(token: dict[str, str]) -> str:
          return f"{token['namespace']}:{token['kind']}:{token['sha256']}"
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.build-raw-summary kind=function title="Python function build_raw_summary"
      def build_raw_summary(mode: str, results: list[dict[str, Any]], observed_at: str) -> dict[str, Any]:
          status_value = overall_status(results)
          safe_results = []
          for item in results:
              safe_item = {key: value for key, value in item.items() if key != "output"}
              safe_item.setdefault("verification_model", VERIFICATION_MODEL)
              safe_item.setdefault("active_journal_verify_run", False)
              safe_item.setdefault("active_query_count", 0)
              safe_item.setdefault("archived_verify_count", 0)
              safe_item.setdefault("namespace_identity_stability_checked", True)
              safe_item.setdefault("observation_attempt_count", 1)
              safe_results.append(safe_item)
          return {
              "schema": STATE_SCHEMA,
              "schema_version": SCHEMA,
              "observed_at": observed_at,
              "mode": mode,
              "overall_status": status_value,
              "source": {
                  "path": str(CONFIG_PATH),
                  "sha256": read_source_sha(),
                  "running_system": safe_resolve(RUNNING_LINK),
                  "boot_default_system": safe_resolve(DEFAULT_LINK),
              },
              "namespaces": safe_results,
              "policy": {
                  "observer_malfunction_is_hard_failure": True,
                  "verified_damage_is_review_required": True,
                  "verified_damage_degrades_systemd": False,
                  "journal_files_deleted": False,
                  "journal_vacuum_run": False,
                  "journal_rotation_run": False,
                  "journal_repair_run": False,
                  "network_used": False,
                  "recovery_boundary_supported": True,
                  "verification_model": VERIFICATION_MODEL,
                  "active_journal_verify_run": False,
                  "archived_journal_verify_run": True,
                  "active_journal_query_run": True,
                  "namespace_wide_verify_run": False,
                  "namespace_identity_stability_checked": True,
                  "observation_max_attempts": OBSERVATION_MAX_ATTEMPTS,
                  "checkpoint_policy": "natural-journald-size-and-age-rotation",
              },
          }
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.build_anchor kind=function title="Python function build_anchor"
      def build_anchor(origin_summary: dict[str, Any], origin_kind: str, accepted_identity: dict[str, str], created_at: str) -> dict[str, Any]:
          validate_summary(origin_summary)
          tokens = sorted(problem_tokens(origin_summary), key=token_key)
          keys = sorted(token_key(token) for token in tokens)
          namespaces = []
          for item in sorted(origin_summary["namespaces"], key=lambda entry: str(entry["namespace"])):
              namespaces.append({
                  "namespace": item["namespace"],
                  "status": item["status"],
                  "verify_rc": item["verify_rc"],
                  "output_bytes": item["output_bytes"],
                  "output_sha256": item["output_sha256"],
                  "problem_lines": item["problem_lines"],
              })
          return {
              "schema": ANCHOR_SCHEMA,
              "schema_version": 1,
              "created_at": created_at,
              "created_by": accepted_identity,
              "origin": {
                  "kind": origin_kind,
                  "summary_sha256": sha256_bytes(canonical_json(origin_summary)),
                  "observed_at": str(origin_summary.get("observed_at", "unknown")),
                  "source_sha256": str(origin_summary.get("source", {}).get("sha256", "unknown")),
                  "evidence_bundle": str(origin_summary.get("evidence_bundle", "none")),
              },
              "legacy": {
                  "overall_status": origin_summary["overall_status"],
                  "namespaces": namespaces,
                  "problem_tokens": tokens,
                  "problem_token_count": len(tokens),
                  "identity_sha256": sha256_bytes(canonical_json(keys)),
              },
              "policy": {
                  "automatic_replacement": False,
                  "new_damage_auto_absorbed": False,
                  "journal_files_deleted": False,
                  "journal_vacuum_run": False,
                  "journal_rotation_run": False,
                  "journal_repair_run": False,
                  "network_used": False,
              },
          }
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.validate_anchor kind=function title="Python function validate_anchor"
      def validate_anchor(value: dict[str, Any]) -> dict[str, Any]:
          require(isinstance(value, dict), "journal anchor is not an object")
          require(set(value) == {"schema", "schema_version", "created_at", "created_by", "origin", "legacy", "policy"}, "journal anchor top-level fields differ")
          require(value.get("schema") == ANCHOR_SCHEMA, "journal anchor has an unexpected schema")
          require(value.get("schema_version") == 1, "journal anchor schema version is invalid")
          created_at = value.get("created_at")
          require(isinstance(created_at, str) and 10 <= len(created_at.encode("utf-8")) <= 80, "journal anchor creation timestamp is invalid")
          try:
              dt.datetime.fromisoformat(created_at.replace("Z", "+00:00"))
          except ValueError as exc:
              raise JournalIntegrityError("journal anchor creation timestamp is malformed") from exc
          created_by = value.get("created_by")
          require(isinstance(created_by, dict), "journal anchor accepted identity is missing")
          require(set(created_by) == {"accepted_stage", "accepted_source_sha256", "running_system", "boot_default_system"}, "journal anchor accepted identity fields differ")
          require(isinstance(created_by.get("accepted_stage"), str) and re.fullmatch(r"[1-9][0-9]*", str(created_by["accepted_stage"])) is not None, "journal anchor stage identity is invalid")
          require(isinstance(created_by.get("accepted_source_sha256"), str) and HEX64_RE.fullmatch(str(created_by["accepted_source_sha256"])) is not None, "journal anchor source identity is invalid")
          require(created_by.get("running_system") == created_by.get("boot_default_system"), "journal anchor closure identity is not accepted")
          require(isinstance(created_by.get("running_system"), str) and str(created_by["running_system"]).startswith("/nix/store/"), "journal anchor closure path is invalid")
          origin = value.get("origin")
          require(isinstance(origin, dict), "journal anchor origin record is missing")
          require(set(origin) == {"kind", "summary_sha256", "observed_at", "source_sha256", "evidence_bundle"}, "journal anchor origin fields differ")
          require(isinstance(origin.get("kind"), str) and re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", str(origin["kind"])) is not None, "journal anchor origin kind is invalid")
          require(isinstance(origin.get("summary_sha256"), str) and HEX64_RE.fullmatch(str(origin["summary_sha256"])) is not None, "journal anchor origin summary digest is invalid")
          require(isinstance(origin.get("observed_at"), str) and 1 <= len(str(origin["observed_at"]).encode("utf-8")) <= 80, "journal anchor origin observation timestamp is invalid")
          require(isinstance(origin.get("source_sha256"), str) and (HEX64_RE.fullmatch(str(origin["source_sha256"])) is not None or origin["source_sha256"] == "unreadable"), "journal anchor origin source digest is invalid")
          require(origin.get("evidence_bundle") == str(EXPECTED_LEGACY_EVIDENCE), "journal anchor origin is not the source-declared legacy evidence bundle")
          legacy = value.get("legacy")
          require(isinstance(legacy, dict), "journal anchor legacy record is missing")
          require(set(legacy) == {"overall_status", "namespaces", "problem_tokens", "problem_token_count", "identity_sha256"}, "journal anchor legacy fields differ")
          require(legacy.get("overall_status") == "review-required", "journal anchor legacy state is not review-required")
          namespaces = legacy.get("namespaces")
          require(isinstance(namespaces, list) and len(namespaces) == 2, "journal anchor legacy namespace records are invalid")
          namespace_names: list[str] = []
          review_namespaces = 0
          for item in namespaces:
              require(isinstance(item, dict), "journal anchor legacy namespace record is not an object")
              require(set(item) == {"namespace", "status", "verify_rc", "output_bytes", "output_sha256", "problem_lines"}, "journal anchor legacy namespace fields differ")
              namespace = item.get("namespace")
              require(namespace in {"default", "logbook"}, "journal anchor legacy namespace name is invalid")
              namespace_names.append(str(namespace))
              status_value = item.get("status")
              require(status_value in NAMESPACE_STATUSES, f"journal anchor legacy namespace status is invalid: {namespace}")
              if status_value == "review-required":
                  review_namespaces += 1
              require(type(item.get("verify_rc")) is int, f"journal anchor legacy verify rc is invalid: {namespace}")
              require(type(item.get("output_bytes")) is int and 0 <= int(item["output_bytes"]) <= MAX_CAPTURE_BYTES + 256, f"journal anchor legacy output size is invalid: {namespace}")
              require(isinstance(item.get("output_sha256"), str) and HEX64_RE.fullmatch(str(item["output_sha256"])) is not None, f"journal anchor legacy output digest is invalid: {namespace}")
              problem_lines = item.get("problem_lines")
              require(isinstance(problem_lines, list) and len(problem_lines) <= 40, f"journal anchor legacy problem lines are invalid: {namespace}")
              for line in problem_lines:
                  require(isinstance(line, str) and 0 < len(line.encode("utf-8")) <= 4096, f"journal anchor legacy problem line is invalid: {namespace}")
          require(sorted(namespace_names) == ["default", "logbook"], "journal anchor legacy namespaces are duplicated or incomplete")
          require(review_namespaces >= 1, "journal anchor contains no legacy damaged namespace")
          tokens = legacy.get("problem_tokens")
          require(isinstance(tokens, list) and 1 <= len(tokens) <= 80, "journal anchor problem token list is invalid")
          keys: list[str] = []
          for token in tokens:
              require(isinstance(token, dict), "journal anchor token is not an object")
              require(set(token) == {"namespace", "kind", "sha256", "line"}, "journal anchor token fields differ")
              require(token.get("namespace") in {"default", "logbook"}, "journal anchor token namespace is invalid")
              kind = token.get("kind")
              require(kind in {"problem-line", "review-output"}, "journal anchor token kind is invalid")
              digest = token.get("sha256")
              require(isinstance(digest, str) and HEX64_RE.fullmatch(digest) is not None, "journal anchor token digest is invalid")
              line = token.get("line")
              require(isinstance(line, str) and len(line.encode("utf-8")) <= 4096, "journal anchor token line is invalid")
              if kind == "problem-line":
                  require(line != "" and sha256_bytes(line.encode("utf-8")) == digest, "journal anchor problem-line token identity differs")
              else:
                  require(line == "", "journal anchor review-output token must not carry a line")
              keys.append(token_key({"namespace": str(token["namespace"]), "kind": str(kind), "sha256": digest, "line": line}))
          require(keys == sorted(keys), "journal anchor problem tokens are not canonical")
          require(len(keys) == len(set(keys)), "journal anchor contains duplicate problem tokens")
          require(legacy.get("problem_token_count") == len(tokens), "journal anchor problem token count differs")
          require(legacy.get("identity_sha256") == sha256_bytes(canonical_json(keys)), "journal anchor identity digest differs")
          policy = value.get("policy")
          require(isinstance(policy, dict), "journal anchor policy record is missing")
          policy_names = {"automatic_replacement", "new_damage_auto_absorbed", "journal_files_deleted", "journal_vacuum_run", "journal_rotation_run", "journal_repair_run", "network_used"}
          require(set(policy) == policy_names, "journal anchor policy fields differ")
          for name in sorted(policy_names):
              require(policy.get(name) is False, f"journal anchor policy differs: {name}")
          return value
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.verify_anchor_origin kind=function title="Python function verify_anchor_origin"
      def verify_anchor_origin(anchor: dict[str, Any]) -> pathlib.Path:
          validate_anchor(anchor)
          origin = anchor.get("origin", {})
          bundle_text = origin.get("evidence_bundle")
          require(isinstance(bundle_text, str) and bundle_text.startswith(str(INCIDENT_ROOT) + "/journal-verify-"), "journal anchor origin evidence path is invalid")
          bundle = pathlib.Path(bundle_text)
          metadata = bundle.lstat()
          require(stat.S_ISDIR(metadata.st_mode) and not bundle.is_symlink(), "journal anchor origin evidence bundle is unsafe")
          require(metadata.st_uid == 0, "journal anchor origin evidence bundle is not root-owned")
          root_resolved = INCIDENT_ROOT.resolve(strict=True)
          bundle_resolved = bundle.resolve(strict=True)
          require(bundle_resolved.parent == root_resolved, "journal anchor origin evidence bundle is not contained")
          expected_resolved = EXPECTED_LEGACY_EVIDENCE.resolve(strict=True)
          require(bundle_resolved == expected_resolved, f"journal anchor origin differs from the Stage55-pinned legacy evidence bundle: {bundle_resolved}")
          completed = subprocess.run(
              [str(BUNDLE_MANIFEST), "verify", str(bundle)],
              stdout=subprocess.PIPE,
              stderr=subprocess.PIPE,
              text=True,
              check=False,
          )
          require(completed.returncode == 0, f"journal anchor origin manifest verification failed: {completed.stderr.strip() or completed.stdout.strip()}")
          summary_path = bundle / "summary.json"
          secure_regular_file(summary_path, {0o640})
          summary_bytes = summary_path.read_bytes()
          require(sha256_bytes(summary_bytes) == origin.get("summary_sha256"), "journal anchor origin summary digest differs")
          try:
              origin_summary = json.loads(summary_bytes.decode("utf-8"))
          except (UnicodeDecodeError, json.JSONDecodeError) as exc:
              raise JournalIntegrityError(f"journal anchor origin summary is unreadable: {summary_path}: {exc}") from exc
          validate_summary(origin_summary)
          require(summary_bytes == canonical_json(origin_summary), "journal anchor origin summary is not canonical")
          expected = build_anchor(
              origin_summary,
              str(origin.get("kind", "unknown")),
              {str(key): str(item) for key, item in anchor["created_by"].items()},
              str(anchor.get("created_at", "unknown")),
          )
          require(anchor.get("origin") == expected.get("origin"), "journal anchor origin metadata differs from manifested summary")
          require(anchor.get("legacy") == expected.get("legacy"), "journal anchor legacy identity differs from manifested summary")
          require(anchor.get("policy") == expected.get("policy"), "journal anchor policy differs from its source-owned contract")
          return bundle
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.load_anchor kind=function title="Python function load_anchor"
      def load_anchor() -> dict[str, Any] | None:
          if not ANCHOR_PATH.exists() and not ANCHOR_PATH.is_symlink():
              return None
          secure_regular_file(ANCHOR_PATH, {0o640})
          try:
              raw = ANCHOR_PATH.read_bytes()
              value = json.loads(raw.decode("utf-8"))
          except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
              raise JournalIntegrityError(f"journal anchor is unreadable: {ANCHOR_PATH}: {exc}") from exc
          validate_anchor(value)
          require(raw == canonical_json(value), "journal anchor bytes are not canonical")
          return value
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.load-pinned-blocker-review kind=function title="Python function load_pinned_blocker_review"
      def load_pinned_blocker_review() -> dict[str, Any]:
          bundle = EXPECTED_BLOCKER_EVIDENCE
          if not bundle.exists() and not bundle.is_symlink():
              raise JournalIntegrityError(f"Stage60 reset-origin evidence bundle is absent: {bundle}")
          metadata = bundle.lstat()
          require(stat.S_ISDIR(metadata.st_mode) and not bundle.is_symlink(), f"Stage60 reset-origin evidence bundle is unsafe: {bundle}")
          require(metadata.st_uid == 0 and (stat.S_IMODE(metadata.st_mode) & 0o022) == 0, f"Stage60 reset-origin evidence bundle metadata is unsafe: {bundle}")
          require(bundle.resolve(strict=True).parent == INCIDENT_ROOT.resolve(strict=True), "Stage60 reset-origin evidence bundle is not contained")
          completed = subprocess.run([str(BUNDLE_MANIFEST), "verify", str(bundle)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
          require(completed.returncode == 0, f"Stage60 reset-origin evidence manifest verification failed: {completed.stderr.strip() or completed.stdout.strip()}")
          summary_path = bundle / "summary.json"
          secure_regular_file(summary_path, {0o640})
          raw = summary_path.read_bytes()
          try:
              value = json.loads(raw.decode("utf-8"))
          except (UnicodeDecodeError, json.JSONDecodeError) as exc:
              raise JournalIntegrityError(f"Stage60 reset-origin summary is unreadable: {summary_path}: {exc}") from exc
          validate_summary(value)
          require(raw == canonical_json(value), "Stage60 reset-origin summary is not canonical")
          require(value.get("overall_status") == "review-required", "Stage60 reset-origin summary is not review-required")
          require(value.get("source", {}).get("sha256") == EXPECTED_BLOCKER_SOURCE_SHA256, "Stage60 reset-origin source identity differs")
          require(value.get("source", {}).get("running_system") == EXPECTED_BLOCKER_SYSTEM, "Stage60 reset-origin running closure differs")
          require(value.get("source", {}).get("boot_default_system") == EXPECTED_BLOCKER_SYSTEM, "Stage60 reset-origin boot-default closure differs")
          require(value.get("evidence_bundle") == str(bundle), "Stage60 reset-origin summary points to another bundle")
          by_namespace = {str(item.get("namespace")): item for item in value.get("namespaces", [])}
          require(set(by_namespace) == {"default", "logbook"}, "Stage60 reset-origin namespace set differs")
          expected_lines = [
              "26fb8e0: Invalid data object at hash entry 10154 of 466033",
              "File corruption detected at /var/log/journal/dda3767314624f9890868a8fa18e887e/system.journal:40876104 (of 41943040 bytes, <percent>).",
              "FAIL: /var/log/journal/dda3767314624f9890868a8fa18e887e/system.journal (Bad message)",
          ]
          require(by_namespace["default"].get("status") == "review-required" and by_namespace["default"].get("problem_lines") == expected_lines, "Stage60 reset-origin default problem lines differ")
          require(by_namespace["logbook"].get("status") == "clean" and by_namespace["logbook"].get("problem_lines") == [], "Stage60 reset-origin logbook state differs")
          clean_forward = value.get("clean_forward", {})
          require(clean_forward.get("status") == "new-damage-review-required" and clean_forward.get("new_problem_count") == 3, "Stage60 reset-origin clean-forward contract differs")
          return value
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.stat-record kind=function title="Python function stat_record"
      def stat_record(path: pathlib.Path) -> dict[str, Any]:
          metadata = secure_regular_file(path)
          return {
              "path": str(path),
              "device": int(metadata.st_dev),
              "inode": int(metadata.st_ino),
              "mode": stat.S_IMODE(metadata.st_mode),
              "uid": int(metadata.st_uid),
              "gid": int(metadata.st_gid),
              "size": int(metadata.st_size),
              "mtime_ns": int(metadata.st_mtime_ns),
              "ctime_ns": int(metadata.st_ctime_ns),
              "nlink": int(metadata.st_nlink),
          }
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.journal-directory-bytes kind=function title="Python function journal_directory_bytes"
      def journal_directory_bytes(directory: pathlib.Path) -> int:
          total = 0
          for child in directory.iterdir():
              try:
                  metadata = child.lstat()
              except OSError:
                  continue
              if stat.S_ISREG(metadata.st_mode) and not child.is_symlink():
                  total += int(metadata.st_size)
          return total
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.find-inode-paths kind=function title="Python function find_inode_paths"
      def find_inode_paths(directory: pathlib.Path, device: int, inode: int) -> list[str]:
          paths: list[str] = []
          for child in directory.iterdir():
              try:
                  metadata = child.lstat()
              except OSError:
                  continue
              if stat.S_ISREG(metadata.st_mode) and not child.is_symlink() and int(metadata.st_dev) == device and int(metadata.st_ino) == inode:
                  paths.append(str(child))
          return sorted(paths)
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.validate-boundary kind=function title="Python function validate_boundary"
      def validate_boundary(value: dict[str, Any]) -> dict[str, Any]:
          require(isinstance(value, dict), "journal recovery boundary is not an object")
          require(set(value) == {"schema", "schema_version", "created_at", "created_by", "anchor_sha256", "origin", "recovery", "postcondition", "policy"}, "journal recovery boundary fields differ")
          require(value.get("schema") == BOUNDARY_SCHEMA and value.get("schema_version") == 1, "journal recovery boundary schema differs")
          created_by = value.get("created_by")
          require(isinstance(created_by, dict) and set(created_by) == {"accepted_stage", "accepted_source_sha256", "running_system", "boot_default_system"}, "journal recovery boundary accepted identity differs")
          require(created_by.get("accepted_stage") == "60", "journal recovery boundary stage differs")
          require(isinstance(created_by.get("accepted_source_sha256"), str) and HEX64_RE.fullmatch(str(created_by["accepted_source_sha256"])) is not None, "journal recovery boundary source identity is invalid")
          require(created_by.get("running_system") == created_by.get("boot_default_system"), "journal recovery boundary closure identity differs")
          require(value.get("anchor_sha256") == EXPECTED_ANCHOR_SHA256, "journal recovery boundary anchor digest differs")
          origin = value.get("origin")
          require(isinstance(origin, dict) and set(origin) == {"bundle", "summary_sha256", "observed_at", "source_sha256", "system", "incident_identity"}, "journal recovery boundary origin differs")
          require(origin.get("bundle") == str(EXPECTED_BLOCKER_EVIDENCE), "journal recovery boundary blocker path differs")
          require(origin.get("source_sha256") == EXPECTED_BLOCKER_SOURCE_SHA256 and origin.get("system") == EXPECTED_BLOCKER_SYSTEM, "journal recovery boundary blocker identity differs")
          require(isinstance(origin.get("summary_sha256"), str) and HEX64_RE.fullmatch(str(origin["summary_sha256"])) is not None, "journal recovery boundary summary digest is invalid")
          require(isinstance(origin.get("incident_identity"), str) and origin["incident_identity"].startswith("default:journal-bad-message-invalid-entry:"), "journal recovery boundary incident identity is invalid")
          recovery = value.get("recovery")
          require(isinstance(recovery, dict) and set(recovery) == {"mode", "evidence_bundle", "manifest_sha256", "active_path", "preserved_path", "preserved_sha256", "rotation_performed", "before_device", "before_inode", "after_active_device", "after_active_inode", "archived_path"}, "journal recovery boundary recovery record differs")
          require(recovery.get("mode") in {"rotated-active", "reconciled-already-rotated", "known-incident-no-longer-observed"}, "journal recovery boundary mode is invalid")
          require(recovery.get("active_path") == str(ACTIVE_SYSTEM_JOURNAL), "journal recovery boundary active path differs")
          require(type(recovery.get("rotation_performed")) is bool, "journal recovery boundary rotation flag is invalid")
          bundle = pathlib.Path(str(recovery.get("evidence_bundle", "")))
          require(bundle.parent == RECOVERY_ROOT and bundle.name.startswith("stage-60-"), "journal recovery evidence bundle path is invalid")
          require(isinstance(recovery.get("manifest_sha256"), str) and HEX64_RE.fullmatch(str(recovery["manifest_sha256"])) is not None, "journal recovery manifest digest is invalid")
          preserved_path = recovery.get("preserved_path")
          preserved_sha = recovery.get("preserved_sha256")
          if recovery.get("mode") == "known-incident-no-longer-observed":
              require(preserved_path == "none" and preserved_sha == "none", "journal recovery disappearance mode unexpectedly claims raw preservation")
          else:
              require(isinstance(preserved_path, str) and pathlib.Path(preserved_path).parent == bundle, "journal recovery preserved path differs")
              require(isinstance(preserved_sha, str) and HEX64_RE.fullmatch(preserved_sha) is not None, "journal recovery preserved digest is invalid")
          postcondition = value.get("postcondition")
          require(isinstance(postcondition, dict) and set(postcondition) == {"active_status", "default_namespace_status", "logbook_namespace_status", "known_incident_present", "unknown_identity_count"}, "journal recovery postcondition differs")
          require(postcondition.get("active_status") == "clean", "journal recovery active journal is not clean")
          require(postcondition.get("default_namespace_status") in {"clean", "review-required"}, "journal recovery default namespace status differs")
          require(postcondition.get("logbook_namespace_status") in {"clean", "absent"}, "journal recovery logbook namespace status differs")
          require(type(postcondition.get("known_incident_present")) is bool and postcondition.get("unknown_identity_count") == 0, "journal recovery identity postcondition differs")
          policy = value.get("policy")
          require(isinstance(policy, dict) and set(policy) == {"anchor_replaced", "journal_files_explicitly_deleted", "journal_vacuum_run", "journal_repair_run", "journal_rotation_run", "network_used", "damaged_bytes_preserved"}, "journal recovery policy fields differ")
          require(policy.get("anchor_replaced") is False and policy.get("journal_files_explicitly_deleted") is False and policy.get("journal_vacuum_run") is False and policy.get("journal_repair_run") is False and policy.get("network_used") is False, "journal recovery forbidden mutation policy differs")
          require(policy.get("journal_rotation_run") is recovery.get("rotation_performed"), "journal recovery rotation policy differs")
          require(policy.get("damaged_bytes_preserved") is (recovery.get("mode") != "known-incident-no-longer-observed"), "journal recovery preservation policy differs")
          if recovery.get("mode") == "rotated-active":
              require(recovery.get("rotation_performed") is True, "rotated-active boundary lacks the reviewed rotation flag")
              require((recovery.get("before_device"), recovery.get("before_inode")) != (recovery.get("after_active_device"), recovery.get("after_active_inode")), "rotated-active boundary did not replace the active inode")
          else:
              require(recovery.get("rotation_performed") is False, "nonrotating recovery mode unexpectedly claims this invocation rotated")
          return value
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.verify-boundary-bundle kind=function title="Python function verify_boundary_bundle"
      def verify_boundary_bundle(boundary: dict[str, Any]) -> pathlib.Path:
          validate_boundary(boundary)
          bundle = pathlib.Path(str(boundary["recovery"]["evidence_bundle"]))
          metadata = bundle.lstat()
          require(stat.S_ISDIR(metadata.st_mode) and not bundle.is_symlink() and metadata.st_uid == 0, "journal recovery evidence bundle is unsafe")
          require(bundle.resolve(strict=True).parent == RECOVERY_ROOT.resolve(strict=True), "journal recovery evidence bundle is not contained")
          completed = subprocess.run([str(BUNDLE_MANIFEST), "verify", str(bundle)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
          require(completed.returncode == 0, f"journal recovery evidence manifest verification failed: {completed.stderr.strip() or completed.stdout.strip()}")
          require(sha256_file(bundle / "SHA256SUMS") == boundary["recovery"]["manifest_sha256"], "journal recovery evidence manifest digest differs")
          preserved = boundary["recovery"]["preserved_path"]
          if preserved != "none":
              preserved_path = pathlib.Path(str(preserved))
              secure_regular_file(preserved_path)
              require(sha256_file(preserved_path) == boundary["recovery"]["preserved_sha256"], "preserved damaged journal digest differs")
          return bundle
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.load-boundary kind=function title="Python function load_boundary"
      def load_boundary() -> dict[str, Any] | None:
          if not BOUNDARY_PATH.exists() and not BOUNDARY_PATH.is_symlink():
              return None
          secure_regular_file(BOUNDARY_PATH, {0o640})
          raw = BOUNDARY_PATH.read_bytes()
          try:
              value = json.loads(raw.decode("utf-8"))
          except (UnicodeDecodeError, json.JSONDecodeError) as exc:
              raise JournalIntegrityError(f"journal recovery boundary is unreadable: {BOUNDARY_PATH}: {exc}") from exc
          validate_boundary(value)
          require(raw == canonical_json(value), "journal recovery boundary is not canonical")
          verify_boundary_bundle(value)
          return value
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.active-file-status kind=function title="Python function active_file_status"
      def active_file_status(summary: dict[str, Any], active_path: str) -> str:
          default = next(item for item in summary["namespaces"] if item["namespace"] == "default")
          matches = [record["status"] for record in default.get("file_results", []) if record.get("path") == active_path]
          if not matches:
              return "unknown"
          if "review-required" in matches:
              return "review-required"
          return "clean"
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.classify_clean_forward kind=function title="Python function classify_clean_forward"
      def classify_clean_forward(summary: dict[str, Any], anchor: dict[str, Any] | None, boundary: dict[str, Any] | None = None) -> dict[str, Any]:
          validate_summary(summary)
          current_identities = semantic_problem_identities(summary)
          current_map = {semantic_identity_key(item): item for item in current_identities}
          current_keys = set(current_map)
          anchor_keys: set[str] = set()
          if anchor is not None:
              validate_anchor(anchor)
              anchor_keys = {semantic_identity_key(item) for item in semantic_identities_from_records(anchor["legacy"]["namespaces"])}
          boundary_key = "none"
          boundary_present = boundary is not None
          active_status = active_file_status(summary, str(ACTIVE_SYSTEM_JOURNAL))
          if boundary is not None:
              validate_boundary(boundary)
              boundary_key = str(boundary["origin"]["incident_identity"])
              active_status = active_file_status(summary, str(boundary["recovery"]["active_path"]))
          known_keys = set(anchor_keys)
          if boundary_key != "none":
              known_keys.add(boundary_key)
          if summary["overall_status"] == "malfunction":
              status_value = "unknown-observer-malfunction"
          elif anchor is None:
              status_value = "unanchored" if current_keys else "clean"
          elif boundary is None:
              new_keys = current_keys - anchor_keys
              if new_keys:
                  status_value = "new-damage-review-required"
              elif current_keys:
                  status_value = "legacy-damage-only"
              elif anchor_keys:
                  status_value = "legacy-damage-no-longer-observed"
              else:
                  status_value = "clean"
          else:
              new_keys = current_keys - known_keys
              active_problem = any(str(item.get("observed_path", "unknown")) == str(boundary["recovery"]["active_path"]) for item in current_identities)
              if active_status == "review-required" or active_problem or new_keys:
                  status_value = "new-damage-review-required"
              elif active_status != "clean":
                  status_value = "unknown-observer-malfunction"
              elif current_keys & known_keys:
                  status_value = "known-archived-damage-clean-forward"
              else:
                  status_value = "known-damage-no-longer-observed-clean-forward"
          new_keys = sorted(current_keys - known_keys)
          anchor_present_keys = sorted(current_keys & anchor_keys)
          anchor_missing_keys = sorted(anchor_keys - current_keys)
          known_present_keys = sorted(current_keys & known_keys)
          require(status_value in CLEAN_FORWARD_STATUSES, "clean-forward classification is invalid")
          return {
              "schema": "mnx.journal-integrity.clean-forward.v2",
              "status": status_value,
              "ok": status_value in {"legacy-damage-only", "legacy-damage-no-longer-observed", "known-archived-damage-clean-forward", "known-damage-no-longer-observed-clean-forward", "clean"},
              "anchor_present": anchor is not None,
              "anchor_path": str(ANCHOR_PATH) if anchor is not None else "none",
              "anchor_sha256": sha256_bytes(canonical_json(anchor)) if anchor is not None else "none",
              "boundary_present": boundary_present,
              "boundary_path": str(BOUNDARY_PATH) if boundary_present else "none",
              "boundary_sha256": sha256_bytes(canonical_json(boundary)) if boundary_present else "none",
              "active_forward_status": active_status,
              "legacy_problem_count": len(anchor_keys),
              "current_problem_count": len(current_keys),
              "legacy_problem_present_count": len(anchor_present_keys),
              "legacy_problem_missing_count": len(anchor_missing_keys),
              "known_problem_count": len(known_keys),
              "known_problem_present_count": len(known_present_keys),
              "new_problem_count": len(new_keys),
              "new_problem_tokens": new_keys[:80],
              "journal_files_deleted": False,
              "journal_vacuum_run": False,
              "journal_rotation_run": bool(boundary.get("policy", {}).get("journal_rotation_run", False)) if boundary is not None else False,
              "journal_repair_run": False,
              "network_used": False,
          }
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.build-summary kind=function title="Python function build_summary"
      def build_summary(mode: str, results: list[dict[str, Any]], observed_at: str, anchor: dict[str, Any] | None = None, boundary: dict[str, Any] | None = None) -> dict[str, Any]:
          summary = build_raw_summary(mode, results, observed_at)
          if anchor is None:
              anchor = load_anchor()
          if boundary is None:
              boundary = load_boundary()
          summary["clean_forward"] = classify_clean_forward(summary, anchor, boundary)
          summary["anchor"] = {
              "present": anchor is not None,
              "path": str(ANCHOR_PATH) if anchor is not None else "none",
              "sha256": sha256_bytes(canonical_json(anchor)) if anchor is not None else "none",
              "created_at": str(anchor.get("created_at", "unknown")) if anchor is not None else "unknown",
              "accepted_source_sha256": str(anchor.get("created_by", {}).get("accepted_source_sha256", "unknown")) if anchor is not None else "unknown",
              "origin_kind": str(anchor.get("origin", {}).get("kind", "unknown")) if anchor is not None else "unknown",
          }
          summary["recovery_boundary"] = {
              "present": boundary is not None,
              "path": str(BOUNDARY_PATH) if boundary is not None else "none",
              "sha256": sha256_bytes(canonical_json(boundary)) if boundary is not None else "none",
              "created_at": str(boundary.get("created_at", "unknown")) if boundary is not None else "unknown",
              "mode": str(boundary.get("recovery", {}).get("mode", "none")) if boundary is not None else "none",
              "active_path": str(boundary.get("recovery", {}).get("active_path", ACTIVE_SYSTEM_JOURNAL)) if boundary is not None else str(ACTIVE_SYSTEM_JOURNAL),
          }
          summary["policy"]["journal_rotation_run"] = bool(boundary.get("policy", {}).get("journal_rotation_run", False)) if boundary is not None else False
          return summary
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.create_manifest kind=function title="Python function create_manifest"
      def create_manifest(bundle: pathlib.Path) -> None:
          completed = subprocess.run(
              [str(BUNDLE_MANIFEST), "create", str(bundle), "2"],
              text=True,
              stdout=subprocess.PIPE,
              stderr=subprocess.PIPE,
              check=False,
          )
          if completed.returncode != 0:
              raise JournalIntegrityError(
                  f"bundle manifest creation failed ({completed.returncode}): {completed.stderr.strip() or completed.stdout.strip()}"
              )
          manifest = bundle / "SHA256SUMS"
          if not manifest.is_file() or manifest.is_symlink() or manifest.stat().st_size == 0:
              raise JournalIntegrityError("bundle manifest is missing after creation")
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.verify_evidence_bundle kind=function title="Python function verify_evidence_bundle"
      def verify_evidence_bundle(summary: dict[str, Any]) -> pathlib.Path:
          validate_summary(summary)
          bundle_text = summary.get("evidence_bundle")
          require(isinstance(bundle_text, str) and bundle_text.startswith(str(INCIDENT_ROOT) + "/journal-verify-"), "journal summary evidence path is outside the journal incident root")
          bundle = pathlib.Path(bundle_text)
          metadata = bundle.lstat()
          require(stat.S_ISDIR(metadata.st_mode) and not bundle.is_symlink(), "journal evidence bundle is unsafe")
          require(metadata.st_uid == 0, "journal evidence bundle is not root-owned")
          root_resolved = INCIDENT_ROOT.resolve(strict=True)
          bundle_resolved = bundle.resolve(strict=True)
          require(bundle_resolved.parent == root_resolved, "journal evidence bundle is not a direct contained child")
          completed = subprocess.run(
              [str(BUNDLE_MANIFEST), "verify", str(bundle)],
              stdout=subprocess.PIPE,
              stderr=subprocess.PIPE,
              text=True,
              check=False,
          )
          require(completed.returncode == 0, f"journal evidence manifest verification failed: {completed.stderr.strip() or completed.stdout.strip()}")
          summary_path = bundle / "summary.json"
          secure_regular_file(summary_path, {0o640})
          require(summary_path.read_bytes() == canonical_json(summary), "journal state differs from its manifested evidence summary")
          return bundle
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.publish_evidence kind=function title="Python function publish_evidence"
      def publish_evidence(mode: str, results: list[dict[str, Any]], summary: dict[str, Any], gid: int) -> pathlib.Path:
          stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
          incident_metadata = INCIDENT_ROOT.lstat()
          require(stat.S_ISDIR(incident_metadata.st_mode) and not INCIDENT_ROOT.is_symlink(), f"journal incident root is unsafe: {INCIDENT_ROOT}")
          require(incident_metadata.st_uid == 0 and incident_metadata.st_gid == gid and stat.S_IMODE(incident_metadata.st_mode) == 0o2750, f"journal incident root metadata differs: {INCIDENT_ROOT}")
          staging = INCIDENT_ROOT / f".journal-verify-{stamp}.{os.getpid()}"
          final = INCIDENT_ROOT / f"journal-verify-{stamp}"
          if staging.exists() or final.exists():
              raise JournalIntegrityError("journal evidence path collision")
          ensure_dir(staging, 0o750, gid)
          try:
              for item in results:
                  write_file(staging / f"{item['namespace']}.verify.txt", item["output"].encode("utf-8"), 0o640, gid)
              summary_with_bundle = dict(summary)
              summary_with_bundle["evidence_bundle"] = str(final)
              write_file(staging / "summary.json", canonical_json(summary_with_bundle), 0o640, gid)
              provenance = (
                  "schema=mnx.journal-integrity.provenance.v4\n"
                  f"mode={mode}\n"
                  f"source_sha256={summary['source']['sha256']}\n"
                  f"clean_forward_status={summary.get('clean_forward', {}).get('status', 'unanchored')}\n"
                  f"recovery_boundary_present={'yes' if summary.get('recovery_boundary', {}).get('present') else 'no'}\n"
                  f"verification_model={summary.get('policy', {}).get('verification_model', 'unknown')}\n"
                  f"active_journal_verify_run={'yes' if summary.get('policy', {}).get('active_journal_verify_run') else 'no'}\n"
                  "authority=observer-evidence-not-independent-mutation-permission\n"
                  f"journal_files_explicitly_deleted={'yes' if summary.get('policy', {}).get('journal_files_deleted') else 'no'}\n"
                  f"journal_vacuum_run={'yes' if summary.get('policy', {}).get('journal_vacuum_run') else 'no'}\n"
                  f"journal_rotation_recorded={'yes' if summary.get('policy', {}).get('journal_rotation_run') else 'no'}\n"
                  f"journal_repair_run={'yes' if summary.get('policy', {}).get('journal_repair_run') else 'no'}\n"
                  f"network_used={'yes' if summary.get('policy', {}).get('network_used') else 'no'}\n"
              ).encode("utf-8")
              write_file(staging / "provenance.txt", provenance, 0o640, gid)
              create_manifest(staging)
              for child in staging.iterdir():
                  if child.is_file() and not child.is_symlink():
                      os.chown(child, 0, gid)
                      os.chmod(child, 0o640)
                      descriptor = os.open(child, os.O_RDONLY | os.O_NOFOLLOW)
                      try:
                          os.fsync(descriptor)
                      finally:
                          os.close(descriptor)
              staging_descriptor = os.open(staging, os.O_RDONLY | os.O_DIRECTORY)
              try:
                  os.fsync(staging_descriptor)
              finally:
                  os.close(staging_descriptor)
              os.replace(staging, final)
              parent_descriptor = os.open(INCIDENT_ROOT, os.O_RDONLY | os.O_DIRECTORY)
              try:
                  os.fsync(parent_descriptor)
              finally:
                  os.close(parent_descriptor)
              return final
          except Exception:
              shutil.rmtree(staging, ignore_errors=True)
              raise
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.publish_state kind=function title="Python function publish_state"
      def publish_state(summary: dict[str, Any], bundle: pathlib.Path, gid: int) -> None:
          ensure_dir(STATE_ROOT, 0o750, gid)
          current = dict(summary)
          current["evidence_bundle"] = str(bundle)
          current_bytes = canonical_json(current)
          atomic_write(STATE_ROOT / "current.json", current_bytes, 0o640, gid)
          status_value = str(summary["overall_status"])
          if status_value == "review-required":
              atomic_write(STATE_ROOT / "last-review.json", current_bytes, 0o640, gid)
          elif status_value == "malfunction":
              atomic_write(STATE_ROOT / "last-malfunction.json", current_bytes, 0o640, gid)
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.publish-metrics kind=function title="Python function publish_metrics"
      def publish_metrics(summary: dict[str, Any]) -> None:
          status_value = str(summary["overall_status"])
          clean_forward = summary.get("clean_forward", {})
          clean_status = str(clean_forward.get("status", "unanchored"))
          observed = int(dt.datetime.now().timestamp())
          default = next(item for item in summary["namespaces"] if item["namespace"] == "default")
          logbook = next(item for item in summary["namespaces"] if item["namespace"] == "logbook")
          lines = [
              "# HELP monsternix_journal_integrity_observation_timestamp_seconds Unix timestamp of the latest journal integrity classification.",
              "# TYPE monsternix_journal_integrity_observation_timestamp_seconds gauge",
              f"monsternix_journal_integrity_observation_timestamp_seconds {observed}",
              "# HELP monsternix_journal_integrity_review_required 1 when journalctl identified any retained integrity damage.",
              "# TYPE monsternix_journal_integrity_review_required gauge",
              f"monsternix_journal_integrity_review_required {1 if status_value == 'review-required' else 0}",
              "# HELP monsternix_journal_integrity_malfunction 1 when the observer itself could not execute or classify safely.",
              "# TYPE monsternix_journal_integrity_malfunction gauge",
              f"monsternix_journal_integrity_malfunction {1 if status_value == 'malfunction' else 0}",
              "# HELP monsternix_journal_integrity_clean 1 when every present namespace verifies cleanly.",
              "# TYPE monsternix_journal_integrity_clean gauge",
              f"monsternix_journal_integrity_clean {1 if status_value == 'clean' else 0}",
              "# HELP monsternix_journal_integrity_namespace_review_required Per-namespace retained review state.",
              "# TYPE monsternix_journal_integrity_namespace_review_required gauge",
              f"monsternix_journal_integrity_namespace_review_required{{namespace=\"default\"}} {1 if default['status'] == 'review-required' else 0}",
              f"monsternix_journal_integrity_namespace_review_required{{namespace=\"logbook\"}} {1 if logbook['status'] == 'review-required' else 0}",
              "# HELP monsternix_journal_integrity_anchor_present 1 when the immutable legacy journal anchor exists and validates.",
              "# TYPE monsternix_journal_integrity_anchor_present gauge",
              f"monsternix_journal_integrity_anchor_present {1 if clean_forward.get('anchor_present') else 0}",
              "# HELP monsternix_journal_integrity_recovery_boundary_present 1 when the accepted clean-forward recovery boundary exists and validates.",
              "# TYPE monsternix_journal_integrity_recovery_boundary_present gauge",
              f"monsternix_journal_integrity_recovery_boundary_present {1 if clean_forward.get('boundary_present') else 0}",
              "# HELP monsternix_journal_integrity_active_forward_clean 1 when the current active default journal is identity-stable and queryable under the online-file observation model.",
              "# TYPE monsternix_journal_integrity_active_forward_clean gauge",
              f"monsternix_journal_integrity_active_forward_clean {1 if clean_forward.get('active_forward_status') == 'clean' else 0}",
              "# HELP monsternix_journal_integrity_clean_forward_ok 1 when no unknown closed-archive damage is observed and every active journal remains identity-stable and queryable.",
              "# TYPE monsternix_journal_integrity_clean_forward_ok gauge",
              f"monsternix_journal_integrity_clean_forward_ok {1 if clean_forward.get('ok') else 0}",
              "# HELP monsternix_journal_integrity_new_damage 1 when unknown or active-forward damage is observed.",
              "# TYPE monsternix_journal_integrity_new_damage gauge",
              f"monsternix_journal_integrity_new_damage {1 if clean_status == 'new-damage-review-required' else 0}",
              "# HELP monsternix_journal_integrity_known_archived_damage 1 when retained known damage remains visible while the active forward journal is clean.",
              "# TYPE monsternix_journal_integrity_known_archived_damage gauge",
              f"monsternix_journal_integrity_known_archived_damage {1 if clean_status == 'known-archived-damage-clean-forward' else 0}",
              "# HELP monsternix_journal_integrity_new_problem_line_count Number of current semantic problem identities outside accepted anchors and boundaries.",
              "# TYPE monsternix_journal_integrity_new_problem_line_count gauge",
              f"monsternix_journal_integrity_new_problem_line_count {int(clean_forward.get('new_problem_count', 0))}",
              "# HELP monsternix_journal_integrity_active_verify_disabled 1 when active journal files are deliberately excluded from structural verify.",
              "# TYPE monsternix_journal_integrity_active_verify_disabled gauge",
              "monsternix_journal_integrity_active_verify_disabled 1",
              "# HELP monsternix_journal_integrity_archived_files_verified Number of closed archived journal files structurally verified in the latest observation.",
              "# TYPE monsternix_journal_integrity_archived_files_verified gauge",
              f"monsternix_journal_integrity_archived_files_verified {sum(int(item.get('archived_verify_count', 0)) for item in summary['namespaces'])}",
              "# HELP monsternix_journal_integrity_active_files_query_tested Number of active journal files query-tested without --verify in the latest observation.",
              "# TYPE monsternix_journal_integrity_active_files_query_tested gauge",
              f"monsternix_journal_integrity_active_files_query_tested {sum(int(item.get('active_query_count', 0)) for item in summary['namespaces'])}",
          ]
          data = ("\n".join(lines) + "\n").encode("utf-8")
          ensure_dir(METRIC_PATH.parent, 0o755, 0)
          descriptor, temporary_name = tempfile.mkstemp(prefix=f".{METRIC_PATH.name}.", dir=METRIC_PATH.parent)
          temporary = pathlib.Path(temporary_name)
          try:
              with os.fdopen(descriptor, "wb") as handle:
                  handle.write(data)
                  handle.flush()
                  os.fsync(handle.fileno())
              os.chown(temporary, 0, 0)
              os.chmod(temporary, 0o644)
              os.replace(temporary, METRIC_PATH)
          finally:
              try:
                  temporary.unlink()
              except FileNotFoundError:
                  pass
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.notify-review kind=function title="Python function notify_review"
      def notify_review(summary: dict[str, Any], bundle: pathlib.Path, gid: int) -> str:
          clean_status = str(summary.get("clean_forward", {}).get("status", "unanchored"))
          if clean_status in {"legacy-damage-only", "legacy-damage-no-longer-observed", "known-archived-damage-clean-forward", "known-damage-no-longer-observed-clean-forward", "clean"}:
              return "suppressed-clean-forward"
          signature_input = {
              "overall_status": summary["overall_status"],
              "clean_forward_status": clean_status,
              "namespaces": [
                  {"namespace": item["namespace"], "status": item["status"], "problem_lines": item["problem_lines"]}
                  for item in summary["namespaces"]
              ],
          }
          signature = sha256_bytes(canonical_json(signature_input))
          notification_state = STATE_ROOT / "last-notification"
          previous = ""
          try:
              previous = notification_state.read_text(encoding="utf-8").strip()
          except OSError:
              pass
          if previous == signature:
              return "suppressed-unchanged"
          if not NOTIFY.is_file() or not os.access(NOTIFY, os.X_OK):
              return "unavailable"
          title = "Monsternix journal integrity anchor required"
          if clean_status == "new-damage-review-required":
              title = "Monsternix new journal damage review required"
          completed = subprocess.run([str(NOTIFY), "warning", title, f"See {bundle}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
          if completed.returncode != 0:
              return "failed"
          atomic_write(notification_state, (signature + "\n").encode("ascii"), 0o640, gid)
          return "sent"
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.log_summary kind=function title="Python function log_summary"
      def log_summary(summary: dict[str, Any], bundle: pathlib.Path) -> None:
          if not LOGGER.is_file() or not os.access(LOGGER, os.X_OK):
              return
          clean_status = str(summary.get("clean_forward", {}).get("status", "unanchored"))
          priority = "daemon.info"
          if summary["overall_status"] == "malfunction":
              priority = "daemon.err"
          elif clean_status in {"unanchored", "new-damage-review-required"}:
              priority = "daemon.warning"
          subprocess.run(
              [str(LOGGER), "-t", "mnx-journal-integrity", "-p", priority, "--", f"status={summary['overall_status']} clean_forward={clean_status} evidence={bundle}"],
              stdout=subprocess.DEVNULL,
              stderr=subprocess.DEVNULL,
              check=False,
          )
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.print-summary kind=function title="Python function print_summary"
      def print_summary(summary: dict[str, Any], bundle: pathlib.Path, notification: str) -> None:
          by_namespace = {item["namespace"]: item for item in summary["namespaces"]}
          clean_forward = summary.get("clean_forward", {})
          anchor = summary.get("anchor", {})
          boundary = summary.get("recovery_boundary", {})
          print(f"journal_integrity_schema={SCHEMA}")
          print(f"verification_model={summary.get('policy', {}).get('verification_model', 'unknown')}")
          print(f"active_journal_verify_run={'yes' if summary.get('policy', {}).get('active_journal_verify_run') else 'no'}")
          print(f"archived_journal_verify_run={'yes' if summary.get('policy', {}).get('archived_journal_verify_run') else 'no'}")
          print(f"active_journal_query_run={'yes' if summary.get('policy', {}).get('active_journal_query_run') else 'no'}")
          print(f"namespace_wide_verify_run={'yes' if summary.get('policy', {}).get('namespace_wide_verify_run') else 'no'}")
          print(f"namespace_identity_stability_checked={'yes' if summary.get('policy', {}).get('namespace_identity_stability_checked') else 'no'}")
          print(f"observed_at={summary['observed_at']}")
          print(f"overall_status={summary['overall_status']}")
          print(f"clean_forward_status={clean_forward.get('status', 'unanchored')}")
          print(f"clean_forward_ok={'yes' if clean_forward.get('ok') else 'no'}")
          print(f"active_forward_status={clean_forward.get('active_forward_status', 'unknown')}")
