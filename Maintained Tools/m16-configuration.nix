      UMask = "0077";
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectSystem = "full";
      RestrictSUIDSGID = true;
    };
    path = [ pkgs.bash pkgs.coreutils pkgs.findutils pkgs.util-linux pkgs.duperemove ];
    script = ''
