#@MNX-PART id=90.00.monsterdesk.function.f023kkf0-qbittorrent-port-release-state kind=function title="Python function qbittorrent_port_release_state"
def qbittorrent_port_release_state(rows: list[dict[str, Any]], *, table_readable: bool) -> dict[str, Any]:
    active_holders: list[dict[str, Any]] = []
    ownerless_tcp_residuals: list[dict[str, Any]] = []
    for item in rows[:128]:
        protocol = str(item.get("protocol", ""))
        port = int(item.get("port", 0))
        state = str(item.get("state", "")).upper()
        inode = str(item.get("inode", "0"))
        relevant = ((port == EXPECTED_QBITTORRENT_LISTEN_PORT and protocol in {"tcp", "tcp6", "udp", "udp6"})
                    or (port == EXPECTED_QBITTORRENT_WEBUI_PORT and protocol in {"tcp", "tcp6"}))
        if not relevant:
            continue
        public = {
            "protocol": protocol,
            "address": str(item.get("address", "unavailable")),
            "port": port,
            "state": state,
            "kind": str(item.get("kind", "unknown")),
            "inode_owned": inode not in {"", "0"},
        }
        if protocol.startswith("tcp") and inode in {"", "0"} and state != "0A":
            ownerless_tcp_residuals.append(public)
        else:
            active_holders.append(public)
    return {
        "table_readable": table_readable,
        "active_holder_count": len(active_holders),
        "active_holders": active_holders[:32],
        "ownerless_tcp_residual_count": len(ownerless_tcp_residuals),
        "ownerless_tcp_residuals": ownerless_tcp_residuals[:32],
        "raw_tables_exported": False,
        "remote_endpoints_exported": False,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kkf1-qbittorrent-host-port-rows kind=function title="Python function qbittorrent_host_port_rows"
def qbittorrent_host_port_rows() -> dict[str, Any]:
    rows: list[dict[str, Any]] = []
    table_states: dict[str, bool] = {}
    clipped = False
    tables = (
        ("tcp", socket.AF_INET, "tcp"), ("tcp6", socket.AF_INET6, "tcp6"),
        ("udp", socket.AF_INET, "udp"), ("udp6", socket.AF_INET6, "udp6"),
    )
    for protocol, family, filename in tables:
        raw = proc_bytes(Path("/proc/self/net") / filename, 2 * 1024 * 1024)
        table_states[protocol] = bool(raw)
        if not raw:
            continue
        for line in raw.decode("ascii", errors="replace").splitlines()[1:4097]:
            fields = line.split()
            if len(fields) < 10:
                continue
            try:
                address_hex, port_hex = fields[1].split(":", 1)
                address = decode_proc_address(address_hex, family)
                port = int(port_hex, 16)
            except (ValueError, MonsterdeskError):
                continue
            if port not in {EXPECTED_QBITTORRENT_LISTEN_PORT, EXPECTED_QBITTORRENT_WEBUI_PORT}:
                continue
            if len(rows) >= 128:
                clipped = True
                break
            state = fields[3].upper()
            if protocol.startswith("tcp") and state == "0A":
                kind = "listen"
            elif protocol.startswith("udp"):
                kind = "bound"
            else:
                kind = "connected-local"
            rows.append({
                "protocol": protocol, "address": address, "port": port,
                "state": state, "kind": kind, "inode": fields[9],
            })
    return {
        "table_readable": all(table_states.get(name) is True for name in ("tcp", "tcp6", "udp", "udp6")),
        "table_states": table_states,
        "row_limit": 128,
        "rows_clipped": clipped,
        "rows": rows,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kkf2-qbittorrent-reuse-bind-probe kind=function title="Python function qbittorrent_reuse_bind_probe"
def qbittorrent_reuse_bind_probe() -> dict[str, Any]:
    sockets: list[socket.socket] = []
    failure: dict[str, Any] | None = None
    try:
        for label, sock_type, address, port in (
            ("peer-tcp", socket.SOCK_STREAM, EXPECTED_QBITTORRENT_HOST_IPV4, EXPECTED_QBITTORRENT_LISTEN_PORT),
            ("webui-tcp", socket.SOCK_STREAM, "127.0.0.1", EXPECTED_QBITTORRENT_WEBUI_PORT),
            ("peer-udp", socket.SOCK_DGRAM, EXPECTED_QBITTORRENT_HOST_IPV4, EXPECTED_QBITTORRENT_LISTEN_PORT),
        ):
            item = socket.socket(socket.AF_INET, sock_type)
            sockets.append(item)
            item.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                item.bind((address, port))
                if sock_type == socket.SOCK_STREAM:
                    item.listen(1)
            except OSError as exc:
                failure = {"label": label, "errno": getattr(exc, "errno", None)}
                break
        return {
            "attempted": True,
            "passed": failure is None,
            "failure": failure,
            "so_reuseaddr": True,
        }
    finally:
        for item in sockets:
            item.close()


#@MNX-PART id=90.00.monsterdesk.function.f023kkf3-qbittorrent-host-port-release-evidence kind=function title="Python function qbittorrent_host_port_release_evidence"
def qbittorrent_host_port_release_evidence() -> dict[str, Any]:
    observed = qbittorrent_host_port_rows()
    classified = qbittorrent_port_release_state(
        observed["rows"], table_readable=bool(observed["table_readable"])
    )
    bind_probe = qbittorrent_reuse_bind_probe() if classified["active_holder_count"] == 0 else {
        "attempted": False, "passed": False, "failure": {"label": "active-holder-present"},
        "so_reuseaddr": True,
    }
    return {
        "schema": "mnx.qbittorrent.host-port-release.v1",
        **classified,
        "table_states": observed.get("table_states", {}),
        "rows_clipped": observed.get("rows_clipped") is True,
        "reuse_bind_probe": bind_probe,
        "released": (classified["table_readable"] is True
                     and observed.get("rows_clipped") is not True
                     and classified["active_holder_count"] == 0
                     and bind_probe.get("passed") is True),
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kkf4-qbittorrent-host-ports-available kind=function title="Python function qbittorrent_host_ports_available"
def qbittorrent_host_ports_available() -> bool:
    return qbittorrent_host_port_release_evidence().get("released") is True


#@MNX-PART id=90.00.monsterdesk.function.f023kkf5-wait-qbittorrent-host-port-release kind=function title="Python function wait_for_qbittorrent_host_port_release"
def wait_for_qbittorrent_host_port_release(timeout: float, label: str) -> dict[str, Any]:
    deadline = time.monotonic() + timeout
    last: dict[str, Any] = {}
    while time.monotonic() < deadline:
        last = qbittorrent_host_port_release_evidence()
        if last.get("released") is True:
            return last
        time.sleep(0.10)
    raise MonsterdeskError(label + "; " + canonical(last))


#@MNX-PART id=90.00.monsterdesk.function.f023kkg-ready-legacy-qbittorrent kind=function title="Python function ready_legacy_qbittorrent"
def ready_legacy_qbittorrent() -> dict[str, Any] | None:
    clients = [item for item in qbittorrent_process_inventory()
               if qbittorrent_client_process(item) and item.get("host_network_namespace") is True]
    if len(clients) > 1:
        raise MonsterdeskError(f"multiple host-network qBittorrent clients exist: {len(clients)}")
    if not clients:
        return None
    selected = clients[0]
    endpoints = selected.get("local_endpoints", [])
    peer_tcp = any(item.get("kind") == "listen"
                   and item.get("protocol") in {"tcp", "tcp6"}
                   and int(item.get("port", 0)) == EXPECTED_QBITTORRENT_LISTEN_PORT
                   for item in endpoints)
    peer_udp = any(item.get("kind") == "bound"
                   and item.get("protocol") in {"udp", "udp6"}
                   and int(item.get("port", 0)) == EXPECTED_QBITTORRENT_LISTEN_PORT
                   for item in endpoints)
    webui_tcp = any(item.get("kind") == "listen"
                    and item.get("protocol") in {"tcp", "tcp6"}
                    and int(item.get("port", 0)) == EXPECTED_QBITTORRENT_WEBUI_PORT
                    for item in endpoints)
    if not (peer_tcp and peer_udp and webui_tcp):
        return None
    return {
        "pid": int(selected["pid"]),
        "start_ticks": int(selected["start_ticks"]),
        "host_network_namespace": True,
        "peer_tcp_port": EXPECTED_QBITTORRENT_LISTEN_PORT,
        "peer_udp_port": EXPECTED_QBITTORRENT_LISTEN_PORT,
        "webui_tcp_port": EXPECTED_QBITTORRENT_WEBUI_PORT,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kkg1-ensure-legacy-qbittorrent kind=function title="Python function ensure_legacy_qbittorrent_running"
def ensure_legacy_qbittorrent_running() -> dict[str, Any]:
    source_before = qbittorrent_stationary_config_identity()
    existing = ready_legacy_qbittorrent()
    if existing is not None:
        return {
            "schema": "mnx.qbittorrent.legacy-prestate.v1",
            **existing,
            "qualified": True,
            "legacy_already_running": True,
            "legacy_started_for_rehearsal": False,
            "partial_client_cleanup_performed": False,
            "source_config_sha256_before": source_before["sha256"],
            "source_config_sha256_after": source_before["sha256"],
            "startup_diagnostics_bounded": True,
        }
    clients = [item for item in qbittorrent_process_inventory() if qbittorrent_client_process(item)]
    isolated = [item for item in clients if item.get("host_network_namespace") is False]
    if isolated:
        raise MonsterdeskError(
            "candidate-entry qBittorrent recovery found an uncommitted isolated client; "
            + canonical([{"pid": item.get("pid"), "start_ticks": item.get("start_ticks")} for item in isolated])
        )
    host_clients = [item for item in clients if item.get("host_network_namespace") is True]
    cleanup: dict[str, Any] = {"performed": False, "tree": None}
    if host_clients:
        if len(host_clients) != 1:
            raise MonsterdeskError(f"candidate-entry qBittorrent recovery found {len(host_clients)} partial host clients")
        selected = host_clients[0]
        tree = birth_pinned_process_tree(int(selected["pid"]), int(selected["start_ticks"]))
        cleanup = {"performed": True, "tree": terminate_birth_pinned_process_tree(tree)}
        wait_for(lambda: not any(qbittorrent_client_process(item)
                                 and item.get("host_network_namespace") is True
                                 for item in qbittorrent_process_inventory()),
                 15, "candidate-entry partial host qBittorrent cleanup")
    release = wait_for_qbittorrent_host_port_release(
        90, "candidate-entry qBittorrent host ports did not become reusable"
    )
    started = start_legacy_qbittorrent()
    source_after = qbittorrent_stationary_config_identity()
    return {
        "schema": "mnx.qbittorrent.legacy-prestate.v1",
        **started,
        "qualified": started.get("restored") is True,
        "legacy_already_running": False,
        "legacy_started_for_rehearsal": True,
        "partial_client_cleanup_performed": cleanup["performed"],
        "partial_client_cleanup": cleanup["tree"],
        "host_port_release_before_start": release,
        "source_config_sha256_before": source_before["sha256"],
        "source_config_sha256_after": source_after["sha256"],
        "source_config_semantic_boundary_preserved": True,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kkg0-qbittorrent-family-unit-command kind=function title="Python function qbittorrent_family_unit_command"
def qbittorrent_family_unit_command(environment: dict[str, str]) -> list[str]:
    return [
        str(SYSTEMD_RUN), "--user", "--quiet", f"--unit={QBITTORRENT_FAMILY_UNIT}", "--collect",
        "--property=Type=exec", "--property=Restart=always", "--property=RestartSec=3s",
        "--property=StartLimitIntervalSec=0", "--property=KillMode=control-group",
        "--property=TimeoutStopSec=30s", f"--property=WorkingDirectory={USER_HOME}",
        f"--setenv=HOME={USER_HOME}", f"--setenv=USER={USER_NAME}", f"--setenv=LOGNAME={USER_NAME}",
        f"--setenv=DISPLAY={environment['DISPLAY']}", f"--setenv=XAUTHORITY={environment['XAUTHORITY']}",
        f"--setenv=XDG_RUNTIME_DIR={environment['XDG_RUNTIME_DIR']}",
        f"--setenv=DBUS_SESSION_BUS_ADDRESS={environment['DBUS_SESSION_BUS_ADDRESS']}",
        "--setenv=QT_QPA_PLATFORM=xcb", "--setenv=LANG=C.UTF-8", "--setenv=LC_ALL=C.UTF-8",
        "--", str(QBITTORRENT), "--no-splash",
    ]


#@MNX-PART id=90.00.monsterdesk.function.f023kkg1-request-qbittorrent-family-unit kind=function title="Python function request_qbittorrent_family_unit"
def request_qbittorrent_family_unit(environment: dict[str, str]) -> str:
    shown = subprocess.run(
        [str(SYSTEMCTL), "--user", "show", QBITTORRENT_FAMILY_UNIT, "-p", "LoadState", "-p", "ActiveState"],
        env=environment, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, timeout=15, check=False,
    )
    properties = dict(line.split("=", 1) for line in shown.stdout.splitlines() if "=" in line)
    if properties.get("LoadState") == "loaded":
        if properties.get("ActiveState") in {"active", "activating", "reloading"}:
            return "existing-transient-unit-active"
        subprocess.run(
            [str(SYSTEMCTL), "--user", "reset-failed", QBITTORRENT_FAMILY_UNIT],
            env=environment, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=15, check=False,
        )
        started = subprocess.run(
            [str(SYSTEMCTL), "--user", "start", QBITTORRENT_FAMILY_UNIT],
            env=environment, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, timeout=20, check=False,
        )
        if started.returncode != 0:
            raise MonsterdeskError(
                "qBittorrent family continuity unit restart failed: "
                + redact_legacy_log((started.stderr or started.stdout)[-4096:])
            )
        return "existing-transient-unit-started"
    completed = subprocess.run(
        qbittorrent_family_unit_command(environment), env=environment,
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, timeout=20, check=False,
    )
    if completed.returncode != 0:
        raise MonsterdeskError(
            "qBittorrent family continuity unit creation failed: "
            + redact_legacy_log((completed.stderr or completed.stdout)[-4096:])
        )
    return "transient-user-unit-created"


#@MNX-PART id=90.00.monsterdesk.function.f023kkg2-ensure-family-qbittorrent kind=function title="Python function ensure_family_qbittorrent_available"
def ensure_family_qbittorrent_available() -> dict[str, Any]:
    """Preserve a healthy host client and start the exact package only when service is absent.

    This Stage118 hold never terminates, signals, copies, or migrates a live qBittorrent client.
    A partial host client is given one ordinary singleton launch request and then left untouched
    even if readiness cannot be proven.
    """
    if QBITTORRENT_ZERO_DOWNTIME_HOLD is not True:
        raise MonsterdeskError("qBittorrent family continuity hold is not active")
    source_before = qbittorrent_stationary_config_identity()
    existing = ready_legacy_qbittorrent()
    if existing is not None:
        return {
            "schema": "mnx.qbittorrent.family-availability.v1",
            **existing,
            "qualified": True,
            "legacy_already_running": True,
            "legacy_started_for_availability": False,
            "healthy_client_stopped": False,
            "process_cleanup_performed": False,
            "state_copy_performed": False,
            "source_config_sha256_before": source_before["sha256"],
            "source_config_sha256_after": source_before["sha256"],
            "startup_diagnostics_bounded": True,
        }
    clients = [item for item in qbittorrent_process_inventory() if qbittorrent_client_process(item)]
    isolated = [item for item in clients if item.get("host_network_namespace") is False]
    if isolated:
        raise MonsterdeskError(
            "qBittorrent availability hold found an uncommitted isolated client and refused mutation: "
            + canonical([{"pid": item.get("pid"), "start_ticks": item.get("start_ticks")} for item in isolated])
        )
    host_clients = [item for item in clients if item.get("host_network_namespace") is True]
    if len(host_clients) > 1:
        raise MonsterdeskError(
            f"qBittorrent availability hold found {len(host_clients)} host clients and refused mutation"
        )
    if not QBITTORRENT.is_file() or not os.access(QBITTORRENT, os.X_OK):
        raise MonsterdeskError(f"qBittorrent family binary is unavailable: {QBITTORRENT}")
    host = current_host_environment()
    allowed_environment = {
        "XDG_SESSION_TYPE", "XDG_CURRENT_DESKTOP", "XDG_SESSION_DESKTOP", "DESKTOP_SESSION",
        "QT_QPA_PLATFORM", "QT_STYLE_OVERRIDE", "GTK_THEME", "LANG", "LC_ALL", "LC_CTYPE",
    }
    env = {key: value for key, value in os.environ.items()
           if key in allowed_environment and isinstance(value, str) and len(value) <= 4096}
    env.update({
        "HOME": str(USER_HOME), "USER": USER_NAME, "LOGNAME": USER_NAME,
        "SHELL": str(BASH), "PATH": "/run/current-system/sw/bin:/run/wrappers/bin",
        "DISPLAY": host["DISPLAY"], "XAUTHORITY": host["XAUTHORITY"],
        "XDG_RUNTIME_DIR": str(runtime_base()),
        "DBUS_SESSION_BUS_ADDRESS": f"unix:path={runtime_base()}/bus",
        "QT_QPA_PLATFORM": "xcb", "LANG": env.get("LANG", "C.UTF-8"),
    })
    if "LC_ALL" not in env and "LC_CTYPE" not in env:
        env["LC_ALL"] = "C.UTF-8"
    unit_action = request_qbittorrent_family_unit(env)
    deadline = time.monotonic() + 120
    while time.monotonic() < deadline:
        selected = ready_legacy_qbittorrent()
        if selected is not None:
            source_after = qbittorrent_stationary_config_identity()
            return {
                "schema": "mnx.qbittorrent.family-availability.v1",
                **selected,
                "qualified": True,
                "legacy_already_running": bool(host_clients),
                "legacy_started_for_availability": not bool(host_clients),
                "healthy_client_stopped": False,
                "process_cleanup_performed": False,
                "state_copy_performed": False,
                "ordinary_singleton_launch_requested": True,
                "continuity_unit": QBITTORRENT_FAMILY_UNIT,
                "continuity_unit_action": unit_action,
                "continuity_restart_policy": "always",
                "startup_diagnostics_bounded": True,
                "source_config_sha256_before": source_before["sha256"],
                "source_config_sha256_after": source_after["sha256"],
                "source_config_semantic_boundary_preserved": True,
            }
        time.sleep(0.25)
    shown = subprocess.run(
        [str(SYSTEMCTL), "--user", "show", QBITTORRENT_FAMILY_UNIT,
         "-p", "LoadState", "-p", "ActiveState", "-p", "SubState", "-p", "Result"],
        env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, timeout=15, check=False,
    )
    raise MonsterdeskError(
        "qBittorrent family availability could not be proven without stopping an existing client; "
        + canonical({
            "host_client_count": len(host_clients),
            "healthy_client_stopped": False,
            "continuity_unit": QBITTORRENT_FAMILY_UNIT,
            "continuity_unit_action": unit_action,
            "continuity_unit_state": redact_legacy_log(shown.stdout[-4096:]),
            "diagnostics_bounded": True,
        })
    )


#@MNX-PART id=90.00.monsterdesk.function.f023kkh-start-legacy-qbittorrent kind=function title="Python function start_legacy_qbittorrent"
def start_legacy_qbittorrent() -> dict[str, Any]:
    existing = ready_legacy_qbittorrent()
    if existing is not None:
        return {**existing, "restored": True, "already_running": True,
                "startup_diagnostics_bounded": True}
    if not QBITTORRENT.is_file() or not os.access(QBITTORRENT, os.X_OK):
        raise MonsterdeskError(f"qBittorrent rollback binary is unavailable: {QBITTORRENT}")
    host_clients = [item for item in qbittorrent_process_inventory()
                    if qbittorrent_client_process(item) and item.get("host_network_namespace") is True]
    if host_clients:
        raise MonsterdeskError("a partial host-network qBittorrent client exists without all reviewed listeners")
    release_before_start = wait_for_qbittorrent_host_port_release(
        90, "qBittorrent host ports before legacy restart"
    )
    host = current_host_environment()
    allowed_environment = {
        "XDG_SESSION_TYPE", "XDG_CURRENT_DESKTOP", "XDG_SESSION_DESKTOP", "DESKTOP_SESSION",
        "QT_QPA_PLATFORM", "QT_STYLE_OVERRIDE", "GTK_THEME", "LANG", "LC_ALL", "LC_CTYPE",
    }
    env = {key: value for key, value in os.environ.items()
           if key in allowed_environment and isinstance(value, str) and len(value) <= 4096}
    env.update({
        "HOME": str(USER_HOME), "USER": USER_NAME, "LOGNAME": USER_NAME,
        "SHELL": str(BASH), "PATH": "/run/current-system/sw/bin:/run/wrappers/bin",
        "DISPLAY": host["DISPLAY"], "XAUTHORITY": host["XAUTHORITY"],
        "XDG_RUNTIME_DIR": str(runtime_base()),
        "DBUS_SESSION_BUS_ADDRESS": f"unix:path={runtime_base()}/bus",
        "QT_QPA_PLATFORM": "xcb",
        "LANG": env.get("LANG", "C.UTF-8"),
    })
    if "LC_ALL" not in env and "LC_CTYPE" not in env:
        env["LC_ALL"] = "C.UTF-8"
    log_root = secure_dir(runtime_base() / "monsterdesk-qbittorrent-rollback")
    log_path = log_root / f"legacy-start-{os.getpid()}-{secrets.token_hex(4)}.log"
    try:
        process = subprocess.Popen(
            [str(QBITTORRENT)], stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            env=env, cwd=str(USER_HOME), start_new_session=True, close_fds=True,
        )
    except OSError as exc:
        raise MonsterdeskError(f"could not execute qBittorrent rollback binary: {exc}") from exc
    if process.stdout is None:
        raise MonsterdeskError("qBittorrent rollback launcher has no diagnostic stream")
    logger = spawn_bounded_pipe_logger(process.stdout, log_path)
    launcher_ticks = 0
    with contextlib.suppress(OSError, ValueError, MonsterdeskError):
        launcher_ticks = process_start_ticks(process.pid)
    deadline = time.monotonic() + 120
    while time.monotonic() < deadline:
        selected = ready_legacy_qbittorrent()
        if selected is not None:
            return {
                **selected,
                "restored": True,
                "already_running": False,
                "launcher_pid": process.pid,
                "launcher_start_ticks": launcher_ticks,
                "launcher_returncode": process.poll(),
                "diagnostic_log_path": str(log_path),
                "startup_diagnostics_bounded": True,
                "host_port_release_before_start": release_before_start,
            }
        time.sleep(0.25)
    failed_clients = [item for item in qbittorrent_process_inventory()
                      if qbittorrent_client_process(item) and item.get("host_network_namespace") is True]
    records: list[dict[str, Any]] = []
    for item in failed_clients:
        with contextlib.suppress(OSError, ValueError, MonsterdeskError):
            records.append(process_identity(int(item["pid"])))
    if launcher_ticks and process_matches(process.pid, launcher_ticks):
        with contextlib.suppress(OSError):
            os.killpg(process.pid, signal.SIGTERM)
    if records:
        with contextlib.suppress(Exception):
            terminate_birth_pinned_process_tree(records)
    with contextlib.suppress(Exception):
        process.wait(timeout=3)
    with contextlib.suppress(Exception):
        logger.wait(timeout=3)
    raise MonsterdeskError(
        "qBittorrent rollback did not restore the reviewed host-network listeners; "
        + canonical({
            "launcher_returncode": process.poll(),
            "host_client_count": len(failed_clients),
            "log_tail": redact_legacy_log(bounded_log_tail(log_path)),
            "log_bytes_bounded": MAX_LOG_FILE_BYTES,
        })
    )


#@MNX-PART id=90.00.monsterdesk.function.f023kki-stop-legacy-qbittorrent kind=function title="Python function stop_legacy_qbittorrent"
def stop_legacy_qbittorrent(inputs: dict[str, Any]) -> dict[str, Any]:
    pid = int(inputs["live_pid"])
    ticks = int(inputs["live_start_ticks"])
    if not process_matches(pid, ticks):
        raise MonsterdeskError("birth-pinned legacy qBittorrent process is no longer alive")
    clients = [item for item in qbittorrent_process_inventory()
               if int(item.get("pid", 0)) == pid and int(item.get("start_ticks", 0)) == ticks]
    if len(clients) != 1 or clients[0].get("host_network_namespace") is not True:
        raise MonsterdeskError("legacy qBittorrent process identity or host network namespace differs")
    tree = birth_pinned_process_tree(pid, ticks)
    method = "term"
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError as exc:
        raise MonsterdeskError(f"could not TERM legacy qBittorrent pid {pid}: {exc}") from exc
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline and any(birth_pinned_process_alive(item) for item in tree):
        time.sleep(0.10)
    remaining = [item for item in tree if birth_pinned_process_alive(item)]
    if remaining:
        termination = terminate_birth_pinned_process_tree(remaining)
        method = "term-kill" if int(termination.get("kill_sent", 0)) else "term-escalated"
    else:
        termination = {
            "record_count": len(tree), "term_sent": 1, "kill_sent": 0,
            "survivor_count": 0, "birth_pinned": True,
        }
    wait_for(lambda: not any(qbittorrent_client_process(item)
                             and item.get("host_network_namespace") is True
                             for item in qbittorrent_process_inventory()),
             15, "absence of host-network qBittorrent after stop")
    release = wait_for_qbittorrent_host_port_release(
        90, "qBittorrent TCP, UDP, and Web UI port release"
    )
    return {
        "stopped": True, "method": method, "pid": pid, "start_ticks": ticks,
        "process_tree_record_count": len(tree),
        "process_tree_termination": termination,
        "host_ports_released": True,
        "host_port_release": release,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kkj-qbittorrent-pasta-runtime kind=function title="Python function qbittorrent_pasta_runtime_evidence"
def qbittorrent_pasta_runtime_evidence(pid: int, start_ticks: int) -> dict[str, Any]:
    if not process_matches(pid, start_ticks):
        raise MonsterdeskError("qBittorrent pasta launch identity is not alive")
    raw = proc_bytes(Path(f"/proc/{pid}/cmdline"), 262144)
    arguments = [item.decode("utf-8", errors="replace") for item in raw.split(b"\0") if item]
    expected = qbittorrent_pasta_options()
    exact = len(arguments) > len(expected) and arguments[:len(expected)] == expected and arguments[len(expected)] == "--"
    return {
        "birth_pinned_alive": True,
        "birth_pinned_command_exact": exact,
        "peer_tcp_spec": f"%{EXPECTED_QBITTORRENT_HOST_INTERFACE}/{EXPECTED_QBITTORRENT_LISTEN_PORT}",
        "peer_udp_spec": f"%{EXPECTED_QBITTORRENT_HOST_INTERFACE}/{EXPECTED_QBITTORRENT_LISTEN_PORT}",
        "webui_tcp_spec": f"127.0.0.1/{EXPECTED_QBITTORRENT_WEBUI_PORT}",
        "remote_endpoints_exported": False,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kkk-qbittorrent-webui-connect kind=function title="Python function qbittorrent_webui_connect_evidence"
def qbittorrent_webui_connect_evidence() -> dict[str, Any]:
    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    client.settimeout(1.0)
    try:
        client.connect(("127.0.0.1", EXPECTED_QBITTORRENT_WEBUI_PORT))
        client.sendall(b"GET / HTTP/1.0\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n")
        response = client.recv(4096)
    except OSError as exc:
        return {
            "attempted": True, "connectable": False,
            "error_errno": getattr(exc, "errno", None),
            "raw_response_exported": False,
        }
    finally:
        client.close()
    first_line = response.splitlines()[0] if response else b""
    return {
        "attempted": True,
        "connectable": True,
        "http_framing_observed": first_line.startswith(b"HTTP/"),
        "response_bytes": len(response),
        "response_sha256": hashlib.sha256(response).hexdigest(),
        "raw_response_exported": False,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kkl-qbittorrent-mount-boundary kind=function title="Python function verify_qbittorrent_mount_boundary"
def verify_qbittorrent_mount_boundary(pid: int, expected_home: Path) -> dict[str, Any]:
    raw = Path(f"/proc/{pid}/mountinfo").read_bytes()
    mounts = parse_mountinfo(raw)
    expected_modes = {
        str(USER_HOME): "rw",
        "/nix/store": "ro",
        "/run/monsterdesk-control": "ro",
        "/tmp/.X11-unix": "ro",
        "/etc/resolv.conf": "ro",
        str(EXPECTED_QBITTORRENT_SAVE_PATH): "rw",
        str(EXPECTED_QBITTORRENT_TEMP_PATH): "rw",
    }
    missing = sorted(path for path in expected_modes if path not in mounts)
    wrong = sorted(
        ({"path": path, "expected": mode, "observed": mounts[path]["mode"]}
         for path, mode in expected_modes.items()
         if path in mounts and mounts[path]["mode"] != mode),
        key=lambda item: item["path"],
    )
    if missing or wrong:
        raise MonsterdeskError(
            "qBittorrent mount boundary differs: " + canonical({"missing": missing, "wrong": wrong})
        )
    root = Path(f"/proc/{pid}/root")
    expected_stat = expected_home.stat()
    process_home_stat = (root / USER_HOME.relative_to("/")).stat()
    original_home_stat = USER_HOME.stat()
    if (process_home_stat.st_dev, process_home_stat.st_ino) != (expected_stat.st_dev, expected_stat.st_ino):
        raise MonsterdeskError("qBittorrent guest home is not the source-owned private home")
    if (process_home_stat.st_dev, process_home_stat.st_ino) == (original_home_stat.st_dev, original_home_stat.st_ino):
        raise MonsterdeskError("qBittorrent guest received the ordinary host home")
    identity_mismatches: list[str] = []
    for source in (EXPECTED_QBITTORRENT_SAVE_PATH, EXPECTED_QBITTORRENT_TEMP_PATH):
        source_stat = source.stat()
        guest_stat = (root / source.relative_to("/")).stat()
        if (source_stat.st_dev, source_stat.st_ino) != (guest_stat.st_dev, guest_stat.st_ino):
            identity_mismatches.append(str(source))
    if identity_mismatches:
        raise MonsterdeskError("qBittorrent writable bind identities differ: " + canonical(identity_mismatches))
    forbidden = [
        USER_HOME / ".ssh", USER_HOME / ".gnupg", USER_HOME / ".mozilla",
        USER_HOME / ".config/i3", Path(f"/run/user/{USER_UID}/bus"),
    ]
    exposed: list[str] = []
    for path in forbidden:
        try:
            (root / path.relative_to("/")).lstat()
        except FileNotFoundError:
            continue
        exposed.append(str(path))
    if exposed:
        raise MonsterdeskError("qBittorrent private root exposes forbidden host paths: " + canonical(exposed))
    return {
        "matched": True,
        "private_home_identity_matched": True,
        "ordinary_host_home_donated": False,
        "host_session_bus_donated": False,
        "read_write_root_count": 2,
        "expected_mount_modes": expected_modes,
        "bind_source_identities_matched": True,
        "exact_bind_source_count": 2,
        "payload_contents_read": False,
        "torrent_resume_data_read": False,
        "raw_mountinfo_exported": False,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kkm-verify-isolated-qbittorrent kind=function title="Python function verify_isolated_qbittorrent"
def verify_isolated_qbittorrent(tracked: dict[str, Any], *, expected_home: Path) -> dict[str, Any]:
    pasta_pid = int(tracked.get("pid", 0))
    pasta_ticks = int(tracked.get("start_ticks", 0))
    selected: dict[str, Any] | None = None
    namespace_value: dict[str, Any] = {"table_readable": False, "endpoints": []}
    peer_forward: dict[str, Any] = {"connectable": False}
    webui_forward: dict[str, Any] = {"connectable": False}
    pasta_evidence: dict[str, Any] = {}
    last: dict[str, Any] = {}
    deadline = time.monotonic() + 120
    next_probe = 0.0
    while time.monotonic() < deadline:
        inventory = [item for item in qbittorrent_process_inventory() if qbittorrent_client_process(item)]
        host_clients = [item for item in inventory if item.get("host_network_namespace") is True]
        isolated = [item for item in inventory if item.get("host_network_namespace") is False]
        pasta_evidence = qbittorrent_pasta_runtime_evidence(pasta_pid, pasta_ticks)
        candidate = isolated[0] if len(isolated) == 1 else None
        peer_tcp = False
        peer_udp = False
        webui_tcp = False
        explicit_private_paths = False
        outbound_count = 0
        if candidate is not None:
            namespace_value = network_namespace_socket_endpoints(Path(f"/proc/{int(candidate['pid'])}"))
            endpoints = namespace_value.get("endpoints", [])
            peer_tcp = any(item.get("protocol") in {"tcp", "tcp6"}
                           and item.get("kind") == "listen"
                           and int(item.get("port", 0)) == EXPECTED_QBITTORRENT_LISTEN_PORT
                           for item in endpoints)
            peer_udp = any(item.get("protocol") in {"udp", "udp6"}
                           and item.get("kind") == "bound"
                           and int(item.get("port", 0)) == EXPECTED_QBITTORRENT_LISTEN_PORT
                           for item in endpoints)
            webui_tcp = any(item.get("protocol") in {"tcp", "tcp6"}
                            and item.get("kind") == "listen"
                            and int(item.get("port", 0)) == EXPECTED_QBITTORRENT_WEBUI_PORT
                            for item in endpoints)
            outbound_count = sum(
                1 for item in endpoints
                if item.get("protocol") in {"tcp", "tcp6"}
                and item.get("kind") == "connected-local"
                and int(item.get("port", 0)) not in {
                    EXPECTED_QBITTORRENT_LISTEN_PORT, EXPECTED_QBITTORRENT_WEBUI_PORT,
                }
            )
            environment = candidate.get("environment", {})
            explicit_private_paths = (
                environment.get("HOME") == str(USER_HOME)
                and environment.get("XDG_CONFIG_HOME") == str(USER_HOME / ".config")
                and environment.get("XDG_DATA_HOME") == str(USER_HOME / ".local/share")
            )
        now = time.monotonic()
        if (candidate is not None and peer_tcp and peer_udp and webui_tcp
                and pasta_evidence.get("birth_pinned_command_exact") is True
                and now >= next_probe):
            if peer_forward.get("connectable") is not True:
                peer_forward = tcp_connect_evidence(
                    EXPECTED_QBITTORRENT_HOST_IPV4, EXPECTED_QBITTORRENT_LISTEN_PORT
                )
            if webui_forward.get("connectable") is not True:
                webui_forward = qbittorrent_webui_connect_evidence()
            next_probe = now + 1.0
        last = {
            "pasta_birth_pinned_alive": pasta_evidence.get("birth_pinned_alive") is True,
            "pasta_command_exact": pasta_evidence.get("birth_pinned_command_exact") is True,
            "host_network_qbittorrent_count": len(host_clients),
            "isolated_qbittorrent_count": len(isolated),
            "namespace_socket_table_readable": namespace_value.get("table_readable") is True,
            "peer_tcp_listener_observed": peer_tcp,
            "peer_udp_socket_observed": peer_udp,
            "webui_tcp_listener_observed": webui_tcp,
            "peer_host_forward_connectable": peer_forward.get("connectable") is True,
            "webui_host_loopback_connectable": webui_forward.get("connectable") is True,
            "explicit_private_paths_observed": explicit_private_paths,
            "outbound_established_socket_count": outbound_count,
            "remote_endpoints_exported": False,
        }
        if (not host_clients and candidate is not None
                and all(last.get(key) is True for key in (
                    "pasta_birth_pinned_alive", "pasta_command_exact",
                    "namespace_socket_table_readable", "peer_tcp_listener_observed",
                    "peer_udp_socket_observed", "webui_tcp_listener_observed",
                    "peer_host_forward_connectable", "webui_host_loopback_connectable",
                    "explicit_private_paths_observed",
                ))):
            selected = candidate
            break
        time.sleep(0.25)
    if selected is None:
        raise MonsterdeskError(
            "isolated qBittorrent readiness timed out; "
            + canonical({"schema": "mnx.qbittorrent.isolated-readiness.v1", **last})
        )
    namespaces = selected.get("namespaces", {})
    if namespaces.get("net") in {"unavailable", os.readlink("/proc/self/ns/net")}:
        raise MonsterdeskError("isolated qBittorrent did not receive a distinct network namespace")
    if namespaces.get("mnt") in {"unavailable", os.readlink("/proc/self/ns/mnt")}:
        raise MonsterdeskError("isolated qBittorrent did not receive a distinct mount namespace")
    filesystem = verify_qbittorrent_mount_boundary(int(selected["pid"]), expected_home)
    final_peer = tcp_connect_evidence(EXPECTED_QBITTORRENT_HOST_IPV4, EXPECTED_QBITTORRENT_LISTEN_PORT)
    final_webui = qbittorrent_webui_connect_evidence()
    if final_peer.get("connectable") is not True or final_webui.get("connectable") is not True:
        raise MonsterdeskError("qBittorrent active host forwards did not remain connectable")
    return {
        "isolated": True,
        "pasta_command_exact": True,
        "pasta_interface": EXPECTED_QBITTORRENT_HOST_INTERFACE,
        "peer_tcp_host_binding": f"%{EXPECTED_QBITTORRENT_HOST_INTERFACE}/{EXPECTED_QBITTORRENT_LISTEN_PORT}",
        "peer_udp_host_binding": f"%{EXPECTED_QBITTORRENT_HOST_INTERFACE}/{EXPECTED_QBITTORRENT_LISTEN_PORT}",
        "webui_host_binding": f"127.0.0.1/{EXPECTED_QBITTORRENT_WEBUI_PORT}",
        "public_webui_ingress": False,
        "peer_tcp_listener_observed": True,
        "peer_udp_listener_observed": True,
        "webui_listener_observed": True,
        "host_to_namespace_tcp_peer_connect": True,
        "host_loopback_webui_connect": True,
        "udp_forward_policy_exact_and_fixture_qualified": True,
        "network_namespace_distinct": True,
        "mount_namespace_distinct": True,
        "host_network_qbittorrent_count": 0,
        "isolated_qbittorrent_count": 1,
        "outbound_established_socket_count": int(last.get("outbound_established_socket_count", 0)),
        "filesystem_boundary": filesystem,
        "filesystem_boundary_matched": True,
        "remote_endpoints_exported": False,
        "credential_values_exported": False,
        "payload_contents_read": False,
        "torrent_resume_data_read": False,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kkn-stabilize-qbittorrent-private-config kind=function title="Python function stabilize_qbittorrent_private_config_after_launch"
def stabilize_qbittorrent_private_config_after_launch(home: Path) -> dict[str, Any]:
    config_path = home / ".config/qBittorrent/qBittorrent.conf"
    samples: list[dict[str, Any]] = []
    stable_count = 0
    previous: tuple[str, int] | None = None
    mode_repairs = 0
    for sample_index in range(1, 9):
        raw, before = stable_regular_read(config_path, MAX_QBITTORRENT_CONFIG_BYTES, expected_uid=USER_UID)
        qbittorrent_private_config_semantics(raw)
        mode_before = int(before["mode"])
        repaired = mode_before != 0o600
        if repaired:
            os.chmod(config_path, 0o600)
            mode_repairs += 1
        after_raw, after = stable_regular_read(config_path, MAX_QBITTORRENT_CONFIG_BYTES, expected_uid=USER_UID)
        qbittorrent_private_config_semantics(after_raw)
        if int(after["mode"]) != 0o600:
            raise MonsterdeskError("qBittorrent post-launch private config did not converge to 0600")
        identity = (str(after["sha256"]), int(after["mode"]))
        stable_count = stable_count + 1 if identity == previous else 1
        previous = identity
        samples.append({
            "sample_index": sample_index,
            "mode_before": mode_before,
            "mode_after": int(after["mode"]),
            "mode_repaired": repaired,
            "sha256": after["sha256"],
            "semantic_boundary_matched": True,
        })
        if sample_index >= 4 and stable_count >= 3:
            break
        time.sleep(0.5)
    if len(samples) < 4 or stable_count < 3:
        raise MonsterdeskError("qBittorrent post-launch private config did not reach stable hardened state")
    final_raw, final_meta = stable_regular_read(
        config_path, MAX_QBITTORRENT_CONFIG_BYTES, expected_uid=USER_UID
    )
    qbittorrent_private_config_semantics(final_raw)
    if int(final_meta["mode"]) != 0o600:
        raise MonsterdeskError("qBittorrent final private config strict read is not mode 0600")
    return {
        "schema": "mnx.qbittorrent.post-launch-private-config.v1",
        "converged": True,
        "sample_count": len(samples),
        "required_unchanged_samples": 3,
        "observed_unchanged_samples": stable_count,
        "mode_repair_count": mode_repairs,
        "final_mode": int(final_meta["mode"]),
        "final_sha256": final_meta["sha256"],
        "credential_values_exported": False,
        "samples": samples,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kko-quiesce-qbittorrent-launch kind=function title="Python function quiesce_qbittorrent_launch"
def quiesce_qbittorrent_launch(session: Any, launch_id: str | None,
                                tree: list[dict[str, Any]]) -> dict[str, Any]:
    tracked_termination: dict[str, Any] | None = None
    if launch_id is not None:
        with contextlib.suppress(Exception):
            if any(item.get("launch_id") == launch_id for item in session.processes()):
                tracked_termination = session.terminate(launch_id, "TERM")
    termination = terminate_birth_pinned_process_tree(tree) if tree else {
        "record_count": 0, "term_sent": 0, "kill_sent": 0,
        "survivor_count": 0, "birth_pinned": True,
    }
    wait_for(lambda: not any(qbittorrent_client_process(item)
                             and item.get("host_network_namespace") is False
                             for item in qbittorrent_process_inventory()),
             15, "isolated qBittorrent process-tree quiescence")
    release = wait_for_qbittorrent_host_port_release(
        90, "qBittorrent host port release after isolated close"
    )
    return {
        "tracked_termination": tracked_termination,
        "tree": termination,
        "isolated_clients_remaining": 0,
        "host_ports_released": True,
        "host_port_release": release,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kkp-rehearse-qbittorrent-cutover kind=function title="Python function rehearse_qbittorrent_cutover"
def rehearse_qbittorrent_cutover(session: Any, preflight: dict[str, Any],
                                  qualification: dict[str, Any]) -> dict[str, Any]:
    plan = qualification.get("cutover_plan", {})
    if plan.get("ready_for_rollback_rehearsal") is not True:
        raise MonsterdeskError("qBittorrent cutover qualification is not ready for rehearsal")
    lock_fd = acquire_qbittorrent_cutover_lock()
    launch: dict[str, Any] | None = None
    launch_tree: list[dict[str, Any]] = []
    original_error: Exception | None = None
    restore_error: Exception | None = None
    stop_info: dict[str, Any] = {}
    source_after_stop: dict[str, Any] = {}
    private_seed: dict[str, Any] = {}
    runtime_before_hardening: dict[str, Any] = {}
    runtime_after_hardening: dict[str, Any] = {}
    hardening: dict[str, Any] = {}
    quiescence: dict[str, Any] = {}
    legacy_restore: dict[str, Any] = {}
    prior_authority = os.environ.get("MNX_MONSTERDESK_QBITTORRENT_REHEARSAL")
    try:
        inputs = qbittorrent_cutover_inputs(preflight)
        stop_info = stop_legacy_qbittorrent(inputs)
        source_after_stop = qbittorrent_stationary_config_identity()
        if any(qbittorrent_client_process(item) for item in qbittorrent_process_inventory()):
            raise MonsterdeskError("qBittorrent process remained after legacy stop and before private migration")
        app_home = session._app_home("qbittorrent-live")
        private_seed = prepare_qbittorrent_live_home(
            app_home, source_config_sha256=source_after_stop["sha256"]
        )
        os.environ["MNX_MONSTERDESK_QBITTORRENT_REHEARSAL"] = "1"
        launch = session.launch("qbittorrent-live")["launch"]
        runtime_before_hardening = verify_isolated_qbittorrent(launch, expected_home=app_home)
        hardening = stabilize_qbittorrent_private_config_after_launch(app_home)
        runtime_after_hardening = verify_isolated_qbittorrent(launch, expected_home=app_home)
        launch_tree = birth_pinned_process_tree(int(launch["pid"]), int(launch["start_ticks"]))
        quiescence = quiesce_qbittorrent_launch(session, str(launch["launch_id"]), launch_tree)
        legacy_restore = start_legacy_qbittorrent()
        source_after_restore = qbittorrent_stationary_config_identity()
        return {
            "schema": "mnx.qbittorrent.cutover-rehearsal.v1",
            "authority": "standing-p2p-security-delegation-plus-candidate-owned-mnx-test",
            "status": "pass",
            "legacy_stop": {
                "confirmed": stop_info.get("stopped") is True,
                "method": stop_info.get("method"),
                "process_tree_record_count": stop_info.get("process_tree_record_count"),
                "process_tree_termination": stop_info.get("process_tree_termination"),
                "host_port_release": stop_info.get("host_port_release"),
            },
            "source_config_after_stop_sha256": source_after_stop.get("sha256"),
            "source_config_after_restore_sha256": source_after_restore.get("sha256"),
            "source_config_byte_identity_may_change_on_clean_application_exit": True,
            "source_config_semantic_boundary_preserved": True,
            "private_state": {
                "source_config_sha256": private_seed.get("source_config_sha256"),
                "private_config_sha256": private_seed.get("private_config_sha256"),
                "private_config_mode": private_seed.get("private_config_mode"),
                "copy_mode": "archive-reflink-auto",
                "original_state_retained": True,
                "credential_values_exported": False,
                "torrent_resume_data_read": False,
                "payload_contents_read": False,
            },
            "runtime_before_hardening": runtime_before_hardening,
            "post_launch_private_config_hardening": hardening,
            "runtime": runtime_after_hardening,
            "launch_tree_record_count": len(launch_tree),
            "launch_tree_quiescence": quiescence,
            "legacy_restore": {
                "confirmed": legacy_restore.get("restored") is True,
                "host_network_namespace": legacy_restore.get("host_network_namespace") is True,
                "peer_tcp_port": legacy_restore.get("peer_tcp_port"),
                "peer_udp_port": legacy_restore.get("peer_udp_port"),
                "webui_tcp_port": legacy_restore.get("webui_tcp_port"),
                "startup_diagnostics_bounded": legacy_restore.get("startup_diagnostics_bounded") is True,
            },
            "legacy_restored_before_test_success": True,
            "persistent_state_committed": False,
            "launcher_replaced": False,
            "receipt_committed": False,
            "receipt_is_last_commit_point_deferred": True,
            "router_state_mutated": False,
            "firewall_changed": False,
        }
    except Exception as exc:
        original_error = exc
        if launch is not None:
            with contextlib.suppress(Exception):
                if not launch_tree:
                    launch_tree = birth_pinned_process_tree(int(launch["pid"]), int(launch["start_ticks"]))
                quiesce_qbittorrent_launch(session, str(launch.get("launch_id")), launch_tree)
        try:
            legacy_restore = start_legacy_qbittorrent()
        except Exception as restore_exc:
            restore_error = restore_exc
    finally:
        if prior_authority is None:
            os.environ.pop("MNX_MONSTERDESK_QBITTORRENT_REHEARSAL", None)
        else:
            os.environ["MNX_MONSTERDESK_QBITTORRENT_REHEARSAL"] = prior_authority
        release_qbittorrent_cutover_lock(lock_fd)
    if restore_error is not None:
        raise MonsterdeskError(
            f"qBittorrent rehearsal failed and legacy rollback also failed: rehearsal={original_error}; rollback={restore_error}"
        ) from original_error
    raise MonsterdeskError(
        f"qBittorrent cutover rehearsal failed; legacy application restored: {original_error}"
    ) from original_error


#@MNX-PART id=90.00.monsterdesk.function.f023kkq0-qbittorrent-cutover-state-root kind=function title="Python function qbittorrent_cutover_state_root"
def qbittorrent_cutover_state_root() -> Path:
    state_home = Path(os.environ.get("XDG_STATE_HOME", USER_HOME / ".local/state"))
    return secure_dir(state_home / "monsterdesk-qbittorrent")


#@MNX-PART id=90.00.monsterdesk.function.f023kkq1-qbittorrent-cutover-receipt-path kind=function title="Python function qbittorrent_cutover_receipt_path"
def qbittorrent_cutover_receipt_path() -> Path:
    return qbittorrent_cutover_state_root() / "qbittorrent-cutover.json"


#@MNX-PART id=90.00.monsterdesk.function.f023kkq2-load-qbittorrent-cutover-receipt kind=function title="Python function load_qbittorrent_cutover_receipt"
def load_qbittorrent_cutover_receipt() -> dict[str, Any] | None:
    path = qbittorrent_cutover_receipt_path()
    try:
        st = path.lstat()
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        raise MonsterdeskError("qBittorrent cutover receipt is not a regular file")
    if st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) != 0o600 or st.st_nlink != 1:
        raise MonsterdeskError("qBittorrent cutover receipt ownership, mode, or link count differs")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise MonsterdeskError(f"qBittorrent cutover receipt is unreadable: {exc}") from exc
    if (not isinstance(value, dict)
            or value.get("schema") != "mnx.qbittorrent.cutover-receipt.v1"
            or value.get("committed") is not True
            or value.get("instance") != "qbittorrent"
            or value.get("version") != VERSION
            or value.get("accepted_stage116_source_sha256") != EXPECTED_QBITTORRENT_STAGE116_SOURCE_SHA256
            or value.get("accepted_stage117_source_sha256") != EXPECTED_QBITTORRENT_STAGE117_SOURCE_SHA256
            or not re.fullmatch(r"[0-9a-f]{64}", str(value.get("source_config_sha256", "")))
            or int(value.get("peer_port", 0)) != EXPECTED_QBITTORRENT_LISTEN_PORT
            or int(value.get("webui_port", 0)) != EXPECTED_QBITTORRENT_WEBUI_PORT
            or value.get("webui_host_binding") != f"127.0.0.1/{EXPECTED_QBITTORRENT_WEBUI_PORT}"
            or value.get("normal_launcher_replaced") is not True
            or value.get("receipt_is_last_commit_point") is not True):
        raise MonsterdeskError("qBittorrent cutover receipt identity differs")
    return value


#@MNX-PART id=90.00.monsterdesk.function.f023kkq2a-bound-qbittorrent-cutover-report kind=function title="Python function bound_qbittorrent_cutover_report"
def bound_qbittorrent_cutover_report(value: dict[str, Any]) -> dict[str, Any]:
    if len(canonical(value).encode("utf-8")) > MAX_QBITTORRENT_CUTOVER_REPORT_BYTES:
        raise MonsterdeskError("qBittorrent cutover report exceeds byte policy")
    return value


#@MNX-PART id=90.00.monsterdesk.function.f023kkq3-cleanup-stale-qbittorrent kind=function title="Python function cleanup_stale_qbittorrent_cutover_processes"
def cleanup_stale_qbittorrent_cutover_processes() -> dict[str, Any]:
    isolated = [item for item in qbittorrent_process_inventory()
                if qbittorrent_client_process(item) and item.get("host_network_namespace") is False]
    records: list[dict[str, Any]] = []
    for item in isolated:
        with contextlib.suppress(OSError, ValueError, MonsterdeskError):
            records.append(process_identity(int(item["pid"])))
    termination = terminate_birth_pinned_process_tree(records) if records else {
        "record_count": 0,
        "term_sent": 0,
        "kill_sent": 0,
        "survivor_count": 0,
        "birth_pinned": True,
    }
    if records:
        wait_for(lambda: not any(qbittorrent_client_process(item)
                                 and item.get("host_network_namespace") is False
                                 for item in qbittorrent_process_inventory()),
                 15, "stale isolated qBittorrent process cleanup")
    release = wait_for_qbittorrent_host_port_release(
        90, "qBittorrent host ports after stale isolated cleanup"
    )
    return {
        "cleanup_performed": bool(records),
        "isolated_client_count_before": len(isolated),
        "termination": termination,
        "host_port_release": release,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kkq4-normalize-qbittorrent-cutover-prestate kind=function title="Python function normalize_legacy_qbittorrent_cutover_prestate"
def normalize_legacy_qbittorrent_cutover_prestate() -> dict[str, Any]:
    legacy = ensure_legacy_qbittorrent_running()
    preflight = inspect_qbittorrent_boundary(USER_HOME, expected_uid=USER_UID, include_runtime=True)
    qualification = qualify_qbittorrent_cutover(preflight)
    inputs = qbittorrent_cutover_inputs(preflight)
    pid = int(legacy.get("pid", 0))
    ticks = int(legacy.get("start_ticks", 0))
    if (pid <= 0 or ticks <= 0
            or legacy.get("host_network_namespace") is not True
            or legacy.get("startup_diagnostics_bounded") is not True
            or int(legacy.get("peer_tcp_port", 0)) != EXPECTED_QBITTORRENT_LISTEN_PORT
            or int(legacy.get("peer_udp_port", 0)) != EXPECTED_QBITTORRENT_LISTEN_PORT
            or int(legacy.get("webui_tcp_port", 0)) != EXPECTED_QBITTORRENT_WEBUI_PORT):
        raise MonsterdeskError("normalized legacy qBittorrent prestate lacks reviewed process and listener evidence")
    if (int(inputs.get("live_pid", 0)) != pid
            or int(inputs.get("live_start_ticks", 0)) != ticks):
        raise MonsterdeskError("legacy qBittorrent identity changed between recovery and cutover qualification")
    if qualification.get("cutover_plan", {}).get("ready_for_rollback_rehearsal") is not True:
        raise MonsterdeskError("normalized qBittorrent prestate is not ready for the proven cutover transaction")
    evidence = {
        "schema": "mnx.qbittorrent.cutover-prestate.v1",
        "qualified": True,
        "legacy_already_running": legacy.get("already_running") is True,
        "legacy_started_for_cutover": legacy.get("already_running") is False,
        "host_network_namespace": True,
        "peer_tcp_port": EXPECTED_QBITTORRENT_LISTEN_PORT,
        "peer_udp_port": EXPECTED_QBITTORRENT_LISTEN_PORT,
        "webui_tcp_port": EXPECTED_QBITTORRENT_WEBUI_PORT,
        "pid_birth_pin_matched": True,
        "startup_diagnostics_bounded": True,
        "source_config_sha256": str(inputs.get("source_config_sha256", "")),
        "semantic_boundary_matched": True,
        "original_state_deleted": False,
        "router_state_mutated": False,
    }
    return {
        "legacy": legacy,
        "preflight": preflight,
        "qualification": qualification,
        "inputs": inputs,
        "evidence": evidence,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023kkq5-verify-committed-qbittorrent kind=function title="Python function verify_committed_qbittorrent_cutover"
def verify_committed_qbittorrent_cutover() -> dict[str, Any]:
    receipt = load_qbittorrent_cutover_receipt()
    if receipt is None:
        raise MonsterdeskError("committed qBittorrent cutover receipt is absent")
    previous_instance = os.environ.get("MONSTERDESK_INSTANCE")
    try:
        os.environ["MONSTERDESK_INSTANCE"] = "qbittorrent"
        if control_socket_path().is_socket():
            status = call_daemon("status")
        elif unit_active():
            wait_for(lambda: control_socket_path().is_socket(), 12,
                     "committed qBittorrent instance control socket")
            status = call_daemon("status")
        else:
            status = start_session(show=False)
        if status.get("instance") != "qbittorrent":
            raise MonsterdeskError("committed qBittorrent daemon published the wrong instance identity")
        app_home = qbittorrent_cutover_state_root() / "apps/qbittorrent-live/home"
        seed = verify_qbittorrent_live_seed(app_home)
        if seed.get("source_config_sha256") != receipt.get("source_config_sha256"):
            raise MonsterdeskError("committed qBittorrent seed marker and receipt source identities differ")
        launches = [item for item in status.get("launches", [])
                    if item.get("profile") == "qbittorrent-live" and item.get("alive")]
        if len(launches) > 1:
            raise MonsterdeskError(f"committed qBittorrent instance has {len(launches)} live launches")
        if not launches:
            if status.get("version") != VERSION:
                raise MonsterdeskError(
                    "committed qBittorrent daemon from another protocol version has no live application"
                )
            launches = [call_daemon("launch", {"profile": "qbittorrent-live"})["launch"]]
            status = call_daemon("status")
        if len(launches) != 1:
            raise MonsterdeskError(f"committed qBittorrent instance has {len(launches)} live launches")
        launch = launches[0]
        runtime_before_hardening = verify_isolated_qbittorrent(launch, expected_home=app_home)
        hardening = stabilize_qbittorrent_private_config_after_launch(app_home)
        runtime = verify_isolated_qbittorrent(launch, expected_home=app_home)
        probe = status.get("x11_authentication", {}).get("probes", {}).get("qbittorrent-live", {})
        if probe.get("state") != "pass" or probe.get("wrong_cookie_rejected") is not True:
            raise MonsterdeskError("committed qBittorrent native X authentication proof differs")
        return {
            "schema": "mnx.qbittorrent.committed-runtime.v1",
            "receipt_committed": True,
            "daemon_version": status.get("version"),
            "daemon_build_revision": status.get("build_revision"),
            "candidate_version_matches_daemon": status.get("version") == VERSION,
            "candidate_build_revision_matches_daemon": status.get("build_revision") == BUILD_REVISION,
            "launch": {
                "launch_id": launch.get("launch_id"),
                "pid": int(launch.get("pid", 0)),
                "start_ticks": int(launch.get("start_ticks", 0)),
                "window_id": int(launch.get("window_id", 0)),
            },
            "runtime_before_post_launch_hardening": runtime_before_hardening,
            "post_launch_private_config_hardening": hardening,
            "runtime": runtime,
            "native_x11_probe": True,
            "private_seed_semantic_boundary": seed.get("semantic_boundary_matched") is True,
            "source_state_retained": True,
            "router_state_mutated": False,
        }
    finally:
        if previous_instance is None:
            os.environ.pop("MONSTERDESK_INSTANCE", None)
        else:
            os.environ["MONSTERDESK_INSTANCE"] = previous_instance


#@MNX-PART id=90.00.monsterdesk.function.f023kkq6-commit-qbittorrent-cutover kind=function title="Python function commit_qbittorrent_cutover"
def commit_qbittorrent_cutover() -> dict[str, Any]:
    if os.environ.get("MNX_MONSTERDESK_POST_ACCEPTANCE") != "1":
        raise MonsterdeskError("qBittorrent cutover commit requires sealed mnx-switch post-acceptance authority")
    if QBITTORRENT_CUTOVER_AUTHORIZED is not True:
        raise MonsterdeskError("standing P2P cutover authority is not recorded")
    previous_instance = os.environ.get("MONSTERDESK_INSTANCE")
    try:
        lock_fd = acquire_qbittorrent_cutover_lock()
    except BlockingIOError as exc:
        raise MonsterdeskError("another qBittorrent cutover or launcher owns the transaction lock") from exc
    original_error: Exception | None = None
    result: dict[str, Any] = {}
    try:
        os.environ["MONSTERDESK_INSTANCE"] = "qbittorrent"
        existing = load_qbittorrent_cutover_receipt()
        if existing is not None:
            current = verify_committed_qbittorrent_cutover()
            status = call_daemon("status")
            if status.get("build_revision") == BUILD_REVISION:
                call_daemon("show")
                return bound_qbittorrent_cutover_report({
                    "schema": "mnx.qbittorrent.cutover.v2",
                    "status": "already-committed",
                    "receipt": existing,
                    "runtime": current.get("runtime"),
                    "post_launch_private_config_hardening": current.get("post_launch_private_config_hardening"),
                    "runtime_build_revision": status.get("build_revision"),
                    "receipt_is_last_commit_point": True,
                    "router_state_mutated": False,
                })
            stop_result = stop_session()
            if (stop_result.get("stopped") is not True
                    or stop_result.get("unit_inactive") is not True
                    or stop_result.get("socket_absent") is not True):
                raise MonsterdeskError("accepted qBittorrent daemon was not proven stopped before runtime refresh")
            wait_for_qbittorrent_host_port_release(
                90, "qBittorrent host ports before accepted runtime refresh"
            )
            refreshed_status = start_session(show=False)
            if refreshed_status.get("build_revision") != BUILD_REVISION:
                raise MonsterdeskError("refreshed qBittorrent daemon did not publish the candidate build revision")
            refreshed_launch = call_daemon("launch", {"profile": "qbittorrent-live"})["launch"]
            app_home = qbittorrent_cutover_state_root() / "apps/qbittorrent-live/home"
            runtime_before_show = verify_isolated_qbittorrent(refreshed_launch, expected_home=app_home)
            call_daemon("show")
            running = [item for item in call_daemon("processes")["processes"]
                       if item.get("launch_id") == refreshed_launch.get("launch_id")
                       and item.get("profile") == "qbittorrent-live" and item.get("alive")]
            if len(running) != 1:
                raise MonsterdeskError("refreshed qBittorrent launch did not remain birth-pinned after showing its viewer")
            runtime_after_show_before_hardening = verify_isolated_qbittorrent(
                running[0], expected_home=app_home
            )
            hardening = stabilize_qbittorrent_private_config_after_launch(app_home)
            runtime = verify_isolated_qbittorrent(running[0], expected_home=app_home)
            seed = verify_qbittorrent_live_seed(app_home)
            refreshed_receipt = {
                **existing,
                "version": VERSION,
                "runtime_build_revision": BUILD_REVISION,
                "runtime_refreshed_at": time.time(),
                "private_config_current_sha256": seed.get("private_config_current_sha256"),
                "post_launch_private_config_hardening": hardening,
                "runtime_reverified_after_refresh_show": True,
                "receipt_is_last_commit_point": True,
            }
            refresh_result = bound_qbittorrent_cutover_report({
                "schema": "mnx.qbittorrent.cutover.v2",
                "status": "accepted-runtime-refreshed",
                "receipt": refreshed_receipt,
                "runtime_before_refresh": current.get("runtime"),
                "runtime_before_show": runtime_before_show,
                "runtime_after_show_before_hardening": runtime_after_show_before_hardening,
                "runtime": runtime,
                "post_launch_private_config_hardening": hardening,
                "persistent_launch_identity_preserved_during_post_launch_hardening": True,
                "runtime_build_revision": BUILD_REVISION,
                "receipt_is_last_commit_point": True,
                "router_state_mutated": False,
            })
            atomic_json(qbittorrent_cutover_receipt_path(), refreshed_receipt)
            os.chmod(qbittorrent_cutover_receipt_path(), 0o600)
            return refresh_result

        os.environ["MONSTERDESK_INSTANCE"] = previous_instance or "main"
        normalized = normalize_legacy_qbittorrent_cutover_prestate()
        inputs = normalized["inputs"]
        prestate = normalized["evidence"]
        stop_info = stop_legacy_qbittorrent(inputs)
        os.environ["MONSTERDESK_INSTANCE"] = "qbittorrent"
        stop_result = stop_session()
        if (stop_result.get("stopped") is not True
                or stop_result.get("unit_inactive") is not True
                or stop_result.get("socket_absent") is not True):
            raise MonsterdeskError("persistent qBittorrent instance was not proven stopped before private-state replacement")
        profile_root = qbittorrent_cutover_state_root() / "apps/qbittorrent-live"
        if profile_root.exists() or profile_root.is_symlink():
            if profile_root.is_symlink() or not profile_root.is_dir():
                raise MonsterdeskError("stale qBittorrent private profile root is unsafe")
            shutil.rmtree(profile_root)
        app_home = secure_dir(profile_root / "home")
        stationary = qbittorrent_stationary_config_identity()
        seed = prepare_qbittorrent_live_home(app_home, source_config_sha256=stationary["sha256"])
        start_session(show=False)
        launch = call_daemon("launch", {"profile": "qbittorrent-live"})["launch"]
        runtime_before_show = verify_isolated_qbittorrent(launch, expected_home=app_home)
        call_daemon("show")
        running = [item for item in call_daemon("processes")["processes"]
                   if item.get("launch_id") == launch.get("launch_id")
                   and item.get("profile") == "qbittorrent-live" and item.get("alive")]
        if len(running) != 1:
            raise MonsterdeskError("isolated qBittorrent launch did not remain birth-pinned after showing its viewer")
        runtime_after_show_before_hardening = verify_isolated_qbittorrent(
            running[0], expected_home=app_home
        )
        hardening = stabilize_qbittorrent_private_config_after_launch(app_home)
        runtime = verify_isolated_qbittorrent(running[0], expected_home=app_home)
        hardened_seed = verify_qbittorrent_live_seed(app_home)
        receipt = {
            "schema": "mnx.qbittorrent.cutover-receipt.v1",
            "committed": True,
            "recorded_at": time.time(),
            "instance": "qbittorrent",
            "version": VERSION,
            "runtime_build_revision": BUILD_REVISION,
            "source_config_sha256": seed.get("source_config_sha256"),
            "accepted_stage116_source_sha256": EXPECTED_QBITTORRENT_STAGE116_SOURCE_SHA256,
            "accepted_stage117_source_sha256": EXPECTED_QBITTORRENT_STAGE117_SOURCE_SHA256,
            "private_config_sha256": seed.get("private_config_sha256"),
            "private_config_current_sha256": hardened_seed.get("private_config_current_sha256"),
            "peer_port": EXPECTED_QBITTORRENT_LISTEN_PORT,
            "webui_port": EXPECTED_QBITTORRENT_WEBUI_PORT,
            "host_interface": EXPECTED_QBITTORRENT_HOST_INTERFACE,
            "webui_host_binding": f"127.0.0.1/{EXPECTED_QBITTORRENT_WEBUI_PORT}",
            "router_mapping_policy": "external-manual-no-source-owned-mutation",
            "original_state_retained": True,
            "normal_launcher_replaced": True,
            "legacy_launcher_retained": True,
            "legacy_fallback_kind": "exact-nix-store-binary",
            "public_webui_ingress": False,
            "peer_transport_access": "one-exact-interface-bound-tcp-and-udp-port",
            "payload_access": "two-exact-read-write-roots",
            "credential_values_exported": False,
            "torrent_resume_data_read": False,
            "payload_contents_read": False,
            "post_launch_private_config_hardening": hardening,
            "runtime_reverified_after_show": True,
            "receipt_is_last_commit_point": True,
        }
        result = {
            "schema": "mnx.qbittorrent.cutover.v1",
            "status": "committed",
            "standing_authority": True,
            "legacy_prestate": prestate,
            "legacy_stop": {
                "confirmed": stop_info.get("stopped") is True,
                "method": stop_info.get("method"),
                "host_port_release": stop_info.get("host_port_release"),
            },
            "private_state": {
                "source_config_sha256": seed.get("source_config_sha256"),
                "private_config_sha256": seed.get("private_config_sha256"),
                "private_config_mode": seed.get("private_config_mode"),
                "copy_mode": "archive-reflink-auto",
                "original_state_retained": True,
                "credential_values_exported": False,
                "torrent_resume_data_read": False,
                "payload_contents_read": False,
            },
            "runtime_before_show": runtime_before_show,
            "runtime_after_show_before_hardening": runtime_after_show_before_hardening,
            "post_launch_private_config_hardening": hardening,
            "runtime": runtime,
            "persistent_launch_identity_preserved_during_post_launch_hardening": True,
            "runtime_reverified_after_show": True,
            "receipt_is_last_commit_point": True,
            "normal_launcher_replaced": True,
            "legacy_launcher_retained": True,
            "legacy_fallback_kind": "exact-nix-store-binary",
            "router_state_mutated": False,
            "firewall_changed": False,
            "rollback_performed": False,
        }
        result = bound_qbittorrent_cutover_report(result)
        atomic_json(qbittorrent_cutover_receipt_path(), receipt)
        os.chmod(qbittorrent_cutover_receipt_path(), 0o600)
    except Exception as exc:
        original_error = exc
        os.environ["MONSTERDESK_INSTANCE"] = "qbittorrent"
        with contextlib.suppress(Exception):
            stop_session()
        with contextlib.suppress(FileNotFoundError):
            qbittorrent_cutover_receipt_path().unlink()
        restore_error: Exception | None = None
        os.environ["MONSTERDESK_INSTANCE"] = previous_instance or "main"
        try:
            cleanup_stale_qbittorrent_cutover_processes()
            ensure_legacy_qbittorrent_running()
        except Exception as restore_exc:
            restore_error = restore_exc
        if restore_error is not None:
            raise MonsterdeskError(
                f"qBittorrent cutover failed and legacy rollback also failed: cutover={exc}; rollback={restore_error}"
            ) from exc
    finally:
        if previous_instance is None:
            os.environ.pop("MONSTERDESK_INSTANCE", None)
        else:
            os.environ["MONSTERDESK_INSTANCE"] = previous_instance
        release_qbittorrent_cutover_lock(lock_fd)
    if original_error is not None:
        raise MonsterdeskError(f"qBittorrent cutover failed; legacy application restored: {original_error}") from original_error
    return result


#@MNX-PART id=90.00.monsterdesk.function.f023kkq7-qbittorrent-launcher kind=function title="Python function qbittorrent_launcher"
def qbittorrent_launcher(arguments: list[str]) -> dict[str, Any]:
    previous_instance = os.environ.get("MONSTERDESK_INSTANCE")
    lock_fd = -1
    try:
        try:
            lock_fd = acquire_qbittorrent_cutover_lock()
        except BlockingIOError as exc:
            raise MonsterdeskError("qBittorrent cutover is in progress; retry after the transaction completes") from exc
        receipt = load_qbittorrent_cutover_receipt()
        if receipt is None:
            if not QBITTORRENT.is_file() or not os.access(QBITTORRENT, os.X_OK):
                raise MonsterdeskError("qBittorrent cutover is not committed and the legacy launcher is unavailable")
            os.execv(str(QBITTORRENT), [str(QBITTORRENT), *arguments])
        if arguments:
            raise MonsterdeskError("the isolated qBittorrent launcher accepts no positional torrent files, magnets, or URLs")
        os.environ["MONSTERDESK_INSTANCE"] = "qbittorrent"
        start_session(show=True)
        running = [item for item in call_daemon("processes")["processes"]
                   if item.get("profile") == "qbittorrent-live" and item.get("alive")]
        if not running:
            running = [call_daemon("launch", {"profile": "qbittorrent-live"})["launch"]]
        return {
            "status": "isolated-running",
            "instance": "qbittorrent",
            "launch_id": running[0]["launch_id"],
            "viewer_shown": True,
            "legacy_fallback_used": False,
            "public_webui_ingress": False,
            "router_state_mutated": False,
        }
    finally:
        if previous_instance is None:
            os.environ.pop("MONSTERDESK_INSTANCE", None)
        else:
            os.environ["MONSTERDESK_INSTANCE"] = previous_instance
        if lock_fd >= 0:
            release_qbittorrent_cutover_lock(lock_fd)

#@MNX-PART id=90.00.monsterdesk.function.f023l-seed-nicotine-preflight-home kind=function title="Python function seed_nicotine_preflight_home"
def seed_nicotine_preflight_home(home: Path, *, source_home: Path = USER_HOME,
                                 expected_uid: int = USER_UID,
                                 include_runtime: bool = True) -> dict[str, Any]:
    marker = home / ".monsterdesk-nicotine-preflight.json"
    if marker.exists():
        try:
            value = json.loads(marker.read_text(encoding="utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError) as exc:
            raise MonsterdeskError(f"Nicotine preflight seed marker is unreadable: {exc}") from exc
        if value.get("schema") != "mnx.monsterdesk.nicotine-preflight-seed.v1":
            raise MonsterdeskError("Nicotine preflight seed marker identity differs")
        return {**value, "reused": True}
    processes = nicotine_process_inventory(expected_uid=expected_uid, include_runtime=include_runtime)
    layout = nicotine_layout(source_home, processes)
    raw, metadata = stable_regular_read(
        layout["config_path"], MAX_NICOTINE_CONFIG_BYTES, expected_uid=expected_uid
    )
    configured = parse_nicotine_config(raw, data_path=layout["data_path"])
    private_data = USER_HOME / ".local/share/nicotine"
    parser = configparser.ConfigParser(
        strict=False, interpolation=None, delimiters=("=",), comment_prefixes=None
    )
    for section in ("server", "transfers", "plugins", "ui"):
        parser.add_section(section)
    server = configured.get("server", {})
    parser.set("server", "server", repr((server.get("host", "server.slsknet.org"), int(server.get("port", 2242)))))
    parser.set("server", "login", "")
    parser.set("server", "passw", "")
    parser.set("server", "interface", "")
    parser.set("server", "portrange", repr(tuple(configured["listen_port_range"])))
    parser.set("server", "upnp", "False")
    parser.set("server", "auto_connect_startup", "False")
    for name in ("shared", "buddyshared", "trustedshared"):
        parser.set("transfers", name, "[]")
    parser.set("transfers", "incompletedir", str(private_data / "incomplete"))
    parser.set("transfers", "downloaddir", str(private_data / "downloads"))
    parser.set("transfers", "uploaddir", str(private_data / "received"))
    parser.set("transfers", "rescanonstartup", "False")
    parser.set("plugins", "enable", "False")
    parser.set("plugins", "enabled", "[]")
    parser.set("ui", "trayicon", "False")
    config_dir = secure_dir(home / ".config/nicotine")
    data_dir = secure_dir(home / ".local/share/nicotine")
    for name in ("incomplete", "downloads", "received"):
        secure_dir(data_dir / name)
    buffer = io.StringIO()
    parser.write(buffer)
    config_path = config_dir / "config"
    atomic_text(config_path, buffer.getvalue(), 0o600)
    value = {
        "schema": "mnx.monsterdesk.nicotine-preflight-seed.v1",
        "profile": "nicotine-preflight", "files": 1, "bytes": config_path.stat().st_size,
        "source_config": str(layout["config_path"]),
        "source_sha256": metadata["sha256"], "source_bytes": metadata["bytes"],
        "credentials_copied": False, "share_paths_copied": False,
        "plugin_state_copied": False, "network_autoconnect_enabled": False,
        "host_share_binds": 0, "reused": False,
    }
    atomic_json(marker, value)
    return value


#@MNX-PART id=90.00.monsterdesk.function.f023m0-interface-ipv4-address kind=function title="Python function interface_ipv4_address"
def interface_ipv4_address(name: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9_.:-]{1,15}", name):
        raise MonsterdeskError("network interface name is invalid")
    request = struct.pack("256s", name.encode("ascii"))
    probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        result = fcntl.ioctl(probe.fileno(), 0x8915, request)  # Linux SIOCGIFADDR.
    except OSError as exc:
        raise MonsterdeskError(f"cannot read IPv4 address for interface {name}: {exc}") from exc
    finally:
        probe.close()
    return socket.inet_ntoa(result[20:24])


#@MNX-PART id=90.00.monsterdesk.function.f023m1-default-ipv4-gateway kind=function title="Python function default_ipv4_gateway"
def default_ipv4_gateway(interface_name: str) -> str:
    candidates: list[str] = []
    try:
        with open("/proc/net/route", encoding="utf-8") as handle:
            next(handle, None)
            for line in handle:
                fields = line.split()
                if len(fields) < 4 or fields[0] != interface_name or fields[1] != "00000000":
                    continue
                try:
                    flags = int(fields[3], 16)
                    gateway_value = int(fields[2], 16)
                except ValueError:
                    continue
                if not flags & 0x2:
                    continue
                candidates.append(socket.inet_ntoa(struct.pack("<I", gateway_value)))
    except OSError as exc:
        raise MonsterdeskError(f"cannot read default IPv4 gateway: {exc}") from exc
    values = sorted(set(candidates))
    if len(values) != 1:
        raise MonsterdeskError(
            f"default IPv4 gateway for {interface_name} is absent-or-ambiguous count={len(values)}"
        )
    return values[0]


#@MNX-PART id=90.00.monsterdesk.function.f023m2-parse-natpmp-external-address-response kind=function title="Python function parse_natpmp_external_address_response"
def parse_natpmp_external_address_response(raw: bytes) -> dict[str, Any]:
    if len(raw) != 12:
        raise MonsterdeskError(f"NAT-PMP external-address response length differs: {len(raw)}")
    version, opcode, result_code, seconds_since_epoch = struct.unpack("!BBHI", raw[:8])
    if version != 0 or opcode != 128:
        raise MonsterdeskError(f"NAT-PMP external-address response header differs: version={version} opcode={opcode}")
    external_address = socket.inet_ntoa(raw[8:12]) if result_code == 0 else None
    return {
        "version": version,
        "opcode": opcode,
        "result_code": result_code,
        "seconds_since_epoch": seconds_since_epoch,
        "external_address": external_address,
        "success": result_code == 0,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023m3-inspect-natpmp-capability kind=function title="Python function inspect_natpmp_capability"
def inspect_natpmp_capability(interface_name: str) -> dict[str, Any]:
    base: dict[str, Any] = {
        "schema": "mnx.nicotine.natpmp-capability.v1",
        "request_opcode": 0,
        "request_mutates_mapping": False,
        "mapping_request_sent": False,
        "mapping_renewal_sent": False,
        "mapping_delete_sent": False,
        "router_state_mutated": False,
        "external_address_exported": False,
        "gateway_address_exported": False,
        "raw_response_exported": False,
        "raw_response_sha256_exported": False,
        "network_scope": "local-default-gateway-read-only-external-address-query",
    }
    try:
        local_address = interface_ipv4_address(interface_name)
        gateway_address = default_ipv4_gateway(interface_name)
    except MonsterdeskError as exc:
        return {**base, "state": "route-unavailable", "request_attempts": 0,
                "response_bytes": 0, "error": str(exc)[:512]}
    request = bytes((0, 0))
    attempts = 0
    probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        probe.bind((local_address, 0))
        for timeout in (0.25, 0.5, 1.0, 2.0):
            attempts += 1
            probe.settimeout(timeout)
            try:
                probe.sendto(request, (gateway_address, NATPMP_GATEWAY_PORT))
                raw, source = probe.recvfrom(MAX_NATPMP_RESPONSE_BYTES)
            except socket.timeout:
                continue
            except OSError as exc:
                return {**base, "state": "unavailable", "request_attempts": attempts,
                        "response_bytes": 0,
                        "error": f"{exc.__class__.__name__}: {exc}"[:512]}
            if source[0] != gateway_address or int(source[1]) != NATPMP_GATEWAY_PORT:
                continue
            try:
                parsed = parse_natpmp_external_address_response(raw)
            except MonsterdeskError as exc:
                return {**base, "state": "invalid-response", "request_attempts": attempts,
                        "response_bytes": len(raw), "error": str(exc)[:512]}
            return {
                **base,
                "state": "supported" if parsed["success"] else "result-error",
                "request_attempts": attempts,
                "response_bytes": len(raw),
                "result_code": parsed["result_code"],
                "seconds_since_epoch": parsed["seconds_since_epoch"],
                "protocol_supported": parsed["success"],
            }
    finally:
        probe.close()
    return {**base, "state": "unavailable", "request_attempts": attempts,
            "response_bytes": 0, "protocol_supported": False}


#@MNX-PART id=90.00.monsterdesk.function.f023m4-build-natpmp-tcp-mapping-request kind=function title="Python function build_natpmp_tcp_mapping_request"
def build_natpmp_tcp_mapping_request(internal_port: int, suggested_external_port: int, lifetime: int) -> bytes:
    for label, value, maximum in (
        ("internal_port", internal_port, 65_535),
        ("suggested_external_port", suggested_external_port, 65_535),
        ("lifetime", lifetime, 0xFFFFFFFF),
    ):
        if not isinstance(value, int) or not 0 <= value <= maximum:
            raise MonsterdeskError(f"NAT-PMP {label} is outside its unsigned range")
    return struct.pack("!BBHHHI", 0, 2, 0, internal_port, suggested_external_port, lifetime)


#@MNX-PART id=90.00.monsterdesk.function.f023m5-parse-natpmp-tcp-mapping-response kind=function title="Python function parse_natpmp_tcp_mapping_response"
def parse_natpmp_tcp_mapping_response(raw: bytes) -> dict[str, Any]:
    if len(raw) != 16:
        raise MonsterdeskError(f"NAT-PMP TCP mapping response length differs: {len(raw)}")
    version, opcode, result_code, seconds_since_epoch, internal_port, external_port, lifetime = struct.unpack(
        "!BBHIHHI", raw
    )
    if version != 0 or opcode != 130:
        raise MonsterdeskError(f"NAT-PMP TCP mapping response header differs: version={version} opcode={opcode}")
    return {
        "version": version,
        "opcode": opcode,
        "result_code": result_code,
        "seconds_since_epoch": seconds_since_epoch,
        "internal_port": internal_port,
        "external_port": external_port,
        "lifetime": lifetime,
        "success": result_code == 0,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023m6-current-nicotine-ingress-witness kind=function title="Python function current_nicotine_ingress_witness"
def current_nicotine_ingress_witness(report: dict[str, Any]) -> dict[str, Any]:
    endpoints = report.get("live", {}).get("local_endpoints", [])
    matches = [
        item for item in endpoints
        if item.get("protocol") in {"tcp", "tcp6"}
        and item.get("kind") == "connected-local"
        and item.get("state") == "01"
        and int(item.get("port", 0)) == EXPECTED_NICOTINE_PORT
        and str(item.get("address")) == EXPECTED_NICOTINE_LISTENER_ADDRESS
    ]
    return {
        "schema": "mnx.nicotine.current-ingress-witness.v1",
        "listener_address": EXPECTED_NICOTINE_LISTENER_ADDRESS,
        "listener_port": EXPECTED_NICOTINE_PORT,
        "established_listener_port_socket_count": len(matches),
        "current_listener_port_connection_observed": bool(matches),
        "remote_endpoints_exported": False,
        "remote_peer_identity_read": False,
        "public_origin_proved": False,
        "router_mapping_proved": False,
        "mapping_persistence_proved": False,
        "scope": "kernel-local-socket-tuples-only",
    }


#@MNX-PART id=90.00.monsterdesk.function.f023m-nicotine-cutover-inputs kind=function title="Python function nicotine_cutover_inputs"
def nicotine_cutover_inputs(report: dict[str, Any], *, require_accepted_hash: bool = True) -> dict[str, Any]:
    config = report.get("config", {})
    configured = report.get("configured", {})
    layout = report.get("layout", {})
    live = report.get("live", {})
    observed_hash = str(config.get("sha256", ""))
    if not re.fullmatch(r"[0-9a-f]{64}", observed_hash):
        raise MonsterdeskError("Nicotine configuration has no stable SHA-256 identity")
    if require_accepted_hash and observed_hash != EXPECTED_NICOTINE_CONFIG_SHA256:
        raise MonsterdeskError(
            "Nicotine config identity changed before the Stage110 rehearsal: "
            f"observed={observed_hash} expected={EXPECTED_NICOTINE_CONFIG_SHA256}"
        )
    if Path(str(layout.get("config_path", ""))) != EXPECTED_NICOTINE_CONFIG_PATH:
        raise MonsterdeskError("Nicotine configuration path changed after Stage107 evidence")
    if Path(str(layout.get("data_path", ""))) != EXPECTED_NICOTINE_DATA_PATH:
        raise MonsterdeskError("Nicotine data path changed after Stage107 evidence")
    if configured.get("listen_port_range") != [EXPECTED_NICOTINE_PORT, EXPECTED_NICOTINE_PORT]:
        raise MonsterdeskError("Nicotine listening port changed after Stage107 evidence")
    if configured.get("upnp") is not True or configured.get("auto_connect_startup") is not True:
        raise MonsterdeskError("Nicotine source UPnP or startup-connect policy changed before cutover")
    server = configured.get("server", {})
    if (server.get("host"), server.get("port")) != EXPECTED_NICOTINE_SERVER:
        raise MonsterdeskError("Nicotine server endpoint changed after Stage107 evidence")
    shares = sorted(
        (str(item.get("virtual_name", "")), str(item.get("path", "")))
        for item in configured.get("paths", []) if str(item.get("kind", "")).endswith("share")
    )
    if shares != sorted(EXPECTED_NICOTINE_SHARES):
        raise MonsterdeskError(f"Nicotine share set changed after Stage107 evidence: {shares}")
    by_kind = {str(item.get("kind")): str(item.get("path")) for item in configured.get("paths", [])
               if not str(item.get("kind", "")).endswith("share")}
    expected_transfers = {
        "download-dir": str(EXPECTED_NICOTINE_DOWNLOAD),
        "incomplete-dir": str(EXPECTED_NICOTINE_INCOMPLETE),
        "received-dir": str(EXPECTED_NICOTINE_RECEIVED),
    }
    if by_kind != expected_transfers:
        raise MonsterdeskError(f"Nicotine transfer paths changed after Stage107 evidence: {by_kind}")
    processes = live.get("processes", [])
    if len(processes) != 1 or processes[0].get("host_network_namespace") is not True:
        raise MonsterdeskError("expected one live host-network Nicotine process for cutover qualification")
    if live.get("configured_port_bound") is not True:
        raise MonsterdeskError("live Nicotine no longer binds its configured transfer port")
    listener_addresses = sorted({
        str(item.get("address")) for item in live.get("local_endpoints", [])
        if item.get("protocol") in {"tcp", "tcp6"}
        and item.get("kind") == "listen" and int(item.get("port", 0)) == EXPECTED_NICOTINE_PORT
        and str(item.get("address")) not in {"0.0.0.0", "::", "127.0.0.1", "::1"}
    })
    if len(listener_addresses) != 1:
        raise MonsterdeskError(f"Nicotine public listener address is ambiguous: {listener_addresses}")
    try:
        socket.inet_aton(listener_addresses[0])
    except OSError as exc:
        raise MonsterdeskError("Nicotine public listener is not one IPv4 address") from exc
    if listener_addresses[0] != EXPECTED_NICOTINE_LISTENER_ADDRESS:
        raise MonsterdeskError(
            "Nicotine listener address changed after Stage107 evidence: "
            f"observed={listener_addresses[0]} expected={EXPECTED_NICOTINE_LISTENER_ADDRESS}"
        )
    interface_address = interface_ipv4_address(NICOTINE_HOST_INTERFACE)
    if interface_address != listener_addresses[0]:
        raise MonsterdeskError(
            f"Nicotine listener {listener_addresses[0]} is not the primary address of {NICOTINE_HOST_INTERFACE} "
            f"({interface_address})"
        )
    wrapper_candidates = report.get("wrapper", {}).get("candidates", [])
    legacy = next((item for item in wrapper_candidates
                   if item.get("path") == str(NICOTINE_LEGACY)), None)
    normal = next((item for item in wrapper_candidates
                   if item.get("path") == "/run/current-system/sw/bin/nicotine"), None)
    if legacy is None or legacy.get("source_owned_direct_legacy_binary") is not True:
        raise MonsterdeskError("Stage110 legacy rollback fallback is not the exact Nix-selected Nicotine binary")
    if normal is None or normal.get("source_owned_nicotine_launcher") is not True:
        raise MonsterdeskError("Stage110 normal Nicotine launcher is not the exact source-owned Monsterdesk bridge")
    return {
        "config_sha256": observed_hash,
        "config_mode": int(config.get("mode", 0)),
        "listener_address": listener_addresses[0],
        "listener_port": EXPECTED_NICOTINE_PORT,
        "host_interface": NICOTINE_HOST_INTERFACE,
        "host_interface_address": interface_address,
        "share_count": len(shares),
        "shares": [{"virtual_name": name, "path": path, "planned_access": "read-only"}
                   for name, path in shares],
        "download_path": str(EXPECTED_NICOTINE_DOWNLOAD),
        "incomplete_path": str(EXPECTED_NICOTINE_INCOMPLETE),
        "received_path": str(EXPECTED_NICOTINE_RECEIVED),
        "upnp_enabled_now": configured.get("upnp") is True,
        "autoconnect_enabled_now": configured.get("auto_connect_startup") is True,
        "live_pid": int(processes[0].get("pid", 0)),
        "live_start_ticks": int(processes[0].get("start_ticks", 0)),
    }


#@MNX-PART id=90.00.monsterdesk.function.f023n-parse-upnpc-listing kind=function title="Python function parse_upnpc_listing"
def parse_upnpc_listing(raw: bytes, *, external_port: int, internal_address: str) -> dict[str, Any]:
    text = raw.decode("utf-8", errors="replace")
    entry_count = 0
    target_entries: list[dict[str, Any]] = []
    pattern = re.compile(
        r"^\s*[0-9]+\s+(TCP|UDP)\s+([0-9]+)->([0-9]{1,3}(?:\.[0-9]{1,3}){3}):([0-9]+)(?:\s|$)",
        re.IGNORECASE,
    )
    for line in text.splitlines():
        match = pattern.search(line)
        if match is None:
            continue
        entry_count += 1
        protocol = match.group(1).upper()
        external = int(match.group(2))
        address = match.group(3)
        internal = int(match.group(4))
        try:
            socket.inet_aton(address)
        except OSError:
            continue
        if external == external_port or internal == external_port:
            target_entries.append({
                "protocol": protocol, "external_port": external,
                "internal_address": address, "internal_port": internal,
            })
    exact = [item for item in target_entries if item == {
        "protocol": "TCP", "external_port": external_port,
        "internal_address": internal_address, "internal_port": external_port,
    }]
    return {
        "parsed_entry_count": entry_count,
        "target_entry_count": len(target_entries),
        "exact_mapping_present": len(exact) == 1,
        "exact_mapping_count": len(exact),
        "conflicting_target_mapping_count": len(target_entries) - len(exact),
        "target_entries": target_entries[:8],
    }


#@MNX-PART id=90.00.monsterdesk.function.f023o-inspect-router-mapping kind=function title="Python function inspect_router_mapping"
def inspect_router_mapping(*, external_port: int, internal_address: str) -> dict[str, Any]:
    try:
        result = subprocess.run(
            [str(UPNPC), "-l"], stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            timeout=12, check=False,
            env={"HOME": str(USER_HOME), "PATH": str(UPNPC.parent), "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"},
        )
        complete_raw = result.stdout
        raw = complete_raw[:MAX_ROUTER_LISTING_BYTES]
        parsed = parse_upnpc_listing(raw, external_port=external_port, internal_address=internal_address)
        return {
            "state": "observed" if result.returncode == 0 else "unavailable-or-no-igd",
            "command_rc": int(result.returncode),
            "listing_bytes": len(raw),
            "listing_truncated": len(complete_raw) > len(raw),
            "listing_sha256": hashlib.sha256(raw).hexdigest(),
            "raw_listing_exported": False,
            "external_address_exported": False,
            "router_state_mutated": False,
            "network_scope": "local-upnp-discovery-and-read-only-listing",
            **parsed,
        }
    except subprocess.TimeoutExpired:
        return {
            "state": "timeout", "command_rc": None, "listing_bytes": 0,
            "listing_truncated": False, "listing_sha256": None,
            "raw_listing_exported": False, "external_address_exported": False,
            "router_state_mutated": False,
            "network_scope": "local-upnp-discovery-and-read-only-listing",
            "parsed_entry_count": 0, "target_entry_count": 0,
            "exact_mapping_present": False, "exact_mapping_count": 0,
            "conflicting_target_mapping_count": 0, "target_entries": [],
        }


#@MNX-PART id=90.00.monsterdesk.function.f023p-reserve-loopback-port kind=function title="Python function reserve_loopback_port"
def reserve_loopback_port() -> int:
    candidate = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        candidate.bind(("127.0.0.1", 0))
        return int(candidate.getsockname()[1])
    finally:
        candidate.close()


