#@MNX-CHUNK id=95.00 slug=rescue-personalities title="GUI and terminal rescue personalities"
####################################################################################SECTION 95##Rescue####
##                                                                                           ##
##  NixOS specialisations: bootable/runtime alternate personalities for when the monster      ##
##  needs to stop dancing and simply let you regain control. The ordinary unspecialised       ##
##  system is normal mode. These modes inherit the monolith and only force small deltas.       ##
##                                                                                           ##
#############################################################################################

#@MNX-DEF path=specialisation.gui-rescue.configuration section=95.00 role=rescue ordinal=258
  specialisation.gui-rescue.configuration = {
    system.nixos.tags = [ "gui-rescue" ];

    environment.etc."monsternix/mode".text = lib.mkForce "gui-rescue\n";
    environment.variables.MONSTERNIX_MODE = lib.mkForce "gui-rescue";
    environment.sessionVariables.MONSTERNIX_MODE = lib.mkForce "gui-rescue";

    # GUI rescue gives you a graphical login without autologin or the normal i3 startup path.
    # Firewall/network policy is intentionally inherited unchanged.
    services.displayManager.autoLogin.enable = lib.mkForce false;
    services.displayManager.defaultSession = lib.mkForce "xterm";
    services.xserver.enable = lib.mkForce true;
    services.xserver.autorun = lib.mkForce true;
    services.xserver.displayManager.lightdm.enable = lib.mkForce true;
    services.xserver.desktopManager.xterm.enable = lib.mkForce true;
    services.picom.enable = lib.mkForce false;

    system.autoUpgrade.enable = lib.mkForce false;
    nix.gc.automatic = lib.mkForce false;
    services.btrfs.autoScrub.enable = lib.mkForce false;

    systemd.timers.btrbk-main.wantedBy = lib.mkForce [ ];
    systemd.timers.btrbk-archive-to-new-storage.wantedBy = lib.mkForce [ ];
    systemd.timers.m21-btrfs-pull-backup.wantedBy = lib.mkForce [ ];
    systemd.timers.mnx-storage-catchup.wantedBy = lib.mkForce [ ];
    systemd.timers.mnx-logbook-prune.wantedBy = lib.mkForce [ ];
    systemd.timers.rsync-m16-new-to-old.wantedBy = lib.mkForce [ ];
    systemd.timers.duperemove-home.wantedBy = lib.mkForce [ ];
    systemd.timers.duperemove-m16-new-storage.wantedBy = lib.mkForce [ ];
    systemd.timers.duperemove-m16-old-storage.wantedBy = lib.mkForce [ ];
    systemd.timers.archiver-local-offline-site.wantedBy = lib.mkForce [ ];
    systemd.timers.nix-result-root-cleanup.wantedBy = lib.mkForce [ ];
    systemd.timers.wol-tcsn.wantedBy = lib.mkForce [ ];
    systemd.timers.hypertext-i2p-sync.wantedBy = lib.mkForce [ ];
    systemd.timers.monsternix-config-copy.wantedBy = lib.mkForce [ ];
    systemd.timers.savetrail-jsons.wantedBy = lib.mkForce [ ];

    systemd.paths.monsternix-config-copy.wantedBy = lib.mkForce [ ];
  };

#@MNX-DEF path=specialisation.terminal-rescue.configuration section=95.00 role=rescue ordinal=259
  specialisation.terminal-rescue.configuration = {
    system.nixos.tags = [ "terminal-rescue" ];

    environment.etc."monsternix/mode".text = lib.mkForce "terminal-rescue\n";
    environment.variables.MONSTERNIX_MODE = lib.mkForce "terminal-rescue";
    environment.sessionVariables.MONSTERNIX_MODE = lib.mkForce "terminal-rescue";

    # Plain multi-user terminal rescue: no display manager, no X session, no DE.
    # It keeps NetworkManager, SSH, Eternal Terminal, zram, logbook, and health/census logs.
    # Firewall policy is intentionally inherited unchanged.
    systemd.defaultUnit = lib.mkForce "multi-user.target";
    services.displayManager.autoLogin.enable = lib.mkForce false;
    services.xserver.enable = lib.mkForce false;
    services.xserver.autorun = lib.mkForce false;
    services.xserver.displayManager.lightdm.enable = lib.mkForce false;
    services.xserver.desktopManager.xterm.enable = lib.mkForce false;
    services.xserver.desktopManager.kodi.enable = lib.mkForce false;
    services.xserver.windowManager.i3.enable = lib.mkForce false;
    services.picom.enable = lib.mkForce false;
    xdg.portal.enable = lib.mkForce false;

    # Do not automatically page through any disk in terminal rescue.
    # zramSwap remains enabled because it is configured separately from swapDevices.
    swapDevices = lib.mkForce [ ];

    system.autoUpgrade.enable = lib.mkForce false;
    nix.gc.automatic = lib.mkForce false;
    services.btrfs.autoScrub.enable = lib.mkForce false;

    # Stop public-ish/background network services in terminal rescue while leaving
    # basic networking, SSH, and Eternal Terminal available.
    services.i2p.enable = lib.mkForce false;
    services.i2pd.enable = lib.mkForce false;
    services.tor.enable = lib.mkForce false;
    services.tor.client.enable = lib.mkForce false;
    services.tor.torsocks.enable = lib.mkForce false;
    services.tor.tsocks.enable = lib.mkForce false;
    services.tor.relay.onionServices = lib.mkForce { };
    services.bitmagnet.enable = lib.mkForce false;
    services.nfs.server.enable = lib.mkForce false;
    services.rpcbind.enable = lib.mkForce false;
    services.avahi.enable = lib.mkForce false;
    virtualisation.libvirtd.enable = lib.mkForce false;
    services.flatpak.enable = lib.mkForce false;

    systemd.timers.btrbk-main.wantedBy = lib.mkForce [ ];
    systemd.timers.btrbk-archive-to-new-storage.wantedBy = lib.mkForce [ ];
    systemd.timers.m21-btrfs-pull-backup.wantedBy = lib.mkForce [ ];
    systemd.timers.mnx-storage-catchup.wantedBy = lib.mkForce [ ];
    systemd.timers.mnx-logbook-prune.wantedBy = lib.mkForce [ ];
    systemd.timers.rsync-m16-new-to-old.wantedBy = lib.mkForce [ ];
    systemd.timers.duperemove-home.wantedBy = lib.mkForce [ ];
    systemd.timers.duperemove-m16-new-storage.wantedBy = lib.mkForce [ ];
    systemd.timers.duperemove-m16-old-storage.wantedBy = lib.mkForce [ ];
    systemd.timers.archiver-local-offline-site.wantedBy = lib.mkForce [ ];
    systemd.timers.nix-result-root-cleanup.wantedBy = lib.mkForce [ ];
    systemd.timers.wol-tcsn.wantedBy = lib.mkForce [ ];
    systemd.timers.hypertext-i2p-sync.wantedBy = lib.mkForce [ ];
    systemd.timers.monsternix-config-copy.wantedBy = lib.mkForce [ ];
    systemd.timers.savetrail-jsons.wantedBy = lib.mkForce [ ];

    systemd.paths.monsternix-config-copy.wantedBy = lib.mkForce [ ];
  };


#@MNX-CHUNK id=98.00 slug=candidate-experiment-bay title="Candidate-only experimental code, probes, and promotion gate"
#######################################################################################################
# SECTION 98 — CANDIDATE-ONLY EXPERIMENT BAY
#######################################################################################################
#
# This is the only approved landing zone for genuinely temporary active Nix code. It is intentionally
# empty in every permanent generation. It is not a miscellaneous commented-code attic.
#
# Future ChatGPT may place a short-lived experiment here using paired markers with this conceptual form:
#
#   # @MNX-TEMP-BEGIN id=descriptive-id purpose="What this proves" expires=YYYY-MM-DD cleanup="remove-or-promote" owner=chatgpt
#   ...active candidate-only Nix definitions...
#   # @MNX-TEMP-END id=descriptive-id
#
# Remove the space between `#` and `@` only when intentionally activating a temporary region. Rules:
#
# * `mnx test` validates, reports, and may temporarily activate the region.
# * A passing test with temporary code is NOT switch-authorized.
# * `mnx switch` refuses the evidence even when every other audit passes.
# * To keep the work, move it into its permanent numbered section, remove the temporary markers, and retest.
# * To discard the work, remove the whole region and retest.
# * IDs are unique, nesting is forbidden, and purpose/expires/cleanup metadata are mandatory.
#
