              "duplicate_listener_row_total": "duplicate_listener_row_total",
              "listener_total": "stable_listener_total",
              "declared_listener_total": "declared_listener_total",
              "known_listener_total": "known_listener_total",
              "review_listener_total": "review_listener_total",
              "undeclared_listener_total": "undeclared_listener_total",
              "ambiguous_listener_total": "ambiguous_listener_total",
              "forbidden_listener_total": "forbidden_listener_total",
              "unattributed_listener_total": "unattributed_listener_total",
              "rpc_attributed_listener_total": "rpc_attributed_listener_total",
              "rpc_program_endpoint_total": "rpc_program_endpoint_total",
              "public_listener_total": "public_listener_total",
              "review_group_total": "review_group_total",
              "zone_firewall_required_total": "zone_firewall_required_total",
              "zone_mismatch_total": "zone_mismatch_total",
              "new_listener_total": "new_listener_total",
              "recurring_listener_total": "recurring_listener_total",
              "persistent_listener_total": "persistent_listener_total",
          }
          for metric_suffix, summary_key in metric_keys.items():
              metric = f"monsternix_exposure_{metric_suffix}"
              lines.extend([
                  f"# HELP {metric} Monsternix canonical exposure observation value: {summary_key}.",
                  f"# TYPE {metric} gauge",
