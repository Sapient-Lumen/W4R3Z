        RESTIC_BACKUP_CONTROLLER="$RESTIC_BACKUP_RAW_CONTROLLER"
        RESTIC_BACKUP_REASON="$RESTIC_BACKUP_RAW_REASON"
        RESTIC_BACKUP_COMPATIBILITY_CLASSIFICATION=none
        if restic_backup_legacy_preflight_skip_bridge "$RESTIC_BACKUP_CURRENT"; then
          RESTIC_BACKUP_CONTROLLER=pass
          RESTIC_BACKUP_PRODUCT=skipped
          RESTIC_BACKUP_REASON=storage-preflight-refused
          RESTIC_BACKUP_COMPATIBILITY_CLASSIFICATION=legacy-storage-preflight-rc75-as-skipped
          warn 'm21 Restic current state is an exact known legacy rc75 storage-preflight refusal; classifying it as skipped without rewriting state or claiming backup success; the next controller attempt must republish'
        fi
        printf 'restic_backup_raw_controller_status=%s\nrestic_backup_raw_product_status=%s\nrestic_backup_raw_reason=%s\n' "$RESTIC_BACKUP_RAW_CONTROLLER" "$RESTIC_BACKUP_RAW_PRODUCT" "$RESTIC_BACKUP_RAW_REASON"
        printf 'restic_backup_controller_status=%s\nrestic_backup_product_status=%s\nrestic_backup_phase=%s\nrestic_backup_reason=%s\nrestic_backup_compatibility_classification=%s\n' "$RESTIC_BACKUP_CONTROLLER" "$RESTIC_BACKUP_PRODUCT" "$RESTIC_BACKUP_PHASE" "$RESTIC_BACKUP_REASON" "$RESTIC_BACKUP_COMPATIBILITY_CLASSIFICATION"
