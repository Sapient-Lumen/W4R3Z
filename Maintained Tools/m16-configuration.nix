      #@MNX-PART id=40.17.mnx-journal-integrity.function.perform-verify kind=function title="Python function perform_verify"
      def perform_verify(mode: str, service_exit: bool) -> int:
          try:
              gid = grp.getgrnam(GROUP_NAME).gr_gid
              observed_at = dt.datetime.now().astimezone().isoformat(timespec="seconds")
              results = [run_verify("default"), run_verify("logbook")]
              summary = build_summary(mode, results, observed_at)
              bundle = publish_evidence(mode, results, summary, gid)
              publish_state(summary, bundle, gid)
              publish_metrics(summary)
              clean_status = str(summary.get("clean_forward", {}).get("status", "unanchored"))
              notification = "not-requested"
              if service_exit and clean_status in {"unanchored", "new-damage-review-required"}:
                  notification = notify_review(summary, bundle, gid)
              log_summary(summary, bundle)
              print_summary(summary, bundle, notification)
              if summary["overall_status"] == "malfunction" or clean_status == "unknown-observer-malfunction":
                  print("MNX_JOURNAL_VERIFY=FAIL_OBSERVER_MALFUNCTION")
                  return 1
              if clean_status == "new-damage-review-required":
                  print("MNX_JOURNAL_VERIFY=PASS_WITH_NEW_DAMAGE_REVIEW")
                  return 76 if service_exit else 0
              if clean_status == "unanchored":
                  print("MNX_JOURNAL_VERIFY=PASS_UNANCHORED")
                  return 76 if service_exit else 0
              if summary["overall_status"] == "review-required":
                  print("MNX_JOURNAL_VERIFY=PASS_WITH_KNOWN_ARCHIVED_REVIEW")
                  return 0
              print("MNX_JOURNAL_VERIFY=PASS")
              return 0
          except (JournalIntegrityError, OSError, KeyError, ValueError, json.JSONDecodeError) as exc:
              print(f"MNX_JOURNAL_INTEGRITY_ERROR: {exc}", file=sys.stderr)
              print("MNX_JOURNAL_VERIFY=FAIL_OBSERVER_MALFUNCTION")
              return 1
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.load-current kind=function title="Python function load_current"
      def load_current() -> dict[str, Any]:
          path = STATE_ROOT / "current.json"
          try:
              value = json.loads(path.read_text(encoding="utf-8"))
          except (OSError, json.JSONDecodeError) as exc:
              raise JournalIntegrityError(f"journal integrity state is unavailable: {path}: {exc}") from exc
          validate_summary(value)
          anchor = load_anchor()
          boundary = load_boundary()
          rebuilt = build_summary(str(value.get("mode", "state-load")), [{**item, "output": ""} for item in value["namespaces"]], str(value.get("observed_at", "unknown")), anchor, boundary)
          expected_clean = classify_clean_forward(value, anchor, boundary)
          if value.get("schema") != STATE_SCHEMA or value.get("clean_forward", {}).get("schema") != "mnx.journal-integrity.clean-forward.v2":
              value["clean_forward"] = expected_clean
              value["anchor"] = rebuilt["anchor"]
              value["recovery_boundary"] = rebuilt["recovery_boundary"]
          else:
              require(value.get("clean_forward") == expected_clean, "journal clean-forward state differs from accepted anchor/boundary classification")
              for key in ("anchor", "recovery_boundary"):
                  require(value.get(key) == rebuilt[key], f"journal state {key} summary differs from accepted state")
          return value
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.accepted_identity kind=function title="Python function accepted_identity"
      def accepted_identity() -> dict[str, str]:
          source_sha = read_source_sha()
          require(HEX64_RE.fullmatch(source_sha) is not None, "accepted journal anchor source hash is unreadable")
          running = RUNNING_LINK.resolve(strict=True)
          boot_default = DEFAULT_LINK.resolve(strict=True)
          require(running == boot_default, "journal anchor requires one accepted running and boot-default closure")
          for label, path in (("running", running / "configuration.nix"), ("boot-default", boot_default / "configuration.nix")):
              require(path.is_file(), f"{label} embedded configuration is absent")
              resolved = path.resolve(strict=True)
              require(resolved.is_file(), f"{label} embedded configuration target is unsafe")
              require(sha256_file(resolved) == source_sha, f"{label} embedded configuration differs from accepted source")
          return {
              "accepted_stage": read_candidate_stage(),
              "accepted_source_sha256": source_sha,
              "running_system": str(running),
              "boot_default_system": str(boot_default),
          }
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.load_pinned_legacy_review kind=function title="Python function load_pinned_legacy_review"
      def load_pinned_legacy_review() -> dict[str, Any]:
          bundle = EXPECTED_LEGACY_EVIDENCE
          if not bundle.exists() and not bundle.is_symlink():
              raise JournalIntegrityError(f"Stage55-pinned legacy journal evidence bundle is absent: {bundle}")
          metadata = bundle.lstat()
          require(stat.S_ISDIR(metadata.st_mode) and not bundle.is_symlink(), f"Stage55-pinned legacy journal evidence bundle is unsafe: {bundle}")
          require(metadata.st_uid == 0, f"Stage55-pinned legacy journal evidence bundle is not root-owned: {bundle}")
          root_resolved = INCIDENT_ROOT.resolve(strict=True)
          bundle_resolved = bundle.resolve(strict=True)
          require(bundle_resolved.parent == root_resolved, f"Stage55-pinned legacy journal evidence bundle is not contained: {bundle_resolved}")
          completed = subprocess.run(
              [str(BUNDLE_MANIFEST), "verify", str(bundle)],
              stdout=subprocess.PIPE,
              stderr=subprocess.PIPE,
              text=True,
              check=False,
          )
          require(completed.returncode == 0, f"Stage55-pinned legacy journal evidence manifest verification failed: {completed.stderr.strip() or completed.stdout.strip()}")
          summary_path = bundle / "summary.json"
          secure_regular_file(summary_path, {0o640})
          summary_bytes = summary_path.read_bytes()
          try:
              value = json.loads(summary_bytes.decode("utf-8"))
          except (UnicodeDecodeError, json.JSONDecodeError) as exc:
              raise JournalIntegrityError(f"Stage55-pinned legacy journal summary is unreadable: {summary_path}: {exc}") from exc
          validate_summary(value)
          require(value["overall_status"] == "review-required", "Stage55-pinned legacy journal summary is not review-required")
          require(summary_bytes == canonical_json(value), "Stage55-pinned legacy journal summary is not canonical")
          evidence_text = value.get("evidence_bundle")
          require(isinstance(evidence_text, str), "Stage55-pinned legacy journal summary has no evidence path")
          require(pathlib.Path(evidence_text).resolve(strict=True) == bundle_resolved, "Stage55-pinned legacy journal summary points to a different bundle")
          return value
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.command_anchor kind=function title="Python function command_anchor"
      def command_anchor(switch_owned: bool) -> int:
          try:
              require(switch_owned, "journal anchor is reserved for accepted mnx switch continuation")
              require(os.environ.get("MNX_OFFICE_POST_COMMIT_SEAL") == "1", "journal anchor requires the post-commit seal authority")
              gid = grp.getgrnam(GROUP_NAME).gr_gid
              identity = accepted_identity()
              anchor = load_anchor()
              anchor_action = "existing"
              origin_kind = str(anchor.get("origin", {}).get("kind", "unknown")) if anchor is not None else "unknown"
              origin_fallback = "none"
              results: list[dict[str, Any]] | None = None
              if anchor is None:
                  origin_summary = load_pinned_legacy_review()
                  origin_fallback = "none"
                  origin_kind = "pinned-stage55-manifest"
                  proposed = build_anchor(
                      origin_summary,
                      origin_kind,
                      identity,
                      dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                  )
                  if atomic_create_once(ANCHOR_PATH, canonical_json(proposed), 0o640, gid):
                      anchor_action = "created"
                  else:
                      anchor_action = "existing-race"
                  anchor = load_anchor()
                  require(anchor is not None, "journal anchor did not become readable after creation")
              require(anchor.get("created_by") == identity, "existing journal anchor belongs to a different accepted source or closure")
              verify_anchor_origin(anchor)
              if results is None:
                  results = [run_verify("default"), run_verify("logbook")]
              observed_at = dt.datetime.now().astimezone().isoformat(timespec="seconds")
              summary = build_summary("switch-owned-anchor", results, observed_at, anchor)
              bundle = publish_evidence("switch-owned-anchor", results, summary, gid)
              publish_state(summary, bundle, gid)
              publish_metrics(summary)
              notification = "not-requested"
              if summary["overall_status"] == "review-required":
                  notification = notify_review(summary, bundle, gid)
              log_summary(summary, bundle)
              print(f"anchor_action={anchor_action}")
              print(f"anchor_origin_kind={origin_kind}")
              print(f"anchor_origin_fallback={origin_fallback}")
              print_summary(summary, bundle, notification)
              clean_status = str(summary["clean_forward"]["status"])
              if summary["overall_status"] == "malfunction" or clean_status == "unknown-observer-malfunction":
                  print("MNX_JOURNAL_ANCHOR=FAIL_OBSERVER_MALFUNCTION")
                  return 1
              if clean_status == "new-damage-review-required":
                  print("MNX_JOURNAL_ANCHOR=BLOCKED_NEW_DAMAGE")
                  return 76
              if clean_status == "unanchored":
                  print("MNX_JOURNAL_ANCHOR=FAIL_UNANCHORED")
                  return 1
              print("MNX_JOURNAL_ANCHOR=PASS")
              return 0
          except (JournalIntegrityError, OSError, KeyError, ValueError, json.JSONDecodeError) as exc:
              print(f"MNX_JOURNAL_INTEGRITY_ERROR: {exc}", file=sys.stderr)
              print("MNX_JOURNAL_ANCHOR=FAIL")
              return 1
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.write-recovery-artifact kind=function title="Python function write_recovery_artifact"
      def write_recovery_artifact(bundle: pathlib.Path, name: str, data: bytes) -> pathlib.Path:
          path = bundle / name
          if path.exists() or path.is_symlink():
              secure_regular_file(path, {0o600})
          write_file(path, data, 0o600, 0)
          return path
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.command-recover-forward kind=function title="Python function command_recover_forward"
      def command_recover_forward(switch_owned: bool) -> int:
          try:
              require(switch_owned, "default journal reset is reserved for accepted mnx switch continuation")
              require(os.environ.get("MNX_OFFICE_POST_COMMIT_SEAL") == "1", "default journal reset requires post-commit seal authority")
              gid = grp.getgrnam(GROUP_NAME).gr_gid
              identity = accepted_identity()
              if identity["accepted_stage"] == "64":
                  anchor = load_anchor()
                  require(anchor is not None, "Stage64 closed-file observer recovery requires the immutable legacy anchor")
                  require(sha256_bytes(canonical_json(anchor)) == EXPECTED_ANCHOR_SHA256, "Stage64 closed-file observer recovery anchor digest differs")
                  verify_anchor_origin(anchor)
                  origin = load_pinned_blocker_review()
                  require(load_boundary() is None, "Stage64 closed-file observer recovery refuses an unexpected legacy recovery-boundary object")
                  require(RESET_PATH.exists() and not RESET_PATH.is_symlink(), "Stage64 requires the existing Stage62 default reset receipt; destructive reset authority is expired")
                  secure_regular_file(RESET_PATH, {0o640})
                  reset_raw = RESET_PATH.read_bytes()
                  try:
                      reset = json.loads(reset_raw.decode("utf-8"))
                  except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                      raise JournalIntegrityError(f"Stage62 default journal reset receipt is unreadable: {RESET_PATH}: {exc}") from exc
                  require(reset_raw == canonical_json(reset), "Stage62 default journal reset receipt is not canonical")
                  require(isinstance(reset, dict) and set(reset) == {"schema", "schema_version", "created_at", "created_by", "anchor_sha256", "origin", "operation", "postcondition"}, "Stage62 default journal reset receipt fields differ")
                  require(reset.get("schema") == RESET_SCHEMA and reset.get("schema_version") == 1, "Stage62 default journal reset receipt schema differs")
                  expected_reset_identity = {"accepted_stage": EXPECTED_RESET_OWNER_STAGE, "accepted_source_sha256": EXPECTED_RESET_OWNER_SOURCE_SHA256, "running_system": EXPECTED_RESET_OWNER_SYSTEM, "boot_default_system": EXPECTED_RESET_OWNER_SYSTEM}
                  require(reset.get("created_by") == expected_reset_identity, "Stage62 default journal reset receipt owner identity differs")
                  require(reset.get("anchor_sha256") == EXPECTED_ANCHOR_SHA256, "Stage62 default journal reset receipt anchor differs")
                  source_summary_sha = sha256_bytes(canonical_json(origin))
                  expected_origin = {"bundle": str(EXPECTED_BLOCKER_EVIDENCE), "summary_sha256": source_summary_sha, "source_sha256": EXPECTED_BLOCKER_SOURCE_SHA256, "system": EXPECTED_BLOCKER_SYSTEM}
                  require(reset.get("origin") == expected_origin, "Stage62 default journal reset receipt origin differs")
                  operation = reset.get("operation")
                  require(isinstance(operation, dict), "Stage62 default journal reset receipt operation is invalid")
                  require(operation.get("mode") == "reconciled-already-clean", "Stage62 reset receipt did not record the observed already-clean reconciliation")
                  require(operation.get("default_namespace_only") is True and operation.get("default_archived_history_discarded") is False and operation.get("journal_rotation_run") is False and operation.get("journal_vacuum_run") is False and operation.get("logbook_namespace_mutated") is False and operation.get("journal_repair_run") is False and operation.get("network_used") is False and operation.get("recurring_authority_created") is False, "Stage62 reset receipt operation policy differs")
                  postcondition = reset.get("postcondition")
                  require(isinstance(postcondition, dict) and postcondition.get("default_namespace_status") == "clean" and postcondition.get("logbook_namespace_status") in {"clean", "absent"} and postcondition.get("clean_forward_status") in {"legacy-damage-no-longer-observed", "clean"} and postcondition.get("new_problem_count") == 0, "Stage62 reset receipt clean postcondition differs")
                  results = [run_verify("default"), run_verify("logbook")]
                  summary = build_summary("switch-owned-stage64-closed-file-observer-reconcile", results, dt.datetime.now().astimezone().isoformat(timespec="seconds"), anchor, None)
                  bundle = publish_evidence("switch-owned-stage64-closed-file-observer-reconcile", results, summary, gid)
                  publish_state(summary, bundle, gid)
                  publish_metrics(summary)
                  log_summary(summary, bundle)
                  print("default_reset_action=existing-stage62-verified")
                  print("default_reset_mode=reconciled-already-clean")
                  print(f"default_reset_receipt={RESET_PATH}")
                  print("default_history_discarded=no")
                  print("default_reset_mutation_authority=expired-stage62-only")
                  print(f"verification_model={VERIFICATION_MODEL}")
                  print("live_active_journal_verify_authority=revoked")
                  print("active_journal_query_required=yes")
                  print("logbook_namespace_mutated=no")
                  print("recurring_vacuum_authority_created=no")
                  print_summary(summary, bundle, "suppressed-clean-forward")
                  default_result = next(item for item in results if item["namespace"] == "default")
                  logbook_result = next(item for item in results if item["namespace"] == "logbook")
                  clean_status = str(summary["clean_forward"]["status"])
                  if summary["overall_status"] == "malfunction":
                      print("MNX_JOURNAL_RECOVERY=FAIL_OBSERVER_MALFUNCTION")
                      return 1
                  if default_result["status"] != "clean" or logbook_result["status"] not in {"clean", "absent"} or clean_status not in {"legacy-damage-no-longer-observed", "clean"}:
                      print("MNX_JOURNAL_RECOVERY=BLOCKED_ARCHIVED_DAMAGE_OR_ACTIVE_QUERY_FAILURE")
                      return 76
                  print("MNX_JOURNAL_RECOVERY=PASS_CLOSED_FILE_MODEL")
                  return 0
              require(identity["accepted_stage"] == "62", "default journal reset mutation authority expired after accepted Stage62")
              anchor = load_anchor()
              require(anchor is not None, "default journal reset requires the immutable legacy anchor")
              require(sha256_bytes(canonical_json(anchor)) == EXPECTED_ANCHOR_SHA256, "default journal reset anchor digest differs")
              verify_anchor_origin(anchor)
              origin = load_pinned_blocker_review()
              require(load_boundary() is None, "default journal reset refuses an unexpected legacy recovery-boundary object")
              ensure_dir(STATE_ROOT, 0o750, gid)
              source_summary_sha = sha256_bytes(canonical_json(origin))
              origin_record = {"bundle": str(EXPECTED_BLOCKER_EVIDENCE), "summary_sha256": source_summary_sha, "source_sha256": EXPECTED_BLOCKER_SOURCE_SHA256, "system": EXPECTED_BLOCKER_SYSTEM}

              if RESET_PATH.exists() or RESET_PATH.is_symlink():
                  secure_regular_file(RESET_PATH, {0o640})
                  reset_raw = RESET_PATH.read_bytes()
                  try:
                      reset = json.loads(reset_raw.decode("utf-8"))
                  except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                      raise JournalIntegrityError(f"default journal reset receipt is unreadable: {RESET_PATH}: {exc}") from exc
                  require(reset_raw == canonical_json(reset), "default journal reset receipt is not canonical")
                  require(isinstance(reset, dict) and set(reset) == {"schema", "schema_version", "created_at", "created_by", "anchor_sha256", "origin", "operation", "postcondition"}, "default journal reset receipt fields differ")
                  require(reset.get("schema") == RESET_SCHEMA and reset.get("schema_version") == 1, "default journal reset receipt schema differs")
                  require(reset.get("created_by") == identity, "default journal reset receipt belongs to another accepted identity")
                  require(reset.get("anchor_sha256") == EXPECTED_ANCHOR_SHA256, "default journal reset receipt anchor differs")
                  require(reset.get("origin") == origin_record, "default journal reset receipt origin differs")
                  operation = reset.get("operation", {})
                  require(isinstance(operation, dict) and operation.get("default_namespace_only") is True and operation.get("logbook_namespace_mutated") is False and operation.get("network_used") is False and operation.get("journal_repair_run") is False and operation.get("recurring_authority_created") is False, "default journal reset receipt operation policy differs")
                  results = [run_verify("default"), run_verify("logbook")]
                  summary = build_summary("switch-owned-default-reset-reentry", results, dt.datetime.now().astimezone().isoformat(timespec="seconds"), anchor, None)
                  bundle = publish_evidence("switch-owned-default-reset-reentry", results, summary, gid)
                  publish_state(summary, bundle, gid)
                  publish_metrics(summary)
                  log_summary(summary, bundle)
                  print("default_reset_action=existing")
                  print(f"default_reset_mode={operation.get('mode', 'unknown')}")
                  print(f"default_reset_receipt={RESET_PATH}")
                  print_summary(summary, bundle, "suppressed-clean-forward")
                  default_result = next(item for item in results if item["namespace"] == "default")
                  logbook_result = next(item for item in results if item["namespace"] == "logbook")
                  clean_status = str(summary["clean_forward"]["status"])
                  if summary["overall_status"] == "malfunction" or default_result["status"] != "clean" or logbook_result["status"] not in {"clean", "absent"}:
                      print("MNX_JOURNAL_RECOVERY=BLOCKED_RECURRENT_DAMAGE")
                      return 76
                  if clean_status not in {"legacy-damage-no-longer-observed", "clean"}:
                      print("MNX_JOURNAL_RECOVERY=BLOCKED_REENTRY_CLASSIFICATION")
                      return 76
                  print("MNX_JOURNAL_RECOVERY=PASS_ALREADY_COMPLETE")
                  return 0

              if RESET_ATTEMPT_PATH.exists() or RESET_ATTEMPT_PATH.is_symlink():
                  secure_regular_file(RESET_ATTEMPT_PATH, {0o640})
                  attempt_raw = RESET_ATTEMPT_PATH.read_bytes()
                  try:
                      attempt = json.loads(attempt_raw.decode("utf-8"))
                  except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                      raise JournalIntegrityError(f"default journal reset attempt is unreadable: {RESET_ATTEMPT_PATH}: {exc}") from exc
                  require(attempt_raw == canonical_json(attempt), "default journal reset attempt is not canonical")
                  require(isinstance(attempt, dict) and set(attempt) == {"schema", "schema_version", "created_at", "updated_at", "created_by", "anchor_sha256", "origin", "phase", "operation"}, "default journal reset attempt fields differ")
                  require(attempt.get("schema") == RESET_ATTEMPT_SCHEMA and attempt.get("schema_version") == 1, "default journal reset attempt schema differs")
                  require(attempt.get("created_by") == identity and attempt.get("anchor_sha256") == EXPECTED_ANCHOR_SHA256 and attempt.get("origin") == origin_record, "default journal reset attempt identity differs")
                  require(attempt.get("phase") in {"authorized", "mutated"}, "default journal reset attempt phase differs")
                  operation = attempt.get("operation", {})
                  require(isinstance(operation, dict) and operation.get("default_namespace_only") is True and operation.get("logbook_namespace_mutated") is False and operation.get("network_used") is False and operation.get("journal_repair_run") is False and operation.get("recurring_authority_created") is False, "default journal reset attempt operation policy differs")
                  results = [run_verify("default"), run_verify("logbook")]
                  summary = build_summary("switch-owned-default-reset-attempt-reconcile", results, dt.datetime.now().astimezone().isoformat(timespec="seconds"), anchor, None)
                  bundle = publish_evidence("switch-owned-default-reset-attempt-reconcile", results, summary, gid)
                  publish_state(summary, bundle, gid)
                  publish_metrics(summary)
                  log_summary(summary, bundle)
                  print(f"default_reset_attempt_phase={attempt.get('phase')}")
                  print(f"default_reset_attempt={RESET_ATTEMPT_PATH}")
                  print("default_reset_mutation_repeated=no")
                  print_summary(summary, bundle, "suppressed-clean-forward")
                  default_result = next(item for item in results if item["namespace"] == "default")
                  logbook_result = next(item for item in results if item["namespace"] == "logbook")
                  clean_status = str(summary["clean_forward"]["status"])
                  if summary["overall_status"] == "malfunction":
                      print("MNX_JOURNAL_RECOVERY=FAIL_ATTEMPT_RECONCILIATION_OBSERVER")
                      return 1
                  if default_result["status"] != "clean" or logbook_result["status"] not in {"clean", "absent"} or clean_status not in {"legacy-damage-no-longer-observed", "clean"}:
                      print("MNX_JOURNAL_RECOVERY=BLOCKED_PRIOR_RESET_ATTEMPT_REMAINS_DAMAGED")
                      return 76
                  reconciled_operation = dict(operation)
                  reconciled_operation["mode"] = "reconciled-after-interrupted-reset-attempt"
                  receipt = {
                      "schema": RESET_SCHEMA,
                      "schema_version": 1,
                      "created_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                      "created_by": identity,
                      "anchor_sha256": EXPECTED_ANCHOR_SHA256,
                      "origin": origin_record,
                      "operation": reconciled_operation,
                      "postcondition": {"before_evidence": "interrupted-attempt", "after_evidence": str(bundle), "default_namespace_status": default_result["status"], "logbook_namespace_status": logbook_result["status"], "clean_forward_status": clean_status, "new_problem_count": int(summary["clean_forward"].get("new_problem_count", 0))},
                  }
                  created = atomic_create_once(RESET_PATH, canonical_json(receipt), 0o640, gid)
                  secure_regular_file(RESET_PATH, {0o640})
                  require(RESET_PATH.read_bytes() == canonical_json(receipt), "reconciled default journal reset receipt differs after publication")
                  print(f"default_reset_action={'created-reconciled' if created else 'existing-race'}")
