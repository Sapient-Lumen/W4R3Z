#@MNX-CHUNK id=70.10 slug=mirrors-dedupe-m21 title="Dedupe, new-to-old mirror, and m21 pull implementations"
#######################################################################################################
# SECTION 70 — BACKUP IMPLEMENTATIONS, MIRRORS, DEDUPE, AND M21
#######################################################################################################

  ### deduplication and waterfall mirrors ###
#@MNX-CHUNK id=70.11 slug=old-storage-rsync-mirror title="Authoritative new-storage to old-storage rsync mirror"
#@MNX-DEF path=systemd.services.rsync-m16-new-to-old section=70.11 role=service ordinal=220
  systemd.services.rsync-m16-new-to-old = {
    description = "monthly browseable mirror new->old via locked private rw remount";
    wants = [ "local-fs.target" ];
    after = [ "local-fs.target" ];
    unitConfig = {
      ConditionPathIsMountPoint = "/mnt/m16-new-storage";
      RequiresMountsFor = [ "/mnt/m16-new-storage" "/mnt/m16-old-storage" "/home" ];
      OnFailure = "mnx-job-failure-notify@%n.service";
    };
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Nice = 19;
      CPUSchedulingPolicy = "idle";
      IOSchedulingClass = "idle";
      TimeoutStartSec = "12h";
      TimeoutStopSec = "10min";
      KillMode = "control-group";
      Restart = "no";
      SuccessExitStatus = [ 75 ]; # manager-requested interruption is a clean retryable skip
      UMask = "0077";
      NoNewPrivileges = true;
      PrivateTmp = true;
      PrivateMounts = true; # writable old-storage remount exists only in this unit's mount namespace
      ProtectSystem = "full";
      RestrictSUIDSGID = false; # preserve SUID/SGID metadata in the -aHAX mirror
    };
    path = [ pkgs.bash pkgs.coreutils pkgs.findutils pkgs.gnugrep pkgs.gnused pkgs.util-linux pkgs.rsync ];
    script = ''
      set -euo pipefail
      JOB_START="$(date +%s)"
      JOB_SKIPPED=0
      JOB_REASON=none
      SRC=/mnt/m16-new-storage
      DST=/mnt/m16-old-storage
      L=/run/storage-maintenance.lock
      OLD_STORAGE_RW=0

      #@MNX-PART id=70.11.rsync-m16-new-to-old.function.restore_old_storage_ro kind=function title="Function restore_old_storage_ro"
      restore_old_storage_ro() {
        if (( OLD_STORAGE_RW == 0 )); then
          return 0
        fi
        sync -f "$DST" || true
        if ! mount -o remount,ro "$DST"; then
          return 1
        fi
        OPTIONS="$(findmnt -rn -T "$DST" -o OPTIONS 2>/dev/null || true)"
        case ",$OPTIONS," in
          *,ro,*) OLD_STORAGE_RW=0; return 0 ;;
          *) return 1 ;;
        esac
      }

      #@MNX-PART id=70.11.rsync-m16-new-to-old.function.finish kind=function title="Function finish"
      finish() {
        rc="$?"
        trap - EXIT INT TERM
        if (( OLD_STORAGE_RW == 1 )); then
          if ! restore_old_storage_ro; then
            printf 'ERROR: failed to restore private old-storage view read-only\n' >&2
            JOB_REASON=remount-ro-failed
            rc=1
          fi
        fi
        /etc/monsternix/bin/mnx-job-metric \
          rsync-m16-new-to-old "$rc" "$(( $(date +%s) - JOB_START ))" "$JOB_SKIPPED" "$JOB_REASON" || true
        exit "$rc"
      }
      #@MNX-PART id=70.11.rsync-m16-new-to-old.function.manager-stop-retryable kind=function title="Function manager_stop_retryable"
      manager_stop_retryable() {
        JOB_SKIPPED=1
        JOB_REASON=manager-stop-retryable
        printf 'SKIP rsync-m16-new-to-old reason=%s; private old-storage view will be synchronized and restored read-only before exit\n' "$JOB_REASON"
        exit 75
      }
      trap finish EXIT
      trap 'exit 130' INT
      trap manager_stop_retryable TERM

      exec 9<>"$L"
      if ! flock -n -x 9; then JOB_SKIPPED=1; JOB_REASON=lock-busy; exit 0; fi
      mountpoint -q "$DST"

      OPTIONS="$(findmnt -rn -T "$DST" -o OPTIONS 2>/dev/null || true)"
      case ",$OPTIONS," in
        *,ro,*) ;;
        *) JOB_REASON=host-mount-not-read-only; printf 'ERROR: old-storage did not begin read-only: %s\n' "$OPTIONS" >&2; exit 1 ;;
      esac

      # PrivateMounts keeps this remount inside the service namespace. The host
      # mount remains read-only while rsync obtains the only authorized writable view.
      OLD_STORAGE_RW=1
      if ! mount -o remount,rw "$DST"; then
        JOB_REASON=remount-rw-failed
        exit 1
      fi
      OPTIONS="$(findmnt -rn -T "$DST" -o OPTIONS 2>/dev/null || true)"
      case ",$OPTIONS," in
        *,rw,*) ;;
        *) JOB_REASON=private-view-not-read-write; printf 'ERROR: private old-storage view is not writable: %s\n' "$OPTIONS" >&2; exit 1 ;;
      esac

      if ! /etc/monsternix/bin/mnx-storage-preflight rsync-m16-new-to-old "$SRC" "$DST" /home; then JOB_SKIPPED=1; JOB_REASON=preflight; exit 0; fi

      LOG=/home/h0p3/admin/logs/root-rsync-storage-drives.log
      mkdir -p "$(dirname "$LOG")"
      : >>"$LOG"

      max=1048576
      RUN_ID="$(date +%Y%m%dT%H%M%S)-$$"
      #@MNX-PART id=70.11.rsync-m16-new-to-old.function.log kind=function title="Function log"
      log() {
        printf "%s - %s\n" "$(date "+%F %T")" "$*" | tee -a "$LOG"
      }
      #@MNX-PART id=70.11.rsync-m16-new-to-old.function.compact_log kind=function title="Function compact_log"
      compact_log() {
        size="$(stat -c%s "$LOG" 2>/dev/null || echo 0)"
        if [ "$size" -gt "$max" ]; then
          tmp="$LOG.tmp.$$"
          tail -c "$max" "$LOG" > "$tmp"
          mv -f "$tmp" "$LOG"
        fi
      }

      # This is a browseable mirror, not the versioned snapshot archive. Do not
      # flatten received Btrfs snapshot trees into ordinary files on old-storage.
      log "BEGIN rsync-m16-new-to-old run_id=$RUN_ID source=$SRC destination=$DST exclusions=admin/backups,syncs/m21"
      rsync \
        -aHAX \
        --numeric-ids \
        --delete \
        --force \
        --delete-delay \
        --delay-updates \
        --info=stats2 \
        --exclude='/admin/backups/***' \
        --exclude='/syncs/m21/***' \
        "$SRC/" "$DST/" >>"$LOG" 2>&1 || {
          rc="$?"
          log "ERROR rsync-m16-new-to-old run_id=$RUN_ID exit=$rc"
          compact_log
          exit "$rc"
        }

      /etc/monsternix/bin/mnx-storage-postflight rsync-m16-new-to-old

      if ! restore_old_storage_ro; then
        JOB_REASON=remount-ro-failed
        log "ERROR rsync-m16-new-to-old run_id=$RUN_ID exit=1 reason=remount-ro-failed"
        compact_log
        exit 1
      fi

      log "SUCCESS rsync-m16-new-to-old run_id=$RUN_ID exit=0 host_mount=ro private_transaction=closed"
      compact_log
      /etc/monsternix/bin/mnx-job-success \
        rsync-m16-new-to-old "$DST" "source=$SRC exclusions=admin/backups,syncs/m21 host_mount=ro"
    '';
  };

