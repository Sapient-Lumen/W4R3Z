#@MNX-CHUNK id=40.2B slug=manager-loop-observability title="Transaction-scoped PID 1 manager-loop census and attribution"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-manager-loop-report" section=40.2B role=generated-program ordinal=172
  environment.etc."monsternix/bin/mnx-manager-loop-report" = {
    source = pkgs.writeTextFile {
      name = "mnx-manager-loop-report";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      set -uo pipefail
      export LC_ALL=C SYSTEMD_PAGER=cat SYSTEMD_COLORS=0 PAGER=cat

      LOOP_MESSAGE='Looping too fast. Throttling execution a little.'
      MODE="''${1:-summary}"
      shift || true

      #@MNX-PART id=40.2B.mnx-manager-loop-report.function.count-loop-stream kind=function title="Function count_loop_stream"
      count_loop_stream() {
        ${pkgs.gawk}/bin/awk -v needle="$LOOP_MESSAGE" 'index($0, needle) { count += 1 } END { print count + 0 }'
      }

      #@MNX-PART id=40.2B.mnx-manager-loop-report.function.latest-loop-stream kind=function title="Function latest_loop_stream"
      latest_loop_stream() {
        ${pkgs.gawk}/bin/awk -v needle="$LOOP_MESSAGE" 'index($0, needle) { latest=$0 } END { if (latest != "") print latest }'
      }

      #@MNX-PART id=40.2B.mnx-manager-loop-report.function.default-window-start kind=function title="Function default_window_start"
      default_window_start() {
        local value
        value="$(${pkgs.systemd}/bin/systemctl show sysinit-reactivation.target -p ActiveEnterTimestamp --value 2>/dev/null || true)"
        if [[ -n "$value" && "$value" != n/a ]]; then
          printf '%s\n' "$value"
        else
          ${pkgs.coreutils}/bin/date -d '10 minutes ago' -Is
        fi
      }

      #@MNX-PART id=40.2B.mnx-manager-loop-report.function.later-epoch kind=function title="Function later_epoch"
      later_epoch() {
        local first="$1"
        local second="$2"
        [[ "$first" =~ ^[0-9]+$ && "$second" =~ ^[0-9]+$ ]] || return 64
        if (( first >= second )); then
          printf '%s\n' "$first"
        else
          printf '%s\n' "$second"
        fi
      }

      #@MNX-PART id=40.2B.mnx-manager-loop-report.function.unit-start-count kind=function title="Function unit_start_count"
      unit_start_count() {
        local unit="$1"
        local since="$2"
        ${pkgs.systemd}/bin/journalctl -b -u "$unit" --since "$since" --no-pager -o cat 2>/dev/null |
          ${pkgs.gawk}/bin/awk 'index($0, "Starting ") == 1 { count += 1 } END { print count + 0 }'
      }

      #@MNX-PART id=40.2B.mnx-manager-loop-report.function.self-test kind=function title="Function self_test"
      self_test() {
        local sample count latest
        sample="$(${pkgs.coreutils}/bin/printf '%s\n' \
          'ordinary line' \
          'Looping too fast. Throttling execution a little.' \
          'another line' \
          'prefix Looping too fast. Throttling execution a little. suffix')"
        count="$(${pkgs.coreutils}/bin/printf '%s\n' "$sample" | count_loop_stream)"
        latest="$(${pkgs.coreutils}/bin/printf '%s\n' "$sample" | latest_loop_stream)"
        [[ "$count" == 2 ]] || { echo "MNX_MANAGER_LOOP_SELF_TEST_ERROR: count=$count" >&2; return 1; }
        [[ "$latest" == 'prefix Looping too fast. Throttling execution a little. suffix' ]] || { echo "MNX_MANAGER_LOOP_SELF_TEST_ERROR: latest=$latest" >&2; return 1; }
        [[ "$(later_epoch 100 200)" == 200 ]] || { echo 'MNX_MANAGER_LOOP_SELF_TEST_ERROR: later_epoch forward' >&2; return 1; }
        [[ "$(later_epoch 300 200)" == 300 ]] || { echo 'MNX_MANAGER_LOOP_SELF_TEST_ERROR: later_epoch reverse' >&2; return 1; }
        if later_epoch invalid 200 >/dev/null 2>&1; then
          echo 'MNX_MANAGER_LOOP_SELF_TEST_ERROR: later_epoch accepted nonnumeric input' >&2
          return 1
        fi
        echo 'MNX_MANAGER_LOOP_REPORT_SELF_TEST=PASS'
      }

      if [[ "$MODE" == self-test ]]; then
        self_test
        exit
      fi

      if [[ ''${EUID:-$(${pkgs.coreutils}/bin/id -u)} -ne 0 ]]; then
        [[ -x /run/wrappers/bin/sudo ]] || { echo '/run/wrappers/bin/sudo is unavailable' >&2; exit 126; }
        exec /run/wrappers/bin/sudo -- ${pkgs.coreutils}/bin/env \
          MNX_LOOP_SINCE="''${MNX_LOOP_SINCE:-}" \
          /etc/monsternix/bin/mnx-manager-loop-report "$MODE" "$@"
      fi

      case "$MODE" in
        summary|audit|full)
          ;;
        help|-h|--help)
          cat <<'USAGE'
      mnx-manager-loop-report [summary|audit|full]

      Report PID 1 "Looping too fast" messages from the latest sysinit reactivation
      (or MNX_LOOP_SINCE), plus a two-minute freshness count and suspect service starts.
      This is diagnostic-only and changes no unit, timer, baseline, or filesystem.
      USAGE
          exit 0
          ;;
        *)
          echo "unknown manager-loop report mode: $MODE" >&2
          exit 64
          ;;
      esac

      WINDOW_REQUESTED="''${MNX_LOOP_SINCE:-$(default_window_start)}"
      NOW_EPOCH="$(${pkgs.coreutils}/bin/date +%s)"
      WINDOW_START_EPOCH="$(${pkgs.coreutils}/bin/date -d "$WINDOW_REQUESTED" +%s 2>/dev/null || true)"
      [[ "$NOW_EPOCH" =~ ^[0-9]+$ ]] || { echo 'could not read the current manager-loop wall clock' >&2; exit 1; }
      [[ "$WINDOW_START_EPOCH" =~ ^[0-9]+$ ]] || { echo "invalid manager-loop window start: $WINDOW_REQUESTED" >&2; exit 1; }
      LAST_TWO_MINUTES_EPOCH=$((NOW_EPOCH - 120))
      [[ "$LAST_TWO_MINUTES_EPOCH" =~ ^[0-9]+$ ]] || { echo 'could not calculate the two-minute manager-loop boundary' >&2; exit 1; }
      CLOCK_ANOMALY=none
      if (( WINDOW_START_EPOCH > NOW_EPOCH )); then
        WINDOW_START_EPOCH="$NOW_EPOCH"
        CLOCK_ANOMALY=future-activation-clamped-to-now
      fi
      RECENT_START_EPOCH="$(later_epoch "$WINDOW_START_EPOCH" "$LAST_TWO_MINUTES_EPOCH")" || { echo 'could not intersect manager-loop windows' >&2; exit 1; }
      WINDOW_START="$(${pkgs.coreutils}/bin/date -d "@$WINDOW_START_EPOCH" -Is)"
      RECENT_START="$(${pkgs.coreutils}/bin/date -d "@$RECENT_START_EPOCH" -Is)"
      RECENT_CLAMPED_TO_ACTIVATION=no
      if (( WINDOW_START_EPOCH > LAST_TWO_MINUTES_EPOCH )); then
        RECENT_CLAMPED_TO_ACTIVATION=yes
      fi

      # Keep only the matching manager-loop records in memory. Both queries begin no earlier
      # than the current activation, so a candidate can never inherit "recent" events from the
      # generation it replaced.
      EVENTS="$(${pkgs.systemd}/bin/journalctl -b _PID=1 --since "@$WINDOW_START_EPOCH" --no-pager -o short-iso 2>/dev/null | ${pkgs.gnugrep}/bin/grep -F "$LOOP_MESSAGE" || true)"
      RECENT_EVENTS="$(${pkgs.systemd}/bin/journalctl -b _PID=1 --since "@$RECENT_START_EPOCH" --no-pager -o short-iso 2>/dev/null | ${pkgs.gnugrep}/bin/grep -F "$LOOP_MESSAGE" || true)"
      LOOP_COUNT="$(${pkgs.coreutils}/bin/printf '%s\n' "$EVENTS" | count_loop_stream)"
      RECENT_COUNT="$(${pkgs.coreutils}/bin/printf '%s\n' "$RECENT_EVENTS" | count_loop_stream)"
      LOOP_LATEST="$(${pkgs.coreutils}/bin/printf '%s\n' "$EVENTS" | latest_loop_stream)"

      [[ "$LOOP_COUNT" =~ ^[0-9]+$ && "$RECENT_COUNT" =~ ^[0-9]+$ ]] || { echo 'manager-loop reporter produced nonnumeric counts' >&2; exit 1; }
      (( RECENT_COUNT <= LOOP_COUNT )) || { echo "manager-loop window contradiction: recent=$RECENT_COUNT activation=$LOOP_COUNT" >&2; exit 1; }
      if (( LOOP_COUNT == 0 )); then
        [[ -z "$LOOP_LATEST" ]] || { echo "manager-loop latest event exists while activation count is zero: $LOOP_LATEST" >&2; exit 1; }
      else
        [[ -n "$LOOP_LATEST" ]] || { echo "manager-loop activation count is $LOOP_COUNT but latest event is empty" >&2; exit 1; }
      fi

      printf 'pid1_loop_window_requested=%s\n' "$WINDOW_REQUESTED"
      printf 'pid1_loop_window_start=%s\n' "$WINDOW_START"
      printf 'pid1_loop_window_start_epoch=%s\n' "$WINDOW_START_EPOCH"
      printf 'pid1_loop_recent_window_start=%s\n' "$RECENT_START"
      printf 'pid1_loop_recent_window_start_epoch=%s\n' "$RECENT_START_EPOCH"
      printf 'pid1_loop_recent_window_clamped_to_activation=%s\n' "$RECENT_CLAMPED_TO_ACTIVATION"
      printf 'pid1_loop_clock_anomaly=%s\n' "$CLOCK_ANOMALY"
      printf 'pid1_loop_throttle_since_activation_count=%s\n' "''${LOOP_COUNT:-0}"
      printf 'pid1_loop_throttle_last_2m_count=%s\n' "''${RECENT_COUNT:-0}"
      printf 'pid1_loop_throttle_latest=%s\n' "''${LOOP_LATEST:-none}"
      printf 'pid1_loop_window_consistency=pass\n'

      HYPER_PATH_LOAD="$(${pkgs.systemd}/bin/systemctl show hypertext-i2p-sync.path -p LoadState --value 2>/dev/null || true)"
      HYPER_TRIGGERED_BY="$(${pkgs.systemd}/bin/systemctl show hypertext-i2p-sync.service -p TriggeredBy --value 2>/dev/null || true)"
      HYPER_TIMER_STATE="$(${pkgs.systemd}/bin/systemctl show hypertext-i2p-sync.timer -p ActiveState --value 2>/dev/null || true)"
      JSON_PATH_LOAD="$(${pkgs.systemd}/bin/systemctl show savetrail-jsons.path -p LoadState --value 2>/dev/null || true)"
      JSON_TRIGGERED_BY="$(${pkgs.systemd}/bin/systemctl show savetrail-jsons.service -p TriggeredBy --value 2>/dev/null || true)"
      JSON_TIMER_STATE="$(${pkgs.systemd}/bin/systemctl show savetrail-jsons.timer -p ActiveState --value 2>/dev/null || true)"
      JSON_MATCH_COUNT="$(${pkgs.findutils}/bin/find /home/h0p3/downloads -maxdepth 1 -type f -name '*.json' -printf . 2>/dev/null | ${pkgs.coreutils}/bin/wc -c | ${pkgs.coreutils}/bin/tr -d '[:space:]')"
      [[ "$JSON_MATCH_COUNT" =~ ^[0-9]+$ ]] || JSON_MATCH_COUNT=0
      printf 'hypertext_i2p_path_load_state=%s\n' "''${HYPER_PATH_LOAD:-not-found}"
      printf 'hypertext_i2p_service_triggered_by=%s\n' "''${HYPER_TRIGGERED_BY:-none}"
      printf 'hypertext_i2p_timer_active_state=%s\n' "''${HYPER_TIMER_STATE:-unknown}"
      printf 'savetrail_json_path_load_state=%s\n' "''${JSON_PATH_LOAD:-not-found}"
      printf 'savetrail_json_service_triggered_by=%s\n' "''${JSON_TRIGGERED_BY:-none}"
      printf 'savetrail_json_timer_active_state=%s\n' "''${JSON_TIMER_STATE:-unknown}"
      printf 'savetrail_json_top_level_match_count=%s\n' "$JSON_MATCH_COUNT"

      SUSPECT_UNITS=(
        hypertext-i2p-sync.service
        savetrail-jsons.service
        monsternix-config-copy.service
        logbook-incident-scan.service
        mnx-storage-health.service
        mnx-metric-reconcile.service
        systemd-tmpfiles-resetup.service
        accounts-daemon.service
        NetworkManager-dispatcher.service
      )

      for unit in "''${SUSPECT_UNITS[@]}"; do
        printf 'manager_start_count[%s]=%s\n' "$unit" "$(unit_start_count "$unit" "@$WINDOW_START_EPOCH")"
      done

      if [[ "$MODE" == full ]]; then
        printf '\nExact PID 1 loop-throttle events:\n'
        if [[ -n "$EVENTS" ]]; then
          ${pkgs.coreutils}/bin/printf '%s\n' "$EVENTS"
        else
          echo none
        fi
        printf '\nSuspect service journal tails since window start:\n'
        for unit in "''${SUSPECT_UNITS[@]}"; do
          printf '\n--- %s ---\n' "$unit"
          ${pkgs.systemd}/bin/journalctl -b -u "$unit" --since "$WINDOW_START" --no-pager -o short-iso -n 120 2>&1 || true
        done
      fi

      echo 'MNX_MANAGER_LOOP_REPORT=PASS'
      exit 0
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            "$out" self-test | ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_MANAGER_LOOP_REPORT_SELF_TEST=PASS'
            ;;
          *)
            echo "unexpected manager-loop reporter interpreter: $first" >&2
            exit 1
            ;;
        esac
      '';
    };
  };

#@MNX-CHUNK id=40.30 slug=operational-observability title="Mode, listener, timer, health, freshness, and support observability"
  ### Monsternix mode/listener/timer logging ###
  # These are deliberately narrow, independent observers. They do not firewall,
  # restart, kill, or repair anything. They only write bounded logbook reports and
  # Prometheus textfile metrics so future debugging has a clean witness trail.

#@MNX-CHUNK id=40.31 slug=mode-and-listener-census title="Mode history and network-listener census"
#@MNX-DEF path=systemd.services.mnx-mode-marker section=40.31 role=service ordinal=173
  systemd.services.mnx-mode-marker = {
    description = "Record current Monsternix mode";
    wantedBy = [ "multi-user.target" ];
    after = [ "local-fs.target" "systemd-journald.service" ];
    wants = [ "local-fs.target" ];
    serviceConfig = {
      Type = "oneshot";
      User = "root";
      Group = "logbook";
      UMask = "0027";
      StateDirectory = "logbook";
      StateDirectoryMode = "2750";
      StandardOutput = "journal";
      StandardError = "journal";
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectSystem = "full";
      RestrictSUIDSGID = true;
      ReadWritePaths = [ "/run/monsternix" "/var/lib/logbook" "/var/lib/node-exporter-textfile" ];
    };
    path = [ pkgs.coreutils pkgs.util-linux pkgs.systemd pkgs.gnused ];
    script = ''
      set -euo pipefail
      umask 027

      MODE="$(tr -d '\r\n' < /etc/monsternix/mode 2>/dev/null || echo normal)"
      [ -n "$MODE" ] || MODE=normal
      SAFE_MODE="$(printf '%s' "$MODE" | sed -E 's/[^A-Za-z0-9_.-]+/_/g')"
      TS="$(date -Is)"
      SAFE_TS="$(date +%Y%m%dT%H%M%S)"
      BOOT_ID="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)"
      OUT="/var/lib/logbook/mode/current.txt"
      HIST="/var/lib/logbook/mode/mode-$SAFE_TS.txt"
      PROM_TMP="/var/lib/node-exporter-textfile/monsternix_mode.prom.$$"
      PROM="/var/lib/node-exporter-textfile/monsternix_mode.prom"

      install -d -m 0755 -o root -g root /run/monsternix
      install -d -m 2750 -o root -g logbook /var/lib/logbook/mode
      install -d -m 0755 -o root -g root /var/lib/node-exporter-textfile

      printf '%s\n' "$MODE" > /run/monsternix/mode
      chmod 0644 /run/monsternix/mode

      cat > "$OUT" <<EOF
mode=$MODE
boot_id=$BOOT_ID
timestamp=$TS
system=$(readlink -f /run/current-system 2>/dev/null || true)
EOF
      cp -f "$OUT" "$HIST" || true
      chown root:logbook "$OUT" "$HIST" 2>/dev/null || true
      chmod 0640 "$OUT" "$HIST" 2>/dev/null || true
      find /var/lib/logbook/mode -maxdepth 1 -type f -name 'mode-*.txt' -mtime +90 -delete 2>/dev/null || true

      cat > "$PROM_TMP" <<EOF
# HELP monsternix_mode_info Current Monsternix specialisation/personality mode.
# TYPE monsternix_mode_info gauge
monsternix_mode_info{mode="$SAFE_MODE"} 1
EOF
      chmod 0644 "$PROM_TMP" 2>/dev/null || true
      mv -f "$PROM_TMP" "$PROM"
      chmod 0644 "$PROM" 2>/dev/null || true

      logger --journald <<EOF || logger -t mnx-mode-marker "Monsternix mode: $MODE" || true
MESSAGE_ID=01db87f4-f408-5c8d-976d-bdfb7af759d4
PRIORITY=5
LOGBOOK_KIND=MNX_MODE_MARKER
LOGBOOK_VER=1
MONSTERNIX_MODE=$MODE
BOOT_ID=$BOOT_ID
BUNDLE_PATH=$OUT
MESSAGE=Monsternix mode: $MODE
EOF
    '';
  };

#@MNX-DEF path=environment.etc."monsternix/bin/mnx-exposure" section=40.31 role=generated-program ordinal=174
  environment.etc."monsternix/bin/mnx-exposure" = {
    source = pkgs.writeTextFile {
      name = "mnx-exposure";
      executable = true;
      text = ''
      #!${pkgs.python3}/bin/python3
      from __future__ import annotations
                  
      import argparse
      import collections
      import datetime as dt
      import fnmatch
      import grp
      import hashlib
      import ipaddress
      import json
      import os
      import pathlib
      import re
      import shlex
      import stat
      import subprocess
      import sys
      import tempfile
      from typing import Any
                  
      VERSION = 3
      POLICY_SCHEMA = 2
      ZONE_SCHEMA = 1
      LEDGER_SCHEMA = 1
      MAX_OUTPUT_BYTES = 262_144
      MAX_AUXILIARY_SECTION_BYTES = 65_536
      MAX_SS_BYTES = 4_194_304
      MAX_LISTENERS = 4096
      MAX_OWNER_PIDS = 1024
      MAX_SYSTEMD_UNIT_LOOKUPS = 128
      MAX_LEDGER_ENTRIES = 8192
      LEDGER_RETENTION_SECONDS = 45 * 86400
      DEFAULT_CONFIG = pathlib.Path(os.environ.get("MNX_EXPOSURE_CONFIG", "/etc/nixos/configuration.nix"))
      DEFAULT_LOG_ROOT = pathlib.Path(os.environ.get("MNX_EXPOSURE_LOG_ROOT", "/var/lib/logbook/network"))
      DEFAULT_STATE_ROOT = pathlib.Path(os.environ.get("MNX_EXPOSURE_STATE_ROOT", "/var/lib/monsternix/exposure"))
      DEFAULT_PROM = pathlib.Path(os.environ.get("MNX_EXPOSURE_PROM", "/var/lib/node-exporter-textfile/monsternix_network.prom"))
      RPCINFO = pathlib.Path("${pkgs.rpcbind}/bin/rpcinfo")
      RPCINFO_ACCEPTED_STATES = {"ok", "disabled-no-rpc-surface"}
      RPC_WELL_KNOWN_PORTS = {111, 2049, 20048}
      RPC_RUNTIME_UNITS = (
          "rpcbind.service", "rpcbind.socket", "nfs-server.service", "nfs-mountd.service",
          "nfs-idmapd.service", "rpc-statd.service", "rpc-statd-notify.service", "rpc-rquotad.service",
      )
      RPC_OWNER_HINTS = ("rpc", "nfs", "mountd", "statd", "nlockmgr", "rquotad")
      BEGIN_RE = re.compile(r"^#@MNX-EXPOSURE-BEGIN schema=2 policy_mode=(observe-only) default_disposition=(review)$")
      ZONE_RE = re.compile(r"^#@MNX-ZONE (.+)$")
      ENTRY_RE = re.compile(r"^#@MNX-EXPOSURE (.+)$")
      END_RE = re.compile(r"^#@MNX-EXPOSURE-END$")
      ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
      SAFE_GLOB_RE = re.compile(r"^[A-Za-z0-9._:+@/*?-]+$")
      ALLOWED_ENTRY_FIELDS = {
          "id", "proto", "port", "address", "interfaces", "netns", "unit", "process",
          "package", "cgroup", "mode", "disposition", "intent", "zone", "required", "volatility",
      }
      REQUIRED_ENTRY_FIELDS = set(ALLOWED_ENTRY_FIELDS)
      ALLOWED_ZONE_FIELDS = {"id", "interfaces", "address", "bind_policy", "sources", "enforcement"}
      REQUIRED_ZONE_FIELDS = set(ALLOWED_ZONE_FIELDS)
      ADDRESS_CLASSES = {"wildcard", "loopback", "link-local", "multicast", "lan", "public", "unknown"}
      NETNS_CLASSES = {"host", "nonhost", "unknown", "any"}
      DISPOSITIONS = {"known", "review", "forbidden"}
      PROTOCOLS = {"tcp", "udp", "any"}
      VOLATILITY_CLASSES = {"persistent", "dynamic", "transient"}
      BIND_POLICIES = {"exact", "firewall-gated", "any", "review"}
      ZONE_ENFORCEMENT = {"observe-only"}
      ZONE_STATUS_ATTENTION = {"firewall-required", "overbroad", "interface-mismatch", "review", "unknown-zone"}
      SS_OWNER_RE = re.compile(r'\("(?P<comm>(?:\\.|[^"])*)",pid=(?P<pid>[0-9]+),fd=(?P<fd>[0-9]+)')
      STORE_RE = re.compile(r"^/nix/store/[0-9a-z]{32}-(?P<package>[^/]+)(?P<rest>/.*)?$")
      METRIC_RE = re.compile(r"^[a-zA-Z_:][a-zA-Z0-9_:]*$")
            
      #@MNX-PART id=40.31.mnx-exposure.class.exposureerror kind=class title="Python class ExposureError"
      class ExposureError(RuntimeError):
          pass
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.canonical-json kind=function title="Python function canonical_json"
      def canonical_json(value: Any) -> bytes:
          return (json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True) + "\n").encode("utf-8")
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.sha256-bytes kind=function title="Python function sha256_bytes"
      def sha256_bytes(data: bytes) -> str:
          return hashlib.sha256(data).hexdigest()
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.sha256-file kind=function title="Python function sha256_file"
      def sha256_file(path: pathlib.Path) -> str:
          return sha256_bytes(path.read_bytes())
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.run kind=function title="Python function run"
      def run(command: list[str], *, timeout: int = 30, check: bool = True) -> str:
          try:
              completed = subprocess.run(
                  command,
                  text=True,
                  stdout=subprocess.PIPE,
                  stderr=subprocess.PIPE,
                  timeout=timeout,
                  check=False,
              )
          except (OSError, subprocess.TimeoutExpired) as exc:
              raise ExposureError(f"command unavailable or timed out: {command}: {exc}") from exc
          if check and completed.returncode != 0:
              raise ExposureError(
                  f"command failed ({completed.returncode}): {' '.join(command)}: {completed.stderr.strip()}"
              )
          return completed.stdout
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.bounded-auxiliary-text kind=function title="Python function bounded_auxiliary_text"
      def bounded_auxiliary_text(value: str, label: str) -> str:
          data = value.encode("utf-8", errors="replace")
          if len(data) <= MAX_AUXILIARY_SECTION_BYTES:
              return value if value.endswith("\n") else value + "\n"
          marker = f"\nTRUNCATED_MNX_EXPOSURE_AUXILIARY_SECTION={label}\n".encode("utf-8")
          kept = data[: max(0, MAX_AUXILIARY_SECTION_BYTES - len(marker))]
          return (kept + marker).decode("utf-8", errors="replace")
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.optional-bounded-command kind=function title="Python function optional_bounded_command"
      def optional_bounded_command(command: list[str], label: str, *, timeout: int = 15) -> str:
          try:
              completed = subprocess.run(
                  command,
                  text=True,
                  stdout=subprocess.PIPE,
                  stderr=subprocess.PIPE,
                  timeout=timeout,
                  check=False,
              )
          except (OSError, subprocess.TimeoutExpired) as exc:
              return bounded_auxiliary_text(f"UNAVAILABLE: {label}: {exc}\n", label)
          value = completed.stdout
          if completed.returncode != 0:
              value += f"\nEXIT_STATUS={completed.returncode}\n"
              if completed.stderr:
                  value += completed.stderr
          if not value.strip():
              value = "none\n"
          return bounded_auxiliary_text(value, label)
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.collect-auxiliary-context kind=function title="Python function collect_auxiliary_context"
      def collect_auxiliary_context() -> list[tuple[str, str]]:
          return [
              ("ip -br address", optional_bounded_command(["ip", "-br", "address"], "ip-address")),
              ("ip route show table all", optional_bounded_command(["ip", "route", "show", "table", "all"], "ip-routes")),
              ("listening unix sockets with process info", optional_bounded_command(["ss", "-H", "-lnxp"], "unix-sockets")),
              ("systemd sockets", optional_bounded_command(["systemctl", "list-sockets", "--all", "--no-pager", "--no-legend"], "systemd-sockets")),
              ("running services", optional_bounded_command(["systemctl", "list-units", "--type=service", "--state=running", "--no-pager", "--no-legend"], "running-services")),
          ]
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.split-csv kind=function title="Python function split_csv"
      def split_csv(value: str) -> list[str]:
          values = [item.strip() for item in value.split(",") if item.strip()]
          if not values:
              raise ExposureError(f"empty comma-separated value: {value!r}")
          return values
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.parse-ports kind=function title="Python function parse_ports"
      def parse_ports(value: str) -> list[tuple[int, int]]:
          if value == "*":
              return [(0, 65535)]
          ranges: list[tuple[int, int]] = []
          for item in split_csv(value):
              if "-" in item:
                  left, right = item.split("-", 1)
              else:
                  left = right = item
              if not left.isdigit() or not right.isdigit():
                  raise ExposureError(f"invalid port expression: {item!r}")
              low = int(left)
              high = int(right)
              if low < 1 or high > 65535 or low > high:
                  raise ExposureError(f"invalid port range: {item!r}")
              ranges.append((low, high))
          return ranges
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.parse-policy-text kind=function title="Python function parse_policy_text"
      def parse_policy_text(text: str) -> dict[str, Any]:
          lines = text.splitlines()
          begin = [index for index, line in enumerate(lines) if BEGIN_RE.fullmatch(line)]
          end = [index for index, line in enumerate(lines) if END_RE.fullmatch(line)]
          if len(begin) != 1 or len(end) != 1 or end[0] <= begin[0]:
              raise ExposureError(f"expected one ordered exposure policy block; begin={len(begin)} end={len(end)}")
            
          #@MNX-PART id=40.31.mnx-exposure.parse-policy-text.function.parse-fields kind=function title="Python nested function parse_fields"
          def parse_fields(payload: str, line_number: int, *, allowed: set[str], required: set[str], label: str) -> dict[str, str]:
              try:
                  tokens = shlex.split(payload, posix=True)
              except ValueError as exc:
                  raise ExposureError(f"invalid {label} marker at line {line_number}: {exc}") from exc
              fields: dict[str, str] = {}
              for token in tokens:
                  if "=" not in token:
                      raise ExposureError(f"invalid {label} token at line {line_number}: {token!r}")
                  key, value = token.split("=", 1)
                  if key in fields:
                      raise ExposureError(f"duplicate {label} field at line {line_number}: {key}")
                  fields[key] = value
              unknown = sorted(set(fields) - allowed)
              missing = sorted(required - set(fields))
              if unknown:
                  raise ExposureError(f"unknown {label} fields at line {line_number}: {unknown}")
              if missing:
                  raise ExposureError(f"missing {label} fields at line {line_number}: {missing}")
              return fields
            
          #@MNX-PART id=40.31.mnx-exposure.parse-policy-text.function.safe-patterns kind=function title="Python nested function safe_patterns"
          def safe_patterns(value: str, line_number: int, field: str) -> list[str]:
              patterns = split_csv(value)
              for pattern in patterns:
                  if pattern == "*":
                      continue
                  if not SAFE_GLOB_RE.fullmatch(pattern) or ".." in pattern:
                      raise ExposureError(f"unsafe {field} pattern at line {line_number}: {pattern!r}")
              return patterns
            
          zones: list[dict[str, Any]] = []
          entries: list[dict[str, Any]] = []
          zone_ids: set[str] = set()
          entry_ids: set[str] = set()
          for line_number, line in enumerate(lines[begin[0] + 1 : end[0]], start=begin[0] + 2):
              if not line.strip():
                  continue
              zone_match = ZONE_RE.fullmatch(line)
              entry_match = ENTRY_RE.fullmatch(line)
              if zone_match:
                  fields = parse_fields(
                      zone_match.group(1), line_number,
                      allowed=ALLOWED_ZONE_FIELDS, required=REQUIRED_ZONE_FIELDS, label="zone",
                  )
                  zone_id = fields["id"]
                  if not ID_RE.fullmatch(zone_id) or zone_id in zone_ids:
                      raise ExposureError(f"invalid or duplicate zone id at line {line_number}: {zone_id!r}")
                  zone_ids.add(zone_id)
                  addresses = set(split_csv(fields["address"]))
                  if not addresses <= ADDRESS_CLASSES:
                      raise ExposureError(f"invalid zone address classes for {zone_id}: {sorted(addresses - ADDRESS_CLASSES)}")
                  if fields["bind_policy"] not in BIND_POLICIES:
                      raise ExposureError(f"invalid bind policy for zone {zone_id}: {fields['bind_policy']!r}")
                  if fields["enforcement"] not in ZONE_ENFORCEMENT:
                      raise ExposureError(f"invalid enforcement for zone {zone_id}: {fields['enforcement']!r}")
                  interface_patterns = safe_patterns(fields["interfaces"], line_number, "interfaces")
                  source_values = split_csv(fields["sources"])
                  for source_value in source_values:
                      if source_value in {"any", "local-host", "link-local"}:
                          continue
                      try:
                          ipaddress.ip_network(source_value, strict=False)
                      except ValueError as exc:
                          raise ExposureError(f"invalid source prefix for zone {zone_id}: {source_value!r}") from exc
                  zones.append({
                      **fields,
                      "line": line_number,
                      "address_classes": sorted(addresses),
                      "interface_patterns": interface_patterns,
                      "source_values": source_values,
                  })
                  continue
              if entry_match:
                  fields = parse_fields(
                      entry_match.group(1), line_number,
                      allowed=ALLOWED_ENTRY_FIELDS, required=REQUIRED_ENTRY_FIELDS, label="exposure",
                  )
                  entry_id = fields["id"]
                  if not ID_RE.fullmatch(entry_id) or entry_id in entry_ids:
                      raise ExposureError(f"invalid or duplicate exposure id at line {line_number}: {entry_id!r}")
                  entry_ids.add(entry_id)
                  protocols = set(split_csv(fields["proto"]))
                  if not protocols <= PROTOCOLS:
                      raise ExposureError(f"invalid protocols for {entry_id}: {sorted(protocols - PROTOCOLS)}")
                  addresses = set(split_csv(fields["address"]))
                  if not addresses <= ADDRESS_CLASSES:
                      raise ExposureError(f"invalid address classes for {entry_id}: {sorted(addresses - ADDRESS_CLASSES)}")
                  netns = set(split_csv(fields["netns"]))
                  if not netns <= NETNS_CLASSES:
                      raise ExposureError(f"invalid network namespace classes for {entry_id}: {sorted(netns - NETNS_CLASSES)}")
                  if fields["disposition"] not in DISPOSITIONS:
                      raise ExposureError(f"invalid disposition for {entry_id}: {fields['disposition']!r}")
                  if fields["required"] not in {"yes", "no"}:
                      raise ExposureError(f"invalid required flag for {entry_id}: {fields['required']!r}")
                  if fields["volatility"] not in VOLATILITY_CLASSES:
                      raise ExposureError(f"invalid volatility for {entry_id}: {fields['volatility']!r}")
                  for key in ("intent", "zone"):
                      if not ID_RE.fullmatch(fields[key]):
                          raise ExposureError(f"invalid {key} slug for {entry_id}: {fields[key]!r}")
                  entries.append({
                      **fields,
                      "line": line_number,
                      "protocols": sorted(protocols),
                      "port_ranges": parse_ports(fields["port"]),
                      "address_classes": sorted(addresses),
                      "netns_classes": sorted(netns),
                      "interface_patterns": safe_patterns(fields["interfaces"], line_number, "interfaces"),
                      "unit_patterns": safe_patterns(fields["unit"], line_number, "unit"),
                      "process_patterns": safe_patterns(fields["process"], line_number, "process"),
                      "package_patterns": safe_patterns(fields["package"], line_number, "package"),
                      "cgroup_patterns": safe_patterns(fields["cgroup"], line_number, "cgroup"),
                      "mode_patterns": safe_patterns(fields["mode"], line_number, "mode"),
                      "required_bool": fields["required"] == "yes",
                  })
                  continue
              raise ExposureError(f"unexpected exposure policy line {line_number}: {line!r}")
            
          if not zones:
              raise ExposureError("exposure policy contains no zones")
          if not entries:
              raise ExposureError("exposure policy contains no entries")
          for required_zone in ("loopback", "admin-lan", "lan-services", "public-p2p", "host-control", "review"):
              if required_zone not in zone_ids:
                  raise ExposureError(f"required exposure zone is absent: {required_zone}")
          for entry in entries:
              if entry["zone"] not in zone_ids:
                  raise ExposureError(f"exposure entry {entry['id']} references unknown zone {entry['zone']}")
          zone_by_id = {zone["id"]: zone for zone in zones}
          policy_payload = {
              "schema": POLICY_SCHEMA,
              "zone_schema": ZONE_SCHEMA,
              "policy_mode": "observe-only",
              "default_disposition": "review",
              "zones": [
                  {key: value for key, value in zone.items() if key in REQUIRED_ZONE_FIELDS}
                  for zone in zones
              ],
              "entries": [
                  {key: value for key, value in entry.items() if key in REQUIRED_ENTRY_FIELDS}
                  for entry in entries
              ],
          }
          return {
              "schema": POLICY_SCHEMA,
              "zone_schema": ZONE_SCHEMA,
              "policy_mode": "observe-only",
              "default_disposition": "review",
              "zones": zones,
              "zone_by_id": zone_by_id,
              "entries": entries,
              "policy_sha256": sha256_bytes(canonical_json(policy_payload)),
          }
            
      #@MNX-PART id=40.31.mnx-exposure.function.parse-policy kind=function title="Python function parse_policy"
      def parse_policy(path: pathlib.Path) -> dict[str, Any]:
          try:
              text = path.read_text(encoding="utf-8")
          except (OSError, UnicodeDecodeError) as exc:
              raise ExposureError(f"cannot read exposure policy source: {path}: {exc}") from exc
          return parse_policy_text(text)
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.parse-endpoint kind=function title="Python function parse_endpoint"
      def parse_endpoint(value: str) -> tuple[str, int]:
          raw = value.strip()
          if raw.startswith("["):
              close = raw.find("]")
              if close < 0:
                  raise ExposureError(f"unparseable bracketed listener endpoint: {value!r}")
              host = raw[1:close]
              suffix = raw[close + 1 :]
              scope = ""
              if suffix.startswith("%"):
                  scope, separator, port_text = suffix[1:].rpartition(":")
                  if not separator or not scope or any(character.isspace() for character in scope):
                      raise ExposureError(f"unparseable scoped bracketed listener endpoint: {value!r}")
              elif suffix.startswith(":"):
                  port_text = suffix[1:]
              else:
                  raise ExposureError(f"unparseable bracketed listener endpoint: {value!r}")
              if scope:
                  if "%" in host:
                      raise ExposureError(f"listener endpoint has duplicate IPv6 scope identifiers: {value!r}")
                  host = f"{host}%{scope}"
          else:
              host, separator, port_text = raw.rpartition(":")
              if not separator:
                  raise ExposureError(f"unparseable listener endpoint: {value!r}")
          if not port_text.isdigit():
              raise ExposureError(f"listener port is not numeric: {value!r}")
          port = int(port_text)
          if port < 0 or port > 65535:
              raise ExposureError(f"listener port is out of range: {value!r}")
          return host or "*", port
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.classify-address kind=function title="Python function classify_address"
      def classify_address(host: str) -> str:
          clean = host.strip().strip("[]")
          if "%" in clean:
              clean = clean.split("%", 1)[0]
          if clean in {"", "*", "0.0.0.0", "::"}:
              return "wildcard"
          try:
              address = ipaddress.ip_address(clean)
          except ValueError:
              return "unknown"
          if address.is_loopback:
              return "loopback"
          if address.is_multicast:
              return "multicast"
          if address.is_link_local:
              return "link-local"
          if address.is_private:
              return "lan"
          return "public"
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.interface-map kind=function title="Python function interface_map"
      def interface_map() -> dict[str, list[str]]:
          mapping: dict[str, list[str]] = {}
          try:
              payload = json.loads(run(["ip", "-j", "address", "show"], check=True))
          except (ExposureError, json.JSONDecodeError):
              return mapping
          for item in payload:
              name = str(item.get("ifname", "unknown"))
              for address in item.get("addr_info", []):
                  local = str(address.get("local", ""))
                  if local:
                      mapping.setdefault(local, []).append(name)
          for names in mapping.values():
              names.sort()
          return mapping
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.interface-lookup-address kind=function title="Python function interface_lookup_address"
      def interface_lookup_address(host: str) -> str:
          clean = host.strip().strip("[]")
          if "%" in clean:
              clean = clean.split("%", 1)[0]
          try:
              address = ipaddress.ip_address(clean)
          except ValueError:
              return clean
          if isinstance(address, ipaddress.IPv6Address) and address.ipv4_mapped is not None:
              return str(address.ipv4_mapped)
          return str(address)
      
      
      #@MNX-PART id=40.31.mnx-exposure.function.host-netns-inode kind=function title="Python function host_netns_inode"
      def host_netns_inode() -> int | None:
          try:
              return os.stat("/proc/1/ns/net").st_ino
          except OSError:
              return None
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.package-identity kind=function title="Python function package_identity"
      def package_identity(executable: str) -> tuple[str, str]:
          if not executable:
              return "unknown", "unknown"
          match = STORE_RE.match(executable)
          if match:
              package = match.group("package")
              binary = pathlib.PurePosixPath(executable).name
              return package, f"nix:{package}:{binary}"
          binary = pathlib.PurePosixPath(executable).name or "unknown"
          if executable.startswith("/home/"):
              return "home", f"home:{binary}"
          if executable.startswith("/run/") or executable.startswith("/usr/") or executable.startswith("/bin/"):
              return "system", f"system:{binary}"
          return "other", f"other:{binary}"
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.derive-unit kind=function title="Python function derive_unit"
      def derive_unit(cgroup: str) -> str:
          components = [item for item in cgroup.split("/") if item]
          for suffix in (".service", ".scope", ".socket"):
              for component in reversed(components):
                  if component.endswith(suffix):
                      return component
          return "unknown"
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.process-identity kind=function title="Python function process_identity"
      def process_identity(
          pid: int,
          host_netns: int | None,
          cache: dict[int, dict[str, Any]],
          unit_cache: dict[str, tuple[list[str], str]],
      ) -> dict[str, Any]:
          if pid in cache:
              return cache[pid]
          if len(cache) >= MAX_OWNER_PIDS:
              raise ExposureError(f"listener owner PID ceiling exceeded: {MAX_OWNER_PIDS}")
          root = pathlib.Path("/proc") / str(pid)
          result: dict[str, Any] = {
              "pid": pid,
              "uid": "unknown",
              "comm": "unknown",
              "executable_id": "unknown",
              "package": "unknown",
              "cgroup": "unknown",
              "unit": "unknown",
              "netns_inode": "unknown",
              "netns_class": "unknown",
              "socket_units": [],
              "socket_lookup": "not-applicable",
          }
          try:
              status = (root / "status").read_text(encoding="utf-8", errors="replace")
              uid_match = re.search(r"(?m)^Uid:\s+([0-9]+)", status)
              if uid_match:
                  result["uid"] = int(uid_match.group(1))
          except OSError:
              pass
          try:
              result["comm"] = (root / "comm").read_text(encoding="utf-8", errors="replace").strip() or "unknown"
          except OSError:
              pass
          try:
              executable = os.path.realpath(root / "exe")
          except OSError:
              executable = ""
          package, executable_id = package_identity(executable)
          result["package"] = package
          result["executable_id"] = executable_id
          cgroup = ""
          try:
              for line in (root / "cgroup").read_text(encoding="utf-8", errors="replace").splitlines():
                  fields = line.split(":", 2)
                  if len(fields) == 3 and fields[0] == "0":
                      cgroup = fields[2]
                      break
          except OSError:
              pass
          result["cgroup"] = cgroup or "unknown"
          result["unit"] = derive_unit(cgroup)
          try:
              inode = os.stat(root / "ns/net").st_ino
              result["netns_inode"] = inode
              if host_netns is None:
                  result["netns_class"] = "unknown"
              elif inode == host_netns:
                  result["netns_class"] = "host"
              else:
                  result["netns_class"] = "nonhost"
          except OSError:
              pass
          if result["unit"] != "unknown":
              unit = str(result["unit"])
              if unit in unit_cache:
                  socket_units, lookup_state = unit_cache[unit]
              elif len(unit_cache) >= MAX_SYSTEMD_UNIT_LOOKUPS:
                  socket_units, lookup_state = [], "skipped-limit"
              else:
                  try:
                      triggered = run(
                          ["systemctl", "show", unit, "-p", "TriggeredBy", "--value", "--no-pager"],
                          timeout=3,
                          check=False,
                      ).strip()
                      socket_units = sorted(item for item in triggered.split() if item.endswith(".socket"))
                      lookup_state = "queried"
                  except ExposureError:
                      socket_units, lookup_state = [], "unavailable"
                  unit_cache[unit] = (socket_units, lookup_state)
              result["socket_units"] = list(socket_units)
              result["socket_lookup"] = lookup_state
          cache[pid] = result
          return result
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.parse-ss-line kind=function title="Python function parse_ss_line"
      def parse_ss_line(
          line: str,
          interfaces: dict[str, list[str]],
          host_netns: int | None,
          cache: dict[int, dict[str, Any]],
          unit_cache: dict[str, tuple[list[str], str]],
      ) -> dict[str, Any]:
          parts = line.split(maxsplit=6)
          if len(parts) < 6:
              raise ExposureError(f"unparseable ss listener line: {line!r}")
          proto_raw, state, _recv_q, _send_q, local, peer = parts[:6]
          process_text = parts[6] if len(parts) == 7 else ""
          protocol = "tcp" if proto_raw.startswith("tcp") else "udp" if proto_raw.startswith("udp") else proto_raw
          if protocol not in {"tcp", "udp"}:
              raise ExposureError(f"unsupported listener protocol: {proto_raw!r}")
          host, port = parse_endpoint(local)
          address_class = classify_address(host)
          clean_host = host.strip("[]")
          scope_interface = ""
          if "%" in clean_host:
              clean_host, scope_interface = clean_host.rsplit("%", 1)
          if address_class == "wildcard":
              interface_names = ["*"]
          elif scope_interface:
              interface_names = [scope_interface]
          else:
              interface_names = interfaces.get(interface_lookup_address(clean_host), [])
          owners: list[dict[str, Any]] = []
          seen_pids: set[int] = set()
          for match in SS_OWNER_RE.finditer(process_text):
              pid = int(match.group("pid"))
              if pid in seen_pids:
                  continue
              seen_pids.add(pid)
              owner = dict(process_identity(pid, host_netns, cache, unit_cache))
              if owner.get("comm") == "unknown":
                  owner["comm"] = match.group("comm").replace('\\"', '"')
              owners.append(owner)
          owners.sort(key=lambda item: (str(item.get("unit")), str(item.get("comm")), int(item.get("pid", 0))))
          # `ss` was executed in the host network namespace. An unattributed socket is still a host-netns socket.
          netns_classes = sorted({str(item.get("netns_class", "unknown")) for item in owners}) or ["host"]
          return {
              "protocol": protocol,
              "state": state,
              "local_address": host,
              "local_port": port,
              "peer": peer,
              "address_class": address_class,
              "interfaces": interface_names,
              "owners": owners,
              "netns_classes": netns_classes,
              "raw_process_present": bool(process_text),
              "raw_row_count": 1,
          }
            
            
      #@MNX-PART id=40.31.mnx-exposure.function.owner-stable-key kind=function title="Python function owner_stable_key"
      def owner_stable_key(owner: dict[str, Any]) -> tuple[Any, ...]:
          return (
              owner.get("uid", "unknown"),
              owner.get("comm", "unknown"),
              owner.get("unit", "unknown"),
              owner.get("package", "unknown"),
              owner.get("executable_id", "unknown"),
              owner.get("cgroup", "unknown"),
              owner.get("netns_class", "unknown"),
              owner.get("netns_inode", "unknown"),
              tuple(owner.get("socket_units", [])),
              owner.get("socket_lookup", "unknown"),
          )
            
            
      #@MNX-PART id=40.31.mnx-exposure.function.endpoint-key kind=function title="Python function endpoint_key"
      def endpoint_key(listener: dict[str, Any]) -> tuple[Any, ...]:
          return (
              listener["protocol"],
              listener["local_address"],
              int(listener["local_port"]),
              listener["address_class"],
              tuple(listener.get("interfaces", [])),
