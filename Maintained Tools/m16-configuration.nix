  #virtualisation.waydroid.enable = true; # Enable Waydroid virtualization
#@MNX-DEF path=programs.sysdig.enable section=20.20 role=policy ordinal=011
  programs.sysdig.enable = false; # Unused; deep tracing remains operator-explicit.
#@MNX-DEF path=services.xserver.videoDrivers section=20.20 role=policy ordinal=012
