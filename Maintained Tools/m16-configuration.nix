              root_stat=resolved.lstat()
          except OSError as exc:
              raise Error(f'closed-tree root unavailable: {root}: {exc}') from exc
          if stat.S_ISLNK(root_stat.st_mode) or not stat.S_ISDIR(root_stat.st_mode):
              raise Error(f'closed-tree root is not a non-symlink directory: {resolved}')
