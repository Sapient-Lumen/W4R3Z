#@MNX-PART id=90.00.monsterdesk.function.f023u-stationary-config kind=function title="Python function nicotine_stationary_config_identity"
def nicotine_stationary_config_identity() -> dict[str, Any]:
    raw, metadata = stable_regular_read(
        EXPECTED_NICOTINE_CONFIG_PATH, MAX_NICOTINE_CONFIG_BYTES, expected_uid=USER_UID
    )
    configured = parse_nicotine_config(raw, data_path=EXPECTED_NICOTINE_DATA_PATH)
    if configured.get("listen_port_range") != [EXPECTED_NICOTINE_PORT, EXPECTED_NICOTINE_PORT]:
        raise MonsterdeskError("stationary Nicotine config changed the transfer port")
    server = configured.get("server", {})
    if (server.get("host"), server.get("port")) != EXPECTED_NICOTINE_SERVER:
        raise MonsterdeskError("stationary Nicotine config changed the server endpoint")
    shares = sorted(
        (str(item.get("virtual_name", "")), str(item.get("path", "")))
        for item in configured.get("paths", []) if str(item.get("kind", "")).endswith("share")
    )
    if shares != sorted(EXPECTED_NICOTINE_SHARES):
        raise MonsterdeskError("stationary Nicotine config changed the reviewed share set")
    by_kind = {str(item.get("kind")): str(item.get("path")) for item in configured.get("paths", [])
               if not str(item.get("kind", "")).endswith("share")}
    if by_kind != {
        "download-dir": str(EXPECTED_NICOTINE_DOWNLOAD),
        "incomplete-dir": str(EXPECTED_NICOTINE_INCOMPLETE),
        "received-dir": str(EXPECTED_NICOTINE_RECEIVED),
    }:
        raise MonsterdeskError("stationary Nicotine config changed the reviewed transfer paths")
    return {
        "sha256": metadata["sha256"], "bytes": metadata["bytes"], "mode": metadata["mode"],
        "upnp": configured.get("upnp"),
        "auto_connect_startup": configured.get("auto_connect_startup"),
        "semantic_boundary_matched": True,
    }


