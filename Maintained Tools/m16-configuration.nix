      #@MNX-PART id=99.20.mnx-switch.function.latest_switch_report kind=function title="Function latest_switch_report"
      latest_switch_report() {
        local result
        result="$(readlink -f "$REPORT_DIR/mnx-switch-latest.txt" 2>/dev/null || true)"
        if [[ -z "$result" || ! -f "$result" ]] || ! grep -q '^mnx_switch_result=' "$result" 2>/dev/null; then
          result="$(find "$REPORT_DIR" -maxdepth 1 -type f -name 'mnx-switch-*.txt' -printf '%T@ %p\n' 2>/dev/null | sort -nr | while IFS=' ' read -r _ file; do grep -q '^mnx_switch_result=' "$file" 2>/dev/null && { printf '%s\n' "$file"; break; }; done)"
        fi
        printf '%s\n' "$result"
      }

      #@MNX-PART id=99.20.mnx-switch.function.process_cmdline kind=function title="Function process_cmdline"
      process_cmdline() {
        local pid="$1"
        [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]] || return 1
        tr '\0' ' ' < "/proc/$pid/cmdline"
      }

      #@MNX-PART id=99.20.mnx-switch.function.process_is_mnx_switch kind=function title="Function process_is_mnx_switch"
      process_is_mnx_switch() {
        local pid="$1" cmd
        cmd="$(process_cmdline "$pid" 2>/dev/null || true)"
        [[ "$cmd" == *mnx-switch* || "$cmd" == *"mnx switch"* ]]
      }

      #@MNX-PART id=99.20.mnx-switch.function.secure_evidence_file kind=function title="Function secure_evidence_file"
      secure_evidence_file() {
        local file="$1" expected_uid mode mode_decimal uid
        [[ -f "$file" && ! -L "$file" ]] || return 1
        expected_uid="''${MNX_SWITCH_SELF_TEST_UID:-0}"
        uid="$(stat -c '%u' "$file" 2>/dev/null || true)"
        [[ "$uid" == "$expected_uid" ]] || return 1
        mode="$(stat -c '%a' "$file" 2>/dev/null || true)"
        [[ "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
        mode_decimal=$((8#$mode))
        (( (mode_decimal & 0022) == 0 )) || return 1
      }

      #@MNX-PART id=99.20.mnx-switch.function.find_latest_matching_test kind=function title="Function find_latest_matching_test"
      find_latest_matching_test() {
        local source_sha="$1" stamp report candidate_sha
        while IFS=' ' read -r stamp report; do
          [[ -n "$report" && -f "$report" ]] || continue
          grep -Eq '^(mnx_test_result|mnx_bootstrap_test_result)=' "$report" 2>/dev/null || continue
          candidate_sha="$(sed -n -E 's/^(candidate_configuration_sha256|candidate_sha256)=//p' "$report" | tail -n 1)"
          [[ "$candidate_sha" == "$source_sha" ]] || continue
          printf '%s\n' "$report"
          return 0
        done < <(
          find "$REPORT_DIR" -maxdepth 1 -type f \
            \( -name 'mnx-test-*.txt' -o -name 'mnx-bootstrap-test-*.txt' \) \
            -printf '%T@ %p\n' 2>/dev/null | sort -nr
        )
        return 1
      }

