          [[ -n "$LATEST" && -r "$LATEST" ]] || { echo 'no completed MNX test transcript exists' >&2; exit 1; }
          CANDIDATE="$(${pkgs.gnused}/bin/sed -n -E 's/^(candidate_snapshot|candidate)=//p' "$LATEST" | ${pkgs.coreutils}/bin/tail -n 1)"
          [[ -n "$CANDIDATE" && -r "$CANDIDATE" ]] || { echo 'the newest completed test has no readable candidate' >&2; exit 1; }
          printf 'candidate=%s\n' "$CANDIDATE"
          exec ${pkgs.coreutils}/bin/sha256sum "$CANDIDATE"
          ;;
        rsync-summary)
          exec /etc/monsternix/bin/mnx-rsync-log-report summary "$@"
          ;;
        hash)
          exec ${pkgs.coreutils}/bin/sha256sum /etc/nixos/configuration.nix
          ;;
        office)
          OFFICE_COMMAND="''${1:-resume}"
          (( $# == 0 )) || shift
          case "$OFFICE_COMMAND" in
            resume|status) exec /etc/monsternix/bin/mnx-office resume "$@" ;;
            json|--json) exec /etc/monsternix/bin/mnx-office resume --json "$@" ;;
            verify) exec /etc/monsternix/bin/mnx-office verify "$@" ;;
            agenda) exec /etc/monsternix/bin/mnx-office agenda "$@" ;;
            health-evidence) exec /etc/monsternix/bin/mnx-office health-evidence "$@" ;;
            static|source) exec ${pkgs.gnused}/bin/sed -n '/^# SECTION 01 —/,/^# SECTION 10 —/p' /etc/nixos/configuration.nix ;;
            *) printf 'unknown mnx office command: %s\n' "$OFFICE_COMMAND" >&2; exit 64 ;;
          esac
          ;;
        version|identity)
          printf 'configuration_sha256=%s\n' "$(${pkgs.coreutils}/bin/sha256sum /etc/nixos/configuration.nix | ${pkgs.gawk}/bin/awk '{print $1}')"
          printf 'running_system=%s\n' "$(${pkgs.coreutils}/bin/readlink -f /run/current-system 2>/dev/null || true)"
          printf 'default_system=%s\n' "$(${pkgs.coreutils}/bin/readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)"
          /etc/monsternix/bin/mnx-behavior-manifest status 2>/dev/null || true
          ;;
        help|-h|--help)
          cat <<'USAGE'
      mnx — Monsternix operator command

      The officer wake entrypoint:
        mnx / mnx wake             verify and classify exact identity before advice; one screen, read-only
        mnx brief --full           progressively disclose the detailed epistemic handoff
        mnx brief --json           machine-readable wake, office, runtime, health, and evidence state

      The two routine operator commands:
        mnx test [OPTIONS]         temporarily activate and validate the exact candidate
        mnx switch                 permanently activate only that exact successfully tested candidate

      Candidate evaluation and permanent-activation recovery:
        mnx candidate-test          force the source-embedded candidate-owned repair/bootstrap harness
        mnx test-status            show the live phase, child PID, and current transcript
        mnx test-cancel            request a signal-safe cancellation and conditional rollback
        mnx test-recover           recover a stale/SIGKILL orphan and restore the prior closure
        mnx test-summary           newest final machine-readable result markers
        mnx test-errors            newest failure markers, error contexts, and rebuild tail
        mnx test-raw [PHASE]       raw rebuild/source/post/support/contract/state sidecar log
        mnx switch-status          live permanent-switch phase and newest result
        mnx switch-cancel          signal-safe cancellation and rollback request
        mnx switch-recover         hard-kill/orphan recovery to prior boot default
        mnx switch-summary         newest permanent-switch result markers
        mnx switch-errors          newest failure context
        mnx switch-raw [PHASE]     raw switch activation/audit/baseline/support/state log
        mnx source-audit           source/parser/polyglot validation without activation
        mnx audit                  post-switch runtime audit
        mnx full                   audit plus nixos-rebuild dry-build --show-trace

      Monolith navigation and reversible source workbench:
        mnx map                         hierarchical chunk and definition atlas
        mnx defs [FILTER]               list top-level assignments and their internal-part counts
        mnx def PATH                    print one exact top-level assignment
        mnx parts [DEF]                 list internal function/phase/class/category footholds
        mnx part ID                     print one exact internal part
        mnx search REGEX                search with chunk, definition, and internal-part context
        mnx relations                   list explicit operational flows and non-negotiable laws
        mnx flow ID                     show one flow, its paths/state/lock, and exact definitions
        mnx law ID                      show one law, enforcement notes, and exact definitions
        mnx related TEXT                find definitions, flows, and laws touching a concept
        mnx explain TARGET              explain an exact flow, law, or definition
        mnx graph [FLOW]                render all or one flow as a stable text graph
        mnx loops [summary|full]        transaction-scoped PID 1 manager-loop census and attribution
        mnx temp [--show]               candidate-only Section-98 region status
        mnx chunk ID                    print one exact chunk
        mnx humpty verify               exact split/join byte-roundtrip proof
        mnx humpty manifest             complete JSON manifest for machine parsing
        mnx humpty split                create a disposable chunk workspace under /tmp
        mnx humpty join DIR --out FILE  reassemble a workspace and Nix-parse the result
        mnx humpty bundle               uploadable full-source plus exact-chunks tar.gz

      Behavior-preserving refactor and planning:
        mnx refactor frontier           rank low-coupling definitions; heuristic, never permission
        mnx port review SOURCE           bounded read-only foreign-source classification; no execution or mutation
        mnx eject plan [--json] [--full] [SOURCE]
                                     exact keep/remove/transform inventory plus preview identity; publish nothing
        mnx eject transforms [--json] [--full] [SOURCE]
                                     inspect all body-hash-bound mixed-definition transformation contracts
        mnx eject preview [--json] [--show] [SOURCE]
                                     generate and Nix-parse a nonpersistent ordinary-module preview; --show is stdout only
        mnx eject self-test             adversarial private fixture and transformation-strategy proof
        mnx eject verify [SOURCE]       run fixture, exact contract, preview, and real-source plan proofs
        mnx eject publish               deliberately refused while behavior witnesses remain incomplete
        mnx upgrade policy               offline immutable cross-series target and mutation-boundary contract
        mnx upgrade check                networked official-feed and pinned-release identity check; no persistent write
        mnx upgrade build                freeze exact source and build one manifested closure without activation/profile mutation
        mnx upgrade status               independently verify and summarize newest upgrade-build evidence
        mnx upgrade evidence [--full]    newest bounded release/build/diff evidence
        mnx upgrade test|switch          deliberately refused until exact activation/promotion semantics are accepted
        mnx desktop policy [--json]       source-declared maintained font, Fontconfig, GTK, dconf, and portal policy
        mnx desktop audit [--json]        read-only live font-family and GTK/XDG baseline verification
        mnx desktop self-test             pure family classifier and policy JSON contract test
        mnx exposure                     compact attributed listener/exposure summary
        mnx exposure refresh             elevate through the hardened listener service, then summarize
        mnx exposure full                canonical endpoints plus grouped unresolved review ledger
        mnx exposure review              grouped unresolved listeners by stable owner/purpose
        mnx exposure zones               source-owned observe-only zone model
        mnx exposure policy              source-owned zones and intent records
        mnx refactor impact DEF         show direct/reverse references, flows, laws, and behavior surfaces
        mnx refactor plan DEF           produce a bounded edit/test plan for one definition
        mnx refactor plan --chunk ID    produce a subsystem-scoped plan
        mnx refactor workspace create NAME DEF... [--chunk ID]
                                       create a root-owned disposable exact-slice workspace
        mnx refactor prepare            verify, bundle, map, capture, and pin pre-refactor behavior
        mnx refactor verify             exact source roundtrip plus pinned behavior comparison
        mnx refactor status             source/runtime/baseline/chunk-map state
        mnx baseline capture pre-refactor --pin
        mnx baseline compare
        mnx baseline status
        mnx baseline show

      Foundation handoff and evidence:
        mnx doctor [--json] [--require TIER]
                                   map entry, inspect, source, runtime, office, transaction, and m16-machine capability tiers without mutation
        mnx brief [--full] [--json] [--save]
                                   compact wake by default; --full discloses detail; --save creates one manifested support bundle
        mnx evidence verify [BUNDLE]
                                   independently verify canonical contained regular-file hashes; execute no payload
        mnx evidence latest        show the newest manifested boot, incident, or support bundle
        mnx evidence list [LIMIT]  list recent manifested evidence bundles
        mnx evidence office        independently verify the accepted office record against the active/default source
        mnx capsule policy         show the nonexecuting capsule authority contract
        mnx capsule inspect SOURCE bounded stable byte identity, media, mode, and symlink evidence; execute nothing
        mnx capsule verify SOURCE --sha256 HASH --bytes N [--media TYPE]
                                   require an exact operator-supplied byte identity; matching does not authorize execution
        mnx capsule self-test      adversarial private proof that inspection never runs the payload
        mnx substrate status       observe the current NixOS/Linux/systemd adapter without mutation or network use
        mnx substrate contract     portable protocol/evidence inventory and required migration witnesses
        mnx substrate reconstruction
                                   exact-source reconstruction order, adapter boundaries, and witness curriculum
        mnx substrate backup-soak  bounded local Restic/Btrfs state review; no job run, secret read, or retirement authority
        mnx substrate self-test    deterministic private contract/reconstruction/soak proof; migration remains unavailable
        mnx cloudtainer policy     source-owned authority and packet-containment contract
        mnx cloudtainer status     exact source/capsule/office/runtime command-center state, read-only
        mnx cloudtainer candidate  contained complete-source workspace, check, review, diff, controlled handoff injection, and proposal package
        mnx cloudtainer pack       explicit manifested reconstruction packet plus deterministic archive for a ChatGPT cloud container
        mnx cloudtainer self-test  private packet, portable-helper, manifest, and malformed-capsule regression
        mnx incident journal status    show current clean/review/malfunction classification without re-verifying
        mnx incident journal verify    run both namespace verifiers, publish manifested evidence, and return success for clean or review
        mnx incident journal evidence  print the latest bounded verifier evidence; --full deliberately prints all retained output

      m21 Restic enrollment, qualification, and fail-closed automatic scheduling:
        mnx restic policy               exact authority, phase, and gated-cutover contract
        mnx restic status               enrollment, timers, accepted path, and manifested run state
        mnx restic enroll adoption-preflight
                                        verify the existing pull identity, host pin, and fail-closed local state
        mnx restic qualify begin        bind one run to exact accepted source and closure
        mnx restic qualify backup       prove exactly one new snapshot; run twice, second has bounded apparent growth
        mnx restic cleanup-witness-instructions
                                        explain the locally fetched bounded m21 success/failure cleanup receipt
        mnx restic qualify failure-expected --switch-owned-interrupted-export
        mnx restic qualify recover --switch-owned
        mnx restic qualify check        retain a local Restic check receipt
        mnx restic qualify restore      verified restore into one exact private disposable target
        mnx restic qualify restore-accept --switch-owned-machine-verified
        mnx restic qualify restore-clean --confirm-destroy-disposable-restore
        mnx restic qualify finalize --switch-owned
                                        require every exact phase once and authorize the gated marker
        mnx restic qualify complete-and-enable --switch-owned
                                        switch-only one-shot continuation; enable timers only after every proof

      Diagnostics and identity:
        mnx status                 deliberately short current machine/backup/test summary
        mnx health                 run the storage-state snapshot and print truthful domain metrics
        mnx support                bounded paste-ready support report
        mnx m21-identity           strict host-key/hostname/helper/source-UUID verification
        mnx m21-enroll             explicit fingerprint-checked enrollment of missing endpoint ED25519 keys
        mnx btrfs-baseline status  per-device, per-counter evidence and pinned-baseline comparison
        mnx last-test              complete newest MNX test transcript
        mnx last-candidate         exact source frozen by the newest test
        mnx rsync-summary          summarized new-storage -> old-storage rsync history
        mnx hash                   SHA-256 of /etc/nixos/configuration.nix
        mnx office                 verified bounded amnesiac-successor resume packet
        mnx office --json          same packet as strict machine-readable JSON
        mnx office static          print source-owned ChatGPT Sections 01 through 09
        mnx identity               source hash, closures, and behavior-baseline state

      mnx apply [--allow-behavior-change]
        run the same test and conditional switch with Presslog-guarded initial sudo authentication;
        invoke as h0p3, without an outer sudo; no automatic capture resume and no new sudo permission.

      Bare `mnx` is the officer cold-start. Routine mutation workflow is `mnx test`, then `mnx switch`. Complete raw phase logs are always
      saved; success output is compact by default. Use `mnx test -v --support=always` only when you
      deliberately want everything streamed. Ctrl-C is an interruption result, not a fake rebuild
      failure, and optional support-report cancellation after core validation does not invalidate it.
      `mnx test-recover` is the exceptional hard-kill/orphan cleanup path; ordinary Ctrl-C needs none.
      `mnx office` is the continuity handoff for an amnesiac successor and must validate before it speaks.
      USAGE
          ;;
        *)
          printf 'unknown mnx command: %s\n\n' "$COMMAND" >&2
          "$0" help >&2 || true
          exit 64
          ;;
      esac
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            "$out" status-self-test
            "$out" ejection-dispatch-self-test
            "$out" command-surface-self-test
            "$out" officer-wake-self-test
            "$out" foundation-port-self-test
            "$out" desktop self-test
            ;;
          '#!'*python*)
            ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
            ;;
          *)
            echo "unsupported generated-script interpreter: $first" >&2
            exit 1
            ;;
        esac
      '';
    };
  };


#@MNX-CHUNK id=99.20 slug=mnx-switch-transaction title="Exact-tested-closure permanent switch transaction and recovery"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-switch" section=99.20 role=generated-program ordinal=267
  environment.etc."monsternix/bin/mnx-switch" = {
    source = pkgs.writeTextFile {
      name = "mnx-switch";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      export PATH=/run/wrappers/bin:${pkgs.bash}/bin:${pkgs.coreutils}/bin:${pkgs.findutils}/bin:${pkgs.gawk}/bin:${pkgs.gnugrep}/bin:${pkgs.gnused}/bin:${pkgs.util-linux}/bin:${pkgs.systemd}/bin:${pkgs.nix}/bin:${pkgs.procps}/bin:/run/current-system/sw/bin
      set -Eeuo pipefail
      export LC_ALL=C SYSTEMD_PAGER=cat SYSTEMD_COLORS=0 PAGER=cat
      umask 027

      MNX_SWITCH_IMPLEMENTATION_VERSION=13
      CONFIG_AUDIT_BIN=/etc/monsternix/bin/mnx-config-audit
      RAW_ARGS=("$@")
      SUBCOMMAND="''${1:-switch}"
      case "$SUBCOMMAND" in
        switch|status|cancel|recover|summary|errors|raw|self-test|help|-h|--help)
          shift || true
          ;;
        --*)
          SUBCOMMAND=switch
          ;;
        *)
          printf 'unknown mnx switch command: %s\n' "$SUBCOMMAND" >&2
          exit 64
          ;;
      esac

      CFG="''${MNX_SWITCH_CONFIG:-/etc/nixos/configuration.nix}"
      REPORT_DIR="''${MNX_SWITCH_REPORT_DIR:-/var/lib/logbook/support}"
      RUNTIME_DIR="''${MNX_SWITCH_RUNTIME_DIR:-/run/monsternix}"
      RUNTIME_STATE="$RUNTIME_DIR/mnx-switch.current"
      SUPPORT_POLICY=failure
      VERBOSE=0
      ROLLBACK_ON_FAILURE=1
      SWITCH_TIMEOUT=0
      POST_ACCEPTANCE_FORCE=0
      MAINTENANCE_WAIT_SECONDS="''${MNX_SWITCH_MAINTENANCE_WAIT_SECONDS:-7200}"
      MAINTENANCE_POLL_SECONDS="''${MNX_SWITCH_MAINTENANCE_POLL_SECONDS:-15}"
      [[ "$MAINTENANCE_WAIT_SECONDS" =~ ^[0-9]+$ && "$MAINTENANCE_POLL_SECONDS" =~ ^[1-9][0-9]*$ ]] || { echo "invalid maintenance wait configuration" >&2; exit 64; }
      (( MAINTENANCE_WAIT_SECONDS <= 86400 && MAINTENANCE_POLL_SECONDS <= 300 )) || { echo "maintenance wait configuration exceeds bounds" >&2; exit 64; }

      if [[ "$SUBCOMMAND" == switch ]]; then
        while (( $# > 0 )); do
          case "$1" in
            --config)
              [[ $# -ge 2 ]] || { echo '--config requires a path' >&2; exit 64; }
              CFG="$2"
              shift 2
              ;;
            --verbose|-v)
              VERBOSE=1
              shift
              ;;
            --support=always|--full-support)
              SUPPORT_POLICY=always
              shift
              ;;
            --support=failure)
              SUPPORT_POLICY=failure
              shift
              ;;
            --support=never|--no-support)
              SUPPORT_POLICY=never
              shift
              ;;
            --no-rollback)
              ROLLBACK_ON_FAILURE=0
              shift
              ;;
            --timeout)
              [[ $# -ge 2 ]] || { echo '--timeout requires a duration such as 20m or 2h' >&2; exit 64; }
              SWITCH_TIMEOUT="$2"
              shift 2
              ;;
            --rerun-post-acceptance)
              POST_ACCEPTANCE_FORCE=1
              shift
              ;;
            *)
              printf 'unknown mnx switch option: %s\n' "$1" >&2
              exit 64
              ;;
          esac
        done
      fi

      #@MNX-PART id=99.20.mnx-switch.function.field_from_file kind=function title="Function field_from_file"
      field_from_file() {
        local file="$1" key="$2"
        sed -n "s/^''${key}=//p" "$file" 2>/dev/null | tail -n 1
      }


      #@MNX-PART id=99.20.mnx-switch.function.candidate-lineage-checkpoint kind=function title="Function candidate_lineage_checkpoint"
      candidate_lineage_checkpoint() {
        local checkpoint="$1" candidate="$2" expected_sha="$3" expected_default="$4"
        local output rc state observed_sha observed_default lineage_bin lineage_resolved
        case "$checkpoint" in switch-preflight|switch-lock) ;; *) echo "MNX_SWITCH_LINEAGE_ERROR: unsupported checkpoint: $checkpoint" >&2; return 1 ;; esac
        [[ -n "$expected_default" && "$expected_default" == /nix/store/* ]] || { echo 'MNX_SWITCH_LINEAGE_ERROR: accepted boot-default closure is unresolved' >&2; return 1; }
        lineage_bin="$expected_default/etc/monsternix/bin/mnx-lineage"
        [[ -x "$lineage_bin" ]] || { echo 'MNX_SWITCH_LINEAGE_ERROR: accepted boot-default closure has no executable mnx-lineage verifier' >&2; return 1; }
        lineage_resolved="$(readlink -f -- "$lineage_bin" 2>/dev/null || true)"
        [[ -n "$lineage_resolved" && "$lineage_resolved" == /nix/store/* && -x "$lineage_resolved" ]] || { echo 'MNX_SWITCH_LINEAGE_ERROR: accepted mnx-lineage verifier does not resolve to an executable Nix-store object' >&2; return 1; }
        set +e
        output="$("$lineage_resolved" check "$candidate" "$expected_sha" --expected-accepted-default "$expected_default" 2>&1)"
        rc=$?
        set -e
        printf '%s\n' "$output"
        (( rc == 0 )) || { echo "MNX_SWITCH_LINEAGE_ERROR: accepted-closure verifier refused checkpoint $checkpoint" >&2; return 1; }
        state="$(printf '%s\n' "$output" | sed -n 's/^candidate_lineage_state=//p' | tail -n 1)"
        observed_sha="$(printf '%s\n' "$output" | sed -n 's/^candidate_source_sha256=//p' | tail -n 1)"
        observed_default="$(printf '%s\n' "$output" | sed -n 's/^accepted_office_default_system=//p' | tail -n 1)"
        case "$state" in accepted-exact|direct-successor) ;; *) echo "MNX_SWITCH_LINEAGE_ERROR: unsupported passing state: $state" >&2; return 1 ;; esac
        [[ "$observed_sha" == "$expected_sha" ]] || { echo 'MNX_SWITCH_LINEAGE_ERROR: verifier returned a different candidate SHA-256' >&2; return 1; }
        [[ "$observed_default" == "$expected_default" ]] || { echo 'MNX_SWITCH_LINEAGE_ERROR: verifier returned a different accepted boot-default closure' >&2; return 1; }
        printf '%s\n' "$output" | grep -Fxq 'candidate_lineage_writes_performed=false' || { echo 'MNX_SWITCH_LINEAGE_ERROR: verifier did not prove read-only behavior' >&2; return 1; }
        printf '%s\n' "$output" | grep -Fxq 'candidate_lineage_mutation_authority=none' || { echo 'MNX_SWITCH_LINEAGE_ERROR: verifier claimed mutation authority' >&2; return 1; }
        printf '%s\n' "$output" | grep -Fxq 'MNX_CANDIDATE_LINEAGE=PASS' || { echo 'MNX_SWITCH_LINEAGE_ERROR: verifier omitted its PASS record' >&2; return 1; }
        if [[ "$CANONICAL_LINEAGE_CHECKPOINTS" == none ]]; then
          CANONICAL_LINEAGE_CHECKPOINTS="$checkpoint"
        else
          CANONICAL_LINEAGE_CHECKPOINTS+=",$checkpoint"
        fi
        printf 'candidate_lineage_checkpoint=%s\ncandidate_lineage_engine=accepted-default-closure-mnx-lineage\ncandidate_lineage_verifier=%s\ncandidate_lineage_authoritative_writes=false\ncandidate_lineage_mutation_authority=none\nMNX_CANONICAL_LINEAGE_CHECKPOINT=PASS\n' "$checkpoint" "$lineage_resolved"
      }


      #@MNX-PART id=99.20.mnx-switch.function.load-post-acceptance-plan kind=function title="Function load_post_acceptance_plan"
      load_post_acceptance_plan() {
        local input="''${1:-$CFG}" count value action
        local actions=()
        count="$(grep -Ec '^# MNX_POST_ACCEPTANCE_PLAN=' "$input" 2>/dev/null || true)"
        [[ "$count" == 1 ]] || {
          echo "MNX_POST_ACCEPTANCE_ERROR: expected one source plan marker, found $count" >&2
          return 1
        }
        value="$(sed -n 's/^# MNX_POST_ACCEPTANCE_PLAN=//p' "$input")"
        [[ "$value" == none || "$value" =~ ^[a-z0-9]+(-[a-z0-9]+)*(,[a-z0-9]+(-[a-z0-9]+)*)*$ ]] || {
          echo "MNX_POST_ACCEPTANCE_ERROR: invalid plan syntax: $value" >&2
          return 1
        }
        if [[ "$value" != none ]]; then
          IFS=, read -r -a actions <<< "$value"
          for action in "''${actions[@]}"; do
            case "$action" in
              m21-source-inventory|presslog-rearm|presslog-recovery-qualify|desktop-audit|upgrade-build|restic-adopt-existing|restic-qualify-first-pair|restic-qualify-and-enable|restic-maintenance-recover|restic-backup-reconcile|journal-integrity-anchor|journal-integrity-evidence|journal-integrity-recover-forward|nicotine-cutover|qbittorrent-cutover|cloudtainer-pack) ;;
              *) echo "MNX_POST_ACCEPTANCE_ERROR: unsupported action: $action" >&2; return 1 ;;
            esac
          done
        fi
        POST_ACCEPTANCE_PLAN="$value"
      }

      #@MNX-PART id=99.20.mnx-switch.function.release-transaction-locks kind=function title="Function release_transaction_locks"
      release_transaction_locks() {
        flock -u 9 2>/dev/null || true
        exec 9>&- 2>/dev/null || true
        flock -u 8 2>/dev/null || true
        exec 8>&- 2>/dev/null || true
        flock -u 7 2>/dev/null || true
        exec 7>&- 2>/dev/null || true
        POST_ACCEPTANCE_LOCKS_RELEASED=yes
      }

      #@MNX-PART id=99.20.mnx-switch.function.post-commit-seal kind=function title="Function post_commit_seal"
      post_commit_seal() {
        local intended_result="$1" office_rc=0 doctor_rc=0 doctor_json attempt
        : > "$POST_COMMIT_SEAL_LOG"
        printf 'post_commit_seal_intended_result=%s\n' "$intended_result"
        for attempt in $(seq 1 100); do
          grep -Fxq "post_commit_seal_intended_result=$intended_result" "$REPORT" 2>/dev/null && break
          sleep 0.05
        done
        grep -Fxq "post_commit_seal_intended_result=$intended_result" "$REPORT" || {
          echo 'post-commit seal intended result did not become durable in the transcript' >&2
          POST_COMMIT_SEAL_RC=1
          return 1
        }
        set +e
        MNX_OFFICE_POST_COMMIT_SEAL=1 MNX_OFFICE_CONFIG="$CFG" /etc/monsternix/bin/mnx-office verify --allow-incomplete-switch >> "$POST_COMMIT_SEAL_LOG" 2>&1
        office_rc="$?"
        doctor_json="$(MNX_OFFICE_POST_COMMIT_SEAL=1 MNX_CONFIG="$CFG" /etc/monsternix/bin/mnx doctor --json --require machine 2>>"$POST_COMMIT_SEAL_LOG")"
        doctor_rc="$?"
        set -e
        if (( doctor_rc == 0 )); then
          printf '%s\n' "$doctor_json" >> "$POST_COMMIT_SEAL_LOG"
          printf '%s\n' "$doctor_json" | ${pkgs.jq}/bin/jq -e \
            '.schema == "mnx.doctor.v1" and .status == "pass" and .required_tier == "machine" and .office.office_acceptance_state == "committed-pending-final-seal" and .network_used == false and .mutation == "none"' \
            >/dev/null 2>&1 || doctor_rc=1
        fi
        printf 'post_commit_office_verify_rc=%s\npost_commit_doctor_rc=%s\n' "$office_rc" "$doctor_rc" >> "$POST_COMMIT_SEAL_LOG"
        if (( office_rc == 0 && doctor_rc == 0 )); then
          POST_COMMIT_SEAL_RC=0
          CORE_ACCEPTANCE_RESULT="$intended_result"
          {
            printf 'post_commit_seal_rc=0\n'
            printf 'core_acceptance_result=%s\n' "$CORE_ACCEPTANCE_RESULT"
            echo 'MNX_POST_COMMIT_SEAL=PASS'
          } | tee -a "$POST_COMMIT_SEAL_LOG"
          write_state
          return 0
        fi
        POST_COMMIT_SEAL_RC=1
        printf 'post_commit_seal_rc=1\n' | tee -a "$POST_COMMIT_SEAL_LOG" >&2
        cat "$POST_COMMIT_SEAL_LOG" >&2 || true
        return 1
      }

      #@MNX-PART id=99.20.mnx-switch.function.run-presslog-rearm-action kind=function title="Function run_presslog_rearm_action"
      run_presslog_rearm_action() {
        (
          set -Eeuo pipefail
          umask 077
          local marker=/home/h0p3/.local/state/presslog/monsternix/armed
          local status_path=/home/h0p3/.local/state/presslog/run/status.json
          local heartbeat_path=/run/monsternix-monsterkey/presslog-heartbeat.json
          local runtime=/run/user/1000
          local bus=/run/user/1000/bus
          local xauthority=/home/h0p3/.Xauthority
          local display_socket=/tmp/.X11-unix/X0
          local tmpdir arm_out arm_err command_out command_err observer_out observer_err
          local uid gid arm_rc=0 command_rc=0 observer_rc=0
          local arm_state=unknown outcome=unknown blocker_kind=none session_ready=yes manager_ready=yes
          local normal_load=unknown normal_active=unknown normal_pid=0 normal_result=unknown
          local burn_load=unknown burn_active=unknown burn_pid=0 burn_result=unknown
          local stopped=no heartbeat_ok=no current_boot observer_json attempt
          local -a user_env=() user_systemctl=()

          tmpdir="$(mktemp -d -t mnx-presslog-rearm.XXXXXXXX)" || exit 2
          trap 'rm -rf -- "$tmpdir"' EXIT HUP INT TERM
          arm_out="$tmpdir/armed.stdout"
          arm_err="$tmpdir/armed.stderr"
          command_out="$tmpdir/recover.stdout"
          command_err="$tmpdir/recover.stderr"
          observer_out="$tmpdir/observer.stdout"
          observer_err="$tmpdir/observer.stderr"

          uid="$(id -u h0p3 2>/dev/null || true)"
          gid="$(id -g h0p3 2>/dev/null || true)"
          if [[ "$uid" != 1000 || ! "$gid" =~ ^[0-9]+$ ]]; then
            printf 'presslog_rearm_identity=invalid uid=%q gid=%q\nMNX_PRESSLOG_REARM=FAIL_CONTRACT\n' "$uid" "$gid" >&2
            exit 2
          fi

          user_env=(
            ${pkgs.util-linux}/bin/runuser -u h0p3 --
            ${pkgs.coreutils}/bin/env -i
            HOME=/home/h0p3 USER=h0p3 LOGNAME=h0p3
            PATH=/run/current-system/sw/bin:${pkgs.bash}/bin:${pkgs.coreutils}/bin:${pkgs.util-linux}/bin:${pkgs.systemd}/bin
            XDG_RUNTIME_DIR="$runtime"
            DBUS_SESSION_BUS_ADDRESS="unix:path=$bus"
            DISPLAY=:0
            XAUTHORITY="$xauthority"
            QT_QPA_PLATFORM=xcb
            LC_ALL=C
          )
          user_systemctl=("''${user_env[@]}" ${pkgs.systemd}/bin/systemctl --user)

          if "''${user_env[@]}" /etc/monsternix/bin/presslog armed-status >"$arm_out" 2>"$arm_err"; then
            arm_rc=0
          else
            arm_rc=$?
          fi
          cat "$arm_out"
          cat "$arm_err" >&2
          arm_state="$(sed -n 's/^presslog_armed_marker_state=//p' "$arm_out" | tail -n 1)"
          if [[ -z "$arm_state" ]]; then
            arm_state="$(sed -n 's/^presslog_armed_marker_state=//p' "$arm_err" | tail -n 1)"
          fi
          case "$arm_state:$arm_rc" in
            absent:0)
              outcome=skip
              ;;
            safe:0)
              outcome=attempt
              ;;
            unsafe:76)
              outcome=blocked
              blocker_kind=unsafe-armed-marker
              ;;
            *)
              printf 'presslog_rearm_armed_status_contract=invalid state=%q rc=%q\nMNX_PRESSLOG_REARM=FAIL_CONTRACT\n' "$arm_state" "$arm_rc" >&2
              exit 2
              ;;
          esac

          if [[ -d "$runtime" && ! -L "$runtime" && "$(stat -Lc '%u:%a' "$runtime" 2>/dev/null || true)" == 1000:700 && -S "$bus" ]]; then
            normal_load="$("''${user_systemctl[@]}" show presslog.service -p LoadState --value 2>/dev/null || true)"
            burn_load="$("''${user_systemctl[@]}" show presslog-burn.service -p LoadState --value 2>/dev/null || true)"
            if [[ "$normal_load" != loaded || "$burn_load" != loaded ]]; then
              manager_ready=no
            fi
          else
            manager_ready=no
          fi

          if [[ "$manager_ready" == yes ]]; then
            normal_active="$("''${user_systemctl[@]}" show presslog.service -p ActiveState --value 2>/dev/null || true)"
            normal_pid="$("''${user_systemctl[@]}" show presslog.service -p MainPID --value 2>/dev/null || true)"
            normal_result="$("''${user_systemctl[@]}" show presslog.service -p Result --value 2>/dev/null || true)"
            burn_active="$("''${user_systemctl[@]}" show presslog-burn.service -p ActiveState --value 2>/dev/null || true)"
            burn_pid="$("''${user_systemctl[@]}" show presslog-burn.service -p MainPID --value 2>/dev/null || true)"
            burn_result="$("''${user_systemctl[@]}" show presslog-burn.service -p Result --value 2>/dev/null || true)"
          fi
          [[ "$normal_pid" =~ ^[0-9]+$ ]] || normal_pid=0
          [[ "$burn_pid" =~ ^[0-9]+$ ]] || burn_pid=0
          printf 'presslog_rearm_pre_service=manager:%s normal:%s:%s:%s:%s burn:%s:%s:%s:%s\n' "$manager_ready" "$normal_load" "$normal_active" "$normal_pid" "$normal_result" "$burn_load" "$burn_active" "$burn_pid" "$burn_result"
          if [[ "$manager_ready" == yes && ( "$normal_active" == active || "$normal_pid" -gt 0 ) && ( "$burn_active" == active || "$burn_pid" -gt 0 ) ]]; then
            echo 'presslog_rearm_service_exclusivity=both-recorders-active' >&2
            echo 'MNX_PRESSLOG_REARM=FAIL_CONTRACT' >&2
            exit 2
          fi

          if [[ "$outcome" == attempt ]]; then
            if [[ "$manager_ready" != yes ]]; then
              outcome=deferred
              blocker_kind=user-manager-unavailable
            elif [[ "$burn_active" == active || "$burn_active" == activating || "$burn_active" == reloading || "$burn_pid" -gt 0 ]]; then
              outcome=deferred
              blocker_kind=active-burn-session-preserved
            else
              if [[ "$normal_active" != active ]]; then
                if [[ ! -S "$display_socket" || ! -f "$xauthority" || -L "$xauthority" || "$(stat -Lc '%u:%a:%h' "$xauthority" 2>/dev/null || true)" != 1000:600:1 ]]; then
                  session_ready=no
                fi
              fi
              if [[ "$session_ready" != yes ]]; then
                outcome=deferred
                blocker_kind=graphical-session-unavailable
              else
                if ${pkgs.coreutils}/bin/timeout --signal=TERM --kill-after=10s 240s \
                  "''${user_env[@]}" /etc/monsternix/bin/presslog recover-armed --switch-owned \
                  >"$command_out" 2>"$command_err"; then
                  command_rc=0
                else
                  command_rc=$?
                fi
                cat "$command_out"
                cat "$command_err" >&2
                if [[ "$command_rc" == 0 ]] && grep -Fxq 'PRESSLOG_RECOVER_ARMED=PASS' "$command_out"; then
                  outcome=pass
                elif [[ "$command_rc" == 0 ]] && grep -Fxq 'PRESSLOG_RECOVER_ARMED=SKIP_NOT_ARMED' "$command_out"; then
                  outcome=skip
                elif [[ "$command_rc" == 76 ]] && grep -Fxq 'PRESSLOG_RECOVER_ARMED=BLOCKED' "$command_err"; then
                  outcome=blocked
                  blocker_kind=authentication-or-recorder-start
                elif [[ "$command_rc" == 75 ]]; then
                  outcome=deferred
                  blocker_kind=bounded-controller-contention
                elif [[ "$command_rc" == 74 ]]; then
                  printf 'presslog_rearm_recovery_contract=unsafe-state-transition rc=74\nMNX_PRESSLOG_REARM=FAIL_CONTRACT\n' >&2
                  exit 2
                else
                  outcome=blocked
                  blocker_kind="controller-exit-$command_rc"
                fi
              fi
            fi
          fi

          if [[ "$outcome" == blocked || "$outcome" == deferred || "$outcome" == skip ]]; then
            if [[ "$manager_ready" == yes && "$burn_active" != active && "$burn_active" != activating && "$burn_active" != reloading && "$burn_pid" == 0 ]]; then
              "''${user_systemctl[@]}" stop presslog.service >/dev/null 2>&1 || true
              for attempt in $(seq 1 60); do
                normal_active="$("''${user_systemctl[@]}" show presslog.service -p ActiveState --value 2>/dev/null || true)"
                normal_pid="$("''${user_systemctl[@]}" show presslog.service -p MainPID --value 2>/dev/null || true)"
                [[ "$normal_pid" =~ ^[0-9]+$ ]] || normal_pid=0
                if [[ "$normal_active" == inactive || "$normal_active" == failed ]] && [[ "$normal_pid" == 0 ]]; then
                  stopped=yes
                  break
                fi
                sleep 1
              done
              if [[ "$stopped" != yes ]]; then
                printf 'presslog_rearm_stopped_proof=failed active=%q pid=%q\nMNX_PRESSLOG_REARM=FAIL_CONTRACT\n' "$normal_active" "$normal_pid" >&2
                exit 2
              fi
              "''${user_systemctl[@]}" reset-failed presslog.service >/dev/null 2>&1 || {
                echo 'presslog_rearm_normal_reset_failed=failed' >&2
                echo 'MNX_PRESSLOG_REARM=FAIL_CONTRACT' >&2
                exit 2
              }
              normal_active="$("''${user_systemctl[@]}" show presslog.service -p ActiveState --value 2>/dev/null || true)"
              normal_pid="$("''${user_systemctl[@]}" show presslog.service -p MainPID --value 2>/dev/null || true)"
              normal_result="$("''${user_systemctl[@]}" show presslog.service -p Result --value 2>/dev/null || true)"
              burn_active="$("''${user_systemctl[@]}" show presslog-burn.service -p ActiveState --value 2>/dev/null || true)"
              burn_pid="$("''${user_systemctl[@]}" show presslog-burn.service -p MainPID --value 2>/dev/null || true)"
              burn_result="$("''${user_systemctl[@]}" show presslog-burn.service -p Result --value 2>/dev/null || true)"
              [[ "$normal_pid" =~ ^[0-9]+$ ]] || normal_pid=0
              [[ "$burn_pid" =~ ^[0-9]+$ ]] || burn_pid=0
              if [[ "$normal_active" != inactive || "$normal_pid" != 0 || "$normal_result" != success || "$burn_active" != inactive || "$burn_pid" != 0 || "$burn_result" != success ]]; then
                printf 'presslog_rearm_clean_idle_proof=failed normal=%q:%q:%q burn=%q:%q:%q\nMNX_PRESSLOG_REARM=FAIL_CONTRACT\n' "$normal_active" "$normal_pid" "$normal_result" "$burn_active" "$burn_pid" "$burn_result" >&2
                exit 2
              fi
              printf 'presslog_rearm_clean_idle_proof=pass\n'
            fi

            if "''${user_env[@]}" /etc/monsternix/bin/presslog armed-status >"$arm_out.after" 2>"$arm_err.after"; then
              arm_rc=0
            else
              arm_rc=$?
            fi
            cat "$arm_out.after"
            cat "$arm_err.after" >&2
            arm_state="$(sed -n 's/^presslog_armed_marker_state=//p' "$arm_out.after" | tail -n 1)"
            if [[ -z "$arm_state" ]]; then
              arm_state="$(sed -n 's/^presslog_armed_marker_state=//p' "$arm_err.after" | tail -n 1)"
            fi
            if [[ "$blocker_kind" == unsafe-armed-marker ]]; then
              if [[ "$arm_state" != unsafe || "$arm_rc" != 76 ]]; then
                printf 'presslog_rearm_unsafe_arm_after=changed state=%q rc=%q\nMNX_PRESSLOG_REARM=FAIL_CONTRACT\n' "$arm_state" "$arm_rc" >&2
                exit 2
              fi
              printf 'presslog_rearm_arm_after=unsafe-preserved\n'
            else
              if [[ "$arm_state" == unsafe || ( "$arm_rc" != 0 && "$arm_rc" != 76 ) ]]; then
                printf 'presslog_rearm_arm_after=invalid state=%q rc=%q\nMNX_PRESSLOG_REARM=FAIL_CONTRACT\n' "$arm_state" "$arm_rc" >&2
                exit 2
              fi
              printf 'presslog_rearm_arm_after=%s\n' "$arm_state"
            fi
          fi

          if [[ "$outcome" == pass ]]; then
            normal_active="$("''${user_systemctl[@]}" show presslog.service -p ActiveState --value 2>/dev/null || true)"
            normal_pid="$("''${user_systemctl[@]}" show presslog.service -p MainPID --value 2>/dev/null || true)"
            normal_result="$("''${user_systemctl[@]}" show presslog.service -p Result --value 2>/dev/null || true)"
            burn_active="$("''${user_systemctl[@]}" show presslog-burn.service -p ActiveState --value 2>/dev/null || true)"
            burn_pid="$("''${user_systemctl[@]}" show presslog-burn.service -p MainPID --value 2>/dev/null || true)"
            burn_result="$("''${user_systemctl[@]}" show presslog-burn.service -p Result --value 2>/dev/null || true)"
            [[ "$normal_pid" =~ ^[1-9][0-9]*$ ]] || {
              printf 'presslog_rearm_live_service=invalid-pid value=%q\nMNX_PRESSLOG_REARM=FAIL_CONTRACT\n' "$normal_pid" >&2
              exit 2
            }
            [[ "$burn_pid" =~ ^[0-9]+$ ]] || burn_pid=0
            if [[ "$normal_active" != active || "$normal_result" != success || "$burn_active" != inactive || "$burn_pid" != 0 || "$burn_result" != success ]]; then
              printf 'presslog_rearm_live_service=invalid normal=%q:%q:%q burn=%q:%q:%q\nMNX_PRESSLOG_REARM=FAIL_CONTRACT\n' "$normal_active" "$normal_pid" "$normal_result" "$burn_active" "$burn_pid" "$burn_result" >&2
              exit 2
            fi
            if [[ ! -f "$status_path" || -L "$status_path" || "$(stat -Lc '%u:%g:%a:%h' "$status_path" 2>/dev/null || true)" != "1000:$gid:600:1" ]] ||
               ! ${pkgs.jq}/bin/jq -e --arg pid "$normal_pid" 'select(.pid==$pid and .paused=="true" and .burn=="false" and .auto_expire=="false" and (.segment|type)=="string" and (.segment|length)>0)' "$status_path" >/dev/null 2>&1; then
              echo 'presslog_rearm_live_status=invalid' >&2
              echo 'MNX_PRESSLOG_REARM=FAIL_CONTRACT' >&2
              exit 2
            fi
            current_boot="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
            for attempt in $(seq 1 60); do
              if [[ -f "$heartbeat_path" && ! -L "$heartbeat_path" && "$(stat -Lc '%u:%g:%a:%h' "$heartbeat_path" 2>/dev/null || true)" == "1000:$gid:600:1" ]] &&
                 ${pkgs.jq}/bin/jq -e --arg boot "$current_boot" --argjson pid "$normal_pid" 'select(.schema=="mnx.presslog.heartbeat.v1" and .boot_id==$boot and .service_active==true and .service_result=="success" and .status=="paused" and .paused==true and .status_pid_matches==true and .recorder_pid==$pid and .journal_content_read==false and .private_material_read==false and .network_used==false)' "$heartbeat_path" >/dev/null 2>&1; then
                heartbeat_ok=yes
                break
              fi
              sleep 1
            done
            if [[ "$heartbeat_ok" != yes ]]; then
              echo 'presslog_rearm_heartbeat=missing-or-mismatched' >&2
              echo 'MNX_PRESSLOG_REARM=FAIL_CONTRACT' >&2
              exit 2
            fi
            printf 'presslog_rearm_live_service=pass pid=%s\npresslog_rearm_live_status=paused\npresslog_rearm_heartbeat=pass\nmanual_resume_required=true\n' "$normal_pid"
          fi

          if /etc/monsternix/bin/mnx-presslog-observe observe >"$observer_out" 2>"$observer_err"; then
            observer_rc=0
          else
            observer_rc=$?
          fi
          cat "$observer_out"
          cat "$observer_err" >&2
          observer_json="$(sed -n '1p' "$observer_out")"
          if [[ "$observer_rc" != 0 && "$observer_rc" != 76 ]] ||
             ! ${pkgs.jq}/bin/jq -e 'select(.schema=="mnx.presslog.current.v2" and (.status|type)=="string" and (.review_reasons|type)=="array" and .status_snapshot_semantics=="opened-fd-consistent-atomic-path-replacement-accepted" and (.status_snapshot_replaced_during_read|type)=="boolean" and .content_inspected==false and .private_material_read==false and .journal_payload_read==false and .network_used==false)' <<<"$observer_json" >/dev/null 2>&1; then
            printf 'presslog_rearm_observer_contract=invalid rc=%q\nMNX_PRESSLOG_REARM=FAIL_CONTRACT\n' "$observer_rc" >&2
            exit 2
          fi
          if [[ "$observer_rc" == 0 ]] && ! grep -Fxq 'MNX_PRESSLOG_OBSERVER=PASS' "$observer_out"; then
            echo 'presslog_rearm_observer_marker=missing-pass' >&2
            echo 'MNX_PRESSLOG_REARM=FAIL_CONTRACT' >&2
            exit 2
          fi
          if [[ "$observer_rc" == 76 ]] && ! grep -Fxq 'MNX_PRESSLOG_OBSERVER=REVIEW_PUBLISHED_STATE' "$observer_err"; then
            echo 'presslog_rearm_observer_marker=missing-review' >&2
            echo 'MNX_PRESSLOG_REARM=FAIL_CONTRACT' >&2
            exit 2
          fi

          case "$outcome" in
            pass)
              if ! ${pkgs.jq}/bin/jq -e --argjson pid "$normal_pid" '
                select(
                  .armed==true and .service_active==true and .service_failed==false and .burn_active==false and
                  .normal_service.active=="active" and .normal_service.result=="success" and
                  .paused=="true" and .auto_expire=="false" and .active_segment_reported==true and
                  .heartbeat_current_boot==true and .heartbeat.status=="paused" and .heartbeat.paused==true and
                  .heartbeat.service_active==true and .heartbeat.service_result=="success" and
                  .heartbeat.status_pid_matches==true and .heartbeat.recorder_pid==$pid and
                  .heartbeat_age_seconds>=0 and .heartbeat_age_seconds<=90 and .unsafe_object_count==0 and
                  ([.review_reasons[] | select(.=="armed-not-recording" or .=="service-failed" or .=="active-without-status" or .=="automatic-expiry-not-disabled" or .=="burn-service-status-mismatch" or .=="normal-service-status-mismatch" or .=="current-boot-heartbeat-missing" or .=="heartbeat-pid-unconfirmed" or .=="supervisor-heartbeat-stale")] | length)==0
                )' <<<"$observer_json" >/dev/null; then
                echo 'presslog_rearm_observer_live_proof=failed' >&2
                echo 'MNX_PRESSLOG_REARM=FAIL_CONTRACT' >&2
                exit 2
              fi
              printf 'presslog_rearm_observer_live_proof=pass\nmanual_resume_required=true\nMNX_PRESSLOG_REARM=PASS\n'
              exit 0
              ;;
            skip)
              if ! ${pkgs.jq}/bin/jq -e 'select(.armed==false and .service_active==false and .burn_active==false and .service_failed==false and .unsafe_object_count==0)' <<<"$observer_json" >/dev/null; then
                echo 'presslog_rearm_observer_skip_proof=failed' >&2
                echo 'MNX_PRESSLOG_REARM=FAIL_CONTRACT' >&2
                exit 2
              fi
              printf 'presslog_rearm_observer_skip_proof=pass\nmanual_resume_required=true\nMNX_PRESSLOG_REARM=SKIP_NOT_ARMED\n'
              exit 0
              ;;
            deferred)
              printf 'presslog_rearm_deferred_reason=%s\nmanual_resume_required=true\nMNX_PRESSLOG_REARM=DEFERRED\n' "$blocker_kind" >&2
              exit 75
              ;;
            blocked)
              if [[ "$blocker_kind" != unsafe-armed-marker ]] &&
                 ! ${pkgs.jq}/bin/jq -e 'select(.service_active==false and .burn_active==false and .service_failed==false and .unsafe_object_count==0 and (.armed==true or .armed==false))' <<<"$observer_json" >/dev/null; then
                echo 'presslog_rearm_observer_blocked_proof=failed' >&2
                echo 'MNX_PRESSLOG_REARM=FAIL_CONTRACT' >&2
                exit 2
              fi
              printf 'presslog_rearm_blocked_reason=%s\npresslog_rearm_controller_rc=%s\nmanual_resume_required=true\nMNX_PRESSLOG_REARM=BLOCKED\n' "$blocker_kind" "$command_rc" >&2
              exit 76
              ;;
            *)
              printf 'presslog_rearm_outcome=invalid value=%q\nMNX_PRESSLOG_REARM=FAIL_CONTRACT\n' "$outcome" >&2
              exit 2
              ;;
          esac
        )
      }

      #@MNX-PART id=99.20.mnx-switch.function.run-presslog-recovery-qualify-action kind=function title="Function run_presslog_recovery_qualify_action"
      run_presslog_recovery_qualify_action() {
        (
          set -Eeuo pipefail
          umask 077
          local recovery_root=/home/h0p3/.local/state/presslog/monsternix/recovery
          local receipt_path=/home/h0p3/.local/state/presslog/monsternix/recovery-drill-current.json
          local runtime=/run/user/1000
          local bus=/run/user/1000/bus
          local xauthority=/home/h0p3/.Xauthority
          local tmpdir arm_out arm_err stop_out stop_err drill_out drill_err observer_out observer_err rearm_out rearm_err
          local uid gid arm_rc=0 stop_rc=0 drill_rc=0 observer_rc=0 rearm_rc=0 normal_pid=0 burn_pid=0 attempt recovery_attempt rearm_attempt
          local max_original_attempts=3 max_rearm_attempts=1 expected_receipt receipt_outcome observer_json archive archive_meta phase
          local normal_load=unknown normal_active=unknown normal_result=unknown burn_load=unknown burn_active=unknown burn_result=unknown
          local arm_state=unknown final_failure_class=unknown
          local receipt_before=absent receipt_after=absent receipt_current=absent drill_archive=none drill_archive_sha=none
          local receipt_before_dev=absent receipt_before_ino=absent receipt_after_dev=absent receipt_after_ino=absent
          local receipt_owner=absent receipt_group=absent receipt_mode=absent receipt_links=absent receipt_size=absent receipt_mtime=absent
          local receipt_before_identity=absent receipt_after_identity=absent observer_settled=no observer_ready=no rearm_ready=no
          local -a user_env=() user_systemctl=()

          tmpdir="$(mktemp -d -t mnx-presslog-recovery-qualify.XXXXXXXX)" || exit 2
          trap 'rm -rf -- "$tmpdir"' EXIT HUP INT TERM
          arm_out="$tmpdir/armed.stdout"
          arm_err="$tmpdir/armed.stderr"
          stop_out="$tmpdir/stop.stdout"
          stop_err="$tmpdir/stop.stderr"
          drill_out="$tmpdir/drill.stdout"
          drill_err="$tmpdir/drill.stderr"
          observer_out="$tmpdir/observer.stdout"
          observer_err="$tmpdir/observer.stderr"
          rearm_out="$tmpdir/rearm.stdout"
          rearm_err="$tmpdir/rearm.stderr"

          uid="$(id -u h0p3 2>/dev/null || true)"
          gid="$(id -g h0p3 2>/dev/null || true)"
          if [[ "$uid" != 1000 || ! "$gid" =~ ^[0-9]+$ ]]; then
            printf 'presslog_recovery_qualification_identity=invalid uid=%q gid=%q\nMNX_PRESSLOG_RECOVERY_QUALIFICATION=FAIL_CONTRACT\n' "$uid" "$gid" >&2
            exit 2
          fi

          user_env=(
            ${pkgs.util-linux}/bin/runuser -u h0p3 --
            ${pkgs.coreutils}/bin/env -i
            HOME=/home/h0p3 USER=h0p3 LOGNAME=h0p3
            PATH=/run/current-system/sw/bin:${pkgs.bash}/bin:${pkgs.coreutils}/bin:${pkgs.util-linux}/bin:${pkgs.systemd}/bin
            XDG_RUNTIME_DIR="$runtime"
            DBUS_SESSION_BUS_ADDRESS="unix:path=$bus"
            DISPLAY=:0
            XAUTHORITY="$xauthority"
            QT_QPA_PLATFORM=xcb
            LC_ALL=C
          )
          user_systemctl=("''${user_env[@]}" ${pkgs.systemd}/bin/systemctl --user)

          printf '%s\n' \
            'presslog_recovery_qualification_baseline_policy=normalize-safe-arm-to-clean-idle-before-any-secret-prompt' \
            'presslog_recovery_qualification_drill_prompt_count=5' \
            'presslog_recovery_qualification_post_success_rearm_prompt_count=1' \
            'presslog_recovery_qualification_post_success_rearm_attempt_limit=1' \
            'presslog_recovery_qualification_successful_first_try_dialog_count=6' \
            'presslog_recovery_qualification_original_password_attempt_limit=3' \
            'presslog_recovery_qualification_maximum_dialog_count=8' \
            'presslog_recovery_qualification_prompt_1=existing-presslog-password-for-original-deep-verification' \
            'presslog_recovery_qualification_prompt_2=new-separate-archive-passphrase' \
            'presslog_recovery_qualification_prompt_3=confirm-separate-archive-passphrase' \
            'presslog_recovery_qualification_prompt_4=archive-passphrase-for-disposable-import' \
            'presslog_recovery_qualification_prompt_5=existing-presslog-password-for-disposable-deep-verification' \
            'presslog_recovery_qualification_prompt_6=existing-presslog-password-for-paused-recorder-rearm-after-recovery-pass' \
            'presslog_recovery_qualification_retry_scope=verify-original-rc65-only' \
            'presslog_recovery_qualification_monster_key=do-not-use-during-sequence' \
