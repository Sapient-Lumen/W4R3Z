      DEFAULT_CONFIG = Path('/etc/nixos/configuration.nix')
      CHUNK_RE = re.compile(r'^#@MNX-CHUNK\s+(.*?)(?:\r?\n)?$')
      DEF_RE = re.compile(r'^#@MNX-DEF\s+path=(.*?)\s+section=([^\s]+)\s+role=([^\s]+)\s+ordinal=([0-9]+)\s*$')
