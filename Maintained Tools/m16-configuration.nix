      #@MNX-PART id=99.92.mnx-monsterkey.function.presslog-status-snapshot kind=function title="Python function presslog_status_snapshot"
      def presslog_status_snapshot() -> dict[str, Any] | None:
          path = PRESSLOG_STATUS_PATH
          for _ in range(3):
              try:
                  before = path.lstat()
              except FileNotFoundError:
                  return None
              if not stat.S_ISREG(before.st_mode) or stat.S_ISLNK(before.st_mode) or before.st_uid != EXPECTED_UID or stat.S_IMODE(before.st_mode) != 0o600 or before.st_size <= 0 or before.st_size > MAX_FILE_BYTES:
                  return None
              descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
              try:
                  opened = os.fstat(descriptor)
                  payload = os.read(descriptor, MAX_FILE_BYTES + 1)
                  after = os.fstat(descriptor)
              finally:
                  os.close(descriptor)
              identity = lambda item: (item.st_dev, item.st_ino, item.st_uid, item.st_gid, stat.S_IMODE(item.st_mode), item.st_size, item.st_mtime_ns)
              if identity(opened) != identity(after) or len(payload) != opened.st_size:
                  time.sleep(0.01)
                  continue
              try:
                  current = path.lstat()
              except FileNotFoundError:
                  time.sleep(0.01)
                  continue
              if not stat.S_ISREG(current.st_mode) or stat.S_ISLNK(current.st_mode) or current.st_uid != EXPECTED_UID or stat.S_IMODE(current.st_mode) != 0o600:
                  return None
              try:
                  record = json.loads(payload.decode("utf-8"))
              except (UnicodeDecodeError, json.JSONDecodeError):
                  return None
              return record if isinstance(record, dict) else None
          return None

      #@MNX-PART id=99.92.mnx-monsterkey.function.presslog-metadata-progress kind=function title="Python function presslog_metadata_progress"
      def presslog_metadata_progress(status: dict[str, Any] | None) -> dict[str, Any]:
          active_name = str(status.get('segment', ''')) if isinstance(status, dict) else '''
          if not re.fullmatch(r'[A-Za-z0-9_.:+-]{1,128}', active_name):
              active_name = '''
          active_path = PRESSLOG_JOURNAL_DIR / active_name if active_name else None
          active_size = 0
          active_mtime_ns = 0
          if active_path is not None:
              try:
                  item = active_path.lstat()
                  if stat.S_ISREG(item.st_mode) and not stat.S_ISLNK(item.st_mode) and item.st_uid == EXPECTED_UID:
                      active_size = item.st_size
                      active_mtime_ns = item.st_mtime_ns
              except OSError:
                  pass
          newest_manifest_ns = 0
          try:
              iterator = os.scandir(PRESSLOG_MANIFEST_DIR)
          except OSError:
              iterator = None
          if iterator is not None:
              with iterator:
                  for number, entry in enumerate(iterator, 1):
                      if number > 100000:
                          break
                      try:
                          item = entry.stat(follow_symlinks=False)
                      except OSError:
                          continue
                      if not entry.is_symlink() and stat.S_ISREG(item.st_mode) and item.st_uid == EXPECTED_UID and entry.name.endswith('.sha256'):
                          newest_manifest_ns = max(newest_manifest_ns, item.st_mtime_ns)
          events = 0
          if isinstance(status, dict) and str(status.get('events', '0')).isdigit():
              events = int(str(status.get('events')))
          return {
              'events': events,
              'active_segment': active_name,
              'active_segment_size': active_size,
              'active_segment_mtime_ns': active_mtime_ns,
              'newest_manifest_mtime_ns': newest_manifest_ns,
          }
      #@MNX-PART id=99.92.mnx-monsterkey.function.write-presslog-startup kind=function title="Python function write_presslog_startup"
      def write_presslog_startup(environment: dict[str, str], unit: dict[str, Any], status: dict[str, Any] | None) -> dict[str, Any]:
          armed = False
          try:
              marker = PRESSLOG_ARMED_MARKER.lstat()
              armed = stat.S_ISREG(marker.st_mode) and not stat.S_ISLNK(marker.st_mode) and marker.st_uid == EXPECTED_UID and stat.S_IMODE(marker.st_mode) == 0o600
          except FileNotFoundError:
              pass
          current_boot = boot_id()
          invocation = str(unit.get('invocation_id', '''))
          if not re.fullmatch(r'[0-9a-f]{32}', invocation):
              invocation = '''
          recording = unit.get('active') == 'active' and isinstance(status, dict) and str(status.get('pid', ''')) == str(unit.get('pid', 0))
          attempted = bool(invocation) or unit.get('active') in {'active', 'failed'}
          if recording:
              outcome = 'recording-confirmed'
          elif unit.get('active') == 'failed':
              outcome = 'failed'
          elif armed and attempted:
              outcome = 'armed-but-locked'
          elif armed:
              outcome = 'pending'
          else:
              outcome = 'not-armed'
          now_text = utc_now()
          prior: dict[str, Any] = {}
          prior_path = ensure_runtime_root() / PRESSLOG_STARTUP_NAME
          if prior_path.exists():
              try:
                  candidate = json.loads(validated_regular(prior_path).decode('utf-8'))
                  if isinstance(candidate, dict) and candidate.get('schema') == PRESSLOG_STARTUP_SCHEMA and candidate.get('boot_id') == current_boot:
                      prior = candidate
              except Exception:
                  prior = {}
          same_attempt = prior.get('invocation_id', ''') == invocation and prior.get('armed_at_observation') == armed
          first_observed_at = str(prior.get('first_observed_at', now_text)) if same_attempt else now_text
          unlock_attempted_at = prior.get('unlock_attempted_at') if same_attempt else None
          recording_confirmed_at = prior.get('recording_confirmed_at') if same_attempt else None
          if attempted and not unlock_attempted_at:
              unlock_attempted_at = now_text
          if recording and not recording_confirmed_at:
              recording_confirmed_at = now_text
          record = {
              'schema': PRESSLOG_STARTUP_SCHEMA,
              'boot_id': current_boot,
              'graphical_session_seen': True,
              'armed_at_observation': armed,
              'unlock_attempted': attempted,
              'unlock_outcome': outcome,
              'recording_confirmed': recording,
              'recorder_pid': int(unit.get('pid', 0)) if recording else 0,
              'service_state': unit.get('active', 'unknown'),
              'service_result': unit.get('result', 'unknown'),
              'invocation_id': invocation,
              'first_observed_at': first_observed_at,
              'unlock_attempted_at': unlock_attempted_at,
              'recording_confirmed_at': recording_confirmed_at,
              'observed_at': now_text,
              'updated_epoch': int(time.time()),
              'updated_monotonic_ns': time.monotonic_ns(),
              'password_recorded': False,
              'journal_content_read': False,
          }
          stable_keys = (
              'schema', 'boot_id', 'graphical_session_seen', 'armed_at_observation',
              'unlock_attempted', 'unlock_outcome', 'recording_confirmed',
              'recorder_pid', 'service_state', 'service_result', 'invocation_id',
              'first_observed_at', 'unlock_attempted_at', 'recording_confirmed_at',
              'password_recorded', 'journal_content_read',
          )
          if prior and all(prior.get(key) == record.get(key) for key in stable_keys):
              return prior
          atomic_write(prior_path, (json.dumps(record, sort_keys=True, separators=(',', ':')) + '\n').encode('utf-8'))
          return record
      #@MNX-PART id=99.92.mnx-monsterkey.function.write-presslog-heartbeat kind=function title="Python function write_presslog_heartbeat"
      def write_presslog_heartbeat(supervisor: dict[str, Any], unit: dict[str, Any], status: dict[str, Any] | None, progress: dict[str, Any]) -> dict[str, Any]:
          now_monotonic = time.monotonic()
          now_ns = time.monotonic_ns()
          if progress['events'] != supervisor.get('events'):
              supervisor['last_event_change_monotonic_ns'] = now_ns
          if progress['active_segment_size'] != supervisor.get('active_segment_size'):
              supervisor['last_ciphertext_growth_monotonic_ns'] = now_ns
          if progress['newest_manifest_mtime_ns'] != supervisor.get('newest_manifest_mtime_ns'):
              supervisor['last_manifest_change_monotonic_ns'] = now_ns
          supervisor.update(progress)
          active = unit.get('active') == 'active'
          status_match = active and isinstance(status, dict) and str(status.get('pid', ''')) == str(unit.get('pid', 0))
          paused = status_match and str(status.get('paused', 'false')) == 'true'
          if active and not status_match:
              heartbeat_status = 'review-active-without-pid-bound-status'
          elif active and paused:
              heartbeat_status = 'paused'
          elif active:
              heartbeat_status = 'recording'
          else:
              heartbeat_status = 'not-recording'
          record = {
              'schema': PRESSLOG_HEARTBEAT_SCHEMA,
              'boot_id': boot_id(),
              'scope': 'supervisor-process-status-and-ciphertext-metadata-not-core-internal-loop',
              'status': heartbeat_status,
              'service_active': active,
              'service_result': unit.get('result', 'unknown'),
              'recorder_pid': int(unit.get('pid', 0)),
              'status_pid_matches': status_match,
              'paused': paused,
              'events': progress['events'],
              'active_segment': progress['active_segment'],
              'active_segment_size': progress['active_segment_size'],
              'active_segment_mtime_ns': progress['active_segment_mtime_ns'],
              'newest_manifest_mtime_ns': progress['newest_manifest_mtime_ns'],
              'last_event_change_monotonic_ns': int(supervisor.get('last_event_change_monotonic_ns', 0)),
              'last_ciphertext_growth_monotonic_ns': int(supervisor.get('last_ciphertext_growth_monotonic_ns', 0)),
              'last_manifest_change_monotonic_ns': int(supervisor.get('last_manifest_change_monotonic_ns', 0)),
              'quiet_input_is_ambiguous': True,
              'updated_at': utc_now(),
              'updated_epoch': int(time.time()),
              'updated_monotonic_ns': now_ns,
              'journal_content_read': False,
              'private_material_read': False,
              'network_used': False,
          }
          atomic_write(ensure_runtime_root() / PRESSLOG_HEARTBEAT_NAME, (json.dumps(record, sort_keys=True, separators=(',', ':')) + '\n').encode('utf-8'))
          supervisor['last_heartbeat_write'] = now_monotonic
          return record
      #@MNX-PART id=99.92.mnx-monsterkey.function.named-indicator-index kind=function title="Python function named_indicator_index"
      def named_indicator_index(name: str) -> int | None:
          if not LIBX11.is_file():
              raise MonsterKeyError(f'libX11 is unavailable: {LIBX11}')
          library = ctypes.CDLL(str(LIBX11))
          library.XOpenDisplay.argtypes = [ctypes.c_char_p]
          library.XOpenDisplay.restype = ctypes.c_void_p
          library.XCloseDisplay.argtypes = [ctypes.c_void_p]
          library.XCloseDisplay.restype = ctypes.c_int
          library.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
          library.XInternAtom.restype = ctypes.c_ulong
          library.XkbGetNamedIndicator.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int), ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
          library.XkbGetNamedIndicator.restype = ctypes.c_int
          handle = library.XOpenDisplay(None)
          if not handle:
              return None
          try:
              atom = library.XInternAtom(handle, name.encode('ascii'), 0)
              if not atom:
                  return None
              index = ctypes.c_int()
              state = ctypes.c_int()
              real = ctypes.c_int()
              if not library.XkbGetNamedIndicator(handle, atom, ctypes.byref(index), ctypes.byref(state), None, ctypes.byref(real)):
                  return None
              if real.value == 0 or index.value < 0 or index.value >= 32:
                  return None
              return int(index.value)
          finally:
              library.XCloseDisplay(handle)

      #@MNX-PART id=99.92.mnx-monsterkey.function.physical-led-state kind=function title="Python function physical_led_state"
      def physical_led_state(indicator_index: int, desired: bool | None = None) -> bool:
          if indicator_index < 0 or indicator_index >= 32:
              raise MonsterKeyError(f'unsafe keyboard LED index: {indicator_index}')
          environment = x11_environment()
          connection = open_display(environment)
          lock_before = False
          lock_after = False
          try:
              lock_before = lock_active(connection)
              if desired is not None:
                  connection.change_keyboard_control(
                      led=indicator_index + 1,
                      led_mode=X.LedModeOn if desired else X.LedModeOff,
                  )
                  connection.sync()
              mask = int(connection.get_keyboard_control().led_mask)
              lock_after = lock_active(connection)
          finally:
              connection.close()
          if lock_after != lock_before:
              set_lock_active(lock_before)
              verification = open_display(environment)
              try:
                  restored_lock = lock_active(verification)
              finally:
                  verification.close()
              if restored_lock != lock_before:
                  raise MonsterKeyError('keyboard LED control changed Caps Lock latch and restoration failed')
              raise MonsterKeyError('keyboard LED control unexpectedly changed the Caps Lock latch')
          return bool(mask & (1 << indicator_index))

      #@MNX-PART id=99.92.mnx-monsterkey.function.qualify-monster-eye-candidate kind=function title="Python function qualify_monster_eye_candidate"
      def qualify_monster_eye_candidate(name: str) -> dict[str, Any] | None:
          indicator_index = named_indicator_index(name)
          if indicator_index is None:
              return None
          original = physical_led_state(indicator_index)
          opposite = not original
          changed = physical_led_state(indicator_index, opposite)
          if changed != opposite:
              current = physical_led_state(indicator_index)
              if current != original:
                  restored = physical_led_state(indicator_index, original)
                  if restored != original:
                      raise MonsterKeyError(f'Monster Eye probe could not restore {name}')
              return None
          restored = physical_led_state(indicator_index, original)
          if restored != original:
              raise MonsterKeyError(f'Monster Eye qualification could not restore {name}')
          return {
              'indicator': name,
              'indicator_index': indicator_index,
              'indicator_number': indicator_index + 1,
              'supported': True,
              'original_state': original,
          }
      #@MNX-PART id=99.92.mnx-monsterkey.function.read-monster-eye-record kind=function title="Python function read_monster_eye_record"
      def read_monster_eye_record() -> dict[str, Any] | None:
          path = ensure_runtime_root() / MONSTER_EYE_NAME
          if not path.exists():
              return None
          try:
              value = json.loads(validated_regular(path).decode('utf-8'))
          except Exception:
              return None
          if not isinstance(value, dict) or value.get('schema') != MONSTER_EYE_SCHEMA:
              return None
          return value

      #@MNX-PART id=99.92.mnx-monsterkey.function.restore-monster-eye-from-record kind=function title="Python function restore_monster_eye_from_record"
      def restore_monster_eye_from_record() -> str:
          record = read_monster_eye_record()
          if not isinstance(record, dict) or record.get('supported') is not True:
              return 'unsupported-or-absent'
          indicator = str(record.get('indicator', 'none'))
          indicator_index = record.get('indicator_index')
          if indicator not in XKB_INDICATOR_CANDIDATES or not isinstance(indicator_index, int) or indicator_index < 0 or indicator_index >= 32:
              return 'invalid-indicator'
          desired = bool(record.get('original_state', False))
          observed = physical_led_state(indicator_index, desired)
          return 'restored' if observed == desired else 'restore-failed'

      #@MNX-PART id=99.92.mnx-monsterkey.function.update-monster-eye kind=function title="Python function update_monster_eye"
      def update_monster_eye(supervisor: dict[str, Any], paused: bool, restore: bool = False) -> dict[str, Any]:
          existing = supervisor.get('monster_eye')
          persisted = read_monster_eye_record()
          if not isinstance(existing, dict):
              if (
                  isinstance(persisted, dict)
                  and persisted.get('supported') is True
                  and persisted.get('indicator') in XKB_INDICATOR_CANDIDATES
                  and isinstance(persisted.get('indicator_index'), int)
                  and 0 <= int(persisted['indicator_index']) < 32
              ):
                  existing = {
                      'indicator': persisted['indicator'],
                      'indicator_index': int(persisted['indicator_index']),
                      'indicator_number': int(persisted['indicator_index']) + 1,
                      'supported': True,
                      'original_state': bool(persisted.get('original_state', False)),
                  }
              else:
                  existing = {
                      'indicator': 'none',
                      'indicator_index': None,
                      'indicator_number': None,
                      'supported': False,
                      'original_state': False,
                  }
                  for candidate in XKB_INDICATOR_CANDIDATES:
                      qualified = qualify_monster_eye_candidate(candidate)
                      if qualified is not None:
                          existing = qualified
                          break
              supervisor['monster_eye'] = existing
          desired = bool(existing.get('original_state', False)) if restore else paused
          observed: bool | None = None
          if existing.get('supported') is True:
              indicator_index = existing.get('indicator_index')
              if not isinstance(indicator_index, int):
                  raise MonsterKeyError('Monster Eye supported state lacks an LED index')
              observed = physical_led_state(indicator_index)
              if observed != desired:
                  observed = physical_led_state(indicator_index, desired)
              if observed != desired:
                  raise MonsterKeyError(f"Monster Eye did not reach requested state on {existing.get('indicator', 'unknown')}")
          record = {
              'schema': MONSTER_EYE_SCHEMA,
              'supported': bool(existing.get('supported')),
              'indicator': existing.get('indicator', 'none'),
              'indicator_index': existing.get('indicator_index'),
              'indicator_number': existing.get('indicator_number'),
              'control_method': 'x11-core-keyboard-led-mask',
              'meaning': 'on-presslog-paused-recording-off',
              'desired_state': desired,
              'observed_state': observed,
              'original_state': bool(existing.get('original_state', False)),
              'caps_lock_latch_preserved': True,
              'hardware_support_qualified': bool(existing.get('supported')),
              'restored': restore and observed == desired,
              'updated_at': utc_now(),
              'updated_monotonic_ns': time.monotonic_ns(),
              'synthetic_input_used': False,
          }
          semantic_keys = (
              'schema', 'supported', 'indicator', 'indicator_index', 'indicator_number',
              'control_method', 'meaning', 'desired_state', 'observed_state',
              'original_state', 'caps_lock_latch_preserved',
              'hardware_support_qualified', 'restored', 'synthetic_input_used',
          )
          if isinstance(persisted, dict) and all(persisted.get(key) == record.get(key) for key in semantic_keys):
              return persisted
          atomic_write(ensure_runtime_root() / MONSTER_EYE_NAME, (json.dumps(record, sort_keys=True, separators=(',', ':')) + '\n').encode('utf-8'))
          return record
      #@MNX-PART id=99.92.mnx-monsterkey.function.read-proc-identity kind=function title="Python function read_proc_identity"
      def read_proc_identity(pid: int) -> dict[str, Any] | None:
          if pid <= 0:
              return None
          stat_path = Path(f"/proc/{pid}/stat")
          status_path = Path(f"/proc/{pid}/status")
          try:
              stat_before = stat_path.read_text(encoding="utf-8", errors="replace")
              closing = stat_before.rfind(")")
              if closing < 0:
                  return None
              fields_before = stat_before[closing + 2:].split()
              if len(fields_before) < 20:
                  return None
              state = fields_before[0]
              start_ticks = int(fields_before[19])
              uid_values: tuple[int, int, int, int] | None = None
              for line in status_path.read_text(encoding="utf-8", errors="replace").splitlines():
                  if line.startswith("Uid:"):
                      values = tuple(int(value) for value in line.split()[1:5])
                      if len(values) == 4:
                          uid_values = values
                      break
              if uid_values is None:
                  return None
              executable = os.readlink(f"/proc/{pid}/exe")
              network_namespace = os.readlink(f"/proc/{pid}/ns/net")
              stat_after = stat_path.read_text(encoding="utf-8", errors="replace")
              closing_after = stat_after.rfind(")")
              fields_after = stat_after[closing_after + 2:].split() if closing_after >= 0 else []
              if len(fields_after) < 20 or int(fields_after[19]) != start_ticks or fields_after[0] == "Z":
                  return None
          except (FileNotFoundError, PermissionError, ProcessLookupError, OSError, ValueError):
              return None
          return {
              "pid": pid,
              "start_ticks": start_ticks,
              "state": state,
              "uid_values": uid_values,
              "executable": executable,
              "network_namespace": network_namespace,
          }


      #@MNX-PART id=99.92.mnx-monsterkey.function.reviewed-qbittorrent-executable kind=function title="Python function reviewed_qbittorrent_executable"
      def reviewed_qbittorrent_executable(executable: str) -> bool:
          path = Path(executable)
          return (
              executable.startswith("/nix/store/")
              and "qbittorrent" in executable.lower()
              and path.name in {"qbittorrent", ".qbittorrent-wrapped"}
          )


      #@MNX-PART id=99.92.mnx-monsterkey.function.qbittorrent-process-inventory kind=function title="Python function qbittorrent_process_inventory"
      def qbittorrent_process_inventory() -> list[dict[str, Any]]:
          try:
              host_network_namespace = os.readlink("/proc/self/ns/net")
          except OSError as error:
              raise MonsterKeyError(f"cannot identify the host network namespace: {error}") from error
          records: list[dict[str, Any]] = []
          for entry in Path("/proc").iterdir():
              if not entry.name.isdigit():
                  continue
              identity = read_proc_identity(int(entry.name))
              if identity is None:
                  continue
              if identity["state"] == "Z" or any(value != EXPECTED_UID for value in identity["uid_values"]):
                  continue
              if not reviewed_qbittorrent_executable(str(identity["executable"])):
                  continue
              identity["host_network_namespace"] = identity["network_namespace"] == host_network_namespace
              records.append(identity)
              if len(records) > 8:
                  raise MonsterKeyError("qBittorrent process inventory exceeded the bounded client count")
          return sorted(records, key=lambda item: (int(item["pid"]), int(item["start_ticks"])))


      #@MNX-PART id=99.92.mnx-monsterkey.function.process-socket-rows kind=function title="Python function process_socket_rows"
      def process_socket_rows(pid: int) -> dict[str, Any]:
          socket_inodes: set[int] = set()
          fd_directory = Path(f"/proc/{pid}/fd")
          fd_readable = True
          try:
              for entry in fd_directory.iterdir():
                  try:
                      target = os.readlink(entry)
                  except (FileNotFoundError, PermissionError, ProcessLookupError, OSError):
                      continue
                  match = re.fullmatch(r"socket:\[(\d+)\]", target)
                  if match:
                      socket_inodes.add(int(match.group(1)))
          except (FileNotFoundError, PermissionError, ProcessLookupError, OSError):
              fd_readable = False
          rows: list[dict[str, Any]] = []
          table_states: dict[str, bool] = {}
          for protocol, filename in (("tcp", "tcp"), ("tcp6", "tcp6"), ("udp", "udp"), ("udp6", "udp6")):
              path = Path(f"/proc/{pid}/net/{filename}")
              try:
                  lines = path.read_text(encoding="ascii", errors="replace").splitlines()[1:]
                  table_states[protocol] = True
              except (FileNotFoundError, PermissionError, ProcessLookupError, OSError):
                  table_states[protocol] = False
                  continue
              if len(lines) > 4096:
                  raise MonsterKeyError(f"qBittorrent {protocol} socket table exceeded the bounded row count")
              for line in lines:
                  fields = line.split()
                  if len(fields) < 10:
                      continue
                  try:
                      local_port = int(fields[1].rsplit(":", 1)[1], 16)
                      state = fields[3].upper()
                      inode = int(fields[9])
                  except (IndexError, ValueError):
                      continue
                  if inode <= 0 or inode not in socket_inodes:
                      continue
                  rows.append({"protocol": protocol, "port": local_port, "state": state})
                  if len(rows) > 256:
                      raise MonsterKeyError("qBittorrent socket evidence exceeded the bounded row count")
          return {
              "fd_readable": fd_readable,
              "table_states": table_states,
              "rows": rows,
          }


      #@MNX-PART id=99.92.mnx-monsterkey.function.inspect-family-qbittorrent kind=function title="Python function inspect_family_qbittorrent"
      def inspect_family_qbittorrent() -> dict[str, Any]:
          clients = qbittorrent_process_inventory()
          host_clients = [item for item in clients if item.get("host_network_namespace") is True]
          result: dict[str, Any] = {
              "schema": "mnx.qbittorrent.family-continuity.v1",
              "client_count": len(clients),
              "host_client_count": len(host_clients),
              "isolated_client_count": len(clients) - len(host_clients),
              "healthy": False,
              "peer_tcp_listener": False,
              "peer_udp_socket": False,
              "webui_tcp_listener": False,
          }
          if len(host_clients) != 1:
              return result
          identity = host_clients[0]
          sockets = process_socket_rows(int(identity["pid"]))
          rows = sockets["rows"]
          result.update({
              "pid": int(identity["pid"]),
              "start_ticks": int(identity["start_ticks"]),
              "socket_fd_readable": sockets["fd_readable"],
              "socket_tables_readable": all(sockets["table_states"].values()),
              "peer_tcp_listener": any(row["protocol"].startswith("tcp") and row["port"] == QBITTORRENT_PEER_PORT and row["state"] == "0A" for row in rows),
              "peer_udp_socket": any(row["protocol"].startswith("udp") and row["port"] == QBITTORRENT_PEER_PORT for row in rows),
              "webui_tcp_listener": any(row["protocol"].startswith("tcp") and row["port"] == QBITTORRENT_WEBUI_PORT and row["state"] == "0A" for row in rows),
          })
          result["healthy"] = bool(
              result["socket_fd_readable"]
              and result["socket_tables_readable"]
              and result["peer_tcp_listener"]
              and result["peer_udp_socket"]
              and result["webui_tcp_listener"]
          )
          return result


      #@MNX-PART id=99.92.mnx-monsterkey.function.qbittorrent-transient-command kind=function title="Python function qbittorrent_transient_command"
      def qbittorrent_transient_command(environment: dict[str, str]) -> list[str]:
          return [
              str(SYSTEMD_RUN), "--user", "--quiet", f"--unit={QBITTORRENT_FAMILY_UNIT}", "--collect",
              "--property=Type=exec", "--property=Restart=always", "--property=RestartSec=3s",
              "--property=StartLimitIntervalSec=0", "--property=KillMode=control-group",
              "--property=TimeoutStopSec=30s", "--property=WorkingDirectory=/home/h0p3",
              "--setenv=HOME=/home/h0p3", "--setenv=USER=h0p3", "--setenv=LOGNAME=h0p3",
              f"--setenv=DISPLAY={environment['DISPLAY']}",
              f"--setenv=XAUTHORITY={environment['XAUTHORITY']}",
              f"--setenv=XDG_RUNTIME_DIR={environment['XDG_RUNTIME_DIR']}",
              f"--setenv=DBUS_SESSION_BUS_ADDRESS={environment['DBUS_SESSION_BUS_ADDRESS']}",
              "--setenv=QT_QPA_PLATFORM=xcb", "--setenv=LANG=C.UTF-8", "--setenv=LC_ALL=C.UTF-8",
              "--", str(QBITTORRENT_FAMILY), "--no-splash",
          ]


      #@MNX-PART id=99.92.mnx-monsterkey.function.user-systemctl kind=function title="Python function user_systemctl"
      def user_systemctl(environment: dict[str, str], arguments: list[str]) -> subprocess.CompletedProcess[str]:
          return subprocess.run(
              [str(SYSTEMCTL), "--user", *arguments], env=environment,
              stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
              text=True, timeout=15, check=False,
          )


      #@MNX-PART id=99.92.mnx-monsterkey.function.start-family-qbittorrent kind=function title="Python function start_family_qbittorrent"
      def start_family_qbittorrent(environment: dict[str, str]) -> str:
          if not QBITTORRENT_FAMILY.is_file() or not os.access(QBITTORRENT_FAMILY, os.X_OK):
              raise MonsterKeyError(f"qBittorrent family binary is unavailable: {QBITTORRENT_FAMILY}")
          shown = user_systemctl(environment, ["show", QBITTORRENT_FAMILY_UNIT, "-p", "LoadState", "-p", "ActiveState"])
          properties = dict(line.split("=", 1) for line in shown.stdout.splitlines() if "=" in line)
          if properties.get("LoadState") == "loaded":
              if properties.get("ActiveState") in {"active", "activating", "reloading"}:
                  return "existing-transient-unit-active"
              user_systemctl(environment, ["reset-failed", QBITTORRENT_FAMILY_UNIT])
              started = user_systemctl(environment, ["start", QBITTORRENT_FAMILY_UNIT])
              if started.returncode != 0:
                  raise MonsterKeyError(f"qBittorrent continuity unit restart failed: {bounded_text(started.stderr).strip()}")
              return "existing-transient-unit-started"
          completed = subprocess.run(
              qbittorrent_transient_command(environment), env=environment,
              stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
              text=True, timeout=20, check=False,
          )
          if completed.returncode != 0:
              detail = bounded_text(completed.stderr or completed.stdout).strip()
              raise MonsterKeyError(f"qBittorrent continuity unit creation failed: {detail or completed.returncode}")
          return "transient-user-unit-created"


      #@MNX-PART id=99.92.mnx-monsterkey.function.supervise-family-qbittorrent kind=function title="Python function supervise_family_qbittorrent"
      def supervise_family_qbittorrent(supervisor: dict[str, Any], environment: dict[str, str], force: bool = False) -> None:
          now = time.monotonic()
          if not force and now - float(supervisor.get("qbittorrent_last_check", 0.0)) < QBITTORRENT_GUARD_SECONDS:
              return
          supervisor["qbittorrent_last_check"] = now
          evidence = inspect_family_qbittorrent()
          state = "ready" if evidence.get("healthy") is True else (
              "absent" if evidence.get("client_count") == 0 else "partial-or-ambiguous"
          )
          previous = supervisor.get("qbittorrent_state")
          supervisor["qbittorrent_state"] = state
          if state == "ready":
              if previous != state:
                  print(f"qbittorrent_family_guard=ready pid={evidence.get('pid')} start_ticks={evidence.get('start_ticks')}", flush=True)
              supervisor.pop("qbittorrent_review_notice", None)
              return
          if evidence.get("client_count") != 0:
              last_notice = float(supervisor.get("qbittorrent_review_notice", 0.0))
              if previous != state or now - last_notice >= REVIEW_LOG_INTERVAL_SECONDS:
                  print(
                      "qbittorrent_family_guard=review "
                      f"client_count={evidence.get('client_count')} host_client_count={evidence.get('host_client_count')} "
                      f"tcp={evidence.get('peer_tcp_listener')} udp={evidence.get('peer_udp_socket')} webui={evidence.get('webui_tcp_listener')}",
                      file=sys.stderr, flush=True,
                  )
                  supervisor["qbittorrent_review_notice"] = now
              return
          if now - float(supervisor.get("qbittorrent_last_start", 0.0)) < QBITTORRENT_START_COOLDOWN_SECONDS:
              return
          action = start_family_qbittorrent(environment)
          supervisor["qbittorrent_last_start"] = now
          print(f"qbittorrent_family_guard=start-requested action={action}", flush=True)
          notify("qBittorrent continuity recovery", "The family qBittorrent service was absent; Monsternix started the exact package under a restart-supervised user unit.", "normal")


      #@MNX-PART id=99.92.mnx-monsterkey.function.parse-xrandr-outputs kind=function title="Python function parse_xrandr_outputs"
      def parse_xrandr_outputs(output: str) -> list[dict[str, Any]]:
          encoded = output.encode("utf-8", errors="replace")
          if len(encoded) > MAX_COMMAND_OUTPUT:
              raise MonsterKeyError("xrandr output exceeded the bounded parser input")
          records: list[dict[str, Any]] = []
          current: dict[str, Any] | None = None
          connected = re.compile(r"^(\S+)\s+connected(?:\s+(primary))?\s+(\d+)x(\d+)([+-]\d+)([+-]\d+)(?:\s|$)")
          mode_line = re.compile(r"^\s+(\d+x\d+)\s+(.+)$")
          for line in output.splitlines():
              match = connected.match(line)
              if match:
                  current = {
                      "name": match.group(1), "primary": match.group(2) == "primary",
                      "width": int(match.group(3)), "height": int(match.group(4)),
                      "x": int(match.group(5)), "y": int(match.group(6)),
                      "mode": f"{match.group(3)}x{match.group(4)}", "rate": None,
                  }
                  records.append(current)
                  if len(records) > 16:
                      raise MonsterKeyError("xrandr active output count exceeded the bound")
                  continue
              if current is None:
                  continue
              mode_match = mode_line.match(line)
              if mode_match and mode_match.group(1) == current["mode"]:
                  rate_match = re.search(r"([0-9]+(?:[.][0-9]+)?)\*", mode_match.group(2))
                  if rate_match:
                      current["rate"] = rate_match.group(1)
          names = [str(item["name"]) for item in records]
          if len(names) != len(set(names)) or any(item["width"] <= 0 or item["height"] <= 0 for item in records):
              raise MonsterKeyError("xrandr active output topology is invalid")
          return records


      #@MNX-PART id=99.92.mnx-monsterkey.function.select-output-for-rectangle kind=function title="Python function select_output_for_rectangle"
      def select_output_for_rectangle(outputs: list[dict[str, Any]], rectangle: tuple[int, int, int, int]) -> dict[str, Any] | None:
          window_x, window_y, window_width, window_height = rectangle
          if window_width <= 0 or window_height <= 0:
              return None
          center_x = window_x + window_width / 2.0
          center_y = window_y + window_height / 2.0
          ranked: list[tuple[int, int, int, dict[str, Any]]] = []
          for item in outputs:
              left = max(window_x, int(item["x"]))
              top = max(window_y, int(item["y"]))
              right = min(window_x + window_width, int(item["x"]) + int(item["width"]))
              bottom = min(window_y + window_height, int(item["y"]) + int(item["height"]))
              area = max(0, right - left) * max(0, bottom - top)
              center_inside = int(
                  int(item["x"]) <= center_x < int(item["x"]) + int(item["width"])
                  and int(item["y"]) <= center_y < int(item["y"]) + int(item["height"])
              )
              ranked.append((area, center_inside, int(bool(item.get("primary"))), item))
          ranked.sort(key=lambda value: (value[0], value[1], value[2], str(value[3]["name"])), reverse=True)
          return ranked[0][3] if ranked and (ranked[0][0] > 0 or ranked[0][1] > 0) else None


      #@MNX-PART id=99.92.mnx-monsterkey.function.kodi-window-rectangles kind=function title="Python function kodi_window_rectangles"
      def kodi_window_rectangles(connection: xdisplay.Display) -> list[dict[str, Any]]:
          root = connection.screen().root
          window_ids: list[int] = []
          for property_name in ("_NET_CLIENT_LIST_STACKING", "_NET_CLIENT_LIST"):
              atom = connection.intern_atom(property_name, only_if_exists=True)
              if not atom:
                  continue
              value = root.get_full_property(atom, X.AnyPropertyType)
              if value is not None:
                  window_ids = [int(item) for item in value.value]
                  break
          if not window_ids:
              try:
                  window_ids = [int(item.id) for item in root.query_tree().children]
              except Exception:
                  window_ids = []
          active_id = 0
          active_atom = connection.intern_atom("_NET_ACTIVE_WINDOW", only_if_exists=True)
          if active_atom:
              active_value = root.get_full_property(active_atom, X.AnyPropertyType)
              if active_value is not None and len(active_value.value):
                  active_id = int(active_value.value[0])
          records: list[dict[str, Any]] = []
          for window_id in window_ids[:512]:
              try:
                  window = connection.create_resource_object("window", window_id)
                  attributes = window.get_attributes()
                  if attributes.map_state != X.IsViewable:
                      continue
                  classes = window.get_wm_class() or ()
                  title = window.get_wm_name() or ""
                  identity = " ".join([str(value) for value in classes] + [str(title)]).lower()
                  if "kodi" not in identity:
                      continue
                  geometry = window.get_geometry()
                  translated = window.translate_coords(root, 0, 0)
                  x_value = int(getattr(translated, "dst_x", getattr(translated, "x", 0)))
                  y_value = int(getattr(translated, "dst_y", getattr(translated, "y", 0)))
                  width = int(geometry.width)
                  height = int(geometry.height)
                  if width <= 0 or height <= 0:
                      continue
                  records.append({
                      "window_id": window_id, "x": x_value, "y": y_value,
                      "width": width, "height": height, "active": window_id == active_id,
                  })
              except (xerror.XError, OSError, ValueError, TypeError):
                  continue
          records.sort(key=lambda item: (int(item["active"]), item["width"] * item["height"], item["window_id"]), reverse=True)
          return records


      #@MNX-PART id=99.92.mnx-monsterkey.function.current-xrandr-outputs kind=function title="Python function current_xrandr_outputs"
      def current_xrandr_outputs(environment: dict[str, str]) -> list[dict[str, Any]]:
          completed = subprocess.run(
              [str(XRANDR), "--display", environment["DISPLAY"], "--query", "--current"],
              env=environment, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
              text=True, timeout=10, check=False,
          )
          if completed.returncode != 0:
              raise MonsterKeyError(f"xrandr query failed: {bounded_text(completed.stderr).strip() or completed.returncode}")
          return parse_xrandr_outputs(completed.stdout)


      #@MNX-PART id=99.92.mnx-monsterkey.function.kodi-reapply-command kind=function title="Python function kodi_reapply_command"
      def kodi_reapply_command(output: dict[str, Any], environment: dict[str, str]) -> list[str]:
          command = [
              str(XRANDR), "--display", environment["DISPLAY"], "--output", str(output["name"]),
              "--mode", str(output["mode"]),
          ]
          if output.get("rate"):
              command.extend(["--rate", str(output["rate"])])
          return command


      #@MNX-PART id=99.92.mnx-monsterkey.function.kodi-fullscreen-client-message-data kind=function title="Python function kodi_fullscreen_client_message_data"
      def kodi_fullscreen_client_message_data(action: int, fullscreen_atom: int) -> tuple[int, list[int]]:
          if action not in {0, 1} or fullscreen_atom <= 0:
              raise MonsterKeyError("invalid bounded Kodi fullscreen client-message request")
          return (32, [action, fullscreen_atom, 0, 2, 0])


      #@MNX-PART id=99.92.mnx-monsterkey.function.kodi-window-state-atoms kind=function title="Python function kodi_window_state_atoms"
      def kodi_window_state_atoms(connection: xdisplay.Display, window_id: int) -> set[int]:
          state_atom = connection.intern_atom("_NET_WM_STATE", only_if_exists=True)
          if not state_atom:
              return set()
          window = connection.create_resource_object("window", window_id)
          value = window.get_full_property(state_atom, X.AnyPropertyType)
          if value is None:
              return set()
          return {int(item) for item in value.value}


      #@MNX-PART id=99.92.mnx-monsterkey.function.kodi-window-is-fullscreen kind=function title="Python function kodi_window_is_fullscreen"
      def kodi_window_is_fullscreen(connection: xdisplay.Display, window_id: int) -> bool:
          fullscreen_atom = connection.intern_atom("_NET_WM_STATE_FULLSCREEN", only_if_exists=True)
          return bool(fullscreen_atom and int(fullscreen_atom) in kodi_window_state_atoms(connection, window_id))


      #@MNX-PART id=99.92.mnx-monsterkey.function.kodi-fullscreen-reentry-decision kind=function title="Python function kodi_fullscreen_reentry_decision"
      def kodi_fullscreen_reentry_decision(
          current_window_id: int,
          current_fullscreen: bool,
          previous_window_id: Any,
          previous_fullscreen: Any,
          previous_observed_monotonic: Any,
          now: float,
      ) -> dict[str, Any]:
          previous_age: float | None = None
          if isinstance(previous_observed_monotonic, (int, float)) and not isinstance(previous_observed_monotonic, bool):
              previous_age = max(0.0, now - float(previous_observed_monotonic))
          identity_matched = bool(
              current_window_id > 0
              and isinstance(previous_window_id, int)
              and previous_window_id == current_window_id
          )
          prior_qualified = bool(
              identity_matched
              and previous_fullscreen is True
              and previous_age is not None
              and previous_age <= KODI_FULLSCREEN_CONTINUITY_SECONDS
          )
          if current_fullscreen:
              authority = "current-x11-state"
          elif prior_qualified:
              authority = "prior-same-window-fullscreen-observation"
          else:
              authority = "none"
          return {
              "reentry_required": bool(current_fullscreen or prior_qualified),
              "authority": authority,
              "current_fullscreen_observed": bool(current_fullscreen),
              "prior_fullscreen_observed": previous_fullscreen if isinstance(previous_fullscreen, bool) else None,
              "prior_window_identity_matched": identity_matched,
              "prior_observation_age_seconds": round(previous_age, 3) if previous_age is not None else None,
              "prior_observation_fresh": bool(previous_age is not None and previous_age <= KODI_FULLSCREEN_CONTINUITY_SECONDS),
          }


      #@MNX-PART id=99.92.mnx-monsterkey.function.update-kodi-fullscreen-intent kind=function title="Python function update_kodi_fullscreen_intent"
      def update_kodi_fullscreen_intent(
          supervisor: dict[str, Any],
          window_id: int,
          current_fullscreen: bool,
          now: float,
      ) -> bool:
          if current_fullscreen:
              supervisor["kodi_fullscreen_intent_window_id"] = window_id
              supervisor["kodi_fullscreen_intent_monotonic"] = now
              return True
          prior_window_id = supervisor.get("kodi_fullscreen_intent_window_id")
          prior_monotonic = supervisor.get("kodi_fullscreen_intent_monotonic")
          prior_age: float | None = None
          if isinstance(prior_monotonic, (int, float)) and not isinstance(prior_monotonic, bool):
              prior_age = max(0.0, now - float(prior_monotonic))
          retained = bool(
              window_id > 0
              and isinstance(prior_window_id, int)
              and prior_window_id == window_id
              and prior_age is not None
              and prior_age <= KODI_FULLSCREEN_CONTINUITY_SECONDS
          )
          if not retained:
              supervisor.pop("kodi_fullscreen_intent_window_id", None)
              supervisor.pop("kodi_fullscreen_intent_monotonic", None)
          return retained


      #@MNX-PART id=99.92.mnx-monsterkey.function.send-kodi-fullscreen-state kind=function title="Python function send_kodi_fullscreen_state"
      def send_kodi_fullscreen_state(connection: xdisplay.Display, window_id: int, enabled: bool) -> None:
          state_atom = connection.intern_atom("_NET_WM_STATE", only_if_exists=False)
          fullscreen_atom = connection.intern_atom("_NET_WM_STATE_FULLSCREEN", only_if_exists=False)
          window = connection.create_resource_object("window", window_id)
          message = xevent.ClientMessage(
              window=window,
              client_type=state_atom,
              data=kodi_fullscreen_client_message_data(1 if enabled else 0, int(fullscreen_atom)),
          )
          connection.screen().root.send_event(
              message,
              event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask,
          )
          connection.flush()


      #@MNX-PART id=99.92.mnx-monsterkey.function.wait-for-kodi-fullscreen-state kind=function title="Python function wait_for_kodi_fullscreen_state"
      def wait_for_kodi_fullscreen_state(connection: xdisplay.Display, window_id: int, expected: bool, timeout: float) -> bool:
          deadline = time.monotonic() + timeout
          while time.monotonic() < deadline:
              try:
                  connection.sync()
                  if kodi_window_is_fullscreen(connection, window_id) is expected:
                      return True
              except (xerror.XError, OSError, ValueError, TypeError):
                  return False
              time.sleep(0.05)
          return False


      #@MNX-PART id=99.92.mnx-monsterkey.function.kodi-rectangle-matches-output kind=function title="Python function kodi_rectangle_matches_output"
      def kodi_rectangle_matches_output(window: dict[str, Any], output: dict[str, Any], tolerance: int = KODI_GEOMETRY_TOLERANCE_PIXELS) -> bool:
          return all(
              abs(int(window[key]) - int(output[output_key])) <= tolerance
              for key, output_key in (("x", "x"), ("y", "y"), ("width", "width"), ("height", "height"))
          )


      #@MNX-PART id=99.92.mnx-monsterkey.function.kodi-output-geometry-metrics kind=function title="Python function kodi_output_geometry_metrics"
      def kodi_output_geometry_metrics(window: dict[str, Any], output: dict[str, Any]) -> dict[str, Any]:
          window_x, window_y = int(window["x"]), int(window["y"])
          window_width, window_height = int(window["width"]), int(window["height"])
          output_x, output_y = int(output["x"]), int(output["y"])
          output_width, output_height = int(output["width"]), int(output["height"])
          if min(window_width, window_height, output_width, output_height) <= 0:
              raise MonsterKeyError("Kodi geometry metrics received a nonpositive rectangle")
          left = max(window_x, output_x)
          top = max(window_y, output_y)
          right = min(window_x + window_width, output_x + output_width)
          bottom = min(window_y + window_height, output_y + output_height)
          intersection = max(0, right - left) * max(0, bottom - top)
          window_area = window_width * window_height
          output_area = output_width * output_height
          window_coverage = intersection / window_area
          output_coverage = intersection / output_area
          return {
              "target_window_coverage_ratio": round(window_coverage, 6),
              "target_output_coverage_ratio": round(output_coverage, 6),
              "fullscreen_like_geometry": bool(window_coverage >= 0.90 and output_coverage >= 0.90),
          }


      #@MNX-PART id=99.92.mnx-monsterkey.function.reset-kodi-output-receipt-generation kind=function title="Python function reset_kodi_output_receipt_generation"
      def reset_kodi_output_receipt_generation() -> str:
          path = ensure_runtime_root() / KODI_OUTPUT_RECEIPT_NAME
          if not path.exists() and not path.is_symlink():
              return "absent"
          info = path.lstat()
          if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
              raise MonsterKeyError("refusing unsafe stale Kodi output receipt object")
          if info.st_uid != EXPECTED_UID or stat.S_IMODE(info.st_mode) != 0o600:
              raise MonsterKeyError("refusing unsafe stale Kodi output receipt metadata")
          current = False
          try:
              record = json.loads(validated_regular(path).decode("utf-8"))
              current = bool(
                  isinstance(record, dict)
                  and record.get("schema") == KODI_OUTPUT_RECEIPT_SCHEMA
                  and record.get("service_pid") == os.getpid()
                  and record.get("guardian_program") == str(PROGRAM_PATH)
                  and record.get("guardian_build_revision") == GUARDIAN_BUILD_REVISION
              )
          except (UnicodeDecodeError, json.JSONDecodeError, MonsterKeyError):
              current = False
          if current:
              return "current"
          path.unlink()
          print("kodi_output_follow_generation_reset=stale-receipt-removed", flush=True)
          return "removed"


      #@MNX-PART id=99.92.mnx-monsterkey.function.wait-for-kodi-window-on-output kind=function title="Python function wait_for_kodi_window_on_output"
      def wait_for_kodi_window_on_output(connection: xdisplay.Display, outputs: list[dict[str, Any]], output_name: str, timeout: float) -> dict[str, Any] | None:
          deadline = time.monotonic() + timeout
          while time.monotonic() < deadline:
              for window in kodi_window_rectangles(connection):
                  selected = select_output_for_rectangle(
                      outputs,
                      (int(window["x"]), int(window["y"]), int(window["width"]), int(window["height"])),
                  )
                  if selected is not None and str(selected["name"]) == output_name:
                      return window
              time.sleep(0.05)
          return None


      #@MNX-PART id=99.92.mnx-monsterkey.function.write-kodi-output-receipt kind=function title="Python function write_kodi_output_receipt"
      def write_kodi_output_receipt(record: dict[str, Any]) -> None:
          payload = {
              "schema": KODI_OUTPUT_RECEIPT_SCHEMA,
              "recorded_at": dt.datetime.now(dt.timezone.utc).isoformat(),
              "service_pid": os.getpid(),
              "guardian_program": str(PROGRAM_PATH),
              "guardian_build_revision": GUARDIAN_BUILD_REVISION,
              "qbittorrent_mutated": False,
              "i3_configuration_mutated": False,
              "kodi_configuration_mutated": False,
              "display_layout_mutated": False,
              "synthetic_input_used": False,
              **record,
          }
          encoded = (json.dumps(payload, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
          if len(encoded) > KODI_OUTPUT_RECEIPT_MAX_BYTES:
              raise MonsterKeyError("Kodi output-follow receipt exceeds the 64 KiB bound")
          atomic_write(ensure_runtime_root() / KODI_OUTPUT_RECEIPT_NAME, encoded)


      #@MNX-PART id=99.92.mnx-monsterkey.function.supervise-kodi-output kind=function title="Python function supervise_kodi_output"
      def supervise_kodi_output(supervisor: dict[str, Any], environment: dict[str, str], connection: xdisplay.Display, force: bool = False) -> None:
          now = time.monotonic()
          if not force and now - float(supervisor.get("kodi_last_check", 0.0)) < KODI_OUTPUT_GUARD_SECONDS:
              return
          supervisor["kodi_last_check"] = now
          windows = kodi_window_rectangles(connection)
          if not windows:
              for key in (
                  "kodi_output", "kodi_window_id", "kodi_fullscreen", "kodi_observed_monotonic", "kodi_geometry",
                  "kodi_fullscreen_intent_window_id", "kodi_fullscreen_intent_monotonic",
              ):
                  supervisor.pop(key, None)
              return
          outputs = current_xrandr_outputs(environment)
          window_before = windows[0]
          window_id_before = int(window_before["window_id"])
          current_fullscreen = kodi_window_is_fullscreen(connection, window_id_before)
          geometry_before = [int(window_before[key]) for key in ("x", "y", "width", "height")]
          selected = select_output_for_rectangle(
              outputs,
              (int(window_before["x"]), int(window_before["y"]), int(window_before["width"]), int(window_before["height"])),
          )
          if selected is None:
              raise MonsterKeyError("Kodi window does not intersect an active RandR output")
          output_name = str(selected["name"])
          previous = supervisor.get("kodi_output")
          update_kodi_fullscreen_intent(supervisor, window_id_before, current_fullscreen, now)
          if previous is None:
              geometry_metrics = kodi_output_geometry_metrics(window_before, selected)
              supervisor.update({
                  "kodi_output": output_name,
                  "kodi_window_id": window_id_before,
                  "kodi_fullscreen": current_fullscreen,
                  "kodi_observed_monotonic": now,
                  "kodi_geometry": geometry_before,
              })
              write_kodi_output_receipt({
                  "status": "baseline", "event": "initial-observation", "previous_output": None,
                  "target_output": output_name, "target_mode": str(selected["mode"]),
                  "target_rate": selected.get("rate"), "window_id_before": window_id_before,
                  "window_id_after": window_id_before,
                  "geometry_before": geometry_before, "geometry_after": geometry_before,
                  "xrandr_current_mode_reapplied": False,
                  "fullscreen_before": current_fullscreen,
                  "fullscreen_current_observed": current_fullscreen,
                  "fullscreen_prior_observed": None,
                  "fullscreen_prior_identity_matched": False,
                  "fullscreen_prior_observation_age_seconds": None,
                  "fullscreen_reentry_authority": "initial-current-state",
                  "fullscreen_cycle_attempted": False, "fullscreen_removed": False,
                  "fullscreen_restored": current_fullscreen,
                  "target_geometry_matched": kodi_rectangle_matches_output(window_before, selected),
                  **geometry_metrics,
              })
              print(f"kodi_output_follow=baseline output={output_name} mode={selected['mode']} rate={selected.get('rate') or 'unchanged'}", flush=True)
              return
          if previous == output_name:
              supervisor.update({
                  "kodi_window_id": window_id_before,
                  "kodi_fullscreen": current_fullscreen,
                  "kodi_observed_monotonic": now,
                  "kodi_geometry": geometry_before,
              })
              return
          if now - float(supervisor.get("kodi_last_reapply", 0.0)) < KODI_OUTPUT_REAPPLY_COOLDOWN_SECONDS:
              return
          decision = kodi_fullscreen_reentry_decision(
              window_id_before,
              current_fullscreen,
              supervisor.get("kodi_fullscreen_intent_window_id"),
              True if supervisor.get("kodi_fullscreen_intent_monotonic") is not None else None,
              supervisor.get("kodi_fullscreen_intent_monotonic"),
              now,
          )
          fullscreen_before = bool(decision["reentry_required"])
          geometry_metrics_before = kodi_output_geometry_metrics(window_before, selected)
          base_receipt = {
              "event": "cross-output", "previous_output": str(previous), "target_output": output_name,
              "target_mode": str(selected["mode"]), "target_rate": selected.get("rate"),
              "window_id_before": window_id_before,
              "geometry_before": geometry_before,
              "xrandr_current_mode_reapplied": False, "fullscreen_before": fullscreen_before,
              "fullscreen_current_observed": bool(decision["current_fullscreen_observed"]),
              "fullscreen_prior_observed": decision["prior_fullscreen_observed"],
              "fullscreen_prior_identity_matched": bool(decision["prior_window_identity_matched"]),
              "fullscreen_prior_observation_age_seconds": decision["prior_observation_age_seconds"],
              "fullscreen_reentry_authority": str(decision["authority"]),
              "fullscreen_cycle_attempted": fullscreen_before, "fullscreen_removed": False,
              "fullscreen_restored": False, "target_geometry_matched": False,
              **geometry_metrics_before,
          }
          supervisor["kodi_last_reapply"] = now
          try:
              completed = subprocess.run(
                  kodi_reapply_command(selected, environment), env=environment,
                  stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                  text=True, timeout=15, check=False,
              )
              if completed.returncode != 0:
                  raise MonsterKeyError(f"Kodi target-output mode reapply failed: {bounded_text(completed.stderr).strip() or completed.returncode}")
              base_receipt["xrandr_current_mode_reapplied"] = True
              window_after = wait_for_kodi_window_on_output(
                  connection, outputs, output_name, KODI_WINDOW_SETTLE_TIMEOUT_SECONDS,
              )
              if window_after is None:
                  raise MonsterKeyError("Kodi window did not settle on the destination output after RandR reapply")
              if fullscreen_before:
                  window_id = int(window_after["window_id"])
                  if kodi_window_is_fullscreen(connection, window_id):
                      send_kodi_fullscreen_state(connection, window_id, False)
                      if not wait_for_kodi_fullscreen_state(
                              connection, window_id, False, KODI_FULLSCREEN_TRANSITION_TIMEOUT_SECONDS):
                          raise MonsterKeyError("Kodi fullscreen state did not clear during destination-output reentry")
                  base_receipt["fullscreen_removed"] = True
                  send_kodi_fullscreen_state(connection, window_id, True)
                  if not wait_for_kodi_fullscreen_state(
                          connection, window_id, True, KODI_FULLSCREEN_TRANSITION_TIMEOUT_SECONDS):
                      raise MonsterKeyError("Kodi fullscreen state did not restore on the destination output")
                  base_receipt["fullscreen_restored"] = True
                  window_after = wait_for_kodi_window_on_output(
                      connection, outputs, output_name, KODI_WINDOW_SETTLE_TIMEOUT_SECONDS,
                  )
                  if window_after is None:
                      raise MonsterKeyError("Kodi fullscreen window was not reacquired on the destination output")
              final_fullscreen = kodi_window_is_fullscreen(connection, int(window_after["window_id"]))
              geometry_matched = kodi_rectangle_matches_output(window_after, selected)
              geometry_metrics_after = kodi_output_geometry_metrics(window_after, selected)
              base_receipt.update({
                  "status": "pass", "window_id_after": int(window_after["window_id"]),
                  "geometry_after": [int(window_after[key]) for key in ("x", "y", "width", "height")],
                  "fullscreen_restored": final_fullscreen if fullscreen_before else False,
                  "target_geometry_matched": geometry_matched,
                  **geometry_metrics_after,
              })
              if fullscreen_before and (not final_fullscreen or not geometry_matched):
                  raise MonsterKeyError("Kodi fullscreen state or geometry did not match the destination output")
              write_kodi_output_receipt(base_receipt)
              observed_after = time.monotonic()
              update_kodi_fullscreen_intent(
                  supervisor, int(window_after["window_id"]), final_fullscreen, observed_after,
              )
              supervisor.update({
                  "kodi_output": output_name,
                  "kodi_window_id": int(window_after["window_id"]),
                  "kodi_fullscreen": final_fullscreen,
                  "kodi_observed_monotonic": observed_after,
                  "kodi_geometry": base_receipt["geometry_after"],
              })
              print(
                  f"kodi_output_follow=pass previous={previous} output={output_name} mode={selected['mode']} "
                  f"rate={selected.get('rate') or 'unchanged'} fullscreen_reentry={str(fullscreen_before).lower()} "
                  f"authority={decision['authority']} geometry_matched={str(geometry_matched).lower()}",
                  flush=True,
              )
