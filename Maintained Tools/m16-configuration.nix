      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      export PATH=/run/wrappers/bin:${pkgs.bash}/bin:${pkgs.coreutils}/bin:${pkgs.findutils}/bin:${pkgs.gawk}/bin:${pkgs.gnugrep}/bin:${pkgs.gnused}/bin:${pkgs.util-linux}/bin:${pkgs.systemd}/bin:${pkgs.nix}/bin:${pkgs.procps}/bin:/run/current-system/sw/bin
      set -Eeuo pipefail
      export LC_ALL=C SYSTEMD_PAGER=cat SYSTEMD_COLORS=0 PAGER=cat
      umask 027

      ROOT=/var/lib/logbook/baselines
      COMMAND="''${1:-help}"
      shift || true

      #@MNX-PART id=99.40.mnx-behavior-manifest.function.validate_name kind=function title="Function validate_name"
      validate_name() {
        [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "invalid baseline name: $1" >&2; exit 64; }
      }

      #@MNX-PART id=99.40.mnx-behavior-manifest.function.normalize_stream kind=function title="Function normalize_stream"
      normalize_stream() {
        sed -E \
          -e 's#/nix/store/[0-9a-z]{32}-[^/[:space:]";}]*(/[^[:space:]";}]*)?#/nix/store/<STORE>\1#g' \
          -e 's/[[:space:]]+$//' \
          -e '/^# \/(etc|nix\/store)\//d' \
          -e '/^[[:space:]]*#@MNX-PART /d' \
          -e '/^[[:space:]]*$/d'
      }

      #@MNX-PART id=99.40.mnx-behavior-manifest.function.normalize_property_stream kind=function title="Function normalize_property_stream"
      normalize_property_stream() {
        gawk -F= '
          function sorted_words(value, count, parts, position, result) {
            count = split(value, parts, /[[:space:]]+/)
            asort(parts)
            result = ""
            for (position = 1; position <= count; position++) {
              if (parts[position] == "") continue
              result = result (result == "" ? "" : " ") parts[position]
            }
            return result
          }
          {
            key = $1
            value = substr($0, length(key) + 2)
            if (key ~ /^(ReadWritePaths|ReadOnlyPaths|InaccessiblePaths|RequiresMountsFor|OnFailure|SuccessExitStatus)$/) {
              value = sorted_words(value)
            }
            print key "=" value
          }
        '
      }

      #@MNX-PART id=99.40.mnx-behavior-manifest.function.normalizer_self_test kind=function title="Function normalizer_self_test"
      normalizer_self_test() {
        local actual expected
        actual="$(printf '%s\n' \
          'ReadWritePaths=/z /a /m' \
          'Type=oneshot' \
          'OnFailure=z.service a.service' | normalize_property_stream)" || return 1
        expected=$'ReadWritePaths=/a /m /z\nType=oneshot\nOnFailure=a.service z.service'
        [[ "$actual" == "$expected" ]] || {
          echo 'MNX_BEHAVIOR_NORMALIZER_SELF_TEST_ERROR: canonical property output differs' >&2
          printf 'expected:\n%s\nactual:\n%s\n' "$expected" "$actual" >&2
          return 1
        }
        echo 'MNX_BEHAVIOR_NORMALIZER_SELF_TEST=PASS'
      }

      if [[ "$COMMAND" == normalizer-self-test ]]; then
        normalizer_self_test
        exit 0
      fi

      if [[ ''${EUID:-$(id -u)} -ne 0 ]]; then
        [[ -x /run/wrappers/bin/sudo ]] || { echo '/run/wrappers/bin/sudo is unavailable' >&2; exit 126; }
        exec /run/wrappers/bin/sudo -- /etc/monsternix/bin/mnx-behavior-manifest "$COMMAND" "$@"
      fi

      install -d -m 2750 -o root -g logbook "$ROOT"

      #@MNX-PART id=99.40.mnx-behavior-manifest.function.hash_stream kind=function title="Function hash_stream"
      hash_stream() {
        sha256sum | awk '{print $1}'
      }

      #@MNX-PART id=99.40.mnx-behavior-manifest.function.normalized_file_hash kind=function title="Function normalized_file_hash"
      normalized_file_hash() {
        local result
        if ! result="$(normalize_stream < "$1" | hash_stream)"; then
          echo "MNX_BEHAVIOR_MANIFEST_ERROR: failed to normalize/hash file: $1" >&2
          return 1
        fi
        printf '%s\n' "$result"
      }

      #@MNX-PART id=99.40.mnx-behavior-manifest.function.exec_path_for_unit kind=function title="Function exec_path_for_unit"
      exec_path_for_unit() {
        local raw
        raw="$(systemctl show "$1" -p ExecStart --value 2>/dev/null || true)"
        printf '%s\n' "$raw" | sed -n 's/.*path=\([^ ;}]*\).*/\1/p' | head -n 1
      }

      #@MNX-PART id=99.40.mnx-behavior-manifest.function.emit_unit kind=function title="Function emit_unit"
      emit_unit() {
        local unit="$1" unit_text unit_hash props_hash exec_path exec_hash unit_load
        unit_load="$(systemctl show "$unit" -p LoadState --value 2>/dev/null || true)"
        if [[ "$unit_load" == masked ]]; then
          printf 'unit|%s|load=masked\n' "$unit"
          return 0
        fi
        if ! systemctl cat "$unit" --no-pager >/dev/null 2>&1; then
          printf 'unit|%s|load=missing\n' "$unit"
          return 0
        fi
        if ! unit_text="$(systemctl cat "$unit" --no-pager 2>/dev/null | normalize_stream)"; then
          echo "MNX_BEHAVIOR_MANIFEST_ERROR: failed to normalize rendered unit: $unit" >&2
          return 1
        fi
        if ! unit_hash="$(printf '%s\n' "$unit_text" | hash_stream)"; then
          echo "MNX_BEHAVIOR_MANIFEST_ERROR: failed to hash rendered unit: $unit" >&2
          return 1
        fi
        if ! props_hash="$({
          systemctl show "$unit" \
            -p Type -p User -p Group -p UMask -p Nice -p IOSchedulingClass -p CPUSchedulingPolicy \
            -p TimeoutStartUSec -p TimeoutStopUSec -p KillMode -p Restart -p SuccessExitStatus \
            -p NoNewPrivileges -p PrivateTmp -p ProtectSystem -p ProtectHome -p ProtectKernelTunables \
            -p ProtectKernelModules -p ProtectControlGroups -p RestrictSUIDSGID -p ReadWritePaths \
            -p ReadOnlyPaths -p InaccessiblePaths -p RequiresMountsFor -p OnFailure -p RefuseManualStart \
            -p RandomizedDelayUSec -p AccuracyUSec -p OnActiveUSec -p OnUnitActiveUSec \
            -p Persistent -p WakeSystem -p RemainAfterElapse \
            --no-pager 2>/dev/null
        } | normalize_stream | normalize_property_stream | sort | hash_stream)"; then
          echo "MNX_BEHAVIOR_MANIFEST_ERROR: failed to normalize/hash stable properties: $unit" >&2
          return 1
        fi
        exec_path="$(exec_path_for_unit "$unit")"
        exec_hash=none
        if [[ -n "$exec_path" && -r "$exec_path" ]]; then
          if ! exec_hash="$(normalized_file_hash "$exec_path")"; then
            echo "MNX_BEHAVIOR_MANIFEST_ERROR: failed to hash ExecStart program: $unit" >&2
            return 1
          fi
        fi
        printf 'unit|%s|fragment_sha256=%s|properties_sha256=%s|exec_sha256=%s\n' "$unit" "$unit_hash" "$props_hash" "$exec_hash"
      }

      #@MNX-PART id=99.40.mnx-behavior-manifest.function.apply_manifest_metadata kind=function title="Function apply_manifest_metadata"
      apply_manifest_metadata() {
        local output="$1"
        case "$output" in
          "$ROOT"/*)
            chown root:logbook "$output"
            chmod 0640 "$output"
            ;;
          *)
            chown root:root "$output"
            chmod 0644 "$output"
            ;;
        esac
      }

      #@MNX-PART id=99.40.mnx-behavior-manifest.function.generate_manifest kind=function title="Function generate_manifest"
      generate_manifest() {
        local output="$1"
        local parent base tmp value
        parent="$(dirname "$output")"
        base="$(basename "$output")"
        if [[ ! -d "$parent" ]]; then
          case "$parent" in
            "$ROOT"|"$ROOT"/*) install -d -m 2750 -o root -g logbook "$parent" ;;
            *) mkdir -p "$parent" ;;
          esac
        fi
        tmp="$(mktemp "$parent/.''${base}.tmp.XXXXXX")"
        {
          printf 'mnx_behavior_manifest_version=2\n'

          printf '\n[generated-programs]\n'
          find -L /etc/monsternix/bin -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | sort | while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            program_hash="$(normalized_file_hash "/etc/monsternix/bin/$name")" || return 1
            printf 'program|%s|normalized_sha256=%s\n' "$name" "$program_hash"
          done

          printf '\n[critical-files]\n'
          for file in /etc/btrbk/main.conf /etc/fstab /etc/systemd/journald@logbook.conf /etc/systemd/coredump.conf.d/10-monsternix.conf; do
            if [[ -r "$file" ]]; then
              file_hash="$(normalized_file_hash "$file")" || return 1
              printf 'file|%s|normalized_sha256=%s\n' "$file" "$file_hash"
            else
              printf 'file|%s|missing\n' "$file"
            fi
          done

          printf '\n[units]\n'
          for unit in \
            btrbk-main.service btrbk-main.timer \
            btrbk-archive-to-new-storage.service btrbk-archive-to-new-storage.timer \
            m21-btrfs-pull-backup.service m21-btrfs-pull-backup.timer \
            m16-restic-enrollment-check.service m16-restic-storage-prepare.service \
            m16-restic-repository-init.service m16-rest-server.service \
            m16-backup-m21.service m16-backup-m21.timer \
            m16-restic-maintenance.service m16-restic-maintenance.timer \
            rsync-m16-new-to-old.service rsync-m16-new-to-old.timer \
            duperemove-home.service duperemove-home.timer \
            duperemove-m16-new-storage.service duperemove-m16-new-storage.timer \
            duperemove-m16-old-storage.service duperemove-m16-old-storage.timer \
            hypertext-i2p-sync.service hypertext-i2p-sync.timer \
            monsternix-config-copy.service monsternix-config-copy.path monsternix-config-copy.timer \
            savetrail-jsons.service savetrail-jsons.timer \
            wol-tcsn.service wol-tcsn.timer nix-result-root-cleanup.service nix-result-root-cleanup.timer \
            archiver-local-offline-site.service archiver-local-offline-site.timer \
            mnx-storage-catchup.service mnx-storage-catchup.timer \
            mnx-logbook-prune.service mnx-logbook-prune.timer \
            mnx-storage-health.service mnx-storage-health.timer \
            mnx-swapfile-audit.service mnx-swapfile-audit.timer \
            logbook-incident-scan.service logbook-incident-scan.timer \
            earlyoom.service systemd-oomd.service fstrim.service fstrim.timer \
            'btrfs-scrub--.service' 'btrfs-scrub--.timer' \
            'btrfs-scrub-mnt-m16\x2dnew\x2dstorage.service' 'btrfs-scrub-mnt-m16\x2dnew\x2dstorage.timer'
          do
            emit_unit "$unit" || return 1
          done

          printf '\n[mounts]\n'
          for mount in / /home /nix /nix/store /mnt/m16-backup-nvme /mnt/m16-new-storage /mnt/m16-old-storage /mnt/torrents; do
            if findmnt -rn -T "$mount" >/dev/null 2>&1; then
              findmnt -rn -T "$mount" -o TARGET,SOURCE,FSTYPE,UUID,OPTIONS | sed -E 's/[[:space:]]+/|/g' | sed "s#^#mount|requested=$mount|#"
            else
              printf 'mount|requested=%s|missing\n' "$mount"
            fi
          done

          printf '\n[swap]\n'
          swapon --noheadings --bytes --show=NAME,TYPE,SIZE,PRIO 2>/dev/null | awk '{printf "swap|name=%s|type=%s|size=%s|priority=%s\n", $1,$2,$3,$4}' | sort

          printf '\n[sysctl]\n'
          for key in fs.inotify.max_user_watches kernel.sysrq vm.swappiness vm.page-cluster vm.overcommit_memory; do
            value="$(sysctl -n "$key" 2>/dev/null || echo missing)"
            printf 'sysctl|%s=%s\n' "$key" "$value"
          done
        } > "$tmp"
        apply_manifest_metadata "$tmp"
        mv -f "$tmp" "$output"
      }

      #@MNX-PART id=99.40.mnx-behavior-manifest.function.generate_stable_manifest kind=function title="Function generate_stable_manifest"
      generate_stable_manifest() {
        local output="$1"
        local parent base sample_one sample_two sample_three
        parent="$(dirname "$output")"
        base="$(basename "$output")"
        [[ -d "$parent" ]] || mkdir -p "$parent"
        sample_one="$(mktemp "$parent/.''${base}.sample-one.XXXXXX")"
        sample_two="$(mktemp "$parent/.''${base}.sample-two.XXXXXX")"
        sample_three="$(mktemp "$parent/.''${base}.sample-three.XXXXXX")"

        if ! generate_manifest "$sample_one"; then
          rm -f -- "$sample_one" "$sample_two" "$sample_three"
          return 1
        fi
        sleep 1
        if ! generate_manifest "$sample_two"; then
          rm -f -- "$sample_one" "$sample_two" "$sample_three"
          return 1
        fi
        sleep 1
        if ! generate_manifest "$sample_three"; then
          rm -f -- "$sample_one" "$sample_two" "$sample_three"
          return 1
        fi

        printf 'behavior_manifest_sample_sha256[1]=%s\n' "$(sha256sum "$sample_one" | awk '{print $1}')"
        printf 'behavior_manifest_sample_sha256[2]=%s\n' "$(sha256sum "$sample_two" | awk '{print $1}')"
        printf 'behavior_manifest_sample_sha256[3]=%s\n' "$(sha256sum "$sample_three" | awk '{print $1}')"

        if ! cmp -s "$sample_one" "$sample_two" || ! cmp -s "$sample_two" "$sample_three"; then
          echo 'MNX_BEHAVIOR_MANIFEST_ERROR: three consecutive normalized manifests are not identical' >&2
          diff -u "$sample_one" "$sample_two" >&2 || true
          diff -u "$sample_two" "$sample_three" >&2 || true
          rm -f -- "$sample_one" "$sample_two" "$sample_three"
          return 1
        fi

        mv -f "$sample_one" "$output"
        rm -f -- "$sample_two" "$sample_three"
        apply_manifest_metadata "$output"
        echo 'MNX_BEHAVIOR_MANIFEST_REPEATABILITY=PASS'
      }

      #@MNX-PART id=99.40.mnx-behavior-manifest.function.resolve_baseline kind=function title="Function resolve_baseline"
      resolve_baseline() {
        local name="$1"
        if [[ "$name" == pinned ]]; then
          [[ -L "$ROOT/pinned" ]] || { echo 'no pinned behavior baseline exists' >&2; exit 2; }
          readlink -f "$ROOT/pinned"
        else
          validate_name "$name"
          printf '%s/%s\n' "$ROOT" "$name"
        fi
      }

      #@MNX-PART id=99.40.mnx-behavior-manifest.function.heavy_storage_active kind=function title="Function heavy_storage_active"
      heavy_storage_active() {
        local unit state
        for unit in btrbk-main.service btrbk-archive-to-new-storage.service m21-btrfs-pull-backup.service m16-backup-m21.service m16-restic-maintenance.service rsync-m16-new-to-old.service duperemove-home.service duperemove-m16-new-storage.service 'btrfs-scrub--.service' 'btrfs-scrub-mnt-m16\x2dnew\x2dstorage.service'; do
          state="$(systemctl is-active "$unit" 2>/dev/null || true)"
          case "$state" in active|activating|reloading) printf '%s\n' "$unit"; return 0 ;; esac
        done
        return 1
      }

      case "$COMMAND" in
        generate)
          OUTPUT="''${1:-/dev/stdout}"
          if [[ "$OUTPUT" == /dev/stdout || "$OUTPUT" == - ]]; then
            TMP="$(mktemp)"
            generate_stable_manifest "$TMP"
            cat "$TMP"
            rm -f "$TMP"
          else
            generate_stable_manifest "$OUTPUT"
            printf 'manifest=%s\n' "$OUTPUT"
            sha256sum "$OUTPUT"
          fi
          ;;

        capture)
          NAME="''${1:-pre-refactor}"
          shift || true
          PIN=0
          REPLACE=0
          while (( $# > 0 )); do
            case "$1" in --pin) PIN=1 ;; --replace) REPLACE=1 ;; *) echo "unknown capture option: $1" >&2; exit 64 ;; esac
            shift
          done
          validate_name "$NAME"
          [[ "$(systemctl is-system-running 2>/dev/null || true)" == running ]] || { echo 'system is not running cleanly' >&2; exit 1; }
          [[ "$(readlink -f /run/current-system)" == "$(readlink -f /nix/var/nix/profiles/system)" ]] || { echo 'running generation is not the boot default' >&2; exit 1; }
          [[ -z "$(systemctl --failed --no-legend --plain 2>/dev/null | grep -Ev '^[[:space:]]*$|^[0-9]+ loaded units listed[.]$' || true)" ]] || { echo 'failed units exist' >&2; exit 1; }
          BUSY="$(heavy_storage_active || true)"
          [[ -z "$BUSY" ]] || { echo "heavy storage is active: $BUSY" >&2; exit 75; }
          DIR="$ROOT/$NAME"
          if [[ -e "$DIR" && "$REPLACE" != 1 ]]; then echo "baseline exists: $NAME (use --replace deliberately)" >&2; exit 1; fi
          rm -rf "$DIR.tmp.$$"
          install -d -m 2750 -o root -g logbook "$DIR.tmp.$$"
          generate_stable_manifest "$DIR.tmp.$$/manifest.txt"
          install -m 0640 -o root -g logbook /run/current-system/configuration.nix "$DIR.tmp.$$/configuration.nix"
          {
            printf 'name=%s\n' "$NAME"
            printf 'captured=%s\n' "$(date -Is)"
            printf 'epoch=%s\n' "$(date +%s)"
            printf 'running_system=%s\n' "$(readlink -f /run/current-system)"
            printf 'default_system=%s\n' "$(readlink -f /nix/var/nix/profiles/system)"
            printf 'configuration_sha256=%s\n' "$(sha256sum /run/current-system/configuration.nix | awk '{print $1}')"
            printf 'manifest_sha256=%s\n' "$(sha256sum "$DIR.tmp.$$/manifest.txt" | awk '{print $1}')"
          } > "$DIR.tmp.$$/metadata.txt"
          chown root:logbook "$DIR.tmp.$$/metadata.txt"
          chmod 0640 "$DIR.tmp.$$/metadata.txt"
          [[ ! -e "$DIR" ]] || mv "$DIR" "$ROOT/$NAME.replaced-$(date +%Y%m%dT%H%M%S)"
          mv "$DIR.tmp.$$" "$DIR"
          if (( PIN == 1 )); then ln -sfn "$NAME" "$ROOT/pinned"; fi
          printf 'baseline=%s\nmanifest=%s\npinned=%s\n' "$NAME" "$DIR/manifest.txt" "$PIN"
          cat "$DIR/metadata.txt"
          ;;

        pin)
          NAME="''${1:-}"
          [[ -n "$NAME" ]] || { echo 'usage: mnx baseline pin NAME' >&2; exit 64; }
          validate_name "$NAME"
          [[ -s "$ROOT/$NAME/manifest.txt" ]] || { echo "baseline does not exist: $NAME" >&2; exit 1; }
          ln -sfn "$NAME" "$ROOT/pinned"
          printf 'pinned_baseline=%s\n' "$NAME"
          ;;

        compare)
          NAME="''${1:-pinned}"
          DIR="$(resolve_baseline "$NAME")"
          [[ -s "$DIR/manifest.txt" ]] || { echo "baseline manifest is missing: $DIR/manifest.txt" >&2; exit 2; }
          CURRENT="$ROOT/last-current-manifest.txt"
          DIFF="$ROOT/last-diff.txt"
          generate_stable_manifest "$CURRENT"
          set +e
          diff -u "$DIR/manifest.txt" "$CURRENT" > "$DIFF.tmp.$$"
          RC="$?"
          set -e
          chown root:logbook "$DIFF.tmp.$$"
          chmod 0640 "$DIFF.tmp.$$"
          mv -f "$DIFF.tmp.$$" "$DIFF"
          printf 'baseline=%s\n' "$DIR/manifest.txt"
          printf 'current_manifest=%s\n' "$CURRENT"
          printf 'diff=%s\n' "$DIFF"
          if [[ "$RC" == 0 ]]; then
            echo 'behavior_contract=match'
            exit 0
          fi
          echo 'behavior_contract=DIFFERENT'
          printf 'changed_lines=%s\n' "$(grep -Ec '^[+-][^+-]' "$DIFF" 2>/dev/null || true)"
          sed -n '1,500p' "$DIFF"
          exit 1
          ;;

        repeatability|self-test)
          normalizer_self_test
          DIR="$(mktemp -d /run/mnx-behavior-manifest-repeatability.XXXXXX)"
          trap 'rm -rf -- "$DIR"' EXIT
          generate_stable_manifest "$DIR/manifest.txt"
          printf 'repeatability_manifest=%s\n' "$DIR/manifest.txt"
          sha256sum "$DIR/manifest.txt"
          echo 'MNX_BEHAVIOR_MANIFEST_SELF_TEST=PASS'
          ;;

        properties)
          UNIT="''${1:-}"
          [[ -n "$UNIT" ]] || { echo 'usage: mnx baseline properties UNIT' >&2; exit 64; }
          systemctl show "$UNIT" \\
            -p Type -p User -p Group -p UMask -p Nice -p IOSchedulingClass -p CPUSchedulingPolicy \\
            -p TimeoutStartUSec -p TimeoutStopUSec -p KillMode -p Restart -p SuccessExitStatus \\
            -p NoNewPrivileges -p PrivateTmp -p ProtectSystem -p ProtectHome -p ProtectKernelTunables \\
            -p ProtectKernelModules -p ProtectControlGroups -p RestrictSUIDSGID -p ReadWritePaths \\
            -p ReadOnlyPaths -p InaccessiblePaths -p RequiresMountsFor -p OnFailure -p RefuseManualStart \\
            -p RandomizedDelayUSec -p AccuracyUSec -p OnActiveUSec -p OnUnitActiveUSec \\
            -p Persistent -p WakeSystem -p RemainAfterElapse \\
            --no-pager 2>/dev/null | normalize_stream | normalize_property_stream | sort
          ;;

        show)
          NAME="''${1:-pinned}"
          DIR="$(resolve_baseline "$NAME")"
          cat "$DIR/metadata.txt" 2>/dev/null || true
          cat "$DIR/manifest.txt"
          ;;

        status)
          if [[ -L "$ROOT/pinned" ]]; then
            printf 'pinned_baseline=%s\n' "$(basename "$(readlink -f "$ROOT/pinned")")"
            cat "$(readlink -f "$ROOT/pinned")/metadata.txt" 2>/dev/null || true
          else
            echo 'pinned_baseline=none'
          fi
          find "$ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort | sed 's/^/available_baseline=/'
          ;;

        help|-h|--help)
          cat <<'USAGE'
      mnx baseline repeatability        require three consecutive normalized manifests to match
      mnx baseline properties UNIT         print the exact canonical unit properties being hashed
      mnx baseline capture [NAME] [--pin] [--replace]
                                          capture a clean, repeatable runtime behavior contract
      mnx baseline pin NAME               select the baseline enforced by mnx test
      mnx baseline compare [NAME|pinned]  compare the live system with a baseline
      mnx baseline show [NAME|pinned]     print baseline metadata and manifest
      mnx baseline status                 list and identify the pinned baseline

      The manifest deliberately excludes the configuration source hash, timestamps, active states,
      kernel version, and NixOS version. It fingerprints generated Monsternix programs, critical
      rendered files, normalized systemd units/properties/ExecStart scripts, mount identities/options,
      swap policy, and selected sysctls. It is intended to detect accidental behavior changes while
      configuration.nix is reorganized without imports; language-level refactors remain explicit, source-audited, and behavior-reviewed.
      USAGE
          ;;

        *)
          printf 'unknown behavior-manifest command: %s\n' "$COMMAND" >&2
          exit 64
          ;;
      esac
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            if [ -s "$err" ]; then
              ${pkgs.coreutils}/bin/cat "$err" >&2
              exit 1
            fi
            "$out" normalizer-self-test
            ;;
          '#!'*python*)
            ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
            ;;
          *)
            echo "unsupported generated-script interpreter: $first" >&2
            exit 1
            ;;
        esac
      '';
    };
  };

#@MNX-CHUNK id=99.50 slug=monolith-workbench title="Humpty/Dumpty source split, join, map, search, and bundle workbench"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-monolith" section=99.50 role=generated-program ordinal=270
  environment.etc."monsternix/bin/mnx-monolith" = {
    source = pkgs.writeTextFile {
      name = "mnx-monolith";
      executable = true;
      text = ''
      #!${pkgs.python3}/bin/python3
      from __future__ import annotations

      import argparse
      import gzip
      import hashlib
      import json
      import os
      import re
      import shlex
      import shutil
      import subprocess
      import sys
      import tarfile
      import tempfile
      from dataclasses import dataclass
      from datetime import datetime
      from pathlib import Path
      from typing import Iterable

      MARKER_PREFIX = "#@MNX-CHUNK "
      MARKER_RE = re.compile(r"^#@MNX-CHUNK\s+(.*?)(?:\r?\n)?$")
      ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
      SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
      MANIFEST_NAME = "manifest.json"
      README_NAME = "README.txt"
      DEFAULT_CONFIG = Path("/etc/nixos/configuration.nix")


      #@MNX-PART id=99.50.mnx-monolith.class.monolitherror kind=class title="Python class MonolithError"
      class MonolithError(RuntimeError):
          pass


      @dataclass(frozen=True)
      #@MNX-PART id=99.50.mnx-monolith.class.chunk kind=class title="Python class Chunk"
      class Chunk:
          order: int
          chunk_id: str
          slug: str
          title: str
          start_line: int
          end_line: int
          data: bytes
          filename: str

          @property
          #@MNX-PART id=99.50.mnx-monolith.function.sha256 kind=function title="Python function sha256"
          def sha256(self) -> str:
              return hashlib.sha256(self.data).hexdigest()

          @property
          #@MNX-PART id=99.50.mnx-monolith.function.size kind=function title="Python function size"
          def size(self) -> int:
              return len(self.data)


      @dataclass(frozen=True)
      #@MNX-PART id=99.50.mnx-monolith.class.parsedmonolith kind=class title="Python class ParsedMonolith"
      class ParsedMonolith:
          source: Path
          data: bytes
          chunks: tuple[Chunk, ...]

          @property
          #@MNX-PART id=99.50.mnx-monolith.function.sha256-2 kind=function title="Python function sha256"
          def sha256(self) -> str:
              return hashlib.sha256(self.data).hexdigest()

          @property
          #@MNX-PART id=99.50.mnx-monolith.function.line_count kind=function title="Python function line_count"
          def line_count(self) -> int:
              return len(self.data.splitlines())


      #@MNX-PART id=99.50.mnx-monolith.function.sha256_bytes kind=function title="Python function sha256_bytes"
      def sha256_bytes(data: bytes) -> str:
          return hashlib.sha256(data).hexdigest()


      #@MNX-PART id=99.50.mnx-monolith.function.sanitize_filename kind=function title="Python function sanitize_filename"
      def sanitize_filename(value: str) -> str:
          return re.sub(r"[^A-Za-z0-9._-]+", "-", value).strip("-") or "chunk"


      #@MNX-PART id=99.50.mnx-monolith.function.parse_marker kind=function title="Python function parse_marker"
      def parse_marker(raw_line: bytes, line_number: int) -> tuple[str, str, str] | None:
          try:
              line = raw_line.decode("utf-8")
          except UnicodeDecodeError as exc:
              raise MonolithError(f"source is not valid UTF-8 near line {line_number}: {exc}") from exc
          match = MARKER_RE.match(line)
          if not match:
              return None
          try:
              tokens = shlex.split(match.group(1), posix=True)
          except ValueError as exc:
              raise MonolithError(f"invalid MNX chunk marker at line {line_number}: {exc}") from exc
          fields: dict[str, str] = {}
          for token in tokens:
              if "=" not in token:
                  raise MonolithError(f"invalid marker token at line {line_number}: {token}")
              key, value = token.split("=", 1)
              if key in fields:
                  raise MonolithError(f"duplicate marker field {key} at line {line_number}")
              fields[key] = value
          missing = [key for key in ("id", "slug", "title") if not fields.get(key)]
          if missing:
              raise MonolithError(f"marker at line {line_number} lacks: {', '.join(missing)}")
          chunk_id = fields["id"]
          slug = fields["slug"]
          title = fields["title"]
          if not ID_RE.fullmatch(chunk_id):
              raise MonolithError(f"invalid chunk id at line {line_number}: {chunk_id}")
          if not SLUG_RE.fullmatch(slug):
              raise MonolithError(f"invalid chunk slug at line {line_number}: {slug}")
          return chunk_id, slug, title


      #@MNX-PART id=99.50.mnx-monolith.function.parse_monolith kind=function title="Python function parse_monolith"
      def parse_monolith(path: Path) -> ParsedMonolith:
          if not path.is_file():
              raise MonolithError(f"configuration is not a regular file: {path}")
          data = path.read_bytes()
          lines = data.splitlines(keepends=True)
          markers: list[tuple[int, str, str, str]] = []
          ids: set[str] = set()
          slugs: set[str] = set()
          for index, raw_line in enumerate(lines):
              if not raw_line.startswith(MARKER_PREFIX.encode("utf-8")):
                  continue
              parsed = parse_marker(raw_line, index + 1)
              if parsed is None:
                  continue
              chunk_id, slug, title = parsed
              if chunk_id in ids:
                  raise MonolithError(f"duplicate chunk id: {chunk_id}")
              if slug in slugs:
                  raise MonolithError(f"duplicate chunk slug: {slug}")
              ids.add(chunk_id)
              slugs.add(slug)
              markers.append((index, chunk_id, slug, title))
          if not markers:
              raise MonolithError("no #@MNX-CHUNK markers were found")
          chunks: list[Chunk] = []
          if markers[0][0] > 0:
              preamble_data = b"".join(lines[: markers[0][0]])
              chunks.append(
                  Chunk(
                      order=0,
                      chunk_id="__preamble__",
                      slug="preamble",
                      title="Bytes before the first explicit chunk marker",
                      start_line=1,
                      end_line=markers[0][0],
                      data=preamble_data,
                      filename="0000__preamble.nixpart",
                  )
              )
          base_order = len(chunks)
          for offset, (start_index, chunk_id, slug, title) in enumerate(markers):
              end_index = markers[offset + 1][0] if offset + 1 < len(markers) else len(lines)
              chunk_data = b"".join(lines[start_index:end_index])
              order = base_order + offset
              filename = f"{order:04d}__{sanitize_filename(chunk_id)}__{sanitize_filename(slug)}.nixpart"
              chunks.append(
                  Chunk(
                      order=order,
                      chunk_id=chunk_id,
                      slug=slug,
                      title=title,
                      start_line=start_index + 1,
                      end_line=end_index,
                      data=chunk_data,
                      filename=filename,
                  )
              )
          rebuilt = b"".join(chunk.data for chunk in chunks)
          if rebuilt != data:
              raise MonolithError("internal split failed to preserve exact source bytes")
          return ParsedMonolith(source=path.resolve(), data=data, chunks=tuple(chunks))


      #@MNX-PART id=99.50.mnx-monolith.function.manifest_for kind=function title="Python function manifest_for"
      def manifest_for(parsed: ParsedMonolith) -> dict[str, object]:
          return {
              "mnx_monolith_manifest_version": 1,
              "source": str(parsed.source),
              "source_sha256": parsed.sha256,
              "source_bytes": len(parsed.data),
              "source_lines": parsed.line_count,
              "marker_prefix": MARKER_PREFIX.rstrip(),
              "chunks": [
                  {
                      "order": chunk.order,
                      "id": chunk.chunk_id,
                      "slug": chunk.slug,
                      "title": chunk.title,
                      "file": chunk.filename,
                      "start_line": chunk.start_line,
                      "end_line": chunk.end_line,
                      "bytes": chunk.size,
                      "sha256": chunk.sha256,
                  }
                  for chunk in parsed.chunks
              ],
          }


      #@MNX-PART id=99.50.mnx-monolith.function.write_workspace kind=function title="Python function write_workspace"
      def write_workspace(parsed: ParsedMonolith, output: Path) -> Path:
          output = output.resolve()
          if output.exists():
              if not output.is_dir():
                  raise MonolithError(f"output path exists but is not a directory: {output}")
              if any(output.iterdir()):
                  raise MonolithError(f"output directory is not empty: {output}")
          else:
              output.mkdir(parents=True, mode=0o750)
          manifest = manifest_for(parsed)
          for chunk in parsed.chunks:
              (output / chunk.filename).write_bytes(chunk.data)
          (output / MANIFEST_NAME).write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
          (output / README_NAME).write_text(
              "MNX monolith workbench\n"
              "======================\n\n"
              "The .nixpart files concatenate in manifest order to reconstruct the source.\n"
              "Run `mnx humpty join WORKSPACE --out FILE` after editing derived chunks.\n"
              "Run `mnx humpty verify-workspace WORKSPACE` before using the assembled file.\n"
              "The workspace is derived material; configuration.nix remains the source of truth.\n",
              encoding="utf-8",
          )
          return output


      #@MNX-PART id=99.50.mnx-monolith.function.load_manifest kind=function title="Python function load_manifest"
      def load_manifest(workspace: Path) -> dict[str, object]:
          manifest_path = workspace / MANIFEST_NAME
          if not manifest_path.is_file():
              raise MonolithError(f"workspace manifest is missing: {manifest_path}")
          try:
              manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
          except (json.JSONDecodeError, UnicodeDecodeError) as exc:
              raise MonolithError(f"workspace manifest is invalid: {exc}") from exc
          if manifest.get("mnx_monolith_manifest_version") != 1:
              raise MonolithError("unsupported workspace manifest version")
          chunks = manifest.get("chunks")
          if not isinstance(chunks, list) or not chunks:
              raise MonolithError("workspace manifest has no chunks")
          return manifest


      #@MNX-PART id=99.50.mnx-monolith.function.assemble_workspace kind=function title="Python function assemble_workspace"
      def assemble_workspace(workspace: Path) -> tuple[bytes, list[str], dict[str, object]]:
          workspace = workspace.resolve()
          manifest = load_manifest(workspace)
          chunk_entries = sorted(manifest["chunks"], key=lambda item: int(item["order"]))
          assembled = bytearray()
          changed: list[str] = []
          seen_files: set[str] = set()
          expected_order = 0
          for entry in chunk_entries:
              order = int(entry["order"])
              if order != expected_order:
                  raise MonolithError(f"workspace order is not contiguous at {order}; expected {expected_order}")
              expected_order += 1
              filename = str(entry["file"])
              filename_path = Path(filename)
              if filename_path.is_absolute() or filename_path.name != filename or len(filename_path.parts) != 1:
                  raise MonolithError(f"unsafe chunk filename in manifest: {filename}")
              if not filename.endswith(".nixpart"):
                  raise MonolithError(f"unexpected chunk filename suffix in manifest: {filename}")
              if filename in seen_files:
                  raise MonolithError(f"duplicate chunk file in manifest: {filename}")
              seen_files.add(filename)
              path = workspace / filename
              if not path.is_file():
                  raise MonolithError(f"workspace chunk is missing: {path}")
              data = path.read_bytes()
              assembled.extend(data)
              if sha256_bytes(data) != str(entry["sha256"]):
                  changed.append(f"{entry['id']}:{entry['slug']}")
          untracked = sorted(path.name for path in workspace.glob("*.nixpart") if path.name not in seen_files)
          if untracked:
              raise MonolithError("workspace contains untracked .nixpart files: " + ", ".join(untracked))
          return bytes(assembled), changed, manifest


      #@MNX-PART id=99.50.mnx-monolith.function.validate_assembled_bytes kind=function title="Python function validate_assembled_bytes"
      def validate_assembled_bytes(data: bytes) -> ParsedMonolith:
          with tempfile.TemporaryDirectory(prefix="mnx-monolith-validate-") as temp_dir:
              path = Path(temp_dir) / "configuration.nix"
              path.write_bytes(data)
              return parse_monolith(path)


      #@MNX-PART id=99.50.mnx-monolith.function.run_nix_parse kind=function title="Python function run_nix_parse"
      def run_nix_parse(path: Path) -> tuple[str, int]:
          executable = shutil.which("nix-instantiate")
          if not executable:
              return "unavailable", 0
          completed = subprocess.run([executable, "--parse", str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
          if completed.returncode != 0:
              sys.stderr.write(completed.stderr)
              return "failed", completed.returncode
          return "pass", 0


      #@MNX-PART id=99.50.mnx-monolith.function.resolve_chunk kind=function title="Python function resolve_chunk"
      def resolve_chunk(parsed: ParsedMonolith, query: str) -> Chunk:
          exact = [chunk for chunk in parsed.chunks if query in {chunk.chunk_id, chunk.slug}]
          if len(exact) == 1:
              return exact[0]
          partial = [chunk for chunk in parsed.chunks if chunk.chunk_id.startswith(query) or chunk.slug.startswith(query)]
          if len(partial) == 1:
              return partial[0]
          if not partial:
              raise MonolithError(f"no chunk matches: {query}")
          raise MonolithError("ambiguous chunk query: " + query + " -> " + ", ".join(chunk.chunk_id for chunk in partial))


      #@MNX-PART id=99.50.mnx-monolith.function.print_index kind=function title="Python function print_index"
      def print_index(parsed: ParsedMonolith) -> None:
          print(f"source={parsed.source}")
          print(f"source_sha256={parsed.sha256}")
          print(f"source_bytes={len(parsed.data)}")
          print(f"source_lines={parsed.line_count}")
          print(f"chunk_count={len(parsed.chunks)}")
          print("order\tid\tslug\tlines\tbytes\tsha256_12\ttitle")
          for chunk in parsed.chunks:
              line_range = f"{chunk.start_line}-{chunk.end_line}"
              print(f"{chunk.order:04d}\t{chunk.chunk_id}\t{chunk.slug}\t{line_range}\t{chunk.size}\t{chunk.sha256[:12]}\t{chunk.title}")


      #@MNX-PART id=99.50.mnx-monolith.function.command_manifest kind=function title="Python function command_manifest"
      def command_manifest(parsed: ParsedMonolith) -> int:
          print(json.dumps(manifest_for(parsed), indent=2, sort_keys=True))
          return 0


      #@MNX-PART id=99.50.mnx-monolith.function.command_verify kind=function title="Python function command_verify"
      def command_verify(parsed: ParsedMonolith) -> int:
          with tempfile.TemporaryDirectory(prefix="mnx-monolith-roundtrip-") as temp_dir:
              workspace = Path(temp_dir) / "split"
              write_workspace(parsed, workspace)
              assembled, changed, manifest = assemble_workspace(workspace)
              if changed:
                  raise MonolithError("fresh split unexpectedly reports changed chunks")
              if assembled != parsed.data:
                  raise MonolithError("split/join roundtrip changed source bytes")
              if sha256_bytes(assembled) != parsed.sha256:
                  raise MonolithError("split/join roundtrip hash mismatch")
              validate_assembled_bytes(assembled)
              print(f"source={parsed.source}")
              print(f"source_sha256={parsed.sha256}")
              print(f"chunk_count={len(parsed.chunks)}")
              print(f"manifest_version={manifest['mnx_monolith_manifest_version']}")
              print("exact_byte_roundtrip=yes")
              print("MNX_MONOLITH_ROUNDTRIP=PASS")
          return 0


      #@MNX-PART id=99.50.mnx-monolith.function.command_split kind=function title="Python function command_split"
      def command_split(parsed: ParsedMonolith, output: Path | None) -> int:
          if output is None:
              stamp = datetime.now().strftime("%Y%m%dT%H%M%S")
              output = Path(tempfile.gettempdir()) / f"mnx-monolith-{os.getuid()}-{stamp}-{parsed.sha256[:12]}"
          workspace = write_workspace(parsed, output)
          print(f"workspace={workspace}")
          print(f"manifest={workspace / MANIFEST_NAME}")
          print(f"source_sha256={parsed.sha256}")
          print(f"chunk_count={len(parsed.chunks)}")
          print("MNX_MONOLITH_SPLIT=PASS")
          return 0


      #@MNX-PART id=99.50.mnx-monolith.function.command_join kind=function title="Python function command_join"
      def command_join(workspace: Path, output: Path | None, verify_only: bool) -> int:
          assembled, changed, manifest = assemble_workspace(workspace)
          parsed = validate_assembled_bytes(assembled)
          original_sha = str(manifest["source_sha256"])
          assembled_sha = sha256_bytes(assembled)
          if verify_only:
              output_path = None
          else:
              output_path = output or (workspace.resolve() / "assembled-configuration.nix")
              output_path.parent.mkdir(parents=True, exist_ok=True)
              temporary = output_path.with_name(output_path.name + f".tmp.{os.getpid()}")
              temporary.write_bytes(assembled)
              os.chmod(temporary, 0o644)
              os.replace(temporary, output_path)
          print(f"workspace={workspace.resolve()}")
          if output_path is not None:
              print(f"assembled={output_path.resolve()}")
          print(f"original_sha256={original_sha}")
          print(f"assembled_sha256={assembled_sha}")
          print(f"matches_original={'yes' if assembled_sha == original_sha else 'no'}")
          print(f"changed_chunk_count={len(changed)}")
          for value in changed:
              print(f"changed_chunk={value}")
          print(f"assembled_chunk_count={len(parsed.chunks)}")
          if output_path is not None:
              parse_path = output_path
              cleanup_parse_path = False
          else:
              parse_handle = tempfile.NamedTemporaryFile(prefix="mnx-monolith-workspace-", suffix=".nix", delete=False)
              parse_handle.write(assembled)
              parse_handle.close()
              parse_path = Path(parse_handle.name)
              cleanup_parse_path = True
          try:
              nix_status, nix_rc = run_nix_parse(parse_path)
              print(f"nix_parse={nix_status}")
              if nix_rc != 0:
                  raise MonolithError("assembled configuration failed nix-instantiate --parse")
          finally:
              if cleanup_parse_path:
                  parse_path.unlink(missing_ok=True)
          print("MNX_MONOLITH_WORKSPACE=PASS")
          return 0


      #@MNX-PART id=99.50.mnx-monolith.function.command_search kind=function title="Python function command_search"
      def command_search(parsed: ParsedMonolith, pattern: str, context: int, maximum: int) -> int:
          try:
              regex = re.compile(pattern)
          except re.error as exc:
              raise MonolithError(f"invalid regular expression: {exc}") from exc
          text_lines = parsed.data.decode("utf-8").splitlines()
          chunk_by_line: list[Chunk] = []
          for line_number in range(1, len(text_lines) + 1):
              match = next((chunk for chunk in parsed.chunks if chunk.start_line <= line_number <= chunk.end_line), parsed.chunks[0])
              chunk_by_line.append(match)
          hits = 0
          for index, line in enumerate(text_lines):
              if not regex.search(line):
                  continue
              hits += 1
              if hits > maximum:
                  print(f"truncated_after={maximum}")
                  break
              chunk = chunk_by_line[index]
              print(f"match={hits} chunk={chunk.chunk_id}:{chunk.slug} line={index + 1}")
              start = max(0, index - context)
              end = min(len(text_lines), index + context + 1)
              for nearby in range(start, end):
                  marker = ">" if nearby == index else " "
                  print(f"{marker}{nearby + 1:06d}: {text_lines[nearby]}")
          print(f"match_count={min(hits, maximum)}")
          return 0 if hits else 1


      #@MNX-PART id=99.50.mnx-monolith.function.command_bundle kind=function title="Python function command_bundle"
      def command_bundle(parsed: ParsedMonolith, output: Path | None) -> int:
          stamp = datetime.now().strftime("%Y%m%dT%H%M%S")
          if output is None:
              output = Path(tempfile.gettempdir()) / f"mnx-monolith-bundle-{stamp}-{parsed.sha256[:12]}.tar.gz"
          output = output.resolve()
          output.parent.mkdir(parents=True, exist_ok=True)
          if output.exists():
              raise MonolithError(f"bundle output already exists: {output}")
          with tempfile.TemporaryDirectory(prefix="mnx-monolith-bundle-") as temp_dir:
              workspace = Path(temp_dir) / f"monolith-{parsed.sha256[:12]}"
              write_workspace(parsed, workspace)
              (workspace / "configuration.nix").write_bytes(parsed.data)
              with tarfile.open(output, "w:gz") as archive:
                  archive.add(workspace, arcname=workspace.name)
          print(f"bundle={output}")
          print(f"bundle_sha256={hashlib.sha256(output.read_bytes()).hexdigest()}")
          print(f"source_sha256={parsed.sha256}")
          print(f"chunk_count={len(parsed.chunks)}")
          print("MNX_MONOLITH_BUNDLE=PASS")
          return 0


      #@MNX-PART id=99.50.mnx-monolith.function.command_self_test kind=function title="Python function command_self_test"
      def command_self_test() -> int:
          sample = (
              b"#!/usr/bin/env bash\n"
              b"#@MNX-CHUNK id=00.00 slug=alpha title=\"Alpha chunk\"\n"
              b"{ value = \"unicode: \xe2\x98\x83\";\n"
              b"#@MNX-CHUNK id=99.00 slug=omega title=\"Omega chunk\"\n"
              b"}\n"
          )
          with tempfile.TemporaryDirectory(prefix="mnx-monolith-self-test-") as temp_dir:
              source = Path(temp_dir) / "configuration.nix"
              source.write_bytes(sample)
              parsed = parse_monolith(source)
              workspace = Path(temp_dir) / "workspace"
              write_workspace(parsed, workspace)
              assembled, changed, _ = assemble_workspace(workspace)
              if assembled != sample or changed:
                  raise MonolithError("self-test exact roundtrip failed")
              joined = Path(temp_dir) / "joined-configuration.nix"
              command_join(workspace, joined, verify_only=False)
              if joined.read_bytes() != sample:
                  raise MonolithError("self-test command_join changed source bytes")
              command_join(workspace, None, verify_only=True)
              second = workspace / parsed.chunks[-1].filename
              second.write_bytes(second.read_bytes() + b"# changed\n")
              modified, changed, _ = assemble_workspace(workspace)
              if modified == sample or not changed:
                  raise MonolithError("self-test changed-chunk detection failed")
              validate_assembled_bytes(modified)
              missing_path = workspace / parsed.chunks[0].filename
              missing_saved = missing_path.read_bytes()
              missing_path.unlink()
              try:
                  assemble_workspace(workspace)
              except MonolithError:
                  pass
              else:
                  raise MonolithError("self-test missing-chunk rejection failed")
              missing_path.write_bytes(missing_saved)
              untracked_path = workspace / "9999__untracked.nixpart"
              untracked_path.write_bytes(b"untracked")
              try:
                  assemble_workspace(workspace)
              except MonolithError:
                  pass
              else:
                  raise MonolithError("self-test untracked-chunk rejection failed")
              untracked_path.unlink()
              manifest_path = workspace / MANIFEST_NAME
              manifest_saved = manifest_path.read_bytes()
              unsafe_manifest = json.loads(manifest_saved.decode("utf-8"))
              unsafe_manifest["chunks"][0]["file"] = "../escape.nixpart"
              manifest_path.write_text(json.dumps(unsafe_manifest), encoding="utf-8")
              try:
                  assemble_workspace(workspace)
              except MonolithError:
                  pass
              else:
                  raise MonolithError("self-test unsafe-path rejection failed")
              manifest_path.write_bytes(manifest_saved)
              duplicate = sample + b"#@MNX-CHUNK id=00.00 slug=duplicate title=\"Duplicate id\"\n"
              duplicate_path = Path(temp_dir) / "duplicate.nix"
              duplicate_path.write_bytes(duplicate)
              try:
                  parse_monolith(duplicate_path)
              except MonolithError:
                  pass
              else:
                  raise MonolithError("self-test duplicate-marker rejection failed")
          print("MNX_MONOLITH_SELF_TEST=PASS")
          return 0


      #@MNX-PART id=99.50.mnx-monolith.function.build_parser kind=function title="Python function build_parser"
      def build_parser() -> argparse.ArgumentParser:
          parser = argparse.ArgumentParser(prog="mnx-monolith", description="Exact split/index/search/reassembly tools for the single-file Monsternix configuration")
          parser.add_argument("--config", default=str(DEFAULT_CONFIG), help="configuration.nix source path")
          subparsers = parser.add_subparsers(dest="command", required=True)

          subparsers.add_parser("index", help="print the stable chunk map")
          subparsers.add_parser("manifest", help="print the complete JSON chunk manifest")
          subparsers.add_parser("verify", help="validate markers and exact split/join roundtrip")
          subparsers.add_parser("roundtrip", help="alias for verify")

          show = subparsers.add_parser("show", help="print one exact chunk by id or slug")
          show.add_argument("chunk")

          search = subparsers.add_parser("search", help="regex search with chunk-aware locations")
          search.add_argument("pattern")
          search.add_argument("--context", type=int, default=2)
          search.add_argument("--max", type=int, default=100)

          split = subparsers.add_parser("split", help="write a derived chunk workspace")
          split.add_argument("--out", type=Path)

          join = subparsers.add_parser("join", help="assemble a workspace, allowing intentionally edited chunks")
          join.add_argument("workspace", type=Path)
          join.add_argument("--out", type=Path)

          verify_workspace = subparsers.add_parser("verify-workspace", help="validate a workspace without writing an assembled file")
          verify_workspace.add_argument("workspace", type=Path)

          bundle = subparsers.add_parser("bundle", help="create a tar.gz containing the full source, manifest, and exact chunks")
          bundle.add_argument("--out", type=Path)

          subparsers.add_parser("self-test", help="exercise exact roundtrip and changed-chunk detection")
          return parser


      #@MNX-PART id=99.50.mnx-monolith.function.main kind=function title="Python function main"
      def main(argv: list[str] | None = None) -> int:
          parser = build_parser()
          args = parser.parse_args(argv)
          try:
              if args.command == "self-test":
                  return command_self_test()
              if args.command == "join":
                  return command_join(args.workspace, args.out, verify_only=False)
              if args.command == "verify-workspace":
                  return command_join(args.workspace, None, verify_only=True)
              parsed = parse_monolith(Path(args.config))
              if args.command == "index":
                  print_index(parsed)
                  return 0
              if args.command == "manifest":
                  return command_manifest(parsed)
              if args.command in {"verify", "roundtrip"}:
                  return command_verify(parsed)
              if args.command == "show":
                  chunk = resolve_chunk(parsed, args.chunk)
                  sys.stdout.buffer.write(chunk.data)
                  return 0
              if args.command == "search":
                  return command_search(parsed, args.pattern, max(args.context, 0), max(args.max, 1))
              if args.command == "split":
                  return command_split(parsed, args.out)
              if args.command == "bundle":
                  return command_bundle(parsed, args.out)
              raise MonolithError(f"unsupported command: {args.command}")
          except MonolithError as exc:
              print(f"MNX_MONOLITH_ERROR: {exc}", file=sys.stderr)
              return 1


      if __name__ == "__main__":
          raise SystemExit(main())
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
          '#!'*bash*)
            err="$(${pkgs.coreutils}/bin/mktemp)"
            trap '${pkgs.coreutils}/bin/rm -f "$err"' EXIT
            if ! ${pkgs.bash}/bin/bash -n "$out" 2>"$err"; then
