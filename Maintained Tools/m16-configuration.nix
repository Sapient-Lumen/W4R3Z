      #@MNX-PART id=99.60.mnx-refactor.planner.function.render-substrate-record kind=function title="Python function render_substrate_record"
      def render_substrate_record(record: dict) -> str:
          lines = ["################################################################################", "# MNX SUBSTRATE CONTINUITY", "################################################################################"]
          schema = record["schema"]
          if schema == "mnx.substrate.contract.v2":
              for key in ["schema", "substrate_schema", "current_substrate", "substrate_identity", "source_sha256", "authority"]:
                  lines.append(f"{key}={record[key]}")
              lines.append(f"current_source_portable={'yes' if record['current_source_portable'] else 'no'}")
              lines.append("portable_contracts=" + ",".join(record["portable_contracts"]))
              lines.append("migration_requirements=" + ",".join(record["migration_requirements"]))
              lines.append("current_adapter=" + ",".join(f"{key}:{value}" for key, value in sorted(record["current_adapter"].items())))
              lines += ["network_used=no", "mutation=none", "MNX_SUBSTRATE_CONTRACT=PASS"]
          elif schema == "mnx.substrate.status.v2":
              for key in ["schema", "substrate_schema", "current_substrate", "substrate_identity", "source_sha256", "authority"]:
                  lines.append(f"{key}={record[key]}")
              lines.append(f"current_source_portable={'yes' if record['current_source_portable'] else 'no'}")
              lines.append(f"kernel={record['host']['kernel']}")
              lines.append(f"architecture={record['host']['architecture']}")
              for key, value in sorted(record["runtime"].items()):
                  if isinstance(value, bool):
                      value = "yes" if value else "no"
                  if value is None:
                      value = "unavailable"
                  lines.append(f"runtime_{key}={value}")
              lines += ["network_used=no", "mutation=none", "MNX_SUBSTRATE_STATUS=PASS"]
          elif schema == "mnx.substrate.reconstruction.v1":
              lines += [
                  f"schema={schema}",
                  f"reconstruction_packet_schema={record['reconstruction_packet_schema']}",
                  f"substrate_schema={record['substrate_schema']}",
                  f"source_sha256={record['source']['sha256']}",
                  f"current_substrate={record['current_substrate']}",
                  f"current_source_portable={'yes' if record['current_source_portable'] else 'no'}",
                  f"authority={record['authority']}",
                  "portable_contracts=" + ",".join(record['portable_contracts']),
                  "reconstruction_order=" + ",".join(record['reconstruction_order']),
                  "migration_requirements=" + ",".join(record['migration_requirements']),
                  "operator_commands=mnx-test-then-mnx-switch",
                  "network_used=no",
                  "mutation=none",
                  "MNX_RECONSTRUCTION_PACKET=PASS",
              ]
          elif schema == "mnx.backup-soak.review.v1":
              lines += [
                  f"schema={schema}",
                  f"backup_soak_review_schema={record['backup_soak_review_schema']}",
                  f"source_sha256={record['source_sha256']}",
                  f"authority={record['authority']}",
                  f"disposition={record['disposition']}",
                  f"retirement_authorized={'yes' if record['retirement_authorized'] else 'no'}",
                  f"review_flags={','.join(record['review_flags']) if record['review_flags'] else 'none'}",
                  f"unknowns={','.join(record['unknowns']) if record['unknowns'] else 'none'}",
                  "backup_job_executed=no",
                  "secret_path_read=no",
                  "network_used=no",
                  "mutation=none",
                  "MNX_BACKUP_SOAK_REVIEW=PASS",
              ]
          else:
              raise PlannerError(f"unsupported substrate record schema: {schema}")
          return "\n".join(lines) + "\n"
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.substrate-self-test kind=function title="Python function substrate_self_test"
      def substrate_self_test(root: Path) -> None:
          source = root / "substrate-configuration.nix"
          source.write_text("{ ... }: { system.stateVersion = \"25.11\"; }\n", encoding="utf-8")
          first = substrate_contract_record(source)
          second = substrate_contract_record(source)
          if not (canonical_json(first) == canonical_json(second)):
              raise PlannerError('explicit proof condition failed near planner line 614')
          if not (first["schema"] == "mnx.substrate.contract.v2" and first["substrate_schema"] == 2):
              raise PlannerError('substrate contract schema self-test failed')
          if not (first["current_substrate"] == "nixos"):
              raise PlannerError('explicit proof condition failed near planner line 615')
          if not (first["substrate_identity"] == "replaceable"):
              raise PlannerError('explicit proof condition failed near planner line 616')
          if not (first["current_source_portable"] is False):
              raise PlannerError('explicit proof condition failed near planner line 617')
          if not ("switch-committed-office" in first["portable_contracts"]):
              raise PlannerError('explicit proof condition failed near planner line 618')
          if not ("behavior-and-evidence-migration-witnesses" in first["migration_requirements"]):
              raise PlannerError('explicit proof condition failed near planner line 619')
          status_record = substrate_status_record(source)
          if not (status_record["schema"] == "mnx.substrate.status.v2" and status_record["network_used"] is False and status_record["mutation"] == "none"):
              raise PlannerError('explicit proof condition failed near planner line 621')
          reconstruction = substrate_reconstruction_record(source)
          if not (reconstruction['schema'] == 'mnx.substrate.reconstruction.v1' and reconstruction['current_source_portable'] is False and reconstruction['operator_commands'] == ['mnx test','mnx switch']):
              raise PlannerError('substrate reconstruction contract self-test failed')
          soak = backup_soak_review_record(source)
          if not (soak['schema'] == 'mnx.backup-soak.review.v1' and soak['disposition'] == 'continue-dual-path-soak' and soak['retirement_authorized'] is False and soak['backup_job_executed'] is False and soak['secret_path_read'] is False and soak['network_used'] is False and soak['mutation'] == 'none'):
              raise PlannerError('backup soak nonretirement self-test failed')
          source.write_text('# MNX_M21_LEGACY_SCHEDULE_POLICY=timer-masked-manual-service-and-all-history-preserved\n' + source.read_text(encoding='utf-8'), encoding='utf-8')
          retired_soak = backup_soak_review_record(source)
          if retired_soak['disposition'] != 'preserve-both-histories-restic-primary' or retired_soak['retirement_authorized'] is not False or retired_soak['history_deleted'] is not False:
              raise PlannerError('explicit scheduling retirement was confused with history deletion authority')
          print('MNX_BACKUP_SCHEDULE_RETIREMENT_SELF_TEST=PASS')
          print('MNX_RECONSTRUCTION_PACKET_SELF_TEST=PASS')
          print('MNX_BACKUP_SOAK_REVIEW_SELF_TEST=PASS')
          print("MNX_SUBSTRATE_SELF_TEST=PASS")
      
      
