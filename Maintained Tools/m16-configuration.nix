#@MNX-CHUNK id=10.00 slug=legacy-body-entry title="Nix entry, top-level opening, and hardware baseline"
#######################################################################################################
# SECTION 10 — HARDWARE AND BOOT INVARIANTS
#######################################################################################################
#
# CURRENT ADAPTER: NIXOS. This is the concrete machine entry, not an abstract promise of portability.
# The scoped typed semantic kernel below is still a small shadow of explicit machine facts. It publishes
# a checked view; it does not yet generate the backup timetable or replace the visibly written device,
# boot, user and service definitions. Keep that distinction until a witnessed consumer migration is accepted.
#
# INNER-NIX DIRECTION: bind a fact once when several consumers genuinely need the same meaning; use types
# and assertions to reject contradictions; leave privileged operations readable at their actual definition.
# Derive implementation values from the policy, but keep expected behavioral tests independent of that derivation.
# Prefer a few explicit local functions to a general builder framework. No import forest is required.
#
# HARDWARE IS NOT JUST AN ADAPTER DETAIL. Keep filesystem/device identities, bootability, available recovery
# media, driver needs and mutable data outside claims of source-only reproducibility. A candidate activation
# is not a cold-boot test. A new backend must prove it can recover this operator's data and regain control,
# not merely evaluate equivalent-looking configuration. Stage83 preserves hardware and boot definitions.
#

  { config, pkgs, lib, ... }:

  let
    mnxSemanticKernelType = lib.types.submodule {
      options = {
        schema = lib.mkOption { type = lib.types.enum [ "mnx.semantic-kernel.v1" ]; };
        epoch = lib.mkOption { type = lib.types.int; };
        machine = lib.mkOption {
          type = lib.types.submodule {
            options = {
              hostName = lib.mkOption { type = lib.types.str; };
              timeZone = lib.mkOption { type = lib.types.str; };
            };
          };
        };
        operator = lib.mkOption {
          type = lib.types.submodule {
            options = {
              name = lib.mkOption { type = lib.types.str; };
              uid = lib.mkOption { type = lib.types.int; };
              home = lib.mkOption { type = lib.types.str; };
            };
          };
        };
        paths = lib.mkOption {
          type = lib.types.submodule {
            options = {
              configuration = lib.mkOption { type = lib.types.str; };
              oldStorage = lib.mkOption { type = lib.types.str; };
              presslogState = lib.mkOption { type = lib.types.str; };
            };
          };
        };
        locks = lib.mkOption {
          type = lib.types.submodule {
            options.storageMaintenance = lib.mkOption { type = lib.types.str; };
          };
        };
        source = lib.mkOption {
          type = lib.types.submodule {
            options = {
              oneFile = lib.mkOption { type = lib.types.bool; };
              importsEmpty = lib.mkOption { type = lib.types.bool; };
              dynamicImports = lib.mkOption { type = lib.types.bool; };
            };
          };
        };
      };
    };
    mnxSemanticKernelIdentity = {
      schema = "mnx.semantic-kernel.v1";
      epoch = 1;
    };
    mnxSemanticKernel = (lib.evalModules {
      modules = [
        {
          options.kernel = lib.mkOption { type = mnxSemanticKernelType; };
          config.kernel = {
            inherit (mnxSemanticKernelIdentity) schema epoch;
            machine = {
              hostName = "monster-16";
              timeZone = "America/New_York";
            };
            operator = {
              name = "h0p3";
              uid = 1000;
              home = "/home/h0p3";
            };
            paths = {
              configuration = "/etc/nixos/configuration.nix";
              oldStorage = "/mnt/m16-old-storage";
              presslogState = "/home/h0p3/.local/state/presslog";
            };
            locks.storageMaintenance = "/run/storage-maintenance.lock";
            source = {
              oneFile = true;
              importsEmpty = true;
              dynamicImports = false;
            };
          };
        }
      ];
    }).config.kernel;
    # One policy, three consumer families. Keep this data-only and near the outer
    # module boundary; transfer/credential/retention implementations stay explicit.
    mnxM21NightlyPolicyType = lib.types.submodule {
      options = {
        schema = lib.mkOption { type = lib.types.enum [ "mnx.m21.nightly-policy.v1" ]; };
        backend = lib.mkOption { type = lib.types.enum [ "restic" ]; };
        timezone = lib.mkOption { type = lib.types.strMatching "[A-Za-z_]+(/[A-Za-z0-9_+-]+)*"; };
        slot = lib.mkOption { type = lib.types.strMatching "([01][0-9]|2[0-3]):[0-5][0-9]"; };
        retryFrom = lib.mkOption { type = lib.types.strMatching "([01][0-9]|2[0-3]):[0-5][0-9]"; };
        deadline = lib.mkOption { type = lib.types.strMatching "([01][0-9]|2[0-3]):[0-5][0-9]"; };
        primaryJitterMinutes = lib.mkOption { type = lib.types.ints.between 0 120; };
        catchupEveryMinutes = lib.mkOption { type = lib.types.ints.between 1 1440; };
        catchupJitterMinutes = lib.mkOption { type = lib.types.ints.between 0 120; };
        activationGraceMinutes = lib.mkOption { type = lib.types.ints.between 1 1440; };
      };
    };
    mnxClockMinutes = value:
      let digit = position: builtins.fromJSON (builtins.substring position 1 value);
      in (digit 0 * 10 + digit 1) * 60 + digit 3 * 10 + digit 4;
    mnxValidateM21NightlyPolicy = values:
      let
        checked = (lib.evalModules {
          modules = [ {
            options.policy = lib.mkOption { type = mnxM21NightlyPolicyType; };
            config.policy = values;
          } ];
        }).config.policy;
      in builtins.deepSeq checked (
        assert lib.assertMsg (checked.slot < checked.retryFrom && checked.retryFrom < checked.deadline)
          "Monsternix nightly policy requires ordered same-day slot, retry and deadline.";
        assert lib.assertMsg (mnxClockMinutes checked.slot + checked.primaryJitterMinutes <= mnxClockMinutes checked.retryFrom)
          "Monsternix nightly primary jitter must finish by the retry boundary.";
        assert lib.assertMsg (checked.catchupJitterMinutes < checked.catchupEveryMinutes)
          "Monsternix catch-up jitter must be smaller than the retry interval.";
        checked
      );
    mnxM21NightlyPolicy = mnxValidateM21NightlyPolicy {
      schema = "mnx.m21.nightly-policy.v1";
      backend = "restic";
      timezone = "America/New_York";
      slot = "03:25";
      retryFrom = "04:00";
      deadline = "07:00";
      primaryJitterMinutes = 30;
      catchupEveryMinutes = 30;
      catchupJitterMinutes = 2;
      activationGraceMinutes = 45;
    };
    # Migration oracle: intentionally fixed, never generated from the policy.
    # tryEval is deep so an invalid lazy option cannot pass by remaining unread.
    mnxM21NightlyPolicySelfTest =
      let rejects = change:
        !(builtins.tryEval (builtins.deepSeq (mnxValidateM21NightlyPolicy (mnxM21NightlyPolicy // change)) true)).success;
      in mnxM21NightlyPolicy == {
        schema = "mnx.m21.nightly-policy.v1";
        backend = "restic";
        timezone = "America/New_York";
        slot = "03:25";
        retryFrom = "04:00";
        deadline = "07:00";
        primaryJitterMinutes = 30;
        catchupEveryMinutes = 30;
        catchupJitterMinutes = 2;
        activationGraceMinutes = 45;
      } && lib.all rejects [
        { slot = "25:00"; }
        { retryFrom = "3:59"; }
        { retryFrom = "03:25"; }
        { deadline = "03:59"; }
        { primaryJitterMinutes = 36; }
        { catchupEveryMinutes = 0; }
        { catchupEveryMinutes = "30"; }
        { catchupJitterMinutes = 30; }
        { activationGraceMinutes = -1; }
        { backend = "btrfs"; }
        { timezone = "../../etc"; }
        { unexpectedField = true; }
      ];
    mnxCanonicalJSON = value: builtins.toJSON value + "\n";
  in
  {
#@MNX-DEF path=imports section=10.00 role=policy ordinal=001
    imports = [ ];  # Intentionally no imports; single-file configuration.nix

