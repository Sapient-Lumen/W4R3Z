#@MNX-DEF path=systemd.services.m16-restic-maintenance section=70.14 role=service ordinal=237
  systemd.services.m16-restic-maintenance = {
    description = "m16-local Restic check, retention, prune, recheck, and manifested product-state publication";
    after = [ "m16-restic-enrollment-check.service" "m16-restic-repository-init.service" ];
    requires = [ "m16-restic-enrollment-check.service" "m16-restic-repository-init.service" ];
    onFailure = [ "mnx-job-failure-notify@%n.service" ];
    unitConfig = {
      ConditionPathExists = "/etc/nixos/secrets/m16-restic/enabled";
      ConditionPathIsMountPoint = "/mnt/m16-new-storage";
      RequiresMountsFor = [ "/mnt/m16-new-storage" ];
    };
    serviceConfig = {
      Type = "oneshot";
      User = "m16-backup";
      Group = "m16-backup";
      UMask = "0077";
      LoadCredential = [ "repository-password:/etc/nixos/secrets/m16-restic/repository-password" ];
      ExecStart = "+${pkgs.writeTextFile {
        name = "m16-restic-maintenance";
        executable = true;
        text = ''
        #!${pkgs.bash}/bin/bash
        set -Eeuo pipefail
        export LC_ALL=C SYSTEMD_PAGER=cat SYSTEMD_COLORS=0 PAGER=cat
        umask 027

        start_epoch="$(${pkgs.coreutils}/bin/date +%s)"
        repository=/mnt/m16-new-storage/admin/backups/restic/m21
        password="$CREDENTIALS_DIRECTORY/repository-password"
        state_root=/var/lib/monsternix/restic-maintenance
        evidence_root=/var/lib/logbook/backups/restic-maintenance
        metric_out=/var/lib/node-exporter-textfile/monsternix_restic_maintenance.prom
        current_state="$state_root/current.json"
        phase=starting
        reason=starting
        command_rc=0
        product_status=unknown
        lock_acquired=no
        staging=""
        final=""
        evidence_manifest_sha256=none

        #@MNX-PART id=70.14.m16-restic-maintenance.function.cleanup kind=function title="Function cleanup"
        cleanup() {
          local rc="$?"
          trap - EXIT INT TERM HUP
          [ -z "$staging" ] || ${pkgs.coreutils}/bin/rm -rf -- "$staging"
          exit "$rc"
        }
        trap cleanup EXIT INT TERM HUP

        #@MNX-PART id=70.14.m16-restic-maintenance.function.as-backup kind=function title="Function as_backup"
        as_backup() {
          ${pkgs.util-linux}/bin/setpriv \
            --reuid=m16-backup --regid=m16-backup --init-groups \
            --bounding-set=-all --inh-caps=-all --ambient-caps=-all -- "$@"
        }

        #@MNX-PART id=70.14.m16-restic-maintenance.function.source-sha kind=function title="Function source_sha"
        source_sha() {
          ${pkgs.coreutils}/bin/sha256sum /etc/nixos/configuration.nix | ${pkgs.gawk}/bin/awk '{print $1}'
        }
        #@MNX-PART id=70.14.m16-restic-maintenance.function.running-system kind=function title="Function running_system"
        running_system() {
          ${pkgs.coreutils}/bin/readlink -f /run/current-system
        }
        #@MNX-PART id=70.14.m16-restic-maintenance.function.default-system kind=function title="Function default_system"
        default_system() {
          ${pkgs.coreutils}/bin/readlink -f /nix/var/nix/profiles/system
        }

        #@MNX-PART id=70.14.m16-restic-maintenance.function.begin-evidence kind=function title="Function begin_evidence"
        begin_evidence() {
          local safe_ts
          safe_ts="$(${pkgs.coreutils}/bin/date -u +%Y%m%dT%H%M%SZ)"
          final="$evidence_root/restic-maintenance-$safe_ts-$$"
          staging="$evidence_root/.restic-maintenance-$safe_ts-$$.staging"
          [ ! -e "$final" ] && [ ! -L "$final" ] && [ ! -e "$staging" ] && [ ! -L "$staging" ] || {
            echo 'restic maintenance evidence path collision' >&2
            exit 1
          }
          ${pkgs.coreutils}/bin/install -d -o root -g logbook -m 0750 "$state_root" "$evidence_root" "$staging"
          {
            printf 'schema=mnx.restic.maintenance.provenance.v1\n'
            printf 'source_sha256=%s\n' "$(source_sha)"
            printf 'running_system=%s\n' "$(running_system)"
            printf 'default_system=%s\n' "$(default_system)"
            printf 'repository=%s\n' "$repository"
            printf 'network_used=no\n'
            printf 'secrets_recorded=no\n'
          } > "$staging/provenance.txt"
        }

        #@MNX-PART id=70.14.m16-restic-maintenance.function.commit-evidence kind=function title="Function commit_evidence"
        commit_evidence() {
          local summary_tmp manifest_log
          summary_tmp="$staging/.summary.json.$$"
          ${pkgs.jq}/bin/jq -cnS \
            --arg schema mnx.restic.maintenance.evidence.v1 \
            --arg observed_at "$(${pkgs.coreutils}/bin/date --iso-8601=seconds)" \
            --arg source_sha256 "$(source_sha)" \
            --arg running_system "$(running_system)" \
            --arg default_system "$(default_system)" \
            --arg product_status "$product_status" \
            --arg phase "$phase" --arg reason "$reason" \
            --argjson command_rc "$command_rc" \
            --arg lock_acquired "$lock_acquired" \
            --arg evidence_bundle "$final" \
            '{schema:$schema,observed_at:$observed_at,source_sha256:$source_sha256,running_system:$running_system,default_system:$default_system,controller_status:"pass",product_status:$product_status,phase:$phase,reason:$reason,command_rc:$command_rc,lock_acquired:($lock_acquired=="yes"),evidence_bundle:$evidence_bundle,repository:"/mnt/m16-new-storage/admin/backups/restic/m21",network_used:false,secrets_recorded:false}' > "$summary_tmp"
          ${pkgs.coreutils}/bin/mv -f -- "$summary_tmp" "$staging/summary.json"
          ${pkgs.coreutils}/bin/chown -R root:logbook "$staging"
          ${pkgs.findutils}/bin/find "$staging" -type d -exec ${pkgs.coreutils}/bin/chmod 0750 {} +
          ${pkgs.findutils}/bin/find "$staging" -type f -exec ${pkgs.coreutils}/bin/chmod 0640 {} +
          manifest_log="$state_root/.manifest.$$"
          if ! /etc/monsternix/bin/mnx-bundle-manifest create "$staging" 2 > "$manifest_log" 2>&1; then
            ${pkgs.coreutils}/bin/cat "$manifest_log" >&2 || true
            ${pkgs.coreutils}/bin/rm -f -- "$manifest_log"
            exit 1
          fi
          ${pkgs.coreutils}/bin/rm -f -- "$manifest_log"
          /etc/monsternix/bin/mnx-bundle-manifest verify "$staging" >/dev/null
          ${pkgs.coreutils}/bin/mv -T -- "$staging" "$final"
          staging=""
          evidence_manifest_sha256="$(${pkgs.coreutils}/bin/sha256sum "$final/SHA256SUMS" | ${pkgs.gawk}/bin/awk '{print $1}')"
        }

        #@MNX-PART id=70.14.m16-restic-maintenance.function.publish-state-and-metric kind=function title="Function publish_state_and_metric"
        publish_state_and_metric() {
          local duration state_tmp metric_tmp
          duration=$(( $(${pkgs.coreutils}/bin/date +%s) - start_epoch ))
          state_tmp="$state_root/.current.json.$$"
          metric_tmp="/var/lib/node-exporter-textfile/.monsternix_restic_maintenance.prom.$$"
          ${pkgs.jq}/bin/jq -cnS \
            --arg schema mnx.restic.maintenance.state.v1 \
            --arg observed_at "$(${pkgs.coreutils}/bin/date --iso-8601=seconds)" \
            --arg source_sha256 "$(source_sha)" \
            --arg running_system "$(running_system)" \
            --arg default_system "$(default_system)" \
            --arg product_status "$product_status" \
            --arg phase "$phase" --arg reason "$reason" \
            --argjson command_rc "$command_rc" --argjson duration_seconds "$duration" \
            --arg lock_acquired "$lock_acquired" \
            --arg evidence_bundle "$final" \
            --arg evidence_manifest_sha256 "$evidence_manifest_sha256" \
            '{schema:$schema,observed_at:$observed_at,source_sha256:$source_sha256,running_system:$running_system,default_system:$default_system,controller_status:"pass",product_status:$product_status,phase:$phase,reason:$reason,command_rc:$command_rc,duration_seconds:$duration_seconds,lock_acquired:($lock_acquired=="yes"),evidence_bundle:$evidence_bundle,evidence_manifest_sha256:$evidence_manifest_sha256,repository:"/mnt/m16-new-storage/admin/backups/restic/m21",network_used:false,secrets_recorded:false}' > "$state_tmp"
          ${pkgs.coreutils}/bin/chown root:logbook "$state_tmp"
          ${pkgs.coreutils}/bin/chmod 0640 "$state_tmp"
          {
            echo '# HELP monsternix_restic_maintenance_product_status Current Restic maintenance product state: pass=0 skipped=1 review-required=2.'
            echo '# TYPE monsternix_restic_maintenance_product_status gauge'
            case "$product_status" in pass) value=0 ;; skipped) value=1 ;; review-required) value=2 ;; *) value=3 ;; esac
            printf 'monsternix_restic_maintenance_product_status %s\n' "$value"
            echo '# HELP monsternix_restic_maintenance_last_command_rc Last underlying Restic or lock command status.'
            echo '# TYPE monsternix_restic_maintenance_last_command_rc gauge'
            printf 'monsternix_restic_maintenance_last_command_rc %s\n' "$command_rc"
            echo '# HELP monsternix_restic_maintenance_last_duration_seconds Duration of the latest controlled attempt.'
            echo '# TYPE monsternix_restic_maintenance_last_duration_seconds gauge'
            printf 'monsternix_restic_maintenance_last_duration_seconds %s\n' "$duration"
          } > "$metric_tmp"
          ${pkgs.coreutils}/bin/chown root:root "$metric_tmp"
          ${pkgs.coreutils}/bin/chmod 0644 "$metric_tmp"
          ${pkgs.coreutils}/bin/mv -f -- "$metric_tmp" "$metric_out"
          # current.json is the authoritative controller/product publication and is committed last.
          ${pkgs.coreutils}/bin/mv -f -- "$state_tmp" "$current_state"
        }

        #@MNX-PART id=70.14.m16-restic-maintenance.function.finish-product kind=function title="Function finish_product"
        finish_product() {
          local skipped=0 metric_rc="$command_rc"
          commit_evidence
          if [ "$product_status" = pass ]; then
            /etc/monsternix/bin/mnx-job-success m16-restic-maintenance maintenance-complete "phase=complete repository=$repository evidence=$final"
          fi
          publish_state_and_metric
          case "$product_status" in
            pass)
              /etc/monsternix/bin/mnx-job-metric m16-restic-maintenance 0 "$(( $(${pkgs.coreutils}/bin/date +%s) - start_epoch ))" 0 maintenance-complete || true
              echo "maintenance_evidence=$final"
              echo 'MNX_RESTIC_MAINTENANCE=PASS'
              exit 0
              ;;
            skipped)
              skipped=1
              /etc/monsternix/bin/mnx-job-metric m16-restic-maintenance 0 "$(( $(${pkgs.coreutils}/bin/date +%s) - start_epoch ))" "$skipped" "$reason" || true
              echo "maintenance_evidence=$final"
              echo 'MNX_RESTIC_MAINTENANCE=SKIPPED_LOCK_BUSY'
              exit 75
              ;;
            review-required)
              /etc/monsternix/bin/mnx-job-metric m16-restic-maintenance "$metric_rc" "$(( $(${pkgs.coreutils}/bin/date +%s) - start_epoch ))" 0 "$reason" || true
              echo "backup_notification=deferred-to-one-week-supervision phase=$phase rc=$command_rc evidence=$final" >&2
              echo "maintenance_evidence=$final"
              echo 'MNX_RESTIC_MAINTENANCE_PRODUCT_FAILURE=REVIEW_REQUIRED'
              exit 76
              ;;
            *) echo "invalid Restic maintenance product status: $product_status" >&2; exit 1 ;;
          esac
        }

        #@MNX-PART id=70.14.m16-restic-maintenance.function.run-restic-phase kind=function title="Function run_restic_phase"
        run_restic_phase() {
          local name="$1"; shift
          phase="$name"
          set +e
          as_backup "$@" > "$staging/$name.log" 2>&1
          command_rc="$?"
          set -e
          ${pkgs.coreutils}/bin/tail -n 240 "$staging/$name.log" || true
          if [ "$command_rc" -ne 0 ]; then
            product_status=review-required
            reason="$name-failed"
            finish_product
          fi
        }

        begin_evidence
        exec 9<>/run/storage-maintenance.lock
        lock_started="$(${pkgs.coreutils}/bin/date +%s)"
        set +e
        ${pkgs.util-linux}/bin/flock -n -x 9 2> "$staging/storage-lock.log"
        lock_rc="$?"
        set -e
        lock_elapsed=$(( $(${pkgs.coreutils}/bin/date +%s) - lock_started ))
        printf 'lock_rc=%s\nlock_elapsed_seconds=%s\nlock_policy=single-nonblocking-attempt\n' "$lock_rc" "$lock_elapsed" >> "$staging/storage-lock.log"
        if [ "$lock_rc" -ne 0 ]; then
          if [ "$lock_rc" -eq 1 ]; then
            phase=storage-lock
            reason=storage-lock-busy
            command_rc="$lock_rc"
            product_status=skipped
            finish_product
          fi
          echo "storage lock controller failure rc=$lock_rc elapsed=$lock_elapsed" >&2
          exit 1
        fi
        lock_acquired=yes
        export RESTIC_CACHE_DIR=/var/cache/m16-restic-maintenance
        run_restic_phase check-before ${pkgs.restic}/bin/restic --repo "$repository" --password-file "$password" check
        # h0p3 requests a few days of m21 history, not yearly retention. Relative-to-newest
        # time keeps the last usable window during outages; never run this on an m16 archive.
        printf 'retention_scope=m21-home-only\nretention_window=3d-relative-to-newest\nretain_latest=true\n'
        run_restic_phase retention-plan ${pkgs.restic}/bin/restic --repo "$repository" --password-file "$password" forget --host comfy-m21 --path /m21-home.tar --group-by host,paths --keep-within 3d --keep-last 1 --dry-run
        run_restic_phase forget-prune ${pkgs.restic}/bin/restic --repo "$repository" --password-file "$password" forget --host comfy-m21 --path /m21-home.tar --group-by host,paths --keep-within 3d --keep-last 1 --prune
        run_restic_phase check-after ${pkgs.restic}/bin/restic --repo "$repository" --password-file "$password" check
        phase=complete
        reason=none
        command_rc=0
        product_status=pass
        finish_product
        '';
        checkPhase = ''
          set -Eeuo pipefail
          ${pkgs.bash}/bin/bash -n "$out"
        '';
      }}";
      SuccessExitStatus = [ 75 76 ];
      TimeoutStartSec = "8h";
      TimeoutStopSec = "5min";
      CacheDirectory = "m16-restic-maintenance";
      CacheDirectoryMode = "0700";
      Nice = 19;
      IOSchedulingClass = "idle";
      KillMode = "control-group";
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectHome = true;
      ProtectSystem = "strict";
      ReadWritePaths = [
        "/run/storage-maintenance.lock"
        "/mnt/m16-new-storage/admin/backups/restic"
        "/var/cache/m16-restic-maintenance"
        "/var/lib/monsternix/restic-maintenance"
        "/var/lib/logbook/backups/restic-maintenance"
        "/var/lib/monsternix/job-state/authoritative"
        "/var/lib/node-exporter-textfile"
      ];
    };
  };

#@MNX-DEF path=systemd.timers.m16-backup-m21 section=70.14 role=timer ordinal=238
  systemd.timers.m16-backup-m21 = {
    description = "Qualification-gated m16-owned schedule for the m21 Restic export";
    wantedBy = [ "timers.target" ];
    unitConfig.ConditionPathExists = "/var/lib/monsternix/restic-qualification/automatic-enabled";
    timerConfig = {
      Unit = "m16-backup-m21.service";
      OnCalendar = mnxM21NightlyPolicy.slot;
      RandomizedDelaySec = toString mnxM21NightlyPolicy.primaryJitterMinutes + "m";
      Persistent = false;
    };
  };

#@MNX-DEF path=systemd.timers.m16-restic-maintenance section=70.14 role=timer ordinal=239
  systemd.timers.m16-restic-maintenance = {
    description = "Qualification-gated m16-owned Restic maintenance schedule";
    wantedBy = [ "timers.target" ];
    unitConfig.ConditionPathExists = "/var/lib/monsternix/restic-qualification/automatic-enabled";
    timerConfig = {
      Unit = "m16-restic-maintenance.service";
      OnCalendar = "*-*-* 11:15:00";
      RandomizedDelaySec = "30m";
      Persistent = false;
    };
  };

#@MNX-DEF path=environment.etc."monsternix/bin/mnx-restic" section=70.14 role=generated-program ordinal=240
  environment.etc."monsternix/bin/mnx-restic" = {
    source = pkgs.writeTextFile {
      name = "mnx-restic";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      export PATH=/run/wrappers/bin:${pkgs.bash}/bin:${pkgs.coreutils}/bin:${pkgs.findutils}/bin:${pkgs.gawk}/bin:${pkgs.gnugrep}/bin:${pkgs.gnused}/bin:${pkgs.jq}/bin:${pkgs.openssh}/bin:${pkgs.openssl}/bin:${pkgs.apacheHttpd}/bin:${pkgs.restic}/bin:${pkgs.systemd}/bin:${pkgs.util-linux}/bin:/run/current-system/sw/bin
      set -Eeuo pipefail
      export LC_ALL=C SYSTEMD_PAGER=cat SYSTEMD_COLORS=0 PAGER=cat
      umask 077

      readonly SECRET_ROOT=/etc/nixos/secrets/m16-restic
      readonly STATE_ROOT=/var/lib/monsternix/restic-qualification
      readonly REPOSITORY=/mnt/m16-new-storage/admin/backups/restic/m21
      readonly RESTORE_ROOT=/mnt/m16-new-storage/admin/restore-tests
      readonly AUTOMATIC_ENABLE_MARKER=/var/lib/monsternix/restic-qualification/automatic-enabled
      readonly EXPECTED_M21_FINGERPRINT=SHA256:BfdYWZn5Qiaw5c3nzteZzKp47VQExA333A5LcgrYiHc
      readonly EXISTING_PULL_ROOT=/var/lib/m21-btrfs-pull-backup
      readonly EXPECTED_PULL_FINGERPRINT=SHA256:n4Kvw4B9XxRy9l43RBPFfPgR5cQUGgCtqbAJJLuTzzA
      readonly STAGE53_PARTIAL_RUN=20260822T072402Z-8ea097354164
      readonly STAGE53_SOURCE_SHA256=8ea097354164029d95aa1282eb139d823461bfc68f53f89c931c1f9660bcd666
      readonly STAGE53_SYSTEM=/nix/store/cl8fckxws44h2ccj8hlmgscrsyrshap1-nixos-system-monster-16-25.11pre-git
      readonly STAGE52_SOURCE_SHA256=3c01175ff21aab800eef80eb4aa1323070ace72a4c060c71cc16f53c64231c2e
      readonly STAGE52_SYSTEM=/nix/store/nq00mbsx1ii6kc4wy832iz5m2w7jcih2-nixos-system-monster-16-25.11pre-git
      readonly STAGE57_SOURCE_SHA256=a974ae6205bf2c208fa4c4a082e05d7a0601dbd97ef1e67d553ded6e6aa01f78
      readonly STAGE57_SYSTEM=/nix/store/4dc1sl1k6bih2x29lfi5fbygr105g6vw-nixos-system-monster-16-25.11pre-git
      readonly MAINTENANCE_ROOT=/var/lib/monsternix/restic-maintenance
      readonly MAINTENANCE_INTAKE=/var/lib/monsternix/restic-maintenance/bridge-intake.json
      readonly MAINTENANCE_CURRENT=/var/lib/monsternix/restic-maintenance/current.json
      readonly MAINTENANCE_RECOVERY=/var/lib/monsternix/restic-maintenance/recovery.json
      readonly BACKUP_CURRENT=/var/lib/monsternix/job-state/authoritative/m16-restic-m21.current.json
      readonly BACKUP_METRIC=/var/lib/node-exporter-textfile/monsternix_restic_backup.prom
      readonly BACKUP_RECONCILE_ROOT=/var/lib/monsternix/restic-backup
      readonly BACKUP_RECONCILIATION=/var/lib/monsternix/restic-backup/reconciliation.json
      readonly DEGRADED_BACKGROUND_ROOT=/var/lib/monsternix/degraded-background
      readonly STAGE67_SOURCE_SHA256=3276e4b095e14bdca0b32d46198dc700c44fa85ac3e831d9f76e11506dc37e6f
      readonly STAGE67_SYSTEM=/nix/store/akbb1n9ikrhizpw709irzx3j0wh909ng-nixos-system-monster-16-25.11pre-git
      readonly STAGE68_REJECTED_SOURCE_SHA256=3e7bbd2a8d558a6d41238a1c9d77296cfa134dd6a9f9ef92f60ee2a5815ab76e
      readonly STAGE68_REJECTED_TEST_REPORT=/var/lib/logbook/support/mnx-test-20260827T180855-1231083.txt
      readonly STAGE68_REJECTED_BASE64_SHA256=4a9aef075f1166ded7b7aeec18596b01b14451bcb9a6545371b15cba5e07c549
      readonly STAGE68_CORRECTED_BASE64_SHA256=07a98de84e25f4efda0ef6b8e78cb9196e22b1dedcbdaa9ff52d7626c36d704e

      #@MNX-PART id=70.14.mnx-restic.function.die kind=function title="Function die"
      die() {
        printf 'MNX_RESTIC_ERROR: %s\n' "$*" >&2
        exit 1
      }
      #@MNX-PART id=70.14.mnx-restic.function.usage-error kind=function title="Function usage_error"
      usage_error() {
        printf 'MNX_RESTIC_USAGE_ERROR: %s\n' "$*" >&2
        exit 64
      }
      #@MNX-PART id=70.14.mnx-restic.function.require-root kind=function title="Function require_root"
      require_root() {
        if [[ ''${EUID:-$(id -u)} -ne 0 ]]; then
          [[ -x /run/wrappers/bin/sudo ]] || die '/run/wrappers/bin/sudo is unavailable'
          exec /run/wrappers/bin/sudo -- "$0" "$@"
        fi
      }
      #@MNX-PART id=70.14.mnx-restic.function.acquire-control-lock kind=function title="Function acquire_control_lock"
      acquire_control_lock() {
        exec 8<>/run/mnx-restic-qualification.lock
        flock -n -x 8 || die 'another m16 Restic enrollment or qualification command is active'
      }
      #@MNX-PART id=70.14.mnx-restic.function.acquire-read-lock kind=function title="Function acquire_read_lock"
      acquire_read_lock() {
        exec 8<>/run/mnx-restic-qualification.lock
        flock -s 8 || die 'could not obtain the m16 Restic qualification read lock'
      }
      #@MNX-PART id=70.14.mnx-restic.function.ensure-private-directory kind=function title="Function ensure_private_directory"
      ensure_private_directory() {
        local path="$1" metadata mode
        if [[ -e "$path" || -L "$path" ]]; then
          [[ -d "$path" && ! -L "$path" ]] || die "unsafe directory object: $path"
          metadata="$(stat -Lc '%U:%G %a' "$path")"
          [[ "$(stat -Lc '%U:%G' "$path")" == root:root ]] || die "unsafe directory ownership: $path $metadata"
          mode="$(stat -Lc '%a' "$path")"
          [[ "$mode" =~ ^[0-7]{3,4}$ ]] || die "unsafe directory mode syntax: $path $mode"
          (( (8#$mode & 8#022) == 0 )) || die "unsafe writable directory metadata: $path $metadata"
        else
          install -d -o root -g root -m 0700 "$path"
        fi
        if [[ "$(stat -Lc '%U:%G %a' "$path")" != 'root:root 700' ]]; then
          chmod g-s,ug-rwx,u+rwx "$path"
          [[ "$(stat -Lc '%U:%G %a' "$path")" == 'root:root 700' ]] || die "private directory normalization did not take effect: $path"
          printf 'private_directory_mode_normalized=%s\n' "$path"
        fi
      }
      #@MNX-PART id=70.14.mnx-restic.function.require-repository-path kind=function title="Function require_repository_path"
      require_repository_path() {
        mountpoint -q /mnt/m16-new-storage || die 'm16 new storage is not mounted'
        [[ -d "$REPOSITORY" && ! -L "$REPOSITORY" ]] || die 'local Restic repository is absent or a symlink'
        [[ "$(readlink -f -- "$REPOSITORY")" == "$REPOSITORY" ]] || die 'local Restic repository traverses a symlinked path'
        [[ -f "$REPOSITORY/config" && ! -L "$REPOSITORY/config" ]] || die 'local Restic repository config is absent or a symlink'
        [[ "$(stat -Lc '%U:%G' "$REPOSITORY")" == 'm16-backup:m16-backup' ]] || die 'local Restic repository ownership differs'
      }
      #@MNX-PART id=70.14.mnx-restic.function.source-sha kind=function title="Function source_sha"
      source_sha() {
        sha256sum /etc/nixos/configuration.nix | awk '{print $1}'
      }
      #@MNX-PART id=70.14.mnx-restic.function.running-system kind=function title="Function running_system"
      running_system() {
        readlink -f /run/current-system
      }
      #@MNX-PART id=70.14.mnx-restic.function.default-system kind=function title="Function default_system"
      default_system() {
        readlink -f /nix/var/nix/profiles/system
      }
      #@MNX-PART id=70.14.mnx-restic.function.current-run kind=function title="Function current_run"
      current_run() {
        [[ -f "$STATE_ROOT/current" && ! -L "$STATE_ROOT/current" ]] || return 1
        [[ "$(stat -Lc '%U:%G %a' "$STATE_ROOT/current")" == 'root:root 600' ]] || die 'current qualification pointer metadata is unsafe'
        local value
        value="$(<"$STATE_ROOT/current")"
        [[ "$value" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$ ]] || die 'current qualification run identifier is malformed'
        [[ -d "$STATE_ROOT/runs/$value" && ! -L "$STATE_ROOT/runs/$value" ]] || die 'current qualification run directory is absent or unsafe'
        [[ -f "$STATE_ROOT/runs/$value/state" && ! -L "$STATE_ROOT/runs/$value/state" ]] || die 'current qualification state is absent or unsafe'
        printf '%s\n' "$value"
      }
      #@MNX-PART id=70.14.mnx-restic.function.run-dir kind=function title="Function run_dir"
      run_dir() {
        printf '%s/runs/%s\n' "$STATE_ROOT" "$1"
      }
      #@MNX-PART id=70.14.mnx-restic.function.state-value kind=function title="Function state_value"
      state_value() {
        local file="$1" key="$2"
        sed -n "s/^$key=//p" "$file" | tail -n 1
      }
      #@MNX-PART id=70.14.mnx-restic.function.receipt-path kind=function title="Function receipt_path"
      receipt_path() {
        printf '%s/%s\n' "$(run_dir "$1")" "$2"
      }
      #@MNX-PART id=70.14.mnx-restic.function.phase-receipt-path kind=function title="Function phase_receipt_path"
      phase_receipt_path() {
        local run="$1" phase="$2" dir file found= count=0
        dir="$(run_dir "$run")"
        while IFS= read -r -d "" file; do
          if jq -e --arg phase "$phase" 'select(.phase==$phase and .status=="pass")' "$file" >/dev/null 2>&1; then
            found="$file"
            count=$((count + 1))
          fi
        done < <(find "$dir" -maxdepth 1 -type f -name '[0-9][0-9][0-9]-*.json' -print0)
        [[ "$count" == 1 ]] || die "phase $phase has $count passing receipt files"
        printf '%s\n' "$found"
      }
      #@MNX-PART id=70.14.mnx-restic.function.receipt-details kind=function title="Function receipt_details"
      receipt_details() {
        jq -er '.details | strings | select(length > 0)' "$(phase_receipt_path "$1" "$2")"
      }
      #@MNX-PART id=70.14.mnx-restic.function.detail-value kind=function title="Function detail_value"
      detail_value() {
        local details="$1" key="$2"
        printf '%s\n' "$details" | tr ' ' '\n' | sed -n "s/^$key=//p" | tail -n 1
      }
      #@MNX-PART id=70.14.mnx-restic.function.require-exact-receipt kind=function title="Function require_exact_receipt"
      require_exact_receipt() {
        local run="$1" filename="$2" sequence="$3" phase="$4" expected_source="$5" expected_system="$6" path
        path="$(receipt_path "$run" "$filename")"
        [[ -f "$path" && ! -L "$path" ]] || die "exact receipt is absent or unsafe: $path"
        [[ "$(stat -Lc '%U:%G %a' "$path")" == 'root:root 600' ]] || die "exact receipt metadata differs: $path"
        jq -e \
          --argjson sequence "$sequence" --arg phase "$phase" --arg source "$expected_source" --arg system "$expected_system" \
          'select(.schema=="mnx.restic.qualification.receipt.v1" and .sequence==$sequence and .phase==$phase and .status=="pass" and .source_sha256==$source and .running_system==$system and .default_system==$system and (.details|type)=="string" and (.details|length)>0 and .network_evidence_is_authority==false and .secrets_recorded==false)' \
          "$path" >/dev/null || die "exact receipt identity differs: $path"
      }
      #@MNX-PART id=70.14.mnx-restic.function.require-exact-first-pair-receipts kind=function title="Function require_exact_first_pair_receipts"
      require_exact_first_pair_receipts() {
        local run="$1" expected_source="$2" expected_system="$3" dir actual expected
        dir="$(run_dir "$run")"
        verify_run_tree "$run"
        [[ ! -e "$dir/restic-check.log" && ! -L "$dir/restic-check.log" ]] || die "first-pair run unexpectedly contains a repository-check log: $run"
        actual="$(find "$dir" -maxdepth 1 -type f -name '[0-9][0-9][0-9]-*.json' -printf '%f\n' | sort)"
        expected="$(printf '%s\n' 001-begin.json 002-backup-1.json 003-backup-2.json 004-source-cleanup-success.json)"
        [[ "$actual" == "$expected" ]] || die "first-pair run receipt inventory differs: $run"
        require_exact_receipt "$run" 001-begin.json 1 begin "$expected_source" "$expected_system"
        require_exact_receipt "$run" 002-backup-1.json 2 backup-1 "$expected_source" "$expected_system"
        require_exact_receipt "$run" 003-backup-2.json 3 backup-2 "$expected_source" "$expected_system"
        require_exact_receipt "$run" 004-source-cleanup-success.json 4 source-cleanup-success "$expected_source" "$expected_system"
      }
      #@MNX-PART id=70.14.mnx-restic.function.repository-has-snapshot-id kind=function title="Function repository_has_snapshot_id"
      repository_has_snapshot_id() {
        local snapshot_id="$1"
        [[ "$snapshot_id" =~ ^[0-9a-f]{64}$ ]] || return 1
        repository_json | jq -e --arg id "$snapshot_id" '[.[] | select(.id==$id)] | length == 1' >/dev/null
      }
      #@MNX-PART id=70.14.mnx-restic.function.repository-json kind=function title="Function repository_json"
      repository_json() {
        require_repository_path
        restic --repo "$REPOSITORY" --password-file "$SECRET_ROOT/repository-password" snapshots --json
      }
      #@MNX-PART id=70.14.mnx-restic.function.repository-count kind=function title="Function repository_count"
      repository_count() {
        repository_json | jq 'length'
      }
      #@MNX-PART id=70.14.mnx-restic.function.repository-ids-sha kind=function title="Function repository_ids_sha"
      repository_ids_sha() {
        repository_json | jq -r 'sort_by(.time) | .[].id' | sha256sum | awk '{print $1}'
      }
      #@MNX-PART id=70.14.mnx-restic.function.repository-latest-id kind=function title="Function repository_latest_id"
      repository_latest_id() {
        repository_json | jq -r 'sort_by(.time) | last | .id // empty'
      }
      #@MNX-PART id=70.14.mnx-restic.function.repository-latest-parent kind=function title="Function repository_latest_parent"
      repository_latest_parent() {
        repository_json | jq -r 'sort_by(.time) | last | .parent // empty'
      }
      #@MNX-PART id=70.14.mnx-restic.function.repository-bytes kind=function title="Function repository_bytes"
      repository_bytes() {
        require_repository_path
        du -s -B1 --apparent-size "$REPOSITORY" | awk '{print $1}'
      }
      #@MNX-PART id=70.14.mnx-restic.function.free-bytes kind=function title="Function free_bytes"
      free_bytes() {
        df -B1 --output=avail /mnt/m16-new-storage | tail -n 1 | tr -d ' '
      }

      #@MNX-PART id=70.14.mnx-restic.function.first-pair-capacity-preflight kind=function title="Function first_pair_capacity_preflight"
      first_pair_capacity_preflight() {
        [[ $# == 0 ]] || usage_error 'mnx restic qualify capacity-preflight'
        mountpoint -q /mnt/m16-new-storage || die 'm16 new storage is not mounted'
        local target_free
        target_free="$(free_bytes)"
        [[ "$target_free" =~ ^[0-9]+$ ]] || die 'free-space measurement is not numeric'
        printf 'target_free_bytes=%s\n' "$target_free"
        echo 'capacity_policy=measurement-only-no-artificial-byte-ceiling'
        echo 'mutation=none'
        echo 'MNX_RESTIC_FIRST_PAIR_CAPACITY_MEASUREMENT=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.second-pull-capacity-preflight kind=function title="Function second_pull_capacity_preflight"
      second_pull_capacity_preflight() {
        local target_free
        target_free="$(free_bytes)"
        [[ "$target_free" =~ ^[0-9]+$ ]] || die 'second-pull free-space measurement is not numeric'
        printf 'second_pull_target_free_bytes=%s\n' "$target_free"
        echo 'second_pull_capacity_policy=measurement-only-no-artificial-byte-ceiling'
        echo 'MNX_RESTIC_SECOND_PULL_CAPACITY_MEASUREMENT=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.verify-run-tree kind=function title="Function verify_run_tree"
      verify_run_tree() {
        local run="$1" dir manifest metadata mode path base
        dir="$(run_dir "$run")"
        manifest="$dir/SHA256SUMS"
        [[ -d "$dir" && ! -L "$dir" && -f "$manifest" && ! -L "$manifest" ]] || die "qualification evidence tree is incomplete: $dir"
        metadata="$(stat -Lc '%U:%G %a' "$dir")"
        [[ "$(stat -Lc '%U:%G' "$dir")" == root:root ]] || die "qualification directory ownership is unsafe: $metadata"
        mode="$(stat -Lc '%a' "$dir")"
        [[ "$mode" =~ ^[0-7]{3,4}$ ]] || die "qualification directory mode is malformed: $mode"
        (( (8#$mode & 8#022) == 0 )) || die "qualification directory is writable by group or others: $metadata"
        while IFS= read -r -d "" path; do
          base="$(basename -- "$path")"
          case "$base" in
            state|SHA256SUMS|restic-check.log|[0-9][0-9][0-9]-*.json) ;;
            *) die "qualification evidence tree contains an unexpected object: $base" ;;
          esac
          [[ -f "$path" && ! -L "$path" ]] || die "qualification evidence object is not a regular non-symlink file: $base"
          [[ "$(stat -Lc '%U:%G %a' "$path")" == 'root:root 600' ]] || die "qualification evidence file metadata is unsafe: $base"
        done < <(find "$dir" -mindepth 1 -maxdepth 1 -print0)
        diff -u \
          <(cd "$dir" && find . -maxdepth 1 -type f \( -name 'state' -o -name 'restic-check.log' -o -name '[0-9][0-9][0-9]-*.json' \) -printf '%P\n' | sort) \
          <(awk 'NF == 2 {print $2}' "$manifest" | sort) >/dev/null || die 'qualification receipt manifest membership differs from the bounded evidence set'
        (cd "$dir" && sha256sum -c SHA256SUMS >/dev/null) || die 'qualification receipt manifest verification failed'
        if [[ "$metadata" != 'root:root 700' ]]; then
          chmod g-s,ug-rwx,u+rwx "$dir"
          [[ "$(stat -Lc '%U:%G %a' "$dir")" == 'root:root 700' ]] || die 'qualification directory mode normalization did not take effect'
          echo 'qualification_directory_mode_normalized=yes'
        fi
        echo 'MNX_RESTIC_QUALIFICATION_MANIFEST=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.record-receipt kind=function title="Function record_receipt"
      record_receipt() {
        local run="$1" phase="$2" status="$3" details="$4" dir sequence tmp manifest_tmp
        dir="$(run_dir "$run")"
        [[ -d "$dir" && ! -L "$dir" ]] || die 'qualification run directory is absent'
        sequence="$(find "$dir" -maxdepth 1 -type f -name '[0-9][0-9][0-9]-*.json' | wc -l)"
        sequence=$((sequence + 1))
        printf -v tmp '%s/.receipt.%s.tmp' "$dir" "$$"
        jq -cn \
          --arg schema mnx.restic.qualification.receipt.v1 \
          --argjson sequence "$sequence" --arg phase "$phase" --arg status "$status" \
          --arg recorded_at "$(date --iso-8601=seconds)" --arg source_sha256 "$(source_sha)" \
          --arg running_system "$(running_system)" --arg default_system "$(default_system)" \
          --arg details "$details" \
          '{schema:$schema,sequence:$sequence,phase:$phase,status:$status,recorded_at:$recorded_at,source_sha256:$source_sha256,running_system:$running_system,default_system:$default_system,details:$details,network_evidence_is_authority:false,secrets_recorded:false}' > "$tmp"
        chmod 0600 "$tmp"
        mv -f -- "$tmp" "$dir/$(printf '%03d' "$sequence")-$phase.json"
        manifest_tmp="$dir/.SHA256SUMS.$$"
        (cd "$dir" && find . -maxdepth 1 -type f \( -name 'state' -o -name 'restic-check.log' -o -name '[0-9][0-9][0-9]-*.json' \) -printf '%P\n' | sort | xargs -r sha256sum) > "$manifest_tmp"
        chmod 0600 "$manifest_tmp"
        mv -f -- "$manifest_tmp" "$dir/SHA256SUMS"
      }

      #@MNX-PART id=70.14.mnx-restic.function.require-enrollment kind=function title="Function require_enrollment"
      require_enrollment() {
        [[ -f "$SECRET_ROOT/enabled" && ! -s "$SECRET_ROOT/enabled" ]] || die 'Restic enrollment is not armed'
        systemctl start m16-restic-enrollment-check.service || die 'enrollment validation failed'
      }

      #@MNX-PART id=70.14.mnx-restic.function.timer-enablement-is-disarmed kind=function title="Function timer_enablement_is_disarmed"
      timer_enablement_is_disarmed() {
        case "''${1:-}" in
          disabled|linked) return 0 ;;
          *) return 1 ;;
        esac
      }

      #@MNX-PART id=70.14.mnx-restic.function.require-disarmed-timers kind=function title="Function require_disarmed_timers"
      require_disarmed_timers() {
        local unit enable_state active_state
        for unit in m16-backup-m21.timer m16-restic-maintenance.timer; do
          enable_state="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
          timer_enablement_is_disarmed "$enable_state" || die "$unit enablement is not disarmed: ''${enable_state:-unknown}"
          active_state="$(systemctl show --property=ActiveState --value "$unit" 2>/dev/null || true)"
          [[ "$active_state" == inactive ]] || die "$unit runtime state is not disarmed: ''${active_state:-unknown}"
        done
        [[ "$(systemctl is-enabled m21-btrfs-pull-backup.timer 2>/dev/null || true)" == enabled ]] || die 'accepted Btrfs backup timer is not enabled'
      }

      #@MNX-PART id=70.14.mnx-restic.function.require-qualification-quarantine kind=function title="Function require_qualification_quarantine"
      require_qualification_quarantine() {
        local unit enable_state active_state
        [[ ! -e "$AUTOMATIC_ENABLE_MARKER" && ! -L "$AUTOMATIC_ENABLE_MARKER" ]] || die 'automatic Restic scheduling marker exists before qualification completion'
        for unit in m16-backup-m21.timer m16-restic-maintenance.timer; do
          enable_state="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
          [[ "$enable_state" == enabled ]] || die "$unit is not declaratively enabled behind its qualification condition: ''${enable_state:-unknown}"
          active_state="$(systemctl show --property=ActiveState --value "$unit" 2>/dev/null || true)"
          [[ "$active_state" == inactive ]] || die "$unit escaped qualification quarantine: ''${active_state:-unknown}"
        done
        [[ "$(systemctl is-enabled m21-btrfs-pull-backup.timer 2>/dev/null || true)" == enabled ]] || die 'accepted Btrfs backup timer is not enabled'
      }

      #@MNX-PART id=70.14.mnx-restic.function.enroll-adoption-preflight kind=function title="Function enroll_adoption_preflight"
      enroll_adoption_preflight() {
        [[ $# == 0 ]] || usage_error 'mnx restic enroll adoption-preflight'
        local path owner mode pull_fingerprint host_lines host_fingerprint state
        for path in "$EXISTING_PULL_ROOT/id_ed25519" "$EXISTING_PULL_ROOT/known_hosts"; do
          [[ -f "$path" && ! -L "$path" ]] || die "existing pull credential is absent or unsafe: $path"
          owner="$(stat -Lc '%U:%G' "$path")"; mode="$(stat -Lc '%a' "$path")"
          [[ "$owner" == root:root && ( "$mode" == 400 || "$mode" == 600 ) ]] || die "unsafe existing pull credential metadata: $path $owner $mode"
        done
        pull_fingerprint="$(ssh-keygen -y -f "$EXISTING_PULL_ROOT/id_ed25519" | ssh-keygen -lf - | awk 'NF {print $2; exit}')"
        [[ "$pull_fingerprint" == "$EXPECTED_PULL_FINGERPRINT" ]] || die "existing pull identity differs: $pull_fingerprint"
        host_lines="$(ssh-keygen -F 192.168.100.119 -f "$EXISTING_PULL_ROOT/known_hosts" | awk '$1 !~ /^#/ {print}')"
        [[ "$(printf '%s\n' "$host_lines" | awk 'NF {n++} END {print n+0}')" == 1 ]] || die 'existing known_hosts must contain exactly one wired m21 key'
        host_fingerprint="$(printf '%s\n' "$host_lines" | ssh-keygen -lf - | awk 'NF {print $2; exit}')"
        [[ "$host_fingerprint" == "$EXPECTED_M21_FINGERPRINT" ]] || die "m21 host identity differs: $host_fingerprint"
        state=absent
        if [[ -e "$SECRET_ROOT" || -L "$SECRET_ROOT" ]]; then
          [[ -d "$SECRET_ROOT" && ! -L "$SECRET_ROOT" && "$(stat -Lc '%U:%G %a' "$SECRET_ROOT")" == 'root:root 700' ]] || die 'm16 Restic secret root has unsafe type or metadata'
          if [[ -z "$(find "$SECRET_ROOT" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
            state=empty
          elif [[ -f "$SECRET_ROOT/enabled" && ! -L "$SECRET_ROOT/enabled" && ! -s "$SECRET_ROOT/enabled" && -f "$SECRET_ROOT/repository-password" && ! -L "$SECRET_ROOT/repository-password" && -s "$SECRET_ROOT/repository-password" && "$(find "$SECRET_ROOT" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort | tr '\n' ',')" == 'enabled,repository-password,' ]]; then
            [[ "$(stat -Lc '%U:%G %a' "$SECRET_ROOT/enabled")" == 'root:root 600' && "$(stat -Lc '%U:%G %a' "$SECRET_ROOT/repository-password")" == 'root:root 600' ]] || die 'adopted Restic secret metadata differs'
            [[ "$(wc -c < "$SECRET_ROOT/repository-password")" -ge 24 ]] || die 'adopted Restic password is implausibly short'
            state=complete
          else
            die 'ambiguous partial m16 Restic secret state; refusing adoption'
          fi
        fi
        if [[ -e "$REPOSITORY" || -L "$REPOSITORY" ]]; then
          [[ "$state" == complete ]] || die 'repository exists without complete adopted credentials'
          require_repository_path
          restic --repo "$REPOSITORY" --password-file "$SECRET_ROOT/repository-password" cat config >/dev/null || die 'existing repository cannot be opened by the adopted password'
        fi
        printf 'adoption_state=%s\n' "$state"
        printf 'pull_public_fingerprint=%s\n' "$pull_fingerprint"
        printf 'm21_host_fingerprint=%s\n' "$host_fingerprint"
        echo 'private_key_copied=no'
        echo 'm21_key_transfer_required=no'
        echo 'mutation=none'
        echo 'MNX_RESTIC_ADOPTION_PREFLIGHT=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.enroll-source-probe kind=function title="Function enroll_source_probe"
      enroll_source_probe() {
        (
          [[ $# == 0 ]] || usage_error 'mnx restic enroll source-probe'
          enroll_adoption_preflight >/dev/null
          local tmp rc receipt_state
          tmp="$(mktemp -d)"; trap 'rm -rf -- "$tmp"' EXIT
          set +e
          ssh -F /dev/null -T -i "$EXISTING_PULL_ROOT/id_ed25519" \
            -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes \
            -o HostKeyAlgorithms=ssh-ed25519 \
            -o UserKnownHostsFile="$EXISTING_PULL_ROOT/known_hosts" \
            -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no \
            -o ConnectTimeout=15 -o ServerAliveInterval=30 -o ServerAliveCountMax=1 \
            backup-source@192.168.100.119 receipt >"$tmp/stdout" 2>"$tmp/stderr"
          rc="$?"
          set -e
          [[ "$(wc -c < "$tmp/stdout")" -le 2048 && "$(wc -c < "$tmp/stderr")" -le 2048 ]] || die 'm21 source probe output exceeded its bound'
          if [[ "$rc" == 66 && ! -s "$tmp/stdout" ]]; then
            receipt_state=absent
          elif [[ "$rc" == 0 ]] && grep -qx 'schema=mnx.m21.pull-source.receipt.v1' "$tmp/stdout" &&
               grep -qx 'source_hostname=comfy-m21' "$tmp/stdout" &&
               grep -qx 'source_uuid=5c208c49-1b6c-411e-899c-fca29e2d5d9b' "$tmp/stdout" &&
               grep -qx 'snapshot_absent=yes' "$tmp/stdout" &&
               grep -qx 'network_initiator=m16' "$tmp/stdout" &&
               grep -qx 'm21_outbound_connection=none' "$tmp/stdout"; then
            receipt_state=present-valid
          else
            die "m21 forced-command source probe failed: rc=$rc"
          fi
          printf 'source_receipt_state=%s\n' "$receipt_state"
          echo 'data_bearing_command_invoked=no'
          echo 'network_initiator=m16'
          echo 'MNX_RESTIC_SOURCE_PROBE=PASS'
        )
      }

      #@MNX-PART id=70.14.mnx-restic.function.enroll-adopt-existing kind=function title="Function enroll_adopt_existing"
      enroll_adopt_existing() {
        [[ $# == 1 && "$1" == --switch-owned ]] || usage_error 'adopt-existing is reserved for accepted mnx switch continuation'
        local state tmp created=0 secret_root_created=0
        [[ "$(running_system)" == "$(default_system)" && "$(source_sha)" == "$(sha256sum /run/current-system/configuration.nix | awk '{print $1}')" ]] || die 'adoption requires one accepted running/default/source identity'
        state="$(enroll_adoption_preflight | sed -n 's/^adoption_state=//p')"
        if [[ "$state" == absent ]]; then
          install -d -o root -g root -m 0700 "$SECRET_ROOT"
          secret_root_created=1
          state=empty
        fi
        if [[ "$state" == empty ]]; then
          tmp="$SECRET_ROOT/.repository-password.$$"
          openssl rand -hex 32 > "$tmp"
          chown root:root "$tmp"; chmod 0600 "$tmp"
          mv -f -- "$tmp" "$SECRET_ROOT/repository-password"
          install -o root -g root -m 0600 /dev/null "$SECRET_ROOT/enabled"
          created=1
        fi
        if ! systemctl start m16-restic-enrollment-check.service ||
           ! systemctl start m16-restic-repository-init.service ||
           ! enroll_adoption_preflight >/dev/null ||
           ! enroll_source_probe; then
          if (( created == 1 )); then
            # Preflight proved that this exact repository path did not exist
            # before this action. A failed initialization may therefore remove
            # only its own newly-created local repository object.
            if [[ -d "$REPOSITORY" && ! -L "$REPOSITORY" ]]; then
              find "$REPOSITORY" -xdev -depth -delete 2>/dev/null || true
            fi
            rm -f -- "$SECRET_ROOT/enabled" "$SECRET_ROOT/repository-password"
            if (( secret_root_created == 1 )); then rmdir "$SECRET_ROOT" 2>/dev/null || true; fi
          fi
          die 'existing-credential adoption failed; action-owned local state was compensated'
        fi
        echo 'enrollment_state=armed'
        echo 'credential_authority=existing-m16-btrfs-pull-identity'
        echo 'private_key_copied=no'
        echo 'm21_key_transfer_required=no'
        echo 'data_bearing_pull_performed=no'
        echo 'timers_changed=no'
        echo 'old_btrfs_timer_changed=no'
        echo 'MNX_RESTIC_ADOPT_EXISTING=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.enroll-disarm kind=function title="Function enroll_disarm"
      enroll_disarm() {
        systemctl is-active --quiet m16-backup-m21.service && die 'refusing to disarm while a physical backup is active'
        systemctl is-active --quiet m16-restic-maintenance.service && die 'refusing to disarm while repository maintenance is active'
        if [[ -e "$SECRET_ROOT/enabled" ]]; then
          [[ -f "$SECRET_ROOT/enabled" && ! -L "$SECRET_ROOT/enabled" && ! -s "$SECRET_ROOT/enabled" ]] || die 'refusing to remove a noncanonical enrollment marker'
          rm -f -- "$SECRET_ROOT/enabled"
        fi
        echo 'enrollment_state=disarmed'
        echo 'credentials_deleted=no'
        echo 'repository_deleted=no'
        echo 'MNX_RESTIC_ENROLL_DISARM=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.qualify-begin kind=function title="Function qualify_begin"
      qualify_begin() {
        [[ $# == 0 ]] || usage_error 'mnx restic qualify begin'
        require_enrollment
        require_disarmed_timers
        mountpoint -q /mnt/m16-new-storage || die 'm16 new storage is not mounted'
        [[ "$(running_system)" == "$(default_system)" ]] || die 'qualification must begin from one accepted active and boot-default closure'
        systemctl start m16-restic-repository-init.service
        local run dir tmp count ids bytes free
        run="$(date -u +%Y%m%dT%H%M%SZ)-$(source_sha | cut -c1-12)"
        dir="$(run_dir "$run")"
        [[ ! -e "$dir" ]] || die 'qualification run identifier collision'
        ensure_private_directory "$STATE_ROOT"
        ensure_private_directory "$STATE_ROOT/runs"
        install -d -o root -g root -m 0700 "$dir"
        count="$(repository_count)"; ids="$(repository_ids_sha)"; bytes="$(repository_bytes)"; free="$(free_bytes)"
        tmp="$STATE_ROOT/.current.$$"; printf '%s\n' "$run" > "$tmp"; chmod 0600 "$tmp"; mv -f -- "$tmp" "$STATE_ROOT/current"
        cat > "$dir/state" <<EOF
      run=$run
      source_sha256=$(source_sha)
      running_system=$(running_system)
      default_system=$(default_system)
      initial_snapshot_count=$count
      initial_snapshot_ids_sha256=$ids
      initial_repository_bytes=$bytes
      initial_free_bytes=$free
      next_backup=1
      EOF
        chmod 0600 "$dir/state"
        record_receipt "$run" begin pass "initial_snapshot_count=$count initial_repository_bytes=$bytes initial_free_bytes=$free timers=disarmed old_btrfs=enabled"
        printf 'qualification_run=%s\n' "$run"
        echo 'next=mnx restic qualify backup'
        echo 'MNX_RESTIC_QUALIFY_BEGIN=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.update-state-key kind=function title="Function update_state_key"
      update_state_key() {
        local file key value tmp
        file="$1"; key="$2"; value="$3"; tmp="$file.tmp.$$"
        awk -F= -v key="$key" -v value="$value" 'BEGIN{done=0} $1==key {print key "=" value; done=1; next} {print} END{if(!done) print key "=" value}' "$file" > "$tmp"
        chmod 0600 "$tmp"; mv -f -- "$tmp" "$file"
      }

      #@MNX-PART id=70.14.mnx-restic.function.phase-count kind=function title="Function phase_count"
      phase_count() {
        local run="$1" phase="$2" dir
        dir="$(run_dir "$run")"
        jq -r --arg phase "$phase" 'select(.phase==$phase and .status=="pass") | 1' "$dir"/[0-9][0-9][0-9]-*.json 2>/dev/null | wc -l
      }
      #@MNX-PART id=70.14.mnx-restic.function.require-phase-once kind=function title="Function require_phase_once"
      require_phase_once() {
        local run="$1" phase="$2" count
        count="$(phase_count "$run" "$phase")"
        [[ "$count" == 1 ]] || die "required predecessor phase $phase has $count passing receipts"
      }

      #@MNX-PART id=70.14.mnx-restic.function.require-phase-absent kind=function title="Function require_phase_absent"
      require_phase_absent() {
        local run="$1" phase="$2" count
        count="$(phase_count "$run" "$phase")"
        [[ "$count" == 0 ]] || die "phase $phase already has $count passing receipts; refusing to duplicate it"
      }

      #@MNX-PART id=70.14.mnx-restic.function.require-run-identity kind=function title="Function require_run_identity"
      require_run_identity() {
        local run="$1" state
        state="$(run_dir "$run")/state"
        [[ -f "$state" && ! -L "$state" ]] || die 'qualification state is absent or unsafe'
        [[ "$(stat -Lc '%U:%G %a' "$state")" == 'root:root 600' ]] || die 'qualification state metadata is unsafe'
        [[ "$(state_value "$state" source_sha256)" == "$(source_sha)" ]] || die 'live source differs from qualification source'
        [[ "$(state_value "$state" running_system)" == "$(running_system)" ]] || die 'running closure differs from qualification closure'
        [[ "$(state_value "$state" default_system)" == "$(default_system)" ]] || die 'boot-default closure differs from qualification closure'
        [[ "$(running_system)" == "$(default_system)" ]] || die 'running and boot-default closures differ during qualification'
      }

      #@MNX-PART id=70.14.mnx-restic.function.supersede-begin-only-run kind=function title="Function supersede_begin_only_run"
      supersede_begin_only_run() {
        local run="$1" dir state old_source receipt_count superseded_count current_count current_ids supersession_reason cleanup_witness cleanup_sha
        dir="$(run_dir "$run")"; state="$dir/state"
        [[ -f "$state" && ! -L "$state" && "$(stat -Lc '%U:%G %a' "$state")" == 'root:root 600' ]] || die 'stale qualification state is absent or unsafe'
        old_source="$(state_value "$state" source_sha256)"
        cleanup_sha=none
        case "$old_source" in
          e9e1ac9422350e97b34a3dfd2bff0aeae25f0a5152a9407519ae623f7fa729e3)
            supersession_reason=accepted-stage46-begin-only-local-preflight-failure
            ;;
          ec1ddee25414e1569675e2f9c7e33b43a11187ef902e027467353e469936d294)
            cleanup_witness=/var/lib/m16-backup-control/m21-last-source-receipt
            validate_cleanup_witness failure "$cleanup_witness" || die 'Stage50 failed-export source cleanup witness is invalid'
            cleanup_sha="$(sha256sum "$cleanup_witness" | awk '{print $1}')"
            supersession_reason=accepted-stage50-uncommitted-export-with-source-cleanup-and-unchanged-repository-identities
            ;;
          *) die 'only an explicitly recognized accepted predecessor run may be superseded here' ;;
        esac
        [[ "$run" == *-"''${old_source:0:12}" && "$(state_value "$state" run)" == "$run" ]] || die 'stale qualification run identity is inconsistent'
        [[ "$(state_value "$state" next_backup)" == 1 ]] || die 'stale qualification run has progressed beyond begin; refusing supersession'
        receipt_count="$(find "$dir" -maxdepth 1 -type f -name '[0-9][0-9][0-9]-*.json' | wc -l)"
        require_phase_once "$run" begin
        superseded_count="$(phase_count "$run" superseded)"
        if [[ "$superseded_count" == 0 ]]; then
          [[ "$receipt_count" == 1 ]] || die 'stale qualification run is not begin-only'
        else
          [[ "$superseded_count" == 1 && "$receipt_count" == 2 ]] || die 'stale qualification supersession evidence is ambiguous'
          jq -e --arg source "$(source_sha)" 'select(.phase=="superseded" and .status=="pass" and .source_sha256==$source)' "$dir"/[0-9][0-9][0-9]-superseded.json >/dev/null || die 'stale qualification supersession belongs to another source'
        fi
        current_count="$(repository_count)"; current_ids="$(repository_ids_sha)"
        [[ "$current_count" == "$(state_value "$state" initial_snapshot_count)" ]] || die 'repository count changed since stale qualification began'
        [[ "$current_ids" == "$(state_value "$state" initial_snapshot_ids_sha256)" ]] || die 'repository identities changed since stale qualification began'
        verify_run_tree "$run"
        if [[ "$superseded_count" == 0 ]]; then
          record_receipt "$run" superseded pass "old_source_sha256=$old_source new_source_sha256=$(source_sha) begin_only=yes repository_snapshot_count=$current_count repository_ids_unchanged=yes data_snapshot_created=no source_cleanup_witness_sha256=$cleanup_sha"
        fi
        verify_run_tree "$run"
        rm -f -- "$STATE_ROOT/current"
        printf 'superseded_qualification_run=%s\n' "$run"
        printf 'supersession_reason=%s\n' "$supersession_reason"
        echo 'MNX_RESTIC_BEGIN_ONLY_SUPERSESSION=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.run-backup-service kind=function title="Function run_backup_service"
      run_backup_service() {
        local rc
        systemctl reset-failed m16-backup-m21.service 2>/dev/null || true
        set +e
        systemctl start m16-backup-m21.service
        rc="$?"
        set -e
        if [[ "$rc" -ne 0 ]]; then
          echo '################################################################################' >&2
          echo '# M16 RESTIC BACKUP UNIT FAILURE — BOUNDED AUTOMATIC DIAGNOSTICS' >&2
          echo '################################################################################' >&2
          systemctl status m16-backup-m21.service --no-pager -l 2>&1 | tail -n 80 >&2 || true
          journalctl -u m16-backup-m21.service -b --no-pager -o short-iso -n 120 2>&1 | tail -n 120 >&2 || true
          printf 'm16_restic_backup_service_rc=%s\n' "$rc" >&2
          systemctl reset-failed m16-backup-m21.service 2>/dev/null || true
        fi
        return "$rc"
      }

      #@MNX-PART id=70.14.mnx-restic.function.qualify-backup kind=function title="Function qualify_backup"
      qualify_backup() {
        [[ $# == 0 ]] || usage_error 'mnx restic qualify backup'
        require_enrollment; require_disarmed_timers
        local run dir state index before_count before_ids before_bytes before_free after_count after_ids after_bytes after_free growth parent
        run="$(current_run)"; dir="$(run_dir "$run")"; state="$dir/state"
        require_run_identity "$run"
        index="$(state_value "$state" next_backup)"
        [[ "$index" == 1 || "$index" == 2 ]] || die 'the two required qualification backups are already complete'
        require_phase_once "$run" begin
        if [[ "$index" == 2 ]]; then require_phase_once "$run" backup-1; fi
        before_count="$(repository_count)"; before_ids="$(repository_ids_sha)"; before_bytes="$(repository_bytes)"; before_free="$(free_bytes)"
        if ! run_backup_service; then die "physical backup $index failed; bounded unit diagnostics are printed above"; fi
        after_count="$(repository_count)"; after_ids="$(repository_ids_sha)"; after_bytes="$(repository_bytes)"; after_free="$(free_bytes)"
        [[ "$after_count" -eq $((before_count + 1)) ]] || die "backup $index did not add exactly one snapshot"
        [[ "$after_ids" != "$before_ids" ]] || die "backup $index snapshot identity set did not change"
        growth=$((after_bytes - before_bytes)); (( growth >= 0 )) || die 'repository apparent size moved backwards during backup'
        parent="$(repository_latest_parent)"
        update_state_key "$state" next_backup "$((index + 1))"
        record_receipt "$run" "backup-$index" pass "before_count=$before_count after_count=$after_count growth_bytes=$growth before_free_bytes=$before_free after_free_bytes=$after_free latest_id=$(repository_latest_id) latest_parent=''${parent:-none}"
        printf 'backup_index=%s\n' "$index"
        printf 'snapshot_count_before=%s\n' "$before_count"
        printf 'snapshot_count_after=%s\n' "$after_count"
        printf 'repository_growth_bytes=%s\n' "$growth"
        printf 'latest_parent=%s\n' "''${parent:-none}"
        echo 'source_cleanup_receipt=ready-for-local-verification'
        echo 'MNX_RESTIC_QUALIFY_BACKUP=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.validate-cleanup-witness kind=function title="Function validate_cleanup_witness"
      validate_cleanup_witness() {
        local expected="$1" file="$2"
        [[ -f "$file" && ! -L "$file" ]] || die 'cleanup witness must be a regular non-symlink file'
        [[ "$(grep -cx 'schema=mnx.m21.pull-source.receipt.v1' "$file")" == 1 ]] || die 'cleanup receipt schema is absent or duplicated'
        [[ "$(grep -cx "result=$expected" "$file")" == 1 ]] || die 'cleanup receipt outcome differs'
        [[ "$(grep -cx 'snapshot_absent=yes' "$file")" == 1 ]] || die 'cleanup witness does not prove snapshot absence'
        [[ "$(grep -cx 'source_hostname=comfy-m21' "$file")" == 1 ]] || die 'cleanup witness hostname differs'
        [[ "$(grep -cx 'source_uuid=5c208c49-1b6c-411e-899c-fca29e2d5d9b' "$file")" == 1 ]] || die 'cleanup witness source UUID differs'
        [[ "$(grep -cx 'network_initiator=m16' "$file")" == 1 ]] || die 'cleanup witness initiator differs'
        [[ "$(grep -cx 'm21_outbound_connection=none' "$file")" == 1 ]] || die 'cleanup witness outbound boundary differs'
        [[ "$(wc -c < "$file")" -le 2048 ]] || die 'cleanup witness is unbounded'
      }

      #@MNX-PART id=70.14.mnx-restic.function.reconcile-stage51-backup1 kind=function title="Function reconcile_stage51_backup1"
      reconcile_stage51_backup1() {
        local old_run="$1" old_dir old_state new_run new_dir pointer_tmp initial_count initial_ids initial_bytes initial_free current_count current_ids current_bytes current_free growth cleanup_witness cleanup_sha latest latest_id latest_parent
        old_dir="$(run_dir "$old_run")"; old_state="$old_dir/state"
        [[ -f "$old_state" && ! -L "$old_state" && "$(stat -Lc '%U:%G %a' "$old_state")" == 'root:root 600' ]] || die 'Stage51 reconciliation state is absent or unsafe'
        [[ "$(state_value "$old_state" source_sha256)" == 0679b47ba81b8f5a08d63a8af6b96435c87a9aa55a68b3c62db41b35b6617d20 ]] || die 'Stage51 reconciliation source differs'
        [[ "$(state_value "$old_state" running_system)" == /nix/store/2g5qkpvp5kx2ixhbx0h25iz0fks4kkxd-nixos-system-monster-16-25.11pre-git ]] || die 'Stage51 reconciliation running closure differs'
        [[ "$(state_value "$old_state" default_system)" == /nix/store/2g5qkpvp5kx2ixhbx0h25iz0fks4kkxd-nixos-system-monster-16-25.11pre-git ]] || die 'Stage51 reconciliation default closure differs'
        [[ "$(state_value "$old_state" run)" == "$old_run" && "$(state_value "$old_state" next_backup)" == 1 ]] || die 'Stage51 reconciliation state progressed unexpectedly'
        verify_run_tree "$old_run"
        require_phase_once "$old_run" begin
        require_phase_absent "$old_run" backup-1
        initial_count="$(state_value "$old_state" initial_snapshot_count)"
        initial_ids="$(state_value "$old_state" initial_snapshot_ids_sha256)"
        initial_bytes="$(state_value "$old_state" initial_repository_bytes)"
        initial_free="$(state_value "$old_state" initial_free_bytes)"
        [[ "$initial_count" =~ ^[0-9]+$ && "$initial_bytes" =~ ^[0-9]+$ && "$initial_free" =~ ^[0-9]+$ && "$initial_ids" =~ ^[0-9a-f]{64}$ ]] || die 'Stage51 reconciliation baseline is malformed'
        current_count="$(repository_count)"; current_ids="$(repository_ids_sha)"; current_bytes="$(repository_bytes)"; current_free="$(free_bytes)"
        [[ "$current_count" -eq $((initial_count + 1)) ]] || die 'Stage51 reconciliation does not observe exactly one added snapshot'
        [[ "$current_ids" != "$initial_ids" ]] || die 'Stage51 reconciliation snapshot identities did not change'
        growth=$((current_bytes - initial_bytes)); (( growth >= 0 )) || die 'Stage51 reconciliation repository size moved backwards'
        latest="$(repository_json | jq -c 'sort_by(.time) | last')"
        jq -e 'select(.hostname == "comfy-m21" and (.tags | index("m16-pull")) and ([.tags[] | select(startswith("m16-pull-"))] | length) == 1)' <<<"$latest" >/dev/null || die 'Stage51 reconciliation latest snapshot identity or tags differ'
        latest_id="$(jq -r '.id' <<<"$latest")"; latest_parent="$(jq -r '.parent // "none"' <<<"$latest")"
        [[ "$latest_id" =~ ^[0-9a-f]{64}$ ]] || die 'Stage51 reconciliation latest snapshot ID is malformed'
        cleanup_witness=/var/lib/m16-backup-control/m21-last-source-receipt
        validate_cleanup_witness success "$cleanup_witness" || die 'Stage51 successful-export source cleanup witness is invalid'
        cleanup_sha="$(sha256sum "$cleanup_witness" | awk '{print $1}')"
        new_run="$(date -u +%Y%m%dT%H%M%SZ)-$(source_sha | cut -c1-12)"; new_dir="$(run_dir "$new_run")"
        [[ ! -e "$new_dir" && ! -L "$new_dir" ]] || die 'Stage52 reconciliation run identifier collision'
        ensure_private_directory "$STATE_ROOT"; ensure_private_directory "$STATE_ROOT/runs"
        install -d -o root -g root -m 0700 "$new_dir"
        chmod g-s,ug-rwx,u+rwx "$new_dir"
        [[ "$(stat -Lc '%U:%G %a' "$new_dir")" == 'root:root 700' ]] || die 'Stage52 reconciliation directory metadata differs'
        cat > "$new_dir/state" <<EOF
      run=$new_run
      source_sha256=$(source_sha)
      running_system=$(running_system)
      default_system=$(default_system)
      initial_snapshot_count=$initial_count
      initial_snapshot_ids_sha256=$initial_ids
      initial_repository_bytes=$initial_bytes
      initial_free_bytes=$initial_free
      next_backup=2
      reconciled_from_run=$old_run
      EOF
        chmod 0600 "$new_dir/state"
        record_receipt "$new_run" begin pass "reconciled_from_run=$old_run initial_snapshot_count=$initial_count initial_repository_bytes=$initial_bytes initial_free_bytes=$initial_free timers=disarmed old_btrfs=enabled"
        record_receipt "$new_run" backup-1 pass "reconciled_from_run=$old_run snapshot_count_before=$initial_count snapshot_count_after=$current_count growth_bytes=$growth before_free_bytes=$initial_free after_free_bytes=$current_free latest_id=$latest_id latest_parent=$latest_parent source_cleanup_witness_sha256=$cleanup_sha no_repeat_data_work=yes"
        verify_run_tree "$new_run"
        pointer_tmp="$STATE_ROOT/.current.$$"; printf '%s\n' "$new_run" > "$pointer_tmp"; chmod 0600 "$pointer_tmp"; mv -f -- "$pointer_tmp" "$STATE_ROOT/current"
        printf 'reconciled_qualification_run=%s\n' "$new_run"
        printf 'reconciled_backup_1_snapshot=%s\n' "$latest_id"
        echo 'backup_1_repeated=no'
        echo 'source_cleanup_witness=verified'
        echo 'MNX_RESTIC_STAGE51_BACKUP1_RECONCILIATION=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.carry-stage52-first-pair kind=function title="Function carry_stage52_first_pair"
      carry_stage52_first_pair() {
        local old_run="$1" old_dir old_state old_manifest_sha new_run new_dir pointer_tmp initial_count initial_ids initial_bytes initial_free current_count current_ids cleanup_witness cleanup_sha
        old_dir="$(run_dir "$old_run")"; old_state="$old_dir/state"
        [[ -f "$old_state" && ! -L "$old_state" && "$(stat -Lc '%U:%G %a' "$old_state")" == 'root:root 600' ]] || die 'Stage52 carry state is absent or unsafe'
        [[ "$(state_value "$old_state" source_sha256)" == 3c01175ff21aab800eef80eb4aa1323070ace72a4c060c71cc16f53c64231c2e ]] || die 'Stage52 carry source differs'
        [[ "$(state_value "$old_state" running_system)" == /nix/store/nq00mbsx1ii6kc4wy832iz5m2w7jcih2-nixos-system-monster-16-25.11pre-git ]] || die 'Stage52 carry running closure differs'
        [[ "$(state_value "$old_state" default_system)" == /nix/store/nq00mbsx1ii6kc4wy832iz5m2w7jcih2-nixos-system-monster-16-25.11pre-git ]] || die 'Stage52 carry default closure differs'
        [[ "$(state_value "$old_state" run)" == "$old_run" && "$(state_value "$old_state" next_backup)" == 3 ]] || die 'Stage52 carry state differs from a complete first pair'
        verify_run_tree "$old_run"
        require_phase_once "$old_run" begin
        require_phase_once "$old_run" backup-1
        require_phase_once "$old_run" backup-2
        require_phase_once "$old_run" source-cleanup-success
        initial_count="$(state_value "$old_state" initial_snapshot_count)"
        initial_ids="$(state_value "$old_state" initial_snapshot_ids_sha256)"
        initial_bytes="$(state_value "$old_state" initial_repository_bytes)"
        initial_free="$(state_value "$old_state" initial_free_bytes)"
        [[ "$initial_count" =~ ^[0-9]+$ && "$initial_ids" =~ ^[0-9a-f]{64}$ && "$initial_bytes" =~ ^[0-9]+$ && "$initial_free" =~ ^[0-9]+$ ]] || die 'Stage52 carry baseline is malformed'
        current_count="$(repository_count)"; current_ids="$(repository_ids_sha)"
        [[ "$current_count" -eq $((initial_count + 2)) && "$current_ids" != "$initial_ids" ]] || die 'Stage52 two-snapshot repository identity proof no longer holds'
        cleanup_witness=/var/lib/m16-backup-control/m21-last-source-receipt
        validate_cleanup_witness success "$cleanup_witness"
        cleanup_sha="$(sha256sum "$cleanup_witness" | awk '{print $1}')"
        old_manifest_sha="$(sha256sum "$old_dir/SHA256SUMS" | awk '{print $1}')"
        new_run="$(date -u +%Y%m%dT%H%M%SZ)-$(source_sha | cut -c1-12)"; new_dir="$(run_dir "$new_run")"
        [[ ! -e "$new_dir" && ! -L "$new_dir" ]] || die 'Stage53 carry run identifier collision'
        ensure_private_directory "$STATE_ROOT"; ensure_private_directory "$STATE_ROOT/runs"
        install -d -o root -g root -m 0700 "$new_dir"
        cat > "$new_dir/state" <<EOF
      run=$new_run
      source_sha256=$(source_sha)
      running_system=$(running_system)
      default_system=$(default_system)
      initial_snapshot_count=$initial_count
      initial_snapshot_ids_sha256=$initial_ids
      initial_repository_bytes=$initial_bytes
      initial_free_bytes=$initial_free
      next_backup=3
      carried_from_run=$old_run
      EOF
        chmod 0600 "$new_dir/state"
        record_receipt "$new_run" begin pass "carried_from_run=$old_run stage52_manifest_sha256=$old_manifest_sha initial_snapshot_count=$initial_count timers=condition-quarantined old_btrfs=enabled"
        record_receipt "$new_run" backup-1 pass "carried_from_run=$old_run physical_snapshot_preserved=yes data_work_repeated=no"
        record_receipt "$new_run" backup-2 pass "carried_from_run=$old_run repository_snapshot_count=$current_count physical_snapshot_preserved=yes data_work_repeated=no"
        record_receipt "$new_run" source-cleanup-success pass "carried_from_run=$old_run witness_sha256=$cleanup_sha snapshot_absent=yes"
        verify_run_tree "$new_run"
        pointer_tmp="$STATE_ROOT/.current.$$"; printf '%s\n' "$new_run" > "$pointer_tmp"; chmod 0600 "$pointer_tmp"; mv -f -- "$pointer_tmp" "$STATE_ROOT/current"
        printf 'carried_qualification_run=%s\n' "$new_run"
        echo 'first_pair_repeated=no'
        echo 'MNX_RESTIC_STAGE52_FIRST_PAIR_CARRY=PASS'
      }


      #@MNX-PART id=70.14.mnx-restic.function.carry-stage53-partial-run kind=function title="Function carry_stage53_partial_run"
      carry_stage53_partial_run() {
        local old_run="$1" old_dir old_state old_manifest_sha stage52_run stage52_dir stage52_state stage52_manifest_sha
        local initial_count initial_ids initial_bytes initial_free current_count current_ids current_bytes current_free
        local stage53_begin stage53_backup1 stage53_backup2 stage53_cleanup stage52_cleanup cleanup_sha stage53_cleanup_receipt_sha
        local backup1_id backup2_id new_run new_dir pointer_tmp key details
        [[ "$old_run" == "$STAGE53_PARTIAL_RUN" ]] || die "only the exact Stage53 partial run may be carried: $old_run"
        old_dir="$(run_dir "$old_run")"; old_state="$old_dir/state"
        [[ -f "$old_state" && ! -L "$old_state" && "$(stat -Lc '%U:%G %a' "$old_state")" == 'root:root 600' ]] || die 'Stage53 carry state is absent or unsafe'
        [[ "$(state_value "$old_state" source_sha256)" == "$STAGE53_SOURCE_SHA256" ]] || die 'Stage53 carry source differs'
        [[ "$(state_value "$old_state" running_system)" == "$STAGE53_SYSTEM" && "$(state_value "$old_state" default_system)" == "$STAGE53_SYSTEM" ]] || die 'Stage53 carry closure differs'
        [[ "$(state_value "$old_state" run)" == "$old_run" && "$(state_value "$old_state" next_backup)" == 3 ]] || die 'Stage53 carry state differs from the interrupted continuation point'
        require_exact_first_pair_receipts "$old_run" "$STAGE53_SOURCE_SHA256" "$STAGE53_SYSTEM"
        old_manifest_sha="$(sha256sum "$old_dir/SHA256SUMS" | awk '{print $1}')"

        stage52_run="$(state_value "$old_state" carried_from_run)"
        [[ "$stage52_run" =~ ^[0-9]{8}T[0-9]{6}Z-3c01175ff21a$ ]] || die 'Stage53 carry does not name one exact Stage52 run'
        stage52_dir="$(run_dir "$stage52_run")"; stage52_state="$stage52_dir/state"
        [[ -f "$stage52_state" && ! -L "$stage52_state" && "$(stat -Lc '%U:%G %a' "$stage52_state")" == 'root:root 600' ]] || die 'carried Stage52 state is absent or unsafe'
        [[ "$(state_value "$stage52_state" source_sha256)" == "$STAGE52_SOURCE_SHA256" ]] || die 'carried Stage52 source differs'
        [[ "$(state_value "$stage52_state" running_system)" == "$STAGE52_SYSTEM" && "$(state_value "$stage52_state" default_system)" == "$STAGE52_SYSTEM" ]] || die 'carried Stage52 closure differs'
        [[ "$(state_value "$stage52_state" run)" == "$stage52_run" && "$(state_value "$stage52_state" next_backup)" == 3 ]] || die 'carried Stage52 state differs from a complete first pair'
        require_exact_first_pair_receipts "$stage52_run" "$STAGE52_SOURCE_SHA256" "$STAGE52_SYSTEM"
        stage52_manifest_sha="$(sha256sum "$stage52_dir/SHA256SUMS" | awk '{print $1}')"

        for key in initial_snapshot_count initial_snapshot_ids_sha256 initial_repository_bytes initial_free_bytes; do
          [[ "$(state_value "$old_state" "$key")" == "$(state_value "$stage52_state" "$key")" ]] || die "Stage53 and Stage52 carry baselines differ: $key"
        done
        initial_count="$(state_value "$old_state" initial_snapshot_count)"
        initial_ids="$(state_value "$old_state" initial_snapshot_ids_sha256)"
        initial_bytes="$(state_value "$old_state" initial_repository_bytes)"
        initial_free="$(state_value "$old_state" initial_free_bytes)"
        [[ "$initial_count" =~ ^[0-9]+$ && "$initial_ids" =~ ^[0-9a-f]{64}$ && "$initial_bytes" =~ ^[0-9]+$ && "$initial_free" =~ ^[0-9]+$ ]] || die 'Stage53 carry baseline is malformed'

        stage53_begin="$(receipt_details "$old_run" begin)"
        stage53_backup1="$(receipt_details "$old_run" backup-1)"
        stage53_backup2="$(receipt_details "$old_run" backup-2)"
        stage53_cleanup="$(receipt_details "$old_run" source-cleanup-success)"
        stage52_cleanup="$(receipt_details "$stage52_run" source-cleanup-success)"
        [[ "$(detail_value "$stage53_begin" carried_from_run)" == "$stage52_run" ]] || die 'Stage53 begin receipt carries a different Stage52 run'
        [[ "$(detail_value "$stage53_begin" stage52_manifest_sha256)" == "$stage52_manifest_sha" ]] || die 'Stage53 begin receipt carries a different Stage52 manifest'
        for details in "$stage53_backup1" "$stage53_backup2" "$stage53_cleanup"; do
          [[ "$(detail_value "$details" carried_from_run)" == "$stage52_run" ]] || die 'Stage53 carried receipt provenance differs'
        done
        cleanup_sha="$(detail_value "$stage53_cleanup" witness_sha256)"
        [[ "$cleanup_sha" =~ ^[0-9a-f]{64}$ ]] || die 'Stage53 manifested cleanup witness digest is malformed'
        [[ "$(detail_value "$stage52_cleanup" witness_sha256)" == "$cleanup_sha" ]] || die 'Stage53 and Stage52 cleanup witness digests differ'
        stage53_cleanup_receipt_sha="$(sha256sum "$(phase_receipt_path "$old_run" source-cleanup-success)" | awk '{print $1}')"

        current_count="$(repository_count)"; current_ids="$(repository_ids_sha)"; current_bytes="$(repository_bytes)"; current_free="$(free_bytes)"
        [[ "$current_count" -eq $((initial_count + 2)) ]] || die 'repository count no longer equals the exact completed first pair'
        [[ "$current_ids" != "$initial_ids" ]] || die 'repository identity set did not advance from the first-pair baseline'
        [[ "$(detail_value "$stage53_backup2" repository_snapshot_count)" == "$current_count" ]] || die 'Stage53 backup-2 receipt count differs from the live repository'
        backup1_id="$(detail_value "$(receipt_details "$stage52_run" backup-1)" latest_id)"
        backup2_id="$(detail_value "$(receipt_details "$stage52_run" backup-2)" latest_id)"
        repository_has_snapshot_id "$backup1_id" || die 'Stage52 backup-1 snapshot is absent from the live repository'
        repository_has_snapshot_id "$backup2_id" || die 'Stage52 backup-2 snapshot is absent from the live repository'
        [[ "$backup1_id" != "$backup2_id" ]] || die 'the carried first pair does not name two distinct snapshots'

        new_run="$(date -u +%Y%m%dT%H%M%SZ)-$(source_sha | cut -c1-12)"; new_dir="$(run_dir "$new_run")"
        [[ ! -e "$new_dir" && ! -L "$new_dir" ]] || die 'Stage54 carry run identifier collision'
        ensure_private_directory "$STATE_ROOT"; ensure_private_directory "$STATE_ROOT/runs"
        install -d -o root -g root -m 0700 "$new_dir"
        cat > "$new_dir/state" <<EOF
      run=$new_run
      source_sha256=$(source_sha)
      running_system=$(running_system)
      default_system=$(default_system)
      initial_snapshot_count=$initial_count
      initial_snapshot_ids_sha256=$initial_ids
      initial_repository_bytes=$initial_bytes
      initial_free_bytes=$initial_free
      next_backup=3
      carried_from_run=$old_run
      carried_stage52_run=$stage52_run
      carried_repository_snapshot_count=$current_count
      carried_repository_snapshot_ids_sha256=$current_ids
      carried_repository_bytes=$current_bytes
      carried_free_bytes=$current_free
      stage53_manifest_sha256=$old_manifest_sha
      stage52_manifest_sha256=$stage52_manifest_sha
      cleanup_witness_sha256=$cleanup_sha
      EOF
        chmod 0600 "$new_dir/state"
        record_receipt "$new_run" begin pass "carried_from_run=$old_run stage53_manifest_sha256=$old_manifest_sha stage52_run=$stage52_run stage52_manifest_sha256=$stage52_manifest_sha initial_snapshot_count=$initial_count repository_snapshot_count=$current_count timers=condition-quarantined old_btrfs=enabled"
        record_receipt "$new_run" backup-1 pass "carried_from_run=$old_run physical_snapshot_id=$backup1_id physical_snapshot_preserved=yes data_work_repeated=no"
        record_receipt "$new_run" backup-2 pass "carried_from_run=$old_run physical_snapshot_id=$backup2_id repository_snapshot_count=$current_count repository_snapshot_ids_sha256=$current_ids physical_snapshot_preserved=yes data_work_repeated=no"
        record_receipt "$new_run" source-cleanup-success pass "carried_from_run=$old_run manifested_receipt_sha256=$stage53_cleanup_receipt_sha witness_sha256=$cleanup_sha snapshot_absent=yes live_witness_required=no"
        verify_run_tree "$new_run"
        pointer_tmp="$STATE_ROOT/.current.$$"; printf '%s\n' "$new_run" > "$pointer_tmp"; chmod 0600 "$pointer_tmp"; mv -f -- "$pointer_tmp" "$STATE_ROOT/current"
        printf 'carried_qualification_run=%s\n' "$new_run"
        printf 'carried_stage53_run=%s\n' "$old_run"
        echo 'first_pair_repeated=no'
        echo 'live_success_witness_required=no'
        echo 'MNX_RESTIC_STAGE53_PARTIAL_CARRY=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.qualify-source-cleanup kind=function title="Function qualify_source_cleanup"
      qualify_source_cleanup() {
        [[ $# == 1 ]] || usage_error 'mnx restic qualify source-cleanup success|failure'
        local outcome="$1" file=/var/lib/m16-backup-control/m21-last-source-receipt run sha
        [[ "$outcome" == success || "$outcome" == failure ]] || usage_error 'cleanup outcome must be success or failure'
        validate_cleanup_witness "$outcome" "$file"
        run="$(current_run)"; require_run_identity "$run"; sha="$(sha256sum "$file" | awk '{print $1}')"
        if [[ "$outcome" == success ]]; then require_phase_once "$run" backup-2; else require_phase_once "$run" failure-expected; fi
        require_phase_absent "$run" "source-cleanup-$outcome"
        record_receipt "$run" "source-cleanup-$outcome" pass "witness_sha256=$sha witness_bytes=$(wc -c < "$file") source_hostname=comfy-m21 snapshot_absent=yes network_initiator=m16 m21_outbound_connection=none"
        printf 'witness_sha256=%s\n' "$sha"
        echo 'MNX_RESTIC_SOURCE_CLEANUP=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.qualify-first-pair-switch-owned kind=function title="Function qualify_first_pair_switch_owned"
      qualify_first_pair_switch_owned() {
        [[ $# == 1 && "$1" == --switch-owned ]] || usage_error 'first-pair is reserved for accepted mnx switch continuation'
        first_pair_capacity_preflight
        local run dir state next cleanup_count
        if ! run="$(current_run 2>/dev/null)"; then
          qualify_begin
          run="$(current_run)"
        elif [[ "$(state_value "$(run_dir "$run")/state" source_sha256)" != "$(source_sha)" ]]; then
          if [[ "$(state_value "$(run_dir "$run")/state" source_sha256)" == 0679b47ba81b8f5a08d63a8af6b96435c87a9aa55a68b3c62db41b35b6617d20 ]]; then
            reconcile_stage51_backup1 "$run"
          else
            supersede_begin_only_run "$run"
            qualify_begin
          fi
          run="$(current_run)"
        fi
        require_run_identity "$run"
        dir="$(run_dir "$run")"
        state="$dir/state"
        next="$(state_value "$state" next_backup)"
        if [[ "$next" == 1 ]]; then
          qualify_backup
          next="$(state_value "$state" next_backup)"
        fi
        if [[ "$next" == 2 ]]; then
          second_pull_capacity_preflight
          qualify_backup
          next="$(state_value "$state" next_backup)"
        fi
        [[ "$next" == 3 ]] || die "unexpected first-pair continuation state: next_backup=$next"
        cleanup_count="$(phase_count "$run" source-cleanup-success)"
        if [[ "$cleanup_count" == 0 ]]; then
          qualify_source_cleanup success
        fi
        require_phase_once "$run" begin
        require_phase_once "$run" backup-1
        require_phase_once "$run" backup-2
        require_phase_once "$run" source-cleanup-success
        verify_run_tree "$run"
        printf 'qualification_run=%s\n' "$run"
        printf 'repository_snapshot_count=%s\n' "$(repository_count)"
        echo 'physical_pull_count=2'
        echo 'success_cleanup_receipt=verified'
        echo 'timers_changed=no'
        echo 'old_btrfs_timer_changed=no'
        echo 'cutover_authorized=no'
        echo 'MNX_RESTIC_QUALIFY_FIRST_PAIR=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.qualify-failure-expected kind=function title="Function qualify_failure_expected"
      qualify_failure_expected() {
        (
          [[ $# == 1 && "$1" == --switch-owned-interrupted-export ]] || usage_error 'failure qualification is reserved for accepted switch continuation'
          require_enrollment; require_qualification_quarantine
          enroll_adoption_preflight >/dev/null
          enroll_source_probe >/dev/null
          local run before_count before_ids after_count after_ids receipt cleanup_sha tmp interrupted_bytes pipeline_rc ssh_rc sink_rc
          local receipt_ready=no receipt_attempts=0 receipt_rc=unknown receipt_stdout_bytes receipt_stderr_bytes
          local ssh_args
          run="$(current_run)"; require_run_identity "$run"; require_phase_once "$run" backup-2; require_phase_once "$run" source-cleanup-success; require_phase_absent "$run" failure-expected
          before_count="$(repository_count)"; before_ids="$(repository_ids_sha)"
          receipt=/var/lib/m16-backup-control/m21-last-source-receipt
          tmp="$(mktemp -d)"; trap 'rm -rf -- "$tmp"' EXIT
          rm -f -- "$receipt"
          ssh_args=(
            -F /dev/null -T -i "$EXISTING_PULL_ROOT/id_ed25519"
            -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes
            -o HostKeyAlgorithms=ssh-ed25519 -o UserKnownHostsFile="$EXISTING_PULL_ROOT/known_hosts"
            -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no
            -o ConnectTimeout=15 -o ConnectionAttempts=1 -o ServerAliveInterval=15 -o ServerAliveCountMax=2
            backup-source@192.168.100.119
          )
          set +e
          timeout --foreground --signal=TERM --kill-after=30s 5m \
            ssh "''${ssh_args[@]}" export | head -c 1048576 > "$tmp/interrupted-export.bin"
          pipeline_rc=("''${PIPESTATUS[@]}")
          set -e
          ssh_rc="''${pipeline_rc[0]}"; sink_rc="''${pipeline_rc[1]}"
          interrupted_bytes="$(wc -c < "$tmp/interrupted-export.bin")"
          [[ "$interrupted_bytes" == 1048576 ]] || die "interrupted-export probe did not receive the exact bounded prefix: bytes=$interrupted_bytes"
          [[ "$sink_rc" == 0 && "$ssh_rc" != 0 ]] || die "interrupted-export probe did not close the source stream as expected: ssh_rc=$ssh_rc sink_rc=$sink_rc"

          for receipt_attempts in $(seq 1 45); do
            : > "$tmp/receipt.out"; : > "$tmp/receipt.err"
            set +e
            timeout --foreground --signal=TERM --kill-after=10s 30s \
              ssh "''${ssh_args[@]}" receipt > "$tmp/receipt.out" 2> "$tmp/receipt.err"
            receipt_rc="$?"
            set -e
            receipt_stdout_bytes="$(wc -c < "$tmp/receipt.out")"; receipt_stderr_bytes="$(wc -c < "$tmp/receipt.err")"
            [[ "$receipt_stdout_bytes" -le 2048 && "$receipt_stderr_bytes" -le 2048 ]] || die 'm21 cleanup receipt probe exceeded its output bound'
            if [[ "$receipt_rc" == 0 ]] && (validate_cleanup_witness failure "$tmp/receipt.out") >/dev/null 2>&1; then
              receipt_ready=yes
              break
            fi
            sleep 2
          done
          if [[ "$receipt_ready" != yes ]]; then
            printf 'last_receipt_rc=%s\n' "$receipt_rc" >&2
            sed -n '1,80p' "$tmp/receipt.err" >&2 || true
            die "m21 failure cleanup receipt did not become valid after $receipt_attempts bounded attempts"
          fi
          mv -f -- "$tmp/receipt.out" "$receipt"
          validate_cleanup_witness failure "$receipt"
          cleanup_sha="$(sha256sum "$receipt" | awk '{print $1}')"
          after_count="$(repository_count)"; after_ids="$(repository_ids_sha)"
          [[ "$after_count" == "$before_count" && "$after_ids" == "$before_ids" ]] || die 'failed backup changed repository snapshot identity'
          record_receipt "$run" failure-expected pass "ssh_rc=$ssh_rc sink_rc=$sink_rc interrupted_after_bytes=$interrupted_bytes receipt_attempts=$receipt_attempts receipt_rc=$receipt_rc snapshot_count=$after_count snapshot_ids_unchanged=yes network_initiator=m16"
          qualify_source_cleanup failure
          echo 'failure_propagated=yes'
          echo 'repository_snapshot_ids_unchanged=yes'
          echo 'source_cleanup_failure=verified'
          echo 'MNX_RESTIC_QUALIFY_FAILURE=PASS'
        )
      }

      #@MNX-PART id=70.14.mnx-restic.function.qualify-recover kind=function title="Function qualify_recover"
      qualify_recover() {
        [[ $# == 1 && "$1" == --switch-owned ]] || usage_error 'recovery qualification is reserved for accepted switch continuation'
        require_enrollment; require_qualification_quarantine
        local run state expected_before expected_ids before before_ids after after_ids latest cleanup_sha reconciled=no
        run="$(current_run)"; require_run_identity "$run"; require_phase_once "$run" failure-expected; require_phase_once "$run" source-cleanup-failure; require_phase_absent "$run" recovery
        state="$(run_dir "$run")/state"
        expected_before="$(state_value "$state" carried_repository_snapshot_count)"
        expected_ids="$(state_value "$state" carried_repository_snapshot_ids_sha256)"
        [[ "$expected_before" =~ ^[0-9]+$ && "$expected_ids" =~ ^[0-9a-f]{64}$ ]] || die 'recovery carry baseline is absent or malformed'
        before="$(repository_count)"; before_ids="$(repository_ids_sha)"
        if [[ "$before" -eq "$expected_before" && "$before_ids" == "$expected_ids" ]]; then
          if ! run_backup_service; then die 'post-injection recovery backup failed; bounded unit diagnostics are printed above'; fi
          after="$(repository_count)"; after_ids="$(repository_ids_sha)"
        elif [[ "$before" -eq $((expected_before + 1)) && "$before_ids" != "$expected_ids" ]]; then
          after="$before"; after_ids="$before_ids"; reconciled=yes
        else
          die "recovery repository identity is neither the carried pair nor one exact unrecorded recovery: expected_count=$expected_before observed_count=$before"
        fi
        [[ "$after" -eq $((expected_before + 1)) && "$after_ids" != "$expected_ids" ]] || die 'recovery did not establish exactly one new snapshot identity'
        latest="$(repository_json | jq -c 'sort_by(.time) | last')"
        jq -e 'select(.hostname == "comfy-m21" and (.tags | index("m16-pull")) and ([.tags[] | select(startswith("m16-pull-"))] | length) == 1)' <<< "$latest" >/dev/null || die 'recovery latest snapshot identity or tags differ'
        validate_cleanup_witness success /var/lib/m16-backup-control/m21-last-source-receipt
        cleanup_sha="$(sha256sum /var/lib/m16-backup-control/m21-last-source-receipt | awk '{print $1}')"
        record_receipt "$run" recovery pass "expected_before_count=$expected_before after_count=$after before_ids_sha256=$expected_ids after_ids_sha256=$after_ids latest_id=$(jq -r '.id' <<< "$latest") latest_parent=$(jq -r '.parent // "none"' <<< "$latest") source_cleanup_witness_sha256=$cleanup_sha reconciled_unrecorded=$reconciled"
        echo "reconciled_unrecorded_recovery=$reconciled"
        echo 'source_cleanup_recovery=verified'
        echo 'MNX_RESTIC_QUALIFY_RECOVERY=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.qualify-check kind=function title="Function qualify_check"
      qualify_check() {
        [[ $# == 0 ]] || usage_error 'mnx restic qualify check'
        require_enrollment; require_qualification_quarantine
        require_repository_path
        local run log
        run="$(current_run)"; require_run_identity "$run"; require_phase_once "$run" recovery; require_phase_absent "$run" check; log="$(run_dir "$run")/restic-check.log"
        if restic --repo "$REPOSITORY" --password-file "$SECRET_ROOT/repository-password" check > "$log.tmp" 2>&1; then
          chmod 0600 "$log.tmp"; mv -f -- "$log.tmp" "$log"
        else
          chmod 0600 "$log.tmp"; mv -f -- "$log.tmp" "$log"; die 'Restic repository check failed'
        fi
        record_receipt "$run" check pass "log_sha256=$(sha256sum "$log" | awk '{print $1}') log_bytes=$(wc -c < "$log") snapshot_count=$(repository_count)"
        echo 'MNX_RESTIC_QUALIFY_CHECK=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.qualify-restore kind=function title="Function qualify_restore"
      qualify_restore() {
        [[ $# == 0 ]] || usage_error 'mnx restic qualify restore'
        require_enrollment; require_qualification_quarantine
        require_repository_path
        local run target before_free after_free restored_bytes restored_files sample reset_count
        run="$(current_run)"; require_run_identity "$run"; require_phase_once "$run" check; require_phase_absent "$run" restore; target="$RESTORE_ROOT/$run"
        if [[ -e "$target" || -L "$target" ]]; then
          [[ "$target" == "$RESTORE_ROOT/"* && -d "$target" && ! -L "$target" ]] || die 'refusing to reset a noncanonical partial restore target'
          rm -rf --one-file-system -- "$target"
          [[ ! -e "$target" && ! -L "$target" ]] || die 'partial restore target reset failed'
          reset_count="$(phase_count "$run" restore-reset)"
          if [[ "$reset_count" == 0 ]]; then
            record_receipt "$run" restore-reset pass "target=$target absent=yes automatic_retry=yes no_successful_restore_receipt=yes"
          fi
        fi
        ensure_private_directory "$RESTORE_ROOT"
        install -d -o root -g root -m 0700 "$target"
        before_free="$(free_bytes)"
        if ! restic --repo "$REPOSITORY" --password-file "$SECRET_ROOT/repository-password" \
          dump latest /m21-home.tar | tar -xpf - -C "$target"; then
          die "verified tar-stream restore failed; retained for diagnosis: $target"
        fi
        after_free="$(free_bytes)"
        restored_bytes="$(du -s -B1 --apparent-size "$target" | awk '{print $1}')"
        restored_files="$(find "$target" -xdev -type f | wc -l)"
        sample="$(find "$target" -xdev -type f -printf '%P\n' | sort | sed -n '1,256p' | sha256sum | awk '{print $1}')"
        [[ "$restored_files" =~ ^[0-9]+$ && "$restored_files" -gt 0 && "$restored_bytes" =~ ^[0-9]+$ && "$restored_bytes" -gt 0 && "$sample" =~ ^[0-9a-f]{64}$ ]] || die 'restored tree is empty or its measurements are malformed'
        record_receipt "$run" restore pass "target=$target restic_stream_verified=yes tar_extraction_verified=yes restored_bytes=$restored_bytes restored_file_count=$restored_files path_sample_sha256=$sample before_free_bytes=$before_free after_free_bytes=$after_free"
        printf 'restore_target=%s\n' "$target"
        printf 'restored_bytes=%s\n' "$restored_bytes"
        printf 'restored_file_count=%s\n' "$restored_files"
        echo 'next=switch-owned-machine-verification'
        echo 'MNX_RESTIC_QUALIFY_RESTORE=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.qualify-restore-accept kind=function title="Function qualify_restore_accept"
      qualify_restore_accept() {
        [[ $# == 1 && "$1" == --switch-owned-machine-verified ]] || usage_error 'restore acceptance is reserved for accepted switch continuation'
        require_qualification_quarantine
        local run target restored_files restored_bytes sample details expected_files expected_bytes expected_sample
        run="$(current_run)"; require_run_identity "$run"; require_phase_once "$run" restore; require_phase_absent "$run" restore-accepted; target="$RESTORE_ROOT/$run"
        [[ -d "$target" && ! -L "$target" ]] || die 'exact disposable restore target is absent'
        restored_files="$(find "$target" -xdev -type f | wc -l)"; restored_bytes="$(du -s -B1 --apparent-size "$target" | awk '{print $1}')"
        sample="$(find "$target" -xdev -type f -printf '%P\n' | sort | sed -n '1,256p' | sha256sum | awk '{print $1}')"
        details="$(receipt_details "$run" restore)"
        expected_files="$(detail_value "$details" restored_file_count)"; expected_bytes="$(detail_value "$details" restored_bytes)"; expected_sample="$(detail_value "$details" path_sample_sha256)"
        [[ "$restored_files" =~ ^[0-9]+$ && "$restored_files" -gt 0 && "$restored_bytes" =~ ^[0-9]+$ && "$restored_bytes" -gt 0 ]] || die 'restored tree is empty or its measurements are malformed'
        [[ "$restored_files" == "$expected_files" && "$restored_bytes" == "$expected_bytes" && "$sample" == "$expected_sample" ]] || die 'restored tree changed after the verified extraction receipt'
        record_receipt "$run" restore-accepted pass "target=$target machine_verified=yes restic_stream_verified=yes successful_tar_extraction=yes measurements_unchanged=yes restored_file_count=$restored_files restored_bytes=$restored_bytes path_sample_sha256=$sample"
        echo 'MNX_RESTIC_QUALIFY_RESTORE_ACCEPT=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.qualify-restore-clean kind=function title="Function qualify_restore_clean"
      qualify_restore_clean() {
        [[ $# == 1 && "$1" == --confirm-destroy-disposable-restore ]] || usage_error 'mnx restic qualify restore-clean --confirm-destroy-disposable-restore'
        require_qualification_quarantine
        local run target reconciled_absent=no
        run="$(current_run)"; require_run_identity "$run"; require_phase_once "$run" restore-accepted; require_phase_absent "$run" restore-cleaned; target="$RESTORE_ROOT/$run"
        [[ "$target" == "$RESTORE_ROOT/"* ]] || die 'refusing a noncanonical restore cleanup target'
        if [[ -e "$target" || -L "$target" ]]; then
          [[ -d "$target" && ! -L "$target" ]] || die 'refusing to remove a non-directory or symlink restore target'
          rm -rf --one-file-system -- "$target"
        else
          reconciled_absent=yes
        fi
        [[ ! -e "$target" && ! -L "$target" ]] || die 'disposable restore cleanup failed'
        record_receipt "$run" restore-cleaned pass "target=$target absent=yes reconciled_already_absent=$reconciled_absent"
        echo "reconciled_already_absent=$reconciled_absent"
        echo 'MNX_RESTIC_QUALIFY_RESTORE_CLEAN=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.qualify-restore-reset kind=function title="Function qualify_restore_reset"
      qualify_restore_reset() {
        [[ $# == 1 && "$1" == --confirm-destroy-failed-restore ]] || usage_error 'mnx restic qualify restore-reset --confirm-destroy-failed-restore'
        local run target
        run="$(current_run)"; require_run_identity "$run"; require_phase_once "$run" check; require_phase_absent "$run" restore; target="$RESTORE_ROOT/$run"
        [[ "$target" == "$RESTORE_ROOT/"* && -d "$target" && ! -L "$target" ]] || die 'no canonical failed restore target is present'
        rm -rf --one-file-system -- "$target"
        [[ ! -e "$target" ]] || die 'failed restore target cleanup did not complete'
        record_receipt "$run" restore-reset pass "target=$target absent=yes no_successful_restore_receipt=yes"
        echo 'next=mnx restic qualify restore'
        echo 'MNX_RESTIC_QUALIFY_RESTORE_RESET=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.qualify-finalize kind=function title="Function qualify_finalize"
      qualify_finalize() {
        [[ $# == 1 && "$1" == --switch-owned ]] || usage_error 'final qualification is reserved for accepted switch continuation'
        local run dir phase count
        run="$(current_run)"; dir="$(run_dir "$run")"; require_run_identity "$run"; require_phase_absent "$run" final
        verify_run_tree "$run"
        [[ "$(state_value "$dir/state" source_sha256)" == "$(source_sha)" ]] || die 'qualification source no longer matches live source'
        [[ "$(state_value "$dir/state" running_system)" == "$(running_system)" && "$(running_system)" == "$(default_system)" ]] || die 'qualification closure identity changed'
        require_qualification_quarantine
        for phase in begin backup-1 backup-2 source-cleanup-success failure-expected source-cleanup-failure recovery check restore restore-accepted restore-cleaned; do
          count="$(jq -r --arg phase "$phase" 'select(.phase==$phase and .status=="pass") | 1' "$dir"/[0-9][0-9][0-9]-*.json 2>/dev/null | wc -l)"
          [[ "$count" == 1 ]] || die "required phase $phase has $count passing receipts"
        done
        record_receipt "$run" final pass "cutover_authorized=yes timers=condition-quarantined old_btrfs=enabled exact_source_and_closure=yes all_required_phase_receipts=yes"
        verify_run_tree "$run"
        printf 'qualification_run=%s\n' "$run"
        printf 'evidence=%s\n' "$dir"
        echo 'cutover_authorized=yes'
        echo 'MNX_RESTIC_QUALIFICATION=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.automatic-marker-value kind=function title="Function automatic_marker_value"
      automatic_marker_value() {
        local key="$1"
        sed -n "s/^$key=//p" "$AUTOMATIC_ENABLE_MARKER" | tail -n 1
      }

      #@MNX-PART id=70.14.mnx-restic.function.write-automatic-marker kind=function title="Function write_automatic_marker"
      write_automatic_marker() {
        local run="$1" scheduling_receipt="$2" dir tmp
        dir="$(run_dir "$run")"; tmp="$STATE_ROOT/.automatic-enabled.$$"
        {
          echo 'schema=mnx.restic.automatic-enablement.v1'
          printf 'source_sha256=%s\n' "$(source_sha)"
          printf 'running_system=%s\n' "$(running_system)"
          printf 'default_system=%s\n' "$(default_system)"
          printf 'qualification_run=%s\n' "$run"
          printf 'qualification_manifest_sha256=%s\n' "$(sha256sum "$dir/SHA256SUMS" | awk '{print $1}')"
          printf 'scheduling_receipt=%s\n' "$scheduling_receipt"
          echo 'old_btrfs_timer=enabled'
        } > "$tmp"
        chmod 0600 "$tmp"
        mv -f -- "$tmp" "$AUTOMATIC_ENABLE_MARKER"
      }

      #@MNX-PART id=70.14.mnx-restic.function.verify-automatic-marker kind=function title="Function verify_automatic_marker"
      verify_automatic_marker() {
        local run="$1" expected_receipt="$2" dir
        dir="$(run_dir "$run")"
        [[ -f "$AUTOMATIC_ENABLE_MARKER" && ! -L "$AUTOMATIC_ENABLE_MARKER" ]] || die 'automatic Restic scheduling marker is absent or unsafe'
        [[ "$(stat -Lc '%U:%G %a' "$AUTOMATIC_ENABLE_MARKER")" == 'root:root 600' ]] || die 'automatic Restic scheduling marker metadata differs'
        [[ "$(wc -l < "$AUTOMATIC_ENABLE_MARKER")" == 8 ]] || die 'automatic Restic scheduling marker field count differs'
        [[ "$(grep -cx 'schema=mnx.restic.automatic-enablement.v1' "$AUTOMATIC_ENABLE_MARKER")" == 1 ]] || die 'automatic Restic scheduling marker schema differs'
        [[ "$(automatic_marker_value source_sha256)" == "$(source_sha)" ]] || die 'automatic scheduling marker source differs'
        [[ "$(automatic_marker_value running_system)" == "$(running_system)" && "$(automatic_marker_value default_system)" == "$(default_system)" ]] || die 'automatic scheduling marker closure differs'
        [[ "$(automatic_marker_value qualification_run)" == "$run" ]] || die 'automatic scheduling marker qualification run differs'
        [[ "$(automatic_marker_value qualification_manifest_sha256)" == "$(sha256sum "$dir/SHA256SUMS" | awk '{print $1}')" ]] || die 'automatic scheduling marker qualification manifest differs'
        [[ "$(automatic_marker_value scheduling_receipt)" == "$expected_receipt" ]] || die 'automatic scheduling marker receipt state differs'
        [[ "$(automatic_marker_value old_btrfs_timer)" == enabled ]] || die 'automatic scheduling marker lost the old Btrfs soak boundary'
      }

      #@MNX-PART id=70.14.mnx-restic.function.verify-automatic-marker-transition kind=function title="Function verify_automatic_marker_transition"
      verify_automatic_marker_transition() {
        local run="$1" dir receipt receipt_name prior_manifest_sha
        dir="$(run_dir "$run")"; receipt="$(phase_receipt_path "$run" scheduling-enabled)"; receipt_name="$(basename -- "$receipt")"
        [[ -f "$AUTOMATIC_ENABLE_MARKER" && ! -L "$AUTOMATIC_ENABLE_MARKER" && "$(stat -Lc '%U:%G %a' "$AUTOMATIC_ENABLE_MARKER")" == 'root:root 600' ]] || die 'transitional automatic marker is absent or unsafe'
        [[ "$(wc -l < "$AUTOMATIC_ENABLE_MARKER")" == 8 && "$(grep -cx 'schema=mnx.restic.automatic-enablement.v1' "$AUTOMATIC_ENABLE_MARKER")" == 1 ]] || die 'transitional automatic marker shape differs'
        [[ "$(automatic_marker_value source_sha256)" == "$(source_sha)" && "$(automatic_marker_value running_system)" == "$(running_system)" && "$(automatic_marker_value default_system)" == "$(default_system)" ]] || die 'transitional automatic marker identity differs'
        [[ "$(automatic_marker_value qualification_run)" == "$run" && "$(automatic_marker_value scheduling_receipt)" == absent && "$(automatic_marker_value old_btrfs_timer)" == enabled ]] || die 'transitional automatic marker state differs'
        prior_manifest_sha="$(awk -v receipt="$receipt_name" 'NF == 2 && $2 != receipt {print}' "$dir/SHA256SUMS" | sha256sum | awk '{print $1}')"
        [[ "$(automatic_marker_value qualification_manifest_sha256)" == "$prior_manifest_sha" ]] || die 'transitional automatic marker does not bind the pre-receipt manifest'
      }

      #@MNX-PART id=70.14.mnx-restic.function.verify-scheduled-timers kind=function title="Function verify_scheduled_timers"
      verify_scheduled_timers() {
        local unit active sub
        for unit in m16-backup-m21.timer m16-restic-maintenance.timer; do
          [[ "$(systemctl is-enabled "$unit" 2>/dev/null || true)" == enabled ]] || die "$unit lost declarative enablement"
          active="$(systemctl show --property=ActiveState --value "$unit")"; sub="$(systemctl show --property=SubState --value "$unit")"
          [[ "$active" == active && "$sub" == waiting ]] || die "$unit did not enter active/waiting state: $active/$sub"
        done
        [[ "$(systemctl is-enabled m21-btrfs-pull-backup.timer 2>/dev/null || true)" == enabled ]] || die 'old Btrfs timer changed during Restic enablement'
      }

      #@MNX-PART id=70.14.mnx-restic.function.enable-automatic-scheduling kind=function title="Function enable_automatic_scheduling"
      enable_automatic_scheduling() {
        local run schedule_count
        run="$(current_run)"; require_run_identity "$run"; require_phase_once "$run" final
        schedule_count="$(phase_count "$run" scheduling-enabled)"
        [[ "$schedule_count" == 0 || "$schedule_count" == 1 ]] || die "scheduling-enabled has an impossible receipt count: $schedule_count"

        if [[ "$schedule_count" == 1 ]]; then
          if [[ -e "$AUTOMATIC_ENABLE_MARKER" || -L "$AUTOMATIC_ENABLE_MARKER" ]]; then
            if ! (verify_automatic_marker "$run" present) >/dev/null 2>&1; then
              verify_automatic_marker_transition "$run"
              write_automatic_marker "$run" present
            fi
          else
            write_automatic_marker "$run" present
          fi
          trap 'rc=$?; trap - EXIT; systemctl stop m16-backup-m21.timer m16-restic-maintenance.timer 2>/dev/null || true; rm -f -- "$AUTOMATIC_ENABLE_MARKER"; exit "$rc"' EXIT
          systemctl start m16-backup-m21.timer m16-restic-maintenance.timer || die 'automatic timer reactivation failed and its marker was revoked'
          verify_scheduled_timers
          verify_automatic_marker "$run" present
          trap - EXIT
          echo 'automatic_restic_backup=enabled'
          echo 'automatic_restic_maintenance=enabled'
          echo 'old_btrfs_backup=enabled'
          echo 'MNX_RESTIC_AUTOMATIC_ENABLEMENT_ALREADY_ACTIVE=PASS'
          return 0
        fi

        if [[ -e "$AUTOMATIC_ENABLE_MARKER" || -L "$AUTOMATIC_ENABLE_MARKER" ]]; then
          verify_automatic_marker "$run" absent
        else
          require_qualification_quarantine
          write_automatic_marker "$run" absent
        fi
        trap 'rc=$?; trap - EXIT; systemctl stop m16-backup-m21.timer m16-restic-maintenance.timer 2>/dev/null || true; rm -f -- "$AUTOMATIC_ENABLE_MARKER"; exit "$rc"' EXIT
        systemctl start m16-backup-m21.timer m16-restic-maintenance.timer || die 'automatic timer activation failed and its enablement marker was revoked'
        verify_scheduled_timers
        record_receipt "$run" scheduling-enabled pass "backup_timer=enabled-active-waiting maintenance_timer=enabled-active-waiting old_btrfs_timer=enabled automatic_enable_marker=$AUTOMATIC_ENABLE_MARKER"
        write_automatic_marker "$run" present
        verify_automatic_marker "$run" present
        trap - EXIT
        echo 'automatic_restic_backup=enabled'
        echo 'automatic_restic_maintenance=enabled'
        echo 'old_btrfs_backup=enabled'
        echo 'MNX_RESTIC_AUTOMATIC_ENABLEMENT=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.qualify-and-enable-switch-owned kind=function title="Function qualify_and_enable_switch_owned"
      qualify_and_enable_switch_owned() {
        [[ $# == 1 && "$1" == --switch-owned ]] || usage_error 'complete qualification is reserved for accepted mnx switch continuation'
        require_enrollment
        local run source phase_count_value cleanup_count schedule_count
        run="$(current_run)"; source="$(state_value "$(run_dir "$run")/state" source_sha256)"
        if [[ "$source" == "$STAGE53_SOURCE_SHA256" ]]; then
          [[ "$run" == "$STAGE53_PARTIAL_RUN" ]] || die 'the current Stage53 qualification pointer is not the exact accepted partial run'
          carry_stage53_partial_run "$run"
          run="$(current_run)"
        elif [[ "$source" != "$(source_sha)" ]]; then
          die "qualification source is neither the exact Stage53 partial run nor this accepted Stage54 source: $source"
        fi
        require_run_identity "$run"

        schedule_count="$(phase_count "$run" scheduling-enabled)"
        [[ "$schedule_count" == 0 || "$schedule_count" == 1 ]] || die "scheduling-enabled has an impossible receipt count: $schedule_count"
        if [[ "$schedule_count" == 1 || -e "$AUTOMATIC_ENABLE_MARKER" || -L "$AUTOMATIC_ENABLE_MARKER" ]]; then
          require_phase_once "$run" final
          enable_automatic_scheduling
          echo 'MNX_RESTIC_QUALIFY_AND_ENABLE=PASS'
          return 0
        fi

        require_qualification_quarantine
        phase_count_value="$(phase_count "$run" failure-expected)"; cleanup_count="$(phase_count "$run" source-cleanup-failure)"
        if [[ "$phase_count_value" == 0 && "$cleanup_count" == 0 ]]; then
          qualify_failure_expected --switch-owned-interrupted-export
        elif [[ "$phase_count_value" == 1 && "$cleanup_count" == 0 ]]; then
          qualify_source_cleanup failure
        elif [[ "$phase_count_value" != 1 || "$cleanup_count" != 1 ]]; then
          die "failure qualification receipt pair is inconsistent: failure=$phase_count_value cleanup=$cleanup_count"
        fi
        require_phase_once "$run" failure-expected; require_phase_once "$run" source-cleanup-failure

        phase_count_value="$(phase_count "$run" recovery)"
        if [[ "$phase_count_value" == 0 ]]; then qualify_recover --switch-owned; else require_phase_once "$run" recovery; fi
        phase_count_value="$(phase_count "$run" check)"
        if [[ "$phase_count_value" == 0 ]]; then qualify_check; else require_phase_once "$run" check; fi
        phase_count_value="$(phase_count "$run" restore)"
        if [[ "$phase_count_value" == 0 ]]; then qualify_restore; else require_phase_once "$run" restore; fi
        phase_count_value="$(phase_count "$run" restore-accepted)"
        if [[ "$phase_count_value" == 0 ]]; then qualify_restore_accept --switch-owned-machine-verified; else require_phase_once "$run" restore-accepted; fi
        phase_count_value="$(phase_count "$run" restore-cleaned)"
        if [[ "$phase_count_value" == 0 ]]; then qualify_restore_clean --confirm-destroy-disposable-restore; else require_phase_once "$run" restore-cleaned; fi
        phase_count_value="$(phase_count "$run" final)"
        if [[ "$phase_count_value" == 0 ]]; then qualify_finalize --switch-owned; else require_phase_once "$run" final; fi
        enable_automatic_scheduling
        echo 'MNX_RESTIC_QUALIFY_AND_ENABLE=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.verify-maintenance-bridge-intake kind=function title="Function verify_maintenance_bridge_intake"
      verify_maintenance_bridge_intake() {
        local metadata bundle manifest_sha candidate_sha accepted_source accepted_system
        [[ -f "$MAINTENANCE_INTAKE" && ! -L "$MAINTENANCE_INTAKE" ]] || die 'Restic maintenance bridge intake is absent or unsafe'
        metadata="$(stat -Lc '%U:%G %a' "$MAINTENANCE_INTAKE")"
        [[ "$metadata" == 'root:logbook 640' ]] || die "Restic maintenance bridge intake metadata differs: $metadata"
        jq -e 'type=="object" and .schema=="mnx.restic.maintenance.bridge-intake.v2" and .candidate_post_acceptance_plan=="restic-maintenance-recover,journal-integrity-recover-forward,cloudtainer-pack" and (.failed_units|sort)==["logbook-journal-verify.service","m16-restic-maintenance.service"] and .system_state_before=="degraded" and .system_state_after=="running" and .bridge_mutation=="systemd-failure-bookkeeping-only" and .evidence_first==true and .status_assumption=="none" and .service_started==false and .observer_rerun==false and .restic_rerun==false and .journal_mutated==false and .configuration_mutated==false and .profile_mutated==false and .backup_filesystems_written==false and .network_used==false' "$MAINTENANCE_INTAKE" >/dev/null || die 'Restic maintenance bridge intake contract differs'
        candidate_sha="$(jq -r '.candidate_source_sha256 // empty' "$MAINTENANCE_INTAKE")"
        accepted_source="$(jq -r '.accepted_source_sha256 // empty' "$MAINTENANCE_INTAKE")"
        accepted_system="$(jq -r '.accepted_system // empty' "$MAINTENANCE_INTAKE")"
        [[ "$candidate_sha" == "$(source_sha)" ]] || die 'Restic maintenance bridge intake candidate source differs'
        [[ "$accepted_source" == "$STAGE57_SOURCE_SHA256" && "$accepted_system" == "$STAGE57_SYSTEM" ]] || die 'Restic maintenance bridge intake predecessor identity differs'
        bundle="$(jq -r '.evidence_bundle // empty' "$MAINTENANCE_INTAKE")"
        manifest_sha="$(jq -r '.evidence_manifest_sha256 // empty' "$MAINTENANCE_INTAKE")"
        [[ "$bundle" == /var/lib/logbook/incidents/restic-maintenance-bridge-* && -d "$bundle" && ! -L "$bundle" ]] || die 'Restic maintenance bridge evidence path is absent or outside policy'
        /etc/monsternix/bin/mnx-bundle-manifest verify "$bundle" >/dev/null || die 'Restic maintenance bridge evidence manifest failed'
        [[ "$(sha256sum "$bundle/SHA256SUMS" | awk '{print $1}')" == "$manifest_sha" ]] || die 'Restic maintenance bridge manifest identity differs'
        [[ -f "$bundle/summary.json" && ! -L "$bundle/summary.json" && "$(stat -Lc '%U:%G %a' "$bundle/summary.json")" == 'root:logbook 640' ]] || die 'Restic maintenance bridge summary is absent or unsafe'
        jq -e --arg candidate "$candidate_sha" --arg accepted_source "$accepted_source" --arg accepted_system "$accepted_system" 'select(.schema=="mnx.restic.maintenance.bridge-evidence.v2" and .candidate_post_acceptance_plan=="restic-maintenance-recover,journal-integrity-recover-forward,cloudtainer-pack" and .candidate_source_sha256==$candidate and .accepted_source_sha256==$accepted_source and .accepted_system==$accepted_system and (.failed_units|sort)==["logbook-journal-verify.service","m16-restic-maintenance.service"] and .system_state_before=="degraded" and .evidence_first==true and .status_assumption=="none" and .journal_observer.load_state=="loaded" and .journal_observer.active_state=="failed" and .journal_observer.sub_state=="failed" and (.journal_observer.result|type)=="string" and (.journal_observer.result|length)>0 and (.journal_observer.exec_main_code|type)=="number" and (.journal_observer.exec_main_status|type)=="number" and .restic_maintenance.load_state=="loaded" and .restic_maintenance.active_state=="failed" and .restic_maintenance.sub_state=="failed" and (.restic_maintenance.result|type)=="string" and (.restic_maintenance.result|length)>0 and (.restic_maintenance.exec_main_code|type)=="number" and (.restic_maintenance.exec_main_status|type)=="number" and .service_started==false and .observer_rerun==false and .restic_rerun==false and .journal_mutated==false and .configuration_mutated==false and .profile_mutated==false and .backup_filesystems_written==false and .network_used==false)' "$bundle/summary.json" >/dev/null || die 'Restic maintenance bridge evidence summary contract differs'
        printf '%s\n' "$bundle"
      }

      #@MNX-PART id=70.14.mnx-restic.function.maintenance-recover-switch-owned kind=function title="Function maintenance_recover_switch_owned"
      maintenance_recover_switch_owned() {
        [[ $# == 1 && "$1" == --switch-owned ]] || usage_error 'maintenance-recover is reserved for accepted mnx switch continuation'
        [[ "''${MNX_OFFICE_POST_COMMIT_SEAL:-0}" == 1 ]] || die 'maintenance recovery requires accepted post-commit-seal authority'
        [[ "$(running_system)" == "$(default_system)" ]] || die 'maintenance recovery requires one running/default closure'
        [[ "$(source_sha)" == "$(sha256sum /run/current-system/configuration.nix | awk '{print $1}')" ]] || die 'maintenance recovery source differs from the running closure'
        [[ "$(source_sha)" == "$(sha256sum "$(default_system)/configuration.nix" | awk '{print $1}')" ]] || die 'maintenance recovery source differs from the boot-default closure'
        require_enrollment
        local bundle intake_sha current_meta product phase reason evidence current_sha recovery_tmp start_rc
        bundle="$(verify_maintenance_bridge_intake)"
        intake_sha="$(sha256sum "$MAINTENANCE_INTAKE" | awk '{print $1}')"
        local evidence_name
        for evidence_name in summary.json failed-units.txt m16-restic-maintenance.show.txt m16-restic-maintenance.status.txt m16-restic-maintenance.journal.txt m16-restic-maintenance.cat.txt logbook-journal-verify.show.txt logbook-journal-verify.status.txt logbook-journal-verify.journal.txt logbook-journal-verify.default-journal.txt; do
          [[ -f "$bundle/$evidence_name" && ! -L "$bundle/$evidence_name" ]] || die "Restic maintenance bridge evidence file is absent or unsafe: $evidence_name"
          printf '%s\n' "--- manifested predecessor evidence: $evidence_name ---"
          sed -n '1,320p' "$bundle/$evidence_name"
        done
        if [[ -e "$MAINTENANCE_RECOVERY" || -L "$MAINTENANCE_RECOVERY" ]]; then
          [[ -f "$MAINTENANCE_RECOVERY" && ! -L "$MAINTENANCE_RECOVERY" && "$(stat -Lc '%U:%G %a' "$MAINTENANCE_RECOVERY")" == 'root:logbook 640' ]] || die 'Restic maintenance recovery receipt is unsafe'
          jq -e --arg source "$(source_sha)" --arg intake "$intake_sha" 'select(.schema=="mnx.restic.maintenance.recovery.v1" and .source_sha256==$source and .intake_sha256==$intake and .product_status=="pass" and .network_used==false and .secrets_recorded==false)' "$MAINTENANCE_RECOVERY" >/dev/null || die 'Restic maintenance recovery receipt differs'
          echo "bridge_intake=$MAINTENANCE_INTAKE"
          echo "bridge_evidence=$bundle"
          echo 'MNX_RESTIC_MAINTENANCE_RECOVERY_ALREADY_COMPLETE=PASS'
          return 0
        fi
        systemctl reset-failed m16-restic-maintenance.service 2>/dev/null || true
        set +e
        systemctl start m16-restic-maintenance.service
        start_rc="$?"
        set -e
        journalctl -u m16-restic-maintenance.service -b --no-pager -o short-iso -n 260 2>&1 || true
        [[ "$start_rc" == 0 ]] || die "Restic maintenance controller failed during accepted retry: rc=$start_rc"
        [[ -f "$MAINTENANCE_CURRENT" && ! -L "$MAINTENANCE_CURRENT" ]] || die 'Restic maintenance current state was not published'
        current_meta="$(stat -Lc '%U:%G %a' "$MAINTENANCE_CURRENT")"
        [[ "$current_meta" == 'root:logbook 640' ]] || die "Restic maintenance current-state metadata differs: $current_meta"
        jq -e --arg source "$(source_sha)" --arg system "$(running_system)" 'select(.schema=="mnx.restic.maintenance.state.v1" and .source_sha256==$source and .running_system==$system and .default_system==$system and .controller_status=="pass" and .network_used==false and .secrets_recorded==false)' "$MAINTENANCE_CURRENT" >/dev/null || die 'Restic maintenance current state is not bound to the accepted source and closure'
        product="$(jq -r '.product_status' "$MAINTENANCE_CURRENT")"
        phase="$(jq -r '.phase' "$MAINTENANCE_CURRENT")"
        reason="$(jq -r '.reason' "$MAINTENANCE_CURRENT")"
        evidence="$(jq -r '.evidence_bundle' "$MAINTENANCE_CURRENT")"
        current_sha="$(sha256sum "$MAINTENANCE_CURRENT" | awk '{print $1}')"
        printf 'bridge_intake=%s\nbridge_evidence=%s\nmaintenance_product_status=%s\nmaintenance_phase=%s\nmaintenance_reason=%s\nmaintenance_evidence=%s\n' "$MAINTENANCE_INTAKE" "$bundle" "$product" "$phase" "$reason" "$evidence"
        case "$product" in
          pass)
            recovery_tmp="$MAINTENANCE_ROOT/.recovery.json.$$"
            jq -cnS --arg schema mnx.restic.maintenance.recovery.v1 --arg recorded_at "$(date --iso-8601=seconds)" --arg source_sha256 "$(source_sha)" --arg running_system "$(running_system)" --arg intake_sha256 "$intake_sha" --arg current_state_sha256 "$current_sha" --arg evidence_bundle "$evidence" '{schema:$schema,recorded_at:$recorded_at,source_sha256:$source_sha256,running_system:$running_system,default_system:$running_system,intake_sha256:$intake_sha256,current_state_sha256:$current_state_sha256,product_status:"pass",evidence_bundle:$evidence_bundle,network_used:false,secrets_recorded:false}' > "$recovery_tmp"
            chown root:logbook "$recovery_tmp"; chmod 0640 "$recovery_tmp"; mv -f -- "$recovery_tmp" "$MAINTENANCE_RECOVERY"
            echo 'MNX_RESTIC_MAINTENANCE_RECOVERY=PASS'
            ;;
          skipped)
            echo 'MNX_RESTIC_MAINTENANCE_RECOVERY=DEFERRED_LOCK_BUSY'
            return 75
            ;;
          review-required)
            echo 'MNX_RESTIC_MAINTENANCE_RECOVERY=BLOCKED_PRODUCT_FAILURE'
            return 76
            ;;
          *) die "Restic maintenance published an unknown product status: $product" ;;
        esac
      }

      #@MNX-PART id=70.14.mnx-restic.function.secure-backup-reconcile-file kind=function title="Function secure_backup_reconcile_file"
      secure_backup_reconcile_file() {
        local path="$1"
        [[ -f "$path" && ! -L "$path" ]] || return 1
        [[ "$(stat -Lc '%U:%G %a' "$path" 2>/dev/null || true)" == 'root:logbook 640' ]] || return 1
      }

      #@MNX-PART id=70.14.mnx-restic.function.verify-stage68-rejected-candidate-lineage kind=function title="Function verify_stage68_rejected_candidate_lineage"
      verify_stage68_rejected_candidate_lineage() {
        local evidence_candidate="$1" bundle="$2" candidate_copy current_source
        [[ "$evidence_candidate" == "$STAGE68_REJECTED_SOURCE_SHA256" ]] || return 0
        current_source=/etc/nixos/configuration.nix
        secure_backup_reconcile_file "$STAGE68_REJECTED_TEST_REPORT" || die 'rejected Stage68 test report is absent or unsafe'
        for marker in \
          "candidate_configuration_sha256=$STAGE68_REJECTED_SOURCE_SHA256" \
          'mnx_test_result=FAIL_REBUILD' \
          'nixos_rebuild_test_rc=100' \
          'rollback_rc=not-needed-no-activation' \
          'live_source_sha256_after=not-checked' \
          'activated_embedded_configuration_sha256=not-checked' \
          "temporary_running_system=$STAGE67_SYSTEM" \
          "unchanged_boot_default_system=$STAGE67_SYSTEM" \
          'safe_to_run_operator_normal_switch=no' \
          'switch_command=blocked' \
          'boot_default_changed_by_mnx_test=no' \
          'rollback_not_needed=no_activation_observed' \
          '/build/presslog-source.tar.gz.b64: FAILED'; do
          grep -Fq "$marker" "$STAGE68_REJECTED_TEST_REPORT" || die "rejected Stage68 test report lost required no-activation marker: $marker"
        done
        grep -Fxq "# MNX_STAGE68_REJECTED_CANDIDATE_SOURCE_SHA256=$STAGE68_REJECTED_SOURCE_SHA256" "$current_source" || die 'current source lacks rejected Stage68 lineage marker'
        grep -Fxq "# MNX_STAGE68_REJECTED_CANDIDATE_TEST_REPORT=$STAGE68_REJECTED_TEST_REPORT" "$current_source" || die 'current source lacks rejected Stage68 report marker'
        grep -Fxq '# MNX_STAGE68_BACKUP_EVIDENCE_CARRY_FORWARD_POLICY=verified-rejected-stage68-build-with-no-activation-may-carry-predecessor-failure-evidence-to-corrected-same-stage-source-without-rerun-reset-or-status-invention' "$current_source" || die 'current source lacks backup evidence carry-forward policy'
        candidate_copy="$bundle/candidate.nix"
        [[ -f "$candidate_copy" && ! -L "$candidate_copy" && "$(stat -Lc '%U:%G %a' "$candidate_copy" 2>/dev/null || true)" == 'root:logbook 640' ]] || die 'rejected Stage68 candidate copy is absent or unsafe'
        [[ "$(sha256sum "$candidate_copy" | awk '{print $1}')" == "$STAGE68_REJECTED_SOURCE_SHA256" ]] || die 'rejected Stage68 candidate copy identity differs'
        grep -Fxq '#@MNX-OFFICE candidate_stage=68' "$candidate_copy" || die 'rejected evidence candidate is not Stage68'
        grep -Fxq "#@MNX-OFFICE accepted_predecessor_sha256=$STAGE67_SOURCE_SHA256" "$candidate_copy" || die 'rejected evidence candidate predecessor differs'
        grep -Fxq '# MNX_POST_ACCEPTANCE_PLAN=restic-backup-reconcile,cloudtainer-pack' "$candidate_copy" || die 'rejected evidence candidate continuation plan differs'
        grep -Fxq '# MNX_PRESSLOG_SOURCE_ARCHIVE_SHA256=4f04905c797da9a510147df78ba8fe5b60a36c6c51f6508dcc90f95ce2c16402' "$candidate_copy" || die 'rejected evidence candidate Presslog raw archive identity differs'
        grep -Fxq "# MNX_PRESSLOG_SOURCE_ARCHIVE_BASE64_SHA256=$STAGE68_REJECTED_BASE64_SHA256" "$candidate_copy" || die 'rejected evidence candidate did not carry the recorded stale base64 identity'
        grep -Eq '^# MNX_PRESSLOG_SOURCE_ARCHIVE_SHA256=[0-9a-f]{64}$' "$current_source" || die 'current source Presslog raw archive identity marker is absent'
        grep -Eq '^# MNX_PRESSLOG_SOURCE_ARCHIVE_BASE64_SHA256=[0-9a-f]{64}$' "$current_source" || die 'current source Presslog base64 archive identity marker is absent'
      }

      #@MNX-PART id=70.14.mnx-restic.function.find-backup-reconcile-intake kind=function title="Function find_backup_reconcile_intake"
      find_backup_reconcile_intake() {
        local candidate file found= count=0 newest_epoch=-1 epoch evidence_candidate
        candidate="$(source_sha)"
        [[ -d "$DEGRADED_BACKGROUND_ROOT" && ! -L "$DEGRADED_BACKGROUND_ROOT" ]] || die 'degraded-background intake root is absent or unsafe'
        while IFS= read -r -d "" file; do
          secure_backup_reconcile_file "$file" || continue
          evidence_candidate="$(jq -r '.candidate_source_sha256 // empty' "$file" 2>/dev/null || true)"
          case "$evidence_candidate" in "$candidate"|"$STAGE68_REJECTED_SOURCE_SHA256") ;; *) continue ;; esac
          jq -e --arg evidence_candidate "$evidence_candidate" --arg predecessor "$STAGE67_SOURCE_SHA256" --arg predecessor_system "$STAGE67_SYSTEM" \
            'select(.schema=="mnx.degraded-background.intake.v2" and .candidate_source_sha256==$evidence_candidate and .accepted_source_sha256==$predecessor and .accepted_system==$predecessor_system and .candidate_post_acceptance_plan=="restic-backup-reconcile,cloudtainer-pack" and .failed_units==["m16-backup-m21.service"] and (.failed_unit_invocation_id|type)=="string" and (.failed_unit_invocation_id|length)>0 and .system_state_before=="degraded" and .system_state_after=="running" and .bridge_mutation=="systemd-failure-bookkeeping-only" and .evidence_first==true and .status_assumption=="none" and .service_started==false and .journal_verification_run==false and .restic_operation_run==false and .credential_read==false and .repository_accessed==false and .journal_mutated==false and .backup_filesystems_written==false and .profile_mutated==false and .network_used==false)' "$file" >/dev/null 2>&1 || continue
          epoch="$(stat -Lc '%Y' "$file" 2>/dev/null || echo -1)"
          [[ "$epoch" =~ ^[0-9]+$ ]] || continue
          count=$((count + 1))
          if (( epoch > newest_epoch )); then
            newest_epoch="$epoch"
            found="$file"
          elif (( epoch == newest_epoch )) && [[ -n "$found" && "$file" > "$found" ]]; then
            found="$file"
          fi
        done < <(find "$DEGRADED_BACKGROUND_ROOT" -maxdepth 1 -type f -name 'intake-*.json' -print0)
        (( count >= 1 )) || die 'no current-or-explicit-rejected-lineage m16 backup reconciliation intake is available'
        printf '%s\n' "$found"
      }
      #@MNX-PART id=70.14.mnx-restic.function.verify-backup-reconcile-intake kind=function title="Function verify_backup_reconcile_intake"
      verify_backup_reconcile_intake() {
        local intake="$1" bundle manifest_sha candidate evidence_candidate
        candidate="$(source_sha)"
        evidence_candidate="$(jq -r '.candidate_source_sha256 // empty' "$intake")"
        case "$evidence_candidate" in "$candidate"|"$STAGE68_REJECTED_SOURCE_SHA256") ;; *) die 'm16 backup intake candidate is outside current/rejected Stage68 lineage' ;; esac
        jq -e --arg evidence_candidate "$evidence_candidate" --arg predecessor "$STAGE67_SOURCE_SHA256" --arg predecessor_system "$STAGE67_SYSTEM" \
          'select(.schema=="mnx.degraded-background.intake.v2" and .candidate_source_sha256==$evidence_candidate and .accepted_source_sha256==$predecessor and .accepted_system==$predecessor_system and .candidate_post_acceptance_plan=="restic-backup-reconcile,cloudtainer-pack" and .failed_units==["m16-backup-m21.service"] and (.failed_unit_invocation_id|type)=="string" and (.failed_unit_invocation_id|length)>0 and .system_state_before=="degraded" and .system_state_after=="running" and .bridge_mutation=="systemd-failure-bookkeeping-only" and .evidence_first==true and .status_assumption=="none" and .service_started==false and .journal_verification_run==false and .restic_operation_run==false and .credential_read==false and .repository_accessed==false and .journal_mutated==false and .backup_filesystems_written==false and .profile_mutated==false and .network_used==false)' "$intake" >/dev/null || die 'm16 backup predecessor intake contract differs'
        bundle="$(jq -r '.evidence_bundle // empty' "$intake")"
        manifest_sha="$(jq -r '.evidence_manifest_sha256 // empty' "$intake")"
        case "$bundle" in /var/lib/logbook/incidents/mnx-test-degraded-background-*|/var/lib/logbook/incidents/mnx-stage68-bridge-degraded-background-*) ;; *) die 'm16 backup predecessor evidence path is outside policy' ;; esac
        [[ -d "$bundle" && ! -L "$bundle" ]] || die 'm16 backup predecessor evidence path is absent or unsafe'
        [[ "$(stat -Lc '%U:%G %a' "$bundle" 2>/dev/null || true)" == 'root:logbook 2750' ]] || die 'm16 backup predecessor evidence directory metadata differs'
        /etc/monsternix/bin/mnx-bundle-manifest verify "$bundle" >/dev/null || die 'm16 backup predecessor evidence manifest failed'
        [[ "$(sha256sum "$bundle/SHA256SUMS" | awk '{print $1}')" == "$manifest_sha" ]] || die 'm16 backup predecessor evidence manifest identity differs'
        [[ -f "$bundle/summary.json" && ! -L "$bundle/summary.json" && "$(stat -Lc '%U:%G %a' "$bundle/summary.json")" == 'root:logbook 640' ]] || die 'm16 backup predecessor summary is absent or unsafe'
        jq -e --arg evidence_candidate "$evidence_candidate" --arg predecessor "$STAGE67_SOURCE_SHA256" --arg predecessor_system "$STAGE67_SYSTEM" \
          'select(.schema=="mnx.degraded-background.evidence.v2" and .candidate_source_sha256==$evidence_candidate and .accepted_source_sha256==$predecessor and .accepted_system==$predecessor_system and .candidate_post_acceptance_plan=="restic-backup-reconcile,cloudtainer-pack" and .failed_units==["m16-backup-m21.service"] and (.units|length)==1 and .units[0].unit=="m16-backup-m21.service" and .units[0].load_state=="loaded" and .units[0].active_state=="failed" and .units[0].sub_state=="failed" and (.units[0].result|type)=="string" and (.units[0].result|length)>0 and (.units[0].invocation_id|type)=="string" and (.units[0].invocation_id|length)>0 and (.units[0].exec_main_code|type)=="number" and (.units[0].exec_main_status|type)=="number" and .evidence_first==true and .status_assumption=="none" and .service_started==false and .journal_verification_run==false and .restic_operation_run==false and .credential_read==false and .repository_accessed==false and .journal_mutated==false and .backup_filesystems_written==false and .profile_mutated==false and .network_used==false)' "$bundle/summary.json" >/dev/null || die 'm16 backup predecessor evidence summary contract differs'
        [[ "$(jq -r '.failed_unit_invocation_id' "$intake")" == "$(jq -r '.units[0].invocation_id' "$bundle/summary.json")" ]] || die 'm16 backup predecessor intake and evidence invocation identities differ'
        verify_stage68_rejected_candidate_lineage "$evidence_candidate" "$bundle"
        printf '%s\n' "$bundle"
      }
      #@MNX-PART id=70.14.mnx-restic.function.publish-backup-reconcile-state kind=function title="Function publish_backup_reconcile_state"
      publish_backup_reconcile_state() {
        local intake="$1" bundle="$2" prior_status="$3" invocation_id="$4" intake_sha manifest_sha source running default now state_tmp metric_tmp receipt_tmp state_sha evidence_candidate carry_forward
        source="$(source_sha)"; running="$(running_system)"; default="$(default_system)"; now="$(date --iso-8601=seconds)"
        evidence_candidate="$(jq -r '.candidate_source_sha256' "$intake")"
        [[ "$evidence_candidate" == "$source" ]] && carry_forward=false || carry_forward=true
        [[ "$running" == "$default" && "$source" == "$(sha256sum /run/current-system/configuration.nix | awk '{print $1}')" && "$source" == "$(sha256sum "$default/configuration.nix" | awk '{print $1}')" ]] || die 'm16 backup reconciliation accepted-state identity differs'
        intake_sha="$(sha256sum "$intake" | awk '{print $1}')"
        manifest_sha="$(sha256sum "$bundle/SHA256SUMS" | awk '{print $1}')"
        install -d -o root -g logbook -m 0750 "$BACKUP_RECONCILE_ROOT"
        if [[ -e "$BACKUP_RECONCILIATION" || -L "$BACKUP_RECONCILIATION" ]]; then
          secure_backup_reconcile_file "$BACKUP_RECONCILIATION" || die 'm16 backup reconciliation receipt is unsafe'
          jq -e --arg source "$source" --arg intake_sha "$intake_sha" --arg bundle "$bundle" --arg evidence_candidate "$evidence_candidate" --argjson carry_forward "$carry_forward" 'select(.schema=="mnx.restic.backup.reconciliation.v1" and .source_sha256==$source and .intake_sha256==$intake_sha and .evidence_bundle==$bundle and .evidence_candidate_source_sha256==$evidence_candidate and .evidence_carry_forward==$carry_forward and .product_status=="review-required" and .service_started==false and .network_used==false and .credential_read==false and .repository_accessed==false and .backup_filesystems_written==false)' "$BACKUP_RECONCILIATION" >/dev/null || die 'm16 backup reconciliation receipt differs'
          cat "$BACKUP_RECONCILIATION"
          echo 'MNX_RESTIC_BACKUP_RECONCILIATION=ALREADY_RECORDED_REVIEW_REQUIRED'
          return 76
        fi
        state_tmp="$BACKUP_CURRENT.tmp.$$"
        metric_tmp="$BACKUP_METRIC.tmp.$$"
        receipt_tmp="$BACKUP_RECONCILIATION.tmp.$$"
        jq -cnS --arg schema mnx.restic.backup.state.v1 --arg recorded_at "$now" --arg source_sha256 "$source" --arg running_system "$running" --arg default_system "$default" --arg evidence_bundle "$bundle" --arg evidence_manifest_sha256 "$manifest_sha" --arg evidence_candidate_source_sha256 "$evidence_candidate" --argjson evidence_carry_forward "$carry_forward" --arg predecessor_source_sha256 "$STAGE67_SOURCE_SHA256" --arg predecessor_system "$STAGE67_SYSTEM" --arg predecessor_invocation_id "$invocation_id" --argjson command_rc "$prior_status" '{schema:$schema,recorded_at:$recorded_at,source_sha256:$source_sha256,running_system:$running_system,default_system:$default_system,controller_status:"pass",product_status:"review-required",phase:"predecessor-failure-reconciled",reason:"accepted-predecessor-unit-failed",command_rc:$command_rc,duration_seconds:0,evidence_bundle:$evidence_bundle,evidence_manifest_sha256:$evidence_manifest_sha256,evidence_candidate_source_sha256:$evidence_candidate_source_sha256,evidence_carry_forward:$evidence_carry_forward,source_receipt_result:"not-inspected-predecessor-evidence-only",cleanup_snapshot_count:0,cleanup_failure_count:0,network_used:false,secrets_recorded:false,repository:"/mnt/m16-new-storage/admin/backups/restic/m21",m21_outbound_connection:false,reconciliation_only:true,predecessor_source_sha256:$predecessor_source_sha256,predecessor_system:$predecessor_system,predecessor_invocation_id:$predecessor_invocation_id,service_started:false,credential_read:false,repository_accessed:false,backup_filesystems_written:false}' > "$state_tmp"
        chown root:logbook "$state_tmp"; chmod 0640 "$state_tmp"
        {
          echo '# HELP monsternix_restic_backup_product_status Current m21 Restic backup product state: pass=0 skipped=1 review-required=2 malfunction=3.'
          echo '# TYPE monsternix_restic_backup_product_status gauge'
          echo 'monsternix_restic_backup_product_status 2'
          echo '# HELP monsternix_restic_backup_last_command_rc Last underlying predecessor or current controlled-attempt status.'
          echo '# TYPE monsternix_restic_backup_last_command_rc gauge'
          printf 'monsternix_restic_backup_last_command_rc %s\n' "$prior_status"
          echo '# HELP monsternix_restic_backup_reconciliation_only Whether current state came from evidence-only predecessor reconciliation.'
          echo '# TYPE monsternix_restic_backup_reconciliation_only gauge'
          echo 'monsternix_restic_backup_reconciliation_only 1'
        } > "$metric_tmp"
        chown root:root "$metric_tmp"; chmod 0644 "$metric_tmp"
        mv -f -- "$metric_tmp" "$BACKUP_METRIC"
        mv -f -- "$state_tmp" "$BACKUP_CURRENT"
        state_sha="$(sha256sum "$BACKUP_CURRENT" | awk '{print $1}')"
        jq -cnS --arg schema mnx.restic.backup.reconciliation.v1 --arg recorded_at "$now" --arg source_sha256 "$source" --arg running_system "$running" --arg intake "$intake" --arg intake_sha256 "$intake_sha" --arg evidence_bundle "$bundle" --arg evidence_manifest_sha256 "$manifest_sha" --arg evidence_candidate_source_sha256 "$evidence_candidate" --argjson evidence_carry_forward "$carry_forward" --arg current_state_sha256 "$state_sha" --arg predecessor_invocation_id "$invocation_id" --argjson predecessor_exec_main_status "$prior_status" '{schema:$schema,recorded_at:$recorded_at,source_sha256:$source_sha256,running_system:$running_system,default_system:$running_system,intake:$intake,intake_sha256:$intake_sha256,evidence_bundle:$evidence_bundle,evidence_manifest_sha256:$evidence_manifest_sha256,evidence_candidate_source_sha256:$evidence_candidate_source_sha256,evidence_carry_forward:$evidence_carry_forward,current_state_sha256:$current_state_sha256,product_status:"review-required",predecessor_exec_main_status:$predecessor_exec_main_status,predecessor_invocation_id:$predecessor_invocation_id,evidence_first:true,status_assumption:"none",service_started:false,network_used:false,credential_read:false,repository_accessed:false,backup_filesystems_written:false,secrets_recorded:false}' > "$receipt_tmp"
        chown root:logbook "$receipt_tmp"; chmod 0640 "$receipt_tmp"; mv -f -- "$receipt_tmp" "$BACKUP_RECONCILIATION"
        /etc/monsternix/bin/mnx-notify critical 'Monsternix m21 Restic backup review required' "accepted predecessor backup unit failed; no rerun occurred; evidence=$bundle" || true
        cat "$BACKUP_RECONCILIATION"
        echo 'MNX_RESTIC_BACKUP_RECONCILIATION=REVIEW_REQUIRED_NO_RERUN'
        return 76
      }

      #@MNX-PART id=70.14.mnx-restic.function.backup-reconcile-switch-owned kind=function title="Function backup_reconcile_switch_owned"
      backup_reconcile_switch_owned() {
        [[ $# == 1 && "$1" == --switch-owned ]] || usage_error 'backup-reconcile is reserved for accepted mnx switch continuation'
        [[ "''${MNX_OFFICE_POST_COMMIT_SEAL:-0}" == 1 ]] || die 'backup reconciliation requires accepted post-commit-seal authority'
        [[ "$(running_system)" == "$(default_system)" ]] || die 'backup reconciliation requires one running/default closure'
        [[ "$(source_sha)" == "$(sha256sum /run/current-system/configuration.nix | awk '{print $1}')" ]] || die 'backup reconciliation source differs from the running closure'
        [[ "$(source_sha)" == "$(sha256sum "$(default_system)/configuration.nix" | awk '{print $1}')" ]] || die 'backup reconciliation source differs from the boot-default closure'
        local intake bundle prior_status invocation_id evidence_candidate
        intake="$(find_backup_reconcile_intake)"
        bundle="$(verify_backup_reconcile_intake "$intake")"
        evidence_candidate="$(jq -r '.candidate_source_sha256' "$intake")"
        prior_status="$(jq -r '.units[0].exec_main_status' "$bundle/summary.json")"
        invocation_id="$(jq -r '.units[0].invocation_id' "$bundle/summary.json")"
        [[ "$prior_status" =~ ^[0-9]+$ ]] || die 'm16 backup predecessor exit status is not numeric evidence'
        [[ "$invocation_id" =~ ^[0-9a-fA-F-]{16,64}$ ]] || die 'm16 backup predecessor invocation identity is malformed'
        printf 'backup_reconciliation_intake=%s\nbackup_reconciliation_evidence=%s\nbackup_reconciliation_evidence_candidate_source_sha256=%s\npredecessor_exec_main_status=%s\npredecessor_invocation_id=%s\n' "$intake" "$bundle" "$evidence_candidate" "$prior_status" "$invocation_id"
        publish_backup_reconcile_state "$intake" "$bundle" "$prior_status" "$invocation_id"
      }

      #@MNX-PART id=70.14.mnx-restic.function.status-command kind=function title="Function status_command"
      status_command() {
        printf 'enrollment=%s\n' "$([[ -f "$SECRET_ROOT/enabled" ]] && echo armed || echo disarmed)"
        printf 'backup_timer=%s\n' "$(systemctl is-enabled m16-backup-m21.timer 2>/dev/null || true)"
        printf 'maintenance_timer=%s\n' "$(systemctl is-enabled m16-restic-maintenance.timer 2>/dev/null || true)"
        printf 'old_btrfs_timer=%s\n' "$(systemctl is-enabled m21-btrfs-pull-backup.timer 2>/dev/null || true)"
        printf 'automatic_marker=%s\n' "$([[ -f "$AUTOMATIC_ENABLE_MARKER" && ! -L "$AUTOMATIC_ENABLE_MARKER" ]] && echo present || echo absent)"
        if [[ -f "$BACKUP_CURRENT" && ! -L "$BACKUP_CURRENT" ]]; then
          printf 'backup_product_status=%s\n' "$(jq -r '.product_status // "unknown"' "$BACKUP_CURRENT" 2>/dev/null || echo unknown)"
          printf 'backup_phase=%s\n' "$(jq -r '.phase // "unknown"' "$BACKUP_CURRENT" 2>/dev/null || echo unknown)"
          printf 'backup_reason=%s\n' "$(jq -r '.reason // "unknown"' "$BACKUP_CURRENT" 2>/dev/null || echo unknown)"
          printf 'backup_evidence=%s\n' "$(jq -r '.evidence_bundle // "none"' "$BACKUP_CURRENT" 2>/dev/null || echo none)"
          printf 'backup_reconciliation_only=%s\n' "$(jq -r '.reconciliation_only // false' "$BACKUP_CURRENT" 2>/dev/null || echo unknown)"
        else
          echo 'backup_product_status=unknown-never-published'
          echo 'backup_evidence=none'
        fi
        if [[ -f "$MAINTENANCE_CURRENT" && ! -L "$MAINTENANCE_CURRENT" ]]; then
          printf 'maintenance_product_status=%s\n' "$(jq -r '.product_status // "unknown"' "$MAINTENANCE_CURRENT" 2>/dev/null || echo unknown)"
          printf 'maintenance_phase=%s\n' "$(jq -r '.phase // "unknown"' "$MAINTENANCE_CURRENT" 2>/dev/null || echo unknown)"
          printf 'maintenance_reason=%s\n' "$(jq -r '.reason // "unknown"' "$MAINTENANCE_CURRENT" 2>/dev/null || echo unknown)"
          printf 'maintenance_evidence=%s\n' "$(jq -r '.evidence_bundle // "none"' "$MAINTENANCE_CURRENT" 2>/dev/null || echo none)"
        elif [[ -f "$MAINTENANCE_INTAKE" && ! -L "$MAINTENANCE_INTAKE" ]]; then
          echo 'maintenance_product_status=pending-bridge-recovery'
          printf 'maintenance_evidence=%s\n' "$(jq -r '.evidence_bundle // "none"' "$MAINTENANCE_INTAKE" 2>/dev/null || echo none)"
        else
          echo 'maintenance_product_status=unknown-never-published'
          echo 'maintenance_evidence=none'
        fi
        if run="$(current_run 2>/dev/null)"; then
          printf 'qualification_run=%s\n' "$run"
          printf 'qualification_evidence=%s\n' "$(run_dir "$run")"
          verify_run_tree "$run"
        else
          echo 'qualification_run=none'
        fi
        echo 'MNX_RESTIC_STATUS=PASS'
      }

      #@MNX-PART id=70.14.mnx-restic.function.policy-command kind=function title="Function policy_command"
      policy_command() {
        cat <<'EOF'
      schema=mnx.restic.qualification.v1
      authority=m16-controls-schedule-network-initiation-and-local-repository-administration
      enrollment=adopt-existing-only-after-exact-switch-acceptance;never-copies-private-key;rejects-partial-state
      remote_authority=m21-exposes-only-forced-export-and-receipt-on-m16-initiated-ssh
      m21_repository_credentials=none
      m21_outbound_backup_connections=none
      qualification=exact-manifested-stage53-first-pair-carry;local-success-and-failure-cleanup-receipts;failure-rollback;resumable-recovery;check;verified-disposable-tar-restore
      second_increment_policy=measured-not-ceiling
      cutover=authorized-only-after-complete-switch-owned-proof-chain
      timers=declaratively-enabled-and-condition-gated-until-source-closure-run-and-final-manifest-bound-proof-marker
      old_btrfs=preserved-history-manual-service-only
      old_btrfs_schedule=masked-by-accepted-configuration
      old_btrfs_enablement_marker_scope=historical-initial-qualification-not-live-state
      old_btrfs_authority_scope=preserved-legacy-recovery-points-not-mandatory-freshness
      mandatory_m21_freshness=restic-nightly-slot
      legacy_data_deletion_authorized=no
      backup_result_contract=pass-skipped-review-required-product-state-controller-malfunction-hard-failure
      predecessor_backup_reconciliation=evidence-first-reset-failed-no-rerun-network-credential-or-repository-access;rejected-no-activation-stage68-evidence-may-cross-only-through-exact-lineage-proof
      secrets_in_receipts=no
      MNX_RESTIC_POLICY=PASS
      EOF
      }

      #@MNX-PART id=70.14.mnx-restic.function.cleanup-witness-instructions kind=function title="Function cleanup_witness_instructions"
      cleanup_witness_instructions() {
        cat <<'EOF'
      m16 fetches m21's bounded source receipt over the same pinned,
      forced-command SSH authority after success and expected failure. No file
      needs to be carried. Verify the most recently fetched result with:
        sudo mnx restic qualify source-cleanup success
        sudo mnx restic qualify source-cleanup failure
      The accepted switch owns a bounded interrupted-export failure probe; m21
      remains passive and receives no credential or outbound authority.
      EOF
      }

      #@MNX-PART id=70.14.mnx-restic.function.self-test kind=function title="Function self_test"
      self_test() {
        local tmp witness run
        [[ "$STAGE53_PARTIAL_RUN" == 20260822T072402Z-8ea097354164 ]]
        [[ "$STAGE53_SOURCE_SHA256" == 8ea097354164029d95aa1282eb139d823461bfc68f53f89c931c1f9660bcd666 ]]
        [[ "$EXISTING_PULL_ROOT/id_ed25519" == /var/lib/m21-btrfs-pull-backup/id_ed25519 ]]
        [[ "$EXISTING_PULL_ROOT/known_hosts" == /var/lib/m21-btrfs-pull-backup/known_hosts ]]
        [[ "$MAINTENANCE_INTAKE" == /var/lib/monsternix/restic-maintenance/bridge-intake.json ]]
        [[ "$STAGE57_SOURCE_SHA256" == a974ae6205bf2c208fa4c4a082e05d7a0601dbd97ef1e67d553ded6e6aa01f78 ]]
        [[ "$STAGE67_SOURCE_SHA256" == 3276e4b095e14bdca0b32d46198dc700c44fa85ac3e831d9f76e11506dc37e6f ]]
        [[ "$STAGE68_REJECTED_SOURCE_SHA256" == 3e7bbd2a8d558a6d41238a1c9d77296cfa134dd6a9f9ef92f60ee2a5815ab76e ]]
        [[ "$STAGE68_REJECTED_TEST_REPORT" == /var/lib/logbook/support/mnx-test-20260827T180855-1231083.txt ]]
        [[ "$STAGE68_REJECTED_BASE64_SHA256" == 4a9aef075f1166ded7b7aeec18596b01b14451bcb9a6545371b15cba5e07c549 ]]
        [[ "$STAGE68_CORRECTED_BASE64_SHA256" == 07a98de84e25f4efda0ef6b8e78cb9196e22b1dedcbdaa9ff52d7626c36d704e ]]
        [[ "$BACKUP_CURRENT" == /var/lib/monsternix/job-state/authoritative/m16-restic-m21.current.json ]]
        [[ "$BACKUP_RECONCILIATION" == /var/lib/monsternix/restic-backup/reconciliation.json ]]
        grep -Fq 'mnx-stage68-bridge-degraded-background-*' "$0" || die 'backup reconciliation lost the one-time Stage68 bridge evidence prefix'
        grep -Fq '(( count >= 1 ))' "$0" || die 'backup reconciliation regained exact-single-intake brittleness'
        grep -Fq 'epoch > newest_epoch' "$0" || die 'backup reconciliation lost newest-source-bound-intake selection'
        grep -Fq 'verify_stage68_rejected_candidate_lineage' "$0" || die 'backup reconciliation lost rejected-candidate lineage verifier'
        grep -Fq 'rollback_not_needed=no_activation_observed' "$0" || die 'backup reconciliation lost rejected-candidate no-activation proof'
        grep -Fq 'evidence_candidate_source_sha256' "$0" || die 'backup reconciliation lost evidence-candidate provenance publication'
        grep -Fq 'evidence_carry_forward' "$0" || die 'backup reconciliation lost carry-forward provenance publication'
        [[ "$(detail_value 'alpha=1 beta=two gamma=3' beta)" == two ]]
        timer_enablement_is_disarmed disabled
        timer_enablement_is_disarmed linked
        ! timer_enablement_is_disarmed enabled
        ! timer_enablement_is_disarmed enabled-runtime
        ! timer_enablement_is_disarmed active
        ! timer_enablement_is_disarmed unknown
        tmp="$(mktemp -d)"; trap 'rm -rf -- "$tmp"' EXIT
        cat > "$tmp/good" <<'EOF'
      schema=mnx.m21.pull-source.receipt.v1
      result=success
      exit_status=0
      cleanup_status=0
      phase=complete
      source_hostname=comfy-m21
      source_uuid=5c208c49-1b6c-411e-899c-fca29e2d5d9b
      snapshot_absent=yes
      network_initiator=m16
      m21_outbound_connection=none
      EOF
        validate_cleanup_witness success "$tmp/good"
        ! (validate_cleanup_witness failure "$tmp/good") >/dev/null 2>&1
        sed 's/snapshot_absent=yes/snapshot_absent=no/' "$tmp/good" > "$tmp/bad"
        ! (validate_cleanup_witness success "$tmp/bad") >/dev/null 2>&1
        printf 'next_backup=1\n' > "$tmp/state"
        update_state_key "$tmp/state" next_backup 2
        [[ "$(state_value "$tmp/state" next_backup)" == 2 ]]
        [[ "$RESTORE_ROOT/20260821T010203Z-0123456789ab" == "$RESTORE_ROOT/"* ]]
        trap - EXIT
        rm -rf -- "$tmp"
        echo 'MNX_RESTIC_SELF_TEST=PASS'
      }

      command="''${1:-help}"; (( $# == 0 )) || shift
      case "$command" in
        policy) policy_command ;;
        status) require_root "$command" "$@"; acquire_read_lock; status_command ;;
        verify) require_root "$command" "$@"; acquire_read_lock; run="$(current_run)"; verify_run_tree "$run" ;;
        cleanup-witness-instructions) cleanup_witness_instructions ;;
        self-test) self_test ;;
        maintenance-recover) require_root "$command" "$@"; acquire_control_lock; maintenance_recover_switch_owned "$@" ;;
        backup-reconcile) require_root "$command" "$@"; acquire_control_lock; backup_reconcile_switch_owned "$@" ;;
        enroll)
          require_root "$command" "$@"
          sub="''${1:-status}"; (( $# == 0 )) || shift
          [[ "$sub" == status ]] || acquire_control_lock
          case "$sub" in
            adoption-preflight) enroll_adoption_preflight "$@" ;;
            source-probe) enroll_source_probe "$@" ;;
            adopt-existing) enroll_adopt_existing "$@" ;;
            disarm) enroll_disarm "$@" ;;
            status) acquire_read_lock; status_command ;;
            *) usage_error 'mnx restic enroll adoption-preflight|source-probe|disarm|status' ;;
          esac
          ;;
        qualify)
          require_root "$command" "$@"
          sub="''${1:-status}"; (( $# == 0 )) || shift
          [[ "$sub" == status ]] || acquire_control_lock
          case "$sub" in
            begin) qualify_begin "$@" ;;
            capacity-preflight) first_pair_capacity_preflight "$@" ;;
            first-pair) qualify_first_pair_switch_owned "$@" ;;
            backup) qualify_backup "$@" ;;
            source-cleanup) qualify_source_cleanup "$@" ;;
            failure-expected) qualify_failure_expected "$@" ;;
            recover) qualify_recover "$@" ;;
            check) qualify_check "$@" ;;
            restore) qualify_restore "$@" ;;
            restore-accept) qualify_restore_accept "$@" ;;
            restore-clean) qualify_restore_clean "$@" ;;
            restore-reset) qualify_restore_reset "$@" ;;
            finalize) qualify_finalize "$@" ;;
            complete-and-enable) qualify_and_enable_switch_owned "$@" ;;
            status) status_command ;;
            *) usage_error 'unknown mnx restic qualify command' ;;
          esac
          ;;
        help|-h|--help)
          cat <<'EOF'
      mnx restic policy
      mnx restic status
      mnx restic maintenance-recover --switch-owned
      mnx restic backup-reconcile --switch-owned
      mnx restic enroll adoption-preflight
      mnx restic enroll source-probe
      mnx restic enroll disarm
      mnx restic qualify begin
      mnx restic qualify capacity-preflight
      mnx restic qualify backup                    # run exactly twice
      mnx restic cleanup-witness-instructions
      mnx restic qualify source-cleanup success
      mnx restic qualify failure-expected --switch-owned-interrupted-export
      mnx restic qualify source-cleanup failure
      mnx restic qualify recover --switch-owned
      mnx restic qualify check
      mnx restic qualify restore
      mnx restic qualify restore-reset --confirm-destroy-failed-restore  # only after a failed partial restore
      mnx restic qualify restore-accept --switch-owned-machine-verified
      mnx restic qualify restore-clean --confirm-destroy-disposable-restore
      mnx restic qualify finalize
      mnx restic qualify complete-and-enable --switch-owned
      mnx restic verify
      mnx restic self-test
      EOF
          ;;
        *) usage_error "unknown mnx restic command: $command" ;;
      esac
      '';
      checkPhase = ''
        set -Eeuo pipefail
        ${pkgs.bash}/bin/bash -n "$out"
        "$out" self-test | ${pkgs.gnugrep}/bin/grep -Fx 'MNX_RESTIC_SELF_TEST=PASS'
        ${pkgs.gnugrep}/bin/grep -Fq 'MNX_RESTIC_STAGE53_PARTIAL_CARRY=PASS' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'MNX_RESTIC_QUALIFICATION=PASS' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'MNX_RESTIC_QUALIFY_AND_ENABLE=PASS' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'MNX_RESTIC_MAINTENANCE_RECOVERY=PASS' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'MNX_RESTIC_BACKUP_RECONCILIATION=REVIEW_REQUIRED_NO_RERUN' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'repository_accessed:false,backup_filesystems_written:false' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'verify_stage68_rejected_candidate_lineage' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'evidence_candidate_source_sha256' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'cutover_authorized=yes' "$out"
      '';
    };
    mode = "0755";
  };

