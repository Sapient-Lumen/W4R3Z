#@MNX-PART id=90.00.monsterdesk.function.f023r0-server-address-validation kind=function title="Python function validate_nicotine_server_ipv4_addresses"
def validate_nicotine_server_ipv4_addresses(values: Any) -> list[str]:
    if not isinstance(values, list):
        raise MonsterdeskError("Nicotine server resolver did not return a list")
    addresses: list[str] = []
    for value in values:
        if not isinstance(value, str):
            raise MonsterdeskError("Nicotine server resolver returned a non-string address")
        try:
            parsed = ipaddress.ip_address(value)
        except ValueError as exc:
            raise MonsterdeskError("Nicotine server resolver returned an invalid address") from exc
        if not isinstance(parsed, ipaddress.IPv4Address) or not parsed.is_global:
            raise MonsterdeskError("Nicotine server resolver returned a non-public IPv4 address")
        addresses.append(str(parsed))
    addresses = sorted(set(addresses))
    if not (1 <= len(addresses) <= MAX_NICOTINE_SERVER_ADDRESSES):
        raise MonsterdeskError("Nicotine server resolver returned an invalid address count")
    return addresses


#@MNX-PART id=90.00.monsterdesk.function.f023r01-server-resolution kind=function title="Python function nicotine_server_ipv4_addresses"
def nicotine_server_ipv4_addresses() -> list[str]:
    host, port = EXPECTED_NICOTINE_SERVER
    resolver = (
        "import json,socket,sys\n"
        "host=sys.argv[1]; port=int(sys.argv[2])\n"
        "values=sorted({item[4][0] for item in socket.getaddrinfo(host,port,socket.AF_INET,socket.SOCK_STREAM)})\n"
        "print(json.dumps(values,separators=(',',':')))\n"
    )
    try:
        completed = subprocess.run(
            [str(PYTHON), "-c", resolver, host, str(port)],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=NICOTINE_SERVER_RESOLVE_TIMEOUT_SECONDS, check=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise MonsterdeskError("fixed Nicotine server hostname resolution timed out") from exc
    if completed.returncode != 0:
        diagnostic = completed.stderr[:4096].decode("utf-8", errors="replace")
        diagnostic = re.sub(r"[0-9A-Fa-f:.]{4,}", "[address-redacted]", diagnostic)
        raise MonsterdeskError(
            "fixed Nicotine server hostname resolution failed: " + diagnostic[:1000]
        )
    try:
        values = json.loads(completed.stdout[:16384].decode("utf-8", errors="strict"))
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise MonsterdeskError("fixed Nicotine server resolver output is invalid") from exc
    return validate_nicotine_server_ipv4_addresses(values)


#@MNX-PART id=90.00.monsterdesk.function.f023r02-server-hosts-payload kind=function title="Python function nicotine_server_hosts_payload"
def nicotine_server_hosts_payload(addresses: list[str]) -> str:
    selected = validate_nicotine_server_ipv4_addresses(list(addresses))
    host, _port = EXPECTED_NICOTINE_SERVER
    lines = ["127.0.0.1 localhost monsterdesk", "::1 localhost monsterdesk"]
    lines.extend(f"{address} {host}" for address in selected)
    return "\n".join(lines) + "\n"


#@MNX-PART id=90.00.monsterdesk.function.f023r03-prepare-server-hosts kind=function title="Python function prepare_nicotine_server_hosts"
def prepare_nicotine_server_hosts(guest_etc: Path) -> dict[str, Any]:
    addresses = nicotine_server_ipv4_addresses()
    payload = nicotine_server_hosts_payload(addresses)
    atomic_text(guest_etc / "hosts", payload, 0o644)
    digest_input = "\n".join(addresses).encode("ascii")
    return {
        "fixed_hostname": EXPECTED_NICOTINE_SERVER[0],
        "fixed_port": EXPECTED_NICOTINE_SERVER[1],
        "address_count": len(addresses),
        "address_set_sha256": hashlib.sha256(digest_input).hexdigest(),
        "host_resolution_performed": True,
        "private_hosts_fallback_written": True,
        "raw_addresses_exported": False,
        "credential_values_exported": False,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023r1-proc-command-arguments kind=function title="Python function proc_command_arguments"
def proc_command_arguments(pid: int) -> list[str]:
    raw = proc_bytes(Path(f"/proc/{pid}/cmdline"), 256 * 1024)
    return [item.decode("utf-8", errors="replace") for item in raw.split(b"\0") if item][:256]


#@MNX-PART id=90.00.monsterdesk.function.f023r2-pasta-listener-evidence kind=function title="Python function nicotine_pasta_listener_evidence"
def nicotine_pasta_listener_evidence(arguments: list[str], endpoints: list[dict[str, Any]],
                                      port: int = EXPECTED_NICOTINE_PORT) -> dict[str, Any]:
    expected = nicotine_pasta_options(port)
    command_exact = (len(arguments) > len(expected)
                     and arguments[:len(expected)] == expected
                     and arguments[len(expected)] == "--")
    listeners = [
        item for item in endpoints
        if item.get("protocol") == "tcp"
        and item.get("kind") == "listen"
        and int(item.get("port", 0)) == port
    ]
    addresses = sorted({str(item.get("address", "")) for item in listeners})
    exact_address = EXPECTED_NICOTINE_LISTENER_ADDRESS in addresses
    wildcard_address = "0.0.0.0" in addresses
    return {
        "birth_pinned_command_exact": command_exact,
        "interface": NICOTINE_HOST_INTERFACE,
        "address_bound_port_spec": f"{EXPECTED_NICOTINE_LISTENER_ADDRESS}/{port}",
        "listener_addresses": addresses,
        "exact_address_observed": exact_address,
        "ipv4_wildcard_address_observed": wildcard_address,
        "listener_observed": command_exact and exact_address,
        "socket_table_observation_authority": "diagnostic-only",
        "active_connect_required": True,
        "remote_endpoints_exported": False,
    }


#@MNX-PART id=90.00.monsterdesk.function.f023r3-pasta-runtime-evidence kind=function title="Python function nicotine_pasta_runtime_evidence"
def nicotine_pasta_runtime_evidence(pid: int, start_ticks: int) -> dict[str, Any]:
    alive = process_matches(pid, start_ticks)
    if not alive:
        return {
            "birth_pinned_alive": False,
            "birth_pinned_command_exact": False,
            "listener_addresses": [],
            "listener_observed": False,
            "socket_table_observation_authority": "diagnostic-only",
            "remote_endpoints_exported": False,
        }
    evidence = nicotine_pasta_listener_evidence(
        proc_command_arguments(pid), process_socket_endpoints(Path(f"/proc/{pid}"))
    )
    return {**evidence, "birth_pinned_alive": True}


