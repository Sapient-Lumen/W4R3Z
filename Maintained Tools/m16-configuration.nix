          )
            
            
      #@MNX-PART id=40.31.mnx-exposure.function.canonicalize-listeners kind=function title="Python function canonicalize_listeners"
      def canonicalize_listeners(rows: list[dict[str, Any]]) -> list[dict[str, Any]]:
          merged: dict[tuple[Any, ...], dict[str, Any]] = {}
          owner_maps: dict[tuple[Any, ...], dict[tuple[Any, ...], dict[str, Any]]] = {}
          for row in rows:
              key = endpoint_key(row)
              if key not in merged:
                  merged[key] = {**row, "owners": [], "raw_row_count": 0}
                  owner_maps[key] = {}
              target = merged[key]
              target["raw_row_count"] = int(target.get("raw_row_count", 0)) + int(row.get("raw_row_count", 1))
              target["raw_process_present"] = bool(target.get("raw_process_present")) or bool(row.get("raw_process_present"))
              for owner in row.get("owners", []):
                  stable_key = owner_stable_key(owner)
                  if stable_key not in owner_maps[key]:
                      copy = dict(owner)
                      copy["pids"] = sorted({int(owner["pid"])}) if isinstance(owner.get("pid"), int) else []
                      owner_maps[key][stable_key] = copy
                  elif isinstance(owner.get("pid"), int):
                      existing = owner_maps[key][stable_key]
                      existing["pids"] = sorted(set(existing.get("pids", [])) | {int(owner["pid"])})
          result: list[dict[str, Any]] = []
          for key, listener in merged.items():
              owners = list(owner_maps[key].values())
              owners.sort(key=lambda item: (str(item.get("unit")), str(item.get("comm")), str(item.get("package"))))
              listener["owners"] = owners
              listener["netns_classes"] = sorted({str(item.get("netns_class", "host")) for item in owners}) or ["host"]
              result.append(listener)
          result.sort(key=lambda item: (item["protocol"], int(item["local_port"]), item["address_class"], item["local_address"]))
          return result
            
      #@MNX-PART id=40.31.mnx-exposure.function.rpc-surface-present kind=function title="Python function rpc_surface_present"
      def rpc_surface_present(listeners: list[dict[str, Any]]) -> bool:
          for listener in listeners:
              if int(listener.get("local_port", 0)) in RPC_WELL_KNOWN_PORTS:
                  return True
              for owner in listener.get("owners", []):
                  haystack = " ".join(str(owner.get(key, "")).lower() for key in ("unit", "comm", "package", "cgroup"))
                  if any(hint in haystack for hint in RPC_OWNER_HINTS):
                      return True
          return False


      #@MNX-PART id=40.31.mnx-exposure.function.rpc-runtime-active-units kind=function title="Python function rpc_runtime_active_units"
      def rpc_runtime_active_units() -> list[str]:
          active: list[str] = []
          for unit in RPC_RUNTIME_UNITS:
              try:
                  completed = subprocess.run(
                      ["systemctl", "is-active", unit], text=True, stdout=subprocess.PIPE,
                      stderr=subprocess.PIPE, timeout=5, check=False,
                  )
              except (OSError, subprocess.TimeoutExpired) as exc:
                  raise ExposureError(f"cannot classify RPC unit state for {unit}: {exc}") from exc
              state = completed.stdout.strip()
              if state in {"active", "activating", "reloading"}:
                  active.append(unit)
          return active


      #@MNX-PART id=40.31.mnx-exposure.function.normalize-rpcinfo-state kind=function title="Python function normalize_rpcinfo_state"
      def normalize_rpcinfo_state(raw_state: str, *, surface_present: bool, active_units: list[str]) -> str:
          if raw_state in RPCINFO_ACCEPTED_STATES:
              return raw_state
          if raw_state in {"exit-1", "empty"} and not surface_present and not active_units:
              return "disabled-no-rpc-surface"
          return raw_state


      #@MNX-PART id=40.31.mnx-exposure.function.rpc-registry-satisfied kind=function title="Python function rpc_registry_satisfied"
      def rpc_registry_satisfied(state: str) -> bool:
          return state in RPCINFO_ACCEPTED_STATES


      #@MNX-PART id=40.31.mnx-exposure.function.collect-listeners kind=function title="Python function collect_listeners"
      def collect_listeners() -> tuple[list[dict[str, Any]], str, dict[str, Any]]:
          raw = run(["ss", "-H", "-lntup"], timeout=30, check=True)
          raw_size = len(raw.encode("utf-8"))
          if raw_size > MAX_SS_BYTES:
              raise ExposureError(f"ss listener output exceeds {MAX_SS_BYTES} bytes: {raw_size}")
          raw_lines = [line for line in raw.splitlines() if line.strip()]
          if len(raw_lines) > MAX_LISTENERS:
              raise ExposureError(f"listener ceiling exceeded: {len(raw_lines)} > {MAX_LISTENERS}")
          interfaces = interface_map()
          host_netns = host_netns_inode()
          cache: dict[int, dict[str, Any]] = {}
          unit_cache: dict[str, tuple[list[str], str]] = {}
          rows: list[dict[str, Any]] = []
          errors: list[str] = []
          for line in raw_lines:
              try:
                  rows.append(parse_ss_line(line, interfaces, host_netns, cache, unit_cache))
              except ExposureError as exc:
                  errors.append(str(exc))
          if errors:
              raise ExposureError("listener parsing failed: " + " | ".join(errors[:10]))
          listeners = canonicalize_listeners(rows)
          surface_present = rpc_surface_present(listeners)
          active_units = rpc_runtime_active_units()
          rpc_programs, raw_rpcinfo_state = collect_rpc_programs()
          rpcinfo_state = normalize_rpcinfo_state(
              raw_rpcinfo_state, surface_present=surface_present, active_units=active_units
          )
          rpc_attributed = attribute_rpc_listeners(listeners, rpc_programs, host_netns)
          return listeners, raw, {
              "raw_listener_row_total": len(rows),
              "canonical_listener_total": len(listeners),
              "duplicate_listener_row_total": max(0, len(rows) - len(listeners)),
              "rpcinfo_state": rpcinfo_state,
              "rpc_registry_required": bool(surface_present or active_units),
              "rpc_registry_satisfied": rpc_registry_satisfied(rpcinfo_state),
              "rpc_active_unit_total": len(active_units),
              "rpc_active_units": active_units,
              "rpc_program_endpoint_total": len(rpc_programs),
              "rpc_attributed_listener_total": rpc_attributed,
          }
            
      #@MNX-PART id=40.31.mnx-exposure.function.universal-address-port kind=function title="Python function universal_address_port"
      def universal_address_port(value: str) -> int | None:
          pieces = value.rsplit(".", 2)
          if len(pieces) != 3 or not pieces[-2].isdigit() or not pieces[-1].isdigit():
              return None
          high, low = int(pieces[-2]), int(pieces[-1])
          if not (0 <= high <= 255 and 0 <= low <= 255):
              return None
          port = high * 256 + low
          return port if 1 <= port <= 65535 else None
      
      
      #@MNX-PART id=40.31.mnx-exposure.function.parse-rpcinfo-text kind=function title="Python function parse_rpcinfo_text"
      def parse_rpcinfo_text(value: str) -> dict[tuple[str, int], list[str]]:
          mapping: dict[tuple[str, int], set[str]] = {}
          transports = {"tcp": "tcp", "tcp6": "tcp", "udp": "udp", "udp6": "udp"}
          for line in value.splitlines():
              fields = line.split()
              if len(fields) < 4 or not fields[0].isdigit() or not fields[1].isdigit():
                  continue
              protocol = transports.get(fields[2].lower())
              if protocol is None:
                  continue
              if fields[3].isdigit():
                  port = int(fields[3])
              else:
                  port = universal_address_port(fields[3])
              if port is None or port < 1 or port > 65535:
                  continue
              service = fields[4].lower() if len(fields) >= 5 else f"program-{fields[0]}"
              mapping.setdefault((protocol, port), set()).add(service)
          return {key: sorted(names) for key, names in mapping.items()}
      
      
      #@MNX-PART id=40.31.mnx-exposure.function.collect-rpc-programs kind=function title="Python function collect_rpc_programs"
      def collect_rpc_programs() -> tuple[dict[tuple[str, int], list[str]], str]:
          if not RPCINFO.is_file() or not os.access(RPCINFO, os.X_OK):
              return {}, "missing"
          try:
              completed = subprocess.run(
                  [str(RPCINFO)],
                  text=True,
                  stdout=subprocess.PIPE,
                  stderr=subprocess.PIPE,
                  timeout=8,
                  check=False,
              )
          except subprocess.TimeoutExpired:
              return {}, "timeout"
          except OSError as exc:
              return {}, f"oserror-{exc.errno if exc.errno is not None else 'unknown'}"
          if completed.returncode != 0:
              return {}, f"exit-{completed.returncode}"
          mapping = parse_rpcinfo_text(completed.stdout)
          return mapping, "ok" if mapping else "empty"
      
      
      #@MNX-PART id=40.31.mnx-exposure.function.rpc-pseudo-owner kind=function title="Python function rpc_pseudo_owner"
      def rpc_pseudo_owner(names: list[str], host_netns: int | None) -> dict[str, Any]:
          normalized = sorted(set(name.lower() for name in names))
          name_set = set(normalized)
          if "nlockmgr" in name_set:
              unit, comm, package = "nfs-server.service", "kernel-nlockmgr", "kernel-nfs-rpc"
          elif "nfs" in name_set:
              unit, comm, package = "nfs-server.service", "kernel-nfsd", "kernel-nfs-rpc"
          elif "mountd" in name_set:
              unit, comm, package = "nfs-mountd.service", "rpc.mountd", "nfs-utils"
          elif "status" in name_set:
              unit, comm, package = "rpc-statd.service", "rpc.statd", "nfs-utils"
          elif name_set & {"portmapper", "rpcbind"}:
              unit, comm, package = "rpcbind.service", "rpcbind", "rpcbind"
          elif "rquotad" in name_set:
              unit, comm, package = "rpc-rquotad.service", "rpc.rquotad", "nfs-utils"
          else:
              unit, comm, package = "kernel-rpc.service", "kernel-rpc", "kernel-rpc"
          return {
              "pid": 0,
              "pids": [],
              "uid": 0,
              "comm": comm,
              "executable_id": "kernel:rpc:" + ",".join(normalized),
              "package": package,
              "cgroup": "/system.slice/" + unit,
              "unit": unit,
              "netns_inode": host_netns if host_netns is not None else "unknown",
              "netns_class": "host",
              "socket_units": [],
              "socket_lookup": "rpcinfo",
              "rpc_programs": normalized,
          }
      
      
      #@MNX-PART id=40.31.mnx-exposure.function.attribute-rpc-listeners kind=function title="Python function attribute_rpc_listeners"
      def attribute_rpc_listeners(
          listeners: list[dict[str, Any]], rpc_programs: dict[tuple[str, int], list[str]], host_netns: int | None
      ) -> int:
          attributed = 0
          for listener in listeners:
              if listener.get("owners"):
                  continue
              names = rpc_programs.get((str(listener["protocol"]), int(listener["local_port"])), [])
              if not names:
                  continue
              listener["owners"] = [rpc_pseudo_owner(names, host_netns)]
              listener["netns_classes"] = ["host"]
              attributed += 1
          return attributed
      
      
      #@MNX-PART id=40.31.mnx-exposure.function.pattern-matches kind=function title="Python function pattern_matches"
      def pattern_matches(patterns: list[str], value: str) -> bool:
          return any(pattern == "*" or fnmatch.fnmatchcase(value, pattern) for pattern in patterns)
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.port-matches kind=function title="Python function port_matches"
      def port_matches(ranges: list[tuple[int, int]], port: int) -> bool:
          return any(low <= port <= high for low, high in ranges)
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.entry-matches-owner kind=function title="Python function entry_matches_owner"
      def entry_matches_owner(
          entry: dict[str, Any], listener: dict[str, Any], mode: str, owner: dict[str, Any]
      ) -> bool:
          if "any" not in entry["protocols"] and listener["protocol"] not in entry["protocols"]:
              return False
          if not port_matches(entry["port_ranges"], int(listener["local_port"])):
              return False
          if listener["address_class"] not in entry["address_classes"]:
              return False
          if "any" not in entry["netns_classes"] and not set(listener["netns_classes"]) & set(entry["netns_classes"]):
              return False
          if not pattern_matches(entry["mode_patterns"], mode):
              return False
          interfaces = listener.get("interfaces", []) or ["unknown"]
          if not any(pattern_matches(entry["interface_patterns"], interface) for interface in interfaces):
              return False
          if not pattern_matches(entry["unit_patterns"], str(owner.get("unit", "unknown"))):
              return False
          if not pattern_matches(entry["process_patterns"], str(owner.get("comm", "unknown"))):
              return False
          if not pattern_matches(entry["package_patterns"], str(owner.get("package", "unknown"))):
              return False
          if not pattern_matches(entry["cgroup_patterns"], str(owner.get("cgroup", "unknown"))):
              return False
          return True
      
      
      #@MNX-PART id=40.31.mnx-exposure.function.policy-relevant-owners kind=function title="Python function policy_relevant_owners"
      def policy_relevant_owners(listener: dict[str, Any]) -> list[dict[str, Any]]:
          owners = list(listener.get("owners", []))
          preferred = [
              owner for owner in owners
              if not (owner.get("unit") == "init.scope" and owner.get("comm") == "systemd")
          ]
          if preferred:
              return preferred
          if owners:
              return owners
          return [{"unit": "unknown", "comm": "unknown", "package": "unknown", "cgroup": "unknown"}]
      
      
      #@MNX-PART id=40.31.mnx-exposure.function.entry-matches kind=function title="Python function entry_matches"
      def entry_matches(entry: dict[str, Any], listener: dict[str, Any], mode: str) -> bool:
          return any(
              entry_matches_owner(entry, listener, mode, owner)
              for owner in policy_relevant_owners(listener)
          )
      
