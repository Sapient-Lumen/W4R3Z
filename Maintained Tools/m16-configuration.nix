#@MNX-DEF path=users.users.h0p3.hashedPasswordFile section=30.10 role=identity-policy ordinal=032
  users.users.h0p3.hashedPasswordFile = "/etc/nixos/nixos.h0p3.password"; # real one must be synced or generated by the install script, 
#@MNX-DEF path=users.users.h0p3.isNormalUser section=30.10 role=identity-policy ordinal=033
  users.users.h0p3.isNormalUser = true;                             # as NixOS doesn't use a safe hashing mechanism (`mkpasswd -m sha-512`); use `chown root:root` and `chmod 600`
#@MNX-DEF path=users.users.h0p3.extraGroups section=30.10 role=identity-policy ordinal=034
  users.users.h0p3.extraGroups = [ "wheel" "docker" "libvirtd" "networkmanager" "rslsync" "vboxusers" "vboxfs" "video" "audio" "lp" "scanner" "kvm" "wireshark" "vnstat" "lightdm" "bluetooth" "btrbk" "logbook" ];
