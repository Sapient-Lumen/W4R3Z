              'definition_count': len(re.findall(r'(?m)^#@MNX-DEF ', text)),
              'part_count': len(re.findall(r'(?m)^\s*#@MNX-PART ', text)),
              'flow_count': len(re.findall(r'(?m)^#@MNX-FLOW ', text)),
              'law_count': len(re.findall(r'(?m)^#@MNX-LAW ', text)),
              'generated_program_count': len(re.findall(r'(?m)^\s*environment[.]etc[.]"monsternix/bin/[^"\n]+"\s*=\s*\{', text)),
          }
          agenda_sha = sha256_bytes(canonical_json(agenda))
          return {
              'path': str(path),
              'raw': raw,
              'text': text,
              'sha256': sha256_bytes(raw),
              'bytes': len(raw),
              'document_schema': int(schema_matches[0]),
              'agenda': agenda,
              'agenda_sha256': agenda_sha,
              'amnesia_capsule': amnesia_capsule,
              **counts,
          }
      
      
      #@MNX-PART id=99.08.mnx-office.function.read-metric-file kind=function title="Python function read_metric_file"
      def read_metric_file(path: Path) -> dict[str, float]:
          values: dict[str, float] = {}
          try:
              lines = path.read_text(encoding='utf-8', errors='replace').splitlines()
          except OSError:
              return values
          for line in lines:
              if not line or line.startswith('#') or '{' in line:
                  continue
              parts = line.split()
              if len(parts) != 2:
                  continue
              try:
                  values[parts[0]] = float(parts[1])
              except ValueError:
                  continue
          return values
      
      
      #@MNX-PART id=99.08.mnx-office.function.run-text kind=function title="Python function run_text"
      def run_text(command: list[str]) -> tuple[int, str]:
          try:
              result = subprocess.run(command, check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=30)
          except (OSError, subprocess.TimeoutExpired):
              return 127, ""
          return result.returncode, result.stdout.strip()
      
      
      #@MNX-PART id=99.08.mnx-office.function.runtime-paths kind=function title="Python function runtime_paths"
      def runtime_paths() -> dict[str, Path]:
          return {
              'config': Path(os.environ.get('MNX_OFFICE_CONFIG', str(DEFAULT_CONFIG))),
              'state_root': Path(os.environ.get('MNX_OFFICE_STATE_ROOT', str(DEFAULT_STATE_ROOT))),
              'running': Path(os.environ.get('MNX_OFFICE_RUNNING_LINK', '/run/current-system')),
              'default': Path(os.environ.get('MNX_OFFICE_DEFAULT_LINK', '/nix/var/nix/profiles/system')),
              'baseline': Path(os.environ.get('MNX_OFFICE_BASELINE_LINK', str(DEFAULT_BASELINE_LINK))),
              'health': Path(os.environ.get('MNX_OFFICE_HEALTH_METRICS', '/var/lib/node-exporter-textfile/monsternix_storage.prom')),
              'exposure': Path(os.environ.get('MNX_OFFICE_EXPOSURE_CURRENT', '/var/lib/monsternix/exposure/current.json')),
          }
      
      
      #@MNX-PART id=99.08.mnx-office.function.record-path-from-current kind=function title="Python function record_path_from_current"
      def record_path_from_current(state_root: Path) -> Path:
          current = state_root / 'current.json'
          if not current.is_symlink():
              raise OfficeError(f'office current pointer is absent or not a symlink: {current}')
          resolved = safe_resolve(current)
          records = safe_resolve(state_root / 'records')
          try:
              resolved.relative_to(records)
          except ValueError as exc:
              raise OfficeError(f'office current pointer escapes the records directory: {resolved}') from exc
          return resolved
      
      
      #@MNX-PART id=99.08.mnx-office.function.load-record kind=function title="Python function load_record"
      def load_record(path: Path, *, require_root: bool = True) -> dict[str, Any]:
          secure_regular_file(path, require_root=require_root)
          try:
              value = json.loads(path.read_text(encoding='utf-8'))
          except (OSError, json.JSONDecodeError) as exc:
              raise OfficeError(f'cannot parse office record: {path}: {exc}') from exc
          if not isinstance(value, dict):
              raise OfficeError('office record is not a JSON object')
          unknown = sorted(set(value) - ALLOWED_RECORD_KEYS)
          missing = sorted(ALLOWED_RECORD_KEYS - set(value))
          if unknown:
              raise OfficeError(f'office record contains unknown fields: {unknown}')
          if missing:
              raise OfficeError(f'office record is missing fields: {missing}')
          if value.get('record_schema') != RECORD_VERSION:
              raise OfficeError(f'unsupported office record schema: {value.get("record_schema")!r}')
          for key, item in value.items():
              if SENSITIVE_KEY_RE.search(key):
                  raise OfficeError(f'office record contains a sensitive field name: {key}')
              if isinstance(item, str):
                  assert_safe_public_value(key, item)
          return value
      
      
      #@MNX-PART id=99.08.mnx-office.function.field kind=function title="Python function field"
      def field(report: dict[str, str], *keys: str) -> str:
          for key in keys:
              if report.get(key, ""):
                  return report[key]
          return ""
      
      
      #@MNX-PART id=99.08.mnx-office.function.continuation-overlay kind=function title="Python function continuation_overlay"
      def continuation_overlay(record: dict[str, Any], source: dict[str, Any], *, require_root: bool = True) -> dict[str, Any]:
          switch_path = Path(record['switch_report'])
          switch = parse_key_value_report(switch_path)
          core_result = field(switch, 'core_acceptance_result', 'office_acceptance_intended_result') or record['switch_result']
          final_result = field(switch, 'mnx_switch_result') or 'unknown'
          plan = field(switch, 'post_acceptance_plan') or 'none'
          status = field(switch, 'post_acceptance_status') or ('none' if plan == 'none' else 'unknown')
          action_results = field(switch, 'post_acceptance_action_results') or ('none' if plan == 'none' else 'unknown')
          mutation_proof = field(switch, 'post_acceptance_mutation_proof') or ('pass' if plan == 'none' else 'unknown')
          receipt_text = field(switch, 'post_acceptance_receipt')
          receipt_status = 'not-declared'
          receipt_fields: dict[str, str] = {}
          if receipt_text:
              receipt_path = Path(receipt_text)
              if not path_is_public_evidence(receipt_path):
                  raise OfficeError('post-acceptance receipt points outside approved evidence roots')
              secure_regular_file(receipt_path, require_root=require_root)
              receipt_fields = parse_key_value_report(receipt_path)
              expected = {
                  'source_sha256': source['sha256'],
                  'plan': plan,
                  'status': status,
                  'action_results': action_results,
                  'mutation_proof': mutation_proof,
              }
              for key, value in expected.items():
                  if receipt_fields.get(key, "") != value:
                      raise OfficeError(f'post-acceptance receipt differs from finalized switch report: {key}')
              receipt_status = 'verified'
          attention_reasons: list[str] = []
          if final_result.startswith('FAIL_'):
              attention_reasons.append('final-switch-failure')
          if status in {'contract-violation', 'completed-with-blocker', 'deferred', 'interrupted'}:
              attention_reasons.append('post-acceptance-' + status)
          if mutation_proof not in {'pass', 'none'}:
              attention_reasons.append('post-acceptance-mutation-proof-' + mutation_proof.lower())
          declared_stage = source['agenda']['after_acceptance_next_stage']
          declared_objective = source['agenda']['after_acceptance_next_objective']
          effective_stage = declared_stage
          effective_objective = declared_objective
          effective_source = 'source-agenda'
          if final_result == 'FAIL_POST_ACCEPTANCE_CONTRACT_AFTER_ACCEPTANCE' or status == 'contract-violation' or mutation_proof == 'FAIL':
              effective_objective = 'reconcile-post-acceptance-contract-before-declared-next-objective'
              effective_source = 'finalized-runtime-overlay'
          elif final_result == 'PASS_WITH_POST_ACCEPTANCE_BLOCKER' or status == 'completed-with-blocker':
              effective_objective = 'review-post-acceptance-blocker-before-declared-next-objective'
              effective_source = 'finalized-runtime-overlay'
          elif final_result == 'PASS_WITH_POST_ACCEPTANCE_DEFERRED' or status == 'deferred':
              effective_objective = 'resume-post-acceptance-continuation-before-declared-next-objective'
              effective_source = 'finalized-runtime-overlay'
          elif final_result == 'PASS_WITH_POST_ACCEPTANCE_INTERRUPTED' or status == 'interrupted':
              effective_objective = 'inspect-interrupted-post-acceptance-continuation-before-declared-next-objective'
              effective_source = 'finalized-runtime-overlay'
          return {
              'core_switch_result': core_result,
              'final_switch_result': final_result,
              'post_acceptance_plan': plan,
              'post_acceptance_status': status,
              'post_acceptance_action_results': action_results,
              'post_acceptance_mutation_proof': mutation_proof,
              'post_acceptance_receipt': receipt_text or 'none',
              'post_acceptance_receipt_status': receipt_status,
              'attention_required': bool(attention_reasons),
              'attention_reasons': attention_reasons,
              'declared_next_stage': declared_stage,
              'declared_next_objective': declared_objective,
              'effective_next_stage': effective_stage,
              'effective_next_objective': effective_objective,
              'effective_next_source': effective_source,
          }
      
      
      #@MNX-PART id=99.08.mnx-office.function.evidence-digest kind=function title="Python function evidence_digest"
      def evidence_digest(report: dict[str, str], keys: tuple[str, ...]) -> str:
          selected = {key: report.get(key, "") for key in keys}
          return sha256_bytes(canonical_json(selected))
      
      
      #@MNX-PART id=99.08.mnx-office.function.test-evidence-digest kind=function title="Python function test_evidence_digest"
      def test_evidence_digest(report: dict[str, str]) -> str:
          return evidence_digest(report, (
              'mnx_test_result',
              'mnx_bootstrap_test_result',
              'candidate_configuration_sha256',
              'candidate_sha256',
              'post_test_audit_rc',
              'temporary_code_region_count',
              'old_storage_direct_write_by_mnx_test',
              'old_storage_direct_write_by_bootstrap',
              'temporary_running_system',
              'current_running_system',
              'tested_system',
          ))
      
      
      #@MNX-PART id=99.08.mnx-office.function.switch-evidence-digest kind=function title="Python function switch_evidence_digest"
      def switch_evidence_digest(report: dict[str, str]) -> str:
          # The switch transcript is still open when acceptance is committed. Its final epilogue adds the
          # candidate_configuration_sha256 alias after configuration_sha256 was already printed. Hash one
          # canonical semantic source field so transcript finalization cannot change accepted evidence.
          selected = {
              'source_sha256': field(report, 'candidate_configuration_sha256', 'configuration_sha256'),
              'office_acceptance_ready': report.get('office_acceptance_ready', ""),
              'office_acceptance_intended_result': report.get('office_acceptance_intended_result', ""),
              'office_acceptance_running_system': report.get('office_acceptance_running_system', ""),
              'office_acceptance_default_system': report.get('office_acceptance_default_system', ""),
              'office_acceptance_post_audit_rc': report.get('office_acceptance_post_audit_rc', ""),
              'office_acceptance_behavior_contract_rc': report.get('office_acceptance_behavior_contract_rc', ""),
              'office_acceptance_old_storage_write': report.get('office_acceptance_old_storage_write', ""),
          }
          return sha256_bytes(canonical_json(selected))
      
      
      #@MNX-PART id=99.08.mnx-office.function.legacy-switch-evidence-digests kind=function title="Python function legacy_switch_evidence_digests"
      def legacy_switch_evidence_digests(report: dict[str, str]) -> dict[str, str]:
          # Stage-23's first record used the pre-fix alias-set digest. Preserve only the two deterministic
          # forms that could have been committed before or after the final epilogue; new records never use them.
          keys = (
              'candidate_configuration_sha256',
              'configuration_sha256',
              'office_acceptance_ready',
              'office_acceptance_intended_result',
              'office_acceptance_running_system',
              'office_acceptance_default_system',
              'office_acceptance_post_audit_rc',
              'office_acceptance_behavior_contract_rc',
              'office_acceptance_old_storage_write',
          )
          finalized = evidence_digest(report, keys)
          pre_finalization = dict(report)
          pre_finalization['candidate_configuration_sha256'] = ""
          return {
              'legacy-finalized-alias-set': finalized,
              'legacy-pre-finalization-alias-set': evidence_digest(pre_finalization, keys),
          }
      
      
      #@MNX-PART id=99.08.mnx-office.function.validate-switch-evidence-digest kind=function title="Python function validate_switch_evidence_digest"
      def validate_switch_evidence_digest(stored: str, report: dict[str, str], *, allow_legacy: bool = False) -> str:
          if stored == switch_evidence_digest(report):
              return 'canonical-semantic-source'
          if allow_legacy:
              for mode, digest in legacy_switch_evidence_digests(report).items():
                  if stored == digest:
                      return mode
          raise OfficeError('office record switch evidence digest differs')
      
      
      #@MNX-PART id=99.08.mnx-office.function.validate-test-report kind=function title="Python function validate_test_report"
      def validate_test_report(path: Path, source_sha: str, *, require_root: bool = True) -> dict[str, str]:
          secure_regular_file(path, require_root=require_root)
          report = parse_key_value_report(path)
          result = field(report, 'mnx_test_result', 'mnx_bootstrap_test_result')
          candidate_sha = field(report, 'candidate_configuration_sha256', 'candidate_sha256')
          if not result.startswith('PASS'):
              raise OfficeError(f'accepted test report did not pass: {result!r}')
          if candidate_sha != source_sha:
              raise OfficeError(f'accepted test report source hash differs: {candidate_sha!r}')
          if field(report, 'post_test_audit_rc') != '0':
              raise OfficeError('accepted test report postflight did not pass')
          temporary = field(report, 'temporary_code_region_count') or '0'
          if temporary != '0':
              raise OfficeError(f'accepted test report contains temporary code: {temporary}')
          old_write = field(report, 'old_storage_direct_write_by_mnx_test', 'old_storage_direct_write_by_bootstrap')
          if old_write and old_write != 'no':
              raise OfficeError(f'accepted test report did not prove old-storage safety: {old_write}')
          return report
      
      
      #@MNX-PART id=99.08.mnx-office.function.validate-switch-report kind=function title="Python function validate_switch_report"
      def validate_switch_report(path: Path, source_sha: str, *, require_root: bool = True, allow_incomplete: bool = False) -> dict[str, str]:
          secure_regular_file(path, require_root=require_root)
          report = parse_key_value_report(path)
          result = field(report, 'mnx_switch_result')
          candidate_sha = field(report, 'candidate_configuration_sha256', 'configuration_sha256')
          if candidate_sha and candidate_sha != source_sha:
              raise OfficeError(f'switch report source hash differs: {candidate_sha!r}')
          if field(report, 'office_acceptance_ready') != 'yes':
              raise OfficeError('switch report lacks the office acceptance-ready gate')
          if field(report, 'office_acceptance_post_audit_rc') != '0':
              raise OfficeError('switch report office acceptance postflight did not pass')
          if field(report, 'office_acceptance_behavior_contract_rc') != '0':
              raise OfficeError('switch report office acceptance behavior contract did not pass')
          if field(report, 'office_acceptance_old_storage_write') != 'no':
              raise OfficeError('switch report office acceptance did not prove old-storage safety')
          intended = field(report, 'office_acceptance_intended_result')
          if intended not in {'PASS', 'PASS_ALREADY_ACTIVE_DEFAULT'}:
              raise OfficeError(f'switch report has invalid office acceptance result: {intended!r}')

          core_result = field(report, 'core_acceptance_result')
          post_status = field(report, 'post_acceptance_status')
          seal_rc = field(report, 'post_commit_seal_rc')
          if not result:
              if not allow_incomplete:
                  raise OfficeError('switch report lacks a final mnx_switch_result marker')
              if os.environ.get('MNX_OFFICE_SWITCH_TRANSACTION') == '1':
                  pass
              elif os.environ.get('MNX_OFFICE_POST_COMMIT_SEAL') == '1':
                  if field(report, 'post_commit_seal_intended_result') != intended:
                      raise OfficeError('open switch report lacks the exact post-commit-seal intended result')
              else:
                  raise OfficeError('incomplete switch evidence is not authorized outside commit or post-commit seal')
          elif core_result:
              if core_result != intended:
                  raise OfficeError('switch report core acceptance differs from the committed office result')
              if seal_rc != '0':
                  raise OfficeError('switch report final result lacks a successful post-commit seal')
              allowed_results = {
                  'pass': {intended},
                  'none': {intended},
                  'already-recorded': {intended},
                  'completed-with-blocker': {f'{intended}_WITH_POST_ACCEPTANCE_BLOCKER'},
                  'deferred': {f'{intended}_WITH_POST_ACCEPTANCE_DEFERRED'},
                  'interrupted': {f'{intended}_WITH_POST_ACCEPTANCE_INTERRUPTED'},
                  'contract-violation': {'FAIL_POST_ACCEPTANCE_CONTRACT_AFTER_ACCEPTANCE'},
              }
              if post_status not in allowed_results:
                  raise OfficeError(f'switch report has invalid post-acceptance status: {post_status!r}')
              if result not in allowed_results[post_status]:
                  raise OfficeError('switch report final result is inconsistent with core acceptance and post-acceptance status')
          else:
              # Accepted records from schemas before the two-result contract have one PASS marker only.
              if result != intended:
                  raise OfficeError('legacy switch report final result differs from the committed office result')

          if field(report, 'post_switch_audit_rc') not in {"", "0"}:
              raise OfficeError('switch report postflight did not pass')
          if field(report, 'behavior_contract_rc') not in {"", "0"}:
              raise OfficeError('switch report behavior contract did not pass')
          old_write = field(report, 'old_storage_direct_write_by_mnx_switch')
          if old_write and old_write != 'no':
              raise OfficeError(f'switch report did not prove old-storage safety: {old_write}')
          return report
      
      
      #@MNX-PART id=99.08.mnx-office.function.resolve-runtime-source kind=function title="Python function resolve_runtime_source"
      def resolve_runtime_source(link: Path) -> tuple[Path, str]:
          resolved = safe_resolve(link)
          config = resolved / 'configuration.nix'
          if not config.exists():
              raise OfficeError(f'closure lacks configuration.nix: {resolved}')
          return resolved, sha256_file(config)
      
      
      #@MNX-PART id=99.08.mnx-office.function.baseline-identity kind=function title="Python function baseline_identity"
      def baseline_identity(path: Path) -> tuple[Path, str]:
          resolved = safe_resolve(path)
          manifest = resolved / 'manifest.txt'
          secure_regular_file(manifest, require_root=os.environ.get('MNX_OFFICE_SELF_TEST') != '1')
          return resolved, sha256_file(manifest)
      
      
      #@MNX-PART id=99.08.mnx-office.function.validate-record-against-runtime kind=function title="Python function validate_record_against_runtime"
      def validate_record_against_runtime(record: dict[str, Any], source: dict[str, Any], *, allow_incomplete_switch: bool = False, require_root: bool = True) -> dict[str, Any]:
          paths = runtime_paths()
          running, running_sha = resolve_runtime_source(paths['running'])
          default, default_sha = resolve_runtime_source(paths['default'])
          if running != default:
              raise OfficeError('running closure is not the boot-default closure')
          if running_sha != source['sha256'] or default_sha != source['sha256']:
              raise OfficeError('editable source does not match active and boot-default embedded sources')
          if record['source_sha256'] != source['sha256']:
              raise OfficeError('office record source hash differs from the editable source')
          if record['source_bytes'] != source['bytes']:
              raise OfficeError('office record source byte count differs')
          if record['document_schema'] != source['document_schema']:
              raise OfficeError('office record document schema differs')
          if record['accepted_stage'] != int(source['agenda']['candidate_stage']):
              raise OfficeError('office record accepted stage differs from source agenda')
          if record['agenda_sha256'] != source['agenda_sha256']:
              raise OfficeError('office record agenda hash differs')
          if Path(record['running_system']) != running or Path(record['default_system']) != default:
              raise OfficeError('office record closure identity differs from runtime')
          for key in ('explicit_chunk_count', 'assembly_chunk_count', 'definition_count', 'part_count', 'flow_count', 'law_count', 'generated_program_count'):
              if record[key] != source[key]:
                  raise OfficeError(f'office record count differs: {key}')
      
          test_path = Path(record['test_report'])
          switch_path = Path(record['switch_report'])
          if not path_is_public_evidence(test_path) or not path_is_public_evidence(switch_path):
              raise OfficeError('office record points outside approved evidence roots')
          test = validate_test_report(test_path, source['sha256'], require_root=require_root)
          switch = validate_switch_report(switch_path, source['sha256'], require_root=require_root, allow_incomplete=allow_incomplete_switch)
          if record['test_result'] != field(test, 'mnx_test_result', 'mnx_bootstrap_test_result'):
              raise OfficeError('office record test result differs from test report')
          if record['test_evidence_sha256'] != test_evidence_digest(test):
              raise OfficeError('office record test evidence digest differs')
          allow_legacy_switch_digest = (
              record['accepted_stage'] == 23
              and record['source_sha256'] == LEGACY_STAGE23_SOURCE_SHA256
          )
          switch_evidence_digest_mode = validate_switch_evidence_digest(
              record['switch_evidence_sha256'],
              switch,
              allow_legacy=allow_legacy_switch_digest,
          )
          reported_core_result = field(switch, 'core_acceptance_result', 'office_acceptance_intended_result')
          if record['switch_result'] != reported_core_result:
              raise OfficeError('office record core switch result differs from switch report')
          tested_system = field(test, 'temporary_running_system', 'current_running_system', 'tested_system')
          if tested_system and Path(tested_system) != Path(record['tested_system']):
              raise OfficeError('office record tested closure differs from test report')
          if Path(record['tested_system']) != running:
              raise OfficeError('office record tested closure is not the current closure')
      
          baseline, manifest_sha = baseline_identity(paths['baseline'])
          if Path(record['behavior_baseline']) != baseline:
              raise OfficeError('office record behavior baseline differs from pinned baseline')
          if record['behavior_manifest_sha256'] != manifest_sha:
              raise OfficeError('office record behavior manifest hash differs')
          if record['temporary_code_region_count'] != 0:
              raise OfficeError('office record contains temporary code')
      
          state_rc, state_text = run_text(['systemctl', 'is-system-running'])
          system_state = state_text or ('running' if state_rc == 0 else 'unknown')
          failed_rc, failed_text = run_text(['systemctl', '--failed', '--no-legend', '--plain'])
          failed_units = 0 if not failed_text else len(failed_text.splitlines())
          return {
              'running_system': str(running),
              'default_system': str(default),
              'system_state': system_state,
              'failed_unit_count': failed_units,
              'test_report': str(test_path),
              'switch_report': str(switch_path),
              'behavior_baseline': str(baseline),
              'behavior_manifest_sha256': manifest_sha,
              'switch_evidence_digest_mode': switch_evidence_digest_mode,
          }
      
      
      #@MNX-PART id=99.08.mnx-office.function.validate-predecessor-closure-identity kind=function title="Python function validate_predecessor_closure_identity"
      def validate_predecessor_closure_identity(record: dict[str, Any], default: Path) -> str:
          recorded = (
              Path(record['running_system']),
              Path(record['default_system']),
              Path(record['tested_system']),
          )
          if all(path == default for path in recorded):
              return 'exact'
          if (
              record['accepted_stage'] == 26
              and record['source_sha256'] == STAGE26_DRIFT_SOURCE_SHA256
              and all(path == STAGE26_ACCEPTED_SYSTEM for path in recorded)
              and default == STAGE26_UNATTENDED_DRIFT_SYSTEM
          ):
              return 'stage26-source-pinned-unattended-upgrade-transition'
          raise OfficeError(
              'office predecessor record closure identity differs from boot default: '
              f'recorded={recorded!r} current_default={default}'
          )


      #@MNX-PART id=99.08.mnx-office.function.validate-predecessor-record kind=function title="Python function validate_predecessor_record"
      def validate_predecessor_record(record: dict[str, Any], source: dict[str, Any], default: Path, *, require_root: bool = True) -> dict[str, Any]:
          if record['source_sha256'] != source['sha256']:
              raise OfficeError('office predecessor record source hash differs from boot-default source')
          if record['source_bytes'] != source['bytes'] or record['document_schema'] != source['document_schema']:
              raise OfficeError('office predecessor record source identity differs')
          if record['agenda_sha256'] != source['agenda_sha256']:
              raise OfficeError('office predecessor record agenda hash differs')
          closure_identity_mode = validate_predecessor_closure_identity(record, default)
          for key in ('explicit_chunk_count', 'assembly_chunk_count', 'definition_count', 'part_count', 'flow_count', 'law_count', 'generated_program_count'):
              if record[key] != source[key]:
                  raise OfficeError(f'office predecessor record count differs: {key}')
          predecessor_test = validate_test_report(Path(record['test_report']), source['sha256'], require_root=require_root)
          predecessor_switch = validate_switch_report(Path(record['switch_report']), source['sha256'], require_root=require_root)
          if record['test_evidence_sha256'] != test_evidence_digest(predecessor_test):
              raise OfficeError('office predecessor test evidence digest differs')
          allow_legacy_switch_digest = (
              record['accepted_stage'] == 23
              and record['source_sha256'] == LEGACY_STAGE23_SOURCE_SHA256
          )
          predecessor_switch_digest_mode = validate_switch_evidence_digest(
              record['switch_evidence_sha256'],
              predecessor_switch,
              allow_legacy=allow_legacy_switch_digest,
          )
          baseline, manifest_sha = baseline_identity(runtime_paths()['baseline'])
          if Path(record['behavior_baseline']) != baseline or record['behavior_manifest_sha256'] != manifest_sha:
              raise OfficeError('office predecessor record behavior baseline differs from pinned baseline')
          return {
              'default_system': str(default),
              'behavior_baseline': str(baseline),
              'switch_evidence_digest_mode': predecessor_switch_digest_mode,
              'closure_identity_mode': closure_identity_mode,
          }
      
      
      #@MNX-PART id=99.08.mnx-office.function.validate-commit-pending-agenda kind=function title="Python function validate_commit_pending_agenda"
      def validate_commit_pending_agenda(record: dict[str, Any], source: dict[str, Any]) -> None:
          agenda = source['agenda']
          if int(agenda['accepted_predecessor_stage']) != int(record['accepted_stage']):
              raise OfficeError('candidate accepted_predecessor_stage differs from the current office record')
          if agenda['accepted_predecessor_sha256'] != record['source_sha256']:
              raise OfficeError('candidate accepted_predecessor_sha256 differs from the current office record')
      
      
      #@MNX-PART id=99.08.mnx-office.function.validate-commit-pending-record kind=function title="Python function validate_commit_pending_record"
      def validate_commit_pending_record(record: dict[str, Any], source: dict[str, Any], *, require_root: bool = True) -> dict[str, Any]:
          paths = runtime_paths()
          running, running_sha = resolve_runtime_source(paths['running'])
          default, default_sha = resolve_runtime_source(paths['default'])
          if running != default:
              raise OfficeError('switch-commit-pending runtime is not the boot-default closure')
          if running_sha != source['sha256'] or default_sha != source['sha256']:
              raise OfficeError('switch-commit-pending candidate source differs from active/default closure source')
          validate_commit_pending_agenda(record, source)
          predecessor_default = safe_resolve(Path(record['default_system']))
          if predecessor_default == running:
              raise OfficeError('switch-commit-pending predecessor closure unexpectedly equals the candidate closure')
          predecessor_source = parse_source(predecessor_default / 'configuration.nix')
          predecessor = validate_predecessor_record(
              record,
              predecessor_source,
              predecessor_default,
              require_root=require_root,
          )
          return {
              'running_system': str(running),
              'default_system': str(default),
              'candidate_source_sha256': source['sha256'],
              'accepted_predecessor_system': str(predecessor_default),
              'behavior_baseline': predecessor['behavior_baseline'],
              'switch_evidence_digest_mode': predecessor['switch_evidence_digest_mode'],
              'predecessor_closure_identity_mode': predecessor['closure_identity_mode'],
          }
      
      
      #@MNX-PART id=99.08.mnx-office.function.ensure-state-dirs kind=function title="Python function ensure_state_dirs"
      def ensure_state_dirs(state_root: Path) -> tuple[Path, int, int]:
          records = state_root / 'records'
          state_root.mkdir(parents=True, exist_ok=True)
          records.mkdir(parents=True, exist_ok=True)
          os.chmod(state_root, 0o750)
          os.chmod(records, 0o750)
          uid = 0 if os.geteuid() == 0 else os.getuid()
          try:
              gid = grp.getgrnam('logbook').gr_gid if os.geteuid() == 0 else os.getgid()
          except KeyError:
              gid = os.getgid()
          if os.geteuid() == 0:
              os.chown(state_root, uid, gid)
              os.chown(records, uid, gid)
          return records, uid, gid
      
      
      #@MNX-PART id=99.08.mnx-office.function.atomic-write-record kind=function title="Python function atomic_write_record"
      def atomic_write_record(state_root: Path, record: dict[str, Any]) -> Path:
          records, uid, gid = ensure_state_dirs(state_root)
          stamp = dt.datetime.now().astimezone().strftime('%Y%m%dT%H%M%S%f%z')
          name = f'accepted-{stamp}-{record["source_sha256"][:12]}.json'
          destination = records / name
          if destination.exists():
              raise OfficeError(f'office record already exists: {destination}')
          fd, temporary_name = tempfile.mkstemp(prefix='.record.', suffix='.json', dir=records)
          temporary = Path(temporary_name)
          try:
              with os.fdopen(fd, 'wb') as handle:
                  handle.write(canonical_json(record))
                  handle.flush()
                  os.fsync(handle.fileno())
              os.chmod(temporary, 0o640)
              if os.geteuid() == 0:
                  os.chown(temporary, uid, gid)
              os.replace(temporary, destination)
              dir_fd = os.open(records, os.O_DIRECTORY)
              try:
                  os.fsync(dir_fd)
              finally:
                  os.close(dir_fd)
              current = state_root / 'current.json'
              link_temp = state_root / f'.current.{os.getpid()}'
              try:
                  link_temp.unlink(missing_ok=True)
                  os.symlink(f'records/{name}', link_temp)
                  os.replace(link_temp, current)
              finally:
                  link_temp.unlink(missing_ok=True)
              dir_fd = os.open(state_root, os.O_DIRECTORY)
              try:
                  os.fsync(dir_fd)
              finally:
                  os.close(dir_fd)
          finally:
              temporary.unlink(missing_ok=True)
          return destination
      
      
      #@MNX-PART id=99.08.mnx-office.function.build-record kind=function title="Python function build_record"
      def build_record(args: argparse.Namespace, source: dict[str, Any]) -> dict[str, Any]:
          paths = runtime_paths()
          running, running_sha = resolve_runtime_source(paths['running'])
          default, default_sha = resolve_runtime_source(paths['default'])
          if running != default:
              raise OfficeError('refusing office commit: running closure is not boot default')
          if running_sha != source['sha256'] or default_sha != source['sha256']:
              raise OfficeError('refusing office commit: source/active/default hashes disagree')
          test_path = safe_resolve(Path(args.test_report))
          switch_path = safe_resolve(Path(args.switch_report))
          require_root = os.environ.get('MNX_OFFICE_SELF_TEST') != '1'
          test = validate_test_report(test_path, source['sha256'], require_root=require_root)
          switch = validate_switch_report(switch_path, source['sha256'], require_root=require_root, allow_incomplete=True)
          if args.switch_result not in {'PASS', 'PASS_ALREADY_ACTIVE_DEFAULT'}:
              raise OfficeError(f'invalid switch result requested for office commit: {args.switch_result!r}')
          if field(switch, 'office_acceptance_intended_result') != args.switch_result:
              raise OfficeError('switch transaction intended result differs from office commit request')
          if Path(field(switch, 'office_acceptance_running_system')) != running:
              raise OfficeError('switch transaction acceptance running closure differs from runtime')
          if Path(field(switch, 'office_acceptance_default_system')) != default:
              raise OfficeError('switch transaction acceptance boot-default closure differs from runtime')
          test_result = field(test, 'mnx_test_result', 'mnx_bootstrap_test_result')
          tested_system = field(test, 'temporary_running_system', 'current_running_system', 'tested_system')
          if not tested_system:
              tested_system = str(running)
          if Path(tested_system) != running:
              raise OfficeError('refusing office commit: tested closure is not current')
          baseline, baseline_sha = baseline_identity(paths['baseline'])
          record = {
              'record_schema': RECORD_VERSION,
              'accepted_at': dt.datetime.now().astimezone().isoformat(timespec='seconds'),
              'accepted_stage': int(source['agenda']['candidate_stage']),
              'source_sha256': source['sha256'],
              'source_bytes': source['bytes'],
              'document_schema': source['document_schema'],
              'running_system': str(running),
              'default_system': str(default),
              'tested_system': str(running),
              'test_report': str(test_path),
              'test_result': test_result,
              'test_evidence_sha256': test_evidence_digest(test),
              'switch_report': str(switch_path),
              'switch_result': args.switch_result,
              'switch_evidence_sha256': switch_evidence_digest(switch),
              'behavior_baseline': str(baseline),
              'behavior_manifest_sha256': baseline_sha,
              'temporary_code_region_count': 0,
              'agenda_sha256': source['agenda_sha256'],
              'explicit_chunk_count': source['explicit_chunk_count'],
              'assembly_chunk_count': source['assembly_chunk_count'],
              'definition_count': source['definition_count'],
              'part_count': source['part_count'],
              'flow_count': source['flow_count'],
              'law_count': source['law_count'],
              'generated_program_count': source['generated_program_count'],
          }
          unknown = set(record) - ALLOWED_RECORD_KEYS
          if unknown:
              raise OfficeError(f'internal record has unknown fields: {sorted(unknown)}')
          return record
      
      
      #@MNX-PART id=99.08.mnx-office.function.health-read-file kind=function title="Python function health_read_file"
      def health_read_file(path: Path, limit: int, *, root: Path = Path('/'), uid: int = 0, after_read: Any = None, allow_empty: bool = False) -> tuple[str, str]:
          """Read only a bounded, private-to-root publication. Never follow a symlink."""
          fd = -1
          try:
              path.relative_to(root)
              parent = path.parent
              while True:
                  info = parent.lstat()
                  if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid or info.st_mode & 0o022:
                      return 'untrusted-parent', '''
                  if parent == root:
                      break
                  parent = parent.parent
              fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK)
              before = os.fstat(fd)
              if not stat.S_ISREG(before.st_mode) or before.st_uid != uid or before.st_mode & 0o022 or before.st_nlink != 1:
                  return 'untrusted-file', '''
              if not 0 <= before.st_size <= limit or (before.st_size == 0 and not allow_empty):
                  return 'size-refused', '''
              data = bytearray()
              while len(data) <= limit:
                  chunk = os.read(fd, min(16384, limit + 1 - len(data)))
                  if not chunk:
                      break
                  data.extend(chunk)
              if after_read is not None:
                  after_read()
              after = os.fstat(fd)
              current = path.lstat()
              fields = ('st_dev', 'st_ino', 'st_mode', 'st_uid', 'st_gid', 'st_nlink', 'st_size', 'st_mtime_ns', 'st_ctime_ns')
              if any(getattr(before, key) != getattr(after, key) or getattr(after, key) != getattr(current, key) for key in fields):
                  return 'changed-during-read', '''
              if len(data) != before.st_size or len(data) > limit:
                  return 'changed-during-read', '''
              return 'read', data.decode('utf-8')
          except FileNotFoundError:
              return 'missing', '''
          except (OSError, ValueError, UnicodeError):
              return 'unreadable-or-unsafe', '''
          finally:
              if fd >= 0:
                  os.close(fd)


      #@MNX-PART id=99.08.mnx-office.function.health-parse-metrics kind=function title="Python function health_parse_metrics"
      def health_parse_metrics(text: str) -> dict[str, Any]:
          scalar_names = {
              'monsternix_storage_health_observation_timestamp_seconds': 'observation_epoch',
              'monsternix_storage_health_problem': 'problem',
              'monsternix_storage_health_warning': 'warning',
              'monsternix_storage_health_advisory': 'advisory',
              'monsternix_storage_health_history_problem': 'historical_storage_events',
              'monsternix_memory_pressure_seen_last_24h': 'memory_pressure_events',
              'monsternix_btrfs_baseline_problem': 'btrfs_baseline_problem',
          }
          result: dict[str, Any] = {key: None for key in scalar_names.values()}
          result.update(nvme={device: {'temperature_celsius': None, 'critical_warning': None} for device in ('nvme0', 'nvme1')}, report_hint=None, parse_state='valid')
          seen: set[str] = set()
          for line in text.splitlines():
              if line.startswith('# MNX_STORAGE_REPORT='):
                  name = line.partition('=')[2]
                  if result['report_hint'] is not None or not re.fullmatch(r'storage-health-[0-9]{8}T[0-9]{6}[.]txt', name):
                      result['parse_state'] = 'invalid-report-hint'
                  else:
                      result['report_hint'] = name
                  continue
              fields = line.split()
              if not fields or line.startswith('#'):
                  continue
              name = fields[0]
              device_match = re.fullmatch(r'monsternix_nvme_(temperature_celsius|critical_warning)\{device="(nvme[0-9]{1,3})"\}', name)
              if name not in scalar_names and device_match is None:
                  continue
              if name in seen or len(fields) != 2 or not re.fullmatch(r'-?[0-9]{1,15}(?:[.]0+)?', fields[1]):
                  result['parse_state'] = 'invalid-or-duplicate-metric'
                  continue
              seen.add(name)
              number = int(fields[1].split('.')[0])
              if name in scalar_names:
                  key = scalar_names[name]
                  if (key == 'observation_epoch' and number <= 0) or (key != 'observation_epoch' and number not in (0, 1)):
                      result['parse_state'] = 'invalid-metric-range'
                  else:
                      result[key] = number
              elif device_match is not None:
                  key, device = device_match.groups()
                  if len(result['nvme']) >= 16 and device not in result['nvme']:
                      result['parse_state'] = 'too-many-devices'
                  elif (key == 'temperature_celsius' and not -50 <= number <= 200) or (key == 'critical_warning' and not 0 <= number <= 255):
                      result['parse_state'] = 'invalid-device-range'
                  else:
                      result['nvme'].setdefault(device, {})[key] = number
          if result['parse_state'] == 'valid' and any(result[key] is None for key in scalar_names.values()):
              result['parse_state'] = 'incomplete-metrics'
          return result


      #@MNX-PART id=99.08.mnx-office.function.health-report-causes kind=function title="Python function health_report_causes"
      def health_report_causes(text: str) -> dict[str, Any]:
          """Project known producer messages to codes and numbers, never emit raw report text."""
          result: list[dict[str, Any]] = []
          unmapped = 0
          clipped = 0
          exact = {
              'backup-NVMe 128 GiB Btrfs overflow swap is not active': 'overflow-swap-inactive',
              'Btrfs device-counter baseline comparison failed': 'btrfs-baseline-failed',
              'one or more storage-related systemd units are failed': 'storage-unit-failed',
              'one or more essential backup flows are critically stale': 'backup-critically-stale',
              'one or more essential backup flows are stale and queued for catch-up': 'backup-stale',
          }
          for line in text.splitlines():
              match = re.fullmatch(r'(WARN|CRIT): (.+)', line)
              if match is None:
                  continue
              severity, message = match.groups()
              entry: dict[str, Any] = {'severity': severity.lower()}
              temperature = re.fullmatch(r'(nvme[0-9]{1,3}) temperature is ([0-9]{1,3})C', message)
              delta = re.fullmatch(r'(nvme[0-9]{1,3}) temperature changed from ([0-9]{1,3})C to ([0-9]{1,3})C since the last health run', message)
              critical = re.fullmatch(r'(nvme[0-9]{1,3}) SMART critical_warning is (0x[0-9a-fA-F]{1,8}|[0-9]{1,8})', message)
              unreadable = re.fullmatch(r'unable to read (nvme[0-9]{1,3}) SMART critical_warning', message)
              if message in exact:
                  entry['code'] = exact[message]
              elif temperature:
                  entry.update(code='nvme-temperature-high', device=temperature[1], celsius=int(temperature[2]))
              elif delta:
                  old, new = int(delta[2]), int(delta[3])
                  entry.update(code='nvme-temperature-change', device=delta[1], previous_celsius=old, celsius=new,
                               delta_celsius=new - old, direction='cooling' if new < old else 'warming')
              elif critical:
                  entry.update(code='nvme-smart-critical-warning', device=critical[1], bits=int(critical[2], 16 if critical[2].startswith('0x') else 10))
              elif unreadable:
                  entry.update(code='nvme-smart-unreadable', device=unreadable[1])
              else:
                  unmapped += 1
                  continue
              if len(result) < 16:
                  result.append(entry)
              else:
                  clipped += 1
          return {'causes': result, 'unmapped_cause_count': unmapped, 'clipped_cause_count': clipped}


      #@MNX-PART id=99.08.mnx-office.function.health-read-report kind=function title="Python function health_read_report"
      def health_read_report(root: Path, uid: int, epoch: int | None, hint: str | None) -> dict[str, Any]:
          directory = root / 'var/lib/logbook/daily'
          result: dict[str, Any] = {'state': 'no-matching-report', 'path': None, 'epoch_matches_metric': False,
                                    'causes': [], 'unmapped_cause_count': 0, 'clipped_cause_count': 0}
          if epoch is None:
              return result
          names = []
          if hint is not None:
              names = [hint]
          else:
              try:
                  info = directory.lstat()
                  if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid or info.st_mode & 0o022:
                      result['state'] = 'untrusted-directory'
                      return result
                  with os.scandir(directory) as entries:
                      for index, entry in enumerate(entries):
                          if index >= 8192:
                              result['state'] = 'directory-budget-exceeded'
                              return result
                          if re.fullmatch(r'storage-health-[0-9]{8}T[0-9]{6}[.]txt', entry.name):
                              names.append(entry.name)
                  names = sorted(names, reverse=True)[:8]
              except OSError:
                  result['state'] = 'directory-unavailable'
                  return result
          for name in names:
              path = directory / name
              state, text = health_read_file(path, 1_048_576, root=root, uid=uid)
              if state != 'read':
                  if hint is not None:
                      result['state'] = state
                  continue
              found = re.findall(r'(?m)^observation_epoch=([0-9]{1,15})$', text)
              if len(found) != 1 or int(found[0]) != epoch:
                  continue
              result.update(state='matched', path=str(Path('/') / path.relative_to(root)), epoch_matches_metric=True)
              result.update(health_report_causes(text))
              break
          return result


      #@MNX-PART id=99.08.mnx-office.function.restic-nightly-policy kind=function title="Python function restic_nightly_policy"
      def restic_nightly_policy(now: int, source_epoch: int | None) -> dict[str, Any]:
          """A source-age policy, not repository verification or a remote health claim."""
          from zoneinfo import ZoneInfo
          policy = M21_NIGHTLY_POLICY
          with open('${pkgs.tzdata}/share/zoneinfo/' + policy['timezone'], 'rb') as timezone_file:
              zone = ZoneInfo.from_file(timezone_file, key=policy['timezone'])
          slot_time = dt.time.fromisoformat(policy['slot'])
          retry_time = dt.time.fromisoformat(policy['retryFrom'])
          deadline_time = dt.time.fromisoformat(policy['deadline'])
          local = dt.datetime.fromtimestamp(now, zone)
          day = local.date()
          slot = dt.datetime.combine(day, slot_time, zone)
          if local < slot:
              day -= dt.timedelta(days=1)
              slot = dt.datetime.combine(day, slot_time, zone)
          retry = dt.datetime.combine(day, retry_time, zone)
          deadline = dt.datetime.combine(day, deadline_time, zone)
          source_valid = type(source_epoch) is int and 0 < source_epoch <= now
          covered = source_valid and source_epoch >= int(slot.timestamp())
          due = not covered and now >= int(retry.timestamp())
          late = not covered and now >= int(deadline.timestamp())
          return {'timezone': policy['timezone'], 'slot_epoch': int(slot.timestamp()),
                  'slot_local': slot.isoformat(), 'retry_not_before_epoch': int(retry.timestamp()),
                  'deadline_epoch': int(deadline.timestamp()), 'deadline_local': deadline.isoformat(),
                  'covered': covered, 'retry_due': due, 'deadline_missed': late,
                  'state': ('covered-by-success-receipt' if covered else
                            'deadline-missed' if late else 'retry-due' if due else 'nightly-window-pending')}


      #@MNX-PART id=99.08.mnx-office.function.health-restic-evidence kind=function title="Python function health_restic_evidence"
      def health_restic_evidence(root: Path, uid: int, now: int) -> dict[str, Any]:
          base = root / 'var/lib/monsternix/job-state/authoritative'
          read_state, text = health_read_file(base / 'm16-restic-m21.last-success', 4096, root=root, uid=uid)
          epoch_fields = re.findall(r'(?m)^epoch=([0-9]{1,15})$', text)
          result_fields = re.findall(r'(?m)^result=(.*)$', text)
          completion = int(epoch_fields[0]) if len(epoch_fields) == 1 else None
          if read_state == 'read' and (completion is None or result_fields != ['pull-complete']):
              read_state = 'invalid-success-receipt'
          if completion is not None and not 0 < completion <= now:
              read_state = 'invalid-success-timestamp'
          # This established root success receipt names its own backup evidence bundle.
          # The bundle's creation timestamp precedes source snapshot creation: a conservative
          # lower bound, NOT an independently measured snapshot time. Do not use completion
          # time as data age: a long-running old backup must not satisfy a newer nightly slot.
          stamps = re.findall(r'(?m)^detail=[^\n]*\bevidence=/var/lib/logbook/backups/m16-restic-backup-([0-9]{8}T[0-9]{6}Z)-[1-9][0-9]*(?: |$)', text)
          source_epoch = None
          if read_state == 'read' and len(stamps) == 1:
              try:
                  source_epoch = int(dt.datetime.strptime(stamps[0], '%Y%m%dT%H%M%SZ').replace(tzinfo=dt.timezone.utc).timestamp())
              except ValueError:
                  pass
              if source_epoch is None or completion is None or not 0 < source_epoch <= completion:
                  read_state = 'invalid-source-time-bound'
                  source_epoch = None
          if read_state != 'read':
              source_epoch = None
          automatic_state, automatic = health_read_file(root / 'var/lib/monsternix/restic-qualification/automatic-enabled', 4096, root=root, uid=uid)
          enabled_state, enabled = health_read_file(root / 'etc/nixos/secrets/m16-restic/enabled', 1, root=root, uid=uid, allow_empty=True)
          # These are enrollment markers, never repository credentials. Existing service
          # enrollment/credential checks remain authoritative before any data operation.
          qualified = (automatic_state == 'read' and
                       automatic.splitlines().count('schema=mnx.restic.automatic-enablement.v1') == 1 and
                       automatic.splitlines().count('scheduling_receipt=present') == 1)
          enrolled = enabled_state == 'read' and enabled == '''
          current_state, current_text = health_read_file(base / 'm16-restic-m21.current.json', 65536, root=root, uid=uid)
          attempt: dict[str, Any] = {'read_state': current_state}
          if current_state == 'read':
              try:
                  pairs = json.loads(current_text, object_pairs_hook=list)
                  current = dict(pairs)
                  if len(current) != len(pairs) or current.get('schema') != 'mnx.restic.backup.state.v1':
                      raise ValueError('invalid attempt')
                  for key in ('controller_status', 'product_status', 'phase', 'reason', 'source_receipt_result', 'rebuild_bundle_status', 'rebuild_bundle_sha256', 'snapshot_id', 'snapshot_metadata_status'):
                      value = current.get(key)
                      attempt[key] = value if isinstance(value, str) and re.fullmatch(r'[a-z0-9-]{1,96}', value) else None
                  for key in ('command_rc', 'duration_seconds', 'cleanup_failure_count', 'rebuild_bundle_bytes', 'snapshot_archive_bytes'):
                      value = current.get(key)
                      attempt[key] = value if type(value) is int and 0 <= value <= 10**12 else None
                  snapshot_time = current.get('snapshot_time')
                  attempt['snapshot_time'] = snapshot_time if isinstance(snapshot_time, str) and re.fullmatch(r'[0-9T:+.Z-]{10,40}', snapshot_time) else None
                  recorded_at = current.get('recorded_at')
                  attempt['recorded_at'] = recorded_at if isinstance(recorded_at, str) and re.fullmatch(r'[0-9T:+.Z-]{10,40}', recorded_at) else None
              except (ValueError, TypeError):
                  attempt = {'read_state': 'malformed-attempt-record'}
          nightly = restic_nightly_policy(now, source_epoch)
          return {'schema': 'mnx.m21.restic-nightly.v1', 'primary_backend': M21_NIGHTLY_POLICY['backend'],
                  'policy': dict(M21_NIGHTLY_POLICY), 'policy_origin': 'nix-evaluated-embedded-no-runtime-policy-file',
                  'scope': 'existing-m21-home-export-other-datasets-not-qualified-here',
                  'enrolled': enrolled, 'automatic_qualified': qualified,
                  'eligible': enrolled and qualified, 'nightly': nightly,
                  'source_epoch': source_epoch, 'source_time_basis': 'success-receipt-backup-attempt-start-lower-bound' if source_epoch is not None else 'unknown',
                  'completion_epoch': completion, 'success_receipt_state': read_state,
                  'current_attempt': attempt, 'legacy_btrfs_helper_is_restic_prerequisite': False,
                  'repository_data_verified_here': False, 'restore_test_performed_here': False,
                  'network_used': False, 'secrets_read': False}


      #@MNX-PART id=99.08.mnx-office.function.restic-nightly-self-test kind=function title="Python function restic_nightly_self_test"
