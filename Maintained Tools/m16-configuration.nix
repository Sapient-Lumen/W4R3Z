      #@MNX-PART id=99.55.mnx-atlas.function.parse-chunk-marker kind=function title="Python function parse_chunk_marker"
      def parse_chunk_marker(comment: Comment) -> ChunkMarker:
          import shlex
      
          if comment.column != 1:
              raise AtlasError(f"MNX chunk marker is not column zero at line {comment.line}")
          try:
              fields = shlex.split(comment.raw[len(CHUNK_PREFIX):], posix=True)
          except ValueError as exc:
              raise AtlasError(f"invalid MNX chunk marker at line {comment.line}: {exc}") from exc
          if len(fields) != 3:
              raise AtlasError(f"MNX chunk marker at line {comment.line} must have exactly id, slug, and title")
          parsed: dict[str, str] = {}
          for token in fields:
              if "=" not in token:
                  raise AtlasError(f"invalid MNX chunk marker token at line {comment.line}: {token!r}")
              key, value = token.split("=", 1)
              if key in parsed:
                  raise AtlasError(f"duplicate MNX chunk field {key!r} at line {comment.line}")
              parsed[key] = value
          if list(parsed) != ["id", "slug", "title"]:
              raise AtlasError(f"MNX chunk fields must be ordered id, slug, title at line {comment.line}")
          chunk_id = parsed["id"]
          slug = parsed["slug"]
          title = parsed["title"]
          if not CHUNK_ID_RE.fullmatch(chunk_id):
              raise AtlasError(f"invalid MNX chunk id {chunk_id!r} at line {comment.line}")
          if not SLUG_RE.fullmatch(slug):
              raise AtlasError(f"invalid MNX chunk slug {slug!r} at line {comment.line}")
          if not title:
              raise AtlasError(f"empty MNX chunk title at line {comment.line}")
          return ChunkMarker(chunk_id, slug, title, comment.line, comment.start, comment.end)
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.parse-definition-marker kind=function title="Python function parse_definition_marker"
      def parse_definition_marker(comment: Comment) -> DefinitionMarker:
          if comment.column != 1:
              raise AtlasError(f"MNX definition marker is not column zero at line {comment.line}")
          pattern = re.compile(
              r'^#@MNX-DEF path=(?P<path>.+) section=(?P<section>[A-Za-z0-9][A-Za-z0-9._-]*) '
              r'role=(?P<role>[a-z][a-z0-9-]*) ordinal=(?P<ordinal>[0-9]{3})$'
          )
          match = pattern.fullmatch(comment.raw)
          if not match:
              raise AtlasError(
                  f"definition marker at line {comment.line} must be exactly "
                  "#@MNX-DEF path=... section=... role=... ordinal=NNN"
              )
          marker_path = match.group("path")
          # Reuse the lexer to validate the path grammar and preserve quoted segments.
          path_lexer = Lexer(marker_path)
          path_tokens, path_comments = path_lexer.run()
          if path_comments:
              raise AtlasError(f"definition marker path contains a comment at line {comment.line}")
          canonical = canonical_attr_path(path_tokens, 0, len(path_tokens))
          if canonical != marker_path:
              raise AtlasError(f"definition marker path is not canonical at line {comment.line}: {marker_path!r}")
          section = match.group("section")
          role = match.group("role")
          if not CHUNK_ID_RE.fullmatch(section):
              raise AtlasError(f"invalid definition section {section!r} at line {comment.line}")
          if not ROLE_RE.fullmatch(role):
              raise AtlasError(f"invalid definition role {role!r} at line {comment.line}")
          if role not in ALLOWED_ROLES:
              raise AtlasError(f"unknown definition role {role!r} at line {comment.line}")
          return DefinitionMarker(
              path=marker_path,
              section=section,
              role=role,
              ordinal=int(match.group("ordinal")),
              line=comment.line,
              start=comment.start,
              end=comment.end,
          )
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.line-end kind=function title="Python function line_end"
      def line_end(text: str, index: int) -> int:
          newline = text.find("\n", index)
          return len(text) if newline < 0 else newline + 1
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.sha256-text kind=function title="Python function sha256_text"
      def sha256_text(value: str) -> str:
          return hashlib.sha256(value.encode("utf-8")).hexdigest()
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.build-atlas kind=function title="Python function build_atlas"
      def build_atlas(path: Path) -> Atlas:
          try:
              data = path.read_bytes()
          except OSError as exc:
              raise AtlasError(f"cannot read configuration: {path}: {exc}") from exc
          try:
              text = data.decode("utf-8")
          except UnicodeDecodeError as exc:
              raise AtlasError(f"configuration is not valid UTF-8: {exc}") from exc
          lexer = Lexer(text)
          tokens, comments = lexer.run()
          matching = matching_delimiters(tokens)
          root_open, root_close = find_module_body(tokens, matching)
          assignments = parse_assignments(tokens, matching, root_open, root_close)
      
          marker_candidate_re = re.compile(r"^[ \t]*#@MNX-(?:CHUNK|DEF)\b")
          raw_marker_lines: set[int] = set()
          for line_number, line in enumerate(text.splitlines(), start=1):
              if not marker_candidate_re.match(line):
                  continue
              raw_marker_lines.add(line_number)
              if line[:1].isspace():
                  raise AtlasError(f"MNX marker-like line is not column zero at line {line_number}")
      
          lexical_marker_lines = {
              comment.line
              for comment in comments
              if comment.outer and comment.column == 1
              and (comment.raw.startswith("#@MNX-CHUNK") or comment.raw.startswith("#@MNX-DEF"))
          }
          hidden = sorted(raw_marker_lines - lexical_marker_lines)
          if hidden:
              raise AtlasError(
                  "column-zero MNX marker-like text occurs inside a string, block comment, or interpolation at lines "
                  + ", ".join(map(str, hidden[:20]))
              )
      
          chunk_comments = [
              comment for comment in comments
              if comment.outer and comment.raw.startswith("#@MNX-CHUNK")
          ]
          def_comments = [
              comment for comment in comments
              if comment.outer and comment.raw.startswith("#@MNX-DEF")
          ]
          chunks = [parse_chunk_marker(comment) for comment in chunk_comments]
          markers = [parse_definition_marker(comment) for comment in def_comments]
          if not chunks:
              raise AtlasError("no MNX chunk markers found")
          if not markers:
              raise AtlasError("no MNX definition markers found")
      
          chunk_ids: set[str] = set()
          chunk_slugs: set[str] = set()
          for chunk in chunks:
              if chunk.chunk_id in chunk_ids:
                  raise AtlasError(f"duplicate chunk id {chunk.chunk_id!r} at line {chunk.line}")
              if chunk.slug in chunk_slugs:
                  raise AtlasError(f"duplicate chunk slug {chunk.slug!r} at line {chunk.line}")
              chunk_ids.add(chunk.chunk_id)
              chunk_slugs.add(chunk.slug)
      
          marker_paths: set[str] = set()
          for marker in markers:
              if marker.path in marker_paths:
                  raise AtlasError(f"duplicate definition path {marker.path!r} at line {marker.line}")
              marker_paths.add(marker.path)
      
          assignment_by_line: dict[int, Assignment] = {}
          for assignment in assignments:
              if assignment.start_line in assignment_by_line:
                  raise AtlasError(f"multiple top-level assignments begin on line {assignment.start_line}")
              assignment_by_line[assignment.start_line] = assignment
      
          marker_by_assignment_line: dict[int, DefinitionMarker] = {}
          for marker in markers:
              assignment_line = marker.line + 1
              if assignment_line in marker_by_assignment_line:
                  raise AtlasError(f"multiple definition markers target line {assignment_line}")
              marker_by_assignment_line[assignment_line] = marker
      
          missing_markers = [assignment for assignment in assignments if assignment.start_line not in marker_by_assignment_line]
          if missing_markers:
              first = missing_markers[0]
              raise AtlasError(f"top-level assignment {first.path!r} at line {first.start_line} lacks an immediately preceding DEF marker")
          dangling_markers = [marker for marker in markers if marker.line + 1 not in assignment_by_line]
          if dangling_markers:
              first = dangling_markers[0]
              raise AtlasError(f"DEF marker at line {first.line} does not immediately precede a top-level assignment")
          if len(assignments) != len(markers):
              raise AtlasError(f"definition/assignment count mismatch: markers={len(markers)} assignments={len(assignments)}")
      
          expected_ordinals = list(range(1, len(markers) + 1))
          actual_ordinals = [marker.ordinal for marker in markers]
          if actual_ordinals != expected_ordinals:
              for position, (actual, expected) in enumerate(zip(actual_ordinals, expected_ordinals), start=1):
                  if actual != expected:
                      marker = markers[position - 1]
                      raise AtlasError(
                          f"definition ordinal sequence breaks at line {marker.line}: found {actual:03d}, expected {expected:03d}"
                      )
              raise AtlasError("definition ordinal sequence is not contiguous")
      
          chunk_starts = [chunk.start for chunk in chunks]
          definitions: list[Definition] = []
          for assignment in assignments:
              marker = marker_by_assignment_line[assignment.start_line]
              if marker.path != assignment.path:
                  raise AtlasError(
                      f"stale DEF path at line {marker.line}: marker={marker.path!r} assignment={assignment.path!r}"
                  )
              chunk_index = bisect.bisect_right(chunk_starts, marker.start) - 1
              if chunk_index < 0:
                  raise AtlasError(f"DEF marker at line {marker.line} appears before the first chunk marker")
              chunk = chunks[chunk_index]
              if marker.section != chunk.chunk_id:
                  raise AtlasError(
                      f"DEF section mismatch at line {marker.line}: marker={marker.section!r} containing_chunk={chunk.chunk_id!r}"
                  )
              intruding_chunks = [
                  candidate for candidate in chunks
                  if assignment.start < candidate.start < assignment.end
              ]
              if intruding_chunks:
                  candidate = intruding_chunks[0]
                  raise AtlasError(
                      f"chunk marker {candidate.chunk_id!r} at line {candidate.line} splits definition {assignment.path!r}"
                  )
              span_start = marker.start
              span_end = line_end(text, assignment.end)
              assignment_text = text[assignment.start:assignment.end]
              span_text = text[span_start:span_end]
              definitions.append(
                  Definition(
                      marker=marker,
                      assignment=assignment,
                      chunk=chunk,
                      span_start=span_start,
                      span_end=span_end,
                      assignment_sha256=sha256_text(assignment_text),
                      span_sha256=sha256_text(span_text),
                  )
              )
      
          for marker in markers:
              if any(definition.assignment.start < marker.start < definition.assignment.end for definition in definitions):
                  raise AtlasError(f"DEF marker at line {marker.line} occurs inside another top-level definition")
      
          return Atlas(
              source=path.resolve(),
              text=text,
              chunks=tuple(chunks),
              definitions=tuple(definitions),
              source_sha256=hashlib.sha256(data).hexdigest(),
          )
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.definition-manifest kind=function title="Python function definition_manifest"
      def definition_manifest(atlas: Atlas) -> dict[str, object]:
          return {
              "mnx_definition_atlas_version": 1,
              "source": str(atlas.source),
              "source_sha256": atlas.source_sha256,
              "chunk_count": len(atlas.chunks),
              "definition_count": len(atlas.definitions),
              "definitions": [
                  {
                      "ordinal": definition.marker.ordinal,
                      "path": definition.marker.path,
                      "section": definition.marker.section,
                      "role": definition.marker.role,
                      "marker_line": definition.marker.line,
                      "start_line": definition.assignment.start_line,
                      "end_line": definition.assignment.end_line,
                      "assignment_sha256": definition.assignment_sha256,
                      "anchored_span_sha256": definition.span_sha256,
                  }
                  for definition in atlas.definitions
              ],
          }
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.resolve-definition kind=function title="Python function resolve_definition"
      def resolve_definition(atlas: Atlas, query: str) -> Definition:
          exact = [
              definition
              for definition in atlas.definitions
              if query in {definition.marker.path, f"{definition.marker.ordinal:03d}"}
          ]
          if len(exact) == 1:
              return exact[0]
          partial = [definition for definition in atlas.definitions if definition.marker.path.startswith(query)]
          if len(partial) == 1:
              return partial[0]
          if not partial:
              raise AtlasError(f"no definition matches {query!r}")
          raise AtlasError(
              f"ambiguous definition query {query!r}: "
              + ", ".join(definition.marker.path for definition in partial[:12])
          )
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.definition-valid-fixture kind=function title="Python function definition_valid_fixture"
      def definition_valid_fixture() -> str:
          template = """#!/usr/bin/env -S bash -c 'exit 0'
      __CHUNK__ id=00.00 slug=preamble title=\"Preamble\"
      # harmless office text
      __CHUNK__ id=10.00 slug=body title=\"Body\"
      { config, pkgs, lib, ... }:
      {
      __DEF__ path=imports section=10.00 role=policy ordinal=001
        imports = [ ];
      __DEF__ path=alpha.\"quoted.segment\" section=10.00 role=generated-config ordinal=002
        alpha.\"quoted.segment\" = with pkgs; [
          \"fake __DEF__ path=nope section=nope role=policy ordinal=1010\"
          __S2__
            braces { [ ( ) ] }
            escaped interpolation: __S2____DOLLAR__not_nix}
            live interpolation: __DOLLAR__\"{\" + \"}\"}
          __S2__
        ];
      __CHUNK__ id=20.00 slug=more title=\"More\"
      __DEF__ path=beta section=20.00 role=service ordinal=003
        beta = assert true; {
          nested = { value = \"x\"; };
          script = __S2__echo \"}\"; # not a comment to Nix__S2__;
        };
      __DEF__ path=gamma section=20.00 role=timer ordinal=004
        gamma = value: if value then (with lib; value) else value;
      }
      __CHUNK__ id=99.99 slug=end title=\"End\"
      # MNX-END
      """
          return (
              template.replace("__S2__", S2)
              .replace("__DOLLAR__", DOLLAR_OPEN)
              .replace("__CHUNK__", CHUNK_PREFIX.rstrip())
              .replace("__DEF__", DEF_PREFIX.rstrip())
          )
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.definition-expect-failure kind=function title="Python function definition_expect_failure"
      def definition_expect_failure(label: str, source: str, needle: str | None = None) -> None:
          with tempfile.TemporaryDirectory(prefix="mnx-atlas-self-test-") as temporary:
              path = Path(temporary) / "configuration.nix"
              path.write_text(source, encoding="utf-8")
              try:
                  build_atlas(path)
              except AtlasError as exc:
                  if needle is not None and needle not in str(exc):
                      raise AtlasError(f"self-test {label!r} failed with wrong error: {exc}") from exc
                  return
          raise AtlasError(f"self-test expected rejection: {label}")
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.definition-core-self-test kind=function title="Python function definition_core_self_test"
      def definition_core_self_test() -> int:
          fixture = definition_valid_fixture()
          with tempfile.TemporaryDirectory(prefix="mnx-atlas-self-test-") as temporary:
              path = Path(temporary) / "configuration.nix"
              path.write_text(fixture, encoding="utf-8")
              first = build_atlas(path)
              second = build_atlas(path)
              if definition_manifest(first) != definition_manifest(second):
                  raise AtlasError("self-test manifest is not deterministic")
              if [definition.marker.path for definition in first.definitions] != [
                  "imports", 'alpha."quoted.segment"', "beta", "gamma"
              ]:
                  raise AtlasError("self-test parsed definition paths incorrectly")
              shown = first.text[first.definitions[1].span_start:first.definitions[1].span_end]
              if not shown.startswith('#@MNX-DEF path=alpha."quoted.segment"') or not shown.rstrip().endswith("];" ):
                  raise AtlasError("self-test exact definition span is wrong")
      
          mutations: list[tuple[str, str, str | None]] = [
              ("missing marker", fixture.replace("#@MNX-DEF path=beta section=20.00 role=service ordinal=003\n", "", 1), "lacks an immediately preceding"),
              ("stale path", fixture.replace("path=beta section=20.00", "path=delta section=20.00", 1), "stale DEF path"),
              ("quoted path collapse", fixture.replace('path=alpha."quoted.segment"', "path=alpha.quoted.segment", 1), "stale DEF path"),
              ("wrong section", fixture.replace("path=beta section=20.00", "path=beta section=10.00", 1), "section mismatch"),
              ("ordinal gap", fixture.replace("ordinal=003", "ordinal=004", 1), "ordinal sequence"),
              ("blank after marker", fixture.replace("ordinal=003\n  beta", "ordinal=003\n\n  beta", 1), None),
              ("indented marker", fixture.replace("#@MNX-DEF path=beta", "  #@MNX-DEF path=beta", 1), None),
              ("unknown role", fixture.replace("role=service ordinal=003", "role=serivce ordinal=003", 1), "unknown definition role"),
              ("extra field", fixture.replace("role=service ordinal=003", "role=service extra=x ordinal=003", 1), "must be exactly"),
              ("chunk splits definition", fixture.replace("    nested =", "#@MNX-CHUNK id=20.50 slug=intrude title=\"Intrude\"\n    nested =", 1), "splits definition"),
              ("raw marker in string", fixture.replace("      braces", "#@MNX-DEF path=fake section=20.00 role=policy ordinal=1010\n      braces", 1), "inside a string"),
              ("unterminated string", fixture.replace('"fake #@MNX-DEF path=nope section=nope role=policy ordinal=1010"', '"fake', 1), "unterminated"),
              ("missing semicolon", fixture.replace("  gamma = value: if value then (with lib; value) else value;", "  gamma = value: if value then (with lib; value) else value", 1), "no terminating semicolon"),
              ("active code after body", fixture.replace("}\n#@MNX-CHUNK id=99.99", "}\ntrue\n#@MNX-CHUNK id=99.99", 1), "active Nix tokens follow"),
              ("duplicate chunk id", fixture.replace("id=20.00 slug=more", "id=10.00 slug=more", 1), "duplicate chunk id"),
              ("dynamic marker path", fixture.replace("path=beta section=20.00", 'path=beta."' + DOLLAR_OPEN + 'x}" section=20.00', 1), "unsupported attribute-path"),
              ("top-level inherit", fixture.replace("#@MNX-DEF path=gamma section=20.00 role=timer ordinal=004\n  gamma = value: if value then (with lib; value) else value;", "  inherit gamma;", 1), "top-level inherit"),
          ]
          for label, source, needle in mutations:
              definition_expect_failure(label, source, needle)
          print(f"mutation_cases={len(mutations)}")
          print("MNX_DEFINITION_ATLAS_SELF_TEST=PASS")
          return 0
      
      
      
      PART_RE = re.compile(r"^[ \t]*#@MNX-PART\s+(?P<payload>.*)$")
      TEMP_BEGIN_PREFIX = "#@MNX-TEMP-BEGIN "
      TEMP_END_PREFIX = "#@MNX-TEMP-END "
      ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
      KIND_RE = re.compile(r"^[a-z][a-z0-9-]*$")
      DATE_RE = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
      ALLOWED_PART_KINDS = frozenset({"function", "class", "phase", "category"})
      
      PY_DEF_RE = re.compile(r"^\s*(?:async\s+)?def\s+([A-Za-z_][A-Za-z0-9_]*)\s*\(")
      BASH_FUNCTION_RE = re.compile(
          r"^\s*(?:(?:function\s+)([A-Za-z_][A-Za-z0-9_]*)(?:\s*\(\s*\))?|([A-Za-z_][A-Za-z0-9_]*)\s*\(\s*\))\s*\{\s*$"
      )
      PY_CLASS_RE = re.compile(r"^\s*class\s+([A-Za-z_][A-Za-z0-9_]*)\b")
      SECTION_RE = re.compile(r"^\s*section\s+(['\"])(.*?)\1\s*$")
      
      
      #@MNX-PART id=99.55.mnx-atlas.class.policyerror kind=class title="Python class PolicyError"
      class PolicyError(RuntimeError):
          pass
      
      
      @dataclass(frozen=True)
      #@MNX-PART id=99.55.mnx-atlas.class.part kind=class title="Python class Part"
      class Part:
          part_id: str
          kind: str
          title: str
          marker_line: int
          target_line: int
          target: str
          definition_path: str
          definition_ordinal: int
          section: str
          end_line: int
          sha256: str
          byte_count: int
      
      
      @dataclass(frozen=True)
      #@MNX-PART id=99.55.mnx-atlas.class.tempregion kind=class title="Python class TempRegion"
      class TempRegion:
          temp_id: str
          purpose: str
          expires: str
          cleanup: str
          owner: str
          begin_line: int
          end_line: int
          definition_ordinals: tuple[int, ...]
      
      
      @dataclass(frozen=True)
      #@MNX-PART id=99.55.mnx-atlas.class.stage15policy kind=class title="Python class Stage15Policy"
      class Stage15Policy:
          source: Path
          source_sha256: str
          definition_count: int
          part_count: int
          chunks: tuple[str, ...]
          parts: tuple[Part, ...]
          temporary_regions: tuple[TempRegion, ...]
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.clean-line kind=function title="Python function clean_line"
      def clean_line(line: str) -> str:
          return line.rstrip("\r\n")
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.parse-fields kind=function title="Python function parse_fields"
      def parse_fields(payload: str, line_number: int, marker: str) -> dict[str, str]:
          try:
              tokens = shlex.split(payload, posix=True)
          except ValueError as exc:
              raise PolicyError(f"invalid {marker} marker at line {line_number}: {exc}") from exc
          fields: dict[str, str] = {}
          for token in tokens:
              if "=" not in token:
                  raise PolicyError(f"invalid {marker} token at line {line_number}: {token!r}")
              key, value = token.split("=", 1)
              if not key or key in fields:
                  raise PolicyError(f"duplicate or empty {marker} field {key!r} at line {line_number}")
              fields[key] = value
          return fields
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.normalize-name kind=function title="Python function normalize_name"
      def normalize_name(value: str) -> str:
          return re.sub(r"[^a-z0-9]+", "", value.casefold().strip("_"))
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.collapse-space kind=function title="Python function collapse_space"
      def collapse_space(value: str) -> str:
          return " ".join(value.split()).casefold()
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.next-nonblank kind=function title="Python function next_nonblank"
      def next_nonblank(lines: Sequence[str], marker_line: int) -> tuple[int, str]:
          index = marker_line
          while index < len(lines) and not clean_line(lines[index]).strip():
              index += 1
          if index >= len(lines):
              raise PolicyError(f"marker at line {marker_line} has no following target")
          return index + 1, clean_line(lines[index])
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.chunk-ranges kind=function title="Python function chunk_ranges"
      def chunk_ranges(atlas: Atlas, line_count: int) -> list[tuple[ChunkMarker, int, int]]:
          result: list[tuple[ChunkMarker, int, int]] = []
          chunks = list(atlas.chunks)
          for index, chunk in enumerate(chunks):
              end = chunks[index + 1].line - 1 if index + 1 < len(chunks) else line_count
              result.append((chunk, chunk.line, end))
          return result
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.chunk-for-line kind=function title="Python function chunk_for_line"
      def chunk_for_line(ranges: Iterable[tuple[ChunkMarker, int, int]], line_number: int) -> ChunkMarker | None:
          for chunk, start, end in ranges:
              if start <= line_number <= end:
                  return chunk
          return None
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.definition-for-line kind=function title="Python function definition_for_line"
      def definition_for_line(atlas: Atlas, line_number: int) -> Definition | None:
          for definition in atlas.definitions:
              if definition.marker.line <= line_number <= definition.assignment.end_line:
                  return definition
          return None
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.parse-parts kind=function title="Python function parse_parts"
      def parse_parts(text: str, lines: Sequence[str], atlas: Atlas) -> tuple[Part, ...]:
          rows: list[tuple[int, str, str, str, Definition, int, str]] = []
          seen_ids: set[str] = set()
          marker_lines: set[int] = set()
      
          for line_number, raw_line in enumerate(lines, start=1):
              line = clean_line(raw_line)
              match = PART_RE.fullmatch(line)
              if not match:
                  continue
              fields = parse_fields(match.group("payload"), line_number, "part")
              if list(fields) != ["id", "kind", "title"]:
                  raise PolicyError(f"part fields must be exactly id, kind, title at line {line_number}")
              part_id = fields["id"]
              kind = fields["kind"]
              title = fields["title"]
              if not ID_RE.fullmatch(part_id):
                  raise PolicyError(f"invalid part id at line {line_number}: {part_id!r}")
              if not KIND_RE.fullmatch(kind) or kind not in ALLOWED_PART_KINDS:
                  raise PolicyError(f"unknown part kind at line {line_number}: {kind!r}")
              if not title:
                  raise PolicyError(f"empty part title at line {line_number}")
              if part_id in seen_ids:
                  raise PolicyError(f"duplicate part id at line {line_number}: {part_id}")
              parent = definition_for_line(atlas, line_number)
              if parent is None:
                  raise PolicyError(f"part marker is outside a top-level definition at line {line_number}: {part_id}")
              if not part_id.startswith(parent.marker.section + "."):
                  raise PolicyError(
                      f"part id does not begin with containing section at line {line_number}: "
                      f"id={part_id!r} section={parent.marker.section!r}"
                  )
              target_line, target = next_nonblank(lines, line_number)
              if PART_RE.fullmatch(target):
                  raise PolicyError(f"empty part slice at line {line_number}: next nonblank line is another PART marker")
              seen_ids.add(part_id)
              marker_lines.add(line_number)
              rows.append((line_number, part_id, kind, title, parent, target_line, target))
      
          if not rows:
              raise PolicyError("no #@MNX-PART markers found")
      
          # Marker truth: a part naming a function/class/phase/category must still point at that thing.
          for line_number, part_id, kind, title, _parent, target_line, target in rows:
              if kind == "function":
                  match = PY_DEF_RE.match(target)
                  name = match.group(1) if match else ""
                  if not name:
                      match = BASH_FUNCTION_RE.match(target)
                      if match:
                          name = match.group(1) or match.group(2) or ""
                  if not name:
                      raise PolicyError(f"function part at line {line_number} does not immediately identify a function: {target!r}")
                  if normalize_name(name) not in normalize_name(title):
                      raise PolicyError(
                          f"stale function part at line {line_number}: target={name!r} title={title!r} id={part_id!r}"
                      )
              elif kind == "class":
                  match = PY_CLASS_RE.match(target)
                  if not match:
                      raise PolicyError(f"class part at line {line_number} does not immediately identify a class: {target!r}")
                  name = match.group(1)
                  if normalize_name(name) not in normalize_name(title):
                      raise PolicyError(
                          f"stale class part at line {line_number}: target={name!r} title={title!r} id={part_id!r}"
                      )
              elif kind == "phase":
                  match = SECTION_RE.match(target)
                  if not match:
                      raise PolicyError(f"phase part at line {line_number} does not immediately identify a section call: {target!r}")
                  label = match.group(2)
                  expected = f"Phase: {label}"
                  if title != expected:
                      raise PolicyError(
                          f"stale phase part at line {line_number}: target={label!r} title={title!r} expected={expected!r}"
                      )
              elif kind == "category":
                  heading = re.sub(r"^[#\s]+|[#\s]+$", "", target).strip()
                  prefix = "Package category: "
                  if not heading or not title.startswith(prefix):
                      raise PolicyError(f"category part at line {line_number} does not immediately identify a heading: {target!r}")
                  if collapse_space(heading) != collapse_space(title[len(prefix):]):
                      raise PolicyError(
                          f"stale category part at line {line_number}: heading={heading!r} title={title!r}"
                      )
      
          # Exhaustiveness for the constructs this schema says it navigates. New functions/classes/literal phases
          # cannot silently appear without a part marker immediately above them.
          for definition in atlas.definitions:
              for line_number in range(definition.assignment.start_line, definition.assignment.end_line + 1):
                  target = clean_line(lines[line_number - 1])
                  stripped = target.strip()
                  kind: str | None = None
                  if PY_DEF_RE.match(target) or BASH_FUNCTION_RE.match(target):
                      kind = "function"
                  elif PY_CLASS_RE.match(target):
                      kind = "class"
                  else:
                      section_match = SECTION_RE.match(target)
                      if section_match and "$" not in section_match.group(2):
                          kind = "phase"
                  if kind is None:
                      continue
                  previous = line_number - 1
                  while previous > definition.marker.line and not clean_line(lines[previous - 1]).strip():
                      previous -= 1
                  if previous not in marker_lines:
                      raise PolicyError(
                          f"unanchored internal {kind} at line {line_number} inside definition "
                          f"{definition.marker.path!r}: {stripped!r}"
                      )
      
          grouped: dict[int, list[tuple[int, str, str, str, Definition, int, str]]] = {}
          for row in rows:
              grouped.setdefault(row[4].marker.ordinal, []).append(row)
      
          parts: list[Part] = []
          for definition in atlas.definitions:
              members = sorted(grouped.get(definition.marker.ordinal, []), key=lambda row: row[0])
              for position, row in enumerate(members):
                  line_number, part_id, kind, title, parent, target_line, target = row
                  end_line = members[position + 1][0] - 1 if position + 1 < len(members) else definition.assignment.end_line
                  if end_line < target_line:
                      raise PolicyError(f"part has no target span at line {line_number}: {part_id}")
                  data = "".join(lines[line_number - 1:end_line])
                  parts.append(
                      Part(
                          part_id=part_id,
                          kind=kind,
                          title=title,
                          marker_line=line_number,
                          target_line=target_line,
                          target=target.strip(),
                          definition_path=parent.marker.path,
                          definition_ordinal=parent.marker.ordinal,
                          section=parent.marker.section,
                          end_line=end_line,
                          sha256=hashlib.sha256(data.encode("utf-8")).hexdigest(),
                          byte_count=len(data.encode("utf-8")),
                      )
                  )
          return tuple(parts)
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.lexical-temp-comments kind=function title="Python function lexical_temp_comments"
      def lexical_temp_comments(text: str) -> tuple[list[Comment], set[int]]:
          lexer = Lexer(text)
          _tokens, comments = lexer.run()
          outer = [
              comment
              for comment in comments
              if comment.outer and comment.column == 1
              and (comment.raw.startswith("#@MNX-TEMP-BEGIN") or comment.raw.startswith("#@MNX-TEMP-END"))
          ]
          raw_lines: set[int] = set()
          for line_number, line in enumerate(text.splitlines(), start=1):
              if re.match(r"^[ \t]*#@MNX-TEMP-(?:BEGIN|END)\b", line):
                  raw_lines.add(line_number)
                  if line[:1].isspace():
                      raise PolicyError(f"TEMP marker-like line is not column zero at line {line_number}")
          lexical_lines = {comment.line for comment in outer}
          hidden = sorted(raw_lines - lexical_lines)
          if hidden:
              raise PolicyError(
                  "column-zero TEMP marker-like text occurs inside a string, block comment, or interpolation at lines "
                  + ", ".join(map(str, hidden[:20]))
              )
          return outer, raw_lines
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.parse-temporary-regions kind=function title="Python function parse_temporary_regions"
      def parse_temporary_regions(text: str, lines: Sequence[str], atlas: Atlas) -> tuple[TempRegion, ...]:
          comments, _ = lexical_temp_comments(text)
          ranges = chunk_ranges(atlas, len(lines))
          comments = sorted(comments, key=lambda item: item.line)
          active: tuple[Comment, dict[str, str]] | None = None
          seen: set[str] = set()
          regions: list[TempRegion] = []
      
          for comment in comments:
              if comment.raw.startswith(TEMP_BEGIN_PREFIX):
                  if active is not None:
                      raise PolicyError(f"nested temporary-code region begins at line {comment.line}")
                  fields = parse_fields(comment.raw[len(TEMP_BEGIN_PREFIX):], comment.line, "temporary begin")
                  if list(fields) not in (["id", "purpose", "expires", "cleanup"], ["id", "purpose", "expires", "cleanup", "owner"]):
                      raise PolicyError(
                          f"temporary begin fields must be id, purpose, expires, cleanup[, owner] at line {comment.line}"
                      )
                  temp_id = fields.get("id", "")
                  purpose = fields.get("purpose", "")
                  expires = fields.get("expires", "")
                  cleanup = fields.get("cleanup", "")
                  owner = fields.get("owner", "chatgpt")
                  if not ID_RE.fullmatch(temp_id) or not purpose or not cleanup or not owner or not DATE_RE.fullmatch(expires):
                      raise PolicyError(f"invalid temporary begin marker at line {comment.line}")
                  try:
                      date.fromisoformat(expires)
                  except ValueError as exc:
                      raise PolicyError(f"invalid temporary expiry date at line {comment.line}: {expires}") from exc
                  if temp_id in seen:
                      raise PolicyError(f"duplicate temporary-code id at line {comment.line}: {temp_id}")
                  chunk = chunk_for_line(ranges, comment.line)
                  if chunk is None or chunk.chunk_id != "98.00":
                      raise PolicyError(f"temporary-code region must begin in chunk 98.00, line {comment.line}")
                  seen.add(temp_id)
                  active = (comment, fields)
              elif comment.raw.startswith(TEMP_END_PREFIX):
                  fields = parse_fields(comment.raw[len(TEMP_END_PREFIX):], comment.line, "temporary end")
                  if list(fields) != ["id"]:
                      raise PolicyError(f"temporary end marker must contain exactly id at line {comment.line}")
                  if active is None:
                      raise PolicyError(f"temporary-code end without begin at line {comment.line}")
                  begin, begin_fields = active
                  if fields["id"] != begin_fields["id"]:
                      raise PolicyError(
                          f"temporary-code id mismatch: begin={begin_fields['id']} end={fields['id']}"
                      )
                  begin_chunk = chunk_for_line(ranges, begin.line)
                  end_chunk = chunk_for_line(ranges, comment.line)
                  if begin_chunk is None or end_chunk is None or begin_chunk.chunk_id != "98.00" or end_chunk.chunk_id != "98.00":
                      raise PolicyError(
                          f"temporary-code region {begin_fields['id']!r} crosses outside chunk 98.00: "
                          f"lines={begin.line}-{comment.line}"
                      )
                  intruding_chunks = [chunk for chunk in atlas.chunks if begin.line < chunk.line <= comment.line]
                  if intruding_chunks:
                      raise PolicyError(
                          f"temporary-code region {begin_fields['id']!r} crosses chunk marker "
                          f"{intruding_chunks[0].chunk_id!r} at line {intruding_chunks[0].line}"
                      )
                  contained = [
                      definition.marker.ordinal
                      for definition in atlas.definitions
                      if begin.line < definition.marker.line
                      and definition.assignment.end_line < comment.line
                  ]
                  if not contained:
                      raise PolicyError(
                          f"temporary-code region {begin_fields['id']!r} at lines {begin.line}-{comment.line} "
                          "contains no complete top-level definition"
                      )
                  regions.append(
                      TempRegion(
                          temp_id=begin_fields["id"],
                          purpose=begin_fields["purpose"],
                          expires=begin_fields["expires"],
                          cleanup=begin_fields["cleanup"],
                          owner=begin_fields.get("owner", "chatgpt"),
                          begin_line=begin.line,
                          end_line=comment.line,
                          definition_ordinals=tuple(contained),
                      )
                  )
                  active = None
          if active is not None:
              raise PolicyError(f"unterminated temporary-code region beginning at line {active[0].line}")
      
          for definition in atlas.definitions:
              if definition.chunk.chunk_id != "98.00":
                  continue
              containing = [
                  region
                  for region in regions
                  if region.begin_line < definition.marker.line
                  and definition.assignment.end_line < region.end_line
              ]
              if len(containing) != 1:
                  raise PolicyError(
                      f"active top-level definition in candidate-only chunk 98.00 is not enclosed by exactly one "
                      f"TEMP region: ordinal={definition.marker.ordinal:03d} path={definition.marker.path!r} "
                      f"line={definition.marker.line}"
                  )
      
          return tuple(regions)
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.build-policy kind=function title="Python function build_policy"
      def build_policy(path: Path) -> Stage15Policy:
          try:
              data = path.read_bytes()
          except OSError as exc:
              raise PolicyError(f"cannot read configuration: {path}: {exc}") from exc
          try:
              text = data.decode("utf-8")
          except UnicodeDecodeError as exc:
              raise PolicyError(f"configuration is not valid UTF-8: {exc}") from exc
          try:
              atlas = build_atlas(path)
          except AtlasError as exc:
              raise PolicyError(str(exc)) from exc
          lines = tuple(text.splitlines(keepends=True))
          parts = parse_parts(text, lines, atlas)
          temporary_regions = parse_temporary_regions(text, lines, atlas)
          return Stage15Policy(
              source=path.resolve(),
              source_sha256=hashlib.sha256(data).hexdigest(),
              definition_count=len(atlas.definitions),
              part_count=len(parts),
              chunks=tuple(chunk.chunk_id for chunk in atlas.chunks),
              parts=parts,
              temporary_regions=temporary_regions,
          )
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.manifest kind=function title="Python function manifest"
      def manifest(policy: Stage15Policy) -> dict[str, object]:
          return {
              "mnx_stage15_policy_version": 1,
              "source": str(policy.source),
              "source_sha256": policy.source_sha256,
              "definition_count": policy.definition_count,
              "part_count": policy.part_count,
              "chunk_ids": list(policy.chunks),
              "parts": [asdict(item) for item in policy.parts],
              "temporary_regions": [asdict(item) for item in policy.temporary_regions],
          }
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.gate kind=function title="Python function gate"
      def gate(policy: Stage15Policy, mode: str) -> int:
          expired = [item for item in policy.temporary_regions if date.fromisoformat(item.expires) < date.today()]
          print(f"temporary_code_region_count={len(policy.temporary_regions)}")
          print(f"temporary_code_expired_count={len(expired)}")
          print(
              "temporary_code_region_ids="
              + (",".join(item.temp_id for item in policy.temporary_regions) if policy.temporary_regions else "none")
          )
          if expired:
              print("MNX_STAGE15_TEMP_GATE=FAIL_EXPIRED")
              return 1
          if mode in {"switch", "audit"} and policy.temporary_regions:
              print("MNX_STAGE15_TEMP_GATE=FAIL_CANDIDATE_ONLY_CODE_PRESENT")
              return 1
          print("MNX_STAGE15_TEMP_GATE=PASS")
          return 0
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.valid-fixture kind=function title="Python function valid_fixture"
      def valid_fixture(*, with_temp: bool = True) -> str:
          temp = ""
          if with_temp:
              temp = (
                  '#@MNX-TEMP-BEGIN id=probe purpose="Temporary probe" expires=2099-12-31 cleanup="remove" owner=chatgpt\n'
                  '#@MNX-DEF path=probe section=98.00 role=experiment ordinal=002\n'
                  'probe = true;\n'
                  '#@MNX-TEMP-END id=probe\n'
              )
          return "".join([
              "#!/usr/bin/env bash\n",
              '#@MNX-CHUNK id=10.00 slug=body title="Body"\n',
              "{ config, ... }:\n",
              "{\n",
              '#@MNX-DEF path=alpha section=10.00 role=generated-program ordinal=001\n',
              "alpha = ", S2, "\n",
              '#@MNX-PART id=10.00.alpha.function.hello kind=function title="Function hello"\n',
              "hello() {\n",
              "  :\n",
              "}\n",
              '#@MNX-PART id=10.00.alpha.phase.check kind=phase title="Phase: CHECK"\n',
              "section 'CHECK'\n",
              S2, ";\n",
              '#@MNX-CHUNK id=98.00 slug=candidate-experiment-bay title="Experiment bay"\n',
              temp,
              "}\n",
              '#@MNX-CHUNK id=99.99 slug=end title="End"\n',
          ])
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.expect-failure kind=function title="Python function expect_failure"
      def expect_failure(label: str, source: str, needle: str | None = None) -> None:
          with tempfile.TemporaryDirectory(prefix="mnx-stage15-policy-self-test-") as temporary:
              path = Path(temporary) / "configuration.nix"
              path.write_text(source, encoding="utf-8")
              try:
                  build_policy(path)
              except PolicyError as exc:
                  if needle is not None and needle not in str(exc):
                      raise PolicyError(f"self-test {label!r} failed with wrong error: {exc}") from exc
                  return
          raise PolicyError(f"self-test expected rejection: {label}")
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.self-test kind=function title="Python function self_test"
      def self_test() -> int:
          if definition_core_self_test() != 0:
              raise PolicyError("definition-boundary core self-test failed")
          fixture = valid_fixture()
          with tempfile.TemporaryDirectory(prefix="mnx-stage15-policy-self-test-") as temporary:
              path = Path(temporary) / "configuration.nix"
              path.write_text(fixture, encoding="utf-8")
              first = build_policy(path)
              second = build_policy(path)
              if manifest(first) != manifest(second):
                  raise PolicyError("self-test manifest is not deterministic")
              if len(first.parts) != 2 or len(first.temporary_regions) != 1:
                  raise PolicyError("self-test valid fixture counts are wrong")
              if gate(first, "test") != 0 or gate(first, "switch") == 0:
                  raise PolicyError("self-test temporary-code gate behavior is wrong")
      
          mutations: list[tuple[str, str, str | None]] = [
              (
                  "stale definition path",
                  fixture.replace("path=alpha section=10.00", "path=beta section=10.00", 1),
                  "stale DEF path",
              ),
              (
                  "blank after definition marker",
                  fixture.replace("ordinal=001\nalpha", "ordinal=001\n\nalpha", 1),
                  "immediately preceding",
              ),
              (
                  "unmarked top-level definition",
                  fixture.replace("#@MNX-CHUNK id=98.00", "unmarked = true;\n#@MNX-CHUNK id=98.00", 1),
                  "lacks an immediately preceding",
              ),
              (
                  "chunk splits definition",
                  fixture.replace("  :\n", "#@MNX-CHUNK id=10.50 slug=intrude title=\"Intrude\"\n  :\n", 1),
                  None,
              ),
              (
                  "stale function part",
                  fixture.replace("hello() {", "renamed() {", 1),
                  "stale function part",
              ),
              (
                  "missing function part",
                  fixture.replace('#@MNX-PART id=10.00.alpha.function.hello kind=function title="Function hello"\n', "", 1),
                  "unanchored internal function",
              ),
              (
                  "empty part",
                  fixture.replace(
                      '#@MNX-PART id=10.00.alpha.function.hello kind=function title="Function hello"',
                      '#@MNX-PART id=10.00.alpha.function.empty kind=function title="Function empty"\n'
                      '#@MNX-PART id=10.00.alpha.function.hello kind=function title="Function hello"',
                      1,
                  ),
                  "empty part slice",
              ),
              (
                  "stale phase title",
                  fixture.replace("title=\"Phase: CHECK\"", "title=\"Phase: WRONG\"", 1),
                  "stale phase part",
              ),
              (
                  "temporary region outside 98",
                  fixture.replace("#@MNX-CHUNK id=98.00", "#@MNX-TEMP-BEGIN id=bad purpose=\"bad\" expires=2099-12-31 cleanup=\"remove\"\n#@MNX-TEMP-END id=bad\n#@MNX-CHUNK id=98.00", 1),
                  "must begin in chunk 98.00",
              ),
              (
                  "temporary region crosses chunk",
                  fixture.replace("#@MNX-TEMP-END id=probe\n", "", 1).replace(
                      "#@MNX-CHUNK id=99.99 slug=end title=\"End\"\n", "#@MNX-CHUNK id=99.99 slug=end title=\"End\"\n#@MNX-TEMP-END id=probe\n", 1
                  ),
                  "crosses outside chunk 98.00",
              ),
              (
                  "marked active code in 98 without temp",
                  valid_fixture(with_temp=False).replace(
                      "}\n#@MNX-CHUNK id=99.99",
                      '#@MNX-DEF path=permanentLeak section=98.00 role=experiment ordinal=002\npermanentLeak = true;\n}\n#@MNX-CHUNK id=99.99',
                      1,
                  ),
                  "not enclosed by exactly one TEMP region",
              ),
              (
                  "empty temporary region",
                  fixture.replace(
                      '#@MNX-DEF path=probe section=98.00 role=experiment ordinal=002\nprobe = true;\n',
                      "",
                      1,
                  ).replace("ordinal=001", "ordinal=001", 1),
                  "contains no complete top-level definition",
              ),
              (
                  "temporary id mismatch",
                  fixture.replace("#@MNX-TEMP-END id=probe", "#@MNX-TEMP-END id=wrong", 1),
                  "id mismatch",
              ),
              (
                  "temporary marker hidden in string",
                  fixture.replace("  :\n", "#@MNX-TEMP-BEGIN id=hidden purpose=\"x\" expires=2099-12-31 cleanup=\"remove\"\n  :\n", 1),
                  "inside a string",
              ),
          ]
          for label, source, needle in mutations:
              expect_failure(label, source, needle)
      
          # Exact-byte identity survives CRLF rather than silently hashing/writing a normalized copy.
          with tempfile.TemporaryDirectory(prefix="mnx-stage15-policy-crlf-") as temporary:
              path = Path(temporary) / "configuration.nix"
              raw = valid_fixture(with_temp=False).encode("utf-8").replace(b"\n", b"\r\n")
              path.write_bytes(raw)
              parsed = build_policy(path)
              if parsed.source_sha256 != hashlib.sha256(raw).hexdigest():
                  raise PolicyError("self-test CRLF source hash is not byte-exact")
      
          print(f"mutation_cases={len(mutations)}")
          print("crlf_exact_byte_case=PASS")
          print("MNX_STAGE15_POLICY_SELF_TEST=PASS")
          return 0
      
      
      
      @dataclass(frozen=True)
      #@MNX-PART id=99.55.mnx-atlas.class.navigationatlas kind=class title="Python class NavigationAtlas"
      class NavigationAtlas:
          core: Atlas
          policy: Stage15Policy
          raw_bytes: bytes
          lines: tuple[str, ...]
      
          @property
          #@MNX-PART id=99.55.mnx-atlas.function.source kind=function title="Python function source"
          def source(self) -> Path:
              return self.core.source
      
          @property
          #@MNX-PART id=99.55.mnx-atlas.function.text kind=function title="Python function text"
          def text(self) -> str:
              return self.core.text
      
          @property
          #@MNX-PART id=99.55.mnx-atlas.function.sha256 kind=function title="Python function sha256"
          def sha256(self) -> str:
              return self.policy.source_sha256
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.build-navigation kind=function title="Python function build_navigation"
      def build_navigation(path: Path) -> NavigationAtlas:
          try:
              raw = path.read_bytes()
          except OSError as exc:
              raise PolicyError(f"cannot read configuration: {path}: {exc}") from exc
          try:
              text = raw.decode("utf-8")
          except UnicodeDecodeError as exc:
              raise PolicyError(f"configuration is not valid UTF-8: {exc}") from exc
          core_atlas = build_atlas(path)
          policy = build_policy(path)
          digest = hashlib.sha256(raw).hexdigest()
          if core_atlas.source_sha256 != digest or policy.source_sha256 != digest:
              raise PolicyError("atlas source hashes disagree")
          if len(core_atlas.definitions) != policy.definition_count:
              raise PolicyError("definition count disagrees between core and policy layers")
          return NavigationAtlas(core_atlas, policy, raw, tuple(text.splitlines(keepends=True)))
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.chunk-end-line kind=function title="Python function chunk_end_line"
      def chunk_end_line(navigation: NavigationAtlas, position: int) -> int:
          chunks = navigation.core.chunks
          return chunks[position + 1].line - 1 if position + 1 < len(chunks) else len(navigation.lines)
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.chunk-for-navigation-line kind=function title="Python function chunk_for_navigation_line"
      def chunk_for_navigation_line(navigation: NavigationAtlas, line_number: int) -> ChunkMarker | None:
          selected: ChunkMarker | None = None
          for chunk in navigation.core.chunks:
              if chunk.line > line_number:
                  break
              selected = chunk
          return selected
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.definition-for-navigation-line kind=function title="Python function definition_for_navigation_line"
      def definition_for_navigation_line(navigation: NavigationAtlas, line_number: int) -> Definition | None:
          for definition in navigation.core.definitions:
              if definition.marker.line <= line_number <= definition.assignment.end_line:
                  return definition
          return None
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.part-for-navigation-line kind=function title="Python function part_for_navigation_line"
      def part_for_navigation_line(navigation: NavigationAtlas, line_number: int) -> Part | None:
          for part in navigation.policy.parts:
              if part.marker_line <= line_number <= part.end_line:
                  return part
          return None
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.definition-bytes kind=function title="Python function definition_bytes"
      def definition_bytes(navigation: NavigationAtlas, definition: Definition) -> bytes:
          return navigation.text[definition.span_start:definition.span_end].encode("utf-8")
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.definition-text kind=function title="Python function definition_text"
      def definition_text(navigation: NavigationAtlas, definition: Definition) -> str:
          return definition_bytes(navigation, definition).decode("utf-8")
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.part-bytes kind=function title="Python function part_bytes"
      def part_bytes(navigation: NavigationAtlas, part: Part) -> bytes:
          return "".join(navigation.lines[part.marker_line - 1:part.end_line]).encode("utf-8")
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.part-text kind=function title="Python function part_text"
      def part_text(navigation: NavigationAtlas, part: Part) -> str:
          return part_bytes(navigation, part).decode("utf-8")
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.resolve-navigation-definition kind=function title="Python function resolve_navigation_definition"
      def resolve_navigation_definition(navigation: NavigationAtlas, selector: str) -> Definition:
          exact = [
              item for item in navigation.core.definitions
              if selector in {item.marker.path, str(item.marker.ordinal), f"{item.marker.ordinal:03d}"}
          ]
          if len(exact) == 1:
              return exact[0]
          query = selector.casefold()
          partial = [item for item in navigation.core.definitions if query in item.marker.path.casefold()]
          if len(partial) == 1:
              return partial[0]
          if not partial:
              raise PolicyError(f"no definition matches: {selector}")
          raise PolicyError(
              "ambiguous definition selector: "
              + selector
              + "\n"
              + "\n".join(f"{item.marker.ordinal:03d} {item.marker.path}" for item in partial[:30])
          )
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.resolve-navigation-part kind=function title="Python function resolve_navigation_part"
      def resolve_navigation_part(navigation: NavigationAtlas, selector: str) -> Part:
          exact = [item for item in navigation.policy.parts if item.part_id == selector]
          if len(exact) == 1:
              return exact[0]
          query = selector.casefold()
          partial = [
              item for item in navigation.policy.parts
              if query in item.part_id.casefold() or query in item.title.casefold()
          ]
          if len(partial) == 1:
              return partial[0]
          if not partial:
              raise PolicyError(f"no part matches: {selector}")
          raise PolicyError(
              "ambiguous part selector: "
              + selector
              + "\n"
              + "\n".join(f"{item.part_id} {item.title}" for item in partial[:30])
          )
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.print-navigation-index kind=function title="Python function print_navigation_index"
      def print_navigation_index(navigation: NavigationAtlas, include_parts: bool = False) -> None:
          print(f"source={navigation.source}")
          print(f"source_sha256={navigation.sha256}")
          print(f"source_bytes={len(navigation.raw_bytes)}")
          print(f"chunk_count={len(navigation.core.chunks)}")
          print(f"definition_count={len(navigation.core.definitions)}")
          print(f"part_count={len(navigation.policy.parts)}")
          print(f"temporary_code_region_count={len(navigation.policy.temporary_regions)}")
          for position, chunk in enumerate(navigation.core.chunks):
              end_line = chunk_end_line(navigation, position)
              definitions = [item for item in navigation.core.definitions if item.marker.section == chunk.chunk_id]
              part_count = sum(1 for item in navigation.policy.parts if item.section == chunk.chunk_id)
              print(
                  f"\n[{chunk.chunk_id}] {chunk.slug} lines={chunk.line}-{end_line} "
                  f"definitions={len(definitions)} parts={part_count} title={chunk.title}"
              )
              for definition in definitions:
                  definition_parts = [
                      item for item in navigation.policy.parts
                      if item.definition_ordinal == definition.marker.ordinal
                  ]
                  print(
                      f"  DEF {definition.marker.ordinal:03d} "
                      f"lines={definition.marker.line}-{definition.assignment.end_line} "
                      f"role={definition.marker.role} parts={len(definition_parts)} "
                      f"path={definition.marker.path}"
                  )
                  if include_parts:
                      for part in definition_parts:
                          print(
                              f"    PART lines={part.marker_line}-{part.end_line} "
                              f"kind={part.kind} id={part.part_id} title={part.title}"
                          )
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.navigation-manifest kind=function title="Python function navigation_manifest"
      def navigation_manifest(navigation: NavigationAtlas) -> dict[str, object]:
          return {
              "mnx_atlas_manifest_version": 2,
              "mnx_atlas_defense_version": 1,
              "source": str(navigation.source),
              "source_sha256": navigation.sha256,
              "source_lines": len(navigation.lines),
              "source_bytes": len(navigation.raw_bytes),
              "exact_byte_identity": True,
              "chunks": [
                  {
                      "id": chunk.chunk_id,
                      "slug": chunk.slug,
                      "title": chunk.title,
                      "marker_line": chunk.line,
                      "end_line": chunk_end_line(navigation, position),
                  }
                  for position, chunk in enumerate(navigation.core.chunks)
              ],
              "definitions": [
                  {
                      "ordinal": item.marker.ordinal,
                      "path": item.marker.path,
                      "section": item.marker.section,
                      "role": item.marker.role,
                      "marker_line": item.marker.line,
                      "start_line": item.assignment.start_line,
                      "end_line": item.assignment.end_line,
                      "assignment_sha256": item.assignment_sha256,
                      "anchored_span_sha256": item.span_sha256,
                      "bytes": len(definition_bytes(navigation, item)),
                      "part_count": sum(
                          1 for part in navigation.policy.parts
                          if part.definition_ordinal == item.marker.ordinal
                      ),
                  }
                  for item in navigation.core.definitions
              ],
              "parts": [asdict(item) for item in navigation.policy.parts],
              "temporary_regions": [asdict(item) for item in navigation.policy.temporary_regions],
              "invariants": {
                  "all_top_level_assignments_anchored": True,
                  "all_definition_markers_truthful": True,
                  "all_definition_ordinals_contiguous": True,
                  "no_chunk_marker_splits_definition": True,
                  "all_internal_function_class_phase_anchors_truthful": True,
                  "section_98_temporary_code_containment": True,
              },
          }
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.command-navigation-manifest kind=function title="Python function command_navigation_manifest"
      def command_navigation_manifest(navigation: NavigationAtlas) -> int:
          json.dump(navigation_manifest(navigation), sys.stdout, indent=2, sort_keys=True)
          print()
          return 0
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.command-navigation-search kind=function title="Python function command_navigation_search"
      def command_navigation_search(navigation: NavigationAtlas, pattern: str, context: int, maximum: int) -> int:
          try:
              regex = re.compile(pattern)
          except re.error as exc:
              raise PolicyError(f"invalid search regex: {exc}") from exc
          matches = 0
          plain_lines = [line.rstrip("\r\n") for line in navigation.lines]
          for line_number, line in enumerate(plain_lines, start=1):
              if not regex.search(line):
                  continue
              matches += 1
              chunk = chunk_for_navigation_line(navigation, line_number)
              definition = definition_for_navigation_line(navigation, line_number)
              part = part_for_navigation_line(navigation, line_number)
              print(
                  f"\nMATCH line={line_number} "
                  f"chunk={chunk.chunk_id if chunk else 'none'} "
                  f"definition={definition.marker.path if definition else 'none'} "
                  f"part={part.part_id if part else 'none'}"
              )
              low = max(1, line_number - context)
              high = min(len(plain_lines), line_number + context)
              for current in range(low, high + 1):
                  prefix = ">" if current == line_number else " "
                  print(f"{prefix}{current:06d}: {plain_lines[current - 1]}")
              if matches >= maximum:
                  break
          print(f"\nmatch_count={matches}")
          return 0 if matches else 1
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.command-navigation-temp kind=function title="Python function command_navigation_temp"
      def command_navigation_temp(navigation: NavigationAtlas, show: bool) -> int:
          today = date.today()
          expired = [
              item for item in navigation.policy.temporary_regions
              if date.fromisoformat(item.expires) < today
          ]
          print(f"temporary_code_region_count={len(navigation.policy.temporary_regions)}")
          print(f"temporary_code_expired_count={len(expired)}")
          print(
              "temporary_code_region_ids="
              + (
                  ",".join(item.temp_id for item in navigation.policy.temporary_regions)
                  if navigation.policy.temporary_regions else "none"
              )
          )
          if not navigation.policy.temporary_regions:
              print("temporary_code_switch_policy=clear")
              return 0
          print("temporary_code_switch_policy=blocked-until-the-bounded-region-is-removed-and-retested")
          for item in navigation.policy.temporary_regions:
              is_expired = date.fromisoformat(item.expires) < today
              print(
                  f"temporary_region id={item.temp_id} lines={item.begin_line}-{item.end_line} "
                  f"definitions={','.join(f'{value:03d}' for value in item.definition_ordinals)} "
                  f"owner={item.owner} expires={item.expires} "
                  f"expired={'yes' if is_expired else 'no'} cleanup={item.cleanup} purpose={item.purpose}"
              )
              if show:
                  sys.stdout.write("".join(navigation.lines[item.begin_line - 1:item.end_line]))
          return 1 if expired else 0
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.command-navigation-temp-gate kind=function title="Python function command_navigation_temp_gate"
      def command_navigation_temp_gate(navigation: NavigationAtlas, mode: str) -> int:
          if mode not in {"test", "switch", "audit"}:
              raise PolicyError(f"unknown temporary-code gate mode: {mode}")
          status_rc = command_navigation_temp(navigation, show=False)
          if status_rc != 0:
              print("MNX_TEMPORARY_CODE_GATE=FAIL_EXPIRED")
              return 1
          if mode in {"switch", "audit"} and navigation.policy.temporary_regions:
              print("MNX_TEMPORARY_CODE_GATE=FAIL_CANDIDATE_ONLY_CODE_PRESENT")
              return 1
          print("MNX_TEMPORARY_CODE_GATE=PASS")
          return 0
      
      
      #@MNX-PART id=99.55.mnx-atlas.function.command-navigation-temp-template kind=function title="Python function command_navigation_temp_template"
      def command_navigation_temp_template() -> int:
          print(
              "# Copy this commented template into SECTION 98. Remove the leading '# ' only while actively testing.\n"
              "# Any bounded region may be activated by `mnx test`; plain `mnx switch` refuses every such region.\n"
              "# Promote wanted code by moving it to its canonical section, deleting both TEMP markers, and testing again.\n"
              "#\n"
              "# #@MNX-TEMP-BEGIN id=short-name purpose=\"what is being tested\" expires=YYYY-MM-DD cleanup=\"exact removal condition\" owner=h0p3\n"
              "# #@MNX-DEF path=systemd.services.example-temporary section=98.00 role=experiment ordinal=NNN\n"
              "# systemd.services.example-temporary = {\n"
