#@MNX-CHUNK id=40.22 slug=evidence-manifest title="Atomic checksum manifests for forensic bundles"
#@MNX-DEF path=environment.etc."monsternix/bin/mnx-bundle-manifest" section=40.22 role=generated-program ordinal=156
  environment.etc."monsternix/bin/mnx-bundle-manifest" = {
    source = pkgs.writeTextFile {
      name = "mnx-bundle-manifest";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      export PATH=${pkgs.coreutils}/bin:${pkgs.findutils}/bin:${pkgs.gnugrep}/bin:${pkgs.gawk}/bin
      set -Eeuo pipefail
      export LC_ALL=C
      umask 027

      #@MNX-PART id=40.22.mnx-bundle-manifest.function.usage kind=function title="Function usage"
      usage() {
        cat <<'USAGE'
      usage:
        mnx-bundle-manifest create DIRECTORY [MAX_DEPTH]
        mnx-bundle-manifest verify DIRECTORY
        mnx-bundle-manifest self-test

      The manifest is built in DIRECTORY's parent, excludes SHA256SUMS itself,
      is atomically moved into place, and is immediately verified.
      USAGE
      }

      #@MNX-PART id=40.22.mnx-bundle-manifest.function.verify_manifest kind=function title="Function verify_manifest"
      verify_manifest() {
        local dir="$1" manifest line expected relative local_path resolved actual component
        local line_number=0 entry_count=0 failure_count=0
        local -a components=()
        local -A seen=()

        [[ -d "$dir" && ! -L "$dir" ]] || { echo "invalid bundle directory: $dir" >&2; return 66; }
        dir="$(readlink -f -- "$dir")"
        manifest="$dir/SHA256SUMS"
        [[ -s "$manifest" && -f "$manifest" && ! -L "$manifest" ]] || { echo "missing manifest: $manifest" >&2; return 65; }

        while IFS= read -r line || [[ -n "$line" ]]; do
          (( line_number += 1 ))
          if [[ ! "$line" =~ ^([0-9a-f]{64})[[:space:]][[:space:]](\./.+)$ ]]; then
            printf 'manifest line %s is not canonical: %q\n' "$line_number" "$line" >&2
            failure_count=$((failure_count + 1))
            continue
          fi

          expected="''${BASH_REMATCH[1]}"
          relative="''${BASH_REMATCH[2]}"
          if [[ "$relative" == "./SHA256SUMS" || "$relative" == *\\* || "$relative" == *$'\r'* || "$relative" == *$'\n'* ]]; then
            printf 'manifest line %s has a forbidden path: %q\n' "$line_number" "$relative" >&2
            failure_count=$((failure_count + 1))
            continue
          fi

          IFS='/' read -r -a components <<< "''${relative#./}"
          if (( ''${#components[@]} == 0 )); then
            printf 'manifest line %s has an empty path\n' "$line_number" >&2
            failure_count=$((failure_count + 1))
            continue
          fi
          for component in "''${components[@]}"; do
            if [[ -z "$component" || "$component" == . || "$component" == .. ]]; then
              printf 'manifest line %s escapes or aliases the bundle root: %q\n' "$line_number" "$relative" >&2
              failure_count=$((failure_count + 1))
              component=""
              break
            fi
          done
          [[ -n "$component" ]] || continue

          if [[ -n "''${seen[$relative]+present}" ]]; then
            printf 'manifest line %s duplicates path: %s\n' "$line_number" "$relative" >&2
            failure_count=$((failure_count + 1))
            continue
          fi
          seen["$relative"]=1

          local_path="$dir/''${relative#./}"
          if [[ ! -f "$local_path" || -L "$local_path" ]]; then
            printf '%s: FAILED (not a regular non-symlink file)\n' "$relative" >&2
            failure_count=$((failure_count + 1))
            continue
          fi
          resolved="$(readlink -f -- "$local_path" 2>/dev/null || true)"
          case "$resolved" in
            "$dir"/*) ;;
            *)
              printf '%s: FAILED (resolved outside bundle)\n' "$relative" >&2
              failure_count=$((failure_count + 1))
              continue
              ;;
          esac

          actual="$(sha256sum -- "$local_path")"
          actual="''${actual%% *}"
          if [[ "$actual" != "$expected" ]]; then
            printf '%s: FAILED\n' "$relative" >&2
            failure_count=$((failure_count + 1))
            continue
          fi
          printf '%s: OK\n' "$relative"
          entry_count=$((entry_count + 1))
        done < "$manifest"

        (( line_number > 0 )) || { echo "manifest is empty: $manifest" >&2; return 1; }
        printf 'manifest_entry_count=%s\nmanifest_failure_count=%s\n' "$entry_count" "$failure_count"
        if (( failure_count != 0 )); then
          echo 'manifest_status=failed'
          return 1
        fi
        echo 'manifest_status=verified'
      }

      #@MNX-PART id=40.22.mnx-bundle-manifest.function.create_manifest kind=function title="Function create_manifest"
      create_manifest() {
        local dir="$1"
        local depth="''${2:-2}"
        local parent tmp
        [[ "$depth" =~ ^[1-9][0-9]*$ ]] || { echo "invalid max depth: $depth" >&2; return 64; }
        [[ -d "$dir" && ! -L "$dir" ]] || { echo "invalid bundle directory: $dir" >&2; return 66; }
        dir="$(readlink -f "$dir")"
        parent="$(dirname "$dir")"
        tmp="$(mktemp "$parent/.SHA256SUMS.XXXXXX")"
        trap 'rm -f "$tmp"' RETURN
        while IFS= read -r -d "" candidate; do
          if [[ "$candidate" == *\\* || "$candidate" == *$'\r'* || "$candidate" == *$'\n'* ]]; then
            printf 'refusing unsafe evidence filename: %q\n' "$candidate" >&2
            return 1
          fi
        done < <(cd "$dir" && find . -maxdepth "$depth" -type f ! -name SHA256SUMS -print0)
        (
          cd "$dir"
          find . -maxdepth "$depth" -type f ! -name SHA256SUMS -print0 |
            sort -z |
            xargs -0 -r sha256sum --
        ) > "$tmp"
        [[ -s "$tmp" ]] || { echo "refusing empty manifest for $dir" >&2; return 1; }
        if [[ ''${EUID:-$(id -u)} -eq 0 ]]; then
          chown root:logbook "$tmp" 2>/dev/null || chown root:root "$tmp"
        fi
        chmod 0640 "$tmp"
        mv -f "$tmp" "$dir/SHA256SUMS"
        trap - RETURN
        verify_manifest "$dir"
        printf 'manifest=%s\nmanifest_status=verified\n' "$dir/SHA256SUMS"
      }

      case "''${1:-help}" in
        create)
          [[ $# -ge 2 && $# -le 3 ]] || { usage >&2; exit 64; }
          create_manifest "$2" "''${3:-2}"
          ;;
        verify)
          [[ $# -eq 2 ]] || { usage >&2; exit 64; }
          verify_manifest "$2"
          ;;
        self-test)
          TEST_ROOT="$(mktemp -d)"
          trap 'rm -rf "$TEST_ROOT"' EXIT
          mkdir -p "$TEST_ROOT/bundle/sub"
          printf 'alpha\n' > "$TEST_ROOT/bundle/a.txt"
          printf 'beta\n' > "$TEST_ROOT/bundle/sub/b.txt"
          create_manifest "$TEST_ROOT/bundle" 2 >/dev/null
          cp "$TEST_ROOT/bundle/SHA256SUMS" "$TEST_ROOT/good.manifest"
          if grep -Fq ' SHA256SUMS' "$TEST_ROOT/bundle/SHA256SUMS"; then
            echo 'manifest hashed itself' >&2
            exit 1
          fi
          verify_manifest "$TEST_ROOT/bundle" >/dev/null
          printf 'changed\n' >> "$TEST_ROOT/bundle/a.txt"
          if verify_manifest "$TEST_ROOT/bundle" >/dev/null 2>&1; then
            echo 'modified bundle incorrectly verified' >&2
            exit 1
          fi
          printf 'alpha\n' > "$TEST_ROOT/bundle/a.txt"
          cp "$TEST_ROOT/good.manifest" "$TEST_ROOT/bundle/SHA256SUMS"
          printf 'outside\n' > "$TEST_ROOT/outside.txt"
          OUTSIDE_HASH_LINE="$(sha256sum -- "$TEST_ROOT/outside.txt")"
          OUTSIDE_HASH="''${OUTSIDE_HASH_LINE%% *}"
          [[ "$OUTSIDE_HASH" =~ ^[0-9a-f]{64}$ ]] || { echo 'self-test could not hash outside fixture' >&2; exit 1; }
          printf '%s  ../../outside.txt\n' "$OUTSIDE_HASH" >> "$TEST_ROOT/bundle/SHA256SUMS"
          if verify_manifest "$TEST_ROOT/bundle" >/dev/null 2>&1; then
            echo 'escaping manifest path incorrectly verified' >&2
            exit 1
          fi
          cp "$TEST_ROOT/good.manifest" "$TEST_ROOT/bundle/SHA256SUMS"
          ln -s a.txt "$TEST_ROOT/bundle/link.txt"
          LINK_HASH_LINE="$(sha256sum -- "$TEST_ROOT/bundle/a.txt")"
          LINK_HASH="''${LINK_HASH_LINE%% *}"
          [[ "$LINK_HASH" =~ ^[0-9a-f]{64}$ ]] || { echo 'self-test could not hash symlink fixture target' >&2; exit 1; }
          printf '%s  ./link.txt\n' "$LINK_HASH" >> "$TEST_ROOT/bundle/SHA256SUMS"
          if verify_manifest "$TEST_ROOT/bundle" >/dev/null 2>&1; then
            echo 'symlink manifest path incorrectly verified' >&2
            exit 1
          fi
          rm -f "$TEST_ROOT/bundle/link.txt"
          cp "$TEST_ROOT/good.manifest" "$TEST_ROOT/bundle/SHA256SUMS"
          head -n 1 "$TEST_ROOT/good.manifest" >> "$TEST_ROOT/bundle/SHA256SUMS"
          if verify_manifest "$TEST_ROOT/bundle" >/dev/null 2>&1; then
            echo 'duplicate manifest path incorrectly verified' >&2
            exit 1
          fi
          echo 'MNX_BUNDLE_MANIFEST_CONTAINMENT_SELF_TEST=PASS'
          echo 'MNX_BUNDLE_MANIFEST_SELF_TEST=PASS'
          ;;
        help|-h|--help)
          usage
          ;;
        *)
          usage >&2
          exit 64
          ;;
      esac
      '';
      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        case "$first" in
