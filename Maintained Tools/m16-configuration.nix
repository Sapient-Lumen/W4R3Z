      #@MNX-PART id=99.08.mnx-office.function.restore-residue-identity kind=function title="Python function restore_residue_identity"
      def restore_residue_identity(info: os.stat_result, *, contents: bool = False) -> tuple[int, ...]:
          fields = (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid, info.st_nlink)
          return fields + ((info.st_mtime_ns, info.st_ctime_ns) if contents else ())


      #@MNX-PART id=99.08.mnx-office.function.restore-residue-mount kind=function title="Python function restore_residue_mount"
      def restore_residue_mount(fd: int, path: Path) -> tuple[int, str]:
          # Both the live exact mountpoint and the held directory descriptor must name
          # the configured Btrfs filesystem. A missing mount is never an empty inventory.
          command = ["${pkgs.util-linux}/bin/findmnt", "--kernel", "--mountpoint", str(path),
                     "--json", "--output", "ID,TARGET,FSTYPE,UUID"]
          completed = subprocess.run(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL, timeout=10, check=False,
                                     env={"LC_ALL": "C", "PATH": "${pkgs.util-linux}/bin"})
          if completed.returncode != 0:
              raise ValueError("mount unavailable")
          return restore_residue_parse_mount(completed.stdout, restore_residue_fdinfo(fd), path)


      #@MNX-PART id=99.08.mnx-office.function.restore-residue-fdinfo kind=function title="Python function restore_residue_fdinfo"
      def restore_residue_fdinfo(fd: int) -> bytes:
          with open("/proc/self/fdinfo/" + str(fd), "rb") as stream:
              info = stream.read(4097)
          if len(info) > 4096 or len(re.findall(rb"(?m)^mnt_id:\s*([0-9]+)$", info)) != 1:
              raise ValueError("invalid descriptor mount information")
          return info


      #@MNX-PART id=99.08.mnx-office.function.restore-residue-parse-mount kind=function title="Python function restore_residue_parse_mount"
      def restore_residue_parse_mount(raw: bytes, descriptor_info: bytes, path: Path) -> tuple[int, str]:
          if len(raw) > 8192 or len(descriptor_info) > 4096:
              raise ValueError("mount metadata exceeds bound")
          document = json.loads(raw, object_pairs_hook=recovery_unique_pairs)
          if not isinstance(document, dict):
              raise ValueError("invalid mount document")
          rows = document.get("filesystems")
          if not isinstance(rows, list) or len(rows) != 1 or not isinstance(rows[0], dict):
              raise ValueError("mount ambiguous")
          row = rows[0]
          expected = "${lib.removePrefix "/dev/disk/by-uuid/" config.fileSystems."/mnt/m16-new-storage".device}"
          if (row.get("target") != str(path) or row.get("fstype") != "btrfs" or
                  row.get("uuid") != expected or isinstance(row.get("id"), bool) or
                  re.fullmatch(r"[1-9][0-9]{0,19}", str(row.get("id"))) is None):
              raise ValueError("mount identity differs")
          ids = re.findall(rb"(?m)^mnt_id:\s*([0-9]+)$", descriptor_info)
          if len(ids) != 1 or int(ids[0]) != int(row["id"]):
              raise ValueError("descriptor mount differs")
          return (int(ids[0]), expected)



      # Nix-owned operator identity; never inferred from the directory being inspected.
      RESTORE_RESIDUE_OPERATOR_UID = int("${toString config.users.users.h0p3.uid}")

      #@MNX-PART id=99.08.mnx-office.function.restore-residue-directory-observation kind=function title="Python function restore_residue_directory_observation"
      def restore_residue_directory_observation(info: os.stat_result, component: str, uid: int) -> dict[str, Any]:
          # Only these literal administrative components may enter public evidence.
          # This is a no-follow metadata sample, not a trusted inventory or a chmod request.
          if component not in ("/", "mnt", "m16-new-storage", "admin", "restore-tests"):
              raise ValueError("unsupported diagnostic component")
          kind = ("directory" if stat.S_ISDIR(info.st_mode) else
                  "symlink" if stat.S_ISLNK(info.st_mode) else
                  "regular-file" if stat.S_ISREG(info.st_mode) else "other")
          # Shared storage ancestors are not root evidence publications. Only the
          # named operator may additionally own these two exact transit directories.
          # The restore area itself and the system anchors retain root-only policy.
          allowed = sorted({uid, RESTORE_RESIDUE_OPERATOR_UID}) if component in ("m16-new-storage", "admin") else [uid]
          return {"component": component, "kind": kind, "uid": info.st_uid, "gid": info.st_gid,
                  "mode": format(stat.S_IMODE(info.st_mode), "04o"), "allowed_owner_uids": allowed,
                  "owner_matches": info.st_uid in allowed, "write_mask_clear": not bool(info.st_mode & 0o022),
                  "opened_identity_matches": None}


      #@MNX-PART id=99.08.mnx-office.function.health-restore-residue kind=function title="Python function health_restore_residue"
      def health_restore_residue(root: Path, uid: int, now: int, recovery: dict[str, Any], *,
                                 mount_probe: Any = None, after_scan: Any = None) -> dict[str, Any]:
          """Inspect only immediate restore-test entries. Presence is not deletion authority.

          No restored child directory or file is opened. Unknown names are not exported.
          The historical witness and this live metadata observation remain distinct.
          Two matching bounded enumerations are not an atomic filesystem snapshot;
          transient changes that revert between observations are not excluded.
          Test injection is a Python-only interface, never a CLI or environment override.
          """
          import errno

          mount_path = root / "mnt/m16-new-storage"
          area = "/mnt/m16-new-storage/admin/restore-tests"
          result: dict[str, Any] = {
              "schema": "mnx.restic.local-residue.v1", "state": "unavailable", "observed_epoch": now,
              "scope": "m16-disposable-restore-area-immediate-entries-only", "area": area,
              "mount_verified": False, "scan_complete": False, "entry_limit": 128,
              "entry_count": None, "unrecognized_entry_count": None, "entries": [],
              "qualified_run": None, "qualified_target_state": "unknown",
              "qualified_target_absent_now": None, "cleanup_receipt_contradicted_now": None,
              "directory_metadata_read": False, "restored_content_read": False,
              "repository_data_read": False, "credentials_read": False, "network_used": False,
              "remote_residue_inventoried": False, "whole_machine_coverage_proven": False,
              "state_mutated": False, "deletion_authorized": False,
              "all_historical_residue_removed": False,
              "directory_diagnostics": {"schema": "mnx.restic.directory-diagnostics.v2",
                  "metadata_basis": "nofollow-stat-then-descriptor-identity",
                  "default_owner_uid": uid, "operator_owner_uid": RESTORE_RESIDUE_OPERATOR_UID,
                  "operator_owned_components": ["m16-new-storage", "admin"],
                  "authority": "metadata-observation-not-root-exclusive-provenance",
                  "forbidden_write_mask": "0022", "policy_changed": True,
                  "components": [], "failure": None},
          }
          run = recovery.get("qualification_run")
          trusted = (recovery.get("historical_qualification_verified") is True and isinstance(run, str) and
                     re.fullmatch(r"[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}", run) is not None and
                     recovery.get("cleanup", {}).get("disposable_restore_absence_recorded") is True)
          if trusted:
              result["qualified_run"] = run
          else:
              run = None
          if root != Path("/") and mount_probe is None:
              result["issue"] = "fixture-mount-not-observed"
              return result
          probe = restore_residue_mount if mount_probe is None else mount_probe
          opened: list[int] = []
          anchors: list[tuple[int, str, int, tuple[int, ...]]] = []
          member_identities: dict[str, tuple[int, ...]] = {}
          missing: tuple[int, str, tuple[int, ...]] | None = None
          mount_fd = -1
          scan_fd = -1
          stage = "directory-chain"
          diagnostics = result["directory_diagnostics"]
          component = "/"
          operation = "metadata-stat"
          reason = "observation-rejected"
          try:
              # O_NOATIME avoids turning an inventory into access-time writes. No
              # fallback silently drops it when the caller lacks sufficient ownership.
              flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NOATIME
              root_info = root.lstat()
              observation = restore_residue_directory_observation(root_info, component, uid)
              diagnostics["components"].append(observation)
              result["directory_metadata_read"] = True
              operation = "directory-policy"
              reason = ("not-directory" if observation["kind"] != "directory" else
                        "owner-mismatch" if not observation["owner_matches"] else
                        "write-permissions" if not observation["write_mask_clear"] else "observation-rejected")
              if reason != "observation-rejected":
                  raise ValueError("directory policy refused")
              operation = "directory-open"
              parent = os.open(root, flags)
              opened.append(parent)
              operation = "descriptor-stat"
              observation["opened_identity_matches"] = restore_residue_identity(os.fstat(parent)) == restore_residue_identity(root_info)
              if not observation["opened_identity_matches"]:
                  reason = "directory-identity-changed"
                  raise ValueError("root changed while opening")
              root_identity = restore_residue_identity(root_info)
              mount_identity = None
              for component in ("mnt", "m16-new-storage", "admin", "restore-tests"):
                  stage = "directory-" + component
                  operation = "metadata-stat"
                  reason = "observation-rejected"
                  before_parent = os.fstat(parent)
                  try:
                      info = os.stat(component, dir_fd=parent, follow_symlinks=False)
                  except FileNotFoundError:
                      if mount_fd < 0:
                          reason = "mount-directory-absent"
                          raise ValueError("mount directory absent")
                      missing = (parent, component, restore_residue_identity(before_parent, contents=True))
                      break
                  observation = restore_residue_directory_observation(info, component, uid)
                  diagnostics["components"].append(observation)
                  operation = "directory-policy"
                  reason = ("not-directory" if observation["kind"] != "directory" else
                            "owner-mismatch" if not observation["owner_matches"] else
                            "write-permissions" if not observation["write_mask_clear"] else "observation-rejected")
                  if reason != "observation-rejected":
                      raise ValueError("directory policy refused")
                  operation = "directory-open"
                  child = os.open(component, flags, dir_fd=parent)
                  opened.append(child)
                  operation = "descriptor-stat"
                  observation["opened_identity_matches"] = restore_residue_identity(os.fstat(child)) == restore_residue_identity(info)
                  if not observation["opened_identity_matches"]:
                      reason = "directory-identity-changed"
                      raise ValueError("directory changed while opening")
                  anchors.append((parent, component, child, restore_residue_identity(info)))
                  if component == "m16-new-storage":
                      mount_fd = child
                      stage = operation = "mount-identity"
                      mount_identity = probe(mount_fd, mount_path)
                      result["mount_identity_checked_before"] = True
                      result["mount_id"] = mount_identity[0]
                      result["filesystem_uuid"] = mount_identity[1]
                      stage = "directory-chain"
                  if mount_fd >= 0:
                      operation = "descriptor-mount"
                      child_mount = re.findall(rb"(?m)^mnt_id:\s*([0-9]+)$", restore_residue_fdinfo(child))
                      if int(child_mount[0]) != mount_identity[0]:
                          raise ValueError("nested mount shadows restore area")
                  parent = child
              component = None
              operation = "entry-scan"
              result["directory_metadata_read"] = True
              rows = []
              unknown = 0
              count = 0
              target_state = "absent" if trusted else "unknown"
              if missing is None:
                  scan_fd = parent
                  scan_before = restore_residue_identity(os.fstat(scan_fd), contents=True)
                  stage = "immediate-entry-scan"
                  with os.scandir(scan_fd) as entries:
                      for entry in entries:
                          count += 1
                          if count > 128:
                              raise ValueError("entry bound exceeded")
                          if entry.name in member_identities:
                              raise ValueError("duplicate directory entry")
                          info = os.stat(entry.name, dir_fd=scan_fd, follow_symlinks=False)
                          member_identities[entry.name] = restore_residue_identity(info, contents=True)
                          kind = ("directory" if stat.S_ISDIR(info.st_mode) else
                                  "regular-file" if stat.S_ISREG(info.st_mode) else
                                  "symlink" if stat.S_ISLNK(info.st_mode) else "special")
                          if entry.name == run:
                              target_state = "present-" + kind
                          if re.fullmatch(r"[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}", entry.name):
                              rows.append({"run": entry.name, "kind": kind, "uid": info.st_uid,
                                           "gid": info.st_gid, "mode": format(stat.S_IMODE(info.st_mode), "04o"),
                                           "mtime_ns": info.st_mtime_ns,
                                           "classification": "present-not-proven-abandoned"})
                          else:
                              unknown += 1
              if after_scan is not None:
                  after_scan()
              if missing is None:
                  stage = operation = "entry-set-recheck"
                  # Directory times can remain equal across rapid membership changes.
                  # Reopen the SAME directory for an independent cursor, not its path
                  # or a restored child, and compare both names and no-follow metadata.
                  # O_NOATIME and the 128-entry limit apply to both enumerations.
                  recheck_fd = os.open(".", flags, dir_fd=scan_fd)
                  opened.append(recheck_fd)
                  if restore_residue_identity(os.fstat(recheck_fd), contents=True) != scan_before:
                      raise ValueError("recheck directory changed")
                  rechecked: set[str] = set()
                  with os.scandir(recheck_fd) as entries:
                      for entry in entries:
                          if len(rechecked) >= 128 or entry.name in rechecked:
                              raise ValueError("recheck entry bound or uniqueness failed")
                          rechecked.add(entry.name)
                          info = os.stat(entry.name, dir_fd=recheck_fd, follow_symlinks=False)
                          if restore_residue_identity(info, contents=True) != member_identities.get(entry.name):
                              raise ValueError("recheck membership or entry changed")
                  if rechecked != set(member_identities):
                      raise ValueError("recheck membership differs")
              stage = operation = "observation-stability"
              if restore_residue_identity(root.lstat()) != root_identity:
                  raise ValueError("root changed")
              for parent_fd, name, child_fd, identity in anchors:
                  if (restore_residue_identity(os.fstat(child_fd)) != identity or
                          restore_residue_identity(os.stat(name, dir_fd=parent_fd, follow_symlinks=False)) != identity):
                      raise ValueError("directory changed")
              if missing is not None:
                  parent_fd, name, identity = missing
                  if restore_residue_identity(os.fstat(parent_fd), contents=True) != identity:
                      raise ValueError("missing parent changed")
                  try:
                      os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
                  except FileNotFoundError:
                      pass
                  else:
                      raise ValueError("missing entry appeared")
              else:
                  if restore_residue_identity(os.fstat(scan_fd), contents=True) != scan_before:
                      raise ValueError("inventory changed")
                  for name, identity in member_identities.items():
                      if restore_residue_identity(os.stat(name, dir_fd=scan_fd, follow_symlinks=False), contents=True) != identity:
                          raise ValueError("entry changed")
              stage = operation = "mount-stability"
              if mount_fd < 0 or probe(mount_fd, mount_path) != mount_identity:
                  raise ValueError("mount changed")
              result.update(state=("area-absent" if missing else "empty" if count == 0 else "entries-present"),
                            scan_complete=True, mount_verified=True, entry_count=count, unrecognized_entry_count=unknown,
                            entries=sorted(rows, key=lambda row: row["run"]), qualified_target_state=target_state,
                            qualified_target_absent_now=(target_state == "absent") if trusted else None,
                            cleanup_receipt_contradicted_now=(target_state != "absent") if trusted else None)
          except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError) as exc:
              # Numeric errno and fixed classifications only: exception messages may
              # contain private names, link targets, or child output and are NEVER exported.
              code = exc.errno if isinstance(exc, OSError) and type(exc.errno) is int and 0 < exc.errno < 4096 else None
              if isinstance(exc, OSError):
                  reason = "os-error"
              elif isinstance(exc, subprocess.TimeoutExpired):
                  reason = "subprocess-timeout"
              elif isinstance(exc, subprocess.SubprocessError):
                  reason = "subprocess-error"
              diagnostics["failure"] = {"component": component, "operation": operation, "reason": reason,
                                         "errno": code, "errno_name": errno.errorcode.get(code, "UNKNOWN") if code else None}
              result.update(state="review-required", issue=stage, scan_complete=False)
          finally:
              for fd in reversed(opened):
                  os.close(fd)
          return result


      #@MNX-PART id=99.08.mnx-office.function.restore-residue-self-test kind=function title="Python function restore_residue_self_test"
