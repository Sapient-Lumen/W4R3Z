      #@MNX-PART id=99.20.mnx-switch.function.exact_activate kind=function title="Function exact_activate"
      exact_activate() {
        local tested="$1"
        local nix_env="''${MNX_SWITCH_NIX_ENV:-${pkgs.nix}/bin/nix-env}"
        local profile_rc=0
        local activation_rc=not-run

        [[ -n "$tested" && -x "$tested/bin/switch-to-configuration" ]] || {
          echo "mnx_profile_set_rc=not-run"
          echo "mnx_switch_to_configuration_rc=not-run"
          echo "exact tested closure is unusable: $tested" >&2
          return 1
        }

        set +e
        "$nix_env" --profile /nix/var/nix/profiles/system --set "$tested"
        profile_rc=$?
        set -e
        echo "mnx_profile_set_rc=$profile_rc"
        if (( profile_rc != 0 )); then
          echo "mnx_switch_to_configuration_rc=not-run"
          return "$profile_rc"
        fi

        set +e
        "$tested/bin/switch-to-configuration" switch
        activation_rc=$?
        set -e
        echo "mnx_switch_to_configuration_rc=$activation_rc"
        return "$activation_rc"
      }

