        ${pkgs.gnugrep}/bin/grep -Fq -- '--presslog-create-thumbdrive-create' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'pinentry_environment' "$out"
        ! ${pkgs.gnugrep}/bin/grep -Fq 'PRESSLOG_PASSWORD=' "$out"
