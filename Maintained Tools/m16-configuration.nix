      checkPhase = ''
        set -Eeuo pipefail
        first="$(${pkgs.coreutils}/bin/head -n 1 "$out")"
        expected='#!${pkgs.python3}/bin/python3'
        if [[ "$first" != "$expected" ]]; then
          printf 'MNX_EXPOSURE_INTERPRETER_ERROR: expected=%s actual=%s\n' "$expected" "$first" >&2
          exit 1
        fi
        interpreter="''${first#\#!}"
        [[ -x "$interpreter" ]] || {
          printf 'MNX_EXPOSURE_INTERPRETER_ERROR: interpreter is not executable: %s\n' "$interpreter" >&2
          exit 1
        }
        printf 'MNX_EXPOSURE_INTERPRETER_SELF_TEST=PASS\n'
        rpcinfo_expected='${pkgs.rpcbind}/bin/rpcinfo'
        [[ -x "$rpcinfo_expected" ]] || {
          printf 'MNX_EXPOSURE_RPCINFO_ERROR: rpcinfo is not executable: %s\n' "$rpcinfo_expected" >&2
          exit 1
        }
        ${pkgs.gnugrep}/bin/grep -Fq "RPCINFO = pathlib.Path(\"$rpcinfo_expected\")" "$out" || {
          printf 'MNX_EXPOSURE_RPCINFO_ERROR: generated program lacks the evaluated rpcinfo path\n' >&2
          exit 1
        }
        printf 'MNX_EXPOSURE_RPCINFO_EXECUTABLE_SELF_TEST=PASS\n'
        case "$first" in
          '#!'*python*)
            ${pkgs.python3}/bin/python3 -c 'import pathlib,sys; source=pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"); compile(source, sys.argv[1], "exec")' "$out"
            self_test_output="$TMPDIR/mnx-exposure-self-test.txt"
            "$out" self-test | ${pkgs.coreutils}/bin/tee "$self_test_output"
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_EXPOSURE_CANONICAL_ENDPOINT_SELF_TEST=PASS' "$self_test_output"
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_EXPOSURE_MULTI_OWNER_POLICY_SELF_TEST=PASS' "$self_test_output"
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_EXPOSURE_RPC_ATTRIBUTION_SELF_TEST=PASS' "$self_test_output"
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_EXPOSURE_RPCINFO_PATH_SELF_TEST=PASS' "$self_test_output"
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_EXPOSURE_RPCINFO_DUAL_STACK_SELF_TEST=PASS' "$self_test_output"
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_EXPOSURE_MAPPED_IPV4_INTERFACE_SELF_TEST=PASS' "$self_test_output"
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_EXPOSURE_ZONE_MODEL_SELF_TEST=PASS' "$self_test_output"
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_EXPOSURE_BUILD_SANDBOX_SELF_TEST=PASS' "$self_test_output"
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_EXPOSURE_MANAGED_DIRECTORY_SELF_TEST=PASS' "$self_test_output"
            ${pkgs.gnugrep}/bin/grep -Fxq 'MNX_EXPOSURE_SELF_TEST=PASS' "$self_test_output"
            ;;
          *) echo "unexpected exposure-program interpreter: $first" >&2; exit 1 ;;
        esac
      '';
