      #@MNX-PART id=40.31.mnx-exposure.function.secure-directory kind=function title="Python function secure_directory"
      def secure_directory(path: pathlib.Path, mode: int, *, root_required: bool) -> None:
          if not path.exists() and not path.is_symlink():
              if root_required:
                  raise ExposureError(
                      f"managed directory is missing: {path}; systemd-tmpfiles must create it before capture"
                  )
              try:
                  path.mkdir(parents=True, exist_ok=True)
              except OSError as exc:
                  raise ExposureError(f"cannot create directory {path}: {exc}") from exc
          try:
              info = path.lstat()
          except OSError as exc:
              raise ExposureError(f"cannot stat directory {path}: {exc}") from exc
          if path.is_symlink() or not stat.S_ISDIR(info.st_mode):
              raise ExposureError(f"directory path is unsafe or not a directory: {path}")
          actual_mode = stat.S_IMODE(info.st_mode)
          if root_required:
              expected_gid = logbook_gid()
              if info.st_uid != 0 or info.st_gid != expected_gid or actual_mode != mode:
                  raise ExposureError(
                      "managed directory metadata mismatch: "
                      f"path={path} actual_uid={info.st_uid} actual_gid={info.st_gid} "
                      f"actual_mode={actual_mode:04o} expected_uid=0 expected_gid={expected_gid} "
                      f"expected_mode={mode:04o}; repair is declarative through systemd-tmpfiles"
                  )
              return
          if actual_mode != mode:
              try:
                  os.chmod(path, mode)
              except OSError as exc:
                  raise ExposureError(f"cannot set directory mode on {path}: {exc}") from exc
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.atomic-write kind=function title="Python function atomic_write"
      def atomic_write(path: pathlib.Path, data: bytes, mode: int, *, root_required: bool) -> None:
          path.parent.mkdir(parents=True, exist_ok=True)
          fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
          temporary_path = pathlib.Path(temporary)
          try:
              with os.fdopen(fd, "wb") as handle:
                  handle.write(data)
                  handle.flush()
                  os.fsync(handle.fileno())
              if root_required:
                  os.chown(temporary_path, 0, logbook_gid())
              os.chmod(temporary_path, mode)
              os.replace(temporary_path, path)
          finally:
              temporary_path.unlink(missing_ok=True)
                  
                  
      #@MNX-PART id=40.31.mnx-exposure.function.tsv-bytes kind=function title="Python function tsv_bytes"
      def tsv_bytes(listeners: list[dict[str, Any]], *, stable_only: bool) -> bytes:
          lines = [
              "endpoint_id\tattribution_id\tproto\taddress_class\tlocal_address\tport\tinterfaces\tnetns\towner_count\towners\tpolicy_status\tpolicy_id\tdisposition\tintent\tzone\tzone_status\tvolatility\tpersistence\tseen_count\traw_rows"
          ]
          for listener in listeners:
              if stable_only and not listener["stable"]:
                  continue
              owner_values: list[str] = []
              for owner in listener.get("owners", []):
                  owner_values.append(
                      "|".join(
                          str(value).replace("\t", " ").replace("\n", " ").replace("\r", " ")
                          for value in (
                              owner.get("uid", "unknown"), owner.get("unit", "unknown"), owner.get("comm", "unknown"),
                              owner.get("package", "unknown"), owner.get("executable_id", "unknown"), owner.get("cgroup", "unknown"),
                          )
                      )
                  )
              fields = [
                  listener["endpoint_id"], listener["attribution_id"], listener["protocol"], listener["address_class"],
                  listener["local_address"], str(listener["local_port"]), ",".join(listener.get("interfaces", [])) or "unknown",
                  ",".join(listener.get("netns_classes", [])) or "unknown", str(len(listener.get("owners", []))),
                  ";".join(owner_values) or "unknown", listener["policy_status"], listener["policy_id"],
                  listener["disposition"], listener["intent"], listener["zone"], listener["zone_status"],
                  listener.get("volatility", "dynamic"), listener.get("persistence", "new"),
                  str(listener.get("seen_count", 0)), str(listener.get("raw_row_count", 1)),
              ]
              lines.append("\t".join(field.replace("\t", " ").replace("\n", " ").replace("\r", " ") for field in fields))
          return ("\n".join(lines) + "\n").encode("utf-8")
            
            
      #@MNX-PART id=40.31.mnx-exposure.function.review-tsv-bytes kind=function title="Python function review_tsv_bytes"
      def review_tsv_bytes(groups: list[dict[str, Any]]) -> bytes:
          lines = [
              "group_id\tendpoint_count\tunit\tprocess\tpackage\tpolicy_status\tpolicy_id\tdisposition\tintent\tzone\tzone_status\tvolatility\treasons\tprotocols\tports\taddress_classes\tinterfaces\tpersistence"
          ]
          for group in groups:
              fields = [
                  group["group_id"], str(group["endpoint_count"]), group["unit"], group["process"], group["package"],
                  group["policy_status"], group["policy_id"], group["disposition"], group["intent"], group["zone"],
                  group["zone_status"], group["volatility"], ",".join(group["reasons"]), ",".join(group["protocols"]),
                  ",".join(str(port) for port in group["ports"]), ",".join(group["address_classes"]),
                  ",".join(group["interfaces"]), ",".join(group["persistence"]),
              ]
              lines.append("\t".join(field.replace("\t", " ").replace("\n", " ").replace("\r", " ") for field in fields))
          return ("\n".join(lines) + "\n").encode("utf-8")
            
      #@MNX-PART id=40.31.mnx-exposure.function.render-report kind=function title="Python function render_report"
      def render_report(observation: dict[str, Any], raw_ss: str, auxiliary: list[tuple[str, str]]) -> bytes:
          summary = summarize(observation)
          lines = [
              f"=== MONSTERNIX EXPOSURE CENSUS ({observation['observed_at']}) ===",
              f"source_sha256={observation['source_sha256']}", f"policy_sha256={observation['policy_sha256']}",
              f"mode={observation['mode']}", f"policy_mode={observation['policy_mode']}",
              f"default_disposition={observation['default_disposition']}", f"boot_id={observation['boot_id']}",
              f"system={observation['system']}",
              f"ephemeral_udp_range={observation['ephemeral_udp_range'][0]}-{observation['ephemeral_udp_range'][1]}",
              f"ledger_bootstrap={observation.get('ledger_bootstrap', 'unknown')}", "", "== summary ==",
          ]
          for key, value in summary.items():
              lines.append(f"{key}={value}")
          lines.extend(["", "== canonical stable listener endpoints =="])
          lines.append(tsv_bytes(observation["listeners"], stable_only=True).decode("utf-8").rstrip())
          lines.extend(["", "== grouped review ledger =="])
          lines.append(review_tsv_bytes(observation.get("review_groups", [])).decode("utf-8").rstrip())
          lines.extend(["", "== raw ss -H -lntup ==", raw_ss.rstrip()])
          for title, value in auxiliary:
              lines.extend(["", f"== {title} ==", value.rstrip()])
          lines.append("")
          data = ("\n".join(lines) + "\n").encode("utf-8")
          if len(data) > MAX_OUTPUT_BYTES:
              data = data[: MAX_OUTPUT_BYTES - 64] + b"\nTRUNCATED_BY_MNX_EXPOSURE=yes\n"
          return data
            
      #@MNX-PART id=40.31.mnx-exposure.function.prometheus-bytes kind=function title="Python function prometheus_bytes"
