      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.atomic-write kind=function title="Portable Python function atomic_write"
      def atomic_write(path: Path, payload: bytes, mode: int = 0o600) -> None:
          parent = path.parent
          if not parent.is_dir() or parent.is_symlink():
              raise Error(f'atomic-write parent is unsafe: {parent}')
          if path.exists() and path.is_symlink():
              raise Error(f'atomic-write target is a symlink: {path}')
          handle, temporary_name = tempfile.mkstemp(prefix=f'.{path.name}.', dir=str(parent))
          temporary = Path(temporary_name)
          try:
              with os.fdopen(handle, 'wb') as stream:
                  stream.write(payload)
                  stream.flush()
                  os.fsync(stream.fileno())
              os.chmod(temporary, mode)
              os.replace(temporary, path)
              directory_fd = os.open(parent, os.O_RDONLY)
              try:
                  os.fsync(directory_fd)
              finally:
                  os.close(directory_fd)
          except Exception:
              temporary.unlink(missing_ok=True)
              raise
      
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.stable-regular-bytes kind=function title="Portable Python function stable_regular_bytes"
      def stable_regular_bytes(path: Path, maximum: int, label: str) -> bytes:
          try:
              before=path.lstat()
          except OSError as exc:
              raise Error(f'{label} unavailable: {path}: {exc}') from exc
          if stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode):
              raise Error(f'{label} is not a non-symlink regular file: {path}')
          if before.st_size>maximum:
              raise Error(f'{label} exceeds {maximum} bytes: {before.st_size}')
          with path.open('rb') as stream:
              raw=stream.read(maximum+1)
          after=path.lstat()
          identity=lambda value:(value.st_dev,value.st_ino,value.st_size,value.st_mtime_ns,value.st_mode)
          if len(raw)>maximum or identity(before)!=identity(after) or len(raw)!=after.st_size:
              raise Error(f'{label} changed or exceeded its bound while reading: {path}')
          return raw
      
