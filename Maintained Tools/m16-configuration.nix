      #@MNX-PART id=99.91.mnx-presslog-observe.function.expected-identity kind=function title="Python function expected_identity"
      def expected_identity() -> tuple[int, int]:
          entry = pwd.getpwnam(EXPECTED_USER)
          if entry.pw_uid != EXPECTED_UID:
              raise ObserverError(f'{EXPECTED_USER} uid differs: {entry.pw_uid}')
