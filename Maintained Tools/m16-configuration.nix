      #@MNX-PART id=99.60.mnx-refactor.planner.function.cloudtainer-run-portable-candidate kind=function title="Python function cloudtainer_run_portable_candidate"
      def cloudtainer_run_portable_candidate(config: Path, arguments: list[str]) -> int:
          if '--source' in arguments:
              raise PlannerError('host cloudtainer candidate route binds the accepted source and rejects --source override')
          with tempfile.TemporaryDirectory(prefix='mnx-cloudtainer-candidate-route.') as directory:
              helper = Path(directory) / 'mnx-cloudtainer'
              helper.write_text(CLOUDTAINER_PORTABLE_SOURCE, encoding='utf-8')
              os.chmod(helper, 0o700)
              command = [sys.executable, str(helper), 'candidate', *arguments, '--source', str(config)]
              completed = subprocess.run(command, timeout=1800, check=False)
              return completed.returncode
      
