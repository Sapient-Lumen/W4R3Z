#@MNX-FLOW id=journal-integrity-observation kind=health title="Closed journal archives and queryable active streams to retained evidence and clean-forward state" source="closed archived journal files verified individually, active journal files identity-stabilized and query-tested without --verify, bounded natural-rotation retries, natural one-day/64MiB checkpoints, immutable legacy anchor, exact reset receipt, and root-owned observer state" destination="manifested incident bundles, current schema-v4 state, root-published metrics, and mnx incident journal without live-verify false positives" defs='services.journald,environment.etc."systemd/journald@logbook.conf".text,environment.etc."monsternix/bin/mnx-journal-integrity",systemd.services.logbook-journal-verify,systemd.timers.logbook-journal-verify,environment.etc."monsternix/bin/mnx",environment.etc."monsternix/bin/mnx-switch"' programs="mnx-journal-integrity,mnx,mnx-switch" service=logbook-journal-verify.service timer=logbook-journal-verify.timer lock=none state="/var/lib/monsternix/journal-integrity/anchor.json,/var/lib/monsternix/journal-integrity/default-reset.json,/var/lib/monsternix/journal-integrity/current.json,/var/lib/logbook/incidents/journal-verify-*,/var/lib/node-exporter-textfile/monsternix_journal_integrity.prom" notes="Active journalctl --verify output is explicitly nonauthoritative because live-write races can report transient invalid-object errors. Archived files remain structurally verified; active files must remain queryable. No recurring deletion, vacuum, repair, network use, or anchor replacement is authorized."
