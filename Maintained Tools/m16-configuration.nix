      #@MNX-PART id=99.60.mnx-refactor.planner.function.cloudtainer-extract-capsule kind=function title="Python function cloudtainer_extract_capsule"
      def cloudtainer_extract_capsule(text: str) -> tuple[str, dict]:
          begin_re = re.compile(r'(?m)^#@MNX-AMNESIA-BEGIN schema=1 candidate_stage=([0-9]+) accepted_predecessor_stage=([0-9]+) accepted_predecessor_sha256=([0-9a-f]{64})$')
          begins = list(begin_re.finditer(text))
          ends = list(re.finditer(r'(?m)^#@MNX-AMNESIA-END$', text))
          if len(begins) != 1 or len(ends) != 1 or begins[0].start() >= ends[0].start():
              raise PlannerError('cloudtainer requires exactly one ordered amnesia capsule')
          start = begins[0].start()
          end = text.find('\n', ends[0].end())
          if end < 0:
              end = len(text)
          else:
              end += 1
          block = text[start:end]
          fields: dict[str, str] = {}
          for line in block.splitlines()[1:-1]:
              match = re.fullmatch(r'# (AUTHORITY|STATE|INTENT|OPEN|NEXT|HOLD|OPERATOR): (.+)', line)
              if not match:
                  raise PlannerError(f'malformed cloudtainer amnesia capsule line: {line}')
              if match.group(1) in fields:
                  raise PlannerError(f'duplicate cloudtainer amnesia capsule field: {match.group(1)}')
              fields[match.group(1)] = match.group(2)
          if tuple(fields) != CLOUDTAINER_FIELDS:
              raise PlannerError(f'cloudtainer capsule fields/order differ: {tuple(fields)}')
          marker = begins[0]
          metadata = {
              'schema': 1,
              'candidate_stage': int(marker.group(1)),
              'accepted_predecessor_stage': int(marker.group(2)),
              'accepted_predecessor_sha256': marker.group(3),
              'sha256': hashlib.sha256(block.encode('utf-8')).hexdigest(),
              'bytes': len(block.encode('utf-8')),
              'fields': fields,
          }
          return block, metadata
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.cloudtainer-extract-wake kind=function title="Python function cloudtainer_extract_wake"
      def cloudtainer_extract_wake(text: str) -> str:
          start = text.find('# WAKE FROM AMNESIA — CANONICAL OFFICE PROTOCOL')
          end = text.find('# EDITING CHATGPT TURN-CLOSE RULE', start + 1)
          if start < 0 or end < 0 or end <= start:
              raise PlannerError('cloudtainer wake protocol landmarks are missing')
          block = text[start:end].rstrip() + '\n'
          return '\n'.join(line[2:] if line.startswith('# ') else line[1:] if line == '#' else line for line in block.splitlines()) + '\n'
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.cloudtainer-office-agenda kind=function title="Python function cloudtainer_office_agenda"
      def cloudtainer_office_agenda(text: str) -> dict:
          matches = re.findall(r'(?m)^#@MNX-OFFICE ([a-z0-9_]+)=(.+)$', text)
          agenda: dict[str, str] = {}
          for key, value in matches:
              if key in agenda:
                  raise PlannerError(f'duplicate cloudtainer office field: {key}')
              agenda[key] = value
          required = {'candidate_stage','accepted_predecessor_stage','accepted_predecessor_sha256','stage_objective','after_acceptance_next_stage','after_acceptance_next_objective','deferred_stage','deferred_objective','closed_issue','operator_memory'}
          missing = sorted(required - set(agenda))
          if missing:
              raise PlannerError('cloudtainer office agenda is missing fields: ' + ','.join(missing))
          return agenda
      
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.cloudtainer-extract-history kind=function title="Python function cloudtainer_extract_history"
      def cloudtainer_extract_history(text: str) -> list[dict]:
          lines = text.splitlines()
          begins = [index for index, line in enumerate(lines) if line == '#@MNX-HISTORY-BEGIN schema=1 max_entries=8']
          ends = [index for index, line in enumerate(lines) if line == '#@MNX-HISTORY-END']
          if len(begins) != 1 or len(ends) != 1 or begins[0] >= ends[0]:
              raise PlannerError('cloudtainer requires exactly one ordered bounded history ledger')
          pattern = re.compile(r'^#@MNX-HISTORY stage=([1-9][0-9]*) source=([0-9a-f]{64}) closed=([a-z0-9]+(?:-[a-z0-9]+)*)$')
          history = []
          for line in lines[begins[0] + 1:ends[0]]:
              match = pattern.fullmatch(line)
              if not match:
                  raise PlannerError(f'malformed cloudtainer history line: {line}')
              history.append({'stage': int(match.group(1)), 'source_sha256': match.group(2), 'closed_issue': match.group(3)})
          if len(history) != 8:
              raise PlannerError(f'cloudtainer history must contain exactly eight entries: {len(history)}')
          stages = [item['stage'] for item in history]
          if stages != sorted(set(stages)):
              raise PlannerError('cloudtainer history stages are not unique and ascending')
          return history
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.cloudtainer-render-history kind=function title="Python function cloudtainer_render_history"
      def cloudtainer_render_history(history: list[dict]) -> str:
          return "".join(f"stage={item['stage']} source_sha256={item['source_sha256']} closed_issue={item['closed_issue']}\n" for item in history)
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.cloudtainer-turn-close-record kind=function title="Python function cloudtainer_turn_close_record"
      def cloudtainer_turn_close_record(config: Path, overrides: dict[str, str] | None = None) -> dict:
          source = read_port_source(config)
          _, capsule = cloudtainer_extract_capsule(source['text'])
          agenda = cloudtainer_office_agenda(source['text'])
          history = cloudtainer_extract_history(source['text'])
          if history[-1]['stage'] != capsule['accepted_predecessor_stage'] or history[-1]['source_sha256'] != capsule['accepted_predecessor_sha256']:
              raise PlannerError('cloudtainer history tail differs from candidate predecessor identity')
          fields = dict(capsule['fields'])
          next_stage = int(agenda['after_acceptance_next_stage'])
          fields['STATE'] = f"Accepted Stage {capsule['candidate_stage']} source {source['sha256']} is the exact predecessor; replace this sentence with finalized measured outcomes from the current turn."
          fields['INTENT'] = f"Replace with one compressed sentence describing candidate Stage {next_stage}."
          fields['NEXT'] = agenda['after_acceptance_next_objective'].replace('-', ' ')
          for key, value in (overrides or {}).items():
              if value:
                  fields[key] = value
          secret_re = re.compile(r'(-----BEGIN [A-Z ]*PRIVATE KEY-----|(?:password|passwd|token|api[_-]?key|authorization)\s*[:=])', re.I)
          for key in CLOUDTAINER_FIELDS:
              value = fields[key]
              if not value or len(value) > 1024 or '\n' in value or '\r' in value or secret_re.search(value):
                  raise PlannerError(f'cloudtainer turn-close field is unsafe or invalid: {key}')
          marker = f"#@MNX-AMNESIA-BEGIN schema=1 candidate_stage={next_stage} accepted_predecessor_stage={capsule['candidate_stage']} accepted_predecessor_sha256={source['sha256']}"
          block = '\n'.join([marker, *[f"# {key}: {fields[key]}" for key in CLOUDTAINER_FIELDS], '#@MNX-AMNESIA-END']) + '\n'
          next_history = [*history, {'stage': capsule['candidate_stage'], 'source_sha256': source['sha256'], 'closed_issue': agenda['closed_issue']}][-8:]
          ledger = '#@MNX-HISTORY-BEGIN schema=1 max_entries=8\n' + "".join(f"#@MNX-HISTORY stage={item['stage']} source={item['source_sha256']} closed={item['closed_issue']}\n" for item in next_history) + '#@MNX-HISTORY-END\n'
          return {'schema':'mnx.cloudtainer.turn-close.v1','cloudtainer_schema':CLOUDTAINER_SCHEMA,'status':'render-only','source_sha256':source['sha256'],'candidate_stage':next_stage,'accepted_predecessor_stage':capsule['candidate_stage'],'accepted_predecessor_sha256':source['sha256'],'capsule':block,'history_ledger':ledger,'recent_history':next_history,'network_used':False,'mutation':'none'}
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.cloudtainer-render-turn-close kind=function title="Python function cloudtainer_render_turn_close"
      def cloudtainer_render_turn_close(record: dict) -> str:
          return record['capsule'] + record['history_ledger'] + 'MNX_CLOUDTAINER_TURN_CLOSE=PASS\n'
      
      #@MNX-PART id=99.60.mnx-refactor.planner.function.cloudtainer-commands-text kind=function title="Python function cloudtainer_commands_text"
