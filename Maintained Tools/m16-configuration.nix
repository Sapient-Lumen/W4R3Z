#@MNX-CHUNK id=99.89 slug=presslog-service-adapter title="Presslog foreground service adapter"
#######################################################################################################
# SECTION 99.89 — PRESSLOG USER-SERVICE ADAPTER
#######################################################################################################
#@MNX-DEF path=environment.etc."monsternix/bin/presslog-service" section=99.89 role=generated-program ordinal=289
  environment.etc."monsternix/bin/presslog-service" = {
    source = pkgs.writeTextFile {
      name = "presslog-service";
      executable = true;
      text = ''
      #!${pkgs.bash}/bin/bash
      set -Eeuo pipefail
      umask 077
      export LC_ALL=C

      readonly PRESSLOG_SERVICE_USER=h0p3
      readonly PRESSLOG_STATE_ROOT=/home/h0p3/.local/state/presslog
      readonly PRESSLOG_CORE=${pkgs.presslogCore}/libexec/presslog/presslog
      readonly PRESSLOG_PINENTRY_DEFAULT=/etc/monsternix/bin/presslog-pinentry
      readonly PRESSLOG_ID=${pkgs.coreutils}/bin/id
      readonly PRESSLOG_INSTALL=${pkgs.coreutils}/bin/install
      readonly PRESSLOG_STAT=${pkgs.coreutils}/bin/stat
      readonly PRESSLOG_GREP=${pkgs.gnugrep}/bin/grep
      readonly PRESSLOG_MKTEMP=${pkgs.coreutils}/bin/mktemp
      readonly PRESSLOG_RM=${pkgs.coreutils}/bin/rm
      readonly PRESSLOG_CAT=${pkgs.coreutils}/bin/cat
      readonly PRESSLOG_FIND=${pkgs.findutils}/bin/find

      #@MNX-PART id=99.89.presslog-service.function.die kind=function title="Bash function die"
      die() {
        printf 'presslog-service: %s\n' "$1" >&2
        exit "''${2:-1}"
      }

      #@MNX-PART id=99.89.presslog-service.function.ensure-layout kind=function title="Bash function ensure_layout"
      ensure_layout() {
        local uid gid path
        uid="$($PRESSLOG_ID -u)"
        gid="$($PRESSLOG_ID -g)"
        [[ "$($PRESSLOG_ID -un)" == "$PRESSLOG_SERVICE_USER" && $uid == 1000 ]] || die 'service must run as h0p3 uid 1000' 77
        [[ ''${PRESSLOG_STATE:-$PRESSLOG_STATE_ROOT} == "$PRESSLOG_STATE_ROOT" ]] || die 'state override differs from source policy' 64
        [[ ! -L /home/h0p3/.local && ! -L /home/h0p3/.local/state ]] || die 'state parent is a symlink' 74
        "$PRESSLOG_INSTALL" -d -m 0700 \
          "$PRESSLOG_STATE_ROOT" \
          "$PRESSLOG_STATE_ROOT/run" \
          "$PRESSLOG_STATE_ROOT/monsternix" \
          "$PRESSLOG_STATE_ROOT/monsternix/recovery" \
          "$PRESSLOG_STATE_ROOT/monsternix/pinentry-config" \
          "$PRESSLOG_STATE_ROOT/monsternix/pinentry-cache" \
          "$PRESSLOG_STATE_ROOT/monsternix/pinentry-data" \
          "$PRESSLOG_STATE_ROOT/monsternix/pinentry-state"
        for path in \
          "$PRESSLOG_STATE_ROOT" \
          "$PRESSLOG_STATE_ROOT/run" \
          "$PRESSLOG_STATE_ROOT/monsternix" \
          "$PRESSLOG_STATE_ROOT/monsternix/recovery" \
          "$PRESSLOG_STATE_ROOT/monsternix/pinentry-config" \
          "$PRESSLOG_STATE_ROOT/monsternix/pinentry-cache" \
          "$PRESSLOG_STATE_ROOT/monsternix/pinentry-data" \
          "$PRESSLOG_STATE_ROOT/monsternix/pinentry-state"; do
          [[ -d $path && ! -L $path ]] || die "unsafe state directory: $path" 74
          [[ "$($PRESSLOG_STAT -Lc '%u:%g:%a' "$path")" == "$uid:$gid:700" ]] || die "state metadata differs: $path" 74
        done
      }

      #@MNX-PART id=99.89.presslog-service.function.prepare-session-environment kind=function title="Bash function prepare_session_environment"
      prepare_session_environment() {
        local prompt_runtime uid gid
        export HOME=/home/h0p3
        export XDG_RUNTIME_DIR="''${XDG_RUNTIME_DIR:-/run/user/1000}"
        export DBUS_SESSION_BUS_ADDRESS="''${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/1000/bus}"
        export DISPLAY="''${DISPLAY:-:0}"
        if [[ -z ''${XAUTHORITY:-} && -f /home/h0p3/.Xauthority && ! -L /home/h0p3/.Xauthority ]]; then
          export XAUTHORITY=/home/h0p3/.Xauthority
        fi
        export XDG_CONFIG_HOME="$PRESSLOG_STATE_ROOT/monsternix/pinentry-config"
        export XDG_CACHE_HOME="$PRESSLOG_STATE_ROOT/monsternix/pinentry-cache"
        export XDG_DATA_HOME="$PRESSLOG_STATE_ROOT/monsternix/pinentry-data"
        export XDG_STATE_HOME="$PRESSLOG_STATE_ROOT/monsternix/pinentry-state"
        export QT_QPA_PLATFORM="''${QT_QPA_PLATFORM:-xcb}"
        export PRESSLOG_STATE=$PRESSLOG_STATE_ROOT
        export PRESSLOG_ASKER=tty
        prompt_runtime="$XDG_RUNTIME_DIR/monsternix"
        "$PRESSLOG_INSTALL" -d -m 0700 "$prompt_runtime"
        uid="$($PRESSLOG_ID -u)"
        gid="$($PRESSLOG_ID -g)"
        [[ -d $prompt_runtime && ! -L $prompt_runtime && "$($PRESSLOG_STAT -Lc '%u:%g:%a' "$prompt_runtime" 2>/dev/null || true)" == "$uid:$gid:700" ]] || die 'secret-prompt runtime directory is unsafe' 74
      }

      #@MNX-PART id=99.89.presslog-service.function.pinentry-mode kind=function title="Bash function pinentry_mode"
      pinentry_mode() {
        local keystore=$PRESSLOG_STATE_ROOT/private/keystore first_segment
        if [[ -e $keystore || -L $keystore ]]; then
          [[ -f $keystore && ! -L $keystore ]] || die 'Presslog keystore is not a regular nonsymlink file' 74
          printf '%s\n' --presslog-existing
          return 0
        fi
        first_segment="$($PRESSLOG_FIND "$PRESSLOG_STATE_ROOT/journal" -maxdepth 1 -type f -name '*.plog' -print -quit 2>/dev/null || true)"
        [[ -z $first_segment ]] || die 'journal present but keystore missing; restore private state before creating another vault' 74
