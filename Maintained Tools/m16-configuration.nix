      #@MNX-PART id=99.08.mnx-office.function.bounded-output kind=function title="Python function bounded_output"
      def bounded_output(data: bytes) -> bytes:
          if len(data) > MAX_OUTPUT_BYTES:
              raise OfficeError(f'office output exceeds limit: {len(data)} > {MAX_OUTPUT_BYTES}')
          return data
      
      
      #@MNX-PART id=99.08.mnx-office.function.print-text-packet kind=function title="Python function print_text_packet"
      def print_text_packet(packet: dict[str, Any]) -> None:
          lines = ['################################################################################', '# MNX OFFICE RESUME — PASTE THIS ENTIRE OUTPUT TO CHATGPT', '################################################################################']
          for key, value in packet.items():
              lines.append(f'{key}={value}')
          lines.extend(['################################################################################', '# MNX OFFICE RESUME END', '################################################################################'])
          data = bounded_output(('\n'.join(lines) + '\n').encode('utf-8'))
          sys.stdout.buffer.write(data)
      
      
      #@MNX-PART id=99.08.mnx-office.function.command-agenda kind=function title="Python function command_agenda"
      def command_agenda(args: argparse.Namespace) -> int:
          source = parse_source(runtime_paths()['config'])
          payload = {'office_schema': OFFICE_VERSION, **source['agenda'], 'agenda_sha256': source['agenda_sha256'], 'amnesia_capsule': source['amnesia_capsule']}
          if args.json:
              sys.stdout.buffer.write(bounded_output(canonical_json(payload)))
          else:
              for key, value in payload.items():
                  print(f'{key}={value}')
          print('MNX_OFFICE_AGENDA=PASS') if not args.json else None
          return 0
      
      
      #@MNX-PART id=99.08.mnx-office.function.command-verify kind=function title="Python function command_verify"
      def command_verify(args: argparse.Namespace) -> int:
          paths = runtime_paths()
          source = parse_source(paths['config'])
          try:
              record_path = record_path_from_current(paths['state_root'])
          except OfficeError:
              if args.allow_missing:
                  print('office_acceptance_state=missing-allowed')
                  print('MNX_OFFICE_VERIFY=PASS_WITHOUT_RECORD')
                  return 0
              raise
          record = load_record(record_path, require_root=os.environ.get('MNX_OFFICE_SELF_TEST') != '1')
          require_root = os.environ.get('MNX_OFFICE_SELF_TEST') != '1'
          running = safe_resolve(paths['running'])
          default = safe_resolve(paths['default'])
          if args.allow_commit_pending:
              if os.environ.get('MNX_OFFICE_COMMIT_PENDING') != '1':
                  raise OfficeError('--allow-commit-pending requires MNX_OFFICE_COMMIT_PENDING=1')
              pending = validate_commit_pending_record(record, source, require_root=require_root)
              result = {
                  'office_acceptance_state': 'predecessor-valid-during-switch-commit',
                  'accepted_record': str(record_path),
                  'accepted_stage': record['accepted_stage'],
                  'accepted_source_sha256': record['source_sha256'],
                  'candidate_stage': int(source['agenda']['candidate_stage']),
                  'candidate_source_sha256': pending['candidate_source_sha256'],
                  'running_system': pending['running_system'],
                  'default_system': pending['default_system'],
                  'accepted_predecessor_system': pending['accepted_predecessor_system'],
                  'behavior_baseline': pending['behavior_baseline'],
                  'switch_evidence_digest_mode': pending['switch_evidence_digest_mode'],
                  'predecessor_closure_identity_mode': pending['predecessor_closure_identity_mode'],
              }
          elif args.allow_predecessor and running != default:
              predecessor_source = parse_source(default / 'configuration.nix')
              predecessor = validate_predecessor_record(record, predecessor_source, default, require_root=require_root)
              result = {
                  'office_acceptance_state': 'predecessor-valid-during-candidate',
                  'accepted_record': str(record_path),
                  'accepted_stage': record['accepted_stage'],
                  'accepted_source_sha256': record['source_sha256'],
                  'running_system': str(running),
                  'default_system': predecessor['default_system'],
                  'behavior_baseline': predecessor['behavior_baseline'],
                  'switch_evidence_digest_mode': predecessor['switch_evidence_digest_mode'],
                  'predecessor_closure_identity_mode': predecessor['closure_identity_mode'],
              }
          else:
              if args.allow_incomplete_switch and os.environ.get('MNX_OFFICE_POST_COMMIT_SEAL') != '1':
                  raise OfficeError('--allow-incomplete-switch requires MNX_OFFICE_POST_COMMIT_SEAL=1')
              runtime = validate_record_against_runtime(record, source, allow_incomplete_switch=args.allow_incomplete_switch, require_root=require_root)
              result = {
                  'office_acceptance_state': 'committed-pending-final-seal' if args.allow_incomplete_switch else 'accepted',
                  'accepted_record': str(record_path),
                  'accepted_stage': record['accepted_stage'],
                  'accepted_source_sha256': record['source_sha256'],
                  'running_system': runtime['running_system'],
                  'default_system': runtime['default_system'],
                  'behavior_baseline': runtime['behavior_baseline'],
                  'switch_evidence_digest_mode': runtime['switch_evidence_digest_mode'],
              }
          if args.json:
              sys.stdout.buffer.write(bounded_output(canonical_json(result)))
          else:
              for key, value in result.items():
                  print(f'{key}={value}')
              print('MNX_OFFICE_VERIFY=PASS')
          return 0
      
      
      #@MNX-PART id=99.08.mnx-office.function.command-resume kind=function title="Python function command_resume"
      def command_resume(args: argparse.Namespace) -> int:
          paths = runtime_paths()
          source = parse_source(paths['config'])
          record_path = record_path_from_current(paths['state_root'])
          record = load_record(record_path, require_root=os.environ.get('MNX_OFFICE_SELF_TEST') != '1')
          runtime = validate_record_against_runtime(record, source, require_root=os.environ.get('MNX_OFFICE_SELF_TEST') != '1')
          health = health_summary(paths['health'])
          exposure = exposure_summary(paths['exposure'])
          packet = render_resume(record, source, runtime, health, exposure)
          packet['health_evidence'] = health_build_evidence()
          if args.json:
              sys.stdout.buffer.write(bounded_output(canonical_json(packet)))
          else:
              print_text_packet(packet)
              print('MNX_OFFICE_RESUME=PASS')
          return 0
      
      
      #@MNX-PART id=99.08.mnx-office.function.command-commit kind=function title="Python function command_commit"
      def command_commit(args: argparse.Namespace) -> int:
          self_test = os.environ.get('MNX_OFFICE_SELF_TEST') == '1'
          if os.geteuid() != 0 and not self_test:
              raise OfficeError('office acceptance commit requires root')
          if os.environ.get('MNX_OFFICE_SWITCH_TRANSACTION') != '1' and not self_test:
              raise OfficeError('office acceptance commit is reserved for the mnx switch transaction')
          paths = runtime_paths()
          source = parse_source(paths['config'])
          record = build_record(args, source)
          require_root = os.environ.get('MNX_OFFICE_SELF_TEST') != '1'
          validate_record_against_runtime(record, source, allow_incomplete_switch=True, require_root=require_root)
          destination = atomic_write_record(paths['state_root'], record)
          load_record(destination, require_root=require_root)
          print(f'office_record={destination}')
          print(f'office_current={paths["state_root"] / "current.json"}')
          print(f'office_accepted_stage={record["accepted_stage"]}')
          print(f'office_accepted_source_sha256={record["source_sha256"]}')
          print('MNX_OFFICE_COMMIT=PASS')
          return 0
      
      
