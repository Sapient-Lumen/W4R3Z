#@MNX-CHUNK id=99.02 slug=activation-gates title="Source ownership, state-layout migration, and incoming-closure activation gates"
#@MNX-DEF path=system.activationScripts.mnx-configuration-source-executable section=99.02 role=activation ordinal=261
  system.activationScripts.mnx-configuration-source-executable = {
    deps = [ "etc" ];
    text = ''
      if [ -f /etc/nixos/configuration.nix ] && [ ! -L /etc/nixos/configuration.nix ]; then
        ${pkgs.coreutils}/bin/chown root:root /etc/nixos/configuration.nix
        ${pkgs.coreutils}/bin/chmod 0755 /etc/nixos/configuration.nix
      fi
    '';
  };


#@MNX-DEF path=system.activationScripts.mnx-job-state-authority-layout section=99.02 role=activation ordinal=262
  system.activationScripts.mnx-job-state-authority-layout = {
    deps = [ "etc" ];
    text = ''
      set -Eeuo pipefail
      ROOT=/var/lib/monsternix/job-state
      AUTH="$ROOT/authoritative"
      TELEMETRY="$ROOT/telemetry"
      REJECTED=/var/lib/logbook/maintenance/job-state-migration-rejected
      ${pkgs.coreutils}/bin/install -d -m 0750 -o root -g logbook "$ROOT" "$AUTH" "$REJECTED"
      ${pkgs.coreutils}/bin/install -d -m 2770 -o root -g logbook "$TELEMETRY"

      #@MNX-PART id=99.02.mnx-job-state-authority-layout.function.migrate_one kind=function title="Function migrate_one"
      migrate_one() {
        src="$1"
        [ -e "$src" ] || [ -L "$src" ] || return 0
        base="$(${pkgs.coreutils}/bin/basename "$src")"
        if [ -L "$src" ]; then
          target="$(${pkgs.coreutils}/bin/readlink "$src" 2>/dev/null || true)"
          ${pkgs.coreutils}/bin/rm -f "$src"
          rejected="$REJECTED/$base.symlink.$(${pkgs.coreutils}/bin/date +%Y%m%dT%H%M%S).txt"
          printf 'source=%s\nsymlink_target=%s\nreason=legacy-job-state-symlink-rejected\n' "$src" "$target" > "$rejected"
          ${pkgs.coreutils}/bin/chown root:logbook "$rejected"
          ${pkgs.coreutils}/bin/chmod 0640 "$rejected"
          return 0
        fi
        [ -f "$src" ] || {
          echo "refusing non-regular legacy job-state entry: $src" >&2
          return 1
        }
        owner="$(${pkgs.coreutils}/bin/stat -c '%u' "$src")"
        case "$base" in
          *.last-success|*.last-failure)
            if [ "$owner" != 0 ]; then
              rejected="$REJECTED/$base.untrusted-owner-$owner.$(${pkgs.coreutils}/bin/date +%Y%m%dT%H%M%S)"
              ${pkgs.coreutils}/bin/mv "$src" "$rejected"
              ${pkgs.coreutils}/bin/chown root:logbook "$rejected"
              ${pkgs.coreutils}/bin/chmod 0640 "$rejected"
              echo "rejected non-root authoritative legacy state: $base owner=$owner" >&2
              return 0
            fi
            dst="$AUTH/$base"
            ;;
          *.last-run)
            if [ "$owner" = 0 ]; then dst="$AUTH/$base"; else dst="$TELEMETRY/$base"; fi
            ;;
          *)
            echo "unexpected legacy job-state filename: $src" >&2
            return 1
            ;;
        esac
        if [ -e "$dst" ]; then
          [ -f "$dst" ] && [ ! -L "$dst" ] || {
            echo "refusing unsafe destination job-state entry: $dst" >&2
            return 1
          }
          if [ "$src" -nt "$dst" ]; then
            ${pkgs.coreutils}/bin/mv -f "$src" "$dst"
          else
            ${pkgs.coreutils}/bin/rm -f "$src"
          fi
        else
          ${pkgs.coreutils}/bin/mv "$src" "$dst"
        fi
        case "$dst" in
          "$AUTH"/*)
            ${pkgs.coreutils}/bin/chown root:logbook "$dst"
            ${pkgs.coreutils}/bin/chmod 0640 "$dst"
            ;;
          "$TELEMETRY"/*)
            ${pkgs.coreutils}/bin/chgrp logbook "$dst"
            ${pkgs.coreutils}/bin/chmod 0660 "$dst"
            ;;
        esac
      }

      for src in "$ROOT"/*.last-run "$ROOT"/*.last-success "$ROOT"/*.last-failure; do
        [ -e "$src" ] || [ -L "$src" ] || continue
        migrate_one "$src"
      done

      if ${pkgs.findutils}/bin/find "$ROOT" -maxdepth 1 \( -type f -o -type l \) -name '*.last-*' -print -quit | ${pkgs.gnugrep}/bin/grep -q .; then
        echo 'legacy authoritative state remains at the writable job-state root' >&2
        exit 1
      fi

      printf 'schema=2\nauthoritative=%s\ntelemetry=%s\n' "$AUTH" "$TELEMETRY" > "$ROOT/layout"
      ${pkgs.coreutils}/bin/chown root:logbook "$ROOT/layout"
      ${pkgs.coreutils}/bin/chmod 0640 "$ROOT/layout"
    '';
  };


#@MNX-DEF path=system.activationScripts.mnx-rendered-program-and-monolith-gate section=99.02 role=activation ordinal=263
  system.activationScripts.mnx-rendered-program-and-monolith-gate = {
    deps = [ "etc" ];
    text = ''
      set -Eeuo pipefail
      # Activation snippets run before /run/current-system is repointed. Audit the
      # incoming closure through the activation script's candidate-owned systemConfig.
      INCOMING_LINK="$systemConfig/configuration.nix"
      INCOMING_SOURCE="$(${pkgs.coreutils}/bin/readlink -f -- "$INCOMING_LINK" 2>/dev/null || true)"
      [ -n "$INCOMING_SOURCE" ] || { echo "MNX_SOURCE_PROGRAM_AUDIT_ERROR: could not resolve incoming embedded configuration: $INCOMING_LINK" >&2; exit 1; }
      [ -f "$INCOMING_SOURCE" ] && [ -r "$INCOMING_SOURCE" ] || { echo "MNX_SOURCE_PROGRAM_AUDIT_ERROR: incoming configuration target is not a readable regular file: $INCOMING_SOURCE" >&2; exit 1; }
      case "$INCOMING_SOURCE" in
        /nix/store/*) ;;
        *) echo "MNX_SOURCE_PROGRAM_AUDIT_ERROR: incoming configuration resolves outside /nix/store: $INCOMING_SOURCE" >&2; exit 1 ;;
      esac
      /etc/monsternix/bin/mnx-source-program-audit closure "$INCOMING_LINK"
      /etc/monsternix/bin/mnx-bundle-manifest self-test
      /etc/monsternix/bin/mnx-journal-integrity self-test
      /etc/monsternix/bin/mnx-monolith --config "$INCOMING_SOURCE" verify
      /etc/monsternix/bin/mnx-atlas --config "$INCOMING_SOURCE" verify
      /etc/monsternix/bin/mnx-atlas --config "$INCOMING_SOURCE" temp-gate test
      /etc/monsternix/bin/mnx-relations --config "$INCOMING_SOURCE" verify
      /etc/monsternix/bin/mnx-exposure self-test
      MNX_EXPOSURE_CONFIG="$INCOMING_SOURCE" /etc/monsternix/bin/mnx-exposure policy >/dev/null
      MNX_EXPOSURE_CONFIG="$INCOMING_SOURCE" /etc/monsternix/bin/mnx-exposure zones >/dev/null
      MNXCRYPT_ALLOW_ROOT_FOR_TESTS=1 /etc/monsternix/bin/mnxcrypt self-test
      MNXCRYPT_POLICY_OUTPUT="$(MNXCRYPT_ALLOW_ROOT_FOR_TESTS=1 /etc/monsternix/bin/mnxcrypt policy)"
      grep -Fxq 'MNXCRYPT_POLICY=PASS' <<<"$MNXCRYPT_POLICY_OUTPUT"
      /etc/monsternix/bin/mnxcrypt-pinentry --self-test
      /etc/monsternix/bin/mnxcrypt-pinentry --check-program >/dev/null
      /etc/monsternix/bin/mnx-office self-test
      MNX_OFFICE_CONFIG="$INCOMING_SOURCE" /etc/monsternix/bin/mnx-office agenda --json >/dev/null
    '';
  };


