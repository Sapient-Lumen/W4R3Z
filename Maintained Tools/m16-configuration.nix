          print("MNX_JOURNAL_CLOSED_FILE_MODEL_SELF_TEST=PASS")
          print("MNX_JOURNAL_NAMESPACE_STABILITY_SELF_TEST=PASS")
          print("MNX_JOURNAL_PREPROVISIONED_ROOT_SELF_TEST=PASS")
          print("MNX_JOURNAL_RESET_AUTHORITY_REVOCATION_SELF_TEST=PASS")
          print("MNX_JOURNAL_DEFAULT_RESET_ATTEMPT_SELF_TEST=PASS")
          print("MNX_JOURNAL_DEFAULT_RESET_SELF_TEST=PASS")
          print("MNX_JOURNAL_SEMANTIC_IDENTITY_SELF_TEST=PASS")
          print("MNX_JOURNAL_RECOVERY_BOUNDARY_SELF_TEST=PASS")
          print("MNX_JOURNAL_CLEAN_FORWARD_SELF_TEST=PASS")
          print("MNX_JOURNAL_INTEGRITY_SELF_TEST=PASS")
          return 0
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.escalate_if_needed kind=function title="Python function escalate_if_needed"
      def escalate_if_needed(command: str, argv: list[str]) -> None:
          if command == "self-test" or os.geteuid() == 0:
              return
          sudo = "/run/wrappers/bin/sudo"
          if not os.path.exists(sudo):
              raise JournalIntegrityError("/run/wrappers/bin/sudo is unavailable")
          os.execv(sudo, [sudo, "--", "/etc/monsternix/bin/mnx-journal-integrity", *argv])
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.build_parser kind=function title="Python function build_parser"
      def build_parser() -> argparse.ArgumentParser:
          parser = argparse.ArgumentParser(prog="mnx-journal-integrity", description="Classify journal verifier execution, immutable legacy damage, and clean-forward state")
          sub = parser.add_subparsers(dest="command", required=True)
          sub.add_parser("service", help="publish evidence and return status 76 for review-required findings")
          sub.add_parser("verify", help="publish evidence and return success for clean or review-required findings")
          status_parser = sub.add_parser("status", help="show the latest source-owned journal integrity state")
          status_parser.add_argument("--json", action="store_true")
          evidence = sub.add_parser("evidence", help="show the latest bounded journal verifier evidence and immutable anchor")
          evidence.add_argument("--full", action="store_true")
          anchor = sub.add_parser("anchor", help="switch-owned one-time legacy anchor and clean-forward verification")
          anchor.add_argument("--switch-owned", action="store_true")
          recover = sub.add_parser("recover-forward", help="switch-owned Stage62 reset reconciliation, clean-current proof, and accepted observer recovery")
          recover.add_argument("--switch-owned", action="store_true")
          sub.add_parser("self-test")
          return parser
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.main kind=function title="Python function main"
      def main() -> int:
          parser = build_parser()
          args = parser.parse_args()
          try:
              escalate_if_needed(args.command, sys.argv[1:])
          except JournalIntegrityError as exc:
              print(f"MNX_JOURNAL_INTEGRITY_ERROR: {exc}", file=sys.stderr)
              return 126
          if args.command == "self-test":
              return command_self_test()
          if args.command == "service":
              return perform_verify("service", service_exit=True)
          if args.command == "verify":
              return perform_verify("operator-verify", service_exit=False)
          if args.command == "status":
              return command_status(args.json)
          if args.command == "evidence":
              return command_evidence(args.full)
          if args.command == "anchor":
              return command_anchor(args.switch_owned)
          if args.command == "recover-forward":
              return command_recover_forward(args.switch_owned)
          return 64
      
      
      if __name__ == "__main__":
          raise SystemExit(main())
