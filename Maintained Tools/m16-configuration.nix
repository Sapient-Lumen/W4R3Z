        grep -Fq 'journal-integrity-anchor)' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: journal anchor continuation handler is missing' >&2; return 1; }
        grep -Fq 'mnx incident journal anchor --switch-owned' "$0" || { echo 'MNX_SWITCH_SELF_TEST_ERROR: journal anchor continuation command is missing' >&2; return 1; }
