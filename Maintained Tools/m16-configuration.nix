      #@MNX-PART id=99.55.mnx-atlas.function.command-navigation-self-test kind=function title="Python function command_navigation_self_test"
      def command_navigation_self_test() -> int:
          if self_test() != 0:
              raise PolicyError("strict atlas/policy self-test failed")
          fixture = navigation_valid_fixture()
          with tempfile.TemporaryDirectory(prefix="mnx-atlas-navigation-self-test-") as temporary:
              path = Path(temporary) / "configuration.nix"
              path.write_text(fixture, encoding="utf-8")
              navigation = build_navigation(path)
              if len(navigation.core.definitions) != 2:
                  raise PolicyError("navigation self-test definition count is wrong")
              if len(navigation.policy.parts) != 2:
                  raise PolicyError("navigation self-test part count is wrong")
              if len(navigation.policy.temporary_regions) != 1:
                  raise PolicyError("navigation self-test temporary region count is wrong")
              if resolve_navigation_definition(navigation, "foo").marker.path != "foo":
                  raise PolicyError("navigation self-test definition resolution failed")
              if resolve_navigation_part(navigation, "hello").part_id != "00.00.foo.function.hello":
                  raise PolicyError("navigation self-test part resolution failed")
              if command_navigation_temp_gate(navigation, "test") != 0:
                  raise PolicyError("navigation self-test test gate rejected valid candidate code")
              if command_navigation_temp_gate(navigation, "switch") == 0:
                  raise PolicyError("navigation self-test switch gate accepted candidate-only code")
      
              raw = navigation_valid_fixture().encode("utf-8").replace(b"\n", b"\r\n")
              path.write_bytes(raw)
              crlf = build_navigation(path)
              if crlf.sha256 != hashlib.sha256(raw).hexdigest():
                  raise PolicyError("navigation self-test CRLF source hash is not byte-exact")
              bundle = Path(temporary) / "atlas.tar.gz"
              capture_navigation_output(lambda: command_navigation_bundle(crlf, bundle))
              extract = Path(temporary) / "extract"
              extract.mkdir()
              with tarfile.open(bundle, "r:gz") as archive:
                  archive.extractall(extract, filter="data")
              copies = list(extract.glob("*/configuration.nix"))
              if len(copies) != 1 or copies[0].read_bytes() != raw:
                  raise PolicyError("navigation self-test bundle normalized or changed source bytes")
      
          print("outer_let_module_envelope=PASS")
          print("modern_let_in_definition_slicing=PASS")
          print("strict_definition_assignment_pairing=PASS")
