                  except OSError:
                      note_unsafe(unsafe, 'private-unstatable')
                      continue
                  if entry.is_symlink() or not stat.S_ISREG(item.st_mode):
                      note_unsafe(unsafe, 'private-object-type')
                      continue
                  if item.st_uid != uid or stat.S_IMODE(item.st_mode) != 0o600:
                      note_unsafe(unsafe, 'private-file-metadata')
                  if entry.name == 'salt':
