                  "error": str(error)[:512],
                  "window_id_after": None, "geometry_after": None,
              })
              write_kodi_output_receipt(review)
              raise


      #@MNX-PART id=99.92.mnx-monsterkey.function.supervise-desktop-extensions kind=function title="Python function supervise_desktop_extensions"
      def supervise_desktop_extensions(supervisor: dict[str, Any], environment: dict[str, str], connection: xdisplay.Display, force: bool = False) -> None:
          checks = (
              ("qbittorrent", lambda: supervise_family_qbittorrent(supervisor, environment, force=force)),
              ("kodi", lambda: supervise_kodi_output(supervisor, environment, connection, force=force)),
          )
          now = time.monotonic()
          for name, callback in checks:
              try:
                  callback()
              except Exception as error:
                  key = f"{name}_review_log"
                  if now - float(supervisor.get(key, 0.0)) >= REVIEW_LOG_INTERVAL_SECONDS:
                      print(f"{name}_guardian_review={type(error).__name__}: {error}", file=sys.stderr, flush=True)
                      supervisor[key] = now


      #@MNX-PART id=99.92.mnx-monsterkey.function.supervise-presslog kind=function title="Python function supervise_presslog"
      def supervise_presslog(supervisor: dict[str, Any], environment: dict[str, str], force: bool = False) -> None:
          unit = presslog_unit_state(environment)
          status = presslog_status_snapshot()
          progress = presslog_metadata_progress(status)
          startup = write_presslog_startup(environment, unit, status)
          now = time.monotonic()
          if force or now - float(supervisor.get('last_heartbeat_write', 0.0)) >= HEARTBEAT_WRITE_SECONDS:
              write_presslog_heartbeat(supervisor, unit, status, progress)
          paused = startup.get('recording_confirmed') is True and isinstance(status, dict) and str(status.get('paused', 'false')) == 'true'
          prior_paused = supervisor.get('paused')
          if paused and prior_paused is not True:
              supervisor['paused_since'] = now
              supervisor['next_pause_reminder'] = now + PAUSE_REMINDER_FIRST_SECONDS
          elif not paused:
              supervisor.pop('paused_since', None)
              supervisor.pop('next_pause_reminder', None)
          if paused and now >= float(supervisor.get('next_pause_reminder', now + PAUSE_REMINDER_FIRST_SECONDS)):
              notify('Presslog is still paused', 'MONSTER EYE: recording remains OFF. New keystrokes are being discarded; Caps+Esc resumes only when you choose.', 'normal')
              supervisor['next_pause_reminder'] = now + PAUSE_REMINDER_REPEAT_SECONDS
          update_monster_eye(supervisor, paused)
          supervisor['paused'] = paused
      #@MNX-PART id=99.92.mnx-monsterkey.function.serve-session kind=function title="Python function serve_session"
      def serve_session(connection: xdisplay.Display, stopping: list[bool]) -> None:
          apply_on_connection(connection)
          inspect_live_x11(connection, emit=True)
          escape_keycode, extras = grab_escape(connection)
          environment = x11_environment()
          supervisor: dict[str, Any] = {}
          try:
              while connection.pending_events():
                  connection.next_event()
              write_runtime_state(ready=True, status="active", key_grab_count=len(extras))
              supervise_presslog(supervisor, environment, force=True)
              supervise_desktop_extensions(supervisor, environment, connection, force=True)
              print("MNX_MONSTER_KEY_READY=PASS", flush=True)
              next_guard = time.monotonic() + GUARD_INTERVAL_SECONDS
              while not stopping[0]:
                  timeout = max(0.0, min(0.5, next_guard - time.monotonic()))
                  readable, _, _ = select.select([connection.fileno()], [], [], timeout)
                  if readable:
                      while connection.pending_events():
                          event = connection.next_event()
                          if event.type == X.MappingNotify:
                              connection.refresh_keyboard_mapping(event)
                          elif event.type == X.KeyRelease and int(event.detail) == escape_keycode and int(event.state) & MONSTER_MASK:
                              command_toggle(source="mod3-escape-release")
                              supervise_presslog(supervisor, environment, force=True)
                  if time.monotonic() >= next_guard:
                      if not monster_state(connection):
                          print("monster_key_guard=reasserting-direct-caps-state", flush=True)
                          ungrab_escape(connection, escape_keycode, extras)
                          apply_on_connection(connection)
                          escape_keycode, extras = grab_escape(connection)
                          write_runtime_state(ready=True, status="active", key_grab_count=len(extras))
                      supervise_presslog(supervisor, environment)
                      supervise_desktop_extensions(supervisor, environment, connection)
                      next_guard = time.monotonic() + GUARD_INTERVAL_SECONDS
          finally:
              try:
                  update_monster_eye(supervisor, False, restore=True)
              except Exception as error:
                  print(f"monster_eye_restore_error={error}", file=sys.stderr, flush=True)
              try:
                  ungrab_escape(connection, escape_keycode, extras)
              except Exception as error:
                  print(f"monster_key_ungrab_error={error}", file=sys.stderr, flush=True)
      #@MNX-PART id=99.92.mnx-monsterkey.function.command-serve kind=function title="Python function command_serve"
      def command_serve() -> int:
          ensure_runtime_root()
          reset_kodi_output_receipt_generation()
          stopping = [False]

          #@MNX-PART id=99.92.mnx-monsterkey.function.command-serve.request-stop kind=function title="Python nested function request_stop"
          def request_stop(signum: int, frame: object) -> None:
              stopping[0] = True

          prior_term = signal.signal(signal.SIGTERM, request_stop)
          prior_int = signal.signal(signal.SIGINT, request_stop)
          last_review_message = ""
          last_review_log = 0.0
          try:
              while not stopping[0]:
                  connection: xdisplay.Display | None = None
                  try:
                      write_runtime_state(ready=False, status="starting")
                      _, connection = wait_for_x11(timeout_seconds=10)
                      if stopping[0]:
                          break
                      serve_session(connection, stopping)
                  except Exception as error:
                      message = f"{type(error).__name__}: {error}"
                      now = time.monotonic()
                      if message != last_review_message or now - last_review_log >= REVIEW_LOG_INTERVAL_SECONDS:
                          print(f"monster_key_runtime_review={message}", file=sys.stderr, flush=True)
                          last_review_message = message
                          last_review_log = now
                      try:
                          write_runtime_state(ready=False, status="review-required", error=message)
                      except Exception as state_error:
                          print(f"monster_key_state_publish_error={state_error}", file=sys.stderr, flush=True)
                      if connection is not None:
                          try:
                              restore_on_connection(connection)
                          except Exception as restore_error:
                              print(f"monster_key_retry_restore_error={restore_error}", file=sys.stderr, flush=True)
                      deadline = time.monotonic() + RETRY_INTERVAL_SECONDS
                      while not stopping[0] and time.monotonic() < deadline:
                          time.sleep(0.1)
                  finally:
                      if connection is not None:
                          try:
                              connection.close()
                          except Exception:
                              pass
              return 0
          finally:
              signal.signal(signal.SIGTERM, prior_term)
              signal.signal(signal.SIGINT, prior_int)
              try:
                  command_restore()
              except Exception as error:
                  print(f"monster_key_final_restore_error={error}", file=sys.stderr, flush=True)
                  return 1


      #@MNX-PART id=99.92.mnx-monsterkey.function.read-runtime-state kind=function title="Python function read_runtime_state"
      def read_runtime_state() -> dict[str, Any]:
          path = ensure_runtime_root() / STATE_NAME
          if not path.exists():
              raise MonsterKeyError("Monster Key runtime state is absent")
          try:
              record = json.loads(validated_regular(path).decode("utf-8"))
          except (UnicodeDecodeError, json.JSONDecodeError) as error:
              raise MonsterKeyError(f"Monster Key runtime state is invalid: {error}") from error
          if not isinstance(record, dict) or record.get("schema") != STATE_SCHEMA:
              raise MonsterKeyError("Monster Key runtime state schema differs")
          return record


      #@MNX-PART id=99.92.mnx-monsterkey.function.command-status kind=function title="Python function command_status"
      def command_status() -> int:
          state = read_runtime_state()
          action = read_action_receipt()
          operational_records: list[tuple[str, str]] = [("presslog_startup", PRESSLOG_STARTUP_NAME), ("presslog_heartbeat", PRESSLOG_HEARTBEAT_NAME), ("monster_eye", MONSTER_EYE_NAME)]
          environment = x11_environment()
          connection = open_display(environment)
          try:
              inspect_live_x11(connection, emit=True)
          finally:
              connection.close()
          completed = subprocess.run(
              [str(SYSTEMCTL), "show", SERVICE, "-p", "LoadState", "-p", "ActiveState", "-p", "SubState", "-p", "Result", "-p", "MainPID", "-p", "User", "-p", "Type", "-p", "Restart", "-p", "ProtectHome"],
              env=environment,
              stdin=subprocess.DEVNULL,
              stdout=subprocess.PIPE,
              stderr=subprocess.PIPE,
              text=True,
              timeout=10,
              check=False,
          )
          if completed.returncode != 0:
              raise MonsterKeyError(f"systemd status query failed: {completed.stderr.strip()}")
          print(completed.stdout, end="" if completed.stdout.endswith("\n") else "\n")
          for key in sorted(state):
              print(f"runtime_{key}={state[key]}")
          for prefix, filename in operational_records:
              path = ensure_runtime_root() / filename
              if not path.exists():
                  print(f"{prefix}=none")
                  continue
              try:
                  record = json.loads(validated_regular(path).decode("utf-8"))
              except Exception as error:
                  print(f"{prefix}=review:{type(error).__name__}")
                  continue
              if record.get("boot_id") is not None:
                  print(f"{prefix}_current_boot={str(record.get('boot_id')) == boot_id()}")
              for key in sorted(record):
                  value = record[key]
                  if isinstance(value, bool): value = "true" if value else "false"
                  elif value is None: value = "none"
                  print(f"{prefix}_{key}={value}")
          action_current = False
          if action is None:
              print("last_action=none")
          elif action.get("service_pid") != state.get("pid"):
              print("last_action=stale-prior-service")
              print(f"last_action_service_pid={action.get('service_pid')}")
          else:
              action_current = True
              for key in ("schema", "source", "outcome", "action", "paused", "presslog_rc", "notification", "detail", "updated_monotonic_ns"):
                  value = action.get(key)
                  if isinstance(value, bool):
                      rendered = "true" if value else "false"
                  elif value is None:
                      rendered = "none"
                  else:
                      rendered = str(value)
                  print(f"last_action_{key}={rendered}")
          properties = dict(line.split("=", 1) for line in completed.stdout.splitlines() if "=" in line)
          healthy = (
              properties.get("LoadState") == "loaded"
              and properties.get("ActiveState") == "active"
              and properties.get("SubState") == "running"
              and properties.get("Result") == "success"
              and properties.get("User") == EXPECTED_USER
              and properties.get("Type") == "simple"
              and properties.get("Restart") == "no"
              and properties.get("ProtectHome") == "read-only"
              and state.get("ready") is True
              and state.get("status") == "active"
              and str(state.get("pid")) == properties.get("MainPID")
          )
          if action_current and action is not None and action.get("outcome") != "pass":
              healthy = False
          if not healthy:
              print("MNX_MONSTER_KEY_STATUS=REVIEW")
              return 1
          print("MNX_MONSTER_KEY_STATUS=PASS")
          return 0


