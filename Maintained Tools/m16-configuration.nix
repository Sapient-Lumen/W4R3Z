      #@MNX-PART id=40.17.mnx-journal-integrity.function.command_status kind=function title="Python function command_status"
      def command_status(as_json: bool) -> int:
          try:
              state = load_current()
              if as_json:
                  sys.stdout.buffer.write(canonical_json(state))
              else:
                  bundle = pathlib.Path(str(state.get("evidence_bundle", "none")))
                  print_summary(state, bundle, "state-only")
                  clean_status = str(state.get("clean_forward", {}).get("status", "unanchored"))
                  marker = "PASS"
                  if state["overall_status"] == "malfunction" or clean_status == "unknown-observer-malfunction":
                      marker = "FAIL_OBSERVER_MALFUNCTION"
                  elif clean_status == "new-damage-review-required":
                      marker = "PASS_WITH_NEW_DAMAGE_REVIEW"
                  elif clean_status == "unanchored":
                      marker = "PASS_UNANCHORED"
                  elif clean_status == "known-archived-damage-clean-forward":
                      marker = "PASS_KNOWN_ARCHIVED_DAMAGE_CLEAN_FORWARD"
                  elif clean_status == "known-damage-no-longer-observed-clean-forward":
                      marker = "PASS_KNOWN_DAMAGE_NO_LONGER_OBSERVED"
                  elif state["overall_status"] == "review-required":
                      marker = "PASS_WITH_LEGACY_REVIEW"
                  print(f"MNX_JOURNAL_STATUS={marker}")
              return 1 if state["overall_status"] == "malfunction" else 0
          except (JournalIntegrityError, OSError, KeyError, ValueError) as exc:
              print(f"MNX_JOURNAL_INTEGRITY_ERROR: {exc}", file=sys.stderr)
              print("MNX_JOURNAL_STATUS=UNKNOWN")
              return 1
      
      
      #@MNX-PART id=40.17.mnx-journal-integrity.function.command_evidence kind=function title="Python function command_evidence"
      def command_evidence(full: bool) -> int:
          try:
              state = load_current()
              bundle = pathlib.Path(str(state.get("evidence_bundle", "")))
              if not bundle.is_dir() or bundle.is_symlink():
                  raise JournalIntegrityError(f"journal evidence bundle is unavailable: {bundle}")
              print(f"evidence_bundle={bundle}")
              print((bundle / "summary.json").read_text(encoding="utf-8"), end="")
              anchor = load_anchor()
              if anchor is not None:
                  print("\n--- immutable legacy anchor ---")
                  sys.stdout.buffer.write(canonical_json(anchor))
              boundary = load_boundary()
              if boundary is not None:
                  print("\n--- accepted journal recovery boundary ---")
                  sys.stdout.buffer.write(canonical_json(boundary))
              for namespace in ("default", "logbook"):
                  path = bundle / f"{namespace}.verify.txt"
                  print(f"\n--- {namespace} namespace verifier output ---")
                  data = path.read_bytes()
                  if not full:
                      data = bounded_bytes(data, MAX_EVIDENCE_PRINT_BYTES)
                  sys.stdout.buffer.write(data)
                  if data and not data.endswith(b"\n"):
                      print()
              print("MNX_JOURNAL_EVIDENCE=PASS")
              return 0
          except (JournalIntegrityError, OSError, json.JSONDecodeError) as exc:
              print(f"MNX_JOURNAL_INTEGRITY_ERROR: {exc}", file=sys.stderr)
              print("MNX_JOURNAL_EVIDENCE=FAIL")
              return 1
      
      
