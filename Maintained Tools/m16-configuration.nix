              raise LineageError(f"cannot read accepted office current link: {path}: {exc}") from exc
          require(stat.S_ISLNK(before.st_mode), f"accepted office current is not a symlink: {path}")
          if require_root:
              require(before.st_uid == 0, f"accepted office current symlink is not root-owned: {path}")
          identity_before = (before.st_dev, before.st_ino, before.st_mode, before.st_uid, before.st_gid, before.st_size, before.st_mtime_ns, before.st_ctime_ns)
          identity_after = (after.st_dev, after.st_ino, after.st_mode, after.st_uid, after.st_gid, after.st_size, after.st_mtime_ns, after.st_ctime_ns)
