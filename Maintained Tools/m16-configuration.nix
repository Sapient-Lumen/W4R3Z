      JOB_START="$(date +%s)"
      JOB_SKIPPED=0
      JOB_REASON=none
      finish() { rc="$?"; /etc/monsternix/bin/mnx-job-metric duperemove-home "$rc" "$(( $(date +%s) - JOB_START ))" "$JOB_SKIPPED" "$JOB_REASON" || true; exit "$rc"; }
      trap finish EXIT
      L=/run/storage-maintenance.lock
      exec 9<>"$L"
      if ! flock -n -x 9; then JOB_SKIPPED=1; JOB_REASON=lock-busy; exit 0; fi
      if ! /etc/monsternix/bin/mnx-storage-preflight duperemove-home /home; then JOB_SKIPPED=1; JOB_REASON=preflight; exit 0; fi

      H=/home/h0p3/admin/duperemove/duperemove-m16-home.hashfile

      find /home/h0p3 -mindepth 1 -maxdepth 1 -type d ! -name admin ! -name .btrbk-snapshots -print0 \
        | xargs -0 -r duperemove -drq -r --io-threads=1 --dedupe-options=same --hashfile="$H"
      /etc/monsternix/bin/mnx-storage-postflight duperemove-home
    '';
  };

