      #@MNX-PART id=99.89.presslog-service.function.exec-capture kind=function title="Bash function exec_capture"
      exec_capture() {
        local mode=$1 pinentry="''${PRESSLOG_PINENTRY_ADAPTER:-$PRESSLOG_PINENTRY_DEFAULT}" prompt_mode
        [[ $pinentry == "$PRESSLOG_PINENTRY_DEFAULT" ]] || die 'pinentry adapter override differs from source policy' 64
        [[ -x $pinentry && -f $pinentry && ! -L $pinentry ]] || die 'source-owned pinentry adapter is unavailable or unsafe' 70
        prompt_mode="$(pinentry_mode)"
        case "$mode" in
          normal)
            exec "$PRESSLOG_CORE" --state "$PRESSLOG_STATE_ROOT" --asker tty start --foreground --start-paused --retain 36500 --no-auto-expire < <("$pinentry" "$prompt_mode")
            ;;
          burn)
            exec "$PRESSLOG_CORE" --state "$PRESSLOG_STATE_ROOT" --asker tty start --foreground --burn --start-paused --retain 1 --no-auto-expire < <("$pinentry" "$prompt_mode")
            ;;
          *) die "unknown capture mode: $mode" 64 ;;
        esac
      }

      #@MNX-PART id=99.89.presslog-service.function.clear-stale-run-state kind=function title="Bash function clear_stale_run_state"
      clear_stale_run_state() {
        local pidfile=$PRESSLOG_STATE_ROOT/run/pid status=$PRESSLOG_STATE_ROOT/run/status.json pid=''' comm='''
        if [[ -f $pidfile && ! -L $pidfile ]]; then
          IFS= read -r pid < "$pidfile" || pid='''
          if [[ $pid =~ ^[1-9][0-9]*$ && -r /proc/$pid/comm ]]; then
            comm="$($PRESSLOG_CAT "/proc/$pid/comm" 2>/dev/null || true)"
          fi
        fi
        if [[ $comm == presslog ]]; then
          return 0
        fi
        "$PRESSLOG_RM" -f -- "$pidfile" "$status"
      }

      #@MNX-PART id=99.89.presslog-service.function.command-self-test kind=function title="Bash function command_self_test"
      command_self_test() {
        [[ -x $PRESSLOG_CORE ]] || die 'core executable is missing' 70
        local help_tmp
        help_tmp="$($PRESSLOG_MKTEMP)"
        if ! "$PRESSLOG_CORE" help > "$help_tmp"; then
          "$PRESSLOG_RM" -f -- "$help_tmp"
          die 'core help failed' 70
        fi
        if ! "$PRESSLOG_GREP" -Fq -- '--no-auto-expire' "$help_tmp"; then
          "$PRESSLOG_RM" -f -- "$help_tmp"
          die 'core durability switch is missing' 70
        fi
        if ! "$PRESSLOG_GREP" -Fq -- '--start-paused' "$help_tmp"; then
          "$PRESSLOG_RM" -f -- "$help_tmp"
          die 'core start-paused privacy switch is missing' 70
        fi
        "$PRESSLOG_RM" -f -- "$help_tmp"
        "$PRESSLOG_GREP" -Fq -- '--foreground' "$0" || die 'foreground service contract is missing' 70
        [[ "$("$PRESSLOG_GREP" -Fc -- '--start-paused' "$0")" -ge 2 ]] || die 'normal and burn service paths must both start paused' 70
        "$PRESSLOG_GREP" -Fq -- '--no-auto-expire' "$0" || die 'no-auto-expire service contract is missing' 70
        "$PRESSLOG_GREP" -Fq -- '--retain 36500' "$0" || die 'long prospective retention contract is missing' 70
        "$PRESSLOG_GREP" -Fq -- '--asker tty' "$0" || die 'pipe-fed tty asker contract is missing' 70
        "$PRESSLOG_GREP" -Fq 'PRESSLOG_PINENTRY_ADAPTER' "$0" || die 'source-owned pinentry adapter contract is missing' 70
        "$PRESSLOG_GREP" -Fq '< <(' "$0" || die 'anonymous pipe password transport is missing' 70
        local forbidden_asker='--asker ro'
        forbidden_asker+='fi'
        ! "$PRESSLOG_GREP" -Fq -- "$forbidden_asker" "$0" || die 'fragile rofi prompt returned to the service path' 70
        "$PRESSLOG_GREP" -Fq 'pinentry-config' "$0" || die 'private pinentry XDG configuration path is missing' 70
        "$PRESSLOG_GREP" -Fq 'clear_stale_run_state' "$0" || die 'stale volatile-state cleanup is missing' 70
        local forbidden_cleanup='tr'
        forbidden_cleanup+='ap '
        ! "$PRESSLOG_GREP" -Fq "$forbidden_cleanup" "$0" || die 'service self-test regained scope-unsafe cleanup trap' 70
        printf 'PRESSLOG_SERVICE_PINENTRY_PIPE_SELF_TEST=PASS\n'
        printf 'PRESSLOG_SERVICE_START_PAUSED_SELF_TEST=PASS\n'
        printf 'PRESSLOG_SERVICE_SELF_TEST=PASS\n'
      }

      #@MNX-PART id=99.89.presslog-service.function.main kind=function title="Bash function main"
      main() {
        local mode=''${1:-normal}
        if [[ $mode == self-test && ''${PRESSLOG_ALLOW_ROOT_FOR_TESTS:-0} == 1 ]]; then
          command_self_test
          return 0
        fi
        ensure_layout
        clear_stale_run_state
        prepare_session_environment
        case "$mode" in
          normal|burn) exec_capture "$mode" ;;
          self-test) command_self_test ;;
          *) die "unknown mode: $mode" 64 ;;
        esac
      }

      main "$@"
      '';
      checkPhase = ''
        set -Eeuo pipefail
        ${pkgs.bash}/bin/bash -n "$out"
        PRESSLOG_ALLOW_ROOT_FOR_TESTS=1 "$out" self-test
        ${pkgs.gnugrep}/bin/grep -Fq -- '--asker tty' "$out"
        [[ "$(${pkgs.gnugrep}/bin/grep -Fc -- '--start-paused' "$out")" -ge 2 ]]
        ${pkgs.gnugrep}/bin/grep -Fq '< <(' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'pinentry-config' "$out"
        ${pkgs.gnugrep}/bin/grep -Fq 'clear_stale_run_state' "$out"
        forbidden_asker='--asker ro'; forbidden_asker+='fi'
        ! ${pkgs.gnugrep}/bin/grep -Fq -- "$forbidden_asker" "$out"
      '';
    };
    mode = "0755";
  };
#@MNX-CHUNK id=99.91 slug=presslog-runtime-observer title="Presslog user services, metadata-only observer, and timer"
