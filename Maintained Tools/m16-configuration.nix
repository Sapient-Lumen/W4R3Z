  ########## tmux (riced) ##########
#@MNX-DEF path=programs.tmux section=30.40 role=policy ordinal=086
  programs.tmux = {
    enable = true;
    terminal = "xterm-kitty";

    extraConfig = ''
      set -g mouse on
      set -g history-limit 200000
      set -g renumber-windows on
      setw -g mode-keys vi
      set -g set-clipboard on
      set -as terminal-overrides ",xterm-kitty:RGB"
      set -g status-interval 2

      bind-key v split-window -h
      bind-key s split-window -v
    '';

    plugins = with pkgs.tmuxPlugins; [
      sensible
      yank
      resurrect
      continuum
      extrakto
    ];
  };

  ########## kitty: system-wide kittens + a little ricing ##########
#@MNX-DEF path=environment.etc."xdg/kitty/kitty.conf".text section=30.40 role=generated-config ordinal=087
  environment.etc."xdg/kitty/kitty.conf".text = ''
    map ctrl+shift+h kitten hints
    map ctrl+shift+c copy_to_clipboard
    map ctrl+shift+v paste_from_clipboard
  '';

  ##### Defeating ELF-hell #####
#@MNX-DEF path=programs.nix-ld.enable section=30.40 role=policy ordinal=088
  programs.nix-ld.enable = true;
#@MNX-DEF path=services.envfs.enable section=30.40 role=policy ordinal=089
  services.envfs.enable = true;


