#@MNX-PART id=90.00.monsterdesk.function.f023zh-cutover-rehearsal kind=function title="Python function rehearse_nicotine_cutover"
def rehearse_nicotine_cutover(session: Any, preflight: dict[str, Any], network: dict[str, Any]) -> dict[str, Any]:
    if not NICOTINE_CUTOVER_AUTHORIZED:
        raise MonsterdeskError("standing P2P cutover authority is not recorded")
    plan = network.get("cutover_plan", {})
    if plan.get("ready_for_operator_authorized_cutover") is not True:
        raise MonsterdeskError(f"Nicotine cutover plan is not ready: {canonical(plan.get('blockers', []))}")
    inputs = nicotine_cutover_inputs(preflight, require_accepted_hash=False)
    app_home = session._app_home("nicotine-live")
    if any(app_home.iterdir()):
        shutil.rmtree(app_home)
        app_home.mkdir(mode=0o700)
    try:
        lock_fd = acquire_nicotine_cutover_lock()
    except BlockingIOError as exc:
        raise MonsterdeskError("another Nicotine cutover or launcher owns the transaction lock") from exc
    launch_id: str | None = None
    launch_tree: list[dict[str, Any]] = []
    quiescence: dict[str, Any] | None = None
    report: dict[str, Any] = {}
    original_error: Exception | None = None
    try:
        try:
            stop_info = stop_legacy_nicotine(inputs)
            stationary = nicotine_stationary_config_identity()
            seed = prepare_nicotine_live_home(app_home, source_config_sha256=stationary["sha256"])
            os.environ["MNX_MONSTERDESK_CUTOVER_REHEARSAL"] = "1"
            launched = session.launch("nicotine-live")
            launch = launched["launch"]
            launch_id = str(launch["launch_id"])
            evidence_before_post_launch_hardening = verify_isolated_nicotine(launch, expected_home=app_home)
            post_launch_hardening = stabilize_nicotine_live_private_config_after_launch(app_home)
            evidence = verify_isolated_nicotine(launch, expected_home=app_home)
            launch_tree = birth_pinned_process_tree(int(launch["pid"]), int(launch["start_ticks"]))
            session.focus(int(launch["window_id"]), None)
            closed = session.close_active()
            if closed.get("terminated") is not True:
                raise MonsterdeskError("Nicotine rehearsal close was not confirmed")
            quiescence = quiesce_nicotine_launch(session, launch_id, launch_tree)
            report = {
                "schema": "mnx.nicotine.cutover-rehearsal.v2",
                "authority": "standing-p2p-security-delegation-plus-candidate-owned-mnx-test",
                "legacy_stop": {"confirmed": stop_info["stopped"], "method": stop_info["method"]},
                "private_state": {
                    "accepted_pre_stop_config_sha256": inputs["config_sha256"],
                    "historical_stage109_config_sha256": EXPECTED_NICOTINE_CONFIG_SHA256,
                    "copied_source_config_sha256": seed["source_config_sha256"],
                    "private_config_sha256": seed["private_config_sha256"],
                    "private_config_mode": seed["private_config_mode"],
                    "upnp_disabled": seed["upnp_disabled"],
                    "credentials_copied": seed["credentials_copied"],
                    "credential_values_exported": False,
                    "source_state_deleted": False,
                    "copy_mode": "archive-reflink-auto",
                    "post_launch_hardening": post_launch_hardening,
                },
                "isolated_runtime_before_post_launch_hardening": evidence_before_post_launch_hardening,
                "isolated_runtime": evidence,
                "persistent_launch_identity_preserved_during_post_launch_hardening": True,
                "isolated_close_confirmed": True,
                "launch_tree_record_count": len(launch_tree),
                "launch_tree_quiescence": quiescence,
                "host_port_released_before_restore": quiescence.get("host_port_released") is True,
                "router_state_mutated": False,
                "launcher_committed": False,
                "persistent_state_committed": False,
                "original_state_deleted": False,
                "concurrent_launcher_excluded": True,
            }
        except Exception as exc:
            original_error = exc
        finally:
            os.environ.pop("MNX_MONSTERDESK_CUTOVER_REHEARSAL", None)
            cleanup_error: Exception | None = None
            if quiescence is None:
                try:
                    quiescence = quiesce_nicotine_launch(session, launch_id, launch_tree)
                except Exception as exc:
                    cleanup_error = exc
            restore_error: Exception | None = None
            restored: dict[str, Any] | None = None
            try:
                restored = ensure_legacy_nicotine_running()
            except Exception as exc:
                restore_error = exc
            if cleanup_error is not None or restore_error is not None:
                raise MonsterdeskError(
                    "Nicotine cutover rehearsal recovery failed: "
                    f"quiescence={cleanup_error}; legacy_restore={restore_error}; original={original_error}"
                ) from original_error
            if restored is not None:
                report["legacy_restore"] = {
                    "confirmed": True,
                    "host_network_namespace": True,
                    "listener_port": restored["listener_port"],
                    "already_running": restored.get("already_running"),
                    "startup_diagnostics_bounded": restored.get("startup_diagnostics_bounded") is True,
                }
        if original_error is not None:
            raise original_error
        after_restore = nicotine_stationary_config_identity()
        report["source_config_after_restore_sha256"] = after_restore["sha256"]
        report["source_config_semantic_boundary_preserved"] = after_restore["semantic_boundary_matched"]
        report["source_config_byte_identity_may_change_on_clean_application_exit"] = True
        report["retry_used_current_stable_config_identity"] = True
        report["legacy_restored_before_test_success"] = True
        return report
    finally:
        release_nicotine_cutover_lock(lock_fd)

#@MNX-PART id=90.00.monsterdesk.function.f023zi-cutover-commit kind=function title="Python function commit_nicotine_cutover"
def commit_nicotine_cutover() -> dict[str, Any]:
    if os.environ.get("MNX_MONSTERDESK_POST_ACCEPTANCE") != "1":
        raise MonsterdeskError("Nicotine cutover commit requires sealed mnx-switch post-acceptance authority")
    if not NICOTINE_CUTOVER_AUTHORIZED:
        raise MonsterdeskError("standing P2P cutover authority is not recorded")
    previous_instance = os.environ.get("MONSTERDESK_INSTANCE")
    try:
        lock_fd = acquire_nicotine_cutover_lock()
    except BlockingIOError as exc:
        raise MonsterdeskError("another Nicotine cutover or launcher owns the transaction lock") from exc
    original_error: Exception | None = None
    result: dict[str, Any] = {}
    try:
        os.environ["MONSTERDESK_INSTANCE"] = "nicotine"
        existing = load_nicotine_cutover_receipt()
        if existing is not None:
            current = verify_committed_nicotine_cutover()
            status = call_daemon("status")
            refresh_required = status.get("build_revision") != BUILD_REVISION
            if not refresh_required:
                call_daemon("show")
                return {
                    "schema": "mnx.nicotine.cutover.v2", "status": "already-committed",
                    "receipt": existing, "runtime": current["runtime"],
                    "private_config_hardening": current.get("private_config_hardening"),
                    "runtime_build_revision": status.get("build_revision"),
                    "router_state_mutated": False,
                }
            stop_result = stop_session()
            if (stop_result.get("stopped") is not True
                    or stop_result.get("unit_inactive") is not True
                    or stop_result.get("socket_absent") is not True):
                raise MonsterdeskError("accepted Nicotine daemon was not proven stopped before runtime refresh")
            wait_for(nicotine_host_port_available, 20,
                     "TCP 2234 release before accepted Nicotine runtime refresh")
            refreshed_status = start_session(show=False)
            if refreshed_status.get("build_revision") != BUILD_REVISION:
                raise MonsterdeskError("refreshed Nicotine daemon did not publish the candidate build revision")
            refreshed_launch = call_daemon("launch", {"profile": "nicotine-live"})["launch"]
            app_home = nicotine_cutover_state_root() / "apps/nicotine-live/home"
            evidence_before_show = verify_isolated_nicotine(refreshed_launch, expected_home=app_home)
            call_daemon("show")
            running_after_show = [item for item in call_daemon("processes")["processes"]
                                  if item.get("launch_id") == refreshed_launch.get("launch_id")
                                  and item.get("profile") == "nicotine-live" and item.get("alive")]
            if len(running_after_show) != 1:
                raise MonsterdeskError("refreshed Nicotine launch did not remain birth-pinned after showing its viewer")
            evidence_after_show_before_hardening = verify_isolated_nicotine(
                running_after_show[0], expected_home=app_home
            )
            post_launch_hardening = stabilize_nicotine_live_private_config_after_launch(app_home)
            evidence = verify_isolated_nicotine(running_after_show[0], expected_home=app_home)
            hardened = verify_nicotine_live_seed(app_home, repair_hardening=False)
            refreshed_receipt = {
                **existing,
                "version": VERSION,
                "runtime_build_revision": BUILD_REVISION,
                "runtime_refreshed_at": time.time(),
                "private_config_current_sha256": hardened["private_config_current_sha256"],
                "private_config_hardening_reverified": True,
                "post_launch_private_config_hardening": post_launch_hardening,
                "runtime_reverified_after_refresh_show": True,
                "receipt_is_last_commit_point": True,
            }
            atomic_json(nicotine_cutover_receipt_path(), refreshed_receipt)
            os.chmod(nicotine_cutover_receipt_path(), 0o600)
            return {
                "schema": "mnx.nicotine.cutover.v2", "status": "accepted-runtime-refreshed",
                "receipt": refreshed_receipt,
                "runtime_before_refresh": current["runtime"],
                "runtime_before_show": evidence_before_show,
                "runtime_after_show_before_hardening": evidence_after_show_before_hardening,
                "runtime": evidence,
                "private_config_hardening": hardened.get("private_config_hardening"),
                "post_launch_private_config_hardening": post_launch_hardening,
                "persistent_launch_identity_preserved_during_post_launch_hardening": True,
                "runtime_build_revision": BUILD_REVISION,
                "receipt_is_last_commit_point": True,
                "router_state_mutated": False,
            }
        os.environ["MONSTERDESK_INSTANCE"] = previous_instance or "main"
        normalized_prestate = normalize_legacy_nicotine_cutover_prestate()
        inputs = normalized_prestate["inputs"]
        legacy_prestate = normalized_prestate["evidence"]
        stop_info = stop_legacy_nicotine(inputs)
        os.environ["MONSTERDESK_INSTANCE"] = "nicotine"
        stop_result = stop_session()
        if (stop_result.get("stopped") is not True
                or stop_result.get("unit_inactive") is not True
                or stop_result.get("socket_absent") is not True):
            raise MonsterdeskError("persistent Nicotine instance was not proven stopped before private-state replacement")
        profile_root = nicotine_cutover_state_root() / "apps/nicotine-live"
        if profile_root.exists() or profile_root.is_symlink():
            if profile_root.is_symlink() or not profile_root.is_dir():
                raise MonsterdeskError("stale Nicotine private profile root is unsafe")
            shutil.rmtree(profile_root)
        app_home = secure_dir(profile_root / "home")
        stationary = nicotine_stationary_config_identity()
        seed = prepare_nicotine_live_home(app_home, source_config_sha256=stationary["sha256"])
        start_session(show=False)
        launched = call_daemon("launch", {"profile": "nicotine-live"})
        launch = launched["launch"]
        evidence_before_show = verify_isolated_nicotine(launch, expected_home=app_home)
        call_daemon("show")
        running_after_show = [item for item in call_daemon("processes")["processes"]
                              if item.get("launch_id") == launch.get("launch_id")
                              and item.get("profile") == "nicotine-live" and item.get("alive")]
        if len(running_after_show) != 1:
            raise MonsterdeskError("isolated Nicotine launch did not remain birth-pinned after showing its viewer")
        evidence_after_show_before_hardening = verify_isolated_nicotine(
            running_after_show[0], expected_home=app_home
        )
        post_launch_hardening = stabilize_nicotine_live_private_config_after_launch(app_home)
        evidence = verify_isolated_nicotine(running_after_show[0], expected_home=app_home)
        hardened = verify_nicotine_live_seed(app_home, repair_hardening=False)
        receipt = {
            "schema": "mnx.nicotine.cutover-receipt.v1", "committed": True,
            "recorded_at": time.time(), "instance": "nicotine", "version": VERSION,
            "source_config_sha256": seed["source_config_sha256"],
            "accepted_stage109_config_sha256": EXPECTED_NICOTINE_CONFIG_SHA256,
            "private_config_sha256": seed["private_config_sha256"],
            "port": EXPECTED_NICOTINE_PORT, "host_interface": NICOTINE_HOST_INTERFACE,
            "router_mapping_policy": "external-manual-no-source-owned-mutation",
            "legacy_launcher_retained": True, "legacy_fallback_kind": "exact-nix-store-binary",
            "firejail_used_for_nicotine": False, "original_state_retained": True,
            "normal_launcher_replaced": True, "upnp_disabled": True,
            "share_access": "four-exact-read-only", "download_access": "one-exact-read-write",
            "remote_endpoints_exported": False, "credential_values_exported": False,
            "legacy_prestate_normalized": True,
            "private_config_current_sha256": hardened["private_config_current_sha256"],
            "post_launch_private_config_hardening": post_launch_hardening,
            "runtime_reverified_after_show": True, "receipt_is_last_commit_point": True,
        }
        atomic_json(nicotine_cutover_receipt_path(), receipt)
        os.chmod(nicotine_cutover_receipt_path(), 0o600)
        result = {
            "schema": "mnx.nicotine.cutover.v1", "status": "committed",
            "standing_authority": True,
            "legacy_prestate": legacy_prestate,
            "legacy_stop": {"confirmed": stop_info["stopped"], "method": stop_info["method"]},
            "private_state": {
                "source_config_sha256": seed["source_config_sha256"],
                "private_config_sha256": seed["private_config_sha256"],
                "private_config_mode": seed["private_config_mode"],
                "copy_mode": "archive-reflink-auto", "original_state_retained": True,
                "credentials_copied": True, "credential_values_exported": False,
            },
            "runtime": evidence, "runtime_before_show": evidence_before_show,
            "runtime_after_show_before_hardening": evidence_after_show_before_hardening,
            "post_launch_private_config_hardening": post_launch_hardening,
            "persistent_launch_identity_preserved_during_post_launch_hardening": True,
            "runtime_reverified_after_show": True, "receipt_is_last_commit_point": True,
            "normal_launcher_replaced": True,
            "legacy_launcher_retained": True, "legacy_fallback_kind": "exact-nix-store-binary",
            "firejail_used_for_nicotine": False, "router_state_mutated": False,
            "router_mapping_policy": "external-manual-no-source-owned-mutation",
            "rollback_performed": False,
        }
    except Exception as exc:
        original_error = exc
        os.environ["MONSTERDESK_INSTANCE"] = "nicotine"
        with contextlib.suppress(Exception):
            stop_session()
        with contextlib.suppress(FileNotFoundError):
            nicotine_cutover_receipt_path().unlink()
        restore_error: Exception | None = None
        os.environ["MONSTERDESK_INSTANCE"] = previous_instance or "main"
        try:
            cleanup_stale_nicotine_cutover_processes()
            wait_for(nicotine_host_port_available, 15,
                     "persistent isolated Nicotine TCP 2234 release before rollback")
            ensure_legacy_nicotine_running()
        except Exception as restore_exc:
            restore_error = restore_exc
        if restore_error is not None:
            raise MonsterdeskError(f"Nicotine cutover failed and legacy rollback also failed: cutover={exc}; rollback={restore_error}") from exc
    finally:
        if previous_instance is None:
            os.environ.pop("MONSTERDESK_INSTANCE", None)
        else:
            os.environ["MONSTERDESK_INSTANCE"] = previous_instance
        release_nicotine_cutover_lock(lock_fd)
    if original_error is not None:
        raise MonsterdeskError(f"Nicotine cutover failed; legacy application restored: {original_error}") from original_error
    if len(canonical(result).encode("utf-8")) > MAX_NICOTINE_CUTOVER_REPORT_BYTES:
        raise MonsterdeskError("Nicotine cutover report exceeds byte policy")
    return result


#@MNX-PART id=90.00.monsterdesk.function.f023zj-nicotine-launcher kind=function title="Python function nicotine_launcher"
def nicotine_launcher(arguments: list[str]) -> dict[str, Any]:
    previous_instance = os.environ.get("MONSTERDESK_INSTANCE")
    try:
        try:
            lock_fd = acquire_nicotine_cutover_lock()
        except BlockingIOError as exc:
            raise MonsterdeskError("Nicotine cutover is in progress; retry after the transaction completes") from exc
        receipt = load_nicotine_cutover_receipt()
        if receipt is None:
            if not NICOTINE_LEGACY.is_file() or not os.access(NICOTINE_LEGACY, os.X_OK):
                raise MonsterdeskError("Nicotine cutover is not committed and the legacy launcher is unavailable")
            os.execv(str(NICOTINE_LEGACY), [str(NICOTINE_LEGACY), *arguments])
        if arguments:
            raise MonsterdeskError("the isolated Nicotine launcher accepts no positional files or URLs")
        os.environ["MONSTERDESK_INSTANCE"] = "nicotine"
        start_session(show=True)
        running = [item for item in call_daemon("processes")["processes"]
                   if item.get("profile") == "nicotine-live" and item.get("alive")]
        if not running:
            running = [call_daemon("launch", {"profile": "nicotine-live"})["launch"]]
        return {"status": "isolated-running", "instance": "nicotine",
                "launch_id": running[0]["launch_id"], "viewer_shown": True,
                "legacy_fallback_used": False, "router_state_mutated": False}
    finally:
        if previous_instance is None:
            os.environ.pop("MONSTERDESK_INSTANCE", None)
        else:
            os.environ["MONSTERDESK_INSTANCE"] = previous_instance
        release_nicotine_cutover_lock(lock_fd)


#@MNX-PART id=90.00.monsterdesk.function.f024-prepare-guest-etc kind=function title="Python function prepare_guest_etc"
def prepare_guest_etc(root: Path) -> None:
    root.mkdir(mode=0o700)
    (root / "passwd").write_text(
        f"root:x:0:0:root:/root:/bin/bash\n{USER_NAME}:x:{USER_UID}:{USER_GID}:Monsterdesk:/home/{USER_NAME}:/bin/bash\n",
        encoding="utf-8",
    )
    (root / "group").write_text(f"root:x:0:\nusers:x:{USER_GID}:{USER_NAME}\n", encoding="utf-8")
    (root / "hosts").write_text("127.0.0.1 localhost monsterdesk\n::1 localhost monsterdesk\n", encoding="utf-8")
    (root / "resolv.conf").write_text("nameserver 127.0.0.1\n", encoding="utf-8")
    (root / "nsswitch.conf").write_text("passwd: files\ngroup: files\nhosts: files dns\n", encoding="utf-8")
    (root / "machine-id").write_text(secrets.token_hex(16) + "\n", encoding="ascii")
    (root / "os-release").write_text('NAME="Monsterdesk"\nID=monsterdesk\n', encoding="utf-8")
    (root / "shells").write_text("/bin/bash\n/bin/sh\n", encoding="utf-8")
    (root / "fonts").symlink_to(FONTCONFIG_ROOT, target_is_directory=True)
    for path in root.iterdir():
        st = path.lstat()
        if stat.S_ISREG(st.st_mode):
            os.chmod(path, 0o644)
        elif stat.S_ISDIR(st.st_mode):
            os.chmod(path, 0o755)


#@MNX-PART id=90.00.monsterdesk.function.f024a-normalize-x-hints kind=function title="Python function normalize_x_hints"
def normalize_x_hints(value: Any) -> dict[str, Any]:
    if value is None:
        return {}
    if isinstance(value, dict):
        return dict(value)
    data = getattr(value, "_data", None)
    if isinstance(data, dict):
        return dict(data)
    raise MonsterdeskError("X11 size hints are not dictionary-like")


#@MNX-PART id=90.00.monsterdesk.function.f025-safe-bind-directory kind=function title="Python function safe_bind_directory"
def safe_bind_directory(path: Path) -> bool:
    try:
        st = path.lstat()
    except OSError:
        return False
    return stat.S_ISDIR(st.st_mode) and not stat.S_ISLNK(st.st_mode)


#@MNX-PART id=90.00.monsterdesk.function.f025a-prepare-openbox-control kind=function title="Python function prepare_openbox_control"
def prepare_openbox_control(wm_home: Path, runtime: Path, operator_runtime: Path, executable: Path,
                            host_display: str, host_xauthority: Path, instance: str) -> dict[str, Path]:
    config_dir = wm_home / ".config/openbox"
    config_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    bridge = runtime / "wm-launch"
    # Openbox and its launch helpers share the existing bounded, live-drained pipe.
    menu_log = runtime / "openbox.log"
    bridge_text = (
        f"#!{BASH}\n"
        "set -Eeuo pipefail\n"
        "umask 077\n"
        "if [ \"$#\" -ne 1 ]; then echo 'usage: wm-launch terminal|nicotine-audit|close-active' >&2; exit 64; fi\n"
        "case \"$1\" in terminal|nicotine-audit|close-active) ;; *) echo 'profile rejected' >&2; exit 64;; esac\n"
        f"export HOME={shlex.quote(str(USER_HOME))}\n"
        f"export XDG_RUNTIME_DIR={shlex.quote(str(operator_runtime))}\n"
        f"export DISPLAY={shlex.quote(host_display)}\n"
        f"export XAUTHORITY={shlex.quote(str(host_xauthority))}\n"
        f"export MONSTERDESK_INSTANCE={shlex.quote(instance)}\n"
        "if [ \"$1\" = close-active ]; then\n"
        "  printf 'MONSTERDESK_WM_CLOSE target=active\\n'\n"
        f"  exec {shlex.quote(str(executable))} close-active\n"
        "fi\n"
        "printf 'MONSTERDESK_WM_LAUNCH profile=%s\\n' \"$1\"\n"
        f"exec {shlex.quote(str(executable))} launch \"$1\"\n"
    )
    atomic_text(bridge, bridge_text, 0o600)
    ready_script = runtime / "wm-ready"
    ready_file = runtime / "openbox.ready"
    atomic_text(ready_script,
                "set -Eeuo pipefail\numask 077\n"
                f"printf '%s\\n' \"$PPID\" > {shlex.quote(str(ready_file))}\n", 0o600)

    menu_path = config_dir / "menu.xml"
    rc_path = config_dir / "rc.xml"
    terminal_command = xml_escape(shlex.join([str(BASH), "--noprofile", "--norc", str(bridge), "terminal"]))
    nicotine_command = xml_escape(shlex.join([str(BASH), "--noprofile", "--norc", str(bridge), "nicotine-audit"]))
    close_command = xml_escape(shlex.join([str(BASH), "--noprofile", "--norc", str(bridge), "close-active"]))
    menu_file = xml_escape(str(menu_path))
    menu_text = f"""<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Monsterdesk">
    <item label="Private terminal  (Ctrl+Shift+F12)">
      <action name="Execute"><command>{terminal_command}</command><startupnotify><enabled>no</enabled></startupnotify></action>
    </item>
    <item label="Nicotine audit - offline">
      <action name="Execute"><command>{nicotine_command}</command><startupnotify><enabled>no</enabled></startupnotify></action>
    </item>
    <separator/>
    <item label="Close active private window  (Ctrl+Shift+F4)">
      <action name="Execute"><command>{close_command}</command><startupnotify><enabled>no</enabled></startupnotify></action>
    </item>
    <item label="Reconfigure private desktop"><action name="Reconfigure"/></item>
  </menu>
</openbox_menu>
"""
    rc_text = f"""<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse><focusLast>yes</focusLast><underMouse>no</underMouse><focusDelay>100</focusDelay><raiseOnFocus>no</raiseOnFocus></focus>
  <placement><policy>Smart</policy><center>no</center><monitor>Primary</monitor><primaryMonitor>1</primaryMonitor></placement>
  <theme><name>Clearlooks</name><titleLayout>NC</titleLayout><keepBorder>yes</keepBorder><animateIconify>no</animateIconify></theme>
  <desktops><number>1</number><firstdesk>1</firstdesk><names><name>Monsterdesk</name></names><popupTime>0</popupTime></desktops>
  <keyboard>
    <chainQuitKey>C-g</chainQuitKey>
    <keybind key="C-S-F12"><action name="Execute"><command>{terminal_command}</command></action></keybind>
    <keybind key="C-S-F10"><action name="Execute"><command>{nicotine_command}</command></action></keybind>
    <keybind key="C-S-F11"><action name="ShowMenu"><menu>root-menu</menu></action></keybind>
    <keybind key="C-S-F4"><action name="Execute"><command>{close_command}</command></action></keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
  </keyboard>
  <mouse>
    <dragThreshold>8</dragThreshold><doubleClickTime>500</doubleClickTime><screenEdgeWarpTime>0</screenEdgeWarpTime><screenEdgeWarpMouse>false</screenEdgeWarpMouse>
    <context name="Root"><mousebind button="Right" action="Press"><action name="ShowMenu"><menu>root-menu</menu></action></mousebind></context>
    <context name="Client"><mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind></context>
    <context name="Titlebar">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="Right" action="Drag"><action name="Resize"/></mousebind>
      <mousebind button="Middle" action="Press"><action name="Close"/></mousebind>
      <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize"/></mousebind>
    </context>
  </mouse>
  <menu><file>{menu_file}</file><hideDelay>200</hideDelay><middle>no</middle><submenuShowDelay>100</submenuShowDelay><submenuHideDelay>300</submenuHideDelay><applicationIcons>no</applicationIcons><manageDesktops>no</manageDesktops></menu>
  <applications/>
</openbox_config>
"""
    atomic_text(menu_path, menu_text, 0o600)
    atomic_text(rc_path, rc_text, 0o600)
    try:
        ET.fromstring(menu_text)
        ET.fromstring(rc_text)
    except ET.ParseError as exc:
        raise MonsterdeskError(f"source-owned Openbox XML is invalid: {exc}") from exc
    return {"bridge": bridge, "menu": menu_path, "rc": rc_path, "menu_log": menu_log,
            "ready_script": ready_script, "ready_file": ready_file}


#@MNX-PART id=90.00.monsterdesk.class.c004-session kind=class title="Python class Session"
class Session:
    #@MNX-PART id=90.00.monsterdesk.function.f026-init kind=function title="Python function __init__"
    def __init__(self, host_display: str, host_xauthority: Path) -> None:
        self.host_display = host_display
        self.host_xauthority = host_xauthority
        self.instance = instance_name()
        self.viewer_title = viewer_title(self.instance)
        self.runtime = runtime_root()
        self.state = state_base()
        self.status_file = status_path()
        self.display_number = 0
        self.display_name = ""
        self.auth_file = self.runtime / "Xauthority"
        self.socket_path = control_socket_path()
        self.viewer_window: int | None = None
        self.children: dict[str, tuple[subprocess.Popen[bytes], int]] = {}
        self.child_logs: dict[str, Path] = {}
        self.launches: dict[str, TrackedProcess] = {}
        self.launch_processes: dict[str, subprocess.Popen[bytes]] = {}
        self.recent_exits: list[dict[str, Any]] = []
        self.openbox_files: dict[str, Path] = {}
        self.wm_readiness: dict[str, Any] = {"ready": False, "startup_hook_seen": False}
        self.last_key_action: dict[str, Any] | None = None
        self.x11_probes: dict[str, dict[str, Any]] = {}
        self.stop_event = threading.Event()
        self.generation = 0
        self.started_at = time.time()
        self.lock_fd: int | None = None
        self.server: socket.socket | None = None
        self.x: xdisplay.Display | None = None

    #@MNX-PART id=90.00.monsterdesk.function.f027-spawn kind=function title="Python function spawn"
    def spawn(self, name: str, argv: list[str], *, env: dict[str, str] | None = None,
              output: int | Any = subprocess.DEVNULL, log_path: Path | None = None) -> subprocess.Popen[bytes]:
        stream = output
        stderr_stream = output
        if log_path is not None:
            log_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            stream = subprocess.PIPE
            stderr_stream = subprocess.STDOUT
        try:
            process = subprocess.Popen(
                argv,
                stdin=subprocess.DEVNULL,
                stdout=stream,
                stderr=stderr_stream,
                env=env,
                start_new_session=True,
            )
        except OSError as exc:
            raise MonsterdeskError(f"could not start {name}: {exc}") from exc
        if log_path is not None:
            if process.stdout is None:
                with contextlib.suppress(OSError):
                    os.killpg(process.pid, signal.SIGKILL)
                raise MonsterdeskError(f"could not establish bounded diagnostic pipe for {name}")
            self.child_logs[name] = log_path
            threading.Thread(
                target=drain_bounded_log, args=(process.stdout, log_path),
                name=f"monsterdesk-log-{name}", daemon=True,
            ).start()
        try:
            ticks = process_start_ticks(process.pid)
        except (OSError, ValueError, MonsterdeskError) as exc:
            with contextlib.suppress(Exception):
                process.wait(timeout=0.25)
            detail = bounded_log_tail(log_path)
            suffix = f"; diagnostic={detail}" if detail else ""
            raise MonsterdeskError(
                f"{name} exited before process identity could be pinned rc={process.poll()}{suffix}"
            ) from exc
        self.children[name] = (process, ticks)
        return process

    #@MNX-PART id=90.00.monsterdesk.function.f028-child-alive kind=function title="Python function child_alive"
    def child_alive(self, name: str) -> bool:
        record = self.children.get(name)
        return bool(record and record[0].poll() is None and process_matches(record[0].pid, record[1]))

    #@MNX-PART id=90.00.monsterdesk.function.f029-assert-infrastructure kind=function title="Python function assert_infrastructure"
    def assert_infrastructure(self) -> None:
        for name in ("Xephyr", "x-proxy", "dbus", "openbox"):
            if not self.child_alive(name):
                detail = bounded_log_tail(self.child_logs.get(name))
                suffix = f": {detail}" if detail else ""
                raise MonsterdeskError(f"private desktop infrastructure exited: {name}{suffix}")

    #@MNX-PART id=90.00.monsterdesk.function.f030-setup kind=function title="Python function setup"
    def setup(self) -> None:
        clean_known_runtime(self.runtime)
        os.chmod(self.runtime, 0o700)
        lock = self.runtime / "daemon.lock"
        self.lock_fd = os.open(lock, os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
        try:
            fcntl.flock(self.lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise MonsterdeskError("another Monsterdesk daemon owns the runtime") from exc

        self.display_number = find_display_number()
        self.display_name = f":{self.display_number}"
        cookie = secrets.token_bytes(16)
        write_xauthority(self.auth_file, socket.gethostname(), self.display_number, cookie)

        xenv = dict(os.environ)
        xenv.update({"DISPLAY": self.host_display, "XAUTHORITY": str(self.host_xauthority), "HOME": str(USER_HOME)})
        self.spawn(
            "Xephyr",
            [str(XEPHYR), self.display_name, "-screen", f"{SCREEN_WIDTH}x{SCREEN_HEIGHT}", "-resizeable",
             "-nolisten", "tcp", "-noreset", "-auth", str(self.auth_file), "-title", self.viewer_title],
            env=xenv,
        )
        real_socket = Path(f"/tmp/.X11-unix/X{self.display_number}")
        wait_for(lambda: real_socket.is_socket() and self.child_alive("Xephyr"), 15, "Xephyr socket")

        proxy_dir = self.runtime / "x11"
        proxy_dir.mkdir(mode=0o700)
        proxy_socket = proxy_dir / f"X{self.display_number}"
        self.spawn(
            "x-proxy",
            [str(SOCAT), f"UNIX-LISTEN:{proxy_socket},fork,unlink-early,mode=0600",
             f"UNIX-CONNECT:{real_socket}"],
        )
        wait_for(lambda: proxy_socket.is_socket() and self.child_alive("x-proxy"), 10, "private X proxy")

        guest_run = self.runtime / "guest-run"
        guest_run.mkdir(mode=0o700)
        guest_auth = guest_run / "Xauthority"
        write_xauthority(guest_auth, GUEST_HOSTNAME, self.display_number, cookie)
        # Same selector, deliberately wrong credential: native negative-control probe only.
        denied_cookie = bytes([cookie[0] ^ 1]) + cookie[1:]
        write_xauthority(guest_run / "Xauthority-denied", GUEST_HOSTNAME, self.display_number, denied_cookie)
        del cookie, denied_cookie
        bus = guest_run / "bus"
        bus_config = self.runtime / "dbus.conf"
        bus_config.write_text(
            "<busconfig>\n"
            "  <type>session</type>\n"
            f"  <listen>unix:path={bus}</listen>\n"
            "  <policy context=\"default\">\n"
            "    <allow send_destination=\"*\"/>\n"
            "    <allow receive_sender=\"*\"/>\n"
            "    <allow own=\"*\"/>\n"
            "  </policy>\n"
            "  <limit name=\"max_message_size\">8388608</limit>\n"
            "</busconfig>\n",
            encoding="utf-8",
        )
        os.chmod(bus_config, 0o600)
        self.spawn(
            "dbus",
            [str(DBUS_DAEMON), "--nofork", "--nopidfile", f"--config-file={bus_config}"],
        )
        wait_for(lambda: bus.is_socket() and self.child_alive("dbus"), 10, "private D-Bus")

        guest_etc = self.runtime / "guest-etc"
        prepare_guest_etc(guest_etc)

        wm_home = self.runtime / "openbox-home"
        wm_home.mkdir(mode=0o700)
        self.openbox_files = prepare_openbox_control(
            wm_home, self.runtime, runtime_base(), Path(__file__).resolve(), self.host_display, self.host_xauthority,
            self.instance
        )
        nested_env = display_env(self.display_name, self.auth_file)
        nested_env.update({
            "HOME": str(wm_home),
            "XDG_CONFIG_HOME": str(wm_home / ".config"),
            "DBUS_SESSION_BUS_ADDRESS": f"unix:path={bus}",
            "XDG_RUNTIME_DIR": str(guest_run),
        })
        self.spawn(
            "openbox",
            [str(OPENBOX), "--sm-disable", "--config-file", str(self.openbox_files["rc"]),
             "--startup", shlex.join([str(BASH), "--noprofile", "--norc", str(self.openbox_files["ready_script"])])],
            env=nested_env,
            log_path=self.runtime / "openbox.log",
        )

        os.environ["DISPLAY"] = self.display_name
        os.environ["XAUTHORITY"] = str(self.auth_file)
        wait_for(self._x_connectable, 10, "nested X connection")
        try:
            wait_for(self._openbox_ready, 15, "Openbox startup hook and exact loaded configuration")
        except MonsterdeskError as exc:
            raise MonsterdeskError(
                f"Openbox did not become ready: {canonical(self.wm_readiness)}; "
                f"diagnostic={bounded_log_tail(self.runtime / 'openbox.log')}"
            ) from exc
        self._discover_viewer_window()
        self.hide_viewer(best_effort=True)
        self._open_control_socket()
        self.write_status()

    #@MNX-PART id=90.00.monsterdesk.function.f031-x-connectable kind=function title="Python function _x_connectable"
    def _x_connectable(self) -> bool:
        try:
            candidate = xdisplay.Display(self.display_name)
            candidate.sync()
            if self.x is not None:
                self.x.close()
            self.x = candidate
            return True
        except Exception:
            return False

    #@MNX-PART id=90.00.monsterdesk.function.f031a-openbox-ready kind=function title="Python function _openbox_ready"
    def _openbox_ready(self) -> bool:
        # --startup is run after Openbox has installed its keyboard/mouse/menu handlers.
        # The early EWMH support-window property alone is not that completion signal.
        record: dict[str, Any] = {"ready": False, "startup_hook_seen": False,
                                  "source_owned_config_loaded": False}
        self.wm_readiness = record
        if self.x is None or not self.child_alive("openbox") or not self.openbox_files:
            return False
        expected_pid = self.children["openbox"][0].pid
        record["tracked_openbox_pid"] = expected_pid
        try:
            ready_file = self.openbox_files["ready_file"]
            st = ready_file.lstat()
            if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_size > 32:
                raise MonsterdeskError("unsafe Openbox startup receipt")
            with ready_file.open("rb") as handle:
                payload = handle.read(33)
            record["startup_hook_seen"] = payload == f"{expected_pid}\n".encode("ascii")
        except FileNotFoundError:
            pass
        root = self.x.screen().root
        prop = root.get_property(self.x.intern_atom("_OB_CONFIG_FILE"), X.AnyPropertyType, 0, 1024)
        if prop is not None and prop.format == 8 and prop.bytes_after == 0:
            value = prop.value
            loaded = value if isinstance(value, str) else bytes(value).decode("utf-8", errors="replace")
            record["loaded_config"] = loaded
            record["source_owned_config_loaded"] = loaded == str(self.openbox_files["rc"])
        record["ready"] = record["startup_hook_seen"] and record["source_owned_config_loaded"]
        return bool(record["ready"])

    #@MNX-PART id=90.00.monsterdesk.function.f032-host-xdotool kind=function title="Python function _host_xdotool"
    def _host_xdotool(self, arguments: list[str], timeout: float = 10) -> subprocess.CompletedProcess[bytes]:
        env = dict(os.environ)
        env.update({"DISPLAY": self.host_display, "XAUTHORITY": str(self.host_xauthority), "HOME": str(USER_HOME)})
        return run_checked([str(XDOTOOL), *arguments], env=env, timeout=timeout)

    #@MNX-PART id=90.00.monsterdesk.function.f033-nested-xdotool kind=function title="Python function _nested_xdotool"
    def _nested_xdotool(self, arguments: list[str], timeout: float = 10) -> subprocess.CompletedProcess[bytes]:
        env = dict(os.environ)
        env.update({"DISPLAY": self.display_name, "XAUTHORITY": str(self.auth_file), "HOME": str(USER_HOME)})
        return run_checked([str(XDOTOOL), *arguments], env=env, timeout=timeout)

    #@MNX-PART id=90.00.monsterdesk.function.f034-discover-viewer-window kind=function title="Python function _discover_viewer_window"
    def _discover_viewer_window(self) -> None:
        try:
            result = self._host_xdotool(
                ["search", "--sync", "--name", f"^{re.escape(self.viewer_title)}$"], 8
            )
            for line in result.stdout.decode("ascii", errors="strict").splitlines():
                value = int(line.strip())
                title = self._host_xdotool(["getwindowname", str(value)], 4).stdout.decode(
                    "utf-8", errors="replace"
                ).strip()
                if title == self.viewer_title:
                    self.viewer_window = value
                    return
        except (MonsterdeskError, ValueError, UnicodeError):
            pass
        self.viewer_window = None


    #@MNX-PART id=90.00.monsterdesk.function.f035-show-viewer kind=function title="Python function show_viewer"
    def show_viewer(self) -> dict[str, Any]:
        if self.viewer_window is None:
            self._discover_viewer_window()
        if self.viewer_window is None:
            raise MonsterdeskError("Monsterdesk viewer window was not found")
        self._host_xdotool(["windowmap", str(self.viewer_window), "windowactivate", "--sync", str(self.viewer_window)])
        return {"viewer_visible": True, "viewer_window": self.viewer_window}

    #@MNX-PART id=90.00.monsterdesk.function.f036-hide-viewer kind=function title="Python function hide_viewer"
    def hide_viewer(self, *, best_effort: bool = False) -> dict[str, Any]:
        try:
            if self.viewer_window is None:
                self._discover_viewer_window()
            if self.viewer_window is None:
                raise MonsterdeskError("Monsterdesk viewer window was not found")
            self._host_xdotool(["windowminimize", str(self.viewer_window)])
            return {"viewer_visible": False, "viewer_window": self.viewer_window}
        except MonsterdeskError:
            if best_effort:
                return {"viewer_visible": None, "viewer_window": self.viewer_window}
            raise

    #@MNX-PART id=90.00.monsterdesk.function.f037-open-control-socket kind=function title="Python function _open_control_socket"
    def _open_control_socket(self) -> None:
        if self.socket_path.exists() or self.socket_path.is_symlink():
            self.socket_path.unlink()
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(str(self.socket_path))
        os.chmod(self.socket_path, 0o600)
        server.listen(16)
        server.settimeout(0.5)
        self.server = server

    #@MNX-PART id=90.00.monsterdesk.function.f038-reap kind=function title="Python function reap"
    def reap(self) -> None:
        dead: list[str] = []
        for launch_id, tracked in list(self.launches.items()):
            process = self.launch_processes.get(launch_id)
            if (process is not None and process.poll() is not None) or not process_matches(tracked.pid, tracked.start_ticks):
                returncode = process.poll() if process is not None else None
                self.recent_exits.append({
                    "launch_id": launch_id,
                    "profile": tracked.profile,
                    "pid": tracked.pid,
                    "returncode": returncode,
                    "reason": "process-exited-after-ready",
                    "exited_at": time.time(),
                    "log_path": tracked.log_path,
                })
                self.recent_exits = self.recent_exits[-MAX_RECENT_EXITS:]
                dead.append(launch_id)
        for launch_id in dead:
            self.launches.pop(launch_id, None)
            self.launch_processes.pop(launch_id, None)
        if dead:
            self.write_status()

    #@MNX-PART id=90.00.monsterdesk.function.f039-status kind=function title="Python function status"
    def status(self) -> dict[str, Any]:
        infrastructure = {
            name: {
                "pid": record[0].pid,
                "start_ticks": record[1],
                "alive": record[0].poll() is None and process_matches(record[0].pid, record[1]),
            }
            for name, record in self.children.items()
            if not name.startswith("app:")
        }
        return {
            "schema": SCHEMA,
            "version": VERSION,
            "build_revision": BUILD_REVISION,
            "instance": self.instance,
            "state": "running" if not self.stop_event.is_set() else "stopping",
            "started_at": self.started_at,
            "display": self.display_name,
            "viewer_window": self.viewer_window,
            "control_socket": str(self.socket_path),
            "generation": self.generation,
            "infrastructure": infrastructure,
            "launches": [item.public() for item in self.launches.values()],
            "recent_exits": list(self.recent_exits),
            "diagnostic_log_limit_bytes": MAX_LOG_FILE_BYTES,
            "x11_authentication": {
                "policy": "fresh-nested-cookie-exact-familylocal-host-and-guest-records",
                "guest_hostname": GUEST_HOSTNAME,
                "wildcard_records": False,
                "host_cookie_donated": False,
                "cookie_bytes_exported": False,
                "probes": dict(self.x11_probes),
            },
            "openbox_policy": {
                "source_owned_config": True,
                "readiness": dict(self.wm_readiness),
                "ambient_system_menu_used": False,
                "rc": str(self.openbox_files.get("rc", "")),
                "menu": str(self.openbox_files.get("menu", "")),
            },
            "host_desktop_controlled": False,
            "host_display_donated_to_apps": False,
            "host_session_bus_donated_to_apps": False,
            "host_home_donated_to_apps": False,
            "network_default": "network-disabled-private-netns",
            "clipboard_bridge": False,
            "drag_drop_bridge": False,
            "audio_bridge": False,
            "foundation_status": "m16-lived-proof-before-reusable-product",
        }

    #@MNX-PART id=90.00.monsterdesk.function.f040-write-status kind=function title="Python function write_status"
    def write_status(self) -> None:
        with contextlib.suppress(Exception):
            atomic_json(self.status_file, self.status())

    #@MNX-PART id=90.00.monsterdesk.function.f041-capture kind=function title="Python function capture"
    def capture(self) -> dict[str, Any]:
        self.assert_infrastructure()
        try:
            image = ImageGrab.grab(xdisplay=self.display_name).convert("RGB")
        except Exception as exc:
            raise MonsterdeskError(f"nested desktop capture failed: {exc}") from exc
        if image.width * image.height > MAX_SCREEN_PIXELS:
            raise MonsterdeskError("nested desktop capture exceeds pixel limit")
        output = io.BytesIO()
        image.save(output, format="PNG")
        payload = output.getvalue()
        if len(payload) > MAX_SCREENSHOT_BYTES:
            raise MonsterdeskError("nested desktop capture exceeds byte limit")
        width, height = png_dimensions(payload)
        digest = hashlib.sha256(payload).hexdigest()
        return {
            "mime_type": "image/png",
            "width": width,
            "height": height,
            "bytes": len(payload),
            "sha256": digest,
            "data_base64": base64.b64encode(payload).decode("ascii"),
        }

    #@MNX-PART id=90.00.monsterdesk.function.f042-fence kind=function title="Python function _fence"
    def _fence(self, expected: str | None) -> dict[str, Any]:
        before = self.capture()
        if expected is not None:
            if not re.fullmatch(r"[0-9a-f]{64}", expected):
                raise FenceError("expected_frame_sha256 is malformed")
            if before["sha256"] != expected:
                raise FenceError("desktop frame changed; observe again before acting")
        return before

    #@MNX-PART id=90.00.monsterdesk.function.f043-pointer kind=function title="Python function pointer"
    def pointer(self) -> dict[str, Any]:
        if self.x is None:
            raise MonsterdeskError("nested X connection is unavailable")
        root = self.x.screen().root
        result = root.query_pointer()
        return {"x": int(result.root_x), "y": int(result.root_y), "mask": int(result.mask)}

    #@MNX-PART id=90.00.monsterdesk.function.f044-windows kind=function title="Python function windows"
    def windows(self) -> list[dict[str, Any]]:
        if self.x is None:
            raise MonsterdeskError("nested X connection is unavailable")
        root = self.x.screen().root
        atom = self.x.intern_atom("_NET_CLIENT_LIST", only_if_exists=True)
        ids: list[int] = []
        if atom:
            prop = root.get_full_property(atom, Xatom.WINDOW)
            if prop is not None:
                ids = [int(value) for value in prop.value]
        managed_ids = set(ids)
        if not ids:
            ids = [int(child.id) for child in root.query_tree().children]
        result: list[dict[str, Any]] = []
        for wid in ids[:MAX_WINDOWS]:
            try:
                window = self.x.create_resource_object("window", wid)
                attributes = window.get_attributes()
                geometry = window.get_geometry()
                root_x = int(geometry.x)
                root_y = int(geometry.y)
                with contextlib.suppress(Exception):
                    translated = root.translate_coords(window, 0, 0)
                    root_x = int(getattr(translated, "x", root_x))
                    root_y = int(getattr(translated, "y", root_y))
                title = window.get_wm_name() or ""
                wm_class = window.get_wm_class() or ()
                normal_hints: dict[str, Any] = {}
                with contextlib.suppress(Exception):
                    normal_hints = normalize_x_hints(window.get_wm_normal_hints())
                result.append({
                    "window_id": wid,
                    "title": str(title)[:512],
                    "class": [str(item)[:256] for item in wm_class],
                    "mapped": attributes.map_state == X.IsViewable,
                    "managed": wid in managed_ids,
                    "x": root_x,
                    "y": root_y,
                    "width": int(geometry.width),
                    "height": int(geometry.height),
                    "base_width": int(normal_hints.get("base_width", 0) or 0),
                    "base_height": int(normal_hints.get("base_height", 0) or 0),
                    "cell_width": int(normal_hints.get("width_inc", 0) or 0),
                    "cell_height": int(normal_hints.get("height_inc", 0) or 0),
                })
            except Exception:
                continue
        return result

    #@MNX-PART id=90.00.monsterdesk.function.f045-observe kind=function title="Python function observe"
    def observe(self, *, include_image: bool = True) -> dict[str, Any]:
        capture = self.capture()
        result = {
            "schema": "mnx.monsterdesk.observation.v2",
            "observed_at": time.time(),
            "generation": self.generation,
            "display": self.display_name,
            "pointer": self.pointer(),
            "windows": self.windows(),
            "frame": {key: value for key, value in capture.items() if key != "data_base64"},
            "human_agent_input_may_overlap": True,
            "action_fence": "pass frame.sha256 as expected_frame_sha256; mismatch requires re-observation",
            "host_desktop_observed": False,
        }
        if include_image:
            result["image"] = capture
        return result

    #@MNX-PART id=90.00.monsterdesk.function.f046-after-action kind=function title="Python function _after_action"
    def _after_action(self) -> dict[str, Any]:
        self.generation += 1
        time.sleep(0.12)
        self.write_status()
        return self.observe(include_image=False)

    #@MNX-PART id=90.00.monsterdesk.function.f047-move-pointer kind=function title="Python function _move_pointer"
    def _move_pointer(self, x: int, y: int) -> None:
        if not (0 <= x < SCREEN_WIDTH and 0 <= y < SCREEN_HEIGHT):
            raise MonsterdeskError("pointer coordinates are outside the private desktop")
        if self.x is None:
            raise MonsterdeskError("nested X connection is unavailable")
        self.x.screen().root.warp_pointer(x, y)
        self.x.sync()

    #@MNX-PART id=90.00.monsterdesk.function.f048-move kind=function title="Python function move"
    def move(self, x: int, y: int, expected: str | None) -> dict[str, Any]:
        self._fence(expected)
        self._move_pointer(x, y)
        return self._after_action()

    #@MNX-PART id=90.00.monsterdesk.function.f049-click kind=function title="Python function click"
    def click(self, x: int, y: int, button: int, expected: str | None) -> dict[str, Any]:
        if button not in (1, 2, 3):
            raise MonsterdeskError("button must be 1, 2, or 3")
        self._fence(expected)
        self._move_pointer(x, y)
        if self.x is None:
            raise MonsterdeskError("nested X connection is unavailable")
        xtest.fake_input(self.x, X.ButtonPress, button)
        self.x.sync()
        time.sleep(0.04)
        xtest.fake_input(self.x, X.ButtonRelease, button)
        self.x.sync()
        return self._after_action()


    #@MNX-PART id=90.00.monsterdesk.function.f050-type-text kind=function title="Python function type_text"
    def type_text(self, text: str, expected: str | None) -> dict[str, Any]:
        if not isinstance(text, str) or not text or len(text) > MAX_TEXT or "\x00" in text:
            raise MonsterdeskError(f"text must contain 1..{MAX_TEXT} non-NUL characters")
        self._fence(expected)
        self._nested_xdotool(["type", "--clearmodifiers", "--delay", "1", "--", text], timeout=30)
        return self._after_action()

    #@MNX-PART id=90.00.monsterdesk.function.f051-key kind=function title="Python function key"
    def key(self, chord: str, expected: str | None) -> dict[str, Any]:
        if not re.fullmatch(r"[A-Za-z0-9_+:-]{1,128}", chord):
            raise MonsterdeskError("key chord contains unsupported syntax")
        self._fence(expected)
        if self.x is None:
            raise MonsterdeskError("nested X connection is unavailable")
        focused = self.x.get_input_focus().focus
        self.last_key_action = {
            "chord": chord, "display": self.display_name,
            "focus_window_before": int(getattr(focused, "id", focused)),
            "modifier_mask_before": self.pointer()["mask"],
            "delivery": "pending", "application_handling_proved": False,
        }
        try:
            result = self._nested_xdotool(["key", "--clearmodifiers", chord], timeout=15)
            diagnostic = result.stderr[:MAX_LOG_TAIL_BYTES].decode("utf-8", errors="replace")
            self.last_key_action.update({"returncode": result.returncode, "stderr": diagnostic,
                                         "modifier_mask_after": self.pointer()["mask"]})
            if "No such key name" in diagnostic or "Ignoring it" in diagnostic:
                raise MonsterdeskError(f"xdotool rejected part of the key chord: {diagnostic}")
            self.last_key_action["delivery"] = "sent-not-confirmed-handled"
        except (MonsterdeskError, OSError, subprocess.TimeoutExpired) as exc:
            self.last_key_action.update({"delivery": "failed", "reason": str(exc)[:1000]})
            raise
        observation = self._after_action()
        observation["key_delivery"] = dict(self.last_key_action)
        return observation

    #@MNX-PART id=90.00.monsterdesk.function.f052-focus kind=function title="Python function focus"
    def focus(self, window_id: int, expected: str | None) -> dict[str, Any]:
        if window_id <= 0:
            raise MonsterdeskError("window_id must be positive")
        self._fence(expected)
        self._nested_xdotool(["windowactivate", "--sync", str(window_id)], timeout=10)
        return self._after_action()

    #@MNX-PART id=90.00.monsterdesk.function.f053-app-home kind=function title="Python function _app_home"
    def _app_home(self, profile: str) -> Path:
        root = secure_dir(self.state / "apps")
        profile_root = secure_dir(root / profile)
        return secure_dir(profile_root / "home")

    #@MNX-PART id=90.00.monsterdesk.function.f054-bwrap-command kind=function title="Python function bwrap_command"
    def bwrap_command(self, profile: str) -> tuple[list[str], dict[str, Any]]:
        app_home = self._app_home(profile)
        host_binds: list[tuple[Path, str, bool]] = []
        network_enabled = False
        network_functionality_expected = False
        purpose = "private-desktop-and-filesystem-boundary-proof; not a public-peer replacement"
        if profile == "terminal":
            command = [
                str(XTERM), "-title", "Monsterdesk Terminal", "-fa", "DejaVu Sans Mono", "-fs", "10",
                "-geometry", "96x30", "-e", "/bin/bash", "--noprofile", "--norc", "-i",
            ]
            seed = None
            filesystem_mode = "empty-root-store-private-home-explicit-shell"
        elif profile == "nicotine-audit":
            seed = seed_nicotine_home(app_home)
            command = [str(NICOTINE)]
            host_binds = [
                (Path("/mnt/torrents"), "read-only", False),
                (Path("/mnt/m16-new-storage/public-share"), "read-only", False),
            ]
            filesystem_mode = "empty-root-store-private-home-read-only-public-shares"
        elif profile == "nicotine-preflight":
            seed = seed_nicotine_preflight_home(app_home)
            command = [
                str(NICOTINE), "--isolated", "--ci-mode",
                "--config", str(USER_HOME / ".config/nicotine/config"),
                "--user-data", str(USER_HOME / ".local/share/nicotine"),
            ]
            filesystem_mode = "empty-root-store-private-sanitized-nicotine-config-no-host-shares"
        elif profile == "nicotine-live":
            seed = verify_nicotine_live_seed(app_home)
            command = [
                str(BASH), "--noprofile", "--norc", "-c",
                'umask 077; exec "$@"', "monsterdesk-nicotine-live",
                str(NICOTINE), "--isolated",
                "--config", str(USER_HOME / ".config/nicotine/config"),
                "--user-data", str(USER_HOME / ".local/share/nicotine"),
            ]
            host_binds = nicotine_live_bind_specs()
            filesystem_mode = (
                "empty-root-store-private-copied-nicotine-state-"
                "four-read-only-shares-one-read-write-download"
            )
            network_enabled = True
            network_functionality_expected = True
            purpose = "isolated-public-peer-service-with-exact-tcp2234-and-filesystem-grants"
        elif profile == "qbittorrent-live":
            seed = verify_qbittorrent_live_seed(app_home)
            command = [
                str(BASH), "--noprofile", "--norc", "-c",
                'umask 077; exec "$@"', "monsterdesk-qbittorrent-live",
                str(QBITTORRENT), "--no-splash",
            ]
            host_binds = qbittorrent_live_bind_specs()
            filesystem_mode = (
                "empty-root-store-private-copied-qbittorrent-state-"
                "two-read-write-payload-roots"
            )
            network_enabled = True
            network_functionality_expected = True
            purpose = (
                "isolated-qbittorrent-peer-service-with-"
                "interface-bound-tcp-udp-and-loopback-only-webui"
            )
        else:
            raise MonsterdeskError(
                "profile must be terminal, nicotine-audit, or an internal reviewed profile"
            )

        guest_run = self.runtime / "guest-run"
        guest_etc = self.runtime / "guest-etc"
        proxy_dir = self.runtime / "x11"
        if not all(safe_bind_directory(path) for path in (guest_run, guest_etc, proxy_dir, app_home)):
            raise MonsterdeskError("sandbox source directory failed validation")

        # Mount points beneath the private home must exist inside the backing tree
        # before Bubblewrap overlays exact host grants at the same absolute paths.
        for source, _mode, required in host_binds:
            if not safe_bind_directory(source):
                if required:
                    raise MonsterdeskError(f"required sandbox bind source is unavailable: {source}")
                continue
            try:
                relative = source.relative_to(USER_HOME)
            except ValueError:
                continue
            target = app_home / relative
            target.mkdir(parents=True, exist_ok=True, mode=0o700)

        server_host_bootstrap: dict[str, Any] | None = None
        if profile == "nicotine-live":
            server_host_bootstrap = prepare_nicotine_server_hosts(guest_etc)

        argv = [
            str(BWRAP),
            "--die-with-parent", "--new-session",
            "--unshare-user", "--unshare-pid", "--unshare-ipc", "--unshare-uts", "--unshare-cgroup-try",
        ]
        if not network_enabled:
            argv.append("--unshare-net")
        argv.extend([
            "--cap-drop", "ALL",
            "--ro-bind", "/nix/store", "/nix/store",
            "--proc", "/proc", "--dev", "/dev",
            "--tmpfs", "/tmp", "--dir", "/tmp/.X11-unix", "--ro-bind", str(proxy_dir), "/tmp/.X11-unix",
            "--tmpfs", "/run", "--dir", "/run/user", "--dir", f"/run/user/{USER_UID}",
            "--dir", "/run/monsterdesk-control", "--ro-bind", str(guest_run), "/run/monsterdesk-control",
            "--ro-bind", str(guest_etc), "/etc",
            "--dir", "/bin", "--symlink", str(BASH), "/bin/bash", "--symlink", str(BASH), "/bin/sh",
            "--dir", "/usr", "--dir", "/usr/bin", "--symlink", str(ENV), "/usr/bin/env",
            "--dir", "/home", "--dir", str(USER_HOME), "--bind", str(app_home), str(USER_HOME),
            "--dir", "/mnt", "--dir", "/var", "--tmpfs", "/var/tmp",
        ])
        if profile in {"nicotine-live", "qbittorrent-live"}:
            resolv_file = app_home / ".monsterdesk-resolv.conf"
            atomic_text(resolv_file, f"nameserver {NICOTINE_DNS_FORWARD}\noptions timeout:2 attempts:2\n", 0o644)
            argv.extend(["--ro-bind", str(resolv_file), "/etc/resolv.conf"])

        created_targets: set[Path] = {Path("/mnt"), Path("/var"), Path("/home"), USER_HOME}
        for source, mode, required in host_binds:
            if not safe_bind_directory(source):
                if required:
                    raise MonsterdeskError(f"required sandbox bind source is unavailable: {source}")
                continue
            try:
                source.relative_to(USER_HOME)
            except ValueError:
                parent = Path("/")
                for component in source.parts[1:]:
                    parent = parent / component
                    if parent not in created_targets:
                        argv.extend(["--dir", str(parent)])
                        created_targets.add(parent)
            bind_flag = "--ro-bind" if mode == "read-only" else "--bind"
            argv.extend([bind_flag, str(source), str(source)])

        env_values = {
            "HOME": str(USER_HOME),
            "USER": USER_NAME,
            "LOGNAME": USER_NAME,
            "SHELL": "/bin/bash",
            "PATH": ":".join([str(COREUTILS_BIN), str(FINDUTILS_BIN), str(PROCPS_BIN), str(UTIL_LINUX_BIN),
                                      str(BASH.parent), str(ENV.parent), str(XTERM.parent),
                                      str(NICOTINE.parent), str(QBITTORRENT.parent)]),
            "DISPLAY": self.display_name,
            "XAUTHORITY": "/run/monsterdesk-control/Xauthority",
            "XDG_RUNTIME_DIR": f"/run/user/{USER_UID}",
            "DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/monsterdesk-control/bus",
            "XDG_CONFIG_HOME": str(USER_HOME / ".config"),
            "XDG_CACHE_HOME": str(USER_HOME / ".cache"),
            "XDG_DATA_HOME": str(USER_HOME / ".local/share"),
            "XDG_STATE_HOME": str(USER_HOME / ".local/state"),
            "SSL_CERT_FILE": str(CA_BUNDLE),
            "NIX_SSL_CERT_FILE": str(CA_BUNDLE),
            "FONTCONFIG_FILE": str(FONTCONFIG_ROOT / "fonts.conf"),
            "FONTCONFIG_PATH": str(FONTCONFIG_ROOT),
            "LANG": "C.UTF-8",
            "LC_ALL": "C.UTF-8",
        }
        argv.append("--clearenv")
        for key, value in env_values.items():
            argv.extend(["--setenv", key, value])
        argv.extend(["--hostname", GUEST_HOSTNAME, "--chdir", str(USER_HOME), "--", *command])
        if profile == "nicotine-live":
            argv = [*nicotine_pasta_options(EXPECTED_NICOTINE_PORT), "--", *argv]
            network_mode = "pasta-private-netns-host-enp4s0-tcp2234-only"
            public_tcp_ports = [EXPECTED_NICOTINE_PORT]
            public_udp_ports: list[int] = []
            webui_host_endpoint = None
        elif profile == "qbittorrent-live":
            argv = [*qbittorrent_pasta_options(), "--", *argv]
            network_mode = "pasta-private-netns-enp4s0-tcp-udp1429-loopback-webui1234"
            public_tcp_ports = [EXPECTED_QBITTORRENT_LISTEN_PORT]
            public_udp_ports = [EXPECTED_QBITTORRENT_LISTEN_PORT]
            webui_host_endpoint = f"127.0.0.1:{EXPECTED_QBITTORRENT_WEBUI_PORT}"
        else:
            network_mode = "network-disabled-private-netns"
            public_tcp_ports = []
            public_udp_ports = []
            webui_host_endpoint = None
        metadata = {
            "profile": profile,
            "network_mode": network_mode,
            "network_functionality_expected": network_functionality_expected,
            "public_tcp_ports": public_tcp_ports,
            "public_udp_ports": public_udp_ports,
            "webui_host_endpoint": webui_host_endpoint,
            "host_gateway_mapping": False,
            "host_loopback_mapping": False,
            "filesystem_mode": filesystem_mode,
            "host_display_donated": False,
            "host_session_bus_donated": False,
            "host_home_donated": False,
            "clipboard_bridge": False,
            "audio_bridge": False,
            "seed": seed,
            "server_host_bootstrap": server_host_bootstrap,
            "purpose": purpose,
        }
        return argv, metadata


    #@MNX-PART id=90.00.monsterdesk.function.f054a-probe-capsule-x11 kind=function title="Python function probe_capsule_x11"
    def probe_capsule_x11(self, profile: str, argv: list[str]) -> None:
        boundary = len(argv) - 1 - argv[::-1].index("--")
        prefix = list(argv[:boundary])
        public_port_probe_suppressed = False
        if profile in {"nicotine-live", "qbittorrent-live"}:
            # Prove Xauthority through the same pasta-owned namespace and Bubblewrap
            # filesystem policy without repeatedly taking the reviewed live ports.
            try:
                pasta_boundary = prefix.index("--")
            except ValueError as exc:
                raise MonsterdeskError(f"{profile} X11 probe has no pasta/Bubblewrap boundary") from exc
            pasta_args = prefix[:pasta_boundary]
            bubble_args = prefix[pasta_boundary + 1:]
            rewritten: list[str] = []
            seen: set[str] = set()
            index = 0
            while index < len(pasta_args):
                token = pasta_args[index]
                if token in {"--tcp-ports", "--udp-ports"}:
                    if index + 1 >= len(pasta_args):
                        raise MonsterdeskError(f"{profile} X11 probe port policy is truncated")
                    if token not in seen:
                        rewritten.extend([token, "none"])
                        seen.add(token)
                    index += 2
                    continue
                rewritten.append(token)
                index += 1
            if "--tcp-ports" not in seen or (profile == "qbittorrent-live" and "--udp-ports" not in seen):
                raise MonsterdeskError(f"{profile} X11 probe has incomplete pasta port policy")
            prefix = [*rewritten, "--", *bubble_args]
            public_port_probe_suppressed = True
        command = [str(XDPYINFO), "-display", self.display_name]
        record: dict[str, Any] = {
            "state": "checking", "client": "xdpyinfo", "guest_hostname": GUEST_HOSTNAME,
            "same_filesystem_x11_policy": True,
            "public_port_probe_suppressed": public_port_probe_suppressed,
            "positive_before": False,
            "wrong_cookie_rejected": False, "positive_after": False,
            "cookie_bytes_exported": False,
        }
        self.x11_probes[profile] = record
        try:
            run_checked([*prefix, "--", *command], timeout=4)
            record["positive_before"] = True
            denied = subprocess.run(
                [*prefix, "--setenv", "XAUTHORITY", "/run/monsterdesk-control/Xauthority-denied", "--", *command],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                timeout=4, check=False,
            )
            diagnostic = denied.stderr.decode("utf-8", errors="replace")
            if denied.returncode == 0 or not any(token in diagnostic for token in (
                "Invalid MIT-MAGIC-COOKIE-1 key", "Authorization required", "Authorization failed",
            )):
                raise MonsterdeskError("native wrong-cookie probe did not prove X authentication refusal")
            record["wrong_cookie_rejected"] = True
            run_checked([*prefix, "--", *command], timeout=4)
            record["positive_after"] = True
            record["state"] = "pass"
        except (MonsterdeskError, OSError, subprocess.TimeoutExpired) as exc:
            record["state"] = "failed"
            record["reason"] = str(exc)[:1000]
            raise MonsterdeskError(f"native X11 probe failed inside {profile} capsule: {exc}") from exc
        finally:
            self.write_status()


    #@MNX-PART id=90.00.monsterdesk.function.f055-launch kind=function title="Python function launch"
    def launch(self, profile: str) -> dict[str, Any]:
        self.reap()
        if profile == "nicotine-preflight" and not instance_name().startswith("acceptance-"):
            raise MonsterdeskError("nicotine-preflight is internal to candidate-active live acceptance")
        if profile == "nicotine-live":
            allowed_instance = instance_name() == "nicotine"
            allowed_rehearsal = (instance_name().startswith("acceptance-")
                                 and os.environ.get("MNX_MONSTERDESK_CUTOVER_REHEARSAL") == "1")
            if not (allowed_instance or allowed_rehearsal):
                raise MonsterdeskError("nicotine-live requires the dedicated persistent instance or candidate-owned rehearsal")
        if profile == "qbittorrent-live":
            allowed_instance = instance_name() == "qbittorrent"
            allowed_rehearsal = (instance_name().startswith("acceptance-")
                                 and os.environ.get("MNX_MONSTERDESK_QBITTORRENT_REHEARSAL") == "1")
            if not (allowed_instance or allowed_rehearsal):
                raise MonsterdeskError("qbittorrent-live requires the dedicated persistent instance or candidate-owned rehearsal")
        if not self._openbox_ready():
            raise MonsterdeskError(f"private window manager is not ready: {canonical(self.wm_readiness)}")
        if profile != "terminal":
            for tracked in self.launches.values():
                if tracked.profile == profile and process_matches(tracked.pid, tracked.start_ticks):
                    raise MonsterdeskError(f"profile already running: {profile}")
        before_windows = {item["window_id"] for item in self.windows() if item.get("mapped")}
        argv, metadata = self.bwrap_command(profile)
        self.probe_capsule_x11(profile, argv)
        token = secrets.token_hex(4)
        child_name = f"app:{profile}:{token}"
        log_path = self.runtime / "logs" / f"{profile}-{token}.log"
        process = self.spawn(child_name, argv, log_path=log_path)
        ticks = self.children[child_name][1]
        launch_id = f"{profile}-{process.pid}-{ticks}-{secrets.token_hex(4)}"
        tracked = TrackedProcess(
            launch_id=launch_id,
            profile=profile,
            pid=process.pid,
            start_ticks=ticks,
            started_at=time.time(),
            network_mode=metadata["network_mode"],
            filesystem_mode=metadata["filesystem_mode"],
            log_path=str(log_path),
            window_ready=False,
        )
        self.launches[launch_id] = tracked
        self.launch_processes[launch_id] = process
        deadline = time.monotonic() + (90.0 if profile == "qbittorrent-live"
                                       else 45.0 if profile.startswith("nicotine-") else 6.0)
        while time.monotonic() < deadline:
            if process.poll() is not None or not process_matches(process.pid, ticks):
                break
            visible = [
                item for item in self.windows()
                if item.get("mapped") and item.get("managed")
                and item.get("width", 0) > 20 and item.get("height", 0) > 20
                and item.get("window_id") not in before_windows
            ]
            if visible:
                tracked.window_id = int(visible[0]["window_id"])
                tracked.window_ready = True
                break
            time.sleep(0.10)
        if process.poll() is not None or not process_matches(process.pid, ticks):
            returncode = process.poll()
            detail = bounded_log_tail(log_path)
            self.recent_exits.append({
                "launch_id": launch_id, "profile": profile, "pid": process.pid,
                "returncode": returncode, "reason": "process-exited-before-window",
                "exited_at": time.time(), "log_path": str(log_path),
            })
            self.recent_exits = self.recent_exits[-MAX_RECENT_EXITS:]
            self.launches.pop(launch_id, None)
            self.launch_processes.pop(launch_id, None)
            self.write_status()
            suffix = f"; diagnostic={detail}" if detail else ""
            raise MonsterdeskError(f"sandboxed profile exited during launch: {profile} rc={returncode}{suffix}")
        if not tracked.window_ready:
            detail = bounded_log_tail(log_path)
            with contextlib.suppress(OSError):
                os.killpg(process.pid, signal.SIGTERM)
            self.recent_exits.append({
                "launch_id": launch_id, "profile": profile, "pid": process.pid,
                "returncode": process.poll(), "reason": "mapped-window-timeout",
                "exited_at": time.time(), "log_path": str(log_path),
            })
            self.recent_exits = self.recent_exits[-MAX_RECENT_EXITS:]
            self.launches.pop(launch_id, None)
            self.launch_processes.pop(launch_id, None)
            self.write_status()
            suffix = f"; diagnostic={detail}" if detail else ""
            raise MonsterdeskError(f"sandboxed profile produced no mapped window: {profile}{suffix}")
        # Openbox may place equal-sized windows at the same coordinates; make concurrent
        # private applications visibly distinct without trusting host-window placement.
        ordinal = sum(1 for item in self.launches.values()
                      if item.launch_id != launch_id and item.window_ready)
        cascade_x = 40 + (ordinal % 8) * 56
        cascade_y = 48 + (ordinal % 8) * 44
        self._nested_xdotool(["windowmove", str(tracked.window_id), str(cascade_x), str(cascade_y)], timeout=10)
        self.generation += 1
        self.write_status()
        return {
            "launch": tracked.public(),
            "boundary": metadata,
            "network_functionality_expected": bool(metadata.get("network_functionality_expected")),
            "purpose": metadata.get("purpose"),
        }

    #@MNX-PART id=90.00.monsterdesk.function.f056-processes kind=function title="Python function processes"
    def processes(self) -> list[dict[str, Any]]:
        self.reap()
        return [item.public() for item in self.launches.values()]

    #@MNX-PART id=90.00.monsterdesk.function.f056a-diagnostics kind=function title="Python function diagnostics"
    def diagnostics(self) -> dict[str, Any]:
        self.reap()
        active = []
        for launch_id, tracked in self.launches.items():
            active.append({
                "launch": tracked.public(),
                "log_tail": bounded_log_tail(Path(tracked.log_path)),
            })
        return {
            "schema": "mnx.monsterdesk.diagnostics.v1",
            "version": VERSION,
            "active": active,
            "recent_exits": [
                {**item, "log_tail": bounded_log_tail(Path(str(item["log_path"])))}
                for item in self.recent_exits
            ],
            "openbox_log_tail": bounded_log_tail(self.runtime / "openbox.log"),
            "menu_action_log_tail": bounded_log_tail(self.openbox_files.get("menu_log")),
            "menu_action_log_source": "shared-bounded-openbox-pipe",
            "openbox_readiness": dict(self.wm_readiness),
            "last_key_action": self.last_key_action,
            "x11_probes": dict(self.x11_probes),
            "diagnostic_log_limit_bytes": MAX_LOG_FILE_BYTES,
            "ambient_system_menu_used": False,
        }


    #@MNX-PART id=90.00.monsterdesk.function.f057-terminate kind=function title="Python function terminate"
    def terminate(self, launch_id: str, signal_name: str) -> dict[str, Any]:
        self.reap()
        tracked = self.launches.get(launch_id)
        if tracked is None:
            raise MonsterdeskError("unknown launch_id")
        if not process_matches(tracked.pid, tracked.start_ticks):
            self.reap()
            raise MonsterdeskError("tracked launch is no longer alive")
        allowed = {"TERM": signal.SIGTERM, "INT": signal.SIGINT, "KILL": signal.SIGKILL, "HUP": signal.SIGHUP}
        if signal_name not in allowed:
            raise MonsterdeskError("signal must be TERM, INT, KILL, or HUP")
        try:
            os.killpg(tracked.pid, allowed[signal_name])
        except ProcessLookupError:
            pass
        except OSError as exc:
            raise MonsterdeskError(f"could not signal tracked launch: {exc}") from exc
        process = self.launch_processes.get(launch_id)
        deadline = time.monotonic() + (2.0 if signal_name == "KILL" else 0.75)
        while time.monotonic() < deadline:
            if (process is not None and process.poll() is not None) or not process_matches(tracked.pid, tracked.start_ticks):
                break
            time.sleep(0.05)
        alive = bool((process is None or process.poll() is None)
                     and process_matches(tracked.pid, tracked.start_ticks))
        self.generation += 1
        if alive:
            self.write_status()
        else:
            self.reap()
        return {
            "signal_sent": True,
            "terminated": not alive,
            "alive": alive,
            "launch_id": launch_id,
            "signal": signal_name,
        }

    #@MNX-PART id=90.00.monsterdesk.function.f057a-close-active kind=function title="Python function close_active"
    def close_active(self) -> dict[str, Any]:
        self.reap()
        live = [item for item in self.launches.values() if process_matches(item.pid, item.start_ticks)]
        if not live:
            raise MonsterdeskError("no tracked private application is running")
        focused_id: int | None = None
        if self.x is not None:
            focused = self.x.get_input_focus().focus
            focused_id = int(getattr(focused, "id", focused))
        selected = next((item for item in live if item.window_id == focused_id), None)
        selection = "focused"
        if selected is None:
            selected = max(live, key=lambda item: item.started_at)
            selection = "newest-fallback"
        attempts: list[dict[str, Any]] = []
        process = self.launch_processes.get(selected.launch_id)
        close_method: str | None = None
        if selected.window_id is not None:
            try:
                self._nested_xdotool(["windowclose", str(selected.window_id)], timeout=10)
            except MonsterdeskError as exc:
                attempts.append({"method": "wm-delete", "sent": False, "error": str(exc)[:512]})
            else:
                deadline = time.monotonic() + 4.0
                while time.monotonic() < deadline:
                    if (process is not None and process.poll() is not None) or not process_matches(selected.pid, selected.start_ticks):
                        break
                    time.sleep(0.05)
                exited = bool((process is not None and process.poll() is not None)
                              or not process_matches(selected.pid, selected.start_ticks))
                attempts.append({"method": "wm-delete", "sent": True, "terminated": exited})
                if exited:
                    close_method = "wm-delete"
        if close_method is None:
            term_result = self.terminate(selected.launch_id, "TERM")
            attempts.append({"method": "term", "sent": True,
                             "terminated": bool(term_result.get("terminated"))})
            if term_result.get("terminated") is True:
                close_method = "term"
        if close_method is None:
            kill_result = self.terminate(selected.launch_id, "KILL")
            attempts.append({"method": "kill", "sent": True,
                             "terminated": bool(kill_result.get("terminated"))})
            if kill_result.get("terminated") is True:
                close_method = "kill"
        process = self.launch_processes.get(selected.launch_id)
        alive = bool((process is None or process.poll() is None)
                     and process_matches(selected.pid, selected.start_ticks))
        if alive or close_method is None:
            raise MonsterdeskError(
                f"tracked private application did not close after bounded escalation: {canonical(attempts)}"
            )
        self.reap()
        return {
            "terminated": True,
            "launch_id": selected.launch_id,
            "selection": selection,
            "focused_window_id": focused_id,
            "window_id": selected.window_id,
            "profile": selected.profile,
            "close_method": close_method,
            "attempts": attempts,
        }

    #@MNX-PART id=90.00.monsterdesk.function.f058-dispatch kind=function title="Python function dispatch"
    def dispatch(self, request: dict[str, Any]) -> dict[str, Any]:
        action = request.get("action")
        arguments = request.get("arguments", {})
        if not isinstance(action, str) or not isinstance(arguments, dict):
            raise MonsterdeskError("request action/arguments are invalid")
        self.assert_infrastructure()
        if action == "status":
            return self.status()
        if action == "observe":
            return self.observe(include_image=bool(arguments.get("include_image", True)))
        if action == "screenshot":
            return self.capture()
        if action == "windows":
            return {"windows": self.windows(), "generation": self.generation}
        if action == "pointer":
            return {"pointer": self.pointer(), "generation": self.generation}
        if action == "move":
            return self.move(int(arguments["x"]), int(arguments["y"]), arguments.get("expected_frame_sha256"))
        if action == "click":
            return self.click(int(arguments["x"]), int(arguments["y"]), int(arguments.get("button", 1)),
                              arguments.get("expected_frame_sha256"))
        if action == "type":
            return self.type_text(arguments.get("text"), arguments.get("expected_frame_sha256"))
        if action == "key":
            return self.key(arguments.get("chord"), arguments.get("expected_frame_sha256"))
        if action == "focus":
            return self.focus(int(arguments["window_id"]), arguments.get("expected_frame_sha256"))
        if action == "launch":
            return self.launch(str(arguments.get("profile", "")))
        if action == "processes":
            return {"processes": self.processes()}
        if action == "diagnostics":
            return self.diagnostics()
        if action == "terminate":
            return self.terminate(str(arguments.get("launch_id", "")), str(arguments.get("signal", "TERM")))
        if action == "close-active":
            return self.close_active()
        if action == "show":
            return self.show_viewer()
        if action == "hide":
            return self.hide_viewer()
        raise MonsterdeskError(f"unknown action: {action}")

    #@MNX-PART id=90.00.monsterdesk.function.f059-handle-connection kind=function title="Python function handle_connection"
    def handle_connection(self, connection: socket.socket) -> None:
        with connection:
            if peer_uid(connection) != os.getuid():
                send_json(connection, {"ok": False, "error": "peer uid rejected"})
                return
            try:
                raw = recv_line(connection)
                request = json.loads(raw.decode("utf-8", errors="strict"))
                if not isinstance(request, dict):
                    raise MonsterdeskError("request is not an object")
                result = self.dispatch(request)
                send_json(connection, {"ok": True, "result": result})
            except (MonsterdeskError, FenceError, KeyError, ValueError, TypeError, json.JSONDecodeError, UnicodeError) as exc:
                send_json(connection, {"ok": False, "error": str(exc), "error_type": type(exc).__name__})

    #@MNX-PART id=90.00.monsterdesk.function.f060-serve kind=function title="Python function serve"
    def serve(self) -> None:
        if self.server is None:
            raise MonsterdeskError("control socket is not initialized")
        while not self.stop_event.is_set():
            self.reap()
            try:
                connection, _ = self.server.accept()
            except socket.timeout:
                continue
            except OSError as exc:
                if self.stop_event.is_set():
                    break
                raise MonsterdeskError(f"control socket failed: {exc}") from exc
            self.handle_connection(connection)

    #@MNX-PART id=90.00.monsterdesk.function.f061-cleanup kind=function title="Python function cleanup"
    def cleanup(self) -> None:
        self.stop_event.set()
        if self.server is not None:
            with contextlib.suppress(OSError):
                self.server.close()
        for tracked in list(self.launches.values()):
            if process_matches(tracked.pid, tracked.start_ticks):
                with contextlib.suppress(OSError):
                    os.killpg(tracked.pid, signal.SIGTERM)
        time.sleep(0.15)
        for name, (process, ticks) in reversed(list(self.children.items())):
            if process.poll() is None and process_matches(process.pid, ticks):
                with contextlib.suppress(OSError):
                    os.killpg(process.pid, signal.SIGTERM)
        end = time.monotonic() + 3
        while time.monotonic() < end:
            if all(process.poll() is not None for process, _ in self.children.values()):
                break
            time.sleep(0.05)
        for process, ticks in self.children.values():
            if process.poll() is None and process_matches(process.pid, ticks):
                with contextlib.suppress(OSError):
                    os.killpg(process.pid, signal.SIGKILL)
        if self.x is not None:
            with contextlib.suppress(Exception):
                self.x.close()
        with contextlib.suppress(OSError):
            if self.socket_path.exists() or self.socket_path.is_symlink():
                self.socket_path.unlink()
        status = self.status()
        status["state"] = "stopped"
        status["stopped_at"] = time.time()
        with contextlib.suppress(Exception):
            atomic_json(self.status_file, status)
        with contextlib.suppress(Exception):
            if self.runtime.exists():
                shutil.rmtree(self.runtime)


#@MNX-PART id=90.00.monsterdesk.function.f062-daemon-main kind=function title="Python function daemon_main"
def daemon_main() -> int:
    if os.getuid() != USER_UID or Path.home() != USER_HOME:
        raise MonsterdeskError(f"daemon must run as {USER_NAME} uid {USER_UID}")
    host = current_host_environment()
    session = Session(host["DISPLAY"], Path(host["XAUTHORITY"]))

    #@MNX-PART id=90.00.monsterdesk.function.f063-stop-handler kind=function title="Python function stop_handler"
    def stop_handler(_signum, _frame) -> None:
        session.stop_event.set()

    signal.signal(signal.SIGTERM, stop_handler)
    signal.signal(signal.SIGINT, stop_handler)
    try:
        session.setup()
        session.serve()
        return 0
    finally:
        session.cleanup()


#@MNX-PART id=90.00.monsterdesk.function.f064-unit-active kind=function title="Python function unit_active"
def unit_active() -> bool:
    completed = subprocess.run(
        [str(SYSTEMCTL), "--user", "is-active", "--quiet", unit_name()],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return completed.returncode == 0


#@MNX-PART id=90.00.monsterdesk.function.f065-call-daemon kind=function title="Python function call_daemon"
def call_daemon(action: str, arguments: dict[str, Any] | None = None, *, start: bool = False) -> Any:
    if start and not control_socket_path().is_socket():
        start_session(show=False)
    if action != "status":
        daemon_status = call_daemon("status")
        observed_version = daemon_status.get("version") if isinstance(daemon_status, dict) else None
        if observed_version != VERSION:
            raise MonsterdeskError(
                f"running Monsterdesk daemon version {observed_version!r} differs from client {VERSION!r}; "
                "run `monsterdesk stop` before using the new client"
            )
    path = control_socket_path()
    if not path.is_socket():
        raise MonsterdeskError("Monsterdesk is not running; run `monsterdesk start`")
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    connection.settimeout(30)
    try:
        connection.connect(str(path))
        send_json(connection, {"action": action, "arguments": arguments or {}})
        response = recv_line(connection, MAX_RESPONSE_BYTES)
    finally:
        connection.close()
    value = json.loads(response.decode("utf-8", errors="strict"))
    if not isinstance(value, dict) or value.get("ok") is not True:
        raise MonsterdeskError(str(value.get("error", "invalid daemon response")) if isinstance(value, dict) else "invalid daemon response")
    return value["result"]


#@MNX-PART id=90.00.monsterdesk.function.f066-start-session kind=function title="Python function start_session"
def start_session(*, show: bool) -> dict[str, Any]:
    if instance_name() not in {"main", "nicotine", "qbittorrent"}:
        raise MonsterdeskError("acceptance Monsterdesk instances are internal to live acceptance")
    if os.getuid() != USER_UID:
        raise MonsterdeskError(f"run as {USER_NAME}, not root")
    if control_socket_path().is_socket():
        result = call_daemon("status")
        if not isinstance(result, dict) or result.get("version") != VERSION:
            raise MonsterdeskError("a different Monsterdesk daemon version is running; run `monsterdesk stop`")
        if show:
            call_daemon("show")
        return result
    if unit_active():
        try:
            wait_for(lambda: control_socket_path().is_socket(), 8, "active Monsterdesk control socket")
            result = call_daemon("status")
            if not isinstance(result, dict) or result.get("version") != VERSION:
                raise MonsterdeskError("a different Monsterdesk daemon version is running; run `monsterdesk stop`")
            if show:
                call_daemon("show")
            return result
        except MonsterdeskError as exc:
            raise MonsterdeskError("Monsterdesk user service is active but its control socket is unavailable; run `monsterdesk stop`") from exc
    host = current_host_environment()
    runtime_base()
    executable = Path(__file__).resolve()
    if not executable.is_file():
        raise MonsterdeskError("could not resolve Monsterdesk executable")
    argv = [
        str(SYSTEMD_RUN), "--user", "--quiet", "--collect", f"--unit={unit_name()}", "--service-type=exec",
        "--property=KillMode=mixed", "--property=TimeoutStopSec=20s", "--property=Restart=no",
        f"--setenv=DISPLAY={host['DISPLAY']}", f"--setenv=XAUTHORITY={host['XAUTHORITY']}",
        f"--setenv=HOME={USER_HOME}", f"--setenv=XDG_RUNTIME_DIR={runtime_base()}",
        f"--setenv=MONSTERDESK_INSTANCE={instance_name()}",
        str(executable), "daemon",
    ]
    run_checked(argv, timeout=15)
    wait_for(lambda: control_socket_path().is_socket(), 45, "Monsterdesk control socket")
    result = call_daemon("status")
    if show:
        call_daemon("show")
    return result


#@MNX-PART id=90.00.monsterdesk.function.f067-stop-session kind=function title="Python function stop_session"
def stop_session() -> dict[str, Any]:
    if instance_name() not in {"main", "nicotine", "qbittorrent"}:
        raise MonsterdeskError("acceptance Monsterdesk instances are internal to live acceptance")
    if not unit_active() and not control_socket_path().exists():
        return {"stopped": True, "already_stopped": True, "unit_inactive": True, "socket_absent": True}
    completed = subprocess.run([str(SYSTEMCTL), "--user", "stop", unit_name()], check=False)
    if completed.returncode != 0:
        raise MonsterdeskError(f"systemctl stop failed rc={completed.returncode}")
    wait_for(lambda: not unit_active() and not control_socket_path().exists(), 20,
             "Monsterdesk user unit and control socket to stop")
    if unit_active() or control_socket_path().exists():
        raise MonsterdeskError("Monsterdesk stop returned without proving unit inactivity and socket removal")
    return {"stopped": True, "already_stopped": False, "unit_inactive": True, "socket_absent": True}


#@MNX-PART id=90.00.monsterdesk.function.f068-print-human kind=function title="Python function print_human"
def print_human(value: Any) -> None:
    if isinstance(value, dict):
        for key, item in value.items():
            if key in {"data_base64", "image"}:
                continue
            print(f"{key}={canonical(item) if isinstance(item, (dict, list)) else item}")
    else:
        print(canonical(value))


