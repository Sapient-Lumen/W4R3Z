          print("verified_damage_is_review_required=yes")
          print("verified_damage_degrades_systemd=no")
          policy = summary.get("policy", {})
          print(f"journal_files_explicitly_deleted={'yes' if policy.get('journal_files_deleted') else 'no'}")
          print(f"journal_vacuum_run={'yes' if policy.get('journal_vacuum_run') else 'no'}")
          print(f"journal_rotation_recorded={'yes' if policy.get('journal_rotation_run') else 'no'}")
