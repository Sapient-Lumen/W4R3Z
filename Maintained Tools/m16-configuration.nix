PRESSLOG_SOURCE_BASE64
      echo "d6a1cfe9ca685cfa4f4852087db278556f406557c4aed3cb637f79e1846efdfc  $payload_b64" | sha256sum -c -
      base64 -d "$payload_b64" > "$payload"
      echo "4ae9fbd6113d07bde5aa345fa10c0a37f8cfdc613bb3d1fcf40219c1ed4135c1  $payload" | sha256sum -c -
      mkdir -p "$out"
      tar -xzf "$payload" -C "$out" --no-same-owner --no-same-permissions
      (cd "$out" && sha256sum -c PRESSLOG-INTEGRATION-SHA256SUMS)
      grep -Fxq 'integration_profile=monsternix-durability-first-no-automatic-expiry-visible-write-failure' "$out/PRESSLOG-INTEGRATION-PROVENANCE"
      grep -Fxq 'integration_revision=0006' "$out/PRESSLOG-INTEGRATION-PROVENANCE"
      grep -Fxq 'backup_contract=persistent-private-state-and-ciphertext-follow-home-backups-no-backup-wide-destruction-claim' "$out/PRESSLOG-INTEGRATION-PROVENANCE"
      (cd "$out" && sha256sum -c SHA256SUMS)
      grep -Fq -- '--no-auto-expire' "$out/README.md" || { echo 'PRESSLOG_SOURCE_GATE_ERROR: README lacks no-auto-expire durability documentation' >&2; exit 1; }
      grep -Fq -- '"--no-auto-expire" => auto_expire = false' "$out/src/main.rs" || { echo 'PRESSLOG_SOURCE_GATE_ERROR: core lacks the no-auto-expire parser branch' >&2; exit 1; }
      grep -Fq 'stopping before silent event loss' "$out/src/main.rs" || { echo 'PRESSLOG_SOURCE_GATE_ERROR: core lacks visible stop-before-loss handling' >&2; exit 1; }
      grep -Fq '"--start-paused" => start_paused = true' "$out/src/main.rs" || { echo 'PRESSLOG_SOURCE_GATE_ERROR: core lacks the start-paused parser branch' >&2; exit 1; }
      grep -Fq 'hw::set_paused(opts.start_paused)' "$out/src/main.rs" || { echo 'PRESSLOG_SOURCE_GATE_ERROR: core does not establish paused state before capture' >&2; exit 1; }
      grep -Fq 'status_live_json_is_line_delimited' "$out/tests/cli.rs" || { echo 'PRESSLOG_SOURCE_GATE_ERROR: core lacks the live status framing regression test' >&2; exit 1; }
      ! grep -Eq '^source = "git\+' "$out/Cargo.lock" || { echo 'PRESSLOG_SOURCE_GATE_ERROR: Cargo.lock contains an unpinned Git dependency' >&2; exit 1; }
      echo 'PRESSLOG_SOURCE_GATE=PASS' 
    '';
    presslogCore = p.rustPlatform.buildRustPackage {
      pname = "presslog-core";
      version = "0.3.0-mnx5";
      src = f.presslogSource;
      cargoLock.lockFile = f.presslogSource + "/Cargo.lock";
      doCheck = true;
      nativeCheckInputs = [ p.coreutils p.gnugrep ];
      postInstall = ''
        (
          set -Eeuo pipefail
          mkdir -p "$out/libexec/presslog" "$out/share/doc/presslog"
          mv "$out/bin/presslog" "$out/libexec/presslog/presslog"
          rmdir "$out/bin"
          install -m 0444 README.md PRESSLOG-INTEGRATION-PROVENANCE PRESSLOG-INTEGRATION-SHA256SUMS "$out/share/doc/presslog/"
          help_out="$TMPDIR/presslog-help"
          "$out/libexec/presslog/presslog" help > "$help_out"
          grep -Fq -- '--no-auto-expire' "$help_out"
          grep -Fq -- '--start-paused' "$help_out"
          status_fixture="$TMPDIR/presslog-status-line-fixture"
          mkdir -p "$status_fixture/run" "$status_fixture/journal"
          printf '%s\n' "$$" > "$status_fixture/run/pid"
          printf '{"pid":"%s","paused":"true","burn":"false","auto_expire":"false","segment":"fixture.plog","events":"0"}' "$$" > "$status_fixture/run/status.json"
          "$out/libexec/presslog/presslog" --state "$status_fixture" status > "$status_fixture/output"
          grep -Fxq "{\"pid\":\"$$\",\"paused\":\"true\",\"burn\":\"false\",\"auto_expire\":\"false\",\"segment\":\"fixture.plog\",\"events\":\"0\"}" "$status_fixture/output"
          grep -Fxq 'segments=0' "$status_fixture/output"
          ! grep -Fq '}segments=' "$status_fixture/output"
          echo 'PRESSLOG_STATUS_LINE_DELIMITATION_GATE=PASS'
          "$out/libexec/presslog/presslog" self-test
        )
      '';
      postFixup = ''
        (
          set -Eeuo pipefail
          test -x "$out/libexec/presslog/presslog"
          "$out/libexec/presslog/presslog" self-test
        )
        echo 'PRESSLOG_FIXUP_PHASE=PASS'
      '';
      meta = {
        description = "Encrypted local keystroke journal core; installed only behind the source-owned Presslog controller";
        platforms = p.lib.platforms.linux;
      };
    };
  })];
