      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.workspace-root kind=function title="Portable Python function workspace_root"
      def workspace_root(value: str | None, record: dict, must_exist: bool = False) -> Path:
          requested = Path(value).expanduser() if value else workspace_default(record)
          if must_exist:
              if requested.is_symlink():
                  raise Error(f'candidate workspace path is a symlink: {requested}')
              try:
                  root = requested.resolve(strict=True)
              except OSError as exc:
                  raise Error(f'candidate workspace is unavailable: {requested}: {exc}') from exc
          else:
              try:
                  parent = requested.parent.resolve(strict=True)
              except OSError as exc:
                  raise Error(f'candidate workspace parent is unavailable: {requested.parent}: {exc}') from exc
              root = parent / requested.name
          if root == Path('/') or root.name in {"", '.', '..'}:
              raise Error(f'candidate workspace path is unsafe: {root}')
          packet = packet_root().resolve()
          if (packet / 'packet.json').is_file() or (packet / 'SHA256SUMS').is_file():
              try:
                  root.relative_to(packet)
              except ValueError:
                  pass
              else:
                  raise Error('candidate workspace may not be created inside the manifested packet')
          forbidden = [Path('/etc'), Path('/nix'), Path('/run/current-system'), Path('/nix/var/nix/profiles')]
          for prefix in forbidden:
              try:
                  root.relative_to(prefix)
              except ValueError:
                  continue
              raise Error(f'candidate workspace may not be created beneath protected host path: {prefix}')
          return root
      
