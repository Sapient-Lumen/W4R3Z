#@MNX-CHUNK id=99.00 slug=assertions-tests title="Assertions, parsers, generated tools, and rebuild testing"
#######################################################################################################
# SECTION 99 — ASSERTIONS, SOURCE PARSER, SELF-TESTS, AND CONFIGURATION-AS-BASH
#######################################################################################################
#
# These programs are generated from this monolith. They do not become independent source files.
# `mnx` is the stable operator dispatcher; `mnx test` is the canonical candidate-evaluation transcript.
# `mnx-config-audit source` validates the candidate monolith without requiring it to be active.
# `mnx-config-audit quick` is the normal post-switch proof. `mnx-config-audit test` validates a temporary
# `nixos-rebuild test` generation whose running closure intentionally differs from the boot-default profile.
# `mnx-config-audit full` additionally performs a NixOS dry build. `mnx-configuration-as-bash` extracts and
# executes the commented Bash payload that follows the top-level Nix expression.
#
#######################################################################################################

  #####################################################################################################
  # SECTION 99 / EVALUATION-TIME INVARIANTS
  #####################################################################################################

#@MNX-CHUNK id=99.01 slug=evaluation-invariants title="Evaluation-time invariants"
#@MNX-DEF path=assertions section=99.01 role=assertion ordinal=260
  assertions = [
    {
      assertion = mnxM21NightlyPolicySelfTest;
      message = "Monsternix nightly policy migration oracle or malformed-policy rejection failed.";
    }
    {
      assertion = mnxM21NightlyPolicy.timezone == config.time.timeZone;
      message = "Monsternix nightly classifier timezone must agree with the native calendar timer timezone.";
    }
    {
      assertion = config.systemd.timers.m16-backup-m21.timerConfig.OnCalendar == "03:25"
        && config.systemd.timers.m16-backup-m21.timerConfig.RandomizedDelaySec == "30m"
        && config.systemd.timers.mnx-storage-catchup.timerConfig.OnActiveSec == "45min"
        && config.systemd.timers.mnx-storage-catchup.timerConfig.OnUnitActiveSec == "30min"
        && config.systemd.timers.mnx-storage-catchup.timerConfig.RandomizedDelaySec == "2min";
      message = "Monsternix typed-policy migration must preserve the five established native timer values.";
    }
    {
      assertion = mnxSemanticKernel.schema == "mnx.semantic-kernel.v1" && mnxSemanticKernel.epoch == 1;
      message = "Monsternix semantic-kernel schema and epoch must remain exact.";
    }
    {
      assertion = mnxSemanticKernel.machine.hostName == config.networking.hostName && mnxSemanticKernel.machine.timeZone == config.time.timeZone;
      message = "Monsternix semantic-kernel machine identity must match the explicit NixOS settings.";
    }
    {
      assertion = mnxSemanticKernel.operator.name == "h0p3" && mnxSemanticKernel.operator.uid == (config.users.users.h0p3.uid or null) && mnxSemanticKernel.operator.home == "/home/h0p3";
      message = "Monsternix semantic-kernel operator identity must match the explicit account boundary.";
    }
    {
      assertion = mnxSemanticKernel.paths.configuration == "/etc/nixos/configuration.nix" && mnxSemanticKernel.paths.oldStorage == "/mnt/m16-old-storage" && mnxSemanticKernel.paths.presslogState == "/home/h0p3/.local/state/presslog" && mnxSemanticKernel.locks.storageMaintenance == "/run/storage-maintenance.lock";
      message = "Monsternix semantic-kernel authoritative path and lock facts must remain exact.";
    }
    {
      assertion = mnxSemanticKernel.source.oneFile && mnxSemanticKernel.source.importsEmpty && !mnxSemanticKernel.source.dynamicImports;
      message = "Monsternix semantic-kernel source authority must remain one file with empty static imports.";
    }
    {
      assertion = (config.users.users.h0p3.uid or null) == 1000;
      message = "Monsternix notification/session tooling requires h0p3 to remain UID 1000.";
    }
    {
      assertion = config.networking.firewall.enable == false;
      message = "Stage 26 is canonicalization/zone observation only; firewall enforcement requires a separately reviewed later stage.";
    }
    {
      assertion = config.system.autoUpgrade.enable == false;
      message = "Raw system.autoUpgrade switching is forbidden because it bypasses mnx test, exact-closure promotion, behavior review, rollback evidence, and office acceptance.";
    }
    {
      assertion = config.systemd.timers.mnx-listener-census.timerConfig.OnUnitActiveSec == "1h";
      message = "Listener attribution must remain an hourly bounded oneshot census.";
    }
    {
      assertion = (config.systemd.services.mnx-listener-census.serviceConfig.RestrictSUIDSGID or false) == true;
      message = "The listener census must retain RestrictSUIDSGID; managed directory metadata is verified rather than repaired in-service.";
    }
    {
      assertion = lib.elem pkgs.rpcbind (config.systemd.services.mnx-listener-census.path or [ ]);
      message = "The listener census must carry the rpcbind package that owns rpcinfo; nfs-utils alone does not provide the registry client.";
    }
    {
      assertion = lib.elem "d /var/lib/logbook/network 2750 root logbook - -" config.systemd.tmpfiles.rules && lib.elem "z /var/lib/logbook/network 2750 root logbook - -" config.systemd.tmpfiles.rules && lib.elem "d /var/lib/monsternix/exposure 0750 root logbook - -" config.systemd.tmpfiles.rules && lib.elem "z /var/lib/monsternix/exposure 0750 root logbook - -" config.systemd.tmpfiles.rules;
      message = "Listener exposure state and history directories must be created and have metadata declaratively enforced by systemd-tmpfiles.";
    }
    {
      assertion = lib.hasInfix "/etc/monsternix/bin/mnx-exposure --config /run/current-system/configuration.nix capture --quiet" config.systemd.services.mnx-listener-census.script;
      message = "The listener census service must classify exposure against the exact active closure source.";
    }
    {
      assertion = config.services.prometheus.exporters.node.listenAddress == "127.0.0.1";
      message = "Monsternix node_exporter must remain loopback-only.";
    }
    {
      assertion = lib.elem 76 (config.systemd.services.logbook-journal-verify.serviceConfig.SuccessExitStatus or [ ]);
      message = "The journal classifier must retain private review status 76 as a defense; the service wrapper maps that reviewed outcome to success while observer malfunction remains a failed unit.";
    }
    {
      assertion = lib.hasInfix "/etc/monsternix/bin/mnx-journal-integrity service" config.systemd.services.logbook-journal-verify.script;
      message = "The weekly journal verifier must use the source-owned classifier rather than an inline text grep.";
    }
    {
      assertion = lib.elem "d /var/lib/monsternix/journal-integrity 0750 root logbook - -" config.systemd.tmpfiles.rules && lib.elem "z /var/lib/monsternix/journal-integrity 0750 root logbook - -" config.systemd.tmpfiles.rules;
      message = "Journal integrity current state must live in a root-owned tmpfiles-managed directory.";
    }
    {
      assertion = lib.elem "d /var/lib/monsternix/degraded-background 0750 root logbook - -" config.systemd.tmpfiles.rules && lib.elem "z /var/lib/monsternix/degraded-background 0750 root logbook - -" config.systemd.tmpfiles.rules && lib.elem "d /var/lib/monsternix/restic-maintenance 0750 root logbook - -" config.systemd.tmpfiles.rules && lib.elem "z /var/lib/monsternix/restic-maintenance 0750 root logbook - -" config.systemd.tmpfiles.rules;
      message = "Evidence-first degraded-controller intake and Restic maintenance state must live in root-owned tmpfiles-managed directories.";
    }
    {
      assertion = config.system.copySystemConfiguration;
      message = "Monsternix closure-source auditing requires system.copySystemConfiguration = true so the incoming $systemConfig/configuration.nix exists as a resolvable Nix-store symlink.";
    }
    {
      assertion = !(lib.elem "/mnt/m16-old-storage" config.services.btrfs.autoScrub.fileSystems);
      message = "old-storage is mirror-only and must not be included in automatic Btrfs scrub/repair.";
    }
    {
      assertion = (config.systemd.services."duperemove-m16-old-storage".unitConfig.RefuseManualStart or false) == true;
      message = "old-storage duperemove must refuse manual starts; rsync is its sole enabled content writer.";
    }
    {
      assertion = config.fileSystems."/mnt/m16-old-storage".fsType == "btrfs";
      message = "The old-storage policy assumes a Btrfs filesystem at /mnt/m16-old-storage.";
    }
    {
      assertion = lib.elem "ro" config.fileSystems."/mnt/m16-old-storage".options && !(lib.elem "rw" config.fileSystems."/mnt/m16-old-storage".options);
      message = "old-storage must be mounted read-only in the host namespace.";
    }
    {
      assertion = (config.systemd.services."rsync-m16-new-to-old".serviceConfig.PrivateMounts or false) == true;
      message = "The authorized old-storage rsync must use a private mount namespace.";
    }
    {
      assertion = lib.hasInfix "mount -o remount,rw \"$DST\"" config.systemd.services."rsync-m16-new-to-old".script && lib.hasInfix "mount -o remount,ro \"$DST\"" config.systemd.services."rsync-m16-new-to-old".script;
      message = "The authorized old-storage rsync must contain both private rw and restoration ro remounts.";
    }
    {
      assertion = config.swapDevices == [ ] || builtins.any (entry: entry.device == "/mnt/m16-backup-nvme/swap/swapfile" && (entry.priority or null) == 10) config.swapDevices;
      message = "Normal mode requires the 128 GiB backup-NVMe overflow swap at priority 10; terminal rescue may intentionally have no disk swap.";
    }
    {
      assertion = lib.hasInfix "STORAGE_RE='Read-error on swap-device" config.systemd.services.mnx-storage-health.script && lib.hasInfix "MEMORY_RE='Out of memory|oom-kill" config.systemd.services.mnx-storage-health.script;
      message = "mnx-storage-health must keep storage-state and memory-pressure evidence in separate domains.";
    }
    {
      assertion = !(lib.hasInfix ("Current boot storage/" + "session incident strings") config.systemd.services.mnx-storage-health.script);
      message = "mnx-storage-health must not restore the retired mixed storage/session critical classification.";
    }
  ];

  #####################################################################################################
  # SECTION 99 / SOURCE MODE REPAIR FOR THE DIRECT POLYGLOT SHEBANG
