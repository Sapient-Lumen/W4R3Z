          ])
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.workspace-init kind=function title="Portable Python function workspace_init"
      def workspace_init(record: dict, value: str | None) -> dict:
          root = workspace_root(value, record, must_exist=False)
          if root.exists() or root.is_symlink():
              raise Error(f'candidate workspace already exists; choose a new path: {root}')
          temporary = Path(tempfile.mkdtemp(prefix=f'.{root.name}.', dir=str(root.parent)))
          try:
              os.chmod(temporary, 0o700)
              _, raw, _ = read_source(Path(record['source']))
              atomic_write(temporary / 'accepted.nix', raw, 0o400)
              atomic_write(temporary / 'candidate.nix', raw, 0o600)
              turn = turn_close(record)
              atomic_write(temporary / 'CAPSULE.next.txt', turn['capsule'].encode('utf-8'), 0o600)
              atomic_write(temporary / 'HISTORY.next.txt', turn['history_ledger'].encode('utf-8'), 0o600)
              atomic_write(temporary / 'TURN-CLOSE.next.txt', (turn['capsule'] + turn['history_ledger']).encode('utf-8'), 0o600)
              marker = {
                  'schema': 'mnx.cloudtainer.candidate-workspace.v1',
                  'authority': 'disposable-proposal-workspace-not-host-mutation-authority',
                  'accepted_source_sha256': record['source_sha256'],
                  'accepted_document_schema': record['document_schema'],
                  'accepted_stage': record['candidate_stage'],
                  'next_stage': int(record['office_agenda']['after_acceptance_next_stage']),
                  'candidate_filename': 'candidate.nix',
                  'accepted_filename': 'accepted.nix',
                  'packet_source': str(record['source']),
                  'network_used': False,
                  'source_executed': False,
                  'host_state_mutated': False,
              }
              atomic_write(temporary / '.mnx-cloudtainer-workspace.json', canonical(marker).encode('utf-8'), 0o600)
              atomic_write(temporary / 'README.md', workspace_readme(record, root).encode('utf-8'), 0o600)
              atomic_write(
                  temporary / 'HOST-VALIDATION-REQUIRED.txt',
                  b'Cloudtainer review is evidence, never acceptance. The human-facing host transaction remains mnx test followed by mnx switch.\n',
                  0o600,
              )
              atomic_write(temporary / 'WORKSPACE-SHA256SUMS', workspace_static_manifest(temporary).encode('utf-8'), 0o600)
              workspace_verify_static_manifest(temporary)
              os.replace(temporary, root)
          except Exception:
              shutil.rmtree(temporary, ignore_errors=True)
              raise
          return {
              'schema': 'mnx.cloudtainer.candidate-workspace.v1',
              'status': 'initialized',
              'workspace': str(root),
              'accepted_source_sha256': record['source_sha256'],
              'accepted_stage': record['candidate_stage'],
              'next_stage': int(record['office_agenda']['after_acceptance_next_stage']),
              'candidate': str(root / 'candidate.nix'),
              'network_used': False,
              'source_executed': False,
              'host_state_mutated': False,
          }
      
      #@MNX-PART id=99.60.mnx-refactor.cloudtainer-portable.function.workspace-import kind=function title="Portable Python function workspace_import"
      def workspace_import(accepted: dict, value: str | None, source: Path) -> dict:
