{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "IOTOX_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "gcc-debug",
      "inherits": "base",
      "displayName": "GCC Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang-debug",
      "inherits": "base",
      "displayName": "Clang Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang-asan-ubsan",
      "inherits": "clang-debug",
      "displayName": "Clang ASan + UBSan",
      "cacheVariables": {
        "IOTOX_ENABLE_ASAN": "ON",
        "IOTOX_ENABLE_UBSAN": "ON",
        "IOTOX_TEST_SHARD_COUNT": "16"
      }
    },
    {
      "name": "gcc-tsan",
      "inherits": "gcc-debug",
      "displayName": "GCC ThreadSanitizer",
      "cacheVariables": {
        "IOTOX_ENABLE_TSAN": "ON",
        "IOTOX_TEST_SHARD_COUNT": "16"
      }
    },
    {
      "name": "gcc-release",
      "inherits": "base",
      "displayName": "GCC Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "gcc-coverage",
      "inherits": "gcc-debug",
      "displayName": "GCC Coverage",
      "cacheVariables": {
        "IOTOX_ENABLE_COVERAGE": "ON",
        "IOTOX_WARNINGS_AS_ERRORS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-asan-ubsan",
      "configurePreset": "clang-asan-ubsan"
    },
    {
      "name": "gcc-tsan",
      "configurePreset": "gcc-tsan"
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release"
    },
    {
      "name": "gcc-coverage",
      "configurePreset": "gcc-coverage"
    }
  ],
  "testPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-asan-ubsan",
      "configurePreset": "clang-asan-ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-tsan",
      "configurePreset": "gcc-tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-coverage",
      "configurePreset": "gcc-coverage",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
