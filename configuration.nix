        def bounded_integer(value: Any, label: str, *, minimum: int = 0,
                            maximum: int = 2**63 - 1) -> int:
            require(isinstance(value, int) and not isinstance(value, bool) and
                    minimum <= value <= maximum, f"invalid {label}")
            return value
        
        
        def safe_text(value: Any, label: str) -> str:
            require(isinstance(value, str) and SAFE_TEXT.fullmatch(value) is not None,
                    f"invalid {label}")
            return value
        
        
        def sha256_text(value: Any, label: str, *, nullable: bool = False) -> str | None:
            if nullable and value is None:
                return None
            require(isinstance(value, str) and SHA256.fullmatch(value) is not None,
                    f"invalid {label}")
            return value
        
        
        def exact_keys(value: dict[str, Any], keys: set[str], label: str) -> None:
            require(set(value) == keys,
                    f"{label} fields differ: missing={sorted(keys - set(value))} "
                    f"extra={sorted(set(value) - keys)}")
        
        
        def load_registry(path: pathlib.Path) -> tuple[dict[str, Any], str]:
            raw = stable_regular(path, 65536, "measurement registry")
            registry = strict_object(raw, "measurement registry")
            required = {
                "schema", "status", "canonicalization", "allowed_statuses",
                "capability_states", "attempt_states", "attempt_dispositions", "comparison_classes",
                "authority", "bounds", "snapshot", "questions",
            }
            exact_keys(registry, required, "measurement registry")
            require(registry["schema"] == "mnx.measurement-registry.v1" and
                    registry["status"] == "portable-reference-kernel",
                    "unsupported measurement registry")
            require(registry["canonicalization"] == "json-sort-keys-compact-lf-v1",
                    "unsupported registry canonicalization")
            require(registry["allowed_statuses"] ==
                    ["pass", "failed", "unknown", "unavailable", "not-applicable"],
                    "measurement status vocabulary drifted")
            require(registry["capability_states"] ==
                    ["observed", "absent", "permission-denied", "timed-out",
                     "output-limited", "not-applicable"],
                    "capability vocabulary drifted")
            require(registry["attempt_dispositions"] == [
                "not-started", "policy-refused", "cancelled", "infrastructure-failed",
                "observer-or-harness-failed", "subject-failed", "timed-out",
                "completed-unverified", "verified",
            ], "attempt-disposition vocabulary drifted")
            require(registry["attempt_states"] == ["not-started", "running", "terminal"],
                    "attempt-state vocabulary drifted")
            require(registry["comparison_classes"] ==
                    ["controlled-delta", "described-delta", "incomparable"],
                    "comparison-class vocabulary drifted")
            require(registry["authority"] == {
                "mode": "observation-and-comparison-only", "mutation": "none",
                "network": "none", "secrets": "none", "acceptance": False,
                "promotion": False, "publication": False, "remediation": False,
            }, "measurement registry enlarged authority")
            bounds = registry["bounds"]
            require(isinstance(bounds, dict) and bounds.get("raw_logs") == 0 and
                    bounds.get("registry_bytes") == 65536 and
                    bounds.get("evidence_bytes") == 65536 and
                    bounds.get("result_bytes") == 16384 and
                    bounds.get("qualification_bytes") == 16384 and
                    bounds.get("snapshot_bytes") == 65536 and
                    bounds.get("diff_bytes") == 32768 and
                    bounds.get("difference_rows") == 64,
                    "measurement physical bounds drifted")
            questions = registry["questions"]
            require(isinstance(questions, list) and len(questions) == 3,
                    "registry must contain exactly three first-slice questions")
            expected_ids = [
                "source-closure-boot-default-lineage",
                "failed-unit-observer-health",
                "scheduled-work-freshness",
            ]
            require([item.get("id") for item in questions if isinstance(item, dict)] == expected_ids,
                    "question inventory or order drifted")
            allowed = set(registry["allowed_statuses"])
            for question in questions:
                require(isinstance(question, dict), "question declaration is not an object")
                question_id = safe_text(question.get("id"), "question id")
                require(question.get("version") == 1 and
                        isinstance(question.get("capabilities"), list) and
                        isinstance(question.get("freshness"), dict) and
                        isinstance(question.get("fixture_cases"), dict) and
                        isinstance(question.get("cheapest_next_measurement"), dict),
                        f"incomplete question declaration: {question_id}")
                require(COMMON_FIXTURES <= set(question["fixture_cases"]),
                        f"incomplete canonical fixture matrix: {question_id}")
                require(set(question["fixture_cases"].values()) <= allowed and
                        set(question["cheapest_next_measurement"]) == allowed,
                        f"question status mapping drifted: {question_id}")
                freshness = question["freshness"]
                bounded_integer(freshness.get("evidence_maximum_age_seconds"),
                                "evidence maximum age", maximum=3600)
                if question_id == "scheduled-work-freshness":
                    bounded_integer(freshness.get("success_maximum_age_seconds"),
                                    "success maximum age", maximum=604800)
                bounded_integer(freshness.get("future_skew_seconds"), "future skew", maximum=3600)
                require(freshness.get("stale_status") in allowed,
                        f"invalid stale status: {question_id}")
            snapshot = registry["snapshot"]
            require(isinstance(snapshot, dict) and
                    snapshot.get("result_embedding") ==
                    "complete-bounded-evidence-and-normalized-result-for-independent-replay" and
                    snapshot.get("normalized_fields") == list(NORMALIZED_FIELDS) and
                    set(snapshot.get("qualification_fields", [])) ==
                    (QUALIFICATION_FIELDS - {"schema"}) and
                    isinstance(snapshot.get("controlled_axes"), dict),
                    "snapshot contract drifted")
            for axis, fields in snapshot["controlled_axes"].items():
                safe_text(axis, "controlled axis")
                require(isinstance(fields, list) and
                        set(fields) <= ((QUALIFICATION_FIELDS - {"schema"}) | {"epoch_id"}),
                        f"invalid controlled-axis fields: {axis}")
            return registry, digest_bytes(canonical_bytes(registry))
        
        
        def question_by_id(registry: dict[str, Any], question_id: str) -> dict[str, Any]:
            for question in registry["questions"]:
                if question["id"] == question_id:
                    return question
            raise Refusal(f"unknown measurement question: {question_id}")
        
        
        def validate_evidence(evidence: dict[str, Any], registry: dict[str, Any]) -> None:
            exact_keys(evidence, EVIDENCE_FIELDS, "measurement evidence")
            require(evidence["schema"] == "mnx.measurement-evidence.v1",
                    "unsupported measurement evidence schema")
            safe_text(evidence["question_id"], "evidence question id")
            bounded_integer(evidence["observed_at_epoch"], "observation epoch")
            require(evidence["capability"] in registry["capability_states"],
                    "unknown capability state")
            observer = evidence["observer"]
            require(isinstance(observer, dict), "observer must be an object")
            exact_keys(observer, OBSERVER_FIELDS, "observer")
            safe_text(observer["id"], "observer id")
            sha256_text(observer["sha256"], "observer sha256")
            require(observer["health"] in {"healthy", "unhealthy", "unavailable"},
                    "unknown observer health")
            require(evidence["subject"] is None or isinstance(evidence["subject"], dict),
                    "evidence subject must be an object or null")
        
        
        def load_evidence(path: pathlib.Path, registry: dict[str, Any]) -> tuple[dict[str, Any], str]:
            maximum = bounded_integer(registry["bounds"]["evidence_bytes"], "evidence byte bound")
            raw = stable_regular(path, maximum, "measurement evidence")
            evidence = strict_object(raw, "measurement evidence")
            validate_evidence(evidence, registry)
            return evidence, digest_bytes(canonical_bytes(evidence))
        
        
        def result_object(registry_sha256: str, question_id: str, evidence: dict[str, Any],
                          evidence_sha256: str, status: str, reason: str,
                          freshness: str, comparison: str,
                          disposition: str = "not-applicable") -> dict[str, Any]:
            normalized = {
                "status": status,
                "observed_capability": evidence["capability"],
                "observer_health": evidence["observer"]["health"],
                "freshness_relation": freshness,
                "comparison": comparison,
                "attempt_disposition": disposition,
            }
            return {
                "schema": "mnx.measurement-result.v1",
                "registry_sha256": registry_sha256,
                "question_id": question_id,
                "observed_at_epoch": evidence["observed_at_epoch"],
                "status": status,
                "reason": reason,
                "normalized": normalized,
                "evidence_sha256": evidence_sha256,
                "observer": copy.deepcopy(evidence["observer"]),
                "authority": {
                    "mode": "observation-only", "mutation": "none", "network": "none",
                    "acceptance": False, "promotion": False, "remediation": False,
                },
                "limits": {"raw_logs_included": False, "result_bytes": 16384},
            }
        
        
        def freshness_relation(question: dict[str, Any], observed_at: int, now: int) -> tuple[str, str | None]:
            maximum = bounded_integer(
                question["freshness"]["evidence_maximum_age_seconds"], "evidence maximum age",
            )
            skew = bounded_integer(question["freshness"]["future_skew_seconds"], "future skew")
            if observed_at > now + skew:
                return "future", "FUTURE_EVIDENCE"
            if now - observed_at > maximum:
                return "stale", "STALE_EVIDENCE"
            return "fresh", None
        
        
        def normalize_lineage(subject: dict[str, Any]) -> tuple[str, str, str, str]:
            keys = {"source_sha256", "embedded_source_sha256", "running_closure", "boot_default_closure"}
            if set(subject) != keys:
                raise SubjectUnknown("LINEAGE_FIELDS_MALFORMED")
            source = sha256_text(subject["source_sha256"], "source sha256", nullable=True)
            embedded = sha256_text(subject["embedded_source_sha256"], "embedded source sha256", nullable=True)
            running = subject["running_closure"]
            default = subject["boot_default_closure"]
            if source is None or embedded is None or running is None or default is None:
                return "unavailable", "LINEAGE_IDENTITY_UNAVAILABLE", "identity-unavailable", "not-applicable"
            safe_text(running, "running closure")
            safe_text(default, "boot-default closure")
            if source != embedded:
                return "failed", "SOURCE_CLOSURE_MISMATCH", "source-mismatch", "not-applicable"
            relation = "running-is-boot-default" if running == default else "running-differs-from-boot-default"
            return "pass", "SOURCE_CLOSURE_COHERENT", relation, "not-applicable"
        
        
        def normalize_failed_units(subject: dict[str, Any]) -> tuple[str, str, str, str]:
            if set(subject) != {"observer_status", "observer_rc", "failed_units"}:
                raise SubjectUnknown("FAILED_UNIT_FIELDS_MALFORMED")
            status = subject["observer_status"]
            rc = subject["observer_rc"]
            units = subject["failed_units"]
            if (
                status not in {"observed-none", "observed-failures", "failed"}
                or not isinstance(rc, int)
                or isinstance(rc, bool)
                or not isinstance(units, list)
                or len(units) > 32
                or any(not isinstance(item, str) or SAFE_TEXT.fullmatch(item) is None for item in units)
            ):
                raise SubjectUnknown("FAILED_UNIT_SUBJECT_MALFORMED")
            if status == "failed":
                return "failed", "OBSERVER_MALFUNCTION", "observer-malfunction", "not-applicable"
            if rc != 0 or (status == "observed-none") != (len(units) == 0):
                raise SubjectUnknown("FAILED_UNIT_OBSERVER_CONTRADICTION")
            comparison = "observer-coherent-no-failures" if not units else "observer-coherent-failures-present"
            return "pass", "OBSERVER_COHERENT", comparison, "not-applicable"
        
        
        def normalize_scheduled(subject: dict[str, Any], observed_at: int,
                                question: dict[str, Any]) -> tuple[str, str, str, str]:
            keys = {
                "job_id", "planned_slot_id", "attempt_id", "attempt_state", "disposition",
                "attempt_started_at_epoch", "attempt_finished_at_epoch",
                "last_verified_success_epoch", "active_instances", "lock_state",
            }
            if set(subject) != keys:
                raise SubjectUnknown("SCHEDULED_WORK_FIELDS_MALFORMED")
            safe_text(subject["job_id"], "job id")
            safe_text(subject["planned_slot_id"], "planned slot id")
            state = subject["attempt_state"]
            disposition = subject["disposition"]
            if state not in {"not-started", "running", "terminal"}:
                raise SubjectUnknown("ATTEMPT_STATE_UNKNOWN")
            allowed = {
                "not-started", "policy-refused", "cancelled", "infrastructure-failed",
                "observer-or-harness-failed", "subject-failed", "timed-out",
                "completed-unverified", "verified",
            }
            if disposition is not None and disposition not in allowed:
                raise SubjectUnknown("ATTEMPT_DISPOSITION_UNKNOWN")
            start = subject["attempt_started_at_epoch"]
            finish = subject["attempt_finished_at_epoch"]
            last_success = subject["last_verified_success_epoch"]
            active = subject["active_instances"]
            lock_state = subject["lock_state"]
            if (
                not isinstance(active, int)
                or isinstance(active, bool)
                or not 0 <= active <= 64
                or lock_state not in {"not-observed", "unlocked", "locked", "unknown"}
            ):
                raise SubjectUnknown("OVERLAP_OR_LOCK_STATE_MALFORMED")
            if state == "not-started":
                if (
                    disposition != "not-started"
                    or subject["attempt_id"] is not None
                    or start is not None
                    or finish is not None
                ):
                    raise SubjectUnknown("NOT_STARTED_ATTEMPT_CONTRADICTION")
                return "failed", "PLANNED_SLOT_NOT_STARTED", "planned-slot-without-attempt", disposition
            if state == "running":
                if (
                    disposition is not None
                    or subject["attempt_id"] is None
                    or finish is not None
                    or active < 1
                ):
                    raise SubjectUnknown("RUNNING_ATTEMPT_CONTRADICTION")
                safe_text(subject["attempt_id"], "attempt id")
                bounded_integer(start, "attempt start epoch")
                if start > observed_at:
                    raise SubjectUnknown("ATTEMPT_TIME_CONTRADICTION")
                return "unknown", "ATTEMPT_RUNNING", "attempt-running", "not-applicable"
            if disposition in {None, "not-started"} or subject["attempt_id"] is None:
                raise SubjectUnknown("TERMINAL_ATTEMPT_DISPOSITION_REQUIRED")
            safe_text(subject["attempt_id"], "attempt id")
            bounded_integer(start, "attempt start epoch")
            bounded_integer(finish, "attempt finish epoch")
            if not start <= finish <= observed_at:
                raise SubjectUnknown("ATTEMPT_TIME_CONTRADICTION")
            if last_success is not None:
                bounded_integer(last_success, "last verified success epoch")
                if last_success > observed_at:
                    raise SubjectUnknown("LAST_SUCCESS_TIME_CONTRADICTION")
            overlap = ";overlap-observed-no-policy" if active > 1 else ""
            mapping = {
                "policy-refused": ("failed", "ATTEMPT_POLICY_REFUSED"),
                "cancelled": ("failed", "ATTEMPT_CANCELLED"),
                "infrastructure-failed": ("failed", "ATTEMPT_INFRASTRUCTURE_FAILED"),
                "observer-or-harness-failed": ("unavailable", "ATTEMPT_OBSERVER_OR_HARNESS_FAILED"),
                "subject-failed": ("failed", "ATTEMPT_SUBJECT_FAILED"),
                "timed-out": ("failed", "ATTEMPT_TIMED_OUT"),
                "completed-unverified": ("unknown", "ATTEMPT_COMPLETED_UNVERIFIED"),
            }
            if disposition in mapping:
                status, reason = mapping[disposition]
                return status, reason, disposition + overlap, disposition
            if disposition != "verified" or last_success != finish:
                raise SubjectUnknown("VERIFIED_SUCCESS_RELATION_CONTRADICTION")
            maximum = bounded_integer(
                question["freshness"]["success_maximum_age_seconds"], "success maximum age",
            )
            skew = bounded_integer(question["freshness"]["future_skew_seconds"], "success future skew")
            if last_success > observed_at + skew:
                raise SubjectUnknown("LAST_SUCCESS_FUTURE")
            if observed_at - last_success > maximum:
                return "failed", "LAST_VERIFIED_SUCCESS_STALE", "verified-stale" + overlap, disposition
            return "pass", "LAST_VERIFIED_SUCCESS_FRESH", "verified-fresh" + overlap, disposition
        
        
        def normalize(registry: dict[str, Any], registry_sha256: str, question_id: str,
                      evidence: dict[str, Any], evidence_sha256: str, now: int) -> dict[str, Any]:
            question = question_by_id(registry, question_id)
            require(evidence["question_id"] == question_id, "evidence question identity mismatch")
            relation, freshness_reason = freshness_relation(question, evidence["observed_at_epoch"], now)
            capability = evidence["capability"]
            if capability == "not-applicable":
                result = result_object(registry_sha256, question_id, evidence, evidence_sha256,
                                       "not-applicable", "RUNTIME_NOT_APPLICABLE", relation,
                                       "not-observed")
            elif capability in {"absent", "permission-denied", "timed-out", "output-limited"}:
                reason = {
                    "absent": "CAPABILITY_ABSENT",
                    "permission-denied": "CAPABILITY_PERMISSION_DENIED",
                    "timed-out": "CAPABILITY_TIMED_OUT",
                    "output-limited": "CAPABILITY_OUTPUT_LIMITED",
                }[capability]
                result = result_object(registry_sha256, question_id, evidence, evidence_sha256,
                                       "unavailable", reason, relation, "not-observed")
            elif evidence["observer"]["health"] == "unavailable":
                result = result_object(registry_sha256, question_id, evidence, evidence_sha256,
                                       "unavailable", "OBSERVER_UNAVAILABLE", relation,
                                       "not-observed")
            elif freshness_reason is not None:
                status = question["freshness"]["stale_status"] if relation == "stale" else "unknown"
                result = result_object(registry_sha256, question_id, evidence, evidence_sha256,
                                       status, freshness_reason, relation, "not-compared")
            else:
                subject = evidence["subject"]
                if not isinstance(subject, dict):
                    result = result_object(registry_sha256, question_id, evidence, evidence_sha256,
                                           "unknown", "SUBJECT_MISSING", relation, "not-compared")
                elif (
                    evidence["observer"]["health"] == "unhealthy"
                    and question_id != "failed-unit-observer-health"
                ):
                    disposition = "observer-or-harness-failed" if question_id == "scheduled-work-freshness" else "not-applicable"
                    result = result_object(registry_sha256, question_id, evidence, evidence_sha256,
                                           "unavailable", "OBSERVER_UNHEALTHY", relation,
                                           "not-compared", disposition)
                else:
                    try:
                        if question_id == "source-closure-boot-default-lineage":
                            status, reason, comparison, disposition = normalize_lineage(subject)
                        elif question_id == "failed-unit-observer-health":
                            status, reason, comparison, disposition = normalize_failed_units(subject)
                        else:
                            status, reason, comparison, disposition = normalize_scheduled(
                                subject, evidence["observed_at_epoch"], question,
                            )
                        result = result_object(registry_sha256, question_id, evidence,
                                               evidence_sha256, status, reason, relation,
                                               comparison, disposition)
                    except (Refusal, SubjectUnknown) as error:
                        result = result_object(registry_sha256, question_id, evidence,
                                               evidence_sha256, "unknown", str(error), relation,
                                               "subject-contradictory")
            maximum = bounded_integer(registry["bounds"]["result_bytes"], "result byte bound")
            result["normalized_at_epoch"] = now
            result["evidence"] = copy.deepcopy(evidence)
            sealed = seal(result)
            require(len(canonical_bytes(sealed)) <= maximum, "normalized result exceeds physical bound")
            return sealed
        
        
        def fixture_evidence(question_id: str, case: str, now: int) -> dict[str, Any]:
            observer = {
                "id": "observer.synthetic.v1",
                "sha256": digest_bytes(b"observer.synthetic.v1\n"),
                "health": "healthy",
            }
            if question_id == "source-closure-boot-default-lineage":
                source = digest_bytes(b"candidate\n")
                subject: dict[str, Any] = {
                    "source_sha256": source, "embedded_source_sha256": source,
                    "running_closure": "/nix/store/synthetic-system",
                    "boot_default_closure": "/nix/store/synthetic-system",
                }
            elif question_id == "failed-unit-observer-health":
                subject = {"observer_status": "observed-failures", "observer_rc": 0,
                           "failed_units": ["synthetic.service"]}
            else:
                subject = {
                    "job_id": "synthetic-job", "planned_slot_id": "slot-0001",
                    "attempt_id": "attempt-0001", "attempt_state": "terminal",
                    "disposition": "verified", "attempt_started_at_epoch": now - 120,
                    "attempt_finished_at_epoch": now - 60,
                    "last_verified_success_epoch": now - 60, "active_instances": 0,
                    "lock_state": "not-observed",
                }
            evidence: dict[str, Any] = {
                "schema": "mnx.measurement-evidence.v1", "question_id": question_id,
                "observed_at_epoch": now, "capability": "observed",
                "observer": observer, "subject": subject,
            }
            if case == "permission-denied":
                evidence["capability"] = "permission-denied"; evidence["subject"] = None
            elif case == "timeout":
                evidence["capability"] = "timed-out"; evidence["subject"] = None
            elif case == "output-limit":
                evidence["capability"] = "output-limited"; evidence["subject"] = None
            elif case == "not-applicable" or (case == "reset" and question_id != "scheduled-work-freshness"):
                evidence["capability"] = "not-applicable"; evidence["subject"] = None
            elif case == "stale":
                evidence["observed_at_epoch"] = now - 301
            elif case == "malformed-subject":
                evidence["subject"] = {"contradiction": True}
            elif question_id == "source-closure-boot-default-lineage":
                if case == "absent":
                    evidence["capability"] = "absent"; evidence["subject"] = None
                elif case == "mismatch":
                    subject["embedded_source_sha256"] = digest_bytes(b"different\n")
            elif question_id == "failed-unit-observer-health":
                if case == "absent":
                    evidence["subject"] = {"observer_status": "observed-none", "observer_rc": 0,
                                           "failed_units": []}
                elif case == "observer-malfunction":
                    evidence["subject"] = {"observer_status": "failed", "observer_rc": 1,
                                           "failed_units": []}
            else:
                if case == "absent":
                    subject.update({"attempt_id": None, "attempt_state": "not-started",
                                    "disposition": "not-started", "attempt_started_at_epoch": None,
                                    "attempt_finished_at_epoch": None,
                                    "last_verified_success_epoch": None})
                elif case == "reset":
                    subject["last_verified_success_epoch"] = now + 1
                elif case == "stale-success":
                    subject["attempt_started_at_epoch"] = now - 28820
                    subject["attempt_finished_at_epoch"] = now - 28810
                    subject["last_verified_success_epoch"] = now - 28810
                elif case == "overlap-observed":
                    subject["active_instances"] = 2
                else:
                    disposition_by_case = {
                        "policy-refused": "policy-refused", "cancelled": "cancelled",
                        "infrastructure-failed": "infrastructure-failed",
                        "observer-or-harness-failed": "observer-or-harness-failed",
                        "subject-failed": "subject-failed", "work-timed-out": "timed-out",
                        "completed-unverified": "completed-unverified",
                    }
                    if case in disposition_by_case:
                        subject["disposition"] = disposition_by_case[case]
                        subject["last_verified_success_epoch"] = now - 3600
            return evidence
        
        
        def compile_fixtures(registry: dict[str, Any], registry_sha256: str,
                             only: str | None) -> dict[str, Any]:
            now = 2_000_000_000
            questions = registry["questions"] if only is None else [question_by_id(registry, only)]
            rows: list[dict[str, Any]] = []
            statuses: set[str] = set()
            for question in questions:
                for case, expected in question["fixture_cases"].items():
                    evidence = fixture_evidence(question["id"], case, now)
                    result = normalize(registry, registry_sha256, question["id"], evidence,
                                       digest_bytes(canonical_bytes(evidence)), now)
                    rows.append({
                        "question_id": question["id"], "case": case,
                        "expected_status": expected, "actual_status": result["status"],
                        "match": result["status"] == expected,
                        "reason": result["reason"],
                    })
                    statuses.add(result["status"])
            require(all(row["match"] for row in rows), "generated fixture status mismatch")
            return {
                "schema": "mnx.measurement-fixture-results.v1", "status": "pass",
                "registry_sha256": registry_sha256, "question_id": only,
                "fixture_count": len(rows), "statuses_observed": sorted(statuses),
                "fixtures": rows,
                "authority": {"host_validated": False, "mutation": "none", "network": "none"},
            }
        
        
        def validate_qualification(value: dict[str, Any]) -> None:
            exact_keys(value, QUALIFICATION_FIELDS, "measurement qualification")
            require(value["schema"] == "mnx.measurement-qualification.v1",
                    "unsupported qualification schema")
            for field in ("candidate_sha256", "workspace_sha256", "resource_envelope_sha256", "policy_sha256"):
                sha256_text(value[field], field)
            for field in QUALIFICATION_FIELDS - {
                "schema", "candidate_sha256", "workspace_sha256",
                "resource_envelope_sha256", "policy_sha256", "currentity",
            }:
                safe_text(value[field], field)
            require(value["currentity"] in {"current", "stale", "unknown"},
                    "invalid qualification currentity")
        
        
        def seal(value: dict[str, Any]) -> dict[str, Any]:
            sealed = copy.deepcopy(value)
            sealed["content_sha256"] = digest_bytes(canonical_bytes(value))
            return sealed
        
        
        def validate_seal(value: dict[str, Any], label: str) -> None:
            identity = value.get("content_sha256")
            sha256_text(identity, f"{label} content sha256")
            unsealed = copy.deepcopy(value)
            del unsealed["content_sha256"]
            require(digest_bytes(canonical_bytes(unsealed)) == identity,
                    f"{label} content digest mismatch")
        
        
        def load_json_file(path: pathlib.Path, maximum: int, label: str) -> dict[str, Any]:
            return strict_object(stable_regular(path, maximum, label), label)
        
        
        def validate_result(value: dict[str, Any], registry: dict[str, Any], registry_sha256: str) -> None:
            exact_keys(value, RESULT_FIELDS, "measurement result")
            validate_seal(value, "measurement result")
            require(value.get("schema") == "mnx.measurement-result.v1" and
                    value.get("registry_sha256") == registry_sha256 and
                    value.get("status") in registry["allowed_statuses"],
                    "measurement result identity or status is invalid")
            question_by_id(registry, safe_text(value.get("question_id"), "result question id"))
            normalized = value.get("normalized")
            require(isinstance(normalized, dict) and set(normalized) == set(NORMALIZED_FIELDS) and
                    normalized.get("status") == value.get("status"),
                    "measurement result normalization is invalid")
            require(value.get("authority") == {
                "mode": "observation-only", "mutation": "none", "network": "none",
                "acceptance": False, "promotion": False, "remediation": False,
            }, "measurement result enlarged authority")
            require(value.get("limits") == {"raw_logs_included": False, "result_bytes": 16384},
                    "measurement result physical limits drifted")
            bounded_integer(value.get("observed_at_epoch"), "result observation epoch")
            normalized_at = bounded_integer(value.get("normalized_at_epoch"),
                                            "result normalization epoch")
            sha256_text(value.get("evidence_sha256"), "result evidence sha256")
            evidence = value.get("evidence")
            require(isinstance(evidence, dict), "measurement result evidence is absent")
            validate_evidence(evidence, registry)
            require(value["evidence_sha256"] == digest_bytes(canonical_bytes(evidence)),
                    "measurement result evidence digest mismatch")
            require(value.get("observer") == evidence["observer"],
                    "measurement result observer differs from its evidence")
            expected = normalize(
                registry, registry_sha256, value["question_id"], evidence,
                value["evidence_sha256"], normalized_at,
            )
            require(value == expected, "measurement result does not replay from its evidence")
        
        
        def build_snapshot(registry: dict[str, Any], registry_sha256: str,
                           result_paths: list[pathlib.Path], qualification_path: pathlib.Path,
                           epoch_id: str) -> dict[str, Any]:
            safe_text(epoch_id, "epoch id")
            qualification = load_json_file(
                qualification_path, registry["bounds"]["qualification_bytes"], "measurement qualification",
            )
            validate_qualification(qualification)
            results: dict[str, dict[str, Any]] = {}
            result_identities: dict[str, str] = {}
            observed: list[int] = []
            observer_identity: tuple[str, str] | None = None
            for path in result_paths:
                value = load_json_file(path, registry["bounds"]["result_bytes"], "measurement result")
                validate_result(value, registry, registry_sha256)
                question_id = value["question_id"]
                require(question_id not in results, f"duplicate snapshot question: {question_id}")
                observer = value.get("observer", {})
                identity = (observer.get("id"), observer.get("sha256"))
                require(all(isinstance(item, str) for item in identity), "result observer identity absent")
                if observer_identity is None:
                    observer_identity = identity
                require(observer_identity == identity, "snapshot mixes observer identities")
                results[question_id] = copy.deepcopy(value)
                result_identities[question_id] = value["content_sha256"]
                observed.append(value["observed_at_epoch"])
            expected = sorted(question["id"] for question in registry["questions"])
            require(sorted(results) == expected, "snapshot requires the complete current question set")
            require(max(observed) - min(observed) <= 300,
                    "snapshot question observations exceed the coherence window")
            unsealed = {
                "schema": "mnx.measurement-snapshot.v1", "status": "complete",
                "registry_sha256": registry_sha256,
                "qualification_sha256": digest_bytes(canonical_bytes(qualification)),
                "qualification": qualification, "epoch_id": epoch_id,
                "observed_at_epoch": max(observed), "question_ids": expected,
                "results": {key: results[key] for key in expected},
                "result_sha256": {key: result_identities[key] for key in expected},
                "observer": {"id": observer_identity[0], "sha256": observer_identity[1]},
                "authority": {
                    "mode": "observation-only", "mutation": "none", "network": "none",
                    "accepted_baseline": False, "acceptance_inferred": False,
                    "promotion": False,
                },
                "limits": {"raw_logs_included": False, "snapshot_bytes": 65536},
            }
            snapshot = seal(unsealed)
            require(len(canonical_bytes(snapshot)) <= registry["bounds"]["snapshot_bytes"],
                    "measurement snapshot exceeds physical bound")
            return snapshot
        
        
        def validate_snapshot(value: dict[str, Any], registry: dict[str, Any],
                              registry_sha256: str, label: str) -> None:
            exact_keys(value, SNAPSHOT_FIELDS, label)
            validate_seal(value, label)
            require(value.get("schema") == "mnx.measurement-snapshot.v1" and
                    value.get("status") == "complete" and
                    value.get("registry_sha256") == registry_sha256,
                    f"{label} identity is not current")
            qualification = value.get("qualification")
            require(isinstance(qualification, dict), f"{label} qualification absent")
            validate_qualification(qualification)
            require(value.get("qualification_sha256") == digest_bytes(canonical_bytes(qualification)),
                    f"{label} qualification digest mismatch")
            expected = sorted(question["id"] for question in registry["questions"])
            require(value.get("question_ids") == expected and
                    isinstance(value.get("results"), dict) and
                    sorted(value["results"]) == expected and
                    isinstance(value.get("result_sha256"), dict) and
                    sorted(value["result_sha256"]) == expected,
                    f"{label} question inventory is incomplete")
            for question_id in expected:
                result = value["results"][question_id]
                require(isinstance(result, dict), f"{label} result is not an object")
                validate_result(result, registry, registry_sha256)
                require(result["question_id"] == question_id and
                        value["result_sha256"][question_id] == result["content_sha256"],
                        f"{label} result identity is inconsistent: {question_id}")
            observer = value.get("observer")
            require(isinstance(observer, dict) and set(observer) == {"id", "sha256"},
                    f"{label} observer identity is malformed")
            safe_text(observer["id"], f"{label} observer id")
            sha256_text(observer["sha256"], f"{label} observer sha256")
            require(all(result["observer"]["id"] == observer["id"] and
                        result["observer"]["sha256"] == observer["sha256"]
                        for result in value["results"].values()),
                    f"{label} observer identity differs from embedded results")
            result_epochs = [result["observed_at_epoch"] for result in value["results"].values()]
            require(value.get("observed_at_epoch") == max(result_epochs) and
                    max(result_epochs) - min(result_epochs) <= 300,
                    f"{label} observation epoch or coherence window is inconsistent")
            require(value.get("authority") == {
                "mode": "observation-only", "mutation": "none", "network": "none",
                "accepted_baseline": False, "acceptance_inferred": False,
                "promotion": False,
            }, f"{label} enlarged authority")
            require(value.get("limits") == {"raw_logs_included": False, "snapshot_bytes": 65536},
                    f"{label} physical limits drifted")
            safe_text(value.get("epoch_id"), f"{label} epoch id")
            bounded_integer(value.get("observed_at_epoch"), f"{label} observation epoch")
        
        
        def compare_snapshots(registry: dict[str, Any], registry_sha256: str,
                              baseline: dict[str, Any], current: dict[str, Any],
                              axis: str, now: int) -> dict[str, Any]:
            validate_snapshot(baseline, registry, registry_sha256, "baseline snapshot")
            validate_snapshot(current, registry, registry_sha256, "current snapshot")
            axes = registry["snapshot"]["controlled_axes"]
            require(axis in axes, f"unknown comparison axis: {axis}")
            changed_context = sorted(
                field for field in QUALIFICATION_FIELDS - {"schema"}
                if baseline["qualification"][field] != current["qualification"][field]
            )
            if baseline["epoch_id"] != current["epoch_id"]:
                changed_context.append("epoch_id")
            changed_context.sort()
            reason: str
            comparison_class: str
            incomparable_reason: str | None = None
            future_skew = registry["bounds"]["future_skew_seconds"]
            if (
                baseline["qualification"]["currentity"] != "current"
                or current["qualification"]["currentity"] != "current"
            ):
                incomparable_reason = "qualification-currentity-missing"
            elif current["observed_at_epoch"] < baseline["observed_at_epoch"]:
                incomparable_reason = "observation-epoch-regression"
            elif (
                current["observed_at_epoch"] > now + future_skew
                or baseline["observed_at_epoch"] > now + future_skew
            ):
                incomparable_reason = "future-snapshot"
            elif now - current["observed_at_epoch"] > registry["bounds"]["current_maximum_age_seconds"]:
                incomparable_reason = "current-snapshot-stale"
            elif now - baseline["observed_at_epoch"] > registry["bounds"]["baseline_maximum_age_seconds"]:
                incomparable_reason = "baseline-snapshot-stale"
            allowed = set(axes[axis])
            if incomparable_reason is not None:
                comparison_class = "incomparable"
                status = "unknown"
                reason = incomparable_reason
            elif not set(changed_context) <= allowed:
                comparison_class = "described-delta"
                status = "failed"
                reason = "nuisance-context-changed"
            else:
                comparison_class = "controlled-delta"
                status = "pass"
                reason = "normalized-results-match"
            differences: list[dict[str, Any]] = []
            for question_id in baseline["question_ids"]:
                before = baseline["results"][question_id]["normalized"]
                after = current["results"][question_id]["normalized"]
                fields = [field for field in NORMALIZED_FIELDS if before[field] != after[field]]
                if fields:
                    differences.append({
                        "question_id": question_id, "fields": fields,
                        "before": {field: before[field] for field in fields},
                        "after": {field: after[field] for field in fields},
                    })
            require(len(differences) <= registry["bounds"]["difference_rows"],
                    "measurement difference row bound exceeded")
            if comparison_class != "incomparable" and differences:
                status = "failed"
                reason = "normalized-results-differ"
            unsealed = {
                "schema": "mnx.measurement-diff.v1", "status": status,
                "reason": reason, "comparison_class": comparison_class,
                "intended_axis": axis, "changed_context_fields": changed_context,
                "baseline_snapshot_sha256": baseline["content_sha256"],
                "current_snapshot_sha256": current["content_sha256"],
                "differences": differences,
                "authority": {
                    "mode": "comparison-only", "mutation": "none", "network": "none",
                    "acceptance_inferred": False, "promotion": False, "causal_claim": False,
                },
                "limits": {
                    "raw_logs_included": False, "difference_rows": 64,
                    "diff_bytes": 32768,
                },
            }
            result = seal(unsealed)
            require(len(canonical_bytes(result)) <= registry["bounds"]["diff_bytes"],
                    "measurement diff exceeds physical bound")
            return result
        
        
        def verification_summary(kind: str, value: dict[str, Any],
                                 registry: dict[str, Any], registry_sha256: str) -> dict[str, Any]:
            if kind == "result":
                validate_result(value, registry, registry_sha256)
                return {
                    "schema": "mnx.measurement-verification.v1", "status": "pass",
                    "kind": "result", "registry_sha256": registry_sha256,
                    "content_sha256": value["content_sha256"],
                    "question_ids": [value["question_id"]],
                    "observed_at_epoch": value["observed_at_epoch"],
                    "normalized_statuses": {value["question_id"]: value["status"]},
                    "authority": {
                        "mode": "verification-only", "mutation": "none", "network": "none",
                        "accepted_baseline": False, "acceptance_inferred": False,
                        "promotion": False,
                    },
                }
            validate_snapshot(value, registry, registry_sha256, "measurement snapshot")
            return {
                "schema": "mnx.measurement-verification.v1", "status": "pass",
                "kind": "snapshot", "registry_sha256": registry_sha256,
                "content_sha256": value["content_sha256"],
                "question_ids": value["question_ids"],
                "observed_at_epoch": value["observed_at_epoch"],
                "normalized_statuses": {
                    question_id: value["results"][question_id]["status"]
                    for question_id in value["question_ids"]
                },
                "authority": {
                    "mode": "verification-only", "mutation": "none", "network": "none",
                    "accepted_baseline": False, "acceptance_inferred": False,
                    "promotion": False,
                },
            }
        
        
        def render(value: Any) -> None:
            json.dump(value, sys.stdout, sort_keys=True, indent=2, allow_nan=False)
            sys.stdout.write("\n")
        
        
        def main() -> int:
            parser = argparse.ArgumentParser(prog="mnx-measurement")
            parser.add_argument("--registry", type=pathlib.Path, default=DEFAULT_REGISTRY)
            commands = parser.add_subparsers(dest="command", required=True)
            commands.add_parser("registry")
            explain = commands.add_parser("explain")
            explain.add_argument("question")
            normalize_parser = commands.add_parser("normalize")
            normalize_parser.add_argument("question")
            normalize_parser.add_argument("evidence", type=pathlib.Path)
            normalize_parser.add_argument("--now", type=int, required=True)
            fixtures = commands.add_parser("fixtures")
            fixtures.add_argument("question", nargs="?")
            snapshot = commands.add_parser("snapshot")
            snapshot.add_argument("results", type=pathlib.Path, nargs="+")
            snapshot.add_argument("--qualification", type=pathlib.Path, required=True)
            snapshot.add_argument("--epoch-id", required=True)
            diff = commands.add_parser("diff")
            diff.add_argument("baseline", type=pathlib.Path)
            diff.add_argument("current", type=pathlib.Path)
            diff.add_argument("--axis", required=True)
            diff.add_argument("--now", type=int, required=True)
            verify = commands.add_parser("verify")
            verify.add_argument("kind", choices=("result", "snapshot"))
            verify.add_argument("artifact", type=pathlib.Path)
            commands.add_parser("self-test")
            arguments = parser.parse_args()
            try:
                registry, registry_sha256 = load_registry(arguments.registry)
                if arguments.command == "registry":
                    result = copy.deepcopy(registry)
                    result["registry_sha256"] = registry_sha256
                elif arguments.command == "explain":
                    result = question_by_id(registry, arguments.question)
                elif arguments.command == "normalize":
                    bounded_integer(arguments.now, "current epoch")
                    evidence, evidence_sha256 = load_evidence(arguments.evidence, registry)
                    result = normalize(registry, registry_sha256, arguments.question,
                                       evidence, evidence_sha256, arguments.now)
                elif arguments.command == "fixtures":
                    result = compile_fixtures(registry, registry_sha256, arguments.question)
                elif arguments.command == "snapshot":
                    result = build_snapshot(registry, registry_sha256, arguments.results,
                                            arguments.qualification, arguments.epoch_id)
                elif arguments.command == "diff":
                    bounded_integer(arguments.now, "current epoch")
                    baseline = load_json_file(
                        arguments.baseline, registry["bounds"]["snapshot_bytes"], "baseline snapshot",
                    )
                    current = load_json_file(
                        arguments.current, registry["bounds"]["snapshot_bytes"], "current snapshot",
                    )
                    result = compare_snapshots(registry, registry_sha256, baseline, current,
                                               arguments.axis, arguments.now)
                elif arguments.command == "verify":
                    maximum = (
                        registry["bounds"]["result_bytes"]
                        if arguments.kind == "result"
                        else registry["bounds"]["snapshot_bytes"]
                    )
                    artifact = load_json_file(
                        arguments.artifact, maximum, f"measurement {arguments.kind}",
                    )
                    result = verification_summary(
                        arguments.kind, artifact, registry, registry_sha256,
                    )
                else:
                    fixture_result = compile_fixtures(registry, registry_sha256, None)
                    require(fixture_result["fixture_count"] == 36,
                            "complete generated fixture inventory drifted")
                    require(set(fixture_result["statuses_observed"]) ==
                            set(registry["allowed_statuses"]),
                            "fixtures do not exercise every measurement status")
                    result = {
                        "schema": "mnx.measurement-kernel-self-test.v1", "status": "pass",
                        "registry_sha256": registry_sha256,
                        "question_count": len(registry["questions"]),
                        "fixture_count": fixture_result["fixture_count"],
                        "statuses_observed": fixture_result["statuses_observed"],
                        "authority": registry["authority"],
                    }
                render(result)
                return 0
            except (OSError, UnicodeError, ValueError, Refusal) as error:
                print(f"MNX_MEASUREMENT_REFUSED: {error}", file=sys.stderr)
                return 1
        
        
        if __name__ == "__main__":
            raise SystemExit(main())
      '';
      # MNX-MEASUREMENT-EMBED-END id=kernel
      checkPhase = ''
        export PYTHONPYCACHEPREFIX="$TMPDIR/pycache"
        ${pkgs.python3}/bin/python3 -I -B -m py_compile "$out"
      '';
    };
  };

  environment.etc."monsternix/bin/mnx-measurement-adapter" = {
    mode = "0555";
    source = pkgs.writeTextFile {
      name = "mnx-measurement-adapter";
      executable = true;
      # MNX-MEASUREMENT-EMBED-BEGIN id=adapter source_sha256=d86c843b78dc8b181f6d3ec2e912e74462e64e64706b484555cb6dd98224368c
      text = ''
        #!/usr/bin/env python3
        """Candidate-owned read-only adapter for the first measurement questions."""
        
        from __future__ import annotations
        
        import argparse
        import hashlib
        import json
        import os
        import pathlib
        import re
        import selectors
        import signal
        import stat
        import subprocess
        import sys
        import time
        from typing import Any
        
        
        ROOT = pathlib.Path(__file__).resolve().parent.parent
        DEFAULT_DESCRIPTOR = ROOT / "foundation/measurement-adapter.json"
        SHA256 = re.compile(r"^[0-9a-f]{64}$")
        UNIT = re.compile(r"^[A-Za-z0-9_.@:-]{1,200}\.(service|timer)$")
        SAFE = re.compile(r"^[A-Za-z0-9._:/@+,-]{1,256}$")
        QUESTION_IDS = (
            "source-closure-boot-default-lineage",
            "failed-unit-observer-health",
            "scheduled-work-freshness",
        )
        ATTEMPT_DISPOSITIONS = (
            "policy-refused", "cancelled", "infrastructure-failed",
            "observer-or-harness-failed", "subject-failed", "timed-out",
            "completed-unverified", "verified",
        )
        
        
        class Refusal(RuntimeError):
            pass
        
        
        def require(condition: bool, message: str) -> None:
            if not condition:
                raise Refusal(message)
        
        
        def canonical_bytes(value: Any) -> bytes:
            return (json.dumps(
                value, sort_keys=True, separators=(",", ":"), ensure_ascii=False,
                allow_nan=False,
            ) + "\n").encode("utf-8")
        
        
        def digest(raw: bytes) -> str:
            return hashlib.sha256(raw).hexdigest()
        
        
        def strict_object(raw: bytes, label: str) -> dict[str, Any]:
            def pairs(rows: list[tuple[str, Any]]) -> dict[str, Any]:
                result: dict[str, Any] = {}
                for key, value in rows:
                    if key in result:
                        raise Refusal(f"{label} contains duplicate JSON key: {key}")
                    result[key] = value
                return result
        
            def constant(value: str) -> Any:
                raise Refusal(f"{label} contains non-finite JSON number: {value}")
        
            try:
                value = json.loads(
                    raw.decode("utf-8", errors="strict"), object_pairs_hook=pairs,
                    parse_constant=constant,
                )
            except (UnicodeDecodeError, json.JSONDecodeError) as error:
                raise Refusal(f"{label} is not strict JSON: {error}") from error
            require(isinstance(value, dict), f"{label} must be a JSON object")
            return value
        
        
        def stable_regular(path: pathlib.Path, maximum: int, label: str,
                           *, follow_final_link: bool = False) -> bytes:
            selected = path.resolve(strict=True) if follow_final_link else path
            flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
            descriptor = os.open(selected, flags)
            try:
                before = os.fstat(descriptor)
                require(stat.S_ISREG(before.st_mode), f"{label} must be a regular file")
                require(before.st_size <= maximum, f"{label} exceeds {maximum} bytes")
                raw = bytearray()
                while len(raw) <= maximum:
                    block = os.read(descriptor, min(65536, maximum + 1 - len(raw)))
                    if not block:
                        break
                    raw.extend(block)
                after = os.fstat(descriptor)
                require(len(raw) <= maximum and len(raw) == before.st_size,
                        f"{label} size changed while being read")
                require(
                    (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) ==
                    (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns),
                    f"{label} changed while being read",
                )
                return bytes(raw)
            finally:
                os.close(descriptor)
        
        
        def stable_virtual(path: pathlib.Path, maximum: int, label: str) -> bytes:
            flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
            descriptor = os.open(path, flags)
            try:
                before = os.fstat(descriptor)
                require(stat.S_ISREG(before.st_mode), f"{label} must be a regular virtual file")
                raw = bytearray()
                while len(raw) <= maximum:
                    block = os.read(descriptor, min(4096, maximum + 1 - len(raw)))
                    if not block:
                        break
                    raw.extend(block)
                after = os.fstat(descriptor)
                require(len(raw) <= maximum, f"{label} exceeds {maximum} bytes")
                require((before.st_dev, before.st_ino, before.st_mode) ==
                        (after.st_dev, after.st_ino, after.st_mode),
                        f"{label} identity changed while being read")
                return bytes(raw)
            finally:
                os.close(descriptor)
        
        
        def exact_keys(value: dict[str, Any], keys: set[str], label: str) -> None:
            require(set(value) == keys,
                    f"{label} fields differ: missing={sorted(keys - set(value))} "
                    f"extra={sorted(set(value) - keys)}")
        
        
        def bounded_integer(value: Any, label: str, maximum: int = 2**63 - 1) -> int:
            require(isinstance(value, int) and not isinstance(value, bool) and
                    0 <= value <= maximum, f"invalid {label}")
            return value
        
        
        def safe(value: Any, label: str) -> str:
            require(isinstance(value, str) and SAFE.fullmatch(value) is not None,
                    f"invalid {label}")
            return value
        
        
        def load_descriptor(path: pathlib.Path) -> tuple[dict[str, Any], str]:
            raw = stable_regular(path, 16384, "measurement adapter descriptor")
            value = strict_object(raw, "measurement adapter descriptor")
            exact_keys(value, {
                "schema", "status", "adapter_id", "input_observation_schema",
                "question_ids", "scheduled_work", "bounds", "authority", "limitations",
            }, "measurement adapter descriptor")
            require(value["schema"] == "mnx.measurement-adapter.v1" and
                    value["status"] == "candidate-owned-live-reference",
                    "unsupported measurement adapter")
            safe(value["adapter_id"], "adapter id")
            require(value["input_observation_schema"] == "mnx.observation.v1" and
                    tuple(value["question_ids"]) == QUESTION_IDS,
                    "adapter question inventory drifted")
            scheduled = value["scheduled_work"]
            exact_keys(scheduled, {
                "job_id", "service_unit", "timer_unit", "singleton_by_systemd",
                "lock_observation", "success_maximum_age_seconds", "attempt_ledger_schema",
                "attempt_ledger_path", "attempt_ledger_contract_sha256",
                "attempt_ledger_max_bytes", "attempt_ledger_max_recent_attempts",
            }, "scheduled-work adapter")
            safe(scheduled["job_id"], "job id")
            require(isinstance(scheduled["service_unit"], str) and
                    UNIT.fullmatch(scheduled["service_unit"]) is not None and
                    scheduled["service_unit"].endswith(".service"), "invalid service unit")
            require(isinstance(scheduled["timer_unit"], str) and
                    UNIT.fullmatch(scheduled["timer_unit"]) is not None and
                    scheduled["timer_unit"].endswith(".timer"), "invalid timer unit")
            require(scheduled["singleton_by_systemd"] is True and
                    scheduled["lock_observation"] == "not-observed" and
                    scheduled["success_maximum_age_seconds"] == 28800 and
                    scheduled["attempt_ledger_schema"] == "mnx.scheduled-attempt-ledger.v1" and
                    scheduled["attempt_ledger_path"] ==
                    "/var/lib/monsternix/attempt-ledger/ledger.json" and
                    isinstance(scheduled["attempt_ledger_contract_sha256"], str) and
                    SHA256.fullmatch(scheduled["attempt_ledger_contract_sha256"]) is not None and
                    scheduled["attempt_ledger_max_bytes"] == 524288 and
                    scheduled["attempt_ledger_max_recent_attempts"] == 256,
                    "scheduled-work policy drifted")
            bounds = value["bounds"]
            exact_keys(bounds, {
                "adapter_bytes", "descriptor_bytes", "observation_bytes",
                "systemctl_executable_bytes", "systemctl_output_bytes",
                "systemctl_timeout_seconds", "output_files", "output_total_bytes",
            }, "adapter bounds")
            expected_bounds = {
                "adapter_bytes": 65536, "descriptor_bytes": 16384,
                "observation_bytes": 524288, "systemctl_executable_bytes": 67108864,
                "systemctl_output_bytes": 16384, "systemctl_timeout_seconds": 3,
                "output_files": 6, "output_total_bytes": 131072,
            }
            require(bounds == expected_bounds, "adapter physical bounds drifted")
            require(value["authority"] == {
                "mode": "read-only-live-observation", "host_mutation": "none",
                "artifact_mutation": "explicit-output-directory-only", "network": "none",
                "secrets": "none", "work_execution": False, "acceptance": False,
                "promotion": False, "publication": False, "remediation": False,
            }, "adapter enlarged authority")
            require(isinstance(value["limitations"], list) and len(value["limitations"]) == 6,
                    "adapter limitations drifted")
            return value, digest(raw)
        
        
        def parse_observed_at(value: Any) -> int:
            require(isinstance(value, str) and
                    re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z", value) is not None,
                    "observation timestamp is not canonical UTC")
            try:
                parsed = time.strptime(value, "%Y-%m-%dT%H:%M:%SZ")
            except ValueError as error:
                raise Refusal("observation timestamp is invalid") from error
            return int(calendar_timegm(parsed))
        
        
        def calendar_timegm(value: time.struct_time) -> int:
            # calendar.timegm is deliberately isolated to keep locale/timezone out of
            # the evidence identity while avoiding a dependency beyond Python itself.
            import calendar
            return calendar.timegm(value)
        
        
        def load_observation(path: pathlib.Path, maximum: int) -> dict[str, Any]:
            value = strict_object(stable_regular(path, maximum, "bounded observation"),
                                  "bounded observation")
            require(value.get("schema") == "mnx.observation.v1",
                    "unsupported observation schema")
            for field in ("source", "host", "system"):
                require(isinstance(value.get(field), dict), f"observation lacks {field}")
            require(isinstance(value.get("observed_at"), str), "observation time is absent")
            return value
        
        
        def bounded_command(executable: pathlib.Path, arguments: list[str],
                            timeout_seconds: int, maximum: int) -> tuple[int, bytes, str]:
            resolved = executable.resolve(strict=True)
            raw = stable_regular(resolved, 67108864, "systemctl executable")
            require(os.access(resolved, os.X_OK), "systemctl executable is not executable")
            environment = {
                "LC_ALL": "C", "LANG": "C", "SYSTEMD_COLORS": "0",
                "SYSTEMD_PAGER": "cat", "PATH": "/usr/bin:/bin",
            }
            process = subprocess.Popen(
                [str(resolved), *arguments], stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=environment,
                start_new_session=True,
            )
            require(process.stdout is not None, "systemctl output pipe is absent")
            os.set_blocking(process.stdout.fileno(), False)
            selector = selectors.DefaultSelector()
            selector.register(process.stdout, selectors.EVENT_READ)
            output = bytearray()
            deadline = time.monotonic() + timeout_seconds
            state = "completed"
            try:
                while True:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        state = "timed-out"
                        os.killpg(process.pid, signal.SIGTERM)
                        break
                    events = selector.select(min(remaining, 0.1))
                    for key, _ in events:
                        block = os.read(key.fd, min(4096, maximum + 1 - len(output)))
                        if block:
                            output.extend(block)
                            if len(output) > maximum:
                                state = "output-limit"
                                del output[maximum:]
                                os.killpg(process.pid, signal.SIGTERM)
                                break
                    if state != "completed" or process.poll() is not None:
                        break
                if state != "completed":
                    try:
                        process.wait(timeout=0.25)
                    except subprocess.TimeoutExpired:
                        os.killpg(process.pid, signal.SIGKILL)
                        process.wait(timeout=1)
                else:
                    tail = process.stdout.read(maximum + 1 - len(output)) or b""
                    output.extend(tail)
                    if len(output) > maximum:
                        state = "output-limit"
                        del output[maximum:]
            finally:
                selector.close()
                process.stdout.close()
            require(len(output) <= maximum, "systemctl output exceeded its byte bound")
            return process.returncode if process.returncode is not None else 124, bytes(output), state + ":" + digest(raw)
        
        
        def properties(raw: bytes, label: str) -> dict[str, str]:
            try:
                text = raw.decode("utf-8", errors="strict")
            except UnicodeDecodeError as error:
                raise Refusal(f"{label} output is not UTF-8") from error
            result: dict[str, str] = {}
            for line in text.splitlines():
                if not line:
                    continue
                require("=" in line, f"{label} emitted a non-property line")
                key, value = line.split("=", 1)
                require(re.fullmatch(r"[A-Za-z][A-Za-z0-9]+", key) is not None,
                        f"{label} emitted an invalid property")
                require(key not in result, f"{label} emitted duplicate property: {key}")
                result[key] = value
            return result
        
        
        def monotonic_epoch(value: str, now: int, uptime_seconds: float) -> int | None:
            if not value or not value.isdigit() or int(value) == 0:
                return None
            epoch = int(now - uptime_seconds + int(value) / 1_000_000)
            return max(0, min(epoch, now))
        
        
        def read_uptime(path: pathlib.Path) -> float:
            raw = stable_virtual(path, 128, "kernel uptime")
            try:
                token = raw.decode("ascii", errors="strict").split()[0]
                value = float(token)
            except (UnicodeDecodeError, ValueError, IndexError) as error:
                raise Refusal("kernel uptime is malformed") from error
            require(value >= 0 and value < 10**10, "kernel uptime is out of range")
            return value
        
        
        def observer(adapter_sha: str, descriptor_sha: str, health: str) -> dict[str, Any]:
            return {
                "id": "monsternix.candidate-live.v1",
                "sha256": digest(canonical_bytes({
                    "adapter_sha256": adapter_sha, "descriptor_sha256": descriptor_sha,
                })),
                "health": health,
            }
        
        
        def executable_scoped_observer(identity: dict[str, Any], executable_sha: str,
                                       health: str, ledger_sha: str | None = None) -> dict[str, Any]:
            return {
                "id": identity["id"] + ".systemctl",
                "sha256": digest(canonical_bytes({
                    "base_observer_sha256": identity["sha256"],
                    "systemctl_sha256": executable_sha,
                    "attempt_ledger_sha256": ledger_sha,
                })),
                "health": health,
            }
        
        
        def evidence(question: str, observed_at: int, capability: str,
                     identity: dict[str, Any], subject: dict[str, Any] | None) -> dict[str, Any]:
            return {
                "schema": "mnx.measurement-evidence.v1", "question_id": question,
                "observed_at_epoch": observed_at, "capability": capability,
                "observer": identity, "subject": subject,
            }
        
        
        def nullable_digest(value: Any) -> str | None:
            return value if isinstance(value, str) and SHA256.fullmatch(value) is not None else None
        
        
        def nullable_safe(value: Any) -> str | None:
            return value if isinstance(value, str) and SAFE.fullmatch(value) is not None else None
        
        
        def load_attempt_ledger(path: pathlib.Path, scheduled: dict[str, Any]) -> tuple[dict[str, Any], str]:
            raw = stable_regular(path, scheduled["attempt_ledger_max_bytes"], "attempt ledger")
            state = os.lstat(path)
            require(stat.S_IMODE(state.st_mode) == 0o644, "attempt ledger mode differs")
            value = strict_object(raw, "attempt ledger")
            exact_keys(value, {"schema", "contract_sha256", "job_id", "generation",
                               "records", "rollup", "ledger_sha256"}, "attempt ledger")
            require(value["schema"] == scheduled["attempt_ledger_schema"] and
                    value["contract_sha256"] == scheduled["attempt_ledger_contract_sha256"] and
                    value["job_id"] == scheduled["job_id"], "attempt ledger identity differs")
            bounded_integer(value["generation"], "attempt ledger generation")
            require(isinstance(value["records"], list) and
                    len(value["records"]) <= scheduled["attempt_ledger_max_recent_attempts"],
                    "attempt ledger recent window differs")
            identities: set[str] = set()
            for record in value["records"]:
                require(isinstance(record, dict), "attempt record must be an object")
                exact_keys(record, {
                    "schema", "job_id", "planned_slot_id", "attempt_id", "attempt_state",
                    "disposition", "attempt_started_at_epoch", "attempt_finished_at_epoch",
                    "exit_status", "source_sha256", "running_closure", "boot_id",
                    "trigger_observation_sha256", "systemd_result", "record_sha256",
                }, "attempt record")
                require(record["schema"] == "mnx.scheduled-attempt.v1" and
                        record["job_id"] == scheduled["job_id"], "attempt record identity differs")
                safe(record["planned_slot_id"], "planned slot id")
                safe(record["attempt_id"], "attempt id")
                require(record["attempt_id"] not in identities, "duplicate attempt identity")
                identities.add(record["attempt_id"])
                start = bounded_integer(record["attempt_started_at_epoch"], "attempt start")
                state_name = record["attempt_state"]
                require(state_name in {"running", "terminal"}, "invalid attempt state")
                if state_name == "running":
                    require(record["disposition"] is None and
                            record["attempt_finished_at_epoch"] is None,
                            "running attempt has terminal state")
                else:
                    require(record["disposition"] in ATTEMPT_DISPOSITIONS,
                            "invalid attempt disposition")
                    require(bounded_integer(record["attempt_finished_at_epoch"],
                                            "attempt finish") >= start,
                            "attempt finished before it started")
                require(isinstance(record["source_sha256"], str) and
                        SHA256.fullmatch(record["source_sha256"]) is not None and
                        isinstance(record["trigger_observation_sha256"], str) and
                        SHA256.fullmatch(record["trigger_observation_sha256"]) is not None,
                        "attempt record digest differs")
                body = {key: item for key, item in record.items() if key != "record_sha256"}
                require(record["record_sha256"] == digest(canonical_bytes(body)),
                        "attempt record seal differs")
            rollup = value["rollup"]
            exact_keys(rollup, {"compacted_attempt_count", "disposition_counts",
                                "chain_sha256", "through_finished_at_epoch",
                                "last_verified_success_epoch"}, "attempt rollup")
            bounded_integer(rollup["compacted_attempt_count"], "compacted attempts")
            require(set(rollup["disposition_counts"]) == set(ATTEMPT_DISPOSITIONS),
                    "rollup dispositions differ")
            for name in ATTEMPT_DISPOSITIONS:
                bounded_integer(rollup["disposition_counts"][name], f"{name} count")
            require(sum(rollup["disposition_counts"].values()) ==
                    rollup["compacted_attempt_count"], "rollup counts do not close")
            require(isinstance(rollup["chain_sha256"], str) and
                    SHA256.fullmatch(rollup["chain_sha256"]) is not None,
                    "rollup chain digest differs")
            for name in ("through_finished_at_epoch", "last_verified_success_epoch"):
                if rollup[name] is not None:
                    bounded_integer(rollup[name], name)
            body = {key: item for key, item in value.items() if key != "ledger_sha256"}
            require(value["ledger_sha256"] == digest(canonical_bytes(body)),
                    "attempt ledger seal differs")
            return value, digest(raw)
        
        
        def ledger_last_verified(ledger: dict[str, Any]) -> int | None:
            values = [record["attempt_finished_at_epoch"] for record in ledger["records"]
                      if record["attempt_state"] == "terminal" and
                      record["disposition"] == "verified"]
            rolled = ledger["rollup"]["last_verified_success_epoch"]
            if rolled is not None:
                values.append(rolled)
            return max(values) if values else None
        
        
        def apply_attempt_ledger(subject: dict[str, Any], ledger: dict[str, Any],
                                 invocation: str, active: bool) -> tuple[dict[str, Any], str]:
            last_success = ledger_last_verified(ledger)
            subject["last_verified_success_epoch"] = last_success
            if not invocation:
                return subject, "ledger-history-only"
            attempt_id = "invocation-" + invocation
            record = next((item for item in ledger["records"]
                           if item["attempt_id"] == attempt_id), None)
            if record is None:
                return subject, "ledger-current-attempt-absent"
            if active:
                require(record["attempt_state"] == "running",
                        "active systemd invocation is terminal in the attempt ledger")
            else:
                require(record["attempt_state"] == "terminal",
                        "inactive systemd invocation is still running in the attempt ledger")
            return {
                "job_id": record["job_id"], "planned_slot_id": record["planned_slot_id"],
                "attempt_id": record["attempt_id"], "attempt_state": record["attempt_state"],
                "disposition": record["disposition"],
                "attempt_started_at_epoch": record["attempt_started_at_epoch"],
                "attempt_finished_at_epoch": record["attempt_finished_at_epoch"],
                "last_verified_success_epoch": last_success,
                "active_instances": 1 if active else 0,
                "lock_state": subject["lock_state"],
            }, "ledger-current-attempt-matched"
        
        
        def collect_scheduled(descriptor: dict[str, Any], systemctl: pathlib.Path | None,
                              uptime_file: pathlib.Path, attempt_ledger: pathlib.Path,
                              now: int,
                              observed_runtime: str, identity: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any]]:
            question = QUESTION_IDS[2]
            if observed_runtime != "nixos-systemd":
                return evidence(question, now, "not-applicable", identity, None), {
                    "state": "not-applicable", "systemctl_sha256": None,
                }
            if systemctl is None:
                return evidence(question, now, "absent", identity, None), {
                    "state": "systemctl-absent", "systemctl_sha256": None,
                }
            scheduled = descriptor["scheduled_work"]
            wanted_service = [
                "LoadState", "ActiveState", "SubState", "Result", "InvocationID",
                "ExecMainStartTimestampMonotonic", "ExecMainExitTimestampMonotonic",
            ]
            wanted_timer = ["LoadState", "LastTriggerUSec", "NextElapseUSecRealtime"]
            service_rc, service_raw, service_state = bounded_command(
                systemctl, ["show", scheduled["service_unit"], "--no-pager",
                            "--property=" + ",".join(wanted_service)],
                descriptor["bounds"]["systemctl_timeout_seconds"],
                descriptor["bounds"]["systemctl_output_bytes"],
            )
            binary_sha = service_state.split(":", 1)[1]
            probed_identity = executable_scoped_observer(identity, binary_sha, "healthy")
            if service_state.startswith("timed-out"):
                unavailable = executable_scoped_observer(identity, binary_sha, "unavailable")
                return evidence(question, now, "timed-out", unavailable, None), {
                    "state": "timed-out", "systemctl_sha256": binary_sha,
                }
            if service_state.startswith("output-limit"):
                unavailable = executable_scoped_observer(identity, binary_sha, "unavailable")
                return evidence(question, now, "output-limited", unavailable, None), {
                    "state": "output-limit", "systemctl_sha256": binary_sha,
                }
            timer_rc, timer_raw, timer_state = bounded_command(
                systemctl, ["show", scheduled["timer_unit"], "--no-pager",
                            "--property=" + ",".join(wanted_timer)],
                descriptor["bounds"]["systemctl_timeout_seconds"],
                descriptor["bounds"]["systemctl_output_bytes"],
            )
            if timer_state.split(":", 1)[1] != binary_sha:
                raise Refusal("systemctl executable identity changed between queries")
            if timer_state.startswith(("timed-out", "output-limit")):
                unavailable = executable_scoped_observer(identity, binary_sha, "unavailable")
                capability = "output-limited" if timer_state.startswith("output-limit") else "timed-out"
                return evidence(question, now, capability, unavailable, None), {
                    "state": timer_state.split(":", 1)[0], "systemctl_sha256": binary_sha,
                }
            service = properties(service_raw, "service query")
            timer = properties(timer_raw, "timer query")
            if service.get("LoadState") == "not-found" or timer.get("LoadState") == "not-found":
                return evidence(question, now, "absent", probed_identity, None), {
                    "state": "declared-unit-absent", "systemctl_sha256": binary_sha,
                }
            if service_rc != 0 or timer_rc != 0:
                unavailable = executable_scoped_observer(identity, binary_sha, "unavailable")
                return evidence(question, now, "permission-denied", unavailable, None), {
                    "state": f"query-failed:{service_rc}:{timer_rc}",
                    "systemctl_sha256": binary_sha,
                }
            require(set(wanted_service) <= set(service) and set(wanted_timer) <= set(timer),
                    "systemctl property set is incomplete")
            uptime = read_uptime(uptime_file)
            started = monotonic_epoch(service["ExecMainStartTimestampMonotonic"], now, uptime)
            finished = monotonic_epoch(service["ExecMainExitTimestampMonotonic"], now, uptime)
            invocation = service["InvocationID"]
            active = service["ActiveState"] in {"active", "activating", "deactivating"}
            if active:
                require(invocation != "" and started is not None,
                        "active scheduled unit lacks attempt identity")
                subject = {
                    "job_id": scheduled["job_id"],
                    "planned_slot_id": "timer-" + digest(timer["LastTriggerUSec"].encode())[:24],
                    "attempt_id": "invocation-" + invocation,
                    "attempt_state": "running", "disposition": None,
                    "attempt_started_at_epoch": started, "attempt_finished_at_epoch": None,
                    "last_verified_success_epoch": None, "active_instances": 1,
                    "lock_state": scheduled["lock_observation"],
                }
            elif invocation == "" or started is None:
                subject = {
                    "job_id": scheduled["job_id"],
                    "planned_slot_id": "timer-" + digest(timer["LastTriggerUSec"].encode())[:24],
                    "attempt_id": None, "attempt_state": "not-started",
                    "disposition": "not-started", "attempt_started_at_epoch": None,
                    "attempt_finished_at_epoch": None, "last_verified_success_epoch": None,
                    "active_instances": 0, "lock_state": scheduled["lock_observation"],
                }
            else:
                if finished is None:
                    finished = started
                    disposition = "completed-unverified"
                else:
                    result_map = {
                        "success": "verified", "timeout": "timed-out",
                        "exit-code": "subject-failed", "signal": "subject-failed",
                        "core-dump": "subject-failed", "watchdog": "subject-failed",
                        "start-limit-hit": "infrastructure-failed", "resources": "infrastructure-failed",
                    }
                    disposition = result_map.get(service["Result"], "completed-unverified")
                subject = {
                    "job_id": scheduled["job_id"],
                    "planned_slot_id": "timer-" + digest(timer["LastTriggerUSec"].encode())[:24],
                    "attempt_id": "invocation-" + invocation,
                    "attempt_state": "terminal", "disposition": disposition,
                    "attempt_started_at_epoch": started, "attempt_finished_at_epoch": finished,
                    "last_verified_success_epoch": finished if disposition == "verified" else None,
                    "active_instances": 0, "lock_state": scheduled["lock_observation"],
                }
            ledger_sha: str | None = None
            ledger_state = "absent-systemd-fallback"
            if attempt_ledger.exists() or attempt_ledger.is_symlink():
                try:
                    ledger, ledger_sha = load_attempt_ledger(attempt_ledger, scheduled)
                    subject, ledger_state = apply_attempt_ledger(subject, ledger, invocation, active)
                except PermissionError:
                    unavailable = executable_scoped_observer(identity, binary_sha, "unavailable")
                    return evidence(question, now, "permission-denied", unavailable, None), {
                        "state": "attempt-ledger-permission-denied", "systemctl_sha256": binary_sha,
                        "attempt_ledger_state": "permission-denied", "attempt_ledger_sha256": None,
                    }
                except (OSError, UnicodeError, ValueError, Refusal):
                    unavailable = executable_scoped_observer(identity, binary_sha, "unavailable")
                    return evidence(question, now, "malformed", unavailable, None), {
                        "state": "attempt-ledger-malformed", "systemctl_sha256": binary_sha,
                        "attempt_ledger_state": "malformed", "attempt_ledger_sha256": None,
                    }
            return evidence(question, now, "observed", probed_identity, subject), {
                "state": "observed", "systemctl_sha256": binary_sha,
                "attempt_ledger_state": ledger_state, "attempt_ledger_sha256": ledger_sha,
            }
        
        
        def secure_parent(path: pathlib.Path) -> None:
            require(path.is_absolute(), "output directory must be absolute")
            parent = path.parent
            before = os.lstat(parent)
            require(stat.S_ISDIR(before.st_mode) and not stat.S_ISLNK(before.st_mode),
                    "output parent must be a non-link directory")
            require(before.st_uid == os.geteuid(), "output parent must be owned by the caller")
            require(before.st_mode & 0o022 == 0, "output parent must not be group/other writable")
            require(not path.exists() and not path.is_symlink(), "output directory already exists")
        
        
        def write_exclusive(path: pathlib.Path, raw: bytes) -> None:
            descriptor = os.open(
                path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0), 0o600,
            )
            try:
                view = memoryview(raw)
                while view:
                    written = os.write(descriptor, view)
                    view = view[written:]
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
        
        
        def collect(arguments: argparse.Namespace, descriptor: dict[str, Any],
                    descriptor_sha: str) -> dict[str, Any]:
            now = bounded_integer(arguments.now, "current epoch")
            observation = load_observation(arguments.observation,
                                           descriptor["bounds"]["observation_bytes"])
            observed_at = parse_observed_at(observation["observed_at"])
            require(abs(now - observed_at) <= 300, "observation is outside the 300-second adapter window")
            adapter_raw = stable_regular(pathlib.Path(__file__).resolve(),
                                         descriptor["bounds"]["adapter_bytes"], "adapter")
            adapter_sha = digest(adapter_raw)
            healthy = observer(adapter_sha, descriptor_sha, "healthy")
            source = observation["source"]
            system = observation["system"]
            host = observation["host"]
            source_sha = nullable_digest(source.get("sha256"))
            require(source_sha is not None, "observation lacks a candidate source digest")
            lineage_subject = {
                "source_sha256": source_sha,
                "embedded_source_sha256": nullable_digest(source.get("embedded_sha256")),
                "running_closure": nullable_safe(system.get("running_closure")),
                "boot_default_closure": nullable_safe(system.get("boot_default_closure")),
            }
            lineage = evidence(QUESTION_IDS[0], observed_at, "observed", healthy, lineage_subject)
            failed = system.get("failed_unit_observer")
            require(isinstance(failed, dict), "observation lacks failed-unit observer")
            failed_status = failed.get("status")
            failed_rc = failed.get("rc")
            failed_units = system.get("failed_units")
            mapping = {
                "observed-none": "observed-none", "observed-present": "observed-failures",
                "observer-malfunction": "failed",
            }
            if failed_status == "not-observed":
                failed_evidence = evidence(QUESTION_IDS[1], observed_at, "not-applicable", healthy, None)
            else:
                require(failed_status in mapping and isinstance(failed_rc, int) and
                        isinstance(failed_units, list), "failed-unit observation is malformed")
                failed_evidence = evidence(QUESTION_IDS[1], observed_at, "observed", healthy, {
                    "observer_status": mapping[failed_status], "observer_rc": failed_rc,
                    "failed_units": failed_units,
                })
            scheduled_evidence, scheduled_probe = collect_scheduled(
                descriptor, arguments.systemctl, arguments.uptime_file,
                arguments.attempt_ledger or pathlib.Path(
                    descriptor["scheduled_work"]["attempt_ledger_path"]), now,
                str(host.get("runtime_mode", "unknown")), healthy,
            )
            # A snapshot is one observational epoch and therefore carries one observer
            # identity.  When systemctl participated, bind its exact bytes into that
            # common identity rather than making only one question look as though it
            # came from a different evaluator.
            systemctl_sha = scheduled_probe["systemctl_sha256"]
            attempt_ledger_sha = scheduled_probe.get("attempt_ledger_sha256")
            epoch_observer = (
                executable_scoped_observer(
                    healthy, systemctl_sha, "healthy", attempt_ledger_sha)
                if systemctl_sha is not None else healthy
            )
            scheduled_health = scheduled_evidence["observer"]["health"]
            lineage["observer"] = epoch_observer
            failed_evidence["observer"] = epoch_observer
            scheduled_evidence["observer"] = {
                **epoch_observer, "health": scheduled_health,
            }
            host_identity = {
                "kernel": str(host.get("kernel", "unknown")),
                "architecture": str(host.get("architecture", "unknown")),
                "boot_id": str(host.get("boot_id", "unknown")),
            }
