  #@MNX-PART id=10.00.reconstruction-curriculum-renderer kind=mechanism title="Source-bound substrate reconstruction curriculum renderer"
  environment.etc."monsternix/bin/mnx-reconstruct" = {
    mode = "0555";
    source = pkgs.writeTextFile {
      name = "mnx-reconstruct";
      executable = true;
      # MNX-RECONSTRUCTION-EMBED-BEGIN id=reconstruction-engine source_sha256=4bf7afec7934d4c18e112781262d5333882302698b37da7b0ac6b39746d16f99
      text = ''
        #!/usr/bin/env python3
        """Render a source-bound Monsternix reconstruction curriculum without executing it."""

        from __future__ import annotations

        import argparse
        import hashlib
        import json
        import os
        import pathlib
        import re
        import stat
        import sys
        from typing import Any


        SCHEMA = "mnx.reconstruction-contract.v1"
        REPORT_SCHEMA = "mnx.reconstruction-curriculum.v1"
        MAX_CONTRACT = 128 * 1024
        MAX_SOURCE = 16 * 1024 * 1024
        IDENTIFIER = re.compile(r"^[a-z][a-z0-9-]{0,95}$")
        HARD_PROHIBITIONS = {
            "current-nix-source-runs-on-another-substrate",
            "contract-digest-proves-authorship-or-trust",
            "static-curriculum-proves-runtime-equivalence",
            "reconstruction-evidence-authorizes-migration",
            "successful-rendering-authorizes-host-mutation",
        }
        AUTHORITY = {
            "activation": False,
            "automatic_adapter_generation": False,
            "host_mutation": False,
            "migration_authorization": False,
            "network_access": False,
            "operator_acceptance": False,
            "payload_execution": False,
            "secret_access": False,
        }


        class Refusal(RuntimeError):
            pass


        def require(condition: bool, message: str) -> None:
            if not condition:
                raise Refusal(message)


        def digest(raw: bytes) -> str:
            return hashlib.sha256(raw).hexdigest()


        def canonical(value: Any) -> bytes:
            return (json.dumps(
                value, sort_keys=True, separators=(",", ":"), ensure_ascii=False,
                allow_nan=False,
            ) + "\n").encode("utf-8")


        def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
            result: dict[str, Any] = {}
            for key, value in pairs:
                require(key not in result, f"duplicate JSON key: {key}")
                result[key] = value
            return result


        def strict_json(raw: bytes, label: str) -> Any:
            def reject_constant(value: str) -> None:
                raise Refusal(f"non-finite JSON number in {label}: {value}")

            try:
                return json.loads(
                    raw.decode("utf-8", errors="strict"),
                    object_pairs_hook=unique_object,
                    parse_constant=reject_constant,
                )
            except (UnicodeError, json.JSONDecodeError) as error:
                raise Refusal(f"invalid JSON in {label}: {error}") from error


        def exact(value: dict[str, Any], keys: set[str], label: str) -> None:
            require(set(value) == keys,
                    f"{label} keys differ: expected={sorted(keys)} actual={sorted(value)}")


        def stable_regular(path: pathlib.Path, limit: int, label: str,
                           allow_store_link: bool = False) -> tuple[bytes, pathlib.Path]:
            try:
                before = path.lstat()
            except OSError as error:
                raise Refusal(f"{label} is unavailable: {path}: {error}") from error
            resolved = path
            if stat.S_ISLNK(before.st_mode):
                require(allow_store_link, f"{label} must be a regular non-link file: {path}")
                try:
                    resolved = path.resolve(strict=True)
                except OSError as error:
                    raise Refusal(f"{label} link cannot be resolved: {path}: {error}") from error
                require(str(resolved).startswith("/nix/store/"),
                        f"{label} link must resolve beneath /nix/store: {path}")
                before = resolved.lstat()
            else:
                try:
                    resolved = path.resolve(strict=True)
                except OSError as error:
                    raise Refusal(f"{label} cannot be resolved: {path}: {error}") from error
                before = resolved.lstat()
            require(stat.S_ISREG(before.st_mode), f"{label} is not a regular file: {path}")
            require(0 <= before.st_size <= limit, f"{label} exceeds {limit} bytes: {path}")
            try:
                raw = resolved.read_bytes()
                after = resolved.lstat()
            except OSError as error:
                raise Refusal(f"{label} could not be read: {path}: {error}") from error
            require(
                (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) ==
                (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns),
                f"{label} changed while reading: {path}",
            )
            require(len(raw) == before.st_size, f"{label} was read incompletely: {path}")
            return raw, resolved


        def identifier(value: Any, label: str) -> str:
            require(isinstance(value, str) and IDENTIFIER.fullmatch(value) is not None,
                    f"{label} is not a bounded identifier")
            return value


        def string_list(value: Any, label: str, maximum: int) -> list[str]:
            require(isinstance(value, list) and 1 <= len(value) <= maximum,
                    f"{label} must contain 1..{maximum} strings")
            require(all(isinstance(item, str) and item and "\x00" not in item and
                        len(item.encode("utf-8")) <= 512 for item in value),
                    f"{label} contains an invalid string")
            require(len(value) == len(set(value)), f"{label} contains duplicates")
            return value


        def normalized_relative(value: Any, label: str) -> pathlib.PurePosixPath:
            require(isinstance(value, str) and value and not value.startswith("/") and
                    "\\" not in value and "\x00" not in value,
                    f"{label} must be a repository-relative path")
            relative = pathlib.PurePosixPath(value)
            require(value == relative.as_posix() and
                    all(part not in {"", ".", ".."} for part in relative.parts),
                    f"{label} is not a normalized relative path: {value!r}")
            return relative


        def validate_contract(value: Any) -> dict[str, Any]:
            require(isinstance(value, dict), "reconstruction contract must be an object")
            exact(value, {
                "schema", "status", "current_substrate", "current_source_portable",
                "authority", "limits", "portable_contracts", "adapter_classes",
                "reconstruction_order", "carry_artifacts", "prohibited_claims", "laws",
            }, "contract")
            require(value["schema"] == SCHEMA and value["status"] == "active",
                    "unsupported or inactive reconstruction contract")
            require(value["current_substrate"] == "nixos" and
                    value["current_source_portable"] is False,
                    "current substrate must remain an explicitly nonportable NixOS binding")
            require(value["authority"] == AUTHORITY,
                    "reconstruction contract enlarged authority")

            limits = value["limits"]
            require(isinstance(limits, dict), "contract limits must be an object")
            exact(limits, {
                "artifact_bytes", "artifacts", "contract_bytes", "identifier_bytes",
                "source_bytes", "source_markers_per_contract", "steps",
                "witnesses_per_adapter",
            }, "limits")
            expected_bounds = {
                "artifact_bytes": (1, 64 * 1024 * 1024),
                "artifacts": (1, 256),
                "contract_bytes": (1, MAX_CONTRACT),
                "identifier_bytes": (1, 96),
                "source_bytes": (1, MAX_SOURCE),
                "source_markers_per_contract": (1, 16),
                "steps": (1, 64),
                "witnesses_per_adapter": (1, 32),
            }
            for key, (minimum, maximum) in expected_bounds.items():
                require(isinstance(limits[key], int) and not isinstance(limits[key], bool) and
                        minimum <= limits[key] <= maximum,
                        f"limit {key} is outside the hard bound")

            portable = value["portable_contracts"]
            adapters = value["adapter_classes"]
            steps = value["reconstruction_order"]
            artifacts = value["carry_artifacts"]
            require(isinstance(portable, list) and 1 <= len(portable) <= 64,
                    "portable contract inventory is empty or excessive")
            require(isinstance(adapters, list) and 1 <= len(adapters) <= 32,
                    "adapter class inventory is empty or excessive")
            require(isinstance(steps, list) and 1 <= len(steps) <= limits["steps"],
                    "reconstruction order is empty or excessive")
            require(isinstance(artifacts, list) and 1 <= len(artifacts) <= limits["artifacts"],
                    "carry artifact inventory is empty or excessive")

            adapter_ids: list[str] = []
            for index, adapter in enumerate(adapters):
                require(isinstance(adapter, dict), f"adapter class {index} is not an object")
                exact(adapter, {"id", "current_binding", "successor_witnesses"},
                      f"adapter class {index}")
                adapter_id = identifier(adapter["id"], f"adapter class {index} id")
                identifier(adapter["current_binding"], f"adapter class {adapter_id} binding")
                witnesses = string_list(adapter["successor_witnesses"],
                                        f"adapter class {adapter_id} witnesses",
                                        limits["witnesses_per_adapter"])
                for witness in witnesses:
                    identifier(witness, f"adapter class {adapter_id} witness")
                adapter_ids.append(adapter_id)
            require(len(adapter_ids) == len(set(adapter_ids)), "adapter class ids are not unique")
            adapter_set = set(adapter_ids)

            portable_ids: list[str] = []
            portable_adapters: set[str] = set()
            for index, item in enumerate(portable):
                require(isinstance(item, dict), f"portable contract {index} is not an object")
                exact(item, {"id", "adapter_classes", "source_markers"},
                      f"portable contract {index}")
                item_id = identifier(item["id"], f"portable contract {index} id")
                mapped = string_list(item["adapter_classes"],
                                     f"portable contract {item_id} adapter classes", 16)
                require(set(mapped) <= adapter_set,
                        f"portable contract {item_id} names an unknown adapter class")
                markers = string_list(item["source_markers"],
                                      f"portable contract {item_id} source markers",
                                      limits["source_markers_per_contract"])
                require(all("\n" not in marker and marker.startswith("#") for marker in markers),
                        f"portable contract {item_id} source marker is not one exact comment line")
                portable_ids.append(item_id)
                portable_adapters.update(mapped)
            require(len(portable_ids) == len(set(portable_ids)),
                    "portable contract ids are not unique")
            require(portable_adapters == adapter_set,
                    "portable contracts do not map every adapter class")
            portable_set = set(portable_ids)

            preserved: set[str] = set()
            replaced: set[str] = set()
            step_ids: list[str] = []
            for index, step in enumerate(steps, 1):
                require(isinstance(step, dict), f"reconstruction step {index} is not an object")
                exact(step, {"order", "id", "preserves", "replaces"},
                      f"reconstruction step {index}")
                require(step["order"] == index, "reconstruction step order is not contiguous")
                step_id = identifier(step["id"], f"reconstruction step {index} id")
                preserves = string_list(step["preserves"], f"step {step_id} preserves", 32)
                replaces = string_list(step["replaces"], f"step {step_id} replaces", 32)
                require(set(preserves) <= portable_set,
                        f"step {step_id} names an unknown portable contract")
                require(set(replaces) <= adapter_set,
                        f"step {step_id} names an unknown adapter class")
                step_ids.append(step_id)
                preserved.update(preserves)
                replaced.update(replaces)
            require(len(step_ids) == len(set(step_ids)), "reconstruction step ids are not unique")
            require(preserved == portable_set,
                    "reconstruction order does not preserve every portable contract")
            require(replaced == adapter_set,
                    "reconstruction order does not replace every current adapter class")

            artifact_paths: list[str] = []
            for index, artifact in enumerate(artifacts):
                require(isinstance(artifact, dict), f"carry artifact {index} is not an object")
                exact(artifact, {"path", "role"}, f"carry artifact {index}")
                relative = normalized_relative(artifact["path"], f"carry artifact {index} path")
                identifier(artifact["role"], f"carry artifact {relative} role")
                artifact_paths.append(relative.as_posix())
            require(len(artifact_paths) == len(set(artifact_paths)),
                    "carry artifact paths are not unique")
            prohibited = set(string_list(value["prohibited_claims"], "prohibited claims", 32))
            require(HARD_PROHIBITIONS <= prohibited,
                    "reconstruction contract omitted a hard prohibited claim")
            string_list(value["laws"], "reconstruction laws", 32)
            return value


        def source_record(path: pathlib.Path, contract: dict[str, Any]) -> dict[str, Any]:
            raw, resolved = stable_regular(
                path, contract["limits"]["source_bytes"], "Monsternix source",
                allow_store_link=True,
            )
            require(b"\x00" not in raw, "Monsternix source contains a NUL byte")
            try:
                text = raw.decode("utf-8", errors="strict")
            except UnicodeError as error:
                raise Refusal(f"Monsternix source is not strict UTF-8: {error}") from error
            lines = set(text.splitlines())
            verified: list[dict[str, Any]] = []
            for item in contract["portable_contracts"]:
                missing = [marker for marker in item["source_markers"] if marker not in lines]
                if missing:
                    raise Refusal(
                        f"source does not witness portable contract {item['id']}: {missing[0]}"
                    )
                verified.append({
                    "id": item["id"],
                    "adapter_classes": item["adapter_classes"],
                    "source_marker_count": len(item["source_markers"]),
                    "source_markers_verified": True,
                })
            return {
                "path": str(path),
                "resolved_path": str(resolved),
                "sha256": digest(raw),
                "bytes": len(raw),
                "lines": text.count("\n") + (1 if text and not text.endswith("\n") else 0),
                "portable_contracts": verified,
            }


        def artifact_records(root: pathlib.Path | None, contract: dict[str, Any]) -> dict[str, Any]:
            if root is None:
                return {
                    "mode": "not-requested",
                    "root": None,
                    "verified": False,
                    "count": len(contract["carry_artifacts"]),
                    "records": [],
                }
            try:
                root_info = root.lstat()
                root_resolved = root.resolve(strict=True)
            except OSError as error:
                raise Refusal(f"artifact root is unavailable: {root}: {error}") from error
            require(stat.S_ISDIR(root_info.st_mode) and not stat.S_ISLNK(root_info.st_mode),
                    "artifact root must be a real directory")
            records: list[dict[str, Any]] = []
            for artifact in contract["carry_artifacts"]:
                relative = normalized_relative(artifact["path"], "carry artifact path")
                current = root
                for component in relative.parts[:-1]:
                    current = current / component
                    try:
                        info = current.lstat()
                    except OSError as error:
                        raise Refusal(f"carry artifact parent is unavailable: {current}: {error}") from error
                    require(stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode),
                            f"carry artifact crosses an unsafe directory: {current}")
                path = root.joinpath(*relative.parts)
                raw, resolved = stable_regular(
                    path, contract["limits"]["artifact_bytes"],
                    f"carry artifact {relative}", allow_store_link=False,
                )
                try:
                    resolved.relative_to(root_resolved)
                except ValueError as error:
                    raise Refusal(f"carry artifact escapes root: {relative}") from error
                records.append({
                    "path": relative.as_posix(),
                    "role": artifact["role"],
                    "sha256": digest(raw),
                    "bytes": len(raw),
                })
            return {
                "mode": "closed-tree",
                "root": str(root),
                "verified": True,
                "count": len(records),
                "records": records,
                "manifest_sha256": digest(canonical(records)),
            }


        def build_report(source: pathlib.Path, contract_path: pathlib.Path,
                         root: pathlib.Path | None) -> dict[str, Any]:
            contract_raw, contract_resolved = stable_regular(
                contract_path, MAX_CONTRACT, "reconstruction contract", allow_store_link=True,
            )
            contract = validate_contract(strict_json(contract_raw, "reconstruction contract"))
            require(len(contract_raw) <= contract["limits"]["contract_bytes"],
                    "contract exceeds its own byte limit")
            source_value = source_record(source, contract)
            artifact_value = artifact_records(root, contract)
            body: dict[str, Any] = {
                "schema": REPORT_SCHEMA,
                "status": "ready-as-verified-curriculum",
                "current_substrate": contract["current_substrate"],
                "current_source_portable": False,
                "source": source_value,
                "contract": {
                    "path": str(contract_path),
                    "resolved_path": str(contract_resolved),
                    "sha256": digest(contract_raw),
                    "bytes": len(contract_raw),
                    "schema": contract["schema"],
                },
                "adapter_classes": contract["adapter_classes"],
                "reconstruction_order": contract["reconstruction_order"],
                "carry_artifacts": artifact_value,
                "prohibited_claims": contract["prohibited_claims"],
                "operator_acceptance_path": [
                    "sudo mnx test --config /etc/nixos/configuration.nix",
                    "sudo mnx switch --config /etc/nixos/configuration.nix",
                ],
                "authority": {
                    **AUTHORITY,
                    "mode": "read-only-curriculum",
                    "source_executed": False,
                    "artifacts_executed": False,
                    "mutation_performed": False,
                },
            }
            body["content_sha256"] = digest(canonical(body))
            return body


        def render_text(report: dict[str, Any]) -> str:
            rows = [
                "################################################################################",
                "# MONSTERNIX RECONSTRUCTION CURRICULUM — EVIDENCE, NOT PORTABILITY",
                "################################################################################",
                f"status={report['status']}",
                f"source_sha256={report['source']['sha256']}",
                f"contract_sha256={report['contract']['sha256']}",
                f"current_substrate={report['current_substrate']}",
                "current_source_portable=no",
                f"portable_contract_count={len(report['source']['portable_contracts'])}",
                f"adapter_class_count={len(report['adapter_classes'])}",
                f"artifact_verification={report['carry_artifacts']['mode']}",
                "",
                "Reconstruction order:",
            ]
            for step in report["reconstruction_order"]:
                rows.append(
                    f"  {step['order']}. {step['id']} "
                    f"[preserve={','.join(step['preserves'])}; replace={','.join(step['replaces'])}]"
                )
            rows.extend(["", "Current adapter obligations:"])
            for adapter in report["adapter_classes"]:
                rows.append(
                    f"  {adapter['id']}: {adapter['current_binding']} -> "
                    f"{','.join(adapter['successor_witnesses'])}"
                )
            rows.extend([
                "",
                "claims_not_made=" + ",".join(report["prohibited_claims"]),
                "network_used=no",
                "payload_executed=no",
                "mutation=none",
                "acceptance=sudo-mnx-test-then-sudo-mnx-switch",
                f"content_sha256={report['content_sha256']}",
                "MNX_RECONSTRUCTION_CURRICULUM=PASS",
            ])
            return "\n".join(rows) + "\n"


        def main() -> int:
            parser = argparse.ArgumentParser(prog="mnx-reconstruct")
            parser.add_argument("--source", type=pathlib.Path, required=True)
            parser.add_argument("--contract", type=pathlib.Path, required=True)
            parser.add_argument("--root", type=pathlib.Path)
            parser.add_argument("--json", action="store_true")
            arguments = parser.parse_args()
            try:
                report = build_report(arguments.source, arguments.contract, arguments.root)
                if arguments.json:
                    sys.stdout.buffer.write(canonical(report))
                else:
                    sys.stdout.write(render_text(report))
                return 0
            except (OSError, ValueError, KeyError, TypeError, Refusal) as error:
