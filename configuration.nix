#@MNX-DEF path=environment.etc."monsternix/bin/mnx-eject-engine" section=10.00 role=generated-program ordinal=004
  #@MNX-PART id=10.00.foundation-ejection-engine kind=mechanism title="Profile-aware plain-NixOS and Foundation source projection"
  # SUCCESSOR DIALOGUE: keep this engine ignorant of machine meaning.  Bridges
  # classify ownership; the engine only proves exact disposition and parsing.
  environment.etc."monsternix/bin/mnx-eject-engine" = {
    source = pkgs.writeTextFile {
      name = "mnx-eject-engine";
      executable = true;
      # MNX-EJECTION-EMBED-BEGIN id=eject-engine source_sha256=73249ecdb378bb10508d0c5b064af451bbc96c9ff253d15d730ea977b090a269
      text = ''
        #!/usr/bin/env python3
        """Project one owned Monsternix source into plain NixOS or Foundation."""

        from __future__ import annotations

        import argparse
        import hashlib
        import json
        import os
        import pathlib
        import re
        import stat
        import subprocess
        import sys
        import tempfile
        from typing import Any


        BEGIN = re.compile(r"^(?P<indent>\s*)# MNX-EJECT-BEGIN owner=(?P<owner>[a-z0-9][a-z0-9.-]*)\s*$")
        END = re.compile(r"^\s*# MNX-EJECT-END\s*$")
        LINE = re.compile(
            r"^(?P<body>.*?)\s*# MNX-EJECT-LINE owner=(?P<owner>[a-z0-9][a-z0-9.-]*)['\"]?\s*$"
        )
        SHEBANG = re.compile(r"^\s*# MNX-EJECT-SHEBANG owner=(?P<owner>[a-z0-9][a-z0-9.-]*)\s*$")
        OWNER = re.compile(r"^[a-z0-9][a-z0-9.-]*$")
        PROFILE = re.compile(r"^[a-z][a-z0-9-]*$")
        CONTRACT_SCHEMA = "mnx.source-ownership.v2"
        RECEIPT_SCHEMA = "mnx.ejection-receipt.v2"
        ACTIONS = {"drop", "keep-marked", "keep-clean"}
        DEFAULT_CONTRACT = pathlib.Path(__file__).resolve().parent.parent / "foundation/ownership.json"


        class Refusal(RuntimeError):
            pass


        def require(condition: bool, message: str) -> None:
            if not condition:
                raise Refusal(message)


        def digest(raw: bytes) -> str:
            return hashlib.sha256(raw).hexdigest()


        def canonical_json(value: Any) -> str:
            return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False)


        def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
            result: dict[str, Any] = {}
            for key, value in pairs:
                require(key not in result, f"duplicate JSON key: {key}")
                result[key] = value
            return result


        def exact(value: dict[str, Any], keys: set[str], label: str) -> None:
            require(set(value) == keys, f"{label} keys differ")


        def stable_regular(path: pathlib.Path, label: str, maximum: int) -> tuple[pathlib.Path, bytes, int]:
            try:
                first = path.lstat()
            except FileNotFoundError as error:
                raise Refusal(f"{label} is absent: {path}") from error
            if stat.S_ISLNK(first.st_mode):
                resolved = path.resolve(strict=True)
                require(str(resolved).startswith("/nix/store/"), f"mutable {label} symlinks are forbidden")
            else:
                resolved = path.resolve(strict=True)
            before = resolved.stat()
            require(stat.S_ISREG(before.st_mode), f"{label} must resolve to a regular file")
            require(0 < before.st_size <= maximum, f"{label} exceeds its byte contract")
            raw = resolved.read_bytes()
            after = resolved.stat()
            require(
                (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
                == (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns),
                f"{label} changed while being read",
            )
            return resolved, raw, stat.S_IMODE(before.st_mode)


        def strict_json(raw: bytes, label: str) -> Any:
            try:
                return json.loads(
                    raw.decode("utf-8", errors="strict"),
                    object_pairs_hook=unique_object,
                    parse_constant=lambda value: (_ for _ in ()).throw(
                        Refusal(f"non-finite JSON number in {label}: {value}")
                    ),
                )
            except (UnicodeError, json.JSONDecodeError) as error:
                raise Refusal(f"{label} is not strict JSON: {error}") from error


        def load_contract(path: pathlib.Path) -> tuple[dict[str, Any], str]:
            _, raw, _ = stable_regular(path, "ownership contract", 256 * 1024)
            value = strict_json(raw, "ownership contract")
            require(isinstance(value, dict), "ownership contract must be an object")
            exact(value, {"schema", "owner_classes", "profiles", "sources", "laws"}, "ownership contract")
            require(value["schema"] == CONTRACT_SCHEMA, "ownership contract schema differs")
            classes = value["owner_classes"]
            require(isinstance(classes, dict) and classes, "owner classes must be a nonempty object")
            for owner, row in classes.items():
                require(isinstance(owner, str) and OWNER.fullmatch(owner) is not None, "invalid owner name")
                require(isinstance(row, dict), f"owner class {owner} must be an object")
                exact(row, {"class", "description"}, f"owner class {owner}")
                require(isinstance(row["class"], str) and PROFILE.fullmatch(row["class"]) is not None,
                        f"owner {owner} has an invalid class")
                require(isinstance(row["description"], str) and 0 < len(row["description"]) <= 160,
                        f"owner {owner} description differs")
            profiles = value["profiles"]
            require(isinstance(profiles, dict) and {"plain-nixos", "foundation"} <= set(profiles),
                    "plain-nixos and foundation profiles are required")
            known_classes = {row["class"] for row in classes.values()}
            for name, row in profiles.items():
                require(isinstance(name, str) and PROFILE.fullmatch(name) is not None, "invalid profile name")
                require(isinstance(row, dict), f"profile {name} must be an object")
                exact(row, {"description", "class_actions", "behavior", "required_after", "forbidden_after"},
                      f"profile {name}")
                require(isinstance(row["class_actions"], dict)
                        and set(row["class_actions"]) == known_classes,
                        f"profile {name} does not cover every owner class")
                require(all(action in ACTIONS for action in row["class_actions"].values()),
                        f"profile {name} has an invalid action")
                behavior = row["behavior"]
                require(isinstance(behavior, dict), f"profile {name} behavior must be an object")
                exact(behavior, {"comparison", "preserve_classes", "discard_classes"},
                      f"profile {name} behavior")
                preserved = behavior["preserve_classes"]
                discarded = behavior["discard_classes"]
                require(
                    isinstance(preserved, list) and isinstance(discarded, list)
                    and len(preserved) == len(set(preserved))
                    and len(discarded) == len(set(discarded))
                    and set(preserved).isdisjoint(discarded)
                    and set(preserved) | set(discarded) == known_classes,
                    f"profile {name} behavior does not dispose every owner class",
                )
                require(all(row["class_actions"][item] != "drop" for item in preserved)
                        and all(row["class_actions"][item] == "drop" for item in discarded),
                        f"profile {name} behavior contradicts class actions")
                require(isinstance(behavior["comparison"], str)
                        and PROFILE.fullmatch(behavior["comparison"]) is not None,
                        f"profile {name} behavior comparison differs")
                for field in ("required_after", "forbidden_after"):
                    require(isinstance(row[field], list)
                            and len(row[field]) == len(set(row[field]))
                            and all(isinstance(item, str) and 0 < len(item) <= 160 for item in row[field]),
                            f"profile {name} {field} differs")
            sources = value["sources"]
            require(isinstance(sources, dict) and sources, "source inventory must be a nonempty object")
            for name, row in sources.items():
                require(isinstance(name, str) and name and not name.startswith("/"), "invalid source id")
                require(isinstance(row, dict), f"source {name} must be an object")
                exact(row, {"plain_owner", "declared_owners"}, f"source {name}")
                require(isinstance(row["plain_owner"], str) and OWNER.fullmatch(row["plain_owner"]),
                        f"source {name} plain owner differs")
                require(isinstance(row["declared_owners"], list) and row["declared_owners"]
                        and len(row["declared_owners"]) == len(set(row["declared_owners"]))
                        and all(owner in classes for owner in row["declared_owners"]),
                        f"source {name} owner inventory differs")
            require(isinstance(value["laws"], list) and len(value["laws"]) >= 8
                    and len(value["laws"]) == len(set(value["laws"]))
                    and all(isinstance(item, str) and PROFILE.fullmatch(item) for item in value["laws"]),
                    "ownership laws differ")
            return value, digest(raw)


        def discover(raw: bytes) -> set[str]:
            try:
                text = raw.decode("utf-8", errors="strict")
            except UnicodeError as error:
                raise Refusal(f"source is not UTF-8: {error}") from error
            owners: set[str] = set()
            depth = 0
            for number, line in enumerate(text.splitlines(), 1):
                if match := SHEBANG.match(line):
                    owners.add(match.group("owner"))
                if match := BEGIN.match(line):
                    require(depth == 0, f"nested eject span at line {number}")
                    depth = 1
                    owners.add(match.group("owner"))
                    continue
                if END.match(line):
                    require(depth == 1, f"unmatched eject end at line {number}")
                    depth = 0
                    continue
                if match := LINE.match(line):
                    require(depth == 0, f"line-owned declaration inside span at line {number}")
                    owners.add(match.group("owner"))
            require(depth == 0, "unterminated eject span")
            require(owners, "source declares no eject ownership")
            return owners


        def source_contract(contract: dict[str, Any], owners: set[str]) -> tuple[str, str]:
            matches = [name for name, row in contract["sources"].items()
                       if set(row["declared_owners"]) == owners]
            require(len(matches) == 1,
                    f"source owner inventory is unrecognized or ambiguous: {sorted(owners)}")
            source_id = matches[0]
            return source_id, contract["sources"][source_id]["plain_owner"]


        def profile_actions(contract: dict[str, Any], profile: str, owners: set[str]) -> dict[str, str]:
            require(profile in contract["profiles"], f"unknown ejection profile: {profile}")
            classes = contract["owner_classes"]
            require(owners <= set(classes), f"source contains undeclared owners: {sorted(owners - set(classes))}")
            actions = contract["profiles"][profile]["class_actions"]
            return {owner: actions[classes[owner]["class"]] for owner in owners}


        def project(raw: bytes, actions: dict[str, str]) -> tuple[bytes, list[str], list[str]]:
            text = raw.decode("utf-8", errors="strict")
            output: list[str] = []
            depth = 0
            active_action = ""
            removed: set[str] = set()
            retained: set[str] = set()
            for number, line in enumerate(text.splitlines(keepends=True), 1):
                if match := SHEBANG.match(line):
                    require(depth == 0 and len(output) == 1 and output[0].startswith("#!")
                            and "#@MNX-BASH" in output[0],
                            f"MNX polyglot shebang marker has no matching first line at {number}")
                    owner = match.group("owner")
                    action = actions.get(owner)
                    require(action in ACTIONS, f"owner action is unavailable: {owner}")
                    if action == "drop":
                        output.pop()
                        removed.add(owner)
                    else:
                        retained.add(owner)
                        if action == "keep-marked":
                            output.append(line)
                    continue
                if match := BEGIN.match(line):
                    require(depth == 0, f"nested eject span at line {number}")
                    owner = match.group("owner")
                    active_action = actions.get(owner, "")
                    require(active_action in ACTIONS, f"owner action is unavailable: {owner}")
                    depth = 1
                    (removed if active_action == "drop" else retained).add(owner)
                    if active_action == "keep-marked":
                        output.append(line)
                    continue
                if END.match(line):
                    require(depth == 1, f"unmatched eject end at line {number}")
                    if active_action == "keep-marked":
                        output.append(line)
                    depth = 0
                    active_action = ""
                    continue
                if match := LINE.match(line):
                    require(depth == 0, f"line-owned declaration inside span at line {number}")
                    owner = match.group("owner")
                    action = actions.get(owner)
                    require(action in ACTIONS, f"owner action is unavailable: {owner}")
                    if action == "drop":
                        removed.add(owner)
                    elif action == "keep-marked":
                        retained.add(owner)
                        output.append(line)
                    else:
                        retained.add(owner)
                        body = match.group("body").rstrip()
                        require(body, f"keep-clean line owner has no retained body at line {number}")
                        output.append(body + ("\n" if line.endswith("\n") else ""))
                    continue
                if depth == 0 or active_action != "drop":
                    output.append(line)
            require(depth == 0, "unterminated eject span")
            return "".join(output).encode("utf-8"), sorted(removed), sorted(retained)


        def parse_nix(path: pathlib.Path) -> None:
            completed = subprocess.run(
                ["nix-instantiate", "--store", "dummy://", "--parse", path],
                check=False, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
            )
            require(completed.returncode == 0,
                    f"ejected Nix does not parse: {completed.stderr.strip()}")


        def validate_output(raw: bytes, profile: dict[str, Any], extra_forbidden: list[str]) -> None:
            text = raw.decode("utf-8", errors="strict")
            for token in profile["required_after"]:
                require(token in text, f"projected source lacks required token: {token}")
            lowered = text.lower()
            retained = [token for token in [*profile["forbidden_after"], *extra_forbidden]
                        if token.lower() in lowered]
            require(not retained, f"projected source retains forbidden language: {', '.join(retained)}")


        def publish(output: pathlib.Path, raw: bytes, mode: int, force: bool) -> None:
            output = output.absolute()
            output.parent.mkdir(parents=True, exist_ok=True)
            require(output.parent.is_dir() and not output.parent.is_symlink(), "output parent is unsafe")
            if output.exists() or output.is_symlink():
                require(force, f"output exists; use --force: {output}")
                require(not output.is_dir(), "output is a directory")
            descriptor, name = tempfile.mkstemp(prefix=f".{output.name}.mnx-eject.", dir=output.parent)
            temporary = pathlib.Path(name)
            try:
                with os.fdopen(descriptor, "wb") as stream:
                    stream.write(raw)
                    stream.flush()
                    os.fchmod(stream.fileno(), mode)
                    os.fsync(stream.fileno())
                parse_nix(temporary)
                if force:
                    os.replace(temporary, output)
                else:
                    try:
                        os.link(temporary, output)
                    except FileExistsError as error:
                        raise Refusal("output appeared during publication") from error
                    temporary.unlink()
                directory = os.open(output.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
                try:
                    os.fsync(directory)
                finally:
                    os.close(directory)
            finally:
                temporary.unlink(missing_ok=True)


        def main() -> int:
            parser = argparse.ArgumentParser(prog="mnx-eject")
            parser.add_argument("source", type=pathlib.Path)
            parser.add_argument("output", type=pathlib.Path)
            parser.add_argument("--profile", default="plain-nixos")
            parser.add_argument("--contract", type=pathlib.Path)
            parser.add_argument("--force", action="store_true")
            parser.add_argument("--forbid", action="append", default=[])
            parser.add_argument("--json", action="store_true")
            args = parser.parse_args()

            try:
                source, source_raw, mode = stable_regular(args.source, "source", 64 * 1024 * 1024)
                output = args.output.absolute()
                require(source != output.resolve(strict=False), "source overwrite is forbidden")
                owners = discover(source_raw)
                contract_path = args.contract
                if contract_path is None and DEFAULT_CONTRACT.is_file() and not DEFAULT_CONTRACT.is_symlink():
                    contract_path = DEFAULT_CONTRACT
                if contract_path is None:
                    require(args.profile == "plain-nixos", "a contract is required for Foundation ejection")
                    actions = {owner: "drop" for owner in owners}
                    profile = {
                        "required_after": [], "forbidden_after": [],
                        "class_actions": {"unbound": "drop"},
                        "behavior": {
                            "comparison": "legacy-text-removal",
                            "preserve_classes": [], "discard_classes": ["unbound"],
                        },
                    }
                    source_id = "unbound-legacy-source"
                    plain_owner = "unbound"
                    contract_sha256 = "none"
                else:
                    contract, contract_sha256 = load_contract(contract_path)
                    source_id, plain_owner = source_contract(contract, owners)
                    actions = profile_actions(contract, args.profile, owners)
                    profile = contract["profiles"][args.profile]
                projected, removed, retained = project(source_raw, actions)
                validate_output(projected, profile, args.forbid)
                publish(output, projected, mode, args.force)
                result = {
                    "schema": RECEIPT_SCHEMA,
                    "status": "pass",
                    "profile": args.profile,
                    "source_contract": source_id,
                    "ownership_contract_sha256": contract_sha256,
                    "plain_owner": plain_owner,
                    "source_sha256": digest(source_raw),
                    "source_bytes": len(source_raw),
                    "output": str(output),
                    "output_sha256": digest(projected),
                    "output_bytes": len(projected),
                    "removed_owners": removed,
                    "retained_owners": retained,
                    "owner_actions": dict(sorted(actions.items())),
                    "class_actions": dict(sorted(profile["class_actions"].items())),
                    "source_present_classes": sorted({
                        contract["owner_classes"][owner]["class"] for owner in owners
                    }) if contract_path is not None else ["unbound"],
                    "source_absent_classes": sorted(
                        set(profile["class_actions"]) - {
                            contract["owner_classes"][owner]["class"] for owner in owners
                        }
                    ) if contract_path is not None else [],
                    "abstraction_disposition_total": True,
                    "behavior_claim": profile["behavior"],
                    "nix_parse": "pass",
                    "source_executed": False,
                    "network_used": False,
                    "host_acceptance": False,
                    "operator_acceptance": False,
                }
                if args.json:
                    print(canonical_json(result))
                else:
                    for key in (
                        "profile",
                        "source_contract",
                        "ownership_contract_sha256",
                        "plain_owner",
                        "source_sha256",
                        "output",
                        "output_sha256",
                    ):
                        print(f"{key}={result[key]}")
                    print("owner_actions=" + ",".join(f"{owner}:{action}" for owner, action in sorted(actions.items())))
                    print(f"removed_owners={','.join(removed) if removed else 'none'}")
                    print(f"retained_owners={','.join(retained) if retained else 'none'}")
                    print("nix_parse=pass")
                    print("MNX_EJECT=PASS" if args.profile.startswith("plain-") else "MNX_FOUNDATION_EJECT=PASS")
                return 0
            except (OSError, UnicodeError, ValueError, Refusal) as error:
                print(f"MNX_EJECT_REFUSED: {error}", file=sys.stderr)
                return 1


        if __name__ == "__main__":
            raise SystemExit(main())
      '';
      # MNX-EJECTION-EMBED-END id=eject-engine
    };
  };

