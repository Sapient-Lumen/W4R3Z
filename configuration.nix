    source = pkgs.writeTextFile {
      name = "mnx-measurement-accept";
      executable = true;
      # MNX-MEASUREMENT-EMBED-BEGIN id=accept source_sha256=ff962f4d442c154ccb23a44d20171222bd080af4f0e34ed4431c858073f8aebe
      text = ''
        #!/usr/bin/env python3
        """Explicit two-phase acceptance for measurement comparison baselines."""
        
        from __future__ import annotations
        
        import argparse
        import copy
        import hashlib
        import json
        import os
        import pathlib
        import re
        import shutil
        import stat
        import subprocess
        import sys
        import tempfile
        from typing import Any
        
        
        ROOT = pathlib.Path(__file__).resolve().parent.parent
        DEFAULT_KERNEL = ROOT / "tools/mnx-measurement"
        DEFAULT_REGISTRY = ROOT / "foundation/measurement-registry.json"
        SHA256 = re.compile(r"^[0-9a-f]{64}$")
        SAFE = re.compile(r"^[A-Za-z0-9._:@+,-]{1,128}$")
        RECORD = re.compile(r"^accepted-[0-9a-f]{12}-[0-9a-f]{12}$")
        INTENT = "accept-this-exact-snapshot-as-a-comparison-baseline-only"
        ASSERTION = "I-explicitly-authorize-this-exact-proposal-and-no-other"
        REQUEST_FIELDS = {
            "schema", "label", "snapshot_content_sha256", "scope", "replace_current",
            "requested_at_epoch", "operator_intent",
        }
        AUTHORIZATION_FIELDS = {
            "schema", "proposal_content_sha256", "decision", "assertion",
            "authorized_at_epoch", "operator_claim",
        }
        PROPOSAL_FIELDS = {
            "schema", "status", "registry_sha256", "snapshot_content_sha256",
            "snapshot_observed_at_epoch", "normalized_statuses", "request_sha256",
            "request", "kernel_sha256", "proposed_at_epoch", "expires_at_epoch",
            "authority", "content_sha256",
        }
        ACCEPTANCE_FIELDS = {
            "schema", "status", "acceptance_id", "label", "registry_sha256",
            "snapshot_content_sha256", "snapshot_file_sha256", "proposal_content_sha256",
            "authorization_sha256", "request_sha256", "kernel_sha256",
            "normalized_statuses", "accepted_at_epoch", "operator_claim",
            "authority", "limitations", "content_sha256",
        }
        CURRENT_FIELDS = {
            "schema", "acceptance_id", "acceptance_content_sha256",
            "record_directory", "updated_at_epoch",
        }
        
        
        class Refusal(RuntimeError):
            pass
        
        
        def require(condition: bool, message: str) -> None:
            if not condition:
                raise Refusal(message)
        
        
        def canonical_bytes(value: Any) -> bytes:
            return (json.dumps(
                value, sort_keys=True, separators=(",", ":"), ensure_ascii=False,
                allow_nan=False,
            ) + "\n").encode("utf-8")
        
        
        def digest(raw: bytes) -> str:
            return hashlib.sha256(raw).hexdigest()
        
        
        def strict_object(raw: bytes, label: str) -> dict[str, Any]:
            def pairs(rows: list[tuple[str, Any]]) -> dict[str, Any]:
                result: dict[str, Any] = {}
                for key, value in rows:
                    if key in result:
                        raise Refusal(f"{label} contains duplicate JSON key: {key}")
                    result[key] = value
                return result
        
            def constant(value: str) -> Any:
                raise Refusal(f"{label} contains non-finite JSON number: {value}")
        
            try:
                value = json.loads(
                    raw.decode("utf-8", errors="strict"), object_pairs_hook=pairs,
                    parse_constant=constant,
                )
            except (UnicodeDecodeError, json.JSONDecodeError) as error:
                raise Refusal(f"{label} is not strict JSON: {error}") from error
            require(isinstance(value, dict), f"{label} must be a JSON object")
            return value
        
        
        def stable_regular(path: pathlib.Path, maximum: int, label: str,
                           *, follow_final_link: bool = False) -> bytes:
            selected = path.resolve(strict=True) if follow_final_link else path
            flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
            descriptor = os.open(selected, flags)
            try:
                before = os.fstat(descriptor)
                require(stat.S_ISREG(before.st_mode), f"{label} must be a regular file")
                require(before.st_size <= maximum, f"{label} exceeds {maximum} bytes")
                raw = bytearray()
                while len(raw) <= maximum:
                    block = os.read(descriptor, min(65536, maximum + 1 - len(raw)))
                    if not block:
                        break
                    raw.extend(block)
                after = os.fstat(descriptor)
                require(len(raw) <= maximum and len(raw) == before.st_size,
                        f"{label} size changed while being read")
                require(
                    (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) ==
                    (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns),
                    f"{label} changed while being read",
                )
                return bytes(raw)
            finally:
                os.close(descriptor)
        
        
        def load_object(path: pathlib.Path, maximum: int, label: str) -> tuple[dict[str, Any], bytes]:
            raw = stable_regular(path, maximum, label)
            return strict_object(raw, label), raw
        
        
        def exact_keys(value: dict[str, Any], keys: set[str], label: str) -> None:
            require(set(value) == keys,
                    f"{label} fields differ: missing={sorted(keys - set(value))} "
                    f"extra={sorted(set(value) - keys)}")
        
        
        def bounded_integer(value: Any, label: str) -> int:
            require(isinstance(value, int) and not isinstance(value, bool) and
                    0 <= value <= 2**63 - 1, f"invalid {label}")
            return value
        
        
        def safe(value: Any, label: str) -> str:
            require(isinstance(value, str) and SAFE.fullmatch(value) is not None,
                    f"invalid {label}")
            return value
        
        
        def sha(value: Any, label: str) -> str:
            require(isinstance(value, str) and SHA256.fullmatch(value) is not None,
                    f"invalid {label}")
            return value
        
        
        def seal(value: dict[str, Any]) -> dict[str, Any]:
            result = copy.deepcopy(value)
            result["content_sha256"] = digest(canonical_bytes(value))
            return result
        
        
        def validate_seal(value: dict[str, Any], label: str) -> None:
            identity = sha(value.get("content_sha256"), f"{label} content sha256")
            unsealed = copy.deepcopy(value)
            del unsealed["content_sha256"]
            require(digest(canonical_bytes(unsealed)) == identity,
                    f"{label} content digest mismatch")
        
        
        def kernel_verification(kernel: pathlib.Path, registry: pathlib.Path,
                                snapshot: pathlib.Path) -> tuple[dict[str, Any], str]:
            kernel_raw = stable_regular(kernel, 65536, "measurement kernel", follow_final_link=True)
            stable_regular(registry, 65536, "measurement registry", follow_final_link=True)
            completed = subprocess.run(
                [sys.executable, "-I", "-B", str(kernel.resolve(strict=True)),
                 "--registry", str(registry.resolve(strict=True)),
                 "verify", "snapshot", str(snapshot)],
                check=False, capture_output=True, timeout=10,
            )
            require(len(completed.stdout) <= 32768 and len(completed.stderr) <= 8192,
                    "measurement kernel verification output exceeded its bound")
            require(completed.returncode == 0,
                    "measurement kernel refused snapshot: " +
                    completed.stderr.decode("utf-8", errors="replace")[:1024])
            value = strict_object(completed.stdout, "measurement verification")
            exact_keys(value, {
                "schema", "status", "kind", "registry_sha256", "content_sha256",
                "question_ids", "observed_at_epoch", "normalized_statuses", "authority",
            }, "measurement verification")
            require(value["schema"] == "mnx.measurement-verification.v1" and
                    value["status"] == "pass" and value["kind"] == "snapshot",
                    "snapshot verification summary is invalid")
            require(value["authority"] == {
                "mode": "verification-only", "mutation": "none", "network": "none",
                "accepted_baseline": False, "acceptance_inferred": False,
                "promotion": False,
            }, "measurement verifier enlarged authority")
            return value, digest(kernel_raw)
        
        
        def validate_request(value: dict[str, Any], verification: dict[str, Any], now: int) -> None:
            exact_keys(value, REQUEST_FIELDS, "baseline request")
            require(value["schema"] == "mnx.measurement-baseline-request.v1",
                    "unsupported baseline request")
            safe(value["label"], "baseline label")
            require(value["scope"] == "measurement-comparison-only" and
                    isinstance(value["replace_current"], bool) and
                    value["operator_intent"] == INTENT,
                    "baseline request lacks exact comparison-only intent")
            require(sha(value["snapshot_content_sha256"], "requested snapshot sha256") ==
                    verification["content_sha256"], "request names a different snapshot")
            requested = bounded_integer(value["requested_at_epoch"], "request epoch")
            require(verification["observed_at_epoch"] <= requested <= now + 300,
                    "request epoch is outside snapshot/current time bounds")
            require(now - requested <= 600, "baseline request expired")
        
        
        def make_request(snapshot: pathlib.Path, label: str, replace_current: bool,
                         kernel: pathlib.Path, registry: pathlib.Path,
                         now: int) -> dict[str, Any]:
            verification, _ = kernel_verification(kernel, registry, snapshot)
            require(now - verification["observed_at_epoch"] <= 300 and
                    verification["observed_at_epoch"] <= now + 300,
                    "only a current snapshot may enter an acceptance request")
            result = {
                "schema": "mnx.measurement-baseline-request.v1",
                "label": safe(label, "baseline label"),
                "snapshot_content_sha256": verification["content_sha256"],
                "scope": "measurement-comparison-only",
                "replace_current": replace_current,
                "requested_at_epoch": now,
                "operator_intent": INTENT,
            }
            validate_request(result, verification, now)
            return result
        
        
        def proposal(snapshot: pathlib.Path, request_path: pathlib.Path, kernel: pathlib.Path,
                     registry: pathlib.Path, now: int) -> dict[str, Any]:
            verification, kernel_sha = kernel_verification(kernel, registry, snapshot)
            request, _ = load_object(request_path, 8192, "baseline request")
            validate_request(request, verification, now)
            require(now - verification["observed_at_epoch"] <= 300,
                    "only a current snapshot may be proposed as the baseline")
            request_sha = digest(canonical_bytes(request))
            return seal({
                "schema": "mnx.measurement-baseline-proposal.v1",
                "status": "awaiting-explicit-authorization",
                "registry_sha256": verification["registry_sha256"],
                "snapshot_content_sha256": verification["content_sha256"],
                "snapshot_observed_at_epoch": verification["observed_at_epoch"],
                "normalized_statuses": verification["normalized_statuses"],
                "request_sha256": request_sha, "request": request,
                "kernel_sha256": kernel_sha, "proposed_at_epoch": now,
                "expires_at_epoch": now + 600,
                "authority": {
                    "mode": "proposal-only", "mutation": "none", "network": "none",
                    "accepted_baseline": False, "acceptance_inferred": False,
                    "candidate_accepted": False, "promotion": False, "publication": False,
                },
            })
        
        
        def validate_proposal(value: dict[str, Any], verification: dict[str, Any],
                              kernel_sha: str, now: int) -> None:
            exact_keys(value, PROPOSAL_FIELDS, "baseline proposal")
            validate_seal(value, "baseline proposal")
            require(value["schema"] == "mnx.measurement-baseline-proposal.v1" and
                    value["status"] == "awaiting-explicit-authorization",
                    "unsupported baseline proposal")
            require(value["registry_sha256"] == verification["registry_sha256"] and
                    value["snapshot_content_sha256"] == verification["content_sha256"] and
                    value["snapshot_observed_at_epoch"] == verification["observed_at_epoch"] and
                    value["normalized_statuses"] == verification["normalized_statuses"] and
                    value["kernel_sha256"] == kernel_sha,
                    "proposal differs from fresh snapshot verification")
            request = value["request"]
            require(isinstance(request, dict), "proposal request is absent")
            validate_request(request, verification, now)
            require(value["request_sha256"] == digest(canonical_bytes(request)),
                    "proposal request digest mismatch")
            proposed = bounded_integer(value["proposed_at_epoch"], "proposal epoch")
            expires = bounded_integer(value["expires_at_epoch"], "proposal expiry")
            require(expires == proposed + 600 and proposed <= now <= expires,
                    "proposal is not current")
            require(value["authority"] == {
                "mode": "proposal-only", "mutation": "none", "network": "none",
                "accepted_baseline": False, "acceptance_inferred": False,
                "candidate_accepted": False, "promotion": False, "publication": False,
            }, "proposal enlarged authority")
        
        
        def validate_authorization(value: dict[str, Any], proposal_value: dict[str, Any],
                                   now: int) -> None:
            exact_keys(value, AUTHORIZATION_FIELDS, "baseline authorization")
            require(value["schema"] == "mnx.measurement-baseline-authorization.v1" and
                    value["decision"] == "accept" and value["assertion"] == ASSERTION,
                    "authorization lacks the exact affirmative decision")
            require(sha(value["proposal_content_sha256"], "authorized proposal sha256") ==
                    proposal_value["content_sha256"],
                    "authorization names a different proposal")
            safe(value["operator_claim"], "operator claim")
            authorized = bounded_integer(value["authorized_at_epoch"], "authorization epoch")
            require(proposal_value["proposed_at_epoch"] <= authorized <= now + 300 and
                    authorized <= proposal_value["expires_at_epoch"],
                    "authorization epoch is outside proposal/current time bounds")
        
        
        def make_authorization(snapshot: pathlib.Path, proposal_path: pathlib.Path,
                               operator_claim: str, kernel: pathlib.Path,
                               registry: pathlib.Path, now: int) -> dict[str, Any]:
            verification, kernel_sha = kernel_verification(kernel, registry, snapshot)
            proposal_value, _ = load_object(proposal_path, 32768, "baseline proposal")
            validate_proposal(proposal_value, verification, kernel_sha, now)
            result = {
                "schema": "mnx.measurement-baseline-authorization.v1",
                "proposal_content_sha256": proposal_value["content_sha256"],
                "decision": "accept", "assertion": ASSERTION,
                "authorized_at_epoch": now,
                "operator_claim": safe(operator_claim, "operator claim"),
            }
            validate_authorization(result, proposal_value, now)
            return result
        
        
        def secure_store(path: pathlib.Path) -> None:
            require(path.is_absolute(), "baseline store must be absolute")
            info = os.lstat(path)
            require(stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode),
                    "baseline store must be a non-link directory")
            require(info.st_uid == os.geteuid(), "baseline store must be owned by the caller")
            require(stat.S_IMODE(info.st_mode) == 0o700, "baseline store mode must be 0700")
        
        
        def write_exclusive(path: pathlib.Path, raw: bytes, mode: int = 0o600) -> None:
            descriptor = os.open(
                path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0), mode,
            )
            try:
                view = memoryview(raw)
                while view:
                    written = os.write(descriptor, view)
                    view = view[written:]
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
        
        
        def validate_current(value: dict[str, Any]) -> None:
            exact_keys(value, CURRENT_FIELDS, "current baseline pointer")
            require(value["schema"] == "mnx.measurement-baseline-current.v1",
                    "unsupported current baseline pointer")
            safe(value["acceptance_id"], "current acceptance id")
            require(RECORD.fullmatch(value["record_directory"]) is not None and
                    value["record_directory"] == value["acceptance_id"],
                    "current baseline record identity is malformed")
            sha(value["acceptance_content_sha256"], "current acceptance sha256")
            bounded_integer(value["updated_at_epoch"], "current update epoch")
        
        
        def validate_acceptance(value: dict[str, Any]) -> None:
            exact_keys(value, ACCEPTANCE_FIELDS, "baseline acceptance")
            validate_seal(value, "baseline acceptance")
            require(value["schema"] == "mnx.measurement-baseline-acceptance.v1" and
                    value["status"] == "accepted" and
                    isinstance(value["normalized_statuses"], dict),
                    "unsupported baseline acceptance")
            safe(value["acceptance_id"], "acceptance id")
            safe(value["label"], "acceptance label")
            safe(value["operator_claim"], "acceptance operator claim")
            for field in (
                "registry_sha256", "snapshot_content_sha256", "snapshot_file_sha256",
                "proposal_content_sha256", "authorization_sha256", "request_sha256",
                "kernel_sha256",
            ):
                sha(value[field], field)
            bounded_integer(value["accepted_at_epoch"], "acceptance epoch")
            require(value["authority"] == {
                "mode": "comparison-baseline-selection", "artifact_mutation": "bounded-store-only",
                "network": "none", "accepted_baseline": True,
                "observation_status_required_to_be_pass": False,
                "candidate_accepted": False, "host_validated": False,
                "promotion": False, "publication": False,
            }, "acceptance authority drifted")
            require(value["limitations"] == [
                "operator-claim-is-recorded-not-authenticated",
                "self-seals-prove-integrity-not-authorship",
                "measurement-baseline-is-not-candidate-or-host-acceptance",
                "failed-or-unknown-observations-may-be-explicitly-accepted-as-comparison-points",
            ], "acceptance limitations drifted")
        
        
        def verify_record(record: pathlib.Path, kernel: pathlib.Path,
                          registry: pathlib.Path) -> dict[str, Any]:
            require(record.is_dir() and not record.is_symlink() and
                    RECORD.fullmatch(record.name) is not None,
                    "baseline record directory is invalid")
            require(stat.S_IMODE(os.lstat(record).st_mode) == 0o700,
                    "baseline record directory mode must be 0700")
            expected = {
                "snapshot.json", "request.json", "proposal.json", "authorization.json",
                "acceptance.json", "manifest.sha256",
            }
            entries = {item.name for item in record.iterdir()}
            require(entries == expected, "baseline record shape differs")
            for item in record.iterdir():
                info = os.lstat(item)
                require(stat.S_ISREG(info.st_mode) and not stat.S_ISLNK(info.st_mode) and
                        stat.S_IMODE(info.st_mode) == 0o600,
                        f"baseline record artifact is insecure: {item.name}")
            manifest_raw = stable_regular(record / "manifest.sha256", 8192, "baseline manifest")
            manifest: dict[str, str] = {}
            for line in manifest_raw.decode("ascii", errors="strict").splitlines():
                match = re.fullmatch(r"([0-9a-f]{64})  ([a-z-]+\.json)", line)
                require(match is not None, "baseline manifest row is malformed")
                require(match.group(2) not in manifest, "baseline manifest has duplicate row")
                manifest[match.group(2)] = match.group(1)
            require(set(manifest) == expected - {"manifest.sha256"},
                    "baseline manifest inventory differs")
            for name, identity in manifest.items():
                require(digest(stable_regular(record / name, 65536, name)) == identity,
                        f"baseline manifest digest differs: {name}")
            verification, kernel_sha = kernel_verification(kernel, registry, record / "snapshot.json")
            request, _ = load_object(record / "request.json", 8192, "retained request")
            proposal_value, _ = load_object(record / "proposal.json", 32768, "retained proposal")
            authorization, _ = load_object(record / "authorization.json", 8192,
                                           "retained authorization")
            acceptance, _ = load_object(record / "acceptance.json", 32768,
                                        "retained acceptance")
            validate_acceptance(acceptance)
            validate_proposal(proposal_value, verification, kernel_sha,
                              proposal_value["proposed_at_epoch"])
            validate_authorization(authorization, proposal_value,
                                   authorization["authorized_at_epoch"])
            require(request == proposal_value["request"] and
                    acceptance["acceptance_id"] == record.name and
                    acceptance["label"] == request["label"] and
                    acceptance["registry_sha256"] == verification["registry_sha256"] and
                    acceptance["snapshot_content_sha256"] == verification["content_sha256"] and
                    acceptance["snapshot_file_sha256"] == manifest["snapshot.json"] and
                    acceptance["proposal_content_sha256"] == proposal_value["content_sha256"] and
                    acceptance["authorization_sha256"] == digest(canonical_bytes(authorization)) and
                    acceptance["request_sha256"] == digest(canonical_bytes(request)) and
                    acceptance["kernel_sha256"] == kernel_sha and
                    acceptance["normalized_statuses"] == verification["normalized_statuses"] and
                    acceptance["operator_claim"] == authorization["operator_claim"],
                    "baseline acceptance bindings differ")
            return acceptance
        
        
        def update_current(store: pathlib.Path, acceptance: dict[str, Any], now: int) -> None:
            value = {
                "schema": "mnx.measurement-baseline-current.v1",
                "acceptance_id": acceptance["acceptance_id"],
                "acceptance_content_sha256": acceptance["content_sha256"],
                "record_directory": acceptance["acceptance_id"],
                "updated_at_epoch": now,
            }
            descriptor, temporary_name = tempfile.mkstemp(prefix=".current.", dir=store)
            temporary = pathlib.Path(temporary_name)
            try:
                os.fchmod(descriptor, 0o600)
                raw = canonical_bytes(value)
                view = memoryview(raw)
                while view:
                    written = os.write(descriptor, view)
                    view = view[written:]
                os.fsync(descriptor)
                os.close(descriptor)
                descriptor = -1
                os.replace(temporary, store / "current.json")
                directory = os.open(store, os.O_RDONLY | os.O_DIRECTORY)
                try:
                    os.fsync(directory)
                finally:
                    os.close(directory)
            finally:
                if descriptor >= 0:
                    os.close(descriptor)
                temporary.unlink(missing_ok=True)
        
        
        def commit(snapshot: pathlib.Path, proposal_path: pathlib.Path,
                   authorization_path: pathlib.Path, store: pathlib.Path,
                   kernel: pathlib.Path, registry: pathlib.Path, now: int) -> dict[str, Any]:
            secure_store(store)
            verification, kernel_sha = kernel_verification(kernel, registry, snapshot)
            proposal_value, _ = load_object(proposal_path, 32768, "baseline proposal")
            authorization, _ = load_object(authorization_path, 8192, "baseline authorization")
            validate_proposal(proposal_value, verification, kernel_sha, now)
            validate_authorization(authorization, proposal_value, now)
            request = proposal_value["request"]
            authorization_sha = digest(canonical_bytes(authorization))
            acceptance_id = (
                "accepted-" + verification["content_sha256"][:12] + "-" +
                authorization_sha[:12]
            )
            acceptance = seal({
                "schema": "mnx.measurement-baseline-acceptance.v1", "status": "accepted",
                "acceptance_id": acceptance_id, "label": request["label"],
                "registry_sha256": verification["registry_sha256"],
                "snapshot_content_sha256": verification["content_sha256"],
                "snapshot_file_sha256": digest(stable_regular(snapshot, 65536, "snapshot")),
                "proposal_content_sha256": proposal_value["content_sha256"],
                "authorization_sha256": authorization_sha,
                "request_sha256": proposal_value["request_sha256"],
                "kernel_sha256": kernel_sha,
                "normalized_statuses": verification["normalized_statuses"],
                # Acceptance is the durable projection of this exact authorization.
                # Binding its time to that event makes retries byte-idempotent instead
                # of allowing commit wall-clock time to perturb the same record ID.
                "accepted_at_epoch": authorization["authorized_at_epoch"],
                "operator_claim": authorization["operator_claim"],
                "authority": {
                    "mode": "comparison-baseline-selection",
                    "artifact_mutation": "bounded-store-only", "network": "none",
                    "accepted_baseline": True,
                    "observation_status_required_to_be_pass": False,
                    "candidate_accepted": False, "host_validated": False,
                    "promotion": False, "publication": False,
                },
                "limitations": [
                    "operator-claim-is-recorded-not-authenticated",
                    "self-seals-prove-integrity-not-authorship",
                    "measurement-baseline-is-not-candidate-or-host-acceptance",
                    "failed-or-unknown-observations-may-be-explicitly-accepted-as-comparison-points",
                ],
            })
            validate_acceptance(acceptance)
            lock = store / ".accept.lock"
            try:
                os.mkdir(lock, 0o700)
            except FileExistsError as error:
                raise Refusal("another baseline acceptance transaction owns the store") from error
            temporary: pathlib.Path | None = None
            try:
                records = [item for item in store.iterdir() if RECORD.fullmatch(item.name)]
                require(len(records) <= 64, "baseline record bound exceeded")
                current_path = store / "current.json"
                current: dict[str, Any] | None = None
                if current_path.exists() or current_path.is_symlink():
                    current, _ = load_object(current_path, 4096, "current baseline pointer")
                    validate_current(current)
                    if current["acceptance_id"] != acceptance_id:
                        require(request["replace_current"] is True,
                                "a current baseline exists and replacement was not authorized")
                record = store / acceptance_id
                if record.exists() or record.is_symlink():
                    existing = verify_record(record, kernel, registry)
                    require(existing == acceptance, "existing deterministic acceptance differs")
                else:
                    require(len(records) < 64, "baseline record bound reached")
                    temporary = pathlib.Path(tempfile.mkdtemp(prefix=".accept-", dir=store))
                    os.chmod(temporary, 0o700)
                    artifacts = {
                        "snapshot.json": stable_regular(snapshot, 65536, "snapshot"),
                        "request.json": canonical_bytes(request),
                        "proposal.json": canonical_bytes(proposal_value),
                        "authorization.json": canonical_bytes(authorization),
                        "acceptance.json": canonical_bytes(acceptance),
                    }
                    for name, raw in artifacts.items():
                        write_exclusive(temporary / name, raw)
                    manifest = "".join(
                        f"{digest(artifacts[name])}  {name}\n" for name in sorted(artifacts)
                    ).encode()
                    write_exclusive(temporary / "manifest.sha256", manifest)
                    directory = os.open(temporary, os.O_RDONLY | os.O_DIRECTORY)
                    try:
                        os.fsync(directory)
                    finally:
                        os.close(directory)
                    os.rename(temporary, record)
                    temporary = None
                    parent = os.open(store, os.O_RDONLY | os.O_DIRECTORY)
                    try:
                        os.fsync(parent)
                    finally:
                        os.close(parent)
                    require(verify_record(record, kernel, registry) == acceptance,
                            "new baseline record failed independent verification")
                # The current projection is part of the same durable authorization.
                # Use the authorization event time so retrying identical input cannot
                # perturb any accepted-store byte merely because wall time advanced.
                update_current(store, acceptance, acceptance["accepted_at_epoch"])
                current_value, _ = load_object(current_path, 4096, "current baseline pointer")
                validate_current(current_value)
                require(current_value["acceptance_id"] == acceptance_id and
                        current_value["acceptance_content_sha256"] == acceptance["content_sha256"],
                        "current baseline pointer did not commit exact acceptance")
            finally:
                if temporary is not None and temporary.exists():
                    shutil.rmtree(temporary)
                lock.rmdir()
            return acceptance
        
        
        def verify_store(store: pathlib.Path, kernel: pathlib.Path,
                         registry: pathlib.Path) -> dict[str, Any]:
            secure_store(store)
            entries = list(store.iterdir())
            require(all(item.name == "current.json" or RECORD.fullmatch(item.name)
                        for item in entries), "baseline store contains an unknown entry")
            records = sorted(item for item in entries if RECORD.fullmatch(item.name))
            require(len(records) <= 64, "baseline store record bound exceeded")
            accepted = [verify_record(record, kernel, registry) for record in records]
            current_path = store / "current.json"
            if not current_path.exists():
                require(not accepted, "baseline records exist without a current pointer")
                current = None
            else:
                current, _ = load_object(current_path, 4096, "current baseline pointer")
                validate_current(current)
                matches = [item for item in accepted if item["acceptance_id"] == current["acceptance_id"]]
                require(len(matches) == 1 and
                        matches[0]["content_sha256"] == current["acceptance_content_sha256"],
                        "current baseline pointer does not name one verified record")
            return {
                "schema": "mnx.measurement-baseline-store-verification.v1",
                "status": "pass", "record_count": len(accepted),
                "current_acceptance_id": None if current is None else current["acceptance_id"],
                "authority": {
                    "mode": "verification-only", "mutation": "none", "network": "none",
                    "acceptance_inferred": False, "promotion": False,
                },
            }
        
        
        def show(store: pathlib.Path, kernel: pathlib.Path, registry: pathlib.Path) -> dict[str, Any]:
            verified = verify_store(store, kernel, registry)
            require(verified["current_acceptance_id"] is not None,
                    "no measurement baseline has been accepted")
            return verify_record(store / verified["current_acceptance_id"], kernel, registry)
        
        
        def render(value: Any) -> None:
            json.dump(value, sys.stdout, sort_keys=True, indent=2, allow_nan=False)
            sys.stdout.write("\n")
        
        
        def main() -> int:
            parser = argparse.ArgumentParser(prog="mnx-measurement-accept")
            parser.add_argument("--kernel", type=pathlib.Path, default=DEFAULT_KERNEL)
            parser.add_argument("--registry", type=pathlib.Path, default=DEFAULT_REGISTRY)
            commands = parser.add_subparsers(dest="command", required=True)
            request_parser = commands.add_parser("request")
            request_parser.add_argument("snapshot", type=pathlib.Path)
            request_parser.add_argument("label")
            request_parser.add_argument("--replace-current", action="store_true")
            request_parser.add_argument("--now", type=int, required=True)
            proposal_parser = commands.add_parser("propose")
            proposal_parser.add_argument("snapshot", type=pathlib.Path)
            proposal_parser.add_argument("--request", type=pathlib.Path, required=True)
            proposal_parser.add_argument("--now", type=int, required=True)
            authorization_parser = commands.add_parser("authorize")
            authorization_parser.add_argument("snapshot", type=pathlib.Path)
            authorization_parser.add_argument("proposal", type=pathlib.Path)
            authorization_parser.add_argument("operator_claim")
            authorization_parser.add_argument("--now", type=int, required=True)
            commit_parser = commands.add_parser("commit")
            commit_parser.add_argument("snapshot", type=pathlib.Path)
            commit_parser.add_argument("proposal", type=pathlib.Path)
            commit_parser.add_argument("authorization", type=pathlib.Path)
            commit_parser.add_argument("--store", type=pathlib.Path, required=True)
            commit_parser.add_argument("--now", type=int, required=True)
            verify_parser = commands.add_parser("verify-store")
            verify_parser.add_argument("--store", type=pathlib.Path, required=True)
            show_parser = commands.add_parser("show")
            show_parser.add_argument("--store", type=pathlib.Path, required=True)
            arguments = parser.parse_args()
            try:
