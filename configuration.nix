#@MNX-DEF path=systemd.services.mnx-observe section=10.00 role=service ordinal=010
  #@MNX-PART id=10.00.periodic-observer kind=mechanism title="Bounded periodic runtime observer"
  systemd.services.mnx-observe = {
    description = "Measure Monsternix runtime and retain a bounded evidence bundle";
    serviceConfig = {
      Type = "oneshot";
      UMask = "0077";
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectSystem = "strict";
      ProtectHome = true;
      ReadWritePaths = [ "/var/lib/monsternix/observations" "/var/lib/monsternix/observation-retention" "/var/lib/monsternix/attempt-ledger" "/run/monsternix" ];
      IPAddressDeny = "any";
      ExecStartPre = "${pkgs.python3}/bin/python3 -I -B /etc/monsternix/bin/mnx-attempt-ledger --contract /etc/monsternix/attempt-ledger.json begin-systemd";
      ExecStart = "/etc/monsternix/bin/mnx observe --save --quiet";
      ExecStartPost = "/etc/monsternix/bin/mnx evidence prune --quiet";
      ExecStopPost = "${pkgs.python3}/bin/python3 -I -B /etc/monsternix/bin/mnx-attempt-ledger --contract /etc/monsternix/attempt-ledger.json finish-systemd";
    };
  };

#@MNX-DEF path=systemd.timers.mnx-observe section=10.00 role=timer ordinal=011
  systemd.timers.mnx-observe = {
    description = "Periodically measure Monsternix runtime";
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnBootSec = "4min";
      OnUnitActiveSec = "6h";
      AccuracySec = "1min";
      Persistent = true;
      Unit = "mnx-observe.service";
    };
  };

  # Keep an immutable closure reference without claiming the operator's
  # editable /etc/nixos source tree. Test adapters may populate that tree as
  # explicit machine policy.
  environment.etc."monsternix/source/configuration.nix".source = monsternixSource;

  systemd.services.mnx-foundation-boot-proof = {
    description = "Record bounded MNX Foundation boot identity";
    wantedBy = [ "multi-user.target" ];
    after = [ "local-fs.target" ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      UMask = "0077";
      RuntimeDirectory = "monsternix";
      RuntimeDirectoryMode = "0700";
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectSystem = "strict";
      ProtectHome = true;
      ReadWritePaths = [ "/run/monsternix" ];
    };
    script = ''
      set -Eeuo pipefail
      tmp=/run/monsternix/foundation-boot.json.$$
      global_addresses="$(${pkgs.iproute2}/bin/ip -j address | ${pkgs.jq}/bin/jq '[.[] | select(.ifname != "lo") | .addr_info[]? | select(.scope == "global")] | length')"
      listening_sockets="$(${pkgs.iproute2}/bin/ss -H -lntup | ${pkgs.gawk}/bin/awk 'END { print NR + 0 }')"
      exposure_policy_sha256="$(${pkgs.coreutils}/bin/sha256sum /etc/monsternix/exposure-policy.json | ${pkgs.coreutils}/bin/cut -d' ' -f1)"
      exposure_policy_enforcement="$(${pkgs.jq}/bin/jq -r '.enforcement' /etc/monsternix/exposure-policy.json)"
      ${pkgs.jq}/bin/jq -n \
        --arg schema mnx.foundation-boot.v0 \
        --arg boot_id "$(${pkgs.coreutils}/bin/cat /proc/sys/kernel/random/boot_id)" \
        --arg running_system "$(${pkgs.coreutils}/bin/readlink -f /run/current-system)" \
        --arg foundation_posture ${lib.escapeShellArg machinePosture} \
        --arg network_default ${lib.escapeShellArg (if machinePosture == "reference" then "off" else "adapter-owned")} \
        --argjson global_addresses "$global_addresses" \
        --argjson listening_sockets "$listening_sockets" \
        --arg exposure_policy_sha256 "$exposure_policy_sha256" \
        --arg exposure_policy_enforcement "$exposure_policy_enforcement" \
        '{schema:$schema,status:"booted",boot_id:$boot_id,running_system:$running_system,foundation_posture:$foundation_posture,network_default:$network_default,global_address_count:$global_addresses,listening_socket_count:$listening_sockets,exposure_policy_sha256:$exposure_policy_sha256,exposure_policy_enforcement:$exposure_policy_enforcement,promotion_status:"not-requested"}' \
        > "$tmp"
      ${pkgs.coreutils}/bin/chmod 0600 "$tmp"
      ${pkgs.coreutils}/bin/mv -T "$tmp" /run/monsternix/foundation-boot.json
    '';
  };
  # MNX-EJECT-END

  # MNX-EJECT-BEGIN owner=monsternix.foundation
  assertions = [
    {
      assertion = machinePosture != "reference" || config.networking.firewall.enable;
      message = "MNX Foundation reference posture requires its firewall enabled";
    }
    {
      assertion = machinePosture != "reference" || !config.networking.networkmanager.enable;
      message = "MNX Foundation reference posture must not enable NetworkManager";
    }
    {
      assertion = machinePosture != "reference" || !(config.services.xserver.enable or false);
      message = "MNX Foundation reference posture must remain console-only";
    }
    {
      assertion = machinePosture != "reference" || !(config.services.openssh.enable or false);
      message = "MNX Foundation reference posture must remain console-first without SSH";
    }
  ];
  # MNX-EJECT-END

  # MNX-EJECT-BEGIN owner=monsternix.foundation
  # Bind every closure to this exact complete handoff. NixOS's generic source
  # copying can otherwise inherit an ambient NIXOS_CONFIG and attach an
  # unrelated host file to a successfully built candidate.
  system.copySystemConfiguration = false;
#@MNX-DEF path=system.systemBuilderCommands section=10.00 role=source-identity ordinal=012
  #@MNX-PART id=10.00.closure-source-binding kind=mechanism title="Exact closure source binding"
  system.systemBuilderCommands = lib.optionalString bindFoundationConfiguration ''
    ln -s ${monsternixSource} "$out/configuration.nix"
  '';
  # MNX-EJECT-END
}

