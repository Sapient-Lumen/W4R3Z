        #!/usr/bin/env python3
        """Portable, deterministic editing-office carrier for a Foundation repository."""

        from __future__ import annotations

        import argparse
        import gzip
        import hashlib
        import io
        import json
        import os
        import pathlib
        import re
        import shutil
        import stat
        import subprocess
        import sys
        import tarfile
        import tempfile
        from typing import Any


        PACKET_ROOT = "mnx-foundation-cloudtainer"
        RETURN_ROOT = "mnx-foundation-return"
        PACKET_SCHEMA = "mnx.foundation-repository-cloudtainer.v1"
        RETURN_SCHEMA = "mnx.foundation-repository-return.v1"
        WORKSPACE_SCHEMA = "mnx.foundation-repository-workspace.v1"
        MANIFEST = "SHA256SUMS"
        MAX_FILES = 512
        MAX_BYTES = 64 * 1024 * 1024
        MAX_REQUEST = 256 * 1024
        MAX_EVIDENCE_FILES = 16
        MAX_EVIDENCE_BYTES = 8 * 1024 * 1024
        MAX_HISTORY = 8
        SHA256 = re.compile(r"^[0-9a-f]{64}$")
        LABEL = re.compile(r"^[a-z][a-z0-9-]{0,63}$")
        REQUIRED_REPOSITORY_PATHS = {
            "foundation/configuration.nix",
            "dist/configuration.nix",
            "foundation/projections.json",
            "foundation/proof-profiles.json",
            "foundation/cloudtainer-contract.json",
            "foundation/ownership.json",
            "docs/pro-reading-map.md",
            "tools/mnx-cloudtainer",
            "tools/mnx-cloudtainer-product-proof",
        }


        class Refusal(RuntimeError):
            pass


        def require(condition: bool, message: str) -> None:
            if not condition:
                raise Refusal(message)


        def digest(raw: bytes) -> str:
            return hashlib.sha256(raw).hexdigest()


        def canonical_json(value: Any) -> bytes:
            return (json.dumps(value, sort_keys=True, separators=(",", ":"),
                               ensure_ascii=False, allow_nan=False) + "\n").encode()


        def stable_regular(path: pathlib.Path, label: str, limit: int) -> bytes:
            require(path.is_file() and not path.is_symlink(), f"{label} must be a regular non-symlink file")
            before = path.stat()
            require(before.st_size <= limit, f"{label} exceeds its byte bound")
            raw = path.read_bytes()
            after = path.stat()
            require((before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) ==
                    (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns),
                    f"{label} changed while being read")
            require(len(raw) == before.st_size, f"{label} length changed while being read")
            return raw


        def text_input(path: pathlib.Path, label: str, limit: int) -> bytes:
            raw = stable_regular(path, label, limit)
            require(b"\x00" not in raw, f"{label} contains a NUL byte")
            try:
                raw.decode("utf-8", errors="strict")
            except UnicodeDecodeError as error:
                raise Refusal(f"{label} is not UTF-8: {error}") from error
            return raw


        def run_git(repo: pathlib.Path, *arguments: str) -> bytes:
            completed = subprocess.run(
                ["git", "-C", str(repo), *arguments], check=False,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            )
            require(completed.returncode == 0,
                    f"git {' '.join(arguments)} failed: {completed.stderr.decode(errors='replace').strip()}")
            return completed.stdout


        def clean_git_identity(repo: pathlib.Path) -> tuple[str, list[str]]:
            require(repo.is_dir() and not repo.is_symlink(), "repository is not a real directory")
            repo = repo.resolve(strict=True)
            root = pathlib.Path(run_git(repo, "rev-parse", "--show-toplevel").decode().strip()).resolve()
            require(root == repo, "--repo must name the Git top level")
            require(run_git(repo, "status", "--porcelain=v1", "--untracked-files=all", "-z") == b"",
                    "repository must be exactly clean, including untracked files")
            head = run_git(repo, "rev-parse", "--verify", "HEAD").decode().strip()
            require(re.fullmatch(r"[0-9a-f]{40,64}", head) is not None, "Git HEAD is not canonical")
            raw = run_git(repo, "ls-files", "-z")
            names = [item.decode("utf-8", errors="strict") for item in raw.split(b"\0") if item]
            require(names == sorted(names) and len(names) == len(set(names)), "tracked path order is not canonical")
            visibility = [item for item in run_git(repo, "ls-files", "-v", "-z").split(b"\0") if item]
            require(len(visibility) == len(names), "Git index visibility inventory differs")
            require(all(item[:1] not in {b"S"} and not item[:1].islower() for item in visibility),
                    "Git index contains skip-worktree or assume-unchanged entries")
            require(REQUIRED_REPOSITORY_PATHS <= set(names),
                    "repository lacks the canonical Cloudtainer reading/proof surface")
            return head, names


        def tracked_executability(repo: pathlib.Path, names: list[str]) -> dict[str, bool]:
            result: dict[str, bool] = {}
            for row in run_git(repo, "ls-files", "--stage", "-z").split(b"\0"):
                if not row:
                    continue
                metadata, separator, raw_name = row.partition(b"\t")
                fields = metadata.split()
                require(separator == b"\t" and len(fields) == 3 and fields[2] == b"0" and
                        fields[0] in {b"100644", b"100755"},
                        "Git index contains a noncanonical tracked object")
                name = raw_name.decode("utf-8", errors="strict")
                require(name not in result, "Git index contains duplicate tracked paths")
                result[name] = fields[0] == b"100755"
            require(sorted(result) == names, "Git index mode inventory differs from tracked paths")
            return result


        def canonical_relative(name: str) -> pathlib.PurePosixPath:
            pure = pathlib.PurePosixPath(name)
            require(name == pure.as_posix() and not pure.is_absolute() and pure.parts and
                    all(part not in {"", ".", "..", ".git"} for part in pure.parts) and "\\" not in name,
                    f"unsafe or noncanonical relative path: {name!r}")
            return pure


        def inventory_paths(root: pathlib.Path, names: list[str],
                            executability: dict[str, bool] | None = None) -> tuple[list[dict[str, Any]], int]:
            require(len(names) <= MAX_FILES, "source file-count bound exceeded")
            records: list[dict[str, Any]] = []
            total = 0
            for name in names:
                pure = canonical_relative(name)
                path = root.joinpath(*pure.parts)
                require(path.is_file() and not path.is_symlink(), f"source path is not a regular file: {name}")
                raw = stable_regular(path, f"source path {name}", MAX_BYTES)
                mode = stat.S_IMODE(path.stat().st_mode)
                total += len(raw)
                require(total <= MAX_BYTES, "source byte bound exceeded")
                records.append({"path": name, "sha256": digest(raw), "bytes": len(raw),
                                "executable": (executability[name] if executability is not None
                                               else bool(mode & 0o111))})
            return records, total


        def walk_regular(root: pathlib.Path, *, maximum_files: int = MAX_FILES,
                         maximum_bytes: int = MAX_BYTES) -> dict[str, pathlib.Path]:
            require(root.is_dir() and not root.is_symlink(), "tree root is not a real directory")
            result: dict[str, pathlib.Path] = {}
            total = 0

            def visit(directory: pathlib.Path, prefix: pathlib.PurePosixPath) -> None:
                nonlocal total
                with os.scandir(directory) as stream:
                    entries = sorted(stream, key=lambda item: item.name)
                for entry in entries:
                    name = (prefix / entry.name).as_posix()
                    canonical_relative(name)
                    mode = entry.stat(follow_symlinks=False).st_mode
                    path = pathlib.Path(entry.path)
                    if stat.S_ISDIR(mode):
                        visit(path, prefix / entry.name)
                    elif stat.S_ISREG(mode):
                        if name == MANIFEST:
                            continue
                        total += entry.stat(follow_symlinks=False).st_size
                        require(len(result) + 1 <= maximum_files, "tree file-count bound exceeded")
                        require(total <= maximum_bytes, "tree byte bound exceeded")
                        result[name] = path
                    else:
                        raise Refusal(f"links and special files are forbidden: {name}")

            visit(root, pathlib.PurePosixPath())
            return result


        def render_manifest(root: pathlib.Path) -> bytes:
            files = walk_regular(root)
            return "".join(
                f"{digest(path.read_bytes())}  ./{name}\n" for name, path in sorted(files.items())
            ).encode()


        def verify_manifest(root: pathlib.Path) -> dict[str, pathlib.Path]:
            manifest = root / MANIFEST
            raw = stable_regular(manifest, "closed-tree manifest", 1024 * 1024)
            recorded: dict[str, str] = {}
            for line in raw.decode("utf-8", errors="strict").splitlines():
                require(len(line) >= 68 and line[64:68] == "  ./" and SHA256.fullmatch(line[:64]) is not None,
                        "malformed manifest row")
                name = line[68:]
                canonical_relative(name)
                require(name != MANIFEST and name not in recorded, "duplicate or recursive manifest path")
                recorded[name] = line[:64]
            files = walk_regular(root)
            require(set(recorded) == set(files), "closed-tree inventory differs")
            for name, path in files.items():
                require(digest(path.read_bytes()) == recorded[name], f"manifest digest differs: {name}")
            return files


        def write_archive(tree: pathlib.Path, output: pathlib.Path, root_name: str) -> str:
            require(not output.exists() and not output.is_symlink(), "output must be absent")
            require(output.parent.is_dir() and not output.parent.is_symlink(), "output parent is unsafe")
            files = verify_manifest(tree)
            tar_buffer = io.BytesIO()
            with tarfile.open(fileobj=tar_buffer, mode="w", format=tarfile.PAX_FORMAT) as archive:
                directories: set[pathlib.PurePosixPath] = {pathlib.PurePosixPath()}
                for name in [*files, MANIFEST]:
                    parent = pathlib.PurePosixPath(name).parent
                    while parent.parts:
                        directories.add(parent)
                        parent = parent.parent
                for relative in sorted(directories, key=lambda item: (len(item.parts), item.as_posix())):
                    if not relative.parts:
                        continue
                    info = tarfile.TarInfo(f"{root_name}/{relative.as_posix()}")
                    info.type = tarfile.DIRTYPE
                    info.mode = 0o700
                    info.uid = info.gid = info.mtime = 0
                    info.uname = info.gname = ""
                    archive.addfile(info)
                for name in sorted([*files, MANIFEST]):
                    path = tree / name
                    raw = path.read_bytes()
                    info = tarfile.TarInfo(f"{root_name}/{name}")
                    info.size = len(raw)
                    info.mode = 0o700 if (path.stat().st_mode & 0o111) else 0o600
                    info.uid = info.gid = info.mtime = 0
                    info.uname = info.gname = ""
                    archive.addfile(info, io.BytesIO(raw))
            buffer = io.BytesIO()
            with gzip.GzipFile(fileobj=buffer, mode="wb", filename="", mtime=0) as stream:
                stream.write(tar_buffer.getvalue())
            raw = buffer.getvalue()
            descriptor, temporary_name = tempfile.mkstemp(prefix=f".{output.name}.", dir=output.parent)
            temporary = pathlib.Path(temporary_name)
            try:
                with os.fdopen(descriptor, "wb") as stream:
                    stream.write(raw)
                    stream.flush()
                    os.fchmod(stream.fileno(), 0o600)
                    os.fsync(stream.fileno())
                try:
                    os.link(temporary, output)
                except FileExistsError as error:
                    raise Refusal("output appeared during publication") from error
            finally:
                temporary.unlink(missing_ok=True)
            return digest(raw)


        def extract_archive(archive_path: pathlib.Path, destination: pathlib.Path,
                            expected_root: str | None = None) -> tuple[pathlib.Path, str]:
            raw = stable_regular(archive_path, "archive", MAX_BYTES)
            require(not destination.exists() and not destination.is_symlink(), "destination must be absent")
            destination.mkdir(mode=0o700)
            seen: set[str] = set()
            root_name: str | None = None
            total = 0
            try:
                with tarfile.open(fileobj=io.BytesIO(raw), mode="r:gz") as archive:
                    members = archive.getmembers()
                    require(len(members) <= MAX_FILES * 2, "archive member bound exceeded")
                    for member in members:
                        require(member.uid == 0 and member.gid == 0 and member.mtime == 0 and
                                member.uname == "" and member.gname == "",
                                "archive metadata is not normalized")
                        pure = pathlib.PurePosixPath(member.name)
                        require(not pure.is_absolute() and len(pure.parts) >= 2 and
                                all(part not in {"", ".", ".."} for part in pure.parts),
                                "archive member path is unsafe")
                        if root_name is None:
                            root_name = pure.parts[0]
                        require(pure.parts[0] == root_name, "archive has multiple roots")
                        relative = pathlib.PurePosixPath(*pure.parts[1:])
                        canonical_relative(relative.as_posix())
                        name = relative.as_posix()
                        require(name not in seen, "archive contains duplicate members")
                        seen.add(name)
                        target = destination.joinpath(root_name, *relative.parts)
                        if member.isdir():
                            require(member.mode == 0o700, "archive directory mode differs")
                            target.mkdir(parents=True, exist_ok=False)
                        elif member.isfile():
                            require(member.mode in {0o600, 0o700}, "archive file mode differs")
                            total += member.size
                            require(total <= MAX_BYTES, "archive expanded byte bound exceeded")
                            target.parent.mkdir(parents=True, exist_ok=True)
                            stream = archive.extractfile(member)
                            require(stream is not None, "archive member has no payload")
                            payload = stream.read(MAX_BYTES + 1)
                            require(len(payload) == member.size, "archive member length differs")
                            target.write_bytes(payload)
                            target.chmod(member.mode)
                        else:
                            raise Refusal("archive links and special members are forbidden")
                require(root_name is not None, "archive is empty")
                require(expected_root is None or root_name == expected_root, "archive kind differs")
                root = destination / root_name
                verify_manifest(root)
                return root, digest(raw)
            except Exception:
                shutil.rmtree(destination, ignore_errors=True)
                raise


        def source_manifest(records: list[dict[str, Any]]) -> bytes:
            return canonical_json({"schema": "mnx.foundation-source-tree.v1", "files": records})


        def validate_source_manifest(root: pathlib.Path, raw: bytes) -> dict[str, Any]:
            value = json.loads(raw)
            require(isinstance(value, dict), "source manifest is not an object")
            require(value.get("schema") == "mnx.foundation-source-tree.v1", "source manifest schema differs")
            files = value.get("files")
            require(isinstance(files, list), "source manifest files are absent")
            names = [item.get("path") for item in files]
            require(names == sorted(names) and len(names) == len(set(names)), "source manifest order differs")
            actual, total = inventory_paths(root, names)
            require(actual == files, "source manifest contradicts carried bytes")
            return {"files": len(files), "bytes": total, "sha256": digest(raw)}


        def validate_history(raw: bytes) -> list[dict[str, Any]]:
            value = json.loads(raw)
            require(isinstance(value, dict), "conversation history is not an object")
            require(value.get("schema") == "mnx.foundation-conversation-history.v1",
                    "conversation history schema differs")
            records = value.get("records")
            require(isinstance(records, list) and len(records) <= MAX_HISTORY,
                    "conversation history exceeds its record bound")
            for record in records:
                require(isinstance(record, dict) and set(record) == {
                    "base_git_head", "packet_sha256", "operator_request_sha256",
                    "portable_result_sha256", "disposition", "candidate_manifest_sha256",
                }, "conversation history record shape differs")
                require(all(isinstance(record[field], str) for field in record),
                        "conversation history record values must be strings")
                require(re.fullmatch(r"[0-9a-f]{40,64}", record["base_git_head"]) is not None and
                        all(SHA256.fullmatch(record[field]) is not None for field in (
                            "packet_sha256", "operator_request_sha256", "portable_result_sha256",
                            "candidate_manifest_sha256")) and
                        record["disposition"] in {"recommend", "hold", "reject"},
                        "conversation history record value differs")
            return records


        def read_metadata(root: pathlib.Path, kind: str) -> tuple[dict[str, Any], dict[str, Any]]:
            verify_manifest(root)
            if kind == "packet":
                metadata_name, schema = "cloudtainer.json", PACKET_SCHEMA
            else:
                metadata_name, schema = "proposal.json", RETURN_SCHEMA
            raw = stable_regular(root / metadata_name, metadata_name, 1024 * 1024)
            metadata = json.loads(raw)
            require(isinstance(metadata, dict), f"{kind} metadata is not an object")
            require(metadata.get("schema") == schema and metadata.get("status") == "proposal-not-accepted",
                    f"{kind} metadata schema or status differs")
            manifest_name = "source-manifest.json" if kind == "packet" else "candidate-manifest.json"
            source_raw = stable_regular(root / manifest_name, manifest_name, 8 * 1024 * 1024)
            require(metadata.get(manifest_name.replace("-", "_").replace(".json", "_sha256")) == digest(source_raw),
                    f"{kind} metadata does not bind its source manifest")
            summary = validate_source_manifest(root / "source", source_raw)
            helper = stable_regular(root / "bin/mnx-cloudtainer", "carried helper", 1024 * 1024)
            require(metadata.get("helper_sha256") == digest(helper), f"{kind} helper identity differs")
            history_raw = stable_regular(root / "conversation-history.json", "conversation history", MAX_REQUEST)
            history = validate_history(history_raw)
            require(metadata.get("conversation_history_sha256") == digest(history_raw),
                    f"{kind} metadata does not bind conversation history")
            authority = metadata.get("authority", {})
            require(authority == {"host_write": False, "host_test": False, "host_switch": False,
                                  "acceptance": False, "network": False, "payload_execution": False},
                    f"{kind} authority expanded")
            if kind == "packet":
                reading = stable_regular(root / "READING-MAP.md", "reading map", MAX_REQUEST)
                require(metadata.get("reading_map_sha256") == digest(reading), "reading map identity differs")
                rows = metadata.get("evidence")
                require(isinstance(rows, list) and len(rows) <= MAX_EVIDENCE_FILES, "evidence inventory differs")
                labels: set[str] = set()
                total = 0
                for row in rows:
                    label = row.get("label")
                    require(isinstance(label, str) and LABEL.fullmatch(label) is not None and label not in labels,
                            "evidence label is invalid or duplicated")
                    labels.add(label)
                    raw_evidence = stable_regular(root / "evidence" / label, f"evidence {label}", MAX_EVIDENCE_BYTES)
                    total += len(raw_evidence)
                    require(total <= MAX_EVIDENCE_BYTES and row == {
                        "label": label, "sha256": digest(raw_evidence), "bytes": len(raw_evidence)},
                        "evidence metadata contradicts carried bytes")
            else:
                for field, name in (
                    ("portable_result_sha256", "portable-result.txt"),
                    ("portable_disposition_sha256", "portable-disposition.json"),
                    ("host_validation_request_sha256", "host-validation-request.json"),
                ):
                    raw_bound = stable_regular(root / name, name, MAX_REQUEST)
                    require(metadata.get(field) == digest(raw_bound), f"return metadata does not bind {name}")
                disposition = json.loads((root / "portable-disposition.json").read_text(encoding="utf-8"))
                require(isinstance(disposition, dict), "portable disposition is not an object")
                require(disposition.get("schema") == "mnx.foundation-portable-disposition.v1" and
                        disposition.get("disposition") in {"recommend", "hold", "reject"} and
                        disposition.get("attribution") == "recorded-not-authenticated" and
                        disposition.get("host_acceptance") is False and
                        disposition.get("operator_acceptance") is False,
                        "portable disposition impersonates authority")
                request = json.loads((root / "host-validation-request.json").read_text(encoding="utf-8"))
                require(request == {"schema": "mnx.foundation-host-validation-request.v1",
                                    "required": ["exact-base-review", "candidate-source-check", "focused-proofs",
                                                 "nix-evaluation", "operator-review", "mnx-test", "mnx-switch"],
                                    "automatic_host_overwrite": False},
                        "host validation request differs")
            summary["history_records"] = len(history)
            return metadata, summary


        def reading_map(head: str) -> bytes:
            return f"""# Monsternix Foundation portable office

        Carrier base: `{head}`

        Read in this order:

        1. `OPERATOR-REQUEST.txt` — the current request; it is not inherited authority.
        2. `source/foundation/configuration.nix` — constitution and current Foundation source.
        3. `source/docs/pro-reading-map.md` — repository-wide navigation.
        4. `source/foundation/ownership.json` and `source/foundation/feature-maturity.json`.
        5. `source/foundation/cloudtainer-contract.json` — this carrier's authority limits.
        6. Relevant canonical `source/tools/`, `source/foundation/`, and focused proofs.

        Edit only `source/`. Close the workspace with `bin/mnx-cloudtainer close`.
        The return is a proposal. It cannot prove Nix evaluation, runtime behavior,
        physical facts, host acceptance, or activation.
        """.encode()


        def copy_records(repo: pathlib.Path, records: list[dict[str, Any]], destination: pathlib.Path) -> None:
            for item in records:
                relative = canonical_relative(item["path"])
                source = repo.joinpath(*relative.parts)
                target = destination.joinpath(*relative.parts)
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(source.read_bytes())
                target.chmod(0o700 if item["executable"] else 0o600)


        def command_export(args: argparse.Namespace) -> dict[str, Any]:
            require(args.repo.is_dir() and not args.repo.is_symlink(), "repository is not a real directory")
            repo = args.repo.resolve(strict=True)
            head, names = clean_git_identity(repo)
            modes = tracked_executability(repo, names)
            records, source_bytes = inventory_paths(repo, names, modes)
            source_raw = source_manifest(records)
            request = text_input(args.request, "operator request", MAX_REQUEST)
            history_records: list[dict[str, Any]] = []
            if args.predecessor_return is not None:
                with tempfile.TemporaryDirectory(prefix="mnx-cloudtainer-predecessor.") as predecessor_name:
                    predecessor_root, _ = extract_archive(
                        args.predecessor_return, pathlib.Path(predecessor_name) / "extract", RETURN_ROOT)
                    predecessor_metadata, _ = read_metadata(predecessor_root, "return")
                    require(predecessor_metadata["candidate_manifest_sha256"] == digest(source_raw),
                            "predecessor return candidate is not the exact current repository tree")
                    history_records = validate_history(stable_regular(
                        predecessor_root / "conversation-history.json", "predecessor history", MAX_REQUEST))
            evidence: list[tuple[str, pathlib.Path, bytes]] = []
            require(len(args.evidence) <= MAX_EVIDENCE_FILES, "evidence file-count bound exceeded")
            if args.evidence:
                require(args.acknowledge_evidence_secret_review,
                        "selected evidence requires --acknowledge-evidence-secret-review")
            evidence_total = 0
            for expression in args.evidence:
                label, separator, value = expression.partition("=")
                require(separator == "=" and LABEL.fullmatch(label) is not None, "evidence must be LABEL=PATH")
                require(label not in {item[0] for item in evidence}, "duplicate evidence label")
                path = pathlib.Path(value)
                raw = stable_regular(path, f"evidence {label}", MAX_EVIDENCE_BYTES)
                evidence_total += len(raw)
                require(evidence_total <= MAX_EVIDENCE_BYTES, "evidence byte bound exceeded")
                evidence.append((label, path, raw))
            with tempfile.TemporaryDirectory(prefix="mnx-cloudtainer-export.") as temporary_name:
                tree = pathlib.Path(temporary_name) / "tree"
                (tree / "source").mkdir(parents=True)
                copy_records(repo, records, tree / "source")
                (tree / "source-manifest.json").write_bytes(source_raw)
                history_raw = canonical_json({"schema": "mnx.foundation-conversation-history.v1",
                                              "records": history_records})
                (tree / "conversation-history.json").write_bytes(history_raw)
                (tree / "OPERATOR-REQUEST.txt").write_bytes(request)
                (tree / "READING-MAP.md").write_bytes(reading_map(head))
                helper = stable_regular(repo / "tools/mnx-cloudtainer", "Cloudtainer helper", 1024 * 1024)
                (tree / "bin").mkdir()
                (tree / "bin/mnx-cloudtainer").write_bytes(helper)
                (tree / "bin/mnx-cloudtainer").chmod(0o700)
                evidence_rows = []
                if evidence:
                    (tree / "evidence").mkdir()
                for label, _, raw in evidence:
                    (tree / "evidence" / label).write_bytes(raw)
                    evidence_rows.append({"label": label, "sha256": digest(raw), "bytes": len(raw)})
                final_head, final_names = clean_git_identity(repo)
                final_records, final_bytes = inventory_paths(repo, final_names,
                                                               tracked_executability(repo, final_names))
                require(final_head == head and final_names == names and final_records == records and
                        final_bytes == source_bytes,
                        "repository changed while the packet was being assembled")
                metadata = {
                    "schema": PACKET_SCHEMA, "status": "proposal-not-accepted",
                    "carrier": "foundation-repository", "git_head": head,
                    "source_manifest_sha256": digest(source_raw),
                    "conversation_history_sha256": digest(history_raw),
                    "operator_request_sha256": digest(request),
                    "reading_map_sha256": digest((tree / "READING-MAP.md").read_bytes()),
                    "helper_sha256": digest(helper), "source_files": len(records),
                    "source_bytes": source_bytes, "evidence": evidence_rows,
                    "authority": {"host_write": False, "host_test": False, "host_switch": False,
                                  "acceptance": False, "network": False, "payload_execution": False},
                }
                (tree / "cloudtainer.json").write_bytes(canonical_json(metadata))
                (tree / MANIFEST).write_bytes(render_manifest(tree))
                archive_sha = write_archive(tree, args.output, PACKET_ROOT)
            return {"schema": "mnx.foundation-cloudtainer-export.v1", "status": "pass",
                    "archive": str(args.output.resolve()), "archive_sha256": archive_sha,
                    "git_head": head, "source_files": len(records), "source_bytes": source_bytes,
                    "evidence_files": len(evidence), "history_records": len(history_records),
                    "authority": metadata["authority"]}


        def command_verify(args: argparse.Namespace) -> dict[str, Any]:
            with tempfile.TemporaryDirectory(prefix="mnx-cloudtainer-verify.") as temporary_name:
                target = pathlib.Path(temporary_name) / "extract"
                root, archive_sha = extract_archive(args.archive, target)
                if root.name == PACKET_ROOT:
                    metadata, summary = read_metadata(root, "packet")
                    request = stable_regular(root / "OPERATOR-REQUEST.txt", "operator request", MAX_REQUEST)
                    require(metadata["operator_request_sha256"] == digest(request), "request identity differs")
                    kind = "packet"
                elif root.name == RETURN_ROOT:
                    metadata, summary = read_metadata(root, "return")
                    kind = "return"
                else:
                    raise Refusal("unknown Cloudtainer archive root")
                return {"schema": "mnx.foundation-cloudtainer-verification.v1", "status": "pass",
                        "kind": kind, "archive_sha256": archive_sha,
                        "base_git_head": metadata.get("git_head", metadata.get("base_git_head")),
                        "source": summary, "authority": metadata["authority"]}


        def copy_verified_tree(source: pathlib.Path, destination: pathlib.Path) -> None:
            files = walk_regular(source)
            for name, path in files.items():
                relative = canonical_relative(name)
                target = destination.joinpath(*relative.parts)
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(path.read_bytes())
                target.chmod(0o700 if path.stat().st_mode & 0o111 else 0o600)


        def normalize_private_directories(root: pathlib.Path) -> None:
            """Make carrier workspaces independent of the caller's ambient umask."""
            for directory, names, _files in os.walk(root, topdown=True, followlinks=False):
                path = pathlib.Path(directory)
                require(path.is_dir() and not path.is_symlink(), "workspace contains a linked directory")
                path.chmod(0o700)
                for name in names:
                    child = path / name
                    require(child.is_dir() and not child.is_symlink(),
                            "workspace contains a linked directory")


        def command_open(args: argparse.Namespace) -> dict[str, Any]:
            output = args.out.absolute()
            require(not output.exists() and not output.is_symlink(), "workspace output must be absent")
            require(output.parent.is_dir() and output.parent.resolve(strict=True) == output.parent,
                    "workspace output parent is unsafe")
            with tempfile.TemporaryDirectory(prefix=".mnx-cloudtainer-open.",
                                             dir=output.parent) as temporary_name:
                root, archive_sha = extract_archive(args.archive, pathlib.Path(temporary_name) / "extract", PACKET_ROOT)
                metadata, summary = read_metadata(root, "packet")
                staging = pathlib.Path(temporary_name) / "workspace"
                (staging / "source").mkdir(parents=True)
                copy_verified_tree(root / "source", staging / "source")
                (staging / "bin").mkdir()
                shutil.copy2(root / "bin/mnx-cloudtainer", staging / "bin/mnx-cloudtainer")
                shutil.copy2(root / "OPERATOR-REQUEST.txt", staging / "OPERATOR-REQUEST.txt")
                shutil.copy2(root / "READING-MAP.md", staging / "READING-MAP.md")
                custody = {
                    "schema": WORKSPACE_SCHEMA, "packet_sha256": archive_sha,
                    "base_git_head": metadata["git_head"],
                    "base_source_manifest_sha256": metadata["source_manifest_sha256"],
                    "operator_request_sha256": metadata["operator_request_sha256"],
                    "authority": {"host_write": False, "acceptance": False, "activation": False},
                }
                (staging / ".mnx-cloudtainer").mkdir()
                (staging / ".mnx-cloudtainer/receipt.json").write_bytes(canonical_json(custody))
                (staging / ".mnx-cloudtainer/receipt.json").chmod(0o600)
                shutil.copy2(root / "conversation-history.json",
                             staging / ".mnx-cloudtainer/conversation-history.json")
                normalize_private_directories(staging)
                require(staging.stat().st_dev == output.parent.stat().st_dev,
                        "workspace staging filesystem differs from output")
                os.replace(staging, output)
            return {"schema": WORKSPACE_SCHEMA, "status": "pass", "workspace": str(output.resolve()),
                    "packet_sha256": archive_sha, "base_git_head": metadata["git_head"], "source": summary}


        def workspace_receipt(workspace: pathlib.Path) -> dict[str, Any]:
            require(workspace.is_dir() and not workspace.is_symlink(), "workspace is not a real directory")
            raw = stable_regular(workspace / ".mnx-cloudtainer/receipt.json", "workspace receipt", 1024 * 1024)
            value = json.loads(raw)
            require(value.get("schema") == WORKSPACE_SCHEMA and SHA256.fullmatch(value.get("packet_sha256", "")),
                    "workspace receipt is invalid")
            require(re.fullmatch(r"[0-9a-f]{40,64}", value.get("base_git_head", "")) is not None,
                    "workspace base Git head is invalid")
            history_raw = stable_regular(workspace / ".mnx-cloudtainer/conversation-history.json",
                                         "workspace conversation history", MAX_REQUEST)
            value["history"] = validate_history(history_raw)
            return value


        def command_close(args: argparse.Namespace) -> dict[str, Any]:
            receipt = workspace_receipt(args.workspace)
            result = text_input(args.result, "portable result", MAX_REQUEST)
            candidate_files = walk_regular(args.workspace / "source")
            names = sorted(candidate_files)
            records, source_bytes = inventory_paths(args.workspace / "source", names)
            require(REQUIRED_REPOSITORY_PATHS <= set(names), "candidate lost the canonical Cloudtainer surface")
            with tempfile.TemporaryDirectory(prefix="mnx-cloudtainer-close.") as temporary_name:
                tree = pathlib.Path(temporary_name) / "tree"
                (tree / "source").mkdir(parents=True)
                copy_records(args.workspace / "source", records, tree / "source")
                manifest_raw = source_manifest(records)
                (tree / "candidate-manifest.json").write_bytes(manifest_raw)
                (tree / "portable-result.txt").write_bytes(result)
                disposition = {"schema": "mnx.foundation-portable-disposition.v1",
                               "disposition": args.disposition, "attribution": "recorded-not-authenticated",
                               "host_acceptance": False, "operator_acceptance": False}
                (tree / "portable-disposition.json").write_bytes(canonical_json(disposition))
                history_records = [*receipt["history"], {
                    "base_git_head": receipt["base_git_head"],
                    "packet_sha256": receipt["packet_sha256"],
                    "operator_request_sha256": receipt["operator_request_sha256"],
                    "portable_result_sha256": digest(result),
                    "disposition": args.disposition,
                    "candidate_manifest_sha256": digest(manifest_raw),
                }][-MAX_HISTORY:]
                history_raw = canonical_json({"schema": "mnx.foundation-conversation-history.v1",
                                              "records": history_records})
                (tree / "conversation-history.json").write_bytes(history_raw)
                host_request = {"schema": "mnx.foundation-host-validation-request.v1",
                                "required": ["exact-base-review", "candidate-source-check", "focused-proofs",
                                             "nix-evaluation", "operator-review", "mnx-test", "mnx-switch"],
                                "automatic_host_overwrite": False}
                (tree / "host-validation-request.json").write_bytes(canonical_json(host_request))
                helper = stable_regular(args.workspace / "bin/mnx-cloudtainer", "workspace helper", 1024 * 1024)
                (tree / "bin").mkdir()
                (tree / "bin/mnx-cloudtainer").write_bytes(helper)
                (tree / "bin/mnx-cloudtainer").chmod(0o700)
                metadata = {
                    "schema": RETURN_SCHEMA, "status": "proposal-not-accepted",
                    "carrier": "foundation-repository", "base_git_head": receipt["base_git_head"],
                    "base_packet_sha256": receipt["packet_sha256"],
                    "base_source_manifest_sha256": receipt["base_source_manifest_sha256"],
                    "operator_request_sha256": receipt["operator_request_sha256"],
                    "candidate_manifest_sha256": digest(manifest_raw),
                    "conversation_history_sha256": digest(history_raw),
                    "portable_result_sha256": digest(result),
                    "portable_disposition_sha256": digest((tree / "portable-disposition.json").read_bytes()),
                    "host_validation_request_sha256": digest((tree / "host-validation-request.json").read_bytes()),
                    "helper_sha256": digest(helper), "source_files": len(records), "source_bytes": source_bytes,
                    "authority": {"host_write": False, "host_test": False, "host_switch": False,
                                  "acceptance": False, "network": False, "payload_execution": False},
                }
                (tree / "proposal.json").write_bytes(canonical_json(metadata))
                (tree / MANIFEST).write_bytes(render_manifest(tree))
                archive_sha = write_archive(tree, args.output, RETURN_ROOT)
            return {"schema": "mnx.foundation-cloudtainer-close.v1", "status": "pass",
                    "archive": str(args.output.resolve()), "archive_sha256": archive_sha,
                    "base_git_head": receipt["base_git_head"], "candidate": {"files": len(records), "bytes": source_bytes},
                    "disposition": args.disposition, "history_records": len(history_records),
                    "authority": metadata["authority"]}


        def current_repo_manifest(repo: pathlib.Path) -> tuple[str, bytes, list[dict[str, Any]]]:
            head, names = clean_git_identity(repo)
            records, _ = inventory_paths(repo, names)
            return head, source_manifest(records), records


        def review_return(archive: pathlib.Path, repo: pathlib.Path) -> tuple[dict[str, Any], pathlib.Path, tempfile.TemporaryDirectory[str]]:
            temporary = tempfile.TemporaryDirectory(prefix="mnx-cloudtainer-review.")
            try:
                root, archive_sha = extract_archive(archive, pathlib.Path(temporary.name) / "extract", RETURN_ROOT)
                metadata, summary = read_metadata(root, "return")
                head, base_raw, base_records = current_repo_manifest(repo)
                require(head == metadata["base_git_head"], "host checkout head differs from the acknowledged base")
                require(digest(base_raw) == metadata["base_source_manifest_sha256"],
                        "host checkout tree differs from the acknowledged base")
                base = {item["path"]: item for item in base_records}
                candidate_raw = stable_regular(root / "candidate-manifest.json", "candidate manifest", 8 * 1024 * 1024)
                candidate_value = json.loads(candidate_raw)
                candidate = {item["path"]: item for item in candidate_value["files"]}
                added = sorted(set(candidate) - set(base))
                deleted = sorted(set(base) - set(candidate))
                modified = sorted(name for name in set(base) & set(candidate) if candidate[name] != base[name])
                result = {"schema": "mnx.foundation-cloudtainer-review.v1", "status": "pass",
                          "archive_sha256": archive_sha, "base_git_head": head,
                          "candidate": summary, "changes": {"added": added, "modified": modified, "deleted": deleted},
                          "disposition": json.loads((root / "portable-disposition.json").read_text())["disposition"],
                          "authority": {"host_write": False, "host_test": False, "host_switch": False,
                                        "acceptance": False}}
                return result, root, temporary
            except Exception:
                temporary.cleanup()
                raise


        def command_review(args: argparse.Namespace) -> dict[str, Any]:
            result, _, temporary = review_return(args.archive, args.repo)
            temporary.cleanup()
            return result


        def command_materialize(args: argparse.Namespace) -> dict[str, Any]:
            output = args.out.absolute()
            require(not output.exists() and not output.is_symlink(), "materialization output must be absent")
            require(output.parent.is_dir() and output.parent.resolve(strict=True) == output.parent,
                    "materialization output parent is unsafe")
            result, root, temporary = review_return(args.archive, args.repo)
            try:
                with tempfile.TemporaryDirectory(prefix=".mnx-cloudtainer-materialize.",
                                                 dir=output.parent) as staging_name:
                    staging = pathlib.Path(staging_name) / "candidate"
                    staging.mkdir()
                    copy_verified_tree(root / "source", staging)
                    normalize_private_directories(staging)
                    require(staging.stat().st_dev == output.parent.stat().st_dev,
                            "materialization staging filesystem differs from output")
                    os.replace(staging, output)
            finally:
                temporary.cleanup()
            result = dict(result)
            result["schema"] = "mnx.foundation-cloudtainer-materialization.v1"
            result["candidate_path"] = str(output.resolve())
            result["authority"] = {"source_repository_write": False, "new_directory_write": True,
                                   "host_test": False, "host_switch": False, "acceptance": False}
            return result


        def parser() -> argparse.ArgumentParser:
            result = argparse.ArgumentParser(prog="mnx-cloudtainer")
            result.add_argument("--json", action="store_true")
            commands = result.add_subparsers(dest="command", required=True)
            doctor = commands.add_parser("doctor")
            export = commands.add_parser("export")
            export.add_argument("--repo", type=pathlib.Path, default=pathlib.Path.cwd())
            export.add_argument("--request", type=pathlib.Path, required=True)
            export.add_argument("--output", type=pathlib.Path, required=True)
            export.add_argument("--predecessor-return", type=pathlib.Path)
            export.add_argument("--evidence", action="append", default=[])
            export.add_argument("--acknowledge-evidence-secret-review", action="store_true")
            verify = commands.add_parser("verify")
            verify.add_argument("archive", type=pathlib.Path)
            open_command = commands.add_parser("open")
            open_command.add_argument("archive", type=pathlib.Path)
            open_command.add_argument("--out", type=pathlib.Path, required=True)
            close = commands.add_parser("close")
            close.add_argument("workspace", type=pathlib.Path)
            close.add_argument("--result", type=pathlib.Path, required=True)
            close.add_argument("--disposition", choices=("recommend", "hold", "reject"), required=True)
            close.add_argument("--output", type=pathlib.Path, required=True)
            review = commands.add_parser("review")
            review.add_argument("archive", type=pathlib.Path)
            review.add_argument("--repo", type=pathlib.Path, default=pathlib.Path.cwd())
            materialize = commands.add_parser("materialize")
            materialize.add_argument("archive", type=pathlib.Path)
            materialize.add_argument("--repo", type=pathlib.Path, default=pathlib.Path.cwd())
            materialize.add_argument("--out", type=pathlib.Path, required=True)
            return result


        def main() -> int:
            args = parser().parse_args()
            try:
                if args.command == "doctor":
                    value = {"schema": "mnx.foundation-cloudtainer-doctor.v1", "status": "pass",
