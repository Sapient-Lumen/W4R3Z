        def stable_regular(path: pathlib.Path, maximum: int, label: str) -> bytes:
            flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
            descriptor = os.open(path, flags)
            try:
                before = os.fstat(descriptor)
                require(stat.S_ISREG(before.st_mode), f"{label} must be a regular non-link file")
                require(before.st_size <= maximum, f"{label} exceeds {maximum} bytes")
                chunks = bytearray()
                while len(chunks) <= maximum:
                    chunk = os.read(descriptor, min(65536, maximum + 1 - len(chunks)))
                    if not chunk:
