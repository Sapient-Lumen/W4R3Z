        export PATH=${pkgs.nix}/bin:${pkgs.jq}/bin:$PATH
        export NIX_STATE_DIR="$TMPDIR/nix-state"
        mkdir -p "$NIX_STATE_DIR"
        ${pkgs.bash}/bin/bash -n "$out"
