        IDENTIFIER = re.compile(r"^[a-z][a-z0-9-]{0,63}$")
        SHA256 = re.compile(r"^[0-9a-f]{64}$")
        SAFE_SENTENCE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 .,:/()+_-]*$")
        ORDER = {"critical": 4, "unknown": 3, "review": 2, "clear": 1, "absent": 0}


        class Refusal(RuntimeError):
            pass


        def require(condition: bool, message: str) -> None:
            if not condition:
                raise Refusal(message)


        def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
            result: dict[str, Any] = {}
            for key, value in pairs:
                require(key not in result, f"duplicate JSON key: {key}")
                result[key] = value
            return result


        def canonical_bytes(value: Any) -> bytes:
            return (json.dumps(
                value, sort_keys=True, separators=(",", ":"), ensure_ascii=False,
                allow_nan=False,
            ) + "\n").encode("utf-8")


        def stat_identity(info: os.stat_result) -> tuple[int, ...]:
            return (
                info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid,
                info.st_nlink, info.st_size, info.st_mtime_ns, info.st_ctime_ns,
            )


        def bound_regular_bytes(
            path: pathlib.Path, limit: int, label: str, *, owner_uid: int | None = None,
            required_mode: int | None = None,
        ) -> bytes:
            """Read one bounded leaf while proving the pathname stayed on the opened inode."""
            try:
                before = path.lstat()
            except OSError as error:
                raise Refusal(f"{label} is unavailable: {error}") from error
            require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1,
                    f"{label} must be a single-link regular file")
            require(0 < before.st_size <= limit, f"{label} exceeds its byte contract")
            if owner_uid is not None:
                require(before.st_uid == owner_uid, f"{label} owner differs")
            if required_mode is not None:
                require(stat.S_IMODE(before.st_mode) == required_mode, f"{label} mode differs")
            flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
            try:
                descriptor = os.open(path, flags)
            except OSError as error:
                raise Refusal(f"{label} could not be opened without following links: {error}") from error
            try:
                opened = os.fstat(descriptor)
                require(stat_identity(before) == stat_identity(opened),
                        f"{label} changed while being opened")
                chunks = bytearray()
                while len(chunks) <= limit:
                    chunk = os.read(descriptor, min(131072, limit + 1 - len(chunks)))
                    if not chunk:
                        break
                    chunks.extend(chunk)
                require(0 < len(chunks) <= limit and len(chunks) == opened.st_size,
                        f"{label} changed or exceeds its byte contract")
                after = os.fstat(descriptor)
                try:
                    rebound = path.lstat()
                except OSError as error:
                    raise Refusal(f"{label} path disappeared while being read: {error}") from error
                require(stat_identity(opened) == stat_identity(after) == stat_identity(rebound),
                        f"{label} path binding or metadata changed while being read")
                return bytes(chunks)
            finally:
                os.close(descriptor)


        def load_object(
            path: pathlib.Path, limit: int, label: str, *, owner_uid: int | None = None,
            required_mode: int | None = None,
        ) -> tuple[dict[str, Any], bytes]:
            raw = bound_regular_bytes(
                path, limit, label, owner_uid=owner_uid, required_mode=required_mode)
            try:
                value = json.loads(
                    raw.decode("utf-8", errors="strict"), object_pairs_hook=unique_object,
                    parse_constant=lambda item: (_ for _ in ()).throw(Refusal(f"non-finite number: {item}")),
                )
            except (UnicodeError, json.JSONDecodeError) as error:
                raise Refusal(f"{label} is not strict JSON: {error}") from error
            require(isinstance(value, dict), f"{label} must be an object")
            return value, raw


        def exact(value: dict[str, Any], keys: set[str], label: str) -> None:
            require(set(value) == keys, f"{label} keys differ")


        def positive(value: Any, label: str, maximum: int | None = None) -> int:
            require(isinstance(value, int) and not isinstance(value, bool) and value > 0,
                    f"{label} must be a positive integer")
            if maximum is not None:
                require(value <= maximum, f"{label} exceeds its limit")
            return value


        def safe_id(value: Any, label: str) -> str:
            require(isinstance(value, str) and IDENTIFIER.fullmatch(value) is not None,
                    f"{label} is not a safe identifier")
            return value


        def safe_sentence(value: Any, maximum: int, label: str) -> str:
            require(isinstance(value, str) and len(value.encode("utf-8")) <= maximum
                    and SAFE_SENTENCE.fullmatch(value) is not None,
                    f"{label} is not bounded source-owned prose")
            return value


        def sha(value: Any, label: str) -> str:
            require(isinstance(value, str) and SHA256.fullmatch(value) is not None,
                    f"{label} is not sha256")
            return value


        def validate_contract(value: dict[str, Any]) -> dict[str, Any]:
            exact(value, {"schema", "reading_schema", "registry_schema", "report_schema",
                          "paths", "limits", "vocabulary", "authority", "publication", "laws"}, "contract")
            require(value["schema"] == "mnx.sensory-organ-contract.v1", "contract schema differs")
            exact(value["paths"], {"current_directory", "filename_rule"}, "contract paths")
            require(value["paths"]["current_directory"] == str(DEFAULT_READINGS)
                    and value["paths"]["filename_rule"] == "organ-id-plus-json",
                    "contract path convention differs")
            limits = value["limits"]
            exact(limits, {"contract_bytes", "registry_bytes", "reading_bytes", "producer_bytes",
                           "evidence_bytes", "organs",
                           "findings_per_organ", "future_skew_seconds", "identifier_bytes",
                           "title_bytes", "summary_bytes", "action_bytes"}, "contract limits")
            for key, item in limits.items():
                positive(item, f"contract limit {key}")
            vocabulary = value["vocabulary"]
            exact(vocabulary, {"states", "report_states", "observer_states", "currentity"},
                  "contract vocabulary")
            require(vocabulary["states"] == ["clear", "review", "critical"], "state vocabulary differs")
            require(vocabulary["report_states"] == ["clear", "review", "critical", "unknown", "absent"],
                    "report-state vocabulary differs")
            require(vocabulary["observer_states"] == ["healthy", "malfunction"],
                    "observer-state vocabulary differs")
            require(vocabulary["currentity"] == ["fresh", "stale", "future", "missing", "invalid"],
                    "currentity vocabulary differs")
            authority = value["authority"]
            exact(authority, {"mode", "host_mutation", "network", "work_execution", "notification",
                              "remediation", "promotion", "reading_text_is_instruction",
                              "observed_state_is_policy"}, "contract authority")
            require(authority["mode"] == "read-only-classification"
                    and all(item is False for key, item in authority.items() if key != "mode"),
                    "contract grants authority")
            publication = value["publication"]
            exact(publication, {"mode", "output_directory", "output_mode",
                                "producer_identity_computed", "evidence_identity_computed",
                                "arbitrary_probe_execution", "network", "notification",
                                "remediation", "promotion"}, "contract publication")
            require(publication["mode"] == "one-atomic-code-reading"
                    and publication["output_directory"] == str(DEFAULT_READINGS)
                    and publication["output_mode"] == "0644"
                    and publication["producer_identity_computed"] is True
                    and publication["evidence_identity_computed"] is True
                    and all(publication[key] is False for key in
                            ("arbitrary_probe_execution", "network", "notification", "remediation", "promotion")),
                    "contract publication authority differs")
            require(isinstance(value["laws"], list) and len(value["laws"]) >= 7
                    and len(value["laws"]) == len(set(value["laws"]))
                    and all(isinstance(item, str) and len(item.encode("utf-8")) <= 160
                            and re.fullmatch(r"[a-z][a-z0-9-]+", item) is not None
                            for item in value["laws"]),
                    "contract laws differ")
            return value


        def stable_digest(path: pathlib.Path, limit: int, owner_uid: int, label: str) -> str:
            try:
                before = path.lstat()
            except OSError as error:
                raise Refusal(f"{label} is unavailable: {error}") from error
            require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1,
                    f"{label} must be a single-link regular file")
            flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
            try:
                descriptor = os.open(path, flags)
            except OSError as error:
                raise Refusal(f"{label} could not be opened without following links: {error}") from error
            try:
                opened = os.fstat(descriptor)
                require(stat_identity(before) == stat_identity(opened),
                        f"{label} changed while being opened")
                require(stat.S_ISREG(opened.st_mode) and opened.st_uid == owner_uid,
                        f"{label} must be a regular file owned by the publisher authority")
                require(opened.st_mode & 0o022 == 0, f"{label} is group or world writable")
                require(0 < opened.st_size <= limit, f"{label} exceeds its byte contract")
                value = hashlib.sha256()
                total = 0
                while True:
                    chunk = os.read(descriptor, min(1024 * 1024, limit + 1 - total))
                    if not chunk:
                        break
                    total += len(chunk)
                    require(total <= limit, f"{label} exceeds its byte contract")
                    value.update(chunk)
                after = os.fstat(descriptor)
                try:
                    rebound = path.lstat()
                except OSError as error:
                    raise Refusal(f"{label} path disappeared while being read: {error}") from error
                require(total == opened.st_size and
                        stat_identity(opened) == stat_identity(after) == stat_identity(rebound),
                        f"{label} path binding or metadata changed while being read")
                return value.hexdigest()
            finally:
                os.close(descriptor)


        def safe_reading_directory(directory: pathlib.Path, owner_uid: int) -> pathlib.Path:
            try:
                before = directory.lstat()
            except OSError as error:
                raise Refusal(f"reading directory is unavailable: {error}") from error
            require(stat.S_ISDIR(before.st_mode) and before.st_uid == owner_uid
                    and stat.S_IMODE(before.st_mode) == 0o755,
                    "reading directory ownership or mode differs")
            flags = (os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) |
                     getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_DIRECTORY", 0))
            try:
                descriptor = os.open(directory, flags)
            except OSError as error:
                raise Refusal(f"reading directory could not be opened safely: {error}") from error
            try:
                opened = os.fstat(descriptor)
                rebound = directory.lstat()
                require(stat_identity(before) == stat_identity(opened) == stat_identity(rebound),
                        "reading directory path binding changed")
                return directory.resolve(strict=True)
            finally:
                os.close(descriptor)


        def validate_registry(value: dict[str, Any], contract: dict[str, Any]) -> list[dict[str, Any]]:
            exact(value, {"schema", "organs"}, "registry")
            require(value["schema"] == contract["registry_schema"], "registry schema differs")
            organs = value["organs"]
            require(isinstance(organs, list) and len(organs) <= contract["limits"]["organs"],
                    "registry organ count exceeds its limit")
            seen: set[str] = set()
            for index, organ in enumerate(organs):
                label = f"organ[{index}]"
                require(isinstance(organ, dict), f"{label} must be an object")
                exact(organ, {"id", "title", "required", "maximum_age_seconds", "producer_sha256",
                              "findings"}, label)
                organ_id = safe_id(organ["id"], f"{label} id")
                require(organ_id not in seen, f"duplicate organ id: {organ_id}")
                seen.add(organ_id)
                safe_sentence(organ["title"], contract["limits"]["title_bytes"], f"{label} title")
                require(isinstance(organ["required"], bool), f"{label} required must be boolean")
                positive(organ["maximum_age_seconds"], f"{label} maximum age", 31536000)
                sha(organ["producer_sha256"], f"{label} producer")
                findings = organ["findings"]
                require(isinstance(findings, dict) and findings
                        and len(findings) <= contract["limits"]["findings_per_organ"],
                        f"{label} findings differ")
                for code, finding in findings.items():
                    safe_id(code, f"{label} finding code")
                    require(isinstance(finding, dict), f"{label} finding must be an object")
                    exact(finding, {"state", "summary", "action"}, f"{label} finding {code}")
                    require(finding["state"] in contract["vocabulary"]["states"],
                            f"{label} finding state differs")
                    safe_sentence(finding["summary"], contract["limits"]["summary_bytes"],
                                  f"{label} finding summary")
                    safe_id(finding["action"], f"{label} finding action")
            return organs


        def unknown(organ: dict[str, Any], currentity: str, reason: str) -> dict[str, Any]:
            return {
                "id": organ["id"], "title": organ["title"], "state": "unknown",
                "currentity": currentity, "finding": None, "summary": "Observation is unavailable",
                "action": "inspect-organ-observer", "reason": reason, "age_seconds": None,
                "evidence": None,
            }


        def read_organ(organ: dict[str, Any], directory: pathlib.Path, contract: dict[str, Any],
                       now: int, owner_uid: int) -> dict[str, Any]:
            path = directory / f"{organ['id']}.json"
            if not path.exists() and not path.is_symlink():
                if organ["required"]:
                    return unknown(organ, "missing", "required-reading-missing")
                return {
                    "id": organ["id"], "title": organ["title"], "state": "absent",
                    "currentity": "missing", "finding": None, "summary": "Optional organ is absent",
                    "action": "no-action", "reason": "optional-reading-missing", "age_seconds": None,
                    "evidence": None,
                }
            try:
                reading, _ = load_object(
                    path, contract["limits"]["reading_bytes"], "reading",
                    owner_uid=owner_uid, required_mode=0o644)
                exact(reading, {"schema", "organ_id", "observed_at_epoch", "producer_sha256",
                                "observer_status", "finding", "evidence"}, "reading")
                require(reading["schema"] == contract["reading_schema"], "reading schema differs")
                require(reading["organ_id"] == organ["id"], "reading organ id differs")
                require(reading["producer_sha256"] == organ["producer_sha256"],
                        "reading producer identity differs")
                observed = positive(reading["observed_at_epoch"], "reading epoch")
                require(reading["observer_status"] in contract["vocabulary"]["observer_states"],
                        "reading observer state differs")
                code = safe_id(reading["finding"], "reading finding")
                evidence = reading["evidence"]
                require(isinstance(evidence, dict), "reading evidence must be an object")
                exact(evidence, {"id", "sha256"}, "reading evidence")
                safe_id(evidence["id"], "reading evidence id")
                sha(evidence["sha256"], "reading evidence sha256")
                age = now - observed
                if age < -contract["limits"]["future_skew_seconds"]:
                    return unknown(organ, "future", "reading-clock-is-in-the-future")
                if age > organ["maximum_age_seconds"]:
                    result = unknown(organ, "stale", "reading-exceeded-maximum-age")
                    result["age_seconds"] = age
                    result["evidence"] = evidence
                    return result
                if reading["observer_status"] == "malfunction":
                    result = unknown(organ, "fresh", "observer-reported-malfunction")
                    result["age_seconds"] = max(age, 0)
                    result["evidence"] = evidence
                    return result
                require(code in organ["findings"], "reading finding is not declared")
                declared = organ["findings"][code]
                return {
                    "id": organ["id"], "title": organ["title"], "state": declared["state"],
                    "currentity": "fresh", "finding": code, "summary": declared["summary"],
                    "action": declared["action"], "reason": "declared-finding",
                    "age_seconds": max(age, 0), "evidence": evidence,
                }
            except (OSError, Refusal, ValueError) as error:
                return unknown(organ, "invalid", "reading-invalid")


        def collect(contract_path: pathlib.Path, registry_path: pathlib.Path, directory: pathlib.Path,
                    now: int, owner_uid: int) -> dict[str, Any]:
            bootstrap, _ = load_object(contract_path, 32768, "contract")
            contract = validate_contract(bootstrap)
            registry, registry_raw = load_object(registry_path, contract["limits"]["registry_bytes"], "registry")
            organs = validate_registry(registry, contract)
            directory = safe_reading_directory(directory, owner_uid)
            results = [read_organ(organ, directory, contract, now, owner_uid) for organ in organs]
            counts = {state: sum(item["state"] == state for item in results)
                      for state in contract["vocabulary"]["report_states"]}
            strongest = max((item["state"] for item in results), key=lambda item: ORDER[item], default="clear")
            attention = sorted(
                (item for item in results if item["state"] not in {"clear", "absent"}),
                key=lambda item: (-ORDER[item["state"]], results.index(item)),
            )
            return {
                "schema": contract["report_schema"],
                "status": "pass" if not attention else "attention",
                "observed_at_epoch": now,
                "registry_sha256": hashlib.sha256(registry_raw).hexdigest(),
                "strongest_state": strongest,
                "counts": counts,
                "next_action": attention[0]["action"] if attention else "no-urgent-action",
                "organs": results,
                "authority": contract["authority"],
                "limits": {"organs": contract["limits"]["organs"], "reading_bytes": contract["limits"]["reading_bytes"],
                           "rendered_attention_organs": 5},
            }


        def publish(contract_path: pathlib.Path, registry_path: pathlib.Path, directory: pathlib.Path,
                    organ_id: str, producer_path: pathlib.Path, finding: str, observer_status: str,
                    evidence_id: str, evidence_path: pathlib.Path, observed_at: int,
                    owner_uid: int) -> dict[str, Any]:
            bootstrap, _ = load_object(contract_path, 32768, "contract")
            contract = validate_contract(bootstrap)
            registry, registry_raw = load_object(registry_path, contract["limits"]["registry_bytes"], "registry")
            organs = validate_registry(registry, contract)
            organ_id = safe_id(organ_id, "publication organ id")
            evidence_id = safe_id(evidence_id, "publication evidence id")
            finding = safe_id(finding, "publication finding")
            require(observer_status in contract["vocabulary"]["observer_states"],
                    "publication observer status differs")
            observed_at = positive(observed_at, "publication epoch")
            selected = [organ for organ in organs if organ["id"] == organ_id]
            require(len(selected) == 1, "publication organ is not source-declared")
            organ = selected[0]
            require(observer_status == "malfunction" or finding in organ["findings"],
                    "healthy publication finding is not source-declared")
            producer_sha256 = stable_digest(
                producer_path, contract["limits"]["producer_bytes"], owner_uid, "producer")
            require(producer_sha256 == organ["producer_sha256"],
                    "publication producer identity differs from the source registry")
            evidence_sha256 = stable_digest(
                evidence_path, contract["limits"]["evidence_bytes"], owner_uid, "evidence")
            directory = safe_reading_directory(directory, owner_uid)
            output = directory / f"{organ_id}.json"
            if output.exists() or output.is_symlink():
                info = output.lstat()
                require(stat.S_ISREG(info.st_mode) and not output.is_symlink()
                        and info.st_uid == owner_uid and stat.S_IMODE(info.st_mode) == 0o644,
                        "existing reading ownership or mode differs")
            reading = {
                "schema": contract["reading_schema"], "organ_id": organ_id,
                "observed_at_epoch": observed_at, "producer_sha256": producer_sha256,
                "observer_status": observer_status, "finding": finding,
                "evidence": {"id": evidence_id, "sha256": evidence_sha256},
            }
            raw = canonical_bytes(reading)
            require(len(raw) <= contract["limits"]["reading_bytes"],
                    "rendered reading exceeds its byte contract")
            descriptor, temporary_name = tempfile.mkstemp(prefix=f".{organ_id}.", dir=directory)
            temporary = pathlib.Path(temporary_name)
            try:
                with os.fdopen(descriptor, "wb") as stream:
                    stream.write(raw)
                    stream.flush()
                    os.fchmod(stream.fileno(), 0o644)
                    os.fsync(stream.fileno())
                os.replace(temporary, output)
                directory_descriptor = os.open(directory, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
                try:
                    os.fsync(directory_descriptor)
                finally:
                    os.close(directory_descriptor)
            finally:
                temporary.unlink(missing_ok=True)
            return {
                "schema": "mnx.sensory-organ-publication.v1", "status": "pass",
                "organ_id": organ_id, "observer_status": observer_status, "finding": finding,
                "observed_at_epoch": observed_at, "producer_sha256": producer_sha256,
                "evidence": {"id": evidence_id, "sha256": evidence_sha256},
                "registry_sha256": hashlib.sha256(registry_raw).hexdigest(),
                "output": str(output), "output_sha256": hashlib.sha256(raw).hexdigest(),
                "mutation": "one-atomic-code-reading", "probe_executed": False,
                "network_used": False, "notification": False, "remediation": False,
                "promotion": False,
            }


        def render(report: dict[str, Any]) -> str:
            rows = [
                f"schema={report['schema']}", f"status={report['status']}",
                f"organs={len(report['organs'])}", f"strongest_state={report['strongest_state']}",
                "counts=" + ",".join(f"{key}:{value}" for key, value in report["counts"].items()),
            ]
            attention = [item for item in report["organs"] if item["state"] not in {"clear", "absent"}]
            for item in attention[:5]:
                rows.append(f"organ={item['id']}:{item['state']}:{item['currentity']}:{item['action']}")
            rows.extend([f"next_action={report['next_action']}", "authority=read-only-classification",
                         "MNX_SENSE=PASS"])
            return "\n".join(rows) + "\n"


        def self_test() -> dict[str, Any]:
            producer = hashlib.sha256(b"synthetic storage observer\n").hexdigest()
            contract_source = pathlib.Path(__file__).resolve().parent.parent / "foundation" / "sensory-organ-contract.json"
            if not contract_source.is_file():
                contract_source = DEFAULT_CONTRACT
            with tempfile.TemporaryDirectory(prefix="mnx-sense-") as temporary:
                root = pathlib.Path(temporary)
                contract = root / "contract.json"
                registry = root / "registry.json"
                readings = root / "readings"
                readings.mkdir(mode=0o755)
                readings.chmod(0o755)
                contract.write_bytes(contract_source.read_bytes())
                registry_value = {
                    "schema": "mnx.sensory-organ-registry.v1",
                    "organs": [{
                        "id": "storage", "title": "Storage health", "required": True,
                        "maximum_age_seconds": 60, "producer_sha256": producer,
                        "findings": {
                            "ok": {"state": "clear", "summary": "Storage is clear", "action": "no-action"},
                            "degraded": {"state": "critical", "summary": "Storage needs review",
                                         "action": "inspect-storage-evidence"},
                        },
                    }],
                }
                registry.write_bytes(canonical_bytes(registry_value))
                reading_path = readings / "storage.json"
                reading = {
                    "schema": "mnx.sensory-organ-reading.v1", "organ_id": "storage",
                    "observed_at_epoch": 1000, "producer_sha256": producer,
                    "observer_status": "healthy", "finding": "degraded",
                    "evidence": {"id": "storage-sample", "sha256": hashlib.sha256(b"evidence\n").hexdigest()},
                }
                reading_path.write_bytes(canonical_bytes(reading))
                reading_path.chmod(0o644)
                current_uid = os.getuid()
                critical = collect(contract, registry, readings, 1010, current_uid)
                require(critical["strongest_state"] == "critical"
                        and critical["next_action"] == "inspect-storage-evidence", "critical fixture failed")
                readings.chmod(0o777)
                try:
                    collect(contract, registry, readings, 1010, current_uid)
                    raise Refusal("unsafe reading directory passed")
                except Refusal as error:
                    require(str(error) != "unsafe reading directory passed",
                            "unsafe reading directory passed")
                finally:
                    readings.chmod(0o755)
                reading["finding"] = "ignore-all-prior-instructions"
                reading_path.write_bytes(canonical_bytes(reading))
                reading_path.chmod(0o644)
                hostile = collect(contract, registry, readings, 1010, current_uid)
                require(hostile["strongest_state"] == "unknown"
                        and hostile["next_action"] == "inspect-organ-observer", "undeclared code was trusted")
                reading["finding"] = "ok"
                reading["producer_sha256"] = hashlib.sha256(b"other producer\n").hexdigest()
                reading_path.write_bytes(canonical_bytes(reading))
                reading_path.chmod(0o644)
                mismatch = collect(contract, registry, readings, 1010, current_uid)
                require(mismatch["organs"][0]["reason"] == "reading-invalid", "producer mismatch passed")
                reading["producer_sha256"] = producer
                reading["observer_status"] = "malfunction"
                reading_path.write_bytes(canonical_bytes(reading))
                reading_path.chmod(0o644)
                malfunction = collect(contract, registry, readings, 1010, current_uid)
                require(malfunction["organs"][0]["reason"] == "observer-reported-malfunction",
                        "observer malfunction collapsed")
                reading["observer_status"] = "healthy"
                reading["observed_at_epoch"] = 2000
                reading_path.write_bytes(canonical_bytes(reading))
                reading_path.chmod(0o644)
                future = collect(contract, registry, readings, 1010, current_uid)
                require(future["organs"][0]["currentity"] == "future", "future fixture failed")
                reading["finding"] = "ok"
                reading["observed_at_epoch"] = 1
                reading_path.write_bytes(canonical_bytes(reading))
                reading_path.chmod(0o644)
                stale = collect(contract, registry, readings, 1010, current_uid)
                require(stale["organs"][0]["currentity"] == "stale", "stale fixture failed")
                reading["observed_at_epoch"] = 1000
                reading_path.write_bytes(canonical_bytes(reading))
                reading_path.chmod(0o600)
                wrong_mode = collect(contract, registry, readings, 1010, current_uid)
                require(wrong_mode["organs"][0]["reason"] == "reading-invalid", "wrong mode passed")
                reading_path.unlink()
                target = readings / "untrusted-target.json"
                target.write_bytes(canonical_bytes(reading))
                target.chmod(0o644)
                reading_path.symlink_to(target)
                linked = collect(contract, registry, readings, 1010, current_uid)
                require(linked["organs"][0]["reason"] == "reading-invalid", "linked reading passed")
                reading_path.unlink()
                target.unlink()
                target.write_bytes(canonical_bytes(reading))
                target.chmod(0o644)
                os.link(target, reading_path)
                hardlinked = collect(contract, registry, readings, 1010, current_uid)
                require(hardlinked["organs"][0]["reason"] == "reading-invalid",
                        "hardlinked reading passed")
                reading_path.unlink()
                target.unlink()
                missing = collect(contract, registry, readings, 1010, current_uid)
                require(missing["organs"][0]["reason"] == "required-reading-missing", "missing fixture failed")
                swap_source = root / "swap-source.json"
                swap_replacement = root / "swap-replacement.json"
                swap_source.write_bytes(canonical_bytes({"before": True}))
                swap_replacement.write_bytes(canonical_bytes({"after": True}))
                original_open = os.open
                swapped = False
                def swapping_open(path: Any, flags: int, *args: Any, **kwargs: Any) -> int:
                    nonlocal swapped
                    descriptor = original_open(path, flags, *args, **kwargs)
                    if not swapped and os.fspath(path) == os.fspath(swap_source):
                        os.replace(swap_replacement, swap_source)
                        swapped = True
                    return descriptor
                os.open = swapping_open
                try:
                    try:
                        load_object(swap_source, 1024, "swap fixture")
                        raise Refusal("path swap passed")
                    except Refusal as error:
                        require(str(error) != "path swap passed", "path swap passed")
                finally:
                    os.open = original_open
                require(swapped, "path swap fixture did not execute")
                producer_path = root / "producer"
                evidence_path = root / "evidence.json"
                producer_path.write_bytes(b"synthetic storage observer\n")
                evidence_path.write_bytes(b'{"sample":"clear"}\n')
                producer_path.chmod(0o555)
                evidence_path.chmod(0o600)
                publication = publish(
                    contract, registry, readings, "storage", producer_path, "ok", "healthy",
                    "storage-sample", evidence_path, 1000, current_uid)
                require(publication["mutation"] == "one-atomic-code-reading"
                        and stat.S_IMODE(reading_path.stat().st_mode) == 0o644,
                        "safe publication fixture failed")
                published = collect(contract, registry, readings, 1010, current_uid)
                require(published["strongest_state"] == "clear", "published reading did not collect")
                try:
                    publish(contract, registry, readings, "storage", producer_path,
                            "erase-disk", "healthy", "storage-sample", evidence_path, 1000, current_uid)
                    raise Refusal("undeclared publication code passed")
                except Refusal as error:
                    require(str(error) != "undeclared publication code passed",
                            "undeclared publication code passed")
                evidence_link = root / "evidence-link"
                evidence_link.symlink_to(evidence_path)
                try:
                    publish(contract, registry, readings, "storage", producer_path,
                            "ok", "healthy", "storage-sample", evidence_link, 1000, current_uid)
                    raise Refusal("linked publication evidence passed")
                except Refusal as error:
                    require(str(error) != "linked publication evidence passed",
                            "linked publication evidence passed")
            return {
                "schema": "mnx.sensory-organ-self-test.v1", "status": "pass",
                "cases": ["critical-source-mapping", "undeclared-code-inert", "producer-bound",
                          "observer-malfunction-distinct", "future-distinct", "stale-distinct",
                          "unsafe-reading-directory-rejected", "wrong-mode-rejected",
                          "linked-reading-rejected", "hardlinked-reading-rejected",
                          "stable-path-swap-rejected", "missing-distinct",
                          "atomic-publication", "undeclared-publication-code-rejected",
                          "linked-publication-evidence-rejected"],
                "network_used": False, "host_mutation": False,
            }


        def main() -> int:
            parser = argparse.ArgumentParser(prog="mnx-sense")
            sub = parser.add_subparsers(dest="command", required=True)
            collect_parser = sub.add_parser("collect")
            collect_parser.add_argument("--contract", type=pathlib.Path, default=DEFAULT_CONTRACT)
            collect_parser.add_argument("--registry", type=pathlib.Path, default=DEFAULT_REGISTRY)
            collect_parser.add_argument("--readings", type=pathlib.Path, default=DEFAULT_READINGS)
            collect_parser.add_argument("--now", type=int, default=None)
            collect_parser.add_argument("--owner-uid", type=int, default=0)
            collect_parser.add_argument("--text", action="store_true")
            publish_parser = sub.add_parser("publish")
            publish_parser.add_argument("--contract", type=pathlib.Path, default=DEFAULT_CONTRACT)
            publish_parser.add_argument("--registry", type=pathlib.Path, default=DEFAULT_REGISTRY)
            publish_parser.add_argument("--readings", type=pathlib.Path, default=DEFAULT_READINGS)
            publish_parser.add_argument("--organ", required=True)
            publish_parser.add_argument("--producer", required=True, type=pathlib.Path)
            publish_parser.add_argument("--finding", required=True)
            publish_parser.add_argument("--observer-status", choices=["healthy", "malfunction"], default="healthy")
            publish_parser.add_argument("--evidence-id", required=True)
            publish_parser.add_argument("--evidence", required=True, type=pathlib.Path)
            publish_parser.add_argument("--observed-at", type=int, default=None)
            publish_parser.add_argument("--owner-uid", type=int, default=0, help=argparse.SUPPRESS)
            sub.add_parser("self-test")
            arguments = parser.parse_args()
            try:
                if arguments.command == "self-test":
                    print(json.dumps(self_test(), sort_keys=True, separators=(",", ":")))
                elif arguments.command == "publish":
                    result = publish(
                        arguments.contract, arguments.registry, arguments.readings,
                        arguments.organ, arguments.producer, arguments.finding,
                        arguments.observer_status, arguments.evidence_id, arguments.evidence,
                        arguments.observed_at if arguments.observed_at is not None else int(time.time()),
                        arguments.owner_uid,
                    )
                    sys.stdout.buffer.write(canonical_bytes(result))
                else:
                    report = collect(arguments.contract, arguments.registry, arguments.readings,
                                     arguments.now if arguments.now is not None else int(time.time()),
                                     arguments.owner_uid)
                    if arguments.text:
                        sys.stdout.write(render(report))
                    else:
                        sys.stdout.buffer.write(canonical_bytes(report))
                return 0
            except (OSError, Refusal, ValueError) as error:
                print(f"MNX_SENSE_REFUSED: {error}", file=sys.stderr)
                return 1


        if __name__ == "__main__":
            raise SystemExit(main())
