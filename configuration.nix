      text = ''
        #!/usr/bin/env python3
        """Bounded durable lineage for one candidate-owned scheduled job."""
        
        from __future__ import annotations
        
        import argparse
        import fcntl
        import hashlib
        import json
        import os
        import pathlib
        import re
        import stat
        import subprocess
        import sys
        import tempfile
        import time
        from typing import Any
        
        
        ROOT = pathlib.Path(__file__).resolve().parent.parent
        DEFAULT_CONTRACT = ROOT / "foundation/attempt-ledger.json"
        SHA256 = re.compile(r"^[0-9a-f]{64}$")
        SAFE = re.compile(r"^[A-Za-z0-9._:/@+,-]{1,512}$")
        INVOCATION = re.compile(r"^[0-9a-f]{32}$")
        DISPOSITIONS = (
            "policy-refused", "cancelled", "infrastructure-failed",
            "observer-or-harness-failed", "subject-failed", "timed-out",
            "completed-unverified", "verified",
        )
        ORPHAN_DISPOSITIONS = (
            "cancelled", "infrastructure-failed", "observer-or-harness-failed",
            "completed-unverified",
        )
        RECONCILIATION_AUTHORITY = {
            "ledger_mutation": False, "scheduler_mutation": False,
            "work_execution": False, "network": "none", "secrets": "none",
            "acceptance": False, "promotion": False, "publication": False,
            "remediation": False,
        }
        
        
        class Refusal(RuntimeError):
            pass
        
        
        def require(condition: bool, message: str) -> None:
            if not condition:
                raise Refusal(message)
        
        
        def canonical_bytes(value: Any) -> bytes:
            return (json.dumps(
                value, sort_keys=True, separators=(",", ":"), ensure_ascii=False,
                allow_nan=False,
            ) + "\n").encode("utf-8")
        
        
        def digest(raw: bytes) -> str:
            return hashlib.sha256(raw).hexdigest()
        
        
        def exact_keys(value: dict[str, Any], keys: set[str], label: str) -> None:
            require(set(value) == keys,
                    f"{label} fields differ: missing={sorted(keys - set(value))} "
                    f"extra={sorted(set(value) - keys)}")
        
        
        def strict_object(raw: bytes, label: str) -> dict[str, Any]:
            def pairs(rows: list[tuple[str, Any]]) -> dict[str, Any]:
                result: dict[str, Any] = {}
                for key, value in rows:
                    require(key not in result, f"{label} contains duplicate JSON key: {key}")
                    result[key] = value
                return result
        
            def constant(value: str) -> Any:
                raise Refusal(f"{label} contains non-finite number: {value}")
        
            try:
                value = json.loads(raw.decode("utf-8", errors="strict"),
                                   object_pairs_hook=pairs, parse_constant=constant)
            except (UnicodeDecodeError, json.JSONDecodeError) as error:
                raise Refusal(f"{label} is not strict JSON: {error}") from error
            require(isinstance(value, dict), f"{label} must be a JSON object")
            return value
        
        
        def stable_regular(path: pathlib.Path, maximum: int, label: str,
                           *, follow_final_link: bool = False) -> bytes:
            selected = path.resolve(strict=True) if follow_final_link else path
            flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
            descriptor = os.open(selected, flags)
            try:
                before = os.fstat(descriptor)
                require(stat.S_ISREG(before.st_mode), f"{label} must be a regular file")
                require(before.st_size <= maximum, f"{label} exceeds {maximum} bytes")
                raw = bytearray()
                while len(raw) <= maximum:
                    block = os.read(descriptor, min(65536, maximum + 1 - len(raw)))
                    if not block:
                        break
                    raw.extend(block)
                after = os.fstat(descriptor)
                require(len(raw) <= maximum and len(raw) == before.st_size,
                        f"{label} size changed while being read")
                require((before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) ==
                        (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns),
                        f"{label} changed while being read")
                return bytes(raw)
            finally:
                os.close(descriptor)
        
        
        def stable_virtual(path: pathlib.Path, maximum: int, label: str) -> bytes:
            flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
            descriptor = os.open(path, flags)
            try:
                before = os.fstat(descriptor)
                require(stat.S_ISREG(before.st_mode), f"{label} must be a regular virtual file")
                raw = bytearray()
                while len(raw) <= maximum:
                    block = os.read(descriptor, min(4096, maximum + 1 - len(raw)))
                    if not block:
                        break
                    raw.extend(block)
                after = os.fstat(descriptor)
                require(len(raw) <= maximum, f"{label} exceeds {maximum} bytes")
                require((before.st_dev, before.st_ino, before.st_mode) ==
                        (after.st_dev, after.st_ino, after.st_mode),
                        f"{label} identity changed while being read")
                return bytes(raw)
            finally:
                os.close(descriptor)
        
        
        def bounded_integer(value: Any, label: str, maximum: int = 2**63 - 1) -> int:
            require(isinstance(value, int) and not isinstance(value, bool) and
                    0 <= value <= maximum, f"invalid {label}")
            return value
        
        
        def safe(value: Any, label: str, maximum: int = 512) -> str:
            require(isinstance(value, str) and len(value.encode("utf-8")) <= maximum and
                    SAFE.fullmatch(value) is not None, f"invalid {label}")
            return value
        
        
        def load_contract(path: pathlib.Path) -> tuple[dict[str, Any], str]:
            raw = stable_regular(path, 16384, "attempt contract")
            value = strict_object(raw, "attempt contract")
            exact_keys(value, {"schema", "status", "job", "store", "systemd", "bounds",
                               "authority", "limitations"}, "attempt contract")
            require(value["schema"] == "mnx.scheduled-attempt-contract.v1" and
                    value["status"] == "candidate-owned-reference", "unsupported contract")
            job = value["job"]
            exact_keys(job, {"job_id", "service_unit", "timer_unit"}, "job contract")
            safe(job["job_id"], "job id")
            require(job["service_unit"] == "mnx-observe.service" and
                    job["timer_unit"] == "mnx-observe.timer", "job identity drifted")
            store = value["store"]
            exact_keys(store, {"path", "ledger_name", "directory_mode", "ledger_mode",
                               "lock_mode", "max_recent_attempts"}, "store contract")
            require(store == {
                "path": "/var/lib/monsternix/attempt-ledger", "ledger_name": "ledger.json",
                "directory_mode": 0o755, "ledger_mode": 0o644, "lock_mode": 0o600,
                "max_recent_attempts": 256,
            }, "attempt store policy drifted")
            systemd = value["systemd"]
            exact_keys(systemd, {"systemctl", "running_system", "embedded_configuration",
                                 "boot_id", "result_dispositions"}, "systemd contract")
            expected_map = {
                "success": "verified", "timeout": "timed-out",
                "exit-code": "observer-or-harness-failed",
                "signal": "observer-or-harness-failed",
                "core-dump": "observer-or-harness-failed",
                "watchdog": "observer-or-harness-failed",
                "oom-kill": "infrastructure-failed", "resources": "infrastructure-failed",
                "start-limit-hit": "infrastructure-failed",
                "protocol": "infrastructure-failed", "exec-condition": "policy-refused",
            }
            require(systemd["result_dispositions"] == expected_map,
                    "systemd disposition mapping drifted")
            bounds = value["bounds"]
            require(bounds == {
                "contract_bytes": 16384, "tool_bytes": 65536, "ledger_bytes": 524288,
                "systemctl_executable_bytes": 67108864, "systemctl_output_bytes": 4096,
                "systemctl_timeout_seconds": 3, "safe_text_bytes": 512,
            }, "attempt ledger bounds drifted")
            require(value["authority"] == {
                "writer": "filesystem-owner-only",
                "reader": "public-sanitized-machine-metadata",
                "mutation": "declared-ledger-only", "work_execution": False,
                "network": "none", "secrets": "none", "acceptance": False,
                "promotion": False, "publication": False, "remediation": False,
            }, "attempt ledger authority enlarged")
            require(isinstance(value["limitations"], list) and len(value["limitations"]) == 5,
                    "attempt ledger limitations drifted")
            return value, digest(raw)
        
        
        def record_body(record: dict[str, Any]) -> dict[str, Any]:
            return {key: value for key, value in record.items() if key != "record_sha256"}
        
        
        def validate_record(record: Any, job_id: str) -> None:
            require(isinstance(record, dict), "attempt record must be an object")
            exact_keys(record, {
                "schema", "job_id", "planned_slot_id", "attempt_id", "attempt_state",
                "disposition", "attempt_started_at_epoch", "attempt_finished_at_epoch",
                "exit_status", "source_sha256", "running_closure", "boot_id",
                "trigger_observation_sha256", "systemd_result", "record_sha256",
            }, "attempt record")
            require(record["schema"] == "mnx.scheduled-attempt.v1" and
                    record["job_id"] == job_id, "attempt record identity differs")
            safe(record["planned_slot_id"], "planned slot id")
            safe(record["attempt_id"], "attempt id")
            bounded_integer(record["attempt_started_at_epoch"], "attempt start")
            require(isinstance(record["source_sha256"], str) and
                    SHA256.fullmatch(record["source_sha256"]) is not None,
                    "invalid source digest")
            safe(record["running_closure"], "running closure")
            safe(record["boot_id"], "boot id")
            require(isinstance(record["trigger_observation_sha256"], str) and
                    SHA256.fullmatch(record["trigger_observation_sha256"]) is not None,
                    "invalid trigger observation digest")
            state = record["attempt_state"]
            require(state in {"running", "terminal"}, "invalid attempt state")
            if state == "running":
                require(record["disposition"] is None and
                        record["attempt_finished_at_epoch"] is None and
                        record["exit_status"] is None and record["systemd_result"] is None,
                        "running attempt contains terminal fields")
            else:
                require(record["disposition"] in DISPOSITIONS,
                        "invalid terminal disposition")
                finish = bounded_integer(record["attempt_finished_at_epoch"], "attempt finish")
                require(finish >= record["attempt_started_at_epoch"],
                        "attempt finished before it started")
                if record["exit_status"] is not None:
                    safe(record["exit_status"], "exit status")
                if record["systemd_result"] is not None:
                    safe(record["systemd_result"], "systemd result")
            require(record["record_sha256"] == digest(canonical_bytes(record_body(record))),
                    "attempt record seal differs")
        
        
        def empty_rollup() -> dict[str, Any]:
            return {
                "compacted_attempt_count": 0,
                "disposition_counts": {name: 0 for name in DISPOSITIONS},
                "chain_sha256": digest(b"mnx.scheduled-attempt-rollup.v1\n"),
                "through_finished_at_epoch": None,
                "last_verified_success_epoch": None,
            }
        
        
        def seal_ledger(value: dict[str, Any]) -> dict[str, Any]:
            body = {key: item for key, item in value.items() if key != "ledger_sha256"}
            return {**body, "ledger_sha256": digest(canonical_bytes(body))}
        
        
        def empty_ledger(contract_sha: str, job_id: str) -> dict[str, Any]:
            return seal_ledger({
                "schema": "mnx.scheduled-attempt-ledger.v1", "contract_sha256": contract_sha,
                "job_id": job_id, "generation": 0, "records": [], "rollup": empty_rollup(),
            })
        
        
        def validate_ledger(value: dict[str, Any], contract: dict[str, Any],
                            contract_sha: str) -> None:
            exact_keys(value, {"schema", "contract_sha256", "job_id", "generation",
                               "records", "rollup", "ledger_sha256"}, "attempt ledger")
            job_id = contract["job"]["job_id"]
            require(value["schema"] == "mnx.scheduled-attempt-ledger.v1" and
                    value["contract_sha256"] == contract_sha and value["job_id"] == job_id,
                    "attempt ledger identity differs")
            bounded_integer(value["generation"], "ledger generation")
            require(isinstance(value["records"], list) and
                    len(value["records"]) <= contract["store"]["max_recent_attempts"],
                    "recent attempt window is invalid")
            identities: set[str] = set()
            for record in value["records"]:
                validate_record(record, job_id)
                require(record["attempt_id"] not in identities, "duplicate attempt identity")
                identities.add(record["attempt_id"])
            rollup = value["rollup"]
            exact_keys(rollup, {"compacted_attempt_count", "disposition_counts",
                                "chain_sha256", "through_finished_at_epoch",
                                "last_verified_success_epoch"}, "attempt rollup")
            bounded_integer(rollup["compacted_attempt_count"], "compacted attempt count")
            require(set(rollup["disposition_counts"]) == set(DISPOSITIONS),
                    "rollup disposition inventory differs")
            for name in DISPOSITIONS:
                bounded_integer(rollup["disposition_counts"][name], f"{name} count")
            require(sum(rollup["disposition_counts"].values()) ==
                    rollup["compacted_attempt_count"], "rollup counts do not close")
            require(isinstance(rollup["chain_sha256"], str) and
                    SHA256.fullmatch(rollup["chain_sha256"]) is not None,
                    "invalid rollup chain digest")
            for name in ("through_finished_at_epoch", "last_verified_success_epoch"):
                if rollup[name] is not None:
                    bounded_integer(rollup[name], name)
            body = {key: item for key, item in value.items() if key != "ledger_sha256"}
            require(value["ledger_sha256"] == digest(canonical_bytes(body)),
                    "attempt ledger seal differs")
        
        
        def ensure_store(path: pathlib.Path, mode: int) -> None:
            require(path.is_absolute(), "attempt store must be absolute")
            if not path.exists():
                parent = path.parent
                parent_state = os.lstat(parent)
                require(stat.S_ISDIR(parent_state.st_mode) and not stat.S_ISLNK(parent_state.st_mode),
                        "attempt store parent is unsafe")
                os.mkdir(path, mode)
            state = os.lstat(path)
            require(stat.S_ISDIR(state.st_mode) and not stat.S_ISLNK(state.st_mode),
                    "attempt store must be an ordinary directory")
            require(state.st_uid == os.geteuid(), "attempt store writer does not own the store")
            require(stat.S_IMODE(state.st_mode) == mode, "attempt store mode differs")
        
        
        def ledger_path(contract: dict[str, Any], override: pathlib.Path | None) -> pathlib.Path:
            store = pathlib.Path(contract["store"]["path"]) if override is None else override
            return store / contract["store"]["ledger_name"]
        
        
        def read_ledger(path: pathlib.Path, contract: dict[str, Any], contract_sha: str,
                        *, absent_ok: bool) -> dict[str, Any]:
            if not path.exists():
                require(absent_ok, "attempt ledger is absent")
                return empty_ledger(contract_sha, contract["job"]["job_id"])
            raw = stable_regular(path, contract["bounds"]["ledger_bytes"], "attempt ledger")
            state = os.lstat(path)
            require(stat.S_IMODE(state.st_mode) == contract["store"]["ledger_mode"],
                    "attempt ledger mode differs")
            value = strict_object(raw, "attempt ledger")
            validate_ledger(value, contract, contract_sha)
            return value
        
        
        def write_atomic(path: pathlib.Path, raw: bytes, mode: int, maximum: int) -> None:
            require(len(raw) <= maximum, "attempt ledger exceeds its byte bound")
            descriptor, name = tempfile.mkstemp(prefix=".ledger.", dir=path.parent)
            temporary = pathlib.Path(name)
            try:
                os.fchmod(descriptor, mode)
                view = memoryview(raw)
                while view:
                    written = os.write(descriptor, view)
                    view = view[written:]
                os.fsync(descriptor)
                os.close(descriptor)
                descriptor = -1
                os.replace(temporary, path)
                directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
                try:
                    os.fsync(directory)
                finally:
                    os.close(directory)
            finally:
                if descriptor >= 0:
                    os.close(descriptor)
                temporary.unlink(missing_ok=True)
        
        
        def compact_one(ledger: dict[str, Any]) -> None:
            candidates = [record for record in ledger["records"]
                          if record["attempt_state"] == "terminal"]
            require(candidates, "recent attempt window is full of nonterminal attempts")
            selected = min(candidates, key=lambda item: (
                item["attempt_finished_at_epoch"], item["attempt_started_at_epoch"],
                item["attempt_id"],
            ))
            rollup = ledger["rollup"]
            rollup["compacted_attempt_count"] += 1
            rollup["disposition_counts"][selected["disposition"]] += 1
            rollup["chain_sha256"] = digest(
                bytes.fromhex(rollup["chain_sha256"]) + canonical_bytes(selected)
            )
            finished = selected["attempt_finished_at_epoch"]
            prior = rollup["through_finished_at_epoch"]
            rollup["through_finished_at_epoch"] = finished if prior is None else max(prior, finished)
            if selected["disposition"] == "verified":
                prior_success = rollup["last_verified_success_epoch"]
                rollup["last_verified_success_epoch"] = (
                    finished if prior_success is None else max(prior_success, finished)
                )
            ledger["records"].remove(selected)
        
        
        def mutate(contract: dict[str, Any], contract_sha: str, store_override: pathlib.Path | None,
                   operation: Any) -> dict[str, Any]:
            path = ledger_path(contract, store_override)
            ensure_store(path.parent, contract["store"]["directory_mode"])
            lock_path = path.parent / ".ledger.lock"
            flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
            lock = os.open(lock_path, flags, contract["store"]["lock_mode"])
            try:
                os.fchmod(lock, contract["store"]["lock_mode"])
                state = os.fstat(lock)
                require(state.st_uid == os.geteuid() and
                        stat.S_IMODE(state.st_mode) == contract["store"]["lock_mode"],
                        "attempt lock metadata differs")
                fcntl.flock(lock, fcntl.LOCK_EX)
                ledger = read_ledger(path, contract, contract_sha, absent_ok=True)
                changed = operation(ledger)
                if not changed:
                    return ledger
                ledger["generation"] += 1
                ledger = seal_ledger(ledger)
                validate_ledger(ledger, contract, contract_sha)
                write_atomic(path, canonical_bytes(ledger), contract["store"]["ledger_mode"],
                             contract["bounds"]["ledger_bytes"])
                return ledger
            finally:
                os.close(lock)
        
        
        def make_running(contract: dict[str, Any], planned_slot: str, attempt_id: str,
                         started: int, source_sha: str, running_closure: str, boot_id: str,
                         trigger_sha: str) -> dict[str, Any]:
            record = {
                "schema": "mnx.scheduled-attempt.v1", "job_id": contract["job"]["job_id"],
                "planned_slot_id": safe(planned_slot, "planned slot id"),
                "attempt_id": safe(attempt_id, "attempt id"), "attempt_state": "running",
                "disposition": None, "attempt_started_at_epoch": started,
                "attempt_finished_at_epoch": None, "exit_status": None,
                "source_sha256": source_sha, "running_closure": safe(running_closure, "running closure"),
                "boot_id": safe(boot_id, "boot id"),
                "trigger_observation_sha256": trigger_sha, "systemd_result": None,
            }
            require(SHA256.fullmatch(source_sha) is not None, "invalid source digest")
            require(SHA256.fullmatch(trigger_sha) is not None, "invalid trigger digest")
            record["record_sha256"] = digest(canonical_bytes(record))
            validate_record(record, contract["job"]["job_id"])
            return record
        
        
        def begin(contract: dict[str, Any], contract_sha: str, store: pathlib.Path | None,
                  record: dict[str, Any]) -> dict[str, Any]:
            selected: dict[str, Any] = {}
        
            def operation(ledger: dict[str, Any]) -> bool:
                nonlocal selected
                existing = next((item for item in ledger["records"]
                                 if item["attempt_id"] == record["attempt_id"]), None)
                if existing is not None:
                    require(existing == record, "attempt identity was reused with different bytes")
                    selected = existing
                    return False
                if len(ledger["records"]) >= contract["store"]["max_recent_attempts"]:
                    compact_one(ledger)
                ledger["records"].append(record)
                selected = record
                return True
        
            ledger = mutate(contract, contract_sha, store, operation)
            return {"schema": "mnx.scheduled-attempt-operation.v1", "status": "pass",
                    "operation": "begin", "record": selected,
                    "ledger_generation": ledger["generation"],
                    "ledger_sha256": ledger["ledger_sha256"]}
        
        
        def finish(contract: dict[str, Any], contract_sha: str, store: pathlib.Path | None,
                   attempt_id: str, disposition: str, finished: int, exit_status: str | None,
                   systemd_result: str | None) -> dict[str, Any]:
            require(disposition in DISPOSITIONS, "invalid terminal disposition")
            selected: dict[str, Any] = {}
        
            def operation(ledger: dict[str, Any]) -> bool:
                nonlocal selected
                index = next((offset for offset, item in enumerate(ledger["records"])
                              if item["attempt_id"] == attempt_id), None)
                require(index is not None, "attempt identity is absent")
                prior = ledger["records"][index]
                terminal = {**record_body(prior), "attempt_state": "terminal",
                            "disposition": disposition,
                            "attempt_finished_at_epoch": finished,
                            "exit_status": exit_status, "systemd_result": systemd_result}
                terminal["record_sha256"] = digest(canonical_bytes(terminal))
                validate_record(terminal, contract["job"]["job_id"])
                if prior["attempt_state"] == "terminal":
                    require(prior == terminal, "terminal attempt cannot be rewritten")
                    selected = terminal
                    return False
                else:
                    ledger["records"][index] = terminal
                selected = terminal
                return True
        
            ledger = mutate(contract, contract_sha, store, operation)
            return {"schema": "mnx.scheduled-attempt-operation.v1", "status": "pass",
                    "operation": "finish", "record": selected,
                    "ledger_generation": ledger["generation"],
                    "ledger_sha256": ledger["ledger_sha256"]}
        
        
        def bounded_systemctl(contract: dict[str, Any], invocation: str) -> tuple[str, str]:
            executable = pathlib.Path(contract["systemd"]["systemctl"])
            resolved = executable.resolve(strict=True)
            executable_sha = digest(stable_regular(
                resolved, contract["bounds"]["systemctl_executable_bytes"],
                "systemctl executable"))
            require(os.access(resolved, os.X_OK), "systemctl is not executable")
            command = [str(resolved), "show", contract["job"]["timer_unit"], "--no-pager",
                       "--property=LastTriggerUSec", "--value"]
            try:
                completed = subprocess.run(
                    command, stdin=subprocess.DEVNULL, capture_output=True,
                    timeout=contract["bounds"]["systemctl_timeout_seconds"], check=False,
                    env={"LC_ALL": "C", "LANG": "C", "SYSTEMD_COLORS": "0",
                         "SYSTEMD_PAGER": "cat", "PATH": "/usr/bin:/bin"},
                )
            except subprocess.TimeoutExpired as error:
                raise Refusal("timer trigger query timed out") from error
            output = completed.stdout + completed.stderr
            require(len(output) <= contract["bounds"]["systemctl_output_bytes"],
                    "timer trigger query exceeded its output bound")
            require(completed.returncode == 0, "timer trigger query failed")
            trigger = output.decode("utf-8", errors="strict").strip()
            require("\n" not in trigger and "\r" not in trigger,
                    "timer trigger identity is multiline")
            observation_sha = digest(canonical_bytes({
                "systemctl_sha256": executable_sha, "timer_unit": contract["job"]["timer_unit"],
                "last_trigger": trigger or None,
            }))
            planned = (
                "timer-" + digest(trigger.encode("utf-8"))[:24]
                if trigger else "manual-invocation-" + invocation[:24]
            )
            return planned, observation_sha
        
        
        def system_identity(contract: dict[str, Any]) -> tuple[str, str, str]:
            source = digest(stable_regular(
                pathlib.Path(contract["systemd"]["embedded_configuration"]),
                8 * 1024 * 1024, "embedded configuration", follow_final_link=True))
            running = str(pathlib.Path(contract["systemd"]["running_system"]).resolve(strict=True))
            boot = stable_virtual(pathlib.Path(contract["systemd"]["boot_id"]), 128,
                                  "boot id").decode("ascii", errors="strict").strip()
            return source, safe(running, "running closure"), safe(boot, "boot id")
        
        
        def last_verified(ledger: dict[str, Any]) -> int | None:
            values = [record["attempt_finished_at_epoch"] for record in ledger["records"]
                      if record["attempt_state"] == "terminal" and
                      record["disposition"] == "verified"]
            rolled = ledger["rollup"]["last_verified_success_epoch"]
            if rolled is not None:
                values.append(rolled)
            return max(values) if values else None
        
        
        def summary(ledger: dict[str, Any]) -> dict[str, Any]:
            latest = max(ledger["records"], key=lambda item: (
                item["attempt_started_at_epoch"], item["attempt_id"]), default=None)
            return {
                "schema": "mnx.scheduled-attempt-summary.v1", "status": "pass",
                "job_id": ledger["job_id"], "generation": ledger["generation"],
                "recent_attempt_count": len(ledger["records"]),
                "compacted_attempt_count": ledger["rollup"]["compacted_attempt_count"],
                "last_verified_success_epoch": last_verified(ledger), "latest_attempt": latest,
                "rollup": ledger["rollup"], "ledger_sha256": ledger["ledger_sha256"],
            }
        def load_sidecar(path: pathlib.Path, label: str, maximum: int = 262144) -> tuple[dict[str, Any], bytes]:
            raw = stable_regular(path, maximum, label)
            return strict_object(raw, label), raw
        def reconcile_attempts(ledger: dict[str, Any], plan_path: pathlib.Path,
                               evidence_path: pathlib.Path, now: int) -> dict[str, Any]:
            plan, plan_raw = load_sidecar(plan_path, "scheduled-slot plan")
            evidence, evidence_raw = load_sidecar(evidence_path, "orphan evidence")
            exact_keys(plan, {"schema", "status", "job_id", "window", "slots"},
                       "scheduled-slot plan")
            require(plan["schema"] == "mnx.scheduled-slot-plan.v1" and
                    plan["status"] == "reviewed" and plan["job_id"] == ledger["job_id"],
                    "scheduled-slot plan identity differs")
            window = plan["window"]
            exact_keys(window, {"start_epoch", "end_epoch"}, "scheduled-slot window")
            start = bounded_integer(window["start_epoch"], "slot window start")
            end = bounded_integer(window["end_epoch"], "slot window end")
            require(start <= end <= now, "scheduled-slot window is not closed at observation time")
            through = ledger["rollup"]["through_finished_at_epoch"]
            require(through is None or start > through,
                    "scheduled-slot window overlaps compacted history")
            slots = plan["slots"]
            require(isinstance(slots, list) and 0 < len(slots) <= 4096,
                    "scheduled-slot inventory is invalid")
            slot_ids: set[str] = set()
            prior_epoch: int | None = None
            for index, item in enumerate(slots):
                require(isinstance(item, dict), f"slot {index} must be an object")
                exact_keys(item, {"slot_id", "scheduled_at_epoch"}, f"slot {index}")
                slot_id = safe(item["slot_id"], "slot id")
                epoch = bounded_integer(item["scheduled_at_epoch"], "slot epoch")
                require(slot_id not in slot_ids and start <= epoch <= end,
                        "slot identity is duplicated or outside its window")
                require(prior_epoch is None or epoch > prior_epoch,
                        "scheduled slots must be strictly chronological")
                slot_ids.add(slot_id)
                prior_epoch = epoch
            exact_keys(evidence, {"schema", "status", "job_id", "observed_at_epoch", "orphans"},
                       "orphan evidence")
            observed_at = bounded_integer(evidence["observed_at_epoch"], "evidence observation")
            require(evidence["schema"] == "mnx.orphan-attempt-evidence.v1" and
                    evidence["status"] == "reviewed-bounded-observation" and
                    evidence["job_id"] == ledger["job_id"] and end <= observed_at <= now and
                    now - observed_at <= 604800, "orphan evidence identity or currentity differs")
            orphans = evidence["orphans"]
            require(isinstance(orphans, list) and len(orphans) <= 256,
                    "orphan evidence inventory is invalid")
            records = {item["attempt_id"]: item for item in ledger["records"]}
            seen_orphans: set[str] = set()
            reconciled: list[dict[str, Any]] = []
            for index, item in enumerate(orphans):
                require(isinstance(item, dict), f"orphan evidence {index} must be an object")
                exact_keys(item, {"attempt_id", "original_record_sha256", "observation_kind",
                                  "observed_boot_id", "disposition", "reason_code"},
                           f"orphan evidence {index}")
                attempt_id = safe(item["attempt_id"], "orphan attempt id")
                require(attempt_id not in seen_orphans and attempt_id in records,
                        "orphan evidence identity is duplicated or absent")
                original = records[attempt_id]
                require(original["attempt_state"] == "running" and
                        item["original_record_sha256"] == original["record_sha256"],
                        "orphan evidence does not bind one running begin")
                require(item["observation_kind"] in {"boot-retired", "service-inactive"},
                        "orphan observation kind is unsupported")
                observed_boot = safe(item["observed_boot_id"], "observed boot id")
                if item["observation_kind"] == "boot-retired":
                    require(observed_boot != original["boot_id"],
                            "boot-retired evidence names the original boot")
                require(item["disposition"] in ORPHAN_DISPOSITIONS,
                        "orphan disposition is not conservative")
                reason = safe(item["reason_code"], "orphan reason code")
                seen_orphans.add(attempt_id)
                reconciled.append({
                    "attempt_id": attempt_id,
                    "original_record_sha256": original["record_sha256"],
                    "original_attempt_state": "running",
                    "reconciled_disposition": item["disposition"],
                    "observation_kind": item["observation_kind"],
                    "observed_boot_id": observed_boot,
                    "reason_code": reason,
                })
            reconciled.sort(key=lambda item: item["attempt_id"])
            by_slot: dict[str, list[dict[str, Any]]] = {}
            for record in ledger["records"]:
                by_slot.setdefault(record["planned_slot_id"], []).append(record)
            accounting = []
            for item in slots:
                attempts = sorted(by_slot.get(item["slot_id"], []), key=lambda row: row["attempt_id"])
                accounting.append({
                    "slot_id": item["slot_id"],
                    "scheduled_at_epoch": item["scheduled_at_epoch"],
                    "accounting": "attempted" if attempts else "not-started",
                    "attempt_ids": [row["attempt_id"] for row in attempts],
                })
            body = {
                "schema": "mnx.scheduled-attempt-reconciliation.v1", "status": "pass",
                "job_id": ledger["job_id"], "observed_at_epoch": observed_at,
                "ledger_sha256": ledger["ledger_sha256"],
                "slot_plan_sha256": digest(plan_raw), "orphan_evidence_sha256": digest(evidence_raw),
                "slot_accounting": accounting,
                "planned_slot_count": len(accounting),
                "attempted_slot_count": sum(row["accounting"] == "attempted" for row in accounting),
                "not_started_slot_count": sum(row["accounting"] == "not-started" for row in accounting),
                "orphan_resolutions": reconciled,
                "unreconciled_running_attempt_ids": sorted(
                    item["attempt_id"] for item in ledger["records"]
                    if item["attempt_state"] == "running" and item["attempt_id"] not in seen_orphans
                ),
                "original_records_mutated": False, "authority": RECONCILIATION_AUTHORITY,
            }
            return {**body, "receipt_sha256": digest(canonical_bytes(body))}
        def validate_reconciliation(value: dict[str, Any]) -> None:
            exact_keys(value, {"schema", "status", "job_id", "observed_at_epoch",
                               "ledger_sha256", "slot_plan_sha256", "orphan_evidence_sha256",
                               "slot_accounting", "planned_slot_count", "attempted_slot_count",
                               "not_started_slot_count", "orphan_resolutions",
                               "unreconciled_running_attempt_ids", "original_records_mutated",
                               "authority", "receipt_sha256"}, "reconciliation receipt")
            body = {key: item for key, item in value.items() if key != "receipt_sha256"}
            require(value["schema"] == "mnx.scheduled-attempt-reconciliation.v1" and
                    value["status"] == "pass" and value["authority"] == RECONCILIATION_AUTHORITY and
                    value["original_records_mutated"] is False and
                    value["receipt_sha256"] == digest(canonical_bytes(body)),
                    "reconciliation receipt identity or seal differs")
            require(value["planned_slot_count"] == len(value["slot_accounting"]) and
                    value["planned_slot_count"] == value["attempted_slot_count"] +
                    value["not_started_slot_count"], "reconciliation counts do not close")
        def render(value: Any) -> None:
            json.dump(value, sys.stdout, sort_keys=True, indent=2, allow_nan=False)
            sys.stdout.write("\n")
        
        
        def main() -> int:
            parser = argparse.ArgumentParser(prog="mnx-attempt-ledger")
            parser.add_argument("--contract", type=pathlib.Path, default=DEFAULT_CONTRACT)
            parser.add_argument("--store", type=pathlib.Path,
                                help="explicit test or adapter store; production uses the contract path")
            commands = parser.add_subparsers(dest="command", required=True)
            commands.add_parser("describe")
            begin_parser = commands.add_parser("begin")
            for name in ("planned-slot", "attempt-id", "source-sha256", "running-closure",
                         "boot-id", "trigger-observation-sha256"):
                begin_parser.add_argument("--" + name, required=True)
            begin_parser.add_argument("--started", type=int, required=True)
            finish_parser = commands.add_parser("finish")
            finish_parser.add_argument("--attempt-id", required=True)
            finish_parser.add_argument("--disposition", choices=DISPOSITIONS, required=True)
            finish_parser.add_argument("--finished", type=int, required=True)
            finish_parser.add_argument("--exit-status")
            finish_parser.add_argument("--systemd-result")
            commands.add_parser("begin-systemd")
            commands.add_parser("finish-systemd")
            commands.add_parser("show")
            commands.add_parser("verify")
            reconcile_parser = commands.add_parser("reconcile")
            reconcile_parser.add_argument("--plan", type=pathlib.Path, required=True)
            reconcile_parser.add_argument("--evidence", type=pathlib.Path, required=True)
            reconcile_parser.add_argument("--now", type=int, required=True)
            verify_reconciliation_parser = commands.add_parser("verify-reconciliation")
            verify_reconciliation_parser.add_argument("receipt", type=pathlib.Path)
            arguments = parser.parse_args()
            try:
                contract, contract_sha = load_contract(arguments.contract)
                path = ledger_path(contract, arguments.store)
                if arguments.command == "describe":
                    result = {**contract, "contract_sha256": contract_sha}
                elif arguments.command == "begin":
                    record = make_running(
                        contract, arguments.planned_slot, arguments.attempt_id,
                        bounded_integer(arguments.started, "attempt start"),
                        arguments.source_sha256, arguments.running_closure, arguments.boot_id,
                        arguments.trigger_observation_sha256,
                    )
                    result = begin(contract, contract_sha, arguments.store, record)
                elif arguments.command == "finish":
                    result = finish(
                        contract, contract_sha, arguments.store,
                        safe(arguments.attempt_id, "attempt id"), arguments.disposition,
                        bounded_integer(arguments.finished, "attempt finish"),
                        safe(arguments.exit_status, "exit status") if arguments.exit_status else None,
                        safe(arguments.systemd_result, "systemd result")
                        if arguments.systemd_result else None,
                    )
                elif arguments.command == "begin-systemd":
                    invocation = os.environ.get("INVOCATION_ID", "")
                    require(INVOCATION.fullmatch(invocation) is not None,
                            "systemd invocation identity is absent")
                    planned, trigger_sha = bounded_systemctl(contract, invocation)
                    source, running, boot = system_identity(contract)
                    result = begin(contract, contract_sha, arguments.store, make_running(
                        contract, planned, "invocation-" + invocation, int(time.time()),
                        source, running, boot, trigger_sha,
                    ))
                elif arguments.command == "finish-systemd":
                    invocation = os.environ.get("INVOCATION_ID", "")
                    require(INVOCATION.fullmatch(invocation) is not None,
                            "systemd invocation identity is absent")
                    systemd_result = os.environ.get("SERVICE_RESULT", "")
                    disposition = contract["systemd"]["result_dispositions"].get(
                        systemd_result, "completed-unverified")
                    exit_code = os.environ.get("EXIT_CODE", "")
                    exit_status = os.environ.get("EXIT_STATUS", "")
                    status = ":".join(item for item in (exit_code, exit_status) if item) or None
                    result = finish(contract, contract_sha, arguments.store,
                                    "invocation-" + invocation, disposition, int(time.time()),
                                    safe(status, "exit status") if status else None,
                                    safe(systemd_result, "systemd result") if systemd_result else None)
                elif arguments.command == "show":
                    ledger = read_ledger(path, contract, contract_sha, absent_ok=False)
                    result = summary(ledger)
                elif arguments.command == "reconcile":
                    ledger = read_ledger(path, contract, contract_sha, absent_ok=False)
                    result = reconcile_attempts(
                        ledger, arguments.plan, arguments.evidence,
                        bounded_integer(arguments.now, "reconciliation observation time"),
                    )
                elif arguments.command == "verify-reconciliation":
                    receipt, _ = load_sidecar(arguments.receipt, "reconciliation receipt")
                    validate_reconciliation(receipt)
                    result = {
                        "schema": "mnx.scheduled-attempt-reconciliation-verification.v1",
                        "status": "pass", "receipt_sha256": receipt["receipt_sha256"],
                        "ledger_sha256": receipt["ledger_sha256"],
                        "planned_slot_count": receipt["planned_slot_count"],
                        "not_started_slot_count": receipt["not_started_slot_count"],
                        "authority": RECONCILIATION_AUTHORITY,
                    }
                else:
                    ledger = read_ledger(path, contract, contract_sha, absent_ok=False)
                    result = {
                        "schema": "mnx.scheduled-attempt-verification.v1", "status": "pass",
                        "ledger_sha256": ledger["ledger_sha256"],
                        "generation": ledger["generation"],
                        "recent_attempt_count": len(ledger["records"]),
                        "compacted_attempt_count": ledger["rollup"]["compacted_attempt_count"],
                        "last_verified_success_epoch": last_verified(ledger),
                        "authority": contract["authority"],
                    }
                render(result)
                return 0
            except (OSError, UnicodeError, ValueError, Refusal, subprocess.SubprocessError) as error:
                print(f"MNX_ATTEMPT_LEDGER_REFUSED: {error}", file=sys.stderr)
                return 1
        
        
        if __name__ == "__main__":
            raise SystemExit(main())
      '';
      # MNX-MEASUREMENT-EMBED-END id=attempt-ledger
      checkPhase = ''
