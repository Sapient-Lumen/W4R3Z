        set +p
        set -Eeuo pipefail
        export LC_ALL=C
        supervisor='${monsternixSource}'
        candidate="''${MNX_CONFIG:-/etc/nixos/configuration.nix}"
        if [[ "''${1:-}" == --config ]]; then
          [[ $# -ge 2 ]] || { echo '--config requires a source path' >&2; exit 64; }
          candidate="$2"
          shift 2
        elif [[ "''${1:-}" == test || "''${1:-}" == switch || "''${1:-}" == office ]]; then
          candidate_index=2
          while (( candidate_index <= $# )); do
            candidate_argument="''${!candidate_index}"
            if [[ "$candidate_argument" == --config ]]; then
              candidate_index=$((candidate_index + 1))
              (( candidate_index <= $# )) || { echo '--config requires a source path' >&2; exit 64; }
              candidate="''${!candidate_index}"
              break
            fi
            candidate_index=$((candidate_index + 1))
          done
        fi
        [[ -r "$candidate" ]] || { echo "candidate is unreadable: $candidate" >&2; exit 66; }
        [[ -r "$supervisor" ]] || { echo "embedded supervisor is unreadable: $supervisor" >&2; exit 66; }
        begin_count="$(${pkgs.gnugrep}/bin/grep -Fxc '#@MNX-BASH-BEGIN' "$supervisor" 2>/dev/null || true)"
        end_count="$(${pkgs.gnugrep}/bin/grep -Fxc '#@MNX-BASH-END' "$supervisor" 2>/dev/null || true)"
        [[ "$begin_count" == 1 && "$end_count" == 1 ]] || {
          echo 'candidate-owned MNX Bash payload is absent or ambiguous' >&2
          exit 65
        }
        payload="$(${pkgs.gnused}/bin/sed -n '/^#@MNX-BASH-BEGIN$/,/^#@MNX-BASH-END$/p' "$supervisor" |
          ${pkgs.gnused}/bin/sed -E -e '1d' -e '$d' -e 's/^#@MNX-BASH ?//')"
        [[ -n "$payload" ]] || { echo 'candidate-owned MNX Bash payload is empty' >&2; exit 65; }
        export MNX_CONFIG="$candidate"
        exec ${pkgs.bash}/bin/bash -p -s -- "$@" <<<"$payload"
      '';
