                             "commands": ["export", "verify", "open", "close", "review", "materialize"],
                             "authority": {"network": False, "payload_execution": False, "host_activation": False}}
                elif args.command == "export":
                    value = command_export(args)
                elif args.command == "verify":
                    value = command_verify(args)
                elif args.command == "open":
                    value = command_open(args)
                elif args.command == "close":
                    value = command_close(args)
                elif args.command == "review":
                    value = command_review(args)
                elif args.command == "materialize":
                    value = command_materialize(args)
                else:
                    raise Refusal("unknown command")
                if args.json:
                    json.dump(value, sys.stdout, sort_keys=True, indent=2)
                    sys.stdout.write("\n")
                else:
                    for key, item in value.items():
                        print(f"{key}={json.dumps(item, sort_keys=True) if isinstance(item, (dict, list)) else item}")
                return 0
            except (Refusal, OSError, UnicodeError, json.JSONDecodeError, tarfile.TarError,
                    subprocess.SubprocessError) as error:
                print(f"MNX_CLOUDTAINER_REFUSED: {error}", file=sys.stderr)
                return 1


        if __name__ == "__main__":
            raise SystemExit(main())
      '';
      # MNX-CLOUDTAINER-EMBED-END id=cloudtainer-product
    };
  };

