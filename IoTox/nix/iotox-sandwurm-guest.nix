                destination_corrupt_stable_samples=1
              fi
              (( destination_corrupt_stable_samples >= 10 )) && break
              agent_is_running "$agent_pid"
              sleep 0.1
            done
            (( destination_corrupt_stable_samples >= 10 ))
            sync_tree_destination_corrupt_position_bytes="''${destination_corrupt_stable_position}"
            (( sync_tree_destination_corrupt_position_bytes > 0 ))
            (( sync_tree_destination_corrupt_position_bytes < \
