                    printf 'samples=%s\n' "$sync_range_restart_samples"
                    printf 'job=%s\n' "$sync_pull_job_id"
                    printf 'bundle-bytes=%s\n' \
                      "$sync_range_restart_bundle"
                    printf 'receive-position=%s\n' \
                      "$sync_range_restart_ready_position"
                    printf 'carrier-receive-position=%s\n' \
                      "$sync_range_restart_carrier_position"
                    printf 'status-sha256=%s\n' \
                      "$(printf '%s' "$sync_range_restart_ready_line" | \
                        sha256sum | cut -d' ' -f1)"
                    printf 'file-observed=%s\n' \
                      "$([[ -n "$sync_range_restart_file_line" ]] && \
                          printf 1 || printf 0)"
                  } >"$rendezvous_dir/client.sync-range-restart-progress.tmp"
                  mv "$rendezvous_dir/client.sync-range-restart-progress.tmp" \
                    "$rendezvous_dir/client.sync-range-restart-progress"
                fi
                if grep -q ' range-lane-active=1 ' \
                     <<<" $sync_range_restart_ready_line " && \
                   [[ "$sync_range_restart_bundle" == 1048576 ]] && \
                   [[ "$sync_range_restart_ready_position" =~ \
                      ^[1-9][0-9]*$ ]] && \
                   (( sync_range_restart_ready_position >= 262144 && \
                      sync_range_restart_ready_position < \
                        sync_range_restart_bundle )) && \
                   [[ -n "$sync_range_restart_file_line" ]]; then
                  break
                fi
                if grep -Eq ' state=(complete|failed) ' \
                     <<<" $sync_range_restart_ready_line "; then
                  printf '%s\n' "$sync_range_restart_ready_line" >&2
                  exit 1
                fi
                agent_is_running "$agent_pid"
                sleep 0.05
              done
              sync_range_restart_first_attempt_id="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^range-attempt=/) {
                  sub(/^range-attempt=/,"",$i); print $i; exit
                }
              }' <<<"$sync_range_restart_ready_line")"
              sync_range_restart_first_message_id="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^range-message=/) {
                  sub(/^range-message=/,"",$i); print $i; exit
                }
              }' <<<"$sync_range_restart_ready_line")"
              sync_range_restart_first_file_id="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^file-id=/) {
                  sub(/^file-id=/,"",$i); print tolower($i); exit
                }
              }' <<<"$sync_range_restart_file_line")"
              [[ "$sync_range_restart_first_attempt_id" =~ ^[1-9][0-9]*$ ]]
              [[ "$sync_range_restart_first_message_id" =~ ^[1-9][0-9]*$ ]]
              [[ "$sync_range_restart_first_file_id" =~ ^[0-9a-f]{64}$ ]]
              sync_range_restart_predecessor_accepted_sha256="$(sha256sum \
                "$sync_root/accepted-heads/sandwurm-file.accepted-head" | \
                cut -d' ' -f1)"
              sync_range_restart_predecessor_activation_sha256="$(sha256sum \
                "$sync_root/activated-revisions/sandwurm-file.activated-revision" | \
                cut -d' ' -f1)"
              {
                printf 'schema=iotox-sync-range-restart-ready-v1\n'
                printf 'job=%s\n' "$sync_range_restart_first_job_id"
                printf 'attempt=%s\n' "$sync_range_restart_first_attempt_id"
                printf 'message=%s\n' "$sync_range_restart_first_message_id"
                printf 'file-id=%s\n' "$sync_range_restart_first_file_id"
                printf 'position-bytes=%s\n' \
