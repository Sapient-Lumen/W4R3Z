                }
              }' <<<"$sync_range_status_line")"
              sync_tree_route_loss_retention_fallbacks="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ \
                    /^range-retention-fallbacks=/) {
                  sub(/^range-retention-fallbacks=/,"",$i); print $i; exit
                }
