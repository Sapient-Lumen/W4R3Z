              quota_status="$(iotox --runtime "$runtime" sync-status \
                2>/dev/null || true)"
              quota_line="$(awk -v job="$quota_job" \
                '$1 == "job=" job { print; exit }' <<<"$quota_status")"
              if grep -q ' state=failed ' <<<"$quota_line"; then
                break
              fi
              if grep -Eq ' state=(complete|cancelled) ' <<<"$quota_line"; then
                printf '%s\n' "$quota_line" >&2
