                  mv "$rendezvous_dir/client.sync-range-loss-progress.tmp" \
                    "$rendezvous_dir/client.sync-range-loss-progress"
                fi
                if [[ "$qualification_fault" == 1 ]] && \
                   [[ "$qualification_fault_count" == \
                     "$expected_range_faults" ]] && \
                   [[ "$range_loss_reassignments" == \
                     "$expected_range_faults" ]] && \
                   [[ "$current_attempt" =~ ^[1-9][0-9]*$ ]] && \
                   [[ -n "$range_loss_initial_attempt" ]] && \
                   [[ "$current_attempt" != "$range_loss_initial_attempt" ]] && \
                   [[ "$current_carrier" =~ ^[0-9A-F]{64}$ ]] && \
                   $range_loss_topology_matches; then
                  range_loss_final_attempt="$current_attempt"
                  sync_tree_route_loss_final_carrier="$current_carrier"
                  break
                fi
                if grep -q ' state=failed ' <<<" $range_loss_job "; then
                  printf '%s\n' "$range_loss_job" >&2
                  exit 1
                fi
                agent_is_running "$agent_pid"
                sleep 0.05
              done
              [[ "$range_loss_initial_attempt" =~ ^[1-9][0-9]*$ ]]
              [[ "$range_loss_final_attempt" =~ ^[1-9][0-9]*$ ]]
              [[ "$range_loss_final_attempt" != \
                "$range_loss_initial_attempt" ]]
              if $sync_range_repeated_route_loss_scenario; then
                if $sync_range_triple_route_loss_scenario; then
                  [[ "$sync_tree_route_loss_final_carrier" != \
                    "$sync_tree_route_loss_stopped_carrier" ]]
                else
                  [[ "$sync_tree_route_loss_final_carrier" == \
                    "$sync_tree_route_loss_stopped_carrier" ]]
                fi
              else
                [[ "$sync_tree_route_loss_final_carrier" != \
                  "$sync_tree_route_loss_stopped_carrier" ]]
              fi
            fi
            if $sync_range_actual_i2p_loss_scenario; then
              actual_i2p_loss_status=
              actual_i2p_loss_job=
              actual_i2p_loss_carrier=
              actual_i2p_loss_worker=
              actual_i2p_range_lane_active=
              actual_i2p_range_bundle_bytes=
              while (( SECONDS < deadline )); do
                actual_i2p_loss_status="$(iotox --runtime "$runtime" \
                  sync-status 2>/dev/null || true)"
                actual_i2p_loss_job="$(awk -v job="$sync_pull_job_id" \
                  '$1 == "job=" job { print; exit }' \
                  <<<"$actual_i2p_loss_status")"
                actual_i2p_loss_carrier="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^carrier-route=/) {
                    sub(/^carrier-route=/,"",$i); print $i; exit
                  }
                }' <<<"$actual_i2p_loss_job")"
                actual_i2p_loss_worker="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^carrier-worker=/) {
                    sub(/^carrier-worker=/,"",$i); print $i; exit
                  }
                }' <<<"$actual_i2p_loss_job")"
                actual_i2p_fail_closed_loss_position_bytes="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ \
