              }' <<<"$sync_range_fault_line")"
              [[ "$sync_range_fault_file_number" =~ ^[0-9]+$ ]]
              [[ "$sync_range_retry_first_file_id" =~ ^[0-9a-f]{64}$ ]]
              cancel_output="$(iotox --runtime "$runtime" file-control \
                "$remote_key" "$sync_range_fault_file_number" cancel)"
