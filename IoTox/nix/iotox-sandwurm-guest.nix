              } >"$rendezvous_dir/client.sync-range-crash-state.tmp"
              mv "$rendezvous_dir/client.sync-range-crash-state.tmp" \
                "$rendezvous_dir/client.sync-range-crash-state"
              sync_unclean_stop_observed=true
              printf 'sync-daemon-stopped=1\n' \
                >"$rendezvous_dir/client.sync-range-daemon-stopped.tmp"
              mv "$rendezvous_dir/client.sync-range-daemon-stopped.tmp" \
                "$rendezvous_dir/client.sync-range-daemon-stopped"

              wait_for_file "$input_dir/sync-range-restart-continue"
              rm -f "$input_dir/sync-range-restart-continue" \
