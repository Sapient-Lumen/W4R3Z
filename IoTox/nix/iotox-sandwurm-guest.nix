                '$1 == "public-key" { print $2 }')"
              [[ "$secondary_primary_route_key" =~ ^[0-9A-F]{64}$ ]]
              [[ "''${route_worker_key[2]}" =~ ^[0-9A-F]{64}$ ]]
              [[ -f \
                "$secondary_route_worker_root/''${route_worker_key[2]}.toxsave" ]]
              iotox --identity "$secondary_state/device.identity" \
                route-set-create-v2 "$secondary_route_set" 1 \
                "$secondary_primary_route_key" \
                "$secondary_primary_route_key:protected:udp:tox/native:1:0:0" \
                "''${route_worker_key[2]}:bulk:tcp:tox/tor:8:1:0" \
                >"$secondary_state/route-set-create.txt"
              grep -q ' generation=1 members=2 format=2 ' \
                "$secondary_state/route-set-create.txt"
              secondary_agent_args+=(--route-set "$secondary_route_set")
              secondary_agent_args+=(--route-generation-state \
                "$secondary_route_generation")
              secondary_agent_args+=(--enable-route-workers)
              secondary_agent_args+=(--route-worker-root \
                "$secondary_route_worker_root")
              secondary_agent_args+=(--enable-private-route-bindings)
              secondary_agent_args+=(--route-worker-network \
                "''${route_worker_key[2]}=tox/tor@$actual_tor_proxy_endpoint")
              secondary_agent_args+=(--route-worker-bootstrap \
                "''${route_worker_key[2]}=$actual_tor_node_record")
              secondary_agent_args+=(--route-worker-tcp-relay \
                "''${route_worker_key[2]}=$actual_tor_node_record")
            fi
            stop_secondary_agent
            start_secondary_agent
            secondary_peer_pid="$secondary_agent_pid"
          elif $sync_content_multi_source_scenario; then
            secondary_peer_pid="$agent_pid"
          fi
          if $sync_tree_route_startup_order_scenario; then
            printf 'sync-restarted=1\n' \
              >"$rendezvous_dir/${role}.startup-sync-restarted.tmp"
            mv "$rendezvous_dir/${role}.startup-sync-restarted.tmp" \
              "$rendezvous_dir/${role}.startup-sync-restarted"
          fi
        else
          [[ ${lib.escapeShellArg role} == device ]]
          $sync_guest_restart_scenario
          [[ -f "$sync_policy_store/namespaces/sandwurm-file.namespace" ]]
          [[ -f "$state_dir/sync-guest-restart.published" ]]
        fi

        while (( SECONDS < deadline )); do
          session="$(iotox --runtime "$runtime" session "$remote_key" 2>/dev/null || true)"
          authority="$(iotox --runtime "$runtime" authority-session "$remote_key" 2>/dev/null || true)"
          if grep -q '^state=confirmed$' <<<"$session" && \
             grep -q 'state-sync-v1' <<<"$session" && \
             grep -q 'authorization-ledger-v3' <<<"$session" && \
             grep -q '^remote-authorized=1$' <<<"$authority"; then
            break
          fi
          agent_is_running "$agent_pid"
          sleep 0.1
        done
        grep -q '^state=confirmed$' <<<"$session"
        grep -q 'state-sync-v1' <<<"$session"
        if $sync_content_scenario; then
          grep -q 'state-sync-content-v2' <<<"$session"
        fi
        grep -q 'authorization-ledger-v3' <<<"$session"
        grep -q '^remote-authorized=1$' <<<"$authority"
        if $sync_tree_route_startup_order_scenario; then
          observe_first_ready_route() {
            local expected_key=$1
            local phase=$2
            local started_ms now_ms ready_count ready_key
            local stable_samples=0
            local observed_snapshot=
            local phase_deadline=$((SECONDS + 60))
            started_ms="$(date +%s%3N)"
            while (( SECONDS < deadline && SECONDS < phase_deadline )); do
              observed_snapshot="$(iotox --runtime "$runtime" routes \
                2>/dev/null || true)"
              ready_count="$(awk '
                / role=bulk / && / lifecycle=ready / { count++ }
                END { print count + 0 }
              ' <<<"$observed_snapshot")"
              ready_key="$(awk '
                / role=bulk / && / lifecycle=ready / {
                  for (i=1;i<=NF;i++) if ($i ~ /^public-key=/) {
                    sub(/^public-key=/, "", $i); print $i
                  }
                }
              ' <<<"$observed_snapshot")"
              if (( ready_count == 1 )); then
                [[ "$ready_key" == "$expected_key" ]]
                stable_samples=$((stable_samples + 1))
                if (( stable_samples >= 10 )); then
                  break
                fi
              elif (( ready_count > 1 )); then
                false
              else
                stable_samples=0
              fi
              agent_is_running "$agent_pid"
              sleep 0.1
            done
            (( stable_samples >= 10 ))
            now_ms="$(date +%s%3N)"
            if [[ "$phase" == one ]]; then
              sync_tree_route_startup_phase_one_first="$ready_key"
              sync_tree_route_startup_phase_one_ms=$((now_ms - started_ms))
              sync_tree_route_startup_phase_one_stable_samples="$stable_samples"
            else
              sync_tree_route_startup_phase_two_first="$ready_key"
              sync_tree_route_startup_phase_two_ms=$((now_ms - started_ms))
              sync_tree_route_startup_phase_two_stable_samples="$stable_samples"
            fi
          }
          wait_for_both_ready_routes() {
            local ready_count=0
            local phase_deadline=$((SECONDS + 60))
            while (( SECONDS < deadline && SECONDS < phase_deadline )); do
              route_snapshot="$(iotox --runtime "$runtime" routes \
                2>/dev/null || true)"
              ready_count="$(awk '
                / role=bulk / && / lifecycle=ready / { count++ }
                END { print count + 0 }
              ' <<<"$route_snapshot")"
              if (( ready_count == 2 )); then
                break
              fi
              agent_is_running "$agent_pid"
              sleep 0.1
            done
            (( ready_count == 2 ))
          }

          observe_first_ready_route "''${route_worker_key[1]}" one
          wait_for_both_ready_routes
          printf 'phase-one-ready=1\n' \
            >"$rendezvous_dir/${role}.startup-phase-one-ready.tmp"
          mv "$rendezvous_dir/${role}.startup-phase-one-ready.tmp" \
            "$rendezvous_dir/${role}.startup-phase-one-ready"
          wait_for_file "$input_dir/startup-phase-two-release"
          rm -f "$input_dir/startup-phase-two-release" \
            "$rendezvous_dir/${role}.startup-phase-one-ready"
          stop_agent
          agent_args[$qualification_first_value_index]="''${route_worker_key[2]}"
          start_agent
          sync_tree_route_startup_restart_count=1
          printf 'phase-two-restarted=1\n' \
            >"$rendezvous_dir/${role}.startup-phase-two-restarted.tmp"
          mv "$rendezvous_dir/${role}.startup-phase-two-restarted.tmp" \
            "$rendezvous_dir/${role}.startup-phase-two-restarted"

          while (( SECONDS < deadline )); do
            session="$(iotox --runtime "$runtime" session "$remote_key" \
              2>/dev/null || true)"
            authority="$(iotox --runtime "$runtime" authority-session \
              "$remote_key" 2>/dev/null || true)"
            if grep -q '^state=confirmed$' <<<"$session" && \
               grep -q 'state-sync-v1' <<<"$session" && \
               grep -q 'authorization-ledger-v3' <<<"$session" && \
               grep -q '^remote-authorized=1$' <<<"$authority"; then
              break
            fi
            agent_is_running "$agent_pid"
            sleep 0.1
          done
          grep -q '^state=confirmed$' <<<"$session"
          grep -q 'state-sync-v1' <<<"$session"
          grep -q 'authorization-ledger-v3' <<<"$session"
          grep -q '^remote-authorized=1$' <<<"$authority"
          observe_first_ready_route "''${route_worker_key[2]}" two
          wait_for_both_ready_routes
          [[ "$sync_tree_route_startup_phase_one_first" != \
             "$sync_tree_route_startup_phase_two_first" ]]
          sync_tree_route_startup_delay_ms=20000
          sync_tree_route_startup_order_observed=true
        fi
        if $sync_tree_route_loss_scenario || \
           $sync_range_route_loss_scenario || \
           $sync_tree_route_startup_order_scenario || \
           $sync_tree_route_private_mixed_scenario || \
           $sync_tree_route_balance_scenario || \
           $sync_tree_route_population_scenario || \
           $sync_tree_route_population_loss_scenario || \
           $sync_tree_route_loss_admission_scenario || \
           $sync_tree_route_startup_admission_scenario || \
           $sync_tree_route_throughput_scenario || \
           $sync_tree_route_concurrent_cancel_scenario || \
           $sync_tree_route_cancel_scenario; then
          route_snapshot=
          secondary_route_snapshot=
          while (( SECONDS < deadline )); do
            route_snapshot="$(iotox --runtime "$runtime" routes \
              2>/dev/null || true)"
            ready_bulk_count="$(awk '
              / role=bulk / && / lifecycle=ready / { count++ }
              END { print count + 0 }
            ' <<<"$route_snapshot")"
            if $sync_content_multi_route_actual_tor_scenario && \
               $sync_content_multi_source_scenario && \
               [[ ${lib.escapeShellArg role} == device ]]; then
              secondary_route_snapshot="$(iotox \
                --runtime "$secondary_runtime" routes 2>/dev/null || true)"
              secondary_ready_bulk_count="$(awk '
                / role=bulk / && / lifecycle=ready / { count++ }
                END { print count + 0 }
              ' <<<"$secondary_route_snapshot")"
              if grep -q '^route-count=2$' <<<"$route_snapshot" && \
                 grep -q '^route-count=2$' \
                   <<<"$secondary_route_snapshot" && \
                 (( ready_bulk_count == 1 && \
                    secondary_ready_bulk_count == 1 )); then
                ready_bulk_count=2
                break
              fi
            elif grep -q '^route-count=3$' <<<"$route_snapshot" && \
                 (( ready_bulk_count == 2 )); then
                break
            fi
            agent_is_running "$agent_pid"
            sleep 0.1
          done
          if $sync_content_multi_route_actual_tor_scenario && \
             $sync_content_multi_source_scenario && \
             [[ ${lib.escapeShellArg role} == device ]]; then
            grep -q '^route-count=2$' <<<"$route_snapshot"
            grep -q '^route-count=2$' <<<"$secondary_route_snapshot"
          else
            grep -q '^route-count=3$' <<<"$route_snapshot"
          fi
          (( ready_bulk_count == 2 ))
          primary_route_record="$(awk -v key="$primary_route_key" '
            $0 ~ ("public-key=" key) { print; exit }
          ' <<<"$route_snapshot")"
          grep -q " role=protected " <<<" $primary_route_record "
          grep -q " network-class=$route_network_class " \
            <<<" $primary_route_record "
          for lane in 1 2; do
            worker_route_snapshot="$route_snapshot"
            if $sync_content_multi_route_actual_tor_scenario && \
               $sync_content_multi_source_scenario && \
               [[ ${lib.escapeShellArg role} == device ]] && \
               (( lane == 2 )); then
              worker_route_snapshot="$secondary_route_snapshot"
            fi
            worker_route_record="$(awk \
              -v key="''${route_worker_key[$lane]}" '
              $0 ~ ("public-key=" key) { print; exit }
            ' <<<"$worker_route_snapshot")"
            grep -q " role=bulk " <<<" $worker_route_record "
            grep -q \
              " network-class=''${route_worker_network_class[$lane]} " \
              <<<" $worker_route_record "
          done
          signed_route_network_classes_observed=true
          sync_tree_route_ready_bulk="$ready_bulk_count"
          if $sync_tree_route_actual_tor_payload_scenario || \
             $sync_tree_route_actual_i2p_payload_scenario || \
             $sync_range_actual_i2p_scenario || \
             $sync_tree_route_actual_tor_loss_scenario; then
            # Coordinator readiness only says that the worker transport is
            # live. Exact payload selection additionally requires both
            # private-route bindings to have been mutually authenticated and
            # admitted as synchronization carriers by the parent agent.
            authenticated_auxiliary_count=0
            authenticated_privacy_route_count=0
            authenticated_range_route_count=0
            authenticated_auxiliary_deadline=$((SECONDS + 180))
            failure_phase=sync-auxiliary-authority
            while (( SECONDS < deadline && \
                     SECONDS < authenticated_auxiliary_deadline )); do
              route_sync_status="$(iotox --runtime "$runtime" sync-status \
                2>/dev/null || true)"
              if $sync_content_multi_route_actual_tor_scenario && \
                 $sync_content_multi_source_scenario && \
                 [[ ${lib.escapeShellArg role} == device ]]; then
                secondary_route_sync_status="$(iotox \
                  --runtime "$secondary_runtime" sync-status \
                  2>/dev/null || true)"
                route_sync_status+=$'\n'
                route_sync_status+="$secondary_route_sync_status"
              fi
              if $sync_content_multi_route_actual_tor_scenario; then
                authenticated_auxiliary_count="$(awk '
                  /^auxiliary-route=/ { ++count }
                  END { print count + 0 }
                ' <<<"$route_sync_status")"
              else
                authenticated_auxiliary_count="$(awk \
                  -v principal="$remote_principal" '
                  /^auxiliary-route=/ {
                    for (i=1;i<=NF;i++) if ($i == "principal=" principal) {
                      ++count
                    }
                  }
                  END { print count + 0 }
                ' <<<"$route_sync_status")"
              fi
              authenticated_privacy_route_count="$(awk \
                -v route="''${route_worker_key[$private_route_tor_lane]}" \
                -v principal="$remote_principal" '
                $1 == "auxiliary-route=" route {
                  for (i=1;i<=NF;i++) if ($i == "principal=" principal) {
                    ++count
                  }
                }
                END { print count + 0 }
              ' <<<"$route_sync_status")"
              authenticated_range_route_count="$(awk '
                /^auxiliary-route=/ && / range-negotiated=1$/ {
                  ++count
                }
                END { print count + 0 }
              ' <<<"$route_sync_status")"
              if $sync_content_multi_route_actual_tor_scenario; then
                authenticated_privacy_route_count="$(awk '
                  /^auxiliary-route=/ && / content-negotiated=1$/ {
                    ++count
                  }
                  END { print count + 0 }
                ' <<<"$route_sync_status")"
              fi
              {
                printf 'authenticated-auxiliary-count=%s\n' \
                  "$authenticated_auxiliary_count"
                printf 'authenticated-privacy-route-count=%s\n' \
                  "$authenticated_privacy_route_count"
                printf 'authenticated-range-route-count=%s\n' \
                  "$authenticated_range_route_count"
                printf 'sync-route-status-sha256=%s\n' \
                  "$(printf '%s' "$route_sync_status" | \
                    sha256sum | cut -d' ' -f1)"
              } >"$rendezvous_dir/${role}.sync-authority-progress.tmp"
              mv "$rendezvous_dir/${role}.sync-authority-progress.tmp" \
                "$rendezvous_dir/${role}.sync-authority-progress"
              expected_privacy_route_count=1
              if $sync_content_multi_route_actual_tor_scenario; then
                expected_privacy_route_count=2
              fi
              if [[ "$authenticated_auxiliary_count" == 2 && \
                    "$authenticated_privacy_route_count" == \
                      "$expected_privacy_route_count" && \
                    "$authenticated_range_route_count" == 2 ]]; then
                break
              fi
              agent_is_running "$agent_pid"
              sleep 0.1
            done
            [[ "$authenticated_auxiliary_count" == 2 ]]
            [[ "$authenticated_privacy_route_count" == \
              "$expected_privacy_route_count" ]]
            [[ "$authenticated_range_route_count" == 2 ]]
            rm -f "$rendezvous_dir/${role}.sync-authority-progress"
          fi
          initial_bulk_route="$(awk '
            / role=bulk / {
              for (i=1;i<=NF;i++) if ($i ~ /^public-key=/) {
                sub(/^public-key=/, "", $i); print $i
              }
            }
          ' <<<"$route_snapshot" | sort | head -n 1)"
          [[ "$initial_bulk_route" =~ ^[0-9A-F]{64}$ ]]
          combined_route_snapshot="$route_snapshot"
          if [[ -n "$secondary_route_snapshot" ]]; then
            combined_route_snapshot+=$'\n'
            combined_route_snapshot+="$secondary_route_snapshot"
          fi
          printf '%s\n' "$combined_route_snapshot" \
            >"$rendezvous_dir/${role}.sync-routes-ready.tmp"
          mv "$rendezvous_dir/${role}.sync-routes-ready.tmp" \
            "$rendezvous_dir/${role}.sync-routes-ready"
        fi
        if $sync_tree_route_private_mixed_scenario; then
          grep -q 'private-route-binding-v2' <<<"$session"
          private_route_mixed_context_observed=true
          private_route_primary_network=Tox/native
          if $sync_tree_route_actual_i2p_payload_scenario || \
             $sync_range_actual_i2p_scenario; then
            private_route_auxiliary_network=Tox/I2P-construction
          else
            private_route_auxiliary_network=Tox/Tor
          fi
          private_route_auxiliary_key_sha256="$(printf '%s' \
            "''${route_worker_key[$private_route_tor_lane]}" | \
            sha256sum | cut -d' ' -f1)"
          [[ "$private_route_auxiliary_key_sha256" =~ ^[0-9a-f]{64}$ ]]
        fi
        if $sync_range_scenario; then
          grep -q 'state-sync-ranges-v1' <<<"$session"
        fi
        if ! $resumed_guest && \
           { $sync_restart_scenario || $sync_guest_restart_scenario || \
             $sync_disconnect_scenario; }; then
          sync_initial_online_epoch="$(awk -F= '$1 == "online-epoch" { print $2 }' \
            <<<"$session")"
          [[ "$sync_initial_online_epoch" =~ ^[1-9][0-9]*$ ]]
          initial_online_epoch="$sync_initial_online_epoch"
          recovered_online_epoch="$sync_initial_online_epoch"
        fi
        if $sync_content_multi_source_scenario; then
          secondary_authority=
          secondary_authority_samples=0
          secondary_authority_deadline=$((SECONDS + 300))
          while (( SECONDS < secondary_authority_deadline )); do
            (( secondary_authority_samples += 1 ))
            secondary_session="$(iotox --runtime "$secondary_peer_runtime" \
              session "$secondary_peer_key" 2>/dev/null || true)"
            secondary_authority="$(iotox --runtime "$secondary_peer_runtime" \
              authority-session "$secondary_peer_key" 2>/dev/null || true)"
            if (( secondary_authority_samples == 1 || \
                  secondary_authority_samples % 50 == 0 )); then
              {
                printf 'secondary-samples=%s\n' \
                  "$secondary_authority_samples"
                printf 'secondary-session-state=%s\n' "$(awk -F= \
                  '$1 == "state" { print $2 }' \
                  <<<"$secondary_session")"
                printf 'secondary-online-epoch=%s\n' "$(awk -F= \
                  '$1 == "online-epoch" { print $2 }' \
                  <<<"$secondary_session")"
                printf 'secondary-remote-authorized=%s\n' "$(awk -F= \
                  '$1 == "remote-authorized" { print $2 }' \
                  <<<"$secondary_authority")"
              } >"$rendezvous_dir/${role}.sync-authority-progress.tmp"
              mv "$rendezvous_dir/${role}.sync-authority-progress.tmp" \
                "$rendezvous_dir/${role}.sync-authority-progress"
            fi
            if grep -q '^state=confirmed$' <<<"$secondary_session" && \
               grep -q 'state-sync-content-v2' <<<"$secondary_session" && \
               grep -q 'authorization-ledger-v3' <<<"$secondary_session" && \
               grep -q '^remote-authorized=1$' <<<"$secondary_authority"; then
              break
            fi
            kill -0 "$secondary_peer_pid"
            sleep 0.1
          done
          grep -q '^state=confirmed$' <<<"$secondary_session"
          grep -q 'state-sync-content-v2' <<<"$secondary_session"
          grep -q 'authorization-ledger-v3' <<<"$secondary_session"
          grep -q '^remote-authorized=1$' <<<"$secondary_authority"
          if $sync_content_multi_source_loss_scenario && \
             [[ ${lib.escapeShellArg role} == client ]]; then
            multi_source_loss_initial_epoch="$(awk -F= \
              '$1 == "online-epoch" { print $2 }' <<<"$secondary_session")"
            [[ "$multi_source_loss_initial_epoch" =~ ^[1-9][0-9]*$ ]]
          elif $sync_content_multi_route_actual_tor_loss_scenario && \
               [[ ${lib.escapeShellArg role} == client ]]; then
            multi_source_route_loss_primary_epoch="$(awk -F= \
              '$1 == "online-epoch" { print $2 }' <<<"$session")"
            multi_source_route_loss_secondary_epoch="$(awk -F= \
              '$1 == "online-epoch" { print $2 }' \
              <<<"$secondary_session")"
            [[ "$multi_source_route_loss_primary_epoch" =~ \
              ^[1-9][0-9]*$ ]]
            [[ "$multi_source_route_loss_secondary_epoch" =~ \
              ^[1-9][0-9]*$ ]]
            multi_source_loss_initial_epoch="$multi_source_route_loss_secondary_epoch"
            multi_source_loss_recovered_epoch="$multi_source_route_loss_secondary_epoch"
          fi
          rm -f "$rendezvous_dir/${role}.sync-authority-progress"
          if $sync_content_multi_source_any_loss_scenario; then
            # Keep the destructive fault and explicit retry independently
            # bounded from construction and authority convergence.
            deadline=$((SECONDS + 900))
          fi
        fi
        sync_authority_observed=true
        printf 'sync-authority-ready=1\n' \
          >"$rendezvous_dir/${role}.sync-authority-ready.tmp"
        mv "$rendezvous_dir/${role}.sync-authority-ready.tmp" \
          "$rendezvous_dir/${role}.sync-authority-ready"

        if [[ ${lib.escapeShellArg role} == device ]]; then
          sync_source="$state_dir/sandwurm-sync-source.bin"
          if $sync_tree_scenario; then
            sync_source="$state_dir/sandwurm-sync-source-tree"
          fi
          if $resumed_guest; then
            sync_published="$(<"$state_dir/sync-guest-restart.published")"
            sync_generation="$(awk -F= '$1 == "generation" { print $2 }' \
              <<<"$sync_published")"
            sync_head_record="$(awk -F= '$1 == "head-record" { print $2 }' \
              <<<"$sync_published")"
            sync_artifact_sha256="$(awk -F= '$1 == "artifact-sha256" { print $2 }' \
              <<<"$sync_published")"
            sync_manifest_sha256="$(awk -F= '$1 == "manifest-sha256" { print $2 }' \
              <<<"$sync_published")"
            sync_artifact_bytes="$(awk -F= '$1 == "artifact-bytes" { print $2 }' \
              <<<"$sync_published")"
            sync_manifest_bytes="$(awk -F= '$1 == "manifest-bytes" { print $2 }' \
              <<<"$sync_published")"
          else
            if $sync_tree_scenario; then
              install -d -m 0700 "$sync_source" "$sync_source/bin" \
                "$sync_source/empty" "$sync_source/nested"
              printf '%s\n' '#!/bin/sh' \
                "printf 'iotox-tree-probe\\n'" >"$sync_source/bin/probe"
              printf '%s\n' \
                'IoTox genuine Sandwurm treepack-v1 convergence' \
                >"$sync_source/nested/field-notes.txt"
              dd if=/dev/zero of="$sync_source/payload.bin" \
                bs="$sync_tree_base_payload_bytes" count=1 status=none
              printf 'IoTox deterministic tree payload\n' |
                dd of="$sync_source/payload.bin" conv=notrunc status=none
              chmod 0700 "$sync_source/bin/probe"
              chmod 0600 "$sync_source/nested/field-notes.txt" \
                "$sync_source/payload.bin"
              sync_tree_payload_sha256="$(sha256sum \
                "$sync_source/payload.bin" | cut -d' ' -f1)"
            else
              if $signed_update_scenario; then
                signed_update_payload="$state_dir/signed-update-payload.bin"
                sync_source="$state_dir/signed-update-release.iub"
                signed_update_version=1.0.0-sandwurm
                if $update_service_scenario; then
                  install -m 0600 \
                    ${updateServiceProbe}/bin/iotox-update-service-probe \
                    "$signed_update_payload"
                  truncate -s $((sync_source_mib * 1048576)) \
                    "$signed_update_payload"
                  signed_update_version=delayed-ready
                else
                  dd if=/dev/zero of="$signed_update_payload" bs=1048576 \
                    count="$sync_source_mib" status=none
                  printf 'IoTox inert signed update slot payload v1\n' |
                    dd of="$signed_update_payload" conv=notrunc status=none
                fi
                chmod 0600 "$signed_update_payload"
