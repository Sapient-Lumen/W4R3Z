                  grep -q ' lifecycle=ready ' \
                    <<<" $route_cancel_recovered_member "
                  grep -q ' restarts=1 ' \
                    <<<" $route_cancel_recovered_member "
                  grep -q ' restart-budget=1 ' \
                    <<<" $route_cancel_recovered_member "
                  grep -q ' last-failure=none$' \
                    <<<"$route_cancel_recovered_member"
                  sync_tree_route_loss_position_bytes="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^qualification-fault-position=/) {
                      sub(/^qualification-fault-position=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_header")"
                  sync_tree_route_loss_carrier_losses="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-carrier-losses=/) {
                      sub(/^auxiliary-carrier-losses=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_header")"
                  sync_tree_route_loss_reassignments="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-reassignments=/) {
                      sub(/^auxiliary-reassignments=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_header")"
                  sync_tree_route_loss_stale_terminals="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-stale-terminals=/) {
                      sub(/^auxiliary-stale-terminals=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_header")"
                  grep -q ' qualification-fault=1 ' \
                    <<<" $route_cancel_header "
                  grep -q ' qualification-fault-armed=0 ' \
                    <<<" $route_cancel_header "
                  grep -q ' qualification-fault-after-cancel=0$' \
                    <<<"$route_cancel_header"
                  (( sync_tree_route_loss_position_bytes >= 65536 ))
                  (( sync_tree_route_loss_position_bytes < \
                     sync_artifact_bytes ))
                  (( sync_tree_route_loss_carrier_losses == 1 ))
                  (( sync_tree_route_loss_reassignments == \
                     sync_tree_route_cancel_reassignments_delta ))
                  (( sync_tree_route_loss_stale_terminals >= 0 ))
                  sync_tree_route_loss_stopped_carrier="$sync_tree_route_cancel_carrier"
                  if [[ "$sync_tree_route_cancel_race_outcome" == \
                       cancel-first ]]; then
                    (( sync_tree_route_loss_reassignments == 0 ))
                    [[ "$sync_tree_route_loss_final_carrier" == \
                      "$sync_tree_route_loss_stopped_carrier" ]]
                  else
                    [[ "$sync_tree_route_cancel_race_outcome" == \
                      loss-first ]]
                    (( sync_tree_route_loss_reassignments == 1 ))
                    [[ "$sync_tree_route_loss_final_carrier" != \
                      "$sync_tree_route_loss_stopped_carrier" ]]
                  fi
                  sync_tree_route_loss_observed=true
                  sync_tree_route_cancel_race_observed=true
                elif $sync_tree_route_cancel_loss_scenario; then
                  while (( SECONDS < deadline )); do
                    sync_status="$(iotox --runtime "$runtime" sync-status \
                      2>/dev/null || true)"
                    route_cancel_header="$(head -n 1 <<<"$sync_status")"
                    route_cancel_routes="$(iotox --runtime "$runtime" \
                      routes 2>/dev/null || true)"
                    route_cancel_ready_bulk="$(awk '
                      / role=bulk / && / lifecycle=ready / { count++ }
                      END { print count + 0 }
                    ' <<<"$route_cancel_routes")"
                    route_cancel_recovered_member="$(awk \
                      -v key="$sync_tree_route_cancel_carrier" \
                      '$0 ~ ("public-key=" key) { print; exit }' \
                      <<<"$route_cancel_routes")"
                    sync_tree_route_loss_recoveries="$(awk '{
                      for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-recoveries=/) {
                        sub(/^auxiliary-recoveries=/,"",$i); print $i
                      }
                    }' <<<"$route_cancel_header")"
                    if (( route_cancel_ready_bulk == 2 )) && \
                       [[ "$sync_tree_route_loss_recoveries" == 1 ]] && \
                       grep -q ' lifecycle=ready ' \
                         <<<" $route_cancel_recovered_member " && \
                       grep -q ' restarts=1 ' \
                         <<<" $route_cancel_recovered_member "; then
                      break
                    fi
                    agent_is_running "$agent_pid"
                    sleep 0.05
                  done
                  (( route_cancel_ready_bulk == 2 ))
                  (( sync_tree_route_loss_recoveries == 1 ))
                  grep -q ' lifecycle=ready ' \
                    <<<" $route_cancel_recovered_member "
                  grep -q ' restarts=1 ' \
                    <<<" $route_cancel_recovered_member "
                  grep -q ' restart-budget=1 ' \
                    <<<" $route_cancel_recovered_member "
                  grep -q ' last-failure=none$' \
                    <<<"$route_cancel_recovered_member"
                  sync_tree_route_loss_position_bytes="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^qualification-fault-position=/) {
                      sub(/^qualification-fault-position=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_header")"
                  sync_tree_route_loss_carrier_losses="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-carrier-losses=/) {
                      sub(/^auxiliary-carrier-losses=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_header")"
                  sync_tree_route_loss_reassignments="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-reassignments=/) {
                      sub(/^auxiliary-reassignments=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_header")"
                  sync_tree_route_loss_stale_terminals="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-stale-terminals=/) {
                      sub(/^auxiliary-stale-terminals=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_header")"
                  grep -q ' qualification-fault=1 ' \
                    <<<" $route_cancel_header "
                  grep -q ' qualification-fault-after-cancel=1$' \
                    <<<"$route_cancel_header"
                  (( sync_tree_route_loss_position_bytes == 0 ))
                  (( sync_tree_route_loss_carrier_losses == 1 ))
                  (( sync_tree_route_loss_reassignments == 0 ))
                  (( sync_tree_route_loss_stale_terminals >= 1 ))
                  sync_tree_route_loss_final_carrier="$sync_tree_route_cancel_carrier"
                  sync_tree_route_loss_stopped_carrier="$sync_tree_route_cancel_carrier"
                  sync_tree_route_loss_observed=true
                  sync_tree_route_cancel_loss_observed=true
                else
                  route_cancel_ready_bulk="$(awk '
                    / role=bulk / && / lifecycle=ready / { count++ }
                    END { print count + 0 }
                  ' <<<"$route_cancel_routes")"
                fi
                (( route_cancel_ready_bulk == 2 ))
                (( sync_tree_route_cancel_work_after == 0 ))
                sync_tree_route_cancel_observed=true
                sync_tree_observed=true
              fi
              sync_cancellation_observed=true
            elif $sync_disconnect_scenario || $sync_guest_restart_scenario; then
              sync_fault_name=disconnect
              if $sync_disconnect_scenario; then
                sync_disconnect_staging_bytes="$sync_progress_staging_bytes"
                wait_for_file "$input_dir/sync-disconnect"
                rm -f "$input_dir/sync-disconnect"
                printf 'sync-disconnect-armed=1\n' \
                  >"$rendezvous_dir/client.sync-disconnect-armed.tmp"
                mv "$rendezvous_dir/client.sync-disconnect-armed.tmp" \
                  "$rendezvous_dir/client.sync-disconnect-armed"
              else
                sync_fault_name=guest-restart
                sync_guest_restart_staging_bytes="$sync_progress_staging_bytes"
              fi

              stable_sync_epoch=0
              stable_sync_samples=0
              while (( SECONDS < deadline )); do
                session="$(iotox --runtime "$runtime" session "$remote_key" 2>/dev/null || true)"
                connection="$(iotox --runtime "$runtime" peers 2>/dev/null |
                  awk -v key="$remote_key" '$0 ~ "public-key=" key {
                    for (i = 1; i <= NF; i++) if ($i ~ /^connection=/) {
                      sub(/^connection=/, "", $i); print $i; exit
                    }
                  }')"
                if grep -q '^state=offline$' <<<"$session" && \
                   [[ "$connection" == offline ]]; then
                  break
                fi
                kill -0 "$agent_pid"
                sleep 0.1
              done
              grep -q '^state=offline$' <<<"$session"
              [[ "$connection" == offline ]]
              sync_peer_offline_observed=true
              if $sync_disconnect_scenario; then
                link_interruption_observed=true
              fi
              sync_status="$(iotox --runtime "$runtime" sync-status)"
              grep -Eq "job=$sync_pull_job_id .*namespace=sandwurm-file state=failed" \
                <<<"$sync_status"
              sync_files="$(iotox --runtime "$runtime" files)"
              ! grep -Eq 'direction=incoming .*state=(offered|active|paused)' \
                <<<"$sync_files"
