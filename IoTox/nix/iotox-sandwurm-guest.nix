            awk '!/^writer=/' \
              "$sync_policy_store/namespaces/sandwurm-file.namespace" \
              >"$sync_policy_store/namespaces/sandwurm-file.namespace.base"
            awk -v writers="$sync_policy_store/namespaces/sandwurm-file.namespace.writers" '
              /^subscriber=/ {
                while ((getline line < writers) > 0) print line
                close(writers)
              }
              { print }
            ' "$sync_policy_store/namespaces/sandwurm-file.namespace.base" \
              >"$sync_policy_store/namespaces/sandwurm-file.namespace"
            rm -f "$sync_policy_store/namespaces/sandwurm-file.namespace.base" \
              "$sync_policy_store/namespaces/sandwurm-file.namespace.writers"
            chmod 0600 "$sync_policy_store/namespaces/sandwurm-file.namespace"
            if [[ ${lib.escapeShellArg role} == device ]]; then
              install -d -m 0700 "$secondary_sync_policy_store" \
                "$secondary_sync_policy_store/namespaces" \
                "$secondary_sync_root"
              secondary_sync_root_hex="$(printf '%s' "$secondary_sync_root" |
