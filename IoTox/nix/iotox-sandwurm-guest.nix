              "$rendezvous_dir/client.sync-adversity-finished"
          fi
          if $sync_range_scenario; then
            wait_for_file "$input_dir/sync-range-start"
            sync_range_start="$(<"$input_dir/sync-range-start")"
            rm -f "$input_dir/sync-range-start"
            if ! $sync_range_actual_i2p_loss_scenario; then
              rm -f "$rendezvous_dir/client.sync-complete"
            fi
            sync_basis_sha256="$sync_artifact_sha256"
            sync_basis_object="$sync_root/objects/$sync_basis_sha256.artifact"
            [[ "$(sha256sum "$sync_basis_object" | cut -d' ' -f1)" == \
              "$sync_basis_sha256" ]]
            sync_generation="$(awk -F= '$1 == "generation" { print $2 }' <<<"$sync_range_start")"
            sync_head_record="$(awk -F= '$1 == "head-record" { print $2 }' <<<"$sync_range_start")"
            sync_artifact_sha256="$(awk -F= '$1 == "artifact-sha256" { print $2 }' <<<"$sync_range_start")"
            sync_manifest_sha256="$(awk -F= '$1 == "manifest-sha256" { print $2 }' <<<"$sync_range_start")"
            sync_artifact_bytes="$(awk -F= '$1 == "artifact-bytes" { print $2 }' <<<"$sync_range_start")"
            sync_manifest_bytes="$(awk -F= '$1 == "manifest-bytes" { print $2 }' <<<"$sync_range_start")"
            [[ "$sync_generation" == 2 ]]
            [[ "$sync_head_record" =~ ^[0-9a-f]{64}$ ]]
            [[ "$sync_artifact_sha256" =~ ^[0-9a-f]{64}$ ]]
            [[ "$sync_manifest_sha256" =~ ^[0-9a-f]{64}$ ]]
            if $sync_range_fallback_scenario; then
              sync_basis_size="$(stat -c '%s' "$sync_basis_object")"
              dd if=/dev/zero of="$sync_basis_object" bs=4096 count=1 \
                conv=notrunc status=none
              [[ "$(stat -c '%s' "$sync_basis_object")" == \
                "$sync_basis_size" ]]
              [[ "$(sha256sum "$sync_basis_object" | cut -d' ' -f1)" != \
                "$sync_basis_sha256" ]]
            fi
            sync_range_policy_args=()
            if $sync_range_actual_i2p_scenario; then
              sync_range_policy_args=(fail-closed tox/i2p-construction)
            fi
            failure_phase=sync-range-successor-pull
            sync_range_pull_error=
            if ! sync_range_pull="$(iotox --runtime "$runtime" sync-pull \
              "$remote_key" sandwurm-file \
              "''${sync_range_policy_args[@]}" 2>&1)"; then
              sync_range_pull_error="$sync_range_pull"
              false
            fi
            sync_pull_job_id="$(awk '{ for (i=1;i<=NF;i++) if ($i ~ /^job=/) { sub(/^job=/,"",$i); print $i } }' \
              <<<"$sync_range_pull")"
            [[ "$sync_pull_job_id" =~ ^[1-9][0-9]*$ ]]
            if $sync_range_restart_resume_scenario; then
              sync_range_restart_first_job_id="$sync_pull_job_id"
              sync_range_restart_ready_line=
              sync_range_restart_file_line=
              sync_range_restart_samples=0
              while (( SECONDS < deadline )); do
                sync_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                sync_range_restart_ready_line="$(awk \
                  -v job="$sync_pull_job_id" \
                  '$1 == "job=" job { print; exit }' <<<"$sync_status")"
                sync_files="$(iotox --runtime "$runtime" files \
                  2>/dev/null || true)"
                sync_range_restart_bundle="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^range-bundle-bytes=/) {
                    sub(/^range-bundle-bytes=/,"",$i); print $i; exit
                  }
                }' <<<"$sync_range_restart_ready_line")"
                sync_range_restart_file_line="$(awk \
                  -v size="$sync_range_restart_bundle" '
                  /direction=incoming/ && /state=active/ {
                    found=0
                    for (i=1;i<=NF;i++) if ($i == "size=" size) found=1
                    if (found) { print; exit }
                  }' <<<"$sync_files")"
                sync_range_restart_carrier_position="$(awk '{
                  for (i=1;i<=NF;i++) if \
                      ($i ~ /^carrier-receive-position=/) {
