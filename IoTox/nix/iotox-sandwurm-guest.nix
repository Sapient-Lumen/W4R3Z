          fi
          sync_finished="$(<"$input_dir/sync-finished")"
          rm -f "$input_dir/sync-finished" \
            "$rendezvous_dir/device.sync-published" \
            "$rendezvous_dir/device.sync-initial-live-status" \
            "$rendezvous_dir/device.sync-initial-live-routes"
          grep -q "^head-record=$sync_head_record$" <<<"$sync_finished"
          grep -q "^artifact-sha256=$sync_artifact_sha256$" <<<"$sync_finished"
          grep -q "^manifest-sha256=$sync_manifest_sha256$" <<<"$sync_finished"
          if $sync_content_multi_source_scenario; then
            grep -q '^content-source-count=2$' <<<"$sync_finished"
            grep -q '^content-atomic-pull=1$' <<<"$sync_finished"
            multi_source_atomic_pull_observed=true
            client_availability_requests="$(awk -F= \
              '$1 == "content-availability-requests" { print $2 }' \
              <<<"$sync_finished")"
            client_availability_results="$(awk -F= \
              '$1 == "content-availability-results" { print $2 }' \
              <<<"$sync_finished")"
            [[ "$client_availability_requests" =~ ^[1-9][0-9]*$ ]]
            [[ "$client_availability_results" == \
               "$client_availability_requests" ]]
            if $sync_content_multi_source_any_loss_scenario; then
              multi_source_loss_first_job_id="$(awk -F= \
                '$1 == "content-loss-first-job" { print $2 }' \
                <<<"$sync_finished")"
              multi_source_loss_replacement_job_id="$(awk -F= \
                '$1 == "content-loss-replacement-job" { print $2 }' \
                <<<"$sync_finished")"
              multi_source_loss_committed_objects="$(awk -F= \
                '$1 == "content-loss-committed-objects" { print $2 }' \
                <<<"$sync_finished")"
              multi_source_loss_fetched_bytes="$(awk -F= \
                '$1 == "content-loss-fetched-bytes" { print $2 }' \
                <<<"$sync_finished")"
              multi_source_loss_initial_epoch="$(awk -F= \
                '$1 == "content-loss-initial-epoch" { print $2 }' \
                <<<"$sync_finished")"
              multi_source_loss_recovered_epoch="$(awk -F= \
                '$1 == "content-loss-recovered-epoch" { print $2 }' \
                <<<"$sync_finished")"
              grep -q '^content-loss-observed=1$' <<<"$sync_finished"
              grep -q '^content-loss-recovery=1$' <<<"$sync_finished"
              grep -q '^content-loss-staging-clean=1$' <<<"$sync_finished"
              grep -q '^content-loss-head-fenced=1$' <<<"$sync_finished"
              grep -q '^content-loss-activation-fenced=1$' \
                <<<"$sync_finished"
              [[ "$multi_source_loss_first_job_id" =~ ^[1-9][0-9]*$ ]]
              [[ "$multi_source_loss_replacement_job_id" =~ \
                ^[1-9][0-9]*$ ]]
              [[ "$multi_source_loss_first_job_id" != \
                "$multi_source_loss_replacement_job_id" ]]
              [[ "$multi_source_loss_committed_objects" =~ \
                ^[1-9][0-9]*$ ]]
              [[ "$multi_source_loss_fetched_bytes" =~ ^[1-9][0-9]*$ ]]
              if $sync_content_multi_source_loss_scenario; then
                (( multi_source_loss_recovered_epoch > \
                  multi_source_loss_initial_epoch ))
              else
                [[ "$multi_source_loss_recovered_epoch" == \
                  "$multi_source_loss_initial_epoch" ]]
                grep -q '^content-route-loss=1$' <<<"$sync_finished"
                multi_source_route_loss_target="$(awk -F= \
                  '$1 == "content-route-loss-target" { print $2 }' \
                  <<<"$sync_finished")"
                multi_source_route_loss_fault_worker="$(awk -F= \
                  '$1 == "content-route-loss-fault-worker" { print $2 }' \
                  <<<"$sync_finished")"
                multi_source_route_loss_recovered_worker="$(awk -F= \
                  '$1 == "content-route-loss-recovered-worker" { print $2 }' \
                  <<<"$sync_finished")"
                multi_source_route_loss_position_bytes="$(awk -F= \
                  '$1 == "content-route-loss-position-bytes" { print $2 }' \
                  <<<"$sync_finished")"
                multi_source_route_loss_carrier_losses="$(awk -F= \
                  '$1 == "content-route-loss-carrier-losses" { print $2 }' \
                  <<<"$sync_finished")"
                multi_source_route_loss_reassignments="$(awk -F= \
                  '$1 == "content-route-loss-reassignments" { print $2 }' \
                  <<<"$sync_finished")"
                multi_source_route_loss_recoveries="$(awk -F= \
                  '$1 == "content-route-loss-recoveries" { print $2 }' \
                  <<<"$sync_finished")"
                multi_source_route_loss_primary_epoch="$(awk -F= \
                  '$1 == "content-route-loss-primary-epoch" { print $2 }' \
                  <<<"$sync_finished")"
                multi_source_route_loss_secondary_epoch="$(awk -F= \
                  '$1 == "content-route-loss-secondary-epoch" { print $2 }' \
                  <<<"$sync_finished")"
                [[ "$multi_source_route_loss_target" =~ ^[0-9A-F]{64}$ ]]
                [[ "$multi_source_route_loss_fault_worker" =~ \
                  ^[1-9][0-9]*$ ]]
                [[ "$multi_source_route_loss_recovered_worker" =~ \
                  ^[1-9][0-9]*$ ]]
                [[ "$multi_source_route_loss_fault_worker" != \
                  "$multi_source_route_loss_recovered_worker" ]]
                (( multi_source_route_loss_position_bytes >= 65536 ))
                (( multi_source_route_loss_carrier_losses == 1 ))
                (( multi_source_route_loss_reassignments == 0 ))
                (( multi_source_route_loss_recoveries == 1 ))
                # In this scenario the one restart is the selected auxiliary
                # worker, not either native publisher Agent.
                multi_source_loss_restart_count=1
                multi_source_route_loss_observed=true
              fi
              multi_source_loss_observed=true
