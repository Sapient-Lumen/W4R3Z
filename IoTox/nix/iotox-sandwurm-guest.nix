              quota_remaining=$((
                sync_tree_quota_store_bytes - sync_tree_quota_inventory_bytes
              ))
              (( quota_remaining > 0 ))
              (( quota_candidate_artifact_bytes > quota_remaining ))
              (( quota_candidate_manifest_bytes > quota_remaining ))
            fi

