              '$1 == "candidate-artifact-sha256" { print $2 }' \
              <<<"$control_candidate")"
            sync_tree_control_replay_manifest_sha256="$(awk -F= \
              '$1 == "candidate-manifest-sha256" { print $2 }' \
              <<<"$control_candidate")"
            control_artifact_bytes="$(awk -F= \
              '$1 == "candidate-artifact-bytes" { print $2 }' \
              <<<"$control_candidate")"
            control_manifest_bytes="$(awk -F= \
              '$1 == "candidate-manifest-bytes" { print $2 }' \
              <<<"$control_candidate")"
            control_payload="$(awk -F= \
              '$1 == "candidate-payload-sha256" { print $2 }' \
