iotox-sync-namespace-v1
id=sandwurm-balance-$balance_namespace
root-hex=$balance_root_hex
engine=treepack-v1
activation=manual
maximum-artifact-bytes=$sync_maximum_artifact_bytes
maximum-manifest-bytes=1048576
maximum-store-bytes=33554432
maximum-staging-bytes=16777216
maximum-objects=32
maximum-retained-revisions=4
maximum-peers=2
maximum-lanes=1
maximum-outstanding-requests=4
writer=''${publisher_principal,,}
subscriber=''${subscriber_principal,,}
POLICY
              chmod 0600 \
                "$sync_policy_store/namespaces/sandwurm-balance-$balance_namespace.namespace"
            done
            if [[ ${lib.escapeShellArg role} == client ]]; then
              # The reverse-order cell starts adaptive in the ordinary sync
              # enablement restart. Avoid inserting a second immediate daemon
              # replacement before the cold first phase.
              agent_args+=(--sync-route-policy adaptive)
            fi
          fi
          if $sync_tree_route_population_fixture; then
            population_policies=(fixed adaptive)
            population_jobs_per_policy=8
            population_maximum_artifact_bytes=8388608
            population_maximum_store_bytes=33554432
            population_maximum_staging_bytes=16777216
