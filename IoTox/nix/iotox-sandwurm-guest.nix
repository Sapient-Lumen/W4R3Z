              rm -f "$input_dir/actual-i2p-restarted"
              actual_i2p_recovery_samples=0
              while (( SECONDS < deadline )); do
                actual_i2p_recovered_routes="$(iotox --runtime "$runtime" \
                  routes 2>/dev/null || true)"
                actual_i2p_recovered_route="$(awk \
                  -v key="$actual_i2p_loss_carrier" \
                  '$0 ~ ("public-key=" key) { print; exit }' \
                  <<<"$actual_i2p_recovered_routes")"
                actual_i2p_recovered_worker="$(awk \
                  -v key="$actual_i2p_loss_carrier" \
                  '$1 == "auxiliary-worker=" key { print; exit }' \
                  <<<"$actual_i2p_recovered_routes")"
                actual_i2p_loss_status="$(iotox --runtime "$runtime" \
                  sync-status 2>/dev/null || true)"
                actual_i2p_loss_header="$(head -n 1 \
                  <<<"$actual_i2p_loss_status")"
                actual_i2p_fail_closed_loss_recoveries="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-recoveries=/) {
                    sub(/^auxiliary-recoveries=/,"",$i); print $i; exit
                  }
                }' <<<"$actual_i2p_loss_header")"
                actual_i2p_recovery_lifecycle="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^lifecycle=/) {
