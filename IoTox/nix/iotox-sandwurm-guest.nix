            } >"$rendezvous_dir/client.actual-tor-loss-ready.tmp"
            mv "$rendezvous_dir/client.actual-tor-loss-ready.tmp" \
              "$rendezvous_dir/client.actual-tor-loss-ready"

            actual_tor_loss_replacement=
            while (( SECONDS < deadline )); do
              actual_tor_loss_status="$(iotox --runtime "$runtime" \
                sync-status 2>/dev/null || true)"
              actual_tor_loss_header="$(head -n 1 \
                <<<"$actual_tor_loss_status")"
              actual_tor_loss_job="$(awk -v job="$sync_pull_job_id" \
                '$1 == "job=" job { print; exit }' \
                <<<"$actual_tor_loss_status")"
              sync_tree_route_loss_carrier_losses="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ \
                    /^auxiliary-carrier-losses=/) {
                  sub(/^auxiliary-carrier-losses=/,"",$i); print $i; exit
                }
              }' <<<"$actual_tor_loss_header")"
              sync_tree_route_loss_reassignments="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ \
                    /^auxiliary-reassignments=/) {
                  sub(/^auxiliary-reassignments=/,"",$i); print $i; exit
                }
              }' <<<"$actual_tor_loss_header")"
              actual_tor_loss_replacement="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^carrier-route=/) {
                  sub(/^carrier-route=/,"",$i); print $i; exit
                }
              }' <<<"$actual_tor_loss_job")"
              if [[ "$sync_tree_route_loss_carrier_losses" == 1 ]] && \
                 [[ "$sync_tree_route_loss_reassignments" == 1 ]] && \
                 [[ "$actual_tor_loss_replacement" =~ \
                    ^[0-9A-F]{64}$ ]] && \
                 [[ "$actual_tor_loss_replacement" != \
                    "$actual_tor_loss_carrier" ]]; then
                break
              fi
              agent_is_running "$agent_pid"
              sleep 0.1
            done
            (( sync_tree_route_loss_carrier_losses == 1 ))
            (( sync_tree_route_loss_reassignments == 1 ))
            [[ "$actual_tor_loss_replacement" != \
              "$actual_tor_loss_carrier" ]]
            {
              printf 'schema=iotox-actual-tor-loss-observed-v1\n'
              printf 'job=%s\n' "$sync_pull_job_id"
              printf 'position-bytes=%s\n' \
                "$sync_tree_route_loss_position_bytes"
              printf 'stopped-carrier=%s\n' "$actual_tor_loss_carrier"
              printf 'replacement-carrier=%s\n' \
                "$actual_tor_loss_replacement"
              printf 'carrier-losses=1\n'
              printf 'reassignments=1\n'
            } >"$rendezvous_dir/client.actual-tor-loss-observed.tmp"
            mv "$rendezvous_dir/client.actual-tor-loss-observed.tmp" \
              "$rendezvous_dir/client.actual-tor-loss-observed"
            wait_for_file "$input_dir/actual-tor-restarted"
            rm -f "$input_dir/actual-tor-restarted"
          fi
          if $sync_tree_route_actual_i2p_loss_scenario; then
            actual_i2p_loss_status=
            actual_i2p_loss_job=
            actual_i2p_loss_carrier=
            actual_i2p_loss_worker=
            while (( SECONDS < deadline )); do
              actual_i2p_loss_status="$(iotox --runtime "$runtime" \
                sync-status 2>/dev/null || true)"
              actual_i2p_loss_job="$(awk -v job="$sync_pull_job_id" \
                '$1 == "job=" job { print; exit }' \
                <<<"$actual_i2p_loss_status")"
              actual_i2p_loss_carrier="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^carrier-route=/) {
                  sub(/^carrier-route=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_loss_job")"
              actual_i2p_loss_worker="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^carrier-worker=/) {
                  sub(/^carrier-worker=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_loss_job")"
              actual_i2p_fail_closed_loss_position_bytes="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ \
                    /^carrier-receive-position=/) {
                  sub(/^carrier-receive-position=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_loss_job")"
              if [[ "$actual_i2p_loss_carrier" == \
                    "''${route_worker_key[$private_route_tor_lane]}" ]] && \
                 [[ "$actual_i2p_loss_worker" =~ ^[1-9][0-9]*$ ]] && \
                 [[ "$actual_i2p_fail_closed_loss_position_bytes" =~ \
                    ^[1-9][0-9]*$ ]] && \
                 (( actual_i2p_fail_closed_loss_position_bytes >= 65536 && \
                    actual_i2p_fail_closed_loss_position_bytes < \
                      sync_artifact_bytes )); then
                break
              fi
              agent_is_running "$agent_pid"
              sleep 0.05
            done
            [[ "$actual_i2p_loss_carrier" == \
              "''${route_worker_key[$private_route_tor_lane]}" ]]
            [[ "$initial_bulk_route" == "$actual_i2p_loss_carrier" ]]
            (( actual_i2p_fail_closed_loss_position_bytes >= 65536 ))
            (( actual_i2p_fail_closed_loss_position_bytes < \
               sync_artifact_bytes ))
            actual_i2p_fail_closed_loss_original_job_id="$sync_pull_job_id"
            actual_i2p_fail_closed_loss_carrier_sha256="$(printf '%s' \
              "$actual_i2p_loss_carrier" | sha256sum | cut -d' ' -f1)"
            [[ "$actual_i2p_fail_closed_loss_carrier_sha256" == \
              "$private_route_auxiliary_key_sha256" ]]
            {
              printf 'schema=iotox-actual-i2p-loss-ready-v1\n'
              printf 'job=%s\n' "$sync_pull_job_id"
              printf 'position-bytes=%s\n' \
                "$actual_i2p_fail_closed_loss_position_bytes"
              printf 'carrier=%s\n' "$actual_i2p_loss_carrier"
              printf 'carrier-worker=%s\n' "$actual_i2p_loss_worker"
            } >"$rendezvous_dir/client.actual-i2p-loss-ready.tmp"
            mv "$rendezvous_dir/client.actual-i2p-loss-ready.tmp" \
              "$rendezvous_dir/client.actual-i2p-loss-ready"

            while (( SECONDS < deadline )); do
              actual_i2p_loss_status="$(iotox --runtime "$runtime" \
                sync-status 2>/dev/null || true)"
              actual_i2p_loss_header="$(head -n 1 \
                <<<"$actual_i2p_loss_status")"
              actual_i2p_loss_job="$(awk \
                -v job="$actual_i2p_fail_closed_loss_original_job_id" \
                '$1 == "job=" job { print; exit }' \
                <<<"$actual_i2p_loss_status")"
              actual_i2p_fail_closed_loss_carrier_losses="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ \
                    /^auxiliary-carrier-losses=/) {
                  sub(/^auxiliary-carrier-losses=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_loss_header")"
              actual_i2p_fail_closed_loss_reassignments="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ \
                    /^auxiliary-reassignments=/) {
                  sub(/^auxiliary-reassignments=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_loss_header")"
              actual_i2p_fail_closed_loss_blocked_jobs="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ \
                    /^auxiliary-fail-closed-jobs=/) {
                  sub(/^auxiliary-fail-closed-jobs=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_loss_header")"
              if [[ "$actual_i2p_fail_closed_loss_carrier_losses" == 1 ]] && \
                 [[ "$actual_i2p_fail_closed_loss_reassignments" == 0 ]] && \
                 [[ "$actual_i2p_fail_closed_loss_blocked_jobs" == 1 ]] && \
                 grep -q ' state=awaiting-objects ' \
                   <<<" $actual_i2p_loss_job " && \
                 grep -q ' failover=fail-closed ' \
                   <<<" $actual_i2p_loss_job " && \
                 grep -q ' route-class=tox/i2p-construction ' \
                   <<<" $actual_i2p_loss_job " && \
                 grep -q " carrier-route=$actual_i2p_loss_carrier " \
                   <<<" $actual_i2p_loss_job "; then
                break
              fi
              agent_is_running "$agent_pid"
              sleep 0.1
            done
            (( actual_i2p_fail_closed_loss_carrier_losses == 1 ))
            (( actual_i2p_fail_closed_loss_reassignments == 0 ))
            (( actual_i2p_fail_closed_loss_blocked_jobs == 1 ))
            {
              printf 'schema=iotox-actual-i2p-loss-observed-v1\n'
              printf 'job=%s\n' \
                "$actual_i2p_fail_closed_loss_original_job_id"
              printf 'position-bytes=%s\n' \
                "$actual_i2p_fail_closed_loss_position_bytes"
              printf 'stopped-carrier=%s\n' "$actual_i2p_loss_carrier"
              printf 'carrier-losses=1\n'
              printf 'reassignments=0\n'
              printf 'blocked-jobs=1\n'
            } >"$rendezvous_dir/client.actual-i2p-loss-observed.tmp"
            mv "$rendezvous_dir/client.actual-i2p-loss-observed.tmp" \
              "$rendezvous_dir/client.actual-i2p-loss-observed"

            wait_for_file "$input_dir/actual-i2p-restarted"
            rm -f "$input_dir/actual-i2p-restarted"
            actual_i2p_recovery_samples=0
            while (( SECONDS < deadline )); do
              actual_i2p_recovered_routes="$(iotox --runtime "$runtime" \
                routes 2>/dev/null || true)"
              actual_i2p_recovered_route="$(awk \
                -v key="$actual_i2p_loss_carrier" \
                '$0 ~ ("public-key=" key) { print; exit }' \
                <<<"$actual_i2p_recovered_routes")"
              actual_i2p_loss_status="$(iotox --runtime "$runtime" \
                sync-status 2>/dev/null || true)"
              actual_i2p_loss_header="$(head -n 1 \
                <<<"$actual_i2p_loss_status")"
              actual_i2p_fail_closed_loss_recoveries="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-recoveries=/) {
                  sub(/^auxiliary-recoveries=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_loss_header")"
              actual_i2p_recovery_lifecycle="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^lifecycle=/) {
                  sub(/^lifecycle=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_recovered_route")"
              actual_i2p_recovery_worker="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^worker-id=/) {
                  sub(/^worker-id=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_recovered_route")"
              actual_i2p_recovery_restarts="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^restarts=/) {
                  sub(/^restarts=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_recovered_route")"
              actual_i2p_recovery_failure="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^last-failure=/) {
                  sub(/^last-failure=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_recovered_route")"
              actual_i2p_recovery_losses="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-carrier-losses=/) {
                  sub(/^auxiliary-carrier-losses=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_loss_header")"
              actual_i2p_recovery_reassignments="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-reassignments=/) {
                  sub(/^auxiliary-reassignments=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_loss_header")"
              actual_i2p_recovery_blocked="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-fail-closed-jobs=/) {
                  sub(/^auxiliary-fail-closed-jobs=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_loss_header")"
              actual_i2p_recovery_job_state="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^state=/) {
                  sub(/^state=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_loss_job")"
              (( actual_i2p_recovery_samples += 1 ))
              {
                printf 'schema=iotox-actual-i2p-recovery-progress-v1\n'
                printf 'samples=%s\n' "$actual_i2p_recovery_samples"
                printf 'elapsed-seconds=%s\n' "$SECONDS"
                printf 'carrier=%s\n' "$actual_i2p_loss_carrier"
                printf 'lifecycle=%s\n' \
                  "''${actual_i2p_recovery_lifecycle:-absent}"
                printf 'worker=%s\n' \
                  "''${actual_i2p_recovery_worker:-absent}"
                printf 'restarts=%s\n' \
                  "''${actual_i2p_recovery_restarts:-absent}"
                printf 'last-failure=%s\n' \
                  "''${actual_i2p_recovery_failure:-absent}"
                printf 'carrier-losses=%s\n' \
                  "''${actual_i2p_recovery_losses:-absent}"
                printf 'recoveries=%s\n' \
                  "''${actual_i2p_fail_closed_loss_recoveries:-absent}"
                printf 'reassignments=%s\n' \
                  "''${actual_i2p_recovery_reassignments:-absent}"
                printf 'blocked-jobs=%s\n' \
                  "''${actual_i2p_recovery_blocked:-absent}"
                printf 'original-job-state=%s\n' \
                  "''${actual_i2p_recovery_job_state:-absent}"
              } >"$rendezvous_dir/client.actual-i2p-recovery-progress.tmp"
              mv "$rendezvous_dir/client.actual-i2p-recovery-progress.tmp" \
                "$rendezvous_dir/client.actual-i2p-recovery-progress"
              if grep -q ' lifecycle=ready ' \
                   <<<" $actual_i2p_recovered_route " && \
                 grep -q ' network-class=tox/i2p-construction ' \
                   <<<" $actual_i2p_recovered_route " && \
                 grep -q ' restarts=0 ' \
                   <<<" $actual_i2p_recovered_route " && \
                 [[ "$actual_i2p_fail_closed_loss_recoveries" == 1 ]]; then
                break
              fi
              agent_is_running "$agent_pid"
              sleep 0.1
            done
            grep -q ' lifecycle=ready ' <<<" $actual_i2p_recovered_route "
            grep -q ' network-class=tox/i2p-construction ' \
              <<<" $actual_i2p_recovered_route "
            grep -q ' restarts=0 ' <<<" $actual_i2p_recovered_route "
            (( actual_i2p_fail_closed_loss_recoveries == 1 ))
            actual_i2p_fail_closed_loss_worker_restarts=0

            actual_i2p_cancel_output="$(iotox --runtime "$runtime" \
              sync-cancel "$actual_i2p_fail_closed_loss_original_job_id")"
            grep -q \
              "sync-cancelled job=$actual_i2p_fail_closed_loss_original_job_id" \
              <<<"$actual_i2p_cancel_output"
            actual_i2p_fail_closed_loss_old_job_cancelled=true
            actual_i2p_repull_output="$(iotox --runtime "$runtime" \
              sync-pull "$remote_key" sandwurm-file fail-closed \
              tox/i2p-construction)"
            actual_i2p_fail_closed_loss_replacement_job_id="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^job=/) {
                sub(/^job=/,"",$i); print $i; exit
              }
            }' <<<"$actual_i2p_repull_output")"
            [[ "$actual_i2p_fail_closed_loss_replacement_job_id" =~ \
              ^[1-9][0-9]*$ ]]
            [[ "$actual_i2p_fail_closed_loss_replacement_job_id" != \
              "$actual_i2p_fail_closed_loss_original_job_id" ]]
            sync_pull_job_id="$actual_i2p_fail_closed_loss_replacement_job_id"
          fi
          if $sync_restart_scenario || $sync_guest_restart_scenario || \
             $sync_pause_scenario || $sync_cancel_scenario || \
             $sync_disconnect_scenario; then
            sync_status=
            sync_progress_staging_bytes=0
            content_restart_progress_samples=0
            while (( SECONDS < deadline )); do
              sync_status="$(iotox --runtime "$runtime" sync-status 2>/dev/null || true)"
              sync_files="$(iotox --runtime "$runtime" files 2>/dev/null || true)"
              sync_progress_staging_bytes="$(awk '
                /direction=incoming/ && /state=active/ {
                  for (i = 1; i <= NF; i++) if ($i ~ /^position=/) {
                    sub(/^position=/, "", $i); total += $i
                  }
                }
                END { print total + 0 }
              ' <<<"$sync_files")"
              content_restart_lane_ready=true
              content_restart_staging_temporaries=0
              if $sync_content_restart_scenario; then
                content_restart_lane_ready=false
                content_restart_staging_temporaries="$(find \
                  "$sync_root/staging/content-v2" -type f \
                  -name '.iotox-*.part.part-??????' -printf '.\n' \
                  2>/dev/null | wc -l)"
                sync_progress_staging_bytes="$(find \
                  "$sync_root/staging/content-v2" -type f \
                  -name '.iotox-*.part.part-??????' -printf '%s\n' \
                  2>/dev/null | \
                  awk '{ total += $1 } END { print total + 0 }')"
                content_restart_job_line="$(awk -v job="$sync_pull_job_id" \
                  '$1 == "content-job=" job { print; exit }' \
                  <<<"$sync_status")"
                content_restart_lane_lines="$(awk -v job="$sync_pull_job_id" \
                  '$1 == "content-lane-job=" job { print }' \
                  <<<"$sync_status")"
                content_restart_header_cap="$(awk 'NR == 1 {
                  for (i=1;i<=NF;i++) if ($i ~ /^content-lane-cap=/) {
                    sub(/^content-lane-cap=/,"",$i); print $i; exit
                  }
                }' <<<"$sync_status")"
                content_restart_status_active="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^active-lanes=/) {
                    sub(/^active-lanes=/,"",$i); print $i; exit
                  }
                }' <<<"$content_restart_job_line")"
                content_restart_lane_rows="$(awk 'NF { ++count }
                  END { print count + 0 }' \
                  <<<"$content_restart_lane_lines")"
                content_restart_admitted_lanes="$(awk '{
                  for (i=1;i<=NF;i++) if ($i == "admitted=1") ++count
                  }
                  END { print count + 0 }' \
                  <<<"$content_restart_lane_lines")"
                content_restart_root_lanes="$(awk '{
                  for (i=1;i<=NF;i++) if ($i == "root=1") ++count
                  }
                  END { print count + 0 }' \
                  <<<"$content_restart_lane_lines")"
                content_restart_distinct_requests="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^request=/) {
                    sub(/^request=/,"",$i); seen[$i]=1
                  }
                  }
                  END { for (value in seen) ++count; print count + 0 }
                ' <<<"$content_restart_lane_lines")"
                content_restart_distinct_lane_files="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^file=/) {
                    sub(/^file=/,"",$i); seen[$i]=1
                  }
                  }
                  END { for (value in seen) ++count; print count + 0 }
                ' <<<"$content_restart_lane_lines")"
                content_restart_distinct_sources="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^source-id=/) {
                    sub(/^source-id=/,"",$i); seen[$i]=1
                  }
                  }
                  END { for (value in seen) ++count; print count + 0 }
                ' <<<"$content_restart_lane_lines")"
                content_restart_active_files="$(awk '
                  /direction=incoming/ && /state=active/ { ++count }
                  END { print count + 0 }
                ' <<<"$sync_files")"
                content_restart_positive_files="$(awk '
                  /direction=incoming/ && /state=active/ {
                    for (i=1;i<=NF;i++) if ($i ~ /^position=/) {
                      sub(/^position=/,"",$i); if ($i > 0) ++count
                    }
                  }
                  END { print count + 0 }
                ' <<<"$sync_files")"
                content_restart_distinct_file_ids="$(awk '
                  /direction=incoming/ && /state=active/ {
                    for (i=1;i<=NF;i++) if ($i ~ /^file-id=/) {
                      sub(/^file-id=/,"",$i); seen[$i]=1
                    }
                  }
                  END { for (value in seen) ++count; print count + 0 }
                ' <<<"$sync_files")"
                # sync-status and files are separate control-socket snapshots.
                # Bind exact logical lanes, requests, and FileIds in the former,
                # and bind concurrent private transport files from staging.
                # The files snapshot remains diagnostic: short objects can turn
                # over between the two control calls, so it is not an atomic
                # source for the exact lane count.
                if [[ "$content_restart_header_cap" == \
                        "$sync_content_restart_cap" && \
                      "$content_restart_status_active" == \
                        "$sync_content_restart_cap" && \
                      "$content_restart_lane_rows" == \
                        "$sync_content_restart_cap" && \
                      "$content_restart_admitted_lanes" == \
                        "$sync_content_restart_cap" && \
                      "$content_restart_root_lanes" == 0 && \
                      "$content_restart_distinct_requests" == \
                        "$sync_content_restart_cap" && \
                      "$content_restart_distinct_lane_files" == \
                        "$sync_content_restart_cap" && \
                      "$content_restart_distinct_sources" == 1 && \
                      "$content_restart_staging_temporaries" -ge 2 && \
                      "$content_restart_staging_temporaries" -le \
                        "$sync_content_restart_cap" && \
                      "$sync_progress_staging_bytes" -gt 0 ]]; then
                  content_restart_lane_ready=true
                fi
                (( content_restart_progress_samples += 1 ))
                if (( content_restart_progress_samples == 1 || \
                      content_restart_progress_samples % 10 == 0 )); then
                  {
                    printf 'schema=iotox-content-restart-progress-v1\n'
                    printf 'samples=%s\n' \
                      "$content_restart_progress_samples"
                    printf 'expected-cap=%s\n' \
                      "$sync_content_restart_cap"
                    printf 'header-cap=%s\n' \
                      "''${content_restart_header_cap:-absent}"
                    printf 'status-active=%s\n' \
                      "''${content_restart_status_active:-absent}"
                    printf 'lane-rows=%s\n' \
                      "$content_restart_lane_rows"
                    printf 'admitted-lanes=%s\n' \
                      "$content_restart_admitted_lanes"
                    printf 'root-lanes=%s\n' \
                      "$content_restart_root_lanes"
                    printf 'distinct-requests=%s\n' \
                      "$content_restart_distinct_requests"
                    printf 'distinct-lane-files=%s\n' \
                      "$content_restart_distinct_lane_files"
                    printf 'distinct-sources=%s\n' \
                      "$content_restart_distinct_sources"
                    printf 'active-files=%s\n' \
                      "$content_restart_active_files"
                    printf 'positive-files=%s\n' \
                      "$content_restart_positive_files"
                    printf 'distinct-file-ids=%s\n' \
                      "$content_restart_distinct_file_ids"
                    printf 'staging-temporaries=%s\n' \
                      "$content_restart_staging_temporaries"
                    printf 'staging-bytes=%s\n' \
                      "$sync_progress_staging_bytes"
                    printf 'lane-ready=%s\n' \
                      "$content_restart_lane_ready"
                    printf 'status-sha256=%s\n' \
                      "$(printf '%s' "$sync_status" | sha256sum | \
                        cut -d' ' -f1)"
                    printf 'files-sha256=%s\n' \
                      "$(printf '%s' "$sync_files" | sha256sum | \
                        cut -d' ' -f1)"
                  } >"$rendezvous_dir/client.content-restart-progress.tmp"
                  mv "$rendezvous_dir/client.content-restart-progress.tmp" \
                    "$rendezvous_dir/client.content-restart-progress"
                fi
              fi
              if $sync_tree_route_cancel_scenario; then
                route_cancel_progress_job="$(awk -v job="$sync_pull_job_id" \
                  '$1 == "job=" job { print; exit }' <<<"$sync_status")"
                sync_progress_staging_bytes="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^carrier-receive-position=/) {
                    sub(/^carrier-receive-position=/,"",$i); print $i
                  }
                }' <<<"$route_cancel_progress_job")"
                route_cancel_progress_receives="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^carrier-active-receives=/) {
                    sub(/^carrier-active-receives=/,"",$i); print $i
                  }
                }' <<<"$route_cancel_progress_job")"
                [[ "$sync_progress_staging_bytes" =~ ^[0-9]+$ ]]
                [[ "$route_cancel_progress_receives" =~ ^[0-9]+$ ]]
                route_cancel_order_ready=true
                if $sync_tree_route_loss_cancel_scenario; then
                  route_cancel_progress_header="$(head -n 1 \
                    <<<"$sync_status")"
                  route_cancel_progress_carrier="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^carrier-route=/) {
                      sub(/^carrier-route=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_progress_job")"
                  route_cancel_progress_losses="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-carrier-losses=/) {
                      sub(/^auxiliary-carrier-losses=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_progress_header")"
                  route_cancel_progress_reassignments="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-reassignments=/) {
                      sub(/^auxiliary-reassignments=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_progress_header")"
                  route_cancel_order_ready=false
                  if grep -q ' qualification-fault=1 ' \
                       <<<" $route_cancel_progress_header " && \
                     [[ "$route_cancel_progress_losses" == 1 ]] && \
                     [[ "$route_cancel_progress_reassignments" == 1 ]] && \
                     [[ "$route_cancel_progress_carrier" =~ ^[0-9A-F]{64}$ ]] && \
                     [[ "$route_cancel_progress_carrier" != \
                        "$initial_bulk_route" ]]; then
                    route_cancel_order_ready=true
                  fi
                elif $sync_tree_route_cancel_race_scenario; then
                  route_cancel_progress_header="$(head -n 1 \
                    <<<"$sync_status")"
                  route_cancel_progress_losses="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-carrier-losses=/) {
                      sub(/^auxiliary-carrier-losses=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_progress_header")"
                  route_cancel_progress_reassignments="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-reassignments=/) {
                      sub(/^auxiliary-reassignments=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_progress_header")"
                  route_cancel_order_ready=false
                  if grep -q ' qualification-fault=0 ' \
                       <<<" $route_cancel_progress_header " && \
                     grep -q ' qualification-fault-armed=1 ' \
                       <<<" $route_cancel_progress_header " && \
                     [[ "$route_cancel_progress_losses" == 0 ]] && \
                     [[ "$route_cancel_progress_reassignments" == 0 ]]; then
                    route_cancel_order_ready=true
                  fi
                fi
              fi
              sync_progress_admission_ready=false
              if $sync_content_restart_scenario; then
                $content_restart_lane_ready && \
                  sync_progress_admission_ready=true
              elif grep -Eq \
                'namespace=sandwurm-file .* admitted=[1-9][0-9]*' \
                <<<"$sync_status"; then
                sync_progress_admission_ready=true
              fi
              if grep -q 'namespace=sandwurm-file state=awaiting-objects' \
                 <<<"$sync_status" && \
                 $sync_progress_admission_ready && \
                 (( sync_progress_staging_bytes > 0 )) && \
                 (( sync_progress_staging_bytes < sync_artifact_bytes + sync_manifest_bytes )) && \
                 $content_restart_lane_ready && \
                 { ! $sync_tree_route_cancel_scenario || \
                   $route_cancel_order_ready; }; then
                break
              fi
              if grep -q 'namespace=sandwurm-file state=complete' <<<"$sync_status" || \
                 grep -q 'namespace=sandwurm-file state=failed' <<<"$sync_status"; then
                printf '%s\n' "$sync_status" >&2
                exit 1
              fi
              kill -0 "$agent_pid"
              sleep 0.1
            done
            grep -q 'namespace=sandwurm-file state=awaiting-objects' <<<"$sync_status"
            (( sync_progress_staging_bytes > 0 ))
            (( sync_progress_staging_bytes < sync_artifact_bytes + sync_manifest_bytes ))
            if $sync_content_restart_scenario; then
              $content_restart_lane_ready
              content_restart_cap=$sync_content_restart_cap
              content_restart_live_lanes=$sync_content_restart_cap
              content_restart_total_chunks=$sync_content_chunks
              content_restart_total_objects=$sync_content_objects
              (( content_restart_total_chunks >= \
                 sync_content_restart_cap ))
              (( content_restart_total_objects >= \
                 sync_content_restart_cap + 2 ))
              (( content_restart_staging_temporaries >= 2 && \
                 content_restart_staging_temporaries <= \
                   sync_content_restart_cap ))
              content_restart_first_job_id=$sync_pull_job_id
              content_restart_live_lane_set_sha256="$(printf '%s\n' \
                "$content_restart_lane_lines" | sort | sha256sum | \
                cut -d' ' -f1)"
              [[ "$content_restart_live_lane_set_sha256" =~ \
                ^[0-9a-f]{64}$ ]]
            fi
            [[ ! -e "$sync_root/accepted-heads/sandwurm-file.accepted-head" ]]
            [[ ! -e "$sync_root/activated-revisions/sandwurm-file.activated-revision" ]]
            {
              printf 'sync-interruption-ready=1\n'
              printf 'staging-bytes=%s\n' "$sync_progress_staging_bytes"
              if $sync_content_restart_scenario; then
                printf 'content-restart-cap=%s\n' \
                  "$sync_content_restart_cap"
                printf 'content-restart-live-lanes=%s\n' \
                  "$content_restart_live_lanes"
                printf 'content-restart-staging-temporaries=%s\n' \
                  "$content_restart_staging_temporaries"
                printf 'content-restart-lane-set-sha256=%s\n' \
                  "$content_restart_live_lane_set_sha256"
                printf 'content-restart-first-job=%s\n' \
                  "$content_restart_first_job_id"
              fi
            } >"$rendezvous_dir/client.sync-interruption-ready.tmp"
            mv "$rendezvous_dir/client.sync-interruption-ready.tmp" \
              "$rendezvous_dir/client.sync-interruption-ready"

            if $sync_pause_scenario; then
              sync_pause_line="$(awk '
                /direction=incoming/ && /state=active/ { print; exit }
              ' <<<"$sync_files")"
              sync_pause_file_number="$(awk '{
                for (i = 1; i <= NF; i++) if ($i ~ /^file-number=/) {
                  sub(/^file-number=/, "", $i); print $i; exit
                }
              }' <<<"$sync_pause_line")"
              sync_pause_file_id="$(awk '{
                for (i = 1; i <= NF; i++) if ($i ~ /^file-id=/) {
                  sub(/^file-id=/, "", $i); print tolower($i); exit
                }
              }' <<<"$sync_pause_line")"
              [[ "$sync_pause_file_number" =~ ^[0-9]+$ ]]
              [[ "$sync_pause_file_id" =~ ^[0-9a-f]{64}$ ]]
              pause_output="$(iotox --runtime "$runtime" file-control \
                "$remote_key" "$sync_pause_file_number" pause)"
              grep -q 'state=paused' <<<"$pause_output"
              grep -q 'local-paused=1' <<<"$pause_output"

              sync_pause_last_position=-1
              sync_pause_stable_samples=0
              while (( SECONDS < deadline )); do
                sync_files="$(iotox --runtime "$runtime" files)"
                sync_pause_line="$(awk -v number="$sync_pause_file_number" '
                  /direction=incoming/ {
                    for (i = 1; i <= NF; i++) {
                      if ($i == "file-number=" number) { print; exit }
                    }
                  }
                ' <<<"$sync_files")"
                grep -q 'state=paused' <<<"$sync_pause_line"
                grep -q 'local-paused=1' <<<"$sync_pause_line"
                observed_pause_file_id="$(awk '{
                  for (i = 1; i <= NF; i++) if ($i ~ /^file-id=/) {
                    sub(/^file-id=/, "", $i); print tolower($i); exit
                  }
                }' <<<"$sync_pause_line")"
                [[ "$observed_pause_file_id" == "$sync_pause_file_id" ]]
                sync_pause_position="$(awk '{
                  for (i = 1; i <= NF; i++) if ($i ~ /^position=/) {
                    sub(/^position=/, "", $i); print $i; exit
                  }
                }' <<<"$sync_pause_line")"
                [[ "$sync_pause_position" =~ ^[0-9]+$ ]]
                if (( sync_pause_position == sync_pause_last_position )); then
                  (( ++sync_pause_stable_samples ))
                else
                  sync_pause_last_position="$sync_pause_position"
                  sync_pause_stable_samples=1
                fi
                if (( sync_pause_stable_samples >= 20 )); then
                  break
                fi
                kill -0 "$agent_pid"
                sleep 0.1
              done
              (( sync_pause_stable_samples >= 20 ))
              (( sync_pause_last_position > 0 ))
              (( sync_pause_last_position < sync_artifact_bytes + sync_manifest_bytes ))
              [[ ! -e "$sync_root/accepted-heads/sandwurm-file.accepted-head" ]]
              [[ ! -e "$sync_root/activated-revisions/sandwurm-file.activated-revision" ]]
              sync_pause_position_bytes="$sync_pause_last_position"
              resume_output="$(iotox --runtime "$runtime" file-control \
                "$remote_key" "$sync_pause_file_number" resume)"
              grep -q 'state=active' <<<"$resume_output"
              grep -q 'local-paused=0' <<<"$resume_output"
              grep -q "file-id=''${sync_pause_file_id^^}" <<<"$resume_output"
              sync_pause_observed=true
              sync_resume_observed=true
            elif $sync_cancel_scenario; then
              sync_cancelled_job_id="$sync_pull_job_id"
              sync_interrupted_staging_bytes=0
              sync_cancelled_staging_bytes="$sync_progress_staging_bytes"
              sync_cancelled_receive_count="$(awk '
                /direction=incoming/ && /state=active/ { count++ }
                END { print count + 0 }
              ' <<<"$sync_files")"
              if $sync_tree_route_cancel_scenario; then
                sync_cancelled_receive_count="$route_cancel_progress_receives"
              fi
              (( sync_cancelled_receive_count > 0 && sync_cancelled_receive_count <= 2 ))
              if $sync_tree_route_cancel_scenario; then
                route_cancel_job="$(awk -v job="$sync_cancelled_job_id" \
                  '$1 == "job=" job { print; exit }' <<<"$sync_status")"
                sync_tree_route_cancel_carrier="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^carrier-route=/) {
                    sub(/^carrier-route=/,"",$i); print $i
                  }
                }' <<<"$route_cancel_job")"
                sync_tree_route_cancel_worker_id="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^carrier-worker=/) {
                    sub(/^carrier-worker=/,"",$i); print $i
                  }
                }' <<<"$route_cancel_job")"
                grep -q ' carrier=auxiliary ' <<<" $route_cancel_job "
                [[ "$sync_tree_route_cancel_carrier" =~ ^[0-9A-F]{64}$ ]]
                [[ "$sync_tree_route_cancel_worker_id" =~ ^[1-9][0-9]*$ ]]
                route_cancel_header="$(head -n 1 <<<"$sync_status")"
                route_cancel_reassignments_before="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-reassignments=/) {
                    sub(/^auxiliary-reassignments=/,"",$i); print $i
                  }
                }' <<<"$route_cancel_header")"
                sync_tree_route_cancel_adaptive_selections="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-adaptive-selections=/) {
                    sub(/^auxiliary-adaptive-selections=/,"",$i); print $i
                  }
                }' <<<"$route_cancel_header")"
                [[ "$route_cancel_reassignments_before" =~ ^[0-9]+$ ]]
                if $sync_tree_route_loss_cancel_scenario; then
                  (( route_cancel_reassignments_before == 1 ))
                  (( sync_tree_route_cancel_adaptive_selections == 2 ))
                  grep -q ' qualification-fault=1 ' \
                    <<<" $route_cancel_header "
                  [[ "$sync_tree_route_cancel_carrier" != \
                    "$initial_bulk_route" ]]
                else
                  (( route_cancel_reassignments_before == 0 ))
                  (( sync_tree_route_cancel_adaptive_selections == 1 ))
                fi
                route_cancel_routes="$(iotox --runtime "$runtime" routes)"
                route_cancel_member="$(awk \
                  -v key="$sync_tree_route_cancel_carrier" \
                  '$0 ~ ("public-key=" key) { print; exit }' \
                  <<<"$route_cancel_routes")"
                sync_tree_route_cancel_work_before="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^admitted-work=/) {
                    sub(/^admitted-work=/,"",$i); print $i
                  }
                }' <<<"$route_cancel_member")"
                grep -q ' role=bulk ' <<<" $route_cancel_member "
                grep -q ' lifecycle=ready ' <<<" $route_cancel_member "
                grep -q " worker-id=$sync_tree_route_cancel_worker_id " \
                  <<<" $route_cancel_member "
                [[ "$sync_tree_route_cancel_work_before" =~ ^[1-9][0-9]*$ ]]
              fi
              cancel_started_ms="$(awk '{printf "%.0f\n", $1 * 1000}' \
                /proc/uptime)"
              if $sync_tree_route_cancel_race_scenario; then
                sleep "$(printf '%d.%03d' \
                  "$((sync_tree_route_cancel_race_cancel_delay_ms / 1000))" \
                  "$((sync_tree_route_cancel_race_cancel_delay_ms % 1000))")"
                cancel_started_ms="$(awk '{printf "%.0f\n", $1 * 1000}' \
                  /proc/uptime)"
              fi
              cancel_status=0
              if cancel_output="$(iotox --runtime "$runtime" sync-cancel \
                   "$sync_cancelled_job_id" 2>&1)"; then
                :
              else
                cancel_status=$?
              fi
              if $sync_tree_route_cancel_race_scenario && \
                 (( cancel_status == 4 )); then
                grep -q '^error=unavailable message=' <<<"$cancel_output"
                sync_tree_route_cancel_race_cleanup_retries=1
                cancel_output="$(iotox --runtime "$runtime" sync-cancel \
                  "$sync_cancelled_job_id")"
              else
                (( cancel_status == 0 ))
              fi
              grep -q "sync-cancelled job=$sync_cancelled_job_id" <<<"$cancel_output"
              cancel_deadline_ms=$((cancel_started_ms + 5000))
              while true; do
                sync_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                sync_files="$(iotox --runtime "$runtime" files \
                  2>/dev/null || true)"
                cancel_incoming_count="$(awk '
                  /direction=incoming/ && /state=(offered|active|paused)/ {
                    count++
                  }
                  END { print count + 0 }
                ' <<<"$sync_files")"
                cancel_staging_count="$(find "$sync_root/staging" \
                  -mindepth 1 -maxdepth 1 -printf '.\n' | wc -l)"
                sync_tree_route_cancel_work_after=0
                if $sync_tree_route_cancel_scenario; then
                  route_cancel_routes="$(iotox --runtime "$runtime" routes \
                    2>/dev/null || true)"
                  sync_tree_route_cancel_work_after="$(awk '
                    /route-index=/ {
                      for (i=1;i<=NF;i++) if ($i ~ /^admitted-work=/) {
                        sub(/^admitted-work=/,"",$i); total += $i
                      }
                    }
                    END { print total + 0 }
                  ' <<<"$route_cancel_routes")"
                fi
                if grep -Eq \
                     "job=$sync_cancelled_job_id .*namespace=sandwurm-file state=cancelled" \
                     <<<"$sync_status" && \
                   (( cancel_incoming_count == 0 && \
                      cancel_staging_count == 0 && \
                      sync_tree_route_cancel_work_after == 0 )); then
                  break
                fi
                cancel_now_ms="$(awk '{printf "%.0f\n", $1 * 1000}' \
                  /proc/uptime)"
                (( cancel_now_ms < cancel_deadline_ms ))
                agent_is_running "$agent_pid"
                sleep 0.01
              done
              cancel_finished_ms="$(awk '{printf "%.0f\n", $1 * 1000}' \
                /proc/uptime)"
              sync_tree_route_cancel_tail_ms=$((
                cancel_finished_ms - cancel_started_ms
              ))
              (( sync_tree_route_cancel_tail_ms >= 0 && \
                 sync_tree_route_cancel_tail_ms <= 5000 ))
              grep -Eq "job=$sync_cancelled_job_id .*namespace=sandwurm-file state=cancelled" \
                <<<"$sync_status"
              ! grep -Eq 'direction=incoming .*state=(offered|active|paused)' \
                <<<"$sync_files"
              [[ -z "$(find "$sync_root/staging" -mindepth 1 -maxdepth 1 \
                -print -quit)" ]]
              [[ ! -e "$sync_root/accepted-heads/sandwurm-file.accepted-head" ]]
              [[ ! -e "$sync_root/activated-revisions/sandwurm-file.activated-revision" ]]
              if $sync_tree_route_cancel_scenario; then
                route_cancel_header="$(head -n 1 <<<"$sync_status")"
                route_cancel_reassignments_after="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-reassignments=/) {
                    sub(/^auxiliary-reassignments=/,"",$i); print $i
                  }
                }' <<<"$route_cancel_header")"
                [[ "$route_cancel_reassignments_after" =~ ^[0-9]+$ ]]
                sync_tree_route_cancel_reassignments_delta=$((
                  route_cancel_reassignments_after -
                  route_cancel_reassignments_before
                ))
                if $sync_tree_route_cancel_race_scenario; then
                  (( sync_tree_route_cancel_reassignments_delta >= 0 && \
                     sync_tree_route_cancel_reassignments_delta <= 1 ))
                  sync_tree_route_cancel_adaptive_selections="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-adaptive-selections=/) {
                      sub(/^auxiliary-adaptive-selections=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_header")"
                  (( sync_tree_route_cancel_adaptive_selections == \
                     1 + sync_tree_route_cancel_reassignments_delta ))
                else
                  (( sync_tree_route_cancel_reassignments_delta == 0 ))
                fi
                route_cancel_final_job="$(awk -v job="$sync_cancelled_job_id" \
                  '$1 == "job=" job { print; exit }' <<<"$sync_status")"
                if $sync_tree_route_cancel_race_scenario; then
                  sync_tree_route_loss_final_carrier="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^carrier-route=/) {
                      sub(/^carrier-route=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_final_job")"
                  [[ "$sync_tree_route_loss_final_carrier" =~ \
                    ^[0-9A-F]{64}$ ]]
                  if (( sync_tree_route_cancel_reassignments_delta == 0 )); then
                    [[ "$sync_tree_route_loss_final_carrier" == \
                      "$sync_tree_route_cancel_carrier" ]]
                    sync_tree_route_cancel_race_outcome=cancel-first
                  else
                    [[ "$sync_tree_route_loss_final_carrier" != \
                      "$sync_tree_route_cancel_carrier" ]]
                    sync_tree_route_cancel_race_outcome=loss-first
                  fi
                else
                  grep -q \
                    " carrier-route=$sync_tree_route_cancel_carrier " \
                    <<<" $route_cancel_final_job "
                  grep -q \
                    " carrier-worker=$sync_tree_route_cancel_worker_id " \
                    <<<" $route_cancel_final_job "
                fi
                if $sync_tree_route_loss_cancel_scenario; then
                  while (( SECONDS < deadline )); do
                    sync_status="$(iotox --runtime "$runtime" sync-status \
                      2>/dev/null || true)"
                    route_cancel_header="$(head -n 1 <<<"$sync_status")"
                    route_cancel_routes="$(iotox --runtime "$runtime" \
                      routes 2>/dev/null || true)"
                    route_cancel_ready_bulk="$(awk '
                      / role=bulk / && / lifecycle=ready / { count++ }
                      END { print count + 0 }
                    ' <<<"$route_cancel_routes")"
                    route_cancel_recovered_member="$(awk \
                      -v key="$initial_bulk_route" \
                      '$0 ~ ("public-key=" key) { print; exit }' \
                      <<<"$route_cancel_routes")"
                    sync_tree_route_loss_recoveries="$(awk '{
                      for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-recoveries=/) {
                        sub(/^auxiliary-recoveries=/,"",$i); print $i
                      }
                    }' <<<"$route_cancel_header")"
                    if (( route_cancel_ready_bulk == 2 )) && \
                       [[ "$sync_tree_route_loss_recoveries" == 1 ]] && \
                       grep -q ' lifecycle=ready ' \
                         <<<" $route_cancel_recovered_member " && \
                       grep -q ' restarts=1 ' \
                         <<<" $route_cancel_recovered_member "; then
                      break
                    fi
                    agent_is_running "$agent_pid"
                    sleep 0.05
                  done
                  (( route_cancel_ready_bulk == 2 ))
                  (( sync_tree_route_loss_recoveries == 1 ))
                  grep -q ' lifecycle=ready ' \
                    <<<" $route_cancel_recovered_member "
                  grep -q ' restarts=1 ' \
                    <<<" $route_cancel_recovered_member "
                  grep -q ' restart-budget=1 ' \
                    <<<" $route_cancel_recovered_member "
                  grep -q ' last-failure=none$' \
                    <<<"$route_cancel_recovered_member"
                  sync_tree_route_loss_position_bytes="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^qualification-fault-position=/) {
                      sub(/^qualification-fault-position=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_header")"
                  sync_tree_route_loss_carrier_losses="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-carrier-losses=/) {
                      sub(/^auxiliary-carrier-losses=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_header")"
                  sync_tree_route_loss_reassignments="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-reassignments=/) {
                      sub(/^auxiliary-reassignments=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_header")"
                  sync_tree_route_loss_stale_terminals="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-stale-terminals=/) {
                      sub(/^auxiliary-stale-terminals=/,"",$i); print $i
                    }
                  }' <<<"$route_cancel_header")"
                  grep -q ' qualification-fault=1 ' \
                    <<<" $route_cancel_header "
                  (( sync_tree_route_loss_position_bytes >= 65536 ))
                  (( sync_tree_route_loss_position_bytes < \
                     sync_artifact_bytes ))
                  (( sync_tree_route_loss_carrier_losses == 1 ))
                  (( sync_tree_route_loss_reassignments == 1 ))
                  (( sync_tree_route_loss_stale_terminals >= 1 ))
                  sync_tree_route_loss_final_carrier="$sync_tree_route_cancel_carrier"
                  sync_tree_route_loss_stopped_carrier="$initial_bulk_route"
                  [[ "$sync_tree_route_loss_final_carrier" != \
                    "$sync_tree_route_loss_stopped_carrier" ]]
                  sync_tree_route_loss_observed=true
                elif $sync_tree_route_cancel_race_scenario; then
                  while (( SECONDS < deadline )); do
                    sync_status="$(iotox --runtime "$runtime" sync-status \
                      2>/dev/null || true)"
                    route_cancel_header="$(head -n 1 <<<"$sync_status")"
                    route_cancel_routes="$(iotox --runtime "$runtime" \
                      routes 2>/dev/null || true)"
                    route_cancel_ready_bulk="$(awk '
                      / role=bulk / && / lifecycle=ready / { count++ }
                      END { print count + 0 }
                    ' <<<"$route_cancel_routes")"
                    route_cancel_recovered_member="$(awk \
                      -v key="$sync_tree_route_cancel_carrier" \
                      '$0 ~ ("public-key=" key) { print; exit }' \
                      <<<"$route_cancel_routes")"
                    sync_tree_route_loss_recoveries="$(awk '{
                      for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-recoveries=/) {
                        sub(/^auxiliary-recoveries=/,"",$i); print $i
                      }
                    }' <<<"$route_cancel_header")"
                    if (( route_cancel_ready_bulk == 2 )) && \
                       [[ "$sync_tree_route_loss_recoveries" == 1 ]] && \
                       grep -q ' lifecycle=ready ' \
                         <<<" $route_cancel_recovered_member " && \
                       grep -q ' restarts=1 ' \
                         <<<" $route_cancel_recovered_member "; then
