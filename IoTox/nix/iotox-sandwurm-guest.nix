              sync_tree_route_loss_retained_bytes="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^range-retained-bytes=/) {
                  sub(/^range-retained-bytes=/,"",$i); print $i; exit
                }
              }' <<<"$sync_range_status_line")"
              sync_tree_route_loss_resumed_bytes="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^range-resumed-bytes=/) {
                  sub(/^range-resumed-bytes=/,"",$i); print $i; exit
