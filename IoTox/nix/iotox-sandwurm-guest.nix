            destination_corrupt_ready="$(<"$input_dir/device.sync-destination-corrupt-retry-ready")"
            grep -q '^failure-observed=1$' <<<"$destination_corrupt_ready"
            grep -q "^candidate-head-record=$sync_tree_destination_corrupt_head_record$" \
