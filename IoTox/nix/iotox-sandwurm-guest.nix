      start_stripe_agent() {
        local lane=$1
        local lane_state="''${stripe_state[$lane]}"
        local lane_runtime="''${stripe_runtime[$lane]}"
        local -a lane_args=(
          run
          --runtime "$lane_runtime"
          --state "$lane_state/device.toxsave"
          --identity "$lane_state/device.identity"
          --authority-ledger "$lane_state/authority.ledger"
          --command-store "$lane_state/commands.store"
          --no-default-bootstrap
          --no-default-relays
          --bootstrap "10.0.0.1:33445:$bootstrap_key"
          --bootstrap-retry-ms 1000
          --native-tcp-only
          --tcp-relay "10.0.0.1:33445:$bootstrap_key"
          --max-active-sends "$stripe_streams_per_route"
          --max-active-receives "$stripe_streams_per_route"
        )
        if $ratox_protected_route; then
          taskset --cpu-list 1 iotox "''${lane_args[@]}" \
            >>"$lane_state/agent.log" 2>&1 &
        else
          iotox "''${lane_args[@]}" >>"$lane_state/agent.log" 2>&1 &
        fi
        stripe_agent_pid[$lane]=$!
        while [[ ! -S "$lane_runtime/control.sock" ]]; do
          (( SECONDS < deadline ))
          kill -0 "''${stripe_agent_pid[$lane]}"
          sleep 0.1
        done
      }
      stop_stripe_agent() {
        local lane=$1
        [[ -n "''${stripe_agent_pid[$lane]:-}" ]]
        iotox --runtime "''${stripe_runtime[$lane]}" stop >/dev/null
        wait "''${stripe_agent_pid[$lane]}"
        stripe_agent_pid[$lane]=
      }
      restart_stripe_agent() {
        local lane=$1
        stop_stripe_agent "$lane"
        stripe_restart_count[$lane]=$((''${stripe_restart_count[$lane]:-0} + 1))
        stripe_route_restart_count=$((stripe_route_restart_count + 1))
        start_stripe_agent "$lane"
      }
      stop_stripe_agents() {
        local lane
        for lane in 1 2 3; do
          if [[ -n "''${stripe_agent_pid[$lane]:-}" ]]; then
            stop_stripe_agent "$lane"
          fi
        done
      }
      start_agent

      if $sync_content_multi_source_scenario && \
         [[ ${lib.escapeShellArg role} == device ]]; then
        start_secondary_agent
      fi

      address="$(iotox --runtime "$runtime" address | tr -d '\n')"
      [[ "$address" =~ ^[0-9A-Fa-f]{76}$ ]]
      if $resumed_guest; then
        [[ "$address" == "$expected_address" ]]
      else
        printf '%s\n' "$address" >"$rendezvous_dir/${role}.address.tmp"
        mv "$rendezvous_dir/${role}.address.tmp" "$rendezvous_dir/${role}.address"

        device_principal="$(iotox --runtime "$runtime" identity |
          awk -F= '$1 == "device-public-key" { print $2 }')"
        [[ "$device_principal" =~ ^[0-9A-Fa-f]{64}$ ]]
        printf '%s\n' "$device_principal" >"$rendezvous_dir/${role}.principal.tmp"
        mv "$rendezvous_dir/${role}.principal.tmp" "$rendezvous_dir/${role}.principal"

        if $sync_content_multi_source_scenario && \
           [[ ${lib.escapeShellArg role} == device ]]; then
          secondary_address="$(iotox --runtime "$secondary_runtime" address |
            tr -d '\n')"
          secondary_principal="$(iotox --runtime "$secondary_runtime" identity |
            awk -F= '$1 == "device-public-key" { print $2 }')"
          [[ "$secondary_address" =~ ^[0-9A-Fa-f]{76}$ ]]
          [[ "$secondary_principal" =~ ^[0-9A-Fa-f]{64}$ ]]
          [[ "''${secondary_address:0:64}" != "''${address:0:64}" ]]
          [[ "$secondary_principal" != "$device_principal" ]]
          printf '%s\n' "$secondary_address" \
            >"$rendezvous_dir/device.secondary.address.tmp"
          mv "$rendezvous_dir/device.secondary.address.tmp" \
            "$rendezvous_dir/device.secondary.address"
          printf '%s\n' "$secondary_principal" \
            >"$rendezvous_dir/device.secondary.principal.tmp"
          mv "$rendezvous_dir/device.secondary.principal.tmp" \
            "$rendezvous_dir/device.secondary.principal"
        fi

        if (( ratox_stripe_routes == 4 )); then
          declare -a stripe_address=()
          for lane in 1 2 3; do
            stripe_restart_count[$lane]=0
            start_stripe_agent "$lane"
            stripe_address[$lane]="$(iotox --runtime "''${stripe_runtime[$lane]}" \
              address | tr -d '\n')"
            [[ "''${stripe_address[$lane]}" =~ ^[0-9A-Fa-f]{76}$ ]]
            lane_principal="$(iotox --runtime "''${stripe_runtime[$lane]}" identity |
              awk -F= '$1 == "device-public-key" { print $2 }')"
            [[ "$lane_principal" == "$device_principal" ]]
            printf '%s\n' "''${stripe_address[$lane]}" \
              >"$rendezvous_dir/${role}.lane-$lane.address.tmp"
            mv "$rendezvous_dir/${role}.lane-$lane.address.tmp" \
              "$rendezvous_dir/${role}.lane-$lane.address"
          done
        fi

        wait_for_file "$input_dir/peer.address"
        remote_address="$(tr -d '\n' <"$input_dir/peer.address")"
        rm -f "$input_dir/peer.address" "$rendezvous_dir/${role}.address" \
          "$rendezvous_dir/${role}.principal"
        if (( ratox_stripe_routes == 4 )); then
          for lane in 1 2 3; do
            wait_for_file "$input_dir/lane-$lane.peer.address"
            lane_remote_address="$(tr -d '\n' \
              <"$input_dir/lane-$lane.peer.address")"
            rm -f "$input_dir/lane-$lane.peer.address" \
              "$rendezvous_dir/${role}.lane-$lane.address"
            [[ "$lane_remote_address" =~ ^[0-9A-Fa-f]{76}$ ]]
            stripe_remote_key[$lane]="''${lane_remote_address:0:64}"
            iotox --runtime "''${stripe_runtime[$lane]}" transport-peer-request \
              "$lane_remote_address" \
              "IoTox Sandwurm ${routeMode} stripe lane $lane" >/dev/null
          done
          if [[ "$scenario" == ratox-stripe-recovery-32 && \
                ${lib.escapeShellArg role} == device ]]; then
            # Kill only the fourth route after its friend request has been
            # durably applied. The replacement must recover the same Tox
            # identity and friendship from savedata before the workload starts.
            restart_stripe_agent 3
            stripe_injected_restart_count=1
          fi
        fi
        if $ratox_scenario || $sync_scenario || \
           $sync_bidirectional_scenario || $sync_automation_scenario || \
           $mutable_scenario || \
           $sync_tree_route_private_mixed_scenario; then
          wait_for_file "$input_dir/peer.principal"
          remote_principal="$(tr -d '\n' <"$input_dir/peer.principal")"
          rm -f "$input_dir/peer.principal"
          [[ "$remote_principal" =~ ^[0-9A-Fa-f]{64}$ ]]
        fi
        if $sync_content_multi_source_scenario && \
           [[ ${lib.escapeShellArg role} == client ]]; then
          wait_for_file "$input_dir/secondary.peer.address"
          wait_for_file "$input_dir/secondary.peer.principal"
          secondary_remote_address="$(tr -d '\n' \
            <"$input_dir/secondary.peer.address")"
          secondary_remote_principal="$(tr -d '\n' \
            <"$input_dir/secondary.peer.principal")"
          rm -f "$input_dir/secondary.peer.address" \
            "$input_dir/secondary.peer.principal"
          [[ "$secondary_remote_address" =~ ^[0-9A-Fa-f]{76}$ ]]
          [[ "$secondary_remote_principal" =~ ^[0-9A-Fa-f]{64}$ ]]
          [[ "''${secondary_remote_address:0:64}" != \
             "''${remote_address:0:64}" ]]
          [[ "$secondary_remote_principal" != "$remote_principal" ]]
        fi
      fi
      [[ "$remote_address" =~ ^[0-9A-Fa-f]{76}$ ]]
      remote_key="''${remote_address:0:64}"

      if ! $resumed_guest && [[ ${lib.escapeShellArg routeMode} != tox-tor ]] && \
         [[ ${lib.escapeShellArg routeMode} != tox-i2p ]] && \
         [[ ${lib.escapeShellArg routeMode} != tox-i2p-construction ]]; then
        ping -c 3 -W 2 ${peerAddress} >"$state_dir/ping.txt"
      fi
      if ! $resumed_guest; then
        if $sync_content_multi_source_scenario; then
          # The device pre-accepts the already reviewed reusable key; the
          # client still supplies the complete Tox address so c-toxcore can
          # seed rendezvous without requiring the isolated relay fixture to
          # deliver an operator-visible pending request.
          if [[ ${lib.escapeShellArg role} == client ]]; then
            iotox --runtime "$runtime" transport-peer-request \
              "$remote_address" "IoTox Sandwurm ${routeMode} pair" \
              >/dev/null
          else
            iotox --runtime "$runtime" transport-peer-accept \
              "$remote_key" >/dev/null
          fi
        else
          iotox --runtime "$runtime" transport-peer-request \
            "$remote_address" "IoTox Sandwurm ${routeMode} pair" >/dev/null
        fi
      fi

      if $sync_content_multi_source_scenario; then
        failure_phase=sync-content-multi-source-primary-session
      fi
      connection=
      while (( SECONDS < deadline )); do
        session="$(iotox --runtime "$runtime" session "$remote_key" 2>/dev/null || true)"
        connection="$(iotox --runtime "$runtime" peers 2>/dev/null |
          awk -v key="$remote_key" '$0 ~ "public-key=" key {
            for (i = 1; i <= NF; i++) if ($i ~ /^connection=/) {
              sub(/^connection=/, "", $i); print $i; exit
            }
          }')"
        if grep -q '^state=confirmed$' <<<"$session" && \
           [[ "$connection" == ${lib.escapeShellArg expectedConnection} ]]; then
          break
        fi
        kill -0 "$agent_pid"
        sleep 0.1
      done
      [[ "$connection" == ${lib.escapeShellArg expectedConnection} ]]
      grep -q '^state=confirmed$' <<<"$session"
      if $sync_content_multi_source_scenario; then
        failure_phase=initialization
      fi

      if $sync_content_multi_source_scenario; then
        if [[ ${lib.escapeShellArg role} == client ]]; then
          secondary_remote_key="''${secondary_remote_address:0:64}"
        fi
        if ! $resumed_guest; then
          # Establish the primary session first, then repeat the same
          # pre-accept/address-rendezvous construction for the second key.
          if [[ ${lib.escapeShellArg role} == client ]]; then
            iotox --runtime "$runtime" transport-peer-request \
              "$secondary_remote_address" \
              "IoTox Sandwurm ${routeMode} secondary content source" \
              >/dev/null
          else
            iotox --runtime "$secondary_runtime" transport-peer-accept \
              "$remote_key" >/dev/null
          fi
        fi
        failure_phase=sync-content-multi-source-secondary-session
        secondary_session=
        secondary_connection=
        if [[ ${lib.escapeShellArg role} == client ]]; then
          secondary_peer_runtime="$runtime"
          secondary_peer_key="$secondary_remote_key"
          secondary_peer_pid="$agent_pid"
        else
          secondary_peer_runtime="$secondary_runtime"
          secondary_peer_key="$remote_key"
          secondary_peer_pid="$secondary_agent_pid"
        fi
        while (( SECONDS < deadline )); do
          secondary_session="$(iotox --runtime "$secondary_peer_runtime" \
            session "$secondary_peer_key" 2>/dev/null || true)"
          secondary_connection="$(iotox --runtime "$secondary_peer_runtime" \
            peers 2>/dev/null | awk -v key="$secondary_peer_key" \
            '$0 ~ "public-key=" key {
              for (i = 1; i <= NF; i++) if ($i ~ /^connection=/) {
                sub(/^connection=/, "", $i); print $i; exit
              }
            }')"
          if grep -q '^state=confirmed$' <<<"$secondary_session" && \
             [[ "$secondary_connection" == \
                ${lib.escapeShellArg expectedConnection} ]]; then
            break
          fi
          kill -0 "$secondary_peer_pid"
          sleep 0.1
        done
        grep -q '^state=confirmed$' <<<"$secondary_session"
        [[ "$secondary_connection" == \
           ${lib.escapeShellArg expectedConnection} ]]
        failure_phase=initialization
      fi

      declare -a stripe_connection=()
      if (( ratox_stripe_routes == 4 )); then
        stripe_remote_key[0]="$remote_key"
        stripe_runtime[0]="$runtime"
        stripe_connection[0]="$connection"
        publish_stripe_progress 1 0
        for lane in 1 2 3; do
          lane_connection=
          lane_retry_count=0
          lane_retry_delay=$((35 + lane * 5))
          if [[ ${lib.escapeShellArg role} == device ]]; then
            lane_retry_delay=$((lane_retry_delay + 7))
          fi
          lane_retry_at=$((SECONDS + lane_retry_delay))
          while (( SECONDS < deadline )); do
            lane_session="$(iotox --runtime "''${stripe_runtime[$lane]}" \
              session "''${stripe_remote_key[$lane]}" 2>/dev/null || true)"
            lane_connection="$(iotox --runtime "''${stripe_runtime[$lane]}" peers 2>/dev/null |
              awk -v key="''${stripe_remote_key[$lane]}" '$0 ~ "public-key=" key {
                for (i = 1; i <= NF; i++) if ($i ~ /^connection=/) {
                  sub(/^connection=/, "", $i); print $i; exit
                }
              }')"
            if grep -q '^state=confirmed$' <<<"$lane_session" && \
               [[ "$lane_connection" == ${lib.escapeShellArg expectedConnection} ]]; then
              break
            fi
            kill -0 "''${stripe_agent_pid[$lane]}"
            if (( SECONDS >= lane_retry_at && lane_retry_count < 2 )); then
              restart_stripe_agent "$lane"
              lane_retry_count=$((lane_retry_count + 1))
              lane_retry_at=$((SECONDS + lane_retry_delay))
              publish_stripe_progress "$lane" "$((lane - 1))"
            fi
            sleep 0.1
          done
          grep -q '^state=confirmed$' <<<"$lane_session"
          [[ "$lane_connection" == ${lib.escapeShellArg expectedConnection} ]]
          stripe_connection[$lane]="$lane_connection"
          publish_stripe_progress "$((lane + 1))" "$lane"
        done
      else
        stripe_remote_key[0]="$remote_key"
        stripe_runtime[0]="$runtime"
        stripe_connection[0]="$connection"
      fi

      observed_online_epoch="$(awk -F= '$1 == "online-epoch" { print $2 }' <<<"$session")"
      [[ "$observed_online_epoch" =~ ^[1-9][0-9]*$ ]]
      if $resumed_guest; then
        recovered_online_epoch="$observed_online_epoch"
      else
        initial_online_epoch="$observed_online_epoch"
        recovered_online_epoch="$initial_online_epoch"
      fi

      message_suffix=
      if $resumed_guest; then
        message_suffix=-after-guest-restart
      fi
      message="iotox-sandwurm-${role}-${routeMode}''${message_suffix}"
      iotox --runtime "$runtime" message "$remote_key" "$message" >/dev/null
      peer_message="iotox-sandwurm-${if role == "client" then "device" else "client"}-${routeMode}''${message_suffix}"
      peer_journal="$runtime/peers/$remote_key/messages"
      while (( SECONDS < deadline )); do
        if [[ -f "$peer_journal" ]] && grep -Fq "$peer_message" "$peer_journal"; then
          break
        fi
        kill -0 "$agent_pid"
        sleep 0.1
      done
      grep -Fq "$peer_message" "$peer_journal"

      relay_interruption_observed=false
      relay_recovery_observed=false
      proxy_interruption_observed=false
      proxy_recovery_observed=false
