            [[ "$destination_corrupt_original_byte" =~ ^[0-9a-f]{2}$ ]]
            [[ "$destination_corrupt_original_byte" != a5 ]]
            printf '\245' | dd of="$destination_corrupt_temporary" bs=1 \
