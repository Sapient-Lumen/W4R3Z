                sleep $(($sync_tree_route_throughput_restart_hold_ms / 1000))
                population_configure_policy "$throughput_policy"
                start_agent
                sync_tree_route_throughput_restart_count=$(($sync_tree_route_throughput_restart_count + 1))
                population_wait_ready 180 "$throughput_label"
                population_run_throughput_phase \
                  "$throughput_label" "$throughput_policy"
                if [[ "$throughput_policy" == fixed ]]; then
                  if [[ -n "$sync_tree_route_throughput_fixed_patterns" ]]; then
                    sync_tree_route_throughput_fixed_patterns+=,
                  fi
                  sync_tree_route_throughput_fixed_patterns+="$sync_tree_route_throughput_last_pattern"
                else
                  if [[ -n "$sync_tree_route_throughput_adaptive_patterns" ]]; then
                    sync_tree_route_throughput_adaptive_patterns+=,
                  fi
                  sync_tree_route_throughput_adaptive_patterns+="$sync_tree_route_throughput_last_pattern"
                fi
              done
              sync_tree_route_throughput_fixed_total_duration_ms=$(($sync_tree_route_throughput_fixed_a_duration_ms + $sync_tree_route_throughput_fixed_b_duration_ms))
              sync_tree_route_throughput_adaptive_total_duration_ms=$(($sync_tree_route_throughput_adaptive_a_duration_ms + $sync_tree_route_throughput_adaptive_b_duration_ms))
              (( sync_tree_route_throughput_fixed_total_duration_ms > 0 ))
              (( sync_tree_route_throughput_adaptive_total_duration_ms > 0 ))
              throughput_policy_artifact_bytes=$((
                4 * sync_tree_route_throughput_artifact_bytes
              ))
              sync_tree_route_throughput_fixed_artifact_bps=$((
                throughput_policy_artifact_bytes * 1000 /
                  sync_tree_route_throughput_fixed_total_duration_ms
              ))
              sync_tree_route_throughput_adaptive_artifact_bps=$((
                throughput_policy_artifact_bytes * 1000 /
                  sync_tree_route_throughput_adaptive_total_duration_ms
