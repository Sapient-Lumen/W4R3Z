              mv "$state_dir/guest-restart.bootstrap-key.tmp" \
                "$state_dir/guest-restart.bootstrap-key"
              printf '%s\n' "$remote_address" \
                >"$state_dir/guest-restart.remote-address.tmp"
              mv "$state_dir/guest-restart.remote-address.tmp" \
                "$state_dir/guest-restart.remote-address"
              printf '%s\n' "$address" \
                >"$state_dir/guest-restart.local-address.tmp"
              mv "$state_dir/guest-restart.local-address.tmp" \
                "$state_dir/guest-restart.local-address"
              printf '%s\n' "$initial_online_epoch" \
                >"$state_dir/guest-restart.initial-online-epoch.tmp"
              mv "$state_dir/guest-restart.initial-online-epoch.tmp" \
                "$state_dir/guest-restart.initial-online-epoch"
              printf '%s\n' "$initial_guest_boot_id" \
                >"$state_dir/guest-restart.initial-boot-id.tmp"
              mv "$state_dir/guest-restart.initial-boot-id.tmp" \
                "$state_dir/guest-restart.initial-boot-id"
              printf 'pending=1\n' >"$state_dir/guest-restart.pending.tmp"
              mv "$state_dir/guest-restart.pending.tmp" \
                "$state_dir/guest-restart.pending"
              sync -f "$state_dir"
              printf 'sync-guest-restart-armed=1\n' \
                >"$rendezvous_dir/device.sync-guest-restart-armed.tmp"
              mv "$rendezvous_dir/device.sync-guest-restart-armed.tmp" \
                "$rendezvous_dir/device.sync-guest-restart-armed"
              systemctl reboot --no-block
              while true; do sleep 1; done
            fi
          elif $sync_restart_scenario; then
            observe_sync_process_restart \
              sync-observe-restart \
              device.sync-restart-armed \
              device.sync-offline-observed \
              device.sync-recovered
          elif $sync_disconnect_scenario; then
            sync_observe_name=sync-observe-restart
            sync_armed_name=device.sync-restart-armed
            sync_offline_name=device.sync-offline-observed
            sync_recovered_name=device.sync-recovered
            if $sync_disconnect_scenario; then
              sync_observe_name=sync-observe-disconnect
              sync_armed_name=device.sync-disconnect-armed
              sync_offline_name=device.sync-disconnect-offline
              sync_recovered_name=device.sync-disconnect-recovered
            fi
            wait_for_file "$input_dir/$sync_observe_name"
            rm -f "$input_dir/$sync_observe_name"
            printf 'sync-fault-armed=1\n' \
              >"$rendezvous_dir/$sync_armed_name.tmp"
            mv "$rendezvous_dir/$sync_armed_name.tmp" \
              "$rendezvous_dir/$sync_armed_name"

            required_sync_stable_samples=1
            if $sync_disconnect_scenario; then
              required_sync_stable_samples=50
            fi
            stable_sync_epoch=0
            stable_sync_samples=0
            sync_recovery_probe_samples=0
            while (( SECONDS < deadline )); do
              session="$(iotox --runtime "$runtime" session "$remote_key" 2>/dev/null || true)"
              authority="$(iotox --runtime "$runtime" authority-session "$remote_key" 2>/dev/null || true)"
              connection="$(iotox --runtime "$runtime" peers 2>/dev/null |
                awk -v key="$remote_key" '$0 ~ "public-key=" key {
                  for (i = 1; i <= NF; i++) if ($i ~ /^connection=/) {
                    sub(/^connection=/, "", $i); print $i; exit
                  }
                }')"
              if grep -q '^state=offline$' <<<"$session" && \
                 [[ "$connection" == offline ]]; then
                break
              fi
              kill -0 "$agent_pid"
              sleep 0.1
            done
            grep -q '^state=offline$' <<<"$session"
            [[ "$connection" == offline ]]
            sync_peer_offline_observed=true
            if $sync_disconnect_scenario; then
              link_interruption_observed=true
            fi
            printf 'sync-offline-observed=1\n' \
              >"$rendezvous_dir/$sync_offline_name.tmp"
            mv "$rendezvous_dir/$sync_offline_name.tmp" \
              "$rendezvous_dir/$sync_offline_name"

            while (( SECONDS < deadline )); do
              session="$(iotox --runtime "$runtime" session "$remote_key" 2>/dev/null || true)"
              authority="$(iotox --runtime "$runtime" authority-session "$remote_key" 2>/dev/null || true)"
              connection="$(iotox --runtime "$runtime" peers 2>/dev/null |
                awk -v key="$remote_key" '$0 ~ "public-key=" key {
                  for (i = 1; i <= NF; i++) if ($i ~ /^connection=/) {
                    sub(/^connection=/, "", $i); print $i; exit
                  }
                }')"
              recovered_sync_epoch="$(awk -F= '$1 == "online-epoch" { print $2 }' \
                <<<"$session")"
              if grep -q '^state=confirmed$' <<<"$session" && \
                 [[ "$connection" == ${lib.escapeShellArg expectedConnection} ]] && \
                 grep -q '^remote-authorized=1$' <<<"$authority" && \
                 [[ "$recovered_sync_epoch" =~ ^[1-9][0-9]*$ ]] && \
                 (( recovered_sync_epoch > initial_online_epoch )); then
                if (( recovered_sync_epoch == stable_sync_epoch )); then
                  (( ++stable_sync_samples ))
                else
                  stable_sync_epoch="$recovered_sync_epoch"
                  stable_sync_samples=1
                fi
                if (( stable_sync_samples >= required_sync_stable_samples )); then
                  break
                fi
              else
                stable_sync_epoch=0
                stable_sync_samples=0
              fi
              if $sync_disconnect_scenario; then
                sync_recovery_probe_samples=$((sync_recovery_probe_samples + 1))
                if (( sync_recovery_probe_samples == 1 ||
                      sync_recovery_probe_samples % 10 == 0 ||
                      stable_sync_samples >= required_sync_stable_samples )); then
                  {
                    printf 'initial-online-epoch=%s\n' "$initial_online_epoch"
                    printf 'observed-online-epoch=%s\n' "$recovered_sync_epoch"
                    printf 'session-state=%s\n' \
                      "$(awk -F= '$1 == "state" { print $2 }' <<<"$session")"
                    printf 'connection=%s\n' "$connection"
                    printf 'remote-authorized=%s\n' \
                      "$(awk -F= '$1 == "remote-authorized" { print $2 }' <<<"$authority")"
                    printf 'stable-epoch=%s\n' "$stable_sync_epoch"
                    printf 'stable-samples=%s\n' "$stable_sync_samples"
                    printf 'probe-samples=%s\n' "$sync_recovery_probe_samples"
                  } >"$rendezvous_dir/device.sync-disconnect-probe.tmp"
                  mv "$rendezvous_dir/device.sync-disconnect-probe.tmp" \
                    "$rendezvous_dir/device.sync-disconnect-probe"
                fi
              fi
              kill -0 "$agent_pid"
              sleep 0.1
            done
            grep -q '^state=confirmed$' <<<"$session"
            [[ "$connection" == ${lib.escapeShellArg expectedConnection} ]]
            grep -q '^remote-authorized=1$' <<<"$authority"
            (( stable_sync_samples >= required_sync_stable_samples ))
            (( stable_sync_epoch > initial_online_epoch ))
            recovered_online_epoch="$stable_sync_epoch"
            if $sync_disconnect_scenario; then
              link_recovery_observed=true
              sync_disconnect_stable_samples="$stable_sync_samples"
            else
              sync_restart_observed=true
              sync_restart_recovery_observed=true
              sync_restart_identity_preserved=true
            fi
            printf 'sync-recovered=1\n' \
              >"$rendezvous_dir/$sync_recovered_name.tmp"
            mv "$rendezvous_dir/$sync_recovered_name.tmp" \
              "$rendezvous_dir/$sync_recovered_name"
          fi
          if $signed_update_scenario; then
            failure_phase=signed-update-remote-issue
            wait_for_file "$input_dir/signed-update-stage-ready"
            signed_update_stage_ready="$(<"$input_dir/signed-update-stage-ready")"
            rm -f "$input_dir/signed-update-stage-ready"
            grep -q "^head-record=$sync_head_record$" \
              <<<"$signed_update_stage_ready"
            signed_update_issue="$(iotox --runtime "$runtime" command \
              "$remote_key" update.stage "$sync_head_record" high)"
            grep -q '^operation=update.stage$' <<<"$signed_update_issue"
            grep -qi "^expected-update-head=$sync_head_record$" \
              <<<"$signed_update_issue"
            signed_update_sender_epoch="$(awk -F= \
              '$1 == "sender-epoch" { print $2 }' \
              <<<"$signed_update_issue")"
            signed_update_message_id="$(awk -F= \
              '$1 == "message-id" { print $2 }' \
              <<<"$signed_update_issue")"
            [[ "$signed_update_sender_epoch" =~ ^[1-9][0-9]*$ ]]
            [[ "$signed_update_message_id" =~ ^[1-9][0-9]*$ ]]
            signed_update_outgoing=
            while (( SECONDS < deadline )); do
              signed_update_outgoing="$(iotox --runtime "$runtime" \
                command-record outgoing "$remote_key" \
                "$signed_update_sender_epoch" \
                "$signed_update_message_id" 2>/dev/null || true)"
              if grep -q '^lifecycle=succeeded$' \
                   <<<"$signed_update_outgoing" && \
                 grep -q '^outcome=succeeded$' \
                   <<<"$signed_update_outgoing"; then
                break
              fi
              kill -0 "$agent_pid"
              sleep 0.1
            done
            grep -q '^lifecycle=succeeded$' <<<"$signed_update_outgoing"
            grep -q '^operation=update.stage$' <<<"$signed_update_outgoing"
            grep -q '^outcome=succeeded$' <<<"$signed_update_outgoing"
            grep -qi "^expected-update-head=$sync_head_record$" \
              <<<"$signed_update_outgoing"
            grep -q '^update-staged=1$' <<<"$signed_update_outgoing"
            grep -q '^update-sequence=1$' <<<"$signed_update_outgoing"
            grep -qi "^update-accepted-head=$sync_head_record$" \
              <<<"$signed_update_outgoing"
            grep -qi "^update-manifest-record=$signed_update_manifest_record$" \
              <<<"$signed_update_outgoing"
            signed_update_remote_stage_observed=true
            {
              printf 'head-record=%s\n' "$sync_head_record"
              printf 'sender-epoch=%s\n' "$signed_update_sender_epoch"
              printf 'message-id=%s\n' "$signed_update_message_id"
              printf 'remote-stage=1\n'
              printf 'remote-stage-outcome=succeeded\n'
              printf 'remote-stage-sequence=1\n'
              printf 'remote-stage-manifest-record=%s\n' \
                "$signed_update_manifest_record"
            } >"$rendezvous_dir/device.update-stage-complete.tmp"
            mv "$rendezvous_dir/device.update-stage-complete.tmp" \
              "$rendezvous_dir/device.update-stage-complete"
          fi
          if $sync_content_multi_source_loss_scenario; then
            failure_phase=sync-content-multi-source-loss
            multi_source_loss_selection_deadline=$((SECONDS + 300))
            while (( SECONDS < multi_source_loss_selection_deadline )); do
              secondary_content_status="$(iotox --runtime \
                "$secondary_runtime" sync-status 2>/dev/null || true)"
              multi_source_loss_secondary_requests_before_stop="$(awk \
                'NR == 1 {
                  for (i=1;i<=NF;i++) if ($i ~ \
                    /^content-object-requests=/) {
                    sub(/^content-object-requests=/,"",$i); print $i
                  }
                }' <<<"$secondary_content_status")"
              if [[ "$multi_source_loss_secondary_requests_before_stop" =~ \
                    ^[1-9][0-9]*$ ]]; then
                break
              fi
              kill -0 "$secondary_agent_pid"
              sleep 0.1
            done
            [[ "$multi_source_loss_secondary_requests_before_stop" =~ \
              ^[1-9][0-9]*$ ]]
            {
              printf 'schema=iotox-content-multi-source-loss-ready-v1\n'
              printf 'secondary-object-requests=%s\n' \
                "$multi_source_loss_secondary_requests_before_stop"
            } >"$rendezvous_dir/device.multi-source-loss-ready.tmp"
            mv "$rendezvous_dir/device.multi-source-loss-ready.tmp" \
              "$rendezvous_dir/device.multi-source-loss-ready"
            wait_for_file "$input_dir/multi-source-loss-inject"
            rm -f "$input_dir/multi-source-loss-inject"
            stop_secondary_agent
            printf 'secondary-stopped=1\n' \
              >"$rendezvous_dir/device.multi-source-loss-stopped.tmp"
            mv "$rendezvous_dir/device.multi-source-loss-stopped.tmp" \
              "$rendezvous_dir/device.multi-source-loss-stopped"
            wait_for_file "$input_dir/multi-source-loss-restart"
            rm -f "$input_dir/multi-source-loss-restart"
            # The source is a custody-authenticated availability replica, not
            # the foreign writer and never a local publication.  Its partial
            # graph must remain a GC root and become publishable after a true
            # cold start with no post-start reinjection.
            secondary_replica_head="$secondary_sync_root/replica-heads/sandwurm-file.replica-head"
            [[ -f "$secondary_replica_head" ]]
            [[ ! -e \
              "$secondary_sync_root/published-heads/sandwurm-file.signed-head" ]]
            start_secondary_agent
            [[ -f "$secondary_replica_head" ]]
            [[ ! -e \
              "$secondary_sync_root/published-heads/sandwurm-file.signed-head" ]]
            secondary_replica_gc="$(iotox --runtime "$secondary_runtime" \
              sync-gc sandwurm-file dry-run)"
            grep -q '^namespace=sandwurm-file engine=content-v2 mode=dry-run consistent=1 traversal-complete=1 rollback-guard-consistent=1 ' \
              <<<"$secondary_replica_gc"
            grep -q ' candidates=0 candidate-bytes=0 purge=disabled$' \
              <<<"$secondary_replica_gc"
            multi_source_loss_durable_replica_cold_start=true
            multi_source_loss_restart_count=1
            multi_source_loss_restart_deadline=$((SECONDS + 300))
            while (( SECONDS < multi_source_loss_restart_deadline )); do
              secondary_session="$(iotox --runtime "$secondary_runtime" \
                session "$remote_key" 2>/dev/null || true)"
              secondary_connection="$(iotox --runtime "$secondary_runtime" \
                peers 2>/dev/null | awk -v key="$remote_key" \
                '$0 ~ "public-key=" key {
                  for (i=1;i<=NF;i++) if ($i ~ /^connection=/) {
                    sub(/^connection=/,"",$i); print $i; exit
                  }
                }')"
              if grep -q '^state=confirmed$' <<<"$secondary_session" && \
                 [[ "$secondary_connection" == \
                   ${lib.escapeShellArg expectedConnection} ]]; then
                break
              fi
              kill -0 "$secondary_agent_pid"
              sleep 0.1
            done
            grep -q '^state=confirmed$' <<<"$secondary_session"
            [[ "$secondary_connection" == \
              ${lib.escapeShellArg expectedConnection} ]]
            {
              printf 'schema=iotox-content-multi-source-loss-recovered-v1\n'
              printf 'secondary-recovered=1\n'
              printf 'durable-replica-head-cold-start=1\n'
              printf 'published-head-absent=1\n'
              printf 'replica-gc-consistent=1\n'
            } >"$rendezvous_dir/device.multi-source-loss-recovered.tmp"
            mv "$rendezvous_dir/device.multi-source-loss-recovered.tmp" \
              "$rendezvous_dir/device.multi-source-loss-recovered"
          fi
          if $sync_range_triple_route_loss_scenario; then
            while [[ ! -s "$input_dir/sync-finished" ]]; do
              (( SECONDS < deadline ))
