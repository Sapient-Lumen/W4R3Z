maximum-lanes=$sync_maximum_lanes
maximum-outstanding-requests=$sync_maximum_outstanding_requests
writer=''${publisher_principal,,}
subscriber=''${subscriber_principal,,}
POLICY
          chmod 0600 "$sync_policy_store/namespaces/sandwurm-file.namespace"
          ! grep -q '^$' \
