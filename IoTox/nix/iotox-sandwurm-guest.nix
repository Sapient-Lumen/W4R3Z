            [[ "$sync_tree_control_replay_head_record" =~ ^[0-9a-f]{64}$ ]]
            [[ "$sync_tree_control_replay_artifact_sha256" =~ ^[0-9a-f]{64}$ ]]
            [[ "$sync_tree_control_replay_manifest_sha256" =~ ^[0-9a-f]{64}$ ]]
            [[ "$control_payload" =~ ^[0-9a-f]{64}$ ]]
            [[ "$sync_tree_control_replay_head_record" != "$sync_head_record" ]]
            (( control_artifact_bytes == sync_artifact_bytes ))
            (( control_manifest_bytes == sync_manifest_bytes ))

            control_protocol="$runtime/peers/$remote_key/protocol"
            [[ -f "$control_protocol" ]]
            control_journal_count() {
              local control_direction=$1
              local control_type=$2
              awk -v direction="$control_direction" -v type="$control_type" '
                index($0, " direction=" direction " ") &&
                index($0, " type=" type " ") { ++count }
                END { print count + 0 }
              ' "$control_protocol"
            }
            control_frame_hex() {
              python3 - "$1" <<'PY'
import re
import struct
import sys

line = sys.argv[1]
match = re.search(
    r"protocol=(\d+)\.(\d+) type=([^ ]+) flags=(\d+) "
    r"message-id=(\d+) correlation-id=(\d+) sequence=(\d+) "
    r"expiry-unix-ms=(\d+) payload-bytes=(\d+) payload=(.*)$",
    line,
)
if match is None:
    raise SystemExit("protocol journal line is not canonical")
major, minor, kind, flags, message, correlation, sequence, expiry, size, escaped = match.groups()
types = {"sync-head-request": 20, "sync-object-request": 22}
if kind not in types:
    raise SystemExit("journal line is not a replayable sync request")
payload = bytearray()
index = 0
while index < len(escaped):
    value = escaped[index]
    if value != "\\":
        payload.append(ord(value))
        index += 1
        continue
    index += 1
    if index >= len(escaped):
        raise SystemExit("truncated journal escape")
    escape = escaped[index]
    if escape == "x":
        if index + 2 >= len(escaped):
            raise SystemExit("truncated hexadecimal journal escape")
        payload.append(int(escaped[index + 1:index + 3], 16))
        index += 3
        continue
    mapping = {"\\": 92, "n": 10, "r": 13, "t": 9, "=": 61}
    if escape not in mapping:
        raise SystemExit("unknown journal escape")
    payload.append(mapping[escape])
    index += 1
if len(payload) != int(size):
    raise SystemExit("journal payload length does not match its evidence")
packet = bytes((0xA0, int(major), int(minor), types[kind], int(flags)))
packet += struct.pack(
    ">IQQQQ", len(payload), int(message), int(correlation), int(sequence), int(expiry)
)
packet += payload
print(packet.hex())
PY
            }
            control_lines_before="$(wc -l <"$control_protocol")"
            control_head_in_before="$(control_journal_count incoming \
              sync-head-result)"
            control_object_in_before="$(control_journal_count incoming \
              sync-object-result)"
            control_object_out_before="$(control_journal_count outgoing \
              sync-object-request)"
            control_accepted="$sync_root/accepted-heads/sandwurm-file.accepted-head"
            control_activation="$sync_root/activated-revisions/sandwurm-file.activated-revision"
            control_current="$sync_root/materialized-trees/current"
