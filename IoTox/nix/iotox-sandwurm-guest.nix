                  sub(/^file-id=/,"",$i); print tolower($i); exit
                }
              }' <<<"$sync_range_retry_line")"
              [[ "$sync_range_retry_second_file_id" =~ ^[0-9a-f]{64}$ ]]
              [[ "$sync_range_retry_second_file_id" != \
                "$sync_range_retry_first_file_id" ]]
            fi
            sync_range_status_line=
            while (( SECONDS < deadline )); do
              sync_status="$(iotox --runtime "$runtime" sync-status 2>/dev/null || true)"
              sync_range_status_line="$(awk -v job="$sync_pull_job_id" \
                '$1 == "job=" job { print; exit }' <<<"$sync_status")"
              if $sync_range_actual_i2p_loss_scenario; then
                actual_i2p_repull_state="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^state=/) {
                    sub(/^state=/,"",$i); print $i; exit
                  }
                }' <<<"$sync_range_status_line")"
                actual_i2p_repull_requested="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^requested=/) {
                    sub(/^requested=/,"",$i); print $i; exit
                  }
                }' <<<"$sync_range_status_line")"
                actual_i2p_repull_committed="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^committed=/) {
                    sub(/^committed=/,"",$i); print $i; exit
                  }
                }' <<<"$sync_range_status_line")"
                actual_i2p_repull_active="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^carrier-active-receives=/) {
                    sub(/^carrier-active-receives=/,"",$i); print $i; exit
                  }
                }' <<<"$sync_range_status_line")"
                actual_i2p_repull_position="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^carrier-receive-position=/) {
                    sub(/^carrier-receive-position=/,"",$i); print $i; exit
                  }
                }' <<<"$sync_range_status_line")"
                actual_i2p_repull_bytes="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^carrier-receive-bytes=/) {
                    sub(/^carrier-receive-bytes=/,"",$i); print $i; exit
                  }
                }' <<<"$sync_range_status_line")"
                actual_i2p_repull_range_active="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^range-lane-active=/) {
                    sub(/^range-lane-active=/,"",$i); print $i; exit
                  }
                }' <<<"$sync_range_status_line")"
                actual_i2p_repull_bundle="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^range-bundle-bytes=/) {
                    sub(/^range-bundle-bytes=/,"",$i); print $i; exit
                  }
                }' <<<"$sync_range_status_line")"
                actual_i2p_repull_status_sha256="$(printf '%s' \
                  "$sync_range_status_line" | sha256sum | cut -d' ' -f1)"
                (( actual_i2p_repull_samples += 1 ))
                if (( actual_i2p_repull_samples == 1 ||
                      actual_i2p_repull_samples % 10 == 0 )); then
                  {
                    printf 'schema=iotox-actual-i2p-repull-progress-v1\n'
                    printf 'samples=%s\n' "$actual_i2p_repull_samples"
                    printf 'elapsed-seconds=%s\n' "$SECONDS"
                    printf 'replacement-job=%s\n' "$sync_pull_job_id"
                    printf 'state=%s\n' "$actual_i2p_repull_state"
                    printf 'requested=%s\n' "$actual_i2p_repull_requested"
                    printf 'committed=%s\n' "$actual_i2p_repull_committed"
