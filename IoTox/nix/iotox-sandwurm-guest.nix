          fi
          if $sync_tree_route_cancel_scenario && \
             [[ ${lib.escapeShellArg role} == client ]]; then
            # Exercise local withdrawal through the experimental load-aware
            # selector. The proof below binds the cancellation to this exact
            # authenticated carrier and signed work admission.
            agent_args+=(--sync-route-policy adaptive)
            if $sync_tree_route_cancel_loss_scenario; then
              agent_args+=(--qualify-route-stop-after-cancel)
            fi
          fi
          if $sync_tree_route_startup_order_scenario; then
            qualification_first_value_index=$((''${#agent_args[@]} + 1))
            agent_args+=(--qualify-route-first-worker \
              "''${route_worker_key[1]}")
            agent_args+=(--qualify-route-other-delay-ms 20000)
          fi
          if { $sync_tree_route_actual_tor_payload_scenario || \
               $sync_tree_route_actual_i2p_payload_scenario || \
               $sync_range_actual_i2p_scenario || \
