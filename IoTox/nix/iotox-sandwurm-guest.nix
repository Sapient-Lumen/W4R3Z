                  }
                }' <<<"$actual_i2p_loss_job")"
                actual_i2p_range_lane_active="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^range-lane-active=/) {
                    sub(/^range-lane-active=/,"",$i); print $i; exit
                  }
                }' <<<"$actual_i2p_loss_job")"
                actual_i2p_range_bundle_bytes="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^range-bundle-bytes=/) {
                    sub(/^range-bundle-bytes=/,"",$i); print $i; exit
                  }
                }' <<<"$actual_i2p_loss_job")"
                if [[ "$actual_i2p_loss_carrier" == \
                      "''${route_worker_key[$private_route_tor_lane]}" ]] && \
                   [[ "$actual_i2p_loss_worker" =~ ^[1-9][0-9]*$ ]] && \
                   [[ "$actual_i2p_range_lane_active" == 1 ]] && \
                   [[ "$actual_i2p_range_bundle_bytes" =~ ^[1-9][0-9]*$ ]] && \
                   [[ "$actual_i2p_fail_closed_loss_position_bytes" =~ \
                      ^[1-9][0-9]*$ ]] && \
                   (( actual_i2p_fail_closed_loss_position_bytes >= 65536 && \
                      actual_i2p_fail_closed_loss_position_bytes < \
                        actual_i2p_range_bundle_bytes )); then
                  break
                fi
                if grep -Eq ' state=(complete|failed) ' \
                     <<<" $actual_i2p_loss_job "; then
                  printf '%s\n' "$actual_i2p_loss_job" >&2
                  exit 1
                fi
                agent_is_running "$agent_pid"
                sleep 0.05
              done
              [[ "$actual_i2p_loss_carrier" == \
                "''${route_worker_key[$private_route_tor_lane]}" ]]
              (( actual_i2p_fail_closed_loss_position_bytes >= 65536 ))
              [[ "$actual_i2p_range_lane_active" == 1 ]]
              [[ "$actual_i2p_range_bundle_bytes" =~ ^[1-9][0-9]*$ ]]
              (( actual_i2p_fail_closed_loss_position_bytes < \
                 actual_i2p_range_bundle_bytes ))
              actual_i2p_fail_closed_loss_original_job_id="$sync_pull_job_id"
              actual_i2p_fail_closed_loss_carrier_sha256="$(printf '%s' \
