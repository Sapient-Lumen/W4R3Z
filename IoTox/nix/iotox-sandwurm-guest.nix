            control_activation_before="$(sha256sum "$control_activation" | cut -d' ' -f1)"
            control_current_before="$(readlink "$control_current")"

            control_pull="$(iotox --runtime "$runtime" sync-pull \
              "$remote_key" sandwurm-file)"
            control_job="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^job=/) {
                sub(/^job=/,"",$i); print $i
              }
            }' <<<"$control_pull")"
            [[ "$control_job" =~ ^[1-9][0-9]*$ ]]
            control_head_line=
            control_object_lines=()
            while (( SECONDS < deadline )); do
              control_status="$(iotox --runtime "$runtime" sync-status \
                2>/dev/null || true)"
              control_job_line="$(awk -v job="$control_job" \
                '$1 == "job=" job { print; exit }' <<<"$control_status")"
