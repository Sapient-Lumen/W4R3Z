                    sub(/^qualification-deferred-frame-releases=/,"",$i); print $i; exit
                  }
                }' <<<"$range_loss_header")"
                if (( final_ready_bulk == 2 )) && \
                   grep -q ' lifecycle=ready ' <<<" $recovered_route " && \
                   grep -q \
                     " restarts=$expected_stopped_route_restarts " \
                     <<<" $recovered_route " && \
                   [[ "$sync_tree_route_loss_recoveries" == \
