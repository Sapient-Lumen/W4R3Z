      sync_automation_generation_2_sha256=
      sync_automation_generation_3_sha256=
      if $sync_bidirectional_scenario; then
        failure_phase=sync-bidirectional-authority
        recall_phrase='abnormal abrasion abrasive abreast abridge abroad abruptly absence'
        bootstrap_output="$(printf '%s\n' "$recall_phrase" |
          iotox --runtime "$runtime" authority-bootstrap-recall-stdin)"
        owner_principal="$(awk -F= '$1 == "owner-public-key" { print $2 }' \
          <<<"$bootstrap_output")"
        [[ "$owner_principal" =~ ^[0-9A-Fa-f]{64}$ ]]
        printf '%s\n' "$recall_phrase" |
          iotox --runtime "$runtime" authority-migrate-v2-recall-stdin >/dev/null
        printf '%s\n' "$recall_phrase" |
          iotox --runtime "$runtime" authority-migrate-v3-recall-stdin all >/dev/null
        printf '%s\n' "$recall_phrase" |
          iotox --runtime "$runtime" authority-grant-recall-stdin \
            "$owner_principal" owner all-v3 >/dev/null

        sync_worktree="$state_dir/bidirectional-worktree"
        install -d -m 0700 "$sync_worktree"
        printf 'common baseline\n' >"$sync_worktree/note.txt"
        chmod 0600 "$sync_worktree/note.txt"
        sync_create="$(iotox --runtime "$runtime" sync-create \
          field-notes "$sync_worktree" read-write 1)"
        grep -q ' engine=tree-v2 access=read-write ' <<<" $sync_create "

        failure_phase=sync-bidirectional-share
        sync_share="$(printf '%s\n' "$recall_phrase" |
          iotox --runtime "$runtime" sync-share \
            field-notes "$remote_key" read-write)"
        grep -q ' access=read-write ' <<<" $sync_share "
        grep -q ' membership=added ' <<<" $sync_share "

        sync_authority=
        sync_status=
        sync_repair=
        sync_progress_next=0
        while (( SECONDS < deadline )); do
          sync_authority="$(iotox --runtime "$runtime" \
            authority-session "$remote_key" 2>/dev/null || true)"
          sync_status="$(iotox --runtime "$runtime" sync-status \
            2>/dev/null || true)"
          sync_repair="$(iotox --runtime "$runtime" sync-repair \
            field-notes 2>/dev/null || true)"
          if grep -q '^remote-authorized=1$' <<<"$sync_authority" && \
             grep -q ' automation-bidirectional=1 ' \
               <<<" $sync_status " && \
             grep -q ' engine=tree-v2 branches=2 ' \
               <<<" $sync_repair "; then
            break
          fi
          if (( SECONDS >= sync_progress_next )); then
            sync_remote_authorized=0
            sync_automation_bidirectional=0
            sync_repair_branches=0
            sync_repair_verified=0
            grep -q '^remote-authorized=1$' <<<"$sync_authority" && \
              sync_remote_authorized=1
            grep -q ' automation-bidirectional=1 ' \
              <<<" $sync_status " && sync_automation_bidirectional=1
            sync_repair_branches="$(awk '{ for (i = 1; i <= NF; ++i) \
              if ($i ~ /^branches=/) { sub(/^branches=/, "", $i); \
              print $i; exit } }' <<<"$sync_repair")"
            [[ "$sync_repair_branches" =~ ^[0-9]+$ ]] || \
              sync_repair_branches=0
            grep -q ' verified=1$' <<<"$sync_repair" && \
              sync_repair_verified=1
            {
              printf 'schema=iotox-sync-bidirectional-progress-v1\n'
              printf 'phase=initial-convergence\n'
              printf 'remote-authorized=%s\n' "$sync_remote_authorized"
              printf 'automation-bidirectional=%s\n' \
                "$sync_automation_bidirectional"
              printf 'repair-branches=%s\n' "$sync_repair_branches"
              printf 'repair-verified=%s\n' "$sync_repair_verified"
              printf 'sync-status=%s\n' "$sync_status"
            } >"$rendezvous_dir/${role}.sync-bidirectional-progress.tmp"
            mv "$rendezvous_dir/${role}.sync-bidirectional-progress.tmp" \
              "$rendezvous_dir/${role}.sync-bidirectional-progress"
            sync_progress_next=$((SECONDS + 5))
          fi
          agent_is_running "$agent_pid"
          sleep 0.2
        done
        grep -q '^remote-authorized=1$' <<<"$sync_authority"
        grep -q ' automation-bidirectional=1 ' <<<" $sync_status "
        grep -q ' engine=tree-v2 branches=2 ' <<<" $sync_repair "

        peer_role=${if role == "client" then "device" else "client"}
        peer_journal="$runtime/peers/$remote_key/messages"
        baseline_marker="iotox-bidirectional-baseline-${role}"
        peer_baseline_marker="iotox-bidirectional-baseline-$peer_role"
        iotox --runtime "$runtime" message "$remote_key" \
          "$baseline_marker" >/dev/null
        while (( SECONDS < deadline )); do
          [[ -f "$peer_journal" ]] && \
            grep -Fq "$peer_baseline_marker" "$peer_journal" && break
          agent_is_running "$agent_pid"
          sleep 0.1
        done
        grep -Fq "$peer_baseline_marker" "$peer_journal"

        # Both daemons now stop after a transcript-confirmed Tox barrier. Each
        # waits for a host-released barrier proving that both processes are
        # down. Each worktree then changes while its peer is offline; startup
        # reconciliation must publish the local write before accepting the
        # remote frontier.
        failure_phase=sync-bidirectional-offline-edit
        stop_agent
        printf 'stopped=1\n' \
          >"$rendezvous_dir/${role}.sync-bidirectional-stopped.tmp"
        mv "$rendezvous_dir/${role}.sync-bidirectional-stopped.tmp" \
          "$rendezvous_dir/${role}.sync-bidirectional-stopped"
        wait_for_file "$input_dir/sync-bidirectional-restart"
        rm "$input_dir/sync-bidirectional-restart"
        local_edit="offline edit from ${role}"
        peer_edit="offline edit from $peer_role"
        printf '%s\n' "$local_edit" >"$sync_worktree/note.txt"
        chmod 0600 "$sync_worktree/note.txt"
        start_agent
        sync_bidirectional_restart_count=1

        recovered_session=
        recovered_authority=
        while (( SECONDS < deadline )); do
          recovered_session="$(iotox --runtime "$runtime" session \
            "$remote_key" 2>/dev/null || true)"
          recovered_authority="$(iotox --runtime "$runtime" \
            authority-session "$remote_key" 2>/dev/null || true)"
          if grep -q '^state=confirmed$' <<<"$recovered_session" && \
             grep -q '^remote-authorized=1$' <<<"$recovered_authority"; then
            break
          fi
          agent_is_running "$agent_pid"
          sleep 0.1
        done
        grep -q '^state=confirmed$' <<<"$recovered_session"
        grep -q '^remote-authorized=1$' <<<"$recovered_authority"
        recovered_online_epoch="$(awk -F= \
          '$1 == "online-epoch" { print $2 }' <<<"$recovered_session")"
        [[ "$recovered_online_epoch" =~ ^[1-9][0-9]*$ ]]

        if [[ "$device_principal" < "$remote_principal" ]]; then
          expected_projection="$local_edit"
          expected_conflict="$peer_edit"
        else
          expected_projection="$peer_edit"
          expected_conflict="$local_edit"
        fi
        failure_phase=sync-bidirectional-conflict
        conflict_file=
        while (( SECONDS < deadline )); do
          if [[ -f "$sync_worktree/note.txt" ]] && \
             [[ "$(tr -d '\n' <"$sync_worktree/note.txt")" == \
                "$expected_projection" ]] && \
             [[ -d "$sync_worktree/.iotox-conflicts/by-origin" ]]; then
            conflict_file="$(grep -Frl -- "$expected_conflict" \
              "$sync_worktree/.iotox-conflicts/by-origin" 2>/dev/null | \
              head -n 1 || true)"
