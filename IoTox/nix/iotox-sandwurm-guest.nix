              fi
              if grep -q ' state=failed ' <<<"$sync_range_status_line"; then
                printf '%s\n' "$sync_range_status_line" >&2
                exit 1
              fi
              kill -0 "$agent_pid"
              sleep 0.1
            done
            grep -q ' state=complete ' <<<"$sync_range_status_line"
            if $sync_range_route_loss_scenario; then
