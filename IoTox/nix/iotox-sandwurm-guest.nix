                awk '{ total += $1 } END { print total + 0 }')"
              (( sync_interrupted_staging_bytes > 0 ))
              (( sync_interrupted_staging_bytes < \
                 sync_artifact_bytes + sync_manifest_bytes ))
            fi
            sync_attempt_journal_present=0
            sync_accepted_head_present=0
            sync_activation_present=0
            if $sync_content_restart_scenario; then
              [[ ! -s \
                "$sync_root/content-attempts/sandwurm-file.active-content-attempts" ]] || \
