              mv "$rendezvous_dir/client.sync-range-reconnect-ready.tmp" \
                "$rendezvous_dir/client.sync-range-reconnect-ready"
              wait_for_file "$input_dir/sync-range-repull"
              rm -f "$input_dir/sync-range-repull"
              sync_range_restart_repull="$(iotox --runtime "$runtime" \
                sync-pull "$remote_key" sandwurm-file)"
              sync_range_restart_second_job_id="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^job=/) {
                  sub(/^job=/,"",$i); print $i; exit
                }
              }' <<<"$sync_range_restart_repull")"
              [[ "$sync_range_restart_second_job_id" =~ ^[1-9][0-9]*$ ]]
              [[ "$sync_range_restart_second_job_id" != \
                "$sync_range_restart_first_job_id" ]]
              sync_pull_job_id="$sync_range_restart_second_job_id"

              sync_range_restart_reacquired_line=
              sync_range_restart_second_file_line=
              sync_range_restart_second_position=
              while (( SECONDS < deadline )); do
                sync_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                sync_range_restart_reacquired_line="$(awk \
                  -v job="$sync_pull_job_id" \
                  '$1 == "job=" job { print; exit }' <<<"$sync_status")"
                sync_files="$(iotox --runtime "$runtime" files \
                  2>/dev/null || true)"
                sync_range_restart_second_file_line="$(awk \
                  -v size="$sync_range_restart_bundle" '
                  /direction=incoming/ && /state=active/ {
                    found=0
                    for (i=1;i<=NF;i++) if ($i == "size=" size) found=1
                    if (found) { print; exit }
                  }' <<<"$sync_files")"
                sync_range_restart_second_position="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^position=/) {
                    sub(/^position=/,"",$i); print $i; exit
                  }
                }' <<<"$sync_range_restart_second_file_line")"
                if grep -q ' range-lane-active=1 ' \
                     <<<" $sync_range_restart_reacquired_line " && \
                   grep -q ' range-restart-resumed-attempts=1 ' \
                     <<<" $sync_range_restart_reacquired_line " && \
                   grep -q \
                     " range-restart-resumed-bytes=$sync_range_restart_interrupted_bytes " \
                     <<<" $sync_range_restart_reacquired_line " && \
                   [[ "$sync_range_restart_second_position" =~ \
                      ^[1-9][0-9]*$ ]] && \
                   (( sync_range_restart_second_position >= \
                        sync_range_restart_interrupted_bytes && \
                      sync_range_restart_second_position < \
                        sync_range_restart_bundle )) && \
                   [[ -n "$sync_range_restart_second_file_line" ]]; then
                  break
                fi
                if grep -q ' state=failed ' \
                     <<<" $sync_range_restart_reacquired_line "; then
                  printf '%s\n' "$sync_range_restart_reacquired_line" >&2
                  exit 1
                fi
                kill -0 "$agent_pid"
                sleep 0.05
              done
              sync_range_restart_second_attempt_id="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^range-attempt=/) {
                  sub(/^range-attempt=/,"",$i); print $i; exit
                }
              }' <<<"$sync_range_restart_reacquired_line")"
              sync_range_restart_second_message_id="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^range-message=/) {
                  sub(/^range-message=/,"",$i); print $i; exit
                }
              }' <<<"$sync_range_restart_reacquired_line")"
              sync_range_restart_resumed_attempts="$(awk '{
                for (i=1;i<=NF;i++) if \
                    ($i ~ /^range-restart-resumed-attempts=/) {
                  sub(/^range-restart-resumed-attempts=/,"",$i); print $i; exit
                }
              }' <<<"$sync_range_restart_reacquired_line")"
              sync_range_restart_resumed_bytes="$(awk '{
                for (i=1;i<=NF;i++) if \
                    ($i ~ /^range-restart-resumed-bytes=/) {
                  sub(/^range-restart-resumed-bytes=/,"",$i); print $i; exit
                }
              }' <<<"$sync_range_restart_reacquired_line")"
              sync_range_restart_suffix_bytes="$(awk '{
                for (i=1;i<=NF;i++) if \
                    ($i ~ /^range-restart-suffix-bytes=/) {
                  sub(/^range-restart-suffix-bytes=/,"",$i); print $i; exit
                }
              }' <<<"$sync_range_restart_reacquired_line")"
              sync_range_restart_second_file_id="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^file-id=/) {
