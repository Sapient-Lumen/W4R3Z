              sync_range_restart_recovered_count="$(find "$sync_root/staging" \
                -maxdepth 1 -type f \
                -name 'attempt-????????????????.part' -printf '.\n' | wc -l)"
              sync_range_restart_retained_bytes="$(find \
                "$sync_root/staging" -maxdepth 1 -type f \
                -name 'attempt-????????????????.part' -printf '%s\n' | \
                awk '{ total += $1 } END { print total + 0 }')"
              (( sync_range_restart_recovered_count == 1 ))
              (( sync_range_restart_retained_bytes == \
                 sync_range_restart_interrupted_bytes ))
              [[ "$(sha256sum \
                "$sync_root/accepted-heads/sandwurm-file.accepted-head" | \
                cut -d' ' -f1)" == \
                "$sync_range_restart_predecessor_accepted_sha256" ]]
              [[ "$(sha256sum \
                "$sync_root/activated-revisions/sandwurm-file.activated-revision" | \
                cut -d' ' -f1)" == \
                "$sync_range_restart_predecessor_activation_sha256" ]]
              sync_attempt_recovery_observed=true

              while (( SECONDS < deadline )); do
