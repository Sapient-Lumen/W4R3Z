                printf 'second-job=%s\n' "$sync_range_restart_second_job_id"
                printf 'first-attempt=%s\n' \
                  "$sync_range_restart_first_attempt_id"
                printf 'second-attempt=%s\n' \
                  "$sync_range_restart_second_attempt_id"
                printf 'first-message=%s\n' \
                  "$sync_range_restart_first_message_id"
                printf 'second-message=%s\n' \
                  "$sync_range_restart_second_message_id"
                printf 'first-file-id=%s\n' \
                  "$sync_range_restart_first_file_id"
                printf 'second-file-id=%s\n' \
                  "$sync_range_restart_second_file_id"
                printf 'interrupted-bytes=%s\n' \
                  "$sync_range_restart_interrupted_bytes"
                printf 'retained-bytes=%s\n' \
                  "$sync_range_restart_retained_bytes"
                printf 'resumed-bytes=%s\n' \
                  "$sync_range_restart_resumed_bytes"
                printf 'suffix-bytes=%s\n' \
                  "$sync_range_restart_suffix_bytes"
                printf 'observed-position=%s\n' \
                  "$sync_range_restart_second_position"
              } >"$rendezvous_dir/client.sync-range-restart-reacquired.tmp"
              mv "$rendezvous_dir/client.sync-range-restart-reacquired.tmp" \
                "$rendezvous_dir/client.sync-range-restart-reacquired"
              printf 'sync-daemon-restarted=1\n' \
                >"$rendezvous_dir/client.sync-range-daemon-restarted.tmp"
              mv "$rendezvous_dir/client.sync-range-daemon-restarted.tmp" \
                "$rendezvous_dir/client.sync-range-daemon-restarted"
              sync_range_restart_resume_observed=true
            fi
            if $sync_range_route_loss_scenario; then
              range_loss_initial_attempt=
              range_loss_final_attempt=
              range_loss_header=
              range_loss_job=
              range_loss_samples=0
              while (( SECONDS < deadline )); do
                range_loss_status="$(iotox --runtime "$runtime" \
                  sync-status 2>/dev/null || true)"
                range_loss_header="$(head -n 1 <<<"$range_loss_status")"
                range_loss_job="$(awk -v job="$sync_pull_job_id" \
                  '$1 == "job=" job { print; exit }' \
                  <<<"$range_loss_status")"
                current_attempt="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^range-attempt=/) {
                    sub(/^range-attempt=/,"",$i); print $i; exit
                  }
                }' <<<"$range_loss_job")"
                current_carrier="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^carrier-route=/) {
                    sub(/^carrier-route=/,"",$i); print $i; exit
                  }
                }' <<<"$range_loss_job")"
                qualification_fault="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^qualification-fault=/) {
                    sub(/^qualification-fault=/,"",$i); print $i; exit
                  }
                }' <<<"$range_loss_header")"
                qualification_fault_count="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ \
                      /^qualification-fault-count=/) {
                    sub(/^qualification-fault-count=/,"",$i); print $i; exit
                  }
                }' <<<"$range_loss_header")"
                qualification_deferred_frames="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ \
                      /^qualification-deferred-frames=/) {
                    sub(/^qualification-deferred-frames=/,"",$i); print $i; exit
                  }
                }' <<<"$range_loss_header")"
                qualification_deferred_frame_releases="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ \
                      /^qualification-deferred-frame-releases=/) {
                    sub(/^qualification-deferred-frame-releases=/,"",$i); print $i; exit
                  }
                }' <<<"$range_loss_header")"
                if [[ -z "$range_loss_initial_attempt" ]] && \
                   [[ "$qualification_fault" == 0 ]] && \
                   grep -q ' range-lane-active=1 ' \
                     <<<" $range_loss_job " && \
                   [[ "$current_attempt" =~ ^[1-9][0-9]*$ ]] && \
                   [[ "$current_carrier" =~ ^[0-9A-F]{64}$ ]]; then
                  range_loss_initial_attempt="$current_attempt"
                  sync_tree_route_loss_stopped_carrier="$current_carrier"
                fi
                range_loss_reassignments="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-reassignments=/) {
                    sub(/^auxiliary-reassignments=/,"",$i); print $i; exit
                  }
                }' <<<"$range_loss_header")"
                expected_range_faults=1
                range_loss_topology_matches=false
                if $sync_range_repeated_route_loss_scenario; then
                  expected_range_faults=2
                  if $sync_range_triple_route_loss_scenario; then
                    expected_range_faults=3
                  fi
                  if [[ -n "$sync_tree_route_loss_stopped_carrier" ]] && \
                     { { $sync_range_triple_route_loss_scenario && \
                         [[ "$current_carrier" != \
                           "$sync_tree_route_loss_stopped_carrier" ]]; } || \
                       { ! $sync_range_triple_route_loss_scenario && \
                         [[ "$current_carrier" == \
                           "$sync_tree_route_loss_stopped_carrier" ]]; }; }; then
                    range_loss_topology_matches=true
                  fi
                elif [[ -n "$sync_tree_route_loss_stopped_carrier" ]] && \
                     [[ "$current_carrier" != \
                       "$sync_tree_route_loss_stopped_carrier" ]]; then
                  range_loss_topology_matches=true
                fi
                (( range_loss_samples += 1 ))
                if (( range_loss_samples == 1 ||
                      range_loss_samples % 20 == 0 )); then
                  range_loss_state="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^state=/) {
                      sub(/^state=/,"",$i); print $i; exit
                    }
                  }' <<<"$range_loss_job")"
                  range_loss_position="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ \
                        /^carrier-receive-position=/) {
                      sub(/^carrier-receive-position=/,"",$i); print $i; exit
                    }
                  }' <<<"$range_loss_job")"
                  {
                    printf 'schema=iotox-sync-range-loss-progress-v1\n'
                    printf 'samples=%s\n' "$range_loss_samples"
                    printf 'state=%s\n' "$range_loss_state"
                    printf 'qualification-fault=%s\n' \
                      "$qualification_fault"
                    printf 'qualification-fault-count=%s\n' \
                      "$qualification_fault_count"
                    printf 'qualification-deferred-frames=%s\n' \
                      "$qualification_deferred_frames"
                    printf 'qualification-deferred-frame-releases=%s\n' \
                      "$qualification_deferred_frame_releases"
                    printf 'reassignments=%s\n' "$range_loss_reassignments"
                    printf 'initial-attempt=%s\n' \
                      "$range_loss_initial_attempt"
                    printf 'stopped-carrier=%s\n' \
                      "$sync_tree_route_loss_stopped_carrier"
                    printf 'current-attempt=%s\n' "$current_attempt"
                    printf 'current-carrier=%s\n' "$current_carrier"
                    printf 'expected-faults=%s\n' \
                      "$expected_range_faults"
                    printf 'topology-matches=%s\n' \
                      "$range_loss_topology_matches"
                    printf 'receive-position=%s\n' "$range_loss_position"
                    printf 'agent-running=%s\n' \
