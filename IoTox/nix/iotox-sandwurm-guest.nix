                printf 'deferred-frame-releases=%s\n' \
                  "$sync_qualification_deferred_frame_releases"
                printf 'retained-bytes=%s\n' \
                  "$sync_tree_route_loss_retained_bytes"
                printf 'resumed-bytes=%s\n' \
                  "$sync_tree_route_loss_resumed_bytes"
                printf 'discarded-bytes=%s\n' "$range_loss_discarded"
                printf 'retention-fallbacks=%s\n' \
                  "$sync_tree_route_loss_retention_fallbacks"
                printf 'ready-bulk=%s\n' "$final_ready_bulk"
                printf 'worker-restarts=%s\n' \
                  "$range_loss_total_worker_restarts"
                printf 'status-sha256=%s\n' \
                  "$(printf '%s' "$sync_range_status_line" | \
                    sha256sum | cut -d' ' -f1)"
                printf 'routes-sha256=%s\n' \
                  "$(printf '%s' "$range_loss_routes" | \
                    sha256sum | cut -d' ' -f1)"
              } >"$rendezvous_dir/client.sync-range-postconditions.tmp"
              mv "$rendezvous_dir/client.sync-range-postconditions.tmp" \
                "$rendezvous_dir/client.sync-range-postconditions"
              (( sync_tree_route_loss_position_bytes >= 262144 ))
              (( sync_tree_route_loss_position_bytes <= \
                 sync_tree_route_loss_retained_bytes ))
              (( sync_tree_route_loss_retained_bytes == \
                 sync_tree_route_loss_resumed_bytes ))
              (( sync_tree_route_loss_retained_bytes > 0 && \
                 sync_tree_route_loss_retained_bytes < \
                   expected_range_faults * 1048576 ))
              if $sync_range_repeated_route_loss_scenario; then
                (( sync_tree_route_loss_retained_bytes > \
                   sync_tree_route_loss_position_bytes ))
              fi
              (( range_loss_discarded == 0 ))
              (( sync_tree_route_loss_retention_fallbacks == 0 ))
              (( sync_tree_route_loss_carrier_losses == \
                 expected_range_faults ))
              (( sync_tree_route_loss_reassignments == \
                 expected_range_faults ))
              (( sync_tree_route_loss_stale_terminals >= \
                 expected_range_faults ))
              (( sync_tree_route_loss_recoveries == \
                 expected_range_faults ))
