            fi
            [[ ! -e "$sync_root/accepted-heads/sandwurm-file.accepted-head" ]] || \
              sync_accepted_head_present=1
            [[ ! -e "$sync_root/activated-revisions/sandwurm-file.activated-revision" ]] || \
              sync_activation_present=1
            {
              if $sync_content_restart_scenario; then
                printf 'schema=iotox-sync-content-crash-state-v1\n'
              elif $sync_restart_resume_scenario; then
