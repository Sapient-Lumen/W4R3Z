                printf 'range-bundle-bytes=%s\n' \
                  "$sync_range_restart_bundle"
                printf 'attempt-journal-present=1\n'
                printf 'first-job=%s\n' "$sync_range_restart_first_job_id"
                printf 'first-attempt=%s\n' \
                  "$sync_range_restart_first_attempt_id"
                printf 'first-message=%s\n' \
                  "$sync_range_restart_first_message_id"
                printf 'first-file-id=%s\n' \
