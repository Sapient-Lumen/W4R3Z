            printf 'generation-2a=accepted\n' \
              >"$rendezvous_dir/client.sync-adversity-generation-2a.tmp"
            mv "$rendezvous_dir/client.sync-adversity-generation-2a.tmp" \
              "$rendezvous_dir/client.sync-adversity-generation-2a"

            wait_for_file "$input_dir/device.sync-adversity-stale"
            adversity_read_record "$(<"$input_dir/device.sync-adversity-stale")"
            (( sync_generation == 1 ))
            adversity_status="$(adversity_pull failed)"
            grep -q 'detail="signed HEAD refused: stale"' \
              <<<"$adversity_status"
            [[ "$(sha256sum "$adversity_accepted" | cut -d' ' -f1)" == \
              "$adversity_gen2_accepted_sha" ]]
            [[ "$(sha256sum "$adversity_activated" | cut -d' ' -f1)" == \
              "$adversity_gen2_activated_sha" ]]
            [[ "$(sha256sum "$adversity_current/payload.bin" | \
              cut -d' ' -f1)" == "$adversity_gen2_payload" ]]
            sync_tree_rollback_refused=true
            printf 'stale-refused=1\n' \
              >"$rendezvous_dir/client.sync-adversity-stale.tmp"
            mv "$rendezvous_dir/client.sync-adversity-stale.tmp" \
              "$rendezvous_dir/client.sync-adversity-stale"

            wait_for_file "$input_dir/device.sync-adversity-fork"
            adversity_read_record "$(<"$input_dir/device.sync-adversity-fork")"
            (( sync_generation == 2 ))
            [[ "$sync_head_record" != "$adversity_gen2a_record" ]]
            adversity_status="$(adversity_pull failed)"
            grep -q 'detail="signed HEAD refused: fork"' \
              <<<"$adversity_status"
            [[ "$(sha256sum "$adversity_accepted" | cut -d' ' -f1)" == \
              "$adversity_gen2_accepted_sha" ]]
            [[ "$(sha256sum "$adversity_activated" | cut -d' ' -f1)" == \
              "$adversity_gen2_activated_sha" ]]
            [[ "$(sha256sum "$adversity_current/payload.bin" | \
              cut -d' ' -f1)" == "$adversity_gen2_payload" ]]
            sync_tree_fork_refused=true
            printf 'fork-refused=1\n' \
              >"$rendezvous_dir/client.sync-adversity-fork.tmp"
            mv "$rendezvous_dir/client.sync-adversity-fork.tmp" \
              "$rendezvous_dir/client.sync-adversity-fork"

            wait_for_file \
              "$input_dir/device.sync-adversity-generation-3"
            adversity_read_record "$(<"$input_dir/device.sync-adversity-generation-3")"
            (( sync_generation == 3 ))
            adversity_status="$(adversity_pull complete)"
            grep -qi " head-record=$sync_head_record " \
              <<<"$adversity_status"
            adversity_free_before="$(df -B1 --output=avail "$sync_root" | \
              tail -n 1 | tr -d ' ')"
            [[ "$adversity_free_before" =~ ^[1-9][0-9]*$ ]]
            adversity_leave_bytes=2097152
            (( adversity_free_before > adversity_leave_bytes + 4194601 ))
            sync_tree_enospc_reserved_bytes=$((
              adversity_free_before - adversity_leave_bytes
            ))
            fallocate -l "$sync_tree_enospc_reserved_bytes" \
              "$sync_root/.iotox-enospc-fill"
            sync -f "$sync_root/.iotox-enospc-fill"
            trap - ERR
            set +e
            adversity_failure="$(iotox --runtime "$runtime" \
              --timeout-ms 60000 sync-activate sandwurm-file \
              "$sync_head_record" 2>&1)"
            adversity_failure_status=$?
            set -e
            trap report_failure ERR
            (( adversity_failure_status != 0 ))
            sync_tree_enospc_failure_free_bytes="$(df -B1 --output=avail \
              "$sync_root" | tail -n 1 | tr -d ' ')"
            [[ "$sync_tree_enospc_failure_free_bytes" =~ ^[0-9]+$ ]]
            (( sync_tree_enospc_failure_free_bytes < 4194601 ))
            [[ "$(sha256sum "$adversity_current/payload.bin" | \
              cut -d' ' -f1)" == "$adversity_gen2_payload" ]]
            [[ "$(sha256sum "$adversity_activated" | cut -d' ' -f1)" != \
              "$adversity_gen2_activated_sha" ]]
            sync_tree_enospc_observed=true
            rm -f "$sync_root/.iotox-enospc-fill"
            sync -f "$sync_root"
            adversity_retry="$(iotox --runtime "$runtime" \
              --timeout-ms 60000 sync-activate sandwurm-file \
              "$sync_head_record")"
            grep -q 'decision=duplicate' <<<"$adversity_retry"
            grep -q ' kind=treepack ' <<<"$adversity_retry"
            grep -q ' materialized=1 ' <<<"$adversity_retry"
            [[ "$(sha256sum "$adversity_current/payload.bin" | \
              cut -d' ' -f1)" == "$sync_tree_payload_sha256" ]]
            (( $(find "$sync_root/materialized-trees/revisions" \
              -mindepth 1 -maxdepth 1 -type d | wc -l) == 1 ))
            [[ -z "$(find "$sync_root/materialized-trees" \
              -mindepth 1 -name '*.part.*' -print -quit)" ]]
            sync_tree_enospc_retry_observed=true
            sync_tree_publisher_restart_count=4
            {
              printf 'rollback-refused=1\n'
              printf 'fork-refused=1\n'
              printf 'enospc-observed=1\n'
