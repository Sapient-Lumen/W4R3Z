{ config, lib, pkgs, iotox, sandwurmPackage, role, routeMode, sourceRevision,
  providerOldFixture, providerCurrentFixture, ... }:
let
  expectedVersion = "0.51.0";
  expectedRevision = lib.strings.removeSuffix "\n" (builtins.readFile ../REVISION);
  networked = routeMode != "none";
  localAddress = if role == "client" then "10.0.0.11" else "10.0.0.12";
  peerAddress = if role == "client" then "10.0.0.12" else "10.0.0.11";
  expectedConnection = if routeMode == "direct-udp" then "udp" else "tcp";
  i2pRoute = builtins.elem routeMode [ "tox-i2p" "tox-i2p-construction" ];
  expectedNetwork =
    if routeMode == "tox-tor" then "Tox/Tor"
    else if routeMode == "tox-i2p" then "Tox/I2P"
    else if routeMode == "tox-i2p-construction" then "Tox/I2P-construction"
    else "Tox/native";
  privacyRoute = routeMode == "tox-tor" || i2pRoute;
  privateL2Ping = !privacyRoute;
  ratoxEcho = pkgs.writeCBin "iotox-ratox-echo" ''
    #include <errno.h>
    #include <stddef.h>
    #include <termios.h>
    #include <unistd.h>

    int main(void) {
      struct termios state;
      if (tcgetattr(STDIN_FILENO, &state) != 0) return 111;
      state.c_iflag &= (tcflag_t)~(BRKINT | ICRNL | INPCK | ISTRIP | IXON);
      state.c_oflag &= (tcflag_t)~OPOST;
      state.c_cflag &= (tcflag_t)~CSIZE;
      state.c_cflag |= CS8;
      state.c_lflag &= (tcflag_t)~(ECHO | ICANON | IEXTEN | ISIG);
      state.c_cc[VMIN] = 1;
      state.c_cc[VTIME] = 0;
      if (tcsetattr(STDIN_FILENO, TCSANOW, &state) != 0) return 112;
      unsigned char byte;
      for (;;) {
        ssize_t count = read(STDIN_FILENO, &byte, 1);
        if (count == 0) return 0;
        if (count < 0) {
          if (errno == EINTR) continue;
          return 113;
        }
        size_t offset = 0;
        while (offset < (size_t)count) {
          ssize_t written = write(STDOUT_FILENO, &byte + offset,
                                  (size_t)count - offset);
          if (written < 0) {
            if (errno == EINTR) continue;
            return 114;
          }
          if (written == 0) return 115;
          offset += (size_t)written;
        }
      }
    }
  '';
  updateServiceProbe = pkgs.writeCBin "iotox-update-service-probe" ''
    #include <errno.h>
    #include <stdint.h>
    #include <stdlib.h>
    #include <string.h>
    #include <time.h>
    #include <unistd.h>

    static int write_all(int descriptor, const unsigned char *bytes,
                         size_t size) {
      size_t offset = 0;
      while (offset < size) {
        ssize_t written = write(descriptor, bytes + offset, size - offset);
        if (written > 0) {
          offset += (size_t)written;
          continue;
        }
        if (written < 0 && errno == EINTR) continue;
        return 0;
      }
      return 1;
    }

    int main(void) {
      const char *ready = getenv("IOTOX_SERVICE_READY_FD");
      const char *sequence_text = getenv("IOTOX_UPDATE_SEQUENCE");
      const char *version = getenv("IOTOX_UPDATE_VERSION");
      const char *digest = getenv("IOTOX_UPDATE_PAYLOAD_DIGEST");
      if (ready == NULL || strcmp(ready, "3") != 0 ||
          sequence_text == NULL || version == NULL || digest == NULL ||
          strlen(digest) != 64) return 125;
      errno = 0;
      char *end = NULL;
      unsigned long long sequence = strtoull(sequence_text, &end, 10);
      if (errno != 0 || end == sequence_text || *end != '\0' || sequence == 0)
        return 125;
      if (strcmp(version, "delayed-ready") == 0) {
        struct timespec delay = { .tv_sec = 5, .tv_nsec = 0 };
        while (nanosleep(&delay, &delay) != 0 && errno == EINTR) {}
      }
      unsigned char record[16] = {
        'I', 'O', 'T', 'O', 'X', 'S', 'R', '1', 0, 0, 0, 0, 0, 0, 0, 0
      };
      for (size_t index = 0; index < 8; ++index) {
        record[8 + index] =
          (unsigned char)(sequence >> (56U - (unsigned int)index * 8U));
      }
      if (!write_all(3, record, sizeof(record)) || close(3) != 0) return 125;
      for (;;) pause();
    }
  '';
in {
  assertions = [
    {
      assertion = builtins.elem role [ "client" "device" ];
      message = "IoTox Sandwurm guest role must be client or device";
    }
    {
      assertion = builtins.elem routeMode [
        "none" "direct-udp" "forced-tcp" "tox-tor" "tox-i2p"
        "tox-i2p-construction"
      ];
      message = "IoTox Sandwurm route mode is not supported";
    }
  ];

  sandwurm.directCloudHypervisorGuest = {
    hostName = "iotox-${role}";
    taskId = "iotox-${role}-vm-smoke";
    authorityMode = "bounded";
    networkClass = if networked then "provider-egress" else "none";
    workspaceGrant = "shared";
    stateGrant = "task-private";
    profile = "iotox-${role}-${routeMode}-qualification";
    reviewHint = "IoTox ${role} guest booted the exact Nix closure and emitted a content-free smoke receipt";
  };

  # The qualification image carries the complete source-linked compiler,
  # transport, evidence, and Sandwurm closure.  Keep generous filesystem
  # population headroom here; this is an ephemeral lab artifact and is not an
  # IoTox deployment-size claim.
  image.repart.partitions."10-root".repartConfig.SizeMinBytes =
    lib.mkForce "48G";

  environment.systemPackages = [
    iotox
    providerOldFixture
    providerCurrentFixture
    sandwurmPackage
    updateServiceProbe
  ];

  networking = lib.mkIf networked {
    useDHCP = false;
    defaultGateway = "10.0.0.1";
    nameservers = lib.optionals (!privacyRoute) [ "1.1.1.1" "9.9.9.9" ];
    interfaces.eth0.ipv4.addresses = [ {
      address = localAddress;
      prefixLength = 24;
    } ];
    firewall = {
      # c-toxcore selects an ephemeral native UDP socket when no port range is
      # configured. Permit that peer-facing socket inside this disposable lab
      # guest; the prepared host bridge remains the outer containment boundary.
      allowedUDPPortRanges = lib.optionals (routeMode == "direct-udp") [
        { from = 1024; to = 65535; }
      ];
    };
  };

  # Sandwurm considers its own receipt service the terminal guest boundary.
  # Make that boundary wait for the IoTox-specific proof so the host cannot
  # harvest a generic boot receipt and terminate the VMM too early.
  systemd.services.sandwurm-guest-receipts = {
    requires = [ "iotox-vm-smoke.service" ];
    after = [ "iotox-vm-smoke.service" ];
  };

  systemd.services.iotox-vm-smoke = {
    description = "Run the bounded IoTox VM smoke gate";
    wantedBy = [ "multi-user.target" ];
    requires = [ "workspace.mount" ];
    after = [ "local-fs.target" "workspace.mount" ];
    before = [ "sandwurm-guest-receipts.service" ];
    unitConfig.ConditionPathIsMountPoint = "/workspace";
    path = [
      pkgs.coreutils
      pkgs.diffutils
      pkgs.findutils
      pkgs.e2fsprogs
      pkgs.gnugrep
      pkgs.gnused
      pkgs.gawk
      pkgs.iproute2
      pkgs.iputils
      pkgs.jq
      pkgs.python3
      pkgs.systemd
      pkgs.util-linux
      iotox
      providerOldFixture
      providerCurrentFixture
    ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      StandardOutput = "journal+console";
      StandardError = "journal+console";
    };
    script = if !networked then ''
      set -euo pipefail
      receipt_dir=/workspace/guest-receipts/iotox
      mkdir -p "$receipt_dir"

      version_output="$(iotox --version)"
      expected_output='IoTox ${expectedVersion} ${expectedRevision}'
      test "$version_output" = "$expected_output"
      binary_sha256="$(sha256sum ${iotox}/bin/iotox | cut -d' ' -f1)"
      virtualization="$(systemd-detect-virt --vm)"
      test "$virtualization" = "kvm"
      cgroup_type="$(stat -fc '%T' /sys/fs/cgroup)"
      test "$cgroup_type" = "cgroup2fs"

      jq -n \
        --arg schema "iotox.sandwurm-vm-smoke.v0" \
        --arg status "passed" \
        --arg role ${lib.escapeShellArg role} \
        --arg source_revision ${lib.escapeShellArg sourceRevision} \
        --arg product_revision ${lib.escapeShellArg expectedRevision} \
        --arg version "$version_output" \
        --arg binary_sha256 "$binary_sha256" \
        --arg virtualization "$virtualization" \
        --arg cgroup_type "$cgroup_type" \
        --arg network_class "none" \
        --arg package_variant "pinned-source-linked" \
        '{
          schema: $schema,
          status: $status,
          role: $role,
          source_revision: $source_revision,
          product_revision: $product_revision,
          version: $version,
          binary_sha256: $binary_sha256,
          virtualization: $virtualization,
          cgroup_type: $cgroup_type,
          network_class: $network_class,
          package_variant: $package_variant,
          contains_secrets: false
        }' >"$receipt_dir/vm-smoke.json.tmp"
      mv "$receipt_dir/vm-smoke.json.tmp" "$receipt_dir/vm-smoke.json"
    '' else ''
      set -euo pipefail
      umask 0077
      receipt_dir=/workspace/guest-receipts/iotox
      input_dir=/workspace/iotox-input
      rendezvous_dir=/workspace/iotox-rendezvous
      state_dir=/var/lib/iotox-pair
      runtime="$state_dir/runtime"
      agent_pid=
      secondary_agent_pid=
      secondary_state="$state_dir/content-secondary"
      secondary_runtime="$secondary_state/runtime"
      secondary_sync_policy_store="$secondary_state/sync-policy"
      secondary_sync_root="$secondary_state/sync-data"
      declare -a stripe_agent_pid=()
      declare -a stripe_runtime=()
      declare -a stripe_state=()
      declare -a stripe_remote_key=()
      declare -a stripe_restart_count=()
      stripe_route_restart_count=0
      stripe_injected_restart_count=0

      cleanup() {
        local lane pid lane_runtime
        for lane in 1 2 3; do
          pid="''${stripe_agent_pid[$lane]:-}"
          lane_runtime="''${stripe_runtime[$lane]:-}"
          if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            iotox --runtime "$lane_runtime" stop >/dev/null 2>&1 || true
            wait "$pid" 2>/dev/null || true
          fi
        done
        if [[ -n "$secondary_agent_pid" ]] && \
           kill -0 "$secondary_agent_pid" 2>/dev/null; then
          iotox --runtime "$secondary_runtime" stop >/dev/null 2>&1 || true
          wait "$secondary_agent_pid" 2>/dev/null || true
        fi
        if [[ -n "$agent_pid" ]] && kill -0 "$agent_pid" 2>/dev/null; then
          iotox --runtime "$runtime" stop >/dev/null 2>&1 || true
          wait "$agent_pid" 2>/dev/null || true
        fi
        if [[ "''${sync_adversity_mount:-false}" == true ]] &&
           mountpoint -q "''${sync_root:-/nonexistent}"; then
          umount "''${sync_root:-/nonexistent}" || true
        fi
        if [[ "''${sync_gc_test_mount:-false}" == true ]] &&
           mountpoint -q "''${sync_root:-/nonexistent}/objects"; then
          umount "''${sync_root:-/nonexistent}/objects" || true
        fi
      }
      trap cleanup EXIT

      mkdir -p "$receipt_dir" "$input_dir" "$rendezvous_dir" "$state_dir"
      chmod 0700 "$input_dir" "$rendezvous_dir" "$state_dir"
      failure_phase=initialization
      report_failure() {
        local trapped_status=$?
        local failure_status="''${1:-$trapped_status}"
        local failure_line="''${BASH_LINENO[0]:-0}"
        trap - ERR
        {
          printf 'schema=iotox-sandwurm-guest-failure-v1\n'
          printf 'role=%s\n' ${lib.escapeShellArg role}
          printf 'phase=%s\n' "$failure_phase"
          printf 'status=%s\n' "$failure_status"
          printf 'line=%s\n' "$failure_line"
          if [[ -n "''${secondary_session:-}" ]]; then
            # Preserve only the content-free protocol boundary.  A live Tox
            # connection and a transcript-confirmed IoTox session are
            # intentionally different observations.
            printf 'secondary-session-state=%s\n' \
              "$(awk -F= '$1 == "state" { print $2; exit }' \
                <<<"$secondary_session")"
            printf 'secondary-session-connected=%s\n' \
              "$(awk -F= '$1 == "connected" { print $2; exit }' \
                <<<"$secondary_session")"
            printf 'secondary-session-connection=%s\n' \
              "$(awk -F= '$1 == "connection" { print $2; exit }' \
                <<<"$secondary_session")"
            printf 'secondary-session-hello-sent=%s\n' \
              "$(awk -F= '$1 == "hello-sent" { print $2; exit }' \
                <<<"$secondary_session")"
            printf 'secondary-session-hello-received=%s\n' \
              "$(awk -F= '$1 == "hello-received" { print $2; exit }' \
                <<<"$secondary_session")"
            printf 'secondary-session-hello-send-attempts=%s\n' \
              "$(awk -F= '$1 == "hello-send-attempts" { print $2; exit }' \
                <<<"$secondary_session")"
          fi
          if [[ -n "''${sync_initial_pull_attempts:-}" ]]; then
            printf 'sync-initial-pull-attempts=%s\n' \
              "$sync_initial_pull_attempts"
            printf 'sync-initial-pull-failures=%s\n' \
              "$sync_initial_pull_failures"
            printf 'sync-initial-pull-first-error-sha256=%s\n' \
              "$sync_initial_pull_first_error_sha256"
          fi
          if [[ -n "''${route_loss_job:-}" ]]; then
            printf 'route-loss-job=%s\n' "$route_loss_job"
            printf 'route-loss-retained-attempts=%s\n' \
              "''${sync_tree_route_loss_retained_attempts:-}"
            printf 'route-loss-retained-bytes=%s\n' \
              "''${sync_tree_route_loss_retained_bytes:-}"
            printf 'route-loss-retention-fallbacks=%s\n' \
              "''${sync_tree_route_loss_retention_fallbacks:-}"
            printf 'route-loss-resumed-attempts=%s\n' \
              "''${sync_tree_route_loss_resumed_attempts:-}"
            printf 'route-loss-resumed-bytes=%s\n' \
              "''${sync_tree_route_loss_resumed_bytes:-}"
          fi
          if [[ -n "''${actual_privacy_payload_carrier:-}" ]]; then
            printf 'actual-privacy-payload-carrier=%s\n' \
              "$actual_privacy_payload_carrier"
            printf 'actual-privacy-payload-expected-carrier=%s\n' \
              "''${route_worker_key[$private_route_tor_lane]:-}"
            printf 'actual-privacy-payload-reassignments=%s\n' \
              "''${actual_privacy_payload_reassignments:-}"
          fi
          if [[ -n "''${authenticated_auxiliary_count:-}" ]]; then
            printf 'authenticated-auxiliary-count=%s\n' \
              "$authenticated_auxiliary_count"
            printf 'authenticated-privacy-route-count=%s\n' \
              "''${authenticated_privacy_route_count:-0}"
            printf 'authenticated-range-route-count=%s\n' \
              "''${authenticated_range_route_count:-0}"
          fi
          if [[ -n "''${route_sync_status:-}" ]]; then
            printf 'sync-route-status-sha256=%s\n' \
              "$(printf '%s' "$route_sync_status" | sha256sum | cut -d' ' -f1)"
            printf 'sync-route-status-hex=%s\n' \
              "$(printf '%s' "$route_sync_status" | \
                od -An -tx1 | tr -d ' \n')"
          fi
          if [[ -n "''${sync_range_pull_error:-}" ]]; then
            printf 'sync-range-pull-error-sha256=%s\n' \
              "$(printf '%s' "$sync_range_pull_error" | \
                sha256sum | cut -d' ' -f1)"
            printf 'sync-range-pull-error-hex=%s\n' \
              "$(printf '%s' "$sync_range_pull_error" | \
                od -An -tx1 | tr -d ' \n')"
          fi
          if [[ -n "''${actual_i2p_loss_staging_observation:-}" ]]; then
            printf 'actual-i2p-loss-staging-observation-hex=%s\n' \
              "$(printf '%s' "$actual_i2p_loss_staging_observation" | \
                od -An -tx1 | tr -d ' \n')"
            printf 'actual-i2p-loss-staging-entry-count=%s\n' \
              "''${actual_i2p_loss_staging_entry_count:-0}"
          fi
          if [[ -n "''${actual_i2p_loss_staging_fd_observation:-}" ]]; then
            printf 'actual-i2p-loss-staging-fd-observation-hex=%s\n' \
              "$(printf '%s' "$actual_i2p_loss_staging_fd_observation" | \
                od -An -tx1 | tr -d ' \n')"
          fi
          if [[ -n "''${sync_repair_recovered_bytes:-}" ]]; then
            printf 'repair-observed-bytes=%s\n' \
              "$sync_repair_recovered_bytes"
            printf 'repair-expected-bytes=%s\n' \
              "''${sync_artifact_bytes:-0}"
          fi
          if [[ -n "''${clean_repair_output:-}" ]]; then
            printf 'repair-scan-output=%s\n' "$clean_repair_output"
          fi
          if [[ -n "''${repair_status_line:-}" ]]; then
            printf 'repair-job-status=%s\n' "$repair_status_line"
          fi
          if [[ -n "''${sync_adversity_diagnostic:-}" ]]; then
            printf 'sync-adversity-diagnostic-hex=%s\n' \
              "$(printf '%s' "$sync_adversity_diagnostic" | \
                od -An -tx1 | tr -d ' \n')"
          fi
          if [[ -n "''${read_only_line:-}" ]]; then
            printf 'sync-read-only-status-hex=%s\n' \
              "$(printf '%s' "$read_only_line" | \
                od -An -tx1 | tr -d ' \n')"
          fi
          if [[ -n "''${read_only_retry_line:-}" ]]; then
            printf 'sync-read-only-retry-status-hex=%s\n' \
              "$(printf '%s' "$read_only_retry_line" | \
                od -An -tx1 | tr -d ' \n')"
          fi
          if [[ -n "''${read_only_activation_output:-}" ]]; then
            printf 'sync-read-only-activation-hex=%s\n' \
              "$(printf '%s' "$read_only_activation_output" | \
                od -An -tx1 | tr -d ' \n')"
          fi
          if [[ -n "''${ratox_probe_error_path:-}" &&
                -s "$ratox_probe_error_path" ]]; then
            printf 'ratox-probe-error-hex=%s\n' \
              "$(od -An -tx1 "$ratox_probe_error_path" | tr -d ' \n')"
          fi
          for memory_failure_field in \
            sync_tree_memory_publisher_baseline_hwm_kib \
            sync_tree_memory_publisher_post_publish_hwm_kib \
            sync_tree_memory_publisher_peak_hwm_kib \
            sync_tree_memory_subscriber_baseline_hwm_kib \
            sync_tree_memory_subscriber_post_pull_hwm_kib \
            sync_tree_memory_subscriber_peak_hwm_kib; do
            memory_failure_value="''${!memory_failure_field:-}"
            if [[ -n "$memory_failure_value" ]]; then
              printf '%s=%s\n' "$memory_failure_field" \
                "$memory_failure_value"
            fi
          done
        } >"$rendezvous_dir/${role}.failure.tmp"
        mv "$rendezvous_dir/${role}.failure.tmp" \
          "$rendezvous_dir/${role}.failure"
        exit "$failure_status"
      }
      trap report_failure ERR
      deadline=$((SECONDS + 420))
      wait_for_file() {
        local path=$1
        while [[ ! -s "$path" ]]; do
          (( SECONDS < deadline )) || return 1
          sleep 0.1
        done
      }
      qualify_sync_gc_quarantine() {
        local gc_payload gc_identity gc_source gc_destination
        local gc_state_sentinel gc_workspace_sentinel
        local gc_state_sentinel_sha256 gc_workspace_sentinel_sha256
        local gc_artifact_object gc_manifest_object
        local gc_artifact_object_sha256 gc_manifest_object_sha256 gc_source_identity
        local gc_dry_output gc_quarantine_output gc_repeat_output
        local gc_mount_source gc_mount_output gc_mount_status
        gc_payload="$state_dir/gc-unreferenced.bin"
        gc_state_sentinel="$state_dir/gc-outside-sentinel"
        gc_workspace_sentinel="$rendezvous_dir/${role}.gc-outside-sentinel"
        printf 'outside-sync-root:%s\n' ${lib.escapeShellArg role} > \
          "$gc_state_sentinel"
        printf 'outside-sync-root-workspace:%s\n' ${lib.escapeShellArg role} > \
          "$gc_workspace_sentinel"
        gc_state_sentinel_sha256="$(sha256sum "$gc_state_sentinel" | cut -d' ' -f1)"
        gc_workspace_sentinel_sha256="$(sha256sum "$gc_workspace_sentinel" | cut -d' ' -f1)"
        gc_artifact_object="$sync_root/objects/$sync_artifact_sha256.artifact"
        gc_manifest_object="$sync_root/objects/$sync_manifest_sha256.manifest"
        gc_artifact_object_sha256="$(sha256sum "$gc_artifact_object" | cut -d' ' -f1)"
        gc_manifest_object_sha256="$(sha256sum "$gc_manifest_object" | cut -d' ' -f1)"

        gc_mount_source="$state_dir/gc-mount-source"
        install -d -m 0700 "$gc_mount_source"
        mount --bind "$gc_mount_source" "$sync_root/objects"
        sync_gc_test_mount=true
        trap - ERR
        set +e
        gc_mount_output="$(iotox --runtime "$runtime" sync-gc \
          sandwurm-file dry-run 2>&1)"
        gc_mount_status=$?
        set -e
        trap report_failure ERR
        umount "$sync_root/objects"
        sync_gc_test_mount=false
        (( gc_mount_status != 0 ))
        grep -q 'unable to open contained sync object directory' \
          <<<"$gc_mount_output"
        sync_gc_mount_refused=true

        dd if=/dev/zero bs=32768 count=1 status=none | \
          tr '\000' '\246' >"$gc_payload"
        gc_identity="$(sha256sum "$gc_payload" | cut -d' ' -f1)"
        [[ "$gc_identity" =~ ^[0-9a-f]{64}$ ]]
        gc_source="$sync_root/objects/$gc_identity.artifact"
        gc_destination="$sync_root/gc-quarantine/$gc_identity.artifact"
        install -m 0600 "$gc_payload" "$gc_source"
        sync -f "$gc_source"
        gc_source_identity="$(stat -c '%d:%i' "$gc_source")"

        gc_dry_output="$(iotox --runtime "$runtime" sync-gc \
          sandwurm-file dry-run)"
        grep -q '^namespace=sandwurm-file mode=dry-run consistent=1 descriptor-pinned=1 ' \
          <<<"$gc_dry_output"
        grep -q ' rooted=2 ' <<<"$gc_dry_output"
        grep -q ' candidates=1 candidate-bytes=32768 purge=disabled$' \
          <<<"$gc_dry_output"
        [[ -f "$gc_source" ]]
        [[ ! -e "$gc_destination" ]]

        gc_quarantine_output="$(iotox --runtime "$runtime" sync-gc \
          sandwurm-file quarantine)"
        grep -q '^namespace=sandwurm-file mode=quarantine candidates=1 moved=1 moved-bytes=32768 durable=1 durable-bytes=32768 cancelled=0 purge=disabled$' \
          <<<"$gc_quarantine_output"
        [[ ! -e "$gc_source" ]]
        [[ -f "$gc_destination" ]]
        [[ "$(stat -c '%d:%i' "$gc_destination")" == "$gc_source_identity" ]]
        [[ "$(sha256sum "$gc_destination" | cut -d' ' -f1)" == "$gc_identity" ]]
        [[ "$(sha256sum "$gc_artifact_object" | cut -d' ' -f1)" == \
          "$gc_artifact_object_sha256" ]]
        [[ "$(sha256sum "$gc_manifest_object" | cut -d' ' -f1)" == \
          "$gc_manifest_object_sha256" ]]
        [[ "$(sha256sum "$gc_state_sentinel" | cut -d' ' -f1)" == \
          "$gc_state_sentinel_sha256" ]]
        [[ "$(sha256sum "$gc_workspace_sentinel" | cut -d' ' -f1)" == \
          "$gc_workspace_sentinel_sha256" ]]

        gc_repeat_output="$(iotox --runtime "$runtime" sync-gc \
          sandwurm-file quarantine)"
        grep -q '^namespace=sandwurm-file mode=quarantine candidates=0 moved=0 moved-bytes=0 durable=0 durable-bytes=0 cancelled=0 purge=disabled$' \
          <<<"$gc_repeat_output"
        [[ -f "$gc_destination" ]]
