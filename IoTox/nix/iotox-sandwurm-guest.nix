                awk '{ total += $1 } END { print total + 0 }')"
              content_restart_crash_transport_files=$sync_transport_temporary_count
              content_restart_crash_transport_bytes=$sync_interrupted_staging_bytes
              content_restart_crash_canonical_partials=$sync_canonical_partial_count
              content_restart_crash_inventory="$state_dir/content-restart-crash-inventory.tsv"
              content_restart_capture_inventory \
                "$content_restart_crash_inventory"
              content_restart_crash_committed_objects="$(wc -l \
                <"$content_restart_crash_inventory")"
              content_restart_crash_committed_bytes="$(awk \
                '{ total += $2 } END { print total + 0 }' \
                "$content_restart_crash_inventory")"
              content_restart_crash_inventory_sha256="$(sha256sum \
                "$content_restart_crash_inventory" | cut -d' ' -f1)"
              (( content_restart_crash_transport_files >= 2 && \
                 content_restart_crash_transport_files <= \
                   sync_content_restart_cap ))
              (( content_restart_crash_transport_bytes > 0 ))
              (( content_restart_crash_canonical_partials == 0 ))
