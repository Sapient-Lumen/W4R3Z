                } >>"$rendezvous_dir/device.sync-route-population-ready.tmp"
              done
            done
            printf 'jobs-per-policy=%s\nartifact-bytes=%s\npayload-bytes=%s\n' \
              "$population_jobs_per_policy" "$population_common_bytes" \
              "$population_payload_bytes" \
              >>"$rendezvous_dir/device.sync-route-population-ready.tmp"
            mv "$rendezvous_dir/device.sync-route-population-ready.tmp" \
              "$rendezvous_dir/device.sync-route-population-ready"
          fi
          if $sync_guest_restart_scenario; then
            if $resumed_guest; then
              guest_restart_observed=true
              guest_identity_preserved=true
              fresh_session_after_guest_restart=true
              sync_restart_observed=true
              sync_restart_recovery_observed=true
              sync_restart_identity_preserved=true
              printf 'sync-guest-recovered=1\n' \
