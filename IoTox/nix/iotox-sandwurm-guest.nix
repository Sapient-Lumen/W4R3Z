            (( sync_restart_total_resumed_bytes == \
               sync_restart_resumed_bytes ))
            sync_restart_prefix_resume_observed=true
          fi
          if $sync_tree_route_actual_tor_payload_scenario || \
             $sync_tree_route_actual_i2p_payload_scenario; then
            actual_privacy_payload_job="$(awk -v job="$sync_pull_job_id" \
              '$1 == "job=" job { print; exit }' <<<"$sync_status")"
            actual_privacy_payload_header="$(head -n 1 <<<"$sync_status")"
            actual_privacy_payload_carrier="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^carrier-route=/) {
                sub(/^carrier-route=/,"",$i); print $i; exit
              }
            }' <<<"$actual_privacy_payload_job")"
            actual_privacy_payload_reassignments="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-reassignments=/) {
                sub(/^auxiliary-reassignments=/,"",$i); print $i; exit
              }
            }' <<<"$actual_privacy_payload_header")"
            grep -q ' carrier=auxiliary ' \
              <<<" $actual_privacy_payload_job "
            grep -q ' state=complete ' <<<" $actual_privacy_payload_job "
            [[ "$actual_privacy_payload_carrier" == \
              "''${route_worker_key[$private_route_tor_lane]}" ]]
            [[ "$actual_privacy_payload_reassignments" == 0 ]]
            actual_privacy_payload_carrier_sha256="$(printf '%s' \
              "$actual_privacy_payload_carrier" | sha256sum | cut -d' ' -f1)"
            [[ "$actual_privacy_payload_carrier_sha256" == \
              "$private_route_auxiliary_key_sha256" ]]
            if $sync_tree_route_actual_i2p_payload_scenario; then
              grep -q ' auxiliary-failover-policy=fail-closed ' \
                <<<" $actual_privacy_payload_header "
              if $sync_tree_route_actual_i2p_loss_scenario; then
                grep -q ' auxiliary-fail-closed-jobs=1 ' \
                  <<<" $actual_privacy_payload_header "
              else
                grep -q ' auxiliary-fail-closed-jobs=0 ' \
                  <<<" $actual_privacy_payload_header "
              fi
              actual_i2p_payload_carrier_sha256="$actual_privacy_payload_carrier_sha256"
              actual_i2p_payload_reassignments="$actual_privacy_payload_reassignments"
              actual_i2p_payload_observed=true
              if $sync_tree_route_actual_i2p_loss_scenario; then
                [[ "$actual_i2p_payload_carrier_sha256" == \
                  "$actual_i2p_fail_closed_loss_carrier_sha256" ]]
                (( actual_i2p_fail_closed_loss_carrier_losses == 1 ))
                (( actual_i2p_fail_closed_loss_reassignments == 0 ))
                (( actual_i2p_fail_closed_loss_blocked_jobs == 1 ))
                (( actual_i2p_fail_closed_loss_recoveries == 1 ))
                (( actual_i2p_fail_closed_loss_worker_restarts == 0 ))
                $actual_i2p_fail_closed_loss_old_job_cancelled
                actual_i2p_fail_closed_loss_same_carrier=true
                actual_i2p_fail_closed_loss_observed=true
                {
                  printf 'schema=iotox-actual-i2p-loss-recovered-v1\n'
                  printf 'original-job=%s\n' \
                    "$actual_i2p_fail_closed_loss_original_job_id"
                  printf 'replacement-job=%s\n' \
                    "$actual_i2p_fail_closed_loss_replacement_job_id"
                  printf 'carrier=%s\n' "$actual_privacy_payload_carrier"
                  printf 'recoveries=1\n'
                  printf 'worker-restarts=0\n'
                  printf 'old-job-cancelled=1\n'
                  printf 'same-carrier=1\n'
                } >"$rendezvous_dir/client.actual-i2p-loss-recovered.tmp"
                mv "$rendezvous_dir/client.actual-i2p-loss-recovered.tmp" \
                  "$rendezvous_dir/client.actual-i2p-loss-recovered"
              fi
            else
              actual_tor_payload_carrier_sha256="$actual_privacy_payload_carrier_sha256"
              actual_tor_payload_reassignments="$actual_privacy_payload_reassignments"
              actual_tor_payload_observed=true
            fi
          fi
          if $sync_tree_admission_scenario; then
            admission_status_line="$(awk -v job="$sync_pull_job_id" \
              '$1 == "job=" job { print; exit }' <<<"$sync_status")"
            [[ -n "$admission_status_line" ]]
            sync_tree_admission_retry_count="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^admission-retries=/) {
                sub(/^admission-retries=/,"",$i); print $i
              }
            }' <<<"$admission_status_line")"
            sync_tree_admission_admitted_offers="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^admitted=/) {
                sub(/^admitted=/,"",$i); print $i
              }
            }' <<<"$admission_status_line")"
            sync_tree_admission_pending_offers="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^pending-offers=/) {
                sub(/^pending-offers=/,"",$i); print $i
              }
            }' <<<"$admission_status_line")"
            [[ "$sync_tree_admission_retry_count" =~ ^[1-9][0-9]*$ ]]
            [[ "$sync_tree_admission_admitted_offers" == 2 ]]
            [[ "$sync_tree_admission_pending_offers" == 0 ]]
            sync_tree_admission_observed=true
          fi
          if $sync_content_scenario; then
            artifact_object="$sync_root/content-v2/sha256/''${sync_artifact_sha256:0:2}/''${sync_artifact_sha256:2}"
            manifest_object="$sync_root/content-v2/sha256/''${sync_manifest_sha256:0:2}/''${sync_manifest_sha256:2}"
          else
            artifact_object="$sync_root/objects/$sync_artifact_sha256.artifact"
            manifest_object="$sync_root/objects/$sync_manifest_sha256.manifest"
          fi
          [[ "$(sha256sum "$artifact_object" | cut -d' ' -f1)" == "$sync_artifact_sha256" ]]
          [[ "$(sha256sum "$manifest_object" | cut -d' ' -f1)" == "$sync_manifest_sha256" ]]
          [[ "$(stat -c '%s' "$artifact_object")" == "$sync_artifact_bytes" ]]
          [[ "$(stat -c '%s' "$manifest_object")" == "$sync_manifest_bytes" ]]
          if $signed_update_scenario; then
            failure_phase=signed-update-remote-stage
            post_update_session=
            while (( SECONDS < deadline )); do
              post_update_session="$(iotox --runtime "$runtime" session \
                "$remote_key" 2>/dev/null || true)"
              if grep -q 'signed-ota-v1' <<<"$post_update_session"; then
                break
              fi
              kill -0 "$agent_pid"
              sleep 0.1
            done
            grep -q 'signed-ota-v1' <<<"$post_update_session"
            signed_update_feature_advertised=true
            {
              printf 'head-record=%s\n' "$sync_head_record"
              printf 'accepted=1\n'
            } >"$rendezvous_dir/client.update-stage-ready.tmp"
            mv "$rendezvous_dir/client.update-stage-ready.tmp" \
              "$rendezvous_dir/client.update-stage-ready"
            wait_for_file "$input_dir/signed-update-stage-complete"
            signed_update_stage_completion="$(
              <"$input_dir/signed-update-stage-complete")"
            rm -f "$input_dir/signed-update-stage-complete"
            grep -q "^head-record=$sync_head_record$" \
              <<<"$signed_update_stage_completion"
            grep -q '^remote-stage=1$' \
              <<<"$signed_update_stage_completion"
            grep -q '^remote-stage-outcome=succeeded$' \
              <<<"$signed_update_stage_completion"
            grep -q '^remote-stage-sequence=1$' \
              <<<"$signed_update_stage_completion"
            grep -q "^remote-stage-manifest-record=$signed_update_manifest_record$" \
              <<<"$signed_update_stage_completion"
            signed_update_sender_epoch="$(awk -F= \
              '$1 == "sender-epoch" { print $2 }' \
              <<<"$signed_update_stage_completion")"
            signed_update_message_id="$(awk -F= \
              '$1 == "message-id" { print $2 }' \
              <<<"$signed_update_stage_completion")"
            [[ "$signed_update_sender_epoch" =~ ^[1-9][0-9]*$ ]]
            [[ "$signed_update_message_id" =~ ^[1-9][0-9]*$ ]]
            signed_update_status=
            signed_update_incoming=
            while (( SECONDS < deadline )); do
              signed_update_status="$(iotox --runtime "$runtime" \
                update-status 2>/dev/null || true)"
              signed_update_incoming="$(iotox --runtime "$runtime" \
                command-record incoming "$remote_key" \
                "$signed_update_sender_epoch" \
                "$signed_update_message_id" 2>/dev/null || true)"
              if grep -q ' phase=staged ' \
                   <<<" $signed_update_status " && \
                 grep -q '^lifecycle=succeeded$' \
                   <<<"$signed_update_incoming"; then
                break
              fi
              kill -0 "$agent_pid"
              sleep 0.1
            done
            grep -q ' phase=staged ' <<<" $signed_update_status "
            grep -q ' candidate-sequence=1 ' \
              <<<" $signed_update_status "
            grep -q '^lifecycle=succeeded$' <<<"$signed_update_incoming"
            grep -q '^operation=update.stage$' <<<"$signed_update_incoming"
            grep -q '^outcome=succeeded$' <<<"$signed_update_incoming"
            grep -qi "^expected-update-head=$sync_head_record$" \
              <<<"$signed_update_incoming"
            grep -q '^update-staged=1$' <<<"$signed_update_incoming"
            grep -q '^update-sequence=1$' <<<"$signed_update_incoming"
            grep -qi "^update-accepted-head=$sync_head_record$" \
              <<<"$signed_update_incoming"
            grep -qi "^update-manifest-record=$signed_update_manifest_record$" \
              <<<"$signed_update_incoming"
            signed_update_remote_stage_observed=true

            failure_phase=signed-update-apply
            signed_update_apply_output="$(iotox --runtime "$runtime" \
              update-apply "$signed_update_manifest_record")"
            signed_update_health_token="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^health-token=/) {
                sub(/^health-token=/,"",$i); print tolower($i); exit
              }
            }' <<<"$signed_update_apply_output")"
            [[ "$signed_update_health_token" =~ ^[0-9a-f]{64}$ ]]
            grep -q ' restart-required=1 ' \
              <<<" $signed_update_apply_output "
            grep -q ' candidate-sequence=1$' \
              <<<"$signed_update_apply_output"

            failure_phase=signed-update-restart
            stop_agent
            start_agent
            signed_update_restart_count=1
            signed_update_startup_disposition=health-window-opened

            if $update_service_scenario; then
              update_service_wait_status() {
                local pattern matched
                while (( SECONDS < deadline )); do
                  signed_update_status="$(iotox --runtime "$runtime" \
                    update-status 2>/dev/null || true)"
                  matched=true
                  for pattern in "$@"; do
                    if ! grep -q -- "$pattern" \
                         <<<" $signed_update_status "; then
                      matched=false
                      break
                    fi
                  done
                  if $matched; then
                    return 0
                  fi
                  kill -0 "$agent_pid"
                  sleep 0.05
                done
                printf '%s\n' "$signed_update_status" >&2
                return 1
              }
              update_service_stage_apply_restart() {
                local staged
                staged="$(iotox --runtime "$runtime" update-stage \
                  sandwurm-file "$sync_head_record")"
                grep -q ' phase=staged ' <<<" $staged "
                grep -q ' candidate-sequence=1 ' <<<" $staged "
                signed_update_apply_output="$(iotox --runtime "$runtime" \
                  update-apply "$signed_update_manifest_record")"
                signed_update_health_token="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^health-token=/) {
                    sub(/^health-token=/,"",$i); print tolower($i); exit
                  }
                }' <<<"$signed_update_apply_output")"
                [[ "$signed_update_health_token" =~ ^[0-9a-f]{64}$ ]]
                grep -q ' restart-required=1 ' \
                  <<<" $signed_update_apply_output "
                grep -q ' candidate-sequence=1$' \
                  <<<"$signed_update_apply_output"
                stop_agent
                start_agent
                signed_update_restart_count=$((
                  signed_update_restart_count + 1
                ))
                update_service_wait_status \
                  ' startup=health-window-opened ' \
                  ' phase=awaiting-health ' \
                  ' candidate-sequence=1 '
              }

              failure_phase=update-service-pre-readiness-exit
              update_service_wait_status \
                ' startup=health-window-opened ' \
                ' phase=awaiting-health ' \
                ' service-phase=starting ' \
                ' service-sequence=1 ' \
                ' service-candidate=1 ' \
                ' service-image-sealed=1 '
              update_service_pid="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^service-pid=/) {
                  sub(/^service-pid=/,"",$i); print $i; exit
                }
              }' <<<"$signed_update_status")"
              [[ "$update_service_pid" =~ ^[1-9][0-9]*$ ]]
              kill -KILL "$update_service_pid"
              update_service_wait_status \
                ' phase=idle-after-rollback ' \
                ' rollback-count=1 ' \
                ' last-failed-sequence=1' \
                ' service-phase=inactive '
              update_service_pre_ready_exit_observed=true

              failure_phase=update-service-agent-death
              update_service_stage_apply_restart
              update_service_wait_status \
                ' phase=awaiting-health ' \
                ' service-phase=ready ' \
                ' service-candidate=1 ' \
                ' service-ready=1 ' \
                ' service-image-sealed=1 '
              update_service_pid="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^service-pid=/) {
                  sub(/^service-pid=/,"",$i); print $i; exit
                }
              }' <<<"$signed_update_status")"
              [[ "$update_service_pid" =~ ^[1-9][0-9]*$ ]]
              kill -KILL "$agent_pid"
              wait "$agent_pid" || true
              agent_pid=
              while (( SECONDS < deadline )) && \
                    [[ -e "/proc/$update_service_pid" ]]; do
                sleep 0.05
              done
              [[ ! -e "/proc/$update_service_pid" ]]
              update_service_parent_death_observed=true
              start_agent
              signed_update_restart_count=$((
                signed_update_restart_count + 1
              ))
              update_service_wait_status \
                ' startup=unconfirmed-restart-rolled-back ' \
                ' phase=idle-after-rollback ' \
                ' rollback-count=2 ' \
                ' last-failed-sequence=1' \
                ' service-phase=inactive '
              update_service_agent_death_observed=true

              failure_phase=update-service-health-expiry
              update_service_stage_apply_restart
              update_service_wait_status \
                ' phase=awaiting-health ' \
                ' service-phase=ready ' \
                ' service-candidate=1 ' \
                ' service-ready=1 '
              update_service_ready_observed=true
              update_service_wait_status \
                ' phase=idle-after-rollback ' \
                ' rollback-count=3 ' \
                ' last-failed-sequence=1' \
                ' service-phase=inactive '
              update_service_health_expiry_observed=true

              failure_phase=update-service-confirm
              update_service_stage_apply_restart
              update_service_wait_status \
                ' phase=awaiting-health ' \
                ' service-phase=ready ' \
                ' service-candidate=1 ' \
                ' service-ready=1 ' \
                ' service-image-sealed=1 '
              signed_update_confirm_output="$(iotox --runtime "$runtime" \
                update-confirm "$signed_update_health_token")"
              grep -q ' phase=confirmed ' \
                <<<" $signed_update_confirm_output "
              grep -q ' confirmed-sequence=1 ' \
                <<<" $signed_update_confirm_output "
              grep -q ' candidate-sequence=0 ' \
                <<<" $signed_update_confirm_output "
              grep -q ' service-phase=ready ' \
                <<<" $signed_update_confirm_output "
              grep -q ' service-candidate=0 ' \
                <<<" $signed_update_confirm_output "
              grep -q ' service-image-sealed=1 ' \
                <<<" $signed_update_confirm_output "

              failure_phase=update-service-confirmed-recovery
              stop_agent
              start_agent
              signed_update_restart_count=$((
                signed_update_restart_count + 1
              ))
              update_service_wait_status \
                ' startup=unchanged ' \
                ' phase=confirmed ' \
                ' rollback-count=3 ' \
                ' confirmed-sequence=1 ' \
                ' candidate-sequence=0 ' \
                ' service-phase=ready ' \
                ' service-sequence=1 ' \
                ' service-candidate=0 ' \
                ' service-ready=1 ' \
                ' service-image-sealed=1 '
              update_service_confirmed_recovery_observed=true
              update_service_rollback_count=3
              update_service_payload_kind=linux-service-v1
              update_service_image_sealed=true
            else
              signed_update_status="$(iotox --runtime "$runtime" \
                update-status)"
              grep -q ' startup=health-window-opened ' \
                <<<" $signed_update_status "
              grep -q ' phase=awaiting-health ' \
                <<<" $signed_update_status "
              grep -q ' candidate-sequence=1 ' \
                <<<" $signed_update_status "

              failure_phase=signed-update-confirm
              signed_update_confirm_output="$(iotox --runtime "$runtime" \
                update-confirm "$signed_update_health_token")"
              grep -q ' phase=confirmed ' \
                <<<" $signed_update_confirm_output "
              grep -q ' confirmed-sequence=1 ' \
                <<<" $signed_update_confirm_output "
              grep -q ' candidate-sequence=0 ' \
                <<<" $signed_update_confirm_output "
            fi
            signed_update_current="$(readlink -f "$update_root/current")"
            [[ -f "$signed_update_current" ]]
            [[ "$(stat -c '%a' "$signed_update_current")" == 400 ]]
            signed_update_current_sha256="$(sha256sum \
              "$signed_update_current" | cut -d' ' -f1)"
            [[ "$signed_update_current_sha256" == \
              "$signed_update_payload_sha256" ]]
            post_update_session=
            while (( SECONDS < deadline )); do
              post_update_session="$(iotox --runtime "$runtime" session \
                "$remote_key" 2>/dev/null || true)"
              if grep -q 'signed-ota-v1' <<<"$post_update_session"; then
                break
              fi
              kill -0 "$agent_pid"
              sleep 0.1
            done
            grep -q 'signed-ota-v1' <<<"$post_update_session"
            signed_update_confirmed=true
            signed_update_observed=true
            failure_phase=signed-update-complete
          else
            activation_output="$(iotox --runtime "$runtime" sync-activate \
              sandwurm-file "$sync_head_record")"
            grep -q 'decision=activated' <<<"$activation_output"
            [[ -s "$sync_root/activated-revisions/sandwurm-file.activated-revision" ]]
          fi
          if $sync_tree_scenario; then
            grep -q ' kind=treepack ' <<<"$activation_output"
            grep -q ' directories=3 ' <<<"$activation_output"
            grep -q ' files=3 ' <<<"$activation_output"
            grep -q " content-bytes=$sync_tree_base_content_bytes " \
              <<<"$activation_output"
            grep -q ' materialized=1 ' <<<"$activation_output"
            tree_current="$sync_root/materialized-trees/current"
            [[ -L "$tree_current" ]]
            [[ "$(stat -Lc '%a' "$tree_current")" == 500 ]]
            [[ "$(stat -Lc '%a' "$tree_current/bin/probe")" == 500 ]]
            [[ "$(stat -Lc '%a' \
              "$tree_current/nested/field-notes.txt")" == 400 ]]
            [[ "$(stat -Lc '%a' "$tree_current/payload.bin")" == 400 ]]
            [[ "$(<"$tree_current/nested/field-notes.txt")" == \
              'IoTox genuine Sandwurm treepack-v1 convergence' ]]
            [[ "$(sha256sum "$tree_current/payload.bin" | cut -d' ' -f1)" == \
              "$sync_tree_payload_sha256" ]]
            (( $(find -L "$tree_current" -mindepth 1 -type d | wc -l) == 3 ))
            (( $(find -L "$tree_current" -mindepth 1 -type f | wc -l) == 3 ))
            [[ -z "$(find -L "$tree_current" -mindepth 1 -type l -print -quit)" ]]
            tree_retry_output="$(iotox --runtime "$runtime" sync-activate \
              sandwurm-file "$sync_head_record")"
            grep -q 'decision=duplicate' <<<"$tree_retry_output"
            grep -q ' kind=treepack ' <<<"$tree_retry_output"
            grep -q ' materialized=0 ' <<<"$tree_retry_output"
            grep -q ' already-current=1 ' <<<"$tree_retry_output"
            grep -q ' recovered-staging-trees=0 ' <<<"$tree_retry_output"
            grep -q ' pruned-revision-trees=0$' <<<"$tree_retry_output"
            sync_tree_observed=true
          fi
          if $sync_repair_scenario; then
            failure_phase=sync-repair-corrupt
            accepted_state="$sync_root/accepted-heads/sandwurm-file.accepted-head"
            activation_state="$sync_root/activated-revisions/sandwurm-file.activated-revision"
            accepted_state_sha256="$(sha256sum "$accepted_state" | cut -d' ' -f1)"
            activation_state_sha256="$(sha256sum "$activation_state" | cut -d' ' -f1)"

            dd if=/dev/zero bs=4096 count=1 status=none | \
              tr '\000' '\245' | \
              dd of="$artifact_object" conv=notrunc status=none
            [[ "$(stat -c '%s' "$artifact_object")" == "$sync_artifact_bytes" ]]
            sync_repair_corrupt_sha256="$(sha256sum "$artifact_object" | cut -d' ' -f1)"
            [[ "$sync_repair_corrupt_sha256" != "$sync_artifact_sha256" ]]
            sync -f "$artifact_object"

            repair_output="$(iotox --runtime "$runtime" sync-repair sandwurm-file)"
            grep -q '^namespace=sandwurm-file inspected=2 ' <<<"$repair_output"
            grep -q ' verified=1 quarantined=1 ' <<<"$repair_output"
            grep -q " quarantined-bytes=$sync_artifact_bytes$" <<<"$repair_output"
            sync_repair_inspected_objects=2
            sync_repair_quarantined_objects=1
            sync_repair_quarantined_bytes="$sync_artifact_bytes"
            [[ ! -e "$artifact_object" ]]
            mapfile -t sync_repair_quarantine < <(find "$sync_root/quarantine" \
              -mindepth 1 -maxdepth 1 -type f \
              -name "$sync_artifact_sha256.artifact.corrupt-*" -print)
            (( ''${#sync_repair_quarantine[@]} == 1 ))
            quarantine_object="''${sync_repair_quarantine[0]}"
            [[ "$(stat -c '%a' "$quarantine_object")" == 600 ]]
            [[ "$(stat -c '%s' "$quarantine_object")" == "$sync_artifact_bytes" ]]
            [[ "$(sha256sum "$quarantine_object" | cut -d' ' -f1)" == \
              "$sync_repair_corrupt_sha256" ]]
            [[ "$(sha256sum "$accepted_state" | cut -d' ' -f1)" == \
              "$accepted_state_sha256" ]]
            [[ "$(sha256sum "$activation_state" | cut -d' ' -f1)" == \
              "$activation_state_sha256" ]]
            sync_repair_observed=true
            sync_repair_state_preserved=true

            failure_phase=sync-repair-repull
            repair_pull="$(iotox --runtime "$runtime" sync-pull \
              "$remote_key" sandwurm-file)"
            repair_job_id="$(awk '{ for (i=1;i<=NF;i++) if ($i ~ /^job=/) { sub(/^job=/,"",$i); print $i } }' \
              <<<"$repair_pull")"
            [[ "$repair_job_id" =~ ^[1-9][0-9]*$ ]]
            repair_status_line=
            while (( SECONDS < deadline )); do
              sync_status="$(iotox --runtime "$runtime" sync-status 2>/dev/null || true)"
              repair_status_line="$(awk -v job="$repair_job_id" \
                '$1 == "job=" job { print; exit }' <<<"$sync_status")"
              if grep -q ' state=complete ' <<<"$repair_status_line"; then
                break
              fi
              if grep -q ' state=failed ' <<<"$repair_status_line"; then
                printf '%s\n' "$repair_status_line" >&2
                exit 1
              fi
              kill -0 "$agent_pid"
              sleep 0.1
            done
            grep -q ' state=complete ' <<<"$repair_status_line"
            repair_status_head_record="$(awk '{ for (i=1;i<=NF;i++) if ($i ~ /^head-record=/) { sub(/^head-record=/,"",$i); print tolower($i) } }' \
              <<<"$repair_status_line")"
            [[ "$repair_status_head_record" == "$sync_head_record" ]]
            failure_phase=sync-repair-clean-scan
            # ERR traps are inherited by command substitutions in this unit.
            # Suspend the trap while collecting the local-control diagnostic so
            # a failed maintenance call is reported by the parent shell.
            trap - ERR
            set +e
            clean_repair_output="$(iotox --runtime "$runtime" \
              sync-repair sandwurm-file 2>&1)"
            clean_repair_status=$?
            set -e
            trap report_failure ERR
            if (( clean_repair_status != 0 )); then
              failure_phase=sync-repair-clean-scan-command
              false
            fi
            grep -q '^namespace=sandwurm-file inspected=2 ' <<<"$clean_repair_output"
            grep -q ' verified=2 quarantined=0 quarantined-bytes=0$' \
              <<<"$clean_repair_output"
            [[ -f "$artifact_object" ]]
            sync_repair_recovered_bytes="$(stat -c '%s' "$artifact_object")"
            [[ "$sync_repair_recovered_bytes" =~ ^[0-9]+$ ]]
            (( sync_repair_recovered_bytes == sync_artifact_bytes ))
            failure_phase=sync-repair-verify-quarantine
            [[ -f "$quarantine_object" ]]
            [[ "$(stat -c '%s' "$quarantine_object")" == \
              "$sync_artifact_bytes" ]]
            failure_phase=sync-repair-verify-state
            [[ "$(sha256sum "$accepted_state" | cut -d' ' -f1)" == \
              "$accepted_state_sha256" ]]
            [[ "$(sha256sum "$activation_state" | cut -d' ' -f1)" == \
              "$activation_state_sha256" ]]
            sync_repair_recovery_observed=true
            sync_repair_quarantine_preserved=true
            sync_repair_clean_retry_observed=true
            failure_phase=sync-gc-client-qualification
            qualify_sync_gc_quarantine
            failure_phase=sync-repair-complete
          fi
          sync_convergence_observed=true
          sync_activation_observed=true
          if $sync_content_lane_science_scenario; then
            failure_phase=sync-content-lane-science
            wait_for_file \
              "$input_dir/device.sync-content-lane-science-ready"
            lane_science_ready="$(
              <"$input_dir/device.sync-content-lane-science-ready")"
            rm -f "$input_dir/device.sync-content-lane-science-ready"
            grep -q \
              '^schema=iotox-content-lane-science-publications-v1$' \
              <<<"$lane_science_ready"
            grep -q "^artifact-sha256=$sync_artifact_sha256$" \
              <<<"$lane_science_ready"
            grep -q "^artifact-bytes=$sync_artifact_bytes$" \
              <<<"$lane_science_ready"
            grep -q "^content-chunks=$sync_content_chunks$" \
              <<<"$lane_science_ready"
            grep -q "^content-objects=$sync_content_objects$" \
              <<<"$lane_science_ready"

            lane_science_summary_tmp="$receipt_dir/content-lane-science.tsv.tmp"
            {
              printf 'schema\tiotox-content-lane-science-v1\n'
              printf 'artifact-sha256\t%s\n' "$sync_artifact_sha256"
              printf 'artifact-bytes\t%s\n' "$sync_artifact_bytes"
              printf 'content-chunks\t%s\n' "$sync_content_chunks"
              printf 'content-objects\t%s\n' "$sync_content_objects"
              printf 'phase-order\t%s\n' \
                "$content_lane_science_requested_phase_order"
              printf 'columns\tcap\tduration-ms\tartifact-bps\tmax-active-lanes\tuser-cpu-ticks\tsystem-cpu-ticks\tresident-high-water-kib\ttransport-iterations\tresource-sha256\n'
            } >"$lane_science_summary_tmp"

            lane_science_append_summary() {
              local cap=$1 duration=$2 artifact_bps=$3 active=$4
              local resource=$5 resource_sha256=$6
              local user_ticks system_ticks resident_hwm iterations
              user_ticks="$(awk -F '\t' \
                '$1 == "delta-user-cpu-ticks" { print $2 }' "$resource")"
              system_ticks="$(awk -F '\t' \
                '$1 == "delta-system-cpu-ticks" { print $2 }' "$resource")"
              resident_hwm="$(awk -F '\t' \
                '$1 == "end-resident-high-water-kib" { print $2 }' \
                "$resource")"
              iterations="$(awk -F '\t' \
                '$1 == "delta-transport-iterations" { print $2 }' \
                "$resource")"
              [[ "$user_ticks" =~ ^[0-9]+$ ]]
              [[ "$system_ticks" =~ ^[0-9]+$ ]]
              [[ "$resident_hwm" =~ ^[1-9][0-9]*$ ]]
              [[ "$iterations" =~ ^[1-9][0-9]*$ ]]
              printf 'phase\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$cap" "$duration" "$artifact_bps" "$active" \
                "$user_ticks" "$system_ticks" "$resident_hwm" \
                "$iterations" "$resource_sha256" \
                >>"$lane_science_summary_tmp"
            }

            lane_science_append_summary \
              "$content_lane_science_initial_cap" \
              "$content_lane_science_initial_duration_ms" \
              "$content_lane_science_initial_bps" \
              "$content_lane_science_initial_active" \
              "$lane_science_resource_output" \
              "$content_lane_science_initial_resource_sha256"
            content_lane_science_activation_count=1

            lane_science_run_phase() {
              local cap=$1 expected_head=$2
              local namespace="sandwurm-lanes-$cap"
              local phase_root="$state_dir/$namespace"
              local resource_state resource_status resource_output
              local started_ms finished_ms duration_ms artifact_bps
              local pull_output job status job_line lane_lines
              local active=0 max_active=0 observed=false
              local lane_rows admitted root_lanes distinct_requests
              local distinct_files distinct_sources activation_output
              local resource_sha256 phase_artifact

              [[ "$expected_head" =~ ^[0-9a-f]{64}$ ]]
              resource_state="$state_dir/content-lane-science-cap-$cap-resource.json"
              resource_status="$state_dir/content-lane-science-cap-$cap-status.txt"
              resource_output="$receipt_dir/content-lane-science-cap-$cap-resource.tsv"
              failure_phase="sync-content-lane-science-cap-$cap-transfer"
              if $sync_content_ratox_post_bulk_scenario && \
                 [[ "$cap" == 8 ]]; then
                # Prove authenticated terminal readiness before the reliable
                # cap-8 workload. Do not poll it again after completion: the
                # next controller operation must be the fresh OPEN itself.
                failure_phase=sync-content-ratox-post-bulk-readiness
                content_ratox_post_bulk_readiness
                failure_phase=sync-content-lane-science-cap-8-transfer
              fi
              iotox --runtime "$runtime" status >"$resource_status"
              python3 ${../tools/capture-process-resources.py} begin \
                --pid "$agent_pid" --runtime-status "$resource_status" \
                --state "$resource_state" --role client
              if $sync_content_ratox_latency_science_scenario && \
                 content_ratox_measures_cap "$cap"; then
                content_ratox_begin_phase "$cap"
                started_ms=$((content_ratox_phase_start_us / 1000))
              else
                started_ms="$(awk '{printf "%.0f\n", $1 * 1000}' \
                  /proc/uptime)"
              fi
              pull_output="$(iotox --runtime "$runtime" sync-pull \
                "$remote_key" "$namespace")"
              job="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^job=/) {
                  sub(/^job=/,"",$i); print $i; exit
                }
              }' <<<"$pull_output")"
              [[ "$job" =~ ^[1-9][0-9]*$ ]]

              while (( SECONDS < deadline )); do
                status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                job_line="$(awk -v job="$job" \
                  '$1 == "content-job=" job { print; exit }' \
                  <<<"$status")"
                lane_lines="$(awk -v job="$job" \
                  '$1 == "content-lane-job=" job { print }' \
                  <<<"$status")"
                active="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^active-lanes=/) {
                    sub(/^active-lanes=/,"",$i); print $i; exit
                  }
                }' <<<"$job_line")"
                [[ "$active" =~ ^[0-9]+$ ]] || active=0
                if (( active > 0 )); then
                  lane_rows="$(awk 'NF { ++count }
                    END { print count + 0 }' <<<"$lane_lines")"
                  admitted="$(awk '{
                    for (i=1;i<=NF;i++) if ($i == "admitted=1") ++count
                    }
                    END { print count + 0 }' <<<"$lane_lines")"
                  root_lanes="$(awk '{
                    for (i=1;i<=NF;i++) if ($i == "root=1") ++count
                    }
                    END { print count + 0 }' <<<"$lane_lines")"
                  distinct_requests="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^request=/) {
                      sub(/^request=/,"",$i); seen[$i]=1
                    }} END { for (value in seen) ++count; print count + 0 }
                  ' <<<"$lane_lines")"
                  distinct_files="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^file=/) {
                      sub(/^file=/,"",$i); seen[$i]=1
                    }} END { for (value in seen) ++count; print count + 0 }
                  ' <<<"$lane_lines")"
                  distinct_sources="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^source-id=/) {
                      sub(/^source-id=/,"",$i); seen[$i]=1
                    }} END { for (value in seen) ++count; print count + 0 }
                  ' <<<"$lane_lines")"
                  if (( lane_rows == active && admitted == active && \
                        root_lanes == 0 && distinct_requests == active && \
                        distinct_files == active && distinct_sources == 1 )); then
                    observed=true
                    (( active > max_active )) && max_active=$active
                  fi
                fi
                if grep -q ' state=complete ' <<<" $job_line "; then
                  break
                fi
                if grep -q ' state=failed ' <<<" $job_line "; then
                  printf '%s\n' "$job_line" >&2
                  return 1
                fi
                if $sync_content_ratox_latency_science_scenario && \
                   content_ratox_measures_cap "$cap" && \
                   ! kill -0 "$content_ratox_probe_pid" 2>/dev/null; then
                  wait "$content_ratox_probe_pid" || true
                  failure_phase="sync-content-ratox-cap-$cap-probe-runtime"
                  return 1
                fi
                agent_is_running "$agent_pid"
                sleep 0.02
              done
              grep -q ' state=complete ' <<<" $job_line "
              $observed
              (( max_active >= 1 && max_active <= cap ))
              if $sync_content_ratox_latency_science_scenario && \
                 content_ratox_measures_cap "$cap"; then
                content_ratox_phase_end_us="$(python3 -c \
                  'import time; print(time.monotonic_ns() // 1000)')"
                finished_ms=$((content_ratox_phase_end_us / 1000))
              elif $sync_content_ratox_post_bulk_scenario && \
                   [[ "$cap" == 8 ]]; then
                content_ratox_post_bulk_origin_us="$(python3 -c \
                  'import time; print(time.monotonic_ns() // 1000)')"
                [[ "$content_ratox_post_bulk_origin_us" =~ ^[1-9][0-9]*$ ]]
                finished_ms=$((content_ratox_post_bulk_origin_us / 1000))
              else
                finished_ms="$(awk '{printf "%.0f\n", $1 * 1000}' \
                  /proc/uptime)"
              fi
              duration_ms=$((finished_ms - started_ms))
              (( duration_ms > 0 ))
              artifact_bps=$((sync_artifact_bytes * 1000 / duration_ms))
              (( artifact_bps > 0 ))
              if $sync_content_ratox_latency_science_scenario && \
                 content_ratox_measures_cap "$cap"; then
                content_ratox_record_phase "$cap" \
                  "$content_ratox_phase_end_us" "$duration_ms" \
                  "$artifact_bps" "$max_active"
              fi
              if $sync_content_ratox_post_bulk_scenario && \
                 [[ "$cap" == 8 ]]; then
                local post_capture post_admission post_stderr post_epoch
                failure_phase=sync-content-ratox-post-bulk-open
                post_capture="$receipt_dir/content-ratox-post-bulk-capture.tsv"
                post_admission="$receipt_dir/content-ratox-post-bulk-admission.tsv"
                post_stderr="$rendezvous_dir/client.content-ratox-post-bulk.stderr"
                python3 ${../tools/ratox-terminal-probe.py} \
                  --runtime "$runtime" --peer "$remote_key" \
                  --samples "$content_ratox_post_bulk_samples" \
                  --timeout-ms 5000 \
                  --expected-connection \
                    ${lib.escapeShellArg expectedConnection} \
                  --output "$post_capture" \
                  --admission-output "$post_admission" \
                  --admission-origin-us \
                    "$content_ratox_post_bulk_origin_us" \
                  2>"$post_stderr"
                rm -f "$post_stderr"
                awk -F '\t' -v expected="$content_ratox_post_bulk_samples" '
                  $1 == "samples" && $2 == expected { metadata = 1 }
                  $1 == "sample" { ++samples }
                  END { exit !(metadata && samples == expected) }
                ' "$post_capture"
                content_ratox_post_bulk_origin_to_open_sent_us="$(awk -F '\t' \
                  '$1 == "origin-to-open-sent-us" { print $2 }' \
                  "$post_admission")"
                content_ratox_post_bulk_origin_to_opened_us="$(awk -F '\t' \
                  '$1 == "origin-to-opened-us" { print $2 }' \
                  "$post_admission")"
                content_ratox_post_bulk_open_round_trip_us="$(awk -F '\t' \
                  '$1 == "open-round-trip-us" { print $2 }' \
                  "$post_admission")"
                post_epoch="$(awk -F '\t' '$1 == "online-epoch" { print $2 }' \
                  "$post_admission")"
                [[ "$content_ratox_post_bulk_origin_to_open_sent_us" =~ \
                  ^[0-9]+$ ]]
                [[ "$content_ratox_post_bulk_origin_to_opened_us" =~ \
                  ^[1-9][0-9]*$ ]]
                [[ "$content_ratox_post_bulk_open_round_trip_us" =~ \
                  ^[1-9][0-9]*$ ]]
                (( content_ratox_post_bulk_origin_to_open_sent_us <= 1000000 ))
                (( content_ratox_post_bulk_open_round_trip_us <= 5000000 ))
                (( content_ratox_post_bulk_origin_to_opened_us <= 6000000 ))
                [[ "$post_epoch" == "$content_ratox_post_bulk_online_epoch" ]]
                content_ratox_post_bulk_capture_sha256="$(sha256sum \
                  "$post_capture" | cut -d' ' -f1)"
                content_ratox_post_bulk_admission_sha256="$(sha256sum \
                  "$post_admission" | cut -d' ' -f1)"
                [[ "$content_ratox_post_bulk_capture_sha256" =~ \
                  ^[0-9a-f]{64}$ ]]
                [[ "$content_ratox_post_bulk_admission_sha256" =~ \
                  ^[0-9a-f]{64}$ ]]
                content_ratox_post_bulk_cap=8
                content_ratox_post_bulk_observed=true
              fi
              iotox --runtime "$runtime" status >"$resource_status"
              python3 ${../tools/capture-process-resources.py} finish \
                --pid "$agent_pid" --runtime-status "$resource_status" \
                --state "$resource_state" --output "$resource_output"
              resource_sha256="$(sha256sum "$resource_output" | \
                cut -d' ' -f1)"
              [[ "$resource_sha256" =~ ^[0-9a-f]{64}$ ]]

              failure_phase="sync-content-lane-science-cap-$cap-activation"
              activation_output="$(iotox --runtime "$runtime" \
                --timeout-ms 60000 \
                sync-activate "$namespace" "$expected_head")"
              grep -q ' decision=activated ' <<<" $activation_output "
              failure_phase="sync-content-lane-science-cap-$cap-object"
              phase_artifact="$phase_root/content-v2/sha256/''${sync_artifact_sha256:0:2}/''${sync_artifact_sha256:2}"
              [[ "$(sha256sum "$phase_artifact" | cut -d' ' -f1)" == \
                "$sync_artifact_sha256" ]]
              [[ "$(stat -c '%s' "$phase_artifact")" == \
                "$sync_artifact_bytes" ]]
              content_lane_science_activation_count=$((
                content_lane_science_activation_count + 1
              ))

              case "$cap" in
                1)
                  content_lane_science_cap_1_duration_ms=$duration_ms
                  content_lane_science_cap_1_bps=$artifact_bps
                  content_lane_science_cap_1_active=$max_active
                  content_lane_science_cap_1_resource_sha256=$resource_sha256
                  ;;
                2)
                  content_lane_science_cap_2_duration_ms=$duration_ms
                  content_lane_science_cap_2_bps=$artifact_bps
                  content_lane_science_cap_2_active=$max_active
                  content_lane_science_cap_2_resource_sha256=$resource_sha256
                  ;;
                4)
                  content_lane_science_cap_4_duration_ms=$duration_ms
                  content_lane_science_cap_4_bps=$artifact_bps
                  content_lane_science_cap_4_active=$max_active
                  content_lane_science_cap_4_resource_sha256=$resource_sha256
                  ;;
                8)
                  content_lane_science_cap_8_duration_ms=$duration_ms
                  content_lane_science_cap_8_bps=$artifact_bps
                  content_lane_science_cap_8_active=$max_active
                  content_lane_science_cap_8_resource_sha256=$resource_sha256
                  ;;
                *) return 1 ;;
              esac
              failure_phase="sync-content-lane-science-cap-$cap-summary"
              lane_science_append_summary "$cap" "$duration_ms" \
                "$artifact_bps" "$max_active" "$resource_output" \
                "$resource_sha256"
            }

            lane_science_remaining_order="$(tr ',' ' ' \
              <<<"$content_lane_science_requested_phase_order")"
            for lane_science_cap in $lane_science_remaining_order; do
              if [[ "$lane_science_cap" == \
                    "$content_lane_science_initial_cap" ]]; then
                continue
              fi
              lane_science_head="$(awk -F= \
                -v name="cap-$lane_science_cap-head-record" \
                '$1 == name { print $2 }' <<<"$lane_science_ready")"
              lane_science_run_phase \
                "$lane_science_cap" "$lane_science_head"
            done
            failure_phase=sync-content-lane-science-finalize
            (( content_lane_science_restart_count == 0 ))
            (( content_lane_science_activation_count == 4 ))
            [[ "$content_lane_science_cap_1_active" == 1 ]]
            (( content_lane_science_cap_2_active >= 1 && \
               content_lane_science_cap_2_active <= 2 ))
            (( content_lane_science_cap_4_active >= 1 && \
               content_lane_science_cap_4_active <= 4 ))
            (( content_lane_science_cap_8_active >= 1 && \
               content_lane_science_cap_8_active <= 8 ))
            if $sync_content_ratox_latency_science_scenario; then
              failure_phase=sync-content-ratox-latency-summarize
              content_ratox_metadata="$receipt_dir/content-ratox-overlap-metadata.tsv"
              mv "$content_ratox_metadata_tmp" "$content_ratox_metadata"
              python3 ${../tools/summarize-content-ratox-latency.py} \
                --metadata "$content_ratox_metadata" \
                --capture "$content_ratox_capture" \
                --output "$receipt_dir/content-ratox-latency.tsv"
              content_ratox_summary_schema=iotox-content-ratox-latency-science-v1
              content_ratox_summary_count=3
              content_ratox_summary_caps=1,4,8,
              if $sync_content_ratox_sla_scenario; then
                content_ratox_summary_schema=iotox-content-ratox-latency-sla-v1
                content_ratox_summary_count=4
                content_ratox_summary_caps=1,2,4,8,
              fi
              awk -F '\t' -v expected="$content_ratox_summary_schema" '
                $1 == "schema" &&
                  $2 == expected {
                  found = 1
                }
                END { exit !found }
              ' "$receipt_dir/content-ratox-latency.tsv"
              awk -v expected_count="$content_ratox_summary_count" \
                  -v expected_caps="$content_ratox_summary_caps" '
                $1 == "phase" { caps = caps $2 ","; ++count }
                END { exit !(count == expected_count && caps == expected_caps) }
              ' "$receipt_dir/content-ratox-latency.tsv"
              if $sync_content_ratox_sla_scenario; then
                failure_phase=sync-content-ratox-cap-2-sla
                awk -F '\t' '
                  $1 == "phase" && $2 == 2 {
                    found = 1
                    pass = $7 >= 40 && $8 <= 250000 && $9 <= 500000 &&
                      $10 <= 1000000 && $11 <= 1500000 && $12 <= 10000
                  }
                  END { exit !(found && pass) }
                ' "$receipt_dir/content-ratox-latency.tsv"
              fi
            fi
            if $sync_content_ratox_post_bulk_scenario; then
              failure_phase=sync-content-ratox-post-bulk-finalize
              $content_ratox_post_bulk_observed
              [[ "$content_ratox_post_bulk_cap" == 8 ]]
              [[ "$content_ratox_post_bulk_samples" == 40 ]]
              [[ "$content_ratox_post_bulk_online_epoch" =~ \
                ^[1-9][0-9]*$ ]]
            fi
            mv "$lane_science_summary_tmp" \
              "$receipt_dir/content-lane-science.tsv"
            content_lane_science_summary_sha256="$(sha256sum \
              "$receipt_dir/content-lane-science.tsv" | cut -d' ' -f1)"
            [[ "$content_lane_science_summary_sha256" =~ ^[0-9a-f]{64}$ ]]
            content_lane_science_phase_order=$content_lane_science_requested_phase_order
            content_lane_science_observed=true
          fi
          if $sync_tree_route_loss_scenario || \
             $sync_tree_route_actual_tor_loss_scenario; then
            final_routes=
            recovered_route=
            expected_route_worker_restarts=1
            if $sync_tree_route_actual_tor_loss_scenario; then
              expected_route_worker_restarts=0
            fi
            while (( SECONDS < deadline )); do
              final_routes="$(iotox --runtime "$runtime" routes \
                2>/dev/null || true)"
              recovered_route="$(awk -v key="$initial_bulk_route" '
                $0 ~ ("public-key=" key) { print; exit }
              ' <<<"$final_routes")"
              final_ready_bulk="$(awk '
                / role=bulk / && / lifecycle=ready / { count++ }
                END { print count + 0 }
              ' <<<"$final_routes")"
              route_loss_status="$(iotox --runtime "$runtime" \
                sync-status 2>/dev/null || true)"
              route_loss_header="$(head -n 1 <<<"$route_loss_status")"
              sync_tree_route_loss_recoveries="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-recoveries=/) {
                  sub(/^auxiliary-recoveries=/,"",$i); print $i
                }
              }' <<<"$route_loss_header")"
              if (( final_ready_bulk == 2 )) && \
                 grep -q ' lifecycle=ready ' <<<" $recovered_route " && \
                 grep -q " restarts=$expected_route_worker_restarts " \
                   <<<" $recovered_route " && \
                 [[ "$sync_tree_route_loss_recoveries" == 1 ]]; then
                break
              fi
              agent_is_running "$agent_pid"
              sleep 0.1
            done
            (( final_ready_bulk == 2 ))
            grep -q ' lifecycle=ready ' <<<" $recovered_route "
            grep -q " restarts=$expected_route_worker_restarts " \
              <<<" $recovered_route "
            sync_tree_route_loss_worker_restarts="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^restarts=/) {
                sub(/^restarts=/,"",$i); print $i; exit
              }
            }' <<<"$recovered_route")"
            [[ "$sync_tree_route_loss_worker_restarts" == \
              "$expected_route_worker_restarts" ]]
            grep -q ' restart-budget=1 ' <<<" $recovered_route "
            grep -q ' last-failure=none$' <<<"$recovered_route"
            route_loss_job="$(awk -v job="$sync_pull_job_id" \
              '$1 == "job=" job { print; exit }' <<<"$route_loss_status")"
            if $sync_tree_route_loss_scenario; then
              sync_tree_route_loss_position_bytes="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ \
                    /^qualification-fault-position=/) {
                  sub(/^qualification-fault-position=/,"",$i); print $i
                }
              }' <<<"$route_loss_header")"
            fi
            sync_tree_route_loss_carrier_losses="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-carrier-losses=/) {
                sub(/^auxiliary-carrier-losses=/,"",$i); print $i
              }
            }' <<<"$route_loss_header")"
            sync_tree_route_loss_reassignments="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-reassignments=/) {
                sub(/^auxiliary-reassignments=/,"",$i); print $i
              }
            }' <<<"$route_loss_header")"
            sync_tree_route_loss_stale_terminals="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-stale-terminals=/) {
                sub(/^auxiliary-stale-terminals=/,"",$i); print $i
              }
            }' <<<"$route_loss_header")"
            sync_tree_route_loss_final_carrier="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^carrier-route=/) {
                sub(/^carrier-route=/,"",$i); print $i
              }
            }' <<<"$route_loss_job")"
            sync_tree_route_loss_retained_partials="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^retained-partials=/) {
                sub(/^retained-partials=/,"",$i); print $i
              }
            }' <<<"$route_loss_job")"
            sync_tree_route_loss_retained_attempts="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^retained-attempts=/) {
                sub(/^retained-attempts=/,"",$i); print $i
              }
            }' <<<"$route_loss_job")"
            sync_tree_route_loss_retained_bytes="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^retained-bytes=/) {
                sub(/^retained-bytes=/,"",$i); print $i
              }
            }' <<<"$route_loss_job")"
            sync_tree_route_loss_retention_fallbacks="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^retention-fallbacks=/) {
                sub(/^retention-fallbacks=/,"",$i); print $i
              }
            }' <<<"$route_loss_job")"
            sync_tree_route_loss_resumed_attempts="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^resumed-attempts=/) {
                sub(/^resumed-attempts=/,"",$i); print $i
              }
            }' <<<"$route_loss_job")"
            sync_tree_route_loss_resumed_bytes="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^resumed-bytes=/) {
                sub(/^resumed-bytes=/,"",$i); print $i
              }
            }' <<<"$route_loss_job")"
            if $sync_tree_route_actual_tor_loss_scenario; then
              grep -q ' qualification-fault=0 ' <<<" $route_loss_header "
            else
              grep -q ' qualification-fault=1 ' <<<" $route_loss_header "
            fi
            (( sync_tree_route_loss_position_bytes >= 65536 ))
            (( sync_tree_route_loss_position_bytes < sync_artifact_bytes ))
            (( sync_tree_route_loss_carrier_losses == 1 ))
            (( sync_tree_route_loss_reassignments == 1 ))
            (( sync_tree_route_loss_stale_terminals >= 1 ))
            (( sync_tree_route_loss_recoveries == 1 ))
            (( sync_tree_route_loss_retained_partials == 0 ))
            (( sync_tree_route_loss_retained_attempts >= 1 ))
            (( sync_tree_route_loss_retained_attempts <= 2 ))
            (( sync_tree_route_loss_retained_bytes >= \
               sync_tree_route_loss_position_bytes ))
            (( sync_tree_route_loss_retention_fallbacks == 0 ))
            (( sync_tree_route_loss_resumed_attempts == \
               sync_tree_route_loss_retained_attempts ))
            (( sync_tree_route_loss_resumed_bytes == \
               sync_tree_route_loss_retained_bytes ))
            grep -q ' carrier=auxiliary ' <<<" $route_loss_job "
            grep -q ' state=complete ' <<<" $route_loss_job "
            [[ "$sync_tree_route_loss_final_carrier" =~ ^[0-9A-F]{64}$ ]]
            sync_tree_route_loss_stopped_carrier="$initial_bulk_route"
            nonzero_route_work="$(awk '
              /route-index=/ {
                for (i=1;i<=NF;i++) if ($i ~ /^admitted-work=/ &&
                    $i != "admitted-work=0") count++
              }
              END { print count + 0 }
            ' <<<"$final_routes")"
            [[ "$sync_tree_route_loss_stopped_carrier" == \
              "$initial_bulk_route" ]]
            [[ "$sync_tree_route_loss_final_carrier" != \
              "$sync_tree_route_loss_stopped_carrier" ]]
            (( final_ready_bulk == 2 ))
            (( nonzero_route_work == 0 ))
            [[ -z "$(find "$sync_root/staging" -type f -print -quit)" ]]
            sync_tree_route_loss_observed=true
            sync_tree_route_resume_observed=true
          fi
          if $sync_tree_route_balance_scenario; then
            failure_phase=sync-tree-route-balance-client
            wait_for_file "$input_dir/device.sync-route-balance-ready"
            balance_ready="$(<"$input_dir/device.sync-route-balance-ready")"
            for balance_namespace in fixed-a fixed-b adaptive-a adaptive-b; do
              balance_head="$(awk -F= -v name="$balance_namespace-head-record" \
                '$1 == name { print $2 }' <<<"$balance_ready")"
              [[ "$balance_head" =~ ^[0-9a-f]{64}$ ]]
              printf -v "balance_head_''${balance_namespace//-/_}" '%s' \
                "$balance_head"
            done
            balance_artifact="$(awk -F= \
              '$1 == "artifact-sha256" { print $2 }' <<<"$balance_ready")"
            balance_manifest="$(awk -F= \
              '$1 == "manifest-sha256" { print $2 }' <<<"$balance_ready")"
            balance_payload_sha256="$(awk -F= \
              '$1 == "payload-sha256" { print $2 }' <<<"$balance_ready")"
            sync_tree_route_balance_artifact_bytes="$(awk -F= \
              '$1 == "artifact-bytes" { print $2 }' <<<"$balance_ready")"
            [[ "$balance_artifact" =~ ^[0-9a-f]{64}$ ]]
            [[ "$balance_manifest" =~ ^[0-9a-f]{64}$ ]]
            [[ "$balance_payload_sha256" =~ ^[0-9a-f]{64}$ ]]
            (( sync_tree_route_balance_artifact_bytes == 8259 ))

            balance_wait_ready() {
              local balance_session balance_authority balance_routes
              local balance_ready_bulk
              while (( SECONDS < deadline )); do
                balance_session="$(iotox --runtime "$runtime" session \
                  "$remote_key" 2>/dev/null || true)"
                balance_authority="$(iotox --runtime "$runtime" \
                  authority-session "$remote_key" 2>/dev/null || true)"
                balance_routes="$(iotox --runtime "$runtime" routes \
                  2>/dev/null || true)"
                balance_ready_bulk="$(awk '
                  / role=bulk / && / lifecycle=ready / { count++ }
                  END { print count + 0 }
                ' <<<"$balance_routes")"
                if grep -q '^state=confirmed$' <<<"$balance_session" && \
                   grep -q '^remote-authorized=1$' <<<"$balance_authority" && \
                   [[ "$balance_ready_bulk" == 2 ]]; then
                  return 0
                fi
                agent_is_running "$agent_pid"
                sleep 0.1
              done
              return 1
            }
            balance_status_value() {
              local balance_field=$1
              awk -v field="$balance_field" 'NR == 1 {
                for (i=1;i<=NF;i++) if ($i ~ ("^" field "=")) {
                  sub("^" field "=", "", $i); print $i; exit
                }
              }'
            }
            balance_job_value() {
              local balance_field=$1
              awk -v field="$balance_field" '{
                for (i=1;i<=NF;i++) if ($i ~ ("^" field "=")) {
                  sub("^" field "=", "", $i); print $i; exit
                }
              }'
            }
            balance_wait_complete() {
              local balance_job_a=$1 balance_job_b=$2 balance_policy=$3
              local balance_status balance_line_a balance_line_b
              local balance_complete_last_report=-1
              while (( SECONDS < deadline )); do
                balance_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                balance_line_a="$(awk -v job="$balance_job_a" \
                  '$1 == "job=" job { print; exit }' <<<"$balance_status")"
                balance_line_b="$(awk -v job="$balance_job_b" \
                  '$1 == "job=" job { print; exit }' <<<"$balance_status")"
                if grep -q ' state=complete ' <<<"$balance_line_a" && \
                   grep -q ' state=complete ' <<<"$balance_line_b"; then
                  printf '%s\n%s\n' "$balance_line_a" "$balance_line_b"
                  return 0
                fi
                if grep -Eq ' state=(failed|cancelled) ' \
                     <<<"$balance_line_a $balance_line_b"; then
                  printf '%s\n%s\n' "$balance_line_a" "$balance_line_b" >&2
                  return 1
                fi
                if (( SECONDS >= balance_complete_last_report + 5 )); then
                  {
                    printf 'phase=%s-completing\n' "$balance_policy"
                    printf 'job-a-hex=%s\n' "$(printf '%s' "$balance_line_a" | \
                      od -An -tx1 | tr -d ' \n')"
                    printf 'job-b-hex=%s\n' "$(printf '%s' "$balance_line_b" | \
                      od -An -tx1 | tr -d ' \n')"
                    printf 'routes-hex=%s\n' "$(iotox --runtime "$runtime" \
                      routes | od -An -tx1 | tr -d ' \n')"
                  } >"$rendezvous_dir/client.sync-route-balance-phase.tmp"
                  mv "$rendezvous_dir/client.sync-route-balance-phase.tmp" \
                    "$rendezvous_dir/client.sync-route-balance-phase"
                  balance_complete_last_report=$SECONDS
                fi
                agent_is_running "$agent_pid"
                sleep 0.05
              done
              return 1
            }
            balance_run_phase() {
              local policy=$1 namespace_a=$2 namespace_b=$3
              local before_status before_count pull_a pull_b job_a job_b
              local status line_a line_b carrier_a carrier_b route_line
              local completed after_status after_count start_ms finish_ms
              local balance_line balance_namespace balance_token
              local balance_expected_var balance_expected balance_activation
              local balance_root balance_routes balance_nonzero
              local selection_delta duration_ms
              local balance_last_report=-1
              local head_retry_count_a=0 head_retry_count_b=0
              local head_last_retry_a=$SECONDS head_last_retry_b=0
              local retry_pull retry_job
              before_status="$(iotox --runtime "$runtime" sync-status)"
              if ! grep -q \
                   "^enabled=1 .*auxiliary-route-policy=$policy " \
                   <<<"$before_status"; then
                {
                  printf 'phase=%s-preflight-failed\n' "$policy"
                  printf 'status-hex=%s\n' "$(printf '%s' "$before_status" | \
                    od -An -tx1 | tr -d ' \n')"
                } >"$rendezvous_dir/client.sync-route-balance-phase.tmp"
                mv "$rendezvous_dir/client.sync-route-balance-phase.tmp" \
                  "$rendezvous_dir/client.sync-route-balance-phase"
                report_failure 1
              fi
              before_count="$(balance_status_value \
                "auxiliary-$policy-selections" <<<"$before_status")"
              [[ "$before_count" =~ ^[0-9]+$ ]]
              start_ms="$(date +%s%3N)"
              pull_a="$(iotox --runtime "$runtime" sync-pull \
                "$remote_key" "$namespace_a")"
              job_a="$(balance_job_value job <<<"$pull_a")"
              [[ "$job_a" =~ ^[1-9][0-9]*$ ]]
              while (( SECONDS < deadline )); do
                status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                line_a="$(awk -v job="$job_a" \
                  '$1 == "job=" job { print; exit }' <<<"$status")"
                carrier_a="$(balance_job_value carrier-route <<<"$line_a")"
                route_line="$(iotox --runtime "$runtime" routes | \
                  awk -v key="$carrier_a" '$0 ~ ("public-key=" key) {
                    print; exit
                  }')"
                if grep -q ' state=awaiting-objects ' <<<"$line_a" && \
                   [[ "$carrier_a" =~ ^[0-9A-F]{64}$ ]] && \
                   grep -Eq ' admitted-work=[1-9][0-9]* ' \
                     <<<" $route_line "; then
                  break
                fi
                if grep -Eq ' state=(complete|failed|cancelled) ' \
                     <<<"$line_a"; then
                  {
                    printf 'phase=%s-terminal-a\n' "$policy"
                    printf 'job-a-hex=%s\n' "$(printf '%s' "$line_a" | \
                      od -An -tx1 | tr -d ' \n')"
                    printf 'route-hex=%s\n' "$(printf '%s' "$route_line" | \
                      od -An -tx1 | tr -d ' \n')"
                  } >"$rendezvous_dir/client.sync-route-balance-phase.tmp"
                  mv "$rendezvous_dir/client.sync-route-balance-phase.tmp" \
                    "$rendezvous_dir/client.sync-route-balance-phase"
                  report_failure 1
                fi
                if grep -q ' state=awaiting-head ' <<<"$line_a" && \
                   (( head_retry_count_a < 8 )) && \
                   (( SECONDS >= head_last_retry_a + 2 )); then
                  retry_pull="$(iotox --runtime "$runtime" sync-pull \
                    "$remote_key" "$namespace_a")"
                  retry_job="$(balance_job_value job <<<"$retry_pull")"
                  [[ "$retry_job" == "$job_a" ]]
                  head_retry_count_a=$((head_retry_count_a + 1))
                  head_last_retry_a=$SECONDS
                fi
                if (( SECONDS >= balance_last_report + 5 )); then
                  {
                    printf 'phase=%s-awaiting-a\n' "$policy"
                    printf 'head-retries-a=%s\n' "$head_retry_count_a"
                    printf 'job-a-hex=%s\n' "$(printf '%s' "$line_a" | \
                      od -An -tx1 | tr -d ' \n')"
                    printf 'route-hex=%s\n' "$(printf '%s' "$route_line" | \
                      od -An -tx1 | tr -d ' \n')"
                  } >"$rendezvous_dir/client.sync-route-balance-phase.tmp"
                  mv "$rendezvous_dir/client.sync-route-balance-phase.tmp" \
                    "$rendezvous_dir/client.sync-route-balance-phase"
                  balance_last_report=$SECONDS
                fi
                agent_is_running "$agent_pid"
                sleep 0.05
              done
              if ! grep -q ' state=awaiting-objects ' <<<"$line_a" || \
                 ! grep -Eq ' admitted-work=[1-9][0-9]* ' \
                   <<<" $route_line "; then
                {
                  printf 'phase=%s-timeout-a\n' "$policy"
                  printf 'job-a-hex=%s\n' "$(printf '%s' "$line_a" | \
                    od -An -tx1 | tr -d ' \n')"
                  printf 'route-hex=%s\n' "$(printf '%s' "$route_line" | \
                    od -An -tx1 | tr -d ' \n')"
                } >"$rendezvous_dir/client.sync-route-balance-phase.tmp"
                mv "$rendezvous_dir/client.sync-route-balance-phase.tmp" \
                  "$rendezvous_dir/client.sync-route-balance-phase"
                report_failure 1
              fi

              pull_b="$(iotox --runtime "$runtime" sync-pull \
                "$remote_key" "$namespace_b")"
              job_b="$(balance_job_value job <<<"$pull_b")"
              [[ "$job_b" =~ ^[1-9][0-9]*$ && "$job_b" != "$job_a" ]]
              head_last_retry_b=$SECONDS
              while (( SECONDS < deadline )); do
                status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                line_a="$(awk -v job="$job_a" \
                  '$1 == "job=" job { print; exit }' <<<"$status")"
                line_b="$(awk -v job="$job_b" \
                  '$1 == "job=" job { print; exit }' <<<"$status")"
                carrier_a="$(balance_job_value carrier-route <<<"$line_a")"
                carrier_b="$(balance_job_value carrier-route <<<"$line_b")"
                if grep -Eq ' carrier=auxiliary .* state=(awaiting-objects|complete) ' \
                     <<<" $line_a " && \
                   grep -Eq ' carrier=auxiliary .* state=(awaiting-objects|complete) ' \
                     <<<" $line_b " && \
                   [[ "$carrier_a" =~ ^[0-9A-F]{64}$ && \
                      "$carrier_b" =~ ^[0-9A-F]{64}$ ]]; then
                  break
                fi
                if grep -Eq ' state=(failed|cancelled) ' \
                     <<<"$line_a $line_b"; then
                  {
                    printf 'phase=%s-terminal-pair\n' "$policy"
                    printf 'job-a-hex=%s\n' "$(printf '%s' "$line_a" | \
                      od -An -tx1 | tr -d ' \n')"
                    printf 'job-b-hex=%s\n' "$(printf '%s' "$line_b" | \
                      od -An -tx1 | tr -d ' \n')"
                  } >"$rendezvous_dir/client.sync-route-balance-phase.tmp"
                  mv "$rendezvous_dir/client.sync-route-balance-phase.tmp" \
                    "$rendezvous_dir/client.sync-route-balance-phase"
                  report_failure 1
                fi
                if grep -q ' state=awaiting-head ' <<<"$line_b" && \
                   (( head_retry_count_b < 8 )) && \
                   (( SECONDS >= head_last_retry_b + 2 )); then
                  retry_pull="$(iotox --runtime "$runtime" sync-pull \
                    "$remote_key" "$namespace_b")"
                  retry_job="$(balance_job_value job <<<"$retry_pull")"
                  [[ "$retry_job" == "$job_b" ]]
                  head_retry_count_b=$((head_retry_count_b + 1))
                  head_last_retry_b=$SECONDS
                fi
                if (( SECONDS >= balance_last_report + 5 )); then
                  {
                    printf 'phase=%s-awaiting-pair\n' "$policy"
                    printf 'head-retries-a=%s\n' "$head_retry_count_a"
                    printf 'head-retries-b=%s\n' "$head_retry_count_b"
                    printf 'job-a-hex=%s\n' "$(printf '%s' "$line_a" | \
                      od -An -tx1 | tr -d ' \n')"
                    printf 'job-b-hex=%s\n' "$(printf '%s' "$line_b" | \
                      od -An -tx1 | tr -d ' \n')"
                  } >"$rendezvous_dir/client.sync-route-balance-phase.tmp"
                  mv "$rendezvous_dir/client.sync-route-balance-phase.tmp" \
                    "$rendezvous_dir/client.sync-route-balance-phase"
                  balance_last_report=$SECONDS
                fi
                agent_is_running "$agent_pid"
                sleep 0.05
              done
              if [[ ! "$carrier_a" =~ ^[0-9A-F]{64}$ || \
                    ! "$carrier_b" =~ ^[0-9A-F]{64}$ ]]; then
                {
                  printf 'phase=%s-carrier-invalid\n' "$policy"
                  printf 'job-a-hex=%s\n' "$(printf '%s' "$line_a" | \
                    od -An -tx1 | tr -d ' \n')"
                  printf 'job-b-hex=%s\n' "$(printf '%s' "$line_b" | \
                    od -An -tx1 | tr -d ' \n')"
                } >"$rendezvous_dir/client.sync-route-balance-phase.tmp"
                mv "$rendezvous_dir/client.sync-route-balance-phase.tmp" \
                  "$rendezvous_dir/client.sync-route-balance-phase"
                report_failure 1
              fi
              if [[ "$policy" == fixed ]]; then
                if [[ "$carrier_a" != "$carrier_b" ]]; then
                  {
                    printf 'phase=fixed-policy-mismatch\n'
                    printf 'carrier-a=%s\n' "$carrier_a"
                    printf 'carrier-b=%s\n' "$carrier_b"
                    printf 'job-a-hex=%s\n' "$(printf '%s' "$line_a" | \
                      od -An -tx1 | tr -d ' \n')"
                    printf 'job-b-hex=%s\n' "$(printf '%s' "$line_b" | \
                      od -An -tx1 | tr -d ' \n')"
                    printf 'routes-hex=%s\n' "$(iotox --runtime "$runtime" \
                      routes | od -An -tx1 | tr -d ' \n')"
                  } >"$rendezvous_dir/client.sync-route-balance-phase.tmp"
                  mv "$rendezvous_dir/client.sync-route-balance-phase.tmp" \
                    "$rendezvous_dir/client.sync-route-balance-phase"
                  report_failure 1
                fi
                sync_tree_route_balance_fixed_same_carrier=true
                sync_tree_route_balance_fixed_carrier_a="$carrier_a"
                sync_tree_route_balance_fixed_carrier_b="$carrier_b"
              else
                if [[ "$carrier_a" == "$carrier_b" ]]; then
                  {
                    printf 'phase=adaptive-policy-mismatch\n'
                    printf 'carrier-a=%s\n' "$carrier_a"
                    printf 'carrier-b=%s\n' "$carrier_b"
                    printf 'job-a-hex=%s\n' "$(printf '%s' "$line_a" | \
                      od -An -tx1 | tr -d ' \n')"
                    printf 'job-b-hex=%s\n' "$(printf '%s' "$line_b" | \
                      od -An -tx1 | tr -d ' \n')"
                    printf 'routes-hex=%s\n' "$(iotox --runtime "$runtime" \
                      routes | od -An -tx1 | tr -d ' \n')"
                  } >"$rendezvous_dir/client.sync-route-balance-phase.tmp"
                  mv "$rendezvous_dir/client.sync-route-balance-phase.tmp" \
                    "$rendezvous_dir/client.sync-route-balance-phase"
                  report_failure 1
                fi
                sync_tree_route_balance_adaptive_distinct_carriers=true
                sync_tree_route_balance_adaptive_carrier_a="$carrier_a"
                sync_tree_route_balance_adaptive_carrier_b="$carrier_b"
              fi
              {
                printf 'phase=%s-assigned\n' "$policy"
                printf 'carrier-a=%s\n' "$carrier_a"
                printf 'carrier-b=%s\n' "$carrier_b"
              } >"$rendezvous_dir/client.sync-route-balance-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-balance-phase.tmp" \
                "$rendezvous_dir/client.sync-route-balance-phase"

              completed="$(balance_wait_complete "$job_a" "$job_b" \
                "$policy")"
              finish_ms="$(date +%s%3N)"
              while read -r balance_line; do
                grep -q ' requested=2 ' <<<"$balance_line"
                grep -q ' admitted=2 ' <<<"$balance_line"
                grep -q ' committed=2 ' <<<"$balance_line"
              done <<<"$completed"
              for balance_namespace in "$namespace_a" "$namespace_b"; do
                balance_token="''${balance_namespace#sandwurm-balance-}"
                balance_expected_var="balance_head_''${balance_token//-/_}"
                balance_expected="''${!balance_expected_var}"
                balance_activation="$(iotox --runtime "$runtime" \
                  sync-activate "$balance_namespace" "$balance_expected")"
                grep -q ' decision=activated ' <<<" $balance_activation "
                grep -q ' kind=treepack ' <<<" $balance_activation "
                balance_root="$state_dir/sync-route-balance-$balance_token"
                [[ "$(sha256sum \
                  "$balance_root/materialized-trees/current/payload.bin" | \
                  cut -d' ' -f1)" == "$balance_payload_sha256" ]]
                [[ -z "$(find "$balance_root/staging" -type f -print -quit)" ]]
                sync_tree_route_balance_activations=$((
                  sync_tree_route_balance_activations + 1
                ))
              done
              while (( SECONDS < deadline )); do
                balance_routes="$(iotox --runtime "$runtime" routes)"
                balance_nonzero="$(awk '
                  /route-index=/ {
                    for (i=1;i<=NF;i++) if ($i ~ /^admitted-work=/ &&
                        $i != "admitted-work=0") count++
                  }
                  END { print count + 0 }
                ' <<<"$balance_routes")"
                [[ "$balance_nonzero" == 0 ]] && break
                agent_is_running "$agent_pid"
                sleep 0.05
              done
              [[ "$balance_nonzero" == 0 ]]
              after_status="$(iotox --runtime "$runtime" sync-status)"
              after_count="$(balance_status_value \
                "auxiliary-$policy-selections" <<<"$after_status")"
              [[ "$after_count" =~ ^[0-9]+$ ]]
              selection_delta=$((after_count - before_count))
              (( selection_delta == 2 ))
              duration_ms=$((finish_ms - start_ms))
              (( duration_ms > 0 ))
              if [[ "$policy" == fixed ]]; then
                sync_tree_route_balance_fixed_selections="$selection_delta"
                sync_tree_route_balance_fixed_duration_ms="$duration_ms"
                sync_tree_route_balance_fixed_head_retries=$((
                  head_retry_count_a + head_retry_count_b
                ))
              else
                sync_tree_route_balance_adaptive_selections="$selection_delta"
                sync_tree_route_balance_adaptive_duration_ms="$duration_ms"
                sync_tree_route_balance_adaptive_head_retries=$((
                  head_retry_count_a + head_retry_count_b
                ))
              fi
            }

            balance_configure_policy() {
              local requested_policy=$1 argument skip_next=false
              local -a filtered_arguments=()
              for argument in "''${agent_args[@]}"; do
                if $skip_next; then
                  skip_next=false
                  continue
                fi
                if [[ "$argument" == --sync-route-policy ]]; then
                  skip_next=true
                  continue
                fi
                filtered_arguments+=("$argument")
              done
              ! $skip_next
              agent_args=("''${filtered_arguments[@]}")
              if [[ "$requested_policy" == adaptive ]]; then
                agent_args+=(--sync-route-policy adaptive)
              else
                [[ "$requested_policy" == fixed ]]
              fi
            }

            sync_tree_route_balance_phase_order=adaptive-fixed
            balance_wait_ready
            printf 'phase=adaptive-start\n' \
              >"$rendezvous_dir/client.sync-route-balance-phase.tmp"
            mv "$rendezvous_dir/client.sync-route-balance-phase.tmp" \
              "$rendezvous_dir/client.sync-route-balance-phase"
            balance_run_phase adaptive sandwurm-balance-adaptive-a \
              sandwurm-balance-adaptive-b
            printf 'phase=adaptive-complete\n' \
              >"$rendezvous_dir/client.sync-route-balance-phase.tmp"
            mv "$rendezvous_dir/client.sync-route-balance-phase.tmp" \
              "$rendezvous_dir/client.sync-route-balance-phase"
            stop_agent
            balance_configure_policy fixed
            start_agent
            balance_wait_ready
            printf 'phase=fixed-start\n' \
              >"$rendezvous_dir/client.sync-route-balance-phase.tmp"
            mv "$rendezvous_dir/client.sync-route-balance-phase.tmp" \
              "$rendezvous_dir/client.sync-route-balance-phase"
            balance_run_phase fixed sandwurm-balance-fixed-a \
              sandwurm-balance-fixed-b
            printf 'phase=fixed-complete\n' \
              >"$rendezvous_dir/client.sync-route-balance-phase.tmp"
            mv "$rendezvous_dir/client.sync-route-balance-phase.tmp" \
              "$rendezvous_dir/client.sync-route-balance-phase"
            (( sync_tree_route_balance_activations == 4 ))
            sync_tree_route_balance_observed=true
          fi
          if $sync_tree_route_population_fixture; then
            failure_phase=sync-tree-route-population-client
            if $sync_tree_route_concurrent_cancel_scenario; then
              failure_phase=sync-tree-route-concurrent-cancel-client
            elif $sync_tree_route_population_loss_scenario; then
              failure_phase=sync-tree-route-population-loss-client
            elif $sync_tree_route_loss_admission_scenario; then
              failure_phase=sync-tree-route-loss-admission-client
            elif $sync_tree_route_startup_admission_scenario; then
              failure_phase=sync-tree-route-startup-admission-client
            elif $sync_tree_route_throughput_scenario; then
              failure_phase=sync-tree-route-throughput-client
            fi
            wait_for_file "$input_dir/device.sync-route-population-ready"
            population_ready="$(<"$input_dir/device.sync-route-population-ready")"
            population_jobs_per_policy="$(awk -F= \
              '$1 == "jobs-per-policy" { print $2 }' \
              <<<"$population_ready")"
            population_artifact_bytes="$(awk -F= \
              '$1 == "artifact-bytes" { print $2 }' \
              <<<"$population_ready")"
            population_payload_bytes="$(awk -F= \
              '$1 == "payload-bytes" { print $2 }' \
              <<<"$population_ready")"
            population_policies=(fixed adaptive)
            if $sync_tree_route_concurrent_cancel_scenario; then
              (( population_jobs_per_policy == 8 ))
              if $sync_tree_route_common_link_fairness_scenario; then
                (( population_payload_bytes == 1048576 ))
                (( population_artifact_bytes == 1048643 ))
              else
                (( population_payload_bytes == 262144 ))
                (( population_artifact_bytes == 262211 ))
              fi
              sync_tree_route_concurrent_cancel_artifact_bytes="$population_artifact_bytes"
              population_policies=(cancel)
            elif $sync_tree_route_population_loss_scenario || \
                 $sync_tree_route_loss_admission_scenario; then
              (( population_jobs_per_policy == 8 ))
              (( population_payload_bytes == 524288 ))
              (( population_artifact_bytes == 524355 ))
              if $sync_tree_route_population_loss_scenario; then
                sync_tree_route_population_loss_jobs="$population_jobs_per_policy"
              else
                sync_tree_route_population_loss_jobs=4
              fi
              sync_tree_route_population_loss_artifact_bytes="$population_artifact_bytes"
              population_policies=(loss)
            elif $sync_tree_route_startup_admission_scenario; then
              (( population_jobs_per_policy == 2 ))
              (( population_payload_bytes == 16777216 ))
              (( population_artifact_bytes == 16777283 ))
              sync_tree_route_startup_admission_jobs="$population_jobs_per_policy"
              sync_tree_route_startup_admission_artifact_bytes="$population_artifact_bytes"
              population_policies=(startup)
            elif $sync_tree_route_throughput_scenario; then
              (( population_jobs_per_policy == 2 ))
              (( population_payload_bytes == 16777216 ))
              (( population_artifact_bytes == 16777283 ))
              sync_tree_route_throughput_jobs_per_phase="$population_jobs_per_policy"
              sync_tree_route_throughput_phases=4
              sync_tree_route_throughput_artifact_bytes="$population_artifact_bytes"
              sync_tree_route_throughput_phase_order=fixed-a,adaptive-a,adaptive-b,fixed-b
              sync_tree_route_throughput_restart_hold_ms=5000
              population_policies=(fixed-a adaptive-a adaptive-b fixed-b)
            else
              (( population_jobs_per_policy == 8 ))
              (( population_payload_bytes == 131072 ))
              (( population_artifact_bytes > 131072 && \
                 population_artifact_bytes < 262144 ))
              sync_tree_route_population_jobs="$population_jobs_per_policy"
              sync_tree_route_population_artifact_bytes="$population_artifact_bytes"
            fi
            for population_policy in "''${population_policies[@]}"; do
              for ((population_index=0; \
                    population_index < population_jobs_per_policy; \
                    ++population_index)); do
                population_token="$population_policy-$population_index"
                for population_field in head-record artifact-sha256 \
                  manifest-sha256 payload-sha256; do
                  population_value="$(awk -F= \
                    -v name="$population_token-$population_field" \
                    '$1 == name { print $2 }' <<<"$population_ready")"
                  [[ "$population_value" =~ ^[0-9a-f]{64}$ ]]
                done
              done
            done

            population_status_value() {
              local population_field=$1
              awk -v field="$population_field" 'NR == 1 {
                for (i=1;i<=NF;i++) if ($i ~ ("^" field "=")) {
                  sub("^" field "=", "", $i); print $i; exit
                }
              }'
            }
            population_job_value() {
              local population_field=$1
              awk -v field="$population_field" '{
                for (i=1;i<=NF;i++) if ($i ~ ("^" field "=")) {
                  sub("^" field "=", "", $i); print $i; exit
                }
              }'
            }
            population_wait_ready() {
              local population_session population_authority population_routes
              local population_ready_bulk=0 population_confirmed=0
              local population_authorized=0
              local population_maximum_wait_seconds="''${1:-0}"
              local population_wait_label="''${2:-base}"
              local population_wait_deadline="$deadline"
              if (( population_maximum_wait_seconds > 0 && \
                    SECONDS + population_maximum_wait_seconds < \
                      population_wait_deadline )); then
                population_wait_deadline=$(($SECONDS + \
                  population_maximum_wait_seconds))
              fi
              while (( SECONDS < population_wait_deadline )); do
                population_session="$(iotox --runtime "$runtime" session \
                  "$remote_key" 2>/dev/null || true)"
                population_authority="$(iotox --runtime "$runtime" \
                  authority-session "$remote_key" 2>/dev/null || true)"
                population_routes="$(iotox --runtime "$runtime" routes \
                  2>/dev/null || true)"
                population_ready_bulk="$(awk '
                  / role=bulk / && / lifecycle=ready / { count++ }
                  END { print count + 0 }
                ' <<<"$population_routes")"
                population_confirmed=0
                population_authorized=0
                grep -q '^state=confirmed$' <<<"$population_session" && \
                  population_confirmed=1
                grep -q '^remote-authorized=1$' \
                  <<<"$population_authority" && population_authorized=1
                if (( population_confirmed == 1 && \
                      population_authorized == 1 && \
                      population_ready_bulk == 2 )); then
                  return 0
                fi
                agent_is_running "$agent_pid"
                sleep 0.1
              done
              {
                printf 'phase=%s-readiness-timeout\n' \
                  "$population_wait_label"
                printf 'session-confirmed=%s\n' "$population_confirmed"
                printf 'authority-authorized=%s\n' "$population_authorized"
                printf 'ready-bulk=%s\n' "$population_ready_bulk"
              } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                "$rendezvous_dir/client.sync-route-population-phase"
              return 1
            }
            population_configure_policy() {
              local requested_policy=$1 argument skip_next=false
              local -a filtered_arguments=()
              for argument in "''${agent_args[@]}"; do
                if $skip_next; then
                  skip_next=false
                  continue
                fi
                if [[ "$argument" == --sync-route-policy ]]; then
                  skip_next=true
                  continue
                fi
                filtered_arguments+=("$argument")
              done
              ! $skip_next
              agent_args=("''${filtered_arguments[@]}")
              if [[ "$requested_policy" == adaptive ]]; then
                agent_args+=(--sync-route-policy adaptive)
              else
                [[ "$requested_policy" == fixed ]]
              fi
            }
            population_run_phase() {
              local policy=$1
              local before_status before_count after_status after_count
              local population_pull population_job population_status
              local population_line population_carrier population_position
              local population_committed
              local population_assigned population_complete population_progressed
              local population_routes population_nonzero population_activation
              local population_expected_head population_expected_payload
              local population_root population_now_ms population_start_ms
              local population_finish_ms population_duration_ms
              local population_pattern= population_prefix=0
              local population_max_prefix=0 population_zero_count=0
              local population_one_count=0 population_min_progress=-1
              local population_invalid_carriers=0
              local population_max_progress=0 population_absolute_prefix=0
              local population_progress=0 population_spread_ms=0
              local selection_delta
              local resource_state resource_status resource_output resource_digest
              local -a population_jobs=() population_carriers=()
              local -a population_first_progress=()
              local -a population_route_keys=()
              local -a population_lines=()

              before_status="$(iotox --runtime "$runtime" sync-status)"
              grep -q \
                "^enabled=1 .*auxiliary-route-policy=$policy " \
                <<<"$before_status"
              before_count="$(population_status_value \
                "auxiliary-$policy-selections" <<<"$before_status")"
              [[ "$before_count" =~ ^[0-9]+$ ]]
              resource_state="$state_dir/sync-route-population-$policy-resource.json"
              resource_status="$state_dir/sync-route-population-$policy-status.txt"
              resource_output="$receipt_dir/sync-route-population-$policy-resource.tsv"
              iotox --runtime "$runtime" status >"$resource_status"
              python3 ${../tools/capture-process-resources.py} begin \
                --pid "$agent_pid" --runtime-status "$resource_status" \
                --state "$resource_state" --role client
              # Snapshot stable keys before admitting the full population.
              # The first instrumented cell proved that a synchronous `routes`
              # query can starve behind eight admitted object jobs even though
              # `sync-status` and the transfer workers continue to advance.
              mapfile -t population_route_keys < <(iotox --runtime "$runtime" \
                routes | awk '/ role=bulk / {
                  for (i=1;i<=NF;i++) if ($i ~ /^public-key=/) {
                    sub(/^public-key=/,"",$i); print $i
                  }
                }' | sort)
              (( ''${#population_route_keys[@]} == 2 ))
              population_start_ms="$(date +%s%3N)"

              for population_index in 0 1 2 3 4 5 6 7; do
                population_pull="$(iotox --runtime "$runtime" sync-pull \
                  "$remote_key" \
                  "sandwurm-population-$policy-$population_index")"
                population_job="$(population_job_value job \
                  <<<"$population_pull")"
                [[ "$population_job" =~ ^[1-9][0-9]*$ ]]
                population_jobs[$population_index]="$population_job"
                population_carriers[$population_index]=
                population_first_progress[$population_index]=-1
              done
              {
                printf 'phase=%s-pulls-started\n' "$policy"
                printf 'jobs=8\n'
              } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                "$rendezvous_dir/client.sync-route-population-phase"

              while (( SECONDS < deadline )); do
                population_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                population_now_ms="$(date +%s%3N)"
                population_assigned=0
                for population_index in 0 1 2 3 4 5 6 7; do
                  population_line="$(awk \
                    -v job="''${population_jobs[$population_index]}" \
                    '$1 == "job=" job { print; exit }' \
                    <<<"$population_status")"
                  population_lines[$population_index]="$population_line"
                  ! grep -Eq ' state=(failed|cancelled) ' \
                    <<<"$population_line"
                  population_carrier="$(population_job_value carrier-route \
                    <<<"$population_line")"
                  if [[ "$population_carrier" == \
                          "''${population_route_keys[0]}" || \
                        "$population_carrier" == \
                          "''${population_route_keys[1]}" ]]; then
                    population_carriers[$population_index]="$population_carrier"
                    population_assigned=$((population_assigned + 1))
                  fi
                  population_position="$(population_job_value \
                    carrier-receive-position <<<"$population_line")"
                  population_committed="$(population_job_value committed \
                    <<<"$population_line")"
                  [[ "$population_position" =~ ^[0-9]+$ ]]
                  [[ "$population_committed" =~ ^[0-9]+$ ]]
                  if (( population_position > 0 || population_committed > 0 )) && \
                     (( population_first_progress[$population_index] < 0 )); then
                    population_first_progress[$population_index]=$(($population_now_ms - population_start_ms))
                  fi
                done
                {
                  printf 'phase=%s-assignment\n' "$policy"
                  printf 'assigned=%s\n' "$population_assigned"
                } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
                mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                  "$rendezvous_dir/client.sync-route-population-phase"
                (( population_assigned == 8 )) && break
                agent_is_running "$agent_pid"
                sleep 0.02
              done
              (( population_assigned == 8 ))
              for population_index in 0 1 2 3 4 5 6 7; do
                if [[ "''${population_carriers[$population_index]}" == \
                      "''${population_route_keys[0]}" ]]; then
                  population_pattern+=0
                  population_prefix=$((population_prefix + 1))
                  population_zero_count=$((population_zero_count + 1))
                elif [[ "''${population_carriers[$population_index]}" == \
                        "''${population_route_keys[1]}" ]]; then
                  population_pattern+=1
                  population_prefix=$((population_prefix - 1))
                  population_one_count=$((population_one_count + 1))
                else
                  population_pattern+=x
                  population_invalid_carriers=$((population_invalid_carriers + 1))
                fi
                population_absolute_prefix=$population_prefix
                (( population_absolute_prefix < 0 )) && \
                  population_absolute_prefix=$((-population_absolute_prefix))
                (( population_absolute_prefix > population_max_prefix )) && \
                  population_max_prefix=$population_absolute_prefix
              done
              {
                printf 'phase=%s-pattern-observed\n' "$policy"
                printf 'assigned=8\n'
                printf 'pattern=%s\n' "$population_pattern"
                printf 'route-zero=%s\n' "''${population_route_keys[0]}"
                printf 'route-one=%s\n' "''${population_route_keys[1]}"
                printf 'invalid-carriers=%s\n' "$population_invalid_carriers"
                for population_index in 0 1 2 3 4 5 6 7; do
                  printf 'carrier-%s=%s\n' "$population_index" \
                    "''${population_carriers[$population_index]}"
                done
              } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                "$rendezvous_dir/client.sync-route-population-phase"
              (( population_invalid_carriers == 0 ))
              (( population_zero_count == 4 && population_one_count == 4 ))
              if [[ "$policy" == fixed ]]; then
                [[ "$population_pattern" == 00001111 ]]
                (( population_max_prefix == 4 ))
              else
                [[ "$population_pattern" == 01010101 ]]
                (( population_max_prefix == 1 ))
              fi
              {
                printf 'phase=%s-assigned\n' "$policy"
                printf 'assigned=8\n'
                printf 'pattern=%s\n' "$population_pattern"
              } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                "$rendezvous_dir/client.sync-route-population-phase"

              while (( SECONDS < deadline )); do
                population_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                population_now_ms="$(date +%s%3N)"
                population_progressed=0
                for population_index in 0 1 2 3 4 5 6 7; do
                  population_line="$(awk \
                    -v job="''${population_jobs[$population_index]}" \
                    '$1 == "job=" job { print; exit }' \
                    <<<"$population_status")"
                  population_lines[$population_index]="$population_line"
                  ! grep -Eq ' state=(failed|cancelled) ' \
                    <<<"$population_line"
                  population_position="$(population_job_value \
                    carrier-receive-position <<<"$population_line")"
                  population_committed="$(population_job_value committed \
                    <<<"$population_line")"
                  [[ "$population_position" =~ ^[0-9]+$ ]]
                  [[ "$population_committed" =~ ^[0-9]+$ ]]
                  if (( population_position > 0 || population_committed > 0 )) && \
                     (( population_first_progress[$population_index] < 0 )); then
                    population_first_progress[$population_index]=$(($population_now_ms - population_start_ms))
                  fi
                  if (( population_first_progress[$population_index] >= 0 )); then
                    population_progressed=$((population_progressed + 1))
                  fi
                done
                {
                  printf 'phase=%s-progress\n' "$policy"
                  printf 'assigned=8\n'
                  printf 'progressed=%s\n' "$population_progressed"
                  printf 'pattern=%s\n' "$population_pattern"
                  for population_index in 0 1 2 3 4 5 6 7; do
                    printf 'job-%s=%s\n' "$population_index" \
                      "''${population_lines[$population_index]}"
                  done
                } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
                mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                  "$rendezvous_dir/client.sync-route-population-phase"
                (( population_progressed == 8 )) && break
                agent_is_running "$agent_pid"
                sleep 0.02
              done
              (( population_progressed == 8 ))
              for population_index in 0 1 2 3 4 5 6 7; do
                population_progress="''${population_first_progress[$population_index]}"
                if (( population_min_progress < 0 || \
                     population_progress < population_min_progress )); then
                  population_min_progress=$population_progress
                fi
                (( population_progress > population_max_progress )) && \
                  population_max_progress=$population_progress
              done
              population_spread_ms=$(($population_max_progress - population_min_progress))

              while (( SECONDS < deadline )); do
                population_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                population_complete=0
                for population_index in 0 1 2 3 4 5 6 7; do
                  population_line="$(awk \
                    -v job="''${population_jobs[$population_index]}" \
                    '$1 == "job=" job { print; exit }' \
                    <<<"$population_status")"
                  ! grep -Eq ' state=(failed|cancelled) ' \
                    <<<"$population_line"
                  if grep -q ' state=complete ' <<<"$population_line"; then
                    grep -q ' requested=2 ' <<<"$population_line"
                    grep -q ' admitted=2 ' <<<"$population_line"
                    grep -q ' committed=2 ' <<<"$population_line"
                    population_complete=$((population_complete + 1))
                  fi
                done
                if (( population_complete == 8 )); then
                  break
                fi
                {
                  printf 'phase=%s-population\n' "$policy"
                  printf 'assigned=%s\n' "$population_assigned"
                  printf 'progressed=%s\n' "$population_progressed"
                  printf 'complete=%s\n' "$population_complete"
                  printf 'pattern=%s\n' "$population_pattern"
                } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
                mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                  "$rendezvous_dir/client.sync-route-population-phase"
                agent_is_running "$agent_pid"
                sleep 0.05
              done
              (( population_complete == 8 ))

              for population_index in 0 1 2 3 4 5 6 7; do
                population_token="$policy-$population_index"
                population_expected_head="$(awk -F= \
                  -v name="$population_token-head-record" \
                  '$1 == name { print $2 }' <<<"$population_ready")"
                population_expected_payload="$(awk -F= \
                  -v name="$population_token-payload-sha256" \
                  '$1 == name { print $2 }' <<<"$population_ready")"
                population_activation="$(iotox --runtime "$runtime" \
                  sync-activate "sandwurm-population-$population_token" \
                  "$population_expected_head")"
                grep -q ' decision=activated ' <<<" $population_activation "
                grep -q ' kind=treepack ' <<<" $population_activation "
                population_root="$state_dir/sync-route-population-$population_token"
                [[ "$(sha256sum \
                  "$population_root/materialized-trees/current/payload.bin" | \
                  cut -d' ' -f1)" == "$population_expected_payload" ]]
                [[ -z "$(find "$population_root/staging" -type f \
                  -print -quit)" ]]
                sync_tree_route_population_activations=$(($sync_tree_route_population_activations + 1))
              done
              while (( SECONDS < deadline )); do
                population_routes="$(iotox --runtime "$runtime" routes)"
                population_nonzero="$(awk '
                  /route-index=/ {
                    for (i=1;i<=NF;i++) if ($i ~ /^admitted-work=/ &&
                        $i != "admitted-work=0") count++
                  }
                  END { print count + 0 }
                ' <<<"$population_routes")"
                (( population_nonzero == 0 )) && break
                agent_is_running "$agent_pid"
                sleep 0.05
              done
              (( population_nonzero == 0 ))
              population_finish_ms="$(date +%s%3N)"
              iotox --runtime "$runtime" status >"$resource_status"
              python3 ${../tools/capture-process-resources.py} finish \
                --pid "$agent_pid" --runtime-status "$resource_status" \
                --state "$resource_state" --output "$resource_output"
              resource_digest="$(sha256sum "$resource_output" | \
                cut -d' ' -f1)"
              [[ "$resource_digest" =~ ^[0-9a-f]{64}$ ]]
              after_status="$(iotox --runtime "$runtime" sync-status)"
              after_count="$(population_status_value \
                "auxiliary-$policy-selections" <<<"$after_status")"
              [[ "$after_count" =~ ^[0-9]+$ ]]
              selection_delta=$((after_count - before_count))
              (( selection_delta == 8 ))
              population_duration_ms=$(($population_finish_ms - population_start_ms))
              (( population_duration_ms > 0 ))
              if [[ "$policy" == fixed ]]; then
                sync_tree_route_population_fixed_pattern="$population_pattern"
                sync_tree_route_population_fixed_max_prefix_imbalance="$population_max_prefix"
                sync_tree_route_population_fixed_progress_jobs="$population_progressed"
                sync_tree_route_population_fixed_progress_observation_spread_ms="$population_spread_ms"
                sync_tree_route_population_fixed_duration_ms="$population_duration_ms"
                sync_tree_route_population_fixed_resource_sha256="$resource_digest"
              else
                sync_tree_route_population_adaptive_pattern="$population_pattern"
                sync_tree_route_population_adaptive_max_prefix_imbalance="$population_max_prefix"
                sync_tree_route_population_adaptive_progress_jobs="$population_progressed"
                sync_tree_route_population_adaptive_progress_observation_spread_ms="$population_spread_ms"
                sync_tree_route_population_adaptive_duration_ms="$population_duration_ms"
                sync_tree_route_population_adaptive_resource_sha256="$resource_digest"
              fi
              {
                printf 'phase=%s-complete\n' "$policy"
                printf 'duration-ms=%s\n' "$population_duration_ms"
                printf 'progress-observation-spread-ms=%s\n' "$population_spread_ms"
              } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                "$rendezvous_dir/client.sync-route-population-phase"
            }

            population_run_concurrent_cancel() {
              local before_status before_count before_reassignments
              local after_status after_count after_reassignments
              local cancel_pull cancel_job cancel_status cancel_line
              local cancel_carrier cancel_worker cancel_pattern=
              local cancel_zero_count=0 cancel_one_count=0
              local cancel_assigned=0 cancel_terminal=0 survivor_complete=0
              local cancel_started_ms cancel_finished_ms cancel_deadline_ms
              local cancel_routes cancel_work cancel_ready_bulk
              local cancel_expected_head cancel_expected_payload
              local cancel_activation cancel_root cancel_selection_delta
              local cancel_reassignment_delta cancel_resource_digest
              local resource_state resource_status resource_output
              local -a cancel_jobs=() cancel_carriers=() cancel_workers=()
              local -a cancel_route_keys=() cancel_pids=()
              local -a cancel_indices=(0 1 4 5)
              local -a survivor_indices=(2 3 6 7)

              before_status="$(iotox --runtime "$runtime" sync-status)"
              grep -q '^enabled=1 .*auxiliary-route-policy=adaptive ' \
                <<<"$before_status"
              before_count="$(population_status_value \
                auxiliary-adaptive-selections <<<"$before_status")"
              before_reassignments="$(population_status_value \
                auxiliary-reassignments <<<"$before_status")"
              [[ "$before_count" =~ ^[0-9]+$ ]]
              [[ "$before_reassignments" =~ ^[0-9]+$ ]]
              resource_state="$state_dir/sync-route-concurrent-cancel-resource.json"
              resource_status="$state_dir/sync-route-concurrent-cancel-status.txt"
              resource_output="$receipt_dir/sync-route-concurrent-cancel-resource.tsv"
              iotox --runtime "$runtime" status >"$resource_status"
              python3 ${../tools/capture-process-resources.py} begin \
                --pid "$agent_pid" --runtime-status "$resource_status" \
                --state "$resource_state" --role client
              mapfile -t cancel_route_keys < <(iotox --runtime "$runtime" \
                routes | awk '/ role=bulk / {
                  for (i=1;i<=NF;i++) if ($i ~ /^public-key=/) {
                    sub(/^public-key=/,"",$i); print $i
                  }
                }' | sort)
              (( ''${#cancel_route_keys[@]} == 2 ))

              for cancel_index in 0 1 2 3 4 5 6 7; do
                cancel_pull="$(iotox --runtime "$runtime" sync-pull \
                  "$remote_key" "sandwurm-population-cancel-$cancel_index")"
                cancel_job="$(population_job_value job <<<"$cancel_pull")"
                [[ "$cancel_job" =~ ^[1-9][0-9]*$ ]]
                cancel_jobs[$cancel_index]="$cancel_job"
                cancel_carriers[$cancel_index]=
                cancel_workers[$cancel_index]=
              done
              {
                printf 'phase=concurrent-cancel-assignment\n'
                printf 'jobs=8\n'
              } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                "$rendezvous_dir/client.sync-route-population-phase"

              while (( SECONDS < deadline )); do
                cancel_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                cancel_assigned=0
                for cancel_index in 0 1 2 3 4 5 6 7; do
                  cancel_line="$(awk \
                    -v job="''${cancel_jobs[$cancel_index]}" \
                    '$1 == "job=" job { print; exit }' \
                    <<<"$cancel_status")"
                  [[ -n "$cancel_line" ]]
                  ! grep -Eq ' state=(failed|cancelled|complete) ' \
                    <<<"$cancel_line"
                  cancel_carrier="$(population_job_value carrier-route \
                    <<<"$cancel_line")"
                  cancel_worker="$(population_job_value carrier-worker \
                    <<<"$cancel_line")"
                  if [[ "$cancel_carrier" == "''${cancel_route_keys[0]}" || \
                        "$cancel_carrier" == "''${cancel_route_keys[1]}" ]]; then
                    [[ "$cancel_worker" =~ ^[1-9][0-9]*$ ]]
                    cancel_carriers[$cancel_index]="$cancel_carrier"
                    cancel_workers[$cancel_index]="$cancel_worker"
                    cancel_assigned=$((cancel_assigned + 1))
                  fi
                done
                (( cancel_assigned == 8 )) && break
                agent_is_running "$agent_pid"
                sleep 0.01
              done
              (( cancel_assigned == 8 ))
              for cancel_index in 0 1 2 3 4 5 6 7; do
                if [[ "''${cancel_carriers[$cancel_index]}" == \
                      "''${cancel_route_keys[0]}" ]]; then
                  cancel_pattern+=0
                elif [[ "''${cancel_carriers[$cancel_index]}" == \
                        "''${cancel_route_keys[1]}" ]]; then
                  cancel_pattern+=1
                else
                  cancel_pattern+=x
                fi
              done
              [[ "$cancel_pattern" == 01010101 ]]
              for cancel_index in "''${cancel_indices[@]}"; do
                if [[ "''${cancel_carriers[$cancel_index]}" == \
                      "''${cancel_route_keys[0]}" ]]; then
                  cancel_zero_count=$((cancel_zero_count + 1))
                else
                  [[ "''${cancel_carriers[$cancel_index]}" == \
                    "''${cancel_route_keys[1]}" ]]
                  cancel_one_count=$((cancel_one_count + 1))
                fi
              done
              (( cancel_zero_count == 2 && cancel_one_count == 2 ))
              cancel_routes="$(iotox --runtime "$runtime" routes)"
              cancel_work="$(awk '
                /route-index=/ {
                  for (i=1;i<=NF;i++) if ($i ~ /^admitted-work=/) {
                    sub(/^admitted-work=/,"",$i); total += $i
                  }
                }
                END { print total + 0 }
              ' <<<"$cancel_routes")"
              [[ "$cancel_work" =~ ^[1-9][0-9]*$ ]]
              sync_tree_route_concurrent_cancel_work_before="$cancel_work"

              cancel_started_ms="$(awk '{printf "%.0f\n", $1 * 1000}' \
                /proc/uptime)"
              for cancel_index in "''${cancel_indices[@]}"; do
                (iotox --runtime "$runtime" sync-cancel \
                  "''${cancel_jobs[$cancel_index]}" \
                  >"$state_dir/sync-route-concurrent-cancel-$cancel_index.out") &
                cancel_pids+=("$!")
              done
              for cancel_pid in "''${cancel_pids[@]}"; do
                wait "$cancel_pid"
              done
              for cancel_index in "''${cancel_indices[@]}"; do
                grep -q "sync-cancelled job=''${cancel_jobs[$cancel_index]}" \
                  "$state_dir/sync-route-concurrent-cancel-$cancel_index.out"
              done
              cancel_deadline_ms=$((cancel_started_ms + 5000))
              while true; do
                cancel_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                cancel_terminal=0
                for cancel_index in "''${cancel_indices[@]}"; do
                  cancel_line="$(awk \
                    -v job="''${cancel_jobs[$cancel_index]}" \
                    '$1 == "job=" job { print; exit }' \
                    <<<"$cancel_status")"
                  if grep -q ' state=cancelled ' <<<"$cancel_line"; then
                    grep -q \
                      " carrier-route=''${cancel_carriers[$cancel_index]} " \
                      <<<" $cancel_line "
                    grep -q \
                      " carrier-worker=''${cancel_workers[$cancel_index]} " \
                      <<<" $cancel_line "
                    cancel_terminal=$((cancel_terminal + 1))
                  else
                    ! grep -Eq ' state=(failed|complete) ' <<<"$cancel_line"
                  fi
                done
                (( cancel_terminal == 4 )) && break
                cancel_finished_ms="$(awk '{printf "%.0f\n", $1 * 1000}' \
                  /proc/uptime)"
                (( cancel_finished_ms < cancel_deadline_ms ))
                agent_is_running "$agent_pid"
                sleep 0.01
              done
              cancel_finished_ms="$(awk '{printf "%.0f\n", $1 * 1000}' \
                /proc/uptime)"
              sync_tree_route_concurrent_cancel_tail_ms=$((
                cancel_finished_ms - cancel_started_ms
              ))
              (( sync_tree_route_concurrent_cancel_tail_ms >= 0 && \
                 sync_tree_route_concurrent_cancel_tail_ms <= 5000 ))

              while (( SECONDS < deadline )); do
                cancel_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                survivor_complete=0
                for cancel_index in "''${survivor_indices[@]}"; do
                  cancel_line="$(awk \
                    -v job="''${cancel_jobs[$cancel_index]}" \
                    '$1 == "job=" job { print; exit }' \
                    <<<"$cancel_status")"
                  ! grep -Eq ' state=(failed|cancelled) ' <<<"$cancel_line"
                  if grep -q ' state=complete ' <<<"$cancel_line"; then
                    grep -q ' requested=2 ' <<<"$cancel_line"
                    grep -q ' admitted=2 ' <<<"$cancel_line"
                    grep -q ' committed=2 ' <<<"$cancel_line"
                    survivor_complete=$((survivor_complete + 1))
                  fi
                done
                (( survivor_complete == 4 )) && break
                agent_is_running "$agent_pid"
                sleep 0.05
              done
              (( survivor_complete == 4 ))

              for cancel_index in "''${cancel_indices[@]}"; do
                cancel_root="$state_dir/sync-route-population-cancel-$cancel_index"
                [[ ! -e \
                  "$cancel_root/accepted-heads/sandwurm-population-cancel-$cancel_index.accepted-head" ]]
                [[ ! -e \
                  "$cancel_root/activated-revisions/sandwurm-population-cancel-$cancel_index.activated-revision" ]]
                [[ -z "$(find "$cancel_root/staging" -type f -print -quit)" ]]
              done
              for cancel_index in "''${survivor_indices[@]}"; do
                cancel_expected_head="$(awk -F= \
                  -v name="cancel-$cancel_index-head-record" \
                  '$1 == name { print $2 }' <<<"$population_ready")"
                cancel_expected_payload="$(awk -F= \
                  -v name="cancel-$cancel_index-payload-sha256" \
                  '$1 == name { print $2 }' <<<"$population_ready")"
                cancel_activation="$(iotox --runtime "$runtime" \
                  sync-activate "sandwurm-population-cancel-$cancel_index" \
                  "$cancel_expected_head")"
                grep -q ' decision=activated ' <<<" $cancel_activation "
                grep -q ' kind=treepack ' <<<" $cancel_activation "
                cancel_root="$state_dir/sync-route-population-cancel-$cancel_index"
                [[ "$(sha256sum \
                  "$cancel_root/materialized-trees/current/payload.bin" | \
                  cut -d' ' -f1)" == "$cancel_expected_payload" ]]
                [[ -z "$(find "$cancel_root/staging" -type f -print -quit)" ]]
                sync_tree_route_concurrent_cancel_survivor_activations=$((
                  sync_tree_route_concurrent_cancel_survivor_activations + 1
                ))
              done
              while (( SECONDS < deadline )); do
                cancel_routes="$(iotox --runtime "$runtime" routes \
                  2>/dev/null || true)"
                cancel_work="$(awk '
                  /route-index=/ {
                    for (i=1;i<=NF;i++) if ($i ~ /^admitted-work=/) {
                      sub(/^admitted-work=/,"",$i); total += $i
                    }
                  }
                  END { print total + 0 }
                ' <<<"$cancel_routes")"
                cancel_ready_bulk="$(awk '
                  / role=bulk / && / lifecycle=ready / { count++ }
                  END { print count + 0 }
                ' <<<"$cancel_routes")"
                (( cancel_work == 0 && cancel_ready_bulk == 2 )) && break
                agent_is_running "$agent_pid"
                sleep 0.05
              done
              (( cancel_work == 0 && cancel_ready_bulk == 2 ))
              sync_tree_route_concurrent_cancel_work_after="$cancel_work"
              iotox --runtime "$runtime" status >"$resource_status"
              python3 ${../tools/capture-process-resources.py} finish \
                --pid "$agent_pid" --runtime-status "$resource_status" \
                --state "$resource_state" --output "$resource_output"
              cancel_resource_digest="$(sha256sum "$resource_output" | \
                cut -d' ' -f1)"
              [[ "$cancel_resource_digest" =~ ^[0-9a-f]{64}$ ]]
              after_status="$(iotox --runtime "$runtime" sync-status)"
              after_count="$(population_status_value \
                auxiliary-adaptive-selections <<<"$after_status")"
              after_reassignments="$(population_status_value \
                auxiliary-reassignments <<<"$after_status")"
              [[ "$after_count" =~ ^[0-9]+$ ]]
              [[ "$after_reassignments" =~ ^[0-9]+$ ]]
              cancel_selection_delta=$((after_count - before_count))
              cancel_reassignment_delta=$((
                after_reassignments - before_reassignments
              ))
              (( cancel_selection_delta == 8 ))
              (( cancel_reassignment_delta == 0 ))
              sync_tree_route_concurrent_cancel_jobs=8
              sync_tree_route_concurrent_cancel_requested=4
              sync_tree_route_concurrent_cancel_completed=4
              sync_tree_route_concurrent_cancel_survivors=4
              sync_tree_route_concurrent_cancel_pattern="$cancel_pattern"
              sync_tree_route_concurrent_cancel_route_zero="$cancel_zero_count"
              sync_tree_route_concurrent_cancel_route_one="$cancel_one_count"
              sync_tree_route_concurrent_cancel_reassignments_delta="$cancel_reassignment_delta"
              sync_tree_route_concurrent_cancel_adaptive_selections="$cancel_selection_delta"
              sync_tree_route_concurrent_cancel_resource_sha256="$cancel_resource_digest"
              (( sync_tree_route_concurrent_cancel_survivor_activations == 4 ))
              sync_tree_route_concurrent_cancel_observed=true
              {
                printf 'phase=concurrent-cancel-complete\n'
                printf 'pattern=%s\n' "$cancel_pattern"
                printf 'cancelled=4\n'
                printf 'survivors=4\n'
                printf 'tail-ms=%s\n' \
                  "$sync_tree_route_concurrent_cancel_tail_ms"
              } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                "$rendezvous_dir/client.sync-route-population-phase"
            }

            population_run_throughput_phase() {
              local throughput_label=$1 throughput_policy=$2
              local before_status before_count before_reassignments
              local after_status after_count after_reassignments
              local throughput_pull throughput_job throughput_status
              local throughput_line throughput_carrier throughput_pattern=
              local throughput_assigned=0 throughput_complete=0
              local throughput_routes throughput_work=0 throughput_peak_work=0
              local throughput_activation throughput_expected_head
              local throughput_expected_payload throughput_root
              local throughput_start_ms throughput_now_ms throughput_duration_ms
              local throughput_skew_ms throughput_selection_delta
              local throughput_reassignment_delta throughput_resource_digest
              local resource_state resource_status resource_output
              local -a throughput_jobs=() throughput_carriers=()
              local -a throughput_completed_ms=(-1 -1)
              local -a throughput_route_keys=()

              before_status="$(iotox --runtime "$runtime" sync-status)"
              grep -q \
                "^enabled=1 .*auxiliary-route-policy=$throughput_policy " \
                <<<"$before_status"
              before_count="$(population_status_value \
                "auxiliary-$throughput_policy-selections" \
                <<<"$before_status")"
              before_reassignments="$(population_status_value \
                auxiliary-reassignments <<<"$before_status")"
              [[ "$before_count" =~ ^[0-9]+$ ]]
              [[ "$before_reassignments" =~ ^[0-9]+$ ]]
              mapfile -t throughput_route_keys < <(iotox --runtime "$runtime" \
                routes | awk '/ role=bulk / && / lifecycle=ready / {
                  for (i=1;i<=NF;i++) if ($i ~ /^public-key=/) {
                    sub(/^public-key=/,"",$i); print $i
                  }
                }' | sort)
              (( ''${#throughput_route_keys[@]} == 2 ))

              resource_state="$state_dir/sync-route-throughput-$throughput_label-resource.json"
              resource_status="$state_dir/sync-route-throughput-$throughput_label-status.txt"
              resource_output="$receipt_dir/sync-route-throughput-$throughput_label-resource.tsv"
              iotox --runtime "$runtime" status >"$resource_status"
              python3 ${../tools/capture-process-resources.py} begin \
                --pid "$agent_pid" --runtime-status "$resource_status" \
                --state "$resource_state" --role client
              throughput_start_ms="$(awk '{printf "%.0f\n", $1 * 1000}' \
                /proc/uptime)"

              for throughput_index in 0 1; do
                throughput_pull="$(iotox --runtime "$runtime" sync-pull \
                  "$remote_key" \
                  "sandwurm-population-$throughput_label-$throughput_index")"
                throughput_job="$(population_job_value job \
                  <<<"$throughput_pull")"
                [[ "$throughput_job" =~ ^[1-9][0-9]*$ ]]
                throughput_jobs[$throughput_index]="$throughput_job"
                throughput_carriers[$throughput_index]=
              done

              while (( SECONDS < deadline )); do
                throughput_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                throughput_assigned=0
                for throughput_index in 0 1; do
                  throughput_line="$(awk \
                    -v job="''${throughput_jobs[$throughput_index]}" \
                    '$1 == "job=" job { print; exit }' \
                    <<<"$throughput_status")"
                  [[ -n "$throughput_line" ]]
                  ! grep -Eq ' state=(failed|cancelled|complete) ' \
                    <<<"$throughput_line"
                  throughput_carrier="$(population_job_value carrier-route \
                    <<<"$throughput_line")"
                  if [[ "$throughput_carrier" == \
                          "''${throughput_route_keys[0]}" || \
                        "$throughput_carrier" == \
                          "''${throughput_route_keys[1]}" ]]; then
                    throughput_carriers[$throughput_index]="$throughput_carrier"
                    throughput_assigned=$((throughput_assigned + 1))
                  fi
                done
                (( throughput_assigned == 2 )) && break
                agent_is_running "$agent_pid"
                sleep 0.01
              done
              (( throughput_assigned == 2 ))
              for throughput_index in 0 1; do
                if [[ "''${throughput_carriers[$throughput_index]}" == \
                      "''${throughput_route_keys[0]}" ]]; then
                  throughput_pattern+=0
                elif [[ "''${throughput_carriers[$throughput_index]}" == \
                        "''${throughput_route_keys[1]}" ]]; then
                  throughput_pattern+=1
                else
                  throughput_pattern+=x
                fi
              done
              if [[ "$throughput_policy" == fixed ]]; then
                [[ "$throughput_pattern" == 00 ]]
              else
                [[ "$throughput_policy" == adaptive ]]
                [[ "$throughput_pattern" == 01 ]]
              fi
              throughput_routes="$(iotox --runtime "$runtime" routes)"
              throughput_work="$(awk '
                /route-index=/ {
                  for (i=1;i<=NF;i++) if ($i ~ /^admitted-work=/) {
                    sub(/^admitted-work=/,"",$i); total += $i
                  }
                }
                END { print total + 0 }
              ' <<<"$throughput_routes")"
              (( throughput_work == 4 ))
              throughput_peak_work="$throughput_work"
              (( throughput_peak_work > sync_tree_route_throughput_peak_work )) && \
                sync_tree_route_throughput_peak_work="$throughput_peak_work"
              {
                printf 'phase=%s-assigned\n' "$throughput_label"
                printf 'policy=%s\npattern=%s\nwork=%s\n' \
                  "$throughput_policy" "$throughput_pattern" "$throughput_work"
              } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                "$rendezvous_dir/client.sync-route-population-phase"

              while (( SECONDS < deadline )); do
                throughput_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                throughput_now_ms="$(awk '{printf "%.0f\n", $1 * 1000}' \
                  /proc/uptime)"
                throughput_complete=0
                for throughput_index in 0 1; do
                  throughput_line="$(awk \
                    -v job="''${throughput_jobs[$throughput_index]}" \
                    '$1 == "job=" job { print; exit }' \
                    <<<"$throughput_status")"
                  [[ -n "$throughput_line" ]]
                  ! grep -Eq ' state=(failed|cancelled) ' \
                    <<<"$throughput_line"
                  [[ "$(population_job_value carrier-route \
                    <<<"$throughput_line")" == \
                    "''${throughput_carriers[$throughput_index]}" ]]
                  if grep -q ' state=complete ' <<<"$throughput_line"; then
                    grep -q ' requested=2 ' <<<"$throughput_line"
                    grep -q ' admitted=2 ' <<<"$throughput_line"
                    grep -q ' committed=2 ' <<<"$throughput_line"
                    if (( throughput_completed_ms[$throughput_index] < 0 )); then
                      throughput_completed_ms[$throughput_index]=$(($throughput_now_ms - throughput_start_ms))
                    fi
                    throughput_complete=$((throughput_complete + 1))
                  fi
                done
                (( throughput_complete == 2 )) && break
                agent_is_running "$agent_pid"
                sleep 0.02
              done
              (( throughput_complete == 2 ))
              throughput_duration_ms="''${throughput_completed_ms[0]}"
              (( throughput_completed_ms[1] > throughput_duration_ms )) && \
                throughput_duration_ms="''${throughput_completed_ms[1]}"
              throughput_skew_ms=$((
                throughput_completed_ms[0] - throughput_completed_ms[1]
              ))
              (( throughput_skew_ms < 0 )) && \
                throughput_skew_ms=$((-throughput_skew_ms))
              (( throughput_duration_ms > 0 ))

              for throughput_index in 0 1; do
                throughput_expected_head="$(awk -F= \
                  -v name="$throughput_label-$throughput_index-head-record" \
                  '$1 == name { print $2 }' <<<"$population_ready")"
                throughput_expected_payload="$(awk -F= \
                  -v name="$throughput_label-$throughput_index-payload-sha256" \
                  '$1 == name { print $2 }' <<<"$population_ready")"
                throughput_activation="$(iotox --runtime "$runtime" \
                  sync-activate \
                  "sandwurm-population-$throughput_label-$throughput_index" \
                  "$throughput_expected_head")"
                grep -q ' decision=activated ' <<<" $throughput_activation "
                grep -q ' kind=treepack ' <<<" $throughput_activation "
                throughput_root="$state_dir/sync-route-population-$throughput_label-$throughput_index"
                [[ "$(sha256sum \
                  "$throughput_root/materialized-trees/current/payload.bin" | \
                  cut -d' ' -f1)" == "$throughput_expected_payload" ]]
                [[ -z "$(find "$throughput_root/staging" -type f \
                  -print -quit)" ]]
                sync_tree_route_throughput_activations=$(($sync_tree_route_throughput_activations + 1))
              done
              while (( SECONDS < deadline )); do
                throughput_routes="$(iotox --runtime "$runtime" routes \
                  2>/dev/null || true)"
                throughput_work="$(awk '
                  /route-index=/ {
                    for (i=1;i<=NF;i++) if ($i ~ /^admitted-work=/) {
                      sub(/^admitted-work=/,"",$i); total += $i
                    }
                  }
                  END { print total + 0 }
                ' <<<"$throughput_routes")"
                (( throughput_work == 0 )) && break
                agent_is_running "$agent_pid"
                sleep 0.02
              done
              (( throughput_work == 0 ))
              sync_tree_route_throughput_work_after="$throughput_work"

              iotox --runtime "$runtime" status >"$resource_status"
              python3 ${../tools/capture-process-resources.py} finish \
                --pid "$agent_pid" --runtime-status "$resource_status" \
                --state "$resource_state" --output "$resource_output"
              throughput_resource_digest="$(sha256sum "$resource_output" | \
                cut -d' ' -f1)"
              [[ "$throughput_resource_digest" =~ ^[0-9a-f]{64}$ ]]
              after_status="$(iotox --runtime "$runtime" sync-status)"
              after_count="$(population_status_value \
                "auxiliary-$throughput_policy-selections" \
                <<<"$after_status")"
              after_reassignments="$(population_status_value \
                auxiliary-reassignments <<<"$after_status")"
              [[ "$after_count" =~ ^[0-9]+$ ]]
              [[ "$after_reassignments" =~ ^[0-9]+$ ]]
              throughput_selection_delta=$((after_count - before_count))
              throughput_reassignment_delta=$(($after_reassignments - $before_reassignments))
              (( throughput_selection_delta == 2 ))
              (( throughput_reassignment_delta == 0 ))
              sync_tree_route_throughput_reassignments=$(($sync_tree_route_throughput_reassignments + throughput_reassignment_delta))
              if [[ "$throughput_policy" == fixed ]]; then
                sync_tree_route_throughput_fixed_selections=$(($sync_tree_route_throughput_fixed_selections + throughput_selection_delta))
              else
                sync_tree_route_throughput_adaptive_selections=$(($sync_tree_route_throughput_adaptive_selections + throughput_selection_delta))
              fi
              case "$throughput_label" in
                fixed-a)
                  sync_tree_route_throughput_fixed_a_duration_ms="$throughput_duration_ms"
                  sync_tree_route_throughput_fixed_a_completion_skew_ms="$throughput_skew_ms"
                  sync_tree_route_throughput_fixed_a_resource_sha256="$throughput_resource_digest"
                  ;;
                adaptive-a)
                  sync_tree_route_throughput_adaptive_a_duration_ms="$throughput_duration_ms"
                  sync_tree_route_throughput_adaptive_a_completion_skew_ms="$throughput_skew_ms"
                  sync_tree_route_throughput_adaptive_a_resource_sha256="$throughput_resource_digest"
                  ;;
                adaptive-b)
                  sync_tree_route_throughput_adaptive_b_duration_ms="$throughput_duration_ms"
                  sync_tree_route_throughput_adaptive_b_completion_skew_ms="$throughput_skew_ms"
                  sync_tree_route_throughput_adaptive_b_resource_sha256="$throughput_resource_digest"
                  ;;
                fixed-b)
                  sync_tree_route_throughput_fixed_b_duration_ms="$throughput_duration_ms"
                  sync_tree_route_throughput_fixed_b_completion_skew_ms="$throughput_skew_ms"
                  sync_tree_route_throughput_fixed_b_resource_sha256="$throughput_resource_digest"
                  ;;
                *) false ;;
              esac
              {
                printf 'phase=%s-complete\n' "$throughput_label"
                printf 'policy=%s\npattern=%s\nduration-ms=%s\n' \
                  "$throughput_policy" "$throughput_pattern" \
                  "$throughput_duration_ms"
                printf 'completion-skew-ms=%s\n' "$throughput_skew_ms"
              } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                "$rendezvous_dir/client.sync-route-population-phase"
              sync_tree_route_throughput_last_pattern="$throughput_pattern"
            }

            population_run_startup_admission() {
              local before_status before_count before_reassignments
              local startup_session startup_authority startup_routes
              local startup_ready_bulk=0 startup_ready_key= startup_stable=0
              local startup_status startup_line startup_pull startup_job
              local startup_carrier startup_work startup_complete=0
              local startup_live=0 startup_preserved=0 startup_activation
              local startup_expected_head startup_expected_payload startup_root
              local startup_started_ms startup_finished_ms startup_digest
              local after_status after_count after_reassignments
              local resource_state resource_status resource_output
              local -a startup_jobs=()

              startup_started_ms="$(date +%s%3N)"
              while (( SECONDS < deadline )); do
                startup_session="$(iotox --runtime "$runtime" session \
                  "$remote_key" 2>/dev/null || true)"
                startup_authority="$(iotox --runtime "$runtime" \
                  authority-session "$remote_key" 2>/dev/null || true)"
                startup_routes="$(iotox --runtime "$runtime" routes \
                  2>/dev/null || true)"
                startup_ready_bulk="$(awk '
                  / role=bulk / && / lifecycle=ready / { count++ }
                  END { print count + 0 }
                ' <<<"$startup_routes")"
                startup_ready_key="$(awk '
                  / role=bulk / && / lifecycle=ready / {
                    for (i=1;i<=NF;i++) if ($i ~ /^public-key=/) {
                      sub(/^public-key=/,"",$i); print $i; exit
                    }
                  }
                ' <<<"$startup_routes")"
                if grep -q '^state=confirmed$' <<<"$startup_session" && \
                   grep -q '^remote-authorized=1$' \
                     <<<"$startup_authority" && \
                   (( startup_ready_bulk == 1 )) && \
                   [[ "$startup_ready_key" == \
                     "$sync_tree_route_startup_admission_carrier" ]]; then
                  startup_stable=$((startup_stable + 1))
                  (( startup_stable >= 10 )) && break
                else
                  startup_stable=0
                fi
                agent_is_running "$agent_pid"
                sleep 0.1
              done
              (( startup_stable >= 10 && startup_ready_bulk == 1 ))
              [[ "$startup_ready_key" == \
                "$sync_tree_route_startup_admission_carrier" ]]
              sync_tree_route_startup_admission_ready_bulk_before="$startup_ready_bulk"
              sync_tree_route_startup_admission_stable_samples="$startup_stable"

              before_status="$(iotox --runtime "$runtime" sync-status)"
              grep -q '^enabled=1 .*auxiliary-route-policy=adaptive ' \
                <<<"$before_status"
              before_count="$(population_status_value \
                auxiliary-adaptive-selections <<<"$before_status")"
              before_reassignments="$(population_status_value \
                auxiliary-reassignments <<<"$before_status")"
              [[ "$before_count" =~ ^[0-9]+$ ]]
              [[ "$before_reassignments" =~ ^[0-9]+$ ]]
              resource_state="$state_dir/sync-route-startup-admission-resource.json"
              resource_status="$state_dir/sync-route-startup-admission-status.txt"
              resource_output="$receipt_dir/sync-route-startup-admission-resource.tsv"
              iotox --runtime "$runtime" status >"$resource_status"
              python3 ${../tools/capture-process-resources.py} begin \
                --pid "$agent_pid" --runtime-status "$resource_status" \
                --state "$resource_state" --role client

              for startup_index in 0 1; do
                startup_pull="$(iotox --runtime "$runtime" sync-pull \
                  "$remote_key" \
                  "sandwurm-population-startup-$startup_index")"
                startup_job="$(population_job_value job <<<"$startup_pull")"
                [[ "$startup_job" =~ ^[1-9][0-9]*$ ]]
                startup_jobs[$startup_index]="$startup_job"
              done

              while (( SECONDS < deadline )); do
                startup_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                startup_preserved=0
                for startup_index in 0 1; do
                  startup_line="$(awk \
                    -v job="''${startup_jobs[$startup_index]}" \
                    '$1 == "job=" job { print; exit }' \
                    <<<"$startup_status")"
                  [[ -n "$startup_line" ]]
                  ! grep -Eq ' state=(failed|cancelled|complete) ' \
                    <<<"$startup_line"
                  startup_carrier="$(population_job_value carrier-route \
                    <<<"$startup_line")"
                  if [[ "$startup_carrier" == \
                        "$sync_tree_route_startup_admission_carrier" ]]; then
                    startup_preserved=$((startup_preserved + 1))
                  fi
                done
                startup_routes="$(iotox --runtime "$runtime" routes \
                  2>/dev/null || true)"
                startup_ready_bulk="$(awk '
                  / role=bulk / && / lifecycle=ready / { count++ }
                  END { print count + 0 }
                ' <<<"$startup_routes")"
                startup_work="$(awk '
                  /route-index=/ {
                    for (i=1;i<=NF;i++) if ($i ~ /^admitted-work=/) {
                      sub(/^admitted-work=/,"",$i); total += $i
                    }
                  }
                  END { print total + 0 }
                ' <<<"$startup_routes")"
                if (( startup_preserved == 2 && startup_ready_bulk == 1 && \
                      startup_work == 4 )); then
                  break
                fi
                agent_is_running "$agent_pid"
                sleep 0.01
              done
              (( startup_preserved == 2 && startup_ready_bulk == 1 && \
                 startup_work == 4 ))
              sync_tree_route_startup_admission_work_before="$startup_work"
              {
                printf 'phase=startup-admission-assigned\n'
                printf 'jobs=2\nready-bulk=1\nwork=4\n'
                printf 'carrier=%s\n' \
                  "$sync_tree_route_startup_admission_carrier"
              } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                "$rendezvous_dir/client.sync-route-population-phase"

              while (( SECONDS < deadline )); do
                startup_routes="$(iotox --runtime "$runtime" routes \
                  2>/dev/null || true)"
                startup_ready_bulk="$(awk '
                  / role=bulk / && / lifecycle=ready / { count++ }
                  END { print count + 0 }
                ' <<<"$startup_routes")"
                startup_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                startup_live=0
                startup_preserved=0
                for startup_index in 0 1; do
                  startup_line="$(awk \
                    -v job="''${startup_jobs[$startup_index]}" \
                    '$1 == "job=" job { print; exit }' \
                    <<<"$startup_status")"
                  [[ -n "$startup_line" ]]
                  ! grep -Eq ' state=(failed|cancelled) ' <<<"$startup_line"
                  if ! grep -q ' state=complete ' <<<"$startup_line"; then
                    startup_live=$((startup_live + 1))
                  fi
                  startup_carrier="$(population_job_value carrier-route \
                    <<<"$startup_line")"
                  if [[ "$startup_carrier" == \
                        "$sync_tree_route_startup_admission_carrier" ]]; then
                    startup_preserved=$((startup_preserved + 1))
                  fi
                done
                if (( startup_ready_bulk == 2 )); then
                  break
                fi
                agent_is_running "$agent_pid"
                sleep 0.01
              done
              (( startup_ready_bulk == 2 && startup_live == 2 && \
                 startup_preserved == 2 ))
              sync_tree_route_startup_admission_ready_bulk_after="$startup_ready_bulk"
              sync_tree_route_startup_admission_live_jobs_after_join="$startup_live"
              sync_tree_route_startup_admission_preserved_carriers="$startup_preserved"
              {
                printf 'phase=startup-admission-route-joined\n'
                printf 'live-jobs=%s\npreserved-carriers=%s\n' \
                  "$startup_live" "$startup_preserved"
              } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                "$rendezvous_dir/client.sync-route-population-phase"

              while (( SECONDS < deadline )); do
                startup_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                startup_complete=0
                for startup_index in 0 1; do
                  startup_line="$(awk \
                    -v job="''${startup_jobs[$startup_index]}" \
                    '$1 == "job=" job { print; exit }' \
                    <<<"$startup_status")"
                  ! grep -Eq ' state=(failed|cancelled) ' <<<"$startup_line"
                  if grep -q ' state=complete ' <<<"$startup_line"; then
                    grep -q ' requested=2 ' <<<"$startup_line"
                    grep -q ' committed=2 ' <<<"$startup_line"
                    [[ "$(population_job_value carrier-route \
                      <<<"$startup_line")" == \
                      "$sync_tree_route_startup_admission_carrier" ]]
                    startup_complete=$((startup_complete + 1))
                  fi
                done
                (( startup_complete == 2 )) && break
                agent_is_running "$agent_pid"
                sleep 0.05
              done
              (( startup_complete == 2 ))

              for startup_index in 0 1; do
                startup_expected_head="$(awk -F= \
                  -v name="startup-$startup_index-head-record" \
                  '$1 == name { print $2 }' <<<"$population_ready")"
                startup_expected_payload="$(awk -F= \
                  -v name="startup-$startup_index-payload-sha256" \
                  '$1 == name { print $2 }' <<<"$population_ready")"
                startup_activation="$(iotox --runtime "$runtime" \
                  sync-activate \
                  "sandwurm-population-startup-$startup_index" \
                  "$startup_expected_head")"
                grep -q ' decision=activated ' <<<" $startup_activation "
                startup_root="$state_dir/sync-route-population-startup-$startup_index"
                [[ "$(sha256sum \
                  "$startup_root/materialized-trees/current/payload.bin" | \
                  cut -d' ' -f1)" == "$startup_expected_payload" ]]
                [[ -z "$(find "$startup_root/staging" -type f -print -quit)" ]]
                sync_tree_route_startup_admission_activations=$((
                  sync_tree_route_startup_admission_activations + 1
                ))
              done

              while (( SECONDS < deadline )); do
                startup_routes="$(iotox --runtime "$runtime" routes \
                  2>/dev/null || true)"
                startup_work="$(awk '
                  /route-index=/ {
                    for (i=1;i<=NF;i++) if ($i ~ /^admitted-work=/) {
                      sub(/^admitted-work=/,"",$i); total += $i
                    }
                  }
                  END { print total + 0 }
                ' <<<"$startup_routes")"
                (( startup_work == 0 )) && break
                agent_is_running "$agent_pid"
                sleep 0.05
              done
              (( startup_work == 0 ))
              sync_tree_route_startup_admission_work_after="$startup_work"
              after_status="$(iotox --runtime "$runtime" sync-status)"
              after_count="$(population_status_value \
                auxiliary-adaptive-selections <<<"$after_status")"
              after_reassignments="$(population_status_value \
                auxiliary-reassignments <<<"$after_status")"
              [[ "$after_count" =~ ^[0-9]+$ ]]
              [[ "$after_reassignments" =~ ^[0-9]+$ ]]
              sync_tree_route_startup_admission_adaptive_selections=$((
                after_count - before_count
              ))
              (( sync_tree_route_startup_admission_adaptive_selections == 2 ))
              (( after_reassignments - before_reassignments == 0 ))
              (( sync_tree_route_startup_admission_activations == 2 ))
              iotox --runtime "$runtime" status >"$resource_status"
              python3 ${../tools/capture-process-resources.py} finish \
                --pid "$agent_pid" --runtime-status "$resource_status" \
                --state "$resource_state" --output "$resource_output"
              startup_digest="$(sha256sum "$resource_output" | cut -d' ' -f1)"
              [[ "$startup_digest" =~ ^[0-9a-f]{64}$ ]]
              sync_tree_route_startup_admission_resource_sha256="$startup_digest"
              startup_finished_ms="$(date +%s%3N)"
              sync_tree_route_startup_admission_duration_ms=$((
                startup_finished_ms - startup_started_ms
              ))
              (( sync_tree_route_startup_admission_duration_ms > 0 ))
              sync_tree_route_startup_admission_observed=true
              {
                printf 'phase=startup-admission-complete\n'
                printf 'jobs=2\nactivations=2\nwork=0\n'
                printf 'duration-ms=%s\n' \
                  "$sync_tree_route_startup_admission_duration_ms"
              } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                "$rendezvous_dir/client.sync-route-population-phase"
            }

            population_run_loss() {
              local before_status before_count before_reassignments
              local loss_pull loss_job loss_status loss_line loss_header
              local loss_carrier loss_final_carrier loss_pattern=
              local loss_assigned=0 loss_complete=0 loss_migrated=0
              local loss_last_header= loss_fault_deadline=0
              local loss_last_complete=-1 loss_completion_deadline=0
              local loss_routes loss_work loss_ready_bulk loss_member
              local loss_initial_jobs=8 loss_late_jobs=0 loss_total_jobs=8
              local loss_expected_affected=4 loss_expected_selections=12
              local loss_expected_reassignments=4
              local loss_expected_head loss_expected_payload loss_activation
              local loss_root loss_resource_digest loss_started_ms loss_finished_ms
              local after_status after_count after_reassignments
              local resource_state resource_status resource_output
              local -a loss_jobs=() loss_initial_carriers=()
              local -a loss_final_carriers=() loss_route_keys=()

              if $sync_tree_route_loss_admission_scenario; then
                loss_initial_jobs=2
                loss_late_jobs=2
                loss_total_jobs=4
                loss_expected_affected=2
                loss_expected_reassignments=2
                loss_expected_selections=6
              fi

              before_status="$(iotox --runtime "$runtime" sync-status)"
              grep -q '^enabled=1 .*auxiliary-route-policy=fixed ' \
                <<<"$before_status"
              before_count="$(population_status_value \
                auxiliary-fixed-selections <<<"$before_status")"
              before_reassignments="$(population_status_value \
                auxiliary-reassignments <<<"$before_status")"
              [[ "$before_count" =~ ^[0-9]+$ ]]
              [[ "$before_reassignments" =~ ^[0-9]+$ ]]
              resource_state="$state_dir/sync-route-population-loss-resource.json"
              resource_status="$state_dir/sync-route-population-loss-status.txt"
              resource_output="$receipt_dir/sync-route-population-loss-resource.tsv"
              iotox --runtime "$runtime" status >"$resource_status"
              python3 ${../tools/capture-process-resources.py} begin \
                --pid "$agent_pid" --runtime-status "$resource_status" \
                --state "$resource_state" --role client
              mapfile -t loss_route_keys < <(iotox --runtime "$runtime" \
                routes | awk '/ role=bulk / {
                  for (i=1;i<=NF;i++) if ($i ~ /^public-key=/) {
                    sub(/^public-key=/,"",$i); print $i
                  }
                }' | sort)
              (( ''${#loss_route_keys[@]} == 2 ))
              loss_started_ms="$(date +%s%3N)"

              for ((loss_index=0; loss_index < loss_initial_jobs; ++loss_index)); do
                loss_pull="$(iotox --runtime "$runtime" sync-pull \
                  "$remote_key" "sandwurm-population-loss-$loss_index")"
                loss_job="$(population_job_value job <<<"$loss_pull")"
                [[ "$loss_job" =~ ^[1-9][0-9]*$ ]]
                loss_jobs[$loss_index]="$loss_job"
                loss_initial_carriers[$loss_index]=
                loss_final_carriers[$loss_index]=
              done
              while (( SECONDS < deadline )); do
                loss_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                loss_assigned=0
                for ((loss_index=0; loss_index < loss_initial_jobs; ++loss_index)); do
                  loss_line="$(awk -v job="''${loss_jobs[$loss_index]}" \
                    '$1 == "job=" job { print; exit }' <<<"$loss_status")"
                  [[ -n "$loss_line" ]]
                  ! grep -q ' state=failed ' <<<"$loss_line"
                  if [[ -z "''${loss_initial_carriers[$loss_index]}" ]]; then
                    loss_carrier="$(population_job_value carrier-route \
                      <<<"$loss_line")"
                    if [[ "$loss_carrier" == "''${loss_route_keys[0]}" || \
                          "$loss_carrier" == "''${loss_route_keys[1]}" ]]; then
                      loss_initial_carriers[$loss_index]="$loss_carrier"
                    fi
                  fi
                  [[ -n "''${loss_initial_carriers[$loss_index]}" ]] && \
                    loss_assigned=$((loss_assigned + 1))
                done
                (( loss_assigned == loss_initial_jobs )) && break
                agent_is_running "$agent_pid"
                sleep 0.01
              done
              (( loss_assigned == loss_initial_jobs ))
              for ((loss_index=0; loss_index < loss_initial_jobs; ++loss_index)); do
                if [[ "''${loss_initial_carriers[$loss_index]}" == \
                      "''${loss_route_keys[0]}" ]]; then
                  loss_pattern+=0
                elif [[ "''${loss_initial_carriers[$loss_index]}" == \
                        "''${loss_route_keys[1]}" ]]; then
                  loss_pattern+=1
                else
                  loss_pattern+=x
                fi
              done
              if $sync_tree_route_loss_admission_scenario; then
                [[ "$loss_pattern" == 00 ]]
              else
                [[ "$loss_pattern" == 00001111 ]]
              fi
              loss_routes="$(iotox --runtime "$runtime" routes)"
              loss_work="$(awk '
                /route-index=/ {
                  for (i=1;i<=NF;i++) if ($i ~ /^admitted-work=/) {
                    sub(/^admitted-work=/,"",$i); total += $i
                  }
                }
                END { print total + 0 }
              ' <<<"$loss_routes")"
              (( loss_work == loss_initial_jobs * 2 ))
              sync_tree_route_population_loss_work_before="$loss_work"
              {
                printf 'phase=population-loss-assigned\n'
                printf 'pattern=%s\n' "$loss_pattern"
                printf 'work=%s\n' "$loss_work"
              } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                "$rendezvous_dir/client.sync-route-population-phase"

              loss_fault_deadline=$((SECONDS + 120))
              while (( SECONDS < deadline && \
                        SECONDS < loss_fault_deadline )); do
                loss_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                loss_header="$(head -n 1 <<<"$loss_status")"
                if [[ "$loss_header" != "$loss_last_header" ]]; then
                  printf '%s\n' "$loss_status" \
                    >"$rendezvous_dir/client.sync-route-population-status.tmp"
                  mv "$rendezvous_dir/client.sync-route-population-status.tmp" \
                    "$rendezvous_dir/client.sync-route-population-status"
                  loss_last_header="$loss_header"
                fi
                if grep -q ' qualification-fault=1 ' \
                     <<<" $loss_header " && \
                   grep -q " qualification-fault-affected-jobs=$loss_expected_affected " \
                     <<<" $loss_header " && \
                   grep -q ' auxiliary-carrier-losses=1 ' \
                     <<<" $loss_header "; then
                  break
                fi
                agent_is_running "$agent_pid"
                sleep 0.01
              done
              grep -q ' qualification-fault=1 ' <<<" $loss_header "
              grep -q " qualification-fault-affected-jobs=$loss_expected_affected " \
                <<<" $loss_header "
              grep -q ' auxiliary-carrier-losses=1 ' <<<" $loss_header "

              if $sync_tree_route_loss_admission_scenario; then
                sync_tree_route_population_loss_stopped_carrier="''${loss_initial_carriers[0]}"
                [[ "''${loss_initial_carriers[1]}" == \
                  "$sync_tree_route_population_loss_stopped_carrier" ]]
                if [[ "$sync_tree_route_population_loss_stopped_carrier" == \
                      "''${loss_route_keys[0]}" ]]; then
                  sync_tree_route_loss_admission_surviving_carrier="''${loss_route_keys[1]}"
                else
                  sync_tree_route_loss_admission_surviving_carrier="''${loss_route_keys[0]}"
                fi

                # Admit genuinely new jobs only after both affected jobs have
                # received fresh assignments and while the stopped route is
                # still absent from the ready candidate set.
                while (( SECONDS < deadline )); do
                  loss_status="$(iotox --runtime "$runtime" sync-status \
                    2>/dev/null || true)"
                  loss_header="$(head -n 1 <<<"$loss_status")"
                  after_reassignments="$(population_status_value \
                    auxiliary-reassignments <<<"$loss_status")"
                  [[ "$after_reassignments" =~ ^[0-9]+$ ]]
                  if (( after_reassignments - before_reassignments == \
                        loss_expected_reassignments )); then
                    break
                  fi
                  agent_is_running "$agent_pid"
                  sleep 0.01
                done
                (( after_reassignments - before_reassignments == \
                  loss_expected_reassignments ))

                for ((loss_index=loss_initial_jobs; \
                      loss_index < loss_total_jobs; ++loss_index)); do
                  loss_pull="$(iotox --runtime "$runtime" sync-pull \
                    "$remote_key" "sandwurm-population-loss-$loss_index")"
                  loss_job="$(population_job_value job <<<"$loss_pull")"
                  [[ "$loss_job" =~ ^[1-9][0-9]*$ ]]
                  loss_jobs[$loss_index]="$loss_job"
                  loss_initial_carriers[$loss_index]=
                  loss_final_carriers[$loss_index]=
                done
                while (( SECONDS < deadline )); do
                  loss_status="$(iotox --runtime "$runtime" sync-status \
                    2>/dev/null || true)"
                  loss_routes="$(iotox --runtime "$runtime" routes \
                    2>/dev/null || true)"
                  loss_ready_bulk="$(awk '
                    / role=bulk / && / lifecycle=ready / { count++ }
                    END { print count + 0 }
                  ' <<<"$loss_routes")"
                  loss_assigned=0
                  for ((loss_index=loss_initial_jobs; \
                        loss_index < loss_total_jobs; ++loss_index)); do
                    loss_line="$(awk -v job="''${loss_jobs[$loss_index]}" \
                      '$1 == "job=" job { print; exit }' <<<"$loss_status")"
                    [[ -n "$loss_line" ]]
                    ! grep -Eq ' state=(failed|cancelled) ' <<<"$loss_line"
                    loss_carrier="$(population_job_value carrier-route \
                      <<<"$loss_line")"
                    if [[ "$loss_carrier" == \
                          "$sync_tree_route_loss_admission_surviving_carrier" ]]; then
                      loss_initial_carriers[$loss_index]="$loss_carrier"
                      loss_assigned=$((loss_assigned + 1))
                    fi
                  done
                  if (( loss_assigned == loss_late_jobs && \
                        loss_ready_bulk == 1 )); then
                    break
                  fi
                  agent_is_running "$agent_pid"
                  sleep 0.01
                done
                (( loss_assigned == loss_late_jobs && loss_ready_bulk == 1 ))
                sync_tree_route_loss_admission_started_jobs="$loss_late_jobs"
                sync_tree_route_loss_admission_ready_bulk="$loss_ready_bulk"
                {
                  printf 'phase=population-loss-admission\n'
                  printf 'started-jobs=%s\n' "$loss_late_jobs"
                  printf 'ready-bulk=%s\n' "$loss_ready_bulk"
                  printf 'surviving-carrier=%s\n' \
                    "$sync_tree_route_loss_admission_surviving_carrier"
                } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
                mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                  "$rendezvous_dir/client.sync-route-population-phase"
              fi

              # Independent signed two-object pulls can serialize behind one
              # surviving native-TCP carrier after the fault. Keep this
              # bounded without turning relay throughput into scheduler truth.
              loss_completion_deadline=$((SECONDS + 300))
              while (( SECONDS < deadline && \
                        SECONDS < loss_completion_deadline )); do
                loss_status="$(iotox --runtime "$runtime" sync-status \
                  2>/dev/null || true)"
                loss_complete=0
                for ((loss_index=0; loss_index < loss_total_jobs; ++loss_index)); do
                  loss_line="$(awk -v job="''${loss_jobs[$loss_index]}" \
                    '$1 == "job=" job { print; exit }' <<<"$loss_status")"
                  ! grep -Eq ' state=(failed|cancelled) ' <<<"$loss_line"
                  if grep -q ' state=complete ' <<<"$loss_line"; then
                    grep -q ' requested=2 ' <<<"$loss_line"
                    grep -q ' committed=2 ' <<<"$loss_line"
                    loss_final_carrier="$(population_job_value carrier-route \
                      <<<"$loss_line")"
                    [[ "$loss_final_carrier" == "''${loss_route_keys[0]}" || \
                          "$loss_final_carrier" == "''${loss_route_keys[1]}" ]]
                    loss_final_carriers[$loss_index]="$loss_final_carrier"
                    loss_complete=$((loss_complete + 1))
                  fi
                done
                if (( loss_complete != loss_last_complete )); then
                  {
                    printf '%s\n' "$loss_status"
                    printf '%s\n' "$(iotox --runtime "$runtime" routes \
                      2>/dev/null || true)"
                  } >"$rendezvous_dir/client.sync-route-population-status.tmp"
                  mv "$rendezvous_dir/client.sync-route-population-status.tmp" \
                    "$rendezvous_dir/client.sync-route-population-status"
                  loss_last_complete=$loss_complete
                fi
                (( loss_complete == loss_total_jobs )) && break
                agent_is_running "$agent_pid"
                sleep 0.05
              done
              (( loss_complete == loss_total_jobs ))
              if ! $sync_tree_route_loss_admission_scenario; then
                sync_tree_route_population_loss_stopped_carrier=
              fi
              for ((loss_index=0; loss_index < loss_total_jobs; ++loss_index)); do
                if [[ "''${loss_initial_carriers[$loss_index]}" != \
                      "''${loss_final_carriers[$loss_index]}" ]]; then
                  loss_migrated=$((loss_migrated + 1))
                  if [[ -z "$sync_tree_route_population_loss_stopped_carrier" ]]; then
                    sync_tree_route_population_loss_stopped_carrier="''${loss_initial_carriers[$loss_index]}"
                  else
                    [[ "$sync_tree_route_population_loss_stopped_carrier" == \
                      "''${loss_initial_carriers[$loss_index]}" ]]
                  fi
                fi
              done
              (( loss_migrated == loss_expected_reassignments ))
              [[ "$sync_tree_route_population_loss_stopped_carrier" =~ \
                ^[0-9A-F]{64}$ ]]
              for ((loss_index=0; loss_index < loss_total_jobs; ++loss_index)); do
                if [[ "''${loss_initial_carriers[$loss_index]}" == \
                      "$sync_tree_route_population_loss_stopped_carrier" ]]; then
                  [[ "''${loss_final_carriers[$loss_index]}" != \
                    "''${loss_initial_carriers[$loss_index]}" ]]
                else
                  [[ "''${loss_final_carriers[$loss_index]}" == \
                    "''${loss_initial_carriers[$loss_index]}" ]]
                fi
              done

              for ((loss_index=0; loss_index < loss_total_jobs; ++loss_index)); do
                loss_expected_head="$(awk -F= \
                  -v name="loss-$loss_index-head-record" \
                  '$1 == name { print $2 }' <<<"$population_ready")"
                loss_expected_payload="$(awk -F= \
                  -v name="loss-$loss_index-payload-sha256" \
                  '$1 == name { print $2 }' <<<"$population_ready")"
                loss_activation="$(iotox --runtime "$runtime" sync-activate \
                  "sandwurm-population-loss-$loss_index" \
                  "$loss_expected_head")"
                grep -q ' decision=activated ' <<<" $loss_activation "
                loss_root="$state_dir/sync-route-population-loss-$loss_index"
                [[ "$(sha256sum \
                  "$loss_root/materialized-trees/current/payload.bin" | \
                  cut -d' ' -f1)" == "$loss_expected_payload" ]]
                [[ -z "$(find "$loss_root/staging" -type f -print -quit)" ]]
                sync_tree_route_population_loss_activations=$((
                  sync_tree_route_population_loss_activations + 1
                ))
              done

              while (( SECONDS < deadline )); do
                loss_routes="$(iotox --runtime "$runtime" routes \
                  2>/dev/null || true)"
                loss_work="$(awk '
                  /route-index=/ {
                    for (i=1;i<=NF;i++) if ($i ~ /^admitted-work=/) {
                      sub(/^admitted-work=/,"",$i); total += $i
                    }
                  }
                  END { print total + 0 }
                ' <<<"$loss_routes")"
                loss_ready_bulk="$(awk '
                  / role=bulk / && / lifecycle=ready / { count++ }
                  END { print count + 0 }
                ' <<<"$loss_routes")"
                loss_member="$(awk \
                  -v key="$sync_tree_route_population_loss_stopped_carrier" \
                  '$0 ~ ("public-key=" key) { print; exit }' \
                  <<<"$loss_routes")"
                if (( loss_work == 0 && loss_ready_bulk == 2 )) && \
                   grep -q ' lifecycle=ready ' <<<" $loss_member " && \
                   grep -q ' restarts=1 ' <<<" $loss_member "; then
                  break
                fi
                agent_is_running "$agent_pid"
                sleep 0.05
              done
              (( loss_work == 0 && loss_ready_bulk == 2 ))
              grep -q ' restart-budget=1 ' <<<" $loss_member "
              grep -q ' last-failure=none$' <<<"$loss_member"
              sync_tree_route_population_loss_work_after="$loss_work"
              after_status="$(iotox --runtime "$runtime" sync-status)"
              loss_header="$(head -n 1 <<<"$after_status")"
              after_count="$(population_status_value \
                auxiliary-fixed-selections <<<"$after_status")"
              after_reassignments="$(population_status_value \
                auxiliary-reassignments <<<"$after_status")"
              sync_tree_route_population_loss_affected_jobs="$(
                population_status_value qualification-fault-affected-jobs \
                  <<<"$after_status"
              )"
              sync_tree_route_population_loss_carrier_losses="$(
                population_status_value auxiliary-carrier-losses \
                  <<<"$after_status"
              )"
              sync_tree_route_population_loss_stale_terminals="$(
                population_status_value auxiliary-stale-terminals \
                  <<<"$after_status"
              )"
              sync_tree_route_population_loss_recoveries="$(
                population_status_value auxiliary-recoveries <<<"$after_status"
              )"
              sync_tree_route_population_loss_fault_position_bytes="$(
                population_status_value qualification-fault-position \
                  <<<"$after_status"
              )"
              sync_tree_route_population_loss_fixed_selections=$((
                after_count - before_count
              ))
              sync_tree_route_population_loss_reassignments=$((
                after_reassignments - before_reassignments
              ))
              (( sync_tree_route_population_loss_affected_jobs == \
                loss_expected_affected ))
              (( sync_tree_route_population_loss_carrier_losses == 1 ))
              (( sync_tree_route_population_loss_reassignments == \
                loss_expected_reassignments ))
              (( sync_tree_route_population_loss_stale_terminals >= 1 ))
              (( sync_tree_route_population_loss_recoveries == 1 ))
              (( sync_tree_route_population_loss_fixed_selections == \
                loss_expected_selections ))
              (( sync_tree_route_population_loss_activations == \
                loss_total_jobs ))
              (( sync_tree_route_population_loss_fault_position_bytes >= 65536 && \
                 sync_tree_route_population_loss_fault_position_bytes < \
                   population_artifact_bytes ))
              grep -q ' qualification-fault-armed=0 ' <<<" $loss_header "
              grep -q ' qualification-fault-after-cancel=0$' <<<"$loss_header"
              iotox --runtime "$runtime" status >"$resource_status"
              python3 ${../tools/capture-process-resources.py} finish \
                --pid "$agent_pid" --runtime-status "$resource_status" \
                --state "$resource_state" --output "$resource_output"
              loss_resource_digest="$(sha256sum "$resource_output" | \
                cut -d' ' -f1)"
              [[ "$loss_resource_digest" =~ ^[0-9a-f]{64}$ ]]
              sync_tree_route_population_loss_resource_sha256="$loss_resource_digest"
              sync_tree_route_population_loss_pattern="$loss_pattern"
              sync_tree_route_population_loss_jobs="$loss_total_jobs"
              loss_finished_ms="$(date +%s%3N)"
              sync_tree_route_population_loss_duration_ms=$((
                loss_finished_ms - loss_started_ms
              ))
              (( sync_tree_route_population_loss_duration_ms > 0 ))
              sync_tree_route_population_loss_observed=true
              {
                printf 'phase=population-loss-complete\n'
                printf 'pattern=%s\n' "$loss_pattern"
                printf 'affected-jobs=%s\n' \
                  "$sync_tree_route_population_loss_affected_jobs"
                printf 'reassignments=%s\n' \
                  "$sync_tree_route_population_loss_reassignments"
                printf 'duration-ms=%s\n' \
                  "$sync_tree_route_population_loss_duration_ms"
              } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                "$rendezvous_dir/client.sync-route-population-phase"
