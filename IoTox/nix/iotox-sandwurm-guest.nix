            grep -q ' state=complete ' <<<"$source_corrupt_retry_line"
            grep -q ' requested=2 ' <<<"$source_corrupt_retry_line"
            grep -q ' admitted=2 ' <<<"$source_corrupt_retry_line"
            grep -q ' committed=2 ' <<<"$source_corrupt_retry_line"
            source_corrupt_retry_head="$(awk '{
              for (i=1;i<=NF;i++) if ($i ~ /^head-record=/) {
