          cat >"$sync_policy_store/namespaces/sandwurm-file.namespace" <<POLICY
iotox-sync-namespace-v1
id=sandwurm-file
root-hex=$sync_root_hex
engine=$sync_engine
activation=manual
maximum-artifact-bytes=$sync_maximum_artifact_bytes
maximum-manifest-bytes=1048576
