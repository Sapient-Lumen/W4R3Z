              actual_i2p_fail_closed_loss_replacement_job_id="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^job=/) {
                  sub(/^job=/,"",$i); print $i; exit
                }
              }' <<<"$actual_i2p_repull_output")"
              [[ "$actual_i2p_fail_closed_loss_replacement_job_id" =~ \
                ^[1-9][0-9]*$ ]]
              [[ "$actual_i2p_fail_closed_loss_replacement_job_id" != \
                "$actual_i2p_fail_closed_loss_original_job_id" ]]
              sync_pull_job_id="$actual_i2p_fail_closed_loss_replacement_job_id"
              actual_i2p_repull_samples=0
            fi
            if $sync_range_retry_scenario; then
              sync_range_fault_line=
              while (( SECONDS < deadline )); do
                sync_status="$(iotox --runtime "$runtime" sync-status 2>/dev/null || true)"
                sync_range_status_line="$(awk -v job="$sync_pull_job_id" \
                  '$1 == "job=" job { print; exit }' <<<"$sync_status")"
                sync_files="$(iotox --runtime "$runtime" files 2>/dev/null || true)"
                if grep -Eq ' range-count=[1-9][0-9]* ' \
                   <<<"$sync_range_status_line"; then
                  sync_range_fault_line="$(awk '
                    /direction=incoming/ && /state=active/ {
                      position = 0; size = 0
                      for (i = 1; i <= NF; i++) {
                        if ($i ~ /^position=/) {
                          sub(/^position=/, "", $i); position = $i + 0
                        } else if ($i ~ /^size=/) {
                          sub(/^size=/, "", $i); size = $i + 0
                        }
                      }
                      if (position > 0 && position < size) { print; exit }
                    }
                  ' <<<"$sync_files")"
                fi
                [[ -n "$sync_range_fault_line" ]] && break
                if grep -Eq ' state=(complete|failed) ' \
                   <<<"$sync_range_status_line"; then
                  printf '%s\n' "$sync_range_status_line" >&2
                  exit 1
                fi
                kill -0 "$agent_pid"
                sleep 0.05
              done
              [[ -n "$sync_range_fault_line" ]]
              sync_range_fault_file_number="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^file-number=/) {
                  sub(/^file-number=/,"",$i); print $i; exit
