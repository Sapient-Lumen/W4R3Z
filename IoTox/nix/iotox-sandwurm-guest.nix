            else
              sync_stop_status=$?
            fi
            [[ "$sync_stop_status" == 137 ]]
            agent_pid=
            (( sync_interrupted_staging_bytes > 0 ))
            (( sync_interrupted_staging_bytes < sync_artifact_bytes + sync_manifest_bytes ))
            sync_transport_temporary_count="$(find "$sync_root/staging" \
