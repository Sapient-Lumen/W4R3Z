            sync_canonical_partial_count="$(find "$sync_root/staging" \
              -maxdepth 1 -type f \
              -name 'attempt-????????????????.part' -printf '.\n' |
              wc -l)"
            if $sync_content_restart_scenario; then
              content_restart_capture_inventory() {
                local destination=$1
                local relative bytes expected actual
                : >"$destination"
                if [[ -d "$sync_root/content-v2/sha256" ]]; then
                  while IFS=$'\t' read -r relative bytes; do
                    [[ "$relative" =~ ^[0-9a-f]{2}/[0-9a-f]{62}$ ]]
                    expected="''${relative/\//}"
                    actual="$(sha256sum \
                      "$sync_root/content-v2/sha256/$relative" | \
                      cut -d' ' -f1)"
                    [[ "$actual" == "$expected" ]]
                    [[ "$bytes" =~ ^[1-9][0-9]*$ ]]
                    printf '%s\t%s\n' "$expected" "$bytes" \
                      >>"$destination"
                  done < <(find "$sync_root/content-v2/sha256" \
                    -mindepth 2 -maxdepth 2 -type f -printf '%P\t%s\n' | \
                    sort)
                fi
              }
              sync_transport_temporary_count="$(find \
                "$sync_root/staging/content-v2" -type f \
                -name '.iotox-*.part.part-??????' -printf '.\n' \
                2>/dev/null | wc -l)"
              sync_canonical_partial_count="$(find \
                "$sync_root/staging/content-v2" -type f \
                -name '*.part' -printf '.\n' 2>/dev/null | wc -l)"
              sync_interrupted_staging_bytes="$(find \
                "$sync_root/staging/content-v2" -type f \
                -name '.iotox-*.part.part-??????' -printf '%s\n' \
