                printf 'content-live-lanes=%s\n' \
                  "$content_restart_live_lanes"
                printf 'content-transport-bytes=%s\n' \
                  "$content_restart_crash_transport_bytes"
                printf 'content-canonical-partials=%s\n' \
                  "$content_restart_crash_canonical_partials"
                printf 'content-committed-objects=%s\n' \
                  "$content_restart_crash_committed_objects"
                printf 'content-committed-bytes=%s\n' \
                  "$content_restart_crash_committed_bytes"
                printf 'content-inventory-sha256=%s\n' \
                  "$content_restart_crash_inventory_sha256"
              elif $sync_restart_resume_scenario; then
                printf 'canonical-partials=%s\n' \
                  "$sync_canonical_partial_count"
                printf 'canonical-bytes=%s\n' \
                  "$sync_interrupted_staging_bytes"
              fi
              printf 'attempt-journal-present=%s\n' "$sync_attempt_journal_present"
              printf 'accepted-head-present=%s\n' "$sync_accepted_head_present"
              printf 'activation-present=%s\n' "$sync_activation_present"
            } >"$rendezvous_dir/client.sync-crash-state.tmp"
            mv "$rendezvous_dir/client.sync-crash-state.tmp" \
              "$rendezvous_dir/client.sync-crash-state"
            if $sync_content_restart_scenario; then
              (( sync_transport_temporary_count == \
                 content_restart_crash_transport_files ))
              (( sync_canonical_partial_count == 0 ))
            elif $sync_restart_resume_scenario; then
              (( sync_transport_temporary_count == 0 ))
              (( sync_canonical_partial_count >= 1 && \
                 sync_canonical_partial_count <= 2 ))
            else
              (( sync_transport_temporary_count >= 1 && \
                 sync_transport_temporary_count <= 2 ))
            fi
            (( sync_attempt_journal_present == 1 ))
            (( sync_accepted_head_present == 0 ))
            (( sync_activation_present == 0 ))
            sync_unclean_stop_observed=true
            printf 'sync-daemon-stopped=1\n' \
              >"$rendezvous_dir/client.sync-daemon-stopped.tmp"
            mv "$rendezvous_dir/client.sync-daemon-stopped.tmp" \
