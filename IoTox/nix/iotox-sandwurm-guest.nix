            [[ ! -e "$sync_root/accepted-heads/sandwurm-file.accepted-head" ]]
            [[ ! -e "$sync_root/activated-revisions/sandwurm-file.activated-revision" ]]
            if $sync_content_restart_scenario; then
              content_restart_recovered_inventory="$state_dir/content-restart-recovered-inventory.tsv"
              content_restart_capture_inventory \
                "$content_restart_recovered_inventory"
              content_restart_recovered_committed_objects="$(wc -l \
                <"$content_restart_recovered_inventory")"
              content_restart_recovered_committed_bytes="$(awk \
                '{ total += $2 } END { print total + 0 }' \
                "$content_restart_recovered_inventory")"
              content_restart_recovered_inventory_sha256="$(sha256sum \
                "$content_restart_recovered_inventory" | cut -d' ' -f1)"
              content_restart_recovery_committed_delta=$((
                content_restart_recovered_committed_objects -
                  content_restart_crash_committed_objects
              ))
              content_restart_post_start_transport_files="$(find \
                "$sync_root/staging/content-v2" -type f \
                -name '.iotox-*.part.part-??????' -printf '.\n' \
                2>/dev/null | wc -l)"
              content_restart_post_start_canonical_partials="$(find \
                "$sync_root/staging/content-v2" -type f \
                -name '*.part' -printf '.\n' 2>/dev/null | wc -l)"
              cmp "$content_restart_crash_inventory" \
                "$content_restart_recovered_inventory"
              (( content_restart_recovered_committed_objects == \
                   content_restart_crash_committed_objects && \
                 content_restart_recovered_committed_objects < \
                   sync_content_objects ))
              (( content_restart_recovered_committed_bytes == \
                   content_restart_crash_committed_bytes && \
                 content_restart_recovered_committed_bytes < \
                   sync_artifact_bytes ))
              (( content_restart_recovery_committed_delta == 0 ))
              (( content_restart_post_start_transport_files == 0 ))
              (( content_restart_post_start_canonical_partials == 0 ))
              [[ "$content_restart_recovered_inventory_sha256" == \
                "$content_restart_crash_inventory_sha256" ]]
              [[ "$content_restart_recovered_inventory_sha256" =~ \
                ^[0-9a-f]{64}$ ]]
            elif $sync_restart_resume_scenario; then
              recovered_partial_count="$(find "$sync_root/staging" \
                -maxdepth 1 -type f \
                -name 'attempt-????????????????.part' -printf '.\n' |
                wc -l)"
              recovered_partial_bytes="$(find "$sync_root/staging" \
                -maxdepth 1 -type f \
                -name 'attempt-????????????????.part' -printf '%s\n' |
                awk '{ total += $1 } END { print total + 0 }')"
              (( recovered_partial_count == sync_canonical_partial_count ))
              (( recovered_partial_bytes == sync_interrupted_staging_bytes ))
            else
              [[ -z "$(find "$sync_root/staging" -mindepth 1 -maxdepth 1 \
                -print -quit)" ]]
            fi
            sync_attempt_recovery_observed=true

            while (( SECONDS < deadline )); do
              session="$(iotox --runtime "$runtime" session "$remote_key" 2>/dev/null || true)"
              authority="$(iotox --runtime "$runtime" authority-session "$remote_key" 2>/dev/null || true)"
              connection="$(iotox --runtime "$runtime" peers 2>/dev/null |
                awk -v key="$remote_key" '$0 ~ "public-key=" key {
                  for (i = 1; i <= NF; i++) if ($i ~ /^connection=/) {
                    sub(/^connection=/, "", $i); print $i; exit
                  }
                }')"
              if grep -q '^state=confirmed$' <<<"$session" && \
                 [[ "$connection" == ${lib.escapeShellArg expectedConnection} ]] && \
                 grep -q '^remote-authorized=1$' <<<"$authority"; then
                break
              fi
              kill -0 "$agent_pid"
              sleep 0.1
            done
            grep -q '^state=confirmed$' <<<"$session"
            [[ "$connection" == ${lib.escapeShellArg expectedConnection} ]]
            grep -q '^remote-authorized=1$' <<<"$authority"
            sync_restart_observed=true
            sync_restart_recovery_observed=true
            printf 'sync-daemon-restarted=1\n' \
              >"$rendezvous_dir/client.sync-daemon-restarted.tmp"
            mv "$rendezvous_dir/client.sync-daemon-restarted.tmp" \
              "$rendezvous_dir/client.sync-daemon-restarted"
            # Local verification of the publisher can complete before the
            # publisher has consumed this restarted claimant's proof.  The
            # host releases the pull only after both guests independently
            # report the recovered, authorized session.
            wait_for_file "$input_dir/sync-restart-authority-ready"
            rm -f "$input_dir/sync-restart-authority-ready"
            if $sync_content_restart_scenario; then
              content_restart_pull="$(iotox --runtime "$runtime" \
                sync-pull "$remote_key" sandwurm-file)"
              content_restart_second_job_id="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^job=/) {
                  sub(/^job=/,"",$i); print $i; exit
                }
              }' <<<"$content_restart_pull")"
              [[ "$content_restart_second_job_id" =~ ^[1-9][0-9]*$ ]]
              [[ "$content_restart_second_job_id" != \
                "$content_restart_first_job_id" ]]
              sync_pull_job_id=$content_restart_second_job_id
              content_restart_observed=true
            else
              iotox --runtime "$runtime" sync-pull \
                "$remote_key" sandwurm-file >/dev/null
            fi
            fi
          fi
          if $sync_cancel_scenario; then
            {
              printf 'cancellation=1\n'
              printf 'convergence=0\n'
              printf 'activation=0\n'
              printf 'job-id=%s\n' "$sync_cancelled_job_id"
              printf 'cancelled-staging-bytes=%s\n' "$sync_cancelled_staging_bytes"
              printf 'cancelled-receives=%s\n' "$sync_cancelled_receive_count"
              if $sync_tree_route_cancel_scenario; then
                printf 'route-cancel=1\n'
                printf 'route-cancel-carrier=%s\n' \
                  "$sync_tree_route_cancel_carrier"
                printf 'route-cancel-worker-id=%s\n' \
                  "$sync_tree_route_cancel_worker_id"
                printf 'route-cancel-tail-ms=%s\n' \
                  "$sync_tree_route_cancel_tail_ms"
                printf 'route-cancel-work-before=%s\n' \
                  "$sync_tree_route_cancel_work_before"
                printf 'route-cancel-work-after=%s\n' \
                  "$sync_tree_route_cancel_work_after"
                printf 'route-cancel-reassignments-delta=%s\n' \
                  "$sync_tree_route_cancel_reassignments_delta"
                printf 'route-cancel-adaptive-selections=%s\n' \
                  "$sync_tree_route_cancel_adaptive_selections"
                if $sync_tree_route_loss_cancel_scenario; then
                  printf 'route-loss-before-cancel=1\n'
                  printf 'route-loss-position-bytes=%s\n' \
                    "$sync_tree_route_loss_position_bytes"
                  printf 'route-carrier-losses=%s\n' \
                    "$sync_tree_route_loss_carrier_losses"
                  printf 'route-reassignments=%s\n' \
                    "$sync_tree_route_loss_reassignments"
                  printf 'route-stale-terminals=%s\n' \
                    "$sync_tree_route_loss_stale_terminals"
                  printf 'route-recoveries=%s\n' \
                    "$sync_tree_route_loss_recoveries"
                  printf 'route-final-carrier=%s\n' \
                    "$sync_tree_route_loss_final_carrier"
                  printf 'route-stopped-carrier=%s\n' \
                    "$sync_tree_route_loss_stopped_carrier"
                elif $sync_tree_route_cancel_race_scenario; then
                  printf 'route-cancel-loss-race=1\n'
                  printf 'route-cancel-loss-race-outcome=%s\n' \
                    "$sync_tree_route_cancel_race_outcome"
                  printf 'route-cancel-loss-race-fault-delay-ms=%s\n' \
                    "$sync_tree_route_cancel_race_fault_delay_ms"
                  printf 'route-cancel-loss-race-cancel-delay-ms=%s\n' \
                    "$sync_tree_route_cancel_race_cancel_delay_ms"
                  printf 'route-cancel-loss-race-cleanup-retries=%s\n' \
                    "$sync_tree_route_cancel_race_cleanup_retries"
                  printf 'route-loss-position-bytes=%s\n' \
                    "$sync_tree_route_loss_position_bytes"
                  printf 'route-carrier-losses=%s\n' \
                    "$sync_tree_route_loss_carrier_losses"
                  printf 'route-reassignments=%s\n' \
                    "$sync_tree_route_loss_reassignments"
                  printf 'route-stale-terminals=%s\n' \
                    "$sync_tree_route_loss_stale_terminals"
                  printf 'route-recoveries=%s\n' \
                    "$sync_tree_route_loss_recoveries"
                  printf 'route-final-carrier=%s\n' \
                    "$sync_tree_route_loss_final_carrier"
                  printf 'route-stopped-carrier=%s\n' \
                    "$sync_tree_route_loss_stopped_carrier"
                elif $sync_tree_route_cancel_loss_scenario; then
                  printf 'route-cancel-before-loss=1\n'
                  printf 'route-loss-position-bytes=%s\n' \
                    "$sync_tree_route_loss_position_bytes"
                  printf 'route-carrier-losses=%s\n' \
                    "$sync_tree_route_loss_carrier_losses"
                  printf 'route-reassignments=%s\n' \
                    "$sync_tree_route_loss_reassignments"
                  printf 'route-stale-terminals=%s\n' \
                    "$sync_tree_route_loss_stale_terminals"
                  printf 'route-recoveries=%s\n' \
                    "$sync_tree_route_loss_recoveries"
                  printf 'route-final-carrier=%s\n' \
                    "$sync_tree_route_loss_final_carrier"
                  printf 'route-stopped-carrier=%s\n' \
                    "$sync_tree_route_loss_stopped_carrier"
                fi
              fi
              printf 'generation=%s\n' "$sync_generation"
              printf 'head-record=%s\n' "$sync_head_record"
              printf 'artifact-sha256=%s\n' "$sync_artifact_sha256"
              printf 'manifest-sha256=%s\n' "$sync_manifest_sha256"
              printf 'artifact-bytes=%s\n' "$sync_artifact_bytes"
              printf 'manifest-bytes=%s\n' "$sync_manifest_bytes"
              if $sync_tree_scenario; then
                printf 'tree-directories=%s\n' "$sync_tree_directories"
                printf 'tree-files=%s\n' "$sync_tree_files"
                printf 'tree-content-bytes=%s\n' "$sync_tree_content_bytes"
                printf 'tree-payload-sha256=%s\n' \
                  "$sync_tree_payload_sha256"
              fi
            } >"$rendezvous_dir/client.sync-complete.tmp"
            mv "$rendezvous_dir/client.sync-complete.tmp" \
              "$rendezvous_dir/client.sync-complete"
          else
          sync_status=
          sync_initial_status_samples=0
          while (( SECONDS < deadline )); do
            sync_status="$(iotox --runtime "$runtime" sync-status 2>/dev/null || true)"
            lane_observation_expected=0
            lane_observation_process_cap=0
            if $sync_content_same_source_lanes_scenario && \
               ! $same_source_lanes_observed; then
              lane_observation_expected=2
              lane_observation_process_cap=2
            elif $sync_content_lane_science_scenario && \
                 ! $content_lane_science_initial_observed; then
              lane_observation_expected=$content_lane_science_initial_cap
              lane_observation_process_cap=8
            fi
            if (( lane_observation_expected != 0 )); then
              same_source_job_line="$(awk -v job="$sync_pull_job_id" \
                '$1 == "content-job=" job { print; exit }' \
                <<<"$sync_status")"
              same_source_lane_lines="$(awk -v job="$sync_pull_job_id" \
                '$1 == "content-lane-job=" job { print }' \
                <<<"$sync_status")"
              observed_active_lanes="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^active-lanes=/) {
                  sub(/^active-lanes=/,"",$i); print $i; exit
                }
              }' <<<"$same_source_job_line")"
              observed_lane_cap="$(awk 'NR == 1 {
                for (i=1;i<=NF;i++) if ($i ~ /^content-lane-cap=/) {
                  sub(/^content-lane-cap=/,"",$i); print $i; exit
                }
              }' <<<"$sync_status")"
              observed_lane_rows="$(awk 'NF { ++count }
                END { print count + 0 }' <<<"$same_source_lane_lines")"
              observed_admitted_lanes="$(awk '{
                for (i=1;i<=NF;i++) if ($i == "admitted=1") ++count
                }
                END { print count + 0 }' <<<"$same_source_lane_lines")"
              observed_root_lanes="$(awk '{
                for (i=1;i<=NF;i++) if ($i == "root=1") ++count
                }
                END { print count + 0 }' <<<"$same_source_lane_lines")"
              observed_distinct_requests="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^request=/) {
                  sub(/^request=/,"",$i); seen[$i]=1
                }
                }
                END { for (value in seen) ++count; print count + 0 }
              ' <<<"$same_source_lane_lines")"
              observed_distinct_files="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^file=/) {
                  sub(/^file=/,"",$i); seen[$i]=1
                }
                }
                END { for (value in seen) ++count; print count + 0 }
              ' <<<"$same_source_lane_lines")"
              observed_distinct_sources="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^source-id=/) {
                  sub(/^source-id=/,"",$i); seen[$i]=1
                }
                }
                END { for (value in seen) ++count; print count + 0 }
              ' <<<"$same_source_lane_lines")"
              if [[ "$observed_lane_cap" == \
                      "$lane_observation_process_cap" && \
                    "$observed_active_lanes" == \
                      "$lane_observation_expected" && \
                    "$observed_lane_rows" == \
                      "$lane_observation_expected" && \
                    "$observed_admitted_lanes" == \
                      "$lane_observation_expected" && \
                    "$observed_root_lanes" == 0 && \
                    "$observed_distinct_requests" == \
                      "$lane_observation_expected" && \
                    "$observed_distinct_files" == \
                      "$lane_observation_expected" && \
                    "$observed_distinct_sources" == 1 ]]; then
                if $sync_content_lane_science_scenario; then
                  content_lane_science_initial_active=$lane_observation_expected
                  content_lane_science_initial_observed=true
                else
                  same_source_lane_cap=2
                  same_source_active_lanes=2
                  same_source_admitted_lanes=2
                  same_source_distinct_requests=2
                  same_source_distinct_files=2
                  same_source_source_count=1
                  same_source_root_lane_count=0
                  same_source_lane_set_sha256="$(printf '%s\n' \
                    "$same_source_lane_lines" | sort | sha256sum | \
                    cut -d' ' -f1)"
                  [[ "$same_source_lane_set_sha256" =~ ^[0-9a-f]{64}$ ]]
                  same_source_lanes_observed=true
                fi
              fi
            fi
            if $sync_range_triple_route_loss_scenario; then
              (( sync_initial_status_samples += 1 ))
              if (( sync_initial_status_samples == 1 ||
                    sync_initial_status_samples % 10 == 0 )); then
                printf '%s\n' "$sync_status" \
                  >"$rendezvous_dir/client.sync-initial-live-status.tmp"
                mv "$rendezvous_dir/client.sync-initial-live-status.tmp" \
                  "$rendezvous_dir/client.sync-initial-live-status"
                if iotox --runtime "$runtime" routes \
                    >"$rendezvous_dir/client.sync-initial-live-routes.tmp"; then
                  mv "$rendezvous_dir/client.sync-initial-live-routes.tmp" \
                    "$rendezvous_dir/client.sync-initial-live-routes"
                else
                  rm -f "$rendezvous_dir/client.sync-initial-live-routes.tmp"
                fi
              fi
            fi
            if $sync_tree_route_population_fixture; then
              {
                printf 'phase=base-convergence\n'
                printf '%s\n' "$sync_status"
              } >"$rendezvous_dir/client.sync-route-population-phase.tmp"
              mv "$rendezvous_dir/client.sync-route-population-phase.tmp" \
                "$rendezvous_dir/client.sync-route-population-phase"
            fi
            if grep -q 'namespace=sandwurm-file state=complete' <<<"$sync_status"; then
              break
            fi
            if grep -q 'namespace=sandwurm-file state=failed' <<<"$sync_status"; then
              if $sync_content_multi_source_any_loss_scenario && \
                 ! $multi_source_loss_observed; then
                multi_source_loss_job_status="$(awk -v job="$sync_pull_job_id" \
                  '$1 == "content-job=" job { print; exit }' \
                  <<<"$sync_status")"
                grep -q ' state=failed ' \
                  <<<" $multi_source_loss_job_status "
                if $sync_content_multi_route_actual_tor_loss_scenario; then
                  grep -q \
                    ' detail="exact auxiliary content carrier went offline"$' \
                    <<<"$multi_source_loss_job_status"
                else
                  grep -q \
                    ' detail="registered content source went offline"$' \
                    <<<"$multi_source_loss_job_status"
                fi
                multi_source_loss_first_job_id="$sync_pull_job_id"
                multi_source_loss_committed_objects="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^committed=/) {
                    sub(/^committed=/,"",$i); print $i
                  }
                }' <<<"$multi_source_loss_job_status")"
                multi_source_loss_fetched_bytes="$(awk '{
                  for (i=1;i<=NF;i++) if ($i ~ /^fetched-bytes=/) {
                    sub(/^fetched-bytes=/,"",$i); print $i
                  }
                }' <<<"$multi_source_loss_job_status")"
                [[ "$multi_source_loss_committed_objects" =~ ^[1-9][0-9]*$ ]]
                [[ "$multi_source_loss_fetched_bytes" =~ ^[1-9][0-9]*$ ]]
                if $sync_content_multi_route_actual_tor_loss_scenario; then
                  multi_source_loss_header="$(head -n 1 <<<"$sync_status")"
                  multi_source_route_loss_target="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ \
                        /^qualification-fault-route=/) {
                      sub(/^qualification-fault-route=/,"",$i); print $i
                    }
                  }' <<<"$multi_source_loss_header")"
                  multi_source_route_loss_fault_worker="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ \
                        /^qualification-fault-worker=/) {
                      sub(/^qualification-fault-worker=/,"",$i); print $i
                    }
                  }' <<<"$multi_source_loss_header")"
                  multi_source_route_loss_position_bytes="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ \
                        /^qualification-fault-position=/) {
                      sub(/^qualification-fault-position=/,"",$i); print $i
                    }
                  }' <<<"$multi_source_loss_header")"
                  multi_source_route_loss_carrier_losses="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ \
                        /^auxiliary-carrier-losses=/) {
                      sub(/^auxiliary-carrier-losses=/,"",$i); print $i
                    }
                  }' <<<"$multi_source_loss_header")"
                  multi_source_route_loss_reassignments="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ \
                        /^auxiliary-reassignments=/) {
                      sub(/^auxiliary-reassignments=/,"",$i); print $i
                    }
                  }' <<<"$multi_source_loss_header")"
                  route_loss_source_line="$(awk -v job="$sync_pull_job_id" \
                    -v route="''${route_worker_key[2]}" '
                    $1 == "content-source-job=" job && \
                    $0 ~ " route=" route " " { print; exit }
                  ' <<<"$sync_status")"
                  route_loss_source_worker="$(awk '{
                    for (i=1;i<=NF;i++) if ($i ~ /^worker=/) {
                      sub(/^worker=/,"",$i); print $i; exit
                    }
                  }' <<<"$route_loss_source_line")"
                  [[ "$multi_source_route_loss_target" == \
                    "''${route_worker_key[2]}" ]]
                  [[ "$multi_source_route_loss_fault_worker" == \
                    "$route_loss_source_worker" ]]
                  [[ "$multi_source_route_loss_fault_worker" =~ \
                    ^[1-9][0-9]*$ ]]
                  (( multi_source_route_loss_position_bytes >= 65536 ))
                  (( multi_source_route_loss_carrier_losses == 1 ))
                  (( multi_source_route_loss_reassignments == 0 ))
                  grep -q ' qualification-fault-affected-jobs=1 ' \
                    <<<" $multi_source_loss_header "
                  multi_source_route_loss_observed=true
                fi
                sync_files="$(iotox --runtime "$runtime" files)"
                ! grep -Eq \
                  'direction=incoming .*state=(offered|active|paused)' \
                  <<<"$sync_files"
                grep -q ' active-file=none active-file-number=none ' \
                  <<<" $multi_source_loss_job_status "
                [[ -z "$(find "$sync_root/staging" -mindepth 1 \
                  ! -type d -print -quit)" ]]
                multi_source_loss_staging_clean=true
                [[ ! -e \
                  "$sync_root/accepted-heads/sandwurm-file.accepted-head" ]]
                multi_source_loss_head_fenced=true
                [[ ! -e \
                  "$sync_root/activated-revisions/sandwurm-file.activated-revision" ]]
                multi_source_loss_activation_fenced=true
                multi_source_loss_observed=true
                {
                  printf 'schema=iotox-content-multi-source-loss-failed-v1\n'
                  printf 'job=%s\n' "$multi_source_loss_first_job_id"
                  printf 'committed-objects=%s\n' \
                    "$multi_source_loss_committed_objects"
                  printf 'fetched-bytes=%s\n' \
                    "$multi_source_loss_fetched_bytes"
                  printf 'staging-clean=1\n'
                  printf 'accepted-head=0\n'
                  printf 'activation=0\n'
                  if $sync_content_multi_route_actual_tor_loss_scenario; then
                    printf 'route-loss=1\n'
                    printf 'route=%s\n' \
                      "$multi_source_route_loss_target"
                    printf 'worker=%s\n' \
                      "$multi_source_route_loss_fault_worker"
                    printf 'position-bytes=%s\n' \
                      "$multi_source_route_loss_position_bytes"
                    printf 'carrier-losses=%s\n' \
                      "$multi_source_route_loss_carrier_losses"
                    printf 'reassignments=%s\n' \
                      "$multi_source_route_loss_reassignments"
                  fi
                } >"$rendezvous_dir/client.multi-source-loss-failed.tmp"
                mv "$rendezvous_dir/client.multi-source-loss-failed.tmp" \
                  "$rendezvous_dir/client.multi-source-loss-failed"
                multi_source_loss_recovery_deadline=$((SECONDS + 300))
                if $sync_content_multi_route_actual_tor_loss_scenario; then
                  while (( SECONDS < multi_source_loss_recovery_deadline )); do
                    route_loss_routes="$(iotox --runtime "$runtime" routes \
                      2>/dev/null || true)"
                    route_loss_recovered_record="$(awk \
                      -v key="$multi_source_route_loss_target" '
                      $0 ~ "public-key=" key { print; exit }
                    ' <<<"$route_loss_routes")"
                    multi_source_route_loss_recovered_worker="$(awk '{
                      for (i=1;i<=NF;i++) if ($i ~ /^worker-id=/) {
                        sub(/^worker-id=/,"",$i); print $i; exit
                      }
                    }' <<<"$route_loss_recovered_record")"
                    route_loss_recovery_status="$(iotox --runtime \
                      "$runtime" sync-status 2>/dev/null || true)"
                    multi_source_route_loss_recoveries="$(awk 'NR == 1 {
                      for (i=1;i<=NF;i++) if ($i ~ \
                          /^auxiliary-recoveries=/) {
                        sub(/^auxiliary-recoveries=/,"",$i); print $i
                      }
                    }' <<<"$route_loss_recovery_status")"
                    primary_recovery_session="$(iotox --runtime "$runtime" \
                      session "$remote_key" 2>/dev/null || true)"
                    secondary_recovery_session="$(iotox --runtime \
                      "$runtime" session "$secondary_remote_key" \
                      2>/dev/null || true)"
                    primary_recovery_epoch="$(awk -F= \
                      '$1 == "online-epoch" { print $2 }' \
                      <<<"$primary_recovery_session")"
                    secondary_recovery_epoch="$(awk -F= \
                      '$1 == "online-epoch" { print $2 }' \
                      <<<"$secondary_recovery_session")"
                    if grep -q ' lifecycle=ready ' \
                         <<<" $route_loss_recovered_record " && \
                       grep -q ' restarts=1 ' \
                         <<<" $route_loss_recovered_record " && \
                       [[ "$multi_source_route_loss_recovered_worker" =~ \
                         ^[1-9][0-9]*$ ]] && \
                       [[ "$multi_source_route_loss_recovered_worker" != \
                         "$multi_source_route_loss_fault_worker" ]] && \
                       [[ "$multi_source_route_loss_recoveries" == 1 ]] && \
                       grep -q "^auxiliary-route=$multi_source_route_loss_target worker=$multi_source_route_loss_recovered_worker " \
                         <<<"$route_loss_recovery_status" && \
                       grep -q '^state=confirmed$' \
                         <<<"$primary_recovery_session" && \
                       grep -q '^state=confirmed$' \
                         <<<"$secondary_recovery_session" && \
                       [[ "$primary_recovery_epoch" == \
                         "$multi_source_route_loss_primary_epoch" ]] && \
                       [[ "$secondary_recovery_epoch" == \
                         "$multi_source_route_loss_secondary_epoch" ]]; then
                      break
                    fi
                    kill -0 "$agent_pid"
                    sleep 0.1
                  done
                  [[ "$multi_source_route_loss_recovered_worker" =~ \
                    ^[1-9][0-9]*$ ]]
                  [[ "$multi_source_route_loss_recovered_worker" != \
                    "$multi_source_route_loss_fault_worker" ]]
