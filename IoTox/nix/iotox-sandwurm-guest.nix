            [[ "$destination_corrupt_retry_job" =~ ^[1-9][0-9]*$ ]]
            [[ "$destination_corrupt_retry_job" != "$destination_corrupt_job" ]]
            while (( SECONDS < deadline )); do
              destination_corrupt_retry_status="$(iotox --runtime "$runtime" \
