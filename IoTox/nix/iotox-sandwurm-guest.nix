                if grep -Eq ' state=(complete|failed) ' <<<"$status_line"; then
                  printf '%s\n' "$status_line" >&2
                  return 1
                fi
                kill -0 "$agent_pid"
                sleep 0.1
              done
              return 1
            }

            wait_for_file \
              "$input_dir/device.sync-adversity-generation-2a"
            adversity_read_record "$(<"$input_dir/device.sync-adversity-generation-2a")"
            (( sync_generation == 2 ))
            adversity_gen2a_record="$sync_head_record"
            adversity_status="$(adversity_pull complete)"
            grep -qi " head-record=$sync_head_record " \
              <<<"$adversity_status"
            trap - ERR
            set +e
            adversity_activation="$(iotox --runtime "$runtime" \
              --timeout-ms 60000 sync-activate sandwurm-file \
              "$sync_head_record" 2>&1)"
            adversity_activation_status=$?
            set -e
            trap report_failure ERR
            sync_adversity_diagnostic="$adversity_activation"
            (( adversity_activation_status == 0 ))
            sync_adversity_diagnostic=
            grep -q 'decision=activated' <<<"$adversity_activation"
            grep -q ' kind=treepack ' <<<"$adversity_activation"
            adversity_current="$sync_root/materialized-trees/current"
            [[ "$(sha256sum "$adversity_current/payload.bin" | \
              cut -d' ' -f1)" == "$sync_tree_payload_sha256" ]]
            adversity_gen2_payload="$sync_tree_payload_sha256"
            adversity_accepted="$sync_root/accepted-heads/sandwurm-file.accepted-head"
            adversity_activated="$sync_root/activated-revisions/sandwurm-file.activated-revision"
            adversity_gen2_accepted_sha="$(sha256sum "$adversity_accepted" | \
              cut -d' ' -f1)"
            adversity_gen2_activated_sha="$(sha256sum "$adversity_activated" | \
