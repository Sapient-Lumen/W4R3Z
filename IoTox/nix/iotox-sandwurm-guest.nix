              install -d -m 0700 "$lane_science_root"
              cat >"$sync_policy_store/namespaces/$lane_science_namespace.namespace" <<POLICY
iotox-sync-namespace-v1
id=$lane_science_namespace
root-hex=$lane_science_root_hex
engine=content-v2
activation=manual
maximum-artifact-bytes=$sync_maximum_artifact_bytes
maximum-manifest-bytes=1048576
maximum-store-bytes=$sync_maximum_store_bytes
maximum-staging-bytes=$sync_maximum_staging_bytes
maximum-objects=$sync_maximum_objects
maximum-retained-revisions=4
maximum-peers=2
maximum-lanes=$lane_science_cap
maximum-outstanding-requests=$lane_science_cap
writer=''${publisher_principal,,}
subscriber=''${subscriber_principal,,}
POLICY
              chmod 0600 \
                "$sync_policy_store/namespaces/$lane_science_namespace.namespace"
              ! grep -q '^$' \
