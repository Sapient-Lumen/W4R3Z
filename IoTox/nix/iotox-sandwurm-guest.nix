                  >"$rendezvous_dir/device.sync-initial-live-status.tmp"; then
                mv "$rendezvous_dir/device.sync-initial-live-status.tmp" \
                  "$rendezvous_dir/device.sync-initial-live-status"
              else
                rm -f "$rendezvous_dir/device.sync-initial-live-status.tmp"
              fi
              if iotox --runtime "$runtime" routes \
                  >"$rendezvous_dir/device.sync-initial-live-routes.tmp"; then
                mv "$rendezvous_dir/device.sync-initial-live-routes.tmp" \
                  "$rendezvous_dir/device.sync-initial-live-routes"
              else
                rm -f "$rendezvous_dir/device.sync-initial-live-routes.tmp"
              fi
              sleep 0.5
            done
          else
