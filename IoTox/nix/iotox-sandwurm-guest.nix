              if $sync_range_triple_route_loss_scenario; then
                grep -q ' restarts=2 ' <<<" $recovered_route "
                grep -q ' restart-budget=2 ' <<<" $recovered_route "
                grep -q ' restart-budget-remaining=0 ' \
                  <<<" $recovered_route "
              else
                grep -q ' restarts=1 ' <<<" $recovered_route "
                grep -q ' restart-budget=1 ' <<<" $recovered_route "
                grep -q ' restart-budget-remaining=0 ' \
                  <<<" $recovered_route "
              fi
              grep -q ' last-failure=none$' <<<"$recovered_route"
              sync_tree_route_loss_position_bytes="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ \
                    /^qualification-fault-position=/) {
                  sub(/^qualification-fault-position=/,"",$i); print $i; exit
                }
              }' <<<"$range_loss_header")"
              sync_tree_route_loss_carrier_losses="$(awk '{
                for (i=1;i<=NF;i++) if ($i ~ /^auxiliary-carrier-losses=/) {
