diff --git a/toxcore/Messenger.h b/toxcore/Messenger.h
--- a/toxcore/Messenger.h
+++ b/toxcore/Messenger.h
@@ -236,4 +236,5 @@
     Connection_Status last_connection_udp_tcp;
     struct File_Transfers file_sending[MAX_CONCURRENT_FILE_PIPES];
     uint32_t num_sending_files;
+    uint32_t file_send_cursor;
     struct File_Transfers file_receiving[MAX_CONCURRENT_FILE_PIPES];
diff --git a/toxcore/Messenger.c b/toxcore/Messenger.c
--- a/toxcore/Messenger.c
+++ b/toxcore/Messenger.c
@@ -1608,2 +1608,5 @@
-    // Iterate over file transfers as long as we're sending files
-    for (uint32_t i = 0; i < MAX_CONCURRENT_FILE_PIPES; ++i) {
+    // Resume after the last file that received a chunk request so a small
+    // crypto send window cannot starve higher-numbered transfer slots.
+    const uint32_t start = friendcon->file_send_cursor;
+    for (uint32_t offset = 0; offset < MAX_CONCURRENT_FILE_PIPES; ++offset) {
+        const uint32_t i = (start + offset) % MAX_CONCURRENT_FILE_PIPES;
@@ -1663,3 +1666,4 @@
             // The allocated slot is no longer free.
             --*free_slots;
+            friendcon->file_send_cursor = (i + 1) % MAX_CONCURRENT_FILE_PIPES;
         }
