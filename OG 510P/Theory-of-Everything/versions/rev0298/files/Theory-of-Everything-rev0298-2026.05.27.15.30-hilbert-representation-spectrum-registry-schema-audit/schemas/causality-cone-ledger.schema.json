{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "causality-cone-ledger.schema.json",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "causality_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "causality_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "causality_cone_id",
          "route_ids",
          "evidence_unit_ids",
          "unitarity_check_ids",
          "causality_cone_class",
          "causal_structure_object",
          "causality_condition",
          "superluminal_or_acausal_failure_mode",
          "causality_test",
          "forbidden_inference",
          "maximum_authority_effect",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "causality_cone_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unitarity_check_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "causality_cone_class": {
            "type": "string"
          },
          "causal_structure_object": {
            "type": "string"
          },
          "causality_condition": {
            "type": "string"
          },
          "superluminal_or_acausal_failure_mode": {
            "type": "string"
          },
          "causality_test": {
            "type": "string"
          },
          "forbidden_inference": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
