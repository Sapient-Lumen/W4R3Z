{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything rollback propagation ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "rollback_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "rollback_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rollback_id",
          "defeater_ids",
          "trigger_scope",
          "affected_route_ids",
          "affected_claim_or_oq_ids",
          "affected_carrier_ids",
          "affected_protocol_ids",
          "trigger_condition",
          "dependency_scope",
          "immediate_state_effect",
          "target_floor",
          "public_notice",
          "repair_conditions",
          "no_silent_repromotion_rule"
        ],
        "properties": {
          "rollback_id": {
            "type": "string"
          },
          "defeater_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trigger_scope": {
            "type": "string"
          },
          "affected_route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affected_claim_or_oq_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affected_carrier_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affected_protocol_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trigger_condition": {
            "type": "string"
          },
          "dependency_scope": {
            "type": "string"
          },
          "immediate_state_effect": {
            "type": "string"
          },
          "target_floor": {
            "type": "string"
          },
          "public_notice": {
            "type": "string"
          },
          "repair_conditions": {
            "type": "string"
          },
          "no_silent_repromotion_rule": {
            "type": "string"
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
