        "properties": {
          "measurement_model_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "carrier_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "protocol_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model_class": {
            "type": "string"
          },
          "measurand_or_target": {
            "type": "string"
          },
          "raw_record_inputs": {
            "type": "string"
          },
          "transformation_model": {
            "type": "string"
          },
          "correction_model": {
            "type": "string"
          },
          "uncertainty_expression": {
            "type": "string"
          },
          "candidate_native_gap": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "defeater_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
