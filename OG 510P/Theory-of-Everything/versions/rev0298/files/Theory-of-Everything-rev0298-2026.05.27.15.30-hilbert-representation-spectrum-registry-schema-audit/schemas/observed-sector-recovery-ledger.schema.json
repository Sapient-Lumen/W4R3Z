{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything observed sector recovery ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "obligations"
  ],
  "properties": {
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "obligation_id",
          "target_sector",
          "minimum_for_S4",
          "minimum_for_S5",
          "current_archive_state",
          "route_ids_touching",
          "decisive_missing_piece",
          "negative_controls",
          "residual_cap"
        ]
      }
    }
  },
  "additionalProperties": true
}
