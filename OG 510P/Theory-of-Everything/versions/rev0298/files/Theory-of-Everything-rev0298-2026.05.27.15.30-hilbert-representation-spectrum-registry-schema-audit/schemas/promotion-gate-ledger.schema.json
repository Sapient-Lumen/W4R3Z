{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything promotion gate ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "gate_rows"
  ],
  "properties": {
    "gate_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate_id",
          "from_state",
          "to_state",
          "minimum_condition",
          "required_route_fields",
          "required_external_ledgers",
          "blocking_if_missing",
          "no_compensation_clause",
          "observed_sector_condition",
          "allowed_result",
          "forbidden_result"
        ]
      }
    }
  },
  "additionalProperties": true
}
