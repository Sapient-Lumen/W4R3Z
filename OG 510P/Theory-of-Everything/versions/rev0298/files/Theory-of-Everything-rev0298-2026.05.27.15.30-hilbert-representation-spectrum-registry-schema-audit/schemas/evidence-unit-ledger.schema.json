{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything evidence unit ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "evidence_units"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "evidence_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_unit_id",
          "route_ids",
          "support_kind",
          "record_status",
          "record_description",
          "carrier_ids",
          "protocol_ids",
          "empirical_delta_ids",
          "severity_test_ids",
          "negative_control_ids",
          "independence_assumption_ids",
          "shared_support_cluster",
          "credit_role",
          "maximum_credit",
          "double_counting_risk",
          "credit_spend_rule",
          "rollback_if_compromised",
          "source_refs"
        ],
        "properties": {
          "evidence_unit_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "support_kind": {
            "type": "string"
          },
          "record_status": {
            "type": "string"
          },
          "record_description": {
            "type": "string"
          },
          "carrier_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "protocol_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "empirical_delta_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity_test_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "negative_control_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "independence_assumption_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shared_support_cluster": {
            "type": "string"
          },
          "credit_role": {
            "type": "string"
          },
          "maximum_credit": {
            "type": "string"
          },
          "double_counting_risk": {
            "type": "string"
          },
          "credit_spend_rule": {
            "type": "string"
          },
          "rollback_if_compromised": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
