{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything systematic uncertainty ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "systematic_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "systematic_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "systematic_id",
          "route_ids",
          "evidence_unit_ids",
          "measurement_model_ids",
          "systematic_class",
          "uncertainty_source",
          "bias_or_failure_mode",
          "nuisance_parameters",
          "stress_test",
          "mitigation_or_bound",
          "residual_effect",
          "maximum_authority_effect",
          "defeater_ids",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "systematic_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "measurement_model_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "systematic_class": {
            "type": "string"
          },
          "uncertainty_source": {
            "type": "string"
          },
          "bias_or_failure_mode": {
            "type": "string"
          },
          "nuisance_parameters": {
            "type": "string"
          },
          "stress_test": {
            "type": "string"
          },
          "mitigation_or_bound": {
            "type": "string"
          },
          "residual_effect": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "defeater_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
