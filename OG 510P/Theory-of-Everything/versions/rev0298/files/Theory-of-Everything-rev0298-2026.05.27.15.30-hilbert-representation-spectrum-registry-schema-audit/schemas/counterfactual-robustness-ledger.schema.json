{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything counterfactual robustness ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "counterfactual_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "counterfactual_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "counterfactual_id",
          "route_ids",
          "mechanism_ids",
          "intervention_ids",
          "evidence_unit_ids",
          "contrast_class_ids",
          "transportability_ids",
          "counterfactual_class",
          "counterfactual_query",
          "alternative_worlds_or_model_interventions",
          "invariance_requirement",
          "failure_modes",
          "robustness_status",
          "maximum_authority_effect",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "counterfactual_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mechanism_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "intervention_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contrast_class_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transportability_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counterfactual_class": {
            "type": "string"
          },
          "counterfactual_query": {
            "type": "string"
          },
          "alternative_worlds_or_model_interventions": {
            "type": "string"
          },
          "invariance_requirement": {
            "type": "string"
          },
          "failure_modes": {
            "type": "string"
          },
          "robustness_status": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
