{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything credit allocation ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "credit_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "credit_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "credit_id",
          "route_id",
          "evidence_unit_ids",
          "independence_assumption_ids",
          "independence_clusters",
          "aggregation_rule",
          "current_credit_basis",
          "maximum_authority_effect",
          "no_double_counting_rule",
          "cannot_compensate_for",
          "claim_or_oq_ids",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "credit_id": {
            "type": "string"
          },
          "route_id": {
            "type": "string"
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "independence_assumption_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "independence_clusters": {
            "type": "string"
          },
          "aggregation_rule": {
            "type": "string"
          },
          "current_credit_basis": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "no_double_counting_rule": {
            "type": "string"
          },
          "cannot_compensate_for": {
            "type": "string"
          },
          "claim_or_oq_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
