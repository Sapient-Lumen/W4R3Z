{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything generated authority dependency graph",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "edge_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "edge_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "edge_id",
          "source_kind",
          "source_id",
          "dependent_kind",
          "dependent_id",
          "dependency_kind",
          "required_for",
          "failure_effect",
          "max_credit_transmitted"
        ]
      }
    }
  },
  "additionalProperties": true
}
