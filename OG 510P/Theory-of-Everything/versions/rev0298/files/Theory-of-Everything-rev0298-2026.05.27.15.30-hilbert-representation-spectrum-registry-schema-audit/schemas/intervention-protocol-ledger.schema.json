{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything intervention protocol ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "intervention_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "intervention_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "intervention_id",
          "route_ids",
          "mechanism_ids",
          "evidence_unit_ids",
          "protocol_ids",
          "domain_ids",
          "intervention_status",
          "intervention_or_perturbation",
          "intervention_target",
          "isolation_assumptions",
          "manipulability_gap",
          "public_artifact",
          "stress_test",
          "maximum_authority_effect",
          "defeater_ids",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "intervention_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mechanism_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "protocol_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "domain_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "intervention_status": {
            "type": "string"
          },
          "intervention_or_perturbation": {
            "type": "string"
          },
          "intervention_target": {
            "type": "string"
          },
          "isolation_assumptions": {
            "type": "string"
          },
          "manipulability_gap": {
            "type": "string"
          },
          "public_artifact": {
            "type": "string"
          },
          "stress_test": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "defeater_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
