{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything empirical delta ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "empirical_deltas"
  ],
  "properties": {
    "empirical_deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "delta_id",
          "source_refs",
          "route_ids",
          "record_delta",
          "candidate_native_effect",
          "state_effect",
          "promotion_ceiling",
          "residual_cap"
        ],
        "properties": {
          "delta_id": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "record_delta": {
            "type": "string"
          },
          "candidate_native_effect": {
            "type": "string"
          },
          "state_effect": {
            "type": "string"
          },
          "promotion_ceiling": {
            "type": "string"
          },
          "residual_cap": {
            "type": "string"
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
