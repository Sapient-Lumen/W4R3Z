{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything independence assumption ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "independence_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "independence_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "independence_id",
          "assumption_type",
          "route_ids",
          "evidence_unit_ids",
          "independence_claim",
          "failure_mode",
          "stress_test",
          "minimum_disclosure",
          "aggregation_effect",
          "defeater_ids",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "independence_id": {
            "type": "string"
          },
          "assumption_type": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "independence_claim": {
            "type": "string"
          },
          "failure_mode": {
            "type": "string"
          },
          "stress_test": {
            "type": "string"
          },
          "minimum_disclosure": {
            "type": "string"
          },
          "aggregation_effect": {
            "type": "string"
          },
          "defeater_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
