{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ledger-family-registry.schema.json",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "registry_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "registry_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family_id",
          "introduced_revision",
          "ledger_files",
          "route_fields",
          "open_question_id",
          "cardinality_policy"
        ]
      }
    }
  },
  "additionalProperties": true
}
