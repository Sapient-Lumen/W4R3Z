{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything evidence severity ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "severity_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "severity_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity_id",
          "route_ids",
          "decision_experiment_ids",
          "protocol_ids",
          "carrier_ids",
          "negative_control_ids",
          "hypothesis_under_test",
          "alternatives_or_failure_modes",
          "pass_condition",
          "severity_condition",
          "public_artifact",
          "maximum_credit_if_passed",
          "defeat_if_failed",
          "source_refs"
        ],
        "properties": {
          "severity_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision_experiment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "protocol_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "carrier_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "negative_control_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hypothesis_under_test": {
            "type": "string"
          },
          "alternatives_or_failure_modes": {
            "type": "string"
          },
          "pass_condition": {
            "type": "string"
          },
          "severity_condition": {
            "type": "string"
          },
          "public_artifact": {
            "type": "string"
          },
          "maximum_credit_if_passed": {
            "type": "string"
          },
          "defeat_if_failed": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
