{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "classical-limit-ledger.schema.json",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "classical_limit_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "classical_limit_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "classical_limit_id",
          "route_ids",
          "evidence_unit_ids",
          "quantization_map_ids",
          "classical_limit_class",
          "limit_parameter_or_regime",
          "recovered_classical_object",
          "recovery_condition",
          "classical_limit_failure_mode",
          "forbidden_inference",
          "maximum_authority_effect",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "classical_limit_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quantization_map_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "classical_limit_class": {
            "type": "string"
          },
          "limit_parameter_or_regime": {
            "type": "string"
          },
          "recovered_classical_object": {
            "type": "string"
          },
          "recovery_condition": {
            "type": "string"
          },
          "classical_limit_failure_mode": {
            "type": "string"
          },
          "forbidden_inference": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
