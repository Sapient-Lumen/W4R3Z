              "type": "string"
            }
          },
          "renormalization_flow_class": {
            "type": "string"
          },
          "flow_object": {
            "type": "string"
          },
          "scale_parameter_or_blocking_rule": {
            "type": "string"
          },
          "fixed_point_or_running_claim": {
            "type": "string"
          },
          "universal_quantity_claim": {
            "type": "string"
          },
          "scheme_or_truncation_residual": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "rollback_rule_ids": {
            "type": "array",
