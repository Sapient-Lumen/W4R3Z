{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything contrast class ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "contrast_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "contrast_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "contrast_class_id",
          "route_ids",
          "evidence_unit_ids",
          "comparator_scope",
          "target_question",
          "live_alternatives",
          "quotient_policy",
          "contrast_completeness_status",
          "current_update_ceiling",
          "negative_control_ids",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "contrast_class_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "comparator_scope": {
            "type": "string"
          },
          "target_question": {
            "type": "string"
          },
          "live_alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quotient_policy": {
            "type": "string"
          },
          "contrast_completeness_status": {
            "type": "string"
          },
          "current_update_ceiling": {
            "type": "string"
          },
          "negative_control_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
