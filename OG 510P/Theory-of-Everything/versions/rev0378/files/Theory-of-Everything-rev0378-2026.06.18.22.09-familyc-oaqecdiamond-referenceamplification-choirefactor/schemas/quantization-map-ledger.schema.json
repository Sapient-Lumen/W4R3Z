{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quantization-map-ledger.schema.json",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "quantization_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "quantization_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "quantization_map_id",
          "route_ids",
          "evidence_unit_ids",
          "quantization_map_class",
          "classical_or_prequantum_domain",
          "quantum_target_object",
          "quantization_map_or_rule",
          "ordering_measure_or_representation_ambiguity",
          "quantization_failure_mode",
          "forbidden_inference",
          "maximum_authority_effect",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "quantization_map_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quantization_map_class": {
            "type": "string"
          },
          "classical_or_prequantum_domain": {
            "type": "string"
          },
          "quantum_target_object": {
            "type": "string"
          },
          "quantization_map_or_rule": {
            "type": "string"
          },
          "ordering_measure_or_representation_ambiguity": {
            "type": "string"
          },
          "quantization_failure_mode": {
            "type": "string"
          },
          "forbidden_inference": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
