{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything prior sensitivity ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "prior_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "prior_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prior_sensitivity_id",
          "route_ids",
          "contrast_class_ids",
          "evidence_unit_ids",
          "prior_family",
          "sensitivity_dimensions",
          "stress_test",
          "current_status",
          "maximum_authority_effect",
          "likelihood_update_ids",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "prior_sensitivity_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contrast_class_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prior_family": {
            "type": "string"
          },
          "sensitivity_dimensions": {
            "type": "string"
          },
          "stress_test": {
            "type": "string"
          },
          "current_status": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "likelihood_update_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
