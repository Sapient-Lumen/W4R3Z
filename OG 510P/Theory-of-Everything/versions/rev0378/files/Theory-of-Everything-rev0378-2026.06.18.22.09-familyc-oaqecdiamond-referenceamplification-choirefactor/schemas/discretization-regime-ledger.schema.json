{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "discretization_rows"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "discretization_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "discretization_regime_id",
          "route_ids",
          "evidence_unit_ids",
          "maximum_authority_effect",
          "rollback_rule_ids",
          "source_refs"
        ],
        "additionalProperties": true,
        "properties": {
          "discretization_regime_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
