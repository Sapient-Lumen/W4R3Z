{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "local_qft_recovery_rows schema",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "local_qft_recovery_rows"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "local_qft_recovery_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "local_qft_recovery_id",
          "route_ids",
          "evidence_unit_ids",
          "microcausality_locality_ids",
          "cluster_decomposition_ids",
          "local_qft_recovery_class",
          "recovery_object",
          "denominator_rule",
          "residual_gap",
          "forbidden_inference",
          "maximum_authority_effect",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "local_qft_recovery_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "denominator_rule": {
            "type": "string"
          },
          "residual_gap": {
            "type": "string"
          },
          "forbidden_inference": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "microcausality_locality_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cluster_decomposition_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "local_qft_recovery_class": {
            "type": "string"
          },
          "recovery_object": {
            "type": "string"
          },
          "source_role_events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "event_id",
                "introduced_revision",
                "normalized_revision",
                "source_role",
                "source_refs",
                "credit_cap",
                "source_ref_disposition",
                "disposition"
              ],
              "additionalProperties": true,
              "properties": {
                "event_id": {
                  "type": "string"
                },
                "introduced_revision": {
                  "type": "string"
                },
                "normalized_revision": {
                  "type": "string"
                },
                "source_role": {
                  "type": "string",
                  "enum": [
                    "acquired_support",
                    "denominator_pressure",
                    "forecast_runway",
                    "operational_status",
                    "metadata_wrapper"
                  ]
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "credit_cap": {
                  "type": "string"
                },
                "source_ref_disposition": {
                  "type": "string",
                  "enum": [
                    "excluded_from_acquired_source_refs",
                    "forbidden_on_metadata_wrapper",
                    "retained_on_denominator_row_only",
                    "historical_source_role_normalization",
                    "route_local_handoff_only",
                    "retained_as_acquired_support",
                    "retained_as_forecast_runway",
                    "retained_as_operational_status"
                  ]
                },
                "empirical_delta_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "replaces_ad_hoc_keys": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "disposition": {
                  "type": "string"
                },
                "source_note": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
