{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything likelihood update ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "update_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "update_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "likelihood_update_id",
          "route_id",
          "contrast_class_id",
          "evidence_unit_ids",
          "update_mode",
          "likelihood_or_score_object",
          "outcome_classes",
          "prior_sensitivity_ids",
          "current_update_status",
          "maximum_authority_effect",
          "no_update_if",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "likelihood_update_id": {
            "type": "string"
          },
          "route_id": {
            "type": "string"
          },
          "contrast_class_id": {
            "type": "string"
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "update_mode": {
            "type": "string"
          },
          "likelihood_or_score_object": {
            "type": "string"
          },
          "outcome_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prior_sensitivity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "current_update_status": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "no_update_if": {
            "type": "string"
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
