{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "benchmark_suite_rows"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "benchmark_suite_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "benchmark_suite_id",
          "route_ids",
          "evidence_unit_ids",
          "rollback_rule_ids",
          "source_refs",
          "maximum_authority_effect",
          "benchmark_suite_class",
          "benchmark_or_challenge_object",
          "dataset_or_task_boundary",
          "contamination_or_leaderboard_risk",
          "residual_gap",
          "forbidden_inference"
        ],
        "properties": {
          "benchmark_suite_id": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "benchmark_suite_class": {
            "type": "string"
          },
          "benchmark_or_challenge_object": {
            "type": "string"
          },
          "dataset_or_task_boundary": {
            "type": "string"
          },
          "contamination_or_leaderboard_risk": {
            "type": "string"
          },
          "residual_gap": {
            "type": "string"
          },
          "forbidden_inference": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
