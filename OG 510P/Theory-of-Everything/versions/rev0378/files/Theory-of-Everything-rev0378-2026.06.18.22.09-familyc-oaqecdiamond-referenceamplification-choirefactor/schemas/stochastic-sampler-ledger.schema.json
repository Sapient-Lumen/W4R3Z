            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stochastic_sampler_class": {
            "type": "string"
          },
          "sampler_object": {
            "type": "string"
          },
          "target_distribution_or_population": {
            "type": "string"
          },
          "sampling_protocol": {
            "type": "string"
          },
          "residual_gap": {
            "type": "string"
          },
          "forbidden_inference": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          }
