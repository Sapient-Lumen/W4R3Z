{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything evidence unit ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "evidence_units"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "evidence_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_unit_id",
          "route_ids",
          "support_kind",
          "record_status",
          "record_description",
          "carrier_ids",
          "protocol_ids",
          "empirical_delta_ids",
          "severity_test_ids",
          "negative_control_ids",
          "independence_assumption_ids",
          "shared_support_cluster",
          "credit_role",
          "maximum_credit",
          "double_counting_risk",
          "credit_spend_rule",
          "rollback_if_compromised",
          "source_refs"
        ],
        "properties": {
          "evidence_unit_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "support_kind": {
            "type": "string"
          },
          "record_status": {
            "type": "string"
          },
          "record_description": {
            "type": "string"
          },
          "carrier_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "protocol_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "empirical_delta_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity_test_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "negative_control_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "independence_assumption_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shared_support_cluster": {
            "type": "string"
          },
          "credit_role": {
            "type": "string"
          },
          "maximum_credit": {
            "type": "string"
          },
          "double_counting_risk": {
            "type": "string"
          },
          "credit_spend_rule": {
            "type": "string"
          },
          "rollback_if_compromised": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_role_events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "event_id",
                "introduced_revision",
                "normalized_revision",
                "source_role",
                "source_refs",
                "credit_cap",
                "source_ref_disposition",
                "disposition"
              ],
              "additionalProperties": true,
              "properties": {
                "event_id": {
                  "type": "string"
                },
                "introduced_revision": {
                  "type": "string"
                },
                "normalized_revision": {
                  "type": "string"
                },
                "source_role": {
                  "type": "string",
                  "enum": [
                    "acquired_support",
                    "denominator_pressure",
                    "forecast_runway",
                    "operational_status",
                    "metadata_wrapper"
                  ]
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "credit_cap": {
                  "type": "string"
                },
                "source_ref_disposition": {
                  "type": "string",
                  "enum": [
                    "excluded_from_acquired_source_refs",
                    "forbidden_on_metadata_wrapper",
                    "retained_on_denominator_row_only",
                    "historical_source_role_normalization",
                    "route_local_handoff_only",
                    "retained_as_acquired_support",
                    "retained_as_forecast_runway",
                    "retained_as_operational_status"
                  ]
                },
                "empirical_delta_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "replaces_ad_hoc_keys": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "disposition": {
                  "type": "string"
                },
                "source_note": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
