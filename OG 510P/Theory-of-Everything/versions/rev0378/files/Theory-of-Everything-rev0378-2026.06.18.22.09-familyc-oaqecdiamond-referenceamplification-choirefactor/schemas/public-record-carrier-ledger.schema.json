{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything public record carrier ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "carrier_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "carrier_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "carrier_id",
          "route_ids",
          "carrier_class",
          "publicness_level",
          "record_object",
          "custody_object",
          "locator_or_access_class",
          "metadata_standard",
          "provenance_requirements",
          "replay_requirements",
          "challenge_route",
          "versioning_or_freeze_rule",
          "known_failure_modes",
          "maximum_authority_credit",
          "source_refs"
        ],
        "properties": {
          "carrier_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "carrier_class": {
            "type": "string"
          },
          "publicness_level": {
            "type": "string"
          },
          "record_object": {
            "type": "string"
          },
          "custody_object": {
            "type": "string"
          },
          "locator_or_access_class": {
            "type": "string"
          },
          "metadata_standard": {
            "type": "string"
          },
          "provenance_requirements": {
            "type": "string"
          },
          "replay_requirements": {
            "type": "string"
          },
          "challenge_route": {
            "type": "string"
          },
          "versioning_or_freeze_rule": {
            "type": "string"
          },
          "known_failure_modes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maximum_authority_credit": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
