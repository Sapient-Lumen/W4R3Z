{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "regularization-scheme-ledger.schema.json",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "regularization_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "regularization_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "regularization_scheme_id",
          "route_ids",
          "evidence_unit_ids",
          "regularization_scheme_class",
          "regulator_or_subtraction_object",
          "scheme_dependence_risk",
          "invariant_or_scheme_independence_test",
          "forbidden_inference",
          "maximum_authority_effect",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "regularization_scheme_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "regularization_scheme_class": {
            "type": "string"
          },
          "regulator_or_subtraction_object": {
            "type": "string"
          },
          "scheme_dependence_risk": {
            "type": "string"
          },
          "invariant_or_scheme_independence_test": {
            "type": "string"
          },
          "forbidden_inference": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
