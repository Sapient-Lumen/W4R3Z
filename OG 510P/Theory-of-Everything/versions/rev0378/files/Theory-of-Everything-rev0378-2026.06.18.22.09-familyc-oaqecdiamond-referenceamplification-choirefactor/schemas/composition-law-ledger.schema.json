{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "composition-law-ledger.schema.json",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "composition_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "composition_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "composition_law_id",
          "route_ids",
          "evidence_unit_ids",
          "composition_law_class",
          "component_objects",
          "composition_rule",
          "associativity_or_functoriality_test",
          "non_compositional_failure_mode",
          "forbidden_inference",
          "maximum_authority_effect",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "composition_law_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "composition_law_class": {
            "type": "string"
          },
          "component_objects": {
            "type": "string"
          },
          "composition_rule": {
            "type": "string"
          },
          "associativity_or_functoriality_test": {
            "type": "string"
          },
          "non_compositional_failure_mode": {
            "type": "string"
          },
          "forbidden_inference": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
