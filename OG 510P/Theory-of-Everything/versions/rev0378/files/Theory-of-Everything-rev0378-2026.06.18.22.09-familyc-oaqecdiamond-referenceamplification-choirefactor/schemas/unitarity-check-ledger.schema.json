{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unitarity-check-ledger.schema.json",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "unitarity_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "unitarity_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "unitarity_check_id",
          "route_ids",
          "evidence_unit_ids",
          "unitarity_check_class",
          "probability_or_norm_object",
          "unitarity_condition",
          "violation_mode",
          "unitarity_test",
          "forbidden_inference",
          "maximum_authority_effect",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "unitarity_check_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unitarity_check_class": {
            "type": "string"
          },
          "probability_or_norm_object": {
            "type": "string"
          },
          "unitarity_condition": {
            "type": "string"
          },
          "violation_mode": {
            "type": "string"
          },
          "unitarity_test": {
            "type": "string"
          },
          "forbidden_inference": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
