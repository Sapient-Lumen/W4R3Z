{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything generated authority dependency graph",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "edge_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "title": "Expanded edge-row representation",
      "required": [
        "edge_rows"
      ],
      "properties": {
        "edge_rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "edge_id",
              "source_kind",
              "source_id",
              "dependent_kind",
              "dependent_id",
              "dependency_kind",
              "required_for",
              "failure_effect",
              "max_credit_transmitted"
            ],
            "properties": {
              "edge_id": {
                "type": "string"
              },
              "source_kind": {
                "type": "string"
              },
              "source_id": {
                "type": "string"
              },
              "dependent_kind": {
                "type": "string"
              },
              "dependent_id": {
                "type": "string"
              },
              "dependency_kind": {
                "type": "string"
              },
              "required_for": {
                "type": "string"
              },
              "failure_effect": {
                "type": "string"
              },
              "max_credit_transmitted": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "title": "Columnar dictionary compact representation",
      "required": [
        "representation",
        "edge_count",
        "row_count",
        "edge_row_fields",
        "edge_ids",
        "dictionaries",
        "columns",
        "expanded_sha256"
      ],
      "properties": {
        "representation": {
          "const": "columnar-dictionary-v1"
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "edge_row_fields": {
          "type": "array",
          "prefixItems": [
            {
              "const": "source_kind"
            },
            {
              "const": "source_id"
            },
            {
              "const": "dependent_kind"
            },
            {
              "const": "dependent_id"
            },
            {
              "const": "dependency_kind"
            },
            {
              "const": "required_for"
            },
            {
              "const": "failure_effect"
            },
            {
              "const": "max_credit_transmitted"
            }
          ],
          "minItems": 8,
          "maxItems": 8
        },
        "edge_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dictionaries": {
          "type": "object",
          "required": [
            "source_kind",
            "source_id",
            "dependent_kind",
            "dependent_id",
            "dependency_kind",
            "required_for",
            "failure_effect",
            "max_credit_transmitted"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "columns": {
          "type": "object",
          "required": [
            "source_kind",
            "source_id",
            "dependent_kind",
            "dependent_id",
            "dependency_kind",
            "required_for",
            "failure_effect",
            "max_credit_transmitted"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "expanded_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "not": {
        "required": [
          "edge_rows"
        ]
      }
    }
  ],
  "additionalProperties": true
}
