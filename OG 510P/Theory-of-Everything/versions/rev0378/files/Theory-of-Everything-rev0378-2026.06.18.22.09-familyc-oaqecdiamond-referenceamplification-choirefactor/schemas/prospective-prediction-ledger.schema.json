{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "prospective-prediction-ledger.schema.json",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "prospective_prediction_rows"
  ],
  "properties": {
