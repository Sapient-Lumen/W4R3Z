            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "residual_gap": {
            "type": "string"
          },
          "forbidden_inference": {
            "type": "string"
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prospective_prediction_class": {
            "type": "string"
          },
          "prediction_or_forecast_object": {
            "type": "string"
          },
          "temporal_order_test": {
            "type": "string"
          },
          "postdiction_or_retrofit_risk": {
            "type": "string"
          }
