        "required": [
          "prospective_prediction_id",
          "route_ids",
          "evidence_unit_ids",
          "maximum_authority_effect",
          "prospective_prediction_class",
          "prediction_or_forecast_object",
          "temporal_order_test",
          "postdiction_or_retrofit_risk",
          "residual_gap",
          "forbidden_inference",
          "rollback_rule_ids",
