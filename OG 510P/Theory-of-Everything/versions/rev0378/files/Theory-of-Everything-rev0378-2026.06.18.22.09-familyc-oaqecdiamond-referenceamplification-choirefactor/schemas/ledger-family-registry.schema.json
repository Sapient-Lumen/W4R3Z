{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ledger-family-registry.schema.json",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "registry_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "registry_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family_id",
          "introduced_revision",
          "ledger_files",
          "route_fields",
          "open_question_id",
          "cardinality_policy",
          "schema_files",
          "maximum_route_field_cardinality",
          "generated_summary",
          "audit_note"
        ],
        "properties": {
          "family_id": {
            "type": "string"
          },
          "introduced_revision": {
            "type": "string"
          },
          "ledger_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "schema_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "route_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "open_question_id": {
            "type": "string"
          },
          "cardinality_policy": {
            "type": "string"
          },
          "maximum_route_field_cardinality": {
            "type": "integer"
          },
          "generated_summary": {
            "type": "string"
          },
          "audit_note": {
            "type": "string"
          }
        }
      }
    },
    "generated_registry_schema_audit": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
