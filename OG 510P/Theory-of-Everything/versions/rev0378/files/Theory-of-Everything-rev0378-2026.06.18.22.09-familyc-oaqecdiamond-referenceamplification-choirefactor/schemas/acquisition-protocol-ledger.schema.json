{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything acquisition protocol ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "protocol_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "protocol_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "protocol_id",
          "route_ids",
          "carrier_ids",
          "acquisition_stage",
          "required_operations",
          "minimum_public_artifacts",
          "calibration_or_metadata_requirements",
          "nuisance_controls",
          "replay_harness",
          "intervention_grade",
          "fresh_host_reinstantiation_requirement",
          "failure_to_record_effect",
          "maximum_route_effect",
          "source_refs"
        ],
        "properties": {
          "protocol_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "carrier_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acquisition_stage": {
            "type": "string"
          },
          "required_operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minimum_public_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "calibration_or_metadata_requirements": {
            "type": "string"
          },
          "nuisance_controls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "replay_harness": {
            "type": "string"
          },
          "intervention_grade": {
            "type": "string"
          },
          "fresh_host_reinstantiation_requirement": {
            "type": "string"
          },
          "failure_to_record_effect": {
            "type": "string"
          },
          "maximum_route_effect": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
