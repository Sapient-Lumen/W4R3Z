{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything calibration traceability ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "calibration_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "calibration_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "calibration_id",
          "route_ids",
          "evidence_unit_ids",
          "measurement_model_ids",
          "systematic_ids",
          "carrier_ids",
          "protocol_ids",
          "traceability_class",
          "reference_object_or_standard",
          "calibration_chain",
          "uncertainty_budget",
          "drift_control",
          "replay_or_audit_artifact",
          "failure_effect",
          "maximum_authority_effect",
          "source_refs"
        ],
        "properties": {
          "calibration_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "measurement_model_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "systematic_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "carrier_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "protocol_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "traceability_class": {
            "type": "string"
          },
          "reference_object_or_standard": {
            "type": "string"
          },
          "calibration_chain": {
            "type": "string"
          },
          "uncertainty_budget": {
            "type": "string"
          },
          "drift_control": {
            "type": "string"
          },
          "replay_or_audit_artifact": {
            "type": "string"
          },
          "failure_effect": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
