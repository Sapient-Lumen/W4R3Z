{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything observed sector recovery ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "obligations"
  ],
  "properties": {
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "obligation_id",
          "target_sector",
          "minimum_for_S4",
          "minimum_for_S5",
          "current_archive_state",
          "route_ids_touching",
          "decisive_missing_piece",
          "negative_controls",
          "residual_cap"
        ],
        "properties": {
          "source_role_events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "event_id",
                "introduced_revision",
                "normalized_revision",
                "source_role",
                "source_refs",
                "credit_cap",
                "source_ref_disposition",
                "disposition"
              ],
              "additionalProperties": true,
              "properties": {
                "event_id": {
                  "type": "string"
                },
                "introduced_revision": {
                  "type": "string"
                },
                "normalized_revision": {
                  "type": "string"
                },
                "source_role": {
                  "type": "string",
                  "enum": [
                    "acquired_support",
                    "denominator_pressure",
                    "forecast_runway",
                    "operational_status",
                    "metadata_wrapper"
                  ]
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "credit_cap": {
                  "type": "string"
                },
                "source_ref_disposition": {
                  "type": "string",
                  "enum": [
                    "excluded_from_acquired_source_refs",
                    "forbidden_on_metadata_wrapper",
                    "retained_on_denominator_row_only",
                    "historical_source_role_normalization",
                    "route_local_handoff_only",
                    "retained_as_acquired_support",
                    "retained_as_forecast_runway",
                    "retained_as_operational_status"
                  ]
                },
                "empirical_delta_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "replaces_ad_hoc_keys": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "disposition": {
                  "type": "string"
                },
                "source_note": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
