{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything extrapolation fence ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "fence_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "fence_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fence_id",
          "route_ids",
          "domain_ids",
          "transport_ids",
          "evidence_unit_ids",
          "fence_class",
          "forbidden_inference",
          "allowed_inference",
          "escalation_condition",
          "target_floor_if_violated",
          "maximum_authority_effect",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "fence_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "domain_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transport_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fence_class": {
            "type": "string"
          },
          "forbidden_inference": {
            "type": "string"
          },
          "allowed_inference": {
            "type": "string"
          },
          "escalation_condition": {
            "type": "string"
          },
          "target_floor_if_violated": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
