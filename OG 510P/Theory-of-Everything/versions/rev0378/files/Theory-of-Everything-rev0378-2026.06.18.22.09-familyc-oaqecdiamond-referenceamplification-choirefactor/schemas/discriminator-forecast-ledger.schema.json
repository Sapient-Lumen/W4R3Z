{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything discriminator forecast ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "forecast_rows"
  ],
  "properties": {
    "forecast_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "forecast_id",
          "route_id",
          "artifact_type",
          "required_public_record",
          "positive_result_credit",
          "negative_result_credit",
          "underdetermination_controls",
          "current_maximum_credit",
          "non_promotion_warning",
          "public_record_carrier_ids",
          "acquisition_protocol_ids"
        ]
      }
    }
  },
  "additionalProperties": true
}
