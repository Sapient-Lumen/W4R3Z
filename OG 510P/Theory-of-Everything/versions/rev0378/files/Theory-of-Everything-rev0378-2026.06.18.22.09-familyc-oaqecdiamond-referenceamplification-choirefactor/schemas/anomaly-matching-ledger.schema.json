{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "anomaly-matching-ledger.schema.json",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "anomaly_rows"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "anomaly_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "anomaly_matching_id",
          "route_ids",
          "evidence_unit_ids",
          "symmetry_realization_ids",
          "anomaly_matching_class",
          "anomaly_object",
          "matching_or_cancellation_condition",
          "mismatch_failure_mode",
          "anomaly_test",
          "forbidden_inference",
          "maximum_authority_effect",
          "rollback_rule_ids",
          "source_refs"
        ],
        "properties": {
          "anomaly_matching_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "symmetry_realization_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "anomaly_matching_class": {
            "type": "string"
          },
          "anomaly_object": {
            "type": "string"
          },
          "matching_or_cancellation_condition": {
            "type": "string"
          },
          "mismatch_failure_mode": {
            "type": "string"
          },
          "anomaly_test": {
            "type": "string"
          },
          "forbidden_inference": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
