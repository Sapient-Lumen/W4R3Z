{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "matching-condition-ledger.schema.json",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "purpose",
    "matching_rows"
