        "properties": {
          "matching_condition_id": {
            "type": "string"
          },
          "route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "regularization_scheme_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "renormalization_flow_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "matching_condition_class": {
            "type": "string"
          },
          "source_scale_or_theory": {
            "type": "string"
          },
          "target_scale_or_theory": {
            "type": "string"
          },
          "matching_object": {
            "type": "string"
          },
          "threshold_or_power_counting_rule": {
            "type": "string"
          },
          "unmatched_residual": {
            "type": "string"
          },
          "forbidden_inference": {
            "type": "string"
          },
          "maximum_authority_effect": {
            "type": "string"
          },
          "rollback_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
