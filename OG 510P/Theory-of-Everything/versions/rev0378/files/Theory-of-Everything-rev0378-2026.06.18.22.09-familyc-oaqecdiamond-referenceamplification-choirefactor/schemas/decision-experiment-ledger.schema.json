{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theory-of-Everything decision experiment ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "schema_version",
    "decision_experiments"
  ],
  "properties": {
    "project": {
      "const": "Theory-of-Everything"
    },
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "decision_experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "experiment_id",
          "route_ids",
          "target_question",
          "public_record",
          "decision_stage",
          "minimum_public_artifact",
          "source_refs",
          "negative_controls",
          "empirical_delta_hooks",
          "outcome_effects",
          "non_promotion_clause",
          "public_record_carrier_ids",
          "acquisition_protocol_ids"
        ],
        "properties": {
          "outcome_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "outcome_class",
                "record_result",
                "route_state_effect",
                "promotion_ceiling",
                "residual_cap",
                "rollback_trigger"
              ]
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
