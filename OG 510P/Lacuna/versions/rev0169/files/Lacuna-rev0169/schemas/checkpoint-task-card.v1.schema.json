{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:checkpoint-task-card:v1",
  "title": "Lacuna retcon checkpoint least-context task card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "role",
    "task_id",
    "checkpoint_id",
    "request_sha256",
    "upstream",
    "provider_aliases",
    "objective",
    "input_payload",
    "instructions",
    "forbidden_context",
    "output_contract",
    "authority",
    "next_command",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.checkpoint.tasked"
    },
    "schema": {
      "const": "lacuna.checkpoint-task-card.v1"
    },
    "role": {
      "enum": [
        "lacuna-retcon-generator",
        "lacuna-retcon-judge",
        "lacuna-retcon-compressor",
        "lacuna-retcon-verifier"
      ]
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "checkpoint_id": {
      "$ref": "#/$defs/id"
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "upstream": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "schema",
          "sha256"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "provider_aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portable",
        "codex",
        "claude-code",
        "gemini-cli",
        "chatgpt"
      ],
      "properties": {
        "portable": {
          "type": "string",
          "minLength": 1
        },
        "codex": {
          "type": "string",
          "minLength": 1
        },
        "claude-code": {
          "type": "string",
          "minLength": 1
        },
        "gemini-cli": {
          "type": "string",
          "minLength": 1
        },
        "chatgpt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "input_payload": {
      "type": "object"
    },
    "instructions": {
      "$ref": "#/$defs/stringList"
    },
    "forbidden_context": {
      "$ref": "#/$defs/stringList"
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "format",
        "template"
      ],
      "properties": {
        "schema": {
          "enum": [
            "lacuna.checkpoint-candidates.v1",
            "lacuna.checkpoint-judgment.v1",
            "lacuna.checkpoint-compression.v1",
            "lacuna.checkpoint-verifier-return.v1"
          ]
        },
        "format": {
          "const": "exact-json-object"
        },
        "template": {
          "type": "object"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_may",
        "worker_may_not",
        "parent_only"
      ],
      "properties": {
        "worker_may": {
          "$ref": "#/$defs/stringList"
        },
        "worker_may_not": {
          "$ref": "#/$defs/stringList"
        },
        "parent_only": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "next_command": {
      "type": "string",
      "minLength": 1
    },
    "nonclaims": {
      "$ref": "#/$defs/stringList"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "model_version",
        "invocation_id",
        "notes"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
