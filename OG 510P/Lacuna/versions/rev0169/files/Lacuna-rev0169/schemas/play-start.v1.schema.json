{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:play-start:v1",
  "title": "Lacuna direct session-control play start receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "profile",
    "input_kind",
    "reference",
    "resolved_cube_path",
    "campaign",
    "bootstrap_actions",
    "run",
    "next_action",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.play.started"
    },
    "schema": {
      "const": "lacuna.play-start.v1"
    },
    "profile": {
      "enum": [
        "chat",
        "workspace",
        "orchestrated"
      ]
    },
    "input_kind": {
      "const": "session-control"
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "resolved_cube_path": {
      "type": "string",
      "minLength": 1
    },
    "campaign": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/campaign"
        }
      ]
    },
    "bootstrap_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "run": {
      "type": "object",
      "required": [
        "event",
        "schema",
        "run_id",
        "run_path",
        "status",
        "selected_mode",
        "turn_identity",
        "artifacts",
        "next_action"
      ],
      "properties": {
        "event": {
          "const": "lacuna.turn.run"
        },
        "schema": {
          "const": "lacuna.turn-run.v2"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "run_path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "selected_mode": {
          "enum": [
            "solo",
            "pair",
            "full"
          ]
        },
        "turn_identity": {
          "type": "object"
        },
        "artifacts": {
          "type": "object"
        },
        "next_action": {
          "$ref": "#/$defs/nextAction"
        }
      }
    },
    "next_action": {
      "$ref": "#/$defs/nextAction"
    },
    "nonclaims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "slug",
        "title",
        "summary",
        "status",
        "owner_id",
        "player_id",
        "narrator_id"
      ],
      "properties": {
        "campaign_id": {
          "$ref": "#/$defs/nullableString"
        },
        "slug": {
          "$ref": "#/$defs/nullableString"
        },
        "title": {
          "$ref": "#/$defs/nullableString"
        },
        "summary": {
          "$ref": "#/$defs/nullableString"
        },
        "status": {
          "$ref": "#/$defs/nullableString"
        },
        "owner_id": {
          "$ref": "#/$defs/nullableString"
        },
        "player_id": {
          "$ref": "#/$defs/nullableString"
        },
        "narrator_id": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "action",
        "input_path",
        "expected_schema",
        "command",
        "player_visibility"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "input_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "player_visibility": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
