{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-cell-receipt-v1",
  "title": "Lacuna accepted comparative cell receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "run_id",
    "capsule_id",
    "cell_label",
    "assignment_sha256",
    "driver_sha256",
    "return_artifact",
    "return_sha256",
    "transcript_sha256",
    "observed_cube",
    "execution_totals",
    "accepted_at",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.cell-recorded"
    },
    "schema": {
      "const": "lacuna.scenario-cell-receipt.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "capsule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "cell_label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "assignment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "driver_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "return_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "schema",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "return_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transcript_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_cube": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cube_id",
        "seed_head",
        "final_head",
        "seed_event_count",
        "final_event_count",
        "event_count_delta",
        "verification_sha256",
        "overall_status"
      ],
      "properties": {
        "cube_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "seed_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "final_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "seed_event_count": {
          "type": "integer",
          "minimum": 1
        },
        "final_event_count": {
          "type": "integer",
          "minimum": 1
        },
        "event_count_delta": {
          "type": "integer",
          "minimum": 0
        },
        "verification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "overall_status": {
          "const": "pass"
        }
      }
    },
    "execution_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation_count",
        "accepted_invocations",
        "failed_invocations",
        "duration_ms",
        "duration_complete",
        "input_tokens",
        "input_tokens_complete",
        "output_tokens",
        "output_tokens_complete",
        "cost_microusd",
        "cost_complete"
      ],
      "properties": {
        "invocation_count": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_invocations": {
          "type": "integer",
          "minimum": 0
        },
        "failed_invocations": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "duration_complete": {
          "type": "boolean"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens_complete": {
          "type": "boolean"
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens_complete": {
          "type": "boolean"
        },
        "cost_microusd": {
          "type": "integer",
          "minimum": 0
        },
        "cost_complete": {
          "type": "boolean"
        }
      }
    },
    "accepted_at": {
      "type": "string",
      "minLength": 1
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
