{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:artifact-audit-v1",
  "title": "Local extracted Lacuna artifact audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "root",
    "project_version",
    "revision",
    "strict_members",
    "overall_status",
    "checks",
    "counts",
    "warnings",
    "nonclaims"
  ],
  "properties": {
    "event": {"const": "lacuna.artifact.audited"},
    "schema": {"const": "lacuna.artifact-audit.v1"},
    "root": {"type": "string", "minLength": 1},
    "project_version": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "strict_members": {"type": "boolean"},
    "overall_status": {"enum": ["pass", "fail"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "summary", "details"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail"]},
          "summary": {"type": "string", "minLength": 1},
          "details": {"type": "object"}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
