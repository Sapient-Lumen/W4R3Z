{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-bundle-plan-v1",
  "title": "Lacuna preregistered scenario bundle plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bundle_id",
    "title",
    "research_question",
    "blocks",
    "registration",
    "witness_policy",
    "notes",
    "nonclaims"
  ],
  "properties": {
    "schema": {
      "const": "lacuna.scenario-bundle-plan.v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_id",
          "reference",
          "resolved_seed_cube_path",
          "capsule",
          "story_stratum",
          "model_stratum",
          "replicate",
          "tags"
        ],
        "properties": {
          "block_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "resolved_seed_cube_path": {
            "type": "string",
            "minLength": 1
          },
          "capsule": {
            "$ref": "#/$defs/capsule"
          },
          "story_stratum": {
            "type": "string",
            "minLength": 1
          },
          "model_stratum": {
            "type": "string",
            "minLength": 1
          },
          "replicate": {
            "type": "integer",
            "minimum": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            }
          }
        }
      },
      "minItems": 2,
      "maxItems": 128
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_dimensions",
        "primary_preference_rank",
        "block_inclusion",
        "terminal_failures",
        "analysis_unit",
        "ordinal_policy",
        "analysis_notes"
      ],
      "properties": {
        "primary_dimensions": {
          "type": "array",
          "items": {
            "enum": [
              "coherence",
              "agency",
              "character_believability",
              "genre_fit",
              "payoff",
              "novelty",
              "coincidence_restraint",
              "mystery_fairness",
              "seam_invisibility"
            ]
          },
          "minItems": 1,
          "maxItems": 9
        },
        "primary_preference_rank": {
          "const": true
        },
        "block_inclusion": {
          "const": "all-scheduled-blocks"
        },
        "terminal_failures": {
          "const": "include"
        },
        "analysis_unit": {
          "const": "rater-by-condition-within-block"
        },
        "ordinal_policy": {
          "const": "retain-integers-and-ranks-no-automatic-interval-or-significance-claim"
        },
        "analysis_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "witness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_receipts_before_execution"
      ],
      "properties": {
        "minimum_receipts_before_execution": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "nonclaims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3
    }
  },
  "$defs": {
    "capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "capsule_id",
        "title",
        "research_question",
        "seed",
        "actors",
        "script",
        "conditions",
        "model_policy",
        "budget",
        "rating",
        "notes"
      ],
      "properties": {
        "schema": {
          "const": "lacuna.scenario-capsule.v1"
        },
        "capsule_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "research_question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "seed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cube_id",
            "head"
          ],
          "properties": {
            "cube_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "head": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "actors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "audience_id",
            "actor_id"
          ],
          "properties": {
            "audience_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "actor_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            }
          }
        },
        "script": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "player_input",
              "checkpoint_after",
              "checkpoint_trigger",
              "tags"
            ],
            "properties": {
              "step_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
              },
              "player_input": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              },
              "checkpoint_after": {
                "type": "boolean"
              },
              "checkpoint_trigger": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
                },
                "maxItems": 64,
                "uniqueItems": true
              }
            }
          }
        },
        "conditions": {
          "const": [
            "forward-only",
            "prompt-only-retcon",
            "lacuna-serial",
            "lacuna-role-separated"
          ]
        },
        "model_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model_family",
            "model",
            "model_version",
            "sampling_policy",
            "sampling_seed",
            "same_model_required"
          ],
          "properties": {
            "provider": {
              "enum": [
                "portable",
                "codex",
                "claude-code",
                "gemini-cli",
                "chatgpt"
              ]
            },
            "model_family": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "model_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "sampling_policy": {
              "type": "string",
              "minLength": 1
            },
            "same_model_required": {
              "type": "boolean"
            },
            "sampling_seed": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_invocations_per_cell",
            "max_duration_ms_per_cell",
            "max_input_tokens_per_cell",
            "max_output_tokens_per_cell",
            "max_cost_microusd_per_cell"
          ],
          "properties": {
            "max_invocations_per_cell": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "max_duration_ms_per_cell": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "max_input_tokens_per_cell": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "max_output_tokens_per_cell": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "max_cost_microusd_per_cell": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "rating": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rater_count",
            "scale_min",
            "scale_max",
            "dimension_prompts",
            "comments_prompt"
          ],
          "properties": {
            "rater_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "scale_min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "scale_max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "dimension_prompts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "coherence",
                "agency",
                "character_believability",
                "genre_fit",
                "payoff",
                "novelty",
                "coincidence_restraint",
                "mystery_fairness",
                "seam_invisibility"
              ],
              "properties": {
                "coherence": {
                  "type": "string",
                  "minLength": 1
                },
                "agency": {
                  "type": "string",
                  "minLength": 1
                },
                "character_believability": {
                  "type": "string",
                  "minLength": 1
                },
                "genre_fit": {
                  "type": "string",
                  "minLength": 1
                },
                "payoff": {
                  "type": "string",
                  "minLength": 1
                },
                "novelty": {
                  "type": "string",
                  "minLength": 1
                },
                "coincidence_restraint": {
                  "type": "string",
                  "minLength": 1
                },
                "mystery_fairness": {
                  "type": "string",
                  "minLength": 1
                },
                "seam_invisibility": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "comments_prompt": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
