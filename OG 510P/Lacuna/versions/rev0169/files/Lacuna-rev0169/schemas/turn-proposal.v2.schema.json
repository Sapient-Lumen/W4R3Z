{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:turn-proposal:v2",
  "title": "Lacuna turn proposal v2",
  "description": "A source-bound narration and typed mutation proposal. Runtime operation validation remains authoritative; sequential `as` aliases and @references are normalized before kernel validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "request_source_id",
    "proposal_id",
    "actor_id",
    "expected_head",
    "player_input_sha256",
    "audience_id",
    "narration_source_id",
    "narration",
    "revealed_assertion_ids",
    "operations"
  ],
  "properties": {
    "schema": {
      "const": "lacuna.turn-proposal.v2"
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "request_source_id": {
      "$ref": "#/$defs/id"
    },
    "proposal_id": {
      "$ref": "#/$defs/id"
    },
    "actor_id": {
      "$ref": "#/$defs/id"
    },
    "expected_head": {
      "$ref": "#/$defs/sha256"
    },
    "player_input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "audience_id": {
      "$ref": "#/$defs/id"
    },
    "narration_source_id": {
      "$ref": "#/$defs/id"
    },
    "narration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    },
    "revealed_assertion_ids": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/idOrAlias"
      }
    },
    "operations": {
      "type": "array",
      "maxItems": 999,
      "items": {
        "type": "object",
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "enum": [
              "add_source",
              "assign_world",
              "close_question",
              "create_world",
              "declare_cardinality",
              "declare_claim",
              "declare_relation",
              "link_consequence",
              "link_evidence",
              "open_question",
              "raise_commitment",
              "reconcile_particle_bank",
              "record_assertion",
              "register_agent",
              "replace_consequence",
              "retire_cardinality",
              "retire_consequence",
              "retire_relation",
              "revise_world",
              "set_world_status",
              "set_world_weight",
              "supersede_assertion",
              "update_particle_bank"
            ]
          },
          "as": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,63}$"
          }
        },
        "additionalProperties": true
      }
    },
    "message": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "idOrAlias": {
      "type": "string",
      "pattern": "^(?:[A-Za-z][A-Za-z0-9._:-]{0,127}|@[A-Za-z][A-Za-z0-9._:-]{0,63})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
