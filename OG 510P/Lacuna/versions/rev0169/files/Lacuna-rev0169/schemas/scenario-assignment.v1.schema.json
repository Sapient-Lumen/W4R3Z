{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-assignment-v1",
  "title": "Private comparative scenario condition assignment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "run_id",
    "capsule_id",
    "method",
    "randomization_seed",
    "assignments",
    "created_at",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.assignment"
    },
    "schema": {
      "const": "lacuna.scenario-assignment.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "capsule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "method": {
      "enum": [
        "host-random-seed-sha256-sort-v1",
        "bundle-precommitted-seed-sha256-sort-v1"
      ]
    },
    "randomization_seed": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assignments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "cell_label",
          "condition"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "cell_label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "condition": {
            "enum": [
              "forward-only",
              "prompt-only-retcon",
              "lacuna-serial",
              "lacuna-role-separated"
            ]
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
