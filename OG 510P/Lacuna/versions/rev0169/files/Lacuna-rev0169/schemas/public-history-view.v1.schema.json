{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:public-history-view:v1",
  "title": "Lacuna public history least-context view v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "project_version",
    "history_id",
    "cube_id",
    "audience_id",
    "entry_count",
    "public_entries_sha256",
    "public_entries",
    "operating_instructions",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.public-history.projected"
    },
    "schema": {
      "const": "lacuna.public-history-view.v1"
    },
    "project_version": {
      "type": "string",
      "minLength": 1
    },
    "history_id": {
      "$ref": "#/$defs/id"
    },
    "cube_id": {
      "$ref": "#/$defs/id"
    },
    "audience_id": {
      "$ref": "#/$defs/id"
    },
    "entry_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "public_entries_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "public_entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turn_index",
          "input_kind",
          "player_input",
          "narration"
        ],
        "properties": {
          "turn_index": {
            "type": "integer",
            "minimum": 1
          },
          "input_kind": {
            "enum": [
              "play-turn",
              "session-control"
            ]
          },
          "player_input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "narration": {
            "type": "string",
            "maxLength": 200000
          }
        }
      }
    },
    "operating_instructions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
