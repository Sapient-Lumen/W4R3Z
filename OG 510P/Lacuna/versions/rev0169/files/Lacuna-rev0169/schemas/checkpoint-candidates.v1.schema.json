{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:checkpoint-candidates:v1",
  "title": "Lacuna retcon checkpoint candidates v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "checkpoint_id",
    "request_sha256",
    "candidates",
    "generation_notes",
    "nonclaims"
  ],
  "properties": {
    "schema": {
      "const": "lacuna.checkpoint-candidates.v1"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "checkpoint_id": {
      "$ref": "#/$defs/id"
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "title",
          "hypothesis_card",
          "story_so_far_explanation",
          "future_arc_summary",
          "preserved_unknown_ids",
          "promoted_incidental_details",
          "commitment_risks",
          "fair_play_risks",
          "identity_drift_risks",
          "rollout",
          "provenance"
        ],
        "properties": {
          "candidate_id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "hypothesis_card": {
            "type": "string",
            "minLength": 1
          },
          "story_so_far_explanation": {
            "type": "string",
            "minLength": 1
          },
          "future_arc_summary": {
            "type": "string",
            "minLength": 1
          },
          "preserved_unknown_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "promoted_incidental_details": {
            "$ref": "#/$defs/stringList"
          },
          "commitment_risks": {
            "$ref": "#/$defs/stringList"
          },
          "fair_play_risks": {
            "$ref": "#/$defs/stringList"
          },
          "identity_drift_risks": {
            "$ref": "#/$defs/stringList"
          },
          "rollout": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "horizon_turns",
              "turns",
              "summary"
            ],
            "properties": {
              "horizon_turns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "turns": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        }
      }
    },
    "generation_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "nonclaims": {
      "$ref": "#/$defs/stringList"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "model_version",
        "invocation_id",
        "notes"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
