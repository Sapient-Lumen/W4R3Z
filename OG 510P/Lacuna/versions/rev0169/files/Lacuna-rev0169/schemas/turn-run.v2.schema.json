{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lacuna.invalid/schema/turn-run.v2.schema.json",
  "title": "Lacuna request-scoped turn run manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "project_version",
    "run_id",
    "run_path",
    "created_at",
    "updated_at",
    "reference",
    "resolved_cube_path",
    "cube_id",
    "requested_mode",
    "selected_mode",
    "include_planner_context_on_commit",
    "status",
    "turn_identity",
    "artifacts",
    "next_action",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.turn.run"
    },
    "schema": {
      "const": "lacuna.turn-run.v2"
    },
    "project_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "run_path": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "resolved_cube_path": {
      "type": "string",
      "minLength": 1
    },
    "cube_id": {
      "$ref": "#/$defs/id"
    },
    "requested_mode": {
      "enum": [
        "auto",
        "solo",
        "pair",
        "full"
      ]
    },
    "selected_mode": {
      "enum": [
        "solo",
        "pair",
        "full"
      ]
    },
    "include_planner_context_on_commit": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "awaiting-solo-proposal",
        "awaiting-planner",
        "awaiting-narrator",
        "awaiting-pair-proposal",
        "awaiting-proposal-builder",
        "awaiting-verifier",
        "verifier-refused",
        "ready-to-commit",
        "committed"
      ]
    },
    "turn_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_source_id",
        "proposal_id",
        "expected_head",
        "player_input_sha256",
        "packet_sha256"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "request_source_id": {
          "$ref": "#/$defs/id"
        },
        "proposal_id": {
          "$ref": "#/$defs/id"
        },
        "expected_head": {
          "$ref": "#/$defs/sha256"
        },
        "player_input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "packet_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player_input",
        "packet",
        "plan",
        "planner_card",
        "planner_return",
        "narrator_card",
        "narrator_return",
        "proposal_builder_card",
        "proposal_draft",
        "proposal",
        "preparation",
        "verifier_card",
        "verifier_return",
        "receipt"
      ],
      "properties": {
        "player_input": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "packet": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "plan": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "planner_card": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "planner_return": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "narrator_card": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "narrator_return": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "proposal_builder_card": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "proposal_draft": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "proposal": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "preparation": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "verifier_card": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "verifier_return": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "receipt": {
          "$ref": "#/$defs/nullableArtifact"
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "action",
        "input_path",
        "expected_schema",
        "command",
        "player_visibility"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "input_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "player_visibility": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "media_type",
        "schema",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "nullableArtifact": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/artifact"
        }
      ]
    }
  }
}
