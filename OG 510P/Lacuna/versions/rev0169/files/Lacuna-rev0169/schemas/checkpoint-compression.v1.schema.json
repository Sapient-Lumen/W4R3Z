{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:checkpoint-compression:v1",
  "title": "Lacuna bounded retcon checkpoint compression v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "checkpoint_id",
    "request_sha256",
    "candidates_sha256",
    "judgment_sha256",
    "selected_candidate_id",
    "state_card",
    "retained_elements",
    "omitted_elements",
    "preserved_unknown_ids",
    "forbidden_contradictions",
    "next_pressures",
    "narration",
    "operations",
    "message",
    "nonclaims"
  ],
  "properties": {
    "schema": {
      "const": "lacuna.checkpoint-compression.v1"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "checkpoint_id": {
      "$ref": "#/$defs/id"
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidates_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "judgment_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "selected_candidate_id": {
      "$ref": "#/$defs/id"
    },
    "state_card": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "retained_elements": {
      "$ref": "#/$defs/stringList"
    },
    "omitted_elements": {
      "$ref": "#/$defs/stringList"
    },
    "preserved_unknown_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "forbidden_contradictions": {
      "$ref": "#/$defs/stringList"
    },
    "next_pressures": {
      "$ref": "#/$defs/stringList"
    },
    "narration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    },
    "operations": {
      "type": "array",
      "maxItems": 99,
      "items": {
        "type": "object"
      }
    },
    "message": {
      "type": "string",
      "maxLength": 4096
    },
    "nonclaims": {
      "$ref": "#/$defs/stringList"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "model_version",
        "invocation_id",
        "notes"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
