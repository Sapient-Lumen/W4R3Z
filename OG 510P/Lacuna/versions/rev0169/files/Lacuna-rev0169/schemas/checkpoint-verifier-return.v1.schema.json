{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:checkpoint-verifier-return:v1",
  "title": "Lacuna anti-rubber-reality checkpoint verifier return v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "checkpoint_id",
    "request_sha256",
    "proposal_sha256",
    "status",
    "checks",
    "findings",
    "recommended_action",
    "nonclaims"
  ],
  "properties": {
    "schema": {
      "const": "lacuna.checkpoint-verifier-return.v1"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "checkpoint_id": {
      "$ref": "#/$defs/id"
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "proposal_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": [
        "pass",
        "refuse"
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_canon_untouched",
        "exposed_consequences_respected",
        "fair_play_evidence_not_retconned",
        "all_existing_unknowns_preserved",
        "selection_evidence_internally_consistent",
        "compression_within_budget",
        "custody_source_exact",
        "operation_surface_within_checkpoint_grant",
        "narration_does_not_present_hidden_state_as_observation"
      ],
      "properties": {
        "observed_canon_untouched": {
          "type": "boolean"
        },
        "exposed_consequences_respected": {
          "type": "boolean"
        },
        "fair_play_evidence_not_retconned": {
          "type": "boolean"
        },
        "all_existing_unknowns_preserved": {
          "type": "boolean"
        },
        "selection_evidence_internally_consistent": {
          "type": "boolean"
        },
        "compression_within_budget": {
          "type": "boolean"
        },
        "custody_source_exact": {
          "type": "boolean"
        },
        "operation_surface_within_checkpoint_grant": {
          "type": "boolean"
        },
        "narration_does_not_present_hidden_state_as_observation": {
          "type": "boolean"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "code",
          "message",
          "evidence_paths"
        ],
        "properties": {
          "severity": {
            "enum": [
              "info",
              "warning",
              "blocking"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "evidence_paths": {
            "$ref": "#/$defs/stringList"
          }
        }
      }
    },
    "recommended_action": {
      "enum": [
        "commit",
        "refuse",
        "regenerate"
      ]
    },
    "nonclaims": {
      "$ref": "#/$defs/stringList"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "model_version",
        "invocation_id",
        "notes"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
