{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:checkpoint-run-agent-dispatch:v1",
  "title": "Lacuna managed checkpoint least-context agent dispatch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "run_id",
    "run_path",
    "status",
    "checkpoint_id",
    "task_id",
    "provider",
    "role",
    "agent_name",
    "input_card_sha256",
    "input_card",
    "return_contract",
    "invocation_contract",
    "instructions",
    "authority",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.checkpoint.run.agent-dispatch"
    },
    "schema": {
      "const": "lacuna.checkpoint-run-agent-dispatch.v1"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "run_path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "awaiting-generator",
        "awaiting-judge",
        "awaiting-compressor",
        "awaiting-verifier"
      ]
    },
    "checkpoint_id": {
      "$ref": "#/$defs/id"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "provider": {
      "enum": [
        "portable",
        "codex",
        "claude-code",
        "gemini-cli",
        "chatgpt"
      ]
    },
    "role": {
      "enum": [
        "lacuna-retcon-generator",
        "lacuna-retcon-judge",
        "lacuna-retcon-compressor",
        "lacuna-retcon-verifier"
      ]
    },
    "agent_name": {
      "type": "string",
      "minLength": 1
    },
    "input_card_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_card": {
      "type": "object",
      "required": [
        "event",
        "schema",
        "role",
        "task_id",
        "checkpoint_id",
        "output_contract",
        "authority"
      ],
      "properties": {
        "event": {
          "const": "lacuna.checkpoint.tasked"
        },
        "schema": {
          "const": "lacuna.checkpoint-task-card.v1"
        },
        "role": {
          "enum": [
            "lacuna-retcon-generator",
            "lacuna-retcon-judge",
            "lacuna-retcon-compressor",
            "lacuna-retcon-verifier"
          ]
        },
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "checkpoint_id": {
          "$ref": "#/$defs/id"
        },
        "output_contract": {
          "type": "object"
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "worker_may",
            "worker_may_not",
            "parent_only"
          ],
          "properties": {
            "worker_may": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "worker_may_not": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "parent_only": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "return_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "format",
        "save_path",
        "accept_command"
      ],
      "properties": {
        "schema": {
          "enum": [
            "lacuna.checkpoint-candidates.v1",
            "lacuna.checkpoint-judgment.v1",
            "lacuna.checkpoint-compression.v1",
            "lacuna.checkpoint-verifier-return.v1"
          ]
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "save_path": {
          "type": "string",
          "minLength": 1
        },
        "accept_command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "invocation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration",
        "accepted_command_records",
        "failure_command"
      ],
      "properties": {
        "declaration": {
          "const": "host-declared"
        },
        "accepted_command_records": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "instructions": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_may",
        "worker_may_not",
        "parent_only"
      ],
      "properties": {
        "worker_may": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "worker_may_not": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parent_only": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
