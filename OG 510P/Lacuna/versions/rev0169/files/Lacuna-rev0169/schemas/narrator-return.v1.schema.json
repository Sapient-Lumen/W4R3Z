{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:narrator-return:v1",
  "title": "Lacuna narrator return v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "request_id",
    "packet_sha256",
    "planner_return_sha256",
    "narration",
    "directly_observable_facts"
  ],
  "properties": {
    "schema": {"const": "lacuna.narrator-return.v1"},
    "task_id": {"$ref": "#/$defs/id"},
    "request_id": {"$ref": "#/$defs/id"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "planner_return_sha256": {"$ref": "#/$defs/sha256"},
    "narration": {"type": "string", "minLength": 1, "maxLength": 50000},
    "directly_observable_facts": {
      "type": "array",
      "maxItems": 500,
      "items": {"type": "string", "minLength": 1, "maxLength": 10000}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
