{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-bundle-schedule-v1",
  "title": "Lacuna private scenario bundle schedule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "bundle_id",
    "method",
    "randomization_seed",
    "blocks",
    "created_at",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.bundle.schedule"
    },
    "schema": {
      "const": "lacuna.scenario-bundle-schedule.v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "method": {
      "const": "host-random-seed-sha256-sort-v1"
    },
    "randomization_seed": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "block_id",
          "block_label",
          "scenario_run_id",
          "assignment_seed"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "block_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "block_label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "scenario_run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "assignment_seed": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 2,
      "maxItems": 128
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "nonclaims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3
    }
  }
}
