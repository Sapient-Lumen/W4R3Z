{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lacuna.invalid/schema/turn-receipt.v3.schema.json",
  "title": "Lacuna turn receipt v3",
  "description": "A committed turn receipt bound to one exact rollback preparation. Delivery records whether the sidecar transition was direct or crash-recovered.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "overall_status",
    "cube_id",
    "preparation_sha256",
    "prepared_at",
    "request_id",
    "request_source_id",
    "request_head",
    "player_input_sha256",
    "proposal_id",
    "actor_id",
    "audience_id",
    "access_mode",
    "write_grant",
    "narration_source_id",
    "narration_sha256",
    "narration",
    "revealed_assertion_ids",
    "bindings",
    "change",
    "head",
    "audience_context",
    "planner_context",
    "delivery",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.turn.committed"
    },
    "schema": {
      "const": "lacuna.turn-receipt.v3"
    },
    "overall_status": {
      "const": "pass"
    },
    "cube_id": {
      "$ref": "#/$defs/id"
    },
    "preparation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "prepared_at": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "request_source_id": {
      "$ref": "#/$defs/id"
    },
    "request_head": {
      "$ref": "#/$defs/sha256"
    },
    "player_input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "proposal_id": {
      "$ref": "#/$defs/id"
    },
    "actor_id": {
      "$ref": "#/$defs/id"
    },
    "audience_id": {
      "$ref": "#/$defs/id"
    },
    "access_mode": {
      "enum": [
        "audience",
        "director"
      ]
    },
    "write_grant": {
      "$ref": "#/$defs/grant"
    },
    "narration_source_id": {
      "$ref": "#/$defs/id"
    },
    "narration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "narration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    },
    "revealed_assertion_ids": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/id"
      }
    },
    "change": {
      "$ref": "#/$defs/changeReceipt"
    },
    "head": {
      "$ref": "#/$defs/sha256"
    },
    "audience_context": {
      "type": "object"
    },
    "planner_context": {
      "type": [
        "object",
        "null"
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "materialized_at",
        "historical_snapshot_used"
      ],
      "properties": {
        "mode": {
          "enum": [
            "direct",
            "recovered"
          ]
        },
        "materialized_at": {
          "type": "string",
          "minLength": 1
        },
        "historical_snapshot_used": {
          "type": "boolean"
        }
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profile",
        "allowed_operations",
        "allow_anchored_assertions",
        "require_audience_visible_writes",
        "world_scope",
        "max_operations",
        "max_reveals"
      ],
      "properties": {
        "schema": {
          "enum": [
            "lacuna.turn-grant.v1",
            "lacuna.turn-grant.v2"
          ]
        },
        "profile": {
          "enum": [
            "audience",
            "director",
            "checkpoint"
          ]
        },
        "allowed_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allow_anchored_assertions": {
          "type": "boolean"
        },
        "require_audience_visible_writes": {
          "type": "boolean"
        },
        "world_scope": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "max_operations": {
          "enum": [
            100,
            999
          ]
        },
        "max_reveals": {
          "enum": [
            0,
            500
          ]
        }
      }
    },
    "changeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "schema",
        "overall_status",
        "cube_id",
        "change_id",
        "actor_id",
        "message",
        "before_head",
        "after_head",
        "operation_count",
        "event_ids",
        "applied_at"
      ],
      "properties": {
        "event": {
          "const": "lacuna.change.applied"
        },
        "schema": {
          "const": "lacuna.change-receipt.v1"
        },
        "overall_status": {
          "const": "pass"
        },
        "cube_id": {
          "$ref": "#/$defs/id"
        },
        "change_id": {
          "$ref": "#/$defs/id"
        },
        "actor_id": {
          "$ref": "#/$defs/id"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "before_head": {
          "$ref": "#/$defs/sha256"
        },
        "after_head": {
          "$ref": "#/$defs/sha256"
        },
        "operation_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "event_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "applied_at": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
