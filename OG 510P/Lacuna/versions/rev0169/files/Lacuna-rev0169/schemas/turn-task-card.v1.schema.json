{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:turn-task-card:v1",
  "title": "Lacuna digest-bound turn task card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "task_id",
    "role",
    "turn_identity",
    "upstream_artifacts",
    "objective",
    "instructions",
    "input",
    "output_contract",
    "information_boundary",
    "forbidden_actions",
    "may_commit",
    "nonclaim"
  ],
  "properties": {
    "event": {"const": "lacuna.turn.task-carded"},
    "schema": {"const": "lacuna.turn-task-card.v1"},
    "task_id": {"$ref": "#/$defs/id"},
    "role": {
      "enum": ["lacuna-planner", "lacuna-narrator", "lacuna-proposal-builder", "lacuna-verifier"]
    },
    "turn_identity": {"$ref": "#/$defs/identity"},
    "upstream_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "objective": {"type": "string", "minLength": 1},
    "instructions": {"$ref": "#/$defs/stringList"},
    "input": {"type": "object"},
    "output_contract": {"$ref": "#/$defs/outputContract"},
    "information_boundary": {"$ref": "#/$defs/informationBoundary"},
    "forbidden_actions": {"$ref": "#/$defs/stringList"},
    "may_commit": {"const": false},
    "nonclaim": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_source_id",
        "cube_id",
        "expected_head",
        "player_input_sha256",
        "packet_sha256"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/id"},
        "request_source_id": {"$ref": "#/$defs/id"},
        "cube_id": {"$ref": "#/$defs/id"},
        "expected_head": {"$ref": "#/$defs/sha256"},
        "player_input_sha256": {"$ref": "#/$defs/sha256"},
        "packet_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "format", "rules", "template"],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "format": {"const": "exact-json-object"},
        "rules": {"$ref": "#/$defs/stringList"},
        "template": {"type": "object"}
      }
    },
    "informationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "included", "withheld"],
      "properties": {
        "classification": {"type": "string", "minLength": 1},
        "included": {"$ref": "#/$defs/stringList"},
        "withheld": {"$ref": "#/$defs/stringList"}
      }
    }
  }
}
