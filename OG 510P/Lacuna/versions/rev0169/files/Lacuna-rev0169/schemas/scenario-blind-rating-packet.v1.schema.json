{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-blind-rating-packet-v1",
  "title": "Condition-blind comparative scenario rating packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "run_id",
    "capsule_id",
    "title",
    "research_question",
    "created_at",
    "rubric",
    "cells",
    "instructions",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.blind-rating-packet"
    },
    "schema": {
      "const": "lacuna.scenario-blind-rating-packet.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "capsule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rater_count",
        "scale_min",
        "scale_max",
        "dimension_prompts",
        "comments_prompt"
      ],
      "properties": {
        "scale_min": {
          "type": "integer"
        },
        "scale_max": {
          "type": "integer"
        },
        "dimension_prompts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coherence",
            "agency",
            "character_believability",
            "genre_fit",
            "payoff",
            "novelty",
            "coincidence_restraint",
            "mystery_fairness",
            "seam_invisibility"
          ],
          "properties": {
            "coherence": {
              "type": "string",
              "minLength": 1
            },
            "agency": {
              "type": "string",
              "minLength": 1
            },
            "character_believability": {
              "type": "string",
              "minLength": 1
            },
            "genre_fit": {
              "type": "string",
              "minLength": 1
            },
            "payoff": {
              "type": "string",
              "minLength": 1
            },
            "novelty": {
              "type": "string",
              "minLength": 1
            },
            "coincidence_restraint": {
              "type": "string",
              "minLength": 1
            },
            "mystery_fairness": {
              "type": "string",
              "minLength": 1
            },
            "seam_invisibility": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "comments_prompt": {
          "type": "string",
          "minLength": 1
        },
        "rater_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_label",
          "status",
          "transcript",
          "transcript_sha256"
        ],
        "properties": {
          "cell_label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "status": {
            "enum": [
              "completed",
              "refused",
              "failed"
            ]
          },
          "transcript": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step_id",
                "narration"
              ],
              "properties": {
                "step_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
                },
                "narration": {
                  "type": "string",
                  "maxLength": 200000
                }
              }
            }
          },
          "transcript_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
