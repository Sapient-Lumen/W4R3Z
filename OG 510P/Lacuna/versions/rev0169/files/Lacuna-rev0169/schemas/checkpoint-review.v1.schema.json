{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:checkpoint-review:v1",
  "title": "Lacuna exact kernel checkpoint review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "reviewed_at",
    "checkpoint_id",
    "cube_id",
    "request_sha256",
    "candidates_sha256",
    "judgment_sha256",
    "proposal_sha256",
    "verifier_sha256",
    "selection_evidence_sha256",
    "mechanical_status",
    "mechanical_checks",
    "turn_preparation",
    "turn_preparation_sha256",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.checkpoint.reviewed"
    },
    "schema": {
      "const": "lacuna.checkpoint-review.v1"
    },
    "reviewed_at": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_id": {
      "$ref": "#/$defs/id"
    },
    "cube_id": {
      "$ref": "#/$defs/id"
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidates_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "judgment_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "proposal_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "verifier_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "selection_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "mechanical_status": {
      "const": "pass"
    },
    "mechanical_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_bound_checkpoint_grant",
        "artifact_digest_chain",
        "deterministic_candidate_selection",
        "compression_budget",
        "unknown_preservation",
        "selection_custody_source",
        "turn_binding_preflight",
        "kernel_exact_rollback_preparation"
      ],
      "properties": {
        "source_bound_checkpoint_grant": {
          "const": true
        },
        "artifact_digest_chain": {
          "const": true
        },
        "deterministic_candidate_selection": {
          "const": true
        },
        "compression_budget": {
          "const": true
        },
        "unknown_preservation": {
          "const": true
        },
        "selection_custody_source": {
          "const": true
        },
        "turn_binding_preflight": {
          "const": true
        },
        "kernel_exact_rollback_preparation": {
          "const": true
        }
      }
    },
    "turn_preparation": {
      "type": "object"
    },
    "turn_preparation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "nonclaims": {
      "$ref": "#/$defs/stringList"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "model_version",
        "invocation_id",
        "notes"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
