{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-bundle-report-v2",
  "title": "Lacuna unblinded scenario bundle report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "bundle_id",
    "title",
    "research_question",
    "commitment_sha256",
    "witness_artifact_sha256s",
    "registration",
    "block_records",
    "observations",
    "descriptive_summary",
    "unblinded_at",
    "separation",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.bundle.unblinded"
    },
    "schema": {
      "const": "lacuna.scenario-bundle-report.v2"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "commitment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "witness_artifact_sha256s": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_dimensions",
        "primary_preference_rank",
        "block_inclusion",
        "terminal_failures",
        "analysis_unit",
        "ordinal_policy",
        "analysis_notes"
      ],
      "properties": {
        "primary_dimensions": {
          "type": "array",
          "items": {
            "enum": [
              "coherence",
              "agency",
              "character_believability",
              "genre_fit",
              "payoff",
              "novelty",
              "coincidence_restraint",
              "mystery_fairness",
              "seam_invisibility"
            ]
          },
          "minItems": 1,
          "maxItems": 9
        },
        "primary_preference_rank": {
          "const": true
        },
        "block_inclusion": {
          "const": "all-scheduled-blocks"
        },
        "terminal_failures": {
          "const": "include"
        },
        "analysis_unit": {
          "const": "rater-by-condition-within-block"
        },
        "ordinal_policy": {
          "const": "retain-integers-and-ranks-no-automatic-interval-or-significance-claim"
        },
        "analysis_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "block_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "block_id",
          "story_stratum",
          "model_stratum",
          "replicate",
          "scenario_run_id",
          "capsule_sha256",
          "assignment_sha256",
