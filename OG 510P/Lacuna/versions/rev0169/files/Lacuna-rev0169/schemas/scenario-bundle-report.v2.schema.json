            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "scenario_report_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rater_count": {
            "type": "integer",
            "minimum": 1
          },
          "included": {
            "const": true
          }
