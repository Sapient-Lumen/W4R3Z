{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:public-history:v1",
  "title": "Lacuna public history v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "project_version",
    "history_id",
    "cube_id",
    "audience_id",
    "coverage",
    "public_entries",
    "source_custody",
    "operating_instructions",
    "excluded_by_design",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.public-history.compiled"
    },
    "schema": {
      "const": "lacuna.public-history.v1"
    },
    "project_version": {
      "type": "string",
      "minLength": 1
    },
    "history_id": {
      "$ref": "#/$defs/id"
    },
    "cube_id": {
      "$ref": "#/$defs/id"
    },
    "audience_id": {
      "$ref": "#/$defs/id"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_count",
        "first_request_event_seq",
        "last_commit_event_seq",
        "first_request_head",
        "last_post_commit_head",
        "public_entries_sha256",
        "source_custody_sha256"
      ],
      "properties": {
        "entry_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "first_request_event_seq": {
          "type": "integer",
          "minimum": 1
        },
        "last_commit_event_seq": {
          "type": "integer",
          "minimum": 1
        },
        "first_request_head": {
          "$ref": "#/$defs/sha256"
        },
        "last_post_commit_head": {
          "$ref": "#/$defs/sha256"
        },
        "public_entries_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_custody_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "public_entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turn_index",
          "input_kind",
          "player_input",
          "narration"
        ],
        "properties": {
          "turn_index": {
            "type": "integer",
            "minimum": 1
          },
          "input_kind": {
            "enum": [
              "play-turn",
              "session-control"
            ]
          },
          "player_input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "narration": {
            "type": "string",
            "maxLength": 200000
          }
        }
      }
    },
    "source_custody": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turn_index",
          "run_id",
          "request_id",
          "request_source_id",
          "narration_source_id",
          "proposal_id",
          "actor_id",
          "packet_sha256",
          "receipt_sha256",
          "player_input_sha256",
          "narration_sha256",
          "request_head",
          "post_commit_head",
          "request_event_seq",
          "commit_event_seq"
        ],
        "properties": {
          "turn_index": {
            "type": "integer",
            "minimum": 1
          },
          "run_id": {
            "$ref": "#/$defs/id"
          },
          "request_id": {
            "$ref": "#/$defs/id"
          },
          "request_source_id": {
            "$ref": "#/$defs/id"
          },
          "narration_source_id": {
            "$ref": "#/$defs/id"
          },
          "proposal_id": {
            "$ref": "#/$defs/id"
          },
          "actor_id": {
            "$ref": "#/$defs/id"
          },
          "packet_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "receipt_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "player_input_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "narration_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "request_head": {
            "$ref": "#/$defs/sha256"
          },
          "post_commit_head": {
            "$ref": "#/$defs/sha256"
          },
          "request_event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "commit_event_seq": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "operating_instructions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excluded_by_design": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
