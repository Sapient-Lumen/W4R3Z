{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:cube:v1",
  "title": "Lacuna cube configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "project_version",
    "cube_id",
    "created_at",
    "database"
  ],
  "properties": {
    "schema": {
      "const": "lacuna.cube.v1"
    },
    "project": {
      "const": "Lacuna"
    },
    "project_version": {
      "type": "string",
      "pattern": "^0\\.145\\.[0-9]+$"
    },
    "cube_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "database": {
      "const": "lacuna.sqlite3"
    }
  }
}
