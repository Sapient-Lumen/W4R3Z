{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:checkpoint-run:v1",
  "title": "Lacuna resumable retcon checkpoint run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "project_version",
    "run_id",
    "run_path",
    "created_at",
    "updated_at",
    "reference",
    "resolved_cube_path",
    "cube_id",
    "status",
    "provider_routes",
    "checkpoint_identity",
    "artifacts",
    "invocations",
    "next_action",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.checkpoint.run"
    },
    "schema": {
      "const": "lacuna.checkpoint-run.v1"
    },
    "project_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "run_path": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "resolved_cube_path": {
      "type": "string",
      "minLength": 1
    },
    "cube_id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": [
        "awaiting-generator",
        "awaiting-judge",
        "awaiting-compressor",
        "awaiting-verifier",
        "verifier-refused",
        "ready-to-commit",
        "committed"
      ]
    },
    "provider_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lacuna-retcon-generator",
        "lacuna-retcon-judge",
        "lacuna-retcon-compressor",
        "lacuna-retcon-verifier"
      ],
      "properties": {
        "lacuna-retcon-generator": {
          "enum": [
            "portable",
            "codex",
            "claude-code",
            "gemini-cli",
            "chatgpt"
          ]
        },
        "lacuna-retcon-judge": {
          "enum": [
            "portable",
            "codex",
            "claude-code",
            "gemini-cli",
            "chatgpt"
          ]
        },
        "lacuna-retcon-compressor": {
          "enum": [
            "portable",
            "codex",
            "claude-code",
            "gemini-cli",
            "chatgpt"
          ]
        },
        "lacuna-retcon-verifier": {
          "enum": [
            "portable",
            "codex",
            "claude-code",
            "gemini-cli",
            "chatgpt"
          ]
        }
      }
    },
    "checkpoint_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "expected_head",
        "trigger_sha256",
        "request_sha256",
        "turn_packet_sha256"
      ],
      "properties": {
        "checkpoint_id": {
          "$ref": "#/$defs/id"
        },
        "expected_head": {
          "$ref": "#/$defs/sha256"
        },
        "trigger_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "turn_packet_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "request",
        "generator_card",
        "candidates",
        "judge_card",
        "judgment",
        "compressor_card",
        "compression",
        "proposal",
        "verifier_card",
        "verifier_return",
        "review",
        "receipt"
      ],
      "properties": {
        "trigger": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "request": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "generator_card": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "candidates": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "judge_card": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "judgment": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "compressor_card": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "compression": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "proposal": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "verifier_card": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "verifier_return": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "review": {
          "$ref": "#/$defs/nullableArtifact"
        },
        "receipt": {
          "$ref": "#/$defs/nullableArtifact"
        }
      }
    },
    "invocations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/invocationArtifact"
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "provider",
        "agent_name",
        "action",
        "input_path",
        "expected_schema",
        "command",
        "player_visibility"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "portable",
                "codex",
                "claude-code",
                "gemini-cli",
                "chatgpt"
              ]
            }
          ]
        },
        "agent_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "input_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "player_visibility": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "media_type",
        "schema",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "nullableArtifact": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/artifact"
        }
      ]
    },
    "invocationArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "object",
          "properties": {
            "media_type": {
              "const": "application/json"
            },
            "schema": {
              "const": "lacuna.checkpoint-invocation-receipt.v1"
            },
            "role": {
              "enum": [
                "lacuna-retcon-generator",
                "lacuna-retcon-judge",
                "lacuna-retcon-compressor",
                "lacuna-retcon-verifier"
              ]
            }
          }
        }
      ]
    }
  }
}
