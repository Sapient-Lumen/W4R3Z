{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:checkpoint-proposal:v1",
  "title": "Lacuna assembled source-bound retcon checkpoint proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "checkpoint_id",
    "request_sha256",
    "candidates_sha256",
    "judgment_sha256",
    "compression_sha256",
    "selected_candidate_id",
    "compression_artifact",
    "compression",
    "selection_evidence",
    "selection_evidence_sha256",
    "turn_proposal",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.checkpoint.proposed"
    },
    "schema": {
      "const": "lacuna.checkpoint-proposal.v1"
    },
    "checkpoint_id": {
      "$ref": "#/$defs/id"
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidates_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "judgment_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "compression_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "selected_candidate_id": {
      "$ref": "#/$defs/id"
    },
    "compression_artifact": {
      "type": "object"
    },
    "compression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_chars",
        "char_count",
        "state_card",
        "state_card_sha256",
        "retained_elements",
        "omitted_elements",
        "preserved_unknown_ids",
        "forbidden_contradictions",
        "next_pressures"
      ],
      "properties": {
        "budget_chars": {
          "type": "integer",
          "minimum": 256,
          "maximum": 20000
        },
        "char_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "state_card": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "state_card_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "retained_elements": {
          "$ref": "#/$defs/stringList"
        },
        "omitted_elements": {
          "$ref": "#/$defs/stringList"
        },
        "preserved_unknown_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "forbidden_contradictions": {
          "$ref": "#/$defs/stringList"
        },
        "next_pressures": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "selection_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "checkpoint_id",
        "request_sha256",
        "candidates_sha256",
        "judgment_sha256",
        "selected_candidate_id",
        "selected_candidate_sha256",
        "protected_state_sha256",
        "state_card_sha256"
      ],
      "properties": {
        "schema": {
          "const": "lacuna.checkpoint-selection-evidence.v1"
        },
        "checkpoint_id": {
          "$ref": "#/$defs/id"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidates_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "judgment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selected_candidate_id": {
          "$ref": "#/$defs/id"
        },
        "protected_state_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "state_card_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selected_candidate_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "selection_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "turn_proposal": {
      "type": "object"
    },
    "nonclaims": {
      "$ref": "#/$defs/stringList"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "model_version",
        "invocation_id",
        "notes"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
