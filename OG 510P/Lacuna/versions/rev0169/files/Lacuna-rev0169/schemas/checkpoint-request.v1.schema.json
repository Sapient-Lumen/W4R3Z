{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:checkpoint-request:v1",
  "title": "Lacuna retcon checkpoint request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "checkpoint_id",
    "created_at",
    "cube_id",
    "expected_head",
    "trigger_sha256",
    "turn_packet_sha256",
    "turn_packet",
    "policy",
    "protected_state",
    "protected_state_sha256",
    "workflow",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.checkpoint.requested"
    },
    "schema": {
      "const": "lacuna.checkpoint-request.v1"
    },
    "checkpoint_id": {
      "$ref": "#/$defs/id"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "cube_id": {
      "$ref": "#/$defs/id"
    },
    "expected_head": {
      "$ref": "#/$defs/sha256"
    },
    "trigger_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "turn_packet_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "turn_packet": {
      "type": "object"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "candidate_count",
        "rollout_horizon_turns",
        "compression_max_chars",
        "max_operations",
        "score_dimensions",
        "score_weights",
        "selection_rule",
        "blind_judging",
        "preserve_all_existing_unknowns",
        "forbid_observed_canon_mutation",
        "forbid_aesthetic_particle_weighting"
      ],
      "properties": {
        "schema": {
          "const": "lacuna.checkpoint-policy.v1"
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "rollout_horizon_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "compression_max_chars": {
          "type": "integer",
          "minimum": 256,
          "maximum": 20000
        },
        "max_operations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "score_dimensions": {
          "const": [
            "coherence",
            "player_agency",
            "genre_fit",
            "character_believability",
            "payoff_density",
            "novelty",
            "coincidence_sanity"
          ]
        },
        "score_weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coherence",
            "player_agency",
            "genre_fit",
            "character_believability",
            "payoff_density",
            "novelty",
            "coincidence_sanity"
          ],
          "properties": {
            "coherence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "player_agency": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "genre_fit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "character_believability": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "payoff_density": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "novelty": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "coincidence_sanity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "selection_rule": {
          "const": "highest-weighted-eligible-then-lexicographic-candidate-id"
        },
        "blind_judging": {
          "const": true
        },
        "preserve_all_existing_unknowns": {
          "const": true
        },
        "forbid_observed_canon_mutation": {
          "const": true
        },
        "forbid_aesthetic_particle_weighting": {
          "const": true
        }
      }
    },
    "protected_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "audience_assertions",
        "anchors",
        "cross_world_consensus",
        "fair_play_seals",
        "claim_relations",
        "cardinality_constraints",
        "consequence_links",
        "revision_guards",
        "open_questions",
        "unsettled_claims",
        "unknown_ids"
      ],
      "properties": {
        "schema": {
          "const": "lacuna.checkpoint-protected-state.v1"
        },
        "audience_assertions": {
          "type": "array"
        },
        "anchors": {
          "type": "array"
        },
        "cross_world_consensus": {
          "type": "array"
        },
        "fair_play_seals": {
          "type": "array"
        },
        "claim_relations": {
          "type": "array"
        },
        "cardinality_constraints": {
          "type": "array"
        },
        "consequence_links": {
          "type": "array"
        },
        "revision_guards": {
          "type": "array"
        },
        "open_questions": {
          "type": "array"
        },
        "unsettled_claims": {
          "type": "array"
        },
        "unknown_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "protected_state_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "workflow": {
      "type": "object"
    },
    "nonclaims": {
      "$ref": "#/$defs/stringList"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "model_version",
        "invocation_id",
        "notes"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
