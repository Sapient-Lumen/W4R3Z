{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-report-v1",
  "title": "Unblinded descriptive comparative scenario report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "run_id",
    "capsule_id",
    "title",
    "research_question",
    "assignment_sha256",
    "blind_packet_sha256",
    "rating_artifact_sha256s",
    "cell_records",
    "mechanical_outcomes",
    "human_rating_summary",
    "unblinded_at",
    "separation",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.unblinded"
    },
    "schema": {
      "const": "lacuna.scenario-report.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "capsule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "assignment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blind_packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rating_artifact_sha256s": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "cell_records": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition",
          "cell_label",
          "status",
          "transcript_sha256",
          "return_sha256",
          "receipt_sha256"
        ],
        "properties": {
          "condition": {
            "enum": [
              "forward-only",
              "prompt-only-retcon",
              "lacuna-serial",
              "lacuna-role-separated"
            ]
          },
          "cell_label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "status": {
            "enum": [
              "completed",
              "refused",
              "failed"
            ]
          },
          "transcript_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "return_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "mechanical_outcomes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition",
          "cell_label",
          "final_head",
          "event_count_delta",
          "execution_totals"
        ],
        "properties": {
          "condition": {
            "enum": [
              "forward-only",
              "prompt-only-retcon",
              "lacuna-serial",
              "lacuna-role-separated"
            ]
          },
          "cell_label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "final_head": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "event_count_delta": {
            "type": "integer",
            "minimum": 0
          },
          "execution_totals": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "invocation_count",
              "accepted_invocations",
              "failed_invocations",
              "duration_ms",
              "duration_complete",
              "input_tokens",
              "input_tokens_complete",
              "output_tokens",
              "output_tokens_complete",
              "cost_microusd",
              "cost_complete"
            ],
            "properties": {
              "invocation_count": {
                "type": "integer",
                "minimum": 0
              },
              "accepted_invocations": {
                "type": "integer",
                "minimum": 0
              },
              "failed_invocations": {
                "type": "integer",
                "minimum": 0
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0
              },
              "duration_complete": {
                "type": "boolean"
              },
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "input_tokens_complete": {
                "type": "boolean"
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens_complete": {
                "type": "boolean"
              },
              "cost_microusd": {
                "type": "integer",
                "minimum": 0
              },
              "cost_complete": {
                "type": "boolean"
              }
            }
          }
        }
      }
