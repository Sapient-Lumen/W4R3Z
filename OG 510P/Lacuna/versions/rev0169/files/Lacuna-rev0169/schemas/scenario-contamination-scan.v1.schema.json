{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-contamination-scan-v1",
  "title": "Authenticated preregistered scenario contamination scan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "run_id",
    "capsule_id",
    "plan_sha256",
    "assignment_sha256",
    "scan_scope",
    "file_count",
    "byte_count",
    "file_manifest_sha256",
    "unexpected_matches",
    "cell_summaries",
    "overall_status",
    "scanned_at",
    "instructions",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.contamination-scanned"
    },
    "schema": {
      "const": "lacuna.scenario-contamination-scan.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "capsule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assignment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scan_scope": {
      "const": "scenario-cell-complete-retained-artifacts-v1"
    },
    "file_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20000
    },
    "byte_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1073741824
    },
    "file_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unexpected_matches": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canary_id",
          "owner_cell_label",
          "observed_cell_label",
          "scope",
          "path",
          "match_surface",
          "classification",
          "occurrence_count"
        ],
        "properties": {
          "canary_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "owner_cell_label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "observed_cell_label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "scope": {
            "enum": [
              "operator-only",
              "filesystem-only"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "match_surface": {
            "enum": [
              "content",
              "relative-path"
            ]
          },
          "classification": {
            "enum": [
              "same-cell-leak",
              "cross-cell-leak"
            ]
          },
          "occurrence_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          }
        }
      }
    },
    "cell_summaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_label",
          "status",
          "own_canary_leaks",
          "foreign_canary_leaks",
          "unexpected_match_count",
          "canary_ids"
        ],
        "properties": {
          "cell_label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "status": {
            "enum": [
              "clean",
              "leak-detected"
            ]
          },
          "own_canary_leaks": {
            "type": "integer",
            "minimum": 0
          },
          "foreign_canary_leaks": {
            "type": "integer",
            "minimum": 0
          },
          "unexpected_match_count": {
            "type": "integer",
            "minimum": 0
          },
          "canary_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            }
          }
        }
      }
    },
    "overall_status": {
      "enum": [
        "clean",
        "leak-detected"
      ]
    },
    "scanned_at": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
