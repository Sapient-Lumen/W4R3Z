{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-contamination-plan-v1",
  "title": "Private preregistered scenario contamination plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "run_id",
    "capsule_id",
    "assignment_sha256",
    "method",
    "canaries",
    "scan_policy",
    "created_at",
    "instructions",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.contamination-planned"
    },
    "schema": {
      "const": "lacuna.scenario-contamination-plan.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "capsule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "assignment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "method": {
      "const": "sha256-domain-separated-exact-canaries-v1"
    },
    "canaries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canary_id",
          "cell_label",
          "scope",
          "token",
          "token_sha256",
          "source_paths",
          "expected_absent_from"
        ],
        "properties": {
          "canary_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "cell_label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "scope": {
            "enum": [
              "operator-only",
              "filesystem-only"
            ]
          },
          "token": {
            "type": "string",
            "pattern": "^LACUNA_CANARY_(OPERATOR_ONLY|FILESYSTEM_ONLY)_[0-9A-F]{40}$"
          },
          "token_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_absent_from": {
            "const": "all other retained file contents and relative pathnames under cells/"
          }
        }
      }
    },
    "scan_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "root",
        "case_sensitive",
        "max_files",
        "max_member_bytes",
        "max_total_bytes"
      ],
      "properties": {
        "scope": {
          "const": "scenario-cell-complete-retained-artifacts-v1"
        },
        "root": {
          "const": "cells"
        },
        "case_sensitive": {
          "const": true
        },
        "max_files": {
          "const": 20000
        },
        "max_member_bytes": {
          "const": 67108864
        },
        "max_total_bytes": {
          "const": 1073741824
        }
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
