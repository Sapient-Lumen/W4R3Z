{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-bundle-block-seal-v2",
  "title": "Lacuna scenario bundle blinded block seal v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "bundle_id",
    "block_id",
    "block_label",
    "ordinal",
    "scenario_run_id",
    "scenario_run_path",
    "capsule_sha256",
    "assignment_sha256",
    "blind_packet_sha256",
    "contamination_scan_sha256",
    "rating_artifact_sha256s",
    "sealed_at",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.bundle.block-sealed"
    },
    "schema": {
      "const": "lacuna.scenario-bundle-block-seal.v2"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "block_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "block_label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "scenario_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "scenario_run_path": {
      "type": "string",
      "minLength": 1
    },
    "capsule_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assignment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blind_packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contamination_scan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rating_artifact_sha256s": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 1
    },
    "sealed_at": {
      "type": "string",
      "minLength": 1
    },
    "nonclaims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2
    }
  }
}
