{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:seal-opening:v1",
  "title": "Lacuna fair-play seal opening v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "scheme",
    "cube_id",
    "seal_id",
    "commitment_sha256",
    "nonce",
    "payload",
    "custody_warning"
  ],
  "properties": {
    "event": {
      "const": "lacuna.seal.opening.prepared"
    },
    "schema": {
      "const": "lacuna.seal-opening.v1"
    },
    "scheme": {
      "const": "lacuna.salted-sha256-json.v1"
    },
    "cube_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "seal_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "commitment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "$ref": "#/$defs/portableJson"
    },
    "custody_warning": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "portableJson": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/portableJson"
          }
        },
        {
          "type": "object",
          "maxProperties": 10000,
          "propertyNames": {
            "pattern": "^[^\\uD800-\\uDFFF]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/portableJson"
          }
        }
      ]
    }
  }
}
