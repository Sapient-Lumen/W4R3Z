{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:turn-request:v4",
  "title": "Lacuna source-bound purpose-typed turn request v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "request_id",
    "request_source_id",
    "cube_id",
    "expected_head",
    "created_at",
    "player_input_sha256",
    "input_trust",
    "input_kind",
    "request_purpose",
    "audience_id",
    "actor_id",
    "access_mode",
    "player_input",
    "write_grant",
    "audience_context",
    "planner_context",
    "response_contract",
    "nonclaim"
  ],
  "properties": {
    "event": {
      "const": "lacuna.turn.requested"
    },
    "schema": {
      "const": "lacuna.turn-request.v4"
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "request_source_id": {
      "$ref": "#/$defs/id"
    },
    "cube_id": {
      "$ref": "#/$defs/id"
    },
    "expected_head": {
      "$ref": "#/$defs/sha256"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "player_input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_trust": {
      "const": "untrusted-player-data"
    },
    "input_kind": {
      "enum": [
        "play-turn",
        "session-control"
      ]
    },
    "request_purpose": {
      "enum": [
        "play",
        "checkpoint"
      ]
    },
    "audience_id": {
      "$ref": "#/$defs/id"
    },
    "actor_id": {
      "$ref": "#/$defs/id"
    },
    "access_mode": {
      "enum": [
        "audience",
        "director"
      ]
    },
    "player_input": {
      "type": "string",
      "maxLength": 50000
    },
    "write_grant": {
      "$ref": "#/$defs/writeGrant"
    },
    "audience_context": {
      "type": "object"
    },
    "planner_context": {
      "type": [
        "object",
        "null"
      ]
    },
    "response_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "allowed_operations",
        "prebound_aliases",
        "rules",
        "proposal_template"
      ],
      "properties": {
        "schema": {
          "const": "lacuna.turn-proposal.v2"
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "prebound_aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proposal_template": {
          "type": "object"
        }
      }
    },
    "nonclaim": {
      "type": "string"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "writeGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profile",
        "allowed_operations",
        "allow_anchored_assertions",
        "require_audience_visible_writes",
        "world_scope",
        "max_operations",
        "max_reveals"
      ],
      "properties": {
        "schema": {
          "const": "lacuna.turn-grant.v2"
        },
        "profile": {
          "enum": [
            "audience",
            "director",
            "checkpoint"
          ]
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "allow_anchored_assertions": {
          "type": "boolean"
        },
        "require_audience_visible_writes": {
          "type": "boolean"
        },
        "world_scope": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_operations": {
          "enum": [
            100,
            999
          ]
        },
        "max_reveals": {
          "enum": [
            0,
            500
          ]
        }
      }
    }
  }
}
