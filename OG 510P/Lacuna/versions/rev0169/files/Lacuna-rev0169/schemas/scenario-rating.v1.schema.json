{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-rating-v1",
  "title": "Authored blind comparative scenario rating v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "run_id",
    "capsule_id",
    "rating_id",
    "rater_id",
    "blind_packet_sha256",
    "ratings",
    "declared_at",
    "declaration",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.rating"
    },
    "schema": {
      "const": "lacuna.scenario-rating.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "capsule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "rating_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "rater_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "blind_packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ratings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_label",
          "scores",
          "preference_rank",
          "comments"
        ],
        "properties": {
          "cell_label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "coherence",
              "agency",
              "character_believability",
              "genre_fit",
              "payoff",
              "novelty",
              "coincidence_restraint",
              "mystery_fairness",
              "seam_invisibility"
            ],
            "properties": {
              "coherence": {
                "type": "integer"
              },
              "agency": {
                "type": "integer"
              },
              "character_believability": {
                "type": "integer"
              },
              "genre_fit": {
                "type": "integer"
              },
              "payoff": {
                "type": "integer"
              },
              "novelty": {
                "type": "integer"
              },
              "coincidence_restraint": {
                "type": "integer"
              },
              "mystery_fairness": {
                "type": "integer"
              },
              "seam_invisibility": {
                "type": "integer"
              }
            }
          },
          "preference_rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "comments": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "declared_at": {
      "type": "string",
      "minLength": 1
    },
    "declaration": {
      "const": "blind-packet-only"
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
