{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:orchestration-plan:v1",
  "title": "Lacuna turn orchestration plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "request_id",
    "request_source_id",
    "cube_id",
    "expected_head",
    "packet_sha256",
    "requested_mode",
    "selected_mode",
    "spawn_policy",
    "selection_reasons",
    "risk_summary",
    "stages",
    "card_protocol",
    "parent_only_actions",
    "completion_rule",
    "nonclaim"
  ],
  "properties": {
    "event": {"const": "lacuna.turn.orchestration-planned"},
    "schema": {"const": "lacuna.orchestration-plan.v1"},
    "request_id": {"$ref": "#/$defs/id"},
    "request_source_id": {"$ref": "#/$defs/id"},
    "cube_id": {"$ref": "#/$defs/id"},
    "expected_head": {"$ref": "#/$defs/sha256"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "requested_mode": {"enum": ["auto", "solo", "pair", "full"]},
    "selected_mode": {"enum": ["solo", "pair", "full"]},
    "spawn_policy": {"enum": ["do-not-spawn-by-default", "spawn-recommended"]},
    "selection_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reason"}
    },
    "risk_summary": {"$ref": "#/$defs/riskSummary"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stage"}
    },
    "card_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "rule"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "parent_only_actions": {"$ref": "#/$defs/stringList"},
    "completion_rule": {"type": "string", "minLength": 1},
    "nonclaim": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "riskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privileged_context_present",
        "candidate_world_count",
        "conflict_count",
        "severe_conflict_count",
        "consequence_repair_frontier_count",
        "revision_guard_count",
        "particle_world_count",
        "particle_factor_count",
        "particle_reweighting_debt_count",
        "particle_reconciliation_ready",
        "anchored_write_authority",
        "world_scoped_grant",
        "high_impact_custody_present"
      ],
      "properties": {
        "privileged_context_present": {"type": "boolean"},
        "candidate_world_count": {"type": "integer", "minimum": 0},
        "conflict_count": {"type": "integer", "minimum": 0},
        "severe_conflict_count": {"type": "integer", "minimum": 0},
        "consequence_repair_frontier_count": {"type": "integer", "minimum": 0},
        "revision_guard_count": {"type": "integer", "minimum": 0},
        "particle_world_count": {"type": "integer", "minimum": 0},
        "particle_factor_count": {"type": "integer", "minimum": 0},
        "particle_reweighting_debt_count": {"type": "integer", "minimum": 0},
        "particle_reconciliation_ready": {"type": "boolean"},
        "anchored_write_authority": {"type": "boolean"},
        "world_scoped_grant": {"type": "boolean"},
        "high_impact_custody_present": {"type": "boolean"}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "role", "action", "requires", "returns", "task_card_role", "card_command", "may_commit"],
      "properties": {
        "stage": {"type": "integer", "minimum": 1},
        "role": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "requires": {"$ref": "#/$defs/stringList"},
        "returns": {"type": "string", "minLength": 1},
        "task_card_role": {
          "type": ["string", "null"],
          "enum": [null, "lacuna-planner", "lacuna-narrator", "lacuna-proposal-builder", "lacuna-verifier"]
        },
        "card_command": {"type": ["string", "null"], "minLength": 1},
        "may_commit": {"const": false}
      }
    }
  }
}
