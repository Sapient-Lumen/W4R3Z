{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-bundle-v2",
  "title": "Lacuna scenario bundle manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "project_version",
    "bundle_id",
    "bundle_path",
    "created_at",
    "updated_at",
    "status",
    "plan",
    "schedule",
    "commitment",
    "blocks",
    "witnesses",
    "report",
    "unblinded_at",
    "next_action",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.bundle"
    },
    "schema": {
      "const": "lacuna.scenario-bundle.v2"
    },
    "project_version": {
      "type": "string",
      "minLength": 1
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "bundle_path": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "awaiting-witnesses",
        "block-active",
        "block-ready-to-seal",
        "ready-to-unblind",
        "unblinding",
        "unblinded"
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "schema",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "schema",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "schema",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "label",
          "block_id",
          "status",
          "scenario_run",
          "seal",
          "scenario_report_sha256"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "block_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "status": {
            "enum": [
              "pending",
              "active",
              "sealed",
              "unblinded"
            ]
          },
          "scenario_run": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "run_id",
              "capsule_sha256",
              "assignment_sha256",
              "seed"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "run_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
              },
              "capsule_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "assignment_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "seed": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cube_id",
                  "head",
                  "event_count",
                  "snapshot_sha256"
                ],
                "properties": {
                  "cube_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
                  },
                  "head": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "event_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "snapshot_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "seal": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "schema",
                  "role"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "schema": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "scenario_report_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          }
        }
      },
      "minItems": 2,
      "maxItems": 128
    },
    "witnesses": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "schema",
          "role",
          "witness_id",
          "external_receipt_id"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "schema": {
            "const": "lacuna.scenario-bundle-witness.v1"
          },
          "role": {
            "const": "external-witness-record"
          },
          "witness_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "external_receipt_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "report": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "schema",
            "role"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "unblinded_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "action",
        "input_path",
        "expected_schema",
        "command",
        "blind"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "input_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "blind": {
          "type": "boolean"
        }
      }
    },
    "nonclaims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 7
    }
  }
}
