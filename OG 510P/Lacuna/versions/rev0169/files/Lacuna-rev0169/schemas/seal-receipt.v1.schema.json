{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:fair-play-seal-receipt:v1",
  "title": "Lacuna fair-play seal receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "cube_id",
    "current_head",
    "receipt_sha256",
    "receipt_core",
    "seal",
    "commitment_event",
    "opening",
    "resolution",
    "nonclaims",
    "access"
  ],
  "properties": {
    "event": {
      "const": "lacuna.fair-play-seal.receipt"
    },
    "schema": {
      "const": "lacuna.fair-play-seal-receipt.v1"
    },
    "cube_id": {
      "$ref": "#/$defs/id"
    },
    "current_head": {
      "$ref": "#/$defs/digest"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/digest"
    },
    "receipt_core": {
      "$ref": "#/$defs/receiptCore"
    },
    "seal": {
      "$ref": "#/$defs/currentSeal"
    },
    "commitment_event": {
      "$ref": "#/$defs/commitmentEvent"
    },
    "opening": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/opening"
        }
      ]
    },
    "resolution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/voidResolution"
        }
      ]
    },
    "nonclaims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "access": {
      "$ref": "#/$defs/access"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "audience": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "portableJson": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/portableJson"
          }
        },
        {
          "type": "object",
          "maxProperties": 10000,
          "propertyNames": {
            "pattern": "^[^\\uD800-\\uDFFF]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/portableJson"
          }
        }
      ]
    },
    "immutableSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seal_id",
        "scheme",
        "commitment_sha256",
        "label",
        "purpose",
        "visibility",
        "audience",
        "created_seq"
      ],
      "properties": {
        "seal_id": {
          "$ref": "#/$defs/id"
        },
        "scheme": {
          "const": "lacuna.salted-sha256-json.v1"
        },
        "commitment_sha256": {
          "$ref": "#/$defs/digest"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "enum": [
            "mystery",
            "continuity",
            "choice",
            "other"
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "restricted"
          ]
        },
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "created_seq": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "currentSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seal_id",
        "scheme",
        "commitment_sha256",
        "label",
        "purpose",
        "visibility",
        "audience",
        "created_seq",
        "revealed_seq",
        "voided_seq",
        "status"
      ],
      "properties": {
        "seal_id": {
          "$ref": "#/$defs/id"
        },
        "scheme": {
          "const": "lacuna.salted-sha256-json.v1"
        },
        "commitment_sha256": {
          "$ref": "#/$defs/digest"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "enum": [
            "mystery",
            "continuity",
            "choice",
            "other"
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "restricted"
          ]
        },
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "created_seq": {
          "type": "integer",
          "minimum": 1
        },
        "revealed_seq": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "voided_seq": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "status": {
          "enum": [
            "sealed",
            "revealed",
            "voided"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "sealed"
            },
            "revealed_seq": {
              "type": "null"
            },
            "voided_seq": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "revealed"
            },
            "revealed_seq": {
              "type": "integer",
              "minimum": 1
            },
            "voided_seq": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "voided"
            },
            "revealed_seq": {
              "type": "null"
            },
            "voided_seq": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "commitmentEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "event_id",
        "event_hash",
        "prev_hash",
        "recorded_at",
        "change_after_head"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "event_hash": {
          "$ref": "#/$defs/digest"
        },
        "prev_hash": {
          "$ref": "#/$defs/digest"
        },
        "recorded_at": {
          "type": "string",
          "minLength": 1
        },
        "change_after_head": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "receiptCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "cube_id",
        "seal",
        "commitment_event"
      ],
      "properties": {
        "schema": {
          "const": "lacuna.fair-play-seal-receipt-core.v1"
        },
        "cube_id": {
          "$ref": "#/$defs/id"
        },
        "seal": {
          "$ref": "#/$defs/immutableSeal"
        },
        "commitment_event": {
          "$ref": "#/$defs/commitmentEvent"
        }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nonce",
        "payload",
        "reason",
        "revealed_seq"
      ],
      "properties": {
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payload": {
          "$ref": "#/$defs/portableJson"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "revealed_seq": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "voidResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "voided_seq"
      ],
      "properties": {
        "status": {
          "const": "voided"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "voided_seq": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "agent_id",
        "privileged"
      ],
      "properties": {
        "mode": {
          "enum": [
            "planner",
            "perspective"
          ]
        },
        "agent_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "privileged": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "seal": {
            "properties": {
              "status": {
                "const": "sealed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "opening": {
            "type": "null"
          },
          "resolution": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "seal": {
            "properties": {
              "status": {
                "const": "revealed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "opening": {
            "$ref": "#/$defs/opening"
          },
          "resolution": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "seal": {
            "properties": {
              "status": {
                "const": "voided"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "opening": {
            "type": "null"
          },
          "resolution": {
            "$ref": "#/$defs/voidResolution"
          }
        }
      }
    }
  ]
}
