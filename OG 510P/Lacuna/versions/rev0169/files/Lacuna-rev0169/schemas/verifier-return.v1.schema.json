{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:verifier-return:v1",
  "title": "Lacuna verifier return v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "request_id",
    "packet_sha256",
    "proposal_sha256",
    "status",
    "findings",
    "recommended_action"
  ],
  "properties": {
    "schema": {"const": "lacuna.verifier-return.v1"},
    "task_id": {"$ref": "#/$defs/id"},
    "request_id": {"$ref": "#/$defs/id"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["pass", "refuse"]},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "recommended_action": {"type": "string", "minLength": 1, "maxLength": 10000}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "path", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 10000},
        "severity": {"type": "string", "minLength": 1, "maxLength": 10000},
        "path": {"type": "string", "minLength": 1, "maxLength": 10000},
        "message": {"type": "string", "minLength": 1, "maxLength": 10000}
      }
    }
  }
}
