{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:planner-return:v1",
  "title": "Lacuna planner return v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "request_id",
    "packet_sha256",
    "observable_plan",
    "candidate_operations",
    "preserved_unknowns",
    "commitment_risks",
    "leakage_risks",
    "private_notes"
  ],
  "properties": {
    "schema": {"const": "lacuna.planner-return.v1"},
    "task_id": {"$ref": "#/$defs/id"},
    "request_id": {"$ref": "#/$defs/id"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "observable_plan": {"$ref": "#/$defs/stringList"},
    "candidate_operations": {
      "type": "array",
      "maxItems": 999,
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {"op": {"type": "string", "minLength": 1}}
      }
    },
    "preserved_unknowns": {"$ref": "#/$defs/stringList"},
    "commitment_risks": {"$ref": "#/$defs/stringList"},
    "leakage_risks": {"$ref": "#/$defs/stringList"},
    "private_notes": {"type": "string", "maxLength": 20000}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringList": {
      "type": "array",
      "maxItems": 500,
      "items": {"type": "string", "minLength": 1, "maxLength": 10000}
    }
  }
}
