{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:checkpoint-narrator-capsule:v1",
  "title": "Lacuna fresh-narrator checkpoint capsule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "project_version",
    "run_id",
    "checkpoint_id",
    "cube_id",
    "post_commit_head",
    "audience_id",
    "actor_id",
    "source_artifacts",
    "accepted_previous_narration",
    "audience_context",
    "private_planning_context",
    "operating_instructions",
    "excluded_by_design",
    "nonclaims"
  ],
  "properties": {
    "event": {"const": "lacuna.checkpoint.narrator-capsule"},
    "schema": {"const": "lacuna.checkpoint-narrator-capsule.v1"},
    "project_version": {"type": "string", "minLength": 1},
    "run_id": {"$ref": "#/$defs/id"},
    "checkpoint_id": {"$ref": "#/$defs/id"},
    "cube_id": {"$ref": "#/$defs/id"},
    "post_commit_head": {"$ref": "#/$defs/sha256"},
    "audience_id": {"$ref": "#/$defs/id"},
    "actor_id": {"$ref": "#/$defs/id"},
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_sha256",
        "proposal_sha256",
        "receipt_sha256",
        "compression_sha256",
        "state_card_sha256",
        "audience_context_sha256"
      ],
      "properties": {
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "proposal_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "compression_sha256": {"$ref": "#/$defs/sha256"},
        "state_card_sha256": {"$ref": "#/$defs/sha256"},
        "audience_context_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "accepted_previous_narration": {"type": "string", "minLength": 1, "maxLength": 50000},
    "audience_context": {"type": "object"},
    "private_planning_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_card",
        "retained_elements",
        "omitted_elements",
        "preserved_unknown_ids",
        "forbidden_contradictions",
        "next_pressures"
      ],
      "properties": {
        "state_card": {"type": "string", "minLength": 1, "maxLength": 20000},
        "retained_elements": {"$ref": "#/$defs/stringList"},
        "omitted_elements": {"$ref": "#/$defs/stringList"},
        "preserved_unknown_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden_contradictions": {"$ref": "#/$defs/stringList"},
        "next_pressures": {"$ref": "#/$defs/stringList"}
      }
    },
    "operating_instructions": {"$ref": "#/$defs/stringList"},
    "excluded_by_design": {"$ref": "#/$defs/stringList"},
    "nonclaims": {"$ref": "#/$defs/stringList"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
