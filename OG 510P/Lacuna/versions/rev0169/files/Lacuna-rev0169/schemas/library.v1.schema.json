{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:library:v1",
  "title": "Lacuna campaign library v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "project_version",
    "library_id",
    "created_at",
    "selected_campaign_id"
  ],
  "properties": {
    "schema": {"const": "lacuna.library.v1"},
    "project": {"const": "Lacuna"},
    "project_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "library_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 128},
    "selected_campaign_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
