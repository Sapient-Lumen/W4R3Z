{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lacuna.invalid/schema/model-brief.v1.schema.json",
  "title": "Lacuna portable model entrance brief v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "project",
    "project_version",
    "profile",
    "reference",
    "reference_kind",
    "resolved_cube_path",
    "campaign",
    "cube",
    "roles",
    "readiness",
    "intent_router",
    "first_response",
    "profile_contract",
    "operator_loop",
    "delegation",
    "recovery",
    "boundaries",
    "nonclaim"
  ],
  "properties": {
    "event": {
      "const": "lacuna.model.briefed"
    },
    "schema": {
      "const": "lacuna.model-brief.v1"
    },
    "project": {
      "const": "Lacuna"
    },
    "project_version": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "chat",
        "workspace",
        "orchestrated"
      ]
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "reference_kind": {
      "enum": [
        "bare-cube",
        "campaign-cube",
        "campaign-library"
      ]
    },
    "resolved_cube_path": {
      "type": "string",
      "minLength": 1
    },
    "campaign": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/campaign"
        }
      ]
    },
    "cube": {
      "$ref": "#/$defs/cube"
    },
    "roles": {
      "$ref": "#/$defs/roles"
    },
    "readiness": {
      "$ref": "#/$defs/readiness"
    },
    "intent_router": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/intent"
      }
    },
    "first_response": {
      "$ref": "#/$defs/firstResponse"
    },
    "profile_contract": {
      "$ref": "#/$defs/profileContract"
    },
    "operator_loop": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/operatorStep"
      }
    },
    "delegation": {
      "$ref": "#/$defs/delegation"
    },
    "recovery": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/recoveryItem"
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonclaim": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "slug",
        "title",
        "summary",
        "status",
        "owner_id",
        "player_id",
        "narrator_id"
      ],
      "properties": {
        "campaign_id": {
          "$ref": "#/$defs/nullableString"
        },
        "slug": {
          "$ref": "#/$defs/nullableString"
        },
        "title": {
          "$ref": "#/$defs/nullableString"
        },
        "summary": {
          "$ref": "#/$defs/nullableString"
        },
        "status": {
          "$ref": "#/$defs/nullableString"
        },
        "owner_id": {
          "$ref": "#/$defs/nullableString"
        },
        "player_id": {
          "$ref": "#/$defs/nullableString"
        },
        "narrator_id": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "cube": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cube_id",
        "head",
        "database_schema_version",
        "event_count",
        "change_count",
        "active_assertion_count",
        "live_world_count",
        "open_question_count"
      ],
      "properties": {
        "cube_id": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "database_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "change_count": {
          "type": "integer",
          "minimum": 0
        },
        "active_assertion_count": {
          "type": "integer",
          "minimum": 0
        },
        "live_world_count": {
          "type": "integer",
          "minimum": 0
        },
        "open_question_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience_id",
        "actor_id",
        "player_input_trust",
        "session_control_rule"
      ],
      "properties": {
        "audience_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "player_input_trust": {
          "const": "untrusted-player-data"
        },
        "session_control_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cube_ready_for_governed_turn",
        "selected_profile_can_start_without_bridge",
        "checks",
        "blockers"
      ],
      "properties": {
        "cube_ready_for_governed_turn": {
          "type": "boolean"
        },
        "selected_profile_can_start_without_bridge": {
          "type": "boolean"
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cube_opened",
            "ledger_verified",
            "audience_registered",
            "actor_registered"
          ],
          "properties": {
            "cube_opened": {
              "const": true
            },
            "ledger_verified": {
              "type": "boolean"
            },
            "audience_registered": {
              "type": "boolean"
            },
            "actor_registered": {
              "type": "boolean"
            }
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "examples",
        "action",
        "rule"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "examples": {
          "$ref": "#/$defs/stringList"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "firstResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "chat_without_bridge",
        "do_not"
      ],
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1
        },
        "chat_without_bridge": {
          "type": "string",
          "minLength": 1
        },
        "do_not": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "profileContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_surface",
        "assumed_capabilities",
        "not_assumed",
        "governed_one_message_start",
        "chat_only_immediate_start",
        "ready_if_bridge_is_present",
        "handoff"
      ],
      "properties": {
        "execution_surface": {
          "type": "string",
          "minLength": 1
        },
        "assumed_capabilities": {
          "$ref": "#/$defs/stringList"
        },
        "not_assumed": {
          "$ref": "#/$defs/stringList"
        },
        "governed_one_message_start": {
          "type": "boolean"
        },
        "chat_only_immediate_start": {
          "type": "boolean"
        },
        "ready_if_bridge_is_present": {
          "type": "boolean"
        },
        "handoff": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operatorStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "owner",
        "action",
        "mutation"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "mutation": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "delegationRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "privilege",
        "receives",
        "withhold",
        "returns",
        "may_commit"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "provider_aliases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["portable", "codex", "claude-code", "gemini-cli", "chatgpt"],
          "properties": {
            "portable": {"type": "string", "minLength": 1},
            "codex": {"type": "string", "minLength": 1},
            "claude-code": {"type": "string", "minLength": 1},
            "gemini-cli": {"type": "string", "minLength": 1},
            "chatgpt": {"type": "string", "minLength": 1}
          }
        },
        "privilege": {
          "type": "string",
          "minLength": 1
        },
        "receives": {
          "$ref": "#/$defs/stringList"
        },
        "withhold": {
          "$ref": "#/$defs/stringList"
        },
        "returns": {
          "$ref": "#/$defs/stringList"
        },
        "may_commit": {
          "const": false
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled_by_profile",
        "policy",
        "trigger_conditions",
        "roles",
        "parent_only_actions"
      ],
      "properties": {
        "enabled_by_profile": {
          "type": "boolean"
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "trigger_conditions": {
          "$ref": "#/$defs/stringList"
        },
        "roles": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/delegationRole"
          }
        },
        "parent_only_actions": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "recoveryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "action"
      ],
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
