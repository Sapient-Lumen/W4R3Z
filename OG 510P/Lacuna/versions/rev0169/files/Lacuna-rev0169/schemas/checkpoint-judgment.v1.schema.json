{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:checkpoint-judgment:v1",
  "title": "Lacuna blind retcon checkpoint judgment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "checkpoint_id",
    "request_sha256",
    "candidates_sha256",
    "blind_review",
    "assessor",
    "scores",
    "selected_candidate_id",
    "selection_rule",
    "selection_rationale",
    "nonclaims"
  ],
  "properties": {
    "schema": {
      "const": "lacuna.checkpoint-judgment.v1"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "checkpoint_id": {
      "$ref": "#/$defs/id"
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidates_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "blind_review": {
      "const": true
    },
    "assessor": {
      "$ref": "#/$defs/provenance"
    },
    "scores": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "eligible",
          "disqualifiers",
          "dimensions",
          "weighted_score",
          "rationale"
        ],
        "properties": {
          "candidate_id": {
            "$ref": "#/$defs/id"
          },
          "eligible": {
            "type": "boolean"
          },
          "disqualifiers": {
            "$ref": "#/$defs/stringList"
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "coherence",
              "player_agency",
              "genre_fit",
              "character_believability",
              "payoff_density",
              "novelty",
              "coincidence_sanity"
            ],
            "properties": {
              "coherence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "player_agency": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "genre_fit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "character_believability": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "payoff_density": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "novelty": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "coincidence_sanity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "weighted_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "selected_candidate_id": {
      "$ref": "#/$defs/id"
    },
    "selection_rule": {
      "const": "highest-weighted-eligible-then-lexicographic-candidate-id"
    },
    "selection_rationale": {
      "type": "string",
      "minLength": 1
    },
    "nonclaims": {
      "$ref": "#/$defs/stringList"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "model_version",
        "invocation_id",
        "notes"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
