{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-bundle-witness-v1",
  "title": "Lacuna external scenario bundle witness record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "bundle_id",
    "witness_id",
    "commitment_sha256",
    "kind",
    "service",
    "external_receipt_id",
    "external_receipt_sha256",
    "external_locator",
    "witnessed_at",
    "recorded_at",
    "declaration",
    "notes",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.bundle.witness-recorded"
    },
    "schema": {
      "const": "lacuna.scenario-bundle-witness.v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "witness_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "commitment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "external-retention",
        "timestamp",
        "transparency-log",
        "signature",
        "human-cosignature",
        "other"
      ]
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "external_receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "external_receipt_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "external_locator": {
      "type": [
        "string",
        "null"
      ]
    },
    "witnessed_at": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "declaration": {
      "const": "operator-supplied-unverified-external-receipt"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "nonclaims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2
    }
  }
}
