{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-cell-driver-v2",
  "title": "Private comparative scenario cell driver v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "project_version",
    "run_id",
    "capsule_id",
    "cell_label",
    "ordinal",
    "condition",
    "seed",
    "resolved_cube_path",
    "turn_run_root",
    "checkpoint_run_root",
    "script",
    "model_policy",
    "budget",
    "condition_contract",
    "contamination_controls",
    "instructions",
    "return_contract",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.cell-driver"
    },
    "schema": {
      "const": "lacuna.scenario-cell-driver.v2"
    },
    "project_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "capsule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "cell_label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "condition": {
      "enum": [
        "forward-only",
        "prompt-only-retcon",
        "lacuna-serial",
        "lacuna-role-separated"
      ]
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cube_id",
        "head"
      ],
      "properties": {
        "cube_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "resolved_cube_path": {
      "type": "string",
      "minLength": 1
    },
    "turn_run_root": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_run_root": {
      "type": "string",
      "minLength": 1
    },
    "script": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "player_input",
          "checkpoint_after",
          "checkpoint_trigger",
          "tags"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "player_input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "checkpoint_after": {
            "type": "boolean"
          },
          "checkpoint_trigger": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "maxItems": 64,
            "uniqueItems": true
          }
        }
      }
    },
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_family",
        "model",
        "model_version",
        "sampling_policy",
        "sampling_seed",
        "same_model_required"
      ],
      "properties": {
        "provider": {
          "enum": [
            "portable",
            "codex",
            "claude-code",
            "gemini-cli",
            "chatgpt"
          ]
        },
        "model_family": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "sampling_policy": {
          "type": "string",
          "minLength": 1
        },
        "same_model_required": {
          "type": "boolean"
        },
        "sampling_seed": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_invocations_per_cell",
        "max_duration_ms_per_cell",
        "max_input_tokens_per_cell",
        "max_output_tokens_per_cell",
        "max_cost_microusd_per_cell"
      ],
      "properties": {
        "max_invocations_per_cell": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_duration_ms_per_cell": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_input_tokens_per_cell": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_output_tokens_per_cell": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_cost_microusd_per_cell": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "condition_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_mode",
        "required_roles",
        "context_rule",
        "continuation_mode",
        "checkpoint_step_ids"
      ],
      "properties": {
        "checkpoint_mode": {
          "enum": [
            "none",
            "monolithic",
            "managed-serial",
            "managed-role-separated"
          ]
        },
        "required_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "maxItems": 4,
          "uniqueItems": true
        },
        "context_rule": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_step_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "uniqueItems": true
        },
        "continuation_mode": {
          "enum": [
            "persistent-context",
            "fresh-narrator-capsule"
          ]
        }
      }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "return_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "template",
        "record_command"
      ],
      "properties": {
        "schema": {
          "const": "lacuna.scenario-cell-return.v1"
        },
        "template": {
          "type": "object"
        },
        "record_command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contamination_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "operator_canary",
        "filesystem_canary",
        "instructions",
        "nonclaims"
      ],
      "properties": {
        "method": {
          "const": "sha256-domain-separated-exact-canaries-v1"
        },
        "operator_canary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canary_id",
            "token",
            "token_sha256"
          ],
          "properties": {
            "canary_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "token": {
              "type": "string",
              "pattern": "^LACUNA_CANARY_OPERATOR_ONLY_[0-9A-F]{40}$"
            },
            "token_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "filesystem_canary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canary_id",
            "path",
            "token_sha256"
          ],
          "properties": {
            "canary_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "token_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nonclaims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
