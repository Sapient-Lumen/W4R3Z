{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:checkpoint-continuation-dispatch:v2",
  "title": "Lacuna fresh post-checkpoint narrator dispatch v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "project_version",
    "checkpoint_run_id",
    "checkpoint_run_path",
    "checkpoint_id",
    "checkpoint_receipt_sha256",
    "capsule_sha256",
    "turn_run_id",
    "turn_run_path",
    "turn_request_id",
    "turn_packet_sha256",
    "public_context_mode",
    "public_history_sha256",
    "public_history_completeness",
    "provider",
    "role",
    "agent_name",
    "context_requirement",
    "input_document_sha256",
    "input_document",
    "return_contract",
    "instructions",
    "authority",
    "excluded_by_design",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.checkpoint.continuation-dispatched"
    },
    "schema": {
      "const": "lacuna.checkpoint-continuation-dispatch.v2"
    },
    "project_version": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_run_id": {
      "$ref": "#/$defs/id"
    },
    "checkpoint_run_path": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_id": {
      "$ref": "#/$defs/id"
    },
    "checkpoint_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "capsule_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "turn_run_id": {
      "$ref": "#/$defs/id"
    },
    "turn_run_path": {
      "type": "string",
      "minLength": 1
    },
    "turn_request_id": {
      "$ref": "#/$defs/id"
    },
    "turn_packet_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provider": {
      "enum": [
        "portable",
        "codex",
        "claude-code",
        "gemini-cli",
        "chatgpt"
      ]
    },
    "role": {
      "const": "lacuna-fresh-narrator"
    },
    "agent_name": {
      "type": "string",
      "minLength": 1
    },
    "context_requirement": {
      "const": "fresh-post-checkpoint"
    },
    "input_document_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_document": {
      "$ref": "#/$defs/inputDocument"
    },
    "return_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "format",
        "template",
        "save_path",
        "accept_command"
      ],
      "properties": {
        "schema": {
          "const": "lacuna.turn-proposal.v2"
        },
        "format": {
          "const": "exactly one root JSON object; no prose, Markdown, or code fence"
        },
        "template": {
          "$ref": "#/$defs/turnProposal"
        },
        "save_path": {
          "type": "string",
          "minLength": 1
        },
        "accept_command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "instructions": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_may",
        "worker_may_not",
        "parent_only"
      ],
      "properties": {
        "worker_may": {
          "$ref": "#/$defs/stringList"
        },
        "worker_may_not": {
          "$ref": "#/$defs/stringList"
        },
        "parent_only": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "excluded_by_design": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "public_context_mode": {
      "enum": [
        "typed-only",
        "bound-public-history",
        "complete-bound-public-history"
      ]
    },
    "public_history_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "public_history_completeness": {
      "enum": [
        "not-claimed",
        "complete",
        null
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "idOrAlias": {
      "type": "string",
      "pattern": "^(?:[A-Za-z][A-Za-z0-9._:-]{0,127}|@[A-Za-z][A-Za-z0-9._:-]{0,63})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "continuationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_run_id",
        "checkpoint_id",
        "checkpoint_request_head",
        "checkpoint_request_event_seq",
        "checkpoint_post_commit_head",
        "checkpoint_post_commit_event_seq",
        "capsule_sha256",
        "request_sha256",
        "proposal_sha256",
        "receipt_sha256",
        "compression_sha256",
        "state_card_sha256",
        "checkpoint_audience_context_sha256",
        "public_history_sha256",
        "public_history_id",
        "public_history_public_entries_sha256",
        "public_history_last_commit_event_seq",
        "public_history_coverage_mode",
        "public_history_completeness",
        "public_history_expected_committed_turn_count",
        "public_history_ledger_turns_sha256"
      ],
      "properties": {
        "checkpoint_run_id": {
          "$ref": "#/$defs/id"
        },
        "checkpoint_id": {
          "$ref": "#/$defs/id"
        },
        "checkpoint_post_commit_head": {
          "$ref": "#/$defs/sha256"
        },
        "capsule_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "proposal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "compression_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "state_card_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checkpoint_audience_context_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checkpoint_request_head": {
          "$ref": "#/$defs/sha256"
        },
        "checkpoint_request_event_seq": {
          "type": "integer",
          "minimum": 1
        },
        "checkpoint_post_commit_event_seq": {
          "type": "integer",
          "minimum": 1
        },
        "public_history_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "public_history_last_commit_event_seq": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "public_history_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "public_history_public_entries_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "public_history_coverage_mode": {
          "enum": [
            "explicit-run-list",
            "complete-before-checkpoint",
            null
          ]
        },
        "public_history_completeness": {
          "enum": [
            "not-claimed",
            "complete",
            null
          ]
        },
        "public_history_expected_committed_turn_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000
        },
        "public_history_ledger_turns_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "turnIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cube_id",
        "turn_run_id",
        "request_id",
        "request_source_id",
        "proposal_id",
        "expected_head",
        "audience_id",
        "actor_id",
        "player_input_sha256",
        "narration_source_id",
        "turn_packet_sha256",
        "turn_audience_context_sha256"
      ],
      "properties": {
        "cube_id": {
          "$ref": "#/$defs/id"
        },
        "turn_run_id": {
          "$ref": "#/$defs/id"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "request_source_id": {
          "$ref": "#/$defs/id"
        },
        "proposal_id": {
          "$ref": "#/$defs/id"
        },
        "expected_head": {
          "$ref": "#/$defs/sha256"
        },
        "audience_id": {
          "$ref": "#/$defs/id"
        },
        "actor_id": {
          "$ref": "#/$defs/id"
        },
        "player_input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "narration_source_id": {
          "$ref": "#/$defs/id"
        },
        "turn_packet_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "turn_audience_context_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "privatePlanningContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_card",
        "retained_elements",
        "omitted_elements",
        "preserved_unknown_ids",
        "forbidden_contradictions",
        "next_pressures",
        "state_card_sha256"
      ],
      "properties": {
        "state_card": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "retained_elements": {
          "$ref": "#/$defs/stringList"
        },
        "omitted_elements": {
          "$ref": "#/$defs/stringList"
        },
        "preserved_unknown_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_contradictions": {
          "$ref": "#/$defs/stringList"
        },
        "next_pressures": {
          "$ref": "#/$defs/stringList"
        },
        "state_card_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inputDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "schema",
        "project_version",
        "continuation_source",
        "turn_identity",
        "accepted_previous_narration",
        "audience_context",
        "public_context_mode",
        "public_history",
        "private_planning_context",
        "next_player_input",
        "turn_response_contract",
        "operating_instructions",
        "nonclaims"
      ],
      "properties": {
        "event": {
          "const": "lacuna.checkpoint.continuation-input"
        },
        "schema": {
          "const": "lacuna.checkpoint-continuation-input.v2"
        },
        "project_version": {
          "type": "string",
          "minLength": 1
        },
        "continuation_source": {
          "$ref": "#/$defs/continuationSource"
        },
        "turn_identity": {
          "$ref": "#/$defs/turnIdentity"
        },
        "accepted_previous_narration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        },
        "audience_context": {
          "type": "object"
        },
        "private_planning_context": {
          "$ref": "#/$defs/privatePlanningContext"
        },
        "next_player_input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        },
        "turn_response_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_operations",
            "rules"
          ],
          "properties": {
            "allowed_operations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rules": {
              "$ref": "#/$defs/stringList"
            }
          }
        },
        "operating_instructions": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nonclaims": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "public_context_mode": {
          "enum": [
            "typed-only",
            "bound-public-history",
            "complete-bound-public-history"
          ]
        },
        "public_history": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/publicHistoryView"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "public_context_mode": {
                "const": "typed-only"
              }
            },
            "required": [
              "public_context_mode"
            ]
          },
          "then": {
            "properties": {
              "public_history": {
                "type": "null"
              },
              "continuation_source": {
                "properties": {
                  "public_history_sha256": {
                    "type": "null"
                  },
                  "public_history_id": {
                    "type": "null"
                  },
                  "public_history_public_entries_sha256": {
                    "type": "null"
                  },
                  "public_history_last_commit_event_seq": {
                    "type": "null"
                  },
                  "public_history_coverage_mode": {
                    "type": "null"
                  },
                  "public_history_completeness": {
                    "type": "null"
                  },
                  "public_history_expected_committed_turn_count": {
                    "type": "null"
                  },
                  "public_history_ledger_turns_sha256": {
                    "type": "null"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "public_context_mode": {
                "const": "bound-public-history"
              }
            },
            "required": [
              "public_context_mode"
            ]
          },
          "then": {
            "properties": {
              "public_history": {
                "$ref": "#/$defs/publicHistoryView"
              },
              "continuation_source": {
                "properties": {
                  "public_history_sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "public_history_id": {
                    "$ref": "#/$defs/id"
                  },
                  "public_history_public_entries_sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "public_history_last_commit_event_seq": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "public_history_coverage_mode": {
                    "const": "explicit-run-list"
                  },
                  "public_history_completeness": {
                    "const": "not-claimed"
                  },
                  "public_history_expected_committed_turn_count": {
                    "type": "null"
                  },
                  "public_history_ledger_turns_sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "public_context_mode": {
                "const": "complete-bound-public-history"
              }
            },
            "required": [
              "public_context_mode"
            ]
          },
          "then": {
            "properties": {
              "public_history": {
                "$ref": "#/$defs/publicHistoryView"
              },
              "continuation_source": {
                "properties": {
                  "public_history_sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "public_history_id": {
                    "$ref": "#/$defs/id"
                  },
                  "public_history_public_entries_sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "public_history_last_commit_event_seq": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "public_history_coverage_mode": {
                    "const": "complete-before-checkpoint"
                  },
                  "public_history_completeness": {
                    "const": "complete"
                  },
                  "public_history_expected_committed_turn_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "public_history_ledger_turns_sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "turnProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "request_source_id",
        "proposal_id",
        "actor_id",
        "expected_head",
        "player_input_sha256",
        "audience_id",
        "narration_source_id",
        "narration",
        "revealed_assertion_ids",
        "operations",
        "message"
      ],
      "properties": {
        "schema": {
          "const": "lacuna.turn-proposal.v2"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "request_source_id": {
          "$ref": "#/$defs/id"
        },
        "proposal_id": {
          "$ref": "#/$defs/id"
        },
        "actor_id": {
          "$ref": "#/$defs/id"
        },
        "expected_head": {
          "$ref": "#/$defs/sha256"
        },
        "player_input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "audience_id": {
          "$ref": "#/$defs/id"
        },
        "narration_source_id": {
          "$ref": "#/$defs/id"
        },
        "narration": {
          "const": "Write only what the audience experiences now."
        },
        "revealed_assertion_ids": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "$ref": "#/$defs/idOrAlias"
          }
        },
        "operations": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "object",
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "type": "string",
                "minLength": 1
              },
              "as": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,63}$"
              }
            },
            "additionalProperties": true
          }
        },
        "message": {
          "const": "commit one narrated turn"
        }
      }
    },
    "publicHistoryView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "schema",
        "project_version",
        "history_id",
        "cube_id",
        "audience_id",
        "entry_count",
        "coverage_mode",
        "completeness",
        "public_entries_sha256",
        "public_entries",
        "operating_instructions",
        "nonclaims"
      ],
      "properties": {
        "event": {
          "const": "lacuna.public-history.projected"
        },
        "schema": {
          "const": "lacuna.public-history-view.v2"
        },
        "project_version": {
          "type": "string",
          "minLength": 1
        },
        "history_id": {
          "$ref": "#/$defs/id"
        },
        "cube_id": {
          "$ref": "#/$defs/id"
        },
        "audience_id": {
          "$ref": "#/$defs/id"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "coverage_mode": {
          "enum": [
            "explicit-run-list",
            "complete-before-checkpoint"
          ]
        },
        "completeness": {
          "enum": [
            "not-claimed",
            "complete"
          ]
        },
        "public_entries_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "public_entries": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "turn_index",
              "input_kind",
              "player_input",
              "narration"
            ],
            "properties": {
              "turn_index": {
                "type": "integer",
                "minimum": 1
              },
              "input_kind": {
                "enum": [
                  "play-turn",
                  "session-control"
                ]
              },
              "player_input": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              },
              "narration": {
                "type": "string",
                "maxLength": 200000
              }
            }
          }
        },
        "operating_instructions": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nonclaims": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage_mode": {
                "const": "explicit-run-list"
              }
            },
            "required": [
              "coverage_mode"
            ]
          },
          "then": {
            "properties": {
              "completeness": {
                "const": "not-claimed"
              },
              "entry_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            }
          },
          "else": {
            "properties": {
              "completeness": {
                "const": "complete"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "public_context_mode": {
            "const": "typed-only"
          }
        },
        "required": [
          "public_context_mode"
        ]
      },
      "then": {
        "properties": {
          "public_history_sha256": {
            "type": "null"
          },
          "public_history_completeness": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "public_context_mode": {
            "const": "bound-public-history"
          }
        },
        "required": [
          "public_context_mode"
        ]
      },
      "then": {
        "properties": {
          "public_history_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "public_history_completeness": {
