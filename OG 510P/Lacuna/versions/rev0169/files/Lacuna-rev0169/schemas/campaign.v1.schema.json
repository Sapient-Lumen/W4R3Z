{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:campaign:v1",
  "title": "Lacuna campaign manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "project_version",
    "campaign_id",
    "slug",
    "title",
    "summary",
    "status",
    "owner_id",
    "player_id",
    "narrator_id",
    "created_at",
    "cube_directory"
  ],
  "properties": {
    "schema": {"const": "lacuna.campaign.v1"},
    "project": {"const": "Lacuna"},
    "project_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "campaign_id": {"$ref": "#/$defs/id"},
    "slug": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "summary": {"type": "string", "maxLength": 4096},
    "status": {"enum": ["active", "archived"]},
    "owner_id": {"$ref": "#/$defs/id"},
    "player_id": {"$ref": "#/$defs/id"},
    "narrator_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 128},
    "cube_directory": {"const": "."}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"}
  }
}
