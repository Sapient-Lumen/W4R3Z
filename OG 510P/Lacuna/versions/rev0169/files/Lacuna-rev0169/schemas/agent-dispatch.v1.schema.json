{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:agent-dispatch:v1",
  "title": "Lacuna provider-neutral delegated-stage dispatch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "run_id",
    "run_path",
    "status",
    "provider",
    "role",
    "agent_name",
    "input_kind",
    "input_artifact",
    "input_document",
    "return_contract",
    "instructions",
    "authority",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.turn.agent-dispatch"
    },
    "schema": {
      "const": "lacuna.agent-dispatch.v1"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "run_path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "awaiting-planner",
        "awaiting-narrator",
        "awaiting-proposal-builder",
        "awaiting-verifier"
      ]
    },
    "provider": {
      "enum": [
        "portable",
        "codex",
        "claude-code",
        "gemini-cli",
        "chatgpt"
      ]
    },
    "role": {
      "enum": [
        "lacuna-planner",
        "lacuna-narrator",
        "lacuna-proposal-builder",
        "lacuna-verifier"
      ]
    },
    "agent_name": {
      "type": "string",
      "minLength": 1
    },
    "input_kind": {
      "enum": [
        "play-turn",
        "session-control"
      ]
    },
    "input_artifact": {
      "$ref": "#/$defs/inputArtifact"
    },
    "input_document": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "event",
        "schema",
        "task_id",
        "role",
        "turn_identity",
        "upstream_artifacts",
        "objective",
        "instructions",
        "input",
        "output_contract",
        "information_boundary",
        "forbidden_actions",
        "may_commit",
        "nonclaim"
      ],
      "properties": {
        "event": {
          "const": "lacuna.turn.task-carded"
        },
        "schema": {
          "const": "lacuna.turn-task-card.v1"
        },
        "role": {
          "enum": [
            "lacuna-planner",
            "lacuna-narrator",
            "lacuna-proposal-builder",
            "lacuna-verifier"
          ]
        },
        "may_commit": {
          "const": false
        }
      }
    },
    "return_contract": {
      "$ref": "#/$defs/returnContract"
    },
    "instructions": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "nonclaims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "media_type",
        "schema",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "const": "application/json"
        },
        "schema": {
          "const": "lacuna.turn-task-card.v1"
        },
        "role": {
          "enum": [
            "lacuna-planner",
            "lacuna-narrator",
            "lacuna-proposal-builder",
            "lacuna-verifier"
          ]
        }
      }
    },
    "returnContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "format",
        "save_path",
        "accept_command"
      ],
      "properties": {
        "schema": {
          "enum": [
            "lacuna.planner-return.v1",
            "lacuna.narrator-return.v1",
            "lacuna.turn-proposal.v2",
            "lacuna.verifier-return.v1"
          ]
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "save_path": {
          "type": "string",
          "minLength": 1
        },
        "accept_command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_may",
        "worker_may_not",
        "parent_only"
      ],
      "properties": {
        "worker_may": {
          "$ref": "#/$defs/stringList"
        },
        "worker_may_not": {
          "$ref": "#/$defs/stringList"
        },
        "parent_only": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  }
}
