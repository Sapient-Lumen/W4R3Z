{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:checkpoint-invocation-receipt:v1",
  "title": "Lacuna host-declared checkpoint invocation receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "run_id",
    "checkpoint_id",
    "sequence",
    "attempt",
    "role",
    "provider",
    "agent_name",
    "card_sha256",
    "dispatch_sha256",
    "expected_output_schema",
    "model",
    "model_version",
    "invocation_id",
    "started_at",
    "completed_at",
    "duration_ms",
    "outcome",
    "output_artifact",
    "failure_class",
    "failure_message",
    "recorded_at",
    "declaration",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.checkpoint.invocation-recorded"
    },
    "schema": {
      "const": "lacuna.checkpoint-invocation-receipt.v1"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "checkpoint_id": {
      "$ref": "#/$defs/id"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "role": {
      "enum": [
        "lacuna-retcon-generator",
        "lacuna-retcon-judge",
        "lacuna-retcon-compressor",
        "lacuna-retcon-verifier"
      ]
    },
    "provider": {
      "enum": [
        "portable",
        "codex",
        "claude-code",
        "gemini-cli",
        "chatgpt"
      ]
    },
    "agent_name": {
      "type": "string",
      "minLength": 1
    },
    "card_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "dispatch_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "expected_output_schema": {
      "enum": [
        "lacuna.checkpoint-candidates.v1",
        "lacuna.checkpoint-judgment.v1",
        "lacuna.checkpoint-compression.v1",
        "lacuna.checkpoint-verifier-return.v1"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "invocation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "outcome": {
      "enum": [
        "accepted",
        "failed"
      ]
    },
    "output_artifact": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "schema"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "schema": {
              "enum": [
                "lacuna.checkpoint-candidates.v1",
                "lacuna.checkpoint-judgment.v1",
                "lacuna.checkpoint-compression.v1",
                "lacuna.checkpoint-verifier-return.v1"
              ]
            }
          }
        }
      ]
    },
    "failure_class": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "provider-error",
            "timeout",
            "transport-error",
            "invalid-output",
            "worker-refusal",
            "interrupted",
            "other"
          ]
        }
      ]
    },
    "failure_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "declaration": {
      "const": "host-declared"
    },
    "nonclaims": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "accepted"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "output_artifact": {
            "type": "object"
          },
          "failure_class": {
            "type": "null"
          },
          "failure_message": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "output_artifact": {
            "type": "null"
          },
          "failure_class": {
            "enum": [
              "provider-error",
              "timeout",
              "transport-error",
              "invalid-output",
              "worker-refusal",
              "interrupted",
              "other"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "started_at": {
            "type": "null"
          }
        },
        "required": [
          "started_at"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "completed_at": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
