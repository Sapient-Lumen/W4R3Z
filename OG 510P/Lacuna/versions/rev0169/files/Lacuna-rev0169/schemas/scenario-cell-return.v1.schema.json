{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-cell-return-v1",
  "title": "Host-declared comparative scenario cell return v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "run_id",
    "capsule_id",
    "cell_label",
    "status",
    "transcript",
    "invocations",
    "failure",
    "completed_at",
    "operator_notes",
    "declaration",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.cell-return"
    },
    "schema": {
      "const": "lacuna.scenario-cell-return.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "capsule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "cell_label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "status": {
      "enum": [
        "completed",
        "refused",
        "failed"
      ]
    },
    "transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "narration"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "narration": {
            "type": "string",
            "maxLength": 200000
          }
        }
      },
      "maxItems": 100
    },
    "invocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "phase",
          "role",
          "script_step_id",
          "checkpoint_step_id",
          "managed_checkpoint_id",
          "continuation_checkpoint_id",
          "continuation_capsule_sha256",
          "provider",
          "model",
          "model_version",
          "context_id",
          "invocation_id",
          "input_sha256",
          "output_sha256",
          "started_at",
          "completed_at",
          "duration_ms",
          "input_tokens",
          "output_tokens",
          "cost_microusd",
          "outcome",
          "failure_class",
          "failure_message"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "phase": {
            "enum": [
              "ordinary-turn",
              "checkpoint"
            ]
          },
          "role": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "checkpoint_step_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "provider": {
            "enum": [
              "portable",
              "codex",
              "claude-code",
              "gemini-cli",
              "chatgpt"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "model_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "context_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "invocation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "output_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cost_microusd": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "outcome": {
            "enum": [
              "accepted",
              "failed"
            ]
          },
          "failure_class": {
            "type": [
              "string",
              "null"
            ]
          },
          "failure_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "script_step_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "managed_checkpoint_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "continuation_checkpoint_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "continuation_capsule_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "maxItems": 1000
    },
    "failure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "message"
          ],
          "properties": {
            "class": {
              "enum": [
                "provider-error",
                "timeout",
                "transport-error",
                "invalid-output",
                "worker-refusal",
                "kernel-refusal",
                "budget-exhausted",
                "interrupted",
                "other"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "operator_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "declaration": {
      "const": "host-declared"
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
