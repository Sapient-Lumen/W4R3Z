{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-masking-assessment-v1",
  "title": "Lacuna post-primary-rating method-identifiability assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "run_id",
    "capsule_id",
    "masking_id",
    "assessor_id",
    "blind_packet_sha256",
    "primary_rating_sha256s",
    "assessments",
    "declared_at",
    "declaration",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.masking-assessment"
    },
    "schema": {
      "const": "lacuna.scenario-masking-assessment.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "capsule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "masking_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "assessor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "blind_packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "primary_rating_sha256s": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "assessments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_label",
          "guessed_condition",
          "confidence",
          "cues",
          "familiarity",
          "recognized_method",
          "notes"
        ],
        "properties": {
          "cell_label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "guessed_condition": {
            "enum": [
              "forward-only",
              "prompt-only-retcon",
              "lacuna-serial",
              "lacuna-role-separated",
              "unknown"
            ]
          },
          "confidence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "cues": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "familiarity": {
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ]
          },
          "recognized_method": {
            "type": "boolean"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "declared_at": {
      "type": "string",
      "minLength": 1
    },
    "declaration": {
      "const": "post-primary-rating-blind-packet-only-method-assessment"
    },
    "nonclaims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2
    }
  }
}
