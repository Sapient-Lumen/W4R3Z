{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:scenario-bundle-commitment-v1",
  "title": "Lacuna public scenario bundle commitment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "bundle_id",
    "plan_sha256",
    "schedule_sha256",
    "block_count",
    "blocks",
    "created_at",
    "hash_contract",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.scenario.bundle.committed"
    },
    "schema": {
      "const": "lacuna.scenario-bundle-commitment.v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schedule_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "block_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 128
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "block_id",
          "block_label",
          "scenario_run_id",
          "seed",
          "capsule_sha256",
          "assignment_sha256"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "block_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "block_label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "scenario_run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          },
          "seed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cube_id",
              "head",
              "event_count",
              "snapshot_sha256"
            ],
            "properties": {
              "cube_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
              },
              "head": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "event_count": {
                "type": "integer",
                "minimum": 1
              },
              "snapshot_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "capsule_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "assignment_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 2,
      "maxItems": 128
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "hash_contract": {
      "const": "sha256-canonical-json-utf8-v1"
    },
    "nonclaims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3
    }
  }
}
