{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:checkpoint-commit-receipt:v1",
  "title": "Lacuna committed retcon checkpoint receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "overall_status",
    "checkpoint_id",
    "cube_id",
    "selected_candidate_id",
    "selection_evidence_sha256",
    "checkpoint_review_sha256",
    "turn_receipt",
    "narration",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.checkpoint.committed"
    },
    "schema": {
      "const": "lacuna.checkpoint-commit-receipt.v1"
    },
    "overall_status": {
      "const": "accepted"
    },
    "checkpoint_id": {
      "$ref": "#/$defs/id"
    },
    "cube_id": {
      "$ref": "#/$defs/id"
    },
    "selected_candidate_id": {
      "$ref": "#/$defs/id"
    },
    "selection_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "checkpoint_review_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "turn_receipt": {
      "type": "object"
    },
    "narration": {
      "type": "string"
    },
    "nonclaims": {
      "$ref": "#/$defs/stringList"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "model_version",
        "invocation_id",
        "notes"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
