{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lacuna:schema:checkpoint-agent-dispatch:v1",
  "title": "Lacuna provider-neutral checkpoint agent dispatch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema",
    "checkpoint_id",
    "task_id",
    "provider",
    "role",
    "agent_name",
    "input_card_sha256",
    "input_card",
    "return_contract",
    "instructions",
    "authority",
    "nonclaims"
  ],
  "properties": {
    "event": {
      "const": "lacuna.checkpoint.agent-dispatch"
    },
    "schema": {
      "const": "lacuna.checkpoint-agent-dispatch.v1"
    },
    "checkpoint_id": {
      "$ref": "#/$defs/id"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "provider": {
      "enum": [
        "portable",
        "codex",
        "claude-code",
        "gemini-cli",
        "chatgpt"
      ]
    },
    "role": {
      "enum": [
        "lacuna-retcon-generator",
        "lacuna-retcon-judge",
        "lacuna-retcon-compressor",
        "lacuna-retcon-verifier"
      ]
    },
    "agent_name": {
      "type": "string",
      "minLength": 1
    },
    "input_card_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_card": {
      "type": "object"
    },
    "return_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "format",
        "next_command"
      ],
      "properties": {
        "schema": {
          "enum": [
            "lacuna.checkpoint-candidates.v1",
            "lacuna.checkpoint-judgment.v1",
            "lacuna.checkpoint-compression.v1",
            "lacuna.checkpoint-verifier-return.v1"
          ]
        },
        "format": {
          "const": "exact-json-object"
        },
        "next_command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "instructions": {
      "$ref": "#/$defs/stringList"
    },
    "authority": {
      "type": "object"
    },
    "nonclaims": {
      "$ref": "#/$defs/stringList"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "model_version",
        "invocation_id",
        "notes"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
