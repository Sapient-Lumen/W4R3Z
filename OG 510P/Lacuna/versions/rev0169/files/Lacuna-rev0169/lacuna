#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${PYTHONPATH:-}" ]; then
    PYTHONPATH="$ROOT/src:$PYTHONPATH"
else
    PYTHONPATH="$ROOT/src"
fi
export PYTHONPATH
export PYTHONDONTWRITEBYTECODE=1

# Lacuna has no runtime dependencies. -S prevents ambient site-packages and
# sitecustomize hooks from silently becoming part of the executable boundary.
exec python3 -S -m lacuna.cli "$@"
