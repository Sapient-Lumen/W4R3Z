{
  "schema_version": "0.1.0",
  "command": ["cargo", "check", "--workspace"],
  "cargo": {
    "version": "1.90.0",
    "resolver_version": "2"
  },
  "data_sources": [
    "cargo_tree_features",
    "cargo_metadata",
    "manual_manifest_scan",
    "conservative_inference"
  ],
  "build_equivalence": "close_approximation",
  "selection_scope": {
    "command_kind": "check",
    "workspace_members": ["user1", "user2"],
    "targets": ["host"]
  },
  "assumptions": [
    "a separate member-specific command may produce a different feature state"
  ],
  "unknowns": [
    "stable Cargo outputs do not fully encode the counterfactual member-only feature state in one exact machine-readable receipt"
  ],
  "manual_review_required": true,
  "redactions": {
    "private_paths": true,
    "private_package_names": false
  }
}
