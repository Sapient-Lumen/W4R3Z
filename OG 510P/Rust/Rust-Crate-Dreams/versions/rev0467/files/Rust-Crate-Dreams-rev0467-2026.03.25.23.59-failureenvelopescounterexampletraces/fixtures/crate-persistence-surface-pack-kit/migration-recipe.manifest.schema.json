{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MigrationRecipeManifest",
  "type": "object",
  "required": [
    "surface",
    "from_version",
    "to_version",
    "strategy"
  ],
  "properties": {
    "surface": {
      "type": "string"
    },
    "from_version": {
      "type": "string"
    },
    "to_version": {
      "type": "string"
    },
    "strategy": {
      "enum": [
        "read_old_rewrite_new",
        "offline_convert",
        "in_place_upgrade",
        "discard_and_rebuild",
        "manual_review_required"
      ]
    },
    "lossy": {
      "type": "boolean"
    }
  }
}