{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeCaptureContextReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "captures"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "captures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capture_id",
          "origin_kind",
          "command_family",
          "selection",
          "toolchain_posture",
          "replay_posture"
        ],
        "properties": {
          "capture_id": {
            "type": "string"
          },
          "origin_kind": {
            "type": "string",
            "enum": [
              "cargo_fix_run",
              "cargo_check_run",
              "cargo_metadata_run",
              "cargo_report_replay",
              "cargo_semver_checks_run",
              "manual_observation",
              "other"
            ]
          },
          "command_family": {
            "type": "string"
          },
          "workspace_root_ref": {
            "type": "string"
          },
          "manifest_ref": {
            "type": "string"
          },
          "selection": {
            "type": "object",
            "properties": {
              "packages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "profile": {
                "type": "string"
              },
              "target_triples": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          },
          "toolchain_posture": {
            "type": "string",
            "enum": [
              "stable",
              "nightly",
              "mixed",
              "unknown"
            ]
          },
          "lockfile_posture": {
            "type": "string",
            "enum": [
              "locked",
              "frozen",
              "mutable",
              "not_applicable",
              "unknown"
            ]
          },
          "native_ids": {
            "type": "object",
            "properties": {
              "session_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "report_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          },
          "env_allowlist_digest": {
            "type": "string"
          },
          "replay_posture": {
            "type": "string",
            "enum": [
              "direct_replayable",
              "native_storage_replayable",
              "copied_attachment_only",
              "summary_only",
              "manual_only"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
