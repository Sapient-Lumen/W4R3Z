{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted Publishing Provider Drift Diff",
  "type": "object",
  "required": [
    "schema_version",
    "scope",
    "changes",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "subject"
        ],
        "properties": {
          "kind": {
            "enum": [
              "provider_scope_changed",
              "issuer_scope_changed",
              "claim_basis_changed",
              "trigger_policy_changed",
              "publish_mode_changed",
              "audience_claim_changed",
              "workflow_route_changed",
              "manual_review_required"
            ]
          },
          "subject": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "compatible",
        "review_needed",
        "blocked",
        "manual_review_required"
      ]
    }
  }
}
