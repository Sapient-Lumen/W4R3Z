{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rewrite Lineage Receipt",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "basis": {
      "type": "string",
      "enum": [
        "none",
        "hidden-setup-only",
        "adapter-injected",
        "manual-patch",
        "imported"
      ]
    },
    "rewrites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "description"
        ]
      }
    },
    "rationale": {
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "basis",
    "rewrites"
  ]
}
