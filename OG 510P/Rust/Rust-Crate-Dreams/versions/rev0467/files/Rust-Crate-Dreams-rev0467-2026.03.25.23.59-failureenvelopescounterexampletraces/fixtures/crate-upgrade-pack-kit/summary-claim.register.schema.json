{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeSummaryClaimRegister",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "summary_ref",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "summary_ref": {
      "type": "string"
    },
    "surface_state": {
      "type": "string",
      "enum": [
        "candidate_internal",
        "candidate_public",
        "frozen_public",
        "superseded_public"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "section_id",
          "claim_class",
          "audience",
          "status",
          "summary",
          "authoring_mode",
          "evidence_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "section_id": {
            "type": "string"
          },
          "claim_class": {
            "type": "string",
            "enum": [
              "hazard",
              "scope",
              "matrix_coverage",
              "fixup_posture",
              "manual_review_boundary",
              "readiness",
              "freshness",
              "warning",
              "next_step",
              "export_posture",
              "session_posture"
            ]
          },
          "audience": {
            "type": "string",
            "enum": [
              "maintainer_only",
              "downstream_adopter",
              "release_reviewer",
              "tool_importer",
              "public_contract"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "advisory",
              "manual_review_required",
              "superseded",
              "withheld"
            ]
          },
          "summary": {
            "type": "string"
          },
          "authoring_mode": {
            "type": "string",
            "enum": [
              "native_import",
              "maintainer_authored",
              "mixed_synthesis",
              "derived_register"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "warning_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deviation_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_head_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fallback_ref": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
