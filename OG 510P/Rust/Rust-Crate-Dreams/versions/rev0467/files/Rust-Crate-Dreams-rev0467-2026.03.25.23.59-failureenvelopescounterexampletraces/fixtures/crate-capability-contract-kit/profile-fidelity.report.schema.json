{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileFidelityReport",
  "type": "object",
  "required": [
    "schema_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "fidelity_class"
        ],
        "properties": {
          "profile_id": {
            "type": "string"
          },
          "fidelity_class": {
            "enum": [
              "fully_observed",
              "mostly_observed",
              "policy_backed",
              "partial_overlay",
              "manual_review_required"
            ]
          },
          "evidence_dimensions": {
            "type": "array",
            "items": {
              "enum": [
                "manifest_facts_present",
                "docsrs_metadata_imported",
                "rustdoc_json_imported",
                "cargo_metadata_imported",
                "slice_tool_imported",
                "target_caveats_acknowledged",
                "manual_review_boundary_recorded"
              ]
            }
          },
          "missing_dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
