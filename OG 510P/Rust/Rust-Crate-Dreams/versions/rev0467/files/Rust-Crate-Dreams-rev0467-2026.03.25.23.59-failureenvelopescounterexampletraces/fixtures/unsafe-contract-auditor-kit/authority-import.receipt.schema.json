{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/unsafe-contract-auditor-kit/authority-import.receipt.schema.json",
  "title": "Authority Import Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "crate_id",
    "imports",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate_id": {
      "type": "string"
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "import_id",
          "source_kind",
          "exactness_class",
          "obligations_covered"
        ],
        "properties": {
          "import_id": {
            "type": "string"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "docs_section",
              "contract_attribute",
              "std_contract_import",
              "upstream_manifest",
              "manual_manifest",
              "unknown"
            ]
          },
          "imported_from": {
            "type": "string"
          },
          "exactness_class": {
            "type": "string",
            "enum": [
              "exact",
              "translated",
              "partial",
              "inferred",
              "unknown"
            ]
          },
          "obligations_covered": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "freshness": {
            "type": "string"
          },
          "conflicts_with_local": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
