{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Lock Contention Witness Kit \u2014 evidence source receipt",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "consumption_mode"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "cargo_stderr_wait_message",
              "cargo_config_scan",
              "cargo_env_scan",
              "rust_analyzer_config",
              "process_observation",
              "build_analysis_session",
              "manual_annotation"
            ]
          },
          "consumption_mode": {
            "type": "string",
            "enum": [
              "direct_observation",
              "normalized_extract",
              "supporting_context",
              "manual_note"
            ]
          },
          "session_id": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}