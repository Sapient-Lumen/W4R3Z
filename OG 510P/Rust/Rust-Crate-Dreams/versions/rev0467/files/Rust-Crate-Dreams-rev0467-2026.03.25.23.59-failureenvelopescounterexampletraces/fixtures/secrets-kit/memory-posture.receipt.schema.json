{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/secrets-kit/memory-posture.receipt.schema.json",
  "title": "memory-posture.receipt",
  "type": "object",
  "required": [
    "subject",
    "profile",
    "memory_class",
    "zeroize_on_drop",
    "protected_memory",
    "evidence_class",
    "judgment"
  ],
  "properties": {
    "subject": {"type": "string"},
    "profile": {"type": "string"},
    "memory_class": {
      "type": "string",
      "enum": ["ordinary_heap", "zeroize_only", "protected_memory", "hybrid", "manual_review_required"]
    },
    "zeroize_on_drop": {"type": "boolean"},
    "protected_memory": {"type": "boolean"},
    "allows_copy_out": {"type": "boolean"},
    "evidence_class": {
      "type": "string",
      "enum": ["observed", "imported", "declared", "manual_review_required"]
    },
    "judgment": {
      "type": "string",
      "enum": ["zeroize_only_posture", "protected_memory_posture", "ordinary_heap_posture", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
