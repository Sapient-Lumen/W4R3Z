{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Default Surface Drift Report",
  "type": "object",
  "required": [
    "schema_version",
    "surface_name",
    "drift_kind",
    "visibility_change_without_support_evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "surface_name": {
      "type": "string"
    },
    "previous_default_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_default_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drift_kind": {
      "enum": [
        "docsrs_default_targets_changed",
        "project_metadata_changed",
        "mixed",
        "manual_review_required"
      ]
    },
    "visibility_change_without_support_evidence": {
      "type": "boolean"
    },
    "affected_item_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_action": {
      "enum": [
        "pin_explicit_targets",
        "review_support_contract",
        "manual_review_required"
      ]
    },
    "cautions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
