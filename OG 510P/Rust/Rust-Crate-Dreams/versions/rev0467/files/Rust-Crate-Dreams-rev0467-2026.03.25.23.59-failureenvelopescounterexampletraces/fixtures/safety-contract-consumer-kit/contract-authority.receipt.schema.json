{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/safety-contract-consumer/contract-authority.receipt.schema.json",
  "title": "safety contract authority receipt",
  "type": "object",
  "required": ["schema_version", "subject", "clauses"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "snapshot_id": {"type": "string"},
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clause_id", "authority_kind", "source_location", "extraction_route", "authority_confidence"],
        "properties": {
          "clause_id": {"type": "string"},
          "authority_kind": {"type": "string"},
          "source_location": {"type": "string"},
          "extraction_route": {"type": "string"},
          "authority_confidence": {"type": "string"},
          "normalization_notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "manual_review_gaps": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
