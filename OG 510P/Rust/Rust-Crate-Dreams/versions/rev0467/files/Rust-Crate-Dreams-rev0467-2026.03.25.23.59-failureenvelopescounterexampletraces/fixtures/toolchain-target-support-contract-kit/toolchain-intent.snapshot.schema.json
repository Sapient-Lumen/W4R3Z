{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toolchain Intent Snapshot",
  "type": "object",
  "required": ["schema_version", "channel_source", "toolchain"],
  "properties": {
    "schema_version": {"type": "string"},
    "channel_source": {"type": "string", "enum": ["rust-toolchain.toml", "rust-toolchain", "override", "default"]},
    "toolchain": {"type": "string"},
    "profile": {"type": "string"},
    "components": {"type": "array", "items": {"type": "string"}},
    "targets": {"type": "array", "items": {"type": "string"}},
    "docsrs": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
