{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shutdown-escalation.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "stop_signal_basis",
    "graceful_phase",
    "timeout_aftermath",
    "blocking_work_posture"
  ],
  "properties": {
    "artifact": {"const": "shutdown-escalation.receipt"},
    "subject": {"type": "string"},
    "stop_signal_basis": {
      "enum": ["cancellation_token", "supervisor_shutdown", "abort_handle", "actor_stop_signal", "mixed", "manual_review_required"]
    },
    "graceful_phase": {
      "enum": ["cooperative_drain", "await_children_exit", "channel_close_then_wait", "manual_review_required"]
    },
    "timeout_aftermath": {
      "enum": ["abort_async_children", "stop_waiting_but_work_may_continue", "blocking_tasks_may_escape", "manual_review_required"]
    },
    "blocking_work_posture": {
      "enum": ["none", "present_abortable", "present_non_abortable", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
