{
  "schema_version": "1",
  "subject": "demo-sys 0.4.0",
  "actor_name": "demo-sys build.rs",
  "actor_class": "build_script",
  "ambient_inputs": [
    {
      "input_class": "cargo_set_env",
      "source": "cargo",
      "posture": "allowlisted",
      "keys": ["HOST", "TARGET", "OUT_DIR", "OPT_LEVEL"]
    },
    {
      "input_class": "parent_env",
      "source": "parent_process",
      "posture": "allowlisted",
      "keys": ["CC", "CFLAGS", "PKG_CONFIG_PATH"]
    },
    {
      "input_class": "path_search",
      "source": "runner_backend",
      "posture": "allowlisted",
      "paths": ["/usr/bin", "/opt/homebrew/bin", "/opt/homebrew/lib"],
      "notes": "pkg-config, cc, and linker helpers remain reachable via PATH"
    },
    {
      "input_class": "toolchain_selector",
      "source": "rustup",
      "posture": "manual_review_required",
      "keys": ["rust-toolchain.toml", "rustup default toolchain"],
      "notes": "toolchain choice still shapes host binaries even when network is denied"
    }
  ]
}
