{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/async-runtime-assurance-profile/capability-route.receipt.schema.json",
  "title": "async runtime capability route receipt",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "lane_id",
    "capability",
    "provider_kind",
    "activation_requirement",
    "satisfied",
    "evidence_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "lane_id": {
      "type": "string"
    },
    "capability": {
      "type": "string",
      "enum": [
        "sleep",
        "timeout",
        "tcp_stream",
        "udp_socket",
        "spawn_blocking",
        "local_spawn",
        "manual_review_required"
      ]
    },
    "provider_kind": {
      "type": "string",
      "enum": [
        "runtime_core",
        "resource_driver",
        "runtime_context",
        "hal_time_driver",
        "integrated_timer_queue",
        "priority_dispatcher",
        "compatibility_adapter",
        "application_specific",
        "manual_review_required"
      ]
    },
    "activation_requirement": {
      "type": "string",
      "enum": [
        "enabled_by_default",
        "builder_flag_required",
        "runtime_context_required",
        "hal_feature_required",
        "dispatchers_required",
        "adapter_required",
        "application_specific",
        "manual_review_required"
      ]
    },
    "satisfied": {
      "type": "boolean"
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "documentation_only",
        "documentation_plus_metrics",
        "documentation_plus_on_target_measurement",
        "imported_assurance_artifact",
        "manual_review_required"
      ]
    },
    "activation_reference": {
      "type": "string"
    },
    "unmet_reason": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}