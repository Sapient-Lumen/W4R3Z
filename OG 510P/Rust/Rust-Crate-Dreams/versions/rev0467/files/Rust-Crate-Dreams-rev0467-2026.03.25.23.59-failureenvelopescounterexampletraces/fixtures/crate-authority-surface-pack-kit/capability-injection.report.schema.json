{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityInjectionReport",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "injectable"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "injectable": {
            "type": "boolean"
          },
          "mechanism": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
