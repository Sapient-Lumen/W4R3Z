{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/cargo-sandbox-capability-policy-kit/sandbox-support-bundle.manifest.schema.json",
  "title": "Sandbox Support Bundle Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "bundle_members"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "created_from": {
      "type": "string"
    },
    "bundle_members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
