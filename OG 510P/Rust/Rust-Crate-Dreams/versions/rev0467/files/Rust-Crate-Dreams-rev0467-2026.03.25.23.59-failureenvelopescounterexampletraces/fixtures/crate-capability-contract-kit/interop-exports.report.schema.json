{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interop exports report",
  "type": "object",
  "required": [
    "schema_version",
    "exports"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ecosystem",
          "surface_kind",
          "confidence"
        ],
        "properties": {
          "ecosystem": {
            "type": "string"
          },
          "surface_kind": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
