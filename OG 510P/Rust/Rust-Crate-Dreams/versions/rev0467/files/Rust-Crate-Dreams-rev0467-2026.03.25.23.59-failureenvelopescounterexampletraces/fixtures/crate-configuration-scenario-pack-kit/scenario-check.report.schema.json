{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioCheckReport",
  "type": "object",
  "required": ["crate", "results"],
  "properties": {
    "crate": {"type": "string"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario", "status"],
        "properties": {
          "scenario": {"type": "string"},
          "status": {"enum": ["pass", "fail", "manual_review_required"]},
          "checked_on": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}