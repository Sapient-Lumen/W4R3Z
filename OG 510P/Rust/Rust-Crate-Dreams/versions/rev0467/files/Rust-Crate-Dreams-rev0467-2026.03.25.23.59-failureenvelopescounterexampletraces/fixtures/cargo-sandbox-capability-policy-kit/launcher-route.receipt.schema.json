{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/cargo-sandbox-capability-policy-kit/launcher-route.receipt.schema.json",
  "title": "Launcher Route Receipt",
  "type": "object",
  "required": ["schema_version", "subject", "actor_scope", "route_family", "route_subject", "granularity", "route_mutation_risk"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "actor_scope": {"type": "string"},
    "route_family": {
      "enum": ["direct_exec", "rustc_wrapper", "preload_interceptor", "dedicated_runner", "cargo_native_experiment", "manual_review_required"]
    },
    "route_subject": {
      "enum": ["build_script", "proc_macro_lane", "rustc_host_lane", "mixed_host_lane", "compile_time_deps_workflow", "manual_review"]
    },
    "granularity": {
      "enum": ["separate_actor", "shared_lane", "whole_command", "manual_review_required"]
    },
    "backend": {"type": "string"},
    "route_mutation_risk": {
      "enum": ["none_known", "shared_env_channel", "build_script_can_influence_later_route", "manual_review_required"]
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
