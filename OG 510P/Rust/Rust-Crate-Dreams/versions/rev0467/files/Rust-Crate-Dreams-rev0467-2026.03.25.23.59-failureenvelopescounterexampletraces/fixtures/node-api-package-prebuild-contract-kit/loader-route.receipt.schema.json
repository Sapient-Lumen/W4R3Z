{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/node-api-package-prebuild-contract-kit/loader-route.receipt.schema.json",
  "title": "NodeApiLoaderRouteReceipt",
  "type": "object",
  "required": ["package_name", "route_class", "routes"],
  "properties": {
    "package_name": {"type": "string"},
    "route_class": {
      "type": "string",
      "enum": [
        "node_addons_native_first",
        "native_then_local_build",
        "node_addons_with_default_wasm_fallback",
        "default_only_wasm",
        "manual_review_required"
      ]
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition", "action"],
        "properties": {
          "condition": {"type": "string"},
          "action": {"type": "string"},
          "artifact_pattern": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    },
    "loader_name_alignment": {
      "type": "string",
      "enum": ["aligned", "mismatch_detected", "manual_review_required"]
    }
  }
}
