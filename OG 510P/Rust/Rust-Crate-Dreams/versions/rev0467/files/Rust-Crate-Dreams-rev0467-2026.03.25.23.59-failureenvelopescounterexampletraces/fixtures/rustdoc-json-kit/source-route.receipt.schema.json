{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/source-route.receipt.schema.json",
  "title": "source-route.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "route_class",
    "crate_identity",
    "target_triple",
    "observed_format_version",
    "support_class",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "route_class": {
      "type": "string",
      "enum": [
        "local_cargo_rustdoc",
        "local_rustdoc_direct",
        "docsrs_import",
        "rustup_toolchain_component",
        "manual_file_import",
        "mixed",
        "unknown"
      ]
    },
    "crate_identity": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "source": {"type": "string"}
      },
      "additionalProperties": true
    },
    "toolchain_selector": {"type": "string"},
    "target_triple": {"type": "string"},
    "observed_format_version": {"type": "integer"},
    "compression": {
      "type": "string",
      "enum": ["none", "gzip", "zstd", "unknown"]
    },
    "route_notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "source_authority": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "cargo_rustdoc_invocation",
            "rustdoc_invocation",
            "docsrs_endpoint",
            "rustup_component",
            "manual_observation",
            "unknown"
          ]
        },
        "ref": {"type": "string"}
      },
      "additionalProperties": true
    },
    "support_class": {
      "type": "string",
      "enum": [
        "direct_generation",
        "trusted_import",
        "legacy_import_with_caveats",
        "mixed_manual_review",
        "unknown"
      ]
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": true
}
