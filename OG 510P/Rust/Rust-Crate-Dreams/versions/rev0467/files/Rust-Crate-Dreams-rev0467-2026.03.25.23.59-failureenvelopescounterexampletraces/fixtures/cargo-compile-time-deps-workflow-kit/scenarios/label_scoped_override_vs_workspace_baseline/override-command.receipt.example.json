{
  "schema_version": "0.1",
  "command_roles": [
    {
      "role": "check",
      "command_origin": "rust_analyzer_override",
      "argv": ["cargo", "check", "-p", "{label}", "--message-format=json", "--all-targets"],
      "emits_json": true,
      "placeholder_usage": ["label"],
      "pairing_status": "check_only_override",
      "command_path_mode": "plain_name",
      "wrapper_mode": "none",
      "notes": ["Using {label} narrows the observed package scope and must be reflected in the comparison baseline."]
    }
  ]
}
