{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "font resolution receipt",
  "type": "object",
  "required": [
    "profile",
    "provider",
    "requested_families",
    "resolved_fonts",
    "font_universe_comparable"
  ],
  "properties": {
    "profile": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "bundled_test_pack",
        "system",
        "mixed"
      ]
    },
    "requested_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolved_fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "source",
          "used_for"
        ],
        "properties": {
          "family": {
            "type": "string"
          },
          "postscript_name": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "bundled_test_pack",
              "user_supplied",
              "system"
            ]
          },
          "used_for": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "primary",
                "fallback",
                "emoji",
                "bold",
                "italic"
              ]
            }
          },
          "sha256": {
            "type": "string"
          },
          "path_hint": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "font_universe_comparable": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
