{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/in-place-initialization-adoption-kit/constructor-lane.report.schema.json",
  "title": "Constructor Lane Report",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "constructor_family",
    "move_semantics_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "constructor_family": {
      "enum": [
        "rust_by_value",
        "pin_init",
        "moveit_new",
        "crubit_ctor",
        "ffi_out_ptr",
        "future_language",
        "local_unsafe_adapter"
      ]
    },
    "pin_required": {
      "type": "boolean"
    },
    "move_semantics_class": {
      "enum": [
        "rust_memcpy_move",
        "cxx_constructor_move",
        "no_move_after_commit",
        "unknown"
      ]
    },
    "direct_init_posture": {
      "enum": [
        "direct_ok",
        "pinned_only",
        "caller_storage_only",
        "mixed",
        "unknown"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
