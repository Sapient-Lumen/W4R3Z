{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Migration Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "trait_family",
    "current_recipe",
    "target_recipe",
    "decision",
    "comparability"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "receipt_id": {
      "type": "string"
    },
    "trait_family": {
      "type": "string"
    },
    "current_recipe": {
      "type": "string"
    },
    "target_recipe": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "stay",
        "pilot",
        "migrate",
        "dual-support",
        "blocked"
      ]
    },
    "comparability": {
      "type": "string",
      "enum": [
        "comparable",
        "manual-review-required",
        "not-comparable"
      ]
    },
    "primary_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_up": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
