{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/clippy-safety-profile-waiver-kit/diagnostic-channel.receipt.schema.json",
  "title": "Diagnostic Channel Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "producer",
    "stability",
    "blocking_class",
    "command"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "producer": {
      "enum": [
        "rustc",
        "clippy",
        "cargo"
      ]
    },
    "stability": {
      "enum": [
        "stable",
        "nightly",
        "experimental_adapter"
      ]
    },
    "blocking_class": {
      "enum": [
        "blocking",
        "advisory",
        "manual_review_required"
      ]
    },
    "command": {
      "type": "string"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
