{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/crate-ecosystem-pathfinder-kit/gap-closure.receipt.schema.json",
  "title": "gap-closure.receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "plan_ref",
    "gap_id",
    "prior_basis_refs",
    "produced_artifacts",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "receipt_id": {
      "type": "string"
    },
    "plan_ref": {
      "type": "string"
    },
    "gap_id": {
      "type": "string"
    },
    "prior_basis_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "produced_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "closed",
        "partially_closed",
        "blocked",
        "reopened",
        "manual_review_required"
      ]
    },
    "stage_progress_effect": {
      "type": "string",
      "enum": [
        "none",
        "can_reassess_stage",
        "stage_may_progress",
        "opens_exception_review",
        "opens_new_compare"
      ]
    },
    "remaining_gap_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}