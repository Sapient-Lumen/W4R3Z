{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/crate-example-surface-pack-kit/success-witness.receipt.schema.json",
  "title": "Success witness receipt",
  "type": "object",
  "required": ["quickstart", "witness_class", "confidence"],
  "properties": {
    "quickstart": {"type": "string"},
    "witness_class": {
      "type": "string",
      "enum": [
        "compile_success",
        "normalized_stdout",
        "normalized_stderr",
        "generated_file_present",
        "http_exchange_observed",
        "rendered_doc_fragment",
        "board_or_device_observed",
        "maintainer_summary_only",
        "manual_review_required"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["observed", "partially_observed", "summarized", "manual_review_required"]
    },
    "artifact_refs": {"type": "array", "items": {"type": "string"}},
    "normalization_profile": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
