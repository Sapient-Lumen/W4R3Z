{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/live-update-outcome.report.schema.json",
  "title": "LiveUpdateOutcomeReport",
  "type": "object",
  "required": [
    "subject",
    "attempted_route",
    "observed_outcome",
    "evidence_basis",
    "confidence"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "attempted_route": {
      "type": "string",
      "enum": [
        "ui_reload",
        "asset_reload",
        "function_hotpatch",
        "dynamic_library_reload",
        "relink_without_restart",
        "rebuild_restart",
        "manual_probe"
      ]
    },
    "observed_outcome": {
      "type": "object",
      "required": [
        "class",
        "new_code_reachable",
        "old_code_may_still_run",
        "process_state"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "applied_and_observed",
            "applied_but_incomplete",
            "rejected_before_switch",
            "failed_to_apply",
            "reverted_to_old_code",
            "restart_required",
            "crashed_or_inconsistent",
            "unknown"
          ]
        },
        "new_code_reachable": {
          "type": "boolean"
        },
        "old_code_may_still_run": {
          "type": "boolean"
        },
        "process_state": {
          "type": "string",
          "enum": [
            "running",
            "degraded",
            "restarting",
            "crashed",
            "unknown"
          ]
        },
        "observation_window": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "manual_review_required"
      ]
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
