{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocsExampleLinkageReport",
  "type": "object",
  "required": [
    "links"
  ],
  "properties": {
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["docs_anchor", "example_name", "status"],
        "properties": {
          "docs_anchor": {"type": "string"},
          "example_name": {"type": "string"},
          "status": {
            "enum": [
              "linked",
              "stale",
              "missing",
              "manual_review_required"
            ]
          }
        }
      }
    }
  }
}
