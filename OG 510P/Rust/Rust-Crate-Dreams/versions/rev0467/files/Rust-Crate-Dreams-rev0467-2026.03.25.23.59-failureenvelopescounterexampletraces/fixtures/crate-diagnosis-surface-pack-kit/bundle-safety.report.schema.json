{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/crate-diagnosis-surface-pack-kit/bundle-safety.report.schema.json",
  "title": "Bundle safety report",
  "type": "object",
  "required": ["bundle_name", "verdict", "allowed_classes", "blocked_classes"],
  "properties": {
    "bundle_name": {"type": "string"},
    "verdict": {"type": "string", "enum": ["safe", "safe_with_redaction", "manual_review_required", "unsafe"]},
    "allowed_classes": {"type": "array", "items": {"type": "string"}},
    "blocked_classes": {"type": "array", "items": {"type": "string"}},
    "redactions": {"type": "array", "items": {"type": "string"}},
    "secret_shape_hits": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
