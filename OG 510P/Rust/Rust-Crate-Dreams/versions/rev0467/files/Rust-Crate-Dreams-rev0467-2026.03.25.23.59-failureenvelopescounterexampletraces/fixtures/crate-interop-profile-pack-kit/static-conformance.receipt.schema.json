{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "static conformance receipt",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "package",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "package": {
      "type": "string"
    },
    "verdict": {
      "type": "string"
    },
    "matched_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_coupling_found": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_zones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
