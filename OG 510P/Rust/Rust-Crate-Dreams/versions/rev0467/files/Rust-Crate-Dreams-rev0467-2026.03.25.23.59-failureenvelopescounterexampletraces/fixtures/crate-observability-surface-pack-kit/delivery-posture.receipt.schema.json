{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "delivery-posture.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "signal_family",
    "route",
    "delivery_shape"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "signal_family": {"type": "string"},
    "route": {
      "type": "string",
      "enum": [
        "fmt_stdout",
        "fmt_stderr",
        "console",
        "otel_trace",
        "otel_metric",
        "otel_log",
        "manual_review_required"
      ]
    },
    "delivery_shape": {
      "type": "string",
      "enum": [
        "blocking_inline",
        "async_buffered_backpressure",
        "async_buffered_lossy",
        "batch_async_flush_dependent",
        "periodic_reader",
        "manual_review_required"
      ]
    },
    "sampling_shape": {
      "type": "string",
      "enum": [
        "unsampled",
        "head_sampled",
        "tail_sampled",
        "collector_sampled",
        "mixed",
        "manual_review_required"
      ]
    },
    "aggregation_shape": {
      "type": "string",
      "enum": [
        "per_event",
        "aggregated_window",
        "manual_review_required"
      ]
    },
    "flush_requirement": {
      "type": "string",
      "enum": [
        "none",
        "worker_guard_drop",
        "provider_last_ref_drop",
        "force_flush_or_shutdown",
        "timeout_sensitive",
        "manual_review_required"
      ]
    },
    "evidence_strength": {
      "type": "string",
      "enum": [
        "maintainer_declared",
        "observed_in_example",
        "observed_in_test",
        "imported_from_upstream_docs",
        "manual_review_required"
      ]
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
