{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GuidanceChannelReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "failure_case",
    "channels"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "failure_case": {
      "type": "string"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "channel_kind",
          "claim_strength"
        ],
        "properties": {
          "channel_kind": {
            "enum": [
              "compiler_diagnostic",
              "ui_stderr_snapshot",
              "proc_macro_emit",
              "miette_metadata",
              "docs_anchor",
              "manual_review_required"
            ]
          },
          "claim_strength": {
            "enum": [
              "primary",
              "supporting",
              "fallback_only",
              "not_currently_reliable",
              "manual_review_required"
            ]
          },
          "source_ref": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
