{
  "schema_version": "0.1",
  "target_dir_lane": {
    "configured_mode": "rust_analyzer_subdir",
    "sharing": "isolated_for_tool",
    "duplication_tradeoff": "duplicate_artifacts",
    "notes": [
      "rust-analyzer-specific target dir prevents one class of lock contention."
    ]
  },
  "build_dir_lane": {
    "configured_mode": "workspace_default",
    "sharing": "shared_with_terminal",
    "layout_compatibility": "supports_separate_build_dir",
    "notes": [
      "No separate build-dir override was observed for the tool lane."
    ]
  },
  "final_artifact_root_relation": "target_dir",
  "exactness": "conservative",
  "blockers": [
    "build_dir_isolation_not_observed"
  ]
}
