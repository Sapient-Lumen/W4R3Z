{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SunsetCheckReport",
  "type": "object",
  "required": [
    "crate",
    "status"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "warning",
        "manual_review_required",
        "broken"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "result"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          }
        }
      }
    }
  }
}
