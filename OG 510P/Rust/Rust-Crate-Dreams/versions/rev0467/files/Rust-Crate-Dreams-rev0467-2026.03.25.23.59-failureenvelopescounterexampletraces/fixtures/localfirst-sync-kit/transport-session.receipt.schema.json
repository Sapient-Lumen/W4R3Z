{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transport Session Receipt",
  "type": "object",
  "required": ["schema_version", "session_id", "repo_id", "transport_family", "ordering_guarantee", "result"],
  "properties": {
    "schema_version": {"type": "string"},
    "session_id": {"type": "string"},
    "repo_id": {"type": "string"},
    "transport_family": {"type": "string"},
    "protocol_id": {"type": "string"},
    "bootstrap_method": {"type": "string"},
    "bootstrap_redacted": {"type": "boolean"},
    "ordering_guarantee": {"type": "string"},
    "path_mode": {"type": "string", "enum": ["direct", "relay_fallback", "relay_only", "unknown"]},
    "relay_class": {"type": "string", "enum": ["none", "public", "dedicated", "self_hosted", "unknown"]},
    "initiator_replica_id": {"type": "string"},
    "peer_replica_id": {"type": "string"},
    "bytes_sent": {"type": "integer"},
    "bytes_received": {"type": "integer"},
    "message_count": {"type": "integer"},
    "result": {"type": "string"},
    "failure_class": {"type": "string"},
    "caveats": {"type": "array", "items": {"type": "string"}}
  }
}
