{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "attempt-topology.report",
  "type": "object",
  "required": ["artifact", "subject", "topology", "max_outstanding_attempts", "request_clone_required", "loser_cancellation"],
  "properties": {
    "artifact": {"const": "attempt-topology.report"},
    "subject": {"type": "string"},
    "topology": {"enum": ["single_attempt", "serial_retry", "hedged_parallel", "retry_then_hedge", "manual_review_required"]},
    "max_outstanding_attempts": {"type": ["integer", "null"], "minimum": 1},
    "request_clone_required": {"type": "boolean"},
    "loser_cancellation": {"enum": ["first_success_cancels_others", "none", "not_applicable", "manual_review_required"]},
    "parallel_trigger_basis": {"enum": ["none", "latency_percentile", "fixed_delay", "manual_review_required"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
