{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-resolve-why/platform-coverage.report.schema.json",
  "title": "Cargo resolve why — platform coverage report",
  "type": "object",
  "required": ["schema_version", "requested_targets", "metadata_scope", "clauses", "overall_exactness"],
  "properties": {
    "schema_version": {"type": "string"},
    "requested_targets": {"type": "array", "items": {"type": "string"}},
    "metadata_scope": {
      "type": "object",
      "required": ["filter_platform_mode", "includes_all_targets"],
      "properties": {
        "filter_platform_mode": {"type": "string", "enum": ["not_used", "explicit_triple", "host_tuple"]},
        "filter_platform_value": {"type": "string"},
        "includes_all_targets": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["manifest_condition", "dependency", "status", "exactness"],
        "properties": {
          "manifest_condition": {"type": "string"},
          "dependency": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["included", "excluded_nonmatching_target", "visible_only_in_all_targets_graph", "unknown"]
          },
          "evidence_basis": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["cargo_metadata", "manual_manifest_scan", "unit_graph", "conservative_inference"]
            }
          },
          "exactness": {"type": "string", "enum": ["exact", "conservative", "manual_review_required"]},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "overall_exactness": {"type": "string", "enum": ["exact", "conservative", "manual_review_required"]},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
