{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature-intent.report",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "positive_requests",
    "negative_requests"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "positive_requests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_requests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workspace_pressure_overrode_subject": {
      "type": "boolean"
    },
    "exactness": {
      "type": "string",
      "enum": [
        "exact",
        "conservative",
        "manual_review_required"
      ]
    }
  },
  "additionalProperties": true
}
