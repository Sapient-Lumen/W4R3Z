{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "observed capabilities receipt",
  "type": "object",
  "required": [
    "schema_version",
    "package_name",
    "manifest_facts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "package_name": {
      "type": "string"
    },
    "manifest_facts": {
      "type": "object",
      "properties": {
        "rust_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "has_build_script": {
          "type": "boolean"
        },
        "links": {
          "type": [
            "string",
            "null"
          ]
        },
        "proc_macro": {
          "type": "boolean"
        },
        "keywords_count": {
          "type": "integer"
        },
        "categories_count": {
          "type": "integer"
        },
        "has_package_metadata_contract": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "docsrs_facts": {
      "type": "object",
      "additionalProperties": true
    },
    "rustdoc_json_facts": {
      "type": "object",
      "additionalProperties": true
    },
    "observed_interop_exports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
