{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Lock Contention Witness Kit \u2014 build analysis session link",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "link_role"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "link_role": {
      "type": "string",
      "enum": [
        "supporting_context",
        "same_root_correlated",
        "manual_annotation"
      ]
    },
    "claims_not_made": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}