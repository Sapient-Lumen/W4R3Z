{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rust Android Mobile Kit page-size compatibility report",
  "type": "object",
  "required": [
    "status",
    "checked_outputs"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "unknown",
        "needs_rebuild",
        "manual_review_required"
      ]
    },
    "policy_class": {
      "type": "string",
      "enum": [
        "android_16kb_release_gate",
        "advisory",
        "manual_review_required"
      ]
    },
    "checked_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "android_api_level": {
      "type": [
        "integer",
        "null"
      ]
    },
    "ndk_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "declared",
        "locally_checked",
        "imported_build_receipt",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
