{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "publicir.diff.json",
  "type": "object",
  "required": ["schema_version", "baseline", "candidate", "classification"],
  "properties": {
    "schema_version": {"type": "string"},
    "baseline": {"type": "string"},
    "candidate": {"type": "string"},
    "classification": {
      "type": "string",
      "enum": ["compatible", "capability_gap", "snapshot_drift", "unstable_surface_touched", "bridge_required", "manual_review_required"]
    },
    "changed_items": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
