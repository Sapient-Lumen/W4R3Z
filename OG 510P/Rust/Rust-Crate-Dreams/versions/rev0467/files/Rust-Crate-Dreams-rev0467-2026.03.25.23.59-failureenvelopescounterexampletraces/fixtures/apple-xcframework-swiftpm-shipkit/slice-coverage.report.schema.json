{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/apple-xcframework-swiftpm-shipkit/slice-coverage.report.schema.json",
  "title": "AppleSliceCoverageReport",
  "type": "object",
  "required": ["bundle_name", "coverage_class", "declared_platforms", "shipped_slices"],
  "properties": {
    "bundle_name": {"type": "string"},
    "coverage_class": {
      "type": "string",
      "enum": [
        "complete_declared_matrix",
        "declared_platform_gap",
        "simulator_gap",
        "wrapper_claim_exceeds_bundle",
        "manual_review_required"
      ]
    },
    "declared_platforms": {"type": "array", "items": {"type": "string"}},
    "shipped_slices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "arch", "artifact"],
        "properties": {
          "platform": {"type": "string"},
          "arch": {"type": "string"},
          "variant": {"type": "string"},
          "artifact": {"type": "string"},
          "linkage": {"type": "string", "enum": ["static", "dynamic", "unknown"]}
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "reason"],
        "properties": {
          "platform": {"type": "string"},
          "reason": {"type": "string"},
          "severity": {"type": "string", "enum": ["warning", "error", "manual_review"]}
        }
      }
    }
  }
}
