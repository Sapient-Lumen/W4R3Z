{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manual-review-debt.report",
  "type": "object",
  "required": [
    "debt_items"
  ],
  "properties": {
    "debt_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["debt_class", "severity", "summary"],
        "properties": {
          "debt_class": {
            "enum": [
              "unsupported_construct",
              "macro_visibility_gap",
              "profile_durability_gap",
              "host_target_gap",
              "policy_exception"
            ]
          },
          "severity": {
            "enum": ["low", "medium", "high", "blocking"]
          },
          "summary": {"type": "string"},
          "affected_refs": {
            "type": "array",
            "items": {"type": "string"}
          },
          "close_condition": {"type": "string"},
          "owner": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
