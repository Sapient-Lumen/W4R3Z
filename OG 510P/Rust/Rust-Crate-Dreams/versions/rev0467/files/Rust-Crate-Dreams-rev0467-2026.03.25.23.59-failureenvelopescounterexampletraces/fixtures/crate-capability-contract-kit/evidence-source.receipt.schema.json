{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence source receipt",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "freshness"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "freshness": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
