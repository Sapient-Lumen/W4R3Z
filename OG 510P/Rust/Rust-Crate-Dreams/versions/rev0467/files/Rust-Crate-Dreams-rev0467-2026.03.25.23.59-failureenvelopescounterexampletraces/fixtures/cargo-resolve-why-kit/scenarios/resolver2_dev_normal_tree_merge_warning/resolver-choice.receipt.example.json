{
  "schema_version": "0.1.0",
  "command": ["cargo", "tree", "-e", "features"],
  "cargo": {
    "resolver_version": "2"
  },
  "data_sources": ["cargo_tree_features", "manual_manifest_scan", "conservative_inference"],
  "build_equivalence": "manual_review_required",
  "selection_scope": {
    "command_kind": "build",
    "workspace_members": ["tt"],
    "targets": ["host-tuple"]
  },
  "assumptions": [
    "resolver v2 dev features should remain separate when dev targets are not being built"
  ],
  "unknowns": [
    "stable cargo tree output may merge dev and normal lane features for display convenience"
  ],
  "manual_review_required": true,
  "redactions": {
    "private_paths": true,
    "private_package_names": false
  }
}
