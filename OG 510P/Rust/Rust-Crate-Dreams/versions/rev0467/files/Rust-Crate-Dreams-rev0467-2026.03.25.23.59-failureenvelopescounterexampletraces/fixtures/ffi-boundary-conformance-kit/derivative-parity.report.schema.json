{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "derivative-parity.report",
  "type": "object",
  "required": [
    "subject",
    "authority_artifact",
    "derivative_artifact",
    "parity_class",
    "verdict"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "authority_artifact": {
      "type": "string"
    },
    "derivative_artifact": {
      "type": "string"
    },
    "parity_class": {
      "type": "string"
    },
    "receiver_visible_differences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "difference_causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof_class": {
      "type": "string"
    },
    "manual_review_zones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "type": "string"
    }
  }
}
