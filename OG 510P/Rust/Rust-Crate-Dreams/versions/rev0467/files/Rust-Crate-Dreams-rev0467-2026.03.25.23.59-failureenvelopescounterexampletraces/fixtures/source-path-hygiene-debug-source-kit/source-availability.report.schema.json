{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/source-path-hygiene-debug-source-kit/source-availability.report.schema.json",
  "title": "SourceAvailabilityReport",
  "type": "object",
  "required": ["verdicts"],
  "properties": {
    "verdicts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "workspace_sources_ok",
          "sysroot_sources_missing",
          "compiler_sources_missing",
          "overtrimmed_for_debugging",
          "privacy_goal_met",
          "manual_review_required"
        ]
      }
    },
    "component_hints": {"type": "array", "items": {"type": "string", "enum": ["rust-src", "rustc-dev", "none", "manual_review_required"]}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
