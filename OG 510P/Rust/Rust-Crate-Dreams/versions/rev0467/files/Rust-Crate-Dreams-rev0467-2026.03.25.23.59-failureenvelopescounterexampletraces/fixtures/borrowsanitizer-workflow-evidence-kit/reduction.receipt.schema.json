{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reduction Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "reduction_id",
    "status",
    "subject"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "reduction_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "not-started",
        "in-progress",
        "reduced",
        "blocked",
        "manual-review-required"
      ]
    },
    "before_lines": {
      "type": "integer"
    },
    "after_lines": {
      "type": "integer"
    },
    "preserved_signal": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
