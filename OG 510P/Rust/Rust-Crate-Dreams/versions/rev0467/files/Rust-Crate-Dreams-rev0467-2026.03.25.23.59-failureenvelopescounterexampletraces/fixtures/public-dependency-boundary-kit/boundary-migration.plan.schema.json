{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "boundary-migration.plan",
  "type": "object",
  "required": [
    "crate",
    "actions"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "dependency",
          "rationale"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "dependency": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "semver_risk": {
            "type": "string"
          }
        }
      }
    }
  }
}
