{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.local/fixtures/cargo-build-insights/build-insight-session.schema.json",
  "title": "cargo-build-insights normalized session",
  "type": "object",
  "required": [
    "bundle_schema_version",
    "insight_session_id",
    "imported_sources",
    "command_receipt",
    "workspace_scope",
    "metrics_summary",
    "judgments"
  ],
  "properties": {
    "bundle_schema_version": {"type": "string"},
    "insight_session_id": {"type": "string"},
    "imported_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "source_ref"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["cargo_report", "cargo_jsonl", "cargo_json_messages", "cargo_metadata", "other"]
          },
          "source_ref": {"type": "string"},
          "session_id": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "command_receipt": {
      "type": "object",
      "required": ["command", "toolchain_channel"],
      "properties": {
        "command": {"type": "string"},
        "toolchain_channel": {"type": "string"},
        "profile": {"type": "string"},
        "target": {"type": "string"}
      },
      "additionalProperties": true
    },
    "workspace_scope": {
      "type": "object",
      "required": ["selection_kind"],
      "properties": {
        "selection_kind": {"type": "string"},
        "packages": {"type": "array", "items": {"type": "string"}},
        "targets": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "metrics_summary": {
      "type": "object",
      "properties": {
        "total_wall_time_ms": {"type": "number"},
        "rebuilt_units": {"type": "integer", "minimum": 0},
        "reused_units": {"type": "integer", "minimum": 0},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "label"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["observed_fact", "conservative_inference", "manual_review_required"]
          },
          "label": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "unknown_upstream_fields": {"type": "object"}
  },
  "additionalProperties": true
}
