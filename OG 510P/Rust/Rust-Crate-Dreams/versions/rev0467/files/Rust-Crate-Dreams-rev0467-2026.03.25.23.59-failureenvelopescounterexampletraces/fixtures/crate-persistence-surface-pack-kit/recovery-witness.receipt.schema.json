{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persistence Recovery Witness Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "surface",
    "witness_classes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "surface": {
      "type": "string"
    },
    "witness_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "declared_only",
          "fixture_observed_clean_restart",
          "fixture_observed_process_crash",
          "fixture_observed_power_loss_proxy",
          "integrity_check_observed",
          "repair_path_observed",
          "external_mutation_detected",
          "manual_review_required"
        ]
      }
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
