{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-build-dir-consumer-transition/transition.receipt.schema.json",
  "title": "Cargo build-dir transition receipt",
  "type": "object",
  "required": ["schema_version", "cargo_version", "build_dir_mode", "overall_verdict"],
  "properties": {
    "schema_version": {"type": "string"},
    "cargo_version": {"type": "string"},
    "build_dir_mode": {"type": "string"},
    "overall_verdict": {"type": "string", "enum": ["safe_noop", "adapter_available", "manual_review_required", "blocked_on_upstream"]},
    "risky_consumers": {"type": "array", "items": {"type": "string"}},
    "adapters_offered": {"type": "array", "items": {"type": "string"}},
    "redaction_policy": {"type": "string"}
  },
  "additionalProperties": false
}
