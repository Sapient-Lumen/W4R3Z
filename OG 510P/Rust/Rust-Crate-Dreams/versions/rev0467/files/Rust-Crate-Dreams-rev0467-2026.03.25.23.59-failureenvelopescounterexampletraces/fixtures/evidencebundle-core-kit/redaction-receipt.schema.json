{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/evidencebundle-core-kit/redaction-receipt.schema.json",
  "title": "Evidence Bundle Redaction Receipt",
  "type": "object",
  "required": ["schema_version", "bundle_id", "operations"],
  "properties": {
    "schema_version": {"const": "evidencebundle-redaction@1"},
    "bundle_id": {"type": "string"},
    "policy_id": {"type": ["string", "null"]},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "action", "reason"],
        "properties": {
          "path": {"type": "string"},
          "action": {"enum": ["removed", "masked", "placeholder", "truncated"]},
          "reason": {"type": "string"},
          "preserved_sha256": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
