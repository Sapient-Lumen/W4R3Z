{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "migration hazards report",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "hazards"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "severity"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
