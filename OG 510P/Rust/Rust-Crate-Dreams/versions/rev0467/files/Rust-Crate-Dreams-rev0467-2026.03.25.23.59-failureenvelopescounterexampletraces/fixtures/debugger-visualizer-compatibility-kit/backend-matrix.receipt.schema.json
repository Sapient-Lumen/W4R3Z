{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/debugger-visualizer-compatibility-kit/backend-matrix.receipt.schema.json",
  "title": "BackendMatrixReceipt",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["backend", "target", "verdict"],
        "properties": {
          "backend": {"type": "string"},
          "target": {"type": "string"},
          "debugger_version": {"type": "string"},
          "verdict": {"type": "string", "enum": ["supported", "unsupported_by_design", "safe_path_blocked", "asset_failed", "backend_failed", "manual_review_required"]},
          "asset_refs": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "render_golden": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
