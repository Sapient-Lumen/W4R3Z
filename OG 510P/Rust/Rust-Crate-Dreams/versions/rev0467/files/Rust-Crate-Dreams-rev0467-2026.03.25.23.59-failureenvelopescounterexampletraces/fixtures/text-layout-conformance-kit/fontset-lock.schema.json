{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fontset lock",
  "type": "object",
  "required": ["profile", "fonts"],
  "properties": {
    "profile": {"type": "string"},
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family", "source", "sha256"],
        "properties": {
          "family": {"type": "string"},
          "source": {"type": "string", "enum": ["bundled_test_pack", "user_supplied", "system"]},
          "sha256": {"type": "string"},
          "path_hint": {"type": "string"},
          "coverage": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "fallback_order": {"type": "array", "items": {"type": "string"}},
    "font_universe_comparable": {"type": "boolean"}
  },
  "additionalProperties": false
}
