{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthorityProfileReport",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "declared",
              "verified",
              "warn",
              "manual_review_required",
              "failed"
            ]
          },
          "authority": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "budget_ref": {
            "type": "string"
          },
          "witness_status": {
            "enum": [
              "passed_under_restriction",
              "failed_under_restriction",
              "not_run",
              "manual_review_required"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
