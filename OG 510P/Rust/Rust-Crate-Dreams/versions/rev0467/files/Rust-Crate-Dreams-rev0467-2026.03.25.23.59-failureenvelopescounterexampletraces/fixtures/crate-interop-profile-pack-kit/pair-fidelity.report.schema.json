{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PairFidelityReport",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "pairs"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "consumer",
          "fidelity_class"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "consumer": {
            "type": "string"
          },
          "fidelity_class": {
            "enum": [
              "static_only",
              "static_plus_pair_build",
              "behaviorally_observed",
              "adapter_assumed",
              "sampled_pair_only",
              "manual_review_required"
            ]
          },
          "checked_dimensions": {
            "type": "array",
            "items": {
              "enum": [
                "provider_api",
                "consumer_api",
                "feature_set",
                "adapter_path",
                "body_type",
                "error_type",
                "runtime_boundary",
                "behavior_probe",
                "manual_review_boundary_recorded"
              ]
            }
          },
          "missing_dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
