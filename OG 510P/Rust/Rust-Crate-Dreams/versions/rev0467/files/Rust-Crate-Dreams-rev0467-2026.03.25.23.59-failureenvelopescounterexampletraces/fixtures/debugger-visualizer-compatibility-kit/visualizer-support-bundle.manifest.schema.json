              "visualizer_assets_manifest",
              "activation_route_receipt",
              "formatter_origin_receipt",
              "probe_surface_receipt",
              "comparison_basis_receipt",
              "backend_matrix_receipt",
              "render_golden_report",
              "embed_vs_external_report",
              "visualizer_drift_diff",
              "notes"
            ]
          },
          "path": {"type": "string"},
          "redacted": {"type": "boolean"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "summary": {"type": "array", "items": {"type": "string"}}
  }
}
