{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlumbingReceipt",
  "type": "object",
  "required": [
    "commands",
    "input_behavior",
    "classification"
  ],
  "properties": {
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_behavior": {
      "enum": [
        "consumed_directly",
        "reread_from_disk",
        "fallback_reconstructed"
      ]
    },
    "classification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
