{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/vendoring-policy.report.schema.json",
  "title": "vendoring-policy.report",
  "type": "object",
  "required": ["schema_version", "result", "findings"],
  "properties": {
    "schema_version": {"type": "string"},
    "result": {"enum": ["allowed", "blocked", "manual_review_required"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "verdict", "message"],
        "properties": {
          "name": {"type": "string"},
          "verdict": {"enum": ["allowed", "blocked", "manual_review_required"]},
          "requested_mode": {"enum": ["system", "vendored", "override", "auto", "unknown"]},
          "final_mode": {"enum": ["system_only", "prefer_system", "auto_fallback_to_vendored", "vendored_only", "override_only", "blocked_by_policy", "manual_review_required"]},
          "policy_reason": {"enum": ["airgapped", "distro_policy", "security_patchability", "feature_unification", "user_override", "missing_system_dep", "missing_toolchain", "unknown"]},
          "message": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
