{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kernel report",
  "type": "object",
  "required": [
    "schema_version",
    "kernel",
    "backend",
    "correctness",
    "benchmarks"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "kernel": {
      "type": "string"
    },
    "backend": {
      "type": "string"
    },
    "correctness": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "cases": {
          "type": "integer"
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "throughput": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    }
  }
}