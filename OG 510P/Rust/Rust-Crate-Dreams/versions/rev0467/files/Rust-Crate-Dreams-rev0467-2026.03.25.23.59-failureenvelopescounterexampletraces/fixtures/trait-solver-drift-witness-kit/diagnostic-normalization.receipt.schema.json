{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/trait-solver-drift-witness-kit/diagnostic-normalization.receipt.schema.json",
  "title": "Diagnostic Normalization Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "transforms",
    "diagnostic_verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "transforms": {
      "type": "array",
      "items": {
        "enum": [
          "path_remap",
          "span_elision",
          "help_note_filter",
          "ordering_insensitive_compare",
          "message_substring_match",
          "none"
        ]
      }
    },
    "diagnostic_verdict": {
      "enum": [
        "raw_difference",
        "normalized_equivalent",
        "manual_review_required"
      ]
    },
    "proof_tree_sensitive": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
