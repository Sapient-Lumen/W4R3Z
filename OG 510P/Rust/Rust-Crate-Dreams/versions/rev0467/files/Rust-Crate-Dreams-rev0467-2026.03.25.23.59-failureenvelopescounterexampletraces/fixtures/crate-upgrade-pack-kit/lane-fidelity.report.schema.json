{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LaneFidelityReport",
  "type": "object",
  "required": [
    "schema_version",
    "from_version",
    "to_version",
    "fidelity_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "from_version": {
      "type": "string"
    },
    "to_version": {
      "type": "string"
    },
    "fidelity_class": {
      "enum": [
        "fully_observed",
        "sampled",
        "recipe_only",
        "fix_only",
        "docs_only",
        "workspace_subset_only",
        "manual_review_required"
      ]
    },
    "dimensions_checked": {
      "type": "object",
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "config_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "package_subsets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "excluded_lanes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
