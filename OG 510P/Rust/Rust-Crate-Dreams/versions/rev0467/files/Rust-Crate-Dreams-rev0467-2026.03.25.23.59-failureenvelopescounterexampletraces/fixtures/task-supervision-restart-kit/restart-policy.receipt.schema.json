{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "restart-policy.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "restart_class",
    "failure_triggers",
    "backoff_policy",
    "meltdown_policy"
  ],
  "properties": {
    "artifact": {"const": "restart-policy.receipt"},
    "subject": {"type": "string"},
    "restart_class": {
      "enum": ["permanent", "transient", "temporary", "mixed", "manual_review_required"]
    },
    "failure_triggers": {
      "type": "array",
      "items": {
        "enum": ["panic", "abnormal_exit", "normal_exit", "hung_deadline", "startup_failure", "external_kill", "manual_review_required"]
      }
    },
    "backoff_policy": {
      "enum": ["none", "fixed_delay", "exponential_jitter", "custom", "manual_review_required"]
    },
    "meltdown_policy": {
      "enum": ["none", "restart_window_shutdown", "restart_window_resettable", "manual_review_required"]
    },
    "max_restarts": {"type": ["integer", "null"], "minimum": 0},
    "max_window_seconds": {"type": ["number", "null"], "minimum": 0},
    "reset_after_seconds": {"type": ["number", "null"], "minimum": 0},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
