{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/async-runtime-assurance-profile/compatibility-bridge.report.schema.json",
  "title": "async runtime compatibility bridge report",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "bridge_name",
    "source_surface",
    "target_surface",
    "classification",
    "preserved_constraints",
    "residual_review_debt"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "bridge_name": {
      "type": "string"
    },
    "source_surface": {
      "type": "string"
    },
    "target_surface": {
      "type": "string"
    },
    "classification": {
      "type": "string",
      "enum": [
        "trait_or_context_bridge_only",
        "partial_capability_bridge",
        "manual_review_required"
      ]
    },
    "preserved_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities_helped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_solved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residual_review_debt": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}