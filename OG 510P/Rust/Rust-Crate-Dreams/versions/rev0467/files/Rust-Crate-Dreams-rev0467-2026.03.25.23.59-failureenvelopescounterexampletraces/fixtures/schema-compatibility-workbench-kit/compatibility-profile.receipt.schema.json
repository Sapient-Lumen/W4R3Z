{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "compatibility-profile.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "engine_family",
    "profile_kind",
    "rule_or_mode",
    "gate_threshold",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "engine_family": {
      "type": "string",
      "enum": [
        "buf",
        "oasdiff",
        "jsonschema_validation",
        "schema_registry",
        "native_rust_checker",
        "manual_review_required"
      ]
    },
    "profile_kind": {
      "type": "string",
      "enum": [
        "client_api",
        "server_api",
        "generated_source",
        "wire_encoding",
        "wire_and_json_encoding",
        "registry_backward",
        "registry_forward",
        "registry_full",
        "validation_only",
        "manual_review_required"
      ]
    },
    "rule_or_mode": {"type": "string"},
    "gate_threshold": {
      "type": "string",
      "enum": [
        "info",
        "warn",
        "err",
        "pass_fail_engine_default",
        "manual_review_required"
      ]
    },
    "ignored_rule_count": {"type": "integer", "minimum": 0},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
