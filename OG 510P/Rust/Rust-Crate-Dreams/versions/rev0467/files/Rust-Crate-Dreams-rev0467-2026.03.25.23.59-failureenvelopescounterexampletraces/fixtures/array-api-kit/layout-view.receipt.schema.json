{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "layout-view.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "crate",
    "default_order",
    "arbitrary_strides",
    "borrowed_views"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "proposal_id": {
      "const": "P-0003"
    },
    "crate": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "default_order": {
      "enum": [
        "row_major",
        "column_major",
        "not_applicable",
        "manual_review_required"
      ]
    },
    "alternate_orders": {
      "type": "array",
      "items": {
        "enum": [
          "row_major",
          "column_major",
          "custom_strides"
        ]
      }
    },
    "arbitrary_strides": {
      "type": "boolean"
    },
    "borrowed_views": {
      "enum": [
        "supported",
        "read_only_only",
        "not_supported",
        "manual_review_required"
      ]
    },
    "mutation_views": {
      "enum": [
        "supported",
        "not_supported",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
