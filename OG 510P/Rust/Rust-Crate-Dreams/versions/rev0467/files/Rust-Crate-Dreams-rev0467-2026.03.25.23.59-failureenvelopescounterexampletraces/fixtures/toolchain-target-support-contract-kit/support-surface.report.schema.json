{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Support Surface Report",
  "type": "object",
  "required": ["schema_version", "axes"],
  "properties": {
    "schema_version": {"type": "string"},
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "state"],
        "properties": {
          "subject": {"type": "string"},
          "state": {
            "type": "string",
            "enum": [
              "fully_supported",
              "ci_verified",
              "docs_default_surface",
              "docs_only",
              "compile_only",
              "nightly_only",
              "manual_setup_required",
              "unknown"
            ]
          },
          "evidence": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
