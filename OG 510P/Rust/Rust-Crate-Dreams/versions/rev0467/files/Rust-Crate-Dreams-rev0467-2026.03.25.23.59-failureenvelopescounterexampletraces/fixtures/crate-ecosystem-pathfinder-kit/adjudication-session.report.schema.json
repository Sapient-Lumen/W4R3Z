{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pathfinder Adjudication Session Report",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "opened_at",
    "packet_refs",
    "conflicts",
    "overall_outcome",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "packet_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "weighting_policy_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "conflict_id",
          "subject",
          "route_set",
          "outcome"
        ],
        "properties": {
          "conflict_id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "route_set": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "keep_prior_claim",
              "accept_new_claim",
              "split_scope",
              "freeze_with_exception",
              "manual_review_required",
              "open_transition_review"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "overall_outcome": {
      "type": "string",
      "enum": [
        "carry_forward_keep",
        "carry_forward_partial",
        "split_scope",
        "manual_review_required",
        "open_transition_review"
      ]
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
