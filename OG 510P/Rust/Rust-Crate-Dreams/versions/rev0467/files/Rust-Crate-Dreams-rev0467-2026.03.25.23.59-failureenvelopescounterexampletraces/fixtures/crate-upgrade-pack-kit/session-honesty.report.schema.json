{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeSessionHonestyReport",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "overall_posture",
    "session_groups"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "overall_posture": {
      "type": "string",
      "enum": [
        "single_native_session",
        "single_capture_without_native_session",
        "aligned_multi_capture_family",
        "cross_session_comparison",
        "mixed_session_synthesis",
        "unknown"
      ]
    },
    "session_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group_id",
          "capture_refs",
          "coherence_class",
          "summary_join_posture"
        ],
        "properties": {
          "group_id": {
            "type": "string"
          },
          "capture_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "native_session_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coherence_class": {
            "type": "string",
            "enum": [
              "single_native_session",
              "single_capture_without_native_session",
              "replay_of_single_native_session",
              "aligned_multi_capture_family",
              "cross_session_diff",
              "mixed_sessions",
              "unknown"
            ]
          },
          "alignment_basis": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "same_native_session_id",
                "same_capture_family",
                "same_workspace_subject",
                "same_package_selection",
                "same_feature_selection",
                "same_target_selection",
                "same_profile",
                "same_toolchain_posture",
                "same_lockfile_posture",
                "explicit_diff_artifact",
                "manual_join"
              ]
            }
          },
          "summary_join_posture": {
            "type": "string",
            "enum": [
              "single_session_safe",
              "comparison_only",
              "requires_mixed_session_warning",
              "not_safe_for_summary"
            ]
          },
          "disclosure_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
