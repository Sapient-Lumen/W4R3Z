{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/a11ylab/tree.snapshot.schema.json",
  "title": "Accessibility tree snapshot",
  "type": "object",
  "required": ["snapshot_version", "root"],
  "properties": {
    "snapshot_version": {"type": "string"},
    "root": {"type": "string"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "properties": {
          "id": {"type": "string"},
          "parent": {"type": "string"},
          "role": {"type": "string"},
          "name": {"type": "string"},
          "states": {"type": "array", "items": {"type": "string"}},
          "relations": {"type": "array", "items": {"type": "string"}},
          "extensions": {"type": "object"},
          "caveats": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
