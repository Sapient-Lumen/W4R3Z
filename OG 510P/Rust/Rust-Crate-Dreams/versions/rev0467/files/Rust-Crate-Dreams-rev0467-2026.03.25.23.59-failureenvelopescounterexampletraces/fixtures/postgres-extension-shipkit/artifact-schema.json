{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "spec_version",
    "kind",
    "created_at",
    "report"
  ],
  "properties": {
    "spec_version": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "postgres-extension-shipkit"
    },
    "created_at": {
      "type": "string"
    },
    "report": {
      "type": "object",
      "properties": {
        "postgres_versions": {
          "type": "array"
        },
        "platforms": {
          "type": "array"
        },
        "tests": {
          "type": "object"
        },
        "artifacts": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}