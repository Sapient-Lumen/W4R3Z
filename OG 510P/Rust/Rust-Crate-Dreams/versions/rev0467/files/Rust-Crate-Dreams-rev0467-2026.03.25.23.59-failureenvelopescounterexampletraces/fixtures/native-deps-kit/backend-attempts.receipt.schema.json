{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/backend-attempts.receipt.schema.json",
  "title": "backend-attempts.receipt",
  "type": "object",
  "required": ["schema_version", "attempts"],
  "properties": {
    "schema_version": {"type": "string"},
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["backend", "result"],
        "properties": {
          "backend": {"enum": ["pkg-config", "vcpkg", "vendored", "override"]},
          "result": {"enum": ["success", "failure", "skipped", "manual_review_required"]},
          "observed_inputs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
