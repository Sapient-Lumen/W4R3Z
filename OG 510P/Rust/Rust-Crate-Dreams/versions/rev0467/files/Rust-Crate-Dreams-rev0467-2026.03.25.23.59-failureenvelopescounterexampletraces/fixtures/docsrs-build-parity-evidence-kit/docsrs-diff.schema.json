{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docs.rs Diff",
  "type": "object",
  "required": ["schema_version", "changes"],
  "properties": {
    "schema_version": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "summary"],
        "properties": {
          "kind": {"type": "string"},
          "summary": {"type": "string"}
        }
      }
    }
  }
}
