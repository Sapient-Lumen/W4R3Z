{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FollowthroughStateReport",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "steps"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "lane": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "surface",
          "request_state",
          "completion_state"
        ],
        "properties": {
          "step_id": { "type": "string" },
          "surface": {
            "enum": [
              "cargo_manifest",
              "config_file",
              "docs_snippet",
              "example_code",
              "workspace_metadata",
              "runtime_env"
            ]
          },
          "request_state": {
            "enum": [
              "not_needed",
              "active",
              "rerequest_needed",
              "closed"
            ]
          },
          "completion_state": {
            "enum": [
              "not_started",
              "machine_fixed",
              "human_receipted",
              "completed_previous_lane"
            ]
          },
          "completion_lane": { "type": "string" },
          "receipt_ref": { "type": "string" },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "manual_review_remaining": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
