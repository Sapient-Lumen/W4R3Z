{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sbom-workbench-bundle.manifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_name",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "bundle_name": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "share_posture": {
      "type": "string",
      "enum": [
        "internal_review",
        "external_share_safe",
        "manual_review_required"
      ]
    },
    "manual_review_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
