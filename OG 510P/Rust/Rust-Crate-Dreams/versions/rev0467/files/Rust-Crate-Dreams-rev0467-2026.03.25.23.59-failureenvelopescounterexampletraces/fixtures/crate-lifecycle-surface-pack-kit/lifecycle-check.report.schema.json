{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LifecycleCheckReport",
  "type": "object",
  "required": [
    "crate",
    "status"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "failed",
        "manual_review_required"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
