{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradePackRevalidationWindowPolicy",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "review_clock",
    "material_change_triggers"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "baseline_ref": {
      "type": "string"
    },
    "review_clock": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "clock_starts_from",
        "missed_clock_status"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "type": "string",
          "enum": [
            "days",
            "weeks",
            "months",
            "release_pairs"
          ]
        },
        "clock_starts_from": {
          "type": "string",
          "enum": [
            "pack_created_at",
            "last_revalidated_at",
            "citation_head_frozen_at",
            "public_exported_at"
          ]
        },
        "missed_clock_status": {
          "type": "string",
          "enum": [
            "stale_but_usable",
            "expired"
          ]
        }
      },
      "additionalProperties": true
    },
    "material_change_triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "source_head_moved",
          "import_target_changed",
          "dependency_graph_changed",
          "workspace_scope_changed",
          "feature_policy_changed",
          "recipe_surface_changed",
          "toolchain_assumption_changed",
          "behavior_witness_changed",
          "warning_register_changed"
        ]
      }
    },
    "trigger_policy": {
      "type": "string",
      "enum": [
        "any_trigger_expires_pack",
        "selected_triggers_expire_pack",
        "review_required_then_classify"
      ]
    },
    "supersession_rule": {
      "type": "string",
      "enum": [
        "newer_current_pack_supersedes_older_pack",
        "manual_supersession_only"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
