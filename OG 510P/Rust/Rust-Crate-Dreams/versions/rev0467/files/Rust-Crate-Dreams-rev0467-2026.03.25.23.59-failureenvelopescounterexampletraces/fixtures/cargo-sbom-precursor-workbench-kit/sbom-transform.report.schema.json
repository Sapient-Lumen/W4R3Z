{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sbom-transform.report",
  "type": "object",
  "required": ["schema_version", "output_format", "exact_fields", "normalized_fields", "verdict"],
  "properties": {
    "schema_version": {"type": "string"},
    "output_format": {"type": "string", "enum": ["cyclonedx-json", "spdx-json"]},
    "exact_fields": {"type": "array", "items": {"type": "string"}},
    "normalized_fields": {"type": "array", "items": {"type": "string"}},
    "dropped_fields": {"type": "array", "items": {"type": "string"}},
    "verdict": {
      "type": "string",
      "enum": ["exact_projection", "normalized_with_loss", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
