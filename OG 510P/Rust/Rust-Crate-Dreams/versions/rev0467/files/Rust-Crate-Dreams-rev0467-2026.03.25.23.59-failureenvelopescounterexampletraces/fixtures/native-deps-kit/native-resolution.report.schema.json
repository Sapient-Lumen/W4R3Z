{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/native-resolution.report.schema.json",
  "title": "native-resolution.report",
  "type": "object",
  "required": ["schema_version", "result", "libraries"],
  "properties": {
    "schema_version": {"type": "string"},
    "result": {"enum": ["resolved", "failed", "manual_review_required"]},
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "resolution"],
        "properties": {
          "name": {"type": "string"},
          "resolution": {"enum": ["system", "vcpkg", "vendored", "override", "missing", "manual_review_required"]},
          "observed_paths": {"type": "array", "items": {"type": "string"}},
          "suggested_fix": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
