{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradePackReadinessReport",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "readiness_state",
    "review_buckets",
    "next_safest_step"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "readiness_state": {
      "type": "string",
      "enum": [
        "hold",
        "candidate",
        "freeze_ready",
        "manual_review_only"
      ]
    },
    "freeze_target_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_buckets": {
      "type": "object",
      "required": [
        "citation_head_gaps",
        "unpinned_or_floating_imports",
        "authority_conflicts",
        "partial_scope_claims",
        "active_followthrough_steps",
        "posture_blockers",
        "unstable_imports",
        "mixed_session_joins",
        "review_independence_gaps"
      ],
      "properties": {
        "citation_head_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unpinned_or_floating_imports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority_conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partial_scope_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "active_followthrough_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "posture_blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unstable_imports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mixed_session_joins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_independence_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "next_safest_step": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
