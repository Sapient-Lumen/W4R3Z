{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-resolve-why/feature-causes.schema.json",
  "title": "Cargo resolve why — feature causes",
  "type": "object",
  "required": ["schema_version", "features"],
  "properties": {
    "schema_version": {"type": "string"},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package", "feature", "cause_chain"],
        "properties": {
          "package": {"type": "string"},
          "feature": {"type": "string"},
          "activated": {"type": "boolean"},
          "cause_chain": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "summary"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "manifest_edge",
                    "workspace_forwarding",
                    "target_specific_edge",
                    "dev_dependency_edge",
                    "command_line_selection",
                    "lockfile_context",
                    "conservative_inference"
                  ]
                },
                "summary": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
