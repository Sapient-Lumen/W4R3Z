{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pathfinder Recheck Ticket Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "ticket_id",
    "opened_at",
    "basis_lock_ref",
    "task_profile_ref",
    "trigger_set",
    "recommended_action",
    "manual_review_required",
    "supporting_artifacts"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "ticket_id": { "type": "string" },
    "opened_at": { "type": "string", "format": "date-time" },
    "basis_lock_ref": { "type": "string" },
    "task_profile_ref": { "type": "string" },
    "trigger_set": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["trigger_class", "source", "summary"],
        "properties": {
          "trigger_class": {
            "type": "string",
            "enum": [
              "new_release",
              "advisory",
              "docs_surface_shift",
              "support_surface_shift",
              "build_substrate_change",
              "target_or_msrv_shift",
              "local_incident",
              "manual_recheck_request"
            ]
          },
          "source": { "type": "string" },
          "summary": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["note", "review", "urgent"]
          }
        },
        "additionalProperties": false
      }
    },
    "candidate_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_action": {
      "type": "string",
      "enum": [
        "keep_and_record",
        "recheck_compare",
        "open_transition_review",
        "manual_review_required"
      ]
    },
    "manual_review_required": { "type": "boolean" },
    "supporting_artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
