{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceToolLock",
  "type": "object",
  "required": ["tools"],
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "source_id"],
        "properties": {
          "name": {"type": "string"},
          "version": {"type": "string"},
          "source_id": {"type": "string"},
          "binary": {"type": "string"},
          "install_strategy": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
