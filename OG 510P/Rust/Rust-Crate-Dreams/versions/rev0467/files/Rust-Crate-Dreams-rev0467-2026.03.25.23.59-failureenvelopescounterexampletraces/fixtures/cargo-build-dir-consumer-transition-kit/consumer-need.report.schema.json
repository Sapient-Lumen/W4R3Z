{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-build-dir-consumer-transition/consumer-need.report.schema.json",
  "title": "Cargo build-dir consumer need report",
  "type": "object",
  "required": [
    "schema_version",
    "consumer_ref",
    "observed_path_pattern",
    "need_class",
    "confidence"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "consumer_ref": {"type": "string"},
    "observed_path_pattern": {"type": "string"},
    "need_class": {
      "type": "string",
      "enum": [
        "integration_test_binary",
        "build_script_owned_output",
        "final_artifact",
        "user_requested_artifact",
        "dep_info",
        "workspace_topology_guess",
        "manual_review_required"
      ]
    },
    "claimed_need": {"type": "string"},
    "confidence": {
      "type": "string",
      "enum": ["direct", "inferred", "ambiguous"]
    },
    "misclassification_risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "evidence": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
