{
  "schema_version": "0.1",
  "profile": {
    "id": "tower_http_service_boundary",
    "version": "0.1.0",
    "summary": "Service and middleware boundary over tower-service + http"
  },
  "required_public_surfaces": [
    "tower_service::Service",
    "http::Request",
    "http::Response"
  ],
  "forbidden_public_coupling": [
    "framework_specific_request_wrapper"
  ],
  "optional_adapter_surfaces": [
    "feature:axum-adapter",
    "feature:hyper-adapter"
  ],
  "behavioral_probes": [
    "compile_witness:service_roundtrip"
  ]
}
