{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeCoverageMatrixReport",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "coverage_posture",
    "dimensions",
    "cells"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "coverage_posture": {
      "type": "string",
      "enum": [
        "exact_sparse_matrix",
        "declared_matrix_with_unknown_cells",
        "summary_only"
      ]
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "feature_sets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "config_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cell_id",
          "selectors",
          "coverage_state"
        ],
        "properties": {
          "cell_id": {
            "type": "string"
          },
          "selectors": {
            "type": "object",
            "properties": {
              "package": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "feature_set": {
                "type": "string"
              },
              "runtime_profile": {
                "type": "string"
              },
              "config_profile": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "coverage_state": {
            "type": "string",
            "enum": [
              "observed_ok",
              "observed_hazard",
              "fix_only",
              "recipe_only",
              "manual_review_required",
              "not_requested",
              "unsupported",
              "unknown"
            ]
          },
          "capture_context_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
