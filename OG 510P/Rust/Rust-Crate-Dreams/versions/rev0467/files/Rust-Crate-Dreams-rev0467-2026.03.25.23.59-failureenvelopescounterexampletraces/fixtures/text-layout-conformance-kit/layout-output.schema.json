{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "layout output",
  "type": "object",
  "required": [
    "case_id",
    "backend",
    "paragraphs",
    "comparability"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "backend": {
      "type": "string"
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text_range",
          "lines"
        ],
        "properties": {
          "text_range": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "bidi_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "index",
                "advance_px",
                "text_range",
                "break_reason"
              ],
              "properties": {
                "index": {
                  "type": "integer"
                },
                "advance_px": {
                  "type": "number"
                },
                "text_range": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                "break_reason": {
                  "type": "string",
                  "enum": [
                    "soft_wrap",
                    "hard_break",
                    "emergency_break",
                    "end_of_text"
                  ]
                },
                "glyph_runs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "font_family",
                      "glyph_count"
                    ],
                    "properties": {
                      "font_family": {
                        "type": "string"
                      },
                      "glyph_count": {
                        "type": "integer"
                      },
                      "fallback_used": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "comparability": {
      "type": "object",
      "required": [
        "is_comparable",
        "exactness_lane"
      ],
      "properties": {
        "is_comparable": {
          "type": "boolean"
        },
        "exactness_lane": {
          "type": "string"
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "profile_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
