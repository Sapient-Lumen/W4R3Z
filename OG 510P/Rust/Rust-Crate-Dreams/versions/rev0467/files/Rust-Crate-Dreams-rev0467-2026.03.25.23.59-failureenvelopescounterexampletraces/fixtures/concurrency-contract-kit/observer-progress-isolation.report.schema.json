{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "observer-progress-isolation.report",
  "type": "object",
  "required": [
    "surface",
    "slow_observer_effect_class",
    "affects_other_observers",
    "affects_sender_progress",
    "local_recovery_posture",
    "claim_basis",
    "claim_ceiling"
  ],
  "properties": {
    "surface": {
      "type": "string"
    },
    "slow_observer_effect_class": {
      "type": "string",
      "enum": [
        "observer_local_only",
        "self_lag_with_cursor_rebase",
        "shared_work_pool_competition",
        "single_receiver_only_not_multiobserver",
        "wake_only_not_data_progress",
        "manual_review_required"
      ]
    },
    "affects_other_observers": {
      "type": "string"
    },
    "affects_sender_progress": {
      "type": "string"
    },
    "local_recovery_posture": {
      "type": "string"
    },
    "claim_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_ceiling": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
