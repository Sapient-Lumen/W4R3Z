{
  "crate": "demo-crate",
  "profile": "default_docsrs_surface",
  "surfaces": [
    {
      "id": "surf_docsrs_hosted_demo_default",
      "source_kind": "docsrs_hosted_html",
      "resolved_version": "1.2.0",
      "toolchain_channel": "nightly",
      "toolchain_version": "rustc 1.96.0-nightly (562dee482 2026-03-21)",
      "rustdoc_json_format_version": null,
      "feature_posture": {
        "all_features": false,
        "no_default_features": false,
        "enabled_features": ["serde", "cli"]
      },
      "cfgs": ["docsrs"],
      "docsrs_cfg_scope": "final_documented_crate_only",
      "target_posture": {
        "default_target": "x86_64-pc-windows-msvc",
        "built_targets": [
          "x86_64-pc-windows-msvc",
          "x86_64-unknown-linux-gnu",
          "aarch64-apple-darwin"
        ],
        "cross_compiled_targets": [
          "x86_64-pc-windows-msvc",
          "aarch64-apple-darwin"
        ]
      },
      "example_scrape_posture": null,
      "notes": [
        "Hosted surface follows package.metadata.docs.rs recipe, not a universal crate view."
      ],
      "caveats": [
        "Different local feature/target recipes may expose different visible surfaces."
      ]
    }
  ],
  "notes": [
    "Treat docs.rs HTML as one named build surface, not the only possible crate surface."
  ]
}
