{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/a11ydoctor/toolkit-profile.schema.json",
  "title": "UI accessibility toolkit profile",
  "type": "object",
  "required": ["profile_version", "toolkit", "backend", "ruleset", "baseline"],
  "properties": {
    "profile_version": {"type": "string"},
    "toolkit": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "mode": {"type": "string", "enum": ["immediate", "retained", "custom-canvas", "other"]}
      },
      "additionalProperties": true
    },
    "backend": {
      "type": "object",
      "required": ["semantic_source"],
      "properties": {
        "semantic_source": {"type": "string", "enum": ["accesskit", "custom", "mixed"]},
        "host_adapter": {"type": "string"},
        "platform_scope": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "ruleset": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "severity_profile": {"type": "string"}
      },
      "additionalProperties": true
    },
    "baseline": {
      "type": "object",
      "required": ["pack_id"],
      "properties": {
        "pack_id": {"type": "string"},
        "snapshot_ref": {"type": "string"}
      },
      "additionalProperties": true
    },
    "waiver_policy": {"type": "string"}
  },
  "additionalProperties": true
}
