{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstrumentationRecipeManifest",
  "type": "object",
  "required": ["schema_version", "recipes"],
  "properties": {
    "schema_version": {"type": "string"},
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command"],
        "properties": {
          "name": {"type": "string"},
          "command": {"type": "string"},
          "feature_flags": {"type": "array", "items": {"type": "string"}},
          "runtime_notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
