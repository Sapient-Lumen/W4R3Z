{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/msrv-workspace-lab/msrv-blame.report.schema.json",
  "title": "MSRV blame report",
  "type": "object",
  "required": [
    "schema_version",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding",
          "confidence"
        ],
        "properties": {
          "finding": {
            "type": "string",
            "enum": [
              "declared_policy_ok",
              "policy_underdeclared",
              "inactive_target_edge_only",
              "metadata_floor_higher_than_build_floor",
              "dependency_raised_floor",
              "manual_review_required"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "observed_fact",
              "conservative_inference",
              "manual_review_required"
            ]
          },
          "package": {
            "type": "string"
          },
          "dependency": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
