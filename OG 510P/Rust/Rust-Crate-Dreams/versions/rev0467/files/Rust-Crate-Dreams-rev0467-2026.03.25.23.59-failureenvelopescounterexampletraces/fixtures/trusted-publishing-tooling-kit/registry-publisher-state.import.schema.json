{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted Publishing Registry Publisher State Import",
  "type": "object",
  "required": [
    "schema_version",
    "registry",
    "packages",
    "provider_family",
    "host_scope",
    "trusted_publishing_only",
    "registered_route",
    "observation_source",
    "authority_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "registry": {
      "const": "crates.io"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "provider_family": {
      "enum": [
        "github_actions",
        "gitlab_ci_cd",
        "other",
        "unknown"
      ]
    },
    "host_scope": {
      "type": "string"
    },
    "trusted_publishing_only": {
      "type": "boolean"
    },
    "registered_route": {
      "type": "object",
      "required": [
        "repository_or_project",
        "workflow_or_config"
      ],
      "properties": {
        "repository_or_project": {
          "type": "string"
        },
        "workflow_or_config": {
          "type": "string"
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "observation_source": {
      "enum": [
        "crates_io_ui",
        "iac_repo",
        "manual_import",
        "support_ticket",
        "other"
      ]
    },
    "authority_class": {
      "enum": [
        "authoritative_import",
        "partial_import",
        "stale_import",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
