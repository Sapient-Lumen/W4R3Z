{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DrainRecipeManifest",
  "type": "object",
  "required": [
    "crate",
    "recipes"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "mode",
          "steps"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "graceful",
              "timeout",
              "hard_abort"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
