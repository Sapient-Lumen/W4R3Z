{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publish Identity Report",
  "type": "object",
  "properties": {
    "publish_mode": {"enum": ["manual", "token", "trusted-publisher"]},
    "provider": {"type": ["string", "null"]},
    "workflow_identity": {"type": ["string", "null"]},
    "verdict": {"enum": ["verified", "partial", "manual_review_required"]}
  },
  "required": ["publish_mode", "verdict"]
}
