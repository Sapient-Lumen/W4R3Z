{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tool-compat.matrix.json",
  "type": "object",
  "required": ["schema_version", "tool_name", "rows"],
  "properties": {
    "schema_version": {"type": "string"},
    "tool_name": {"type": "string"},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["compiler_range", "rustc_public_range", "bridge_mode", "status"],
        "properties": {
          "compiler_range": {"type": "string"},
          "rustc_public_range": {"type": "string"},
          "bridge_mode": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["supported", "partial", "manual_review_required", "unknown"]
          },
          "semver_exempt_surfaces": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "additionalProperties": true
}
