{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desktop ShipKit update channel contract",
  "type": "object",
  "required": [
    "app_id",
    "channels",
    "key_continuity",
    "manual_review"
  ],
  "properties": {
    "app_id": {
      "type": "string"
    },
    "key_continuity": {
      "type": "string",
      "enum": [
        "preserved",
        "rotated_with_migration",
        "rotated_without_migration",
        "unknown"
      ]
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "artifact_families"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "artifact_families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollback_policy": {
            "type": "string"
          },
          "store_route": {
            "type": "boolean"
          },
          "direct_route": {
            "type": "boolean"
          }
        }
      }
    },
    "manual_review": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
