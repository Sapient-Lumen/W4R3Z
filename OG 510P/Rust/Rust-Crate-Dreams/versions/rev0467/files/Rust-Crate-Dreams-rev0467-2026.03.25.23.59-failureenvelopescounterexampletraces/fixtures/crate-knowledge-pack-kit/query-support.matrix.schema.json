{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "query-support.matrix",
  "type": "object",
  "required": [
    "crate",
    "profile",
    "query_classes"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "query_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class",
          "status"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "partial",
              "manual_review_required",
              "refused"
            ]
          },
          "required_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "global_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
