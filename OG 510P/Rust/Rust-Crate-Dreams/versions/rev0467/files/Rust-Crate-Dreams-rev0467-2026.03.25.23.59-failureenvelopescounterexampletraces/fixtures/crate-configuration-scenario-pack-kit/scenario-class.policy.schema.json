{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioClassPolicy",
  "type": "object",
  "required": [
    "schema_version",
    "classes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class_name",
          "meaning"
        ],
        "properties": {
          "class_name": {
            "enum": [
              "recommended_default",
              "minimal_supported",
              "backend_choice_required",
              "docs_only",
              "integration_heavy",
              "board_only",
              "deprecated_scenario",
              "manual_review_required"
            ]
          },
          "meaning": {
            "type": "string"
          },
          "minimum_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "non_goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "example_scenarios": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
