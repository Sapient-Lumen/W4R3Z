{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/nuget-native-interop-shipkit/loader-route.report.schema.json",
  "title": "NugetLoaderRouteReport",
  "type": "object",
  "required": [
    "package_name",
    "route_class",
    "managed_library_name",
    "expected_route"
  ],
  "properties": {
    "package_name": {
      "type": "string"
    },
    "route_class": {
      "type": "string",
      "enum": [
        "default_probe_route",
        "custom_resolver_required",
        "isolated_plugin_route",
        "library_name_mismatch_risk",
        "manual_review_required"
      ]
    },
    "managed_library_name": {
      "type": "string"
    },
    "expected_route": {
      "type": "string",
      "enum": [
        "default_probing",
        "dllimport_resolver",
        "isolated_alc",
        "host_specific",
        "manual_review"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "error",
              "manual_review"
            ]
          }
        }
      }
    }
  }
}
