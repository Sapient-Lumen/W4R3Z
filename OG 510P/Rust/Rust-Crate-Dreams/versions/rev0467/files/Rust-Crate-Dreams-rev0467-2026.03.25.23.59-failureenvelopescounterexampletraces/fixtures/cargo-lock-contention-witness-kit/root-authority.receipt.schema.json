{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "root-authority.receipt",
  "type": "object",
  "required": [
    "workspace",
    "roots"
  ],
  "properties": {
    "workspace": {
      "type": "string"
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path_source",
          "exactness"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "path_source": {
            "type": "string"
          },
          "exactness": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
