{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Lock Contention Witness Kit \u2014 exactness report",
  "type": "object",
  "required": [
    "schema_version",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "exactness"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "exactness": {
            "type": "string",
            "enum": [
              "observed_directly",
              "normalized_observed",
              "conservative_inference",
              "manual_review_required"
            ]
          },
          "evidence_lane": {
            "type": "string",
            "enum": [
              "wait_capture",
              "root_topology",
              "session_import",
              "manual_annotation"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}