{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeReplayBridgeReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "bridges"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "bridges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bridge_id",
          "subject_refs",
          "bridge_kind",
          "stability_posture",
          "copy_provenance",
          "fidelity_expectation",
          "usability_status"
        ],
        "properties": {
          "bridge_id": {
            "type": "string"
          },
          "subject_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "bridge_kind": {
            "type": "string",
            "enum": [
              "direct_command_rerun",
              "native_storage_rerender",
              "copied_attachment_open",
              "manual_reconstruction",
              "not_replayable"
            ]
          },
          "stability_posture": {
            "type": "string",
            "enum": [
              "stable",
              "unstable",
              "external",
              "mixed",
              "unknown"
            ]
          },
          "entrypoint": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "native_locator": {
                "type": "object",
                "properties": {
                  "report_id": {
                    "type": "string"
                  },
                  "session_id": {
                    "type": "string"
                  },
                  "storage_path_ref": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              },
              "attachment_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "prerequisite_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          },
          "copy_provenance": {
            "type": "string",
            "enum": [
              "native_storage_only",
              "copied_verbatim",
              "copied_after_redaction",
              "maintainer_rewritten",
              "none",
              "unknown"
            ]
          },
          "fidelity_expectation": {
            "type": "string",
            "enum": [
              "byte_exact_expected",
              "semantically_equivalent_expected",
              "manual_compare_required",
              "summary_only",
              "unknown"
            ]
          },
          "usability_status": {
            "type": "string",
            "enum": [
              "usable",
              "blocked",
              "stale",
              "missing",
              "unknown"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
