{
  "crate": "acme-cli",
  "rules": [
    {
      "match_class": "temp_dir",
      "scope": "stdout",
      "replacement": "<TEMP_DIR>"
    },
    {
      "match_class": "timestamp",
      "scope": "stdout",
      "replacement": "<TIMESTAMP>"
    },
    {
      "match_class": "uuid",
      "scope": "stdout",
      "replacement": "<UUID>"
    }
  ]
}
