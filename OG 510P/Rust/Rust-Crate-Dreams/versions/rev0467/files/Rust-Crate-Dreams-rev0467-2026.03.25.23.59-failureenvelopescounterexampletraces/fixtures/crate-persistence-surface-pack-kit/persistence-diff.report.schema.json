{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersistenceDiffReport",
  "type": "object",
  "required": [
    "crate",
    "changes"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "surface"
        ],
        "properties": {
          "kind": {
            "enum": [
              "format_surface_changed",
              "compatibility_window_narrowed",
              "compatibility_window_widened",
              "durability_boundary_changed",
              "recovery_posture_changed",
              "migration_lane_added",
              "migration_lane_removed",
              "manual_review_required"
            ]
          },
          "surface": {
            "type": "string"
          }
        }
      }
    }
  }
}