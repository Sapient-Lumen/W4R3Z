{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/freshness-window.policy.schema.json",
  "title": "Crate pathfinder freshness window policy",
  "type": "object",
  "required": ["schema_version", "windows"],
  "properties": {
    "schema_version": {"type": "string"},
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signal_class", "window_class", "default_action"],
        "properties": {
          "signal_class": {
            "type": "string",
            "enum": [
              "new_publish",
              "fresh_support_claim",
              "docs_surface_change",
              "download_signal_change",
              "imported_health_or_trust_change"
            ]
          },
          "window_class": {
            "type": "string",
            "enum": ["cooldown", "recent_review", "steady_state"]
          },
          "max_age_days": {"type": ["integer", "null"], "minimum": 0},
          "default_action": {
            "type": "string",
            "enum": ["allow_freeze", "manual_review_required", "import_only"]
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
