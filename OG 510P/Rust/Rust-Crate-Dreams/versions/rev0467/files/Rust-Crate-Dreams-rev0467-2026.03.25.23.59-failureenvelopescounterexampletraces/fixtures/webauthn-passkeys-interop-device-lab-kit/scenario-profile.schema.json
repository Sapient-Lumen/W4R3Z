    "allow_credentials_mode": {"type": "string", "enum": ["any", "filtered", "none"]},
    "overlays": {"type": "array", "items": {"type": "string"}},
    "expected_failure_family": {"type": ["string", "null"]},
    "redaction_profile": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
