{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "normalized-build-graph.report",
  "type": "object",
  "required": ["schema_version", "root_artifacts", "packages"],
  "properties": {
    "schema_version": {"type": "string"},
    "root_artifacts": {"type": "array", "items": {"type": "string"}},
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package_id", "feature_set", "compiled_kinds"],
        "properties": {
          "package_id": {"type": "string"},
          "feature_set": {"type": "array", "items": {"type": "string"}},
          "compiled_kinds": {"type": "array", "items": {"type": "string"}},
          "target_triple": {"type": ["string", "null"]},
          "duplicate_compile_group": {"type": ["string", "null"]}
        }
      }
    },
    "edge_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "edge_kind"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "edge_kind": {"type": "string", "enum": ["normal", "build"]}
        }
      }
    }
  },
  "additionalProperties": true
}
