{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "report-determinism.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "replay_class",
    "requires_network",
    "toolchain_frozen"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "replay_class": {
      "enum": [
        "bundle_replayable",
        "cache_replayable",
        "system_state_dependent",
        "network_dependent",
        "manual_review_required"
      ]
    },
    "requires_network": {
      "type": "boolean"
    },
    "toolchain_frozen": {
      "type": "boolean"
    },
    "stackwalk_engine": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
