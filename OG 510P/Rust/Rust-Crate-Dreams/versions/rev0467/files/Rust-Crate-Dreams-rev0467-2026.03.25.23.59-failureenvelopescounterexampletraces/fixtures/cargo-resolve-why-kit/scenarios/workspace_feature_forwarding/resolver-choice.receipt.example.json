{
  "schema_version": "0.1.0",
  "command": ["cargo", "resolve-why", "capture", "--workspace", "--all-features"],
  "cargo": {
    "version": "1.85.0",
    "resolver_version": "3",
    "feature_unification_mode": "selected"
  },
  "data_sources": ["cargo_metadata", "cargo_tree_features", "manual_manifest_scan"],
  "assumptions": [
    "workspace members were captured with `--all-features`",
    "feature forwarding is derived from manifest edges plus tree inversion"
  ],
  "manual_review_required": false,
  "redactions": {
    "private_paths": true,
    "private_package_names": false
  }
}
