{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "service-transition-bundle.manifest",
  "type": "object",
  "required": [
    "artifact",
    "proposal_id",
    "subject",
    "transition_class",
    "attachments"
  ],
  "properties": {
    "artifact": {
      "const": "service-transition-bundle.manifest"
    },
    "proposal_id": {
      "const": "P-0534"
    },
    "subject": {
      "type": "string"
    },
    "transition_class": {
      "enum": [
        "startup",
        "steady_state",
        "drain",
        "timeout_aftermath",
        "restart",
        "manual_review_required"
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redaction_posture": {
      "enum": [
        "safe_to_share",
        "redacted",
        "internal_only",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
