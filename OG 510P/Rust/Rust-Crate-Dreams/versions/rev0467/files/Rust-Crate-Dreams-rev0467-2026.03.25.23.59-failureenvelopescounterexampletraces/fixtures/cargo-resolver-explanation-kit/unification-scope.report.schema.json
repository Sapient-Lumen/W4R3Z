{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unification-scope.report",
  "type": "object",
  "required": [
    "schema_version",
    "policy",
    "selected_packages",
    "participating_packages"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "policy": {
      "type": "string",
      "enum": [
        "selected",
        "workspace",
        "package"
      ]
    },
    "selected_packages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "participating_packages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "other_package_influenced_answer": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
