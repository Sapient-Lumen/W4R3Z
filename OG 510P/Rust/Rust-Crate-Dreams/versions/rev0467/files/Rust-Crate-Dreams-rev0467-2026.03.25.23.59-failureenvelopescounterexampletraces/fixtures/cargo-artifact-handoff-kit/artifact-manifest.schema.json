{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactManifest",
  "type": "object",
  "required": ["artifacts"],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "owner_package", "target_kind", "profile", "origin_basis"],
        "properties": {
          "path": {"type": "string"},
          "owner_package": {"type": "string"},
          "target_kind": {"type": "string"},
          "profile": {"type": "string"},
          "platform": {"type": ["string", "null"]},
          "origin_basis": {"type": "string"},
          "copied_output_path": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
