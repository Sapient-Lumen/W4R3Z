{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.local/r-package-native-shipkit/registration-posture.report.schema.json",
  "title": "RegistrationPostureReport",
  "type": "object",
  "required": ["package", "class", "summary"],
  "properties": {
    "package": {"type": "string"},
    "class": {
      "type": "string",
      "enum": [
        "registered_contract_ok",
        "registration_posture_review_required",
        "wrapper_export_drift",
        "manual_review_required"
      ]
    },
    "summary": {"type": "string"},
    "nspace_directive": {"type": "string"},
    "registered_symbols": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
