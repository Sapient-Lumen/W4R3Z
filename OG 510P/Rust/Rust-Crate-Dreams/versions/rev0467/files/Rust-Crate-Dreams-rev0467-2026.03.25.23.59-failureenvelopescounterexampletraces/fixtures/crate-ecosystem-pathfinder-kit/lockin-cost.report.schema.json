{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/crate-ecosystem-pathfinder-kit/lockin-cost.report.schema.json",
  "title": "lockin-cost.report",
  "type": "object",
  "required": [
    "task_lane",
    "stack_name",
    "overall_lockin_class",
    "lockin_vectors",
    "escape_story"
  ],
  "properties": {
    "task_lane": {
      "type": "string"
    },
    "stack_name": {
      "type": "string"
    },
    "overall_lockin_class": {
      "enum": [
        "low",
        "moderate",
        "high",
        "manual_review_required"
      ]
    },
    "lockin_vectors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "escape_story": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
