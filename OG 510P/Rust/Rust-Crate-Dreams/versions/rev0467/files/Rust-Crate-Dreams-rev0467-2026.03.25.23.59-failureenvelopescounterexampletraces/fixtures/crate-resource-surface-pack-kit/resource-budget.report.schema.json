{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceBudgetReport",
  "type": "object",
  "required": ["schema_version", "crate", "budgets"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "budgets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource", "kind", "baseline"],
        "properties": {
          "resource": {"type": "string"},
          "kind": {"type": "string"},
          "baseline": {"type": ["integer", "string"]},
          "confidence": {"type": "string"},
          "manual_review_boundary": {"type": ["string", "null"]}
        }
      }
    }
  }
}