{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/evidence-origin.report.schema.json",
  "title": "Crate pathfinder evidence origin report",
  "type": "object",
  "required": ["schema_version", "task", "facts"],
  "properties": {
    "schema_version": {"type": "string"},
    "task": {"type": "string"},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact", "origin_class"],
        "properties": {
          "fact": {"type": "string"},
          "origin_class": {
            "type": "string",
            "enum": [
              "registry_metadata",
              "crate_authored_docs",
              "official_rust_policy",
              "imported_receipt",
              "local_observation",
              "inference",
              "manual_review_required"
            ]
          },
          "source_ref": {"type": ["string", "null"]},
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
