{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/decision-timebox.receipt.schema.json",
  "title": "Crate pathfinder decision timebox receipt",
  "type": "object",
  "required": ["schema_version", "task_lane", "starter_set", "frozen_at", "as_of_cutoff", "signal_cutoffs", "knowledge_scope", "manual_review_required"],
  "properties": {
    "schema_version": {"type": "string"},
    "task_lane": {"type": "string"},
    "starter_set": {"type": "string"},
    "frozen_at": {"type": "string"},
    "as_of_cutoff": {"type": "string"},
    "signal_cutoffs": {
      "type": "object",
      "required": ["registry_publish_cutoff", "docs_surface_cutoff", "imported_receipts_cutoff"],
      "properties": {
        "registry_publish_cutoff": {"type": ["string", "null"]},
        "docs_surface_cutoff": {"type": ["string", "null"]},
        "imported_receipts_cutoff": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "cooldown_policy_ref": {"type": ["string", "null"]},
    "knowledge_scope": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "blind_spots": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
