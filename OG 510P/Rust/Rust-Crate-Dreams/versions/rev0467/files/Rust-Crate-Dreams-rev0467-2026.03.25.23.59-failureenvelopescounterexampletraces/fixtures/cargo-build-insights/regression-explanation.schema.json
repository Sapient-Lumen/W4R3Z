{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.local/fixtures/cargo-build-insights/regression-explanation.schema.json",
  "title": "cargo-build-insights regression explanation",
  "type": "object",
  "required": [
    "bundle_schema_version",
    "baseline",
    "head",
    "comparability",
    "metric_deltas",
    "judgments"
  ],
  "properties": {
    "bundle_schema_version": {"type": "string"},
    "baseline": {
      "type": "object",
      "required": ["selection_kind", "session_refs"],
      "properties": {
        "selection_kind": {"type": "string"},
        "session_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "head": {
      "type": "object",
      "required": ["selection_kind", "session_refs"],
      "properties": {
        "selection_kind": {"type": "string"},
        "session_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "comparability": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["comparable", "comparable_with_caveats", "manual_review_required"]
        },
        "caveats": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "metric_deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "baseline_value", "head_value"],
        "properties": {
          "metric": {"type": "string"},
          "baseline_value": {"type": "number"},
          "head_value": {"type": "number"},
          "delta": {"type": "number"},
          "unit": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "label"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["observed_fact", "conservative_inference", "manual_review_required"]
          },
          "label": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
