{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecoveryOriginReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "failure_case",
    "origins"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "failure_case": {
      "type": "string"
    },
    "origins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "origin_kind",
          "source_ref",
          "claimed_role"
        ],
        "properties": {
          "origin_kind": {
            "enum": [
              "diagnostic_attribute",
              "compile_fail_fixture",
              "rustdoc_example",
              "miette_metadata",
              "proc_macro_error_helper",
              "maintainer_docs_anchor",
              "manual_review_required"
            ]
          },
          "source_ref": {
            "type": "string"
          },
          "claimed_role": {
            "enum": [
              "primary_guidance",
              "replacement_hint",
              "smallest_good_path",
              "supporting_context",
              "manual_review_boundary"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
