{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/fixtures/cargo-publish-receipt-join-kit/registry-capability.receipt.schema.json",
  "title": "registry-capability.receipt",
  "type": "object",
  "required": [
    "subject",
    "registry",
    "capabilities",
    "verdict"
  ],
  "properties": {
    "subject": {
      "type": "object",
      "required": [
        "package",
        "version"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "registry": {
      "type": "object",
      "required": [
        "name",
        "url_class",
        "publish_route"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url_class": {
          "type": "string"
        },
        "publish_route": {
          "type": "string"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "basis"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "unsupported",
              "unknown",
              "imported_crates_io_only"
            ]
          },
          "basis": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "registry_capability_known",
        "partial_registry_capability",
        "manual_review_required"
      ]
    },
    "manual_review_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
