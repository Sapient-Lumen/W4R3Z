{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build-Std evidence source receipt",
  "type": "object",
  "required": [
    "schema_version",
    "direct_sources",
    "normalized_sources",
    "manual_annotations"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "direct_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "normalized_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_annotations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "mixed",
        "manual_review_required"
      ]
    }
  }
}
