{
  "schema_version": "0.1",
  "bundle_name": "tokio-mutex-support-bundle",
  "artifacts": [
    {
      "kind": "reentrancy_scope",
      "path": "reentrancy-scope.report.json",
      "required": true
    },
    {
      "kind": "progress_fairness",
      "path": "progress-fairness.report.json",
      "required": true
    },
    {
      "kind": "wait_cancellation",
      "path": "wait-cancellation.report.json",
      "required": false
    },
    {
      "kind": "execution_context_boundary",
      "path": "execution-context-boundary.report.json",
      "required": true
    },
    {
      "kind": "failure_recovery",
      "path": "failure-recovery.report.json",
      "required": false
    }
  ],
  "notes": [
    "Bundle inventory does not imply all artifacts came from the same authority route.",
    "Missing optional reports should remain visible instead of being silently inferred.",
    "Cancellation and recovery reports must not be flattened into one generic concurrency verdict."
  ]
}