{
  "profile": "release",
  "target": "x86_64-unknown-linux-gnu",
  "support_posture": "backtrace_only",
  "capture_sources": ["cargo_profile", "filesystem_scan"],
  "observed_settings": {
    "debug": "line-tables-only",
    "split_debuginfo": "off",
    "strip": "none",
    "panic": "unwind"
  },
  "artifacts": [
    {
      "path": "target/release/app",
      "artifact_kind": "bin",
      "debug_info_mode": "limited_embedded",
      "sidecars": []
    }
  ],
  "notes": ["Enough evidence for backtrace usefulness, not enough for rich variable inspection promises"]
}
