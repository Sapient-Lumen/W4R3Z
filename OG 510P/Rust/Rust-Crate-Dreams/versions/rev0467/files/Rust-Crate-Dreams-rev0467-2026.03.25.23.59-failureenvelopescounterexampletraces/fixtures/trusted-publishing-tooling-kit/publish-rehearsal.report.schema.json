{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted Publishing Rehearsal Report",
  "type": "object",
  "required": [
    "schema_version",
    "provider",
    "trigger_verdict",
    "claim_basis_verdict",
    "publish_mode_verdict",
    "result",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "provider_scope_verdict": {
      "enum": [
        "ok",
        "partial",
        "manual_review_required",
        "blocked"
      ]
    },
    "trigger_verdict": {
      "type": "string"
    },
    "claim_basis_verdict": {
      "enum": [
        "ok",
        "partial",
        "manual_review_required",
        "mismatch"
      ]
    },
    "publish_mode_verdict": {
      "enum": [
        "ok",
        "policy_mismatch",
        "manual_review_required"
      ]
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "partial",
        "blocked"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
