{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toolchain & Target Support Evidence Report",
  "type": "object",
  "required": ["schema_version", "claims"],
  "properties": {
    "schema_version": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "support_class", "evidence_classes"],
        "properties": {
          "subject": {"type": "string"},
          "support_class": {"type": "string"},
          "evidence_classes": {
            "type": "array",
            "items": {"type": "string"}
          },
          "sources": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
