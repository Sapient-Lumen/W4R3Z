{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "export-policy.receipt",
  "type": "object",
  "required": [
    "crate",
    "profile",
    "allowed_source_kinds",
    "pinning_policy"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "allowed_source_kinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_source_kinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redaction_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pinning_policy": {
      "type": "string"
    },
    "hosted_vs_local_precedence": {
      "type": "string"
    },
    "manual_review_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_export_posture": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
