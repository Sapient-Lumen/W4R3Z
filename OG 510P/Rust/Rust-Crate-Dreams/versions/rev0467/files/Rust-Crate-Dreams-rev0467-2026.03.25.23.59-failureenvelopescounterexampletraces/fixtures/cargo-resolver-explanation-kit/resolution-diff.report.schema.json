{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "resolution-diff.report",
  "type": "object",
  "required": [
    "schema_version",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "summary"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "version_change",
              "feature_change",
              "participant_scope_change",
              "lockfile_change",
              "target_scope_change"
            ]
          },
          "summary": {
            "type": "string"
          },
          "reason_kinds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
