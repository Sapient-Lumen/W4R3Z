{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthorityBudgetPolicy",
  "type": "object",
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {"type": "string"},
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "budget"],
        "properties": {
          "name": {"type": "string"},
          "budget": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "budget_class"],
              "properties": {
                "kind": {
                  "enum": [
                    "fs_read",
                    "fs_write",
                    "temp_dir",
                    "home_dir",
                    "env_read",
                    "env_write",
                    "network_egress",
                    "network_ingress",
                    "time_now",
                    "sleep_timer",
                    "randomness",
                    "process_spawn",
                    "stdio",
                    "thread_spawn",
                    "host_probe",
                    "manual_review_required"
                  ]
                },
                "budget_class": {
                  "enum": [
                    "required_runtime_authority",
                    "optional_accelerant",
                    "host_convenience",
                    "test_only",
                    "forbidden_in_profile",
                    "manual_review_required"
                  ]
                },
                "justification": {"type": "string"},
                "notes": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              }
            }
          }
        }
      }
    }
  }
}
