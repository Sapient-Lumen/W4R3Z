{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InjectionBoundaryReceipt",
  "type": "object",
  "required": ["schema_version", "crate", "boundaries"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "boundary_class"],
        "properties": {
          "name": {"type": "string"},
          "authority_kind": {"type": "string"},
          "boundary_class": {
            "enum": [
              "ambient_only",
              "injectable_at_construction",
              "injectable_per_operation",
              "host_supplied_capability",
              "test_only_injection",
              "manual_review_required"
            ]
          },
          "surface_refs": {
            "type": "array",
            "items": {"type": "string"}
          },
          "evidence_sources": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
