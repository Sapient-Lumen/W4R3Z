{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/in-place-initialization-adoption-kit/placement-topology.receipt.schema.json",
  "title": "Placement Topology Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "topology_class",
    "first_write_site",
    "final_allocation_site"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "topology_class": {
      "enum": [
        "by_value_stack",
        "heap_final_place",
        "caller_provided_place",
        "field_embed_place",
        "ffi_out_ptr",
        "unknown"
      ]
    },
    "first_write_site": {
      "type": "string"
    },
    "final_allocation_site": {
      "type": "string"
    },
    "stack_bounce": {
      "type": "boolean"
    },
    "caller_provided_storage": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
