{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Rebuild Why Kit \u2014 baseline authority receipt",
  "type": "object",
  "required": [
    "schema_version",
    "candidate",
    "selected_baseline",
    "selection_strategy",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "candidate": {
      "type": "string"
    },
    "selected_baseline": {
      "type": "string"
    },
    "selection_strategy": {
      "type": "string",
      "enum": [
        "nearest_prior",
        "same_profile_target",
        "manual_pin",
        "workspace_policy"
      ]
    },
    "compatibility_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "status"
        ],
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "command_role",
              "profile",
              "targets",
              "features",
              "wrapper_flags",
              "workspace_selection"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "match",
              "compatible_with_caveat",
              "mismatch"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "disqualified_baselines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "session_id",
          "reason"
        ],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "baseline_authorized",
        "baseline_authorized_with_caveats",
        "manual_review_required"
      ]
    }
  },
  "additionalProperties": true
}
