{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SupportObligationReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "obligations"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "origin_class"
        ],
        "properties": {
          "kind": {
            "enum": [
              "build_script_present",
              "native_links_present",
              "proc_macro_present",
              "docsrs_metadata_overlay",
              "custom_target_list",
              "docsrs_default_target_dependence",
              "msrv_declared",
              "workspace_metadata_inherited",
              "manual_review_required"
            ]
          },
          "origin_class": {
            "enum": [
              "manifest_observed",
              "docsrs_metadata_observed",
              "cargo_metadata_observed",
              "rustdoc_json_observed",
              "slice_tool_imported",
              "maintainer_declared"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "adoption_impact": {
            "enum": [
              "none",
              "low",
              "medium",
              "high",
              "manual_review_required"
            ]
          }
        }
      }
    }
  }
}
