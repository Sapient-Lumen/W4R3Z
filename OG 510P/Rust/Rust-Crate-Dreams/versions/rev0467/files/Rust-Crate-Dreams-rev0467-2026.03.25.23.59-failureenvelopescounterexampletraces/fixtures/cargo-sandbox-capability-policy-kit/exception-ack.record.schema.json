{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/cargo-sandbox-capability-policy-kit/exception-ack.record.schema.json",
  "title": "Exception Ack Record",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "actor_name",
    "capability",
    "owner",
    "justification",
    "source",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "justification": {
      "type": "string"
    },
    "expiry": {
      "type": "string"
    },
    "source": {
      "enum": [
        "crate_manifest",
        "workspace_overlay",
        "ci_override",
        "manual_review"
      ]
    },
    "status": {
      "enum": [
        "active",
        "expired",
        "pending_review"
      ]
    }
  },
  "additionalProperties": false
}
