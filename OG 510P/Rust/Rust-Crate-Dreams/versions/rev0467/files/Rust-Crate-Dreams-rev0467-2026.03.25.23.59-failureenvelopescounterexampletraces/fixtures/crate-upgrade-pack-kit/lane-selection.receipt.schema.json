{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeLaneSelectionReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "invocation_subject",
    "manifest_walk",
    "workspace_attachment",
    "package_selection",
    "feature_selection",
    "target_selection"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "invocation_subject": {
      "type": "object",
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "cwd_package",
            "cwd_workspace_root",
            "explicit_manifest_path",
            "imported_receipt",
            "maintainer_declared"
          ]
        },
        "cwd": {
          "type": "string"
        },
        "manifest_path": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "manifest_walk": {
      "type": "object",
      "required": [
        "walk_mode",
        "resolved_manifest_path"
      ],
      "properties": {
        "walk_mode": {
          "type": "string",
          "enum": [
            "ambient_cwd_walk",
            "explicit_manifest_only",
            "workspace_root_manifest",
            "imported_only"
          ]
        },
        "resolved_manifest_path": {
          "type": "string"
        },
        "config_discovery_posture": {
          "type": "string",
          "enum": [
            "ambient_parent_walk",
            "explicit_manifest_chain",
            "imported_unknown",
            "not_applicable"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "workspace_attachment": {
      "type": "object",
      "required": [
        "attachment_kind"
      ],
      "properties": {
        "attachment_kind": {
          "type": "string",
          "enum": [
            "standalone_package",
            "workspace_member",
            "workspace_root_default_members",
            "workspace_all_members",
            "workspace_subset_explicit",
            "workspace_subset_imported"
          ]
        },
        "workspace_root": {
          "type": "string"
        },
        "attached_member_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_member_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "package_selection": {
      "type": "object",
      "required": [
        "mode",
        "selected_refs"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "current_package",
            "default_members",
            "explicit_packages",
            "workspace_all_members",
            "workspace_subset_with_excludes",
            "published_subset",
            "imported_unknown"
          ]
        },
        "selected_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "excluded_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cause": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "feature_selection": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "default_features",
            "no_default_features",
            "explicit_features",
            "all_features",
            "mixed_workspace_features",
            "imported_unknown"
          ]
        },
        "selected_feature_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "target_selection": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "default_targets",
            "explicit_targets",
            "all_targets",
            "required_features_gated_subset",
            "mixed",
            "imported_unknown"
          ]
        },
        "selected_target_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped_target_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "selection_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
