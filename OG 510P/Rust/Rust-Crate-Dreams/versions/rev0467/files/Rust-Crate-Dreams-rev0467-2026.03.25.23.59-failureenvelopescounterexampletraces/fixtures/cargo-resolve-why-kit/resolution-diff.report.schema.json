{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-resolve-why/resolution-diff.report.schema.json",
  "title": "Cargo resolve why — resolution diff report",
  "type": "object",
  "required": ["schema_version", "baseline", "head", "changes"],
  "properties": {
    "schema_version": {"type": "string"},
    "baseline": {"type": "string"},
    "head": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package", "change_kind", "summary", "confidence"],
        "properties": {
          "package": {"type": "string"},
          "change_kind": {
            "type": "string",
            "enum": [
              "feature_activated",
              "feature_deactivated",
              "version_changed",
              "duplicate_group_changed",
              "workspace_selection_changed",
              "msrv_policy_changed",
              "manual_review_required"
            ]
          },
          "summary": {"type": "string"},
          "confidence": {
            "type": "string",
            "enum": ["observed_fact", "conservative_inference", "manual_review_required"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
