{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeterminismSurfaceReport",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "determinism_class"
      ],
      "properties": {
        "determinism_class": {
          "enum": [
            "pure",
            "seed_injectable",
            "clock_injectable",
            "env_sensitive",
            "filesystem_sensitive",
            "network_sensitive",
            "host_probe",
            "manual_review_required"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "status"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ambient_only",
              "injectable",
              "forbidden_in_profile",
              "manual_review_required"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
