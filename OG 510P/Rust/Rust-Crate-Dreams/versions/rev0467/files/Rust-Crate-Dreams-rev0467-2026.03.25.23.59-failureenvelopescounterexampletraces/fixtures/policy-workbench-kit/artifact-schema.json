{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "constraints": {
      "properties": {
        "max_steps": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "engine": {
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "policy_bundle_hash": {
      "type": "string"
    },
    "rego_mode": {
      "type": "string"
    },
    "summary": {
      "properties": {
        "eval_ms_p50": {
          "type": [
            "number",
            "null"
          ]
        },
        "tests_failed": {
          "type": "integer"
        },
        "tests_passed": {
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "policy_bundle_hash",
    "engine",
    "rego_mode",
    "constraints",
    "summary"
  ],
  "title": "policy-report.json (Policy Workbench Kit)",
  "type": "object"
}