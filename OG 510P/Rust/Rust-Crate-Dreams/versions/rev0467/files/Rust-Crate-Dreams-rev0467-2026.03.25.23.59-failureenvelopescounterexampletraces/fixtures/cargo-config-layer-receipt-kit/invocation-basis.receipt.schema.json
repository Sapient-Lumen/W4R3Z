{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "invocation-basis.receipt",
  "type": "object",
  "required": ["basis_class", "capture_mode", "command_family", "cwd", "workspace_anchor", "explicit_overrides", "env_capture", "read_scope"],
  "properties": {
    "basis_class": {"enum": ["ambient_defaults", "invocation_scoped", "mixed_basis", "reconstructed"]},
    "capture_mode": {"enum": ["wrapped_live_invocation", "imported_observation", "file_reconstruction", "mixed"]},
    "command_family": {"type": "string"},
    "cwd": {"type": "string"},
    "workspace_anchor": {"type": "string"},
    "manifest_path": {"type": "string"},
    "explicit_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_class", "key"],
        "properties": {
          "source_class": {"enum": ["config_cli_key_value", "config_cli_file", "env", "token_flag", "other"]},
          "key": {"type": "string"},
          "observed": {"type": "boolean"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "env_capture": {"enum": ["observed_subset", "declared_none", "inferred_unknown", "mixed"]},
    "read_scope": {"enum": ["project_and_ancestors", "project_ancestors_and_cargo_home", "reconstructed_partial", "unknown"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
