{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/projection-reborrow/projection-support-bundle.manifest.schema.json",
  "title": "Projection support bundle manifest",
  "type": "object",
  "required": ["schema_version", "subject", "bundle_members"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "bundle_members": {
      "type": "object",
      "required": ["projection_authority_receipts", "borrow_semantics_matrices", "semantics_witness_reports"],
      "properties": {
        "projection_authority_receipts": {"type": "array", "items": {"type": "string"}},
        "borrow_semantics_matrices": {"type": "array", "items": {"type": "string"}},
        "semantics_witness_reports": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
