{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Miri Compare",
  "type": "object",
  "required": [
    "schema_version",
    "comparison_id",
    "relationship"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "comparison_id": {
      "type": "string"
    },
    "relationship": {
      "type": "string",
      "enum": [
        "same-finding",
        "borrow-only",
        "miri-only",
        "partially-overlapping",
        "not-comparable"
      ]
    },
    "reason": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
