{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestSurfaceDiffReport",
  "type": "object",
  "required": [
    "crate",
    "changes"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "fixture_added",
              "fixture_removed",
              "fake_backend_changed",
              "scenario_corpus_changed",
              "property_strategy_changed",
              "deterministic_seam_changed",
              "integration_topology_changed",
              "manual_review_required"
            ]
          },
          "surface": {
            "type": "string"
          }
        }
      }
    }
  }
}