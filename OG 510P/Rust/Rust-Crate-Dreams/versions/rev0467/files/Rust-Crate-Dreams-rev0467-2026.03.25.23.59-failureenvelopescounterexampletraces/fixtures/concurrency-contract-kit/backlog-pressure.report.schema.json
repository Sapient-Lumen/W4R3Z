{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/backlog-pressure.report.schema.json",
  "title": "backlog-pressure.report",
  "type": "object",
  "required": [
    "schema_version",
    "surface",
    "pressure_class",
    "claim_basis",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "surface": {
      "type": "string"
    },
    "pressure_class": {
      "type": "string"
    },
    "full_or_lag_trigger": {
      "type": "string"
    },
    "producer_effect": {
      "type": "string"
    },
    "consumer_effect": {
      "type": "string"
    },
    "loss_or_skip_posture": {
      "type": "string"
    },
    "growth_risk": {
      "type": "string"
    },
    "signal_visibility": {
      "type": "string"
    },
    "claim_basis": {
      "type": "string"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
