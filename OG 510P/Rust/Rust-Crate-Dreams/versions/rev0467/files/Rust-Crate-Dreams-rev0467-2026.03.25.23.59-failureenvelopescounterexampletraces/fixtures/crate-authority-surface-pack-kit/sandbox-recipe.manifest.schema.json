{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SandboxRecipeManifest",
  "type": "object",
  "required": [
    "schema_version",
    "recipes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "command"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "profile_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "restrictions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env_policy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fs_policy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "network_policy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
