{
  "profile": "dev",
  "target": "x86_64-unknown-linux-gnu",
  "support_posture": "interactive_debugger",
  "capture_sources": ["cargo_profile", "rustc_codegen", "filesystem_scan"],
  "observed_settings": {
    "debug": "full",
    "split_debuginfo": "unpacked",
    "strip": "none",
    "panic": "unwind"
  },
  "artifacts": [
    {
      "path": "target/debug/app",
      "artifact_kind": "bin",
      "debug_info_mode": "split_sidecar",
      "sidecars": ["target/debug/app.dwo"]
    }
  ],
  "notes": ["Split DWARF sidecar discovered; support posture should stay explicit about sidecar dependence"]
}
