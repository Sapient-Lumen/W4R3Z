{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted Publishing Publish Mode Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "scope",
    "mode",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "package",
        "workspace"
      ]
    },
    "mode": {
      "enum": [
        "trusted_publishing_only",
        "mixed_transition",
        "token_fallback_allowed",
        "manual_publish_only"
      ]
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "declared_mode"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "declared_mode": {
            "type": "string"
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "ok",
        "policy_mismatch",
        "manual_review_required"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
