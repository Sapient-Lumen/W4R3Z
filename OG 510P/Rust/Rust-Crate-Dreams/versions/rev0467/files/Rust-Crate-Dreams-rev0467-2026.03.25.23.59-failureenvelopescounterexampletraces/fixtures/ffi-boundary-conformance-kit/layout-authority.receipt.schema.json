{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "layout-authority.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "surface",
    "boundary_family",
    "representation_class",
    "source_of_truth",
    "verification_route",
    "by_value_crossing",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "surface": {"type": "string"},
    "boundary_family": {
      "type": "string",
      "enum": [
        "c_abi",
        "cxx_bridge",
        "uniffi",
        "diplomat",
        "wit_component",
        "manual_review_required"
      ]
    },
    "representation_class": {
      "type": "string",
      "enum": [
        "shared_by_value_type",
        "opaque_indirection_only",
        "serialized_buffer_lowering",
        "canonical_abi_value",
        "canonical_resource_handle",
        "header_declared_ffi_type",
        "manual_review_required"
      ]
    },
    "source_of_truth": {
      "type": "string",
      "enum": [
        "rust_definition",
        "foreign_definition",
        "interface_definition",
        "generated_projection",
        "mixed_or_unknown",
        "manual_review_required"
      ]
    },
    "verification_route": {
      "type": "string",
      "enum": [
        "static_assertions_or_compile_time_checks",
        "interface_typechecking",
        "generated_code_contract_only",
        "generated_header_only",
        "manual_review_only",
        "manual_review_required"
      ]
    },
    "by_value_crossing": {"type": "boolean"},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
