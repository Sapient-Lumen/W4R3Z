{
  "schema_version": "0.1",
  "profile": {
    "id": "serde_data_model_boundary",
    "version": "0.1.0",
    "summary": "Data-model crates stay format-neutral while exposing Serde support"
  },
  "required_public_surfaces": [
    "serde::Serialize",
    "serde::Deserialize"
  ],
  "forbidden_public_coupling": [
    "serde_json::Value in core model API"
  ],
  "optional_adapter_surfaces": [
    "feature:json-adapter",
    "feature:yaml-adapter"
  ],
  "behavioral_probes": [
    "compile_witness:model_roundtrip_via_generic_serializer"
  ]
}
