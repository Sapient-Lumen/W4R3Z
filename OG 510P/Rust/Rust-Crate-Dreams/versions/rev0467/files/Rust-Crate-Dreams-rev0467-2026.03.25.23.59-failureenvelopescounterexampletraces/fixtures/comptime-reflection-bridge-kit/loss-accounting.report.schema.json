{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loss-accounting.report",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "losses",
    "claim_ceiling"
  ],
  "properties": {
    "artifact": {"const": "loss-accounting.report"},
    "subject": {"type": "string"},
    "losses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metadata_class", "status", "reason"],
        "properties": {
          "metadata_class": {"type": "string"},
          "status": {
            "enum": ["preserved", "dropped", "synthesized", "manual_review_required"]
          },
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "claim_ceiling": {
      "enum": [
        "portable_type_shape_only",
        "type_shape_plus_docs_attrs",
        "runtime_mutation_capable",
        "format_schema_only",
        "manual_review_required"
      ]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
