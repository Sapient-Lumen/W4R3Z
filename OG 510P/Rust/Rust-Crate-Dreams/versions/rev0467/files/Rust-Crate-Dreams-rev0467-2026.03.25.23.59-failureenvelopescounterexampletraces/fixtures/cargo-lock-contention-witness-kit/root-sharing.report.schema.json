{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-lock-contention/root-sharing.report.schema.json",
  "title": "Cargo lock contention \u2014 root sharing report",
  "type": "object",
  "required": [
    "schema_version",
    "sharing_lanes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "sharing_lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lane_id",
          "root_ref",
          "roles",
          "sharing_state"
        ],
        "properties": {
          "lane_id": {
            "type": "string"
          },
          "root_ref": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sharing_state": {
            "type": "string",
            "enum": [
              "shared",
              "isolated",
              "mixed",
              "unknown"
            ]
          },
          "intended": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
