{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Performance Environment Fidelity Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "fidelity_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "fidelity_class": {
      "type": "string",
      "enum": [
        "claim_matched",
        "profile_mismatch",
        "harness_mismatch",
        "corpus_mismatch",
        "runtime_or_allocator_mismatch",
        "compat_layer_limitation",
        "manual_review_required"
      ]
    },
    "profile": {
      "type": "string"
    },
    "harness": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "known_distortions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
