{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tooling Interop Report",
  "type": "object",
  "required": [
    "schema_version",
    "trait_family",
    "recipe_kind",
    "tool_class",
    "interop_verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "trait_family": {
      "type": "string"
    },
    "recipe_kind": {
      "type": "string"
    },
    "tool_class": {
      "type": "string",
      "enum": [
        "mocking",
        "macro-composition",
        "test-support",
        "manual-review-required"
      ]
    },
    "tools_checked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interop_verdict": {
      "type": "string",
      "enum": [
        "works-with-constraints",
        "unsupported",
        "manual-review-required",
        "unknown"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
