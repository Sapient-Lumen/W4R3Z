{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/crate-health-contract-kit/response-channel.receipt.schema.json",
  "title": "ResponseChannelReceipt",
  "type": "object",
  "required": ["channel_id", "channel_kind", "audience", "confidentiality", "evidence_basis"],
  "properties": {
    "channel_id": {"type": "string"},
    "channel_kind": {
      "type": "string",
      "enum": [
        "public_issue_tracker",
        "discussion_forum",
        "private_security_reporting",
        "direct_email_alias",
        "manual_review_required"
      ]
    },
    "audience": {
      "type": "array",
      "items": {"type": "string"}
    },
    "confidentiality": {
      "type": "string",
      "enum": ["public", "private", "mixed", "manual_review_required"]
    },
    "structured_intake": {
      "type": "string",
      "enum": ["none", "issue_form", "discussion_template", "private_report_form", "manual_review_required"]
    },
    "fallback_channel": {"type": ["string", "null"]},
    "evidence_basis": {
      "type": "string",
      "enum": ["maintainer_declared", "repo_import", "registry_import", "inferred", "manual_review_required"]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
