{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/buildscript-report.schema.json",
  "title": "buildscript-report",
  "type": "object",
  "required": ["schema_version", "crate", "status", "observed_directives", "messages"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "status": {"enum": ["success", "failure", "warning_only", "manual_review_required"]},
    "capture_origin": {"enum": ["live_capture", "cargo_json_cached", "imported_log", "mixed"]},
    "script_identity": {
      "type": ["object", "null"],
      "properties": {
        "package_id": {"type": ["string", "null"]},
        "build_script_name": {"type": ["string", "null"]},
        "fresh": {"type": ["boolean", "null"]}
      },
      "additionalProperties": true
    },
    "observed_directives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "raw"],
        "properties": {
          "kind": {"type": "string"},
          "raw": {"type": "string"},
          "normalized": {"type": ["string", "object", "array", "null"]}
        },
        "additionalProperties": true
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel", "importance", "text"],
        "properties": {
          "channel": {"enum": ["stdout", "stderr", "directive", "summary"]},
          "importance": {"enum": ["info", "warning", "error", "actionable_fix", "manual_review_required"]},
          "text": {"type": "string"},
          "visibility": {"enum": ["shown_by_default", "hidden_unless_verbose", "shown_on_failure", "summary_only"]},
          "redacted": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "suggested_fix": {"type": ["string", "null"]},
    "redaction_policy": {"type": ["string", "null"]},
    "log_excerpt": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
