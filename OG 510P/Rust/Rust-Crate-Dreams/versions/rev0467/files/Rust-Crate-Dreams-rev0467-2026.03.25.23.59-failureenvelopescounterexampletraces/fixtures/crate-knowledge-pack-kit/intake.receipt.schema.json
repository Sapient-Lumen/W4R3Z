{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intake.receipt",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "subject",
    "imports",
    "manual_review_zones"
  ],
  "properties": {
    "schema_name": {
      "const": "intake.receipt"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "subject": {
      "type": "object",
      "required": ["crate", "version"],
      "properties": {
        "crate": { "type": "string" },
        "version": { "type": "string" },
        "target": { "type": "string" }
      },
      "additionalProperties": true
    },
    "imports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "import_id",
          "source_surface",
          "acquisition_mode",
          "pinned",
          "resolved_identity"
        ],
        "properties": {
          "import_id": { "type": "string" },
          "source_surface": {
            "type": "string",
            "enum": [
              "cargo_metadata",
              "cargo_json_stream",
              "registry_index",
              "docsrs_metadata",
              "docsrs_build_page",
              "docsrs_rustdoc_json",
              "docs_download_archive",
              "cargo_package_vcs_info",
              "manual_entry"
            ]
          },
          "acquisition_mode": {
            "type": "string",
            "enum": [
              "local_command",
              "pinned_url",
              "redirected_url",
              "downloaded_archive",
              "supplied_file",
              "manual_entry"
            ]
          },
          "pinned": { "type": "boolean" },
          "resolved_identity": {
            "type": "object",
            "properties": {
              "crate": { "type": "string" },
              "version": { "type": "string" },
              "target": { "type": "string" },
              "url": { "type": "string" }
            },
            "additionalProperties": true
          },
          "caveats": {
            "type": "array",
            "items": { "type": "string" }
          },
          "manual_review_required": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "manual_review_zones": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
