{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioWitnessReceipt",
  "type": "object",
  "required": ["schema_version", "scenario_witnesses"],
  "properties": {
    "schema_version": {"type": "string"},
    "scenario_witnesses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "support_level", "witness_status"],
        "properties": {
          "name": {"type": "string"},
          "support_level": {
            "type": "string",
            "enum": [
              "officially_supported",
              "best_effort_example",
              "experimental",
              "manual_review_required",
              "unknown"
            ]
          },
          "witness_status": {
            "type": "string",
            "enum": [
              "observed",
              "declared_only",
              "sample_only",
              "manual_review_required"
            ]
          },
          "fixture_refs": {
            "type": "array",
            "items": {"type": "string"}
          },
          "seam_refs": {
            "type": "array",
            "items": {"type": "string"}
          },
          "topology_refs": {
            "type": "array",
            "items": {"type": "string"}
          },
          "asset_refs": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
