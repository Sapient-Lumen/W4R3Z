{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/async-replay-debugger-kit/schedule-basis.receipt.schema.json",
  "title": "schedule-basis.receipt",
  "type": "object",
  "required": [
    "scenario",
    "runtime_family",
    "schedule_authority",
    "provenance"
  ],
  "properties": {
    "scenario": {
      "type": "string"
    },
    "runtime_family": {
      "type": "string",
      "enum": [
        "tokio",
        "shuttle_harness",
        "loom_model",
        "custom_executor",
        "mixed",
        "manual_review_required"
      ]
    },
    "schedule_authority": {
      "type": "string",
      "enum": [
        "exhaustive_model",
        "recorded_schedule",
        "seeded_scheduler",
        "live_trace_only",
        "manual_review_required"
      ]
    },
    "provenance": {
      "type": "string",
      "enum": [
        "saved_schedule",
        "seed_only",
        "trace_derived",
        "manual_review_required"
      ]
    },
    "execution_topology": {
      "type": "string",
      "enum": [
        "single_thread",
        "multi_thread",
        "model_only",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
