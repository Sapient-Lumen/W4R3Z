{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unit-topology.receipt",
  "type": "object",
  "required": [
    "subject",
    "units",
    "order_basis",
    "authority_route"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "order_basis": {
      "type": "string"
    },
    "authority_route": {
      "type": "string"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "unit_class",
          "position",
          "provenance"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "unit_class": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          },
          "provenance": {
            "type": "string"
          },
          "parameter_source": {
            "type": "string"
          }
        }
      }
    }
  }
}
