{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/debuggability-support-contract-kit/symbol-layout.manifest.schema.json",
  "title": "SymbolLayoutManifest",
  "type": "object",
  "required": ["artifacts"],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["binary_path", "primary_kind", "debug_info_mode", "sidecar_expectation"],
        "properties": {
          "binary_path": {"type": "string"},
          "primary_kind": {"type": "string"},
          "debug_info_mode": {"type": "string", "enum": ["embedded", "split_sidecar", "external_only", "absent", "manual_review_required"]},
          "sidecar_expectation": {"type": "string", "enum": ["pdb", "dsym", "dwo", "dwp", "none", "manual_review_required"]},
          "sidecars": {"type": "array", "items": {"type": "string"}},
          "embedded_visualizers": {"type": "array", "items": {"type": "string"}},
          "target": {"type": "string"}
        }
      }
    }
  }
}
