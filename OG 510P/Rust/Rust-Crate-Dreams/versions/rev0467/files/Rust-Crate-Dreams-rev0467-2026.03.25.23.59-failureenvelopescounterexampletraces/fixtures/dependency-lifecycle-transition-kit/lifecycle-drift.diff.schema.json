{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/dependency-lifecycle-transition-kit/lifecycle-drift.diff.schema.json",
  "title": "LifecycleDriftDiff",
  "type": "object",
  "required": ["summary", "changes"],
  "properties": {
    "summary": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "dependency"],
        "properties": {
          "kind": {"type": "string"},
          "dependency": {"type": "string"},
          "consumer": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
