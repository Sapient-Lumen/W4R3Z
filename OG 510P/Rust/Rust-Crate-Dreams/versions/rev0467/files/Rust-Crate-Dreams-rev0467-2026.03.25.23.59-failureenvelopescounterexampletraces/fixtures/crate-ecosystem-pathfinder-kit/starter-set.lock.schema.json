{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/starter-set.lock.schema.json",
  "title": "Crate pathfinder starter-set lock",
  "type": "object",
  "required": ["schema_version", "task", "selected"],
  "properties": {
    "schema_version": {"type": "string"},
    "task": {"type": "string"},
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "crate"],
        "properties": {
          "role": {"type": "string"},
          "crate": {"type": "string"},
          "version": {"type": ["string", "null"]},
          "accepted_tradeoffs": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "reviewed_at": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
