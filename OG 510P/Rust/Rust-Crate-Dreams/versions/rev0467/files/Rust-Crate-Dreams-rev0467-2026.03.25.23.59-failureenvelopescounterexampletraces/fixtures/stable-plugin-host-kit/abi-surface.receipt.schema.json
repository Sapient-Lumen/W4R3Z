{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stable-plugin-host-kit/abi-surface.receipt.schema.json",
  "title": "abi-surface.receipt",
  "type": "object",
  "required": [
    "scenario",
    "surface_class",
    "root_authority",
    "load_check_basis"
  ],
  "properties": {
    "scenario": {
      "type": "string"
    },
    "surface_class": {
      "type": "string",
      "enum": [
        "abi_stable_prefix_module",
        "abi_stable_trait_object",
        "serialized_boundary",
        "c_abi_shim",
        "manual_review_required"
      ]
    },
    "interface_crate": {
      "type": "string"
    },
    "root_authority": {
      "type": "string"
    },
    "load_check_basis": {
      "type": "string",
      "enum": [
        "abi_stable_root_module",
        "manual_symbol_lookup",
        "out_of_band_contract",
        "manual_review_required"
      ]
    },
    "extensibility_posture": {
      "type": "string",
      "enum": [
        "prefix_additive",
        "fixed_vtable",
        "serialized_schema_evolution",
        "manual_review_required"
      ]
    },
    "transport_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
