{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Performance Execution Intent Report",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "intent"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "intent": {
      "type": "string",
      "enum": [
        "authoritative_measurement",
        "supporting_measurement",
        "smoke_only",
        "compile_and_run_sanity",
        "replay_only",
        "manual_review_required"
      ]
    },
    "authoritative_metric": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
