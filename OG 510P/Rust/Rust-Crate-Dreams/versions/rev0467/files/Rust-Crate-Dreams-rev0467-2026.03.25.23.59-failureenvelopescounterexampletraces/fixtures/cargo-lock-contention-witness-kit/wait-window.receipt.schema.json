    "actor": {
      "type": "string"
    },
    "wait_class": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "stalled_phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocker_identity_exactness": {
      "type": "string"
    },
    "supporting_sessions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
