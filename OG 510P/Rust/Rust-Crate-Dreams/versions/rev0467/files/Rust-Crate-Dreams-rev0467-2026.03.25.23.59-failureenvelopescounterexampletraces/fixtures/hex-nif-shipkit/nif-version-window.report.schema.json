{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.local/hex-nif-shipkit/nif-version-window.report.schema.json",
  "title": "Hex NIF version window report",
  "type": "object",
  "required": ["package", "class", "configured_min_nif", "claimed_otp_support", "manual_review_required"],
  "properties": {
    "package": {"type": "string"},
    "class": {"enum": ["nif_version_window_honest", "nif_window_claim_exceeds_features", "manual_review_required"]},
    "configured_min_nif": {"type": "string"},
    "claimed_otp_support": {"type": "string"},
    "compatible_nif_majors": {"type": "array", "items": {"type": "string"}},
    "feature_sources": {"type": "array", "items": {"type": "string"}},
    "manual_review_required": {"type": "boolean"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
