{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HazardAuthorityReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "hazards"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "lane": { "type": "string" },
    "hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hazard_id",
          "authority_kind",
          "evidence_status",
          "supports_classes"
        ],
        "properties": {
          "hazard_id": { "type": "string" },
          "authority_kind": {
            "enum": [
              "semver_public_api",
              "feature_policy",
              "config_policy",
              "runtime_policy",
              "behavior_witness",
              "maintainer_note",
              "docs_only"
            ]
          },
          "origin_tool": { "type": "string" },
          "evidence_status": {
            "enum": [
              "observed",
              "imported",
              "declared",
              "missing"
            ]
          },
          "supports_classes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
