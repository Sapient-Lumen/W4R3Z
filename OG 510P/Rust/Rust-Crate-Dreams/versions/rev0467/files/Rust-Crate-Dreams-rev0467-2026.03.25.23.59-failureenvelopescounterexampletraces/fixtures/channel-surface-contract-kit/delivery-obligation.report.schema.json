{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "delivery-obligation.report",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "visibility_scope",
    "subscription_history",
    "message_clone_model",
    "delivery_claim_strength"
  ],
  "properties": {
    "artifact": {
      "const": "delivery-obligation.report"
    },
    "subject": {
      "type": "string"
    },
    "visibility_scope": {
      "enum": [
        "one_consumer",
        "one_of_many_consumers",
        "all_current_subscribers",
        "latest_value_only"
      ]
    },
    "subscription_history": {
      "enum": [
        "full_buffered_history",
        "future_only",
        "latest_only",
        "manual_review_required"
      ]
    },
    "message_clone_model": {
      "enum": [
        "move_once",
        "clone_per_receiver",
        "shared_latest_state",
        "manual_review_required"
      ]
    },
    "delivery_claim_strength": {
      "enum": [
        "enqueued_only",
        "enqueued_and_receivable",
        "visible_as_latest",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
