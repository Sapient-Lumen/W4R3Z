{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/activation-boundary.report.schema.json",
  "title": "ActivationBoundaryReport",
  "type": "object",
  "required": [
    "activation_class",
    "activation_trigger",
    "stale_frames_can_continue",
    "manual_review_reasons"
  ],
  "properties": {
    "activation_class": {
      "type": "string",
      "enum": [
        "immediate_global_switch",
        "next_annotated_entrypoint",
        "next_reloadable_call",
        "after_explicit_handoff",
        "restart_only",
        "unknown"
      ]
    },
    "activation_trigger": {
      "type": "string",
      "enum": [
        "dylib_swap",
        "annotated_function_call",
        "reload_event_pair",
        "event_loop_turn",
        "full_restart",
        "manual_review",
        "unknown"
      ]
    },
    "stale_frames_can_continue": {
      "type": "boolean"
    },
    "activation_scope_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
