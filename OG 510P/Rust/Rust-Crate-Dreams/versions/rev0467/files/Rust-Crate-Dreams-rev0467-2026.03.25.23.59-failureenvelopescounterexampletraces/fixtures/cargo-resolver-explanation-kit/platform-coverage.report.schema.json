{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "platform-coverage.report",
  "type": "object",
  "required": [
    "schema_version",
    "targets",
    "clauses"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "selector",
          "status"
        ],
        "properties": {
          "selector": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "selected_target",
              "all_target_graph_only",
              "not_selected"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
