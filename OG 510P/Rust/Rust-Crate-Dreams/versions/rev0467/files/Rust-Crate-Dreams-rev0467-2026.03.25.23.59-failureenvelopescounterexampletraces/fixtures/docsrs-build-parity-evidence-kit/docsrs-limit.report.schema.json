{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docs.rs Limit Report",
  "type": "object",
  "required": ["schema_version", "limit_facts"],
  "properties": {
    "schema_version": {"type": "string"},
    "limit_facts": {
      "type": "object",
      "properties": {
        "max_targets": {"type": "integer"},
        "network_blocked": {"type": "boolean"},
        "read_only_source_tree": {"type": "boolean"},
        "rustdoc_time_minutes": {"type": "integer"},
        "max_log_kib": {"type": "number"}
      }
    },
    "findings": {"type": "array", "items": {"type": "string"}}
  }
}
