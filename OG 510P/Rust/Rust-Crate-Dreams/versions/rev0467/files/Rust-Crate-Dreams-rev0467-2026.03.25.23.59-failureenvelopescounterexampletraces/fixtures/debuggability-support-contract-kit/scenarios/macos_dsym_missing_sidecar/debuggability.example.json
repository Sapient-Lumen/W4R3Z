{
  "profile": "release",
  "target": "aarch64-apple-darwin",
  "support_posture": "manual_review_required",
  "capture_sources": ["cargo_profile", "rustc_codegen", "filesystem_scan"],
  "observed_settings": {
    "debug": "full",
    "split_debuginfo": "packed",
    "strip": "none",
    "panic": "unwind"
  },
  "artifacts": [
    {
      "path": "target/release/app",
      "artifact_kind": "bin",
      "debug_info_mode": "split_sidecar",
      "sidecars": []
    }
  ],
  "policy_reference": "policies/release-debuggability.toml",
  "notes": ["Expected dSYM sidecar not found in exported bundle"]
}
