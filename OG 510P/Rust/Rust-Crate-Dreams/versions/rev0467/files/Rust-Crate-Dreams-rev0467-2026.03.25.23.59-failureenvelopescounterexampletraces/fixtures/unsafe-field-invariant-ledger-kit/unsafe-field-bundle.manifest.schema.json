{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/unsafe-field-invariant-ledger-kit/unsafe-field-bundle.manifest.schema.json",
  "title": "Unsafe Field Bundle Manifest",
  "type": "object",
  "required": ["schema_version", "bundle_id", "artifacts"],
  "properties": {
    "schema_version": {"type": "string"},
    "bundle_id": {"type": "string"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "properties": {
          "kind": {"enum": ["field_authority", "mutation_lane", "trusted_constructor", "invariant_witness", "field_contract_drift", "notes", "source_excerpt", "other"]},
          "path": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
