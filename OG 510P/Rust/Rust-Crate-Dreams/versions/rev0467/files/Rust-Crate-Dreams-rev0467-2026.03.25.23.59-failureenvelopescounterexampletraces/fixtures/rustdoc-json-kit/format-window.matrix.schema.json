{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/format-window.matrix.schema.json",
  "title": "format-window.matrix",
  "type": "object",
  "required": [
    "schema_version",
    "consumer_name",
    "windows",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "consumer_name": {"type": "string"},
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["format_version", "support_class"],
        "properties": {
          "format_version": {"type": "integer"},
          "toolchain_window": {"type": "string"},
          "adapter_class": {
            "type": "string",
            "enum": ["native", "translated", "legacy_shim", "unsupported", "unknown"]
          },
          "support_class": {
            "type": "string",
            "enum": ["full", "partial", "legacy_import_only", "unsupported", "unknown"]
          },
          "query_support": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": true
}
