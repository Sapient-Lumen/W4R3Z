{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sidecar-contract.lock",
  "type": "object",
  "required": ["schema_version", "workspace_root", "package_scope", "profile", "toolchain", "artifact_discovery_mode"],
  "properties": {
    "schema_version": {"type": "string"},
    "workspace_root": {"type": "string"},
    "package_scope": {"type": "array", "items": {"type": "string"}},
    "target_scope": {"type": "array", "items": {"type": "string"}},
    "profile": {"type": "string"},
    "toolchain": {"type": "string"},
    "artifact_discovery_mode": {
      "type": "string",
      "enum": ["compiler_artifact_stream", "artifact_dir_scan", "mixed", "manual_import"]
    },
    "redaction_mode": {"type": "string"}
  },
  "additionalProperties": true
}
