{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-lock-contention/wrapper-context.receipt.schema.json",
  "title": "Cargo lock contention \u2014 wrapper context receipt",
  "type": "object",
  "required": [
    "schema_version",
    "roles"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "wrapper_mode",
          "hash_separation_hint"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "editor_check",
              "manual_build",
              "test_runner",
              "doc_build",
              "ci_job",
              "unknown_role"
            ]
          },
          "wrapper_mode": {
            "type": "string",
            "enum": [
              "none",
              "rust_analyzer_wrapper",
              "rustc_wrapper",
              "rustc_workspace_wrapper",
              "nested_wrappers",
              "manual_review_required"
            ]
          },
          "hash_separation_hint": {
            "type": "string",
            "enum": [
              "same_cache_mode",
              "separate_filename_hash",
              "unknown"
            ]
          },
          "observed_from": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "env",
                "cargo_config",
                "tool_config",
                "manual_annotation"
              ]
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
