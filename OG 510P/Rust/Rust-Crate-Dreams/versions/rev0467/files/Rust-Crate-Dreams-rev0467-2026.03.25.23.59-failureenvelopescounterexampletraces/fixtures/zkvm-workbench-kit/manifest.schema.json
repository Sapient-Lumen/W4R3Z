{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "zkbundle manifest",
  "type": "object",
  "required": [
    "schema_version",
    "backend",
    "toolchain",
    "guest",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "backend": {
      "type": "string",
      "description": "e.g., risc0, sp1"
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "rustc": {
          "type": "string"
        },
        "backend_version": {
          "type": "string"
        }
      }
    },
    "guest": {
      "type": "object",
      "properties": {
        "crate": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "cycles": {
          "type": "integer"
        },
        "proof_size_bytes": {
          "type": "integer"
        },
        "proving_time_ms": {
          "type": "integer"
        }
      }
    }
  }
}