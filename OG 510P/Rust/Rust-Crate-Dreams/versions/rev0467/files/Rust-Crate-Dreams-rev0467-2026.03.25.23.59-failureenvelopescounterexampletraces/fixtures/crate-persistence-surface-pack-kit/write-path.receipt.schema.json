{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persistence Write Path Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "surface",
    "write_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "surface": {
      "type": "string"
    },
    "write_class": {
      "type": "string",
      "enum": [
        "write_in_place",
        "tempfile_replace",
        "append_journal",
        "transaction_commit",
        "remote_ack",
        "manual_review_required"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "buffered_write",
          "flush_called",
          "sync_data_called",
          "sync_all_called",
          "rename_used",
          "directory_sync_observed",
          "transaction_commit_observed",
          "remote_ack_observed",
          "manual_review_required"
        ]
      }
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
