{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sidecar-association.receipt",
  "type": "object",
  "required": ["schema_version", "associations"],
  "properties": {
    "schema_version": {"type": "string"},
    "associations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sidecar_path", "artifact_path", "association_kind", "evidence_source", "exactness"],
        "properties": {
          "sidecar_path": {"type": "string"},
          "artifact_path": {"type": ["string", "null"]},
          "association_kind": {"type": "string", "enum": ["matched", "ambiguous", "unmatched"]},
          "evidence_source": {"type": "string", "enum": ["compiler_artifact_stream", "artifact_dir_scan", "cargo_sbom_path_env", "filename_match", "manual_mapping"]},
          "exactness": {"type": "string", "enum": ["exact", "conservative", "manual_review_required"]},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "additionalProperties": true
}
