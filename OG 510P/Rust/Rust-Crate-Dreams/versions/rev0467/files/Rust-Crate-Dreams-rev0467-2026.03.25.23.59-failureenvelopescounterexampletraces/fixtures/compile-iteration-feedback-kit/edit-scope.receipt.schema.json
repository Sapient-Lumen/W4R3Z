{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/edit-scope.receipt.schema.json",
  "title": "EditScopeReceipt",
  "type": "object",
  "required": [
    "artifact_scope",
    "semantic_change_class",
    "topology_scope",
    "interface_impact_class",
    "confidence_class"
  ],
  "properties": {
    "artifact_scope": {
      "type": "string",
      "enum": [
        "rsx_markup",
        "css_asset",
        "static_asset",
        "rust_function_body",
        "rust_type_layout",
        "public_api_surface",
        "global_or_static",
        "thread_local",
        "build_or_config",
        "dependency_crate",
        "workspace_peer_crate",
        "unknown"
      ]
    },
    "semantic_change_class": {
      "type": "string",
      "enum": [
        "presentation_only",
        "implementation_only",
        "interface_affecting",
        "layout_affecting",
        "runtime_global_affecting",
        "tooling_route_affecting",
        "mixed",
        "unknown"
      ]
    },
    "topology_scope": {
      "type": "string",
      "enum": [
        "tip_crate",
        "local_dependency_crate",
        "workspace_peer",
        "transitive_dependency",
        "frontend_only",
        "mixed_frontend_and_rust",
        "unknown"
      ]
    },
    "interface_impact_class": {
      "type": "string",
      "enum": [
        "public_interface_preserved",
        "public_interface_changed",
        "not_applicable",
        "unknown"
      ]
    },
    "confidence_class": {
      "type": "string",
      "enum": [
        "direct_observation",
        "imported_substrate",
        "conservative_inference",
        "manual_review"
      ]
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
