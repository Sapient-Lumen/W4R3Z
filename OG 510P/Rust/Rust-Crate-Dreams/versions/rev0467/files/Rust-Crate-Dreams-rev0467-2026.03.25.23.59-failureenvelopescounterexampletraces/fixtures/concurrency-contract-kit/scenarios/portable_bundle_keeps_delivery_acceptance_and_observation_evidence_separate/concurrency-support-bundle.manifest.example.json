{
  "schema_version": "2026-03-23",
  "bundle_name": "portable-delivery-acceptance-observation-bundle",
  "artifacts": [
    {
      "kind": "delivery-acceptance.report",
      "path": "delivery-acceptance.report.json",
      "required": false
    },
    {
      "kind": "observation-evidence.report",
      "path": "observation-evidence.report.json",
      "required": false
    },
    {
      "kind": "delivery-audience.report",
      "path": "delivery-audience.report.json",
      "required": false
    },
    {
      "kind": "consumption-claim.report",
      "path": "consumption-claim.report.json",
      "required": false
    },
    {
      "kind": "delivery-memory.report",
      "path": "delivery-memory.report.json",
      "required": false
    },
    {
      "kind": "backlog-pressure.report",
      "path": "backlog-pressure.report.json",
      "required": false
    }
  ],
  "artifact_policy": "keep_acceptance_evidence_audience_claim_memory_and_pressure_separate",
  "notes": [
    "Producer-visible success is not proof of downstream observation.",
    "Receiver-count hints and close signals remain weaker than application-level acknowledgments."
  ]
}
