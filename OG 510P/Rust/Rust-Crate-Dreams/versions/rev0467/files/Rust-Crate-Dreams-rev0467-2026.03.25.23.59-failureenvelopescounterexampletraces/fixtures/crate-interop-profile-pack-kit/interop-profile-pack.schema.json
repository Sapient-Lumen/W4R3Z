{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crate interop profile pack",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "required_public_surfaces"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "manual_review_zones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "required_public_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_public_coupling": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional_adapter_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "behavioral_probes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
