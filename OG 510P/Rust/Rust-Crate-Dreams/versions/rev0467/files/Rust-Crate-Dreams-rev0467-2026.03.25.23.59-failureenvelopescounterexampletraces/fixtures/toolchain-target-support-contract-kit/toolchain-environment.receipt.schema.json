{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toolchain Environment Receipt",
  "type": "object",
  "required": ["schema_version", "host", "active_toolchain"],
  "properties": {
    "schema_version": {"type": "string"},
    "host": {"type": "string"},
    "active_toolchain": {"type": "string"},
    "installed_components": {"type": "array", "items": {"type": "string"}},
    "installed_targets": {"type": "array", "items": {"type": "string"}},
    "external_linker": {"type": ["string", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
