{
  "schema_version": "1.0",
  "layers": [
    {
      "source": "/home/alice/.cargo/config.toml",
      "route": "config_file",
      "precedence": 0,
      "path_basis": "cargo_home"
    },
    {
      "source": "/work/.cargo/config.toml",
      "route": "config_file",
      "precedence": 1,
      "path_basis": "config_parent",
      "includes": ["/work/.cargo/local-runner.toml"]
    },
    {
      "source": "/work/.cargo/local-runner.toml",
      "route": "config_include",
      "precedence": 2,
      "path_basis": "config_parent"
    },
    {
      "source": "build.target-dir=\"/tmp/custom-target\"",
      "route": "cli_key_value",
      "precedence": 3,
      "path_basis": "cwd"
    }
  ],
  "notes": [
    "CLI override takes precedence over environment and config files.",
    "Included config paths are relative to the including config file."
  ]
}
