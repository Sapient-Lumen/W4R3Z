{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/semver-api-diff/witness-plan.schema.json",
  "title": "Witness plan",
  "type": "object",
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"type": "string"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "item_path", "reason", "expected_decider"],
        "properties": {
          "id": {"type": "string"},
          "item_path": {"type": "string"},
          "reason": {"type": "string"},
          "expected_decider": {"type": "string", "enum": ["rule", "witness", "manual_review"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
