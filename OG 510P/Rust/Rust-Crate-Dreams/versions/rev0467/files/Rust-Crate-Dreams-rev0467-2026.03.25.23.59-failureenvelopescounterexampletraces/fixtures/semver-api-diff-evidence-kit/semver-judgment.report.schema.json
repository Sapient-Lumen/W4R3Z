{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/semver-api-diff/semver-judgment.report.schema.json",
  "title": "SemVer judgment report",
  "type": "object",
  "required": ["schema_version", "judgments"],
  "properties": {
    "schema_version": {"type": "string"},
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_path", "decision", "basis"],
        "properties": {
          "item_path": {"type": "string"},
          "decision": {"type": "string", "enum": ["compatible", "breaking", "manual_review_required"]},
          "basis": {"type": "string", "enum": ["rule", "witness", "mixed", "manual_review"]},
          "summary": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
