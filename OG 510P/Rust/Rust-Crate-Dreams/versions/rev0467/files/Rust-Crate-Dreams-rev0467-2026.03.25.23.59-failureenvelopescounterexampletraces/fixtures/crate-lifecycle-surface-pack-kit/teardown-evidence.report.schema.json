{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle Teardown Evidence Report",
  "type": "object",
  "required": ["schema_version", "components"],
  "properties": {
    "schema_version": {"type": "string"},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "evidence_class"],
        "properties": {
          "name": {"type": "string"},
          "evidence_class": {
            "type": "string",
            "enum": [
              "no_teardown_required",
              "shutdown_requested_only",
              "join_completion_observed",
              "tracker_drained_observed",
              "protocol_shutdown_observed",
              "flush_then_shutdown_observed",
              "blocking_task_returned",
              "manual_review_required"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
