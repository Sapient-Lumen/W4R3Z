{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision-revalidation.report",
  "type": "object",
  "required": [
    "decision_ref",
    "status",
    "triggers"
  ],
  "properties": {
    "decision_ref": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class",
          "summary"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "same_task_profile": {
      "type": "boolean"
    },
    "same_policy": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
