{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "execution-budget.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "interrupt_basis",
    "interrupt_determinism",
    "memory_budget_basis",
    "concurrency_posture"
  ],
  "properties": {
    "artifact": {"const": "execution-budget.receipt"},
    "subject": {"type": "string"},
    "interrupt_basis": {
      "enum": ["fuel", "epoch", "timeout_only", "none", "manual_review_required"]
    },
    "interrupt_determinism": {
      "enum": ["deterministic", "coarse_grained", "host_only", "none", "manual_review_required"]
    },
    "memory_budget_basis": {
      "enum": ["manifest_max_pages", "pooling_allocator_limits", "store_limiter", "none", "manual_review_required"]
    },
    "concurrency_posture": {
      "enum": ["single_instance", "pooled_instances", "host_defined", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
