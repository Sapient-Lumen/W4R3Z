{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExampleCatalogReceipt",
  "type": "object",
  "required": [
    "crate",
    "sources"
  ],
  "properties": {
    "crate": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "properties": {
          "path": {"type": "string"},
          "kind": {
            "enum": [
              "readme",
              "rustdoc",
              "examples_target",
              "guide",
              "external_doc",
              "manual_review_required"
            ]
          }
        }
      }
    }
  }
}
