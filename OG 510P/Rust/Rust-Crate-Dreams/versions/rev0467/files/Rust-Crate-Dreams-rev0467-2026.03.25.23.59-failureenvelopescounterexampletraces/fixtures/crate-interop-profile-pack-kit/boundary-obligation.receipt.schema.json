{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoundaryObligationReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "obligations"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "origin_class"
        ],
        "properties": {
          "kind": {
            "enum": [
              "required_public_surface",
              "forbidden_public_coupling",
              "adapter_feature_required",
              "runtime_coupling_must_be_explicit",
              "body_error_shape_alignment_required",
              "format_specific_helpers_must_stay_internal",
              "manual_review_required"
            ]
          },
          "origin_class": {
            "enum": [
              "profile_pack_declared",
              "manifest_observed",
              "rustdoc_json_observed",
              "compile_witness_observed",
              "behavior_probe_observed",
              "pair_probe_observed",
              "maintainer_declared"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "impact": {
            "enum": [
              "none",
              "low",
              "medium",
              "high",
              "hard_incompatibility",
              "manual_review_required"
            ]
          }
        }
      }
    }
  }
}
