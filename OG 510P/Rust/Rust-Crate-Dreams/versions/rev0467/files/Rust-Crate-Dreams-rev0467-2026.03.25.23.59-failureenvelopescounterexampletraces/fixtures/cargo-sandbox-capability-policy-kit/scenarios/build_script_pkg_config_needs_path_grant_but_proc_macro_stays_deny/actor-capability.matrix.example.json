{
  "schema_version": "1",
  "subject": "demo-sys 0.4.0",
  "actors": [
    {
      "actor_name": "demo-sys build.rs",
      "actor_class": "build_script",
      "granularity": "separate_actor",
      "fs_read_roots": [
        "/usr/include",
        "$CARGO_MANIFEST_DIR/vendor"
      ],
      "fs_write_roots": [
        "$OUT_DIR"
      ],
      "env_read": [
        "HOST",
        "TARGET",
        "PKG_CONFIG_PATH",
        "OUT_DIR"
      ],
      "network": "deny",
      "process_spawn": "allowlist",
      "notes": "pkg-config and cc are allowed; network remains denied"
    },
    {
      "actor_name": "derive-helper proc-macro lane",
      "actor_class": "proc_macro_lane",
      "granularity": "shared_lane",
      "fs_read_roots": [],
      "fs_write_roots": [],
      "env_read": [
        "CARGO_ENCODED_RUSTFLAGS"
      ],
      "network": "deny",
      "process_spawn": "deny",
      "notes": "must not inherit build.rs path grants"
    }
  ]
}
