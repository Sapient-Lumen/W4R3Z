{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/clippy-safety-profile-waiver-kit/lint-support-bundle.manifest.schema.json",
  "title": "Lint Support Bundle Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "bundle_id": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
