{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/crate-diagnosis-surface-pack-kit/symptom-class.policy.schema.json",
  "title": "Symptom class policy",
  "type": "object",
  "required": ["symptom_class", "meaning", "root_cause_claim", "automation_posture"],
  "properties": {
    "symptom_class": {"type": "string"},
    "meaning": {"type": "string"},
    "root_cause_claim": {"type": "string", "enum": ["forbidden", "manual_review_required", "limited"]},
    "automation_posture": {"type": "string", "enum": ["official", "partial", "manual_review_required"]},
    "ambiguity_notes": {"type": "array", "items": {"type": "string"}},
    "split_required_when": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
