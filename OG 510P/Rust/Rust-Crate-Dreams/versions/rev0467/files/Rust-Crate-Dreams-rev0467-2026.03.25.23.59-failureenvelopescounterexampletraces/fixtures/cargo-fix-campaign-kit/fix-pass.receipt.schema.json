{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FixPassReceipt",
  "type": "object",
  "required": [
    "pass_id",
    "selected_lints",
    "targets",
    "verification_status",
    "rollback_performed"
  ],
  "properties": {
    "pass_id": {
      "type": "string"
    },
    "selected_lints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_status": {
      "enum": [
        "passed",
        "failed",
        "manual_review_required"
      ]
    },
    "rollback_performed": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
