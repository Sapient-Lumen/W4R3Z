{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy-decision.report",
  "type": "object",
  "required": [
    "schema_version",
    "surface",
    "gate_result",
    "gate_threshold",
    "waiver_posture",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "surface": {"type": "string"},
    "gate_result": {
      "type": "string",
      "enum": [
        "pass",
        "pass_with_exceptions",
        "review_required",
        "fail",
        "manual_review_required"
      ]
    },
    "gate_threshold": {
      "type": "string",
      "enum": [
        "info",
        "warn",
        "err",
        "engine_default",
        "manual_review_required"
      ]
    },
    "waiver_posture": {
      "type": "string",
      "enum": [
        "none",
        "ignored_rules_present",
        "time_bounded_exception",
        "manual_review_required"
      ]
    },
    "ignored_rule_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "waiver_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
