{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/apple-xcframework-swiftpm-shipkit/package-alignment.report.schema.json",
  "title": "ApplePackageAlignmentReport",
  "type": "object",
  "required": ["package_name", "alignment_class", "distribution_mode"],
  "properties": {
    "package_name": {"type": "string"},
    "alignment_class": {
      "type": "string",
      "enum": [
        "aligned_remote_binary_target",
        "aligned_local_binary_target",
        "checksum_or_zip_mismatch",
        "module_identity_drift",
        "deployment_claim_exceeds_bundle",
        "manual_review_required"
      ]
    },
    "distribution_mode": {"type": "string", "enum": ["remote_url", "local_path", "mixed", "unknown"]},
    "binary_target": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "url": {"type": "string"},
        "checksum": {"type": "string"},
        "path": {"type": "string"}
      }
    },
    "artifact_identity": {
      "type": "object",
      "properties": {
        "module_name": {"type": "string"},
        "xcframework_name": {"type": "string"},
        "zip_sha256": {"type": "string"}
      }
    },
    "drifts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "details"],
        "properties": {
          "kind": {"type": "string"},
          "details": {"type": "string"}
        }
      }
    }
  }
}
