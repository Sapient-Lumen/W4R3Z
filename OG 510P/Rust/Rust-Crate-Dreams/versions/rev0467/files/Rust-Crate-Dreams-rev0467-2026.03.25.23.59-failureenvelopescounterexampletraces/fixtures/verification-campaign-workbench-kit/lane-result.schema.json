{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification Campaign Lane Result",
  "type": "object",
  "required": [
    "lane_id",
    "tool_family",
    "result_kind",
    "lane_semantics",
    "obligation_results"
  ],
  "properties": {
    "lane_id": {
      "type": "string"
    },
    "tool_family": {
      "type": "string"
    },
    "tool_version": {
      "type": "string"
    },
    "result_kind": {
      "type": "string"
    },
    "lane_semantics": {
      "type": "object",
      "required": [
        "evidence_kind",
        "soundness_scope"
      ],
      "properties": {
        "evidence_kind": {
          "type": "string"
        },
        "soundness_scope": {
          "type": "string"
        },
        "trust_surface": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported_surface": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manual_review_required": {
          "type": "boolean"
        }
      }
    },
    "obligation_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "obligation_id",
          "status"
        ],
        "properties": {
          "obligation_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidence_strength": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "counterexample_ref": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object"
    }
  }
}
