{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spiffe-identity-kit identity-source receipt",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "source_mode",
    "credential_kind",
    "endpoint_kind",
    "rotation_mode"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "source_mode": {
      "type": "string",
      "enum": [
        "workload_api_live_x509",
        "workload_api_live_jwt",
        "spire_delegated_identity",
        "static_dev_identity",
        "manual_review_required"
      ]
    },
    "credential_kind": {"type": "string", "enum": ["x509", "jwt", "mixed", "unknown"]},
    "endpoint_kind": {"type": "string", "enum": ["unix_socket", "tcp", "in_process", "manual", "unknown"]},
    "rotation_mode": {"type": "string", "enum": ["watch_driven", "fetch_on_demand", "static_until_restart", "manual_review_required"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
