{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/crate-health-contract-kit/work-routing.report.schema.json",
  "title": "WorkRoutingReport",
  "type": "object",
  "required": ["crate", "routes"],
  "properties": {
    "crate": {"type": "string"},
    "routes": {
      "type": "array",
      "items": {"$ref": "#/$defs/route"}
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "required": ["work_class", "channel_ref", "confidentiality", "owner_class", "evidence_basis"],
      "properties": {
        "work_class": {"type": "string"},
        "channel_ref": {"type": "string"},
        "confidentiality": {
          "type": "string",
          "enum": ["public", "private", "mixed", "manual_review_required"]
        },
        "owner_class": {
          "type": "string",
          "enum": [
            "primary_maintainer",
            "maintainer_team",
            "organization_owner",
            "rotating_review_pool",
            "security_contact",
            "manual_review_required"
          ]
        },
        "backup_route": {"type": ["string", "null"]},
        "evidence_basis": {
          "type": "string",
          "enum": ["maintainer_declared", "repo_import", "registry_import", "inferred", "manual_review_required"]
        },
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
