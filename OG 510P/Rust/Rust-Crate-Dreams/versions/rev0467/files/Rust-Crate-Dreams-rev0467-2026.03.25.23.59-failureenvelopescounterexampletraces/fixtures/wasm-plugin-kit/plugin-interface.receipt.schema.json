{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plugin-interface.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "interface_kind",
    "binding_basis",
    "compatibility_class"
  ],
  "properties": {
    "artifact": {"const": "plugin-interface.receipt"},
    "subject": {"type": "string"},
    "interface_kind": {
      "enum": ["wit_world", "extism_host_functions", "exported_symbol_set", "manual_review_required"]
    },
    "package_id": {"type": ["string", "null"]},
    "world_id": {"type": ["string", "null"]},
    "binding_basis": {
      "enum": ["wasmtime_bindgen", "wit_bindgen_guest", "extism_pdk", "manual_host_api", "manual_review_required"]
    },
    "compatibility_class": {
      "enum": ["component_exact", "component_adapter_required", "host_specific", "experimental_tooling", "manual_review_required"]
    },
    "imports": {"type": "array", "items": {"type": "string"}},
    "exports": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
