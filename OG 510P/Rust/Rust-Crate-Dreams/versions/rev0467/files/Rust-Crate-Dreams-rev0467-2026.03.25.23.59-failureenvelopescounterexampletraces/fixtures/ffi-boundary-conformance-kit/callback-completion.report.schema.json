{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "callback-completion.report",
  "type": "object",
  "required": [
    "artifact",
    "callback_surface",
    "completion_signal",
    "delivery_guarantee",
    "cancellation_support",
    "late_completion_after_teardown",
    "unexpected_error_posture",
    "verdict"
  ],
  "properties": {
    "artifact": {
      "const": "callback-completion.report"
    },
    "callback_surface": {
      "type": "string"
    },
    "completion_signal": {
      "type": "string",
      "enum": [
        "inline_return",
        "done_callback",
        "channel_send",
        "rust_call_status",
        "none",
        "unspecified"
      ]
    },
    "delivery_guarantee": {
      "type": "string",
      "enum": [
        "exactly_once",
        "at_most_once",
        "best_effort",
        "unspecified"
      ]
    },
    "cancellation_support": {
      "type": "string",
      "enum": [
        "supported",
        "optional",
        "unsupported",
        "unknown"
      ]
    },
    "late_completion_after_teardown": {
      "type": "string",
      "enum": [
        "possible",
        "guarded",
        "impossible",
        "unknown"
      ]
    },
    "unexpected_error_posture": {
      "type": "string",
      "enum": [
        "mapped_to_declared_error",
        "internal_error_channel",
        "panic_if_unmapped",
        "unspecified"
      ]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "docs_import",
        "generated_code_import",
        "direct_test",
        "manual_review"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "supported_with_explicit_caveats",
        "partial",
        "manual_review_required"
      ]
    }
  },
  "additionalProperties": false
}
