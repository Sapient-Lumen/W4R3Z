{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "array-bundle.manifest",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "crate",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "proposal_id": {
      "const": "P-0003"
    },
    "crate": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
