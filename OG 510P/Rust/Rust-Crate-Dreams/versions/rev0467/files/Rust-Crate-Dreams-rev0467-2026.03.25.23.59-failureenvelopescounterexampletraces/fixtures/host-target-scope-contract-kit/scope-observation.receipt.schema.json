{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/scope-observation.receipt.schema.json",
  "title": "ScopeObservationReceipt",
  "type": "object",
  "required": ["schema_version", "command_shape", "host_triple", "target_triples", "evidence_lanes"],
  "properties": {
    "schema_version": {"type": "string"},
    "command_shape": {
      "type": "string",
      "enum": ["no-explicit-target", "explicit-target", "build-target-configured", "rustdoc-like", "manual-review-required"]
    },
    "host_triple": {"type": ["string", "null"]},
    "target_triples": {
      "type": "array",
      "items": {"type": "string"}
    },
    "host_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["build-script", "proc-macro", "rustdoc-driver", "manual-review-required"]
      }
    },
    "target_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["rlib", "bin", "cdylib", "staticlib", "test", "doc", "manual-review-required"]
      }
    },
    "applied_config_families": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["build", "target", "host", "environment", "cli", "rustdoc-cli", "manual-policy"]
      }
    },
    "evidence_lanes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["config_parse", "command_capture", "imported_verbose_log", "manual_policy"]
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["observed-fact", "conservative-inference", "manual-review-required"]
    },
    "caveats": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
