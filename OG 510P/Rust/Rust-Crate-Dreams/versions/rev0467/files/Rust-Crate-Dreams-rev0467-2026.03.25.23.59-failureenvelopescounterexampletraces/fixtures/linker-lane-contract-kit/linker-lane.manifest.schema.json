{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/linker-lane.manifest.schema.json",
  "title": "LinkerLaneManifest",
  "type": "object",
  "required": ["schema_version", "target", "lane_kind", "sources"],
  "properties": {
    "schema_version": {"type": "string"},
    "target": {"type": "string"},
    "profile": {"type": "string"},
    "lane_kind": {
      "type": "string",
      "enum": [
        "system-default",
        "self-contained-lld",
        "explicit-lld",
        "zig-driver",
        "xwin-sdk",
        "containerized-cross",
        "custom-wrapper",
        "manual-review-required"
      ]
    },
    "driver": {"type": ["string", "null"]},
    "linker_binary": {"type": ["string", "null"]},
    "link_self_contained": {"type": ["boolean", "null"]},
    "lld_enabled": {"type": ["boolean", "null"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["cargo-config", "environment", "wrapper", "rustc-flags", "manual-policy"]
      }
    },
    "external_prereqs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "caveats": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
