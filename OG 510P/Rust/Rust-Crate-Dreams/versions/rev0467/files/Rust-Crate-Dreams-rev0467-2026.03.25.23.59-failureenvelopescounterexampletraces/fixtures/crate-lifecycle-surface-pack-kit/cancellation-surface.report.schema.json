{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CancellationSurfaceReport",
  "type": "object",
  "required": [
    "crate",
    "operations"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "cancel"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "cancel": {
            "enum": [
              "cancel_safe",
              "partial_progress_possible",
              "non_cancel_safe_restart_from_beginning",
              "drop_detaches",
              "drop_aborts",
              "abort_unsupported",
              "manual_review_required"
            ]
          },
          "evidence_kind": {
            "enum": [
              "doc",
              "fixture",
              "maintainer_assertion",
              "manual_review_required"
            ]
          }
        }
      }
    }
  }
}
