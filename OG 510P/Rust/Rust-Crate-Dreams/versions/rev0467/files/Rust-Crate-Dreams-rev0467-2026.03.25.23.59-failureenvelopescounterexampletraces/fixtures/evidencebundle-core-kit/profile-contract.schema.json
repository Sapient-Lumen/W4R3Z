{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/evidencebundle-core-kit/profile-contract.schema.json",
  "title": "Evidence Bundle Profile Contract",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "extends_core",
    "required_entry_kinds",
    "required_reports"
  ],
  "properties": {
    "schema_version": {"const": "evidencebundle-profile@1"},
    "profile_id": {"type": "string"},
    "extends_core": {"const": "evidencekit@1"},
    "required_entry_kinds": {
      "type": "array",
      "items": {"type": "string"}
    },
    "required_reports": {
      "type": "array",
      "items": {"type": "string"}
    },
    "accepted_signature_lanes": {
      "type": "array",
      "items": {"enum": ["none", "dsse", "cose", "sigstore-bundle"]}
    },
    "publication_lanes": {
      "type": "array",
      "items": {"enum": ["none", "oci", "scitt", "filesystem", "manual-handoff"]}
    },
    "domain_types": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
