{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/semver-api-diff/public-api.snapshot.schema.json",
  "title": "Public API snapshot",
  "type": "object",
  "required": ["schema_version", "crate", "version", "source", "items"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "version": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["kind", "locator"],
      "properties": {
        "kind": {"type": "string", "enum": ["registry", "git", "path"]},
        "locator": {"type": "string"},
        "revision": {"type": "string"}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "signature"],
        "properties": {
          "path": {"type": "string"},
          "kind": {"type": "string"},
          "signature": {"type": "string"},
          "reexported_from": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
