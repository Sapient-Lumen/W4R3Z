{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-pack.manifest",
  "type": "object",
  "required": [
    "crate",
    "artifacts"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "slice_profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}