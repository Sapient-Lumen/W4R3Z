{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capture-route.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "capture_mode",
    "same_invocation_claim",
    "discovery_sources",
    "freshness_visibility"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "capture_mode": {
      "type": "string",
      "enum": [
        "direct_build_invocation",
        "imported_target_tree",
        "imported_artifact_dir_copy",
        "imported_bundle",
        "manual_reconstruction"
      ]
    },
    "same_invocation_claim": {
      "type": "string",
      "enum": [
        "exact",
        "not_proven",
        "manual_review_required"
      ]
    },
    "discovery_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "compiler_artifact_stream",
          "cargo_sbom_path_env",
          "target_dir_scan",
          "artifact_dir_scan",
          "imported_bundle_manifest",
          "manual_mapping"
        ]
      }
    },
    "freshness_visibility": {
      "type": "string",
      "enum": [
        "direct_freshness_observed",
        "mixed_or_partial",
        "not_visible"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
