{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileWitnessReport",
  "type": "object",
  "required": ["schema_version", "crate", "witnesses"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "witnesses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["profile_name", "status"],
        "properties": {
          "profile_name": {"type": "string"},
          "status": {
            "enum": [
              "passed_under_restriction",
              "failed_under_restriction",
              "not_run",
              "manual_review_required"
            ]
          },
          "restrictions": {
            "type": "object",
            "properties": {
              "no_network": {"type": "boolean"},
              "empty_env": {"type": "boolean"},
              "no_home_dir": {"type": "boolean"},
              "readonly_fs": {"type": "boolean"},
              "fixed_clock": {"type": "boolean"},
              "fixed_rng": {"type": "boolean"},
              "no_process_spawn": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "unexpected_touchpoints": {
            "type": "array",
            "items": {"type": "string"}
          },
          "findings": {
            "type": "array",
            "items": {"type": "string"}
          },
          "evidence_sources": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
