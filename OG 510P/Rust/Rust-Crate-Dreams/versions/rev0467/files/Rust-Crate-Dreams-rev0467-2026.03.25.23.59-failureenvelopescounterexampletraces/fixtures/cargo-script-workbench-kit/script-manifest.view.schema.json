{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-script-workbench/script-manifest.view.schema.json",
  "title": "Cargo script manifest view",
  "type": "object",
  "required": ["schema_version", "path", "package_name", "edition"],
  "properties": {
    "schema_version": {"type": "string"},
    "path": {"type": "string"},
    "package_name": {"type": "string"},
    "edition": {"type": "string"},
    "edition_source": {"type": "string", "enum": ["explicit_frontmatter", "cargo_default"]},
    "explicit_frontmatter_fields": {"type": "array", "items": {"type": "string"}},
    "disallowed_fields_present": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
