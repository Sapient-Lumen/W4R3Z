{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-resolve-why/resolve-why.lock.schema.json",
  "title": "Cargo resolve why — capture lock",
  "type": "object",
  "required": ["schema_version", "capture_id", "cargo", "selection"],
  "properties": {
    "schema_version": {"type": "string"},
    "capture_id": {"type": "string"},
    "workspace_root": {"type": "string"},
    "cargo": {
      "type": "object",
      "required": ["resolver_version"],
      "properties": {
        "version": {"type": "string"},
        "resolver_version": {"type": "string"},
        "incompatible_rust_versions": {"type": "string"},
        "feature_unification_mode": {"type": "string"}
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["command_kind", "workspace_members"],
      "properties": {
        "command_kind": {
          "type": "string",
          "enum": ["build", "check", "test", "doc", "metadata", "custom"]
        },
        "workspace_members": {
          "type": "array",
          "items": {"type": "string"}
        },
        "targets": {
          "type": "array",
          "items": {"type": "string"}
        },
        "features": {
          "type": "array",
          "items": {"type": "string"}
        },
        "all_features": {"type": "boolean"},
        "no_default_features": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "lockfile_present": {"type": "boolean"},
        "manifest_paths": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
