{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PackageDiff",
  "type": "object",
  "required": [
    "added",
    "removed",
    "changed"
  ],
  "properties": {
    "added": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_findings_changed": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
