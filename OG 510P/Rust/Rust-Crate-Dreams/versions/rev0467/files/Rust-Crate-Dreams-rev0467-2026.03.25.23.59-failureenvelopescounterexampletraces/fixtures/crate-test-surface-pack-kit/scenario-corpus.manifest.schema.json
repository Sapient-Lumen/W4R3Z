{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioCorpusManifest",
  "type": "object",
  "required": [
    "crate",
    "name",
    "coverage"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}