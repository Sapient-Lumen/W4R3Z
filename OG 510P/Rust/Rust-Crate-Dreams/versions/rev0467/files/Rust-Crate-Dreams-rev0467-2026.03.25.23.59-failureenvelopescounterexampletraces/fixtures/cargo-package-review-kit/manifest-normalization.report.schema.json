{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ManifestNormalizationReport",
  "type": "object",
  "required": [
    "normalization_events"
  ],
  "properties": {
    "normalization_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "basis"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          },
          "details": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "manual_review_required": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
