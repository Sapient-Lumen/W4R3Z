{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted Publishing Publisher Policy",
  "type": "object",
  "properties": {
    "registry": {"type": "string"},
    "providers": {"type": "array", "items": {"type": "string"}},
    "trusted_publishing_only": {"type": "boolean"},
    "allowed_triggers": {"type": "array", "items": {"type": "string"}},
    "packages": {"type": "array", "items": {"type": "string"}},
    "expected_repository": {"type": "string"},
    "expected_workflow": {"type": "string"},
    "expected_environment": {"type": ["string", "null"]}
  },
  "required": ["registry", "providers", "trusted_publishing_only", "allowed_triggers", "packages"]
}
