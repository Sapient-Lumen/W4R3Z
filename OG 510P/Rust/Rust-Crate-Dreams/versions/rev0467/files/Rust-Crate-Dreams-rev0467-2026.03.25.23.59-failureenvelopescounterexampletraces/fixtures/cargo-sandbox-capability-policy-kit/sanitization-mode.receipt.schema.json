{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/cargo-sandbox-capability-policy-kit/sanitization-mode.receipt.schema.json",
  "title": "Sanitization Mode Receipt",
  "type": "object",
  "required": ["schema_version", "subject", "actor_scope", "mode", "default_posture"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "actor_scope": {"type": "string"},
    "mode": {
      "enum": ["inherit_all", "whitelist", "rewrite", "deny_by_default", "manual_review_required"]
    },
    "default_posture": {
      "enum": ["allow", "warn", "deny", "manual_review_required"]
    },
    "allowed_keys": {"type": "array", "items": {"type": "string"}},
    "stripped_keys": {"type": "array", "items": {"type": "string"}},
    "rewritten_keys": {"type": "array", "items": {"type": "string"}},
    "allowed_path_roots": {"type": "array", "items": {"type": "string"}},
    "project_local_override_posture": {
      "enum": ["allowed", "ignored", "rejected", "manual_review_required"]
    },
    "toolchain_auto_install_posture": {
      "enum": ["enabled", "disabled", "unknown", "manual_review_required"]
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
