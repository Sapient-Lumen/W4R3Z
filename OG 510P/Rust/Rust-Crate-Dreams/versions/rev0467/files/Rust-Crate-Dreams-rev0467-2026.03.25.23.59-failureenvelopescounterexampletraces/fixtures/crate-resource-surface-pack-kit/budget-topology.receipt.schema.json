{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/crate-resource-surface-pack-kit/budget-topology.receipt.schema.json",
  "title": "budget-topology.receipt",
  "type": "object",
  "required": [
    "resource_name",
    "scope_class",
    "sharing_behavior",
    "multiplication_axes",
    "aggregate_bound_posture"
  ],
  "properties": {
    "resource_name": {"type": "string"},
    "scope_class": {
      "type": "string",
      "enum": [
        "per_instance",
        "shared_clone_family",
        "per_connection",
        "per_host",
        "per_runtime",
        "process_global",
        "external_service_scoped",
        "manual_review_required"
      ]
    },
    "sharing_behavior": {
      "type": "string",
      "enum": [
        "clone_shares_state",
        "clone_multiplies_budget",
        "constructor_multiplies_budget",
        "mixed",
        "manual_review_required"
      ]
    },
    "multiplication_axes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "service_instances",
          "connections",
          "hosts",
          "runtimes",
          "workers",
          "tenants",
          "manual_review_required"
        ]
      }
    },
    "aggregate_bound_posture": {
      "type": "string",
      "enum": [
        "exact_total_known",
        "per_scope_only",
        "topology_dependent",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
