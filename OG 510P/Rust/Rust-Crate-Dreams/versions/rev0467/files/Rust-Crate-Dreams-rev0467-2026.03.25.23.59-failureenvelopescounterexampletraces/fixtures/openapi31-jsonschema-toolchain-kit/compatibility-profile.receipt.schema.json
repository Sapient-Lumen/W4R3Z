{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rustcrate.dreams/fixtures/openapi31-jsonschema-toolchain-kit/compatibility-profile.receipt.schema.json",
  "title": "compatibility-profile.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "profile_name",
    "profile_version",
    "structural_validity",
    "compatibility_verdict"
  ],
  "properties": {
    "artifact": {
      "const": "compatibility-profile.receipt"
    },
    "subject": {
      "type": "string"
    },
    "profile_name": {
      "type": "string"
    },
    "profile_version": {
      "type": "string"
    },
    "structural_validity": {
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "unknown"
      ]
    },
    "compatibility_verdict": {
      "type": "string",
      "enum": [
        "compatible",
        "conditionally-compatible",
        "incompatible",
        "not-evaluated"
      ]
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
