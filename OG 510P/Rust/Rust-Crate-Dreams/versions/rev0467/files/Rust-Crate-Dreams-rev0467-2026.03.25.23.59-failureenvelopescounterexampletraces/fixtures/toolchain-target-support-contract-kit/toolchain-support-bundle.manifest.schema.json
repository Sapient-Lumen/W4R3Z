{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/toolchain-target-support-contract-kit/toolchain-support-bundle.manifest.schema.json",
  "title": "ToolchainSupportBundleManifest",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "support_posture",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "support_posture": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "required_for_review"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "required_for_review": {
            "type": "boolean"
          },
          "sensitivity": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "manual_review_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "share_posture": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
