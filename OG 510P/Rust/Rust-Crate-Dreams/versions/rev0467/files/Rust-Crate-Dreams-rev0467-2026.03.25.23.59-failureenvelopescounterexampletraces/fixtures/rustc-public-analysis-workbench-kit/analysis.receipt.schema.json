{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analysis.receipt.json",
  "type": "object",
  "required": ["schema_version", "tool_name", "fixture_name", "status", "findings", "semver_surface"],
  "properties": {
    "schema_version": {"type": "string"},
    "tool_name": {"type": "string"},
    "fixture_name": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["compatible", "capability_gap", "snapshot_drift", "unstable_surface_touched", "bridge_required", "manual_review_required"]
    },
    "findings": {"type": "array", "items": {"type": "string"}},
    "unsupported_constructs": {"type": "array", "items": {"type": "string"}},
    "semver_surface": {
      "type": "object",
      "required": ["public_only"],
      "properties": {
        "public_only": {"type": "boolean"},
        "touched": {"type": "array", "items": {"type": "string"}}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
