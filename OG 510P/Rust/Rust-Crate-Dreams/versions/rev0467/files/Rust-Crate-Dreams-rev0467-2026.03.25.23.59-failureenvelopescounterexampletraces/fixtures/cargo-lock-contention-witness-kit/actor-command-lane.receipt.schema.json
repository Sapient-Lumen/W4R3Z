{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "actor-command-lane.receipt",
  "type": "object",
  "required": [
    "actor",
    "command_family",
    "scope"
  ],
  "properties": {
    "actor": {
      "type": "string"
    },
    "command_family": {
      "type": "string"
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string"
    },
    "invocation_strategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "compile_time_only": {
      "type": "boolean"
    },
    "wrapper_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
