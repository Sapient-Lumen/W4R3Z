{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-resolve-why/duplicate-builds.schema.json",
  "title": "Cargo resolve why — duplicate builds",
  "type": "object",
  "required": ["schema_version", "groups"],
  "properties": {
    "schema_version": {"type": "string"},
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package", "version", "instances", "causes"],
        "properties": {
          "package": {"type": "string"},
          "version": {"type": "string"},
          "instances": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["build_kind"],
              "properties": {
                "build_kind": {
                  "type": "string",
                  "enum": ["normal", "build", "dev", "host", "target", "proc-macro", "custom"]
                },
                "feature_set": {"type": "array", "items": {"type": "string"}},
                "target": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "causes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "feature_split",
                "host_target_split",
                "dev_dependency_split",
                "workspace_selection_split",
                "manual_review_required"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
