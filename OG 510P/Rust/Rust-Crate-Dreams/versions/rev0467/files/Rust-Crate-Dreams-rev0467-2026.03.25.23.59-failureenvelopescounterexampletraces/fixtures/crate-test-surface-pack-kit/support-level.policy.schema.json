{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestSurfaceSupportLevelPolicy",
  "type": "object",
  "required": ["schema_version", "support_levels"],
  "properties": {
    "schema_version": {"type": "string"},
    "support_levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "minimum_evidence"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "officially_supported",
              "best_effort_example",
              "experimental",
              "manual_review_required",
              "unknown"
            ]
          },
          "minimum_evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
