{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-build-dir-consumer-transition/adapter-plan.schema.json",
  "title": "Cargo adapter plan",
  "type": "object",
  "required": ["schema_version", "actions"],
  "properties": {
    "schema_version": {"type": "string"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["consumer_ref", "action", "confidence"],
        "properties": {
          "consumer_ref": {"type": "string"},
          "action": {"type": "string", "enum": ["switch_to_artifact_handoff", "use_build_script_json", "use_out_dir_contract", "use_cargo_bin_exe", "use_dep_info", "support_both_layouts", "keep_scraping_for_now", "blocked_on_upstream"]},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "tradeoff": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
