{
  "ordered_units": [
    "probe-foo",
    "emit-link-flags"
  ],
  "parameter_bindings": [
    {
      "unit": "probe-foo",
      "parameter": "prefer-static",
      "source": "env:FOO_SYS_STATIC"
    },
    {
      "unit": "emit-link-flags",
      "parameter": "search-root",
      "source": "package.metadata.probe.search_root"
    }
  ],
  "artifact_bridge_mode": "metadata_only"
}
