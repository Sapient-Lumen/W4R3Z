{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/linker-route.receipt.schema.json",
  "title": "LinkerRouteReceipt",
  "type": "object",
  "required": [
    "linker_family",
    "route_origin",
    "speed_class",
    "hotpatch_capability"
  ],
  "properties": {
    "linker_family": {
      "type": "string",
      "enum": [
        "system",
        "lld",
        "wild",
        "manual_review"
      ]
    },
    "route_origin": {
      "type": "string",
      "enum": [
        "rustc_default",
        "cargo_config",
        "tool_wrapper",
        "framework_adapter",
        "manual_review"
      ]
    },
    "speed_class": {
      "type": "string",
      "enum": [
        "baseline",
        "faster_link_only",
        "fast_nonincremental",
        "incremental_planned",
        "unknown"
      ]
    },
    "hotpatch_capability": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
