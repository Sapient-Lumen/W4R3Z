{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/secrets-kit/revelation-path.receipt.schema.json",
  "title": "revelation-path.receipt",
  "type": "object",
  "required": [
    "subject",
    "profile",
    "source_class",
    "intermediate_plaintext",
    "evidence_class",
    "judgment"
  ],
  "properties": {
    "subject": {"type": "string"},
    "profile": {"type": "string"},
    "source_class": {
      "type": "string",
      "enum": ["env", "file", "keyring", "remote", "mock", "manual", "other"]
    },
    "intermediate_plaintext": {"type": "boolean"},
    "decrypt_location": {
      "type": "string",
      "enum": ["none", "local", "remote", "unknown"]
    },
    "evidence_class": {
      "type": "string",
      "enum": ["observed", "imported", "declared", "manual_review_required"]
    },
    "judgment": {
      "type": "string",
      "enum": ["direct_protected_path", "plaintext_intermediate_present", "mock_path", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
