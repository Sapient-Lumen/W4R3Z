{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/localfirst-sync-kit/presence-surface.receipt.schema.json",
  "title": "presence-surface.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "delivery_guarantee",
    "persistence_posture",
    "identity_basis",
    "user_identity_strength",
    "export_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "delivery_guarantee": {
      "enum": [
        "best_effort",
        "reliable_session_scoped",
        "manual_review_required"
      ]
    },
    "persistence_posture": {
      "enum": [
        "not_persisted",
        "session_cache_only",
        "persisted",
        "manual_review_required"
      ]
    },
    "identity_basis": {
      "enum": [
        "peer_runtime_id",
        "device_id",
        "member_id",
        "manual_review_required"
      ]
    },
    "user_identity_strength": {
      "enum": [
        "not_user_identity",
        "mapped_by_app",
        "manual_review_required"
      ]
    },
    "export_policy": {
      "enum": [
        "redact_default",
        "summary_only",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
