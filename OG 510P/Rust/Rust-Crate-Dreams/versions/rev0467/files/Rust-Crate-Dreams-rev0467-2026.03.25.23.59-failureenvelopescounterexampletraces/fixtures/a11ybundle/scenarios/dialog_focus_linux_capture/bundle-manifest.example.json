{
  "format": "a11ybundle",
  "version": "1.0",
  "capture": {
    "backend": "atspi2",
    "mode": "platform-capture",
    "scenario_id": "dialog_focus_linux_capture",
    "capability_profile": "linux-atspi-basic@1"
  },
  "environment": {
    "os": "linux-wayland",
    "app": "dialog-demo",
    "toolkit": "egui-like-demo",
    "backend_version": "capture-prototype"
  },
  "artifacts": {
    "tree_snapshot": "tree.snapshot.example.json",
    "event_stream": "event-stream.example.json"
  },
  "redaction": {
    "profile": "balanced",
    "notes": "Typed text and dynamic content values redacted by default."
  }
}
