{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Availability Origin Receipt",
  "type": "object",
  "required": ["schema_version", "item_path", "origins"],
  "properties": {
    "schema_version": {"type": "string"},
    "item_path": {"type": "string"},
    "origins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": [
              "direct_cfg",
              "inherited_cfg",
              "doc_cfg_override",
              "doc_auto_cfg",
              "cfg_doc_visibility",
              "docsrs_cfg",
              "docsrs_rustc_arg",
              "build_script_custom_cfg",
              "inferred_from_profile",
              "manual_review_required"
            ]
          },
          "expression": {"type": "string"},
          "source_file": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    },
    "selected_target": {"type": "string"},
    "selected_features": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
