{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sbom-diff.report",
  "type": "object",
  "required": ["schema_version", "changes"],
  "properties": {
    "schema_version": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change_kind", "subject", "severity"],
        "properties": {
          "change_kind": {
            "type": "string",
            "enum": ["component_added", "component_removed", "edge_kind_changed", "feature_set_changed", "root_artifact_changed", "provenance_changed", "manual_review_required"]
          },
          "subject": {"type": "string"},
          "severity": {"type": "string", "enum": ["info", "review", "blocking"]},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "additionalProperties": true
}
