{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/trait-solver-drift-witness-kit/solver-support-bundle.manifest.schema.json",
  "title": "Solver Support Bundle Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "bundle_id": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "enum": [
              "comparison_lane",
              "corpus_authority",
              "obligation_class",
              "diagnostic_normalization",
              "minimization_lineage",
              "solver_drift_diff",
              "notes",
              "other"
            ]
          },
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
