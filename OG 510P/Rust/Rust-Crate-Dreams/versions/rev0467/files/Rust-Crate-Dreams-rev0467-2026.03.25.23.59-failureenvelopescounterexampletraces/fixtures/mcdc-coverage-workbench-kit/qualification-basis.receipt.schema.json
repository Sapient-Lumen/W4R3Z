{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qualification-basis.receipt",
  "type": "object",
  "required": [
    "qualification_class",
    "target_execution_class",
    "normative_basis"
  ],
  "properties": {
    "qualification_class": {
      "enum": [
        "exploratory",
        "evidence_only",
        "review_ready_with_caveats",
        "manual_review_required"
      ]
    },
    "target_execution_class": {
      "enum": [
        "host_executed",
        "target_executed",
        "mixed_host_target",
        "unknown"
      ]
    },
    "normative_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "toolchain": {
      "type": "object"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
