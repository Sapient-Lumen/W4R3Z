        "properties": {
          "profile": {"type": "string"},
          "target": {"type": "string"},
          "intended_posture": {"type": "string", "enum": ["interactive_debugger", "backtrace_only", "crash_symbolication_only", "internal_only"]},
          "required_sidecars": {"type": "array", "items": {"type": "string"}},
          "require_visualizers": {"type": "boolean"}
        }
      }
    }
  }
}
