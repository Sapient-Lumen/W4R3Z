{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/msrv-workspace-lab/policy-activation.receipt.schema.json",
  "title": "MSRV policy activation receipt",
  "type": "object",
  "required": [
    "schema_version",
    "workspace_kind",
    "expected_policy",
    "observed_policy",
    "activation_state",
    "resolver_source"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "workspace_kind": {
      "type": "string",
      "enum": ["single_package", "rooted_workspace", "virtual_workspace", "unknown"]
    },
    "expected_policy": {
      "type": "string",
      "enum": ["allow", "fallback", "unknown"]
    },
    "observed_policy": {
      "type": "string",
      "enum": ["allow", "fallback", "unknown"]
    },
    "activation_state": {
      "type": "string",
      "enum": [
        "active_as_expected",
        "expected_but_inactive",
        "overridden_from_config",
        "manual_review_required"
      ]
    },
    "resolver_source": {
      "type": "string",
      "enum": [
        "workspace_manifest",
        "top_package_manifest",
        "cargo_config",
        "env_override",
        "workspace_default",
        "unknown"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
