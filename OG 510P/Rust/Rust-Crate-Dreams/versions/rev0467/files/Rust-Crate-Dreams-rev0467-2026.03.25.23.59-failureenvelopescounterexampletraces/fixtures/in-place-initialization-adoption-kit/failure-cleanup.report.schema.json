{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/in-place-initialization-adoption-kit/failure-cleanup.report.schema.json",
  "title": "Failure Cleanup Report",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "fallible_edges",
    "cleanup_owner"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "fallible_edges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "partial_init_regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cleanup_owner": {
      "enum": [
        "constructor",
        "caller",
        "framework",
        "none",
        "unknown"
      ]
    },
    "cleanup_mechanisms": {
      "type": "array",
      "items": {
        "enum": [
          "drop",
          "rollback_code",
          "not_initialized",
          "manual_review"
        ]
      }
    },
    "initialized_state_may_escape": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
