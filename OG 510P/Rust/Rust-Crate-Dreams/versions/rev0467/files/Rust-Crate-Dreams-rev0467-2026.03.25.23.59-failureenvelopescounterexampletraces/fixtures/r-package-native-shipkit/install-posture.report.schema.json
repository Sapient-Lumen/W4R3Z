{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.local/r-package-native-shipkit/install-posture.report.schema.json",
  "title": "InstallPostureReport",
  "type": "object",
  "required": ["package", "class", "summary"],
  "properties": {
    "package": {"type": "string"},
    "class": {
      "type": "string",
      "enum": [
        "cran_binary_expected",
        "source_build_required",
        "mixed_binary_source",
        "manual_review_required"
      ]
    },
    "summary": {"type": "string"},
    "cargo_required_at_install": {"type": "boolean"},
    "staged_install_posture": {"type": "string"},
    "system_requirements": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
