{
  "schema_version": "0.1.0",
  "workspace_root": "/workspace/probe",
  "roots": {
    "target_dir": {
      "path": "/workspace/probe/target",
      "observation": "cargo_config_scan"
    },
    "build_dir": {
      "path": "/workspace/probe/build",
      "observation": "cargo_env_scan"
    },
    "package_cache": {
      "path": "~/.cargo",
      "observation": "cargo_env_scan"
    }
  },
  "flags": [
    "-Zbuild-dir-new-layout"
  ]
}