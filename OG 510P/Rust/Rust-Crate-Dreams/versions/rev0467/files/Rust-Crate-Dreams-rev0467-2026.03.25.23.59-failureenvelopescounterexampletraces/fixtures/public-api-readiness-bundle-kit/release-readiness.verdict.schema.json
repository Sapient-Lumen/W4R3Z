{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/public-api-readiness/release-readiness.verdict.schema.json",
  "title": "Release readiness verdict",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "reasons"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "ready_with_waivers",
        "manual_review_required",
        "not_ready"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "advisory_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
