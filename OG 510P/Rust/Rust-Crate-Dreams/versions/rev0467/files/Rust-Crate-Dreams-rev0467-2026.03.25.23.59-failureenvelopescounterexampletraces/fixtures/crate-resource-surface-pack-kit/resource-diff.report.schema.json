{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceDiffReport",
  "type": "object",
  "required": ["schema_version", "crate", "changes"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "resource"],
        "properties": {
          "kind": {
            "enum": ["resource_class_added", "resource_class_removed", "bound_added", "bound_removed", "default_increased", "default_decreased", "saturation_semantics_changed", "manual_review_required"]
          },
          "resource": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}