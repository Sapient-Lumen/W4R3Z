{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/msrv-workspace-lab/resolver-lane.diff.schema.json",
  "title": "MSRV resolver lane diff",
  "type": "object",
  "required": [
    "schema_version",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "change"
        ],
        "properties": {
          "change": {
            "type": "string",
            "enum": [
              "support_promise_unchanged",
              "resolver_policy_changed",
              "metadata_floor_raised",
              "active_build_floor_raised",
              "inactive_edge_detected",
              "manual_review_required"
            ]
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
