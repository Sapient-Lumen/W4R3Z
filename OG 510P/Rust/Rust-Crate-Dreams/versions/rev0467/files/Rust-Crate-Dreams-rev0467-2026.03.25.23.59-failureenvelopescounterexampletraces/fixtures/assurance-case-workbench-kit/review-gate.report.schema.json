{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/assurance-case-workbench-kit/review-gate.report.schema.json",
  "title": "Review Gate Report",
  "type": "object",
  "required": ["version", "gate_status", "blocking_reasons"],
  "properties": {
    "version": { "type": "string" },
    "gate_status": { "type": "string", "enum": ["green", "yellow", "red", "blocked"] },
    "blocking_reasons": { "type": "array", "items": { "type": "string" } },
    "manual_review_zones": { "type": "array", "items": { "type": "string" } },
    "top_claim_ids": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" }
  },
  "additionalProperties": true
}
