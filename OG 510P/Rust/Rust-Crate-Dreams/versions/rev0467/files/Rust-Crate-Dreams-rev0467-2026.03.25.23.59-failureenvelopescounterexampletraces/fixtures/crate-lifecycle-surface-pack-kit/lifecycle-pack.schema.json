{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LifecyclePack",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "components",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "drop_semantics"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "handle",
              "client",
              "writer",
              "stream",
              "watcher",
              "pool",
              "daemon",
              "manual_review_required"
            ]
          },
          "background_work": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "drop_semantics": {
            "enum": [
              "no_background_work",
              "detaches",
              "aborts",
              "joins",
              "blocks_until_shutdown",
              "manual_review_required"
            ]
          },
          "shutdown_recipe": {
            "type": "string"
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "cancel"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "read",
              "write",
              "flush",
              "shutdown",
              "close",
              "join",
              "subscribe",
              "poll",
              "manual_review_required"
            ]
          },
          "cancel": {
            "enum": [
              "cancel_safe",
              "partial_progress_possible",
              "drop_detaches",
              "drop_aborts",
              "abort_unsupported",
              "manual_review_required"
            ]
          },
          "retry": {
            "enum": [
              "idempotent",
              "safe_to_recreate",
              "manual_review_required"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
