{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/crate-ecosystem-pathfinder-kit/profile-progression.report.schema.json",
  "title": "profile-progression.report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "program_id",
    "task_id",
    "from_stage",
    "to_stage",
    "subject",
    "inherited_artifacts",
    "new_artifacts",
    "unresolved_gaps",
    "exception_budget_status",
    "exit_status",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "report_id": {
      "type": "string"
    },
    "program_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "from_stage": {
      "type": "string"
    },
    "to_stage": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_kind",
        "subject_ref"
      ],
      "properties": {
        "subject_kind": {
          "type": "string",
          "enum": [
            "candidate",
            "starter_set",
            "frozen_basis"
          ]
        },
        "subject_ref": {
          "type": "string"
        }
      }
    },
    "inherited_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "new_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exception_budget_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_open_exceptions",
        "currently_open",
        "within_budget"
      ],
      "properties": {
        "max_open_exceptions": {
          "type": "integer",
          "minimum": 0
        },
        "currently_open": {
          "type": "integer",
          "minimum": 0
        },
        "within_budget": {
          "type": "boolean"
        }
      }
    },
    "exit_status": {
      "type": "string",
      "enum": [
        "keep",
        "conditional_keep",
        "hold",
        "split_boundary",
        "replace_later",
        "stop_and_reopen_compare"
      ]
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}