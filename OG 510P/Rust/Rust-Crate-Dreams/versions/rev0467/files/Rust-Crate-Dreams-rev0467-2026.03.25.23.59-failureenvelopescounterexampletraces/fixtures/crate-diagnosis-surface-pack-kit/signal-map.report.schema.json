{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignalMapReport",
  "type": "object",
  "required": [
    "symptom",
    "signals"
  ],
  "properties": {
    "symptom": {"type": "string"},
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signal_kind", "name", "stability"],
        "properties": {
          "signal_kind": {
            "enum": [
              "counter",
              "gauge",
              "histogram",
              "trace_span",
              "trace_event",
              "runtime_metric",
              "diagnostic_code",
              "diagnostic_url",
              "warning_class",
              "manual_review_required"
            ]
          },
          "source": {
            "enum": [
              "tracing",
              "metrics",
              "tokio_console",
              "tokio_metrics",
              "miette",
              "other"
            ]
          },
          "name": {"type": "string"},
          "stability": {
            "enum": [
              "documented",
              "best_effort",
              "manual_review_required"
            ]
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
