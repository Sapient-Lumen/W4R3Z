{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/delivery-memory.report.schema.json",
  "title": "delivery-memory.report",
  "type": "object",
  "required": [
    "schema_version",
    "surface",
    "memory_class",
    "claim_basis",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "surface": {
      "type": "string"
    },
    "memory_class": {
      "type": "string"
    },
    "delivery_unit": {
      "type": "string"
    },
    "receiver_fanout": {
      "type": "string"
    },
    "accumulation_limit": {
      "type": "string"
    },
    "late_receiver_posture": {
      "type": "string"
    },
    "close_or_disconnect_posture": {
      "type": "string"
    },
    "claim_basis": {
      "type": "string"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
