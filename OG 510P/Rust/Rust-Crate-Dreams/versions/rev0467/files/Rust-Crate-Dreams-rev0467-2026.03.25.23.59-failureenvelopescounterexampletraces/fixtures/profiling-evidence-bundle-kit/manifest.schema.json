{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "build": {
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "captures": {
      "items": {
        "properties": {
          "kind": {
            "enum": [
              "cpu.pprof",
              "heap.pprof",
              "tracing.folded"
            ],
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "path"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "target": {
      "type": "string"
    },
    "toolchain": {
      "properties": {
        "cargo": {
          "type": "string"
        },
        "rustc": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "toolchain",
    "target",
    "build",
    "captures"
  ],
  "title": "profbundle manifest.json",
  "type": "object"
}