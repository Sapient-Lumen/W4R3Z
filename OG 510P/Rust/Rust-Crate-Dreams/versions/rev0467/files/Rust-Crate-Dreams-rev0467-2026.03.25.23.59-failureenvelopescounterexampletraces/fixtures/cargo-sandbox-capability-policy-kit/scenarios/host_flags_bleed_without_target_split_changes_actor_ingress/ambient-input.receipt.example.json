{
  "schema_version": "1",
  "subject": "workspace release build",
  "actor_name": "shared host lane",
  "actor_class": "rustc_host_lane",
  "ambient_inputs": [
    {
      "input_class": "parent_env",
      "source": "parent_process",
      "posture": "inherited",
      "keys": ["RUSTFLAGS", "CARGO_ENCODED_RUSTFLAGS"],
      "notes": "without --target, host build scripts and proc macros receive the same extra compiler flags"
    },
    {
      "input_class": "config_env",
      "source": "cargo_config",
      "posture": "inherited",
      "keys": ["build.rustflags", "target.<triple>.rustflags"],
      "notes": "host ingress meaning depends on target split and target-applies-to-host behavior"
    }
  ]
}
