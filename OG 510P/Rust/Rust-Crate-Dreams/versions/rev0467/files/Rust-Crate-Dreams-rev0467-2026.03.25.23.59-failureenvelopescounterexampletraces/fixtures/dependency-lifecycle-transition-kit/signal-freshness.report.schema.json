{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/dependency-lifecycle-transition-kit/signal-freshness.report.schema.json",
  "title": "SignalFreshnessReport",
  "type": "object",
  "required": [
    "dependency",
    "freshness_verdict",
    "signals"
  ],
  "properties": {
    "dependency": {"type": "string"},
    "freshness_verdict": {"type": "string"},
