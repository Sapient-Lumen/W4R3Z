      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "signal_kind",
          "imported_at",
          "expected_refresh_window",
          "status"
        ],
        "properties": {
          "source": {"type": "string"},
          "signal_kind": {"type": "string"},
          "imported_at": {"type": "string"},
          "expected_refresh_window": {"type": "string"},
          "status": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
