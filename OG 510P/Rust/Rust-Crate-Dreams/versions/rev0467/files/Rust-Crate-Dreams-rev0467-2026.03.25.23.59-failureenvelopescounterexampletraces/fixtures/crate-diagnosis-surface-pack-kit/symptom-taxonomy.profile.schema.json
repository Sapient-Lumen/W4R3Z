{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SymptomTaxonomyProfile",
  "type": "object",
  "required": [
    "schema_version",
    "symptom_classes"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "symptom_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "summary"],
        "properties": {
          "name": {
            "enum": [
              "startup_stall",
              "request_hang",
              "retry_storm",
              "queue_growth",
              "idle_but_busy",
              "high_cpu",
              "auth_drift",
              "config_mismatch",
              "resource_exhaustion",
              "manual_review_required"
            ]
          },
          "summary": {"type": "string"},
          "aliases": {
            "type": "array",
            "items": {"type": "string"}
          },
          "ambiguity_notes": {"type": "string"},
          "preferred_signals": {
            "type": "array",
            "items": {"type": "string"}
          },
          "not_a_root_cause": {"type": "boolean"}
        }
      }
    }
  }
}
