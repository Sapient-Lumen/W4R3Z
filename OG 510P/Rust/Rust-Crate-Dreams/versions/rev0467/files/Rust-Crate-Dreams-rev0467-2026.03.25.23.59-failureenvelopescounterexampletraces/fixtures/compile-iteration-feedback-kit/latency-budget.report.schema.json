{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/latency-budget.report.schema.json",
  "title": "LatencyBudgetReport",
  "type": "object",
  "required": [
    "budget_ms",
    "observed_ms",
    "budget_verdict",
    "feedback_class",
    "measurement_basis"
  ],
  "properties": {
    "budget_ms": {
      "type": "integer",
      "minimum": 0
    },
    "observed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "budget_verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_measured",
        "incomparable"
      ]
    },
    "feedback_class": {
      "type": "string",
      "enum": [
        "instant_visual_update",
        "asset_update_visible",
        "rust_logic_ready",
        "app_restarted_ready",
        "unknown"
      ]
    },
    "measurement_basis": {
      "type": "string",
      "enum": [
        "direct_local_measurement",
        "framework_imported_expectation",
        "mixed"
      ]
    },
    "confidence_class": {
      "type": "string",
      "enum": [
        "direct_observation",
        "imported_substrate",
        "conservative_inference",
        "manual_review"
      ]
    },
    "samples_count": {
      "type": "integer",
      "minimum": 1
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
