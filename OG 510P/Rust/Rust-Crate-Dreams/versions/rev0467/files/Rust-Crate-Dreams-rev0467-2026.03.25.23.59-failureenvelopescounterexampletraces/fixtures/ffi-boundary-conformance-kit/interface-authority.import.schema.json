{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interface-authority.import",
  "type": "object",
  "required": [
    "subject",
    "boundary_family",
    "primary_authority",
    "authority_scope",
    "verdict"
  ],
  "properties": {
    "subject": { "type": "string" },
    "boundary_family": { "type": "string" },
    "primary_authority": {
      "type": "object",
      "required": ["kind", "location"],
      "properties": {
        "kind": { "type": "string" },
        "location": { "type": "string" },
        "version_or_commit": { "type": ["string", "null"] }
      }
    },
    "derived_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "location", "relation"],
        "properties": {
          "kind": { "type": "string" },
          "location": { "type": "string" },
          "relation": { "type": "string" }
        }
      }
    },
    "authority_scope": { "type": "string" },
    "manual_review_zones": { "type": "array", "items": { "type": "string" } },
    "verdict": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
