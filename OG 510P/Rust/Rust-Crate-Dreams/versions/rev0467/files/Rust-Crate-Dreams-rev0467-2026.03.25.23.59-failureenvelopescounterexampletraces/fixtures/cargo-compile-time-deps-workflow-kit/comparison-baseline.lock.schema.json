{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-compile-time-deps-workflow-kit/comparison-baseline.lock.schema.json",
  "title": "ComparisonBaselineLock",
  "type": "object",
  "required": ["schema_version", "claim_kind", "observed_run", "baseline", "exactness"],
  "properties": {
    "schema_version": {"type": "string"},
    "claim_kind": {
      "type": "string",
      "enum": ["tool_vs_tool", "tool_vs_full_build", "tool_vs_terminal_build", "tool_vs_policy"]
    },
    "observed_run": {
      "type": "object",
      "required": ["workflow_role", "selection_scope", "targets"],
      "properties": {
        "workflow_role": {"type": "string"},
        "selection_scope": {"type": "string", "enum": ["workspace", "package", "label_scoped", "saved_file_scoped", "manual_review_required"]},
        "targets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "baseline": {
      "type": "object",
      "required": ["kind", "selection_scope"],
      "properties": {
        "kind": {"type": "string", "enum": ["workspace_build", "package_build", "terminal_build", "policy_only", "other_tool_run"]},
        "selection_scope": {"type": "string", "enum": ["workspace", "package", "label_scoped", "saved_file_scoped", "unknown"]},
        "targets": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "exactness": {"type": "string", "enum": ["exact", "conservative", "manual_review_required"]},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
