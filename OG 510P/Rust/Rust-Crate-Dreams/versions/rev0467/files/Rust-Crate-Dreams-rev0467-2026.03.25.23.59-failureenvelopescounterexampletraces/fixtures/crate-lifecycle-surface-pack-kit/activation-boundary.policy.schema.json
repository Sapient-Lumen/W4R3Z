{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle Activation Boundary Policy",
  "type": "object",
  "required": ["schema_version", "activation_classes"],
  "properties": {
    "schema_version": {"type": "string"},
    "activation_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "minimum_evidence"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "constructor_eager",
              "explicit_start",
              "first_use_lazy",
              "subscription_attached",
              "external_runtime_owned",
              "manual_review_required",
              "unknown"
            ]
          },
          "minimum_evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
