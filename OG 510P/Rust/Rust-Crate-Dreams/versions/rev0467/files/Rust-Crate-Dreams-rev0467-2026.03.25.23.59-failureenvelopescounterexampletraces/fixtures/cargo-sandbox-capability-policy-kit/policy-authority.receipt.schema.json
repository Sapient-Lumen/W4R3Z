{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/cargo-sandbox-capability-policy-kit/policy-authority.receipt.schema.json",
  "title": "Policy Authority Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "authority_route",
    "backend_family",
    "actor_scope"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "authority_route": {
      "enum": [
        "crate_manifest",
        "workspace_overlay",
        "organization_policy",
        "ci_override",
        "manual_review"
      ]
    },
    "backend_family": {
      "type": "string"
    },
    "actor_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
