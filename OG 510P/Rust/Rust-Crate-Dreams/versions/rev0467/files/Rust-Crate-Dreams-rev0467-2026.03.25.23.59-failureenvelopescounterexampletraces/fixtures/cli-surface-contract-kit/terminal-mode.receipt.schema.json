{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "terminal-mode.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "tty_detection_basis",
    "color_policy",
    "progress_posture",
    "prompt_posture",
    "non_interactive_behavior"
  ],
  "properties": {
    "artifact": {"const": "terminal-mode.receipt"},
    "subject": {"type": "string"},
    "tty_detection_basis": {
      "enum": ["std_is_terminal", "crate_specific_detection", "manual_review_required"]
    },
    "color_policy": {
      "enum": ["never", "auto", "always", "env_sensitive", "manual_review_required"]
    },
    "progress_posture": {
      "enum": ["none", "stderr_tty_only", "stdout_tty_only", "always_visible", "manual_review_required"]
    },
    "prompt_posture": {
      "enum": ["none", "tty_required", "fallback_flags_required", "manual_review_required"]
    },
    "editor_or_pager_posture": {
      "enum": ["none", "editor_optional", "editor_required", "pager_optional", "manual_review_required"]
    },
    "non_interactive_behavior": {
      "enum": ["same_surface", "reduced_surface", "refuse_without_override", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
