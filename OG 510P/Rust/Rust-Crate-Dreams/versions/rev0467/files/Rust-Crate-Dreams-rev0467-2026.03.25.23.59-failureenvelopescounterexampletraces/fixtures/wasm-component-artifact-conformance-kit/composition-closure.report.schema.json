{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wasm Component composition-closure report",
  "type": "object",
  "required": [
    "closure_class",
    "status"
  ],
  "properties": {
    "closure_class": {
      "type": "string",
      "enum": [
        "closed_bundle",
        "host_supplied_open",
        "transitive_open",
        "manual_review_required"
      ]
    },
    "runnable_surface": {
      "type": ["string", "null"],
      "enum": [
        "wasi_cli_run",
        "invoke_export",
        "custom_host_required",
        "none",
        null
      ]
    },
    "unsatisfied_imports": {
      "type": "array",
      "items": {"type": "string"}
    },
    "bundled_dependencies": {
      "type": "array",
      "items": {"type": "string"}
    },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "failed", "manual_review_required"]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
