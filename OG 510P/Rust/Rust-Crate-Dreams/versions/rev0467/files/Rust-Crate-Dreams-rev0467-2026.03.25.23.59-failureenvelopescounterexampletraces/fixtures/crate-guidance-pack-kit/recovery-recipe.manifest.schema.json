{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recovery recipe manifest",
  "type": "object",
  "required": [
    "schema_version",
    "recipes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "entrypoint": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
