{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradePublicationSurfaceManifest",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "surface_state",
    "entry_points",
    "context_refs",
    "omitted_refs",
    "warning_labels",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "surface_state": {
      "type": "string",
      "enum": [
        "candidate_public",
        "frozen_public"
      ]
    },
    "entry_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "role"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "summary",
              "recipe_manifest",
              "hazard_report",
              "manual_review_boundary",
              "scope_report",
              "warning_labels",
              "warning_register",
              "claim_register",
              "trace_path_report",
              "omission_register",
              "durable_cue_report",
              "supporting_receipt"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "omitted_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "reason"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "internal_working_only",
              "redaction_pending",
              "floating_source",
              "not_citation_ready",
              "private_workspace_evidence",
              "superseded"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "warning_labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "omission_register_ref": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
