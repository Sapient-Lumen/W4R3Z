{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/toolchain-target-support-contract-kit/host-target-topology.receipt.schema.json",
  "title": "HostTargetTopologyReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "host_triple",
    "target_triple",
    "phases"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "host_triple": {
      "type": "string"
    },
    "target_triple": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "executor_lane",
          "artifact_platform",
          "runner_requirement"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "resolve",
              "build_script_compile",
              "build_script_run",
              "proc_macro_compile",
              "proc_macro_run",
              "target_compile",
              "target_link",
              "target_run",
              "target_test",
              "docs_build",
              "ci_upload",
              "manual_review_required"
            ]
          },
          "executor_lane": {
            "type": "string",
            "enum": [
              "host",
              "target",
              "docsrs",
              "ci_service",
              "runner_device",
              "manual_review_required"
            ]
          },
          "artifact_platform": {
            "type": "string",
            "enum": [
              "host",
              "target",
              "docs",
              "n_a",
              "manual_review_required"
            ]
          },
          "runner_requirement": {
            "type": "string",
            "enum": [
              "none",
              "host_shell",
              "custom_runner",
              "emulator",
              "device_lab",
              "docsrs_service",
              "manual_review_required"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
