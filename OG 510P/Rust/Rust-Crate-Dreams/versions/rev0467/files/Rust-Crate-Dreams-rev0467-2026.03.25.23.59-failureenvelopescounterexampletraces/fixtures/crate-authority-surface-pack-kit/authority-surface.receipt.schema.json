{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthoritySurfaceReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "touchpoints_observed"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "touchpoints_observed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "evidence_sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "feature_conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
