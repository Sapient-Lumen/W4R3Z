{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeSurfaceAuthorshipReport",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "surfaces",
    "overall_posture"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "surface_id",
          "surface_ref",
          "surface_kind",
          "authorship_bucket",
          "trust_plane"
        ],
        "properties": {
          "surface_id": {
            "type": "string"
          },
          "surface_ref": {
            "type": "string"
          },
          "surface_kind": {
            "type": "string",
            "enum": [
              "native_tool_output",
              "maintainer_guidance",
              "review_decision",
              "warning_or_cue_surface",
              "public_summary",
              "archive_synthesis",
              "discussion_or_thread",
              "other"
            ]
          },
          "authorship_bucket": {
            "type": "string",
            "enum": [
              "cargo_native_generated",
              "maintainer_authored",
              "reviewer_authored",
              "archive_derived",
              "third_party_discussion",
              "mixed_authorship"
            ]
          },
          "trust_plane": {
            "type": "string",
            "enum": [
              "native_observation",
              "project_guidance",
              "review_governance",
              "derived_presentation",
              "advisory_context"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "overall_posture": {
      "type": "string",
      "enum": [
        "homogeneous_native",
        "mixed_but_explicit",
        "mixed_with_boundary_blur",
        "unknown"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
