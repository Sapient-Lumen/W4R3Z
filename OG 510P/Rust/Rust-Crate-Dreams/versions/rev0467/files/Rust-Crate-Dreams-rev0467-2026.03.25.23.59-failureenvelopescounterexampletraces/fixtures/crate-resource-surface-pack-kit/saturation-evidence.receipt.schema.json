{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SaturationEvidenceReceipt",
  "type": "object",
  "required": ["schema_version", "crate", "scenario", "observations"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "scenario": {"type": "string"},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource", "observed_event"],
        "properties": {
          "resource": {"type": "string"},
          "boundedness": {
            "enum": [
              "bounded",
              "configurable",
              "burst_bounded",
              "externally_bounded",
              "effectively_unbounded",
              "manual_review_required"
            ]
          },
          "declared_saturation": {
            "enum": [
              "backpressure_wait",
              "reject_with_error",
              "drop_newest",
              "drop_oldest",
              "evict",
              "queue_until_limit",
              "spill_or_degrade",
              "unbounded_growth_risk",
              "panic_or_abort",
              "manual_review_required"
            ]
          },
          "observed_event": {
            "enum": [
              "send_waited_for_capacity",
              "send_rejected",
              "task_queued_after_thread_cap",
              "connection_reused",
              "connection_opened",
              "entry_evicted",
              "budget_exhausted",
              "continued_buffering",
              "manual_review_required"
            ]
          },
          "observed_limit": {"type": ["integer", "string", "null"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
