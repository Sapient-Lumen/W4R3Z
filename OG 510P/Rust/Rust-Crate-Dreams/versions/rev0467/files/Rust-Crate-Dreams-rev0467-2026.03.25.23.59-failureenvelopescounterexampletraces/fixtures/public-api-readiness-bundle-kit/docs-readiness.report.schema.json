{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/public-api-readiness/docs-readiness.report.schema.json",
  "title": "Docs readiness report",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "coverage_scope"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "regression_detected",
        "manual_review_required"
      ]
    },
    "coverage_scope": {
      "type": "string",
      "enum": [
        "public_surface_only",
        "crate_wide",
        "unknown"
      ]
    },
    "totals": {
      "type": "object",
      "properties": {
        "public_items": {
          "type": "integer",
          "minimum": 0
        },
        "with_docs": {
          "type": "integer",
          "minimum": 0
        },
        "with_examples": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "missing_docs",
              "missing_examples",
              "broken_linkage",
              "coverage_drop"
            ]
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "manual_review_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
