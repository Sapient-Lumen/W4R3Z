{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/cargo-sandbox-capability-policy-kit/ambient-input.receipt.schema.json",
  "title": "Ambient Input Receipt",
  "type": "object",
  "required": ["schema_version", "subject", "actor_name", "actor_class", "ambient_inputs"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "actor_name": {"type": "string"},
    "actor_class": {
      "enum": ["build_script", "proc_macro_lane", "rustc_host_lane", "compile_time_deps_workflow", "manual_review"]
    },
    "ambient_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["input_class", "source", "posture"],
        "properties": {
          "input_class": {
            "enum": [
              "cargo_set_env",
              "parent_env",
              "config_env",
              "path_search",
              "toolchain_selector",
              "wrapper_env",
              "build_script_emitted_env",
              "manual_review"
            ]
          },
          "source": {
            "enum": [
              "cargo",
              "parent_process",
              "cargo_config",
              "rustup",
              "runner_backend",
              "build_script_output",
              "manual_review"
            ]
          },
          "posture": {
            "enum": ["inherited", "allowlisted", "rewritten", "denied", "manual_review_required"]
          },
          "keys": {"type": "array", "items": {"type": "string"}},
          "paths": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
