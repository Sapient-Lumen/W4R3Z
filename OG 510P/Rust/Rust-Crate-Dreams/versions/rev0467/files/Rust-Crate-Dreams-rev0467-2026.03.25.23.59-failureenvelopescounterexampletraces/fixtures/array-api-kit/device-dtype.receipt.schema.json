{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "device-dtype.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "crate",
    "device_posture",
    "runtime_devices",
    "default_dtype_basis"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "proposal_id": {
      "const": "P-0003"
    },
    "crate": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "device_posture": {
      "enum": [
        "host_only",
        "explicit_runtime_devices",
        "backend_generic",
        "manual_review_required"
      ]
    },
    "runtime_devices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_device": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_dtype_basis": {
      "enum": [
        "fixed",
        "device_dependent",
        "backend_dependent",
        "manual_review_required"
      ]
    },
    "transfer_posture": {
      "enum": [
        "explicit",
        "implicit_or_hidden",
        "not_applicable",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
