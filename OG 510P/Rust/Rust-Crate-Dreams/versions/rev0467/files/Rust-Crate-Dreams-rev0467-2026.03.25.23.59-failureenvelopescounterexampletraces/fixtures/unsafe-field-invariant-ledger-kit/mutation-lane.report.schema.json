{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/unsafe-field-invariant-ledger-kit/mutation-lane.report.schema.json",
  "title": "Mutation Lane Report",
  "type": "object",
  "required": ["schema_version", "field_path", "mutators"],
  "properties": {
    "schema_version": {"type": "string"},
    "field_path": {"type": "string"},
    "mutators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "visibility", "lane", "preconditions"],
        "properties": {
          "path": {"type": "string"},
          "visibility": {"enum": ["private", "pub_crate", "pub", "generated", "unknown"]},
          "lane": {"enum": ["unsafe_direct", "trusted_safe_wrapper", "constructor_only", "drop_only", "generated_code", "unknown"]},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "caveats": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "manual_review_gaps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
