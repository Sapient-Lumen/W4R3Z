{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stable-plugin-host-kit/capability-negotiation.receipt.schema.json",
  "title": "capability-negotiation.receipt",
  "type": "object",
  "required": [
    "scenario",
    "negotiation_class",
    "required_capabilities",
    "failure_posture"
  ],
  "properties": {
    "scenario": {
      "type": "string"
    },
    "negotiation_class": {
      "type": "string",
      "enum": [
        "none",
        "versioned_module_fields",
        "trait_probe",
        "manifest_flags",
        "serialized_capabilities",
        "manual_review_required"
      ]
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "downgrade_policy": {
      "type": "string",
      "enum": [
        "none",
        "activate_subset",
        "reject_plugin",
        "manual_review_required"
      ]
    },
    "failure_posture": {
      "type": "string",
      "enum": [
        "fail_load",
        "degrade_with_receipt",
        "ignore_unknown",
        "manual_review_required"
      ]
    },
    "source_of_truth": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
