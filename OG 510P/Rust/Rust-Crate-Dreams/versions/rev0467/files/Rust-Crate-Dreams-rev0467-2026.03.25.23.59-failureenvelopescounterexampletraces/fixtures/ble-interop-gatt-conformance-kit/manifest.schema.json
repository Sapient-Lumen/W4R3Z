{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "blebundle manifest",
  "type": "object",
  "required": [
    "schema_version",
    "platform",
    "adapter",
    "profile",
    "redaction"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "platform": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "adapter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "chipset": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        }
      }
    },
    "profile": {
      "type": "object",
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "redaction": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string"
        }
      }
    }
  }
}