{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cargo-event-envelope",
  "type": "object",
  "required": ["schema_version", "session_id", "sequence", "event_kind", "origin"],
  "properties": {
    "schema_version": {"type": "string"},
    "session_id": {"type": "string"},
    "sequence": {"type": "integer", "minimum": 0},
    "event_kind": {
      "type": "string",
      "enum": [
        "session_start",
        "cargo_message",
        "rustc_diagnostic",
        "compiler_artifact",
        "build_script_output",
        "foreign_output",
        "render_policy",
        "stream_gap",
        "session_end",
        "unknown_cargo_reason"
      ]
    },
    "origin": {
      "type": "string",
      "enum": ["cargo", "rustc", "build_script", "proc_macro", "runner", "other_tool"]
    },
    "package_id": {"type": "string"},
    "target_name": {"type": "string"},
    "payload_path": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
