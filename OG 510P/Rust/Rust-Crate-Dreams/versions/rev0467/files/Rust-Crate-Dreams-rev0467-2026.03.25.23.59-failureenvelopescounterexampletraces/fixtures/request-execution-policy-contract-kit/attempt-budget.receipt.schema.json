{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "attempt-budget.receipt",
  "type": "object",
  "required": ["artifact", "subject", "serial_attempts_max", "retry_budget_kind", "backoff_kind", "jitter_kind"],
  "properties": {
    "artifact": {"const": "attempt-budget.receipt"},
    "subject": {"type": "string"},
    "serial_attempts_max": {"type": ["integer", "null"], "minimum": 1},
    "retry_budget_kind": {"enum": ["none", "fractional_extra_requests", "fixed_attempt_cap", "manual_review_required"]},
    "retry_budget_value": {"type": ["number", "string", "null"]},
    "per_attempt_timeout_ms": {"type": ["integer", "null"], "minimum": 0},
    "overall_deadline_ms": {"type": ["integer", "null"], "minimum": 0},
    "backoff_kind": {"enum": ["none", "constant", "exponential", "fibonacci", "manual_review_required"]},
    "jitter_kind": {"enum": ["none", "full", "bounded", "manual_review_required"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
