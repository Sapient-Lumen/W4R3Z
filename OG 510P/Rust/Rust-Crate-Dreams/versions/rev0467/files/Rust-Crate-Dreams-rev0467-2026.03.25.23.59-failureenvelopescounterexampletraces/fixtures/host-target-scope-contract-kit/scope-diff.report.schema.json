{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/scope-diff.report.schema.json",
  "title": "ScopeDiffReport",
  "type": "object",
  "required": ["schema_version", "classification", "changes"],
  "properties": {
    "schema_version": {"type": "string"},
    "classification": {
      "type": "string",
      "enum": [
        "scope_equivalent",
        "target_only_shift",
        "host_only_shift",
        "mixed_shift",
        "nightly_dependency_added",
        "same_triple_lane_changed",
        "manual_review_required"
      ]
    },
    "changes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "manual-review-required"]
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "suggested_next_steps": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
