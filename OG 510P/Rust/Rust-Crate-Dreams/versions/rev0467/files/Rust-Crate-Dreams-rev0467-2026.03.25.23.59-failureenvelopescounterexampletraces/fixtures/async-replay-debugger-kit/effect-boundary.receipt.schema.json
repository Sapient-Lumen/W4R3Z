{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/async-replay-debugger-kit/effect-boundary.receipt.schema.json",
  "title": "effect-boundary.receipt",
  "type": "object",
  "required": [
    "scenario",
    "effect_class",
    "capture_posture"
  ],
  "properties": {
    "scenario": {
      "type": "string"
    },
    "effect_class": {
      "type": "string",
      "enum": [
        "http",
        "streams",
        "rng",
        "clock",
        "filesystem",
        "database",
        "env",
        "user_input",
        "custom"
      ]
    },
    "capture_posture": {
      "type": "string",
      "enum": [
        "captured_cassette",
        "seeded",
        "stubbed",
        "live",
        "not_applicable",
        "manual_review_required"
      ]
    },
    "lineage": {
      "type": "string"
    },
    "redaction_posture": {
      "type": "string",
      "enum": [
        "public_shareable",
        "internal_only",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
