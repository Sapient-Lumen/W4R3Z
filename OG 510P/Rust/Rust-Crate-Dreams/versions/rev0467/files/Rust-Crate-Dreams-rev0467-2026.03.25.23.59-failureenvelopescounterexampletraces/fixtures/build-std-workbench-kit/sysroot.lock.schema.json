{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build-Std Workbench lock",
  "type": "object",
  "required": [
    "schema_version",
    "toolchain",
    "std_source",
    "target",
    "profile"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "toolchain": {
      "type": "object"
    },
    "std_source": {
      "type": "object"
    },
    "target": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "build_std_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_digests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
