{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Override Lineage Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "effective_toolchain",
    "active_selector"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "requested_toolchain": {"type": "string"},
    "effective_toolchain": {"type": "string"},
    "active_selector": {
      "type": "string",
      "enum": [
        "cli_shorthand",
        "env_toolchain",
        "directory_override",
        "toolchain_file",
        "default_toolchain",
        "manual_review_required"
      ]
    },
    "selector_sources": {
      "type": "array",
      "items": {"type": "string"}
    },
    "shadowed_project_requests": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
