{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wasm Component world-lock report",
  "type": "object",
  "required": [
    "world_name",
    "status"
  ],
  "properties": {
    "package_id": {
      "type": ["string", "null"]
    },
    "world_name": {
      "type": "string"
    },
    "exported_interfaces": {
      "type": "array",
      "items": {"type": "string"}
    },
    "imported_interfaces": {
      "type": "array",
      "items": {"type": "string"}
    },
    "version_mismatches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requested", "available", "reason"],
        "properties": {
          "requested": {"type": "string"},
          "available": {"type": "string"},
          "reason": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["detected", "manual_review_required"]
          }
        },
        "additionalProperties": true
      }
    },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "failed", "manual_review_required"]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
