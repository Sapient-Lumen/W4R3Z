{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exit-semantics.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "success_class",
    "usage_error_class",
    "empty_result_class",
    "partial_success_class",
    "portability_note"
  ],
  "properties": {
    "artifact": {"const": "exit-semantics.receipt"},
    "subject": {"type": "string"},
    "success_class": {
      "enum": ["complete_success", "success_with_warnings", "manual_review_required"]
    },
    "usage_error_class": {
      "enum": ["distinct_nonzero", "shared_failure_code", "manual_review_required"]
    },
    "empty_result_class": {
      "enum": ["success", "distinct_nonzero", "not_applicable", "manual_review_required"]
    },
    "partial_success_class": {
      "enum": ["success_with_report", "distinct_nonzero", "not_applicable", "manual_review_required"]
    },
    "portability_note": {
      "enum": ["named_classes_only", "raw_numbers_documented", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
