{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "delegation-drift.diff",
  "type": "object",
  "required": [
    "subject",
    "changes"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "severity",
          "summary"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    }
  }
}
