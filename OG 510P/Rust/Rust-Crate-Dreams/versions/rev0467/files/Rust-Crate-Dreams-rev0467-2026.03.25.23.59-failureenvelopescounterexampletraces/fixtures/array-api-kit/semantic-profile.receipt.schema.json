{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "semantic-profile.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "crate",
    "semantic_profile",
    "profile_basis"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "proposal_id": {
      "const": "P-0003"
    },
    "crate": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "semantic_profile": {
      "enum": [
        "dense_nd_core",
        "dense_linalg",
        "tensor_backend",
        "columnar_bridge_only",
        "manual_review_required"
      ]
    },
    "profile_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
