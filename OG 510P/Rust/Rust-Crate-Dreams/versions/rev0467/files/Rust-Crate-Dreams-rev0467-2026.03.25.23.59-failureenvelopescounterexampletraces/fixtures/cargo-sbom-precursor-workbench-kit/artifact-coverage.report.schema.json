{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "artifact-coverage.report",
  "type": "object",
  "required": [
    "schema_version",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_label",
          "precursor_eligibility",
          "observation_status",
          "association_basis"
        ],
        "properties": {
          "artifact_label": {
            "type": "string"
          },
          "target_kind": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "crate_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "precursor_eligibility": {
            "type": "string",
            "enum": [
              "eligible_executable_or_linkable",
              "ineligible_non_linkable_or_non_uplifted",
              "unknown"
            ]
          },
          "observation_status": {
            "type": "string",
            "enum": [
              "observed_exact",
              "observed_imported",
              "eligible_but_missing",
              "out_of_scope",
              "manual_review_required"
            ]
          },
          "association_basis": {
            "type": "string",
            "enum": [
              "compiler_artifact_plus_env",
              "directory_import",
              "manual_classification"
            ]
          },
          "fresh": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
