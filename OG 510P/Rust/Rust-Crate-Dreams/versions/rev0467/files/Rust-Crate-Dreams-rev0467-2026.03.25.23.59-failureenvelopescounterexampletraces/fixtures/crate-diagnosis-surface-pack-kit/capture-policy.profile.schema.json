{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapturePolicyProfile",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "default_mode",
    "capture_rules"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "default_mode": {
      "enum": [
        "deny_by_default",
        "allow_list",
        "manual_review_required"
      ]
    },
    "capture_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capture_class", "allowed", "sensitivity"],
        "properties": {
          "capture_class": {
            "enum": [
              "logs",
              "traces",
              "metrics",
              "runtime_snapshot",
              "config_summary",
              "version_fingerprint",
              "manual_review_required"
            ]
          },
          "allowed": {"type": "boolean"},
          "sensitivity": {
            "enum": [
              "low",
              "moderate",
              "secrets_possible",
              "manual_review_required"
            ]
          },
          "requires_opt_in": {"type": "boolean"},
          "redaction_profile": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
