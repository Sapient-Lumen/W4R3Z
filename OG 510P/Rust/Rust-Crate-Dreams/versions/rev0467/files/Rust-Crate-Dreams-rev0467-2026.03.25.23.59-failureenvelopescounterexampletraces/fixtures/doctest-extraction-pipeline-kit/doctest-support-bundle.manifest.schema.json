{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/doctest-extraction-pipeline-kit/doctest-support-bundle.manifest.schema.json",
  "title": "DoctestSupportBundleManifest",
  "type": "object",
  "required": [
    "bundle_id",
    "artifacts"
  ],
  "properties": {
    "bundle_id": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "required_for_review": {
            "type": "boolean"
          },
          "redaction": {
            "type": "string"
          }
        }
      }
    },
    "import_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "manual_review": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
