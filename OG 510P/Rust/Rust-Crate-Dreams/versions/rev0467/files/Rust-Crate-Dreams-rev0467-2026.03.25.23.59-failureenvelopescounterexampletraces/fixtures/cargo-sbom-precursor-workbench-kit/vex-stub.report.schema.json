{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vex-stub.report",
  "type": "object",
  "required": ["schema_version", "status_entries"],
  "properties": {
    "schema_version": {"type": "string"},
    "status_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package_id", "status", "evidence_basis"],
        "properties": {
          "package_id": {"type": "string"},
          "status": {"type": "string", "enum": ["under_investigation", "not_affected_stub", "affected_unknown"]},
          "evidence_basis": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "additionalProperties": true
}
