{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HandoffFidelityReport",
  "type": "object",
  "required": [
    "schema_version",
    "failure_cases"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "failure_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "fidelity_class"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "fidelity_class": {
            "enum": [
              "error_chain_only",
              "error_plus_backtrace",
              "error_plus_span_context",
              "panic_receipt_only",
              "runtime_bundle_complete",
              "sampled_fixture_only",
              "manual_review_required"
            ]
          },
          "checked_dimensions": {
            "type": "array",
            "items": {
              "enum": [
                "error_code_or_class",
                "source_chain",
                "backtrace_status",
                "spantrace_status",
                "panic_location",
                "panic_payload_class",
                "report_artifact_path",
                "redaction_applied",
                "recovery_step_linked",
                "manual_review_boundary_recorded"
              ]
            }
          },
          "missing_dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
