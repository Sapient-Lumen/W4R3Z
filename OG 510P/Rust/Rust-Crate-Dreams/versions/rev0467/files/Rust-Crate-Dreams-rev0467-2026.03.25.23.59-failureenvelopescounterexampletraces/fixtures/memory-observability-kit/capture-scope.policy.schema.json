{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capture-scope.policy",
  "type": "object",
  "required": ["scenario", "scope_class", "authoritative_window"],
  "properties": {
    "scenario": { "type": "string" },
    "scope_class": {
      "type": "string",
      "enum": [
        "startup",
        "single_operation",
        "steady_state_window",
        "background_phase",
        "whole_process_lifetime",
        "manual_review_required"
      ]
    },
    "authoritative_window": { "type": "string" },
    "phase_marks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exclusions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
