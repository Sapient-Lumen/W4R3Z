{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence-source.receipt",
  "type": "object",
  "required": ["schema_version", "source_kind", "exactness"],
  "properties": {
    "schema_version": {"type": "string"},
    "source_kind": {
      "type": "string",
      "enum": ["direct_precursor_capture", "cargo_sbom_path_list", "sidecar_scan", "imported_bundle", "conservative_reconstruction"]
    },
    "exactness": {
      "type": "string",
      "enum": ["exact", "conservative", "partial", "manual_review_required"]
    },
    "build_finished_seen": {"type": "boolean"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
