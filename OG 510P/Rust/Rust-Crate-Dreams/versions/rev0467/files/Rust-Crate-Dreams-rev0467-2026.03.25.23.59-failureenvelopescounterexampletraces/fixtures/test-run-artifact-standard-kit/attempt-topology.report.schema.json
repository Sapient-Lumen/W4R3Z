{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/test-run-artifact-standard-kit/attempt-topology.report.schema.json",
  "title": "attempt-topology.report",
  "type": "object",
  "required": ["artifact", "subject", "execution_class", "fail_fast_posture", "retry_policy", "stress_posture", "attempt_id_posture"],
  "properties": {
    "artifact": {"const": "attempt-topology.report"},
    "subject": {"type": "string"},
    "execution_class": {"enum": ["shared_process", "process_per_test", "mixed", "manual_review_required"]},
    "fail_fast_posture": {"enum": ["binary_fail_fast", "run_fail_fast", "no_fail_fast", "manual_review_required"]},
    "retry_policy": {"enum": ["none", "bounded_retries", "time_bound_retries", "manual_review_required"]},
    "max_attempts_per_test": {"type": ["integer", "null"], "minimum": 1},
    "stress_posture": {"enum": ["none", "count_bound", "duration_bound", "infinite", "manual_review_required"]},
    "attempt_id_posture": {"enum": ["per_run_only", "per_attempt_ids_present", "manual_review_required"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
