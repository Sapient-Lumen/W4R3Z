{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/async-runtime-assurance-profile/shutdown-behavior.report.schema.json",
  "title": "async runtime shutdown behavior report",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "async_task_shutdown_posture",
    "blocking_shutdown_posture",
    "timeout_aftermath",
    "panic_visibility",
    "post_shutdown_resource_posture"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "async_task_shutdown_posture": {
      "type": "string",
      "enum": ["dropped_after_next_yield", "cooperative_until_framework_stop", "manual_review_required"]
    },
    "blocking_shutdown_posture": {
      "type": "string",
      "enum": ["waits_for_blocking_tasks", "no_blocking_pool", "manual_review_required"]
    },
    "timeout_aftermath": {
      "type": "string",
      "enum": ["work_may_continue_after_timeout", "no_timeout_surface", "manual_review_required"]
    },
    "panic_visibility": {
      "type": "string",
      "enum": ["join_handle_or_user_observed", "framework_or_policy_defined", "manual_review_required"]
    },
    "post_shutdown_resource_posture": {
      "type": "string",
      "enum": ["bound_resources_fail_after_drop", "manual_review_required"]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
