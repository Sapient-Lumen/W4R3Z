{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docs Example Drift Diff",
  "type": "object",
  "properties": {
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "change": {
            "type": "string",
            "enum": [
              "manifest-changed",
              "rewrite-changed",
              "mode-changed",
              "support-regressed",
              "support-improved",
              "ignore-policy-changed"
            ]
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "change",
          "summary"
        ]
      }
    }
  },
  "required": [
    "from",
    "to",
    "changes"
  ]
}
