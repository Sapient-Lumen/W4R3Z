{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "activation-gate.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "gate_class",
    "success_basis",
    "failure_action"
  ],
  "properties": {
    "artifact": {
      "const": "activation-gate.receipt"
    },
    "subject": {
      "type": "string"
    },
    "gate_class": {
      "enum": [
        "immediate_accept",
        "startup_task_set",
        "dependency_probe",
        "manual_flip",
        "composite",
        "none",
        "manual_review_required"
      ]
    },
    "success_basis": {
      "enum": [
        "listener_bound",
        "first_request_possible",
        "all_dependencies_ready",
        "background_tasks_stable",
        "manual_operator_mark",
        "manual_review_required"
      ]
    },
    "failure_action": {
      "enum": [
        "block_admission",
        "serve_not_ready",
        "crash_process",
        "degrade_mode",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
