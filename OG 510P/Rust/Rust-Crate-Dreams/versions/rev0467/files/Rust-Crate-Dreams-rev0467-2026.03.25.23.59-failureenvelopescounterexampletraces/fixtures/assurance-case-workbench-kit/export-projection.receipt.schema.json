{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/assurance-case-workbench-kit/export-projection.receipt.schema.json",
  "title": "Export Projection Receipt",
  "type": "object",
  "required": ["version", "format", "projection_class", "status_mapping", "losses"],
  "properties": {
    "version": { "type": "string" },
    "format": { "type": "string", "enum": ["gsn-json", "sacm-xmi", "sacm-json", "other"] },
    "projection_class": { "type": "string", "enum": ["lossless-local", "review-safe-projection", "standards-shaped-lossy"] },
    "status_mapping": {
      "type": "object",
      "required": ["preserves_status_class"],
      "properties": {
        "preserves_status_class": { "type": "boolean" },
        "manual_review_exported_as": { "type": ["string", "null"] },
        "blocked_exported_as": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "losses": { "type": "array", "items": { "type": "string" } },
    "redactions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
