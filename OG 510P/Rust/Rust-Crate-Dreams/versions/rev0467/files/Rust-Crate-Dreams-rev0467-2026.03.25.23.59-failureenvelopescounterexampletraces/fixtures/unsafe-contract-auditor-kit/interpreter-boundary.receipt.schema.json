{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/unsafe-contract-auditor-kit/interpreter-boundary.receipt.schema.json",
  "title": "Interpreter Boundary Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "witness_kind",
    "boundary_class",
    "ffi_posture",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "witness_kind": {
      "type": "string",
      "enum": [
        "miri",
        "loom",
        "other"
      ]
    },
    "boundary_class": {
      "type": "string",
      "enum": [
        "local_only",
        "partial_system",
        "unknown"
      ]
    },
    "target_triple": {
      "type": "string"
    },
    "ffi_posture": {
      "type": "string",
      "enum": [
        "none",
        "present_out_of_scope",
        "mocked",
        "partially_modeled",
        "fully_modeled",
        "unknown"
      ]
    },
    "network_process_platform_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
