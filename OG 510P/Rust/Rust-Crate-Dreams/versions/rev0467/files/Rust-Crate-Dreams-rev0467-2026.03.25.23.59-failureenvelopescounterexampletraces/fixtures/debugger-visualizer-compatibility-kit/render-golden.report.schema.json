{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/debugger-visualizer-compatibility-kit/render-golden.report.schema.json",
  "title": "RenderGoldenReport",
  "type": "object",
  "required": ["goldens"],
  "properties": {
