{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "readiness-surface.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "admission_basis",
    "external_surface",
    "backpressure_semantics"
  ],
  "properties": {
    "artifact": {
      "const": "readiness-surface.receipt"
    },
    "subject": {
      "type": "string"
    },
    "admission_basis": {
      "enum": [
        "tower_poll_ready",
        "listener_state",
        "manual_gate",
        "composite",
        "none",
        "manual_review_required"
      ]
    },
    "external_surface": {
      "enum": [
        "none",
        "http_endpoint",
        "grpc_health",
        "admin_api",
        "mixed",
        "manual_review_required"
      ]
    },
    "backpressure_semantics": {
      "enum": [
        "pending_until_ready",
        "error_when_over_capacity",
        "queue_then_accept",
        "mixed",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
