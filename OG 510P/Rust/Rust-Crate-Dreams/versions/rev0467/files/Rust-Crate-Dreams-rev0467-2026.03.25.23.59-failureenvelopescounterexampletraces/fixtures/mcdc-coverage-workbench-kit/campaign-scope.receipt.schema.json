{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "campaign-scope.receipt",
  "type": "object",
  "required": [
    "campaign_id",
    "selected_packages",
    "execution_class",
    "included_surfaces"
  ],
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "selected_packages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_triples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_class": {
      "enum": [
        "host_only",
        "on_target",
        "mixed_host_target",
        "unknown"
      ]
    },
    "included_surfaces": {
      "type": "object",
      "required": [
        "unit_tests",
        "integration_tests",
        "doctests"
      ],
      "properties": {
        "unit_tests": {
          "type": "boolean"
        },
        "integration_tests": {
          "type": "boolean"
        },
        "doctests": {
          "type": "boolean"
        },
        "proc_macros": {
          "type": "boolean"
        },
        "build_scripts": {
          "type": "boolean"
        },
        "external_harnesses": {
          "type": "boolean"
        },
        "ffi_coverage": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
