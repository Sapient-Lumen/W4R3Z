{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audiobundle manifest",
  "type": "object",
  "required": [
    "format",
    "version",
    "environment",
    "runs"
  ],
  "properties": {
    "format": {
      "const": "audiobundle"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+$"
    },
    "environment": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "host": {
          "type": "string"
        }
      },
      "required": [
        "os",
        "arch"
      ]
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "plugin",
          "verdict"
        ],
        "properties": {
          "plugin": {
            "type": "object",
            "required": [
              "id",
              "format"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "format": {
                "enum": [
                  "clap",
                  "vst3"
                ]
              },
              "path": {
                "type": "string"
              }
            }
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "crash",
              "skipped"
            ]
          },
          "reports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}