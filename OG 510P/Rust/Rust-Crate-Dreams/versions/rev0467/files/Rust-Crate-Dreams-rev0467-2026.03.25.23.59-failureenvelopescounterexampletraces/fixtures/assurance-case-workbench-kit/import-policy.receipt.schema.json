{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/assurance-case-workbench-kit/import-policy.receipt.schema.json",
  "title": "Import Policy Receipt",
  "type": "object",
  "required": ["version", "accepted_evidence_classes", "freshness_policy", "trust_policy", "fallback_behavior"],
  "properties": {
    "version": { "type": "string" },
    "accepted_evidence_classes": { "type": "array", "items": { "type": "string" } },
    "freshness_policy": {
      "type": "object",
      "required": ["stale_effect"],
      "properties": {
        "max_age_days": { "type": ["integer", "null"] },
        "stale_effect": { "type": "string", "enum": ["allow", "manual-review", "block"] }
      },
      "additionalProperties": true
    },
    "trust_policy": {
      "type": "object",
      "required": ["minimum_default_trust"],
      "properties": {
        "minimum_default_trust": { "type": "string", "enum": ["high", "medium", "low", "manual-review"] },
        "manual_review_if_below": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "fallback_behavior": { "type": "string", "enum": ["manual-review", "block", "drop-import"] }
  },
  "additionalProperties": true
}
