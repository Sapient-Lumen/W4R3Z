{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-rebuild-why/session-index.schema.json",
  "title": "Cargo rebuild why — session index",
  "type": "object",
  "required": ["schema_version", "sessions"],
  "properties": {
    "schema_version": {"type": "string"},
    "workspace_root": {"type": "string"},
    "selected_session_id": {"type": "string"},
    "baseline_session_id": {"type": "string"},
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["session_id", "source", "kind"],
        "properties": {
          "session_id": {"type": "string"},
          "source": {
            "type": "string",
            "enum": ["cargo_report_sessions", "build_analysis_log", "manual_entry"]
          },
          "kind": {
            "type": "string",
            "enum": ["build", "check", "test", "unknown"]
          },
          "captured_at": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
