{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/assurance-case-workbench-kit/review-pack-manifest.schema.json",
  "title": "Review Pack Manifest",
  "type": "object",
  "required": ["version", "reports"],
  "properties": {
    "version": { "type": "string" },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "properties": {
          "kind": { "type": "string" },
          "path": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "redaction_receipt": { "type": "string" },
    "generated_exports": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
