{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OffRampSupportBundleManifest",
  "type": "object",
  "required": ["crate", "bundle_version", "includes"],
  "properties": {
    "crate": {"type": "string"},
    "bundle_version": {"type": "string"},
    "includes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "purpose"],
        "properties": {
          "kind": {"type": "string"},
          "path": {"type": "string"},
          "purpose": {"type": "string"}
        }
      }
    }
  }
}
