{
  "schema_version": "2026-03-23",
  "bundle_name": "portable-delivery-audience-claim-bundle",
  "artifacts": [
    {
      "kind": "delivery-audience.report",
      "path": "delivery-audience.report.json",
      "required": false
    },
    {
      "kind": "consumption-claim.report",
      "path": "consumption-claim.report.json",
      "required": false
    },
    {
      "kind": "delivery-memory.report",
      "path": "delivery-memory.report.json",
      "required": false
    },
    {
      "kind": "backlog-pressure.report",
      "path": "backlog-pressure.report.json",
      "required": false
    },
    {
      "kind": "wait-cancellation.report",
      "path": "wait-cancellation.report.json",
      "required": false
    },
    {
      "kind": "progress-fairness.report",
      "path": "progress-fairness.report.json",
      "required": false
    }
  ],
  "artifact_policy": "keep_audience_claim_memory_pressure_and_cancellation_separate",
  "notes": [
    "Many receivers existing does not imply all receivers get each send.",
    "Per-receiver latest-state observation is not the same as broadcast clone fanout."
  ]
}