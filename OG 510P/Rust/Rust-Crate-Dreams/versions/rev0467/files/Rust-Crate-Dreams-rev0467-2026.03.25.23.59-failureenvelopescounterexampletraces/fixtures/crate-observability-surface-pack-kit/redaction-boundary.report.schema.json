{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RedactionBoundaryReport",
  "type": "object",
  "required": ["schema_version", "crate", "rules"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signal_name", "field_glob", "redaction_class"],
        "properties": {
          "signal_name": {"type": "string"},
          "field_glob": {"type": "string"},
          "redaction_class": {"enum": ["safe_by_default", "contains_identifiers", "payload_derived", "hash_or_truncate", "drop_before_export", "manual_review_required"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
