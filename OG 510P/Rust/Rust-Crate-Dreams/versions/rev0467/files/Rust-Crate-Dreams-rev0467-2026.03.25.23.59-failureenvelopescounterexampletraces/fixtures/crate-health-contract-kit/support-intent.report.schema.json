{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/schemas/crate-health-contract-kit/support-intent.report.schema.json",
  "title": "Support Intent Report",
  "type": "object",
  "required": ["crate", "declared_support"],
  "properties": {
    "crate": {"type": "string"},
    "declared_support": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "msrv_policy_declared",
          "security_contact_declared",
          "issue_response_expectation_declared",
          "release_expectation_declared",
          "trusted_publishing_imported",
          "security_tab_imported",
          "manual_review_required"
        ]
      }
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
