{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public API Readiness Bundle",
  "type": "object",
  "required": ["schema_version", "public_api_snapshot", "semver_verdict"],
  "properties": {
    "schema_version": {"type": "string"},
    "public_api_snapshot": {"type": "object"},
    "semver_verdict": {"type": "object"},
    "public_deps_report": {"type": "object"},
    "docs_surface_report": {"type": "object"},
    "release_waivers": {"type": "array", "items": {"type": "object"}}
  }
}
