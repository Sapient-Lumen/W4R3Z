{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/schemas/crate-health-contract-kit/maintenance-window.report.schema.json",
  "title": "Maintenance Window Report",
  "type": "object",
  "required": ["crate", "window_class", "supports"],
  "properties": {
    "crate": {"type": "string"},
    "window_class": {
      "type": "string",
      "enum": [
        "active_window_declared",
        "reactive_window_declared",
        "critical_fix_window_declared",
        "support_window_unknown",
        "release_quiet_but_supported",
        "frozen_without_horizon",
        "manual_review_required"
      ]
    },
    "supports": {
      "type": "array",
      "items": {"type": "string"}
    },
    "excludes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "horizon": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
