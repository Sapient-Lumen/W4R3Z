{
  "schema_version": "1",
  "artifacts": [
    {
      "artifact_path": "target/release/demo-cli",
      "artifact_kind": "bin",
      "package_id": "path+file:///workspace/demo-cli#0.1.0",
      "target_name": "demo-cli",
      "sidecars": [
        {
          "path": "target/release/demo-cli.cargo-sbom.json",
          "sidecar_kind": "cargo_sbom_precursor",
          "association_basis": "cargo_sbom_path_env",
          "attachment_policy": "analysis_only"
        }
      ]
    },
    {
      "artifact_path": "target/release/libdemo_plugin.so",
      "artifact_kind": "cdylib",
      "package_id": "path+file:///workspace/demo-plugin#0.1.0",
      "target_name": "demo_plugin",
      "sidecars": [
        {
          "path": "target/release/libdemo_plugin.debug",
          "sidecar_kind": "split_debug_symbols",
          "association_basis": "filename_match",
          "attachment_policy": "ship_with_artifact"
        }
      ]
    }
  ]
}
