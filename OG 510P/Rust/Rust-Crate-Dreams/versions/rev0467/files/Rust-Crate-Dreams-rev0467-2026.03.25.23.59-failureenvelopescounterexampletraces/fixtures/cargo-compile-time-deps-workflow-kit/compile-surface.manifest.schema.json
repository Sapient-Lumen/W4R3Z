{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-compile-time-deps-workflow-kit/compile-surface.manifest.schema.json",
  "title": "Cargo tool compile surface manifest",
  "type": "object",
  "required": ["schema_version", "included_surfaces", "excluded_surfaces"],
  "properties": {
    "schema_version": {"type": "string"},
    "included_surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["proc_macros", "build_scripts", "host_units", "workspace_libs", "workspace_bins", "tests", "examples", "full_codegen"]
      }
    },
    "excluded_surfaces": {
      "type": "array",
      "items": {"type": "string"}
    },
    "feature_scope": {"type": "string"},
    "target_scope": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
