{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/crate-health-contract-kit/continuity-backstop.report.schema.json",
  "title": "ContinuityBackstopReport",
  "type": "object",
  "required": ["crate", "continuity_profile", "primary_mode", "backstop_mode", "evidence_basis"],
  "properties": {
    "crate": {"type": "string"},
    "continuity_profile": {
      "type": "string",
      "enum": [
        "single_primary_with_documented_backstop",
        "team_routed_with_rotation",
        "organization_owned_best_effort",
        "single_primary_no_backstop",
        "manual_review_required"
      ]
    },
    "primary_mode": {"type": "string"},
    "backstop_mode": {"type": "string"},
    "degraded_response_window": {"type": ["string", "null"]},
    "evidence_basis": {
      "type": "string",
      "enum": ["maintainer_declared", "repo_import", "registry_import", "inferred", "manual_review_required"]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
