{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/a11ydoctor/baseline-drift.report.schema.json",
  "title": "UI accessibility baseline drift report",
  "type": "object",
  "required": ["report_version", "old_snapshot_ref", "new_snapshot_ref", "summary", "changes"],
  "properties": {
    "report_version": {"type": "string"},
    "old_snapshot_ref": {"type": "string"},
    "new_snapshot_ref": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["changed_nodes", "identity_churn", "manual_review_required"],
      "properties": {
        "changed_nodes": {"type": "integer", "minimum": 0},
        "identity_churn": {"type": "string", "enum": ["none", "low", "high", "unknown"]},
        "manual_review_required": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change_id", "class", "severity", "review_status"],
        "properties": {
          "change_id": {"type": "string"},
          "class": {"type": "string", "enum": ["node_added", "node_removed", "name_changed", "role_changed", "state_changed", "focus_order_changed", "node_identity_changed", "manual_review_boundary_changed"]},
          "node_ref": {"type": "string"},
          "severity": {"type": "string", "enum": ["blocking", "warning", "info", "manual-review-required"]},
          "review_status": {"type": "string", "enum": ["accepted", "needs-review", "waived"]},
          "summary": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
