{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/doctest-extraction-pipeline-kit/grouping-comparison.report.schema.json",
  "title": "GroupingComparisonReport",
  "type": "object",
  "required": [
    "comparisons"
  ],
  "properties": {
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "left_bundle",
          "right_bundle",
          "comparison_verdict"
        ],
        "properties": {
          "left_bundle": {
            "type": "string"
          },
          "right_bundle": {
            "type": "string"
          },
          "comparison_verdict": {
            "type": "string",
            "enum": [
              "like_for_like",
              "grouping_drift",
              "target_scope_drift",
              "attribute_scope_drift",
              "basis_drift",
              "not_comparable",
              "manual_review_required"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "import_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
