{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desktop ShipKit release identity receipt",
  "type": "object",
  "required": [
    "app_id",
    "version",
    "channel",
    "artifacts",
    "route",
    "signing_status",
    "manual_review"
  ],
  "properties": {
    "app_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "route": {
      "type": "string",
      "enum": [
        "direct_download",
        "store",
        "mixed"
      ]
    },
    "signing_status": {
      "type": "string",
      "enum": [
        "declared",
        "partial",
        "missing",
        "manual_review_required"
      ]
    },
    "notarization_status": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "format",
          "path"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "store_distribution": {
            "type": "boolean"
          }
        }
      }
    },
    "manual_review": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
