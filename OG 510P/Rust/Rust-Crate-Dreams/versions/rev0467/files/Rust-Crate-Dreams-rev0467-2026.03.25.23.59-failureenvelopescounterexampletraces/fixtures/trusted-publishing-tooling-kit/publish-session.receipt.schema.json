{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted Publishing Session Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "packages",
    "provider",
    "workflow_identity",
    "mode",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "provider": {
      "type": "string"
    },
    "workflow_identity": {
      "type": "string"
    },
    "publish_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "enum": [
        "rehearsal",
        "publish"
      ]
    },
    "outcome": {
      "enum": [
        "success",
        "blocked",
        "failed",
        "partial",
        "manual_review_required"
      ]
    }
  }
}
