{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "accessibility conformance result report",
  "type": "object",
  "required": [
    "format",
    "version",
    "scenario_id",
    "capture_id",
    "summary",
    "findings"
  ],
  "properties": {
    "format": {
      "const": "a11y-conformance-result"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "scenario_id": {
      "type": "string"
    },
    "capture_id": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "status",
        "critical_failures"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail",
            "manual-review"
          ]
        },
        "critical_failures": {
          "type": "integer",
          "minimum": 0
        },
        "manual_review_required": {
          "type": "boolean"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "severity",
          "status"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor",
              "advisory"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "warn",
              "manual-review"
            ]
          },
          "node_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
