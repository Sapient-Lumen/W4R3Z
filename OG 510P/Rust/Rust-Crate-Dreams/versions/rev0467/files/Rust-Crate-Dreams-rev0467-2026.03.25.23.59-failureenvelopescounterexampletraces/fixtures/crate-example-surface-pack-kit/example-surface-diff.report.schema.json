{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExampleSurfaceDiffReport",
  "type": "object",
  "required": [
    "crate",
    "changes"
  ],
  "properties": {
    "crate": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": [
              "quickstart_added",
              "quickstart_removed",
              "environment_changed",
              "docs_linkage_changed",
              "example_output_changed",
              "support_level_changed",
              "manual_review_required"
            ]
          },
          "surface": {"type": "string"}
        }
      }
    }
  }
}
