{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rubygem-native-shipkit/extension-residency.report.schema.json",
  "title": "RubyGem Extension Residency Report",
  "type": "object",
  "required": [
    "schema_version",
    "gem_name",
    "residency_class",
    "load_points"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "gem_name": {
      "type": "string"
    },
    "residency_class": {
      "type": "string",
      "enum": [
        "extension_residency_ok",
        "extension_residency_mismatch",
        "manual_review_required"
      ]
    },
    "load_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "require_stub",
          "expected_shared_object"
        ],
        "properties": {
          "require_stub": {
            "type": "string"
          },
          "expected_shared_object": {
            "type": "string"
          },
          "packaged_path": {
            "type": "string"
          },
          "copied_under_lib": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
