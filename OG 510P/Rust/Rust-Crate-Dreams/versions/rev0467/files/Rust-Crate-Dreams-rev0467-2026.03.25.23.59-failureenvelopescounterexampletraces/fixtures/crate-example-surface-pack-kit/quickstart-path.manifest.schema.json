{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuickstartPathManifest",
  "type": "object",
  "required": [
    "crate",
    "paths"
  ],
  "properties": {
    "crate": {"type": "string"},
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "goal", "entrypoints"],
        "properties": {
          "name": {"type": "string"},
          "goal": {"type": "string"},
          "entrypoints": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
