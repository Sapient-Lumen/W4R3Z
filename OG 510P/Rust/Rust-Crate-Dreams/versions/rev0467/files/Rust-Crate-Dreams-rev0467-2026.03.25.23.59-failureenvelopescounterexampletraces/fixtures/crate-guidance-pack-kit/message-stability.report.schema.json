{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessageStabilityReport",
  "type": "object",
  "required": [
    "schema_version",
    "failure_case",
    "stability_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "failure_case": {
      "type": "string"
    },
    "stability_class": {
      "enum": [
        "exact_snapshot",
        "code_stable_shape_flexible",
        "shape_stable",
        "failure_only",
        "manual_review_required"
      ]
    },
    "observed_via": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
