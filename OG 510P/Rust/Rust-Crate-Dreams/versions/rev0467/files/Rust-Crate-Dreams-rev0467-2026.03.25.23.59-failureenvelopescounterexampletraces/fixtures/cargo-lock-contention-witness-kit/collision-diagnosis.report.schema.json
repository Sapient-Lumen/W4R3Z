{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-lock-contention/collision-diagnosis.report.schema.json",
  "title": "Cargo lock contention — collision diagnosis report",
  "type": "object",
  "required": ["schema_version", "collision_class", "verdict"],
  "properties": {
    "schema_version": {"type": "string"},
    "collision_class": {"type": "string", "enum": ["shared_target_dir", "package_cache_lock", "build_dir_collision", "wrapper_mismatch", "cache_mode_split", "editor_manual_conflict", "manual_review_required", "unknown_wait"]},
    "verdict": {"type": "string", "enum": ["observed_wait", "likely_wait", "mitigated", "manual_review_required"]},
    "supporting_facts": {"type": "array", "items": {"type": "string"}},
    "root_refs": {"type": "array", "items": {"type": "string"}},
    "recommended_mitigation": {"type": "string"}
  },
  "additionalProperties": false
}
