{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plugin-bundle.manifest",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "interface_receipt",
    "capability_receipt",
    "execution_budget_receipt",
    "instance_lifecycle_receipt"
  ],
  "properties": {
    "artifact": {"const": "plugin-bundle.manifest"},
    "subject": {"type": "string"},
    "interface_receipt": {"type": "string"},
    "capability_receipt": {"type": "string"},
    "execution_budget_receipt": {"type": "string"},
    "instance_lifecycle_receipt": {"type": "string"},
    "package_route": {"type": ["string", "null"]},
    "digest": {"type": ["string", "null"]},
    "runtime_family": {"type": ["string", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
