{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/msrv-workspace-lab/msrv-observation.receipt.schema.json",
  "title": "MSRV observation receipt",
  "type": "object",
  "required": [
    "schema_version",
    "package",
    "toolchain",
    "command_family",
    "resolver_policy",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "package": {
      "type": "string"
    },
    "toolchain": {
      "type": "string"
    },
    "command_family": {
      "type": "string",
      "enum": [
        "build",
        "test",
        "metadata",
        "doc",
        "clippy"
      ]
    },
    "resolver_policy": {
      "type": "string",
      "enum": [
        "allow",
        "fallback",
        "unknown"
      ]
    },
    "target": {
      "type": "string"
    },
    "feature_profile": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "not_run"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
