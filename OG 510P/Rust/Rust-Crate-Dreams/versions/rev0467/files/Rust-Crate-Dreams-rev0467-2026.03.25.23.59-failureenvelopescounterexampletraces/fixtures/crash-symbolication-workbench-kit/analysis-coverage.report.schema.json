{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analysis-coverage.report",
  "type": "object",
  "required": [
    "schema_version",
    "crashing_thread_frames",
    "resolved_frames",
    "unresolved_frames",
    "symbol_health",
    "soft_error_posture"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "crashing_thread_frames": {
      "type": "integer"
    },
    "resolved_frames": {
      "type": "integer"
    },
    "unresolved_frames": {
      "type": "integer"
    },
    "symbol_health": {
      "type": "object",
      "required": [
        "loaded",
        "missing",
        "corrupt"
      ],
      "properties": {
        "loaded": {
          "type": "integer"
        },
        "missing": {
          "type": "integer"
        },
        "corrupt": {
          "type": "integer"
        }
      }
    },
    "soft_error_posture": {
      "enum": [
        "none_observed",
        "soft_errors_present",
        "unknown",
        "manual_review_required"
      ]
    },
    "inline_posture": {
      "enum": [
        "inline_frames_available",
        "outer_frames_only",
        "unknown",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
