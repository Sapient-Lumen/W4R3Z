{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/crate-ecosystem-pathfinder-kit/exception-expiry.ticket.schema.json",
  "title": "exception-expiry.ticket",
  "type": "object",
  "required": [
    "artifact_kind",
    "ticket_id",
    "exception_ref",
    "trigger_class",
    "review_owner",
    "deadline",
    "reimport_surfaces",
    "possible_outcomes"
  ],
  "properties": {
    "artifact_kind": {"const": "exception-expiry.ticket"},
    "ticket_id": {"type": "string"},
    "exception_ref": {"type": "string"},
    "trigger_class": {
      "type": "string",
      "enum": [
        "date_expiry",
        "new_release",
        "advisory_change",
        "audit_completed",
        "docs_support_change",
        "target_support_change",
        "manual_recheck"
      ]
    },
    "review_owner": {"type": "string"},
    "deadline": {"type": "string", "format": "date"},
    "reimport_surfaces": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "possible_outcomes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["renew", "remove", "revalidate", "transition", "manual_review_required"]
      },
      "minItems": 1
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
