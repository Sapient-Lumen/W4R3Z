{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecipeWitnessReport",
  "type": "object",
  "required": ["crate", "recipes"],
  "properties": {
    "crate": {"type": "string"},
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recipe_id", "witness_verdict"],
        "properties": {
          "recipe_id": {"type": "string"},
          "witness_verdict": {
            "enum": [
              "manifest_rename_checked",
              "feature_mapping_checked",
              "tests_passed",
              "docs_build_checked",
              "matrix_partial",
              "adapter_required",
              "behavior_review_required",
              "recipe_not_witnessed"
            ]
          },
          "checked_axes": {"type": "array", "items": {"type": "string"}},
          "uncovered_axes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
