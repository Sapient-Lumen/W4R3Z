{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/clippy-safety-profile-waiver-kit/waiver-decision.record.schema.json",
  "title": "Waiver Decision Record",
  "type": "object",
  "required": [
    "schema_version",
    "lint",
    "scope",
    "owner",
    "rationale",
    "source",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lint": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "expiry": {
      "type": "string"
    },
    "source": {
      "enum": [
        "inline_attribute",
        "waiver_file",
        "ci_override",
        "manual_review"
      ]
    },
    "status": {
      "enum": [
        "active",
        "expired",
        "pending_review"
      ]
    },
    "tracking": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
