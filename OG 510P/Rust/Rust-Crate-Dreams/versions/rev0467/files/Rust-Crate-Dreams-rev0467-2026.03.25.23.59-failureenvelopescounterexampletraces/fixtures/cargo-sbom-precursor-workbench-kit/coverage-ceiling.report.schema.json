{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coverage-ceiling.report",
  "type": "object",
  "required": [
    "schema_version",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "limit_kind",
          "severity",
          "summary",
          "manual_review_required"
        ],
        "properties": {
          "limit_kind": {
            "type": "string",
            "enum": [
              "non_linkable_outputs_out_of_scope",
              "same_invocation_not_proven",
              "fresh_cache_reuse_visible",
              "artifact_dir_copy_retention_not_proven",
              "directory_scan_may_miss_outputs"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "note",
              "warning",
              "manual_review_required"
            ]
          },
          "summary": {
            "type": "string"
          },
          "affected_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manual_review_required": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
