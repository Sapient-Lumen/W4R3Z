{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Rebuild Why Kit — exactness report",
  "type": "object",
  "required": ["schema_version", "claims"],
  "properties": {
    "schema_version": { "type": "string" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "exactness"],
        "properties": {
          "claim": { "type": "string" },
          "exactness": {
            "type": "string",
            "enum": [
              "imported_verbatim",
              "normalized_observed",
              "conservative_inference",
              "manual_review_required"
            ]
          },
          "evidence_lane": {
            "type": "string",
            "enum": ["cargo_report_import", "live_capture", "fingerprint_overlay"]
          },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
