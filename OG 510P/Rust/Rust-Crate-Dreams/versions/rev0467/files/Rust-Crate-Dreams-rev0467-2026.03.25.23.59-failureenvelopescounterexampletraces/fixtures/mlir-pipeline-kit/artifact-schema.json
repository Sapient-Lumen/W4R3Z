{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mlirbundle manifest",
  "type": "object",
  "required": [
    "schema_version",
    "pipeline",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "pipeline": {
      "type": "object",
      "required": [
        "passes"
      ],
      "properties": {
        "passes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": [
        "ir_text_path"
      ],
      "properties": {
        "ir_text_path": {
          "type": "string"
        },
        "ir_bytecode_path": {
          "type": "string"
        }
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "mlir_version": {
          "type": "string"
        },
        "llvm_version": {
          "type": "string"
        }
      }
    }
  }
}
