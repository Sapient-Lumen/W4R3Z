{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/crate-ecosystem-pathfinder-kit/revisit-trigger.policy.schema.json",
  "title": "revisit-trigger.policy",
  "type": "object",
  "required": ["task_lane", "starter_set", "triggers"],
  "properties": {
    "task_lane": {"type": "string"},
    "starter_set": {"type": "string"},
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_class", "effect"],
        "properties": {
          "event_class": {
            "enum": [
              "rustsec_advisory",
              "malicious_crate_notice",
              "health_contract_changed",
              "docs_surface_changed",
              "major_release_after_cooldown",
              "task_constraint_changed",
              "manual_review_requested"
            ]
          },
          "effect": {
            "enum": ["inform_only", "review_due", "invalidate_until_reviewed"]
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
