{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/littlefs-native-adoption-kit/storage-adapter.receipt.schema.json",
  "title": "StorageAdapterReceipt",
  "type": "object",
  "required": [
    "adapter_class",
    "backend_identity",
    "read_size",
    "prog_size",
    "erase_size",
    "block_count",
    "async_mode",
    "manual_review_required"
  ],
  "properties": {
    "adapter_class": {"type": "string"},
    "backend_identity": {"type": "string"},
    "read_size": {"type": "integer", "minimum": 1},
    "prog_size": {"type": "integer", "minimum": 1},
    "erase_size": {"type": "integer", "minimum": 1},
    "block_count": {"type": "integer", "minimum": 1},
    "async_mode": {
      "type": "string",
      "enum": ["blocking", "native_async", "cooperative_async", "wrapped_blocking", "unknown"]
    },
    "bad_block_policy": {"type": "string"},
    "yield_notes": {"type": "array", "items": {"type": "string"}},
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": true
}
