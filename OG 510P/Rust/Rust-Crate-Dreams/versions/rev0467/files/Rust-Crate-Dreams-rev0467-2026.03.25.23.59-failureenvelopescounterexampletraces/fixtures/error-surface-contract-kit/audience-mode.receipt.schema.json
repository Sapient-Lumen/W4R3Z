{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audience-mode.receipt",
  "type": "object",
  "required": [
    "artifact",
    "surface_name",
    "audience",
    "detail_posture",
    "includes_source_chain",
    "includes_backtrace"
  ],
  "properties": {
    "artifact": {"const": "audience-mode.receipt"},
    "surface_name": {"type": "string"},
    "audience": {
      "enum": ["end_user", "operator", "developer", "machine_reader", "mixed", "manual_review_required"]
    },
    "detail_posture": {
      "enum": ["concise_human", "rich_human", "structured_machine", "debug_heavy", "mixed", "manual_review_required"]
    },
    "includes_source_chain": {"type": "boolean"},
    "includes_backtrace": {"type": "boolean"},
    "stability_promise": {
      "enum": ["stable_contract", "best_effort", "unstable_debug_only", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
