{
  "schema_version": "0.1",
  "workflow_role": "ide_diagnostics",
  "command": {
    "argv": ["cargo", "check", "--quiet", "--workspace", "--message-format=json", "--all-targets", "--keep-going"],
    "working_directory": "/redacted/workspace",
    "provenance": "rust_analyzer_default"
  },
  "workspace": {
    "root": "/redacted/workspace",
    "selected_packages": ["app", "macro_support"]
  },
  "assumptions": {
    "targets": ["x86_64-unknown-linux-gnu"],
    "target_dir_policy": "separate",
    "build_scripts_enabled": true,
    "proc_macros_enabled": true,
    "sysroot_source": "present",
    "compile_time_deps_mode": false
  },
  "redaction_policy": "paths-redacted",
  "notes": [
    "Separate rust-analyzer target dir avoids shared-lock pressure at the cost of duplicated artifacts."
  ]
}
