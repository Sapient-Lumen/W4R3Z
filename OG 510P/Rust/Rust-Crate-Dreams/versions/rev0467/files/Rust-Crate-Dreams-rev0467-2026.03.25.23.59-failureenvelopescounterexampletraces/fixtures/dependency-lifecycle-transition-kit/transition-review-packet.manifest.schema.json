{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "transition-review-packet.manifest",
  "type": "object",
  "required": [
    "dependency",
    "trigger",
    "disposition",
    "artifacts"
  ],
  "properties": {
    "dependency": {
      "type": "string"
    },
    "prior_basis_lock": {
      "type": "string"
    },
    "trigger": {
      "type": "object",
      "required": [
        "class",
        "summary"
      ],
      "properties": {
        "class": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "disposition": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
