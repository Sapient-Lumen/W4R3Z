{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/candidate-reentry.policy.schema.json",
  "title": "Crate pathfinder candidate re-entry policy",
  "type": "object",
  "required": [
    "schema_version",
    "task_lane",
    "candidate",
    "reentry_conditions",
    "non_reentry_signals",
    "decision_authority",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "task_lane": {
      "type": "string"
    },
    "candidate": {
      "type": "string"
    },
    "reentry_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "trigger_class",
          "required_change",
          "evidence_needed",
          "effect"
        ],
        "properties": {
          "trigger_class": {
            "type": "string",
            "enum": [
              "constraint_shift",
              "release_after_cooldown",
              "docs_support_change",
              "health_or_trust_change",
              "target_support_change",
              "manual_review_request"
            ]
          },
          "required_change": {
            "type": "string"
          },
          "evidence_needed": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "effect": {
            "type": "string",
            "enum": [
              "allow_reconsideration",
              "allow_reimport",
              "still_manual_review"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "non_reentry_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_authority": {
      "type": "string",
      "enum": [
        "manual_review_only",
        "policy_controlled",
        "automatic_reimport_allowed"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
