{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-compile-time-deps-workflow-kit/tool-build.receipt.schema.json",
  "title": "Cargo tool build receipt",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_role",
    "command",
    "workspace",
    "assumptions"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "workflow_role": {
      "type": "string",
      "enum": ["ide_index", "ide_diagnostics", "buildscript_discovery", "ci_preflight", "manual_diagnosis", "unknown"]
    },
    "command": {
      "type": "object",
      "required": ["argv"],
      "properties": {
        "argv": {"type": "array", "items": {"type": "string"}},
        "working_directory": {"type": "string"},
        "provenance": {"type": "string", "enum": ["cargo_default", "rust_analyzer_default", "override_command", "wrapper", "manual"]}
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "root": {"type": "string"},
        "selected_packages": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "assumptions": {
      "type": "object",
      "required": ["targets", "build_scripts_enabled", "proc_macros_enabled"],
      "properties": {
        "targets": {"type": "array", "items": {"type": "string"}},
        "target_dir_policy": {"type": "string", "enum": ["shared", "separate", "unknown"]},
        "build_scripts_enabled": {"type": "boolean"},
        "proc_macros_enabled": {"type": "boolean"},
        "sysroot_source": {"type": "string", "enum": ["present", "missing", "unknown"]},
        "compile_time_deps_mode": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "redaction_policy": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
