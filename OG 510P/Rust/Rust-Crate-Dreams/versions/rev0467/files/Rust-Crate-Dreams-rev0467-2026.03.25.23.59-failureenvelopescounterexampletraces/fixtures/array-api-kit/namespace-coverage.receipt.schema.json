{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "namespace-coverage.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "crate",
    "namespaces"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "proposal_id": {
      "const": "P-0003"
    },
    "crate": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "namespaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "support"
        ],
        "properties": {
          "name": {
            "enum": [
              "core_create",
              "index_slice",
              "broadcast_elementwise",
              "linear_algebra",
              "reductions",
              "autodiff_extensions",
              "columnar_interop"
            ]
          },
          "support": {
            "enum": [
              "exact",
              "partial",
              "extension_only",
              "imported",
              "not_supported",
              "manual_review_required"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
