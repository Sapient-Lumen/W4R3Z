{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "waiver-ledger.policy",
  "type": "object",
  "required": ["schema_version", "waivers"],
  "properties": {
    "schema_version": {"type": "string"},
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_key", "owner", "reason", "expires_on"],
        "properties": {
          "finding_key": {"type": "string"},
          "owner": {"type": "string"},
          "reason": {"type": "string"},
          "approved_by": {"type": "string"},
          "review_on": {"type": "string"},
          "expires_on": {"type": "string"},
          "branch_scope": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  },
  "additionalProperties": true
}
