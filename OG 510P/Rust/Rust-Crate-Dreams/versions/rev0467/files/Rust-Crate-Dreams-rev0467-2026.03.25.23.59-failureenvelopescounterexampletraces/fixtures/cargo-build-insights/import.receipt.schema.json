{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Build Insights — import receipt",
  "type": "object",
  "required": ["schema_version", "sources", "normalization_steps"],
  "properties": {
    "schema_version": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "source_ref", "consumption_mode"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["cargo_report_sessions", "cargo_report_timings", "cargo_report_rebuilds", "build_analysis_jsonl", "cargo_json_messages", "cargo_metadata", "manual_annotation"]
          },
          "source_ref": {"type": "string"},
          "consumption_mode": {"type": "string", "enum": ["verbatim_import", "normalized_extract", "summarized", "manual_note"]},
          "session_ids": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "normalization_steps": {
      "type": "array",
      "items": {"type": "string"}
    },
    "redaction_policy": {
      "type": "object",
      "properties": {
        "paths": {"type": "string", "enum": ["kept", "trimmed", "redacted"]},
        "usernames": {"type": "string", "enum": ["kept", "redacted"]},
        "ci_job_ids": {"type": "string", "enum": ["kept", "redacted"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
