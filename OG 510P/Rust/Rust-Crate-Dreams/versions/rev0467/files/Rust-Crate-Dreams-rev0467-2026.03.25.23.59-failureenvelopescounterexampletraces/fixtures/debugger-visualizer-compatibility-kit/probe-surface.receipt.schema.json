{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/debugger-visualizer-compatibility-kit/probe-surface.receipt.schema.json",
  "title": "ProbeSurfaceReceipt",
  "type": "object",
  "required": ["backend_family", "frontend_surface", "debugger_version", "host_os_class", "delivery_container", "observation_route"],
  "properties": {
    "backend_family": {"type": "string", "enum": ["gdb", "lldb", "cdb", "manual_review"]},
    "frontend_surface": {
      "type": "string",
      "enum": [
        "gdb_cli",
        "rust_gdb_wrapper",
        "lldb_cli",
        "rust_lldb_wrapper",
        "lldb_dap",
        "cdb_cli",
        "windbg_dx",
        "visual_studio_debugger",
        "vscode_cpp_extension",
        "manual_review"
      ]
    },
    "debugger_version": {"type": "string"},
    "host_os_class": {"type": "string"},
    "delivery_container": {
      "type": "string",
      "enum": ["embedded_pdb", "embedded_binary", "project_file", "vsix_registered", "user_visualizer_dir", "system_visualizer_dir", "toolchain_wrapper", "manual_review"]
    },
    "observation_route": {"type": "string"},
    "hot_reload_support": {"type": "string", "enum": ["yes", "no", "unknown"]},
    "delivery_precedence_notes": {"type": "array", "items": {"type": "string"}},
    "manual_review_required": {"type": "boolean"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
