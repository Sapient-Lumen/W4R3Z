{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-workspace-boundary-doctor/boundary-diff.report.schema.json",
  "title": "Cargo boundary diff report",
  "type": "object",
  "required": [
    "schema_version",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "change"
        ],
        "properties": {
          "change": {
            "type": "string",
            "enum": [
              "workspace_root_changed",
              "config_sources_changed",
              "cwd_changed_only",
              "manifest_path_changed_only",
              "manual_review_required"
            ]
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
