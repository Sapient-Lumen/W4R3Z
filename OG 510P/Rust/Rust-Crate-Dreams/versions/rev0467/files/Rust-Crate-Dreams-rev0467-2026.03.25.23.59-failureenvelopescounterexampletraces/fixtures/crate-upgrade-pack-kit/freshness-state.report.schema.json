{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradePackFreshnessStateReport",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "policy_ref",
    "status",
    "reason_class",
    "as_of"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "policy_ref": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "current",
        "stale_but_usable",
        "expired",
        "superseded",
        "unknown"
      ]
    },
    "reason_class": {
      "type": "string",
      "enum": [
        "within_window",
        "review_clock_elapsed",
        "material_change_triggered",
        "newer_pack_available",
        "inputs_missing"
      ]
    },
    "as_of": {
      "type": "string"
    },
    "trigger_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseding_pack_ref": {
      "type": "string"
    },
    "public_use_allowed": {
      "type": "string",
      "enum": [
        "yes",
        "yes_with_warning",
        "internal_only",
        "no"
      ]
    },
    "next_action": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
