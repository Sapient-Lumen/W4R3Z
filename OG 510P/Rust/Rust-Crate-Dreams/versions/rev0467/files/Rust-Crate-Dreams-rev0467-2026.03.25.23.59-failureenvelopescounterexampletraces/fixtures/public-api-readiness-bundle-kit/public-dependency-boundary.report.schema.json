{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/public-api-readiness/public-dependency-boundary.report.schema.json",
  "title": "Public dependency boundary report",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "classification"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "enum": [
              "public",
              "private",
              "ambiguous"
            ]
          },
          "reason": {
            "type": "string"
          },
          "surface_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_origin": {
            "type": "string",
            "enum": [
              "measured",
              "imported",
              "inferred"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "manual_review_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
