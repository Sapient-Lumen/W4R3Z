{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/async-runtime-assurance-profile/runtime-assurance-bundle.manifest.schema.json",
  "title": "async runtime assurance bundle manifest",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "lanes",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lane_id",
          "runtime_family",
          "scope"
        ],
        "properties": {
          "lane_id": {
            "type": "string"
          },
          "runtime_family": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "required_for_review"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "required_for_review": {
            "type": "boolean"
          },
          "sensitivity": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "manual_review_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "share_posture": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
