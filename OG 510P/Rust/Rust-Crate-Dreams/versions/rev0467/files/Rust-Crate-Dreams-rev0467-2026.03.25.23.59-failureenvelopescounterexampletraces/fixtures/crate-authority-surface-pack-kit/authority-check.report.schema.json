{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthorityCheckReport",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "warn",
        "manual_review_required",
        "fail"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
