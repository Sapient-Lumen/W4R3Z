{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Rebuild Why Kit \u2014 reverse impact report",
  "type": "object",
  "required": [
    "schema_version",
    "subject_unit",
    "dependents",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject_unit": {
      "type": "string"
    },
    "upstream_change_class": {
      "type": "string",
      "enum": [
        "source_edit",
        "lockfile_change",
        "profile_target_drift",
        "unknown"
      ]
    },
    "dependents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "unit",
          "status",
          "impact_class"
        ],
        "properties": {
          "unit": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "rebuilt",
              "reused",
              "unknown"
            ]
          },
          "impact_class": {
            "type": "string",
            "enum": [
              "reverse_rebuild_observed",
              "relink_candidate_possible",
              "interface_change_unproven",
              "manual_review_required"
            ]
          },
          "evidence_lane": {
            "type": "string",
            "enum": [
              "cargo_report_import",
              "live_capture",
              "fingerprint_overlay"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "rebuilt_dependents",
        "relink_candidate_count",
        "manual_review_count"
      ],
      "properties": {
        "rebuilt_dependents": {
          "type": "integer",
          "minimum": 0
        },
        "relink_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "manual_review_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
