{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/crate-ecosystem-pathfinder-kit/profile-satisfaction.report.schema.json",
  "title": "profile-satisfaction.report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "profile_id",
    "task_id",
    "subject",
    "status",
    "satisfied_floors",
    "unsatisfied_or_manual_floors",
    "exception_budget_status",
    "next_actions"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "report_id": { "type": "string" },
    "profile_id": { "type": "string" },
    "task_id": { "type": "string" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_kind", "subject_ref"],
      "properties": {
        "subject_kind": {
          "type": "string",
          "enum": ["candidate", "starter_set", "frozen_basis"]
        },
        "subject_ref": { "type": "string" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["pass", "conditional", "manual_review_required", "fail"]
    },
    "satisfied_floors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["floor_id", "evidence_refs"],
        "properties": {
          "floor_id": { "type": "string" },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "unsatisfied_or_manual_floors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["floor_id", "reason", "severity"],
        "properties": {
          "floor_id": { "type": "string" },
          "reason": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["conditional", "manual_review_required", "fail"]
          },
          "can_be_temporarily_excepted": { "type": "boolean" }
        }
      }
    },
    "exception_budget_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_open_exceptions", "currently_open", "within_budget"],
      "properties": {
        "max_open_exceptions": { "type": "integer", "minimum": 0 },
        "currently_open": { "type": "integer", "minimum": 0 },
        "within_budget": { "type": "boolean" }
      }
    },
    "next_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "non_claims_repeated": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
