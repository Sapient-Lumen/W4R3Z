{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conditioned-availability.report",
  "type": "object",
  "required": ["crate", "profile", "subjects"],
  "properties": {
    "crate": {"type": "string"},
    "profile": {"type": "string"},
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "subject_kind",
          "subject",
          "build_surface_id",
          "availability_class",
          "authority_basis",
          "reason_classes"
        ],
        "properties": {
          "id": {"type": "string"},
          "subject_kind": {
            "type": "string",
            "enum": ["item", "module", "example", "docs_page", "query_slice"]
          },
          "subject": {"type": "string"},
          "build_surface_id": {"type": "string"},
          "availability_class": {
            "type": "string",
            "enum": [
              "present",
              "absent",
              "target_bound",
              "feature_bound",
              "recipe_bound",
              "format_window_mismatch",
              "manual_review_required"
            ]
          },
          "authority_basis": {
            "type": "string",
            "enum": ["rustdoc_json", "docsrs_html", "cargo_metadata", "tool_output", "inference"]
          },
          "reason_classes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cfg_docsrs_scope",
                "feature_gate",
                "target_gate",
                "example_scrape_recipe",
                "rustdoc_json_format_window",
                "manual_review_required"
              ]
            }
          },
          "item_witness_ids": {"type": "array", "items": {"type": "string"}},
          "citation_locator_ids": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}},
          "caveats": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
