{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crate capability contract",
  "type": "object",
  "required": [
    "schema_version",
    "package",
    "support_profiles",
    "interop_claims"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "package": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "declared_rust_version_policy": {
          "type": "string"
        },
        "contract_location": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "support_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "runtime_coupling",
          "std_support",
          "docs_posture"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "runtime_coupling": {
            "type": "string"
          },
          "std_support": {
            "type": "string"
          },
          "docs_posture": {
            "type": "string"
          },
          "target_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "native_obligations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manual_review_zones": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "interop_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ecosystem",
          "claim"
        ],
        "properties": {
          "ecosystem": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "claim_class": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
