{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "observer-cursor.report",
  "type": "object",
  "required": [
    "surface",
    "cursor_class",
    "observer_cardinality",
    "cursor_owner",
    "progress_frontier",
    "claim_basis",
    "claim_ceiling"
  ],
  "properties": {
    "surface": {
      "type": "string"
    },
    "cursor_class": {
      "type": "string",
      "enum": [
        "per_observer_seen_cursor",
        "per_observer_retained_history_cursor",
        "shared_competitive_claim_pool",
        "fixed_single_receiver_cursor",
        "wake_only_no_cursor",
        "manual_review_required"
      ]
    },
    "observer_cardinality": {
      "type": "string"
    },
    "cursor_owner": {
      "type": "string"
    },
    "progress_frontier": {
      "type": "string"
    },
    "rewind_or_rebase_posture": {
      "type": "string"
    },
    "claim_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_ceiling": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
