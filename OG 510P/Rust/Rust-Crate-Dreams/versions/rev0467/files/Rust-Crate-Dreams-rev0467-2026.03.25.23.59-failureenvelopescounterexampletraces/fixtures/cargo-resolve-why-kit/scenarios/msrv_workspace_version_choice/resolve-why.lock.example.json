{
  "schema_version": "0.1.0",
  "capture_id": "msrv-workspace-01",
  "workspace_root": "/workspace",
  "cargo": {
    "version": "1.90.0",
    "resolver_version": "3",
    "incompatible_rust_versions": "fallback"
  },
  "selection": {
    "command_kind": "check",
    "workspace_members": ["a", "b"],
    "targets": ["host"],
    "features": [],
    "all_features": false,
    "no_default_features": false
  },
  "inputs": {
    "lockfile_present": true,
    "manifest_paths": ["/workspace/Cargo.toml", "/workspace/a/Cargo.toml", "/workspace/b/Cargo.toml"]
  }
}
