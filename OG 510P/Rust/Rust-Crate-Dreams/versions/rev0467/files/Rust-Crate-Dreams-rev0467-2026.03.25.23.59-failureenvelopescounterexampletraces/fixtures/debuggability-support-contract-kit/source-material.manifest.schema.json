{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/debuggability-support-contract-kit/source-material.manifest.schema.json",
  "title": "Debuggability source material manifest",
  "type": "object",
  "required": ["schema_version", "subject", "materials"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "logical_name",
          "material_kind",
          "location_class",
          "lookup_role",
          "share_posture"
        ],
        "properties": {
          "logical_name": {"type": "string"},
          "material_kind": {
            "type": "string",
            "enum": [
              "workspace_source_tree",
              "source_archive",
              "sysroot_sources",
              "generated_source_bundle",
              "manual_other"
            ]
          },
          "location_class": {
            "type": "string",
            "enum": [
              "local_absolute_path",
              "relative_bundle_path",
              "remapped_virtual_path",
              "external_url",
              "unknown"
            ]
          },
          "location": {"type": "string"},
          "lookup_role": {
            "type": "string",
            "enum": [
              "primary_lookup_material",
              "optional_lookup_material",
              "manual_review_required"
            ]
          },
          "share_posture": {
            "type": "string",
            "enum": [
              "safe_to_share",
              "internal_only",
              "redacted",
              "manual_review_required"
            ]
          },
          "supports_remapped_prefixes": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "manual_review_gaps": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
