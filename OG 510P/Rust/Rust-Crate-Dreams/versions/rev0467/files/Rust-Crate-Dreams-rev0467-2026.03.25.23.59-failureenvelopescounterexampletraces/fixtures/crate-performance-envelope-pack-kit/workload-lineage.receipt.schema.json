{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Performance Workload Lineage Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "input_origin",
    "warmth"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "input_origin": {
      "type": "string",
      "enum": [
        "synthetic_inline",
        "fixture_file",
        "seeded_generated",
        "captured_trace",
        "imported_recording",
        "external_live",
        "manual_review_required"
      ]
    },
    "corpus_id": {
      "type": "string"
    },
    "warmth": {
      "type": "string",
      "enum": [
        "cold",
        "warm",
        "mixed",
        "unknown"
      ]
    },
    "scale_class": {
      "type": "string",
      "enum": [
        "tiny",
        "representative",
        "stress",
        "unknown"
      ]
    },
    "replayable": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
