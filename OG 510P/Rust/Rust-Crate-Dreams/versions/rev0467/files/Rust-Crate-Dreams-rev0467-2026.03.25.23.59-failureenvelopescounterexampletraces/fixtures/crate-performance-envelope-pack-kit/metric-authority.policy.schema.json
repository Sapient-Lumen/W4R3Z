{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Performance Metric Authority Policy",
  "type": "object",
  "required": [
    "schema_version",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "minimum_evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "wall_time_ms",
              "throughput_bytes_per_sec",
              "instructions",
              "cache_events",
              "allocations",
              "peak_rss_bytes",
              "startup_time_ms",
              "artifact_bytes",
              "manual_review_required",
              "unknown"
            ]
          },
          "minimum_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
