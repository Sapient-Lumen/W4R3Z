{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "normalized accessibility tree",
  "type": "object",
  "required": [
    "format",
    "version",
    "capture_id",
    "lane",
    "nodes"
  ],
  "properties": {
    "format": {
      "const": "normalized-tree"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "capture_id": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "root_id": {
      "type": "string"
    },
    "comparability": {
      "type": "object",
      "properties": {
        "semantic_core": {
          "type": "boolean"
        },
        "platform_extensions_present": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "target"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                }
              }
            }
          },
          "extensions": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
