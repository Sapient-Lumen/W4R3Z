{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-resolve-why/version-choices.schema.json",
  "title": "Cargo resolve why — version choices",
  "type": "object",
  "required": ["schema_version", "choices"],
  "properties": {
    "schema_version": {"type": "string"},
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package", "selected_version", "influences"],
        "properties": {
          "package": {"type": "string"},
          "selected_version": {"type": "string"},
          "lockfile_state": {
            "type": "string",
            "enum": ["locked_existing", "updated", "generated", "manual_review_required"]
          },
          "requirement_contexts": {
            "type": "array",
            "items": {"type": "string"}
          },
          "resolver_version": {"type": "string"},
          "influences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "summary"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "manifest_requirement",
                    "lockfile_pin",
                    "resolver_policy",
                    "msrv_fallback",
                    "feature_unification_mode",
                    "command_selection",
                    "conservative_inference"
                  ]
                },
                "summary": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "rejected_alternatives_visible": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
