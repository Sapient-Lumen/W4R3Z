{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/secrets-kit/persistence-posture.receipt.schema.json",
  "title": "persistence-posture.receipt",
  "type": "object",
  "required": [
    "subject",
    "profile",
    "backend_class",
    "persistence_class",
    "evidence_class",
    "judgment"
  ],
  "properties": {
    "subject": {"type": "string"},
    "profile": {"type": "string"},
    "backend_class": {
      "type": "string",
      "enum": ["native_store", "file_envelope", "env_only", "remote_store", "mock_store", "memory_only", "other"]
    },
    "persistence_class": {
      "type": "string",
      "enum": ["persistent", "session_bound", "ephemeral", "mock_only", "external", "unknown"]
    },
    "evidence_class": {
      "type": "string",
      "enum": ["observed", "imported", "declared", "manual_review_required"]
    },
    "judgment": {
      "type": "string",
      "enum": ["persistent_supported", "non_persistent_support", "mock_substitution", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
