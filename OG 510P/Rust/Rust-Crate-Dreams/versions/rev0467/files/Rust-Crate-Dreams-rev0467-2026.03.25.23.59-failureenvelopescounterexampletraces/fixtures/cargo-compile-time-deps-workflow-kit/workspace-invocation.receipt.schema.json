{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-compile-time-deps-workflow-kit/workspace-invocation.receipt.schema.json",
  "title": "WorkspaceInvocationReceipt",
  "type": "object",
  "required": ["schema_version", "linked_projects_count", "check_lane", "build_script_lane"],
  "properties": {
    "schema_version": {"type": "string"},
    "linked_projects_count": {"type": "integer", "minimum": 1},
    "opened_project_root_mode": {"type": "string", "enum": ["workspace_root", "opened_project_root", "manual_review_required", "unknown"]},
    "check_lane": {
      "type": "object",
      "required": ["invocation_strategy", "working_directory_mode"],
      "properties": {
        "invocation_strategy": {"type": "string", "enum": ["default", "per_workspace", "once", "unknown"]},
        "working_directory_mode": {"type": "string", "enum": ["workspace_root", "opened_project_root", "mixed", "unknown"]},
        "expected_runs": {"type": "integer", "minimum": 0},
        "observed_runs": {"type": "integer", "minimum": 0},
        "placeholder_usage": {"type": "array", "items": {"type": "string", "enum": ["label", "saved_file"]}},
        "startup_scope_leakage": {"type": "string", "enum": ["none_observed", "observed", "unknown"]}
      },
      "additionalProperties": false
    },
    "build_script_lane": {
      "type": "object",
      "required": ["invocation_strategy", "working_directory_mode"],
      "properties": {
        "invocation_strategy": {"type": "string", "enum": ["default", "per_workspace", "once", "unknown"]},
        "working_directory_mode": {"type": "string", "enum": ["workspace_root", "opened_project_root", "mixed", "unknown"]},
        "expected_runs": {"type": "integer", "minimum": 0},
        "observed_runs": {"type": "integer", "minimum": 0},
        "paired_with_check_lane": {"type": "string", "enum": ["yes", "no", "unknown"]}
      },
      "additionalProperties": false
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
