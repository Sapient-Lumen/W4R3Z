{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-resolve-why/feature-origin.report.schema.json",
  "title": "Cargo resolve why — feature origin report",
  "type": "object",
  "required": [
    "schema_version",
    "package_name",
    "observations",
    "overall_exactness"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "package_name": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject_feature",
          "origin_kind",
          "dependency_activation",
          "exactness"
        ],
        "properties": {
          "subject_feature": {
            "type": "string"
          },
          "referenced_token": {
            "type": "string"
          },
          "dependency_package": {
            "type": "string"
          },
          "origin_kind": {
            "type": "string",
            "enum": [
              "explicit_feature_clause",
              "implicit_optional_dependency_alias",
              "dep_syntax_hidden_dependency",
              "dependency_feature_forward",
              "weak_dependency_feature_forward",
              "conservative_merge"
            ]
          },
          "dependency_activation": {
            "type": "string",
            "enum": [
              "activates_optional_dependency",
              "forwards_feature_and_activates_dependency",
              "requires_other_activation",
              "does_not_activate_dependency",
              "suppressed_alias",
              "manual_review_required"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "user_addressable_feature",
              "hidden_internal_detail",
              "not_a_real_feature_name",
              "manual_review_required"
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence_basis": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cargo_metadata",
                "cargo_tree_features",
                "unit_graph",
                "manual_manifest_scan",
                "issue_repro",
                "release_notes",
                "registry_index_docs",
                "conservative_inference"
              ]
            }
          },
          "exactness": {
            "type": "string",
            "enum": [
              "exact",
              "conservative",
              "manual_review_required"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "overall_exactness": {
      "type": "string",
      "enum": [
        "exact",
        "conservative",
        "manual_review_required"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
