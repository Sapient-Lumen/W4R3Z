{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Divergence Triage Report",
  "type": "object",
  "required": ["schema_version", "repo_id", "profile_id", "conclusion_class", "severity"],
  "properties": {
    "schema_version": {"type": "string"},
    "repo_id": {"type": "string"},
    "profile_id": {"type": "string"},
    "conclusion_class": {
      "type": "string",
      "enum": [
        "converged",
        "missing_updates",
        "membership_epoch_mismatch",
        "revoked_device",
        "compaction_gap",
        "migration_mismatch",
        "transport_not_comparable",
        "redaction_insufficient",
        "manual_review_required"
      ]
    },
    "severity": {"type": "string", "enum": ["info", "warning", "error"]},
    "blocking_receipts": {"type": "array", "items": {"type": "string"}},
    "recommended_actions": {"type": "array", "items": {"type": "string"}},
    "comparability": {
      "type": "object",
      "properties": {
        "comparable": {"type": "boolean"},
        "why_not": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
