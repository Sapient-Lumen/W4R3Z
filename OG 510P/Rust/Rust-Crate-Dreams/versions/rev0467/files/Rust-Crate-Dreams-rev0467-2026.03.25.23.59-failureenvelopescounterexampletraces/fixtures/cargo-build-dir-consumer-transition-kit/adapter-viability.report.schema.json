{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-build-dir-consumer-transition/adapter-viability.report.schema.json",
  "title": "Cargo build-dir adapter viability report",
  "type": "object",
  "required": [
    "schema_version",
    "consumer_ref",
    "recommended_adapter",
    "authority_class",
    "availability_class",
    "fallback_posture"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "consumer_ref": {"type": "string"},
    "recommended_adapter": {
      "type": "string",
      "enum": [
        "switch_to_artifact_handoff",
        "use_build_script_json",
        "use_out_dir_contract",
        "use_cargo_bin_exe",
        "use_dep_info",
        "support_both_layouts",
        "keep_scraping_for_now",
        "blocked_on_upstream"
      ]
    },
    "authority_class": {
      "type": "string",
      "enum": [
        "documented_stable",
        "documented_stable_with_version_window",
        "documented_nightly",
        "heuristic_only",
        "upstream_gap"
      ]
    },
    "availability_class": {
      "type": "string",
      "enum": [
        "available_now",
        "available_with_minimum_cargo",
        "nightly_only",
        "manual_review_required"
      ]
    },
    "cargo_version_floor": {"type": "string"},
    "requires_dual_support": {"type": "boolean"},
    "fallback_posture": {
      "type": "string",
      "enum": [
        "none",
        "older_cargo_fallback_required",
        "legacy_layout_fallback_required",
        "both_fallbacks_required",
        "manual_review_required"
      ]
    },
    "notes": {"type": "string"},
    "evidence_sources": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
