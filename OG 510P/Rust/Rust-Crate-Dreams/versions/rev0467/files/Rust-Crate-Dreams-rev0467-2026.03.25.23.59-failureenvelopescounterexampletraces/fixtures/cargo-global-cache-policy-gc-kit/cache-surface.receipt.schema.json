{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cache Surface Receipt",
  "type": "object",
  "properties": {
    "surface": {
      "type": "string",
      "enum": [
        "cargo_home_global_cache",
        "target_dir_final_artifacts",
        "build_dir_intermediate_artifacts",
        "future_user_wide_build_cache",
        "mixed_or_unknown"
      ]
    },
    "basis": {
      "type": "array",
      "items": {"type": "string"}
    },
    "covered_classes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "excluded_classes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"},
    "notes": {"type": "string"}
  },
  "required": ["surface", "basis", "covered_classes", "excluded_classes", "manual_review_required"]
}
