{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/trait-solver-drift-witness-kit/minimization-lineage.receipt.schema.json",
  "title": "Minimization Lineage Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "minimized_case_id",
    "source_case_id",
    "source_origin",
    "preserved_claim"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "minimized_case_id": {
      "type": "string"
    },
    "source_case_id": {
      "type": "string"
    },
    "source_origin": {
      "enum": [
        "ui_test",
        "trybuild",
        "compiletest_rs",
        "handwritten",
        "generated_witness"
      ]
    },
    "reducers_applied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dropped_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preserved_claim": {
      "enum": [
        "semantic_drift",
        "diagnostic_drift",
        "scope_drift",
        "manual_review_required"
      ]
    },
    "authority_posture": {
      "enum": [
        "authoritative",
        "derived_but_trusted",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
