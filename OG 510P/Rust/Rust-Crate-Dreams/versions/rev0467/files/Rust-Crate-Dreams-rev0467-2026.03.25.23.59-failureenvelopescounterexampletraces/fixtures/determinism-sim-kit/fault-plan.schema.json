{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/fixtures/determinism-sim-kit/fault-plan.schema.json",
  "title": "fault-plan",
  "type": "object",
  "required": ["plan_id", "topology", "events"],
  "properties": {
    "plan_id": {"type": "string"},
    "topology": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "role"],
        "properties": {
          "node_id": {"type": "string"},
          "role": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "at_step"],
        "properties": {
          "kind": {"type": "string", "enum": ["delay", "drop", "reorder", "partition", "repair", "crash", "restart", "clock-skew"]},
          "at_step": {"type": "integer", "minimum": 0},
          "target": {"type": "string"},
          "details": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
