{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/schemas/trust-lens-kit/signal-basis.report.schema.json",
  "title": "Trust Lens Signal Basis Report",
  "type": "object",
  "required": ["subject", "signals"],
  "properties": {
    "subject": {"type": "string"},
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "source", "summary"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "registry_signal",
              "advisory_signal",
              "publishing_identity_signal",
              "audit_import_signal",
              "effect_scan_signal",
              "research_model_signal",
              "manual_declaration",
              "inference"
            ]
          },
          "source": {"type": "string"},
          "summary": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
