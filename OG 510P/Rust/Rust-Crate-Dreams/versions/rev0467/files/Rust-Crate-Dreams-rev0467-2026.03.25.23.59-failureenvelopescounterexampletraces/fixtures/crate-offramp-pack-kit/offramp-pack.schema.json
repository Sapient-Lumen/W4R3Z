{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OffRampPack",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "sunset_phase",
    "successors",
    "exit_lanes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "sunset_phase": {
      "enum": [
        "active_but_discouraged",
        "deprecated",
        "security_only",
        "superseded",
        "no_successor",
        "retired"
      ]
    },
    "successors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "relation"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "drop_in",
              "partial",
              "fork",
              "shim",
              "stopgap",
              "none"
            ]
          }
        }
      }
    },
    "exit_lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "status"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "status": {
            "enum": [
              "checked",
              "manual_review_required",
              "unsupported"
            ]
          }
        }
      }
    },
    "manual_review_zones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
