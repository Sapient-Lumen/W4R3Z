{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeDurableCueReport",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "surface_state",
    "cues",
    "overall_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "surface_state": {
      "type": "string",
      "enum": [
        "candidate_public",
        "frozen_public",
        "superseded_public"
      ]
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cue_id",
          "cue_class",
          "governing_ref",
          "audience",
          "cue_posture",
          "visibility_status"
        ],
        "properties": {
          "cue_id": {
            "type": "string"
          },
          "cue_class": {
            "type": "string",
            "enum": [
              "blocking_warning",
              "warning",
              "deviation",
              "readiness",
              "freshness",
              "supersession",
              "manual_review_boundary"
            ]
          },
          "governing_ref": {
            "type": "string"
          },
          "audience": {
            "type": "string",
            "enum": [
              "downstream_adopter",
              "release_reviewer",
              "public_contract"
            ]
          },
          "cue_posture": {
            "type": "string",
            "enum": [
              "summary_banner",
              "summary_callout",
              "warning_label_plus_summary",
              "warning_register_plus_summary",
              "replacement_notice",
              "exported_status_block",
              "missing_durable_equivalent"
            ]
          },
          "durable_surface_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "compact_only_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visibility_status": {
            "type": "string",
            "enum": [
              "durable_visible",
              "compact_only",
              "register_only",
              "missing"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "unknown"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
