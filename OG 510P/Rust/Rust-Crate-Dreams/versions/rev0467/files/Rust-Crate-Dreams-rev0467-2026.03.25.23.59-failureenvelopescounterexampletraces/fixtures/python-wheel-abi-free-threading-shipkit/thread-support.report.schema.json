{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Python Wheel thread-support report",
  "type": "object",
  "required": [
    "declared_policy",
    "status"
  ],
  "properties": {
    "declared_policy": {
      "type": "string",
      "enum": [
        "free_threaded_supported",
        "gil_required_opt_out",
        "manual_review_required"
      ]
    },
    "gil_used": {
      "type": ["boolean", "null"]
    },
    "pyo3_version_family": {
      "type": ["string", "null"]
    },
    "unsafe_hotspots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["location", "reason"],
        "properties": {
          "location": {"type": "string"},
          "reason": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["audited", "unaudited", "manual_review_required"]
          }
        },
        "additionalProperties": true
      }
    },
    "pyclass_sync_audit": {
      "type": ["string", "null"],
      "enum": ["passed", "failed", "manual_review_required", null]
    },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "failed", "manual_review_required"]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
