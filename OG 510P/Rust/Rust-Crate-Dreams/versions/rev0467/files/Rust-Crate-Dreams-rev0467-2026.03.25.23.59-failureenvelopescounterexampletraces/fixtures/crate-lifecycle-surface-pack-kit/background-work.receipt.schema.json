{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BackgroundWorkReceipt",
  "type": "object",
  "required": [
    "crate",
    "scenario",
    "components"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "work_kind",
          "started"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "work_kind": {
            "enum": [
              "task",
              "worker_thread",
              "timer",
              "subscription",
              "queue_drain",
              "reconnect_loop",
              "manual_review_required"
            ]
          },
          "started": {
            "type": "boolean"
          },
          "stop_signal": {
            "type": "string"
          }
        }
      }
    }
  }
}
