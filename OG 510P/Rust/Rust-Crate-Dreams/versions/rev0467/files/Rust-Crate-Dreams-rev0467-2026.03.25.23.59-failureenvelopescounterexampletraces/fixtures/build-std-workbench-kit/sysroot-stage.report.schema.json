{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build-Std stage posture report",
  "type": "object",
  "required": [
    "schema_version",
    "verdict",
    "reasons"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "manual_build_std",
        "explicit_std_dependency_transition",
        "target_modifier_profile",
        "automatic_rebuild_policy",
        "manual_review_required"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
