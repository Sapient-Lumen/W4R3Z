{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/state-continuity.contract.schema.json",
  "title": "StateContinuityContract",
  "type": "object",
  "required": [
    "continuity_class",
    "preserved_state_classes",
    "reset_state_classes",
    "migration_hooks_required"
  ],
  "properties": {
    "continuity_class": {
      "type": "string",
      "enum": [
        "full",
        "partial",
        "restart_required",
        "unknown"
      ]
    },
    "preserved_state_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reset_state_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "migration_hooks_required": {
      "type": "boolean"
    },
    "manual_review_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
