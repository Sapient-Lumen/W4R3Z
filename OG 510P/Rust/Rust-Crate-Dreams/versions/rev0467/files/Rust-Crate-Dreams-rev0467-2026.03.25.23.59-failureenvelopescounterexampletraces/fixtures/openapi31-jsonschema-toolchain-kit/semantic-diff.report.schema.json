{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rustcrate.dreams/fixtures/openapi31-jsonschema-toolchain-kit/semantic-diff.report.schema.json",
  "title": "semantic-diff.report",
  "type": "object",
  "required": [
    "artifact",
    "left",
    "right",
    "changes",
    "verdict_mode"
  ],
  "properties": {
    "artifact": {
      "const": "semantic-diff.report"
    },
    "left": {
      "type": "string"
    },
    "right": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "verdict_mode": {
      "type": "string",
      "enum": [
        "descriptive-only",
        "policy-backed"
      ]
    },
    "policy_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "verdict": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
