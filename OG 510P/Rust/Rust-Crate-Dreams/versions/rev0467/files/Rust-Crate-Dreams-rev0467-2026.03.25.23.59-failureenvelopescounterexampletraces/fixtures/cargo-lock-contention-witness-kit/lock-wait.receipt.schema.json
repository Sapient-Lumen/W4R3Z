{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-lock-contention/lock-wait.receipt.schema.json",
  "title": "Cargo lock contention — lock wait receipt",
  "type": "object",
  "required": ["schema_version", "command", "wait_scope", "observed_wait_ms", "evidence_strength"],
  "properties": {
    "schema_version": {"type": "string"},
    "command": {"type": "array", "items": {"type": "string"}},
    "wait_scope": {"type": "string", "enum": ["target_dir", "build_dir", "package_cache", "index_cache", "unknown_scope"]},
    "root_ref": {"type": "string"},
    "observed_wait_ms": {"type": "integer", "minimum": 0},
    "observation_sources": {
      "type": "array",
      "items": {"type": "string", "enum": ["cargo_stderr", "cargo_json", "process_sample", "config_scan", "manual_annotation"]}
    },
    "evidence_strength": {"type": "string", "enum": ["observed", "strong_inference", "weak_inference", "unknown"]},
    "blocked_by_role": {"type": "string"},
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
