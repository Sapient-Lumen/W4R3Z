{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Build Insights — exactness report",
  "type": "object",
  "required": ["schema_version", "claims"],
  "properties": {
    "schema_version": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "exactness"],
        "properties": {
          "claim": {"type": "string"},
          "exactness": {"type": "string", "enum": ["imported_verbatim", "normalized_observed", "conservative_inference", "manual_review_required"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
