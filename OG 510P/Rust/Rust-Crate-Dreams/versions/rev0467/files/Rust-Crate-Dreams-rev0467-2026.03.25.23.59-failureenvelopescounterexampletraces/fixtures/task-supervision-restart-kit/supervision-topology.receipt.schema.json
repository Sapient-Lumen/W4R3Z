{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "supervision-topology.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "supervisor_kind",
    "strategy",
    "membership_shape",
    "blast_radius"
  ],
  "properties": {
    "artifact": {"const": "supervision-topology.receipt"},
    "subject": {"type": "string"},
    "supervisor_kind": {
      "enum": ["tokio_task_group", "task_supervisor", "actor_supervisor", "process_tree", "manual_review_required"]
    },
    "strategy": {
      "enum": ["one_for_one", "one_for_all", "rest_for_one", "dynamic_one_for_one", "manual_review_required"]
    },
    "membership_shape": {
      "enum": ["fixed_startup_set", "dynamic_runtime_set", "mixed", "manual_review_required"]
    },
    "blast_radius": {
      "enum": ["failing_child_only", "ordered_suffix", "whole_group", "subtree", "manual_review_required"]
    },
    "dependency_order_basis": {
      "enum": ["none", "startup_order", "explicit_dependency_graph", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
