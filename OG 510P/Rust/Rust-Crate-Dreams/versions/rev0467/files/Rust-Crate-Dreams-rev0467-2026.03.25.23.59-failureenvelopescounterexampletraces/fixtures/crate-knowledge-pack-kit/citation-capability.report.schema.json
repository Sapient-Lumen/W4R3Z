{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "citation-capability.report",
  "type": "object",
  "required": ["crate", "profile", "query_classes"],
  "properties": {
    "crate": {"type": "string"},
    "profile": {"type": "string"},
    "query_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "citation_level"],
        "properties": {
          "class": {"type": "string"},
          "citation_level": {
            "type": "string",
            "enum": [
              "item_anchor",
              "page_anchor",
              "page_only",
              "package_only",
              "manual_review_required",
              "refused"
            ]
          },
          "required_locator_classes": {"type": "array", "items": {"type": "string"}},
          "target_sensitive": {"type": "boolean"},
          "gaps": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "global_limitations": {"type": "array", "items": {"type": "string"}}
  }
}
