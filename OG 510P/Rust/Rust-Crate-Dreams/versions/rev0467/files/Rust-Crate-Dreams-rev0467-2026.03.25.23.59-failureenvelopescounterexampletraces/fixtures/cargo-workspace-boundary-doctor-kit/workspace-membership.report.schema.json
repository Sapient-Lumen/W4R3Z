{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-workspace-boundary-doctor/workspace-membership.report.schema.json",
  "title": "Cargo workspace membership report",
  "type": "object",
  "required": [
    "schema_version",
    "membership"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "membership": {
      "type": "string",
      "enum": [
        "root_package",
        "virtual_workspace_member",
        "auto_member",
        "excluded_package",
        "standalone_package",
        "ambiguous"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
