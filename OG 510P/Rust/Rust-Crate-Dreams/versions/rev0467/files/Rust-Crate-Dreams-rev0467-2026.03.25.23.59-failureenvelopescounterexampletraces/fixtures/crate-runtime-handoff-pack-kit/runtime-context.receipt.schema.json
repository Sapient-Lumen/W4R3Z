{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runtime context receipt",
  "type": "object",
  "required": ["schema_version", "case_id", "evidence_class"],
  "properties": {
    "schema_version": {"type": "string"},
    "case_id": {"type": "string"},
    "evidence_class": {"type": "string"},
    "error_class": {"type": "string"},
    "source_chain_shape": {"type": "array", "items": {"type": "string"}},
    "backtrace_status": {"type": "string"},
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "redaction_class"],
        "properties": {
          "name": {"type": "string"},
          "redaction_class": {"type": "string"},
          "capture_status": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": true
}