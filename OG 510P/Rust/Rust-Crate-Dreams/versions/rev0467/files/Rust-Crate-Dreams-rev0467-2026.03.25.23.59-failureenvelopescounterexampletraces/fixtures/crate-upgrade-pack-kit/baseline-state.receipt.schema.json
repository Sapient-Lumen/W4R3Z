{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeBaselineStateReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "baseline_posture",
    "subjects"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "baseline_posture": {
      "type": "string",
      "enum": [
        "published_release_pair",
        "published_to_local_workspace",
        "local_workspace_only",
        "mixed",
        "unknown"
      ]
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "subject_id",
          "role",
          "origin_kind",
          "identity_posture",
          "cleanliness_posture",
          "mutability_posture"
        ],
        "properties": {
          "subject_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "from_subject",
              "to_subject",
              "capture_workspace",
              "comparison_baseline",
              "fixture_subject",
              "other"
            ]
          },
          "origin_kind": {
            "type": "string",
            "enum": [
              "registry_release",
              "crate_package_extract",
              "git_commit_checkout",
              "workspace_working_tree",
              "local_path_copy",
              "synthetic_fixture",
              "other"
            ]
          },
          "identity_posture": {
            "type": "string",
            "enum": [
              "version_pinned",
              "digest_pinned",
              "rev_pinned",
              "floating_local",
              "mixed",
              "unknown"
            ]
          },
          "cleanliness_posture": {
            "type": "string",
            "enum": [
              "pristine",
              "dirty_local_modifications",
              "partially_migrated",
              "generated_extract",
              "not_applicable",
              "unknown"
            ]
          },
          "mutability_posture": {
            "type": "string",
            "enum": [
              "immutable_snapshot",
              "reconstructible_snapshot",
              "live_mutable_workspace",
              "ephemeral_generated",
              "unknown"
            ]
          },
          "published_identity": {
            "properties": {
              "crate_name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "registry": {
                "type": "string"
              },
              "package_sha256": {
                "type": "string"
              },
              "git_rev": {
                "type": "string"
              },
              "manifest_ref": {
                "type": "string"
              }
            },
            "additionalProperties": true,
            "type": "object"
          },
          "claim_posture": {
            "type": "string",
            "enum": [
              "safe_release_pair_contract",
              "local_only",
              "comparison_only",
              "manual_review_required",
              "unknown"
            ]
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
