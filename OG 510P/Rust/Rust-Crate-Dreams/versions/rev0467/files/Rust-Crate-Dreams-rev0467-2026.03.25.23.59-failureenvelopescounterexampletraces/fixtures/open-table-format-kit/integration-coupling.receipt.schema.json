{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "open-table-format-kit integration-coupling receipt",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "subject",
    "coupling_mode",
    "version_locking",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "scenario": {"type": "string"},
    "subject": {"type": "string"},
    "coupling_mode": {
      "enum": [
        "native_only_no_shared_engine_contract",
        "datafusion_exact_version_match_required",
        "ffi_table_provider_decoupled",
        "language_binding_wrapper",
        "manual_review_required"
      ]
    },
    "version_locking": {
      "enum": [
        "exact_datafusion_match_required",
        "ffi_decoupled",
        "binding_local_only",
        "manual_review_required"
      ]
    },
    "coverage_gaps": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
