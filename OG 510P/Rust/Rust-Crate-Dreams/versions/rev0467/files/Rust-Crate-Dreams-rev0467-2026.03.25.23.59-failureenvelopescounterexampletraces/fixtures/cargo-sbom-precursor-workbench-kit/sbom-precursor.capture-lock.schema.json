{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sbom-precursor.capture-lock",
  "type": "object",
  "required": ["schema_version", "workspace_root", "acquisition_mode", "toolchain", "profile"],
  "properties": {
    "schema_version": {"type": "string"},
    "workspace_root": {"type": "string"},
    "package_scope": {"type": "array", "items": {"type": "string"}},
    "target_scope": {"type": "array", "items": {"type": "string"}},
    "profile": {"type": "string"},
    "toolchain": {"type": "string"},
    "acquisition_mode": {
      "type": "string",
      "enum": ["live_build_capture", "imported_build_dir", "sidecar_scan", "imported_bundle"]
    },
    "artifact_discovery": {
      "type": "string",
      "enum": ["compiler_artifact_stream", "artifact_dir_scan", "mixed", "manual_mapping"]
    },
    "redaction_mode": {"type": "string"}
  },
  "additionalProperties": true
}
