{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-resolve-why/dependency-identity.report.schema.json",
  "title": "Cargo resolve why — dependency identity report",
  "type": "object",
  "required": [
    "schema_version",
    "package_name",
    "dependencies",
    "overall_exactness"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "package_name": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "local_dependency_key",
          "package_name",
          "rename_state",
          "feature_reference_token",
          "exactness"
        ],
        "properties": {
          "local_dependency_key": {
            "type": "string"
          },
          "package_name": {
            "type": "string"
          },
          "rename_state": {
            "type": "string",
            "enum": [
              "unrenamed",
              "renamed_local_key",
              "workspace_inherited_rename_ignored",
              "registry_surface_mismatch",
              "manual_review_required"
            ]
          },
          "feature_reference_token": {
            "type": "string"
          },
          "cargo_metadata_identity": {
            "type": "object",
            "properties": {
              "name_field": {
                "type": "string"
              },
              "rename_field": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "registry_identity": {
            "type": "object",
            "properties": {
              "name_field": {
                "type": "string"
              },
              "package_field": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "publish_alias_field": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "summary": {
            "type": "string"
          },
          "evidence_basis": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cargo_metadata",
                "manual_manifest_scan",
                "registry_index_docs",
                "issue_repro",
                "conservative_inference"
              ]
            }
          },
          "exactness": {
            "type": "string",
            "enum": [
              "exact",
              "conservative",
              "manual_review_required"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "overall_exactness": {
      "type": "string",
      "enum": [
        "exact",
        "conservative",
        "manual_review_required"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
