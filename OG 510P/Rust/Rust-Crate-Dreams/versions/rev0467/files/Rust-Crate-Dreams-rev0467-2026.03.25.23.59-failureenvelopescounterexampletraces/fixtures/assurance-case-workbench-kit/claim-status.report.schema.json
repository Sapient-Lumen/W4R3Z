{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/assurance-case-workbench-kit/claim-status.report.schema.json",
  "title": "Claim Status Report",
  "type": "object",
  "required": ["version", "top_level_status", "claim_statuses"],
  "properties": {
    "version": { "type": "string" },
    "top_level_status": {
      "type": "string",
      "enum": ["satisfied", "partial", "assumed", "manual-review", "stale", "unsupported", "waived", "blocked"]
    },
    "claim_statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "status"],
        "properties": {
          "claim_id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["satisfied", "partial", "assumed", "manual-review", "stale", "unsupported", "waived", "blocked"]
          },
          "blocking_reasons": { "type": "array", "items": { "type": "string" } },
          "supporting_evidence_ids": { "type": "array", "items": { "type": "string" } },
          "next_actions": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "summary": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
