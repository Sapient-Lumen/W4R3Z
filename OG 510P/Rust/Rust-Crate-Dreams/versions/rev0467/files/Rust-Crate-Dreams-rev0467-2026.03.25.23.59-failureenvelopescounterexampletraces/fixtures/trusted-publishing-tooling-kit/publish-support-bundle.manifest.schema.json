{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted Publishing Support Bundle Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_kind",
    "artifacts",
    "redaction_posture"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "bundle_kind": {
      "const": "trusted_publish_support_bundle"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redaction_posture": {
      "enum": [
        "token_redacted_claims_visible",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
