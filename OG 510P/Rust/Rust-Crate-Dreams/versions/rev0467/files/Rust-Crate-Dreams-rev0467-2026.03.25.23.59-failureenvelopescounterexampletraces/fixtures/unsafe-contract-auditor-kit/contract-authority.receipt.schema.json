{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/unsafe-contract-auditor-kit/contract-authority.receipt.schema.json",
  "title": "Contract Authority Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "crate_id",
    "authority_sources",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate_id": {
      "type": "string"
    },
    "authority_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "obligation_id",
          "source_class",
          "status"
        ],
        "properties": {
          "obligation_id": {
            "type": "string"
          },
          "source_class": {
            "type": "string",
            "enum": [
              "docs",
              "contract_attribute",
              "imported_upstream",
              "manual_manifest",
              "std_contract_import",
              "unknown"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "authoritative",
              "partial",
              "missing",
              "manual_review_required"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
