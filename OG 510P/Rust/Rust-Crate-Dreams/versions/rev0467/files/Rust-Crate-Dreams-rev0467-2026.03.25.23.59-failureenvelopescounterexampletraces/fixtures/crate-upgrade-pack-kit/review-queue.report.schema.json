{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeReviewQueueReport",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "readiness_ref",
    "queue_items",
    "next_queue_head"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "readiness_ref": {
      "type": "string"
    },
    "queue_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "class",
          "status",
          "required_before",
          "summary"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "class": {
            "type": "string",
            "enum": [
              "pin_source",
              "arbitration_review",
              "scope_review",
              "followthrough_review",
              "fixup_approval",
              "redaction_review",
              "independent_review",
              "publication_freeze",
              "recipe_run",
              "summary_freeze",
              "manual_check"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "blocked",
              "ready_for_review",
              "waiting_on_external",
              "closed"
            ]
          },
          "required_before": {
            "type": "string",
            "enum": [
              "candidate",
              "freeze_ready"
            ]
          },
          "summary": {
            "type": "string"
          },
          "blocker_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggested_next_action": {
            "type": "string"
          },
          "command_hint": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "next_queue_head": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
