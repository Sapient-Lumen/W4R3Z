{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/evidencebundle-core-kit/publication-route.receipt.schema.json",
  "title": "publication-route.receipt",
  "type": "object",
  "required": [
    "route_kind",
    "status"
  ],
  "properties": {
    "route_kind": {
      "type": "string",
      "enum": [
        "local_only",
        "flat_file_export",
        "oci_subject_referrers",
        "scitt_submission",
        "review_portal",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "prepared",
        "observed",
        "inferred",
        "manual_review_required"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "repository_scope": {
      "type": "string"
    },
    "transparency_or_registry": {
      "type": "string"
    },
    "publication_caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
