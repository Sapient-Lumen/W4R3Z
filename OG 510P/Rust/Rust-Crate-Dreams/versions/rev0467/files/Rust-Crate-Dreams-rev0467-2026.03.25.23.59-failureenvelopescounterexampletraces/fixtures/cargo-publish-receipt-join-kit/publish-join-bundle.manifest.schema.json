{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/fixtures/cargo-publish-receipt-join-kit/publish-join-bundle.manifest.schema.json",
  "title": "publish-join-bundle.manifest",
  "type": "object",
  "required": [
    "subject",
    "bundle_items",
    "required_for_review",
    "share_posture"
  ],
  "properties": {
    "subject": {
      "type": "object",
      "required": [
        "package",
        "version"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "bundle_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "required_for_review": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "share_posture": {
      "type": "string",
      "enum": [
        "internal_only",
        "redacted_external",
        "public_safe"
      ]
    },
    "manual_review_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
