{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/candidate-elimination.receipt.schema.json",
  "title": "Crate pathfinder candidate elimination receipt",
  "type": "object",
  "required": [
    "schema_version",
    "task_lane",
    "candidate",
    "elimination_class",
    "blocking_axes",
    "evidence_refs",
    "reversible",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "task_lane": {
      "type": "string"
    },
    "candidate": {
      "type": "string"
    },
    "elimination_class": {
      "type": "string",
      "enum": [
        "runner_up_not_chosen",
        "blocked_by_hard_constraint",
        "blocked_by_policy",
        "out_of_scope",
        "manual_review_only"
      ]
    },
    "blocking_axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reversible": {
      "type": "boolean"
    },
    "reentry_policy_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "freeze_timebox_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
