{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interop-route.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "source_crate",
    "target_surface",
    "ownership_posture",
    "loss_posture"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "proposal_id": {
      "const": "P-0003"
    },
    "source_crate": {
      "type": "string"
    },
    "target_surface": {
      "type": "string"
    },
    "ownership_posture": {
      "enum": [
        "borrowed_view",
        "zero_copy",
        "copy_required",
        "manual_review_required"
      ]
    },
    "layout_change": {
      "enum": [
        "none",
        "possible",
        "required",
        "manual_review_required"
      ]
    },
    "device_transfer": {
      "enum": [
        "none",
        "possible",
        "required",
        "manual_review_required"
      ]
    },
    "loss_posture": {
      "enum": [
        "none",
        "shape_loss",
        "nullability_loss",
        "dtype_loss",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
