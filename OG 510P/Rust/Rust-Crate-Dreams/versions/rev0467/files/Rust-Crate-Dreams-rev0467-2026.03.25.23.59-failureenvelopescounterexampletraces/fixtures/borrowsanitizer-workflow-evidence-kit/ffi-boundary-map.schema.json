{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FFI Boundary Map",
  "type": "object",
  "required": [
    "schema_version",
    "boundary_id",
    "boundary_kind",
    "rust_surface",
    "foreign_surface"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "boundary_id": {
      "type": "string"
    },
    "boundary_kind": {
      "type": "string",
      "enum": [
        "c-abi",
        "cxx-bridge",
        "sys-crate",
        "raw-pointer-contract",
        "callback",
        "unknown"
      ]
    },
    "rust_surface": {
      "type": "string"
    },
    "foreign_surface": {
      "type": "string"
    },
    "ownership_story": {
      "type": "string"
    },
    "aliasing_risk": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
