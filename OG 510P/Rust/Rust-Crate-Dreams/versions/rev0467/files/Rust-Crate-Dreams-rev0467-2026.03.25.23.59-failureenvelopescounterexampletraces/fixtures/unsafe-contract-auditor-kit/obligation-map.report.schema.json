{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/unsafe-contract-auditor-kit/obligation-map.report.schema.json",
  "title": "Obligation Map Report",
  "type": "object",
  "required": [
    "schema_version",
    "crate_id",
    "unsafe_sites",
    "evidence_strength"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate_id": {
      "type": "string"
    },
    "unsafe_sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "site_id",
          "location",
          "obligation_classes",
          "status"
        ],
        "properties": {
          "site_id": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "obligation_classes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "aliasing",
                "initialization",
                "lifetime",
                "threading",
                "ffi",
                "symbol",
                "abi",
                "callback",
                "other"
              ]
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "covered",
              "partial",
              "manual_review_required",
              "missing"
            ]
          },
          "linked_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_strength": {
      "type": "string",
      "enum": [
        "strong",
        "advisory",
        "weak",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
