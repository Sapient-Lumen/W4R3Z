{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/sanitizer-profile-evidence-kit/runtime-linkage.receipt.schema.json",
  "title": "Runtime Linkage Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "sanitizer",
    "linkage_route",
    "mixed_language",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "sanitizer": { "type": "string" },
    "linkage_route": {
      "type": "string",
      "enum": [
        "rust_default_compiler_runtime",
        "external_clangrt",
        "mixed_language_manual_route",
        "unknown"
      ]
    },
    "mixed_language": { "type": "boolean" },
    "participating_languages": { "type": "array", "items": { "type": "string" } },
    "external_route_reason": { "type": "string" },
    "manual_review_required": { "type": "boolean" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
