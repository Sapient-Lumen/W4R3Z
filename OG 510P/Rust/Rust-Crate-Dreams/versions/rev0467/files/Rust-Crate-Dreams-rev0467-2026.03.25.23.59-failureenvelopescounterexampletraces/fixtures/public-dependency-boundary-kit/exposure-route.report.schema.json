{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exposure-route.report",
  "type": "object",
  "required": [
    "crate",
    "routes"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dependency",
          "route_class",
          "public_item"
        ],
        "properties": {
          "dependency": {
            "type": "string"
          },
          "route_class": {
            "type": "string"
          },
          "public_item": {
            "type": "string"
          },
          "manual_review": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
