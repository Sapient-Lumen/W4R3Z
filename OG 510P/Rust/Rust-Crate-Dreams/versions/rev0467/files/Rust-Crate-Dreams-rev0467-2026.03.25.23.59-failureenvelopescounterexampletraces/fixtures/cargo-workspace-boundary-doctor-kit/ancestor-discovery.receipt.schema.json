{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-workspace-boundary-doctor/ancestor-discovery.receipt.schema.json",
  "title": "Cargo ancestor discovery receipt",
  "type": "object",
  "required": [
    "schema_version",
    "subject_path",
    "invocation_mode",
    "candidates"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "subject_path": { "type": "string" },
    "invocation_mode": {
      "type": "string",
      "enum": [
        "cwd_auto_discovery",
        "manifest_path",
        "manifest_command",
        "single_file_manifest_path",
        "single_file_manifest_command"
      ]
    },
    "workspace_autodiscovery": {
      "type": "string",
      "enum": ["enabled", "disabled", "manual_review_required"]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "exactness"],
        "properties": {
          "path": { "type": "string" },
          "kind": { "type": "string", "enum": ["manifest", "config_file", "home_config", "cargo_home_config"] },
          "exactness": { "type": "string", "enum": ["observed", "inferred", "suspected"] },
          "stop_reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "selected_workspace_root": { "type": "string" }
  },
  "additionalProperties": false
}
