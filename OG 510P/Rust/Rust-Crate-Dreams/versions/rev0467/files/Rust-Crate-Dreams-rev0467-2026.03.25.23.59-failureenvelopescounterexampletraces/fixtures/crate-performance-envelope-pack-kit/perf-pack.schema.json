{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PerfPack",
  "type": "object",
  "required": ["schema_version", "crate", "scenarios"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "metric", "recipe_ref"],
        "properties": {
          "name": {"type": "string"},
          "metric": {"type": "string"},
          "recipe_ref": {"type": "string"},
          "confidence": {"enum": ["ci_reliable", "locally_reliable", "comparative_only", "hardware_sensitive", "allocator_sensitive", "runtime_sensitive", "manual_review_required"]}
        }
      }
    }
  }
}
