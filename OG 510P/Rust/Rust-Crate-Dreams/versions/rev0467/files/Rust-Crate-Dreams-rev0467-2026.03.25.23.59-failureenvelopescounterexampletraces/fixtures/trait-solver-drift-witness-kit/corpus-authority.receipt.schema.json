{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/trait-solver-drift-witness-kit/corpus-authority.receipt.schema.json",
  "title": "Corpus Authority Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "origin",
    "expectation_authority"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "ui_test",
        "trybuild",
        "compiletest_rs",
        "handwritten",
        "generated_witness",
        "reduced_repro"
      ]
    },
    "source_path": {
      "type": "string"
    },
    "expectation_authority": {
      "enum": [
        "pass_fail_only",
        "stderr_exact",
        "stderr_normalized",
        "advisory_only"
      ]
    },
    "transforms_applied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redacted": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
