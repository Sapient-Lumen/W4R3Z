{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/install-root.receipt.schema.json",
  "title": "install-root.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "root_class",
    "path",
    "visibility",
    "collision_policy",
    "cleanup_posture",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "root_class": {
      "type": "string",
      "enum": [
        "workspace_local",
        "shared_user_cache",
        "cargo_home_bin",
        "ephemeral_ci",
        "custom_path"
      ]
    },
    "path": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "not_on_path_by_default",
        "prepended_for_runner_only",
        "globally_visible_on_path",
        "manual_review_required"
      ]
    },
    "collision_policy": {
      "type": "string",
      "enum": [
        "refuse",
        "prefer_workspace_managed",
        "prefer_existing_global",
        "manual_review_required"
      ]
    },
    "cleanup_posture": {
      "type": "string",
      "enum": [
        "persistent",
        "ci_cacheable",
        "ephemeral",
        "manual_review_required"
      ]
    },
    "metadata_tracking": {
      "type": "string",
      "enum": [
        "cargo_install_metadata",
        "workspace_manifest_only",
        "mixed",
        "unknown"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
