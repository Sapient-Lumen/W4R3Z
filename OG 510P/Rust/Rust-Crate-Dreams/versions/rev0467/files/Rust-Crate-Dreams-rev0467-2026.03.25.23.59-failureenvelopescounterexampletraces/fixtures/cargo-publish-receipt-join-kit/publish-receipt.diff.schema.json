{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publish Receipt Diff",
  "type": "object",
  "properties": {
    "package": {"type": "string"},
    "changes": {"type": "array", "items": {"type": "string"}},
    "verdict": {"enum": ["compatible", "review_needed", "mismatch", "manual_review_required"]}
  },
  "required": ["package", "changes", "verdict"]
}
