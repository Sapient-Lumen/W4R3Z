{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/resolution-mode.lock.schema.json",
  "title": "resolution-mode.lock",
  "type": "object",
  "required": ["schema_version", "libraries"],
  "properties": {
    "schema_version": {"type": "string"},
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "final_mode", "decision_inputs", "exactness"],
        "properties": {
          "name": {"type": "string"},
          "final_mode": {"enum": ["system_only", "prefer_system", "auto_fallback_to_vendored", "vendored_only", "override_only", "blocked_by_policy", "manual_review_required"]},
          "selected_backend": {"enum": ["pkg-config", "vcpkg", "vendored", "override", "manual_review_required", null]},
          "decision_inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "key"],
              "properties": {
                "kind": {"enum": ["cargo_feature", "environment", "config_override", "crate_default", "workspace_policy"]},
                "key": {"type": "string"},
                "value": {"type": ["string", "null"]}
              },
              "additionalProperties": true
            }
          },
          "exactness": {"enum": ["exact", "manual_review_required"]},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
