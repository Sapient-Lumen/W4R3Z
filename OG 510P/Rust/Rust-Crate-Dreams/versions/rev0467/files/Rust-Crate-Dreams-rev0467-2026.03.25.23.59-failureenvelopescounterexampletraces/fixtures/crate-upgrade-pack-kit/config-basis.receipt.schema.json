{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeConfigBasisReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "baseline_posture",
    "config_sources",
    "override_surfaces"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "baseline_posture": {
      "type": "string",
      "enum": [
        "repo_portable",
        "repo_local_with_checked_in_config",
        "ci_pinned",
        "user_local_nonportable",
        "mixed",
        "unknown"
      ]
    },
    "config_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_kind",
          "visibility",
          "posture",
          "influence_domains"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "cli_config_arg",
              "workspace_cargo_config",
              "parent_cargo_config",
              "cargo_home_config",
              "environment_variable",
              "rust_toolchain_file",
              "manifest_declared",
              "other"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "repo_checked_in",
              "ci_injected",
              "user_local",
              "ephemeral_cli",
              "unknown"
            ]
          },
          "posture": {
            "type": "string",
            "enum": [
              "explicit_and_reviewed",
              "ambient_but_disclosed",
              "ambient_and_unreviewed",
              "unknown"
            ]
          },
          "influence_domains": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "resolver",
                "registry",
                "compiler_flags",
                "toolchain",
                "target_defaults",
                "network",
                "cache_paths",
                "build_wrapper",
                "output_path",
                "alias",
                "other"
              ]
            },
            "minItems": 1
          },
          "location_ref": {
            "type": "string"
          },
          "key_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "override_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "override_id",
          "override_kind",
          "visibility",
          "subject_refs",
          "outcome_posture"
        ],
        "properties": {
          "override_id": {
            "type": "string"
          },
          "override_kind": {
            "type": "string",
            "enum": [
              "none",
              "patch_crates_io",
              "patch_registry",
              "replace",
              "path_override",
              "source_replacement",
              "alternate_registry",
              "local_path_dependency",
              "git_override",
              "other"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "repo_checked_in",
              "ci_injected",
              "user_local",
              "ephemeral_cli",
              "unknown"
            ]
          },
          "subject_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "outcome_posture": {
            "type": "string",
            "enum": [
              "portable_and_reviewed",
              "repo_local_nonportable",
              "user_local_nonportable",
              "ci_only",
              "unknown"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
