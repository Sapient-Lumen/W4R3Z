{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature-support-bundle.manifest",
  "type": "object",
  "required": [
    "subject",
    "release",
    "required_artifacts"
  ],
  "properties": {
    "subject": { "type": "string" },
    "release": { "type": "string" },
    "required_artifacts": { "type": "array", "items": { "type": "string" } },
    "optional_artifacts": { "type": "array", "items": { "type": "string" } },
    "supported_profiles": { "type": "array", "items": { "type": "string" } },
    "manual_review_zones": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
