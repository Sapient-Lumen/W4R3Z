{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignalCatalogReceipt",
  "type": "object",
  "required": ["schema_version", "crate", "signals_observed"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "signals_observed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"enum": ["span", "event", "metric", "log"]},
          "feature_conditions": {"type": "array", "items": {"type": "string"}},
          "targets": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
