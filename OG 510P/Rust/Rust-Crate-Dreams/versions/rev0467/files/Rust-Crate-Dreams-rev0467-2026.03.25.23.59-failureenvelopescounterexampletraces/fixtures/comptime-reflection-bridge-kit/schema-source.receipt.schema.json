{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "schema-source.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "source_family",
    "capture_mode",
    "authority_class"
  ],
  "properties": {
    "artifact": {"const": "schema-source.receipt"},
    "subject": {"type": "string"},
    "source_family": {
      "enum": [
        "bevy_reflect",
        "facet",
        "future_const_reflection",
        "serde_reflection",
        "mixed",
        "manual_review_required"
      ]
    },
    "capture_mode": {
      "enum": [
        "runtime_registry_export",
        "associated_const_export",
        "compile_time_const_eval_export",
        "serialization_trace_export",
        "mixed",
        "manual_review_required"
      ]
    },
    "authority_class": {
      "enum": [
        "type_shape_primary",
        "type_shape_partial",
        "format_schema_only",
        "adapter_projection",
        "manual_review_required"
      ]
    },
    "registry_population_basis": {
      "enum": [
        "all_required_types_registered",
        "observed_registered_subset",
        "not_applicable",
        "manual_review_required"
      ]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
