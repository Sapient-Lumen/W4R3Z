{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/role-coverage.report.schema.json",
  "title": "Crate pathfinder role coverage report",
  "type": "object",
  "required": ["schema_version", "task", "roles"],
  "properties": {
    "schema_version": {"type": "string"},
    "task": {"type": "string"},
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "coverage_class"],
        "properties": {
          "role": {"type": "string"},
          "coverage_class": {
            "type": "string",
            "enum": [
              "covered_by_single_candidate",
              "covered_with_companion_crates",
              "partially_covered",
              "uncovered",
              "manual_review_required"
            ]
          },
          "candidate_crates": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
