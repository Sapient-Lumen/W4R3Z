{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wasm Component tooling-lineage report",
  "type": "object",
  "required": [
    "build_path_class",
    "status"
  ],
  "properties": {
    "build_path_class": {
      "type": "string",
      "enum": [
        "native_target_build",
        "cargo_component_transitional",
        "native_plus_wac_compose",
        "manual_review_required"
      ]
    },
    "target_family": {
      "type": ["string", "null"],
      "enum": [
        "wasm32-wasip2",
        "wasm32-wasip3",
        "other",
        null
      ]
    },
    "composition_tooling": {
      "type": "array",
      "items": {"type": "string"}
    },
    "wit_dependency_source": {
      "type": ["string", "null"],
      "enum": [
        "wkg",
        "vendored",
        "mixed",
        "unknown",
        null
      ]
    },
    "manual_review_reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "failed", "manual_review_required"]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
