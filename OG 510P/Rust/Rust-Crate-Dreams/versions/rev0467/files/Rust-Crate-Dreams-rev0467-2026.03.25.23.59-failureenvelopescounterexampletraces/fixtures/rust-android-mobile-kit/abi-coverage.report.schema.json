{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rust Android Mobile Kit ABI coverage report",
  "type": "object",
  "required": [
    "declared_abis",
    "built_abis",
    "status"
  ],
  "properties": {
    "declared_abis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "built_abis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "android_api_level": {
      "type": [
        "integer",
        "null"
      ]
    },
    "binding_mode": {
      "type": "string",
      "enum": [
        "jni",
        "uniffi_kotlin",
        "manual_glue",
        "mixed",
        "unknown",
        "manual_review_required"
      ]
    },
    "per_abi": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "abi",
          "status"
        ],
        "properties": {
          "abi": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "built",
              "missing",
              "declared_not_built",
              "manual_review_required"
            ]
          },
          "library_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "debug_sidecars_present": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "failed",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
