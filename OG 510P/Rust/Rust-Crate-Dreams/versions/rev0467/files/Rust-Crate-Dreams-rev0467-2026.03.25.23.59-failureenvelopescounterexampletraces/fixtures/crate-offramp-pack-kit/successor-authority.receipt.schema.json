{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuccessorAuthorityReceipt",
  "type": "object",
  "required": ["crate", "claims"],
  "properties": {
    "crate": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "authority_class", "source", "claim"],
        "properties": {
          "subject": {"type": "string"},
          "authority_class": {
            "enum": [
              "crate_pack_declared",
              "deprecated_note_declared",
              "docs_page_declared",
              "advisory_stopgap_only",
              "yank_pressure_only",
              "third_party_inference",
              "manual_review_required"
            ]
          },
          "source": {"type": "string"},
          "claim": {"type": "string"},
          "long_term_successor": {"type": "boolean"}
        }
      }
    }
  }
}
