{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObservabilitySurfaceReport",
  "type": "object",
  "required": ["schema_version", "crate", "summary"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "summary": {
      "type": "object",
      "properties": {
        "stable_query_surface": {"type": "integer"},
        "supported_but_evolving": {"type": "integer"},
        "debug_only": {"type": "integer"},
        "internal_only": {"type": "integer"},
        "manual_review_required": {"type": "integer"}
      }
    }
  }
}
