{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FixupCapabilityReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "fixes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "origin",
          "applicability",
          "scope",
          "status"
        ],
        "properties": {
          "origin": {
            "enum": [
              "cargo_fix",
              "rustfix",
              "clippy_fix",
              "maintainer_codemod",
              "manual_recipe_only",
              "no_fix_available"
            ]
          },
          "applicability": {
            "enum": [
              "machine_applicable",
              "maybe_incorrect",
              "has_placeholders",
              "unspecified",
              "not_applicable"
            ]
          },
          "scope": {
            "type": "array",
            "items": {
              "enum": [
                "rust_source",
                "cargo_manifest",
                "config_file",
                "docs_snippet",
                "workspace_metadata"
              ]
            }
          },
          "status": {
            "enum": [
              "observed",
              "imported",
              "declared",
              "missing"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "manual_review_remaining": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
