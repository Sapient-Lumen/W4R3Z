{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rustcrate.dreams/fixtures/openapi31-jsonschema-toolchain-kit/bundle-projection.report.schema.json",
  "title": "bundle-projection.report",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "projection_kind",
    "preserves_ref_graph",
    "rewrites_refs",
    "flattening",
    "intended_consumers"
  ],
  "properties": {
    "artifact": {
      "const": "bundle-projection.report"
    },
    "subject": {
      "type": "string"
    },
    "projection_kind": {
      "type": "string",
      "enum": [
        "review-bundle",
        "codegen-projection",
        "docs-projection",
        "gateway-projection"
      ]
    },
    "preserves_ref_graph": {
      "type": "boolean"
    },
    "rewrites_refs": {
      "type": "boolean"
    },
    "flattening": {
      "type": "string",
      "enum": [
        "none",
        "partial",
        "full"
      ]
    },
    "intended_consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "losses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
