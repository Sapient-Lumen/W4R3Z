{
  "profile": "dev",
  "target": "x86_64-pc-windows-msvc",
  "support_posture": "interactive_debugger",
  "capture_sources": ["cargo_profile", "rustc_codegen", "filesystem_scan"],
  "observed_settings": {
    "debug": "full",
    "split_debuginfo": "packed",
    "strip": "none",
    "panic": "unwind"
  },
  "artifacts": [
    {
      "path": "target/debug/app.exe",
      "artifact_kind": "bin",
      "debug_info_mode": "split_sidecar",
      "sidecars": ["target/debug/app.pdb"]
    }
  ],
  "notes": ["NatVis asset embedded for MSVC debugger family"]
}
