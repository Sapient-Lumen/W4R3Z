{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stable-plugin-host-kit/compatibility-witness.receipt.schema.json",
  "title": "compatibility-witness.receipt",
  "type": "object",
  "required": [
    "scenario",
    "witness_class",
    "load_verdict",
    "diagnostics_coverage"
  ],
  "properties": {
    "scenario": {
      "type": "string"
    },
    "witness_class": {
      "type": "string",
      "enum": [
        "abi_stable_load_check",
        "handrolled_symbol_contract",
        "serialized_smoke_test",
        "manual_review_required"
      ]
    },
    "host_target": {
      "type": "string"
    },
    "plugin_target": {
      "type": "string"
    },
    "api_version_range": {
      "type": "string"
    },
    "load_verdict": {
      "type": "string",
      "enum": [
        "loads_cleanly",
        "loads_with_downgrade",
        "rejected_version_mismatch",
        "rejected_layout_mismatch",
        "manual_review_required"
      ]
    },
    "diagnostics_coverage": {
      "type": "string",
      "enum": [
        "load_time_layout_checks",
        "symbol_lookup_only",
        "integration_test_only",
        "manual_review_required"
      ]
    },
    "mismatch_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
