{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/evidencebundle-core-kit/bundle-manifest.schema.json",
  "title": "Evidence Bundle Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "profile",
    "export_class",
    "subjects",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": "evidencebundle-manifest@1"},
    "bundle_id": {"type": "string"},
    "profile": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "export_class": {
      "enum": ["local-unsigned", "shareable-redacted", "publishable-signed"]
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sha256"],
        "properties": {
          "name": {"type": "string"},
          "role": {"type": "string"},
          "sha256": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "sha256", "redaction_state"],
        "properties": {
          "path": {"type": "string"},
          "kind": {
            "enum": ["artifact", "projection", "attestation", "policy", "report", "review"]
          },
          "media_type": {"type": ["string", "null"]},
          "sha256": {"type": "string"},
          "redaction_state": {
            "enum": ["original", "redacted", "placeholder", "derived"]
          },
          "derived_from": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    },
    "signature_lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "entry_paths"],
        "properties": {
          "kind": {"enum": ["dsse", "cose", "sigstore-bundle", "none"]},
          "entry_paths": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
