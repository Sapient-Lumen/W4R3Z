{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/generation-witness.report.schema.json",
  "title": "GenerationWitnessReport",
  "type": "object",
  "required": [
    "subject",
    "generation_scope",
    "generation_identity",
    "witness_basis",
    "confidence"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "generation_scope": {
      "type": "string",
      "enum": [
        "call_route",
        "task",
        "callback",
        "entrypoint",
        "module",
        "dynamic_library",
        "reload_batch",
        "framework_state_bucket"
      ]
    },
    "generation_identity": {
      "type": "object",
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "latest_detoured",
            "load_counter_named",
            "opaque_new_generation",
            "static_build",
            "mixed_or_unknown"
          ]
        },
        "label": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "jump_table",
            "load_counter",
            "dylib_shadow_name",
            "framework_adapter",
            "route_annotation",
            "manual_inference"
          ]
        },
        "stable_across_unchanged_code": {
          "type": "boolean"
        },
        "route_granularity": {
          "type": "string",
          "enum": [
            "global",
            "entrypoint_gated",
            "call_wrapped",
            "dynamic_library",
            "unknown"
          ]
        },
        "applies_from": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "witness_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "manual_review_required"
      ]
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}