{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/assurance-case-workbench-kit/assurance-diff.report.schema.json",
  "title": "Assurance Diff Report",
  "type": "object",
  "required": ["version", "old_pack", "new_pack", "top_level_delta"],
  "properties": {
    "version": { "type": "string" },
    "old_pack": { "type": "string" },
    "new_pack": { "type": "string" },
    "top_level_delta": {
      "type": "object",
      "required": ["old_status", "new_status"],
      "properties": {
        "old_status": { "type": "string" },
        "new_status": { "type": "string" },
        "explanation": { "type": "string" }
      },
      "additionalProperties": true
    },
    "changed_claims": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "evidence_changes": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "blocker_delta": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
