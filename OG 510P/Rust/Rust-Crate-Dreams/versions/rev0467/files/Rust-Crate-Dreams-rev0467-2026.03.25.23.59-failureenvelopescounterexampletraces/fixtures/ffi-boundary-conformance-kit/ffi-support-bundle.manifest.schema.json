{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ffi-support-bundle.manifest",
  "type": "object",
  "required": [
    "bundle_id",
    "subject",
    "artifacts",
    "verdict"
  ],
  "properties": {
    "bundle_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "interface_authority_import": {
          "type": [
            "string",
            "null"
          ]
        },
        "ownership_transfer": {
          "type": [
            "string",
            "null"
          ]
        },
        "unwind_posture": {
          "type": [
            "string",
            "null"
          ]
        },
        "callback_execution": {
          "type": [
            "string",
            "null"
          ]
        },
        "callback_lifecycle": {
          "type": [
            "string",
            "null"
          ]
        },
        "binding_coverage": {
          "type": [
            "string",
            "null"
          ]
        },
        "layout_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "diff_report": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "derivative_parity": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_drift": {
          "type": [
            "string",
            "null"
          ]
        },
        "callback_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "callback_completion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "imported_adjacent_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_zones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "type": "string"
    }
  }
}
