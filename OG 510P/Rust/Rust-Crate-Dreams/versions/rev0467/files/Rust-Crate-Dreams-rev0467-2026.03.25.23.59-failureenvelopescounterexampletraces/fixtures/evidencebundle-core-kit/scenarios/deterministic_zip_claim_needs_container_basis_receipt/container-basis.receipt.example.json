{
  "bundle_profile": "verifybundle@1",
  "archive_format": "zip",
  "entry_order": "sorted_utf8_paths",
  "timestamp_policy": "all_entries_mtime_utc_1970_01_01T00_00_00Z",
  "path_policy": "forward_slash_relative_no_dotdot",
  "compression_policy": "deflate_level_6",
  "digest_algorithms": [
    "sha256"
  ],
  "canonicalization": [
    "json_jcs_for_manifest_and_reports"
  ],
  "reproducibility_posture": "byte_reproducible",
  "notes": "Claim is limited to the packed bundle bytes, not the raw external workspace."
}
