{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "publicir.lock",
  "type": "object",
  "required": ["schema_version", "compiler", "rustc_public", "bridge_mode", "edition", "features"],
  "properties": {
    "schema_version": {"type": "string"},
    "compiler": {
      "type": "object",
      "required": ["channel", "version"],
      "properties": {
        "channel": {"type": "string"},
        "version": {"type": "string"},
        "commit": {"type": "string"}
      }
    },
    "rustc_public": {
      "type": "object",
      "required": ["range"],
      "properties": {
        "range": {"type": "string"},
        "semver_exempt_surfaces_allowed": {"type": "boolean"}
      }
    },
    "bridge_mode": {
      "type": "string",
      "enum": ["public_only", "public_plus_bridge", "mixed_manual_review"]
    },
    "edition": {"type": "string"},
    "features": {"type": "array", "items": {"type": "string"}},
    "redaction": {"type": "string"}
  },
  "additionalProperties": true
}
