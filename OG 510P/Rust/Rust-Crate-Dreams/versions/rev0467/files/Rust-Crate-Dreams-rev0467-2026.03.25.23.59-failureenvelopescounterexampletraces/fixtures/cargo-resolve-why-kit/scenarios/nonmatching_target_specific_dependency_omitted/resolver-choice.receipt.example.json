{
  "schema_version": "0.1.0",
  "command": ["cargo", "metadata", "--format-version=1", "--filter-platform", "x86_64-unknown-linux-gnu"],
  "cargo": {
    "resolver_version": "2"
  },
  "data_sources": ["cargo_metadata", "manual_manifest_scan"],
  "build_equivalence": "close_approximation",
  "selection_scope": {
    "command_kind": "build",
    "workspace_members": ["mycrate"],
    "targets": ["x86_64-unknown-linux-gnu"]
  },
  "assumptions": [
    "target-specific dependency clauses that do not match the selected target are out of scope for the selected build"
  ],
  "unknowns": [],
  "manual_review_required": false,
  "redactions": {
    "private_paths": true,
    "private_package_names": false
  }
}
