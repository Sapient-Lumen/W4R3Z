{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Build Insights — series summary",
  "type": "object",
  "required": ["schema_version", "series_ref", "session_count", "metric_rollups"],
  "properties": {
    "schema_version": {"type": "string"},
    "series_ref": {"type": "string"},
    "session_count": {"type": "integer", "minimum": 1},
    "metric_rollups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "min", "max", "median"],
        "properties": {
          "metric": {"type": "string"},
          "unit": {"type": "string"},
          "min": {"type": "number"},
          "max": {"type": "number"},
          "median": {"type": "number"},
          "latest": {"type": "number"}
        },
        "additionalProperties": true
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
