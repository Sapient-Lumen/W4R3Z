{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdoptionScenarioManifest",
  "type": "object",
  "required": [
    "crate",
    "scenario",
    "class"
  ],
  "properties": {
    "crate": {"type": "string"},
    "scenario": {"type": "string"},
    "class": {
      "enum": [
        "hello_path",
        "authenticated_request",
        "local_persistence",
        "stream_processing",
        "ffi_embedding",
        "no_std_bootstrap",
        "manual_review_required"
      ]
    }
  }
}
