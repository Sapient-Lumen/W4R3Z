{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/decision-pack.report.schema.json",
  "title": "Crate pathfinder decision pack report",
  "type": "object",
  "required": ["schema_version", "task", "ranked_candidates", "verdict"],
  "properties": {
    "schema_version": {"type": "string"},
    "task": {"type": "string"},
    "verdict": {
      "type": "string",
      "enum": ["starter_set_ready", "multiple_plausible_winners", "manual_review_required"]
    },
    "ranked_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "crate", "summary"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "crate": {"type": "string"},
          "summary": {"type": "string"},
          "tradeoffs": {
            "type": "array",
            "items": {"type": "string"}
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "manual_review_required"]
          },
          "starter_set_roles": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "manual_review_reasons": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
