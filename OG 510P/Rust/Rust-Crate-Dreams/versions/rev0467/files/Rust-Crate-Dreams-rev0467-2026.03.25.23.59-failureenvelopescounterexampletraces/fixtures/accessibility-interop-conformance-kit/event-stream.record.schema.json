{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "accessibility event record",
  "type": "object",
  "required": [
    "capture_id",
    "seq",
    "lane",
    "event",
    "node_id"
  ],
  "properties": {
    "capture_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "event": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "cause": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "redacted": {
      "type": "boolean"
    }
  }
}
