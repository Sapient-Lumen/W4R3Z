{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-compile-time-deps-workflow-kit/evidence-source.receipt.schema.json",
  "title": "EvidenceSourceReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "availability",
          "used_for"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "rust_analyzer_config",
              "cargo_argv",
              "cargo_metadata",
              "cargo_config",
              "env",
              "build_analysis_session",
              "cargo_stderr",
              "manual_annotation",
              "workspace_files",
              "unknown"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "observed",
              "imported",
              "inferred",
              "manual"
            ]
          },
          "used_for": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "package_scope",
                "target_coverage",
                "root_policy",
                "sysroot",
                "override_provenance",
                "session_link",
                "parity_verdict",
                "manual_review"
              ]
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
