{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceToolManifest",
  "type": "object",
  "required": ["workspace_root", "tools"],
  "properties": {
    "workspace_root": {"type": "string"},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version_req"],
        "properties": {
          "name": {"type": "string"},
          "version_req": {"type": "string"},
          "binary": {"type": "string"},
          "source_strategy": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "install_root_policy": {"type": "string"}
  },
  "additionalProperties": true
}
