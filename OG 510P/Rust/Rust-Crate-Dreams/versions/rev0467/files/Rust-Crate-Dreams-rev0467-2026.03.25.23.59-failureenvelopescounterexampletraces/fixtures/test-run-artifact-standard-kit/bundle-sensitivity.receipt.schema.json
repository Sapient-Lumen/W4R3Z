{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/test-run-artifact-standard-kit/bundle-sensitivity.receipt.schema.json",
  "title": "bundle-sensitivity.receipt",
  "type": "object",
  "required": ["artifact", "subject", "captures_stdout_stderr", "captures_environment", "redaction_status", "export_posture"],
  "properties": {
    "artifact": {"const": "bundle-sensitivity.receipt"},
    "subject": {"type": "string"},
    "captures_stdout_stderr": {"type": "boolean"},
    "captures_environment": {"type": "boolean"},
    "captures_paths_or_hostnames": {"type": "boolean"},
    "captures_fixture_snippets": {"type": "boolean"},
    "redaction_status": {"enum": ["none", "applied", "unknown", "manual_review_required"]},
    "export_posture": {"enum": ["share_safe", "internal_only", "redaction_required", "manual_review_required"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
