{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FixCampaign",
  "type": "object",
  "required": [
    "workspace_root",
    "mode",
    "lint_scope",
    "target_matrix"
  ],
  "properties": {
    "workspace_root": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "rehearse",
        "apply"
      ]
    },
    "lint_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_matrix": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pass_budget": {
      "type": "integer",
      "minimum": 1
    },
    "review_policy": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
