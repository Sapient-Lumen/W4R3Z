{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Package Receipt",
  "type": "object",
  "properties": {
    "package": {"type": "string"},
    "version": {"type": "string"},
    "local_sha256": {"type": "string"},
    "cargo_dry_run": {"enum": ["ok", "failed", "not_run"]},
    "package_bytes": {"type": "integer"}
  },
  "required": ["package", "version", "local_sha256", "cargo_dry_run", "package_bytes"]
}
