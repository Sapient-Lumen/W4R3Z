{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestEnvironmentRequirements",
  "type": "object",
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {"type": "string"},
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "requirements"],
        "properties": {
          "name": {"type": "string"},
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "none",
                "tempdir_access",
                "env_mutation",
                "loopback_network",
                "docker_daemon",
                "paused_time_runtime",
                "real_external_service",
                "manual_review_required"
              ]
            }
          },
          "platform_scope": {
            "type": "array",
            "items": {"type": "string"}
          },
          "ci_friendly": {"type": "boolean"},
          "parallel_safe": {"type": "boolean"},
          "cleanup_required": {"type": "boolean"},
          "credential_source": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
