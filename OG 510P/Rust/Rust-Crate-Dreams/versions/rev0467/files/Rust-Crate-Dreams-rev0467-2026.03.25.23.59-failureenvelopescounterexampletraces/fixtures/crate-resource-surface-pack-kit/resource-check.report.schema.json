{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceCheckReport",
  "type": "object",
  "required": ["schema_version", "crate", "status", "checks"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "status": {"enum": ["pass", "fail", "manual_review_required"]},
    "checks": {"type": "array", "items": {"type": "string"}}
  }
}