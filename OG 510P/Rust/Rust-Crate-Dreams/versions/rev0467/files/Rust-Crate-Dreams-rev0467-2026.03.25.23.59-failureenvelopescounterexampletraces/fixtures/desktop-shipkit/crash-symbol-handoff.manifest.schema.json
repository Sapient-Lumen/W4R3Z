{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desktop ShipKit crash symbol handoff manifest",
  "type": "object",
  "required": [
    "release",
    "binaries",
    "symbol_strategy",
    "manual_review"
  ],
  "properties": {
    "release": {
      "type": "string"
    },
    "symbol_strategy": {
      "type": "string",
      "enum": [
        "embedded_only",
        "split_sidecars",
        "mixed",
        "missing"
      ]
    },
    "binaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "target",
          "sidecar_status"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "sidecar_status": {
            "type": "string",
            "enum": [
              "present",
              "missing",
              "embedded_only",
              "unknown"
            ]
          },
          "sidecar_path": {
            "type": "string"
          },
          "split_debuginfo": {
            "type": "string"
          },
          "strip": {
            "type": "string"
          }
        }
      }
    },
    "upload_target": {
      "type": "string"
    },
    "manual_review": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
