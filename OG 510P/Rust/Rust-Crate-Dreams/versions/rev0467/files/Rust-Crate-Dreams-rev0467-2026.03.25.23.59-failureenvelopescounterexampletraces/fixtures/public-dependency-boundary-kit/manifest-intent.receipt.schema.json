{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest-intent.receipt",
  "type": "object",
  "required": [
    "crate",
    "toolchain",
    "dependencies"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "toolchain": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "section",
          "declared_public"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "declared_public": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "workspace_inherited": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
