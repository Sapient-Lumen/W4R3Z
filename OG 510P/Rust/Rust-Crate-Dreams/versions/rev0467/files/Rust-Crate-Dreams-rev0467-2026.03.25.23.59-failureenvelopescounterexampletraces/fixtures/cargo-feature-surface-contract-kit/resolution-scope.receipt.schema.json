{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "resolution-scope.receipt",
  "type": "object",
  "required": [
    "subject",
    "resolver_version",
    "command_family",
    "selection",
    "feature_request",
    "verdict"
  ],
  "properties": {
    "subject": { "type": "string" },
    "manifest_root": { "type": "string" },
    "resolver_version": { "type": "string" },
    "command_family": { "type": "string" },
    "selection": {
      "type": "object",
      "required": ["packages"],
      "properties": {
        "packages": { "type": "array", "items": { "type": "string" } },
        "workspace_wide": { "type": "boolean" },
        "target": { "type": ["string", "null"] },
        "host_target_split": { "type": "string" }
      }
    },
    "feature_request": {
      "type": "object",
      "required": ["all_features", "no_default_features"],
      "properties": {
        "features": { "type": "array", "items": { "type": "string" } },
        "all_features": { "type": "boolean" },
        "no_default_features": { "type": "boolean" }
      }
    },
    "verdict": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
