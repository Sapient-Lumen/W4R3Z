{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/trait-solver-drift-witness-kit/obligation-class.report.schema.json",
  "title": "Obligation Class Report",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "obligation_classes",
    "primary_class",
    "drift_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "obligation_classes": {
      "type": "array",
      "items": {
        "enum": [
          "trait_bound",
          "alias_normalization",
          "higher_ranked",
          "coherence",
          "overflow_or_fixpoint",
          "opaque_types",
          "unknown"
        ]
      }
    },
    "primary_class": {
      "enum": [
        "trait_bound",
        "alias_normalization",
        "higher_ranked",
        "coherence",
        "overflow_or_fixpoint",
        "opaque_types",
        "unknown"
      ]
    },
    "drift_class": {
      "enum": [
        "accepted_to_rejected",
        "rejected_to_accepted",
        "overflow_behavior_changed",
        "diagnostic_only",
        "scope_changed",
        "manual_review_required"
      ]
    },
    "evidence_basis": {
      "enum": [
        "compiler_outcome",
        "normalized_diagnostics",
        "manual_classification",
        "mixed"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
