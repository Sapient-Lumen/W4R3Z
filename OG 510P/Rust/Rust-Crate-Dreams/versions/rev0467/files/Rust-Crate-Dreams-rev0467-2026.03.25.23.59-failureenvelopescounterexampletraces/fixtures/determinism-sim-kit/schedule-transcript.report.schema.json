{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/fixtures/determinism-sim-kit/schedule-transcript.report.schema.json",
  "title": "schedule-transcript.report",
  "type": "object",
  "required": ["run_id", "seed", "backend", "transcript_mode", "events", "outcome"],
  "properties": {
    "run_id": {"type": "string"},
    "seed": {"type": ["string", "integer"]},
    "backend": {"type": "string"},
    "schedule_token": {"type": "string"},
    "transcript_mode": {"type": "string", "enum": ["exact", "summarized", "redacted"]},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "kind"],
        "properties": {
          "step": {"type": "integer", "minimum": 0},
          "kind": {"type": "string"},
          "subject": {"type": "string"},
          "details": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "outcome": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["pass", "fail", "manual-review-required"]},
        "failure_site": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
