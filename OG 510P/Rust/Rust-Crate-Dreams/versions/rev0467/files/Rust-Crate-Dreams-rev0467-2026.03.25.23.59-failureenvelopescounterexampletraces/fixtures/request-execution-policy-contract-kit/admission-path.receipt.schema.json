{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "admission-path.receipt",
  "type": "object",
  "required": ["artifact", "subject", "queueing_posture", "rate_limit_scope", "overload_posture"],
  "properties": {
    "artifact": {"const": "admission-path.receipt"},
    "subject": {"type": "string"},
    "queueing_posture": {"enum": ["direct", "buffer_before_limit", "limit_before_buffer", "manual_review_required"]},
    "concurrency_limit": {"type": ["integer", "null"], "minimum": 1},
    "rate_limit_scope": {"enum": ["none", "global", "per_key", "per_connection", "manual_review_required"]},
    "overload_posture": {"enum": ["wait", "buffer", "reject", "shed", "manual_review_required"]},
    "ready_failure_surface": {"enum": ["not_ready_wait", "immediate_error", "resource_exhausted", "manual_review_required"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
