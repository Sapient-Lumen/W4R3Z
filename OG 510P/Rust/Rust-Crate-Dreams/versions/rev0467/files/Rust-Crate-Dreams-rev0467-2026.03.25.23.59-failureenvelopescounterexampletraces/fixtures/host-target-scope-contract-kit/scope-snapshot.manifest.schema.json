{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/scope-snapshot.manifest.schema.json",
  "title": "ScopeSnapshotManifest",
  "type": "object",
  "required": ["schema_version", "command_shape", "config_sources"],
  "properties": {
    "schema_version": {"type": "string"},
    "command_shape": {
      "type": "string",
      "enum": ["no-explicit-target", "explicit-target", "build-target-configured", "rustdoc-like", "manual-review-required"]
    },
    "target_applies_to_host": {"type": ["boolean", "null"]},
    "build_target": {"type": ["string", "null"]},
    "host_triple": {"type": ["string", "null"]},
    "target_triples": {
      "type": "array",
      "items": {"type": "string"}
    },
    "config_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["build", "target", "host", "environment", "cli", "docs-builder", "manual-policy"]
      }
    },
    "artifact_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["build-script", "proc-macro", "target-code", "rustdoc", "manual-review-required"]
      }
    },
    "nightly_features": {
      "type": "array",
      "items": {"type": "string"}
    },
    "caveats": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
