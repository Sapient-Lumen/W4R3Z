{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioPack",
  "type": "object",
  "required": ["schema_version", "crate", "scenarios"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "recipe_ref"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"type": "string"},
          "recipe_ref": {"type": "string"},
          "status": {"enum": ["checked", "manual_review_required", "unsupported"]}
        }
      }
    }
  }
}