{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/evidence-weight.policy.schema.json",
  "title": "Crate pathfinder evidence weight policy",
  "type": "object",
  "required": ["schema_version", "axes"],
  "properties": {
    "schema_version": {"type": "string"},
    "hard_vetoes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "weight_class"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "task_fit",
              "role_coverage",
              "interop_fit",
              "teaching_fit",
              "adoption_signal",
              "health_import",
              "trust_import",
              "migration_friction",
              "uncertainty"
            ]
          },
          "weight_class": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "advisory"]
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
