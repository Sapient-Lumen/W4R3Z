{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeExportPostureReport",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "audience_class",
    "exposure_scope",
    "redaction_status",
    "decision_state",
    "sensitivity_flags",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "audience_class": {
      "type": "string",
      "enum": [
        "maintainer_only",
        "workspace_internal",
        "organization_internal",
        "public_downstream"
      ]
    },
    "exposure_scope": {
      "type": "string",
      "enum": [
        "private_workspace",
        "private_org",
        "public_release_bundle",
        "public_docs_surface",
        "public_registry_adjacent"
      ]
    },
    "redaction_status": {
      "type": "string",
      "enum": [
        "not_needed",
        "required_before_public",
        "applied",
        "manual_review_required"
      ]
    },
    "decision_state": {
      "type": "string",
      "enum": [
        "private_working",
        "private_candidate",
        "public_candidate",
        "public_frozen",
        "withhold_publication"
      ]
    },
    "sensitivity_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "local_paths_present",
          "internal_package_names_present",
          "private_registry_locator_present",
          "private_example_context_present",
          "unreviewed_internal_notes_present"
        ]
      }
    },
    "blocker_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redaction_receipt_ref": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
