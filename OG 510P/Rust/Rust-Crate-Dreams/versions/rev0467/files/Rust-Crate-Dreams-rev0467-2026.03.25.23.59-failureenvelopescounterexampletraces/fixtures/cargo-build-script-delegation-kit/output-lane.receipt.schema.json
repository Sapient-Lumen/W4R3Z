{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "output-lane.receipt",
  "type": "object",
  "required": [
    "subject",
    "unit",
    "out_dir",
    "exports"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "out_dir": {
      "type": "string"
    },
    "exports": {
      "type": "object",
      "properties": {
        "metadata_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "staged_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
