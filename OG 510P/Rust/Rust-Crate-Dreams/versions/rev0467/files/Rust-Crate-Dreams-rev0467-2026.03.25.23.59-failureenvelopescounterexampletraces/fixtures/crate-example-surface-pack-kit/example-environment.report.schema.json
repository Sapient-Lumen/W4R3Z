{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExampleEnvironmentReport",
  "type": "object",
  "required": [
    "example",
    "environment_class"
  ],
  "properties": {
    "example": {"type": "string"},
    "environment_class": {
      "enum": [
        "pure_local",
        "temp_files_only",
        "network_loopback",
        "external_network",
        "credentialed_service",
        "board_or_device",
        "browser_host",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
