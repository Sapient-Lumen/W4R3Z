{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/dependency-lifecycle-transition-kit/criticality-boundary.report.schema.json",
  "title": "CriticalityBoundaryReport",
  "type": "object",
  "required": ["verdict", "restricted_packages", "findings"],
  "properties": {
    "verdict": {"type": "string"},
    "restricted_packages": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dependency", "consumer", "status"],
        "properties": {
          "dependency": {"type": "string"},
          "consumer": {"type": "string"},
          "status": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
