{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/localfirst-sync-kit/history-retention.receipt.schema.json",
  "title": "history-retention.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "durable_state_mode",
    "branching_support",
    "comparison_support",
    "compaction_effect",
    "support_bundle_history_export"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "durable_state_mode": {
      "enum": [
        "full_history",
        "shallow_snapshot",
        "update_range_only",
        "current_state_only",
        "manual_review_required"
      ]
    },
    "branching_support": {
      "enum": [
        "native_branch_checkout",
        "historical_read_only",
        "none",
        "manual_review_required"
      ]
    },
    "comparison_support": {
      "enum": [
        "diff_against_history",
        "frontier_only",
        "manual_review_required"
      ]
    },
    "compaction_effect": {
      "enum": [
        "history_retained",
        "history_truncated_before_frontier",
        "snapshot_rebased",
        "manual_review_required"
      ]
    },
    "support_bundle_history_export": {
      "enum": [
        "redacted_summary",
        "range_sample_only",
        "full_history_opt_in",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
