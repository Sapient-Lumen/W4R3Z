{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TriageSequenceManifest",
  "type": "object",
  "required": [
    "symptom",
    "steps"
  ],
  "properties": {
    "symptom": {"type": "string"},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "action_kind"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "action_kind": {
            "enum": [
              "run_self_check",
              "inspect_signal",
              "inspect_warning",
              "compare_config",
              "capture_bundle",
              "manual_review_required"
            ]
          },
          "references": {
            "type": "array",
            "items": {"type": "string"}
          },
          "expected_outcome": {"type": "string"}
        }
      }
    }
  }
}
