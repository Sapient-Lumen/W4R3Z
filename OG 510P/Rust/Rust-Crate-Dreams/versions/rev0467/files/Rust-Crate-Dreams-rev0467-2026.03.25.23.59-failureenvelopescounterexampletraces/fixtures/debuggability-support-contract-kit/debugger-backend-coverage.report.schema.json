{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/fixtures/debuggability-support-contract-kit/debugger-backend-coverage.report.schema.json",
  "title": "debugger-backend-coverage.report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "capture_basis",
    "backend_matrix",
    "portable_claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crate", "artifact_profile", "target_triple"],
      "properties": {
        "crate": {"type": "string", "minLength": 1},
        "artifact_profile": {"type": "string", "minLength": 1},
        "target_triple": {"type": "string", "minLength": 1}
      }
    },
    "capture_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_refs", "evidence_scope"],
      "properties": {
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_scope": {
          "type": "string",
          "enum": [
            "direct_debugger_sessions",
            "artifact_plus_policy_review",
            "artifact_inference_only",
            "declared_only",
            "mixed"
          ]
        }
      }
    },
    "backend_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "debugger_family",
          "operating_system",
          "version_scope",
          "evidence_class",
          "capabilities",
          "claim_ceiling"
        ],
        "properties": {
          "debugger_family": {
            "type": "string",
            "enum": ["gdb", "lldb", "cdb", "windbg", "visual_studio", "other"]
          },
          "operating_system": {
            "type": "string",
            "enum": ["linux", "macos", "windows", "other"]
          },
          "version_scope": {"type": "string", "minLength": 1},
          "evidence_class": {
            "type": "string",
            "enum": [
              "direct_session_observed",
              "artifact_plus_asset_inference",
              "artifact_inference_only",
              "declared_only",
              "unsupported",
              "manual_review_required"
            ]
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol_loading",
              "type_visualizers",
              "async_debugging",
              "expression_evaluation"
            ],
            "properties": {
              "symbol_loading": {"$ref": "#/$defs/capabilityStatus"},
              "type_visualizers": {"$ref": "#/$defs/capabilityStatus"},
              "async_debugging": {"$ref": "#/$defs/capabilityStatus"},
              "expression_evaluation": {"$ref": "#/$defs/capabilityStatus"}
            }
          },
          "claim_ceiling": {
            "type": "string",
            "enum": [
              "interactive_debugger",
              "backtrace_only",
              "crash_symbolication_only",
              "manual_review_required",
              "unsupported"
            ]
          },
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "portable_claim_ceiling": {
      "type": "string",
      "enum": [
        "interactive_debugger",
        "backtrace_only",
        "crash_symbolication_only",
        "manual_review_required",
        "unsupported"
      ]
    },
    "manual_review_zones": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "capabilityStatus": {
      "type": "string",
      "enum": [
        "observed",
        "artifact_inferred_only",
        "declared_asset_only",
        "not_reviewed",
        "unsupported",
        "manual_review_required"
      ]
    }
  }
}
