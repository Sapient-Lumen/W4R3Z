{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/dependency-lifecycle-transition-kit/imported-signal.receipt.schema.json",
  "title": "ImportedSignalReceipt",
  "type": "object",
  "required": [
    "dependency",
    "signals"
  ],
  "properties": {
    "dependency": {
      "type": "string"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "signal_kind",
          "decision_weight"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "signal_kind": {
            "type": "string"
          },
          "imported_at": {
            "type": "string"
          },
          "decision_weight": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
