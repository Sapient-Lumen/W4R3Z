{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/reprobuildbundle/diff-summary.schema.json",
  "title": "Reprobuild Diff Summary",
  "type": "object",
  "required": ["schema_version", "comparator", "top_causes"],
  "properties": {
    "schema_version": {"const": "diff-summary@1"},
    "comparator": {"type": "string"},
    "top_causes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "summary"],
        "properties": {
          "class": {
            "enum": [
              "timestamp",
              "path-prefix",
              "archive-order",
              "compression",
              "build-id",
              "build-script-output",
              "unknown"
            ]
          },
          "summary": {"type": "string"},
          "affected_artifacts": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    },
    "likely_fix": {"type": ["string", "null"]},
    "raw_report_refs": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
