{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-build-insights/comparison-window.receipt.schema.json",
  "title": "comparison-window.receipt",
  "type": "object",
  "required": [
    "window_id",
    "audience",
    "selection_basis",
    "baseline_session_ids",
    "head_session_ids",
    "excluded_session_ids",
    "notes"
  ],
  "properties": {
    "window_id": {"type": "string"},
    "audience": {
      "type": "string",
      "enum": ["pr_review", "release_review", "rolling_branch_trend", "local_experiment", "manual_review_required"]
    },
    "selection_basis": {
      "type": "string",
      "enum": [
        "pr_head_vs_last_green_base_branch",
        "previous_release_vs_candidate",
        "rolling_branch_window",
        "same_worktree_before_after",
        "manual_review_required"
      ]
    },
    "baseline_session_ids": {"type": "array", "items": {"type": "string"}},
    "head_session_ids": {"type": "array", "items": {"type": "string"}},
    "excluded_session_ids": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
