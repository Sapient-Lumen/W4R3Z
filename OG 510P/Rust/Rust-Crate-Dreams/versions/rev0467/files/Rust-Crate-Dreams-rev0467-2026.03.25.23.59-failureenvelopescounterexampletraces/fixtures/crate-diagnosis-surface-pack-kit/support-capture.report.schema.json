{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SupportCaptureReport",
  "type": "object",
  "required": [
    "crate",
    "capture_classes"
  ],
  "properties": {
    "crate": {"type": "string"},
    "capture_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capture_class", "sensitivity", "requires_opt_in"],
        "properties": {
          "capture_class": {
            "enum": [
              "logs",
              "traces",
              "metrics",
              "runtime_snapshot",
              "config_summary",
              "version_fingerprint",
              "manual_review_required"
            ]
          },
          "sensitivity": {
            "enum": [
              "low",
              "moderate",
              "secrets_possible",
              "manual_review_required"
            ]
          },
          "requires_opt_in": {"type": "boolean"},
          "redaction_profile": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
