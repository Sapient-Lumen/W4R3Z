{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/doctest-runtool-profile-kit/execution-basis.receipt.schema.json",
  "title": "ExecutionBasisReceipt",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "support_class", "compile_directory_basis", "run_directory_basis"],
        "properties": {
          "target": {"type": "string"},
          "support_class": {
            "type": "string",
            "enum": [
              "host_run",
              "target_run_via_runner",
              "compile_only",
              "ignored_by_target_policy",
              "manual_review_required"
            ]
          },
          "compile_directory_basis": {"type": "string"},
          "run_directory_basis": {"type": "string"},
          "ignore_annotations": {"type": "array", "items": {"type": "string"}},
          "basis_imports": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}},
          "summary": {"type": "string"}
        }
      }
    }
  }
}
