{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "symbolization-fidelity.report",
  "type": "object",
  "required": ["backend", "fidelity_class"],
  "properties": {
    "backend": { "type": "string" },
    "fidelity_class": {
      "type": "string",
      "enum": [
        "full_symbols",
        "trimmed_symbols",
        "partial_symbols",
        "allocator_stats_only",
        "stripped_binary",
        "manual_review_required"
      ]
    },
    "frame_pointer_assumption": { "type": "string" },
    "debug_info_present": { "type": "boolean" },
    "redaction_applied": { "type": "boolean" },
    "known_blind_spots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
