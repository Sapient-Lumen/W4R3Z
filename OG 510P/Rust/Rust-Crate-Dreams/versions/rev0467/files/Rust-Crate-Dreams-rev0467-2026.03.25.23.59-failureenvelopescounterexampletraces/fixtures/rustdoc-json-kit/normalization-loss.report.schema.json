{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/normalization-loss.report.schema.json",
  "title": "normalization-loss.report",
  "type": "object",
  "required": [
    "schema_version",
    "loss_classes",
    "overall_support_class",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "loss_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cross_crate_reference_unresolved",
          "manifest_fact_missing",
          "raw_field_omitted",
          "relation_downgraded",
          "attribute_downgraded",
          "none"
        ]
      }
    },
    "affected_query_classes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "status"],
        "properties": {
          "class": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["preserved", "downgraded", "omitted", "unresolved", "unknown"]
          },
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    },
    "overall_support_class": {
      "type": "string",
      "enum": ["lossless_for_declared_queries", "usable_with_caveats", "manual_review_required", "unsupported"]
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": true
}
