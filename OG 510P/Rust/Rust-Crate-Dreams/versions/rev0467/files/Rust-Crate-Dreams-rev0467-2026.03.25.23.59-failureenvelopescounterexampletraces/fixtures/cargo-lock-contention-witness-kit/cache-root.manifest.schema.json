{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-lock-contention/cache-root.manifest.schema.json",
  "title": "Cargo lock contention — cache root manifest",
  "type": "object",
  "required": ["schema_version", "roots"],
  "properties": {
    "schema_version": {"type": "string"},
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["root_id", "root_kind", "path_policy", "observed_from"],
        "properties": {
          "root_id": {"type": "string"},
          "root_kind": {"type": "string", "enum": ["target_dir", "build_dir", "package_cache", "index_cache", "unknown_root"]},
          "workspace_role": {"type": "string"},
          "path_policy": {"type": "string", "enum": ["literal", "redacted", "relative", "omitted"]},
          "path_hint": {"type": "string"},
          "observed_from": {
            "type": "array",
            "items": {"type": "string", "enum": ["cargo_config", "tool_config", "command_line", "env", "process_sample", "manual_annotation"]}
          },
          "shared_across_roles": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
