{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stable-plugin-host-kit/plugin-bundle.manifest.schema.json",
  "title": "plugin-bundle.manifest",
  "type": "object",
  "required": [
    "bundle_version",
    "plugin_name",
    "receipts"
  ],
  "properties": {
    "bundle_version": {
      "type": "string"
    },
    "plugin_name": {
      "type": "string"
    },
    "platform_scope": {
      "type": "string"
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
