{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "public-dependency-support-bundle.manifest",
  "type": "object",
  "required": [
    "crate",
    "artifacts"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_required": {
      "type": "boolean"
    }
  }
}
