{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/debuggability-support-contract-kit/artifact-handoff.manifest.schema.json",
  "title": "Debuggability artifact handoff manifest",
  "type": "object",
  "required": ["version", "artifacts"],
  "properties": {
    "version": {"type": "string"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["logical_name", "kind", "canonical_path", "handoff_status"],
        "properties": {
          "logical_name": {"type": "string"},
          "kind": {
            "type": "string",
            "enum": ["primary_binary", "primary_library", "pdb", "dsym", "dwo", "dwp", "visualizer_asset", "other"]
          },
          "canonical_path": {"type": "string"},
          "copied_to": {
            "type": "array",
            "items": {"type": "string"}
          },
          "retention_class": {
            "type": "string",
            "enum": ["required_for_promised_support", "recommended", "optional", "manual_review_required"]
          },
          "handoff_status": {
            "type": "string",
            "enum": ["verified_present", "declared_only", "missing", "not_applicable", "manual_review_required"]
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
