{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reexport Lineage Report",
  "type": "object",
  "required": [
    "schema_version",
    "exported_path",
    "defining_path",
    "lineage_steps"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "exported_path": {
      "type": "string"
    },
    "defining_path": {
      "type": "string"
    },
    "lineage_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step_kind",
          "path"
        ],
        "properties": {
          "step_kind": {
            "enum": [
              "direct_definition",
              "pub_use",
              "cfg_inherited",
              "cfg_overridden",
              "manual_review_required"
            ]
          },
          "path": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "effective_availability_class": {
      "type": "string"
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
