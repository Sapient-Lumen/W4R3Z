{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "precursor-ingest.report",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"type": "string"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_hint", "precursor_path", "discovery_source", "association_status"],
        "properties": {
          "artifact_hint": {"type": "string"},
          "precursor_path": {"type": "string"},
          "discovery_source": {
            "type": "string",
            "enum": ["cargo_sbom_path_env", "filename_scan", "imported_bundle", "manual"]
          },
          "association_status": {
            "type": "string",
            "enum": ["matched_exact", "matched_conservatively", "ambiguous", "unmatched"]
          },
          "primary_artifact": {"type": ["string", "null"]},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "additionalProperties": true
}
