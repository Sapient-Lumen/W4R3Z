{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sync State Report",
  "type": "object",
  "required": ["schema_version", "repo_id", "document_id", "replica_id", "state_summary"],
  "properties": {
    "schema_version": {"type": "string"},
    "repo_id": {"type": "string"},
    "document_id": {"type": "string"},
    "replica_id": {"type": "string"},
    "captured_at": {"type": "string"},
    "state_summary": {
      "type": "object",
      "required": ["local_heads", "known_peer_heads", "snapshot_lineage"],
      "properties": {
        "local_heads": {"type": "array", "items": {"type": "string"}},
        "known_peer_heads": {"type": "array", "items": {"type": "string"}},
        "snapshot_lineage": {"type": "array", "items": {"type": "string"}},
        "compaction_checkpoint": {"type": "string"},
        "update_backlog_count": {"type": "integer"}
      }
    },
    "comparability": {
      "type": "object",
      "properties": {
        "comparable_to_prior": {"type": "boolean"},
        "caveats": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
