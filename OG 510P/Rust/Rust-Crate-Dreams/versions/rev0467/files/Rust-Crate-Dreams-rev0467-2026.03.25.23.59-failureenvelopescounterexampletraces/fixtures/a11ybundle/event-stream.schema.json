{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/a11ylab/event-stream.schema.json",
  "title": "Accessibility event stream",
  "type": "object",
  "required": ["stream_version", "events"],
  "properties": {
    "stream_version": {"type": "string"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seq", "kind", "node_ref"],
        "properties": {
          "seq": {"type": "integer", "minimum": 0},
          "kind": {"type": "string", "enum": ["focus", "selection", "value-change", "live-region", "show", "hide"]},
          "node_ref": {"type": "string"},
          "payload": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
