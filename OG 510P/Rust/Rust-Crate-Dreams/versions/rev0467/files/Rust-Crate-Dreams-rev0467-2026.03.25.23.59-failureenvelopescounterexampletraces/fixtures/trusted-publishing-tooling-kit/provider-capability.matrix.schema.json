{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted Publishing Provider Capability Matrix",
  "type": "object",
  "required": [
    "schema_version",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "host_scope",
          "issuer_scope",
          "status"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "host_scope": {
            "type": "string"
          },
          "issuer_scope": {
            "type": "string"
          },
          "status": {
            "enum": [
              "supported",
              "partial",
              "blocked",
              "unsupported",
              "manual_review_required"
            ]
          },
          "supports_tp_only": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
