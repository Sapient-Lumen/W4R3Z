{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate Normalization Report",
  "type": "object",
  "required": [
    "schema_version",
    "item_path",
    "normalization_kind"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "item_path": {
      "type": "string"
    },
    "raw_expressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "origin_kind",
          "expression"
        ],
        "properties": {
          "origin_kind": {
            "enum": [
              "cfg",
              "doc_cfg",
              "doc_auto_cfg",
              "cfg_doc",
              "docsrs_cfg",
              "build_script_custom_cfg",
              "manual_review_required"
            ]
          },
          "expression": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "displayed_gate": {
      "type": "string"
    },
    "normalization_kind": {
      "enum": [
        "identity",
        "auto_cfg_simplified",
        "doc_cfg_override",
        "cfg_doc_added_visibility",
        "docsrs_overlay",
        "manual_review_required"
      ]
    },
    "downstream_use_equivalent": {
      "type": "boolean"
    },
    "cautions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
