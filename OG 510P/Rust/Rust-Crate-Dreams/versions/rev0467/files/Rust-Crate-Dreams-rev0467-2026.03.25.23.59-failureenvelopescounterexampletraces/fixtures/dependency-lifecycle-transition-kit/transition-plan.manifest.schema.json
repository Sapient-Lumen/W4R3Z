{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/dependency-lifecycle-transition-kit/transition-plan.manifest.schema.json",
  "title": "TransitionPlanManifest",
  "type": "object",
  "required": [
    "dependency",
    "current_lane",
    "target_lane",
    "seam_ref",
    "owner_class",
    "exit_criteria",
    "blockers"
  ],
  "properties": {
    "dependency": {
      "type": "string"
    },
    "current_lane": {
      "type": "string"
    },
    "target_lane": {
      "type": "string"
    },
    "seam_ref": {
      "type": "string"
    },
    "owner_class": {
      "type": "string"
    },
    "review_by": {
      "type": "string"
    },
    "exit_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
