{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Availability Class Policy",
  "type": "object",
  "required": ["schema_version", "availability_classes"],
  "properties": {
    "schema_version": {"type": "string"},
    "availability_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "summary"],
        "properties": {
          "name": {
            "enum": [
              "stable_public",
              "requires_feature",
              "requires_target",
              "requires_feature_and_target",
              "docs_visible_only",
              "docsrs_assumed_only",
              "inferred_only",
              "hidden_internal",
              "manual_review_required",
              "unknown"
            ]
          },
          "summary": {"type": "string"},
          "semver_relevant": {"type": "boolean"},
          "minimum_fidelity": {"type": "string"},
          "release_note_required_on_change": {"type": "boolean"}
        }
      }
    }
  },
  "additionalProperties": false
}
