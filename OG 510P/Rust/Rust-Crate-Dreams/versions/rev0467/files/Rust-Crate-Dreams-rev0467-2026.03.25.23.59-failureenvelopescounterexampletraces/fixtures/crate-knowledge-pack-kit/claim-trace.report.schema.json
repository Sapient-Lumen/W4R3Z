{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claim-trace.report",
  "type": "object",
  "required": [
    "crate",
    "profile",
    "claims"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text",
          "authority",
          "exactness",
          "excerpt_ids",
          "source_material_ids",
          "manual_review_required"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          },
          "exactness": {
            "type": "string"
          },
          "excerpt_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_material_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manual_review_required": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "untraced_claim_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
