{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/secrets-kit/export-posture.report.schema.json",
  "title": "export-posture.report",
  "type": "object",
  "required": [
    "subject",
    "profile",
    "debug_posture",
    "serde_posture",
    "explicit_reveal_helpers",
    "judgment"
  ],
  "properties": {
    "subject": {"type": "string"},
    "profile": {"type": "string"},
    "debug_posture": {
      "type": "string",
      "enum": ["redacted", "denied", "manual_review_required", "unknown"]
    },
    "display_posture": {
      "type": "string",
      "enum": ["redacted", "denied", "manual_review_required", "unknown"]
    },
    "serde_posture": {
      "type": "string",
      "enum": ["disabled_by_default", "opt_in_enabled", "custom_serializer", "manual_review_required", "unknown"]
    },
    "explicit_reveal_helpers": {"type": "boolean"},
    "clone_posture": {
      "type": "string",
      "enum": ["denied", "best_effort_prevented", "allowed", "unknown"]
    },
    "judgment": {
      "type": "string",
      "enum": ["default_export_safe", "export_surface_widened", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
