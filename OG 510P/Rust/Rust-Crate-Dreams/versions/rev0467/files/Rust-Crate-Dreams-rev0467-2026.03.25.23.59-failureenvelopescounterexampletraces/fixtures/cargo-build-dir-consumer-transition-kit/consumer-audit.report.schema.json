{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-build-dir-consumer-transition/consumer-audit.report.schema.json",
  "title": "Cargo consumer audit report",
  "type": "object",
  "required": ["schema_version", "findings"],
  "properties": {
    "schema_version": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["consumer_ref", "risk_class", "evidence_strength", "verdict"],
        "properties": {
          "consumer_ref": {"type": "string"},
          "risk_class": {"type": "string", "enum": ["deps_scrape", "build_script_path_scrape", "profile_name_assumption", "final_artifact_confusion", "dep_info_scrape", "unknown_layout_dependency"]},
          "evidence_strength": {"type": "string", "enum": ["observed", "strong_inference", "weak_inference", "manual_annotation"]},
          "verdict": {"type": "string", "enum": ["safe_enough", "adapter_available", "manual_review_required", "blocked_on_upstream"]},
          "supporting_facts": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
