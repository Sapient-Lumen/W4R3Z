{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-workspace-boundary-doctor/config-probe.report.schema.json",
  "title": "Cargo config probe report",
  "type": "object",
  "required": [
    "schema_version",
    "effective_sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "effective_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ignored_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "path_policy": {
      "type": "string",
      "enum": [
        "literal",
        "redacted",
        "relative"
      ]
    }
  },
  "additionalProperties": false
}
