{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "identity-fidelity.report",
  "type": "object",
  "required": [
    "crate",
    "profile",
    "cases"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case",
          "witness_ids",
          "fidelity_level",
          "safe_reuse_scope"
        ],
        "properties": {
          "case": {
            "type": "string"
          },
          "witness_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fidelity_level": {
            "type": "string",
            "enum": [
              "exact_same_version_target",
              "exact_same_version_path_kind",
              "cross_version_rechecked",
              "approximate",
              "manual_review_required"
            ]
          },
          "safe_reuse_scope": {
            "type": "string",
            "enum": [
              "same_blob_only",
              "same_version_target",
              "same_version",
              "cross_version_with_recheck",
              "none"
            ]
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "global_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}