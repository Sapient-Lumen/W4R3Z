{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "comparison-basis.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "surface_family",
    "old_input",
    "new_input",
    "basis_kind",
    "normalization_posture",
    "history_scope",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "surface_family": {
      "type": "string",
      "enum": [
        "openapi",
        "json_schema",
        "protobuf",
        "registry_subject",
        "mixed",
        "manual_review_required"
      ]
    },
    "old_input": {"type": "string"},
    "new_input": {"type": "string"},
    "basis_kind": {
      "type": "string",
      "enum": [
        "checked_in_artifacts",
        "generated_artifacts",
        "registry_subject_versions",
        "imported_engine_output",
        "mixed_basis",
        "manual_review_required"
      ]
    },
    "normalization_posture": {
      "type": "string",
      "enum": [
        "normalized",
        "not_normalized",
        "mixed_or_unknown",
        "manual_review_required"
      ]
    },
    "history_scope": {
      "type": "string",
      "enum": [
        "pairwise_latest_only",
        "transitive_all_history",
        "fixed_baseline_pair",
        "mixed_or_unknown",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
