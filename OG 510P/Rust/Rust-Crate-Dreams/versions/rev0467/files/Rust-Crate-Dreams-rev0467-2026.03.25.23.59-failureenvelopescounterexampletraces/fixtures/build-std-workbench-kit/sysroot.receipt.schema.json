{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build-Std Workbench receipt",
  "type": "object",
  "required": [
    "schema_version",
    "observed_via",
    "status",
    "unstable_features"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "observed_via": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "manual_review_required"
      ]
    },
    "unstable_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "produced_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
