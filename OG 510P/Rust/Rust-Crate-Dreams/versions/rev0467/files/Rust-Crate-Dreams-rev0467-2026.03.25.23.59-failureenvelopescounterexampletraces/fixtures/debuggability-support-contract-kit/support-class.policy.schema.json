{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/debuggability-support-contract-kit/support-class.policy.schema.json",
  "title": "Debuggability support-class policy",
  "type": "object",
  "required": ["version", "classes"],
  "properties": {
    "version": {"type": "string"},
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "minimum_evidence", "human_meaning"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "interactive_debugger",
              "backtrace_only",
              "crash_symbolication_only",
              "internal_only",
              "manual_review_required",
              "unknown"
            ]
          },
          "minimum_evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "human_meaning": {"type": "string"},
          "disqualifiers": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
