{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TargetBatchPlan",
  "type": "object",
  "required": [
    "campaign_id",
    "passes"
  ],
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "passes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pass_id",
          "targets"
        ],
        "properties": {
          "pass_id": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
