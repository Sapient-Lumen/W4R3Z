{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Performance Noise Class Report",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "noise_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "noise_class": {
      "type": "string",
      "enum": [
        "ci_reliable",
        "locally_reliable",
        "comparative_only",
        "hardware_sensitive",
        "allocator_sensitive",
        "runtime_sensitive",
        "manual_review_required"
      ]
    },
    "authoritative_metric": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
