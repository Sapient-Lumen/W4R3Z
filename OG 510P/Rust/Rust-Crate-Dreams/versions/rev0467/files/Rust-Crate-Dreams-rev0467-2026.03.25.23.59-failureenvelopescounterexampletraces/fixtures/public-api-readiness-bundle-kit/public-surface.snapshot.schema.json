{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/public-api-readiness/public-surface.snapshot.schema.json",
  "title": "Public surface snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "deprecated": {
            "type": "boolean"
          },
          "reexported_from": {
            "type": "string"
          },
          "evidence_origin": {
            "type": "string",
            "enum": [
              "measured",
              "imported",
              "inferred"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "manual_review_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
