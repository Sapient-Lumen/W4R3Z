{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/async-replay-debugger-kit/time-basis.receipt.schema.json",
  "title": "time-basis.receipt",
  "type": "object",
  "required": [
    "scenario",
    "clock_class",
    "advancement_rule",
    "scope"
  ],
  "properties": {
    "scenario": {
      "type": "string"
    },
    "clock_class": {
      "type": "string",
      "enum": [
        "wall_clock_live",
        "tokio_paused_time",
        "synthetic_timeline",
        "imported_timestamps",
        "manual_review_required"
      ]
    },
    "advancement_rule": {
      "type": "string",
      "enum": [
        "runtime_auto_advance",
        "recorded_delta_playback",
        "external_clock",
        "manual_step",
        "manual_review_required"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "current_thread_only",
        "runtime_specific",
        "effect_slice_only",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
