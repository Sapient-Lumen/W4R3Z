{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "finding-snapshot.report",
  "type": "object",
  "required": ["schema_version", "captured_at", "findings"],
  "properties": {
    "schema_version": {"type": "string"},
    "captured_at": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_key", "package_id", "status"],
        "properties": {
          "finding_key": {"type": "string"},
          "package_id": {"type": "string"},
          "diagnostic_class": {"type": "string"},
          "message_summary": {"type": "string"},
          "report_id": {"type": ["string", "null"]},
          "status": {
            "type": "string",
            "enum": ["new", "persisting", "resolved", "reclassified_by_toolchain"]
          },
          "observed_via": {
            "type": "string",
            "enum": ["live_build", "report_recall", "cached_latest"]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
