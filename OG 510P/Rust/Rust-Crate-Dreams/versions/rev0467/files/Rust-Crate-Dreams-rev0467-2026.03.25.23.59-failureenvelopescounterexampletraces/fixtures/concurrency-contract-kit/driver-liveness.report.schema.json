{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/driver-liveness.report.schema.json",
  "title": "driver-liveness.report",
  "type": "object",
  "required": [
    "schema_version",
    "surface",
    "liveness_class"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "surface": {"type": "string"},
    "liveness_class": {"type": "string"},
    "drive_requirements": {
      "type": "array",
      "items": {"type": "string"}
    },
    "non_driving_handles": {
      "type": "array",
      "items": {"type": "string"}
    },
    "background_progress_posture": {"type": "string"},
    "claim_basis": {"type": "string"},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
