    "tokio::task::JoinHandle",
    "tokio::net::*"
  ],
  "optional_adapter_surfaces": [
    "feature:tokio-adapter"
  ],
  "behavioral_probes": [
    "compile_witness:no_public_tokio_types"
  ]
}
