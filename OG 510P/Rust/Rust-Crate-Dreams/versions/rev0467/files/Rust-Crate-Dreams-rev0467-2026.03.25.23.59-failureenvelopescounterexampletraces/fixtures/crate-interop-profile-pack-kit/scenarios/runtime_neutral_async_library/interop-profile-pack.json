{
  "schema_version": "0.1",
  "profile": {
    "id": "async_runtime_neutral_public_api",
    "version": "0.1.0",
    "summary": "Public async boundary avoids runtime-specific types"
  },
  "required_public_surfaces": [
    "core::future::Future",
    "futures_core::stream::Stream"
