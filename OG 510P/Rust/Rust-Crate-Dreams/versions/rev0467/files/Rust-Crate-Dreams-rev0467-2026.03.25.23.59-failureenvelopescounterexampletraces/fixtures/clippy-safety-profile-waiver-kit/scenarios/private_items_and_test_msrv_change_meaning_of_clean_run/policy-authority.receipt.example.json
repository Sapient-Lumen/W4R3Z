{
  "schema_version": "1",
  "workspace": "sensor-stack",
  "package": "sensor-core",
  "tool": "clippy",
  "lint": "missing_safety_doc",
  "effective_level": "deny",
  "priority": 0,
  "authority_source": "clippy_toml",
  "override_chain": [
    "workspace.lints.clippy.missing_safety_doc = deny",
    "clippy.toml check-private-items = false"
