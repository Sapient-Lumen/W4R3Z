{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/in-place-initialization-adoption-kit/init-transition.diff.schema.json",
  "title": "Init Transition Diff",
  "type": "object",
  "required": [
    "schema_version",
    "old_revision",
    "new_revision",
    "changes",
    "review_recommendation"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "old_revision": {
      "type": "string"
    },
    "new_revision": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "review_recommendation": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
