{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/cargo-vendor-source-parity-kit/source-parity.lock.schema.json",
  "title": "SourceParityLock",
  "type": "object",
  "required": ["schema_version", "selection", "logical_sources", "packages", "exactness"],
  "properties": {
    "schema_version": {"type": "string"},
    "selection": {
      "type": "object",
      "required": ["workspace_root", "manifests"],
      "properties": {
        "workspace_root": {"type": "string"},
        "manifests": {"type": "array", "items": {"type": "string"}},
        "lockfile": {"type": ["string", "null"]}
      }
    },
    "logical_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "declared_kind", "physical_root", "replacement_chain"],
        "properties": {
          "source_id": {"type": "string"},
          "declared_kind": {"type": "string", "enum": ["registry", "local_registry", "directory", "git", "path", "unknown"]},
          "physical_root": {"type": ["string", "null"]},
          "replacement_chain": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "logical_source_id", "source_class"],
        "properties": {
          "name": {"type": "string"},
          "version": {"type": "string"},
          "logical_source_id": {"type": "string"},
          "source_class": {"type": "string", "enum": ["registry", "vendored_directory", "local_registry", "path", "git", "manual_override", "unknown"]}
        }
      }
    },
    "exactness": {"type": "string", "enum": ["exact", "conservative", "manual_review_required"]},
    "blockers": {"type": "array", "items": {"type": "string"}}
  }
}
