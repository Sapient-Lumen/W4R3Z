{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/debuggability-support-contract-kit/debuggability-drift.diff.schema.json",
  "title": "DebuggabilityDriftDiff",
  "type": "object",
  "required": ["changes"],
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "severity"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "support_posture_changed",
              "sidecar_missing",
              "debug_info_mode_changed",
              "visualizer_changed",
              "path_hygiene_changed",
              "policy_weakened",
              "manual_review_required"
            ]
          },
          "severity": {"type": "string", "enum": ["info", "warning", "error"]},
          "artifact": {"type": "string"},
          "summary": {"type": "string"}
        }
      }
    }
  }
}
