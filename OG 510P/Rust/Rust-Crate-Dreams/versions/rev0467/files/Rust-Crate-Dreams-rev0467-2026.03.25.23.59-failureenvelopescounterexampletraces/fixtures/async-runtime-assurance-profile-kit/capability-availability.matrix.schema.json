{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/async-runtime-assurance-profile/capability-availability.matrix.schema.json",
  "title": "async runtime capability availability matrix",
  "type": "object",
  "required": ["schema_version", "subject", "capabilities"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "lanes"],
        "properties": {
          "name": {"type": "string"},
          "lanes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["lane_id", "status", "basis"],
              "properties": {
                "lane_id": {"type": "string"},
                "status": {"type": "string"},
                "basis": {"type": "string"},
                "notes": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
