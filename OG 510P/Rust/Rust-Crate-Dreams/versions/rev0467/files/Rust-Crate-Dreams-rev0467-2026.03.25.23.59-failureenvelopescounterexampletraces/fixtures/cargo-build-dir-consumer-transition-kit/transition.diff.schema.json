{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-build-dir-consumer-transition/transition.diff.schema.json",
  "title": "Cargo build-dir transition diff",
  "type": "object",
  "required": ["schema_version", "changes"],
  "properties": {
    "schema_version": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change_class", "severity"],
        "properties": {
          "change_class": {"type": "string", "enum": ["layout_changed", "consumer_became_risky", "adapter_added", "adapter_removed", "risk_reduced", "manual_review_required", "safe_noop"]},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "consumer_ref": {"type": "string"},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
