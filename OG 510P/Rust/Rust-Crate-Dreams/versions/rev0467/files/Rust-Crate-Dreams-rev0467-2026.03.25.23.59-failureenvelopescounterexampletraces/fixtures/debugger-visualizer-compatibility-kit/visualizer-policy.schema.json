{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/debugger-visualizer-compatibility-kit/visualizer-policy.schema.json",
  "title": "VisualizerPolicy",
  "type": "object",
  "required": ["lanes"],
  "properties": {
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["backend", "target", "mode"],
        "properties": {
          "backend": {"type": "string", "enum": ["natvis", "gdb_pretty_printer", "external_formatter_route", "manual_review_only"]},
          "target": {"type": "string"},
          "mode": {"type": "string", "enum": ["embedded_expected", "external_expected", "unsupported_by_design", "manual_review_required"]},
          "safe_path_required": {"type": "boolean"},
          "golden_set": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
