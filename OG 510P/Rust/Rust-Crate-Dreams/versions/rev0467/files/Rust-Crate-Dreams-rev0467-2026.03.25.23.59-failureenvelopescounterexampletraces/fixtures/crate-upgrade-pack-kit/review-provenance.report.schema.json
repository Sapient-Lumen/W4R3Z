{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeReviewProvenanceReport",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "lane",
    "overall_posture",
    "surfaces"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "overall_posture": {
      "type": "string",
      "enum": [
        "maker_only",
        "maker_checker_separated",
        "fallback_review_only",
        "mixed",
        "unknown"
      ]
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "surface_id",
          "surface_class",
          "maker_refs",
          "checker_refs",
          "separation_class",
          "challenge_posture",
          "decision"
        ],
        "properties": {
          "surface_id": {
            "type": "string"
          },
          "surface_class": {
            "type": "string",
            "enum": [
              "internal_candidate",
              "public_candidate",
              "frozen_public"
            ]
          },
          "maker_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checker_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "separation_class": {
            "type": "string",
            "enum": [
              "same_author_self_review",
              "same_team_nonindependent",
              "independent_checker",
              "fallback_checker",
              "not_reviewed"
            ]
          },
          "challenge_posture": {
            "type": "string",
            "enum": [
              "not_opened",
              "open",
              "closed_no_objection",
              "closed_with_objection",
              "not_applicable"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "working_only",
              "candidate_ok",
              "freeze_ok",
              "withhold"
            ]
          },
          "objection_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
