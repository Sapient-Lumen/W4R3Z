{
  "schema_version": "0.1",
  "profile": {
    "id": "async_runtime_neutral_public_api",
    "version": "0.1.0",
    "class": "ecosystem_boundary",
    "summary": "Async library may use Tokio internally but public API should stay runtime-neutral.",
    "manual_review_zones": [
      "public spawn handles",
      "runtime-specific IO types"
    ]
  },
  "required_public_surfaces": [
    "Future",
    "Stream"
  ],
  "forbidden_public_coupling": [
    "tokio::task::JoinHandle",
    "tokio::net::*"
  ],
  "optional_adapter_surfaces": [
    "tokio feature for internal runtime"
  ],
  "behavioral_probes": [
    "provider_consumer_compile_without_tokio_public_types"
  ]
}
