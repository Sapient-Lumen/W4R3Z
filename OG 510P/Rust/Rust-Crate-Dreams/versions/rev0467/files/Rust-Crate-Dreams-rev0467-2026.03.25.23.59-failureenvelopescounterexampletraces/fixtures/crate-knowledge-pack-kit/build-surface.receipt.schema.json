{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "build-surface.receipt",
  "type": "object",
  "required": ["crate", "profile", "surfaces"],
  "properties": {
    "crate": {"type": "string"},
    "profile": {"type": "string"},
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_kind",
          "toolchain_channel",
          "feature_posture",
          "docsrs_cfg_scope",
          "target_posture"
        ],
        "properties": {
          "id": {"type": "string"},
          "source_kind": {
            "type": "string",
            "enum": [
              "docsrs_hosted_html",
              "docsrs_rustdoc_json",
              "local_rustdoc_json",
              "local_docsrs_simulation",
              "manual_review_required"
            ]
          },
          "resolved_version": {"type": ["string", "null"]},
          "toolchain_channel": {
            "type": "string",
            "enum": ["stable", "beta", "nightly", "manual_review_required"]
          },
          "toolchain_version": {"type": ["string", "null"]},
          "rustdoc_json_format_version": {"type": ["integer", "null"]},
          "feature_posture": {
            "type": "object",
            "required": ["all_features", "no_default_features", "enabled_features"],
            "properties": {
              "all_features": {"type": "boolean"},
              "no_default_features": {"type": "boolean"},
              "enabled_features": {"type": "array", "items": {"type": "string"}}
            }
          },
          "cfgs": {"type": "array", "items": {"type": "string"}},
          "docsrs_cfg_scope": {
            "type": "string",
            "enum": [
              "final_documented_crate_only",
              "not_applicable",
              "manual_review_required"
            ]
          },
          "target_posture": {
            "type": "object",
            "required": ["default_target", "built_targets"],
            "properties": {
              "default_target": {"type": ["string", "null"]},
              "built_targets": {"type": "array", "items": {"type": "string"}},
              "cross_compiled_targets": {"type": "array", "items": {"type": "string"}}
            }
          },
          "example_scrape_posture": {
            "type": ["object", "null"],
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["off", "target_level", "with_examples_import", "manual_review_required"]
              },
              "dev_dependency_caveat": {
                "type": "string",
                "enum": [
                  "none",
                  "example_scrape_may_be_skipped_without_dev_deps",
                  "manual_review_required"
                ]
              }
            }
          },
          "notes": {"type": "array", "items": {"type": "string"}},
          "caveats": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
