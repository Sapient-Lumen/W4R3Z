{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runtime handoff pack",
  "type": "object",
  "required": ["schema_version", "crate", "failure_cases"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "failure_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "class", "summary"],
        "properties": {
          "id": {"type": "string"},
          "class": {"type": "string"},
          "summary": {"type": "string"},
          "capture_promises": {"type": "array", "items": {"type": "string"}},
          "recovery_step_ref": {"type": "string"}
        }
      }
    },
    "manual_review_zones": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}