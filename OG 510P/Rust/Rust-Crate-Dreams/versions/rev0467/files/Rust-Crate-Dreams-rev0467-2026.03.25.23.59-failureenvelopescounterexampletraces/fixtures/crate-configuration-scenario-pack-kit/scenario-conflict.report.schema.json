{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioConflictReport",
  "type": "object",
  "required": ["crate", "conflicts"],
  "properties": {
    "crate": {"type": "string"},
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "scenarios"],
        "properties": {
          "class": {"enum": ["mutually_awkward", "runtime_choice_required", "docs_only_surface", "adapter_needed", "manual_review_required", "unsupported_combo"]},
          "scenarios": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}