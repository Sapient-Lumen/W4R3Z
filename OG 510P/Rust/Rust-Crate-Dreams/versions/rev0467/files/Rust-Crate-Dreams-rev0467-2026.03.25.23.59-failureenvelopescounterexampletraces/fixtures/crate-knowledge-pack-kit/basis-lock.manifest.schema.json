{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "basis-lock.manifest",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "subject",
    "basis_members",
    "manual_review_zones"
  ],
  "properties": {
    "schema_name": {
      "const": "basis-lock.manifest"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "subject": {
      "type": "object",
      "required": [
        "crate",
        "version"
      ],
      "properties": {
        "crate": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "basis_members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "source_surface",
          "pinned"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "receipt",
              "report",
              "manifest",
              "pack",
              "lock",
              "import",
              "note"
            ]
          },
          "source_surface": {
            "type": "string"
          },
          "pinned": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "manual_review_zones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
