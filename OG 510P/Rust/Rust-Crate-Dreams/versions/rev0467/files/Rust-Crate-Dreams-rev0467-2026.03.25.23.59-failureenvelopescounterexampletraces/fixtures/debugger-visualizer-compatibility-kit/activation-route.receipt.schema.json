{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/debugger-visualizer-compatibility-kit/activation-route.receipt.schema.json",
  "title": "ActivationRouteReceipt",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["backend", "target", "route_verdict"],
        "properties": {
          "backend": {"type": "string"},
          "target": {"type": "string"},
          "route_verdict": {
            "type": "string",
            "enum": [
              "embedded_autoloaded",
              "embedded_present_safe_path_blocked",
              "embedded_present_backend_unsupported",
              "external_toolchain_script",
              "external_debugger_config",
              "manual_commands_required",
              "unsupported_by_design",
              "manual_review_required"
            ]
          },
          "asset_refs": {"type": "array", "items": {"type": "string"}},
          "script_refs": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "summary": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
