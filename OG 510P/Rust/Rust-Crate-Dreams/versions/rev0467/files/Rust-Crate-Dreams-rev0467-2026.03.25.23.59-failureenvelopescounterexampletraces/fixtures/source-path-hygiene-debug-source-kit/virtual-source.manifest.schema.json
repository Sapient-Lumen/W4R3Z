{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/source-path-hygiene-debug-source-kit/virtual-source.manifest.schema.json",
  "title": "VirtualSourceManifest",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["virtual_prefix", "source_class", "component_hint"],
        "properties": {
          "virtual_prefix": {"type": "string"},
          "source_class": {"type": "string", "enum": ["workspace", "path_dependency", "sysroot", "compiler_source", "generated", "manual_review_required"]},
          "component_hint": {"type": "string", "enum": ["rust-src", "rustc-dev", "none", "manual_review_required"]},
          "resolvable_locally": {"type": "boolean"}
        }
      }
    }
  }
}
