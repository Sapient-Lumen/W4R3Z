{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-vendor-source-parity/source-replacement.diff.schema.json",
  "title": "Cargo source replacement diff",
  "type": "object",
  "required": ["schema_version", "change_class"],
  "properties": {
    "schema_version": {"type": "string"},
    "change_class": {
      "type": "string",
      "enum": [
        "source_equivalent",
        "protocol_alias_changed",
        "coverage_reduced",
        "verification_import_changed",
        "manual_review_required"
      ]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
