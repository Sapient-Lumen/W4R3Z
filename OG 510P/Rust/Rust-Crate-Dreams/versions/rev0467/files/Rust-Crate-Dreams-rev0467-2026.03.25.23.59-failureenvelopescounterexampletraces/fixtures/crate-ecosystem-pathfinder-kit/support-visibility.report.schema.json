{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/support-visibility.report.schema.json",
  "title": "Crate pathfinder support visibility report",
  "type": "object",
  "required": ["schema_version", "task", "candidate", "visible_surfaces", "hidden_or_non_authoritative_axes", "manual_review_required"],
  "properties": {
    "schema_version": {"type": "string"},
    "task": {"type": "string"},
    "candidate": {"type": "string"},
    "visible_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["surface_kind", "source_ref", "observations"],
        "properties": {
          "surface_kind": {"type": "string"},
          "source_ref": {"type": "string"},
          "observations": {
            "type": "array",
            "items": {"type": "string"}
          },
          "caveats": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "hidden_or_non_authoritative_axes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
