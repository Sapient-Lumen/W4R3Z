{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Usability Witness Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "item_path",
    "slice_id",
    "docs_visibility",
    "doctest_use",
    "downstream_use"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "item_path": {
      "type": "string"
    },
    "slice_id": {
      "type": "string"
    },
    "docs_visibility": {
      "enum": [
        "visible",
        "hidden",
        "manual_review_required"
      ]
    },
    "same_crate_compile": {
      "enum": [
        "usable",
        "not_usable",
        "manual_review_required"
      ]
    },
    "doctest_use": {
      "enum": [
        "usable",
        "not_usable",
        "manual_review_required"
      ]
    },
    "downstream_use": {
      "enum": [
        "usable",
        "not_usable",
        "manual_review_required"
      ]
    },
    "evidence_basis": {
      "type": "array",
      "items": {
        "enum": [
          "direct_compile_witness",
          "doctest_compile_witness",
          "docs_only_witness",
          "docsrs_hosted_import",
          "rule_inference",
          "manual_review_required"
        ]
      }
    },
    "cautions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
