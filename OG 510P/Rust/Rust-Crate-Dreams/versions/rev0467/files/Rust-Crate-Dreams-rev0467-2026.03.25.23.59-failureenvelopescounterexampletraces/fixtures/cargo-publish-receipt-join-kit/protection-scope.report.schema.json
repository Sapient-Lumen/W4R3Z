{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/fixtures/cargo-publish-receipt-join-kit/protection-scope.report.schema.json",
  "title": "protection-scope.report",
  "type": "object",
  "required": [
    "subject",
    "registry",
    "protection_claims",
    "verdict"
  ],
  "properties": {
    "subject": {
      "type": "object",
      "required": [
        "package",
        "version"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "registry": {
      "type": "object",
      "required": [
        "name",
        "client_window"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "client_window": {
          "type": "string"
        }
      }
    },
    "protection_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "scope"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_scope",
              "out_of_scope",
              "unknown",
              "crates_io_only"
            ]
          },
          "scope": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "protection_scope_known",
        "partial_protection_scope",
        "manual_review_required"
      ]
    },
    "manual_review_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
