{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradePublicTracePathReport",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "surface_state",
    "routes",
    "overall_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "surface_state": {
      "type": "string",
      "enum": [
        "candidate_public",
        "frozen_public",
        "superseded_public"
      ]
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "route_id",
          "claim_ref",
          "trace_posture",
          "resolution_status"
        ],
        "properties": {
          "route_id": {
            "type": "string"
          },
          "claim_ref": {
            "type": "string"
          },
          "audience": {
            "type": "string",
            "enum": [
              "downstream_adopter",
              "release_reviewer",
              "public_contract",
              "tool_importer"
            ]
          },
          "trace_posture": {
            "type": "string",
            "enum": [
              "direct_public_receipt",
              "summary_plus_exported_receipt",
              "summary_plus_warning_register",
              "summary_plus_review_queue",
              "summary_only",
              "withheld_public",
              "missing_public_route"
            ]
          },
          "primary_public_ref": {
            "type": "string"
          },
          "fallback_public_ref": {
            "type": "string"
          },
          "withheld_internal_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resolution_status": {
            "type": "string",
            "enum": [
              "resolves",
              "fragment_missing",
              "target_missing",
              "private_only",
              "redaction_pending",
              "superseded_target",
              "unknown"
            ]
          },
          "typed_miss_kind": {
            "type": "string",
            "enum": [
              "none",
              "public_trace_fragment_missing",
              "public_trace_target_missing",
              "public_trace_private_only",
              "public_trace_redaction_pending",
              "public_trace_superseded_target",
              "public_trace_unknown"
            ]
          },
          "warning_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "unknown"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
