{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "excerpt-lineage.report",
  "type": "object",
  "required": [
    "crate",
    "profile",
    "excerpts"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "excerpts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "source_material_id",
          "authority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "source_material_id": {
            "type": "string"
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authority": {
            "type": "string"
          },
          "selection_basis": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "omitted_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_zones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
