{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MatrixFidelityReport",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "scenario",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "fidelity"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "features",
              "target",
              "runtime_or_backend",
              "profile_or_doc_mode",
              "examples_bins_tests",
              "workspace_shape"
            ]
          },
          "fidelity": {
            "enum": [
              "fully_observed",
              "sampled",
              "docs_only",
              "declared_not_observed",
              "workspace_only",
              "board_only",
              "manual_review_required"
            ]
          },
          "observed_values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "declared_values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
