{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/async-runtime-assurance-profile/runtime-profile.receipt.schema.json",
  "title": "async runtime profile receipt",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "runtime_family",
    "scheduler_model",
    "allocation_posture",
    "preemption_posture",
    "timer_authority",
    "blocking_posture",
    "qualification_evidence_class"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "runtime_family": {
      "type": "string",
      "enum": ["tokio", "embassy_executor", "rtic", "custom", "manual_review_required"]
    },
    "scheduler_model": {
      "type": "string",
      "enum": [
        "io_driver_and_task_scheduler",
        "cooperative_executor",
        "interrupt_priority_scheduler",
        "mixed",
        "manual_review_required"
      ]
    },
    "allocation_posture": {
      "type": "string",
      "enum": [
        "requires_alloc",
        "can_run_without_alloc",
        "shared_stack_no_dynamic_allocator",
        "mixed",
        "manual_review_required"
      ]
    },
    "preemption_posture": {
      "type": "string",
      "enum": ["cooperative_only", "priority_preemptive", "mixed", "manual_review_required"]
    },
    "timer_authority": {
      "type": "string",
      "enum": [
        "runtime_timer_driver",
        "integrated_timer_queue",
        "hardware_timer_queue",
        "external_or_board_specific",
        "manual_review_required"
      ]
    },
    "blocking_posture": {
      "type": "string",
      "enum": [
        "dedicated_blocking_pool",
        "forbidden_or_discouraged",
        "board_or_app_specific",
        "manual_review_required"
      ]
    },
    "qualification_evidence_class": {
      "type": "string",
      "enum": [
        "documentation_only",
        "documentation_plus_metrics",
        "documentation_plus_on_target_measurement",
        "imported_assurance_artifact",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
