{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capacity-posture.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "topology",
    "capacity_kind",
    "send_completion_point",
    "ordering_class"
  ],
  "properties": {
    "artifact": {
      "const": "capacity-posture.receipt"
    },
    "subject": {
      "type": "string"
    },
    "topology": {
      "enum": [
        "mpsc",
        "mpmc",
        "broadcast",
        "watch",
        "priority_channel",
        "rendezvous"
      ]
    },
    "capacity_kind": {
      "enum": [
        "bounded",
        "unbounded",
        "zero_capacity",
        "latest_only",
        "overwrite_ring",
        "priority_bounded"
      ]
    },
    "capacity_bound": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "send_completion_point": {
      "enum": [
        "enqueued",
        "handed_off",
        "latest_state_visible",
        "manual_review_required"
      ]
    },
    "ordering_class": {
      "enum": [
        "fifo",
        "per_receiver_fifo",
        "priority_reordered",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
