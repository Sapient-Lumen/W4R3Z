{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-example-surface/visibility-surface.report.schema.json",
  "title": "crate example surface visibility surface report",
  "type": "object",
  "required": ["schema_version", "subject", "surfaces"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surface_kind", "basis", "visibility_status"],
        "properties": {
          "surface_kind": {"type": "string"},
          "basis": {"type": "string"},
          "visibility_status": {"type": "string"},
          "feature_basis": {"type": "string"},
          "target_basis": {"type": "string"},
          "scrape_examples_mode": {"type": "string"},
          "constraints": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "manual_review_gaps": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
