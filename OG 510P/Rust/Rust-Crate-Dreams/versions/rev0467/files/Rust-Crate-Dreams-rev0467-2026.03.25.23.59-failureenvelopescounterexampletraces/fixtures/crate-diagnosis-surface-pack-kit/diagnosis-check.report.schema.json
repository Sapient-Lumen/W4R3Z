{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosisCheckReport",
  "type": "object",
  "required": [
    "crate",
    "status",
    "checks"
  ],
  "properties": {
    "crate": {"type": "string"},
    "status": {
      "enum": [
        "ok",
        "mismatch_found",
        "manual_review_required"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string"},
          "status": {
            "enum": [
              "ok",
              "mismatch_found",
              "manual_review_required"
            ]
          },
          "artifact": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
