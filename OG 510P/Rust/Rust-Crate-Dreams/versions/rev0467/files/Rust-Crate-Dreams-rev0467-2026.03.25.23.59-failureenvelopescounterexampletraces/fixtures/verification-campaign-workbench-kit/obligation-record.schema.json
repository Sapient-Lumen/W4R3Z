{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification Obligation Record",
  "type": "object",
  "required": [
    "obligation_id",
    "subject",
    "kind",
    "accepted_evidence",
    "blocking"
  ],
  "properties": {
    "obligation_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "importance": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "accepted_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_scope": {
      "type": "string"
    },
    "blocking": {
      "type": "boolean"
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  }
}
