{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HazardArbitrationReport",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "arbitrations"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "lane": { "type": "string" },
    "arbitrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "arbitration_id",
          "subject",
          "candidate_authorities",
          "confusability_class",
          "arbitration_rule",
          "abstain_baseline",
          "outcome"
        ],
        "properties": {
          "arbitration_id": { "type": "string" },
          "subject": { "type": "string" },
          "candidate_authorities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["authority_ref", "position"],
              "properties": {
                "authority_ref": { "type": "string" },
                "position": { "type": "string" }
              }
            }
          },
          "confusability_class": {
            "enum": [
              "semver_slice_vs_feature_policy",
              "maintainer_note_vs_behavior_witness",
              "scope_mismatch",
              "stale_import",
              "incomplete_witness",
              "other"
            ]
          },
          "arbitration_rule": {
            "enum": [
              "observed_behavior_beats_docs_only",
              "feature_policy_beats_semver_slice",
              "canonical_release_surface_beats_issue_thread",
              "scope_mismatch_forces_abstention",
              "no_safe_winner"
            ]
          },
          "abstain_baseline": {
            "enum": [
              "manual_review_required",
              "behavior_check_required",
              "unsupported_lane",
              "advisory_only"
            ]
          },
          "outcome": {
            "enum": [
              "winner_selected",
              "manual_review_required",
              "unsupported_lane",
              "advisory_only"
            ]
          },
          "selected_authority_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
