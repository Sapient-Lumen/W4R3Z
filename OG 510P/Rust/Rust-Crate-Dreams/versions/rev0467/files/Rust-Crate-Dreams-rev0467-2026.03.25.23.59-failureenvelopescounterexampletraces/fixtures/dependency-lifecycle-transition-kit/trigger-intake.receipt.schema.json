{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dependency Lifecycle Trigger Intake Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "observed_at",
    "dependency",
    "imported_signals",
    "shared_anchor_state",
    "immediate_result",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "receipt_id": { "type": "string" },
    "observed_at": { "type": "string", "format": "date-time" },
    "dependency": { "type": "string" },
    "imported_signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["signal_class", "source", "as_of", "summary"],
        "properties": {
          "signal_class": {
            "type": "string",
            "enum": [
              "advisory",
              "new_release",
              "registry_path_risk",
              "docs_or_support_shift",
              "build_substrate_change",
              "manual_request"
            ]
          },
          "source": { "type": "string" },
          "as_of": { "type": "string" },
          "summary": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "shared_anchor_state": {
      "type": "string",
      "enum": ["shared_checked_in", "local_only", "mixed", "unknown"]
    },
    "immediate_result": {
      "type": "string",
      "enum": [
        "record_only",
        "refresh_only",
        "open_transition_review",
        "containment_review_required"
      ]
    },
    "next_packet_ref": { "type": "string" },
    "manual_review_required": { "type": "boolean" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
