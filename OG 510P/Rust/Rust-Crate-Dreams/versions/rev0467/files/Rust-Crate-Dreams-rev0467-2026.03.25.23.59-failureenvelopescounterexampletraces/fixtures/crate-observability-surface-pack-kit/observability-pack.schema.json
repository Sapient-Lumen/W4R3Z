{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObservabilityPack",
  "type": "object",
  "required": ["schema_version", "crate", "signals"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "stability", "recipe_ref"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"enum": ["span", "event", "metric", "log"]},
          "stability": {"enum": ["stable_query_surface", "supported_but_evolving", "debug_only", "internal_only", "manual_review_required"]},
          "recipe_ref": {"type": "string"},
          "cost_class": {"type": "string"},
          "redaction_class": {"type": "string"}
        }
      }
    }
  }
}
