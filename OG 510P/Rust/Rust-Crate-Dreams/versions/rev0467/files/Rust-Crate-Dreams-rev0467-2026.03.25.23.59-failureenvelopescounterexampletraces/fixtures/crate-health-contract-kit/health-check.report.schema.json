{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/schemas/crate-health-contract-kit/health-check.report.schema.json",
  "title": "Health Check Report",
  "type": "object",
  "required": ["crate", "verdict", "findings"],
  "properties": {
    "crate": {"type": "string"},
    "verdict": {
      "type": "string",
      "enum": ["pass", "warn", "manual_review_required", "fail"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "summary"],
        "properties": {
          "code": {"type": "string"},
          "summary": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
