{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/schemas/crate-health-contract-kit/succession-map.report.schema.json",
  "title": "Succession Map Report",
  "type": "object",
  "required": ["crate", "succession_class"],
  "properties": {
    "crate": {"type": "string"},
    "succession_class": {
      "type": "string",
      "enum": [
        "multi_maintainer_with_backup",
        "single_maintainer_with_named_backup",
        "single_maintainer_no_backup",
        "seeking_transfer_or_co_maintainer",
        "organization_owned",
        "successor_crate_declared",
        "manual_review_required"
      ]
    },
    "owners": {
      "type": "array",
      "items": {"type": "string"}
    },
    "backup_contacts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "successor": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
