{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/async-runtime-assurance-profile/runtime-profile-diff.report.schema.json",
  "title": "async runtime profile diff report",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "old_ref",
    "new_ref",
    "changed_axes",
    "classification"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "old_ref": {
      "type": "string"
    },
    "new_ref": {
      "type": "string"
    },
    "changed_axes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "runtime_family",
          "scheduler_model",
          "allocation_posture",
          "preemption_posture",
          "timer_authority",
          "blocking_posture",
          "qualification_basis",
          "shutdown_behavior"
        ]
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "runtime_model_changed",
        "evidence_class_changed",
        "support_meaning_changed",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
