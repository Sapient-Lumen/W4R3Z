{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cargo-report-review-request/v0",
  "required": [
    "request_id",
    "request_kind",
    "subject_refs",
    "requested_stronger_use",
    "requester",
    "basis_refs",
    "required_gate_ids",
    "review_queue_status",
    "expected_head_ref",
    "head_lineage_ref",
    "head_guard_status",
    "safe_without_approval",
    "review_separation_ref"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "request_kind": {
      "type": "string",
      "enum": [
        "promotion-carry",
        "frozen-head-carry",
        "currentness-carry",
        "compatibility-carry",
        "contradiction-resolution",
        "waiver-renewal"
      ]
    },
    "subject_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "requested_stronger_use": {
      "type": "string"
    },
    "requester": {
      "type": "string"
    },
    "basis_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "required_gate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "review_queue_status": {
      "type": "string",
      "enum": [
        "pending-review",
        "reviewed-hold",
        "resolved"
      ]
    },
    "safe_without_approval": {
      "type": "string"
    },
    "waiver_ref": {
      "type": "string"
    },
    "contradiction_packet_ref": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string"
    },
    "reviewer_role": {
      "type": "string"
    },
    "blocked_stronger_uses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "review-request-open",
          "decision-witness-required",
          "manual-arbitration-required",
          "temporary-waiver-present",
          "waiver-required-for-stronger-reuse",
          "expected-head-mismatch",
          "rereview-required",
          "review-separation-receipt-required",
          "self-approval-risk",
          "independent-review-missing",
          "compensating-control-required",
          "fallback-review-expired"
        ]
      }
    },
    "notes": {
      "type": "string"
    },
    "head_lineage_ref": {
      "type": "string"
    },
    "expected_head_ref": {
      "type": "string"
    },
    "head_guard_status": {
      "type": "string",
      "enum": [
        "matched-head",
        "stale-head",
        "reissue-required",
        "superseded-request"
      ]
    },
    "current_head_ref": {
      "type": "string"
    },
    "superseded_by_request_ref": {
      "type": "string"
    },
    "review_separation_ref": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "head_guard_status": {
            "enum": [
              "stale-head",
              "reissue-required",
              "superseded-request"
            ]
          }
        }
      },
      "then": {
        "required": [
          "current_head_ref"
        ]
      }
    }
  ]
}
