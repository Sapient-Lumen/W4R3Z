{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cargo-report-quarantine-receipt/v0",
  "required": [
    "quarantine_id",
    "quarantine_class",
    "trigger_classes",
    "blocked_uses"
  ],
  "properties": {
    "quarantine_id": {
      "type": "string"
    },
    "quarantine_class": {
      "type": "string",
      "enum": [
        "capture-only-local",
        "quarantined-retained"
      ]
    },
    "trigger_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "decoder-unknown",
          "privacy-sensitive-native",
          "basis-missing",
          "projection-review-pending",
          "manual-hold"
        ]
      }
    },
    "blocked_uses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "derived_artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
