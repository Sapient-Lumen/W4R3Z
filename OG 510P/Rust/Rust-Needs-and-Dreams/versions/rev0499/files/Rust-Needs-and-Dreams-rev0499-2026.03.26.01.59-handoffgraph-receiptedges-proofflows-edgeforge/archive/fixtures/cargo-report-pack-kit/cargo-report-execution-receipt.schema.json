{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cargo-report-execution-receipt/v0",
  "required": [
    "receipt_id",
    "operation_class",
    "producer",
    "input_refs",
    "output_refs"
  ],
  "properties": {
    "receipt_id": {
      "type": "string"
    },
    "operation_class": {
      "type": "string",
      "enum": [
        "import-future-incompat",
        "import-session",
        "pack",
        "projection",
        "quarantine",
        "promote",
        "diff",
        "explain",
        "derived-summary",
        "arbitrate",
        "request-review",
        "record-decision"
      ]
    },
    "producer": {
      "type": "object",
      "required": [
        "producer_class",
        "producer_id"
      ],
      "properties": {
        "producer_class": {
          "type": "string",
          "enum": [
            "cargo-native-command",
            "reportpack-tool",
            "manual-reviewer"
          ]
        },
        "producer_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parent_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_role": {
      "type": "string",
      "enum": [
        "native-import-root",
        "projected-child",
        "quarantined-source",
        "derived-child",
        "promotion-surface",
        "superseded-head",
        "competing-head"
      ]
    },
    "notes": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "historical-only-until-rechecked",
          "no-workspace-wide-claim",
          "unstable-lane",
          "projection-present",
          "not-current-active",
          "unstable-build-analysis",
          "projection-receipt-required",
          "not-a-frozen-public-example",
          "basis-lost-demotion",
          "frozen-head-blocked",
          "derived-artifact-only",
          "source-remains-quarantined",
          "non-inference-for-omitted-fields",
          "temporary-waiver-present",
          "waiver-expired-demotion",
          "waiver-required-for-stronger-reuse",
          "execution-receipt-required",
          "lineage-link-required",
          "contradiction-held",
          "competing-heads",
          "manual-arbitration-required",
          "review-request-open",
          "decision-witness-required"
        ]
      }
    }
  },
  "additionalProperties": false
}
