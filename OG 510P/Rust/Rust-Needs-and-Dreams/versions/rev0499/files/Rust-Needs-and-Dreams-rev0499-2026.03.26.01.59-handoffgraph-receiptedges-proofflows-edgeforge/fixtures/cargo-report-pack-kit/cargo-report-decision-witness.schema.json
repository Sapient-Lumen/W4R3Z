{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cargo-report-decision-witness/v0",
  "required": [
    "witness_id",
    "request_ref",
    "review_separation_ref",
    "decision_class",
    "reviewer",
    "basis_refs",
    "cleared_blocks",
    "remaining_blocks",
    "reviewed_head_ref",
    "head_guard_status",
    "decided_at"
  ],
  "properties": {
    "witness_id": {
      "type": "string"
    },
    "request_ref": {
      "type": "string"
    },
    "decision_class": {
      "type": "string",
      "enum": [
        "approved",
        "approved-with-warning",
        "hold",
        "rejected",
        "superseded"
      ]
    },
    "reviewer": {
      "type": "string"
    },
    "basis_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "cleared_blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining_blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "winner_ref": {
      "type": "string"
    },
    "waiver_ref": {
      "type": "string"
    },
    "decided_at": {
      "type": "string"
    },
    "supersedes": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "temporary-waiver-present",
          "manual-arbitration-required",
          "competing-heads",
          "expected-head-mismatch",
          "rereview-required",
          "review-separation-receipt-required",
          "self-approval-risk",
          "independent-review-missing",
          "compensating-control-required",
          "fallback-review-expired"
        ]
      }
    },
    "reviewed_head_ref": {
      "type": "string"
    },
    "head_guard_status": {
      "type": "string",
      "enum": [
        "matched-head",
        "stale-head",
        "reissue-required",
        "superseded-request"
      ]
    },
    "current_head_ref": {
      "type": "string"
    },
    "reissue_request_ref": {
      "type": "string"
    },
    "review_separation_ref": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "head_guard_status": {
            "enum": [
              "stale-head",
              "reissue-required",
              "superseded-request"
            ]
          }
        }
      },
      "then": {
        "required": [
          "current_head_ref"
        ]
      }
    }
  ]
}
