{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cargo-report-currentness/v0",
  "required": [
    "currentness_id",
    "currentness_class"
  ],
  "properties": {
    "currentness_id": {
      "type": "string"
    },
    "currentness_class": {
      "type": "string",
      "enum": [
        "historical-retained",
        "as-of-observation",
        "rechecked-current",
        "superseded"
      ]
    },
    "observation_epoch": {
      "type": "string"
    },
    "superseded_by": {
      "type": "string"
    },
    "invalidation_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "historical-only-until-rechecked",
          "no-workspace-wide-claim",
          "unstable-lane",
          "projection-present",
          "not-current-active",
          "unstable-build-analysis",
          "projection-receipt-required",
          "not-a-frozen-public-example",
          "basis-lost-demotion",
          "frozen-head-blocked",
          "derived-artifact-only",
          "source-remains-quarantined",
          "non-inference-for-omitted-fields",
          "temporary-waiver-present",
          "waiver-expired-demotion",
          "waiver-required-for-stronger-reuse"
        ]
      }
    },
    "waiver_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
