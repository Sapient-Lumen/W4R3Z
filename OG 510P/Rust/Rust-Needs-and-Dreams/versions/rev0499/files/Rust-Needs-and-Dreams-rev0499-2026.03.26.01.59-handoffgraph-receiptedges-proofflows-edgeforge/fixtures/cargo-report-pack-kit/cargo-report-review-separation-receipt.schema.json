{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cargo-report-review-separation-receipt/v0",
  "required": [
    "receipt_id",
    "request_ref",
    "requested_stronger_use",
    "proposer",
    "reviewer",
    "executor",
    "review_separation_class",
    "compensating_control_class"
  ],
  "properties": {
    "receipt_id": {
      "type": "string"
    },
    "request_ref": {
      "type": "string"
    },
    "decision_witness_ref": {
      "type": "string"
    },
    "requested_stronger_use": {
      "type": "string"
    },
    "proposer": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "executor": {
      "type": "string"
    },
    "review_separation_class": {
      "type": "string",
      "enum": [
        "independent-checker",
        "cross-team-checker",
        "same-team-second-look",
        "self-review"
      ]
    },
    "compensating_control_class": {
      "type": "string",
      "enum": [
        "none",
        "time-bounded-fallback-review",
        "sampled-independent-audit",
        "escalation-before-stronger-reuse",
        "dual-control-execution"
      ]
    },
    "effective_until": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "review-separation-receipt-required",
          "self-approval-risk",
          "independent-review-missing",
          "compensating-control-required",
          "fallback-review-expired"
        ]
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "review_separation_class": {
            "const": "self-review"
          }
        }
      },
      "then": {
        "not": {
          "properties": {
            "compensating_control_class": {
              "const": "none"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "compensating_control_class": {
            "enum": [
              "time-bounded-fallback-review",
              "sampled-independent-audit",
              "escalation-before-stronger-reuse"
            ]
          }
        }
      },
      "then": {
        "required": [
          "effective_until"
        ]
      }
    }
  ]
}
