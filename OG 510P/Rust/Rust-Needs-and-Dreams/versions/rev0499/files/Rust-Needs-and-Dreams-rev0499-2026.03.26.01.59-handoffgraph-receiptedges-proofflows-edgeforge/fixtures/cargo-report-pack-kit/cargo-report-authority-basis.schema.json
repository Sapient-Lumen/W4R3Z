{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cargo-report-authority-basis/v0",
  "required": [
    "basis_id",
    "lane",
    "authority_path",
    "basis_posture",
    "native_basis_present"
  ],
  "properties": {
    "basis_id": {
      "type": "string"
    },
    "lane": {
      "type": "string",
      "enum": [
        "future-incompat",
        "build-analysis-session",
        "timings-replay",
        "rebuilds-replay",
        "derived-summary"
      ]
    },
    "authority_path": {
      "type": "string",
      "enum": [
        "native-replay-command",
        "direct-native-bytes",
        "copied-native-bytes",
        "copied-rendering",
        "summary-only"
      ]
    },
    "basis_posture": {
      "type": "string",
      "enum": [
        "native-replayable",
        "native-bytes-present",
        "copied-native-only",
        "projected-only",
        "summary-derived-only",
        "basis-missing"
      ]
    },
    "native_basis_present": {
      "type": "boolean"
    },
    "fallback_attempts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "refusal_posture": {
      "type": "string",
      "enum": [
        "allow-local-review",
        "bounded-share-with-warning",
        "hold-until-rechecked",
        "fail-closed-no-stronger-reuse"
      ]
    }
  },
  "additionalProperties": true
}
