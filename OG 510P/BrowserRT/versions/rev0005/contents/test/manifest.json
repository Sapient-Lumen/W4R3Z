{
  "schema": 2,
  "project": "BrowserRT",
  "revision": "rev0005",
  "purpose": "Manifest-driven, sliceable, timed, capability-gated test facility for cloudtainer-constrained BrowserRT development.",
  "tiers": {
    "smoke": "The turn-start tier: fast contract, plan, capability, and harness sanity checks.",
    "release": "The minimum package gate for current executable claims.",
    "full": "Everything currently available in this cube; future browser/GPU/OPFS tiers join here after tiny probes exist.",
    "browser": "Reserved for CDP/local-browser tests once introduced.",
    "stress": "Reserved for expensive timing, chaos, flake, and performance-regression probes.",
    "audit": "Cube surface audit; normally run by make lint before and after release tests."
  },
  "facility_contract": {
    "selection": [
      "tier",
      "id",
      "tag",
      "shard",
      "changed files through impact map"
    ],
    "evidence": [
      "per-task timing",
      "plan estimate",
      "capability survey",
      "slowest-test summary",
      "side-effect artifact paths"
    ],
    "default_parallelism": "auto capped to avoid overwhelming short cloudtainer windows",
    "process_policy": "one-shot by default; reusable browsers/servers only inside one scoped test command"
  },
  "tasks": [
    {
      "id": "cube:check",
      "description": "Validate cube surfaces, no external dependency drift, JSON alignment, proof witnesses, and testing-facility surfaces.",
      "command": [
        "python3",
        "tools/check_cube.py"
      ],
      "tiers": [
        "audit",
        "full"
      ],
      "tags": [
        "cube",
        "contract",
        "fast"
      ],
      "areas": [
        "cube",
        "docs",
        "release"
      ],
      "lane": "main",
      "parallelGroup": "contract",
      "size": "small",
      "isolation": "fresh-process",
      "flakiness": "none",
      "risk": 2,
      "estimatedMs": 160,
      "timeoutMs": 5000,
      "inputs": [
        "tools/check_cube.py",
        "*.json",
        "docs/**",
        "artifacts/**",
        "test/**",
        "tools/**"
      ],
      "outputs": [],
      "capabilities": [
        "node"
      ],
      "cachePolicy": "no-cache-artifact-sensitive",
      "evidence": [
        "stdout ok lines"
      ]
    },
    {
      "id": "facility:capability-survey",
      "description": "Record the current Node/cloudtainer capability envelope before selecting heavier tests.",
      "command": [
        "node",
        "tools/capability_survey.mjs",
        "--json",
        "artifacts/validation/REV0005-CAPABILITY-SURVEY.json"
      ],
      "tiers": [
        "smoke",
        "release",
        "full"
      ],
      "tags": [
        "harness",
        "capabilities",
        "fast"
      ],
      "areas": [
        "facility",
        "capabilities"
      ],
      "lane": "main",
      "parallelGroup": "contract",
      "size": "tiny",
      "isolation": "fresh-process",
      "flakiness": "none",
      "risk": 2,
      "estimatedMs": 80,
      "timeoutMs": 2500,
      "inputs": [
        "src/browserrt.mjs",
        "tools/capability_survey.mjs"
      ],
      "outputs": [
        "artifacts/validation/REV0005-CAPABILITY-SURVEY.json"
      ],
      "capabilities": [
        "node"
      ],
      "cachePolicy": "runtime-environment-no-cache",
      "evidence": [
        "capability survey artifact"
      ]
    },
    {
      "id": "facility:plan-sanity",
      "description": "Exercise affected-selection planning against the rev0005 impact map without running expensive tests.",
      "command": [
        "node",
        "tools/plan_tests.mjs",
        "--tier",
        "release",
        "--changed",
        "src/browserrt.mjs,tools/run_tests.mjs",
        "--json",
        "artifacts/validation/REV0005-TEST-PLAN-SANITY.json"
      ],
      "tiers": [
        "smoke",
        "release",
        "full"
      ],
      "tags": [
        "harness",
        "planning",
        "impact",
        "fast"
      ],
      "areas": [
        "facility",
        "selection"
      ],
      "lane": "main",
      "parallelGroup": "contract",
      "size": "tiny",
      "isolation": "fresh-process",
      "flakiness": "none",
      "risk": 3,
      "estimatedMs": 90,
      "timeoutMs": 2500,
      "inputs": [
        "src/test-facility.mjs",
        "tools/plan_tests.mjs",
        "test/manifest.json",
        "test/impact-map.json"
      ],
      "outputs": [
        "artifacts/validation/REV0005-TEST-PLAN-SANITY.json"
      ],
      "capabilities": [
        "node"
      ],
      "cachePolicy": "input-hashable",
      "evidence": [
        "plan artifact with matched impact rules"
      ]
    },
    {
      "id": "harness:selftest",
      "description": "Check that the test manifest, surface inventory, quarantine list, impact map, and sharding math are coherent before relying on the harness.",
      "command": [
        "node",
        "test/harness-selftest.mjs"
      ],
      "tiers": [
        "smoke",
        "release",
        "full"
      ],
      "tags": [
        "harness",
        "fast"
      ],
      "areas": [
        "facility",
        "selection",
        "sharding"
      ],
      "lane": "main",
      "parallelGroup": "contract",
      "size": "tiny",
      "isolation": "fresh-process",
      "flakiness": "none",
      "risk": 2,
      "estimatedMs": 100,
      "timeoutMs": 2500,
      "inputs": [
        "src/test-facility.mjs",
        "test/manifest.json",
        "test/impact-map.json",
        "test/surface-inventory.json",
        "test/quarantine.json",
        "test/harness-selftest.mjs"
      ],
      "outputs": [],
      "capabilities": [
        "node"
      ],
      "cachePolicy": "input-hashable",
      "evidence": [
        "selftest assertion pass"
      ]
    },
    {
      "id": "harness:surface-inventory",
      "description": "Validate impact map, surface inventory, and quarantine policy; write the test-surface report.",
      "command": [
        "node",
        "tools/validate_test_surface.mjs",
        "--write"
      ],
      "tiers": [
        "smoke",
        "release",
        "full"
      ],
      "tags": [
        "harness",
        "surface-inventory",
        "impact",
        "fast"
      ],
      "areas": [
        "facility",
        "selection",
        "surfaces"
      ],
      "lane": "main",
      "parallelGroup": "contract",
      "size": "tiny",
      "isolation": "fresh-process",
      "flakiness": "none",
      "risk": 3,
      "estimatedMs": 100,
      "timeoutMs": 2500,
      "inputs": [
        "src/test-facility.mjs",
        "tools/validate_test_surface.mjs",
        "test/manifest.json",
        "test/impact-map.json",
        "test/surface-inventory.json",
        "test/quarantine.json"
      ],
      "outputs": [
        "artifacts/validation/REV0005-TEST-SURFACE-REPORT.json"
      ],
      "capabilities": [
        "node"
      ],
      "cachePolicy": "input-hashable",
      "evidence": [
        "surface report artifact"
      ]
    },
    {
      "id": "runtime:smoke",
      "description": "Run the existing dependency-free runtime smoke test for boot, channel, worker transfer, and supervisor restart.",
      "command": [
        "node",
        "test/smoke.mjs"
      ],
      "tiers": [
        "release",
        "full"
      ],
      "tags": [
        "runtime",
        "worker",
        "proof"
      ],
      "areas": [
        "runtime",
        "worker",
        "supervision",
        "transfer"
      ],
      "lane": "cpu",
      "parallelGroup": "runtime-node",
      "size": "small",
      "isolation": "fresh-process",
      "flakiness": "none",
      "risk": 3,
      "estimatedMs": 450,
      "timeoutMs": 12000,
      "timeoutOverrideReason": "Worker spawn variance inside cloudtainer.",
      "inputs": [
        "src/**",
        "test/smoke.mjs"
      ],
      "outputs": [],
      "capabilities": [
        "node",
        "worker_threads",
        "transferable-arraybuffer"
      ],
      "cachePolicy": "input-hashable-but-rerun-release",
      "evidence": [
        "runtime smoke stdout"
      ]
    },
    {
      "id": "proof:phase-zero-agent-supervisor",
      "description": "Re-run the phase-zero worker/transfer/supervisor executable proof without rewriting the proof artifact.",
      "command": [
        "node",
        "tools/run_rev0005_proof.mjs"
      ],
      "tiers": [
        "release",
        "full"
      ],
      "tags": [
        "proof",
        "supervisor",
        "trace",
        "worker"
      ],
      "areas": [
        "runtime",
        "worker",
        "supervision",
        "trace"
      ],
      "lane": "cpu",
      "parallelGroup": "runtime-node",
      "size": "small",
      "isolation": "fresh-process",
      "flakiness": "none",
      "risk": 3,
      "estimatedMs": 550,
      "timeoutMs": 15000,
      "timeoutOverrideReason": "Worker crash/restart path has variable process latency.",
      "inputs": [
        "src/**",
        "tools/run_rev0005_proof.mjs"
      ],
      "outputs": [],
      "capabilities": [
        "node",
        "worker_threads",
        "transferable-arraybuffer"
      ],
      "cachePolicy": "input-hashable-but-rerun-release",
      "evidence": [
        "proof stdout"
      ]
    }
  ]
}
