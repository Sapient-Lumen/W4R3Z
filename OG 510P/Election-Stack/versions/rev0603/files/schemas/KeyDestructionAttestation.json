{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/KeyDestructionAttestation.json",
  "title": "KeyDestructionAttestation",
  "type": "object",
  "required": [
    "election_id",
    "bundle_hash_b64",
    "timestamp_utc",
    "trustee_attestations",
    "witness_cosignatures"
  ],
  "properties": {
    "election_id": { "type": "string", "minLength": 1 },
    "bundle_hash_b64": {
      "type": "string",
      "description": "Hash of the final verification bundle"
    },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "trustee_attestations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["trustee_id", "device_id", "method", "signature_b64"],
        "properties": {
          "trustee_id": { "type": "string", "minLength": 1 },
          "device_id": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "enum": ["HSM_ZEROIZE", "PHYSICAL_DESTRUCTION", "KEY_SHREDDING", "OTHER"] },
          "notes": { "type": "string" },
          "signature_b64": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "witness_cosignatures": {
      "type": "array",
      "items": { "$ref": "WitnessCosignature.json" },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
