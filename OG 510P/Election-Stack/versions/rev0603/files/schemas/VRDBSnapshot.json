{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VRDBSnapshot",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "created_at",
    "epoch_id",
    "jurisdiction_id",
    "root_hash",
    "canonicalization",
    "signatures"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "epoch_id": {
      "type": "string"
    },
    "jurisdiction_id": {
      "type": "string"
    },
    "eligible_voter_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional aggregate eligible voter count for this snapshot scope (used for cross-register consistency checks)."
    },
    "eligible_voter_count_scope": {
      "type": "string",
      "description": "Optional scope label for eligible_voter_count (e.g., jurisdiction_id, reporting_unit_id, or a named rollup)."
    },
    "root_hash": {
      "type": "string",
      "description": "Hash of canonicalized snapshot (e.g., JCS bytes)"
    },
    "canonicalization": {
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "partitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "partition_id": {
            "type": "string"
          },
          "root_hash": {
            "type": "string"
          }
        }
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "sig_alg",
          "signature"
        ],
        "properties": {
          "key_id": {
            "type": "string"
          },
          "sig_alg": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        }
      }
    }
  }
}