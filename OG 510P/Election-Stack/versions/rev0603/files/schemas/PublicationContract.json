{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/PublicationContract.json",
  "title": "PublicationContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "version",
    "election_scope",
    "issued_at",
    "rules",
    "signature_placeholder"
  ],
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "election_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "election_id"
      ],
      "properties": {
        "election_id": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "deadline_class",
          "max_delay_seconds",
          "trigger",
          "required_attachments_policy"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "EvidenceEnvelope.kind this rule applies to."
          },
          "deadline_class": {
            "type": "string",
            "enum": [
              "MMD-PBB",
              "MMD-EVID",
              "MAAD",
              "CUSTOM"
            ]
          },
          "trigger": {
            "type": "string",
            "description": "Deadline trigger identifier. SHOULD be in artifacts/registries/publication-triggers.csv; experimental triggers may be namespaced as x-<org>.<trigger>.",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "max_delay_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "required_attachments_policy": {
            "type": "string",
            "enum": [
              "registry",
              "explicit"
            ],
            "description": "Whether required attachments are taken from the attachment-requirements registry or enumerated in this rule."
          },
          "explicit_required_attachments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "If policy=explicit, list attachment rels required (e.g., transparency_receipt, gossip_summary)."
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "signature_placeholder": {
      "type": "object",
      "additionalProperties": true,
      "description": "Placeholder for signing policy; real deployments should sign the envelope, not this payload."
    }
  }
}