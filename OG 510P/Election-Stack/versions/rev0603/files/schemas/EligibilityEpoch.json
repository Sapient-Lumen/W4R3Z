{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EligibilityEpoch",
  "type": "object",
  "required": [
    "schema_version",
    "epoch_id",
    "effective_from",
    "snapshot_roots",
    "revocation_log_checkpoint",
    "signatures"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "epoch_id": {
      "type": "string"
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot_roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "jurisdiction_id",
          "snapshot_id",
          "root_hash"
        ],
        "properties": {
          "jurisdiction_id": {
            "type": "string"
          },
          "snapshot_id": {
            "type": "string"
          },
          "root_hash": {
            "type": "string"
          }
        }
      }
    },
    "revocation_log_checkpoint": {
      "type": "object",
      "required": [
        "checkpoint_id",
        "sth_hash"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string"
        },
        "sth_hash": {
          "type": "string"
        }
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "sig_alg",
          "signature"
        ],
        "properties": {
          "key_id": {
            "type": "string"
          },
          "sig_alg": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        }
      }
    }
  }
}