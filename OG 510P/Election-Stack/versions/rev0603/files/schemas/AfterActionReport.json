{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AfterActionReport",
  "type": "object",
  "required": [
    "exercise_id",
    "date",
    "summary",
    "timeline",
    "action_items"
  ],
  "properties": {
    "exercise_id": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "what_went_well": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "what_failed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object"
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$id": "https://example.org/schemas/AfterActionReport.json"
}
