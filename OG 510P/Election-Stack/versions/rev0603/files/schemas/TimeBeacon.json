{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/TimeBeacon.json",
  "title": "TimeBeacon",
  "type": "object",
  "required": [
    "node_id",
    "timestamp_utc",
    "sequence",
    "time_source"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "time_source": {
      "type": "string",
      "minLength": 1,
      "description": "Descriptor for the time source (e.g., nts_ntp, roughtime, tsa_rfc3161)."
    },
    "uncertainty_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Upper bound on uncertainty (ms) for timestamp_utc, if known."
    },
    "proof_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "description": "Optional digests of attached time-proof objects that support this beacon."
    }
  },
  "additionalProperties": false
}
