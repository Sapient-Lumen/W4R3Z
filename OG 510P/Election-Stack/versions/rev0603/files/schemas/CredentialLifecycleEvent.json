{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CredentialLifecycleEvent",
  "type": "object",
  "required": ["event_id", "event_type", "election_id", "timestamp_ms", "credential_pseudonym", "signature"],
  "properties": {
    "event_id": {"type": "string"},
    "event_type": {"type": "string", "enum": ["enroll", "add_authenticator", "remove_authenticator", "rotate", "revoke", "reissue", "recover", "appeal_opened", "appeal_closed"]},
    "election_id": {"type": "string"},
    "timestamp_ms": {"type": "integer"},
    "credential_pseudonym": {"type": "string", "description": "Pairwise pseudonymous identifier; MUST NOT be globally stable"},
    "reason_code": {"type": "string"},
    "signature": {"type": "string"}
  },
  "additionalProperties": false
}
