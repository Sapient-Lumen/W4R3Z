{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/RateLimitToken.json",
  "title": "RateLimitToken",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scheme",
    "token_b64",
    "context"
  ],
  "properties": {
    "scheme": {
      "type": "string",
      "enum": [
        "privacypass",
        "arc",
        "other"
      ]
    },
    "token_b64": {
      "type": "string",
      "description": "Encoded token blob, scheme-specific."
    },
    "context": {
      "type": "string",
      "description": "Context binding (election_id || gateway_id || purpose)."
    },
    "challenge_b64": {
      "type": "string",
      "description": "Optional token challenge, scheme-specific."
    },
    "issuer_id": {
      "type": "string",
      "description": "Identifier for the token issuer."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
