{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoterStatusProof",
  "type": "object",
  "required": [
    "schema_version",
    "request_nonce",
    "issued_at",
    "epoch_id",
    "registered",
    "ballot_style_id",
    "ballot_style_hash",
    "evidence_refs",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "request_nonce": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "epoch_id": {
      "type": "string"
    },
    "registered": {
      "type": "boolean"
    },
    "jurisdiction_id": {
      "type": "string"
    },
    "ballot_style_id": {
      "type": "string"
    },
    "ballot_style_hash": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "object",
      "required": [
        "snapshot_id",
        "vrdb_log_inclusion"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "vrdb_log_inclusion": {
          "type": "object"
        }
      }
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "sig_alg",
        "signature"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "sig_alg": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      }
    }
  }
}