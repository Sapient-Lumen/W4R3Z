{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/BatchCommitment.json",
  "title": "BatchCommitment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "commitment",
    "count",
    "created_at"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 8
    },
    "commitment": {
      "type": "string",
      "minLength": 32,
      "description": "Hash/Merkle root over included submissions"
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
