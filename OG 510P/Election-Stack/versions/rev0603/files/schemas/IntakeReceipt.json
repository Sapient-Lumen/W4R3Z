{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IntakeReceipt",
  "type": "object",
  "required": ["election_id", "ballot_hash", "deadline_ms", "entrypoint_id", "signature"],
  "properties": {
    "election_id": {"type": "string"},
    "ballot_hash": {"type": "string", "description": "Hash of canonical ballot submission payload"},
    "deadline_ms": {"type": "integer"},
    "entrypoint_id": {"type": "string"},
    "reason_code_on_failure": {"type": "string"},
    "signature": {"type": "string", "description": "Signature over canonicalized receipt fields"}
  },
  "additionalProperties": false
}
