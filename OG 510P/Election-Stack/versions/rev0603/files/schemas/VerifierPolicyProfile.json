{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/VerifierPolicyProfile.json",
  "title": "VerifierPolicyProfile",
  "type": "object",
  "description": "Machine-readable verifier policy profile used for report comparability. Intended to be published alongside verifier outputs and pinned by sha256 in PacketVerificationReport.policy_profile_sha256 (preferred). Unknown fields are allowed and should be ignored by verifiers unless explicitly required by policy.",
  "required": [
    "policy_id",
    "evaluated_at",
    "bundle_boundary",
    "trust_roots",
    "thresholds",
    "time_rules"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier for the policy profile (implementation-defined)."
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this profile was emitted (RFC3339)."
    },
    "bundle_boundary": {
      "type": "object",
      "required": [
        "manifest_sha256"
      ],
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "sha256 of the canonical bundle manifest bytes the policy was evaluated against."
        }
      },
      "additionalProperties": true
    },
    "trust_roots": {
      "type": "object",
      "required": [
        "publisher_keyset_digest",
        "witness_keyset_digest"
      ],
      "properties": {
        "publisher_keyset_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Digest pin for the publisher signing keyset (bytes as published by the deployment)."
        },
        "witness_keyset_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Digest pin for the witness/cosigner keyset (bytes as published by the deployment)."
        }
      },
      "additionalProperties": true
    },
    "thresholds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "m",
          "n"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "Role name the threshold applies to (e.g., witness, publisher)."
          },
          "m": {
            "type": "integer",
            "minimum": 1
          },
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": [],
            "description": "Optional constraint strings used for policy evaluation (e.g., 'at_least_one_external_witness')."
          }
        },
        "additionalProperties": true
      }
    },
    "time_rules": {
      "type": "object",
      "required": [
        "accept_signatures_not_before",
        "accept_signatures_not_after",
        "key_validity_grace_seconds"
      ],
      "properties": {
        "accept_signatures_not_before": {
          "type": "string",
          "format": "date-time"
        },
        "accept_signatures_not_after": {
          "type": "string",
          "format": "date-time"
        },
        "key_validity_grace_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "additionalProperties": true
}
