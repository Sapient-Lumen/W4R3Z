{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/AvailabilityGossipMessage.json",
  "title": "AvailabilityGossipMessage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sender_id",
    "sender_pubkey_id",
    "timestamp",
    "atl_checkpoint",
    "recent_entries",
    "signature"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "sender_id": { "type": "string" },
    "sender_pubkey_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "time_proof": {
      "description": "Optional secure time proof (e.g., Roughtime receipt) or notarization reference.",
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "atl_checkpoint": {
      "description": "Quorum-final ATL checkpoint summary.",
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch", "checkpoint_hash", "witness_bundle_hash"],
      "properties": {
        "epoch": { "type": "integer", "minimum": 0 },
        "checkpoint_hash": { "type": "string" },
        "witness_bundle_hash": { "type": "string" },
        "inclusion_proof": {
          "description": "Optional inclusion/consistency proof reference.",
          "type": ["object", "null"],
          "additionalProperties": true
        }
      }
    },
    "recent_entries": {
      "description": "Content hashes of recent availability-related entries (bounded).",
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": { "type": "string" }
    },
    "notes": { "type": ["string", "null"] },
    "signature": {
      "description": "Signature over canonicalized message fields (excluding signature).",
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "sig"],
      "properties": {
        "alg": { "type": "string" },
        "sig": { "type": "string" }
      }
    }
  }
}
