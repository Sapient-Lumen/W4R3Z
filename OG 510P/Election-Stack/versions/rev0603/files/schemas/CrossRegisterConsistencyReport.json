{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/CrossRegisterConsistencyReport.json",
  "title": "CrossRegisterConsistencyReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "report_version",
    "generated_at",
    "election_scope",
    "inputs",
    "checks",
    "overall_status"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "report_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "election_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "election_id",
        "jurisdiction"
      ],
      "properties": {
        "election_id": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "scope_id": {
          "type": "string",
          "description": "Optional scope label (e.g., county, municipality, reporting_unit_id)."
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vrdb_snapshot_payload_sha256"
      ],
      "properties": {
        "vrdb_snapshot_payload_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Digest of the VRDBSnapshot payload bytes used as the eligibility upper bound source."
        },
        "cro_payload_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Digest of the canonical results object payload bytes (CRO) used for totals."
        },
        "enr_update_payload_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Digest of an ENRUpdate payload bytes (if CRO is not used)."
        },
        "results_payload_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Optional generic results payload digest if neither CRO nor ENRUpdate naming is used."
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "allowed_overage": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional permitted slack for provisional/exception handling. Prefer 0 unless a jurisdiction has a documented rule."
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "scope_id",
          "status"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "scope_id": {
            "type": "string",
            "description": "Scope label for this constraint check (e.g., county, precinct, reporting_unit_id)."
          },
          "eligible_voter_count": {
            "type": "integer",
            "minimum": 0
          },
          "ballots_accepted_total": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Short explanation; keep bounded and non-partisan."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": { "enum": ["pass", "fail"] }
              },
              "required": ["status"]
            },
            "then": {
              "required": ["eligible_voter_count", "ballots_accepted_total"]
            }
          }
        ]
      }
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "unknown"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "anyOf": [
        { "required": ["inputs"], "properties": { "inputs": { "required": ["cro_payload_sha256"] } } },
        { "required": ["inputs"], "properties": { "inputs": { "required": ["enr_update_payload_sha256"] } } },
        { "required": ["inputs"], "properties": { "inputs": { "required": ["results_payload_sha256"] } } }
      ]
    }
  ]
}
