{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TokenMintResponse",
  "type": "object",
  "required": ["election_id", "eligibility_epoch_id", "signed_blinded_tokens", "server_nonce", "signature"],
  "properties": {
    "election_id": {"type": "string"},
    "eligibility_epoch_id": {"type": "string"},
    "signed_blinded_tokens": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "server_nonce": {"type": "string"},
    "error": {"type": "string"},
    "signature": {"type": "string", "description": "ETI signature over canonicalized response fields"}
  },
  "additionalProperties": false
}
