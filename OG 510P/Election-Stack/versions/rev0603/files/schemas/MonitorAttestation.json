{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/MonitorAttestation.json",
  "title": "MonitorAttestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "attestation_id",
    "monitor_id",
    "scope",
    "window",
    "observations",
    "tooling",
    "created_at",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "type": {
      "type": "string",
      "const": "MonitorAttestation"
    },
    "attestation_id": {
      "type": "string"
    },
    "monitor_id": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "PBB",
        "ATL",
        "ENR",
        "VRDB",
        "ALL"
      ]
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_checkpoint_hashes"
      ],
      "properties": {
        "latest_checkpoint_hashes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "latest_checkpoint_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "latest_epb_hashes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "latest_results_hashes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alerts_emitted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consistency_checks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "inclusion_sample": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "type": "string"
            },
            "sample_size": {
              "type": "integer",
              "minimum": 0
            },
            "failures": {
              "type": "integer",
              "minimum": 0
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "tool_version",
        "tool_hash"
      ],
      "properties": {
        "tool_name": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "tool_hash": {
          "type": "string"
        },
        "build_provenance": {
          "type": "string"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "hashes": {
      "type": "object"
    },
    "signature": {
      "type": "object",
      "additionalProperties": true
    }
  }
}