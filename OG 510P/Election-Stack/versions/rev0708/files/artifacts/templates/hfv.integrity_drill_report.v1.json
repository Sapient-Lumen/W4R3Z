{
  "hfv_version": "1.0",
  "type": "integrity_drill_report",
  "id": "urn:tes:idr:v1:${UUID}",
  "issued_at": "${RFC3339_TIMESTAMP}",
  "drill": {
    "name": "${DRILL_NAME}",
    "scope_surface": "${audit_log_digest|incident_command_log_digest|holdcapsule_summary|controlled_disclosure_packet|signed_digest_statement|timestamp_receipt}",
    "scenario": "${SYNTHETIC|NON_SENSITIVE|LIVE_SHADOW}",
    "target_sla_minutes": "${INT}",
    "ran_by": "${ROLE_OR_TEAM}",
    "participants": [
      "${OPTIONAL_PARTICIPANT_1}"
    ],
    "environment": "${prod_shadow|staging|lab}"
  },
  "inputs": {
    "surface_id": "${OPTIONAL_SURFACE_URN}",
    "source_system": "${OPTIONAL_SYSTEM}",
    "time_window": {
      "start": "${RFC3339_START}",
      "end": "${RFC3339_END}"
    },
    "canonicalization_profile": "${PROFILE_ID_OR_DESCRIPTION}"
  },
  "outputs": {
    "produced_surfaces": [
      "${URN_1}"
    ],
    "sds": {
      "present": "${true|false}",
      "id": "${OPTIONAL_SDS_URN}",
      "key_ref": "${OPTIONAL_KEY_REF}"
    },
    "ts_receipt": {
      "present": "${true|false}",
      "id": "${OPTIONAL_TSR_URN}",
      "method": "${rfc3161|transparency_log|witness_cosign}"
    }
  },
  "results": {
    "time_to_digest_minutes": "${INT}",
    "reproducible": "${true|false}",
    "signature_valid": "${true|false}",
    "disclosure_escalated": "${true|false}",
    "raw_logs_released": "${true|false}",
    "notes": "${SHORT_NOTES}"
  },
  "issues": [
    {
      "code": "${OPTIONAL_CODE}",
      "summary": "${OPTIONAL_SUMMARY}",
      "fix": "${OPTIONAL_FIX}",
      "owner": "${OPTIONAL_OWNER}"
    }
  ],
  "links": {
    "runbook": "${OPTIONAL_URL_OR_DOC_REF}",
    "evidence_store": "${OPTIONAL_STORAGE_REF}",
    "change_ticket": "${OPTIONAL_TICKET_ID}"
  }
}
