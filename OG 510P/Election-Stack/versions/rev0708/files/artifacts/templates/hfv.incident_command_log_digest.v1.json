{
  "kind": "hfv.incident_command_log_digest",
  "schema_version": "v1",
  "generated_at_utc": "<RFC3339 UTC>",
  "triage": {
  },
  "transparency_log": {
    "mode": "<optional: none|internal|public>",
    "provider": "<optional: log name>",
    "entry_id": "<optional: UUID / index / handle>",
    "submitted_at_utc": "<optional: RFC3339 UTC>",
    "log_root": "<optional: root hash / signed checkpoint ref>",
    "inclusion_proof_ref": "<optional: evidence bundle / disclosure packet ref>",
    "notes": "<optional: bounded>"
  },
  "scope": {
    "jurisdiction_label": "<non-identifying label>",
    "election_id": "<local election identifier>",
    "incident_id": "<stable incident identifier>",
    "environment": "<prod|staging|drill>",
    "notes": "<bounded, non-sensitive>"
  },
  "period": {
    "start_utc": "<RFC3339 UTC>",
    "end_utc": "<RFC3339 UTC>",
    "timezone_policy": "utc_only"
  },
  "publication_profile": {
    "cadence": "<hourly|daily|per-shift|per-milestone>",
    "audience": "<public|oversight|sealed>",
    "supersedes": "<optional digest of prior ICLD>"
  },
  "record_digests": [
    {
      "record_kind": "<decision|assessment|evidence_link|comms_release>",
      "record_id": "<stable id within incident>",
      "created_utc": "<RFC3339 UTC>",
      "digest_alg": "sha256",
      "record_digest": "<hex sha256 of canonical record bytes>",
      "classification": "<tiny label: e.g. containment|escalation|status|other>",
      "links": [
        {
          "rel": "<evidence|audit_log_digest|public_notice|ticket|other>",
          "target_digest": "<hex sha256 (if applicable)>",
          "target_uri_hint": "<optional URI hint (not authoritative)>"
        }
      ]
    }
  ],
  "integrity": {
    "hash_chain": {
      "enabled": true,
      "prev_digest": "<hex sha256 of previous ICLD (or 'genesis')>"
    },
    "timestamp_proofs": [
      {
        "kind": "<rfc3161|transparency_receipt|witness_cosignature>",
        "proof_ref": "<uri or embedded blob ref>"
      }
    ]
  },
  "signatures": [
    {
      "signer_role": "<incident_commander|election_director|cio|other>",
      "key_ref": "<key id / public key reference>",
      "sig_alg": "<ed25519|p256|rsa_pss|other>",
      "signature_b64": "<base64>"
    }
  ]
}
