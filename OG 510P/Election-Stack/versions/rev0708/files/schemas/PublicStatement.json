{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/hfv/PublicStatement.schema.json",
  "title": "PublicStatement",
  "type": "object",
  "required": ["statement_id", "election_id", "issued_at", "kind", "text", "statement_hash"],
  "properties": {
    "statement_id": {"type": "string"},
    "election_id": {"type": "string"},
    "issued_at": {"type": "string", "format": "date-time"},
    "kind": {"type": "string", "enum": ["status", "incident", "clarification", "correction"]},
    "related_ids": {"type": "array", "items": {"type": "string"}, "default": []},
    "text": {"type": "string"},
    "statement_hash": {"type": "string"}
  },
  "additionalProperties": false
}
