{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RecoveryRequest",
  "type": "object",
  "required": ["request_id", "election_id", "request_type", "submitted_at_ms", "channel", "signature"],
  "properties": {
    "request_id": {"type": "string"},
    "election_id": {"type": "string"},
    "request_type": {"type": "string", "enum": ["lost_device", "suspected_compromise", "coercion_or_abuse", "name_or_address_change", "other"]},
    "submitted_at_ms": {"type": "integer"},
    "channel": {"type": "string", "enum": ["in_person", "phone", "web", "mail", "assisted"]},
    "safety_flag": {"type": "boolean", "description": "True if voter indicates unsafe/coerced environment"},
    "attachments_hash": {"type": "string", "description": "Hash of redacted attachments bundle, if any"},
    "signature": {"type": "string", "description": "CSP/RA signature over canonicalized fields"}
  },
  "additionalProperties": false
}
