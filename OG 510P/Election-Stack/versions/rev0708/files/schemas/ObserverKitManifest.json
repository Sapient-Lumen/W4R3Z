{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObserverKitManifest",
  "type": "object",
  "required": [
    "bundle_id",
    "created_at",
    "election_id",
    "epb_hash",
    "checkpoint_id",
    "checkpoint_hash",
    "files",
    "canonicalization",
    "signatures"
  ],
  "properties": {
    "bundle_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "election_id": {
      "type": "string"
    },
    "epb_hash": {
      "type": "string",
      "description": "SHA-256 hex of the EPB canonical bytes"
    },
    "checkpoint_id": {
      "type": "string"
    },
    "checkpoint_hash": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "alg",
          "sig_b64"
        ],
        "properties": {
          "key_id": {
            "type": "string"
          },
          "alg": {
            "type": "string",
            "enum": [
              "ed25519"
            ]
          },
          "sig_b64": {
            "type": "string"
          }
        }
      }
    },
    "canonicalization": {
      "type": "string",
      "enum": [
        "RFC8785-JCS"
      ],
      "description": "Canonicalization scheme for manifest signing bytes (see docs/92)."
    }
  }
}
