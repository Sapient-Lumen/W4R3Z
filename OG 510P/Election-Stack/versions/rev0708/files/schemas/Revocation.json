{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revocation_id",
    "issued_at",
    "issuer_id",
    "revokes",
    "reason",
    "signature"
  ],
  "properties": {
    "revocation_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer_id": {
      "type": "string"
    },
    "revokes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "description": "What is being revoked: endorsement, reference value set, key, etc."
        }
      }
    },
    "reason": {
      "type": "string"
    },
    "replacement_id": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    }
  }
}
