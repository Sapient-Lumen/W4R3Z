{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/WitnessGossipMessage.json",
  "title": "WitnessGossipMessage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "witness_id",
    "timestamp",
    "payload",
    "signature"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "STH_OBSERVED",
        "CHECKPOINT",
        "FORK_PROOF"
      ]
    },
    "witness_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "SignedTreeHead.json"
        },
        {
          "$ref": "Checkpoint.json"
        },
        {
          "$ref": "ForkProof.json"
        }
      ]
    },
    "signature": {
      "type": "string",
      "minLength": 32,
      "description": "Signature over (type||witness_id||timestamp||payload_canon)"
    },
    "sig_alg": {
      "type": "string",
      "default": "ed25519"
    }
  }
}
