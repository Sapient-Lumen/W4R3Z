{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AvailabilityProbeResult",
  "type": "object",
  "required": [
    "schema_version",
    "probe_time",
    "target",
    "method",
    "result",
    "vantage",
    "evidence_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "probe_time": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "string",
      "description": "Canonical endpoint key (not necessarily a URL)"
    },
    "method": {
      "type": "string",
      "enum": [
        "HTTPS_HEAD",
        "HTTPS_GET",
        "DNS_LOOKUP",
        "TLS_HANDSHAKE",
        "ARTIFACT_FETCH"
      ]
    },
    "result": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "OK",
            "FAIL",
            "TIMEOUT",
            "TLS_ERROR",
            "DNS_ERROR",
            "HASH_MISMATCH"
          ]
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ],
          "description": "Hash of retrieved artifact/body if applicable"
        }
      }
    },
    "vantage": {
      "type": "object",
      "required": [
        "class",
        "asn"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "INTERNAL",
            "WITNESS",
            "EXTERNAL_RIPE_ATLAS",
            "EXTERNAL_OONI",
            "OTHER"
          ]
        },
        "probe_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "asn": {
          "type": "integer",
          "minimum": 0
        },
        "country": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "rfc3161_tst": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional RFC3161 timestamp token (base64)"
    },
    "evidence_hash": {
      "type": "string",
      "description": "Content-addressed hash of the signed probe result blob"
    }
  }
}