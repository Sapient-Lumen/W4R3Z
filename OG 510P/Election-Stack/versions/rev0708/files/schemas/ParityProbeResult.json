{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParityProbeResult",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp",
    "vantage",
    "target",
    "expected",
    "observed",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "vantage": {
      "type": "object",
      "required": [
        "source",
        "id"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "e.g., internal, ripe-atlas, ooni, observer"
        },
        "id": {
          "type": "string",
          "description": "probe id / monitor id"
        },
        "asn": {
          "type": [
            "integer",
            "null"
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "network": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ],
          "description": "manifest, checkpoint, enr, canary, onion-mirror"
        }
      }
    },
    "expected": {
      "type": "object",
      "properties": {
        "checkpoint_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "tls_spki_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "dns_answers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observed": {
      "type": "object",
      "properties": {
        "http_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "response_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "tls_spki_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "dns_answers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "mismatch",
        "unreachable",
        "error"
      ]
    },
    "evidence_pointers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    }
  }
}