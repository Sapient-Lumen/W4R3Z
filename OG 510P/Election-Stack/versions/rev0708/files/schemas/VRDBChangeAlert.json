{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VRDBChangeAlert",
  "type": "object",
  "required": [
    "schema_version",
    "alert_id",
    "created_at",
    "epoch_id",
    "severity",
    "summary",
    "evidence_refs",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "alert_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "epoch_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "summary": {
      "type": "string"
    },
    "metrics": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "object"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "sig_alg",
        "signature"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "sig_alg": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      }
    }
  }
}