{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/PublicationCoverageReport.json",
  "title": "PublicationCoverageReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "contract_id",
    "window_start",
    "window_end",
    "events_total",
    "events_satisfied",
    "events_missed",
    "miss_rate",
    "per_rule"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "contract_id": {
      "type": "string"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "events_total": {
      "type": "integer",
      "minimum": 0
    },
    "events_satisfied": {
      "type": "integer",
      "minimum": 0
    },
    "events_missed": {
      "type": "integer",
      "minimum": 0
    },
    "miss_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "per_rule": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "trigger_id",
          "events_total",
          "events_satisfied",
          "events_missed",
          "miss_rate"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "trigger_id": {
            "type": "string"
          },
          "events_total": {
            "type": "integer",
            "minimum": 0
          },
          "events_satisfied": {
            "type": "integer",
            "minimum": 0
          },
          "events_missed": {
            "type": "integer",
            "minimum": 0
          },
          "miss_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "missed_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "trigger_id",
          "expected_kind",
          "deadline"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "trigger_id": {
            "type": "string"
          },
          "expected_kind": {
            "type": "string"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          },
          "trigger_event_reference": {
            "type": "string",
            "description": "Optional reference to the TriggerEvent envelope/object used as the deadline anchor."
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}