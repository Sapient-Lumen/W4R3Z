{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/TransparencyReceipt.json",
  "title": "TransparencyReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_version",
    "receipt_type",
    "log_id",
    "issued_at",
    "entry_digest",
    "signature"
  ],
  "properties": {
    "receipt_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "receipt_type": {
      "type": "string",
      "enum": [
        "scitt",
        "ct",
        "custom"
      ],
      "description": "Receipt family / profile identifier. SCITT receipts are commonly COSE-based."
    },
    "profile": {
      "type": "string",
      "description": "Optional profile identifier (e.g., a SCITT receipt profile draft name)."
    },
    "log_id": {
      "type": "string",
      "description": "Identifier for the transparency service/log producing this receipt (e.g., key id or registry id)."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "entry_digest": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$",
      "description": "Digest of the submitted statement / envelope bytes or statement hash, per profile."
    },
    "tree_size": {
      "type": "integer",
      "minimum": 0
    },
    "root_hash": {
      "type": "string",
      "description": "Tree root hash, if applicable (profile-defined encoding)."
    },
    "proof_type": {
      "type": "string",
      "enum": [
        "inclusion",
        "consistency",
        "other"
      ],
      "description": "What property this receipt proves (profile-defined)."
    },
    "proof": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Proof elements (profile-defined encoding)."
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "sig"
      ],
      "properties": {
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        },
        "sig_encoding": {
          "type": "string",
          "enum": [
            "base64",
            "base64url",
            "hex"
          ]
        },
        "kid": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "semantics_tier": {
      "type": "string",
      "enum": [
        "acknowledged",
        "included",
        "consistent",
        "witnessed"
      ],
      "description": "Cross-ecosystem semantics tier. See docs/185."
    },
    "mmd_seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional bounded-delay parameter for acknowledged receipts (MMD-style)."
    }
  }
}