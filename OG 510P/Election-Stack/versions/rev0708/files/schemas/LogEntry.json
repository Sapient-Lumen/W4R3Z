{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/LogEntry.json",
  "title": "LogEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_type",
    "election_id",
    "payload_hash_b64",
    "server_timestamp_ms",
    "node_id",
    "node_signature_b64"
  ],
  "properties": {
    "entry_type": {
      "type": "string",
      "enum": [
        "BALLOT",
        "PARAMS",
        "REVOCATION",
        "CLOSE",
        "RESULTS",
        "OTHER"
      ]
    },
    "election_id": {
      "type": "string",
      "minLength": 1
    },
    "payload_hash_b64": {
      "type": "string",
      "description": "Base64-encoded hash of canonical payload"
    },
    "server_timestamp_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Server wall-clock timestamp (ms since epoch); informational only\u2014canonical ordering comes from STH/checkpoints."
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "node_signature_b64": {
      "type": "string",
      "description": "Signature over canonical LogEntry fields (RFC8785-JCS over the LogEntry object with node_signature_b64 omitted). Optional fields (e.g., sth_ref, time_beacon_digests) are covered if present."
    },
    "sth_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tree_size": {
          "type": "integer",
          "minimum": 0
        },
        "root_hash_b64": {
          "type": "string"
        }
      }
    },
    "time_beacon_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "description": "Optional content-addressed references to published hfv.time.beacon envelopes relevant to this entry/checkpoint epoch."
    }
  }
}
