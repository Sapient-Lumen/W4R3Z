{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/LivenessBeacon.json",
  "title": "LivenessBeacon",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "watchers",
    "election_scope",
    "observations"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "watchers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Identifiers for the watcher/monitor(s) that produced this beacon (human-readable; may map to keys out-of-band)."
    },
    "probe_cohort_plan_payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Optional digest of a ProbeCohortPlan *payload* describing the watcher cohort diversity constraints (docs/127). This makes cohort-shaping attacks against the monitoring ecosystem easier to detect."
    },
    "vantage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional coarse vantage metadata. Avoid IP addresses; prefer ASN/country-level fields to reduce privacy risk while still supporting cohort-shaping analysis.",
      "properties": {
        "asn": {
          "type": "integer",
          "minimum": 0,
          "description": "Origin ASN of the watcher vantage (best effort)."
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 3,
          "description": "ISO country code (best effort; 2 or 3 letters)."
        },
        "region": {
          "type": "string",
          "description": "Optional coarse region label used by the watcher program."
        },
        "network_type": {
          "type": "string",
          "enum": [
            "residential",
            "mobile",
            "datacenter",
            "enterprise",
            "unknown"
          ],
          "description": "Optional network class. Keep coarse to reduce fingerprinting."
        },
        "resolver_asn": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional ASN of the DNS resolver used for the observation (best effort)."
        },
        "notes": {
          "type": "string",
          "description": "Optional short notes about the watcher vantage (avoid narratives)."
        }
      }
    },
    "election_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "election_id",
        "jurisdiction"
      ],
      "properties": {
        "election_id": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "previous_beacon_payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Optional digest of the previous LivenessBeacon *payload* bytes (rollback/rewrites detection)."
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional monotonically increasing counter for watcher convenience. Not authoritative without the hash chain."
    },
    "window_notes": {
      "type": "string",
      "description": "Optional, short watcher notes (avoid narratives)."
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "observed_at",
          "result"
        ],
        "properties": {
          "surface": {
            "type": "string",
            "enum": [
              "well_known_discovery",
              "official_channel_directory",
              "public_notice_feed",
              "public_notice_signing_keyset",
              "witness_set",
              "other"
            ],
            "description": "Which public surface was observed."
          },
          "url_hint": {
            "type": "string",
            "description": "Optional non-normative hint for where the surface was fetched (avoid depending on it for security decisions)."
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "string",
            "enum": [
              "ok",
              "http_error",
              "timeout",
              "dns_error",
              "tls_error",
              "parse_error",
              "other_error"
            ]
          },
          "http_status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Digest of the observed *payload* bytes for the surface's canonical evidence object (if parsing succeeded)."
          },
          "headers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "etag": {
                "type": "string"
              },
              "cache_control": {
                "type": "string"
              },
              "age_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "last_modified": {
                "type": "string"
              }
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "ok"
                }
              },
              "required": [
                "result"
              ]
            },
            "then": {
              "required": [
                "payload_sha256"
              ]
            }
          }
        ]
      }
    }
  }
}
