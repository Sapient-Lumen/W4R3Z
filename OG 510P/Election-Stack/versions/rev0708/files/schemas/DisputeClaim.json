{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/DisputeClaim.json",
  "title": "DisputeClaim",
  "type": "object",
  "additionalProperties": false,
  "required": ["election_id", "claim_type", "submitted_at", "evidence_refs"],
  "properties": {
    "election_id": {"type": "string"},
    "claim_type": {
      "type": "string",
      "enum": [
        "NOT_RECORDED",
        "EQUIVOCATION",
        "WRONG_PARAMETERS",
        "TALLY_MISMATCH",
        "OTHER"
      ]
    },
    "submitted_at": {"type": "string", "format": "date-time"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "sha256"],
        "properties": {
          "kind": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "notes": {"type": "string"}
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": {"type": "string"},
        "phone": {"type": "string"}
      }
    },
    "narrative": {"type": "string"}
  }
}
