{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChallengeQuotaPolicy",
  "type": "object",
  "required": [
    "policy_id",
    "published_by",
    "published_at",
    "watcher_caps",
    "monitor_caps",
    "target_caps",
    "signature"
  ],
  "properties": {
    "policy_id": {
      "type": "string"
    },
    "published_by": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "watcher_caps": {
      "type": "object",
      "required": [
        "max_challenges_per_round",
        "max_challenges_per_day"
      ],
      "properties": {
        "max_challenges_per_round": {
          "type": "integer",
          "minimum": 1
        },
        "max_challenges_per_day": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "monitor_caps": {
      "type": "object",
      "required": [
        "max_total_challenges_per_day"
      ],
      "properties": {
        "max_total_challenges_per_day": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "target_caps": {
      "type": "object",
      "required": [
        "max_per_target_per_day"
      ],
      "properties": {
        "max_per_target_per_day": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}