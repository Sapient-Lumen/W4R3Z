{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerifierProvenance",
  "type": "object",
  "required": [
    "verifier_id",
    "version",
    "source",
    "build",
    "artifacts",
    "created_at",
    "signature"
  ],
  "properties": {
    "verifier_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "build": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object"
    }
  },
  "$id": "https://example.org/schemas/VerifierProvenance.json",
  "additionalProperties": false
}
