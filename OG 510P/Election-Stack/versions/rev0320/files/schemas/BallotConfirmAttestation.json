{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/BallotConfirmAttestation.json",
  "title": "BallotConfirmAttestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request",
    "confirmer_pubkey",
    "signature",
    "alg",
    "timestamp"
  ],
  "properties": {
    "request": {
      "$ref": "BallotConfirmRequest.json"
    },
    "confirmer_pubkey": {
      "type": "string",
      "minLength": 16
    },
    "alg": {
      "type": "string",
      "minLength": 2
    },
    "signature": {
      "type": "string",
      "minLength": 32
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "device_class_proof": {
      "type": "object",
      "description": "Optional privacy-preserving proof of hardware class/certification; avoid unique device identifiers."
    }
  }
}