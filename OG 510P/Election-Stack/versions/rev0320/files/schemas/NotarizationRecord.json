{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/NotarizationRecord.json",
  "title": "NotarizationRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "election_id",
    "artifact_type",
    "artifact_sha256",
    "log_system_id",
    "log_entry_id",
    "checkpoint",
    "inclusion_proof",
    "created_at"
  ],
  "properties": {
    "election_id": {"type": "string"},
    "artifact_type": {"type": "string"},
    "artifact_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},

    "log_system_id": {"type": "string"},
    "log_entry_id": {"type": "string"},

    "checkpoint": {
      "type": "object",
      "additionalProperties": true,
      "description": "Opaque log checkpoint/tree-head structure for the external log"
    },

    "inclusion_proof": {
      "type": "object",
      "additionalProperties": true,
      "description": "Opaque inclusion proof format for the external log"
    },

    "created_at": {"type": "string", "format": "date-time"},

    "notes": {"type": "string"}
  }
}
