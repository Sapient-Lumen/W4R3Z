{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EndpointValidationReport",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp",
    "target",
    "perspectives",
    "quorum_rule",
    "decision",
    "signatures"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "string"
    },
    "perspectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dns",
          "tls",
          "http"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dns": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "tls": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "spki_fingerprint": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cert_chain_hash": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "http": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "status": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "body_hash": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "headers_hash": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "quorum_rule": {
      "type": "string",
      "description": "e.g., >= k perspectives agree on dns+tls+body_hash"
    },
    "decision": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "sig"
        ],
        "properties": {
          "key_id": {
            "type": "string"
          },
          "suite": {
            "type": [
              "string",
              "null"
            ]
          },
          "sig": {
            "type": "string"
          }
        }
      }
    }
  }
}