{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/OfficialSurfaceSecuritySnapshot.json",
  "title": "OfficialSurfaceSecuritySnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "snapshot_version",
    "observed_at",
    "election_scope",
    "target",
    "observations"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "description": "Stable identifier for this snapshot series (updates may chain via previous_snapshot_sha256)."
    },
    "snapshot_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Schema version of this snapshot payload."
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this snapshot was produced (best effort)."
    },
    "election_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "election_id",
        "jurisdiction"
      ],
      "properties": {
        "election_id": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_domain"
      ],
      "properties": {
        "primary_domain": {
          "type": "string",
          "description": "Primary official web domain name (e.g., elections.example)."
        },
        "email_domain": {
          "type": "string",
          "description": "Optional official email sending domain for public communications (e.g., elections.example)."
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional list of official channel IDs from artifacts/registries/official-channels.csv."
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "previous_snapshot_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Optional digest of the prior snapshot payload in this series (anti-rollback / anti-rewrite)."
    },
    "announcing_notice_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Optional digest of the PublicNotice envelope that announced this snapshot."
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control",
          "summary",
          "evidence"
        ],
        "properties": {
          "control": {
            "type": "string",
            "enum": [
              "dns_caa",
              "dnssec_ds",
              "ct_monitoring",
              "tls_certificate",
              "dmarc",
              "spf",
              "dkim",
              "hsts"
            ],
            "description": "Name of the control being observed."
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "missing",
              "misconfigured",
              "unknown"
            ],
            "description": "Optional evaluation hint (operators may leave as unknown; observers may populate)."
          },
          "summary": {
            "type": "string",
            "description": "One-line human summary; keep it short."
          },
          "evidence": {
            "$ref": "./EvidencePointer.json"
          },
          "notes": {
            "type": "string",
            "description": "Optional short note; avoid narratives."
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Optional short notes; avoid narratives."
    }
  }
}
