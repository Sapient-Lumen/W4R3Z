{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/KeyCompromiseEvent.json",
  "title": "KeyCompromiseEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "event_id",
    "election_id",
    "component",
    "key_id",
    "detected_at",
    "impact_summary",
    "containment_actions",
    "created_at",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "type": {
      "type": "string",
      "const": "KeyCompromiseEvent"
    },
    "event_id": {
      "type": "string"
    },
    "election_id": {
      "type": "string"
    },
    "component": {
      "type": "string",
      "enum": [
        "PBB_LOG",
        "WITNESS",
        "TRUSTEE",
        "ELIGIBILITY_ISSUER",
        "ENR",
        "VRDB",
        "VERIFIER",
        "OTHER"
      ]
    },
    "key_id": {
      "type": "string"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "suspected_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "impact_summary": {
      "type": "string"
    },
    "containment_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remediation_plan": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effective_checkpoint_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object",
      "additionalProperties": true
    }
  }
}