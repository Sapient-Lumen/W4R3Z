{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/EvidenceEnvelope.json",
  "title": "EvidenceEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version",
    "kind",
    "track",
    "issued_at",
    "issuer",
    "subject",
    "payload_schema",
    "payload_digest",
    "canonicalization",
    "signatures"
  ],
  "properties": {
    "envelope_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer_id"
      ],
      "properties": {
        "issuer_id": {
          "type": "string"
        },
        "public_key_ref": {
          "type": "string",
          "description": "Key reference (e.g., did:key, jwk thumbprint, or registry id)."
        },
        "role": {
          "type": "string"
        }
      }
    },
    "subject": {
      "type": "object",
      "description": "Subject identifiers: election, jurisdiction, device, component, etc.",
      "additionalProperties": true
    },
    "payload_schema": {
      "type": "string",
      "description": "Schema id/URI for the payload."
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signer_id",
          "alg",
          "sig"
        ],
        "properties": {
          "signer_id": {
            "type": "string"
          },
          "alg": {
            "type": "string"
          },
          "sig": {
            "type": "string"
          },
          "kid": {
            "type": "string",
            "description": "Optional key id / key reference."
          },
          "sig_encoding": {
            "type": "string",
            "enum": [
              "base64",
              "base64url",
              "hex"
            ],
            "description": "Encoding of sig field."
          }
        }
      }
    },
    "canonicalization": {
      "type": "string",
      "enum": [
        "RFC8785-JCS"
      ],
      "description": "Canonicalization scheme for hashing/signing JSON."
    },
    "payload_inline": {
      "type": "object",
      "description": "Inline JSON payload (small objects)."
    },
    "payload_pointer": {
      "allOf": [
        {
          "$ref": "EvidencePointer.json"
        }
      ],
      "description": "Pointer to detached payload bytes."
    },
    "attachments": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "EvidencePointer.json"
          }
        ]
      },
      "description": "Optional supporting materials (receipts, proofs, excerpts)."
    },
    "tbs_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Digest of the canonicalized to-be-signed envelope object (signatures omitted)."
    }
  },
  "oneOf": [
    {
      "required": [
        "payload_inline"
      ],
      "not": {
        "required": [
          "payload_pointer"
        ]
      }
    },
    {
      "required": [
        "payload_pointer"
      ],
      "not": {
        "required": [
          "payload_inline"
        ]
      }
    }
  ]
}
