{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExercisePlan",
  "type": "object",
  "required": ["id", "type", "scenario_id", "objectives", "participants", "evidence_plan"],
  "properties": {
    "id": {"type": "string"},
    "type": {"type": "string", "enum": ["tabletop", "gameday", "red_team", "partner_drill"]},
    "scenario_id": {"type": "string"},
    "objectives": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "participants": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "injects": {"type": "array", "items": {"type": "object"}},
    "evidence_plan": {"type": "object"},
    "communications_plan": {"type": "object"}
  },
  "additionalProperties": false
}
