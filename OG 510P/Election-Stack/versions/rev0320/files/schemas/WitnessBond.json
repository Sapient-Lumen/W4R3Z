{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WitnessBond",
  "type": "object",
  "required": ["witness_id", "bond_type", "obligations", "adjudication", "issued_at", "signature"],
  "properties": {
    "witness_id": {"type": "string"},
    "bond_type": {"type": "string", "enum": ["financial_escrow", "insurance", "contractual", "reputational" ]},
    "obligations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "coverage_amount": {"type": "string"},
    "adjudication": {
      "type": "object",
      "required": ["forum", "appeal_process"],
      "properties": {
        "forum": {"type": "string"},
        "appeal_process": {"type": "string"}
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "string"}
  },
  "additionalProperties": false
}
