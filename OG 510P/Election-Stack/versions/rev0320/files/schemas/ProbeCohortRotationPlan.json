{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ProbeCohortRotationPlan.json",
  "title": "ProbeCohortRotationPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "policy",
    "schedule",
    "selection_seed_commitment",
    "created_at",
    "hashes",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0\\..+$"
    },
    "plan_id": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_asn_share",
        "min_distinct_asn",
        "min_distinct_country",
        "min_path_diversity_score"
      ],
      "properties": {
        "max_asn_share": {
          "type": "number"
        },
        "min_distinct_asn": {
          "type": "integer"
        },
        "min_distinct_country": {
          "type": "integer"
        },
        "min_path_diversity_score": {
          "type": "number"
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_minutes",
        "rotation_minutes"
      ],
      "properties": {
        "window_minutes": {
          "type": "integer"
        },
        "rotation_minutes": {
          "type": "integer"
        }
      }
    },
    "selection_seed_commitment": {
      "type": "string",
      "description": "Commitment to randomness/seed used for cohort selection (revealed later for auditability)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_json_sha256"
      ],
      "properties": {
        "canonical_json_sha256": {
          "type": "string"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "value"
      ],
      "properties": {
        "alg": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}