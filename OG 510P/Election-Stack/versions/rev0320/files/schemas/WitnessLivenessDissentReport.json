{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/WitnessLivenessDissentReport.json",
  "title": "WitnessLivenessDissentReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "issued_at",
    "period_start",
    "period_end",
    "witness_set_id",
    "witnesses",
    "methodology"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "election_id": {
      "type": "string"
    },
    "jurisdiction_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "period_start": {
      "type": "string",
      "format": "date-time"
    },
    "period_end": {
      "type": "string",
      "format": "date-time"
    },
    "witness_set_id": {
      "type": "string",
      "minLength": 1
    },
    "methodology": {
      "type": "string",
      "minLength": 1,
      "description": "Short description of data sources and counting rules."
    },
    "witnesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "witness_id",
          "expected_cosigns",
          "observed_cosigns",
          "missed_cosigns",
          "cosign_rate",
          "dissent_events",
          "last_observed_at"
        ],
        "properties": {
          "witness_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_cosigns": {
            "type": "integer",
            "minimum": 0
          },
          "observed_cosigns": {
            "type": "integer",
            "minimum": 0
          },
          "missed_cosigns": {
            "type": "integer",
            "minimum": 0
          },
          "cosign_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "dissent_events": {
            "type": "integer",
            "minimum": 0,
            "description": "Count of published dissent/refusal items in the period."
          },
          "refusals_to_cosign": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "last_observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "public_profile_ref": {
            "type": "string",
            "description": "Digest/URL pointer to the witness profile / COI disclosures used for evaluation."
          },
          "notes": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "dissent_items": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "issued_at",
          "witness_id",
          "kind",
          "summary"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "witness_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "refusal_to_cosign",
              "fork_alert",
              "policy_violation",
              "disagreement_note",
              "other"
            ]
          },
          "related_digests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "public_statement_ref": {
            "type": "string",
            "description": "Pointer to any public statement packet/digest."
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "capture_risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "limitations": {
      "type": "string",
      "maxLength": 800
    }
  }
}