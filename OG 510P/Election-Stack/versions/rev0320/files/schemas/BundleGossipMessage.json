{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/BundleGossipMessage.json",
  "title": "BundleGossipMessage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "sender_id",
    "timestamp",
    "payload",
    "signature"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "DIGEST",
        "GET_BUNDLE",
        "BUNDLE",
        "GET_CHECKPOINT",
        "CHECKPOINT",
        "DIVERGENCE"
      ]
    },
    "sender_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier for the sender (observer, monitor, witness, etc.)."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "oneOf": [
        {
          "title": "Digest",
          "type": "object",
          "additionalProperties": false,
          "required": ["checkpoint_hash", "known_manifest_hashes"],
          "properties": {
            "checkpoint_hash": {"type": "string", "minLength": 32},
            "known_manifest_hashes": {
              "type": "array",
              "items": {"type": "string", "minLength": 32},
              "maxItems": 128
            },
            "priority_manifest_hashes": {
              "type": "array",
              "items": {"type": "string", "minLength": 32},
              "maxItems": 64
            }
          }
        },
        {
          "title": "GetBundle",
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest_hash"],
          "properties": {
            "manifest_hash": {"type": "string", "minLength": 32}
          }
        },
        {
          "title": "Bundle",
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest"],
          "properties": {
            "manifest": {"$ref": "EvidenceBundleManifest.json"},
            "notarization": {"$ref": "BundleNotarization.json"}
          }
        },
        {
          "title": "GetCheckpoint",
          "type": "object",
          "additionalProperties": false,
          "required": ["checkpoint_hash"],
          "properties": {
            "checkpoint_hash": {"type": "string", "minLength": 32}
          }
        },
        {
          "title": "Checkpoint",
          "type": "object",
          "additionalProperties": false,
          "required": ["checkpoint"],
          "properties": {
            "checkpoint": {"$ref": "Checkpoint.json"}
          }
        },
        {
          "title": "Divergence",
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_manifest_hash"],
          "properties": {
            "evidence_manifest_hash": {"type": "string", "minLength": 32},
            "note": {"type": "string"}
          }
        }
      ]
    },
    "signature": {
      "type": "string",
      "minLength": 32,
      "description": "Signature over (type||sender_id||timestamp||payload_canon)"
    },
    "sig_alg": {
      "type": "string",
      "default": "ed25519"
    }
  }
}
