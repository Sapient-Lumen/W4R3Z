{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/hfv/ReferenceValueEntry.schema.json",
  "title": "ReferenceValueEntry",
  "type": "object",
  "required": [
    "reference_value_id",
    "issued_at",
    "issuer",
    "subject",
    "measurement_set_hash",
    "valid_from",
    "valid_until"
  ],
  "properties": {
    "reference_value_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "string",
      "description": "Human-readable issuer identifier; see endorsement transparency policy."
    },
    "subject": {
      "type": "object",
      "description": "What these reference values apply to (model, revision, component)."
    },
    "measurement_set_hash": {
      "type": "string",
      "description": "Hash of canonical measurement set (e.g., PCR set, firmware digest list)."
    },
    "constraints": {
      "type": "object",
      "description": "Anti-rollback / configuration constraints.",
      "default": {}
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "revocation_reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}