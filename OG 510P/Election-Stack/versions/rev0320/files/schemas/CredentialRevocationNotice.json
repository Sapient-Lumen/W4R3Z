{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CredentialRevocationNotice",
  "type": "object",
  "required": ["election_id", "eligibility_epoch_id", "revocation_set_hash", "published_at_ms", "signature"],
  "properties": {
    "election_id": {"type": "string"},
    "eligibility_epoch_id": {"type": "string"},
    "revocation_set_hash": {"type": "string", "description": "Hash commitment to revocation set (privacy-preserving)"},
    "published_at_ms": {"type": "integer"},
    "signature": {"type": "string"}
  },
  "additionalProperties": false
}
