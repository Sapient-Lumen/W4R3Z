{
  "$id": "https://example.org/schemas/MissionKernelCloseoutIndex.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive_version": {
      "pattern": "^v[0-9]+$",
      "type": "string"
    },
    "closeout_id": {
      "minLength": 1,
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "highest_risk_blockers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blocker_id": {
            "pattern": "^MKB-[0-9]{3}$",
            "type": "string"
          },
          "closure_test": {
            "minLength": 1,
            "type": "string"
          },
          "kernel_element_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "missing_evidence": {
            "minLength": 1,
            "type": "string"
          },
          "next_artifact": {
            "minLength": 1,
            "type": "string"
          },
          "owner_role": {
            "minLength": 1,
            "type": "string"
          },
          "priority": {
            "enum": [
              "critical",
              "high"
            ],
            "type": "string"
          }
        },
        "required": [
          "blocker_id",
          "priority",
          "owner_role",
          "kernel_element_ids",
          "missing_evidence",
          "next_artifact",
          "closure_test"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "kernel_elements": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "closure_test": {
            "minLength": 1,
            "type": "string"
          },
          "element_id": {
            "pattern": "^K[0-9]{2}_[A-Z0-9_]+$",
            "type": "string"
          },
          "evidence_refs": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string"
                },
                "manifest_sha256": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "purpose": {
                  "minLength": 1,
                  "type": "string"
                },
                "ref_type": {
                  "enum": [
                    "packet",
                    "report",
                    "registry",
                    "doc",
                    "template"
                  ],
                  "type": "string"
                },
                "verification_status": {
                  "type": "string"
                }
              },
              "required": [
                "ref_type",
                "path",
                "purpose"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "linked_claims": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "linked_hazards": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "linked_proof_obligations": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "linked_risks": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "live_blockers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "mission_element": {
            "minLength": 1,
            "type": "string"
          },
          "owner_role": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "SYNTHETIC_REPLAY_PASS",
              "SYNTHETIC_PARTIAL",
              "LIVE_BLOCKED_MISSING_EVIDENCE"
            ],
            "type": "string"
          }
        },
        "required": [
          "element_id",
          "mission_element",
          "status",
          "owner_role",
          "evidence_refs",
          "closure_test",
          "live_blockers",
          "linked_proof_obligations",
          "linked_claims",
          "linked_hazards",
          "linked_risks"
        ],
        "type": "object"
      },
      "maxItems": 7,
      "minItems": 7,
      "type": "array"
    },
    "mission_kernel_version": {
      "pattern": "^[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "no_live_deployment_claim": {
      "type": "boolean"
    },
    "non_claims": {
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "type": "array"
    },
    "readiness_verdict": {
      "enum": [
        "SYNTHETIC_REPLAY_PASS_LIVE_NO_GO",
        "FAIL"
      ],
      "type": "string"
    },
    "refactor_audit": {
      "additionalProperties": false,
      "properties": {
        "consumers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "duplicated_verify_packet_functions_after_refactor": {
          "minimum": 0,
          "type": "integer"
        },
        "notes": {
          "type": "string"
        },
        "shared_helper": {
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "shared_helper",
        "consumers",
        "duplicated_verify_packet_functions_after_refactor",
        "notes"
      ],
      "type": "object"
    },
    "scenario_id": {
      "minLength": 1,
      "type": "string"
    },
    "synthetic_only": {
      "type": "boolean"
    }
  },
  "required": [
    "archive_version",
    "scenario_id",
    "closeout_id",
    "mission_kernel_version",
    "generated_at",
    "synthetic_only",
    "no_live_deployment_claim",
    "readiness_verdict",
    "kernel_elements",
    "highest_risk_blockers",
    "refactor_audit",
    "non_claims"
  ],
  "title": "MissionKernelCloseoutIndex",
  "type": "object"
}
