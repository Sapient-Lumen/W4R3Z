{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/MissionKernelLiveWorkqueue.json",
  "title": "Mission kernel live-closeout workqueue",
  "type": "object",
  "required": [
    "archive_version",
    "scenario_id",
    "workqueue_id",
    "synthetic_only",
    "no_live_deployment_claim",
    "decision",
    "work_item_count",
    "critical_work_item_count",
    "rows",
    "boundary"
  ],
  "properties": {
    "archive_version": {"type": "string", "pattern": "^v[0-9]+$"},
    "release_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "scenario_id": {"type": "string", "minLength": 1},
    "closeout_id": {"type": "string", "minLength": 1},
    "workqueue_id": {"type": "string", "minLength": 1},
    "synthetic_only": {"const": true},
    "no_live_deployment_claim": {"const": true},
    "decision": {"const": "NO_GO_LIVE_CLOSEOUT_EVIDENCE_INCOMPLETE"},
    "readiness_verdict": {"const": "SYNTHETIC_REPLAY_PASS_LIVE_NO_GO"},
    "work_item_count": {"type": "integer", "minimum": 1},
    "critical_work_item_count": {"type": "integer", "minimum": 0},
    "high_work_item_count": {"type": "integer", "minimum": 0},
    "boundary": {"type": "string", "minLength": 1},
    "operator_rule": {"type": "string", "minLength": 1},
    "refactor_audit": {"type": "object"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "work_item_id",
          "blocker_id",
          "priority",
          "kernel_element_ids",
          "owner_role",
          "status",
          "next_artifact",
          "missing_evidence",
          "minimum_evidence_classes",
          "closure_test",
          "acceptance_gate",
          "non_claims"
        ],
        "properties": {
          "work_item_id": {"type": "string", "pattern": "^LWC-[0-9]{3}$"},
          "blocker_id": {"type": "string", "pattern": "^MKB-[0-9]{3}$"},
          "priority": {"enum": ["critical", "high", "medium", "low"]},
          "kernel_element_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "kernel_element_labels": {"type": "array", "items": {"type": "string"}},
          "owner_role": {"type": "string", "minLength": 1},
          "status": {"const": "BLOCKED_PENDING_LIVE_EVIDENCE"},
          "next_artifact": {"type": "string", "minLength": 1},
          "missing_evidence": {"type": "string", "minLength": 1},
          "minimum_evidence_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "standard_alignment": {"type": "array", "items": {"type": "string"}},
          "closure_test": {"type": "string", "minLength": 1},
          "first_operator_action": {"type": "string", "minLength": 1},
          "acceptance_gate": {"type": "string", "minLength": 1},
          "no_go_reason": {"type": "string", "minLength": 1},
          "non_claims": {"type": "string", "minLength": 1},
          "source_blocker": {"type": "object"},
          "source_kernel_elements": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
