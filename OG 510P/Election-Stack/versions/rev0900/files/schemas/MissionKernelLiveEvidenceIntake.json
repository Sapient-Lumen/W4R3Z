{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/MissionKernelLiveEvidenceIntake.json",
  "title": "Mission kernel live evidence intake status",
  "type": "object",
  "required": [
    "archive_version",
    "release_date",
    "scenario_id",
    "workqueue_id",
    "intake_report_id",
    "generated_at",
    "synthetic_archive_report",
    "no_live_deployment_claim",
    "decision",
    "submission_id",
    "submission_source_mode",
    "work_item_count",
    "complete_pending_review_item_count",
    "complete_live_candidate_item_count",
    "partial_or_invalid_item_count",
    "complete_drill_item_count",
    "partial_or_invalid_drill_item_count",
    "missing_live_evidence_item_count",
    "live_evidence_object_count",
    "valid_live_evidence_object_count",
    "shape_valid_live_candidate_object_count",
    "drill_evidence_object_count",
    "valid_drill_evidence_object_count",
    "non_live_evidence_object_count",
    "error_count",
    "errors",
    "rows",
    "boundary",
    "authentication_boundary",
    "operator_rule",
    "refactor_audit"
  ],
  "properties": {
    "archive_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "release_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "workqueue_id": {
      "type": "string",
      "minLength": 1
    },
    "intake_report_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "synthetic_archive_report": {
      "const": true
    },
    "no_live_deployment_claim": {
      "const": true
    },
    "decision": {
      "enum": [
        "NO_GO_NO_LIVE_EVIDENCE_SUBMITTED",
        "NO_GO_DRILL_VALIDATION_FAILED_NOT_LIVE_EVIDENCE",
        "DRILL_PARTIAL_NOT_LIVE_EVIDENCE",
        "DRILL_COMPLETE_NOT_LIVE_READY",
        "NO_GO_INTAKE_VALIDATION_FAILED",
        "NO_GO_LIVE_EVIDENCE_AUTHENTICATION_REQUIRED"
      ]
    },
    "submission_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "submission_source_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_item_count": {
      "type": "integer",
      "minimum": 1
    },
    "complete_pending_review_item_count": {
      "const": 0
    },
    "complete_live_candidate_item_count": {
      "type": "integer",
      "minimum": 0
    },
    "partial_or_invalid_item_count": {
      "type": "integer",
      "minimum": 0
    },
    "complete_drill_item_count": {
      "type": "integer",
      "minimum": 0
    },
    "partial_or_invalid_drill_item_count": {
      "type": "integer",
      "minimum": 0
    },
    "missing_live_evidence_item_count": {
      "type": "integer",
      "minimum": 0
    },
    "live_evidence_object_count": {
      "type": "integer",
      "minimum": 0
    },
    "valid_live_evidence_object_count": {
      "const": 0
    },
    "shape_valid_live_candidate_object_count": {
      "type": "integer",
      "minimum": 0
    },
    "drill_evidence_object_count": {
      "type": "integer",
      "minimum": 0
    },
    "valid_drill_evidence_object_count": {
      "type": "integer",
      "minimum": 0
    },
    "non_live_evidence_object_count": {
      "type": "integer",
      "minimum": 0
    },
    "error_count": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "boundary": {
      "type": "string",
      "minLength": 1
    },
    "authentication_boundary": {
      "type": "string",
      "minLength": 1
    },
    "operator_rule": {
      "type": "string",
      "minLength": 1
    },
    "refactor_audit": {
      "type": "object",
      "required": [
        "status",
        "shared_module",
        "duplicated_evidence_class_maps_after_refactor",
        "bare_digest_live_promotion_paths_after_refactor",
        "consumers"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "shared_module": {
          "const": "tools/mission_kernel_common.py"
        },
        "duplicated_evidence_class_maps_after_refactor": {
          "const": 0
        },
        "bare_digest_live_promotion_paths_after_refactor": {
          "const": 0
        },
        "consumers": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "work_item_id",
          "blocker_id",
          "priority",
          "owner_role",
          "required_evidence_class_count",
          "valid_live_evidence_class_count",
          "shape_valid_live_candidate_class_count",
          "valid_drill_evidence_class_count",
          "live_evidence_object_count",
          "valid_live_evidence_object_count",
          "shape_valid_live_candidate_object_count",
          "drill_evidence_object_count",
          "valid_drill_evidence_object_count",
          "non_live_evidence_object_count",
          "missing_evidence_classes",
          "missing_candidate_evidence_classes",
          "missing_drill_evidence_classes",
          "status",
          "errors",
          "next_action"
        ],
        "properties": {
          "work_item_id": {
            "type": "string",
            "pattern": "^LWC-[0-9]{3}$"
          },
          "blocker_id": {
            "type": "string",
            "pattern": "^MKB-[0-9]{3}$"
          },
          "priority": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "owner_role": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence_class_count": {
            "type": "integer",
            "minimum": 1
          },
          "valid_live_evidence_class_count": {
            "const": 0
          },
          "shape_valid_live_candidate_class_count": {
            "type": "integer",
            "minimum": 0
          },
          "valid_drill_evidence_class_count": {
            "type": "integer",
            "minimum": 0
          },
          "live_evidence_object_count": {
            "type": "integer",
            "minimum": 0
          },
          "valid_live_evidence_object_count": {
            "const": 0
          },
          "shape_valid_live_candidate_object_count": {
            "type": "integer",
            "minimum": 0
          },
          "drill_evidence_object_count": {
            "type": "integer",
            "minimum": 0
          },
          "valid_drill_evidence_object_count": {
            "type": "integer",
            "minimum": 0
          },
          "non_live_evidence_object_count": {
            "type": "integer",
            "minimum": 0
          },
          "missing_evidence_classes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "missing_candidate_evidence_classes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "missing_drill_evidence_classes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "MISSING_LIVE_EVIDENCE",
              "DRILL_PARTIAL_OR_INVALID_NOT_LIVE_EVIDENCE",
              "DRILL_COMPLETE_NOT_LIVE_EVIDENCE",
              "PARTIAL_OR_INVALID_LIVE_EVIDENCE_CANDIDATE",
              "CANDIDATE_COMPLETE_AUTHENTICATION_REQUIRED"
            ]
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_action": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
