{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/MissionKernelEvidenceSubmission.json",
  "title": "Mission kernel evidence submission",
  "type": "object",
  "required": [
    "archive_version",
    "submission_id",
    "scenario_id",
    "workqueue_id",
    "source_mode",
    "no_live_deployment_claim",
    "decision",
    "boundary",
    "common_fields",
    "work_items"
  ],
  "properties": {
    "archive_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "submission_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "workqueue_id": {
      "type": "string",
      "minLength": 1
    },
    "source_mode": {
      "enum": [
        "SYNTHETIC_EMPTY_TEMPLATE",
        "AUTHORIZED_NONPRODUCTION_DRILL_RECORD",
        "LIVE_AUTHORIZED_LOCAL_RECORD"
      ]
    },
    "synthetic_only": {
      "type": "boolean"
    },
    "non_production_drill": {
      "type": "boolean"
    },
    "no_live_deployment_claim": {
      "const": true
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "release_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "boundary": {
      "type": "string",
      "minLength": 1
    },
    "common_fields": {
      "type": "object",
      "properties": {
        "jurisdiction_name": {
          "type": "string"
        },
        "election_id": {
          "type": "string"
        },
        "election_date": {
          "type": "string"
        },
        "local_authority_contact_role": {
          "type": "string"
        },
        "authority_scope_record_sha256": {
          "type": "string"
        },
        "evidence_capture_datetime_utc": {
          "type": "string"
        },
        "redaction_review_status": {
          "type": "string"
        },
        "public_release_approval_status": {
          "type": "string"
        },
        "records_retention_rule_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "work_item_id",
          "evidence_objects"
        ],
        "properties": {
          "work_item_id": {
            "type": "string",
            "pattern": "^LWC-[0-9]{3}$"
          },
          "blocker_id": {
            "type": "string",
            "pattern": "^MKB-[0-9]{3}$"
          },
          "owner_role": {
            "type": "string"
          },
          "minimum_evidence_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "submission_status": {
            "type": "string"
          },
          "evidence_objects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "evidence_class",
                "source_mode",
                "record_locator",
                "sha256",
                "approving_role",
                "redaction_status",
                "public_private_boundary",
                "byte_count",
                "records_retention_rule_ref",
                "captured_at_utc"
              ],
              "properties": {
                "evidence_class": {
                  "type": "string",
                  "minLength": 1
                },
                "source_mode": {
                  "enum": [
                    "AUTHORIZED_NONPRODUCTION_DRILL_RECORD",
                    "LIVE_AUTHORIZED_LOCAL_RECORD",
                    "SYNTHETIC_FIXTURE",
                    "DERIVED_PUBLIC_SUMMARY",
                    "GENERATED_SYNTHETIC_REPORT"
                  ]
                },
                "record_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "byte_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "approving_role": {
                  "type": "string",
                  "minLength": 1
                },
                "redaction_status": {
                  "enum": [
                    "APPROVED_PUBLIC",
                    "APPROVED_PRIVATE",
                    "WITHHELD"
                  ]
                },
                "public_private_boundary": {
                  "enum": [
                    "PUBLIC_RELEASED",
                    "REDACTED_PUBLIC_DERIVATIVE",
                    "PRIVATE_SOURCE_RECORD",
                    "WITHHELD_LEGAL_OR_PRIVACY"
                  ]
                },
                "records_retention_rule_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "captured_at_utc": {
                  "type": "string",
                  "format": "date-time"
                },
                "drill_scope": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "operator_next_action": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "authentication_state": {
      "enum": [
        "UNAUTHENTICATED_CANDIDATE_REQUIRES_SIGNED_EVIDENCE_ENVELOPE",
        "NOT_APPLICABLE_NONPRODUCTION_DRILL"
      ]
    }
  },
  "additionalProperties": false
}
