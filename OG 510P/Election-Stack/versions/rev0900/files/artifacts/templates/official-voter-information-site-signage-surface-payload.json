 shown here for this site and voting period. If conditions differ, use the listed official help route or linked official notice.","signage_is_delivery_layer_not_standalone_rulebook":true,"temporary_action_changing_signs_must_identify_site_or_route_scope":true},"signage_surface_family_label":"Example State official voter-information site-signage lane","site_classes":["polling_place","early_voting_site","ballot_drop_box_site","election_office"],"site_status_sync_policy":{"must_align_with_accessibility_and_curbside_instructions":true,"must_match_current_directory_hours_and_live_status_surfaces":true},"stale_posting_and_removal_behavior":{"publish_superseding_notice_when_route_or_room_changes_materially":true,"retain_bounded_record_of_current_signage_packet_or_removal_policy":true,"temporary_signs_must_be_removed_or_marked_stale_when_condition_ends":true},"superseded_by":null,"supersedes":null,"surface_id":"site-signage-state-2026-general"}
