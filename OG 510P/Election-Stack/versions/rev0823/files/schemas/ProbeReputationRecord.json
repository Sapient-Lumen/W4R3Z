{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ProbeReputationRecord.json",
  "title": "ProbeReputationRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "probe_id",
    "platform",
    "window",
    "scores",
    "confidence",
    "created_at",
    "created_by",
    "hashes",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "probe_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "ripe_atlas",
        "internal",
        "ooni",
        "other"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "asn": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "network_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "stop"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "stop": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability_score",
        "stability_score",
        "consistency_score",
        "interference_score"
      ],
      "properties": {
        "availability_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stability_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "consistency_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "interference_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "integrity_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs_hash",
        "code_hash"
      ],
      "properties": {
        "inputs_hash": {
          "type": "string"
        },
        "code_hash": {
          "type": "string"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "value"
      ],
      "properties": {
        "alg": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}