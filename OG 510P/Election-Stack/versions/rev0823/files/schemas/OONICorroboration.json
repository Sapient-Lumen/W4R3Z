{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OONICorroboration",
  "type": "object",
  "description": "Pointers to OONI measurements/statistics used as supplementary corroboration.",
  "additionalProperties": false,
  "properties": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "stop": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "start",
        "stop"
      ]
    },
    "filters": {
      "type": "object",
      "description": "Country/ASN/testname filters used."
    },
    "summary": {
      "type": "object",
      "description": "Aggregate indicators extracted."
    },
    "pointers": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "API URLs or dataset identifiers."
      }
    }
  },
  "required": [
    "window"
  ]
}