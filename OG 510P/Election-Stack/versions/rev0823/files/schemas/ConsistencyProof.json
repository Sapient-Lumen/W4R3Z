{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ConsistencyProof.json",
  "title": "ConsistencyProof",
  "type": "object",
  "required": [
    "from_size",
    "to_size",
    "proof_hashes_b64"
  ],
  "properties": {
    "from_size": {
      "type": "integer",
      "minimum": 0
    },
    "to_size": {
      "type": "integer",
      "minimum": 0
    },
    "proof_hashes_b64": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Base64-encoded hash node"
      },
      "description": "Consistency proof nodes"
    }
  },
  "additionalProperties": false
}