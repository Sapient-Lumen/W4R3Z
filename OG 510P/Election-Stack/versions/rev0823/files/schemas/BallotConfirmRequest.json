{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/BallotConfirmRequest.json",
  "title": "BallotConfirmRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "election_id",
    "ballot_style_hash",
    "ciphertext_commitment",
    "revote_counter",
    "request_nonce"
  ],
  "properties": {
    "election_id": {
      "type": "string",
      "minLength": 1
    },
    "ballot_style_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "ciphertext_commitment": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$",
      "description": "Hash commitment to the encrypted ballot ciphertext (or log entry hash)"
    },
    "revote_counter": {
      "type": "integer",
      "minimum": 0
    },
    "request_nonce": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{32,128}$"
    },
    "display_payload": {
      "type": "object",
      "description": "Optional human-readable choices for confirmer display; must be integrity-checked against ballot style hash."
    }
  }
}