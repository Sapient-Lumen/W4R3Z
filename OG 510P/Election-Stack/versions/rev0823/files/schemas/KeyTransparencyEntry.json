{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/KeyTransparencyEntry.json",
  "title": "KeyTransparencyEntry",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject_id", "revision", "value_sha256", "log_checkpoint", "inclusion_proof"],
  "properties": {
    "subject_id": {"type": "string", "description": "Opaque identifier for the subject (e.g., trustee key id, witness key id, parameter set id)"},
    "revision": {"type": "integer", "minimum": 1},
    "value_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},

    "log_checkpoint": {
      "type": "object",
      "additionalProperties": true,
      "description": "Checkpoint/tree-head from the key/parameter transparency log"
    },

    "inclusion_proof": {
      "type": "object",
      "additionalProperties": true,
      "description": "Inclusion proof for value_sha256 at (subject_id, revision)"
    },

    "created_at": {"type": "string", "format": "date-time"}
  }
}
