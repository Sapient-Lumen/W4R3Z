{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/hfv/EndorsementEntry.schema.json",
  "title": "EndorsementEntry",
  "type": "object",
  "required": [
    "endorsement_id",
    "issued_at",
    "issuer",
    "subject_ref",
    "statement_hash",
    "valid_from",
    "valid_until"
  ],
  "properties": {
    "endorsement_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "string"
    },
    "subject_ref": {
      "type": "string",
      "description": "ReferenceValueEntry ID (or hash) that is being endorsed."
    },
    "statement_hash": {
      "type": "string",
      "description": "Hash of the signed endorsement statement bytes."
    },
    "kind": {
      "type": "string",
      "enum": [
        "manufacturer",
        "lab",
        "authority",
        "community"
      ],
      "default": "authority"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "revocation_reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}