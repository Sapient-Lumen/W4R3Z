{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicInspectionChallenge",
  "type": "object",
  "required": ["challenge_id", "issued_by", "issued_at", "window", "targets", "nonce", "signature"],
  "properties": {
    "challenge_id": {"type": "string"},
    "issued_by": {"type": "string"},
    "issued_at": {"type": "string", "format": "date-time"},
    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "ref"],
        "properties": {
          "type": {"type": "string", "enum": ["checkpoint", "artifact_hash", "endpoint", "locale", "jurisdiction"]},
          "ref": {"type": "string"}
        }
      },
      "minItems": 1
    },
    "nonce": {"type": "string"},
    "signature": {"type": "string"}
  },
  "additionalProperties": false
}
