{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/hfv/CDFMappingManifest.schema.json",
  "title": "CDFMappingManifest",
  "type": "object",
  "required": ["election_id", "bd_hash", "versions", "ballot_style_map", "contest_map", "reporting_unit_map"],
  "properties": {
    "election_id": {"type": "string"},
    "bd_hash": {"type": "string"},
    "versions": {
      "type": "object",
      "required": ["bd", "cvr", "err", "eel"],
      "properties": {
        "bd": {"type": "string"},
        "cvr": {"type": "string"},
        "err": {"type": "string"},
        "eel": {"type": "string"}
      },
      "additionalProperties": false
    },
    "ballot_style_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ballot_style_id", "gp_unit_ids"],
        "properties": {
          "ballot_style_id": {"type": "string"},
          "gp_unit_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "contest_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bd_contest_id", "err_contest_id"],
        "properties": {
          "bd_contest_id": {"type": "string"},
          "err_contest_id": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "option_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bd_option_id", "err_option_id"],
        "properties": {
          "bd_option_id": {"type": "string"},
          "err_option_id": {"type": "string"}
        },
        "additionalProperties": false
      },
      "default": []
    },
    "reporting_unit_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gp_unit_id", "type"],
        "properties": {
          "gp_unit_id": {"type": "string"},
          "type": {"type": "string"},
          "parents": {"type": "array", "items": {"type": "string"}},
          "children": {"type": "array", "items": {"type": "string"}},
          "external_ids": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "manifest_hash": {"type": "string"}
  },
  "additionalProperties": false
}
