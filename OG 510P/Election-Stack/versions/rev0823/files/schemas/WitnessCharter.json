{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WitnessCharter",
  "type": "object",
  "required": ["witness_id", "legal_entity", "jurisdiction", "categories", "signing_keys", "contacts", "version", "issued_at"],
  "properties": {
    "witness_id": {"type": "string"},
    "legal_entity": {"type": "string"},
    "jurisdiction": {"type": "string"},
    "categories": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "controlling_parties": {"type": "array", "items": {"type": "string"}},
    "funding_summary": {"type": "string"},
    "signing_keys": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "hosting_notes": {"type": "string"},
    "contacts": {
      "type": "object",
      "required": ["security", "operations"],
      "properties": {
        "security": {"type": "string"},
        "operations": {"type": "string"},
        "public": {"type": "string"}
      }
    },
    "version": {"type": "string"},
    "issued_at": {"type": "string", "format": "date-time"}
  }
}
