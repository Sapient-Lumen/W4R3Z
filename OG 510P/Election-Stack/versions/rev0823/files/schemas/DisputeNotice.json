{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DisputeNotice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dispute_id",
    "issued_at",
    "issuer_id",
    "contested",
    "claims",
    "requested_action",
    "signature"
  ],
  "properties": {
    "dispute_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer_id": {
      "type": "string"
    },
    "contested": {
      "type": "object",
      "additionalProperties": true
    },
    "claims": {
      "type": "string"
    },
    "requested_action": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "./EvidencePointer.json"
      }
    },
    "signature": {
      "type": "string"
    }
  }
}
