{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/UnreachabilityProof.json",
  "title": "UnreachabilityProof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_id",
    "target",
    "window",
    "probe_results",
    "controls",
    "created_at",
    "created_by",
    "hashes",
    "signature"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "proof_id": { "type": "string" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identifier"],
      "properties": {
        "type": { "type": "string", "enum": ["url", "host", "ip", "onion", "content_hash"] },
        "identifier": { "type": "string" },
        "expected_hash": { "type": ["string", "null"] }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "time_proofs": {
          "description": "Optional secure time receipts or notarization references.",
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "probe_results": {
      "description": "Probe results that indicate unreachability. Each entry may embed a result or reference an external measurement.",
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "result"],
        "properties": {
          "source": { "type": "string", "enum": ["internal", "ripe_atlas", "ooni", "other"] },
          "result": {
            "description": "Embedded AvailabilityProbeResult or external reference.",
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "controls": {
      "description": "Control probes to distinguish local failure from targeted suppression.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "independence_claims": {
      "description": "Structured claims about vantage diversity (ASN/region/operator).",
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string" },
    "hashes": {
      "description": "Content hashes for embedded blobs (raw transcripts, pcaps, etc.)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "alg", "hash"],
        "properties": {
          "name": { "type": "string" },
          "alg": { "type": "string" },
          "hash": { "type": "string" }
        }
      }
    },
    "notes": { "type": ["string", "null"] },
    "signature": {
      "description": "Signature over canonicalized fields (excluding signature).",
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "sig"],
      "properties": {
        "alg": { "type": "string" },
        "sig": { "type": "string" }
      }
    }
  }
}
