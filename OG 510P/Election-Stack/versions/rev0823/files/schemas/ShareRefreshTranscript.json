{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ShareRefreshTranscript.json",
  "title": "ShareRefreshTranscript",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "election_id",
    "committee",
    "protocol_id",
    "created_at",
    "transcript_sha256",
    "signatures"
  ],
  "properties": {
    "election_id": {"type": "string"},

    "committee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "member_ids"],
      "properties": {
        "threshold": {"type": "integer", "minimum": 1},
        "member_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },

    "protocol_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},

    "transcript_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},

    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signer_id", "alg", "sig"],
        "properties": {
          "signer_id": {"type": "string"},
          "alg": {"type": "string"},
          "sig": {"type": "string"}
        }
      }
    }
  }
}
