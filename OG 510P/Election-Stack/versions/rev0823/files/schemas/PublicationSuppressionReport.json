{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/PublicationSuppressionReport.json",
  "title": "PublicationSuppressionReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "reported_by",
    "reported_at",
    "expected_kind",
    "subject",
    "trigger",
    "deadline",
    "evidence",
    "signature"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "reported_by": {
      "type": "string"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "expected_kind": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "election_id"
      ],
      "properties": {
        "election_id": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "scope_hint": {
          "type": "string"
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "trigger_time"
      ],
      "properties": {
        "trigger": {
          "type": "string"
        },
        "trigger_time": {
          "type": "string",
          "format": "date-time"
        },
        "reference": {
          "type": "string",
          "description": "Optional reference to a related envelope/object that should have caused the publication."
        }
      }
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "probe_log",
              "log_query",
              "statement",
              "pointer"
            ]
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "signature": {
      "type": "string",
      "description": "Detached signature placeholder for the report payload; real deployments rely on the envelope signature."
    }
  }
}
