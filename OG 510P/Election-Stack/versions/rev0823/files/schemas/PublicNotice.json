{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/PublicNotice.json",
  "title": "PublicNotice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notice_id",
    "notice_version",
    "issued_at",
    "notice_type",
    "title",
    "message",
    "election_scope"
  ],
  "properties": {
    "notice_id": {
      "type": "string",
      "description": "Stable identifier for this notice (content may change via corrections)."
    },
    "notice_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Schema version of this notice payload."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_update_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional measurable commitment: when the next update will be published (if applicable)."
    },
    "notice_type": {
      "type": "string",
      "enum": [
        "status_update",
        "incident_advisory",
        "correction",
        "audit_result",
        "incident_declaration",
        "rumor_control",
        "election_milestone",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "description": "Short, plain-language statement intended to be mirrored verbatim."
    },
    "details_markdown": {
      "type": "string",
      "description": "Optional longer text; keep concise."
    },
    "election_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "election_id",
        "jurisdiction"
      ],
      "properties": {
        "election_id": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "precinct": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "correction_of": {
      "type": "string",
      "description": "DEPRECATED alias for correction_of_notice_id (kept for backwards compatibility). Prefer correction_of_notice_id. If both are present, correction_of_notice_id is authoritative."
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_type",
          "ref"
        ],
        "properties": {
          "ref_type": {
            "type": "string",
            "enum": [
              "evidence_packet",
              "envelope",
              "url",
              "other"
            ]
          },
          "ref": {
            "type": "string",
            "description": "Content-addressed digest/uri, or URL."
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Where this notice was published. Prefer canonical channel IDs from artifacts/registries/official-channels.csv (e.g., official_website, status_page) so parity checks are unambiguous."
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional target audience tags."
    },
    "notes": {
      "type": "string"
    },
    "supersedes_notice_id": {
      "type": "string",
      "description": "If this notice supersedes a previous notice, record its notice_id."
    },
    "correction_of_notice_id": {
      "type": "string",
      "description": "If notice_type==correction, the notice_id being corrected. Prefer this field (not correction_of)."
    },
    "related_trigger_event_id": {
      "type": "string",
      "description": "Optional trigger event_id this notice addresses (PublicationTriggerEvent)."
    },
    "milestone_id": {
      "type": "string",
      "description": "If notice_type==election_milestone, a stable milestone identifier (see artifacts/registries/election-milestones.csv)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "notice_type": {
            "const": "correction"
          }
        },
        "required": [
          "notice_type"
        ]
      },
      "then": {
        "required": [
          "correction_of_notice_id"
        ]
      }
    },
    {
      "if": {
        "required": [
          "correction_of_notice_id"
        ]
      },
      "then": {
        "properties": {
          "notice_type": {
            "const": "correction"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "notice_type": {
            "const": "election_milestone"
          }
        },
        "required": [
          "notice_type"
        ]
      },
      "then": {
        "required": [
          "milestone_id"
        ]
      }
    }
  ]
}
