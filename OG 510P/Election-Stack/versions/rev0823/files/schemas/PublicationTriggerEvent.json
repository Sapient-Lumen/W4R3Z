{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/PublicationTriggerEvent.json",
  "title": "PublicationTriggerEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "version",
    "trigger_id",
    "occurred_at",
    "observed_by",
    "election_scope"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Stable identifier for this trigger event (UUID or similar)."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Schema version of this payload."
    },
    "trigger_id": {
      "type": "string",
      "description": "Trigger identifier (see artifacts/registries/publication-triggers.csv)."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "observed_by": {
      "type": "string",
      "description": "Entity asserting the trigger occurred (operator or watcher)."
    },
    "election_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "election_id"
      ],
      "properties": {
        "election_id": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "high",
        "critical"
      ],
      "description": "Optional severity of the underlying situation."
    },
    "description": {
      "type": "string",
      "description": "Short human-readable description of what happened."
    },
    "evidence_hint": {
      "type": "string",
      "description": "Optional pointer-like hint (URL or object reference) for supporting evidence."
    },
    "related_notice_id": {
      "type": "string",
      "description": "Optional PublicNotice.notice_id expected to cover this trigger."
    }
  }
}