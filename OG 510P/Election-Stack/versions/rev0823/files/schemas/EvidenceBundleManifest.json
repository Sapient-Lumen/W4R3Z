{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/EvidenceBundleManifest.json",
  "title": "EvidenceBundleManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_version",
    "created_at",
    "created_by",
    "election_id",
    "crypto_policy",
    "artifacts",
    "signatures"
  ],
  "properties": {
    "bundle_version": {
      "type": "string",
      "description": "Bundle/packet manifest format version (semver-ish).",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\n\\r]+$",
      "description": "Tool or operator label that produced the bundle manifest. Avoid embedding secrets or absolute paths."
    },
    "election_id": {
      "type": "string",
      "minLength": 1
    },
    "crypto_policy": {
      "$ref": "CryptoPolicy.json"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "media_type",
          "digest",
          "url",
          "size_bytes",
          "kind",
          "schema"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n\\r]+$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n\\r]+$"
          },
          "sha256": {
            "type": "string",
            "description": "Optional raw sha256 hex (legacy/UX convenience). Prefer 'digest'.",
            "pattern": "^[0-9a-f]{64}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n\\r]+$",
            "description": "Bundle-relative path or retrieval hint. Canonical bytes are addressed by 'digest'."
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9_.-]+$",
            "description": "Kind label for this artifact (envelope/payload/attachment/etc)."
          },
          "schema": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n\\r]+$",
            "description": "Schema path/identifier for this artifact (best-effort)."
          },
          "notes": {
            "type": "string",
            "pattern": "^[^\\n\\r]*$"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Operator notes. Keep bounded and non-partisan."
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "description": "Signatures over this manifest object. Production bundles SHOULD be signed; examples may use placeholders.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signer_id", "alg", "sig"],
        "properties": {
          "signer_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n\\r]+$"
          },
          "alg": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n\\r]+$"
          },
          "sig": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n\\r]+$"
          },
          "kid": {
            "type": "string",
            "pattern": "^[^\\n\\r]+$",
            "description": "Optional key identifier (if signatures are not self-describing)."
          }
        }
      }
    }
  }
}
