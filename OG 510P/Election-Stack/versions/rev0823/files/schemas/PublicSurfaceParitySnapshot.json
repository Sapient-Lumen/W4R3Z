{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/PublicSurfaceParitySnapshot.json",
  "title": "PublicSurfaceParitySnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "snapshot_version",
    "observed_at",
    "election_scope",
    "subject",
    "observations"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "description": "Stable identifier for this snapshot series (updates may chain via previous_snapshot_sha256)."
    },
    "snapshot_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Schema version of this snapshot payload."
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this snapshot was produced (best effort)."
    },
    "election_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "election_id",
        "jurisdiction"
      ],
      "properties": {
        "election_id": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_kind",
        "stable_target"
      ],
      "properties": {
        "surface_kind": {
          "type": "string",
          "enum": [
            "well_known_discovery",
            "official_channel_directory",
            "public_notice_feed_latest",
            "public_notice_feed",
            "public_notice_signing_keyset",
            "status_board",
            "other"
          ],
          "description": "Named public surface being checked (keep the vocabulary small; add via change control)."
        },
        "stable_target": {
          "type": "string",
          "description": "Stable path/identifier for the surface (e.g., /notices/feed/latest.json or /status/)."
        },
        "expected_envelope_kind": {
          "type": "string",
          "description": "Optional expected EvidenceEnvelope.kind when the surface serves an envelope (e.g., hfv.public.notice_feed)."
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "previous_snapshot_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Optional digest of the prior snapshot payload in this series (anti-rollback / anti-rewrite)."
    },
    "announcing_notice_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Optional digest of a PublicNotice envelope that announced this snapshot or parity failure."
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "fetched_at",
          "url",
          "http_status",
          "body_sha256"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "description": "Official channel ID from artifacts/registries/official-channels.csv."
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this channel fetch was performed (best effort)."
          },
          "url": {
            "type": "string",
            "description": "Fetch location used for this observation."
          },
          "http_status": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999,
            "description": "HTTP status code (0 permitted for non-HTTP failures)."
          },
          "content_type": {
            "type": "string",
            "description": "Optional response Content-Type."
          },
          "body_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Digest of raw response body bytes (works even for error pages/WAF blocks)."
          },
          "body_evidence": {
            "$ref": "./EvidencePointer.json",
            "description": "Optional pointer to detached raw response bytes (use sparingly; hashes-first)."
          },
          "envelope_kind": {
            "type": "string",
            "description": "When parseable, the served EvidenceEnvelope.kind."
          },
          "envelope_payload_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "When parseable, the served envelope.payload_digest (recomputed digest preferred)."
          },
          "envelope_tbs_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "When parseable, the served envelope.tbs_digest (recomputed digest preferred)."
          },
          "parse_error": {
            "type": "string",
            "description": "Optional short parse error hint (bounded)."
          },
          "notes": {
            "type": "string",
            "description": "Optional short note (avoid narratives)."
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Optional short notes; avoid narratives."
    }
  }
}
