{
  "hfv_version": "1.0",
  "type": "signed_digest_statement",
  "id": "urn:tes:sds:v1:${UUID}",
  "issued_at": "${RFC3339_TIMESTAMP}",
  "issuer": {
    "org": "${ORG_NAME}",
    "key_id": "${KEY_ID}",
    "key_ref": "${KEY_REF_OR_CERT_FINGERPRINT}"
  },
  "subject": {
    "kind": "evidence_surface_digest",
    "digest": {
      "alg": "sha256",
      "value": "${HEX_SHA256}"
    },
    "surface_ref": "docs/${SURFACE_DOC_NUMBER}",
    "surface_instance_id": "${SURFACE_INSTANCE_ID}"
  },
  "claims": {
    "summary": "${SHORT_ASSERTION}",
    "scope_includes": [
      "${...}"
    ],
    "scope_excludes": [
      "${...}"
    ],
    "policy_refs": [
      "docs/282",
      "docs/283"
    ]
  },
  "triage": {
    "severity": "${low|medium|high|critical}",
    "confidence": "${low|medium|high}",
    "pii_risk": "${none|low|medium|high}"
  },
  "disclosure": {
    "level": "${digest_only|packet_available|packet_released}",
    "packet_ref": "${OPTIONAL_DISCLOSURE_PACKET_ID}"
  },
  "signature": {
    "envelope": "${dsse|cose|jose|raw_detached}",
    "payload_canonicalization": "${CANONICALIZATION_PROFILE}",
    "sig_alg": "${ALG}",
    "value_b64": "${BASE64_SIGNATURE}",
    "signing_input_hint": "Sign the canonical serialized statement with signature.value_b64 omitted."
  },
  "receipts": [
    {
      "kind": "${rekor|ct|scitt|other}",
      "log_id": "${LOG_ID}",
      "entry_id": "${ENTRY_ID}",
      "inclusion_proof_b64": "${OPTIONAL}",
      "checkpoint_b64": "${OPTIONAL}",
      "note": "Receipt is optional; include if independently verifiable."
    }
  ]
}
