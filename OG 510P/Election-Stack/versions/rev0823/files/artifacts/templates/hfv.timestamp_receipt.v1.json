{
  "hfv_version": "1.0",
  "type": "timestamp_receipt",
  "id": "urn:tes:tsr:v1:${UUID}",
  "issued_at": "${RFC3339_TIMESTAMP}",
  "method": "${rfc3161|transparency_log|witness_cosign}",
  "issuer": {
    "org": "${ISSUER_ORG}",
    "service_id": "${SERVICE_ID_OR_LOG_ID}",
    "key_ref": "${CERT_FINGERPRINT_OR_KEY_ID}",
    "policy": "${OPTIONAL_POLICY_OID_OR_PROFILE}"
  },
  "subject": {
    "kind": "digest",
    "digest": {
      "alg": "sha256",
      "value": "${HEX_SHA256}"
    },
    "subject_ref": "${OPTIONAL_URN_OR_POINTER}"
  },
  "receipt": {
    "token_hash": {
      "alg": "sha256",
      "value": "${HEX_SHA256_OF_TOKEN}"
    },
    "claimed_time": "${RFC3339_TIMESTAMP}",
    "receipt_ref": "${SEALED_POINTER_TO_FULL_TOKEN}"
  },
  "triage": {
    "severity": "${low|medium|high|critical}",
    "confidence": "${low|medium|high}",
    "pii_risk": "${none|low|medium|high}"
  },
  "references": [
    {
      "kind": "source_doc",
      "ref": "docs/287"
    },
    {
      "kind": "related",
      "ref": "docs/285"
    }
  ],
  "notes": "${SHORT_NOTE}"
}
