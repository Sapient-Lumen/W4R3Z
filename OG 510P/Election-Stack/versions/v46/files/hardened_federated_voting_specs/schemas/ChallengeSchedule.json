{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChallengeSchedule",
  "type": "object",
  "required": [
    "schedule_id",
    "published_by",
    "published_at",
    "rounds",
    "quota_policy_ref",
    "signature"
  ],
  "properties": {
    "schedule_id": {
      "type": "string"
    },
    "published_by": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "round_id",
          "seed_source",
          "seed_locator",
          "start",
          "end"
        ],
        "properties": {
          "round_id": {
            "type": "integer",
            "minimum": 0
          },
          "seed_source": {
            "type": "string",
            "enum": [
              "NIST_BEACON",
              "PBB_CHECKPOINT",
              "ATL_CHECKPOINT",
              "SCITT_RECEIPT"
            ]
          },
          "seed_locator": {
            "type": "string",
            "description": "How to fetch/derive the seed (e.g., NIST pulse time or checkpoint id)"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "quota_policy_ref": {
      "type": "string",
      "description": "Digest or pointer to ChallengeQuotaPolicy"
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}