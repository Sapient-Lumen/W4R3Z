{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/VerifierReport.json",
  "title": "VerifierReport",
  "type": "object",
  "required": [
    "election_id",
    "verifier_id",
    "version",
    "build_hash_b64",
    "dependency_lock_hash_b64",
    "supported_crypto_suites",
    "conformance_result",
    "signature_b64"
  ],
  "properties": {
    "election_id": { "type": "string", "minLength": 1 },
    "verifier_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "build_hash_b64": { "type": "string" },
    "dependency_lock_hash_b64": { "type": "string" },
    "supported_crypto_suites": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "conformance_result": {
      "type": "string",
      "enum": ["PASS", "FAIL", "PASS_WITH_WARNINGS"]
    },
    "warnings": { "type": "array", "items": { "type": "string" }, "default": [] },
    "signature_b64": { "type": "string", "description": "Signature over canonical report fields" }
  },
  "additionalProperties": false
}
