{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ProbeQualitySignal.json",
  "title": "ProbeQualitySignal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signal_id",
    "probe_id",
    "window",
    "signals",
    "created_at",
    "created_by",
    "hashes",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "signal_id": {
      "type": "string"
    },
    "probe_id": {
      "type": "string"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "stop"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "stop": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrent_load_index",
        "jitter_index",
        "loss_index"
      ],
      "properties": {
        "concurrent_load_index": {
          "type": "number",
          "minimum": 0
        },
        "jitter_index": {
          "type": "number",
          "minimum": 0
        },
        "loss_index": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs_hash",
        "code_hash"
      ],
      "properties": {
        "inputs_hash": {
          "type": "string"
        },
        "code_hash": {
          "type": "string"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "value"
      ],
      "properties": {
        "alg": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}