{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReferenceValueUpdate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_value_id",
    "issued_at",
    "publisher_id",
    "subject",
    "reference_values",
    "signature"
  ],
  "properties": {
    "reference_value_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "publisher_id": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "additionalProperties": true
    },
    "reference_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "digest"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[A-Fa-f0-9]{64}$"
          },
          "label": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "signature": {
      "type": "string"
    }
  }
}
