{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProbeCohortPlan",
  "type": "object",
  "required": ["plan_id", "election_id", "created_at", "target_n", "constraints", "selection_method", "commitment"],
  "properties": {
    "plan_id": {"type": "string"},
    "election_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "target_n": {"type": "integer", "minimum": 1},
    "constraints": {
      "type": "object",
      "properties": {
        "max_per_country": {"type": "integer", "minimum": 1},
        "max_per_asn": {"type": "integer", "minimum": 1},
        "min_countries": {"type": "integer", "minimum": 1},
        "min_asns": {"type": "integer", "minimum": 1},
        "quota_by_region": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "additionalProperties": false
    },
    "selection_method": {
      "type": "string",
      "enum": ["quota_round_robin", "topology_diverse_metis_style", "hybrid"]
    },
    "input_dataset": {
      "type": "object",
      "properties": {
        "source": {"type": "string"},
        "dataset_hash": {"type": "string"},
        "as_of": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "selected_probe_ids": {
      "type": "array",
      "items": {"type": "integer"},
      "uniqueItems": true
    },
    "commitment": {
      "type": "object",
      "required": ["plan_hash", "signature"],
      "properties": {
        "plan_hash": {"type": "string"},
        "signature": {"type": "string"},
        "signing_key_id": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
