{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/BallotSubmission.json",
  "title": "BallotSubmission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "election_id",
    "ballot_ciphertext_b64",
    "ballot_proof_b64",
    "eligibility_proof",
    "client_nonce_b64",
    "client_timestamp_ms"
  ],
  "properties": {
    "election_id": {
      "type": "string",
      "minLength": 1
    },
    "ballot_ciphertext_b64": {
      "type": "string",
      "description": "Base64-encoded ballot ciphertext"
    },
    "ballot_proof_b64": {
      "type": "string",
      "description": "Base64-encoded well-formedness proof bundle"
    },
    "eligibility_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "proof_b64"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "signature",
            "anon_credential_proof",
            "one_time_token"
          ]
        },
        "proof_b64": {
          "type": "string",
          "description": "Base64-encoded proof material"
        }
      }
    },
    "client_nonce_b64": {
      "type": "string",
      "description": "Base64-encoded random nonce (>=128 bits recommended)"
    },
    "client_timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "revote_hint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "none",
            "last_vote_counts"
          ]
        },
        "counter": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}