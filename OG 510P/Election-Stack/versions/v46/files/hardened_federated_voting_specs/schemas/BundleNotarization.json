{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BundleNotarization",
  "type": "object",
  "required": [
    "artifact_hash",
    "hash_alg",
    "notarizations"
  ],
  "properties": {
    "artifact_hash": {
      "type": "string"
    },
    "hash_alg": {
      "type": "string",
      "enum": [
        "sha256"
      ]
    },
    "notarizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "created_at"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "rfc3161_tst",
              "transparency_log_inclusion",
              "countersignature"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          }
        }
      }
    }
  }
}