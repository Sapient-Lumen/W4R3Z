{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SimulationReport",
  "type": "object",
  "required": ["sim_id", "election_id", "generated_at", "runs", "metrics"],
  "properties": {
    "sim_id": {"type": "string"},
    "election_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "runs": {"type": "integer"},
    "metrics": {
      "type": "object",
      "required": ["p_detect_by_t", "mttd_s"],
      "properties": {
        "p_detect_by_t": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["t_s", "p"],
            "properties": {
              "t_s": {"type": "integer", "minimum": 1},
              "p": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "additionalProperties": false
          }
        },
        "mttd_s": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "assumptions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
