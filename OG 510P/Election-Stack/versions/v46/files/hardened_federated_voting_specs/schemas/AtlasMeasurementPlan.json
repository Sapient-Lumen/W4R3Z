{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AtlasMeasurementPlan",
  "type": "object",
  "description": "Plan describing how to run RIPE Atlas measurements for availability evidence.",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "election_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "https",
              "http",
              "dns",
              "icmp"
            ]
          },
          "target": {
            "type": "string",
            "description": "Hostname or IP"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "target"
        ]
      }
    },
    "probe_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "selection": {
            "type": "object",
            "description": "RIPE Atlas probe selection parameters (country_code, asn, tags, etc)."
          },
          "min_probes": {
            "type": "integer",
            "minimum": 1
          },
          "max_probes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "label",
          "selection",
          "min_probes",
          "max_probes"
        ]
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "k_min": {
          "type": "integer",
          "minimum": 1
        },
        "p_unreachable": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "rtt_ms_max": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "k_min",
        "p_unreachable"
      ]
    },
    "ethics_policy_ref": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "election_id",
    "created_at",
    "targets",
    "probe_sets",
    "thresholds"
  ]
}