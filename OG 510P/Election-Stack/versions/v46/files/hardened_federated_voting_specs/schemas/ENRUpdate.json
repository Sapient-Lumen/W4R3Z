{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ENRUpdate.json",
  "title": "ENRUpdate",
  "type": "object",
  "required": [
    "election_id",
    "update_id",
    "sequence",
    "generated_at",
    "prev_hash",
    "payload_hash",
    "signature"
  ],
  "properties": {
    "election_id": {
      "type": "string"
    },
    "update_id": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp"
    },
    "prev_hash": {
      "type": "string",
      "description": "Hash of previous ENRUpdate canonical bytes"
    },
    "payload_hash": {
      "type": "string",
      "description": "Hash of payload bytes (results data)"
    },
    "payload_uri": {
      "type": "string"
    },
    "status_banner": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "required": [
        "alg",
        "key_id",
        "sig"
      ],
      "properties": {
        "alg": {
          "type": "string"
        },
        "key_id": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}