{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/PublicNotice.json",
  "title": "PublicNotice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notice_id",
    "notice_version",
    "issued_at",
    "notice_type",
    "title",
    "message",
    "election_scope"
  ],
  "properties": {
    "notice_id": {
      "type": "string",
      "description": "Stable identifier for this notice (content may change via corrections)."
    },
    "notice_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Schema version of this notice payload."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "notice_type": {
      "type": "string",
      "enum": [
        "status_update",
        "incident_advisory",
        "correction",
        "audit_result",
        "incident_declaration",
        "rumor_control",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "description": "Short, plain-language statement intended to be mirrored verbatim."
    },
    "details_markdown": {
      "type": "string",
      "description": "Optional longer text; keep concise."
    },
    "election_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "election_id",
        "jurisdiction"
      ],
      "properties": {
        "election_id": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "precinct": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "correction_of": {
      "type": "string",
      "description": "If this is a correction, the notice_id it corrects."
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_type",
          "ref"
        ],
        "properties": {
          "ref_type": {
            "type": "string",
            "enum": [
              "evidence_packet",
              "envelope",
              "url",
              "other"
            ]
          },
          "ref": {
            "type": "string",
            "description": "Content-addressed digest/uri, or URL."
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Where this notice was published (e.g., website, social handle)."
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional target audience tags."
    },
    "notes": {
      "type": "string"
    },
    "supersedes_notice_id": {
      "type": "string",
      "description": "If this notice supersedes a previous notice, record its notice_id."
    },
    "correction_of_notice_id": {
      "type": "string",
      "description": "If notice_type==correction, the notice_id being corrected."
    },
    "related_trigger_event_id": {
      "type": "string",
      "description": "Optional trigger event_id this notice addresses (PublicationTriggerEvent)."
    }
  }
}