{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ResultsReleasePackage.json",
  "title": "ResultsReleasePackage",
  "type": "object",
  "required": [
    "election_id",
    "epb_hash",
    "checkpoint",
    "enr_updates",
    "generated_at",
    "package_signature"
  ],
  "properties": {
    "election_id": {
      "type": "string"
    },
    "epb_hash": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "checkpoint": {
      "type": "object"
    },
    "enr_updates": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Hashes or URIs of ENRUpdate objects"
      }
    },
    "notarizations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "human_summary_uri": {
      "type": "string"
    },
    "package_signature": {
      "type": "object",
      "required": [
        "alg",
        "key_id",
        "sig"
      ],
      "properties": {
        "alg": {
          "type": "string"
        },
        "key_id": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}