{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FundingTransparencyReport",
  "type": "object",
  "required": ["entity_id", "period_start", "period_end", "funding_sources", "issued_at"],
  "properties": {
    "entity_id": {"type": "string"},
    "period_start": {"type": "string", "format": "date"},
    "period_end": {"type": "string", "format": "date"},
    "funding_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "kind"],
        "properties": {
          "source": {"type": "string"},
          "kind": {"type": "string", "enum": ["cash", "in_kind", "cloud_credits", "staffing", "other"]},
          "amount_range": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    },
    "issued_at": {"type": "string", "format": "date-time"}
  }
}
