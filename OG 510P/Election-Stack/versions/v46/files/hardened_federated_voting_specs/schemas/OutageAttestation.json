{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutageAttestation",
  "type": "object",
  "required": [
    "schema_version",
    "incident_id",
    "incident_class",
    "scope",
    "detected_at",
    "evidence",
    "signatures"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "incident_id": {
      "type": "string"
    },
    "incident_class": {
      "type": "string",
      "enum": [
        "UNREACHABLE",
        "DEGRADED",
        "PARTITION",
        "SPLIT_VIEW",
        "DNS_TLS_ANOMALY",
        "DDOS_MITIGATION_ACTIVE"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifact_hashes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audience_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "estimated_start": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "object",
      "required": [
        "apr_hashes"
      ],
      "properties": {
        "apr_hashes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rollup": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "signatures": {
      "type": "object",
      "required": [
        "operator",
        "witnesses"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "description": "Detached signature"
        },
        "witnesses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "notarization": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional timestamp/log notarization record hash"
    }
  }
}