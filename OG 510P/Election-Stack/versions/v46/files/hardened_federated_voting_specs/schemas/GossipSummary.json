{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/GossipSummary.json",
  "title": "GossipSummary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary_version",
    "scope",
    "generated_at",
    "observations"
  ],
  "properties": {
    "summary_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["election_id", "window"],
      "properties": {
        "election_id": {"type": "string"},
        "jurisdiction": {"type": "string"},
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string", "format": "date-time"},
            "end": {"type": "string", "format": "date-time"}
          }
        },
        "seed": {
          "type": "string",
          "description": "Optional public randomness seed used to select which items are summarized."
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "digest", "status"],
        "properties": {
          "kind": {"type": "string"},
          "digest": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
          "status": {"type": "string", "enum": ["observed", "missing", "suppressed"]},
          "note": {"type": "string"}
        }
      }
    },
    "signer_hint": {"type": "string"},
    "notes": {"type": "string"}
  }
}
