{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicInspectionGossipMessage",
  "type": "object",
  "required": [
    "msg_id",
    "sent_by",
    "sent_at",
    "checkpoint_refs",
    "challenge_digests",
    "response_digests",
    "suppression_digests",
    "signature"
  ],
  "properties": {
    "msg_id": {
      "type": "string"
    },
    "sent_by": {
      "type": "string",
      "description": "Watcher/monitor/witness identifier"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "checkpoint_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "log",
          "checkpoint_hash"
        ],
        "properties": {
          "log": {
            "type": "string",
            "enum": [
              "PBB",
              "ATL",
              "SCITT"
            ]
          },
          "checkpoint_hash": {
            "type": "string"
          }
        }
      }
    },
    "challenge_digests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "challenge_id",
          "digest"
        ],
        "properties": {
          "challenge_id": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        }
      }
    },
    "response_digests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "response_id",
          "digest"
        ],
        "properties": {
          "response_id": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        }
      }
    },
    "suppression_digests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "report_id",
          "digest"
        ],
        "properties": {
          "report_id": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        }
      }
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}