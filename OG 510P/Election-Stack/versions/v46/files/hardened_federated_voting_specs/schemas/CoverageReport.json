{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/CoverageReport.json",
  "title": "CoverageReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "watchers",
    "targets_total",
    "targets_touched",
    "target_coverage",
    "challenges_issued",
    "suppressions",
    "suppression_rate"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "watchers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "targets_total": {
      "type": "integer",
      "minimum": 0
    },
    "targets_touched": {
      "type": "integer",
      "minimum": 0
    },
    "target_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "challenges_issued": {
      "type": "integer",
      "minimum": 0
    },
    "suppressions": {
      "type": "integer",
      "minimum": 0
    },
    "suppression_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "max_rounds_seen_for_any_target": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "string"
    }
  }
}
