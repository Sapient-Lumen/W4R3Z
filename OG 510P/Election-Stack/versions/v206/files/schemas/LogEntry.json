{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/LogEntry.json",
  "title": "LogEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_type",
    "election_id",
    "payload_hash_b64",
    "server_timestamp_ms",
    "node_id",
    "node_signature_b64"
  ],
  "properties": {
    "entry_type": {
      "type": "string",
      "enum": [
        "BALLOT",
        "PARAMS",
        "REVOCATION",
        "CLOSE",
        "OTHER"
      ]
    },
    "election_id": {
      "type": "string",
      "minLength": 1
    },
    "payload_hash_b64": {
      "type": "string",
      "description": "Base64-encoded hash of canonical payload"
    },
    "server_timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "node_signature_b64": {
      "type": "string",
      "description": "Signature over canonical LogEntry fields"
    },
    "sth_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tree_size": {
          "type": "integer",
          "minimum": 0
        },
        "root_hash_b64": {
          "type": "string"
        }
      }
    }
  }
}