{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/DisclosurePolicy.json",
  "title": "DisclosurePolicy",
  "type": "object",
  "required": [
    "election_id",
    "version",
    "tally_visibility",
    "min_cell_size",
    "release_schedule"
  ],
  "properties": {
    "election_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "tally_visibility": {
      "type": "string",
      "enum": [
        "public_full_tally",
        "tally_hiding",
        "coarsened_only"
      ]
    },
    "min_cell_size": {
      "type": "integer",
      "minimum": 0,
      "description": "Minimum number of ballots/voters per published cell."
    },
    "allowed_breakdowns": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "jurisdiction",
          "precinct",
          "contest",
          "round",
          "none"
        ]
      },
      "default": [
        "jurisdiction",
        "contest"
      ]
    },
    "release_schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "earliest_time"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "unofficial_partial",
              "unofficial_final",
              "certified",
              "post_certification_research"
            ]
          },
          "earliest_time": {
            "type": "string",
            "description": "ISO 8601 or policy descriptor."
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "dp_optional": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "epsilon": {
          "type": "number",
          "minimum": 0
        },
        "delta": {
          "type": "number",
          "minimum": 0
        },
        "mechanism": {
          "type": "string"
        },
        "sensitivity_notes": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}