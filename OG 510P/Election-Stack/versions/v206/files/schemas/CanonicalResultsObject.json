{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/hfv/CanonicalResultsObject.schema.json",
  "title": "CanonicalResultsObject (CRO)",
  "type": "object",
  "required": ["election_id", "epb_hash", "results_format", "reporting_time", "results", "cro_hash"],
  "properties": {
    "election_id": {"type": "string"},
    "epb_hash": {"type": "string", "description": "Hash of the ElectionParameterBundle"},
    "results_format": {"type": "string", "description": "e.g., NIST-ERR-1500-100r2"},
    "reporting_time": {"type": "string", "format": "date-time"},
    "unofficial": {"type": "boolean", "default": true},
    "counts_status": {"type": "string"},
    "report_detail_level": {"type": "string"},
    "results": {"type": "object", "description": "Canonical ERR payload or equivalent"},
    "cro_hash": {"type": "string", "description": "Hash over canonicalized CRO bytes"}
  },
  "additionalProperties": false
}
