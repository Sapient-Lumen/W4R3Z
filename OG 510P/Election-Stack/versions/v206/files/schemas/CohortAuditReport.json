{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/CohortAuditReport.json",
  "title": "CohortAuditReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "cohort_plan_hash",
    "window",
    "distributions",
    "metrics",
    "excluded_probes",
    "created_at",
    "created_by",
    "hashes",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "audit_id": {
      "type": "string"
    },
    "cohort_plan_hash": {
      "type": "string"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "stop"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "stop": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "distributions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_country",
        "by_asn"
      ],
      "properties": {
        "by_country": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_asn": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_network_type": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_asn_share",
        "num_unique_asn",
        "num_unique_country"
      ],
      "properties": {
        "max_asn_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "num_unique_asn": {
          "type": "integer",
          "minimum": 0
        },
        "num_unique_country": {
          "type": "integer",
          "minimum": 0
        },
        "entropy_asn": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "entropy_country": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "excluded_probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "probe_id",
          "reason"
        ],
        "properties": {
          "probe_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "details": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs_hash",
        "code_hash"
      ],
      "properties": {
        "inputs_hash": {
          "type": "string"
        },
        "code_hash": {
          "type": "string"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "value"
      ],
      "properties": {
        "alg": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}