{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/PublicNoticeSigningKeyset.json",
  "title": "PublicNoticeSigningKeyset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "keyset_id",
    "keyset_version",
    "generated_at",
    "election_scope",
    "keys"
  ],
  "properties": {
    "keyset_id": {
      "type": "string",
      "description": "Stable identifier for this keyset (content may rotate via new payloads)."
    },
    "keyset_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Schema version of this keyset payload."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "election_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "election_id",
        "jurisdiction"
      ],
      "properties": {
        "election_id": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "precinct": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "previous_keyset_payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Optional hash-chain pointer to the prior keyset payload bytes (anti rollback / anti split views)."
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kid",
          "alg",
          "public_key_ref",
          "purpose",
          "status"
        ],
        "properties": {
          "kid": {
            "type": "string",
            "description": "Key identifier used by signers/verifiers (short, stable within the scope)."
          },
          "alg": {
            "type": "string",
            "description": "Signature algorithm label (e.g., Ed25519)."
          },
          "public_key_ref": {
            "type": "string",
            "description": "Reference to the public key material (e.g., did:key, jwk thumbprint URI, or other stable ref)."
          },
          "purpose": {
            "type": "string",
            "enum": [
              "public_notice_signing",
              "other"
            ]
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_to": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "revoked",
              "retired"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
