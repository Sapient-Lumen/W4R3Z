{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/WitnessSetChange.json",
  "title": "WitnessSetChange",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "change_id",
    "election_id",
    "reason",
    "new_witnesses",
    "effective_checkpoint_id",
    "created_at",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "type": {
      "type": "string",
      "const": "WitnessSetChange"
    },
    "change_id": {
      "type": "string"
    },
    "election_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "old_witness_set_hash": {
      "type": "string"
    },
    "new_witness_set_payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Optional digest of the new WitnessSet *payload* bytes this change announces (preferred for unambiguous key resolution)."
    },
    "removed_witness_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional list of witness_id values removed by this change."
    },
    "new_witnesses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://example.org/schemas/WitnessMember.json" }
    },
    "effective_checkpoint_id": {
      "type": "string"
    },
    "effective_checkpoint_hash": {
      "type": "string"
    },
    "approved_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object",
      "additionalProperties": true
    }
  }
}