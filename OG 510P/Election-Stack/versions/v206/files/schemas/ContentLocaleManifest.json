{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentLocaleManifest",
  "type": "object",
  "required": [
    "schema_version",
    "base_manifest_hash",
    "locales"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "base_manifest_hash": {
      "type": "string"
    },
    "locales": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "hash",
          "format"
        ],
        "properties": {
          "hash": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "zip",
              "tar",
              "json",
              "wasm",
              "other"
            ]
          },
          "size_bytes": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  }
}