{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EthicsGuardrailsPolicy",
  "type": "object",
  "description": "Ethical and operational guardrails for active measurements.",
  "additionalProperties": false,
  "properties": {
    "policy_id": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "contact": {
      "type": "string"
    },
    "allowed_target_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disallowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rate_caps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_measurements_per_hour": {
          "type": "integer",
          "minimum": 0
        },
        "max_probes_per_measurement": {
          "type": "integer",
          "minimum": 0
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "two_person_rule": {
          "type": "boolean"
        },
        "emergency_override": {
          "type": "boolean"
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "policy_id",
    "owner",
    "contact",
    "disallowed_actions",
    "rate_caps"
  ]
}