{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/InclusionProof.json",
  "title": "InclusionProof",
  "type": "object",
  "required": [
    "leaf_index",
    "tree_size",
    "audit_path_b64"
  ],
  "properties": {
    "leaf_index": {
      "type": "integer",
      "minimum": 0
    },
    "tree_size": {
      "type": "integer",
      "minimum": 1
    },
    "audit_path_b64": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Base64-encoded sibling hash"
      },
      "description": "Merkle authentication path"
    }
  },
  "additionalProperties": false
}