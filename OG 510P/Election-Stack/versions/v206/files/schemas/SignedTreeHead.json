{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/SignedTreeHead.json",
  "title": "SignedTreeHead",
  "type": "object",
  "required": [
    "tree_size",
    "root_hash_b64",
    "timestamp_ms",
    "node_id",
    "signature_b64"
  ],
  "properties": {
    "tree_size": {
      "type": "integer",
      "minimum": 0
    },
    "root_hash_b64": {
      "type": "string",
      "description": "Base64-encoded SHA-256 root hash"
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "signature_b64": {
      "type": "string",
      "description": "Signature over canonical STH fields"
    },
    "witness_cosignatures": {
      "type": "array",
      "items": {
        "$ref": "WitnessCosignature.json"
      },
      "default": []
    }
  },
  "additionalProperties": false
}