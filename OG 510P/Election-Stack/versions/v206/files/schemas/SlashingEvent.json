{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SlashingEvent",
  "type": "object",
  "required": ["event_id", "witness_id", "trigger", "evidence_refs", "decision", "issued_at", "signature"],
  "properties": {
    "event_id": {"type": "string"},
    "witness_id": {"type": "string"},
    "trigger": {"type": "string", "enum": ["equivocation", "missed_slo", "withheld_cosign", "missing_disclosures", "other"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "decision": {
      "type": "object",
      "required": ["action", "panel"],
      "properties": {
        "action": {"type": "string", "enum": ["warning", "probation", "removal", "bond_forfeit", "other"]},
        "panel": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "rationale": {"type": "string"}
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "string"}
  },
  "additionalProperties": false
}
