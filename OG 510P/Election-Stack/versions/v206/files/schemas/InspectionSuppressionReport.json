{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InspectionSuppressionReport",
  "type": "object",
  "required": [
    "report_id",
    "reported_by",
    "reported_at",
    "challenge_id",
    "deadline",
    "evidence",
    "signature"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "reported_by": {
      "type": "string"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "challenge_id": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "object",
      "required": [
        "challenge_digest",
        "gossip_refs"
      ],
      "properties": {
        "challenge_digest": {
          "type": "string"
        },
        "gossip_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$id": "https://example.org/schemas/InspectionSuppressionReport.json"
}
