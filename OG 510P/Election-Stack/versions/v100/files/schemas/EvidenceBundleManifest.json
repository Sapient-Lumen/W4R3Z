{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/EvidenceBundleManifest.json",
  "title": "EvidenceBundleManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "election_id",
    "created_at",
    "crypto_policy",
    "artifacts",
    "signatures"
  ],
  "properties": {
    "election_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "crypto_policy": {
      "$ref": "./CryptoPolicy.json"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "content_type": {
            "type": "string",
            "description": "DEPRECATED alias for media_type (kept for backward compatibility)."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "url": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[A-Fa-f0-9]{64}$",
            "description": "Preferred content digest with algorithm prefix."
          },
          "kind": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          },
          "media_type": {
            "type": "string",
            "description": "Preferred MIME media type for the artifact."
          }
        },
        "oneOf": [
          {
            "required": [
              "content_type"
            ]
          },
          {
            "required": [
              "media_type"
            ]
          }
        ]
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signer_id",
          "alg",
          "sig"
        ],
        "properties": {
          "signer_id": {
            "type": "string"
          },
          "alg": {
            "type": "string"
          },
          "sig": {
            "type": "string"
          }
        }
      }
    },
    "bundle_id": {
      "type": "string"
    },
    "bundle_version": {
      "type": "string"
    },
    "track": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
