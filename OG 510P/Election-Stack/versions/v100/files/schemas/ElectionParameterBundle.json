{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ElectionParameterBundle.json",
  "title": "ElectionParameterBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "election_id",
    "epb_version",
    "created_at",
    "crypto_policy",
    "ballot_definition_sha256",
    "election_public_key",
    "trustee_policy",
    "witness_policy",
    "disclosure_policy_sha256",
    "signatures"
  ],
  "properties": {
    "election_id": {"type": "string"},
    "epb_version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "crypto_policy": {"$ref": "./CryptoPolicy.json"},

    "ballot_definition_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "ballot_styles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["style_id", "sha256"],
        "properties": {
          "style_id": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        }
      }
    },

    "election_public_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "pk"],
      "properties": {
        "alg": {"type": "string"},
        "pk": {"type": "string"}
      }
    },

    "trustee_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "trustee_ids"],
      "properties": {
        "threshold": {"type": "integer", "minimum": 1},
        "trustee_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },

    "witness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cosign_threshold", "witness_ids"],
      "properties": {
        "cosign_threshold": {"type": "integer", "minimum": 1},
        "witness_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },

    "receipt_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_merge_delay_seconds": {"type": "integer", "minimum": 0},
        "pending_timeout_seconds": {"type": "integer", "minimum": 0}
      }
    },

    "disclosure_policy_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},

    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signer_id", "alg", "sig"],
        "properties": {
          "signer_id": {"type": "string"},
          "alg": {"type": "string"},
          "sig": {"type": "string"}
        }
      }
    }
  }
}
