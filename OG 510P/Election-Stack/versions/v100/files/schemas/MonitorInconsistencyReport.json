{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MonitorInconsistencyReport",
  "type": "object",
  "required": ["report_id", "challenge_id", "monitors", "summary", "issued_at", "signature"],
  "properties": {
    "report_id": {"type": "string"},
    "challenge_id": {"type": "string"},
    "monitors": {"type": "array", "items": {"type": "string"}, "minItems": 2},
    "summary": {"type": "string"},
    "response_refs": {"type": "array", "items": {"type": "string"}},
    "issued_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "string"}
  },
  "additionalProperties": false
}
