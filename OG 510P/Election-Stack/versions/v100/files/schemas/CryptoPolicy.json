{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/CryptoPolicy.json",
  "title": "CryptoPolicy",
  "type": "object",
  "required": [
    "election_id",
    "allowed_crypto_suites",
    "default_crypto_suite",
    "deprecation"
  ],
  "properties": {
    "election_id": { "type": "string", "minLength": 1 },
    "allowed_crypto_suites": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "default_crypto_suite": { "type": "string", "minLength": 1 },
    "deprecation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["crypto_suite_id", "not_valid_after_utc"],
        "properties": {
          "crypto_suite_id": { "type": "string", "minLength": 1 },
          "not_valid_after_utc": { "type": "string", "format": "date-time" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
