{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AtlasMeasurementReceipt",
  "type": "object",
  "description": "Record of created RIPE Atlas measurement(s).",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "created_measurement_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "api_endpoint": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "raw_request_hash": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "created_measurement_ids",
    "api_endpoint",
    "created_at"
  ]
}