{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AvailabilityTransparencyEntry",
  "type": "object",
  "required": [
    "schema_version",
    "entry_type",
    "entry_hash",
    "included_in_checkpoint"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "AvailabilityProbeResult",
        "OutageAttestation",
        "RecoveryAttestation",
        "MitigationAction"
      ]
    },
    "entry_hash": {
      "type": "string"
    },
    "included_in_checkpoint": {
      "type": "string",
      "description": "Checkpoint hash that includes this entry"
    }
  }
}