{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EndorsementUpdate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endorsement_id",
    "issued_at",
    "endorser_id",
    "subject",
    "endorsement",
    "signature"
  ],
  "properties": {
    "endorsement_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "endorser_id": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "additionalProperties": true
    },
    "endorsement": {
      "type": "object",
      "additionalProperties": true,
      "description": "Endorsement claims (e.g., device model, component version, process certification scope)."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "string"
    }
  },
  "$id": "https://example.org/schemas/EndorsementUpdate.json"
}
