{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TokenMintRequest",
  "type": "object",
  "required": ["election_id", "eligibility_epoch_id", "mint_grant", "blinded_tokens", "client_nonce"],
  "properties": {
    "election_id": {"type": "string"},
    "eligibility_epoch_id": {"type": "string"},
    "mint_grant": {"type": "string", "description": "Short-lived authorization from CSP; MUST be bound to election_id and epoch"},
    "blinded_tokens": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "client_nonce": {"type": "string"},
    "rate_limit_token": {"type": "string", "description": "Optional anonymous rate-limit token"}
  },
  "additionalProperties": false
}
