{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COIDisclosure",
  "type": "object",
  "required": ["witness_id", "as_of", "disclosures", "signature"],
  "properties": {
    "witness_id": {"type": "string"},
    "as_of": {"type": "string", "format": "date"},
    "disclosures": {
      "type": "object",
      "properties": {
        "employment": {"type": "array", "items": {"type": "string"}},
        "contracts": {"type": "array", "items": {"type": "string"}},
        "political_activity": {"type": "array", "items": {"type": "string"}},
        "donors_funders": {"type": "array", "items": {"type": "string"}},
        "vendors": {"type": "array", "items": {"type": "string"}},
        "other": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string"},
    "signature": {"type": "string", "description": "Detached signature over canonicalized JSON"}
  },
  "additionalProperties": false
}
