{
  "election_id": "example-2026-general",
  "ballot_definition": {
    "format": "NIST.SP.1500-20.BD.v1",
    "filename": "bd.json",
    "canonicalization": "RFC8785-JCS",
    "hash_alg": "sha256",
    "hash": "<sha256-of-canonical-bd-json>",
    "mirrors": [
      {
        "name": "official",
        "uri": "https://elections.example/elections/2026/bd/<hash>/bd.json"
      },
      {
        "name": "university-mirror",
        "uri": "https://mirror-university.example/elections/2026/bd/<hash>/bd.json"
      }
    ]
  },
  "human_render": {
    "filename": "bd_render.pdf",
    "hash_alg": "sha256",
    "hash": "<sha256-of-pdf-render>"
  },
  "epb": {
    "schema": "schemas/ElectionParameterBundle.json",
    "hash_alg": "sha256",
    "hash": "<sha256-of-canonical-epb>",
    "pkt_log": {
      "sth": "<signed-tree-head>",
      "inclusion_proof": "<merkle-inclusion-proof>",
      "checkpoint_id": "<witness-quorum-checkpoint-id>"
    }
  },
  "legal_source_bundle": {
    "hash_alg": "sha256",
    "hash": "<sha256-of-legal-source-zip>",
    "contents": [
      "candidate_filings.pdf",
      "ballot_measures.pdf",
      "districting.geojson"
    ]
  }
}
