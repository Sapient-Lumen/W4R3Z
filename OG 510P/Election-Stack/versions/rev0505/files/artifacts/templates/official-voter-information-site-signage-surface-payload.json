    "queue_and_reroute_status",
    "site_hours_or_temporary_closure",
    "office_help_route"
  ],
  "signage_scope_and_authority_policy": {
    "temporary_action_changing_signs_must_identify_site_or_route_scope": true,
    "signage_is_delivery_layer_not_standalone_rulebook": true,
    "plain_language_role_statement": "Follow the route shown here for this site and voting period. If conditions differ, use the listed official help route or linked official notice."
  },
  "accessibility_and_legibility_policy": {
    "requires_clear_directional_language_and_arrows_when_routing_changes": true,
    "requires_large_print_and_visible_placement": true,
    "inaccessible_entrances_must_direct_to_accessible_entrance_when_applicable": true,
    "multimodal_or_alternate_contact_path_expected_when_sign_alone_is_not_sufficient": true
  },
  "placement_and_review_policy": {
    "open_of_day_walkthrough_for_action_changing_signs": true,
    "review_exterior_and_interior_routes": true,
    "review_after_room_or_accessibility_changes": true
  },
  "canonical_destination_policy": {
    "requires_official_help_route_on_action_changing_signs_when_more_detail_is_needed": true,
    "allowed_linkback_types": [
      "official_phone_number",
      "official_short_url",
      "official_notice_uri",
      "qr_plus_human_readable_fallback"
    ]
  },
  "site_status_sync_policy": {
    "must_match_current_directory_hours_and_live_status_surfaces": true,
    "must_align_with_accessibility_and_curbside_instructions": true
