{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParityReport",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "period_start",
    "period_end",
    "checkpoint_id",
    "results",
    "signatures"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "report_id": {
      "type": "string"
    },
    "period_start": {
      "type": "string",
      "format": "date-time"
    },
    "period_end": {
      "type": "string",
      "format": "date-time"
    },
    "checkpoint_id": {
      "type": "string"
    },
    "targets": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "ParityProbeResult.json"
      }
    },
    "summary": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "ok": {
          "type": "integer"
        },
        "mismatch": {
          "type": "integer"
        },
        "unreachable": {
          "type": "integer"
        },
        "error": {
          "type": "integer"
        }
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "sig"
        ],
        "properties": {
          "key_id": {
            "type": "string"
          },
          "suite": {
            "type": [
              "string",
              "null"
            ]
          },
          "sig": {
            "type": "string"
          }
        }
      }
    },
    "pbb_anchor": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "log_index": {
          "type": [
            "integer",
            "null"
          ]
        },
        "inclusion_proof": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}