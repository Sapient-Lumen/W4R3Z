{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/hfv/DriftAlert.schema.json",
  "title": "DriftAlert",
  "type": "object",
  "required": ["alert_id", "election_id", "severity", "detected_at", "class", "expected_cro_hash", "evidence"],
  "properties": {
    "alert_id": {"type": "string"},
    "election_id": {"type": "string"},
    "severity": {"type": "string", "enum": ["INFO", "WARN", "CRITICAL"]},
    "detected_at": {"type": "string", "format": "date-time"},
    "class": {
      "type": "string",
      "enum": [
        "presentation_drift",
        "canonical_drift",
        "monotonicity_drift",
        "mapping_drift",
        "policy_drift",
        "time_order_drift"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "contests": {"type": "array", "items": {"type": "string"}},
        "reporting_units": {"type": "array", "items": {"type": "string"}},
        "endpoints": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "expected_cro_hash": {"type": "string"},
    "observed_hashes": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "object",
      "required": ["snapshots", "pbb_anchor"],
      "properties": {
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "uri", "content_hash"],
            "properties": {
              "kind": {"type": "string", "description": "e.g., ui_html, api_json"},
              "uri": {"type": "string"},
              "content_hash": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "pbb_anchor": {"type": "object", "description": "Inclusion proof and checkpoint identifiers"}
      },
      "additionalProperties": false
    },
    "suggested_actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
