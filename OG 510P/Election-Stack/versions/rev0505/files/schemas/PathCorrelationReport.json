{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/PathCorrelationReport.json",
  "title": "PathCorrelationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "target",
    "window",
    "cohort_plan_hash",
    "paths",
    "metrics",
    "created_at",
    "hashes",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0\\..+$"
    },
    "report_id": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "stop"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "stop": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "cohort_plan_hash": {
      "type": "string"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "probe_id",
          "as_path",
          "raw_hash"
        ],
        "properties": {
          "probe_id": {
            "type": "string"
          },
          "as_path": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "raw_hash": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asn_entropy",
        "max_asn_share",
        "mean_jaccard",
        "collapse_detected"
      ],
      "properties": {
        "asn_entropy": {
          "type": "number"
        },
        "max_asn_share": {
          "type": "number"
        },
        "mean_jaccard": {
          "type": "number"
        },
        "collapse_detected": {
          "type": "boolean"
        },
        "clusters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cluster_id",
              "probe_ids",
              "representative_path"
            ],
            "properties": {
              "cluster_id": {
                "type": "string"
              },
              "probe_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "representative_path": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_json_sha256"
      ],
      "properties": {
        "canonical_json_sha256": {
          "type": "string"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "value"
      ],
      "properties": {
        "alg": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}