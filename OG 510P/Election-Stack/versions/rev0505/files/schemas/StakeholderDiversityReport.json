{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StakeholderDiversityReport",
  "type": "object",
  "required": ["election_id", "checkpoint_id", "metrics", "issued_at"],
  "properties": {
    "election_id": {"type": "string"},
    "checkpoint_id": {"type": "string"},
    "metrics": {
      "type": "object",
      "properties": {
        "category_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "max_single_funder_share": {"type": "number"},
        "cloud_provider_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "asn_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "entropy": {"type": "number"}
      }
    },
    "notes": {"type": "string"},
    "issued_at": {"type": "string", "format": "date-time"}
  }
}
