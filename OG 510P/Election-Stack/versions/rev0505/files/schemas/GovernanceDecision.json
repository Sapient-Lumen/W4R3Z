{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovernanceDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "issued_at",
    "body_id",
    "decision",
    "related",
    "signature"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "body_id": {
      "type": "string",
      "description": "Decision-making body (board/committee/court)."
    },
    "decision": {
      "type": "string"
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "signature": {
      "type": "string"
    }
  }
}
