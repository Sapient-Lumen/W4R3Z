{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EligibilityToken",
  "type": "object",
  "required": ["election_id", "token", "issuer_id", "signature"],
  "properties": {
    "election_id": {"type": "string"},
    "token": {"type": "string", "description": "Opaque unlinkable token (e.g., blind-signed)"},
    "issuer_id": {"type": "string"},
    "signature": {"type": "string"}
  },
  "additionalProperties": false
}
