{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/WitnessSet.json",
  "title": "WitnessSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "witness_set_id",
    "election_id",
    "issued_at",
    "witnesses"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "type": {
      "type": "string",
      "const": "WitnessSet"
    },
    "witness_set_id": {
      "type": "string"
    },
    "election_id": {
      "type": "string",
      "description": "Election identifier this witness set applies to."
    },
    "previous_witness_set_payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Optional hash-chain pointer to the prior WitnessSet *payload* bytes (rollback/rewrites detection)."
    },
    "witnesses": {
      "type": "array",
      "items": { "$ref": "https://example.org/schemas/WitnessMember.json" },
      "minItems": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  }
}
