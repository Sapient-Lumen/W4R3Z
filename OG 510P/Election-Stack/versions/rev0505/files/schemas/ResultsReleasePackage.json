{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ResultsReleasePackage.json",
  "title": "ResultsReleasePackage",
  "type": "object",
  "required": [
    "election_id",
    "epb_hash",
    "checkpoint",
    "enr_updates",
    "generated_at"
  ],
  "properties": {
    "election_id": {
      "type": "string"
    },
    "epb_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "checkpoint": {
      "type": "object"
    },
    "enr_updates": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Hashes or URIs of ENRUpdate objects"
      }
    },
    "notarizations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "human_summary_uri": {
      "type": "string"
    },
    "package_signature": {
      "type": "object",
      "required": [
        "alg",
        "key_id",
        "sig"
      ],
      "properties": {
        "alg": {
          "type": "string"
        },
        "key_id": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        }
      },
      "description": "Deprecated/legacy: if present, informational. When the RRP is published as an EvidenceEnvelope payload (hfv.results.release_package), publishers SHOULD omit this field and rely on envelope signatures (docs/238)."
    },
    "cro_hash": {
      "type": "string",
      "description": "Optional: cro_hash of the CRO included in this release interval (if applicable).",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "prev_package_hash": {
      "type": "string",
      "description": "Optional link-forward pointer to the prior package digest (format: sha256:<hex> or other declared digest).",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
