{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/hfv/AttestationEvidenceBundle.schema.json",
  "title": "AttestationEvidenceBundle",
  "type": "object",
  "required": [
    "bundle_id",
    "device_id",
    "issued_at",
    "verifier_id",
    "result",
    "evidence_hash",
    "reference_value_ids",
    "endorsement_ids"
  ],
  "properties": {
    "bundle_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "verifier_id": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "indeterminate"
      ]
    },
    "evidence_eat": {
      "type": "string",
      "description": "Optional: embedded EAT as CBOR/JSON base64url."
    },
    "evidence_hash": {
      "type": "string",
      "description": "Hash of the evidence token bytes (EAT)."
    },
    "reference_value_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "endorsement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "log_receipts": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}