{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ENRUpdate.json",
  "title": "ENRUpdate",
  "type": "object",
  "required": [
    "election_id",
    "update_id",
    "sequence",
    "generated_at",
    "prev_hash",
    "payload_hash",
    "signature"
  ],
  "properties": {
    "election_id": {
      "type": "string"
    },
    "update_id": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp",
      "format": "date-time"
    },
    "prev_hash": {
      "type": "string",
      "description": "Hash of previous ENRUpdate canonical bytes",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload_hash": {
      "type": "string",
      "description": "Hash of payload bytes (results data)",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload_uri": {
      "type": "string"
    },
    "status_banner": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "required": [
        "alg",
        "key_id",
        "sig"
      ],
      "properties": {
        "alg": {
          "type": "string"
        },
        "key_id": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        }
      }
    },
    "prev_cro_hash": {
      "type": "string",
      "description": "Optional CRO link: cro_hash of the CRO this update supersedes (for link-forward correction chains).",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cro_hash": {
      "type": "string",
      "description": "Optional CRO link: cro_hash of the CRO this update corresponds to.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "is_correction": {
      "type": "boolean",
      "default": false,
      "description": "If true, this update represents a correction/amendment rather than a purely additive update. Verifiers may allow decreases only when is_correction=true and linkage/reasoning is present."
    },
    "correction_reason": {
      "type": "string",
      "description": "Optional bounded reason category when is_correction=true (see docs/234)."
    },
    "correction_reason_detail": {
      "type": "string",
      "description": "Optional short human explanation when is_correction=true; keep concise (digest-first, screenshot-last).",
      "maxLength": 400
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "is_correction": {
            "const": true
          }
        },
        "required": [
          "is_correction"
        ]
      },
      "then": {
        "required": [
          "correction_reason"
        ]
      }
    }
  ]
}
