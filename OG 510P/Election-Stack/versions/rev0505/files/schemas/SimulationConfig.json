{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SimulationConfig",
  "type": "object",
  "required": ["sim_id", "election_id", "runs", "gossip_interval_s", "partition_model", "probe_model"],
  "properties": {
    "sim_id": {"type": "string"},
    "election_id": {"type": "string"},
    "runs": {"type": "integer", "minimum": 1},
    "gossip_interval_s": {"type": "integer", "minimum": 1},
    "partition_model": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["none", "regional", "asn", "targeted"]},
        "severity": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "probe_model": {
      "type": "object",
      "required": ["success_base_rate"],
      "properties": {
        "success_base_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "selective_failure_rate": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "time_horizon_s": {"type": "integer", "minimum": 1, "default": 3600}
  },
  "additionalProperties": false
}
