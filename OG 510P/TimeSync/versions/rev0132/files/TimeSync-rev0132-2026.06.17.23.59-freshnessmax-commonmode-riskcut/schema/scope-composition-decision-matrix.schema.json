{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/scope-composition-decision-matrix.schema.json",
  "title": "TimeSync Mixed-Layer Scope Composition Decision Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrix_version",
    "matrix_digest",
    "rows"
  ],
  "properties": {
    "matrix_version": {
      "type": "string",
      "const": "rev0090"
    },
    "matrix_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "binds"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binds": {
          "type": "string",
          "enum": [
            "scope_composition_decision_matrix"
          ]
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "attack_pattern",
          "required_surfaces",
          "safe_guard_effect",
          "unsafe_upgrade_blocked",
          "failure_mode"
        ],
        "properties": {
          "row_id": {
            "type": "string",
            "minLength": 1
          },
          "attack_pattern": {
            "type": "string",
            "enum": [
              "safe_separated_surfaces",
              "downgrade_bypasses_lifecycle_suppression",
              "lifecycle_rollup_bypasses_profile_drift",
              "transparency_policy_equivalence_reopens_profile_assessment",
              "aggregate_rollup_updates_actionability",
              "unknown_newer_result_becomes_current",
              "digest_binding_reinterpreted_as_profile_evidence",
              "stale_composed_input_remains_current"
            ]
          },
          "required_surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "profile_compatibility_drift",
                "discovery_version_negotiation",
                "discovery_digest_binding",
                "aggregate_correction_authority_lifecycle",
                "aggregate_lifecycle_rollup",
                "transparency_trust_policy_lifecycle",
                "transparency_policy_equivalence",
                "external_transparency_receipt",
                "replay_transparency_anchor",
                "correction_authority_notification",
                "portable_digest_binding_policy"
              ]
            }
          },
          "safe_guard_effect": {
            "type": "string",
            "enum": [
              "current_use_guarded",
              "historical_only",
              "metadata_only",
              "suppressed",
              "fail_closed"
            ]
          },
          "unsafe_upgrade_blocked": {
            "type": "boolean"
          },
          "failure_mode": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
