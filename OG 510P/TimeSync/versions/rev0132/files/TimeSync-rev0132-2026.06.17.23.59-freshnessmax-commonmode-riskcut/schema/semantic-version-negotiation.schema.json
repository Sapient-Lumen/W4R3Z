{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/semantic-version-negotiation.schema.json",
  "title": "TimeSync Semantic Version Negotiation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "negotiation_version",
    "generated_at",
    "negotiation_scope",
    "supported_result_semantic_versions",
    "unknown_newer_version_policy",
    "boundary"
  ],
  "properties": {
    "negotiation_version": {
      "type": "string",
      "const": "rev0087"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "negotiation_scope": {
      "type": "string",
      "const": "discovery_request_result_items"
    },
    "supported_result_semantic_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "unknown_newer_version_policy": {
      "type": "string",
      "enum": [
        "omit",
        "return_metadata_only",
        "return_unknown",
        "fail_closed"
      ]
    },
    "digest_binding_policy_required_for_current_use": {
      "type": "boolean"
    },
    "fallback_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "accepted_exact",
          "downgraded_to_supported",
          "returned_metadata_only",
          "omitted_unknown_newer",
          "rejected_unknown_newer"
        ]
      },
      "uniqueItems": true
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "negotiation_updates_profile_assessment",
        "negotiation_updates_actionability",
        "negotiation_interpreted_as_timesync_provenance",
        "negotiation_updates_discovery_interpretation_only"
      ],
      "properties": {
        "negotiation_updates_profile_assessment": {
          "type": "boolean",
          "const": false
        },
        "negotiation_updates_actionability": {
          "type": "boolean",
          "const": false
        },
        "negotiation_interpreted_as_timesync_provenance": {
          "type": "boolean",
          "const": false
        },
        "negotiation_updates_discovery_interpretation_only": {
          "type": "boolean",
          "const": true
        },
        "note": {
          "type": "string"
        }
      }
    },
    "note": {
      "type": "string"
    },
    "downgrade_proof_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_use_downgrade_requires_proof",
        "downgrade_proof_digest_required",
        "weaker_semantics_current_use_allowed",
        "boundary"
      ],
      "properties": {
        "current_use_downgrade_requires_proof": {
          "type": "boolean"
        },
        "downgrade_proof_digest_required": {
          "type": "boolean"
        },
        "weaker_semantics_current_use_allowed": {
          "type": "boolean",
          "const": false
        },
        "allowed_downgrade_bases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "exact_supported",
              "stricter_or_equal_supported",
              "metadata_only",
              "legacy_historical_only"
            ]
          }
        },
        "proof_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "profile_downgrade_proof"
            }
          }
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "downgrade_proof_updates_profile_assessment",
            "downgrade_proof_updates_actionability",
            "downgrade_proof_interpreted_as_timesync_provenance",
            "downgrade_proof_updates_discovery_interpretation_only"
          ],
          "properties": {
            "downgrade_proof_updates_profile_assessment": {
              "type": "boolean",
              "const": false
            },
            "downgrade_proof_updates_actionability": {
              "type": "boolean",
              "const": false
            },
            "downgrade_proof_interpreted_as_timesync_provenance": {
              "type": "boolean",
              "const": false
            },
            "downgrade_proof_updates_discovery_interpretation_only": {
              "type": "boolean",
              "const": true
            },
            "note": {
              "type": "string"
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
