{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/transport-adapter-catalog.schema.json",
  "title": "TimeSync Transport Adapter Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "purpose",
    "adapters"
  ],
  "properties": {
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "adapters": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://example.invalid/timesync/schema/transport-adapter.schema.json",
        "title": "TimeSync Transport Adapter",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "mode",
          "carrier",
          "payload_types",
          "does_not_define_protocol",
          "timestate_core_mutation",
          "identity_binding",
          "freshness_source",
          "ordering_semantics",
          "result_policy",
          "profile_reference_policy",
          "prohibited_behaviors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^timesync\\.adapter\\.[A-Za-z0-9_.-]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "test_fixture",
              "in_band_claim",
              "out_of_band_pull",
              "out_of_band_push",
              "detached_export",
              "relay_boundary"
            ]
          },
          "carrier": {
            "type": "string",
            "enum": [
              "json_fixture",
              "existing_protocol",
              "management_api",
              "telemetry_stream",
              "file_export"
            ]
          },
          "payload_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "wire_claim",
                "local_assessed_state",
                "discovery_request",
                "discovery_result",
                "capability_advertisement",
                "retained_assessment_export"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "does_not_define_protocol": {
            "type": "boolean",
            "const": true
          },
          "timestate_core_mutation": {
            "type": "string",
            "const": "forbidden"
          },
          "identity_binding": {
            "type": "string",
            "enum": [
              "none",
              "transport_identity",
              "payload_identity",
              "operator_configured",
              "profile_reference_binding"
            ]
          },
          "freshness_source": {
            "type": "string",
            "enum": [
              "semantic_payload",
              "carrier_native_metadata_only",
              "not_applicable"
            ]
          },
          "ordering_semantics": {
            "type": "string",
            "enum": [
              "none",
              "carrier_order",
              "sequence_optional",
              "external"
            ]
          },
          "result_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "negative_optional_item_results",
              "ordinary_request_scope"
            ],
            "properties": {
              "negative_optional_item_results": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "unavailable",
                    "unknown",
                    "omitted"
                  ]
                },
                "uniqueItems": true
              },
              "ordinary_request_scope": {
                "type": "string",
                "const": "exchange_scoped"
              },
              "native_bundle_layer": {
                "type": "string",
                "const": "none"
              }
            }
          },
          "profile_reference_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "may_carry_profile_reference",
              "envelope_signature_substitutes_for_profile_binding"
            ],
            "properties": {
              "may_carry_profile_reference": {
                "type": "boolean"
              },
              "envelope_signature_substitutes_for_profile_binding": {
                "type": "boolean",
                "const": false
              },
              "digest_obligations_remain_in_payload": {
                "type": "boolean",
                "const": true
              }
            }
          },
          "prohibited_behaviors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "minItems": 1
    }
  }
}
