{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/wire-claim.schema.json",
  "title": "TimeSync Wire Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interval_claim",
    "timescale_claim",
    "identity_or_auth_proof"
  ],
  "properties": {
    "interval_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earliest",
        "latest"
      ],
      "properties": {
        "earliest": {
          "type": "string",
          "format": "date-time"
        },
        "latest": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "timescale_claim": {
      "type": "string",
      "minLength": 1
    },
    "identity_or_auth_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "traceability_posture_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_anchor",
        "evidence_posture"
      ],
      "properties": {
        "reference_anchor": {
          "type": "string",
          "enum": [
            "utc_named_realization",
            "utc_unqualified",
            "profile_reference",
            "local_private",
            "unknown"
          ]
        },
        "evidence_posture": {
          "type": "string",
          "enum": [
            "claimed",
            "traceable",
            "unknown"
          ]
        }
      }
    },
    "sync_dimension_claim": {
      "type": "string",
      "enum": [
        "time",
        "phase",
        "frequency",
        "combination",
        "unknown"
      ]
    }
  }
}
