{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/transport-envelope.schema.json",
  "title": "TimeSync Minimal Transport Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version",
    "message_type",
    "adapter",
    "semantic_payload"
  ],
  "properties": {
    "envelope_version": {
      "type": "string",
      "const": "1.0"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "wire_claim",
        "local_assessed_state",
        "discovery_request",
        "discovery_result",
        "capability_advertisement",
        "retained_assessment_export"
      ]
    },
    "exchange_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "identity"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "source",
            "receiver",
            "relay",
            "exporter",
            "observer",
            "manager",
            "test_fixture"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "carrier",
        "mode",
        "binding_strength"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^timesync\\.adapter\\.[A-Za-z0-9_.-]+$"
        },
        "carrier": {
          "type": "string",
          "enum": [
            "json_fixture",
            "existing_protocol",
            "management_api",
            "telemetry_stream",
            "file_export"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "test_fixture",
            "in_band_claim",
            "out_of_band_pull",
            "out_of_band_push",
            "detached_export",
            "relay_boundary"
          ]
        },
        "binding_strength": {
          "type": "string",
          "enum": [
            "semantic_only",
            "authenticated_transport",
            "signed_payload"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "semantic_payload": {
      "type": "object"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protection",
        "covers"
      ],
      "properties": {
        "protection": {
          "type": "string",
          "enum": [
            "none",
            "transport_authenticated",
            "detached_signature",
            "signed_payload"
          ]
        },
        "covers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "envelope_metadata",
              "semantic_payload",
              "semantic_payload_digest",
              "profile_reference"
            ]
          },
          "uniqueItems": true
        },
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256",
            "ed25519",
            "ecdsa_p256_sha256",
            "unknown"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "key_hint": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "protection": {
                "enum": [
                  "detached_signature",
                  "signed_payload"
                ]
              }
            },
            "required": [
              "protection"
            ]
          },
          "then": {
            "required": [
              "algorithm",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "protection": {
                "const": "none"
              }
            },
            "required": [
              "protection"
            ]
          },
          "then": {
            "properties": {
              "covers": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
