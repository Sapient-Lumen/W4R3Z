{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/extension-hooks.schema.json",
  "title": "TimeSync Extension Hooks",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "traceability_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_anchor",
        "evidence_posture"
      ],
      "properties": {
        "reference_anchor": {
          "type": "string",
          "enum": [
            "utc_named_realization",
            "utc_unqualified",
            "profile_reference",
            "local_private",
            "unknown"
          ]
        },
        "evidence_posture": {
          "type": "string",
          "enum": [
            "claimed",
            "traceable",
            "unknown"
          ]
        }
      }
    },
    "sync_dimension": {
      "type": "string",
      "enum": [
        "time",
        "phase",
        "frequency",
        "combination",
        "unknown"
      ]
    },
    "holdover_class": {
      "type": "string"
    },
    "validity_scope": {
      "type": "string"
    },
    "time_error_bound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bound_ms"
      ],
      "properties": {
        "bound_ms": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "rate_error_bound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bound_ppb"
      ],
      "properties": {
        "bound_ppb": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "timescale_realization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scale",
        "realization",
        "leap_handling",
        "evidence_posture"
      ],
      "properties": {
        "scale": {
          "type": "string",
          "enum": [
            "UTC",
            "TAI",
            "GPS",
            "local_private",
            "profile_defined",
            "unknown"
          ]
        },
        "realization": {
          "type": "string",
          "minLength": 1
        },
        "leap_handling": {
          "type": "string",
          "enum": [
            "standard_utc",
            "smeared",
            "continuous_utc_transition",
            "not_applicable",
            "unknown"
          ]
        },
        "tai_utc_offset_state": {
          "type": "string",
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "evidence_posture": {
          "type": "string",
          "enum": [
            "claimed",
            "traceable",
            "profile_defined",
            "not_applicable",
            "unknown"
          ]
        },
        "note": {
          "type": "string"
        },
        "utc_transition_policy_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "enum": [
                "utc_transition_policy",
                "retained_operator_record",
                "profile_compatibility_statement"
              ]
            }
          }
        },
        "leap_second_policy_epoch": {
          "type": "string",
          "minLength": 1
        },
        "ut1_utc_tolerance_class": {
          "type": "string",
          "enum": [
            "current_utc_limit",
            "continuous_utc_transition_limit",
            "profile_defined",
            "unknown"
          ]
        },
        "smear_policy_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "enum": [
                "smear_policy",
                "utc_transition_policy",
                "retained_operator_record"
              ]
            }
          }
        },
        "continuous_utc_transition_supported": {
          "type": "boolean"
        },
        "mixed_realization_boundary": {
          "type": "string",
          "enum": [
            "not_applicable",
            "same_record_disallowed",
            "profile_defined",
            "unknown"
          ]
        }
      }
    },
    "clock_continuity_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backward_step_policy",
        "smear_policy",
        "monotonic_local_time"
      ],
      "properties": {
        "backward_step_policy": {
          "type": "string",
          "enum": [
            "forbidden",
            "bounded",
            "permitted",
            "unknown"
          ]
        },
        "smear_policy": {
          "type": "string",
          "enum": [
            "none",
            "leap_smear",
            "policy_defined",
            "not_applicable",
            "unknown"
          ]
        },
        "monotonic_local_time": {
          "type": "string",
          "enum": [
            "claimed",
            "assessed",
            "not_claimed",
            "unknown"
          ]
        },
        "evidence_posture": {
          "type": "string",
          "enum": [
            "claimed",
            "assessed",
            "profile_defined",
            "not_applicable",
            "unknown"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "source_diversity_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_class",
        "common_mode_risk",
        "assessment_basis",
        "evidence_posture",
        "export_detail"
      ],
      "properties": {
        "dependency_class": {
          "type": "string",
          "enum": [
            "single_source",
            "multiple_sources_same_root",
            "multiple_roots_common_distribution",
            "multiple_independent_roots",
            "holdover_from_prior_source",
            "unknown"
          ]
        },
        "common_mode_risk": {
          "type": "string",
          "enum": [
            "confirmed_common_mode",
            "possible_common_mode",
            "mitigated_by_diversity",
            "not_assessed",
            "unknown"
          ]
        },
        "assessment_basis": {
          "type": "string",
          "enum": [
            "local_measurement_summary",
            "operator_configuration",
            "profile_catalog_rule",
            "local_policy_rule",
            "policy_redacted",
            "unknown"
          ]
        },
        "evidence_posture": {
          "type": "string",
          "enum": [
            "claimed",
            "assessed",
            "profile_defined",
            "redacted",
            "unknown"
          ]
        },
        "export_detail": {
          "type": "string",
          "enum": [
            "summary_only"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "pnt_risk_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disruption_warning_posture",
        "manipulation_suspected_posture",
        "export_detail"
      ],
      "properties": {
        "disruption_warning_posture": {
          "type": "string",
          "enum": [
            "none_observed",
            "warning_active",
            "degraded_or_unavailable",
            "not_assessed",
            "unknown"
          ]
        },
        "manipulation_suspected_posture": {
          "type": "string",
          "enum": [
            "none_observed",
            "suspected",
            "confirmed",
            "not_assessed",
            "unknown"
          ]
        },
        "holdover_degradation_model_reference": {
          "type": "string",
          "minLength": 1
        },
        "dynamic_time_inaccuracy_reference": {
          "type": "string",
          "minLength": 1
        },
        "time_quality_mapping_reference": {
          "type": "string",
          "minLength": 1
        },
        "common_mode_failure_hypothesis": {
          "type": "string",
          "enum": [
            "none",
            "possible_common_mode",
            "confirmed_common_mode",
            "not_assessed",
            "unknown"
          ]
        },
        "evidence_posture": {
          "type": "string",
          "enum": [
            "claimed",
            "assessed",
            "profile_defined",
            "redacted",
            "unknown"
          ]
        },
        "export_detail": {
          "type": "string",
          "enum": [
            "summary_only"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
