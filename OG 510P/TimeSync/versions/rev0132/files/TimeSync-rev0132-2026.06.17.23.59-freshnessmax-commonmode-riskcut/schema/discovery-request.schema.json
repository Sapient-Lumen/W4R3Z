{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/discovery-request.schema.json",
  "title": "TimeSync Discovery Request and Result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "negotiation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_semantic_version",
            "supported_result_semantic_versions",
            "unknown_newer_version_policy"
          ],
          "properties": {
            "request_semantic_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "supported_result_semantic_versions": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                }
              }
            },
            "unknown_newer_version_policy": {
              "type": "string",
              "enum": [
                "omit",
                "return_metadata_only",
                "return_unknown",
                "fail_closed"
              ]
            },
            "require_digest_binding_policy": {
              "type": "boolean"
            },
            "accept_legacy_canonicalization_for_current": {
              "type": "boolean",
              "const": false
            },
            "note": {
              "type": "string"
            },
            "downgrade_proof_required_for_current_use": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "returned",
              "unavailable",
              "unknown",
              "omitted"
            ]
          },
          "value": {},
          "note": {
            "type": "string"
          },
          "semantic_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "schema_uri": {
            "type": "string",
            "minLength": 1
          },
          "version_negotiation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision",
              "current_use_allowed"
            ],
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "accepted_exact",
                  "downgraded_to_supported",
                  "returned_metadata_only",
                  "omitted_unknown_newer",
                  "rejected_unknown_newer",
                  "accepted_unknown_newer"
                ]
              },
              "current_use_allowed": {
                "type": "boolean"
              },
              "updates_profile_assessment": {
                "type": "boolean",
                "const": false
              },
              "updates_actionability": {
                "type": "boolean",
                "const": false
              },
              "note": {
                "type": "string"
              },
              "source_semantic_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "selected_semantic_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "downgrade_basis": {
                "type": "string",
                "enum": [
                  "exact_supported",
                  "stricter_or_equal_supported",
                  "metadata_only",
                  "unknown_newer_metadata_only",
                  "legacy_historical_only",
                  "weaker_or_unknown",
                  "not_applicable"
                ]
              },
              "downgrade_proof_digest": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "algorithm",
                  "value",
                  "binds"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "enum": [
                      "sha256"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[A-Fa-f0-9]{64}$"
                  },
                  "binds": {
                    "type": "string",
                    "const": "profile_downgrade_proof"
                  }
                }
              },
              "stronger_or_equal_semantics": {
                "type": "boolean"
              }
            }
          },
          "digest_binding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "binding_mode",
              "current_use_allowed",
              "digest"
            ],
            "properties": {
              "binding_mode": {
                "type": "string",
                "enum": [
                  "canonical_json_rfc8785",
                  "external_byte_envelope",
                  "external_receipt_bytes",
                  "legacy_python_sort_keys_historical_only"
                ]
              },
              "canonicalization": {
                "type": "string",
                "enum": [
                  "json_canonicalization_scheme_rfc8785",
                  "timesync_python_json_sort_keys_legacy",
                  "not_applicable"
                ]
              },
              "envelope_kind": {
                "type": "string",
                "enum": [
                  "dsse_like_byte_envelope",
                  "cose_sign1_external_receipt",
                  "scitt_transparent_statement",
                  "private_external_envelope",
                  "unknown_or_redacted"
                ]
              },
              "payload_type": {
                "type": "string",
                "minLength": 1
              },
              "payload_type_authenticated": {
                "type": "boolean"
              },
              "verified_before_payload_parse": {
                "type": "boolean"
              },
              "canonicalization_dependency": {
                "type": "string",
                "enum": [
                  "required_for_signature_validation",
                  "not_required_for_signature_validation",
                  "unknown_or_redacted"
                ]
              },
              "raw_payload_bytes_exported": {
                "type": "boolean"
              },
              "current_use_allowed": {
                "type": "boolean"
              },
              "digest": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "algorithm",
                  "value",
                  "binds"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "enum": [
                      "sha256"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[A-Fa-f0-9]{64}$"
                  },
                  "binds": {
                    "type": "string",
                    "enum": [
                      "normative_profile_rules",
                      "aggregate_lifecycle_decision_table",
                      "aggregate_correction_authority_lifecycle_summary",
                      "aggregate_verifier_audit_summary",
                      "transparency_trust_policy_reference",
                      "external_transparency_receipt",
                      "retained_operator_record",
                      "discovery_returned_object",
                      "digest_binding_policy",
                      "semantic_version_negotiation",
                      "profile_compatibility_drift_matrix",
                      "profile_downgrade_proof",
                      "scope_composition_guard",
                      "scope_composition_decision_matrix"
                    ]
                  }
                }
              },
              "digest_binding_policy_digest": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "algorithm",
                  "value",
                  "binds"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "enum": [
                      "sha256"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[A-Fa-f0-9]{64}$"
                  },
                  "binds": {
                    "type": "string",
                    "const": "digest_binding_policy"
                  }
                }
              },
              "note": {
                "type": "string"
              }
            }
          },
          "freshness": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observed_at",
              "basis_time",
              "max_age_seconds",
              "current_use_not_after",
              "freshness_status",
              "freshness_updates_discovery_interpretation_only",
              "freshness_updates_profile_assessment",
              "freshness_updates_actionability",
              "freshness_interpreted_as_timesync_provenance"
            ],
            "properties": {
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "basis_time": {
                "type": "string",
                "format": "date-time"
              },
              "max_age_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "current_use_not_after": {
                "type": "string",
                "format": "date-time"
              },
              "freshness_status": {
                "type": "string",
                "enum": [
                  "fresh_for_current_use",
                  "stale_for_current_use",
                  "unchecked",
                  "not_time_bound"
                ]
              },
              "freshness_updates_discovery_interpretation_only": {
                "type": "boolean",
                "const": true
              },
              "freshness_updates_profile_assessment": {
                "type": "boolean",
                "const": false
              },
              "freshness_updates_actionability": {
                "type": "boolean",
                "const": false
              },
              "freshness_interpreted_as_timesync_provenance": {
                "type": "boolean",
                "const": false
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "returned"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "value"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "unavailable",
                    "unknown",
                    "omitted"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "value"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "minProperties": 1
}
