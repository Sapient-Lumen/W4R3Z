{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/digest-binding-policy.schema.json",
  "title": "TimeSync Digest Binding Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "generated_at",
    "policy_scope",
    "canonical_json_profile",
    "byte_envelope_profile",
    "digest_surface_rules",
    "boundary"
  ],
  "properties": {
    "policy_version": {
      "type": "string",
      "const": "rev0086"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_scope": {
      "type": "string",
      "const": "portable_digest_binding_and_byte_envelope"
    },
    "canonical_json_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "canonicalization",
        "digest_algorithm",
        "unicode_normalization",
        "number_policy",
        "object_member_order",
        "whitespace",
        "legacy_python_sort_keys_permitted_for_current_binding",
        "ijson_constraints_enforced",
        "duplicate_member_names_rejected",
        "unsafe_numbers_rejected_for_timesync_digest_surfaces"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "const": "timesync-jcs-sha256-v1"
        },
        "canonicalization": {
          "type": "string",
          "const": "json_canonicalization_scheme_rfc8785"
        },
        "digest_algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "unicode_normalization": {
          "type": "string",
          "const": "preserve_codepoints_no_normalization"
        },
        "number_policy": {
          "type": "string",
          "enum": [
            "integers_only_for_digest_bound_timesync_objects",
            "jcs_number_serialization"
          ]
        },
        "object_member_order": {
          "type": "string",
          "const": "lexicographic_utf16_code_unit_order"
        },
        "whitespace": {
          "type": "string",
          "const": "none"
        },
        "legacy_python_sort_keys_permitted_for_current_binding": {
          "type": "boolean",
          "const": false
        },
        "note": {
          "type": "string"
        },
        "ijson_constraints_enforced": {
          "type": "boolean",
          "const": true
        },
        "duplicate_member_names_rejected": {
          "type": "boolean",
          "const": true
        },
        "unsafe_numbers_rejected_for_timesync_digest_surfaces": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "byte_envelope_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "binding_modes",
        "payload_type_authenticated",
        "verifier_must_verify_bytes_before_parse",
        "canonical_json_required_for_signature_validation",
        "raw_payload_bytes_exported_by_default"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "const": "timesync-byte-envelope-v1"
        },
        "binding_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "external_byte_envelope",
              "external_receipt_bytes",
              "canonical_json_rfc8785"
            ]
          }
        },
        "payload_type_authenticated": {
          "type": "boolean",
          "const": true
        },
        "verifier_must_verify_bytes_before_parse": {
          "type": "boolean",
          "const": true
        },
        "canonical_json_required_for_signature_validation": {
          "type": "boolean",
          "const": false
        },
        "raw_payload_bytes_exported_by_default": {
          "type": "boolean",
          "const": false
        },
        "note": {
          "type": "string"
        }
      }
    },
    "digest_surface_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "binding_mode",
          "current_use_allowed",
          "digest_binds",
          "legacy_binding_allowed"
        ],
        "properties": {
          "surface": {
            "type": "string",
            "enum": [
              "normative_profile_rules",
              "aggregate_lifecycle_decision_table",
              "aggregate_correction_authority_lifecycle_summary",
              "aggregate_verifier_audit_summary",
              "transparency_trust_policy_reference",
              "external_transparency_receipt",
              "retained_operator_record",
              "discovery_returned_object",
              "profile_compatibility_statement"
            ]
          },
          "binding_mode": {
            "type": "string",
            "enum": [
              "canonical_json_rfc8785",
              "external_byte_envelope",
              "external_receipt_bytes",
              "legacy_python_sort_keys_historical_only"
            ]
          },
          "current_use_allowed": {
            "type": "boolean"
          },
          "digest_binds": {
            "type": "string",
            "minLength": 1
          },
          "legacy_binding_allowed": {
            "type": "boolean"
          },
          "byte_envelope_payload_type": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_policy_updates_profile_assessment",
        "digest_policy_interpreted_as_timesync_provenance",
        "digest_policy_creates_credential_system",
        "digest_policy_operates_transparency_log",
        "digest_policy_exports_raw_payload_bytes",
        "digest_policy_updates_digest_interpretation_only"
      ],
      "properties": {
        "digest_policy_updates_profile_assessment": {
          "type": "boolean",
          "const": false
        },
        "digest_policy_interpreted_as_timesync_provenance": {
          "type": "boolean",
          "const": false
        },
        "digest_policy_creates_credential_system": {
          "type": "boolean",
          "const": false
        },
        "digest_policy_operates_transparency_log": {
          "type": "boolean",
          "const": false
        },
        "digest_policy_exports_raw_payload_bytes": {
          "type": "boolean",
          "const": false
        },
        "digest_policy_updates_digest_interpretation_only": {
          "type": "boolean",
          "const": true
        },
        "note": {
          "type": "string"
        }
      }
    },
    "note": {
      "type": "string"
    }
  }
}
