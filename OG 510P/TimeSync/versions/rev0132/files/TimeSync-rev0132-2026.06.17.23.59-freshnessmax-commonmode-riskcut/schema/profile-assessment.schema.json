{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/profile-assessment.schema.json",
  "title": "TimeSync Profile Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "assessed_profile",
    "profile_conformance",
    "applicability"
  ],
  "properties": {
    "assessment_time": {
      "type": "string",
      "format": "date-time"
    },
    "assessed_profile": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.invalid/timesync/schema/profile-reference.schema.json",
      "title": "TimeSync Profile Reference",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "anyOf": [
        {
          "required": [
            "version"
          ]
        },
        {
          "required": [
            "revision"
          ]
        }
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "normative_profile_rules"
            }
          }
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "issuer",
            "signed_at",
            "signature"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "signed_profile_binding"
            },
            "issuer": {
              "type": "string",
              "minLength": 1
            },
            "signed_at": {
              "type": "string",
              "format": "date-time"
            },
            "signature": {
              "type": "string",
              "minLength": 1
            },
            "covers": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "authority",
                  "id",
                  "version",
                  "revision",
                  "digest",
                  "normative_rules"
                ]
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "profile_conformance": {
      "type": "string",
      "enum": [
        "satisfied",
        "fallback",
        "unsatisfied"
      ]
    },
    "applicability": {
      "type": "string",
      "minLength": 1
    },
    "profile_lifecycle_state": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "deprecated",
        "revoked",
        "unknown"
      ]
    },
    "policy_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "accepted_with_conditions",
            "rejected",
            "unknown"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_reference": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "actionability": {
          "type": "string",
          "enum": [
            "actionable",
            "conditional",
            "record_only",
            "not_actionable",
            "unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted_with_conditions"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "reason"
                ]
              },
              {
                "required": [
                  "policy_reference"
                ]
              },
              {
                "required": [
                  "actionability"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "rejected",
                  "unknown"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "actionability": {
                "enum": [
                  "record_only",
                  "not_actionable",
                  "unknown"
                ]
              }
            }
          }
        }
      ]
    },
    "evaluation_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matched_profile_catalog": {
          "type": "boolean"
        },
        "fallback_mapping": {
          "type": "string"
        },
        "missing_items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "withdrawn_applicability": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "note": {
      "type": "string"
    },
    "evidence_summary": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.invalid/timesync/schema/evaluator-evidence-summary.schema.json",
      "title": "TimeSync Evaluator Evidence Input Summary",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_version",
        "summary_id",
        "assessment_time",
        "assessed_profile",
        "evaluator",
        "scope",
        "input_items",
        "obligation_results",
        "decision_outputs",
        "conclusion_binding",
        "non_provenance_guards"
      ],
      "properties": {
        "summary_version": {
          "type": "string",
          "const": "1.0"
        },
        "summary_id": {
          "type": "string",
          "minLength": 1
        },
        "assessment_time": {
          "type": "string",
          "format": "date-time"
        },
        "assessed_profile": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://example.invalid/timesync/schema/profile-reference.schema.json",
          "title": "TimeSync Profile Reference",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "anyOf": [
            {
              "required": [
                "version"
              ]
            },
            {
              "required": [
                "revision"
              ]
            }
          ],
          "properties": {
            "authority": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "algorithm",
                "value",
                "binds"
              ],
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "sha256"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{64}$"
                },
                "binds": {
                  "type": "string",
                  "const": "normative_profile_rules"
                }
              }
            },
            "binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "issuer",
                "signed_at",
                "signature"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "const": "signed_profile_binding"
                },
                "issuer": {
                  "type": "string",
                  "minLength": 1
                },
                "signed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "signature": {
                  "type": "string",
                  "minLength": 1
                },
                "covers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "authority",
                      "id",
                      "version",
                      "revision",
                      "digest",
                      "normative_rules"
                    ]
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "decision_model"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "decision_model": {
              "type": "string",
              "enum": [
                "profile_rule_evaluator",
                "profile_rule_evaluator_with_local_policy"
              ]
            },
            "implementation_digest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "algorithm",
                "value",
                "binds"
              ],
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "sha256"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{64}$"
                },
                "binds": {
                  "type": "string",
                  "enum": [
                    "evaluator_configuration_summary",
                    "evaluator_binary_or_script"
                  ]
                }
              }
            },
            "rules_digest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "algorithm",
                "value",
                "binds"
              ],
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "sha256"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{64}$"
                },
                "binds": {
                  "type": "string",
                  "const": "normative_profile_rules"
                }
              }
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visibility",
            "retention_role",
            "profile_scope"
          ],
          "properties": {
            "visibility": {
              "type": "string",
              "enum": [
                "local_only",
                "requestable",
                "profile_default",
                "retention_only"
              ]
            },
            "retention_role": {
              "type": "string",
              "enum": [
                "not_retained",
                "retained_summary",
                "retained_challenge_record"
              ]
            },
            "profile_scope": {
              "type": "string",
              "const": "single_assessed_profile"
            },
            "redaction": {
              "type": "string",
              "enum": [
                "none",
                "summary_only",
                "summary_with_item_digests",
                "policy_redacted",
                "summary_with_salted_commitments"
              ]
            }
          }
        },
        "input_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "presence",
              "evidence_class",
              "used_for"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "presence": {
                "type": "string",
                "enum": [
                  "present",
                  "absent",
                  "unknown",
                  "not_applicable"
                ]
              },
              "evidence_class": {
                "type": "string",
                "enum": [
                  "local_measurement_summary",
                  "authenticated_source_claim",
                  "unauthenticated_source_claim",
                  "source_diversity_summary",
                  "operator_configuration",
                  "profile_catalog_rule",
                  "validity_horizon_summary",
                  "local_policy_rule",
                  "external_evidence_reference",
                  "authorized_verifier_disclosure",
                  "replay_transparency_receipt",
                  "witness_cohort_summary",
                  "lifecycle_authority_rotation_summary",
                  "lifecycle_authority_recovery_attestation",
                  "recovery_audit_rollup_summary",
                  "aggregate_privacy_control_summary",
                  "retained_prior_assessment",
                  "transport_metadata_only",
                  "not_observed"
                ]
              },
              "used_for": {
                "type": "string",
                "enum": [
                  "core_timestate",
                  "extension_hook",
                  "profile_obligation",
                  "policy_acceptance",
                  "fallback_decision",
                  "not_used"
                ]
              },
              "freshness_relation": {
                "type": "string",
                "enum": [
                  "current_at_assessment",
                  "stale_at_assessment",
                  "not_time_bound",
                  "unknown"
                ]
              },
              "value_state": {
                "type": "string",
                "enum": [
                  "accepted",
                  "ignored",
                  "conflicting",
                  "withdrawn",
                  "redacted"
                ]
              },
              "digest": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "algorithm",
                  "value",
                  "binds"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "enum": [
                      "sha256"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[A-Fa-f0-9]{64}$"
                  },
                  "binds": {
                    "type": "string",
                    "enum": [
                      "evidence_item_summary",
                      "redacted_input_group"
                    ]
                  }
                }
              },
              "note": {
                "type": "string"
              },
              "external_evidence_reference": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "https://example.invalid/timesync/schema/redacted-external-evidence-reference.schema.json",
                "title": "TimeSync Redacted External Evidence Reference",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reference_kind",
                  "handle",
                  "handle_disclosure",
                  "binding_role",
                  "external_provenance_not_interpreted"
                ],
                "properties": {
                  "reference_kind": {
                    "type": "string",
                    "enum": [
                      "opaque_audit_handle",
                      "calibration_record_handle",
                      "retained_operator_record",
                      "transparency_log_leaf",
                      "selective_disclosure_proof",
                      "profile_defined_external_record"
                    ]
                  },
                  "handle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "handle_disclosure": {
                    "type": "string",
                    "enum": [
                      "opaque",
                      "local_only",
                      "requestable",
                      "retention_only"
                    ]
                  },
                  "binding_role": {
                    "type": "string",
                    "enum": [
                      "redacted_input_binding",
                      "external_record_handle",
                      "challenge_response_anchor"
                    ]
                  },
                  "digest": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "algorithm",
                      "value",
                      "binds"
                    ],
                    "properties": {
                      "algorithm": {
                        "type": "string",
                        "enum": [
                          "sha256"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "pattern": "^[A-Fa-f0-9]{64}$"
                      },
                      "binds": {
                        "type": "string",
                        "enum": [
                          "external_record",
                          "external_record_summary",
                          "transparency_log_leaf",
                          "external_commitment_envelope"
                        ]
                      }
                    }
                  },
                  "commitment": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "scheme",
                      "algorithm",
                      "value",
                      "binds",
                      "salt",
                      "low_cardinality_protection"
                    ],
                    "properties": {
                      "scheme": {
                        "type": "string",
                        "enum": [
                          "salted_sha256_commitment",
                          "salted_merkle_leaf_commitment",
                          "selective_disclosure_proof_reference"
                        ]
                      },
                      "algorithm": {
                        "type": "string",
                        "enum": [
                          "sha256"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "pattern": "^[A-Fa-f0-9]{64}$"
                      },
                      "binds": {
                        "type": "string",
                        "enum": [
                          "redacted_evidence_value",
                          "redacted_evidence_group",
                          "external_record_digest"
                        ]
                      },
                      "salt": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "disclosure",
                          "length_bytes"
                        ],
                        "properties": {
                          "disclosure": {
                            "type": "string",
                            "enum": [
                              "withheld",
                              "retained_separately",
                              "disclosed_to_authorized_verifier"
                            ]
                          },
                          "length_bytes": {
                            "type": "integer",
                            "minimum": 16,
                            "maximum": 128
                          },
                          "salt_id": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "low_cardinality_protection": {
                        "type": "boolean",
                        "const": true
                      },
                      "verification_hint": {
                        "type": "string",
                        "enum": [
                          "preimage_disclosure_required",
                          "authorized_verifier_can_request_salt",
                          "external_system_verifies",
                          "not_exported"
                        ]
                      }
                    }
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "external_provenance_not_interpreted": {
                    "type": "boolean",
                    "const": true
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "reference_kind": {
                          "const": "opaque_audit_handle"
                        }
                      },
                      "required": [
                        "reference_kind"
                      ]
                    },
                    "then": {
                      "properties": {
                        "handle_disclosure": {
                          "enum": [
                            "opaque",
                            "local_only",
                            "retention_only"
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "obligation_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "requirement_class",
              "result"
            ],
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "requirement_class": {
                "type": "string",
                "enum": [
                  "required",
                  "profile_default",
                  "requestable",
                  "fallback_trigger",
                  "policy_condition"
                ]
              },
              "result": {
                "type": "string",
                "enum": [
                  "met",
                  "missing",
                  "unknown",
                  "not_applicable",
                  "failed"
                ]
              },
              "evidence_items": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "decision_outputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_conformance",
            "applicability"
          ],
          "properties": {
            "profile_conformance": {
              "type": "string",
              "enum": [
                "satisfied",
                "fallback",
                "unsatisfied"
              ]
            },
            "applicability": {
              "type": "string",
              "minLength": 1
            },
            "fallback_mapping": {
              "type": "string"
            },
            "missing_items": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "withdrawn_applicability": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "conclusion_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binds",
            "assessment_id",
            "profile_conformance",
            "applicability"
          ],
          "properties": {
            "binds": {
              "type": "string",
              "const": "profile_assessment_only"
            },
            "profile_conformance": {
              "type": "string",
              "enum": [
                "satisfied",
                "fallback",
                "unsatisfied"
              ]
            },
            "applicability": {
              "type": "string",
              "minLength": 1
            },
            "assessment_index_hint": {
              "type": "integer",
              "minimum": 0
            },
            "assessment_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "non_provenance_guards": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_roster_exported",
            "path_history_exported",
            "clock_algorithm_exported",
            "raw_observations_exported",
            "transport_authentication_promoted_to_traceability",
            "external_evidence_interpreted_as_provenance"
          ],
          "properties": {
            "source_roster_exported": {
              "type": "boolean",
              "const": false
            },
            "path_history_exported": {
              "type": "boolean",
              "const": false
            },
            "clock_algorithm_exported": {
              "type": "boolean",
              "const": false
            },
            "raw_observations_exported": {
              "type": "boolean",
              "const": false
            },
            "transport_authentication_promoted_to_traceability": {
              "type": "boolean",
              "const": false
            },
            "external_evidence_interpreted_as_provenance": {
              "type": "boolean",
              "const": false
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "validity_horizon": {
      "title": "TimeSync Profile Assessment Validity Horizon",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated_at",
        "current_actionability",
        "basis",
        "assessment_time_binding",
        "export_time_role",
        "evidence_posture"
      ],
      "properties": {
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "not_after": {
          "type": "string",
          "format": "date-time"
        },
        "current_actionability": {
          "type": "string",
          "enum": [
            "actionable",
            "conditional",
            "record_only",
            "not_actionable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "profile_policy",
            "local_policy",
            "freshness",
            "holdover_model",
            "retention_context",
            "operator_configuration",
            "unknown"
          ]
        },
        "assessment_time_binding": {
          "type": "string",
          "enum": [
            "profile_assessment_time",
            "timestate_interval",
            "freshness_state",
            "holdover_model",
            "policy_defined",
            "historical_record_only",
            "unknown"
          ]
        },
        "export_time_role": {
          "type": "string",
          "enum": [
            "not_used",
            "record_timestamp_only",
