{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/authorized-verifier-challenge.schema.json",
  "title": "TimeSync Authorized Verifier Challenge Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "challenge_version",
    "record_kind",
    "challenge_id",
    "issued_at",
    "expires_at",
    "verifier_authorization",
    "target_binding",
    "requested_disclosures",
    "portability_boundary",
    "disclosure_boundary"
  ],
  "properties": {
    "challenge_version": {
      "type": "string",
      "const": "1.0"
    },
    "record_kind": {
      "type": "string",
      "enum": [
        "authorized_verifier_challenge",
        "authorized_verifier_challenge_result"
      ]
    },
    "challenge_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "verifier_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_id",
        "authorization_basis",
        "authorization_scope",
        "authorization_binding"
      ],
      "properties": {
        "verifier_id": {
          "type": "string",
          "minLength": 1
        },
        "verifier_authority": {
          "type": "string",
          "minLength": 1
        },
        "authorization_basis": {
          "type": "string",
          "enum": [
            "profile_policy",
            "retained_audit_authority",
            "operator_policy",
            "legal_process",
            "mutual_agreement",
            "test_fixture"
          ]
        },
        "authorization_scope": {
          "type": "string",
          "enum": [
            "salt_preimage_verification",
            "external_system_verification",
            "redacted_item_review"
          ]
        },
        "authorization_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binding_type",
            "reference"
          ],
          "properties": {
            "binding_type": {
              "type": "string",
              "enum": [
                "local_authorization_record",
                "signed_verifier_authorization",
                "external_authority_record",
                "test_fixture"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "algorithm",
                "value",
                "binds"
              ],
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "sha256"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{64}$"
                },
                "binds": {
                  "type": "string",
                  "enum": [
                    "authorization_record",
                    "authorization_policy",
                    "external_authority_record"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "target_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_id",
        "assessment_id",
        "assessed_profile",
        "commitments"
      ],
      "properties": {
        "summary_id": {
          "type": "string",
          "minLength": 1
        },
        "assessment_id": {
          "type": "string",
          "minLength": 1
        },
        "assessed_profile": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://example.invalid/timesync/schema/profile-reference.schema.json",
          "title": "TimeSync Profile Reference",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "anyOf": [
            {
              "required": [
                "version"
              ]
            },
            {
              "required": [
                "revision"
              ]
            }
          ],
          "properties": {
            "authority": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "algorithm",
                "value",
                "binds"
              ],
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "sha256"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{64}$"
                },
                "binds": {
                  "type": "string",
                  "const": "normative_profile_rules"
                }
              }
            },
            "binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "issuer",
                "signed_at",
                "signature"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "const": "signed_profile_binding"
                },
                "issuer": {
                  "type": "string",
                  "minLength": 1
                },
                "signed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "signature": {
                  "type": "string",
                  "minLength": 1
                },
                "covers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "authority",
                      "id",
                      "version",
                      "revision",
                      "digest",
                      "normative_rules"
                    ]
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        },
        "retained_export_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "retained_assessment_export"
            }
          }
        },
        "commitments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_name",
              "commitment_scheme",
              "commitment_value",
              "commitment_binds"
            ],
            "properties": {
              "item_name": {
                "type": "string",
                "minLength": 1
              },
              "commitment_scheme": {
                "type": "string",
                "enum": [
                  "salted_sha256_commitment",
                  "salted_merkle_leaf_commitment",
                  "selective_disclosure_proof_reference"
                ]
              },
              "commitment_value": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "commitment_binds": {
                "type": "string",
                "enum": [
                  "redacted_evidence_value",
                  "redacted_evidence_group",
                  "external_record_digest"
                ]
              }
            }
          }
        }
      }
    },
    "requested_disclosures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_name",
          "commitment_value",
          "requested_material",
          "ordinary_timesync_export_allowed"
        ],
        "properties": {
          "item_name": {
            "type": "string",
            "minLength": 1
          },
          "commitment_value": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "requested_material": {
            "type": "string",
            "enum": [
              "salt_and_preimage",
              "salt_only",
              "external_proof_reference"
            ]
          },
          "ordinary_timesync_export_allowed": {
            "type": "boolean",
            "const": false
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "challenge_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "challenge_id",
        "responded_at",
        "result",
        "result_basis",
        "verified_disclosures",
        "receipt",
        "portable_result_state",
        "response_boundary"
      ],
      "properties": {
        "result_id": {
          "type": "string",
          "minLength": 1
        },
        "challenge_id": {
          "type": "string",
          "minLength": 1
        },
        "responded_at": {
          "type": "string",
          "format": "date-time"
        },
        "result": {
          "type": "string",
          "enum": [
            "matched",
            "mismatch",
            "not_disclosed",
            "external_system_verified"
          ]
        },
        "result_basis": {
          "type": "string",
          "enum": [
            "authorized_external_preimage_review",
            "external_system_verification",
            "selective_disclosure_proof_reference",
            "not_disclosed"
          ]
        },
        "verified_disclosures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_name",
              "commitment_value",
              "verification_result"
            ],
            "properties": {
              "item_name": {
                "type": "string",
                "minLength": 1
              },
              "commitment_value": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "verification_result": {
                "type": "string",
                "enum": [
                  "matched",
                  "mismatch",
                  "not_verified",
                  "external_system_verified"
                ]
              },
              "receipt_digest_value": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receipt_kind",
            "reference",
            "digest",
            "disclosure_material_exported_in_timesync"
          ],
          "properties": {
            "receipt_kind": {
              "type": "string",
              "enum": [
                "external_preimage_review_receipt",
                "selective_disclosure_proof_receipt",
                "external_system_verification_receipt"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "digest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "algorithm",
                "value",
                "binds"
              ],
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "sha256"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{64}$"
                },
                "binds": {
                  "type": "string",
                  "enum": [
                    "authorized_verifier_challenge_receipt",
                    "external_preimage_disclosure_record",
                    "selective_disclosure_proof"
                  ]
                }
              }
            },
            "disclosure_material_exported_in_timesync": {
              "type": "boolean",
              "const": false
            }
          }
        },
        "response_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disclosure_does_not_update_timestate",
            "disclosure_does_not_reassess_profile",
            "disclosure_cannot_satisfy_profile_obligation",
            "disclosure_not_timesync_provenance",
            "ordinary_retained_summary_must_not_include_preimage",
            "source_roster_exported",
            "path_history_exported",
            "clock_algorithm_exported",
            "raw_observations_exported"
          ],
          "properties": {
            "disclosure_does_not_update_timestate": {
              "type": "boolean",
              "const": true
            },
            "disclosure_does_not_reassess_profile": {
              "type": "boolean",
              "const": true
            },
            "disclosure_cannot_satisfy_profile_obligation": {
              "type": "boolean",
              "const": true
            },
            "disclosure_not_timesync_provenance": {
              "type": "boolean",
              "const": true
            },
            "ordinary_retained_summary_must_not_include_preimage": {
              "type": "boolean",
              "const": true
            },
            "source_roster_exported": {
              "type": "boolean",
              "const": false
            },
            "path_history_exported": {
              "type": "boolean",
              "const": false
            },
            "clock_algorithm_exported": {
              "type": "boolean",
              "const": false
            },
            "raw_observations_exported": {
              "type": "boolean",
              "const": false
            }
          }
        },
        "portable_result_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluated_at",
            "not_after",
            "current_status",
            "revocation_check",
            "current_status_does_not_update_profile_assessment"
          ],
          "properties": {
            "evaluated_at": {
              "type": "string",
              "format": "date-time"
            },
            "not_after": {
              "type": "string",
              "format": "date-time"
            },
            "current_status": {
              "type": "string",
              "enum": [
                "usable_for_commitment_verification_only",
                "not_usable",
                "revoked",
                "unknown"
              ]
            },
            "revocation_check": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "checked_at",
                "authority",
                "reference",
                "digest"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "checked_not_revoked",
                    "revoked",
                    "not_checked",
                    "not_applicable"
                  ]
                },
                "checked_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "authority": {
                  "type": "string",
                  "minLength": 1
                },
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "digest": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "algorithm",
                    "value",
                    "binds"
                  ],
                  "properties": {
                    "algorithm": {
                      "type": "string",
                      "enum": [
                        "sha256"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{64}$"
                    },
                    "binds": {
                      "type": "string",
                      "enum": [
                        "revocation_status_record",
                        "verifier_authorization_status",
                        "external_receipt_status"
                      ]
                    }
                  }
                }
              }
            },
            "current_status_does_not_update_profile_assessment": {
              "type": "boolean",
              "const": true
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "referenced_evidence_summary": {
      "type": "object"
    },
    "disclosure_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "salt_preimage_material_location",
        "ordinary_exchange_allowed",
        "ordinary_retained_summary_allowed",
        "challenge_result_is_profile_evidence",
        "challenge_result_reopens_assessment",
        "external_provenance_interpreted_by_timesync"
      ],
      "properties": {
        "salt_preimage_material_location": {
          "type": "string",
          "const": "external_authorized_channel_only"
        },
        "ordinary_exchange_allowed": {
          "type": "boolean",
          "const": false
        },
        "ordinary_retained_summary_allowed": {
          "type": "boolean",
          "const": false
        },
        "challenge_result_is_profile_evidence": {
          "type": "boolean",
          "const": false
        },
        "challenge_result_reopens_assessment": {
          "type": "boolean",
          "const": false
        },
        "external_provenance_interpreted_by_timesync": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "note": {
      "type": "string"
    },
    "portability_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portable_result_scope",
        "replay_policy",
        "result_may_be_replayed_for",
        "portable_across_profile_revisions",
        "portable_across_profile_digest_change",
        "portable_across_operators_without_profile_compatibility",
        "portability_does_not_expand_disclosure_scope",
        "portable_result_is_profile_evidence"
      ],
      "properties": {
        "portable_result_scope": {
          "type": "string",
          "enum": [
            "local_retained_record_only",
            "same_operator_same_assessment",
            "cross_operator_with_profile_compatibility",
            "not_portable"
          ]
        },
        "replay_policy": {
          "type": "string",
          "enum": [
            "not_replayable",
            "same_summary_same_assessment_only",
            "same_export_digest_only",
            "external_policy_only"
          ]
        },
        "result_may_be_replayed_for": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "commitment_verification_only"
            ]
          },
          "uniqueItems": true
        },
        "profile_compatibility_statement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "profile_compatibility_statement"
            }
          }
        },
        "portable_across_profile_revisions": {
          "type": "boolean",
          "const": false
        },
        "portable_across_profile_digest_change": {
          "type": "boolean",
          "const": false
        },
        "portable_across_operators_without_profile_compatibility": {
          "type": "boolean",
          "const": false
        },
        "portability_does_not_expand_disclosure_scope": {
          "type": "boolean",
          "const": true
        },
        "portable_result_is_profile_evidence": {
          "type": "boolean",
          "const": false
        },
        "note": {
          "type": "string"
        }
      }
    },
    "replay_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replayed_at",
        "replay_use",
        "using_operator",
        "replay_target",
        "replay_material_exported_in_timesync"
      ],
      "properties": {
        "replayed_at": {
          "type": "string",
          "format": "date-time"
        },
        "replay_use": {
          "type": "string",
          "enum": [
            "commitment_verification_review",
            "profile_obligation_evidence",
            "current_actionability_evidence",
            "profile_reassessment",
            "transport_authentication"
          ]
        },
        "using_operator": {
          "type": "string",
          "minLength": 1
        },
        "replay_target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary_id",
            "assessment_id",
            "assessed_profile_digest"
          ],
          "properties": {
            "summary_id": {
              "type": "string",
              "minLength": 1
            },
            "assessment_id": {
              "type": "string",
              "minLength": 1
            },
            "assessed_profile_digest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "algorithm",
                "value",
                "binds"
              ],
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "sha256"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{64}$"
                },
                "binds": {
                  "type": "string",
                  "const": "normative_profile_rules"
                }
              }
            },
            "retained_export_digest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "algorithm",
                "value",
                "binds"
              ],
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "sha256"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{64}$"
                },
                "binds": {
                  "type": "string",
                  "const": "retained_assessment_export"
                }
              }
            }
          }
        },
        "profile_compatibility_statement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "profile_compatibility_statement"
            }
          }
        },
        "replay_material_exported_in_timesync": {
          "type": "boolean",
          "const": false
        },
        "note": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "authorized_verifier_challenge_result"
          }
        },
        "required": [
          "record_kind"
        ]
      },
      "then": {
        "required": [
          "challenge_result"
        ]
      }
    }
  ]
}
