{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/transport-capability.schema.json",
  "title": "TimeSync Transport Capability Advertisement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_set_version",
    "adapter_id",
    "supported_message_types",
    "supported_profiles",
    "requestable_items",
    "negative_result_statuses"
  ],
  "properties": {
    "capability_set_version": {
      "type": "string",
      "const": "1.0"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^timesync\\.adapter\\.[A-Za-z0-9_.-]+$"
    },
    "supported_message_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "wire_claim",
          "local_assessed_state",
          "discovery_request",
          "discovery_result",
          "capability_advertisement",
          "retained_assessment_export"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "supported_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "anyOf": [
          {
            "required": [
              "version"
            ]
          },
          {
            "required": [
              "revision"
            ]
          }
        ],
        "properties": {
          "authority": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          }
        }
      }
    },
    "requestable_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "negative_result_statuses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "unavailable",
          "unknown",
          "omitted"
        ]
      },
      "uniqueItems": true
    },
    "max_profile_reference_tier_without_out_of_band_config": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
