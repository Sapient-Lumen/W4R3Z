{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/redacted-external-evidence-reference.schema.json",
  "title": "TimeSync Redacted External Evidence Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_kind",
    "handle",
    "handle_disclosure",
    "binding_role",
    "external_provenance_not_interpreted"
  ],
  "properties": {
    "reference_kind": {
      "type": "string",
      "enum": [
        "opaque_audit_handle",
        "calibration_record_handle",
        "retained_operator_record",
        "transparency_log_leaf",
        "selective_disclosure_proof",
        "profile_defined_external_record"
      ]
    },
    "handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "handle_disclosure": {
      "type": "string",
      "enum": [
        "opaque",
        "local_only",
        "requestable",
        "retention_only"
      ]
    },
    "binding_role": {
      "type": "string",
      "enum": [
        "redacted_input_binding",
        "external_record_handle",
        "challenge_response_anchor"
      ]
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "binds"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binds": {
          "type": "string",
          "enum": [
            "external_record",
            "external_record_summary",
            "transparency_log_leaf",
            "external_commitment_envelope"
          ]
        }
      }
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "algorithm",
        "value",
        "binds",
        "salt",
        "low_cardinality_protection"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "enum": [
            "salted_sha256_commitment",
            "salted_merkle_leaf_commitment",
            "selective_disclosure_proof_reference"
          ]
        },
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binds": {
          "type": "string",
          "enum": [
            "redacted_evidence_value",
            "redacted_evidence_group",
            "external_record_digest"
          ]
        },
        "salt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disclosure",
            "length_bytes"
          ],
          "properties": {
            "disclosure": {
              "type": "string",
              "enum": [
                "withheld",
                "retained_separately",
                "disclosed_to_authorized_verifier"
              ]
            },
            "length_bytes": {
              "type": "integer",
              "minimum": 16,
              "maximum": 128
            },
            "salt_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "low_cardinality_protection": {
          "type": "boolean",
          "const": true
        },
        "verification_hint": {
          "type": "string",
          "enum": [
            "preimage_disclosure_required",
            "authorized_verifier_can_request_salt",
            "external_system_verifies",
            "not_exported"
          ]
        }
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "external_provenance_not_interpreted": {
      "type": "boolean",
      "const": true
    },
    "note": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reference_kind": {
            "const": "opaque_audit_handle"
          }
        },
        "required": [
          "reference_kind"
        ]
      },
      "then": {
        "properties": {
          "handle_disclosure": {
            "enum": [
              "opaque",
              "local_only",
              "retention_only"
            ]
          }
        }
      }
    }
  ]
}
