{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/profile-compatibility-drift-matrix.schema.json",
  "title": "TimeSync Profile Compatibility Drift Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrix_version",
    "generated_at",
    "matrix_digest",
    "rows",
    "boundary"
  ],
  "properties": {
    "matrix_version": {
      "type": "string",
      "const": "rev0087"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "matrix_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "binds"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binds": {
          "type": "string",
          "const": "profile_compatibility_drift_matrix"
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "drift_class",
          "evidence_policy_relation",
          "digest_relation",
          "compatibility_decision",
          "current_use_allowed",
          "proof_required",
          "failure_mode"
        ],
        "properties": {
          "row_id": {
            "type": "string",
            "minLength": 1
          },
          "drift_class": {
            "type": "string",
            "enum": [
              "equivalent",
              "stricter_or_equal",
              "weaker",
              "incomparable",
              "unknown",
              "digest_rollover_compatible",
              "digest_rollover_without_equivalence"
            ]
          },
          "evidence_policy_relation": {
            "type": "string",
            "enum": [
              "identical",
              "stricter_or_equal",
              "weaker",
              "unknown"
            ]
          },
          "digest_relation": {
            "type": "string",
            "enum": [
              "identical_digest",
              "different_digest_with_equivalence",
              "different_digest_without_equivalence",
              "unknown_or_redacted"
            ]
          },
          "compatibility_decision": {
            "type": "string",
            "enum": [
              "current_use_allowed",
              "current_use_guarded",
              "metadata_only",
              "historical_only",
              "suppressed_by_weaker_profile",
              "suppressed_by_unknown_drift",
              "suppressed_by_incomparable_profile",
              "suppressed_by_digest_rollover",
              "suppressed_by_downgrade_without_proof"
            ]
          },
          "current_use_allowed": {
            "type": "boolean"
          },
          "proof_required": {
            "type": "boolean"
          },
          "failure_mode": {
            "type": "string",
            "enum": [
              "none",
              "metadata_only",
              "historical_only",
              "suppressed_by_weaker_profile",
              "suppressed_by_unknown_drift",
              "suppressed_by_incomparable_profile",
              "suppressed_by_digest_rollover",
              "suppressed_by_downgrade_without_proof"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_updates_profile_assessment",
        "matrix_updates_actionability",
        "matrix_reopens_assessment",
        "matrix_interpreted_as_timesync_provenance",
        "profile_rule_delta_exported",
        "matrix_updates_compatibility_interpretation_only"
      ],
      "properties": {
        "matrix_updates_profile_assessment": {
          "type": "boolean",
          "const": false
        },
        "matrix_updates_actionability": {
          "type": "boolean",
          "const": false
        },
        "matrix_reopens_assessment": {
          "type": "boolean",
          "const": false
        },
        "matrix_interpreted_as_timesync_provenance": {
          "type": "boolean",
          "const": false
        },
        "profile_rule_delta_exported": {
          "type": "boolean",
          "const": false
        },
        "matrix_updates_compatibility_interpretation_only": {
          "type": "boolean",
          "const": true
        },
        "note": {
          "type": "string"
        }
      }
    },
    "note": {
      "type": "string"
    }
  }
}
