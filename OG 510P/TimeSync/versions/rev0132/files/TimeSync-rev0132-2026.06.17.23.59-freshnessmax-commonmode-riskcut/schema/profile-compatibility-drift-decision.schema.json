{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/profile-compatibility-drift-decision.schema.json",
  "title": "TimeSync Profile Compatibility Drift Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_version",
    "evaluated_at",
    "decision_scope",
    "subject_profile",
    "related_profile",
    "drift_class",
    "digest_relation",
    "evidence_policy_relation",
    "compatibility_decision",
    "current_use_allowed",
    "matrix_digest",
    "non_upgrade_boundary"
  ],
  "properties": {
    "decision_version": {
      "type": "string",
      "const": "rev0087"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_scope": {
      "type": "string",
      "enum": [
        "profile_reference",
        "profile_compatibility_statement",
        "aggregate_lifecycle_portability",
        "discovery_negotiated_downgrade",
        "cross_operator_replay_reuse"
      ]
    },
    "subject_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "id",
        "digest"
      ],
      "anyOf": [
        {
          "required": [
            "version"
          ]
        },
        {
          "required": [
            "revision"
          ]
        }
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "normative_profile_rules"
            }
          }
        }
      }
    },
    "related_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "id",
        "digest"
      ],
      "anyOf": [
        {
          "required": [
            "version"
          ]
        },
        {
          "required": [
            "revision"
          ]
        }
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "normative_profile_rules"
            }
          }
        }
      }
    },
    "drift_class": {
      "type": "string",
      "enum": [
        "equivalent",
        "stricter_or_equal",
        "weaker",
        "incomparable",
        "unknown",
        "digest_rollover_compatible",
        "digest_rollover_without_equivalence"
      ]
    },
    "digest_relation": {
      "type": "string",
      "enum": [
        "identical_digest",
        "different_digest_with_equivalence",
        "different_digest_without_equivalence",
        "unknown_or_redacted"
      ]
    },
    "evidence_policy_relation": {
      "type": "string",
      "enum": [
        "identical",
        "stricter_or_equal",
        "weaker",
        "unknown"
      ]
    },
    "compatibility_decision": {
      "type": "string",
      "enum": [
        "current_use_allowed",
        "current_use_guarded",
        "metadata_only",
        "historical_only",
        "suppressed_by_weaker_profile",
        "suppressed_by_unknown_drift",
        "suppressed_by_incomparable_profile",
        "suppressed_by_digest_rollover",
        "suppressed_by_downgrade_without_proof"
      ]
    },
    "current_use_allowed": {
      "type": "boolean"
    },
    "matrix_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "binds"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binds": {
          "type": "string",
          "const": "profile_compatibility_drift_matrix"
        }
      }
    },
    "compatibility_statement_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "binds"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binds": {
          "type": "string",
          "const": "profile_compatibility_statement"
        }
      }
    },
    "digest_rollover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prior_profile_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "normative_profile_rules"
            }
          }
        },
        "current_profile_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "normative_profile_rules"
            }
          }
        },
        "successor_compatibility_statement_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "profile_compatibility_statement"
            }
          }
        },
        "rollover_equivalence": {
          "type": "string",
          "enum": [
            "not_applicable",
            "digest_bound_equivalent",
            "stricter_or_equal_successor",
            "weaker_or_unknown",
            "not_checked"
          ]
        }
      }
    },
    "downgrade_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_semantic_version",
        "selected_semantic_version",
        "downgrade_basis",
        "stronger_or_equal_semantics",
        "current_use_allowed"
      ],
      "properties": {
        "source_semantic_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "selected_semantic_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "downgrade_basis": {
          "type": "string",
          "enum": [
            "exact_supported",
            "stricter_or_equal_supported",
            "metadata_only",
            "legacy_historical_only",
            "weaker_or_unknown",
            "not_applicable"
          ]
        },
        "downgrade_proof_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "profile_downgrade_proof"
            }
          }
        },
        "stronger_or_equal_semantics": {
          "type": "boolean"
        },
        "current_use_allowed": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "non_upgrade_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drift_decision_is_profile_evidence",
        "drift_decision_updates_actionability",
        "drift_decision_reopens_assessment",
        "drift_decision_interpreted_as_timesync_provenance",
        "profile_rule_delta_exported",
        "profile_authority_registry_exported",
        "profile_drift_updates_compatibility_interpretation_only"
      ],
      "properties": {
        "drift_decision_is_profile_evidence": {
          "type": "boolean",
          "const": false
        },
        "drift_decision_updates_actionability": {
          "type": "boolean",
          "const": false
        },
        "drift_decision_reopens_assessment": {
          "type": "boolean",
          "const": false
        },
        "drift_decision_interpreted_as_timesync_provenance": {
          "type": "boolean",
          "const": false
        },
        "profile_rule_delta_exported": {
          "type": "boolean",
          "const": false
        },
        "profile_authority_registry_exported": {
          "type": "boolean",
          "const": false
        },
        "profile_drift_updates_compatibility_interpretation_only": {
          "type": "boolean",
          "const": true
        },
        "note": {
          "type": "string"
        }
      }
    },
    "note": {
      "type": "string"
    }
  }
}
