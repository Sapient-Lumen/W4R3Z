{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/scope-composition-guard.schema.json",
  "title": "TimeSync Mixed-Layer Scope Composition Guard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "guard_version",
    "guard_id",
    "evaluated_at",
    "composition_scope",
    "temporal_coherence",
    "surface_decisions",
    "composition_decision",
    "non_upgrade_boundary",
    "guard_digest"
  ],
  "properties": {
    "guard_version": {
      "type": "string",
      "const": "rev0090"
    },
    "guard_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "composition_scope": {
      "type": "string",
      "enum": [
        "mixed_layer_portability_review",
        "aggregate_lifecycle_portability",
        "discovery_downgrade_review",
        "profile_compatibility_drift_review",
        "replay_transparency_policy_equivalence",
        "metadata_only_review"
      ]
    },
    "surface_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "interpretation_scope",
          "current_use_allowed",
          "suppression_effect",
          "source_digest",
          "non_upgrade_boundary"
        ],
        "properties": {
          "surface": {
            "type": "string",
            "enum": [
              "profile_compatibility_drift",
              "discovery_version_negotiation",
              "discovery_digest_binding",
              "aggregate_correction_authority_lifecycle",
              "aggregate_lifecycle_rollup",
              "transparency_trust_policy_lifecycle",
              "transparency_policy_equivalence",
              "external_transparency_receipt",
              "replay_transparency_anchor",
              "correction_authority_notification",
              "portable_digest_binding_policy"
            ]
          },
          "interpretation_scope": {
            "type": "string",
            "enum": [
              "compatibility_interpretation_only",
              "discovery_interpretation_only",
              "aggregate_interpretation_only",
              "replay_visibility_only",
              "metadata_only",
              "historical_only",
              "none"
            ]
          },
          "current_use_allowed": {
            "type": "boolean"
          },
          "suppression_effect": {
            "type": "string",
            "enum": [
              "no_suppression",
              "suppressed_by_lifecycle",
              "suppressed_by_profile_drift",
              "suppressed_by_discovery_downgrade",
              "suppressed_by_transparency_policy",
              "suppressed_by_unknown_lifecycle",
              "suppressed_by_portability_failure",
              "historical_only"
            ]
          },
          "source_digest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "value",
              "binds"
            ],
            "properties": {
              "algorithm": {
                "type": "string",
                "enum": [
                  "sha256"
                ]
              },
              "value": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "binds": {
                "type": "string",
                "enum": [
                  "normative_profile_rules",
                  "profile_compatibility_statement",
                  "profile_compatibility_drift_matrix",
                  "profile_downgrade_proof",
                  "digest_binding_policy",
                  "semantic_version_negotiation",
                  "discovery_returned_object",
                  "aggregate_lifecycle_decision_table",
                  "aggregate_correction_authority_lifecycle_summary",
                  "aggregate_correction_authority_summary",
                  "aggregate_revision_lineage_summary",
                  "aggregate_verifier_audit_summary",
                  "aggregate_lifecycle_portability_summary",
                  "transparency_trust_policy_reference",
                  "transparency_policy_lifecycle_status",
                  "external_transparency_receipt",
                  "scope_composition_guard",
                  "scope_composition_decision_matrix"
                ]
              }
            }
          },
          "source_semantic_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "non_upgrade_boundary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surface_is_profile_evidence",
              "surface_updates_timestate",
              "surface_updates_profile_assessment",
              "surface_updates_actionability",
              "surface_reopens_assessment",
              "surface_interpreted_as_timesync_provenance",
              "surface_overrides_lifecycle_suppression",
              "surface_bypasses_downgrade_proof",
              "surface_bypasses_profile_drift",
              "raw_surface_material_exported"
            ],
            "properties": {
              "surface_is_profile_evidence": {
                "type": "boolean"
              },
              "surface_updates_timestate": {
                "type": "boolean"
              },
              "surface_updates_profile_assessment": {
                "type": "boolean"
              },
              "surface_updates_actionability": {
                "type": "boolean"
              },
              "surface_reopens_assessment": {
                "type": "boolean"
              },
              "surface_interpreted_as_timesync_provenance": {
                "type": "boolean"
              },
              "surface_overrides_lifecycle_suppression": {
                "type": "boolean"
              },
              "surface_bypasses_downgrade_proof": {
                "type": "boolean"
              },
              "surface_bypasses_profile_drift": {
                "type": "boolean"
              },
              "raw_surface_material_exported": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "composition_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guard_effect",
        "profile_assessment_effect",
        "current_actionability_effect",
        "replay_visibility_effect",
        "aggregate_interpretation_effect",
        "portability_effect",
        "suppression_reasons"
      ],
      "properties": {
        "guard_effect": {
          "type": "string",
          "enum": [
            "current_use_allowed",
            "current_use_guarded",
            "historical_only",
            "metadata_only",
            "suppressed",
            "fail_closed"
          ]
        },
        "profile_assessment_effect": {
          "type": "string",
          "enum": [
            "no_effect",
            "profile_evidence",
            "updated_conformance",
            "reopened_assessment"
          ]
        },
        "current_actionability_effect": {
          "type": "string",
          "enum": [
            "no_effect",
            "actionability_updated",
            "current_actionability_supported"
          ]
        },
        "replay_visibility_effect": {
          "type": "string",
          "enum": [
            "no_effect",
            "current_replay_visibility_supported",
            "historical_only",
            "suppressed"
          ]
        },
        "aggregate_interpretation_effect": {
          "type": "string",
          "enum": [
            "no_effect",
            "current_supported",
            "historical_only",
            "suppressed"
          ]
        },
        "portability_effect": {
          "type": "string",
          "enum": [
            "not_applicable",
            "portable_current_guarded",
            "portable_historical_only",
            "not_portable",
            "metadata_only",
            "suppressed"
          ]
        },
        "suppression_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "none",
              "profile_drift_not_current",
              "downgrade_proof_missing_or_weak",
              "lifecycle_suppressed",
              "transparency_policy_not_current",
              "digest_binding_not_current",
              "unknown_newer_version",
              "portability_failure",
              "surface_scope_mismatch"
            ]
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "non_upgrade_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guard_is_profile_evidence",
        "guard_updates_timestate",
        "guard_updates_profile_assessment",
        "guard_updates_actionability",
        "guard_reopens_assessment",
        "guard_interpreted_as_timesync_provenance",
        "guard_overrides_lifecycle_suppression",
        "guard_bypasses_downgrade_proof",
        "guard_bypasses_profile_drift",
        "raw_composed_surface_material_exported"
      ],
      "properties": {
        "guard_is_profile_evidence": {
          "type": "boolean"
        },
        "guard_updates_timestate": {
          "type": "boolean"
        },
        "guard_updates_profile_assessment": {
          "type": "boolean"
        },
        "guard_updates_actionability": {
          "type": "boolean"
        },
        "guard_reopens_assessment": {
          "type": "boolean"
        },
        "guard_interpreted_as_timesync_provenance": {
          "type": "boolean"
        },
        "guard_overrides_lifecycle_suppression": {
          "type": "boolean"
        },
        "guard_bypasses_downgrade_proof": {
          "type": "boolean"
        },
        "guard_bypasses_profile_drift": {
          "type": "boolean"
        },
        "raw_composed_surface_material_exported": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "guard_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "binds"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binds": {
          "type": "string",
          "enum": [
            "scope_composition_guard"
          ]
        }
      }
    },
    "matrix_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "binds"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binds": {
          "type": "string",
          "enum": [
            "scope_composition_decision_matrix"
          ]
        }
      }
    },
    "note": {
      "type": "string"
    },
    "temporal_coherence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "evaluation_window",
        "input_observations",
        "coherence_decision",
        "non_provenance_boundary"
      ],
      "properties": {
        "policy_version": {
          "type": "string",
          "const": "rev0090"
        },
        "evaluation_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not_before",
            "not_after",
            "max_span_seconds",
            "basis"
          ],
          "properties": {
            "not_before": {
              "type": "string",
              "format": "date-time"
            },
            "not_after": {
              "type": "string",
              "format": "date-time"
            },
            "max_span_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400
            },
            "basis": {
              "type": "string",
              "enum": [
                "local_policy_window",
                "evidence_freshness_window",
                "operator_policy",
                "historical_record_only",
                "unknown"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "input_observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surface",
              "time_role",
              "observed_at",
              "freshness_status",
              "current_use_effect"
            ],
            "properties": {
              "surface": {
                "type": "string",
                "enum": [
                  "profile_compatibility_drift",
                  "discovery_version_negotiation",
                  "discovery_digest_binding",
                  "aggregate_correction_authority_lifecycle",
                  "aggregate_lifecycle_rollup",
                  "transparency_trust_policy_lifecycle",
                  "transparency_policy_equivalence",
                  "external_transparency_receipt",
                  "replay_transparency_anchor",
                  "correction_authority_notification",
                  "portable_digest_binding_policy",
                  "scope_composition_decision_matrix"
                ]
              },
              "time_role": {
                "type": "string",
                "enum": [
                  "profile_drift_evaluated_at",
                  "discovery_negotiated_at",
                  "digest_policy_checked_at",
                  "lifecycle_checked_at",
                  "revocation_checked_at",
                  "lifecycle_rollup_checked_at",
                  "transparency_policy_checked_at",
                  "transparency_receipt_observed_at",
                  "transparency_anchor_observed_at",
                  "notification_observed_at",
                  "decision_matrix_observed_at",
                  "guard_evaluated_at"
                ]
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "freshness_status": {
                "type": "string",
                "enum": [
                  "fresh_at_guard_evaluation",
                  "stale_at_guard_evaluation",
                  "unchecked",
                  "not_applicable"
                ]
              },
              "current_use_effect": {
                "type": "string",
                "enum": [
                  "no_effect",
                  "suppress_current_use",
                  "historical_only",
                  "fail_closed"
                ]
              },
              "max_age_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "source_time_digest": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "algorithm",
                  "value",
                  "binds"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "enum": [
                      "sha256"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[A-Fa-f0-9]{64}$"
                  },
                  "binds": {
                    "type": "string",
                    "enum": [
                      "profile_compatibility_drift_matrix",
                      "profile_downgrade_proof",
                      "digest_binding_policy",
                      "aggregate_correction_authority_lifecycle_summary",
                      "aggregate_lifecycle_decision_table",
                      "transparency_trust_policy_reference",
                      "external_transparency_receipt",
                      "scope_composition_decision_matrix"
                    ]
                  }
                }
              },
              "policy_reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "coherence_decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "all_current_inputs_within_window",
            "guard_evaluated_within_window",
            "stale_input_blocks_current_use"
          ],
          "properties": {
            "decision": {
              "type": "string",
              "enum": [
                "coherent_current_guard",
                "coherent_historical_only",
                "metadata_only",
                "fail_closed"
              ]
            },
            "all_current_inputs_within_window": {
              "type": "boolean"
            },
            "guard_evaluated_within_window": {
              "type": "boolean"
            },
            "stale_input_blocks_current_use": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "non_provenance_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temporal_metadata_updates_timestate",
            "temporal_metadata_updates_profile_assessment",
            "temporal_metadata_updates_actionability",
            "temporal_metadata_interpreted_as_time_source_provenance",
            "stale_input_reuse_allowed_for_current"
          ],
          "properties": {
            "temporal_metadata_updates_timestate": {
              "type": "boolean",
              "const": false
            },
            "temporal_metadata_updates_profile_assessment": {
              "type": "boolean",
              "const": false
            },
            "temporal_metadata_updates_actionability": {
              "type": "boolean",
              "const": false
            },
            "temporal_metadata_interpreted_as_time_source_provenance": {
              "type": "boolean",
              "const": false
            },
            "stale_input_reuse_allowed_for_current": {
              "type": "boolean",
              "const": false
            },
            "note": {
              "type": "string"
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
