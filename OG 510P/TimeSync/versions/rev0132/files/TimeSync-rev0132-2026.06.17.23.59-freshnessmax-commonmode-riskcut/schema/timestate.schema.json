{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/timestate.schema.json",
  "title": "TimeSync TimeState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interval",
    "timescale",
    "freshness",
    "regime",
    "source_posture",
    "applicability"
  ],
  "properties": {
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earliest",
        "latest"
      ],
      "properties": {
        "earliest": {
          "type": "string",
          "format": "date-time"
        },
        "latest": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "timescale": {
      "type": "string",
      "minLength": 1
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_discipline": {
          "type": "string",
          "format": "date-time"
        },
        "last_correction": {
          "type": "string",
          "format": "date-time"
        },
        "max_staleness_ms": {
          "type": "number",
          "minimum": 0
        },
        "profile_expression": {
          "type": "string"
        }
      },
      "minProperties": 1
    },
    "regime": {
      "type": "string",
      "enum": [
        "normal",
        "degraded",
        "holdover",
        "partition_local",
        "recovery",
        "unknown"
      ]
    },
    "source_posture": {
      "type": "string",
      "enum": [
        "single_source",
        "multi_source_agreement",
        "authenticated_only",
        "mixed_authenticated",
        "local_holdover_only",
        "unknown"
      ]
    },
    "applicability": {
      "type": "string",
      "minLength": 1
    }
  }
}
