{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/validity-horizon.schema.json",
  "title": "TimeSync Profile Assessment Validity Horizon",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluated_at",
    "current_actionability",
    "basis",
    "assessment_time_binding",
    "export_time_role",
    "evidence_posture"
  ],
  "properties": {
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "not_after": {
      "type": "string",
      "format": "date-time"
    },
    "current_actionability": {
      "type": "string",
      "enum": [
        "actionable",
        "conditional",
        "record_only",
        "not_actionable",
        "unknown"
      ]
    },
    "basis": {
      "type": "string",
      "enum": [
        "profile_policy",
        "local_policy",
        "freshness",
        "holdover_model",
        "retention_context",
        "operator_configuration",
        "unknown"
      ]
    },
    "assessment_time_binding": {
      "type": "string",
      "enum": [
        "profile_assessment_time",
        "timestate_interval",
        "freshness_state",
        "holdover_model",
        "policy_defined",
        "historical_record_only",
        "unknown"
      ]
    },
    "export_time_role": {
      "type": "string",
      "enum": [
        "not_used",
        "record_timestamp_only",
        "used_as_freshness_basis"
      ]
    },
    "evidence_posture": {
      "type": "string",
      "enum": [
        "claimed",
        "assessed",
        "profile_defined",
        "redacted",
        "unknown"
      ]
    },
    "policy_reference": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  }
}
