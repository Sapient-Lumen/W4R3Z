              ]
            },
            "related_policy_state": {
              "type": "string",
              "enum": [
                "active",
                "pending_activation",
                "expired",
                "revoked",
                "retired",
                "superseded",
                "unknown"
              ]
            },
            "equivalence_not_before": {
              "type": "string",
              "format": "date-time"
            },
            "equivalence_not_after": {
              "type": "string",
              "format": "date-time"
            },
            "successor_compatibility_statement_digest": {
