            "monitor_cohort_relation",
            "split_view_handling_relation",
            "weaker_thresholds_allowed"
          ],
          "properties": {
            "anchor_freshness_relation": {
              "type": "string",
              "enum": [
                "identical",
                "subject_stricter_or_equal",
                "related_stricter_or_equal",
                "weaker",
                "unknown"
              ]
            },
            "checkpoint_consistency_relation": {
              "type": "string",
              "enum": [
                "identical",
                "subject_stricter_or_equal",
                "related_stricter_or_equal",
                "weaker",
                "unknown"
              ]
            },
            "witness_threshold_relation": {
              "type": "string",
              "enum": [
                "identical",
                "subject_stricter_or_equal",
                "related_stricter_or_equal",
                "weaker",
                "unknown"
              ]
            },
            "monitor_cohort_relation": {
              "type": "string",
              "enum": [
                "identical",
                "subject_stricter_or_equal",
                "related_stricter_or_equal",
                "weaker",
                "unknown"
              ]
            },
            "split_view_handling_relation": {
              "type": "string",
              "enum": [
                "identical",
                "subject_stricter_or_equal",
                "related_stricter_or_equal",
                "weaker",
                "unknown"
              ]
            },
            "weaker_thresholds_allowed": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "non_upgrade_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_equivalence_is_profile_evidence",
