      "properties": {
        "equivalence_scope": {
          "type": "string",
          "enum": [
            "replay_visibility_only"
          ]
        },
        "subject_policy_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_authority",
            "policy_id",
            "policy_version",
            "policy_digest"
          ],
          "properties": {
            "policy_authority": {
              "type": "string",
              "minLength": 1
            },
            "policy_id": {
              "type": "string",
              "minLength": 1
            },
            "policy_version": {
              "type": "string",
              "minLength": 1
            },
            "policy_digest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "algorithm",
                "value",
                "binds"
              ],
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "sha256"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{64}$"
                },
                "binds": {
                  "type": "string",
                  "const": "transparency_trust_policy_rules"
                }
              }
            }
          }
        },
        "related_policy_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_authority",
            "policy_id",
            "policy_version",
            "policy_digest"
          ],
          "properties": {
            "policy_authority": {
              "type": "string",
              "minLength": 1
            },
            "policy_id": {
              "type": "string",
              "minLength": 1
            },
            "policy_version": {
              "type": "string",
              "minLength": 1
            },
            "policy_digest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "algorithm",
                "value",
                "binds"
              ],
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "sha256"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{64}$"
                },
                "binds": {
                  "type": "string",
                  "const": "transparency_trust_policy_rules"
                }
              }
            }
          }
        },
        "equivalence_relation": {
          "type": "string",
          "enum": [
            "identical_policy_digest",
            "stricter_or_equal_thresholds",
            "locally_accepted_threshold_equivalence",
            "weaker_or_unknown"
