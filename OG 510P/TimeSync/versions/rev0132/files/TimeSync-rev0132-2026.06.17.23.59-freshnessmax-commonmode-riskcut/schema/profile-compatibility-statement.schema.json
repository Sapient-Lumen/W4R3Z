                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "algorithm",
                    "value",
                    "binds"
                  ],
                  "properties": {
                    "algorithm": {
                      "type": "string",
                      "enum": [
                        "sha256"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{64}$"
                    },
                    "binds": {
                      "type": "string",
                      "const": "transparency_trust_policy_rules"
                    }
                  }
                },
                "related_successor_policy_digest": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "algorithm",
                    "value",
                    "binds"
                  ],
                  "properties": {
                    "algorithm": {
                      "type": "string",
                      "enum": [
                        "sha256"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{64}$"
                    },
                    "binds": {
                      "type": "string",
                      "const": "transparency_trust_policy_rules"
                    }
                  }
                },
                "thresholds_weakened": {
                  "type": "boolean"
                },
                "note": {
                  "type": "string"
                }
              }
            },
