            "policy_equivalence_reopens_assessment",
            "policy_equivalence_interpreted_as_timesync_provenance",
            "trust_anchor_or_witness_roster_exported"
          ],
          "properties": {
            "policy_equivalence_is_profile_evidence": {
              "type": "boolean"
            },
            "policy_equivalence_updates_actionability": {
              "type": "boolean"
            },
            "policy_equivalence_reopens_assessment": {
              "type": "boolean"
            },
            "policy_equivalence_interpreted_as_timesync_provenance": {
              "type": "boolean"
            },
            "trust_anchor_or_witness_roster_exported": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "note": {
          "type": "string"
        },
        "policy_lifecycle_equivalence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluated_at",
            "current_equivalence_state",
            "subject_policy_state",
            "related_policy_state",
            "equivalence_not_before",
            "equivalence_not_after",
