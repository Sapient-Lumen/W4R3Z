{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/profile-compatibility-statement.schema.json",
  "title": "TimeSync Profile Compatibility Statement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "statement_version",
    "issuer_authority",
    "issued_at",
    "expires_at",
    "subject_profile",
    "related_profile",
    "relation",
    "evidence_policy_relation",
    "applicability_mapping",
    "binding"
  ],
  "properties": {
    "statement_version": {
      "type": "string",
      "const": "TimeSync-profile-compatibility-v1"
    },
    "issuer_authority": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject_profile": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.invalid/timesync/schema/profile-reference.schema.json",
      "title": "TimeSync Profile Reference",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authority",
        "digest"
      ],
      "anyOf": [
        {
          "required": [
            "version"
          ]
        },
        {
          "required": [
            "revision"
          ]
        }
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "normative_profile_rules"
            }
          }
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "issuer",
            "signed_at",
            "signature"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "signed_profile_binding"
            },
            "issuer": {
              "type": "string",
              "minLength": 1
            },
            "signed_at": {
              "type": "string",
              "format": "date-time"
            },
            "signature": {
              "type": "string",
              "minLength": 1
            },
            "covers": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "authority",
                  "id",
                  "version",
                  "revision",
                  "digest",
                  "normative_rules"
                ]
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "related_profile": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.invalid/timesync/schema/profile-reference.schema.json",
      "title": "TimeSync Profile Reference",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authority",
        "digest"
      ],
      "anyOf": [
        {
          "required": [
            "version"
          ]
        },
        {
          "required": [
            "revision"
          ]
        }
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "normative_profile_rules"
            }
          }
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "issuer",
            "signed_at",
            "signature"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "signed_profile_binding"
            },
            "issuer": {
              "type": "string",
              "minLength": 1
            },
            "signed_at": {
              "type": "string",
              "format": "date-time"
            },
            "signature": {
              "type": "string",
              "minLength": 1
            },
            "covers": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "authority",
                  "id",
                  "version",
                  "revision",
                  "digest",
                  "normative_rules"
                ]
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "relation": {
      "type": "string",
      "enum": [
        "exact_equivalent",
        "compatible_with",
        "supersedes",
        "alias_for"
      ]
    },
    "evidence_policy_relation": {
      "type": "string",
      "enum": [
        "identical",
        "stricter_or_equal",
        "weaker",
        "unknown"
      ]
    },
    "applicability_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "identity",
            "explicit_profile_local_map",
            "not_asserted"
          ]
        },
        "map_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "enum": [
                "compatibility_applicability_mapping",
                "identity_mapping_statement"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "explicit_profile_local_map"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "map_digest"
            ]
          }
        }
      ]
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "issuer",
        "signed_at",
        "signature",
        "covers"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "signed_profile_compatibility_statement"
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "covers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "statement_version",
              "issuer_authority",
              "subject_profile",
              "related_profile",
              "relation",
              "evidence_policy_relation",
              "applicability_mapping",
              "caveats",
              "issued_at",
              "expires_at",
              "compatible_workflows",
              "transparency_policy_equivalence",
              "policy_lifecycle_equivalence",
              "compatibility_drift"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "note": {
      "type": "string"
    },
    "compatible_workflows": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "profile_assessment_export",
          "evaluator_evidence_summary",
          "authorized_verifier_challenge_result_portability",
          "replay_transparency_policy_equivalence",
          "replay_transparency_recovery_attestation_portability",
          "profile_compatibility_drift_review",
          "aggregate_lifecycle_portability",
          "discovery_downgrade_review"
        ]
      },
      "uniqueItems": true
    },
    "transparency_policy_equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equivalence_scope",
        "subject_policy_reference",
        "related_policy_reference",
        "equivalence_relation",
        "threshold_equivalence",
        "policy_lifecycle_equivalence",
        "non_upgrade_boundary"
