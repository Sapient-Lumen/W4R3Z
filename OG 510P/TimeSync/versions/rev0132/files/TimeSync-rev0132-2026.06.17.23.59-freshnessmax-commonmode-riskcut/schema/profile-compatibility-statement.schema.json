                    "not_checked",
                    "unknown"
                  ]
                },
                "checked_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "authority": {
                  "type": "string",
                  "minLength": 1
                },
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "digest": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "algorithm",
                    "value",
                    "binds"
                  ],
                  "properties": {
                    "algorithm": {
                      "type": "string",
                      "enum": [
                        "sha256"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{64}$"
                    },
                    "binds": {
                      "type": "string",
                      "enum": [
                        "transparency_trust_policy_rules",
                        "transparency_trust_policy_lifecycle_status",
                        "transparency_trust_policy_revocation_status",
                        "profile_compatibility_statement"
                      ]
                    }
                  }
                },
                "note": {
                  "type": "string"
                }
              }
            },
            "drift_check": {
              "type": "object",
              "additionalProperties": false,
              "required": [
