                "lifecycle_equivalence_interpreted_as_timesync_provenance",
                "policy_repository_metadata_exported"
              ],
              "properties": {
                "lifecycle_equivalence_is_profile_evidence": {
                  "type": "boolean"
                },
                "lifecycle_equivalence_updates_actionability": {
                  "type": "boolean"
                },
                "lifecycle_equivalence_reopens_assessment": {
                  "type": "boolean"
                },
                "lifecycle_equivalence_interpreted_as_timesync_provenance": {
                  "type": "boolean"
                },
                "policy_repository_metadata_exported": {
                  "type": "boolean"
                },
                "note": {
                  "type": "string"
                }
              }
            },
            "note": {
              "type": "string"
            },
            "sequence_equivalence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subject_sequence_status",
                "related_sequence_status",
                "sequence_relation",
                "rollback_status",
