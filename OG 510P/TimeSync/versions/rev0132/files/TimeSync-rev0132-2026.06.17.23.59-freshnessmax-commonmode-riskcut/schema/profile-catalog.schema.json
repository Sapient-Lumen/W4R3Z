{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/profile-catalog.schema.json",
  "title": "TimeSync Profile Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "revision",
    "catalog_scope",
    "generated_at",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "catalog_scope": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "Embedded TimeSync Profile Applicability Map",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authority",
          "id",
          "version",
          "lifecycle_state",
          "purpose",
          "dominant_timing_pressure",
          "obligations",
          "applicability_labels",
          "fallback_mappings",
          "reference_policy",
          "evidence_policy",
          "normative_rules_digest"
        ],
        "properties": {
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle_state": {
            "type": "string",
            "enum": [
              "active",
              "superseded",
              "deprecated",
              "revoked",
              "unknown"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "dominant_timing_pressure": {
            "type": "string",
            "minLength": 1
          },
          "obligations": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required_items",
              "profile_default_items",
              "requestable_items"
            ],
            "properties": {
              "required_items": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "profile_default_items": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "requestable_items": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          },
          "applicability_labels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "rank",
                "description"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "rank": {
                  "type": "integer",
                  "minimum": 0
                },
                "dimension": {
                  "type": "string",
                  "enum": [
                    "time",
                    "phase",
                    "frequency",
                    "combination",
                    "unknown"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "fallback_mappings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "from",
                "to",
                "trigger",
                "boundary_context_required"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "trigger": {
                  "type": "string",
                  "minLength": 1
                },
                "boundary_context_required": {
                  "type": "boolean"
                }
              }
            }
          },
          "reference_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minimum_export_tier",
              "digest_required_when",
              "signed_binding_required_when"
            ],
            "properties": {
              "minimum_export_tier": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "digest_required_when": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "signed_binding_required_when": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          },
          "normative_rules_digest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "value",
              "binds"
            ],
            "properties": {
              "algorithm": {
                "type": "string",
                "enum": [
                  "sha256"
                ]
              },
              "value": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "binds": {
                "type": "string",
                "const": "normative_profile_rules"
              }
            }
          },
          "evidence_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary_item_name",
              "default_visibility",
              "retention_required",
              "retention_required_when",
              "profile_default_when",
              "minimum_summary_items",
              "classes_that_cannot_satisfy_profile_obligations"
            ],
            "properties": {
              "summary_item_name": {
                "type": "string",
                "const": "evaluator_evidence_summary"
              },
              "default_visibility": {
                "type": "string",
                "enum": [
                  "local_only",
                  "requestable",
                  "profile_default",
                  "retention_only"
                ]
              },
              "retention_required_when": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "profile_default_when": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "minimum_summary_items": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "classes_that_cannot_satisfy_profile_obligations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "local_measurement_summary",
                    "authenticated_source_claim",
                    "unauthenticated_source_claim",
                    "source_diversity_summary",
                    "operator_configuration",
                    "profile_catalog_rule",
                    "validity_horizon_summary",
                    "local_policy_rule",
                    "external_evidence_reference",
                    "authorized_verifier_disclosure",
                    "replay_transparency_receipt",
                    "witness_cohort_summary",
                    "transparency_trust_policy_reference",
                    "lifecycle_authority_rotation_summary",
                    "lifecycle_authority_recovery_attestation",
                    "recovery_audit_rollup_summary",
                    "aggregate_privacy_control_summary",
                    "aggregate_revision_lineage_summary",
                    "aggregate_correction_authority_summary",
                    "aggregate_correction_authority_lifecycle_summary",
                    "portable_digest_binding_policy_summary",
                    "scope_composition_guard_summary",
                    "retained_prior_assessment",
                    "transport_metadata_only",
                    "not_observed"
                  ]
                },
                "uniqueItems": true
              },
              "retention_required": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
