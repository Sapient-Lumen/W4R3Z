{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/profile-reference.schema.json",
  "title": "TimeSync Profile Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "anyOf": [
    {
      "required": [
        "version"
      ]
    },
    {
      "required": [
        "revision"
      ]
    }
  ],
  "properties": {
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "binds"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binds": {
          "type": "string",
          "const": "normative_profile_rules"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "issuer",
        "signed_at",
        "signature"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "signed_profile_binding"
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "covers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "authority",
              "id",
              "version",
              "revision",
              "digest",
              "normative_rules"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
