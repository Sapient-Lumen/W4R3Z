{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/policy-lifecycle-authority-recovery-attestation.schema.json",
  "title": "TimeSync Policy Lifecycle Authority Recovery Attestation Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recovery_attestation_version",
    "attestation_id",
    "issued_at",
    "verified_at",
    "attestation_status",
    "replay_visibility_effect",
    "scope",
    "affected_authority_digest",
    "recovery_or_successor_authority_digest",
    "response_digest",
    "attestation_digest",
    "incident_window",
    "portability",
    "non_interpretation_boundary"
  ],
  "properties": {
    "recovery_attestation_version": {
      "type": "string",
      "const": "1.0"
    },
    "attestation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "attestation_status": {
      "type": "string",
      "enum": [
        "current",
        "expired",
        "revoked",
        "superseded",
        "under_review",
        "unknown_or_redacted"
      ]
    },
    "replay_visibility_effect": {
      "type": "string",
      "enum": [
        "recovered_current",
        "historical_only",
        "contested_visibility",
        "unknown"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_kind",
        "policy_digest",
        "authority_scope"
      ],
      "properties": {
        "scope_kind": {
          "type": "string",
          "enum": [
            "single_policy_digest",
            "policy_family",
            "operator_policy_set",
            "redacted_cohort"
          ]
        },
        "policy_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "transparency_trust_policy_rules"
            }
          }
        },
        "authority_scope": {
          "type": "string",
          "enum": [
            "single_policy_digest",
            "policy_family",
            "operator_policy_set",
            "redacted_cohort",
            "unknown_or_redacted"
          ]
        },
        "profile_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "normative_profile_rules"
            }
          }
        }
      }
    },
    "affected_authority_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "binds"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binds": {
          "type": "string",
          "enum": [
            "transparency_trust_policy_lifecycle_authority",
            "transparency_trust_policy_lifecycle_authority_compromise_response"
          ]
        }
      }
    },
    "recovery_or_successor_authority_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "binds"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binds": {
          "type": "string",
          "enum": [
            "transparency_trust_policy_lifecycle_authority",
            "transparency_trust_policy_lifecycle_authority_rotation",
            "transparency_trust_policy_lifecycle_authority_compromise_response"
          ]
        }
      }
    },
    "response_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "binds"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binds": {
          "type": "string",
          "enum": [
            "transparency_trust_policy_lifecycle_authority_compromise_response",
            "transparency_trust_policy_lifecycle_authority_recovery_attestation"
          ]
        }
      }
    },
    "attestation_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "binds"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binds": {
          "type": "string",
          "const": "transparency_trust_policy_lifecycle_authority_recovery_attestation"
        }
      }
    },
    "incident_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_state",
        "incident_forensics_exported",
        "window_updates_replay_visibility_only"
      ],
      "properties": {
        "window_state": {
          "type": "string",
          "enum": [
            "bounded",
            "open_under_review",
            "redacted_bounded",
            "unknown_or_redacted"
          ]
        },
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "not_after": {
          "type": "string",
          "format": "date-time"
        },
        "contained_at": {
          "type": "string",
          "format": "date-time"
        },
        "incident_forensics_exported": {
          "type": "boolean",
          "const": false
        },
        "window_updates_replay_visibility_only": {
          "type": "boolean",
          "const": true
        },
        "note": {
          "type": "string"
        }
      }
    },
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_scope",
        "portability_checked_at",
        "portability_updates_replay_visibility_only"
      ],
      "properties": {
        "operator_scope": {
          "type": "string",
          "enum": [
            "same_operator_only",
            "compatible_operator_bound",
            "not_portable",
            "unknown_or_redacted"
          ]
        },
        "portability_checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "compatibility_statement_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "profile_compatibility_statement"
            }
          }
        },
        "portability_updates_replay_visibility_only": {
          "type": "boolean",
          "const": true
        },
        "note": {
          "type": "string"
        }
      }
    },
    "non_interpretation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recovery_attestation_is_profile_evidence",
        "recovery_attestation_updates_actionability",
        "recovery_attestation_reopens_assessment",
        "recovery_attestation_interpreted_as_timesync_provenance",
        "authority_key_material_exported",
        "authority_roster_exported",
        "delegation_chain_exported",
        "incident_forensics_exported",
        "legal_authority_details_exported",
        "external_incident_record_interpreted_by_timesync"
      ],
      "properties": {
        "recovery_attestation_is_profile_evidence": {
          "type": "boolean",
          "const": false
        },
        "recovery_attestation_updates_actionability": {
          "type": "boolean",
          "const": false
        },
        "recovery_attestation_reopens_assessment": {
          "type": "boolean",
          "const": false
        },
        "recovery_attestation_interpreted_as_timesync_provenance": {
          "type": "boolean",
          "const": false
        },
        "authority_key_material_exported": {
          "type": "boolean",
          "const": false
        },
        "authority_roster_exported": {
          "type": "boolean",
          "const": false
        },
        "delegation_chain_exported": {
          "type": "boolean",
          "const": false
        },
        "incident_forensics_exported": {
          "type": "boolean",
          "const": false
        },
        "legal_authority_details_exported": {
          "type": "boolean",
          "const": false
        },
        "external_incident_record_interpreted_by_timesync": {
          "type": "boolean",
          "const": false
        },
        "note": {
          "type": "string"
        }
      }
    },
    "note": {
      "type": "string"
    }
  }
}
