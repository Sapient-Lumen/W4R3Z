{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/aggregate-lifecycle-decision-table.schema.json",
  "title": "TimeSync Aggregate Lifecycle Decision Table",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "table_version",
    "generated_at",
    "decision_scope",
    "canonicalization",
    "current_interpretation_decisions",
    "rows",
    "boundary"
  ],
  "properties": {
    "table_version": {
      "type": "string",
      "const": "rev0086"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_scope": {
      "type": "string",
      "const": "aggregate_correction_authority_lifecycle"
    },
    "canonicalization": {
      "type": "string",
      "enum": [
        "json_canonicalization_scheme_rfc8785",
        "timesync_python_json_sort_keys_legacy"
      ]
    },
    "current_interpretation_decisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "current_supported",
          "current_supported_guarded",
          "historical_only",
          "suppressed_by_emergency_withdrawal",
          "suppressed_by_revocation",
          "suppressed_by_contestation",
          "suppressed_by_unknown_lifecycle",
          "suppressed_by_notification_staleness",
          "suppressed_by_portability_failure"
        ]
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "lifecycle_state",
          "allowed_lifecycle_effects",
          "allowed_current_interpretation_decisions",
          "required_posture",
          "digest_requirements",
          "notes"
        ],
        "properties": {
          "row_id": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle_state": {
            "type": "string"
          },
          "allowed_lifecycle_effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "allowed_current_interpretation_decisions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "required_posture": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "array",
                "boolean",
                "null"
              ]
            }
          },
          "digest_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_table_updates_profile_assessment",
        "decision_table_updates_replay_visibility_only",
        "decision_table_exports_authority_registry",
        "decision_table_interpreted_as_timesync_provenance"
      ],
      "properties": {
        "decision_table_updates_profile_assessment": {
          "type": "boolean",
          "const": false
        },
        "decision_table_updates_replay_visibility_only": {
          "type": "boolean",
          "const": true
        },
        "decision_table_exports_authority_registry": {
          "type": "boolean",
          "const": false
        },
        "decision_table_interpreted_as_timesync_provenance": {
          "type": "boolean",
          "const": false
        },
        "note": {
          "type": "string"
        }
      }
    },
    "note": {
      "type": "string"
    }
  }
}
