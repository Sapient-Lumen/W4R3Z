{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/boundary-context.schema.json",
  "title": "TimeSync Boundary Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "preserve",
        "downgrade",
        "restate",
        "unknown"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "loss",
        "recovery",
        "conflict",
        "reconfiguration"
      ]
    },
    "note": {
      "type": "string"
    }
  }
}
