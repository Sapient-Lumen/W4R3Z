{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/profile.schema.json",
  "title": "TimeSync Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "purpose",
    "dominant_timing_pressure",
    "obligations"
  ],
  "properties": {
    "authority": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "dominant_timing_pressure": {
      "type": "string",
      "minLength": 1
    },
    "obligations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "profile_default_items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "requestable_items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "fallback_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "trigger",
          "allowed_applicability"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "allowed_applicability": {
            "type": "string"
          },
          "boundary_context_required": {
            "type": "boolean"
          }
        }
      }
    },
    "profile_reference_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_export_tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "digest_required_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signed_binding_required_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
