{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/timesync/schema/aggregate-correction-authority-lifecycle.schema.json",
  "title": "TimeSync Aggregate Correction Authority Lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lifecycle_state",
    "lifecycle_checked_at",
    "lifecycle_effect",
    "revocation_status",
    "emergency_withdrawal",
    "contestation",
    "lifecycle_boundary",
    "decision_table_digest",
    "current_interpretation_decision"
  ],
  "properties": {
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "active",
        "pending_rotation",
        "expired",
        "revoked",
        "emergency_withdrawal",
        "contested",
        "unknown_or_redacted"
      ]
    },
    "lifecycle_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle_effect": {
      "type": "string",
      "enum": [
        "aggregate_interpretation_current",
        "historical_only",
        "emergency_withdrawal_required",
        "contested",
        "unknown"
      ]
    },
    "lifecycle_policy_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "binds"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binds": {
          "type": "string",
          "enum": [
            "aggregate_correction_authority_lifecycle_rules",
            "aggregate_correction_authority_policy",
            "transparency_trust_policy_rules",
            "retained_operator_record"
          ]
        }
      }
    },
    "revocation_status": {
      "type": "string",
      "enum": [
        "not_revoked",
        "revoked",
        "not_checked",
        "unknown_or_redacted"
      ]
    },
    "revocation_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "emergency_withdrawal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "scope",
        "suppresses_current_interpretation",
        "resynchronization_state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "not_applicable",
            "active",
            "completed",
            "contested",
            "unknown_or_redacted"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "not_applicable",
            "aggregate_publication",
            "aggregate_revision_chain",
            "compatible_operator_chain",
            "redacted_or_aggregate_only"
          ]
        },
        "withdrawal_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "enum": [
                "aggregate_emergency_withdrawal_record",
                "aggregate_publication_revision_chain",
                "retained_operator_record"
              ]
            }
          }
        },
        "suppresses_current_interpretation": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "resynchronization_state": {
          "type": "string",
          "enum": [
            "not_applicable",
            "withdrawal_active",
            "resync_required",
            "resync_in_progress",
            "resync_completed",
            "resync_failed",
            "resync_contested",
            "historical_after_resync",
            "unknown_or_redacted"
          ]
        },
        "notification_policy_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "enum": [
                "aggregate_emergency_resynchronization_policy",
                "aggregate_correction_notification_batch",
                "retained_operator_record"
              ]
            }
          }
        },
        "resynchronization_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "enum": [
                "aggregate_emergency_resynchronization_policy",
                "aggregate_correction_notification_batch",
                "retained_operator_record"
              ]
            }
          }
        },
        "affected_chain_count_bucket": {
          "type": "string",
          "enum": [
            "not_applicable",
            "suppressed_small_group",
            "1",
            "2-4",
            "5-24",
            "25-99",
            "100_or_more",
            "unknown_or_redacted"
          ]
        },
        "remaining_unknown_count_bucket": {
          "type": "string",
          "enum": [
            "not_applicable",
            "suppressed_small_group",
            "0",
            "1",
            "2-4",
            "5-24",
            "25_or_more",
            "unknown_or_redacted"
          ]
        }
      }
    },
    "contestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "contestation_effect"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "none",
            "pending_contestation",
            "resolved_upheld",
            "resolved_overturned",
            "unknown_or_redacted"
          ]
        },
        "contestation_effect": {
          "type": "string",
          "enum": [
            "not_applicable",
            "aggregate_interpretation_current",
            "historical_only",
            "contested",
            "unknown"
          ]
        },
        "contestation_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "enum": [
                "aggregate_correction_authority_contestation_record",
                "aggregate_publication_revision_chain",
                "retained_operator_record"
              ]
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "lifecycle_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_roster_exported",
        "authority_key_material_exported",
        "revocation_endpoint_exported",
        "repository_topology_exported",
        "incident_forensics_exported",
        "legal_process_details_exported",
        "emergency_response_plan_exported",
        "contestation_party_identity_exported",
        "lifecycle_updates_profile_assessment",
        "lifecycle_updates_replay_visibility_only",
        "external_lifecycle_record_interpreted_as_timesync_provenance"
      ],
      "properties": {
        "authority_roster_exported": {
          "type": "boolean",
          "const": false
        },
        "authority_key_material_exported": {
          "type": "boolean",
          "const": false
        },
        "revocation_endpoint_exported": {
          "type": "boolean",
          "const": false
        },
        "repository_topology_exported": {
          "type": "boolean",
          "const": false
        },
        "incident_forensics_exported": {
          "type": "boolean",
          "const": false
        },
        "legal_process_details_exported": {
          "type": "boolean",
          "const": false
        },
        "emergency_response_plan_exported": {
          "type": "boolean",
          "const": false
        },
        "contestation_party_identity_exported": {
          "type": "boolean",
          "const": false
        },
        "lifecycle_updates_profile_assessment": {
          "type": "boolean",
          "const": false
        },
        "lifecycle_updates_replay_visibility_only": {
          "type": "boolean",
          "const": true
        },
        "external_lifecycle_record_interpreted_as_timesync_provenance": {
          "type": "boolean",
          "const": false
        },
        "note": {
          "type": "string"
        }
      }
    },
    "note": {
      "type": "string"
    },
    "decision_table_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "binds"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binds": {
          "type": "string",
          "const": "aggregate_lifecycle_decision_table"
        }
      }
    },
    "current_interpretation_decision": {
      "type": "string",
      "enum": [
        "current_supported",
        "current_supported_guarded",
        "historical_only",
        "suppressed_by_emergency_withdrawal",
        "suppressed_by_revocation",
        "suppressed_by_contestation",
        "suppressed_by_unknown_lifecycle",
        "suppressed_by_notification_staleness",
        "suppressed_by_portability_failure"
      ]
    },
    "lifecycle_portability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_scope",
        "portability_state",
        "authority_equivalence",
        "portability_updates_profile_assessment",
        "portability_updates_replay_visibility_only",
        "external_lifecycle_portability_interpreted_as_timesync_provenance"
      ],
      "properties": {
        "operator_scope": {
          "type": "string",
          "enum": [
            "same_operator",
            "compatible_operator_digest_bound",
            "redacted_cohort",
            "unknown_or_redacted"
          ]
        },
        "portability_state": {
          "type": "string",
          "enum": [
            "local_only",
            "portable_to_compatible_operator",
            "nonportable",
            "unknown_or_redacted"
          ]
        },
        "authority_equivalence": {
          "type": "string",
          "enum": [
            "not_applicable",
            "digest_bound_equivalent_or_stricter",
            "weaker_or_unknown"
          ]
        },
        "compatibility_statement_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "const": "profile_compatibility_statement"
            }
          }
        },
        "portable_lifecycle_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value",
            "binds"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "binds": {
              "type": "string",
              "enum": [
                "aggregate_correction_authority_lifecycle_summary",
                "aggregate_lifecycle_decision_table",
                "retained_operator_record"
              ]
            }
          }
        },
        "portability_updates_profile_assessment": {
          "type": "boolean",
          "const": false
        },
        "portability_updates_replay_visibility_only": {
          "type": "boolean",
          "const": true
        },
        "external_lifecycle_portability_interpreted_as_timesync_provenance": {
          "type": "boolean",
          "const": false
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
