{
  "authority": "example-finance-authority",
  "id": "P3-traceable-finance",
  "version": "1.0.0",
  "lifecycle_state": "active",
  "purpose": "Financial timestamping and audit contexts where traceability, documented uncertainty, retention, and profile identity matter.",
  "dominant_timing_pressure": "Traceability and retained reconstruction.",
  "obligations": {
    "required_items": [
      "timestate",
      "assessment_time",
      "assessed_profile",
      "profile_conformance"
    ],
    "profile_default_items": [
      "traceability_posture",
      "sync_dimension",
      "timescale_realization",
      "validity_horizon"
    ],
    "requestable_items": [
      "boundary_context",
      "policy_acceptance",
      "validity_scope",
      "clock_continuity_posture",
      "source_diversity_posture"
    ]
  },
  "applicability_labels": [
    {
      "name": "diagnostic_local_only",
      "rank": 0,
      "description": "Internal troubleshooting only; not an audit timestamp."
    },
    {
      "name": "internal_recordkeeping",
      "rank": 10,
      "description": "Internal recordkeeping without regulated timestamp claim."
    },
    {
      "name": "retained_audit_record",
      "rank": 20,
      "description": "Historical retained record whose profile reference is reconstructable for audit review."
    },
    {
      "name": "regulated_timestamping",
      "rank": 30,
      "description": "Timestamping use that satisfies the active traceable-finance profile obligations."
    }
  ],
  "fallback_mappings": [
    {
      "name": "regulated_to_recordkeeping",
      "from": "regulated_timestamping",
      "to": "internal_recordkeeping",
      "trigger": "traceability_or_reference_obligation_missing",
      "boundary_context_required": false
    },
    {
      "name": "audit_to_recordkeeping",
      "from": "retained_audit_record",
      "to": "internal_recordkeeping",
      "trigger": "retention_reference_not_resolvable_under_current_policy",
      "boundary_context_required": false
    },
    {
      "name": "recordkeeping_to_diagnostic",
      "from": "internal_recordkeeping",
      "to": "diagnostic_local_only",
      "trigger": "state_not_safe_for_local_records",
      "boundary_context_required": false
    }
  ],
  "reference_policy": {
    "minimum_export_tier": 3,
    "digest_required_when": [
      "retained",
      "detached",
      "regulated_export",
      "audit_reconstruction"
    ],
    "signed_binding_required_when": [
      "receiver_must_verify_profile_binding_issuer"
    ]
  },
  "evidence_policy": {
    "summary_item_name": "evaluator_evidence_summary",
    "default_visibility": "retention_only",
    "retention_required_when": [
      "retained",
      "detached",
      "regulated_export",
      "audit_reconstruction"
    ],
    "profile_default_when": [
      "regulated_timestamping_export",
      "current_actionability_or_replay_boundary"
    ],
    "minimum_summary_items": [
      "timestate.interval",
      "timestate.timescale",
      "timestate.freshness",
      "timestate.regime",
      "timestate.source_posture",
      "timestate.applicability",
      "assessment.assessed_profile",
      "assessment.profile_conformance",
      "assessment.applicability",
      "extension_hooks.traceability_posture",
      "extension_hooks.sync_dimension",
      "profile.required_items",
      "profile.profile_default_items",
      "policy_acceptance",
      "extension_hooks.timescale_realization",
      "assessment.validity_horizon"
    ],
    "classes_that_cannot_satisfy_profile_obligations": [
      "unauthenticated_source_claim",
      "external_evidence_reference",
      "authorized_verifier_disclosure",
      "replay_transparency_receipt",
      "witness_cohort_summary",
      "transparency_trust_policy_reference",
      "lifecycle_authority_rotation_summary",
      "lifecycle_authority_recovery_attestation",
      "recovery_audit_rollup_summary",
      "aggregate_privacy_control_summary",
      "aggregate_revision_lineage_summary",
      "aggregate_correction_authority_summary",
      "aggregate_correction_authority_lifecycle_summary",
      "portable_digest_binding_policy_summary",
      "scope_composition_guard_summary",
      "retained_prior_assessment",
      "transport_metadata_only",
      "not_observed"
    ],
    "retention_required": true
  },
  "normative_rules_digest": {
    "algorithm": "sha256",
    "value": "285944567f5e5304e0ab637a6fb0ee1809095f53140ab2de006f56f0005d0397",
    "binds": "normative_profile_rules"
  }
}
