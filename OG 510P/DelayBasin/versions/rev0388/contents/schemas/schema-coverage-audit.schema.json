{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DelayBasin schema coverage audit",
  "type": "object",
  "required": ["project", "revision", "surface", "guide_surface", "state", "generated_from", "coverage_policy", "non_claim", "coverage_rows", "counts", "failures"],
  "properties": {
    "project": {"const": "DelayBasin"},
    "revision": {"type": "string"},
    "surface": {"const": "SCHEMA-COVERAGE-AUDIT.json"},
    "guide_surface": {"const": "docs/00-meta/schema-coverage-audit.md"},
    "state": {"const": "generated-schema-coverage-audit"},
    "generated_from": {"type": "array", "items": {"type": "string"}},
    "coverage_policy": {
      "type": "object",
      "required": ["schema_backed", "contract_only", "external_standard", "unclassified"],
      "properties": {
        "schema_backed": {"type": "string"},
        "contract_only": {"type": "string"},
        "external_standard": {"type": "string"},
        "unclassified": {"type": "string"}
      }
    },
    "non_claim": {"type": "string"},
    "coverage_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surface", "coverage_class", "schema", "validators", "rationale", "status", "missing"],
        "properties": {
          "surface": {"type": "string"},
          "coverage_class": {"type": "string"},
          "schema": {"type": ["string", "null"]},
          "validators": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string"},
          "status": {"type": "string"},
          "missing": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["root_json_count", "schema_backed_count", "contract_only_count", "external_standard_count", "unclassified_count", "failures"],
      "properties": {
        "root_json_count": {"type": "integer"},
        "schema_backed_count": {"type": "integer"},
        "contract_only_count": {"type": "integer"},
        "external_standard_count": {"type": "integer"},
        "unclassified_count": {"type": "integer"},
        "failures": {"type": "integer"}
      }
    },
    "failures": {"type": "array", "items": {"type": "object"}}
  }
}
