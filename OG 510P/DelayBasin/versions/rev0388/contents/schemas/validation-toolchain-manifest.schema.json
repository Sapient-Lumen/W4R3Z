{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DelayBasin VALIDATION-TOOLCHAIN-MANIFEST.json public shape",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "project",
    "revision",
    "surface",
    "state",
    "ordered_lint_tools",
    "support_modules",
    "entrypoints",
    "counts"
  ],
  "properties": {
    "project": {
      "description": "Required public field for VALIDATION-TOOLCHAIN-MANIFEST.json",
      "type": "string"
    },
    "revision": {
      "description": "Current package revision",
      "type": "string"
    },
    "surface": {
      "description": "Self-identifying surface name",
      "type": "string"
    },
    "state": {
      "description": "Manifest state",
      "type": "string"
    },
    "ordered_lint_tools": {
      "description": "Ordered make-lint tool records",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "support_modules": {
      "description": "Imported helper/support module records",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "entrypoints": {
      "description": "Admission and packaging entrypoint records",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "counts": {
      "description": "Count summary",
      "type": "object"
    },
    "guide_surface": {
      "type": "string"
    },
    "non_claim": {
      "type": "string"
    },
    "generated_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ordering_rule": {
      "type": "string"
    },
    "hash_algorithm": {
      "type": "string"
    },
    "repair": {
      "type": "string"
    }
  }
}
