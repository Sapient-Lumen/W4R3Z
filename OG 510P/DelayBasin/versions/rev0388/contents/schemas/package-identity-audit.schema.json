{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DelayBasin PACKAGE-IDENTITY-AUDIT.json public shape",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "project",
    "revision",
    "surface",
    "state",
    "expected",
    "release_identity_rows",
    "json_revision_rows",
    "current_key_rows",
    "external_metadata_rows",
    "counts",
    "failures"
  ],
  "properties": {
    "project": {
      "description": "Required public field for PACKAGE-IDENTITY-AUDIT.json",
      "type": "string"
    },
    "revision": {
      "description": "Current package revision",
      "type": "string"
    },
    "surface": {
      "description": "Self-identifying surface name",
      "type": "string"
    },
    "state": {
      "description": "Audit state",
      "type": "string"
    },
    "expected": {
      "description": "Expected current revision, bundle, and question cues",
      "type": "object"
    },
    "release_identity_rows": {
      "description": "Receipt/manifest/status identity rows",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "json_revision_rows": {
      "description": "Root JSON revision rows",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "current_key_rows": {
      "description": "Root JSON current/head/latest revision key rows",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "external_metadata_rows": {
      "description": "External metadata revision and bundle token rows",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "counts": {
      "description": "Audit count summary",
      "type": "object"
    },
    "failures": {
      "description": "Failing package identity rows, empty for an admitted release",
      "type": "array"
    },
    "guide_surface": {
      "type": "string"
    },
    "generated_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_claim": {
      "type": "string"
    },
    "known_repaired_findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scan_policy": {
      "type": "object"
    }
  }
}
