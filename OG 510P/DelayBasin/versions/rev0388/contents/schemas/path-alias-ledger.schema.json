{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DelayBasin path alias ledger",
  "type": "object",
  "required": [
    "project",
    "revision",
    "surface",
    "state",
    "entries"
  ],
  "properties": {
    "project": {
      "const": "DelayBasin",
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "surface": {
      "const": "PATH-ALIAS-LEDGER.json",
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "old_path",
          "new_path",
          "handle",
          "kind"
        ]
      }
    },
    "non_claim": {
      "type": "string"
    },
    "alias_rule": {
      "type": "string"
    },
    "repair": {
      "type": "string"
    },
    "entry_count": {
      "type": "integer"
    },
    "path_budget": {
      "type": "object"
    },
    "current_revision": {
      "type": "string"
    },
    "governing_method": {
      "type": "string"
    }
  }
}
