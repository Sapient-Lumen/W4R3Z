{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DelayBasin basis provenance audit",
  "type": "object",
  "required": [
    "project",
    "revision",
    "surface",
    "guide_surface",
    "state",
    "generated_from",
    "policy",
    "non_claim",
    "basis_rows",
    "counts",
    "failures"
  ],
  "properties": {
    "project": {
      "const": "DelayBasin"
    },
    "revision": {
      "type": "string"
    },
    "surface": {
      "const": "BASIS-PROVENANCE-AUDIT.json"
    },
    "guide_surface": {
      "const": "docs/00-meta/basis-provenance-audit.md"
    },
    "state": {
      "const": "generated-basis-provenance-audit"
    },
    "generated_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy": {
      "type": "object"
    },
    "non_claim": {
      "type": "string"
    },
    "basis_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "expected",
          "observed",
          "status",
          "rationale"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "expected": {
            "type": [
              "string",
              "array",
              "object",
              "null",
              "integer",
              "boolean"
            ]
          },
          "observed": {
            "type": [
              "string",
              "array",
              "object",
              "null",
              "integer",
              "boolean"
            ]
          },
          "status": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "checks",
        "failures"
      ],
      "properties": {
        "checks": {
          "type": "integer"
        },
        "failures": {
          "type": "integer"
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
