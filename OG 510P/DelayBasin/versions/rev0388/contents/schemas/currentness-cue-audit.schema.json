{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DelayBasin CURRENTNESS-CUE-AUDIT.json public shape",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "project",
    "revision",
    "surface",
    "state",
    "expected",
    "status_fields",
    "landing_cues",
    "counts",
    "failures"
  ],
  "properties": {
    "project": {
      "description": "Required public field for CURRENTNESS-CUE-AUDIT.json",
      "type": "string"
    },
    "revision": {
      "description": "Current package revision",
      "type": "string"
    },
    "surface": {
      "description": "Self-identifying surface name",
      "type": "string"
    },
    "state": {
      "description": "Audit state",
      "type": "string"
    },
    "expected": {
      "description": "Expected current revision, bundle, and question cues",
      "type": "object"
    },
    "status_fields": {
      "description": "SURFACE-STATUS currentness fields",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "landing_cues": {
      "description": "Landing latest-revision cues",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "counts": {
      "description": "Audit count summary",
      "type": "object"
    },
    "failures": {
      "description": "Failing cue rows, empty for an admitted release",
      "type": "array"
    },
    "guide_surface": {
      "type": "string"
    },
    "generated_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_claim": {
      "type": "string"
    },
    "json_revision_cues": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "current_key_scan": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "known_repaired_findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scan_policy": {
      "type": "object"
    }
  }
}
