+    def rekey_search(self, old_token, new_token):
+
+        page = self.pages.get(old_token)
+
+        if page is None:
+            return
+
+        # Preserve the current tab order while changing the lookup key.
+        pages = [
+            (new_token if token == old_token else token, search_page)
+            for token, search_page in self.pages.items()
+        ]
+        self.pages.clear()
+        self.pages.update(pages)
+
+        page.token = new_token
+        page.reset_for_search_again()
+
+        if page.show_page:
+            self.remove_tab_changed(page.container)
+
+        self.window.update_title()
+
     def show_search(self, token):
 
         page = self.pages.get(token)
