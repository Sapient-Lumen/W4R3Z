+    def repeat_search(self, token):
+        """Repeat a search, preserving persistent-wishlist request identity."""
+
+        search = self.searches.get(token)
+
+        if search is None:
+            return None
+
+        if isinstance(search, WishSearchRequest):
+            self.send_search_request(token)
+            return token
+
+        self.remove_allowed_token(token)
+        self._own_tokens.discard(token)
+        self.token = increment_token(self.token)
+        new_token = self.token
+
+        del self.searches[token]
+        search.token = new_token
+        self.searches[new_token] = search
+
+        events.emit("rekey-search", token, new_token)
+        self.send_search_request(new_token)
+        return new_token
+
     def send_search_request(self, token):
 
         search = self.searches.get(token)
