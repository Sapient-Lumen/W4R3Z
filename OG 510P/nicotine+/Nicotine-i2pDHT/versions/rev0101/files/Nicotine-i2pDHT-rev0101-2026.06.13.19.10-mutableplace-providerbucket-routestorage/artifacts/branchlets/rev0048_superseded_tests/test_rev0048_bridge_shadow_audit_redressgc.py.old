from __future__ import annotations

from pathlib import Path
from types import SimpleNamespace

from i2p_dht_lab.auditquorum import (
    AuditQuorumDecisionKind,
    AuditStatementKind,
    AuditStatementStatus,
    assess_audit_quorum,
    make_audit_statement,
)
from i2p_dht_lab.bridgegovernancefold import audit_bridge_governance_fold
from i2p_dht_lab.bridgeshadow import (
    BridgeShadowDecisionKind,
    BridgeShadowIntent,
    assess_bridge_shadow,
    make_bridge_shadow_plan,
)
from i2p_dht_lab.identity import DhtKeypair
from i2p_dht_lab.ids import sha256
from i2p_dht_lab.moderationquarantine import ZERO_DIGEST
from i2p_dht_lab.redressgc import (
    RedressGcDecisionKind,
    RedressGcItemKind,
    assess_redress_gc,
    make_redress_gc_item,
)

NOW = 1_950_000
PROFILE = "profile-alpha"
SERVICE = "public-bridge"
SCOPE = sha256(b"scope-alpha")
REQUEST = sha256(b"request-alpha")
SUBJECT = sha256(b"subject-alpha")
K1 = DhtKeypair.from_seed(b"A" * 32)
K2 = DhtKeypair.from_seed(b"B" * 32)
K3 = DhtKeypair.from_seed(b"C" * 32)
K4 = DhtKeypair.from_seed(b"D" * 32)
K5 = DhtKeypair.from_seed(b"E" * 32)


def d(label: str) -> bytes:
    return sha256(label.encode("utf-8"))


def report(label: str, *, accept=True, watch=False, continue_publication=True, quench=False):
    return SimpleNamespace(
        accept=accept,
        watch=watch,
        continue_publication=continue_publication,
        quench=quench,
        profile_id=PROFILE,
        service_name=SERVICE,
        scope_digest=SCOPE,
        request_digest=REQUEST,
        report_digest=d(label + str(accept) + str(watch) + str(continue_publication) + str(quench)),
    )


def components(*, pub_accept=True, pub_watch=False, ledger_accept=True, ledger_watch=False, continue_publication=True, quench=False, quench_watch=False):
    return (
        report("publication", accept=pub_accept, watch=pub_watch),
        report("ledger", accept=ledger_accept, watch=ledger_watch),
        report("quench", accept=True, watch=quench_watch, continue_publication=continue_publication, quench=quench),
    )


def shadow_plan(*, keypair=K1, sequence=1, family="fam-a", path="path-a", publication=None, ledger=None, quench=None, scope=SCOPE, request=REQUEST, intent=BridgeShadowIntent.PUBLIC_REFRESH, previous=ZERO_DIGEST, payload=None):
    publication, ledger, quench = publication or components()[0], ledger or components()[1], quench or components()[2]
    return make_bridge_shadow_plan(
        keypair=keypair,
        intent=intent,
        profile_id=PROFILE,
        service_name=SERVICE,
        subject_key_digest=SUBJECT,
        scope_digest=scope,
        request_digest=request,
        publication_report_digest=publication.report_digest,
        publication_ledger_digest=ledger.report_digest,
        quench_report_digest=quench.report_digest,
        public_payload_digest=payload or d(f"payload-{sequence}"),
        side_effect_digest=d(f"side-effect-{sequence}"),
        sequence=sequence,
        previous_shadow_digest=previous,
        issued_at=NOW,
        expires_at=NOW + 100,
        family_id=family,
        path_family=path,
    )


def accepted_shadow(*, watch=False):
    pub, ledger, quench = components(pub_watch=watch)
    plans = (
        shadow_plan(keypair=K1, sequence=1, family="fam-a", path="path-a", publication=pub, ledger=ledger, quench=quench),
        shadow_plan(keypair=K2, sequence=2, family="fam-b", path="path-b", publication=pub, ledger=ledger, quench=quench),
    )
    return assess_bridge_shadow(plans, publication_report=pub, publication_ledger=ledger, quench_report=quench, now=NOW + 1, intent=BridgeShadowIntent.PUBLIC_REFRESH, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST, allow_watch=watch)


def test_bridge_shadow_accepts_component_bound_diverse_dryrun() -> None:
    shadow = accepted_shadow()
    assert shadow.decision_kind is BridgeShadowDecisionKind.ACCEPT_SHADOW
    assert shadow.accept
    assert shadow.family_count == 2
    assert len(shadow.component_digests) == 3


def test_bridge_shadow_holds_watch_and_quench_and_catches_replay_drift_fork() -> None:
    pub, ledger, quench = components(pub_watch=True)
    plan = shadow_plan(publication=pub, ledger=ledger, quench=quench)
    held = assess_bridge_shadow((plan,), publication_report=pub, publication_ledger=ledger, quench_report=quench, now=NOW + 1, intent=BridgeShadowIntent.PUBLIC_REFRESH, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST)
    assert held.decision_kind is BridgeShadowDecisionKind.HOLD_PUBLICATION_WATCH

    pub, ledger, blocked_quench = components(continue_publication=False, quench=True)
    plan = shadow_plan(publication=pub, ledger=ledger, quench=blocked_quench)
    blocked = assess_bridge_shadow((plan,), publication_report=pub, publication_ledger=ledger, quench_report=blocked_quench, now=NOW + 1, intent=BridgeShadowIntent.PUBLIC_REFRESH, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST)
    assert blocked.decision_kind is BridgeShadowDecisionKind.HOLD_QUENCH

    pub, ledger, quench = components()
    a = shadow_plan(keypair=K1, sequence=5, family="fam-a", path="path-a", publication=pub, ledger=ledger, quench=quench)
    replay = assess_bridge_shadow((a,), publication_report=pub, publication_ledger=ledger, quench_report=quench, now=NOW + 1, intent=BridgeShadowIntent.PUBLIC_REFRESH, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST, previously_seen_plan_digests=(a.plan_digest,))
    assert replay.decision_kind is BridgeShadowDecisionKind.QUARANTINE_REPLAY

    drift = shadow_plan(keypair=K1, sequence=1, family="fam-a", path="path-a", publication=pub, ledger=ledger, quench=quench, scope=d("other-scope"))
    assert assess_bridge_shadow((drift,), publication_report=pub, publication_ledger=ledger, quench_report=quench, now=NOW + 1, intent=BridgeShadowIntent.PUBLIC_REFRESH, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST).decision_kind is BridgeShadowDecisionKind.QUARANTINE_SCOPE_DRIFT

    fork_a = shadow_plan(keypair=K1, sequence=7, family="fam-a", path="path-a", publication=pub, ledger=ledger, quench=quench, payload=d("fork-a"))
    fork_b = shadow_plan(keypair=K2, sequence=7, family="fam-b", path="path-b", publication=pub, ledger=ledger, quench=quench, payload=d("fork-b"))
    assert assess_bridge_shadow((fork_a, fork_b), publication_report=pub, publication_ledger=ledger, quench_report=quench, now=NOW + 1, intent=BridgeShadowIntent.PUBLIC_REFRESH, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST).decision_kind is BridgeShadowDecisionKind.QUARANTINE_SEQUENCE_FORK


def audit_statement(kind, *, keypair=K3, status=AuditStatementStatus.SUPPORT, sequence=1, family="audit-a", path="audit-path-a", shadow=None, scope=SCOPE, request=REQUEST):
    shadow = shadow or accepted_shadow()
    return make_audit_statement(
        keypair=keypair,
        kind=kind,
        status=status,
        profile_id=PROFILE,
        service_name=SERVICE,
        subject_key_digest=SUBJECT,
        scope_digest=scope,
        request_digest=request,
        bridge_shadow_digest=shadow.report_digest,
        evidence_digest=d(f"audit-{kind.value}-{sequence}-{status.value}"),
        sequence=sequence,
        issued_at=NOW,
        expires_at=NOW + 100,
        family_id=family,
        path_family=path,
    )


def test_audit_quorum_accepts_diverse_local_evidence_not_truth() -> None:
    shadow = accepted_shadow()
    statements = (
        audit_statement(AuditStatementKind.SHADOW_ACCEPTED, keypair=K3, sequence=1, family="audit-a", path="path-a", shadow=shadow),
        audit_statement(AuditStatementKind.PUBLICATION_BOUNDARY, keypair=K4, sequence=2, family="audit-b", path="path-b", shadow=shadow),
        audit_statement(AuditStatementKind.QUIESCENCE_SCAN, keypair=K5, sequence=3, family="audit-c", path="path-c", shadow=shadow),
    )
    audit = assess_audit_quorum(statements, bridge_shadow=shadow, now=NOW + 1, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST)
    assert audit.decision_kind is AuditQuorumDecisionKind.ACCEPT_AUDIT
    assert audit.accept
    assert audit.kind_count == 3


def test_audit_quorum_catches_missing_low_diversity_replay_and_refute() -> None:
    shadow = accepted_shadow()
    missing = (
        audit_statement(AuditStatementKind.SHADOW_ACCEPTED, keypair=K3, sequence=1, family="audit-a", path="path-a", shadow=shadow),
        audit_statement(AuditStatementKind.PUBLICATION_BOUNDARY, keypair=K4, sequence=2, family="audit-b", path="path-b", shadow=shadow),
    )
    assert assess_audit_quorum(missing, bridge_shadow=shadow, now=NOW + 1, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST).decision_kind is AuditQuorumDecisionKind.HOLD_MISSING_REQUIRED_KIND

    one_family = (
        audit_statement(AuditStatementKind.SHADOW_ACCEPTED, keypair=K3, sequence=1, family="same", path="path-a", shadow=shadow),
        audit_statement(AuditStatementKind.PUBLICATION_BOUNDARY, keypair=K4, sequence=2, family="same", path="path-b", shadow=shadow),
        audit_statement(AuditStatementKind.QUIESCENCE_SCAN, keypair=K5, sequence=3, family="same", path="path-c", shadow=shadow),
    )
    assert assess_audit_quorum(one_family, bridge_shadow=shadow, now=NOW + 1, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST).decision_kind is AuditQuorumDecisionKind.HOLD_LOW_FAMILY_DIVERSITY

    refute = (
        audit_statement(AuditStatementKind.SHADOW_ACCEPTED, keypair=K3, sequence=1, family="audit-a", path="path-a", shadow=shadow),
        audit_statement(AuditStatementKind.CONTRADICTION, keypair=K4, status=AuditStatementStatus.REFUTE, sequence=2, family="audit-b", path="path-b", shadow=shadow),
        audit_statement(AuditStatementKind.QUIESCENCE_SCAN, keypair=K5, sequence=3, family="audit-c", path="path-c", shadow=shadow),
    )
    assert assess_audit_quorum(refute, bridge_shadow=shadow, now=NOW + 1, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST).decision_kind is AuditQuorumDecisionKind.QUARANTINE_REFUTED

    replayed = missing[0]
    assert assess_audit_quorum((replayed,), bridge_shadow=shadow, now=NOW + 1, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST, previously_seen_statement_digests=(replayed.statement_digest,)).decision_kind is AuditQuorumDecisionKind.QUARANTINE_REPLAY


def gc_item(kind, *, keypair=K1, sequence=1, weight=100, family="gc-a", path="path-a", expires=NOW + 100, hard=False, scope=SCOPE, request=REQUEST, digest=None):
    return make_redress_gc_item(
        keypair=keypair,
        kind=kind,
        profile_id=PROFILE,
        service_name=SERVICE,
        subject_key_digest=SUBJECT,
        scope_digest=scope,
        request_digest=request,
        evidence_digest=digest or d(f"gc-{kind.value}-{sequence}-{hard}"),
        sequence=sequence,
        issued_at=NOW,
        expires_at=expires,
        byte_weight=weight,
        hard_negative=hard,
        family_id=family,
        path_family=path,
    )


def test_redress_gc_drops_expired_soft_but_keeps_hard_negative() -> None:
    hard = gc_item(RedressGcItemKind.HARD_NEGATIVE, keypair=K1, sequence=1, weight=200, family="gc-hard", path="path-hard", hard=True)
    live = gc_item(RedressGcItemKind.REDRESS_RECEIPT, keypair=K2, sequence=2, weight=150, family="gc-live", path="path-live")
    expired = gc_item(RedressGcItemKind.APPEAL_OBSERVATION, keypair=K3, sequence=3, weight=150, family="gc-expired", path="path-expired", expires=NOW - 1)
    result = assess_redress_gc((hard, live, expired), now=NOW + 1, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST, retained_byte_budget=500)
    assert result.decision_kind is RedressGcDecisionKind.ACCEPT_WITH_WATCH
    assert hard.item_digest in result.kept_item_digests
    assert expired.item_digest in result.dropped_item_digests
    assert result.hard_negative_count == 1


def test_redress_gc_catches_sequence_fork_budget_and_live_watch_debt() -> None:
    fork_a = gc_item(RedressGcItemKind.REDRESS_RECEIPT, keypair=K1, sequence=9, family="gc-a", path="path-a", digest=d("fork-a"))
    fork_b = gc_item(RedressGcItemKind.REDRESS_RECEIPT, keypair=K2, sequence=9, family="gc-b", path="path-b", digest=d("fork-b"))
    assert assess_redress_gc((fork_a, fork_b), now=NOW + 1, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST, retained_byte_budget=500).decision_kind is RedressGcDecisionKind.QUARANTINE_SEQUENCE_FORK

    huge_hard = gc_item(RedressGcItemKind.HARD_NEGATIVE, keypair=K1, sequence=1, weight=1000, family="gc-hard", path="path-hard", hard=True)
    assert assess_redress_gc((huge_hard,), now=NOW + 1, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST, retained_byte_budget=100).decision_kind is RedressGcDecisionKind.QUARANTINE_HARD_NEGATIVE_DROPPED

    watch = gc_item(RedressGcItemKind.WATCH_DEBT, keypair=K1, sequence=1, family="gc-watch-a", path="path-a")
    other = gc_item(RedressGcItemKind.REDRESS_RECEIPT, keypair=K2, sequence=2, family="gc-watch-b", path="path-b")
    held = assess_redress_gc((watch, other), now=NOW + 1, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST, retained_byte_budget=500)
    assert held.decision_kind is RedressGcDecisionKind.HOLD_LIVE_WATCH_DEBT
    allowed = assess_redress_gc((watch, other), now=NOW + 1, expected_profile_id=PROFILE, expected_service_name=SERVICE, expected_subject_key_digest=SUBJECT, expected_scope_digest=SCOPE, expected_request_digest=REQUEST, retained_byte_budget=500, allow_live_watch_debt=True)
    assert allowed.decision_kind is RedressGcDecisionKind.ACCEPT_WITH_WATCH


def test_bridge_governance_fold_current_path_visible() -> None:
    report = audit_bridge_governance_fold(Path(__file__).resolve().parents[1], revision="rev0048", artifact_stem="Nicotine-i2pDHT-rev0048-2026.06.06.02.45-bridgeshadow-auditquorum-redressgc")
    assert report.status == "pass"
    assert report.error_count == 0
