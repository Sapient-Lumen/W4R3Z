+                queued_event_name = self._main_thread_lifecycle_event_retries[index][0]
+
+                if queued_event_name not in self.PRIORITY_MAIN_THREAD_LIFECYCLE_EVENTS:
+                    evict_index = index
+                    break
+
+            if evict_index is None:
+                return False
+
+            dropped_event_names.append(self._drop_main_thread_lifecycle_event_retry_at(evict_index))
+
+        if dropped_event_names:
+            log.add_conn(
+                "Dropped %s nonpriority main-thread lifecycle event retries to preserve priority event %s",
+                (len(dropped_event_names), dropped_event_names[0])
+            )
+
+        return True
