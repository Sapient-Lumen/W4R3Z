+++ b/pynicotine/tests/unit/protocol/test_slskproto.py
@@ -2375,6 +2375,45 @@ class NetworkThreadUnitTest(TestCase):
             "message-user"
         ], [event_name for event_name, _args, _kwargs in network_thread._main_thread_lifecycle_event_retries])
 
+    def test_priority_lifecycle_retry_evicts_nonpriority_when_shelf_is_full(self):
+        """Cleanup events should displace preserved payloads rather than being dropped."""
+
+        network_thread = self._create_network_thread()
+        message = MessageUser()
+        message.message = "hello"
+
+        with patch.object(slskproto_module.NetworkThread, "MAX_MAIN_THREAD_LIFECYCLE_EVENT_RETRIES", 1):
+            self.assertTrue(network_thread._queue_main_thread_lifecycle_event_retry(
+                "message-user", (message,), {}))
+            self.assertTrue(network_thread._queue_main_thread_lifecycle_event_retry(
+                "file-connection-closed", (), {
+                    "username": "peer", "token": 1, "sock": None, "timed_out": False
+                }))
+
+        self.assertEqual(1, len(network_thread._main_thread_lifecycle_event_retries))
+        event_name, _args, kwargs = network_thread._main_thread_lifecycle_event_retries[0]
+        self.assertEqual("file-connection-closed", event_name)
+        self.assertEqual("peer", kwargs["username"])
+        self.assertGreater(network_thread._main_thread_lifecycle_event_retry_bytes, 0)
+
+    def test_priority_lifecycle_retry_does_not_evict_existing_priority_events(self):
+        """Priority cleanup ordering should be preserved when the shelf contains only priority events."""
+
+        network_thread = self._create_network_thread()
+
+        with patch.object(slskproto_module.NetworkThread, "MAX_MAIN_THREAD_LIFECYCLE_EVENT_RETRIES", 1):
+            self.assertTrue(network_thread._queue_main_thread_lifecycle_event_retry(
+                "peer-message-unsent", (QueueUpload("a.mp3"),), {}))
+            self.assertFalse(network_thread._queue_main_thread_lifecycle_event_retry(
+                "file-connection-closed", (), {
+                    "username": "peer", "token": 1, "sock": None, "timed_out": False
+                }))
+
+        self.assertEqual(1, len(network_thread._main_thread_lifecycle_event_retries))
+        event_name, args, _kwargs = network_thread._main_thread_lifecycle_event_retries[0]
+        self.assertEqual("peer-message-unsent", event_name)
+        self.assertEqual("a.mp3", args[0].file)
+
