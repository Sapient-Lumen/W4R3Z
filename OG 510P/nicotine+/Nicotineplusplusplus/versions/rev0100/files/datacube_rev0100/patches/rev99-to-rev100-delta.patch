+    def _make_room_for_priority_main_thread_lifecycle_event_retry(self, event_size):
+        """Evict ordinary preserved payloads before dropping cleanup/rollback events.
+
+        The lifecycle retry shelf intentionally preserves some accepted request
+        intent and bounded parsed payloads, but tiny rollback/close notifications
+        are the events that release active transfer, peer-init and grant state.
+        If the shelf is full of ordinary preserved payloads, a priority cleanup
+        event must be able to displace them instead of being dropped. Preserve
+        priority-event ordering by evicting only nonpriority entries, starting
+        with the newest/lowest-value ordinary retry.
