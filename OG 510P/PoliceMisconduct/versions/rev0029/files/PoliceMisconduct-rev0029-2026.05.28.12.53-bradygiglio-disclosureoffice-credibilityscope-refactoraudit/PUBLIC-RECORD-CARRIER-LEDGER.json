{
  "project": "PoliceMisconduct",
  "revision": "rev0003",
  "schema_version": "0.1",
  "carrier_publicness_levels": [
    "lead-public",
    "paper-public",
    "metadata-public",
    "document-public",
    "version-pinned-public",
    "replayable-public",
    "restricted-public",
    "sealed-or-unavailable"
  ],
  "carrier_rows": [
    {
      "carrier_id": "PRC-FEDERAL-COURT-DOCKET",
      "name": "Federal court docket / PACER / RECAP",
      "default_publicness": "metadata-public",
      "risks": [
        "sealed filings",
        "partial docket text",
        "party naming harms"
      ],
      "minimum_custody": [
        "court",
        "case_number",
        "document_number_if_available",
        "filing_date",
        "access_date",
        "source_url_or_archive_id"
      ]
    },
    {
      "carrier_id": "PRC-STATE-COURT-DOCKET",
      "name": "State/local court docket",
      "default_publicness": "metadata-public",
      "risks": [
        "heterogeneous portals",
        "paper-only records",
        "expungement/sealing"
      ],
      "minimum_custody": [
        "court",
        "case_number_or_local_locator",
        "access_date",
        "jurisdiction"
      ]
    },
    {
      "carrier_id": "PRC-FOIA-RELEASE",
      "name": "FOIA/public-records release",
      "default_publicness": "document-public",
      "risks": [
        "redaction variance",
        "requester-specific release",
        "agency withholding",
        "retaliation risk"
      ],
      "minimum_custody": [
        "request_id_if_any",
        "agency",
        "release_date",
        "request_text_if_available",
        "pages_or_files",
        "redaction_notes"
      ]
    },
    {
      "carrier_id": "PRC-INTERNAL-AFFAIRS-DISCIPLINE",
      "name": "Internal affairs or discipline record",
      "default_publicness": "restricted-public",
      "risks": [
        "sealed records",
        "appeal changes",
        "union-contract destruction",
        "privacy of complainants"
      ],
      "minimum_custody": [
        "agency",
        "case_or_control_number_if_any",
        "finding_terms",
        "appeal_status",
        "source_law"
      ]
    },
    {
      "carrier_id": "PRC-POST-DECERTIFICATION",
      "name": "POST/decertification list or order",
      "default_publicness": "document-public",
      "risks": [
        "state-by-state terminology",
        "reinstatement",
        "name collision"
      ],
      "minimum_custody": [
        "state",
        "POST_body",
        "certificate_id_if_available",
        "order_date",
        "status"
      ]
    },
    {
      "carrier_id": "PRC-SETTLEMENT-LEDGER",
      "name": "Municipal/county settlement ledger or council approval",
      "default_publicness": "document-public",
      "risks": [
        "no admission clauses",
        "aggregated payments",
        "insurance routing"
      ],
      "minimum_custody": [
        "paying_entity",
        "amount",
        "approval_date",
        "case_or_claim_number_if_any",
        "settlement_terms_locator"
      ]
    },
    {
      "carrier_id": "PRC-NEWS-REPORT",
      "name": "News report",
      "default_publicness": "lead-public",
      "risks": [
        "dead links",
        "paywalls",
        "corrections",
        "single-source claims",
        "misspellings"
      ],
      "minimum_custody": [
        "publication",
        "author_if_available",
        "published_date",
        "url_or_archive",
        "access_date"
      ]
    },
    {
      "carrier_id": "PRC-VIDEO-AUDIO",
      "name": "Bodycam/dashcam/911/audio/video",
      "default_publicness": "restricted-public",
      "risks": [
        "privacy of civilians",
        "selective release",
        "graphic content",
        "context loss"
      ],
      "minimum_custody": [
        "releasing_entity",
        "recording_type",
        "release_date",
        "duration_or_segments",
        "redactions_or_edits"
      ]
    },
    {
      "carrier_id": "PRC-MEDICAL-EXAMINER-CORONER",
      "name": "Medical examiner / coroner report",
      "default_publicness": "restricted-public",
      "risks": [
        "family privacy",
        "medical data",
        "official narrative dependence"
      ],
      "minimum_custody": [
        "office",
        "case_number_if_available",
        "date",
        "cause_manner_terms",
        "privacy_review"
      ]
    },
    {
      "carrier_id": "PRC-POLICY-UNION-CONTRACT",
      "name": "Department policy or union contract",
      "default_publicness": "document-public",
      "risks": [
        "version drift",
        "effective date ambiguity",
        "MOU side letters"
      ],
      "minimum_custody": [
        "agency_or_union",
        "effective_dates",
        "version_or_revision_date",
        "source_url_or_archive"
      ]
    },
    {
      "carrier_id": "PRC-DOJ-SLS-CASE-MATTER-INDEX",
      "name": "DOJ Civil Rights Division Special Litigation Section case/matter index",
      "default_publicness": "document-public",
      "risks": [
        "status drift",
        "linked document movement",
        "political posture change",
        "source-page label overreading"
      ],
      "minimum_custody": [
        "source_url",
        "source_owner",
        "accessed_at",
        "source_page_updated_label",
        "row_label",
        "status_label",
        "linked_document_labels"
      ]
    },
    {
      "carrier_id": "PRC-DOJ-SLS-NEWS",
      "name": "DOJ Special Litigation Section news/status stream",
      "default_publicness": "lead-public",
      "risks": [
        "press release is not court order",
        "posture language",
        "political framing",
        "archive movement"
      ],
      "minimum_custody": [
        "news_url",
        "published_date",
        "issuing_component",
        "status_signal",
        "verification_needed"
      ]
    },
    {
      "carrier_id": "PRC-BJS-CSLLEA",
      "name": "BJS Census of State and Local Law Enforcement Agencies",
      "default_publicness": "replayable-public",
      "risks": [
        "collection-year staleness",
        "agency inclusion/exclusion rules",
        "not misconduct data"
      ],
      "minimum_custody": [
        "publication_or_dataset_url",
        "collection_year",
        "release_date",
        "inclusion_rules",
        "freshness_warning"
      ]
    },
    {
      "carrier_id": "PRC-FBI-UOF",
      "name": "FBI National Use-of-Force Data Collection",
      "default_publicness": "metadata-public",
      "risks": [
        "voluntary participation",
        "aggregate not incident-specific",
        "does not assess legality",
        "release threshold rules"
      ],
      "minimum_custody": [
        "source_url",
        "release_or_cde_locator",
        "participation_caveat",
        "collection_scope"
      ]
    },
    {
      "carrier_id": "PRC-IADLEST-NDI",
      "name": "IADLEST National Decertification Index",
      "default_publicness": "restricted-public",
      "risks": [
        "not all states may report comprehensively",
        "restricted access",
        "revocation action not full misconduct history",
        "reinstatement/status changes"
      ],
      "minimum_custody": [
        "portal_or_description_url",
        "reported_by_state_agency",
        "access_model",
        "status_caveat"
      ]
    }
  ]
}
