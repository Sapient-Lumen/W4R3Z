{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/policemisconduct/schemas/source_row.schema.json",
  "title": "PoliceMisconduct source row",
  "type": "object",
  "required": [
    "row_id",
    "record_kind",
    "source_url",
    "source_owner",
    "source_accessed_at_utc",
    "matter_label",
    "agency_names",
    "display_class",
    "person_level_claims_admitted",
    "incident_level_claims_admitted"
  ],
  "properties": {
    "row_id": {
      "type": "string"
    },
    "record_kind": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_owner": {
      "type": "string"
    },
    "source_page_updated_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_accessed_at_utc": {
      "type": "string"
    },
    "state_or_territory": {
      "type": "string"
    },
    "matter_label": {
      "type": "string"
    },
    "agency_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "doj_page_status_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_classes_present_from_page_label": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "display_class": {
      "type": "string"
    },
    "person_level_claims_admitted": {
      "const": false
    },
    "incident_level_claims_admitted": {
      "const": false
    },
    "status_interpretation_rule": {
      "type": "string"
    },
    "privacy_review": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
