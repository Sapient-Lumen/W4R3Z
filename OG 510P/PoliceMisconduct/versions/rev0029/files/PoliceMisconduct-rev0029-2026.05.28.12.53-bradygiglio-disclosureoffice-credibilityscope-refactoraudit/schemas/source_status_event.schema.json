{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/policemisconduct/schemas/source_status_event.schema.json",
  "title": "PoliceMisconduct source status event",
  "type": "object",
  "required": [
    "status_event_id",
    "agency_or_matter",
    "event_source_type",
    "status_label",
    "source_url",
    "display_permission"
  ],
  "properties": {
    "status_event_id": {
      "type": "string"
    },
    "agency_or_matter": {
      "type": "string"
    },
    "event_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_source_type": {
      "enum": [
        "source_page_label",
        "press_release_signal",
        "court_order",
        "monitor_report",
        "local_agency_page",
        "news_report",
        "other"
      ]
    },
    "status_label": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "confidence": {
      "type": "string"
    },
    "display_permission": {
      "enum": [
        "source-scoped-only",
        "current-status-candidate",
        "verified-current-status",
        "blocked"
      ]
    },
    "rollback_trigger": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
