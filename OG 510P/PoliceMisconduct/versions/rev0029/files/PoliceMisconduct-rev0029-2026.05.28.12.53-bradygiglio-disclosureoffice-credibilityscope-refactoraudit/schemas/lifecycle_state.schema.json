{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle state definition",
  "type": "object",
  "required": [
    "state_id",
    "record_kind",
    "family",
    "definition"
  ],
  "properties": {
    "record_kind": {
      "const": "lifecycle_state_definition"
    },
    "state_id": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "definition": {
      "type": "string"
    },
    "can_support_private_claim_after_review": {
      "type": "boolean"
    },
    "can_support_public_display_after_review": {
      "type": "boolean"
    }
  }
}
