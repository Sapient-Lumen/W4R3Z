{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "title": "SourceVoiceFrame",
  "type": "object",
  "required": [
    "voice_frame_id",
    "record_kind",
    "frame",
    "template",
    "output_scope"
  ],
  "properties": {
    "voice_frame_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "source_voice_frame"
    },
    "frame": {
      "type": "string"
    },
    "template": {
      "type": "string"
    },
    "output_scope": {
      "type": "string"
    }
  }
}
