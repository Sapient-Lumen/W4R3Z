{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit file record",
  "type": "object",
  "required": [
    "path",
    "bytes",
    "sha256",
    "primary_module",
    "text_readable_utf8"
  ],
  "properties": {
    "path": {
      "type": "string"
    },
    "bytes": {
      "type": "integer"
    },
    "sha256": {
      "type": "string"
    },
    "primary_module": {
      "type": "string"
    },
    "text_readable_utf8": {
      "type": "boolean"
    },
    "line_count": {
      "type": [
        "integer",
        "null"
      ]
    }
  }
}
