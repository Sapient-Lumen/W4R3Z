{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open route candidate",
  "type": "object",
  "required": [
    "route_id",
    "name",
    "mode",
    "why",
    "first_outputs",
    "risk"
  ],
  "properties": {
    "route_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "why": {
      "type": "string"
    },
    "first_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  }
}
