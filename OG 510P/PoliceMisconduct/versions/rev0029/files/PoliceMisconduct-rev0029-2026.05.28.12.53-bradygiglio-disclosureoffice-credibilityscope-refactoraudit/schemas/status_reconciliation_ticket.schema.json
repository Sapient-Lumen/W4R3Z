{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Status reconciliation ticket nonclaim",
  "type": "object",
  "required": [
    "ticket_id",
    "record_kind",
    "conflict_class",
    "current_legal_status_asserted_by_cube",
    "claim_extraction_allowed",
    "public_display_rule"
  ],
  "properties": {
    "ticket_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "status_reconciliation_ticket_nonclaim"
    },
    "severity": {
      "type": "string"
    },
    "matter_id": {},
    "source_row_id": {},
    "conflict_class": {
      "type": "string"
    },
    "docket_recheck_required": {
      "type": "boolean"
    },
    "current_legal_status_asserted_by_cube": {
      "const": false
    },
    "claim_extraction_allowed": {
      "const": false
    },
    "public_display_rule": {
      "type": "string"
    }
  }
}
