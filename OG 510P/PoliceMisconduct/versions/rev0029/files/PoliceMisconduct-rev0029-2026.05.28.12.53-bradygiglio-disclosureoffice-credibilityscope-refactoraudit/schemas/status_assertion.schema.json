{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PoliceMisconduct source-scoped status assertion/event",
  "type": "object",
  "required": [
    "status_event_id",
    "matter_id",
    "event_kind",
    "observed_at_utc",
    "current_legal_status_asserted",
    "requires_current_docket_recheck",
    "display_rule"
  ],
  "properties": {
    "status_event_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "source_row_id": {
      "type": "string"
    },
    "event_kind": {
      "type": "string"
    },
    "status_label_observed": {
      "type": "string"
    },
    "source_scope": {
      "type": "string"
    },
    "observed_at_utc": {
      "type": "string"
    },
    "current_legal_status_asserted": {
      "type": "boolean"
    },
    "requires_current_docket_recheck": {
      "type": "boolean"
    },
    "display_rule": {
      "type": "string"
    }
  }
}
