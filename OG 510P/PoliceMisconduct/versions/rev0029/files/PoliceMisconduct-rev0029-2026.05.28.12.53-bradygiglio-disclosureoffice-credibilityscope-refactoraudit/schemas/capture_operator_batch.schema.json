{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "Capture operator batch",
  "required": [
    "batch_id",
    "record_kind",
    "capture_manifest_ids",
    "payloads_captured",
    "payload_hashes_computed"
  ],
  "properties": {
    "batch_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "capture_operator_batch_nonclaim"
    },
    "capture_manifest_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
