{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Capture Manifest Target",
  "type": "object",
  "required": [
    "capture_manifest_id",
    "record_kind",
    "source_url",
    "capture_state_rev0012",
    "payload_captured",
    "payload_hash_computed"
  ],
  "properties": {
    "capture_manifest_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "source_capture_manifest_target_nonclaim"
    },
    "source_url": {
      "type": "string"
    },
    "capture_state_rev0012": {
      "type": "string"
    },
    "payload_captured": {
      "const": false
    },
    "payload_hash_computed": {
      "const": false
    },
    "claim_extraction_allowed": {
      "const": false
    }
  }
}
