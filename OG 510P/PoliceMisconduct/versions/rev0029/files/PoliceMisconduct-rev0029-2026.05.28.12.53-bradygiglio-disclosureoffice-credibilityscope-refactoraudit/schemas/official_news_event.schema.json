{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Official DOJ news event nonclaim",
  "type": "object",
  "required": [
    "event_id",
    "record_kind",
    "source_url",
    "headline",
    "publication_date",
    "event_signal_type",
    "current_legal_status_asserted_by_cube",
    "person_extraction_allowed",
    "incident_extraction_allowed"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "official_news_event_nonclaim"
    },
    "source_url": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "publication_date": {
      "type": "string"
    },
    "event_signal_type": {
      "type": "string"
    },
    "matched_matter_ids": {
      "type": "array"
    },
    "current_legal_status_asserted_by_cube": {
      "const": false
    },
    "person_extraction_allowed": {
      "const": false
    },
    "incident_extraction_allowed": {
      "const": false
    },
    "claim_extraction_allowed": {
      "const": false
    }
  }
}
