{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Preservation Policy Row",
  "type": "object",
  "required": [
    "policy_id",
    "record_kind",
    "carrier_family",
    "preservation_rule",
    "claim_extraction_allowed_by_policy_row"
  ],
  "properties": {
    "policy_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "source_preservation_policy_row"
    },
    "carrier_family": {
      "type": "string"
    },
    "preservation_rule": {
      "type": "string"
    },
    "claim_extraction_allowed_by_policy_row": {
      "const": false
    }
  }
}
