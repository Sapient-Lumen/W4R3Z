{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SettlementRecordDraft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string"
    },
    "record_kind": {
      "type": "string"
    },
    "revision_created": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_state": {
      "type": "string",
      "enum": [
        "Q",
        "S0",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5"
      ]
    },
    "notes": {
      "type": "string"
    },
    "settlement_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "amount": {
      "type": [
        "number",
        "null"
      ]
    },
    "currency": {
      "type": "string"
    },
    "paying_entity": {
      "type": [
        "string",
        "null"
      ]
    },
    "case_or_claim_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "no_admission_clause": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_officer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_department_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "record_id",
    "record_kind",
    "source_ids",
    "evidence_state",
    "currency"
  ]
}
