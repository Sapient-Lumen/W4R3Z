{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PoliceMisconduct matter object",
  "type": "object",
  "required": [
    "matter_id",
    "source_row_id",
    "record_kind",
    "matter_label",
    "agency_names",
    "source_page_status_label",
    "current_status_assertion_state",
    "claim_extraction_allowed",
    "person_extraction_allowed"
  ],
  "properties": {
    "matter_id": {
      "type": "string"
    },
    "source_row_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "matter_object_not_claim_object"
    },
    "matter_label": {
      "type": "string"
    },
    "state_or_territory": {
      "type": "string"
    },
    "agency_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "object_kind": {
      "type": "string"
    },
    "source_page_status_label": {
      "type": "string"
    },
    "current_status_assertion_state": {
      "type": "string"
    },
    "document_label_count_from_source_page": {
      "type": "integer",
      "minimum": 0
    },
    "document_classes_from_source_page": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_extraction_allowed": {
      "type": "boolean"
    },
    "person_extraction_allowed": {
      "type": "boolean"
    },
    "incident_extraction_allowed": {
      "type": "boolean"
    },
    "display_warning": {
      "type": "string"
    }
  }
}
