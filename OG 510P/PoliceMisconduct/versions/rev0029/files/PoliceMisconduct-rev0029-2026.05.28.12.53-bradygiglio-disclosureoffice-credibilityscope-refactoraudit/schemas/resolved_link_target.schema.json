{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resolved Link Target Nonclaim",
  "type": "object",
  "required": [
    "resolution_id",
    "record_kind",
    "resolved_url",
    "payload_captured",
    "payload_hash_computed",
    "content_summary_admitted",
    "current_legal_status_claim_admitted"
  ],
  "properties": {
    "resolution_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "resolved_link_target_nonclaim"
    },
    "source_document_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_url": {
      "type": "string"
    },
    "resolution_state": {
      "type": "string"
    },
    "payload_captured": {
      "const": false
    },
    "payload_hash_computed": {
      "const": false
    },
    "content_summary_admitted": {
      "const": false
    },
    "current_legal_status_claim_admitted": {
      "const": false
    }
  }
}
