{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PoliceMisconduct source document census entry",
  "type": "object",
  "required": [
    "source_document_id",
    "matter_id",
    "document_label_from_source_page",
    "document_class_normalized",
    "url_capture_state",
    "claim_extraction_allowed",
    "person_extraction_allowed",
    "privacy_scan_required_before_summary",
    "nonclaim"
  ],
  "properties": {
    "source_document_id": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "source_row_id": {
      "type": "string"
    },
    "document_label_from_source_page": {
      "type": "string"
    },
    "document_year_from_source_page": {
      "type": [
        "integer",
        "null"
      ]
    },
    "document_class_normalized": {
      "type": "string"
    },
    "source_page_link_id_observed_in_browser": {
      "type": [
        "integer",
        "null"
      ]
    },
    "official_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "url_capture_state": {
      "type": "string"
    },
    "content_hash_state": {
      "type": "string"
    },
    "content_summary_state": {
      "type": "string"
    },
    "claim_extraction_allowed": {
      "type": "boolean"
    },
    "person_extraction_allowed": {
      "type": "boolean"
    },
    "incident_extraction_allowed": {
      "type": "boolean"
    },
    "privacy_scan_required_before_summary": {
      "type": "boolean"
    },
    "public_display_state": {
      "type": "string"
    },
    "nonclaim": {
      "type": "string"
    }
  }
}
