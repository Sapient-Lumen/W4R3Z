{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source observation event",
  "type": "object",
  "required": [
    "source_observation_event_id",
    "record_kind",
    "observed_entity_kind",
    "observed_entity_label",
    "payload_captured",
    "payload_hash_computed",
    "current_status_claim_admitted"
  ],
  "properties": {
    "record_kind": {
      "const": "source_observation_event_nonclaim"
    },
    "payload_captured": {
      "const": false
    },
    "payload_hash_computed": {
      "const": false
    },
    "current_status_claim_admitted": {
      "const": false
    }
  }
}
