{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accession Gap",
  "type": "object",
  "required": [
    "gap_id",
    "record_kind",
    "gap_type",
    "gap_statement",
    "next_action",
    "current_status_claim_admitted"
  ],
  "properties": {
    "gap_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "accession_gap_nonclaim"
    },
    "gap_type": {
      "type": "string"
    },
    "gap_statement": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "current_status_claim_admitted": {
      "type": "boolean"
    }
  }
}
