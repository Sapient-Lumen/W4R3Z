{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Mutation Watch",
  "type": "object",
  "required": [
    "mutation_watch_id",
    "record_kind",
    "source_document_id",
    "watch_reasons",
    "public_current_status_claim_admitted",
    "claim_extraction_allowed"
  ],
  "properties": {
    "mutation_watch_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "document_mutation_watch_nonclaim"
    },
    "source_document_id": {
      "type": "string"
    },
    "watch_reasons": {
      "type": "array"
    },
    "public_current_status_claim_admitted": {
      "const": false
    },
    "claim_extraction_allowed": {
      "const": false
    }
  }
}
