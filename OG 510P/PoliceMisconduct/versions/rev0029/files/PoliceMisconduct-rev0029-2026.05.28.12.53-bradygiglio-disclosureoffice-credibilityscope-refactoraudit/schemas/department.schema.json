{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DepartmentRecordDraft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string"
    },
    "record_kind": {
      "type": "string"
    },
    "revision_created": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_state": {
      "type": "string",
      "enum": [
        "Q",
        "S0",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5"
      ]
    },
    "notes": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "object"
    },
    "agency_type": {
      "type": "string"
    },
    "leadership_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "policy_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "union_contract_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "oversight_body_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "record_id",
    "record_kind",
    "name",
    "jurisdiction",
    "source_ids",
    "evidence_state"
  ]
}
