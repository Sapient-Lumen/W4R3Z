{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Link Target Resolution Ticket",
  "type": "object",
  "required": [
    "resolution_ticket_id",
    "record_kind",
    "source_document_id",
    "target_url_state",
    "claim_extraction_allowed",
    "person_extraction_allowed",
    "incident_extraction_allowed",
    "current_status_claim_admitted"
  ],
  "properties": {
    "resolution_ticket_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "link_target_resolution_ticket_nonclaim"
    },
    "source_document_id": {
      "type": "string"
    },
    "target_url_state": {
      "type": "string"
    },
    "claim_extraction_allowed": {
      "const": false
    },
    "person_extraction_allowed": {
      "const": false
    },
    "incident_extraction_allowed": {
      "const": false
    },
    "current_status_claim_admitted": {
      "const": false
    }
  }
}
