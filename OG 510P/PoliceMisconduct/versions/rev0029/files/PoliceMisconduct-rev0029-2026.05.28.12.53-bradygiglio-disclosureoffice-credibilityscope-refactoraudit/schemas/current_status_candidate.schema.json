{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/current_status_candidate.schema.json",
  "title": "Current status candidate nonclaim",
  "type": "object",
  "required": [
    "candidate_id",
    "record_kind",
    "candidate_status_value",
    "public_current_status_claim_admitted",
    "current_legal_status_asserted_by_cube"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "current_status_candidate_nonclaim"
    },
    "candidate_status_value": {
      "type": "string"
    },
    "supporting_signal_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicting_or_lagging_signal_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "why_not_admitted": {
      "type": "string"
    },
    "public_current_status_claim_admitted": {
      "const": false
    },
    "current_legal_status_asserted_by_cube": {
      "const": false
    },
    "person_extraction_allowed": {
      "const": false
    },
    "incident_extraction_allowed": {
      "const": false
    }
  }
}
