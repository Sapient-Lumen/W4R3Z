{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundation debt",
  "type": "object",
  "required": [
    "debt_id",
    "area",
    "severity",
    "debt",
    "paydown"
  ],
  "properties": {
    "debt_id": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "debt": {
      "type": "string"
    },
    "paydown": {
      "type": "string"
    }
  }
}
