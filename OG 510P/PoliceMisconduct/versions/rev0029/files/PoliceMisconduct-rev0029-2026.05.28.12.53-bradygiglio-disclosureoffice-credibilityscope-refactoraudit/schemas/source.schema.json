{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceRecordDraft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "type": "string"
    },
    "carrier_id": {
      "type": "string"
    },
    "title_or_description": {
      "type": "string"
    },
    "producer": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_or_filed_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "accessed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "url_or_locator": {
      "type": [
        "string",
        "null"
      ]
    },
    "archive_locator": {
      "type": [
        "string",
        "null"
      ]
    },
    "digest_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "custody_state": {
      "type": "string"
    },
    "privacy_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supports_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "does_not_support": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "source_id",
    "carrier_id",
    "title_or_description",
    "custody_state",
    "supports_fields"
  ]
}
