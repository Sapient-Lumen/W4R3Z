{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/policemisconduct/schemas/agency_source_inventory.schema.json",
  "title": "PoliceMisconduct agency source inventory",
  "type": "object",
  "required": [
    "agency_inventory_id",
    "agency_name",
    "jurisdiction_type",
    "source_rows",
    "warnings"
  ],
  "properties": {
    "agency_inventory_id": {
      "type": "string"
    },
    "agency_name": {
      "type": "string"
    },
    "jurisdiction_type": {
      "type": "string"
    },
    "state_or_territory": {
      "type": "string"
    },
    "source_rows": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "person_records_linked": {
      "const": 0
    },
    "incident_records_linked": {
      "const": 0
    }
  },
  "additionalProperties": true
}
