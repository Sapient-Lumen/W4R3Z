{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Line digest record",
  "type": "object",
  "required": [
    "path",
    "line_count",
    "line_hashes_sha256_16",
    "file_line_hash_chain_sha256"
  ],
  "properties": {
    "path": {
      "type": "string"
    },
    "line_count": {
      "type": "integer"
    },
    "line_hashes_sha256_16": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "file_line_hash_chain_sha256": {
      "type": "string"
    }
  }
}
