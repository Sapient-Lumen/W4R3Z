{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OfficerRecordDraft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string"
    },
    "record_kind": {
      "type": "string"
    },
    "revision_created": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_state": {
      "type": "string",
      "enum": [
        "Q",
        "S0",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5"
      ]
    },
    "notes": {
      "type": "string"
    },
    "canonical_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "name_variants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "post_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "employment_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "identity_confidence": {
      "type": "string",
      "enum": [
        "ER-0",
        "ER-1",
        "ER-2",
        "ER-3",
        "ER-X"
      ]
    },
    "identity_evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "privacy_class": {
      "type": "string"
    },
    "display_class": {
      "type": "string"
    },
    "correction_route": {
      "type": "string"
    },
    "unmerge_route": {
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "record_kind",
    "source_ids",
    "evidence_state",
    "identity_confidence",
    "privacy_class",
    "display_class",
    "correction_route"
  ]
}
