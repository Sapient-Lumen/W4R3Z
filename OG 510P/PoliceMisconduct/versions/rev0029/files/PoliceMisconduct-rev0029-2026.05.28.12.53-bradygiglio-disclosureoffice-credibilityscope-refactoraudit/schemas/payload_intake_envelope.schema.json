{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "Payload intake envelope",
  "required": [
    "payload_envelope_id",
    "record_kind",
    "capture_manifest_id",
    "payload_captured",
    "payload_hash_computed",
    "content_summary_admitted",
    "person_extraction_allowed",
    "incident_extraction_allowed"
  ],
  "properties": {
    "payload_envelope_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "payload_intake_envelope_nonclaim"
    },
    "capture_manifest_id": {
      "type": "string"
    }
  }
}
