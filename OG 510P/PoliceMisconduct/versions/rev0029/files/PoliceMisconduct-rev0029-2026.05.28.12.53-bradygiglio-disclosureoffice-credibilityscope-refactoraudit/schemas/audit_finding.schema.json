{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit finding",
  "type": "object",
  "required": [
    "finding_id",
    "severity",
    "title",
    "evidence",
    "action_in_rev0016",
    "next_action"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "green",
        "yellow",
        "red"
      ]
    },
    "title": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "action_in_rev0016": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    }
  }
}
