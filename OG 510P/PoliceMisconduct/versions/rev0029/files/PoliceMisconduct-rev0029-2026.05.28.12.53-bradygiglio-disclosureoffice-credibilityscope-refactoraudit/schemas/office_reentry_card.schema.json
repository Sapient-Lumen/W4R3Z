{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Office reentry card",
  "type": "object",
  "required": [
    "card_id",
    "read_order",
    "title",
    "read",
    "instruction"
  ],
  "properties": {
    "card_id": {
      "type": "string"
    },
    "read_order": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "read": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "instruction": {
      "type": "string"
    }
  }
}
