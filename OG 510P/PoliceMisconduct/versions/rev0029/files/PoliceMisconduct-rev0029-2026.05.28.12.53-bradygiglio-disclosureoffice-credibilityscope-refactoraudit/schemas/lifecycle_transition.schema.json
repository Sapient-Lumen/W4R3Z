{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle transition definition",
  "type": "object",
  "required": [
    "transition_id",
    "record_kind",
    "from_state",
    "to_state",
    "requires_explicit_receipt"
  ],
  "properties": {
    "record_kind": {
      "const": "lifecycle_transition_definition"
    },
    "transition_id": {
      "type": "string"
    },
    "from_state": {
      "type": "string"
    },
    "to_state": {
      "type": "string"
    },
    "requires_explicit_receipt": {
      "type": "boolean"
    }
  }
}
