{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/ghost_carrier_candidate.schema.json",
  "title": "Ghost source-carrier candidate",
  "type": "object",
  "required": [
    "ghost_candidate_id",
    "agency_label",
    "match_state",
    "public_status_claim_admitted"
  ],
  "properties": {
    "ghost_candidate_id": {
      "type": "string"
    },
    "agency_label": {
      "type": "string"
    },
    "match_state": {
      "type": "string"
    },
    "required_followup": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_status_claim_admitted": {
      "const": false
    },
    "person_extraction_allowed": {
      "const": false
    }
  }
}
