{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schema coverage audit row",
  "type": "object",
  "required": [
    "path",
    "schema_coverage_state",
    "note"
  ],
  "properties": {
    "path": {
      "type": "string"
    },
    "heuristic_schema_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_coverage_state": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  }
}
