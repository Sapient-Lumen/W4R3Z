{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transition gate matrix row",
  "type": "object",
  "required": [
    "gate_row_id",
    "record_kind",
    "transition_id",
    "required_gate_bundle"
  ],
  "properties": {
    "record_kind": {
      "const": "transition_gate_matrix_row"
    },
    "gate_row_id": {
      "type": "string"
    },
    "transition_id": {
      "type": "string"
    },
    "required_gate_bundle": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
