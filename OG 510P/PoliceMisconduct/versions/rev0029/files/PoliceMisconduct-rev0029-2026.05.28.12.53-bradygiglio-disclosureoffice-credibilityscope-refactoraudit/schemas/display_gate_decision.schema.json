{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/policemisconduct/schemas/display_gate_decision.schema.json",
  "title": "PoliceMisconduct display gate decision",
  "type": "object",
  "required": [
    "display_gate_id",
    "subject_id",
    "subject_kind",
    "decision",
    "allowed_content",
    "blocked_content",
    "reviewer_note"
  ],
  "properties": {
    "display_gate_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "subject_kind": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "allow-source-inventory",
        "allow-synthetic-only",
        "block",
        "quarantine"
      ]
    },
    "allowed_content": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_content": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewer_note": {
      "type": "string"
    },
    "person_extraction_allowed": {
      "const": false
    }
  },
  "additionalProperties": true
}
