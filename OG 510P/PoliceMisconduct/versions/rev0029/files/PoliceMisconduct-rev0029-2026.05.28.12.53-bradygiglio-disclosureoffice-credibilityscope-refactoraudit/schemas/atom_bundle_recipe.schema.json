{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "title": "AtomBundleRecipe",
  "type": "object",
  "required": [
    "recipe_id",
    "record_kind",
    "claim_template_id",
    "minimum_atoms"
  ],
  "properties": {
    "recipe_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "atom_bundle_recipe"
    },
    "minimum_atoms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
