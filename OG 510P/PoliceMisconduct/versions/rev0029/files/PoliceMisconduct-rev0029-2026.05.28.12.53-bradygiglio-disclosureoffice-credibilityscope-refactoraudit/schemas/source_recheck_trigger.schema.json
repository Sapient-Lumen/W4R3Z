{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Recheck Trigger",
  "type": "object",
  "required": [
    "trigger_id",
    "record_kind",
    "trigger_type",
    "required_action",
    "public_current_status_claim_admitted"
  ],
  "properties": {
    "trigger_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "source_recheck_trigger_nonclaim"
    },
    "trigger_type": {
      "type": "string"
    },
    "required_action": {
      "type": "string"
    },
    "public_current_status_claim_admitted": {
      "const": false
    }
  }
}
