{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IncidentRecordDraft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string"
    },
    "record_kind": {
      "type": "string"
    },
    "revision_created": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_state": {
      "type": "string",
      "enum": [
        "Q",
        "S0",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5"
      ]
    },
    "notes": {
      "type": "string"
    },
    "occurred_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "type": "object"
    },
    "department_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "officer_roles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "civilian_roles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "force_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "injuries_or_deaths": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "adjudication_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "privacy_review_state": {
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "record_kind",
    "source_ids",
    "evidence_state",
    "privacy_review_state"
  ]
}
