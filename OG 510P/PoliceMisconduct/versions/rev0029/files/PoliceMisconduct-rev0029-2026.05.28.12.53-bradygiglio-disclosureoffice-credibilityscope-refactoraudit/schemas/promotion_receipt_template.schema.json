{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Promotion receipt template",
  "type": "object",
  "required": [
    "template_id",
    "record_kind",
    "from_state",
    "to_state",
    "required_receipt_fields"
  ],
  "properties": {
    "record_kind": {
      "const": "promotion_receipt_template"
    },
    "template_id": {
      "type": "string"
    },
    "from_state": {
      "type": "string"
    },
    "to_state": {
      "type": "string"
    },
    "required_receipt_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
