{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixity State Definition",
  "type": "object",
  "required": [
    "fixity_state_id",
    "record_kind",
    "sequence",
    "definition",
    "public_current_status_claim_admitted_at_this_state"
  ],
  "properties": {
    "fixity_state_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "fixity_state_definition"
    },
    "sequence": {
      "type": "integer"
    },
    "definition": {
      "type": "string"
    },
    "claim_extraction_allowed_at_this_state": {
      "type": "boolean"
    },
    "public_current_status_claim_admitted_at_this_state": {
      "const": false
    }
  }
}
