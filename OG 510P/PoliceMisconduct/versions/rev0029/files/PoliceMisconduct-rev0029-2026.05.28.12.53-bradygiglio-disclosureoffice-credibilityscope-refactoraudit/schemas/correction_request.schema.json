{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CorrectionRequestDraft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "correction_id": {
      "type": "string"
    },
    "requester_role": {
      "type": "string"
    },
    "subject_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "received_at": {
      "type": "string"
    },
    "request_summary": {
      "type": "string"
    },
    "evidence_supplied": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "triage",
        "accepted",
        "partially_accepted",
        "rejected",
        "needs_more_information",
        "closed"
      ]
    },
    "disposition_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "rollback_ids_triggered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_note_required": {
      "type": "boolean"
    }
  },
  "required": [
    "correction_id",
    "requester_role",
    "subject_record_ids",
    "received_at",
    "request_summary",
    "status"
  ]
}
