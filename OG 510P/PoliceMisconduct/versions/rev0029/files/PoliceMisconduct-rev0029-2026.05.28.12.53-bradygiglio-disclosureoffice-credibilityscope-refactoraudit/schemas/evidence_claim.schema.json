{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceClaimDraft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "subject_record_id": {
      "type": "string"
    },
    "field_path": {
      "type": "string"
    },
    "claim_text": {
      "type": "string"
    },
    "evidence_state": {
      "type": "string",
      "enum": [
        "Q",
        "S0",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adjudication_term": {
      "type": [
        "string",
        "null"
      ]
    },
    "privacy_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_state": {
      "type": "string"
    },
    "rollback_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "claim_id",
    "subject_record_id",
    "field_path",
    "claim_text",
    "evidence_state",
    "source_ids",
    "review_state"
  ]
}
