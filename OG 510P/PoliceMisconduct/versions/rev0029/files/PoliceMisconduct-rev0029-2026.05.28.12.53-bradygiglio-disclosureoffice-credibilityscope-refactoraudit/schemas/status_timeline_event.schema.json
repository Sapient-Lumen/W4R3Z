{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Status Timeline Event",
  "type": "object",
  "required": [
    "timeline_event_id",
    "record_kind",
    "source_document_id",
    "event_family",
    "current_status_claim_admitted",
    "event_public_display_state"
  ],
  "properties": {
    "timeline_event_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "source_document_timeline_event_noncurrent"
    },
    "source_document_id": {
      "type": "string"
    },
    "event_family": {
      "type": "string"
    },
    "current_status_claim_admitted": {
      "type": "boolean"
    },
    "event_public_display_state": {
      "type": "string"
    }
  }
}
