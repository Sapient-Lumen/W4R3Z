{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order Proof Atom",
  "type": "object",
  "required": [
    "proof_atom_id",
    "record_kind",
    "source_document_id",
    "atom_scope",
    "document_effect_statement",
    "current_status_claim_admitted",
    "person_extraction_allowed",
    "incident_extraction_allowed",
    "rollback_trigger"
  ],
  "properties": {
    "proof_atom_id": {
      "type": "string"
    },
    "record_kind": {
      "enum": [
        "court_order_proof_atom_noncurrent",
        "motion_request_atom_noncurrent",
        "official_closing_letter_effect_atom_noncurrent"
      ]
    },
    "source_document_id": {
      "type": "string"
    },
    "atom_scope": {
      "type": "string"
    },
    "document_effect_statement": {
      "type": "string"
    },
    "current_status_claim_admitted": {
      "type": "boolean"
    },
    "public_current_status_claim_admitted": {
      "type": "boolean"
    },
    "person_extraction_allowed": {
      "type": "boolean"
    },
    "incident_extraction_allowed": {
      "type": "boolean"
    },
    "rollback_trigger": {
      "type": "string"
    }
  }
}
