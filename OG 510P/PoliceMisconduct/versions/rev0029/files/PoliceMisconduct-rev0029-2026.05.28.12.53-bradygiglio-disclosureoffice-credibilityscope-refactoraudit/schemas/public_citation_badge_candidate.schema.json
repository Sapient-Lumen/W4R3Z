{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Citation Badge Candidate",
  "type": "object",
  "required": [
    "badge_id",
    "record_kind",
    "badge_key",
    "display_state",
    "public_current_status_claim_admitted"
  ],
  "properties": {
    "badge_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "public_citation_badge_candidate_nonclaim"
    },
    "badge_key": {
      "type": "string"
    },
    "display_state": {
      "type": "string"
    },
    "public_current_status_claim_admitted": {
      "const": false
    }
  }
}
