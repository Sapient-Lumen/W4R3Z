{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Constraint audit row",
  "type": "object",
  "required": [
    "constraint_id",
    "class",
    "constraint",
    "interpretation"
  ],
  "properties": {
    "constraint_id": {
      "type": "string"
    },
    "class": {
      "enum": [
        "permanent",
        "phase_bound"
      ]
    },
    "constraint": {
      "type": "string"
    },
    "interpretation": {
      "type": "string"
    }
  }
}
