{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/local_monitor_source.schema.json",
  "title": "Local/monitor source bridge row",
  "type": "object",
  "required": [
    "local_source_id",
    "record_kind",
    "source_owner",
    "source_family",
    "claim_power",
    "public_status_admitted"
  ],
  "properties": {
    "local_source_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "local_monitor_source_nonclaim"
    },
    "source_owner": {
      "type": "string"
    },
    "source_family": {
      "type": "string"
    },
    "source_signal_summary": {
      "type": "string"
    },
    "claim_power": {
      "type": "string"
    },
    "public_status_admitted": {
      "const": false
    },
    "person_extraction_allowed": {
      "const": false
    },
    "incident_extraction_allowed": {
      "const": false
    }
  }
}
