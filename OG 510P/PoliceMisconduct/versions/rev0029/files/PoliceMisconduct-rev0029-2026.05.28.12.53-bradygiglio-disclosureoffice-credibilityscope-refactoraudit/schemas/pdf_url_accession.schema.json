{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDF URL Accession",
  "type": "object",
  "required": [
    "accession_id",
    "record_kind",
    "source_document_id",
    "official_url",
    "content_type_observed",
    "content_storage_state",
    "content_summary_state",
    "person_extraction_allowed",
    "incident_extraction_allowed",
    "current_status_claim_admitted"
  ],
  "properties": {
    "accession_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "pdf_url_accession_noncontent"
    },
    "source_document_id": {
      "type": "string"
    },
    "official_url": {
      "type": "string"
    },
    "content_type_observed": {
      "type": "string"
    },
    "content_storage_state": {
      "type": "string"
    },
    "content_summary_state": {
      "type": "string"
    },
    "person_extraction_allowed": {
      "type": "boolean"
    },
    "incident_extraction_allowed": {
      "type": "boolean"
    },
    "current_status_claim_admitted": {
      "type": "boolean"
    }
  }
}
