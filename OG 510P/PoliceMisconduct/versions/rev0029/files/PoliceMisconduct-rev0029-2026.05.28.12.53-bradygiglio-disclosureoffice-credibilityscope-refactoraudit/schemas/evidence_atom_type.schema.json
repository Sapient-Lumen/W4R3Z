{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "title": "EvidenceAtomType",
  "type": "object",
  "required": [
    "atom_type_id",
    "record_kind",
    "family",
    "atom_kind",
    "label",
    "minimum_lifecycle_state",
    "public_display_allowed_by_itself"
  ],
  "properties": {
    "atom_type_id": {
      "type": "string"
    },
    "record_kind": {
      "const": "evidence_atom_type_definition"
    },
    "family": {
      "type": "string"
    },
    "atom_kind": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "minimum_lifecycle_state": {
      "type": "string"
    },
    "public_display_allowed_by_itself": {
      "type": "boolean"
    }
  }
}
