{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/court_order_accession_candidate.schema.json",
  "title": "Court/order accession candidate",
  "type": "object",
  "required": [
    "order_candidate_id",
    "expected_artifact_type",
    "accession_state",
    "public_status_admitted"
  ],
  "properties": {
    "order_candidate_id": {
      "type": "string"
    },
    "expected_artifact_type": {
      "type": "string"
    },
    "locator_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accession_state": {
      "type": "string"
    },
    "public_status_admitted": {
      "const": false
    },
    "person_extraction_allowed": {
      "const": false
    },
    "incident_extraction_allowed": {
      "const": false
    }
  }
}
