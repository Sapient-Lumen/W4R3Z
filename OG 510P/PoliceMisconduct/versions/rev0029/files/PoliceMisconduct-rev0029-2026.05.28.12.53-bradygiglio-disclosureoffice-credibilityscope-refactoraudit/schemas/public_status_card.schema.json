{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/public_status_card.schema.json",
  "title": "Public status card copy candidate",
  "type": "object",
  "required": [
    "card_id",
    "title",
    "safe_public_copy",
    "public_current_status_claim_admitted"
  ],
  "properties": {
    "card_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "safe_public_copy": {
      "type": "string"
    },
    "must_show_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_current_status_claim_admitted": {
      "const": false
    },
    "person_or_incident_display_allowed": {
      "const": false
    }
  }
}
