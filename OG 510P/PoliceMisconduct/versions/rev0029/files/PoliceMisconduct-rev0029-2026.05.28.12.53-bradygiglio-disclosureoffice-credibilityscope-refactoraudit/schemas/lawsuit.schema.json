{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LawsuitRecordDraft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string"
    },
    "record_kind": {
      "type": "string"
    },
    "revision_created": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_state": {
      "type": "string",
      "enum": [
        "Q",
        "S0",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5"
      ]
    },
    "notes": {
      "type": "string"
    },
    "court": {
      "type": "string"
    },
    "case_number": {
      "type": "string"
    },
    "filing_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "plaintiff_display_policy": {
      "type": "string"
    },
    "defendant_officer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defendant_department_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disposition": {
      "type": [
        "string",
        "null"
      ]
    },
    "linked_incident_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "record_id",
    "record_kind",
    "court",
    "case_number",
    "source_ids",
    "evidence_state",
    "plaintiff_display_policy"
  ]
}
