{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Official source observation nonclaim",
  "type": "object",
  "required": [
    "observation_id",
    "record_kind",
    "source_name",
    "source_url",
    "admitted_use",
    "forbidden_use",
    "claim_admitted"
  ],
  "properties": {
    "record_kind": {
      "const": "official_source_observation_nonclaim"
    },
    "claim_admitted": {
      "const": false
    }
  }
}
