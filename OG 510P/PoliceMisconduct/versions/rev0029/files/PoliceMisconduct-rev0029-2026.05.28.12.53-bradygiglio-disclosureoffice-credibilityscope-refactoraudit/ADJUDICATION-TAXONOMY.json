{
  "project": "PoliceMisconduct",
  "revision": "rev0003",
  "schema_version": "0.1",
  "principle": "Outcome terms must preserve the decision-maker, standard, scope, and appeal status.",
  "outcome_terms": [
    {
      "term": "alleged",
      "meaning": "A claim was made; no finding is implied.",
      "requires": [
        "source",
        "claim_maker_or_document_type"
      ]
    },
    {
      "term": "pending",
      "meaning": "A process is open and unresolved.",
      "requires": [
        "forum_or_agency",
        "opened_date"
      ]
    },
    {
      "term": "sustained",
      "meaning": "An administrative body found misconduct under its policy/standard.",
      "requires": [
        "body",
        "finding_date",
        "policy_basis",
        "appeal_status"
      ]
    },
    {
      "term": "unsustained",
      "meaning": "Insufficient evidence under the body’s standard; not equivalent to exoneration.",
      "requires": [
        "body",
        "finding_date",
        "standard_if_available"
      ]
    },
    {
      "term": "exonerated",
      "meaning": "Body found conduct occurred but was lawful/policy-compliant under its standard.",
      "requires": [
        "body",
        "finding_date",
        "standard"
      ]
    },
    {
      "term": "unfounded",
      "meaning": "Body found the alleged event did not occur or complaint was false under its standard.",
      "requires": [
        "body",
        "finding_date"
      ]
    },
    {
      "term": "settled_no_admission",
      "meaning": "Civil matter resolved by settlement without admission unless terms say otherwise.",
      "requires": [
        "settlement_text_or_authoritative_summary"
      ]
    },
    {
      "term": "dismissed",
      "meaning": "Court dismissed case/claim; reason must be coded separately.",
      "requires": [
        "court",
        "order_date",
        "reason_if_available"
      ]
    },
    {
      "term": "summary_judgment_for_defendant",
      "meaning": "Court resolved claim before trial for defendant; does not necessarily adjudicate all facts.",
      "requires": [
        "court",
        "order_date",
        "claims"
      ]
    },
    {
      "term": "trial_verdict_for_plaintiff",
      "meaning": "Trial verdict on specified claims.",
      "requires": [
        "court",
        "verdict_date",
        "claims",
        "damages_if_any"
      ]
    },
    {
      "term": "convicted",
      "meaning": "Criminal conviction on specified charges.",
      "requires": [
        "court",
        "charge",
        "date",
        "appeal_status"
      ]
    },
    {
      "term": "acquitted",
      "meaning": "Criminal acquittal on specified charges; not a finding that no event occurred.",
      "requires": [
        "court",
        "charge",
        "date"
      ]
    },
    {
      "term": "decertified",
      "meaning": "Certification revoked/suspended/denied by POST or equivalent body.",
      "requires": [
        "body",
        "order_date",
        "status",
        "reinstatement_eligibility_if_available"
      ]
    },
    {
      "term": "reversed_or_vacated",
      "meaning": "Prior outcome changed by later process.",
      "requires": [
        "prior_outcome_id",
        "reversing_body",
        "date",
        "effect"
      ]
    }
  ]
}
