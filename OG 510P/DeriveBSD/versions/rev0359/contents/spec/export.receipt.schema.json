{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD export receipt (export.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "artifact",
    "policy_digest"
  ],
  "properties": {
    "kind": {
      "const": "export.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact": {
      "type": "object",
      "required": [
        "kind",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "policy_digest": {
      "type": "string",
      "description": "Digest of export.policy used."
    },
    "plan_digest": {
      "type": "string",
      "description": "Optional digest of bundle.plan that produced the exported artifact."
    },
    "lease_id": {
      "type": "string",
      "description": "Lease id authorizing this export attempt (portal/breakglass)."
    },
    "redaction": {
      "type": "object",
      "properties": {
        "transform_digest": {
          "type": "string"
        },
        "receipt_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "description": "Where the bytes went (metadata only).",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "file",
            "ticket-upload",
            "https-upload",
            "email",
            "removable-media",
            "oob"
          ]
        },
        "ticket_id": {
          "type": "string"
        },
        "recipient": {
          "type": "string"
        },
        "uri_hint": {
          "type": "string",
          "description": "Optional redacted URI hint (avoid embedding secrets)."
        },
        "domain": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "description": "Adapter-specific metadata (upload id, status codes, remote ids, remote validators, remote locators).",
      "properties": {
        "remote_id": {
          "type": "string"
        },
        "remote_validator": {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "etag-strong",
                "etag-weak",
                "version-id",
                "attachment-revision",
                "message-id",
                "opaque"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "remote_protection": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "versioned-noncurrent-retained",
                "retain-until",
                "policy-locked-retention",
                "legal-hold",
                "append-only-log",
                "opaque-reviewed"
              ]
            },
            "retain_until": {
              "type": "string",
              "format": "date-time"
            },
            "note": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "enum": [
                      "retain-until",
                      "policy-locked-retention"
                    ]
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "retain_until"
                ]
              }
            }
          ],
          "additionalProperties": false
        },
        "remote_locator": {
          "type": "object",
          "description": "Redacted non-secret locator for finding the same remote object later without relying on provider folklore.",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "uri-hint",
                "ticket-attachment",
                "portal-object",
                "message-part",
                "object-path",
                "opaque"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "supporting_evidence": {
      "type": "array",
      "description": "Optional typed evidence joins that explain why this export was permitted or how a stronger exported artifact was derived.",
      "items": {
        "$ref": "#/$defs/artifact_ref"
      }
    },
    "signature": {
      "type": "string"
    },
    "consent_receipt_digest": {
      "type": "string",
      "description": "Optional digest of consent.receipt authorizing this export (portal/TTY/OOB)."
    },
    "transport_receipt_digest": {
      "type": "string",
      "description": "Optional digest of transport.receipt describing the actual transport action."
    },
    "transparency_entry_digest": {
      "type": "string",
      "description": "Optional digest of export.transparency.entry proving a log entry for this export."
    },
    "delivery_state": {
      "type": "string"
    },
    "transport_acceptance_receipt_digest": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "required": [
        "kind",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "description": "Optional proof-chain role for this supporting evidence object."
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
