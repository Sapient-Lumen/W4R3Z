{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD support-bundle intake receipt profile (content.import.support-bundle.receipt) (v0.1)",
  "allOf": [
    {
      "$ref": "content.import.receipt.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "content.import.receipt"
        },
        "receipt_version": {
          "const": "0.1"
        },
        "subject": {
          "type": "object",
          "required": [
            "digest",
            "mime",
            "filename"
          ],
          "properties": {
            "mime": {
              "const": "application/zstd"
            },
            "filename": {
              "type": "string",
              "pattern": "\\.tar\\.zst$"
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 3,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "scan"
                  },
                  "status": {
                    "const": "ok"
                  },
                  "tool": {
                    "const": "bundle.scan"
                  }
                },
                "required": [
                  "op",
                  "status",
                  "tool"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "unpack"
                  },
                  "status": {
                    "const": "ok"
                  },
                  "tool": {
                    "const": "bundle.unpack"
                  }
                },
                "required": [
                  "op",
                  "status",
                  "tool"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "classify"
                  },
                  "status": {
                    "const": "ok"
                  },
                  "tool": {
                    "const": "bundle.preview"
                  }
                },
                "required": [
                  "op",
                  "status",
                  "tool"
                ]
              }
            }
          ]
        },
        "execution": {
          "type": "object",
          "properties": {
            "isolation": {
              "const": "microvm"
            },
            "network": {
              "const": "none"
            },
            "lifetime": {
              "const": "disposable"
            }
          },
          "required": [
            "isolation",
            "network",
            "lifetime"
          ]
        },
        "outputs": {
          "type": "array",
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "/var/derive/imports/case-8841"
                  },
                  "labels": {
                    "type": "object",
                    "properties": {
                      "class": {
                        "const": "support-bundle-unpacked"
                      },
                      "trust": {
                        "const": "quarantined"
                      }
                    },
                    "required": [
                      "class",
                      "trust"
                    ]
                  }
                },
                "required": [
                  "path",
                  "labels"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "/var/derive/imports/case-8841/meta/incident.timeline.json"
                  },
                  "labels": {
                    "type": "object",
                    "properties": {
                      "class": {
                        "const": "timeline-preview"
                      },
                      "trust": {
                        "const": "quarantined"
                      }
                    },
                    "required": [
                      "class",
                      "trust"
                    ]
                  }
                },
                "required": [
                  "path",
                  "labels"
                ]
              }
            }
          ]
        },
        "metadata": {
          "type": "object",
          "properties": {
            "transport": {
              "const": "bundle-rehydration"
            },
            "status": {
              "enum": [
                "preserved",
                "rehydrated"
              ]
            }
          },
          "required": [
            "transport",
            "status"
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "status": {
              "const": "ok"
            }
          },
          "required": [
            "status"
          ]
        }
      },
      "required": [
        "kind",
        "receipt_version"
      ]
    }
  ],
  "type": "object",
  "required": [
    "kind",
    "receipt_version"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "content.import.plan",
        "content.import.receipt"
      ]
    },
    "receipt_version": {
      "type": "string"
    }
  }
}
