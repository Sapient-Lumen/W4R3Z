{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Network DNS Query Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "captured_at",
    "subject",
    "queries",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "net-dns-query-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "grant_digest": {
      "type": "string",
      "description": "Optional digest of the net-egress-grant under which DNS queries were performed."
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "resolver": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "system.dns",
            "system.net",
            "stub",
            "other"
          ]
        },
        "endpoint": {
          "type": "string",
          "description": "Optional resolver endpoint (e.g. IP:port or DoH URL), if policy permits recording it."
        }
      },
      "additionalProperties": false
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "qname",
          "qtype",
          "status"
        ],
        "properties": {
          "query_id": {
            "type": "string"
          },
          "qname": {
            "type": "string"
          },
          "qtype": {
            "type": "string",
            "enum": [
              "A",
              "AAAA",
              "CNAME",
              "TXT",
              "SRV",
              "MX",
              "PTR",
              "OTHER"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "nxdomain",
              "servfail",
              "timeout",
              "refused",
              "error"
            ]
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rtype": {
                  "type": "string"
                },
                "rdata": {
                  "type": "string"
                },
                "ttl": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "redaction_transform_digest": {
      "type": "string",
      "description": "Optional digest of the redaction transform applied to this receipt."
    },
    "signature": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
