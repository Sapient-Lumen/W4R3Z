{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD preopen map posture drift diff (preopen.map.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_map",
    "to_map",
    "entries_added",
    "entries_removed",
    "entries_changed"
  ],
  "properties": {
    "kind": {"const": "preopen.map.diff"},
    "diff_version": {"type": "string", "const": "0.1"},
    "created_at": {"type": "string", "format": "date-time"},

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation/domain/service).",
      "properties": {
        "host_id": {"type": "string"},
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "domain_kind": {"type": "string", "enum": ["host", "jail", "microvm"]},
        "domain_id": {"type": "string"},
        "service_id": {"type": "string"},
        "from_generation": {"type": "string"},
        "to_generation": {"type": "string"}
      },
      "additionalProperties": false
    },

    "from_map": {"$ref": "#/$defs/map_ref"},
    "to_map": {"$ref": "#/$defs/map_ref"},

    "entries_added": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "entries_removed": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "entries_changed": {"type": "array", "items": {"$ref": "#/$defs/entry_change"}},

    "summary": {
      "type": "object",
      "properties": {
        "added": {"type": "integer", "minimum": 0},
        "removed": {"type": "integer", "minimum": 0},
        "changed": {"type": "integer", "minimum": 0},
        "risk_flags": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },

    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "map_ref": {
      "type": "object",
      "description": "Reference to a preopen.map object by digest (and optional human fields).",
      "required": ["digest"],
      "properties": {
        "digest": {"type": "string"},
        "map_id": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["entry_id", "kind", "rights"],
      "properties": {
        "entry_id": {"type": "string"},
        "kind": {"type": "string"},
        "path": {"type": "string"},
        "inet": {
          "type": "object",
          "properties": {
            "proto": {"type": "string"},
            "host": {"type": "string"},
            "port": {"type": "integer"}
          },
          "additionalProperties": true
        },
        "rights": {"type": "array", "items": {"type": "string"}},
        "intent": {"type": "string"},
        "risk_tags": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "entry_change": {
      "type": "object",
      "required": ["entry_id", "from", "to", "classification"],
      "properties": {
        "entry_id": {"type": "string"},
        "from": {"$ref": "#/$defs/entry"},
        "to": {"$ref": "#/$defs/entry"},
        "classification": {
          "type": "string",
          "enum": ["kind", "target", "rights", "other"]
        },
        "risk_flags": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
