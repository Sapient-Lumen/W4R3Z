{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Redaction Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "input_digest",
    "output_digest",
    "transform_digest",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "redaction-receipt"},
    "receipt_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "input_digest": {"type": "string"},
    "output_digest": {"type": "string"},
    "transform_digest": {"type": "string"},

    "summary": {
      "type": "object",
      "description": "Optional small counters (fields removed, spans dropped). Keep tiny.",
      "additionalProperties": true
    },

    "issued_at": {"type": "string"},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
