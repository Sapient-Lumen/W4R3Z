{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD base set manifest (v0)",
  "type": "object",
  "required": [
    "kind",
    "manifest_version",
    "set_class",
    "platform",
    "source_authority",
    "build",
    "contents"
  ],
  "properties": {
    "kind": {"const": "base.set"},
    "manifest_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "set_class": {
      "type": "string",
      "enum": ["kernel", "userland", "toolchain"]
    },
    "platform": {
      "type": "object",
      "required": ["os", "release_train", "arch"],
      "properties": {
        "os": {"type": "string", "const": "freebsd"},
        "release_train": {"type": "string"},
        "arch": {"type": "string"},
        "abi": {"type": "string"}
      },
      "additionalProperties": true
    },
    "source_authority": {
      "type": "object",
      "required": ["kind", "digest"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["derive.plan", "adapter.pkgbase-import"]
        },
        "digest": {"type": "string"},
        "receipt_digest": {"type": "string"},
        "source_ref": {"type": "string"}
      },
      "additionalProperties": true
    },
    "build": {
      "type": "object",
      "required": ["lock_digest", "plan_digest", "build_env_digest"],
      "properties": {
        "lock_digest": {"type": "string"},
        "plan_digest": {"type": "string"},
        "build_env_digest": {"type": "string"},
        "closure_manifest_digest": {"type": "string"},
        "toolchain_set_digest": {"type": "string"}
      },
      "additionalProperties": true
    },
    "contents": {
      "type": "object",
      "required": ["root_tree_digest"],
      "properties": {
        "root_tree_digest": {"type": "string"},
        "file_manifest_digest": {"type": "string"},
        "boot_manifest_digest": {"type": "string"},
        "runtime_manifest_digest": {"type": "string"}
      },
      "additionalProperties": true
    },
    "relationships": {
      "type": "object",
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["set_class", "digest"],
            "properties": {
              "set_class": {
                "type": "string",
                "enum": ["kernel", "userland", "toolchain"]
              },
              "digest": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "replaces": {"type": "string"}
      },
      "additionalProperties": true
    },
    "compat": {
      "type": "object",
      "properties": {
        "pkgbase_packages": {
          "type": "array",
          "items": {"type": "string"}
        },
        "adapter_receipt_digest": {"type": "string"}
      },
      "additionalProperties": true
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key_id", "sig"],
        "properties": {
          "key_id": {"type": "string"},
          "sig": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "digest"],
        "properties": {
          "kind": {"type": "string"},
          "digest": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
