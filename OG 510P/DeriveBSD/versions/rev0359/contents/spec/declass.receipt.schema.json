{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Declassification Receipt (declass.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "receipt_id",
    "created_at",
    "request_ref",
    "decision",
    "policy_id",
    "outputs"
  ],
  "properties": {
    "kind": { "const": "declass.receipt" },
    "schema_version": { "type": "string", "const": "0.1" },
    "receipt_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },

    "request_ref": { "type": "string", "description": "Digest/ref to declass.request." },

    "decision": { "type": "string", "enum": ["allow", "deny"] },
    "policy_id": { "type": "string" },

    "consent_receipt": { "type": "string" },

    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "digest", "label"],
        "properties": {
          "ref": { "type": "string" },
          "digest": { "type": "string" },
          "label": { "$ref": "flow.label.schema.json" }
        },
        "additionalProperties": false
      }
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
