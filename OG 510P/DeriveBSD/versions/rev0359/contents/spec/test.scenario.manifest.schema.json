{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Scenario Test Manifest (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "manifest_version",
    "lock_digest",
    "plan_digest",
    "nodes",
    "runner",
    "script"
  ],
  "properties": {
    "kind": {
      "const": "test-scenario-manifest"
    },
    "manifest_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "name": {
      "type": "string"
    },
    "lock_digest": {
      "type": "string"
    },
    "plan_digest": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "artifact_digest"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "artifact_digest": {
            "type": "string"
          },
          "profile_digest": {
            "type": "string",
            "description": "Optional runtime sandbox profile digest for this node."
          }
        },
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "a",
          "b",
          "network"
        ],
        "properties": {
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          },
          "network": {
            "type": "string",
            "description": "Symbolic network name (mapped to epair/VNET/pf anchors)."
          },
          "pf_anchor_digest": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "runner": {
      "type": "object",
      "required": [
        "harness_digest",
        "sandbox_profile_digest"
      ],
      "properties": {
        "harness_digest": {
          "type": "string"
        },
        "sandbox_profile_digest": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "script": {
      "type": "object",
      "required": [
        "bundle_digest"
      ],
      "properties": {
        "bundle_digest": {
          "type": "string"
        },
        "entrypoint": {
          "type": "string",
          "description": "Optional entrypoint within the bundle."
        }
      },
      "additionalProperties": false
    },
    "expected_outputs": {
      "type": "object",
      "properties": {
        "require_node_receipts": {
          "type": "boolean"
        },
        "require_scenario_summary": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
