{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD resource profile (resource.profile) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "profile_version",
    "created_at",
    "budgets"
  ],
  "properties": {
    "kind": {
      "const": "resource.profile"
    },
    "profile_version": {
      "type": "string",
      "const": "0.1"
    },
    "profile_id": {
      "type": "string",
      "description": "Optional human identifier."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "description": "Where this profile is intended to apply (authoring intent).",
      "properties": {
        "host": {
          "type": "string"
        },
        "service_class": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "budgets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "resource",
          "limit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "resource": {
            "type": "string",
            "description": "Portable resource key; compiler maps to backend keys.",
            "enum": [
              "cpu.percent",
              "cpu.time",
              "memory.rss",
              "memory.swap",
              "proc.count",
              "thread.count",
              "fd.open",
              "fs.write.bytes",
              "net.tx.bytes",
              "net.rx.bytes"
            ]
          },
          "limit": {
            "description": "Human-authored limit; compiler normalizes.",
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "window": {
            "type": "string",
            "description": "Optional window (e.g. '1s', '1m')."
          },
          "action": {
            "type": "string",
            "enum": [
              "deny",
              "log",
              "signal",
              "throttle",
              "kill"
            ],
            "default": "log"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
