{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD packet-capture export transport reverification receipt profile (packet.capture.export.transport.reverification.receipt.profile) (v0.1)",
  "allOf": [
    {
      "$ref": "transport.reverification.receipt.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "packet.capture.normalized"
            }
          }
        },
        "reverification": {
          "type": "object",
          "required": [
            "kind",
            "checked_at",
            "status",
            "body_downloaded",
            "remote_validator",
            "remote_protection",
            "remote_locator"
          ],
          "properties": {
            "kind": {
              "enum": [
                "http-head",
                "object-head",
                "ticket-metadata-api",
                "message-metadata-api",
                "portal-manifest",
                "manual-reviewed",
                "custom"
              ]
            },
            "status": {
              "const": "match"
            },
            "body_downloaded": {
              "const": false
            },
            "remote_validator": {
              "type": "object",
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "etag-strong",
                    "etag-weak",
                    "version-id",
                    "attachment-revision",
                    "message-id",
                    "opaque"
                  ]
                },
                "value": {
                  "type": "string"
                }
              }
            },
            "remote_locator": {
              "type": "object",
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "uri-hint",
                    "ticket-attachment",
                    "portal-object",
                    "message-part",
                    "object-path",
                    "opaque"
                  ]
                },
                "value": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "required": [
        "kind",
        "receipt_version",
        "receipt_id",
        "created_at",
        "export_receipt_digest",
        "transport_acceptance_receipt_digest",
        "artifact",
        "recipient",
        "reverification"
      ]
    }
  ]
}
