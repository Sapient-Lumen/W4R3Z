{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD vulnerability gate receipt (vuln.gate.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "authority_semantics",
    "issued_at",
    "policy_digest",
    "vuln_db_snapshot_digest",
    "vuln_query_receipt_digest",
    "decision",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "vuln-gate-receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_digest": {
      "type": "string",
      "description": "Digest of the applied vuln.gate.policy object."
    },
    "vuln_db_snapshot_digest": {
      "type": "string"
    },
    "vuln_query_receipt_digest": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "block"
      ],
      "description": "Gate outcome."
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "vuln_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authority_semantics": {
      "type": "string",
      "const": "vulnerability-verification-evidence-only",
      "description": "Explicitly marks vuln-gate-receipt as policy-evaluation evidence rather than publication authority."
    }
  },
  "additionalProperties": false
}
