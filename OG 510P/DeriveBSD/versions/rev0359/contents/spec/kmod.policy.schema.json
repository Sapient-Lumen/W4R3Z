{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD kernel module policy (kmod.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "issued_at",
    "rules",
    "signature"
  ],
  "properties": {
    "kind": { "const": "kmod-policy" },
    "policy_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "signature": { "type": "object", "description": "Signature over the policy payload (format defined by trust policy)." },

    "defaults": {
      "type": "object",
      "properties": {
        "allow_runtime_load": { "type": "boolean", "default": false },
        "allow_unload": { "type": "boolean", "default": false },
        "deny_unknown": { "type": "boolean", "default": true, "description": "If true, modules not matched by an allow rule are denied." }
      },
      "additionalProperties": false
    },

    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "effect", "match"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$" },
          "description": { "type": "string" },
          "effect": { "type": "string", "enum": ["allow", "deny"] },

          "match": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "Module name (exact match)." },
              "name_regex": { "type": "string", "description": "Optional regex for module names (use sparingly)." },
              "digest": { "type": "string", "description": "Optional digest of the module file bytes." },
              "path_prefix": { "type": "string", "description": "Optional path prefix constraint (e.g., /boot/kernel)." },
              "device_class": { "type": "string", "description": "Optional device class tie-in (e.g., net, storage, gpu)." }
            },
            "additionalProperties": false
          },

          "constraints": {
            "type": "object",
            "properties": {
              "require_mediated": { "type": "boolean", "default": true, "description": "If true, loads must be attributed to a mediated apply/broker path." },
              "allow_unload": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
