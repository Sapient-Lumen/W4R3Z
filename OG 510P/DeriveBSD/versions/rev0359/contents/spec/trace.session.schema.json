{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD trace session spec (trace.session) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "session_version",
    "created_at",
    "scope",
    "program"
  ],
  "properties": {
    "kind": {
      "const": "trace.session"
    },
    "session_version": {
      "type": "string",
      "const": "0.1"
    },
    "session_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "required": [
        "host"
      ],
      "properties": {
        "host": {
          "type": "string"
        },
        "service_id": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "contract_handle_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "string",
      "enum": [
        "dtrace",
        "bpftrace",
        "ktrace",
        "audit"
      ],
      "default": "dtrace"
    },
    "program": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "description": "Digest of the trace program/script artifact."
        },
        "format": {
          "type": "string",
          "description": "d, bpftrace, \u2026"
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "duration": {
          "type": "string",
          "default": "60s"
        },
        "max_output_bytes": {
          "type": "integer",
          "default": 10485760
        }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "properties": {
        "transform_digest": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
