{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Crash Report evidence (crash.report) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "report_version",
    "crash_id",
    "at",
    "host",
    "crash"
  ],
  "properties": {
    "kind": {
      "const": "crash-report"
    },
    "report_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "crash_id": {
      "type": "string",
      "description": "Stable id (UUID recommended) for the crash report."
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "required": [
        "host_id",
        "generation_digest",
        "arch"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "generation_digest": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        },
        "kernel": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "uptime_s": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "crash": {
      "type": "object",
      "required": [
        "domain",
        "crash_type"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "enum": [
            "host",
            "vm",
            "service",
            "toolchain",
            "kernel",
            "hypervisor"
          ]
        },
        "crash_type": {
          "type": "string",
          "enum": [
            "panic",
            "signal",
            "exception",
            "watchdog",
            "oom",
            "abort",
            "unknown"
          ]
        },
        "service_id": {
          "type": "string",
          "description": "If the crashed subject is a supervised service."
        },
        "vm_id": {
          "type": "string",
          "description": "If the crashed subject is a VM/microVM."
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "uid": {
          "type": "integer",
          "minimum": 0
        },
        "exec_digest": {
          "type": "string",
          "description": "Digest of the executable artifact (if known)."
        },
        "reason": {
          "type": "object",
          "properties": {
            "signal": {
              "type": "string"
            },
            "exception_code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "signature": {
          "type": "object",
          "description": "Optional crash signature for grouping (e.g., stack hash).",
          "properties": {
            "stack_hash": {
              "type": "string"
            },
            "fault_class": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "correlation": {
      "type": "object",
      "properties": {
        "change_id": {
          "type": "string"
        },
        "fault_id": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        },
        "svc_event_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "description": "Pointers to heavy crash artifacts; these are digests/ids, not inline blobs.",
      "properties": {
        "minidump_digest": {
          "type": "string"
        },
        "core_digest": {
          "type": "string"
        },
        "kernel_dump_digest": {
          "type": "string"
        },
        "replay_capsule_digest": {
          "type": "string"
        },
        "symbolication": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "none",
                "pending",
                "partial",
                "complete",
                "failed"
              ]
            },
            "debuginfod_urls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resolved_build_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_build_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "safe-metadata",
            "sensitive",
            "secret-risk"
          ]
        },
        "contains_dump": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}