{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD fuzz receipt (fuzz.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "authority_semantics",
    "receipt_id",
    "issued_at",
    "target",
    "harness",
    "runner",
    "sandbox",
    "inputs",
    "result_summary"
  ],
  "properties": {
    "kind": {
      "const": "fuzz.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "authority_semantics": {
      "type": "string",
      "const": "fuzzing-evidence-only"
    },
    "receipt_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "target_id",
        "target_class",
        "artifact_digest"
      ],
      "properties": {
        "target_id": {
          "type": "string"
        },
        "target_class": {
          "type": "string",
          "enum": [
            "uapi",
            "parser",
            "importer",
            "broker",
            "driver",
            "other"
          ]
        },
        "artifact_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "required": [
        "tool",
        "digest"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "descriptor_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runner": {
      "type": "object",
      "required": [
        "tool",
        "digest"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sandbox": {
      "type": "object",
      "required": [
        "isolation",
        "network"
      ],
      "properties": {
        "isolation": {
          "type": "string",
          "enum": [
            "microvm",
            "jail",
            "host-adapter"
          ]
        },
        "network": {
          "type": "string",
          "enum": [
            "none",
            "brokered",
            "full"
          ]
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": [
        "corpus_set_digest"
      ],
      "properties": {
        "corpus_set_digest": {
          "type": "string"
        },
        "seed_inputs_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "result_summary": {
      "type": "object",
      "required": [
        "status",
        "exec_count",
        "wallclock_seconds",
        "new_crash_case_count",
        "reproducible_crash_case_count",
        "flake_suspect_count"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed-no-crash",
            "completed-with-crash",
            "infrastructure-failed"
          ]
        },
        "exec_count": {
          "type": "integer",
          "minimum": 0
        },
        "wallclock_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "new_crash_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "reproducible_crash_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "flake_suspect_count": {
          "type": "integer",
          "minimum": 0
        },
        "crash_case_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "coverage_summary_digest": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
