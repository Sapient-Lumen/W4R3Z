{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD packet-capture normalization redaction transform profile (redaction.transform.packet-capture) (v0.1)",
  "allOf": [
    {
      "$ref": "redaction.transform.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "redaction-transform"
        },
        "transform_version": {
          "const": "0.1"
        },
        "applies_to": {
          "type": "array",
          "contains": {
            "const": "pcap"
          }
        },
        "policy": {
          "type": "object",
          "required": [
            "allow_attributes",
            "deny_attributes"
          ],
          "properties": {
            "allow_attributes": {
              "type": "array",
              "contains": {
                "const": "packet-records"
              }
            },
            "deny_attributes": {
              "type": "array",
              "allOf": [
                {
                  "contains": {
                    "const": "capture-comment"
                  }
                },
                {
                  "contains": {
                    "const": "packet-comment"
                  }
                },
                {
                  "contains": {
                    "const": "name-resolution"
                  }
                },
                {
                  "contains": {
                    "const": "decryption-secrets"
                  }
                }
              ]
            }
          }
        },
        "implementation": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "declarative",
                "wasm-module"
              ]
            }
          }
        }
      },
      "required": [
        "kind",
        "transform_version",
        "applies_to",
        "policy",
        "implementation"
      ]
    }
  ]
}
