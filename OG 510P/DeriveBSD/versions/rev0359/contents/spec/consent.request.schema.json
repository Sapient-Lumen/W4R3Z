{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD consent request (consent.request) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "request_version",
    "request_id",
    "created_at",
    "action",
    "expires_at"
  ],
  "properties": {
    "kind": {
      "const": "consent.request"
    },
    "request_version": {
      "type": "string",
      "const": "0.1"
    },
    "request_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "action": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "export",
            "breakglass",
            "trace.session",
            "change.confirm",
            "lockdown",
            "custom"
          ]
        },
        "summary": {
          "type": "string"
        },
        "policy_digest": {
          "type": "string"
        },
        "artifact_digest": {
          "type": "string"
        },
        "plan_digest": {
          "type": "string"
        },
        "lease_id": {
          "type": "string"
        },
        "destination": {
          "type": "object",
          "description": "Optional intended destination metadata for export-style approval requests.",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "file",
                "ticket-upload",
                "https-upload",
                "email",
                "removable-media",
                "oob"
              ]
            },
            "ticket_id": {
              "type": "string"
            },
            "recipient": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            },
            "uri_hint": {
              "type": "string",
              "description": "Optional redacted URI hint (avoid embedding secrets)."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "approvals": {
      "type": "object",
      "properties": {
        "two_person": {
          "type": "boolean",
          "default": false
        },
        "approvers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quorum": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "secure_attention_required": {
      "type": "boolean",
      "default": false
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
