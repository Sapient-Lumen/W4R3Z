{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Closure Manifest (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "manifest_version",
    "roots",
    "objects",
    "bindings"
  ],
  "properties": {
    "kind": {"const": "closure-manifest"},
    "manifest_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target_kind", "digest"],
        "properties": {
          "target_kind": {"type": "string", "enum": ["host", "microvm"]},
          "digest": {"type": "string"},
          "runtime_manifest_digest": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "digest"],
        "properties": {
          "path": {"type": "string"},
          "digest": {"type": "string"},
          "kind": {"type": "string", "enum": ["store", "zfs-snap", "file"]}
        },
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "object",
      "description": "Digests that bind this closure to a derivation and policy.",
      "required": ["lock_digest", "policy_decision_digest"],
      "properties": {
        "lock_digest": {"type": "string"},
        "policy_decision_digest": {"type": "string"},
        "plan_digest": {"type": "string"}
      },
      "additionalProperties": false
    },
    "attestations": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["predicate_type", "digest"],
            "properties": {
              "predicate_type": {"type": "string"},
              "digest": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "meta": {
      "type": "object",
      "properties": {
        "namespace": {"type": "string"},
        "channel": {"type": "string"},
        "generated_at": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
