{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD state snapshot (state-snapshot) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "snapshot_version",
    "created_at",
    "host_id",
    "generation_digest",
    "volumes"
  ],
  "properties": {
    "kind": { "const": "state-snapshot" },
    "snapshot_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "host_id": { "type": "string" },
    "generation_digest": { "type": "string" },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["volume_id", "dataset", "schema_version"],
        "properties": {
          "volume_id": { "type": "string" },
          "dataset": { "type": "string" },
          "schema_version": { "type": "string" },
          "healthy": { "type": "boolean" },
          "notes": { "type": "string" },
          "last_migration_receipt_digest": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "signature": { "type": "string" }
  },
  "additionalProperties": false
}
