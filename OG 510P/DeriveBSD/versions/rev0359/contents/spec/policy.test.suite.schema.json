{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD policy test suite (policy.test.suite) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "suite_version",
    "created_at",
    "target",
    "cases"
  ],
  "properties": {
    "kind": {"const": "policy-test-suite"},
    "suite_version": {"type": "string", "const": "0.1"},
    "suite_id": {"type": "string", "description": "Stable id (UUID recommended) for review threads and report correlation."},
    "created_at": {"type": "string", "format": "date-time"},
    "target": {
      "type": "object",
      "description": "What policy surface is under test.",
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"type": "string", "description": "Policy surface kind (e.g., net.egress.policy, sandbox.profile, trust.policy)."},
        "ref": {"type": "string", "description": "Repo-relative path or stable identifier for the policy source."},
        "digest": {"type": "string", "description": "Optional digest of the exact policy bytes/IR under test."},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "description": "Optional policy evaluation engine metadata.",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "profile": {"type": "string", "description": "Optional mode/profile (e.g., 'strict', 'ci')."}
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "request", "expected"],
        "properties": {
          "case_id": {"type": "string", "description": "Stable identifier for diffability."},
          "title": {"type": "string"},
          "request": {
            "type": "object",
            "description": "Decision request. Shape is policy-surface specific.",
            "additionalProperties": true
          },
          "context": {
            "type": "object",
            "description": "Facts/evidence inputs used by policy evaluation (attribute maps, receipt refs, etc.).",
            "additionalProperties": true
          },
          "expected": {
            "type": "object",
            "required": ["decision"],
            "properties": {
              "decision": {"type": "string", "enum": ["allow", "deny"]},
              "obligations": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Optional expected obligation ids/tags (surface-specific meaning)."
              },
              "reason_contains": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Optional substrings that should appear in an explain string or trace summary."
              }
            },
            "additionalProperties": false
          },
          "tags": {"type": "array", "items": {"type": "string"}},
          "refs": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Optional URLs or digest pointers to incidents/ADRs motivating the case."
          }
        },
        "additionalProperties": false
      }
    },
    "mutation": {
      "type": "object",
      "description": "Optional mutation testing configuration.",
      "properties": {
        "enabled": {"type": "boolean"},
        "operators": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Mutation operator ids understood by the runner (e.g., 'flip-effect', 'widen-selector')."
        },
        "max_mutants": {"type": "integer", "minimum": 0},
        "seed": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
