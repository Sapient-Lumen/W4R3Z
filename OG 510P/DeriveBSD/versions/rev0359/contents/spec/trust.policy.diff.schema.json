{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD trust policy diff (trust.policy.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_policy",
    "to_policy",
    "namespaces_added",
    "namespaces_removed",
    "namespaces_changed"
  ],
  "properties": {
    "kind": { "const": "trust.policy.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation/tenant).",
      "properties": {
        "host_id": { "type": "string" },
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "namespace_id": {
          "type": "string",
          "description": "Optional namespace focus (if diff is generated for a single tenant/org)."
        },
        "from_generation": { "type": "string" },
        "to_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "from_policy": { "$ref": "#/$defs/policy_ref" },
    "to_policy": { "$ref": "#/$defs/policy_ref" },

    "namespaces_added": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Namespace ids added in the target policy."
    },
    "namespaces_removed": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Namespace ids removed in the target policy."
    },
    "namespaces_changed": {
      "type": "array",
      "items": { "$ref": "#/$defs/namespace_change" },
      "description": "Per-namespace drift summaries (keys/channels/targets)."
    },

    "summary": {
      "type": "object",
      "description": "Optional rollup fields for gating/UI.",
      "properties": {
        "namespaces_added": { "type": "integer", "minimum": 0 },
        "namespaces_removed": { "type": "integer", "minimum": 0 },
        "namespaces_changed": { "type": "integer", "minimum": 0 },
        "keys_added": { "type": "integer", "minimum": 0 },
        "keys_removed": { "type": "integer", "minimum": 0 },
        "keys_changed": { "type": "integer", "minimum": 0 },
        "targets_changed": { "type": "integer", "minimum": 0 },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "policy_ref": {
      "type": "object",
      "description": "Reference to a trust-policy object by digest (and optional human fields).",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "policy_version": { "type": "string" },
        "namespace_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "channel": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "max_rollback_window": { "type": ["string", "null"] },
        "require_expiry": { "type": ["boolean", "null"] }
      },
      "additionalProperties": false
    },

    "channel_change": {
      "type": "object",
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string" },
        "from": { "$ref": "#/$defs/channel" },
        "to": { "$ref": "#/$defs/channel" },
        "classification": {
          "type": "string",
          "enum": ["rollback_window", "expiry", "multiple", "other"]
        },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "key": {
      "type": "object",
      "required": ["key_id", "role", "alg"],
      "properties": {
        "key_id": { "type": "string" },
        "role": { "type": "string", "enum": ["root", "signing", "policy"] },
        "alg": { "type": "string" },
        "public_digest": {
          "type": ["string", "null"],
          "description": "Optional digest of the canonical public key encoding (stable reviewer handle)."
        },
        "valid_from": { "type": ["string", "null"] },
        "valid_to": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },

    "key_change": {
      "type": "object",
      "required": ["key_id", "from", "to"],
      "properties": {
        "key_id": { "type": "string" },
        "from": { "$ref": "#/$defs/key" },
        "to": { "$ref": "#/$defs/key" },
        "classification": {
          "type": "string",
          "enum": ["public", "role", "alg", "validity", "multiple", "other"]
        },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "bool_change": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "boolean" },
        "to": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "string_set_change": {
      "type": "object",
      "required": ["added", "removed"],
      "properties": {
        "added": { "type": "array", "items": { "type": "string" } },
        "removed": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "target_rules_change": {
      "type": "object",
      "description": "Minimal diff surface for target admission rules.",
      "properties": {
        "required_signers": { "$ref": "#/$defs/string_set_change" },
        "required_attestations": { "$ref": "#/$defs/string_set_change" },
        "require_closure_proof": { "$ref": "#/$defs/bool_change" },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "namespace_change": {
      "type": "object",
      "required": [
        "id",
        "channels_added",
        "channels_removed",
        "channels_changed",
        "keys_added",
        "keys_removed",
        "keys_changed",
        "targets_changed"
      ],
      "properties": {
        "id": { "type": "string" },

        "channels_added": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
        "channels_removed": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
        "channels_changed": { "type": "array", "items": { "$ref": "#/$defs/channel_change" } },

        "keys_added": { "type": "array", "items": { "$ref": "#/$defs/key" } },
        "keys_removed": { "type": "array", "items": { "$ref": "#/$defs/key" } },
        "keys_changed": { "type": "array", "items": { "$ref": "#/$defs/key_change" } },

        "targets_changed": {
          "type": "object",
          "required": ["host", "microvm"],
          "properties": {
            "host": { "$ref": "#/$defs/target_rules_change" },
            "microvm": { "$ref": "#/$defs/target_rules_change" }
          },
          "additionalProperties": false
        },

        "summary": {
          "type": "object",
          "properties": {
            "keys_added": { "type": "integer", "minimum": 0 },
            "keys_removed": { "type": "integer", "minimum": 0 },
            "keys_changed": { "type": "integer", "minimum": 0 },
            "targets_changed": { "type": "integer", "minimum": 0 },
            "risk_flags": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },

        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
