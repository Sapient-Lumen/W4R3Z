{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD mirror kit promotion plan (mirror.promote.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "from_quarantine",
    "into_channel",
    "policy_digest"
  ],
  "properties": {
    "kind": { "const": "mirror.promote.plan" },
    "plan_version": { "type": "string", "const": "0.1" },
    "plan_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },

    "requested_by": { "type": "string" },

    "from_quarantine": {
      "type": "object",
      "required": ["quarantine_id"],
      "properties": {
        "quarantine_id": { "type": "string" },
        "cache_state_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "into_channel": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "mode": { "type": "string", "enum": ["merge", "replace"], "default": "merge" }
      },
      "additionalProperties": false
    },

    "gates": {
      "type": "object",
      "description": "Optional gate inputs (policy may require).",
      "properties": {
        "trust_policy_digest": { "type": "string" },
        "release_authority_policy_digest": { "type": "string" },
        "allowlist_digest": { "type": "string" },
        "cohort_policy_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "transaction": {
      "type": "object",
      "description": "Promotion must be reversible (transactional).",
      "properties": {
        "mode": { "type": "string", "enum": ["atomic"], "default": "atomic" },
        "rollback_window_seconds": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "policy_digest": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
