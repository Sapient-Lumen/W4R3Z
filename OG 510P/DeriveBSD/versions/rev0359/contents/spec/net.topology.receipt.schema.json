{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD network topology receipt (net.topology.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_id",
    "plan_digest",
    "status"
  ],
  "properties": {
    "kind": { "const": "net-topology-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "receipt_id": { "type": "string", "description": "Stable id for this receipt (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "plan_id": { "type": "string" },
    "plan_digest": { "type": "string", "description": "Digest of the net.topology.plan that was executed." },

    "host": {
      "type": "object",
      "properties": {
        "machine_id": { "type": "string" },
        "boot_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "link_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["created", "removed", "unchanged", "failed"] },
          "ifindex": { "type": "integer", "minimum": 0 },
          "mac_hash": { "type": "string", "description": "Optional privacy-safe identifier (hash/HMAC)." },
          "error": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "address_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["iface", "cidr", "status"],
        "properties": {
          "iface": { "type": "string" },
          "cidr": { "type": "string" },
          "status": { "type": "string", "enum": ["added", "removed", "unchanged", "failed"] },
          "error": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "route_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dst", "via", "status"],
        "properties": {
          "dst": { "type": "string" },
          "via": { "type": "string" },
          "status": { "type": "string", "enum": ["added", "removed", "unchanged", "failed"] },
          "error": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "pf": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "root_rules_digest": { "type": "string" },
        "anchors_loaded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "rules_digest", "status"],
            "properties": {
              "name": { "type": "string" },
              "rules_digest": { "type": "string" },
              "status": { "type": "string", "enum": ["loaded", "replaced", "unloaded", "failed"] },
              "error": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "observed_state_digest": { "type": "string", "description": "Optional digest of observed post-apply network state (for drift checking)." },

    "status": { "type": "string", "enum": ["success", "partial", "failed"] },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
