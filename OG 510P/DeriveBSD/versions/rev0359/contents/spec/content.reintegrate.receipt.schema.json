{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD content reintegration receipt (content.reintegrate.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_digest",
    "policy_digest",
    "source",
    "target",
    "boundary",
    "supersession",
    "lineage",
    "recovery",
    "result"
  ],
  "properties": {
    "kind": {
      "const": "content.reintegrate.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_digest": {
      "type": "string"
    },
    "policy_digest": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "working_copy_receipt_digest",
        "working_copy_output_digest",
        "import_receipt_digest",
        "authoritative_origin_digest"
      ],
      "properties": {
        "working_copy_receipt_digest": {
          "type": "string"
        },
        "working_copy_output_digest": {
          "type": "string"
        },
        "import_receipt_digest": {
          "type": "string"
        },
        "authoritative_origin_digest": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "scope",
        "action"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "const": "same-authoritative-origin"
        },
        "action": {
          "type": "string",
          "const": "register-successor-candidate"
        },
        "version_label": {
          "type": "string"
        },
        "change_summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": [
        "candidate_posture",
        "replace_in_place",
        "upstream_finalize",
        "candidate_snapshot",
        "later_edits",
        "candidate_ordering",
        "recency_precedence",
        "supersession_scope",
        "supersession_target_posture",
        "stale_target_handling",
        "stale_target_evidence",
        "stale_target_recovery"
      ],
      "properties": {
        "candidate_posture": {
          "type": "string",
          "const": "local-successor-candidate"
        },
        "replace_in_place": {
          "type": "string",
          "const": "forbidden"
        },
        "upstream_finalize": {
          "type": "string",
          "const": "separate-adapter-required"
        },
        "candidate_snapshot": {
          "type": "string",
          "const": "immutable"
        },
        "later_edits": {
          "type": "string",
          "const": "new-candidate-required"
        },
        "candidate_ordering": {
          "type": "string",
          "const": "explicit-supersession-only"
        },
        "recency_precedence": {
          "type": "string",
          "const": "forbidden"
        },
        "supersession_scope": {
          "type": "string",
          "const": "same-authoritative-origin-only"
        },
        "supersession_target_posture": {
          "type": "string",
          "const": "current-unsuperseded-candidate-only"
        },
        "stale_target_handling": {
          "type": "string",
          "const": "fail-closed"
        },
        "stale_target_evidence": {
          "type": "string",
          "const": "observed-current-head-required"
        },
        "stale_target_recovery": {
          "type": "string",
          "const": "fresh-explicit-supersession-required"
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": [
        "relationship",
        "candidate_digest",
        "authoritative_origin_digest"
      ],
      "properties": {
        "relationship": {
          "type": "string",
          "const": "successor-candidate-of"
        },
        "candidate_digest": {
          "type": "string"
        },
        "authoritative_origin_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "deny",
            "fail"
          ]
        },
        "message": {
          "type": "string"
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "stale-supersession-target"
          ],
          "description": "Typed denial reason for a supersession attempt that named a predecessor which was no longer the current unsuperseded candidate."
        },
        "recovery_posture": {
          "type": "string",
          "enum": [
            "fresh-explicit-supersession-required"
          ],
          "description": "Stable recovery answer for stale supersession denials: build a fresh explicit supersession act against the observed current head rather than rebinding the old request."
        },
        "observed_current_receipt_digest": {
          "type": "string",
          "description": "Digest of the current unsuperseded content.reintegrate.receipt that made the attempted supersession target stale."
        },
        "observed_current_candidate_digest": {
          "type": "string",
          "description": "Digest of the current unsuperseded candidate snapshot that made the attempted supersession target stale."
        },
        "observed_current_authoritative_origin_digest": {
          "type": "string",
          "description": "Digest of the authoritative origin shared by the denied attempt and the observed current head."
        }
      },
      "additionalProperties": false
    },
    "portal_session_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "recovery": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "from-stale-supersession-denial"
          ]
        },
        "stale_denial_receipt_digest": {
          "type": "string"
        },
        "expected_current_receipt_digest": {
          "type": "string"
        },
        "expected_current_candidate_digest": {
          "type": "string"
        },
        "expected_current_authoritative_origin_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "from-stale-supersession-denial"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "stale_denial_receipt_digest",
              "expected_current_receipt_digest",
              "expected_current_candidate_digest",
              "expected_current_authoritative_origin_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "none"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "stale_denial_receipt_digest"
                  ]
                },
                {
                  "required": [
                    "expected_current_receipt_digest"
                  ]
                },
                {
                  "required": [
                    "expected_current_candidate_digest"
                  ]
                },
                {
                  "required": [
                    "expected_current_authoritative_origin_digest"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "supersession": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "supersede-prior-candidate"
          ]
        },
        "supersedes_receipt_digest": {
          "type": "string"
        },
        "superseded_candidate_digest": {
          "type": "string"
        },
        "superseded_authoritative_origin_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "supersede-prior-candidate"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "supersedes_receipt_digest",
              "superseded_candidate_digest",
              "superseded_authoritative_origin_digest"
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "supersession": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "supersede-prior-candidate"
              }
            },
            "required": [
              "mode"
            ]
          },
          "result": {
            "type": "object",
            "properties": {
              "reason_code": {
                "const": "stale-supersession-target"
              }
            },
            "required": [
              "reason_code"
            ]
          }
        },
        "required": [
          "supersession",
          "result"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "required": [
              "status",
              "reason_code",
              "recovery_posture",
              "observed_current_receipt_digest",
              "observed_current_candidate_digest",
              "observed_current_authoritative_origin_digest"
            ],
            "properties": {
              "status": {
                "const": "deny"
              },
              "reason_code": {
                "const": "stale-supersession-target"
              },
              "recovery_posture": {
                "const": "fresh-explicit-supersession-required"
              }
            }
          }
        }
      }
    }
  ]
}
