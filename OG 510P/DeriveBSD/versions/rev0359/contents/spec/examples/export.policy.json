{
  "kind": "export.policy",
  "policy_version": "0.1",
  "policy_id": "a3bd6a5a-ec9f-4a5c-9b7d-ec2a9485a0aa",
  "created_at": "2026-02-25T23:10:00Z",
  "label": "external-vendor/support",
  "description": "Default policy for exporting incident bundles to external vendors: require ticket, encryption, and deterministic redaction.",
  "consent": {
    "interactive": true,
    "two_person": false
  },
  "recipients": {
    "class": "external-vendor",
    "identifiers": [
      "vendor:acme-support"
    ],
    "require_ticket": true,
    "ticket_pattern": "^CASE-[0-9]+$"
  },
  "encryption": {
    "mode": "age",
    "recipients": [
      "age1vendorpubkey..."
    ]
  },
  "rules": [
    {
      "artifact_kind": "incident-bundle",
      "redaction_transform_digest": "sha256:feedface...",
      "allow_metadata_only": true,
      "allow_raw_blobs": false,
      "notes": "No raw core/kernel dumps; export bundle-min with redaction."
    },
    {
      "artifact_kind": "trace.output",
      "redaction_transform_digest": "sha256:cafebabe...",
      "allow_metadata_only": true,
      "allow_raw_blobs": true
    }
  ],
  "lease_required": true,
  "transport_policy_digest": "sha256:transportpolicy...",
  "transparency": {
    "mode": "rekor",
    "required": false,
    "log_uri": "https://rekor.example.internal",
    "metadata_profile": "minimal",
    "hash_ticket_id": true,
    "hash_recipient": true,
    "notes": "Log export events internally for tamper-evident history."
  }
}
