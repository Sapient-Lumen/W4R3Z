{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD service supervision event (svc-event) (v0.1)",
  "allOf": [
    {
      "$ref": "event.record.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "event_version",
        "event_id",
        "at",
        "source",
        "generation_digest",
        "service_id",
        "event_type"
      ],
      "properties": {
        "kind": {
          "const": "svc-event"
        },
        "event_version": {
          "type": "string",
          "pattern": "^0\\.\\d+$"
        },
        "event_id": {
          "type": "string",
          "description": "Stable id (UUID recommended)."
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "Supervisor/restarter component name."
            },
            "host_id": {
              "type": "string"
            },
            "domain": {
              "type": "string",
              "description": "Optional domain identifier if supervisor runs in a compartment."
            }
          },
          "additionalProperties": false
        },
        "generation_digest": {
          "type": "string"
        },
        "service_id": {
          "type": "string"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "state-transition",
            "restart-attempt",
            "crash",
            "maintenance-enter",
            "maintenance-exit",
            "note",
            "contract-event"
          ]
        },
        "from_state": {
          "type": "string",
          "enum": [
            "uninitialized",
            "offline",
            "online",
            "degraded",
            "maintenance",
            "disabled",
            "legacy-run"
          ]
        },
        "to_state": {
          "type": "string",
          "enum": [
            "uninitialized",
            "offline",
            "online",
            "degraded",
            "maintenance",
            "disabled",
            "legacy-run"
          ]
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": true
        },
        "instance_id": {
          "type": "string",
          "description": "Optional service instance id (default semantic: 'default')."
        },
        "contract_handle_digest": {
          "type": "string",
          "description": "Optional digest pointer to a svc-contract-handle evidence object (service boundary ownership handle)."
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
