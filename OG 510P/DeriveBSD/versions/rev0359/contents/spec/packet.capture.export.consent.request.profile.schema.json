{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD packet-capture export consent request profile (packet.capture.export.consent.request.profile) (v0.1)",
  "allOf": [
    {
      "$ref": "consent.request.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "object",
          "required": [
            "kind",
            "policy_digest",
            "artifact_digest",
            "lease_id",
            "destination"
          ],
          "properties": {
            "kind": {
              "const": "export"
            },
            "policy_digest": {
              "type": "string"
            },
            "artifact_digest": {
              "type": "string"
            },
            "lease_id": {
              "type": "string"
            },
            "destination": {
              "type": "object",
              "required": [
                "type",
                "recipient"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "ticket-upload",
                    "https-upload",
                    "email",
                    "removable-media",
                    "oob"
                  ]
                },
                "ticket_id": {
                  "type": "string"
                },
                "recipient": {
                  "type": "string",
                  "minLength": 1
                },
                "domain": {
                  "type": "string"
                },
                "uri_hint": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "ticket-upload"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "required": [
                      "ticket_id"
                    ]
                  }
                }
              ]
            }
          }
        },
        "secure_attention_required": {
          "const": true
        }
      },
      "required": [
        "kind",
        "request_version",
        "request_id",
        "created_at",
        "expires_at",
        "action",
        "secure_attention_required"
      ]
    }
  ]
}
