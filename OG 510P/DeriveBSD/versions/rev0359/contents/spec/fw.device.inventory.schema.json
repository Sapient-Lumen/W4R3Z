{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD firmware device inventory (fw.device.inventory) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "inventory_version",
    "created_at",
    "host",
    "components"
  ],
  "properties": {
    "kind": {
      "const": "fw-device-inventory"
    },
    "inventory_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "inventory_id": {
      "type": "string",
      "description": "Stable id for this inventory snapshot (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "required": [
        "host_id",
        "generation_digest"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "generation_digest": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "description": "How the inventory was collected.",
      "properties": {
        "tool": {
          "type": "string",
          "description": "Collector tool name/version (e.g., 'derive-fwscan 0.1')."
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "class",
          "current_version",
          "update_mechanisms"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "description": "Stable identifier for the updatable component (e.g., ESRT firmware class GUID, or derived id for non-ESRT devices)."
          },
          "class": {
            "type": "string",
            "enum": [
              "uefi.esrt",
              "uefi.dbx",
              "cpu.microcode",
              "nvme",
              "bmc",
              "nic",
              "gpu",
              "usb-device",
              "other"
            ]
          },
          "label": {
            "type": "string",
            "description": "Human-friendly label (no secrets)."
          },
          "vendor": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "device_id_hash": {
            "type": "string",
            "description": "Privacy-safe stable identifier hash (e.g., blake3 of bus path + serial)."
          },
          "current_version": {
            "type": "string"
          },
          "minimum_required_version": {
            "type": "string",
            "description": "Optional policy floor (if known or declared by a generation)."
          },
          "update_mechanisms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "uefi-capsule",
                "uefi-file",
                "nvme-slot",
                "bmc-redfish",
                "bmc-ipmi",
                "vendor-tool",
                "manual"
              ]
            }
          },
          "capabilities": {
            "type": "object",
            "description": "Optional component capabilities (policy input).",
            "properties": {
              "supports_rollback": {
                "type": "boolean"
              },
              "requires_reboot": {
                "type": "boolean"
              },
              "requires_ac_power": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional policy tags (e.g., 'vendor:lenovo', 'fleet:edge')."
          },
          "uefi_esrt": {
            "type": "object",
            "description": "Optional ESRT-derived fields for class=uefi.esrt (coarse, privacy-safe).",
            "properties": {
              "fw_class_guid": {
                "type": "string",
                "description": "ESRT firmware class GUID (if known; may match component_id)."
              },
              "last_attempt_status": {
                "type": "integer",
                "minimum": 0,
                "description": "ESRT last attempt status code (numeric)."
              },
              "last_attempt_version": {
                "type": "string",
                "description": "Version reported for the last attempted capsule update (if provided)."
              },
              "last_attempt_error": {
                "type": "string",
                "description": "Firmware-provided human-readable error summary (if any)."
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
