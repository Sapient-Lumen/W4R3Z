{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD boot health report (v0)",
  "type": "object",
  "required": [
    "kind",
    "report_version",
    "generation_digest",
    "overall_status",
    "checks"
  ],
  "properties": {
    "kind": {"const": "boot-health-report"},
    "report_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "generation_digest": {"type": "string", "description": "Digest of the host generation / deployment object."},
    "be_name": {"type": "string"},

    "gate_policy_digest": {
      "type": "string",
      "description": "Optional digest pointer to the boot.health.gate.policy used for this run."
    },

    "overall_status": {"type": "string", "enum": ["pass", "fail", "degraded"]},

    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string"},
          "status": {"type": "string", "enum": ["pass", "fail", "skip", "warn"]},

          "class": {"type": "string", "enum": ["required", "wanted"], "description": "Optional classification (greenboot-style)."},
          "phase": {"type": "string", "enum": ["boot", "post_boot"], "description": "Optional phase for the check."},

          "message": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {"type": "string", "description": "Digest pointer to evidence objects (logs, verify results)."}
          }
        },
        "additionalProperties": true
      }
    },

    "meta": {
      "type": "object",
      "properties": {
        "generated_at": {"type": "string", "format": "date-time"},
        "correlation_id": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
