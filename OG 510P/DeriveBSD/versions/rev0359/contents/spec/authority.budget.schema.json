{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD authority budget (authority.budget) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "budget_version",
    "budget_id",
    "created_at",
    "scope",
    "derived_from",
    "dimensions"
  ],
  "properties": {
    "kind": {
      "const": "authority.budget"
    },
    "budget_version": {
      "type": "string",
      "const": "0.1"
    },
    "budget_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "required": [
        "host_id",
        "profile_id",
        "domain_kind",
        "domain_id",
        "service_id",
        "generation_id"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "domain_kind": {
          "type": "string",
          "enum": [
            "jail",
            "microvm",
            "process"
          ]
        },
        "domain_id": {
          "type": "string"
        },
        "service_id": {
          "type": "string"
        },
        "generation_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "derived_from": {
      "type": "object",
      "required": [
        "derive_unit_digest",
        "caproute_digest",
        "preopen_map_digest",
        "mount_view_digest",
        "devfs_view_plan_digest",
        "pki_profile_digest",
        "diagnostics_profile_digest"
      ],
      "properties": {
        "derive_unit_digest": {
          "type": "string"
        },
        "caproute_digest": {
          "type": "string"
        },
        "preopen_map_digest": {
          "type": "string"
        },
        "mount_view_digest": {
          "type": "string"
        },
        "devfs_view_plan_digest": {
          "type": "string"
        },
        "pki_profile_digest": {
          "type": "string"
        },
        "diagnostics_profile_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "required": [
        "filesystem",
        "network",
        "devices",
        "trust",
        "observability"
      ],
      "properties": {
        "filesystem": {
          "type": "object",
          "required": [
            "max_writable_roots",
            "max_read_roots",
            "forbid_ambient_roots",
            "allow_metadata_enumeration"
          ],
          "properties": {
            "max_writable_roots": {
              "type": "integer",
              "minimum": 0
            },
            "max_read_roots": {
              "type": "integer",
              "minimum": 0
            },
            "forbid_ambient_roots": {
              "type": "boolean"
            },
            "allow_metadata_enumeration": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "required": [
            "max_egress_destinations",
            "allow_raw_sockets",
            "max_inbound_listeners",
            "require_brokered_dns"
          ],
          "properties": {
            "max_egress_destinations": {
              "type": "integer",
              "minimum": 0
            },
            "allow_raw_sockets": {
              "type": "boolean"
            },
            "max_inbound_listeners": {
              "type": "integer",
              "minimum": 0
            },
            "require_brokered_dns": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "devices": {
          "type": "object",
          "required": [
            "allowed_classes",
            "require_timeboxed_leases"
          ],
          "properties": {
            "allowed_classes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "hid",
                  "usb-storage",
                  "camera",
                  "microphone",
                  "gpu",
                  "serial",
                  "smartcard",
                  "printer",
                  "scanner"
                ]
              },
              "uniqueItems": true
            },
            "require_timeboxed_leases": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "trust": {
          "type": "object",
          "required": [
            "max_trust_bundles",
            "allow_private_ca",
            "allow_shipped_ca_bundle"
          ],
          "properties": {
            "max_trust_bundles": {
              "type": "integer",
              "minimum": 0
            },
            "allow_private_ca": {
              "type": "boolean"
            },
            "allow_shipped_ca_bundle": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "observability": {
          "type": "object",
          "required": [
            "allow_trace",
            "allow_screen_or_remote_assist",
            "max_inspect_namespaces",
            "max_flight_recorder_classes"
          ],
          "properties": {
            "allow_trace": {
              "type": "boolean"
            },
            "allow_screen_or_remote_assist": {
              "type": "boolean"
            },
            "max_inspect_namespaces": {
              "type": "integer",
              "minimum": 0
            },
            "max_flight_recorder_classes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
