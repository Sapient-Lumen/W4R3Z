{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD disk layout apply receipt (disk.layout.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "applied_at",
    "plan",
    "outcome"
  ],
  "properties": {
    "kind": {
      "const": "disk-layout-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "receipt_id": {
      "type": "string",
      "description": "Stable id for the receipt (UUID recommended)."
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "host_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "description": "Opaque install/recovery session id (optional)."
    },
    "plan": {
      "type": "object",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "plan_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "serial": { "type": "string" },
        "wwn": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "table": { "type": "string", "enum": ["gpt"] },
        "gpt_digest": { "type": "string", "description": "Digest of normalized GPT state (optional)." },
        "partitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role", "size_bytes"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "type_guid": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "partition_guid": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "content": { "type": "string" },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "zfs": {
          "type": "object",
          "properties": {
            "pool_name": { "type": "string" },
            "pool_guid": { "type": "string" },
            "topology": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": ["success", "failed", "partial"]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "tooling": {
      "type": "object",
      "description": "Optional toolchain/tool versions used (gpart/zpool/bectl).",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
