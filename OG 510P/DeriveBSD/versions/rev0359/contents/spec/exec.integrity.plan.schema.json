{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD exec integrity plan (exec.integrity.plan) (v0.1)",
  "description": "Compiled execution-integrity activation plan. Binds authoritative policy to backend, target, and runtime composition.",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "created_at",
    "policy_digest",
    "backend",
    "target",
    "runtime_contract",
    "resolution"
  ],
  "properties": {
    "kind": {
      "const": "exec.integrity.plan"
    },
    "plan_version": {
      "type": "string",
      "const": "0.1"
    },
    "plan_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_digest": {
      "type": "string"
    },
    "backend": {
      "type": "string",
      "enum": [
        "mac_veriexec",
        "broker",
        "none"
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "generation_id"
      ],
      "properties": {
        "generation_id": {
          "type": "string"
        },
        "host_id": {
          "type": "string"
        },
        "fleet_scope": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runtime_contract": {
      "type": "object",
      "required": [
        "runtime_manifest_digest",
        "stratum_stack_digest",
        "mount_view_digest"
      ],
      "properties": {
        "runtime_manifest_digest": {
          "type": "string"
        },
        "stratum_stack_digest": {
          "type": "string"
        },
        "mount_view_digest": {
          "type": "string"
        },
        "component_origin": {
          "type": "string",
          "enum": [
            "native",
            "adapter",
            "mixed"
          ]
        },
        "abi_anchor_stratum_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": [
        "interpreters",
        "loaders",
        "libraries",
        "quarantined_bytes"
      ],
      "properties": {
        "interpreters": {
          "type": "string",
          "enum": [
            "resolve-within-mount-view"
          ]
        },
        "loaders": {
          "type": "string",
          "enum": [
            "abi-anchor-only"
          ]
        },
        "libraries": {
          "type": "string",
          "enum": [
            "mount-view-explicit-and-abi-anchor-only"
          ]
        },
        "quarantined_bytes": {
          "type": "string",
          "enum": [
            "deny-unless-explicit-exception"
          ]
        }
      },
      "additionalProperties": false
    },
    "compiled_manifest_digest": {
      "type": "string",
      "description": "Digest of backend-specific compiled manifest (if applicable)."
    },
    "compiled_rules_digest": {
      "type": "string",
      "description": "Digest of backend ruleset bundle (if applicable)."
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
