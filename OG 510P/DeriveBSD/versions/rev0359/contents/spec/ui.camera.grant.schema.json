{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI Camera Grant (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "subject",
    "device",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": { "const": "ui-camera-grant" },
    "grant_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "lease_id": { "type": "string" },
    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string" },
        "digest": { "type": "string" },
        "instance": { "type": "string" }
      },
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "required": ["selector"],
      "properties": {
        "selector": {
          "type": "string",
          "description": "Broker-defined selector (e.g., 'default', or a stable device id)."
        },
        "mode": { "type": "string", "enum": ["video", "photo", "any"] }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "requires_foreground": { "type": "boolean" },
        "indicator_required": { "type": "boolean" },
        "expires_at": { "type": "string" },
        "purpose": { "type": "string" },
        "redaction_profile_digest": { "type": "string" }
      },
      "additionalProperties": true
    },
    "issued_at": { "type": "string", "description": "ISO8601 time." },
    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": { "type": "string" },
        "alg": { "type": "string" },
        "sig": { "type": "string", "description": "Signature over canonical JSON bytes." }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
