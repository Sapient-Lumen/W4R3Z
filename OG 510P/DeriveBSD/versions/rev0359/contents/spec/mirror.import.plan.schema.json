{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD mirror kit import plan (mirror.import.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "source",
    "channels",
    "destination",
    "policy_digest"
  ],
  "properties": {
    "kind": { "const": "mirror.import.plan" },
    "plan_version": { "type": "string", "const": "0.1" },
    "plan_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },

    "requested_by": { "type": "string", "description": "Opaque operator/workflow id (optional)." },

    "source": {
      "type": "object",
      "description": "Where the mirror kit bytes come from (carrier is not trust).",
      "required": ["type", "ref"],
      "properties": {
        "type": { "type": "string", "enum": ["path", "bundle-digest", "url"] },
        "ref": { "type": "string" },
        "carrier_hint": { "type": "string", "description": "Human hint only (e.g., 'usb-ssd')." },
        "kit_digest": { "type": "string", "description": "If already known, digest of the kit container." }
      },
      "additionalProperties": false
    },

    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "intent": { "type": "string", "enum": ["stable", "staging", "dev", "custom"], "default": "stable" },
          "expect": {
            "type": "object",
            "description": "Optional expected snapshot constraints (policy may override).",
            "properties": {
              "min_snapshot": { "type": "string" },
              "max_snapshot": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },

    "destination": {
      "type": "object",
      "description": "Import target (quarantine-first).",
      "required": ["to"],
      "properties": {
        "to": { "type": "string", "enum": ["quarantine"] },
        "quarantine_id": { "type": "string", "description": "Optional quarantine namespace/dataset id." }
      },
      "additionalProperties": false
    },

    "verify": {
      "type": "object",
      "description": "Verification knobs; policy may tighten.",
      "properties": {
        "mode": { "type": "string", "enum": ["strict", "offline-accept-stale"], "default": "strict" },
        "max_metadata_staleness_seconds": { "type": "integer", "minimum": 0 },
        "allow_expired_metadata": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },

    "sandbox": {
      "type": "object",
      "description": "Execution isolation hint (applier may constrain).",
      "properties": {
        "mode": { "type": "string", "enum": ["none", "jail", "microvm"], "default": "jail" },
        "sandbox_profile": { "type": "string" }
      },
      "additionalProperties": false
    },

    "policy_digest": { "type": "string", "description": "Digest of the policy module(s) authorizing the import." },

    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
