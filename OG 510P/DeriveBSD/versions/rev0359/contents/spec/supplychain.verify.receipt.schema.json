{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD supplychain verification receipt (supplychain-verify-receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "authority_semantics",
    "layout_policy_digest",
    "artifact_digest",
    "result",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "supplychain-verify-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "layout_policy_digest": {
      "type": "string",
      "description": "Digest of the applied supplychain-layout-policy object."
    },
    "artifact_digest": {
      "type": "string",
      "description": "Digest of the artifact being verified (e.g., runtime bundle, store output)."
    },
    "consumed_attestations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Digests of DSSE/in-toto statement objects (or other evidence) used during verification."
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ],
      "description": "Overall verification result."
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "step": {
            "type": "string"
          },
          "attestation_digest": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "description": "Structured failure reasons for explainability."
    },
    "context": {
      "type": "object",
      "description": "Binds the receipt to higher-level DeriveBSD objects when relevant.",
      "properties": {
        "plan_digest": {
          "type": "string"
        },
        "policy_snapshot_digest": {
          "type": "string"
        },
        "policy_decision_digest": {
          "type": "string"
        },
        "build_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "issued_at": {
      "type": "string",
      "description": "ISO8601 time."
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authority_semantics": {
      "const": "workflow-verification-evidence-only",
      "description": "This receipt records workflow-verification evidence and does not itself authorize publication."
    }
  },
  "additionalProperties": false
}
