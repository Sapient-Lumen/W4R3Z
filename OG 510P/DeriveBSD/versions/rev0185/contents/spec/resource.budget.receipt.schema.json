{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD resource budget application receipt (resource.budget.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "at",
    "target",
    "profile_digest"
  ],
  "properties": {
    "kind": {
      "const": "resource.budget.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "host"
      ],
      "properties": {
        "host": {
          "type": "string"
        },
        "service_id": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "jail": {
          "type": "string"
        },
        "contract_handle_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "profile_digest": {
      "type": "string"
    },
    "compiled_backend": {
      "type": "object",
      "description": "Normalized backend rules actually applied.",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "rctl",
            "jail",
            "bhyve",
            "mixed"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "change_set_digest": {
      "type": "string"
    },
    "generation": {
      "type": "string"
    },
    "correlation": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
