{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD verified execution policy (exec-verify-policy) (v0.1)",
  "type": "object",
  "required": ["kind", "policy_version", "target", "mode", "fingerprints_digest"],
  "properties": {
    "kind": { "const": "exec-verify-policy" },
    "policy_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "target": {
      "type": "object",
      "required": ["scope"],
      "properties": {
        "scope": { "type": "string", "enum": ["host", "service"] },
        "service_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": ["disabled", "audit", "enforce"],
      "description": "Audit logs violations; enforce denies." 
    },
    "fingerprints_digest": {
      "type": "string",
      "description": "Digest of a derived fingerprint database built from closure evidence."
    },
    "inputs": {
      "type": "object",
      "properties": {
        "closure_manifest_digest": { "type": "string" },
        "closure_proof_digest": { "type": "string" },
        "policy_decision_record_digest": { "type": "string" }
      },
      "additionalProperties": false
    },
    "exceptions": {
      "type": "array",
      "description": "Explicit exceptions (should be rare) for operational recovery, bound to decision records.",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "meta": { "type": "object" }
  },
  "additionalProperties": false
}
