{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD transparency monitor snapshot (transparency.monitor.snapshot) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "snapshot_version",
    "snapshot_id",
    "created_at",
    "monitor_policy_digest",
    "log_uri",
    "tree_size"
  ],
  "properties": {
    "kind": {"const": "transparency.monitor.snapshot"},
    "snapshot_version": {"type": "string", "const": "0.1"},
    "snapshot_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},

    "monitor_policy_digest": {"type": "string"},
    "log_uri": {"type": "string"},

    "tree_size": {"type": "integer", "minimum": 0},
    "checkpoint": {"type": "string", "description": "Opaque signed checkpoint/tree-head."},
    "checkpoint_digest": {"type": "string"},

    "last_processed_index": {"type": "integer", "minimum": 0},
    "state_digest": {"type": "string", "description": "Digest of monitor local state (continuity handoff)."},

    "signature": {"type": "string"}
  },
  "additionalProperties": false
}
