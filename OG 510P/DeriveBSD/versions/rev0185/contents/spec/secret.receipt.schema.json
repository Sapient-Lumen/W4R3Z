{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD secret receipt (secret-receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "emitted_at",
    "action",
    "secret_id",
    "result"
  ],
  "properties": {
    "kind": { "const": "secret-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "receipt_id": { "type": "string" },
    "emitted_at": { "type": "string", "format": "date-time" },
    "action": { "type": "string", "enum": ["provision", "rotate", "revoke", "materialize", "fetch", "unseal"] },
    "secret_id": { "type": "string" },
    "policy_digest": { "type": "string" },
    "provider": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" }
      },
      "additionalProperties": true
    },
    "result": { "type": "string", "enum": ["ok", "failed", "skipped"] },
    "error": { "type": "string" },
    "lease": {
      "type": "object",
      "properties": {
        "lease_id": { "type": "string" },
        "renewable": { "type": "boolean" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "correlation": {
      "type": "object",
      "properties": {
        "change_id": { "type": "string" },
        "step": { "type": "string" }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Related event ids/digests in the structured journal."
    },
    "notes": { "type": "string" },
    "signature": { "type": "string" }
  },
  "additionalProperties": false
}
