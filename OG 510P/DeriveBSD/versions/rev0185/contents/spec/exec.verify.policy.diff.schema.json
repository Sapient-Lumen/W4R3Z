{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD verified execution policy diff (exec.verify.policy.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_policy",
    "to_policy",
    "mode_changed",
    "fingerprints_changed",
    "exceptions_added",
    "exceptions_removed",
    "exceptions_changed"
  ],
  "properties": {
    "kind": { "const": "exec.verify.policy.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation/domain).",
      "properties": {
        "host_id": { "type": "string" },
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "domain": { "type": "string", "description": "Optional compartment/domain identifier." },
        "from_generation": { "type": "string" },
        "to_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "from_policy": { "$ref": "#/$defs/policy_ref" },
    "to_policy": { "$ref": "#/$defs/policy_ref" },

    "mode_changed": { "$ref": "#/$defs/mode_change" },
    "fingerprints_changed": { "$ref": "#/$defs/digest_change" },

    "exceptions_added": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    },
    "exceptions_removed": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    },
    "exceptions_changed": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception_change" }
    },

    "summary": {
      "type": "object",
      "properties": {
        "exceptions_added": { "type": "integer", "minimum": 0 },
        "exceptions_removed": { "type": "integer", "minimum": 0 },
        "exceptions_changed": { "type": "integer", "minimum": 0 },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "policy_ref": {
      "type": "object",
      "description": "Reference to an exec-verify-policy object by digest (and optional human fields).",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "policy_version": { "type": "string" },
        "issued_at": { "type": "string", "format": "date-time" },
        "target": {
          "type": "object",
          "properties": {
            "scope": { "type": "string", "enum": ["host", "service"] },
            "service_id": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "mode_change": {
      "description": "Mode drift. Null means unchanged.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string", "enum": ["disabled", "audit", "enforce"] },
            "to": { "type": "string", "enum": ["disabled", "audit", "enforce"] }
          },
          "additionalProperties": false
        }
      ]
    },

    "digest_change": {
      "description": "Digest drift. Null means unchanged.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },

    "exception": {
      "type": "object",
      "required": ["path", "reason"],
      "properties": {
        "path": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },

    "exception_change": {
      "type": "object",
      "required": ["path", "from", "to"],
      "properties": {
        "path": { "type": "string" },
        "from": { "$ref": "#/$defs/exception" },
        "to": { "$ref": "#/$defs/exception" },
        "fields_changed": {
          "type": "array",
          "items": { "type": "string", "enum": ["reason"] }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
