{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD boot manifest diff (boot.manifest.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_manifest",
    "to_manifest",
    "components_added",
    "components_removed",
    "components_changed"
  ],
  "properties": {
    "kind": { "const": "boot.manifest.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation/deployment).",
      "properties": {
        "host_id": { "type": "string" },
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "from_generation": { "type": "string" },
        "to_generation": { "type": "string" },
        "deployment_ref_digest": {
          "type": "string",
          "description": "Digest of deployment.ref for the target generation (if known)."
        }
      },
      "additionalProperties": false
    },

    "from_manifest": { "$ref": "#/$defs/manifest_ref" },
    "to_manifest": { "$ref": "#/$defs/manifest_ref" },

    "components_added": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" },
      "description": "Components present in the target manifest but not in the source manifest."
    },
    "components_removed": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" },
      "description": "Components present in the source manifest but not in the target manifest."
    },
    "components_changed": {
      "type": "array",
      "items": { "$ref": "#/$defs/component_change" },
      "description": "Components present in both manifests but with changed fields (typically digest)."
    },

    "summary": {
      "type": "object",
      "description": "Optional human/policy summary fields.",
      "properties": {
        "added": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "manifest_ref": {
      "type": "object",
      "description": "Reference to a boot-manifest object by digest (and optional human fields).",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "manifest_version": { "type": "string" },
        "generation_id": { "type": "string" },
        "deployment_ref_digest": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "component": {
      "type": "object",
      "required": ["role", "digest"],
      "properties": {
        "role": {
          "type": "string",
          "description": "Component role (aligned with boot-manifest roles).",
          "enum": [
            "firmware-policy",
            "loader",
            "bootloader-config",
            "kernel",
            "kernel-modules",
            "initrd",
            "init",
            "activation",
            "cmdline-profile",
            "microcode",
            "shim",
            "other"
          ]
        },
        "digest": { "type": "string" },
        "path": { "type": "string", "description": "Optional path/label (metadata only)." },
        "format": { "type": "string", "description": "Optional format hint (efi, elf, tar, zfs, etc)." },
        "meta": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },

    "component_change": {
      "type": "object",
      "required": ["role", "from", "to"],
      "properties": {
        "role": { "type": "string" },
        "path_key": {
          "type": ["string", "null"],
          "description": "Optional stable key augmentation when multiple components share a role (e.g., role+path)."
        },
        "from": { "$ref": "#/$defs/component" },
        "to": { "$ref": "#/$defs/component" },
        "classification": {
          "type": "string",
          "enum": ["digest", "path", "format", "meta", "multiple", "other"]
        },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
