{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD export receipt (export.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "artifact",
    "policy_digest"
  ],
  "properties": {
    "kind": {
      "const": "export.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact": {
      "type": "object",
      "required": [
        "kind",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "policy_digest": {
      "type": "string",
      "description": "Digest of export.policy used."
    },
    "plan_digest": {
      "type": "string",
      "description": "Optional digest of bundle.plan that produced the exported artifact."
    },
    "lease_id": {
      "type": "string",
      "description": "Lease id authorizing this export attempt (portal/breakglass)."
    },
    "redaction": {
      "type": "object",
      "properties": {
        "transform_digest": {
          "type": "string"
        },
        "receipt_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "description": "Where the bytes went (metadata only).",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "file",
            "ticket-upload",
            "https-upload",
            "email",
            "removable-media",
            "oob"
          ]
        },
        "ticket_id": {
          "type": "string"
        },
        "recipient": {
          "type": "string"
        },
        "uri_hint": {
          "type": "string",
          "description": "Optional redacted URI hint (avoid embedding secrets)."
        }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "description": "Adapter-specific metadata (upload id, status codes).",
      "additionalProperties": true
    },
    "signature": {
      "type": "string"
    },
    "consent_receipt_digest": {
      "type": "string",
      "description": "Optional digest of consent.receipt authorizing this export (portal/TTY/OOB)."
    },
    "transport_receipt_digest": {
      "type": "string",
      "description": "Optional digest of transport.receipt describing the actual transport action."
    },
    "transparency_entry_digest": {
      "type": "string",
      "description": "Optional digest of export.transparency.entry proving a log entry for this export."
    }
  },
  "additionalProperties": false
}
