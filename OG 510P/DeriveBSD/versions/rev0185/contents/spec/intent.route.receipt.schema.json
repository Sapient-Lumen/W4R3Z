{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Intent Route Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "request_digest",
    "decision",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "intent-route-receipt"},
    "receipt_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "request_digest": {"type": "string"},

    "decision": {"type": "string", "enum": ["allow", "deny"]},

    "handler": {
      "type": "object",
      "description": "Present only on allow. Identifies the chosen handler component.",
      "properties": {
        "service_name": {"type": "string"},
        "service_digest": {"type": "string"},
        "instance_id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "policy_decision_digest": {"type": "string"},

    "portal_grant_digests": {"type": "array", "items": {"type": "string"}, "description": "Portal grants minted as part of routing (file picks, bookmark claims, etc.)."},

    "consent_digest": {"type": "string", "description": "Optional digest of a consent receipt if interactive choice occurred."},

    "issued_at": {"type": "string", "description": "ISO8601 time."},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
