{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD release authority policy (release.authority.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "policy_id",
    "created_at",
    "scope",
    "roles",
    "operations"
  ],
  "properties": {
    "kind": {"const": "release.authority.policy"},
    "policy_version": {"type": "string", "const": "0.1"},
    "policy_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},

    "scope": {
      "type": "object",
      "required": ["namespace", "channel"],
      "properties": {
        "namespace": {"type": "string"},
        "channel": {"type": "string"},
        "subject_name": {"type": "string"}
      },
      "additionalProperties": true
    },

    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "threshold", "keys"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["root", "publisher", "ops", "security", "rollout"]
          },
          "threshold": {"type": "integer", "minimum": 1},
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["key_id"],
              "properties": {
                "key_id": {"type": "string"},
                "public_key": {"type": "string", "description": "Optional inline public key material or reference."},
                "offline": {"type": "boolean", "description": "Hint that the key should be handled offline."}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    },

    "operations": {
      "type": "object",
      "required": ["publish", "halt", "resume"],
      "properties": {
        "publish": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["publisher", "ops", "security", "root"]},
          "description": "Roles required to publish a release (thresholds apply per role)."
        },
        "halt": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["ops", "security", "root"]}
        },
        "resume": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["ops", "security", "root"]}
        },
        "rotate_keys": {
          "type": "array",
          "items": {"type": "string", "enum": ["root", "security"]}
        }
      },
      "additionalProperties": false
    },

    "transparency": {
      "type": "object",
      "properties": {
        "require_transparency_entry": {"type": "boolean", "default": false},
        "allowed_log_uris": {"type": "array", "items": {"type": "string"}},
        "require_witness_quorum": {"type": "integer", "minimum": 0},
        "require_bundled_proof": {"type": "boolean"}
      },
      "additionalProperties": false
    },

    "monitoring": {
      "type": "object",
      "properties": {
        "require_monitor_clean": {"type": "boolean"},
        "monitor_policy_digests": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },

    "notes": {"type": "string"},

    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key_id", "sig"],
        "properties": {
          "key_id": {"type": "string"},
          "sig": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
