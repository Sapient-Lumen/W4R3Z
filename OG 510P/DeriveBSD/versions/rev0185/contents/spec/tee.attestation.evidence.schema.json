{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD TEE attestation evidence (tee.attestation.evidence) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "evidence_version",
    "evidence_id",
    "created_at",
    "subject",
    "tee_type",
    "report"
  ],
  "properties": {
    "kind": {"const": "tee-attestation-evidence"},
    "evidence_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "evidence_id": {"type": "string", "description": "Stable id (UUID recommended)."},
    "created_at": {"type": "string", "format": "date-time"},

    "subject": {
      "type": "object",
      "required": ["workload_id", "instance_id"],
      "properties": {
        "workload_id": {"type": "string"},
        "instance_id": {"type": "string"},
        "host_id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "tee_type": {"type": "string", "enum": ["sev-snp", "tdx", "arm-cca", "nitro", "other"]},

    "report": {
      "type": "object",
      "required": ["format", "report_digest"],
      "properties": {
        "format": {"type": "string", "description": "Vendor evidence format (sev-snp-report, tdx-quote, cca-token, ...)."},
        "report_digest": {"type": "string", "description": "Digest of raw evidence bytes stored separately (CAS)."},
        "cert_chain_digests": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },

    "bound_pubkey_jwk": {
      "type": "object",
      "description": "Optional ephemeral public key generated inside the TEE and bound into evidence (JWK)."
    },

    "bound_report_data_digest": {
      "type": "string",
      "description": "Digest of nonce/reportdata bound into the evidence (if used)."
    },

    "measured_init_data_digest": {
      "type": "string",
      "description": "Digest of measured init-data / guest policy blob (if applicable)."
    }
  },
  "additionalProperties": false
}
