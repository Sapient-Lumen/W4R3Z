{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD publisher identity receipt (publisher.identity.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "subject",
    "method",
    "identity"
  ],
  "properties": {
    "kind": {
      "const": "publisher.identity.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "description": "Digest of the signed subject (sha256:... recommended)."
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "subject_kind": {
          "type": "string",
          "description": "artifact, bundle, closure, etc."
        }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "string",
      "enum": [
        "sigstore-keyless",
        "x509",
        "ssh",
        "gpg",
        "custom"
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "issuer",
        "subject"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "description": "OIDC issuer or identity provider."
        },
        "subject": {
          "type": "string",
          "description": "Provider-defined subject (sub)."
        },
        "email": {
          "type": "string"
        },
        "repo": {
          "type": "string",
          "description": "Optional repo/workflow identity (e.g., org/repo)."
        },
        "workflow": {
          "type": "string"
        },
        "service_account": {
          "type": "string"
        },
        "claims": {
          "type": "object",
          "description": "Optional additional claims (policy-defined).",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "certificate": {
      "type": "object",
      "properties": {
        "leaf_cert_digest": {
          "type": "string",
          "description": "Digest of the leaf certificate bytes."
        },
        "chain_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "not_after": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "transparency": {
      "type": "object",
      "properties": {
        "log_kind": {
          "type": "string",
          "enum": [
            "rekor",
            "sigsum",
            "custom"
          ]
        },
        "log_id": {
          "type": "string"
        },
        "entry_uuid": {
          "type": "string"
        },
        "log_index": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_digest": {
          "type": "string"
        },
        "inclusion_proof_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "verifier": {
          "type": "string",
          "description": "Verifier identity or toolchain digest."
        },
        "decision": {
          "type": "string",
          "enum": [
            "verified",
            "unverified",
            "failed"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sigstore_bundle_digest": {
      "type": "string",
      "description": "Optional digest of a mirrored Sigstore bundle wrapper (kind sigstore.bundle) for offline verification."
    }
  },
  "additionalProperties": false
}
