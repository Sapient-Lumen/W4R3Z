{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD compiled state database (statedb) (v0)",
  "type": "object",
  "required": [
    "kind",
    "statedb_version",
    "generation_digest",
    "volumes"
  ],
  "properties": {
    "kind": { "const": "statedb" },
    "statedb_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "generation_digest": {
      "type": "string",
      "description": "Digest of the host generation/deployment object that produced this statedb."
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dataset",
          "persistence",
          "schema"
        ],
        "properties": {
          "id": { "type": "string", "description": "Stable volume id." },
          "description": { "type": "string" },
          "owner": {
            "type": "object",
            "properties": {
              "service_id": { "type": "string" },
              "workload_id": { "type": "string" }
            },
            "additionalProperties": false
          },
          "dataset": {
            "type": "string",
            "description": "ZFS dataset or zvol identifier (e.g., zroot/vm/foo/state)."
          },
          "mountpoint": { "type": "string" },
          "persistence": {
            "type": "string",
            "enum": ["ephemeral", "persistent"],
            "description": "Whether the volume is expected to persist across generation switches."
          },
          "encryption": {
            "type": "object",
            "properties": {
              "required": { "type": "boolean" },
              "root": { "type": "string", "description": "Encryption root dataset (if applicable)." }
            },
            "additionalProperties": false
          },
          "schema": {
            "type": "object",
            "required": ["id", "version"],
            "properties": {
              "id": { "type": "string", "description": "Schema identifier (e.g., com.example.app.db)." },
              "version": { "type": "string", "description": "Expected schema version (semver-like string)." },
              "min_compatible": { "type": "string", "description": "Optional minimum compatible version for read-only access." }
            },
            "additionalProperties": false
          },
          "snapshot_policy": {
            "type": "object",
            "properties": {
              "pre_upgrade_snapshot": { "type": "boolean" },
              "hold_tag": { "type": "string", "description": "ZFS hold tag to use for pre-upgrade snapshots." },
              "retention": { "type": "string", "description": "Operator policy handle (e.g., keep-7d, keep-30)." }
            },
            "additionalProperties": false
          },
          "replication": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "mode": { "type": "string", "enum": ["zfs-send", "other"] },
              "targets": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
