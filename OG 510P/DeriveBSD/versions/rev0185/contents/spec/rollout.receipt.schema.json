{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD rollout receipt (rollout.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "rollout_policy_digest",
    "release_capsule_digest",
    "decision"
  ],
  "properties": {
    "kind": {"const": "rollout.receipt"},
    "receipt_version": {"type": "string", "const": "0.1"},
    "receipt_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "rollout_policy_digest": {"type": "string"},
    "release_capsule_digest": {"type": "string"},
    "device": {
      "type": "object",
      "description": "Prefer hashes; avoid raw identifiers.",
      "properties": {
        "device_id_hash": {"type": "string"},
        "cohort_id": {"type": "string"},
        "cohort_hint": {"type": "string"}
      },
      "additionalProperties": false
    },
    "phase": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "percent": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "string",
      "enum": ["offer_update", "hold_back", "blocked"]
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "in_phase",
        "out_of_phase",
        "freeze_window",
        "health_gate_failed",
        "policy_blocked",
        "manual_override"
      ]
    },
    "notes": {"type": "string"},
    "signature": {"type": "string", "description": "Optional signature over the canonicalized receipt."}
  },
  "additionalProperties": false
}
