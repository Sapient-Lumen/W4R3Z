{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD content import receipt (content.import.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_digest",
    "policy_digest",
    "subject",
    "result"
  ],
  "properties": {
    "kind": { "const": "content.import.receipt" },
    "receipt_version": { "type": "string", "const": "0.1" },
    "receipt_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },

    "plan_digest": { "type": "string" },
    "policy_digest": { "type": "string" },

    "subject": {
      "type": "object",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "mime": { "type": "string" },
        "filename": { "type": "string" }
      },
      "additionalProperties": false
    },

    "origin": {
      "description": "Resolved origin record or reference.",
      "oneOf": [
        { "$ref": "content.origin.schema.json" },
        {
          "type": "object",
          "required": ["origin_id"],
          "properties": {
            "origin_id": { "type": "string" },
            "origin_digest": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },

    "quarantine": {
      "type": "object",
      "description": "If a quarantine label/xattr was applied or cleared.",
      "properties": {
        "state": { "type": "string", "enum": ["applied", "preserved", "cleared", "none"] },
        "origin_id": { "type": "string" },
        "origin_digest": { "type": "string" },
        "label": { "type": "string", "description": "Opaque label stored in filesystem metadata (implementation-defined)." }
      },
      "additionalProperties": false
    },

    "operations": {
      "type": "array",
      "description": "Per-step results.",
      "items": {
        "type": "object",
        "required": ["op", "status"],
        "properties": {
          "op": { "type": "string" },
          "status": { "type": "string", "enum": ["ok", "deny", "fail"] },
          "tool": { "type": "string" },
          "output_digest": { "type": "string" },
          "log_digest": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "outputs": {
      "type": "array",
      "description": "Imported outputs (may be multiple for archive extraction).",
      "items": {
        "type": "object",
        "required": ["digest"],
        "properties": {
          "digest": { "type": "string" },
          "path": { "type": "string" },
          "mime": { "type": "string" },
          "labels": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },

    "result": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "deny", "fail"] },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },

    "portal_session_id": { "type": "string" },
    "lease_id": { "type": "string" }
  },
  "additionalProperties": false
}
