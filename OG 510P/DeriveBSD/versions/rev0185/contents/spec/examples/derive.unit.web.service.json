{
  "kind": "derive.unit",
  "unit_version": "0.1",
  "id": "svc.web.frontend",
  "labels": {
    "team": "edge",
    "tier": "frontend"
  },
  "rootfs": {
    "tree_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "format": "zfs-dataset",
    "transport_hint": "lazy-mount"
  },
  "exec": {
    "argv": [
      "/usr/local/bin/web",
      "--config",
      "/etc/web/config.json"
    ],
    "env": {
      "TZ": "UTC"
    },
    "user": "_web",
    "group": "_web"
  },
  "strata": [
    "base:sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "vendor:sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
  ],
  "mounts": [
    {
      "name": "etc",
      "mode": "ro",
      "target": "/etc/web",
      "source": "config.snapshot"
    },
    {
      "name": "state",
      "mode": "rw",
      "target": "/var/lib/web",
      "source": "state.web"
    },
    {
      "name": "cache",
      "mode": "cache",
      "target": "/var/cache/web"
    }
  ],
  "state": {
    "datasets": [
      {
        "name": "state.web",
        "schema_version": "2026-02-01",
        "durability": "persistent",
        "backup_class": "required"
      }
    ]
  },
  "promises": [
    "net:egress(web)",
    "fs:read(config)",
    "fs:write(state)",
    "ipc:portal(client)"
  ],
  "health": {
    "http": {
      "path": "/healthz",
      "port": 8080
    }
  },
  "evidence_hooks": {
    "events": true,
    "logs": "structured",
    "redaction_class": "service"
  },
  "diagnostics": {
    "inspect": true,
    "flight_recorder": {
      "enabled": true,
      "buffer_bytes": 8388608,
      "max_window_seconds": 120,
      "categories": [
        "rpc",
        "retries",
        "latency"
      ]
    },
    "redaction_class": "internal"
  },
  "pki": {
    "trust_bundle_digests": [
      "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    ],
    "identity_refs": [
      "service:web:tls"
    ],
    "ca_bundle": {
      "mode": "fd"
    }
  }
}
