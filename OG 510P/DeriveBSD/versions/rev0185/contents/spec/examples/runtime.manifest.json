{
  "kind": "microvm",
  "manifest_version": "0.1",
  "artifact": {
    "digest": "sha256:..."
  },
  "backend": {
    "preferred": "bhyve",
    "compat": [
      "bhyve"
    ]
  },
  "resources": {
    "cpu": 1,
    "mem_mb": 256
  },
  "devices": {
    "virtio": {
      "net": true,
      "blk": true,
      "rng": true,
      "console": true
    },
    "passthrough": []
  },
  "network": {
    "attachments": [
      {
        "mode": "nat",
        "name": "wan0",
        "pf_anchor": "derivebsd/vm/edge-nginx"
      }
    ]
  },
  "injection": {
    "config": {
      "channel": "metadata-disk",
      "schema": "derivebsd/meta-v1"
    },
    "secrets": {
      "channel": "virtio-console",
      "schema": "derivebsd/secrets-v1"
    }
  },
  "secrets_contract": {
    "required": [
      "tls.crt",
      "tls.key"
    ],
    "optional": []
  },
  "update": {
    "strategy": "replace-image",
    "restart_policy": "always"
  }
}
