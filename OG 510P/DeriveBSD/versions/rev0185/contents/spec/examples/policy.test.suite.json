{
  "kind": "policy-test-suite",
  "suite_version": "0.1",
  "suite_id": "7e8d3b83-1f30-4b9d-8f5a-8b987f2b0c9a",
  "created_at": "2026-02-27T14:00:00Z",
  "target": {
    "kind": "net.egress.policy",
    "ref": "policy/net/egress/base.json",
    "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "notes": "Example suite: deny-by-default + one intended allow."
  },
  "engine": {
    "name": "derive-policy",
    "version": "0.1.0",
    "profile": "ci"
  },
  "cases": [
    {
      "case_id": "deny-default-no-grant",
      "title": "Deny egress when no grant/lease exists",
      "request": {
        "operation": "net.egress",
        "dest": {"host": "example.com", "port": 443, "proto": "tcp"},
        "subject": {"unit": "svc.web", "pid": 4242}
      },
      "context": {
        "leases": [],
        "channel": "stable"
      },
      "expected": {"decision": "deny"},
      "tags": ["invariant", "deny-by-default"]
    },
    {
      "case_id": "allow-with-lease",
      "title": "Allow egress when an explicit lease grants the class",
      "request": {
        "operation": "net.egress",
        "dest": {"host": "api.example.com", "port": 443, "proto": "tcp"},
        "subject": {"unit": "svc.web", "pid": 4242}
      },
      "context": {
        "leases": [
          {"lease_id": "lease-123", "class": "web-egress", "expires_at": "2026-02-27T15:00:00Z"}
        ],
        "policy_profile": "default"
      },
      "expected": {"decision": "allow"},
      "tags": ["intended-allow"]
    },
    {
      "case_id": "deny-expired-lease",
      "title": "Expired leases must not authorize",
      "request": {
        "operation": "net.egress",
        "dest": {"host": "api.example.com", "port": 443, "proto": "tcp"},
        "subject": {"unit": "svc.web", "pid": 4242}
      },
      "context": {
        "leases": [
          {"lease_id": "lease-old", "class": "web-egress", "expires_at": "2026-02-27T00:00:00Z"}
        ]
      },
      "expected": {"decision": "deny"},
      "tags": ["invariant", "lease-revocation"]
    }
  ],
  "mutation": {
    "enabled": true,
    "operators": ["flip-effect", "widen-selector"],
    "max_mutants": 50,
    "seed": 42
  }
}
