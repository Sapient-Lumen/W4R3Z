{
  "kind": "attestation-admission-policy",
  "policy_version": "0.1",
  "policy_id": "a30d4f4f-79f2-4ebd-9f07-8e6c6a5e7d3f",
  "created_at": "2026-02-27T13:00:00Z",
  "rules": [
    {
      "action": "issue-workload-identity",
      "selector": {
        "fleet": "prod",
        "host_class": "compute",
        "match_labels": {
          "region": "us-east",
          "tier": "1"
        }
      },
      "requirement_ref": "sha256:attreq-prod-compute-v3",
      "notes": "Require fresh pass/degraded attestation receipt before SPIFFE-style identity issuance."
    },
    {
      "action": "unseal-secrets",
      "selector": {
        "fleet": "prod",
        "host_class": "secrets"
      },
      "requirement_ref": "sha256:attreq-secrets-strict-v1"
    },
    {
      "action": "allow-remote-assist",
      "selector": {
        "fleet": "prod"
      },
      "requirement_ref": "sha256:attreq-prod-ops-v2",
      "notes": "Remote assistance requires verified posture; breakglass overrides are separately receipted."
    }
  ]
}
