{
  "kind": "release.authority.policy",
  "policy_version": "0.1",
  "policy_id": "auth-prod-stable-1",
  "created_at": "2026-02-26T00:05:00Z",
  "scope": {
    "namespace": "prod",
    "channel": "stable",
    "subject_name": "derivebsd-host"
  },
  "roles": [
    {
      "role": "root",
      "threshold": 2,
      "keys": [
        {"key_id": "root-k1", "offline": true},
        {"key_id": "root-k2", "offline": true},
        {"key_id": "root-k3", "offline": true}
      ]
    },
    {
      "role": "publisher",
      "threshold": 1,
      "keys": [
        {"key_id": "pub-k1"},
        {"key_id": "pub-k2"}
      ]
    },
    {
      "role": "ops",
      "threshold": 1,
      "keys": [
        {"key_id": "ops-k1"}
      ]
    }
  ],
  "operations": {
    "publish": ["publisher"],
    "halt": ["ops"],
    "resume": ["ops"],
    "rotate_keys": ["root"]
  },
  "transparency": {
    "require_transparency_entry": true,
    "allowed_log_uris": ["https://rekor.sigstore.dev"],
    "require_witness_quorum": 2,
    "require_bundled_proof": true
  },
  "monitoring": {
    "require_monitor_clean": true,
    "monitor_policy_digests": ["sha256:monitorpolicy..."]
  },
  "signatures": [
    {"key_id": "root-k1", "sig": "opaque:signature..."},
    {"key_id": "root-k2", "sig": "opaque:signature..."}
  ]
}
