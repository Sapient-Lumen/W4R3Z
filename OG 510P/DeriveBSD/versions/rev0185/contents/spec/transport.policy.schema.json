{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD transport policy (transport.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "policy_id",
    "created_at",
    "rules"
  ],
  "properties": {
    "kind": {
      "const": "transport.policy"
    },
    "policy_version": {
      "type": "string",
      "const": "0.1"
    },
    "policy_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "transport_kind"
        ],
        "properties": {
          "transport_kind": {
            "type": "string",
            "enum": [
              "jira",
              "servicenow",
              "https-upload",
              "sftp",
              "email",
              "removable-media",
              "oob",
              "custom"
            ]
          },
          "allowed_domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Allowed destination domains/hosts (patterns/realms, policy-defined)."
          },
          "allowed_realms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ticketing realms/instances (e.g., jira cloud site, ServiceNow instance)."
          },
          "require_tls": {
            "type": "boolean",
            "default": true
          },
          "require_ticket": {
            "type": "boolean",
            "default": true
          },
          "ticket_pattern": {
            "type": "string"
          },
          "max_size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "auth_mode": {
            "type": "string",
            "enum": [
              "none",
              "basic",
              "api-token",
              "oauth2",
              "mTLS",
              "agent"
            ],
            "default": "agent",
            "description": "Authentication mode (no secrets)."
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
