{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD store garbage-collection plan (store.gc.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "scope",
    "roots",
    "constraints",
    "policy_digest",
    "candidates"
  ],
  "properties": {
    "kind": { "const": "store.gc.plan" },
    "plan_version": { "type": "string", "const": "0.1" },
    "plan_id": { "type": "string", "description": "Stable id for this plan (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "requested_by": { "type": "string", "description": "Opaque operator/workflow id (optional)." },

    "scope": {
      "type": "object",
      "description": "Where this GC applies (store + related derived state).",
      "required": ["store_id"],
      "properties": {
        "host_id": { "type": "string" },
        "store_id": { "type": "string", "description": "Store namespace id (e.g., host store vs builder store)." },
        "include_kinds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional filter over candidate kinds (store-object, zfs-snapshot, boot-environment, evidence-segment, ...)."
        }
      },
      "additionalProperties": false
    },

    "roots": {
      "type": "object",
      "description": "The root set that defines liveness (pins/roots/generations).",
      "required": ["root_refs"],
      "properties": {
        "root_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/root_ref" }
        },
        "roots_snapshot_digest": {
          "type": "string",
          "description": "Optional digest/id of a separately stored root snapshot (if captured)."
        }
      },
      "additionalProperties": false
    },

    "constraints": {
      "type": "object",
      "description": "Operator/policy knobs; policy may tighten or override.",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["dry-run", "apply"], "default": "dry-run" },
        "max_delete_bytes": { "type": "integer", "minimum": 0, "description": "Hard cap on bytes to delete in one run (0 = no cap)." },
        "min_free_bytes": { "type": "integer", "minimum": 0, "description": "Target minimum free bytes after GC (best-effort)." },
        "keep_generations": { "type": "integer", "minimum": 1, "description": "Best-effort retention: keep at least N generations per profile (if applicable)." }
      },
      "additionalProperties": false
    },

    "policy_digest": { "type": "string", "description": "Digest of the policy module(s) authorizing the GC plan." },

    "candidates": {
      "type": "array",
      "description": "Candidate deletions with reasons (stable review surface).",
      "items": { "$ref": "#/$defs/candidate" }
    },

    "expect": {
      "type": "object",
      "description": "Optional summary of expected effect.",
      "properties": {
        "candidate_count": { "type": "integer", "minimum": 0 },
        "reclaim_bytes_est": { "type": "integer", "minimum": 0 },
        "store_bytes_before": { "type": "integer", "minimum": 0 },
        "store_free_bytes_before": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "notes": { "type": "string" }
  },
  "$defs": {
    "root_ref": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "description": "root kind (profile-generation, pin, boot-environment, lease, hold, ...)." },
        "ref": { "type": "string" },
        "digest": { "type": "string" },
        "reason": { "type": "string" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "candidate": {
      "type": "object",
      "required": ["target_kind", "ref", "reason"],
      "properties": {
        "target_kind": { "type": "string" },
        "ref": { "type": "string" },
        "digest": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" },
        "protected_by": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional pointers to roots/pins/leases that prevented deletion (if candidate is retained)."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
