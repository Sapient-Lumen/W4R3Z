{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD resource violation event (resource.violation.event) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "event_version",
    "event_id",
    "at",
    "target",
    "resource",
    "observed",
    "limit"
  ],
  "properties": {
    "kind": {
      "const": "resource.violation.event"
    },
    "event_version": {
      "type": "string",
      "const": "0.1"
    },
    "event_id": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "host"
      ],
      "properties": {
        "host": {
          "type": "string"
        },
        "service_id": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "jail": {
          "type": "string"
        },
        "pid": {
          "type": "integer"
        },
        "contract_handle_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "string"
    },
    "observed": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "limit": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "action_taken": {
      "type": "string",
      "enum": [
        "none",
        "logged",
        "denied",
        "signaled",
        "throttled",
        "killed"
      ],
      "default": "logged"
    },
    "receipt_digest": {
      "type": "string",
      "description": "Budget receipt that established the active rule, if known."
    },
    "message": {
      "type": "string"
    },
    "correlation": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
