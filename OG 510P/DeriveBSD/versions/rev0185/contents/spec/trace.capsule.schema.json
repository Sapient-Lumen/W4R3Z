{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Trace Capsule (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "capsule_version",
    "grant_digest",
    "window",
    "outputs",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "trace-capsule"},
    "capsule_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "grant_digest": {"type": "string", "description": "Digest of canonical trace.stream.grant bytes."},

    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string"},
        "end": {"type": "string"}
      },
      "additionalProperties": false
    },

    "template_digest": {"type": "string", "description": "Optional digest of the trace template/script bundle used."},

    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "digest"],
        "properties": {
          "type": {"type": "string", "enum": ["logs", "audit", "dtrace", "metrics", "pcap", "other"]},
          "digest": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },

    "redaction": {
      "type": "object",
      "description": "Optional redaction proof bundle. When present, transform/receipts SHOULD match the grant redaction profile.",
      "properties": {
        "transform_digest": {"type": "string"},
        "receipt_digests": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },

    "summary": {
      "type": "object",
      "description": "Optional quick-triage summary. Keep small; store heavy data elsewhere and reference digests.",
      "additionalProperties": true
    },

    "context": {
      "type": "object",
      "properties": {
        "plan_digest": {"type": "string"},
        "policy_decision_digest": {"type": "string"},
        "incident_id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "issued_at": {"type": "string"},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
