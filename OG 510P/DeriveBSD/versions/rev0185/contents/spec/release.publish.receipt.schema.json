{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD release publish receipt (release.publish.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "release_capsule_digest",
    "authority_policy_digest",
    "decision"
  ],
  "properties": {
    "kind": {"const": "release.publish.receipt"},
    "receipt_version": {"type": "string", "const": "0.1"},
    "receipt_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},

    "release_capsule_digest": {"type": "string"},
    "authority_policy_digest": {"type": "string"},
    "channel_view_digest": {"type": "string"},

    "rollout_policy_digest": {"type": "string"},
    "release_transparency_entry_digest": {"type": "string"},

    "monitor_snapshots": {
      "type": "array",
      "description": "Optional digests of monitor snapshots that were checked prior to publication.",
      "items": {"type": "string"}
    },

    "decision": {"type": "string", "enum": ["published", "rejected"]},
    "reason": {"type": "string"},

    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key_id", "sig"],
        "properties": {
          "key_id": {"type": "string"},
          "sig": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
