{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD TEE attestation reference values (tee.attestation.reference) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "reference_version",
    "created_at",
    "scope",
    "tee_types",
    "accepted_measurements",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "tee-attestation-reference"
    },
    "reference_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "reference_id": {
      "type": "string",
      "description": "Stable id (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "selector": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "tee_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "sev-snp",
          "tdx",
          "arm-cca",
          "nitro",
          "other"
        ]
      }
    },
    "accepted_measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tee_type",
          "measurement_kind",
          "digest"
        ],
        "properties": {
          "tee_type": {
            "type": "string",
            "enum": [
              "sev-snp",
              "tdx",
              "arm-cca",
              "nitro",
              "other"
            ]
          },
          "measurement_kind": {
            "type": "string",
            "description": "Launch measurement / MR* kind (e.g., sev_snp_launch, tdx_mrtd, tdx_mrconfigid, cca_rim, ...)."
          },
          "digest": {
            "type": "string",
            "description": "Digest of expected measurement bytes (e.g., sha256:...)."
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "tcb_requirements": {
      "type": "object",
      "description": "Minimum acceptable TCB/SVN constraints (vendor-specific fields collapsed here).",
      "properties": {
        "min_security_version": {
          "type": "integer",
          "minimum": 0
        },
        "allow_debug": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "accepted_init_data_digests": {
      "type": "array",
      "description": "Optional digests of measured init-data / guest policy blobs.",
      "items": {
        "type": "string"
      }
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
