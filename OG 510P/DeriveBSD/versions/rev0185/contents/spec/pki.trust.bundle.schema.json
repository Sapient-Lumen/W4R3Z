{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD PKI Trust Bundle (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "bundle_version",
    "bundle_id",
    "anchors",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "pki-trust-bundle"
    },
    "bundle_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "bundle_id": {
      "type": "string",
      "description": "Stable identifier for this trust bundle (e.g. trust domain name or org-scoped id)."
    },
    "intended_use": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "tls-client",
          "tls-server",
          "mtls-workload",
          "ssh-ca",
          "pkg-signing",
          "code-signing",
          "other"
        ]
      }
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "digest",
          "format"
        ],
        "properties": {
          "digest": {
            "type": "string",
            "description": "Digest of the trust anchor material stored in the Derive store (format-specific canonical bytes)."
          },
          "format": {
            "type": "string",
            "enum": [
              "pem",
              "der",
              "jwk",
              "spki"
            ]
          },
          "label": {
            "type": "string",
            "description": "Optional human label for UIs/review tools."
          },
          "fingerprint": {
            "type": "string",
            "description": "Optional X.509 fingerprint (informational; digest is authoritative)."
          },
          "constraints": {
            "type": "object",
            "properties": {
              "not_before": {
                "type": "string",
                "format": "date-time"
              },
              "not_after": {
                "type": "string",
                "format": "date-time"
              },
              "name_constraints": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Optional name constraints (e.g., DNS suffixes) enforced by verifiers/adapters."
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "distribution": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "fleet",
            "cluster",
            "host",
            "unit"
          ]
        },
        "selectors": {
          "type": "object",
          "description": "Optional label selectors (fleet/cluster/unit matching) for where this bundle applies."
        }
      },
      "additionalProperties": false
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
