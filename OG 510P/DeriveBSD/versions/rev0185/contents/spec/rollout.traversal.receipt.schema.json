{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD rollout traversal receipt (rollout.traversal.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "host_id_hash",
    "rollout_graph_digest",
    "from_node",
    "to_node",
    "decision"
  ],
  "properties": {
    "kind": { "const": "rollout.traversal.receipt" },
    "receipt_version": { "type": "string", "const": "0.1" },

    "receipt_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },

    "host_id_hash": { "type": "string" },
    "rollout_graph_digest": { "type": "string" },

    "rollout_assignment_digest": { "type": "string" },
    "rollout_policy_digest": { "type": "string" },

    "from_node": { "type": "string" },
    "to_node": { "type": "string" },

    "decision": { "type": "string", "enum": ["take_edge", "hold", "blocked"] },

    "reasons": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional short reason strings for explainability (stable enums preferred)."
    },

    "validated": {
      "type": "object",
      "description": "Optional record of validated prerequisites (digests only).",
      "properties": {
        "required_receipt_digests": { "type": "array", "items": { "type": "string" } },
        "required_evidence_kinds": { "type": "array", "items": { "type": "string" } },
        "boot_gate_policy_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "notes": { "type": "string" },
    "signature": { "type": "string", "description": "Optional signature over the canonicalized receipt." }
  },
  "additionalProperties": false
}
