{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD lease issue receipt (lease.issue.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "host",
    "lane",
    "lease_id",
    "target",
    "outcome"
  ],
  "properties": {
    "kind": {"const": "lease.issue.receipt"},
    "receipt_version": {"type": "string", "const": "0.1"},

    "receipt_id": {"type": "string", "description": "Stable id for this issuance attempt (UUID recommended)."},
    "created_at": {"type": "string", "format": "date-time"},

    "host": {
      "type": "object",
      "required": ["host_id", "generation_digest"],
      "properties": {
        "host_id": {"type": "string"},
        "generation_digest": {"type": "string"},
        "boot_id": {"type": "string"},
        "domain": {"type": "string", "description": "Optional compartment/domain identifier."}
      },
      "additionalProperties": false
    },

    "lane": {
      "type": "string",
      "description": "Authority lane that issued the lease (export, secrets, tracing, breakglass, ...)."
    },

    "lease_id": {"type": "string", "description": "Cross-lane lease identifier."},

    "outcome": {
      "type": "string",
      "enum": ["issued", "renewed", "denied"],
      "description": "Issuance outcome. 'denied' captures an issuance attempt that produced no usable authority."
    },

    "subject": {
      "type": "object",
      "description": "Selectors describing who the lease would authorize (service_id, vm_id, jail_id, operator, ...).",
      "additionalProperties": true
    },

    "target": {
      "type": "object",
      "description": "Pointer to the lane object that grants authority (portal.grant, secret-grant, trace.session, ...).",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string"},
        "id": {"type": "string"},
        "digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "lease": {
      "type": "object",
      "description": "Lease timebox and scope summary (metadata-only; do not embed sensitive payloads).",
      "required": ["issued_at", "expires_at"],
      "properties": {
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "purpose": {"type": "string"},
        "scope_summary": {
          "type": "object",
          "description": "Non-sensitive summary of what is authorized.",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },

    "envelope_digest": {
      "type": "string",
      "description": "Optional digest of a lease.envelope object created for this lease (cross-lane join metadata)."
    },

    "policy_ref": {
      "type": "object",
      "description": "Optional pointer to the policy object consulted during issuance (e.g., export.policy, breakglass.policy).",
      "required": ["kind", "digest"],
      "properties": {
        "kind": {"type": "string"},
        "digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "approvals": {
      "type": "array",
      "description": "Optional approvals/acknowledgements for issuance (2-person integrity, operator consent, etc.).",
      "items": {
        "type": "object",
        "required": ["approver", "at"],
        "properties": {
          "approver": {"type": "string"},
          "method": {"type": "string"},
          "at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },

    "reasons": {
      "type": "array",
      "description": "Optional machine-readable reasons (especially useful for 'denied').",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"}
        },
        "additionalProperties": false
      }
    },

    "notes": {"type": "string"},

    "signature": {
      "type": "object",
      "description": "Optional signature over this receipt envelope.",
      "properties": {
        "sig_alg": {"type": "string"},
        "public_key_hint": {"type": "string"},
        "signature": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"outcome": {"enum": ["issued", "renewed"]}}
      },
      "then": {
        "required": ["lease"]
      }
    }
  ],
  "additionalProperties": false
}
