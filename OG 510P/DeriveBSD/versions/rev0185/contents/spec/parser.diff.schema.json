{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD parser diff (parser.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from",
    "to",
    "parsers_added",
    "parsers_removed",
    "parsers_changed"
  ],
  "properties": {
    "kind": { "const": "parser.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "from": { "$ref": "#/$defs/ref" },
    "to": { "$ref": "#/$defs/ref" },

    "parsers_added": { "type": "array", "items": { "$ref": "#/$defs/parser" } },
    "parsers_removed": { "type": "array", "items": { "$ref": "#/$defs/parser" } },
    "parsers_changed": { "type": "array", "items": { "$ref": "#/$defs/parser_change" } },

    "classifications": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "type": "string" },
        "digest": { "type": "string" },
        "registry_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "parser": {
      "$ref": "https://derivebsd.local/spec/parser.registry.schema.json#/$defs/parser"
    },

    "parser_change": {
      "type": "object",
      "required": ["id", "summary", "from", "to"],
      "properties": {
        "id": { "type": "string" },
        "summary": { "type": "string" },
        "from": { "$ref": "#/$defs/parser" },
        "to": { "$ref": "#/$defs/parser" },
        "classification": { "type": "string", "enum": ["narrowing", "broadening", "privilege-increase", "privilege-decrease", "relocation", "metadata"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
