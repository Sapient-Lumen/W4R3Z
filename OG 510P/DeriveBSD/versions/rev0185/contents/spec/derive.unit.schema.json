{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD component descriptor source (derive.unit) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "unit_version",
    "id",
    "exec"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "derive.unit"
    },
    "unit_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable unit/instance identity within its scope"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Optional freeform labels for grouping/search; should not affect semantics"
    },
    "exec": {
      "type": "object",
      "required": [
        "argv"
      ],
      "additionalProperties": false,
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "group": {
          "type": "string"
        }
      }
    },
    "strata": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of stratum identifiers/digests to compose into the runtime view"
    },
    "mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "mode",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "ro",
              "rw",
              "tmp",
              "cache",
              "secret"
            ]
          },
          "target": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "Optional named dataset/source, if not implied"
          },
          "options": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "schema_version": {
                "type": "string"
              },
              "durability": {
                "enum": [
                  "ephemeral",
                  "persistent"
                ]
              },
              "backup_class": {
                "enum": [
                  "none",
                  "best-effort",
                  "required"
                ]
              }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "object"
        },
        "devices": {
          "type": "object"
        },
        "observability": {
          "type": "object"
        },
        "ipc": {
          "type": "object"
        }
      },
      "description": "High-level capability declarations compiled into caproute/preopen/pf/devfs/etc"
    },
    "promises": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "High-level intent vocabulary compiled to concrete backends"
    },
    "health": {
      "type": "object",
      "description": "Health checks/expectations required for promotion and rollback decisions"
    },
    "evidence_hooks": {
      "type": "object",
      "description": "What to record/redact for this component (events, logs, traces, etc)"
    },
    "rootfs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tree_digest"
      ],
      "properties": {
        "tree_digest": {
          "type": "string",
          "minLength": 1,
          "description": "Digest-bound reference to the runnable filesystem tree (rootfs) expected for this unit"
        },
        "format": {
          "type": "string",
          "description": "Optional tree encoding/packaging hint (e.g., zfs-dataset, oci, composefs, nydus); policy may ignore"
        },
        "transport_hint": {
          "type": "string",
          "description": "Optional transport preference hint (e.g., materialize, lazy-mount, p2p-ok); policy may ignore"
        }
      },
      "description": "Optional root filesystem tree reference (bytes identity); transport selection is policy-bound"
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inspect": {
          "type": "boolean",
          "description": "If true, unit exposes an Inspect-style structured diagnostics tree"
        },
        "flight_recorder": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "buffer_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "max_window_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "categories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "redaction_class": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "sensitive"
          ],
          "description": "Redaction/handling class for diagnostics emitted by this unit"
        }
      },
      "description": "Diagnostics intent compiled into archivist ingestion rules and budgets"
    },
    "pki": {
      "type": "object",
      "properties": {
        "trust_bundle_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of pki-trust-bundle objects (or rendered trust views) required by this unit."
        },
        "identity_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Stable identity references this unit expects (resolved via pki-issue-plan objects)."
        },
        "ca_bundle": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "fd",
                "ro-file",
                "pkcs11"
              ],
              "description": "How trust material is delivered into the unit runtime."
            },
            "path": {
              "type": "string",
              "description": "In-sandbox path when mode uses a file path (ro-file)."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
