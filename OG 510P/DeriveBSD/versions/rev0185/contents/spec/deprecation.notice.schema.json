{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD deprecation notice (deprecation.notice) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "notice_version",
    "created_at",
    "subject",
    "deprecated_since"
  ],
  "properties": {
    "kind": {
      "const": "deprecation-notice"
    },
    "notice_version": {
      "type": "string",
      "const": "0.1"
    },
    "notice_id": {
      "type": "string",
      "description": "Stable id (UUID recommended) for cross-linking in reviews and receipts."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "description": "What is being deprecated.",
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "description": "Surface class (e.g., contract, uapi, promise.vocab, cli.command, schema)."
        },
        "id": {
          "type": "string",
          "description": "Stable surface id (see docs/383-surface-ids-namespacing-and-stability.md)."
        },
        "registry": {
          "type": "string",
          "description": "Optional registry reference (e.g., 'contract.registry', 'uapi.registry')."
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "deprecated_since": {
      "type": "string",
      "description": "Release tag or date when deprecation begins (e.g., '2026-02-27r109' or '2026-03-01')."
    },
    "end_of_life": {
      "type": "object",
      "description": "When the subject may be removed.",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "release": { "type": "string" }
      },
      "additionalProperties": false
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "critical"],
      "default": "warning"
    },
    "breaking": {
      "type": "boolean",
      "description": "True if removal would be a compatibility break for consumers.",
      "default": true
    },
    "replacements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id"],
        "properties": {
          "kind": { "type": "string" },
          "id": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "migration": {
      "type": "object",
      "description": "How to migrate safely.",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["dual-run", "shim", "rewrite", "manual"],
          "description": "Preferred migration pattern."
        },
        "tooling": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Pointers to migration tools/scripts (repo-relative paths or commands)."
        },
        "docs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Pointers to docs/RFCs/ADRs describing the migration."
        }
      },
      "additionalProperties": false
    },
    "links": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
