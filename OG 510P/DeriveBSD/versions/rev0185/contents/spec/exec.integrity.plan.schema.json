{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD exec integrity plan (exec.integrity.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "created_at",
    "policy_digest",
    "backend",
    "target"
  ],
  "properties": {
    "kind": {"const": "exec.integrity.plan"},
    "plan_version": {"type": "string", "const": "0.1"},
    "plan_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},

    "policy_digest": {"type": "string"},

    "backend": {"type": "string", "enum": ["mac_veriexec", "broker", "none"]},

    "target": {
      "type": "object",
      "required": ["generation_id"],
      "properties": {
        "generation_id": {"type": "string"},
        "host_id": {"type": "string"},
        "fleet_scope": {"type": "string"}
      },
      "additionalProperties": false
    },

    "compiled_manifest_digest": {"type": "string", "description": "Digest of backend-specific compiled manifest (if applicable)."},
    "compiled_rules_digest": {"type": "string", "description": "Digest of backend ruleset bundle (if applicable)."},

    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
