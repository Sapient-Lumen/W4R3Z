{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Event journal segment metadata (event.segment) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "segment_version",
    "stream_id",
    "segment_id",
    "created_at",
    "file_digest",
    "count",
    "first_at",
    "last_at"
  ],
  "properties": {
    "kind": {
      "const": "event-segment"
    },
    "segment_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "stream_id": {
      "type": "string",
      "description": "Logical stream identifier (e.g., host:<host_id>, svc:<service_id>)."
    },
    "segment_id": {
      "type": "string",
      "description": "Segment identifier (monotonic id or UUID)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "encoding": {
      "type": "string",
      "description": "Encoding of the segment blob (e.g., jsonl+zstd, cbor+zstd)."
    },
    "file_digest": {
      "type": "string",
      "description": "Digest of the segment blob content."
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "first_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_at": {
      "type": "string",
      "format": "date-time"
    },
    "merkle_root_digest": {
      "type": "string",
      "description": "Optional Merkle root over per-record digests."
    },
    "chain_head_digest": {
      "type": "string",
      "description": "Optional hash-chain head for order-dependent continuity."
    },
    "prev_chain_head_digest": {
      "type": "string",
      "description": "Optional previous chain head to stitch segments."
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
