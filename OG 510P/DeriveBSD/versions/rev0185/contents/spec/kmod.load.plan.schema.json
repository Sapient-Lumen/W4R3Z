{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD kernel module load plan (kmod.load.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "created_at",
    "target",
    "policy_digest",
    "preload"
  ],
  "properties": {
    "kind": {
      "const": "kmod-load-plan"
    },
    "plan_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "plan_id": {
      "type": "string",
      "description": "Stable id (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "generation_id",
        "generation_digest",
        "kernel_abi"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "generation_id": {
          "type": "string"
        },
        "generation_digest": {
          "type": "string"
        },
        "kernel_abi": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "policy_digest": {
      "type": "string",
      "description": "Digest of the kmod-policy used."
    },
    "preload": {
      "type": "array",
      "description": "Modules that must be loaded before entering operational lockdown.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "digest",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "description": "Why this module is required (device match, filesystem, crypto, etc.)."
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional dependency names (UX)."
          }
        },
        "additionalProperties": false
      }
    },
    "enforcement": {
      "type": "object",
      "description": "Intended enforcement after preload.",
      "properties": {
        "deny_runtime_load": {
          "type": "boolean",
          "default": true
        },
        "deny_runtime_unload": {
          "type": "boolean",
          "default": true
        },
        "raise_lockdown_level": {
          "type": "string",
          "description": "Optional target lockdown level (see platform posture lane)."
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
