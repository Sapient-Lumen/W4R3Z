{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Portal Permission Revoke (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "revoke_version",
    "permission_ref",
    "revoked_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "portal-permission-revoke"
    },
    "revoke_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "permission_ref": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "description": "Digest of canonical portal-permission-grant bytes."
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "string"
    },
    "revoked_at": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
