{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD release transparency entry (release.transparency.entry) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "entry_version",
    "entry_id",
    "created_at",
    "release_capsule_digest",
    "policy_digest",
    "log"
  ],
  "properties": {
    "kind": {
      "const": "release.transparency.entry"
    },
    "entry_version": {
      "type": "string",
      "const": "0.1"
    },
    "entry_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_capsule_digest": {
      "type": "string"
    },
    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy governing release publication (e.g. trust.policy or a higher-level publish policy)."
    },
    "channel_view_digest": {
      "type": "string"
    },
    "rollout_policy_digest": {
      "type": "string"
    },
    "metadata_profile": {
      "type": "string",
      "enum": [
        "minimal",
        "standard"
      ],
      "description": "How much non-digest metadata is allowed to be logged."
    },
    "log": {
      "$ref": "transparency.proof.schema.json"
    },
    "signature": {
      "type": "string",
      "description": "Optional signature over the canonicalized entry."
    },
    "authority_policy_digest": {
      "type": "string",
      "description": "Optional digest of release.authority.policy governing this publication."
    }
  },
  "additionalProperties": false
}
