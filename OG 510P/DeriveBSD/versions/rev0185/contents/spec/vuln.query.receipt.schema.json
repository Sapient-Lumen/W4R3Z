{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD vulnerability query receipt (vuln.query.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "query_id",
    "issued_at",
    "engine",
    "inputs",
    "result",
    "signature"
  ],
  "properties": {
    "kind": {"const": "vuln-query-receipt"},
    "receipt_version": {"type": "string", "const": "0.1"},

    "query_id": {"type": "string", "description": "Stable id for this query execution (UUID recommended)."},
    "issued_at": {"type": "string", "format": "date-time"},

    "engine": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "description": "Query engine name (osv-offline, vuxml-audit, grype, trivy, ...)."},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },

    "inputs": {
      "type": "object",
      "required": ["vuln_db_snapshot_digest", "sbom_statement_digest"],
      "properties": {
        "vuln_db_snapshot_digest": {"type": "string"},
        "sbom_statement_digest": {"type": "string"},
        "vex_statement_digests": {
          "type": "array",
          "items": {"type": "string"}
        },
        "policy_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "result": {
      "type": "object",
      "required": ["status", "counts"],
      "properties": {
        "status": {"type": "string", "enum": ["ok", "warn", "error"]},
        "counts": {
          "type": "object",
          "required": ["total"],
          "properties": {
            "total": {"type": "integer", "minimum": 0},
            "critical": {"type": "integer", "minimum": 0},
            "high": {"type": "integer", "minimum": 0},
            "medium": {"type": "integer", "minimum": 0},
            "low": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["vuln_id", "component"],
            "properties": {
              "vuln_id": {"type": "string", "description": "Primary id (OSV, CVE, GHSA, etc.)."},
              "aliases": {"type": "array", "items": {"type": "string"}},
              "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "unknown"]},
              "component": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {"type": "string"},
                  "version": {"type": "string"},
                  "purl": {"type": "string"}
                },
                "additionalProperties": false
              },
              "fixed": {"type": "boolean"},
              "notes": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
