{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Boot Manifest (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "manifest_version",
    "subject",
    "components",
    "created_at"
  ],
  "properties": {
    "kind": {"const": "boot-manifest"},
    "manifest_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "subject": {
      "type": "object",
      "required": ["deployment_ref_digest"],
      "properties": {
        "deployment_ref_digest": {"type": "string", "description": "Digest of deployment.ref (sha256:...)"},
        "generation_id": {"type": "string", "description": "Optional stable generation identifier."},
        "namespace": {"type": "string"},
        "channel": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },

    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "digest"],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "firmware-policy",
              "loader",
              "bootloader-config",
              "kernel",
              "kernel-modules",
              "initrd",
              "init",
              "activation",
              "cmdline-profile",
              "microcode",
              "shim",
              "other"
            ]
          },
          "digest": {"type": "string", "description": "Content digest of the component (sha256:...)"},
          "path": {"type": "string", "description": "Optional path or label (metadata only)."},
          "format": {"type": "string", "description": "Optional format hint (efi, elf, tar, zfs, etc)."},
          "meta": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": false
      }
    },

    "measurement": {
      "type": "object",
      "description": "Optional hints for measured-boot replay and phase markers.",
      "properties": {
        "phase_pcr": {"type": "integer", "description": "PCR index used for phase markers (if any)."},
        "expected_phases": {"type": "array", "items": {"type": "string"}},
        "eventlog_canon": {
          "type": "string",
          "description": "Identifier of eventlog canonicalization rules used for eventlog_digest." 
        }
      },
      "additionalProperties": false
    },

    "created_at": {"type": "string", "format": "date-time"},

    "signatures": {
      "type": "array",
      "description": "Optional signatures over canonical JSON bytes. Most deployments will sign deployment.ref; this is provided for standalone distribution.",
      "items": {
        "type": "object",
        "required": ["key_id", "sig"],
        "properties": {
          "key_id": {"type": "string"},
          "alg": {"type": "string"},
          "sig": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
