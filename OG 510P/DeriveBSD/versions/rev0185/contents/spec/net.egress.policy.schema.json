{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Network Egress Policy (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "classes",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "net-egress-policy"},
    "policy_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "permissions"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$",
            "description": "Stable class id referenced by promise profiles (e.g., https-anywhere, dns-only)."
          },
          "description": {"type": "string"},

          "permissions": {
            "type": "object",
            "properties": {
              "dns_lookup": {"type": "boolean"},
              "connect": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["proto"],
                  "properties": {
                    "proto": {"type": "string", "enum": ["tcp", "udp"]},
                    "ports": {
                      "type": "array",
                      "items": {"type": "integer", "minimum": 0, "maximum": 65535}
                    },
                    "port_range": {
                      "type": "object",
                      "properties": {
                        "min": {"type": "integer", "minimum": 0, "maximum": 65535},
                        "max": {"type": "integer", "minimum": 0, "maximum": 65535}
                      },
                      "additionalProperties": false
                    },
                    "hosts": {
                      "type": "array",
                      "items": {"type": "string", "description": "Hostname globs or suffix patterns."}
                    },
                    "cidrs": {"type": "array", "items": {"type": "string"}}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },

          "defaults": {
            "type": "object",
            "description": "Suggested default constraints when turning a class into a net-egress-grant.",
            "properties": {
              "ttl_seconds": {"type": "integer", "minimum": 1},
              "max_flows": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },

          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },

    "issued_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "object"}
  },
  "additionalProperties": false
}
