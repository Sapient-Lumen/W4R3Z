{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Workload Identity Grant (evidence object)",
  "type": "object",
  "required": [
    "format_version",
    "type",
    "issued_at",
    "expires_at",
    "spiffe_id",
    "subject",
    "issuer",
    "credential"
  ],
  "properties": {
    "format_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "type": {
      "const": "workload.identity.grant"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "spiffe_id": {
      "type": "string",
      "description": "SPIFFE-style workload identifier, e.g. spiffe://example.com/ns/foo"
    },
    "subject": {
      "type": "object",
      "required": [
        "compartment_id",
        "closure_digest",
        "runtime_manifest_digest"
      ],
      "properties": {
        "deployment_ref": {
          "type": "string",
          "description": "Optional deployment reference (digest or ref string)."
        },
        "workload_name": {
          "type": "string"
        },
        "compartment_id": {
          "type": "string",
          "description": "Runtime-provided compartment identity (microVM instance id or jail name)."
        },
        "closure_digest": {
          "type": "string",
          "description": "Digest of the closure proof or closure root used by the workload."
        },
        "runtime_manifest_digest": {
          "type": "string",
          "description": "Digest of the runtime manifest that defines the workload contract."
        },
        "selectors": {
          "type": "object",
          "description": "Additional selectors (namespace/channel/environment labels) used by policy.",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "issuer": {
      "type": "object",
      "required": [
        "issuer_id",
        "key_id"
      ],
      "properties": {
        "issuer_id": {
          "type": "string",
          "description": "Host or WIA identity (stable identifier)."
        },
        "key_id": {
          "type": "string",
          "description": "Key identifier used to sign this evidence object."
        },
        "node_evidence": {
          "type": "object",
          "description": "Optional references to node attestation inputs (measured boot receipts, etc.).",
          "properties": {
            "boot_attestation_ref": { "type": "string" },
            "verifier_receipt_ref": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "credential": {
      "type": "object",
      "required": [
        "kind",
        "svid_digest",
        "trust_bundle_digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "x509-svid",
            "jwt-svid"
          ]
        },
        "svid_digest": {
          "type": "string",
          "description": "Digest of the issued credential (certificate/JWT), not the private key."
        },
        "trust_bundle_digest": {
          "type": "string",
          "description": "Digest of the trust bundle used for verification."
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "description": "Optional policy linkage.",
      "properties": {
        "policy_decision_ref": { "type": "string" },
        "ruleset_id": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
