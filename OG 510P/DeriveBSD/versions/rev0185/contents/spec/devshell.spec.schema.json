{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD DevShell Spec (v0)",
  "type": "object",
  "required": ["format_version", "name", "packages"],
  "properties": {
    "format_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "name": {"type": "string"},
    "platform": {
      "type": "string",
      "description": "e.g. freebsd-14.1-amd64"
    },
    "packages": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Tooling and dependencies to expose in the devshell. Resolved/pinned during Lock."
    },
    "env": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "Environment variables exported on entry."
    },
    "workdir": {
      "type": "string",
      "default": "/work",
      "description": "Default working directory inside the devshell."
    },
    "network": {
      "type": "string",
      "enum": ["off", "restricted", "on"],
      "default": "off",
      "description": "Default is off; policy may further restrict/deny."
    },
    "isolation": {
      "type": "string",
      "enum": ["jail", "microvm"],
      "default": "jail",
      "description": "Execution mode. microvm is higher isolation and may be slower."
    },
    "mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["project", "tmp", "cache", "scratch"],
            "description": "Mount category. Store/closure mounts are derived; this list declares writable mounts."
          },
          "path": {"type": "string"},
          "mode": {"type": "string", "enum": ["ro", "rw"], "default": "rw"}
        },
        "additionalProperties": false
      },
      "description": "Writable mounts for the devshell."
    },
    "hooks": {
      "type": "object",
      "properties": {
        "enter": {"type": "array", "items": {"type": "string"}},
        "exit": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
