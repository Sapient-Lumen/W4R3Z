{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD pin remove receipt (pin.rm.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "removed"
  ],
  "properties": {
    "kind": { "const": "pin.rm.receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "receipt_id": { "type": "string", "description": "Stable id for this receipt (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "host_id": { "type": "string" },

    "requested_by": { "type": "string", "description": "Opaque operator/workflow id (optional)." },
    "policy_digest": { "type": "string", "description": "Optional digest of the policy module(s) authorizing pin removal." },

    "removed": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "prior_target_ref": { "type": "string" },
        "prior_target_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
