{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD configuration transition plan (config.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "created_at",
    "target",
    "roots"
  ],
  "properties": {
    "kind": {
      "const": "config-plan"
    },
    "plan_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "plan_id": {
      "type": "string",
      "description": "Stable id for the plan (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "generation_id"
      ],
      "properties": {
        "generation_id": {
          "type": "string",
          "description": "Generation/profile identifier the plan belongs to."
        },
        "boot_environment": {
          "type": "string",
          "description": "Optional BE name/id that will be switched to."
        }
      }
    },
    "roots": {
      "type": "array",
      "description": "Named config roots to activate (store paths + digests).",
      "items": {
        "type": "object",
        "required": [
          "name",
          "store_path",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "system",
              "network",
              "auth",
              "services",
              "apps",
              "custom"
            ]
          },
          "store_path": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "description": "Digest of the root contents (e.g., blake3:...)."
          },
          "scope": {
            "type": "string",
            "description": "Freeform scope tag (e.g., 'ssh', 'pf', 'resolv')."
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "description": "Optional explicit ops (if not implied by roots).",
      "items": {
        "type": "object",
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "swap-roots",
              "write-file",
              "remove-file",
              "symlink",
              "set-kv",
              "reload-service",
              "restart-service"
            ]
          },
          "path": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "validators": {
      "type": "array",
      "description": "Validators that must pass before activation/commit.",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Validator id (e.g., pf-syntax, sshd-configtest, net-reachability)."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "confirm": {
      "type": "object",
      "description": "Commit-confirmed mode parameters.",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "required_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority_capability": {
          "type": "string",
          "description": "Capability or token namespace required to confirm."
        },
        "auto_confirm_policy_id": {
          "type": "string",
          "description": "Optional policy id for an automated confirmer."
        }
      }
    },
    "rollback": {
      "type": "object",
      "description": "Rollback pointers for auto-rollback or manual rollback.",
      "properties": {
        "prior_snapshot_digest": {
          "type": "string"
        },
        "prior_roots_ref": {
          "type": "string",
          "description": "Pointer to the prior active roots (store path or bookmark)."
        },
        "rollback_plan_digest": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
