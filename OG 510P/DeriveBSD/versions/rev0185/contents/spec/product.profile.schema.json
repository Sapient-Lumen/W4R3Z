{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One product profile definition with defaults, required invariants, and forbidden-by-default lanes.",
  "properties": {
    "defaults": {
      "additionalProperties": true,
      "description": "Default posture knobs for this profile.",
      "type": "object"
    },
    "description": {
      "type": "string"
    },
    "forbidden_by_default": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "description": "Stable id for this profile.",
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "notes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "required_invariants": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "id",
    "label",
    "description",
    "required_invariants"
  ],
  "title": "DeriveBSD product profile",
  "type": "object"
}
