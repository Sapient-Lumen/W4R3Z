{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UserEnv activation plan (userenv.activate.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "created_at",
    "user",
    "userenv_digest",
    "activation"
  ],
  "properties": {
    "kind": { "const": "userenv-activate-plan" },
    "plan_version": { "type": "string", "const": "0.1" },
    "plan_id": {
      "type": "string",
      "description": "Stable id (UUID recommended) for correlation with receipts."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "user": {
      "type": "object",
      "required": ["uid"],
      "properties": {
        "uid": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "home": { "type": "string" }
      },
      "additionalProperties": false
    },
    "userenv_digest": {
      "type": "string",
      "description": "Digest identifying the UserEnv closure/object being activated."
    },
    "expected_previous_digest": {
      "type": "string",
      "description": "Optional guard: activation should fail if the current pointer does not match this digest."
    },
    "activation": {
      "type": "object",
      "required": ["mode", "profile_path"],
      "properties": {
        "mode": { "type": "string", "enum": ["symlink", "mount"] },
        "profile_path": {
          "type": "string",
          "description": "Stable per-user pointer path (e.g., ~/.derive/profile)."
        },
        "generation_path": {
          "type": "string",
          "description": "Optional explicit generation link path (e.g., profile-57-link)."
        },
        "entrypoints": {
          "type": "object",
          "description": "User-facing entrypoints updated by activation.",
          "properties": {
            "path_exports": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Directories to expose on PATH (typically within the activated profile)."
            },
            "shell_hooks": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Shell integration snippets or repo-relative hook paths."
            },
            "desktop_entries": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Optional desktop/menu entry paths produced by the UserEnv."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
