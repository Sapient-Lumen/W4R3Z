{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD resource governance snapshot (resource.snapshot) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "snapshot_version",
    "captured_at",
    "host",
    "subjects"
  ],
  "properties": {
    "kind": {
      "const": "resource-snapshot"
    },
    "snapshot_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "required": [
        "host_id"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "generation_id": {
          "type": "string"
        },
        "boot_environment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "effective_limits"
        ],
        "properties": {
          "subject": {
            "type": "object",
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "service",
                  "workload",
                  "jail",
                  "vm",
                  "user",
                  "group",
                  "host"
                ]
              },
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "effective_limits": {
            "type": "object",
            "additionalProperties": true
          },
          "usage": {
            "type": "object",
            "description": "Coarse usage summary (policy-gated).",
            "properties": {
              "cpu_percent": {
                "type": "number",
                "minimum": 0
              },
              "memory_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "io_read_bps": {
                "type": "integer",
                "minimum": 0
              },
              "io_write_bps": {
                "type": "integer",
                "minimum": 0
              },
              "pids": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": true
          },
          "pressure": {
            "type": "object",
            "description": "Optional pressure summary (cpu/mem/io).",
            "properties": {
              "cpu_some_avg10": {
                "type": "number",
                "minimum": 0
              },
              "mem_some_avg10": {
                "type": "number",
                "minimum": 0
              },
              "io_some_avg10": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": true
          },
          "recent_violations": {
            "type": "object",
            "description": "Optional counters by class.",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}