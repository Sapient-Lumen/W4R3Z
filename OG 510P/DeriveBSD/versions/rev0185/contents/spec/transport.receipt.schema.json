{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD transport receipt (transport.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "transport_kind",
    "artifact"
  ],
  "properties": {
    "kind": {
      "const": "transport.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "transport_kind": {
      "type": "string",
      "enum": [
        "jira",
        "servicenow",
        "https-upload",
        "sftp",
        "email",
        "removable-media",
        "oob",
        "custom"
      ]
    },
    "transport_policy_digest": {
      "type": "string"
    },
    "artifact": {
      "type": "object",
      "required": [
        "kind",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "properties": {
        "ticket_id": {
          "type": "string"
        },
        "recipient": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "uri_hint": {
          "type": "string",
          "description": "Redacted non-secret hint."
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "error",
            "rejected",
            "timeout"
          ]
        },
        "remote_id": {
          "type": "string",
          "description": "Upload id / attachment id / message id."
        },
        "http_status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "error_hint": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
