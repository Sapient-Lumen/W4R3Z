{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD store garbage-collection receipt (store.gc.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_id",
    "plan_digest",
    "outcome",
    "stats"
  ],
  "properties": {
    "kind": { "const": "store.gc.receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "receipt_id": { "type": "string", "description": "Stable id for this receipt (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "host_id": { "type": "string" },

    "plan_id": { "type": "string" },
    "plan_digest": { "type": "string", "description": "Digest of the store.gc.plan executed." },

    "outcome": { "type": "string", "enum": ["applied", "dry-run", "partial", "failed"] },

    "stats": {
      "type": "object",
      "required": ["deleted_count", "reclaimed_bytes"],
      "properties": {
        "deleted_count": { "type": "integer", "minimum": 0 },
        "reclaimed_bytes": { "type": "integer", "minimum": 0 },
        "store_bytes_before": { "type": "integer", "minimum": 0 },
        "store_bytes_after": { "type": "integer", "minimum": 0 },
        "store_free_bytes_after": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "deleted": {
      "type": "array",
      "description": "Optional listing of deletions (may be truncated; export a full list separately if needed).",
      "items": {
        "type": "object",
        "required": ["target_kind", "ref"],
        "properties": {
          "target_kind": { "type": "string" },
          "ref": { "type": "string" },
          "digest": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },

    "retained": {
      "type": "array",
      "description": "Optional listing of items that were candidates but retained due to roots/pins/leases.",
      "items": {
        "type": "object",
        "required": ["ref", "reason"],
        "properties": {
          "ref": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string" },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
