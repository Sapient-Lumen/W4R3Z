{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Sigstore bundle wrapper (sigstore.bundle) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "bundle_version",
    "bundle_id",
    "created_at",
    "bundle"
  ],
  "properties": {
    "kind": {"const": "sigstore.bundle"},
    "bundle_version": {"type": "string", "const": "0.1"},
    "bundle_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},

    "instance": {
      "type": "object",
      "description": "Optional instance metadata (useful when multiple Sigstore instances exist).",
      "properties": {
        "rekor_url": {"type": "string"},
        "fulcio_url": {"type": "string"},
        "tsa_url": {"type": "string"},
        "instance_name": {"type": "string"}
      },
      "additionalProperties": false
    },

    "subject": {
      "type": "object",
      "description": "Optional subject summary (the canonical subject is inside the DSSE in-toto statement).",
      "properties": {
        "digest": {"type": "string"},
        "subject_kind": {"type": "string"}
      },
      "additionalProperties": false
    },

    "bundle": {
      "type": "object",
      "description": "The Sigstore bundle JSON, stored as-is for interoperability (structure defined by Sigstore).",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
