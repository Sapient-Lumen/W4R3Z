{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD time sync plan (time.sync.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "created_at",
    "host",
    "mode",
    "sources",
    "discipline"
  ],
  "properties": {
    "kind": {"const": "time-sync-plan"},
    "plan_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "plan_id": {"type": "string", "description": "Stable id for this plan (UUID recommended)."},

    "created_at": {"type": "string", "format": "date-time"},

    "host": {
      "type": "object",
      "required": ["host_id", "generation_digest"],
      "properties": {
        "host_id": {"type": "string"},
        "generation_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "mode": {"type": "string", "enum": ["ntp", "ptp", "hybrid"]},

    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id"],
        "properties": {
          "source_id": {"type": "string"},
          "type": {"type": "string", "enum": ["ntp", "ptp", "rtc", "roughtime", "gps"]},
          "address": {"type": "string"},
          "auth": {
            "type": "object",
            "properties": {
              "mode": {"type": "string", "enum": ["none", "nts", "symmetric-key", "ptp-auth"]},
              "key_ref": {"type": "string", "description": "Reference to a secret id/ref, not inline key material."}
            },
            "additionalProperties": false
          },
          "weight": {"type": "integer", "minimum": 0, "maximum": 100}
        },
        "additionalProperties": false
      }
    },

    "discipline": {
      "type": "object",
      "required": ["step_policy"],
      "properties": {
        "step_policy": {"type": "string", "enum": ["slew-only", "step-if-big", "step-always"]},
        "max_step_ms": {"type": "integer", "minimum": 0},
        "max_slew_ppm": {"type": "integer", "minimum": 1},
        "max_offset_ms": {"type": "integer", "minimum": 0},
        "quorum": {
          "type": "object",
          "properties": {
            "min_sources": {"type": "integer", "minimum": 1},
            "max_skew_ms": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
