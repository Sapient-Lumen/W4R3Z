{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD secret access grant (secret-grant) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "grant_id",
    "created_at",
    "secret_id",
    "subject",
    "ops",
    "delivery"
  ],
  "properties": {
    "kind": {
      "const": "secret-grant"
    },
    "grant_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "grant_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string",
      "description": "Canonical cross-lane lease identifier for this grant. When present, SHOULD equal grant_id (legacy)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "secret_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "description": "Human/ops label (e.g., 'db-pass for app')."
    },
    "subject": {
      "type": "object",
      "properties": {
        "service_id": {
          "type": "string"
        },
        "workload_label": {
          "type": "string"
        },
        "vm_id": {
          "type": "string"
        },
        "jail_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ops": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "materialize",
          "rotate"
        ]
      }
    },
    "delivery": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "memfd",
            "ramfs",
            "file",
            "env",
            "fd"
          ]
        },
        "path": {
          "type": "string",
          "description": "If mode=file, the brokered destination path."
        },
        "env_key": {
          "type": "string",
          "description": "If mode=env, the env var name."
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_reads": {
          "type": "integer",
          "minimum": 1
        },
        "single_use": {
          "type": "boolean",
          "default": false
        },
        "require_attestation": {
          "type": "boolean",
          "default": false
        },
        "boot_attestation_digest": {
          "type": "string"
        },
        "attestation_requirement_digest": {
          "type": "string",
          "description": "Digest/id of an attestation-requirement object describing the gate to satisfy (preferred)."
        },
        "attestation_receipt_digest": {
          "type": "string",
          "description": "Digest/id of an attestation-receipt to accept (pin to a specific receipt)."
        },
        "max_attestation_age_sec": {
          "type": "integer",
          "minimum": 1,
          "description": "If provided, the receipt must be no older than this many seconds."
        }
      },
      "additionalProperties": false
    },
    "correlation": {
      "type": "object",
      "properties": {
        "change_id": {
          "type": "string"
        },
        "step": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
