{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD boot environment switch plan (bootenv.switch.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "target",
    "fallback",
    "try_policy"
  ],
  "properties": {
    "kind": {
      "const": "bootenv-switch-plan"
    },
    "plan_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "plan_id": {
      "type": "string",
      "description": "Stable id for the plan (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "requested_by": {
      "type": "string",
      "description": "Opaque operator/workflow id (optional)."
    },
    "target": {
      "$ref": "deployment.ref.schema.json"
    },
    "fallback": {
      "$ref": "deployment.ref.schema.json"
    },
    "try_policy": {
      "type": "object",
      "required": [
        "max_tries"
      ],
      "properties": {
        "max_tries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "assessment_deadline_seconds": {
          "type": "integer",
          "minimum": 10,
          "description": "Time window after boot to consider assessment passing."
        },
        "assessment_service": {
          "type": "string",
          "description": "Service/agent that marks the generation as good."
        },
        "health_gate_ref": {
          "type": "string",
          "description": "Optional reference/digest for the health gate policy."
        }
      },
      "additionalProperties": false
    },
    "bootloader": {
      "type": "object",
      "properties": {
        "entry_id": {
          "type": "string",
          "description": "Bootloader entry identifier (if applicable)."
        },
        "constraints_ref": {
          "type": "string",
          "description": "Reference/digest to boot config constraints (see docs/277)."
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
