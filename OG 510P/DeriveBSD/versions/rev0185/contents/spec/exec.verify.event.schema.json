{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD verified execution event (exec-verify-event) (v0.1)",
  "allOf": [
    { "$ref": "event.record.schema.json" },
    {
      "type": "object",
      "required": ["kind", "event_version", "event_id", "at", "source", "class", "severity", "payload", "signature"],
      "properties": {
        "kind": { "const": "exec-verify-event" },
        "event_version": { "type": "string", "pattern": "^0\\.\\d+$" },
        "event_id": { "type": "string" },
        "at": { "type": "string", "format": "date-time" },
        "source": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "description": "Emitter (kernel, mac_veriexec, veriexecd, policy-loader)." },
            "host_id": { "type": "string" },
            "domain": { "type": "string" }
          },
          "additionalProperties": false
        },
        "class": {
          "type": "string",
          "description": "Event class (e.g., exec.violation, exec.denial, policy.loaded)."
        },
        "severity": { "type": "string", "enum": ["debug", "info", "warn", "error", "critical", "fatal"] },
        "payload": { "type": "object" },
        "signature": { "type": "string" }
      },
      "additionalProperties": false
    }
  ]
}
