{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD sysctl plan diff (sysctl.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_plan",
    "to_plan",
    "settings_added",
    "settings_removed",
    "settings_changed"
  ],
  "properties": {
    "kind": { "const": "sysctl.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation/domain).",
      "properties": {
        "host_id": { "type": "string" },
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "domain": { "type": "string", "description": "Optional compartment/domain identifier." },
        "from_generation": { "type": "string" },
        "to_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "from_plan": { "$ref": "#/$defs/plan_ref" },
    "to_plan": { "$ref": "#/$defs/plan_ref" },

    "settings_added": {
      "type": "array",
      "items": { "$ref": "#/$defs/setting" }
    },
    "settings_removed": {
      "type": "array",
      "items": { "$ref": "#/$defs/setting" }
    },
    "settings_changed": {
      "type": "array",
      "items": { "$ref": "#/$defs/setting_change" }
    },

    "summary": {
      "type": "object",
      "properties": {
        "added": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "plan_ref": {
      "type": "object",
      "description": "Reference to a sysctl.plan object by digest (and optional human fields).",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "plan_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "boot_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "setting": {
      "type": "object",
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]+$" },
        "value": {
          "type": "string",
          "description": "Sysctl value encoded as a string (sysctl(8) compatible)."
        },
        "require_exists": {
          "type": "boolean",
          "default": true,
          "description": "If true, missing keys are errors (copied from sysctl.plan settings)."
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "setting_change": {
      "type": "object",
      "required": ["key", "from", "to"],
      "properties": {
        "key": { "type": "string" },
        "from": { "$ref": "#/$defs/setting" },
        "to": { "$ref": "#/$defs/setting" },
        "classification": {
          "type": "string",
          "enum": ["value", "exists", "both", "other"]
        },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
