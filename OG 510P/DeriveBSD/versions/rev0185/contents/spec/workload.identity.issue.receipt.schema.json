{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Workload Identity Issue Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "subject",
    "spiffe_id",
    "credential",
    "issued_at",
    "captured_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "workload-identity-issue-receipt"},
    "receipt_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": {"type": "string"},
        "digest": {"type": "string"},
        "instance": {"type": "string"}
      },
      "additionalProperties": false
    },

    "spiffe_id": {"type": "string"},

    "attestation_ref": {
      "type": "object",
      "description": "Optional pointer to an attestation reference/receipt used to authorize issuance.",
      "properties": {
        "kind": {"type": "string"},
        "digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "credential": {
      "type": "object",
      "required": ["type", "expires_at"],
      "properties": {
        "type": {"type": "string", "enum": ["x509-svid", "jwt-svid"]},
        "expires_at": {"type": "string", "format": "date-time"},
        "bundle_digest": {"type": "string"},
        "cert_chain_digests": {"type": "array", "items": {"type": "string"}},
        "jwt_digest": {"type": "string"},
        "key_handle": {"type": "string"},
        "trust_bundle_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "lease_id": {"type": "string"},
    "issued_at": {"type": "string", "format": "date-time"},
    "captured_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "object"}
  },
  "additionalProperties": false
}
