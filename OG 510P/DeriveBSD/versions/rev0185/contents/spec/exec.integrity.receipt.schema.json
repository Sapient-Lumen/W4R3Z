{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD exec integrity receipt (exec.integrity.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "policy_digest",
    "backend",
    "mode",
    "result"
  ],
  "properties": {
    "kind": {"const": "exec.integrity.receipt"},
    "receipt_version": {"type": "string", "const": "0.1"},
    "receipt_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},

    "policy_digest": {"type": "string"},
    "plan_digest": {"type": "string"},

    "backend": {"type": "string", "enum": ["mac_veriexec", "broker", "none"]},
    "mode": {"type": "string", "enum": ["off", "warn", "enforce"]},

    "activation_boundary": {
      "type": "object",
      "properties": {
        "generation_id": {"type": "string"},
        "bootenv_id": {"type": "string"},
        "service_instance_id": {"type": "string"},
        "vm_instance_id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "compiled_manifest_digest": {"type": "string"},

    "result": {"type": "string", "enum": ["enabled", "disabled", "degraded", "failed"]},
    "reason": {"type": "string"},

    "backend_state": {
      "type": "object",
      "description": "Backend-specific state (opaque to generic tooling).",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
