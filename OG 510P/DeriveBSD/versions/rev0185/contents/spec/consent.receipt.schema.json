{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD consent receipt (consent.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "request_digest",
    "outcome",
    "method"
  ],
  "properties": {
    "kind": {
      "const": "consent.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_digest": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "approved",
        "denied",
        "timeout"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "gui",
        "tty",
        "oob",
        "auto"
      ]
    },
    "actor": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "description": "Approver identity (user/role)."
        },
        "auth_strength": {
          "type": "string",
          "description": "Metadata only (e.g., pam+fido2)."
        }
      },
      "additionalProperties": false
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "gui",
              "tty",
              "oob",
              "auto"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
