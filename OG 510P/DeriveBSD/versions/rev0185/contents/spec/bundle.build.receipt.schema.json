{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD bundle build receipt (bundle.build.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "host",
    "plan_digest",
    "output"
  ],
  "properties": {
    "kind": {
      "const": "bundle.build.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "required": [
        "host_id",
        "generation_digest"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "generation_digest": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "plan_digest": {
      "type": "string",
      "description": "Digest of the bundle.plan used for selection + transforms."
    },
    "inputs": {
      "type": "object",
      "description": "Optional pointers to index inputs used while resolving the plan.",
      "properties": {
        "causality_graph_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "event_stream_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "applied": {
      "type": "object",
      "description": "What was actually applied at build time (may mirror plan/transforms).",
      "properties": {
        "redaction_transform_digest": {
          "type": "string"
        },
        "export_policy_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "payload_digest",
        "format",
        "incident_bundle_digest"
      ],
      "properties": {
        "payload_digest": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "tar.zst",
            "zip"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "incident_bundle_digest": {
          "type": "string",
          "description": "Digest of the incident.bundle metadata object produced/updated for this payload."
        },
        "payload_manifest_digest": {
          "type": "string",
          "description": "Digest of bundle.payload.manifest produced for this payload (file-level member listing)."
        },
        "encryption": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none",
                "encrypt-for-recipient"
              ]
            },
            "recipient_hint": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "description": "Builder tool identity (optional).",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "build_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "description": "Optional signature over this receipt envelope.",
      "properties": {
        "sig_alg": {
          "type": "string"
        },
        "public_key_hint": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
