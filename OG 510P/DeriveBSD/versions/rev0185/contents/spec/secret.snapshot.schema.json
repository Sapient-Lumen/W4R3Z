{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD secret snapshot (secret-snapshot) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "snapshot_version",
    "captured_at",
    "host_id",
    "secrets"
  ],
  "properties": {
    "kind": { "const": "secret-snapshot" },
    "snapshot_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "captured_at": { "type": "string", "format": "date-time" },
    "host_id": { "type": "string" },
    "policy_digest": { "type": "string" },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["secret_id", "status"],
        "properties": {
          "secret_id": { "type": "string" },
          "status": { "type": "string", "enum": ["ok", "expired", "missing", "unseal-failed", "provider-error"] },
          "last_rotated_at": { "type": "string", "format": "date-time" },
          "next_due_at": { "type": "string", "format": "date-time" },
          "latest_receipt_digest": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": "string" },
    "signature": { "type": "string" }
  },
  "additionalProperties": false
}
