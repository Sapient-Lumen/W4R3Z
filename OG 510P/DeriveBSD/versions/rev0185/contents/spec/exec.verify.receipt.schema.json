{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD verified execution apply receipt (exec-verify-receipt) (v0.1)",
  "type": "object",
  "required": ["kind", "receipt_version", "applied_at", "policy_digest", "result"],
  "properties": {
    "kind": { "const": "exec-verify-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "applied_at": { "type": "string", "format": "date-time" },
    "host_id": { "type": "string" },
    "policy_digest": { "type": "string" },
    "loaded_fingerprints_digest": { "type": "string" },
    "result": { "type": "string", "enum": ["ok", "warning", "error"] },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "error": { "type": "string" },
    "signature": { "type": "string" }
  },
  "additionalProperties": false
}
