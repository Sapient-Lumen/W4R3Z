{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD lint report (lint-report) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "report_version",
    "created_at",
    "tool",
    "target",
    "summary",
    "issues"
  ],
  "properties": {
    "kind": {"const": "lint-report"},
    "report_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "report_id": {"type": "string", "description": "Stable id for the report (UUID recommended)."},
    "created_at": {"type": "string", "format": "date-time"},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "profile": {"type": "string", "description": "Optional mode/profile (e.g., 'strict', 'ci')."}
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "description": "What was linted (e.g., 'repo', 'svcdb', 'capability-graph', 'sandbox-profile')."
        },
        "path": {"type": "string", "description": "Optional repo path when linting a file/subtree."},
        "digest": {"type": "string", "description": "Optional digest of the lint target (artifact digest if applicable)."},
        "meta": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["error_count", "warn_count", "info_count"],
      "properties": {
        "error_count": {"type": "integer", "minimum": 0},
        "warn_count": {"type": "integer", "minimum": 0},
        "info_count": {"type": "integer", "minimum": 0},
        "by_code": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0},
          "description": "Optional count map keyed by issue code."
        }
      },
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {"type": "string", "description": "Stable issue code for gating/diffing."},
          "severity": {"type": "string", "enum": ["error", "warn", "info"]},
          "message": {"type": "string"},
          "path": {"type": "string", "description": "Optional file path or logical object path."},
          "span": {
            "type": "object",
            "properties": {
              "line": {"type": "integer", "minimum": 1},
              "col": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "end_col": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          },
          "hint": {"type": "string", "description": "Optional fix hint."},
          "refs": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Optional URLs or digest pointers to supporting evidence/docs."
          },
          "meta": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
