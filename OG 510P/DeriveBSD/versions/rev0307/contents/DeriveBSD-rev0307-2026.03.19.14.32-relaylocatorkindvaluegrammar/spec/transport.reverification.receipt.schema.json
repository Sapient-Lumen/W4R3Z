{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD transport reverification receipt (transport.reverification.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "export_receipt_digest",
    "transport_acceptance_receipt_digest",
    "artifact",
    "recipient",
    "reverification"
  ],
  "properties": {
    "kind": {
      "const": "transport.reverification.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "export_receipt_digest": {
      "type": "string"
    },
    "transport_acceptance_receipt_digest": {
      "type": "string"
    },
    "artifact": {
      "type": "object",
      "required": [
        "kind",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "recipient": {
      "type": "object",
      "required": [
        "recipient"
      ],
      "properties": {
        "recipient": {
          "type": "string"
        },
        "ticket_id": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "reverification": {
      "type": "object",
      "required": [
        "kind",
        "checked_at",
        "status",
        "body_downloaded"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "http-head",
            "object-head",
            "ticket-metadata-api",
            "message-metadata-api",
            "portal-manifest",
            "manual-reviewed",
            "custom"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "match",
            "mismatch",
            "unavailable"
          ]
        },
        "body_downloaded": {
          "type": "boolean"
        },
        "remote_reference": {
          "type": "string"
        },
        "remote_artifact_digest": {
          "type": "string"
        },
        "remote_validator": {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "etag-strong",
                "etag-weak",
                "version-id",
                "attachment-revision",
                "message-id",
                "opaque"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "remote_protection": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "versioned-noncurrent-retained",
                "retain-until",
                "policy-locked-retention",
                "legal-hold",
                "append-only-log",
                "opaque-reviewed"
              ]
            },
            "retain_until": {
              "type": "string",
              "format": "date-time"
            },
            "note": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "enum": [
                      "retain-until",
                      "policy-locked-retention"
                    ]
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "retain_until"
                ]
              }
            }
          ],
          "additionalProperties": false
        },
        "remote_locator": {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "uri-hint",
                "ticket-attachment",
                "portal-object",
                "message-part",
                "object-path",
                "opaque"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reverification": {
            "type": "object",
            "properties": {
              "status": {
                "const": "match"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "reverification"
        ]
      },
      "then": {
        "properties": {
          "reverification": {
            "type": "object",
            "required": [
              "remote_validator",
              "remote_locator"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
