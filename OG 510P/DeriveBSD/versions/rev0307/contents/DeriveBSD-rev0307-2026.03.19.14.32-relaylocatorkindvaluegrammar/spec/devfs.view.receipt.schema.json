{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD devfs view receipt (devfs.view.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_id",
    "plan_digest",
    "status"
  ],
  "properties": {
    "kind": { "const": "devfs-view-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "receipt_id": { "type": "string", "description": "Stable id for this receipt (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "plan_id": { "type": "string" },
    "plan_digest": { "type": "string", "description": "Digest of the devfs.view.plan that was executed." },

    "target": {
      "type": "object",
      "properties": {
        "host_id": { "type": "string" },
        "domain_kind": { "type": "string", "enum": ["host", "jail", "microvm"] },
        "domain_id": { "type": "string" },
        "service_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "host": {
      "type": "object",
      "properties": {
        "machine_id": { "type": "string" },
        "boot_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "applied": {
      "type": "object",
      "description": "What backend state was applied.",
      "properties": {
        "backend": { "type": "string", "enum": ["devfs.rules", "devfs.rule.stream"] },
        "ruleset_id": { "type": "integer", "minimum": 0, "description": "Effective devfs ruleset id (backend-defined)." },
        "rules_digest": { "type": "string", "description": "Digest of the canonical rules list (if available)." },
        "rules_text_digest": { "type": "string", "description": "Digest of rendered devfs.rules text (if used)." }
      },
      "additionalProperties": false
    },

    "observed": {
      "type": "object",
      "description": "Optional observed post-apply state (privacy-safe by default).",
      "properties": {
        "nodes_digest": { "type": "string", "description": "Digest of the observed node set (stable ordering + hashing)." },
        "nodes_count": { "type": "integer", "minimum": 0 },
        "unexpected_paths": {
          "type": "array",
          "description": "Optional sample of unexpected nodes (avoid sensitive identifiers; truncate).",
          "maxItems": 32,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },

    "policy_decision_digest": { "type": "string" },

    "status": { "type": "string", "enum": ["success", "partial", "failed"] },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
