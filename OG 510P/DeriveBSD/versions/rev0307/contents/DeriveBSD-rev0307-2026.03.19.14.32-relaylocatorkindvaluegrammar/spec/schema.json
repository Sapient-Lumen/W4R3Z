{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Spec (v0)",
  "type": "object",
  "required": [
    "format_version",
    "name",
    "packages"
  ],
  "properties": {
    "format_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "name": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "description": "e.g. freebsd-14.1-amd64"
    },
    "toolchain": {
      "type": "object"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    },
    "targets": {
      "type": "object",
      "description": "Optional artifact targets beyond packages/systems.",
      "properties": {
        "microvms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "image",
              "resources",
              "network"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "image": {
                "type": "object",
                "required": [
                  "closure"
                ],
                "properties": {
                  "closure": {
                    "type": "string"
                  }
                }
              },
              "resources": {
                "type": "object",
                "properties": {
                  "cpu": {
                    "type": "integer"
                  },
                  "mem_mb": {
                    "type": "integer"
                  }
                }
              },
              "network": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "isolated",
                      "nat",
                      "bridged"
                    ]
                  }
                }
              },
              "secrets": {
                "type": "object",
                "properties": {
                  "required": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "manifest": {
                "type": "object",
                "description": "Optional inline runtime manifest fields; digest computed during planning.",
                "additionalProperties": true
              }
            }
          }
        },
        "devshells": {
          "type": "array",
          "description": "Optional developer shell targets (nix-shell/nix develop analogue).",
          "items": {
            "type": "object",
            "required": [
              "name",
              "packages"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "packages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "network": {
                "type": "string",
                "enum": [
                  "off",
                  "restricted",
                  "on"
                ]
              },
              "isolation": {
                "type": "string",
                "enum": [
                  "jail",
                  "microvm"
                ]
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  },
  "additionalProperties": true
}
