{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD witness policy (witness.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "policy_id",
    "created_at",
    "log_scope",
    "witnesses",
    "quorum",
    "shortfall"
  ],
  "properties": {
    "kind": {
      "const": "witness.policy"
    },
    "policy_version": {
      "type": "string",
      "const": "0.1"
    },
    "policy_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "log_scope": {
      "type": "object",
      "required": [
        "allowed_log_uris"
      ],
      "properties": {
        "allowed_log_uris": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "allowed_log_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "witnesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "witness_id",
          "key_id",
          "operator_group"
        ],
        "properties": {
          "witness_id": {
            "type": "string"
          },
          "key_id": {
            "type": "string"
          },
          "operator_group": {
            "type": "string",
            "description": "Local diversity bucket used to prevent one operator from satisfying quorum alone."
          },
          "role": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "fleet",
              "regulator",
              "custom"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "quorum": {
      "type": "object",
      "required": [
        "min_witnesses"
      ],
      "properties": {
        "min_witnesses": {
          "type": "integer",
          "minimum": 1
        },
        "min_operator_groups": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "shortfall": {
      "type": "object",
      "required": [
        "publish",
        "consume"
      ],
      "properties": {
        "publish": {
          "type": "string",
          "enum": [
            "deny",
            "degrade",
            "allow"
          ]
        },
        "consume": {
          "type": "string",
          "enum": [
            "deny",
            "degrade",
            "allow"
          ]
        },
        "monitor_alert_severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        }
      },
      "additionalProperties": false
    },
    "rotation": {
      "type": "object",
      "properties": {
        "minimum_overlap_witnesses": {
          "type": "integer",
          "minimum": 0
        },
        "allow_retired_keys_until": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "sig"
        ],
        "properties": {
          "key_id": {
            "type": "string"
          },
          "sig": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
