{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD derive unit compile receipt (derive.unit.compile.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "authority_semantics",
    "issued_at",
    "source_unit",
    "runtime_source_mode",
    "compiler",
    "compiled_outputs"
  ],
  "properties": {
    "kind": {
      "const": "derive.unit.compile.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "authority_semantics": {
      "type": "string",
      "const": "derive-unit-compilation-evidence-only",
      "description": "Explicitly marks derive.unit.compile.receipt as evidence about source→compiled-runtime compilation, not launch or policy authority."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_unit": {
      "type": "object",
      "required": [
        "id",
        "digest",
        "schema_path",
        "example_path"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "schema_path": {
          "type": "string",
          "minLength": 1
        },
        "example_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime_source_mode": {
      "type": "string",
      "enum": [
        "rootfs",
        "strata"
      ]
    },
    "compiler": {
      "type": "object",
      "required": [
        "tool",
        "artifact_digest",
        "invocation_profile",
        "sandbox_profile",
        "network_access"
      ],
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string"
        },
        "artifact_digest": {
          "type": "string"
        },
        "invocation_profile": {
          "type": "string"
        },
        "sandbox_profile": {
          "type": "string",
          "enum": [
            "builtin-compiler",
            "hermetic",
            "workspace-only",
            "custom"
          ]
        },
        "network_access": {
          "type": "string",
          "enum": [
            "forbidden",
            "allowed"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "compiled_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "digest",
          "schema_path",
          "example_path",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "minLength": 1
          },
          "schema_path": {
            "type": "string",
            "minLength": 1
          },
          "example_path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "runtime-ir",
              "launch-authority",
              "budget",
              "supporting-evidence"
            ]
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
