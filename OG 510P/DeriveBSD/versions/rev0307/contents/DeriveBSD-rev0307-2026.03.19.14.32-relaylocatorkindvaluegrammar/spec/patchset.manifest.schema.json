{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD patchset manifest (v0)",
  "type": "object",
  "required": [
    "kind",
    "manifest_version",
    "target",
    "replacements",
    "rollback"
  ],
  "properties": {
    "kind": {"const": "patchset"},
    "manifest_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "target": {
      "type": "object",
      "required": ["kind", "digest"],
      "properties": {
        "kind": {"type": "string", "enum": ["base.set", "host.generation"]},
        "digest": {"type": "string"}
      },
      "additionalProperties": true
    },
    "advisory": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "url": {"type": "string"},
        "summary": {"type": "string"}
      },
      "additionalProperties": true
    },
    "replacements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "digest"],
        "properties": {
          "path": {"type": "string"},
          "digest": {"type": "string"},
          "mode": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "rollback": {
      "type": "object",
      "required": ["digest"],
      "properties": {
        "digest": {"type": "string", "description": "Digest pointer to rollback payload."}
      },
      "additionalProperties": true
    },
    "expiry": {"type": "string", "format": "date-time"},
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key_id", "sig"],
        "properties": {
          "key_id": {"type": "string"},
          "sig": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
