{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD parser registry (parser.registry) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "registry_version",
    "registry_id",
    "created_at",
    "parsers"
  ],
  "properties": {
    "kind": { "const": "parser.registry" },
    "registry_version": { "type": "string", "const": "0.1" },
    "registry_id": { "type": "string", "description": "Stable id for this registry (digest recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "plan_digest": { "type": "string", "description": "Optional plan/generation digest this registry was derived for." },

    "parsers": {
      "type": "array",
      "items": { "$ref": "#/$defs/parser" }
    }
  },
  "$defs": {
    "parser": {
      "type": "object",
      "required": [
        "id",
        "class",
        "input_class",
        "privilege"
      ],
      "properties": {
        "id": { "type": "string", "description": "Stable id, e.g. parser.file.zip or parser.uapi.ioctl.usb_hid" },

        "class": {
          "type": "string",
          "enum": ["file", "network", "uapi", "device", "schema", "other"],
          "description": "High-level parser class (review routing / policy defaults)."
        },
        "input_class": {
          "type": "string",
          "enum": ["untrusted.file", "untrusted.network", "untrusted.device", "untrusted.kernel", "semi.trusted"],
          "description": "What adversary controls the bytes?"
        },
        "privilege": {
          "type": "string",
          "enum": ["unprivileged", "service", "broker", "kernel", "firmware"],
          "description": "Where does it run?"
        },

        "stability": {
          "type": "string",
          "enum": ["stable", "provisional", "deprecated", "internal"],
          "default": "provisional"
        },
        "owner": { "type": "string" },
        "since": { "type": "string" },

        "implementation": {
          "type": "object",
          "description": "Optional pointers to implementation identity (component/service + source path).",
          "properties": {
            "component_id": { "type": "string" },
            "binary_digest": { "type": "string" },
            "source_path": { "type": "string" },
            "language": { "type": "string" },
            "notes": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },

        "surface_links": {
          "type": "object",
          "description": "Optional linkage to other surface registries.",
          "properties": {
            "contracts": { "type": "array", "items": { "type": "string" } },
            "uapi": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },

        "tests": {
          "type": "object",
          "description": "Optional test linkage (conformance + fuzz).",
          "properties": {
            "conformance": { "type": "string" },
            "fuzz": { "type": "string" },
            "proof": { "type": "string", "description": "Optional proof bundle/receipt ref for a high-assurance parser lane." }
          },
          "additionalProperties": false
        },

        "risk_tags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
