{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD hardware compatibility report (hw.compat.report) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "report_version",
    "report_id",
    "created_at",
    "hw_inventory_digest",
    "target",
    "status",
    "findings"
  ],
  "properties": {
    "kind": {
      "const": "hw-compat-report"
    },
    "report_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "report_id": {
      "type": "string",
      "description": "Stable id for this report (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "hw_inventory_digest": {
      "type": "string",
      "description": "Digest of the hw.inventory.receipt used as input."
    },
    "target": {
      "type": "object",
      "required": [
        "generation_digest",
        "release_train"
      ],
      "properties": {
        "generation_digest": {
          "type": "string"
        },
        "closure_digest": {
          "type": "string"
        },
        "boot_manifest_digest": {
          "type": "string"
        },
        "release_train": {
          "type": "string"
        },
        "release_capsule_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "policy_decision_digest": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "warn",
        "fail"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "missing-driver",
              "missing-module",
              "missing-firmware",
              "unsupported-device",
              "policy-denied",
              "binding-mismatch",
              "requires-reboot",
              "boot-path-risk",
              "network-floor-risk",
              "fingerprint-risk",
              "support-matrix-miss",
              "trusted-ui-floor-risk",
              "support-condition-triggered",
              "recovery-path-missing",
              "qualification-target-mismatch",
              "qualification-stale",
              "qualification-revoked",
              "qualification-superseded",
              "unknown"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warn",
              "error"
            ]
          },
          "device_id": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Digests or pointers to related receipts/plans."
          }
        },
        "additionalProperties": false
      }
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "allow",
            "allow-with-warning",
            "deny",
            "require-breakglass"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "support_matrix": {
      "type": "object",
      "description": "Optional join state when a hardware support matrix participates in the decision.",
      "properties": {
        "matrix_digest": {
          "type": "string"
        },
        "match_state": {
          "type": "string",
          "enum": [
            "not-used",
            "matched",
            "miss",
            "conditional"
          ]
        },
        "matched_entry_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "matched_qualification_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Qualification receipts backing the matched support entries."
        },
        "notes": {
          "type": "string"
        },
        "matched_condition_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Published condition ids from matched support entries that participated in the report outcome."
        },
        "matched_target_binding": {
          "type": "string",
          "enum": [
            "exact-artifact-digest",
            "same-release-train",
            "same-release-train-and-boot-manifest"
          ]
        },
        "target_scope_state": {
          "type": "string",
          "enum": [
            "match",
            "mismatch",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
