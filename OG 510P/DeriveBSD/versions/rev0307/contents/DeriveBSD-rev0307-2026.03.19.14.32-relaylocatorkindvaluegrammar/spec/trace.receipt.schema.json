{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD trace session receipt (trace.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "session_digest",
    "at",
    "phase"
  ],
  "properties": {
    "kind": {
      "const": "trace.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string"
    },
    "session_digest": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "phase": {
      "type": "string",
      "enum": [
        "started",
        "stopped"
      ]
    },
    "debug_lease_id": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
