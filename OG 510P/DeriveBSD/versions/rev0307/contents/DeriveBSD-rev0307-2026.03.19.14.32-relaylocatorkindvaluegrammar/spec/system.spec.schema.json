{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD authoring Spec (system) (v0.1)",
  "description": "A minimal system-oriented authoring format (host services + host networking) that compiles to Derive IR.",
  "allOf": [
    { "$ref": "minimal.spec.schema.json" },
    {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "system": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "hostName": { "type": "string", "minLength": 1 },
            "services": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "enable": { "type": "boolean" }
                }
              }
            },
            "networking": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "pf": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "enable": { "type": "boolean" },
                    "anchors": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
