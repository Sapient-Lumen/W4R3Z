{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Activation Claim Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "claim_version",
    "capset_digest",
    "service",
    "claimed_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "activation-claim"},
    "claim_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "capset_digest": {"type": "string", "description": "Digest of canonical activation.capset bytes."},

    "service": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": {"type": "string"},
        "digest": {"type": "string"},
        "instance": {"type": "string"}
      },
      "additionalProperties": false
    },

    "process": {
      "type": "object",
      "description": "Where the instance ran (host/jail/microVM).",
      "properties": {
        "pid": {"type": "integer"},
        "jail_id": {"type": "string"},
        "microvm_id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "claimed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "cap_ref": {"type": "string"},
          "lease_id": {"type": "string"}
        },
        "additionalProperties": false
      }
    },

    "notes": {"type": "object", "additionalProperties": true},

    "claimed_at": {"type": "string", "description": "ISO8601 time."},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
