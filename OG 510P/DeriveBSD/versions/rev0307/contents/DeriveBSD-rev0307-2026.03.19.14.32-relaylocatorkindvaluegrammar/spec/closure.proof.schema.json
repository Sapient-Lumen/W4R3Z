{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Closure Proof (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "proof_version",
    "closure_manifest_digest",
    "target_kind",
    "namespace",
    "issued_at",
    "expires_at",
    "key_id",
    "signature"
  ],
  "properties": {
    "kind": {"const": "closure-proof"},
    "proof_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "closure_manifest_digest": {"type": "string"},
    "target_kind": {"type": "string", "enum": ["host", "microvm"]},
    "namespace": {"type": "string"},
    "issued_at": {"type": "string"},
    "expires_at": {"type": "string"},
    "key_id": {"type": "string"},
    "signature": {
      "type": "object",
      "required": ["alg", "sig"],
      "properties": {
        "alg": {"type": "string"},
        "sig": {"type": "string", "description": "Detached signature bytes (encoding policy-defined)."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
