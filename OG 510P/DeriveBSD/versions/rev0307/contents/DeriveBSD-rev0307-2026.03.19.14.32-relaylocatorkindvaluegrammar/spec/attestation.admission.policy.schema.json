{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD attestation admission policy (attestation.admission.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "created_at",
    "rules"
  ],
  "properties": {
    "kind": { "const": "attestation-admission-policy" },
    "policy_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "policy_id": {
      "type": "string",
      "description": "Stable id (UUID recommended)."
    },
    "created_at": { "type": "string", "format": "date-time" },

    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action",
          "selector",
          "requirement_ref"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "Admission-gated action (issue-identity, unseal-secrets, join-fleet, promote-update, allow-remote-assist, ...).",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
          },
          "selector": {
            "type": "object",
            "description": "Subject selector for which hosts/nodes this rule applies to.",
            "properties": {
              "fleet": { "type": "string" },
              "host_class": { "type": "string" },
              "match_labels": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            },
            "additionalProperties": false
          },
          "requirement_ref": {
            "type": "string",
            "description": "Digest/id of an attestation.requirement object."
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
