{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD state migration receipt (state-migration-receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "created_at",
    "host_id",
    "volume_id",
    "from",
    "to",
    "status"
  ],
  "properties": {
    "kind": { "const": "state-migration-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "receipt_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "host_id": { "type": "string" },
    "volume_id": { "type": "string" },
    "dataset": { "type": "string" },
    "from": { "type": "string" },
    "to": { "type": "string" },
    "plan_digest": { "type": "string" },
    "migration_artifact_digest": { "type": "string" },
    "pre_snapshot": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Snapshot name (dataset@snap)." },
        "hold_tag": { "type": "string" }
      },
      "additionalProperties": false
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["success", "failed", "skipped"]
    },
    "error": {
      "type": "object",
      "properties": {
        "class": { "type": "string", "description": "Classification (precondition, timeout, script-error, invariant-violation)." },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "event_segment_digests": { "type": "array", "items": { "type": "string" } },
        "incident_bundle_digest": { "type": "string" }
      },
      "additionalProperties": false
    },
    "signature": { "type": "string" }
  },
  "additionalProperties": false
}
