{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Intent Role Binding (intent.role.binding) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "binding_version",
    "binding_id",
    "host_id",
    "profile_id",
    "issued_at",
    "bindings",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "intent.role.binding"
    },
    "binding_version": {
      "type": "string",
      "const": "0.1"
    },
    "binding_id": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string",
      "enum": [
        "fleet_host",
        "workstation",
        "general_os",
        "appliance_factory"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_snapshot_digest": {
      "type": "string"
    },
    "previous_binding_digest": {
      "type": "string"
    },
    "bindings": {
      "type": "object",
      "required": [
        "browsing",
        "communications"
      ],
      "properties": {
        "browsing": {
          "$ref": "#/$defs/roleBinding"
        },
        "communications": {
          "$ref": "#/$defs/roleBinding"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "roleBinding": {
      "type": "object",
      "required": [
        "default_target",
        "enrolled_targets"
      ],
      "properties": {
        "default_target": {
          "$ref": "#/$defs/target"
        },
        "enrolled_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "target_id",
        "target_kind"
      ],
      "properties": {
        "target_id": {
          "type": "string"
        },
        "target_kind": {
          "type": "string",
          "enum": [
            "persistent-compartment",
            "disposable-template"
          ]
        },
        "compartment_id": {
          "type": "string"
        },
        "template_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "target_kind": {
                "const": "persistent-compartment"
              }
            }
          },
          "then": {
            "required": [
              "compartment_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "target_kind": {
                "const": "disposable-template"
              }
            }
          },
          "then": {
            "required": [
              "template_id"
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
