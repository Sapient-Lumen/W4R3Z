{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD sysctl plan (sysctl.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "settings"
  ],
  "properties": {
    "kind": { "const": "sysctl-plan" },
    "plan_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "plan_id": { "type": "string", "description": "Stable id for the plan (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "requested_by": { "type": "string", "description": "Opaque operator/workflow id (optional)." },

    "target": {
      "type": "object",
      "description": "Where to apply the sysctls (host/domain).",
      "properties": {
        "host_id": { "type": "string" },
        "domain": { "type": "string", "description": "Optional compartment/domain identifier." }
      },
      "additionalProperties": false
    },

    "settings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "value"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]+$" },
          "value": { "type": "string", "description": "Sysctl value encoded as a string (sysctl(8) compatible)." },
          "require_exists": { "type": "boolean", "default": true, "description": "If true, missing keys are errors." },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "apply": {
      "type": "object",
      "description": "Application posture (kept small; prefer higher-level change-set policy).",
      "properties": {
        "mode": { "type": "string", "enum": ["set"], "default": "set" },
        "commit_confirmed": { "type": "boolean", "default": false, "description": "If true, apply under commit-confirmed transaction semantics." },
        "confirm_ttl_seconds": { "type": "integer", "minimum": 1, "description": "TTL for confirmation when commit_confirmed is true." }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
