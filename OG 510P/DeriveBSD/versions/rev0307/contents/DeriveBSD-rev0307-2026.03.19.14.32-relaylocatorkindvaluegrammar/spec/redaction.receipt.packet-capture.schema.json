{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD packet-capture normalization redaction receipt profile (redaction.receipt.packet-capture) (v0.1)",
  "allOf": [
    {
      "$ref": "redaction.receipt.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "redaction-receipt"
        },
        "receipt_version": {
          "const": "0.1"
        },
        "summary": {
          "type": "object",
          "required": [
            "input_metadata_posture",
            "output_metadata_posture",
            "removed_elements",
            "promotion_verdict"
          ],
          "properties": {
            "input_metadata_posture": {
              "type": "string",
              "enum": [
                "sideband-metadata-present",
                "decryption-material-present"
              ]
            },
            "output_metadata_posture": {
              "const": "packet-records-only"
            },
            "removed_elements": {
              "type": "object",
              "required": [
                "decryption_secrets_blocks_removed",
                "name_resolution_blocks_removed",
                "packet_comments_removed",
                "capture_comments_removed"
              ],
              "properties": {
                "decryption_secrets_blocks_removed": {
                  "type": "integer",
                  "minimum": 0
                },
                "name_resolution_blocks_removed": {
                  "type": "integer",
                  "minimum": 0
                },
                "packet_comments_removed": {
                  "type": "integer",
                  "minimum": 0
                },
                "capture_comments_removed": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "promotion_verdict": {
              "type": "string",
              "enum": [
                "ordinary-review-export-eligible",
                "summary-only"
              ]
            },
            "summary_digest": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "receipt_version",
        "summary"
      ]
    }
  ]
}
