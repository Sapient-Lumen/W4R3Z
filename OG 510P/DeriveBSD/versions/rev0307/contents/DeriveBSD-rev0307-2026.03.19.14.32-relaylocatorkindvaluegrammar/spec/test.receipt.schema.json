{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD test receipt (test.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "issued_at",
    "artifact_digest",
    "testsuite_digest",
    "runner_digest",
    "sandbox_profile_digest",
    "result_summary"
  ],
  "properties": {
    "kind": {
      "const": "test.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_digest": {
      "type": "string"
    },
    "testsuite_digest": {
      "type": "string"
    },
    "runner_digest": {
      "type": "string"
    },
    "sandbox_profile_digest": {
      "type": "string"
    },
    "result_summary": {
      "type": "object",
      "required": [
        "status",
        "passed",
        "failed"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "report_digest": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
