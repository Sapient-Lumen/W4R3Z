{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD chaos experiment receipt (chaos.experiment.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_digest",
    "started_at",
    "ended_at",
    "targets",
    "outcome"
  ],
  "properties": {
    "kind": { "const": "chaos-experiment-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "receipt_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },

    "plan_digest": { "type": "string", "description": "Digest/id of the chaos.experiment.plan that ran." },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },

    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["host_id"],
        "properties": {
          "host_id": { "type": "string" },
          "instance_id": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "target": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "outcome": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail", "aborted"] },
        "reason": { "type": "string" },
        "safety_stop_triggered": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "correlation": {
      "type": "object",
      "properties": {
        "change_id": { "type": "string" },
        "incident_id": { "type": "string" },
        "trace_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "signature": {
      "type": "object",
      "description": "Optional signature of the receipt body for portability.",
      "properties": {
        "key_id": { "type": "string" },
        "sig": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
