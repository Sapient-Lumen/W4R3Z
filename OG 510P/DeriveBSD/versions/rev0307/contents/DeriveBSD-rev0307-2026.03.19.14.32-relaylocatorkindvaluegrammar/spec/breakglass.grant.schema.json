{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD breakglass access grant (breakglass-grant) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "grant_id",
    "created_at",
    "subject",
    "scope"
  ],
  "properties": {
    "kind": {
      "const": "breakglass-grant"
    },
    "grant_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "grant_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string",
      "description": "Canonical cross-lane lease identifier for this grant. When present, SHOULD equal grant_id (legacy)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string",
      "description": "Human justification (ticket id recommended)."
    },
    "subject": {
      "type": "object",
      "required": [
        "host_id"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "fleet": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "description": "What authority is granted in recovery mode.",
      "properties": {
        "ops": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "shell",
              "derive-rollback",
              "derive-apply",
              "mount-rw",
              "network",
              "export-support-bundle"
            ]
          }
        },
        "allowed_methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "console",
              "serial",
              "ssh",
              "oob"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "timebox_minutes": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "two_person": {
          "type": "boolean",
          "default": false
        },
        "approvers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "require_attestation": {
          "type": "boolean",
          "default": false
        },
        "attestation_requirement_digest": {
          "type": "string"
        },
        "min_lockdown_level": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
