{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD persistence set registry (persist.set.registry) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "registry_version",
    "created_at",
    "generation_digest",
    "sets"
  ],
  "properties": {
    "kind": { "const": "persist.set.registry" },
    "registry_version": { "type": "string", "const": "0.1" },
    "registry_id": { "type": "string", "description": "Stable id for this registry (digest recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "generation_digest": {
      "type": "string",
      "description": "Digest of the generation/deployment object this registry was derived for."
    },

    "derived_from": {
      "type": "object",
      "description": "Optional pointers to upstream plans/locks used to compile persistence.",
      "properties": {
        "spec_digest": { "type": "string" },
        "lock_digest": { "type": "string" },
        "plan_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "sets": {
      "type": "array",
      "items": { "$ref": "#/$defs/persist_set" }
    }
  },
  "$defs": {
    "persist_set": {
      "type": "object",
      "required": [
        "id",
        "scope",
        "ephemeral_root",
        "mounts",
        "binds"
      ],
      "properties": {
        "id": { "type": "string", "description": "Stable identifier for the persist set (e.g., host.default)." },
        "description": { "type": "string" },

        "scope": {
          "type": "string",
          "enum": ["host", "userenv", "workload"],
          "description": "Which plane the persistence model applies to."
        },

        "ephemeral_root": {
          "type": "boolean",
          "description": "If true, the root filesystem is treated as discardable; only the persist set survives generation switches."
        },

        "mounts": {
          "type": "array",
          "description": "Persistent dataset mounts (explicit, reviewable persistence roots).",
          "items": { "$ref": "#/$defs/persist_mount" }
        },

        "binds": {
          "type": "array",
          "description": "Persistent path binds into an otherwise derived/ephemeral root.",
          "items": { "$ref": "#/$defs/persist_bind" }
        },

        "policy_handles": {
          "type": "object",
          "description": "Optional operator policy handles referenced by this persist set.",
          "properties": {
            "retention": { "type": "string" },
            "redaction": { "type": "string" }
          },
          "additionalProperties": false
        },

        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "persist_mount": {
      "type": "object",
      "required": [
        "dataset",
        "mountpoint",
        "mode"
      ],
      "properties": {
        "id": { "type": "string" },
        "purpose": { "type": "string" },

        "dataset": {
          "type": "string",
          "description": "ZFS dataset or zvol identifier (e.g., zroot/persist)."
        },

        "mountpoint": { "type": "string", "description": "Target mountpoint (e.g., /persist, /var, /home)." },
        "mode": { "type": "string", "enum": ["ro", "rw"] },

        "encryption_required": { "type": "boolean" },

        "sensitive": {
          "type": "boolean",
          "description": "If true, support bundles must treat payload contents as sensitive by default (metadata-only unless policy grants)."
        }
      },
      "additionalProperties": false
    },

    "persist_bind": {
      "type": "object",
      "required": [
        "target",
        "source",
        "mode",
        "semantics"
      ],
      "properties": {
        "target": { "type": "string", "description": "Path inside the runtime root (e.g., /etc/ssh)." },

        "source": {
          "type": "object",
          "required": ["dataset", "path"],
          "properties": {
            "dataset": { "type": "string", "description": "Dataset providing the persisted content (often a /persist root)." },
            "path": { "type": "string", "description": "Path within the dataset (relative), e.g. etc/ssh." }
          },
          "additionalProperties": false
        },

        "mode": { "type": "string", "enum": ["ro", "rw"] },

        "semantics": {
          "type": "string",
          "enum": ["bind", "copy-up"],
          "description": "bind: direct bind mount; copy-up: copy-on-first-write overlay semantics."
        },

        "sensitive": {
          "type": "boolean",
          "description": "If true, bundle exports should prefer metadata-only unless policy grants payload export."
        },

        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
