{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD drift bundle (drift.bundle) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "bundle_version",
    "created_at",
    "from",
    "to",
    "artifacts"
  ],
  "properties": {
    "kind": {
      "const": "drift.bundle"
    },
    "bundle_version": {
      "type": "string",
      "const": "0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "from": {
      "$ref": "#/$defs/ref"
    },
    "to": {
      "$ref": "#/$defs/ref"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "minItems": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "authority_edges_added": {
          "type": "integer",
          "minimum": 0
        },
        "trust_boundaries_added": {
          "type": "integer",
          "minimum": 0
        },
        "parsers_added": {
          "type": "integer",
          "minimum": 0
        },
        "uapi_surfaces_changed": {
          "type": "integer",
          "minimum": 0
        },
        "contracts_changed": {
          "type": "integer",
          "minimum": 0
        },
        "crypto_changes": {
          "type": "integer",
          "minimum": 0
        },
        "policy_surfaces_changed": {
          "type": "integer",
          "minimum": 0
        },
        "store_paths_added": {
          "type": "integer",
          "minimum": 0
        },
        "store_paths_removed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "e.g., blast_radius.diff, authority.diff, parser.diff"
        },
        "path": {
          "type": "string",
          "description": "repo-relative path or exported bundle path"
        },
        "digest": {
          "type": "string",
          "description": "optional digest of the artifact bytes"
        },
        "surface_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "policy.test.report, fuzz.receipt, proof.bundle, etc"
        },
        "path": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}