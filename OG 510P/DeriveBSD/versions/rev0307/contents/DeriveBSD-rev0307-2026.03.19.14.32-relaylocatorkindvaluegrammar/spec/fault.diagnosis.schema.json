{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Fault Diagnosis (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diagnosis_version",
    "diagnosis_id",
    "issued_at",
    "engine",
    "events",
    "suspects",
    "recommended_actions",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "fault-diagnosis"
    },
    "diagnosis_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "diagnosis_id": {
      "type": "string",
      "description": "Stable id (UUID recommended) for correlation."
    },
    "issued_at": {
      "type": "string",
      "description": "RFC3339 timestamp."
    },
    "engine": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "policy_digest": {
          "type": "string",
          "description": "Optional digest binding diagnosis behavior to a policy/ruleset."
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Event ids or digests this diagnosis is based on."
    },
    "suspects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource",
          "confidence"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "description": "Resource identifier (device, service, dataset, etc.)."
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "priority"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "Short action key (e.g., offline-vdev, drain-host, notify-operator)."
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "urgent"
            ]
          },
          "params": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
