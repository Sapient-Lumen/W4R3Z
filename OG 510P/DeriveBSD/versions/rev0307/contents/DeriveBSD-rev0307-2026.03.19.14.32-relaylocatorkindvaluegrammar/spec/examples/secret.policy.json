{
  "kind": "secret-policy",
  "policy_version": "0.1",
  "policy_id": "a6b0b4a8-5f1b-4f0f-bb42-2b8c1d2c8aa1",
  "created_at": "2026-02-24T23:45:00Z",
  "secrets": [
    {
      "secret_id": "db/postgres/app1",
      "class": "password",
      "description": "Postgres password for app1",
      "source": {
        "mode": "provider",
        "provider": {
          "name": "vault",
          "path": "database/creds/app1"
        }
      },
      "rotation": {
        "lease_seconds": 3600
      },
      "access": {
        "selectors": [
          { "service_id": "svc:app1" }
        ],
        "delivery": ["memfd", "ramfs"],
        "require_attestation": false
      },
      "audit": {
        "emit_events": true,
        "emit_denials": true
      }
    },
    {
      "secret_id": "host/node-identity-key",
      "class": "ssh-key",
      "description": "Node identity key, bound to host boot state",
      "source": {
        "mode": "tpm2-sealed",
        "tpm2": {
          "bind_to_host": true,
          "pcr_policy": "sha256:0,2,4,7"
        }
      },
      "rotation": {
        "rotation_interval_days": 90
      },
      "access": {
        "selectors": [
          { "service_id": "svc:ssh" }
        ],
        "delivery": ["ramfs", "fd"],
        "require_attestation": true,
        "attestation_ref": "blake3:boot-attest-policy..."
      }
    }
  ],
  "notes": "Provider-backed app secrets + TPM2-sealed host identity key"
}
