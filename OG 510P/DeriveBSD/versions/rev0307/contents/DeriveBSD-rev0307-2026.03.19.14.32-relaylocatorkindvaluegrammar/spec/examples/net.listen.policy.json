{
  "kind": "net-listen-policy",
  "policy_version": "0.1",
  "classes": [
    {
      "name": "loopback-http",
      "description": "Listen only on loopback for local HTTP admin/debug UIs.",
      "permissions": {
        "listen": [
          {
            "proto": "tcp",
            "ports": [8080, 9090],
            "bind_cidrs": ["127.0.0.1/32", "::1/128"],
            "allow_from_cidrs": ["127.0.0.1/32", "::1/128"]
          }
        ]
      },
      "defaults": {"ttl_seconds": 7200, "max_connections": 100}
    },
    {
      "name": "public-https",
      "description": "Public HTTPS listener (WAN).",
      "permissions": {
        "listen": [
          {
            "proto": "tcp",
            "ports": [443],
            "bind_cidrs": ["0.0.0.0/32", "::/128"],
            "allow_from_cidrs": ["0.0.0.0/0", "::/0"]
          }
        ]
      },
      "defaults": {"ttl_seconds": 86400, "max_connections": 100000}
    }
  ],
  "issued_at": "2026-02-25T00:00:00Z",
  "signature": {
    "key_id": "ed25519:example",
    "alg": "ed25519",
    "sig": "base64..."
  }
}
