{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD mirror kit promotion receipt (mirror.promote.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_digest",
    "policy_digest",
    "from_quarantine",
    "into_channel",
    "promotion",
    "result"
  ],
  "properties": {
    "kind": { "const": "mirror.promote.receipt" },
    "receipt_version": { "type": "string", "const": "0.1" },
    "receipt_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },

    "plan_digest": { "type": "string" },
    "policy_digest": { "type": "string" },

    "from_quarantine": {
      "type": "object",
      "required": ["quarantine_id"],
      "properties": {
        "quarantine_id": { "type": "string" },
        "cache_state_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "into_channel": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "mode": { "type": "string", "enum": ["merge", "replace"] }
      },
      "additionalProperties": false
    },

    "promotion": {
      "type": "object",
      "description": "What changed as a result of promotion.",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "deny", "fail"] },
        "transaction_id": { "type": "string" },
        "objects_promoted": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["digest", "type"],
            "properties": {
              "digest": { "type": "string" },
              "type": { "type": "string", "enum": ["metadata", "artifact", "delta", "source"] },
              "size_bytes": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "counts": {
          "type": "object",
          "properties": {
            "objects_promoted": { "type": "integer", "minimum": 0 },
            "bytes_promoted": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "channel_state_digest": { "type": "string", "description": "Digest of resulting channel state (implementation-defined)." },
        "transparency_entry_digest": { "type": "string", "description": "Optional digest for publication into a transparency lane." }
      },
      "additionalProperties": false
    },

    "evidence": {
      "type": "object",
      "properties": {
        "policy_trace_digest": { "type": "string" },
        "event_segment_digests": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "result": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "deny", "fail"] },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
