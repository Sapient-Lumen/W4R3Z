{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD on-demand tree mount plan (tree.mount.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "target",
    "backend",
    "projection"
  ],
  "properties": {
    "kind": {
      "const": "tree.mount.plan"
    },
    "plan_version": {
      "type": "string",
      "const": "0.1"
    },
    "plan_id": {
      "type": "string",
      "description": "Stable id for the plan (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation/domain/service).",
      "properties": {
        "host_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "domain_kind": {
          "type": "string",
          "enum": [
            "host",
            "jail",
            "microvm"
          ]
        },
        "domain_id": {
          "type": "string"
        },
        "service_id": {
          "type": "string"
        },
        "generation_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "description": "What tree is being mounted and where.",
      "required": [
        "mount_point",
        "tree_digest"
      ],
      "properties": {
        "mount_point": {
          "type": "string"
        },
        "tree_digest": {
          "type": "string",
          "description": "Content-addressed digest identifying the tree being mounted (store handle)."
        },
        "tree_kind": {
          "type": "string",
          "enum": [
            "rootfs",
            "stratum",
            "data",
            "other"
          ],
          "default": "rootfs"
        },
        "readonly": {
          "type": "boolean",
          "default": true
        },
        "expected_size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "description": "Which transport/format backend satisfies the tree.",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "composefs",
            "estargz",
            "nydus",
            "local",
            "zfs_clone",
            "other"
          ]
        },
        "endpoint": {
          "type": "string",
          "description": "Optional endpoint (URL, mirror name, or store locator)."
        },
        "cache_root": {
          "type": "string",
          "description": "Optional cache root (backend-specific)."
        },
        "integrity": {
          "$ref": "#/$defs/integrity"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "policy_digest": {
      "type": "string",
      "description": "Digest of a policy module authorizing the mount plan (optional)."
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_binding": {
      "type": "object",
      "description": "Optional digests of the reviewed object(s) that requested this projection, keeping transport subordinate to upstream deployment authority.",
      "properties": {
        "mount_view_digest": {
          "type": "string"
        },
        "closure_manifest_digest": {
          "type": "string"
        },
        "runtime_manifest_digest": {
          "type": "string"
        },
        "base_set_digest": {
          "type": "string"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "description": "How the tree is projected locally, which fallback is allowed, and how much fetch evidence may be emitted by default.",
      "required": [
        "mode",
        "fallback_policy",
        "fetch_evidence_scope",
        "constraints"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "materialize",
            "prefetch",
            "lazy"
          ]
        },
        "fallback_policy": {
          "type": "string",
          "enum": [
            "fail_closed",
            "materialize",
            "prefetch"
          ]
        },
        "fetch_evidence_scope": {
          "type": "string",
          "enum": [
            "digest-only",
            "path-level"
          ]
        },
        "prefetch_budget_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "constraints": {
          "type": "object",
          "description": "Plan-time capability requirements for the selected backend/posture.",
          "required": [
            "requires_verified_tree"
          ],
          "properties": {
            "requires_verified_tree": {
              "type": "boolean"
            },
            "requires_remote_range_fetch": {
              "type": "boolean"
            },
            "requires_local_cache": {
              "type": "boolean"
            },
            "requires_userspace_daemon": {
              "type": "boolean"
            },
            "requires_readonly_lower_store": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "integrity": {
      "type": "object",
      "description": "Optional integrity knobs (signatures/trust policy, transparency lanes, etc.).",
      "properties": {
        "trust_policy_digest": {
          "type": "string"
        },
        "attestation_admission_policy_digest": {
          "type": "string"
        },
        "require_verified_execution": {
          "type": "boolean"
        },
        "transparency_proof_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
