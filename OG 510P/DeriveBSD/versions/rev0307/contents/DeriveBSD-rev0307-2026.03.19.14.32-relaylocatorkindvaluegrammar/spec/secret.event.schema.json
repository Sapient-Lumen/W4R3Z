{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Secret Event (secret-event) (v0.1)",
  "allOf": [
    {
      "$ref": "event.record.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "event_version",
        "event_id",
        "at",
        "source",
        "class",
        "severity",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "secret-event"
        },
        "event_version": {
          "type": "string",
          "pattern": "^0\\.\\d+$"
        },
        "event_id": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "Emitter (e.g., secretsd, cred-broker, supervisor)."
            },
            "host_id": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "class": {
          "type": "string",
          "description": "secret.access.*, secret.rotation.*, secret.materialization.*"
        },
        "severity": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error",
            "critical",
            "fatal"
          ]
        },
        "payload": {
          "type": "object",
          "properties": {
            "secret_id": {
              "type": "string"
            },
            "subject": {
              "type": "object",
              "additionalProperties": true
            },
            "grant_id": {
              "type": "string"
            },
            "lease_id": {
              "type": "string"
            },
            "result": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "description": "Metadata-only payload. Must never contain secret bytes."
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
