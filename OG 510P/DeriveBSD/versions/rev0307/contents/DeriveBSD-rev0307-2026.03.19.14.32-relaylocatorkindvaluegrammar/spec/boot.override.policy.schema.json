{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD boot override policy (boot.override.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "issued_at",
    "allowed_overrides"
  ],
  "properties": {
    "kind": {
      "const": "boot.override.policy"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "policy_id": {
      "type": "string",
      "description": "Stable id (UUID recommended)."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "properties": {
        "deployment_ref_digest": {
          "type": "string"
        },
        "generation_id": {
          "type": "string"
        },
        "profile": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        }
      },
      "additionalProperties": false
    },
    "allowed_overrides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "next-entry",
              "boot-mode",
              "console-profile"
            ]
          },
          "allowed_values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "require_authorization": {
            "type": "boolean",
            "default": true
          },
          "allowed_sources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "boot-menu",
                "trusted-ui",
                "maintenance-specialisation",
                "recovery-token"
              ]
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "signature": {
      "type": "object",
      "description": "Optional signature over the policy payload.",
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
