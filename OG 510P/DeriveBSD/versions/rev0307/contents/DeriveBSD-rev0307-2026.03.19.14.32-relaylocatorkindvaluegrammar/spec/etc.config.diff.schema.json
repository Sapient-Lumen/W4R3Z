{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD /etc config drift diff (etc.config.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "base",
    "live",
    "entries_added",
    "entries_removed",
    "entries_changed"
  ],
  "properties": {
    "kind": { "const": "etc.config.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation).",
      "properties": {
        "host_id": { "type": "string" },
        "profile_id": { "type": "string", "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)." },
        "generation_id": { "type": "string" },
        "etc_root": { "type": "string", "description": "Live /etc root path (if nonstandard)." }
      },
      "additionalProperties": false
    },

    "base": { "$ref": "#/$defs/ref" },
    "live": { "$ref": "#/$defs/ref" },

    "entries_added": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "entries_removed": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "entries_changed": { "type": "array", "items": { "$ref": "#/$defs/change" } },

    "summary": {
      "type": "object",
      "properties": {
        "added": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": { "type": "string", "description": "Digest of the policy module(s) authorizing diff generation/export (optional)." },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "description": "A named tree reference (derived base vs live root).",
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "type": "string" },
        "digest": { "type": "string" },
        "store_path": { "type": "string" }
      },
      "additionalProperties": false
    },

    "meta": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["file", "dir", "symlink", "device", "other"] },
        "mode": { "type": "string", "description": "POSIX mode string (e.g. 0644)." },
        "uid": { "type": "integer", "minimum": 0 },
        "gid": { "type": "integer", "minimum": 0 },
        "mtime": { "type": "string", "format": "date-time" },
        "link_target": { "type": "string", "description": "If type=symlink, the link target." }
      },
      "additionalProperties": false
    },

    "entry": {
      "type": "object",
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "description": "Path relative to the /etc root." },
        "digest": { "type": "string", "description": "Digest of the entry contents (tree digest for dirs)." },
        "meta": { "$ref": "#/$defs/meta" },
        "reason": { "type": "string", "description": "Optional classifier (local override, runtime mutation, migration, ...)." }
      },
      "additionalProperties": false
    },

    "change": {
      "type": "object",
      "required": ["path", "from", "to"],
      "properties": {
        "path": { "type": "string" },
        "from": { "$ref": "#/$defs/entry" },
        "to": { "$ref": "#/$defs/entry" },
        "classification": { "type": "string", "enum": ["content", "metadata", "both"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
