{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI Input Stream Grant (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "subject",
    "stream",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": { "const": "ui-input-stream-grant" },
    "grant_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "lease_id": { "type": "string" },
    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string" },
        "digest": { "type": "string" },
        "instance": { "type": "string" }
      },
      "additionalProperties": false
    },
    "stream": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["keyboard", "pointer", "touch"] },
        "surface_id": { "type": "string", "description": "Optional UI surface/window identifier." }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "requires_foreground": { "type": "boolean" },
        "requires_user_gesture": { "type": "boolean" },
        "max_rate": { "type": "string", "description": "Optional event rate cap." },
        "expires_at": { "type": "string", "description": "ISO8601 time." }
      },
      "additionalProperties": true
    },
    "issued_at": { "type": "string", "description": "ISO8601 time." },
    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": { "type": "string" },
        "alg": { "type": "string" },
        "sig": { "type": "string", "description": "Signature over canonical JSON bytes." }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
