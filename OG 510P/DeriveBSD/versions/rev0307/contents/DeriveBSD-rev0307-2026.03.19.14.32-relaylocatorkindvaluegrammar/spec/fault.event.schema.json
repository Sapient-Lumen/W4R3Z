{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Fault Event (fault-event) (v0.1)",
  "allOf": [
    {
      "$ref": "event.record.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "event_version",
        "event_id",
        "at",
        "source",
        "class",
        "severity",
        "payload",
        "signature"
      ],
      "properties": {
        "kind": {
          "const": "fault-event"
        },
        "event_version": {
          "type": "string",
          "pattern": "^0\\.\\d+$"
        },
        "event_id": {
          "type": "string",
          "description": "Stable id (UUID recommended) for correlation."
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "description": "When the fault was observed (RFC3339)."
        },
        "source": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "Detector name (e.g., devd, zfs, smartd, service-probe)."
            },
            "host_id": {
              "type": "string"
            },
            "domain": {
              "type": "string",
              "description": "Optional domain identifier if emitted from a less-trusted compartment."
            }
          },
          "additionalProperties": false
        },
        "class": {
          "type": "string",
          "description": "Fault class/category (hierarchical strings encouraged)."
        },
        "severity": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error",
            "critical",
            "fatal"
          ]
        },
        "payload": {
          "type": "object",
          "description": "Detector-specific structured data."
        },
        "signature": {
          "type": "string",
          "description": "Signature over canonical bytes (see archive hashing rules)."
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
