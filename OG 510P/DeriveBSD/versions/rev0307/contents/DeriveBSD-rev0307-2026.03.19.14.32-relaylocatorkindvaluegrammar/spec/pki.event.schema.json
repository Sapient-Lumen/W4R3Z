{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD PKI event (pki-event) (v0.1)",
  "allOf": [
    {"$ref": "event.record.schema.json"},
    {
      "type": "object",
      "required": ["kind", "event_version", "event_id", "at", "source", "severity", "event_type"],
      "properties": {
        "kind": {"const": "pki-event"},
        "event_version": {"type": "string", "pattern": "^0\\.\\d+$"},
        "event_id": {"type": "string", "description": "Stable id (UUID recommended)."},
        "at": {"type": "string", "format": "date-time"},
        "source": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "description": "Producer name (pki-agent, issuer-adapter, etc.)."},
            "host_id": {"type": "string"}
          },
          "additionalProperties": false
        },
        "severity": {"type": "string", "enum": ["info", "warning", "error", "critical"]},
        "event_type": {
          "type": "string",
          "enum": [
            "pki.trust-bundle.updated",
            "pki.renewal.scheduled",
            "pki.issued",
            "pki.renewed",
            "pki.install.failed",
            "pki.revoked"
          ]
        },
        "identity_id": {"type": "string"},
        "pki_trust_bundle_digest": {"type": "string"},
        "pki_issue_receipt_digest": {"type": "string"}
      },
      "additionalProperties": false
    }
  ]
}
