{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Intent Route Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "request_digest",
    "decision",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "intent-route-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "request_digest": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "allow",
        "deny"
      ]
    },
    "handler": {
      "type": "object",
      "description": "Present only on allow. Identifies the chosen handler component.",
      "properties": {
        "service_name": {
          "type": "string"
        },
        "service_digest": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "policy_decision_digest": {
      "type": "string"
    },
    "portal_grant_digests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Portal grants minted as part of routing (file picks, bookmark claims, etc.)."
    },
    "consent_digest": {
      "type": "string",
      "description": "Optional digest of a consent receipt if interactive choice occurred."
    },
    "issued_at": {
      "type": "string",
      "description": "ISO8601 time."
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "target_role": {
      "type": "string",
      "description": "Trusted host-managed target role used for routing, such as browsing or communications."
    },
    "resolution_mode": {
      "type": "string",
      "enum": [
        "role-default",
        "trusted-chooser",
        "policy-pinned"
      ],
      "description": "How the target was selected within the trusted routing boundary."
    },
    "role_binding_digest": {
      "type": "string",
      "description": "Digest of the trusted remembered role-binding snapshot used for target selection."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "allow"
          }
        }
      },
      "then": {
        "required": [
          "handler",
          "target_role",
          "resolution_mode",
          "role_binding_digest"
        ]
      }
    }
  ]
}
