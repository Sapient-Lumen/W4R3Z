{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD kernel module event (kmod.event) (v0.1)",
  "allOf": [
    {
      "$ref": "event.record.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "event_version",
        "event_id",
        "at",
        "source",
        "severity",
        "subject",
        "action",
        "module"
      ],
      "properties": {
        "kind": { "const": "kmod-event" },
        "event_version": { "type": "string", "pattern": "^0\\.\\d+$" },
        "event_id": { "type": "string", "description": "Stable id (UUID recommended)." },
        "at": { "type": "string", "format": "date-time" },

        "source": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "description": "Emitter name (kmod-broker, kldstat-watcher, etc.)." },
            "host_id": { "type": "string" },
            "domain": { "type": "string" },
            "pid": { "type": "integer" },
            "uid": { "type": "integer" }
          },
          "additionalProperties": false
        },

        "severity": { "type": "string", "enum": ["info", "warning", "error", "critical"] },

        "subject": {
          "type": "object",
          "required": ["host_id"],
          "properties": {
            "host_id": { "type": "string" },
            "domain": { "type": "string" }
          },
          "additionalProperties": false
        },

        "action": { "type": "string", "enum": ["load", "unload", "deny", "drift-detected"] },

        "module": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "id": { "type": "integer", "minimum": 0, "description": "Kernel module id (kldstat-style) if available." },
            "path": { "type": "string" },
            "digest": { "type": "string" },
            "version": { "type": "string" }
          },
          "additionalProperties": false
        },

        "policy": {
          "type": "object",
          "properties": {
            "kmod_policy_digest": { "type": "string" },
            "matched_rule_id": { "type": "string" },
            "policy_decision_digest": { "type": "string" }
          },
          "additionalProperties": false
        },

        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  ]
}
