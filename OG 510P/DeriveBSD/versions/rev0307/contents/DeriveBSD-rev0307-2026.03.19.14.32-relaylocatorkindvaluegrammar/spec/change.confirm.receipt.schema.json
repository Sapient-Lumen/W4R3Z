{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD change confirmation receipt (change-confirm-receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "at",
    "change_set_digest",
    "result"
  ],
  "properties": {
    "kind": { "const": "change-confirm-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },

    "receipt_id": { "type": "string", "description": "Stable id (UUID recommended)." },
    "at": { "type": "string", "format": "date-time" },

    "change_set_digest": { "type": "string", "description": "Digest of the change-set being confirmed." },
    "change_receipt_digest": { "type": "string", "description": "Digest of the pending change-receipt (if available)." },

    "result": { "type": "string", "enum": ["confirmed", "rejected"], "description": "Whether confirmation was granted or explicitly rejected." },

    "actor": {
      "type": "object",
      "description": "Who/what performed the confirmation.",
      "properties": {
        "type": { "type": "string", "enum": ["human", "controller", "policy"] },
        "id": { "type": "string" },
        "method": { "type": "string", "description": "e.g., console, ssh, portal, api" }
      },
      "additionalProperties": false
    },

    "authority_ref": {
      "type": "object",
      "description": "Optional reference to a capability/grant used to authorize confirmation.",
      "required": ["kind", "digest"],
      "properties": {
        "kind": { "type": "string" },
        "digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "notes": { "type": "string" },

    "signature": {
      "type": "object",
      "description": "Optional signature over the receipt body.",
      "properties": {
        "alg": { "type": "string" },
        "key_id": { "type": "string" },
        "sig": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
