{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Redaction Transform (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "transform_version",
    "applies_to",
    "implementation",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "redaction-transform"},
    "transform_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "description": {"type": "string"},

    "applies_to": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["logs", "traces", "metrics", "audit", "coredump", "pcap", "other"]
      }
    },

    "policy": {
      "type": "object",
      "description": "Declarative redaction settings (allowlist-first recommended).",
      "properties": {
        "allow_attributes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "deny_attributes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "mask_patterns": {
          "type": "array",
          "items": {"type": "string", "description": "Implementation-defined pattern (regex/glob)."}
        },
        "drop_when_matches": {
          "type": "array",
          "items": {"type": "string", "description": "Implementation-defined predicate (keep small)."}
        }
      },
      "additionalProperties": false
    },

    "implementation": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["declarative", "wasm-module"]},
        "module_digest": {"type": "string", "description": "Digest of a sandboxed transform module (e.g., Wasm)."},
        "abi": {"type": "string", "description": "ABI identifier for module-based transforms."}
      },
      "additionalProperties": false
    },

    "context": {
      "type": "object",
      "properties": {
        "policy_snapshot_digest": {"type": "string"},
        "policy_decision_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "issued_at": {"type": "string"},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
