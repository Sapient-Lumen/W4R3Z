{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD attestation gate requirement (attestation.requirement) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "requirement_version",
    "created_at",
    "reference_digest",
    "min_verdict",
    "max_age_sec"
  ],
  "properties": {
    "kind": {
      "const": "attestation-requirement"
    },
    "requirement_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "requirement_id": {
      "type": "string",
      "description": "Stable id (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reference_digest": {
      "type": "string"
    },
    "policy_digest": {
      "type": "string"
    },
    "min_verdict": {
      "type": "string",
      "enum": [
        "pass",
        "degraded"
      ],
      "description": "Minimum acceptable verdict."
    },
    "max_age_sec": {
      "type": "integer",
      "minimum": 1,
      "description": "Receipt freshness requirement in seconds."
    },
    "require_runtime_integrity": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
