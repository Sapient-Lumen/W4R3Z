{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI DataTransfer Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "lease_id",
    "subject",
    "direction",
    "offer_id",
    "transferred_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "ui-datatransfer-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "lease_id": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "direction": {
      "type": "string",
      "enum": [
        "read",
        "write"
      ],
      "description": "Read = paste; write = copy/offer creation."
    },
    "offer_id": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer"
        },
        "mime_type": {
          "type": "string"
        },
        "redaction_profile_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "grant_exhausted": {
      "type": "boolean",
      "description": "True when the grant was exhausted after this transfer (the ordinary single-delivery case)."
    },
    "transferred_at": {
      "type": "string",
      "description": "ISO8601 time."
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
