{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD secrets policy (secret-policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "created_at",
    "secrets"
  ],
  "properties": {
    "kind": { "const": "secret-policy" },
    "policy_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "policy_id": { "type": "string", "description": "Stable id (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },
    "secrets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["secret_id", "class", "source", "access"],
        "properties": {
          "secret_id": { "type": "string" },
          "class": {
            "type": "string",
            "enum": ["password", "token", "tls-key", "ssh-key", "opaque"]
          },
          "description": { "type": "string" },
          "source": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["sealed-blob", "tpm2-sealed", "provider"]
              },
              "sealed_blob_digest": {
                "type": "string",
                "description": "Digest of an encrypted secret blob stored in the store (ciphertext only)."
              },
              "tpm2": {
                "type": "object",
                "properties": {
                  "pcr_policy": { "type": "string", "description": "Optional PCR policy descriptor/id." },
                  "bind_to_host": { "type": "boolean", "default": true }
                },
                "additionalProperties": true
              },
              "provider": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "description": "Provider adapter name (e.g., vault, kms, custom)." },
                  "path": { "type": "string", "description": "Provider-specific secret path/locator." },
                  "role": { "type": "string" }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "rotation": {
            "type": "object",
            "properties": {
              "rotation_interval_days": { "type": "integer", "minimum": 1 },
              "lease_seconds": { "type": "integer", "minimum": 1 },
              "rotate_on_boot": { "type": "boolean", "default": false }
            },
            "additionalProperties": false
          },
          "access": {
            "type": "object",
            "required": ["selectors", "delivery"],
            "properties": {
              "selectors": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "service_id": { "type": "string" },
                    "workload_label": { "type": "string" },
                    "vm_id": { "type": "string" },
                    "jail_id": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "delivery": {
                "type": "array",
                "items": { "type": "string", "enum": ["memfd", "ramfs", "file", "env", "fd"] }
              },
              "require_attestation": { "type": "boolean", "default": false },
              "attestation_ref": {
                "type": "string",
                "description": "Optional digest/id of a boot attestation policy or measurement record."
              }
            },
            "additionalProperties": false
          },
          "audit": {
            "type": "object",
            "properties": {
              "emit_events": { "type": "boolean", "default": true },
              "emit_denials": { "type": "boolean", "default": true }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": "string" },
    "signature": { "type": "string", "description": "Optional signature over canonical bytes (policy-dependent)." }
  },
  "additionalProperties": false
}
