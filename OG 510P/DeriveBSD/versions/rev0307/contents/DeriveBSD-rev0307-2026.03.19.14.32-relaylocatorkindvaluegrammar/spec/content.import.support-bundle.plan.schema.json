{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD support-bundle intake plan profile (content.import.support-bundle.plan) (v0.1)",
  "allOf": [
    {
      "$ref": "content.import.plan.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "content.import.plan"
        },
        "plan_version": {
          "const": "0.1"
        },
        "subject": {
          "type": "object",
          "required": [
            "digest",
            "mime",
            "filename"
          ],
          "properties": {
            "mime": {
              "const": "application/zstd"
            },
            "filename": {
              "type": "string",
              "pattern": "\\.tar\\.zst$"
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 3,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "scan"
                  },
                  "tool": {
                    "const": "bundle.scan"
                  }
                },
                "required": [
                  "op",
                  "tool"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "unpack"
                  },
                  "tool": {
                    "const": "bundle.unpack"
                  },
                  "params": {
                    "type": "object",
                    "properties": {
                      "format": {
                        "const": "tar.zst"
                      }
                    },
                    "required": [
                      "format"
                    ]
                  }
                },
                "required": [
                  "op",
                  "tool",
                  "params"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "classify"
                  },
                  "tool": {
                    "const": "bundle.preview"
                  },
                  "params": {
                    "type": "object",
                    "properties": {
                      "prefer_members": {
                        "type": "array",
                        "allOf": [
                          {
                            "contains": {
                              "const": "meta/incident.timeline.json"
                            }
                          },
                          {
                            "contains": {
                              "const": "meta/incident.bundle.json"
                            }
                          },
                          {
                            "contains": {
                              "const": "meta/bundle.payload.manifest.json"
                            }
                          }
                        ]
                      }
                    },
                    "required": [
                      "prefer_members"
                    ]
                  }
                },
                "required": [
                  "op",
                  "tool",
                  "params"
                ]
              }
            }
          ]
        },
        "execution": {
          "type": "object",
          "properties": {
            "isolation": {
              "const": "microvm"
            },
            "network": {
              "const": "none"
            },
            "lifetime": {
              "const": "disposable"
            }
          },
          "required": [
            "isolation",
            "network",
            "lifetime"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "type": {
              "const": "dataset"
            }
          },
          "required": [
            "type"
          ]
        }
      },
      "required": [
        "kind",
        "plan_version"
      ]
    }
  ],
  "type": "object",
  "required": [
    "kind",
    "plan_version"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "content.import.plan",
        "content.import.receipt"
      ]
    },
    "plan_version": {
      "type": "string"
    }
  }
}
