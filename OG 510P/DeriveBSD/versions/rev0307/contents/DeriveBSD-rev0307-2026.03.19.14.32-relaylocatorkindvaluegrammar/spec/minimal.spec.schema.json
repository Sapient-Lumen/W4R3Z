{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD authoring Spec (minimal) (v0.1)",
  "description": "A minimal, human-facing authoring format that compiles to the core Derive IR. Kept intentionally extension-friendly.",
  "type": "object",
  "required": ["format_version", "name", "platform", "packages"],
  "additionalProperties": true,
  "properties": {
    "format_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1,
      "description": "Target platform selector (e.g., freebsd-14.1-amd64)"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
