{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD bundle plan (bundle.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "host",
    "selection"
  ],
  "properties": {
    "kind": {"const": "bundle.plan"},
    "plan_version": {"type": "string", "const": "0.1"},
    "plan_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},

    "trigger": {"type": "object", "additionalProperties": true},

    "host": {
      "type": "object",
      "required": ["host_id"],
      "properties": {
        "host_id": {"type": "string"},
        "boot_id": {"type": "string"},
        "generation_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "source": {
      "type": "object",
      "description": "Evidence index inputs (optional).",
      "properties": {
        "causality_graph_digests": {"type": "array", "items": {"type": "string"}},
        "incident_bundle_id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "selection": {
      "type": "object",
      "description": "What to include and the bounding window.",
      "required": ["include"],
      "properties": {
        "since": {"type": "string", "format": "date-time"},
        "until": {"type": "string", "format": "date-time"},
        "max_bytes": {"type": "integer", "minimum": 0},
        "include": {
          "allOf": [
            {"$ref": "incident.bundle.schema.json#/$defs/include_knobs"}
          ],
          "description": "Inclusion knobs; shared shape with incident.bundle scope.include."
        }
      },
      "additionalProperties": false
    },

    "transforms": {
      "type": "object",
      "description": "Transforms/policies applied to produced exports.",
      "properties": {
        "redaction_transform_digest": {"type": "string"},
        "export_policy_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "output": {
      "type": "object",
      "properties": {
        "format": {"type": "string", "enum": ["tar.zst", "zip"], "default": "tar.zst"},
        "compression_level": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },

    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
