{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Attester Provision Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "captured_at",
    "outcome",
    "subject",
    "signature"
  ],
  "properties": {
    "kind": {"const": "attester-provision-receipt"},
    "receipt_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "captured_at": {"type": "string", "format": "date-time"},

    "outcome": {
      "type": "string",
      "enum": ["enrolled", "rotated", "revoked", "failed"]
    },

    "subject": {
      "type": "object",
      "required": ["host_id"],
      "properties": {
        "host_id": {"type": "string", "description": "Stable host identifier used by the policy authority."},
        "host_identity_key_id": {"type": "string", "description": "Host identity key id (software or hardware backed)."},
        "hardware_class": {"type": "string", "description": "Optional hardware class label or digest."},
        "role": {"type": "string", "description": "Optional fleet role/pool label."}
      },
      "additionalProperties": false
    },

    "tpm": {
      "type": "object",
      "description": "TPM-related identity material (optional).",
      "properties": {
        "ek_cert_digest": {"type": "string", "description": "Digest of EK certificate object if stored (avoid raw certs in receipts unless needed)."},
        "ak_key_id": {"type": "string", "description": "Attestation Key handle/id."},
        "ak_public_digest": {"type": "string", "description": "Digest of canonical AK public area (metadata)."},
        "endorsement_verified": {"type": "boolean"},
        "pcr_policy_digest": {"type": "string", "description": "Optional digest of seal/attestation policy bound during enrollment."}
      },
      "additionalProperties": false
    },

    "enrollment": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["offline-root", "hardware-backed", "factory-anchor", "manual"]
        },
        "enrollment_service_id": {"type": "string"},
        "request_id": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },

    "evidence": {
      "type": "object",
      "description": "Pointers to evidence objects used during enrollment (optional).",
      "properties": {
        "boot_attestation_digest": {"type": "string"},
        "boot_manifest_digest": {"type": "string"},
        "attestation_reference_digest": {"type": "string"},
        "attestation_receipt_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "correlation": {
      "type": "object",
      "properties": {
        "change_set_digest": {"type": "string"},
        "bootstrap_evidence_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "signature": {"type": "object"}
  },
  "additionalProperties": false
}
