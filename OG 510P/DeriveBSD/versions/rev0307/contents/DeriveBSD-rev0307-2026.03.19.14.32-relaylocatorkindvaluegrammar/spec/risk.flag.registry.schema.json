{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD risk flag registry (risk.flag.registry) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "registry_version",
    "registry_id",
    "created_at",
    "flags"
  ],
  "properties": {
    "kind": { "const": "risk.flag.registry" },
    "registry_version": { "type": "string", "const": "0.1" },
    "registry_id": {
      "type": "string",
      "description": "Stable id for this registry (digest recommended)."
    },
    "created_at": { "type": "string", "format": "date-time" },

    "since": {
      "type": "string",
      "description": "Version since this registry form is in use (e.g., 2026-02-27r152)."
    },

    "flags": {
      "type": "array",
      "items": { "$ref": "#/$defs/flag" },
      "minItems": 1
    }
  },
  "$defs": {
    "flag": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "title",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Canonical risk flag id (kebab-case), e.g. raw-blobs-enabled"
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Coarse severity for UI sorting and default gate posture."
        },
        "title": { "type": "string" },
        "description": { "type": "string" },

        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional legacy ids accepted for import/interop (discouraged for new outputs)."
        },

        "typical_sources": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Kinds that may emit this risk flag (e.g. sysctl.diff)."
        },

        "default_gate": {
          "type": "string",
          "enum": ["advisory", "approve", "two-person", "block"],
          "description": "Default gate posture when no profile-specific policy overrides apply."
        },

        "profile_overrides": {
          "type": "object",
          "description": "Optional profile-specific gate posture overrides.",
          "properties": {
            "fleet_host": { "$ref": "#/$defs/gate" },
            "workstation": { "$ref": "#/$defs/gate" },
            "general_os": { "$ref": "#/$defs/gate" },
            "appliance_factory": { "$ref": "#/$defs/gate" }
          },
          "additionalProperties": false
        },

        "introduced_in": {
          "type": "string",
          "description": "Archive version where this flag became canonical (e.g., 2026-02-27r152)."
        },
        "deprecated_in": {
          "type": "string",
          "description": "Archive version where this flag was deprecated (if applicable)."
        }
      },
      "additionalProperties": false
    },

    "gate": {
      "type": "string",
      "enum": ["advisory", "approve", "two-person", "block"]
    }
  },
  "additionalProperties": false
}
