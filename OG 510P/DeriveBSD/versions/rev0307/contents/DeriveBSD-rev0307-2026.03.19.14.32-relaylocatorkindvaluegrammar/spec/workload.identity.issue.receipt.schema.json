{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Workload Identity Issue Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "subject",
    "spiffe_id",
    "credential",
    "issued_at",
    "captured_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "workload-identity-issue-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "spiffe_id": {
      "type": "string"
    },
    "attestation_ref": {
      "type": "object",
      "description": "Legacy pointer to a verifier result used during issuance. Prefer attestation_verification for the authoritative decision context.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "credential": {
      "type": "object",
      "required": [
        "type",
        "expires_at"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "x509-svid",
            "jwt-svid"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "bundle_digest": {
          "type": "string"
        },
        "cert_chain_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "jwt_digest": {
          "type": "string"
        },
        "key_handle": {
          "type": "string"
        },
        "trust_bundle_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "lease_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object"
    },
    "attestation_verification": {
      "type": "object",
      "description": "Summary of how attestation evidence affected this authoritative action receipt without making the verifier receipt itself the authority object.",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "not-required",
            "not-used",
            "accepted",
            "degraded",
            "rejected"
          ]
        },
        "attestation_requirement_digest": {
          "type": "string"
        },
        "attestation_receipt_digest": {
          "type": "string"
        },
        "attestation_admission_policy_digest": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
