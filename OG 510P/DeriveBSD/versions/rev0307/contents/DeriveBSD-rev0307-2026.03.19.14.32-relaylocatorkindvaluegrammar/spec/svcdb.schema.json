{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD compiled service database (svcdb) (v0)",
  "type": "object",
  "required": [
    "kind",
    "svcdb_version",
    "generation_digest",
    "services",
    "bundles"
  ],
  "properties": {
    "kind": {
      "const": "svcdb"
    },
    "svcdb_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "generation_digest": {
      "type": "string",
      "description": "Digest of the host generation / deployment object that produced this svcdb."
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "placement",
          "dependencies",
          "restart"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "oneshot",
              "longrun",
              "jail",
              "microvm",
              "timer",
              "socket-activated",
              "other"
            ]
          },
          "placement": {
            "type": "object",
            "required": [
              "domain"
            ],
            "properties": {
              "domain": {
                "type": "string",
                "enum": [
                  "host",
                  "jail",
                  "microvm"
                ]
              },
              "name": {
                "type": "string",
                "description": "jail name or microvm name when applicable."
              }
            },
            "additionalProperties": true
          },
          "exec": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "working_dir": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "dependencies": {
            "type": "object",
            "properties": {
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "after": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "before": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          },
          "restart": {
            "type": "object",
            "required": [
              "policy"
            ],
            "properties": {
              "policy": {
                "type": "string",
                "enum": [
                  "never",
                  "on-failure",
                  "always"
                ]
              },
              "max_restarts": {
                "type": "integer",
                "minimum": 0
              },
              "window_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "backoff_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "enter_maintenance_after": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": true
          },
          "resources": {
            "type": "object",
            "properties": {
              "rctl_profile": {
                "type": "string"
              },
              "cpuset": {
                "type": "string"
              },
              "pf_anchor": {
                "type": "string"
              },
              "mount_profile": {
                "type": "string"
              },
              "budgets": {
                "type": "array",
                "description": "Optional structured budgets compiled to backend limits (preferred over rctl_profile for new services).",
                "items": {
                  "$ref": "resource.profile.schema.json#/properties/budgets/items"
                }
              },
              "resource_profile_digest": {
                "type": "string",
                "description": "Optional digest of a stored resource.profile artifact used for compilation."
              }
            },
            "additionalProperties": true
          },
          "security": {
            "type": "object",
            "properties": {
              "capset_digest": {
                "type": "string",
                "description": "Digest pointer to a capset/capability activation manifest, if used."
              },
              "portal_grants": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Digest pointers to portal grants."
                }
              },
              "promise_profile_digest": {
                "type": "string",
                "description": "Optional digest of a sandbox-profile artifact expressing least-authority intent (pledge/unveil ergonomics)."
              }
            },
            "additionalProperties": true
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          },
          "activation": {
            "type": "object",
            "description": "Optional activation configuration for socket-activated/portal-activated services.",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "socket",
                  "portal",
                  "hybrid"
                ],
                "description": "Activation gating mode. socket=any traffic triggers, portal=requires grant, hybrid=mix by endpoint."
              },
              "endpoints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "kind",
                    "handoff"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "unix",
                        "tcp",
                        "udp",
                        "vsock",
                        "virtio-console",
                        "other"
                      ]
                    },
                    "listen": {
                      "type": "object",
                      "description": "Endpoint binding descriptor. Shape depends on kind.",
                      "additionalProperties": true
                    },
                    "handoff": {
                      "type": "string",
                      "enum": [
                        "fdpass",
                        "proxy",
                        "rpc"
                      ]
                    },
                    "granting": {
                      "type": "string",
                      "enum": [
                        "none",
                        "portal"
                      ],
                      "description": "Whether callers must obtain a portal grant to connect."
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          },
          "identity": {
            "type": "object",
            "description": "Optional execution identity configuration (primarily for host services). For compartments, identity may be managed inside the compartment.",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "inherit",
                  "static",
                  "dynamic"
                ],
                "description": "inherit=platform default; static=run as named user/group; dynamic=allocate ephemeral UID/GID lease at start."
              },
              "user": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "dynamic": {
                "type": "object",
                "properties": {
                  "class": {
                    "type": "string",
                    "enum": [
                      "service",
                      "task",
                      "ephemeral"
                    ],
                    "description": "Allocation policy class (implementation-defined)."
                  },
                  "uid_min": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "uid_max": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "persist_state": {
                    "type": "boolean"
                  },
                  "state_dirs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "path"
                      ],
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "mode": {
                          "type": "string"
                        },
                        "wipe_on_release": {
                          "type": "boolean"
                        },
                        "meta": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "bundles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "Named service targets (e.g., base, net, control-plane)."
    },
    "meta": {
      "type": "object",
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
