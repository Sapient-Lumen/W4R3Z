{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD storage scrub receipt (storage.scrub.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "created_at",
    "host",
    "plan_digest",
    "results"
  ],
  "properties": {
    "kind": {"const": "storage-scrub-receipt"},
    "receipt_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "receipt_id": {"type": "string", "description": "Stable id for the receipt (UUID recommended)."},
    "created_at": {"type": "string", "format": "date-time"},
    "host": {
      "type": "object",
      "required": ["host_id", "generation_digest"],
      "properties": {
        "host_id": {"type": "string"},
        "generation_digest": {"type": "string"},
        "boot_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "plan_digest": {"type": "string", "description": "Digest/id of the executed storage-scrub-plan."},
    "correlation": {
      "type": "object",
      "properties": {
        "change_id": {"type": "string"},
        "step_name": {"type": "string"}
      },
      "additionalProperties": false
    },
    "executor": {
      "type": "object",
      "properties": {
        "service": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pool_name", "status"],
        "properties": {
          "pool_name": {"type": "string"},
          "status": {"type": "string", "enum": ["success", "failed", "partial", "skipped"]},
          "started_at": {"type": "string", "format": "date-time"},
          "ended_at": {"type": "string", "format": "date-time"},
          "bytes_examined": {"type": "integer", "minimum": 0},
          "errors_found": {"type": "integer", "minimum": 0},
          "errors_repaired": {"type": "integer", "minimum": 0},
          "error": {
            "type": "object",
            "properties": {
              "code": {"type": "string"},
              "message": {"type": "string"}
            },
            "additionalProperties": false
          },
          "events": {
            "type": "object",
            "description": "Pointers into the structured event journal.",
            "properties": {
              "event_ids": {"type": "array", "items": {"type": "string"}},
              "segment_digests": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "overall": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["success", "failed", "partial"]},
        "next_action": {"type": "string", "enum": ["none", "retry", "replace-disk", "manual"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
