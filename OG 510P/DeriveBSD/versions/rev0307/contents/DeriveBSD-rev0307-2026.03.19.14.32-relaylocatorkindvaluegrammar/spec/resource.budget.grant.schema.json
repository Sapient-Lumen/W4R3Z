{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Resource Budget Grant (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "subject",
    "budgets",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "resource-budget-grant"},
    "grant_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "lease_id": {"type": "string"},

    "subject": {
      "type": "object",
      "required": ["target_kind", "id"],
      "properties": {
        "target_kind": {"type": "string", "enum": ["process", "jail", "service", "microvm"]},
        "id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "budgets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["resource", "limit"],
        "properties": {
          "resource": {
            "type": "string",
            "enum": [
              "cpu-time",
              "memory-bytes",
              "processes",
              "threads",
              "read-bytes",
              "write-bytes",
              "read-iops",
              "write-iops",
              "dataset-bytes",
              "net-egress-bytes"
            ]
          },
          "limit": {"type": "integer", "minimum": 0},
          "period_seconds": {"type": "integer", "minimum": 1},
          "burst": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },

    "context": {
      "type": "object",
      "properties": {
        "plan_digest": {"type": "string"},
        "policy_snapshot_digest": {"type": "string"},
        "policy_decision_digest": {"type": "string"},
        "parent_grant_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "issued_at": {"type": "string"},
    "expires_at": {"type": "string"},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
