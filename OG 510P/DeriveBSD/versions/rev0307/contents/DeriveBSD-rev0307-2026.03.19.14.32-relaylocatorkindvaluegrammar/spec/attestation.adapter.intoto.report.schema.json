{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD in-toto/SLSA attestation export report (attestation.adapter.intoto.report) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "report_version",
    "created_at",
    "tool",
    "source",
    "output",
    "summary"
  ],
  "properties": {
    "kind": { "const": "attestation.adapter.intoto.report" },
    "report_version": { "type": "string", "const": "0.1" },

    "report_id": { "type": "string", "description": "Stable id (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "description": "Exporter tool name." },
        "version": { "type": "string" },
        "profile": { "type": "string", "description": "Optional tool profile/config preset." }
      },
      "additionalProperties": false
    },

    "source": {
      "type": "object",
      "description": "DeriveBSD evidence inputs mapped into an external attestation format.",
      "required": ["receipts"],
      "properties": {
        "receipts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "digest"],
            "properties": {
              "kind": { "type": "string", "description": "DeriveBSD evidence kind (e.g., build receipt)." },
              "digest": { "type": "string" },
              "role": { "type": "string", "description": "Hint for mapping (e.g., build-receipt, closure-manifest, config-receipt)." }
            },
            "additionalProperties": false
          }
        },

        "trust_policy_digest": {
          "type": "string",
          "description": "Optional digest of the trust-policy or verifier policy used when producing/verifying the export."
        },

        "export_policy_digest": {
          "type": "string",
          "description": "Optional digest of the export policy that governed what could be emitted."
        },

        "redaction_transform_digest": {
          "type": "string",
          "description": "Optional digest of a redaction transform applied before emission."
        },

        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "output": {
      "type": "object",
      "description": "External-format outputs (digests first; bytes may live elsewhere).",
      "required": ["statement"],
      "properties": {
        "statement": {
          "type": "object",
          "required": ["digest", "predicate_type", "subjects"],
          "properties": {
            "digest": { "type": "string", "description": "Digest of the in-toto Statement JSON bytes." },
            "ref": { "type": "string", "description": "Optional path/URI where the statement bytes are stored." },
            "media_type": {
              "type": "string",
              "description": "Optional media type hint (e.g., application/vnd.in-toto+json)."
            },
            "predicate_type": { "type": "string", "description": "Predicate type (e.g., SLSA provenance predicate)." },
            "subjects": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "digest"],
                "properties": {
                  "name": { "type": "string" },
                  "digest": {
                    "type": "object",
                    "description": "Digest set (algorithm -> hex) as in in-toto Statement subjects.",
                    "minProperties": 1,
                    "additionalProperties": { "type": "string" }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },

        "envelope": {
          "type": "object",
          "description": "Optional DSSE envelope wrapper info.",
          "required": ["digest"],
          "properties": {
            "digest": { "type": "string" },
            "ref": { "type": "string" }
          },
          "additionalProperties": false
        },

        "signature_bundle": {
          "type": "object",
          "description": "Optional signature material (e.g., Sigstore bundle) referenced by digest.",
          "required": ["digest"],
          "properties": {
            "digest": { "type": "string" },
            "ref": { "type": "string" },
            "type": { "type": "string", "description": "Hint only (cosign-bundle, x509-chain, etc)." }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "mapping": {
      "type": "object",
      "description": "How the adapter lane was configured (killable, profile-controlled).",
      "properties": {
        "lane": { "type": "string", "enum": ["adapter", "shadow", "replace"], "description": "Strangler phase at the time of export." },
        "profile": { "type": "string", "description": "Product profile id or alias used to select defaults." },
        "lossy": { "type": "boolean", "description": "True if information was intentionally dropped to fit the external format." },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "summary": {
      "type": "object",
      "required": ["receipts_count", "subjects_count"],
      "properties": {
        "receipts_count": { "type": "integer", "minimum": 0 },
        "subjects_count": { "type": "integer", "minimum": 0 },
        "warnings_count": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
