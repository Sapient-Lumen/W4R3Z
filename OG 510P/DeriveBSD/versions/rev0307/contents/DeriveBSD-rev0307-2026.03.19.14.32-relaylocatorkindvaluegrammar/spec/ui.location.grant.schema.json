{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI Location Grant (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "subject",
    "accuracy_class",
    "cadence",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "ui-location-grant"
    },
    "grant_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "lease_id": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "accuracy_class": {
      "type": "string",
      "enum": [
        "none",
        "city",
        "neighborhood",
        "precise"
      ]
    },
    "cadence": {
      "type": "string",
      "enum": [
        "one-shot",
        "periodic"
      ]
    },
    "max_age_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "period_seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "For periodic cadence."
    },
    "issued_at": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
