{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD packet-capture strong-artifact intake receipt profile (content.import.packet-capture.receipt) (v0.1)",
  "allOf": [
    {
      "$ref": "content.import.receipt.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "content.import.receipt"
        },
        "receipt_version": {
          "const": "0.1"
        },
        "subject": {
          "type": "object",
          "required": [
            "digest",
            "filename"
          ],
          "properties": {
            "filename": {
              "type": "string",
              "pattern": "\\.(pcap|pcapng)$"
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 3,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "scan"
                  },
                  "status": {
                    "const": "ok"
                  },
                  "tool": {
                    "const": "packet-capture.scan"
                  }
                },
                "required": [
                  "op",
                  "status",
                  "tool"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "classify"
                  },
                  "status": {
                    "const": "ok"
                  },
                  "tool": {
                    "const": "packet-capture.classify"
                  }
                },
                "required": [
                  "op",
                  "status",
                  "tool"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "strip-metadata"
                  },
                  "status": {
                    "const": "ok"
                  },
                  "tool": {
                    "const": "packet-capture.normalize"
                  }
                },
                "required": [
                  "op",
                  "status",
                  "tool"
                ]
              }
            }
          ]
        },
        "execution": {
          "type": "object",
          "properties": {
            "isolation": {
              "const": "microvm"
            },
            "network": {
              "const": "none"
            },
            "lifetime": {
              "const": "disposable"
            }
          },
          "required": [
            "isolation",
            "network",
            "lifetime"
          ]
        },
        "outputs": {
          "type": "array",
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "/var/derive/imports/pcap-case-8841/original/vendor-edge-failure.pcapng"
                  },
                  "labels": {
                    "type": "object",
                    "properties": {
                      "class": {
                        "const": "packet-capture-strong-artifact"
                      },
                      "trust": {
                        "const": "quarantined"
                      }
                    },
                    "required": [
                      "class",
                      "trust"
                    ]
                  }
                },
                "required": [
                  "path",
                  "labels"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "/var/derive/imports/pcap-case-8841/normalized/vendor-edge-failure.packet-records-only.pcapng"
                  },
                  "labels": {
                    "type": "object",
                    "properties": {
                      "class": {
                        "const": "packet-capture-normalized"
                      },
                      "trust": {
                        "const": "quarantined"
                      },
                      "metadata_posture": {
                        "const": "packet-records-only"
                      },
                      "redaction_transform_digest": {
                        "type": "string"
                      },
                      "redaction_receipt_digest": {
                        "type": "string"
                      },
                      "promotion_verdict": {
                        "type": "string",
                        "enum": [
                          "ordinary-review-export-eligible",
                          "summary-only"
                        ]
                      }
                    },
                    "required": [
                      "class",
                      "trust",
                      "metadata_posture",
                      "redaction_transform_digest",
                      "redaction_receipt_digest",
                      "promotion_verdict"
                    ]
                  }
                },
                "required": [
                  "path",
                  "labels"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "/var/derive/imports/pcap-case-8841/meta/packet.capture.summary.json"
                  },
                  "labels": {
                    "type": "object",
                    "properties": {
                      "class": {
                        "const": "packet-capture-summary-preview"
                      },
                      "trust": {
                        "const": "quarantined"
                      }
                    },
                    "required": [
                      "class",
                      "trust"
                    ]
                  }
                },
                "required": [
                  "path",
                  "labels"
                ]
              }
            }
          ]
        },
        "metadata": {
          "type": "object",
          "properties": {
            "transport": {
              "const": "portal-copy"
            },
            "status": {
              "enum": [
                "preserved",
                "rehydrated"
              ]
            }
          },
          "required": [
            "transport",
            "status"
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "status": {
              "const": "ok"
            }
          },
          "required": [
            "status"
          ]
        }
      },
      "required": [
        "kind",
        "receipt_version"
      ]
    }
  ],
  "type": "object",
  "required": [
    "kind",
    "receipt_version"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "content.import.plan",
        "content.import.receipt"
      ]
    },
    "receipt_version": {
      "type": "string"
    }
  }
}
