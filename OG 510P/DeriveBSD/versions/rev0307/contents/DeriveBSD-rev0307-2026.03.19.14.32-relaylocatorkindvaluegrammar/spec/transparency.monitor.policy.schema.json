{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD transparency monitor policy (transparency.monitor.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "monitor_id",
    "created_at",
    "logs",
    "scope",
    "checks"
  ],
  "properties": {
    "kind": {
      "const": "transparency.monitor.policy"
    },
    "policy_version": {
      "type": "string",
      "const": "0.1"
    },
    "monitor_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "logs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "mode",
          "log_uri"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "rekor",
              "sigsum",
              "trillian",
              "scitt",
              "custom"
            ]
          },
          "log_uri": {
            "type": "string"
          },
          "expected_log_key_id": {
            "type": "string",
            "description": "Optional key id used by local trust policy to verify checkpoints."
          },
          "witness_policy_digest": {
            "type": "string",
            "description": "Digest of the witness.policy governing which witnesses count for this log and how quorum/shortfall is interpreted."
          }
        },
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "entry_kinds"
      ],
      "properties": {
        "entry_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "export.transparency.entry",
              "release.transparency.entry"
            ]
          }
        },
        "allowed_policy_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional allowlist of governing policy digests (e.g., release.authority.policy)."
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": [
        "verify_checkpoints",
        "verify_consistency"
      ],
      "properties": {
        "verify_checkpoints": {
          "type": "boolean"
        },
        "verify_inclusion": {
          "type": "boolean",
          "default": true
        },
        "verify_consistency": {
          "type": "boolean"
        },
        "detect_unexpected_publications": {
          "type": "boolean",
          "default": true
        },
        "require_bundled_proofs": {
          "type": "boolean",
          "description": "If true, alerts when entries lack sufficient bundled proof for offline verification."
        }
      },
      "additionalProperties": false
    },
    "alerting": {
      "type": "object",
      "description": "Operational routing is implementation-specific; this captures intent.",
      "properties": {
        "min_severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "critical"
          ],
          "default": "warning"
        },
        "suggested_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "sig"
        ],
        "properties": {
          "key_id": {
            "type": "string"
          },
          "sig": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
