{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Cache Witness Quorum Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "quorum_version",
    "inputs",
    "artifact_digest",
    "required_witnesses",
    "matched_witnesses",
    "witness_statements",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "cache-witness-quorum"},
    "quorum_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "inputs": {
      "type": "object",
      "required": ["plan_digest", "target_kind", "builder_abi"],
      "properties": {
        "plan_digest": {"type": "string"},
        "target_kind": {"type": "string"},
        "builder_abi": {"type": "string"},
        "closure_proof_digest": {"type": "string"},
        "toolchain_bundle_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "artifact_digest": {"type": "string"},

    "required_witnesses": {"type": "integer", "minimum": 0},
    "matched_witnesses": {"type": "integer", "minimum": 0},

    "witness_statements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["witness_key_id", "statement_digest"],
        "properties": {
          "witness_key_id": {"type": "string"},
          "statement_digest": {"type": "string"},
          "witness_group": {"type": "string"}
        },
        "additionalProperties": false
      }
    },

    "policy_snapshot_digest": {"type": "string", "description": "Optional binding to a policy snapshot digest."},

    "issued_at": {"type": "string", "description": "ISO8601 time."},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string", "description": "Signature over canonical JSON bytes."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
