{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD boot override receipt (boot.override.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "applied_at",
    "subject",
    "policy_digest",
    "source",
    "outcome"
  ],
  "properties": {
    "kind": {
      "const": "boot.override.receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "receipt_id": {
      "type": "string",
      "description": "Stable id (UUID recommended)."
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "required": [
        "deployment_ref_digest"
      ],
      "properties": {
        "deployment_ref_digest": {
          "type": "string"
        },
        "generation_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "policy_digest": {
      "type": "string",
      "description": "Digest of boot.override.policy used."
    },
    "source": {
      "type": "string",
      "enum": [
        "boot-menu",
        "trusted-ui",
        "maintenance-specialisation",
        "recovery-token"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "applied",
        "denied",
        "partial"
      ]
    },
    "requested": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "next-entry",
              "boot-mode",
              "console-profile"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "applied": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "next-entry",
              "boot-mode",
              "console-profile"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "denied": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "value",
          "reason"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "next-entry",
              "boot-mode",
              "console-profile"
            ]
          },
          "value": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "authorization": {
      "type": "object",
      "properties": {
        "grant_digest": {
          "type": "string"
        },
        "decision_digest": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "string",
      "description": "Optional signature over canonical bytes / DSSE envelope."
    }
  },
  "additionalProperties": false
}
