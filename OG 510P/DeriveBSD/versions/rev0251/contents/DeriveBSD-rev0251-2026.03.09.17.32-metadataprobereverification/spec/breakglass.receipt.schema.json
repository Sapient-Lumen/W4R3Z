{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD breakglass session receipt (breakglass-receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "grant_id",
    "session",
    "approvals"
  ],
  "properties": {
    "kind": {
      "const": "breakglass-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "grant_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string",
      "description": "Canonical cross-lane lease identifier for the referenced breakglass grant. When present, SHOULD equal grant_id."
    },
    "grant_digest": {
      "type": "string",
      "description": "Optional digest of the breakglass-grant object."
    },
    "session": {
      "type": "object",
      "required": [
        "host_id",
        "started_at",
        "expires_at"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "enum": [
            "console",
            "serial",
            "ssh",
            "oob"
          ]
        },
        "operator": {
          "type": "string",
          "description": "Operator identity (human or automation)."
        }
      },
      "additionalProperties": false
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "approver",
          "approved_at"
        ],
        "properties": {
          "approver": {
            "type": "string"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "signature": {
            "type": "string",
            "description": "Optional detached signature over grant_id + session fields."
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "attestation_verification": {
      "type": "object",
      "description": "Summary of how attestation evidence affected this authoritative action receipt without making the verifier receipt itself the authority object.",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "not-required",
            "not-used",
            "accepted",
            "degraded",
            "rejected"
          ]
        },
        "attestation_requirement_digest": {
          "type": "string"
        },
        "attestation_receipt_digest": {
          "type": "string"
        },
        "attestation_admission_policy_digest": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
