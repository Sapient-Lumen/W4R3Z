{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD content import plan (content.import.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "subject",
    "origin",
    "operations",
    "policy_digest"
  ],
  "properties": {
    "kind": {
      "const": "content.import.plan"
    },
    "plan_version": {
      "type": "string",
      "const": "0.1"
    },
    "plan_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mime": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "origin": {
      "description": "Origin metadata for the bytes being imported.",
      "oneOf": [
        {
          "$ref": "content.origin.schema.json"
        },
        {
          "type": "object",
          "required": [
            "origin_id"
          ],
          "properties": {
            "origin_id": {
              "type": "string"
            },
            "origin_digest": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "scan",
              "sanitize",
              "unpack",
              "convert",
              "classify",
              "strip-metadata"
            ]
          },
          "tool": {
            "type": "string",
            "description": "Named tool/pipeline (policy-controlled)."
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "execution": {
      "type": "object",
      "description": "Execution boundary used for import/open work.",
      "required": [
        "isolation",
        "network",
        "lifetime"
      ],
      "properties": {
        "isolation": {
          "type": "string",
          "enum": [
            "host-adapter",
            "jail",
            "microvm"
          ]
        },
        "network": {
          "type": "string",
          "enum": [
            "none",
            "brokered",
            "full"
          ]
        },
        "lifetime": {
          "type": "string",
          "enum": [
            "disposable",
            "persistent"
          ]
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "description": "Where the imported content will be placed (metadata only).",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "file",
            "dataset",
            "store-path"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "policy_digest": {
      "type": "string",
      "description": "Digest of policy module(s) that authorized the plan."
    },
    "portal_session_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
