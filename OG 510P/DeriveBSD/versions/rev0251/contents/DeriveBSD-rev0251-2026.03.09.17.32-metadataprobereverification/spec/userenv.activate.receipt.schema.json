{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UserEnv activation receipt (userenv.activate.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "created_at",
    "user",
    "result"
  ],
  "properties": {
    "kind": { "const": "userenv-activate-receipt" },
    "receipt_version": { "type": "string", "const": "0.1" },
    "receipt_id": {
      "type": "string",
      "description": "Stable id (UUID recommended) for correlation and auditing."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "plan_digest": {
      "type": "string",
      "description": "Optional digest reference to the activation plan that produced this receipt."
    },
    "user": {
      "type": "object",
      "required": ["uid"],
      "properties": {
        "uid": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "previous_userenv_digest": { "type": "string" },
    "new_userenv_digest": { "type": "string" },
    "result": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "failed", "noop"] },
        "error_code": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "change_set_digest": {
      "type": "string",
      "description": "Optional link to a change set digest if activation was part of a broader switch."
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
