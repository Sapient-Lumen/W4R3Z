{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD firmware inventory receipt (fw.inventory.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "components"
  ],
  "properties": {
    "kind": { "const": "fw-inventory-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "receipt_id": { "type": "string", "description": "Stable id for this receipt (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "host": {
      "type": "object",
      "properties": {
        "machine_id": { "type": "string" },
        "boot_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "derived_from": {
      "type": "object",
      "description": "Optional pointers to related evidence objects.",
      "properties": {
        "hw_inventory_digest": { "type": "string" },
        "attestation_receipt_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["class", "version"],
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              "bios",
              "uefi",
              "bmc",
              "tpm",
              "microcode",
              "nic",
              "storage",
              "disk",
              "gpu",
              "secureboot"
            ]
          },
          "device_id": {
            "type": "string",
            "description": "Stable device-class identifier (prefer inventory ids, not raw serials)."
          },
          "vendor": { "type": "string" },
          "model": { "type": "string" },
          "version": { "type": "string" },
          "build": { "type": "string" },
          "fw_guid": { "type": "string", "description": "Optional firmware identifier (e.g., FMP GUID)" },

          "correlation": {
            "type": "object",
            "description": "Optional privacy-preserving correlation handles (not raw serials).",
            "properties": {
              "serial_hmac": { "type": "string", "description": "Org-scoped HMAC of a serial/asset id (optional; policy-gated)." },
              "opaque": { "type": "string" }
            },
            "additionalProperties": false
          },

          "secureboot": {
            "type": "object",
            "description": "Only for class=secureboot. Digest-first summaries; no raw db/dbx blobs by default.",
            "properties": {
              "enabled": { "type": "boolean" },
              "pk_digest": { "type": "string" },
              "kek_digest": { "type": "string" },
              "db_digest": { "type": "string" },
              "dbx_digest": { "type": "string" }
            },
            "additionalProperties": false
          },

          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
