{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD packet-capture export consent receipt profile (packet.capture.export.consent.receipt.profile) (v0.1)",
  "allOf": [
    {
      "$ref": "consent.receipt.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "approved"
        },
        "method": {
          "enum": [
            "gui",
            "tty",
            "oob"
          ]
        }
      },
      "required": [
        "kind",
        "receipt_version",
        "receipt_id",
        "created_at",
        "request_digest",
        "outcome",
        "method"
      ]
    }
  ]
}
