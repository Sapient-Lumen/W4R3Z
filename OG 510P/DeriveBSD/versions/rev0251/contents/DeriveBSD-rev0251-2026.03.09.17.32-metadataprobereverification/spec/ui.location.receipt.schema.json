{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI Location Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "subject",
    "observed_at",
    "accuracy_class",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "ui-location-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "lease_id": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "observed_at": {
      "type": "string"
    },
    "accuracy_class": {
      "type": "string",
      "enum": [
        "none",
        "city",
        "neighborhood",
        "precise"
      ]
    },
    "geohash": {
      "type": "string",
      "description": "Optional coarse encoding of location."
    },
    "coordinates": {
      "type": "object",
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "string",
      "enum": [
        "gps",
        "wifi",
        "cell",
        "manual",
        "unknown"
      ]
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
