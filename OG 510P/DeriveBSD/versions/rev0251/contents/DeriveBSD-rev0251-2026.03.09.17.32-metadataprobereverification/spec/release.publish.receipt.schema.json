{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD release publish receipt (release.publish.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "release_capsule_digest",
    "authority_policy_digest",
    "decision"
  ],
  "properties": {
    "kind": {
      "const": "release.publish.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_capsule_digest": {
      "type": "string"
    },
    "authority_policy_digest": {
      "type": "string"
    },
    "channel_view_digest": {
      "type": "string"
    },
    "rollout_policy_digest": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "published",
        "rejected"
      ]
    },
    "reason": {
      "type": "string"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "sig"
        ],
        "properties": {
          "key_id": {
            "type": "string"
          },
          "sig": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "identity_evidence": {
      "type": "object",
      "description": "Supplemental publisher-identity evidence evaluation. This does not replace the threshold signatures on the release publish receipt.",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "not-required",
            "not-used",
            "accepted",
            "rejected"
          ]
        },
        "publisher_identity_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "transparency_verification": {
      "type": "object",
      "description": "Supplemental transparency gate summary. This records how transparency evidence affected publication review without replacing threshold publication authority.",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "not-required",
            "accepted",
            "rejected",
            "degraded"
          ]
        },
        "release_transparency_entry_digest": {
          "type": "string"
        },
        "checkpoint_receipt_digest": {
          "type": "string"
        },
        "monitor_snapshot_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "monitor_summary_status": {
          "type": "string",
          "enum": [
            "clean",
            "warning",
            "critical"
          ]
        },
        "notes": {
          "type": "string"
        },
        "witness_policy_digest": {
          "type": "string"
        },
        "checkpoint_quorum_verdict": {
          "type": "string",
          "enum": [
            "satisfied",
            "shortfall",
            "not-applicable"
          ]
        }
      },
      "additionalProperties": false
    },
    "supplychain_verification": {
      "type": "object",
      "description": "Supplemental workflow-verification gate summary. This records how supply-chain verification evidence affected publication review without replacing threshold publication authority.",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "not-required",
            "not-used",
            "accepted",
            "rejected"
          ]
        },
        "verify_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layout_policy_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "vulnerability_verification": {
      "type": "object",
      "description": "Supplemental vulnerability-verification gate summary. This records how vulnerability evidence affected publication review without replacing threshold publication authority.",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "not-required",
            "not-used",
            "accepted",
            "warning",
            "rejected"
          ]
        },
        "vuln_gate_receipt_digest": {
          "type": "string"
        },
        "vuln_query_receipt_digest": {
          "type": "string"
        },
        "vuln_gate_policy_digest": {
          "type": "string"
        },
        "vuln_db_snapshot_digest": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
