{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD portable home unlock receipt (home.unlock.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "user",
    "home_area",
    "key_source",
    "result"
  ],
  "properties": {
    "kind": {"const": "home.unlock.receipt"},
    "receipt_version": {"type": "string", "const": "0.1"},
    "receipt_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "user": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"}
      },
      "additionalProperties": false
    },
    "home_area": {
      "type": "object",
      "required": ["area_id"],
      "properties": {
        "area_id": {"type": "string"},
        "record_digest": {"type": "string"}
      },
      "additionalProperties": false
    },
    "key_source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["crypto-portal", "platform-keystore", "sealed-secret", "passphrase", "other"]},
        "policy_digest": {"type": "string"},
        "evidence_digest": {"type": "string"}
      },
      "additionalProperties": false
    },
    "result": {"type": "string", "enum": ["unlocked", "failed"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
