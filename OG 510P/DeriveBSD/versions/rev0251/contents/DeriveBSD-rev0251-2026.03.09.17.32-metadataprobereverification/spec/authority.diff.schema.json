{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD authority diff (authority.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from",
    "to",
    "nodes_added",
    "nodes_removed",
    "edges_added",
    "edges_removed",
    "edges_changed"
  ],
  "properties": {
    "kind": { "const": "authority.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "from": { "$ref": "#/$defs/ref" },
    "to": { "$ref": "#/$defs/ref" },

    "nodes_added": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "nodes_removed": { "type": "array", "items": { "$ref": "#/$defs/node" } },

    "edges_added": { "type": "array", "items": { "$ref": "#/$defs/edge_delta" } },
    "edges_removed": { "type": "array", "items": { "$ref": "#/$defs/edge_delta" } },
    "edges_changed": { "type": "array", "items": { "$ref": "#/$defs/edge_change" } },

    "new_risk_tags": { "type": "array", "items": { "type": "string" } },
    "new_parsers": { "type": "array", "items": { "$ref": "#/$defs/parser" } },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "type": "string" },
        "digest": { "type": "string" }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "edge_delta": {
      "type": "object",
      "required": ["from", "to", "cap_kind", "rights"],
      "properties": {
        "edge_key": { "type": "string", "description": "Stable reviewer-facing identifier for the edge" },
        "from": { "type": "string" },
        "to": { "type": "string" },

        "cap_kind": { "type": "string", "description": "e.g. net.egress, uapi.surface, rpc.endpoint" },
        "cap_digest": { "type": "string", "description": "Optional stable digest for the surface/endpoint" },

        "rights": { "type": "array", "items": { "type": "string" } },
        "scope": { "type": "object" },

        "risk_tags": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" },

        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional digests/refs to receipts, contract ids, or UAPI surface ids that justify or explain the edge"
        }
      },
      "additionalProperties": false
    },
    "edge_change": {
      "type": "object",
      "required": ["edge_key", "summary"],
      "properties": {
        "edge_key": { "type": "string" },
        "summary": { "type": "string" },
        "from": { "$ref": "#/$defs/edge_delta" },
        "to": { "$ref": "#/$defs/edge_delta" },
        "classification": { "type": "string", "enum": ["narrowing", "broadening", "shape-change"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "parser": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "description": "rpc.endpoint, uapi.surface, portal.method, etc" },
        "id": { "type": "string" },
        "digest": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
