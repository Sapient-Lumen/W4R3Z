{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD crypto operation receipt (crypto.op.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "request_digest",
    "subject",
    "key_id",
    "op",
    "captured_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "crypto.op.receipt"},
    "receipt_version": {"type": "string", "const": "0.1"},

    "request_digest": {"type": "string"},

    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": {"type": "string"},
        "digest": {"type": "string"},
        "instance": {"type": "string"}
      },
      "additionalProperties": false
    },

    "key_id": {"type": "string"},
    "key_policy_digest": {"type": "string"},
    "grant_digest": {"type": "string"},
    "lease_id": {"type": "string"},

    "op": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["sign", "decrypt", "derive", "ssh-sign", "custom"]
        },
        "algorithm": {"type": "string"},
        "input_digests": {"type": "array", "items": {"type": "string"}},
        "output_digests": {"type": "array", "items": {"type": "string"}},
        "context": {
          "type": "object",
          "properties": {
            "destination": {"type": "string"},
            "purpose": {"type": "string"}
          },
          "additionalProperties": false
        },
        "user_presence": {"type": "boolean"}
      },
      "additionalProperties": false
    },

    "consent_receipt_digest": {"type": "string"},
    "captured_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "object"}
  },
  "additionalProperties": false
}
