{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI RemoteDesktop Grant (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "subject",
    "device_types",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": { "const": "ui-remotedesktop-grant" },
    "grant_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "lease_id": { "type": "string" },
    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string" },
        "digest": { "type": "string" },
        "instance": { "type": "string" }
      },
      "additionalProperties": false
    },
    "device_types": {
      "type": "array",
      "items": { "type": "string", "enum": ["keyboard", "pointer", "touchscreen"] },
      "minItems": 1,
      "description": "Requested input injection device classes."
    },
    "focus": {
      "type": "object",
      "properties": {
        "surface_id": { "type": "string" },
        "requires_focus": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "requires_foreground": { "type": "boolean" },
        "indicator_required": { "type": "boolean" },
        "expires_at": { "type": "string" },
        "sak_overrides_injected_input": {
          "type": "boolean",
          "description": "Whether Secure Attention Key always preempts injected input (recommended true)."
        }
      },
      "additionalProperties": true
    },
    "issued_at": { "type": "string", "description": "ISO8601 time." },
    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": { "type": "string" },
        "alg": { "type": "string" },
        "sig": { "type": "string", "description": "Signature over canonical JSON bytes." }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
