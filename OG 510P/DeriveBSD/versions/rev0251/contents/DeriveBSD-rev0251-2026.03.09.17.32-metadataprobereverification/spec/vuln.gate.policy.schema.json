{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD vulnerability gate policy (vuln.gate.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "policy_id",
    "created_at",
    "mode",
    "thresholds"
  ],
  "properties": {
    "kind": {"const": "vuln.gate.policy"},
    "policy_version": {"type": "string", "const": "0.1"},

    "policy_id": {"type": "string", "description": "Stable identifier for this policy (UUID recommended)."},
    "created_at": {"type": "string", "format": "date-time"},

    "mode": {
      "type": "string",
      "enum": ["off", "warn", "block"],
      "description": "How to treat matches (off/warn/block)."
    },

    "thresholds": {
      "type": "object",
      "required": ["block_at_or_above"],
      "properties": {
        "block_at_or_above": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "unknown"],
          "description": "Minimum severity that triggers a block when mode=block."
        },
        "warn_at_or_above": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "unknown"],
          "description": "Minimum severity that triggers a warning when mode=warn."
        },
        "known_exploited_always_block": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },

    "freshness": {
      "type": "object",
      "description": "Optional maximum ages for mutable inputs.",
      "properties": {
        "max_vuln_db_age_hours": {"type": "integer", "minimum": 1},
        "max_vex_age_hours": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },

    "vex": {
      "type": "object",
      "description": "Optional VEX handling semantics.",
      "properties": {
        "accept_formats": {
          "type": "array",
          "items": {"type": "string", "enum": ["cyclonedx", "openvex"]}
        },
        "missing_vex_treatment": {
          "type": "string",
          "enum": ["ignore", "unknown", "block"],
          "default": "unknown",
          "description": "What to do if VEX is required but missing."
        }
      },
      "additionalProperties": false
    },

    "allowlist_digest": {
      "type": "string",
      "description": "Optional digest of a time-bounded risk acceptance list (override list)."
    },

    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
