{
  "kind": "redaction-transform",
  "transform_version": "0.1",
  "description": "Default telemetry allowlist for incident capsules (drop secrets; keep routing + counts).",
  "applies_to": [
    "logs",
    "traces",
    "audit"
  ],
  "policy": {
    "allow_attributes": [
      "service.name",
      "service.version",
      "host.id",
      "trace_id",
      "span_id",
      "http.method",
      "http.route",
      "http.status_code",
      "net.peer.name",
      "net.peer.port"
    ],
    "deny_attributes": [
      "authorization",
      "cookie",
      "set-cookie",
      "password",
      "token"
    ],
    "mask_patterns": [
      "(?i)bearer\\s+[a-z0-9._-]+",
      "(?i)apikey=[^&\\s]+"
    ]
  },
  "implementation": {
    "type": "declarative"
  },
  "context": {
    "policy_snapshot_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "policy_decision_digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
  },
  "issued_at": "2026-02-24T00:00:00Z",
  "signature": {
    "key_id": "derive.redaction.example",
    "alg": "ed25519",
    "sig": "base64:..."
  }
}
