{
  "format_version": "0.1",
  "name": "web-stack",
  "platform": "freebsd-14.1-amd64",
  "packages": [
    {
      "id": "nginx"
    }
  ],
  "targets": {
    "microvms": [
      {
        "name": "edge-nginx",
        "image": {
          "closure": "services/nginx:latest"
        },
        "resources": {
          "cpu": 1,
          "mem_mb": 256
        },
        "network": {
          "mode": "nat"
        },
        "secrets": {
          "required": [
            "tls.crt",
            "tls.key"
          ]
        }
      }
    ]
  }
}
