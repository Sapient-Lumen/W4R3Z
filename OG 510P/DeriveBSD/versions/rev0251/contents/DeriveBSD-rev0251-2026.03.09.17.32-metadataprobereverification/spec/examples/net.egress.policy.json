{
  "kind": "net-egress-policy",
  "policy_version": "0.1",
  "classes": [
    {
      "name": "dns-only",
      "description": "Allow DNS lookups via brokered resolver only.",
      "permissions": {
        "dns_lookup": true,
        "connect": []
      },
      "defaults": {"ttl_seconds": 3600, "max_flows": 100}
    },
    {
      "name": "https-anywhere",
      "description": "Allow outbound HTTPS to any host (TCP/443).",
      "permissions": {
        "dns_lookup": true,
        "connect": [
          {"proto": "tcp", "ports": [443], "hosts": ["*"]}
        ]
      },
      "defaults": {"ttl_seconds": 7200, "max_flows": 10000}
    },
    {
      "name": "nts-time",
      "description": "Allow NTS key establishment and NTP client/server mode to approved servers.",
      "permissions": {
        "dns_lookup": true,
        "connect": [
          {"proto": "tcp", "ports": [4460], "hosts": ["time.*.example", "time.cloudflare.com"]},
          {"proto": "udp", "ports": [123], "hosts": ["time.*.example", "time.cloudflare.com"]}
        ]
      },
      "defaults": {"ttl_seconds": 86400, "max_flows": 10000},
      "notes": "Exact endpoints are policy; example only."
    }
  ],
  "issued_at": "2026-02-25T00:00:00Z",
  "signature": {
    "key_id": "ed25519:example",
    "alg": "ed25519",
    "sig": "base64..."
  }
}
