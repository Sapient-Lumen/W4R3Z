{
  "format_version": "0.1",
  "name": "harbor",
  "platform": "freebsd-14.1-amd64",
  "packages": [
    {
      "id": "vim"
    },
    {
      "id": "git"
    },
    {
      "id": "ripgrep"
    }
  ],
  "system": {
    "hostName": "harbor",
    "services": {
      "sshd": {
        "enable": true
      },
      "nginx": {
        "enable": true
      }
    },
    "networking": {
      "pf": {
        "enable": true,
        "anchors": [
          "derivebsd/*"
        ]
      }
    }
  }
}
