{
  "kind": "transport.policy",
  "policy_version": "0.1",
  "policy_id": "transport-policy-default",
  "created_at": "2026-02-25T20:00:00Z",
  "label": "Default support transports",
  "description": "Allow ticketing uploads to approved Jira/ServiceNow realms; forbid arbitrary uploads.",
  "rules": [
    {
      "transport_kind": "jira",
      "allowed_domains": [
        "*.atlassian.net"
      ],
      "allowed_realms": [
        "acme.atlassian.net"
      ],
      "require_tls": true,
      "require_ticket": true,
      "ticket_pattern": "^[A-Z]+-\\d+$",
      "max_size_bytes": 50000000,
      "auth_mode": "api-token",
      "notes": "Prefer issue attachments; avoid embedding secrets in URLs."
    },
    {
      "transport_kind": "servicenow",
      "allowed_domains": [
        "acme.service-now.com"
      ],
      "allowed_realms": [
        "acme.service-now.com"
      ],
      "require_tls": true,
      "require_ticket": true,
      "ticket_pattern": "^(INC|CASE)\\d+$",
      "max_size_bytes": 50000000,
      "auth_mode": "oauth2"
    }
  ]
}
