{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD transparency monitor alert event (transparency.monitor.alert.event) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "event_version",
    "event_id",
    "created_at",
    "monitor_policy_digest",
    "log_uri",
    "alert_type",
    "severity"
  ],
  "properties": {
    "kind": {"const": "transparency.monitor.alert.event"},
    "event_version": {"type": "string", "const": "0.1"},
    "event_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},

    "monitor_policy_digest": {"type": "string"},
    "log_uri": {"type": "string"},

    "severity": {"type": "string", "enum": ["info", "warning", "critical"]},
    "alert_type": {
      "type": "string",
      "enum": [
        "checkpoint_invalid",
        "consistency_failed",
        "split_view_suspected",
        "unexpected_publication",
        "witness_quorum_missing",
        "policy_violation",
        "proof_missing"
      ]
    },

    "offending": {
      "type": "object",
      "properties": {
        "entry_kind": {"type": "string", "enum": ["export.transparency.entry", "release.transparency.entry"]},
        "entry_digest": {"type": "string"},
        "entry_uuid": {"type": "string"},
        "log_index": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },

    "evidence": {
      "type": "object",
      "description": "Pointers sufficient to reproduce the monitor's claim.",
      "properties": {
        "proof": {"$ref": "transparency.proof.schema.json"},
        "checkpoint_prev": {"type": "string"},
        "checkpoint_prev_digest": {"type": "string"},
        "checkpoint_new": {"type": "string"},
        "checkpoint_new_digest": {"type": "string"}
      },
      "additionalProperties": true
    },

    "suggested_actions": {
      "type": "array",
      "items": {"type": "string", "enum": ["halt_rollout", "freeze_exports", "rotate_keys", "page_oncall", "investigate"]}
    },

    "notes": {"type": "string"},
    "signature": {"type": "string"}
  },
  "additionalProperties": false
}
