{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD PKI Issue Plan (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "identity_id",
    "request",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "pki-issue-plan"
    },
    "plan_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "identity_id": {
      "type": "string",
      "description": "Stable identity reference used by components (e.g. service:web:tls)."
    },
    "subject": {
      "type": "object",
      "properties": {
        "unit_id": {
          "type": "string",
          "description": "Optional binding to a derive.unit id."
        },
        "closure_digest": {
          "type": "string",
          "description": "Optional binding to a closure/artifact digest (digest-bound identity issuance)."
        }
      },
      "additionalProperties": false
    },
    "trust_bundle_digests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Trust bundle digests required/expected for this identity (verifier side)."
    },
    "request": {
      "type": "object",
      "required": [
        "usages",
        "provider",
        "key"
      ],
      "properties": {
        "common_name": {
          "type": "string"
        },
        "sans": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "tls-server",
              "tls-client",
              "mtls-svid",
              "ssh-host",
              "ssh-user",
              "code-signing",
              "other"
            ]
          }
        },
        "key": {
          "type": "object",
          "required": [
            "secret_id",
            "algorithm"
          ],
          "properties": {
            "secret_id": {
              "type": "string",
              "description": "Reference to the private key secret handled via the credential broker lane."
            },
            "algorithm": {
              "type": "string",
              "enum": [
                "rsa",
                "ecdsa",
                "ed25519",
                "other"
              ]
            },
            "key_size": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "provider": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "acme",
                "internal-ca",
                "offline",
                "external"
              ]
            },
            "endpoint": {
              "type": "string"
            },
            "profile": {
              "type": "string",
              "description": "Optional provider profile name (e.g. ACME account/profile, CA template)."
            }
          },
          "additionalProperties": false
        },
        "rotation": {
          "type": "object",
          "properties": {
            "min_remaining_days": {
              "type": "integer",
              "minimum": 0
            },
            "max_lifetime_days": {
              "type": "integer",
              "minimum": 0
            },
            "jitter_seconds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
