{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Resource Budget Usage Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "usage_version",
    "grant_digest",
    "window",
    "usage",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "resource-budget-usage"},
    "usage_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "grant_digest": {"type": "string"},

    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string"},
        "end": {"type": "string"}
      },
      "additionalProperties": false
    },

    "usage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["resource", "observed"],
        "properties": {
          "resource": {"type": "string"},
          "observed": {"type": "integer", "minimum": 0},
          "limit_hit": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },

    "context": {
      "type": "object",
      "properties": {
        "plan_digest": {"type": "string"},
        "policy_decision_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "issued_at": {"type": "string"},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
