{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Debug Replay Capsule (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "capsule_version",
    "grant_digest",
    "window",
    "recording",
    "outputs",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "debug-replay-capsule"},
    "capsule_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "grant_digest": {"type": "string", "description": "Digest of canonical debug.record.grant bytes."},

    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string"},
        "end": {"type": "string"}
      },
      "additionalProperties": false
    },

    "recording": {
      "type": "object",
      "required": ["type", "digest"],
      "properties": {
        "type": {"type": "string", "enum": ["rr-trace", "microvm-snapshot", "other"]},
        "digest": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 0},
        "format": {"type": "string"},
        "compression": {"type": "string"}
      },
      "additionalProperties": false
    },

    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "digest"],
        "properties": {
          "type": {"type": "string", "enum": ["logs", "coredump", "stack", "config", "trace", "other"]},
          "digest": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },

    "redaction": {
      "type": "object",
      "description": "Optional redaction proof bundle.",
      "properties": {
        "transform_digest": {"type": "string"},
        "receipt_digests": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },

    "context": {
      "type": "object",
      "properties": {
        "plan_digest": {"type": "string"},
        "policy_decision_digest": {"type": "string"},
        "incident_id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "issued_at": {"type": "string"},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
