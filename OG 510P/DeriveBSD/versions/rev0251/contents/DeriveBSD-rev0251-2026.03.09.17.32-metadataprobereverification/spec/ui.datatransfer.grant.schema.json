{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI DataTransfer Grant (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "subject",
    "direction",
    "offer",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "ui-datatransfer-grant"
    },
    "grant_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "lease_id": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "direction": {
      "type": "string",
      "enum": [
        "read",
        "write"
      ],
      "description": "Read = paste; write = copy/offer creation."
    },
    "offer": {
      "type": "object",
      "required": [
        "id",
        "mime_types"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Offer identifier (clipboard entry / drag offer)."
        },
        "mime_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_bytes": {
          "type": "integer"
        },
        "ttl_seconds": {
          "type": "integer"
        },
        "redaction_profile_digest": {
          "type": "string",
          "description": "Optional digest of redaction.transform artifact."
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "requires_foreground": {
          "type": "boolean"
        },
        "rate_limit": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "issued_at": {
      "type": "string",
      "description": "ISO8601 time."
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}