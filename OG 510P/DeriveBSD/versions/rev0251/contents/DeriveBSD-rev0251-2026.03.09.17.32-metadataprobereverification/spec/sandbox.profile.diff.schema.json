{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD sandbox profile diff (sandbox.profile.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_profile",
    "to_profile",
    "promises_added",
    "promises_removed",
    "fs_rules_added",
    "fs_rules_removed",
    "fs_rules_changed",
    "net_egress_classes_added",
    "net_egress_classes_removed",
    "net_listen_classes_added",
    "net_listen_classes_removed",
    "portals_added",
    "portals_removed",
    "casper_services_added",
    "casper_services_removed"
  ],
  "properties": {
    "kind": { "const": "sandbox.profile.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (unit/service/profile/generation).",
      "properties": {
        "host_id": { "type": "string" },
        "unit_id": { "type": "string", "description": "Stable derive unit id (optional)." },
        "service_name": { "type": "string" },
        "profile_id": { "type": "string", "description": "Canonical product profile id (fleet_host/workstation/general_os/appliance_factory)." },
        "from_generation": { "type": "string" },
        "to_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "from_profile": { "$ref": "#/$defs/profile_ref" },
    "to_profile": { "$ref": "#/$defs/profile_ref" },

    "promises_added": { "type": "array", "items": { "type": "string" } },
    "promises_removed": { "type": "array", "items": { "type": "string" } },

    "fs": {
      "type": "object",
      "properties": {
        "lock_changed": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "boolean" },
            "to": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "fs_rules_added": { "type": "array", "items": { "$ref": "#/$defs/fs_rule" } },
    "fs_rules_removed": { "type": "array", "items": { "$ref": "#/$defs/fs_rule" } },
    "fs_rules_changed": { "type": "array", "items": { "$ref": "#/$defs/fs_rule_change" } },

    "net_egress_classes_added": { "type": "array", "items": { "type": "string" } },
    "net_egress_classes_removed": { "type": "array", "items": { "type": "string" } },

    "net_listen_classes_added": { "type": "array", "items": { "type": "string" } },
    "net_listen_classes_removed": { "type": "array", "items": { "type": "string" } },

    "portals_added": { "type": "array", "items": { "type": "string" } },
    "portals_removed": { "type": "array", "items": { "type": "string" } },

    "casper_services_added": { "type": "array", "items": { "type": "string" } },
    "casper_services_removed": { "type": "array", "items": { "type": "string" } },

    "summary": {
      "type": "object",
      "description": "Optional human/policy summary fields.",
      "properties": {
        "promises_added": { "type": "integer", "minimum": 0 },
        "promises_removed": { "type": "integer", "minimum": 0 },
        "fs_rules_added": { "type": "integer", "minimum": 0 },
        "fs_rules_removed": { "type": "integer", "minimum": 0 },
        "fs_rules_changed": { "type": "integer", "minimum": 0 },
        "net_egress_added": { "type": "integer", "minimum": 0 },
        "net_egress_removed": { "type": "integer", "minimum": 0 },
        "net_listen_added": { "type": "integer", "minimum": 0 },
        "net_listen_removed": { "type": "integer", "minimum": 0 },
        "portals_added": { "type": "integer", "minimum": 0 },
        "portals_removed": { "type": "integer", "minimum": 0 },
        "casper_services_added": { "type": "integer", "minimum": 0 },
        "casper_services_removed": { "type": "integer", "minimum": 0 },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "profile_ref": {
      "type": "object",
      "description": "Reference to a sandbox-profile object by digest (and optional human fields).",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "name": { "type": "string", "description": "Stable profile id (e.g., profile:fetcher@1)." },
        "profile_version": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "fs_rule": {
      "type": "object",
      "required": ["path", "mode"],
      "properties": {
        "path": { "type": "string" },
        "mode": { "type": "string", "enum": ["r", "rw", "rx", "c"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "fs_rule_change": {
      "type": "object",
      "required": ["path", "from", "to"],
      "properties": {
        "path": { "type": "string" },
        "from": { "$ref": "#/$defs/fs_rule" },
        "to": { "$ref": "#/$defs/fs_rule" },
        "classification": {
          "type": "string",
          "enum": ["mode", "notes", "both", "other"]
        },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
