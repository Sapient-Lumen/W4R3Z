{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD lease envelope (lease.envelope) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "lease_version",
    "lease_id",
    "created_at",
    "lane",
    "target"
  ],
  "properties": {
    "kind": {
      "const": "lease.envelope"
    },
    "lease_version": {
      "type": "string",
      "const": "0.1"
    },
    "lease_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string"
    },
    "issuer": {
      "type": "object",
      "description": "Who/what issued the lease.",
      "properties": {
        "principal": {
          "type": "string"
        },
        "host_id": {
          "type": "string"
        },
        "component": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "description": "Selectors describing who holds the lease.",
      "additionalProperties": true
    },
    "lane": {
      "type": "string",
      "description": "Which authority lane this lease belongs to (secrets, portals, tracing, breakglass, export, ...)."
    },
    "target": {
      "type": "object",
      "description": "Pointer to the authoritative lane object that grants temporary authority. This should name a grant / lease / session object, not a later action receipt.",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "Lane object kind (e.g. secret-grant, breakglass-grant, trace.session)."
        },
        "id": {
          "type": "string",
          "description": "Optional id (grant_id/session_id)."
        },
        "digest": {
          "type": "string",
          "description": "Optional digest of the lane object."
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "description": "Non-sensitive summary fields to make listing leases useful.",
      "additionalProperties": true
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
