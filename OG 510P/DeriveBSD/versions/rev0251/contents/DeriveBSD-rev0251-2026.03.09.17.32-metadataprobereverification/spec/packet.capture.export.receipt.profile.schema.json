{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD packet-capture export receipt profile (packet.capture.export.receipt.profile) (v0.1)",
  "allOf": [
    {
      "$ref": "export.receipt.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "packet.capture.summary",
                "packet.capture.normalized"
              ]
            }
          }
        },
        "supporting_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "export.receipt.schema.json#/$defs/artifact_ref"
          }
        },
        "delivery_state": {
          "type": "string",
          "enum": [
            "recipient-accepted"
          ]
        },
        "transport_acceptance_receipt_digest": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "receipt_version",
        "receipt_id",
        "created_at",
        "artifact",
        "policy_digest",
        "supporting_evidence"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "artifact": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "packet.capture.summary"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "supporting_evidence": {
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "required": [
                        "role"
                      ],
                      "properties": {
                        "role": {
                          "const": "session"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifact": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "packet.capture.normalized"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "supporting_evidence": {
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "required": [
                        "role"
                      ],
                      "properties": {
                        "role": {
                          "const": "session"
                        }
                      }
                    }
                  },
                  {
                    "contains": {
                      "type": "object",
                      "required": [
                        "role"
                      ],
                      "properties": {
                        "role": {
                          "const": "summary"
                        }
                      }
                    }
                  },
                  {
                    "contains": {
                      "type": "object",
                      "required": [
                        "role"
                      ],
                      "properties": {
                        "role": {
                          "const": "import-receipt"
                        }
                      }
                    }
                  },
                  {
                    "contains": {
                      "type": "object",
                      "required": [
                        "role"
                      ],
                      "properties": {
                        "role": {
                          "const": "redaction-receipt"
                        }
                      }
                    }
                  }
                ]
              },
              "redaction": {
                "type": "object",
                "required": [
                  "transform_digest",
                  "receipt_digest"
                ]
              },
              "destination": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "ticket-upload",
                      "https-upload",
                      "email",
                      "removable-media",
                      "oob"
                    ]
                  }
                }
              },
              "delivery_state": {
                "const": "recipient-accepted"
              },
              "adapter": {
                "type": "object",
                "required": [
                  "remote_id",
                  "remote_validator",
                  "remote_protection",
                  "remote_locator"
                ],
                "properties": {
                  "remote_id": {
                    "type": "string"
                  },
                  "remote_validator": {
                    "type": "object",
                    "required": [
                      "kind",
                      "value"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "etag-strong",
                          "etag-weak",
                          "version-id",
                          "attachment-revision",
                          "message-id",
                          "opaque"
                        ]
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  },
                  "remote_locator": {
                    "type": "object",
                    "required": [
                      "kind",
                      "value"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "uri-hint",
                          "ticket-attachment",
                          "portal-object",
                          "message-part",
                          "object-path",
                          "opaque"
                        ]
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "adapter",
              "consent_receipt_digest",
              "delivery_state",
              "destination",
              "redaction",
              "transport_acceptance_receipt_digest",
              "transport_receipt_digest"
            ]
          }
        }
      ]
    }
  ]
}
