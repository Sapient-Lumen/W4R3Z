{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD storage pool inventory (storage.pool.inventory) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "inventory_version",
    "created_at",
    "host",
    "pools"
  ],
  "properties": {
    "kind": {"const": "storage-pool-inventory"},
    "inventory_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "inventory_id": {"type": "string", "description": "Stable id for this inventory snapshot (UUID recommended)."},
    "created_at": {"type": "string", "format": "date-time"},
    "host": {
      "type": "object",
      "required": ["host_id", "generation_digest"],
      "properties": {
        "host_id": {"type": "string"},
        "generation_digest": {"type": "string"},
        "boot_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pool_name", "pool_guid", "health", "vdev"],
        "properties": {
          "pool_name": {"type": "string"},
          "pool_guid": {"type": "string"},
          "health": {
            "type": "string",
            "enum": ["ONLINE", "DEGRADED", "FAULTED", "UNAVAIL", "SUSPENDED", "UNKNOWN"]
          },
          "ashift": {"type": "integer", "minimum": 0},
          "features": {"type": "array", "items": {"type": "string"}},
          "encryption": {"type": "string", "enum": ["none", "native", "other"]},
          "vdev": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["root", "disk", "mirror", "raidz", "draid", "spare", "log", "cache", "special", "other"]
              },
              "guid": {"type": "string"},
              "role": {"type": "string", "description": "Optional role hint: data/log/cache/special/spare."},
              "device_id_hash": {"type": "string", "description": "Privacy-safe stable id hash for a leaf device."},
              "path_hint": {"type": "string", "description": "Optional best-effort path hint (e.g., /dev/da0)."},
              "children": {
                "type": "array",
                "items": {"$ref": "#/properties/pools/items/properties/vdev"}
              }
            },
            "additionalProperties": false
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "tool": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
