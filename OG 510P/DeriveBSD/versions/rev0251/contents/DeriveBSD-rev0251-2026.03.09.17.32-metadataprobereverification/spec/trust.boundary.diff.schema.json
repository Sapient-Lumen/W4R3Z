{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Trust Boundary Diff (trust.boundary.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from",
    "to",
    "nodes_added",
    "nodes_removed",
    "boundaries_added",
    "boundaries_removed",
    "boundaries_changed"
  ],
  "properties": {
    "kind": { "const": "trust.boundary.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "from": { "$ref": "#/$defs/ref" },
    "to": { "$ref": "#/$defs/ref" },

    "nodes_added": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "nodes_removed": { "type": "array", "items": { "$ref": "#/$defs/node" } },

    "boundaries_added": { "type": "array", "items": { "$ref": "#/$defs/boundary_delta" } },
    "boundaries_removed": { "type": "array", "items": { "$ref": "#/$defs/boundary_delta" } },
    "boundaries_changed": { "type": "array", "items": { "$ref": "#/$defs/boundary_change" } },

    "new_risk_tags": { "type": "array", "items": { "type": "string" } },
    "new_assumptions": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "type": "string" },
        "digest": { "type": "string" }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "kind", "trust_tier"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "name": { "type": "string" },
        "trust_tier": {
          "type": "string",
          "enum": ["trusted", "semi_trusted", "untrusted", "external", "hardware", "operator"]
        }
      },
      "additionalProperties": false
    },
    "boundary_delta": {
      "type": "object",
      "required": ["id", "from", "to", "kind", "direction"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "kind": { "type": "string" },
        "direction": { "type": "string" },
        "risk_tags": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" },
        "surface_links": { "type": "object" },
        "mitigations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "boundary_change": {
      "type": "object",
      "required": ["id", "summary"],
      "properties": {
        "id": { "type": "string" },
        "summary": { "type": "string" },
        "from": { "$ref": "#/$defs/boundary_delta" },
        "to": { "$ref": "#/$defs/boundary_delta" },
        "classification": { "type": "string", "enum": ["narrowing", "broadening", "shape-change"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
