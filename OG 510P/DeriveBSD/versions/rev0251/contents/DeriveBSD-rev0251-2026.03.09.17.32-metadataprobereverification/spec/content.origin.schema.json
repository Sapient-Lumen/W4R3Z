{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD content origin record (content.origin) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "origin_version",
    "origin_id",
    "created_at",
    "subject",
    "source"
  ],
  "properties": {
    "kind": { "const": "content.origin" },
    "origin_version": { "type": "string", "const": "0.1" },
    "origin_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },

    "subject": {
      "type": "object",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string", "description": "Digest of the imported bytes (sha256:... recommended)." },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "mime": { "type": "string" },
        "filename": { "type": "string" }
      },
      "additionalProperties": false
    },

    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["usb", "download", "attachment", "share", "scanner", "manual"]
        },
        "domain": { "type": "string", "description": "Optional compartment/domain that observed or provided the bytes." },
        "device_id": { "type": "string", "description": "For usb/scanner sources: a stable device identifier if available." },
        "volume": { "type": "string", "description": "For usb sources: mount/volume label or identifier." },
        "url": { "type": "string", "description": "For download sources: canonical URL (metadata only)." },
        "referrer": { "type": "string", "description": "Optional referrer URL (metadata only)." },
        "message_id": { "type": "string", "description": "For attachment sources: message identifier (metadata only)." },
        "conversation": { "type": "string", "description": "For attachment/share sources: chat/thread identifier (metadata only)." },
        "operator": { "type": "string", "description": "For manual sources: the asserted operator identity." }
      },
      "additionalProperties": false
    },

    "parents": {
      "type": "array",
      "description": "Optional origin chain (e.g., extracted from an archive or copied from another labeled file).",
      "items": {
        "type": "object",
        "required": ["origin_id"],
        "properties": {
          "origin_id": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "labels": {
      "type": "object",
      "description": "Optional key/value labels (policy-defined).",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
