{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD vulnerability DB snapshot (vuln.db.snapshot) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "snapshot_version",
    "snapshot_id",
    "created_at",
    "sources",
    "raw_digests"
  ],
  "properties": {
    "kind": {"const": "vuln.db.snapshot"},
    "snapshot_version": {"type": "string", "const": "0.1"},

    "snapshot_id": {"type": "string", "description": "Stable identifier for this snapshot manifest (UUID recommended)."},
    "created_at": {"type": "string", "format": "date-time"},

    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "uri", "fetched_at"],
        "properties": {
          "name": {"type": "string", "description": "Source name (osv, vuxml, ghsa, vendor, ...)."},
          "uri": {"type": "string", "description": "Pinned source URI (for operator reference)."},
          "schema": {"type": "string", "description": "Schema/version hint for the feed (e.g., OSV schema rev, VuXML DTD)."},
          "fetched_at": {"type": "string", "format": "date-time"},
          "signature_digest": {"type": "string", "description": "Optional digest of a signature over the raw feed(s), if provided."}
        },
        "additionalProperties": false
      }
    },

    "raw_digests": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "description": "Digests of raw vulnerability feed blobs included in this snapshot."
    },

    "normalized_digest": {
      "type": "string",
      "description": "Optional digest of a normalized/indexed representation used for offline queries."
    },

    "validity": {
      "type": "object",
      "description": "Optional validity window for the snapshot as a policy input.",
      "properties": {
        "not_before": {"type": "string", "format": "date-time"},
        "not_after": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },

    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
