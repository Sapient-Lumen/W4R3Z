{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD incident timeline (incident.timeline) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "timeline_version",
    "created_at",
    "context",
    "entries"
  ],
  "properties": {
    "kind": { "const": "incident-timeline" },
    "timeline_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "timeline_id": { "type": "string", "description": "Stable id (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "context": {
      "type": "object",
      "description": "Correlation context for the timeline.",
      "required": ["host_id", "generation_digest"],
      "properties": {
        "host_id": { "type": "string" },
        "generation_digest": { "type": "string" },
        "boot_id": { "type": "string" },
        "incident_id": { "type": "string" },
        "change_id": { "type": "string" },
        "trace_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "scope": {
      "type": "object",
      "description": "Time window and display assumptions.",
      "properties": {
        "start_at": { "type": "string", "format": "date-time" },
        "end_at": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "description": "IANA timezone id used for presentation (optional)." },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },

    "inputs": {
      "type": "object",
      "description": "Digest pointers used to compute this timeline (for reproducibility and review).",
      "properties": {
        "event_segment_digests": { "type": "array", "items": { "type": "string" } },
        "causality_graph_digest": { "type": "string" },
        "bundle_plan_digest": { "type": "string" },
        "redaction_transform_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["at", "class", "summary"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "class": {
            "type": "string",
            "enum": [
              "boot",
              "activation",
              "policy",
              "service",
              "fault",
              "security",
              "network",
              "storage",
              "firmware",
              "operator",
              "other"
            ]
          },
          "severity": { "type": "string", "enum": ["info", "warn", "error", "critical"] },
          "summary": { "type": "string", "description": "One-line human summary (safe to export)." },
          "details": { "type": "string", "description": "Optional short detail string (safe; avoid secrets)." },
          "refs": {
            "type": "array",
            "description": "Pointers to evidence objects/events supporting this entry.",
            "items": {
              "type": "object",
              "properties": {
                "digest": { "type": "string" },
                "kind": { "type": "string" },
                "event_id": { "type": "string" },
                "note": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },

    "summary": {
      "type": "object",
      "description": "Optional high-level summary fields for quick human orientation.",
      "properties": {
        "headline": { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "suspected_root_causes": { "type": "array", "items": { "type": "string" } },
        "recommended_next_steps": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "extensions": {
      "type": "object",
      "description": "Extension space for downstreams/vendors. Prefer namespaced keys.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
