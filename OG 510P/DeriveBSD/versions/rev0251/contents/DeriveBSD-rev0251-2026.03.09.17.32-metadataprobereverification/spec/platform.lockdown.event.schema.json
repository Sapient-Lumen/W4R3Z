{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD platform lockdown event (platform-lockdown-event) (v0.1)",
  "type": "object",
  "required": ["kind", "event_version", "event_id", "at", "host", "phase", "level"],
  "properties": {
    "kind": { "const": "platform-lockdown-event" },
    "event_version": { "type": "string", "pattern": "^0\\.\\d+$" },

    "event_id": { "type": "string", "description": "Stable id (UUID recommended)." },
    "at": { "type": "string", "format": "date-time" },

    "host": {
      "type": "object",
      "required": ["host_id", "generation_digest"],
      "properties": {
        "host_id": { "type": "string" },
        "generation_digest": { "type": "string" },
        "boot_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "phase": {
      "type": "string",
      "description": "Lifecycle phase for lockdown transitions.",
      "enum": ["precheck", "applying", "raised", "failed"]
    },

    "level": {
      "type": "string",
      "enum": ["bootstrap", "operational", "high"]
    },

    "receipt_digest": { "type": "string" },
    "policy_digest": { "type": "string" },

    "message": { "type": "string" },

    "correlation": {
      "type": "object",
      "properties": {
        "change_set_digest": { "type": "string" },
        "step_id": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
