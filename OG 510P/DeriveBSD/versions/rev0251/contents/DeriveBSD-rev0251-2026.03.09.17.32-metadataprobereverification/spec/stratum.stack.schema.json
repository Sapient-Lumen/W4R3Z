{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD stratum stack (stratum.stack) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "stack_version",
    "stack_id",
    "created_at",
    "layers",
    "constraints",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "stratum.stack"
    },
    "stack_version": {
      "type": "string",
      "const": "0.1"
    },
    "stack_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "allowed_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "host",
          "jail",
          "microvm",
          "appvm",
          "compat_view"
        ]
      },
      "uniqueItems": true
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "stratum_manifest_digest",
          "mount_point",
          "precedence"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "abi-anchor",
              "extension",
              "tooling",
              "compat"
            ]
          },
          "stratum_manifest_digest": {
            "type": "string",
            "minLength": 1
          },
          "mount_point": {
            "type": "string",
            "minLength": 1
          },
          "precedence": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "host_fallback",
        "loader_resolution",
        "foreign_abi_policy",
        "write_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "host_fallback": {
          "type": "string",
          "enum": [
            "forbidden"
          ]
        },
        "loader_resolution": {
          "type": "string",
          "enum": [
            "abi-anchor-only"
          ]
        },
        "foreign_abi_policy": {
          "type": "string",
          "enum": [
            "same-abi-only",
            "compat-view-only",
            "microvm-only"
          ]
        },
        "write_policy": {
          "type": "string",
          "enum": [
            "separate-datasets-only"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "record_stratum_stack_digest",
        "record_mount_view_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "record_stratum_stack_digest": {
          "type": "boolean"
        },
        "record_mount_view_digest": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
