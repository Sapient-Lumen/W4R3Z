{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Intent Request (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "request_version",
    "action",
    "subject",
    "caller",
    "issued_at"
  ],
  "properties": {
    "kind": {"const": "intent-request"},
    "request_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "action": {
      "type": "string",
      "enum": ["open", "view", "edit", "share", "print"],
      "description": "High-level user intent. v0 is intentionally small."
    },

    "subject": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["file", "url", "blob"]},

        "mime_type": {"type": "string"},
        "uri": {"type": "string", "description": "For url subjects. Prefer binding to a parsed scheme in policy."},

        "bookmark_id": {"type": "string", "description": "For file subjects: optional persistent bookmark reference."},
        "portal_grant_digest": {"type": "string", "description": "For file subjects: optional digest of an existing portal grant."},

        "blob_digest": {"type": "string", "description": "For blob subjects: digest of referenced data."},
        "blob_size": {"type": "integer"}
      },
      "additionalProperties": false
    },

    "caller": {
      "type": "object",
      "required": ["uid"],
      "properties": {
        "uid": {"type": "integer"},
        "pid": {"type": "integer"},
        "service_name": {"type": "string"},
        "service_digest": {"type": "string"},
        "instance_id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "context": {
      "type": "object",
      "properties": {
        "plan_digest": {"type": "string"},
        "policy_snapshot_digest": {"type": "string"},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },

    "constraints": {
      "type": "object",
      "description": "Optional constraints (require_interactive, redaction_profile_digest, max_bytes, ttl_seconds, etc.).",
      "additionalProperties": true
    },

    "issued_at": {"type": "string", "description": "ISO8601 time."},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string"}
      },
      "additionalProperties": false,
      "description": "Optional in workstation mode; may be required for cross-compartment routing."
    }
  },
  "additionalProperties": false
}
