{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD service snapshot (svc.snapshot) (v0)",
  "type": "object",
  "required": [
    "kind",
    "snapshot_version",
    "generation_digest",
    "services"
  ],
  "properties": {
    "kind": {
      "const": "svc-snapshot"
    },
    "snapshot_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "generation_digest": {
      "type": "string"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "desired",
          "state",
          "since"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "desired": {
            "type": "string",
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "uninitialized",
              "offline",
              "online",
              "degraded",
              "maintenance",
              "disabled",
              "legacy-run"
            ]
          },
          "since": {
            "type": "string",
            "format": "date-time"
          },
          "restarts_window": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "window_seconds": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": true
          },
          "last_exit": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer"
              },
              "signal": {
                "type": "integer"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": true
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Digest pointers to evidence objects (logs, crash capsules, faults)."
            }
          },
          "fault_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Digest pointers to fault events/diagnoses tied to this service."
            }
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          },
          "instance_id": {
            "type": "string",
            "description": "Optional service instance id (default semantic: 'default')."
          },
          "contract_handle_digest": {
            "type": "string",
            "description": "Optional digest pointer to a svc-contract-handle evidence object describing the service boundary."
          }
        },
        "additionalProperties": true
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
