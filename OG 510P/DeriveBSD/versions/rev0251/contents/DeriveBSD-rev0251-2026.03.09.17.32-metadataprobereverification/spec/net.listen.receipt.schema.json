{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Network Listen Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "grant_digest",
    "subject",
    "listeners",
    "captured_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "net-listen-receipt"},
    "receipt_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "grant_digest": {"type": "string"},

    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": {"type": "string"},
        "digest": {"type": "string"},
        "instance": {"type": "string"}
      },
      "additionalProperties": false
    },

    "listeners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["listener_id", "proto", "bound", "mode"],
        "properties": {
          "listener_id": {"type": "string"},
          "proto": {"type": "string", "enum": ["tcp", "udp"]},
          "bound": {
            "type": "object",
            "required": ["ip", "port"],
            "properties": {
              "ip": {"type": "string"},
              "port": {"type": "integer", "minimum": 0, "maximum": 65535},
              "interface": {"type": "string"}
            },
            "additionalProperties": false
          },
          "mode": {
            "type": "string",
            "enum": ["held-by-broker", "fd-passed", "proxy-forward"],
            "description": "How the listener is realized: broker holds it; broker passes FDs; broker proxies/forwards to a workload."
          },
          "pf_anchor": {"type": "string"},
          "pf_rules_digest": {"type": "string"}
        },
        "additionalProperties": false
      }
    },

    "captured_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "object"}
  },
  "additionalProperties": false
}
