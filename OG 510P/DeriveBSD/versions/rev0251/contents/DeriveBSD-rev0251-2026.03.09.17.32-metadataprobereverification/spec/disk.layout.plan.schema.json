{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD disk layout plan (disk.layout.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "table",
    "partitions"
  ],
  "properties": {
    "kind": {
      "const": "disk-layout-plan"
    },
    "plan_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "plan_id": {
      "type": "string",
      "description": "Stable id for the plan (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "requested_by": {
      "type": "string",
      "description": "Opaque operator/workflow id (optional)."
    },
    "target_device": {
      "type": "object",
      "description": "Optional selector to reduce the risk of applying the plan to the wrong disk.",
      "properties": {
        "by_path": { "type": "string" },
        "serial": { "type": "string" },
        "wwn": { "type": "string" },
        "min_size_bytes": { "type": "integer", "minimum": 1048576 },
        "max_size_bytes": { "type": "integer", "minimum": 1048576 }
      },
      "additionalProperties": false
    },
    "table": {
      "type": "string",
      "enum": ["gpt"]
    },
    "additive_by_default": {
      "type": "boolean",
      "default": true,
      "description": "If true, applying the plan must not shrink/reformat existing partitions unless breakglass-approved."
    },
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "size"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": {
            "type": "string",
            "enum": ["efi", "boot", "swap", "zfs", "ufs", "data", "factory-reset", "spare"]
          },
          "type_guid": {
            "type": "string",
            "description": "Optional explicit GPT type GUID. If omitted, role/content imply a default.",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "partition_guid": {
            "type": "string",
            "description": "Optional desired partition UUID. If omitted, the applier chooses and records it in the receipt.",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "size": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": { "type": "string", "enum": ["fixed", "min-grow"] },
              "bytes": { "type": "integer", "minimum": 1048576 },
              "min_bytes": { "type": "integer", "minimum": 1048576 },
              "grow_to_fill": { "type": "boolean" }
            },
            "allOf": [
              {
                "if": { "properties": { "mode": { "const": "fixed" } } },
                "then": { "required": ["bytes"], "not": { "required": ["min_bytes"] } }
              },
              {
                "if": { "properties": { "mode": { "const": "min-grow" } } },
                "then": { "required": ["min_bytes"], "properties": { "grow_to_fill": { "const": true } } }
              }
            ],
            "additionalProperties": false
          },
          "content": {
            "type": "string",
            "enum": ["fat32", "swap", "zfs", "ufs", "raw"],
            "description": "High-level content type; applier chooses concrete formatting tools."
          },
          "zfs": {
            "type": "object",
            "description": "Only meaningful for role=zfs.",
            "properties": {
              "pool_name": { "type": "string" },
              "topology": { "type": "string", "enum": ["single", "mirror"] },
              "ashift": { "type": "integer", "minimum": 9, "maximum": 16 },
              "encryption_policy_ref": {
                "type": "string",
                "description": "Digest/handle referencing the policy for obtaining the ZFS encryption key (optional)."
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
