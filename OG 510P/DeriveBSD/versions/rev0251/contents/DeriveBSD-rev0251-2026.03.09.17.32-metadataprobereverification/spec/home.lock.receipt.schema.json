{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD portable home lock receipt (home.lock.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "user",
    "home_area",
    "result"
  ],
  "properties": {
    "kind": {"const": "home.lock.receipt"},
    "receipt_version": {"type": "string", "const": "0.1"},
    "receipt_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "user": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"}
      },
      "additionalProperties": false
    },
    "home_area": {
      "type": "object",
      "required": ["area_id"],
      "properties": {
        "area_id": {"type": "string"},
        "record_digest": {"type": "string"},
        "mount_point": {"type": "string"}
      },
      "additionalProperties": false
    },
    "result": {"type": "string", "enum": ["locked", "failed"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
