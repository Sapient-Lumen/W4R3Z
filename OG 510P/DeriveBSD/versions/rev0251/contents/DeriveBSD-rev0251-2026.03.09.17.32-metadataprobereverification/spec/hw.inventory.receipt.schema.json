{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD hardware inventory receipt (hw.inventory.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "host",
    "platform",
    "devices"
  ],
  "properties": {
    "kind": { "const": "hw-inventory-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "receipt_id": { "type": "string", "description": "Stable id for this receipt (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "host": {
      "type": "object",
      "required": ["host_id", "generation_digest"],
      "properties": {
        "host_id": { "type": "string" },
        "generation_digest": { "type": "string" },
        "boot_id": { "type": "string" },
        "machine_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "collector": {
      "type": "object",
      "description": "How the inventory was collected (tools + digests of raw probe outputs).",
      "properties": {
        "tool": { "type": "string", "description": "Collector tool name/version (e.g., 'derive-hwscan 0.1')." },
        "raw_probe_digests": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Digests of raw probe outputs (e.g., devinfo/pciconf/usbconfig output digests)."
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "platform": {
      "type": "object",
      "required": ["boot", "cpu", "memory_mb"],
      "properties": {
        "boot": {
          "type": "object",
          "properties": {
            "uefi": { "type": "boolean" },
            "secure_boot": { "type": "boolean" },
            "tpm": {
              "type": "object",
              "properties": {
                "present": { "type": "boolean" },
                "version": { "type": "string", "description": "e.g., '2.0'" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "bios": {
          "type": "object",
          "properties": {
            "vendor": { "type": "string" },
            "version": { "type": "string" },
            "date": { "type": "string" }
          },
          "additionalProperties": false
        },
        "board": {
          "type": "object",
          "properties": {
            "vendor": { "type": "string" },
            "product": { "type": "string" },
            "revision": { "type": "string" }
          },
          "additionalProperties": false
        },
        "cpu": {
          "type": "object",
          "required": ["model"],
          "properties": {
            "model": { "type": "string" },
            "arch": { "type": "string" },
            "cores": { "type": "integer", "minimum": 1 },
            "features": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "memory_mb": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },

    "privacy": {
      "type": "object",
      "description": "Privacy posture for identifiers included in this receipt.",
      "properties": {
        "serial_hashing": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["none", "hmac"] },
            "alg": { "type": "string", "description": "e.g., 'HMAC-SHA256'" },
            "key_ref": { "type": "string", "description": "Reference to a crypto domain key id (not the key material)." }
          },
          "additionalProperties": false
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["device_id", "transport", "class", "ident"],
        "properties": {
          "device_id": {
            "type": "string",
            "description": "Instance identifier (e.g., pci:bdf:0000:00:14.0 or usb:bus:1:dev:2)."
          },
          "transport": { "type": "string", "enum": ["pci", "usb", "acpi", "virtio", "other"] },
          "class": { "type": "string", "description": "High-level device class (nic, storage, gpu, usb-controller, hid, etc)." },

          "ident": {
            "type": "object",
            "description": "Stable identity facts (prefer IDs over descriptive strings).",
            "properties": {
              "vendor_id": { "type": "string", "description": "Hex string (e.g., '0x8086')." },
              "device_id": { "type": "string", "description": "Hex string." },
              "subsystem_vendor_id": { "type": "string" },
              "subsystem_device_id": { "type": "string" },
              "class_code": { "type": "string", "description": "PCI class code or equivalent." },
              "revision": { "type": "string" },

              "acpi_hid": { "type": "string" },
              "usb_vid": { "type": "string" },
              "usb_pid": { "type": "string" },

              "vendor": { "type": "string" },
              "model": { "type": "string" }
            },
            "additionalProperties": false
          },

          "binding": {
            "type": "object",
            "description": "Observed current binding (best-effort).",
            "properties": {
              "kernel_driver": { "type": "string", "description": "Attached kernel driver (e.g., 'igb')." },
              "module": { "type": "string", "description": "Module/kld name if applicable." },
              "firmware": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Firmware payload digests or identifiers (digest-first)."
              },
              "device_profile_digest": { "type": "string", "description": "Digest of a signed device-profile if known." }
            },
            "additionalProperties": false
          },

          "fingerprint": {
            "type": "object",
            "description": "Optional hashed identifiers for fleet correlation; avoid raw serials.",
            "properties": {
              "serial_hmac": { "type": "string" },
              "asset_tag_hmac": { "type": "string" }
            },
            "additionalProperties": false
          },

          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
