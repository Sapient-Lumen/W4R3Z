{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD devfs view event (devfs.view.event) (v0.1)",
  "allOf": [
    {
      "$ref": "event.record.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "event_version",
        "event_id",
        "at",
        "source",
        "severity",
        "subject",
        "action"
      ],
      "properties": {
        "kind": { "const": "devfs-view-event" },
        "event_version": { "type": "string", "pattern": "^0\\.\\d+$" },
        "event_id": { "type": "string", "description": "Stable id (UUID recommended)." },
        "at": { "type": "string", "format": "date-time" },

        "source": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "description": "Emitter name (applier, drift-checker, etc.)." },
            "host_id": { "type": "string" },
            "domain": { "type": "string" }
          },
          "additionalProperties": false
        },

        "severity": { "type": "string", "enum": ["info", "warning", "error", "critical"] },

        "subject": {
          "type": "object",
          "required": ["host_id", "domain_kind", "domain_id"],
          "properties": {
            "host_id": { "type": "string" },
            "domain_kind": { "type": "string", "enum": ["host", "jail", "microvm"] },
            "domain_id": { "type": "string" },
            "service_id": { "type": "string" }
          },
          "additionalProperties": false
        },

        "action": {
          "type": "string",
          "enum": ["applied", "drift-detected", "write-denied", "ruleset-mismatch", "unexpected-node"]
        },

        "plan_digest": { "type": "string", "description": "Digest of the intended devfs.view.plan (optional)." },
        "expected_rules_digest": { "type": "string" },
        "observed_nodes_digest": { "type": "string" },

        "unexpected_paths": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string" }
        },

        "policy_decision_digest": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  ]
}
