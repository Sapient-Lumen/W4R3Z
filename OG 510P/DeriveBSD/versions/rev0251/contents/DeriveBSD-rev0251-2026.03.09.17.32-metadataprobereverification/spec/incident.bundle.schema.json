{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD incident/support bundle metadata (incident.bundle) (v0)",
  "type": "object",
  "required": [
    "kind",
    "bundle_version",
    "created_at",
    "host",
    "payload"
  ],
  "$defs": {
    "include_knobs": {
      "type": "object",
      "properties": {
        "event_segments": {
          "type": "boolean"
        },
        "svc_snapshot": {
          "type": "boolean"
        },
        "fault_snapshot": {
          "type": "boolean"
        },
        "policy_decisions": {
          "type": "boolean"
        },
        "activation_records": {
          "type": "boolean"
        },
        "coredumps": {
          "type": "boolean",
          "description": "Dangerous: may contain secrets. Off by default; policy-gated."
        },
        "trace_capsules": {
          "type": "boolean",
          "description": "Only include if a trace/replay grant existed and policy allows."
        },
        "replay_capsules": {
          "type": "boolean",
          "description": "Include references to debug.replay.capsule (and optionally trace blobs) if policy allows."
        },
        "packet_capture_sessions": {
          "type": "boolean",
          "description": "Include packet.capture.session digests when bounded packet capture participated in the incident."
        },
        "packet_capture_summaries": {
          "type": "boolean",
          "description": "Include packet.capture.summary digests as the default packet-capture review/export surface."
        },
        "packet_capture_import_receipts": {
          "type": "boolean",
          "description": "Include content.import.packet-capture receipt digests when stronger imported packet artifacts entered the safe-open lane."
        },
        "packet_capture_redaction_receipts": {
          "type": "boolean",
          "description": "Include redaction.receipt packet-capture digests proving normalization of stronger packet artifacts."
        },
        "firmware_inventory": {
          "type": "boolean",
          "description": "Include fw-device-inventory digest reference (safe by design)."
        },
        "firmware_update_receipts": {
          "type": "boolean",
          "description": "Include recent fw-update-receipt digest references (if present)."
        },
        "secret_snapshot": {
          "type": "boolean",
          "description": "Include secret-snapshot digest reference (metadata only; no secret bytes)."
        },
        "secret_receipts": {
          "type": "boolean",
          "description": "Include recent secret-receipt digest references (metadata only)."
        },
        "time_source_inventory": {
          "type": "boolean",
          "description": "Include time-source-inventory digest reference (safe metadata)."
        },
        "time_sync_snapshot": {
          "type": "boolean",
          "description": "Include time-sync-snapshot digest reference (safe metadata)."
        },
        "time_sync_receipts": {
          "type": "boolean",
          "description": "Include recent time-sync-receipt digest references (safe metadata)."
        },
        "crash_reports": {
          "type": "boolean",
          "description": "Include crash-report evidence objects (safe metadata) when available."
        },
        "kernel_dumps": {
          "type": "boolean",
          "description": "Dangerous: kernel dumps may contain secrets. Off by default; policy-gated."
        },
        "storage_pool_inventory": {
          "type": "boolean",
          "description": "Include storage-pool-inventory digest reference (safe by design)."
        },
        "storage_health_snapshot": {
          "type": "boolean",
          "description": "Include storage-health-snapshot digest reference (safe metadata)."
        },
        "storage_scrub_receipts": {
          "type": "boolean",
          "description": "Include recent storage-scrub-receipt digest references (metadata only)."
        },
        "pki_trust_bundle": {
          "type": "boolean",
          "description": "Include pki trust bundle digest reference (safe metadata)."
        },
        "pki_issue_receipts": {
          "type": "boolean",
          "description": "Include recent pki issuance receipt digest references (metadata only)."
        },
        "breakglass_receipts": {
          "type": "boolean",
          "description": "Include recent breakglass-receipt digest references (metadata only)."
        },
        "lease_snapshot": {
          "type": "boolean",
          "description": "Include lease-snapshot digest reference (metadata-only list of active leases)."
        },
        "lease_revoke_events": {
          "type": "boolean",
          "description": "Include recent lease-revoke-event ids (metadata-only revocation evidence)."
        },
        "lint_reports": {
          "type": "boolean",
          "description": "Include relevant lint-report digests (compile/lint outputs) if available."
        },
        "boot_bless_receipts": {
          "type": "boolean",
          "description": "Include recent boot-bless-receipt digest references (if present)."
        },
        "svc_contract_handles": {
          "type": "boolean",
          "description": "Include referenced svc-contract-handle digests (service boundary handles) when relevant."
        },
        "bootchain_policies": {
          "type": "boolean",
          "description": "Include referenced bootchain-policy digests (targeted boot revocations/allowlists) when relevant."
        },
        "causality_graphs": {
          "type": "boolean",
          "description": "Include causality-graph digests (minimal evidence index) when available."
        },
        "bundle_plans": {
          "type": "boolean",
          "description": "Include bundle.plan digests (selection/transform plan) when available."
        },
        "export_policies": {
          "type": "boolean",
          "description": "Include export.policy digests relevant to the payload (share contract)."
        },
        "export_receipts": {
          "type": "boolean",
          "description": "Include export.receipt digests that record sharing the bundle/payload."
        },
        "lease_envelopes": {
          "type": "boolean",
          "description": "Include lease.envelope digests referenced by lease snapshots (optional)."
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "kind": {
      "const": "incident-bundle"
    },
    "bundle_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "bundle_id": {
      "type": "string",
      "description": "Stable id for the bundle (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "trigger": {
      "type": "object",
      "description": "Why the bundle was created.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "manual",
            "fault",
            "crash",
            "health-gate-rollback",
            "policy"
          ]
        },
        "note": {
          "type": "string"
        },
        "event_id": {
          "type": "string",
          "description": "Related event id (if triggered by an event record)."
        },
        "fault_id": {
          "type": "string"
        },
        "service_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "required": [
        "host_id",
        "generation_digest"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "generation_digest": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        },
        "kernel": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "uptime_s": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "description": "Time/size bounds and inclusion knobs.",
      "properties": {
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "until": {
          "type": "string",
          "format": "date-time"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "include": {
          "$ref": "#/$defs/include_knobs"
        }
      },
      "additionalProperties": false
    },
    "includes": {
      "type": "object",
      "description": "Evidence digests/ids included or referenced by the payload.",
      "properties": {
        "event_segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stream_id",
              "segment_digest"
            ],
            "properties": {
              "stream_id": {
                "type": "string"
              },
              "segment_id": {
                "type": "string"
              },
              "segment_digest": {
                "type": "string"
              },
              "from": {
                "type": "string",
                "format": "date-time"
              },
              "until": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        },
        "incident_timeline_digest": {
          "type": "string",
          "description": "Digest of the incident.timeline artifact included as the default human orientation surface when present."
        },
        "svc_snapshot_digest": {
          "type": "string"
        },
        "fault_snapshot_digest": {
          "type": "string"
        },
        "boot_health_report_digest": {
          "type": "string"
        },
        "policy_decision_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activation_record_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extra": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional evidence digests/ids (optional)."
        },
        "replay_capsule_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced debug.replay.capsule objects."
        },
        "packet_capture_session_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of packet.capture.session objects referenced by the bundle."
        },
        "packet_capture_summary_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of packet.capture.summary objects referenced by the bundle."
        },
        "packet_capture_import_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of content.import.packet-capture receipt objects when stronger packet artifacts were safe-opened."
        },
        "packet_capture_redaction_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of redaction.receipt packet-capture objects proving normalization of stronger packet artifacts."
        },
        "fw_inventory_digest": {
          "type": "string",
          "description": "Digest of referenced fw-device-inventory object."
        },
        "fw_update_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced fw-update-receipt objects."
        },
        "secret_snapshot_digest": {
          "type": "string"
        },
        "secret_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced secret-receipt objects."
        },
        "time_source_inventory_digest": {
          "type": "string",
          "description": "Digest of referenced time-source-inventory object."
        },
        "time_sync_snapshot_digest": {
          "type": "string",
          "description": "Digest of referenced time-sync-snapshot object."
        },
        "time_sync_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced time-sync-receipt objects."
        },
        "crash_report_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced crash-report objects."
        },
        "coredump_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests/ids of referenced core/minidump blobs (if included or referenced)."
        },
        "kernel_dump_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests/ids of referenced kernel dump blobs (if included or referenced)."
        },
        "storage_pool_inventory_digest": {
          "type": "string",
          "description": "Digest of referenced storage-pool-inventory object."
        },
        "storage_health_snapshot_digest": {
          "type": "string",
          "description": "Digest of referenced storage-health-snapshot object."
        },
        "storage_scrub_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced storage-scrub-receipt objects."
        },
        "boot_attestation_digest": {
          "type": "string",
          "description": "Digest of referenced boot.attestation evidence (if captured)."
        },
        "attestation_reference_digest": {
          "type": "string",
          "description": "Digest of referenced attestation-reference (policy scope)."
        },
        "attestation_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced attestation-receipt objects."
        },
        "runtime_measurement_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests/ids of referenced runtime measurement evidence (if captured)."
        },
        "pki_trust_bundle_digest": {
          "type": "string",
          "description": "Digest of referenced trust bundle evidence (pki trust bundle)."
        },
        "pki_issue_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced pki issuance receipts."
        },
        "breakglass_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced breakglass-receipt objects."
        },
        "lease_snapshot_digest": {
          "type": "string",
          "description": "Digest of referenced lease-snapshot object."
        },
        "lease_revoke_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Event ids of referenced lease-revoke-event records."
        },
        "lint_report_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced lint-report objects (e.g., svcdb compile lints)."
        },
        "boot_bless_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced boot-bless-receipt objects (boot assessment decisions)."
        },
        "svc_contract_handle_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced svc-contract-handle objects (service boundary handles)."
        },
        "bootchain_policy_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced bootchain-policy objects."
        },
        "causality_graph_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced causality-graph objects."
        },
        "resource_profile_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource_budget_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource_violation_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trace_session_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trace_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trace_output_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bundle_plan_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced bundle.plan objects."
        },
        "export_policy_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced export.policy objects."
        },
        "export_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced export.receipt objects."
        },
        "lease_envelope_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced lease.envelope objects (optional)."
        },
        "transport_policy_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced transport.policy objects (optional)."
        },
        "transport_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced transport.receipt objects (optional)."
        },
        "consent_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced consent.receipt objects (optional)."
        },
        "export_transparency_entry_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of referenced export.transparency.entry objects (optional)."
        }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "description": "Redaction transforms applied at export/view time.",
      "properties": {
        "transform_digest": {
          "type": "string",
          "description": "Digest/id of a redaction.transform artifact."
        },
        "receipt_digest": {
          "type": "string",
          "description": "Optional redaction receipt digest/id."
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": [
        "format",
        "file_digest"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "tar.zst",
            "zip"
          ]
        },
        "file_digest": {
          "type": "string",
          "description": "Digest of the bundle payload blob (content-addressed)."
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "encryption": {
          "type": "object",
          "description": "Optional encryption metadata (recipient-based).",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none",
                "age",
                "cms",
                "pgp"
              ]
            },
            "recipients": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "signature": {
          "type": "string",
          "description": "Optional signature over bundle payload digest (policy-dependent)."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
