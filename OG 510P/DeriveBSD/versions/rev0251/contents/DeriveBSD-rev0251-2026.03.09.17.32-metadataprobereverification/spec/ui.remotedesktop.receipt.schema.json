{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI RemoteDesktop Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "lease_id",
    "subject",
    "device_types",
    "started_at",
    "signature"
  ],
  "properties": {
    "kind": { "const": "ui-remotedesktop-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "lease_id": { "type": "string" },
    "subject": { "$ref": "ui.remotedesktop.grant.schema.json#/properties/subject" },
    "device_types": { "$ref": "ui.remotedesktop.grant.schema.json#/properties/device_types" },
    "session_id": { "type": "string" },
    "started_at": { "type": "string", "description": "ISO8601 time." },
    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": { "type": "string" },
        "alg": { "type": "string" },
        "sig": { "type": "string", "description": "Signature over canonical JSON bytes." }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
