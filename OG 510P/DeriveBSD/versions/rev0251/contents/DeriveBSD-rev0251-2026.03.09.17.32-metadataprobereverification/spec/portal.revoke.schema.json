{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Portal Revoke (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "revoke_version",
    "lease_id",
    "grant_ref",
    "revoked_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "portal-revoke"},
    "revoke_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "lease_id": {"type": "string", "description": "Lease identifier being revoked."},

    "grant_ref": {
      "type": "string",
      "description": "Digest/ref of the portal.grant evidence object this revocation applies to (e.g., sha256:...)."
    },

    "reason": {"type": "string", "description": "Optional human/operator reason."},

    "context": {
      "type": "object",
      "description": "Optional linkage to higher-level DeriveBSD objects.",
      "properties": {
        "plan_digest": {"type": "string"},
        "policy_decision_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "revoked_at": {"type": "string", "description": "ISO8601 time."},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string", "description": "Signature over canonical JSON bytes."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
