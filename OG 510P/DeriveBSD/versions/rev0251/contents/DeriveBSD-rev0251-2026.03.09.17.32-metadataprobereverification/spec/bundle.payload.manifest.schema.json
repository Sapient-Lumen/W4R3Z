{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD bundle payload manifest (bundle.payload.manifest) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "manifest_version",
    "created_at",
    "host",
    "plan_digest",
    "payload",
    "entries"
  ],
  "properties": {
    "kind": {"const": "bundle.payload.manifest"},
    "manifest_version": {"type": "string", "const": "0.1"},
    "manifest_id": {"type": "string", "description": "Optional stable id for this manifest instance."},
    "created_at": {"type": "string", "format": "date-time"},

    "host": {
      "type": "object",
      "required": [
        "host_id",
        "generation_digest"
      ],
      "properties": {
        "host_id": {"type": "string"},
        "generation_digest": {"type": "string"},
        "boot_id": {"type": "string"},
        "arch": {"type": "string"}
      },
      "additionalProperties": false
    },

    "plan_digest": {
      "type": "string",
      "description": "Digest of the bundle.plan used for selection + transforms." 
    },

    "payload": {
      "type": "object",
      "required": [
        "payload_digest",
        "format"
      ],
      "properties": {
        "payload_digest": {"type": "string"},
        "format": {"type": "string", "enum": ["tar.zst", "zip"]},
        "bytes": {"type": "integer", "minimum": 0},
        "encryption": {
          "type": "object",
          "properties": {
            "mode": {"type": "string", "enum": ["none", "encrypt-for-recipient"]},
            "recipient_hint": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "transforms": {
      "type": "object",
      "description": "Optional transform bindings used to produce the payload (redaction/export policy).",
      "properties": {
        "redaction_transform_digest": {"type": "string"},
        "export_policy_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "entries": {
      "type": "array",
      "description": "Deterministic, stable-ordered list of payload members with digests.",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "description": "Path inside the payload (normalized, forward-slash)."},
          "sha256": {"type": "string", "description": "Digest of the member bytes."},
          "bytes": {"type": "integer", "minimum": 0},
          "category": {
            "type": "string",
            "description": "Optional coarse grouping for UX (evidence, logs, config, traces, dumps, metadata)."
          },
          "source": {
            "type": "object",
            "description": "Optional pointer back to a typed evidence object represented by this member.",
            "properties": {
              "kind": {"type": "string"},
              "digest": {"type": "string"}
            },
            "additionalProperties": false
          },
          "sensitivity": {
            "type": "string",
            "enum": ["public", "restricted", "secretish"],
            "description": "Optional data sensitivity classification (never implies bytes were included)."
          },
          "redacted": {"type": "boolean", "description": "True if a redaction transform modified this member."}
        },
        "additionalProperties": false
      }
    },

    "notes": {"type": "string"},

    "signature": {
      "type": "object",
      "description": "Optional signature over this manifest envelope.",
      "properties": {
        "sig_alg": {"type": "string"},
        "public_key_hint": {"type": "string"},
        "signature": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
