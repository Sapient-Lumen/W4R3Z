{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD operator session envelope (operator.session) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "session_version",
    "session_id",
    "created_at",
    "host",
    "principal",
    "transport",
    "scopes"
  ],
  "properties": {
    "kind": {
      "const": "operator-session"
    },
    "session_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "session_id": {
      "type": "string",
      "description": "Stable id (UUID recommended) for the operator session."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "required": [
        "host_id",
        "generation_digest"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "generation_digest": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "zone": {
          "type": "string",
          "description": "Optional site/cluster/tenant label."
        }
      },
      "additionalProperties": false
    },
    "principal": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Operator principal id (username, SSO subject, or SSH cert principal)."
        },
        "display": {
          "type": "string"
        },
        "issuer": {
          "type": "string",
          "description": "Identity issuer name (SSO, SSH CA, etc.)."
        },
        "identity_receipt_digest": {
          "type": "string",
          "description": "Optional pointer to a publisher/operator identity receipt artifact."
        }
      },
      "additionalProperties": false
    },
    "transport": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ssh",
            "console",
            "serial",
            "microvm-console"
          ]
        },
        "remote_addr": {
          "type": "string",
          "description": "Remote address observed (ip:port or equivalent)."
        },
        "client_fingerprint": {
          "type": "string",
          "description": "Optional client key/cert fingerprint (hash)."
        },
        "ssh_user_cert_fingerprint": {
          "type": "string",
          "description": "Optional fingerprint of the SSH user certificate used to authenticate."
        }
      },
      "additionalProperties": false
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Active session scopes (e.g. role shell, PTY, port-forwarding, recording)."
    },
    "constraints": {
      "type": "object",
      "properties": {
        "forced_command": {
          "type": "string"
        },
        "role_shell": {
          "type": "string"
        },
        "forwarding": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "boolean"
            },
            "x11": {
              "type": "boolean"
            },
            "port": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "lease_envelopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional digests of lease.envelope objects authorizing the session."
    },
    "tty_recording_digests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional digests of tty.session.recording evidence objects."
    },
    "correlation": {
      "type": "object",
      "properties": {
        "support_session_id": {
          "type": "string",
          "description": "If this operator session was part of a remote assistance event."
        },
        "change_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "incident_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
