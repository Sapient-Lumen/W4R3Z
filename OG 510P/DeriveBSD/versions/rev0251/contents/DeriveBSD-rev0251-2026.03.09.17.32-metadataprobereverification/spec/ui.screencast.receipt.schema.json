{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI ScreenCast Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "lease_id",
    "subject",
    "selection",
    "stream",
    "started_at",
    "signature"
  ],
  "properties": {
    "kind": { "const": "ui-screencast-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "lease_id": { "type": "string" },
    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string" },
        "digest": { "type": "string" },
        "instance": { "type": "string" }
      },
      "additionalProperties": false
    },
    "selection": { "$ref": "ui.screencast.grant.schema.json#/properties/selection" },
    "stream": {
      "type": "object",
      "required": ["transport", "handle_digest"],
      "properties": {
        "transport": {
          "type": "string",
          "enum": ["pipewire", "ocap-rpc", "other"],
          "description": "How the stream capability is delivered to the workload."
        },
        "handle_digest": {
          "type": "string",
          "description": "Digest of the opaque stream handle / FD escrow reference."
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "started_at": { "type": "string", "description": "ISO8601 time." },
    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": { "type": "string" },
        "alg": { "type": "string" },
        "sig": { "type": "string", "description": "Signature over canonical JSON bytes." }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
