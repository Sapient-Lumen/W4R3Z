{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD attestation reference values (attestation.reference) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "reference_version",
    "created_at",
    "scope",
    "pcr_selection",
    "boot"
  ],
  "properties": {
    "kind": {
      "const": "attestation-reference"
    },
    "reference_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "reference_id": {
      "type": "string",
      "description": "Stable id for the reference values object (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "description": "Policy scope this reference applies to (fleet role, pool, hardware class, etc.).",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable scope name (e.g. prod/web, ci/builders, edge/gw)."
        },
        "selector": {
          "type": "object",
          "description": "Optional selector hints for verifiers/admission (labels, platform class, etc.)."
        }
      },
      "additionalProperties": false
    },
    "pcr_selection": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "bank",
          "pcrs"
        ],
        "properties": {
          "bank": {
            "type": "string",
            "description": "PCR bank algorithm (sha1, sha256, sha384, ...)."
          },
          "pcrs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            }
          }
        },
        "additionalProperties": false
      }
    },
    "boot": {
      "type": "object",
      "description": "Boot reference values (prefer event-log replay against manifests).",
      "required": [
        "accepted_boot_manifest_digests"
      ],
      "properties": {
        "accepted_boot_manifest_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "accepted_generation_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strict_pcr_values": {
          "type": "array",
          "description": "Optional strict PCR allowlist (only for controlled platforms).",
          "items": {
            "type": "object",
            "required": [
              "bank",
              "pcr",
              "value_hex"
            ],
            "properties": {
              "bank": {
                "type": "string"
              },
              "pcr": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "value_hex": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]+$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "bootchain_policy_digest": {
      "type": "string",
      "description": "Optional digest/id of bootchain.policy used for targeted revocation/allowlisting."
    },
    "firmware": {
      "type": "object",
      "description": "Optional firmware expectations.",
      "properties": {
        "require_esrt": {
          "type": "boolean",
          "default": false
        },
        "accepted_fw_inventory_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "description": "Optional runtime integrity reference (IMA-shaped).",
      "properties": {
        "runtime_policy_digest": {
          "type": "string",
          "description": "Digest of runtime policy object (allowlist/appraisal rules)."
        },
        "required": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
