{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Portal Permission Grant (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "subject",
    "portal_family",
    "resource_id",
    "operations",
    "request_shape_digest",
    "prompt_template_digest",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "portal-permission-grant"
    },
    "grant_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "portal_family": {
      "type": "string"
    },
    "resource_id": {
      "type": "string",
      "description": "Portal-defined resource identifier (e.g. printer UUID, location scope, file bookmark id)."
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "request_shape_digest": {
      "type": "string",
      "description": "Digest of canonical request shape (fields that matter for meaning)."
    },
    "prompt_template_digest": {
      "type": "string",
      "description": "Digest of the UI prompt template used for consent."
    },
    "constraints": {
      "type": "object",
      "properties": {
        "expires_at": {
          "type": "string"
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_scope": {
          "type": "string"
        },
        "redaction_profile_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "issued_at": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
