{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD mirror kit import receipt (mirror.import.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_digest",
    "policy_digest",
    "source",
    "channels",
    "verification",
    "imports",
    "result"
  ],
  "properties": {
    "kind": { "const": "mirror.import.receipt" },
    "receipt_version": { "type": "string", "const": "0.1" },
    "receipt_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },

    "plan_digest": { "type": "string" },
    "policy_digest": { "type": "string" },

    "source": {
      "type": "object",
      "required": ["type", "ref"],
      "properties": {
        "type": { "type": "string", "enum": ["path", "bundle-digest", "url"] },
        "ref": { "type": "string" },
        "kit_digest": { "type": "string" },
        "kit_manifest_digest": { "type": "string", "description": "Digest of mirror.kit.manifest carried by the kit (if present)." }
      },
      "additionalProperties": false
    },

    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "snapshot": { "type": "string", "description": "Resolved snapshot/timestamp id (if known)." }
        },
        "additionalProperties": false
      }
    },

    "verification": {
      "type": "object",
      "description": "Verification summary (details live in logs/evidence objects).",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "deny", "fail"] },
        "metadata_verified": { "type": "boolean" },
        "artifacts_verified": { "type": "boolean" },
        "expired_metadata": { "type": "boolean" },
        "message": { "type": "string" },
        "log_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "imports": {
      "type": "object",
      "description": "What was imported into quarantine caches.",
      "required": ["to"],
      "properties": {
        "to": { "type": "string", "enum": ["quarantine"] },
        "quarantine_id": { "type": "string" },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["digest", "type"],
            "properties": {
              "digest": { "type": "string" },
              "type": { "type": "string", "enum": ["metadata", "artifact", "delta", "source"] },
              "size_bytes": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "counts": {
          "type": "object",
          "properties": {
            "objects_added": { "type": "integer", "minimum": 0 },
            "bytes_added": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "cache_state_digest": { "type": "string", "description": "Digest of the resulting quarantine cache state (implementation-defined)." }
      },
      "additionalProperties": false
    },

    "evidence": {
      "type": "object",
      "description": "Pointers to related evidence objects (optional).",
      "properties": {
        "event_segment_digests": { "type": "array", "items": { "type": "string" } },
        "policy_trace_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "result": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "deny", "fail"] },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
