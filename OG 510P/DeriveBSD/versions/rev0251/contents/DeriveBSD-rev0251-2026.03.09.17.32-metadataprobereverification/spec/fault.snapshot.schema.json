{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Fault Snapshot (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "snapshot_version",
    "host_id",
    "captured_at",
    "active_faults",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "fault-snapshot"
    },
    "snapshot_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "host_id": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "description": "RFC3339 timestamp."
    },
    "active_faults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "diagnosis_id",
          "severity"
        ],
        "properties": {
          "diagnosis_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warn",
              "critical",
              "fatal"
            ]
          },
          "summary": {
            "type": "string"
          },
          "first_seen": {
            "type": "string"
          },
          "last_seen": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
