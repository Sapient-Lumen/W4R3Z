{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD attestation receipt (attestation.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "expires_at",
    "subject",
    "reference_digest",
    "evidence",
    "verdict",
    "signature",
    "authority_semantics"
  ],
  "properties": {
    "kind": {
      "const": "attestation-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "receipt_id": {
      "type": "string",
      "description": "Stable id (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "required": [
        "host_id"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "attester_key_id": {
          "type": "string",
          "description": "Attestation key id (AK) or equivalent identity handle."
        },
        "platform_ueid": {
          "type": "string",
          "description": "Optional hardware UEID / serial-like identifier."
        }
      },
      "additionalProperties": false
    },
    "reference_digest": {
      "type": "string",
      "description": "Digest/id of the attestation-reference used."
    },
    "policy_digest": {
      "type": "string",
      "description": "Optional digest/id of the policy module/decision rules (if separate)."
    },
    "evidence": {
      "type": "object",
      "required": [
        "boot_attestation_digest"
      ],
      "properties": {
        "boot_attestation_digest": {
          "type": "string"
        },
        "boot_event_log_digest": {
          "type": "string",
          "description": "Digest/id of canonicalized boot measurement log (if separately stored)."
        },
        "runtime_measurement_digest": {
          "type": "string",
          "description": "Digest/id of runtime measurement evidence (optional)."
        },
        "fw_inventory_digest": {
          "type": "string",
          "description": "Digest/id of fw-device-inventory used in evaluation (optional)."
        }
      },
      "additionalProperties": false
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "degraded",
        "fail"
      ]
    },
    "reasons": {
      "type": "array",
      "description": "Coarse-grained reason codes and details (no secrets).",
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable reason code (PCR_MISMATCH, EVENT_LOG_INVALID, RUNTIME_TAMPER, ...)."
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "obligations": {
      "type": "array",
      "description": "Optional downstream instructions/constraints (admission hooks).",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "obligation kind (allow-secret, quarantine, require-reimage, ...)."
          },
          "ref": {
            "type": "string",
            "description": "Optional referenced object id/digest."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "correlation": {
      "type": "object",
      "properties": {
        "change_id": {
          "type": "string"
        },
        "incident_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "description": "Optional durable-attestation linkage (posture as a time series).",
      "properties": {
        "chain_id": {
          "type": "string",
          "description": "Stable chain id (e.g., host_id + reference scope)."
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "prev_receipt_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    },
    "authority_semantics": {
      "type": "string",
      "const": "attestation-evidence-only",
      "description": "Explicitly marks attestation.receipt as verifier evidence rather than issued authority."
    }
  },
  "additionalProperties": false
}
