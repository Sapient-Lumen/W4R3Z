{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Flow Label (flow.label) (v0.1)",
  "type": "object",
  "required": ["kind", "label_version", "secrecy", "integrity"],
  "properties": {
    "kind": { "const": "flow.label" },
    "label_version": { "type": "string", "const": "0.1" },

    "secrecy": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Secrecy/confidentiality tags (e.g., external, pii, keys)."
    },
    "integrity": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Integrity/taint tags (e.g., untrusted, sanitized, signed)."
    },

    "provenance": {
      "type": "object",
      "description": "Optional provenance hints; not a substitute for content.origin.",
      "additionalProperties": { "type": "string" }
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
