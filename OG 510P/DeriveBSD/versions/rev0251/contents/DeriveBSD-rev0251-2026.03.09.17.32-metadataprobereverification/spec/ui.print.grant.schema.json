{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI Print Grant (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "subject",
    "destination",
    "settings_digest",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "ui-print-grant"
    },
    "grant_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "lease_id": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "string",
      "enum": [
        "printer",
        "pdf",
        "remote-queue"
      ]
    },
    "printer_id": {
      "type": "string",
      "description": "Portal-defined identifier if destination=printer."
    },
    "settings_digest": {
      "type": "string",
      "description": "Digest of canonical print settings bundle."
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "color_allowed": {
          "type": "boolean"
        },
        "duplex_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "issued_at": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
