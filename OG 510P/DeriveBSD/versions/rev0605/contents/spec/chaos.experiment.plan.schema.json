{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD chaos experiment plan (chaos.experiment.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "targets",
    "actions",
    "budgets"
  ],
  "properties": {
    "kind": { "const": "chaos-experiment-plan" },
    "plan_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "plan_id": { "type": "string", "description": "Stable id (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "title": { "type": "string" },
    "hypothesis": { "type": "string" },

    "targets": {
      "type": "object",
      "required": ["selector"],
      "properties": {
        "selector": {
          "type": "object",
          "properties": {
            "fleet": { "type": "string" },
            "host_class": { "type": "string" },
            "match_labels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "max_instances": {
          "type": "integer",
          "minimum": 1,
          "description": "Upper bound of affected instances."
        }
      },
      "additionalProperties": false
    },

    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "duration_sec"],
        "properties": {
          "type": {
            "type": "string",
            "description": "Fault type (kill-service, net-drop, net-delay, io-delay, disk-fill, cpu-stress, ...).",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
          },
          "target": {
            "type": "string",
            "description": "Optional narrower target (svc id, iface name, dataset id, ...)."
          },
          "params": {
            "type": "object",
            "description": "Type-specific parameters.",
            "additionalProperties": true
          },
          "duration_sec": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },

    "budgets": {
      "type": "object",
      "required": ["max_duration_sec"],
      "properties": {
        "max_duration_sec": { "type": "integer", "minimum": 1 },
        "safety_stop": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "description": "Stop condition type (error_rate, latency_p99, availability, custom)."
            },
            "threshold": { "type": "string" },
            "window_sec": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "approvals": {
      "type": "object",
      "properties": {
        "min_approvers": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "correlation": {
      "type": "object",
      "properties": {
        "change_id": { "type": "string" },
        "incident_id": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
