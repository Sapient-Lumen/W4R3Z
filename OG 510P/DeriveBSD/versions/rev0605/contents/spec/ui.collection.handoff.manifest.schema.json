{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI Collection Handoff Manifest (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "manifest_version",
    "authoritative_manifest",
    "collection_digest",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "ui.collection.handoff.manifest"
    },
    "manifest_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "authoritative_manifest": {
      "type": "object",
      "required": [
        "selected_roots",
        "members"
      ],
      "properties": {
        "selected_roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Exact reviewed selected-root set. Selected roots stay overlap-free after normalization and are authoritative reviewed state."
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "review_path",
              "member_kind"
            ],
            "properties": {
              "review_path": {
                "type": "string",
                "description": "Normalized collection-relative review path."
              },
              "member_kind": {
                "type": "string",
                "enum": [
                  "directory",
                  "regular-file"
                ]
              },
              "payload_digest": {
                "type": "string",
                "description": "Exact payload digest for regular-file members."
              },
              "byte_length": {
                "type": "integer",
                "minimum": 0,
                "description": "Exact byte length for regular-file members."
              },
              "advisory_mime": {
                "type": "string",
                "description": "Optional descriptive MIME hint; non-authoritative."
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "member_kind": {
                      "const": "regular-file"
                    }
                  }
                },
                "then": {
                  "required": [
                    "payload_digest",
                    "byte_length"
                  ]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "payload_digest"
                        ]
                      },
                      {
                        "required": [
                          "byte_length"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "description": "Authoritative ancestor-closed canonical member manifest for the reviewed finite collection."
        }
      },
      "additionalProperties": false,
      "description": "Canonical manifest payload whose JCS bytes are hashed to produce collection_digest."
    },
    "collection_digest": {
      "type": "string",
      "description": "Authoritative compact identity of the reviewed finite collection: sha256(utf8(JCS(authoritative_manifest)))."
    },
    "issued_at": {
      "type": "string",
      "description": "ISO8601 time."
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Portable manifest-first review/export surface for the reviewed finite-collection handoff lane."
}
