{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD rollout assignment (rollout.assignment) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "assignment_version",
    "assignment_id",
    "created_at",
    "host",
    "approved_next_release_capsule_digest"
  ],
  "properties": {
    "kind": { "const": "rollout.assignment" },
    "assignment_version": { "type": "string", "const": "0.1" },

    "assignment_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },

    "host": {
      "type": "object",
      "description": "Prefer hashes; avoid raw identifiers.",
      "required": ["host_id_hash"],
      "properties": {
        "host_id_hash": { "type": "string" },
        "group": { "type": "string", "description": "Optional fleet/group label (for partitioning or update windows)." },
        "cohort_id": { "type": "string", "description": "Optional cohort label/hash if a rollout policy is also in play." }
      },
      "additionalProperties": false
    },

    "rollout_graph_digest": { "type": "string" },
    "rollout_policy_digest": { "type": "string" },

    "approved_next_release_capsule_digest": {
      "type": "string",
      "description": "Digest of the release.capsule that the host is explicitly authorized to move to." 
    },

    "reason_code": {
      "type": "string",
      "enum": ["barrier_override", "emergency_pin", "operator_assignment", "test_canary", "custom"],
      "description": "Optional high-level reason for the assignment." 
    },

    "notes": { "type": "string" },

    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key_id", "sig"],
        "properties": {
          "key_id": { "type": "string" },
          "sig": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
