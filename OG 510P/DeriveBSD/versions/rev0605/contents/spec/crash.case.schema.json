{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD crash case (crash.case) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "case_version",
    "authority_semantics",
    "case_id",
    "created_at",
    "source",
    "signature",
    "reproducers",
    "reproducibility",
    "replay"
  ],
  "properties": {
    "kind": {
      "const": "crash.case"
    },
    "case_version": {
      "type": "string",
      "const": "0.1"
    },
    "authority_semantics": {
      "type": "string",
      "const": "crash-case-evidence-only"
    },
    "case_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "target_id",
        "target_class",
        "target_digest",
        "fuzz_receipt_digest"
      ],
      "properties": {
        "target_id": {
          "type": "string"
        },
        "target_class": {
          "type": "string",
          "enum": [
            "uapi",
            "parser",
            "importer",
            "broker",
            "driver",
            "other"
          ]
        },
        "target_digest": {
          "type": "string"
        },
        "fuzz_receipt_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": [
        "title",
        "hash"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "sanitizer": {
          "type": "string"
        },
        "fault_class": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "reproducers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "format",
          "digest"
        ],
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "syz",
              "c",
              "input",
              "archive",
              "script",
              "other"
            ]
          },
          "digest": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "reproducibility": {
      "type": "object",
      "required": [
        "status",
        "attempts",
        "matching_runs"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "stable",
            "flaky",
            "unreproduced"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "matching_runs": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "replay": {
      "type": "object",
      "required": [
        "isolation",
        "network",
        "lifetime"
      ],
      "properties": {
        "isolation": {
          "type": "string",
          "enum": [
            "microvm",
            "jail",
            "host-adapter"
          ]
        },
        "network": {
          "type": "string",
          "enum": [
            "none",
            "brokered",
            "full"
          ]
        },
        "lifetime": {
          "type": "string",
          "enum": [
            "disposable",
            "persistent"
          ]
        }
      },
      "additionalProperties": false
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
