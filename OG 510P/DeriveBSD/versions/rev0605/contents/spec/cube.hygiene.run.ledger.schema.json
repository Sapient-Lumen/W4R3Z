{
  "$defs": {
    "checkResult": {
      "additionalProperties": false,
      "properties": {
        "child_max_rss_kib_before": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "child_max_rss_kib_best_effort": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "child_max_rss_kib_scope": {
          "enum": [
            "process-cumulative-children-high-water",
            "unavailable"
          ]
        },
        "command": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 2,
          "type": "array"
        },
        "cube_input_file_count": {
          "minimum": 1,
          "type": "integer"
        },
        "cube_input_fingerprint_scope": {
          "enum": [
            "source-docs-spec-tools-fixtures-no-session-reviews-or-ledger-output"
          ]
        },
        "cube_input_sha256": {
          "$ref": "#/$defs/sha256Digest"
        },
        "elapsed_seconds": {
          "minimum": 0,
          "type": "number"
        },
        "failure_class": {
          "enum": [
            "none",
            "exit-nonzero",
            "timed-out",
            "terminated-by-signal"
          ]
        },
        "finished_at_utc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "process_group_isolated": {
          "description": "True when the checker was started in its own process session/group for timeout cleanup.",
          "type": "boolean"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "return_code": {
          "type": "integer"
        },
        "selected_profile": {
          "$ref": "#/$defs/profile"
        },
        "signal_name": {
          "oneOf": [
            {
              "pattern": "^(SIG[A-Z0-9]+|SIGNAL_[0-9]+)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at_utc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "timed-out"
          ]
        },
        "stderr_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "stderr_lines": {
          "minimum": 0,
          "type": "integer"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256Digest"
        },
        "stdout_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "stdout_lines": {
          "minimum": 0,
          "type": "integer"
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256Digest"
        },
        "terminated_by_signal": {
          "type": "boolean"
        },
        "timed_out": {
          "type": "boolean"
        },
        "timeout_grace_seconds": {
          "description": "Grace interval before SIGKILL escalation when a timeout is enforced.",
          "oneOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_kill_scope": {
          "description": "Scope targeted when enforcing a timeout; not-needed for completed checks.",
          "enum": [
            "not-needed",
            "process-group",
            "child-process",
            "already-exited"
          ]
        },
        "timeout_seconds": {
          "$ref": "#/$defs/nullablePositiveNumber"
        },
        "timeout_status": {
          "enum": [
            "not-enforced",
            "completed",
            "timed-out"
          ]
        },
        "timeout_termination_signal": {
          "description": "Best-effort termination signal/cleanup outcome used after a timeout, or null when no timeout occurred.",
          "oneOf": [
            {
              "enum": [
                "SIGTERM",
                "SIGKILL",
                "SIGKILL-unreaped",
                "none"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "tool": {
          "pattern": "^(check_[A-Za-z0-9_]+|lint_spec_schemas|validate_spec_examples)\\.py$",
          "type": "string"
        },
        "tool_sha256": {
          "$ref": "#/$defs/sha256Digest"
        },
        "runner_environment_sha256": {
          "$ref": "#/$defs/sha256Digest"
        },
        "runner_environment_scope": {
          "enum": [
            "python-binary-version-platform-jsonschema"
          ]
        }
      },
      "required": [
        "tool",
        "profile",
        "selected_profile",
        "command",
        "tool_sha256",
        "cube_input_sha256",
        "cube_input_fingerprint_scope",
        "cube_input_file_count",
        "runner_environment_scope",
        "runner_environment_sha256",
        "status",
        "return_code",
        "failure_class",
        "terminated_by_signal",
        "signal_name",
        "timed_out",
        "timeout_seconds",
        "timeout_status",
        "timeout_grace_seconds",
        "timeout_termination_signal",
        "timeout_kill_scope",
        "process_group_isolated",
        "started_at_utc",
        "finished_at_utc",
        "elapsed_seconds",
        "stdout_sha256",
        "stdout_bytes",
        "stdout_lines",
        "stderr_sha256",
        "stderr_bytes",
        "stderr_lines",
        "child_max_rss_kib_best_effort",
        "child_max_rss_kib_scope",
        "child_max_rss_kib_before"
      ],
      "type": "object"
    },
    "nullableNonNegativeInteger": {
      "oneOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullablePositiveNumber": {
      "oneOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "profile": {
      "enum": [
        "all",
        "release-critical",
        "post-detach",
        "generated-surface",
        "schema-cube-audit",
        "deep-contract"
      ]
    },
    "sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "utcTimestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "check_budget_limit": {
      "$ref": "#/$defs/nullableNonNegativeInteger"
    },
    "check_budget_status": {
      "enum": [
        "not-enforced",
        "within-check-budget",
        "stopped-before-check-budget",
        "completed-within-check-budget"
      ]
    },
    "checks_completed": {
      "description": "result rows written so far; partial ledgers have checks_completed < checks_total",
      "minimum": 0,
      "type": "integer"
    },
    "checks_total": {
      "description": "planned selected checks at run start",
      "minimum": 0,
      "type": "integer"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "failed": {
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "minimum": 0,
          "type": "integer"
        },
        "timed_out": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "failed",
        "timed_out"
      ],
      "type": "object"
    },
    "cube_input_file_count": {
      "minimum": 1,
      "type": "integer"
    },
    "cube_input_fingerprint_scope": {
      "enum": [
        "source-docs-spec-tools-fixtures-no-session-reviews-or-ledger-output"
      ]
    },
    "cube_input_sha256": {
      "$ref": "#/$defs/sha256Digest"
    },
    "finished_at_utc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "generated_for_version": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}r[0-9]{3,}$",
      "type": "string"
    },
    "hygiene_wrapper": {
      "const": "tools/hygiene.py"
    },
    "hygiene_wrapper_sha256": {
      "$ref": "#/$defs/sha256Digest"
    },
    "kind": {
      "const": "cube.hygiene.run.ledger"
    },
    "ledger_id": {
      "pattern": "^cube-hygiene-run-ledger-[0-9]{8}-r[0-9]{3,}-(all|release-critical|post-detach|generated-surface|schema-cube-audit|deep-contract)$",
      "type": "string"
    },
    "result": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "results": {
      "items": {
        "$ref": "#/$defs/checkResult"
      },
      "type": "array"
    },
    "run_budget_seconds": {
      "$ref": "#/$defs/nullablePositiveNumber"
    },
    "run_budget_status": {
      "enum": [
        "not-enforced",
        "within-budget",
        "stopped-before-budget",
        "completed-within-budget"
      ]
    },
    "run_complete": {
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0"
    },
    "selected_profile": {
      "$ref": "#/$defs/profile"
    },
    "started_at_utc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "timeout_seconds": {
      "$ref": "#/$defs/nullablePositiveNumber"
    },
    "runner_environment_sha256": {
      "$ref": "#/$defs/sha256Digest"
    },
    "runner_environment_scope": {
      "enum": [
        "python-binary-version-platform-jsonschema"
      ]
    }
  },
  "required": [
    "kind",
    "schema_version",
    "ledger_id",
    "generated_for_version",
    "hygiene_wrapper",
    "hygiene_wrapper_sha256",
    "cube_input_sha256",
    "cube_input_fingerprint_scope",
    "cube_input_file_count",
    "runner_environment_scope",
    "runner_environment_sha256",
    "selected_profile",
    "timeout_seconds",
    "run_budget_status",
    "check_budget_status",
    "check_budget_limit",
    "run_budget_seconds",
    "started_at_utc",
    "finished_at_utc",
    "result",
    "checks_total",
    "run_complete",
    "checks_completed",
    "counts",
    "results"
  ],
  "title": "Cube hygiene run ledger",
  "type": "object"
}
