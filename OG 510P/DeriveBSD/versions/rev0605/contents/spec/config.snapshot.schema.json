{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD effective configuration snapshot (config.snapshot) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "snapshot_version",
    "captured_at",
    "host",
    "generation_id",
    "roots"
  ],
  "properties": {
    "kind": {
      "const": "config-snapshot"
    },
    "snapshot_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "snapshot_id": {
      "type": "string",
      "description": "Stable id for the snapshot (UUID recommended)."
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "required": [
        "host_id"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "domain_id": {
          "type": "string",
          "description": "Optional domain/jail/vm identifier."
        }
      }
    },
    "generation_id": {
      "type": "string"
    },
    "boot_environment": {
      "type": "string"
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "store_path",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "store_path": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "redaction_policy_id": {
            "type": "string"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "recent_receipts": {
      "type": "array",
      "description": "Optional pointers to recent config receipts (digests or store paths).",
      "items": {
        "type": "string"
      }
    }
  }
}
