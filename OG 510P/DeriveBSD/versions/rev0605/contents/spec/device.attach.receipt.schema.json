{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Device Attach Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "lease_id",
    "device",
    "target",
    "attached_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "device-attach-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "lease_id": {
      "type": "string"
    },
    "device": {
      "type": "object",
      "required": [
        "class",
        "id"
      ],
      "properties": {
        "class": {
          "type": "string",
          "description": "Device class (usb-controller, nic, gpu, etc)."
        },
        "id": {
          "type": "string",
          "description": "Stable device/controller identifier (e.g., pci:bdf:0000:00:14.0)."
        },
        "vendor": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "domain_name",
        "domain_digest"
      ],
      "properties": {
        "domain_name": {
          "type": "string"
        },
        "domain_digest": {
          "type": "string",
          "description": "Digest of the device-domain artifact/runtime manifest."
        },
        "instance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "backend": {
          "type": "string",
          "description": "Hypervisor backend (bhyve, etc)."
        },
        "mapping": {
          "type": "object",
          "description": "Optional mapping details (vfio node, bhyve slot, etc).",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "attached_at": {
      "type": "string",
      "description": "ISO8601 time."
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
