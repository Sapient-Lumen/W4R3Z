{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD OCR/searchable inspection derivative plan (content.ocr-inspection.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "source",
    "ocr",
    "output",
    "boundary",
    "policy_digest"
  ],
  "properties": {
    "kind": {
      "const": "content.ocr-inspection.plan"
    },
    "plan_version": {
      "type": "string",
      "const": "0.1"
    },
    "plan_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "import_receipt_digest",
        "source_output_digest",
        "source_class",
        "mime"
      ],
      "properties": {
        "import_receipt_digest": {
          "type": "string"
        },
        "source_output_digest": {
          "type": "string"
        },
        "source_class": {
          "type": "string",
          "const": "sanitized-inspection-derivative"
        },
        "mime": {
          "type": "string",
          "const": "application/pdf"
        },
        "filename": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ocr": {
      "type": "object",
      "required": [
        "languages",
        "derivative_posture",
        "requested_by"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "derivative_posture": {
          "type": "string",
          "const": "explicit-secondary-derivative"
        },
        "requested_by": {
          "type": "string",
          "enum": [
            "user",
            "policy"
          ]
        },
        "engine_profile_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "type",
        "path",
        "mime"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "file"
        },
        "path": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "mime": {
          "type": "string",
          "const": "application/pdf"
        }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": [
        "default_target_role",
        "default_view_posture",
        "automatic_replacement",
        "working_copy_allowed_by_default",
        "local_viewer_search",
        "ambient_host_indexing",
        "detached_text_sidecar_by_default",
        "text_egress_default",
        "clipboard_mime_default",
        "rich_text_transfer_by_default"
      ],
      "properties": {
        "default_target_role": {
          "type": "string",
          "const": "document_viewing"
        },
        "default_view_posture": {
          "type": "string",
          "const": "disposable-first"
        },
        "automatic_replacement": {
          "type": "string",
          "const": "forbidden"
        },
        "working_copy_allowed_by_default": {
          "type": "boolean",
          "const": false
        },
        "local_viewer_search": {
          "type": "string",
          "const": "allowed"
        },
        "ambient_host_indexing": {
          "type": "string",
          "const": "forbidden"
        },
        "detached_text_sidecar_by_default": {
          "type": "boolean",
          "const": false
        },
        "text_egress_default": {
          "type": "string",
          "const": "explicit-datatransfer-only"
        },
        "clipboard_mime_default": {
          "type": "string",
          "const": "text/plain;charset=utf-8"
        },
        "rich_text_transfer_by_default": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    },
    "policy_digest": {
      "type": "string"
    },
    "portal_session_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
