{
  "$defs": {
    "booleanMap": {
      "additionalProperties": {
        "type": "boolean"
      },
      "type": "object"
    },
    "cleanup": {
      "additionalProperties": true,
      "properties": {
        "attempted_mdconfig_detach_after_failure": {
          "type": "boolean"
        },
        "attempted_umount_after_failure": {
          "type": "boolean"
        },
        "cleanup_completed_before_receipt": {
          "type": "boolean"
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/commandResult"
          },
          "type": "array"
        }
      },
      "required": [
        "commands",
        "attempted_umount_after_failure",
        "attempted_mdconfig_detach_after_failure"
      ],
      "type": "object"
    },
    "commandResult": {
      "additionalProperties": true,
      "properties": {
        "command": {
          "$ref": "#/$defs/stringArray"
        },
        "command_role": {
          "type": "string"
        },
        "command_shape_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "host_command_env_keys": {
          "items": {
            "enum": [
              "LC_ALL",
              "PATH"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "host_command_env_policy": {
          "const": "sanitized-locale-and-path-only"
        },
        "observed_stdout_text": {
          "description": "Recorded stdout text for short authority-token rows whose stdout_sha256 must be replayable by the validator.",
          "type": "string"
        },
        "observed_value": {
          "description": "Stripped single-token value derived from observed_stdout_text for host probes or mdconfig/fstyp authority rows.",
          "type": "string"
        },
        "observed_value_key": {
          "description": "Receipt field that observed_value must bind, such as host_probe_* or host_smoke.observed_md_unit.",
          "type": "string"
        },
        "private_work_root_redacted": {
          "type": "boolean"
        },
        "return_code": {
          "type": "integer"
        },
        "stderr_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stdout_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "timed_out": {
          "type": "boolean"
        }
      },
      "required": [
        "command",
        "return_code",
        "timed_out",
        "stdout_sha256",
        "stderr_sha256",
        "stdout_bytes",
        "stderr_bytes"
      ],
      "type": "object"
    },
    "failure": {
      "additionalProperties": true,
      "properties": {
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "receipt_shaped_instead_of_traceback": {
          "const": true
        },
        "stage": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "stage",
        "message",
        "receipt_shaped_instead_of_traceback"
      ],
      "type": "object"
    },
    "host": {
      "additionalProperties": false,
      "properties": {
        "cloudtainer_refusal_is_expected": {
          "type": "boolean"
        },
        "host_probe_capsicum_capabilities": {
          "enum": [
            "0",
            "1"
          ]
        },
        "host_probe_capsicum_capability_mode": {
          "enum": [
            "0",
            "1"
          ]
        },
        "host_probe_effective_uid": {
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "host_probe_observed_system": {
          "type": "string"
        },
        "host_probe_osreldate": {
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "host_probe_uname_machine": {
          "type": "string"
        },
        "host_probe_uname_release": {
          "type": "string"
        },
        "host_target_tier": {
          "enum": [
            "primary-production",
            "supported-legacy-floor",
            "unsupported"
          ]
        },
        "observed_system": {
          "minLength": 1,
          "type": "string"
        },
        "required_os": {
          "const": "FreeBSD"
        },
        "requires_root": {
          "const": true
        }
      },
      "required": [
        "observed_system",
        "required_os",
        "requires_root",
        "cloudtainer_refusal_is_expected"
      ],
      "type": "object"
    },
    "hostProbeResult": {
      "allOf": [
        {
          "$ref": "#/$defs/commandResult"
        },
        {
          "additionalProperties": true,
          "properties": {
            "observed_stdout_text": {
              "minLength": 1,
              "type": "string"
            },
            "observed_value": {
              "minLength": 1,
              "type": "string"
            },
            "observed_value_key": {
              "enum": [
                "host_probe_observed_system",
                "host_probe_uname_release",
                "host_probe_uname_machine",
                "host_probe_effective_uid",
                "host_probe_osreldate",
                "host_probe_capsicum_capability_mode",
                "host_probe_capsicum_capabilities"
              ]
            }
          },
          "required": [
            "observed_value",
            "observed_stdout_text",
            "observed_value_key"
          ],
          "type": "object"
        }
      ]
    },
    "hostSmoke": {
      "additionalProperties": true,
      "properties": {
        "capture_digest": {
          "$ref": "#/$defs/nullableSha256"
        },
        "capture_size_bytes": {
          "oneOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "capture_store_rel": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "host_command_env_keys": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "LC_ALL"
            },
            {
              "const": "PATH"
            }
          ],
          "type": "array"
        },
        "host_command_env_policy": {
          "const": "sanitized-locale-and-path-only"
        },
        "host_probe_values": {
          "oneOf": [
            {
              "$ref": "#/$defs/openObject"
            },
            {
              "type": "null"
            }
          ]
        },
        "host_target_matrix_id": {
          "oneOf": [
            {
              "const": "freebsd-host-proof-targets-20260617-r605"
            },
            {
              "type": "null"
            }
          ]
        },
        "host_target_tier": {
          "oneOf": [
            {
              "enum": [
                "primary-production",
                "supported-legacy-floor",
                "unsupported"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "mdconfig_detached_before_worker": {
          "type": "boolean"
        },
        "observed_fstyp": {
          "oneOf": [
            {
              "const": "ufs"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_md_unit": {
          "description": "Normalized mdconfig unit emitted by readonly vnode attach and replay-bound to fstyp, mount, and detach commands.",
          "oneOf": [
            {
              "pattern": "^md[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "umounted_before_worker": {
          "type": "boolean"
        },
        "worker": {
          "oneOf": [
            {
              "$ref": "#/$defs/openObject"
            },
            {
              "type": "null"
            }
          ]
        },
        "worker_binary_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "worker_cwd_policy": {
          "const": "private-empty-directory-not-media-not-repo"
        },
        "worker_env_policy": {
          "const": "empty-environment"
        },
        "worker_launched": {
          "type": "boolean"
        }
      },
      "required": [
        "umounted_before_worker",
        "mdconfig_detached_before_worker",
        "worker_env_policy",
        "worker_cwd_policy",
        "host_command_env_policy",
        "host_command_env_keys"
      ],
      "type": "object"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "openObject": {
      "additionalProperties": true,
      "type": "object"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "command_path_redaction_policy": {
          "const": "replace-private-work-root-with-$PRIVATE_WORK_ROOT-in-receipts"
        },
        "device_attachment": {
          "const": "mdconfig-vnode-readonly"
        },
        "fd5_canary_source": {
          "const": "broker-nonmedia-canary-not-source-media"
        },
        "filesystem_image": {
          "const": "disposable-ufs-image-created-by-makefs"
        },
        "fixture_manifest_policy": {
          "const": "regular-files-plus-directories-stable-before-makefs"
        },
        "fixture_root_admission_policy": {
          "const": "checked-in-finite-symlink-free-regular-files-only-before-host-commands"
        },
        "fixture_root_allowed_base": {
          "const": "fixtures/removable-media/local-fallback"
        },
        "fixture_root_max_files": {
          "minimum": 1,
          "type": "integer"
        },
        "fixture_root_max_total_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "host_command_env_keys": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "LC_ALL"
            },
            {
              "const": "PATH"
            }
          ],
          "type": "array"
        },
        "host_command_env_policy": {
          "const": "sanitized-locale-and-path-only"
        },
        "host_osreldate_minimum": {
          "const": 1404000
        },
        "host_primary_osreldate_minimum": {
          "const": 1501500
        },
        "host_primary_release": {
          "const": "15.1-RELEASE"
        },
        "host_primary_release_channel": {
          "const": "production"
        },
        "host_release_floor": {
          "const": "14.4-RELEASE"
        },
        "host_release_floor_policy": {
          "const": "require-kern-osreldate-at-or-above-supported-floor-before-media-authority"
        },
        "host_target_matrix_id": {
          "const": "freebsd-host-proof-targets-20260617-r605"
        },
        "host_target_tier_policy": {
          "const": "accept-supported-floor-but-label-primary-production-versus-legacy-floor"
        },
        "lane": {
          "const": "removable-media-local-fallback"
        },
        "mount_options": {
          "maxItems": 5,
          "minItems": 5,
          "prefixItems": [
            {
              "const": "ro"
            },
            {
              "const": "nosuid"
            },
            {
              "const": "noexec"
            },
            {
              "const": "nosymfollow"
            },
            {
              "const": "untrusted"
            }
          ],
          "type": "array"
        },
        "selected_member": {
          "minLength": 1,
          "type": "string"
        },
        "worker_bridge_id": {
          "const": "rm-capsicum-worker-bridge-20260605-r554"
        },
        "worker_source": {
          "const": "tools/freebsd/rm_post_detach_capsicum_worker.c"
        },
        "worker_source_copy_policy": {
          "const": "copy-c-worker-source-into-private-work-root-and-verify-digest-before-compile"
        },
        "worker_source_copy_required_before_compile": {
          "const": true
        },
        "worker_source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "lane",
        "selected_member",
        "fixture_root_admission_policy",
        "fixture_manifest_policy",
        "filesystem_image",
        "device_attachment",
        "mount_options",
        "worker_bridge_id",
        "worker_source",
        "worker_source_sha256",
        "worker_source_copy_policy",
        "worker_source_copy_required_before_compile",
        "fd5_canary_source",
        "command_path_redaction_policy",
        "host_command_env_policy",
        "host_command_env_keys",
        "host_release_floor_policy",
        "host_release_floor",
        "host_osreldate_minimum",
        "host_target_matrix_id",
        "host_target_tier_policy",
        "host_primary_release",
        "host_primary_release_channel",
        "host_primary_osreldate_minimum"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "simulation": {
      "additionalProperties": true,
      "properties": {
        "checker_only_host_command_simulation": {
          "type": "boolean"
        },
        "claims_real_freebsd_execution": {
          "type": "boolean"
        },
        "not_freebsd_host_proof": {
          "type": "boolean"
        }
      },
      "required": [
        "checker_only_host_command_simulation",
        "not_freebsd_host_proof"
      ],
      "type": "object"
    },
    "stringArray": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "utcTimestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "refused"
          }
        }
      },
      "then": {
        "properties": {
          "commands": {
            "maxItems": 0
          },
          "host_probes": {
            "maxItems": 0
          }
        },
        "required": [
          "refusal_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "refusal_reason": {
            "type": "null"
          }
        },
        "required": [
          "failure",
          "host_smoke"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "host_probes": {
            "minItems": 7
          },
          "refusal_reason": {
            "type": "null"
          }
        },
        "required": [
          "host_smoke"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "passed"
          },
          "simulation": {
            "properties": {
              "checker_only_host_command_simulation": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "host": {
            "properties": {
              "host_probe_capsicum_capabilities": {
                "const": "1"
              },
              "host_probe_capsicum_capability_mode": {
                "const": "1"
              },
              "host_probe_effective_uid": {
                "const": "0"
              },
              "host_probe_observed_system": {
                "const": "FreeBSD"
              },
              "observed_system": {
                "const": "FreeBSD"
              }
            }
          },
          "host_probes": {
            "minItems": 7
          },
          "invariants": {
            "properties": {
              "host_osreldate_meets_supported_floor": {
                "const": true
              },
              "host_probe_capsicum_feature_enabled": {
                "const": true
              }
            }
          },
          "simulation": {
            "properties": {
              "not_freebsd_host_proof": {
                "const": false
              }
            }
          }
        }
      }
    }
  ],
  "description": "Receipt for the FreeBSD-only removable-media local fallback host-smoke lane. It validates cloudtainer refusals, receipt-shaped failures, checker-only simulations, and the future real FreeBSD passed receipt without letting simulations overclaim host proof; passed real-host receipts must carry host probes including uname -s FreeBSD, id -u 0, sysctl kern.osreldate, sysctl kern.features.security_capability_mode=1, sysctl kern.features.security_capabilities=1, and host_probe_capsicum_feature_enabled=true, host_osreldate_meets_supported_floor=true; passed/failing host-probe rows must also carry observed_value, observed_stdout_text, and observed_value_key so validators can replay stdout digests and bind probe tokens to host fields.",
  "properties": {
    "cleanup": {
      "$ref": "#/$defs/cleanup"
    },
    "commands": {
      "items": {
        "$ref": "#/$defs/commandResult"
      },
      "type": "array"
    },
    "cube_cut_version": {
      "const": "2026-06-18r630"
    },
    "failure": {
      "oneOf": [
        {
          "$ref": "#/$defs/failure"
        },
        {
          "type": "null"
        }
      ]
    },
    "fixture_admission": {
      "oneOf": [
        {
          "$ref": "#/$defs/openObject"
        },
        {
          "type": "null"
        }
      ]
    },
    "fixture_copy": {
      "oneOf": [
        {
          "$ref": "#/$defs/openObject"
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at_utc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "generated_for_version": {
      "const": "2026-06-05r554"
    },
    "host": {
      "$ref": "#/$defs/host"
    },
    "host_probes": {
      "items": {
        "$ref": "#/$defs/hostProbeResult"
      },
      "type": "array"
    },
    "host_smoke": {
      "$ref": "#/$defs/hostSmoke"
    },
    "invariants": {
      "$ref": "#/$defs/booleanMap"
    },
    "kind": {
      "const": "removable.media.local.freebsd.host.smoke.receipt"
    },
    "refusal_reason": {
      "oneOf": [
        {
          "enum": [
            "non-freebsd-host",
            "root-required",
            "explicit-host-smoke-flag-required",
            "work-dir-must-not-already-exist"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "enum": [
        "refused",
        "failed",
        "passed"
      ]
    },
    "runner_contract_version": {
      "const": "2026-06-05r554"
    },
    "schema_version": {
      "const": "0.1"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "simulation": {
      "$ref": "#/$defs/simulation"
    },
    "smoke_id": {
      "const": "rm-local-freebsd-host-smoke-20260605-r554"
    },
    "worker_source_admission": {
      "oneOf": [
        {
          "$ref": "#/$defs/openObject"
        },
        {
          "type": "null"
        }
      ]
    },
    "worker_source_copy": {
      "oneOf": [
        {
          "$ref": "#/$defs/openObject"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspace": {
      "$ref": "#/$defs/openObject"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "smoke_id",
    "generated_for_version",
    "runner_contract_version",
    "cube_cut_version",
    "generated_at_utc",
    "result",
    "refusal_reason",
    "host",
    "scope",
    "workspace",
    "simulation",
    "host_probes",
    "commands",
    "cleanup",
    "invariants"
  ],
  "title": "Removable media local FreeBSD host smoke receipt",
  "type": "object"
}
