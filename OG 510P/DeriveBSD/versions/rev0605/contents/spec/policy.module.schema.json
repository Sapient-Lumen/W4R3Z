{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Policy Module Evidence (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "module_version",
    "module_digest",
    "abi",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "policy-module"},
    "module_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "module_digest": {"type": "string", "description": "Digest of the Wasm module bytes (e.g., sha256:...)"},

    "abi": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "description": "ABI name (e.g., derive-policy-abi, opa-wasm)"},
        "version": {"type": "string", "description": "ABI version string"}
      },
      "additionalProperties": false
    },

    "language": {"type": "string", "description": "Optional source policy language (rego/cedar/custom)."},
    "compiler": {"type": "string", "description": "Optional compiler/toolchain identifier."},

    "entrypoints": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Named entrypoints supported by the module (default: evaluate)."
    },

    "hostcalls": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Declared hostcalls permitted for this module (should be empty for strict mode)."
    },

    "limits": {
      "type": "object",
      "description": "Declared resource limits for evaluation (fuel/memory).",
      "properties": {
        "fuel": {"type": "integer", "minimum": 0},
        "memory_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },

    "context": {
      "type": "object",
      "description": "Optional binding to DeriveBSD objects (plans/policy bundles).",
      "properties": {
        "policy_bundle_digest": {"type": "string"},
        "plan_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "issued_at": {"type": "string", "description": "ISO8601 time."},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string", "description": "Signature over canonical JSON bytes."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
