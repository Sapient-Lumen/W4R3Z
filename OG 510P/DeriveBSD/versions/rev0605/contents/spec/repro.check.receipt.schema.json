{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD reproducibility check receipt (repro.check.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "applied_at",
    "plan",
    "result",
    "comparisons"
  ],
  "properties": {
    "kind": {
      "const": "repro.check.receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "receipt_id": {
      "type": "string",
      "description": "Stable id for the receipt (UUID recommended)."
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },

    "plan": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "description": "Digest of the plan object."
        },
        "plan_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "result": {
      "type": "string",
      "enum": [
        "match",
        "mismatch",
        "known_impurity",
        "error"
      ]
    },

    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scope",
          "name",
          "expected_digest",
          "observed_digest",
          "status"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "binding",
              "artifact"
            ]
          },
          "name": {
            "type": "string",
            "description": "Binding key or artifact kind being compared."
          },
          "expected_digest": {
            "type": "string"
          },
          "observed_digest": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "match",
              "mismatch",
              "known_impurity",
              "skipped"
            ]
          },
          "impurity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "diff_summary": {
            "type": "string",
            "description": "Short human summary of the difference (optional; keep it tight)."
          },
          "diffoscope_digest": {
            "type": "string",
            "description": "Digest pointer to diffoscope output (HTML or JSON), if produced."
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },

    "summary": {
      "type": "object",
      "properties": {
        "duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "builder_pool": {
          "type": "string"
        },
        "mismatches": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },

    "evidence": {
      "type": "array",
      "description": "Digest pointers to supporting evidence objects (build records, logs, witness statements, policy traces).",
      "items": {
        "type": "string"
      }
    },

    "events": {
      "type": "array",
      "items": {
        "$ref": "event.record.schema.json"
      }
    },

    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
