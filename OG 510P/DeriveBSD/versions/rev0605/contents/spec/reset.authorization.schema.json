{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD destructive reprovision authorization (reset.authorization) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "authorization_version",
    "authorization_id",
    "issued_at",
    "subject",
    "target",
    "requested",
    "destructive_scope",
    "retention",
    "authority"
  ],
  "properties": {
    "kind": {
      "const": "reset.authorization"
    },
    "authorization_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "authorization_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "required": [
        "host_id"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "profile": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "fleet": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "by_path": {
          "type": "string"
        },
        "serial": {
          "type": "string"
        },
        "wwn": {
          "type": "string"
        },
        "min_size_bytes": {
          "type": "integer",
          "minimum": 1048576
        },
        "max_size_bytes": {
          "type": "integer",
          "minimum": 1048576
        }
      },
      "additionalProperties": false
    },
    "requested": {
      "type": "object",
      "required": [
        "disk_layout_plan_digest",
        "install_bundle_digest"
      ],
      "properties": {
        "disk_layout_plan_digest": {
          "type": "string"
        },
        "disk_layout_plan_id": {
          "type": "string"
        },
        "install_bundle_digest": {
          "type": "string"
        },
        "change_set_digest": {
          "type": "string"
        },
        "recovery_image_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "destructive_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "wipe-partition-table",
          "destroy-pools",
          "reformat-filesystems",
          "erase-user-state",
          "reseed-system"
        ]
      }
    },
    "retention": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "wipe-all-state",
            "preserve-hardware-identity-only",
            "preserve-approved-anchors",
            "preserve-listed-datasets"
          ]
        },
        "allowed_dataset_prefixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": [
        "required_evidence"
      ],
      "properties": {
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "trusted-ui-confirmation",
              "physical-reset-marker",
              "station-presence-assertion",
              "breakglass-grant",
              "offline-quorum-approval",
              "maintenance-window"
            ]
          }
        },
        "breakglass_grant_digest": {
          "type": "string"
        },
        "approval_policy_digest": {
          "type": "string"
        },
        "min_distinct_approvers": {
          "type": "integer",
          "minimum": 1
        },
        "require_target_match": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
