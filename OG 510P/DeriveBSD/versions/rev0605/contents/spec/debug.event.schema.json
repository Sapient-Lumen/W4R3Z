{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD debug event (debug-event) (v0.1)",
  "allOf": [
    {"$ref": "event.record.schema.json"},
    {
      "type": "object",
      "required": [
        "kind",
        "event_version",
        "event_id",
        "at",
        "source",
        "event_type"
      ],
      "properties": {
        "kind": {"const": "debug-event"},
        "event_version": {"type": "string", "pattern": "^0\\.\\d+$"},
        "event_id": {"type": "string", "description": "Stable id (UUID recommended)."},

        "at": {"type": "string", "format": "date-time"},

        "source": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "description": "Debug broker component name (e.g., derive-debugd)."},
            "host_id": {"type": "string"},
            "domain": {"type": "string", "description": "Optional domain identifier if broker runs in a compartment."}
          },
          "additionalProperties": false
        },

        "event_type": {
          "type": "string",
          "enum": [
            "record-start",
            "record-stop",
            "capsule-emitted",
            "export-requested",
            "export-denied",
            "export-succeeded",
            "export-failed",
            "note"
          ]
        },

        "target": {
          "type": "object",
          "description": "What is being recorded (selectors are best-effort; policy may narrow).",
          "properties": {
            "service_id": {"type": "string"},
            "jail_id": {"type": "string"},
            "microvm_id": {"type": "string"},
            "pid": {"type": "integer", "minimum": 1},
            "workload_id": {"type": "string"}
          },
          "additionalProperties": false
        },

        "generation_digest": {"type": "string"},

        "grant_digest": {"type": "string", "description": "Digest of debug.record.grant (if applicable)."},
        "capsule_digest": {"type": "string", "description": "Digest of debug.replay.capsule (when emitted)."},

        "change_id": {"type": "string", "description": "Optional change id when capture is tied to a change-set execution."},
        "incident_id": {"type": "string"},

        "reason": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}},

        "meta": {"type": "object", "additionalProperties": true}
      }
    }
  ],
  "unevaluatedProperties": false
}
