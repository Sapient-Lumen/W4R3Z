{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD File Bookmark Revocation (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "revoke_version",
    "bookmark_id",
    "revoked_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "fs-bookmark-revoke"},
    "revoke_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "bookmark_id": {"type": "string"},
    "revoked_at": {"type": "string", "description": "ISO8601 time."},

    "reason": {"type": "string"},

    "context": {
      "type": "object",
      "properties": {
        "policy_decision_digest": {"type": "string"},
        "policy_snapshot_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
