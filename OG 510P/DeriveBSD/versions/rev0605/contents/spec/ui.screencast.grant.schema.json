{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI ScreenCast Grant (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "subject",
    "selection",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": { "const": "ui-screencast-grant" },
    "grant_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "lease_id": { "type": "string" },
    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string" },
        "digest": { "type": "string" },
        "instance": { "type": "string" }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["source_type"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["monitor", "window", "virtual"]
        },
        "ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Selected monitor/window identifiers (broker-defined)."
        },
        "virtual": {
          "type": "object",
          "properties": {
            "width": { "type": "integer" },
            "height": { "type": "integer" },
            "scale": { "type": "number" }
          },
          "additionalProperties": false
        },
        "include_audio": { "type": "boolean" },
        "include_cursor": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "requires_foreground": { "type": "boolean" },
        "indicator_required": { "type": "boolean" },
        "expires_at": { "type": "string" },
        "redaction_profile_digest": {
          "type": "string",
          "description": "Optional digest of redaction.transform artifact (watermarking/metadata rules)."
        }
      },
      "additionalProperties": true
    },
    "issued_at": { "type": "string", "description": "ISO8601 time." },
    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": { "type": "string" },
        "alg": { "type": "string" },
        "sig": { "type": "string", "description": "Signature over canonical JSON bytes." }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
