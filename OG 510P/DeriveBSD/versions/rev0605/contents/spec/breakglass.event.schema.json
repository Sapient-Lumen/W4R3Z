{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD breakglass event (breakglass-event) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "event_version",
    "event_id",
    "occurred_at",
    "host_id",
    "action"
  ],
  "properties": {
    "kind": {
      "const": "breakglass-event"
    },
    "event_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "event_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "host_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "entered",
        "exited",
        "extended",
        "denied"
      ]
    },
    "receipt_digest": {
      "type": "string",
      "description": "Digest/id of breakglass-receipt (if applicable)."
    },
    "grant_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string",
      "description": "Canonical cross-lane lease identifier for the referenced breakglass grant. When present, SHOULD equal grant_id."
    },
    "reason": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
