{
  "$defs": {
    "artifactKind": {
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$",
      "type": "string"
    },
    "identifier": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,180}$",
      "type": "string"
    },
    "schemaPath": {
      "pattern": "^spec/[a-z0-9_.-]+\\.schema\\.json$",
      "type": "string"
    },
    "sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generic runtime schema introduced in r528. The exact r508 canonical example is preserved in spec/removable.media.local.post_detach.export.bundle.fixture.schema.json; this schema keeps the closed-world export-bundle safety envelope while allowing dynamic ids, schema paths, recipients, timestamps, and digest values.",
  "properties": {
    "bundle_contents": {
      "additionalProperties": false,
      "properties": {
        "allowed_entries": {
          "enum": [
            [
              "redacted_query_projection",
              "authoritative_receipt_digests",
              "schema_digests",
              "validation_summary",
              "export_approval_receipt_digest"
            ]
          ]
        },
        "derived_output_bytes_included": {
          "enum": [
            false
          ]
        },
        "raw_authoritative_receipts_included": {
          "enum": [
            false
          ]
        },
        "raw_media_bytes_included": {
          "enum": [
            false
          ]
        },
        "raw_query_index_included": {
          "enum": [
            false
          ]
        },
        "schemas_included": {
          "enum": [
            "digests-or-canonical-refs-only"
          ]
        },
        "secret_material_included": {
          "enum": [
            false
          ]
        },
        "validation_summary_included": {
          "enum": [
            true
          ]
        }
      },
      "required": [
        "allowed_entries",
        "raw_authoritative_receipts_included",
        "raw_query_index_included",
        "raw_media_bytes_included",
        "derived_output_bytes_included",
        "secret_material_included",
        "validation_summary_included",
        "schemas_included"
      ],
      "type": "object"
    },
    "bundle_id": {
      "$ref": "#/$defs/identifier"
    },
    "contract_binding": {
      "additionalProperties": false,
      "properties": {
        "content_import_receipt_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "contract_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "contract_kind": {
          "enum": [
            "removable.media.local.post_detach.contract"
          ]
        },
        "export_bundle_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "export_bundle_posture": {
          "enum": [
            "typed-post-detach-export-bundle-positive-and-negative-fixture-guarded"
          ]
        },
        "lane_family": {
          "enum": [
            "removable-media-local-fallback"
          ]
        },
        "launch_evidence_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "launch_evidence_kind": {
          "enum": [
            "removable.media.local.post_detach.launch.evidence"
          ]
        },
        "query_projection_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "query_projection_floor": {
          "enum": [
            "export-starts-from-redacted-query-projection-not-raw-receipts"
          ]
        },
        "query_projection_kind": {
          "enum": [
            "removable.media.local.post_detach.query.projection"
          ]
        },
        "recovery_evidence_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "recovery_evidence_kind": {
          "enum": [
            "removable.media.local.post_detach.recovery.evidence"
          ]
        }
      },
      "required": [
        "lane_family",
        "contract_kind",
        "contract_digest",
        "launch_evidence_kind",
        "launch_evidence_digest",
        "recovery_evidence_kind",
        "recovery_evidence_digest",
        "query_projection_kind",
        "query_projection_digest",
        "content_import_receipt_digest",
        "export_bundle_posture",
        "export_bundle_digest",
        "query_projection_floor"
      ],
      "type": "object"
    },
    "denial_receipt": {
      "additionalProperties": false,
      "properties": {
        "denial_receipt_required": {
          "enum": [
            true
          ]
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "export_denial_after_tombstone": {
          "enum": [
            "deny-and-record-redacted-denial-receipt"
          ]
        },
        "kind": {
          "enum": [
            "removable.media.local.post_detach.denial.receipt"
          ]
        },
        "negative_fixture_policy": {
          "enum": [
            "known-bad-post-detach-denial-receipt-shapes-must-fail-validation"
          ]
        },
        "posture": {
          "enum": [
            "typed-post-detach-denial-receipt-positive-and-negative-fixture-guarded"
          ]
        },
        "query_denial_after_tombstone": {
          "enum": [
            "deny-and-record-redacted-denial-receipt"
          ]
