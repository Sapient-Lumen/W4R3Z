        }
      },
      "required": [
        "posture",
        "kind",
        "schema",
        "digest",
        "negative_fixture_policy",
        "denial_receipt_required",
        "query_denial_after_tombstone",
        "export_denial_after_tombstone",
        "rehydration_denial_after_tombstone"
      ],
      "type": "object"
    },
    "export_authority": {
      "additionalProperties": false,
      "properties": {
        "actor_scope": {
          "enum": [
            "caller-bound-single-export"
          ]
        },
        "approval_receipt_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "export_access_model": {
          "enum": [
            "explicit-human-approved-export-no-ambient-debug-dump"
          ]
