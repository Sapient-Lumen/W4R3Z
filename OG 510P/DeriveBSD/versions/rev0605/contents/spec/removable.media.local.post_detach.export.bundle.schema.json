        "raw_path_or_hint_present": {
          "enum": [
            "fail-closed"
          ]
        },
        "raw_receipt_payload_present": {
          "enum": [
            "fail-closed"
          ]
        },
        "recipient_unbound": {
          "enum": [
            "fail-closed"
          ]
        },
        "rehydration_after_tombstone": {
          "enum": [
            "fail-closed"
          ]
        },
        "revocation_tombstone_missing": {
          "enum": [
            "fail-closed"
          ]
        },
        "secret_material_present": {
          "enum": [
            "fail-closed"
          ]
        },
        "silent_denial_without_receipt": {
          "enum": [
            "fail-closed"
          ]
        },
        "stale_handle_after_tombstone": {
          "enum": [
            "fail-closed"
          ]
        },
        "unbounded_retention": {
          "enum": [
            "fail-closed"
          ]
        },
        "untrusted_filename_present": {
          "enum": [
            "fail-closed"
          ]
        }
      },
      "required": [
        "export_without_approval",
        "raw_path_or_hint_present",
        "raw_receipt_payload_present",
        "host_identity_present",
        "untrusted_filename_present",
        "body_text_present",
        "recipient_unbound",
        "unbounded_retention",
        "live_locator_present",
        "secret_material_present",
        "revocation_tombstone_missing",
        "stale_handle_after_tombstone",
        "rehydration_after_tombstone",
        "silent_denial_without_receipt"
      ],
      "type": "object"
    },
