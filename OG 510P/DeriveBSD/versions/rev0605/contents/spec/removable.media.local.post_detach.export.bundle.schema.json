            "recipient-digest-required"
          ]
        },
        "revocation_checked": {
          "enum": [
            true
          ]
        }
      },
      "required": [
        "export_access_model",
        "approval_receipt_digest",
        "actor_scope",
        "recipient_binding",
        "purpose_scope",
        "export_requires_approval",
        "revocation_checked"
