{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD time source policy diff (time.source.policy.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_policy",
    "to_policy",
    "sources_added",
    "sources_removed",
    "sources_changed"
  ],
  "properties": {
    "kind": { "const": "time.source.policy.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation/domain).",
      "properties": {
        "host_id": { "type": "string" },
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "domain": { "type": "string", "description": "Optional compartment/domain identifier." },
        "from_generation": { "type": "string" },
        "to_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "from_policy": { "$ref": "#/$defs/policy_ref" },
    "to_policy": { "$ref": "#/$defs/policy_ref" },

    "sources_added": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "sources_removed": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "sources_changed": {
      "type": "array",
      "items": { "$ref": "#/$defs/source_change" }
    },

    "quorum_change": { "$ref": "#/$defs/quorum_change" },
    "bootstrap_change": { "$ref": "#/$defs/bootstrap_change" },

    "summary": {
      "type": "object",
      "properties": {
        "added": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "policy_ref": {
      "type": "object",
      "description": "Reference to a time-source-policy object by digest (and optional human fields).",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "policy_id": { "type": "string" },
        "issued_at": { "type": "string", "format": "date-time" },
        "policy_version": { "type": "string" }
      },
      "additionalProperties": false
    },

    "source": {
      "type": "object",
      "required": ["id", "protocol", "endpoint"],
      "properties": {
        "id": { "type": "string" },
        "protocol": { "type": "string", "enum": ["nts", "roughtime"] },
        "endpoint": { "type": "string" },
        "trust_root_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "source_change": {
      "type": "object",
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string" },
        "from": { "$ref": "#/$defs/source" },
        "to": { "$ref": "#/$defs/source" },
        "classification": {
          "type": "string",
          "enum": ["endpoint", "trust_root", "protocol", "multiple", "other"]
        },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "quorum": {
      "type": "object",
      "required": ["min_sources", "max_skew_ms"],
      "properties": {
        "min_sources": { "type": "integer", "minimum": 1 },
        "max_skew_ms": { "type": "integer", "minimum": 0 },
        "require_vendor_diversity": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "quorum_change": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/quorum" },
        "to": { "$ref": "#/$defs/quorum" },
        "classification": {
          "type": "string",
          "enum": ["min_sources", "max_skew", "vendor_diversity", "multiple", "other"]
        },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "bootstrap": {
      "type": "object",
      "properties": {
        "allow_rtc": { "type": "boolean" },
        "max_rtc_age_sec": { "type": "integer", "minimum": 0 },
        "max_forward_jump_ms": { "type": "integer", "minimum": 0 },
        "max_backward_jump_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "bootstrap_change": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/bootstrap" },
        "to": { "$ref": "#/$defs/bootstrap" },
        "classification": {
          "type": "string",
          "enum": ["allow_rtc", "rtc_age", "forward_jump", "backward_jump", "multiple", "other"]
        },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
