{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Network Flow Summary (net.flow.summary) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "summary_version",
    "authority_semantics",
    "created_at",
    "session",
    "subject",
    "aggregates",
    "evidence",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "net-flow-summary"
    },
    "summary_version": {
      "type": "string",
      "const": "0.1"
    },
    "authority_semantics": {
      "type": "string",
      "const": "network-learning-evidence-only",
      "description": "Derived learning summary only; enforcement still comes from reviewed net-egress-policy."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "session": {
      "type": "object",
      "required": [
        "session_id",
        "tool",
        "mode",
        "started_at",
        "ended_at",
        "window"
      ],
      "properties": {
        "session_id": { "type": "string" },
        "tool": { "type": "string" },
        "mode": {
          "type": "string",
          "enum": ["observe", "audit", "learn"]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "window": {
          "type": "object",
          "required": ["max_duration_seconds", "max_events"],
          "properties": {
            "max_duration_seconds": { "type": "integer", "minimum": 1 },
            "max_events": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string" },
        "digest": { "type": "string" },
        "instance": { "type": "string" }
      },
      "additionalProperties": false
    },
    "policy_ref": {
      "type": "object",
      "required": ["kind", "digest"],
      "properties": {
        "kind": { "const": "net-egress-policy" },
        "digest": { "type": "string" },
        "ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "aggregates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["class", "destination", "transport", "observation", "policy_view"],
        "properties": {
          "class": { "type": "string" },
          "destination": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["hostname", "cidr", "service", "unknown"]
              },
              "hostname": { "type": "string" },
              "cidr": { "type": "string" },
              "service": { "type": "string" },
              "hostname_redacted": { "type": "boolean" },
              "resolution_scope": {
                "type": "string",
                "enum": ["brokered-dns", "direct-ip", "adapter-gap", "unknown"]
              }
            },
            "additionalProperties": false
          },
          "transport": {
            "type": "object",
            "required": ["proto", "ports"],
            "properties": {
              "proto": {
                "type": "string",
                "enum": ["tcp", "udp"]
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                }
              }
            },
            "additionalProperties": false
          },
          "observation": {
            "type": "object",
            "required": ["count", "first_seen", "last_seen"],
            "properties": {
              "count": { "type": "integer", "minimum": 1 },
              "first_seen": {
                "type": "string",
                "format": "date-time"
              },
              "last_seen": {
                "type": "string",
                "format": "date-time"
              },
              "bytes_sent": { "type": "integer", "minimum": 0 },
              "bytes_received": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "policy_view": {
            "type": "string",
            "enum": [
              "current-policy-covered",
              "audit-only-would-deny",
              "denied-under-current-policy",
              "adapter-gap"
            ]
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "required": ["flow_receipt_digests"],
      "properties": {
        "flow_receipt_digests": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "dns_query_receipt_digests": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "redaction_transform_digest": {
      "type": "string",
      "description": "Optional deterministic transform used when hostname/DNS detail is redacted in the summary."
    },
    "signature": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
