{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD attestation admission policy diff (attestation.admission.policy.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_policy",
    "to_policy",
    "rules_added",
    "rules_removed",
    "rules_changed"
  ],
  "properties": {
    "kind": { "const": "attestation.admission.policy.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation/domain).",
      "properties": {
        "host_id": { "type": "string" },
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "domain": { "type": "string", "description": "Optional compartment/domain identifier." },
        "from_generation": { "type": "string" },
        "to_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "from_policy": { "$ref": "#/$defs/policy_ref" },
    "to_policy": { "$ref": "#/$defs/policy_ref" },

    "rules_added": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "rules_removed": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "rules_changed": {
      "type": "array",
      "description": "Rules that stayed keyed by (action, selector) but changed their requirement reference.",
      "items": { "$ref": "#/$defs/rule_change" }
    },

    "summary": {
      "type": "object",
      "properties": {
        "rules_added": { "type": "integer", "minimum": 0 },
        "rules_removed": { "type": "integer", "minimum": 0 },
        "rules_changed": { "type": "integer", "minimum": 0 },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "policy_ref": {
      "type": "object",
      "description": "Reference to an attestation.admission.policy object by digest (and optional human fields).",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "policy_version": { "type": "string" },
        "policy_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "selector": {
      "type": "object",
      "description": "Subject selector for which hosts/nodes this rule applies to.",
      "properties": {
        "fleet": { "type": "string" },
        "host_class": { "type": "string" },
        "match_labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },

    "rule": {
      "type": "object",
      "required": ["action", "selector", "requirement_ref"],
      "properties": {
        "action": {
          "type": "string",
          "description": "Admission-gated action (issue-identity, unseal-secrets, join-fleet, promote-update, allow-remote-assist, ...).",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
        },
        "selector": { "$ref": "#/$defs/selector" },
        "requirement_ref": {
          "type": "string",
          "description": "Digest/id of an attestation.requirement object."
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "rule_change": {
      "type": "object",
      "required": ["action", "selector", "from_requirement_ref", "to_requirement_ref"],
      "properties": {
        "action": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
        },
        "selector": { "$ref": "#/$defs/selector" },
        "from_requirement_ref": { "type": "string" },
        "to_requirement_ref": { "type": "string" },
        "notes": { "type": "string" },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
