{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD resource governance event (resource-event) (v0.1)",
  "allOf": [
    {
      "$ref": "event.record.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "event_version",
        "event_id",
        "at",
        "source",
        "class",
        "severity",
        "payload",
        "signature"
      ],
      "properties": {
        "kind": {
          "const": "resource-event"
        },
        "event_version": {
          "type": "string",
          "pattern": "^0\\.\\d+$"
        },
        "event_id": {
          "type": "string",
          "description": "Stable id (UUID recommended) for correlation."
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "object",
          "required": [
            "host_id",
            "component"
          ],
          "properties": {
            "host_id": {
              "type": "string"
            },
            "component": {
              "type": "string",
              "description": "Emitter (kernel, resource-daemon, supervisor, etc.)."
            },
            "subject": {
              "type": "string",
              "description": "Optional subject id (service/workload/vm)."
            }
          },
          "additionalProperties": true
        },
        "class": {
          "type": "string",
          "description": "Event class (resource.violation.*, resource.pressure.*, resource.action.*, resource.policy.applied)."
        },
        "severity": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "notice",
            "warning",
            "error",
            "critical"
          ]
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "correlation": {
          "type": "object",
          "additionalProperties": true
        },
        "signature": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  ]
}
