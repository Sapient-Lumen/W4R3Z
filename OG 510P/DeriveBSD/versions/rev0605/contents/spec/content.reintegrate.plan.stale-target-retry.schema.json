{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD content reintegration stale-target retry plan profile (content.reintegrate.plan.stale-target-retry) (v0.1)",
  "allOf": [
    {
      "$ref": "content.reintegrate.plan.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "content.reintegrate.plan"
        },
        "recovery": {
          "type": "object",
          "properties": {
            "mode": {
              "const": "from-stale-supersession-denial"
            }
          },
          "required": [
            "mode",
            "stale_denial_receipt_digest",
            "expected_current_receipt_digest",
            "expected_current_candidate_digest",
            "expected_current_authoritative_origin_digest"
          ]
        },
        "supersession": {
          "type": "object",
          "properties": {
            "mode": {
              "const": "supersede-prior-candidate"
            }
          },
          "required": [
            "mode",
            "supersedes_receipt_digest",
            "superseded_candidate_digest",
            "superseded_authoritative_origin_digest"
          ]
        }
      },
      "required": [
        "recovery",
        "supersession"
      ]
    }
  ]
}
