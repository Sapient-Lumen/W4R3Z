{
  "$defs": {
    "adapter": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "enum": [
            "cd9660",
            "exfat",
            "msdosfs",
            "ufs"
          ]
        },
        "helper_command_candidates": {
          "items": {
            "pattern": "^/",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "helper_digest_pinned_before_use": {
          "const": true
        },
        "helper_must_be_preinstalled": {
          "const": true
        },
        "kernel_module_load_in_lane": {
          "minLength": 10,
          "type": "string"
        },
        "package_install_or_network_fetch_in_lane": {
          "const": false
        },
        "production_status": {
          "minLength": 10,
          "type": "string"
        },
        "strategy": {
          "enum": [
            "base-system-mount-helper",
            "external-fuse-helper-gated"
          ]
        }
      },
      "required": [
        "family",
        "strategy",
        "helper_command_candidates",
        "helper_must_be_preinstalled",
        "helper_digest_pinned_before_use",
        "package_install_or_network_fetch_in_lane",
        "kernel_module_load_in_lane",
        "production_status"
      ],
      "type": "object"
    },
    "finding": {
      "additionalProperties": false,
      "properties": {
        "correction": {
          "minLength": 20,
          "type": "string"
        },
        "finding_id": {
          "pattern": "^[a-z0-9-]+$",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "finding_id",
        "severity",
        "correction"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit_findings": {
      "items": {
        "$ref": "#/$defs/finding"
      },
      "minItems": 2,
      "type": "array"
    },
    "capture_sequence": {
      "additionalProperties": false,
      "properties": {
        "detach": {
          "additionalProperties": false,
          "properties": {
            "device_node_closed_before_worker": {
              "const": true
            },
            "mountpoint_not_visible_to_worker": {
              "const": true
            },
            "umount_command_template": {
              "items": false,
              "prefixItems": [
                {
                  "const": "/sbin/umount"
                },
                {
                  "pattern": "^/var/run/derivebsd/removable-media/local-fallback/.+/mnt$",
                  "type": "string"
                }
              ],
              "type": "array"
            },
            "umount_must_complete_before_worker": {
              "const": true
            }
          },
          "required": [
            "umount_command_template",
            "umount_must_complete_before_worker",
            "device_node_closed_before_worker",
            "mountpoint_not_visible_to_worker"
          ],
          "type": "object"
        },
        "phase_order": {
          "items": false,
          "prefixItems": [
            {
              "const": "probe-fstyp"
            },
            {
              "const": "mount-readonly-private"
            },
            {
              "const": "open-selected-member-no-follow"
            },
            {
              "const": "lstat-fstat-same-object-check"
            },
            {
              "const": "copy-to-work-and-hash"
            },
            {
              "const": "commit-preserved-capture-to-cas"
            },
            {
              "const": "umount-before-worker"
            },
            {
              "const": "launch-post-detach-worker"
            }
          ],
          "type": "array"
        },
        "preserved_capture": {
          "additionalProperties": false,
          "properties": {
            "authoritative_before_detach": {
              "const": true
            },
            "digest_algorithm": {
              "const": "sha256"
            },
            "locator_template": {
              "const": "quarantine-cas/sha256/<hex>"
            },
            "verify_after_copy": {
              "const": true
            }
          },
          "required": [
            "locator_template",
            "digest_algorithm",
            "verify_after_copy",
            "authoritative_before_detach"
          ],
          "type": "object"
        },
        "selected_member_open": {
          "additionalProperties": false,
          "properties": {
            "ancestor_symlink_policy": {
              "const": "reject-every-component-before-open"
            },
            "api_floor": {
              "const": "dirfd-openat-root-pinned-walk-or-equivalent"
            },
            "leaf_kind": {
              "const": "regular-file-only"
            },
            "lstat_fstat_same_object_required": {
              "const": true
            },
            "open_flags": {
              "items": {
                "enum": [
                  "O_RDONLY",
                  "O_NOFOLLOW"
                ]
              },
              "minItems": 2,
              "type": "array",
              "uniqueItems": true
            },
            "shares_cloudtainer_capture_helper": {
              "const": "tools/removable_media_safe_capture.py"
            }
          },
          "required": [
            "api_floor",
            "open_flags",
            "ancestor_symlink_policy",
            "leaf_kind",
            "lstat_fstat_same_object_required",
            "shares_cloudtainer_capture_helper"
          ],
          "type": "object"
        }
      },
      "required": [
        "phase_order",
        "selected_member_open",
        "preserved_capture",
        "detach"
      ],
      "type": "object"
    },
    "execution_mode": {
      "const": "dry-run-host-plan-cloudtainer-validated"
    },
    "generated_for_version": {
      "const": "2026-06-04r536"
    },
    "host_requirements": {
      "additionalProperties": false,
      "properties": {
        "cloudtainer_os_observed": {
          "minLength": 1,
          "type": "string"
        },
        "network_required": {
          "const": false
        },
        "non_freebsd_apply_mode": {
          "const": "refuse"
        },
        "package_install_in_lane": {
          "const": false
        },
        "required_os": {
          "const": "FreeBSD"
        },
        "requires_root_for_real_mount": {
          "const": true
        }
      },
      "required": [
        "required_os",
        "cloudtainer_os_observed",
        "non_freebsd_apply_mode",
        "requires_root_for_real_mount",
        "network_required",
        "package_install_in_lane"
      ],
      "type": "object"
    },
    "inputs": {
      "additionalProperties": false,
      "properties": {
        "cas_root": {
          "pattern": "^/var/run/derivebsd/removable-media/local-fallback/.+/quarantine-cas$",
          "type": "string"
        },
        "claimed_fstyp": {
          "enum": [
            "cd9660",
            "exfat",
            "msdosfs",
            "ufs"
          ]
        },
        "derivative_root": {
          "pattern": "^/var/run/derivebsd/removable-media/local-fallback/.+/derivative$",
          "type": "string"
        },
        "device_node": {
          "pattern": "^/dev/[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        "mountpoint": {
          "pattern": "^/var/run/derivebsd/removable-media/local-fallback/.+/mnt$",
          "type": "string"
        },
        "selected_member": {
          "minLength": 1,
          "type": "string"
        },
        "selected_member_normalized": {
          "pattern": "^[^/][^\\u0000]*$",
          "type": "string"
        },
        "session_root": {
          "pattern": "^/var/run/derivebsd/removable-media/local-fallback/[^.][A-Za-z0-9._-]+$",
          "type": "string"
        },
        "work_root": {
          "pattern": "^/var/run/derivebsd/removable-media/local-fallback/.+/work$",
          "type": "string"
        }
      },
      "required": [
        "device_node",
        "selected_member",
        "selected_member_normalized",
        "claimed_fstyp",
        "session_root",
        "mountpoint",
        "work_root",
        "cas_root",
        "derivative_root"
      ],
      "type": "object"
    },
    "kind": {
      "const": "removable.media.local.freebsd.backend.plan"
    },
    "mount_admission": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "$ref": "#/$defs/adapter"
        },
        "contract_desired_inertness_flags": {
          "contains": {
            "const": "untrusted"
          },
          "items": {
            "enum": [
              "ro",
              "nosuid",
              "noexec",
              "nosymfollow",
              "untrusted"
            ]
          },
          "maxItems": 5,
          "minItems": 5,
          "not": {
            "contains": {
              "const": "nodev"
            }
          },
          "type": "array",
          "uniqueItems": true
        },
        "exfat_adapter_command_template": {
          "items": {
            "type": "string"
          },
          "minItems": 5,
          "type": "array"
        },
        "freebsd_generic_mount_options_to_emit": {
          "contains": {
            "const": "untrusted"
          },
          "items": {
            "enum": [
              "ro",
              "nosuid",
              "noexec",
              "nosymfollow",
              "untrusted"
            ]
          },
          "maxItems": 5,
          "minItems": 5,
          "not": {
            "contains": {
              "const": "nodev"
            }
          },
          "type": "array",
          "uniqueItems": true
        },
        "native_mount_command_template": {
          "items": {
            "type": "string"
          },
          "minItems": 7,
          "type": "array"
        },
        "nodev_reality_check": {
          "pattern": "do-not-emit-nodev",
          "type": "string"
        },
        "not_claimed_as_freebsd_generic_mount_options": {
          "items": {
            "const": "nodev"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "post_mount_verification": {
          "additionalProperties": false,
          "properties": {
            "command_template": {
              "items": false,
              "prefixItems": [
                {
                  "const": "/sbin/mount"
                },
                {
                  "const": "-p"
                }
              ],
              "type": "array"
            },
            "missing_required_semantic": {
              "const": "fail-closed-before-capture"
            },
            "must_observe_noexec_nosuid_nosymfollow_where_supported": {
              "const": true
            },
            "must_observe_read_only": {
              "const": true
            }
          },
          "required": [
            "command_template",
            "must_observe_read_only",
            "must_observe_noexec_nosuid_nosymfollow_where_supported",
            "missing_required_semantic"
          ],
          "type": "object"
        }
      },
      "required": [
        "contract_desired_inertness_flags",
        "freebsd_generic_mount_options_to_emit",
        "not_claimed_as_freebsd_generic_mount_options",
        "nodev_reality_check",
        "native_mount_command_template",
        "exfat_adapter_command_template",
        "adapter",
        "post_mount_verification"
      ],
      "type": "object"
    },
    "plan_id": {
      "pattern": "^rm-local-freebsd-backend-plan-[0-9]{8}-r[0-9]{3,}$",
      "type": "string"
    },
    "post_detach_worker": {
      "additionalProperties": false,
      "properties": {
        "argv_includes_device_node": {
          "const": false
        },
        "argv_includes_mountpoint": {
          "const": false
        },
        "capability_floor": {
          "const": "cap_enter-before-tool-mainline-when-running-on-FreeBSD"
        },
        "cwd": {
          "const": "launcher-owned-empty-scratch-not-mount-not-cas"
        },
        "devfs_visible_devices": {
          "maxItems": 0,
          "type": "array"
        },
        "env_includes_device_node": {
          "const": false
        },
        "env_includes_mountpoint": {
          "const": false
        },
        "input_delivery": {
          "const": "read-only-fd-to-preserved-capture-or-single-object-projection"
        },
        "launch_mode": {
          "const": "preopened-fds-only"
        },
        "network_default": {
          "const": "deny-all"
        },
        "output_delivery": {
          "const": "append-only-fd-to-one-empty-derivative-slot"
        }
      },
      "required": [
        "launch_mode",
        "input_delivery",
        "output_delivery",
        "argv_includes_device_node",
        "argv_includes_mountpoint",
        "env_includes_device_node",
        "env_includes_mountpoint",
        "cwd",
        "devfs_visible_devices",
        "network_default",
        "capability_floor"
      ],
      "type": "object"
    },
    "preflight": {
      "additionalProperties": false,
      "properties": {
        "allowed_fstyp_results": {
          "items": {
            "enum": [
              "cd9660",
              "exfat",
              "msdosfs",
              "ufs"
            ]
          },
          "minItems": 4,
          "type": "array",
          "uniqueItems": true
        },
        "denied_fstyp_results": {
          "contains": {
            "const": "unknown"
          },
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "device_node_policy": {
          "const": "must-be-existing-device-node-under-dev-not-directory-not-symlink"
        },
        "fstyp_command": {
          "items": false,
          "prefixItems": [
            {
              "const": "/usr/sbin/fstyp"
            },
            {
              "pattern": "^/dev/",
              "type": "string"
            }
          ],
          "type": "array"
        },
        "fstyp_result_binding": {
          "const": "observed-result-must-equal-claimed-family-before-mount"
        },
        "mountpoint_policy": {
          "const": "launcher-created-empty-private-0700-directory"
        },
        "path_policy": {
          "const": "shared-dirfd-openat-no-symlink-regular-file-before-capture"
        }
      },
      "required": [
        "device_node_policy",
        "path_policy",
        "fstyp_command",
        "allowed_fstyp_results",
        "denied_fstyp_results",
        "fstyp_result_binding",
        "mountpoint_policy"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "apply_mode_status": {
          "const": "not-run-in-cloudtainer"
        },
        "next_host_test": {
          "minLength": 20,
          "type": "string"
        },
        "status": {
          "const": "planned"
        }
      },
      "required": [
        "status",
        "apply_mode_status",
        "next_host_test"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "0.1"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "plan_id",
    "generated_for_version",
    "execution_mode",
    "host_requirements",
    "inputs",
    "preflight",
    "mount_admission",
    "capture_sequence",
    "post_detach_worker",
    "audit_findings",
    "result"
  ],
  "title": "Removable media local fallback FreeBSD backend plan",
  "type": "object"
}
