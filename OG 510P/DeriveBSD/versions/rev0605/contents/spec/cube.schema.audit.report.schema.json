{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cube schema audit report",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "report_id",
    "generated_for_version",
    "scope",
    "audit_policy",
    "counts",
    "posture_buckets",
    "findings",
    "refactor_policy",
    "negative_fixture_policy"
  ],
  "properties": {
    "kind": { "const": "cube.schema.audit.report" },
    "schema_version": { "const": "1.0" },
    "report_id": { "$ref": "#/$defs/identifier" },
    "generated_for_version": { "const": "2026-06-18r630" },
    "scope": {
      "type": "object",
      "required": ["schema_glob", "example_glob", "invalid_examples_included", "audit_generated_at"],
      "properties": {
        "schema_glob": { "const": "spec/*.schema.json" },
        "example_glob": { "const": "spec/examples/*.json" },
        "invalid_examples_included": { "const": false },
        "audit_generated_at": { "const": "release-build-time-deterministic" }
      },
      "additionalProperties": false
    },
    "audit_policy": {
      "type": "object",
      "required": ["const_heavy_threshold", "runtime_contract_rule", "schema_without_example_policy"],
      "properties": {
        "const_heavy_threshold": { "type": "integer", "minimum": 1 },
        "runtime_contract_rule": { "const": "has-$defs-and-patterns-and-not-const-heavy" },
        "schema_without_example_policy": { "const": "allowed-for-base-helper-schemas-but-reported" }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "schemas_total",
        "examples_total",
        "root_kind_schema_count",
        "schemas_with_canonical_example_count",
        "schemas_without_canonical_example_count",
        "const_heavy_schema_count",
        "runtime_contract_shaped_schema_count",
        "exact_fixture_schema_count",
        "dotted_kind_filename_mismatch_count"
      ],
      "properties": {
        "schemas_total": { "type": "integer", "minimum": 1 },
        "examples_total": { "type": "integer", "minimum": 1 },
        "root_kind_schema_count": { "type": "integer", "minimum": 1 },
        "schemas_with_canonical_example_count": { "type": "integer", "minimum": 0 },
        "schemas_without_canonical_example_count": { "type": "integer", "minimum": 0 },
        "const_heavy_schema_count": { "type": "integer", "minimum": 0 },
        "runtime_contract_shaped_schema_count": { "type": "integer", "minimum": 0 },
        "exact_fixture_schema_count": { "type": "integer", "minimum": 0 },
        "dotted_kind_filename_mismatch_count": { "const": 0 }
      },
      "additionalProperties": false
    },
    "posture_buckets": {
      "type": "object",
      "required": [
        "runtime_contract_shaped_schemas",
        "exact_fixture_schemas",
        "const_heavy_schema_sample",
        "schemas_without_canonical_example"
      ],
      "properties": {
        "runtime_contract_shaped_schemas": { "$ref": "#/$defs/schemaList" },
        "exact_fixture_schemas": { "$ref": "#/$defs/schemaList" },
        "const_heavy_schema_sample": { "$ref": "#/$defs/schemaStatList" },
        "schemas_without_canonical_example": { "$ref": "#/$defs/schemaList" }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "summary", "action"],
        "properties": {
          "finding_id": { "$ref": "#/$defs/identifier" },
          "severity": { "enum": ["info", "medium", "high"] },
          "summary": { "type": "string", "minLength": 10 },
          "action": { "type": "string", "minLength": 10 }
        },
        "additionalProperties": false
      }
    },
    "refactor_policy": {
      "type": "object",
      "required": ["canonical_digest_helper", "checker_refactor_target", "next_schema_split_targets"],
      "properties": {
        "canonical_digest_helper": { "const": "tools/cube_digest_lib.py" },
        "checker_refactor_target": { "const": "post-detach-and-cube-audit-checkers-use-shared-canonical-digest-rule" },
        "next_schema_split_targets": { "$ref": "#/$defs/schemaList" }
      },
      "additionalProperties": false
    },
    "negative_fixture_policy": { "const": "schema-audit-report-must-match-live-cube-scan" }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "minLength": 3,
      "maxLength": 180
    },
    "schemaList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^spec/[a-z0-9_.-]+\\.schema\\.json$"
      },
      "uniqueItems": true
    },
    "schemaStatList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema", "const_count"],
        "properties": {
          "schema": { "type": "string", "pattern": "^spec/[a-z0-9_.-]+\\.schema\\.json$" },
          "const_count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  }
}
