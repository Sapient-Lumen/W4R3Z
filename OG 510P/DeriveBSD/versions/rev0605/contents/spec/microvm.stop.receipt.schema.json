{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD microVM stop receipt (microvm.stop.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "host",
    "plan_id",
    "plan_digest",
    "policy_digest",
    "instance",
    "outcome"
  ],
  "properties": {
    "kind": {
      "const": "microvm.stop.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string",
      "description": "Stable id for this receipt (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "required": [
        "host_id",
        "generation_digest"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "generation_digest": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "plan_id": {
      "type": "string",
      "description": "Id of the plan submission executed (not the content identity)."
    },
    "plan_digest": {
      "type": "string",
      "description": "Digest of the executed microvm.stop.plan (sha256 of UTF-8 bytes of JCS-canonicalized plan JSON; `sha256:<hex>`)."
    },
    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) used during authorization/enforcement."
    },
    "instance": {
      "type": "object",
      "required": [
        "instance_id"
      ],
      "properties": {
        "instance_id": {
          "type": "string"
        },
        "backend": {
          "type": "string",
          "description": "Backend selected (bhyve, firecracker, qemu, ...)."
        },
        "backend_instance_id": {
          "type": "string",
          "description": "Optional backend id (vm name, vmm id, socket path, ...)."
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "stopped",
        "already-stopped",
        "denied",
        "failed",
        "timeout"
      ]
    },
    "observed": {
      "type": "object",
      "description": "Optional observed state for forensics (what was running when the stop was evaluated).",
      "properties": {
        "running_at_start": {
          "type": "boolean"
        },
        "running_plan_digest": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "graceful",
            "force"
          ]
        }
      },
      "additionalProperties": false
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "related": {
      "type": "array",
      "description": "Optional pointers to receipts/evidence produced or consulted during stop.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "digest"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "description": "Optional signature over this receipt envelope.",
      "properties": {
        "sig_alg": {
          "type": "string"
        },
        "public_key_hint": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "timeout",
              "denied",
              "failed"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "reasons"
        ],
        "properties": {
          "reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
