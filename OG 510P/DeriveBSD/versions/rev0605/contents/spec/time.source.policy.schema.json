{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Time Source Policy (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "sources",
    "quorum",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "time-source-policy"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "protocol",
          "endpoint"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "nts",
              "roughtime"
            ]
          },
          "endpoint": {
            "type": "string",
            "description": "Protocol-specific endpoint (e.g., host:port or URL)."
          },
          "trust_root_digest": {
            "type": "string",
            "description": "Optional digest of the trust root / pubkey bundle used to authenticate this source."
          }
        },
        "additionalProperties": false
      }
    },
    "quorum": {
      "type": "object",
      "required": [
        "min_sources",
        "max_skew_ms"
      ],
      "properties": {
        "min_sources": {
          "type": "integer",
          "minimum": 1
        },
        "max_skew_ms": {
          "type": "integer",
          "minimum": 0
        },
        "require_vendor_diversity": {
          "type": "boolean",
          "description": "If true, verifier expects sources to come from distinct operator classes."
        }
      },
      "additionalProperties": false
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "allow_rtc": {
          "type": "boolean"
        },
        "max_rtc_age_sec": {
          "type": "integer",
          "minimum": 0
        },
        "max_forward_jump_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_backward_jump_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object",
      "description": "Signature over the canonicalized policy object."
    }
  },
  "additionalProperties": false
}
