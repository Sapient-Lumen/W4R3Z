{
  "$defs": {
    "receiptId": {
      "pattern": "^rm-postdetach-export-deletion-[a-z0-9-]+$",
      "type": "string"
    },
    "schemaPath": {
      "pattern": "^spec/[a-z0-9_.-]+\\.schema\\.json$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "version": {
      "pattern": "^2026-05-30r529$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Receipt proving a post-detach export bundle access has reached its bounded deletion/revocation terminal state without claiming erasure of unmanaged offline copies.",
  "properties": {
    "deletion_actions": {
      "additionalProperties": false,
      "properties": {
        "live_locator": {
          "enum": [
            "absent-or-terminal-after-deletion"
          ]
        },
        "local_managed_copy": {
          "enum": [
            "deleted-or-quarantined-and-terminal"
          ]
        },
        "offline_copy_claim": {
          "enum": [
            "not-claimed-erased-only-future-authority-denied"
          ]
        },
        "raw_locator_visible": {
          "enum": [
            false
          ]
        },
        "recipient_material": {
          "enum": [
            "not-revoked-by-claim-only-recipient-bound-copy-out-of-scope"
          ]
        },
        "remote_object": {
          "enum": [
            "revoked-or-deleted-if-present-and-receipted"
          ]
        }
      },
      "required": [
        "local_managed_copy",
        "remote_object",
        "live_locator",
        "recipient_material",
        "raw_locator_visible",
        "offline_copy_claim"
      ],
      "type": "object"
    },
    "deletion_ledger": {
      "additionalProperties": false,
      "properties": {
        "broker_epoch_id": {
          "pattern": "^rm-postdetach-broker-epoch-[a-z0-9-]+$",
          "type": "string"
        },
        "compare_and_swap_result": {
          "enum": [
            "committed"
          ]
        },
        "delete_sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "expected_root_digest": {
          "$ref": "#/$defs/sha256"
        },
        "forked_root_accepted": {
          "enum": [
            false
          ]
        },
        "idempotency_key_digest": {
          "$ref": "#/$defs/sha256"
        },
        "ledger_anchor_digest": {
          "$ref": "#/$defs/sha256"
        },
        "new_root_digest": {
          "$ref": "#/$defs/sha256"
        },
        "prior_root_digest": {
          "$ref": "#/$defs/sha256"
        },
        "replay_outcome": {
          "enum": [
            "first-export-bundle-deletion",
            "idempotent-deletion-replay-no-new-effects"
          ]
        },
        "rollback_accepted": {
          "enum": [
            false
          ]
        },
        "stale_root_accepted": {
          "enum": [
            false
          ]
        }
      },
      "required": [
        "broker_epoch_id",
        "delete_sequence",
        "prior_root_digest",
        "expected_root_digest",
        "new_root_digest",
        "ledger_anchor_digest",
        "compare_and_swap_result",
        "idempotency_key_digest",
        "replay_outcome",
        "rollback_accepted",
        "forked_root_accepted",
        "stale_root_accepted"
      ],
      "type": "object"
    },
    "deletion_receipt_id": {
      "$ref": "#/$defs/receiptId"
    },
    "deletion_trigger": {
      "additionalProperties": false,
      "properties": {
        "clock_source_digest": {
          "$ref": "#/$defs/sha256"
        },
        "deletion_observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "early_revocation_allowed": {
          "enum": [
            true
          ]
        },
        "retention_expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "trigger_kind": {
          "enum": [
            "retention-expired",
            "explicit-revocation",
            "incident-response"
          ]
        },
        "triggered_by": {
          "enum": [
            "bounded-explicit-expiry-or-explicit-revocation"
          ]
        }
      },
      "required": [
        "trigger_kind",
        "triggered_by",
        "retention_expires_at",
        "deletion_observed_at",
        "clock_source_digest",
        "early_revocation_allowed"
      ],
      "type": "object"
    },
    "export_access_binding": {
      "additionalProperties": false,
      "properties": {
        "access_was_visible_before_deletion": {
          "enum": [
            true
          ]
        },
        "export_access_receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "export_access_receipt_id": {
          "pattern": "^rm-postdetach-export-access-[a-z0-9-]+$",
          "type": "string"
        },
        "export_sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "new_export_requires_new_approval": {
          "enum": [
            true
          ]
        },
        "recipient_digest": {
          "$ref": "#/$defs/sha256"
        },
        "request_id": {
          "pattern": "^rm-postdetach-export-request-[a-z0-9-]+$",
          "type": "string"
        }
      },
      "required": [
        "export_access_receipt_id",
        "export_access_receipt_digest",
        "export_sequence",
        "recipient_digest",
        "request_id",
        "access_was_visible_before_deletion",
        "new_export_requires_new_approval"
      ],
      "type": "object"
    },
    "generated_for_version": {
      "$ref": "#/$defs/version"
    },
    "invariants": {
      "additionalProperties": false,
      "properties": {
        "deletion_is_terminal_for_managed_export": {
          "enum": [
            true
          ]
        },
        "deletion_ledger_advances_once": {
          "enum": [
            true
          ]
        },
        "new_export_requires_new_approval": {
          "enum": [
            true
          ]
        },
        "offline_erasure_not_overclaimed": {
          "enum": [
            true
          ]
        },
        "raw_values_absent_from_deletion_receipt": {
          "enum": [
            true
          ]
        },
        "support_visibility_digest_only": {
          "enum": [
            true
          ]
        }
      },
      "required": [
        "deletion_ledger_advances_once",
        "deletion_is_terminal_for_managed_export",
        "offline_erasure_not_overclaimed",
        "raw_values_absent_from_deletion_receipt",
        "new_export_requires_new_approval",
        "support_visibility_digest_only"
      ],
      "type": "object"
    },
    "joins": {
      "additionalProperties": false,
      "properties": {
        "export_access_digest_matches_source_binding": {
          "enum": [
            true
          ]
        },
        "export_access_required_deletion_receipt": {
          "enum": [
            true
          ]
        },
        "recipient_digest_matches_export_access": {
          "enum": [
            true
          ]
        },
        "revocation_tombstone_fixture_schema": {
          "enum": [
            "spec/removable.media.local.post_detach.revocation.tombstone.fixture.schema.json"
          ]
        },
        "revocation_tombstone_schema": {
          "enum": [
            "spec/removable.media.local.post_detach.revocation.tombstone.schema.json"
          ]
        },
        "support_projection_is_allowlisted": {
          "enum": [
            true
          ]
        },
        "tombstone_digest_checked_before_deletion": {
          "enum": [
            true
          ]
        }
      },
      "required": [
        "export_access_required_deletion_receipt",
        "export_access_digest_matches_source_binding",
        "recipient_digest_matches_export_access",
        "tombstone_digest_checked_before_deletion",
        "support_projection_is_allowlisted",
        "revocation_tombstone_schema",
        "revocation_tombstone_fixture_schema"
      ],
      "type": "object"
    },
    "kind": {
      "enum": [
        "removable.media.local.post_detach.export.bundle.deletion.receipt"
      ]
    },
    "lane": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "enum": [
            "removable-media-local-fallback"
          ]
        },
        "identity_policy": {
          "enum": [
            "family-normalized-phase-by-kind"
          ]
        },
        "phase": {
          "enum": [
            "post-detach"
          ]
        }
      },
      "required": [
        "family",
        "phase",
        "identity_policy"
      ],
      "type": "object"
    },
    "negative_fixture_policy": {
      "enum": [
        "known-bad-post-detach-export-bundle-deletion-shapes-must-fail-validation"
      ]
    },
    "retention_proof": {
      "additionalProperties": false,
      "properties": {
        "deletion_after_expiry_or_revocation": {
          "enum": [
            true
          ]
        },
        "deletion_receipt_visible": {
          "enum": [
            true
          ]
        },
        "retention_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "retention_was_bounded": {
          "enum": [
            true
          ]
        },
        "unbounded_retention_allowed": {
          "enum": [
            false
          ]
        }
      },
      "required": [
        "retention_was_bounded",
        "unbounded_retention_allowed",
        "deletion_after_expiry_or_revocation",
        "deletion_receipt_visible",
        "retention_policy_digest"
      ],
      "type": "object"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "source_bindings": {
      "additionalProperties": false,
      "properties": {
        "canonical_digest_rule": {
          "enum": [
            "json-sort-keys-compact-utf8-sha256"
          ]
        },
        "export_bundle_access_receipt_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "export_bundle_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "revocation_tombstone_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "support_projection_computed_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "canonical_digest_rule",
        "export_bundle_access_receipt_computed_digest",
        "export_bundle_computed_digest",
        "revocation_tombstone_computed_digest",
        "support_projection_computed_digest"
      ],
      "type": "object"
    },
    "support_projection": {
      "additionalProperties": false,
      "properties": {
        "body_or_full_text_visible": {
          "enum": [
            false
          ]
        },
        "device_identifier_visible": {
          "enum": [
            false
          ]
        },
        "filename_visible": {
          "enum": [
            false
          ]
        },
        "host_identity_visible": {
          "enum": [
            false
          ]
        },
        "raw_path_visible": {
          "enum": [
            false
          ]
        },
        "raw_payload_visible": {
          "enum": [
            false
          ]
        },
        "secret_material_visible": {
          "enum": [
            false
          ]
        },
        "visibility": {
          "enum": [
            "support-safe-digest-only"
          ]
        }
      },
      "required": [
        "visibility",
        "raw_payload_visible",
        "raw_path_visible",
        "filename_visible",
        "device_identifier_visible",
        "host_identity_visible",
        "body_or_full_text_visible",
        "secret_material_visible"
      ],
      "type": "object"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "deletion_receipt_id",
    "generated_for_version",
    "lane",
    "source_bindings",
    "deletion_trigger",
    "export_access_binding",
    "deletion_actions",
    "retention_proof",
    "support_projection",
    "deletion_ledger",
    "joins",
    "invariants",
    "negative_fixture_policy"
  ],
  "title": "DeriveBSD Removable-Media Local Post-Detach Export-Bundle Deletion Receipt",
  "type": "object"
}
