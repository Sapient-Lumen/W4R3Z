{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cube schema refactor backlog",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "backlog_id",
    "generated_for_version",
    "source_audit_binding",
    "selection_policy",
    "counts",
    "items",
    "invariants",
    "refactor_policy"
  ],
  "properties": {
    "kind": {
      "const": "cube.schema.refactor.backlog"
    },
    "schema_version": {
      "const": "1.0"
    },
    "backlog_id": {
      "type": "string",
      "pattern": "^cube-schema-refactor-backlog-[0-9]{8}-r[0-9]{3}$"
    },
    "generated_for_version": {
      "const": "2026-06-18r630"
    },
    "source_audit_binding": {
      "$ref": "#/$defs/sourceAuditBinding"
    },
    "selection_policy": {
      "$ref": "#/$defs/selectionPolicy"
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "invariants": {
      "$ref": "#/$defs/invariants"
    },
    "refactor_policy": {
      "$ref": "#/$defs/refactorPolicy"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schemaPath": {
      "type": "string",
      "pattern": "^spec/[a-z0-9_.-]+\\.schema\\.json$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "minLength": 3,
      "maxLength": 180
    },
    "sourceAuditBinding": {
      "type": "object",
      "required": [
        "audit_report_kind",
        "audit_report_schema",
        "audit_report_example",
        "audit_report_computed_digest",
        "const_heavy_threshold"
      ],
      "properties": {
        "audit_report_kind": {
          "const": "cube.schema.audit.report"
        },
        "audit_report_schema": {
          "const": "spec/cube.schema.audit.report.schema.json"
        },
        "audit_report_example": {
          "const": "spec/examples/cube.schema.audit.report.json"
        },
        "audit_report_computed_digest": {
          "$ref": "#/$defs/digest"
        },
        "const_heavy_threshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "selectionPolicy": {
      "type": "object",
      "required": [
        "selected_surface",
        "priority_order",
        "fixture_split_pattern",
        "non_blocking_legacy_history"
      ],
      "properties": {
        "selected_surface": {
          "const": "all-live-const-heavy-schemas"
        },
        "priority_order": {
          "const": "post-detach-runtime-lane-before-other-legacy-fixture-heavy-schemas"
        },
        "fixture_split_pattern": {
          "const": "generic-runtime-schema-plus-exact-fixture-schema-plus-semantic-checker"
        },
        "non_blocking_legacy_history": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "items_total",
        "open_items",
        "completed_items",
        "post_detach_items",
        "highest_const_count",
        "audit_next_targets_count"
      ],
      "properties": {
        "items_total": {
          "type": "integer",
          "minimum": 0
        },
        "open_items": {
          "type": "integer",
          "minimum": 0
        },
        "completed_items": {
          "type": "integer",
          "minimum": 0
        },
        "post_detach_items": {
          "type": "integer",
          "minimum": 0
        },
        "highest_const_count": {
          "type": "integer",
          "minimum": 0
        },
        "audit_next_targets_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": [
        "schema",
        "const_count",
        "priority",
        "status",
        "domain",
        "recommended_action",
        "audit_next_target"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schemaPath"
        },
        "const_count": {
          "type": "integer",
          "minimum": 0
        },
        "priority": {
          "enum": [
            "p0",
            "p1",
            "p2"
          ]
        },
        "status": {
          "enum": [
            "open",
            "completed-production-fixture-split",
            "audited-runtime-policy-const-mesh"
          ]
        },
        "domain": {
          "enum": [
            "post-detach",
            "network-publish",
            "content-import",
            "preopen",
            "other"
          ]
        },
        "recommended_action": {
          "type": "string",
          "minLength": 12
        },
        "audit_next_target": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "invariants": {
      "type": "object",
      "required": [
        "every_const_heavy_schema_has_backlog_item",
        "audit_next_targets_are_p0_or_completed",
        "open_items_have_action",
        "completed_items_have_allowed_disposition"
      ],
      "properties": {
        "every_const_heavy_schema_has_backlog_item": {
          "const": true
        },
        "audit_next_targets_are_p0_or_completed": {
          "const": true
        },
        "open_items_have_action": {
          "const": true
        },
        "completed_items_have_allowed_disposition": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "refactorPolicy": {
      "type": "object",
      "required": [
        "next_cut_recommendation",
        "do_not_rewrite_historical_examples_without_fixture_schema",
        "checker_refactor_direction"
      ],
      "properties": {
        "next_cut_recommendation": {
          "type": "string",
          "minLength": 12
        },
        "do_not_rewrite_historical_examples_without_fixture_schema": {
          "const": true
        },
        "checker_refactor_direction": {
          "const": "move-const-heavy-post-detach-schemas-through-generic-plus-fixture-split"
        }
      },
      "additionalProperties": false
    }
  }
}
