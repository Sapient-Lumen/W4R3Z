{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD bootchain policy (bootchain.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "created_at",
    "scope",
    "components"
  ],
  "properties": {
    "kind": { "const": "bootchain-policy" },
    "policy_version": { "type": "string", "pattern": "^0\\.\\d+$" },

    "policy_id": { "type": "string", "description": "Stable id (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Where this policy applies (fleet role, hardware class, pool, etc.).",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "selector": { "type": "object", "description": "Optional selector hints (labels, platform class, etc.)." }
      },
      "additionalProperties": false
    },

    "components": {
      "type": "array",
      "minItems": 1,
      "description": "Per-component allow rules (SBAT-shaped).",
      "items": {
        "type": "object",
        "required": ["vendor_id", "component_id", "min_generation"],
        "properties": {
          "vendor_id": { "type": "string" },
          "component_id": { "type": "string" },
          "min_generation": { "type": "integer", "minimum": 0 },
          "allowed_build_digests": {
            "type": "array",
            "description": "Optional explicit allowlist of build digests for this component.",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "revocations": {
      "type": "array",
      "description": "Explicit revocations (build digests or generation cutoffs).",
      "items": {
        "type": "object",
        "required": ["vendor_id", "component_id", "kind"],
        "properties": {
          "vendor_id": { "type": "string" },
          "component_id": { "type": "string" },
          "kind": { "type": "string", "enum": ["digest", "generation_below"] },
          "build_digest": { "type": "string" },
          "generation": { "type": "integer", "minimum": 0 },
          "reason": { "type": "string" },
          "effective_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "digest" } } },
            "then": { "required": ["build_digest"] }
          },
          {
            "if": { "properties": { "kind": { "const": "generation_below" } } },
            "then": { "required": ["generation"] }
          }
        ]
      }
    },

    "notes": { "type": "string" },

    "signature": {
      "type": "object",
      "description": "Optional signature over canonical JSON bytes.",
      "properties": {
        "key_id": { "type": "string" },
        "alg": { "type": "string" },
        "sig": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
