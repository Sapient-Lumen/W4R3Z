{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD time source inventory (time.source.inventory) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "inventory_version",
    "created_at",
    "host",
    "sources"
  ],
  "properties": {
    "kind": {"const": "time-source-inventory"},
    "inventory_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "inventory_id": {"type": "string", "description": "Stable id for this inventory snapshot (UUID recommended)."},

    "created_at": {"type": "string", "format": "date-time"},

    "host": {
      "type": "object",
      "required": ["host_id", "generation_digest"],
      "properties": {
        "host_id": {"type": "string"},
        "generation_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "type"],
        "properties": {
          "source_id": {"type": "string", "description": "Stable id for this time source (hashed/pseudonymous recommended for privacy)."},
          "type": {"type": "string", "enum": ["ntp", "ptp", "rtc", "roughtime", "gps", "manual"]},
          "address": {"type": "string", "description": "Optional address/descriptor; may be omitted or redacted."},
          "authenticated": {"type": "boolean", "description": "Whether this source is expected to be authenticated (NTS/PTP auth/etc.)."},
          "capabilities": {
            "type": "array",
            "items": {"type": "string", "enum": ["step", "slew", "holdover", "hardware-timestamping", "quorum"]}
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
