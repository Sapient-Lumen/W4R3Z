{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD network topology plan (net.topology.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "links"
  ],
  "properties": {
    "kind": { "const": "net-topology-plan" },
    "plan_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "plan_id": { "type": "string", "description": "Stable id for the plan (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "requested_by": { "type": "string", "description": "Opaque operator/workflow id (optional)." },

    "target": {
      "type": "object",
      "description": "Where the topology applies.",
      "properties": {
        "host_id": { "type": "string" },
        "domain": { "type": "string", "description": "Optional compartment/domain identifier." }
      },
      "additionalProperties": false
    },

    "links": {
      "type": "array",
      "minItems": 1,
      "description": "Link objects to create or ensure exist.",
      "items": {
        "type": "object",
        "required": ["name", "link_kind"],
        "properties": {
          "name": { "type": "string" },
          "link_kind": {
            "type": "string",
            "enum": ["physical", "bridge", "tap", "epair", "vnet", "vlan", "lo", "wg"],
            "description": "Kind of link object (v1)."
          },
          "ensure": {
            "type": "string",
            "enum": ["present", "absent"],
            "default": "present",
            "description": "Whether the link should exist or be removed."
          },
          "mtu": { "type": "integer", "minimum": 576 },
          "members": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Member interfaces (for bridges/VLAN-like constructs)."
          },
          "params": {
            "type": "object",
            "description": "Backend-specific knobs (kept small; prefer adapters).",
            "additionalProperties": true
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "addresses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["iface", "cidr"],
        "properties": {
          "iface": { "type": "string" },
          "cidr": { "type": "string", "description": "CIDR address (e.g., 192.0.2.10/24)." },
          "alias": { "type": "boolean", "default": false },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dst", "via"],
        "properties": {
          "dst": { "type": "string", "description": "Destination CIDR (e.g., 0.0.0.0/0)." },
          "via": { "type": "string", "description": "Gateway IP or interface name (backend-defined)." },
          "iface": { "type": "string" },
          "metric": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "firewall": {
      "type": "object",
      "description": "Firewall substrate posture (pf-first).",
      "properties": {
        "pf_enabled": { "type": "boolean", "default": true },
        "root_rules_digest": { "type": "string", "description": "Digest of the root ruleset artifact." },
        "anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "rules_digest"],
            "properties": {
              "name": { "type": "string", "description": "Anchor name (e.g., derive/inst/<id>)." },
              "rules_digest": { "type": "string", "description": "Digest of the anchor rules artifact." },
              "direction": { "type": "string", "enum": ["in", "out", "nat", "mixed"] }
            },
            "additionalProperties": false
          }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "apply": {
      "type": "object",
      "description": "Application posture (kept small; prefer change-set policy).",
      "properties": {
        "commit_confirmed": { "type": "boolean", "default": false },
        "confirm_ttl_seconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
