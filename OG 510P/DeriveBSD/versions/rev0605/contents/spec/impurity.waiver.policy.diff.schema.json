{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD impurity waiver policy diff (impurity.waiver.policy.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_policy",
    "to_policy",
    "default_mode_changed",
    "waivers_added",
    "waivers_removed",
    "waivers_changed",
    "summary"
  ],
  "properties": {
    "kind": { "const": "impurity.waiver.policy.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (profile/generation/lane).",
      "properties": {
        "profile_id": { "type": "string" },
        "lane": { "type": "string" },
        "from_generation": { "type": "string" },
        "to_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "from_policy": { "$ref": "#/$defs/policy_ref" },
    "to_policy": { "$ref": "#/$defs/policy_ref" },

    "default_mode_changed": { "$ref": "#/$defs/default_mode_change" },

    "waivers_added": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver_entry" }
    },
    "waivers_removed": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver_entry" }
    },
    "waivers_changed": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver_change" }
    },

    "summary": {
      "type": "object",
      "required": ["waivers_added", "waivers_removed", "waivers_changed"],
      "properties": {
        "waivers_added": { "type": "integer", "minimum": 0 },
        "waivers_removed": { "type": "integer", "minimum": 0 },
        "waivers_changed": { "type": "integer", "minimum": 0 },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false,
  "$defs": {
    "policy_ref": {
      "type": "object",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "policy_version": { "type": "string" },
        "issued_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "default_mode_change": {
      "description": "Default posture drift for unknown impurity ids. Null means unchanged.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string", "enum": ["deny", "allow"] },
            "to": { "type": "string", "enum": ["deny", "allow"] }
          },
          "additionalProperties": false
        }
      ]
    },

    "waiver_entry": {
      "type": "object",
      "required": ["waiver_id", "impurity_ids", "expires_at"],
      "properties": {
        "waiver_id": { "type": "string" },
        "impurity_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "expires_at": { "type": "string", "format": "date-time" },
        "scope": { "type": "object" }
      },
      "additionalProperties": true,
      "description": "Compact waiver snapshot for diff surfaces (not a full policy object)."
    },

    "waiver_change": {
      "type": "object",
      "required": ["waiver_id", "from", "to"],
      "properties": {
        "waiver_id": { "type": "string" },
        "from": { "$ref": "#/$defs/waiver_entry" },
        "to": { "$ref": "#/$defs/waiver_entry" },

        "expiry_changed": {
          "type": "boolean",
          "description": "Whether expires_at changed (extensions are a high-leverage posture drift)."
        },
        "scope_broadened": {
          "type": "boolean",
          "description": "Whether the applicability scope broadened (e.g. more profiles/lanes/stages/targets)."
        },
        "impurity_ids_changed": {
          "type": "boolean",
          "description": "Whether impurity_ids changed for this waiver."
        }
      },
      "additionalProperties": false
    }
  }
}
