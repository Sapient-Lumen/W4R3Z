{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Capability Graph (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "graph_version",
    "plan_digest",
    "nodes",
    "edges"
  ],
  "properties": {
    "kind": {
      "const": "capability-graph"
    },
    "graph_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "plan_digest": {
      "type": "string"
    },
    "caproute_digest": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "e.g. microvm, jail, host-service, broker"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "capability"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "capability": {
            "type": "object",
            "required": [
              "type",
              "rights"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "rights": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scope": {
                "type": "object"
              },
              "risk_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
