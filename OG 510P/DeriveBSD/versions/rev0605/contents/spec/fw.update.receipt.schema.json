{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD firmware update receipt (fw.update.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_id",
    "plan_digest",
    "results"
  ],
  "properties": {
    "kind": {
      "const": "fw-update-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "receipt_id": {
      "type": "string",
      "description": "Stable id for this receipt (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_id": {
      "type": "string"
    },
    "plan_digest": {
      "type": "string",
      "description": "Digest of the fw.update.plan that was executed."
    },
    "host": {
      "type": "object",
      "properties": {
        "machine_id": {
          "type": "string"
        },
        "boot_generation": {
          "type": "string"
        },
        "time_proof_bundle_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "pre_fw_inventory_digest": {
      "type": "string",
      "description": "Digest of fw.inventory.receipt collected before applying/staging."
    },
    "post_fw_inventory_digest": {
      "type": "string",
      "description": "Digest of fw.inventory.receipt collected after reboot/apply."
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "class",
          "status"
        ],
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              "system",
              "bmc",
              "nic",
              "storage",
              "disk",
              "other"
            ]
          },
          "device_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "staged",
              "applied",
              "reboot-required",
              "blocked-by-policy",
              "apply-failed",
              "postcheck-failed",
              "skipped"
            ]
          },
          "detail": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "uefi_esrt_status": {
            "type": "object",
            "description": "Optional ESRT-derived last-attempt status for capsule targets.",
            "properties": {
              "last_attempt_status": {
                "type": "integer",
                "minimum": 0
              },
              "last_attempt_version": {
                "type": "string"
              },
              "last_attempt_error": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "description": "Optional pointers to supporting artifacts/log digests.",
      "properties": {
        "uefi_capsule_status": {
          "type": "string"
        },
        "uefi_var_receipt_digest": {
          "type": "string"
        },
        "boot_eventlog_digest": {
          "type": "string"
        },
        "logs_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "default": "success"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
