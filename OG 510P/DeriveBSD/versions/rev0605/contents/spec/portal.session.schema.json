{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Portal Session Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "session_version",
    "session_id",
    "portal",
    "subject",
    "capset_digest",
    "created_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "portal-session"
    },
    "session_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "session_id": {
      "type": "string",
      "description": "Stable identifier for the session (opaque)."
    },
    "portal": {
      "type": "string",
      "description": "Portal family name (e.g. ui.screencast, ui.print)."
    },
    "lease_id": {
      "type": "string",
      "description": "Optional lease identifier if the session is revocable via lease semantics."
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "capset_digest": {
      "type": "string",
      "description": "Digest identifying the authority live for this session."
    },
    "close_semantics": {
      "type": "string",
      "enum": [
        "revoke",
        "drain",
        "detach",
        "noop"
      ],
      "description": "What Close is expected to do."
    },
    "expires_at": {
      "type": "string",
      "description": "Optional RFC3339 timestamp for expiry."
    },
    "created_at": {
      "type": "string",
      "description": "RFC3339 timestamp."
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
