{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD role-binding policy-window denial event profile (intent.role.binding.event.write-denied.policy-window) (v0.1)",
  "allOf": [
    {
      "$ref": "intent.role.binding.event.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "intent.role.binding.event"
        },
        "action": {
          "const": "write-denied"
        },
        "trigger": {
          "enum": [
            "policy-reconcile",
            "support-import"
          ]
        },
        "reason_code": {
          "enum": [
            "policy-expired",
            "policy-consumed"
          ]
        },
        "policy_decision_digest": {
          "type": "string"
        },
        "consumed_by_event_id": {
          "type": "string"
        },
        "consumed_by_event_digest": {
          "type": "string"
        },
        "consuming_event_action": {
          "enum": [
            "initialized",
            "updated"
          ]
        },
        "recovery_interpretation": {
          "enum": [
            "policy-consumed",
            "already-applied"
          ]
        },
        "consumed_binding_digest": {
          "type": "string"
        },
        "consumed_diff_digest": {
          "type": "string"
        },
        "consumed_previous_binding_digest": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "trigger",
        "reason_code",
        "policy_decision_digest"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "reason_code": {
                "const": "policy-consumed"
              }
            }
          },
          "then": {
            "required": [
              "consumed_by_event_id",
              "consumed_by_event_digest",
              "consuming_event_action",
              "consumed_binding_digest",
              "consumed_diff_digest",
              "recovery_interpretation"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "reason_code": {
                "const": "policy-consumed"
              },
              "consuming_event_action": {
                "const": "updated"
              }
            }
          },
          "then": {
            "required": [
              "consumed_previous_binding_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "reason_code": {
                "const": "policy-consumed"
              },
              "consuming_event_action": {
                "const": "initialized"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "consumed_previous_binding_digest"
              ]
            }
          }
        }
      ]
    }
  ]
}
