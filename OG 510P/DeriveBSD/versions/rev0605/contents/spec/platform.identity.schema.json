{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD platform identity helper (v0.1)",
  "type": "object",
  "required": ["os", "arch"],
  "properties": {
    "os": {"type": "string", "minLength": 1},
    "arch": {"type": "string", "minLength": 1},
    "abi": {"type": "string", "minLength": 1},
    "vendor": {"type": "string", "minLength": 1},
    "subarch": {"type": "string", "minLength": 1},
    "libc": {"type": "string", "minLength": 1},
    "aliases": {
      "type": "object",
      "properties": {
        "llvm_target_triple": {"type": "string", "minLength": 1},
        "gnu_config": {"type": "string", "minLength": 1},
        "freebsd_target": {"type": "string", "minLength": 1},
        "freebsd_target_arch": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
