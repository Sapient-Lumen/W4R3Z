{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI Camera Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "lease_id",
    "subject",
    "device_selector",
    "stream",
    "started_at",
    "signature"
  ],
  "properties": {
    "kind": { "const": "ui-camera-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "lease_id": { "type": "string" },
    "subject": { "$ref": "ui.camera.grant.schema.json#/properties/subject" },
    "device_selector": { "type": "string" },
    "stream": {
      "type": "object",
      "required": ["transport", "handle_digest"],
      "properties": {
        "transport": { "type": "string", "enum": ["pipewire", "ocap-rpc", "other"] },
        "handle_digest": { "type": "string" }
      },
      "additionalProperties": false
    },
    "started_at": { "type": "string", "description": "ISO8601 time." },
    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": { "type": "string" },
        "alg": { "type": "string" },
        "sig": { "type": "string", "description": "Signature over canonical JSON bytes." }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
