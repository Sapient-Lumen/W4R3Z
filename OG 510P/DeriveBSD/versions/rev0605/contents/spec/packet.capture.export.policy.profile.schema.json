{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD packet-capture export policy profile (packet.capture.export.policy.profile) (v0.1)",
  "allOf": [
    {
      "$ref": "export.policy.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "artifact_kind",
                  "allow_raw_blobs"
                ],
                "properties": {
                  "artifact_kind": {
                    "const": "packet.capture.summary"
                  },
                  "allow_raw_blobs": {
                    "const": false
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "artifact_kind",
                  "redaction_transform_digest",
                  "allow_raw_blobs"
                ],
                "properties": {
                  "artifact_kind": {
                    "const": "packet.capture.normalized"
                  },
                  "redaction_transform_digest": {
                    "type": "string"
                  },
                  "allow_raw_blobs": {
                    "const": true
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "kind",
        "policy_version",
        "policy_id",
        "created_at",
        "rules"
      ]
    }
  ]
}
