{
  "$defs": {
    "evidence_file": {
      "additionalProperties": false,
      "properties": {
        "output_root": {
          "const": "validation/removable-media-local-fallback-harness/expected"
        },
        "path": {
          "pattern": "^store/sha256/[0-9a-f]{2}/[0-9a-f]{64}/(preserved-subject\\.bin|sanitized-summary\\.json)$",
          "type": "string"
        },
        "role": {
          "enum": [
            "preserved-capture",
            "sanitized-derivative-summary"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "role",
        "output_root",
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission": {
      "additionalProperties": false,
      "properties": {
        "allowed_filesystem_families": {
          "contains": {
            "const": "exfat"
          },
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "denied_filesystem_families": {
          "contains": {
            "const": "unknown"
          },
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "filesystem_family_admitted": {
          "const": true
        },
        "host_fallback_mounts_forbidden": {
          "const": true
        },
        "mount_flags_required": {
          "items": {
            "enum": [
              "ro",
              "nosuid",
              "noexec",
              "nosymfollow",
              "untrusted"
            ]
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array",
          "uniqueItems": true
        },
        "path_escape_denied": {
          "const": true
        },
        "read_only": {
          "const": true
        },
        "selected_subject_regular_file": {
          "const": true
        },
        "selected_subject_symlink": {
          "const": false
        },
        "source_grant": {
          "const": "spec/examples/device.attach.grant.removable-media-local-ingest.json"
        }
      },
      "required": [
        "source_grant",
        "filesystem_family_admitted",
        "allowed_filesystem_families",
        "denied_filesystem_families",
        "mount_flags_required",
        "read_only",
        "host_fallback_mounts_forbidden",
        "selected_subject_regular_file",
        "selected_subject_symlink",
        "path_escape_denied"
      ],
      "type": "object"
    },
    "capture": {
      "additionalProperties": false,
      "properties": {
        "capture_before_later_ops": {
          "const": "required-before-noncapture-ops"
        },
        "digest_verification": {
          "const": "must-match-planned-subject-digest-before-later-ops"
        },
        "observed_size_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "observed_subject_digest": {
          "$ref": "#/$defs/sha256"
        },
        "path_capture": {
          "additionalProperties": false,
          "properties": {
            "ancestor_symlink_policy": {
              "const": "deny-each-ancestor-by-openat-o_directory-o_nofollow"
            },
            "capture_api": {
              "const": "dirfd-openat-no-symlink-components"
            },
            "leaf_symlink_policy": {
              "const": "deny-leaf-by-openat-o_nofollow"
            },
            "lstat_fstat_same_object": {
              "const": true
            },
            "opened_with_no_follow": {
              "const": true
            },
            "opened_with_openat": {
              "const": true
            },
            "regular_file_only": {
              "const": true
            },
            "root_fd_pinned": {
              "const": true
            },
            "source_stable_after_copy": {
              "const": true
            },
            "verified_after_copy": {
              "const": true
            }
          },
          "required": [
            "capture_api",
            "root_fd_pinned",
            "opened_with_openat",
            "opened_with_no_follow",
            "ancestor_symlink_policy",
            "leaf_symlink_policy",
            "regular_file_only",
            "lstat_fstat_same_object",
            "source_stable_after_copy",
            "verified_after_copy"
          ],
          "type": "object"
        },
        "plan": {
          "const": "spec/examples/content.import.plan.removable-media-local-ingest.json"
        },
        "plan_subject_digest": {
          "$ref": "#/$defs/sha256"
        },
        "preserved_capture": {
          "additionalProperties": false,
          "properties": {
            "locator_kind": {
              "const": "digest-addressed-store"
            },
            "logical_path": {
              "pattern": "^store/sha256/[0-9a-f]{2}/[0-9a-f]{64}/preserved-subject\\.bin$",
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "size_bytes": {
              "minimum": 1,
              "type": "integer"
            },
            "worker_visible": {
              "const": false
            }
          },
          "required": [
            "logical_path",
            "sha256",
            "size_bytes",
            "locator_kind",
            "worker_visible"
          ],
          "type": "object"
        },
        "receipt": {
          "const": "spec/examples/content.import.receipt.removable-media-local-ingest.json"
        },
        "source_path_for_fixture": {
          "const": "invoice.pdf"
        }
      },
      "required": [
        "source_path_for_fixture",
        "plan",
        "receipt",
        "plan_subject_digest",
        "observed_subject_digest",
        "observed_size_bytes",
        "capture_before_later_ops",
        "digest_verification",
        "path_capture",
        "preserved_capture"
      ],
      "type": "object"
    },
    "derivative": {
      "additionalProperties": false,
      "properties": {
        "body_bytes_copied": {
          "const": false
        },
        "logical_path": {
          "pattern": "^store/sha256/[0-9a-f]{2}/[0-9a-f]{64}/sanitized-summary\\.json$",
          "type": "string"
        },
        "relationship": {
          "const": "separate-derivative-from-preserved-capture"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_digest": {
          "$ref": "#/$defs/sha256"
        },
        "worker_readback_allowed": {
          "const": false
        }
      },
      "required": [
        "logical_path",
        "sha256",
        "source_digest",
        "relationship",
        "body_bytes_copied",
        "worker_readback_allowed"
      ],
      "type": "object"
    },
    "detach_gate": {
      "additionalProperties": false,
      "properties": {
        "detach_receipt": {
          "const": "spec/examples/device.detach.receipt.removable-media-local-ingest.json"
        },
        "detach_trigger": {
          "const": "selected-subject-capture-verified"
        },
        "ingest_references_closed_before_worker": {
          "const": true
        },
        "later_ops_dependency": {
          "const": "no-device-presence-required-after-detach"
        },
        "media_session_ended_before_later_ops": {
          "const": true
        },
        "projection_source_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "detach_receipt",
        "detach_trigger",
        "later_ops_dependency",
        "media_session_ended_before_later_ops",
        "ingest_references_closed_before_worker",
        "projection_source_digest"
      ],
      "type": "object"
    },
    "evidence_files": {
      "items": {
        "$ref": "#/$defs/evidence_file"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "generated_for_version": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}r[0-9]{3,}$",
      "type": "string"
    },
    "harness": {
      "additionalProperties": false,
      "properties": {
        "harness_version": {
          "const": "0.2"
        },
        "scope": {
          "const": "cloudtainer-executable-first-lane-proof-not-production-mounter"
        },
        "tool": {
          "const": "tools/removable_media_local_fallback_harness.py"
        }
      },
      "required": [
        "tool",
        "harness_version",
        "scope"
      ],
      "type": "object"
    },
    "inputs": {
      "additionalProperties": false,
      "properties": {
        "claimed_filesystem_family": {
          "enum": [
            "msdosfs",
            "exfat",
            "ufs",
            "cd9660"
          ]
        },
        "device_id": {
          "const": "usb:vid=090c,pid=1000,serial=AA0001234567"
        },
        "fixture_media_root": {
          "const": "fixtures/removable-media/local-fallback/exfat-card"
        },
        "selected_path": {
          "const": "invoice.pdf"
        },
        "selected_path_normalized": {
          "const": "invoice.pdf"
        }
      },
      "required": [
        "fixture_media_root",
        "selected_path",
        "selected_path_normalized",
        "device_id",
        "claimed_filesystem_family"
      ],
      "type": "object"
    },
    "kind": {
      "const": "removable.media.local.fallback.harness.run"
    },
    "post_detach_worker": {
      "additionalProperties": false,
      "properties": {
        "authoritative_store_browseable": {
          "const": false
        },
        "capability_mode_entered": {
          "const": true
        },
        "contract": {
          "const": "spec/examples/removable.media.local.post_detach.contract.json"
        },
        "contract_capability_mode": {
          "const": "cap-enter-before-tool-code-inherited-by-descendants"
        },
        "derivative_slot": {
          "additionalProperties": false,
          "properties": {
            "broker_remeasured_output": {
              "const": true
            },
            "declared_slots": {
              "const": 1
            },
            "initial_state": {
              "const": "empty-regular-file"
            },
            "open_mode": {
              "const": "append-only-no-readback-no-truncate"
            }
          },
          "required": [
            "declared_slots",
            "initial_state",
            "open_mode",
            "broker_remeasured_output"
          ],
          "type": "object"
        },
        "device_nodes_visible": {
          "maxItems": 0,
          "type": "array"
        },
        "ingest_mount_visible": {
          "const": false
        },
        "launch_evidence": {
          "const": "spec/examples/removable.media.local.post_detach.launch.evidence.json"
        },
        "media_mount_visible": {
          "const": false
        },
        "network_default": {
          "const": "deny-all"
        },
        "network_socket_descriptors": {
          "maxItems": 0,
          "type": "array"
        },
        "path_reopen_after_entry": {
          "const": "forbidden"
        },
        "single_object_projection_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "contract",
        "launch_evidence",
        "capability_mode_entered",
        "path_reopen_after_entry",
        "ingest_mount_visible",
        "media_mount_visible",
        "device_nodes_visible",
        "network_default",
        "network_socket_descriptors",
        "contract_capability_mode",
        "single_object_projection_digest",
        "authoritative_store_browseable",
        "derivative_slot"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "minLength": 20,
          "type": "string"
        },
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "status",
        "message"
      ],
      "type": "object"
    },
    "run_id": {
      "pattern": "^rm-local-fallback-harness-[0-9]{8}-r[0-9]{3,}-[a-z0-9-]+$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "run_id",
    "generated_for_version",
    "harness",
    "inputs",
    "admission",
    "capture",
    "detach_gate",
    "post_detach_worker",
    "derivative",
    "evidence_files",
    "result"
  ],
  "title": "Removable media local fallback cloudtainer harness run",
  "type": "object"
}
