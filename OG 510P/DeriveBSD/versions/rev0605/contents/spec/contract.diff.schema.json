{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD contract diff (contract.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from",
    "to",
    "added",
    "removed",
    "changed"
  ],
  "properties": {
    "kind": { "const": "contract.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "from": { "$ref": "#/$defs/ref" },
    "to": { "$ref": "#/$defs/ref" },

    "added": { "type": "array", "items": { "$ref": "#/$defs/delta" } },
    "removed": { "type": "array", "items": { "$ref": "#/$defs/delta" } },
    "changed": { "type": "array", "items": { "$ref": "#/$defs/change" } },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "type": "string" },
        "digest": { "type": "string" }
      },
      "additionalProperties": false
    },
    "delta": {
      "type": "object",
      "required": ["id", "surface", "summary"],
      "properties": {
        "id": { "type": "string" },
        "surface": { "type": "string" },
        "summary": { "type": "string" },
        "stability": { "type": "string" },
        "contract_digest": { "type": "string" },
        "risk_tags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": ["id", "summary", "classification"],
      "properties": {
        "id": { "type": "string" },
        "summary": { "type": "string" },
        "classification": { "type": "string", "enum": ["compatible", "breaking", "suspicious"] },
        "from_digest": { "type": "string" },
        "to_digest": { "type": "string" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
