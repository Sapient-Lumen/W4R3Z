{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "sync",
        "step",
        "slew",
        "source-change",
        "leap-handle",
        "bootstrap"
      ],
      "type": "string"
    },
    "applied_at": {
      "format": "date-time",
      "type": "string"
    },
    "correlation": {
      "additionalProperties": false,
      "properties": {
        "change_id": {
          "type": "string"
        },
        "step": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "details": {
      "additionalProperties": false,
      "properties": {
        "authenticated": {
          "type": "boolean"
        },
        "delta_ms": {
          "description": "Step or estimated correction applied, in milliseconds. Use a decimal string, not a JSON number, so hash-bound time evidence stays restricted-JCS/I-JSON canonicalization-admissible.",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        "leap": {
          "enum": [
            "none",
            "pending",
            "insert",
            "delete",
            "unknown"
          ],
          "type": "string"
        },
        "lkgt_after": {
          "description": "LKGT after this action, if maintained.",
          "format": "date-time",
          "type": "string"
        },
        "lkgt_before": {
          "description": "LKGT before this action, if maintained.",
          "format": "date-time",
          "type": "string"
        },
        "offset_ms": {
          "description": "offset_ms in milliseconds. Use a decimal string, not a JSON number, so hash-bound time evidence stays restricted-JCS/I-JSON canonicalization-admissible.",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        "reference_source_id": {
          "type": "string"
        },
        "uncertainty_ms": {
          "description": "uncertainty_ms in milliseconds. Use a decimal string, not a JSON number, so hash-bound time evidence stays restricted-JCS/I-JSON canonicalization-admissible.",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "finished_at": {
      "format": "date-time",
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "kind": {
      "const": "time-sync-receipt"
    },
    "notes": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "success",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "plan": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string"
        },
        "plan_id": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "receipt_id": {
      "description": "Stable id for the receipt (UUID recommended).",
      "type": "string"
    },
    "receipt_version": {
      "pattern": "^0\\.\\d+$",
      "type": "string"
    },
    "snapshots": {
      "additionalProperties": false,
      "properties": {
        "after_digest": {
          "type": "string"
        },
        "before_digest": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "kind",
    "receipt_version",
    "applied_at",
    "host_id",
    "action",
    "outcome"
  ],
  "title": "DeriveBSD time sync receipt (time.sync.receipt) (v0.1)",
  "type": "object"
}
