{
  "$defs": {
    "booleanMap": {
      "additionalProperties": {
        "type": "boolean"
      },
      "type": "object"
    },
    "receiptSummary": {
      "additionalProperties": false,
      "properties": {
        "byte_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capture_digest": {
          "$ref": "#/$defs/sha256"
        },
        "checker_only_host_command_simulation": {
          "type": "boolean"
        },
        "cube_cut_version": {
          "const": "2026-06-18r630"
        },
        "generated_at_utc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "generated_for_version": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}r[0-9]{3,}$",
          "type": "string"
        },
        "host_probe_capsicum_capabilities": {
          "enum": [
            "0",
            "1"
          ]
        },
        "host_probe_capsicum_capability_mode": {
          "enum": [
            "0",
            "1"
          ]
        },
        "host_probe_effective_uid": {
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "host_probe_observed_system": {
          "type": "string"
        },
        "host_probe_osreldate": {
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "host_target_matrix_id": {
          "const": "freebsd-host-proof-targets-20260617-r605"
        },
        "host_probe_uname_machine": {
          "type": "string"
        },
        "host_probe_uname_release": {
          "type": "string"
        },
        "host_target_tier": {
          "enum": [
            "primary-production",
            "supported-legacy-floor"
          ]
        },
        "kind": {
          "const": "removable.media.local.freebsd.host.smoke.receipt"
        },
        "observed_system": {
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "result": {
          "const": "passed"
        },
        "runner_contract_version": {
          "const": "2026-06-05r554"
        },
        "schema_version": {
          "const": "0.1"
        },
        "smoke_id": {
          "const": "rm-local-freebsd-host-smoke-20260605-r554"
        },
        "worker_binary_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "byte_sha256",
        "canonical_sha256",
        "kind",
        "schema_version",
        "smoke_id",
        "generated_for_version",
        "runner_contract_version",
        "cube_cut_version",
        "generated_at_utc",
        "result",
        "checker_only_host_command_simulation",
        "observed_system",
        "host_probe_observed_system",
        "host_probe_uname_release",
        "host_probe_uname_machine",
        "host_probe_effective_uid",
        "host_probe_osreldate",
        "host_target_matrix_id",
        "host_target_tier",
        "host_probe_capsicum_capability_mode",
        "host_probe_capsicum_capabilities",
        "capture_digest",
        "worker_binary_sha256"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "toolDigest": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "type": "boolean"
        },
        "path": {
          "pattern": "^tools/freebsd/",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256",
        "executable"
      ],
      "type": "object"
    },
    "utcTimestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "proof_status": {
            "const": "real-host-proof"
          }
        }
      },
      "then": {
        "properties": {
          "invariants": {
            "properties": {
              "default_validator_mode_required_for_real_proof": {
                "const": true
              },
              "real_proof_requires_non_simulated_receipt": {
                "const": true
              }
            }
          },
          "receipt": {
            "properties": {
              "checker_only_host_command_simulation": {
                "const": false
              },
              "host_probe_capsicum_capabilities": {
                "const": "1"
              },
              "host_probe_capsicum_capability_mode": {
                "const": "1"
              },
              "host_probe_effective_uid": {
                "const": "0"
              },
              "host_probe_observed_system": {
                "const": "FreeBSD"
              },
              "observed_system": {
                "const": "FreeBSD"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proof_status": {
            "const": "checker-simulation-non-proof"
          }
        }
      },
      "then": {
        "properties": {
          "invariants": {
            "properties": {
              "checker_simulation_explicitly_non_proof": {
                "const": true
              },
              "default_validator_mode_required_for_real_proof": {
                "const": false
              }
            }
          },
          "receipt": {
            "properties": {
              "checker_only_host_command_simulation": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "description": "Importable summary bundle for a FreeBSD removable-media host-smoke receipt. Default finalization accepts only real non-simulated host proof; the checked example is explicitly a checker-simulation non-proof bundle so the shape can be tested before a real FreeBSD receipt exists.",
  "properties": {
    "bundle_id": {
      "pattern": "^rm-local-freebsd-host-proof-bundle-[0-9]{8}-r[0-9]{3,}$",
      "type": "string"
    },
    "cube_cut_version": {
      "const": "2026-06-18r630"
    },
    "generated_at_utc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "generated_for_version": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}r[0-9]{3,}$",
      "type": "string"
    },
    "invariants": {
      "$ref": "#/$defs/booleanMap"
    },
    "kind": {
      "const": "removable.media.local.freebsd.host.proof.bundle"
    },
    "operator_next_step": {
      "const": "attach-this-bundle-plus-original-receipt-to-the-session-review-only-when-proof_status-is-real-host-proof"
    },
    "proof_status": {
      "enum": [
        "real-host-proof",
        "checker-simulation-non-proof"
      ]
    },
    "receipt": {
      "$ref": "#/$defs/receiptSummary"
    },
    "schema_version": {
      "const": "0.1"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/toolDigest"
      },
      "maxItems": 18,
      "minItems": 18,
      "type": "array"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "bundle_id",
    "generated_for_version",
    "cube_cut_version",
    "generated_at_utc",
    "proof_status",
    "receipt",
    "tools",
    "invariants",
    "operator_next_step"
  ],
  "title": "Removable media local FreeBSD host proof bundle",
  "type": "object"
}
