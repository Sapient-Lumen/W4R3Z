{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD destructive reprovision receipt (reset.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "applied_at",
    "authorization",
    "target",
    "requested",
    "observed_evidence",
    "outcome"
  ],
  "properties": {
    "kind": {
      "const": "reset.receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "receipt_id": {
      "type": "string"
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorization": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string"
        },
        "authorization_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "serial": {
          "type": "string"
        },
        "wwn": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "matched_selector": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "requested": {
      "type": "object",
      "required": [
        "disk_layout_plan_digest",
        "install_bundle_digest"
      ],
      "properties": {
        "disk_layout_plan_digest": {
          "type": "string"
        },
        "disk_layout_plan_id": {
          "type": "string"
        },
        "install_bundle_digest": {
          "type": "string"
        },
        "change_set_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "observed_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "outcome"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "trusted-ui-confirmation",
              "physical-reset-marker",
              "station-presence-assertion",
              "breakglass-grant",
              "offline-quorum-approval",
              "maintenance-window"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "observed",
              "not-observed",
              "not-required"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "resulting_receipts": {
      "type": "object",
      "properties": {
        "disk_layout_receipt_digest": {
          "type": "string"
        },
        "change_receipt_digest": {
          "type": "string"
        },
        "bootstrap_evidence_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "partial",
        "denied"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
