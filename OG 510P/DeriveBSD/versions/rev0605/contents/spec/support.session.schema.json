{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD remote assistance session envelope (support.session) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "session_version",
    "session_id",
    "created_at",
    "host",
    "participants",
    "scope"
  ],
  "properties": {
    "kind": {
      "const": "support-session"
    },
    "session_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "session_id": {
      "type": "string",
      "description": "Stable id (UUID recommended) for the support session."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "required": [
        "host_id",
        "generation_digest"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "generation_digest": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "principal"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "requester",
              "local_user",
              "helper",
              "observer",
              "broker"
            ]
          },
          "principal": {
            "type": "string"
          },
          "identity_receipt_digest": {
            "type": "string",
            "description": "Optional digest of identity evidence (e.g., publisher identity receipt / OIDC assertion envelope)."
          }
        },
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "screencast": {
          "type": "boolean"
        },
        "remote_control": {
          "type": "boolean"
        },
        "clipboard": {
          "type": "boolean"
        },
        "file_transfer": {
          "type": "boolean"
        },
        "terminal_recording": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "leases": {
      "type": "array",
      "description": "Lease ids or digests for lane leases issued for this session.",
      "items": {
        "type": "object",
        "required": [
          "lane",
          "lease_id"
        ],
        "properties": {
          "lane": {
            "type": "string"
          },
          "lease_id": {
            "type": "string"
          },
          "lease_digest": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "description": "Pointers to receipts and artifacts produced during the session.",
      "properties": {
        "consent_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ui_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "network_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recording_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "export_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "incident_bundle_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "description": "Optional signature over this envelope.",
      "properties": {
        "sig_alg": {
          "type": "string"
        },
        "public_key_hint": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
