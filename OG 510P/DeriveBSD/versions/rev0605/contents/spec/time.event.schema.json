{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "event.record.schema.json"
    },
    {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "sync-acquired",
            "sync-lost",
            "source-changed",
            "clock-stepped",
            "clock-slewed",
            "leap-announced",
            "leap-applied",
            "quorum-failed",
            "divergence-detected",
            "misbehavior-proof-captured"
          ],
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "event_id": {
          "description": "Stable id (UUID recommended).",
          "type": "string"
        },
        "event_version": {
          "pattern": "^0\\.\\d+$",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": false,
          "properties": {
            "time_sync_receipt_digest": {
              "type": "string"
            },
            "time_sync_snapshot_digest": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "kind": {
          "const": "time-event"
        },
        "metrics": {
          "additionalProperties": false,
          "properties": {
            "authenticated": {
              "type": "boolean"
            },
            "offset_ms": {
              "description": "offset_ms in milliseconds. Use a decimal string, not a JSON number, so hash-bound time evidence stays restricted-JCS/I-JSON canonicalization-admissible.",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            "reference_source_id": {
              "type": "string"
            },
            "step_ms": {
              "description": "step_ms in milliseconds. Use a decimal string, not a JSON number, so hash-bound time evidence stays restricted-JCS/I-JSON canonicalization-admissible.",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            "stratum": {
              "maximum": 16,
              "minimum": 0,
              "type": "integer"
            },
            "uncertainty_ms": {
              "description": "uncertainty_ms in milliseconds. Use a decimal string, not a JSON number, so hash-bound time evidence stays restricted-JCS/I-JSON canonicalization-admissible.",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error",
            "critical"
          ],
          "type": "string"
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "host_id": {
              "type": "string"
            },
            "name": {
              "description": "Producer name (timed, chronyd, ptpd, etc.).",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "subject": {
          "additionalProperties": false,
          "properties": {
            "host_id": {
              "type": "string"
            }
          },
          "required": [
            "host_id"
          ],
          "type": "object"
        }
      },
      "required": [
        "kind",
        "event_version",
        "event_id",
        "at",
        "source",
        "severity",
        "subject",
        "action"
      ],
      "type": "object"
    }
  ],
  "title": "DeriveBSD time event (time.event) (v0.1)"
}
