{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "host": {
      "additionalProperties": false,
      "properties": {
        "generation_digest": {
          "type": "string"
        },
        "host_id": {
          "type": "string"
        }
      },
      "required": [
        "host_id",
        "generation_digest"
      ],
      "type": "object"
    },
    "inputs": {
      "additionalProperties": false,
      "properties": {
        "inventory_digest": {
          "type": "string"
        },
        "plan_digest": {
          "type": "string"
        },
        "proof_bundle_digest": {
          "type": "string"
        },
        "requirement_digest": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "kind": {
      "const": "time-sync-snapshot"
    },
    "snapshot_id": {
      "description": "Stable id for this snapshot (UUID recommended).",
      "type": "string"
    },
    "snapshot_version": {
      "pattern": "^0\\.\\d+$",
      "type": "string"
    },
    "status": {
      "additionalProperties": false,
      "properties": {
        "authenticated": {
          "type": "boolean"
        },
        "last_step_at": {
          "format": "date-time",
          "type": "string"
        },
        "last_step_ms": {
          "description": "last_step_ms in milliseconds. Use a decimal string, not a JSON number, so hash-bound time evidence stays restricted-JCS/I-JSON canonicalization-admissible.",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        "last_sync_at": {
          "format": "date-time",
          "type": "string"
        },
        "leap": {
          "default": "unknown",
          "enum": [
            "none",
            "pending",
            "insert",
            "delete",
            "unknown"
          ],
          "type": "string"
        },
        "lkgt_source": {
          "description": "Where LKGT was sourced from (e.g., tpm_nv, sealed_file, state_dataset).",
          "type": "string"
        },
        "lkgt_time": {
          "description": "Last-known-good time (monotonic wall time floor) if enforced by policy.",
          "format": "date-time",
          "type": "string"
        },
        "offset_ms": {
          "description": "Estimated current clock offset in milliseconds. Use a decimal string, not a JSON number, so hash-bound time evidence stays restricted-JCS/I-JSON canonicalization-admissible.",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        "reference_source_id": {
          "type": "string"
        },
        "rtt_ms": {
          "description": "rtt_ms in milliseconds. Use a decimal string, not a JSON number, so hash-bound time evidence stays restricted-JCS/I-JSON canonicalization-admissible.",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        "state": {
          "enum": [
            "synced",
            "degraded",
            "unsynced"
          ],
          "type": "string"
        },
        "stratum": {
          "maximum": 16,
          "minimum": 0,
          "type": "integer"
        },
        "uncertainty_ms": {
          "description": "Estimated uncertainty bound in milliseconds. Use a decimal string, not a JSON number, so hash-bound time evidence stays restricted-JCS/I-JSON canonicalization-admissible.",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    }
  },
  "required": [
    "kind",
    "snapshot_version",
    "created_at",
    "host",
    "status"
  ],
  "title": "DeriveBSD time sync snapshot (time.sync.snapshot) (v0.1)",
  "type": "object"
}
