{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD microVM launch receipt (microvm.launch.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "host",
    "plan_id",
    "plan_digest",
    "policy_digest",
    "runtime_manifest_digest",
    "instance",
    "outcome"
  ],
  "properties": {
    "kind": {
      "const": "microvm.launch.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string",
      "description": "Stable id for this receipt (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "required": [
        "host_id",
        "generation_digest"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "generation_digest": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "plan_id": {
      "type": "string",
      "description": "Id of the plan submission executed (not the content identity)."
    },
    "plan_digest": {
      "type": "string",
      "description": "Digest of the executed microvm.launch.plan (sha256 of UTF-8 bytes of JCS-canonicalized plan JSON; `sha256:<hex>`)."
    },
    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) used during authorization/enforcement."
    },
    "runtime_manifest_digest": {
      "type": "string"
    },
    "artifact_digest": {
      "type": "string"
    },
    "instance": {
      "type": "object",
      "required": [
        "instance_id"
      ],
      "properties": {
        "instance_id": {
          "type": "string"
        },
        "backend": {
          "type": "string",
          "description": "Backend selected (bhyve, firecracker, qemu, ...)."
        },
        "backend_instance_id": {
          "type": "string",
          "description": "Optional backend id (vm name, vmm id, socket path, ...)."
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "launched",
        "denied",
        "failed",
        "already-running"
      ]
    },
    "assigned": {
      "type": "object",
      "description": "Optional actual resources/attachments after policy enforcement.",
      "properties": {
        "resources": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "integer",
              "minimum": 1
            },
            "mem_mb": {
              "type": "integer",
              "minimum": 16
            }
          },
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none",
                "vsock-only",
                "vnet"
              ]
            },
            "vsock_cid": {
              "type": "integer",
              "minimum": 3
            },
            "ifname": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "io_channels": {
          "type": "array",
          "description": "Optional list of host\u2194guest IO channels attached for this instance (evidence; endpoints are not stable identity).",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "role",
                  "guest_cid",
                  "port"
                ],
                "properties": {
                  "kind": {
                    "const": "vsock"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "control",
                      "console",
                      "logs",
                      "metrics",
                      "debug"
                    ]
                  },
                  "guest_cid": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Guest context identifier (CID) as seen from the host."
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "role",
                  "name"
                ],
                "properties": {
                  "kind": {
                    "const": "virtio-console"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "control",
                      "console",
                      "logs",
                      "metrics",
                      "debug"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Backend-specific port name/label."
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "role",
                  "path"
                ],
                "properties": {
                  "kind": {
                    "const": "nmdm"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "control",
                      "console",
                      "logs",
                      "metrics",
                      "debug"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Host device path (e.g., /dev/nmdmXA)."
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "role"
                ],
                "properties": {
                  "kind": {
                    "const": "stdio"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "control",
                      "console",
                      "logs",
                      "metrics",
                      "debug"
                    ]
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "related": {
      "type": "array",
      "description": "Optional pointers to receipts/evidence produced or consulted during launch (lease.use.receipt, secret.receipt, trace grants, ...).",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "digest"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "description": "Optional signature over this receipt envelope.",
      "properties": {
        "sig_alg": {
          "type": "string"
        },
        "public_key_hint": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "denied",
              "failed"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "reasons"
        ],
        "properties": {
          "reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
