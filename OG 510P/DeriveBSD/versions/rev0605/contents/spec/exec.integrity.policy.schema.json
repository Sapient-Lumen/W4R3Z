{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD exec integrity policy (exec.integrity.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "created_at",
    "scopes"
  ],
  "properties": {
    "kind": {
      "const": "exec.integrity.policy"
    },
    "policy_version": {
      "type": "string",
      "const": "0.1"
    },
    "policy_id": {
      "type": "string",
      "description": "Stable id (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "default_mode": {
      "type": "string",
      "enum": [
        "off",
        "warn",
        "enforce"
      ],
      "default": "enforce"
    },
    "backend_preference": {
      "type": "array",
      "description": "Preferred enforcement backends in order.",
      "items": {
        "type": "string",
        "enum": [
          "mac_veriexec",
          "broker",
          "none"
        ]
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "subject",
          "allowed_sources"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "subject": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "host",
                  "service",
                  "appvm",
                  "builder"
                ]
              },
              "selector": {
                "type": "string",
                "description": "Policy-defined selector (service name, vm id, pattern)."
              }
            },
            "additionalProperties": false
          },
          "mode": {
            "type": "string",
            "enum": [
              "off",
              "warn",
              "enforce"
            ]
          },
          "allowed_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "store-only",
                "signed-bundle",
                "breakglass-only",
                "policy-allowlisted"
              ]
            }
          },
          "deny_if_quarantined": {
            "type": "boolean",
            "default": true,
            "description": "Deny execution of bytes marked with origin/quarantine metadata unless explicitly excepted."
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "value",
                "reason"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "path",
                    "digest",
                    "class"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "ttl_seconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "reason": {
                  "type": "string"
                },
                "approvals": {
                  "type": "array",
                  "description": "Optional approval receipts (digests) backing this exception.",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "description": "Authoritative desired execution-integrity policy. This is the preferred reviewed object for new work."
}
