{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Boot Attestation (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "attestation_version",
    "subject",
    "attester",
    "tpm",
    "verified",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "boot-attestation"
    },
    "attestation_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "subject": {
      "type": "object",
      "required": [
        "deployment_ref_digest"
      ],
      "properties": {
        "deployment_ref_digest": {
          "type": "string",
          "description": "Digest of deployment.ref (e.g., sha256:...)"
        },
        "boot_manifest_digest": {
          "type": "string",
          "description": "Digest of boot.manifest (optional in v0)"
        },
        "namespace": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "attester": {
      "type": "object",
      "required": [
        "host_identity_key_id"
      ],
      "properties": {
        "host_identity_key_id": {
          "type": "string"
        },
        "ak_key_id": {
          "type": "string",
          "description": "Attestation Key id (AK) if distinct from host identity."
        },
        "endorsements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional endorsement digests/pointers."
        }
      },
      "additionalProperties": false
    },
    "tpm": {
      "type": "object",
      "required": [
        "pcr_bank",
        "pcrs",
        "quote",
        "eventlog_digest"
      ],
      "properties": {
        "pcr_bank": {
          "type": "string",
          "description": "e.g., sha256"
        },
        "pcrs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "value"
            ],
            "properties": {
              "index": {
                "type": "integer"
              },
              "value": {
                "type": "string",
                "description": "Hex-encoded PCR value."
              }
            },
            "additionalProperties": false
          }
        },
        "quote": {
          "type": "object",
          "required": [
            "alg",
            "pcr_selection",
            "quoted",
            "sig"
          ],
          "properties": {
            "alg": {
              "type": "string",
              "description": "Signature algorithm."
            },
            "pcr_selection": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "quoted": {
              "type": "string",
              "description": "Quote body bytes (encoding policy-defined)."
            },
            "sig": {
              "type": "string",
              "description": "Quote signature bytes (encoding policy-defined)."
            }
          },
          "additionalProperties": false
        },
        "eventlog_digest": {
          "type": "string",
          "description": "Digest of canonicalized measured boot event log (typically the digest of boot.eventlog.canon)."
        },
        "eventlog_canon": {
          "type": "string",
          "description": "Identifier for the canonicalization ruleset used to compute eventlog_digest (should match boot.manifest.measurement.eventlog_canon when present)."
        }
      },
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "description": "Optional trustworthy time evidence pointers.",
      "properties": {
        "time_evidence_digest": {
          "type": "string"
        },
        "clock_source": {
          "type": "string",
          "enum": [
            "rtc",
            "ntp",
            "roughtime",
            "manual"
          ]
        }
      },
      "additionalProperties": false
    },
    "issued_at": {
      "type": "string",
      "description": "ISO8601 time."
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    },
    "verified": {
      "type": "object",
      "required": [
        "kernel_digest",
        "kernel_modules_digest",
        "kmod_policy_digest",
        "boot_override_policy_digest"
      ],
      "properties": {
        "loader_digest": {
          "type": "string"
        },
        "kernel_digest": {
          "type": "string"
        },
        "kernel_modules_digest": {
          "type": "string"
        },
        "kmod_policy_digest": {
          "type": "string"
        },
        "boot_override_policy_digest": {
          "type": "string"
        },
        "override_receipt_digest": {
          "type": "string",
          "description": "Digest of boot.override.receipt when mutable overrides were used."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
