{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Cache Witness Statement (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "statement_version",
    "inputs",
    "artifact_digest",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "cache-witness-statement"},
    "statement_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "inputs": {
      "type": "object",
      "required": ["plan_digest", "target_kind", "builder_abi"],
      "properties": {
        "plan_digest": {"type": "string"},
        "target_kind": {"type": "string", "description": "e.g., package, host-generation, microvm-bundle, toolchain-bundle"},
        "builder_abi": {"type": "string", "description": "Build ABI contract identifier."},

        "closure_proof_digest": {"type": "string"},
        "toolchain_bundle_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "artifact_digest": {"type": "string", "description": "Digest of the produced artifact bytes."},

    "witness": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "group": {"type": "string", "description": "Optional witness group name."}
      },
      "additionalProperties": false
    },

    "build_record_digest": {"type": "string", "description": "Optional build record / buildinfo digest."},

    "issued_at": {"type": "string", "description": "ISO8601 time."},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string", "description": "Signature over canonical JSON bytes."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
