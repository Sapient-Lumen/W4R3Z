{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Removable media local post-detach transition witness capsule",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "capsule_id",
    "generated_for_version",
    "lane",
    "model_bindings",
    "traces",
    "invariants",
    "negative_fixture_policy"
  ],
  "properties": {
    "kind": {"const": "removable.media.local.post_detach.transition.witness.capsule"},
    "schema_version": {"const": "1.0"},
    "capsule_id": {"$ref": "#/$defs/identifier"},
    "generated_for_version": {"const": "2026-05-30r523"},
    "lane": {"$ref": "#/$defs/lane"},
    "model_bindings": {
      "type": "object",
      "required": [
        "state_machine_manifest_computed_digest",
        "scenario_replay_manifest_computed_digest",
        "enforcement_ledger_receipt_computed_digest",
        "fresh_authority_recovery_receipt_computed_digest",
        "support_projection_computed_digest",
        "backend_evidence_computed_digest",
        "canonical_digest_rule"
      ],
      "properties": {
        "state_machine_manifest_computed_digest": {"$ref": "#/$defs/sha256Digest"},
        "scenario_replay_manifest_computed_digest": {"$ref": "#/$defs/sha256Digest"},
        "enforcement_ledger_receipt_computed_digest": {"$ref": "#/$defs/sha256Digest"},
        "fresh_authority_recovery_receipt_computed_digest": {"$ref": "#/$defs/sha256Digest"},
        "support_projection_computed_digest": {"$ref": "#/$defs/sha256Digest"},
        "backend_evidence_computed_digest": {"$ref": "#/$defs/sha256Digest"},
        "canonical_digest_rule": {"const": "json-sort-keys-compact-utf8-sha256"}
      },
      "additionalProperties": false
    },
    "traces": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/trace"}
    },
    "invariants": {
      "type": "object",
      "required": [
        "every_scenario_has_trace",
        "trace_steps_are_monotonic",
        "trace_transitions_name_known_states",
        "terminal_outcomes_match_replay_manifest",
        "expired_roots_are_never_observable",
        "successor_recovery_never_resurrects_expired_root",
        "idempotent_replay_does_not_double_debit",
        "support_visibility_stays_digest_only",
        "witness_outcome_digests_are_computed"
      ],
      "properties": {
        "every_scenario_has_trace": {"const": true},
        "trace_steps_are_monotonic": {"const": true},
        "trace_transitions_name_known_states": {"const": true},
        "terminal_outcomes_match_replay_manifest": {"const": true},
        "expired_roots_are_never_observable": {"const": true},
        "successor_recovery_never_resurrects_expired_root": {"const": true},
        "idempotent_replay_does_not_double_debit": {"const": true},
        "support_visibility_stays_digest_only": {"const": true},
        "witness_outcome_digests_are_computed": {"const": true}
      },
      "additionalProperties": false
    },
    "negative_fixture_policy": {"const": "known-bad-post-detach-transition-witness-shapes-must-fail-validation"}
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,159}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lane": {
      "type": "object",
      "required": ["family", "phase", "identity_policy"],
      "properties": {
        "family": {"const": "removable-media-local-fallback"},
        "phase": {"const": "post-detach"},
        "identity_policy": {"const": "family-normalized-phase-by-kind"}
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "required": [
        "scenario_id",
        "trace_id",
        "initial_state",
        "steps",
        "terminal_state",
        "expected_replay_terminal_state",
        "allowed_actions",
        "fresh_authority_required",
        "rate_limit_debit_count",
        "support_visibility",
        "expired_root_observable",
        "successor_root_only",
        "double_debit_prevented",
        "outcome_digest"
      ],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/identifier"},
        "trace_id": {"$ref": "#/$defs/identifier"},
        "initial_state": {"$ref": "#/$defs/identifier"},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "terminal_state": {
          "enum": [
            "expired-root-denied",
            "fail-closed-typed-denial",
            "successor-root-admitted",
            "idempotent-denial-replayed"
          ]
        },
        "expected_replay_terminal_state": {
          "enum": [
            "expired-root-denied",
            "fail-closed-typed-denial",
            "successor-root-admitted",
            "idempotent-denial-replayed"
          ]
        },
        "allowed_actions": {"$ref": "#/$defs/actions"},
        "fresh_authority_required": {"type": "boolean"},
        "rate_limit_debit_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "support_visibility": {"enum": ["support-safe-digest-only"]},
        "expired_root_observable": {"type": "boolean"},
        "successor_root_only": {"type": "boolean"},
        "double_debit_prevented": {"type": "boolean"},
        "outcome_digest": {"$ref": "#/$defs/sha256Digest"}
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "step_index",
        "event",
        "from_state",
        "to_state",
        "required_receipt_kind",
        "receipt_digest",
        "allowed_actions_after_step",
        "rate_limit_action",
        "idempotency_effect",
        "time_posture"
      ],
      "properties": {
        "step_index": {"type": "integer", "minimum": 1},
        "event": {
          "enum": [
            "observe-after-expiry-attempt",
            "load-expiry-receipt",
            "commit-enforcement-ledger",
            "emit-support-projection",
            "collect-backend-evidence",
            "request-fresh-authority",
            "consume-fresh-authority-once",
            "cutover-successor-root",
            "admit-successor-reader",
            "replay-same-idempotency-key",
            "detect-missing-expiry-receipt",
            "detect-rollback-or-stale-root",
            "detect-degraded-clock"
          ]
        },
        "from_state": {"$ref": "#/$defs/identifier"},
        "to_state": {"$ref": "#/$defs/identifier"},
        "required_receipt_kind": {"type": "string", "pattern": "^[a-z0-9_.]+$"},
        "receipt_digest": {"$ref": "#/$defs/sha256Digest"},
        "allowed_actions_after_step": {"$ref": "#/$defs/actions"},
        "rate_limit_action": {"enum": ["not-applicable", "debited-once", "replayed-no-new-debit"]},
        "idempotency_effect": {"enum": ["not-applicable", "new-attempt", "same-denial-replayed"]},
        "time_posture": {"enum": ["trusted-order", "degraded-fail-closed", "not-time-sensitive"]}
      },
      "additionalProperties": false
    },
    "actions": {
      "type": "object",
      "required": ["observe", "export", "rehydrate"],
      "properties": {
        "observe": {"type": "boolean"},
        "export": {"type": "boolean"},
        "rehydrate": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
