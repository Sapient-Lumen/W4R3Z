{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Log Checkpoint Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "authority_semantics",
    "log_id",
    "checkpoint",
    "log_signature",
    "witness_signatures",
    "witness_policy_digest",
    "quorum_verdict",
    "issued_at"
  ],
  "properties": {
    "kind": {
      "const": "log-checkpoint-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "authority_semantics": {
      "const": "checkpoint-evidence-only",
      "description": "Checkpoint receipts prove witnessed log state and never replace publication authority."
    },
    "log_id": {
      "type": "string",
      "description": "Opaque log identity (name or key digest)."
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "tree_size",
        "root_hash"
      ],
      "properties": {
        "tree_size": {
          "type": "integer",
          "minimum": 0
        },
        "root_hash": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "description": "Optional log timestamp (ISO8601 or log-native)."
        }
      },
      "additionalProperties": false
    },
    "log_signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "witness_signatures": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "witness_id",
          "alg",
          "sig"
        ],
        "properties": {
          "witness_id": {
            "type": "string"
          },
          "alg": {
            "type": "string"
          },
          "sig": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "consistency_proof_digest": {
      "type": "string",
      "description": "Optional digest of consistency proof material."
    },
    "context": {
      "type": "object",
      "description": "Optional binding to DeriveBSD objects (artifact/statement).",
      "properties": {
        "artifact_digest": {
          "type": "string"
        },
        "statement_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "issued_at": {
      "type": "string",
      "description": "ISO8601 time."
    },
    "witness_policy_digest": {
      "type": "string",
      "description": "Digest of the governing witness.policy used to evaluate the witness signatures on this checkpoint."
    },
    "quorum_verdict": {
      "type": "string",
      "enum": [
        "satisfied",
        "shortfall",
        "not-applicable"
      ],
      "description": "Local verdict for the referenced witness.policy; receipts do not silently change witness trust policy."
    }
  },
  "additionalProperties": false
}
