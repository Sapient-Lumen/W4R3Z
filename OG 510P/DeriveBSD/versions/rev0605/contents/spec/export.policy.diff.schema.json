{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD export policy diff (export.policy.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_policy",
    "to_policy",
    "consent_changed",
    "recipients_changed",
    "encryption_changed",
    "lease_required_changed",
    "transport_policy_digest_changed",
    "transparency_changed",
    "rules_added",
    "rules_removed",
    "rules_changed"
  ],
  "properties": {
    "kind": { "const": "export.policy.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation/export surface).",
      "properties": {
        "host_id": { "type": "string" },
        "profile_id": { "type": "string", "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)." },
        "generation_id": { "type": "string" },
        "export_surface": { "type": "string", "description": "Optional label for the export surface (support bundles, crash uploads, customer handoff, ...)." }
      },
      "additionalProperties": false
    },

    "from_policy": { "$ref": "#/$defs/policy_ref" },
    "to_policy": { "$ref": "#/$defs/policy_ref" },

    "consent_changed": {
      "type": "object",
      "description": "Consent/approval posture drift.",
      "properties": {
        "interactive": { "$ref": "#/$defs/bool_change" },
        "two_person": { "$ref": "#/$defs/bool_change" },
        "approvers_added": { "type": "array", "items": { "type": "string" } },
        "approvers_removed": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "recipients_changed": {
      "type": "object",
      "description": "Recipient constraints drift (who may receive the export).",
      "properties": {
        "class": { "$ref": "#/$defs/string_change" },
        "identifiers_added": { "type": "array", "items": { "type": "string" } },
        "identifiers_removed": { "type": "array", "items": { "type": "string" } },
        "require_ticket": { "$ref": "#/$defs/bool_change" },
        "ticket_pattern": { "$ref": "#/$defs/string_change" }
      },
      "additionalProperties": false
    },

    "encryption_changed": {
      "type": "object",
      "description": "Encryption posture drift.",
      "properties": {
        "mode": { "$ref": "#/$defs/string_change" },
        "recipients_added": { "type": "array", "items": { "type": "string" } },
        "recipients_removed": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "lease_required_changed": { "$ref": "#/$defs/bool_change" },

    "transport_policy_digest_changed": { "$ref": "#/$defs/string_change" },

    "transparency_changed": {
      "type": "object",
      "description": "Transparency logging requirements drift.",
      "properties": {
        "mode": { "$ref": "#/$defs/string_change" },
        "required": { "$ref": "#/$defs/bool_change" },
        "log_uri": { "$ref": "#/$defs/string_change" },
        "metadata_profile": { "$ref": "#/$defs/string_change" },
        "hash_ticket_id": { "$ref": "#/$defs/bool_change" },
        "hash_recipient": { "$ref": "#/$defs/bool_change" }
      },
      "additionalProperties": false
    },

    "rules_added": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "rules_removed": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "rules_changed": { "type": "array", "items": { "$ref": "#/$defs/rule_change" } },

    "summary": {
      "type": "object",
      "description": "Optional human/policy summary fields.",
      "properties": {
        "rules_added": { "type": "integer", "minimum": 0 },
        "rules_removed": { "type": "integer", "minimum": 0 },
        "rules_changed": { "type": "integer", "minimum": 0 },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "policy_ref": {
      "type": "object",
      "description": "Reference to an export.policy object by digest (and optional human fields).",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "policy_id": { "type": "string" },
        "policy_version": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "bool_change": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "boolean" },
        "to": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "string_change": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": ["string", "null"] },
        "to": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },

    "rule": {
      "type": "object",
      "required": ["artifact_kind"],
      "properties": {
        "artifact_kind": { "type": "string" },
        "redaction_transform_digest": { "type": "string" },
        "allow_metadata_only": { "type": "boolean", "default": true },
        "allow_raw_blobs": { "type": "boolean", "default": false },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "rule_change": {
      "type": "object",
      "required": ["artifact_kind", "from", "to"],
      "properties": {
        "artifact_kind": { "type": "string" },
        "from": { "$ref": "#/$defs/rule" },
        "to": { "$ref": "#/$defs/rule" },
        "classification": {
          "type": "string",
          "enum": ["redaction", "allow_raw_blobs", "allow_metadata_only", "notes", "multiple", "other"]
        },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
