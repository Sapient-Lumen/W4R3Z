{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD causality graph (causality.graph) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "graph_version",
    "created_at",
    "roots",
    "nodes",
    "edges"
  ],
  "properties": {
    "kind": { "const": "causality-graph" },
    "graph_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "graph_id": { "type": "string", "description": "Stable id (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "context": {
      "type": "object",
      "description": "Optional correlation context.",
      "properties": {
        "host_id": { "type": "string" },
        "generation_digest": { "type": "string" },
        "change_id": { "type": "string" },
        "incident_id": { "type": "string" },
        "trace_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "roots": {
      "type": "array",
      "minItems": 1,
      "description": "Starting points for traversal (trigger objects).",
      "items": { "type": "string" }
    },

    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["digest", "kind"],
        "properties": {
          "digest": { "type": "string" },
          "kind": { "type": "string" },
          "label": { "type": "string" },
          "at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },

    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "rel"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "rel": {
            "type": "string",
            "enum": [
              "derived-from",
              "triggered",
              "supersedes",
              "rolled-back-to",
              "references"
            ]
          },
          "detail": { "type": "string" },
          "at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },

    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
