{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD devfs view drift diff (devfs.view.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_plan",
    "to_plan",
    "baseline_from",
    "baseline_to",
    "rules_added",
    "rules_removed",
    "rules_changed"
  ],
  "properties": {
    "kind": { "const": "devfs.view.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation/domain).",
      "properties": {
        "host_id": { "type": "string" },
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "domain_kind": { "type": "string", "enum": ["host", "jail", "microvm"] },
        "domain_id": { "type": "string" },
        "service_id": { "type": "string" },
        "from_generation": { "type": "string" },
        "to_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "from_plan": { "$ref": "#/$defs/plan_ref" },
    "to_plan": { "$ref": "#/$defs/plan_ref" },

    "baseline_from": {
      "type": "string",
      "enum": ["service-minimal", "interactive-minimal", "empty"],
      "description": "Baseline /dev posture from the older plan."
    },
    "baseline_to": {
      "type": "string",
      "enum": ["service-minimal", "interactive-minimal", "empty"],
      "description": "Baseline /dev posture from the newer plan."
    },

    "rules_added": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "rules_removed": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "rules_changed": { "type": "array", "items": { "$ref": "#/$defs/rule_change" } },

    "summary": {
      "type": "object",
      "properties": {
        "added": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 },
        "baseline_changed": { "type": "boolean" },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "plan_ref": {
      "type": "object",
      "description": "Reference to a devfs.view.plan object by digest (and optional human fields).",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "plan_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "rules_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "rule": {
      "type": "object",
      "required": ["action", "path"],
      "properties": {
        "action": { "type": "string", "enum": ["hide", "unhide", "perm"] },
        "path": { "type": "string" },
        "uid": { "type": "integer", "minimum": 0 },
        "gid": { "type": "integer", "minimum": 0 },
        "mode": { "type": "string", "pattern": "^[0-7]{3,4}$" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "rule_change": {
      "type": "object",
      "required": ["path", "from", "to", "classification"],
      "properties": {
        "path": { "type": "string" },
        "from": { "$ref": "#/$defs/rule" },
        "to": { "$ref": "#/$defs/rule" },
        "classification": { "type": "string", "enum": ["action", "perm", "both", "other"] },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
