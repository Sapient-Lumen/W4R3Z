{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD multi-step change set (change-set) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "set_version",
    "created_at",
    "target",
    "steps"
  ],
  "properties": {
    "kind": {
      "const": "change-set"
    },
    "set_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "change_id": {
      "type": "string",
      "description": "Stable id for the change (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "generation_id"
      ],
      "properties": {
        "generation_id": {
          "type": "string"
        },
        "boot_environment": {
          "type": "string",
          "description": "Optional BE name/id that will be switched to or validated."
        },
        "host_id": {
          "type": "string",
          "description": "Optional host identity label for binding (policy input)."
        }
      }
    },
    "confirm": {
      "type": "object",
      "description": "Optional commit-confirmed latch at the change level.",
      "properties": {
        "required": {
          "type": "boolean",
          "default": false
        },
        "timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "authority": {
          "type": "object",
          "description": "Optional reference to a capability/grant required to confirm.",
          "properties": {
            "kind": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "op"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "op": {
            "type": "string",
            "enum": [
              "apply-config",
              "apply-firmware",
              "apply-resource-policy",
              "apply-secrets",
              "apply-pki",
              "apply-exec-integrity",
              "commit",
              "emit-bundle",
              "health-check",
              "reconcile-services",
              "require-attestation",
              "require-time-sync",
              "rollback",
              "run-migrations",
              "run-storage-scrub",
              "snapshot"
            ]
          },
          "refs": {
            "type": "array",
            "description": "References to component plans/objects by digest.",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "digest"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "digest": {
                  "type": "string"
                },
                "store_path": {
                  "type": "string"
                }
              }
            }
          },
          "timeout_sec": {
            "type": "integer",
            "minimum": 1
          },
          "on_failure": {
            "type": "string",
            "enum": [
              "abort",
              "rollback",
              "continue"
            ],
            "default": "rollback"
          },
          "notes": {
            "type": "string"
          },
          "debug": {
            "type": "object",
            "description": "Optional record/replay capture hook for this step.",
            "properties": {
              "trigger": {
                "type": "string",
                "enum": [
                  "on-failure",
                  "always"
                ],
                "default": "on-failure"
              },
              "grant_ref": {
                "type": "object",
                "description": "Reference to a debug.record.grant object by digest.",
                "required": [
                  "kind",
                  "digest"
                ],
                "properties": {
                  "kind": {
                    "const": "debug.record.grant"
                  },
                  "digest": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "include_capsule_in_incident_bundle": {
                "type": "boolean",
                "default": false
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "description": "Rollback hints (the apply engine may still choose the safest rollback).",
      "properties": {
        "previous_generation_id": {
          "type": "string"
        },
        "rollback_be": {
          "type": "string"
        },
        "state_hold_tag": {
          "type": "string",
          "description": "Optional ZFS hold tag used to protect pre-change snapshots."
        }
      }
    }
  }
}
