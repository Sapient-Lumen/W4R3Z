{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD PKI Issue Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "identity_id",
    "captured_at",
    "outcome",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "pki-issue-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "identity_id": {
      "type": "string"
    },
    "plan_digest": {
      "type": "string",
      "description": "Optional digest of the pki-issue-plan that triggered this receipt."
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "issued",
        "renewed",
        "revoked",
        "failed",
        "skipped"
      ]
    },
    "provider": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "cert": {
      "type": "object",
      "properties": {
        "serial": {
          "type": "string"
        },
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "not_after": {
          "type": "string",
          "format": "date-time"
        },
        "spki_fingerprint": {
          "type": "string",
          "description": "SPKI fingerprint of the issued certificate public key (metadata only)."
        },
        "chain_digests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Digests of certificate chain objects stored in the Derive store."
        }
      },
      "additionalProperties": false
    },
    "correlation": {
      "type": "object",
      "properties": {
        "change_set_digest": {
          "type": "string"
        },
        "lease_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
