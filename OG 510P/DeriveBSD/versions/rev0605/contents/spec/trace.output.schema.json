{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD trace output metadata (trace.output) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "output_version",
    "created_at",
    "session_digest",
    "format",
    "blob_digest"
  ],
  "properties": {
    "kind": {
      "const": "trace.output"
    },
    "output_version": {
      "type": "string",
      "const": "0.1"
    },
    "output_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_digest": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "blob_digest": {
      "type": "string",
      "description": "Digest of the stored payload blob (may be compressed/encrypted)."
    },
    "compression": {
      "type": "string"
    },
    "encryption": {
      "type": "string"
    },
    "redaction_transform_digest": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
