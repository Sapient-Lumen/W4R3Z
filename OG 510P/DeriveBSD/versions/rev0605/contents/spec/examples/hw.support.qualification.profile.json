  },
  "required_checks": [
    {
      "check_id": "inventory-baseline",
      "purpose": "inventory-baseline",
      "accepted_evidence_kinds": [
        "hw.inventory.receipt"
      ],
      "blocking": true,
      "notes": "A privacy-bounded inventory baseline must anchor every support claim."
    },
    {
      "check_id": "boot-smoke",
      "purpose": "boot",
      "accepted_evidence_kinds": [
        "lab.run.summary",
        "hw.compat.report"
      ],
      "required_roles": [
        "boot-storage"
      ],
      "blocking": true,
      "notes": "Boot-critical storage classes need a direct boot-success check, not only a module-presence claim."
    },
    {
      "check_id": "generation-switch-rehearsal",
      "purpose": "generation-switch",
      "accepted_evidence_kinds": [
        "hw.compat.report",
        "lab.run.summary"
      ],
      "blocking": true,
      "notes": "Positive support claims must survive the actual target generation switch lane."
    },
    {
      "check_id": "network-basic",
      "purpose": "network-basic",
      "accepted_evidence_kinds": [
        "hw.compat.report",
        "lab.run.summary"
      ],
      "required_roles": [
        "primary-network",
        "maintenance-network"
      ],
      "blocking": true,
      "notes": "Network-bearing support claims must prove basic connectivity on the target train."
    },
    {
      "check_id": "trusted-ui-basic",
      "purpose": "trusted-ui-basic",
      "accepted_evidence_kinds": [
        "ui.secure_attention.receipt",
        "lab.run.summary"
      ],
      "required_profiles": [
        "B"
      ],
      "required_roles": [
        "trusted-display",
        "trusted-input"
      ],
      "blocking": true,
      "notes": "Workstation trusted-display/input claims need a trusted-UI-visible check."
    },
    {
      "check_id": "rollback-recovery",
      "purpose": "rollback-or-recovery",
      "accepted_evidence_kinds": [
        "restore-drill-receipt",
        "bundle.build.receipt"
      ],
      "required_profiles": [
        "B",
        "D"
      ],
      "required_roles": [
        "boot-storage",
        "trusted-display",
        "trusted-input"
      ],
      "blocking": true,
      "notes": "B/D boot-floor posture needs a recently verified recovery or rollback path."
    },
    {
      "check_id": "field-watch",
      "purpose": "field-regression-watch",
      "accepted_evidence_kinds": [
        "lab.run.summary",
        "vendor.qualification.bundle"
      ],
      "required_support_levels": [
        "supported"
      ],
      "blocking": false,
      "notes": "Supported claims should have an explicit regression-watch lane even when it is not the initial acceptance blocker."
    }
  ],
  "acceptance": {
    "rule": "all-applicable-blocking-checks-pass",
    "notes": "Applicable checks are selected by support level plus profile/role scope; non-blocking checks inform follow-up watch posture instead of immediate rejection."
  },
  "notes": "This profile is evidence-policy only. It defines the qualification floor but does not prescribe a specific lab runner or runtime control plane.",
  "freshness": {
    "max_age_days_by_stage": {
      "lab-validated": 30,
      "canary-observed": 14,
      "release-qualified": 90,
      "field-sustained": 180
    },
    "reverify_on": [
      "kernel-or-kmod-change",
      "firmware-change",
      "boot-manifest-change",
      "role-regression",
      "qualification-profile-change",
      "recovery-lane-change"
    ],
    "notes": "Freshness stays typed and release-bound: positive support claims stop counting as fresh when the window elapses or when a listed invalidating change lands."
  }
