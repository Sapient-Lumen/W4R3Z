{
  "kind": "derive.unit",
  "unit_version": "0.1",
  "id": "web.nginx",
  "labels": {
    "team": "edge",
    "tier": "frontend",
    "service": "nginx"
  },
  "exec": {
    "argv": [
      "/usr/local/sbin/nginx",
      "-g",
      "daemon off;"
    ],
    "env": {
      "TZ": "UTC"
    },
    "user": "www",
    "group": "www"
  },
  "strata": [
    "base:sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "vendor:sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
  ],
  "mounts": [
    {
      "name": "etc",
      "mode": "ro",
      "target": "/usr/local/etc/nginx",
      "source": "config.snapshot"
    },
    {
      "name": "state",
      "mode": "rw",
      "target": "/var/db/nginx",
      "source": "state.web"
    },
    {
      "name": "cache",
      "mode": "cache",
      "target": "/var/cache/web"
    }
  ],
  "state": {
    "datasets": [
      {
        "name": "state.nginx",
        "schema_version": "2026-02-01",
        "durability": "persistent",
        "backup_class": "required"
      }
    ]
  },
  "promises": [
    "net:egress(web)",
    "fs:read(config)",
    "fs:write(state)",
    "ipc:portal(dns)"
  ],
  "health": {
    "http": {
      "path": "/healthz",
      "port": 8443
    }
  },
  "evidence_hooks": {
    "events": true,
    "logs": "structured",
    "redaction_class": "service"
  },
  "diagnostics": {
    "inspect": true,
    "flight_recorder": {
      "enabled": true,
      "buffer_bytes": 8388608,
      "max_window_seconds": 120,
      "categories": [
        "rpc",
        "retries",
        "latency"
      ]
    },
    "redaction_class": "internal"
  },
  "pki": {
    "trust_bundle_digests": [
      "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    ],
    "identity_refs": [
      "service:web:tls"
    ],
    "ca_bundle": {
      "mode": "fd"
    }
  }
}
