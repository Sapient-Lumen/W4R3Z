{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Policy Decision Record (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "decision_version",
    "lock_digest",
    "engine",
    "inputs",
    "decision",
    "effective_constraints"
  ],
  "properties": {
    "kind": {
      "const": "policy-decision"
    },
    "decision_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "decision_instance_id": {
      "type": "string",
      "description": "Optional issuance identity for policy decisions that must distinguish independently issuable instances even when other decision content is identical."
    },
    "lock_digest": {
      "type": "string",
      "description": "Digest of the Lock object this decision was evaluated against."
    },
    "engine": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "policy_digest": {
          "type": "string",
          "description": "Optional digest of policy source bundle."
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "description": "Only policy-relevant inputs that could affect decisions.",
      "properties": {
        "vuln_db_digest": {
          "type": "string"
        },
        "allowlist_digest": {
          "type": "string"
        },
        "epoch": {
          "type": "string",
          "description": "Optional logical epoch for time-bounded policies."
        }
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": [
        "allowed"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "deny_code": {
          "type": "string"
        },
        "deny_reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "effective_constraints": {
      "type": "object",
      "description": "The enforceable constraints applied to the plan and runtime.",
      "properties": {
        "network_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "isolated",
              "nat",
              "bridged"
            ]
          }
        },
        "allow_passthrough_devices": {
          "type": "boolean"
        },
        "max_cpu": {
          "type": "integer",
          "minimum": 1
        },
        "max_mem_mb": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "trace": {
      "description": "Stable explanation trace for derive explain-policy. May be a full policy-trace object or a legacy minimal inline trace.",
      "anyOf": [
        {
          "$ref": "policy.trace.schema.json"
        },
        {
          "type": "object",
          "description": "Stable explanation trace for derive explain-policy.",
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "result"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "allow",
                      "deny",
                      "note"
                    ]
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "trace_digest": {
      "type": "string",
      "description": "Optional digest of a separately stored policy-trace object (see policy.trace.schema.json)."
    }
  },
  "additionalProperties": false
}
