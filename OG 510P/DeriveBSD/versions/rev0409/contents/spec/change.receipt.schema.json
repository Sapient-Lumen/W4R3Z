{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD change execution receipt (change-receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "change_set_digest",
    "started_at",
    "status",
    "steps"
  ],
  "properties": {
    "kind": {
      "const": "change-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "change_id": {
      "type": "string"
    },
    "change_set_digest": {
      "type": "string",
      "description": "Digest of the executed change-set object (e.g., blake3:...)."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "rolled-back",
        "pending-confirm"
      ]
    },
    "confirm": {
      "type": "object",
      "description": "Optional confirmation window metadata when status is pending-confirm (or when a confirmable change was confirmed).",
      "properties": {
        "required": { "type": "boolean" },
        "deadline_at": { "type": "string", "format": "date-time" },
        "timeout_sec": { "type": "integer", "minimum": 1 },
        "confirmed_at": { "type": "string", "format": "date-time" },
        "change_confirm_receipt_digest": { "type": "string", "description": "Digest of a change-confirm-receipt evidence object (if confirmed/rejected)." },
        "auto_revert_at": { "type": "string", "format": "date-time" },
        "auto_revert_reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "op",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "op": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "skipped",
              "failed"
            ]
          },
          "receipts": {
            "type": "array",
            "description": "Digests of emitted receipts (config/state/service/etc).",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "digest"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "digest": {
                  "type": "string"
                }
              }
            }
          },
          "event_refs": {
            "type": "array",
            "description": "Pointers into the structured event journal (segment/event ids).",
            "items": {
              "type": "object",
              "properties": {
                "segment_id": {
                  "type": "string"
                },
                "event_id": {
                  "type": "string"
                }
              }
            }
          },
          "error": {
            "type": "string"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "health_gate": {
      "type": "object",
      "description": "Optional summary of health-gate decision (if executed as part of change).",
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "skipped"
          ]
        },
        "boot_health_report_digest": {
          "type": "string"
        }
      }
    },
    "rollback": {
      "type": "object",
      "description": "Rollback summary when status is rolled-back.",
      "properties": {
        "to_generation_id": {
          "type": "string"
        },
        "to_boot_environment": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
