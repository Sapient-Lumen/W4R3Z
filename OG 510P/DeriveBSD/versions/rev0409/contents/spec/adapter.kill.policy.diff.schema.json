{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD adapter kill policy diff (adapter.kill.policy.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_policy",
    "to_policy",
    "default_mode_changed",
    "adapters_added",
    "adapters_removed",
    "adapters_changed"
  ],
  "properties": {
    "kind": { "const": "adapter.kill.policy.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation/domain).",
      "properties": {
        "host_id": { "type": "string" },
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "domain": { "type": "string", "description": "Optional compartment/domain identifier." },
        "from_generation": { "type": "string" },
        "to_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "from_policy": { "$ref": "#/$defs/policy_ref" },
    "to_policy": { "$ref": "#/$defs/policy_ref" },

    "default_mode_changed": { "$ref": "#/$defs/default_mode_change" },

    "adapters_added": {
      "type": "array",
      "items": { "$ref": "#/$defs/adapter_entry" }
    },
    "adapters_removed": {
      "type": "array",
      "items": { "$ref": "#/$defs/adapter_entry" }
    },
    "adapters_changed": {
      "type": "array",
      "items": { "$ref": "#/$defs/adapter_change" }
    },

    "summary": {
      "type": "object",
      "properties": {
        "adapters_added": { "type": "integer", "minimum": 0 },
        "adapters_removed": { "type": "integer", "minimum": 0 },
        "adapters_changed": { "type": "integer", "minimum": 0 },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "policy_ref": {
      "type": "object",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "policy_version": { "type": "string" },
        "issued_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "default_mode_change": {
      "description": "Default posture drift for unknown adapter ids. Null means unchanged.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string", "enum": ["disabled", "adapter"] },
            "to": { "type": "string", "enum": ["disabled", "adapter"] }
          },
          "additionalProperties": false
        }
      ]
    },

    "adapter_entry": {
      "type": "object",
      "required": ["adapter_id", "mode"],
      "properties": {
        "adapter_id": { "type": "string" },
        "mode": { "type": "string", "enum": ["disabled", "adapter", "shadow", "replace"] },
        "scopes": {
          "type": "array",
          "items": { "type": "string", "enum": ["import", "install", "runtime"] },
          "minItems": 1
        },
        "expires_at": { "type": "string", "format": "date-time" },
        "required_receipts": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "adapter_change": {
      "type": "object",
      "required": ["adapter_id", "from", "to"],
      "properties": {
        "adapter_id": { "type": "string" },
        "from": { "$ref": "#/$defs/adapter_entry" },
        "to": { "$ref": "#/$defs/adapter_entry" },
        "fields_changed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["mode", "scopes", "expires_at", "required_receipts", "reason", "notes"]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
