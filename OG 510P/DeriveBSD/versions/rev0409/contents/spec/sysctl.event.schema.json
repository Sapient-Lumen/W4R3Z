{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD sysctl event (sysctl.event) (v0.1)",
  "allOf": [
    {
      "$ref": "event.record.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "event_version",
        "event_id",
        "at",
        "source",
        "severity",
        "subject",
        "action"
      ],
      "properties": {
        "kind": {
          "const": "sysctl-event"
        },
        "event_version": {
          "type": "string",
          "pattern": "^0\\.\\d+$"
        },
        "event_id": {
          "type": "string",
          "description": "Stable id (UUID recommended)."
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "Emitter name (applier, drift-checker, etc.)."
            },
            "host_id": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error",
            "critical"
          ]
        },
        "subject": {
          "type": "object",
          "required": [
            "host_id"
          ],
          "properties": {
            "host_id": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "action": {
          "type": "string",
          "enum": [
            "applied",
            "drift-detected",
            "write-denied"
          ]
        },
        "plan_digest": {
          "type": "string",
          "description": "Digest of the plan that was intended (optional)."
        },
        "snapshot_digest": {
          "type": "string",
          "description": "Digest of a bounded sysctl.snapshot collected at detection time (optional)."
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              },
              "observed": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "policy_decision_digest": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  ]
}
