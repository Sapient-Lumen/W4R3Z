{
  "kind": "boot.health.gate.policy",
  "policy_version": "0.1",
  "policy_id": "e1e2c4c6-3d71-4e7f-9a0a-2c7d1c1e7c2a",
  "created_at": "2026-02-26T00:00:00Z",

  "success_point": "core_services_healthy",

  "tries": {
    "max_attempts": 3,
    "rollback_on_exhaustion": true,
    "mark_bad_on_required_fail": true
  },

  "checks": [
    {
      "id": "verify.host",
      "class": "required",
      "phase": "post_boot",
      "timeout_s": 120,
      "description": "derive verify-host must succeed for the booted generation."
    },
    {
      "id": "services.core",
      "class": "required",
      "phase": "post_boot",
      "timeout_s": 120,
      "description": "Critical service bundle is online (svcdb snapshot)."
    },
    {
      "id": "state.migrations",
      "class": "required",
      "phase": "post_boot",
      "timeout_s": 180,
      "description": "Required state migrations completed (receipted) or explicitly skipped by policy."
    },
    {
      "id": "time.sync",
      "class": "wanted",
      "phase": "post_boot",
      "timeout_s": 60,
      "description": "Time is within acceptable skew; authenticated time required only when configured."
    },
    {
      "id": "storage.pool_health",
      "class": "wanted",
      "phase": "post_boot",
      "timeout_s": 60,
      "description": "ZFS pool is healthy; recent scrub receipt present if policy requires."
    }
  ],

  "policy": {
    "commit_requires": {
      "min_consecutive_good_boots": 1,
      "max_degraded_wanted": 2
    },
    "rollback": {
      "max_consecutive_bad": 1,
      "cooldown_s": 300
    }
  },

  "notes": "Required checks are small and deterministic; optional checks surface degraded posture without blocking fleet recovery."
}
