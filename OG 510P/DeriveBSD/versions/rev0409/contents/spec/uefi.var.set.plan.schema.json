{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UEFI variable set plan (uefi.var.set.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "operations"
  ],
  "properties": {
    "kind": { "const": "uefi-var-set-plan" },
    "plan_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "plan_id": { "type": "string", "description": "Stable id for the plan (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "requested_by": { "type": "string" },

    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["guid", "name", "op"],
        "properties": {
          "guid": { "type": "string", "description": "UEFI variable namespace GUID." },
          "name": { "type": "string", "description": "UEFI variable name (Unicode presented as UTF-8)." },
          "op": { "type": "string", "enum": ["set", "delete", "append"] },

          "class": {
            "type": "string",
            "description": "Optional coarse classification for policy (used for budgets/approvals).",
            "enum": ["boot", "capsule", "secureboot", "vendor", "other"]
          },

          "attributes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["non-volatile", "boot-service", "runtime", "time-authenticated"]
            }
          },

          "value": {
            "type": "object",
            "description": "Digest-first value representation. Provide inline only for tiny values.",
            "properties": {
              "value_artifact_digest": { "type": "string", "description": "Digest of a blob artifact containing the raw variable bytes." },
              "value_digest": { "type": "string", "description": "Digest of the raw value bytes (when value bytes are not stored in CAS)." },
              "inline_hex": { "type": "string", "description": "Inline hex encoding for small values (optional)." }
            },
            "additionalProperties": false
          },

          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "approvals": {
      "type": "object",
      "properties": {
        "consent_receipt_digests": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "maintenance_lease_digest": { "type": "string" },

    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
