{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD foreign-document disposable-view import receipt profile (content.import.document-view.receipt) (v0.1)",
  "allOf": [
    {
      "$ref": "content.import.receipt.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "content.import.receipt"
        },
        "receipt_version": {
          "const": "0.1"
        },
        "subject": {
          "type": "object",
          "required": [
            "digest",
            "mime",
            "filename"
          ],
          "properties": {
            "mime": {
              "enum": [
                "application/pdf",
                "application/msword",
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                "application/vnd.ms-excel",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                "application/vnd.ms-powerpoint",
                "application/vnd.openxmlformats-officedocument.presentationml.presentation",
                "text/plain"
              ]
            },
            "filename": {
              "type": "string"
            }
          }
        },
        "quarantine": {
          "type": "object",
          "properties": {
            "state": {
              "const": "preserved"
            }
          },
          "required": [
            "state",
            "origin_id",
            "origin_digest",
            "label"
          ]
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "classify"
                  },
                  "status": {
                    "const": "ok"
                  },
                  "tool": {
                    "const": "doc.inspect"
                  }
                },
                "required": [
                  "op",
                  "status",
                  "tool",
                  "output_digest"
                ]
              }
            }
          ]
        },
        "execution": {
          "type": "object",
          "properties": {
            "isolation": {
              "const": "microvm"
            },
            "network": {
              "const": "none"
            },
            "lifetime": {
              "const": "disposable"
            }
          },
          "required": [
            "isolation",
            "network",
            "lifetime"
          ]
        },
        "outputs": {
          "type": "array",
          "contains": {
            "type": "object",
            "properties": {
              "mime": {
                "enum": [
                  "application/pdf",
                  "application/msword",
                  "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                  "application/vnd.ms-excel",
                  "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                  "application/vnd.ms-powerpoint",
                  "application/vnd.openxmlformats-officedocument.presentationml.presentation",
                  "text/plain"
                ]
              },
              "labels": {
                "type": "object",
                "properties": {
                  "trust": {
                    "const": "quarantined"
                  },
                  "class": {
                    "const": "foreign-document"
                  }
                },
                "required": [
                  "trust",
                  "class"
                ]
              }
            },
            "required": [
              "digest",
              "path",
              "mime",
              "labels"
            ]
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "authority": {
              "const": "content.origin-cas+xattr-pointer"
            },
            "transport": {
              "const": "direct-download-import"
            },
            "status": {
              "const": "preserved"
            }
          },
          "required": [
            "authority",
            "transport",
            "status",
            "authoritative_origin_digest"
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "status": {
              "const": "ok"
            }
          },
          "required": [
            "status"
          ]
        }
      },
      "required": [
        "kind",
        "receipt_version",
        "subject",
        "quarantine",
        "operations",
        "execution",
        "outputs",
        "metadata",
        "result"
      ]
    }
  ]
}
