{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Event Record envelope (event.record) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "event_version",
    "at"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "description": "Event kind identifier (e.g., svc-event, fault-event, policy-decision, audit-event)."
    },
    "event_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "event_id": {
      "type": "string",
      "description": "Stable id (UUID recommended) for correlation."
    },
    "correlation": {
      "type": "object",
      "description": "Optional correlation identifiers for grouping related events (e.g., change-set execution).",
      "properties": {
        "change_id": {
          "type": "string",
          "description": "Change-set or rollout id that triggered this event."
        },
        "step": {
          "type": "string",
          "description": "Optional step name within a change-set."
        },
        "request_id": {
          "type": "string",
          "description": "Optional higher-level request id (fleet controller / operator action)."
        }
      },
      "additionalProperties": false
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "Event timestamp (RFC3339)."
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Collector observation time (optional)."
    },
    "source": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Emitter/collector component name."
        },
        "host_id": {
          "type": "string",
          "description": "Host/node identifier."
        },
        "domain": {
          "type": "string",
          "description": "Optional compartment/domain identifier."
        },
        "pid": {
          "type": "integer"
        },
        "uid": {
          "type": "integer"
        },
        "service_id": {
          "type": "string",
          "description": "If emitted on behalf of a supervised service."
        }
      },
      "additionalProperties": true
    },
    "class": {
      "type": "string",
      "description": "Hierarchical classification string (optional)."
    },
    "severity": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "notice",
        "warn",
        "warning",
        "error",
        "critical",
        "fatal"
      ],
      "description": "Coarse severity (optional)."
    },
    "severity_number": {
      "type": "integer",
      "description": "Optional numeric severity for interoperability (e.g., OpenTelemetry-style)."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subject": {
      "type": "object",
      "description": "Optional subject identifiers (service_id, fault_id, resource ids).",
      "additionalProperties": true
    },
    "payload": {
      "type": "object",
      "description": "Structured event payload (optional)."
    },
    "evidence": {
      "description": "Related evidence pointers (optional). Prefer digests/ids; allow structured evidence when needed.",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "additionalProperties": true
        }
      ]
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related event ids/digests (optional)."
    },
    "prev_digest": {
      "type": "string",
      "description": "Hash-chain link to the previous record in the same stream. The value is `sha256` of the UTF-8 bytes of the JCS-canonicalized previous `event.record` object as stored."
    },
    "signature": {
      "type": "string",
      "description": "Optional signature over canonical bytes (policy-dependent)."
    }
  },
  "additionalProperties": true
}
