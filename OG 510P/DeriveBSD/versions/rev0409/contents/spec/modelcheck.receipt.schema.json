{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Model Check Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "model",
    "tool",
    "result",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "modelcheck-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "model": {
      "type": "object",
      "required": [
        "name",
        "spec_digest",
        "config_digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "spec_digest": {
          "type": "string",
          "description": "Digest of the model source bundle (or primary spec module)."
        },
        "config_digest": {
          "type": "string",
          "description": "Digest of model configuration (constants, bounds, invariants)."
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Model checker name (e.g. TLC)."
        },
        "version": {
          "type": "string"
        },
        "runtime": {
          "type": "string",
          "description": "Runtime environment identifier (e.g. JRE 11)."
        },
        "image_digest": {
          "type": "string",
          "description": "Optional container image digest for the checker."
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "limits": {
          "type": "object",
          "properties": {
            "time_ms": {
              "type": "integer",
              "minimum": 0
            },
            "states_max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "deadlock_detected": {
          "type": "boolean"
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "skipped"
                ]
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "stats": {
          "type": "object",
          "properties": {
            "states_explored": {
              "type": "integer",
              "minimum": 0
            },
            "distinct_states": {
              "type": "integer",
              "minimum": 0
            },
            "max_depth": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "log_digest": {
              "type": "string"
            },
            "counterexample_digest": {
              "type": "string"
            },
            "coverage_digest": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "adr_id": {
          "type": "string",
          "pattern": "^ADR-\\d{4}$"
        },
        "rfc_id": {
          "type": "string",
          "pattern": "^RFC-\\d{4}$"
        },
        "change_id": {
          "type": "string"
        },
        "generation_digest": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
