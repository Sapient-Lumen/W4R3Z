{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD crypto registry (crypto.registry) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "registry_version",
    "registry_id",
    "created_at",
    "uses"
  ],
  "properties": {
    "kind": { "const": "crypto.registry" },
    "registry_version": { "type": "string", "const": "0.1" },
    "registry_id": { "type": "string", "description": "Stable id for this registry (digest recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "plan_digest": { "type": "string", "description": "Optional plan/generation digest this registry was derived for." },

    "uses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/crypto_use" }
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "crypto_use": {
      "type": "object",
      "required": [
        "id",
        "class",
        "stability",
        "summary"
      ],
      "properties": {
        "id": { "type": "string", "description": "Stable id, e.g. crypto.protocol.tls13.default or crypto.key.release_signing." },
        "class": {
          "type": "string",
          "enum": ["protocol", "primitive", "library", "profile", "key_policy"],
          "description": "What kind of crypto surface is this?"
        },
        "stability": {
          "type": "string",
          "enum": ["stable", "provisional", "deprecated", "internal"],
          "default": "provisional"
        },
        "summary": { "type": "string" },

        "owner": { "type": "string" },
        "since": { "type": "string", "description": "First version that shipped this usage (human tag)." },

        "components": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional component/service ids that use this crypto surface."
        },

        "parameters": {
          "type": "object",
          "description": "Key-value details (algorithms, modes, versions). Keep values strings for stability.",
          "additionalProperties": { "type": "string" }
        },

        "policy_links": {
          "type": "object",
          "description": "Optional linkage to policy objects (key policies, deprecations).",
          "properties": {
            "crypto_key_policy_digest": { "type": "string" },
            "deprecation_notice_digest": { "type": "string" }
          },
          "additionalProperties": false
        },

        "surface_links": {
          "type": "object",
          "description": "Optional linkage to other surface registries.",
          "properties": {
            "contracts": { "type": "array", "items": { "type": "string" } },
            "uapi": { "type": "array", "items": { "type": "string" } },
            "parsers": { "type": "array", "items": { "type": "string" } },
            "trust_boundaries": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },

        "risk_tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional flags like uses_legacy_suite, handles_untrusted_input, security_critical, background_use."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
