{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD crash event (crash-event) (v0.1)",
  "allOf": [
    {
      "$ref": "event.record.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "event_version",
        "event_id",
        "at",
        "source",
        "severity",
        "crash_id"
      ],
      "properties": {
        "kind": {
          "const": "crash-event"
        },
        "event_version": {
          "type": "string",
          "pattern": "^0\\.\\d+$"
        },
        "event_id": {
          "type": "string",
          "description": "Stable id (UUID recommended)."
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "Producer name (svc-supervisor, kernel, hypervisor, etc.)."
            },
            "host_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error",
            "critical"
          ]
        },
        "crash_id": {
          "type": "string",
          "description": "Crash report id (crash-report.crash_id)."
        },
        "crash_report_digest": {
          "type": "string",
          "description": "Digest/id of the crash-report evidence object."
        },
        "service_id": {
          "type": "string"
        },
        "vm_id": {
          "type": "string"
        },
        "generation_digest": {
          "type": "string"
        },
        "signature": {
          "type": "string",
          "description": "Optional signature key for grouping (stack hash etc)."
        }
      },
      "additionalProperties": false
    }
  ]
}