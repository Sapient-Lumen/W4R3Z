{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD trust bundle apply receipt (pki.trust.bundle.apply.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "bundle_digest",
    "target",
    "result"
  ],
  "properties": {
    "kind": {
      "const": "pki.trust.bundle.apply.receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "bundle_digest": {
      "type": "string",
      "description": "Digest of the canonical pki-trust-bundle object that this receipt served."
    },
    "bundle_diff_digest": {
      "type": "string",
      "description": "Optional digest of the pki.trust.bundle.diff that justified this apply."
    },
    "purpose": {
      "type": "string",
      "description": "Purpose-scoped trust view identifier, e.g. public-web, internal-mtls, package-verification."
    },
    "target": {
      "type": "object",
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "host-generation",
            "unit-runtime",
            "export-adapter",
            "support-bundle",
            "other"
          ]
        },
        "machine_id": {
          "type": "string"
        },
        "boot_generation": {
          "type": "string"
        },
        "runtime_manifest_digest": {
          "type": "string"
        },
        "unit_name": {
          "type": "string"
        },
        "profile": {
          "type": "string",
          "enum": ["A", "B", "C", "D"]
        }
      },
      "additionalProperties": false
    },
    "renderings": {
      "type": "array",
      "description": "Deterministic rendered trust views derived from the canonical bundle for this target.",
      "items": {
        "type": "object",
        "required": [
          "renderer",
          "output_digest"
        ],
        "properties": {
          "renderer": {
            "type": "string",
            "enum": [
              "openssl-cafile",
              "openssl-capath",
              "p11-kit-trust-module",
              "nssdb",
              "jwk-set",
              "pem-bundle",
              "other"
            ]
          },
          "output_digest": {
            "type": "string"
          },
          "metadata_posture": {
            "type": "string",
            "enum": [
              "digest-only",
              "path-local",
              "handle-local"
            ],
            "default": "digest-only"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "change_set_digest": {
          "type": "string"
        },
        "shadow_trust_scan_digest": {
          "type": "string"
        },
        "waiver_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "applied",
            "rendered-only",
            "skipped",
            "blocked-by-policy",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "status": {
                "enum": ["applied", "rendered-only"]
              }
            },
            "required": ["status"]
          }
        }
      },
      "then": {
        "required": ["renderings"],
        "properties": {
          "renderings": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
