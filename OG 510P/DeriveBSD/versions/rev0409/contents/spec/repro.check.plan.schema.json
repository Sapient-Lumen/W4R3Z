{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD reproducibility check plan (repro.check.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "target",
    "compare"
  ],
  "properties": {
    "kind": {
      "const": "repro.check.plan"
    },
    "plan_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "plan_id": {
      "type": "string",
      "description": "Stable id for the plan (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "requested_by": {
      "type": "string",
      "description": "Opaque operator/workflow id (optional)."
    },

    "target": {
      "$ref": "deployment.ref.schema.json"
    },

    "rebuild": {
      "type": "object",
      "description": "Optional execution hints for how to rebuild the target generation (e.g., replay a Remote Execution action digest).",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "replay_action",
            "rebuild_from_spec",
            "rebuild_from_closure"
          ]
        },
        "action_digest": {
          "type": "string",
          "description": "Remote Execution action digest to replay (if strategy=replay_action)."
        },
        "builder_pool": {
          "type": "string",
          "description": "Builder pool / execution backend identifier (optional)."
        },
        "sandbox_profile_ref": {
          "type": "string",
          "description": "Optional digest/reference to a sandbox profile/policy used for the rebuild."
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },

    "compare": {
      "type": "object",
      "required": [
        "bindings"
      ],
      "properties": {
        "bindings": {
          "type": "array",
          "minItems": 1,
          "description": "Which target.bindings digests must match (closure/root tree/plan/policy decision).",
          "items": {
            "type": "string",
            "enum": [
              "plan_digest",
              "policy_decision_digest",
              "closure_digest",
              "root_tree_digest"
            ]
          }
        },
        "artifact_kinds": {
          "type": "array",
          "description": "Optional: compare digests for artifacts in target.artifacts with matching kind entries.",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },

    "policy": {
      "type": "object",
      "description": "Policy knobs for how strict the check is and what constitutes an acceptable mismatch.",
      "properties": {
        "require_match": {
          "type": "boolean",
          "description": "If true, mismatches should fail promotion gates. If false, mismatches may be recorded with required evidence (diffoscope) and manual approval.",
          "default": true
        },
        "known_impurity_ids": {
          "type": "array",
          "description": "Optional list of impurity ids that can explain tolerated drift (reviewable exceptions).",
          "items": {
            "type": "string"
          }
        },
        "diffoscope": {
          "type": "object",
          "description": "Optional diff generation policy when mismatches occur.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1024
            },
            "emit_html": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
