{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD restore receipt (restore.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_digest",
    "result",
    "observed"
  ],
  "properties": {
    "kind": {
      "const": "restore.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_digest": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "applied",
        "failed",
        "partial"
      ]
    },
    "observed": {
      "type": "object",
      "required": [
        "target_mode"
      ],
      "properties": {
        "target_mode": {
          "type": "string"
        },
        "restored_snapshots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mounted": {
          "type": "boolean"
        },
        "health_check_result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "skipped"
          ]
        },
        "replacement_precondition_mode": {
          "type": "string",
          "enum": [
            "none",
            "quarantine-verified",
            "breakglass-approved"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "backup_receipt_digest": {
          "type": "string"
        },
        "drill_receipt_digest": {
          "type": "string"
        },
        "support_bundle_digest": {
          "type": "string"
        },
        "prior_restore_receipt_digest": {
          "type": "string"
        },
        "authority_receipt_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "observed": {
            "type": "object",
            "properties": {
              "target_mode": {
                "const": "replacement-target"
              }
            },
            "required": [
              "target_mode"
            ]
          }
        },
        "required": [
          "observed"
        ]
      },
      "then": {
        "properties": {
          "observed": {
            "required": [
              "replacement_precondition_mode"
            ],
            "properties": {
              "replacement_precondition_mode": {
                "enum": [
                  "quarantine-verified",
                  "breakglass-approved"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
