{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD impurity waiver policy (impurity.waiver.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "policy_id",
    "created_at",
    "default_mode",
    "waivers"
  ],
  "properties": {
    "kind": { "const": "impurity.waiver.policy" },
    "policy_version": { "type": "string", "const": "0.1" },
    "policy_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },

    "label": { "type": "string" },
    "description": { "type": "string" },

    "default_mode": {
      "type": "string",
      "enum": ["deny", "allow"],
      "default": "deny",
      "description": "Default posture for impurity ids not explicitly waived. Prefer 'deny' (deterministic-by-default)."
    },

    "waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver_entry" },
      "description": "Explicit, time-bounded impurity waivers. Treat additions/scope changes/extensions as review events."
    },

    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "waiver_entry": {
      "type": "object",
      "required": ["waiver_id", "impurity_ids", "expires_at", "justification"],
      "properties": {
        "waiver_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,64}$",
          "description": "Stable identifier for this waiver (used in receipts, gates, and diffs)."
        },

        "impurity_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,64}$"
          },
          "description": "Impurity ids that this waiver permits (e.g. 'ports-nondeterminism')."
        },

        "scope": {
          "type": "object",
          "description": "Optional applicability scope. Keep narrow; broadening scope is a review event.",
          "properties": {
            "profiles": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Optional set of profile ids the waiver applies to (fleet_host/workstation/general_os/appliance_factory)."
            },
            "lanes": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Optional build lanes (e.g. 'native', 'ports_adapter', 'firmware')."
            },
            "stages": {
              "type": "array",
              "items": { "type": "string", "enum": ["build", "repro_check", "upgrade", "activation"] },
              "description": "Pipeline stages the waiver may affect. Prefer the smallest set."
            },
            "targets": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Optional target selectors (package names, derivation labels, artifact kinds)."
            }
          },
          "additionalProperties": false
        },

        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Expiry timestamp for the waiver. Extensions must be review events."
        },

        "required_evidence": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Evidence kinds that must be attached when the waiver is used (e.g. 'diffoscope.report')."
        },

        "justification": {
          "type": "object",
          "required": ["reason"],
          "properties": {
            "reason": { "type": "string" },
            "ticket": { "type": "string" },
            "owner": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
