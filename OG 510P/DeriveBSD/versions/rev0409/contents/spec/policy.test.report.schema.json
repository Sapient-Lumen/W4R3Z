{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD policy test report (policy.test.report) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "report_version",
    "created_at",
    "suite",
    "tool",
    "summary",
    "results"
  ],
  "properties": {
    "kind": {"const": "policy-test-report"},
    "report_version": {"type": "string", "const": "0.1"},
    "report_id": {"type": "string", "description": "Stable id (UUID recommended)."},
    "created_at": {"type": "string", "format": "date-time"},
    "suite": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": {"type": "string", "description": "Repo-relative path or identifier for the suite."},
        "digest": {"type": "string", "description": "Optional digest of the suite bytes."},
        "target": {
          "type": "object",
          "required": ["kind", "ref"],
          "properties": {
            "kind": {"type": "string"},
            "ref": {"type": "string"},
            "digest": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "profile": {"type": "string"}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["case_pass", "case_fail"],
      "properties": {
        "case_pass": {"type": "integer", "minimum": 0},
        "case_fail": {"type": "integer", "minimum": 0},
        "mutants_generated": {"type": "integer", "minimum": 0},
        "mutants_killed": {"type": "integer", "minimum": 0},
        "mutants_survived": {"type": "integer", "minimum": 0},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "status"],
        "properties": {
          "case_id": {"type": "string"},
          "status": {"type": "string", "enum": ["pass", "fail", "skip"]},
          "observed": {
            "type": "object",
            "properties": {
              "decision": {"type": "string", "enum": ["allow", "deny"]},
              "obligations": {"type": "array", "items": {"type": "string"}},
              "explain": {"type": "string"}
            },
            "additionalProperties": false
          },
          "expected": {
            "type": "object",
            "properties": {
              "decision": {"type": "string", "enum": ["allow", "deny"]}
            },
            "additionalProperties": true
          },
          "error": {"type": "string"},
          "refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "mutation_details": {
      "type": "object",
      "description": "Optional mutation testing breakdown.",
      "properties": {
        "operators": {"type": "array", "items": {"type": "string"}},
        "killed": {"type": "array", "items": {"type": "string"}, "description": "Mutant ids killed by the suite."},
        "survived": {"type": "array", "items": {"type": "string"}, "description": "Mutant ids that survived (coverage gap)."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
