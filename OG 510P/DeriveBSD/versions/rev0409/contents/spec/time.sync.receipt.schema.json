{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD time sync receipt (time.sync.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "applied_at",
    "host_id",
    "action",
    "outcome"
  ],
  "properties": {
    "kind": {
      "const": "time-sync-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "receipt_id": {
      "type": "string",
      "description": "Stable id for the receipt (UUID recommended)."
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "host_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "sync",
        "step",
        "slew",
        "source-change",
        "leap-handle",
        "bootstrap"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "skipped"
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "plan_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "details": {
      "type": "object",
      "properties": {
        "reference_source_id": {
          "type": "string"
        },
        "authenticated": {
          "type": "boolean"
        },
        "delta_ms": {
          "type": "number",
          "description": "Step or estimated correction applied, in milliseconds."
        },
        "offset_ms": {
          "type": "number"
        },
        "uncertainty_ms": {
          "type": "number"
        },
        "leap": {
          "type": "string",
          "enum": [
            "none",
            "pending",
            "insert",
            "delete",
            "unknown"
          ]
        },
        "lkgt_before": {
          "type": "string",
          "format": "date-time",
          "description": "LKGT before this action, if maintained."
        },
        "lkgt_after": {
          "type": "string",
          "format": "date-time",
          "description": "LKGT after this action, if maintained."
        }
      },
      "additionalProperties": false
    },
    "snapshots": {
      "type": "object",
      "properties": {
        "before_digest": {
          "type": "string"
        },
        "after_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "correlation": {
      "type": "object",
      "properties": {
        "change_id": {
          "type": "string"
        },
        "step": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
