{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD rollout graph (rollout.graph) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "graph_version",
    "graph_id",
    "created_at",
    "nodes",
    "edges"
  ],
  "properties": {
    "kind": { "const": "rollout.graph" },
    "graph_version": { "type": "string", "const": "0.1" },

    "graph_id": { "type": "string", "description": "Stable id for this graph (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "stream": { "type": "string", "description": "Optional channel/stream label (stable/testing/dev)." },
    "basearch": { "type": "string", "description": "Optional architecture label (amd64/arm64/etc.)." },

    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "release_capsule_digest"],
        "properties": {
          "id": { "type": "string", "description": "Graph-local node id referenced by edges." },
          "release_capsule_digest": { "type": "string", "description": "Digest of a release.capsule describing the deployment payload." },
          "version": { "type": "string", "description": "Optional human version string (for UX only; not authoritative)." },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "edges": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },

          "barrier": {
            "type": "string",
            "description": "Optional barrier label: edges with barriers require explicit operator enablement (or an assignment receipt)."
          },

          "constraints": {
            "type": "object",
            "description": "Optional constraints checked client-side before taking this edge.",
            "properties": {
              "min_rollback_index": { "type": "integer", "minimum": 0 },
              "required_receipt_digests": { "type": "array", "items": { "type": "string" } },
              "required_evidence_kinds": { "type": "array", "items": { "type": "string" } },
              "required_boot_gate_policy_digest": { "type": "string", "description": "Optional digest of boot.health.gate.policy required for promotion." }
            },
            "additionalProperties": false
          },

          "rollout": {
            "type": "object",
            "description": "Optional rollout steering hints (percentage/time-based phasing is usually expressed in rollout.policy).",
            "properties": {
              "wariness_floor": { "type": "number", "minimum": 0, "maximum": 1 },
              "deadend": { "type": "boolean" }
            },
            "additionalProperties": false
          },

          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "signatures": {
      "type": "array",
      "description": "Optional signatures over the canonicalized graph.",
      "items": {
        "type": "object",
        "required": ["key_id", "sig"],
        "properties": {
          "key_id": { "type": "string" },
          "sig": { "type": "string" }
        },
        "additionalProperties": true
      }
    },

    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
