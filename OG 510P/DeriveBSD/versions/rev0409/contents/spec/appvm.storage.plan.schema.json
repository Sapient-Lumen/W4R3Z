{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD AppVM storage plan (appvm.storage.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "appvm",
    "template_root",
    "private_storage",
    "volatile_storage"
  ],
  "properties": {
    "kind": {"const": "appvm.storage.plan"},
    "plan_version": {"type": "string", "const": "0.1"},
    "plan_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "appvm": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "template_digest": {"type": "string"},
        "profile_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "template_root": {
      "type": "object",
      "required": ["digest", "readonly"],
      "properties": {
        "digest": {"type": "string"},
        "readonly": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "private_storage": {"$ref": "#/$defs/storage"},
    "volatile_storage": {"$ref": "#/$defs/storage"},
    "portable_home": {
      "type": "object",
      "properties": {
        "mode": {"type": "string", "enum": ["none", "explicit-lease", "portal-only"]},
        "home_area_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "mount_plan_digest": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "storage": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["zfs-dataset", "qcow2", "raw", "tmpfs", "other"]},
        "size_bytes": {"type": "integer", "minimum": 0},
        "quota_bytes": {"type": "integer", "minimum": 0},
        "wipe_on_shutdown": {"type": "boolean"},
        "snapshot_policy": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
