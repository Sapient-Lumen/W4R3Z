{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Blast-Radius Diff (v1.3)",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "from",
    "to",
    "diff"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "blast_radius.diff"
      ]
    },
    "from": {
      "type": "object",
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "description": "Human identifier (plan id, deployment id, generation id)."
        },
        "digest": {
          "type": "string",
          "description": "Canonical digest for the object."
        }
      },
      "additionalProperties": false
    },
    "to": {
      "type": "object",
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "diff": {
      "type": "object",
      "required": [
        "filesystem",
        "network",
        "devices",
        "runtime",
        "compat"
      ],
      "properties": {
        "filesystem": {
          "$ref": "#/$defs/section"
        },
        "network": {
          "$ref": "#/$defs/section"
        },
        "devices": {
          "$ref": "#/$defs/section"
        },
        "runtime": {
          "$ref": "#/$defs/section"
        },
        "compat": {
          "$ref": "#/$defs/section"
        },
        "contracts": {
          "$ref": "#/$defs/section"
        },
        "uapi": {
          "$ref": "#/$defs/section"
        },
        "resources": {
          "$ref": "#/$defs/section"
        },
        "parsers": {
          "$ref": "#/$defs/section"
        },
        "trust_boundaries": {
          "$ref": "#/$defs/section"
        },
        "crypto": {
          "$ref": "#/$defs/section"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional human notes (safe)."
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": [
        "added",
        "removed",
        "changed"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable identifier for the authority edge."
        },
        "summary": {
          "type": "string",
          "description": "One-line human summary."
        },
        "evidence": {
          "type": "object",
          "description": "Optional structured evidence references (digests, paths, policy ids).",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
