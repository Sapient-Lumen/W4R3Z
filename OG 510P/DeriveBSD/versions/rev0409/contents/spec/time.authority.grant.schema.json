{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Time Authority Grant (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "subject",
    "permissions",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "time-authority-grant"},
    "grant_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "lease_id": {"type": "string", "description": "Optional lease identifier when the grant is mediated/revocable."},

    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": {"type": "string"},
        "digest": {"type": "string"},
        "instance": {"type": "string"}
      },
      "additionalProperties": false
    },

    "context": {
      "type": "object",
      "properties": {
        "plan_digest": {"type": "string"},
        "policy_snapshot_digest": {"type": "string"},
        "policy_decision_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "permissions": {
      "type": "object",
      "required": ["wall_clock", "monotonic", "entropy"],
      "properties": {
        "wall_clock": {
          "type": "string",
          "enum": ["deny", "read", "bounded"],
          "description": "Whether UTC/local wall clock may be observed." 
        },
        "monotonic": {
          "type": "string",
          "enum": ["read"],
          "description": "Monotonic time is always readable in v0." 
        },
        "entropy": {
          "type": "string",
          "enum": ["real", "deterministic", "recorded"],
          "description": "Entropy mode for getrandom/arc4random-style calls." 
        }
      },
      "additionalProperties": false
    },

    "profiles": {
      "type": "object",
      "description": "Optional digests that define virtual clock/entropy profiles.",
      "properties": {
        "clock_profile_digest": {"type": "string"},
        "seed_digest": {"type": "string", "description": "Digest of deterministic seed material (never log raw seed)."}
      },
      "additionalProperties": false
    },

    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional constraints: max skew, max duration, one-shot, etc." 
    },

    "issued_at": {"type": "string"},
    "expires_at": {"type": "string"},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
