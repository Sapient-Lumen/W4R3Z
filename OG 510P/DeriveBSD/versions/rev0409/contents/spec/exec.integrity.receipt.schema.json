{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD exec integrity receipt (exec.integrity.receipt) (v0.1)",
  "description": "Authoritative execution-integrity activation receipt. Records which policy/plan/runtime composition/backend were actually active.",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "policy_digest",
    "plan_digest",
    "backend",
    "mode",
    "runtime_contract",
    "resolution",
    "result"
  ],
  "properties": {
    "kind": {
      "const": "exec.integrity.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_digest": {
      "type": "string"
    },
    "plan_digest": {
      "type": "string"
    },
    "backend": {
      "type": "string",
      "enum": [
        "mac_veriexec",
        "broker",
        "none"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "off",
        "warn",
        "enforce"
      ]
    },
    "activation_boundary": {
      "type": "object",
      "properties": {
        "generation_id": {
          "type": "string"
        },
        "bootenv_id": {
          "type": "string"
        },
        "service_instance_id": {
          "type": "string"
        },
        "vm_instance_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runtime_contract": {
      "type": "object",
      "required": [
        "runtime_manifest_digest",
        "stratum_stack_digest",
        "mount_view_digest"
      ],
      "properties": {
        "runtime_manifest_digest": {
          "type": "string"
        },
        "stratum_stack_digest": {
          "type": "string"
        },
        "mount_view_digest": {
          "type": "string"
        },
        "component_origin": {
          "type": "string",
          "enum": [
            "native",
            "adapter",
            "mixed"
          ]
        },
        "abi_anchor_stratum_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": [
        "interpreters",
        "loaders",
        "libraries",
        "quarantined_bytes"
      ],
      "properties": {
        "interpreters": {
          "type": "string",
          "enum": [
            "resolve-within-mount-view"
          ]
        },
        "loaders": {
          "type": "string",
          "enum": [
            "abi-anchor-only"
          ]
        },
        "libraries": {
          "type": "string",
          "enum": [
            "mount-view-explicit-and-abi-anchor-only"
          ]
        },
        "quarantined_bytes": {
          "type": "string",
          "enum": [
            "deny-unless-explicit-exception"
          ]
        }
      },
      "additionalProperties": false
    },
    "compiled_manifest_digest": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled",
        "degraded",
        "failed"
      ]
    },
    "reason": {
      "type": "string"
    },
    "backend_state": {
      "type": "object",
      "description": "Backend-specific state (opaque to generic tooling).",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
