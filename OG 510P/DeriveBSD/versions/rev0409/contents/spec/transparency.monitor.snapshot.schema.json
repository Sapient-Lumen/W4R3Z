{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD transparency monitor snapshot (transparency.monitor.snapshot) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "snapshot_version",
    "snapshot_id",
    "created_at",
    "authority_semantics",
    "monitor_policy_digest",
    "log_uri",
    "tree_size",
    "summary_status",
    "checkpoint_receipt_digest"
  ],
  "properties": {
    "kind": {
      "const": "transparency.monitor.snapshot"
    },
    "snapshot_version": {
      "type": "string",
      "const": "0.1"
    },
    "snapshot_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority_semantics": {
      "const": "monitor-state-evidence-only",
      "description": "Monitor snapshots summarize observed state and never replace publication authority."
    },
    "monitor_policy_digest": {
      "type": "string"
    },
    "log_uri": {
      "type": "string"
    },
    "tree_size": {
      "type": "integer",
      "minimum": 0
    },
    "checkpoint": {
      "type": "string",
      "description": "Opaque signed checkpoint/tree-head."
    },
    "checkpoint_digest": {
      "type": "string"
    },
    "last_processed_index": {
      "type": "integer",
      "minimum": 0
    },
    "summary_status": {
      "type": "string",
      "enum": [
        "clean",
        "warning",
        "critical"
      ]
    },
    "state_digest": {
      "type": "string",
      "description": "Digest of monitor local state (continuity handoff)."
    },
    "signature": {
      "type": "string"
    },
    "checkpoint_receipt_digest": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
