{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD compiled mount view (mount.view) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "view_version",
    "view_id",
    "created_at",
    "stratum_stack_digest",
    "layers",
    "constraints"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "mount.view"
    },
    "view_version": {
      "type": "string",
      "const": "0.1"
    },
    "view_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "namespace_group": {
      "type": "string"
    },
    "stratum_stack_digest": {
      "type": "string",
      "minLength": 1
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "mount_point",
          "source_kind",
          "access",
          "role",
          "precedence"
        ],
        "additionalProperties": false,
        "properties": {
          "mount_point": {
            "type": "string",
            "minLength": 1
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "stratum",
              "dataset",
              "tmpfs",
              "secret",
              "other"
            ]
          },
          "source_digest": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "access": {
            "type": "string",
            "enum": [
              "ro",
              "rw",
              "tmp",
              "secret"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "abi-anchor",
              "extension",
              "config",
              "state",
              "cache",
              "secret",
              "scratch",
              "other"
            ]
          },
          "precedence": {
            "type": "integer",
            "minimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_kind": {
                  "const": "stratum"
                }
              }
            },
            "then": {
              "required": [
                "source_digest"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "source_kind": {
                  "enum": [
                    "dataset",
                    "tmpfs",
                    "secret",
                    "other"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "source_ref"
              ]
            }
          }
        ]
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "host_fallback",
        "union_order",
        "write_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "host_fallback": {
          "type": "string",
          "enum": [
            "forbidden"
          ]
        },
        "union_order": {
          "type": "string",
          "enum": [
            "deterministic-precedence"
          ]
        },
        "write_policy": {
          "type": "string",
          "enum": [
            "separate-datasets-only"
          ]
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
