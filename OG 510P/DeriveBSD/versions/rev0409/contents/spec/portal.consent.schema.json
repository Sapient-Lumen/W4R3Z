{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Portal Consent Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "consent_version",
    "request_digest",
    "prompt",
    "user",
    "decision",
    "decided_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "portal-consent"},
    "consent_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "request_digest": {"type": "string", "description": "Digest of canonical portal.request bytes (e.g., sha256:...)."},

    "prompt": {
      "type": "object",
      "required": ["template_id", "template_version"],
      "properties": {
        "template_id": {"type": "string", "description": "Stable prompt template id."},
        "template_version": {"type": "string", "description": "Version of the prompt template."},
        "ui_backend": {"type": "string", "description": "Optional UI backend identifier."}
      },
      "additionalProperties": false
    },

    "user": {
      "type": "object",
      "required": ["uid"],
      "properties": {
        "uid": {"type": "integer"},
        "label": {"type": "string", "description": "Optional human-readable label (local), may be omitted for privacy."}
      },
      "additionalProperties": false
    },

    "decision": {"type": "string", "enum": ["allow", "deny"]},

    "constraints": {
      "type": "object",
      "description": "Optional constraints applied at approval time (ttl, rights, scope).",
      "additionalProperties": true
    },

    "grant_ref": {"type": "string", "description": "Optional digest/ref of resulting portal.grant (sha256:...)."},
    "lease_id": {"type": "string", "description": "Optional lease id if the approval produced a leased grant."},

    "context": {
      "type": "object",
      "description": "Optional linkage to DeriveBSD objects.",
      "properties": {
        "plan_digest": {"type": "string"},
        "policy_decision_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "decided_at": {"type": "string", "description": "ISO8601 time."},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string", "description": "Signature over canonical JSON bytes."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
