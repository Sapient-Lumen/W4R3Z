{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Trace Stream Grant (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "target",
    "sources",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "trace-stream-grant"},
    "grant_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "lease_id": {
      "type": "string",
      "description": "Optional lease identifier for revocable grants. Strongly recommended for any cross-compartment observability grant."
    },

    "target": {
      "type": "object",
      "description": "Selectors identifying what is being observed.",
      "properties": {
        "pid": {"type": "integer"},
        "jail_id": {"type": "string"},
        "microvm_id": {"type": "string"},
        "workload_id": {"type": "string", "description": "Optional workload identity handle (e.g., SVID subject, plan-bound identity, etc.)."}
      },
      "additionalProperties": false
    },

    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["logs", "audit", "dtrace"]
      },
      "description": "Approved signal sources for this stream."
    },

    "template_digest": {
      "type": "string",
      "description": "Optional digest of a pre-reviewed trace template/script bundle used by the broker."
    },

    "constraints": {
      "type": "object",
      "description": "Optional bounds. Defaults are policy-defined.",
      "properties": {
        "max_duration_seconds": {"type": "integer", "minimum": 1},
        "max_bytes": {"type": "integer", "minimum": 1},
        "sample_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "redaction_profile_digest": {"type": "string", "description": "Digest of a deterministic redaction.transform artifact (allowlist/masking rules or module)."}
      },
      "additionalProperties": false
    },

    "context": {
      "type": "object",
      "description": "Binds grants to higher-level DeriveBSD objects when relevant.",
      "properties": {
        "plan_digest": {"type": "string"},
        "policy_snapshot_digest": {"type": "string"},
        "policy_decision_digest": {"type": "string"},
        "incident_id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "issued_at": {"type": "string", "description": "ISO8601 time."},
    "expires_at": {"type": "string", "description": "ISO8601 time. Strongly recommended."},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string", "description": "Signature over canonical JSON bytes."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
