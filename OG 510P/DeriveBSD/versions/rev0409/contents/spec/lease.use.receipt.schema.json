{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD lease use receipt (lease.use.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "host",
    "lane",
    "lease_id",
    "authority_semantics",
    "use",
    "outcome"
  ],
  "properties": {
    "kind": {
      "const": "lease.use.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string",
      "description": "Stable id for this use attempt (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "required": [
        "host_id",
        "generation_digest"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "generation_digest": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "lane": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "description": "Selectors describing who attempted to use the lease.",
      "additionalProperties": true
    },
    "use": {
      "type": "object",
      "description": "Metadata-only description of what the lease was used for.",
      "required": [
        "operation"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "description": "High-level operation class (export, decrypt, listen, egress, trace.start, ...)."
        },
        "resource": {
          "type": "string",
          "description": "Optional resource/target summary (never embed secrets)."
        },
        "request_id": {
          "type": "string",
          "description": "Optional request correlation id."
        }
      },
      "additionalProperties": false
    },
    "related": {
      "type": "object",
      "description": "Optional pointer to the later evidence/result object produced by the operation (for example export.receipt or secret-receipt). This is operation evidence, not the authority object.",
      "required": [
        "kind",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "allowed",
        "denied"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "description": "Optional signature over this receipt envelope.",
      "properties": {
        "sig_alg": {
          "type": "string"
        },
        "public_key_hint": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authority_semantics": {
      "type": "string",
      "const": "lease-use-evidence-only",
      "description": "Records that already-issued temporary authority was exercised or denied; it is not itself the authoritative result of the later operation."
    }
  },
  "additionalProperties": false
}
