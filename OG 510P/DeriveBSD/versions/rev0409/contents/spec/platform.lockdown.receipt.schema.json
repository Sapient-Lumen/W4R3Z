{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD platform lockdown receipt (platform-lockdown-receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "at",
    "host",
    "requested_level",
    "effective_level",
    "policy_digest",
    "result"
  ],
  "properties": {
    "kind": { "const": "platform-lockdown-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },

    "receipt_id": { "type": "string", "description": "Stable id (UUID recommended)." },
    "at": { "type": "string", "format": "date-time" },

    "host": {
      "type": "object",
      "required": ["host_id", "generation_digest"],
      "properties": {
        "host_id": { "type": "string" },
        "generation_digest": { "type": "string" },
        "boot_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "requested_level": {
      "type": "string",
      "description": "Policy-intended lockdown level.",
      "enum": ["bootstrap", "operational", "high"]
    },
    "effective_level": {
      "type": "string",
      "description": "Lockdown level observed after applying actions.",
      "enum": ["bootstrap", "operational", "high"]
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest pointer to the posture/lockdown policy object that drove this receipt."
    },

    "result": {
      "type": "string",
      "enum": ["ok", "failed", "partial"],
      "description": "Whether the host reached the requested level. 'partial' means actions applied but level did not match policy."
    },

    "preconditions": {
      "type": "array",
      "description": "Preconditions evaluated prior to raising lockdown.",
      "items": {
        "type": "object",
        "required": ["check", "status"],
        "properties": {
          "check": { "type": "string" },
          "status": { "type": "string", "enum": ["ok", "failed", "skipped"] },
          "evidence_digests": {
            "type": "array",
            "items": { "type": "string" }
          },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "actions_applied": {
      "type": "array",
      "description": "Normalized list of actions applied to reach lockdown intent.",
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string" },
          "target": { "type": "string" },
          "value": { "type": "string" },
          "status": { "type": "string", "enum": ["ok", "failed", "skipped"] },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "correlation": {
      "type": "object",
      "description": "Pointers tying this receipt to an activation/change-set step.",
      "properties": {
        "change_set_digest": { "type": "string" },
        "step_id": { "type": "string" },
        "activation_receipt_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "signature": {
      "type": "object",
      "description": "Optional signature over the receipt body.",
      "properties": {
        "alg": { "type": "string" },
        "key_id": { "type": "string" },
        "sig": { "type": "string" }
      },
      "additionalProperties": false
    },

    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
