{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD terminal session recording metadata (tty.session.recording) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "recording_version",
    "recording_id",
    "created_at",
    "host",
    "subject",
    "mode",
    "chunks"
  ],
  "properties": {
    "kind": {
      "const": "tty-session-recording"
    },
    "recording_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "recording_id": {
      "type": "string",
      "description": "Stable id (UUID recommended) for the recording."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "required": [
        "host_id",
        "generation_digest"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "generation_digest": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": [
        "principal",
        "session_ref"
      ],
      "properties": {
        "principal": {
          "type": "string",
          "description": "Who the session belongs to (login principal)."
        },
        "session_ref": {
          "type": "string",
          "description": "Opaque reference to the login/ssh/console session id."
        },
        "tty": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "jail_id": {
          "type": "string"
        },
        "vm_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "mode": {
      "type": "object",
      "required": [
        "capture"
      ],
      "properties": {
        "capture": {
          "type": "string",
          "enum": [
            "output-only",
            "input+output"
          ]
        },
        "window_cols": {
          "type": "integer"
        },
        "window_rows": {
          "type": "integer"
        },
        "encoding": {
          "type": "string",
          "enum": [
            "jsonl",
            "tlog-json",
            "opaque"
          ],
          "default": "jsonl"
        }
      },
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "properties": {
        "max_seconds": {
          "type": "integer"
        },
        "max_bytes": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "chunk_digest",
          "bytes",
          "sequence"
        ],
        "properties": {
          "sequence": {
            "type": "integer"
          },
          "chunk_digest": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "start_at": {
            "type": "string",
            "format": "date-time"
          },
          "end_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "hash_chain": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "alg": {
          "type": "string"
        },
        "root_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "redaction_receipt_digest": {
      "type": "string"
    },
    "export_receipt_digest": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "properties": {
        "sig_alg": {
          "type": "string"
        },
        "public_key_hint": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
