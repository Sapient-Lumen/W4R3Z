{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD configuration apply receipt (config.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "applied_at",
    "plan",
    "outcome"
  ],
  "properties": {
    "kind": {
      "const": "config-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "receipt_id": {
      "type": "string",
      "description": "Stable id for the receipt (UUID recommended)."
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "host_id": {
      "type": "string"
    },
    "plan": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string"
        },
        "plan_id": {
          "type": "string"
        }
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "rolled-back",
        "pending-confirm"
      ]
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "ok"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "activated_roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "store_path": {
            "type": "string"
          }
        }
      }
    },
    "service_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "service",
          "action"
        ],
        "properties": {
          "service": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "reload",
              "restart",
              "none"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "confirm": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "not-required",
            "pending",
            "confirmed",
            "timed-out"
          ]
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "confirmed_by": {
          "type": "string",
          "description": "Principal/capability id."
        }
      }
    },
    "rollback": {
      "type": "object",
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "rollback_plan_digest": {
          "type": "string"
        },
        "prior_snapshot_digest": {
          "type": "string"
        }
      }
    },
    "events": {
      "type": "array",
      "description": "Optional event ids emitted during apply/confirm/rollback.",
      "items": {
        "type": "string"
      }
    }
  }
}
