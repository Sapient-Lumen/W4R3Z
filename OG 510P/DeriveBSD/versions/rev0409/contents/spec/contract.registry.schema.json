{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD contract registry (contract.registry) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "registry_version",
    "registry_id",
    "created_at",
    "contracts"
  ],
  "properties": {
    "kind": { "const": "contract.registry" },
    "registry_version": { "type": "string", "const": "0.1" },
    "registry_id": { "type": "string", "description": "Stable id for this registry (digest recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "plan_digest": { "type": "string", "description": "Optional plan/generation digest this registry was derived for." },

    "contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/contract" }
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "required": [
        "id",
        "surface",
        "stability",
        "contract_digest"
      ],
      "properties": {
        "id": { "type": "string", "description": "Stable name, e.g. portal.crypto.sign" },
        "surface": {
          "type": "string",
          "enum": ["rpc", "portal", "file", "schema"]
        },
        "stability": {
          "type": "string",
          "enum": ["stable", "provisional", "deprecated", "internal"]
        },
        "owner": { "type": "string" },
        "since": { "type": "string" },
        "contract_digest": { "type": "string", "description": "Digest capturing interface shape (sha256:... recommended)." },

        "idl": {
          "type": "object",
          "description": "Optional pointer to an IDL/schema source that produced the digest.",
          "properties": {
            "type": { "type": "string", "enum": ["wit", "json-schema", "protobuf", "manual"] },
            "ref": { "type": "string" },
            "digest": { "type": "string" }
          },
          "additionalProperties": false
        },

        "risk_tags": { "type": "array", "items": { "type": "string" } },
        "tests": {
          "type": "object",
          "properties": {
            "conformance": { "type": "string" },
            "fuzz": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
