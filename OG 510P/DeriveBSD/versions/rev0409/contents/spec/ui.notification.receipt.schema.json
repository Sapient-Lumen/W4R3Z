{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI Notification Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "op",
    "subject",
    "notification",
    "payload_digest",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": { "const": "ui-notification-receipt" },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "op": {
      "type": "string",
      "enum": ["publish", "withdraw"]
    },
    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string" },
        "digest": { "type": "string" },
        "instance": { "type": "string" }
      },
      "additionalProperties": false
    },
    "notification": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "normal", "high", "critical"] },
        "persistence_seconds": { "type": "integer" },
        "activation_intent_digest": { "type": "string", "description": "Digest of intent.request or activation descriptor." }
      },
      "additionalProperties": true
    },
    "payload_digest": {
      "type": "string",
      "description": "Digest of the notification payload (content), to avoid embedding text in receipts by default."
    },
    "issued_at": { "type": "string", "description": "ISO8601 time." },
    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": { "type": "string" },
        "alg": { "type": "string" },
        "sig": { "type": "string", "description": "Signature over canonical JSON bytes." }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
