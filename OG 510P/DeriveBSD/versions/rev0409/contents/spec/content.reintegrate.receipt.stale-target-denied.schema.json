{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD content reintegration stale-target denial receipt profile (content.reintegrate.receipt.stale-target-denied) (v0.1)",
  "allOf": [
    {
      "$ref": "content.reintegrate.receipt.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "content.reintegrate.receipt"
        },
        "supersession": {
          "type": "object",
          "properties": {
            "mode": {
              "const": "supersede-prior-candidate"
            }
          },
          "required": [
            "mode"
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "status": {
              "const": "deny"
            },
            "reason_code": {
              "const": "stale-supersession-target"
            },
            "recovery_posture": {
              "const": "fresh-explicit-supersession-required"
            }
          },
          "required": [
            "status",
            "reason_code",
            "recovery_posture",
            "observed_current_receipt_digest",
            "observed_current_candidate_digest",
            "observed_current_authoritative_origin_digest"
          ]
        }
      },
      "required": [
        "supersession",
        "result"
      ]
    }
  ]
}
