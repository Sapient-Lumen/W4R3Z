{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD compiled runtime manifest (example contract) (v0.1)",
  "description": "A compiled, backend-facing runtime contract for launching an artifact. This schema is intentionally extension-friendly.",
  "type": "object",
  "required": [
    "kind",
    "manifest_version",
    "artifact",
    "runtime_contract"
  ],
  "additionalProperties": true,
  "properties": {
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "manifest_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "artifact": {
      "type": "object",
      "required": [
        "digest"
      ],
      "additionalProperties": true,
      "properties": {
        "digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "preferred": {
          "type": "string"
        },
        "compat": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cpu": {
          "type": "integer",
          "minimum": 1
        },
        "mem_mb": {
          "type": "integer",
          "minimum": 16
        }
      }
    },
    "runtime_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stratum_stack_digest": {
          "type": "string",
          "minLength": 1
        },
        "mount_view_digest": {
          "type": "string",
          "minLength": 1
        },
        "component_origin": {
          "type": "string",
          "enum": [
            "native",
            "adapter",
            "mixed"
          ]
        },
        "derive_unit_digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "derive_unit_digest",
        "stratum_stack_digest",
        "mount_view_digest"
      ]
    }
  }
}
