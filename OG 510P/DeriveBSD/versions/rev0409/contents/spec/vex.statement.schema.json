{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD VEX statement wrapper (vex.statement) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "statement_version",
    "created_at",
    "subject",
    "vex_format",
    "vex_document_digest",
    "dsse_envelope_digest",
    "bindings",
    "signatures"
  ],
  "properties": {
    "kind": {"const": "vex.statement"},
    "statement_version": {"type": "string", "const": "0.1"},

    "created_at": {"type": "string", "format": "date-time"},

    "subject": {
      "type": "object",
      "required": ["artifact_digest", "sbom_document_digest"],
      "properties": {
        "artifact_digest": {"type": "string"},
        "plan_digest": {"type": "string"},
        "sbom_document_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "vex_format": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "enum": ["cyclonedx", "openvex"]},
        "version": {"type": "string"},
        "media_type": {"type": "string"}
      },
      "additionalProperties": false
    },

    "vex_document_digest": {
      "type": "string",
      "description": "Digest of the VEX document blob (CycloneDX VEX or OpenVEX)."
    },

    "dsse_envelope_digest": {
      "type": "string",
      "description": "Digest of the DSSE envelope (in-toto Statement) that signs/binds the VEX document."
    },

    "bindings": {
      "type": "object",
      "description": "Policy-relevant bindings to make VEX meaning replayable.",
      "required": ["vuln_db_snapshot_digest"],
      "properties": {
        "vuln_db_snapshot_digest": {"type": "string"},
        "policy_decision_digest": {"type": "string"},
        "expires_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },

    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key_id", "alg", "sig"],
        "properties": {
          "key_id": {"type": "string"},
          "alg": {"type": "string"},
          "sig": {"type": "string"}
        },
        "additionalProperties": false
      }
    },

    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
