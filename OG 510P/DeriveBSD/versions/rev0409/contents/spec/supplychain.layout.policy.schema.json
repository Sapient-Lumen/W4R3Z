{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD supplychain layout policy (supplychain-layout-policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "layout_digest",
    "enforcement",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "supplychain-layout-policy"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "layout_digest": {
      "type": "string",
      "description": "Digest of the stored layout artifact (e.g., an in-toto layout JSON or a DSSE-wrapped layout)."
    },
    "layout_format": {
      "type": "string",
      "enum": [
        "in-toto-layout",
        "dsse-in-toto-layout",
        "opaque"
      ],
      "description": "Format hint for tooling. Verification code should treat the digest as authoritative."
    },
    "trust": {
      "type": "object",
      "description": "Where to find the trust roots for layout authors and/or functionaries.",
      "properties": {
        "trust_policy_digest": {
          "type": "string"
        },
        "layout_authority": {
          "type": "string",
          "description": "Optional named authority in the trust policy."
        },
        "functionary_authority": {
          "type": "string",
          "description": "Optional named authority in the trust policy."
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "description": "Optional additional constraints beyond the layout itself (policy-level toggles).",
      "properties": {
        "required_predicate_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Predicate type URIs that must appear in consumed in-toto Statements (e.g., SLSA provenance)."
        },
        "require_test_receipts": {
          "type": "boolean"
        },
        "require_sbom": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "enforcement": {
      "type": "string",
      "enum": [
        "warn",
        "deny"
      ],
      "description": "How clients should treat verification failures."
    },
    "context": {
      "type": "object",
      "description": "Optional binding to DeriveBSD namespaces/channels.",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "issued_at": {
      "type": "string",
      "description": "ISO8601 time."
    },
    "expires_at": {
      "type": "string",
      "description": "ISO8601 time. Optional but recommended."
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
