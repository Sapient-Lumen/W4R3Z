{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD SBOM statement wrapper (sbom.statement) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "statement_version",
    "created_at",
    "subject",
    "sbom_format",
    "sbom_document_digest",
    "dsse_envelope_digest",
    "signatures"
  ],
  "properties": {
    "kind": {"const": "sbom.statement"},
    "statement_version": {"type": "string", "const": "0.1"},

    "created_at": {"type": "string", "format": "date-time"},

    "subject": {
      "type": "object",
      "required": ["artifact_digest"],
      "properties": {
        "artifact_digest": {"type": "string"},
        "plan_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "sbom_format": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "enum": ["cyclonedx", "spdx"]},
        "version": {"type": "string"},
        "media_type": {"type": "string"}
      },
      "additionalProperties": false
    },

    "sbom_document_digest": {
      "type": "string",
      "description": "Digest of the SBOM document blob (CycloneDX/SPDX)."
    },

    "dsse_envelope_digest": {
      "type": "string",
      "description": "Digest of the DSSE envelope (in-toto Statement) that signs/binds the SBOM document."
    },

    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key_id", "alg", "sig"],
        "properties": {
          "key_id": {"type": "string"},
          "alg": {"type": "string"},
          "sig": {"type": "string"}
        },
        "additionalProperties": false
      }
    },

    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
