{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD attestation event (attestation.event) (v0.1)",
  "allOf": [
    {
      "$ref": "event.record.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "event_version",
        "event_id",
        "at",
        "source",
        "severity",
        "subject",
        "action"
      ],
      "properties": {
        "kind": {
          "const": "attestation-event"
        },
        "event_version": {
          "type": "string",
          "pattern": "^0\\.\\d+$"
        },
        "event_id": {
          "type": "string",
          "description": "Stable id (UUID recommended)."
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "Producer name (attestd, verifier, admission, etc.)."
            },
            "host_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error",
            "critical"
          ]
        },
        "subject": {
          "type": "object",
          "required": [
            "host_id"
          ],
          "properties": {
            "host_id": {
              "type": "string"
            },
            "attester_key_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "action": {
          "type": "string",
          "enum": [
            "receipt-issued",
            "receipt-expired",
            "verification-failed",
            "posture-degraded",
            "receipt-used"
          ],
          "description": "Event action."
        },
        "reference_digest": {
          "type": "string"
        },
        "receipt_digest": {
          "type": "string"
        },
        "evidence_digest": {
          "type": "string",
          "description": "Primary evidence digest (boot.attestation) if applicable."
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
