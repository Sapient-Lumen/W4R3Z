{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD backup plan (backup.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "scope",
    "method",
    "destination"
  ],
  "properties": {
    "kind": { "const": "backup-plan" },
    "plan_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "plan_id": { "type": "string", "description": "Stable id for the plan (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "requested_by": { "type": "string", "description": "Opaque operator/workflow id (optional)." },

    "scope": {
      "type": "object",
      "required": ["datasets"],
      "properties": {
        "datasets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["selector"],
            "properties": {
              "selector": {
                "type": "string",
                "description": "Dataset selector (e.g., state role name, dataset name, or stable state id)."
              },
              "include_children": { "type": "boolean", "default": true },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "snapshot": {
          "type": "object",
          "description": "Snapshot strategy. If omitted, applier chooses a safe default.",
          "properties": {
            "mode": { "type": "string", "enum": ["create", "reuse-tag"], "default": "create" },
            "tag": { "type": "string", "description": "When mode=reuse-tag, select the most recent snapshot with this tag." },
            "prefix": { "type": "string", "description": "When mode=create, prefix used for snapshot names." }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "method": {
      "type": "object",
      "required": ["adapter"],
      "properties": {
        "adapter": { "type": "string", "enum": ["zfs.send", "restic", "tar+hash"] },
        "incremental": { "type": "boolean", "default": true },
        "raw_send": { "type": "boolean", "default": false, "description": "ZFS: request raw send if encryption policy allows." },
        "compression": { "type": "string", "enum": ["none", "zstd"], "default": "zstd" },
        "options": {
          "type": "object",
          "description": "Adapter-specific options (kept small; prefer higher-level policy).",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },

    "destination": {
      "type": "object",
      "required": ["transport_ref"],
      "properties": {
        "transport_ref": {
          "type": "string",
          "description": "Digest/handle referencing a transport policy / destination configuration."
        },
        "label": { "type": "string" }
      },
      "additionalProperties": false
    },

    "encryption": {
      "type": "object",
      "description": "Optional encryption policy reference. Prefer portalized crypto ops.",
      "properties": {
        "mode": { "type": "string", "enum": ["none", "portal"], "default": "portal" },
        "crypto_policy_ref": { "type": "string", "description": "Digest/handle referencing crypto op policy (key id, purpose, algorithm allowlists)." }
      },
      "additionalProperties": false
    },

    "retention": {
      "type": "object",
      "description": "Optional retention rules; pruning actions should be recorded in receipts.",
      "properties": {
        "keep_daily": { "type": "integer", "minimum": 0 },
        "keep_weekly": { "type": "integer", "minimum": 0 },
        "keep_monthly": { "type": "integer", "minimum": 0 },
        "keep_yearly": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
