{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD firmware inventory diff (fw.inventory.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_receipt",
    "to_receipt",
    "components_added",
    "components_removed",
    "components_changed"
  ],
  "properties": {
    "kind": { "const": "fw.inventory.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation).",
      "properties": {
        "host_id": { "type": "string" },
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "from_generation": { "type": "string" },
        "to_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "from_receipt": { "$ref": "#/$defs/receipt_ref" },
    "to_receipt": { "$ref": "#/$defs/receipt_ref" },

    "components_added": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "components_removed": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "components_changed": {
      "type": "array",
      "items": { "$ref": "#/$defs/component_change" }
    },

    "summary": {
      "type": "object",
      "properties": {
        "added": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "receipt_ref": {
      "type": "object",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "receipt_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "boot_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "component_key": {
      "type": "object",
      "description": "Stable identifier for a firmware-bearing component in an inventory receipt.",
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "description": "Matches fw.inventory.receipt.components[].class (bios/uefi/bmc/nic/secureboot/etc)."
        },
        "device_id": { "type": "string" },
        "fw_guid": { "type": "string" },
        "vendor": { "type": "string" },
        "model": { "type": "string" }
      },
      "additionalProperties": false
    },

    "secureboot_summary": {
      "type": "object",
      "description": "Only for class=secureboot. Digest-first summary of enrolled keysets.",
      "properties": {
        "enabled": { "type": "boolean" },
        "pk_digest": { "type": "string" },
        "kek_digest": { "type": "string" },
        "db_digest": { "type": "string" },
        "dbx_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "component": {
      "type": "object",
      "required": ["key", "version"],
      "properties": {
        "key": { "$ref": "#/$defs/component_key" },
        "version": { "type": "string" },
        "build": { "type": "string" },
        "secureboot": { "$ref": "#/$defs/secureboot_summary" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "component_change": {
      "type": "object",
      "required": ["key", "from", "to"],
      "properties": {
        "key": { "$ref": "#/$defs/component_key" },
        "from": { "$ref": "#/$defs/component" },
        "to": { "$ref": "#/$defs/component" },
        "classification": { "type": "string", "enum": ["version", "secureboot", "both", "other"] },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
