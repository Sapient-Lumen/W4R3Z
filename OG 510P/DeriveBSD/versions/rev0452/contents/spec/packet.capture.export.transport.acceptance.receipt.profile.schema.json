{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD packet-capture export transport acceptance receipt profile (packet.capture.export.transport.acceptance.receipt.profile) (v0.1)",
  "allOf": [
    {
      "$ref": "transport.acceptance.receipt.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "packet.capture.normalized"
            }
          }
        },
        "outcome": {
          "const": "accepted"
        },
        "acceptance": {
          "type": "object",
          "required": [
            "remote_reference",
            "accepted_at",
            "remote_artifact_digest",
            "remote_validator",
            "remote_protection",
            "remote_locator"
          ],
          "properties": {
            "kind": {
              "enum": [
                "ticket-visible",
                "portal-ingest",
                "signed-mdn",
                "manual-oob",
                "custom"
              ]
            },
            "remote_validator": {
              "type": "object",
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "etag-strong",
                    "etag-weak",
                    "version-id",
                    "attachment-revision",
                    "message-id",
                    "opaque"
                  ]
                },
                "value": {
                  "type": "string"
                }
              }
            },
            "remote_locator": {
              "type": "object",
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "uri-hint",
                    "ticket-attachment",
                    "portal-object",
                    "message-part",
                    "object-path",
                    "opaque"
                  ]
                },
                "value": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "required": [
        "kind",
        "receipt_version",
        "receipt_id",
        "created_at",
        "transport_receipt_digest",
        "artifact",
        "recipient",
        "outcome",
        "acceptance"
      ]
    }
  ]
}
