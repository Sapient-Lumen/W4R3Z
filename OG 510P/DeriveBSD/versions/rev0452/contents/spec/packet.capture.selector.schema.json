{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD packet capture selector (packet.capture.selector) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "selector_version",
    "direction",
    "families",
    "transports"
  ],
  "properties": {
    "kind": {
      "const": "packet.capture.selector"
    },
    "selector_version": {
      "type": "string",
      "const": "0.1"
    },
    "direction": {
      "type": "string",
      "enum": [
        "either",
        "ingress",
        "egress"
      ]
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ipv4",
          "ipv6",
          "arp",
          "any"
        ]
      }
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "tcp",
          "udp",
          "icmp",
          "icmpv6",
          "arp",
          "any"
        ]
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "kind",
          "value"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "either",
              "source",
              "destination"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "ip",
              "cidr",
              "hostname"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "port"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "either",
              "source",
              "destination"
            ]
          },
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "additionalProperties": false
      }
    },
    "vlan_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4094
      }
    },
    "tcp_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "syn",
          "ack",
          "fin",
          "rst",
          "psh",
          "urg"
        ]
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
