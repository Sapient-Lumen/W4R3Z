{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UAPI registry (uapi.registry) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "registry_version",
    "registry_id",
    "created_at",
    "surfaces"
  ],
  "properties": {
    "kind": { "const": "uapi.registry" },
    "registry_version": { "type": "string", "const": "0.1" },
    "registry_id": { "type": "string", "description": "Stable id for this registry (digest recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "kernel_ref": { "type": "string", "description": "Optional kernel build/ref identifier." },
    "plan_digest": { "type": "string", "description": "Optional plan/generation digest this registry was derived for." },

    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/uapi_surface" }
    }
  },
  "$defs": {
    "uapi_surface": {
      "type": "object",
      "required": [
        "id",
        "class",
        "stability",
        "contract_digest"
      ],
      "properties": {
        "id": { "type": "string", "description": "Stable name, e.g. uapi.syscall.openat" },
        "class": {
          "type": "string",
          "enum": ["syscall", "ioctl", "sysctl", "devnode", "pseudofs", "vdso"]
        },
        "stability": {
          "type": "string",
          "enum": ["stable", "provisional", "deprecated", "internal"]
        },
        "owner": { "type": "string" },
        "since": { "type": "string", "description": "First version that shipped this surface (human tag)." },
        "contract_digest": { "type": "string", "description": "Digest capturing signature+shape (sha256:... recommended)." },
        "authority_notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "risk_tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional flags like parses_untrusted_input, touches_global_namespace, returns_authority."
        },
        "tests": {
          "type": "object",
          "properties": {
            "conformance": { "type": "string" },
            "fuzz": { "type": "string" }
          },
          "additionalProperties": false
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
