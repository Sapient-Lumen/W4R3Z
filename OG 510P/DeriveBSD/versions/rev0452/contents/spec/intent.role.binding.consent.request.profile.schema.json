{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD role-binding consent request profile (intent.role.binding.consent.request.profile) (v0.1)",
  "allOf": [
    {
      "$ref": "consent.request.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "object",
          "required": [
            "kind",
            "plan_digest",
            "artifact_digest"
          ],
          "properties": {
            "kind": {
              "const": "change.confirm"
            },
            "summary": {
              "type": "string"
            },
            "policy_digest": {
              "type": "string"
            },
            "artifact_digest": {
              "type": "string"
            },
            "plan_digest": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "secure_attention_required": {
          "const": true
        }
      },
      "required": [
        "kind",
        "request_version",
        "request_id",
        "created_at",
        "expires_at",
        "action",
        "secure_attention_required"
      ]
    }
  ]
}
