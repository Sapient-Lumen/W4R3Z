{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD packet capture summary (packet.capture.summary) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "summary_version",
    "authority_semantics",
    "created_at",
    "session",
    "window",
    "protocol_totals",
    "top_conversations",
    "artifacts",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "packet.capture.summary"
    },
    "summary_version": {
      "type": "string",
      "const": "0.1"
    },
    "authority_semantics": {
      "type": "string",
      "const": "packet-capture-summary-evidence-only"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "session": {
      "type": "object",
      "required": [
        "kind",
        "session_id",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "packet.capture.session"
        },
        "session_id": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "required": [
        "started_at",
        "ended_at",
        "observed_packets",
        "observed_bytes",
        "truncated"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "observed_packets": {
          "type": "integer",
          "minimum": 0
        },
        "observed_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "protocol_totals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "protocol",
          "conversations",
          "packets",
          "bytes"
        ],
        "properties": {
          "protocol": {
            "type": "string",
            "enum": [
              "tcp",
              "udp",
              "icmp",
              "arp",
              "other"
            ]
          },
          "conversations": {
            "type": "integer",
            "minimum": 0
          },
          "packets": {
            "type": "integer",
            "minimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "top_conversations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "transport",
          "peers",
          "observation"
        ],
        "properties": {
          "transport": {
            "type": "object",
            "required": [
              "proto"
            ],
            "properties": {
              "proto": {
                "type": "string",
                "enum": [
                  "tcp",
                  "udp",
                  "icmp",
                  "arp",
                  "other"
                ]
              },
              "source_port": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "destination_port": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            },
            "additionalProperties": false
          },
          "peers": {
            "type": "object",
            "required": [
              "source",
              "destination",
              "source_redacted",
              "destination_redacted"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "destination": {
                "type": "string"
              },
              "source_name": {
                "type": "string"
              },
              "destination_name": {
                "type": "string"
              },
              "source_redacted": {
                "type": "boolean"
              },
              "destination_redacted": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "observation": {
            "type": "object",
            "required": [
              "packets",
              "bytes",
              "first_seen",
              "last_seen"
            ],
            "properties": {
              "packets": {
                "type": "integer",
                "minimum": 0
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "first_seen": {
                "type": "string",
                "format": "date-time"
              },
              "last_seen": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "export_verdict"
      ],
      "properties": {
        "local_capture_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "digest",
              "format",
              "storage",
              "metadata_posture",
              "retention_until"
            ],
            "properties": {
              "digest": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": [
                  "pcap",
                  "pcapng",
                  "netmap-ring-snapshot",
                  "other"
                ]
              },
              "storage": {
                "type": "string",
                "enum": [
                  "ephemeral-local",
                  "sealed-local",
                  "incident-bundle-reference-eligible"
                ]
              },
              "metadata_posture": {
                "type": "string",
                "enum": [
                  "packet-records-only",
                  "sideband-metadata-present",
                  "decryption-material-present"
                ]
              },
              "retention_until": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        },
        "export_verdict": {
          "type": "string",
          "enum": [
            "metadata-only-default",
            "summary-only-default",
            "raw-export-exception-approved",
            "raw-export-forbidden"
          ]
        },
        "exported_raw_artifact_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "redaction_transform_digest": {
      "type": "string"
    },
    "related": {
      "type": "object",
      "properties": {
        "net_flow_summary_digest": {
          "type": "string"
        },
        "incident_bundle_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
