{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD state migration plan (state-migration-plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "from_generation_digest",
    "to_generation_digest",
    "steps"
  ],
  "properties": {
    "kind": { "const": "state-migration-plan" },
    "plan_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "from_generation_digest": { "type": "string" },
    "to_generation_digest": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["volume_id", "from", "to", "migration_artifact_digest"],
        "properties": {
          "volume_id": { "type": "string" },
          "from": { "type": "string", "description": "Expected starting schema version." },
          "to": { "type": "string", "description": "Target schema version." },
          "migration_artifact_digest": {
            "type": "string",
            "description": "Digest reference to the migration code/module (script, wasm, etc.)."
          },
          "placement": {
            "type": "string",
            "description": "Where to run the migration (host-jail, microvm, other)."
          },
          "timeout_s": { "type": "integer", "minimum": 1 },
          "requires_downtime": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "signature": { "type": "string" }
  },
  "additionalProperties": false
}
