{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD time event (time.event) (v0.1)",
  "allOf": [
    {
      "$ref": "event.record.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "event_version",
        "event_id",
        "at",
        "source",
        "severity",
        "subject",
        "action"
      ],
      "properties": {
        "kind": {
          "const": "time-event"
        },
        "event_version": {
          "type": "string",
          "pattern": "^0\\.\\d+$"
        },
        "event_id": {
          "type": "string",
          "description": "Stable id (UUID recommended)."
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "Producer name (timed, chronyd, ptpd, etc.)."
            },
            "host_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error",
            "critical"
          ]
        },
        "subject": {
          "type": "object",
          "required": [
            "host_id"
          ],
          "properties": {
            "host_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "action": {
          "type": "string",
          "enum": [
            "sync-acquired",
            "sync-lost",
            "source-changed",
            "clock-stepped",
            "clock-slewed",
            "leap-announced",
            "leap-applied",
            "quorum-failed",
            "divergence-detected",
            "misbehavior-proof-captured"
          ]
        },
        "metrics": {
          "type": "object",
          "properties": {
            "offset_ms": {
              "type": "number"
            },
            "uncertainty_ms": {
              "type": "number"
            },
            "step_ms": {
              "type": "number"
            },
            "stratum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16
            },
            "reference_source_id": {
              "type": "string"
            },
            "authenticated": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "properties": {
            "time_sync_snapshot_digest": {
              "type": "string"
            },
            "time_sync_receipt_digest": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
