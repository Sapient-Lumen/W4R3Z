{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Policy Trace (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "trace_version",
    "lock_digest",
    "engine",
    "decision",
    "matched_rules"
  ],
  "properties": {
    "kind": {
      "const": "policy-trace"
    },
    "trace_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "lock_digest": {
      "type": "string",
      "description": "Digest of the Lock object that was evaluated."
    },
    "engine": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "policy_digest": {
          "type": "string",
          "description": "Optional digest of the policy bundle/module used."
        }
      },
      "additionalProperties": false
    },
    "inputs_used": {
      "type": "array",
      "description": "Only policy-relevant external inputs that influenced the outcome.",
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "properties": {
          "name": {"type": "string"},
          "digest": {"type": "string"},
          "uri": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "required": ["allowed"],
      "properties": {
        "allowed": {"type": "boolean"},
        "reason_code": {
          "type": "string",
          "description": "Stable enum-like string suitable for gates and UX."
        },
        "deny_reason": {
          "type": "string",
          "description": "One-line safe summary (no secrets)."
        }
      },
      "additionalProperties": false
    },
    "matched_rules": {
      "type": "array",
      "description": "Stable, minimal rule-level explanation (LLM-friendly; no secrets).",
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": {"type": "string"},
          "result": {"type": "string", "enum": ["allow", "deny", "note"]},
          "message": {"type": "string"},
          "bindings": {
            "type": "object",
            "description": "Minimal safe bindings (no secrets; digests only).",
            "additionalProperties": {
              "type": ["string", "number", "boolean", "null"]
            }
          },
          "source": {
            "type": "object",
            "description": "Optional pointer back to a policy bundle location.",
            "properties": {
              "path": {"type": "string"},
              "span": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "obligations": {
      "type": "array",
      "description": "Machine-checkable follow-up actions imposed by policy.",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {"type": "string"},
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number", "boolean", "null", "array", "object"]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "redactions": {
      "type": "array",
      "description": "If the engine withheld fields for safety, record the fact.",
      "items": {
        "type": "object",
        "required": ["field", "reason"],
        "properties": {
          "field": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
