{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Defines first-class product shapes (A\u2013D) as compilation targets for defaults, gates, and lanes (no forks).",
  "properties": {
    "profiles": {
      "additionalProperties": false,
      "description": "Map of product profile ids to profile definitions.",
      "properties": {
        "appliance_factory": {
          "$ref": "product.profile.schema.json"
        },
        "fleet_host": {
          "$ref": "product.profile.schema.json"
        },
        "general_os": {
          "$ref": "product.profile.schema.json"
        },
        "workstation": {
          "$ref": "product.profile.schema.json"
        }
      },
      "required": [
        "fleet_host",
        "workstation",
        "general_os",
        "appliance_factory"
      ],
      "type": "object"
    },
    "version": {
      "description": "Schema payload version for this file format (not the archive version).",
      "type": "string"
    }
  },
  "required": [
    "version",
    "profiles"
  ],
  "title": "DeriveBSD product profiles",
  "type": "object"
}
