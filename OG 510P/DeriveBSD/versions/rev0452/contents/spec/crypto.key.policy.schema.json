{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD crypto key policy (crypto.key.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "created_at",
    "keys"
  ],
  "properties": {
    "kind": { "const": "crypto.key.policy" },
    "policy_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "policy_id": { "type": "string", "description": "Stable id (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "keys": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/key" }
    },

    "notes": { "type": "string" },
    "signature": { "type": "string", "description": "Optional signature over canonical bytes (policy-dependent)." }
  },
  "$defs": {
    "key": {
      "type": "object",
      "required": [
        "key_id",
        "class",
        "backend",
        "export_posture",
        "allowed_ops",
        "access"
      ],
      "properties": {
        "key_id": { "type": "string" },

        "class": {
          "type": "string",
          "enum": ["signing", "encryption", "identity", "attestation", "tunnel", "other"]
        },
        "description": { "type": "string" },

        "backend": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "type": "string", "enum": ["keyvm", "tpm", "pkcs11", "kms", "software"] },
            "ref": { "type": "string", "description": "Backend locator (slot, handle, kms path)." }
          },
          "additionalProperties": true
        },

        "export_posture": { "type": "string", "enum": ["nonexportable", "exportable"], "default": "nonexportable" },

        "allowed_ops": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["sign", "decrypt", "derive", "ssh-sign", "custom"] }
        },

        "algorithms": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional algorithm constraints (e.g. ed25519, ecdsa-p256, rsa-pss-2048)."
        },

        "user_presence": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean", "default": false },
            "mode": { "type": "string", "enum": ["tty", "gui", "oob", "hardware", "any"] },
            "timeout_seconds": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },

        "approvals": {
          "type": "object",
          "properties": {
            "quorum": { "type": "integer", "minimum": 1 },
            "group": { "type": "string", "description": "Policy-defined approver group id." }
          },
          "additionalProperties": false
        },

        "rotation": {
          "type": "object",
          "properties": {
            "rotation_interval_days": { "type": "integer", "minimum": 1 },
            "rotate_on_boot": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },

        "access": {
          "type": "object",
          "required": ["selectors"],
          "properties": {
            "selectors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "service_id": { "type": "string" },
                  "workload_label": { "type": "string" },
                  "vm_id": { "type": "string" },
                  "jail_id": { "type": "string" },
                  "user": { "type": "string" }
                },
                "additionalProperties": false
              }
            },

            "require_attestation": { "type": "boolean", "default": false },
            "attestation_ref": { "type": "string", "description": "Optional digest/id of an attestation requirement or admission policy." }
          },
          "additionalProperties": false
        },

        "audit": {
          "type": "object",
          "properties": {
            "emit_receipts": { "type": "boolean", "default": true },
            "emit_denials": { "type": "boolean", "default": true },
            "retention_class": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
