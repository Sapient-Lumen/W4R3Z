{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD policy suggestion (policy.suggestion) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "suggestion_version",
    "created_at",
    "target",
    "patch",
    "evidence"
  ],
  "properties": {
    "kind": {
      "const": "policy-suggestion"
    },
    "suggestion_version": {
      "type": "string",
      "const": "0.1"
    },
    "suggestion_id": {
      "type": "string",
      "description": "Stable id (UUID recommended) for correlation/review threads."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "session": {
      "type": "object",
      "description": "Optional learning/audit session metadata.",
      "properties": {
        "session_id": { "type": "string" },
        "tool": { "type": "string" },
        "mode": {
          "type": "string",
          "enum": ["observe", "audit", "learn"]
        },
        "window": {
          "type": "string",
          "description": "Bounded window descriptor (e.g., '10m', '1000 events')."
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "description": "What this suggestion proposes to change.",
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "type": "string",
          "description": "Target object kind (e.g., sandbox.profile, net.egress.policy, resource.profile, trust.policy)."
        },
        "ref": {
          "type": "string",
          "description": "Stable identifier or repo-relative path for the policy source under review."
        },
        "base_digest": {
          "type": "string",
          "description": "Digest of the policy source that the patch was derived from (if available)."
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "patch": {
      "type": "object",
      "description": "A reviewable patch; prefer structured formats for machine application.",
      "required": ["format", "body"],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "json-merge-patch",
            "jsonpatch",
            "unified-diff",
            "hujson-source-diff"
          ]
        },
        "body": {
          "description": "Patch body. JSON for json-* formats; string for textual diffs.",
          "oneOf": [
            { "type": "object" },
            { "type": "array" },
            { "type": "string" }
          ]
        },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "description": "Evidence objects that justify this suggestion (traces, receipts, snapshots).",
      "required": ["refs"],
      "properties": {
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "digest"],
            "properties": {
              "kind": { "type": "string" },
              "digest": { "type": "string" },
              "uri": { "type": "string" },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "description": "Safety/guardrail metadata; defaults assume human review.",
      "properties": {
        "auto_apply": {
          "type": "boolean",
          "default": false
        },
        "requires_review": {
          "type": "boolean",
          "default": true
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "description": "Optional signature envelope.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
