{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD boot assessment bless receipt (boot-bless-receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "at",
    "host",
    "be_name",
    "decision",
    "tries"
  ],
  "properties": {
    "kind": { "const": "boot-bless-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },

    "receipt_id": { "type": "string", "description": "Stable id (UUID recommended)." },
    "at": { "type": "string", "format": "date-time" },

    "host": {
      "type": "object",
      "required": ["host_id", "generation_digest"],
      "properties": {
        "host_id": { "type": "string" },
        "generation_digest": { "type": "string" },
        "boot_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "be_name": { "type": "string", "description": "Boot environment name/id that was evaluated." },

    "decision": {
      "type": "string",
      "enum": ["good", "bad"],
      "description": "Whether this boot is blessed as good (commit) or marked bad (trigger fallback)."
    },

    "tries": {
      "type": "object",
      "required": ["left", "done"],
      "properties": {
        "left": { "type": "integer", "minimum": 0 },
        "done": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },

    "ledger": {
      "type": "object",
      "description": "How try-counters are persisted/updated on this platform.",
      "properties": {
        "backend": { "type": "string", "enum": ["bls", "efi-vars", "zfs-ledger", "other"] },
        "details": { "type": "string" }
      },
      "additionalProperties": false
    },

    "gate_policy_digest": {
      "type": "string",
      "description": "Optional digest pointer to the boot.health.gate.policy used for this decision."
    },

    "boot_health_report_digest": { "type": "string", "description": "Digest of boot-health-report that drove the decision (if present)." },

    "correlation": {
      "type": "object",
      "description": "Pointers tying this bless decision back to a change-set or activation run.",
      "properties": {
        "change_set_digest": { "type": "string" },
        "change_receipt_digest": { "type": "string" },
        "activation_receipt_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "notes": { "type": "string" },

    "signature": {
      "type": "object",
      "description": "Optional signature over the receipt body.",
      "properties": {
        "alg": { "type": "string" },
        "key_id": { "type": "string" },
        "sig": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
