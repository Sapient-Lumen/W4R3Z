{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD closure diff (closure.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from",
    "to",
    "roots_added",
    "roots_removed",
    "paths_added",
    "paths_removed"
  ],
  "properties": {
    "kind": {
      "const": "closure.diff"
    },
    "diff_version": {
      "type": "string",
      "const": "0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "from": {
      "$ref": "#/$defs/ref"
    },
    "to": {
      "$ref": "#/$defs/ref"
    },
    "roots_added": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "roots_removed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "paths_added": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path_entry"
      }
    },
    "paths_removed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path_entry"
      }
    },
    "new_origins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/origin"
      }
    },
    "risk_tags_added": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "channel, publisher, upstream, repo"
        },
        "id": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "path_entry": {
      "type": "object",
      "required": [
        "store_path"
      ],
      "properties": {
        "store_path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "nar_hash": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/origin"
          }
        },
        "risk_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}