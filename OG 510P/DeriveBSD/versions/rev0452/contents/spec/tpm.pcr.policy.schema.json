{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD TPM PCR policy (tpm.pcr.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "policy_id",
    "created_at",
    "clauses"
  ],
  "properties": {
    "kind": {"const": "tpm.pcr.policy"},
    "policy_version": {"type": "string", "const": "0.1"},

    "policy_id": {"type": "string", "description": "Stable id (UUID or human-stable id)."},
    "created_at": {"type": "string", "format": "date-time"},

    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/clause"},
      "description": "OR-list of acceptable PCR policy clauses (upgrade-friendly)."
    },

    "notes": {"type": "string"},
    "signature": {"type": "string", "description": "Optional signature over canonical bytes (policy-dependent)."}
  },
  "$defs": {
    "clause": {
      "type": "object",
      "required": ["clause_id", "bank", "pcr_selection"],
      "properties": {
        "clause_id": {"type": "string"},

        "bank": {"type": "string", "description": "PCR hash bank (e.g., sha256)."},
        "pcr_selection": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0, "maximum": 23}
        },

        "expected_pcr_digest": {
          "type": "string",
          "description": "Optional digest of the selected PCR values at seal time (encoding policy-defined)."
        },

        "anchor": {
          "type": "object",
          "description": "Optional linkage to DeriveBSD boot/generation evidence objects.",
          "properties": {
            "deployment_ref_digest": {"type": "string"},
            "boot_manifest_digest": {"type": "string"},
            "eventlog_digest": {"type": "string"}
          },
          "additionalProperties": false
        },

        "tpm": {
          "type": "object",
          "description": "Optional TPM-side policy metadata pointers.",
          "properties": {
            "policy_digest": {"type": "string", "description": "TPM policy digest (encoding policy-defined)."},
            "authorizing_key_id": {"type": "string", "description": "Optional key id used with PolicyAuthorize."}
          },
          "additionalProperties": false
        },

        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
