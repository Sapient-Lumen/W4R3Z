{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD build stabilizer receipt (build.stabilizer.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_digest",
    "policy_digest",
    "stabilizers",
    "result"
  ],
  "properties": {
    "kind": { "const": "build.stabilizer.receipt" },
    "receipt_version": { "type": "string", "const": "0.1" },
    "receipt_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },

    "plan_digest": { "type": "string", "description": "Digest of the build plan or stabilizer plan fragment used." },
    "policy_digest": { "type": "string", "description": "Digest of the policy that allowed/selected stabilizers." },

    "subject": {
      "type": "object",
      "description": "What this receipt applies to (optional if embedded/linked by higher-level receipts).",
      "required": ["kind", "ref", "digest"],
      "properties": {
        "kind": { "type": "string", "description": "Artifact kind (e.g., derivation, closure, bundle, pkg)." },
        "ref": { "type": "string" },
        "digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "stabilizers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stabilizer" }
    },

    "notes": { "type": "array", "items": { "type": "string" } },

    "result": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "deny", "fail"] },
        "message": { "type": "string" },
        "log_digest": { "type": "string", "description": "Digest of logs or supporting evidence objects." }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "stabilizer": {
      "type": "object",
      "required": ["id", "stage", "status"],
      "properties": {
        "id": { "type": "string", "description": "Stable identifier (registry-managed)." },
        "version": { "type": "string", "description": "Tool/library version (if applicable)." },
        "stage": { "type": "string", "enum": ["env", "input", "output"], "description": "Where the stabilizer applies." },
        "status": { "type": "string", "enum": ["applied", "skipped", "deny", "fail"] },
        "params_digest": { "type": "string", "description": "Digest of the stabilizer configuration/parameters." },
        "rationale": { "type": "string", "description": "Short reason the stabilizer was selected (policy trace summary)." },
        "effects": {
          "type": "object",
          "description": "Optional compact summary of the effect surface; deeper diffs live in logs/evidence objects.",
          "properties": {
            "touched_paths": { "type": "integer", "minimum": 0 },
            "bytes_changed": { "type": "integer", "minimum": 0 },
            "output_digest_before": { "type": "string" },
            "output_digest_after": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
