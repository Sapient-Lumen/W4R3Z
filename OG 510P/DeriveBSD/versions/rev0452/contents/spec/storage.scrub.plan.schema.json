{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD storage scrub plan (storage.scrub.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "created_at",
    "target",
    "pools"
  ],
  "properties": {
    "kind": {"const": "storage-scrub-plan"},
    "plan_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "plan_id": {"type": "string", "description": "Stable id for the plan (UUID recommended)."},
    "created_at": {"type": "string", "format": "date-time"},
    "target": {
      "type": "object",
      "required": ["host_id"],
      "properties": {
        "host_id": {"type": "string"},
        "generation_digest": {"type": "string"}
      },
      "additionalProperties": false
    },
    "pools": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "mode": {
      "type": "string",
      "enum": ["now", "within-window", "periodic"],
      "default": "now"
    },
    "window": {
      "type": "object",
      "description": "Optional time window for execution.",
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "throttle": {
      "type": "object",
      "description": "Optional throttling hints (best-effort).",
      "properties": {
        "max_iops": {"type": "integer", "minimum": 0},
        "max_mib_per_sec": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "checkpoint_before": {
      "type": "boolean",
      "description": "Optional: create a pool checkpoint before starting (policy-gated; may have restrictions).",
      "default": false
    },
    "preconditions": {
      "type": "object",
      "properties": {
        "min_pool_health": {"type": "string", "enum": ["ONLINE", "DEGRADED"], "default": "ONLINE"}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
