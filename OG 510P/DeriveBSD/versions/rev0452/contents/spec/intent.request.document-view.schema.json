{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD document-view intent request profile (intent.request.document-view) (v0.1)",
  "allOf": [
    {
      "$ref": "intent.request.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {"const": "intent-request"},
        "action": {"const": "view"},
        "subject": {
          "type": "object",
          "properties": {
            "type": {"const": "file"}
          },
          "required": ["type"]
        }
      },
      "required": ["action", "subject"]
    }
  ]
}
