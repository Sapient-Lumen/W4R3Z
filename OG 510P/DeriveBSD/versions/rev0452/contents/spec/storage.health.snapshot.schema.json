{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD storage health snapshot (storage.health.snapshot) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "snapshot_version",
    "captured_at",
    "host",
    "pools"
  ],
  "properties": {
    "kind": {"const": "storage-health-snapshot"},
    "snapshot_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "snapshot_id": {"type": "string", "description": "Stable id (UUID recommended)."},
    "captured_at": {"type": "string", "format": "date-time"},
    "host": {
      "type": "object",
      "required": ["host_id", "generation_digest"],
      "properties": {
        "host_id": {"type": "string"},
        "generation_digest": {"type": "string"},
        "boot_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pool_name", "health"],
        "properties": {
          "pool_name": {"type": "string"},
          "health": {
            "type": "string",
            "enum": ["ONLINE", "DEGRADED", "FAULTED", "UNAVAIL", "SUSPENDED", "UNKNOWN"]
          },
          "capacity": {
            "type": "object",
            "properties": {
              "size_bytes": {"type": "integer", "minimum": 0},
              "alloc_bytes": {"type": "integer", "minimum": 0},
              "free_bytes": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "errors": {
            "type": "object",
            "properties": {
              "read": {"type": "integer", "minimum": 0},
              "write": {"type": "integer", "minimum": 0},
              "cksum": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "last_scrub": {
            "type": "object",
            "properties": {
              "started_at": {"type": "string", "format": "date-time"},
              "ended_at": {"type": "string", "format": "date-time"},
              "status": {"type": "string", "enum": ["success", "failed", "partial", "unknown"]},
              "errors_found": {"type": "integer", "minimum": 0},
              "errors_repaired": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "resilver": {
            "type": "object",
            "properties": {
              "in_progress": {"type": "boolean"},
              "started_at": {"type": "string", "format": "date-time"},
              "progress_percent": {"type": "number", "minimum": 0, "maximum": 100}
            },
            "additionalProperties": false
          },
          "checkpoint": {
            "type": "object",
            "properties": {
              "present": {"type": "boolean"},
              "created_at": {"type": "string", "format": "date-time"}
            },
            "additionalProperties": false
          },
          "devices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["device_id_hash", "status"],
              "properties": {
                "device_id_hash": {"type": "string"},
                "status": {"type": "string", "enum": ["ok", "warn", "fail", "unknown"]},
                "transport": {"type": "string", "enum": ["ata", "scsi", "nvme", "usb", "other"]},
                "notes": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "warnings": {"type": "array", "items": {"type": "string"}},
          "evidence": {
            "type": "array",
            "description": "Pointers to raw command outputs or derived verify objects (digest pointers).",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
