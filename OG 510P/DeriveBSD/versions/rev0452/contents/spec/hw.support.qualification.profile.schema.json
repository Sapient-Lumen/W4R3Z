{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD hardware support qualification profile (hw.support.qualification.profile) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "profile_version",
    "profile_id",
    "created_at",
    "target",
    "scope",
    "required_checks",
    "freshness",
    "acceptance"
  ],
  "properties": {
    "kind": {
      "const": "hw.support.qualification.profile"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "profile_id": {
      "type": "string",
      "description": "Stable id for this qualification profile (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "artifact_kind",
        "artifact_digest",
        "release_train"
      ],
      "properties": {
        "artifact_kind": {
          "type": "string",
          "enum": [
            "host.generation",
            "release.capsule",
            "reset.authorization",
            "base.set"
          ]
        },
        "artifact_digest": {
          "type": "string"
        },
        "boot_manifest_digest": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "release_train": {
          "type": "string",
          "description": "Release-train identifier this artifact is scoped to."
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "profiles",
        "support_levels",
        "roles"
      ],
      "properties": {
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "support_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "supported",
              "conditional",
              "canary-only",
              "maintenance-only"
            ]
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "boot-storage",
              "primary-network",
              "trusted-display",
              "trusted-input",
              "maintenance-network",
              "usb-quarantine",
              "gpu-accel",
              "camera",
              "microphone",
              "tpm",
              "general"
            ]
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "purpose",
          "accepted_evidence_kinds",
          "blocking"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "inventory-baseline",
              "preflight-check",
              "boot",
              "generation-switch",
              "rollback-or-recovery",
              "trusted-ui-basic",
              "network-basic",
              "device-mediation-basic",
              "suspend-resume",
              "field-regression-watch",
              "vendor-evidence"
            ]
          },
          "accepted_evidence_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "hw.inventory.receipt",
                "hw.compat.report",
                "restore-drill-receipt",
                "ui.secure_attention.receipt",
                "fw-update-receipt",
                "bundle.build.receipt",
                "vendor.qualification.bundle",
                "lab.run.summary"
              ]
            }
          },
          "required_profiles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "required_support_levels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "supported",
                "conditional",
                "canary-only",
                "maintenance-only"
              ]
            }
          },
          "required_roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "boot-storage",
                "primary-network",
                "trusted-display",
                "trusted-input",
                "maintenance-network",
                "usb-quarantine",
                "gpu-accel",
                "camera",
                "microphone",
                "tpm",
                "general"
              ]
            }
          },
          "blocking": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance": {
      "type": "object",
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "enum": [
            "all-applicable-blocking-checks-pass"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "freshness": {
      "type": "object",
      "required": [
        "max_age_days_by_stage",
        "reverify_on"
      ],
      "properties": {
        "max_age_days_by_stage": {
          "type": "object",
          "required": [
            "lab-validated",
            "canary-observed",
            "release-qualified",
            "field-sustained"
          ],
          "properties": {
            "lab-validated": {
              "type": "integer",
              "minimum": 1
            },
            "canary-observed": {
              "type": "integer",
              "minimum": 1
            },
            "release-qualified": {
              "type": "integer",
              "minimum": 1
            },
            "field-sustained": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "description": "Maximum age in days before receipts at each qualification stage stop counting as fresh support evidence."
        },
        "reverify_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "kernel-or-kmod-change",
              "firmware-change",
              "boot-manifest-change",
              "role-regression",
              "qualification-profile-change",
              "recovery-lane-change"
            ]
          },
          "description": "Change classes that invalidate freshness early and require requalification."
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
