{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD export policy (export.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "policy_id",
    "created_at",
    "rules"
  ],
  "properties": {
    "kind": {
      "const": "export.policy"
    },
    "policy_version": {
      "type": "string",
      "const": "0.1"
    },
    "policy_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "consent": {
      "type": "object",
      "description": "Consent/approval requirements.",
      "properties": {
        "interactive": {
          "type": "boolean",
          "default": true,
          "description": "If true, require a portal-style approval flow."
        },
        "two_person": {
          "type": "boolean",
          "default": false
        },
        "approvers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "recipients": {
      "type": "object",
      "description": "Recipient constraints (who may receive the export).",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "internal",
            "external-vendor",
            "customer",
            "public"
          ],
          "default": "external-vendor"
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Emails, org ids, ticketing realms, etc."
        },
        "require_ticket": {
          "type": "boolean",
          "default": true
        },
        "ticket_pattern": {
          "type": "string",
          "description": "Optional regex for ticket ids."
        }
      },
      "additionalProperties": false
    },
    "encryption": {
      "type": "object",
      "description": "Encryption requirement for exports.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "age",
            "cms",
            "pgp"
          ],
          "default": "age"
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Recipient keys/ids."
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_kind"
        ],
        "properties": {
          "artifact_kind": {
            "type": "string",
            "description": "Kind selector (e.g. incident-bundle, trace.output, crash-report)."
          },
          "redaction_transform_digest": {
            "type": "string",
            "description": "Required redaction.transform digest for this artifact kind (if any)."
          },
          "allow_metadata_only": {
            "type": "boolean",
            "default": true
          },
          "allow_raw_blobs": {
            "type": "boolean",
            "default": false,
            "description": "If true, allows blob payloads (e.g., coredumps) when policy permits."
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "lease_required": {
      "type": "boolean",
      "default": true,
      "description": "If true, exporting requires a lease (portal grant or breakglass grant)."
    },
    "signature": {
      "type": "string",
      "description": "Optional signature over the canonicalized policy."
    },
    "transport_policy_digest": {
      "type": "string",
      "description": "Optional digest of transport.policy constraining which transport adapters may be used."
    },
    "transparency": {
      "type": "object",
      "description": "Optional transparency logging requirements for exports (records the act of sharing without revealing the shared contents).",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "rekor",
            "trillian",
            "scitt",
            "custom"
          ],
          "default": "none"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "If true, export is only considered complete when a transparency entry is committed (with inclusion proof/checkpoint)."
        },
        "log_uri": {
          "type": "string",
          "description": "Log endpoint identifier/URI (no secrets)."
        },
        "metadata_profile": {
          "type": "string",
          "enum": [
            "minimal",
            "standard"
          ],
          "default": "minimal",
          "description": "Controls how much metadata is logged (e.g., hashed ticket id vs clear)."
        },
        "hash_ticket_id": {
          "type": "boolean",
          "default": true
        },
        "hash_recipient": {
          "type": "boolean",
          "default": true
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
