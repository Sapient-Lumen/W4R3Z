{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD release halt event (release.halt.event) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "event_version",
    "event_id",
    "created_at",
    "authority_policy_digest",
    "action"
  ],
  "properties": {
    "kind": {"const": "release.halt.event"},
    "event_version": {"type": "string", "const": "0.1"},
    "event_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},

    "authority_policy_digest": {"type": "string"},
    "scope": {
      "type": "object",
      "properties": {
        "namespace": {"type": "string"},
        "channel": {"type": "string"},
        "subject_name": {"type": "string"}
      },
      "additionalProperties": true
    },

    "action": {"type": "string", "enum": ["halt", "resume"]},
    "expires_at": {"type": "string", "format": "date-time"},
    "reason": {"type": "string"},

    "related_incident_bundle_digest": {"type": "string"},

    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key_id", "sig"],
        "properties": {
          "key_id": {"type": "string"},
          "sig": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
