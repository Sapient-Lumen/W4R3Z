{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD restore plan (restore.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "source",
    "target"
  ],
  "properties": {
    "kind": {
      "const": "restore.plan"
    },
    "plan_version": {
      "type": "string",
      "const": "0.1"
    },
    "plan_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "backup_receipt_digest"
      ],
      "properties": {
        "backup_receipt_digest": {
          "type": "string"
        },
        "snapshot_set": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transport_receipt_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "quarantine-namespace",
            "replacement-target",
            "microvm-drill",
            "readonly-mount",
            "other"
          ]
        },
        "dataset": {
          "type": "string"
        },
        "mount_point": {
          "type": "string"
        },
        "host_id": {
          "type": "string"
        },
        "domain_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "encryption": {
      "type": "object",
      "properties": {
        "crypto_policy_digest": {
          "type": "string"
        },
        "key_source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional declared post-restore checks (mount-only, health checks, smoke tests)."
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replacement_precondition": {
      "type": "object",
      "description": "Required when target.mode=replacement-target. Explains why live replacement is allowed instead of quarantine-first restore.",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "quarantine-verified",
            "breakglass-approved"
          ]
        },
        "prior_restore_receipt_digest": {
          "type": "string",
          "description": "Digest of a prior restore.receipt proving quarantine/drill verification before live replacement."
        },
        "authority_receipt_digest": {
          "type": "string",
          "description": "Digest of an authority/breakglass receipt permitting direct replacement."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "quarantine-verified"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "prior_restore_receipt_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "breakglass-approved"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "authority_receipt_digest"
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "replacement-target"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "target"
        ]
      },
      "then": {
        "required": [
          "replacement_precondition"
        ]
      }
    }
  ]
}
