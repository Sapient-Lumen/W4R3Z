{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Workload Identity Lease (workload-identity-lease) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "lease_version",
    "lease",
    "subject",
    "spiffe_id",
    "credential"
  ],
  "properties": {
    "kind": {"const": "workload-identity-lease"},
    "lease_version": {"type": "string", "const": "0.1"},

    "lease": {"$ref": "lease.envelope.schema.json"},

    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": {"type": "string"},
        "digest": {"type": "string"},
        "instance": {"type": "string"}
      },
      "additionalProperties": false
    },

    "spiffe_id": {
      "type": "string",
      "description": "Workload identity string (SPIFFE-style)."
    },

    "credential": {
      "type": "object",
      "required": ["type", "expires_at"],
      "properties": {
        "type": {"type": "string", "enum": ["x509-svid", "jwt-svid"]},
        "expires_at": {"type": "string", "format": "date-time"},

        "bundle_digest": {"type": "string", "description": "Digest of the credential bundle (cert chain / token set) if exported as an object."},
        "cert_chain_digests": {"type": "array", "items": {"type": "string"}},
        "jwt_digest": {"type": "string"},

        "key_handle": {"type": "string", "description": "Opaque key handle (TPM, broker, or OS keystore)."},
        "trust_bundle_digest": {"type": "string", "description": "Digest of the trust bundle used by peers to validate this credential."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
