{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD backup receipt (backup.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_id",
    "plan_digest",
    "results"
  ],
  "properties": {
    "kind": { "const": "backup-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "receipt_id": { "type": "string", "description": "Stable id for this receipt (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "plan_id": { "type": "string" },
    "plan_digest": { "type": "string", "description": "Digest of the backup.plan that was executed." },

    "host": {
      "type": "object",
      "properties": {
        "machine_id": { "type": "string" },
        "boot_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dataset", "snapshot"],
        "properties": {
          "dataset": { "type": "string" },
          "snapshot": { "type": "string", "description": "Snapshot name or identifier." },
          "snapshot_guid": { "type": "string" },
          "content_digest": { "type": "string", "description": "Digest of the exported bytes (stream/pack)." },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "transport_receipt_digest": { "type": "string", "description": "Digest of transport receipt proving delivery." },
          "crypto_op_receipt_digest": { "type": "string", "description": "Digest of crypto.op.receipt if encryption/signing used." }
        },
        "additionalProperties": false
      }
    },

    "retention": {
      "type": "object",
      "description": "Optional summary of pruning actions taken.",
      "properties": {
        "pruned_objects": { "type": "integer", "minimum": 0 },
        "pruned_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "status": { "type": "string", "enum": ["success", "partial", "failed"], "default": "success" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
