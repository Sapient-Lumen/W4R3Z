{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD service contract handle (svc-contract-handle) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "handle_version",
    "handle_id",
    "created_at",
    "service_id",
    "backend",
    "backend_ref"
  ],
  "properties": {
    "kind": { "const": "svc-contract-handle" },
    "handle_version": { "type": "string", "pattern": "^0\\.\\d+$" },

    "handle_id": { "type": "string", "description": "Opaque stable handle identifier (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "service_id": { "type": "string" },
    "instance_id": { "type": "string", "description": "Optional service instance id (default semantic: 'default')." },

    "backend": { "type": "string", "enum": ["jail", "microvm", "procgroup", "other"] },

    "backend_ref": {
      "type": "object",
      "description": "Backend-specific identity for the contract boundary.",
      "properties": {
        "jail_id": { "type": "string" },
        "jail_name": { "type": "string" },
        "vm_id": { "type": "string" },
        "worker_domain": { "type": "string" },
        "pgid": { "type": "integer" },
        "session_id": { "type": "integer" },
        "root_pid": { "type": "integer" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },

    "restarter": {
      "type": "object",
      "description": "Restarter component owning this handle.",
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "string" },
        "domain": { "type": "string" }
      },
      "additionalProperties": false
    },

    "scope": {
      "type": "object",
      "description": "Optional extra scoping identifiers (useful for incident export/redaction policies).",
      "properties": {
        "host_id": { "type": "string" },
        "generation_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "meta": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
