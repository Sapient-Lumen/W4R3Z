{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD AppVM storage receipt (appvm.storage.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_digest",
    "appvm",
    "result",
    "attached_storage"
  ],
  "properties": {
    "kind": {"const": "appvm.storage.receipt"},
    "receipt_version": {"type": "string", "const": "0.1"},
    "receipt_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "plan_digest": {"type": "string"},
    "appvm": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "instance_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "result": {"type": "string", "enum": ["applied", "failed"]},
    "attached_storage": {
      "type": "object",
      "required": ["template_root", "private_storage", "volatile_storage"],
      "properties": {
        "template_root": {
          "type": "object",
          "required": ["digest", "readonly"],
          "properties": {
            "digest": {"type": "string"},
            "readonly": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "private_storage": {"$ref": "#/$defs/storage"},
        "volatile_storage": {"$ref": "#/$defs/storage"},
        "portable_home": {
          "type": "object",
          "properties": {
            "attached": {"type": "boolean"},
            "home_area_id": {"type": "string"},
            "lease_id": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "storage": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["zfs-dataset", "qcow2", "raw", "tmpfs", "other"]},
        "digest": {"type": "string"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "quota_bytes": {"type": "integer", "minimum": 0},
        "wipe_on_shutdown": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
