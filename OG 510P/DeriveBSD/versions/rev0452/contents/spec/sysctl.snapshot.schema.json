{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD sysctl observation snapshot (sysctl.snapshot) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "snapshot_version",
    "snapshot_id",
    "captured_at",
    "subject",
    "values"
  ],
  "properties": {
    "kind": {"const": "sysctl.snapshot"},
    "snapshot_version": {"type": "string", "const": "0.1"},
    "snapshot_id": {
      "type": "string",
      "description": "Stable id for the snapshot (UUID recommended)."
    },
    "captured_at": {"type": "string", "format": "date-time"},

    "source": {
      "type": "object",
      "description": "Emitter metadata (drift-checker, bundle builder, etc.).",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "host_id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "subject": {
      "type": "object",
      "required": ["host_id"],
      "properties": {
        "host_id": {"type": "string"},
        "domain": {"type": "string", "description": "Optional compartment/domain identifier."},
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "generation_id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "plan_digest": {
      "type": "string",
      "description": "Digest of the sysctl.plan used as the expected baseline (optional)."
    },

    "values": {
      "type": "array",
      "minItems": 1,
      "description": "Observed sysctl values for a bounded keyset (typically the keys in the last applied plan).",
      "items": {"$ref": "#/$defs/value"}
    },

    "summary": {
      "type": "object",
      "description": "Optional totals (helps UIs and bundles stay fast).",
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "match": {"type": "integer", "minimum": 0},
        "drift": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "read_error": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },

    "policy_decision_digest": {
      "type": "string",
      "description": "Digest of the policy decision authorizing snapshot collection/export (optional)."
    },

    "errors": {
      "type": "array",
      "description": "Non-fatal collection errors (kept small; avoid raw command output).",
      "items": {"type": "string"}
    },

    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "value": {
      "type": "object",
      "required": ["key", "observed"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-zA-Z0-9_.:-]+$"},
        "observed": {"type": "string", "description": "Observed value encoded as a string (sysctl(8) compatible)."},
        "expected": {"type": "string", "description": "Expected value when a baseline is available (optional)."},
        "status": {
          "type": "string",
          "enum": ["match", "drift", "missing", "read-error"],
          "description": "Comparison status against expected when present (optional)."
        },
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
