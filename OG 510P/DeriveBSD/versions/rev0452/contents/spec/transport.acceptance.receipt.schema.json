{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD transport acceptance receipt (transport.acceptance.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "transport_receipt_digest",
    "artifact",
    "recipient",
    "outcome",
    "acceptance"
  ],
  "properties": {
    "kind": {
      "const": "transport.acceptance.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "transport_receipt_digest": {
      "type": "string"
    },
    "artifact": {
      "type": "object",
      "required": [
        "kind",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "recipient": {
      "type": "object",
      "required": [
        "recipient"
      ],
      "properties": {
        "recipient": {
          "type": "string"
        },
        "ticket_id": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "pending"
      ]
    },
    "acceptance": {
      "type": "object",
      "required": [
        "kind",
        "remote_reference"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ticket-visible",
            "portal-ingest",
            "signed-mdn",
            "manual-oob",
            "custom"
          ]
        },
        "remote_reference": {
          "type": "string"
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "remote_artifact_digest": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "remote_validator": {
          "type": "object",
          "description": "Remote representation/version validator echoed by the recipient lane for the accepted object.",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "etag-strong",
                "etag-weak",
                "version-id",
                "attachment-revision",
                "message-id",
                "opaque"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "remote_protection": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "versioned-noncurrent-retained",
                "retain-until",
                "policy-locked-retention",
                "legal-hold",
                "append-only-log",
                "opaque-reviewed"
              ]
            },
            "retain_until": {
              "type": "string",
              "format": "date-time"
            },
            "note": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "enum": [
                      "retain-until",
                      "policy-locked-retention"
                    ]
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "retain_until"
                ]
              }
            }
          ],
          "additionalProperties": false
        },
        "remote_locator": {
          "type": "object",
          "description": "Redacted non-secret recipient-side locator echoed by the acceptance lane for later retrieval/review of the accepted object.",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "uri-hint",
                "ticket-attachment",
                "portal-object",
                "message-part",
                "object-path",
                "opaque"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "accepted"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "acceptance": {
            "type": "object",
            "required": [
              "accepted_at"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
