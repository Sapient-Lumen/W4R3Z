{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD boot health gate policy (boot.health.gate.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "policy_id",
    "created_at",
    "success_point",
    "tries",
    "checks"
  ],
  "properties": {
    "kind": { "const": "boot.health.gate.policy" },
    "policy_version": { "type": "string", "const": "0.1" },

    "policy_id": { "type": "string", "description": "Stable identifier for this gate policy (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "success_point": {
      "type": "string",
      "description": "Named point at which a boot can be considered eligible to be blessed (after required checks run).",
      "enum": ["multi_user", "core_services_healthy", "control_plane_reachable", "custom"]
    },

    "tries": {
      "type": "object",
      "description": "Boot attempt bounds; bootloaders enforce try-counters; userspace can mark bad early.",
      "required": ["max_attempts"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1 },
        "rollback_on_exhaustion": { "type": "boolean", "default": true },
        "mark_bad_on_required_fail": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },

    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "class"],
        "properties": {
          "id": { "type": "string", "description": "Stable check id referenced in boot-health-report.checks[].id" },
          "class": { "type": "string", "enum": ["required", "wanted"] },
          "phase": { "type": "string", "enum": ["boot", "post_boot"], "default": "post_boot" },
          "timeout_s": { "type": "integer", "minimum": 1, "default": 60 },
          "retries": { "type": "integer", "minimum": 0, "default": 0 },
          "retry_backoff_s": { "type": "integer", "minimum": 0, "default": 0 },
          "description": { "type": "string" },
          "evidence_kinds": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional hint: expected evidence object kinds/digests the check will emit." 
          }
        },
        "additionalProperties": false
      }
    },

    "policy": {
      "type": "object",
      "description": "Optional higher-level knobs that influence how failures are handled.",
      "properties": {
        "commit_requires": {
          "type": "object",
          "properties": {
            "min_consecutive_good_boots": { "type": "integer", "minimum": 1, "default": 1 },
            "max_degraded_wanted": { "type": "integer", "minimum": 0, "default": 999 }
          },
          "additionalProperties": false
        },
        "rollback": {
          "type": "object",
          "properties": {
            "max_consecutive_bad": { "type": "integer", "minimum": 1, "default": 1 },
            "cooldown_s": { "type": "integer", "minimum": 0, "default": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
