{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Device Profile / Classification (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "profile_version",
    "device_id",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": { "const": "device-profile" },
    "profile_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "device_id": {
      "type": "string",
      "description": "Stable identifier (e.g., pci:bdf:0000:00:14.0 or usb:bus:dev:1:2)."
    },
    "transport": { "type": "string", "enum": ["pci", "usb", "virtio", "other"] },
    "class": { "type": "string", "description": "High-level device class (usb-controller, hid, storage, nic, gpu, etc)." },
    "hid": {
      "type": "object",
      "properties": {
        "danger_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["hid-keyboard", "hid-mouse", "hid-composite", "hid-gamepad", "hid-touch"]
          }
        }
      },
      "additionalProperties": true
    },
    "risk_tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Policy-facing tags (e.g., 'input-power', 'dma', 'firmware')."
    },
    "vendor": { "type": "string" },
    "model": { "type": "string" },
    "notes": { "type": "string" },
    "issued_at": { "type": "string", "description": "ISO8601 time." },
    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": { "type": "string" },
        "alg": { "type": "string" },
        "sig": { "type": "string", "description": "Signature over canonical JSON bytes." }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
