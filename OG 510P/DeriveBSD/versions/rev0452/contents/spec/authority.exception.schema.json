{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD authority exception (authority.exception) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "exception_version",
    "exception_id",
    "created_at",
    "budget_digest",
    "check_digest",
    "scope",
    "justification",
    "expires_at",
    "approvals"
  ],
  "properties": {
    "kind": {
      "const": "authority.exception"
    },
    "exception_version": {
      "type": "string",
      "const": "0.1"
    },
    "exception_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "budget_digest": {
      "type": "string"
    },
    "check_digest": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "subject",
        "dimension",
        "field",
        "classification",
        "allowed_value"
      ],
      "properties": {
        "subject": {
          "type": "object",
          "required": [
            "host_id",
            "profile_id",
            "domain_kind",
            "domain_id",
            "service_id",
            "generation_id"
          ],
          "properties": {
            "host_id": {
              "type": "string"
            },
            "profile_id": {
              "type": "string"
            },
            "domain_kind": {
              "type": "string",
              "enum": [
                "jail",
                "microvm",
                "process"
              ]
            },
            "domain_id": {
              "type": "string"
            },
            "service_id": {
              "type": "string"
            },
            "generation_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "dimension": {
          "type": "string",
          "enum": [
            "filesystem",
            "network",
            "devices",
            "trust",
            "observability"
          ]
        },
        "field": {
          "type": "string"
        },
        "classification": {
          "type": "string",
          "enum": [
            "narrowing",
            "broadening",
            "forbidden-presence",
            "missing-required-broker"
          ]
        },
        "allowed_value": {},
        "max_uses": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "justification": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "approver",
          "role"
        ],
        "properties": {
          "approver": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
