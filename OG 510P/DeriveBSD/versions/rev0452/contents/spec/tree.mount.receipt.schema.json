{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD on-demand tree mount receipt (tree.mount.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_digest",
    "result",
    "observed"
  ],
  "properties": {
    "kind": {
      "const": "tree.mount.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "receipt_id": {
      "type": "string",
      "description": "Stable id for the receipt (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_digest": {
      "type": "string",
      "description": "Digest of the tree.mount.plan being executed."
    },
    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation/domain/service).",
      "properties": {
        "host_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "domain_kind": {
          "type": "string",
          "enum": [
            "host",
            "jail",
            "microvm"
          ]
        },
        "domain_id": {
          "type": "string"
        },
        "service_id": {
          "type": "string"
        },
        "generation_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "string",
      "enum": [
        "applied",
        "skipped",
        "failed"
      ],
      "description": "Outcome of the mount attempt."
    },
    "observed": {
      "type": "object",
      "required": [
        "mount_point",
        "tree_digest",
        "realized_mode",
        "fallback_applied",
        "fetch_evidence_scope",
        "constraints_ok"
      ],
      "properties": {
        "mount_point": {
          "type": "string"
        },
        "tree_digest": {
          "type": "string"
        },
        "backend_type": {
          "type": "string"
        },
        "cache_hit": {
          "type": "boolean"
        },
        "mounted": {
          "type": "boolean"
        },
        "realized_mode": {
          "type": "string",
          "enum": [
            "materialize",
            "prefetch",
            "lazy"
          ]
        },
        "fallback_applied": {
          "type": "string",
          "enum": [
            "none",
            "materialize",
            "prefetch"
          ]
        },
        "fetch_evidence_scope": {
          "type": "string",
          "enum": [
            "digest-only",
            "path-level"
          ]
        },
        "constraints_ok": {
          "type": "boolean"
        },
        "remote_fetch_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "path_trace_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "description": "Optional structured errors (bounded; no raw logs).",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "policy_decision_digest": {
      "type": "string",
      "description": "Digest of the policy decision authorizing the mount (optional)."
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
