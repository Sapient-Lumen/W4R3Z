{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Debug Record Grant (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "target",
    "mode",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "debug-record-grant"},
    "grant_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "lease_id": {
      "type": "string",
      "description": "Optional lease identifier for revocable recording authority. Strongly recommended for any cross-compartment recording."
    },

    "target": {
      "type": "object",
      "description": "Selectors identifying what is recorded.",
      "properties": {
        "pid": {"type": "integer"},
        "jail_id": {"type": "string"},
        "microvm_id": {"type": "string"},
        "workload_id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "mode": {
      "type": "string",
      "description": "Recording backend/mode.",
      "enum": ["rr", "microvm-snapshot", "other"]
    },

    "constraints": {
      "type": "object",
      "description": "Optional bounds. Defaults are policy-defined.",
      "properties": {
        "max_duration_seconds": {"type": "integer", "minimum": 1},
        "max_bytes": {"type": "integer", "minimum": 1},
        "include_coredump": {"type": "boolean"},
        "redaction_profile_digest": {
          "type": "string",
          "description": "Optional digest of a deterministic redaction.transform artifact applied to outputs before export."
        }
      },
      "additionalProperties": false
    },

    "context": {
      "type": "object",
      "description": "Binds the grant to higher-level DeriveBSD objects when relevant.",
      "properties": {
        "plan_digest": {"type": "string"},
        "policy_snapshot_digest": {"type": "string"},
        "policy_decision_digest": {"type": "string"},
        "incident_id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "issued_at": {"type": "string"},
    "expires_at": {"type": "string"},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string", "description": "Signature over canonical JSON bytes."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
