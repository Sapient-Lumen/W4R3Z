{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD invariant registry (invariant.registry) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "registry_version",
    "registry_id",
    "created_at",
    "invariants"
  ],
  "properties": {
    "kind": { "const": "invariant.registry" },
    "registry_version": { "type": "string", "const": "0.1" },
    "registry_id": { "type": "string", "description": "Stable id for this registry (digest recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "since": { "type": "string", "description": "Version since this registry form is in use (e.g., 2026-02-27r131)." },

    "invariants": {
      "type": "array",
      "items": { "$ref": "#/$defs/invariant" }
    }
  },
  "$defs": {
    "invariant": {
      "type": "object",
      "required": [
        "id",
        "level",
        "pillars",
        "scope",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^inv\\.[a-z0-9]+(\\.[a-z0-9-]+)+$",
          "description": "Stable invariant id, e.g. inv.repro.explicit-inputs"
        },
        "level": {
          "type": "string",
          "enum": ["MUST", "SHOULD"],
          "description": "Normative strength; default to MUST for pillars/non-negotiables."
        },
        "pillars": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["reproducibility", "isolation", "supply-chain", "operability"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["spec", "lock", "plan", "artifact", "activate", "runtime", "promotion", "interop"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "statement": { "type": "string" },
        "rationale": { "type": "string" },

        "evidence": {
          "type": "array",
          "description": "Kinds or concrete schema paths that act as evidence surfaces.",
          "items": { "type": "string" }
        },
        "enforced_by": {
          "type": "array",
          "description": "Tools/guards that currently enforce this invariant (if any).",
          "items": { "type": "string" }
        },
        "related_docs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Repo-relative doc pointers, e.g. docs/97-non-negotiable-behaviors.md"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
