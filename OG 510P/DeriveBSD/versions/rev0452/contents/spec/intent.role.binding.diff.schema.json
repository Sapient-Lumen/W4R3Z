{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Intent Role Binding Diff (intent.role.binding.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_binding",
    "to_binding",
    "role_changes"
  ],
  "properties": {
    "kind": {
      "const": "intent.role.binding.diff"
    },
    "diff_version": {
      "type": "string",
      "const": "0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "properties": {
        "host_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string",
          "enum": [
            "fleet_host",
            "workstation",
            "general_os",
            "appliance_factory"
          ]
        }
      },
      "additionalProperties": false
    },
    "from_binding": {
      "$ref": "#/$defs/bindingRef"
    },
    "to_binding": {
      "$ref": "#/$defs/bindingRef"
    },
    "role_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/roleChange"
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "roles_changed": {
          "type": "integer",
          "minimum": 0
        },
        "default_targets_changed": {
          "type": "integer",
          "minimum": 0
        },
        "targets_enrolled": {
          "type": "integer",
          "minimum": 0
        },
        "targets_removed": {
          "type": "integer",
          "minimum": 0
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "policy_digest": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "bindingRef": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string"
        },
        "binding_id": {
          "type": "string"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "target_id",
        "target_kind"
      ],
      "properties": {
        "target_id": {
          "type": "string"
        },
        "target_kind": {
          "type": "string",
          "enum": [
            "persistent-compartment",
            "disposable-template"
          ]
        },
        "compartment_id": {
          "type": "string"
        },
        "template_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "target_kind": {
                "const": "persistent-compartment"
              }
            }
          },
          "then": {
            "required": [
              "compartment_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "target_kind": {
                "const": "disposable-template"
              }
            }
          },
          "then": {
            "required": [
              "template_id"
            ]
          }
        }
      ]
    },
    "defaultTargetChange": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/target"
        },
        "to": {
          "$ref": "#/$defs/target"
        }
      },
      "additionalProperties": false
    },
    "roleChange": {
      "type": "object",
      "required": [
        "role",
        "change_kinds"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "change_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "default-target",
              "target-enrolled",
              "target-removed"
            ]
          }
        },
        "default_target_change": {
          "$ref": "#/$defs/defaultTargetChange"
        },
        "enrolled_targets_added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "enrolled_targets_removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
