{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD policy module diff (policy.module.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "baseline",
    "next",
    "summary"
  ],
  "properties": {
    "kind": {"const": "policy.module.diff"},
    "diff_version": {"type": "string", "const": "0.1"},

    "baseline": {
      "type": "object",
      "required": ["module_digest"],
      "properties": {
        "module_digest": {"type": "string", "description": "Digest of baseline Wasm module bytes (e.g., sha256:...)."},
        "module_version": {"type": "string"},
        "abi": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string"},
            "version": {"type": "string"}
          },
          "additionalProperties": false
        },
        "signature_key_id": {"type": "string", "description": "Key id that signed the baseline policy module evidence."}
      },
      "additionalProperties": false
    },

    "next": {
      "type": "object",
      "required": ["module_digest"],
      "properties": {
        "module_digest": {"type": "string", "description": "Digest of next Wasm module bytes (e.g., sha256:...)."},
        "module_version": {"type": "string"},
        "abi": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string"},
            "version": {"type": "string"}
          },
          "additionalProperties": false
        },
        "signature_key_id": {"type": "string", "description": "Key id that signed the next policy module evidence."}
      },
      "additionalProperties": false
    },

    "summary": {
      "type": "object",
      "required": ["module_changed"],
      "properties": {
        "module_changed": {"type": "boolean", "description": "True when module_digest differs."},

        "entrypoints_added": {"type": "array", "items": {"type": "string"}},
        "entrypoints_removed": {"type": "array", "items": {"type": "string"}},

        "hostcalls_added": {"type": "array", "items": {"type": "string"}},
        "hostcalls_removed": {"type": "array", "items": {"type": "string"}},

        "limits_changed": {
          "type": "object",
          "description": "Optional resource-limit drift summary for evaluation (fuel/memory).",
          "properties": {
            "fuel": {"type": "object", "properties": {"from": {"type": "integer"}, "to": {"type": "integer"}}, "required": ["from", "to"], "additionalProperties": false},
            "memory_bytes": {"type": "object", "properties": {"from": {"type": "integer"}, "to": {"type": "integer"}}, "required": ["from", "to"], "additionalProperties": false}
          },
          "additionalProperties": false
        },

        "compiler_changed": {"type": "boolean", "description": "True when compiler/toolchain identifier changed."},
        "language_changed": {"type": "boolean", "description": "True when declared source language changed."}
      },
      "additionalProperties": false
    },

    "risk_flags": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Optional canonical risk flags suitable for gates/review UI (ids from risk.flag.registry)."
    },

    "notes": {"type": "string", "description": "Optional human notes (keep brief)."}
  },
  "additionalProperties": false
}
