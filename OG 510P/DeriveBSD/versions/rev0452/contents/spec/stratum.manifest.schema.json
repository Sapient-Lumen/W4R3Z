{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD stratum manifest (stratum.manifest) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "manifest_version",
    "stratum_id",
    "created_at",
    "subject",
    "source",
    "abi"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "stratum.manifest"
    },
    "manifest_version": {
      "type": "string",
      "const": "0.1"
    },
    "stratum_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "required": [
        "tree_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "tree_digest": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "tree_format": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "class"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "native",
            "adapter",
            "vendor",
            "foreign"
          ]
        },
        "adapter": {
          "type": "string"
        },
        "upstream": {
          "type": "string"
        },
        "import_receipt_digest": {
          "type": "string"
        }
      }
    },
    "abi": {
      "type": "object",
      "required": [
        "family",
        "loader_path",
        "default_library_paths",
        "execution_domains"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "loader_path": {
          "type": "string",
          "minLength": 1
        },
        "default_library_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "kernel_abi": {
          "type": "string"
        },
        "execution_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "host",
              "jail",
              "microvm",
              "appvm",
              "compat_view"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "contents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "loader",
          "shared-libs",
          "executables",
          "sdk",
          "data"
        ]
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
