{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD rollout policy (rollout.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "rollout_id",
    "created_at",
    "release_capsule_digest",
    "cohorting",
    "phases"
  ],
  "properties": {
    "kind": {
      "const": "rollout.policy"
    },
    "policy_version": {
      "type": "string",
      "const": "0.1"
    },
    "rollout_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_capsule_digest": {
      "type": "string"
    },
    "cohorting": {
      "type": "object",
      "required": [
        "method",
        "salt_digest",
        "stable_id_source"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "hash"
          ]
        },
        "salt_digest": {
          "type": "string",
          "description": "Digest of a secret or public salt used for deterministic cohort assignment."
        },
        "stable_id_source": {
          "type": "string",
          "enum": [
            "device_id",
            "workload_id",
            "hw_fingerprint",
            "custom",
            "random_device_secret"
          ],
          "description": "What stable identifier the client uses (hashed) for bucketing."
        },
        "cohort_hint_allowed": {
          "type": "boolean",
          "description": "If true, server may provide a signed/receipted cohort hint."
        },
        "privacy": {
          "type": "object",
          "description": "Optional privacy constraints for cohorting.",
          "properties": {
            "entropy_budget_bits": {
              "type": "integer",
              "minimum": 0,
              "description": "Upper bound on uniqueness encoded by cohorts."
            },
            "max_cohorts": {
              "type": "integer",
              "minimum": 1
            },
            "min_bucket_size": {
              "type": "integer",
              "minimum": 1,
              "description": "Minimum bucket size required before a cohort is considered valid."
            },
            "allow_hw_fingerprint": {
              "type": "boolean",
              "description": "Explicit opt-in to using hw_fingerprint stable IDs."
            },
            "salt_rotation": {
              "type": "object",
              "properties": {
                "epoch_days": {
                  "type": "integer",
                  "minimum": 1
                },
                "rotate_on_release": {
                  "type": "boolean"
                },
                "rotate_on_incident": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "percent"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "min_duration_hours": {
            "type": "integer",
            "minimum": 0
          },
          "require_health_ok": {
            "type": "boolean"
          },
          "require_confirm": {
            "type": "boolean",
            "description": "If true, requires confirmable change-sets for this phase."
          }
        },
        "additionalProperties": false
      }
    },
    "freeze_windows": {
      "type": "array",
      "description": "Optional freeze windows (no new offers) in UTC.",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "halt_conditions": {
      "type": "object",
      "description": "Optional high-level halt/abort triggers (details are implementation-specific).",
      "properties": {
        "max_boot_fail_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_crash_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "manual_kill_switch": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "sig"
        ],
        "properties": {
          "key_id": {
            "type": "string"
          },
          "sig": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
