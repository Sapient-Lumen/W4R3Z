{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Declassification Request (declass.request) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "request_id",
    "created_at",
    "subject",
    "inputs",
    "requested_label",
    "reason"
  ],
  "properties": {
    "kind": { "const": "declass.request" },
    "schema_version": { "type": "string", "const": "0.1" },
    "request_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },

    "subject": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "description": "User/service identity requesting downgrade." },
        "session": { "type": "string" }
      },
      "additionalProperties": false
    },

    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "digest", "current_label"],
        "properties": {
          "ref": { "type": "string" },
          "digest": { "type": "string" },
          "current_label": { "$ref": "flow.label.schema.json" }
        },
        "additionalProperties": false
      }
    },

    "transform": {
      "type": "object",
      "description": "Optional transform that justifies downgrade (redaction/sanitization/export).",
      "properties": {
        "id": { "type": "string" },
        "input_params": { "type": "object" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "requested_label": { "$ref": "flow.label.schema.json" },

    "reason": { "type": "string" },

    "consent": {
      "type": "object",
      "description": "Optional consent context (interactive approval, OOB approval, etc).",
      "properties": {
        "mode": { "type": "string", "enum": ["interactive", "oob", "preapproved"] },
        "consent_receipt": { "type": "string" }
      },
      "additionalProperties": false
    },

    "policy_context": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
