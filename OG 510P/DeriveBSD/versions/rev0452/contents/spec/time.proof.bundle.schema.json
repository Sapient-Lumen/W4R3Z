{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Time Proof Bundle (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "bundle_version",
    "policy_digest",
    "observations",
    "agreement",
    "captured_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "time-proof-bundle"
    },
    "bundle_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "policy_digest": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "protocol",
          "reported_time",
          "uncertainty_ms",
          "transcript_digest"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "nts",
              "roughtime"
            ]
          },
          "reported_time": {
            "type": "string",
            "format": "date-time"
          },
          "uncertainty_ms": {
            "type": "integer",
            "minimum": 0
          },
          "transcript_digest": {
            "type": "string",
            "description": "Digest of the protocol transcript / response blob."
          },
          "server_sig_digest": {
            "type": "string",
            "description": "Optional digest of a server signature blob if separately stored."
          }
        },
        "additionalProperties": false
      }
    },
    "agreement": {
      "type": "object",
      "required": [
        "in_quorum",
        "max_observed_skew_ms"
      ],
      "properties": {
        "in_quorum": {
          "type": "boolean"
        },
        "max_observed_skew_ms": {
          "type": "integer",
          "minimum": 0
        },
        "selected_time": {
          "type": "string",
          "format": "date-time",
          "description": "The time value `system.time` selected under policy (e.g., median)."
        }
      },
      "additionalProperties": false
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object",
      "description": "Signature by `system.time` over the canonicalized bundle."
    }
  },
  "additionalProperties": false
}