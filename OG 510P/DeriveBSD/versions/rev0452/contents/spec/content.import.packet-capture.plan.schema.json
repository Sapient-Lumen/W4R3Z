{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD packet-capture strong-artifact intake plan profile (content.import.packet-capture.plan) (v0.1)",
  "allOf": [
    {
      "$ref": "content.import.plan.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "content.import.plan"
        },
        "plan_version": {
          "const": "0.1"
        },
        "subject": {
          "type": "object",
          "required": [
            "digest",
            "filename"
          ],
          "properties": {
            "filename": {
              "type": "string",
              "pattern": "\\.(pcap|pcapng)$"
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 3,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "scan"
                  },
                  "tool": {
                    "const": "packet-capture.scan"
                  }
                },
                "required": [
                  "op",
                  "tool"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "classify"
                  },
                  "tool": {
                    "const": "packet-capture.classify"
                  },
                  "params": {
                    "type": "object",
                    "properties": {
                      "detect_sideband_metadata": {
                        "const": true
                      },
                      "detect_decryption_material": {
                        "const": true
                      }
                    },
                    "required": [
                      "detect_sideband_metadata",
                      "detect_decryption_material"
                    ]
                  }
                },
                "required": [
                  "op",
                  "tool",
                  "params"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "strip-metadata"
                  },
                  "tool": {
                    "const": "packet-capture.normalize"
                  },
                  "params": {
                    "type": "object",
                    "properties": {
                      "target_posture": {
                        "const": "packet-records-only"
                      },
                      "drop_name_resolution": {
                        "const": true
                      },
                      "drop_decryption_material": {
                        "const": true
                      }
                    },
                    "required": [
                      "target_posture",
                      "drop_name_resolution",
                      "drop_decryption_material"
                    ]
                  }
                },
                "required": [
                  "op",
                  "tool",
                  "params"
                ]
              }
            }
          ]
        },
        "execution": {
          "type": "object",
          "properties": {
            "isolation": {
              "const": "microvm"
            },
            "network": {
              "const": "none"
            },
            "lifetime": {
              "const": "disposable"
            }
          },
          "required": [
            "isolation",
            "network",
            "lifetime"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "type": {
              "const": "dataset"
            }
          },
          "required": [
            "type"
          ]
        }
      },
      "required": [
        "kind",
        "plan_version"
      ]
    }
  ],
  "type": "object",
  "required": [
    "kind",
    "plan_version"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "content.import.plan",
        "content.import.receipt"
      ]
    },
    "plan_version": {
      "type": "string"
    }
  }
}
