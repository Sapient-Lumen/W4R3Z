{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD devfs view plan (devfs.view.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "target",
    "baseline",
    "rules"
  ],
  "properties": {
    "kind": { "const": "devfs-view-plan" },
    "plan_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "plan_id": { "type": "string", "description": "Stable id for the plan (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "requested_by": { "type": "string", "description": "Opaque operator/workflow id (optional)." },

    "target": {
      "type": "object",
      "description": "Where the /dev view applies.",
      "required": ["domain_kind", "domain_id"],
      "properties": {
        "host_id": { "type": "string" },
        "domain_kind": { "type": "string", "enum": ["host", "jail", "microvm"] },
        "domain_id": { "type": "string", "description": "Jail name/id, microVM instance id, etc." },
        "service_id": { "type": "string", "description": "Optional higher-level service identity." }
      },
      "additionalProperties": false
    },

    "inputs": {
      "type": "object",
      "description": "Optional pointers to upstream compilation inputs.",
      "properties": {
        "derive_unit_digest": { "type": "string" },
        "promise_profile_digest": { "type": "string" },
        "device_attach_grant_digests": {
          "type": "array",
          "items": { "type": "string" }
        },
        "policy_decision_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "baseline": {
      "type": "string",
      "enum": ["service-minimal", "interactive-minimal", "empty"],
      "description": "Baseline /dev posture; rules extend/override it." 
    },

    "rules": {
      "type": "array",
      "minItems": 0,
      "description": "Canonical devfs rules (portable IR). Ordering is significant and must be deterministic.",
      "items": {
        "type": "object",
        "required": ["action", "path"],
        "properties": {
          "action": { "type": "string", "enum": ["hide", "unhide", "perm"] },
          "path": { "type": "string", "description": "devfs path pattern (devfs.rules semantics, e.g., 'bpf*', 'da*')." },
          "uid": { "type": "integer", "minimum": 0, "description": "Required for perm actions." },
          "gid": { "type": "integer", "minimum": 0, "description": "Required for perm actions." },
          "mode": { "type": "string", "pattern": "^[0-7]{3,4}$", "description": "Octal permission bits (perm action)." },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "rendering": {
      "type": "object",
      "description": "Optional backend rendering hints (derived artifacts).",
      "properties": {
        "backend": { "type": "string", "enum": ["devfs.rules", "devfs.rule.stream"] },
        "rules_text_digest": { "type": "string", "description": "Digest of rendered devfs.rules text (if produced)." }
      },
      "additionalProperties": false
    },

    "rules_digest": {
      "type": "string",
      "description": "Optional digest of the canonical rules list (for quick comparisons)."
    },

    "apply": {
      "type": "object",
      "description": "Optional application posture (kept small; prefer change-set policy).",
      "properties": {
        "commit_confirmed": { "type": "boolean", "default": false },
        "confirm_ttl_seconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
