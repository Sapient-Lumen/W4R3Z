{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD time requirement gate (time.requirement) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "requirement_version",
    "created_at",
    "bounds",
    "degraded_response"
  ],
  "properties": {
    "kind": {
      "const": "time-requirement"
    },
    "requirement_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "requirement_id": {
      "type": "string",
      "description": "Stable id for this requirement (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "properties": {
        "host_id": {
          "type": "string"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "commit",
            "attestation",
            "secrets",
            "general"
          ]
        }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": [
        "max_offset_ms",
        "max_uncertainty_ms",
        "max_age_seconds"
      ],
      "properties": {
        "max_offset_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_uncertainty_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_age_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "require_authenticated": {
          "type": "boolean",
          "default": false
        },
        "require_nts": {
          "type": "boolean",
          "default": false
        },
        "allow_step": {
          "type": "boolean",
          "default": true
        },
        "max_step_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "degraded_response": {
      "type": "object",
      "required": [
        "on_degraded",
        "on_unsynced"
      ],
      "properties": {
        "on_degraded": {
          "type": "string",
          "enum": [
            "deny",
            "repair-only",
            "allow-if-proof-fresh",
            "allow-breakglass-only"
          ]
        },
        "on_unsynced": {
          "type": "string",
          "enum": [
            "deny",
            "repair-only",
            "allow-breakglass-only"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
