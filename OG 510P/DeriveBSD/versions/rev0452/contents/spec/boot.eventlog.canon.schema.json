{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD canonicalized boot event log (boot.eventlog.canon) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "eventlog_version",
    "canon_id",
    "created_at",
    "raw",
    "events"
  ],
  "properties": {
    "kind": {"const": "boot.eventlog.canon"},
    "eventlog_version": {"type": "string", "const": "0.1"},

    "canon_id": {
      "type": "string",
      "description": "Identifier for the canonicalization ruleset (include upstream spec rev + DeriveBSD suffix)."
    },

    "created_at": {"type": "string", "format": "date-time"},

    "source": {
      "type": "object",
      "description": "Optional producer/platform metadata (not security-critical; hints only).",
      "properties": {
        "host_id": {"type": "string"},
        "platform_id": {"type": "string", "description": "Optional platform identifier or RIM/PAC reference id."},
        "firmware_vendor": {"type": "string"},
        "firmware_version": {"type": "string"}
      },
      "additionalProperties": false
    },

    "raw": {
      "type": "object",
      "required": ["format", "raw_eventlog_digest"],
      "properties": {
        "format": {
          "type": "string",
          "description": "Raw event log encoding/source (e.g., tcg2-uefi, tcg1-efi, vendor)."
        },
        "raw_eventlog_digest": {
          "type": "string",
          "description": "Digest of the raw/binary event log bytes (if captured)."
        },
        "raw_size": {"type": "integer", "minimum": 0},
        "raw_uri": {"type": "string", "description": "Optional pointer/URI for raw bytes (export-policy governed)."}
      },
      "additionalProperties": false
    },

    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"},
      "description": "Stable-ordered canonical event list (order-preserving)."
    },

    "redaction": {
      "type": "object",
      "description": "Optional redaction metadata when exporting/collapsing hints for privacy.",
      "properties": {
        "mode": {"type": "string", "enum": ["none", "hints-stripped", "hints-hashed", "custom"]},
        "unredacted_digest": {"type": "string", "description": "Digest of the unredacted boot.eventlog.canon object (if redacted)."}
      },
      "additionalProperties": false
    },

    "notes": {"type": "string"}
  },

  "$defs": {
    "digest": {
      "type": "object",
      "required": ["alg", "value"],
      "properties": {
        "alg": {"type": "string", "description": "Hash algorithm (sha1/sha256/sha384/sha512)."},
        "value": {"type": "string", "description": "Hex digest (lowercase preferred)."}
      },
      "additionalProperties": false
    },

    "event": {
      "type": "object",
      "required": ["record", "pcr", "event_type", "digests"],
      "properties": {
        "record": {"type": "integer", "minimum": 0, "description": "Monotonic record number in the event log."},
        "pcr": {"type": "integer", "minimum": 0, "maximum": 23},

        "event_type": {
          "type": "string",
          "description": "Canonical event type label (prefer upstream names where possible)."
        },
        "event_type_code": {"type": "integer", "minimum": 0, "description": "Optional numeric code (hint only)."},

        "digests": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/digest"},
          "description": "Event digests (often multi-alg in TCG2 logs)."
        },

        "content_hint": {
          "type": "object",
          "description": "Optional, potentially untrusted hint fields. Verifiers must not trust these without independent validation.",
          "properties": {
            "label": {"type": "string"},
            "path": {"type": "string"},
            "guid": {"type": "string"},
            "vendor": {"type": "string"},
            "component_role": {"type": "string", "description": "Optional mapping hint to boot.manifest roles."},
            "unparsed_blob_digest": {"type": "string", "description": "Digest of unparsed event content bytes (so parsers can evolve without losing integrity)."}
          },
          "additionalProperties": false
        },

        "phase_marker": {
          "type": "object",
          "description": "Optional DeriveBSD phase marker extracted from measured events.",
          "properties": {
            "phase": {"type": "string"},
            "milestone": {"type": "string"},
            "seq": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },

  "additionalProperties": false
}
