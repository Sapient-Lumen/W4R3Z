{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD kernel module load receipt (kmod.load.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "applied_at",
    "boot_manifest_digest",
    "plan_digest",
    "policy_digest",
    "outcome",
    "loaded"
  ],
  "properties": {
    "kind": {
      "const": "kmod-load-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "receipt_id": {
      "type": "string",
      "description": "Stable id (UUID recommended)."
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_digest": {
      "type": "string",
      "description": "Digest of the kmod-load-plan that was executed."
    },
    "policy_digest": {
      "type": "string",
      "description": "Digest of the kmod-policy used during execution."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "failed"
      ]
    },
    "loaded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "module_id": {
            "type": "integer",
            "description": "Optional numeric id/index from kldstat-like interfaces."
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "denied": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "knobs": {
      "type": "object",
      "description": "Kernel/boot knobs set as part of enforcement (securelevel/lockdown, sysctls).",
      "properties": {
        "securelevel_before": {
          "type": "integer"
        },
        "securelevel_after": {
          "type": "integer"
        },
        "lockdown_level": {
          "type": "string"
        },
        "sysctls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "string",
      "description": "Optional signature over canonical bytes / DSSE envelope."
    },
    "boot_manifest_digest": {
      "type": "string",
      "description": "Digest of the boot.manifest in force when the plan ran."
    }
  },
  "additionalProperties": false
}
