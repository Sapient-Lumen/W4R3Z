{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI Notification Grant (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "subject",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": { "const": "ui-notification-grant" },
    "grant_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "lease_id": {
      "type": "string",
      "description": "Optional lease identifier for revocation/expiry."
    },
    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string" },
        "digest": { "type": "string" },
        "instance": { "type": "string" }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "rate_limit": { "type": "string", "description": "e.g. '5/min'" },
        "max_active": { "type": "integer" },
        "allowed_categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "max_priority": {
          "type": "string",
          "enum": ["low", "normal", "high", "critical"]
        },
        "persistence_max_seconds": { "type": "integer" },
        "allow_activation": { "type": "boolean", "description": "Allow click-to-activate via intent routing." },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "issued_at": { "type": "string", "description": "ISO8601 time." },
    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": { "type": "string" },
        "alg": { "type": "string" },
        "sig": { "type": "string", "description": "Signature over canonical JSON bytes." }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
