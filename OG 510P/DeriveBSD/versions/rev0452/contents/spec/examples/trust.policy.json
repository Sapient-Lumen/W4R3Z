{
  "kind": "trust-policy",
  "policy_version": "0.1",
  "namespaces": [
    {
      "id": "example.org/derivebsd",
      "channels": {
        "stable": {
          "max_rollback_window": "30d",
          "require_expiry": true
        }
      },
      "keys": [
        {
          "key_id": "root-2026",
          "role": "root",
          "alg": "ed25519",
          "public": "BASE64(...)"
        },
        {
          "key_id": "signing-2026",
          "role": "signing",
          "alg": "ed25519",
          "public": "BASE64(...)"
        },
        {
          "key_id": "policy-2026",
          "role": "policy",
          "alg": "ed25519",
          "public": "BASE64(...)"
        }
      ],
      "targets": {
        "host": {
          "required_signers": ["signing"],
          "required_attestations": ["provenance"],
          "require_closure_proof": true
        },
        "microvm": {
          "required_signers": ["signing"],
          "required_attestations": ["provenance"],
          "require_closure_proof": true
        }
      }
    }
  ]
}
