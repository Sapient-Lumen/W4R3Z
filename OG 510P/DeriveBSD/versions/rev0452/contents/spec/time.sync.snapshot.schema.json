{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD time sync snapshot (time.sync.snapshot) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "snapshot_version",
    "created_at",
    "host",
    "status"
  ],
  "properties": {
    "kind": {
      "const": "time-sync-snapshot"
    },
    "snapshot_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "snapshot_id": {
      "type": "string",
      "description": "Stable id for this snapshot (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "required": [
        "host_id",
        "generation_digest"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "generation_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "synced",
            "degraded",
            "unsynced"
          ]
        },
        "reference_source_id": {
          "type": "string"
        },
        "authenticated": {
          "type": "boolean"
        },
        "stratum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "offset_ms": {
          "type": "number",
          "description": "Estimated current clock offset in milliseconds."
        },
        "uncertainty_ms": {
          "type": "number",
          "description": "Estimated uncertainty bound in milliseconds."
        },
        "rtt_ms": {
          "type": "number"
        },
        "last_sync_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_step_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_step_ms": {
          "type": "number"
        },
        "leap": {
          "type": "string",
          "enum": [
            "none",
            "pending",
            "insert",
            "delete",
            "unknown"
          ],
          "default": "unknown"
        },
        "lkgt_time": {
          "type": "string",
          "format": "date-time",
          "description": "Last-known-good time (monotonic wall time floor) if enforced by policy."
        },
        "lkgt_source": {
          "type": "string",
          "description": "Where LKGT was sourced from (e.g., tpm_nv, sealed_file, state_dataset)."
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "plan_digest": {
          "type": "string"
        },
        "inventory_digest": {
          "type": "string"
        },
        "requirement_digest": {
          "type": "string"
        },
        "proof_bundle_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
