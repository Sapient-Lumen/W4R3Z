{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD storage event (storage-event) (v0.1)",
  "allOf": [
    {
      "$ref": "event.record.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "event_version",
        "event_id",
        "at",
        "source",
        "severity",
        "event_type"
      ],
      "properties": {
        "kind": {"const": "storage-event"},
        "event_version": {"type": "string", "pattern": "^0\\.\\d+$"},
        "event_id": {"type": "string", "description": "Stable id (UUID recommended)."},
        "at": {"type": "string", "format": "date-time"},
        "source": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "description": "Producer name (zfs-agent, zed, smart-agent, etc.)."},
            "host_id": {"type": "string"}
          },
          "additionalProperties": false
        },
        "severity": {"type": "string", "enum": ["info", "warning", "error", "critical"]},
        "event_type": {
          "type": "string",
          "enum": [
            "storage.pool.online",
            "storage.pool.degraded",
            "storage.pool.faulted",
            "storage.scrub.started",
            "storage.scrub.completed",
            "storage.resilver.started",
            "storage.resilver.completed",
            "storage.checkpoint.created",
            "storage.checkpoint.discarded",
            "storage.device.faulted"
          ]
        },
        "pool_name": {"type": "string"},
        "pool_guid": {"type": "string"},
        "device_id_hash": {"type": "string"},
        "storage_health_snapshot_digest": {"type": "string"},
        "storage_scrub_receipt_digest": {"type": "string"}
      },
      "additionalProperties": false
    }
  ]
}
