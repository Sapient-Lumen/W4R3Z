{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD resource governance apply receipt (resource.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "created_at",
    "policy_ref",
    "result"
  ],
  "properties": {
    "kind": {
      "const": "resource-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "receipt_id": {
      "type": "string",
      "description": "Stable id (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_ref": {
      "type": "object",
      "required": [
        "kind",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "resource-policy"
        },
        "digest": {
          "type": "string"
        },
        "store_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "backend": {
      "type": "string",
      "description": "Enforcement backend used (e.g., rctl, cpuset, io.throttle)."
    },
    "result": {
      "type": "string",
      "enum": [
        "applied",
        "noop",
        "failed",
        "rolled-back"
      ]
    },
    "applied_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Backend rule materialization (opaque strings acceptable)."
    },
    "error": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "correlation": {
      "type": "object",
      "properties": {
        "change_id": {
          "type": "string"
        },
        "step_name": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}