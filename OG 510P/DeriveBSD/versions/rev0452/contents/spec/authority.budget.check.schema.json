{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD authority budget check (authority.budget.check) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "check_version",
    "authority_semantics",
    "check_id",
    "created_at",
    "budget_digest",
    "scope",
    "inputs",
    "verdict",
    "deltas"
  ],
  "properties": {
    "kind": {
      "const": "authority.budget.check"
    },
    "check_version": {
      "type": "string",
      "const": "0.1"
    },
    "authority_semantics": {
      "type": "string",
      "const": "authority-budget-check-evidence-only"
    },
    "check_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "budget_digest": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "host_id",
        "profile_id",
        "domain_kind",
        "domain_id",
        "service_id",
        "generation_id"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "domain_kind": {
          "type": "string",
          "enum": [
            "jail",
            "microvm",
            "process"
          ]
        },
        "domain_id": {
          "type": "string"
        },
        "service_id": {
          "type": "string"
        },
        "generation_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": [
        "derive_unit_digest",
        "caproute_digest",
        "preopen_map_digest",
        "mount_view_digest",
        "devfs_view_plan_digest",
        "pki_profile_digest",
        "diagnostics_profile_digest"
      ],
      "properties": {
        "derive_unit_digest": {
          "type": "string"
        },
        "caproute_digest": {
          "type": "string"
        },
        "preopen_map_digest": {
          "type": "string"
        },
        "mount_view_digest": {
          "type": "string"
        },
        "devfs_view_plan_digest": {
          "type": "string"
        },
        "pki_profile_digest": {
          "type": "string"
        },
        "diagnostics_profile_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "field",
          "classification",
          "severity",
          "budgeted",
          "observed"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "filesystem",
              "network",
              "devices",
              "trust",
              "observability"
            ]
          },
          "field": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "enum": [
              "narrowing",
              "broadening",
              "forbidden-presence",
              "missing-required-broker"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "warn",
              "block"
            ]
          },
          "budgeted": {},
          "observed": {},
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "top_contributors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exception_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "field",
          "suggested_scope"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "filesystem",
              "network",
              "devices",
              "trust",
              "observability"
            ]
          },
          "field": {
            "type": "string"
          },
          "suggested_scope": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
