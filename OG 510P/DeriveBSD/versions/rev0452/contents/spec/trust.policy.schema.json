{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Trust Policy (v0.1)",
  "type": "object",
  "required": ["kind", "policy_version", "namespaces"],
  "properties": {
    "kind": {"const": "trust-policy"},
    "policy_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "namespaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "keys", "targets"],
        "properties": {
          "id": {"type": "string", "description": "Namespace identifier (tenant / org / repo root)."},
          "extensions": {
            "type": "object",
            "description": "Optional forward-compatible extensions (e.g., multi-step approvals, repository bootstrap).",
            "additionalProperties": true
          },
          "channels": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "max_rollback_window": {"type": "string"},
                "require_expiry": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key_id", "role", "alg", "public"],
              "properties": {
                "key_id": {"type": "string"},
                "role": {"type": "string", "enum": ["root", "signing", "policy"]},
                "alg": {"type": "string"},
                "public": {"type": "string", "description": "Public key material (encoding policy-defined)."},
                "valid_from": {"type": "string"},
                "valid_to": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "targets": {
            "type": "object",
            "required": ["host", "microvm"],
            "properties": {
              "host": {"$ref": "#/definitions/target_rules"},
              "microvm": {"$ref": "#/definitions/target_rules"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "target_rules": {
      "type": "object",
      "properties": {
        "required_signers": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of key roles or key_ids required to accept artifacts." 
        },
        "required_attestations": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Predicate types or identifiers required by policy (e.g., provenance)."
        },
        "require_closure_proof": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
