{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Lease Revoke Event (lease-revoke-event) (v0.1)",
  "allOf": [
    { "$ref": "event.record.schema.json" },
    {
      "type": "object",
      "required": [
        "kind",
        "event_version",
        "event_id",
        "at",
        "source",
        "class",
        "severity",
        "payload"
      ],
      "properties": {
        "kind": { "const": "lease-revoke-event" },
        "event_version": { "type": "string", "pattern": "^0\\.\\d+$" },
        "event_id": { "type": "string" },
        "at": { "type": "string", "format": "date-time" },

        "source": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "host_id": { "type": "string" },
            "domain": { "type": "string" },
            "service_id": { "type": "string" },
            "operator": { "type": "string" }
          },
          "additionalProperties": false
        },

        "class": { "type": "string", "description": "lease.revoke.*" },
        "severity": { "type": "string", "enum": ["debug", "info", "warn", "error", "critical", "fatal"] },

        "payload": {
          "type": "object",
          "required": ["lease_id", "result"],
          "properties": {
            "lease_id": { "type": "string" },
            "lease_kind": { "type": "string", "description": "Owning grant/session kind if known (portal-grant, secret-grant, ...)." },
            "result": { "type": "string", "enum": ["revoked", "already_revoked", "not_found", "failed"] },
            "reason": { "type": "string" },
            "requested_by": { "type": "string", "description": "Actor or component that requested revocation." },
            "targets": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Optional list of related objects (service ids, contract handles, etc.)."
            },
            "grant_digest": { "type": "string", "description": "Optional digest/id of the grant object being revoked." }
          },
          "additionalProperties": true
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
