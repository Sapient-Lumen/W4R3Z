{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD release authority policy (release.authority.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "policy_id",
    "created_at",
    "scope",
    "roles",
    "operations"
  ],
  "properties": {
    "kind": {
      "const": "release.authority.policy"
    },
    "policy_version": {
      "type": "string",
      "const": "0.1"
    },
    "policy_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "required": [
        "namespace",
        "channel"
      ],
      "properties": {
        "namespace": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "subject_name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "threshold",
          "keys"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "root",
              "publisher",
              "ops",
              "security",
              "rollout"
            ]
          },
          "threshold": {
            "type": "integer",
            "minimum": 1
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "key_id"
              ],
              "properties": {
                "key_id": {
                  "type": "string"
                },
                "public_key": {
                  "type": "string",
                  "description": "Optional inline public key material or reference."
                },
                "offline": {
                  "type": "boolean",
                  "description": "Hint that the key should be handled offline."
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "object",
      "required": [
        "publish",
        "halt",
        "resume"
      ],
      "properties": {
        "publish": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "publisher",
              "ops",
              "security",
              "root"
            ]
          },
          "description": "Roles required to publish a release (thresholds apply per role)."
        },
        "halt": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ops",
              "security",
              "root"
            ]
          }
        },
        "resume": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ops",
              "security",
              "root"
            ]
          }
        },
        "rotate_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "root",
              "security"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "transparency": {
      "type": "object",
      "properties": {
        "require_transparency_entry": {
          "type": "boolean",
          "default": false
        },
        "allowed_log_uris": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "require_bundled_proof": {
          "type": "boolean"
        },
        "require_checkpoint_receipt": {
          "type": "boolean",
          "description": "Require a mirrored/witnessed log.checkpoint.receipt when transparency is required."
        },
        "witness_policy_digest": {
          "type": "string",
          "description": "Digest of the witness.policy that defines which witnesses count, quorum thresholds, and shortfall behavior for this release channel."
        }
      },
      "additionalProperties": false
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "require_monitor_clean": {
          "type": "boolean"
        },
        "monitor_policy_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "sig"
        ],
        "properties": {
          "key_id": {
            "type": "string"
          },
          "sig": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "identity_evidence": {
      "type": "object",
      "description": "Optional supplemental publisher-identity evidence rules. This constrains review but does not replace threshold publish authority.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "ignored",
            "optional",
            "required"
          ]
        },
        "allowed_methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sigstore-keyless",
              "x509",
              "ssh",
              "gpg",
              "custom"
            ]
          }
        },
        "allowed_issuers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_identity_patterns": {
          "type": "array",
          "description": "Policy-defined templates/match expressions over issuer/subject/workflow claims.",
          "items": {
            "type": "string"
          }
        },
        "require_bundle": {
          "type": "boolean"
        },
        "require_offline_verification_material": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "supplychain_verification": {
      "type": "object",
      "description": "Optional supplemental workflow-verification gate rules. These constrain publication review but do not replace threshold publication authority.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "ignored",
            "optional",
            "required"
          ]
        },
        "allowed_layout_policy_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "require_pass_result": {
          "type": "boolean"
        },
        "max_receipt_age": {
          "type": "string",
          "description": "Optional freshness budget for workflow-verification receipts, e.g. PT24H."
        }
      },
      "additionalProperties": false
    },
    "vulnerability_verification": {
      "type": "object",
      "description": "Optional supplemental vulnerability-verification rules. This constrains review but does not replace threshold publish authority.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "ignored",
            "optional",
            "required"
          ]
        },
        "allowed_vuln_gate_policy_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "require_pass_result": {
          "type": "boolean"
        },
        "max_receipt_age": {
          "type": "string",
          "description": "Maximum accepted age for vulnerability-verification receipts (duration string, e.g. PT24H)."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
