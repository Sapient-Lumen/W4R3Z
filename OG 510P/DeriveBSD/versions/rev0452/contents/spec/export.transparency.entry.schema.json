{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD export transparency entry (export.transparency.entry) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "entry_version",
    "entry_id",
    "created_at",
    "export_receipt_digest",
    "artifact_digest",
    "policy_digest",
    "log"
  ],
  "properties": {
    "kind": {
      "const": "export.transparency.entry"
    },
    "entry_version": {
      "type": "string",
      "const": "0.1"
    },
    "entry_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "export_receipt_digest": {
      "type": "string"
    },
    "artifact_digest": {
      "type": "string"
    },
    "policy_digest": {
      "type": "string"
    },
    "plan_digest": {
      "type": "string"
    },
    "redaction_transform_digest": {
      "type": "string"
    },
    "recipient": {
      "type": "object",
      "description": "Optional recipient metadata, policy-permitting. Prefer hashes.",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "internal",
            "external-vendor",
            "customer",
            "public"
          ]
        },
        "ticket_id_hash": {
          "type": "string"
        },
        "recipient_hash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "transport": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Transport type (ticket-upload, https-upload, email, oob, ...)"
        },
        "domain_hint_hash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "log": {
      "$ref": "transparency.proof.schema.json"
    },
    "signature": {
      "type": "string",
      "description": "Optional signature over the canonicalized entry."
    }
  },
  "additionalProperties": false
}
