{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD hardware support qualification receipt (hw.support.qualification.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "target",
    "support_claim",
    "qualification",
    "supporting_evidence",
    "check_results",
    "freshness",
    "decision"
  ],
  "properties": {
    "kind": {
      "const": "hw.support.qualification.receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "receipt_id": {
      "type": "string",
      "description": "Stable id for this receipt (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "artifact_kind",
        "artifact_digest",
        "release_train"
      ],
      "properties": {
        "artifact_kind": {
          "type": "string",
          "enum": [
            "host.generation",
            "release.capsule",
            "reset.authorization",
            "base.set"
          ]
        },
        "artifact_digest": {
          "type": "string"
        },
        "boot_manifest_digest": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "release_train": {
          "type": "string",
          "description": "Release-train identifier this artifact is scoped to."
        }
      },
      "additionalProperties": false
    },
    "support_claim": {
      "type": "object",
      "required": [
        "entry_id",
        "support_level",
        "profiles",
        "roles"
      ],
      "properties": {
        "entry_id": {
          "type": "string"
        },
        "support_level": {
          "type": "string",
          "enum": [
            "supported",
            "conditional",
            "canary-only",
            "maintenance-only"
          ]
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "boot-storage",
              "primary-network",
              "trusted-display",
              "trusted-input",
              "maintenance-network",
              "usb-quarantine",
              "gpu-accel",
              "camera",
              "microphone",
              "tpm",
              "general"
            ]
          }
        },
        "match_summary": {
          "type": "object",
          "properties": {
            "machine_class_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "pci_identities": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "virtualization": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "condition_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Condition ids from the published support-matrix entry when the claim is conditional, canary-only, or maintenance-only."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "support_level": {
                "enum": [
                  "conditional",
                  "canary-only",
                  "maintenance-only"
                ]
              }
            }
          },
          "then": {
            "required": [
              "condition_ids"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "support_level": {
                "enum": [
                  "supported"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "condition_ids"
              ]
            }
          }
        }
      ]
    },
    "qualification": {
      "type": "object",
      "required": [
        "stage",
        "verified_roles",
        "evidence_floor",
        "regression_policy",
        "target_binding",
        "last_verified_at",
        "profile_digest"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "lab-validated",
            "canary-observed",
            "release-qualified",
            "field-sustained"
          ]
        },
        "verified_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "boot-storage",
              "primary-network",
              "trusted-display",
              "trusted-input",
              "maintenance-network",
              "usb-quarantine",
              "gpu-accel",
              "camera",
              "microphone",
              "tpm",
              "general"
            ]
          }
        },
        "evidence_floor": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "boot",
              "generation-switch",
              "rollback-or-recovery",
              "trusted-ui-basic",
              "network-basic",
              "device-mediation-basic",
              "suspend-resume"
            ]
          }
        },
        "regression_policy": {
          "type": "string",
          "enum": [
            "retest-on-kernel-or-firmware-change",
            "retest-on-release-candidate",
            "continuous-regression-watch"
          ]
        },
        "last_verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "profile_digest": {
          "type": "string",
          "description": "Digest of the hw.support.qualification.profile that defined the required checks for this receipt."
        },
        "notes": {
          "type": "string"
        },
        "target_binding": {
          "type": "string",
          "enum": [
            "exact-artifact-digest",
            "same-release-train",
            "same-release-train-and-boot-manifest"
          ],
          "description": "How far this qualification receipt is allowed to apply beyond the exact published target artifact."
        }
      },
      "additionalProperties": false
    },
    "supporting_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "digest",
          "purpose"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "hw.inventory.receipt",
              "hw.compat.report",
              "restore-drill-receipt",
              "ui.secure_attention.receipt",
              "fw-update-receipt",
              "bundle.build.receipt",
              "vendor.qualification.bundle",
              "lab.run.summary"
            ]
          },
          "digest": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "inventory-baseline",
              "preflight-check",
              "generation-switch",
              "rollback-or-recovery",
              "trusted-ui-basic",
              "network-basic",
              "device-mediation-basic",
              "boot",
              "suspend-resume",
              "field-regression-watch",
              "vendor-evidence"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "status",
        "published",
        "status_effective_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "superseded",
            "revoked"
          ]
        },
        "published": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "status_effective_at": {
          "type": "string",
          "format": "date-time",
          "description": "When this publication status became effective."
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "newer-receipt-published",
            "field-regression",
            "security-issue",
            "qualification-scope-corrected",
            "evidence-invalidated",
            "recovery-gap-found",
            "support-withdrawn"
          ],
          "description": "Typed explanation when the receipt is superseded or revoked."
        },
        "replacement_receipt_digest": {
          "type": "string",
          "description": "Digest of the newer hw.support.qualification.receipt that supersedes this one."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "superseded"
              }
            }
          },
          "then": {
            "required": [
              "reason_code",
              "replacement_receipt_digest"
            ],
            "properties": {
              "reason_code": {
                "const": "newer-receipt-published"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "revoked"
              }
            }
          },
          "then": {
            "required": [
              "reason_code"
            ],
            "properties": {
              "reason_code": {
                "type": "string",
                "enum": [
                  "field-regression",
                  "security-issue",
                  "qualification-scope-corrected",
                  "evidence-invalidated",
                  "recovery-gap-found",
                  "support-withdrawn"
                ]
              }
            }
          }
        }
      ]
    },
    "notes": {
      "type": "string"
    },
    "check_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "status",
          "evidence_digests"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "allowed-deviation"
            ]
          },
          "evidence_digests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "freshness": {
      "type": "object",
      "required": [
        "fresh_until",
        "reverify_on"
      ],
      "properties": {
        "fresh_until": {
          "type": "string",
          "format": "date-time"
        },
        "reverify_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "kernel-or-kmod-change",
              "firmware-change",
              "boot-manifest-change",
              "role-regression",
              "qualification-profile-change",
              "recovery-lane-change"
            ]
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Concrete freshness bounds derived from the qualification profile and the last successful verification time."
    }
  },
  "additionalProperties": false
}
