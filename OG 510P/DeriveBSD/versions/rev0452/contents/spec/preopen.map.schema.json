{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD preopened capability map for Capsicum launchers (preopen.map) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "map_version",
    "map_id",
    "created_at",
    "entries"
  ],
  "properties": {
    "kind": {"const": "preopen.map"},
    "map_version": {"type": "string", "const": "0.1"},
    "map_id": {
      "type": "string",
      "description": "Stable id for the map (UUID recommended)."
    },
    "created_at": {"type": "string", "format": "date-time"},

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation/domain/service).",
      "properties": {
        "host_id": {"type": "string"},
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "domain_kind": {"type": "string", "enum": ["host", "jail", "microvm"]},
        "domain_id": {"type": "string"},
        "service_id": {"type": "string"},
        "generation_id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "derived_from": {
      "type": "object",
      "description": "Optional provenance pointers for the compiler/inputs that produced the map.",
      "properties": {
        "derive_unit_digest": {"type": "string"},
        "sandbox_profile_digest": {"type": "string"},
        "compiler_digest": {"type": "string"},
        "activation_plan_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "entries": {
      "type": "array",
      "minItems": 1,
      "description": "Stable-ordered list of preopened handles (labels + targets + rights).",
      "items": {"$ref": "#/$defs/entry"}
    },

    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["entry_id", "kind", "rights"],
      "properties": {
        "entry_id": {
          "type": "string",
          "description": "Stable label/id for this handle (e.g., cfg_ro, state_rw, logs_append)."
        },
        "kind": {
          "type": "string",
          "enum": ["dir", "file", "unix_socket", "inet_socket", "other"]
        },

        "path": {
          "type": "string",
          "description": "Path for dir/file/unix_socket entries (path resolution happens before cap_enter)."
        },

        "inet": {
          "type": "object",
          "description": "Inet socket description (used when kind=inet_socket).",
          "required": ["proto", "host", "port"],
          "properties": {
            "proto": {"type": "string", "enum": ["tcp", "udp"]},
            "host": {"type": "string"},
            "port": {"type": "integer", "minimum": 0, "maximum": 65535}
          },
          "additionalProperties": false
        },

        "rights": {
          "type": "array",
          "minItems": 1,
          "description": "Capsicum rights mask labels (treated as stable strings; the launcher lowers to cap_rights_t).",
          "items": {"type": "string"}
        },

        "intent": {
          "type": "string",
          "description": "Optional human hint (why this handle exists)."
        },
        "risk_tags": {
          "type": "array",
          "description": "Optional coarse tags for UIs (does not replace diff/gates).",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
