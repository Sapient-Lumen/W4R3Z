{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD role-binding stale-write denial event profile (intent.role.binding.event.write-denied.precondition) (v0.1)",
  "allOf": [
    {
      "$ref": "intent.role.binding.event.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "intent.role.binding.event"
        },
        "action": {
          "const": "write-denied"
        },
        "reason_code": {
          "const": "precondition-failed",
          "description": "The winning denial after applicable policy-window checks passed and compare-and-swap found stale remembered-role state."
        },
        "observed_binding": {
          "$ref": "intent.role.binding.event.schema.json#/$defs/bindingRef"
        }
      },
      "required": [
        "action",
        "reason_code",
        "observed_binding"
      ]
    }
  ]
}
