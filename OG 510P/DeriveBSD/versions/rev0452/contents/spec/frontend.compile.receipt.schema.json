{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD frontend compile receipt (frontend.compile.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "authority_semantics",
    "issued_at",
    "source_frontend",
    "sources",
    "compiler",
    "compiled_object"
  ],
  "properties": {
    "kind": {
      "const": "frontend.compile.receipt"
    },
    "receipt_version": {
      "type": "string",
      "const": "0.1"
    },
    "authority_semantics": {
      "type": "string",
      "const": "frontend-compilation-evidence-only",
      "description": "Explicitly marks frontend.compile.receipt as compiler/source provenance evidence rather than policy or runtime authority."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_frontend": {
      "type": "string",
      "enum": [
        "json",
        "hujson",
        "cue",
        "pkl",
        "nickel",
        "starlark",
        "other"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "digest"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "compiler": {
      "type": "object",
      "required": [
        "tool",
        "artifact_digest",
        "invocation_profile",
        "sandbox_profile",
        "network_access",
        "module_imports",
        "file_embedding",
        "external_readers"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "artifact_digest": {
          "type": "string"
        },
        "language_version": {
          "type": "string"
        },
        "invocation_profile": {
          "type": "string"
        },
        "sandbox_profile": {
          "type": "string",
          "enum": [
            "builtin-normalizer",
            "hermetic",
            "workspace-only",
            "custom"
          ]
        },
        "network_access": {
          "type": "string",
          "enum": [
            "forbidden",
            "allowed"
          ]
        },
        "module_imports": {
          "type": "string",
          "enum": [
            "none",
            "workspace-only",
            "locked",
            "other"
          ]
        },
        "resource_reads": {
          "type": "string",
          "enum": [
            "none",
            "workspace-only",
            "explicit-schemes",
            "other"
          ]
        },
        "file_embedding": {
          "type": "string",
          "enum": [
            "forbidden",
            "allowed"
          ]
        },
        "external_readers": {
          "type": "string",
          "enum": [
            "forbidden",
            "allowed"
          ]
        }
      },
      "additionalProperties": false
    },
    "compiled_object": {
      "type": "object",
      "required": [
        "kind",
        "digest",
        "schema_path"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "schema_path": {
          "type": "string"
        },
        "example_path": {
          "type": "string"
        },
        "canonicalization": {
          "type": "string",
          "enum": [
            "jcs",
            "none",
            "other"
          ]
        }
      },
      "additionalProperties": false
    },
    "trace_digest": {
      "type": "string"
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "messages_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
