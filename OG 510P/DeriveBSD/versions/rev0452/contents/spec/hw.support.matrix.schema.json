{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD hardware support matrix (hw.support.matrix) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "matrix_version",
    "matrix_id",
    "created_at",
    "target",
    "entries",
    "default_policy"
  ],
  "properties": {
    "kind": {
      "const": "hw.support.matrix"
    },
    "matrix_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "matrix_id": {
      "type": "string",
      "description": "Stable id for this matrix (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "artifact_kind",
        "artifact_digest",
        "release_train"
      ],
      "properties": {
        "artifact_kind": {
          "type": "string",
          "enum": [
            "host.generation",
            "release.capsule",
            "reset.authorization",
            "base.set"
          ]
        },
        "artifact_digest": {
          "type": "string"
        },
        "boot_manifest_digest": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "release_train": {
          "type": "string",
          "description": "Release-train identifier this artifact is scoped to."
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "A",
          "B",
          "C",
          "D"
        ]
      },
      "uniqueItems": true,
      "description": "Profiles this matrix is intended to inform. Omit to keep it generic."
    },
    "identifier_posture": {
      "type": "string",
      "enum": [
        "hardware-class-summary-only"
      ],
      "description": "How selectors avoid per-host identity coupling."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entry_id",
          "support_level",
          "roles",
          "match"
        ],
        "properties": {
          "entry_id": {
            "type": "string"
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ]
            },
            "uniqueItems": true
          },
          "support_level": {
            "type": "string",
            "enum": [
              "supported",
              "conditional",
              "canary-only",
              "blocked",
              "maintenance-only"
            ]
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "boot-storage",
                "primary-network",
                "trusted-display",
                "trusted-input",
                "maintenance-network",
                "usb-quarantine",
                "gpu-accel",
                "camera",
                "microphone",
                "tpm",
                "general"
              ]
            }
          },
          "match": {
            "type": "object",
            "properties": {
              "pci": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "vendor_id",
                    "device_id"
                  ],
                  "properties": {
                    "vendor_id": {
                      "type": "string"
                    },
                    "device_id": {
                      "type": "string"
                    },
                    "subsystem_vendor_id": {
                      "type": "string"
                    },
                    "subsystem_device_id": {
                      "type": "string"
                    },
                    "class_code": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "usb": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "vid",
                    "pid"
                  ],
                  "properties": {
                    "vid": {
                      "type": "string"
                    },
                    "pid": {
                      "type": "string"
                    },
                    "class_code": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "acpi_hids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "smbios_chids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "board_products": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "cpu_arches": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "virtualization": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "bare-metal",
                    "bhyve-guest",
                    "other-vmm-guest"
                  ]
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          },
          "expectations": {
            "type": "object",
            "properties": {
              "required_drivers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "required_modules": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "required_firmware": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "required_recovery": {
                "type": "string",
                "enum": [
                  "none",
                  "local-verified-recovery",
                  "out-of-band-console",
                  "offline-reset-media"
                ]
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional digests/pointers to supporting evidence (test receipts, vendor qualification bundles, etc.)."
          },
          "notes": {
            "type": "string"
          },
          "qualification": {
            "type": "object",
            "required": [
              "stage",
              "verified_roles",
              "evidence_floor",
              "regression_policy",
              "target_binding",
              "last_verified_at",
              "receipt_digest",
              "profile_digest"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "enum": [
                  "lab-validated",
                  "canary-observed",
                  "release-qualified",
                  "field-sustained"
                ]
              },
              "verified_roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "boot-storage",
                    "primary-network",
                    "trusted-display",
                    "trusted-input",
                    "maintenance-network",
                    "usb-quarantine",
                    "gpu-accel",
                    "camera",
                    "microphone",
                    "tpm",
                    "general"
                  ]
                }
              },
              "evidence_floor": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "boot",
                    "generation-switch",
                    "rollback-or-recovery",
                    "trusted-ui-basic",
                    "network-basic",
                    "device-mediation-basic",
                    "suspend-resume"
                  ]
                }
              },
              "regression_policy": {
                "type": "string",
                "enum": [
                  "retest-on-kernel-or-firmware-change",
                  "retest-on-release-candidate",
                  "continuous-regression-watch"
                ]
              },
              "last_verified_at": {
                "type": "string",
                "format": "date-time"
              },
              "receipt_digest": {
                "type": "string",
                "description": "Digest of the canonical hw.support.qualification.receipt backing this summary."
              },
              "profile_digest": {
                "type": "string",
                "description": "Digest of the hw.support.qualification.profile that defines the qualification floor for this claim."
              },
              "notes": {
                "type": "string"
              },
              "target_binding": {
                "type": "string",
                "enum": [
                  "exact-artifact-digest",
                  "same-release-train",
                  "same-release-train-and-boot-manifest"
                ],
                "description": "How far this qualification proof is allowed to apply beyond the exact published target artifact."
              }
            },
            "additionalProperties": false,
            "description": "Typed promotion/qualification summary for positive support claims."
          },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "condition_id",
                "reason_code",
                "summary",
                "required_posture"
              ],
              "properties": {
                "condition_id": {
                  "type": "string"
                },
                "reason_code": {
                  "type": "string",
                  "enum": [
                    "topology-variant-unverified",
                    "peripheral-cohort-unverified",
                    "firmware-cohort-unverified",
                    "recovery-prerequisite",
                    "operating-mode-unverified",
                    "performance-floor-not-qualified"
                  ]
                },
                "affected_roles": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "boot-storage",
                      "primary-network",
                      "trusted-display",
                      "trusted-input",
                      "maintenance-network",
                      "usb-quarantine",
                      "gpu-accel",
                      "camera",
                      "microphone",
                      "tpm",
                      "general"
                    ]
                  }
                },
                "summary": {
                  "type": "string"
                },
                "required_posture": {
                  "type": "string",
                  "enum": [
                    "trusted-ui-consent",
                    "verified-recovery-required",
                    "breakglass",
                    "maintenance-window-only",
                    "deny-until-qualified"
                  ]
                },
                "notes": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "description": "Typed support limitations / prerequisites that make the entry conditional, canary-only, or maintenance-only."
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "support_level": {
                  "enum": [
                    "supported",
                    "conditional",
                    "canary-only",
                    "maintenance-only"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "qualification"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "support_level": {
                  "const": "blocked"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "qualification"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "support_level": {
                  "enum": [
                    "conditional",
                    "canary-only",
                    "maintenance-only"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "conditions"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "support_level": {
                  "enum": [
                    "supported",
                    "blocked"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "conditions"
                ]
              }
            }
          }
        ]
      }
    },
    "default_policy": {
      "type": "object",
      "required": [
        "on_miss",
        "on_conditional"
      ],
      "properties": {
        "on_miss": {
          "type": "string",
          "enum": [
            "warn",
            "deny",
            "require-breakglass"
          ]
        },
        "on_conditional": {
          "type": "string",
          "enum": [
            "warn",
            "deny",
            "trusted-ui-consent",
            "require-breakglass"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
