{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Intent Role Binding Event (intent.role.binding.event) (v0.1)",
  "$defs": {
    "bindingRef": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string"
        },
        "binding_id": {
          "type": "string"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "diffRef": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "event.record.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "event_version",
        "event_id",
        "at",
        "source",
        "severity",
        "subject",
        "action"
      ],
      "properties": {
        "kind": {
          "const": "intent.role.binding.event"
        },
        "event_version": {
          "type": "string",
          "const": "0.1"
        },
        "event_id": {
          "type": "string",
          "description": "Stable id (UUID recommended)."
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "Emitter name (trusted settings UI, admin CLI wrapper, reconcile daemon, etc.)."
            },
            "host_id": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            },
            "service_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error",
            "critical"
          ]
        },
        "subject": {
          "type": "object",
          "required": [
            "host_id",
            "profile_id"
          ],
          "properties": {
            "host_id": {
              "type": "string"
            },
            "profile_id": {
              "type": "string",
              "enum": [
                "fleet_host",
                "workstation",
                "general_os",
                "appliance_factory"
              ]
            }
          },
          "additionalProperties": false
        },
        "action": {
          "type": "string",
          "enum": [
            "initialized",
            "updated",
            "write-denied"
          ]
        },
        "trigger": {
          "type": "string",
          "description": "authority/apply lane for the mutation; invocation surfaces belong in source metadata instead of trigger vocabulary.",
          "enum": [
            "trusted-settings-ui",
            "policy-reconcile",
            "support-import"
          ]
        },
        "binding": {
          "$ref": "#/$defs/bindingRef"
        },
        "previous_binding": {
          "$ref": "#/$defs/bindingRef"
        },
        "diff": {
          "$ref": "#/$defs/diffRef"
        },
        "roles_touched": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "browsing",
              "communications"
            ]
          },
          "uniqueItems": true
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "consent_receipt_digest": {
          "type": "string",
          "description": "Optional digest of the joined consent.receipt when the interactive approval lane was used."
        },
        "decision_reason": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "policy_decision_digest": {
          "type": "string",
          "description": "Optional digest of the joined policy.decision record when the mutation was authorized by a non-interactive reconcile/apply lane."
        },
        "consumed_by_event_id": {
          "type": "string",
          "description": "For remembered-role `policy-consumed` denials, identifies the earlier successful event_id that consumed the joined exact-mutation policy decision instance. Retry/reporting logic may collapse the denial to already-applied only when that consuming event is resolved and matches the same exact mutation tuple."
        },
        "consumed_by_event_digest": {
          "type": "string",
          "description": "For remembered-role `policy-consumed` denials, digest of the canonical bytes of the earlier successful event identified by consumed_by_event_id. Offline bundles should verify the joined winner event bytes against this digest before trusting already-applied recovery summaries."
        },
        "consuming_event_action": {
          "type": "string",
          "enum": [
            "initialized",
            "updated"
          ],
          "description": "For remembered-role `policy-consumed` denials, summarizes the earlier successful consuming event's action so detached retry/export/support readers can tell whether the winner was a first-write `initialized` event or a compare-and-swap `updated` event without reopening the winner event body. When this is `updated`, `consumed_previous_binding_digest` keeps that winning compare-and-swap starting point queryable as evidence-only summary data."
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "policy-denied",
            "policy-expired",
            "policy-consumed",
            "consent-denied",
            "consent-timeout",
            "precondition-failed",
            "target-unavailable"
          ],
          "description": "Typed denial reason for write-denied events. For non-interactive remembered-role applies, policy-denied / policy-consumed / policy-expired are normal request checks that precede precondition-failed compare-and-swap stale-state denial; expired/consumed joined-policy failures therefore stay distinct from stale-state denial."
        },
        "observed_binding": {
          "$ref": "#/$defs/bindingRef"
        },
        "import_receipt_digest": {
          "type": "string",
          "description": "Optional digest of the joined content.import.receipt record when remembered role/default state was changed by a support/import/recovery workflow."
        },
        "recovery_interpretation": {
          "type": "string",
          "enum": [
            "policy-consumed",
            "already-applied"
          ],
          "description": "evidence-only retry/reporting summary for remembered-role policy-consumed denials. This never overrides action or reason_code: `policy-consumed` means no exact-match replay collapse was proven; `already-applied` means the denial joined a consuming success for the same exact mutation tuple."
        },
        "consumed_binding_digest": {
          "type": "string",
          "description": "For remembered-role `policy-consumed` denials, the resulting binding.digest from the earlier successful consuming event. This is evidence-only summary data for retry/export/support flows; it does not claim that the same binding is still current at some later read time."
        },
        "consumed_diff_digest": {
          "type": "string",
          "description": "For remembered-role `policy-consumed` denials, the earlier successful consuming event's diff.digest. This keeps the winning reviewed change queryable as evidence-only summary data for retry/export/support flows without reopening the winner event body."
        },
        "consumed_previous_binding_digest": {
          "type": "string",
          "description": "For remembered-role `policy-consumed` denials where the earlier successful consuming event was `updated`, the earlier winner's previous_binding.digest. This keeps the winning compare-and-swap starting point queryable as evidence-only summary data for retry/export/support flows without reopening the winner event body."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "initialized",
                  "updated"
                ]
              }
            }
          },
          "then": {
            "required": [
              "binding",
              "roles_touched"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "updated"
              }
            }
          },
          "then": {
            "required": [
              "previous_binding",
              "diff"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "write-denied"
              }
            }
          },
          "then": {
            "required": [
              "roles_touched",
              "decision_reason",
              "diff",
              "reason_code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "trigger": {
                "const": "policy-reconcile"
              }
            }
          },
          "then": {
            "required": [
              "policy_decision_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "trigger": {
                "const": "support-import"
              }
            }
          },
          "then": {
            "required": [
              "import_receipt_digest"
            ]
          }
        },
        {
          "if": {
            "required": [
              "reason_code"
            ],
            "properties": {
              "reason_code": {
                "const": "policy-consumed"
              }
            }
          },
          "then": {
            "required": [
              "consumed_by_event_id",
              "consumed_by_event_digest",
              "consuming_event_action",
              "consumed_binding_digest",
              "consumed_diff_digest",
              "recovery_interpretation"
            ]
          }
        },
        {
          "if": {
            "required": [
              "reason_code"
            ],
            "properties": {
              "reason_code": {
                "const": "precondition-failed"
              }
            }
          },
          "then": {
            "required": [
              "observed_binding"
            ]
          }
        },
        {
          "if": {
            "required": [
              "reason_code",
              "consuming_event_action"
            ],
            "properties": {
              "reason_code": {
                "const": "policy-consumed"
              },
              "consuming_event_action": {
                "const": "updated"
              }
            }
          },
          "then": {
            "required": [
              "consumed_previous_binding_digest"
            ]
          }
        },
        {
          "if": {
            "required": [
              "reason_code",
              "consuming_event_action"
            ],
            "properties": {
              "reason_code": {
                "const": "policy-consumed"
              },
              "consuming_event_action": {
                "const": "initialized"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "consumed_previous_binding_digest"
              ]
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "reason_code": {
                  "const": "policy-consumed"
                }
              },
              "required": [
                "reason_code"
              ]
            }
          },
          "then": {
            "not": {
              "required": [
                "recovery_interpretation"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    }
  ]
}
