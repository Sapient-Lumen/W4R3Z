{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD packet capture session (packet.capture.session) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "session_version",
    "session_id",
    "created_at",
    "purpose",
    "scope",
    "capture",
    "bounds",
    "export"
  ],
  "properties": {
    "kind": {
      "const": "packet.capture.session"
    },
    "session_version": {
      "type": "string",
      "const": "0.1"
    },
    "session_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "incident",
        "canary",
        "maintenance",
        "trusted-host-admin",
        "lab",
        "custom"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "host_id",
        "interfaces"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "service_id": {
          "type": "string"
        },
        "jail_id": {
          "type": "string"
        },
        "vm_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "required": [
        "backend",
        "selector",
        "snaplen"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "bpf",
            "pcap",
            "netmap"
          ]
        },
        "snaplen": {
          "type": "integer",
          "minimum": 1
        },
        "promiscuous": {
          "type": "boolean",
          "default": false
        },
        "payload_mode": {
          "type": "string",
          "enum": [
            "headers-only",
            "bounded-packets",
            "full-packets"
          ],
          "default": "headers-only"
        },
        "selector": {
          "$ref": "packet.capture.selector.schema.json"
        }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": [
        "max_duration_seconds",
        "max_packets",
        "max_bytes"
      ],
      "properties": {
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_packets": {
          "type": "integer",
          "minimum": 1
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "local_storage": {
          "type": "string",
          "enum": [
            "ephemeral-local",
            "sealed-local",
            "incident-bundle-reference-eligible"
          ]
        },
        "max_local_retention_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "local_storage",
        "max_local_retention_seconds"
      ]
    },
    "export": {
      "type": "object",
      "required": [
        "default_mode",
        "raw_payload_export"
      ],
      "properties": {
        "default_mode": {
          "type": "string",
          "enum": [
            "metadata-only",
            "summary-only"
          ]
        },
        "raw_payload_export": {
          "type": "string",
          "enum": [
            "forbidden",
            "explicit-policy-and-approval",
            "maintenance-only"
          ]
        },
        "summary_kind": {
          "type": "string",
          "const": "packet.capture.summary"
        }
      },
      "additionalProperties": false
    },
    "related": {
      "type": "object",
      "properties": {
        "incident_id": {
          "type": "string"
        },
        "net_egress_policy_digest": {
          "type": "string"
        },
        "lease_envelope_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
