{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD attestation reference values (attestation.reference) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "reference_version",
    "created_at",
    "scope",
    "pcr_selection",
    "boot"
  ],
  "properties": {
    "kind": {
      "const": "attestation-reference"
    },
    "reference_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "reference_id": {
      "type": "string",
      "description": "Stable id for the reference values object (UUID recommended). Useful for correlation, not for recency or overlap precedence."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "description": "Policy scope this reference applies to (fleet role, pool, hardware class, etc.).",
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable scope name (e.g. prod/web, ci/builders, edge/gw)."
        },
        "selector": {
          "type": "object",
          "description": "Optional selector hints for packaging/discovery/admission wiring. Not an implicit precedence or newest-match resolver key; attestation decisions stay pinned to an exact reference digest."
        },
        "kind": {
          "type": "string",
          "enum": [
            "cohort",
            "deployment",
            "host"
          ],
          "description": "Authoring scope for this reference. Routine references should be cohort-scoped; host scope is exceptional."
        }
      },
      "additionalProperties": false
    },
    "pcr_selection": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "bank",
          "pcrs"
        ],
        "properties": {
          "bank": {
            "type": "string",
            "description": "PCR bank algorithm (sha1, sha256, sha384, ...)."
          },
          "pcrs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            }
          }
        },
        "additionalProperties": false
      }
    },
    "boot": {
      "type": "object",
      "description": "Boot reference values (prefer event-log replay against manifests).",
      "required": [
        "accepted_boot_manifest_digests",
        "variance"
      ],
      "properties": {
        "accepted_boot_manifest_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "accepted_generation_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strict_pcr_values": {
          "type": "array",
          "description": "Optional strict PCR allowlist (only for controlled platforms).",
          "items": {
            "type": "object",
            "required": [
              "bank",
              "pcr",
              "value_hex"
            ],
            "properties": {
              "bank": {
                "type": "string"
              },
              "pcr": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "value_hex": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]+$"
              }
            },
            "additionalProperties": false
          }
        },
        "variance": {
          "type": "object",
          "description": "How the verifier should treat expected measurement variance for this reference.",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "manifest-replay-first",
                "mixed",
                "strict-pcr-only"
              ],
              "description": "Bias toward manifest replay, a mixed replay+strict mode, or an exceptional strict-PCR-only mode."
            },
            "allowed_degraded_reason_codes": {
              "type": "array",
              "description": "Optional coarse verifier reason codes that may yield verdict=degraded instead of fail for this reference.",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "bootchain_policy_digest": {
      "type": "string",
      "description": "Optional digest/id of bootchain.policy used for targeted revocation/allowlisting."
    },
    "firmware": {
      "type": "object",
      "description": "Optional firmware expectations.",
      "properties": {
        "require_esrt": {
          "type": "boolean",
          "default": false
        },
        "accepted_fw_inventory_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "description": "Optional runtime integrity reference (IMA-shaped).",
      "properties": {
        "runtime_policy_digest": {
          "type": "string",
          "description": "Digest of runtime policy object (allowlist/appraisal rules)."
        },
        "required": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    },
    "exception": {
      "type": "object",
      "description": "Required review metadata when the reference leaves the ordinary cohort + manifest-replay-first baseline.",
      "required": [
        "reason",
        "justification",
        "expires_at",
        "approvals",
        "renewal_posture"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "rollout-window",
            "hardware-containment",
            "firmware-class-drift",
            "regulatory-pin",
            "legacy-bridge",
            "incident-containment",
            "lab-calibration",
            "other"
          ],
          "description": "Why this reference must deviate from the ordinary cohort baseline."
        },
        "change_id": {
          "type": "string",
          "description": "Optional change / rollout / incident id for the exception."
        },
        "ticket": {
          "type": "string",
          "description": "Optional ticket / review id for the exception."
        },
        "justification": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Renewal deadline. Exception references are timeboxed and must be re-reviewed instead of living forever."
        },
        "approvals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "approver",
              "role"
            ],
            "properties": {
              "approver": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "renewal_posture": {
          "type": "string",
          "enum": [
            "fresh-exception",
            "supersedes-prior-exception"
          ],
          "description": "Whether this exception starts a new reviewed exception story or is the reviewed successor of an earlier exception reference."
        },
        "supersedes_reference_digest": {
          "type": "string",
          "description": "Digest of the prior attestation.reference superseded by this renewed exception. Renewal stays new-artifact-plus-predecessor-digest, not in-place extension."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "renewal_posture": {
                "const": "supersedes-prior-exception"
              }
            }
          },
          "then": {
            "required": [
              "supersedes_reference_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "renewal_posture": {
                "const": "fresh-exception"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "supersedes_reference_digest"
              ]
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "kind": {
                "const": "deployment"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "exception"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "kind": {
                "const": "host"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "exception"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "boot": {
            "properties": {
              "variance": {
                "properties": {
                  "mode": {
                    "enum": [
                      "mixed",
                      "strict-pcr-only"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "exception"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "boot": {
            "properties": {
              "variance": {
                "properties": {
                  "mode": {
                    "const": "manifest-replay-first"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "boot": {
            "not": {
              "required": [
                "strict_pcr_values"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "boot": {
            "properties": {
              "variance": {
                "properties": {
                  "mode": {
                    "const": "strict-pcr-only"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "boot": {
            "required": [
              "strict_pcr_values"
            ]
          }
        }
      }
    }
  ]
}
