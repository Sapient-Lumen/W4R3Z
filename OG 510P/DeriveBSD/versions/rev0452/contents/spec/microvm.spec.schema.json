{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD authoring Spec (microvm target) (v0.1)",
  "description": "A minimal microVM-oriented authoring format (target descriptors) that compiles to Derive IR.",
  "allOf": [
    { "$ref": "minimal.spec.schema.json" },
    {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "targets": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "microvms": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "image"],
                "additionalProperties": true,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "image": {
                    "type": "object",
                    "required": ["closure"],
                    "additionalProperties": true,
                    "properties": {
                      "closure": { "type": "string", "minLength": 1 }
                    }
                  },
                  "resources": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "cpu": { "type": "integer", "minimum": 1 },
                      "mem_mb": { "type": "integer", "minimum": 16 }
                    }
                  },
                  "network": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "mode": { "type": "string", "minLength": 1 }
                    }
                  },
                  "secrets": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "required": {
                        "type": "array",
                        "items": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
