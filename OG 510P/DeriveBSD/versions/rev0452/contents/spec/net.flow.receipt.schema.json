{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Network Flow Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "grant_digest",
    "subject",
    "flows",
    "captured_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "net-flow-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "grant_digest": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "flow_id",
          "proto",
          "remote",
          "outcome"
        ],
        "properties": {
          "flow_id": {
            "type": "string"
          },
          "proto": {
            "type": "string",
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "remote": {
            "type": "object",
            "required": [
              "ip",
              "port"
            ],
            "properties": {
              "ip": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "hostname": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "bytes_sent": {
            "type": "integer",
            "minimum": 0
          },
          "bytes_received": {
            "type": "integer",
            "minimum": 0
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "allowed",
              "denied",
              "failed",
              "timeout"
            ]
          },
          "dns_query_receipt_digest": {
            "type": "string",
            "description": "Optional digest of a net-dns-query-receipt providing name\u2192address provenance for this flow."
          }
        },
        "additionalProperties": false
      }
    },
    "redaction_transform_digest": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
