{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Capability Token Metadata (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "token_version",
    "token_digest",
    "format",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "capability-token"},
    "token_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "token_digest": {
      "type": "string",
      "description": "Digest of the raw bearer token bytes (e.g., sha256:...). Raw token bytes must not be stored in the content-addressed store."
    },

    "format": {
      "type": "string",
      "enum": ["macaroon", "biscuit", "ucan", "opaque"],
      "description": "Token format identifier. 'opaque' means the verifier understands it but the archive does not model its structure."
    },

    "expires_at": {"type": "string", "description": "ISO8601 time (recommended; effectively required for bearer tokens)."},

    "caveats": {
      "type": "array",
      "description": "Redacted, structured caveat summary; must not include secret bytes.",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"type": "string", "description": "e.g. method, path, args, audience, ip, time"},
          "value": {"description": "Redacted/canonical value.", "additionalProperties": true}
        },
        "additionalProperties": false
      }
    },

    "context": {
      "type": "object",
      "description": "Optional linkage to higher-level DeriveBSD objects.",
      "properties": {
        "plan_digest": {"type": "string"},
        "policy_decision_digest": {"type": "string"},
        "portal_grant_digest": {"type": "string"},
        "lease_id": {"type": "string"}
      },
      "additionalProperties": false
    },

    "issued_at": {"type": "string", "description": "ISO8601 time."},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string", "description": "Signature over canonical JSON bytes."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
