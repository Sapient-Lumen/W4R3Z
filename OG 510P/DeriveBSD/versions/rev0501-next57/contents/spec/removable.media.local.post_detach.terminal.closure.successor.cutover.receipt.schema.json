    },
    "id": {
      "pattern": "^rm-postdetach-[a-z0-9-]+$",
      "type": "string"
    },
    "schemaPath": {
      "pattern": "^spec/[a-z0-9_.-]+\\.schema\\.json$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
