{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD pin add receipt (pin.add.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "pin"
  ],
  "properties": {
    "kind": { "const": "pin.add.receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "receipt_id": { "type": "string", "description": "Stable id for this receipt (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "host_id": { "type": "string" },

    "requested_by": { "type": "string", "description": "Opaque operator/workflow id (optional)." },
    "policy_digest": { "type": "string", "description": "Optional digest of the policy module(s) authorizing pinning." },

    "pin": {
      "type": "object",
      "required": ["name", "target"],
      "properties": {
        "name": { "type": "string", "description": "Human-friendly pin name (stable handle)." },
        "target": {
          "type": "object",
          "required": ["ref"],
          "properties": {
            "ref": { "type": "string", "description": "Target reference (digest, store path, ZFS snapshot, etc)." },
            "digest": { "type": "string" },
            "target_kind": { "type": "string" }
          },
          "additionalProperties": false
        },
        "reason": { "type": "string" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
