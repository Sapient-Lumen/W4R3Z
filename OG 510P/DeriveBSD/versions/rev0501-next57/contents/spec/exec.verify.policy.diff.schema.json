{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD exec integrity policy drift (exec.verify.policy.diff) (v0.1)",
  "description": "Canonical drift surface for authoritative exec.integrity.policy objects. The historic artifact kind name is retained for continuity.",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_policy",
    "to_policy",
    "scope_changes",
    "summary"
  ],
  "properties": {
    "kind": {
      "const": "exec.verify.policy.diff"
    },
    "diff_version": {
      "type": "string",
      "const": "0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation/domain).",
      "properties": {
        "host_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "domain": {
          "type": "string"
        },
        "from_generation": {
          "type": "string"
        },
        "to_generation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "from_policy": {
      "$ref": "#/$defs/policy_ref"
    },
    "to_policy": {
      "$ref": "#/$defs/policy_ref"
    },
    "scope_changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scope_change"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "scopes_changed",
        "exceptions_added",
        "exceptions_removed",
        "exceptions_changed"
      ],
      "properties": {
        "scopes_changed": {
          "type": "integer",
          "minimum": 0
        },
        "exceptions_added": {
          "type": "integer",
          "minimum": 0
        },
        "exceptions_removed": {
          "type": "integer",
          "minimum": 0
        },
        "exceptions_changed": {
          "type": "integer",
          "minimum": 0
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "policy_ref": {
      "type": "object",
      "description": "Reference to an exec.integrity.policy object by digest (and optional human fields).",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "host",
            "service",
            "appvm",
            "builder"
          ]
        },
        "selector": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "mode_change": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string",
              "enum": [
                "off",
                "warn",
                "enforce"
              ]
            },
            "to": {
              "type": "string",
              "enum": [
                "off",
                "warn",
                "enforce"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "exception": {
      "type": "object",
      "required": [
        "type",
        "value",
        "reason"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "path",
            "digest",
            "class"
          ]
        },
        "value": {
          "type": "string"
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "exception_change": {
      "type": "object",
      "required": [
        "type",
        "value",
        "from",
        "to"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "path",
            "digest",
            "class"
          ]
        },
        "value": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/exception"
        },
        "to": {
          "$ref": "#/$defs/exception"
        },
        "fields_changed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ttl_seconds",
              "reason"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "scope_change": {
      "type": "object",
      "required": [
        "subject",
        "allowed_sources_added",
        "allowed_sources_removed",
        "exceptions_added",
        "exceptions_removed",
        "exceptions_changed"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "mode_changed": {
          "$ref": "#/$defs/mode_change"
        },
        "allowed_sources_added": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "store-only",
              "signed-bundle",
              "breakglass-only",
              "policy-allowlisted"
            ]
          }
        },
        "allowed_sources_removed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "store-only",
              "signed-bundle",
              "breakglass-only",
              "policy-allowlisted"
            ]
          }
        },
        "exceptions_added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exception"
          }
        },
        "exceptions_removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exception"
          }
        },
        "exceptions_changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exception_change"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
