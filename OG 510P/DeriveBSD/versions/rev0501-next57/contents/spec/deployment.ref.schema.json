{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD deployment reference (v0)",
  "type": "object",
  "required": [
    "kind",
    "ref_version",
    "deployment_id",
    "bindings"
  ],
  "properties": {
    "kind": {"const": "deployment-ref"},
    "ref_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "deployment_id": {"type": "string", "description": "Content digest of the deployment ref itself (or a stable id)."},
    "bindings": {
      "type": "object",
      "required": ["plan_digest", "policy_decision_digest", "closure_digest"],
      "properties": {
        "plan_digest": {"type": "string"},
        "policy_decision_digest": {"type": "string"},
        "closure_digest": {"type": "string"},
        "root_tree_digest": {"type": "string"}
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "digest"],
        "properties": {
          "kind": {"type": "string"},
          "digest": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key_id", "sig"],
        "properties": {
          "key_id": {"type": "string"},
          "sig": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "namespace": {"type": "string"},
        "channel": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
