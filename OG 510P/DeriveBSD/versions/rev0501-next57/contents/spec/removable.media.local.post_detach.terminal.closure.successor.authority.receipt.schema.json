{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Removable-Media Local Post-Detach Terminal Closure Successor Authority Receipt",
  "description": "Runtime contract for r532 successor authority after terminal closure: old managed authority must have been denied first, fresh authority must be bound by computed digest, and any successor must be issued from new authority only. post-detach-terminal-closure-successor-authority-positive-and-negative-fixture-guarded.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^rm-postdetach-[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}r\\d+$"
    },
    "schemaPath": {
      "type": "string",
      "pattern": "^spec/[a-z0-9_.-]+\\.schema\\.json$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "supportVisibility": {
      "enum": [
        "support-safe-digest-only"
      ],
      "type": "string"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "generated_for_version",
    "successor_authority_receipt_id",
    "lane",
    "source_bindings",
    "closure_access_binding",
    "new_authority_request",
    "fresh_authority_binding",
    "successor_issuance",
    "successor_ledger",
    "support_projection",
    "invariants",
    "negative_fixture_policy"
  ],
  "properties": {
    "kind": {
      "const": "removable.media.local.post_detach.terminal.closure.successor.authority.receipt"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "generated_for_version": {
      "$ref": "#/$defs/version"
    },
    "successor_authority_receipt_id": {
      "$ref": "#/$defs/id"
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "phase",
        "identity_policy"
      ],
      "properties": {
        "family": {
          "enum": [
            "removable-media-local-fallback"
          ]
        },
        "phase": {
          "enum": [
            "post-detach"
          ]
        },
        "identity_policy": {
          "enum": [
            "family-normalized-phase-by-kind"
          ]
        }
      }
    },
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_digest_rule",
        "terminal_closure_capsule_computed_digest",
        "terminal_closure_access_receipt_computed_digest",
        "fresh_authority_receipt_computed_digest",
        "denial_reason_registry_computed_digest",
        "denial_selection_receipt_computed_digest",
        "rate_limit_debit_ledger_receipt_computed_digest",
        "support_projection_computed_digest",
        "reader_admission_receipt_computed_digest"
      ],
      "properties": {
        "canonical_digest_rule": {
          "enum": [
            "json-sort-keys-compact-utf8-sha256"
          ]
        },
        "terminal_closure_capsule_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "terminal_closure_access_receipt_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "fresh_authority_receipt_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "denial_reason_registry_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "denial_selection_receipt_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "rate_limit_debit_ledger_receipt_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "support_projection_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "reader_admission_receipt_computed_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "closure_access_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_closure_capsule_id",
        "terminal_closure_capsule_digest",
        "terminal_closure_access_receipt_id",
        "terminal_closure_access_receipt_digest",
        "prior_access_outcome",
        "prior_gate_reason_code",
        "old_authority_denied_before_successor_issue",
        "rate_limit_debited_for_denied_attempt"
      ],
      "properties": {
        "terminal_closure_capsule_id": {
          "$ref": "#/$defs/id"
        },
        "terminal_closure_capsule_digest": {
          "$ref": "#/$defs/sha256"
        },
        "terminal_closure_access_receipt_id": {
          "$ref": "#/$defs/id"
        },
        "terminal_closure_access_receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "prior_access_outcome": {
          "enum": [
            "deny-post-closure-old-authority"
          ]
        },
        "prior_gate_reason_code": {
          "enum": [
            "terminal-closure-managed-authority-closed"
          ]
        },
        "old_authority_denied_before_successor_issue": {
          "enum": [
            true
          ]
        },
        "rate_limit_debited_for_denied_attempt": {
          "enum": [
            true
          ]
        }
      }
    },
    "new_authority_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "requested_action",
        "actor_digest",
        "requested_at",
        "closure_state_seen",
        "ambient_reauthentication_attempted",
        "old_handle_presented_as_authority",
        "old_handle_digest",
        "raw_handle_values_included",
        "raw_locator_values_included"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "requested_action": {
          "enum": [
            "query",
            "export",
            "rehydrate",
            "observe",
            "managed-copy",
            "support-debug"
          ]
        },
        "actor_digest": {
          "$ref": "#/$defs/sha256"
        },
        "requested_at": {
          "$ref": "#/$defs/dateTime"
        },
        "closure_state_seen": {
          "enum": [
            "managed-authority-terminally-closed"
          ]
        },
        "ambient_reauthentication_attempted": {
          "enum": [
            false
          ]
        },
        "old_handle_presented_as_authority": {
          "enum": [
            false
          ]
        },
        "old_handle_digest": {
          "$ref": "#/$defs/sha256"
        },
        "raw_handle_values_included": {
          "enum": [
            false
          ]
        },
        "raw_locator_values_included": {
          "enum": [
            false
          ]
        }
      }
    },
    "fresh_authority_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_authority_receipt_kind",
        "fresh_authority_receipt_schema",
        "fresh_authority_receipt_digest",
        "fresh_authority_exact_fixture_schema",
        "approval_receipt_digest",
        "policy_digest",
        "new_lease_digest",
        "user_presence",
        "fresh_lease_required_after_terminal_closure",
        "stale_handle_reused",
        "tombstone_bypass",
        "old_handle_reused"
      ],
      "properties": {
        "fresh_authority_receipt_kind": {
          "enum": [
            "removable.media.local.post_detach.fresh.authority.receipt"
          ]
        },
        "fresh_authority_receipt_schema": {
          "$ref": "#/$defs/schemaPath"
        },
        "fresh_authority_receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "fresh_authority_exact_fixture_schema": {
          "$ref": "#/$defs/schemaPath"
        },
        "approval_receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "new_lease_digest": {
          "$ref": "#/$defs/sha256"
        },
        "user_presence": {
          "enum": [
            "fresh-local-user-presence-or-admin-breakglass-receipt"
          ]
        },
        "fresh_lease_required_after_terminal_closure": {
          "enum": [
            true
          ]
        },
        "stale_handle_reused": {
          "enum": [
            false
          ]
        },
        "tombstone_bypass": {
          "enum": [
            false
          ]
        },
        "old_handle_reused": {
          "enum": [
            false
          ]
        }
      }
    },
    "successor_issuance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "successor_authority_digest",
        "successor_subject_digest",
        "successor_scope",
        "old_handle_reused",
        "expired_root_resurrected",
        "terminal_closure_reopened",
        "successor_issued_from_old_authority",
        "new_export_approval_required",
        "reader_admission_required_before_reader_use",
        "reader_admission_receipt_kind",
        "reader_admission_receipt_schema",
        "reader_admission_fixture_schema",
        "reader_admission_receipt_digest",
        "reader_admission_legacy_digest"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "successor-authority-issued-from-new-authority-only"
          ]
        },
        "successor_authority_digest": {
          "$ref": "#/$defs/sha256"
        },
        "successor_subject_digest": {
          "$ref": "#/$defs/sha256"
        },
        "successor_scope": {
          "enum": [
            "single-successor-digest-same-or-narrower-than-fresh-authority"
          ]
        },
        "old_handle_reused": {
          "enum": [
            false
          ]
        },
        "expired_root_resurrected": {
          "enum": [
            false
          ]
        },
        "terminal_closure_reopened": {
          "enum": [
            false
          ]
        },
        "successor_issued_from_old_authority": {
          "enum": [
            false
          ]
        },
        "new_export_approval_required": {
          "enum": [
            true
          ]
        },
        "reader_admission_required_before_reader_use": {
          "enum": [
            true
          ]
        },
        "reader_admission_receipt_kind": {
          "enum": [
            "removable.media.local.post_detach.reader.admission.receipt"
          ]
        },
        "reader_admission_receipt_schema": {
          "$ref": "#/$defs/schemaPath"
        },
        "reader_admission_fixture_schema": {
          "$ref": "#/$defs/schemaPath"
        },
        "reader_admission_receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "reader_admission_legacy_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "successor_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker_epoch_id",
        "successor_sequence",
        "prior_root_digest",
        "expected_root_digest",
        "new_root_digest",
        "ledger_anchor_digest",
        "compare_and_swap_result",
        "idempotency_key_digest",
        "replay_outcome",
        "rollback_accepted",
        "forked_root_accepted",
        "stale_root_accepted"
      ],
      "properties": {
        "broker_epoch_id": {
          "pattern": "^rm-postdetach-broker-epoch-[a-z0-9-]+$",
          "type": "string"
        },
        "successor_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "prior_root_digest": {
          "$ref": "#/$defs/sha256"
        },
        "expected_root_digest": {
          "$ref": "#/$defs/sha256"
        },
        "new_root_digest": {
          "$ref": "#/$defs/sha256"
        },
        "ledger_anchor_digest": {
          "$ref": "#/$defs/sha256"
        },
        "compare_and_swap_result": {
          "enum": [
            "committed"
          ]
        },
        "idempotency_key_digest": {
          "$ref": "#/$defs/sha256"
        },
        "replay_outcome": {
          "enum": [
            "first-successor-authority-issue",
            "idempotent-successor-authority-replay-no-new-issue"
          ]
        },
        "rollback_accepted": {
          "enum": [
            false
          ]
        },
        "forked_root_accepted": {
          "enum": [
            false
          ]
        },
        "stale_root_accepted": {
          "enum": [
            false
          ]
        }
      }
    },
    "support_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "support_label",
        "raw_payload_visible",
        "raw_path_visible",
        "filename_visible",
        "device_identifier_visible",
        "host_identity_visible",
        "body_or_full_text_visible",
        "secret_material_visible",
        "offline_erasure_claim"
      ],
      "properties": {
        "visibility": {
          "$ref": "#/$defs/supportVisibility"
        },
        "support_label": {
          "enum": [
            "post-closure-new-authority-issued-digest-only"
          ]
        },
        "raw_payload_visible": {
          "enum": [
            false
          ]
        },
        "raw_path_visible": {
          "enum": [
            false
          ]
        },
        "filename_visible": {
          "enum": [
            false
          ]
        },
        "device_identifier_visible": {
          "enum": [
            false
          ]
        },
        "host_identity_visible": {
          "enum": [
            false
          ]
        },
        "body_or_full_text_visible": {
          "enum": [
            false
          ]
        },
        "secret_material_visible": {
          "enum": [
            false
          ]
        },
        "offline_erasure_claim": {
          "enum": [
            "not-claimed-erased-only-future-authority-controlled"
          ]
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          true
        ]
      },
      "minProperties": 8
    },
    "negative_fixture_policy": {
      "enum": [
        "known-bad-post-detach-terminal-closure-successor-authority-shapes-must-fail-validation"
      ]
    }
  }
}
