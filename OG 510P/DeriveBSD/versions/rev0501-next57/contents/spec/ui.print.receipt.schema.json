{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI Print Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "subject",
    "job_id",
    "destination",
    "submitted_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "ui-print-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "lease_id": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "job_id": {
      "type": "string"
    },
    "destination": {
      "type": "string",
      "enum": [
        "printer",
        "pdf",
        "remote-queue"
      ]
    },
    "bytes_submitted": {
      "type": "integer",
      "minimum": 0
    },
    "redaction_transform_digest": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "Signature over canonical JSON bytes."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
