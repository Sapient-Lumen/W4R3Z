{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Network Listen Grant (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "subject",
    "permissions",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "net-listen-grant"},
    "grant_version": {"type": "string", "pattern": "^0\\.\\d+$"},
    "lease_id": {"type": "string"},

    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": {"type": "string"},
        "digest": {"type": "string"},
        "instance": {"type": "string"}
      },
      "additionalProperties": false
    },

    "permissions": {
      "type": "object",
      "properties": {
        "listen": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["proto"],
            "properties": {
              "proto": {"type": "string", "enum": ["tcp", "udp"]},
              "port": {"type": "integer", "minimum": 0, "maximum": 65535, "description": "0 means 'allocate from policy-approved pool'."},
              "bind": {
                "type": "object",
                "properties": {
                  "cidr": {"type": "string"},
                  "interface": {"type": "string"}
                },
                "additionalProperties": false
              },
              "allow_from_cidrs": {"type": "array", "items": {"type": "string"}},
              "socket_activation": {"type": "boolean", "description": "If true, broker holds the socket and spawns/passes FDs on demand."}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "constraints": {
      "type": "object",
      "properties": {
        "expires_at": {"type": "string", "format": "date-time"},
        "max_connections": {"type": "integer", "minimum": 0},
        "backlog": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },

    "issued_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "object"}
  },
  "additionalProperties": false
}
