{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Lease Snapshot (lease-snapshot) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "snapshot_version",
    "snapshot_id",
    "created_at",
    "host",
    "leases"
  ],
  "properties": {
    "kind": {
      "const": "lease-snapshot"
    },
    "snapshot_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "snapshot_id": {
      "type": "string",
      "description": "Stable id for this snapshot (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "required": [
        "host_id"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        },
        "generation_digest": {
          "type": "string"
        },
        "domain": {
          "type": "string",
          "description": "Optional compartment/domain identifier."
        }
      },
      "additionalProperties": false
    },
    "leases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lease_id",
          "kind",
          "issued_at"
        ],
        "properties": {
          "lease_id": {
            "type": "string"
          },
          "envelope_digest": {
            "type": "string",
            "description": "Optional digest of a lease.envelope object for this lease."
          },
          "kind": {
            "type": "string",
            "description": "Grant/session kind that owns the lease (e.g., portal-grant, secret-grant, debug-record-grant, trace-session, breakglass-grant)."
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "subject": {
            "type": "object",
            "description": "Selectors describing who holds the lease (service_id, vm_id, jail_id, operator, etc.).",
            "additionalProperties": true
          },
          "scope": {
            "type": "object",
            "description": "Metadata-only summary of what is authorized.",
            "additionalProperties": true
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "revoked",
              "unknown"
            ],
            "default": "active"
          },
          "revocation": {
            "type": "object",
            "properties": {
              "revoked_at": {
                "type": "string",
                "format": "date-time"
              },
              "revoked_by": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "event_id": {
                "type": "string",
                "description": "Related lease-revoke-event id, if recorded."
              }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Related evidence digests/ids (optional)."
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
