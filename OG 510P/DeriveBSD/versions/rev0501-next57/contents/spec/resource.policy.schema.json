{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD resource governance policy (resource.policy) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "policy_version",
    "created_at",
    "target",
    "scopes"
  ],
  "properties": {
    "kind": {
      "const": "resource-policy"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "policy_id": {
      "type": "string",
      "description": "Stable id for this policy (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "generation_id"
      ],
      "properties": {
        "generation_id": {
          "type": "string"
        },
        "host_id": {
          "type": "string",
          "description": "Optional host identity label for binding (policy input)."
        },
        "fleet_scope": {
          "type": "string",
          "description": "Optional fleet scope label (e.g., role/cluster)."
        }
      },
      "additionalProperties": false
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "subject",
          "controls"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "subject": {
            "type": "object",
            "required": [
              "type",
              "selector"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "service",
                  "workload",
                  "jail",
                  "vm",
                  "user",
                  "group",
                  "host"
                ]
              },
              "selector": {
                "type": "string",
                "description": "Selector expression (e.g., service:web, workload:tenantA/*)."
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "class": {
            "type": "string",
            "description": "Optional priority class (latency-critical, best-effort, batch, etc.)."
          },
          "controls": {
            "type": "object",
            "properties": {
              "cpu": {
                "type": "object",
                "properties": {
                  "cap_percent": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Absolute CPU cap in percent of one CPU (backend-specific meaning)."
                  },
                  "shares": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Relative weight for proportional sharing."
                  },
                  "cpuset": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "description": "Allowed CPU ids (optional)."
                  }
                },
                "additionalProperties": false
              },
              "memory": {
                "type": "object",
                "properties": {
                  "max_bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "swap_max_bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "oom_action": {
                    "type": "string",
                    "enum": [
                      "log",
                      "throttle",
                      "kill",
                      "restart",
                      "fault"
                    ],
                    "default": "kill"
                  }
                },
                "additionalProperties": false
              },
              "io": {
                "type": "object",
                "properties": {
                  "read_bps": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "write_bps": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "iops": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "device_class": {
                    "type": "string",
                    "description": "Optional device class binding (e.g., fast-ssd, bulk-hdd)."
                  }
                },
                "additionalProperties": false
              },
              "counts": {
                "type": "object",
                "properties": {
                  "pids_max": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "threads_max": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "fds_max": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": true
          },
          "on_violation": {
            "type": "object",
            "description": "Optional breach strategy overrides per scope.",
            "properties": {
              "emit_event": {
                "type": "boolean",
                "default": true
              },
              "emit_fault": {
                "type": "boolean",
                "default": false
              },
              "capture_incident_bundle": {
                "type": "boolean",
                "default": false
              },
              "action": {
                "type": "string",
                "enum": [
                  "none",
                  "throttle",
                  "kill",
                  "restart",
                  "maintenance"
                ],
                "default": "none"
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "signature": {
      "type": "string",
      "description": "Optional signature over the policy digest."
    }
  },
  "additionalProperties": false
}
