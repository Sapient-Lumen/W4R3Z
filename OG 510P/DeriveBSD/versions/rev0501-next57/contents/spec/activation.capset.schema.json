{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Activation Capset (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "capset_version",
    "service",
    "capabilities",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {"const": "activation-capset"},
    "capset_version": {"type": "string", "pattern": "^0\\.\\d+$"},

    "capset_id": {"type": "string", "description": "Optional unique identifier for this capset."},

    "service": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": {"type": "string"},
        "digest": {"type": "string", "description": "Digest of the service binary/closure (e.g., sha256:...)"},
        "instance": {"type": "string", "description": "Instance identifier (host/jail/microVM specific)."}
      },
      "additionalProperties": false
    },

    "context": {
      "type": "object",
      "description": "Binds capsets to higher-level DeriveBSD objects when relevant.",
      "properties": {
        "plan_digest": {"type": "string"},
        "policy_snapshot_digest": {"type": "string"},
        "policy_decision_digest": {"type": "string"}
      },
      "additionalProperties": false
    },

    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "cap_ref"],
        "properties": {
          "name": {"type": "string", "description": "Stable capability name for discovery and graph tooling."},
          "type": {
            "type": "string",
            "enum": ["socket", "file", "dir", "dataset", "rpc", "portal-client", "trace", "budget", "other"]
          },
          "cap_ref": {"type": "string", "description": "Opaque broker reference to the pre-opened handle."},
          "rights": {"type": "array", "items": {"type": "string"}, "description": "Type-specific rights names."},
          "lease_id": {"type": "string", "description": "Optional lease identifier if this capability is revocable/mediated."},
          "metadata": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": false
      }
    },

    "issued_at": {"type": "string", "description": "ISO8601 time."},
    "expires_at": {"type": "string", "description": "ISO8601 time. Optional but recommended."},

    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": {"type": "string"},
        "alg": {"type": "string"},
        "sig": {"type": "string", "description": "Signature over canonical JSON bytes."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
