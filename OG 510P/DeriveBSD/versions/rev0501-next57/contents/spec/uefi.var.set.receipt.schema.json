{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UEFI variable set receipt (uefi.var.set.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_id",
    "plan_digest",
    "results"
  ],
  "properties": {
    "kind": { "const": "uefi-var-set-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "receipt_id": { "type": "string", "description": "Stable id for this receipt (UUID recommended)." },
    "created_at": { "type": "string", "format": "date-time" },

    "plan_id": { "type": "string" },
    "plan_digest": { "type": "string" },

    "host": {
      "type": "object",
      "properties": {
        "machine_id": { "type": "string" },
        "boot_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["guid", "name", "op", "status"],
        "properties": {
          "guid": { "type": "string" },
          "name": { "type": "string" },
          "op": { "type": "string", "enum": ["set", "delete", "append"] },
          "status": { "type": "string", "enum": ["changed", "unchanged", "failed"] },
          "old_value_digest": { "type": "string" },
          "new_value_digest": { "type": "string" },
          "error": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "status": { "type": "string", "enum": ["success", "partial", "failed"], "default": "success" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
