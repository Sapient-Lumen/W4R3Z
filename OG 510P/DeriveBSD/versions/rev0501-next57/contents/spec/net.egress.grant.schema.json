{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Network Egress Grant (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "grant_version",
    "subject",
    "permissions",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "net-egress-grant"
    },
    "grant_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "lease_id": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "dns_lookup": {
          "type": "boolean"
        },
        "connect": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "proto"
            ],
            "properties": {
              "proto": {
                "type": "string",
                "enum": [
                  "tcp",
                  "udp"
                ]
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                }
              },
              "port_range": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "additionalProperties": false
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Hostname globs or suffix patterns."
                }
              },
              "cidrs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "max_flows": {
          "type": "integer",
          "minimum": 0
        },
        "budget_digest": {
          "type": "string",
          "description": "Optional digest of a resource budget capability governing this grant."
        }
      },
      "additionalProperties": false
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
