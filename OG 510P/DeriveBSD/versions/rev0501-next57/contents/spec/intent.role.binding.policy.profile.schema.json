{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD role-binding policy decision profile (intent.role.binding.policy.profile) (v0.1)",
  "allOf": [
    {
      "$ref": "policy.decision.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "decision_instance_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique issuance identity for this remembered-role policy decision instance. independently issuable single-apply decisions must not collapse to the same digest even when the exact mutation tuple is otherwise identical."
        },
        "kind": {
          "const": "policy-decision"
        },
        "decision": {
          "type": "object",
          "required": [
            "allowed"
          ],
          "properties": {
            "allowed": {
              "const": true
            }
          }
        },
        "inputs": {
          "type": "object",
          "required": [
            "intent_role_binding_request"
          ],
          "properties": {
            "intent_role_binding_request": {
              "type": "object",
              "required": [
                "trigger",
                "requested_action",
                "subject",
                "roles_touched",
                "requested_binding_digest"
              ],
              "properties": {
                "trigger": {
                  "type": "string",
                  "enum": [
                    "policy-reconcile",
                    "support-import"
                  ]
                },
                "requested_action": {
                  "type": "string",
                  "enum": [
                    "initialized",
                    "updated"
                  ]
                },
                "subject": {
                  "type": "object",
                  "required": [
                    "host_id",
                    "profile_id"
                  ],
                  "properties": {
                    "host_id": {
                      "type": "string"
                    },
                    "profile_id": {
                      "type": "string",
                      "enum": [
                        "fleet_host",
                        "workstation",
                        "general_os",
                        "appliance_factory"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "roles_touched": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "browsing",
                      "communications"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "requested_binding_digest": {
                  "type": "string"
                },
                "from_binding_digest": {
                  "type": "string"
                },
                "import_receipt_digest": {
                  "type": "string"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "requested_action": {
                        "const": "updated"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "from_binding_digest"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "trigger": {
                        "const": "support-import"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "import_receipt_digest"
                    ]
                  }
                }
              ],
              "additionalProperties": false
            }
          }
        },
        "effective_constraints": {
          "type": "object",
          "required": [
            "intent_role_binding_apply"
          ],
          "properties": {
            "intent_role_binding_apply": {
              "type": "object",
              "required": [
                "apply_mode",
                "subject",
                "require_event_trigger",
                "roles_touched",
                "binding_digest",
                "must_apply_before",
                "max_successful_events"
              ],
              "properties": {
                "apply_mode": {
                  "type": "string",
                  "enum": [
                    "initialized",
                    "updated"
                  ]
                },
                "subject": {
                  "type": "object",
                  "required": [
                    "host_id",
                    "profile_id"
                  ],
                  "properties": {
                    "host_id": {
                      "type": "string"
                    },
                    "profile_id": {
                      "type": "string",
                      "enum": [
                        "fleet_host",
                        "workstation",
                        "general_os",
                        "appliance_factory"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "require_event_trigger": {
                  "type": "string",
                  "enum": [
                    "policy-reconcile",
                    "support-import"
                  ]
                },
                "roles_touched": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "browsing",
                      "communications"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "binding_digest": {
                  "type": "string"
                },
                "from_binding_digest": {
                  "type": "string"
                },
                "diff_digest": {
                  "type": "string"
                },
                "import_receipt_digest": {
                  "type": "string"
                },
                "must_apply_before": {
                  "type": "string",
                  "format": "date-time",
                  "description": "The exact-mutation policy decision must not authorize a successful apply event after this time."
                },
                "max_successful_events": {
                  "type": "integer",
                  "const": 1,
                  "description": "Remembered-role policy decisions are single-apply: only one successful initialized/updated event may consume this authorization."
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "apply_mode": {
                        "const": "updated"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "from_binding_digest",
                      "diff_digest"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "require_event_trigger": {
                        "const": "support-import"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "import_receipt_digest"
                    ]
                  }
                }
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "required": [
        "decision_instance_id",
        "kind",
        "decision_version",
        "lock_digest",
        "engine",
        "inputs",
        "decision",
        "effective_constraints"
      ]
    }
  ]
}
