{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD firmware update plan (fw.update.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "payload",
    "targets"
  ],
  "properties": {
    "kind": {
      "const": "fw-update-plan"
    },
    "plan_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "plan_id": {
      "type": "string",
      "description": "Stable id for the plan (UUID recommended)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "requested_by": {
      "type": "string",
      "description": "Opaque operator/workflow id (optional)."
    },
    "payload": {
      "type": "object",
      "required": [
        "artifact_digest"
      ],
      "properties": {
        "artifact_digest": {
          "type": "string",
          "description": "Digest of the firmware payload artifact (CAS/store handle)."
        },
        "format": {
          "type": "string",
          "enum": [
            "uefi-capsule",
            "cab",
            "raw",
            "vendor"
          ],
          "default": "uefi-capsule"
        },
        "vendor": {
          "type": "string"
        },
        "release_id": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "class"
        ],
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              "system",
              "bmc",
              "nic",
              "storage",
              "disk",
              "other"
            ]
          },
          "device_id": {
            "type": "string",
            "description": "Stable device-class id (prefer from hw/fw inventory receipts)."
          },
          "constraint": {
            "type": "object",
            "properties": {
              "require_current_version": {
                "type": "string",
                "description": "If set, refuse to apply unless current version matches."
              },
              "min_current_version": {
                "type": "string"
              },
              "allow_downgrade": {
                "type": "boolean",
                "default": false
              }
            },
            "additionalProperties": false
          },
          "expect": {
            "type": "object",
            "properties": {
              "expected_version": {
                "type": "string"
              },
              "expected_version_regex": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "notes": {
            "type": "string"
          },
          "mechanism": {
            "type": "string",
            "description": "Preferred update mechanism for this target (applier may constrain).",
            "enum": [
              "uefi-capsule",
              "uefi-file",
              "nvme-slot",
              "bmc-redfish",
              "bmc-ipmi",
              "vendor-tool",
              "manual"
            ]
          },
          "uefi_esrt_guid": {
            "type": "string",
            "description": "For capsule targets: ESRT firmware class GUID (if applicable)."
          }
        },
        "additionalProperties": false
      }
    },
    "apply": {
      "type": "object",
      "description": "Execution mode hints (applier may constrain further).",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "stage-and-reboot",
            "live",
            "bmc"
          ],
          "default": "stage-and-reboot"
        },
        "requires_reboot": {
          "type": "boolean",
          "default": true
        },
        "maintenance_lease_digest": {
          "type": "string",
          "description": "Digest of a maintenance/breakglass lease required to execute (optional but recommended)."
        }
      },
      "additionalProperties": false
    },
    "approvals": {
      "type": "object",
      "description": "Optional digest-bound approval receipts.",
      "properties": {
        "consent_receipt_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "preconditions": {
      "type": "object",
      "properties": {
        "require_fw_inventory_digest": {
          "type": "string"
        },
        "require_hw_inventory_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "limits": {
      "type": "object",
      "description": "Optional plan constraints (applier may enforce stricter limits).",
      "properties": {
        "max_uefi_capsule_targets_per_boot": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "allow_parallel_capsules": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
