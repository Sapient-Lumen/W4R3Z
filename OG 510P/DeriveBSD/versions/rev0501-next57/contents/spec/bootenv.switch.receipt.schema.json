{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD boot environment switch receipt (bootenv.switch.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "applied_at",
    "plan",
    "outcome"
  ],
  "properties": {
    "kind": {
      "const": "bootenv-switch-receipt"
    },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "receipt_id": {
      "type": "string",
      "description": "Stable id for the receipt (UUID recommended)."
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "description": "Digest of the plan object."
        },
        "plan_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failure"
      ]
    },
    "details": {
      "type": "object",
      "properties": {
        "target_deployment_id": {
          "type": "string"
        },
        "fallback_deployment_id": {
          "type": "string"
        },
        "activated_be": {
          "type": "string",
          "description": "Activated boot environment / dataset name."
        },
        "fallback_armed": {
          "type": "boolean"
        },
        "try_counter_set": {
          "type": "boolean"
        },
        "bootloader_entry_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "event.record.schema.json"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
