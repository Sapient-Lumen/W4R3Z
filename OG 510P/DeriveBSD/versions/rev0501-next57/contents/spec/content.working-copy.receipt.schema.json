{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD content working-copy receipt (content.working-copy.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "plan_digest",
    "policy_digest",
    "source",
    "output",
    "boundary",
    "result"
  ],
  "properties": {
    "kind": {"const": "content.working-copy.receipt"},
    "receipt_version": {"type": "string", "const": "0.1"},
    "receipt_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "plan_digest": {"type": "string"},
    "policy_digest": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["import_receipt_digest", "source_output_digest", "source_class"],
      "properties": {
        "import_receipt_digest": {"type": "string"},
        "source_output_digest": {"type": "string"},
        "source_class": {
          "type": "string",
          "enum": ["imported-foreign-original", "sanitized-inspection-derivative"]
        },
        "authoritative_origin_digest": {"type": "string"},
        "mime": {"type": "string"},
        "filename": {"type": "string"}
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["digest", "path"],
      "properties": {
        "digest": {"type": "string"},
        "path": {"type": "string"},
        "filename": {"type": "string"},
        "mime": {"type": "string"},
        "placement": {
          "type": "string",
          "enum": ["home-working-set", "project-working-tree", "appvm-private"]
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": ["relationship", "source_retained_read_only"],
      "properties": {
        "relationship": {"type": "string", "const": "working-copy-of"},
        "source_retained_read_only": {"type": "boolean"},
        "quarantine_state_on_output": {
          "type": "string",
          "enum": ["cleared-by-policy", "preserved", "not-applicable"]
        }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": ["default_save_target", "source_writeback"],
      "properties": {
        "default_save_target": {"type": "string", "const": "working-copy-output"},
        "source_writeback": {"type": "string", "const": "separate-act-required"}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["ok", "deny", "fail"]},
        "message": {"type": "string"}
      },
      "additionalProperties": false
    },
    "portal_session_id": {"type": "string"},
    "lease_id": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
