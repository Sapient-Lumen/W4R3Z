{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Removable-media local post-detach denial reason registry",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "registry_id",
    "generated_for_version",
    "lane",
    "source_bindings",
    "precedence_policy",
    "reason_precedence",
    "scenario_bindings",
    "invariants",
    "negative_fixture_policy"
  ],
  "properties": {
    "kind": {"const": "removable.media.local.post_detach.denial.reason.registry"},
    "schema_version": {"const": "1.0"},
    "registry_id": {"type": "string", "pattern": "^rm-postdetach-denial-reason-registry-[0-9]{8}-r[0-9]{3}$"},
    "generated_for_version": {"const": "2026-05-30r524"},
    "lane": {"$ref": "#/$defs/lane"},
    "source_bindings": {"$ref": "#/$defs/sourceBindings"},
    "precedence_policy": {"$ref": "#/$defs/precedencePolicy"},
    "reason_precedence": {
      "type": "array",
      "minItems": 5,
      "items": {"$ref": "#/$defs/reason"}
    },
    "scenario_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scenarioBinding"}
    },
    "invariants": {"$ref": "#/$defs/invariants"},
    "negative_fixture_policy": {"type": "string", "pattern": "^known-bad-[a-z0-9-]+-shapes-must-fail-validation$"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$", "minLength": 3, "maxLength": 180},
    "lane": {
      "type": "object",
      "required": ["family", "phase", "identity_policy"],
      "properties": {
        "family": {"const": "removable-media-local-fallback"},
        "phase": {"const": "post-detach"},
        "identity_policy": {"const": "family-normalized-phase-by-kind"}
      },
      "additionalProperties": false
    },
    "sourceBindings": {
      "type": "object",
      "required": [
        "canonical_digest_rule",
        "state_machine_manifest_computed_digest",
        "scenario_replay_manifest_computed_digest",
        "transition_witness_capsule_computed_digest",
        "enforcement_ledger_receipt_computed_digest",
        "fresh_authority_recovery_receipt_computed_digest",
        "legacy_denial_receipt_computed_digest"
      ],
      "properties": {
        "canonical_digest_rule": {"const": "json-sort-keys-compact-utf8-sha256"},
        "state_machine_manifest_computed_digest": {"$ref": "#/$defs/digest"},
        "scenario_replay_manifest_computed_digest": {"$ref": "#/$defs/digest"},
        "transition_witness_capsule_computed_digest": {"$ref": "#/$defs/digest"},
        "enforcement_ledger_receipt_computed_digest": {"$ref": "#/$defs/digest"},
        "fresh_authority_recovery_receipt_computed_digest": {"$ref": "#/$defs/digest"},
        "legacy_denial_receipt_computed_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "precedencePolicy": {
      "type": "object",
      "required": [
        "rank_order",
        "primary_reason_must_be_registry_member",
        "subordinate_reasons_must_not_preempt_primary",
        "successor_recovery_is_not_a_denial",
        "support_projection_after_denial_is_digest_only"
      ],
      "properties": {
        "rank_order": {"const": "lower-rank-wins"},
        "primary_reason_must_be_registry_member": {"const": true},
        "subordinate_reasons_must_not_preempt_primary": {"const": true},
        "successor_recovery_is_not_a_denial": {"const": true},
        "support_projection_after_denial_is_digest_only": {"const": true}
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "object",
      "required": [
        "reason_code",
        "rank",
        "reason_class",
        "terminal_states",
        "fresh_authority_required",
        "deny_actions",
        "rate_limit_action",
        "support_visibility",
        "subordinate_reason_codes",
        "summary"
      ],
      "properties": {
        "reason_code": {"$ref": "#/$defs/identifier"},
        "rank": {"type": "integer", "minimum": 0, "maximum": 999},
        "reason_class": {"enum": ["primary-denial", "subordinate-denial", "idempotent-replay", "successor-success", "sanitization-failure"]},
        "terminal_states": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "fresh_authority_required": {"type": "boolean"},
        "deny_actions": {
          "type": "array",
          "items": {"enum": ["observe", "export", "rehydrate", "query", "raw-support"]},
          "uniqueItems": true
        },
        "rate_limit_action": {"enum": ["debit", "no-debit", "replayed-no-new-debit", "not-applicable"]},
        "support_visibility": {"const": "support-safe-digest-only"},
        "subordinate_reason_codes": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "summary": {"type": "string", "minLength": 12}
      },
      "additionalProperties": false
    },
    "scenarioBinding": {
      "type": "object",
      "required": [
        "scenario_id",
        "terminal_state",
        "primary_reason_code",
        "expected_rank",
        "fresh_authority_required",
        "allow_observe",
        "allow_export",
        "allow_rehydrate",
        "rate_limit_action",
        "witness_trace_id"
      ],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/identifier"},
        "terminal_state": {"$ref": "#/$defs/identifier"},
        "primary_reason_code": {"$ref": "#/$defs/identifier"},
        "expected_rank": {"type": "integer", "minimum": 0, "maximum": 999},
        "fresh_authority_required": {"type": "boolean"},
        "allow_observe": {"type": "boolean"},
        "allow_export": {"type": "boolean"},
        "allow_rehydrate": {"type": "boolean"},
        "rate_limit_action": {"enum": ["debit", "no-debit", "replayed-no-new-debit", "not-applicable"]},
        "witness_trace_id": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "invariants": {
      "type": "object",
      "required": [
        "ranks_are_unique",
        "scenario_reason_codes_are_registry_members",
        "enforcement_denial_code_is_registry_member",
        "fresh_recovery_prior_denial_code_is_registry_member",
        "support_visibility_is_digest_only",
        "successor_authority_does_not_resurrect_expired_root"
      ],
      "properties": {
        "ranks_are_unique": {"const": true},
        "scenario_reason_codes_are_registry_members": {"const": true},
        "enforcement_denial_code_is_registry_member": {"const": true},
        "fresh_recovery_prior_denial_code_is_registry_member": {"const": true},
        "support_visibility_is_digest_only": {"const": true},
        "successor_authority_does_not_resurrect_expired_root": {"const": true}
      },
      "additionalProperties": false
    }
  }
}
