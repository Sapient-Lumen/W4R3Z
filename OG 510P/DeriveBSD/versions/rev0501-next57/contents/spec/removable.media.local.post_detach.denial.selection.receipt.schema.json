{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Removable media local post-detach denial selection receipt",
  "description": "Runtime-shaped r525 receipt proving that a post-detach denial cause was selected from the r524 registry by lower-rank-wins precedence, with candidate evidence, scenario/witness bindings, support redaction, and rate-limit posture.",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "selection_receipt_id",
    "generated_for_version",
    "lane",
    "source_bindings",
    "attempted_action",
    "scenario_binding",
    "observed_predicates",
    "candidate_reasons",
    "selected_reason",
    "decision_proof",
    "rate_limit_binding",
    "support_projection",
    "invariants",
    "negative_fixture_policy"
  ],
  "properties": {
    "kind": {"const": "removable.media.local.post_detach.denial.selection.receipt"},
    "schema_version": {"const": "1.0"},
    "selection_receipt_id": {"type": "string", "pattern": "^rm-postdetach-denial-selection-[0-9]{8}-r[0-9]{3}$"},
    "generated_for_version": {"const": "2026-05-30r525"},
    "lane": {"$ref": "#/$defs/lane"},
    "source_bindings": {"$ref": "#/$defs/sourceBindings"},
    "attempted_action": {"enum": ["observe", "export", "rehydrate", "query", "raw-support"]},
    "scenario_binding": {"$ref": "#/$defs/scenarioBinding"},
    "observed_predicates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/predicate"}
    },
    "candidate_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidateReason"}
    },
    "selected_reason": {"$ref": "#/$defs/selectedReason"},
    "decision_proof": {"$ref": "#/$defs/decisionProof"},
    "rate_limit_binding": {"$ref": "#/$defs/rateLimitBinding"},
    "support_projection": {"$ref": "#/$defs/supportProjection"},
    "invariants": {"$ref": "#/$defs/invariants"},
    "negative_fixture_policy": {"const": "known-bad-post-detach-denial-selection-shapes-must-fail-validation"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$", "minLength": 3, "maxLength": 180},
    "lane": {
      "type": "object",
      "required": ["family", "phase", "identity_policy"],
      "properties": {
        "family": {"const": "removable-media-local-fallback"},
        "phase": {"const": "post-detach"},
        "identity_policy": {"const": "family-normalized-phase-by-kind"}
      },
      "additionalProperties": false
    },
    "sourceBindings": {
      "type": "object",
      "required": [
        "canonical_digest_rule",
        "denial_reason_registry_computed_digest",
        "scenario_replay_manifest_computed_digest",
        "transition_witness_capsule_computed_digest",
        "enforcement_ledger_receipt_computed_digest",
        "support_projection_computed_digest"
      ],
      "properties": {
        "canonical_digest_rule": {"const": "json-sort-keys-compact-utf8-sha256"},
        "denial_reason_registry_computed_digest": {"$ref": "#/$defs/digest"},
        "scenario_replay_manifest_computed_digest": {"$ref": "#/$defs/digest"},
        "transition_witness_capsule_computed_digest": {"$ref": "#/$defs/digest"},
        "enforcement_ledger_receipt_computed_digest": {"$ref": "#/$defs/digest"},
        "support_projection_computed_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "scenarioBinding": {
      "type": "object",
      "required": ["scenario_id", "witness_trace_id", "terminal_state", "expected_reason_code", "expected_rank"],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/identifier"},
        "witness_trace_id": {"$ref": "#/$defs/identifier"},
        "terminal_state": {"enum": ["expired-root-denied", "fail-closed-typed-denial", "idempotent-denial-replayed", "successor-root-admitted"]},
        "expected_reason_code": {"$ref": "#/$defs/identifier"},
        "expected_rank": {"type": "integer", "minimum": 0, "maximum": 999}
      },
      "additionalProperties": false
    },
    "predicate": {
      "type": "object",
      "required": ["predicate_code", "active", "evidence_digest", "maps_to_reason_code", "support_visibility"],
      "properties": {
        "predicate_code": {"$ref": "#/$defs/identifier"},
        "active": {"type": "boolean"},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "maps_to_reason_code": {"$ref": "#/$defs/identifier"},
        "support_visibility": {"const": "support-safe-digest-only"}
      },
      "additionalProperties": false
    },
    "candidateReason": {
      "type": "object",
      "required": ["reason_code", "rank", "reason_class", "active", "source_predicates"],
      "properties": {
        "reason_code": {"$ref": "#/$defs/identifier"},
        "rank": {"type": "integer", "minimum": 0, "maximum": 999},
        "reason_class": {"enum": ["primary-denial", "subordinate-denial", "idempotent-replay", "successor-success", "sanitization-failure"]},
        "active": {"type": "boolean"},
        "source_predicates": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "actions": {
      "type": "object",
      "required": ["observe", "export", "rehydrate"],
      "properties": {
        "observe": {"type": "boolean"},
        "export": {"type": "boolean"},
        "rehydrate": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "selectedReason": {
      "type": "object",
      "required": [
        "reason_code",
        "rank",
        "reason_class",
        "selected_by",
        "subordinate_reason_codes",
        "fresh_authority_required",
        "allowed_actions",
        "support_visibility",
        "rate_limit_action"
      ],
      "properties": {
        "reason_code": {"$ref": "#/$defs/identifier"},
        "rank": {"type": "integer", "minimum": 0, "maximum": 999},
        "reason_class": {"enum": ["primary-denial", "sanitization-failure", "idempotent-replay", "successor-success"]},
        "selected_by": {"const": "lower-rank-wins"},
        "subordinate_reason_codes": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "fresh_authority_required": {"type": "boolean"},
        "allowed_actions": {"$ref": "#/$defs/actions"},
        "support_visibility": {"const": "support-safe-digest-only"},
        "rate_limit_action": {"enum": ["debit", "no-debit", "replayed-no-new-debit", "not-applicable"]}
      },
      "additionalProperties": false
    },
    "decisionProof": {
      "type": "object",
      "required": [
        "active_candidate_count",
        "lower_rank_wins",
        "no_active_lower_rank_reason_omitted",
        "subordinate_reasons_do_not_preempt",
        "selected_reason_matches_registry",
        "scenario_binding_matches_witness",
        "support_projection_matches_selected_reason"
      ],
      "properties": {
        "active_candidate_count": {"type": "integer", "minimum": 1},
        "lower_rank_wins": {"const": true},
        "no_active_lower_rank_reason_omitted": {"const": true},
        "subordinate_reasons_do_not_preempt": {"const": true},
        "selected_reason_matches_registry": {"const": true},
        "scenario_binding_matches_witness": {"const": true},
        "support_projection_matches_selected_reason": {"const": true}
      },
      "additionalProperties": false
    },
    "rateLimitBinding": {
      "type": "object",
      "required": ["rate_limit_action", "debit_count", "idempotency_key_digest", "debit_receipt_digest", "replayed_no_new_debit"],
      "properties": {
        "rate_limit_action": {"enum": ["debit", "no-debit", "replayed-no-new-debit", "not-applicable"]},
        "debit_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "idempotency_key_digest": {"$ref": "#/$defs/digest"},
        "debit_receipt_digest": {"$ref": "#/$defs/digest"},
        "replayed_no_new_debit": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "supportProjection": {
      "type": "object",
      "required": ["visibility", "projection_digest", "visible_reason_code", "raw_visibility_detected", "fresh_authority_instruction_visible"],
      "properties": {
        "visibility": {"const": "support-safe-digest-only"},
        "projection_digest": {"$ref": "#/$defs/digest"},
        "visible_reason_code": {"$ref": "#/$defs/identifier"},
        "raw_visibility_detected": {"const": false},
        "fresh_authority_instruction_visible": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "invariants": {
      "type": "object",
      "required": [
        "selected_reason_is_active_registry_member",
        "lowest_active_non_subordinate_rank_selected",
        "support_projection_is_digest_only",
        "scenario_and_witness_bindings_match",
        "rate_limit_action_matches_selected_reason"
      ],
      "properties": {
        "selected_reason_is_active_registry_member": {"const": true},
        "lowest_active_non_subordinate_rank_selected": {"const": true},
        "support_projection_is_digest_only": {"const": true},
        "scenario_and_witness_bindings_match": {"const": true},
        "rate_limit_action_matches_selected_reason": {"const": true}
      },
      "additionalProperties": false
    }
  }
}
