{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD kernel module policy diff (kmod.policy.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_policy",
    "to_policy",
    "defaults_changed",
    "rules_added",
    "rules_removed",
    "rules_changed"
  ],
  "properties": {
    "kind": { "const": "kmod.policy.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/generation/domain).",
      "properties": {
        "host_id": { "type": "string" },
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "domain": { "type": "string", "description": "Optional compartment/domain identifier." },
        "from_generation": { "type": "string" },
        "to_generation": { "type": "string" }
      },
      "additionalProperties": false
    },

    "from_policy": { "$ref": "#/$defs/policy_ref" },
    "to_policy": { "$ref": "#/$defs/policy_ref" },

    "defaults_changed": {
      "type": "array",
      "description": "List of default fields that changed (empty if none).",
      "items": { "$ref": "#/$defs/default_change" }
    },

    "rules_added": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "rules_removed": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "rules_changed": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule_change" }
    },

    "summary": {
      "type": "object",
      "properties": {
        "defaults_changed": { "type": "integer", "minimum": 0 },
        "rules_added": { "type": "integer", "minimum": 0 },
        "rules_removed": { "type": "integer", "minimum": 0 },
        "rules_changed": { "type": "integer", "minimum": 0 },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "policy_ref": {
      "type": "object",
      "description": "Reference to a kmod-policy object by digest (and optional human fields).",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "policy_version": { "type": "string" },
        "issued_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "default_change": {
      "type": "object",
      "required": ["field", "from", "to"],
      "properties": {
        "field": {
          "type": "string",
          "enum": ["allow_runtime_load", "allow_unload", "deny_unknown"]
        },
        "from": { "type": "boolean" },
        "to": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "rule": {
      "type": "object",
      "required": ["id", "effect", "match"],
      "properties": {
        "id": { "type": "string" },
        "effect": { "type": "string", "enum": ["allow", "deny"] },
        "match": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "name_regex": { "type": "string" },
            "digest": { "type": "string" },
            "path_prefix": { "type": "string" },
            "device_class": { "type": "string" }
          },
          "additionalProperties": false
        },
        "constraints": {
          "type": "object",
          "properties": {
            "require_mediated": { "type": "boolean" },
            "allow_unload": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "rule_change": {
      "type": "object",
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string" },
        "from": { "$ref": "#/$defs/rule" },
        "to": { "$ref": "#/$defs/rule" },
        "fields_changed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["effect", "match", "constraints"]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
