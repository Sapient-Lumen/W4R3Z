{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD release capsule (release.capsule) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "capsule_version",
    "capsule_id",
    "created_at",
    "bindings"
  ],
  "properties": {
    "kind": {
      "const": "release.capsule"
    },
    "capsule_version": {
      "type": "string",
      "const": "0.1"
    },
    "capsule_id": {
      "type": "string",
      "description": "Content digest of the capsule itself (or stable id)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "description": "Optional human-facing context; not used for verification.",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "bindings": {
      "type": "object",
      "required": [
        "closure_digest"
      ],
      "properties": {
        "closure_digest": {
          "type": "string"
        },
        "closure_manifest_digest": {
          "type": "string"
        },
        "deployment_ref_digest": {
          "type": "string"
        },
        "channel_view_digest": {
          "type": "string"
        },
        "trust_policy_digest": {
          "type": "string"
        },
        "policy_decision_digest": {
          "type": "string"
        },
        "supplychain_verify_receipt_digest": {
          "type": "string"
        },
        "attestation_reference_digest": {
          "type": "string"
        },
        "sbom_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bootchain_policy_digest": {
          "type": "string"
        },
        "rollout_policy_digest": {
          "type": "string"
        },
        "transparency_entry_digest": {
          "type": "string"
        },
        "release_authority_policy_digest": {
          "type": "string"
        },
        "release_publish_receipt_digest": {
          "type": "string"
        },
        "monitor_policy_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "description": "Optional extra artifact pointers (kind + digest).",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "digest"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "sig"
        ],
        "properties": {
          "key_id": {
            "type": "string"
          },
          "sig": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
