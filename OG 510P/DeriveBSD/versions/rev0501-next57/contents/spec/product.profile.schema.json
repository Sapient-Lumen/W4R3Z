{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One product profile definition with defaults, required invariants, and forbidden-by-default lanes.",
  "properties": {
    "defaults": {
      "type": "object",
      "description": "Default posture knobs for this profile. The key vocabulary is intentionally flat and explicitly allowlisted.",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "string",
          "description": "runtime execution posture / primary isolation lane"
        },
        "removable_media": {
          "type": "string",
          "description": "removable-media intake posture"
        },
        "usb_isolation": {
          "type": "string",
          "description": "USB / device-domain mediation posture"
        },
        "network_egress": {
          "type": "string",
          "description": "outbound network authority posture"
        },
        "dns_resolution": {
          "type": "string",
          "description": "DNS mediation posture when hostnames are used"
        },
        "network_ingress": {
          "type": "string",
          "description": "inbound listen / service exposure posture"
        },
        "networking": {
          "type": "string",
          "description": "host topology mutation posture"
        },
        "remote_assistance": {
          "type": "string",
          "description": "support / remote-control posture"
        },
        "private_keys": {
          "type": "string",
          "description": "private-key handling posture"
        },
        "home_identity": {
          "type": "string",
          "description": "human identity / home-state posture"
        },
        "data_at_rest": {
          "type": "string",
          "description": "data-at-rest encryption / unlock posture"
        },
        "evidence": {
          "type": "string",
          "description": "evidence collection posture"
        },
        "evidence_exports": {
          "type": "string",
          "description": "export / support handoff posture"
        },
        "firmware_updates": {
          "type": "string",
          "description": "firmware update posture"
        },
        "updates": {
          "type": "string",
          "description": "host update delivery / finalization posture"
        },
        "store_retention": {
          "type": "string",
          "description": "store retention / garbage-collection posture"
        },
        "installation_recovery": {
          "type": "string",
          "description": "installation / recovery posture"
        },
        "destructive_reprovision": {
          "type": "string",
          "description": "destructive reprovision / reset posture"
        },
        "kernel_mutation": {
          "type": "string",
          "description": "runtime kernel mutation posture"
        },
        "device_authority": {
          "type": "string",
          "description": "device-node / raw-device authority posture"
        },
        "high_risk_approvals": {
          "type": "string",
          "description": "high-risk approval / quorum posture"
        },
        "operator_access": {
          "type": "string",
          "description": "operator-access posture"
        },
        "time_authority": {
          "type": "string",
          "description": "trustworthy-time posture"
        },
        "trust_bundles": {
          "type": "string",
          "description": "trust-root / trust-bundle posture"
        },
        "platform_provenance": {
          "type": "string",
          "description": "measured platform / attestation posture"
        },
        "workload_identity": {
          "type": "string",
          "description": "service / workload identity posture"
        },
        "backups": {
          "type": "string",
          "description": "backup / restore posture"
        },
        "compat": {
          "type": "string",
          "description": "compatibility-adapter posture"
        },
        "devshells": {
          "type": "string",
          "description": "developer-shell posture"
        },
        "interactive_ui": {
          "type": "string",
          "description": "interactive desktop/UI posture"
        },
        "fuzzing": {
          "type": "string",
          "description": "fuzzing / regression-gate posture"
        }
      }
    },
    "description": {
      "type": "string"
    },
    "forbidden_by_default": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "description": "Stable id for this profile.",
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "notes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "required_invariants": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "id",
    "label",
    "description",
    "required_invariants"
  ],
  "title": "DeriveBSD product profile",
  "type": "object"
}
