{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cube hygiene checkset manifest",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "manifest_id",
    "generated_for_version",
    "scope",
    "counts",
    "shards",
    "checks",
    "profile_policy",
    "invariants",
    "refactor_policy"
  ],
  "properties": {
    "kind": {"const": "cube.hygiene.checkset.manifest"},
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "pattern": "^cube-hygiene-checkset-[0-9]{8}-r[0-9]{3}$"},
    "generated_for_version": {"const": "2026-05-30r533"},
    "scope": {
      "type": "object",
      "required": ["source", "hygiene_wrapper", "top_level_check_glob", "non_check_validators"],
      "properties": {
        "source": {"const": "tools/hygiene.py plus top-level tools/check_*.py"},
        "hygiene_wrapper": {"const": "tools/hygiene.py"},
        "top_level_check_glob": {"const": "tools/check_*.py"},
        "non_check_validators": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9_]+\\.py$"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "top_level_check_scripts",
        "hygiene_referenced_check_scripts",
        "non_check_validators_in_hygiene",
        "shards_total",
        "release_critical_count",
        "post_detach_focus_count",
        "generated_surface_count",
        "schema_cube_audit_count",
        "deep_contract_count",
        "duplicates_count",
        "missing_from_hygiene_count",
        "stale_hygiene_reference_count"
      ],
      "properties": {
        "top_level_check_scripts": {"type": "integer", "minimum": 1},
        "hygiene_referenced_check_scripts": {"type": "integer", "minimum": 1},
        "non_check_validators_in_hygiene": {"type": "integer", "minimum": 0},
        "shards_total": {"type": "integer", "minimum": 5},
        "release_critical_count": {"type": "integer", "minimum": 1},
        "post_detach_focus_count": {"type": "integer", "minimum": 1},
        "generated_surface_count": {"type": "integer", "minimum": 1},
        "schema_cube_audit_count": {"type": "integer", "minimum": 1},
        "deep_contract_count": {"type": "integer", "minimum": 1},
        "duplicates_count": {"const": 0},
        "missing_from_hygiene_count": {"const": 0},
        "stale_hygiene_reference_count": {"const": 0}
      },
      "additionalProperties": false
    },
    "shards": {
      "type": "array",
      "minItems": 5,
      "items": {"$ref": "#/$defs/shard"}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "profile_policy": {
      "type": "object",
      "required": ["hygiene_profile_argument", "default_profile", "release_cut_profile", "full_profile"],
      "properties": {
        "hygiene_profile_argument": {"const": "--profile"},
        "default_profile": {"const": "all"},
        "release_cut_profile": {"const": "release-critical"},
        "full_profile": {"const": "all"}
      },
      "additionalProperties": false
    },
    "invariants": {
      "type": "object",
      "required": [
        "every_top_level_check_is_referenced_once",
        "every_referenced_check_exists",
        "every_check_has_one_shard",
        "release_critical_profile_is_bounded",
        "post_detach_focus_profile_exists",
        "generated_surface_profile_exists",
        "schema_cube_audit_profile_exists"
      ],
      "properties": {
        "every_top_level_check_is_referenced_once": {"const": true},
        "every_referenced_check_exists": {"const": true},
        "every_check_has_one_shard": {"const": true},
        "release_critical_profile_is_bounded": {"const": true},
        "post_detach_focus_profile_exists": {"const": true},
        "generated_surface_profile_exists": {"const": true},
        "schema_cube_audit_profile_exists": {"const": true}
      },
      "additionalProperties": false
    },
    "refactor_policy": {
      "type": "object",
      "required": ["problem", "change", "next_refactor"],
      "properties": {
        "problem": {"const": "flat-full-hygiene-wrapper-exceeds-interactive-release-window"},
        "change": {"const": "profiled-hygiene-shards-are-typed-and-live-scanned"},
        "next_refactor": {"type": "string", "minLength": 12}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "shard": {
      "type": "object",
      "required": ["shard_id", "profile_name", "purpose", "run_command", "check_count"],
      "properties": {
        "shard_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "profile_name": {"enum": ["release-critical", "post-detach", "generated-surface", "schema-cube-audit", "deep-contract", "all"]},
        "purpose": {"type": "string", "minLength": 12},
        "run_command": {"type": "string", "pattern": "^python3 tools/hygiene\\.py --profile [a-z0-9-]+$"},
        "check_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["tool", "shard", "release_critical", "reason"],
      "properties": {
        "tool": {"type": "string", "pattern": "^(check_[A-Za-z0-9_]+|lint_spec_schemas|validate_spec_examples)\\.py$"},
        "shard": {"enum": ["release-critical", "post-detach", "generated-surface", "schema-cube-audit", "deep-contract"]},
        "release_critical": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 8}
      },
      "additionalProperties": false
    }
  }
}
