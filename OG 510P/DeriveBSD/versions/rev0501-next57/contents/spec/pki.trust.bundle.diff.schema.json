{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD PKI trust bundle diff (pki.trust.bundle.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_bundle",
    "to_bundle",
    "intended_use_added",
    "intended_use_removed",
    "anchors_added",
    "anchors_removed",
    "anchors_changed",
    "distribution_changed"
  ],
  "properties": {
    "kind": { "const": "pki.trust.bundle.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (where this bundle applies).",
      "properties": {
        "bundle_id": { "type": "string" },
        "host_id": { "type": "string" },
        "profile_id": { "type": "string", "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)." },
        "generation_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "from_bundle": { "$ref": "#/$defs/bundle_ref" },
    "to_bundle": { "$ref": "#/$defs/bundle_ref" },

    "intended_use_added": {
      "type": "array",
      "items": { "type": "string" },
      "description": "New intended_use tags added in the target bundle."
    },
    "intended_use_removed": {
      "type": "array",
      "items": { "type": "string" },
      "description": "intended_use tags removed in the target bundle."
    },

    "anchors_added": { "type": "array", "items": { "$ref": "#/$defs/anchor" } },
    "anchors_removed": { "type": "array", "items": { "$ref": "#/$defs/anchor" } },
    "anchors_changed": { "type": "array", "items": { "$ref": "#/$defs/anchor_change" } },

    "distribution_changed": {
      "type": "object",
      "description": "Distribution selector drift (where the trust bundle applies).",
      "required": ["present", "scope", "selectors_digest"],
      "properties": {
        "present": { "$ref": "#/$defs/bool_change" },
        "scope": { "$ref": "#/$defs/string_change" },
        "selectors_digest": {
          "$ref": "#/$defs/string_change",
          "description": "Digest of a canonicalized selector object (optional to compute, but stable when present)."
        },
        "from_selectors": { "type": ["object", "null"], "description": "Optional raw selector map for human review." },
        "to_selectors": { "type": ["object", "null"], "description": "Optional raw selector map for human review." }
      },
      "additionalProperties": false
    },

    "summary": {
      "type": "object",
      "description": "Optional human/policy summary fields.",
      "properties": {
        "anchors_added": { "type": "integer", "minimum": 0 },
        "anchors_removed": { "type": "integer", "minimum": 0 },
        "anchors_changed": { "type": "integer", "minimum": 0 },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/gating (optional)."
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "bundle_ref": {
      "type": "object",
      "description": "Reference to a pki-trust-bundle object by digest (and optional human fields).",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "bundle_id": { "type": "string" },
        "bundle_version": { "type": "string" },
        "issued_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "bool_change": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "boolean" },
        "to": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "string_change": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": ["string", "null"] },
        "to": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },

    "anchor": {
      "type": "object",
      "required": ["digest", "format"],
      "properties": {
        "digest": { "type": "string" },
        "format": { "type": "string", "enum": ["pem", "der", "jwk", "spki"] },
        "label": { "type": "string" },
        "fingerprint": { "type": "string" },
        "constraints": {
          "type": "object",
          "properties": {
            "not_before": { "type": "string", "format": "date-time" },
            "not_after": { "type": "string", "format": "date-time" },
            "name_constraints": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "anchor_change": {
      "type": "object",
      "required": ["anchor_digest", "from", "to"],
      "properties": {
        "anchor_digest": { "type": "string", "description": "Anchor digest used as a stable key for change grouping." },
        "from": { "$ref": "#/$defs/anchor" },
        "to": { "$ref": "#/$defs/anchor" },
        "classification": {
          "type": "string",
          "enum": ["constraints", "label", "format", "fingerprint", "multiple", "other"]
        },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
