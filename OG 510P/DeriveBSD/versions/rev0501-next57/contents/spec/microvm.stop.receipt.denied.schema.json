{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD microVM stop receipt (microvm.stop.receipt.denied) (v0.1 example wrapper)",
  "description": "Thin wrapper schema for the 'denied force-stop' example. This pins the outcome and ensures the example demonstrates the intended stable reason-code behavior.",
  "allOf": [
    {"$ref": "microvm.stop.receipt.schema.json"},
    {
      "type": "object",
      "required": ["outcome", "observed", "reasons"],
      "properties": {
        "outcome": {"const": "denied"},
        "observed": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": {"const": "force"}
          }
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "required": ["code"],
            "properties": {
              "code": {"const": "force-stop-denied"}
            }
          },
          "minContains": 1
        }
      }
    }
  ]
}
