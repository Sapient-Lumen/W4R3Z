{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD restore drill receipt (restore.drill.receipt) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "receipt_id",
    "created_at",
    "backup_receipt_digest",
    "environment",
    "checks",
    "result"
  ],
  "properties": {
    "kind": { "const": "restore-drill-receipt" },
    "receipt_version": { "type": "string", "pattern": "^0\\.\\d+$" },
    "receipt_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },

    "backup_receipt_digest": { "type": "string", "description": "Digest of backup.receipt being validated." },

    "environment": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["mount-only", "microvm-coldstart", "full-rehearsal"] },
        "sandbox_digest": { "type": "string", "description": "Digest of the sandbox/runtime bundle used for the drill (optional)." },
        "quarantine_namespace": { "type": "string", "description": "Where restored bytes were applied (dataset/jail/microVM)." }
      },
      "additionalProperties": false
    },

    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "skip"] },
          "detail_digest": { "type": "string", "description": "Optional digest pointer to detailed logs (support-bundle gated)." }
        },
        "additionalProperties": false
      }
    },

    "result": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "rto_seconds": { "type": "integer", "minimum": 0 },
        "rpo_seconds": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
