{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Removable media local post-detach scenario replay manifest",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "replay_manifest_id",
    "generated_for_version",
    "lane",
    "model_bindings",
    "scenarios",
    "invariants",
    "negative_fixture_policy"
  ],
  "properties": {
    "kind": {
      "const": "removable.media.local.post_detach.scenario.replay.manifest"
    },
    "schema_version": {
      "const": "1.0"
    },
    "replay_manifest_id": {
      "$ref": "#/$defs/identifier"
    },
    "generated_for_version": {
      "type": "string",
      "pattern": "^2026-05-30r522$"
    },
    "lane": {
      "$ref": "#/$defs/lane"
    },
    "model_bindings": {
      "type": "object",
      "required": [
        "state_machine_manifest_computed_digest",
        "enforcement_ledger_receipt_computed_digest",
        "fresh_authority_recovery_receipt_computed_digest",
        "support_projection_computed_digest",
        "backend_evidence_computed_digest",
        "canonical_digest_rule"
      ],
      "properties": {
        "state_machine_manifest_computed_digest": { "$ref": "#/$defs/sha256Digest" },
        "enforcement_ledger_receipt_computed_digest": { "$ref": "#/$defs/sha256Digest" },
        "fresh_authority_recovery_receipt_computed_digest": { "$ref": "#/$defs/sha256Digest" },
        "support_projection_computed_digest": { "$ref": "#/$defs/sha256Digest" },
        "backend_evidence_computed_digest": { "$ref": "#/$defs/sha256Digest" },
        "canonical_digest_rule": {
          "const": "json-sort-keys-compact-utf8-sha256"
        }
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "invariants": {
      "type": "object",
      "required": [
        "expired_root_never_observed_after_expiry",
        "missing_expiry_receipt_fails_closed",
        "rollback_fork_or_stale_root_rejected",
        "degraded_time_fails_closed",
        "fresh_authority_recovery_is_successor_only",
        "idempotent_replay_does_not_double_debit",
        "scenario_receipts_are_typed",
        "model_bindings_are_computed"
      ],
      "properties": {
        "expired_root_never_observed_after_expiry": { "const": true },
        "missing_expiry_receipt_fails_closed": { "const": true },
        "rollback_fork_or_stale_root_rejected": { "const": true },
        "degraded_time_fails_closed": { "const": true },
        "fresh_authority_recovery_is_successor_only": { "const": true },
        "idempotent_replay_does_not_double_debit": { "const": true },
        "scenario_receipts_are_typed": { "const": true },
        "model_bindings_are_computed": { "const": true }
      },
      "additionalProperties": false
    },
    "negative_fixture_policy": {
      "const": "known-bad-post-detach-scenario-replay-shapes-must-fail-validation"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "minLength": 3,
      "maxLength": 160
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lane": {
      "type": "object",
      "required": ["family", "phase", "identity_policy"],
      "properties": {
        "family": { "const": "removable-media-local-fallback" },
        "phase": { "const": "post-detach" },
        "identity_policy": { "const": "family-normalized-phase-by-kind" }
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": [
        "scenario_id",
        "scenario_type",
        "initial_condition",
        "events",
        "expected_outcome",
        "required_receipt_kinds",
        "support_visibility"
      ],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/identifier" },
        "scenario_type": {
          "enum": ["negative-denial", "negative-fail-closed", "positive-recovery", "idempotent-replay"]
        },
        "initial_condition": {
          "enum": [
            "expired-root-present",
            "missing-expiry-receipt",
            "rollback-or-stale-root",
            "degraded-time-proof",
            "fresh-authority-present-after-denial",
            "same-post-expiry-attempt-replayed"
          ]
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "observe-after-expiry-attempt",
              "load-expiry-receipt",
              "commit-enforcement-ledger",
              "emit-support-projection",
              "collect-backend-evidence",
              "request-fresh-authority",
              "consume-fresh-authority-once",
              "cutover-successor-root",
              "admit-successor-reader",
              "replay-same-idempotency-key",
              "detect-missing-expiry-receipt",
              "detect-rollback-or-stale-root",
              "detect-degraded-clock"
            ]
          }
        },
        "expected_outcome": {
          "type": "object",
          "required": [
            "terminal_state",
            "allow_new_observation",
            "allow_export",
            "allow_rehydration",
            "fresh_authority_required",
            "rate_limit_debited",
            "denial_reason_code",
            "successor_root_only",
            "expired_root_observation_allowed",
            "double_debit_prevented"
          ],
          "properties": {
            "terminal_state": {
              "enum": [
                "expired-root-denied",
                "fail-closed-typed-denial",
                "successor-root-admitted",
                "idempotent-denial-replayed"
              ]
            },
            "allow_new_observation": { "type": "boolean" },
            "allow_export": { "type": "boolean" },
            "allow_rehydration": { "type": "boolean" },
            "fresh_authority_required": { "type": "boolean" },
            "rate_limit_debited": { "type": "boolean" },
            "denial_reason_code": {
              "enum": [
                "expired-ledger-root-fresh-authority-required",
                "missing-expiry-receipt",
                "stale-root",
                "rollback-root",
                "forked-root",
                "degraded-clock",
                "none-successor-authority"
              ]
            },
            "successor_root_only": { "type": "boolean" },
            "expired_root_observation_allowed": { "type": "boolean" },
            "double_debit_prevented": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "required_receipt_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 },
          "uniqueItems": true
        },
        "support_visibility": {
          "enum": ["support-safe-digest-only", "not-emitted"]
        }
      },
      "additionalProperties": false
    }
  }
}
