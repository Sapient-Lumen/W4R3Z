{
  "kind": "chaos-experiment-plan",
  "plan_version": "0.1",
  "plan_id": "f7bdc46b-8ce5-4f6d-9a3b-6d3bf268b6d0",
  "created_at": "2026-02-27T14:00:00Z",
  "title": "Kill one DNS broker instance",
  "hypothesis": "With one dns-broker instance killed, clients fail over within 2s and error rate stays below 0.1%.",
  "targets": {
    "selector": {
      "fleet": "prod",
      "host_class": "control-plane",
      "match_labels": {
        "service": "dns-broker"
      }
    },
    "max_instances": 1
  },
  "actions": [
    {
      "type": "kill-service",
      "target": "svc:dns-broker",
      "params": { "signal": "SIGKILL" },
      "duration_sec": 60
    }
  ],
  "budgets": {
    "max_duration_sec": 120,
    "safety_stop": {
      "kind": "error_rate",
      "threshold": "0.5%",
      "window_sec": 60
    }
  },
  "approvals": {
    "min_approvers": 2,
    "notes": "Two-person integrity required for prod control-plane fault injection."
  },
  "correlation": {
    "change_id": "chg_2026_02_27_001"
  }
}
