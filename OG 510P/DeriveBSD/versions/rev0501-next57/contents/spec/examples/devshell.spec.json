{
  "format_version": "0.1",
  "name": "example-devshell",
  "platform": "freebsd-14.1-amd64",
  "packages": [
    "llvm",
    "rust",
    "cmake",
    "pkgconf",
    "git"
  ],
  "env": {
    "RUST_BACKTRACE": "1"
  },
  "network": "off",
  "isolation": "jail",
  "mounts": [
    {"kind": "project", "path": "/work", "mode": "rw"},
    {"kind": "tmp", "path": "/tmp", "mode": "rw"}
  ],
  "hooks": {
    "enter": ["echo enter devshell"],
    "exit": ["echo exit devshell"]
  }
}
