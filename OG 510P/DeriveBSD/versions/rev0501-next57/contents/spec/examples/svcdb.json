{
  "kind": "svcdb",
  "svcdb_version": "0.1",
  "generation_digest": "sha256:EXAMPLEGEN",
  "services": [
    {
      "id": "net.dhcp",
      "description": "Bring up host networking",
      "type": "longrun",
      "placement": {
        "domain": "host"
      },
      "exec": {
        "command": "/etc/rc.d/dhclient",
        "args": [
          "start"
        ]
      },
      "dependencies": {
        "requires": [
          "net.ifconfig"
        ]
      },
      "restart": {
        "policy": "on-failure",
        "max_restarts": 5,
        "window_seconds": 60,
        "backoff_seconds": 2,
        "enter_maintenance_after": 5
      },
      "resources": {
        "pf_anchor": "derive/net",
        "rctl_profile": "net-default"
      },
      "security": {
        "capset_digest": "sha256:CAPSETEXAMPLE",
        "promise_profile_digest": "sha256:PROFILE_NET_DHCP"
      }
    },
    {
      "id": "derive.fetchd",
      "description": "Fetcher domain daemon (service jail)",
      "type": "jail",
      "placement": {
        "domain": "jail",
        "name": "fetch"
      },
      "dependencies": {
        "requires": [
          "net.dhcp"
        ]
      },
      "restart": {
        "policy": "always",
        "max_restarts": 10,
        "window_seconds": 120,
        "backoff_seconds": 1,
        "enter_maintenance_after": 10
      },
      "resources": {
        "rctl_profile": "fetch-small"
      },
      "security": {
        "capset_digest": "sha256:CAPSETFETCH",
        "promise_profile_digest": "sha256:PROFILE_FETCHER"
      }
    },
    {
      "id": "derive.metricsd",
      "description": "Metrics scrape endpoint (socket activated, host)",
      "type": "socket-activated",
      "placement": {
        "domain": "host"
      },
      "exec": {
        "command": "/usr/local/libexec/derive/metricsd",
        "args": [
          "--serve-fd=3"
        ]
      },
      "dependencies": {
        "requires": [
          "net.dhcp"
        ]
      },
      "restart": {
        "policy": "on-failure",
        "max_restarts": 10,
        "window_seconds": 60,
        "backoff_seconds": 1,
        "enter_maintenance_after": 10
      },
      "activation": {
        "mode": "socket",
        "endpoints": [
          {
            "id": "http",
            "kind": "unix",
            "listen": {
              "path": "/run/derive/activator/metricsd.sock",
              "mode": "0660",
              "owner": "derive",
              "group": "derive"
            },
            "handoff": "fdpass",
            "granting": "portal"
          }
        ]
      },
      "security": {
        "capset_digest": "sha256:CAPSETMETRICS",
        "portal_grants": [
          "sha256:PORTALPERM_METRICS"
        ],
        "promise_profile_digest": "sha256:PROFILE_METRICS"
      },
      "identity": {
        "mode": "dynamic",
        "dynamic": {
          "class": "service",
          "uid_min": 60000,
          "uid_max": 64999,
          "persist_state": false,
          "state_dirs": [
            {
              "path": "/run/derive/metricsd",
              "mode": "0750",
              "wipe_on_release": true
            }
          ]
        }
      }
    }
  ],
  "bundles": {
    "base": [
      "net.ifconfig",
      "net.dhcp"
    ],
    "control-plane": [
      "derive.fetchd"
    ]
  },
  "meta": {
    "generated_at": "2026-02-24T17:00:00Z",
    "correlation_id": "example-1"
  }
}
