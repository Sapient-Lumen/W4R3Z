{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Time Snapshot Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "snapshot_version",
    "grant_digest",
    "subject",
    "observed",
    "captured_at",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "time-snapshot"
    },
    "snapshot_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "grant_digest": {
      "type": "string",
      "description": "Digest of canonical time.authority.grant bytes."
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "observed": {
      "type": "object",
      "required": [
        "clock_profile_digest",
        "entropy_mode"
      ],
      "properties": {
        "clock_profile_digest": {
          "type": "string"
        },
        "entropy_mode": {
          "type": "string",
          "enum": [
            "real",
            "deterministic",
            "recorded"
          ]
        },
        "seed_digest": {
          "type": "string"
        },
        "notes": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "captured_at": {
      "type": "string",
      "description": "ISO8601 time."
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "sig"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "alg": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "proof_bundle_digest": {
      "type": "string",
      "description": "Optional digest of a time-proof-bundle that explains how secure time was established."
    }
  },
  "additionalProperties": false
}
