{
  "$defs": {
    "action": {
      "enum": [
        "query",
        "export",
        "rehydrate",
        "observe",
        "managed-copy",
        "support-debug"
      ],
      "type": "string"
    },
    "id": {
      "pattern": "^rm-postdetach-[a-z0-9-]+$",
      "type": "string"
    },
    "schemaPath": {
      "pattern": "^spec/[a-z0-9_.-]+\\.schema\\.json$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "supportVisibility": {
      "enum": [
        "support-safe-digest-only"
      ],
      "type": "string"
    },
    "version": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}r\\d+$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Runtime contract for r531 post-closure access gating: every attempt to use old managed authority after terminal closure emits a typed denial/gate receipt and cannot silently observe, query, export, rehydrate, or expose raw support data.",
  "properties": {
    "access_ledger": {
      "additionalProperties": false,
      "properties": {
        "access_sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "broker_epoch_id": {
          "pattern": "^rm-postdetach-broker-epoch-[a-z0-9-]+$",
          "type": "string"
        },
        "compare_and_swap_result": {
          "enum": [
            "committed"
          ]
        },
        "expected_root_digest": {
          "$ref": "#/$defs/sha256"
        },
        "forked_root_accepted": {
          "enum": [
            false
          ]
        },
        "ledger_anchor_digest": {
          "$ref": "#/$defs/sha256"
        },
        "new_root_digest": {
          "$ref": "#/$defs/sha256"
        },
        "prior_root_digest": {
          "$ref": "#/$defs/sha256"
        },
        "rollback_accepted": {
          "enum": [
            false
          ]
        },
        "stale_root_accepted": {
          "enum": [
            false
          ]
        }
      },
      "required": [
        "broker_epoch_id",
        "access_sequence",
        "prior_root_digest",
        "expected_root_digest",
        "new_root_digest",
        "ledger_anchor_digest",
        "compare_and_swap_result",
        "rollback_accepted",
        "forked_root_accepted",
        "stale_root_accepted"
      ],
      "type": "object"
    },
    "access_receipt_id": {
      "$ref": "#/$defs/id"
    },
    "action_matrix": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/$defs/action"
          },
          "approval_required": {
            "type": "boolean"
          },
          "live_locator_allowed": {
            "enum": [
              false
            ]
          },
          "new_authority_required": {
            "enum": [
              true
            ]
          },
          "old_authority_allowed": {
            "enum": [
              false
            ]
          },
          "raw_support_allowed": {
            "enum": [
              false
            ]
          },
          "support_visibility": {
            "$ref": "#/$defs/supportVisibility"
          }
        },
        "required": [
          "action",
          "old_authority_allowed",
          "new_authority_required",
          "approval_required",
          "live_locator_allowed",
          "raw_support_allowed",
          "support_visibility"
        ],
        "type": "object"
      },
      "maxItems": 6,
      "minItems": 6,
      "type": "array"
    },
    "attempt": {
      "additionalProperties": false,
      "properties": {
        "actor_digest": {
          "$ref": "#/$defs/sha256"
        },
        "ambient_reauthentication_attempted": {
          "enum": [
            false
          ]
        },
        "attempt_id": {
          "$ref": "#/$defs/id"
        },
        "attempted_action": {
          "$ref": "#/$defs/action"
        },
        "attempted_at": {
          "format": "date-time",
          "type": "string"
        },
        "attempted_old_authority_class": {
          "enum": [
            "post-closure-old-managed-authority"
          ]
        },
        "old_handle_digest": {
          "$ref": "#/$defs/sha256"
        },
        "raw_handle_values_included": {
          "enum": [
            false
          ]
        },
        "raw_locator_values_included": {
          "enum": [
            false
          ]
        },
        "terminal_closure_capsule_digest": {
          "$ref": "#/$defs/sha256"
        },
        "terminal_closure_capsule_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "attempt_id",
        "attempted_at",
        "attempted_action",
        "attempted_old_authority_class",
        "terminal_closure_capsule_id",
        "terminal_closure_capsule_digest",
        "old_handle_digest",
        "actor_digest",
        "raw_handle_values_included",
        "raw_locator_values_included",
        "ambient_reauthentication_attempted"
      ],
      "type": "object"
    },
    "closure_gate": {
      "additionalProperties": false,
      "properties": {
        "access_outcome": {
          "enum": [
            "deny-post-closure-old-authority"
          ]
        },
        "gate_reason_code": {
          "enum": [
            "terminal-closure-managed-authority-closed"
          ]
        },
        "gate_reason_source": {
          "enum": [
            "terminal-closure-capsule"
          ]
        },
        "new_authority_required": {
          "enum": [
            true
          ]
        },
        "new_export_requires_new_approval": {
          "enum": [
            true
          ]
        },
        "old_authority_accepted": {
          "enum": [
            false
          ]
        },
        "successor_issued_from_old_authority": {
          "enum": [
            false
          ]
        },
        "support_visibility": {
          "$ref": "#/$defs/supportVisibility"
        },
        "terminal_closure_checked": {
          "enum": [
            true
          ]
        },
        "terminal_closure_state": {
          "enum": [
            "managed-authority-terminally-closed"
          ]
        }
      },
      "required": [
        "terminal_closure_checked",
        "terminal_closure_state",
        "gate_reason_code",
        "gate_reason_source",
        "old_authority_accepted",
        "successor_issued_from_old_authority",
        "new_authority_required",
        "new_export_requires_new_approval",
        "access_outcome",
        "support_visibility"
      ],
      "type": "object"
    },
    "generated_for_version": {
      "$ref": "#/$defs/version"
    },
    "invariants": {
      "additionalProperties": false,
      "properties": {
        "access_ledger_advances": {
          "enum": [
            true
          ]
        },
        "new_authority_required_for_successor": {
          "enum": [
            true
          ]
        },
        "no_export_without_new_approval": {
          "enum": [
            true
          ]
        },
        "post_closure_old_authority_denied": {
          "enum": [
            true
          ]
        },
        "rate_limit_debited_once": {
          "enum": [
            true
          ]
        },
        "support_visibility_digest_only": {
          "enum": [
            true
          ]
        },
        "terminal_closure_precedes_access_decision": {
          "enum": [
            true
          ]
        }
      },
      "required": [
        "terminal_closure_precedes_access_decision",
        "post_closure_old_authority_denied",
        "new_authority_required_for_successor",
        "no_export_without_new_approval",
        "support_visibility_digest_only",
        "rate_limit_debited_once",
        "access_ledger_advances"
      ],
      "type": "object"
    },
    "kind": {
      "enum": [
        "removable.media.local.post_detach.terminal.closure.access.receipt"
      ]
    },
    "lane": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "enum": [
            "removable-media-local-fallback"
          ]
        },
        "identity_policy": {
          "enum": [
            "family-normalized-phase-by-kind"
          ]
        },
        "phase": {
          "enum": [
            "post-detach"
          ]
        }
      },
      "required": [
        "family",
        "phase",
        "identity_policy"
      ],
      "type": "object"
    },
    "negative_fixture_policy": {
      "enum": [
        "known-bad-post-detach-terminal-closure-access-shapes-must-fail-validation"
      ]
    },
    "rate_limit_binding": {
      "additionalProperties": false,
      "properties": {
        "debit_count": {
          "enum": [
            1
          ]
        },
        "idempotency_key_digest": {
          "$ref": "#/$defs/sha256"
        },
        "rate_limit_action": {
          "enum": [
            "debit-post-closure-attempt"
          ]
        },
        "rate_limit_debit_receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "rate_limit_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "replayed_no_new_debit": {
          "enum": [
            false
          ]
        },
        "retry_after_policy": {
          "enum": [
            "bounded-redacted-retry-window"
          ]
        }
      },
      "required": [
        "rate_limit_action",
        "rate_limit_policy_digest",
        "rate_limit_debit_receipt_digest",
        "idempotency_key_digest",
        "debit_count",
        "replayed_no_new_debit",
        "retry_after_policy"
      ],
      "type": "object"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "source_bindings": {
      "additionalProperties": false,
      "properties": {
        "canonical_digest_rule": {
          "enum": [
            "json-sort-keys-compact-utf8-sha256"
          ]
        },
        "denial_reason_registry_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "denial_selection_receipt_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "export_bundle_deletion_receipt_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "rate_limit_debit_ledger_receipt_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "support_projection_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "terminal_closure_capsule_computed_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "canonical_digest_rule",
        "terminal_closure_capsule_computed_digest",
        "export_bundle_deletion_receipt_computed_digest",
        "denial_selection_receipt_computed_digest",
        "denial_reason_registry_computed_digest",
        "rate_limit_debit_ledger_receipt_computed_digest",
        "support_projection_computed_digest"
      ],
      "type": "object"
    },
    "support_projection": {
      "additionalProperties": false,
      "properties": {
        "body_or_full_text_visible": {
          "enum": [
            false
          ]
        },
        "device_identifier_visible": {
          "enum": [
            false
          ]
        },
        "filename_visible": {
          "enum": [
            false
          ]
        },
        "host_identity_visible": {
          "enum": [
            false
          ]
        },
        "raw_path_visible": {
          "enum": [
            false
          ]
        },
        "raw_payload_visible": {
          "enum": [
            false
          ]
        },
        "secret_material_visible": {
          "enum": [
            false
          ]
        },
        "visibility": {
          "$ref": "#/$defs/supportVisibility"
        }
      },
      "required": [
        "visibility",
        "raw_payload_visible",
        "raw_path_visible",
        "filename_visible",
        "device_identifier_visible",
        "host_identity_visible",
        "body_or_full_text_visible",
        "secret_material_visible"
      ],
      "type": "object"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "access_receipt_id",
    "generated_for_version",
    "lane",
    "source_bindings",
    "attempt",
    "closure_gate",
    "action_matrix",
    "rate_limit_binding",
    "access_ledger",
    "support_projection",
    "invariants",
    "negative_fixture_policy"
  ],
  "title": "DeriveBSD Removable-Media Local Post-Detach Terminal Closure Access Receipt Runtime Contract (r531)",
  "type": "object"
}
