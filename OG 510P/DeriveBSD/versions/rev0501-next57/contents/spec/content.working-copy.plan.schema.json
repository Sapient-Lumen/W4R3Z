{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD content working-copy plan (content.working-copy.plan) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "plan_version",
    "plan_id",
    "created_at",
    "source",
    "output",
    "boundary",
    "policy_digest"
  ],
  "properties": {
    "kind": {"const": "content.working-copy.plan"},
    "plan_version": {"type": "string", "const": "0.1"},
    "plan_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["import_receipt_digest", "source_output_digest", "source_class"],
      "properties": {
        "import_receipt_digest": {"type": "string"},
        "source_output_digest": {"type": "string"},
        "source_class": {
          "type": "string",
          "enum": ["imported-foreign-original", "sanitized-inspection-derivative"]
        },
        "mime": {"type": "string"},
        "filename": {"type": "string"}
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": {"type": "string", "const": "file"},
        "path": {"type": "string"},
        "filename": {"type": "string"},
        "mime": {"type": "string"},
        "placement": {
          "type": "string",
          "enum": ["home-working-set", "project-working-tree", "appvm-private"]
        }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": ["default_save_target", "source_writeback"],
      "properties": {
        "default_save_target": {"type": "string", "const": "working-copy-output"},
        "source_writeback": {"type": "string", "const": "separate-act-required"}
      },
      "additionalProperties": false
    },
    "policy_digest": {"type": "string"},
    "portal_session_id": {"type": "string"},
    "lease_id": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
