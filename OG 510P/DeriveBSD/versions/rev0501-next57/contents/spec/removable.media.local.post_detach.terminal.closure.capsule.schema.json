{
  "$defs": {
    "dateTime": {
      "format": "date-time",
      "type": "string"
    },
    "examplePath": {
      "pattern": "^spec/examples/[a-z0-9_.-]+\\.json$",
      "type": "string"
    },
    "id": {
      "pattern": "^rm-postdetach-[a-z0-9-]+$",
      "type": "string"
    },
    "schemaPath": {
      "pattern": "^spec/[a-z0-9_.-]+\\.schema\\.json$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}r\\d+$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Runtime contract for r530 terminal closure: after export deletion/revocation and denial selection, managed post-detach authority is closed and future access must require new authority.",
  "properties": {
    "authority_posture": {
      "additionalProperties": false,
      "properties": {
        "expired_root_future_observation_allowed": {
          "enum": [
            false
          ]
        },
        "fresh_authority_required_for_any_new_successor": {
          "enum": [
            true
          ]
        },
        "managed_export_future_access": {
          "enum": [
            "denied-after-terminal-closure"
          ]
        },
        "new_export_requires_new_approval": {
          "enum": [
            true
          ]
        },
        "old_handle_resurrection_allowed": {
          "enum": [
            false
          ]
        },
        "query_projection_future_access": {
          "enum": [
            "denied-unless-new-authority"
          ]
        },
        "reader_observation_future_access": {
          "enum": [
            "denied-unless-successor-authority"
          ]
        },
        "rehydration_future_access": {
          "enum": [
            "denied-unless-new-authority"
          ]
        }
      },
      "required": [
        "managed_export_future_access",
        "query_projection_future_access",
        "rehydration_future_access",
        "reader_observation_future_access",
        "fresh_authority_required_for_any_new_successor",
        "expired_root_future_observation_allowed",
        "old_handle_resurrection_allowed",
        "new_export_requires_new_approval"
      ],
      "type": "object"
    },
    "closure_capsule_id": {
      "$ref": "#/$defs/id"
    },
    "closure_ledger": {
      "additionalProperties": false,
      "properties": {
        "broker_epoch_id": {
          "pattern": "^rm-postdetach-broker-epoch-[a-z0-9-]+$",
          "type": "string"
        },
        "closure_sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "compare_and_swap_result": {
          "enum": [
            "committed"
          ]
        },
        "expected_root_digest": {
          "$ref": "#/$defs/sha256"
        },
        "forked_root_accepted": {
          "enum": [
            false
          ]
        },
        "idempotency_key_digest": {
          "$ref": "#/$defs/sha256"
        },
        "ledger_anchor_digest": {
          "$ref": "#/$defs/sha256"
        },
        "new_root_digest": {
          "$ref": "#/$defs/sha256"
        },
        "prior_root_digest": {
          "$ref": "#/$defs/sha256"
        },
        "replay_outcome": {
          "enum": [
            "first-terminal-closure",
            "idempotent-terminal-closure-replay-no-new-effects"
          ]
        },
        "rollback_accepted": {
          "enum": [
            false
          ]
        },
        "stale_root_accepted": {
          "enum": [
            false
          ]
        }
      },
      "required": [
        "broker_epoch_id",
        "closure_sequence",
        "prior_root_digest",
        "expected_root_digest",
        "new_root_digest",
        "ledger_anchor_digest",
        "compare_and_swap_result",
        "idempotency_key_digest",
        "replay_outcome",
        "rollback_accepted",
        "forked_root_accepted",
        "stale_root_accepted"
      ],
      "type": "object"
    },
    "deletion_closure": {
      "additionalProperties": false,
      "properties": {
        "bounded_retention_proven": {
          "enum": [
            true
          ]
        },
        "controlled_remote_object_terminal_or_revoked": {
          "enum": [
            true
          ]
        },
        "live_locator_absent_or_terminal": {
          "enum": [
            true
          ]
        },
        "local_managed_copy_terminal": {
          "enum": [
            true
          ]
        },
        "offline_copy_claim": {
          "enum": [
            "not-claimed-erased-only-future-authority-denied"
          ]
        },
        "raw_locator_visible": {
          "enum": [
            false
          ]
        }
      },
      "required": [
        "local_managed_copy_terminal",
        "controlled_remote_object_terminal_or_revoked",
        "live_locator_absent_or_terminal",
        "bounded_retention_proven",
        "offline_copy_claim",
        "raw_locator_visible"
      ],
      "type": "object"
    },
    "denial_closure": {
      "additionalProperties": false,
      "properties": {
        "denial_reason_registry_checked": {
          "enum": [
            true
          ]
        },
        "denial_selection_receipt_checked": {
          "enum": [
            true
          ]
        },
        "rate_limit_double_debit_on_replay": {
          "enum": [
            false
          ]
        },
        "selected_reason_is_registry_member": {
          "enum": [
            true
          ]
        },
        "subordinate_reasons_do_not_preempt": {
          "enum": [
            true
          ]
        },
        "support_visibility": {
          "enum": [
            "support-safe-digest-only"
          ]
        }
      },
      "required": [
        "denial_reason_registry_checked",
        "denial_selection_receipt_checked",
        "selected_reason_is_registry_member",
        "subordinate_reasons_do_not_preempt",
        "rate_limit_double_debit_on_replay",
        "support_visibility"
      ],
      "type": "object"
    },
    "generated_for_version": {
      "$ref": "#/$defs/version"
    },
    "invariants": {
      "additionalProperties": false,
      "properties": {
        "closure_ledger_advances_once": {
          "enum": [
            true
          ]
        },
        "future_access_denied_without_new_authority": {
          "enum": [
            true
          ]
        },
        "managed_authority_closed": {
          "enum": [
            true
          ]
        },
        "no_expired_root_resurrection": {
          "enum": [
            true
          ]
        },
        "offline_erasure_not_overclaimed": {
          "enum": [
            true
          ]
        },
        "support_visibility_digest_only": {
          "enum": [
            true
          ]
        }
      },
      "required": [
        "managed_authority_closed",
        "future_access_denied_without_new_authority",
        "no_expired_root_resurrection",
        "offline_erasure_not_overclaimed",
        "support_visibility_digest_only",
        "closure_ledger_advances_once"
      ],
      "type": "object"
    },
    "joins": {
      "additionalProperties": false,
      "properties": {
        "denial_selection_matches_registry": {
          "enum": [
            true
          ]
        },
        "export_deletion_is_terminal_input": {
          "enum": [
            true
          ]
        },
        "future_authority_requires_new_receipts": {
          "enum": [
            true
          ]
        },
        "scenario_replay_checked": {
          "enum": [
            true
          ]
        },
        "support_projection_is_allowlisted": {
          "enum": [
            true
          ]
        },
        "transition_witness_checked": {
          "enum": [
            true
          ]
        }
      },
      "required": [
        "export_deletion_is_terminal_input",
        "denial_selection_matches_registry",
        "support_projection_is_allowlisted",
        "transition_witness_checked",
        "scenario_replay_checked",
        "future_authority_requires_new_receipts"
      ],
      "type": "object"
    },
    "kind": {
      "enum": [
        "removable.media.local.post_detach.terminal.closure.capsule"
      ]
    },
    "lane": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "enum": [
            "removable-media-local-fallback"
          ]
        },
        "identity_policy": {
          "enum": [
            "family-normalized-phase-by-kind"
          ]
        },
        "phase": {
          "enum": [
            "post-detach"
          ]
        }
      },
      "required": [
        "family",
        "phase",
        "identity_policy"
      ],
      "type": "object"
    },
    "negative_fixture_policy": {
      "enum": [
        "known-bad-post-detach-terminal-closure-shapes-must-fail-validation"
      ]
    },
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "source_bindings": {
      "additionalProperties": false,
      "properties": {
        "canonical_digest_rule": {
          "enum": [
            "json-sort-keys-compact-utf8-sha256"
          ]
        },
        "denial_reason_registry_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "denial_receipt_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "denial_selection_receipt_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "export_bundle_access_receipt_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "export_bundle_deletion_receipt_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "revocation_tombstone_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "scenario_replay_manifest_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "support_projection_computed_digest": {
          "$ref": "#/$defs/sha256"
        },
        "transition_witness_capsule_computed_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "canonical_digest_rule",
        "export_bundle_deletion_receipt_computed_digest",
        "export_bundle_access_receipt_computed_digest",
        "revocation_tombstone_computed_digest",
        "denial_receipt_computed_digest",
        "denial_selection_receipt_computed_digest",
        "denial_reason_registry_computed_digest",
        "support_projection_computed_digest",
        "transition_witness_capsule_computed_digest",
        "scenario_replay_manifest_computed_digest"
      ],
      "type": "object"
    },
    "support_projection": {
      "additionalProperties": false,
      "properties": {
        "body_or_full_text_visible": {
          "enum": [
            false
          ]
        },
        "device_identifier_visible": {
          "enum": [
            false
          ]
        },
        "filename_visible": {
          "enum": [
            false
          ]
        },
        "host_identity_visible": {
          "enum": [
            false
          ]
        },
        "raw_path_visible": {
          "enum": [
            false
          ]
        },
        "raw_payload_visible": {
          "enum": [
            false
          ]
        },
        "secret_material_visible": {
          "enum": [
            false
          ]
        },
        "visibility": {
          "enum": [
            "support-safe-digest-only"
          ]
        }
      },
      "required": [
        "visibility",
        "raw_payload_visible",
        "raw_path_visible",
        "filename_visible",
        "device_identifier_visible",
        "host_identity_visible",
        "body_or_full_text_visible",
        "secret_material_visible"
      ],
      "type": "object"
    },
    "terminal_inputs": {
      "additionalProperties": false,
      "properties": {
        "delete_sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "denial_selection_receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "denial_selection_receipt_id": {
          "pattern": "^rm-postdetach-denial-selection-[a-z0-9-]+$",
          "type": "string"
        },
        "export_bundle_deletion_receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "export_bundle_deletion_receipt_id": {
          "pattern": "^rm-postdetach-export-deletion-[a-z0-9-]+$",
          "type": "string"
        },
        "selected_reason_code": {
          "enum": [
            "expired-ledger-root-fresh-authority-required",
            "tombstone-visible",
            "stale-root",
            "missing-expiry-receipt",
            "degraded-clock"
          ]
        },
        "support_projection_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "export_bundle_deletion_receipt_id",
        "export_bundle_deletion_receipt_digest",
        "delete_sequence",
        "denial_selection_receipt_id",
        "denial_selection_receipt_digest",
        "selected_reason_code",
        "support_projection_digest"
      ],
      "type": "object"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "generated_for_version",
    "closure_capsule_id",
    "lane",
    "source_bindings",
    "terminal_inputs",
    "authority_posture",
    "deletion_closure",
    "denial_closure",
    "support_projection",
    "closure_ledger",
    "joins",
    "invariants",
    "negative_fixture_policy"
  ],
  "title": "DeriveBSD Removable-Media Local Post-Detach Terminal Closure Capsule",
  "type": "object"
}
