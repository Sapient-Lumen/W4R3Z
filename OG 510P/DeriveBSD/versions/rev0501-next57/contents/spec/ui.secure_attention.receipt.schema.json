{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD UI Secure Attention Receipt (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "receipt_version",
    "event_id",
    "action_taken",
    "issued_at",
    "signature"
  ],
  "properties": {
    "kind": { "const": "ui-secure-attention-receipt" },
    "receipt_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "event_id": { "type": "string" },
    "action_taken": {
      "type": "string",
      "enum": ["lock_screen", "show_trusted_prompt", "switch_to_host"]
    },
    "reason": { "type": "string" },
    "issued_at": { "type": "string", "description": "ISO8601 time." },
    "signature": {
      "type": "object",
      "required": ["key_id", "alg", "sig"],
      "properties": {
        "key_id": { "type": "string" },
        "alg": { "type": "string" },
        "sig": { "type": "string", "description": "Signature over canonical JSON bytes." }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
