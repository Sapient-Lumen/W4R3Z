{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD Trust Boundary Graph (trust.boundary.graph) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "graph_version",
    "created_at",
    "plan_digest",
    "nodes",
    "boundaries"
  ],
  "properties": {
    "kind": { "const": "trust.boundary.graph" },
    "graph_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },
    "plan_digest": { "type": "string" },

    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },

    "boundaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/boundary" }
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "kind", "trust_tier"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "description": "svc, vm, jail, broker, kernel, hardware, external" },
        "name": { "type": "string" },
        "trust_tier": {
          "type": "string",
          "enum": ["trusted", "semi_trusted", "untrusted", "external", "hardware", "operator"]
        }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": ["id", "from", "to", "kind", "direction"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": [
            "untrusted-input",
            "privilege-gap",
            "confidentiality-gap",
            "integrity-gap",
            "operator-action",
            "trust-change"
          ]
        },
        "direction": { "type": "string", "enum": ["in", "out", "bidirectional"] },

        "assets": {
          "type": "array",
          "items": { "type": "string" },
          "description": "What is at stake (keys, secrets, integrity of state, availability, etc)."
        },

        "surface_links": {
          "type": "object",
          "properties": {
            "contracts": { "type": "array", "items": { "type": "string" } },
            "uapi": { "type": "array", "items": { "type": "string" } },
            "parsers": { "type": "array", "items": { "type": "string" } },
            "authority_edges": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },

        "mitigations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Policy ids, receipt digests, or short references to controls."
        },

        "risk_tags": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
