{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD mirror kit manifest (mirror.kit.manifest) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "manifest_version",
    "kit_id",
    "created_at",
    "layout",
    "channels",
    "contents"
  ],
  "properties": {
    "kind": { "const": "mirror.kit.manifest" },
    "manifest_version": { "type": "string", "const": "0.1" },

    "kit_id": { "type": "string", "description": "Opaque id for this mirror kit instance (not a trust input)." },
    "created_at": { "type": "string", "format": "date-time" },

    "layout": {
      "type": "string",
      "enum": ["tree", "bundle"],
      "description": "Carrier layout. Trust comes from verification, not the carrier." 
    },

    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "snapshot": { "type": "string", "description": "Resolved snapshot/timestamp id if known." },

          "metadata": {
            "type": "array",
            "description": "Channel metadata objects carried by the kit (digests + role hints).",
            "items": {
              "type": "object",
              "required": ["digest"],
              "properties": {
                "role": { "type": "string", "description": "Hint only (e.g., timestamp/snapshot/targets/delegation)." },
                "digest": { "type": "string" },
                "size_bytes": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },

          "constraints": {
            "type": "object",
            "description": "Optional expected constraints (policy may tighten).",
            "properties": {
              "min_snapshot": { "type": "string" },
              "max_snapshot": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },

    "contents": {
      "type": "object",
      "description": "Objects carried by the kit (content-addressed).",
      "required": ["objects"],
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["digest", "type"],
            "properties": {
              "digest": { "type": "string" },
              "type": { "type": "string", "enum": ["metadata", "artifact", "delta", "source", "proof"] },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "channel": { "type": "string", "description": "Optional channel association." }
            },
            "additionalProperties": false
          }
        },
        "totals": {
          "type": "object",
          "properties": {
            "object_count": { "type": "integer", "minimum": 0 },
            "bytes_total": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "bindings": {
      "type": "object",
      "description": "Optional digests that bind the kit to policy/provenance/evidence objects.",
      "properties": {
        "trust_policy_digest": { "type": "string" },
        "publisher_identity_receipt_digest": { "type": "string" },
        "transparency_proof_digest": { "type": "string" }
      },
      "additionalProperties": false
    },

    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
