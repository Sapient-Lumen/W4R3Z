{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD bundle plan diff (bundle.plan.diff) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "diff_version",
    "created_at",
    "from_plan",
    "to_plan",
    "window_changed",
    "include_changed",
    "transforms_changed",
    "output_changed"
  ],
  "properties": {
    "kind": { "const": "bundle.plan.diff" },
    "diff_version": { "type": "string", "const": "0.1" },
    "created_at": { "type": "string", "format": "date-time" },

    "scope": {
      "type": "object",
      "description": "Optional scope metadata (host/profile/export intent).",
      "properties": {
        "host_id": { "type": "string" },
        "profile_id": {
          "type": "string",
          "description": "Canonical profile id (fleet_host/workstation/general_os/appliance_factory)."
        },
        "domain": { "type": "string", "description": "Optional compartment/domain identifier." },
        "from_generation": { "type": "string" },
        "to_generation": { "type": "string" },
        "ticket": { "type": "string", "description": "Optional incident/ticket identifier motivating the export." }
      },
      "additionalProperties": false
    },

    "from_plan": { "$ref": "#/$defs/plan_ref" },
    "to_plan": { "$ref": "#/$defs/plan_ref" },

    "window_changed": {
      "type": "object",
      "description": "Selection window changes (if any).",
      "properties": {
        "since": { "$ref": "#/$defs/value_change" },
        "until": { "$ref": "#/$defs/value_change" },
        "max_bytes": { "$ref": "#/$defs/value_change" }
      },
      "additionalProperties": false
    },

    "include_changed": {
      "type": "array",
      "description": "Include knob changes (incident.bundle include knobs).",
      "items": { "$ref": "#/$defs/knob_change" }
    },

    "transforms_changed": {
      "type": "object",
      "description": "Transform/policy binding changes (redaction/export policy digests).",
      "properties": {
        "redaction_transform_digest": { "$ref": "#/$defs/value_change" },
        "export_policy_digest": { "$ref": "#/$defs/value_change" }
      },
      "additionalProperties": false
    },

    "output_changed": {
      "type": "object",
      "description": "Output formatting changes (if any).",
      "properties": {
        "format": { "$ref": "#/$defs/value_change" },
        "compression_level": { "$ref": "#/$defs/value_change" }
      },
      "additionalProperties": false
    },

    "summary": {
      "type": "object",
      "properties": {
        "include_changed": { "type": "integer", "minimum": 0 },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "policy_digest": {
      "type": "string",
      "description": "Digest of the policy module(s) authorizing diff generation/export (optional)."
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "plan_ref": {
      "type": "object",
      "description": "Reference to a bundle.plan object by digest (and optional human fields).",
      "required": ["digest"],
      "properties": {
        "digest": { "type": "string" },
        "plan_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "value_change": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": ["string", "number", "integer", "boolean", "null"] },
        "to": { "type": ["string", "number", "integer", "boolean", "null"] },
        "classification": {
          "type": "string",
          "enum": ["window", "size", "policy", "format", "other"],
          "default": "other"
        },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "knob_change": {
      "type": "object",
      "required": ["knob", "from", "to"],
      "properties": {
        "knob": { "type": "string" },
        "from": { "type": "boolean" },
        "to": { "type": "boolean" },
        "risk_flags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
