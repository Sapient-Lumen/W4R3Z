{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD packet-capture export transport receipt profile (packet.capture.export.transport.receipt.profile) (v0.1)",
  "allOf": [
    {
      "$ref": "transport.receipt.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "packet.capture.normalized"
            }
          }
        },
        "destination": {
          "type": "object",
          "required": [
            "recipient"
          ],
          "properties": {
            "recipient": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "status",
            "remote_id",
            "remote_validator",
            "remote_locator"
          ],
          "properties": {
            "status": {
              "const": "ok"
            },
            "remote_validator": {
              "type": "object",
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "etag-strong",
                    "etag-weak",
                    "version-id",
                    "attachment-revision",
                    "message-id",
                    "opaque"
                  ]
                },
                "value": {
                  "type": "string"
                }
              }
            },
            "remote_locator": {
              "type": "object",
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "uri-hint",
                    "ticket-attachment",
                    "portal-object",
                    "message-part",
                    "object-path",
                    "opaque"
                  ]
                },
                "value": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "required": [
        "kind",
        "receipt_version",
        "receipt_id",
        "created_at",
        "transport_kind",
        "artifact",
        "destination",
        "result"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "transport_kind": {
                "enum": [
                  "jira",
                  "servicenow"
                ]
              }
            },
            "required": [
              "transport_kind"
            ]
          },
          "then": {
            "properties": {
              "destination": {
                "type": "object",
                "required": [
                  "ticket_id"
                ]
              }
            }
          }
        }
      ]
    }
  ]
}
