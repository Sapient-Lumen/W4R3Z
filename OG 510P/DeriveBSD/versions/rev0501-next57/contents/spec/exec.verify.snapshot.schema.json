{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeriveBSD verified execution backend snapshot (exec-verify-snapshot) (v0.1)",
  "type": "object",
  "required": [
    "kind",
    "snapshot_version",
    "captured_at",
    "mode",
    "loaded_fingerprints_digest"
  ],
  "properties": {
    "kind": {
      "const": "exec-verify-snapshot"
    },
    "snapshot_version": {
      "type": "string",
      "pattern": "^0\\.\\d+$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "host_id": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "host",
            "service"
          ]
        },
        "service_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "disabled",
        "audit",
        "enforce"
      ]
    },
    "loaded_fingerprints_digest": {
      "type": "string"
    },
    "counters": {
      "type": "object",
      "properties": {
        "violations": {
          "type": "integer",
          "minimum": 0
        },
        "denials": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Backend observation snapshot for verified execution state."
}
