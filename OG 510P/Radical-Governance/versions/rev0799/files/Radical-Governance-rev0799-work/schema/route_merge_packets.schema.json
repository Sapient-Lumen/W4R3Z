{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/radical-governance/route_merge_packets.schema.json",
  "title": "Route merge review packets",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "packet_role",
    "packets"
  ],
  "properties": {
    "schema": {
      "const": "route_merge_packets.v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "review_date": {
      "type": "string"
    },
    "packet_role": {
      "type": "string"
    },
    "packets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "source_note",
          "source_file",
          "target_notes",
          "target_files",
          "candidate_status",
          "protected_elements",
          "preservation_findings",
          "absorption_requirements",
          "next_action"
        ],
        "properties": {
          "source_note": {
            "type": "integer"
          },
          "source_file": {
            "type": "string"
          },
          "target_notes": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "target_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "candidate_status": {
            "type": "string"
          },
          "reviewed_in_revision": {
            "type": "string",
            "pattern": "^rev[0-9]{4}$"
          },
          "protected_elements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preservation_findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "absorption_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_action": {
            "type": "string"
          },
          "review_packet_file": {
            "type": "string"
          },
          "review_packet_note": {
            "type": "integer"
          },
          "successor_note": {
            "type": "integer"
          },
          "successor_file": {
            "type": "string"
          },
          "redirect_ledger_id": {
            "type": "string"
          },
          "reader_redirect_status": {
            "type": "string"
          },
          "reader_redirect_surfaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "final_preservation_review_file": {
            "type": "string"
          },
          "final_preservation_review_note": {
            "type": "integer"
          },
          "final_preservation_review_status": {
            "type": "string"
          },
          "retirement_blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
