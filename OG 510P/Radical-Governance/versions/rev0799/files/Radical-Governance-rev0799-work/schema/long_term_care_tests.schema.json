{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/radical-governance/long_term_care_tests.schema.json",
  "title": "Long-term services/supports and care-continuity tests matrix",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "matrix_role",
    "source_notes",
    "tests"
  ],
  "properties": {
    "schema": {
      "const": "radical-governance-long-term-care-tests-v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "matrix_role": {
      "type": "string"
    },
    "source_notes": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "governing_rule": {
      "type": "string"
    },
    "tests": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "question",
          "pass_evidence",
          "fail_or_repair",
          "activated_by",
          "related_notes"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "pass_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fail_or_repair": {
            "type": "string"
          },
          "activated_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_notes": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "case_examples": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
