{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/radical-governance/fieldwork_execution_controls.schema.json",
  "title": "Radical Governance fieldwork execution controls",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "execution_role",
    "privacy_posture",
    "closure_policy",
    "controls"
  ],
  "properties": {
    "schema": {
      "const": "radical-governance-fieldwork-execution-controls-v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "execution_role": {
      "type": "string"
    },
    "privacy_posture": {
      "type": "string"
    },
    "closure_policy": {
      "type": "string"
    },
    "controls": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "control_label",
          "linked_authorization_gate",
          "linked_field_intake_control",
          "linked_sampling_gate",
          "linked_outcome_tail_plan",
          "linked_gaps",
          "linked_source_claim_receipts",
          "execution_status",
          "execution_artifacts_required",
          "operating_log_floor",
          "participant_safety_controls",
          "incident_response_controls",
          "breach_response_controls",
          "audit_controls",
          "retention_destruction_controls",
          "publication_release_controls",
          "prohibited_cube_artifacts",
          "pause_stop_conditions",
          "closure_blocker",
          "next_action"
        ],
        "properties": {
          "control_label": {"type": "string"},
          "linked_authorization_gate": {"type": "string"},
          "linked_field_intake_control": {"type": "string"},
          "linked_sampling_gate": {"type": "string"},
          "linked_outcome_tail_plan": {"type": "string"},
          "linked_gaps": {"type": "array", "items": {"type": "string"}},
          "linked_source_claim_receipts": {"type": "array", "items": {"type": "string"}},
          "execution_status": {"type": "string"},
          "execution_artifacts_required": {"type": "array", "items": {"type": "string"}},
          "operating_log_floor": {"type": "array", "items": {"type": "string"}},
          "participant_safety_controls": {"type": "array", "items": {"type": "string"}},
          "incident_response_controls": {"type": "array", "items": {"type": "string"}},
          "breach_response_controls": {"type": "array", "items": {"type": "string"}},
          "audit_controls": {"type": "array", "items": {"type": "string"}},
          "retention_destruction_controls": {"type": "array", "items": {"type": "string"}},
          "publication_release_controls": {"type": "array", "items": {"type": "string"}},
          "prohibited_cube_artifacts": {"type": "array", "items": {"type": "string"}},
          "pause_stop_conditions": {"type": "array", "items": {"type": "string"}},
          "closure_blocker": {"type": "string"},
          "next_action": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
