{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/radical-governance/fieldwork_postclosure_monitoring_controls.schema.json",
  "title": "Radical Governance fieldwork post-closure monitoring controls",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "monitoring_role",
    "privacy_posture",
    "monitoring_policy",
    "controls"
  ],
