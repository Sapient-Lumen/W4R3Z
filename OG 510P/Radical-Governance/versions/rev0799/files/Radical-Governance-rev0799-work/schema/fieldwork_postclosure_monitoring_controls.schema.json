      "pattern": "^rev[0-9]{4}$"
    },
    "monitoring_role": {
      "type": "string"
    },
    "privacy_posture": {
      "type": "string"
    },
    "monitoring_policy": {
      "type": "string"
    },
    "controls": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "control_label",
          "monitoring_status",
          "linked_fieldwork_closure_dossier",
          "linked_fieldwork_redress_verification_control",
          "linked_fieldwork_correction_control",
          "linked_fieldwork_release_control",
          "linked_fieldwork_execution_control",
          "linked_authorization_gate",
          "linked_field_intake_control",
          "linked_sampling_gate",
          "linked_outcome_tail_plan",
          "linked_gaps",
          "linked_source_claim_receipts",
          "monitoring_cadence_classes",
          "drift_triggers",
          "recheck_evidence_required",
          "allowed_cube_artifacts",
          "prohibited_cube_artifacts",
          "gap_reopen_rules",
          "monitoring_blocker",
          "next_action"
        ],
        "properties": {
          "control_label": {
            "type": "string"
          },
          "monitoring_status": {
            "type": "string"
          },
          "linked_fieldwork_closure_dossier": {
            "type": "string"
          },
          "linked_fieldwork_redress_verification_control": {
            "type": "string"
          },
          "linked_fieldwork_correction_control": {
            "type": "string"
          },
          "linked_fieldwork_release_control": {
            "type": "string"
          },
          "linked_fieldwork_execution_control": {
            "type": "string"
          },
          "linked_authorization_gate": {
            "type": "string"
          },
          "linked_field_intake_control": {
            "type": "string"
          },
          "linked_sampling_gate": {
            "type": "string"
          },
          "linked_outcome_tail_plan": {
            "type": "string"
          },
          "monitoring_blocker": {
            "type": "string"
          },
          "next_action": {
            "type": "string"
          },
          "linked_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "linked_source_claim_receipts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "monitoring_cadence_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "drift_triggers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recheck_evidence_required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_cube_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prohibited_cube_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gap_reopen_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
