{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/radical-governance/archive_stewardship_handoff_controls.schema.json",
  "title": "Radical Governance archive stewardship handoff controls",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "handoff_role",
    "privacy_posture",
    "handoff_policy",
    "controls"
  ],
  "properties": {
    "schema": {
      "const": "radical-governance-archive-stewardship-handoff-controls-v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "handoff_role": {
      "type": "string"
    },
    "privacy_posture": {
      "type": "string"
    },
    "handoff_policy": {
      "type": "string"
    },
    "controls": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "control_label",
          "handoff_status",
          "linked_gaps",
          "linked_source_claim_receipts",
          "required_owner_decisions",
          "required_public_documents",
          "role_classes_required",
          "handoff_clocks",
          "allowed_cube_artifacts",
          "prohibited_cube_artifacts",
          "handoff_blocker",
          "next_action"
        ],
        "properties": {
          "control_label": {
            "type": "string"
          },
          "handoff_status": {
            "type": "string"
          },
          "handoff_blocker": {
            "type": "string"
          },
          "next_action": {
            "type": "string"
          },
          "linked_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "linked_source_claim_receipts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_owner_decisions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_public_documents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role_classes_required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "handoff_clocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_cube_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prohibited_cube_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
