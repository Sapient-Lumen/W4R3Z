{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/radical-governance/claims.schema.json",
  "title": "Radical Governance Claims Ledger",
  "type": "object",
  "required": ["schema", "revision", "ledger_role", "status_labels", "currentness_labels", "claims"],
  "properties": {
    "schema": {"const": "radical-governance-claims-v1"},
    "revision": {"type": "string"},
    "ledger_role": {"type": "string"},
    "current_note_files": {"type": "array", "items": {"type": "string"}},
    "status_labels": {"type": "object"},
    "currentness_labels": {"type": "object"},
    "claims": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["note_file", "claim_text", "claim_status", "evidence_type", "currentness", "source_keys", "opposition_brief", "falsifier", "affected_parties", "capture_channels", "review_clock"],
        "properties": {
          "note_file": {"type": "string"},
          "claim_text": {"type": "string"},
          "claim_status": {"type": "string"},
          "evidence_type": {"type": "string"},
          "currentness": {"type": "string"},
          "source_keys": {"type": "array", "items": {"type": "string"}},
          "opposition_brief": {"type": "string"},
          "falsifier": {"type": "string"},
          "affected_parties": {"type": "array", "items": {"type": "string"}},
          "capture_channels": {"type": "array", "items": {"type": "string"}},
          "review_clock": {"type": "string"}
        }
      }
    }
  }
}
