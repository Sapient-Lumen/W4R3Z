{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/radical-governance/source_catalog.schema.json",
  "title": "Radical Governance source catalog",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "catalog_role",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "radical-governance-source-catalog-v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "catalog_role": {
      "type": "string"
    },
    "notes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "groups"
        ],
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "publisher",
                "title",
                "url"
              ],
              "properties": {
                "publisher": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "source_key": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
