{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/radical-governance/route_redirect_ledger.schema.json",
  "title": "Route redirect ledger",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "ledgers"
  ],
  "properties": {
    "schema": {
      "const": "route_redirect_ledger.v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "review_date": {
      "type": "string"
    },
    "ledger_role": {
      "type": "string"
    },
    "holding": {
      "type": "string"
    },
    "ledgers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "source_note",
          "source_file",
          "successor_note",
          "successor_file",
          "redirect_rows"
        ],
        "properties": {
          "source_note": {
            "type": "integer"
          },
          "source_file": {
            "type": "string"
          },
          "successor_note": {
            "type": "integer"
          },
          "successor_file": {
            "type": "string"
          },
          "ledger_note": {
            "type": "integer"
          },
          "ledger_file": {
            "type": "string"
          },
          "redirect_rows": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "deletion_authorization": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
