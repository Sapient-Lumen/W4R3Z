{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Radical Governance gap ledger",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "ledger_role",
    "gaps"
  ],
  "properties": {
    "schema": {
      "const": "radical-governance-gap-ledger-v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "ledger_role": {
      "type": "string"
    },
    "review_date": {
      "type": "string"
    },
    "gaps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "severity",
          "missing_domain",
          "why_it_matters",
          "nearest_notes",
          "affected_parties",
          "next_artifact",
          "why_not_now"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "missing_domain": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "nearest_notes": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "source_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affected_parties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_artifact": {
            "type": "string"
          },
          "why_not_now": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
