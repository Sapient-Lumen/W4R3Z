{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/radical-governance/source_claim_receipts.schema.json",
  "title": "Radical Governance source claim receipts",
  "type": "object",
  "required": ["schema", "revision", "receipt_role", "copyright_and_privacy_posture", "receipts"],
  "properties": {
    "schema": {"const": "radical-governance-source-claim-receipts-v1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "receipt_role": {"type": "string"},
    "copyright_and_privacy_posture": {"type": "string"},
    "closure_policy": {"type": "string"},
    "receipts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["source_key", "archive_notes", "claim_family", "claim_supported", "source_locator", "locator_type", "anchor_quote", "passage_summary", "source_receipt_level", "preservation_status", "evidence_limit", "closure_blocker_for", "next_preservation_step"],
        "properties": {
          "source_key": {"type": "string"},
          "archive_notes": {"type": "array", "items": {"type": "integer"}},
          "claim_family": {"type": "string"},
          "claim_supported": {"type": "string"},
          "source_locator": {"type": "string"},
          "locator_type": {"type": "string"},
          "anchor_quote": {"type": "string"},
          "passage_summary": {"type": "string"},
          "source_receipt_level": {"type": "string"},
          "preservation_status": {"type": "string"},
          "evidence_limit": {"type": "string"},
          "closure_blocker_for": {"type": "array", "items": {"type": "string"}},
          "next_preservation_step": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
