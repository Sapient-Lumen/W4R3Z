{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/radical-governance/evidence_receipts.schema.json",
  "title": "Radical Governance evidence receipts pilot",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "receipt_role",
    "privacy_posture",
    "receipts"
  ],
  "properties": {
    "schema": {
      "const": "radical-governance-evidence-receipts-v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "receipt_role": {
      "type": "string"
    },
    "privacy_posture": {
      "type": "string"
    },
    "receipts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "claim",
          "case_family",
          "archive_notes",
          "source_keys",
          "source_locator",
          "evidence_class",
          "proof_status",
          "affected_person_gap",
          "minimum_next_receipts",
          "risk_if_missing",
          "proof_floor",
          "denominator_gap",
          "closure_blocker_for",
          "can_close_gap",
          "closure_rule",
          "material_outcome_dimensions",
          "field_sample_requirement",
          "source_receipt_level"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "case_family": {
            "type": "string"
          },
          "archive_notes": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "source_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_locator": {
            "type": "string"
          },
          "evidence_class": {
            "type": "string"
          },
          "proof_status": {
            "type": "string"
          },
          "affected_person_gap": {
            "type": "string"
          },
          "minimum_next_receipts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk_if_missing": {
            "type": "string"
          },
          "proof_floor": {
            "type": "string"
          },
          "denominator_gap": {
            "type": "string"
          },
          "closure_blocker_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "can_close_gap": {
            "type": "boolean"
          },
          "closure_rule": {
            "type": "string"
          },
          "material_outcome_dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "field_sample_requirement": {
            "type": "string"
          },
          "source_receipt_level": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "closure_policy": {
      "type": "string"
    },
    "proof_floor_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
