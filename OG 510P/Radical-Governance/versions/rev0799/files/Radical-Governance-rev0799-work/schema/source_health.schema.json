{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Radical Governance source-health ledger",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "health_role",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "radical-governance-source-health-v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "health_role": {
      "type": "string"
    },
    "review_date": {
      "type": "string"
    },
    "default_policy": {
      "type": "object"
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "source_class",
          "publisher_class",
          "jurisdiction",
          "expected_volatility",
          "health_status"
        ],
        "properties": {
          "source_class": {
            "type": "string"
          },
          "publisher_class": {
            "type": "string"
          },
          "jurisdiction": {
            "type": "string"
          },
          "expected_volatility": {
            "type": "string"
          },
          "first_added_revision": {
            "type": "string"
          },
          "last_checked": {
            "type": "string"
          },
          "check_method": {
            "type": "string"
          },
          "retrieval_result": {
            "type": "string"
          },
          "health_status": {
            "type": "string"
          },
          "redirect_target": {
            "type": "string"
          },
          "content_fingerprint": {
            "type": "string"
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "superseded_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fallback_source_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_cadence_days": {
            "type": "integer"
          },
          "risk_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
