{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Radical Governance applied case-packet matrix input",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "radical-governance-case-packets-v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "matrix_role": {
      "type": "string"
    },
    "dispatcher_file": {
      "type": "string"
    },
    "chain_notes": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "cases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "file",
          "case_label",
          "form_verdict",
          "form_family",
          "thickness",
          "live_chain_notes",
          "reserved_notes",
          "repair_surfaces",
          "source_keys"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "case_label": {
            "type": "string"
          },
          "form_verdict": {
            "type": "string"
          },
          "form_family": {
            "type": "string"
          },
          "thickness": {
            "type": "string"
          },
          "trigger_type": {
            "type": "string"
          },
          "lower_form_result": {
            "type": "string"
          },
          "live_chain_notes": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "reserved_notes": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "repair_surfaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "upgrade_triggers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "downshift_or_handback_triggers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "anti_theater_core": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
