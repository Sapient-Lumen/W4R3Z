{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/radical-governance/tail_sampling_gates.schema.json",
  "title": "Radical Governance tail sampling gates",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "gate_role",
    "privacy_posture",
    "closure_policy",
    "gates"
  ],
  "properties": {
    "schema": {"const": "radical-governance-tail-sampling-gates-v1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "gate_role": {"type": "string"},
    "privacy_posture": {"type": "string"},
    "closure_policy": {"type": "string"},
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "gate_label",
          "outcome_tail_plan",
          "linked_gaps",
          "linked_source_claim_receipts",
          "gate_status",
          "target_population",
          "sampling_frame",
          "material_fields",
          "cohort_requirements",
          "nonresponse_bias_plan",
          "fieldwork_controls",
          "material_followup_windows",
          "privacy_controls",
          "source_preservation_controls",
          "cannot_store",
          "disqualifiers",
          "closure_blocker",
          "next_action"
        ],
        "properties": {
          "gate_label": {"type": "string"},
          "outcome_tail_plan": {"type": "string"},
          "linked_gaps": {"type": "array", "items": {"type": "string"}},
          "linked_source_claim_receipts": {"type": "array", "items": {"type": "string"}},
          "gate_status": {"type": "string"},
          "target_population": {"type": "string"},
          "sampling_frame": {"type": "string"},
          "material_fields": {"type": "array", "items": {"type": "string"}},
          "cohort_requirements": {"type": "array", "items": {"type": "object"}},
          "nonresponse_bias_plan": {"type": "string"},
          "fieldwork_controls": {"type": "array", "items": {"type": "string"}},
          "material_followup_windows": {"type": "array", "items": {"type": "string"}},
          "privacy_controls": {"type": "array", "items": {"type": "string"}},
          "source_preservation_controls": {"type": "array", "items": {"type": "string"}},
          "cannot_store": {"type": "array", "items": {"type": "string"}},
          "disqualifiers": {"type": "array", "items": {"type": "string"}},
          "closure_blocker": {"type": "string"},
          "next_action": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
