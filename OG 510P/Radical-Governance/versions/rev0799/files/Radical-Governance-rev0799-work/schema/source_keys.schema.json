{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Radical Governance source-key registry",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "keys"
  ],
  "properties": {
    "schema": {
      "const": "radical-governance-source-keys-v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "registry_role": {
      "type": "string"
    },
    "keys": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "publisher",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
