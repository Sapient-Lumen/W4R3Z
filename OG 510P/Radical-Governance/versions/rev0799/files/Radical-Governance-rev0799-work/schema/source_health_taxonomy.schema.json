{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/radical-governance/source_health_taxonomy.schema.json",
  "title": "Radical Governance source-health taxonomy aliases",
  "type": "object",
  "required": ["schema", "revision", "taxonomy_role", "default_labels", "fields"],
  "properties": {
    "schema": {"const": "radical-governance-source-health-taxonomy-v1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "taxonomy_role": {"type": "string"},
    "default_labels": {"type": "object"},
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["description", "match_any"],
          "properties": {
            "description": {"type": "string"},
            "match_any": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        }
      }
    }
  },
  "additionalProperties": true
}
