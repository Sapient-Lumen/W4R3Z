{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/radical-governance/outcome_tail_plans.schema.json",
  "title": "Radical Governance outcome-tail sampling plans",
  "type": "object",
  "required": ["schema", "revision", "plan_role", "privacy_posture", "plans"],
  "properties": {
    "schema": {"const": "radical-governance-outcome-tail-plans-v1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "plan_role": {"type": "string"},
    "privacy_posture": {"type": "string"},
    "plans": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["case_family", "linked_gaps", "linked_evidence_receipts", "linked_source_claim_receipts", "archive_notes", "closure_floor", "cohorts", "outcome_tail_fields", "not_allowed_to_store", "first_next_action", "closure_blocker"],
        "properties": {
          "case_family": {"type": "string"},
          "linked_gaps": {"type": "array", "items": {"type": "string"}},
          "linked_evidence_receipts": {"type": "array", "items": {"type": "string"}},
          "linked_source_claim_receipts": {"type": "array", "items": {"type": "string"}},
          "archive_notes": {"type": "array", "items": {"type": "integer"}},
          "closure_floor": {"type": "string"},
          "cohorts": {"type": "array", "items": {"type": "object"}},
          "outcome_tail_fields": {"type": "array", "items": {"type": "string"}},
          "not_allowed_to_store": {"type": "array", "items": {"type": "string"}},
          "first_next_action": {"type": "string"},
          "closure_blocker": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
