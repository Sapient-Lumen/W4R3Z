{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity archive invariants",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "purpose",
    "invariants"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "statement",
          "anchor_surfaces",
          "checked_by"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^INV-\\d{4}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "anchor_surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checked_by": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
