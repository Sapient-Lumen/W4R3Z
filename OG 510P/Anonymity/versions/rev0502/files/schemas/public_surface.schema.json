{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity public surface",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "entry_points",
    "canonical_context",
    "principles",
    "current_public_citation_heads",
    "repo_frozen_noncanonical_entries"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "owner": {
      "type": "string",
      "const": "published/"
    },
    "entry_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "canonical_context": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "current_public_citation_heads": {
      "type": "array"
    },
    "repo_frozen_noncanonical_entries": {
      "type": "array"
    }
  }
}
