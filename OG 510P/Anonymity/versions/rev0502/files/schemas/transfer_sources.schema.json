{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compared datacube transfer sources",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_for_revision",
    "compared_against_primary_revision",
    "purpose",
    "source_bundle_count",
    "status_counts",
    "source_bundles"
  ],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "compared_against_primary_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "purpose": {"type": "string", "minLength": 1},
    "source_bundle_count": {"type": "integer", "minimum": 0},
    "status_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adopted_pattern", "reviewed_no_strong_transfer"],
      "properties": {
        "adopted_pattern": {"type": "integer", "minimum": 0},
        "reviewed_no_strong_transfer": {"type": "integer", "minimum": 0}
      }
    },
    "source_bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project", "source_revision", "bundle", "sha256", "transfer_status", "notes"],
        "properties": {
          "project": {"type": "string", "minLength": 1},
          "source_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
          "bundle": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "transfer_status": {"enum": ["adopted_pattern", "reviewed_no_strong_transfer"]},
          "notes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
