{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity latest decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "generated_for_revision",
    "decision_id",
    "path",
    "date",
    "heading",
    "action_class",
    "kind",
    "publication_action",
    "summary"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "owner": {
      "type": "string",
      "const": "release_queue/"
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "pattern": "^release_queue/decisions/.+\\.md$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
    },
    "time_hint": {
      "type": "string"
    },
    "heading": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "state_before": {
      "type": "string"
    },
    "state_after": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "follow_up_needed": {
      "type": "string"
    },
    "action_class": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "publication_action": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
