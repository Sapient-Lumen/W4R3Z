{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archive budget and hygiene policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "max_total_bytes",
    "max_file_count",
    "max_root_file_count",
    "max_report_file_count",
    "max_schema_file_count",
    "forbidden_series_render_dir_regex",
    "allowed_review_render_prefixes",
    "rationale"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "max_total_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_file_count": {
      "type": "integer",
      "minimum": 1
    },
    "max_root_file_count": {
      "type": "integer",
      "minimum": 1
    },
    "max_report_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_schema_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "forbidden_series_render_dir_regex": {
      "type": "string",
      "minLength": 1
    },
    "allowed_review_render_prefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
