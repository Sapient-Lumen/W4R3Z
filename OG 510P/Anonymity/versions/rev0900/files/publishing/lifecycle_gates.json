{
  "version": 1,
  "owner": "publishing/",
  "fail_closed_rule": "If a required gate is failing or stale, default to no publication until the gate surfaces agree again.",
  "gates": [
    {
      "gate_id": "reentry_identity_and_trust",
      "stage": "reentry",
      "purpose": "Confirm which bundle this is and whether the compact trust surfaces currently agree.",
      "required_surfaces": [
        "VERSION",
        "RELEASE_MANIFEST.json",
        "REVISION_RECEIPT.json",
        "START_HERE.md",
        "CONTEXT_PACK.json",
        "reports/archive_surface_coherence.json",
        "reports/transient_surface_audit.json",
        "reports/manifest_sha256_verification.json",
        "reports/operator_command_hygiene.json",
        "reports/manifest_canonicality.json",
        "reports/toolchain_fingerprint.json"
      ],
      "default_when_not_satisfied": "stop and repair bundle identity / trust surfaces before relying on them"
    },
    {
      "gate_id": "citation_and_public_boundary",
      "stage": "public-boundary",
      "purpose": "Answer what is publicly citable, what legacy links remain canonical, and what is merely frozen in-repo.",
      "required_surfaces": [
        "published/CITATION_HEADS.md",
        "published/citation_heads.json",
        "published/LEGACY_PUBLISHED_LINKS.md",
        "published/legacy_published_links.json",
        "published/PUBLICATION_CLASSIFICATION.md",
        "published/publication_classification.json",
        "published/PUBLIC_SURFACE.json",
        "reports/publication_boundary.json",
        "publishing/check_publication_boundary.py"
      ],
      "default_when_not_satisfied": "treat the public boundary as unresolved and publish nothing"
    },
    {
      "gate_id": "queue_and_decision_integrity",
      "stage": "queue",
      "purpose": "Trust queue counts, queue states, and the current decision lineage without crawling the directory tree by hand.",
      "required_surfaces": [
        "release_queue/QUEUE_INDEX.json",
        "release_queue/REVIEW_INVENTORY.json",
        "release_queue/LATEST_DECISION.md",
        "release_queue/DECISION_INDEX.json",
        "release_queue/DECISION_INDEX.md",
        "reports/review_inventory_integrity.json"
      ],
      "default_when_not_satisfied": "do not move papers between Hold / Candidate / Published-ready / Published"
    },
    {
      "gate_id": "review_move_readiness",
      "stage": "paper-review",
      "purpose": "Review or move a paper only with the actual rubric, review order, and written-decision discipline in hand.",
      "required_surfaces": [
        "publishing/REVIEW_ORDER.md",
        "publishing/REVIEW_RUBRIC.md",
        "publishing/TURN_DECISION_PROTOCOL.md",
        "release_queue/QUEUE.md",
        "release_queue/STATUS.md"
      ],
      "default_when_not_satisfied": "record no move and leave the queue unchanged"
    },
    {
      "gate_id": "publication_execution",
      "stage": "publish",
      "purpose": "Execute an actual release only after a narrow explicit publish decision and preflight pass exist.",
      "required_surfaces": [
        "PUBLISHING.md",
        "publishing/CONSERVATIVE_RELEASE_POLICY.md",
        "publishing/RELEASE_FLOW.md",
        "publishing/release_preflight.py",
        "release_queue/LATEST_DECISION.md",
        "published/PUBLIC_SURFACE.json",
        "release_queue/FREEZE_PACKET_REGISTRY.json",
        "reports/freeze_packet_integrity.json",
        "reports/publication_boundary.json",
        "publishing/create_published_entry.py",
        "reports/tex_source_safety.json",
        "reports/secret_material_quarantine.json",
        "reports/makefile_target_integrity.json",
        "reports/manifest_canonicality.json",
        "reports/freeze_warning_resolution.json",
        "reports/toolchain_fingerprint.json"
      ],
      "default_when_not_satisfied": "no publication"
    },
    {
      "gate_id": "post_publication_audit",
      "stage": "post-publish",
      "purpose": "After any new public release, verify the published-facing boundary, citation heads, and archive trust surfaces again.",
      "required_surfaces": [
        "published/CITATION_HEADS.md",
        "published/PUBLIC_SURFACE.json",
        "published/INDEX.md",
        "reports/archive_surface_coherence.json",
        "reports/manifest_sha256_verification.json",
        "MANIFEST.sha256",
        "reports/publication_boundary.json",
        "published/publication_classification.json",
        "reports/manifest_canonicality.json"
      ],
      "default_when_not_satisfied": "treat the post-publish audit as incomplete and avoid further release actions"
    }
  ]
}
