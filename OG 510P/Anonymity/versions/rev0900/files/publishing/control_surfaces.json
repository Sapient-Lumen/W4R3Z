  "precedence_rule": [
    "citation questions -> published/CITATION_HEADS.md",
    "public-vs-frozen boundary -> published/PUBLICATION_CLASSIFICATION.md",
    "queue state -> release_queue/QUEUE_INDEX.json",
    "latest no-release/publish rationale -> release_queue/LATEST_DECISION.md",
    "stage-specific control-surface question -> reports/lifecycle_gate_status.json then publishing/LIFECYCLE_GATES.md",
    "cross-datacube transfer question -> DATACUBE_TRANSFER_LEDGER.md",
    "release-readiness and source-hash-binding questions -> reports/release_readiness_audit.json, then publishing/release_preflight.py for a single selected source",
    "citation-closure questions -> reports/citation_closure_audit.json, then publishing/check_citation_closure.py",
    "research-object metadata/provenance questions -> reports/research_metadata_integrity.json, then ro-crate-metadata.json and release_provenance.intoto.jsonl",
    "review-inventory source identity questions -> reports/review_inventory_integrity.json, then release_queue/REVIEW_INVENTORY.json",
    "operator quick-check side-effect questions -> reports/operator_command_hygiene.json, then START_HERE.md / CONTEXT_PACK.json",
    "review-inventory coverage questions -> reports/review_inventory_coverage.json, then release_queue/REVIEW_INVENTORY.json",
    "evidence-pack gate questions -> reports/evidence_pack_audit.json, then release_queue/NEXT_RELEASE_FREEZE_PLAN.json",
    "next-release dry-run questions -> release_queue/NEXT_RELEASE_FREEZE_PLAN.md, then release_queue/NEXT_RELEASE_FREEZE_PLAN.json",
    "evidence-pack attachment questions -> reports/evidence_pack_integrity.json, then release_queue/EVIDENCE_PACK_REGISTRY.json",
    "clean-compile freeze questions -> reports/freeze_compile_witness.json, then release_queue/FREEZE_COMPILE_WITNESS.json",
    "freeze-packet staging questions -> reports/freeze_packet_integrity.json, then release_queue/FREEZE_PACKET_REGISTRY.json",
    "published-boundary guard questions -> reports/publication_boundary.json, then published/publication_classification.json and published/citation_heads.json",
    "exact shipped revision / integrity / drift questions -> VERSION, RELEASE_MANIFEST.json, REVISION_RECEIPT.json, reports/archive_surface_coherence.json, reports/context_pack_contract.json, reports/archive_budget.json, reports/transient_surface_audit.json, reports/manifest_sha256_verification.json, reports/manifest_coverage_audit.json, MANIFEST.sha256",
    "machine-report identity questions -> reports/report_identity_coverage.json, then publishing/check_report_identity_coverage.py",
    "publication artifact quarantine questions -> reports/publication_artifact_quarantine.json, then publishing/check_publication_artifact_quarantine.py",
    "queue note source-hash questions -> reports/queue_note_source_binding.json, then release_queue/QUEUE_INDEX.json and the specific queue note",
    "invariant catalog / Markdown mirror questions -> reports/invariant_catalog_integrity.json, then publishing/archive_invariants.json",
    "local path leakage questions -> reports/content_leakage.json, then publishing/check_content_leakage.py",
    "decision-ledger questions -> reports/decision_note_integrity.json, then release_queue/DECISION_INDEX.json and the specific decision note",
    "reports/unicode_control_hygiene.json"
  ]
}
