{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Queue note source binding report",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "checked_states", "rows", "summary", "failures", "fail_closed_rule"],
  "properties": {
    "status": {"enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "checked_bundle": {"type": "string"},
    "publication_authorized": {"const": false},
    "checked_states": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "array", "items": {"type": "object"}},
    "duplicate_source_bindings": {"type": "array"},
    "missing_from_queue_index": {"type": "array", "items": {"type": "string"}},
    "missing_from_directories": {"type": "array", "items": {"type": "string"}},
    "summary": {
      "type": "object",
      "required": ["queue_note_count", "queue_note_pass_count", "queue_note_fail_count", "duplicate_source_binding_count", "failure_count"],
      "properties": {
        "queue_note_count": {"type": "integer", "minimum": 0},
        "queue_note_pass_count": {"type": "integer", "minimum": 0},
        "queue_note_fail_count": {"type": "integer", "minimum": 0},
        "state_counts": {"type": "object"},
        "directory_note_counts": {"type": "object"},
        "duplicate_source_binding_count": {"type": "integer", "minimum": 0},
        "missing_from_queue_index_count": {"type": "integer", "minimum": 0},
        "missing_from_directory_count": {"type": "integer", "minimum": 0},
        "failure_count": {"type": "integer", "minimum": 0},
        "failure_category_counts": {"type": "object"}
      },
      "additionalProperties": true
    },
    "failures": {"type": "array"},
    "fail_closed_rule": {"type": "string"}
  },
  "additionalProperties": true
}
