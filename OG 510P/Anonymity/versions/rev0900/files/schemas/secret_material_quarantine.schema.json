{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Secret material quarantine report",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "policy", "findings", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"const": "pass"},
    "generated_for_revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "checked_bundle": {"type": "string"},
    "publication_authorized": {"const": false},
    "policy": {"type": "object"},
    "findings": {"type": "array", "maxItems": 0},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "text_surface_count", "finding_count", "private_key_marker_count", "token_like_pattern_count"],
      "properties": {
        "checks_failed": {"const": 0},
        "text_surface_count": {"type": "integer", "minimum": 0},
        "finding_count": {"const": 0},
        "private_key_marker_count": {"const": 0},
        "token_like_pattern_count": {"const": 0},
        "category_counts": {"type": "object"}
      },
      "additionalProperties": true
    },
    "fail_closed_rule": {"type": "string"}
  },
  "additionalProperties": true
}
