{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Citation closure audit report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "status",
    "generated_for_revision",
    "checked_bundle",
    "scope",
    "paper_count",
    "papers",
    "global_citation_graph",
    "summary",
    "fail_closed_rule"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "checked_bundle": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "paper_count": {
      "type": "integer",
      "minimum": 0
    },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "path",
          "sha256",
          "queue_states",
          "status",
          "blocker_count",
          "blockers",
          "citation_key_count",
          "bibliography_key_count",
          "reference_key_count",
          "label_count",
          "malformed_bibliography_command_count"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "queue_states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "blocker_count": {
            "type": "integer",
            "minimum": 0
          },
          "blockers": {
            "type": "array"
          },
          "citation_key_count": {
            "type": "integer",
            "minimum": 0
          },
          "bibliography_key_count": {
            "type": "integer",
            "minimum": 0
          },
          "reference_key_count": {
            "type": "integer",
            "minimum": 0
          },
          "label_count": {
            "type": "integer",
            "minimum": 0
          },
          "malformed_bibliography_command_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "global_citation_graph": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "citation_key_count",
        "bibliography_key_count",
        "globally_undefined_citation_count",
        "globally_undefined_citations",
        "duplicate_bibitem_key_count",
        "malformed_bibliography_command_file_count",
        "malformed_bibliography_command_count",
        "malformed_bibliography_command_sources"
      ],
      "properties": {
        "citation_key_count": {
          "type": "integer",
          "minimum": 0
        },
        "bibliography_key_count": {
          "type": "integer",
          "minimum": 0
        },
        "globally_undefined_citation_count": {
          "type": "integer",
          "minimum": 0
        },
        "globally_undefined_citations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duplicate_bibitem_key_count": {
          "type": "integer",
          "minimum": 0
        },
        "malformed_bibliography_command_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "malformed_bibliography_command_count": {
          "type": "integer",
          "minimum": 0
        },
        "malformed_bibliography_command_sources": {
          "type": "array"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "papers_checked",
        "papers_passed",
        "papers_failed",
        "blocker_category_counts",
        "globally_undefined_citation_count",
        "malformed_bibliography_command_count",
        "malformed_bibliography_command_file_count"
      ],
      "properties": {
        "papers_checked": {
          "type": "integer",
          "minimum": 0
        },
        "papers_passed": {
          "type": "integer",
          "minimum": 0
        },
        "papers_failed": {
          "type": "integer",
          "minimum": 0
        },
        "blocker_category_counts": {
          "type": "object"
        },
        "globally_undefined_citation_count": {
          "type": "integer",
          "minimum": 0
        },
        "malformed_bibliography_command_count": {
          "type": "integer",
          "minimum": 0
        },
        "malformed_bibliography_command_file_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fail_closed_rule": {
      "type": "string",
      "minLength": 1
    }
  }
}
