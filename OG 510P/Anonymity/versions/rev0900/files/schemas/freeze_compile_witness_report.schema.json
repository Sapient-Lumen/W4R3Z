{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Freeze compile witness report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "status",
    "generated_for_revision",
    "checked_bundle",
    "publication_authorized",
    "summary",
    "fail_closed_rule"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "checked_bundle": {
      "type": "string",
      "minLength": 1
    },
    "publication_authorized": {
      "const": false
    },
    "summary": {
      "type": "object",
      "required": [
        "checks_failed",
        "witness_present",
        "witness_current_revision",
        "source_bound",
        "clean_final_compile"
      ],
      "properties": {
        "checks_failed": {
          "type": "integer",
          "minimum": 0
        },
        "witness_present": {
          "type": "boolean"
        },
        "source_bound": {
          "type": "boolean"
        },
        "clean_final_compile": {
          "type": "boolean"
        },
        "witness_current_revision": {
          "type": "boolean"
        }
      }
    }
  }
}
