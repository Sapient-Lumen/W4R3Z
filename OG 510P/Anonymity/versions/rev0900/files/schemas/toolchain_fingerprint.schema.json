{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toolchain fingerprint report",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "summary", "command_fingerprints", "failures"],
  "properties": {
    "status": {"const": "pass"},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "minLength": 1},
    "publication_authorized": {"const": false},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "compile_gate_status", "fingerprint_required", "fingerprint_present"],
      "properties": {
        "checks_failed": {"const": 0},
        "compile_gate_status": {"type": "string"},
        "fingerprint_required": {"type": "boolean"},
        "fingerprint_present": {"type": "boolean"}
      }
    },
    "command_fingerprints": {"type": "array"},
    "failures": {"type": "array", "maxItems": 0}
  }
}
