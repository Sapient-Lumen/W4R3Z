{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity lifecycle gate status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_for_revision",
    "status",
    "checked_bundle",
    "publication_authorized",
    "bundle",
    "default_rule",
    "gates",
    "summary"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "bundle": {
      "type": "string",
      "pattern": "^Anonymity-rev\\d{4}-.+\\.zip$"
    },
    "default_rule": {
      "type": "string",
      "minLength": 1
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "gate_id",
          "stage",
          "status",
          "reason",
          "required_surfaces"
        ],
        "properties": {
          "gate_id": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "required_surfaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "checked_bundle": {
      "type": "string",
      "pattern": "^Anonymity-rev\\d{4}-.+\\.zip$"
    },
    "publication_authorized": {
      "type": "boolean",
      "const": false
    }
  },
  "version": 1
}
