{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity revision receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_stem",
    "revision",
    "timestamp_local",
    "focus",
    "summary",
    "borrowed_patterns",
    "changes",
    "queue_posture_after_revision",
    "publication_action"
  ],
  "properties": {
    "artifact_stem": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp_local": {
      "type": "string",
      "minLength": 1
    },
    "focus": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "borrowed_patterns": {
      "type": "array"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "queue_posture_after_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "hold",
        "published_ready",
        "published"
      ],
      "properties": {
        "candidate": {
          "type": "integer",
          "minimum": 0
        },
        "hold": {
          "type": "integer",
          "minimum": 0
        },
        "published_ready": {
          "type": "integer",
          "minimum": 0
        },
        "published": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "publication_action": {
      "type": "string"
    },
    "publication_authorized": {
      "type": "boolean"
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "bundle",
        "sha256"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^rev\\d{4}$"
        },
        "bundle": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "queue_moved": {
      "type": "boolean"
    },
    "reconciled_sibling_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "bundle",
          "sha256",
          "preserved_focus"
        ],
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^rev\\d{4}$"
          },
          "bundle": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "preserved_focus": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "published_entry": {
      "type": "string",
      "minLength": 1
    },
    "publication_receipt": {
      "type": "string",
      "minLength": 1
    },
    "decision_note": {
      "type": "string",
      "minLength": 1
    }
  }
}
