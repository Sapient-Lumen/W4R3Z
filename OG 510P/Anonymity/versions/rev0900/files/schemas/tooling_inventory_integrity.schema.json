{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity tooling inventory integrity report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "generated_for_revision",
    "checked_bundle",
    "inventory_path",
    "publication_authorized",
    "failures",
    "warnings",
    "summary",
    "fail_closed_rule"
  ],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "pattern": "^Anonymity-rev\\d{4}-.+\\.zip$"},
    "inventory_path": {"type": "string", "const": "publishing/TOOLING_INVENTORY.json"},
    "publication_authorized": {"type": "boolean", "const": false},
    "failures": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "actual_script_count", "inventory_script_count", "sha256_mismatch_count"],
      "properties": {
        "checks_failed": {"type": "integer", "minimum": 0},
        "warning_count": {"type": "integer", "minimum": 0},
        "actual_script_count": {"type": "integer", "minimum": 0},
        "inventory_script_count": {"type": "integer", "minimum": 0},
        "sha256_mismatch_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "fail_closed_rule": {"type": "string", "minLength": 1}
  }
}
