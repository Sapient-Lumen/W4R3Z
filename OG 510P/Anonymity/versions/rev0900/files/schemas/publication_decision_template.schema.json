{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication decision template report",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "template_path", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "minLength": 1},
    "publication_authorized": {"const": false},
    "template_path": {"type": "string", "const": "release_queue/PUBLICATION_DECISION_TEMPLATE.md"},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "required_fragments_present", "placeholder_count"],
      "properties": {
        "checks_failed": {"type": "integer", "minimum": 0},
        "required_fragments_present": {"type": "integer", "minimum": 0},
        "placeholder_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
