{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "revision",
    "timestamp",
    "slug",
    "bundle"
  ],
  "properties": {
    "project": {
      "const": "Anonymity"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d{2}\\.\\d{2}$"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "bundle": {
      "type": "string",
      "pattern": "^Anonymity-rev\\d{4}-\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d{2}\\.\\d{2}-.+\\.zip$"
    }
  }
}
