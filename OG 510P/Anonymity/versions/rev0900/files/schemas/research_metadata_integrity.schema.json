{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research metadata integrity report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "status",
    "generated_for_revision",
    "checked_bundle",
    "checks",
    "summary",
    "fail_closed_rule"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "checked_bundle": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name",
          "status",
          "details"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "checks_passed",
        "checks_failed",
        "metadata_file_count",
        "provenance_subject_count",
        "provenance_dependency_count"
      ],
      "properties": {
        "checks_passed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_failed": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "provenance_subject_count": {
          "type": "integer",
          "minimum": 0
        },
        "provenance_dependency_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fail_closed_rule": {
      "type": "string",
      "minLength": 1
    }
  }
}
