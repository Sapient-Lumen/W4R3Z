{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Makefile target integrity report",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "makefile", "required_phony_targets", "parsed_targets", "failures", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"const": "pass"},
    "generated_for_revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "checked_bundle": {"type": "string"},
    "publication_authorized": {"const": false},
    "makefile": {"const": "Makefile"},
    "required_phony_targets": {"type": "array", "items": {"type": "string"}},
    "parsed_targets": {"type": "object"},
    "failures": {"type": "array", "maxItems": 0},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "phony_target_count", "parsed_target_count", "command_count", "missing_phony_count", "missing_target_count", "dangerous_command_count", "unsafe_python_command_count"],
      "properties": {
        "checks_failed": {"const": 0},
        "phony_target_count": {"type": "integer", "minimum": 3},
        "parsed_target_count": {"type": "integer", "minimum": 3},
        "command_count": {"type": "integer", "minimum": 1},
        "missing_phony_count": {"const": 0},
        "missing_target_count": {"const": 0},
        "dangerous_command_count": {"const": 0},
        "unsafe_python_command_count": {"const": 0}
      },
      "additionalProperties": true
    },
    "fail_closed_rule": {"type": "string"}
  },
  "additionalProperties": true
}
