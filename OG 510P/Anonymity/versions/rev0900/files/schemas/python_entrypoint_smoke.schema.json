{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/anonymity/schemas/python_entrypoint_smoke.schema.json",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "report_kind", "scope", "summary", "failures", "results", "fail_closed_rule"],
  "properties": {
    "status": {"enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "checked_bundle": {"type": "string"},
    "publication_authorized": {"const": false},
    "report_kind": {"const": "python_entrypoint_smoke"},
    "scope": {"type": "object"},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "python_source_count", "compile_checked", "compile_failed", "entrypoint_checked", "entrypoint_failed", "non_cli_python_source_count", "cli_script_prefixes"],
      "properties": {
        "checks_failed": {"type": "integer", "minimum": 0},
        "python_source_count": {"type": "integer", "minimum": 0},
        "compile_checked": {"type": "integer", "minimum": 0},
        "compile_failed": {"type": "integer", "minimum": 0},
        "entrypoint_checked": {"type": "integer", "minimum": 0},
        "entrypoint_failed": {"type": "integer", "minimum": 0},
        "non_cli_python_source_count": {"type": "integer", "minimum": 0},
        "cli_script_prefixes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "failures": {"type": "array", "items": {"type": "object"}},
    "results": {"type": "array", "items": {"type": "object"}},
    "fail_closed_rule": {"type": "string"}
  },
  "additionalProperties": true
}
