{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worked-example validation report",
  "type": "object",
  "additionalProperties": true,
  "required": ["validation_report_id", "claim_id", "release_id", "note_version", "ok", "checks"],
  "properties": {
    "validation_report_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "note_version": {"type": "string", "minLength": 1},
    "support_manifest_id": {"type": "string"},
    "artifact_inventory_id": {"type": "string"},
    "ok": {"type": "boolean"},
    "warnings": {"type": "array"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "ok", "detail"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "ok": {"type": "boolean"},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
