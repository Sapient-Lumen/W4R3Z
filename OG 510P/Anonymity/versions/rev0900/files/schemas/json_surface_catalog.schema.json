{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity JSON surface catalog report",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "schema_target_source", "json_surfaces", "failures", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "pattern": "^Anonymity-rev\\d{4}-.+\\.zip$"},
    "publication_authorized": {"type": "boolean", "const": false},
    "schema_target_source": {"type": "string"},
    "json_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "category", "coverage", "schema_checked", "status"],
        "properties": {
          "path": {"type": "string"},
          "category": {"type": "string"},
          "coverage": {"type": "string"},
          "schema_checked": {"type": "boolean"},
          "status": {"type": "string", "enum": ["pass", "fail"]}
        },
        "additionalProperties": true
      }
    },
    "failures": {"type": "array"},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "json_file_count", "schema_checked_json_count", "json_schema_document_count", "unclassified_json_count", "category_counts"],
      "properties": {
        "checks_failed": {"type": "integer", "minimum": 0},
        "json_file_count": {"type": "integer", "minimum": 0},
        "schema_checked_json_count": {"type": "integer", "minimum": 0},
        "json_schema_document_count": {"type": "integer", "minimum": 0},
        "validator_or_registry_classified_count": {"type": "integer", "minimum": 0},
        "unclassified_json_count": {"type": "integer", "minimum": 0},
        "category_counts": {"type": "object"}
      },
      "additionalProperties": true
    },
    "fail_closed_rule": {"type": "string"}
  }
}
