{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schema catalog integrity report",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "schema_directory", "schema_target_source", "schema_rows", "referenced_schemas", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "checked_bundle": {"type": "string"},
    "publication_authorized": {"const": false},
    "schema_directory": {"type": "string"},
    "schema_target_source": {"type": "string"},
    "schema_rows": {"type": "array", "items": {"type": "object", "required": ["schema", "status"], "properties": {"schema": {"type": "string"}, "status": {"enum": ["pass", "fail"]}}, "additionalProperties": true}},
    "referenced_schemas": {"type": "array", "items": {"type": "string"}},
    "unreferenced_schema_paths": {"type": "array", "items": {"type": "string"}},
    "failures": {"type": "array"},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "schema_document_count", "referenced_schema_count", "missing_referenced_schema_count", "unreferenced_schema_count", "target_binding_count", "expected_meta_schema", "generic_report_schema_present"],
      "properties": {
        "checks_failed": {"type": "integer", "minimum": 0},
        "schema_document_count": {"type": "integer", "minimum": 0},
        "referenced_schema_count": {"type": "integer", "minimum": 0},
        "missing_referenced_schema_count": {"type": "integer", "minimum": 0},
        "unreferenced_schema_count": {"type": "integer", "minimum": 0},
        "target_binding_count": {"type": "integer", "minimum": 0},
        "expected_meta_schema": {"type": "string"},
        "generic_report_schema_present": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "fail_closed_rule": {"type": "string"}
  },
  "additionalProperties": true
}
