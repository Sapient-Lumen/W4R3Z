{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unicode/control-character hygiene report",
  "type": "object",
  "required": [
    "status",
    "generated_for_revision",
    "checked_bundle",
    "publication_authorized",
    "unicode_control_policy",
    "text_suffixes",
    "text_names",
    "findings",
    "summary",
    "fail_closed_rule"
  ],
  "properties": {
    "status": {
      "enum": ["pass", "fail"]
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "checked_bundle": {
      "type": "string"
    },
    "publication_authorized": {
      "const": false
    },
    "unicode_control_policy": {
      "type": "object",
      "required": ["allowed_ascii_controls", "forbidden_categories", "findings_do_not_echo_matched_text"],
      "properties": {
        "allowed_ascii_controls": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_categories": {
          "type": "array",
          "items": {"type": "string"}
        },
        "findings_do_not_echo_matched_text": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "text_suffixes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "text_names": {
      "type": "array",
      "items": {"type": "string"}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "column": {"type": "integer", "minimum": 1},
          "offset": {"type": "integer", "minimum": 0},
          "category": {"type": "string"},
          "codepoint": {"type": "string", "pattern": "^U\\+[0-9A-F]{4,6}$"},
          "unicode_category": {"type": "string"},
          "unicode_name": {"type": "string"},
          "detail": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "checks_failed",
        "text_surface_count",
        "codepoints_scanned",
        "finding_count",
        "c0_or_del_control_count",
        "c1_control_count",
        "bidi_control_count",
        "invisible_format_control_count",
        "unicode_noncharacter_count",
        "category_counts"
      ],
      "properties": {
        "checks_failed": {"type": "integer", "minimum": 0},
        "text_surface_count": {"type": "integer", "minimum": 0},
        "codepoints_scanned": {"type": "integer", "minimum": 0},
        "finding_count": {"type": "integer", "minimum": 0},
        "c0_or_del_control_count": {"type": "integer", "minimum": 0},
        "c1_control_count": {"type": "integer", "minimum": 0},
        "bidi_control_count": {"type": "integer", "minimum": 0},
        "invisible_format_control_count": {"type": "integer", "minimum": 0},
        "unicode_noncharacter_count": {"type": "integer", "minimum": 0},
        "category_counts": {"type": "object"}
      },
      "additionalProperties": true
    },
    "fail_closed_rule": {"type": "string"}
  },
  "additionalProperties": true
}
