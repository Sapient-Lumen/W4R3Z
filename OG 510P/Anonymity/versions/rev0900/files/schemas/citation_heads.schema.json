{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity citation heads",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "current_public_citation_heads",
    "repo_frozen_noncanonical_entries",
    "new_post_policy_anonymity_heads",
    "operator_warnings",
    "summary"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "owner": {
      "type": "string",
      "const": "published/"
    },
    "current_public_citation_heads": {
      "type": "array"
    },
    "repo_frozen_noncanonical_entries": {
      "type": "array"
    },
    "new_post_policy_anonymity_heads": {
      "type": "array"
    },
    "operator_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_public_head_count",
        "new_post_policy_anonymity_head_count",
        "repo_frozen_noncanonical_entry_count",
        "ambiguous_public_head_count",
        "decision_required_before_new_anonymity_head_exists"
      ],
      "properties": {
        "legacy_public_head_count": {
          "type": "integer",
          "minimum": 0
        },
        "new_post_policy_anonymity_head_count": {
          "type": "integer",
          "minimum": 0
        },
        "repo_frozen_noncanonical_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous_public_head_count": {
          "type": "integer",
          "minimum": 0
        },
        "decision_required_before_new_anonymity_head_exists": {
          "type": "boolean"
        }
      }
    }
  }
}
