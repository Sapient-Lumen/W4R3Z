{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Freeze toolchain status",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "status",
    "generated_for_revision",
    "checked_bundle",
    "publication_authorized",
    "toolchain_gate_status",
    "commands",
    "summary"
  ],
  "properties": {
    "status": {
      "const": "pass"
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "checked_bundle": {
      "type": "string",
      "minLength": 1
    },
    "publication_authorized": {
      "const": false
    },
    "toolchain_gate_status": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "version_output_sha256": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object"
    }
  }
}
