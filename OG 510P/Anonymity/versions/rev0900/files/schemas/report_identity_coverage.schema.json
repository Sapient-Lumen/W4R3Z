{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity report identity coverage report",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "report_directory", "reports", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "pattern": "^Anonymity-rev\\d{4}-.+\\.zip$"},
    "publication_authorized": {"type": "boolean", "const": false},
    "report_directory": {"type": "string", "const": "reports"},
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "status", "revision_values", "bundle_values", "failures"],
        "properties": {
          "path": {"type": "string", "pattern": "^reports/.+\\.json$"},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "report_status": {},
          "revision_values": {"type": "array", "items": {"type": "string"}},
          "bundle_values": {"type": "array", "items": {"type": "string"}},
          "publication_authorized": {},
          "failures": {"type": "array"}
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": ["checks_failed", "report_json_count", "identity_bound_report_count"],
      "properties": {
        "checks_failed": {"type": "integer", "minimum": 0},
        "report_json_count": {"type": "integer", "minimum": 0},
        "identity_bound_report_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "failures": {"type": "array"},
    "fail_closed_rule": {"type": "string"}
  }
}
