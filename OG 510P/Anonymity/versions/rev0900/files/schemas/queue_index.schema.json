{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity queue index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "generated_for_revision",
    "latest_decision",
    "summary",
    "states",
    "notes"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "owner": {
      "type": "string",
      "const": "release_queue/"
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "latest_decision": {
      "type": "string",
      "pattern": "^release_queue/decisions/.+\\.md$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "hold",
        "published_ready",
        "published",
        "reviewable_unpublished_papers",
        "standalone_series_review_first",
        "synthesis_foundation_review_later",
        "synthesis_tail_defer_high_churn"
      ],
      "properties": {
        "candidate": {
          "type": "integer",
          "minimum": 0
        },
        "hold": {
          "type": "integer",
          "minimum": 0
        },
        "published_ready": {
          "type": "integer",
          "minimum": 0
        },
        "published": {
          "type": "integer",
          "minimum": 0
        },
        "reviewable_unpublished_papers": {
          "type": "integer",
          "minimum": 0
        },
        "standalone_series_review_first": {
          "type": "integer",
          "minimum": 0
        },
        "synthesis_foundation_review_later": {
          "type": "integer",
          "minimum": 0
        },
        "synthesis_tail_defer_high_churn": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "hold",
        "published_ready",
        "published"
      ],
      "properties": {
        "candidate": {
          "type": "array"
        },
        "hold": {
          "type": "array"
        },
        "published_ready": {
          "type": "array"
        },
        "published": {
          "type": "array"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
