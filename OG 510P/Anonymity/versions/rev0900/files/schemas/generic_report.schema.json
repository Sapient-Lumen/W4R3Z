{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity generic machine-report floor",
  "description": "A permissive floor for report JSON surfaces that do not yet have a bespoke schema. It keeps them schema-visible while allowing their specialized shape to mature later.",
  "type": "object",
  "minProperties": 2,
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail", "not_ready_pending_compile_refresh_and_manual_gates", "dry_run_pass_pending_manual_gates"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string"},
    "bundle": {"type": "string"},
    "publication_authorized": {"type": "boolean"},
    "checks": {"type": "array"},
    "gates": {"type": "array"},
    "summary": {"type": "object"},
    "fail_closed_rule": {"type": "string"},
    "default_rule": {"type": "string"}
  },
  "additionalProperties": true,
  "anyOf": [
    {"required": ["status"]},
    {"required": ["generated_for_revision"]},
    {"required": ["checked_revision"]},
    {"required": ["version"]}
  ]
}
