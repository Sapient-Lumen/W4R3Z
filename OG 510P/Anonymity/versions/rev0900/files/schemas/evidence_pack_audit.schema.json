{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-pack policy audit report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "status",
    "generated_for_revision",
    "publication_authorized",
    "policy",
    "items",
    "summary",
    "next_release_evidence_gate",
    "fail_closed_rule"
  ],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "publication_authorized": {"type": "boolean", "const": false},
    "policy": {"type": "object"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "item_id",
          "queue_state",
          "source_tex",
          "title",
          "artifact_governance_likely",
          "freeze_gate_status",
          "required_freeze_resolution"
        ],
        "properties": {
          "item_id": {"type": "string"},
          "queue_state": {"type": "string"},
          "source_tex": {"type": "string"},
          "title": {"type": "string"},
          "artifact_governance_likely": {"type": "boolean"},
          "freeze_gate_status": {"type": "string"},
          "required_freeze_resolution": {"type": "string"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "checked_item_count",
        "artifact_governance_likely_count",
        "missing_evidence_warning_count",
        "freeze_gate_required_if_selected_count"
      ],
      "properties": {
        "checked_item_count": {"type": "integer", "minimum": 0},
        "artifact_governance_likely_count": {"type": "integer", "minimum": 0},
        "missing_evidence_warning_count": {"type": "integer", "minimum": 0},
        "freeze_gate_required_if_selected_count": {"type": "integer", "minimum": 0}
      }
    },
    "next_release_evidence_gate": {"type": "object"},
    "fail_closed_rule": {"type": "string", "minLength": 1}
  }
}
