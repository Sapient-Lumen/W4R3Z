{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence pack manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "evidence_pack_id", "generated_for_revision", "checked_bundle", "publication_authorized", "source_tex", "source_sha256", "pack_paths"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "evidence_pack_id": {"type": "string", "minLength": 1},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "minLength": 1},
    "publication_authorized": {"const": false},
    "source_tex": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pack_paths": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "role", "sha256"], "properties": {"path": {"type":"string"}, "role": {"type":"string"}, "sha256": {"type":"string", "pattern":"^[0-9a-f]{64}$"}}}}
  }
}
