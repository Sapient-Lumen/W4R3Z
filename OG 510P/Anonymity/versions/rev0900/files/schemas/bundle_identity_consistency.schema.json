{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bundle identity consistency report",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "identity_contract", "checks", "summary"],
  "properties": {
    "status": {"const": "pass"},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string"},
    "publication_authorized": {"const": false},
    "identity_contract": {"type": "object"},
    "checks": {"type": "array", "items": {"type": "object"}},
    "failures": {"type": "array"},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "identity_surface_count"],
      "properties": {
        "checks_failed": {"const": 0},
        "identity_surface_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "fail_closed_rule": {"type": "string"}
  },
  "additionalProperties": true
}
