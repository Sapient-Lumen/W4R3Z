{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invariant catalog integrity report",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "catalog", "markdown", "archive_invariants_report", "checks", "summary", "failures", "fail_closed_rule"],
  "properties": {
    "status": {"enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "checked_bundle": {"type": "string"},
    "publication_authorized": {"const": false},
    "catalog": {"type": "string"},
    "markdown": {"type": "string"},
    "archive_invariants_report": {"type": "string"},
    "checks": {"type": "array", "items": {"type": "object", "required": ["name", "status"], "properties": {"name": {"type": "string"}, "status": {"enum": ["pass", "fail"]}}, "additionalProperties": true}},
    "summary": {
      "type": "object",
      "required": ["checks_passed", "checks_failed", "declared_invariant_count", "checked_invariant_count", "markdown_invariant_count", "duplicate_declared_id_count", "duplicate_checked_id_count"],
      "properties": {
        "checks_passed": {"type": "integer", "minimum": 0},
        "checks_failed": {"type": "integer", "minimum": 0},
        "declared_invariant_count": {"type": "integer", "minimum": 0},
        "checked_invariant_count": {"type": "integer", "minimum": 0},
        "markdown_invariant_count": {"type": "integer", "minimum": 0},
        "duplicate_declared_id_count": {"type": "integer", "minimum": 0},
        "duplicate_checked_id_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "failures": {"type": "array"},
    "fail_closed_rule": {"type": "string"}
  },
  "additionalProperties": true
}
