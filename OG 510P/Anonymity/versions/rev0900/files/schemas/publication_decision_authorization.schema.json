{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication decision authorization scan report",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "decision_scan_type", "decision_directory", "publish_decisions", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "minLength": 1},
    "publication_authorized": {"const": false},
    "decision_scan_type": {"const": "explicit_publish_authorization_scan"},
    "decision_directory": {"const": "release_queue/decisions"},
    "publish_decisions": {"type": "array"},
    "summary": {
      "type": "object",
      "required": ["decision_note_count", "publish_decision_count", "valid_publish_decision_count", "checks_failed", "ready_to_execute_guarded_publication_helper"],
      "properties": {
        "decision_note_count": {"type": "integer", "minimum": 0},
        "publish_decision_count": {"type": "integer", "minimum": 0},
        "valid_publish_decision_count": {"type": "integer", "minimum": 0},
        "checks_failed": {"type": "integer", "minimum": 0},
        "ready_to_execute_guarded_publication_helper": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "failures": {"type": "array"},
    "fail_closed_rule": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
