{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity archive index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "latest_revision",
    "revisions"
  ],
  "properties": {
    "latest_revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "date",
          "bundle",
          "summary"
        ],
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^rev\\d{4}$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "bundle": {
            "type": "string",
            "pattern": "^Anonymity-rev\\d{4}-.+\\.zip$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "publication_action": {
            "type": "string",
            "enum": [
              "none",
              "publish",
              "no publication",
              "no publication; no queue movement",
              "published"
            ]
          }
        }
      }
    }
  }
}
