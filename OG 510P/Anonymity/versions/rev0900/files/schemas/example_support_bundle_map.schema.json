{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worked-example support bundle map",
  "type": "object",
  "additionalProperties": true,
  "required": ["bundle_map_id", "claim_id", "bundles"],
  "properties": {
    "bundle_map_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "note": {"type": "string"},
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["bundle_id", "consumed_by", "required_artifacts", "support_pointers", "resolved_owner_map_row_names", "resolved_owner_map_rows"],
        "properties": {
          "bundle_id": {"type": "string", "pattern": "^bundle://"},
          "consumed_by": {"type": "array", "items": {"type": "string"}},
          "required_artifacts": {"type": "array", "items": {"type": "string"}},
          "support_pointers": {"type": "array", "items": {"type": "string"}},
          "resolved_owner_map_row_names": {"type": "array", "items": {"type": "string"}},
          "resolved_owner_map_rows": {"type": "array", "items": {"type": "object"}},
          "resolver_multiplicity_note": {"type": "string"}
        }
      }
    }
  }
}
