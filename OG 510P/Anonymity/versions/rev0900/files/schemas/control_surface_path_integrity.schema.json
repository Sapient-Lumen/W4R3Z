{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Control surface path integrity report",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "control_surfaces_checked", "path_rows", "summary"],
  "properties": {
    "status": {"const": "pass"},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string"},
    "publication_authorized": {"const": false},
    "control_surfaces_checked": {"type": "array", "items": {"type": "string"}},
    "path_rows": {"type": "array", "items": {"type": "object"}},
    "failures": {"type": "array"},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "path_reference_count", "missing_reference_count", "nonportable_reference_count", "unsafe_reference_count"],
      "properties": {
        "checks_failed": {"const": 0},
        "path_reference_count": {"type": "integer", "minimum": 0},
        "missing_reference_count": {"const": 0},
        "nonportable_reference_count": {"const": 0},
        "unsafe_reference_count": {"const": 0}
      },
      "additionalProperties": true
    },
    "fail_closed_rule": {"type": "string"}
  },
  "additionalProperties": true
}
