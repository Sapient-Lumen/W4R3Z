{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity assurance catalog integrity report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "generated_for_revision",
    "checked_bundle",
    "publication_authorized",
    "catalog_json",
    "catalog_markdown",
    "failures",
    "warnings",
    "summary",
    "fail_closed_rule"
  ],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string"},
    "publication_authorized": {"type": "boolean"},
    "catalog_json": {"type": "string"},
    "catalog_markdown": {"type": "string"},
    "failures": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "summary": {"type": "object"},
    "fail_closed_rule": {"type": "string", "minLength": 1}
  }
}
