{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Duplicate content policy report",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "allowlisted_duplicate_groups", "duplicate_groups", "summary"],
  "properties": {
    "status": {"const": "pass"},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string"},
    "publication_authorized": {"const": false},
    "allowlisted_duplicate_groups": {"type": "array", "items": {"type": "object"}},
    "duplicate_groups": {"type": "array", "items": {"type": "object"}},
    "failures": {"type": "array"},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "duplicate_group_count", "unexpected_duplicate_group_count", "missing_allowlist_path_count"],
      "properties": {
        "checks_failed": {"const": 0},
        "duplicate_group_count": {"type": "integer", "minimum": 0},
        "unexpected_duplicate_group_count": {"const": 0},
        "missing_allowlist_path_count": {"const": 0}
      },
      "additionalProperties": true
    },
    "fail_closed_rule": {"type": "string"}
  },
  "additionalProperties": true
}
