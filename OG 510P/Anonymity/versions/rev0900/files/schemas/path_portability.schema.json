{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity path portability report",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "path_policy", "findings", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "pattern": "^Anonymity-rev\\d{4}-.+\\.zip$"},
    "publication_authorized": {"type": "boolean", "const": false},
    "checked_root": {"type": "string", "const": "."},
    "path_policy": {"type": "object"},
    "findings": {"type": "array"},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "path_count", "max_path_bytes", "max_component_bytes", "nfc_collision_count", "casefold_collision_count"],
      "properties": {
        "checks_failed": {"type": "integer", "minimum": 0},
        "path_count": {"type": "integer", "minimum": 0},
        "manifest_json_path_count": {"type": "integer", "minimum": 0},
        "manifest_sha256_path_count": {"type": "integer", "minimum": 0},
        "max_path_bytes": {"type": "integer", "minimum": 0},
        "max_component_bytes": {"type": "integer", "minimum": 0},
        "nfc_collision_count": {"type": "integer", "minimum": 0},
        "casefold_collision_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "fail_closed_rule": {"type": "string"}
  }
}
