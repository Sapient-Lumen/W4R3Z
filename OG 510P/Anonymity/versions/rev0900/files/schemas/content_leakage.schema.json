{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content leakage report",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "policy", "summary", "findings", "fail_closed_rule"],
  "properties": {
    "status": {"enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "checked_bundle": {"type": "string"},
    "publication_authorized": {"const": false},
    "policy": {"type": "object"},
    "summary": {
      "type": "object",
      "required": ["text_file_count", "non_text_file_count", "finding_count", "finding_pattern_counts", "checks_failed"],
      "properties": {
        "text_file_count": {"type": "integer", "minimum": 0},
        "non_text_file_count": {"type": "integer", "minimum": 0},
        "finding_count": {"type": "integer", "minimum": 0},
        "finding_pattern_counts": {"type": "object"},
        "checks_failed": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "findings": {"type": "array"},
    "fail_closed_rule": {"type": "string"}
  },
  "additionalProperties": true
}
