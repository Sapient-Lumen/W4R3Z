{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication boundary audit",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "minLength": 1},
    "publication_authorized": {"const": false},
    "summary": {
      "type": "object",
      "required": ["legacy_public_head_count", "repo_frozen_noncanonical_entry_count", "new_post_policy_anonymity_dir_count", "new_post_policy_anonymity_head_count", "unknown_published_tex_count", "checks_failed"],
      "properties": {
        "legacy_public_head_count": {"type": "integer", "minimum": 0},
        "repo_frozen_noncanonical_entry_count": {"type": "integer", "minimum": 0},
        "new_post_policy_anonymity_dir_count": {"type": "integer", "minimum": 0},
        "new_post_policy_anonymity_head_count": {"type": "integer", "minimum": 0},
        "unknown_published_tex_count": {"type": "integer", "minimum": 0},
        "checks_failed": {"type": "integer", "minimum": 0}
      }
    }
  }
}
