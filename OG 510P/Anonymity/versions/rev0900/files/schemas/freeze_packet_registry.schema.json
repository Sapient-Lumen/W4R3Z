{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Freeze packet registry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "generated_for_revision",
    "checked_bundle",
    "publication_authorized",
    "entries"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "checked_bundle": {
      "type": "string",
      "minLength": 1
    },
    "publication_authorized": {
      "const": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "freeze_packet_id",
          "source_tex",
          "source_sha256",
          "manifest",
          "evidence_pack_manifest",
          "compile_witness",
          "compile_witness_snapshot",
          "compile_witness_snapshot_sha256"
        ],
        "properties": {
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "manifest": {
            "type": "string",
            "minLength": 1
          },
          "compile_witness_snapshot": {
            "type": "string",
            "minLength": 1
          },
          "compile_witness_snapshot_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
