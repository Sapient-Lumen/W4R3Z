{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Text surface normalization report",
  "type": "object",
  "required": [
    "status",
    "generated_for_revision",
    "checked_bundle",
    "publication_authorized",
    "text_policy",
    "text_suffixes",
    "text_names",
    "failures",
    "warnings",
    "summary",
    "fail_closed_rule"
  ],
  "properties": {
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "checked_bundle": {
      "type": "string"
    },
    "publication_authorized": {
      "const": false
    },
    "text_policy": {
      "type": "object"
    },
    "text_suffixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "text_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failures": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    },
    "summary": {
      "type": "object",
      "required": [
        "checks_failed",
        "text_surface_count",
        "nul_byte_failure_count",
        "carriage_return_failure_count",
        "utf8_failure_count",
        "missing_final_lf_failure_count",
        "warning_count",
        "missing_final_lf_warning_count"
      ],
      "properties": {
        "checks_failed": {
          "type": "integer",
          "minimum": 0
        },
        "text_surface_count": {
          "type": "integer",
          "minimum": 0
        },
        "text_surface_total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "nul_byte_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "carriage_return_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "utf8_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_final_lf_warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "largest_text_surface": {
          "type": "object"
        },
        "missing_final_lf_failure_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "fail_closed_rule": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
