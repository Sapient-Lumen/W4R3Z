{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity context pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "project",
    "revision",
    "bundle",
    "must_read",
    "quick_checks",
    "current_posture",
    "control_surfaces",
    "operator_warnings"
  ],
  "properties": {
    "format": {
      "const": "anonymity-context-pack"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "project": {
      "const": "Anonymity"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "bundle": {
      "type": "string",
      "pattern": "^Anonymity-rev\\d{4}-.+\\.zip$"
    },
    "must_read": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "quick_checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "current_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_release_decision",
        "legacy_public_head_count",
        "new_post_policy_anonymity_head_count",
        "repo_frozen_noncanonical_entry_count",
        "queue",
        "reviewable_unpublished_papers"
      ],
      "properties": {
        "default_release_decision": {
          "type": "string"
        },
        "legacy_public_head_count": {
          "type": "integer",
          "minimum": 0
        },
        "new_post_policy_anonymity_head_count": {
          "type": "integer",
          "minimum": 0
        },
        "repo_frozen_noncanonical_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "reviewable_unpublished_papers": {
          "type": "integer",
          "minimum": 0
        },
        "queue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate",
            "published_ready",
            "hold",
            "published"
          ],
          "properties": {
            "candidate": {
              "type": "integer",
              "minimum": 0
            },
            "published_ready": {
              "type": "integer",
              "minimum": 0
            },
            "hold": {
              "type": "integer",
              "minimum": 0
            },
            "published": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "control_surfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "operator_warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
