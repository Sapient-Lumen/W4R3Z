{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worked-example artifact inventory",
  "type": "object",
  "additionalProperties": true,
  "required": ["inventory_id", "claim_id", "groups"],
  "properties": {
    "inventory_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "release_id": {"type": "string"},
    "note_version": {"type": "string"},
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["group", "visibility", "entries"],
        "properties": {
          "group": {"type": "string", "minLength": 1},
          "visibility": {"type": "string", "minLength": 1},
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["path", "role", "consumed_by"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "role": {"type": "string", "minLength": 1},
                "consumed_by": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    }
  }
}
