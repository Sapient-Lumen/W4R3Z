{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Freeze packet integrity report",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "minLength": 1},
    "publication_authorized": {"const": false},
    "summary": {
      "type": "object",
      "required": ["registry_entry_count", "materialized_entry_count", "unregistered_packet_dir_count", "checks_failed"],
      "properties": {
        "registry_entry_count": {"type": "integer", "minimum": 0},
        "materialized_entry_count": {"type": "integer", "minimum": 0},
        "unregistered_packet_dir_count": {"type": "integer", "minimum": 0},
        "checks_failed": {"type": "integer", "minimum": 0}
      }
    }
  }
}
