{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision note integrity report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "generated_for_revision",
    "checked_bundle",
    "publication_authorized",
    "decision_directory",
    "decision_index",
    "latest_decision",
    "decision_rows",
    "failures",
    "summary",
    "fail_closed_rule"
  ],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "pattern": "^Anonymity-rev\\d{4}-.+\\.zip$"},
    "publication_authorized": {"const": false},
    "decision_directory": {"type": "string", "const": "release_queue/decisions"},
    "decision_index": {"type": "string", "const": "release_queue/DECISION_INDEX.json"},
    "latest_decision": {"type": "string", "const": "release_queue/LATEST_DECISION.json"},
    "decision_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "decision_id", "status", "heading", "subject_paths", "revision", "bundle", "failures"],
        "properties": {
          "path": {"type": "string", "pattern": "^release_queue/decisions/.+\\.md$"},
          "decision_id": {"type": "string"},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "heading": {"type": "string"},
          "subject_paths": {"type": "array", "items": {"type": "string"}},
          "revision": {"type": "string"},
          "bundle": {"type": "string"},
          "failures": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "failures": {"type": "array", "items": {"type": "object"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks_failed",
        "decision_note_count",
        "decision_index_count",
        "revision_note_count",
        "subject_path_count",
        "subject_path_missing_count",
        "latest_decision",
        "publication_action_counts"
      ],
      "properties": {
        "checks_failed": {"type": "integer", "minimum": 0},
        "decision_note_count": {"type": "integer", "minimum": 0},
        "decision_index_count": {"type": "integer", "minimum": 0},
        "revision_note_count": {"type": "integer", "minimum": 0},
        "subject_path_count": {"type": "integer", "minimum": 0},
        "subject_path_missing_count": {"type": "integer", "minimum": 0},
        "latest_decision": {"type": "string"},
        "publication_action_counts": {"type": "object"}
      }
    },
    "fail_closed_rule": {"type": "string"}
  }
}
