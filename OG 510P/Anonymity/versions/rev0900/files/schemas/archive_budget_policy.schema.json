{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archive budget and hygiene policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "max_total_bytes",
    "max_file_count",
    "max_root_file_count",
    "max_report_file_count",
    "max_schema_file_count",
    "forbidden_series_render_dir_regex",
    "allowed_review_render_prefixes",
    "category_caps",
    "rationale"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "max_total_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_file_count": {
      "type": "integer",
      "minimum": 1
    },
    "max_root_file_count": {
      "type": "integer",
      "minimum": 1
    },
    "max_report_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_schema_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "forbidden_series_render_dir_regex": {
      "type": "string",
      "minLength": 1
    },
    "allowed_review_render_prefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "category_caps": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "properties": {
        "machine_reports": {
          "type": "integer",
          "minimum": 0
        },
        "json_schemas": {
          "type": "integer",
          "minimum": 0
        },
        "root_research_object_metadata": {
          "type": "integer",
          "minimum": 0
        },
        "transient_files": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "decision_index_rev0892_baseline_bytes": {
      "type": "integer",
      "minimum": 1,
      "description": "Measured rev0892 DECISION_INDEX.json byte baseline used only to report rev0893 compaction gains."
    }
  }
}
