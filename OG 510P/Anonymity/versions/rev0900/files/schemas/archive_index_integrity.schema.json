{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archive index integrity report",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "archive_index_json", "archive_index_markdown", "checks", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "minLength": 1},
    "publication_authorized": {"const": false},
    "archive_index_json": {"const": "ARCHIVE_INDEX.json"},
    "archive_index_markdown": {"const": "ARCHIVE_INDEX.md"},
    "checks": {"type": "array"},
    "summary": {
      "type": "object",
      "required": ["checks_passed", "checks_failed", "recent_revision_count_checked", "markdown_section_count"],
      "properties": {
        "checks_passed": {"type": "integer", "minimum": 0},
        "checks_failed": {"type": "integer", "minimum": 0},
        "recent_revision_count_checked": {"type": "integer", "minimum": 0},
        "markdown_section_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "failures": {"type": "array"},
    "fail_closed_rule": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
