{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence pack registry",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "generated_for_revision", "checked_bundle", "publication_authorized", "entries"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "minLength": 1},
    "publication_authorized": {"const": false},
    "entries": {"type": "array", "items": {"type": "object", "required": ["evidence_pack_id", "source_tex", "source_sha256", "manifest"], "properties": {"source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  }
}
