{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report warning policy report",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "warning_policy", "rows", "failures", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "checked_bundle": {"type": "string"},
    "publication_authorized": {"const": false},
    "warning_policy": {
      "type": "object",
      "required": ["passing_reports_must_have_zero_top_level_warnings", "positive_warning_count_fields_are_failures", "allowed_warning_count"],
      "properties": {
        "passing_reports_must_have_zero_top_level_warnings": {"const": true},
        "positive_warning_count_fields_are_failures": {"const": true},
        "allowed_warning_count": {"const": 0}
      },
      "additionalProperties": true
    },
    "rows": {"type": "array"},
    "failures": {"type": "array"},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "report_json_count", "reports_with_warnings", "total_top_level_warning_count", "positive_warning_count_field_count"],
      "properties": {
        "checks_failed": {"type": "integer", "minimum": 0},
        "report_json_count": {"type": "integer", "minimum": 0},
        "reports_with_warnings": {"type": "integer", "minimum": 0},
        "total_top_level_warning_count": {"type": "integer", "minimum": 0},
        "positive_warning_count_field_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "fail_closed_rule": {"type": "string"}
  },
  "additionalProperties": true
}
