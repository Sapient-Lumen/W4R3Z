{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archive entry security report",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "summary", "failures"],
  "properties": {
    "status": {"const": "pass"},
    "generated_for_revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "checked_bundle": {"type": "string"},
    "publication_authorized": {"const": false},
    "allowed_file_modes": {"type": "array", "items": {"type": "string"}},
    "allowed_executable_rule": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "tree_file_count", "tree_symlink_count", "tree_special_file_count", "tree_mode_failure_count", "zip_member_count", "zip_duplicate_member_count", "zip_mode_failure_count", "zip_path_failure_count", "zip_symlink_entry_count", "zip_directory_entry_count", "unexpected_executable_count", "symlink_or_special_count"],
      "properties": {
        "checks_failed": {"const": 0},
        "tree_file_count": {"type": "integer", "minimum": 0},
        "tree_directory_count": {"type": "integer", "minimum": 0},
        "tree_executable_file_count": {"type": "integer", "minimum": 0},
        "tree_symlink_count": {"const": 0},
        "tree_special_file_count": {"const": 0},
        "tree_mode_failure_count": {"const": 0},
        "zip_member_count": {"type": "integer", "minimum": 0},
        "zip_duplicate_member_count": {"const": 0},
        "zip_mode_failure_count": {"const": 0},
        "zip_path_failure_count": {"const": 0},
        "zip_symlink_entry_count": {"const": 0},
        "zip_directory_entry_count": {"const": 0},
        "unexpected_executable_count": {"const": 0},
        "symlink_or_special_count": {"const": 0}
      },
      "additionalProperties": true
    },
    "failures": {"type": "array", "maxItems": 0},
    "fail_closed_rule": {"type": "string"}
  },
  "additionalProperties": true
}
