{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator command hygiene report",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "generated_for_revision", "checked_files", "checks", "findings", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_files": {"type": "array", "items": {"type": "string"}},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "status", "details"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "details": {"type": "string"}
        }
      }
    },
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["checks_passed", "checks_failed", "checked_file_count", "unsafe_command_line_count"],
      "properties": {
        "checks_passed": {"type": "integer", "minimum": 0},
        "checks_failed": {"type": "integer", "minimum": 0},
        "checked_file_count": {"type": "integer", "minimum": 0},
        "unsafe_command_line_count": {"type": "integer", "minimum": 0}
      }
    },
    "fail_closed_rule": {"type": "string", "minLength": 1}
  }
}
