{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Freeze warning resolution report",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "summary", "preflight_notice_resolutions", "failures"],
  "properties": {
    "status": {"const": "pass"},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "minLength": 1},
    "publication_authorized": {"const": false},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "preflight_notice_count", "resolved_notice_count", "unresolved_notice_count"],
      "properties": {
        "checks_failed": {"const": 0},
        "preflight_notice_count": {"type": "integer", "minimum": 0},
        "resolved_notice_count": {"type": "integer", "minimum": 0},
        "unresolved_notice_count": {"const": 0}
      }
    },
    "preflight_notice_resolutions": {"type": "array"},
    "failures": {"type": "array", "maxItems": 0}
  }
}
