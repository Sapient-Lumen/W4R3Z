{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity rebuild fixed-point coverage report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "generated_for_revision",
    "checked_bundle",
    "publication_authorized",
    "rebuild_script",
    "worked_example_rebuild_helper",
    "queue_compile_runner",
    "queue_compile_script",
    "unqueued_compile_script",
    "published_compile_script",
    "auxiliary_tex_compile_script",
    "verify_driver_script",
    "live_compile_lock_script",
    "first_pass_scripts",
    "tail_scripts",
    "script_outputs",
    "required_rebuild_phases",
    "makefile_phase_targets",
    "required_tail_outputs",
    "tail_targets",
    "extra_tail_targets",
    "failures",
    "summary",
    "fail_closed_rule"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "checked_bundle": {
      "type": "string"
    },
    "publication_authorized": {
      "type": "boolean"
    },
    "rebuild_script": {
      "type": "string"
    },
    "first_pass_scripts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tail_scripts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "script_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "script",
          "outputs"
        ],
        "properties": {
          "script": {
            "type": "string"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "required_tail_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tail_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extra_tail_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "object"
    },
    "fail_closed_rule": {
      "type": "string",
      "minLength": 1
    },
    "required_rebuild_phases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "makefile_phase_targets": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "worked_example_rebuild_helper": {
      "type": "string"
    },
    "queue_compile_script": {
      "type": "string"
    },
    "queue_compile_runner": {
      "type": "string"
    },
    "unqueued_compile_script": {
      "type": "string"
    },
    "verify_driver_script": {
      "type": "string"
    },
    "published_compile_script": {
      "type": "string"
    },
    "auxiliary_tex_compile_script": {
      "type": "string"
    },
    "live_compile_lock_script": {
      "type": "string"
    }
  }
}
