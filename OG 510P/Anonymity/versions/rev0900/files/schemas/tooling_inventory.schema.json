{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity tooling inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_for_revision",
    "checked_bundle",
    "inventory_scope",
    "script_count",
    "scripts",
    "summary",
    "fail_closed_rule"
  ],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "pattern": "^Anonymity-rev\\d{4}-.+\\.zip$"},
    "inventory_scope": {"type": "string", "minLength": 1},
    "script_count": {"type": "integer", "minimum": 0},
    "scripts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "role",
          "side_effect_class",
          "has_python_shebang",
          "has_main_guard",
          "imports_argparse",
          "supports_root_arg",
          "supports_write_report_arg",
          "declared_cli_args",
          "local_imports",
          "appears_in_rebuild_script",
          "appears_in_makefile"
        ],
        "properties": {
          "path": {"type": "string", "pattern": "^publishing/.+\\.py$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "role": {"type": "string", "minLength": 1},
          "side_effect_class": {"type": "string", "minLength": 1},
          "has_python_shebang": {"type": "boolean"},
          "has_main_guard": {"type": "boolean"},
          "imports_argparse": {"type": "boolean"},
          "supports_root_arg": {"type": "boolean"},
          "supports_write_report_arg": {"type": "boolean"},
          "declared_cli_args": {"type": "array", "items": {"type": "string", "pattern": "^--[A-Za-z0-9_-]+$"}},
          "local_imports": {"type": "array", "items": {"type": "string"}},
          "appears_in_rebuild_script": {"type": "boolean"},
          "appears_in_makefile": {"type": "boolean"}
        }
      }
    },
    "summary": {"type": "object"},
    "fail_closed_rule": {"type": "string", "minLength": 1}
  }
}
