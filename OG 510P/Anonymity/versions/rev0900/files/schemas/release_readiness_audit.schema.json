{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release readiness audit report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "status",
    "generated_for_revision",
    "checked_states",
    "publication_authorized",
    "items",
    "summary",
    "next_release_recommendation",
    "fail_closed_rule"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "checked_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "publication_authorized": {
      "type": "boolean",
      "const": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "item_id",
          "queue_state",
          "source_tex",
          "title",
          "decision_note",
          "source_family",
          "release_readiness",
          "blocker_count",
          "blockers",
          "warnings",
          "details"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "queue_state": {
            "type": "string"
          },
          "source_tex": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "decision_note": {
            "type": "string"
          },
          "source_family": {
            "type": "string"
          },
          "release_readiness": {
            "type": "string",
            "enum": [
              "static_preflight_pass",
              "blocked",
              "not_a_release_target"
            ]
          },
          "blocker_count": {
            "type": "integer",
            "minimum": 0
          },
          "blockers": {
            "type": "array"
          },
          "warnings": {
            "type": "array"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "checked_item_count",
        "state_counts",
        "release_readiness_counts",
        "source_family_counts",
        "blocker_category_counts",
        "duplicate_source_binding_count",
        "expected_counts_match_queue_index",
        "malformed_bibliography_command_count",
        "source_hash_bound_count",
        "source_hash_missing_count",
        "source_hash_mismatch_count"
      ],
      "properties": {
        "checked_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "state_counts": {
          "type": "object"
        },
        "release_readiness_counts": {
          "type": "object"
        },
        "source_family_counts": {
          "type": "object"
        },
        "blocker_category_counts": {
          "type": "object"
        },
        "duplicate_source_binding_count": {
          "type": "integer",
          "minimum": 0
        },
        "expected_counts_match_queue_index": {
          "type": "boolean"
        },
        "malformed_bibliography_command_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_hash_bound_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_hash_missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_hash_mismatch_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "next_release_recommendation": {
      "type": "object"
    },
    "fail_closed_rule": {
      "type": "string",
      "minLength": 1
    }
  }
}
