{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Freeze packet manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "freeze_packet_id",
    "generated_for_revision",
    "checked_bundle",
    "publication_authorized",
    "source_tex",
    "source_sha256",
    "frozen_source_path",
    "frozen_source_sha256",
    "evidence_pack_manifest",
    "compile_witness",
    "packet_paths",
    "compile_witness_snapshot",
    "compile_witness_snapshot_sha256",
    "compile_witness_sha256_at_freeze"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "freeze_packet_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "checked_bundle": {
      "type": "string",
      "minLength": 1
    },
    "publication_authorized": {
      "const": false
    },
    "source_tex": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frozen_source_path": {
      "type": "string",
      "minLength": 1
    },
    "frozen_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packet_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "compile_witness_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "compile_witness_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compile_witness_sha256_at_freeze": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
