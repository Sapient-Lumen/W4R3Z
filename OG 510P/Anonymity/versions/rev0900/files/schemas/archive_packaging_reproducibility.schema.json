{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity archive packaging reproducibility report",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "packaging_script", "trial_reports", "summary", "failures", "fail_closed_rule"],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "pattern": "^Anonymity-rev\\d{4}-.+\\.zip$"},
    "publication_authorized": {"type": "boolean", "const": false},
    "packaging_script": {"type": "string", "const": "publishing/build_archive_zip.py"},
    "trial_reports": {"type": "array"},
    "member_order_evidence": {"type": "object"},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "trial_count", "two_trial_zip_sha256_equal", "two_trial_zip_size_equal", "two_trial_member_metadata_equal", "zip_member_count", "manifest_file_count"],
      "properties": {
        "checks_failed": {"type": "integer", "minimum": 0},
        "trial_count": {"type": "integer", "minimum": 0},
        "two_trial_zip_sha256_equal": {"type": "boolean"},
        "two_trial_zip_size_equal": {"type": "boolean"},
        "two_trial_member_metadata_equal": {"type": "boolean"},
        "zip_member_count": {"type": "integer", "minimum": 0},
        "manifest_file_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "failures": {"type": "array"},
    "fail_closed_rule": {"type": "string"}
  }
}
