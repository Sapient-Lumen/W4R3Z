{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review inventory coverage report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "status",
    "generated_for_revision",
    "checked_bundle",
    "inventory_version",
    "checks",
    "summary",
    "visible_unqueued_sources",
    "fail_closed_rule"
  ],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "minLength": 1},
    "inventory_version": {"type": "integer", "minimum": 2},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "status", "details"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "details": {"type": "string"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "checks_passed",
        "checks_failed",
        "series_paper_count",
        "inventory_entry_count",
        "queued_inventory_count",
        "unqueued_inventory_count",
        "queue_source_count",
        "queue_state_source_counts",
        "unqueued_by_bucket",
        "unqueued_by_series"
      ],
      "properties": {
        "checks_passed": {"type": "integer", "minimum": 0},
        "checks_failed": {"type": "integer", "minimum": 0},
        "series_paper_count": {"type": "integer", "minimum": 0},
        "inventory_entry_count": {"type": "integer", "minimum": 0},
        "queued_inventory_count": {"type": "integer", "minimum": 0},
        "unqueued_inventory_count": {"type": "integer", "minimum": 0},
        "queue_source_count": {"type": "integer", "minimum": 0},
        "queue_state_source_counts": {"type": "object"},
        "unqueued_by_bucket": {"type": "object"},
        "unqueued_by_series": {"type": "object"}
      }
    },
    "visible_unqueued_sources": {"type": "array"},
    "fail_closed_rule": {"type": "string", "minLength": 1}
  }
}
