{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review inventory",
  "type": "object",
  "additionalProperties": true,
  "required": ["inventory_version", "generated_for_revision", "generated_from_bundle", "generated_timestamp", "generated_on", "reviewable_unpublished_papers", "series_counts", "review_bucket_counts", "queue_coverage", "entries"],
  "properties": {
    "inventory_version": {"type": "integer", "minimum": 2},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "generated_from_bundle": {"type": "string", "minLength": 1},
    "generated_timestamp": {"type": "string", "minLength": 1},
    "generated_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "reviewable_unpublished_papers": {"type": "integer", "minimum": 0},
    "series_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "review_bucket_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "queue_coverage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["queued_count", "unqueued_count", "queue_state_source_counts", "unqueued_by_bucket", "unqueued_by_series", "queue_sources_not_in_inventory", "duplicate_queue_binding_count"],
      "properties": {
        "queued_count": {"type": "integer", "minimum": 0},
        "unqueued_count": {"type": "integer", "minimum": 0},
        "queue_state_source_counts": {"type": "object"},
        "unqueued_by_bucket": {"type": "object"},
        "unqueued_by_series": {"type": "object"},
        "queue_sources_not_in_inventory": {"type": "array", "items": {"type": "string"}},
        "duplicate_queue_binding_count": {"type": "integer", "minimum": 0}
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["source_tex", "series", "paper_dir", "title_plain", "review_bucket", "initial_review_priority", "sha256", "sha256_prefix", "queue_binding_count", "queue_states", "queue_bindings", "queue_visibility"],
        "properties": {
          "source_tex": {"type": "string", "pattern": "^series/.+/paper\\.tex$"},
          "series": {"type": "string", "minLength": 1},
          "paper_dir": {"type": "string", "minLength": 1},
          "title_plain": {"type": "string"},
          "date_raw": {"type": "string"},
          "review_bucket": {"type": "string", "minLength": 1},
          "initial_review_priority": {"type": "string", "minLength": 1},
          "churn_signals": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sha256_prefix": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
          "queue_binding_count": {"type": "integer", "minimum": 0},
          "queue_states": {"type": "array", "items": {"type": "string"}},
          "queue_bindings": {"type": "array"},
          "queue_visibility": {"type": "string", "enum": ["queued", "not_queued_explicitly_visible"]}
        }
      }
    }
  }
}
