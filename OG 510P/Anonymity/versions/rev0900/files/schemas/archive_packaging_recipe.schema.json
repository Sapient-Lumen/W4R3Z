{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archive packaging recipe report",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "packaging_script", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "minLength": 1},
    "publication_authorized": {"const": false},
    "packaging_script": {"type": "string", "const": "publishing/build_archive_zip.py"},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "packaging_script_present", "makefile_package_target_present", "dry_run_status"],
      "properties": {
        "checks_failed": {"type": "integer", "minimum": 0},
        "packaging_script_present": {"type": "boolean"},
        "makefile_package_target_present": {"type": "boolean"},
        "dry_run_status": {"type": "string"}
      }
    }
  }
}
