{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tooling static integrity report",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "script_directory", "script_rows", "failures", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "checked_bundle": {"type": "string"},
    "publication_authorized": {"const": false},
    "script_directory": {"type": "string"},
    "script_rows": {"type": "array", "items": {"type": "object", "required": ["script", "status", "failures"], "properties": {"script": {"type": "string"}, "status": {"enum": ["pass", "fail"]}, "failures": {"type": "array"}}, "additionalProperties": true}},
    "failures": {"type": "array"},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "script_count", "syntax_failure_count", "missing_future_annotations_count", "duplicate_literal_dict_key_count", "unexpected_top_level_statement_count"],
      "properties": {
        "checks_failed": {"type": "integer", "minimum": 0},
        "script_count": {"type": "integer", "minimum": 0},
        "syntax_failure_count": {"type": "integer", "minimum": 0},
        "missing_future_annotations_count": {"type": "integer", "minimum": 0},
        "duplicate_literal_dict_key_count": {"type": "integer", "minimum": 0},
        "unexpected_top_level_statement_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "fail_closed_rule": {"type": "string"}
  },
  "additionalProperties": true
}
