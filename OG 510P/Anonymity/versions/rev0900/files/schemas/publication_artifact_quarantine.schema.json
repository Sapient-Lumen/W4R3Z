{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity publication artifact quarantine report",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "quarantine_policy", "findings", "shipped_compile_output_digest_hits", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "pattern": "^Anonymity-rev\\d{4}-.+\\.zip$"},
    "publication_authorized": {"type": "boolean", "const": false},
    "quarantine_policy": {"type": "string"},
    "compile_output_pdf_digests": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "findings": {"type": "array"},
    "shipped_compile_output_digest_hits": {"type": "array"},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "disallowed_artifact_count", "compile_output_pdf_digest_count", "shipped_compile_output_digest_hit_count"],
      "properties": {
        "checks_failed": {"type": "integer", "minimum": 0},
        "disallowed_artifact_count": {"type": "integer", "minimum": 0},
        "compile_output_pdf_digest_count": {"type": "integer", "minimum": 0},
        "shipped_compile_output_digest_hit_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "failures": {"type": "array"},
    "fail_closed_rule": {"type": "string"}
  }
}
