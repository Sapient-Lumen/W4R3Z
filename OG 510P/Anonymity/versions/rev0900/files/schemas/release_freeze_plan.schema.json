{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Next release freeze plan",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "status",
    "generated_for_revision",
    "checked_bundle",
    "publication_authorized",
    "recommendation",
    "selected_source",
    "gates",
    "summary",
    "fail_closed_rule"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "dry_run_pass_pending_manual_gates",
        "ready_for_explicit_publication_decision",
        "blocked",
        "no_static_pass_candidate"
      ]
    },
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "minLength": 1},
    "publication_authorized": {"type": "boolean", "const": false},
    "recommendation": {"type": "object"},
    "selected_source": {"type": ["object", "null"]},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "status", "blocking", "detail"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pass", "pending", "fail"]},
          "blocking": {"type": "boolean"},
          "detail": {"type": "string"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["gate_count", "passed_gates", "pending_gates", "failed_gates"],
      "properties": {
        "gate_count": {"type": "integer", "minimum": 1},
        "passed_gates": {"type": "integer", "minimum": 0},
        "pending_gates": {"type": "integer", "minimum": 0},
        "failed_gates": {"type": "integer", "minimum": 0}
      }
    },
    "fail_closed_rule": {"type": "string", "minLength": 1}
  }
}
