{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifest canonicality report",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "summary", "failures"],
  "properties": {
    "status": {"const": "pass"},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "minLength": 1},
    "publication_authorized": {"const": false},
    "manifest_json": {"const": "MANIFEST.json"},
    "manifest_sha256": {"const": "MANIFEST.sha256"},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "manifest_json_file_count", "tree_file_count", "manifest_sha256_entry_count", "digest_mismatch_count"],
      "properties": {
        "checks_failed": {"const": 0},
        "manifest_json_file_count": {"type": "integer", "minimum": 1},
        "tree_file_count": {"type": "integer", "minimum": 1},
        "manifest_sha256_entry_count": {"type": "integer", "minimum": 1},
        "digest_mismatch_count": {"const": 0}
      }
    },
    "failures": {"type": "array", "maxItems": 0}
  }
}
