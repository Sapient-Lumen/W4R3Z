{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Freeze compile witness",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "generated_for_revision",
    "checked_bundle",
    "publication_authorized",
    "witness_type",
    "source_tex",
    "source_sha256",
    "preflight_report"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "checked_bundle": {
      "type": "string",
      "minLength": 1
    },
    "publication_authorized": {
      "const": false
    },
    "source_tex": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preflight_report": {
      "type": "object"
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "version_line": {
          "type": "string"
        },
        "version_output_sha256": {
          "type": "string"
        }
      }
    }
  }
}
