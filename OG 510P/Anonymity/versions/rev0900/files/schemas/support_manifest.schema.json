{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worked-example support manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["manifest_id", "artifact_inventory_id", "claim_id", "release_id", "note_version", "files"],
  "properties": {
    "manifest_id": {"type": "string", "minLength": 1},
    "artifact_inventory_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "note_version": {"type": "string", "minLength": 1},
    "note": {"type": "string"},
    "path_semantics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "artifact_root": {"type": "string", "minLength": 1},
        "paper_root": {"type": "string", "minLength": 1},
        "repo_root": {"type": "string", "minLength": 1}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["path", "sha256", "base", "repo_relative_path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "base": {"type": "string", "enum": ["artifact_root", "paper_root", "repo_root"]},
          "repo_relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
