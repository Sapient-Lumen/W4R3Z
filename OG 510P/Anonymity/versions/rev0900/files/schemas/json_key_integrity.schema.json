{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JSON key integrity report",
  "type": "object",
  "required": [
    "status",
    "generated_for_revision",
    "checked_bundle",
    "publication_authorized",
    "parser_policy",
    "json_file_count",
    "failures",
    "summary",
    "fail_closed_rule"
  ],
  "properties": {
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "checked_bundle": {
      "type": "string"
    },
    "publication_authorized": {
      "const": false
    },
    "parser_policy": {
      "type": "string"
    },
    "json_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "failures": {
      "type": "array"
    },
    "sample_checked_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "checks_failed",
        "json_file_count",
        "duplicate_key_failure_count",
        "checked_with_duplicate_rejecting_parser",
        "non_finite_numeric_literal_failure_count",
        "checked_with_nonfinite_rejecting_parser",
        "other_json_parse_failure_count"
      ],
      "properties": {
        "checks_failed": {
          "type": "integer",
          "minimum": 0
        },
        "json_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_key_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "checked_with_duplicate_rejecting_parser": {
          "type": "boolean"
        },
        "non_finite_numeric_literal_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "checked_with_nonfinite_rejecting_parser": {
          "type": "boolean"
        },
        "other_json_parse_failure_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "fail_closed_rule": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
