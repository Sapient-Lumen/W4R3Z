{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication target portability report",
  "type": "object",
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "summary", "target_rows", "failures"],
  "properties": {
    "status": {"const": "pass"},
    "generated_for_revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "checked_bundle": {"type": "string"},
    "publication_authorized": {"const": false},
    "checked_sources": {"type": "array", "items": {"type": "string"}},
    "target_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "json_pointer", "kind", "value", "portable", "reason"],
        "properties": {
          "path": {"type": "string"},
          "json_pointer": {"type": "string"},
          "kind": {"enum": ["published_path", "published_name"]},
          "value": {"type": "string"},
          "portable": {"const": true},
          "reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "failures": {"type": "array", "maxItems": 0},
    "summary": {
      "type": "object",
      "required": ["checks_failed", "target_row_count", "unique_published_path_count", "unique_published_name_count", "nonportable_count", "already_exists_count"],
      "properties": {
        "checks_failed": {"const": 0},
        "target_row_count": {"type": "integer", "minimum": 0},
        "unique_published_path_count": {"type": "integer", "minimum": 0},
        "unique_published_name_count": {"type": "integer", "minimum": 0},
        "nonportable_count": {"const": 0},
        "already_exists_count": {"const": 0},
        "unique_published_paths": {"type": "array", "items": {"type": "string", "pattern": "^published/[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9]+(?:_[a-z0-9]+)*$"}},
        "unique_published_names": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9]+(?:_[a-z0-9]+)*$"}}
      },
      "additionalProperties": true
    },
    "fail_closed_rule": {"type": "string"}
  },
  "additionalProperties": true
}
