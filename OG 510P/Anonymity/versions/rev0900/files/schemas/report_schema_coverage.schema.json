{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity report schema coverage report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "generated_for_revision",
    "checked_bundle",
    "publication_authorized",
    "schema_validation_report",
    "generic_report_schema",
    "explicit_report_targets",
    "generic_report_targets",
    "failures",
    "summary",
    "fail_closed_rule"
  ],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "pattern": "^Anonymity-rev\\d{4}-.+\\.zip$"},
    "publication_authorized": {"type": "boolean", "const": false},
    "schema_validation_report": {"type": "string", "const": "reports/surface_schema_validation.json"},
    "generic_report_schema": {"type": "string", "const": "schemas/generic_report.schema.json"},
    "explicit_report_targets": {"type": "array", "items": {"type": "string", "pattern": "^reports/.+\\.json$"}},
    "generic_report_targets": {"type": "array", "items": {"type": "string", "pattern": "^reports/.+\\.json$"}},
    "failures": {"type": "array", "items": {"type": "object"}},
    "summary": {
      "type": "object",
      "required": [
        "checks_failed",
        "report_json_count",
        "report_json_schema_checked_count",
        "explicit_report_schema_count",
        "generic_report_schema_count",
        "missing_report_schema_count",
        "failed_report_schema_count",
        "all_report_json_schema_checked"
      ],
      "properties": {
        "checks_failed": {"type": "integer", "minimum": 0},
        "report_json_count": {"type": "integer", "minimum": 0},
        "schema_report_checked_target_count": {"type": "integer", "minimum": 0},
        "report_json_schema_checked_count": {"type": "integer", "minimum": 0},
        "explicit_report_schema_count": {"type": "integer", "minimum": 0},
        "generic_report_schema_count": {"type": "integer", "minimum": 0},
        "missing_report_schema_count": {"type": "integer", "minimum": 0},
        "failed_report_schema_count": {"type": "integer", "minimum": 0},
        "all_report_json_schema_checked": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "fail_closed_rule": {"type": "string", "minLength": 1}
  }
}
