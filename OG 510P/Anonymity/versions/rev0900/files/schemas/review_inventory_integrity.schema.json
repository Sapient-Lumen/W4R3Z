{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review inventory integrity report",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "generated_for_revision", "checked_inventory", "checks", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_inventory": {"type": "string", "const": "release_queue/REVIEW_INVENTORY.json"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "status", "details"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "details": {"type": "string"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["checks_passed", "checks_failed", "inventory_entry_count", "actual_series_paper_count", "queue_source_count", "unqueued_inventory_entry_count", "sha256_prefix_mismatch_count", "duplicate_source_tex_count"],
      "properties": {
        "checks_passed": {"type": "integer", "minimum": 0},
        "checks_failed": {"type": "integer", "minimum": 0},
        "inventory_entry_count": {"type": "integer", "minimum": 0},
        "actual_series_paper_count": {"type": "integer", "minimum": 0},
        "queue_source_count": {"type": "integer", "minimum": 0},
        "unqueued_inventory_entry_count": {"type": "integer", "minimum": 0},
        "sha256_prefix_mismatch_count": {"type": "integer", "minimum": 0},
        "duplicate_source_tex_count": {"type": "integer", "minimum": 0}
      }
    },
    "fail_closed_rule": {"type": "string", "minLength": 1}
  }
}
