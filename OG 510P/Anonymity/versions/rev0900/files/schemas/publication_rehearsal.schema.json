{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication rehearsal report",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "generated_for_revision", "checked_bundle", "publication_authorized", "rehearsal_type", "readiness_status", "source_binding", "summary", "fail_closed_rule"],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "generated_for_revision": {"type": "string", "pattern": "^rev\\d{4}$"},
    "checked_bundle": {"type": "string", "minLength": 1},
    "publication_authorized": {"const": false},
    "rehearsal_type": {"const": "non_authorizing_publication_dry_run"},
    "readiness_status": {"type": "string"},
    "source_binding": {"type": "object"},
    "summary": {"type": "object"},
    "fail_closed_rule": {"type": "string"}
  }
}
