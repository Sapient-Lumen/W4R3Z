{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymity decision index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "generated_for_revision",
    "latest_decision",
    "decision_count",
    "action_class_counts",
    "publication_action_counts",
    "kind_counts",
    "summary",
    "decisions"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "owner": {
      "type": "string",
      "const": "release_queue/decisions/"
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "latest_decision": {
      "type": "string",
      "pattern": "^release_queue/decisions/.+\\.md$"
    },
    "decision_count": {
      "type": "integer",
      "minimum": 0
    },
    "action_class_counts": {
      "type": "object"
    },
    "publication_action_counts": {
      "type": "object"
    },
    "kind_counts": {
      "type": "object"
    },
    "summary": {
      "type": "object",
      "required": [
        "total_notes",
        "first_note",
        "latest_note",
        "distinct_decision_dates"
      ],
      "properties": {
        "total_notes": {
          "type": "integer",
          "minimum": 0
        },
        "first_note": {
          "type": "string"
        },
        "latest_note": {
          "type": "string"
        },
        "distinct_decision_dates": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "array"
    },
    "checked_bundle": {
      "type": "string"
    },
    "publication_authorized": {
      "type": "boolean"
    }
  }
}
