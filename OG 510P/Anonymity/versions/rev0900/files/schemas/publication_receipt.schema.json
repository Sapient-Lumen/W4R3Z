{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "publication_authorized",
    "published_name",
    "published_tex",
    "published_tex_sha256",
    "source_tex",
    "source_sha256",
    "decision_note",
    "evidence_pack_manifest",
    "compile_witness",
    "freeze_packet_manifest",
    "compile_witness_snapshot",
    "compile_witness_snapshot_sha256",
    "published_compile_witness_snapshot",
    "published_compile_witness_snapshot_sha256"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "publication_authorized": {
      "const": true
    },
    "published_tex_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compile_witness_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "published_compile_witness_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "compile_witness_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "published_compile_witness_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
