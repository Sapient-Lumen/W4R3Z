{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/release-invariant.schema.json",
  "title": "AI-EDU release invariant record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invariant_record_id",
    "revision",
    "invariant_state",
    "related_followthrough_ids",
    "release_claim",
    "invariants",
    "forbidden_states",
    "last_reviewed"
  ],
  "properties": {
    "invariant_record_id": {
      "type": "string",
      "pattern": "^INV-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "invariant_state": {
      "type": "string",
      "enum": [
        "INV0",
        "INV1",
        "INV2",
        "INV3",
        "INV4",
        "INVX"
      ]
    },
    "related_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "release_claim": {
      "type": "string",
      "minLength": 4
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "forbidden_states": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
