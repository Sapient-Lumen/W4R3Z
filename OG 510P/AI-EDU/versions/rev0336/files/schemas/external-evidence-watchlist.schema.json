{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/external-evidence-watchlist.schema.json",
  "title": "AI-EDU external evidence watchlist",
  "type": "object",
  "additionalProperties": false,
  "required": ["watchlist_id", "title", "owner", "sources", "last_reviewed"],
  "properties": {
    "watchlist_id": {"type": "string", "pattern": "^EWATCH-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 4},
    "owner": {"type": "string", "minLength": 2},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "title",
          "url",
          "source_class",
          "watch_state",
          "review_cadence",
          "next_review_date",
          "related_bibliography_ids",
          "related_archive_surfaces",
          "invalidation_triggers",
          "action_if_changed"
        ],
        "properties": {
          "source_id": {"type": "string", "pattern": "^EWS-[A-Z0-9-]+$"},
          "title": {"type": "string", "minLength": 4},
          "url": {"type": "string", "minLength": 8},
          "source_class": {"type": "string", "enum": ["standard", "regulation", "security", "official_guidance", "peer_or_independent_study", "market_signal"]},
          "watch_state": {"type": "string", "enum": ["EW0", "EW1", "EW2", "EW3", "EW4", "EW5", "EWX"]},
          "review_cadence": {"type": "string", "enum": ["monthly", "quarterly", "annual", "triggered"]},
          "next_review_date": {"type": "string", "format": "date"},
          "related_bibliography_ids": {"type": "array", "items": {"type": "string", "pattern": "^B[0-9]+$"}, "minItems": 1},
          "related_archive_surfaces": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "invalidation_triggers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "action_if_changed": {"type": "string", "minLength": 4}
        }
      }
    },
    "last_reviewed": {"type": "string", "format": "date"}
  }
}
