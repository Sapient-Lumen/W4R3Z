{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/release-delta-manifest.schema.json",
  "title": "AI-EDU release delta manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delta_id",
    "revision",
    "base_revision",
    "delta_state",
    "added_paths",
    "changed_paths",
    "retired_paths",
    "new_validators",
    "new_schemas",
    "closed_followthrough_ids",
    "live_followthrough_ids",
    "operational_effect",
    "forbidden_claims",
    "last_reviewed"
  ],
  "properties": {
    "delta_id": {
      "type": "string",
      "pattern": "^RDM-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "delta_state": {
      "type": "string",
      "enum": [
        "RDM0",
        "RDM1",
        "RDM2",
        "RDM3",
        "RDM4",
        "RDMX"
      ]
    },
    "added_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retired_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "new_validators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "new_schemas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "closed_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "live_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operational_effect": {
      "type": "string",
      "minLength": 4
    },
    "forbidden_claims": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
