{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/maintenance-mode-state.schema.json",
  "title": "AI-EDU maintenance mode state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "maintenance_id",
    "revision",
    "maintenance_state",
    "related_followthrough_ids",
    "release_candidate",
    "expiry_date",
    "refresh_triggers",
    "closure_allowed",
    "next_actions",
    "last_reviewed"
  ],
  "properties": {
    "maintenance_id": {
      "type": "string",
      "pattern": "^MM-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "maintenance_state": {
      "type": "string",
      "enum": [
        "MM0",
        "MM1",
        "MM2",
        "MM3",
        "MM4",
        "MMX"
      ]
    },
    "related_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "release_candidate": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "refresh_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "closure_allowed": {
      "type": "boolean"
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
