{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/signoff-quorum.schema.json",
  "title": "AI-EDU human signoff quorum",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quorum_id",
    "revision",
    "quorum_state",
    "related_followthrough_ids",
    "closure_permitted",
    "required_roles",
    "conflict_attestations",
    "non_waivable_controls",
    "missing_for_closure",
    "last_reviewed"
  ],
  "properties": {
    "quorum_id": {"type": "string", "pattern": "^SQ-[A-Z0-9-]+$"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "quorum_state": {"type": "string", "enum": ["SQ0", "SQ1", "SQ2", "SQ3", "SQX"]},
    "related_followthrough_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "closure_permitted": {"type": "boolean"},
    "required_roles": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "conflict_attestations": {"type": "array", "items": {"type": "object"}},
    "non_waivable_controls": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "missing_for_closure": {"type": "array", "items": {"type": "string"}},
    "last_reviewed": {"type": "string", "format": "date"}
  }
}
