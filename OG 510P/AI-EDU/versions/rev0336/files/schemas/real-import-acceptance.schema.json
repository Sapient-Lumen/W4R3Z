{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/real-import-acceptance.schema.json",
  "title": "AI-EDU real import acceptance packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptance_id",
    "title",
    "related_followthrough",
    "acceptance_state",
    "source_truth_class",
    "closure_permitted",
    "reviewers",
    "referenced_manifest_ids",
    "referenced_dictionary_ids",
    "referenced_import_map_ids",
    "candidate_service_record_ids",
    "test_results",
    "calibration",
    "last_reviewed"
  ],
  "properties": {
    "acceptance_id": {"type": "string", "pattern": "^ACCEPT-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 4},
    "related_followthrough": {"type": "string", "pattern": "^FT-[0-9]{4}$"},
    "acceptance_state": {"type": "string", "enum": ["AC0", "AC1", "AC2", "AC3", "AC4", "AC5", "AC6", "ACX"]},
    "source_truth_class": {"type": "string", "enum": ["SRC0", "SRC1", "SRC2", "SRC3", "SRC4", "SRCX"]},
    "closure_permitted": {"type": "boolean"},
    "reviewers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "referenced_manifest_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "referenced_dictionary_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "referenced_import_map_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "candidate_service_record_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "test_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "test", "required", "status", "evidence", "blocks_closure"],
        "properties": {
          "test_id": {"type": "string", "pattern": "^AIT-[0-9]{2}$"},
          "test": {"type": "string", "minLength": 4},
          "required": {"type": "boolean"},
          "status": {"type": "string", "enum": ["pass", "fail", "blocked", "not_applicable"]},
          "evidence": {"type": "string"},
          "blocks_closure": {"type": "boolean"}
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_count", "disagreement_items", "unresolved_blocks", "next_action"],
      "properties": {
        "reviewer_count": {"type": "integer", "minimum": 1},
        "disagreement_items": {"type": "array", "items": {"type": "string"}},
        "unresolved_blocks": {"type": "array", "items": {"type": "string"}},
        "next_action": {"type": "string", "minLength": 4}
      }
    },
    "last_reviewed": {"type": "string", "format": "date"}
  }
}
