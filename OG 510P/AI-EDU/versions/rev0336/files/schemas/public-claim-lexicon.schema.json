{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/public-claim-lexicon.schema.json",
  "title": "AI-EDU public claim lexicon",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lexicon_id",
    "revision",
    "related_followthrough_ids",
    "allowed_phrases",
    "conditional_phrases",
    "forbidden_phrases_before_ft0181_close",
    "repair_action",
    "last_reviewed"
  ],
  "properties": {
    "lexicon_id": {
      "type": "string",
      "pattern": "^PCL-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "related_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "allowed_phrases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "conditional_phrases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "forbidden_phrases_before_ft0181_close": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "repair_action": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
