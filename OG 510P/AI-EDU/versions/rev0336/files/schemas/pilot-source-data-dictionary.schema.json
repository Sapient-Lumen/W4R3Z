{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/pilot-source-data-dictionary.schema.json",
  "title": "AI-EDU pilot source data dictionary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dictionary_id",
    "title",
    "source_system",
    "source_owner",
    "source_truth_class",
    "dictionary_state",
    "target_schema_version",
    "field_entries",
    "owner_review",
    "stop_conditions",
    "last_reviewed"
  ],
  "properties": {
    "dictionary_id": {"type": "string", "pattern": "^DDICT-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 4},
    "source_system": {"type": "string", "minLength": 2},
    "source_owner": {"type": "string", "minLength": 2},
    "source_truth_class": {"type": "string", "enum": ["SRC0", "SRC1", "SRC2", "SRC3", "SRC4", "SRCX"]},
    "dictionary_state": {"type": "string", "enum": ["DDICT0", "DDICT1", "DDICT2", "DDICT3", "DDICT4", "DDICTX"]},
    "target_schema_version": {"type": "string", "enum": ["1.1"]},
    "field_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_field",
          "meaning",
          "sensitivity",
          "import_action",
          "target_field",
          "decision_relevance",
          "owner_review_required",
          "notes"
        ],
        "properties": {
          "source_field": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 4},
          "sensitivity": {"type": "string", "enum": ["public", "internal", "protected", "security", "unknown"]},
          "import_action": {"type": "string", "enum": ["map", "abstract", "keep_local", "quarantine", "ignore"]},
          "target_field": {"type": "string"},
          "decision_relevance": {"type": "string", "minLength": 4},
          "owner_review_required": {"type": "string", "enum": ["record_owner", "support_owner", "security_owner", "assessment_owner", "service_owner", "none"]},
          "notes": {"type": "string"}
        }
      }
    },
    "owner_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_by_role", "review_status", "review_notes"],
      "properties": {
        "reviewed_by_role": {"type": "string", "minLength": 2},
        "review_status": {"type": "string", "enum": ["template_only", "owner_review_needed", "owner_reviewed", "blocked"]},
        "review_notes": {"type": "string"}
      }
    },
    "stop_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "last_reviewed": {"type": "string", "format": "date"}
  }
}
