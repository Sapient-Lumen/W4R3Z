{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/operator-handoff.schema.json",
  "title": "AI-EDU operator handoff record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id",
    "revision",
    "handoff_state",
    "remaining_followthrough_ids",
    "required_startup_surfaces",
    "required_commands",
    "allowed_next_actions",
    "do_not_claim",
    "stop_conditions",
    "no_fake_import_assertion",
    "first_real_import_unblocker",
    "last_reviewed"
  ],
  "properties": {
    "handoff_id": {
      "type": "string",
      "pattern": "^OH-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "handoff_state": {
      "type": "string",
      "enum": [
        "OH0",
        "OH1",
        "OH2",
        "OH3",
        "OH4",
        "OH5",
        "OHX"
      ]
    },
    "remaining_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^FT-[0-9]{4}$"
      }
    },
    "required_startup_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 4
    },
    "required_commands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2
    },
    "allowed_next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2
    },
    "do_not_claim": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "no_fake_import_assertion": {
      "type": "boolean"
    },
    "first_real_import_unblocker": {
      "type": "string",
      "minLength": 4
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
