{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/artifact-dependency-graph.schema.json",
  "title": "AI-EDU artifact dependency graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_id",
    "revision",
    "graph_state",
    "related_followthrough_ids",
    "nodes",
    "edges",
    "required_terminal_paths",
    "graph_limits",
    "last_reviewed"
  ],
  "properties": {
    "graph_id": {
      "type": "string",
      "pattern": "^DG-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "graph_state": {
      "type": "string",
      "enum": [
        "DG0",
        "DG1",
        "DG2",
        "DG3",
        "DG4",
        "DGX"
      ]
    },
    "related_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "required_terminal_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "graph_limits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
