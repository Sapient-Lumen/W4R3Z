{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/synthetic-example-declaration.schema.json",
  "title": "AI-EDU synthetic example source-status declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "declaration_id",
    "revision",
    "scope",
    "source_truth_classes",
    "records",
    "blanket_rule",
    "promotion_rule",
    "last_reviewed"
  ],
  "properties": {
    "declaration_id": {
      "type": "string",
      "pattern": "^SED-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "scope": {
      "type": "string"
    },
    "source_truth_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "blanket_rule": {
      "type": "string"
    },
    "promotion_rule": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
