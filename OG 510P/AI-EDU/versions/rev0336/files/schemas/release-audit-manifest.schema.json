{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/release-audit-manifest.schema.json",
  "title": "AI-EDU release audit manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "revision",
    "base_revision",
    "audit_state",
    "claims_all_followthrough_closed",
    "live_followthrough_ids",
    "file_inventory",
    "generated_artifacts",
    "required_commands",
    "hash_targets",
    "excluded_from_hash",
    "claims_bit_reproducible_zip",
    "audit_limits",
    "last_reviewed"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "pattern": "^RA-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "audit_state": {
      "type": "string",
      "enum": [
        "RA0",
        "RA1",
        "RA2",
        "RA3",
        "RA4",
        "RAX"
      ]
    },
    "claims_all_followthrough_closed": {
      "type": "boolean"
    },
    "live_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "file_inventory": {
      "type": "object"
    },
    "generated_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_commands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "hash_targets": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "excluded_from_hash": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims_bit_reproducible_zip": {
      "type": "boolean"
    },
    "audit_limits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
