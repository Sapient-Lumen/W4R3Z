{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/ai-service-record.schema.json",
  "title": "AI-EDU AI service record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "service_name",
    "status",
    "owners",
    "use_case",
    "data_map",
    "authority",
    "memory",
    "evidence_claims",
    "construct_and_proof",
    "accessibility_and_protected_support",
    "security",
    "workload",
    "decision",
    "publication_and_adapters",
    "public_summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.1"
      ]
    },
    "record_id": {
      "type": "string",
      "minLength": 4
    },
    "service_name": {
      "type": "string",
      "minLength": 4
    },
    "status": {
      "type": "string",
      "enum": [
        "sandbox",
        "limited_pilot",
        "recurring_local",
        "scale_review",
        "paused",
        "retired"
      ]
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institutional_owner",
        "educational_owner",
        "technical_owner",
        "support_owner",
        "record_owner"
      ],
      "properties": {
        "institutional_owner": {
          "type": "string",
          "minLength": 2
        },
        "educational_owner": {
          "type": "string",
          "minLength": 2
        },
        "technical_owner": {
          "type": "string",
          "minLength": 2
        },
        "support_owner": {
          "type": "string",
          "minLength": 2
        },
        "record_owner": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "use_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "intended_users",
        "age_bands",
        "sector",
        "intended_tasks",
        "explicit_non_use_cases",
        "highest_stakes_touched",
        "required_human_owner"
      ],
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 8
        },
        "intended_users": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "age_bands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "sector": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "intended_tasks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "explicit_non_use_cases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "highest_stakes_touched": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "required_human_owner": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "data_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_data",
        "generated_outputs",
        "logs",
        "retention",
        "subprocessors_or_storage",
        "export_or_continuity_route"
      ],
      "properties": {
        "input_data": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "generated_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "logs": {
          "type": "string",
          "minLength": 2
        },
        "retention": {
          "type": "string",
          "minLength": 2
        },
        "subprocessors_or_storage": {
          "type": "string",
          "minLength": 2
        },
        "export_or_continuity_route": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_action_authority",
        "durable_write_allowed",
        "direct_write_permissions",
        "queue_or_notification_effects",
        "record_bearing_effects",
        "rollback_route"
      ],
      "properties": {
        "max_action_authority": {
          "type": "string",
          "enum": [
            "AA0",
            "AA1",
            "AA2",
            "AA3",
            "AA4",
            "AA5",
            "AA6"
          ]
        },
        "durable_write_allowed": {
          "type": "boolean"
        },
        "direct_write_permissions": {
          "type": "string"
        },
        "queue_or_notification_effects": {
          "type": "string"
        },
        "record_bearing_effects": {
          "type": "string"
        },
        "rollback_route": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_memory_class",
        "inspection_or_correction_route",
        "protected_local_record_route",
        "cross_function_reuse_prohibited"
      ],
      "properties": {
        "max_memory_class": {
          "type": "string",
          "enum": [
            "M0",
            "M1",
            "M2",
            "M3"
          ]
        },
        "inspection_or_correction_route": {
          "type": "string",
          "minLength": 2
        },
        "protected_local_record_route": {
          "type": "string",
          "minLength": 2
        },
        "cross_function_reuse_prohibited": {
          "type": "boolean"
        }
      }
    },
    "evidence_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_family",
          "claim",
          "evidence_grade",
          "evidence_source",
          "population_or_context",
          "does_not_prove",
          "expiry_date",
          "early_expiry_triggers",
          "owner",
          "renewal_or_repilot_trigger",
          "public_claim_to_remove_if_weak"
        ],
        "properties": {
          "claim_family": {
            "type": "string",
            "enum": [
              "CL-LEARN",
              "CL-TASK",
              "CL-ACCESS",
              "CL-WORKLOAD",
              "CL-VALIDITY",
              "CL-SAFETY",
              "CL-SECURITY",
              "CL-CONTEST",
              "CL-COMPLIANCE"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 4
          },
          "evidence_grade": {
            "type": "string",
            "enum": [
              "EV0",
              "EV1",
              "EV2",
              "EV3",
              "EV4",
              "EV5",
              "EV6",
              "EV7"
            ]
          },
          "evidence_source": {
            "type": "string",
            "minLength": 2
          },
          "population_or_context": {
            "type": "string",
            "minLength": 2
          },
          "does_not_prove": {
            "type": "string",
            "minLength": 4
          },
          "expiry_date": {
            "type": "string",
            "format": "date"
          },
          "early_expiry_triggers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "owner": {
            "type": "string",
            "minLength": 2
          },
          "renewal_or_repilot_trigger": {
            "type": "string",
            "minLength": 2
          },
          "public_claim_to_remove_if_weak": {
            "type": "string",
            "minLength": 4
          }
        }
      }
    },
    "construct_and_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construct_or_support_duty",
        "ai_compatible_task_modes",
        "required_unaided_segment",
        "cognitive_effort_budget",
        "disclosure_rule",
        "proof_bundle",
        "authentication_or_checkpoint_route",
        "contest_or_reconsideration_route"
      ],
      "properties": {
        "construct_or_support_duty": {
          "type": "string",
          "minLength": 4
        },
        "ai_compatible_task_modes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "required_unaided_segment": {
          "type": "string",
          "minLength": 2
        },
        "cognitive_effort_budget": {
          "type": "string",
          "enum": [
            "CE0",
            "CE1",
            "CE2",
            "CE3",
            "CE4",
            "CE5"
          ]
        },
        "disclosure_rule": {
          "type": "string",
          "minLength": 2
        },
        "proof_bundle": {
          "type": "string",
          "minLength": 2
        },
        "authentication_or_checkpoint_route": {
          "type": "string",
          "minLength": 2
        },
        "contest_or_reconsideration_route": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "accessibility_and_protected_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessibility_features_verified",
        "protected_route_owner",
        "no_penalty_fallback",
        "bias_or_subgroup_check",
        "non_misuse_boundary"
      ],
      "properties": {
        "accessibility_features_verified": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "protected_route_owner": {
          "type": "string",
          "minLength": 2
        },
        "no_penalty_fallback": {
          "type": "string",
          "minLength": 2
        },
        "bias_or_subgroup_check": {
          "type": "string",
          "minLength": 2
        },
        "non_misuse_boundary": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sec_level",
        "prompt_injection_exposure",
        "retrieved_or_uploaded_content_risk",
        "tool_or_action_misuse_risk",
        "data_exfiltration_check",
        "red_team_or_abuse_test_date",
        "incident_reconstruction_without_surveillance",
        "safe_degradation_and_manual_fallback"
      ],
      "properties": {
        "sec_level": {
          "type": "string",
          "enum": [
            "SEC0",
            "SEC1",
            "SEC2",
            "SEC3",
            "SECX"
          ]
        },
        "prompt_injection_exposure": {
          "type": "string",
          "minLength": 2
        },
        "retrieved_or_uploaded_content_risk": {
          "type": "string",
          "minLength": 2
        },
        "tool_or_action_misuse_risk": {
          "type": "string",
          "minLength": 2
        },
        "data_exfiltration_check": {
          "type": "string",
          "minLength": 2
        },
        "red_team_or_abuse_test_date": {
          "type": "string",
          "format": "date"
        },
        "incident_reconstruction_without_surveillance": {
          "type": "string",
          "minLength": 2
        },
        "safe_degradation_and_manual_fallback": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teacher_review_burden",
        "support_staff_burden",
        "security_or_it_burden",
        "known_failure_modes"
      ],
      "properties": {
        "teacher_review_burden": {
          "type": "string",
          "minLength": 2
        },
        "support_staff_burden": {
          "type": "string",
          "minLength": 2
        },
        "security_or_it_burden": {
          "type": "string",
          "minLength": 2
        },
        "known_failure_modes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "conditions",
        "maximum_allowed_authority",
        "maximum_allowed_memory",
        "required_human_coverage",
        "required_proof_or_audit",
        "stop_triggers",
        "learner_safe_continuity_plan",
        "next_review_date",
        "public_summary_allowed"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "pilot",
            "scale",
            "narrow",
            "pause",
            "retreat",
            "retire"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "maximum_allowed_authority": {
          "type": "string",
          "enum": [
            "AA0",
            "AA1",
            "AA2",
            "AA3",
            "AA4",
            "AA5",
            "AA6"
          ]
        },
        "maximum_allowed_memory": {
          "type": "string",
          "enum": [
            "M0",
            "M1",
            "M2",
            "M3"
          ]
        },
        "required_human_coverage": {
          "type": "string",
          "minLength": 2
        },
        "required_proof_or_audit": {
          "type": "string",
          "minLength": 2
        },
        "stop_triggers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "learner_safe_continuity_plan": {
          "type": "string",
          "minLength": 2
        },
        "next_review_date": {
          "type": "string",
          "format": "date"
        },
        "public_summary_allowed": {
          "type": "boolean"
        }
      }
    },
    "public_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what_the_service_does",
        "what_it_does_not_do",
        "required_or_optional",
        "data_used_high_level",
        "ai_output_record_effect",
        "human_contact_or_appeal_route",
        "accessibility_and_alternative_path",
        "claim_limits",
        "last_reviewed"
      ],
      "properties": {
        "what_the_service_does": {
          "type": "string",
          "minLength": 4
        },
        "what_it_does_not_do": {
          "type": "string",
          "minLength": 4
        },
        "required_or_optional": {
          "type": "string",
          "minLength": 2
        },
        "data_used_high_level": {
          "type": "string",
          "minLength": 2
        },
        "ai_output_record_effect": {
          "type": "string",
          "minLength": 2
        },
        "human_contact_or_appeal_route": {
          "type": "string",
          "minLength": 2
        },
        "accessibility_and_alternative_path": {
          "type": "string",
          "minLength": 2
        },
        "claim_limits": {
          "type": "string",
          "minLength": 4
        },
        "last_reviewed": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "publication_and_adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_status",
        "source_record_confidence",
        "sector_adapter_ids",
        "public_summary_redaction_profiles",
        "default_public_summary_redaction_profile",
        "normalization_notes",
        "real_record_import_status"
      ],
      "properties": {
        "source_record_status": {
          "type": "string",
          "enum": [
            "realistic_example",
            "synthetic_backtest",
            "template_only",
            "operator_drafted",
            "real_pilot_imported",
            "real_pilot_pending"
          ]
        },
        "source_record_confidence": {
          "type": "string",
          "enum": [
            "example_only",
            "operator_drafted",
            "record_owner_verified",
            "learner_facing_confirmed",
            "mixed_or_conflicting"
          ]
        },
        "sector_adapter_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ADAPT-[A-Z0-9-]+$"
          },
          "minItems": 1
        },
        "public_summary_redaction_profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^RDP-[A-Z0-9-]+$"
          },
          "minItems": 1
        },
        "default_public_summary_redaction_profile": {
          "type": "string",
          "pattern": "^RDP-[A-Z0-9-]+$"
        },
        "normalization_notes": {
          "type": "string",
          "minLength": 4
        },
        "real_record_import_status": {
          "type": "string",
          "enum": [
            "not_applicable_example",
            "ready_for_real_import",
            "imported_and_verified",
            "imported_needs_review",
            "blocked"
          ]
        }
      }
    }
  }
}
