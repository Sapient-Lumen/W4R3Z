{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/ft0181-closure-evidence-checklist.schema.json",
  "title": "AI-EDU FT-0181 closure evidence checklist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checklist_id",
    "revision",
    "checklist_state",
    "related_followthrough_ids",
    "closure_ready",
    "evidence_items",
    "missing_required_evidence",
    "available_preimport_controls",
    "last_reviewed"
  ],
  "properties": {
    "checklist_id": {
      "type": "string",
      "pattern": "^CL-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "checklist_state": {
      "type": "string",
      "enum": [
        "CL0",
        "CL1",
        "CL2",
        "CL3",
        "CL4",
        "CLX"
      ]
    },
    "related_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "closure_ready": {
      "type": "boolean"
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "missing_required_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "available_preimport_controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
