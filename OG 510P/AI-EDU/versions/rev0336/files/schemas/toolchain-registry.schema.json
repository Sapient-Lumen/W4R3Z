{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-EDU toolchain registry",
  "type": "object",
  "required": [
    "registry_id",
    "revision",
    "purpose",
    "source_of_truth_rule",
    "lint_order",
    "lint_lanes",
    "generated_artifacts",
    "utility_tools",
    "coverage_rules"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "pattern": "^TCR-"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "purpose": {
      "type": "string"
    },
    "source_of_truth_rule": {
      "type": "string"
    },
    "lint_order": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "order",
          "path",
          "role"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "pattern": "^tools/.+\\.py$"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "generated_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "generated_by",
          "check"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "generated_by": {
            "type": "string"
          },
          "check": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "utility_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^tools/.+\\.py$"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "coverage_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lint_lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lane_id",
          "description",
          "selection"
        ],
        "properties": {
          "lane_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": {
            "type": "string"
          },
          "selection": {
            "type": "string",
            "enum": [
              "all",
              "paths"
            ]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^tools/.+\\.py$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
