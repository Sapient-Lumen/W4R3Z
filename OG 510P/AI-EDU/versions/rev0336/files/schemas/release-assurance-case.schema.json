{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/release-assurance-case.schema.json",
  "title": "AI-EDU ready-but-not-closed release assurance case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "revision",
    "assurance_state",
    "top_claim",
    "live_followthrough_ids",
    "release_candidate_ids",
    "audit_manifest_ids",
    "synthetic_declaration_ids",
    "policy_exception_ids",
    "closeout_ids",
    "claim_rows",
    "forbidden_claims",
    "unresolved_external_blocks",
    "decision",
    "last_reviewed"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^AC-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "assurance_state": {
      "type": "string",
      "enum": [
        "AC0",
        "AC1",
        "AC2",
        "AC3",
        "AC4",
        "ACX"
      ]
    },
    "top_claim": {
      "type": "string"
    },
    "live_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "release_candidate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audit_manifest_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "synthetic_declaration_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_exception_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "closeout_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_rows": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "forbidden_claims": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "unresolved_external_blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
