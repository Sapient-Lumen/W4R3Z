{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/release-candidate-state.schema.json",
  "title": "AI-EDU release candidate state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "revision",
    "title",
    "state",
    "allowed_to_ship",
    "claims_all_followthrough_closed",
    "open_followthrough_ids",
    "externally_gated_followthrough_ids",
    "required_lint_checks",
    "no_fake_import_assertion",
    "unresolved_blocks",
    "next_unblocker",
    "last_reviewed"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^RC-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "state": {
      "type": "string",
      "enum": [
        "RC0",
        "RC1",
        "RC2",
        "RC3",
        "RC4",
        "RC5",
        "RCX"
      ]
    },
    "allowed_to_ship": {
      "type": "boolean"
    },
    "claims_all_followthrough_closed": {
      "type": "boolean"
    },
    "open_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "externally_gated_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_lint_checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "no_fake_import_assertion": {
      "type": "boolean"
    },
    "unresolved_blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_unblocker": {
      "type": "string",
      "minLength": 4
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
