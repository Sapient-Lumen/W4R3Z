{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/recovery-drill.schema.json",
  "title": "AI-EDU recovery drill packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "drill_packet_id",
    "revision",
    "drill_state",
    "related_followthrough_ids",
    "scenarios",
    "no_closure_claim",
    "last_reviewed"
  ],
  "properties": {
    "drill_packet_id": {
      "type": "string",
      "pattern": "^DR-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "drill_state": {
      "type": "string",
      "enum": [
        "DR0",
        "DR1",
        "DR2",
        "DR3",
        "DR4",
        "DRX"
      ]
    },
    "related_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "no_closure_claim": {
      "type": "boolean"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
