{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/real-data-request.schema.json",
  "title": "AI-EDU minimum real data request packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "title",
    "related_followthrough",
    "status",
    "source_truth_class_required",
    "first_sprint_scope",
    "outreach_preflight",
    "owner_reply_intake",
    "minimum_packet_fields",
    "prohibited_transfer_fields",
    "owner_attestations",
    "acceptable_aggregate_metrics",
    "decision_delta_questions",
    "redaction_before_transfer",
    "stop_conditions",
    "last_reviewed"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^RDR-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "related_followthrough": {
      "type": "string",
      "pattern": "^FT-[0-9]{4}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "sent",
        "received",
        "blocked"
      ]
    },
    "source_truth_class_required": {
      "type": "string",
      "enum": [
        "SRC2",
        "SRC3",
        "SRC4"
      ]
    },
    "minimum_packet_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 4
    },
    "prohibited_transfer_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 4
    },
    "owner_attestations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "acceptable_aggregate_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "decision_delta_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "redaction_before_transfer": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "first_sprint_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_service_record_id",
        "fallback_service_record_id",
        "scope_rule",
        "packet_ceiling",
        "field_survival_categories",
        "fallback_conditions"
      ],
      "properties": {
        "selected_service_record_id": {
          "type": "string",
          "pattern": "^AIEDU-SR-[0-9]{3}$"
        },
        "fallback_service_record_id": {
          "type": "string",
          "pattern": "^AIEDU-SR-[0-9]{3}$"
        },
        "scope_rule": {
          "type": "string",
          "minLength": 12
        },
        "packet_ceiling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "services",
            "owners",
            "date_ranges",
            "source_systems",
            "raw_learner_data_allowed"
          ],
          "properties": {
            "services": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            },
            "owners": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "date_ranges": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            },
            "source_systems": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            },
            "raw_learner_data_allowed": {
              "type": "boolean"
            }
          }
        },
        "field_survival_categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 6
        },
        "fallback_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        }
      }
    },
    "outreach_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_contact_surface",
        "selected_contact_service_id",
        "first_owner_roles",
        "why_this_service_first",
        "owner_time_ceiling_minutes",
        "response_clock",
        "success_definition",
        "silence_or_refusal_rule",
        "do_not_wait_for"
      ],
      "properties": {
        "first_contact_surface": {
          "type": "string",
          "minLength": 4
        },
        "selected_contact_service_id": {
          "type": "string",
          "pattern": "^AIEDU-SR-[0-9]{3}$"
        },
        "first_owner_roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "why_this_service_first": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3
        },
        "owner_time_ceiling_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 10,
          "description": "Maximum time target for the first owner reply; ready requests must fit the eight-row owner reply sheet."
        },
        "response_clock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial_response_business_days",
            "follow_up_count",
            "no_response_after_business_days",
            "default_no_response_outcome"
          ],
          "properties": {
            "initial_response_business_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "follow_up_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "no_response_after_business_days": {
              "type": "integer",
              "minimum": 2,
              "maximum": 15
            },
            "default_no_response_outcome": {
              "type": "string",
              "minLength": 4
            }
          }
        },
        "success_definition": {
          "type": "string",
          "minLength": 12
        },
        "silence_or_refusal_rule": {
          "type": "string",
          "minLength": 12
        },
        "do_not_wait_for": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3
        }
      }
    },
    "owner_reply_intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reply_sheet_surface",
        "reply_template_path",
        "triage_tool_path",
        "receipt_output_rule",
        "receipt_tool_path",
        "staging_note_template_path",
        "staging_tool_path",
        "core_reply_rows",
        "accepted_initial_outcomes",
        "no_packet_outcome",
        "intake_rules",
        "local_only_exclusions",
        "outcome_routes",
        "smoke_tool_path",
        "synthetic_smoke_fixture_path",
        "staging_source_class_guard",
        "intake_tool_path",
        "intake_bundle_output_rule",
        "workbench_seed_tool_path",
        "workbench_seed_doc_surface",
        "workbench_seed_output_rule"
      ],
      "properties": {
        "reply_sheet_surface": {
          "type": "string",
          "minLength": 4
        },
        "core_reply_rows": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 8,
          "maxItems": 8
        },
        "accepted_initial_outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 5
        },
        "no_packet_outcome": {
          "type": "string",
          "minLength": 4
        },
        "intake_rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 4
        },
        "local_only_exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3
        },
        "reply_template_path": {
          "type": "string",
          "minLength": 4,
          "description": "CSV or template path for the exact eight-row owner reply form."
        },
        "triage_tool_path": {
          "type": "string",
          "minLength": 4,
          "description": "Local CLI used to classify a returned eight-row owner reply CSV before workbench import."
        },
        "outcome_routes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "description": "Outcome-specific next artifact/action routes for returned owner-reply triage results.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome",
              "next_artifact",
              "action",
              "no_widening_rule"
            ],
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "PROCEED-STAGED",
                  "RE-ASK-ONCE",
                  "NO-OWNER-PACKET",
                  "BLOCK-OVERBROAD",
                  "BLOCK-PROTECTED",
                  "BLOCK-SECURITY",
                  "BLOCK-AUTHORITY",
                  "BLOCK-EVIDENCE"
                ]
              },
              "next_artifact": {
                "type": "string",
                "minLength": 4
              },
              "action": {
                "type": "string",
                "minLength": 12
              },
              "no_widening_rule": {
                "type": "string",
                "minLength": 12
              }
            }
          }
        },
        "staging_tool_path": {
          "type": "string",
          "minLength": 4
        },
        "staging_note_template_path": {
          "type": "string",
          "minLength": 4
        },
        "smoke_tool_path": {
          "type": "string",
          "minLength": 4,
          "description": "Local smoke-test CLI proving the owner-reply triage -> staging path runs on a synthetic fixture without creating evidence."
        },
        "synthetic_smoke_fixture_path": {
          "type": "string",
          "minLength": 4,
          "description": "SRC0 synthetic CSV fixture for end-to-end owner-reply pipeline smoke testing."
        },
        "staging_source_class_guard": {
          "type": "object",
          "required": [
            "normal_staging_allowed_source_class",
            "blocked_source_class",
            "normal_stage_guard",
            "smoke_output_guard",
            "archive_rule"
          ],
          "additionalProperties": false,
          "properties": {
            "normal_staging_allowed_source_class": {
              "const": "UNVERIFIED-OWNER-REPLY"
            },
            "blocked_source_class": {
              "const": "SRC0-SMOKE"
            },
            "normal_stage_guard": {
              "type": "string",
              "minLength": 20
            },
            "smoke_output_guard": {
              "type": "string",
              "minLength": 20
            },
            "archive_rule": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "receipt_tool_path": {
          "type": "string",
          "minLength": 4,
          "description": "Local CLI used to create a content-minimized receipt/fingerprint for a returned owner reply CSV before staging or archive copy."
        },
        "receipt_output_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_output_scope",
            "blocked_output_roots",
            "content_copied",
            "claim_ceiling"
          ],
          "properties": {
            "allowed_output_scope": {
              "type": "string",
              "minLength": 12
            },
            "blocked_output_roots": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 5
            },
            "content_copied": {
              "const": false
            },
            "claim_ceiling": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "intake_tool_path": {
          "type": "string",
          "minLength": 4,
          "description": "Local CLI that runs the bounded receipt -> triage -> routed local artifact bundle for a returned owner reply CSV."
        },
        "intake_bundle_output_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_output_scope",
            "blocked_output_roots",
            "writes_receipt",
            "writes_triage",
            "writes_staging_only_when_proceed_staged",
            "content_copied",
            "claim_ceiling"
          ],
          "properties": {
            "allowed_output_scope": {
              "type": "string",
              "minLength": 12
            },
            "blocked_output_roots": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 5
            },
            "writes_receipt": {
              "const": true
            },
            "writes_triage": {
              "const": true
            },
            "writes_staging_only_when_proceed_staged": {
              "const": true
            },
            "content_copied": {
              "const": false
            },
            "claim_ceiling": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "workbench_seed_tool_path": {
          "type": "string",
          "minLength": 4,
          "description": "Local CLI that creates a content-minimized workbench seed from a PROCEED-STAGED intake bundle without copying owner answers or accepting evidence."
        },
        "workbench_seed_doc_surface": {
          "type": "string",
          "minLength": 4,
          "description": "Operational surface for the bounded owner-reply workbench seed step."
        },
        "workbench_seed_output_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_output_scope",
            "blocked_output_roots",
            "requires_proceed_staged",
            "content_copied",
            "acceptance_state",
            "claim_ceiling"
          ],
          "properties": {
            "allowed_output_scope": {
              "type": "string",
              "minLength": 12
            },
            "blocked_output_roots": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 5
            },
            "requires_proceed_staged": {
              "const": true
            },
            "content_copied": {
              "const": false
            },
            "acceptance_state": {
              "const": "NOT_ACCEPTED"
            },
            "claim_ceiling": {
              "type": "string",
              "minLength": 20
            }
          }
        }
      }
    }
  }
}
