{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/live-window-readout.schema.json",
  "title": "AI-EDU live-window readout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "readout_id",
    "title",
    "related_followthrough",
    "service_record_id",
    "live_window_card_id",
    "readout_state",
    "source_truth_class",
    "window_disposition",
    "closure_permitted",
    "aggregate_evidence_read",
    "claim_family_effects",
    "decision_delta_allowed",
    "fields_to_trim_before_next_request",
    "rollback_or_stop_outcome",
    "public_language_after_readout",
    "next_action",
    "reviewer_calibration",
    "closure_boundary",
    "last_reviewed"
  ],
  "properties": {
    "readout_id": {"type": "string", "pattern": "^LWR-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 4},
    "related_followthrough": {"type": "string", "pattern": "^FT-[0-9]{4}$"},
    "service_record_id": {"type": "string"},
    "live_window_card_id": {"type": "string", "pattern": "^LWC-[A-Z0-9-]+$"},
    "readout_state": {"type": "string", "enum": ["blocked_no_real_packet", "blocked_incomplete_window", "ready_for_readout", "readout_complete", "quarantined"]},
    "source_truth_class": {"type": "string", "enum": ["SRC0", "SRC1", "SRC2", "SRC3", "SRC4", "SRCX"]},
    "window_disposition": {"type": "string", "enum": ["blocked_no_real_packet", "stopped", "rolled_back", "continue_bounded", "rerun_narrower", "quarantine", "no_change"]},
    "closure_permitted": {"type": "boolean"},
    "aggregate_evidence_read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted_before_hint", "answer_giving_or_construct", "fallback_or_opt_out", "stop_trigger_counts", "workload_minutes", "notice_and_non_ai_route", "field_survival"],
      "properties": {
        "attempted_before_hint": {"type": "string"},
        "answer_giving_or_construct": {"type": "string"},
        "fallback_or_opt_out": {"type": "string"},
        "stop_trigger_counts": {"type": "string"},
        "workload_minutes": {"type": "string"},
        "notice_and_non_ai_route": {"type": "string"},
        "field_survival": {"type": "string"}
      }
    },
    "claim_family_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_family", "pre_window_claim_ceiling", "aggregate_evidence_read", "decision_effect", "public_phrase_after_readout", "what_this_does_not_prove"],
        "properties": {
          "claim_family": {"type": "string", "pattern": "^CL-[A-Z]+$"},
          "pre_window_claim_ceiling": {"type": "string"},
          "aggregate_evidence_read": {"type": "string"},
          "decision_effect": {"type": "string", "enum": ["strengthen", "unchanged", "narrow", "remove", "unmade"]},
          "public_phrase_after_readout": {"type": "string"},
          "what_this_does_not_prove": {"type": "string", "minLength": 8}
        }
      }
    },
    "decision_delta_allowed": {"type": "array", "items": {"type": "string"}},
    "fields_to_trim_before_next_request": {"type": "array", "items": {"type": "string"}},
    "rollback_or_stop_outcome": {"type": "string", "minLength": 4},
    "public_language_after_readout": {"type": "string", "minLength": 4},
    "next_action": {"type": "string", "minLength": 4},
    "reviewer_calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_count", "unresolved_disagreements", "calibration_required_before_closure"],
      "properties": {
        "reviewer_count": {"type": "integer", "minimum": 1},
        "unresolved_disagreements": {"type": "array", "items": {"type": "string"}},
        "calibration_required_before_closure": {"type": "boolean"}
      }
    },
    "closure_boundary": {"type": "string", "minLength": 8},
    "last_reviewed": {"type": "string", "format": "date"}
  }
}
