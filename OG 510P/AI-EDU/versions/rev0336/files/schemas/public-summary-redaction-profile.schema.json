{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/public-summary-redaction-profile.schema.json",
  "title": "AI-EDU public summary redaction profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "audience",
    "publication_band",
    "allowed_public_summary_fields",
    "suppressed_detail_categories",
    "mandatory_messages",
    "forbidden_phrases",
    "protected_support_phrase",
    "security_detail_phrase",
    "requires_human_contact",
    "freshness_required"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^RDP-[A-Z0-9-]+$"
    },
    "audience": {
      "type": "string"
    },
    "publication_band": {
      "type": "string",
      "enum": [
        "PUB0",
        "PUB1",
        "PUB2",
        "PUB3",
        "PUB4",
        "PUBX"
      ]
    },
    "allowed_public_summary_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "suppressed_detail_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "mandatory_messages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "forbidden_phrases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "protected_support_phrase": {
      "type": "string",
      "minLength": 4
    },
    "security_detail_phrase": {
      "type": "string",
      "minLength": 4
    },
    "requires_human_contact": {
      "type": "boolean"
    },
    "freshness_required": {
      "type": "string",
      "enum": [
        "review_date",
        "evidence_fresh_or_claim_removed",
        "not_public"
      ]
    }
  }
}
