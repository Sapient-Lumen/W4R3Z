{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/evidence-refresh-calendar.schema.json",
  "title": "AI-EDU evidence refresh calendar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calendar_id",
    "revision",
    "refresh_state",
    "watchlist_ids",
    "rows",
    "staleness_rule",
    "last_reviewed"
  ],
  "properties": {
    "calendar_id": {"type": "string", "pattern": "^ER-[A-Z0-9-]+$"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "refresh_state": {"type": "string", "enum": ["ER0", "ER1", "ER2", "ER3", "ER4", "ERX"]},
    "watchlist_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "rows": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "staleness_rule": {"type": "string"},
    "last_reviewed": {"type": "string", "format": "date"}
  }
}
