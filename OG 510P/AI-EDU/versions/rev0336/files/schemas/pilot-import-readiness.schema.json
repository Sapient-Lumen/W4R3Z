{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/pilot-import-readiness.schema.json",
  "title": "AI-EDU pilot import readiness manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "title",
    "related_followthrough",
    "readiness_state",
    "source_truth_class",
    "closure_permitted",
    "candidate_service_record_ids",
    "import_map_ids",
    "source_inventory_required",
    "required_before_real_import",
    "protected_exclusions",
    "decision_delta_requirements",
    "stop_conditions",
    "last_reviewed"
  ],
  "properties": {
    "manifest_id": {"type": "string", "pattern": "^IMP-READY-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 4},
    "related_followthrough": {"type": "string", "pattern": "^FT-[0-9]{4}$"},
    "readiness_state": {"type": "string", "enum": ["IR0", "IR1", "IR2", "IR3", "IR4", "IR5", "IR6", "IRX"]},
    "source_truth_class": {"type": "string", "enum": ["SRC0", "SRC1", "SRC2", "SRC3", "SRC4", "SRCX"]},
    "closure_permitted": {"type": "boolean"},
    "candidate_service_record_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "import_map_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "source_inventory_required": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "required_before_real_import": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "protected_exclusions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "decision_delta_requirements": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "stop_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "last_reviewed": {"type": "string", "format": "date"}
  }
}
