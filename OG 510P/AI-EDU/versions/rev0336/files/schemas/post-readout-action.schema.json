{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/post-readout-action.schema.json",
  "title": "AI-EDU post-readout action dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "title",
    "related_followthrough",
    "service_record_id",
    "readout_id",
    "action_state",
    "dispatch_lane",
    "source_truth_class",
    "closure_permitted",
    "owner_action",
    "allowed_actions_before_next_review",
    "prohibited_actions_before_next_review",
    "next_evidence_ask",
    "fields_to_reask",
    "fields_to_drop",
    "public_language_action",
    "due_or_recheck_date",
    "closure_boundary",
    "last_reviewed"
  ],
  "properties": {
    "action_id": {"type": "string", "pattern": "^PRA-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 4},
    "related_followthrough": {"type": "string", "pattern": "^FT-[0-9]{4}$"},
    "service_record_id": {"type": "string"},
    "readout_id": {"type": "string", "pattern": "^LWR-[A-Z0-9-]+$"},
    "action_state": {"type": "string", "enum": ["blocked_no_real_readout", "ready_for_owner_action", "owner_action_complete", "quarantined", "rolled_back", "closed_no_change"]},
    "dispatch_lane": {"type": "string", "enum": ["blocked_no_real_packet", "stop", "rollback_confirmed", "rerun_narrower", "continue_same_ceiling", "quarantine", "no_change_trim"]},
    "source_truth_class": {"type": "string", "enum": ["SRC0", "SRC1", "SRC2", "SRC3", "SRC4", "SRCX"]},
    "closure_permitted": {"type": "boolean"},
    "owner_action": {"type": "string", "minLength": 4},
    "allowed_actions_before_next_review": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "prohibited_actions_before_next_review": {"type": "array", "items": {"type": "string"}, "minItems": 2},
    "next_evidence_ask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_route", "date_range", "packet_ceiling", "decision_question", "field_minimization_rule", "fallback_if_unavailable"],
      "properties": {
        "owner_route": {"type": "string", "minLength": 4},
        "date_range": {"type": "string", "minLength": 4},
        "packet_ceiling": {"type": "string", "minLength": 4},
        "decision_question": {"type": "string", "minLength": 4},
        "field_minimization_rule": {"type": "string", "minLength": 4},
        "fallback_if_unavailable": {"type": "string", "minLength": 4}
      }
    },
    "fields_to_reask": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "fields_to_drop": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "public_language_action": {"type": "string", "minLength": 4},
    "due_or_recheck_date": {"type": "string", "format": "date"},
    "closure_boundary": {"type": "string", "minLength": 8},
    "last_reviewed": {"type": "string", "format": "date"}
  }
}
