{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/control-coverage-matrix.schema.json",
  "title": "AI-EDU control coverage matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrix_id",
    "revision",
    "coverage_state",
    "related_followthrough_ids",
    "controls",
    "negative_fixture_classes_covered",
    "release_boundaries",
    "last_reviewed"
  ],
  "properties": {
    "matrix_id": {"type": "string", "pattern": "^CCM-[A-Z0-9-]+$"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "coverage_state": {"type": "string", "enum": ["CCM0", "CCM1", "CCM2", "CCM3", "CCM4", "CCMX"]},
    "related_followthrough_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "controls": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "negative_fixture_classes_covered": {"type": "array", "items": {"type": "string"}},
    "release_boundaries": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "last_reviewed": {"type": "string", "format": "date"}
  }
}
