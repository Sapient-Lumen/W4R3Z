{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-EDU Surface Contracts Registry",
  "type": "object",
  "required": [
    "registry_id",
    "revision",
    "purpose",
    "source_of_truth_rule",
    "coverage_rules",
    "contracts"
  ],
  "properties": {
    "registry_id": {"type": "string"},
    "revision": {"type": "string"},
    "purpose": {"type": "string"},
    "source_of_truth_rule": {"type": "string"},
    "coverage_rules": {"type": "array", "items": {"type": "string"}},
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "contract_class",
          "expected_type",
          "expected_lifecycle",
          "expected_owner",
          "expected_authority",
          "expected_portability",
          "required_evidence_levels",
          "required_tags",
          "forbidden_tags",
          "required_quality",
          "closure_boundary"
        ],
        "properties": {
          "path": {"type": "string"},
          "contract_class": {"type": "string"},
          "expected_type": {"type": "string"},
          "expected_lifecycle": {"type": "string"},
          "expected_owner": {"type": "string"},
          "expected_authority": {"type": "string"},
          "expected_portability": {"type": "string"},
          "required_evidence_levels": {"type": "array", "items": {"type": "string"}},
          "required_tags": {"type": "array", "items": {"type": "string"}},
          "forbidden_tags": {"type": "array", "items": {"type": "string"}},
          "required_quality": {"type": "string"},
          "closure_boundary": {"type": "string"}
        }
      }
    }
  }
}
