{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/evidence-custody-workbench.schema.json",
  "title": "AI-EDU evidence custody workbench",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "custody_id",
    "revision",
    "custody_stage",
    "related_followthrough_ids",
    "source_packet_class",
    "raw_data_committed",
    "protected_fields_policy",
    "security_payload_policy",
    "derived_artifacts",
    "may_close_ft0181",
    "last_reviewed"
  ],
  "properties": {
    "custody_id": {
      "type": "string",
      "pattern": "^CUST-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "custody_stage": {
      "type": "string",
      "enum": [
        "CUST0",
        "CUST1",
        "CUST2",
        "CUST3",
        "CUST4",
        "CUST5",
        "CUSTX"
      ]
    },
    "related_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "source_packet_class": {
      "type": "string"
    },
    "raw_data_committed": {
      "type": "boolean"
    },
    "protected_fields_policy": {
      "type": "string"
    },
    "security_payload_policy": {
      "type": "string"
    },
    "derived_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "may_close_ft0181": {
      "type": "boolean"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
