{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-EDU schema registry",
  "type": "object",
  "required": [
    "registry_id",
    "revision",
    "purpose",
    "source_of_truth_rule",
    "coverage_rules",
    "schemas"
  ],
  "properties": {
    "registry_id": {"type": "string", "pattern": "^SCR-"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "purpose": {"type": "string"},
    "source_of_truth_rule": {"type": "string"},
    "coverage_rules": {"type": "array", "items": {"type": "string"}},
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_id",
          "schema_path",
          "instance_globs",
          "validator",
          "doc_surface",
          "status",
          "closure_boundary"
        ],
        "properties": {
          "schema_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "schema_path": {"type": "string", "pattern": "^schemas/.+\\.schema\\.json$"},
          "instance_globs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "validator": {"type": "string", "pattern": "^tools/check_.+\\.py$"},
          "doc_surface": {"type": "string"},
          "status": {"type": "string", "enum": ["active", "generated", "release-control", "root-control"]},
          "closure_boundary": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
