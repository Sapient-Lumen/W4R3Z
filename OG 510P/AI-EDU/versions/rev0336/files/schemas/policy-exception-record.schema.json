{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/policy-exception-record.schema.json",
  "title": "AI-EDU policy exception record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exception_id",
    "revision",
    "exception_state",
    "active",
    "affected_followthrough_ids",
    "affected_surfaces",
    "requested_waiver",
    "non_waivable_controls_checked",
    "accountable_owner",
    "start_date",
    "expiry_date",
    "learner_facing_effect",
    "public_summary_effect",
    "rollback_route",
    "decision",
    "last_reviewed"
  ],
  "properties": {
    "exception_id": {
      "type": "string",
      "pattern": "^PX-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "exception_state": {
      "type": "string",
      "enum": [
        "PX0",
        "PX1",
        "PX2",
        "PX3",
        "PX4",
        "PXX"
      ]
    },
    "active": {
      "type": "boolean"
    },
    "affected_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested_waiver": {
      "type": "string"
    },
    "non_waivable_controls_checked": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "accountable_owner": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "learner_facing_effect": {
      "type": "string"
    },
    "public_summary_effect": {
      "type": "string"
    },
    "rollback_route": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
