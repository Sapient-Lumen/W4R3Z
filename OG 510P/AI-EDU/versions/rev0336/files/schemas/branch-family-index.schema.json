{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-EDU branch family index",
  "type": "object",
  "required": ["project", "revision", "status", "generated_by", "branch_detection_rule", "stats", "families", "maintenance_note"],
  "properties": {
    "project": {"const": "AI-EDU"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "status": {"const": "branch-family-index"},
    "generated_by": {"type": "string"},
    "branch_detection_rule": {"type": "string"},
    "stats": {"type": "object"},
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family_id", "description", "count", "preferred_entry", "canonical_compression", "refactor_posture", "new_branch_rule", "paths"],
        "properties": {
          "family_id": {"type": "string"},
          "description": {"type": "string"},
          "count": {"type": "integer", "minimum": 1},
          "preferred_entry": {"type": "string"},
          "canonical_compression": {"type": "string"},
          "refactor_posture": {"enum": ["archive_in_place_with_family_index", "candidate_for_redirect_migration", "active_canonical_family"]},
          "new_branch_rule": {"type": "string"},
          "paths": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "maintenance_note": {"type": "string"}
  }
}
