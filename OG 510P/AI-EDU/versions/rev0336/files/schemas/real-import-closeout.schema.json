{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/real-import-closeout.schema.json",
  "title": "AI-EDU real import closeout board minutes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "closeout_id",
    "title",
    "revision",
    "related_followthrough",
    "closeout_state",
    "source_truth_class",
    "closure_permitted",
    "referenced_manifest_ids",
    "referenced_acceptance_ids",
    "referenced_release_candidate_ids",
    "candidate_service_record_ids",
    "lifecycle_decision_ids",
    "decision_delta_summary",
    "public_summary_actions",
    "evaluator_independence_attestation",
    "unresolved_blocks",
    "decision",
    "last_reviewed"
  ],
  "properties": {
    "closeout_id": {
      "type": "string",
      "pattern": "^CB-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "related_followthrough": {
      "type": "string",
      "pattern": "^FT-[0-9]{4}$"
    },
    "closeout_state": {
      "type": "string",
      "enum": [
        "CB0",
        "CB1",
        "CB2",
        "CB3",
        "CB4",
        "CB5",
        "CB6",
        "CBX"
      ]
    },
    "source_truth_class": {
      "type": "string",
      "enum": [
        "SRC0",
        "SRC1",
        "SRC2",
        "SRC3",
        "SRC4",
        "SRCX"
      ]
    },
    "closure_permitted": {
      "type": "boolean"
    },
    "referenced_manifest_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "referenced_acceptance_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "referenced_release_candidate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_service_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lifecycle_decision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_delta_summary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "public_summary_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evaluator_independence_attestation": {
      "type": "string",
      "minLength": 4
    },
    "unresolved_blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": "string",
      "minLength": 4
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    }
  }
}
