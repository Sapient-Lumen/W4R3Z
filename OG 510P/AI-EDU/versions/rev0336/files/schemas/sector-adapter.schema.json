{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/sector-adapter.schema.json",
  "title": "AI-EDU service-record sector adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_id",
    "sector_family",
    "trigger_terms",
    "required_owner_fields",
    "minimum_action_ceiling",
    "maximum_default_memory",
    "required_public_redaction_profiles",
    "default_redaction_profile",
    "extra_public_notice_requirements",
    "hard_stop_conditions",
    "renewal_or_evidence_overrides",
    "record_separation_rules"
  ],
  "properties": {
    "adapter_id": {
      "type": "string",
      "pattern": "^ADAPT-[A-Z0-9-]+$"
    },
    "sector_family": {
      "type": "string"
    },
    "trigger_terms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "required_owner_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "minimum_action_ceiling": {
      "type": "string",
      "enum": [
        "AA0",
        "AA1",
        "AA2",
        "AA3",
        "AA4",
        "AA5",
        "AA6"
      ]
    },
    "maximum_default_memory": {
      "type": "string",
      "enum": [
        "M0",
        "M1",
        "M2",
        "M3"
      ]
    },
    "required_public_redaction_profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^RDP-[A-Z0-9-]+$"
      },
      "minItems": 1
    },
    "default_redaction_profile": {
      "type": "string",
      "pattern": "^RDP-[A-Z0-9-]+$"
    },
    "extra_public_notice_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "hard_stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "renewal_or_evidence_overrides": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "record_separation_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
