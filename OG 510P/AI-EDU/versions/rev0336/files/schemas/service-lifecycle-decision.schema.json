{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/service-lifecycle-decision.schema.json",
  "title": "AI-EDU service lifecycle decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "service_record_id",
    "service_name",
    "lifecycle_state",
    "decision",
    "evidence_expiry_result",
    "authority_ceiling",
    "public_summary_action",
    "continuity_plan",
    "retirement_or_watch_triggers",
    "decision_board_reference",
    "change_ticket",
    "live_window_control",
    "end_window_readout",
    "post_readout_action",
    "next_review_date",
    "last_reviewed"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^SLC-[A-Z0-9-]+$"
    },
    "service_record_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string",
      "minLength": 4
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "SLC0",
        "SLC1",
        "SLC2",
        "SLC3",
        "SLC4",
        "SLC5",
        "SLC6",
        "SLC7",
        "SLCX"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "idea_only",
        "sandbox",
        "pilot",
        "continue_bounded",
        "scale",
        "watch",
        "deprecate",
        "archive_only",
        "quarantine"
      ]
    },
    "evidence_expiry_result": {
      "type": "string",
      "enum": [
        "not_applicable_example",
        "current",
        "expiring_soon",
        "expired",
        "blocked",
        "unknown"
      ]
    },
    "authority_ceiling": {
      "type": "string",
      "pattern": "^AA[0-6]$"
    },
    "public_summary_action": {
      "type": "string",
      "enum": [
        "none",
        "draft",
        "publish_limited",
        "revise_claims",
        "remove_active_claims",
        "suppress"
      ]
    },
    "continuity_plan": {
      "type": "string",
      "minLength": 4
    },
    "retirement_or_watch_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2
    },
    "next_review_date": {
      "type": "string",
      "format": "date"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "decision_board_reference": {
      "type": "string",
      "minLength": 4
    },
    "change_ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticket_id",
        "ticket_state",
        "source_truth_required",
        "decision_delta_required",
        "allowed_changes",
        "prohibited_changes",
        "rollback_owner",
        "rollback_triggers",
        "public_claim_ceiling",
        "closure_boundary"
      ],
      "properties": {
        "ticket_id": {
          "type": "string",
          "pattern": "^PCT-[A-Z0-9-]+$"
        },
        "ticket_state": {
          "type": "string",
          "enum": [
            "blocked_no_real_packet",
            "blocked_incomplete_board",
            "ready_for_real_packet",
            "active_change",
            "rolled_back",
            "quarantined"
          ]
        },
        "source_truth_required": {
          "type": "string",
          "enum": [
            "SRC0",
            "SRC1",
            "SRC2",
            "SRC3",
            "SRC4",
            "SRCX"
          ]
        },
        "decision_delta_required": {
          "type": "boolean"
        },
        "allowed_changes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "prohibited_changes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "rollback_owner": {
          "type": "string",
          "minLength": 4
        },
        "rollback_triggers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "public_claim_ceiling": {
          "type": "string",
          "enum": [
            "example_only_no_outcome_claim",
            "draft_only",
            "limited_process_claim",
            "bounded_outcome_claim_with_expiry",
            "suppress"
          ]
        },
        "closure_boundary": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "live_window_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id",
        "window_state",
        "window_scope",
        "allowed_during_window",
        "prohibited_during_window",
        "stop_triggers",
        "rollback_owner",
        "rollback_steps",
        "evidence_readouts_required",
        "public_claim_freeze",
        "no_expansion_rule",
        "closure_boundary"
      ],
      "properties": {
        "window_id": {
          "type": "string",
          "pattern": "^LWC-[A-Z0-9-]+$"
        },
        "window_state": {
          "type": "string",
          "enum": [
            "blocked_no_real_packet",
            "blocked_incomplete_ticket",
            "staged",
            "active",
            "paused",
            "rolled_back",
            "completed_no_closure",
            "quarantined"
          ]
        },
        "window_scope": {
          "type": "string",
          "minLength": 8
        },
        "allowed_during_window": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "prohibited_during_window": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "stop_triggers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "rollback_owner": {
          "type": "string",
          "minLength": 4
        },
        "rollback_steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "evidence_readouts_required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "public_claim_freeze": {
          "type": "boolean"
        },
        "no_expansion_rule": {
          "type": "string",
          "minLength": 8
        },
        "closure_boundary": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "end_window_readout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readout_id",
        "readout_state",
        "source_truth_class",
        "window_disposition",
        "claim_family_effects_required",
        "public_language_after_readout",
        "closure_boundary"
      ],
      "properties": {
        "readout_id": {
          "type": "string",
          "pattern": "^LWR-[A-Z0-9-]+$"
        },
        "readout_state": {
          "type": "string",
          "enum": [
            "blocked_no_real_packet",
            "blocked_incomplete_window",
            "ready_for_readout",
            "readout_complete",
            "quarantined"
          ]
        },
        "source_truth_class": {
          "type": "string",
          "enum": [
            "SRC0",
            "SRC1",
            "SRC2",
            "SRC3",
            "SRC4",
            "SRCX"
          ]
        },
        "window_disposition": {
          "type": "string",
          "enum": [
            "blocked_no_real_packet",
            "stopped",
            "rolled_back",
            "continue_bounded",
            "rerun_narrower",
            "quarantine",
            "no_change"
          ]
        },
        "claim_family_effects_required": {
          "type": "boolean"
        },
        "public_language_after_readout": {
          "type": "string",
          "minLength": 4
        },
        "closure_boundary": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "post_readout_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "action_state",
        "dispatch_lane",
        "source_truth_class",
        "owner_action",
        "public_language_action",
        "closure_boundary"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^PRA-[A-Z0-9-]+$"
        },
        "action_state": {
          "type": "string",
          "enum": [
            "blocked_no_real_readout",
            "ready_for_owner_action",
            "owner_action_complete",
            "quarantined",
            "rolled_back",
            "closed_no_change"
          ]
        },
        "dispatch_lane": {
          "type": "string",
          "enum": [
            "blocked_no_real_packet",
            "stop",
            "rollback_confirmed",
            "rerun_narrower",
            "continue_same_ceiling",
            "quarantine",
            "no_change_trim"
          ]
        },
        "source_truth_class": {
          "type": "string",
          "enum": [
            "SRC0",
            "SRC1",
            "SRC2",
            "SRC3",
            "SRC4",
            "SRCX"
          ]
        },
        "owner_action": {
          "type": "string",
          "minLength": 4
        },
        "public_language_action": {
          "type": "string",
          "minLength": 4
        },
        "closure_boundary": {
          "type": "string",
          "minLength": 8
        }
      }
    }
  }
}
