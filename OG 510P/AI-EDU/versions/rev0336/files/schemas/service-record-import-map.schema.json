{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/service-record-import-map.schema.json",
  "title": "AI-EDU service-record import map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "map_id",
    "source_system",
    "source_owner",
    "source_truth_class",
    "target_schema_version",
    "field_mappings",
    "manual_review_fields",
    "do_not_import_fields",
    "redaction_before_commit",
    "stop_conditions",
    "decision_delta_questions"
  ],
  "properties": {
    "map_id": {
      "type": "string",
      "pattern": "^IMP-MAP-[A-Z0-9-]+$"
    },
    "source_system": {
      "type": "string"
    },
    "source_owner": {
      "type": "string"
    },
    "source_truth_class": {
      "type": "string",
      "enum": [
        "SRC0",
        "SRC1",
        "SRC2",
        "SRC3",
        "SRC4",
        "SRCX"
      ]
    },
    "target_schema_version": {
      "type": "string",
      "enum": [
        "1.1"
      ]
    },
    "field_mappings": {
      "type": "object"
    },
    "manual_review_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "do_not_import_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "redaction_before_commit": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "decision_delta_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
