{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/import-failure-fixture.schema.json",
  "title": "AI-EDU import failure fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "title",
    "related_followthrough",
    "fixture_class",
    "synthetic_only",
    "source_truth_class",
    "prohibited_material_present",
    "simulated_faults",
    "referenced_controls",
    "expected_blocks",
    "expected_disposition",
    "last_reviewed"
  ],
  "properties": {
    "fixture_id": {
      "type": "string",
      "pattern": "^IFF-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "related_followthrough": {
      "type": "string",
      "pattern": "^FT-[0-9]{4}$"
    },
    "fixture_class": {
      "type": "string",
      "enum": [
        "IFF0",
        "IFF1",
        "IFF2",
        "IFF3",
        "IFF4",
        "IFF5",
        "IFF6",
        "IFF7",
        "IFF8",
        "IFF9",
        "IFF10"
      ]
    },
    "synthetic_only": {
      "type": "boolean"
    },
    "source_truth_class": {
      "type": "string",
      "enum": [
        "SRC0",
        "SRC1",
        "SRC2",
        "SRC3",
        "SRC4",
        "SRCX"
      ]
    },
    "prohibited_material_present": {
      "type": "boolean"
    },
    "simulated_faults": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "referenced_controls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "expected_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "expected_failure",
          "blocks_closure"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 3
          },
          "expected_failure": {
            "type": "string",
            "minLength": 4
          },
          "blocks_closure": {
            "type": "boolean"
          }
        }
      }
    },
    "expected_disposition": {
      "type": "string",
      "enum": [
        "reject",
        "quarantine",
        "return_to_owner",
        "suppress_public_claim",
        "require_calibration",
        "trim_field"
      ]
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
