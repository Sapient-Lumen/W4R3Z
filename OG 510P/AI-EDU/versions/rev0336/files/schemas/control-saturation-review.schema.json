{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-edu/control-saturation-review.schema.json",
  "title": "AI-EDU control saturation review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "revision",
    "saturation_state",
    "related_followthrough_ids",
    "new_control_allowed",
    "uncovered_risks",
    "existing_controls_reviewed",
    "blocked_claims",
    "last_reviewed"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "pattern": "^SAT-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "saturation_state": {
      "type": "string",
      "enum": [
        "SAT0",
        "SAT1",
        "SAT2",
        "SAT3",
        "SAT4",
        "SATX"
      ]
    },
    "related_followthrough_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "new_control_allowed": {
      "type": "boolean"
    },
    "uncovered_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "existing_controls_reviewed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "blocked_claims": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
