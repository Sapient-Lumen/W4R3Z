{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glasstty.local/schemas/chatgpt-first-proof-bundle.schema.json",
  "title": "GlassTTY ChatGPT first proof bundle",
  "description": "Canonical machine-readable shape for the first plain-chat ChatGPT GLASSTTY-CHECKPOINT proof bundle. This schema is structural; semantic acceptance still requires scripts/chatgpt-first-proof-evaluator.py schema v20.",
  "type": "object",
  "required": ["surface_key", "attempt_id", "actions", "privacy_redaction_review"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "bundle_schema": {"const": "chatgpt-first-proof-bundle/v1"},
    "surface_key": {"const": "chatgpt"},
    "attempt_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "capture_kind": {"type": "string"},
    "probe_prompt": {"$ref": "#/$defs/probePrompt"},
    "route_witness": {"$ref": "#/$defs/routeWitness"},
    "privacy_redaction_review": {"$ref": "#/$defs/privacyReview"},
    "artifacts": {"type": "object", "additionalProperties": true},
    "actions": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/action"},
      "contains": {"$ref": "#/$defs/promptWriteAction"}
    }
  },
  "allOf": [
    {"properties": {"actions": {"contains": {"$ref": "#/$defs/promptSubmitAction"}}}},
    {"properties": {"actions": {"contains": {"$ref": "#/$defs/transcriptLatestAction"}}}},
    {"properties": {"actions": {"contains": {"$ref": "#/$defs/settledCaptureAction"}}}}
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "chatgptUrl": {
      "type": "string",
      "pattern": "^https://([^/]+\\.)?chatgpt\\.com(/|$)"
    },
    "conversationUrl": {
      "type": "string",
      "pattern": "^https://([^/]+\\.)?chatgpt\\.com/c/[^/?#]+"
    },
    "probePrompt": {
      "type": "object",
      "required": ["text", "expected_exact_reply"],
      "properties": {
        "text": {"const": "Reply with exactly this text and nothing else: GLASSTTY-CHECKPOINT"},
        "expected_exact_reply": {"const": "GLASSTTY-CHECKPOINT"}
      },
      "additionalProperties": true
    },
    "routeWitness": {
      "type": "object",
      "required": ["adapter", "url", "route_posture"],
      "properties": {
        "adapter": {"const": "chatgpt"},
        "url": {"$ref": "#/$defs/chatgptUrl"},
        "route_posture": {"const": "plain-chat"},
        "tab_id": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "privacyReview": {
      "type": "object",
      "required": ["review_required_before_publication", "publishable_without_redaction_review"],
      "properties": {
        "review_required_before_publication": {"type": "boolean"},
        "publishable_without_redaction_review": {"const": false},
        "reviewer": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "turnWitness": {
      "type": "object",
      "required": ["text", "selector_hint", "selection_policy", "document_order_index", "frame_depth"],
      "properties": {
        "text": {"type": "string"},
        "selector_hint": {"type": "string", "minLength": 1},
        "selection_policy": {
          "enum": [
            "latest-visible-assistant-like-node-in-dom-order",
            "latest-visible-user-like-node-in-dom-order"
          ]
        },
        "author_role": {"enum": ["assistant", "user"]},
        "assistant_like": {"type": "boolean"},
        "user_like": {"type": "boolean"},
        "document_order_index": {"type": "integer", "minimum": 0},
        "frame_depth": {"type": "integer", "minimum": 0},
        "frame_path": {"type": "string"},
        "witness_scope": {
          "description": "When present, should identify a leaf turn node. Aggregate values such as parent, wrapper, thread, or conversation are evaluator blockers.",
          "type": "string"
        },
        "role_mixture_detected": {"type": "boolean"},
        "contains_user_turn_text": {"type": "boolean"},
        "contains_assistant_turn_text": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "action": {
      "type": "object",
      "required": ["sequence_index", "type", "adapter", "url", "tab_id"],
      "properties": {
        "attempt_id": {"type": "string"},
        "sequence_index": {"type": "integer", "minimum": 0},
        "type": {"type": "string"},
        "ok": {"type": "boolean"},
        "adapter": {"const": "chatgpt"},
        "url": {"$ref": "#/$defs/chatgptUrl"},
        "tab_id": {"type": "integer", "minimum": 0},
        "payload": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "promptWriteAction": {
      "allOf": [
        {"$ref": "#/$defs/action"},
        {
          "required": ["type", "ok", "readback"],
          "properties": {
            "type": {"const": "prompt.write"},
            "ok": {"const": true},
            "readback": {"const": "Reply with exactly this text and nothing else: GLASSTTY-CHECKPOINT"}
          }
        }
      ]
    },
    "promptSubmitAction": {
      "allOf": [
        {"$ref": "#/$defs/action"},
        {
          "required": ["type", "ok", "operator_submit_confirmed", "submit_method", "composer_readback_before_submit"],
          "properties": {
            "type": {"const": "prompt.submit"},
            "ok": {"const": true},
            "operator_submit_confirmed": {"const": true},
            "submit_method": {"enum": ["sidepanel-operator-click", "manual-operator-click", "operator-click"]},
            "composer_readback_before_submit": {"const": "Reply with exactly this text and nothing else: GLASSTTY-CHECKPOINT"},
            "prompt_before_submit": {"const": "Reply with exactly this text and nothing else: GLASSTTY-CHECKPOINT"},
            "submitted_prompt": {"const": "Reply with exactly this text and nothing else: GLASSTTY-CHECKPOINT"}
          }
        }
      ]
    },
    "transcriptLatestAction": {
      "allOf": [
        {"$ref": "#/$defs/action"},
        {
          "required": ["type", "url", "payload"],
          "properties": {
            "type": {"const": "transcript.latest"},
            "url": {"$ref": "#/$defs/conversationUrl"},
            "payload": {
              "type": "object",
              "required": ["text", "latest_output_witness", "latest_user_turn_witness"],
              "properties": {
                "text": {"const": "GLASSTTY-CHECKPOINT"},
                "latest_output_witness": {"$ref": "#/$defs/turnWitness"},
                "latest_user_turn_witness": {"$ref": "#/$defs/turnWitness"}
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "settledCaptureAction": {
      "allOf": [
        {"$ref": "#/$defs/action"},
        {
          "properties": {
            "type": {"enum": ["fixture.capture", "state.snapshot"]},
            "url": {"$ref": "#/$defs/conversationUrl"},
            "payload": {
              "type": "object",
              "properties": {
                "metadata": {
                  "type": "object",
                  "required": ["generation_state", "generation_stop_control_present"],
                  "properties": {
                    "generation_state": {"enum": ["settled-or-idle", "settled", "idle", "complete", "completed"]},
                    "generation_stop_control_present": {"const": false}
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    }
  }
}
