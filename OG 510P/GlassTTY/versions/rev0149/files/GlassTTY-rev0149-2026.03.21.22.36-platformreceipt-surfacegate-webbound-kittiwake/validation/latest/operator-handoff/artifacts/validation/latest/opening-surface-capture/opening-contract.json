{
  "version": 5,
  "project": "GlassTTY",
  "purpose": "Declare the minimum cold-open reads and commands a future operator should use before making new support or runtime claims.",
  "ordered_reads": [
    {
      "path": "README.md",
      "role": "project_entry",
      "required": true
    },
    {
      "path": "STATUS.md",
      "role": "current_truth",
      "required": true
    },
    {
      "path": "REVISION-RECEIPT.json",
      "role": "revision_summary",
      "required": true
    },
    {
      "path": "SUPPORT-PUBLIC-SURFACE.json",
      "role": "citable_support_surface",
      "required": false
    },
    {
      "path": "SUPPORT-PUBLISH-GATE.json",
      "role": "support_publication_gate",
      "required": false
    },
    {
      "path": "SUPPORT-SOURCE-LOCK.json",
      "role": "support_source_lock",
      "required": false
    },
    {
      "path": "SUPPORT-SOURCE-BASELINE.json",
      "role": "support_source_baseline",
      "required": false
    },
    {
      "path": "PROJECT_MAP.md",
      "role": "canon_map",
      "required": true
    },
    {
      "path": "docs/operator-startup.md",
      "role": "wake_path",
      "required": true
    }
  ],
  "commands": [
    {
      "name": "doctor",
      "command": "python scripts/doctor.py --pretty",
      "required": true
    },
    {
      "name": "readiness_report",
      "command": "python scripts/readiness-report.py --pretty",
      "required": true
    },
    {
      "name": "opening_surface",
      "command": "python scripts/check-opening-contract.py --pretty",
      "required": true
    },
    {
      "name": "revision_receipt",
      "command": "python scripts/check-revision-receipt.py --pretty",
      "required": false
    },
    {
      "name": "truth_surface_warnings",
      "command": "python scripts/truth-surface-warnings.py --pretty",
      "required": false
    },
    {
      "name": "validation_artifact_inventory",
      "command": "python scripts/validation-artifact-inventory.py --pretty",
      "required": false
    },
    {
      "name": "control_plane_report",
      "command": "python scripts/control-plane-report.py --pretty",
      "required": false
    },
    {
      "name": "install_receipt",
      "command": "python scripts/install-receipt.py --pretty",
      "required": false
    },
    {
      "name": "support_surface_snapshot",
      "command": "python scripts/support-surface-snapshot.py --pretty",
      "required": false
    },
    {
      "name": "published_support_surface",
      "command": "python scripts/published-support-surface.py --pretty",
      "required": false
    },
    {
      "name": "support_publish_gate",
      "command": "python scripts/support-publish-gate.py --pretty",
      "required": false
    },
    {
      "name": "support_source_baseline",
      "command": "python scripts/support-source-baseline.py --pretty",
      "required": false
    },
    {
      "name": "refresh_truth_surfaces",
      "command": "python scripts/refresh-truth-surfaces.py --pretty",
      "required": false
    },
    {
      "name": "operator_handoff_capture",
      "command": "python scripts/operator-handoff.py capture --output-dir validation/latest/operator-handoff",
      "required": false
    }
  ],
  "principles": [
    "canon_before_archaeology",
    "bootstrap_truth_separate_from_runtime_truth",
    "support_truth_requires_named_surfaces",
    "cold_open_should_be_machine_checkable",
    "revision_identity_should_be_machine_checkable",
    "warning_surfaces_should_be_compact",
    "publication_gates_should_fail_closed",
    "approved_source_hierarchy_before_stronger_support_claims"
  ]
}
