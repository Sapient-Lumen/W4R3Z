{
  "manifest_version": 3,
  "name": "GlassTTY Bridge",
  "version": "0.0.3",
  "description": "User-driven bridge between browser tabs and a local terminal workflow.",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "storage",
    "commands",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "dist/background/main.js",
    "type": "module"
  },
  "action": {
    "default_title": "GlassTTY"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "commands": {
    "pull-latest-output": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Read the latest output from the active supported tab"
    },
    "pull-current-prompt": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Read the current prompt draft from the active supported tab"
    },
    "debug-dom-candidates": {
      "description": "Collect DOM candidate information from the active supported tab"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "dist/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/index.html"
}
