{
  "schema": "llmpoetry-validation-requirements-v1",
  "revision": "rev0019",
  "required_root_files": [
    "START_HERE.md",
    "README.md",
    "AGENTS.md",
    "STATE.json",
    "CONTEXT_PACK.json",
    "REENTRY_CONTRACT.json",
    "REVISION_RECEIPT.json",
    "SURFACE_STATUS.json",
    "VALIDATION_INDEX.json"
  ],
  "required_registries": [
    "poem_index.json",
    "source_registry.json",
    "specimen_registry.json",
    "teacher_patterns.json",
    "open_questions.json",
    "banlist.json"
  ],
  "required_schemas": [
    "poem.schema.json",
    "draft.schema.json",
    "judgment.schema.json",
    "source.schema.json",
    "revision.schema.json",
    "form.schema.json",
    "validation_report.schema.json"
  ],
  "requirements": [
    {
      "id": "VR-RESEARCH-PULSE",
      "description": "Current completed turn has a research pulse or blocked-pulse record.",
      "tool": "tools/check_research_pulses.py"
    },
    {
      "id": "VR-POEM-RECORDS",
      "description": "Poem index and poem folders agree; evidence statuses require receipts.",
      "tool": "tools/check_poem_records.py"
    },
    {
      "id": "VR-P0001-PREFLIGHT",
      "description": "P0001 scaffold exists but contains no draft text in this foundation revision.",
      "tool": "tools/check_poem_records.py"
    },
    {
      "id": "VR-P0001-BRANCH-LATTICE",
      "description": "P0001 branch packets agree with rendered drafts, selected path claims, and any unselected-final-word shadow claim.",
      "tool": "tools/check_branch_selector.py"
    },
    {
      "id": "VR-P0001-SELECTOR-MAP",
      "description": "Selector map exact text and positions match rendered draft.",
      "tool": "tools/check_selector_map.py"
    }
  ]
}
