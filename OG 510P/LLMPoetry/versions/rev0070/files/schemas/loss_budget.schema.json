{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPoetry loss budget receipt",
  "type": "object",
  "required": ["schema", "poem_id", "draft_id", "revision", "turn", "packet_path", "draft_path", "selector_vector_path", "selected_line_count", "omitted_candidate_count", "shadow_sentence", "selected_surface_word_count", "selected_meta_term_count", "non_claim"],
  "properties": {
    "schema": {"const": "llmpoetry-loss-budget-v1"},
    "poem_id": {"type": "string"},
    "draft_id": {"type": "string"},
    "revision": {"type": "string"},
    "turn": {"type": "integer"},
    "packet_path": {"type": "string"},
    "draft_path": {"type": "string"},
    "selector_vector_path": {"type": "string"},
    "selected_line_count": {"type": "integer"},
    "candidate_count": {"type": "integer"},
    "omitted_candidate_count": {"type": "integer"},
    "shadow_sentence": {"type": "string"},
    "shadow_word_count": {"type": "integer"},
    "selected_surface_word_count": {"type": "integer"},
    "hidden_to_visible_word_ratio": {"type": "number"},
    "selected_meta_terms": {"type": "array", "items": {"type": "string"}},
    "selected_meta_term_count": {"type": "integer"},
    "non_claim": {"type": "string"}
  }
}
