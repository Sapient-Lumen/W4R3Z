{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPoetry ergodic traversal receipt",
  "type": "object",
  "required": [
    "schema",
    "poem_id",
    "draft_id",
    "revision",
    "turn",
    "branch_packet_path",
    "draft_path",
    "traversal_sentence",
    "transitions",
    "non_claim"
  ],
  "properties": {
    "schema": {
      "const": "llmpoetry-ergodic-traversal-v1"
    },
    "poem_id": {
      "type": "string"
    },
    "draft_id": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "turn": {
      "type": "integer"
    },
    "branch_packet_path": {
      "type": "string"
    },
    "draft_path": {
      "type": "string"
    },
    "traversal_sentence": {
      "type": "string"
    },
    "transitions": {
      "type": "array"
    },
    "non_claim": {
      "type": "string"
    }
  }
}
