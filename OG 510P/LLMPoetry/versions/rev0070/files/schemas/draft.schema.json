{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPoetry draft record",
  "type": "object",
  "required": [
    "draft_id",
    "poem_id",
    "path",
    "created_revision",
    "created_turn",
    "status"
  ],
  "properties": {
    "draft_id": {
      "type": "string"
    },
    "poem_id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "created_revision": {
      "type": "string"
    },
    "created_turn": {
      "type": "integer"
    },
    "status": {
      "type": "string"
    },
    "prompt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array"
    },
    "metrics_path": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
