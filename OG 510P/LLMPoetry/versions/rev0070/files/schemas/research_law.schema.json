{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llmpoetry-research-law.schema.json",
  "type": "object",
  "required": [
    "law_id",
    "scope",
    "requirement",
    "blocked_behavior"
  ],
  "properties": {
    "law_id": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "requirement": {
      "type": "string"
    },
    "blocked_behavior": {
      "type": "string"
    },
    "allowed_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
