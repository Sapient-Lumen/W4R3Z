{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llmpoetry/schemas/pilot_queue.schema.json",
  "title": "LLMPoetry pilot queue",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "pilots"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "selection_rule": {
      "type": "string"
    },
    "pilots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pilot_id",
          "status",
          "name",
          "form_id",
          "machine_native_claim",
          "verification_path"
        ],
        "properties": {
          "pilot_id": {
            "type": "string",
            "pattern": "^PILOT-\\d{4}$"
          },
          "status": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "form_id": {
            "type": "string"
          },
          "machine_native_claim": {
            "type": "string"
          },
          "verification_path": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
