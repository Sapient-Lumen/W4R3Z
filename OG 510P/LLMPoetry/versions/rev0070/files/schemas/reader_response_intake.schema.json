{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llmpoetry/schemas/reader_response_intake.schema.json",
  "title": "LLMPoetry reader response intake template v3",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "draft_id",
    "template_only",
    "not_a_response",
    "response",
    "non_claim"
  ],
  "properties": {
    "schema": {
      "enum": [
        "llmpoetry-reader-response-intake-template-v1",
        "llmpoetry-reader-response-intake-template-v2",
        "llmpoetry-reader-response-intake-template-v3"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "draft_id": {
      "const": "P0002-D010"
    },
    "template_only": {
      "const": true
    },
    "not_a_response": {
      "const": true
    },
    "response": {
      "type": "object",
      "required": [
        "disclosure_seen_before_poem",
        "source_packet_opened_before_first_response",
        "boundary_acknowledged",
        "keep_reject_uncertain",
        "strongest_line_or_phrase",
        "weakest_line_or_phrase",
        "disclosure_delta",
        "body_works_without_source_packet",
        "documentation_doing_poem_work",
        "revision_instruction",
        "quality_claims"
      ],
      "properties": {
        "disclosure_seen_before_poem": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_packet_opened_before_first_response": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "boundary_acknowledged": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "keep_reject_uncertain": {
          "type": "string"
        },
        "strongest_line_or_phrase": {
          "type": "string"
        },
        "weakest_line_or_phrase": {
          "type": "string"
        },
        "disclosure_delta": {
          "type": "string"
        },
        "body_works_without_source_packet": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "documentation_doing_poem_work": {
          "type": "string"
        },
        "revision_instruction": {
          "type": "string"
        },
        "quality_claims": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "non_claim": {
      "type": "string"
    }
  },
  "description": "Template and guard schema for local non-identifying disclosed-reader response intake; rev0040 adds portable handoff-bundle and transactional duplicate-guarded append hardening. Not a real response and not evidence."
}
