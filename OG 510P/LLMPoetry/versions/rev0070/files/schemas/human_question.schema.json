{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llmpoetry/schemas/human_question.schema.json",
  "title": "LLMPoetry human question",
  "type": "object",
  "required": [
    "question_id",
    "status",
    "question",
    "default_until_answered",
    "blocks_work"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^QH-\\d{4}$"
    },
    "status": {
      "type": "string"
    },
    "asked_revision": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "default_until_answered": {
      "type": "string"
    },
    "blocks_work": {
      "type": "boolean"
    }
  }
}
