{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llmpoetry-source-receipt.schema.json",
  "type": "object",
  "required": [
    "receipt_id",
    "source_id",
    "claim_id",
    "claim_text",
    "accessed_at",
    "verdict"
  ],
  "properties": {
    "receipt_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "claim_id": {
      "type": "string"
    },
    "poem_id": {
      "type": "string"
    },
    "draft_id": {
      "type": "string"
    },
    "claim_text": {
      "type": "string"
    },
    "accessed_at": {
      "type": "string"
    },
    "authority_level": {
      "type": "string"
    },
    "selector": {
      "type": "object"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "supports",
        "does_not_support",
        "ambiguous",
        "stale"
      ]
    }
  }
}
