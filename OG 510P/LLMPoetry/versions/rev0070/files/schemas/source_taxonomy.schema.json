{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llmpoetry/schemas/source_taxonomy.schema.json",
  "title": "LLMPoetry source taxonomy",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "roles",
    "rule"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "fact_claim_allowed",
          "description"
        ]
      }
    },
    "rule": {
      "type": "string"
    }
  }
}
