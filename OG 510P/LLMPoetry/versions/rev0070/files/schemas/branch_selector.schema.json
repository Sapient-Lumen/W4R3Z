{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPoetry branch-selector packet",
  "type": "object",
  "required": [
    "schema",
    "poem_id",
    "draft_id",
    "revision",
    "turn",
    "form_id",
    "prompt_id",
    "prompt_path",
    "draft_path",
    "prompt_text",
    "selected_path",
    "selected_initials_claim",
    "same_turn_judgment_prohibited",
    "layers"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "poem_id": {
      "type": "string"
    },
    "draft_id": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "turn": {
      "type": "integer"
    },
    "form_id": {
      "type": "string"
    },
    "prompt_id": {
      "type": "string"
    },
    "prompt_path": {
      "type": "string"
    },
    "draft_path": {
      "type": "string"
    },
    "prompt_text": {
      "type": "string"
    },
    "selected_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_initials_claim": {
      "type": "string"
    },
    "same_turn_judgment_prohibited": {
      "type": "boolean"
    },
    "layers": {
      "type": "array"
    },
    "selector_notes": {
      "type": "array"
    },
    "non_claim": {
      "type": "string"
    }
  }
}
