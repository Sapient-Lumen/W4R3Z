{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llmpoetry-source-snapshot.schema.json",
  "title": "LLMPoetry source snapshot registry",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "current_head",
    "current_head_packet",
    "snapshots",
    "non_claim"
  ],
  "properties": {
    "schema": {
      "const": "llmpoetry-source-snapshot-registry-v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "generated_at": {
      "type": "string"
    },
    "current_head": {
      "type": "string"
    },
    "current_head_packet": {
      "type": "string"
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "snapshot_id",
          "source_id",
          "path",
          "captured_at",
          "capture_kind",
          "evidence_ref",
          "sha256"
        ],
        "properties": {
          "snapshot_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "captured_at": {
            "type": "string"
          },
          "capture_kind": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string"
          },
          "supports_current_head": {
            "type": "boolean"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "non_claim": {
      "type": "string"
    }
  }
}
