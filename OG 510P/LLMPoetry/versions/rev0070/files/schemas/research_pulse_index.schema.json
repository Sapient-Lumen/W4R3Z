{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPoetry research pulse index",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "law_id",
    "pulses"
  ],
  "properties": {
    "schema": {
      "const": "llmpoetry-research-pulse-index-v1"
    },
    "revision": {
      "type": "string"
    },
    "law_id": {
      "const": "LAW-R1"
    },
    "pulses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pulse_id",
          "turn",
          "revision",
          "status",
          "source_ids"
        ]
      }
    }
  }
}
