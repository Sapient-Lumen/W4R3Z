{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPoetry pilot registry",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "pilots"
  ],
  "properties": {
    "schema": {
      "const": "llmpoetry-pilot-registry-v1"
    },
    "pilots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pilot_id",
          "form_id",
          "name",
          "status",
          "verification_plan"
        ]
      }
    }
  }
}
