{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llmpoetry-research-pulse.schema.json",
  "type": "object",
  "required": [
    "pulse_id",
    "revision",
    "purpose",
    "queries",
    "source_ids"
  ],
  "properties": {
    "pulse_id": {
      "type": "string"
    },
    "turn": {},
    "revision": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "type": "string"
    },
    "entered_cube_as": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entropy_value": {
      "type": "string"
    },
    "blocked": {
      "type": "boolean"
    },
    "blocked_reason": {}
  }
}
