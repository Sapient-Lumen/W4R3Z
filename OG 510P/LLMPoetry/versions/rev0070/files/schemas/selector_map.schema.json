{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPoetry selector map",
  "type": "object",
  "required": [
    "schema",
    "poem_id",
    "draft_id",
    "source_path",
    "selectors"
  ],
  "properties": {
    "schema": {
      "const": "llmpoetry-selector-map-v1"
    },
    "poem_id": {
      "type": "string"
    },
    "draft_id": {
      "type": "string"
    },
    "source_path": {
      "type": "string"
    },
    "selectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "exact",
          "start",
          "end"
        ]
      }
    }
  }
}
