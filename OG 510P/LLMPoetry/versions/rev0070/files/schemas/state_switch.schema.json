{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPoetry state switch receipt",
  "type": "object",
  "required": [
    "schema",
    "poem_id",
    "draft_id",
    "branch_packet_path",
    "selector_vector_path",
    "closed_state",
    "open_state",
    "state_delta",
    "transitions",
    "disclosure_required"
  ],
  "properties": {
    "schema": {
      "const": "llmpoetry-state-switch-v1"
    },
    "poem_id": {
      "type": "string"
    },
    "draft_id": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "turn": {
      "type": "integer"
    },
    "branch_packet_path": {
      "type": "string"
    },
    "selector_vector_path": {
      "type": "string"
    },
    "draft_path": {
      "type": "string"
    },
    "closed_state": {
      "type": "object"
    },
    "open_state": {
      "type": "object"
    },
    "state_delta": {
      "type": "object"
    },
    "transitions": {
      "type": "array"
    },
    "disclosure_required": {
      "type": "boolean"
    },
    "non_claim": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
