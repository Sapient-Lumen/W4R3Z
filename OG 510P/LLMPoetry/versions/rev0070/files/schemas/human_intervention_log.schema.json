  "title": "LLMPoetry human intervention log",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "logging_policy",
    "entries"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "logging_policy": {
      "type": "string"
    },
    "entries": {
      "type": "array"
    }
  }
}
