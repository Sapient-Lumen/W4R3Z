{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llmpoetry/schemas/poem.schema.json",
  "title": "LLMPoetry poem record",
  "type": "object",
  "required": [
    "poem_id",
    "title",
    "status",
    "created_revision",
    "created_turn",
    "axis_coordinates",
    "authorship",
    "drafts",
    "constraint_claims",
    "verification_receipts",
    "source_ids",
    "quote_search_status",
    "disclosure_test_status"
  ],
  "properties": {
    "poem_id": {
      "type": "string",
      "pattern": "^P\\d{4}$"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "template",
        "preflight",
        "draft",
        "graveyard",
        "anthology_candidate",
        "evidence_candidate",
        "admitted",
        "withdrawn"
      ]
    },
    "created_revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "created_turn": {
      "type": "integer",
      "minimum": 0
    },
    "axis_coordinates": {
      "type": "object"
    },
    "authorship": {
      "type": "object"
    },
    "drafts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "constraint_claims": {
      "type": "array"
    },
    "verification_receipts": {
      "type": "array"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quote_search_status": {
      "type": "string"
    },
    "disclosure_test_status": {
      "type": "string"
    },
    "ethics_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
