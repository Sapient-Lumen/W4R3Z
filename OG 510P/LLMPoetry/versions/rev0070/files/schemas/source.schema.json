{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPoetry source record",
  "type": "object",
  "required": [
    "source_id",
    "title",
    "url",
    "accessed_at",
    "role",
    "authority_level",
    "used_for"
  ],
  "properties": {
    "source_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "publisher": {
      "type": [
        "string",
        "null"
      ]
    },
    "accessed_at": {
      "type": "string"
    },
    "role": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_level": {
      "type": "string"
    },
    "used_for": {
      "type": "string"
    },
    "rights_notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
