  "required": [
    "schema",
    "poem_id",
    "draft_id",
    "render_script",
    "packet_path",
    "draft_path",
    "packet_sha256",
    "draft_sha256"
  ],
  "properties": {
    "schema": {
      "const": "llmpoetry-render-receipt-v1"
    },
    "poem_id": {
      "type": "string"
    },
    "draft_id": {
      "type": "string"
    },
    "render_script": {
      "type": "string"
    },
    "packet_path": {
      "type": "string"
    },
    "draft_path": {
      "type": "string"
    }
  }
}
