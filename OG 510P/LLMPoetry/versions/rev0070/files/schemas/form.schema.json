{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPoetry form registry entry",
  "type": "object",
  "required": [
    "form_id",
    "name",
    "tier",
    "verification",
    "risk"
  ],
  "properties": {
    "form_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "tier": {
      "type": "integer"
    },
    "verification": {
      "type": "string"
    },
    "risk": {
      "type": "string"
    }
  }
}
