{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llmpoetry-reader-state-object.schema.json",
  "title": "LLMPoetry reader-facing state object",
  "type": "object",
  "required": ["schema", "object_id", "poem_id", "draft_id", "revision", "turn", "source_paths", "state_order", "closed_state", "open_state", "traversal_state", "patched_state", "layer_walk", "receipt_matrix", "quality_claims", "non_claim"],
  "properties": {
    "schema": {"const": "llmpoetry-reader-state-object-v1"},
    "object_id": {"type": "string"},
    "poem_id": {"type": "string"},
    "draft_id": {"type": "string"},
    "revision": {"type": "string"},
    "turn": {"type": "integer"},
    "source_paths": {"type": "object"},
    "state_order": {
      "type": "array",
      "items": {"enum": ["closed", "open", "traversal", "patched"]},
      "minItems": 4,
      "maxItems": 4
    },
    "closed_state": {"type": "object"},
    "open_state": {"type": "object"},
    "traversal_state": {"type": "object"},
    "patched_state": {"type": "object"},
    "layer_walk": {"type": "array", "minItems": 1},
    "receipt_matrix": {"type": "array", "minItems": 1},
    "quality_claims": {"type": "array", "maxItems": 0},
    "non_claim": {"type": "string"}
  },
  "additionalProperties": true
}
