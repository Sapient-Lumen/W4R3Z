{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPoetry judgment record",
  "type": "object",
  "required": [
    "judgment_id",
    "poem_id",
    "draft_id",
    "created_turn",
    "target_created_turn",
    "firewall_ok",
    "judge",
    "criteria",
    "band"
  ],
  "properties": {
    "judgment_id": {
      "type": "string"
    },
    "poem_id": {
      "type": "string"
    },
    "draft_id": {
      "type": "string"
    },
    "created_turn": {
      "type": "integer"
    },
    "target_created_turn": {
      "type": "integer"
    },
    "firewall_ok": {
      "type": "boolean"
    },
    "judge": {
      "type": "object"
    },
    "criteria": {
      "type": "object"
    },
    "pairwise": {
      "type": [
        "object",
        "null"
      ]
    },
    "order_swap": {
      "type": [
        "object",
        "null"
      ]
    },
    "band": {
      "type": "string",
      "enum": [
        "S",
        "A",
        "B",
        "dead"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
