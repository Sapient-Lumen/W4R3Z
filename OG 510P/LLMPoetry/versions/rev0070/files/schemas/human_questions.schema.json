{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPoetry human questions",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "questions"
  ],
  "properties": {
    "schema": {
      "const": "llmpoetry-human-questions-v1"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "question",
          "default_if_unanswered"
        ]
      }
    }
  }
}
