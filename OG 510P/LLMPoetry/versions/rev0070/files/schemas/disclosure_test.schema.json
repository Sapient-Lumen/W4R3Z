{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llmpoetry/schemas/disclosure_test.schema.json",
  "title": "LLMPoetry disclosure test",
  "type": "object",
  "required": [
    "test_id",
    "poem_id",
    "consent_recorded",
    "blind_phase",
    "disclosed_phase",
    "delta"
  ],
  "properties": {
    "test_id": {
      "type": "string"
    },
    "poem_id": {
      "type": "string",
      "pattern": "^P\\d{4}$"
    },
    "consent_recorded": {
      "type": "boolean"
    },
    "blind_phase": {
      "type": "object"
    },
    "disclosed_phase": {
      "type": "object"
    },
    "delta": {
      "type": "string"
    }
  }
}
