{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPoetry revision receipt",
  "type": "object",
  "required": [
    "project",
    "revision",
    "artifact_stem",
    "timestamp",
    "changes",
    "did_not_do",
    "validation"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "previous_revision": {
      "type": "string"
    },
    "artifact_stem": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "changes": {
      "type": "array"
    },
    "did_not_do": {
      "type": "array"
    },
    "validation": {
      "type": "object"
    }
  }
}
