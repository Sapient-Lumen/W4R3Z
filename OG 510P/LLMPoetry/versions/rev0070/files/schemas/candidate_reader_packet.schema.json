{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llmpoetry/schemas/candidate_reader_packet.schema.json",
  "title": "LLMPoetry candidate reader packet",
  "type": "object",
  "required": [
    "schema",
    "packet_id",
    "revision",
    "poem_id",
    "draft_id",
    "status",
    "disclosure_order",
    "blind_phase",
    "paths",
    "reader_boundary",
    "quality_claims",
    "non_claim",
    "reader_surface_mode",
    "pre_poem_priming_policy",
    "response_log_policy"
  ],
  "properties": {
    "schema": {
      "const": "llmpoetry-candidate-reader-packet-v1"
    },
    "packet_id": {
      "type": "string"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "poem_id": {
      "type": "string",
      "pattern": "^P\\d{4}$"
    },
    "draft_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "disclosure_order": {
      "const": "disclosure_before_poem"
    },
    "blind_phase": {
      "const": false
    },
    "paths": {
      "type": "object"
    },
    "reader_boundary": {
      "type": "object"
    },
    "quality_claims": {
      "type": "array",
      "maxItems": 0
    },
    "non_claim": {
      "type": "string"
    },
    "reader_surface_mode": {
      "type": "string"
    },
    "pre_poem_priming_policy": {
      "type": "object"
    },
    "response_log_policy": {
      "type": "object"
    }
  },
  "description": "Rev0037 schema for a calibrated disclosed-first reader packet with separated evaluator rubric and zero-or-real non-identifying response-log compatibility."
}
