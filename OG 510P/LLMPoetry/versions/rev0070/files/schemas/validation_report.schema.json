{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMPoetry validation report",
  "type": "object",
  "required": [
    "project",
    "revision",
    "ok",
    "checks"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "array"
    }
  }
}
