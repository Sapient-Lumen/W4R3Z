{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llmpoetry-patch-application.schema.json",
  "title": "LLMPoetry patch application receipt",
  "type": "object",
  "required": ["schema", "poem_id", "draft_id", "revision", "turn", "branch_packet_path", "draft_path", "ergodic_traversal_path", "operations", "patched_state", "non_claim"],
  "properties": {
    "schema": {"const": "llmpoetry-patch-application-v1"},
    "poem_id": {"type": "string"},
    "draft_id": {"type": "string"},
    "revision": {"type": "string"},
    "turn": {"type": "integer"},
    "branch_packet_path": {"type": "string"},
    "draft_path": {"type": "string"},
    "ergodic_traversal_path": {"type": "string"},
    "previous_route_receipt_path": {"type": ["string", "null"]},
    "route_sentence": {"type": "string"},
    "operations": {"type": "array"},
    "patched_state": {"type": "object"},
    "non_claim": {"type": "string"}
  },
  "additionalProperties": true
}
