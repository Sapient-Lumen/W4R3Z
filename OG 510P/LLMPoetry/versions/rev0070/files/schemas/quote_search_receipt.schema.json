{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llmpoetry-quote-search-receipt.schema.json",
  "type": "object",
  "required": [
    "receipt_id",
    "poem_id",
    "draft_id",
    "phrase",
    "exact_query",
    "searched_at",
    "search_tool",
    "verdict"
  ],
  "properties": {
    "receipt_id": {
      "type": "string"
    },
    "poem_id": {
      "type": "string"
    },
    "draft_id": {
      "type": "string"
    },
    "phrase": {
      "type": "string"
    },
    "exact_query": {
      "type": "string"
    },
    "searched_at": {
      "type": "string"
    },
    "search_tool": {
      "type": "string"
    },
    "result_summary": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "no_exact_hits",
        "near_collision",
        "common_phrase",
        "source_dependent",
        "needs_rewrite",
        "not_checked"
      ]
    },
    "reviewer_notes": {
      "type": "string"
    }
  }
}
