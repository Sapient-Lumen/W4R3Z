{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtgsim.local/schemas/card_schema_v0.json",
  "title": "MTGSim normalized card definition v0",
  "type": "object",
  "required": ["name", "types"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string"},
    "mana_cost": {"type": "string"},
    "types": {"type": "array", "items": {"type": "string"}},
    "supertypes": {"type": "array", "items": {"type": "string"}},
    "subtypes": {"type": "array", "items": {"type": "string"}},
    "oracle_text": {"type": "string"},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "power": {"type": ["string", "integer", "null"]},
    "toughness": {"type": ["string", "integer", "null"]},
    "loyalty": {"type": ["string", "integer", "null"]},
    "defense": {"type": ["string", "integer", "null"]},
    "color_identity": {"type": "array", "items": {"type": "string"}},
    "source_ids": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "rule_refs": {"type": "array", "items": {"type": "string"}}
  }
}
