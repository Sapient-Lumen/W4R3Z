# A simple targeted damage spell is cast through the scenario action API and damages a player.
seed 7001
card Sample_Bolt instant 0 0 cost=R effect=damage:3:any
card Target_Bear creature 2 2 cost=1G
card Sample_Mountain land 0 0 cost=0 tap=R
# Object IDs: Alpha gets mountain#1 then bolt#2; Beta gets bear#3 and bear#4.
deck Alpha 2,0
deck Beta 1,1
create
start opening=0 shuffle=false
draw 1
add_mana 1 R 1
main_phase 1
expect_actions 1 cast_paid 2
action cast_paid 1 2 target=player:2
expect_stack_size 1
expect_object_zone 2 stack
pass 2
expect_stack_size 0
expect_life 2 17
expect_object_zone 2 graveyard
validate
