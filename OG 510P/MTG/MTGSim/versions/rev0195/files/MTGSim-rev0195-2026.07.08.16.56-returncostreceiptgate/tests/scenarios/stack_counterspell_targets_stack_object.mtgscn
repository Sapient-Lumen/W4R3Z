# A counterspell can target a spell object on the stack, move that target to its owner graveyard,
# and prevent the target spell's payload from resolving.
seed 440101
card Stack_Target_Bolt instant 0 0 cost=R effect=damage:3:player color=red
card Stack_Target_Cancel instant 0 0 cost=U effect=counterspell:1:stack color=blue
card Sample_Mountain land 0 0 tap=R
card Sample_Island land 0 0 tap=U
# Object IDs: Alpha gets mountain#1 then bolt#2; Beta gets island#3 then cancel#4.
deck Alpha 2,0
deck Beta 3,1
create
start opening=0 shuffle=false
draw 1
draw 2
add_mana 1 R 1
add_mana 2 U 1
main_phase 1
action cast_paid 1 2 target=player:2
expect_stack_size 1
# The caster retains priority after casting; the opponent can respond only after Alpha passes.
pass 1
action cast_paid 2 4 target=stack:2
expect_stack_size 2
pass 2
expect_event_order counter_spell resolve_effect
expect_stack_size 0
expect_object_zone 2 graveyard
expect_object_zone 4 graveyard
expect_life 2 20
expect_event_count damage_player 0
validate
