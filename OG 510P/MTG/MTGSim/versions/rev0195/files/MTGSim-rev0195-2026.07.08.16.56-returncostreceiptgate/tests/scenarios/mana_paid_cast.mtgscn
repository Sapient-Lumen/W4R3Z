# Data-driven smoke scenario: tap a mana land, pay 1G, cast a creature, and resolve it.
seed 6001
card Sample_Forest land 0 0 cost=0 tap=G
card Sample_Bear creature 2 2 cost=1G
card Sample_Blank instant 0 0 cost=0
# Object IDs: Alpha gets forest#1 then bear#2; Beta gets forest#3 and blank#4.
deck Alpha 0,1
deck Beta 0,2
create
start opening=0 shuffle=false
draw 1
move 1 1 battlefield
expect_zone_count 1 hand 1
expect_actions 1 tap_mana 1
action tap_mana 1 1
expect_tapped 1 true
expect_mana_total 1 1
add_mana 1 C 1
main_phase 1
expect_actions 1 cast_paid 1
action cast_paid 1 2
expect_stack_size 1
expect_object_zone 2 stack
expect_mana_total 1 0
pass 2
expect_stack_size 0
expect_zone_count 1 battlefield 2
expect_object_zone 2 battlefield
validate
