# Multiple zone-change replacements use a deterministic affected-controller choice rank,
# then recheck the modified event for newly applicable replacements before finalizing.
seed 6162
card exile_gate enchantment 0 0 replacement=to_exile_first:all_creatures:battlefield:graveyard:exile:creature:choice=2
card command_gate enchantment 0 0 replacement=exile_to_command:all_creatures:battlefield:exile:command:creature
card direct_command_gate enchantment 0 0 replacement=direct_to_command:all_creatures:battlefield:graveyard:command:creature:choice=1
card dies_watcher creature 0 1 trigger=creature_dies:gain_life:1:other
card rechecked_bear creature 2 2
deck Alpha 0,1,2,3,4
deck Beta -
create
start opening=0 shuffle=false
move 1 1 battlefield
move 2 1 battlefield
move 3 1 battlefield
move 4 1 battlefield
move 5 1 battlefield
mark_damage 5 2
sba
expect_object_zone 5 command
expect_zone_count 1 graveyard 0
expect_zone_count 1 exile 0
expect_zone_count 1 command 1
expect_pending_triggers 0
expect_life 1 20
validate
