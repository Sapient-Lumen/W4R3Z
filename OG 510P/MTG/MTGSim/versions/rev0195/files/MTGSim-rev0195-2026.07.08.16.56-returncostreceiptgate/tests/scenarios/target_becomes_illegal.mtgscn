deck Alpha 2,0
deck Beta 1,1
create
start opening=0 shuffle=false
draw 1
move 4 2 battlefield
add_mana 1 R 1
main_phase 1
action cast_paid 1 2 target=object:4
expect_stack_size 1
move 4 2 graveyard
pass 2
expect_stack_size 0
expect_object_zone 2 graveyard
expect_object_zone 4 graveyard
expect_damage 4 0
validate
