+        return 1
+    except Exception as exc:
+        print(f"embedded-digest-recovery-safe-materialization-rev0871: FAIL: unexpected error: {exc}", file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
