+def infer_current_revision() -> int:
+    import re
+    candidates = [ROOT.name]
+    checks = ROOT / "CHECKS"
+    if checks.is_dir():
+        candidates.extend(path.name for path in checks.glob("patch-bundle-identity-rev*.json"))
+    found: list[int] = []
