+        lines.append(f"- `{snippet}` — {mark}")
+    lines.extend(["", "## Protected entrypoints", "", "| Entrypoint | Purpose | Imports helper | Guard present | Guard before first mutation marker |", "| --- | --- | ---: | ---: | ---: |"])
+    for item in data["entrypoints"]:
+        lines.append(
