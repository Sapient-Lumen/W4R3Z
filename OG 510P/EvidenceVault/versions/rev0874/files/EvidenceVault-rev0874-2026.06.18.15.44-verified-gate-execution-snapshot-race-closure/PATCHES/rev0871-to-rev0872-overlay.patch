+def expect_error(call: Callable[[], Any], error_type: type[BaseException], phrase: str = "") -> str:
+    try:
+        call()
+    except error_type as exc:
+        text = str(exc)
+        if phrase and phrase.lower() not in text.lower():
+            fail(f"operation failed for the wrong reason: {text}")
