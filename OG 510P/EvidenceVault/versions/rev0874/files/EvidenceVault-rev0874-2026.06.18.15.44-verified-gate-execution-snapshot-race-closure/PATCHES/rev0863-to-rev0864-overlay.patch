@@ -0,0 +1,232 @@
+#!/usr/bin/env python3
+"""Run the current EvidenceVault overlay checks from one structured command.
+
+The overlay ZIP is not a full canonical tree. This entry point therefore reads
+its check list from PATCH_BUNDLE_MANIFEST.json instead of invoking the canonical
+Makefile, whose complete script surface is not carried by the overlay.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path, PurePosixPath
+import subprocess
+import sys
+import tempfile
+import time
+from typing import Any
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[1]
+MANIFEST = ROOT / "PATCH_BUNDLE_MANIFEST.json"
+
+
+class GateError(RuntimeError):
+    pass
+
+
+def _safe_rel(text: Any, label: str) -> str:
+    if not isinstance(text, str) or not text or "\x00" in text or "\\" in text:
+        raise GateError(f"{label} must be a non-empty POSIX relative path")
+    path = PurePosixPath(text)
+    if path.is_absolute() or any(part in {"", ".", ".."} for part in path.parts):
+        raise GateError(f"{label} is not a clean relative path: {text!r}")
+    return path.as_posix()
+
+
+def _first_symlink_component(path: Path) -> Path | None:
+    current = ROOT
+    try:
+        parts = path.relative_to(ROOT).parts
+    except ValueError as exc:
+        raise GateError(f"path escapes bundle root: {path}") from exc
+    for part in parts:
+        current = current / part
+        if current.is_symlink():
+            return current
+    return None
+
+
+def _load_manifest() -> dict[str, Any]:
+    if _first_symlink_component(MANIFEST) is not None or not MANIFEST.is_file():
+        raise GateError("PATCH_BUNDLE_MANIFEST.json is missing, non-regular, or symlinked")
+    try:
+        data = json.loads(MANIFEST.read_text(encoding="utf-8"))
+    except Exception as exc:
+        raise GateError(f"invalid PATCH_BUNDLE_MANIFEST.json: {exc}") from exc
+    if not isinstance(data, dict):
+        raise GateError("PATCH_BUNDLE_MANIFEST.json must be a JSON object")
+    return data
+
+
+def _load_checks() -> tuple[dict[str, Any], list[dict[str, Any]]]:
+    manifest = _load_manifest()
+    raw = manifest.get("gate_checks")
+    if not isinstance(raw, list) or not raw:
+        raise GateError("PATCH_BUNDLE_MANIFEST.json gate_checks must be a non-empty list")
+    seen: set[str] = set()
+    checks: list[dict[str, Any]] = []
+    for index, item in enumerate(raw):
+        if not isinstance(item, dict):
+            raise GateError(f"gate_checks[{index}] must be an object")
+        check_id = item.get("id")
+        if not isinstance(check_id, str) or not check_id or check_id in seen:
+            raise GateError(f"gate_checks[{index}].id must be unique and non-empty")
+        seen.add(check_id)
+        command = item.get("command")
+        if not isinstance(command, list) or len(command) < 2 or not all(isinstance(part, str) and part for part in command):
+            raise GateError(f"gate_checks[{index}].command must be a non-empty argument vector")
+        if command[0] not in {"python3", sys.executable}:
+            raise GateError(f"gate check {check_id} must invoke Python directly, not a shell")
+        script_rel = _safe_rel(command[1], f"gate_checks[{index}].command[1]")
+        if not script_rel.startswith("scripts/"):
+            raise GateError(f"gate check {check_id} script must live under scripts/")
+        script = ROOT / script_rel
+        if _first_symlink_component(script) is not None or not script.is_file():
+            raise GateError(f"gate check {check_id} script is missing, non-regular, or symlinked: {script_rel}")
+        timeout_seconds = item.get("timeout_seconds", 180)
+        if isinstance(timeout_seconds, bool) or not isinstance(timeout_seconds, int) or not 1 <= timeout_seconds <= 1800:
+            raise GateError(f"gate check {check_id} timeout_seconds must be 1..1800")
+        checks.append({
+            "id": check_id,
+            "description": str(item.get("description", "")),
+            "command": ["python3", script_rel, *command[2:]],
+            "timeout_seconds": timeout_seconds,
+        })
+    return manifest, checks
+
+
+def _atomic_write_json(path: Path, payload: dict[str, Any]) -> None:
+    path = path.resolve()
+    try:
+        path.relative_to(ROOT.resolve())
+    except ValueError as exc:
+        raise GateError("--report must resolve inside the overlay bundle") from exc
+    if _first_symlink_component(path) is not None:
+        raise GateError("--report may not pass through a symlink")
+    path.parent.mkdir(parents=True, exist_ok=True)
+    encoded = json.dumps(payload, indent=2, sort_keys=True) + "\n"
+    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as tmp:
+        tmp.write(encoded)
+        tmp.flush()
+        os.fsync(tmp.fileno())
+        tmp_path = Path(tmp.name)
+    os.replace(tmp_path, path)
+
+
+def _run_check(check: dict[str, Any], timeout_override: int | None) -> dict[str, Any]:
+    command = list(check["command"])
+    timeout = timeout_override or int(check["timeout_seconds"])
+    started = time.monotonic()
+    env = dict(os.environ)
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    try:
+        proc = subprocess.run(
+            command,
+            cwd=ROOT,
+            env=env,
+            text=True,
+            capture_output=True,
+            timeout=timeout,
+            check=False,
+        )
+        return {
+            "id": check["id"],
+            "description": check["description"],
+            "command": command,
+            "timeout_seconds": timeout,
+            "duration_seconds": round(time.monotonic() - started, 3),
+            "exit_code": proc.returncode,
+            "status": "pass" if proc.returncode == 0 else "fail",
+            "stdout": proc.stdout,
+            "stderr": proc.stderr,
+        }
+    except subprocess.TimeoutExpired as exc:
+        return {
+            "id": check["id"],
+            "description": check["description"],
+            "command": command,
+            "timeout_seconds": timeout,
+            "duration_seconds": round(time.monotonic() - started, 3),
+            "exit_code": None,
+            "status": "timeout",
+            "stdout": exc.stdout or "",
+            "stderr": exc.stderr or "",
+        }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="Run the current EvidenceVault overlay gate.")
+    parser.add_argument("--json", action="store_true", help="emit one JSON result object")
+    parser.add_argument("--list", action="store_true", help="list configured checks without running them")
+    parser.add_argument("--check", action="append", default=[], help="run only the named check; repeatable")
+    parser.add_argument("--report", help="write the JSON result to a relative path inside the bundle")
+    parser.add_argument("--timeout", type=int, help="override each check timeout in seconds (1..1800)")
+    args = parser.parse_args()
+
+    if args.timeout is not None and not 1 <= args.timeout <= 1800:
+        parser.error("--timeout must be between 1 and 1800")
+
+    try:
+        manifest, checks = _load_checks()
+        selected_ids = set(args.check)
+        known_ids = {row["id"] for row in checks}
+        unknown = sorted(selected_ids - known_ids)
+        if unknown:
+            raise GateError("unknown --check id(s): " + ", ".join(unknown))
+        selected = [row for row in checks if not selected_ids or row["id"] in selected_ids]
+
+        if args.list:
+            payload = {
+                "project": manifest.get("project"),
+                "overlay_revision": manifest.get("overlay_revision"),
+                "mode": "list",
+                "checks": selected,
+            }
+            if args.report:
+                _atomic_write_json(ROOT / _safe_rel(args.report, "--report"), payload)
+            if args.json:
+                print(json.dumps(payload, indent=2, sort_keys=True))
+            else:
+                for row in selected:
+                    print(f"{row['id']}: {' '.join(row['command'])}")
+            return 0
+
+        results = [_run_check(row, args.timeout) for row in selected]
+        failed = [row for row in results if row["status"] != "pass"]
+        payload = {
+            "project": manifest.get("project"),
+            "overlay_revision": manifest.get("overlay_revision"),
+            "archive_name": manifest.get("archive_name"),
+            "mode": "run",
+            "status": "pass" if not failed else "fail",
+            "check_count": len(results),
+            "passed": len(results) - len(failed),
+            "failed": len(failed),
+            "results": results,
+        }
+        if args.report:
+            _atomic_write_json(ROOT / _safe_rel(args.report, "--report"), payload)
+        if args.json:
+            print(json.dumps(payload, indent=2, sort_keys=True))
+        else:
+            for row in results:
+                suffix = f" exit={row['exit_code']}" if row["exit_code"] is not None else ""
+                print(f"[{row['status'].upper()}] {row['id']} ({row['duration_seconds']:.3f}s){suffix}")
+                if row["status"] != "pass":
+                    detail = (row["stderr"] or row["stdout"]).strip()
+                    if detail:
+                        print(detail, file=sys.stderr)
+            print(f"overlay-gate: {payload['status'].upper()} ({payload['passed']}/{payload['check_count']} passed)")
+        return 0 if not failed else 1
+    except GateError as exc:
+        if args.json:
+            print(json.dumps({"status": "error", "error": str(exc)}, indent=2, sort_keys=True))
+        else:
+            print(f"overlay-gate: ERROR: {exc}", file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
