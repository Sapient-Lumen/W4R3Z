+
+
+def assert_absent_public_path_blocks() -> None:
+    with tempfile.TemporaryDirectory(prefix="ev-rev0848-pqi-public-path-missing-") as tmp:
+        root = Path(tmp) / "EvidenceVault-fixture"
+        root.mkdir()
