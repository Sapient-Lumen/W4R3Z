+    )
+
+
+def with_root(root: Path):
+    @contextlib.contextmanager
+    def manager():
+        old_root = pqi.ROOT
+        pqi.ROOT = root
+        try:
+            yield
+        finally:
+            pqi.ROOT = old_root
+    return manager()
+
+
