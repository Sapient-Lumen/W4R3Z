+        }
+        if (!prepared_effect_keys.insert(record.prepared.effect_idempotency_key).second) {
+            throw std::runtime_error(
+                label + " multiple ingress sender replay rows reference one prepared effect");
+        }
+        ++row_count;
+    }
+    return row_count;
+}
