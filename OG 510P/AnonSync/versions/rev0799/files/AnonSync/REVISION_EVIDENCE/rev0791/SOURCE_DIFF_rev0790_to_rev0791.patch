+void verify_foreign_key_integrity(sqlite3* db, const std::string& label) {
+    Stmt stmt(db, "PRAGMA foreign_key_check;", label + " foreign_key_check prepare failed");
+    const int rc = sqlite3_step(stmt.stmt);
+    if (rc == SQLITE_ROW) {
+        throw std::runtime_error(label + " foreign_key_check reported a durable reference violation");
+    }
+    if (rc != SQLITE_DONE) sqlite_throw(db, label + " foreign_key_check step failed");
+}
