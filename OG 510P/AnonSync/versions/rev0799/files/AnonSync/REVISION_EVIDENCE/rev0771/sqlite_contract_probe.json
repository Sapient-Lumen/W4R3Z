{
  "sqlite_version": "3.46.1",
  "probes": {
    "temp_shadowing": {
      "unqualified": "temp",
      "main_qualified": "main",
      "pass": true
    },
    "read_snapshot": {
      "before": 1,
      "during_concurrent_commit": 1,
      "after_commit": 2,
      "pass": true
    },
    "schema_cookie_not_manifest": {
      "initial_cookie": 1,
      "after_ddl_cookie": 2,
      "after_reset_cookie": 1,
      "ddl_changed": true,
      "reset_supported": true,
      "pass": true
    },
    "trusted_schema_off": {
      "readback": 0,
      "pass": true
    }
  },
  "all_pass": true
}