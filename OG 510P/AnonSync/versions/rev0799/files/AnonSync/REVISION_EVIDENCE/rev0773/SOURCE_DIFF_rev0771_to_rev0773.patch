+bool SyncSqliteTransactionAuthority::authorizes(sqlite3* db) const noexcept {
+    const std::shared_ptr<SyncSqliteTransactionAuthorityState> state = state_.lock();
+    if (state == nullptr ||
+        !state->active.load(std::memory_order_acquire) ||
+        state->db == nullptr || state->db != db) {
+        return false;
+    }
+    if (sqlite3_get_autocommit(db) != 0) {
+        // A caller bypassed the owner or SQLite automatically rolled back.
+        // Once an ended boundary is observed, permanently revoke this guard
+        // generation so it cannot authorize a later transaction on the same
+        // handle.
+        state->active.store(false, std::memory_order_release);
+        return false;
+    }
+    return true;
+}
