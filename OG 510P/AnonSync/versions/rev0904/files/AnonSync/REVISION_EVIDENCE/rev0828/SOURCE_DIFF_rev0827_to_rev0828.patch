+inline void cleanup_family(const fs::path& path) {
+    for (const std::string_view suffix :
+         {"", "-wal", "-shm", "-journal", ".write.lock"}) {
+        std::error_code ignored;
+        fs::remove(fs::path(path.string() + std::string(suffix)), ignored);
+    }
