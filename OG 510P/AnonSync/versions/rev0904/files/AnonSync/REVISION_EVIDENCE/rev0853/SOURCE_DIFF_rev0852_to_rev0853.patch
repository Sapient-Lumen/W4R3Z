+class SqliteDatabaseMutexScope final {
+public:
+    explicit SqliteDatabaseMutexScope(sqlite3* database) noexcept
+        : mutex_(sqlite3_db_mutex(database)) {
+        // SQLite documents a serialized connection mutex as recursive. The
+        // subsequent SQLite calls may therefore enter this same mutex while
+        // the ownership probe and alternate setter remain one atomic region.
+        sqlite3_mutex_enter(mutex_);
+    }
+
+    ~SqliteDatabaseMutexScope() { sqlite3_mutex_leave(mutex_); }
+
+    SqliteDatabaseMutexScope(const SqliteDatabaseMutexScope&) = delete;
+    SqliteDatabaseMutexScope& operator=(const SqliteDatabaseMutexScope&) = delete;
+
+private:
+    sqlite3_mutex* mutex_ = nullptr;
+};
