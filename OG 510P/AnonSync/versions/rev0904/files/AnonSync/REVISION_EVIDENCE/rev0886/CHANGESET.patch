+                            break;
+                        case anonsync::SyncReplicaTlsRecordReadPollProgress::
+                            WantRead:
+                            progress = anonsync::
+                                SyncReplicaTlsRecordReadProgress::WantRead;
+                            have_progress = true;
+                            break;
+                        case anonsync::SyncReplicaTlsRecordReadPollProgress::
+                            WantWrite:
+                            progress = anonsync::
+                                SyncReplicaTlsRecordReadProgress::WantWrite;
+                            have_progress = true;
+                            break;
+                        case anonsync::SyncReplicaTlsRecordReadPollProgress::
+                            Complete:
+                            progress = anonsync::
+                                SyncReplicaTlsRecordReadProgress::Complete;
