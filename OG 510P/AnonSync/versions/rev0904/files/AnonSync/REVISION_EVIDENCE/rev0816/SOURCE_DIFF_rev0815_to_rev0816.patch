+std::string render_rows(const std::vector<int>& values) {
+    std::string out = "[";
+    for (std::size_t index = 0; index < values.size(); ++index) {
+        if (index != 0) out += ",";
+        out += std::to_string(values[index]);
+    }
+    out += "]";
+    return out;
