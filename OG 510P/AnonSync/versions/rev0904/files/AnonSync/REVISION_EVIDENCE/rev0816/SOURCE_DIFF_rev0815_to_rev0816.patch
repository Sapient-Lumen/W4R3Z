+int parent_main() {
+    const std::string executable = executable_path();
+    std::uint64_t checks = 0;
+    std::uint64_t workers = 0;
+    std::uint64_t cutpoints = 0;
+
+    for (const auto& [name, scenario] : kScenarios) {
