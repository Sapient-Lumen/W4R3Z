+#!/usr/bin/env python3
+"""Deterministic source audit for SQLite transaction allocator-fault recovery.
+
+The runtime campaign proves compiled behavior under allocation cuts. This audit
+binds the process-isolation machinery, allocator overlay, tri-state authority
+classification, retry/revocation split, and removal of redundant sqlite3_exec()
+error-buffer ownership from the reviewed runtime helpers.
+"""
