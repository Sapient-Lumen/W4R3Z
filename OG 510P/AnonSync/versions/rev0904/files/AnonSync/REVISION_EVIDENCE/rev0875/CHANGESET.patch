+void test_linux_time_namespace_probe_classification() {
+    using anonsync::sync_replica_outbox_clock_linux_detail::
+        TimeNamespaceProbeClassification;
+    using anonsync::sync_replica_outbox_clock_linux_detail::
+        classify_time_namespace_probe;
