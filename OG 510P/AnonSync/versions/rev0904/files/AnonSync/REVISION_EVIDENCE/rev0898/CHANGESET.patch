+[[nodiscard]] bool lowercase_sha256(std::string_view value) noexcept {
+    if (value.size() != 64U) return false;
+    for (const char byte : value) {
+        if (!((byte >= '0' && byte <= '9') ||
+              (byte >= 'a' && byte <= 'f'))) {
+            return false;
+        }
+    }
+    return true;
