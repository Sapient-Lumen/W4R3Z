+        for (int i = 0; i < 4; ++i) {
+            char h = get();
+            cp <<= 4;
+            if (h >= '0' && h <= '9') cp |= static_cast<uint32_t>(h - '0');
+            else if (h >= 'a' && h <= 'f') cp |= static_cast<uint32_t>(10 + h - 'a');
+            else if (h >= 'A' && h <= 'F') cp |= static_cast<uint32_t>(10 + h - 'A');
+            else throw std::runtime_error("bad unicode escape");
+        }
+        return cp;
+    }
