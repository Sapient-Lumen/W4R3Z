+        };
+        out.push_back(static_cast<char>(first));
+        if (first >= 0xC2U && first <= 0xDFU) {
+            out.push_back(static_cast<char>(continuation()));
+            return;
+        }
+        if (first >= 0xE0U && first <= 0xEFU) {
