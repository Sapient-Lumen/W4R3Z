+            continue
+        if quote:
+            if escaped:
+                escaped = False
+            elif byte == "\\":
+                escaped = True
+            elif byte == quote:
+                quote = ""
+            index += 1
+            continue
+        if byte == "/" and following == "/":
+            line_comment = True
+            index += 2
+            continue
+        if byte == "/" and following == "*":
+            block_comment = True
+            index += 2
+            continue
+        if byte == "#":
+            line_comment = True
+            index += 1
