+class JsonParser {
+  public:
+    explicit JsonParser(std::string text) : text_(std::move(text)) {}
+
+    Json parse() {
+        Json v = parse_value();
+        skip_ws();
+        if (pos_ != text_.size()) throw std::runtime_error("trailing JSON content at byte " + std::to_string(pos_));
+        return v;
+    }
