+#!/usr/bin/env python3
+"""Lexical audit for explicit bootstrap and manifest-bound operations.
+
+This pins reviewed source shape and test vocabulary. It is deliberately not a
+semantic proof of filesystem identity, SQLite transaction behavior, race
+freedom, crash recovery, or cross-resource atomicity; compiled/process tests
+and release evidence remain load-bearing.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from dataclasses import asdict, dataclass
+from pathlib import Path
+
+
+REQUIRED = (
+    Path("CMakeLists.txt"),
+    Path("include/anonsync_json_parser.hpp"),
+    Path("src/anonsync_json_parser.cpp"),
+    Path("src/anonsync_replica.cpp"),
+    Path("src/json_codec_crypto.cpp"),
+    Path("src/sync_atomic_file_publication.hpp"),
+    Path("src/sync_replica_deployment_manifest.hpp"),
