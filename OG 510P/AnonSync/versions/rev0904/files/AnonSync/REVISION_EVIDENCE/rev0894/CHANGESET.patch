+    int descriptor;
+    do {
+        descriptor = ::open(
+            path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+    } while (descriptor < 0 && errno == EINTR);
+    if (descriptor < 0) return false;
