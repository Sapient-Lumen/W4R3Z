+SOURCE_SUFFIXES = {".c", ".cc", ".cpp", ".cxx", ".h", ".hh", ".hpp", ".hxx"}
+FORK_CALL = re.compile(r"(?<![A-Za-z0-9_])(?:::)?fork\s*\(")
+RAW_LITERAL_START = re.compile(
+    r'(?:u8|u|U|L)?R"([^ ()\\\t\r\n]{0,16})\('
+)
+QUOTED_LITERAL_START = re.compile(r'(?:u8|u|U|L)?(["\'])')
+EXPECTED_TEST_CALLS = {
+    "tests/persistence/sqlite_persistence_process_authority_fork_test.cpp": 2,
+    "tests/process_incarnation_tests.cpp": 4,
+    "tests/sqlite_connection_authority_test.cpp": 1,
+    "tests/sqlite_owner_generation_borrow_test.cpp": 2,
+    "tests/sqlite_process_authority_fork_test.cpp": 1,
+    "tests/sqlite_replay_ledger_selftests.cpp": 3,
+    "tests/sqlite_source_first_move_test.cpp": 1,
+    "tests/sqlite_transaction_allocator_fault_test.cpp": 1,
+    "tests/sync_atomic_file_publication_prepared_test.cpp": 1,
+}
+
+FORK_EXEC_BRIDGE = "tests/sqlite_transaction_allocator_fault_test.cpp"
+
+MIGRATED_CAMPAIGNS = {
+    "tests/sync_atomic_file_publication_test.cpp":
+        "--anonsync-atomic-publication-writer-helper-v1",
+    "tests/sync_atomic_file_publication_cutpoint_test.cpp":
+        "--anonsync-atomic-publication-crash-helper-v1",
+    "tests/sqlite_runtime_payload_store_test.cpp":
+        "--anonsync-payload-crash-helper-v1",
+    "tests/peer_ingress_schema_attestation_test.cpp":
+        "--anonsync-peer-schema-owner-close-helper-v1",
+}
+
+REQUIRED = (
+    Path("CMakeLists.txt"),
+    Path("src/sync_atomic_file_publication.cpp"),
+    Path("tests/sync_atomic_file_publication_prepared_test.cpp"),
+    Path("tools/audit_raw_fork_boundaries.py"),
+    *tuple(Path(path) for path in MIGRATED_CAMPAIGNS),
+    *tuple(Path(path) for path in EXPECTED_TEST_CALLS),
+)
+
+
+@dataclass(frozen=True)
+class Check:
+    check_id: str
+    passed: bool
+    detail: str
+
+
+def erase_non_code(text: str) -> str:
+    """Replace comments and literals with spaces while preserving newlines.
+
+    The scanner handles ordinary string/character literals and C++ raw string
+    literals. It is intentionally independent of a compiler so the inventory
+    remains cheap enough to run in every CTest gate.
+    """
+
+    out = list(text)
+    n = len(text)
+    i = 0
+
+    def blank(start: int, stop: int) -> None:
+        for index in range(start, min(stop, n)):
+            if out[index] != "\n":
+                out[index] = " "
+
+    while i < n:
+        if text.startswith("//", i):
+            stop = text.find("\n", i + 2)
+            stop = n if stop < 0 else stop
+            blank(i, stop)
+            i = stop
+            continue
+        if text.startswith("/*", i):
+            stop = text.find("*/", i + 2)
+            stop = n if stop < 0 else stop + 2
+            blank(i, stop)
+            i = stop
+            continue
+
+        # Raw strings may carry a prefix (u8R, uR, UR, LR, or R). The
+        # delimiter is at most 16 characters and ends at the next '('.
+        raw_match = RAW_LITERAL_START.match(text, i)
+        if raw_match:
+            delimiter = raw_match.group(1)
+            terminator = ")" + delimiter + '"'
+            body_start = raw_match.end()
+            end = text.find(terminator, body_start)
+            stop = n if end < 0 else end + len(terminator)
+            blank(i, stop)
+            i = stop
+            continue
+
+        prefix_match = QUOTED_LITERAL_START.match(text, i)
+        if prefix_match:
+            quote = prefix_match.group(1)
+            j = prefix_match.end()
+            escaped = False
+            while j < n:
+                char = text[j]
+                if char == "\n" and not escaped:
+                    break
+                if escaped:
+                    escaped = False
+                elif char == "\\":
+                    escaped = True
+                elif char == quote:
+                    j += 1
+                    break
+                j += 1
+            blank(i, j)
+            i = j
+            continue
+        i += 1
+    return "".join(out)
+
+
+def source_files(root: Path, directory: str) -> list[Path]:
+    base = root / directory
+    if not base.is_dir():
+        return []
+    return sorted(
+        path for path in base.rglob("*")
+        if path.is_file() and path.suffix.lower() in SOURCE_SUFFIXES
+    )
+
+
+def raw_fork_inventory(root: Path, directory: str) -> dict[str, int]:
+    inventory: dict[str, int] = {}
+    for path in source_files(root, directory):
+        text = path.read_text(encoding="utf-8", errors="replace")
+        if "fork" not in text:
+            continue
+        count = len(FORK_CALL.findall(erase_non_code(text)))
+        if count:
+            inventory[path.relative_to(root).as_posix()] = count
+    return inventory
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--root", type=Path, required=True)
+    parser.add_argument("--json", type=Path)
+    args = parser.parse_args()
+    root = args.root.resolve()
+
+    missing = sorted(path.as_posix() for path in REQUIRED if not (root / path).is_file())
+    checks: list[Check] = []
+
+    def require(condition: bool, check_id: str, detail: str) -> None:
+        checks.append(Check(check_id, bool(condition), detail))
+
+    require(not missing, "required_files_exist", f"missing={missing}")
+    if missing:
+        report = {
+            "format": "anonsync-raw-fork-boundary-audit-v1",
+            "root": str(root),
+            "passed": False,
+            "passed_checks": 0,
+            "total_checks": len(checks),
+            "checks": [asdict(check) for check in checks],
+            "violations": [f"missing required file: {path}" for path in missing],
+        }
+        rendered = json.dumps(report, indent=2, sort_keys=True) + "\n"
+        if args.json:
+            args.json.parent.mkdir(parents=True, exist_ok=True)
+            args.json.write_text(rendered, encoding="utf-8")
+        else:
+            sys.stdout.write(rendered)
+        return 2
+
+    production = {
+        **raw_fork_inventory(root, "src"),
+        **raw_fork_inventory(root, "include"),
+    }
+    tests = raw_fork_inventory(root, "tests")
+
+    require(
+        production == {},
+        "production_contains_no_raw_fork_calls",
+        f"production_raw_fork_calls={production}",
+    )
+    require(
+        tests == EXPECTED_TEST_CALLS,
+        "test_raw_fork_allowlist_and_counts_are_exact",
+        f"observed={tests}; expected={EXPECTED_TEST_CALLS}",
+    )
+
+    migrated_ok = True
+    migrated_detail: list[str] = []
+    for relative, helper_flag in MIGRATED_CAMPAIGNS.items():
+        text = (root / relative).read_text(encoding="utf-8")
+        code = erase_non_code(text)
+        call_count = len(FORK_CALL.findall(code))
+        no_waitpid = re.search(r"(?<![A-Za-z0-9_])(?:::)?waitpid\s*\(", code) is None
+        tokens_ok = all(
+            token in text
+            for token in (
+                '#include "self_exec_test_process.hpp"',
+                helper_flag,
+                "verify_self_exec_child_boundary_or_throw()",
+                "spawn_self_exec_test_process_or_throw(",
+                "wait_for_exact_exit(",
+            )
+        )
+        file_ok = call_count == 0 and no_waitpid and tokens_ok
+        migrated_ok = migrated_ok and file_ok
+        migrated_detail.append(
+            f"{relative}:fork={call_count},no_waitpid={no_waitpid},tokens={tokens_ok}"
+        )
+    require(
+        migrated_ok,
+        "four_crash_campaigns_use_fresh_self_exec_images",
+        "; ".join(migrated_detail),
+    )
+
+    prepared_path = root / "tests/sync_atomic_file_publication_prepared_test.cpp"
+    prepared = prepared_path.read_text(encoding="utf-8")
+    prepared_code = erase_non_code(prepared)
+    fork_match = FORK_CALL.search(prepared_code)
+    child_window = ""
+    if fork_match:
+        child_window = prepared[prepared_code.find("const pid_t child", max(0, fork_match.start() - 80)) :]
+        child_window = child_window[: child_window.find("const int child_status")]
+    inherited_ok = (
+        len(FORK_CALL.findall(prepared_code)) == 1
+        and "Raw fork is intentional here" in prepared
+        and "wait_for_inherited_capability_probe_or_throw" in prepared
+        and "std::chrono::steady_clock" in prepared
+        and "WNOHANG" in prepared
+        and "SIGKILL" in prepared
+        and "timed out and was killed and reaped" in prepared
+        and "fork_plan.publish_or_throw();" in child_window
+        and "_exit(kSyncProcessCapabilityViolationExitCode);" not in child_window
+        and "_exit(91);" in child_window
+        and "_exit(92);" in child_window
+        and "write_sync_" not in child_window
+        and "sqlite3_" not in child_window
+    )
+    require(
+        inherited_ok,
+        "intentional_inherited_capability_probe_is_minimal_and_bounded",
+        "one raw child invokes only the inherited capability; parent uses monotonic WNOHANG timeout, SIGKILL, and reap",
+    )
+
+    fork_exec_path = root / FORK_EXEC_BRIDGE
+    fork_exec = fork_exec_path.read_text(encoding="utf-8")
+    fork_exec_code = erase_non_code(fork_exec)
+    child_start = fork_exec_code.find("if (child == 0)")
+    child_stop = fork_exec_code.find("(void)::close(pipe_fds[1]);", child_start)
+    # Select the parent-side close, not the same spelling inside the child.
+    child_stop = fork_exec_code.find("(void)::close(pipe_fds[1]);", child_stop + 1)
+    fork_exec_child = (
+        fork_exec[child_start:child_stop]
+        if child_start >= 0 and child_stop > child_start
+        else ""
+    )
+    fork_exec_ok = (
+        len(FORK_CALL.findall(fork_exec_code)) == 1
+        and "Materialize every exec argument before fork" in fork_exec
+        and all(
+            token in fork_exec_child
+            for token in (
+                "(void)::close(pipe_fds[0]);",
+                "::dup2(pipe_fds[1], STDOUT_FILENO)",
+                "::dup2(pipe_fds[1], STDERR_FILENO)",
+                "(void)::close(pipe_fds[1]);",
+                "::execl(executable.c_str(),",
+                "std::_Exit(120);",
+                "std::_Exit(121);",
+            )
+        )
+        and not any(
+            token in fork_exec_child
+            for token in (
+                "sqlite3_",
+                "run_scenario(",
+                "std::cout",
+                "std::cerr",
+                "throw ",
+                "fail(",
+                " new ",
+                " delete ",
+            )
+        )
+    )
+    require(
+        fork_exec_ok,
+        "allocator_fault_fork_exec_bridge_has_no_application_or_sqlite_child_work",
+        "the sole non-inheritance raw child performs close/dup2/exec/_Exit only; capture-capable SelfExecTestProcess migration remains future work",
+    )
+
+    publication = (root / "src/sync_atomic_file_publication.cpp").read_text(
+        encoding="utf-8"
+    )
+    require(
+        "require_sync_process_incarnation_or_fail_stop(" in publication
+        and "implementation->owner_process_incarnation" in publication
+        and "prepared immutable JSON publication destination authority" in publication
+        and "implementation->label +" not in publication
+        and "belongs to a different process incarnation" not in publication,
+        "prepared_publication_process_mismatch_fail_stops",
+        "an inherited nonempty publication capability cannot unwind through application code before touching filesystem state",
+    )
+
+    cmake = (root / "CMakeLists.txt").read_text(encoding="utf-8")
+    cmake_links = all(
+        token in cmake
+        for token in (
+            "ANONSYNC_SELF_EXEC_ATOMIC_TARGET",
+            "anonsync_sync_atomic_file_publication_test",
+            "anonsync_sync_atomic_file_publication_cutpoint_test",
+            "target_link_libraries(anonsync_sqlite_runtime_payload_store_test PRIVATE\n    anonsync_self_exec_test_process)",
+            "target_link_libraries(anonsync_peer_ingress_schema_attestation_test PRIVATE\n    anonsync_self_exec_test_process)",
+        )
+    )
+    require(
+        cmake_links,
+        "all_four_helpers_link_the_test_only_process_owner",
+        "CMake links the fresh-image owner into the two atomic, payload, and peer-schema executables only",
+    )
+    require(
+        "anonsync_raw_fork_boundary_source_audit" in cmake
+        and "tools/audit_raw_fork_boundaries.py" in cmake
+        and "PROPERTIES TIMEOUT 20" in cmake,
+        "raw_fork_inventory_is_in_the_ctest_gate",
+        "future fork additions or removals cannot silently bypass the exact inventory",
+    )
+
+    total_production = sum(production.values())
+    total_test = sum(tests.values())
+    metrics_ok = (
+        total_production == 0
+        and total_test == 16
+        and len(tests) == 9
+        and len(MIGRATED_CAMPAIGNS) == 4
+        and EXPECTED_TEST_CALLS.get(FORK_EXEC_BRIDGE) == 1
+    )
+    require(
+        metrics_ok,
+        "inventory_metrics_are_exact",
+        f"production_calls={total_production}, test_calls={total_test}, allowlisted_test_tus={len(tests)}, inherited_probe_calls={total_test - EXPECTED_TEST_CALLS[FORK_EXEC_BRIDGE]}, fork_exec_bridge_calls={EXPECTED_TEST_CALLS[FORK_EXEC_BRIDGE]}, migrated_campaigns={len(MIGRATED_CAMPAIGNS)}",
+    )
+
+    failures = [check.check_id for check in checks if not check.passed]
+    report = {
+        "format": "anonsync-raw-fork-boundary-audit-v1",
+        "root": str(root),
+        "passed": not failures,
+        "passed_checks": sum(check.passed for check in checks),
+        "total_checks": len(checks),
+        "checks": [asdict(check) for check in checks],
+        "metrics": {
+            "production_raw_fork_calls": total_production,
+            "allowlisted_test_raw_fork_calls": total_test,
+            "allowlisted_test_translation_units": len(tests),
+            "fresh_image_migrated_campaigns": len(MIGRATED_CAMPAIGNS),
+            "inherited_probe_raw_fork_calls": total_test - EXPECTED_TEST_CALLS[FORK_EXEC_BRIDGE],
+            "reviewed_fork_exec_bridge_calls": EXPECTED_TEST_CALLS[FORK_EXEC_BRIDGE],
+        },
+        "production_inventory": production,
+        "test_inventory": tests,
+        "violations": failures,
+    }
+    rendered = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if args.json:
+        args.json.parent.mkdir(parents=True, exist_ok=True)
+        args.json.write_text(rendered, encoding="utf-8")
+    else:
+        sys.stdout.write(rendered)
+    return 0 if not failures else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
