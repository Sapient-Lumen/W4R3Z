+#!/usr/bin/env python3
+"""Fail-closed inventory of raw fork() boundaries in AnonSync.
+
+Raw fork is allowlisted only for explicit inherited-state probes or for one
+reviewed fork-exec bridge whose child performs descriptor syscalls and exec only.
+Crash/fail-stop campaigns that need application or SQLite work in a separate
+process must cross the Linux self-exec boundary and begin in a fresh image.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+from dataclasses import asdict, dataclass
+from pathlib import Path
+
