+            (void)inner;
+            return kFocusedHelperUnexpectedReturn;
+        }
+        if (instruction.action ==
+            FocusedHelperAction::WriteGateCrossThreadDestruction) {
+            std::unique_ptr<SqliteReplayLedgerWriteGate> transferred;
+            std::atomic<bool> acquired{false};
