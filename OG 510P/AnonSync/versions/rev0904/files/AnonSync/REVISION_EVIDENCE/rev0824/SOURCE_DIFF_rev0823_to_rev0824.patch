+std::filesystem::path absolute_normal_cli_path_or_throw(
+    const std::string& path,
+    const std::string& label) {
+    if (path.empty()) throw std::runtime_error(label + " requires a nonempty path");
+    std::error_code error;
+    const std::filesystem::path absolute =
+        std::filesystem::absolute(std::filesystem::path(path), error);
+    if (error) {
+        throw std::runtime_error(label + " could not normalize path: " +
+                                 error.message());
+    }
+    return absolute.lexically_normal();
+}
+
+bool existing_paths_are_equivalent(const std::filesystem::path& first,
+                                   const std::filesystem::path& second) {
+    std::error_code first_error;
+    const bool first_exists = std::filesystem::exists(first, first_error);
+    std::error_code second_error;
+    const bool second_exists = std::filesystem::exists(second, second_error);
+    if (first_error || second_error || !first_exists || !second_exists) {
+        return false;
+    }
+    std::error_code equivalent_error;
+    const bool equivalent =
+        std::filesystem::equivalent(first, second, equivalent_error);
+    return !equivalent_error && equivalent;
+}
+
+void reject_reset_publication_inside_ledger_namespace_or_throw(
+    const std::string& ledger_path,
+    const std::string& publication_path,
+    const std::string& label) {
+    const std::filesystem::path ledger =
+        absolute_normal_cli_path_or_throw(ledger_path, label + " ledger");
+    const std::filesystem::path publication = absolute_normal_cli_path_or_throw(
+        publication_path, label + " publication");
+    constexpr std::array<std::string_view, 7> suffixes{{
+        "", "-wal", "-shm", "-journal", ".write.lock", ".restore.lock",
+        ".reset.lock"}};
+    for (const std::string_view suffix : suffixes) {
+        const std::filesystem::path family_member =
+            std::filesystem::path(ledger.string() + std::string(suffix));
+        if (publication == family_member ||
+            existing_paths_are_equivalent(publication, family_member)) {
+            throw std::runtime_error(
+                label + " refuses publication inside the SQLite ledger namespace");
+        }
+    }
+}
+
+void reject_reset_receipt_request_alias_or_throw(
+    const std::string& request_path,
+    const std::string& receipt_path) {
+    const std::filesystem::path request = absolute_normal_cli_path_or_throw(
+        request_path, "sqlite-wal replay ledger reset request");
+    const std::filesystem::path receipt = absolute_normal_cli_path_or_throw(
+        receipt_path, "sqlite-wal replay ledger reset receipt");
+    if (request == receipt || existing_paths_are_equivalent(request, receipt)) {
+        throw std::runtime_error(
+            "sqlite-wal replay ledger reset receipt must not alias its digest-pinned request");
+    }
+}
