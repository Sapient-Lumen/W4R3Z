+std::pair<dev_t, ino_t> identity_of(const fs::path& path) {
+    struct stat status {};
+    if (::stat(path.c_str(), &status) != 0) {
+        throw std::runtime_error("could not stat focused ledger fixture");
+    }
+    return {status.st_dev, status.st_ino};
