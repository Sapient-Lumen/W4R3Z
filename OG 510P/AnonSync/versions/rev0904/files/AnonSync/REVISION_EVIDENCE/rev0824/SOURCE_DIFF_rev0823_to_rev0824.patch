+int run_sqlite_replay_ledger_reset_state_command(
+    const std::string& ledger_path,
+    const std::string& report_path) {
+    try {
+        if (ledger_path.empty() || report_path.empty()) {
+            throw std::runtime_error(
+                "sqlite-wal replay ledger reset-state inspection requires ledger and report paths");
+        }
+        reject_reset_publication_inside_ledger_namespace_or_throw(
+            ledger_path, report_path,
+            "sqlite-wal replay ledger reset-state report");
+        const persistence::SqliteReplayLedgerResetState state =
+            persistence::inspect_sqlite_replay_ledger_reset_state(ledger_path);
+        const persistence::SqliteReplayLedgerResetExpectation expected =
+            reset_expectation_from_state(state);
+        std::ostringstream out;
+        out << "{\n"
+            << "  \"format\": \""
+            << persistence::kSqliteReplayLedgerResetStateFormat << "\",\n"
+            << "  \"backend_name\": \"sqlite-wal\",\n"
+            << "  \"ledger_path\": \""
+            << json_escape(state.normalized_ledger_path) << "\",\n"
+            << "  \"expected\": "
+            << sqlite_replay_ledger_reset_expectation_json(expected, "  ")
+            << ",\n"
+            << "  \"observation\": {\n"
+            << "    \"connection_owner_generation\": \""
+            << state.connection_owner_generation << "\"\n"
+            << "  }\n"
+            << "}\n";
+        write_sync_cli_report_json_or_throw(
+            report_path, out.str(),
+            "sqlite-wal replay ledger reset-state report");
+        return 0;
+    } catch (const SyncAtomicFilePublicationError& error) {
+        std::cerr
+            << "sqlite-wal replay ledger reset-state report publication failed"
+            << " outcome="
+            << sync_atomic_file_publication_outcome_name(error.outcome())
+            << " residue="
+            << sync_atomic_file_publication_residue_name(error.residue())
+            << ": " << error.what() << "\n";
+        return 1;
+    } catch (const std::exception& error) {
+        std::cerr << "sqlite-wal replay ledger reset-state inspection failed: "
+                  << error.what() << "\n";
+        return 1;
+    }
+}
