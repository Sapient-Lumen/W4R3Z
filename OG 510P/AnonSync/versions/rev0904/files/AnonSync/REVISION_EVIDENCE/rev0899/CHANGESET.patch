+    digest_body = delimited_body(binding, "binding_digest_or_throw(")
+    require(
+        ordered(
+            digest_body,
+            "kBindingDigestDomain", "kBindingFormat", "deployment_id",
+            "manifest_digest", "manifest_path", "role", "database_path",
+            "folder_id", "device_id", "epoch", "application_id",
