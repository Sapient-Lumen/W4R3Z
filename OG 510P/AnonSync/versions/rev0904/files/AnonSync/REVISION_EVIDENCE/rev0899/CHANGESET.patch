+        .deployment_id = std::string(64U, deployment_byte),
+        .manifest_digest = std::string(64U, digest_byte),
+        .manifest_path = temporary.path() / "deployment.json",
+        .folder_id = "folder-alpha",
+        .local_actor = {"device-alpha", 7U},
+    };
+}
