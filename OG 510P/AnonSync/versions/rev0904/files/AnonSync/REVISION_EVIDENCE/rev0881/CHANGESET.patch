+void test_pre_dispatch_failure_releases_exact_attempt_and_bounds_policy() {
+    {
+        TempWorkspace workspace("anonsync-file-delivery-callback-failure");
+        const std::string folder = "folder-file-delivery-callback-failure";
+        const anonsync::SyncReplicaActor sender_actor{
+            "device-file-delivery-callback-sender", 9771U};
+        const anonsync::SyncReplicaActor receiver_actor{
+            "device-file-delivery-callback-receiver", 9772U};
+        const auto clock = std::make_shared<MutableClockState>();
+        anonsync::SyncSqliteDb sender_db = open_database(workspace.sender_db);
+        anonsync::SyncReplicaSqliteOwner sender(
+            sender_db.db, folder, sender_actor, owner_limits(),
+            "callback-failure sender", make_clock(clock));
+        anonsync::SyncReplicaFileDeliveryService service(
+            sender, nullptr, service_limits(), "callback-failure service");
+        const std::vector<std::string> destinations{receiver_actor.device_id};
+        const std::string payload = "callback-failure-payload";
+        const auto operation = sender.create_local_file_or_throw(
+            "callback.bin", payload.size(), anonsync::sha256_hex(payload),
+            destinations);
+        auto channel = sender_channel(receiver_actor, "callback-failure-session");
+        clock->epoch = 720U;
+        std::optional<anonsync::SyncReplicaSqliteSnapshot> claimed;
+        require_error(
+            [&] {
+                (void)service.claim_next_request_or_throw(
+                    channel, "callback-failure-worker", 10U,
+                    [&](const anonsync::SyncReplicaOperation& requested)
+                        -> std::string {
+                        require(requested == operation,
+                                "failing payload callback saw another operation");
+                        claimed = sender.snapshot_or_throw();
+                        throw std::runtime_error("payload source boom");
+                    });
+            },
+            "payload source boom",
+            "payload callback failure was hidden by retry release");
+        require(claimed.has_value(),
+                "payload callback did not observe the committed claim");
+        require_exact_retry_release(
+            *claimed, sender.snapshot_or_throw(), operation.operation_id, 1U,
+            720U, 722U,
+            "payload callback failure did not release the exact attempt");
+        clock->epoch = 721U;
+        require(!service.claim_next_request_or_throw(
+                     channel, "callback-failure-too-early", 10U,
+                     [&](const anonsync::SyncReplicaOperation&) { return payload; })
+                     .has_value(),
+                "pre-dispatch callback failure ignored retry backoff");
+        clock->epoch = 722U;
+        const auto retry = service.claim_next_request_or_throw(
+            channel, "callback-failure-retry", 10U,
+            [&](const anonsync::SyncReplicaOperation&) { return payload; });
+        require(retry.has_value() &&
+                    retry->request.evidence_request.dispatch_attempts == 2U &&
+                    retry->request.evidence_request.claim_id !=
+                        claimed->outbox.front().lease.claim_id,
+                "pre-dispatch callback retry did not mint fresh authority at deadline");
+    }
