+            "close_posix_fd_or_throw",
+        ),
+        "posix_transition_order_is_open_typecheck_eof_recheck_close",
+        "the exact opened descriptor owns every observation and cleanup transition",
+    )
+    require(
+        "remaining + 1" in source
+        and "maximum_size - bytes.size()" in posix_reader
+        and "bytes.append" in posix_reader
+        and "bytes.resize" not in posix_reader
+        and "while (offset < out.size())" not in source,
+        "reader_proves_eof_with_one_byte_ceiling_sentinel",
+        "initial st_size is a bound check and reserve hint, never a trusted read length",
+    )
+    require(
