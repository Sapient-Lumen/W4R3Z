+                "before.st_size == after.st_size",
+                "bytes.size()",
+                "same_posix_modification_snapshot(before, after)",
+            )
+        )
+        and "st_mtim" in source
+        and "st_ctim" in source,
+        "posix_snapshot_binds_identity_size_and_change_metadata",
