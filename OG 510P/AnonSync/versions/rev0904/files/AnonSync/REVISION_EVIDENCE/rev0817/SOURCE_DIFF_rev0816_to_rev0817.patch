index 0000000..0d61291
--- /dev/null
+++ b/tools/audit_sync_atomic_file_publication.py
@@ -0,0 +1,324 @@
+#!/usr/bin/env python3
+"""Audit the invariant-owned report/heartbeat publication boundary."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+from pathlib import Path
+
+
+def source_list_block(cmake: str, variable: str) -> str:
+    match = re.search(
+        rf"set\({re.escape(variable)}\s+(.*?)\)", cmake, re.DOTALL
+    )
+    return match.group(1) if match else ""
+
+
+def target_block(cmake: str, command: str, target: str) -> str:
+    match = re.search(
+        rf"{re.escape(command)}\({re.escape(target)}\s+(.*?)\)",
+        cmake,
+        re.DOTALL,
+    )
+    return match.group(1) if match else ""
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--root", required=True, type=Path)
+    parser.add_argument("--json", type=Path)
+    args = parser.parse_args()
+    root = args.root.resolve()
+
+    paths = {
+        "header": root / "src/sync_atomic_file_publication.hpp",
+        "source": root / "src/sync_atomic_file_publication.cpp",
+        "test": root / "tests/sync_atomic_file_publication_test.cpp",
+        "audit": root / "tools/audit_sync_atomic_file_publication.py",
+        "cmake": root / "CMakeLists.txt",
+        "domain": root / "src/sync_domain.cpp",
+        "cli": root / "src/sync_operator_cli.cpp",
+        "verifier": root / "tools/verify_release_package.py",
+    }
+    missing = [name for name, path in paths.items() if not path.is_file()]
+    if missing:
+        result = {
+            "audit": "sync_atomic_file_publication",
+            "passed": 0,
+            "total": 1,
+            "checks": [
+                {
+                    "check_id": "required_files_exist",
+                    "passed": False,
+                    "detail": f"missing={missing}",
+                }
+            ],
+        }
+        rendered = json.dumps(result, indent=2, sort_keys=True) + "\n"
+        print(rendered, end="")
+        if args.json:
+            args.json.parent.mkdir(parents=True, exist_ok=True)
+            args.json.write_text(rendered)
+        return 1
+
+    header = paths["header"].read_text()
+    source = paths["source"].read_text()
+    test = paths["test"].read_text()
+    audit_source = paths["audit"].read_text()
+    cmake = paths["cmake"].read_text()
+    domain = paths["domain"].read_text()
+    cli = paths["cli"].read_text()
+    verifier = paths["verifier"].read_text()
+
+    checks: list[dict[str, object]] = []
+
+    def check(check_id: str, passed: bool, detail: str) -> None:
+        checks.append(
+            {"check_id": check_id, "passed": bool(passed), "detail": detail}
+        )
+
+    check(
+        "required_files_exist",
+        not missing,
+        "focused header, implementation, regression test, audit, callers, and verifier are present",
+    )
+
+    declarations = [
+        "write_sync_json_file_atomically_no_symlink_or_throw(",
+        "write_sync_cli_report_json_or_throw(",
+    ]
+    check(
+        "header_owns_the_two_publication_entry_points",
+        all(token in header for token in declarations)
+        and "namespace anonsync" in header,
+        "one focused header declares heartbeat/file and CLI-report publication",
+    )
+
+    core_sources = source_list_block(cmake, "ANONSYNC_CORE_SOURCES")
+    invariant_sources_match = re.search(
+        r"foreach\(ANONSYNC_INVARIANT_OWNED_SOURCE\s+(.*?)\)\s*\n\s*list\(FIND",
+        cmake,
+        re.DOTALL,
+    )
+    invariant_sources = (
+        invariant_sources_match.group(1) if invariant_sources_match else ""
+    )
+    check(
+        "implementation_is_outside_the_core_monolith",
+        "src/sync_atomic_file_publication.cpp" not in core_sources
+        and "${ANONSYNC_SYNC_ATOMIC_FILE_PUBLICATION_SOURCE}"
+        in invariant_sources,
+        "the source-ownership guard prevents accidental reabsorption into anonsync_core_lib",
+    )
+
+    publication_links = target_block(
+        cmake, "target_link_libraries", "anonsync_sync_atomic_file_publication"
+    )
+    core_links = target_block(cmake, "target_link_libraries", "anonsync_core_lib")
+    check(
+        "dependency_direction_is_core_to_focused_owner",
+        "add_library(anonsync_sync_atomic_file_publication STATIC" in cmake
+        and "anonsync_core_lib" not in publication_links
+        and "anonsync_sync_atomic_file_publication" in core_links,
+        "focused owner has no reverse core dependency and core consumes it privately",
+    )
+
+    check(
+        "both_production_callers_use_the_focused_header",
+        '#include "sync_atomic_file_publication.hpp"' in domain
+        and '#include "sync_atomic_file_publication.hpp"' in cli
+        and "void write_sync_cli_report_json_or_throw(" not in cli
+        and "void write_sync_json_file_atomically_no_symlink_or_throw(" not in domain
+        and "void write_sync_cli_report_json_or_throw(" not in domain,
+        "heartbeat and operator CLI call the same separately owned implementation",
+    )
+
+    check(
+        "temp_names_are_unique_per_call_and_not_payload_derived",
+        "std::atomic<std::uint64_t> g_publication_nonce" in source
+        and "fetch_add(1, std::memory_order_relaxed)" in source
+        and "current_process_id()" in source
+        and "fnv1a_64(final_basename)" in source
+        and "sha256" not in source.lower()
+        and '".tmp-" + ' not in source,
+        "temp basename binds destination, process, and monotone call nonce rather than shared payload bytes",
+    )
+
+    check(
+        "parent_directory_identity_is_bound_before_use",
+        "::lstat(native.c_str(), &path_identity)" in source
+        and "S_ISLNK(path_identity.st_mode)" in source
+        and "::open(native.c_str(), flags)" in source
+        and "::fstat(fd, &status)" in source
+        and "same_inode(path_identity, status)" in source
+        and "O_DIRECTORY" in source
+        and "O_NOFOLLOW" in source,
+        "terminal symlink rejection and lstat/fstat identity comparison do not trust open flags alone",
+    )
+
+    check(
+        "temp_creation_is_exclusive_directory_relative_and_private",
+        "::openat(directory_fd, temp_basename.c_str(), flags, 0600)" in source
+        and "O_CREAT | O_EXCL" in source
+        and "O_NOFOLLOW" in source
+        and "error != EEXIST" in source,
+        "each writer reserves its own 0600 entry with openat(O_EXCL) and retries only collisions",
+    )
+
+    check(
+        "final_entry_type_is_interpreted_without_following_links",
+        "::fstatat(directory_fd, final_basename.c_str(), &status" in source
+        and "AT_SYMLINK_NOFOLLOW" in source
+        and "S_ISLNK(status.st_mode)" in source
+        and "S_ISREG(status.st_mode)" in source,
+        "existing symlinks and non-regular final entries are rejected relative to the pinned directory",
+    )
+
+    check(
+        "payload_is_fully_written_and_file_synced_before_publish",
+        "write_fd_all_or_throw(temp.get(), payload" in source
+        and "fsync_fd_or_throw(temp.get(), label + \" temp file\")" in source
+        and "write made no progress" in source
+        and "error == EINTR" in source,
+        "short writes and EINTR are handled and the temp inode is synced before rename",
+    )
+
+    check(
+        "temp_path_ownership_is_inode_bound",
+        "temp_name_still_owns_inode" in source
+        and "same_inode(observed, expected)" in source
+        and "temp pathname no longer names the writer-owned inode" in source,
+        "device/inode equality is re-proven before publication",
+    )
+
+    check(
+        "replacement_is_atomic_and_directory_relative",
+        "::renameat(directory.get(), temp_basename.c_str(), directory.get(),"
+        in source
+        and "final_basename.c_str()" in source,
+        "source and destination names are resolved under the same pinned directory descriptor",
+    )
+
+    check(
+        "directory_entry_is_synced_after_linearization",
+        "published = true;" in source
+        and "parent directory after publication" in source
+        and "directory durability is indeterminate" in source,
+        "rename is the linearization point and post-rename fsync failure is reported as indeterminate durability",
+    )
+
+    cleanup_slice_match = re.search(
+        r"void cleanup_owned_temp_noexcept\((.*?)\n\}", source, re.DOTALL
+    )
+    cleanup_slice = cleanup_slice_match.group(0) if cleanup_slice_match else ""
+    check(
+        "cleanup_never_deletes_a_guessed_or_foreign_temp",
+        "temp_name_still_owns_inode" in cleanup_slice
+        and "::unlinkat" in cleanup_slice
+        and "if (!published && temp_identity_known && directory.valid())"
+        in source
+        and "could not remove stale temp" not in source
+        and "fs::remove(tmp_path" not in source,
+        "failure cleanup is pre-publication only and requires exact inode ownership",
+    )
+
+    required_test_tokens = [
+        "kThreadCount = 10",
+        "kRounds = 10",
+        "same-process same-payload writers succeed",
+        "distinct-payload final bytes equal one complete writer",
+        "same-payload child",
+        "legacy predictable temp is not deleted or overwritten",
+        "existing final symlink is rejected",
+        "existing final directory is rejected",
+        "terminal parent-directory symlink is rejected",
+        "publication_temp_count(root.path()) == 0",
+        "published file grants no group or other access",
+    ]
+    check(
+        "focused_runtime_test_covers_race_and_path_adversaries",
+        all(token in test for token in required_test_tokens),
+        "threads, forked processes, complete-payload linearization, legacy-owner preservation, path types, mode, and residue are covered",
+    )
+
+    focused_loop_match = re.search(
+        r"foreach\(ANONSYNC_FOCUSED_BOUNDARY_TARGET\s+(.*?)\)\s*\n\s*get_target_property",
+        cmake,
+        re.DOTALL,
+    )
+    focused_loop = focused_loop_match.group(1) if focused_loop_match else ""
+    check(
+        "focused_library_and_test_are_guarded_from_core_linkage",
+        "anonsync_sync_atomic_file_publication" in focused_loop
+        and "anonsync_sync_atomic_file_publication_test" in focused_loop,
+        "configure-time no-core dependency guard covers both targets",
+    )
+
+    sanitizer_compile = source_list_block(
+        cmake, "ANONSYNC_SANITIZER_COMPILE_TARGETS"
+    )
+    sanitizer_link_match = re.search(
+        r"foreach\(tgt\s+(.*?)\)\s*\n\s*target_link_options",
+        cmake,
+        re.DOTALL,
+    )
+    sanitizer_link = (
+        sanitizer_link_match.group(1) if sanitizer_link_match else ""
+    )
+    check(
+        "focused_owner_is_in_sanitizer_lanes",
+        "anonsync_sync_atomic_file_publication" in sanitizer_compile
+        and "anonsync_sync_atomic_file_publication_test" in sanitizer_compile
+        and "anonsync_sync_atomic_file_publication_test" in sanitizer_link,
+        "implementation and regression executable receive ASan/UBSan instrumentation and link flags",
+    )
+
+    check(
+        "runtime_and_source_audits_are_release_tests",
+        "add_test(NAME anonsync_sync_atomic_file_publication_test" in cmake
+        and "TIMEOUT 90" in cmake
+        and "add_test(NAME anonsync_sync_atomic_file_publication_source_audit"
+        in cmake
+        and "audit_sync_atomic_file_publication.py" in cmake,
+        "CTest registers both executable proof and structural audit",
+    )
+
+    verifier_required = [
+        "src/sync_atomic_file_publication.hpp",
+        "src/sync_atomic_file_publication.cpp",
+        "tests/sync_atomic_file_publication_test.cpp",
+        "tools/audit_sync_atomic_file_publication.py",
+    ]
+    check(
+        "release_verifier_requires_the_new_proof_surface",
+        all(token in verifier for token in verifier_required),
+        "package verification cannot silently omit the owner, test, or audit",
+    )
+
+    check(
+        "audit_is_not_self_satisfied_by_missing_logic",
+        len(audit_source.splitlines()) > 150
+        and "required_test_tokens" in audit_source
+        and "cleanup_never_deletes_a_guessed_or_foreign_temp" in audit_source,
+        "the audit itself contains substantive architecture and adversarial checks",
+    )
+
+    passed = sum(1 for item in checks if item["passed"])
+    result = {
+        "audit": "sync_atomic_file_publication",
+        "passed": passed,
+        "total": len(checks),
+        "checks": checks,
+    }
+    rendered = json.dumps(result, indent=2, sort_keys=True) + "\n"
+    print(rendered, end="")
+    if args.json:
+        args.json.parent.mkdir(parents=True, exist_ok=True)
+        args.json.write_text(rendered)
+    return 0 if passed == len(checks) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
