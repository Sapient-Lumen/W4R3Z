diff --git a/src/sync_replica_model.cpp b/src/sync_replica_model.cpp
new file mode 100644
index 0000000..368fc11
--- /dev/null
+++ b/src/sync_replica_model.cpp
@@ -0,0 +1,713 @@
+#include "sync_replica_model.hpp"
+
+#include "sha256_digest.hpp"
+#include "sync_conflict_resolution.hpp"
+#include "sync_manifest_validation.hpp"
+
+#include <algorithm>
+#include <array>
+#include <charconv>
+#include <limits>
+#include <map>
+#include <set>
+#include <stdexcept>
+#include <string_view>
+#include <system_error>
+#include <utility>
+
+namespace anonsync {
+namespace {
+
+[[nodiscard]] std::string_view kind_text(
+    SyncReplicaValueKind kind) noexcept {
+    return kind == SyncReplicaValueKind::Tombstone ? "tombstone" : "file";
+}
+
+[[nodiscard]] bool kind_is_valid(SyncReplicaValueKind kind) noexcept {
+    return kind == SyncReplicaValueKind::File ||
+           kind == SyncReplicaValueKind::Tombstone;
+}
+
+[[nodiscard]] SyncConflictValueKind conflict_kind(
+    SyncReplicaValueKind kind) {
+    switch (kind) {
+        case SyncReplicaValueKind::File:
+            return SyncConflictValueKind::File;
+        case SyncReplicaValueKind::Tombstone:
+            return SyncConflictValueKind::Tombstone;
+    }
+    throw std::invalid_argument("sync replica operation has unknown value kind");
+}
+
+void append_framed_component(
+    Sha256DigestBuilder& digest,
+    std::string_view component) {
+    std::array<char, 32> decimal{};
+    const auto converted = std::to_chars(
+        decimal.data(), decimal.data() + decimal.size(), component.size());
+    if (converted.ec != std::errc{}) {
+        throw std::runtime_error(
+            "sync replica identity length formatting failed");
+    }
+    digest.update(std::string_view(
+        decimal.data(),
+        static_cast<std::size_t>(converted.ptr - decimal.data())));
+    digest.update(":");
+    digest.update(component);
+}
+
+[[nodiscard]] std::string decimal_u64(std::uint64_t value) {
+    std::array<char, 32> decimal{};
+    const auto converted = std::to_chars(
+        decimal.data(), decimal.data() + decimal.size(), value);
+    if (converted.ec != std::errc{}) {
+        throw std::runtime_error(
+            "sync replica integer formatting failed");
+    }
+    return std::string(
+        decimal.data(),
+        static_cast<std::size_t>(converted.ptr - decimal.data()));
+}
+
+void append_actor(
+    Sha256DigestBuilder& digest,
+    const SyncReplicaActor& actor) {
+    append_framed_component(digest, "device_id");
+    append_framed_component(digest, actor.device_id);
+    append_framed_component(digest, "epoch");
+    append_framed_component(digest, decimal_u64(actor.epoch));
+}
+
+[[nodiscard]] std::uint64_t context_counter(
+    const std::vector<SyncReplicaClockEntry>& context,
+    const SyncReplicaActor& actor) noexcept {
+    const auto found = std::lower_bound(
+        context.begin(), context.end(), actor,
+        [](const SyncReplicaClockEntry& entry,
+           const SyncReplicaActor& target) {
+            return entry.actor < target;
+        });
+    if (found == context.end() || found->actor != actor) return 0;
+    return found->counter;
+}
+
+[[nodiscard]] bool context_dominates_context(
+    const std::vector<SyncReplicaClockEntry>& candidate,
+    const std::vector<SyncReplicaClockEntry>& required) noexcept {
+    for (const SyncReplicaClockEntry& entry : required) {
+        if (context_counter(candidate, entry.actor) < entry.counter) {
+            return false;
+        }
+    }
+    return true;
+}
+
+void validate_limits_or_throw(const SyncReplicaModelLimits& limits) {
+    if (limits.max_operations == 0U) {
+        throw std::invalid_argument(
+            "sync replica model max_operations must be positive");
+    }
+    if (limits.max_context_entries == 0U) {
+        throw std::invalid_argument(
+            "sync replica model max_context_entries must be positive");
+    }
+}
+
+void validate_actor_or_throw(
+    const SyncReplicaActor& actor,
+    std::string_view label) {
+    if (!sync_id_is_valid(actor.device_id)) {
+        throw std::invalid_argument(
+            std::string(label) +
+            " device_id must be a lowercase portable sync id");
+    }
+    if (actor.epoch == 0U) {
+        throw std::invalid_argument(
+            std::string(label) + " epoch must be positive");
+    }
+}
+
+void validate_operation_semantics_or_throw(
+    const SyncReplicaOperation& operation,
+    const SyncReplicaModelLimits& limits) {
+    validate_limits_or_throw(limits);
+    if (!sync_id_is_valid(operation.folder_id)) {
+        throw std::invalid_argument(
+            "sync replica operation folder_id must be a lowercase portable sync id");
+    }
+    const SyncValidationResult path =
+        validate_sync_relative_path(operation.canonical_path);
+    if (!path.ok) {
+        throw std::invalid_argument(
+            "sync replica operation path is not canonical: " + path.reason);
+    }
+    if (!kind_is_valid(operation.kind)) {
+        throw std::invalid_argument(
+            "sync replica operation has unknown value kind");
+    }
+    validate_actor_or_throw(operation.dot.actor, "sync replica dot");
+    if (operation.dot.counter == 0U) {
+        throw std::invalid_argument(
+            "sync replica dot counter must be positive");
+    }
+    if (operation.dot.counter > limits.max_operations) {
+        throw std::invalid_argument(
+            "sync replica dot counter implies more retained history than the configured model limit");
+    }
+    if (operation.causal_context.size() > limits.max_context_entries) {
+        throw std::invalid_argument(
+            "sync replica causal context exceeds configured entry limit");
+    }
+
+    std::optional<SyncReplicaActor> previous_actor;
+    std::uint64_t implied_past_events = 0;
+    for (const SyncReplicaClockEntry& entry : operation.causal_context) {
+        validate_actor_or_throw(entry.actor, "sync replica causal context");
+        if (entry.counter == 0U) {
+            throw std::invalid_argument(
+                "sync replica causal context omits zero counters instead of encoding them");
+        }
+        if (entry.counter > limits.max_operations ||
+            entry.counter > limits.max_operations - implied_past_events) {
+            throw std::invalid_argument(
+                "sync replica causal context implies more retained history than the configured model limit");
+        }
+        implied_past_events += entry.counter;
+        if (previous_actor.has_value() &&
+            !(previous_actor.value() < entry.actor)) {
+            throw std::invalid_argument(
+                "sync replica causal context must be strictly sorted with unique actors");
+        }
+        previous_actor = entry.actor;
+    }
+    if (implied_past_events >= limits.max_operations) {
+        throw std::invalid_argument(
+            "sync replica operation plus causal past exceeds the configured model limit");
+    }
+
+    const std::uint64_t own_past =
+        context_counter(operation.causal_context, operation.dot.actor);
+    if (own_past == std::numeric_limits<std::uint64_t>::max() ||
+        own_past + 1U != operation.dot.counter) {
+        throw std::invalid_argument(
+            "sync replica dot must be the next event in its single-writer actor epoch");
+    }
+
+    if (operation.kind == SyncReplicaValueKind::File) {
+        if (!is_lowercase_sha256_hex(operation.content_sha256)) {
+            throw std::invalid_argument(
+                "sync replica file operation requires a lowercase SHA-256 content digest");
+        }
+    } else if (operation.size_bytes != 0U ||
+               !operation.content_sha256.empty()) {
+        throw std::invalid_argument(
+            "sync replica tombstone must not carry file size or content digest");
+    }
+}
+
+[[nodiscard]] std::string operation_identity_after_semantic_validation(
+    const SyncReplicaOperation& operation) {
+    Sha256DigestBuilder digest;
+    digest.update("anonsync-sync-replica-operation-v1");
+    append_framed_component(digest, "folder_id");
+    append_framed_component(digest, operation.folder_id);
+    append_framed_component(digest, "canonical_path");
+    append_framed_component(digest, operation.canonical_path);
+    append_framed_component(digest, "kind");
+    append_framed_component(digest, kind_text(operation.kind));
+    append_framed_component(digest, "size_bytes");
+    append_framed_component(digest, decimal_u64(operation.size_bytes));
+    append_framed_component(digest, "content_sha256");
+    append_framed_component(digest, operation.content_sha256);
+    append_framed_component(digest, "dot");
+    append_actor(digest, operation.dot.actor);
+    append_framed_component(digest, "counter");
+    append_framed_component(digest, decimal_u64(operation.dot.counter));
+    append_framed_component(digest, "causal_context_count");
+    append_framed_component(
+        digest, decimal_u64(operation.causal_context.size()));
+    for (const SyncReplicaClockEntry& entry : operation.causal_context) {
+        append_framed_component(digest, "causal_context_actor");
+        append_actor(digest, entry.actor);
+        append_framed_component(digest, "causal_context_counter");
+        append_framed_component(digest, decimal_u64(entry.counter));
+    }
+    return digest.finish_hex();
+}
+
+[[nodiscard]] std::string primary_visible_operation_id_or_throw(
+    const std::vector<const SyncReplicaOperation*>& visible) {
+    if (visible.empty()) {
+        throw std::logic_error(
+            "sync replica visible set unexpectedly has no operations");
+    }
+    const SyncReplicaOperation* winner = visible.front();
+    for (std::size_t index = 1; index < visible.size(); ++index) {
+        const SyncReplicaOperation* candidate = visible[index];
+        const SyncConflictResolution resolution =
+            resolve_sync_conflict_or_throw(
+                conflict_kind(winner->kind), winner->operation_id,
+                conflict_kind(candidate->kind), candidate->operation_id);
+        if (!resolution.local_is_winner()) winner = candidate;
+    }
+    return winner->operation_id;
+}
+
+}  // namespace
+
+std::string make_sync_replica_operation_id_or_throw(
+    const SyncReplicaOperation& operation,
+    const SyncReplicaModelLimits& limits) {
+    validate_operation_semantics_or_throw(operation, limits);
+    return operation_identity_after_semantic_validation(operation);
+}
+
+void validate_sync_replica_operation_or_throw(
+    const SyncReplicaOperation& operation,
+    const SyncReplicaModelLimits& limits) {
+    validate_operation_semantics_or_throw(operation, limits);
+    if (!is_lowercase_sha256_hex(operation.operation_id)) {
+        throw std::invalid_argument(
+            "sync replica operation_id must be a lowercase SHA-256 digest");
+    }
+    if (operation_identity_after_semantic_validation(operation) !=
+        operation.operation_id) {
+        throw std::invalid_argument(
+            "sync replica operation_id does not bind the exact semantic operation");
+    }
+}
+
+bool sync_replica_context_covers_dot(
+    const std::vector<SyncReplicaClockEntry>& context,
+    const SyncReplicaDot& dot) noexcept {
+    return context_counter(context, dot.actor) >= dot.counter;
+}
+
+bool sync_replica_operation_supersedes(
+    const SyncReplicaOperation& newer,
+    const SyncReplicaOperation& older) noexcept {
+    return newer.operation_id != older.operation_id &&
+           newer.folder_id == older.folder_id &&
+           newer.canonical_path == older.canonical_path &&
+           sync_replica_context_covers_dot(
+               newer.causal_context, older.dot);
+}
+
+SyncReplicaModel::SyncReplicaModel(
+    std::string folder_id,
+    SyncReplicaActor local_actor,
+    SyncReplicaModelLimits limits)
+    : folder_id_(std::move(folder_id)),
+      local_actor_(std::move(local_actor)),
+      limits_(limits) {
+    validate_limits_or_throw(limits_);
+    if (!sync_id_is_valid(folder_id_)) {
+        throw std::invalid_argument(
+            "sync replica model folder_id must be a lowercase portable sync id");
+    }
+    validate_actor_or_throw(local_actor_, "sync replica local actor");
+}
+
+SyncReplicaModel SyncReplicaModel::restore_or_throw(
+    const SyncReplicaDurableState& durable,
+    SyncReplicaModelLimits limits) {
+    SyncReplicaModel restored(durable.folder_id, durable.local_actor, limits);
+    if (durable.operations.size() > limits.max_operations) {
+        throw std::invalid_argument(
+            "sync replica durable operation set exceeds configured limit");
+    }
+
+    std::optional<std::string> previous_operation_id;
+    for (const SyncReplicaOperation& operation : durable.operations) {
+        validate_sync_replica_operation_or_throw(operation, limits);
+        if (operation.folder_id != durable.folder_id) {
+            throw std::invalid_argument(
+                "sync replica durable operation belongs to a different folder");
+        }
+        if (previous_operation_id.has_value() &&
+            previous_operation_id.value() >= operation.operation_id) {
+            throw std::invalid_argument(
+                "sync replica durable operations must be strictly sorted and unique by operation_id");
+        }
+        previous_operation_id = operation.operation_id;
+        if (restored.insert_validated_or_throw(operation, true) !=
+            SyncReplicaAdmission::Inserted) {
+            throw std::invalid_argument(
+                "sync replica durable history contains a duplicate operation");
+        }
+    }
+
+    std::set<std::uint64_t> local_counters;
+    for (const auto& [operation_id, operation] :
+         restored.operations_by_id_) {
+        (void)operation_id;
+        if (operation.dot.actor == durable.local_actor) {
+            local_counters.insert(operation.dot.counter);
+        }
+        if (context_counter(
+                operation.causal_context, durable.local_actor) >
+            durable.last_local_counter) {
+            throw std::invalid_argument(
+                "sync replica durable history references an unowned future local event");
+        }
+    }
+    if (local_counters.size() != durable.last_local_counter) {
+        throw std::invalid_argument(
+            "sync replica durable history does not contain every minted local event");
+    }
+    std::uint64_t expected = 1;
+    for (const std::uint64_t counter : local_counters) {
+        if (counter != expected) {
+            throw std::invalid_argument(
+                "sync replica durable local event sequence contains a gap");
+        }
+        ++expected;
+    }
+    restored.last_local_counter_ = durable.last_local_counter;
+    return restored;
+}
+
+SyncReplicaOperation SyncReplicaModel::create_local_file_or_throw(
+    std::string canonical_path,
+    std::uint64_t size_bytes,
+    std::string content_sha256) {
+    return create_local_operation_or_throw(
+        std::move(canonical_path),
+        SyncReplicaValueKind::File,
+        size_bytes,
+        std::move(content_sha256));
+}
+
+SyncReplicaOperation SyncReplicaModel::create_local_tombstone_or_throw(
+    std::string canonical_path) {
+    return create_local_operation_or_throw(
+        std::move(canonical_path),
+        SyncReplicaValueKind::Tombstone,
+        0,
+        {});
+}
+
+SyncReplicaOperation SyncReplicaModel::create_local_operation_or_throw(
+    std::string canonical_path,
+    SyncReplicaValueKind kind,
+    std::uint64_t size_bytes,
+    std::string content_sha256) {
+    if (last_local_counter_ == std::numeric_limits<std::uint64_t>::max()) {
+        throw std::overflow_error(
+            "sync replica local dot counter is exhausted; rotate actor epoch");
+    }
+
+    SyncReplicaOperation operation;
+    operation.folder_id = folder_id_;
+    operation.canonical_path = std::move(canonical_path);
+    operation.kind = kind;
+    operation.size_bytes = size_bytes;
+    operation.content_sha256 = std::move(content_sha256);
+    operation.dot = {local_actor_, last_local_counter_ + 1U};
+    operation.causal_context = observed_context();
+
+    const std::uint64_t own_frontier =
+        context_counter(operation.causal_context, local_actor_);
+    if (own_frontier != last_local_counter_) {
+        throw std::logic_error(
+            "sync replica observed context disagrees with local counter authority");
+    }
+    operation.operation_id =
+        make_sync_replica_operation_id_or_throw(operation, limits_);
+    const SyncReplicaAdmission admitted =
+        insert_validated_or_throw(operation, true);
+    if (admitted != SyncReplicaAdmission::Inserted) {
+        throw std::logic_error(
+            "sync replica minted operation unexpectedly matched an existing operation");
+    }
+    last_local_counter_ = operation.dot.counter;
+    return operation;
+}
+
+SyncReplicaAdmission SyncReplicaModel::accept_remote_or_throw(
+    const SyncReplicaOperation& operation) {
+    validate_sync_replica_operation_or_throw(operation, limits_);
+    if (operation.folder_id != folder_id_) {
+        throw std::invalid_argument(
+            "sync replica rejected operation from a different folder");
+    }
+
+    const auto duplicate = operations_by_id_.find(operation.operation_id);
+    if (duplicate != operations_by_id_.end()) {
+        if (duplicate->second != operation) {
+            throw std::runtime_error(
+                "sync replica operation digest collision changed semantic bytes");
+        }
+        return SyncReplicaAdmission::Duplicate;
+    }
+
+    if (operation.dot.actor == local_actor_) {
+        throw std::invalid_argument(
+            "sync replica rejected foreign minting in its local actor epoch");
+    }
+    if (context_counter(operation.causal_context, local_actor_) >
+        last_local_counter_) {
+        throw std::invalid_argument(
+            "sync replica rejected a remote operation that depends on an unowned future local event");
+    }
+    return insert_validated_or_throw(operation, false);
+}
+
+SyncReplicaAdmission SyncReplicaModel::insert_validated_or_throw(
+    const SyncReplicaOperation& operation,
+    bool allow_local_actor) {
+    const auto duplicate = operations_by_id_.find(operation.operation_id);
+    if (duplicate != operations_by_id_.end()) {
+        if (duplicate->second != operation) {
+            throw std::runtime_error(
+                "sync replica operation digest collision changed semantic bytes");
+        }
+        return SyncReplicaAdmission::Duplicate;
+    }
+    if (!allow_local_actor && operation.dot.actor == local_actor_) {
+        throw std::invalid_argument(
+            "sync replica rejected foreign minting in its local actor epoch");
+    }
+    if (operations_by_id_.size() >= limits_.max_operations) {
+        throw std::length_error(
+            "sync replica operation set reached configured reference-model limit");
+    }
+    const auto dot = operation_id_by_dot_.find(operation.dot);
+    if (dot != operation_id_by_dot_.end()) {
+        throw std::invalid_argument(
+            "sync replica detected one actor dot bound to different operation bytes");
+    }
+
+    validate_pairwise_causality_or_throw(operation);
+
+    const auto inserted_operation =
+        operations_by_id_.emplace(operation.operation_id, operation);
+    if (!inserted_operation.second) {
+        throw std::logic_error(
+            "sync replica operation insertion lost uniqueness after preflight");
+    }
+    try {
+        const auto inserted_dot = operation_id_by_dot_.emplace(
+            operation.dot, operation.operation_id);
+        if (!inserted_dot.second) {
+            operations_by_id_.erase(inserted_operation.first);
+            throw std::logic_error(
+                "sync replica dot insertion lost uniqueness after preflight");
+        }
+    } catch (...) {
+        operations_by_id_.erase(operation.operation_id);
+        throw;
+    }
+    return SyncReplicaAdmission::Inserted;
+}
+
+void SyncReplicaModel::validate_pairwise_causality_or_throw(
+    const SyncReplicaOperation& incoming) const {
+    for (const auto& [operation_id, existing] : operations_by_id_) {
+        (void)operation_id;
+        const bool incoming_after_existing =
+            sync_replica_context_covers_dot(
+                incoming.causal_context, existing.dot);
+        const bool existing_after_incoming =
+            sync_replica_context_covers_dot(
+                existing.causal_context, incoming.dot);
+        if (incoming_after_existing && existing_after_incoming) {
+            throw std::invalid_argument(
+                "sync replica causal history contains a dependency cycle");
+        }
+        if (incoming_after_existing &&
+            !context_dominates_context(
+                incoming.causal_context, existing.causal_context)) {
+            throw std::invalid_argument(
+                "sync replica causal context is not transitively closed over an observed predecessor");
+        }
+        if (existing_after_incoming &&
+            !context_dominates_context(
+                existing.causal_context, incoming.causal_context)) {
+            throw std::invalid_argument(
+                "sync replica existing context is not transitively closed over the incoming predecessor");
+        }
+    }
+}
+
+std::optional<SyncReplicaOperation> SyncReplicaModel::operation_by_id(
+    const std::string& operation_id) const {
+    const auto found = operations_by_id_.find(operation_id);
+    if (found == operations_by_id_.end()) return std::nullopt;
+    return found->second;
+}
+
+std::vector<SyncReplicaOperation> SyncReplicaModel::all_operations() const {
+    std::vector<SyncReplicaOperation> operations;
+    operations.reserve(operations_by_id_.size());
+    for (const auto& [operation_id, operation] : operations_by_id_) {
+        (void)operation_id;
+        operations.push_back(operation);
+    }
+    return operations;
+}
+
+std::vector<SyncReplicaClockEntry> SyncReplicaModel::observed_context() const {
+    std::map<SyncReplicaActor, std::uint64_t> frontier;
+    for (const auto& [operation_id, operation] : operations_by_id_) {
+        (void)operation_id;
+        auto& dot_counter = frontier[operation.dot.actor];
+        dot_counter = std::max(dot_counter, operation.dot.counter);
+        for (const SyncReplicaClockEntry& entry : operation.causal_context) {
+            auto& counter = frontier[entry.actor];
+            counter = std::max(counter, entry.counter);
+        }
+    }
+
+    std::vector<SyncReplicaClockEntry> context;
+    context.reserve(frontier.size());
+    for (const auto& [actor, counter] : frontier) {
+        if (counter != 0U) context.push_back({actor, counter});
+    }
+    if (context.size() > limits_.max_context_entries) {
+        throw std::length_error(
+            "sync replica observed causal frontier exceeds configured context limit");
+    }
+    return context;
+}
+
+std::optional<SyncReplicaPathView> SyncReplicaModel::visible_path(
+    const std::string& canonical_path) const {
+    const SyncValidationResult path =
+        validate_sync_relative_path(canonical_path);
+    if (!path.ok) {
+        throw std::invalid_argument(
+            "sync replica visible path lookup is not canonical: " + path.reason);
+    }
+
+    std::vector<const SyncReplicaOperation*> candidates;
+    for (const auto& [operation_id, operation] : operations_by_id_) {
+        (void)operation_id;
+        if (operation.canonical_path == canonical_path) {
+            candidates.push_back(&operation);
+        }
+    }
+    if (candidates.empty()) return std::nullopt;
+
+    std::vector<const SyncReplicaOperation*> visible;
+    for (const SyncReplicaOperation* candidate : candidates) {
+        bool superseded = false;
+        for (const SyncReplicaOperation* other : candidates) {
+            if (sync_replica_operation_supersedes(*other, *candidate)) {
+                superseded = true;
+                break;
+            }
+        }
+        if (!superseded) visible.push_back(candidate);
+    }
+    if (visible.empty()) {
+        throw std::logic_error(
+            "sync replica causal validation admitted a path with no maximal operation");
+    }
+    std::sort(
+        visible.begin(), visible.end(),
+        [](const SyncReplicaOperation* left,
+           const SyncReplicaOperation* right) {
+            return left->operation_id < right->operation_id;
+        });
+
+    SyncReplicaPathView view;
+    view.canonical_path = canonical_path;
+    for (const SyncReplicaOperation* operation : visible) {
+        view.visible_operation_ids.push_back(operation->operation_id);
+    }
+    view.primary_operation_id =
+        primary_visible_operation_id_or_throw(visible);
+    const SyncReplicaOperation& primary =
+        operations_by_id_.at(view.primary_operation_id);
+    view.primary_kind = primary.kind;
+    for (const SyncReplicaOperation* operation : visible) {
+        if (operation->kind == SyncReplicaValueKind::File &&
+            operation->operation_id != view.primary_operation_id) {
+            view.preserved_file_operation_ids.push_back(
+                operation->operation_id);
+        }
+    }
+    return view;
+}
+
+std::vector<SyncReplicaPathView> SyncReplicaModel::visible_paths() const {
+    std::set<std::string> paths;
+    for (const auto& [operation_id, operation] : operations_by_id_) {
+        (void)operation_id;
+        paths.insert(operation.canonical_path);
+    }
+    std::vector<SyncReplicaPathView> views;
+    views.reserve(paths.size());
+    for (const std::string& path : paths) {
+        const auto view = visible_path(path);
+        if (!view.has_value()) {
+            throw std::logic_error(
+                "sync replica indexed path disappeared during stable projection");
+        }
+        views.push_back(view.value());
+    }
+    return views;
+}
+
+std::string SyncReplicaModel::operation_set_digest() const {
+    Sha256DigestBuilder digest;
+    digest.update("anonsync-sync-replica-operation-set-v1");
+    append_framed_component(digest, "folder_id");
+    append_framed_component(digest, folder_id_);
+    append_framed_component(digest, "operation_count");
+    append_framed_component(digest, decimal_u64(operations_by_id_.size()));
+    for (const auto& [operation_id, operation] : operations_by_id_) {
+        (void)operation;
+        append_framed_component(digest, "operation_id");
+        append_framed_component(digest, operation_id);
+    }
+    return digest.finish_hex();
+}
+
+std::string SyncReplicaModel::visible_state_digest() const {
+    const std::vector<SyncReplicaPathView> views = visible_paths();
+    Sha256DigestBuilder digest;
+    digest.update("anonsync-sync-replica-visible-state-v1");
+    append_framed_component(digest, "folder_id");
+    append_framed_component(digest, folder_id_);
+    append_framed_component(digest, "path_count");
+    append_framed_component(digest, decimal_u64(views.size()));
+    for (const SyncReplicaPathView& view : views) {
+        append_framed_component(digest, "canonical_path");
+        append_framed_component(digest, view.canonical_path);
+        append_framed_component(digest, "primary_operation_id");
+        append_framed_component(digest, view.primary_operation_id);
+        append_framed_component(digest, "primary_kind");
+        append_framed_component(digest, kind_text(view.primary_kind));
+        append_framed_component(digest, "visible_count");
+        append_framed_component(
+            digest, decimal_u64(view.visible_operation_ids.size()));
+        for (const std::string& operation_id :
+             view.visible_operation_ids) {
+            append_framed_component(digest, "visible_operation_id");
+            append_framed_component(digest, operation_id);
+        }
+        append_framed_component(digest, "preserved_file_count");
+        append_framed_component(
+            digest,
+            decimal_u64(view.preserved_file_operation_ids.size()));
+        for (const std::string& operation_id :
+             view.preserved_file_operation_ids) {
+            append_framed_component(digest, "preserved_file_operation_id");
+            append_framed_component(digest, operation_id);
+        }
+    }
+    return digest.finish_hex();
+}
+
+SyncReplicaDurableState SyncReplicaModel::durable_state() const {
+    SyncReplicaDurableState durable;
+    durable.folder_id = folder_id_;
+    durable.local_actor = local_actor_;
+    durable.last_local_counter = last_local_counter_;
+    durable.operations = all_operations();
+    return durable;
+}
+
+}  // namespace anonsync
