+                alpha.device_id, path, 3, payload_digest("two"));
+        const std::uint64_t second_message =
+            message_for_operation_to_or_throw(
+                reordered, second.operation_id, bravo.device_id);
+        const std::uint64_t first_message =
+            message_for_operation_to_or_throw(
+                reordered, first.operation_id, bravo.device_id);
+        require(reordered.deliver_message_or_throw(second_message) ==
+                    std::optional<SyncReplicaAdmission>(
+                        SyncReplicaAdmission::Inserted),
+                "successor must be admissible before its material predecessor arrives",
+                checks);
+        const auto successor_only =
+            reordered.replica_or_throw(bravo.device_id).visible_path(path);
+        require(successor_only.has_value() &&
+                    successor_only->primary_operation_id == second.operation_id,
+                "successor context must make the newest value visible immediately",
+                checks);
+        (void)reordered.deliver_message_or_throw(first_message);
+        const auto predecessor_late =
+            reordered.replica_or_throw(bravo.device_id).visible_path(path);
+        require(predecessor_late.has_value() &&
+                    predecessor_late->visible_operation_ids ==
+                        std::vector<std::string>{second.operation_id},
+                "late predecessor delivery must never resurrect an obsolete value",
+                checks);
+
+        // Crash/restart reconstructs the exact accepted operation set and local
+        // counter authority before minting the next dot.
+        const std::string before_crash =
+            reordered.replica_or_throw(alpha.device_id).operation_set_digest();
+        const SyncReplicaDurableState durable_before =
+            reordered.durable_state_or_throw(alpha.device_id);
+        reordered.crash_or_throw(alpha.device_id);
+        require(!reordered.replica_is_live(alpha.device_id),
+                "crash must destroy the live model instance", checks);
+        reordered.restart_or_throw(alpha.device_id);
+        require(reordered.replica_or_throw(alpha.device_id)
+                        .operation_set_digest() == before_crash &&
+                    reordered.durable_state_or_throw(alpha.device_id) ==
+                        durable_before,
+                "restart must restore exact durable history and counter authority",
+                checks);
+        const SyncReplicaOperation after_restart =
+            reordered.create_local_tombstone_or_throw(
+                alpha.device_id, "docs/after-restart.txt");
+        require(after_restart.dot.counter ==
+                    durable_before.last_local_counter + 1U,
+                "post-restart minting must continue rather than reuse a dot",
+                checks);
+
+        SyncReplicaDurableState missing_local_history = durable_before;
+        missing_local_history.operations.erase(
+            std::remove_if(
+                missing_local_history.operations.begin(),
+                missing_local_history.operations.end(),
+                [&](const SyncReplicaOperation& operation) {
+                    return operation.dot.actor == alpha &&
+                           operation.dot.counter == 1U;
+                }),
+            missing_local_history.operations.end());
+        require_throws(
+            [&] {
+                (void)SyncReplicaModel::restore_or_throw(
+                    missing_local_history);
+            },
+            "restore must reject durable state that could reuse a missing local dot",
+            checks);
+
+        SyncReplicaDurableState unsorted_history = durable_before;
+        require(unsorted_history.operations.size() >= 2U,
+                "restore ordering fixture requires at least two durable operations",
+                checks);
+        std::swap(
+            unsorted_history.operations[0],
+            unsorted_history.operations[1]);
+        require_throws(
+            [&] {
+                (void)SyncReplicaModel::restore_or_throw(unsorted_history);
+            },
+            "restore must reject an unordered durable operation stream",
+            checks);
+
+        SyncReplicaDurableState duplicate_history = durable_before;
+        duplicate_history.operations.push_back(
+            duplicate_history.operations.front());
+        std::sort(
+            duplicate_history.operations.begin(),
+            duplicate_history.operations.end(),
+            [](const SyncReplicaOperation& left,
+               const SyncReplicaOperation& right) {
+                return left.operation_id < right.operation_id;
+            });
+        require_throws(
+            [&] {
+                (void)SyncReplicaModel::restore_or_throw(duplicate_history);
+            },
+            "restore must reject duplicate durable operation identities",
+            checks);
+
+        SyncReplicaOperation noncanonical_path = alpha_first;
+        noncanonical_path.canonical_path = "../escape";
+        require_throws(
+            [&] {
+                (void)make_sync_replica_operation_id_or_throw(
+                    noncanonical_path);
+            },
+            "operation identity minting must reject a noncanonical path",
+            checks);
+
+        const SyncReplicaOperation oversized_context =
+            detached_file_operation(
+                folder, "docs/limit.txt", charlie, 1,
+                {{alpha, 2}, {bravo, 1}}, "bounded");
+        SyncReplicaModelLimits tiny_history;
+        tiny_history.max_operations = 3U;
+        tiny_history.max_context_entries = 2U;
+        require_throws(
+            [&] {
+                validate_sync_replica_operation_or_throw(
+                    oversized_context, tiny_history);
+            },
+            "an operation plus its implied causal prefix must fit the retained-history limit",
+            checks);
+
+        const SyncReplicaOperation future_local_dependency =
+            detached_file_operation(
+                folder, "docs/future-local.txt", bravo, 1,
+                {{alpha, alpha_model.last_local_counter() + 1U}},
+                "impossible-future");
+        const std::string alpha_before_future_dependency =
+            alpha_model.operation_set_digest();
+        require_throws(
+            [&] {
+                (void)alpha_model.accept_remote_or_throw(
+                    future_local_dependency);
+            },
+            "a remote operation cannot depend on an event this local actor has never minted",
+            checks);
+        require(alpha_model.operation_set_digest() ==
+                    alpha_before_future_dependency,
+                "future-local dependency rejection must be failure-atomic",
+                checks);
+
+        // Malicious causal cycles and non-transitive contexts are individually
+        // well-shaped but impossible as observed histories. Pairwise admission
+        // must expose them without changing the accepted operation set.
+        const SyncReplicaOperation cycle_alpha = detached_file_operation(
+            folder, path, alpha, 1, {{bravo, 1}}, "cycle-a");
+        const SyncReplicaOperation cycle_bravo = detached_file_operation(
+            folder, path, bravo, 1, {{alpha, 1}}, "cycle-b");
+        SyncReplicaModel cycle_guard(folder, charlie);
+        (void)cycle_guard.accept_remote_or_throw(cycle_alpha);
+        const std::string cycle_before = cycle_guard.operation_set_digest();
+        require_throws(
+            [&] {
+                (void)cycle_guard.accept_remote_or_throw(cycle_bravo);
+            },
+            "mutual future dependencies must be rejected as a causal cycle",
+            checks);
+        require(cycle_guard.operation_set_digest() == cycle_before,
+                "causal cycle rejection must be failure-atomic", checks);
+
+        const SyncReplicaOperation transitive_alpha =
+            detached_file_operation(
+                folder, "docs/transitive.txt", alpha, 1, {}, "a");
+        const SyncReplicaOperation transitive_bravo =
+            detached_file_operation(
+                folder, "docs/transitive.txt", bravo, 1,
+                {{alpha, 1}}, "b");
+        const SyncReplicaOperation broken_charlie =
+            detached_file_operation(
+                folder, "docs/transitive.txt", charlie, 1,
+                {{bravo, 1}}, "c");
+        SyncReplicaModel transitive_guard(
+            folder, actor("device-delta", 41));
+        (void)transitive_guard.accept_remote_or_throw(transitive_alpha);
+        (void)transitive_guard.accept_remote_or_throw(transitive_bravo);
+        require_throws(
+            [&] {
+                (void)transitive_guard.accept_remote_or_throw(broken_charlie);
+            },
+            "a context that names a successor but omits its known causal past must fail",
+            checks);
+
+        // Deterministic generated-history simulation combines partitions,
+        // message loss, duplicates, reorder, and crash/restart. Eventual full
+        // anti-entropy must converge every live node on every generated dot.
+        const std::vector<std::string> devices = {
+            "device-a", "device-b", "device-c", "device-d"};
+        const std::vector<std::string> paths = {
+            "docs/a.txt", "docs/b.txt", "docs/c.txt",
+            "images/d.bin", "notes/e.md"};
+        SyncReplicaModelLimits stress_limits;
+        stress_limits.max_operations = 1000;
+        stress_limits.max_context_entries = 32;
+        SyncReplicaNetworkSimulator stress(
+            "folder-stress", stress_limits);
+        for (std::size_t index = 0; index < devices.size(); ++index) {
+            stress.add_replica_or_throw(
+                actor(devices[index], 100U + index));
+        }
+
+        XorShift64 random;
+        std::set<std::string> generated_operation_ids;
+        for (std::size_t step = 0; step < 720U; ++step) {
+            const std::size_t action = random.index(9U);
+            const std::size_t selected_index =
+                random.index(devices.size());
+            const std::string& selected = devices[selected_index];
+            const std::size_t other_offset =
+                1U + random.index(devices.size() - 1U);
+            const std::string& other =
+                devices[(selected_index + other_offset) % devices.size()];
+
+            if (action <= 2U) {
+                if (!stress.replica_is_live(selected)) continue;
+                const std::string& selected_path =
+                    paths[random.index(paths.size())];
+                SyncReplicaOperation operation;
+                if (action == 2U) {
+                    operation = stress.create_local_tombstone_or_throw(
+                        selected, selected_path);
+                } else {
+                    const std::string material =
+                        selected + ":" + std::to_string(step) + ":" +
+                        std::to_string(random.next());
+                    operation = stress.create_local_file_or_throw(
+                        selected, selected_path, material.size(),
+                        payload_digest(material));
+                }
+                generated_operation_ids.insert(operation.operation_id);
+            } else if (action == 3U) {
+                if (selected != other) {
+                    stress.partition_direction_or_throw(selected, other);
+                }
+            } else if (action == 4U) {
+                if (selected != other) {
+                    stress.heal_direction_or_throw(selected, other);
+                }
+            } else if (action == 5U) {
+                const std::vector<std::uint64_t> pending =
+                    stress.pending_message_ids();
+                if (!pending.empty()) {
+                    const std::uint64_t message_id =
+                        pending[random.index(pending.size())];
+                    if ((random.next() & 1U) == 0U) {
+                        (void)stress.duplicate_message_or_throw(message_id);
+                    } else {
+                        (void)stress.drop_message(message_id);
+                    }
+                }
+            } else if (action == 6U) {
+                const std::vector<std::uint64_t> pending =
+                    stress.pending_message_ids();
+                if (!pending.empty()) {
+                    const std::uint64_t message_id =
+                        pending[random.index(pending.size())];
+                    (void)stress.deliver_message_or_throw(message_id);
+                }
+            } else if (action == 7U) {
+                if (stress.replica_is_live(selected)) {
+                    stress.crash_or_throw(selected);
+                } else {
+                    stress.restart_or_throw(selected);
+                }
+            } else {
+                (void)stress.drain_deliverable_or_throw(
+                    (random.next() & 1U) == 0U
+                        ? SyncReplicaDeliveryOrder::OldestFirst
+                        : SyncReplicaDeliveryOrder::NewestFirst,
+                    3U);
+            }
+        }
+
+        for (const std::string& device : devices) {
+            if (!stress.replica_is_live(device)) {
+                stress.restart_or_throw(device);
+            }
+        }
+        stress.heal_all();
+        (void)stress.enqueue_full_mesh_anti_entropy_or_throw();
+        (void)stress.drain_deliverable_or_throw(
+            SyncReplicaDeliveryOrder::NewestFirst);
+        // A second round proves idempotent anti-entropy from already converged
+        // peers and closes any future refactor that accidentally requires
+        // forwarding on first receipt.
+        (void)stress.enqueue_full_mesh_anti_entropy_or_throw();
+        (void)stress.drain_deliverable_or_throw(
+            SyncReplicaDeliveryOrder::OldestFirst);
+        require(stress.all_replicas_live() &&
+                    stress.pending_message_count() == 0U,
+                "stress convergence must finish with every replica live and queue drained",
+                checks);
+        require(stress.all_operation_sets_equal_or_throw() &&
+                    stress.all_visible_states_equal_or_throw(),
+                "faulted generated history must converge after eventual full delivery",
+                checks);
+        require(generated_operation_ids.size() >= 80U,
+                "stress history must retain enough generated operations to exercise nontrivial anti-entropy",
+                checks);
+        for (const std::string& device : devices) {
+            require(stress.replica_or_throw(device).operation_count() ==
+                        generated_operation_ids.size(),
+                    "every stress replica must retain every unique generated operation",
+                    checks);
+        }
+
+        std::cout << "sync replica network model tests passed (" << checks
+                  << " checks, " << generated_operation_ids.size()
+                  << " generated operations)\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << "sync replica network model tests failed: "
+                  << error.what() << '\n';
+        return 1;
+    }
+}
