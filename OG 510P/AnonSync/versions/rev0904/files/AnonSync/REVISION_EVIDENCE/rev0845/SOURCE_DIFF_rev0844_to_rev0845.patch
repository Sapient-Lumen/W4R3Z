+// Local JSONL now requires an owner-controlled parent directory instead of
+// silently treating a shared temporary directory as writer-exclusive. Keep
+// every selftest ledger family inside one private RAII workspace so production
+// policy is exercised rather than weakened for fixtures.
+class SelftestPrivateDirectory final {
+public:
+    explicit SelftestPrivateDirectory(const std::string& stem) {
+        const std::filesystem::path pattern_path =
+            std::filesystem::temp_directory_path() / (stem + "-XXXXXX");
+        std::string pattern = pattern_path.string();
+        std::vector<char> mutable_pattern(pattern.begin(), pattern.end());
+        mutable_pattern.push_back('\0');
+        char* const created = ::mkdtemp(mutable_pattern.data());
+        if (created == nullptr) {
+            throw std::runtime_error(
+                "selftest private directory creation failed for " + pattern);
+        }
+        path_ = std::filesystem::path(created).lexically_normal();
+    }
+
+    ~SelftestPrivateDirectory() {
+        std::error_code ignored;
+        std::filesystem::permissions(
+            path_, std::filesystem::perms::owner_all,
+            std::filesystem::perm_options::add, ignored);
+        std::filesystem::remove_all(path_, ignored);
+    }
+
+    SelftestPrivateDirectory(const SelftestPrivateDirectory&) = delete;
+    SelftestPrivateDirectory& operator=(const SelftestPrivateDirectory&) =
+        delete;
+
+    [[nodiscard]] std::string file(const std::string& basename) const {
+        return (path_ / basename).generic_string();
+    }
+
+private:
+    std::filesystem::path path_;
+};
