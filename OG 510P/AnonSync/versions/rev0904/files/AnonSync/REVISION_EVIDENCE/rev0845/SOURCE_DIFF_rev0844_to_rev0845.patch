+namespace anonsync::persistence {
+
+// Frozen kernel-visible evidence for the directory in which one local JSONL
+// replay-ledger family may be mutated. This is intentionally narrower than a
+// claim of process-exclusive write access: another process with the same
+// effective UID, or a privileged process that can bypass discretionary access
+// control, an actor able to rename a mutable ancestor path component, or a
+// mechanism outside the reported POSIX mode bits remains outside the proved
+// boundary.
+struct LocalJsonlReplayDirectoryAttestation final {
+    std::uint64_t device = 0;
+    std::uint64_t inode = 0;
+    std::uint64_t owner_user_id = 0;
+    std::uint64_t owner_group_id = 0;
+    std::uint64_t effective_user_id = 0;
+    std::uint64_t effective_group_id = 0;
+    std::uint32_t permission_mode = 0;
+    std::uint64_t filesystem_id = 0;
+    std::uint64_t mount_flags = 0;
+    std::uint64_t filesystem_name_maximum = 0;
+    long path_name_maximum = -1;
+};
+
+// Move-only, process-incarnation-bound authority over one retained directory.
+// Opening rejects symlink traversal, freezes exact identity/ownership/mode and
+// POSIX mount observations, and requires an owner-controlled mutation surface:
+// the effective UID owns the directory, owner read/write/search are present,
+// and no group/other write bit is set. Every later proof rechecks both the
+// retained descriptor and the absolute path against the frozen attestation.
+// Any failed reproof permanently revokes that object; restoring visible mode
+// or ownership later cannot resurrect authority after an unobserved interval.
+class LocalJsonlReplayDirectoryAuthority final {
+public:
+    LocalJsonlReplayDirectoryAuthority() = default;
+    ~LocalJsonlReplayDirectoryAuthority();
+    LocalJsonlReplayDirectoryAuthority(
+        const LocalJsonlReplayDirectoryAuthority&) = delete;
+    LocalJsonlReplayDirectoryAuthority& operator=(
+        const LocalJsonlReplayDirectoryAuthority&) = delete;
+    LocalJsonlReplayDirectoryAuthority(
+        LocalJsonlReplayDirectoryAuthority&& other) noexcept;
+    LocalJsonlReplayDirectoryAuthority& operator=(
+        LocalJsonlReplayDirectoryAuthority&& other) noexcept;
+
+    [[nodiscard]] static LocalJsonlReplayDirectoryAuthority open_or_throw(
+        const std::filesystem::path& absolute_directory,
+        const std::string& label =
+            "durable replay ledger parent directory");
+
+    [[nodiscard]] const std::filesystem::path& path() const noexcept;
+    [[nodiscard]] const std::string& absolute_path() const noexcept;
+    [[nodiscard]] const LocalJsonlReplayDirectoryAttestation& attestation()
+        const noexcept;
+
+    void verify_or_throw(
+        std::string_view label =
+            "durable replay ledger parent directory") const;
+
+private:
+    friend class LocalJsonlReplayNamespace;
+
+    void require_current_process_noexcept() const noexcept;
+    void require_current_process_or_throw(std::string_view label) const;
+    void transfer_from_noexcept(
+        LocalJsonlReplayDirectoryAuthority& other) noexcept;
+    void clear_moved_from_noexcept() noexcept;
+
+    [[nodiscard]] int descriptor_no_verify() const noexcept;
+    [[nodiscard]] long name_maximum_no_verify() const noexcept;
+
+    SyncProcessIncarnation process_id_;
+    std::filesystem::path path_;
+    std::string path_text_;
+    int descriptor_ = -1;
+    LocalJsonlReplayDirectoryAttestation attestation_;
+    mutable bool revoked_ = false;
+};
+
+}  // namespace anonsync::persistence
+
+#endif
