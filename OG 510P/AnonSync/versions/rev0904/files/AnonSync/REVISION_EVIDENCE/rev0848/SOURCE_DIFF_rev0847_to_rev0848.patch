index 0000000000000000000000000000000000000000..af75f2b4c772ad43367f6bf8c3a8702130984cb9
--- /dev/null
+++ b/src/persistence/sqlite_busy_handler_owner.cpp
@@ -0,0 +1,398 @@
+#include "sqlite_busy_handler_owner.hpp"
+
+#include <sqlite3.h>
+
+#include <algorithm>
+#include <limits>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <utility>
+
+namespace anonsync::persistence {
+namespace {
+
+static_assert(SQLITE_VERSION_NUMBER >= 3044000,
+              "SQLite connection client data requires SQLite 3.44.0+");
+static_assert(std::atomic<std::uint64_t>::is_always_lock_free,
+              "busy-handler diagnostics must remain lock-free after fork");
+static_assert(std::atomic<std::uint32_t>::is_always_lock_free,
+              "busy-handler callback activity must remain lock-free after fork");
+static_assert(std::atomic<bool>::is_always_lock_free,
+              "busy-handler callback flags must remain lock-free after fork");
+
+inline constexpr char kBusyHandlerClientDataName[] =
+    "anonsync.sqlite-busy-handler-owner.v1";
+
+// sqlite3_set_clientdata() may synchronously call the supplied destructor on
+// registration failure, replacement, or explicit clearing. A state value alone
+// is not authority: an unrelated close/replacement racing from another thread
+// must not borrow our transient pending/detaching state. This exact-thread
+// witness exists only around the one set_clientdata call that is allowed to
+// destroy the claim.
+thread_local void* g_authorized_busy_claim_destruction = nullptr;
+
+class ScopedAuthorizedBusyClaimDestruction final {
+public:
+    explicit ScopedAuthorizedBusyClaimDestruction(void* claim) noexcept
+        : claim_(claim) {
+        if (claim_ == nullptr ||
+            g_authorized_busy_claim_destruction != nullptr) {
+            fail_stop_on_sync_process_capability_violation_noexcept();
+        }
+        g_authorized_busy_claim_destruction = claim_;
+    }
+
+    ~ScopedAuthorizedBusyClaimDestruction() {
+        if (g_authorized_busy_claim_destruction != claim_) {
+            fail_stop_on_sync_process_capability_violation_noexcept();
+        }
+        g_authorized_busy_claim_destruction = nullptr;
+    }
+
+    ScopedAuthorizedBusyClaimDestruction(
+        const ScopedAuthorizedBusyClaimDestruction&) = delete;
+    ScopedAuthorizedBusyClaimDestruction& operator=(
+        const ScopedAuthorizedBusyClaimDestruction&) = delete;
+
+private:
+    void* claim_;
+};
+
+void saturating_atomic_add(std::atomic<std::uint64_t>& value,
+                           std::uint64_t amount) noexcept {
+    std::uint64_t observed = value.load(std::memory_order_relaxed);
+    for (;;) {
+        const std::uint64_t replacement =
+            amount > std::numeric_limits<std::uint64_t>::max() - observed
+                ? std::numeric_limits<std::uint64_t>::max()
+                : observed + amount;
+        if (value.compare_exchange_weak(observed,
+                                        replacement,
+                                        std::memory_order_relaxed,
+                                        std::memory_order_relaxed)) {
+            return;
+        }
+    }
+}
+
+std::uint64_t elapsed_milliseconds_since(
+    std::chrono::steady_clock::time_point started) noexcept {
+    const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now() - started);
+    if (elapsed.count() <= 0) return 0;
+    return static_cast<std::uint64_t>(elapsed.count());
+}
+
+[[noreturn]] void fail_stop_on_busy_context_lifetime_violation_noexcept()
+    noexcept {
+    // The stable process-capability exit is also used when a retained callback
+    // address cannot be revoked before its C++ lifetime ends. Continuing would
+    // leave SQLite with authority to call freed storage.
+    fail_stop_on_sync_process_capability_violation_noexcept();
+}
+
+std::runtime_error sqlite_busy_owner_error(sqlite3* database,
+                                           int result_code,
+                                           const std::string& label,
+                                           std::string_view operation) {
+    const char* detail = database == nullptr ? nullptr : sqlite3_errmsg(database);
+    if (detail == nullptr || *detail == '\0') detail = sqlite3_errstr(result_code);
+    return std::runtime_error(label + " " + std::string(operation) + ": " +
+                              (detail == nullptr ? "SQLite error" : detail));
+}
+
+class CallbackActivityScope final {
+public:
+    explicit CallbackActivityScope(
+        std::atomic<std::uint32_t>& active) noexcept
+        : active_(active) {
+        if (active_.fetch_add(1U, std::memory_order_acq_rel) != 0U) {
+            fail_stop_on_busy_context_lifetime_violation_noexcept();
+        }
+    }
+
+    ~CallbackActivityScope() {
+        if (active_.fetch_sub(1U, std::memory_order_acq_rel) != 1U) {
+            fail_stop_on_busy_context_lifetime_violation_noexcept();
+        }
+    }
+
+    CallbackActivityScope(const CallbackActivityScope&) = delete;
+    CallbackActivityScope& operator=(const CallbackActivityScope&) = delete;
+
+private:
+    std::atomic<std::uint32_t>& active_;
+};
+
+}  // namespace
+
+struct SqliteBusyHandlerOwner::ClientDataClaim final {
+    enum class State : std::uint8_t {
+        registration_pending = 0,
+        live = 1,
+        detaching = 2,
+    };
+
+    static constexpr std::uint64_t kMagic = 0x414E4F4E42555359ULL;
+
+    explicit ClientDataClaim(SyncProcessIncarnation process_id_value) noexcept
+        : process_id(process_id_value) {}
+
+    const std::uint64_t magic = kMagic;
+    ClientDataClaim* const self = this;
+    const SyncProcessIncarnation process_id;
+    static_assert(std::atomic<State>::is_always_lock_free,
+                  "busy-handler claim state must remain lock-free after fork");
+
+    std::atomic<State> state{State::registration_pending};
+};
+
+SqliteBusyHandlerOwner::SqliteBusyHandlerOwner(
+    SyncSqliteSerializedDbBorrow database_borrow,
+    std::uint64_t maximum_wait_milliseconds,
+    const std::string& label)
+    : process_id_(current_sync_process_incarnation_noexcept()),
+      database_borrow_(std::move(database_borrow)),
+      maximum_wait_milliseconds_(maximum_wait_milliseconds),
+      installed_at_(std::chrono::steady_clock::now()) {
+    sqlite3* const database = database_borrow_.get();
+    if (database == nullptr) {
+        throw std::invalid_argument(
+            "SQLite busy handler owner requires an exact serialized database-generation borrow");
+    }
+    if (label.empty()) {
+        throw std::invalid_argument(
+            "SQLite busy handler owner requires a nonempty diagnostic label");
+    }
+    if (maximum_wait_milliseconds >
+        kMaximumSqliteBusyHandlerWaitMilliseconds) {
+        throw std::invalid_argument(
+            label + " busy-handler wait exceeds the reviewed ceiling of " +
+            std::to_string(kMaximumSqliteBusyHandlerWaitMilliseconds) +
+            " milliseconds");
+    }
+    if (sqlite3_get_clientdata(database, kBusyHandlerClientDataName) != nullptr) {
+        throw std::logic_error(
+            label + " already has an AnonSync SQLite busy-handler owner");
+    }
+
+    // SQLite invokes the supplied destructor itself if registration fails with
+    // SQLITE_NOMEM. Release before the call so that path cannot double-delete.
+    // No other thread may use or close the connection during construction.
+    auto pending_claim = std::make_unique<ClientDataClaim>(process_id_);
+    ClientDataClaim* const claim = pending_claim.release();
+    int claim_result = SQLITE_ERROR;
+    {
+        ScopedAuthorizedBusyClaimDestruction authorized_destruction(claim);
+        claim_result = sqlite3_set_clientdata(
+            database,
+            kBusyHandlerClientDataName,
+            claim,
+            &SqliteBusyHandlerOwner::destroy_client_data_claim);
+    }
+    if (claim_result != SQLITE_OK) {
+        throw sqlite_busy_owner_error(database,
+                                      claim_result,
+                                      label,
+                                      "could not claim callback context");
+    }
+    claim->state.store(ClientDataClaim::State::live,
+                       std::memory_order_release);
+    client_data_claim_ = claim;
+
+    const int handler_result =
+        sqlite3_busy_handler(database,
+                             &SqliteBusyHandlerOwner::busy_callback,
+                             this);
+    if (handler_result != SQLITE_OK) {
+        claim->state.store(ClientDataClaim::State::detaching,
+                           std::memory_order_release);
+        int clear_result = SQLITE_ERROR;
+        {
+            ScopedAuthorizedBusyClaimDestruction authorized_destruction(claim);
+            clear_result = sqlite3_set_clientdata(
+                database, kBusyHandlerClientDataName, nullptr, nullptr);
+        }
+        if (clear_result != SQLITE_OK) {
+            fail_stop_on_busy_context_lifetime_violation_noexcept();
+        }
+        client_data_claim_ = nullptr;
+        throw sqlite_busy_owner_error(database,
+                                      handler_result,
+                                      label,
+                                      "could not install bounded callback");
+    }
+}
+
+SqliteBusyHandlerOwner::~SqliteBusyHandlerOwner() { detach(); }
+
+SqliteBusyHandlerSnapshot SqliteBusyHandlerOwner::snapshot() const noexcept {
+    require_current_process_noexcept();
+
+    SqliteBusyHandlerSnapshot result;
+    // Every field is monotone. Acquire loads make the snapshot a conservative
+    // lower bound during a running operation and exact after quiescence.
+    result.contention_observed =
+        contention_observed_.load(std::memory_order_acquire);
+    result.invocations = invocations_.load(std::memory_order_acquire);
+    result.sleep_milliseconds =
+        sleep_milliseconds_.load(std::memory_order_acquire);
+    result.timeout_exhausted =
+        timeout_exhausted_.load(std::memory_order_acquire);
+    return result;
+}
+
+bool SqliteBusyHandlerOwner::contention_observed() const noexcept {
+    require_current_process_noexcept();
+    return contention_observed_.load(std::memory_order_acquire);
+}
+
+void SqliteBusyHandlerOwner::detach() noexcept {
+    require_current_process_noexcept();
+    sqlite3* const database = database_borrow_.get();
+    if (database == nullptr) {
+        if (client_data_claim_ != nullptr) {
+            fail_stop_on_busy_context_lifetime_violation_noexcept();
+        }
+        return;
+    }
+    if (client_data_claim_ == nullptr) {
+        fail_stop_on_busy_context_lifetime_violation_noexcept();
+    }
+
+    ClientDataClaim* const claim = client_data_claim_;
+    void* const registered =
+        sqlite3_get_clientdata(database, kBusyHandlerClientDataName);
+    if (registered != claim || claim->magic != ClientDataClaim::kMagic ||
+        claim->self != claim ||
+        claim->state.load(std::memory_order_acquire) !=
+            ClientDataClaim::State::live) {
+        fail_stop_on_busy_context_lifetime_violation_noexcept();
+    }
+
+    // On a serialized connection this call cannot return until any operation
+    // currently invoking the old callback has left SQLite's connection mutex.
+    if (sqlite3_busy_handler(database, nullptr, nullptr) != SQLITE_OK) {
+        fail_stop_on_busy_context_lifetime_violation_noexcept();
+    }
+    if (callbacks_active_.load(std::memory_order_acquire) != 0U) {
+        fail_stop_on_busy_context_lifetime_violation_noexcept();
+    }
+
+    // Clearing the slot synchronously invokes destroy_client_data_claim(). Do
+    // not dereference claim after this call.
+    claim->state.store(ClientDataClaim::State::detaching,
+                       std::memory_order_release);
+    int clear_result = SQLITE_ERROR;
+    {
+        ScopedAuthorizedBusyClaimDestruction authorized_destruction(claim);
+        clear_result = sqlite3_set_clientdata(database,
+                                              kBusyHandlerClientDataName,
+                                              nullptr,
+                                              nullptr);
+    }
+    if (clear_result != SQLITE_OK) {
+        fail_stop_on_busy_context_lifetime_violation_noexcept();
+    }
+    client_data_claim_ = nullptr;
+    database_borrow_.reset();
+}
+
+void SqliteBusyHandlerOwner::destroy_client_data_claim(void* context) noexcept {
+    auto* const claim = static_cast<ClientDataClaim*>(context);
+    if (claim == nullptr || claim->magic != ClientDataClaim::kMagic ||
+        claim->self != claim || !claim->process_id.valid() ||
+        !sync_process_incarnation_is_current(claim->process_id)) {
+        fail_stop_on_busy_context_lifetime_violation_noexcept();
+    }
+
+    const ClientDataClaim::State state =
+        claim->state.load(std::memory_order_acquire);
+    if (state == ClientDataClaim::State::live) {
+        // SQLite is closing the handle or replacing the named slot before the
+        // C++ owner revoked its retained callback. Continuing would invalidate
+        // the owner's exact-generation pin behind its back.
+        fail_stop_on_busy_context_lifetime_violation_noexcept();
+    }
+    if ((state != ClientDataClaim::State::registration_pending &&
+         state != ClientDataClaim::State::detaching) ||
+        g_authorized_busy_claim_destruction != claim) {
+        // Pending/detaching state is not authority for an unrelated close or
+        // replacement call racing from another thread. The only permitted
+        // destructor entry is synchronous with our exact set_clientdata call.
+        fail_stop_on_busy_context_lifetime_violation_noexcept();
+    }
+
+    delete claim;
+}
+
+int SqliteBusyHandlerOwner::busy_callback(void* context,
+                                          int prior_invocations) noexcept {
+    if (context == nullptr) return 0;
+    return static_cast<SqliteBusyHandlerOwner*>(context)->on_busy(
+        prior_invocations);
+}
+
+int SqliteBusyHandlerOwner::on_busy(int prior_invocations) noexcept {
+    require_current_process_noexcept();
+    CallbackActivityScope activity(callbacks_active_);
+
+    saturating_atomic_add(invocations_, 1U);
+    const std::uint64_t now_elapsed =
+        elapsed_milliseconds_since(installed_at_);
+    if (prior_invocations <= 0) {
+        event_started_elapsed_milliseconds_.store(now_elapsed,
+                                                  std::memory_order_release);
+    } else {
+        std::uint64_t absent = std::numeric_limits<std::uint64_t>::max();
+        (void)event_started_elapsed_milliseconds_.compare_exchange_strong(
+            absent,
+            now_elapsed,
+            std::memory_order_release,
+            std::memory_order_relaxed);
+    }
+
+    contention_observed_.store(true, std::memory_order_release);
+
+    if (maximum_wait_milliseconds_ == 0U) {
+        timeout_exhausted_.store(true, std::memory_order_release);
+        return 0;
+    }
+
+    const std::uint64_t event_started =
+        event_started_elapsed_milliseconds_.load(std::memory_order_acquire);
+    const std::uint64_t waited =
+        event_started == std::numeric_limits<std::uint64_t>::max() ||
+                now_elapsed < event_started
+            ? 0U
+            : now_elapsed - event_started;
+    if (waited >= maximum_wait_milliseconds_) {
+        timeout_exhausted_.store(true, std::memory_order_release);
+        return 0;
+    }
+
+    const std::uint64_t remaining = maximum_wait_milliseconds_ - waited;
+    const int normalized_prior = std::max(prior_invocations, 0);
+    const int progressive = normalized_prior >= 9 ? 10 : normalized_prior + 1;
+    const std::uint64_t progressive_sleep =
+        static_cast<std::uint64_t>(progressive);
+    const std::uint64_t requested_sleep =
+        std::min(progressive_sleep, remaining);
+    const int slept = sqlite3_sleep(static_cast<int>(requested_sleep));
+    if (slept > 0) {
+        saturating_atomic_add(sleep_milliseconds_,
+                              static_cast<std::uint64_t>(slept));
+    }
+    return 1;
+}
+
+void SqliteBusyHandlerOwner::require_current_process_noexcept() const noexcept {
+    if (!process_id_.valid() ||
+        !sync_process_incarnation_is_current(process_id_)) {
+        fail_stop_on_sync_process_capability_violation_noexcept();
+    }
+}
+
+}  // namespace anonsync::persistence
