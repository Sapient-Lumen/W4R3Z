+            fail_stop_on_sync_sqlite_capability_violation_noexcept();
+        }
+        if (!sync_sqlite_thread_incarnation_is_current(
+                boundary_proof_->owner_thread_incarnation)) {
+            fail_stop_on_sync_sqlite_mutex_capability_violation_noexcept();
+        }
+        rollback_sync_sqlite_savepoint_boundary_noexcept(db_, *boundary_proof_);
+    }
+    revoke_authority();
+}
+
+void SyncSqliteSavepoint::release() {
+    if (!active_) throw std::logic_error(label_ + " savepoint is not active");
+    require_sync_sqlite_process_id_or_fail_stop(process_id_, label_ + " release");
+    require_sync_sqlite_thread_incarnation_or_throw(
+        boundary_proof_->owner_thread_incarnation, label_ + " release");
+    if (!sync_sqlite_savepoint_boundary_authorizes_noexcept(
+            db_, *boundary_proof_)) {
+        revoke_authority();
+        throw std::logic_error(
+            label_ + " savepoint boundary is no longer owned by this guard");
+    }
+    try {
+        end_sync_sqlite_savepoint_boundary_or_throw(
+            db_,
+            *boundary_proof_,
+            SyncSqliteSavepointBoundaryEnd::Release,
+            label_ + " release");
+    } catch (...) {
+        if (!sync_sqlite_savepoint_boundary_authorizes_noexcept(
+                db_, *boundary_proof_)) {
+            revoke_authority();
+        }
+        throw;
+    }
+    revoke_authority();
+}
+
+void SyncSqliteSavepoint::rollback() {
+    if (!active_) return;
+    require_sync_sqlite_process_id_or_fail_stop(process_id_, label_ + " rollback");
+    require_sync_sqlite_thread_incarnation_or_throw(
+        boundary_proof_->owner_thread_incarnation, label_ + " rollback");
+    if (!sync_sqlite_savepoint_boundary_authorizes_noexcept(
+            db_, *boundary_proof_)) {
+        const bool already_ended = sqlite3_get_autocommit(db_) != 0;
+        revoke_authority();
+        if (already_ended) return;
+        throw std::logic_error(
+            label_ +
+            " savepoint boundary is no longer owned; rollback was not executed");
+    }
+    try {
+        end_sync_sqlite_savepoint_boundary_or_throw(
+            db_,
+            *boundary_proof_,
+            SyncSqliteSavepointBoundaryEnd::Rollback,
+            label_ + " rollback");
+    } catch (...) {
+        if (!sync_sqlite_savepoint_boundary_authorizes_noexcept(
+                db_, *boundary_proof_)) {
+            revoke_authority();
+        }
+        throw;
+    }
+    revoke_authority();
+}
+
+bool SyncSqliteSavepoint::active() const noexcept {
+    return active_ && boundary_proof_ != nullptr &&
+           sync_sqlite_process_id_is_current(process_id_) &&
+           sync_sqlite_thread_incarnation_is_current(
+               boundary_proof_->owner_thread_incarnation) &&
+           sync_sqlite_savepoint_boundary_authorizes_noexcept(
+               db_, *boundary_proof_);
+}
+
+void SyncSqliteSavepoint::revoke_authority() noexcept {
+    active_ = false;
+    if (boundary_proof_ != nullptr) {
+        release_sync_sqlite_savepoint_mutex_noexcept(*boundary_proof_);
+    }
+}
+
 }  // namespace anonsync
