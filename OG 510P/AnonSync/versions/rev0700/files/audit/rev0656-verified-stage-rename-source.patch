+struct StagedFileVerification {
+    std::uint64_t size_bytes = 0;
+    std::uint64_t chunks_verified = 0;
+    std::string content_sha256;
+};
+
+StagedFileVerification verify_staged_file_matches_entry_or_throw(const fs::path& staged_file,
+                                                                  const SyncManifestEntry& expected_entry) {
+    std::ifstream in(staged_file, std::ios::binary);
+    if (!in) throw std::runtime_error("could not open staged sync file for verification: " + staged_file.string());
+
+    MdCtxPtr content_ctx(EVP_MD_CTX_new());
+    if (!content_ctx || EVP_DigestInit_ex(content_ctx.get(), EVP_sha256(), nullptr) != 1) {
+        throw std::runtime_error("could not initialize staged sync content digest");
+    }
+
+    std::array<char, 64 * 1024> buffer{};
+    StagedFileVerification verification;
+    for (const auto& expected_chunk : expected_entry.chunks) {
+        MdCtxPtr chunk_ctx(EVP_MD_CTX_new());
+        if (!chunk_ctx || EVP_DigestInit_ex(chunk_ctx.get(), EVP_sha256(), nullptr) != 1) {
+            throw std::runtime_error("could not initialize staged sync chunk digest");
+        }
+
+        std::uint64_t remaining = expected_chunk.length;
+        while (remaining > 0) {
+            const size_t want = static_cast<size_t>(std::min<std::uint64_t>(remaining, buffer.size()));
+            in.read(buffer.data(), static_cast<std::streamsize>(want));
+            const std::streamsize got = in.gcount();
+            if (got <= 0) throw std::runtime_error("staged sync file ended before expected chunk bytes");
+            const size_t got_size = static_cast<size_t>(got);
+            if (EVP_DigestUpdate(content_ctx.get(), buffer.data(), got_size) != 1 ||
+                EVP_DigestUpdate(chunk_ctx.get(), buffer.data(), got_size) != 1) {
+                throw std::runtime_error("could not update staged sync file digest");
+            }
+            if (static_cast<std::uint64_t>(got_size) > std::numeric_limits<std::uint64_t>::max() - verification.size_bytes) {
+                throw std::runtime_error("staged sync file size overflow while verifying");
+            }
+            verification.size_bytes += static_cast<std::uint64_t>(got_size);
+            remaining -= static_cast<std::uint64_t>(got_size);
+        }
+
+        unsigned char chunk_hash[EVP_MAX_MD_SIZE];
+        unsigned int chunk_hash_len = 0;
+        if (EVP_DigestFinal_ex(chunk_ctx.get(), chunk_hash, &chunk_hash_len) != 1) {
+            throw std::runtime_error("could not finalize staged sync chunk digest");
+        }
+        if (hex_from_digest(chunk_hash, chunk_hash_len) != expected_chunk.sha256) {
+            throw std::runtime_error("staged sync file chunk hash mismatch at offset " + u64_string(expected_chunk.offset));
+        }
+        ++verification.chunks_verified;
+    }
+
+    char extra = 0;
+    in.read(&extra, 1);
+    if (in.gcount() != 0) throw std::runtime_error("staged sync file has trailing bytes beyond manifest entry");
+    if (in.bad()) throw std::runtime_error("could not finish staged sync file verification read");
+
+    unsigned char content_hash[EVP_MAX_MD_SIZE];
+    unsigned int content_hash_len = 0;
+    if (EVP_DigestFinal_ex(content_ctx.get(), content_hash, &content_hash_len) != 1) {
+        throw std::runtime_error("could not finalize staged sync content digest");
+    }
+    verification.content_sha256 = hex_from_digest(content_hash, content_hash_len);
+    if (verification.size_bytes != expected_entry.size_bytes) {
+        throw std::runtime_error("staged sync file size does not match manifest entry");
+    }
+    if (verification.content_sha256 != expected_entry.content_sha256) {
+        throw std::runtime_error("staged sync file content hash does not match manifest entry");
+    }
+    return verification;
+}
