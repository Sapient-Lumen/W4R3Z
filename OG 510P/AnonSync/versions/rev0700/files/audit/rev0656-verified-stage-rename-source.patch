+void require_absent_or_directory_not_symlink_or_throw(const fs::path& path, const std::string& label) {
+    std::error_code ec;
+    const fs::file_status link_status = fs::symlink_status(path, ec);
+    if (ec) {
+        if (ec == std::errc::no_such_file_or_directory) return;
+        throw std::invalid_argument(label + " could not be inspected: " + ec.message());
+    }
+    if (!fs::exists(link_status)) return;
+    if (fs::is_symlink(link_status)) throw std::invalid_argument(label + " must not be a symlink");
+    if (!fs::is_directory(link_status)) throw std::invalid_argument(label + " must be absent or a directory");
