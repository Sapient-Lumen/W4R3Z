+void fsync_file_if_supported_or_throw(const fs::path& path, const std::string& label) {
+#if defined(_WIN32)
+    (void)path;
+    (void)label;
+#else
+    int flags = O_RDONLY;
+#ifdef O_CLOEXEC
+    flags |= O_CLOEXEC;
+#endif
+    const std::string native = path.string();
+    int fd = ::open(native.c_str(), flags);
+    if (fd < 0) throw std::runtime_error(label + " open for fsync failed: " + std::strerror(errno));
+    int saved_errno = 0;
+    if (::fsync(fd) != 0) saved_errno = errno;
+    if (::close(fd) != 0 && saved_errno == 0) saved_errno = errno;
+    if (saved_errno != 0) throw std::runtime_error(label + " fsync failed: " + std::strerror(saved_errno));
+#endif
+}
