+    const fs::path relative = candidate.lexically_relative(root);
+    fs::path current = root;
+    fs::path parent_relative = relative.parent_path();
+    for (const auto& component : parent_relative) {
+        if (component == "." || component.empty()) continue;
+        current /= component;
+        std::error_code ec;
+        const fs::file_status status = fs::symlink_status(current, ec);
+        if (ec) {
+            if (ec == std::errc::no_such_file_or_directory) continue;
+            throw std::invalid_argument(label + " ancestor could not be inspected: " + ec.message());
+        }
+        if (!fs::exists(status)) continue;
+        if (fs::is_symlink(status)) throw std::invalid_argument(label + " rejects symlink ancestor: " + current.generic_string());
+        if (!fs::is_directory(status)) throw std::invalid_argument(label + " ancestor is not a directory: " + current.generic_string());
+    }
