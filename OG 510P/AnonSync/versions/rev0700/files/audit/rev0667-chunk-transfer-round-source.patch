+                                                                                      request_plan,
+                                                                                      batch_envelope,
+                                                                                      chunk_bytes,
+                                                                                      write_options,
+                                                                                      acceptance);
+    if (!acceptance_result.ok) {
+        return fail_result("chunk transfer round batch acceptance failed: " + acceptance_result.reason);
+    }
+
+    SyncStagedTransferInspectionResult post_inspection;
+    SyncValidationResult inspection_result = inspect_sync_staged_transfer(remote_file_entry,
