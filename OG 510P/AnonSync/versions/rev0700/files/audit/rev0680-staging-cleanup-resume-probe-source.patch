+
+void record_staging_artifact_path(SyncStagingArtifactsProbe& probe,
+                                  const NormalizedSyncPath& path) {
+    if (probe.artifact_paths.size() >= 128) return;
+    const auto duplicate = std::any_of(probe.artifact_paths.begin(), probe.artifact_paths.end(), [&](const NormalizedSyncPath& existing) {
+        return existing.value == path.value;
+    });
+    if (!duplicate) probe.artifact_paths.push_back(path);
+}
+
+SyncStagingArtifactsProbe verify_committed_staging_artifacts_absent_or_throw(sqlite3* db,
+                                                                             const std::string& session_id,
+                                                                             const fs::path& staging_root,
+                                                                             const std::string& label) {
+    require_existing_directory_not_symlink_or_throw(staging_root, label + " root");
+    SyncSqliteStmt stmt = sqlite_prepare_or_throw(db,
+        "SELECT f.path, e.entry_digest, a.remote_entry_digest, a.absolute_staging_path "
+        "FROM sync_session_file_results f "
+        "JOIN sync_session_apply_intents a ON a.session_id=f.session_id AND a.path=f.path "
+        "JOIN sync_session_manifest_entries e ON e.session_id=f.session_id AND e.role='source' AND e.path=f.path "
+        "WHERE f.session_id=? AND f.staging_artifacts_cleaned=1 AND e.kind='file' "
+        "ORDER BY f.path;",
+        label + " cleaned staging artifact scan");
+    sqlite_bind_text_or_throw(stmt.stmt, 1, session_id, label + " session");
+
+    SyncStagingArtifactsProbe probe;
+    while (true) {
+        const int rc = sqlite3_step(stmt.stmt);
+        if (rc == SQLITE_DONE) break;
+        if (rc != SQLITE_ROW) throw std::runtime_error(label + ": staging artifact query failed");
+
+        NormalizedSyncPath path;
+        SyncValidationResult path_result = normalize_sync_relative_path(sqlite_column_text_or_throw(stmt.stmt, 0, label + " path"), path);
+        if (!path_result.ok) throw std::runtime_error(label + ": stored path is invalid: " + path_result.reason);
+        const std::string entry_digest = sqlite_column_text_or_throw(stmt.stmt, 1, label + " entry digest");
+        const std::string remote_entry_digest = sqlite_column_text_or_throw(stmt.stmt, 2, label + " remote entry digest");
+        const std::string stored_staging_path = sqlite_column_text_or_throw(stmt.stmt, 3, label + " stored staging path");
+        if (!is_lowercase_sha256_hex(entry_digest) || !is_lowercase_sha256_hex(remote_entry_digest)) {
+            throw std::runtime_error(label + ": staging artifact row has invalid digest evidence");
+        }
+        if (entry_digest != remote_entry_digest) {
+            throw std::runtime_error(label + ": apply intent remote digest does not match persisted source manifest entry");
+        }
+
+        NormalizedSyncPath staged_relative;
+        staged_relative.value = remote_staging_relative_path_for_digest_or_throw(path, remote_entry_digest, label + " staging path");
