  ],
  "parent_revision": "rev0650",
  "product_mission": "AnonSync is a C++ peer-to-peer file synchronization system aiming at Resilio Sync-style folder replication across authorized devices.",
  "refactor_scope": "Introduces a separate sync_domain.cpp translation unit instead of growing runner.cpp/sqlite_replay_ledger.cpp/reporting_selftests.cpp.",
  "revision_id": "rev0651",
  "security_properties_claimed": [
    "relative-only portable UTF-8 sync paths reject obvious aliasing and traversal forms",
    "file manifest entries require lowercase SHA-256 content/chunk hashes",
    "chunk ranges must be contiguous from offset zero and exactly cover size_bytes",
    "tombstones cannot carry content/chunks",
    "lineage must be positive, unique, and sorted by device id",
    "sync mutation idempotency keys are namespaced to sync:v1 and reject generic_effect"
  ],
