+        return fail_result("peer chunk response batch acceptance rejected schedule evidence: " + schedule_result.reason);
+    }
+
+    bool assignment_found = false;
+    for (const auto& scheduled_assignment : peer_schedule.assignments) {
+        if (peer_chunk_assignment_equal(scheduled_assignment, peer_assignment)) {
+            assignment_found = true;
+            break;
+        }
+    }
+    if (!assignment_found) {
+        return fail_result("peer chunk response batch acceptance assignment is not present in the peer schedule");
+    }
+    if (peer_batch_envelope.responses.empty()) {
+        return fail_result("peer chunk response batch acceptance requires at least one response envelope");
+    }
+    if (chunk_bytes.size() != peer_batch_envelope.responses.size()) {
+        return fail_result("peer chunk response batch acceptance chunk byte vector does not match response count");
+    }
+
+    std::vector<SyncChunkRange> response_chunks;
+    response_chunks.reserve(peer_batch_envelope.responses.size());
+    for (const auto& response : peer_batch_envelope.responses) {
+        SyncChunkRange chunk;
+        chunk.offset = response.offset;
+        chunk.length = response.length;
+        chunk.sha256 = response.chunk_sha256;
+        response_chunks.push_back(chunk);
+    }
+    if (!chunk_ranges_are_ordered_unique_subset_of(peer_assignment.chunks, response_chunks)) {
+        return fail_result("peer chunk response batch acceptance response chunks are not an ordered unique subset of the scheduled peer assignment");
+    }
+
+    SyncPeerChunkResponseBatchEnvelope expected_peer_batch;
+    SyncValidationResult peer_envelope_result = build_sync_peer_chunk_response_batch_envelope(remote_file_entry,
+                                                                                             apply_entry,
+                                                                                             expected_request,
+                                                                                             peer_schedule,
+                                                                                             peer_assignment,
+                                                                                             response_chunks,
+                                                                                             expected_peer_batch);
+    if (!peer_envelope_result.ok) {
+        return fail_result("peer chunk response batch acceptance rejected peer envelope evidence: " + peer_envelope_result.reason);
+    }
+    if (peer_batch_envelope.path.value != expected_peer_batch.path.value ||
+        peer_batch_envelope.request_idempotency_key != expected_peer_batch.request_idempotency_key ||
+        peer_batch_envelope.schedule_idempotency_key != expected_peer_batch.schedule_idempotency_key ||
+        peer_batch_envelope.peer_id != expected_peer_batch.peer_id ||
+        peer_batch_envelope.peer_session_id != expected_peer_batch.peer_session_id ||
+        peer_batch_envelope.peer_request_idempotency_key != expected_peer_batch.peer_request_idempotency_key ||
+        peer_batch_envelope.peer_response_batch_idempotency_key != expected_peer_batch.peer_response_batch_idempotency_key ||
+        peer_batch_envelope.batch_idempotency_key != expected_peer_batch.batch_idempotency_key ||
+        peer_batch_envelope.remote_entry_digest != expected_peer_batch.remote_entry_digest ||
+        peer_batch_envelope.remote_version_digest != expected_peer_batch.remote_version_digest ||
+        peer_batch_envelope.apply_entry_idempotency_key != expected_peer_batch.apply_entry_idempotency_key ||
+        peer_batch_envelope.response_count != expected_peer_batch.response_count ||
+        peer_batch_envelope.total_bytes != expected_peer_batch.total_bytes ||
+        !response_envelope_vectors_equal(peer_batch_envelope.responses, expected_peer_batch.responses)) {
+        return fail_result("peer chunk response batch acceptance peer envelope does not match schedule/request evidence");
+    }
+
+    SyncChunkResponseBatchEnvelope base_batch;
+    base_batch.path = peer_batch_envelope.path;
+    base_batch.request_idempotency_key = peer_batch_envelope.request_idempotency_key;
+    base_batch.batch_idempotency_key = peer_batch_envelope.batch_idempotency_key;
+    base_batch.remote_entry_digest = peer_batch_envelope.remote_entry_digest;
+    base_batch.remote_version_digest = peer_batch_envelope.remote_version_digest;
+    base_batch.apply_entry_idempotency_key = peer_batch_envelope.apply_entry_idempotency_key;
+    base_batch.response_count = peer_batch_envelope.response_count;
+    base_batch.total_bytes = peer_batch_envelope.total_bytes;
+    base_batch.responses = peer_batch_envelope.responses;
+
+    SyncChunkResponseBatchAcceptanceResult base_acceptance;
+    SyncValidationResult base_accept_result = accept_sync_chunk_response_batch_envelope(remote_file_entry,
+                                                                                       apply_entry,
+                                                                                       inspection,
+                                                                                       request_options,
+                                                                                       expected_request,
+                                                                                       base_batch,
+                                                                                       chunk_bytes,
+                                                                                       write_options,
+                                                                                       base_acceptance);
+    if (!base_accept_result.ok) {
+        return fail_result("peer chunk response batch acceptance write failed: " + base_accept_result.reason);
+    }
+
+    out.path = expected_peer_batch.path;
+    out.request_idempotency_key = expected_request.idempotency_key;
+    out.schedule_idempotency_key = peer_schedule.schedule_idempotency_key;
+    out.peer_id = peer_assignment.peer_id;
+    out.peer_session_id = peer_assignment.peer_session_id;
+    out.peer_request_idempotency_key = peer_assignment.peer_request_idempotency_key;
+    out.peer_response_batch_idempotency_key = expected_peer_batch.peer_response_batch_idempotency_key;
+    out.batch_idempotency_key = expected_peer_batch.batch_idempotency_key;
+    out.request_evidence_checked = true;
+    out.peer_schedule_checked = true;
+    out.peer_assignment_checked = true;
+    out.peer_response_envelope_checked = true;
+    out.response_count = base_acceptance.response_count;
+    out.chunks_written = base_acceptance.chunks_written;
+    out.receipts_reused = base_acceptance.receipts_reused;
+    out.staged_file_complete = base_acceptance.staged_file_complete;
+    out.chunks_verified = base_acceptance.chunks_verified;
+    out.content_sha256 = base_acceptance.content_sha256;
+    out.accepted_chunks = std::move(base_acceptance.accepted_chunks);
+    return ok_result();
+}
