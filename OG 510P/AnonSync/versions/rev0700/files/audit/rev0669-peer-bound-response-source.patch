+SyncValidationResult accept_sync_peer_chunk_response_batch_envelope(const SyncManifestEntry& remote_file_entry,
+                                                                    const SyncLocalApplyPlanEntry& apply_entry,
+                                                                    const SyncStagedTransferInspectionResult& inspection,
+                                                                    const SyncChunkRequestPlanOptions& request_options,
+                                                                    const SyncChunkRequestPlanResult& request_plan,
+                                                                    const SyncPeerChunkScheduleResult& peer_schedule,
+                                                                    const SyncPeerChunkAssignment& peer_assignment,
+                                                                    const SyncPeerChunkResponseBatchEnvelope& peer_batch_envelope,
+                                                                    const std::vector<std::string>& chunk_bytes,
+                                                                    const SyncChunkReceiptWriteOptions& write_options,
+                                                                    SyncPeerChunkResponseBatchAcceptanceResult& out) {
+    out = SyncPeerChunkResponseBatchAcceptanceResult{};
+
+    SyncChunkRequestPlanResult expected_request;
+    SyncValidationResult request_result = build_sync_chunk_request_plan(remote_file_entry,
+                                                                       apply_entry,
+                                                                       inspection,
+                                                                       request_options,
+                                                                       expected_request);
+    if (!request_result.ok) {
+        return fail_result("peer chunk response batch acceptance rejected request evidence: " + request_result.reason);
+    }
+    if (request_plan.path.value != expected_request.path.value ||
+        request_plan.idempotency_key != expected_request.idempotency_key ||
+        request_plan.staged_file_complete != expected_request.staged_file_complete ||
+        request_plan.more_chunks_available != expected_request.more_chunks_available ||
+        request_plan.total_missing_chunks != expected_request.total_missing_chunks ||
+        request_plan.selected_chunks != expected_request.selected_chunks ||
