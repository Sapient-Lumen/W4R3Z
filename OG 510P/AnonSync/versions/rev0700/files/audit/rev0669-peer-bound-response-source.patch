+SyncValidationResult build_sync_peer_chunk_response_batch_envelope(const SyncManifestEntry& remote_file_entry,
+                                                                   const SyncLocalApplyPlanEntry& apply_entry,
+                                                                   const SyncChunkRequestPlanResult& request_plan,
+                                                                   const SyncPeerChunkScheduleResult& peer_schedule,
+                                                                   const SyncPeerChunkAssignment& peer_assignment,
+                                                                   const std::vector<SyncChunkRange>& response_chunks,
+                                                                   SyncPeerChunkResponseBatchEnvelope& out) {
+    out = SyncPeerChunkResponseBatchEnvelope{};
+    SyncValidationResult evidence_result = validate_staged_remote_file_evidence(remote_file_entry, apply_entry,
+                                                                                "peer chunk response batch envelope");
+    if (!evidence_result.ok) return evidence_result;
+    SyncValidationResult request_result = validate_chunk_request_plan_for_remote(remote_file_entry, request_plan,
+                                                                                "peer chunk response batch envelope");
+    if (!request_result.ok) return request_result;
+    if (request_plan.staged_file_complete) {
+        return fail_result("peer chunk response batch envelope refuses responses for a complete staged transfer");
+    }
+    SyncValidationResult schedule_result = validate_peer_chunk_schedule_for_request(remote_file_entry,
+                                                                                   apply_entry,
+                                                                                   request_plan,
+                                                                                   peer_schedule);
+    if (!schedule_result.ok) {
+        return fail_result("peer chunk response batch envelope rejected schedule evidence: " + schedule_result.reason);
+    }
+
+    bool assignment_found = false;
+    for (const auto& scheduled_assignment : peer_schedule.assignments) {
+        if (peer_chunk_assignment_equal(scheduled_assignment, peer_assignment)) {
+            assignment_found = true;
+            break;
+        }
+    }
+    if (!assignment_found) {
+        return fail_result("peer chunk response batch envelope assignment is not present in the peer schedule");
+    }
+    if (response_chunks.empty()) {
+        return fail_result("peer chunk response batch envelope requires at least one response chunk");
+    }
+    if (!chunk_ranges_are_ordered_unique_subset_of(peer_assignment.chunks, response_chunks)) {
+        return fail_result("peer chunk response batch envelope response chunks must be an ordered unique subset of the scheduled peer assignment");
+    }
+
+    SyncChunkResponseBatchEnvelope base_batch;
+    SyncValidationResult batch_result = build_sync_chunk_response_batch_envelope(remote_file_entry,
+                                                                                apply_entry,
+                                                                                request_plan,
+                                                                                response_chunks,
+                                                                                base_batch);
+    if (!batch_result.ok) {
+        return fail_result("peer chunk response batch envelope rejected base batch evidence: " + batch_result.reason);
+    }
+
+    out.path = remote_file_entry.path;
+    out.request_idempotency_key = request_plan.idempotency_key;
+    out.schedule_idempotency_key = peer_schedule.schedule_idempotency_key;
+    out.peer_id = peer_assignment.peer_id;
+    out.peer_session_id = peer_assignment.peer_session_id;
+    out.peer_request_idempotency_key = peer_assignment.peer_request_idempotency_key;
+    out.batch_idempotency_key = base_batch.batch_idempotency_key;
+    out.remote_entry_digest = base_batch.remote_entry_digest;
+    out.remote_version_digest = base_batch.remote_version_digest;
+    out.apply_entry_idempotency_key = base_batch.apply_entry_idempotency_key;
+    out.response_count = base_batch.response_count;
+    out.total_bytes = base_batch.total_bytes;
+    out.responses = base_batch.responses;
+    out.peer_response_batch_idempotency_key = peer_chunk_response_batch_idempotency_key(remote_file_entry,
+                                                                                       apply_entry,
+                                                                                       request_plan,
+                                                                                       peer_schedule,
+                                                                                       peer_assignment,
+                                                                                       base_batch);
+    return ok_result();
+}
