+    std::vector<SyncPeerChunkAvailability> peers = sorted_peer_availabilities(peer_availabilities);
+    std::vector<SyncPeerChunkAvailability> limited;
+    limited.reserve(peers.size());
+    for (const auto& peer : peers) {
+        SyncPeerChunkAvailability next_peer;
+        next_peer.peer_id = peer.peer_id;
+        next_peer.peer_session_id = peer.peer_session_id;
+        next_peer.max_chunks = peer.max_chunks;
+        next_peer.max_bytes = peer.max_bytes;
+        for (const auto& chunk : peer.available_chunks) {
+            if (chunk_range_is_selected(request_plan.chunks_to_request, chunk)) {
+                next_peer.available_chunks.push_back(chunk);
+            }
+        }
+        if (!next_peer.available_chunks.empty()) {
+            limited.push_back(std::move(next_peer));
+        }
+    }
+    return limited;
