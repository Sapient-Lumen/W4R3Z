+        data = p.read_bytes()
+        if len(data) != row["size_bytes"]:
+            raise AssertionError(f"manifest size mismatch: {rel}")
+        if hashlib.sha256(data).hexdigest() != row["sha256"]:
+            raise AssertionError(f"manifest sha mismatch: {rel}")
