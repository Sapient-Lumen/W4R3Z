+SyncLineageRelation compare_lineage_vectors(const std::vector<SyncVersionLineageEntry>& local,
+                                            const std::vector<SyncVersionLineageEntry>& remote) {
+    std::map<std::string, std::pair<std::uint64_t, std::uint64_t>> counters;
+    for (const auto& entry : local) counters[entry.device_id].first = entry.counter;
+    for (const auto& entry : remote) counters[entry.device_id].second = entry.counter;
+
+    bool local_greater = false;
+    bool remote_greater = false;
+    for (const auto& row : counters) {
+        const std::uint64_t local_counter = row.second.first;
+        const std::uint64_t remote_counter = row.second.second;
+        if (local_counter > remote_counter) local_greater = true;
+        if (remote_counter > local_counter) remote_greater = true;
+    }
+    if (local_greater && remote_greater) return SyncLineageRelation::Concurrent;
+    if (local_greater) return SyncLineageRelation::LocalNewer;
+    if (remote_greater) return SyncLineageRelation::RemoteNewer;
+    return SyncLineageRelation::Equal;
+}
