+bool chunk_available_by_hash_and_length(const SyncManifestEntry* local_entry, const SyncChunkRange& remote_chunk) {
+    if (local_entry == nullptr || local_entry->kind != SyncManifestEntryKind::File) return false;
+    for (const auto& local_chunk : local_entry->chunks) {
+        if (local_chunk.length == remote_chunk.length && local_chunk.sha256 == remote_chunk.sha256) return true;
+    }
+    return false;
