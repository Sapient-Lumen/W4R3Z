+#!/usr/bin/env python3
+import hashlib
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+EXPECTED_VALIDATOR = "rev0676 checkpoint resume integrity guard package validator passed"
+EXPECTED_CTEST = "100% tests passed, 0 tests failed out of 27"
+EXPECTED_SELFTEST = "anonsync_core sync domain model selftest passed=203 failed=0"
+ACTIVE_BINARY = "bin/rev0676/anonsync_core-linux-x86_64-gcc-openssl3-sqlite3"
+OLD_ACTIVE_BINARY = "bin/rev0675/anonsync_core-linux-x86_64-gcc-openssl3-sqlite3"
+CAPABILITY_MANIFEST = "gateway/rev0648-cpp-ledger-backend-capabilities.json"
+AUDIT = ROOT / "audit/rev0676-checkpoint-resume-integrity-guard-audit.json"
+MANIFEST = ROOT / "schema/rev0676/slim-cube-manifest.json"
+VALIDATOR_LOG = "audit/logs/rev0676-checkpoint-resume-integrity-guard-package-validator.log"
+EXCLUDED_MUTABLE = {"schema/rev0676/slim-cube-manifest.json", VALIDATOR_LOG}
+
+REQUIRED_CURRENT_FILES = [
+    "README.md",
+    "cpp/anonsync_core/README.md",
+    "cpp/anonsync_core/include/anonsync_core.hpp",
+    "cpp/anonsync_core/src/sync_domain.cpp",
+    ACTIVE_BINARY,
+    "bin/HISTORY.md",
+    "docs/0001-cpp-core-gameplan.md",
+    "docs/0003-next-risk-register.md",
+    "docs/0066-rev0676-checkpoint-resume-integrity-guard.md",
+    "audit/rev0676-checkpoint-resume-integrity-guard-audit.json",
+    "audit/rev0676-checkpoint-resume-integrity-guard-source.patch",
+    "audit/logs/rev0676-release-o0-configure.log",
+    "audit/logs/rev0676-release-o0-build.log",
+    "audit/logs/rev0676-release-o0-ctest.log",
+    "audit/logs/rev0676-resume-integrity-guard-selftest.log",
+    "audit/logs/rev0676-narrow-asan-ubsan-sync-domain-configure.log",
+    "audit/logs/rev0676-narrow-asan-ubsan-sync-domain-build.log",
+    "audit/logs/rev0676-narrow-asan-ubsan-sync-domain-selftest.log",
+    "audit/logs/rev0676-binary-sha256.txt",
+    "audit/logs/rev0676-binary-ldd.txt",
+    "tools/validate_rev0676_checkpoint_resume_integrity_guard.py",
+    "schema/rev0676/slim-cube-manifest.json",
+]
+
+REQUIRED_PHRASES = {
+    "README.md": [
+        "AnonSync slim C++ working cube — rev0676",
+        "checkpoint resume integrity guard",
+        "require_durable_integrity",
+        "durable_integrity_verified",
+        EXPECTED_SELFTEST,
+        "does not replay them into resumed work",
+    ],
+    "cpp/anonsync_core/README.md": [
+        "anonsync_core rev0676",
+        "checkpoint resume integrity guard",
+        "require_durable_integrity",
+        "durable_integrity_verified",
+        "corrupts a persisted source manifest entry count",
+    ],
+    "cpp/anonsync_core/include/anonsync_core.hpp": [
+        "bool require_durable_integrity = true;",
+        "std::string schema_version;",
+        "bool manifest_digest_rows_verified = false;",
+        "bool manifest_entry_rows_verified = false;",
+        "bool file_result_aggregates_verified = false;",
+        "bool chunk_receipt_totals_verified = false;",
+        "bool durable_integrity_verified = false;",
+        "std::uint64_t source_manifest_chunks_recorded = 0;",
+    ],
+    "cpp/anonsync_core/src/sync_domain.cpp": [
+        "supported_sync_session_checkpoint_schema_version",
+        "sqlite_count_for_session_role_or_throw",
+        "sqlite_meta_value_or_throw",
+        "sync session checkpoint resume requires durable cross-table integrity evidence",
+        "sync session checkpoint resume view reloads terminal completion and durable integrity evidence as restart input",
+        "sync session checkpoint resume integrity guard rejects mismatched manifest entry-count rows",
+    ],
+    "docs/0066-rev0676-checkpoint-resume-integrity-guard.md": [
+        "Rev0676 — checkpoint resume integrity guard",
+        "durable cross-table integrity guard",
+        "require_durable_integrity",
+        EXPECTED_SELFTEST,
+        "Remaining ceiling",
+    ],
+    "docs/0001-cpp-core-gameplan.md": [
+        "Current rev0676 product slice — checkpoint resume integrity guard",
+        "durable_integrity_verified",
+        "checkpoint resume integrity verification",
+        EXPECTED_SELFTEST,
+        EXPECTED_CTEST,
+    ],
+    "docs/0003-next-risk-register.md": [
+        "Next risk register after rev0676",
+        "Rev0676 priority note",
+        "integrity-checked resume view",
+        "actionable recovery",
+    ],
+    "bin/HISTORY.md": [
+        "rev0676",
+        "checkpoint resume integrity verification",
+        "rev0675: historical source/audit only",
+    ],
+    "audit/rev0676-checkpoint-resume-integrity-guard-audit.json": [
+        "checkpoint-resume-integrity-guard",
+        "require_durable_integrity",
+        "durable_integrity_verified",
+        "package_validator_summary",
+    ],
+    "audit/rev0676-checkpoint-resume-integrity-guard-source.patch": [
+        "0066-rev0676-checkpoint-resume-integrity-guard.md",
