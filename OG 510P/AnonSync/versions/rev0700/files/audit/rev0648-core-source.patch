+def assert_bad_transition_authority_rejected_before_claim(tmp: pathlib.Path) -> None:
+    good_key, trust, trust_sha, kid = make_trust_and_key(tmp)
+    bad_key = tmp / "relay-untrusted-signer.pem"
+    write_private_key(bad_key)
+    ledger = seed_single_effect_ledger(tmp, "bad-authority-ledger")
+    downstream = tmp / "bad-authority-downstream.sqlite"
+    config = tmp / "bad-authority-config.json"
+    registry = tmp / "bad-authority-registry.json"
+    config_sha = write_relay_config(
+        config,
+        downstream,
+        bad_key,
+        trust,
+        trust_sha,
+        kid,
+        adapter_id="validator-bad-authority",
+        worker="validator-bad-authority-worker",
+    )
+    registry_sha = write_registry(registry, config, config_sha, adapter_id="validator-bad-authority")
+    proc = run([
+        BIN,
+        "--ledger", ledger,
+        "--ledger-effect-relay-report", tmp / "bad-authority-report.json",
+        "--ledger-effect-relay-registry", registry,
+        "--ledger-effect-relay-registry-sha256", registry_sha,
+        "--ledger-effect-relay-config-handle", HANDLE,
+        "--ledger-effect-relay-now-epoch", 1781751780,
+    ], expect_codes=set(range(1, 256)))
+    msg = (proc.stdout + proc.stderr).lower()
+    if not any(word in msg for word in ["signature", "signer", "trust", "verification"]):
+        raise AssertionError(f"bad transition authority rejection was not clear: {msg}")
+    if downstream.exists():
+        raise AssertionError("bad transition authority created/touched the downstream store before rejection")
+    if pending_counts(ledger, tmp, "after-bad-authority") != (1, 0, 0):
+        raise AssertionError("bad transition authority mutated outbox before claim")
+    # A valid signer/trust pair must still be able to claim, touch downstream, and close the same work.
+    good_config = tmp / "good-authority-config.json"
+    good_registry = tmp / "good-authority-registry.json"
+    good_config_sha = write_relay_config(
+        good_config,
+        downstream,
+        good_key,
+        trust,
+        trust_sha,
+        kid,
+        adapter_id="validator-good-authority",
+        worker="validator-good-authority-worker",
+    )
+    good_registry_sha = write_registry(good_registry, good_config, good_config_sha, adapter_id="validator-good-authority")
+    good = relay_once_handle(ledger, good_registry, good_registry_sha, HANDLE, tmp / "good-authority-report.json", 1781751780)
+    if good["claimed"] is not True or good["downstream_touched"] is not True or good["transition_closed"] is not True:
+        raise AssertionError(f"valid transition authority did not close work after bad-authority rejection: {good}")
+    if good.get("transition_authority_preflight_verified") is not True:
+        raise AssertionError("valid relay report did not disclose transition-authority preflight")
+    if pending_counts(ledger, tmp, "after-good-authority") != (0, 0, 1):
+        raise AssertionError("valid transition authority did not terminally close the outbox")
