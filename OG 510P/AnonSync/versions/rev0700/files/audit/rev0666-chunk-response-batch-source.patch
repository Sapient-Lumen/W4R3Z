+std::string digest_chunk_response_envelopes(const std::vector<SyncChunkResponseEnvelope>& responses) {
+    std::string material;
+    std::uint64_t index = 0;
+    for (const auto& response : responses) {
+        material += length_prefixed_security_tuple("anonsync-sync-chunk-response-envelope-list-v1", {
+            {"response_index", u64_string(index)},
+            {"path", response.path.value},
+            {"request_key", response.request_idempotency_key},
+            {"response_key", response.response_idempotency_key},
+            {"remote_entry_digest", response.remote_entry_digest},
+            {"remote_version_digest", response.remote_version_digest},
+            {"apply_intent_key", response.apply_entry_idempotency_key},
+            {"offset", u64_string(response.offset)},
+            {"length", u64_string(response.length)},
