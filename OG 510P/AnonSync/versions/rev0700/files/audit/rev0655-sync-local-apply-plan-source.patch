+SyncValidationResult validate_plan_entry_shape(const SyncManifestPlanEntry& entry) {
+    NormalizedSyncPath normalized;
+    SyncValidationResult path_result = normalize_sync_relative_path(entry.path.value, normalized);
+    if (!path_result.ok) return fail_result("plan path invalid: " + path_result.reason);
+    if (normalized.value != entry.path.value) return fail_result("plan path is not canonical");
+    if (plan_action_text(entry.action) == "unknown") return fail_result("plan entry has unknown action");
+    if (lineage_relation_text(entry.lineage_relation) == "unknown") return fail_result("plan entry has unknown lineage relation");
+    if (!digest_field_ok_or_empty(entry.local_entry_digest) ||
+        !digest_field_ok_or_empty(entry.remote_entry_digest) ||
+        !digest_field_ok_or_empty(entry.local_version_digest) ||
+        !digest_field_ok_or_empty(entry.remote_version_digest)) {
+        return fail_result("plan entry digest fields must be lowercase sha256 or empty");
+    }
+    if (entry.local_entry_present) {
+        if (entry.local_entry_digest.empty() || entry.local_version_digest.empty()) return fail_result("local plan entry is present without local digest evidence");
+    } else if (!entry.local_entry_digest.empty() || !entry.local_version_digest.empty()) {
+        return fail_result("local plan entry digest evidence exists without presence bit");
+    }
+    if (entry.remote_entry_present) {
+        if (entry.remote_entry_digest.empty() || entry.remote_version_digest.empty()) return fail_result("remote plan entry is present without remote digest evidence");
+    } else if (!entry.remote_entry_digest.empty() || !entry.remote_version_digest.empty()) {
+        return fail_result("remote plan entry digest evidence exists without presence bit");
+    }
+    if (!entry.conflict_set_id.empty() && !valid_sync_id(entry.conflict_set_id)) {
+        return fail_result("plan entry conflict_set_id must be empty or a lowercase portable sync id");
+    }
+    SyncValidationResult chunks_result = validate_needed_chunks(entry.needed_chunks);
+    if (!chunks_result.ok) return chunks_result;
+
+    switch (entry.action) {
+        case SyncPlanAction::Noop:
+            if (!entry.local_entry_present || !entry.remote_entry_present) return fail_result("noop requires both local and remote entries");
+            if (!entry.conflict_set_id.empty() || !entry.needed_chunks.empty()) return fail_result("noop must not carry conflict or chunk work");
+            break;
+        case SyncPlanAction::FetchRemoteFile:
+            if (!entry.remote_entry_present || entry.remote_entry_kind != SyncManifestEntryKind::File) return fail_result("fetch requires a remote file entry");
+            break;
+        case SyncPlanAction::ApplyRemoteTombstone:
+            if (!entry.remote_entry_present || entry.remote_entry_kind != SyncManifestEntryKind::Tombstone) return fail_result("apply tombstone requires a remote tombstone entry");
+            if (!entry.needed_chunks.empty()) return fail_result("apply tombstone must not carry chunk work");
+            break;
+        case SyncPlanAction::PublishLocalFile:
+            if (!entry.local_entry_present || entry.local_entry_kind != SyncManifestEntryKind::File) return fail_result("publish file requires a local file entry");
+            if (!entry.needed_chunks.empty()) return fail_result("publish file must not carry inbound chunk work");
+            break;
+        case SyncPlanAction::PublishLocalTombstone:
+            if (!entry.local_entry_present || entry.local_entry_kind != SyncManifestEntryKind::Tombstone) return fail_result("publish tombstone requires a local tombstone entry");
+            if (!entry.needed_chunks.empty()) return fail_result("publish tombstone must not carry inbound chunk work");
+            break;
+        case SyncPlanAction::RecordConflict:
+            if (!entry.local_entry_present || !entry.remote_entry_present) return fail_result("conflict requires both local and remote entries");
+            if (entry.conflict_set_id.empty()) return fail_result("conflict requires a stable conflict_set_id");
+            if (entry.remote_entry_kind != SyncManifestEntryKind::File && !entry.needed_chunks.empty()) {
+                return fail_result("conflict tombstone must not carry remote chunk work");
+            }
+            break;
+    }
+    return ok_result();
+}
