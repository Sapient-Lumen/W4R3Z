+bool path_is_self_or_inside(const fs::path& base_path, const fs::path& candidate_path) {
+    const fs::path base = base_path.lexically_normal();
+    const fs::path candidate = candidate_path.lexically_normal();
+    auto base_it = base.begin();
+    auto candidate_it = candidate.begin();
+    for (; base_it != base.end(); ++base_it, ++candidate_it) {
+        if (candidate_it == candidate.end() || *base_it != *candidate_it) return false;
+    }
+    return true;
+}
+
+bool path_is_strictly_inside(const fs::path& base_path, const fs::path& candidate_path) {
+    const fs::path base = base_path.lexically_normal();
+    const fs::path candidate = candidate_path.lexically_normal();
+    return base != candidate && path_is_self_or_inside(base, candidate);
+}
