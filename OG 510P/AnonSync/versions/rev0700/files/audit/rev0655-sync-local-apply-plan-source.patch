+void require_existing_directory_not_symlink_or_throw(const fs::path& path, const std::string& label) {
+    std::error_code ec;
+    const fs::file_status link_status = fs::symlink_status(path, ec);
+    if (ec) throw std::invalid_argument(label + " could not be inspected: " + ec.message());
+    if (!fs::exists(link_status)) throw std::invalid_argument(label + " does not exist");
+    if (fs::is_symlink(link_status)) throw std::invalid_argument(label + " must not be a symlink");
+    if (!fs::is_directory(link_status)) throw std::invalid_argument(label + " must be a directory");
+}
+
+void require_existing_path_not_symlink_or_throw(const fs::path& path, const std::string& label) {
