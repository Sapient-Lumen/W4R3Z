+    std::vector<NormalizedSyncPath> drift_paths;
+};
+
+void record_destination_filesystem_drift_path(SyncDestinationFilesystemProbe& probe,
+                                              const NormalizedSyncPath& path) {
+    if (probe.drift_paths.size() >= 128) return;
+    const auto duplicate = std::any_of(probe.drift_paths.begin(), probe.drift_paths.end(), [&](const NormalizedSyncPath& existing) {
+        return existing.value == path.value;
+    });
+    if (!duplicate) probe.drift_paths.push_back(path);
+}
+
+SyncDestinationFilesystemProbe verify_destination_after_filesystem_or_throw(sqlite3* db,
+                                                                            const std::string& session_id,
+                                                                            const fs::path& destination_root,
+                                                                            const std::string& label) {
+    require_existing_directory_not_symlink_or_throw(destination_root, label + " destination root");
+    SyncSqliteStmt stmt = sqlite_prepare_or_throw(db,
+        "SELECT path, kind, size_bytes, content_sha256 "
+        "FROM sync_session_manifest_entries "
+        "WHERE session_id=? AND role='destination_after' ORDER BY path;",
+        label + " destination-after manifest entry scan");
+    sqlite_bind_text_or_throw(stmt.stmt, 1, session_id, label + " session");
+
+    SyncDestinationFilesystemProbe probe;
+    while (true) {
+        const int rc = sqlite3_step(stmt.stmt);
+        if (rc == SQLITE_DONE) break;
+        if (rc != SQLITE_ROW) throw std::runtime_error(label + ": destination-after manifest entry query failed");
+
+        NormalizedSyncPath path;
+        SyncValidationResult path_result = normalize_sync_relative_path(sqlite_column_text_or_throw(stmt.stmt, 0, label + " path"), path);
+        if (!path_result.ok) throw std::runtime_error(label + ": destination-after path is invalid: " + path_result.reason);
+        const std::string kind = sqlite_column_text_or_throw(stmt.stmt, 1, label + " kind");
+        const std::uint64_t expected_size = sqlite_column_u64_or_throw(stmt.stmt, 2, label + " size");
+        const std::string expected_hash = sqlite_column_text_or_throw(stmt.stmt, 3, label + " content hash");
+        if (kind != "file" && kind != "tombstone") {
+            throw std::runtime_error(label + ": destination-after manifest entry kind is not supported");
+        }
+        if (kind == "file" && !is_lowercase_sha256_hex(expected_hash)) {
+            throw std::runtime_error(label + ": destination-after file entry has invalid content hash");
+        }
+        if (kind == "tombstone" && (!expected_hash.empty() || expected_size != 0)) {
+            throw std::runtime_error(label + ": destination-after tombstone entry carries file content evidence");
+        }
+
+        ++probe.entries_checked;
+        const fs::path target = fs::path(resolve_normalized_relative_under_root_or_throw(destination_root, path, label + " destination target path"));
+        require_no_symlink_ancestors_under_root_or_throw(destination_root, target, label + " destination target path");
+
+        std::error_code target_ec;
+        const fs::file_status target_status = fs::symlink_status(target, target_ec);
+        if (target_ec && target_ec != std::errc::no_such_file_or_directory) {
+            throw std::runtime_error(label + ": could not inspect destination target: " + target_ec.message());
+        }
+        const bool target_exists = !target_ec && fs::exists(target_status);
+
+        if (kind == "tombstone") {
+            ++probe.tombstone_entries_checked;
+            if (target_exists) {
+                ++probe.kind_mismatches;
+                record_destination_filesystem_drift_path(probe, path);
+            }
+            continue;
+        }
+
+        ++probe.file_entries_checked;
+        if (!target_exists) {
+            ++probe.missing_paths;
+            record_destination_filesystem_drift_path(probe, path);
+            continue;
+        }
+        if (fs::is_symlink(target_status) || fs::is_directory(target_status) || !fs::is_regular_file(target_status)) {
+            ++probe.kind_mismatches;
+            record_destination_filesystem_drift_path(probe, path);
+            continue;
+        }
+        const FileContentFingerprint actual = hash_existing_regular_file_content_or_throw(target, label + " destination target content");
+        if (actual.size_bytes != expected_size || actual.content_sha256 != expected_hash) {
+            ++probe.content_mismatches;
+            record_destination_filesystem_drift_path(probe, path);
+        }
+    }
+    probe.verified = (probe.missing_paths == 0 &&
+                      probe.kind_mismatches == 0 &&
+                      probe.content_mismatches == 0);
+    return probe;
+}
