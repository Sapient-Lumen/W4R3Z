+std::string convergence_content_digest_for_entry(const SyncManifestEntry& entry) {
+    const std::string material = length_prefixed_security_tuple("anonsync-sync-content-convergence-entry-v1", {
+        {"path", entry.path.value},
+        {"kind", manifest_kind_text(entry.kind)},
+        {"size_bytes", u64_string(entry.size_bytes)},
+        {"content_sha256", entry.content_sha256},
+        {"chunks_digest", digest_chunks(entry.chunks)},
+        {"conflict_set_id", entry.conflict_set_id}
+    });
+    return sha256_hex(material);
+}
