+std::string convergence_content_digest_for_manifest(const SyncFolderManifest& manifest) {
+    std::string material;
+    std::uint64_t index = 0;
+    for (const auto& entry : manifest.entries) {
+        material += length_prefixed_security_tuple("anonsync-sync-content-convergence-manifest-entry-v1", {
+            {"entry_index", u64_string(index)},
+            {"path", entry.path.value},
+            {"content_digest", convergence_content_digest_for_entry(entry)}
+        });
+        ++index;
+    }
+    return sha256_hex(length_prefixed_security_tuple("anonsync-sync-content-convergence-manifest-v1", {
+        {"folder_id", manifest.folder_id},
+        {"entry_count", u64_string(static_cast<std::uint64_t>(manifest.entries.size()))},
+        {"entries", material}
+    }));
+}
