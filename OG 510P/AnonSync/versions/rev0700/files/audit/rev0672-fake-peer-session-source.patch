+                                                                                         "fake peer session source file"));
+    require_no_symlink_ancestors_under_root_or_throw(source_root, source_file, "fake peer session source file");
+    require_existing_path_not_symlink_or_throw(source_file, "fake peer session source file");
+    std::vector<std::string> bytes;
+    bytes.reserve(chunks.size());
+    for (const auto& chunk : chunks) {
