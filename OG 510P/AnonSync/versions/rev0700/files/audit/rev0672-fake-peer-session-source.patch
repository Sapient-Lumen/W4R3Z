+bool manifests_have_same_file_content(const SyncFolderManifest& left, const SyncFolderManifest& right) {
+    if (left.folder_id != right.folder_id) return false;
+    if (left.entries.size() != right.entries.size()) return false;
+    for (size_t i = 0; i < left.entries.size(); ++i) {
+        const auto& a = left.entries[i];
+        const auto& b = right.entries[i];
+        if (a.path.value != b.path.value ||
+            a.kind != b.kind ||
+            a.size_bytes != b.size_bytes ||
+            a.content_sha256 != b.content_sha256 ||
+            a.conflict_set_id != b.conflict_set_id ||
+            a.chunks.size() != b.chunks.size()) {
+            return false;
+        }
+        for (size_t c = 0; c < a.chunks.size(); ++c) {
+            if (!same_chunk_range(a.chunks[c], b.chunks[c])) return false;
+        }
+    }
+    return true;
