+std::string read_file_range_bytes_or_throw(const fs::path& path,
+                                          const SyncChunkRange& chunk,
+                                          const std::string& label) {
+    if (chunk.offset > static_cast<std::uint64_t>(std::numeric_limits<std::streamoff>::max())) {
+        throw std::runtime_error(label + " chunk offset exceeds host stream range");
+    }
+    if (chunk.length > static_cast<std::uint64_t>(std::numeric_limits<std::streamsize>::max())) {
+        throw std::runtime_error(label + " chunk length exceeds host stream range");
+    }
+    if (chunk.length > static_cast<std::uint64_t>(std::numeric_limits<size_t>::max())) {
+        throw std::runtime_error(label + " chunk length exceeds host memory range");
+    }
+
+    std::ifstream in(path, std::ios::binary);
+    if (!in) throw std::runtime_error(label + " could not open source file: " + path.string());
+    in.seekg(static_cast<std::streamoff>(chunk.offset), std::ios::beg);
+    if (!in) throw std::runtime_error(label + " could not seek source chunk");
+
+    std::string bytes(static_cast<size_t>(chunk.length), '\0');
+    if (chunk.length > 0) {
+        in.read(bytes.data(), static_cast<std::streamsize>(chunk.length));
+        if (in.gcount() != static_cast<std::streamsize>(chunk.length)) {
+            throw std::runtime_error(label + " source file ended before requested chunk length");
+        }
+    }
+    if (sha256_hex(bytes) != chunk.sha256) {
+        throw std::runtime_error(label + " source chunk bytes do not match manifest hash");
+    }
+    return bytes;
+}
