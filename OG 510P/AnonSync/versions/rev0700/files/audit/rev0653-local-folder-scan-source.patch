+std::string hex_from_digest(const unsigned char* bytes, unsigned int length) {
+    std::ostringstream out;
+    for (unsigned int i = 0; i < length; ++i) {
+        out << std::hex << std::setw(2) << std::setfill('0') << static_cast<int>(bytes[i]);
+    }
+    return out.str();
+}
