+std::string hash_file_and_build_chunks(const fs::path& file_path, std::uint64_t chunk_size,
+                                       std::uint64_t& size_bytes, std::vector<SyncChunkRange>& chunks) {
+    std::ifstream in(file_path, std::ios::binary);
+    if (!in) throw std::runtime_error("could not open sync file for hashing: " + file_path.string());
+
+    MdCtxPtr content_ctx(EVP_MD_CTX_new());
+    if (!content_ctx || EVP_DigestInit_ex(content_ctx.get(), EVP_sha256(), nullptr) != 1) {
+        throw std::runtime_error("could not initialize sync content digest");
+    }
+
+    std::vector<char> buffer(static_cast<size_t>(chunk_size));
+    size_bytes = 0;
+    chunks.clear();
+
+    while (in) {
+        in.read(buffer.data(), static_cast<std::streamsize>(buffer.size()));
+        const std::streamsize got = in.gcount();
+        if (got <= 0) break;
+        const size_t got_size = static_cast<size_t>(got);
+        if (EVP_DigestUpdate(content_ctx.get(), buffer.data(), got_size) != 1) {
+            throw std::runtime_error("could not update sync content digest");
+        }
+        if (static_cast<std::uint64_t>(got_size) > std::numeric_limits<std::uint64_t>::max() - size_bytes) {
+            throw std::runtime_error("sync file size overflow while hashing");
+        }
+        chunks.push_back(SyncChunkRange{size_bytes, static_cast<std::uint64_t>(got_size),
+                                        sha256_hex(std::string(buffer.data(), got_size))});
+        size_bytes += static_cast<std::uint64_t>(got_size);
+    }
+    if (in.bad()) throw std::runtime_error("could not read sync file while hashing: " + file_path.string());
+
+    unsigned char content_hash[EVP_MAX_MD_SIZE];
+    unsigned int content_hash_len = 0;
+    if (EVP_DigestFinal_ex(content_ctx.get(), content_hash, &content_hash_len) != 1) {
+        throw std::runtime_error("could not finalize sync content digest");
+    }
+    return hex_from_digest(content_hash, content_hash_len);
+}
