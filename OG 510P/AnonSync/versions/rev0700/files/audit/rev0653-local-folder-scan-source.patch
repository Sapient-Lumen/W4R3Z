+
+def assert_manifest() -> None:
+    manifest = json.loads(MANIFEST.read_text())
+    if manifest.get("revision_id") != "rev0653" or manifest.get("parent_revision") != "rev0652":
+        raise AssertionError("rev0653 manifest lineage mismatch")
