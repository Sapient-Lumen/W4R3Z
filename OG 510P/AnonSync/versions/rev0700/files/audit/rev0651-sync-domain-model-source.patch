+#include "anonsync_core.hpp"
+#include "anonsync_core_internal.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <iostream>
+#include <limits>
+#include <sstream>
+#include <stdexcept>
+#include <utility>
+
+namespace anonsync {
+namespace {
+
+SyncValidationResult ok_result() {
+    return {true, ""};
+}
+
+SyncValidationResult fail_result(const std::string& reason) {
+    return {false, reason};
+}
+
+std::string manifest_kind_text(SyncManifestEntryKind kind) {
+    switch (kind) {
+        case SyncManifestEntryKind::File: return "file";
+        case SyncManifestEntryKind::Tombstone: return "tombstone";
+    }
+    return "unknown";
+}
+
+bool ascii_lower_alnum(char c) {
+    return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9');
+}
+
+bool valid_sync_id(const std::string& value) {
+    if (value.empty() || value.size() > 128) return false;
+    if (!ascii_lower_alnum(value.front()) || !ascii_lower_alnum(value.back())) return false;
+    for (unsigned char c : value) {
+        if (ascii_lower_alnum(static_cast<char>(c))) continue;
+        if (c == '.' || c == '_' || c == '-') continue;
+        return false;
+    }
+    return true;
+}
+
+bool reserved_windows_device_name(const std::string& component) {
+    std::string stem;
+    for (unsigned char c : component) {
+        if (c == '.') break;
+        stem.push_back(static_cast<char>(std::toupper(c)));
+    }
+    if (stem == "CON" || stem == "PRN" || stem == "AUX" || stem == "NUL") return true;
+    if (stem.size() == 4 && stem.rfind("COM", 0) == 0 && stem[3] >= '1' && stem[3] <= '9') return true;
+    if (stem.size() == 4 && stem.rfind("LPT", 0) == 0 && stem[3] >= '1' && stem[3] <= '9') return true;
+    return false;
+}
+
+bool disallowed_path_byte(unsigned char c) {
+    if (c <= 0x1f || c == 0x7f) return true;
+    switch (c) {
+        case '\\':
+        case ':':
+        case '*':
+        case '?':
+        case '"':
+        case '<':
+        case '>':
+        case '|':
+            return true;
+        default:
+            return false;
+    }
+}
+
+
+bool valid_utf8(const std::string& input) {
+    size_t i = 0;
+    while (i < input.size()) {
+        const unsigned char c = static_cast<unsigned char>(input[i]);
+        if (c <= 0x7f) {
+            ++i;
+            continue;
+        }
+        size_t need = 0;
+        std::uint32_t codepoint = 0;
+        if ((c & 0xe0) == 0xc0) {
+            need = 1;
+            codepoint = c & 0x1f;
+            if (codepoint == 0) return false;  // overlong ASCII
+        } else if ((c & 0xf0) == 0xe0) {
+            need = 2;
+            codepoint = c & 0x0f;
+        } else if ((c & 0xf8) == 0xf0) {
+            need = 3;
+            codepoint = c & 0x07;
+        } else {
+            return false;
+        }
+        if (i + need >= input.size()) return false;
+        for (size_t j = 1; j <= need; ++j) {
+            const unsigned char cc = static_cast<unsigned char>(input[i + j]);
+            if ((cc & 0xc0) != 0x80) return false;
+            codepoint = (codepoint << 6) | (cc & 0x3f);
+        }
+        if (need == 2 && codepoint < 0x800) return false;
+        if (need == 3 && codepoint < 0x10000) return false;
+        if (codepoint > 0x10ffff) return false;
+        if (codepoint >= 0xd800 && codepoint <= 0xdfff) return false;
+        i += need + 1;
+    }
+    return true;
+}
+
+std::vector<std::string> split_manifest_path(const std::string& path) {
+    std::vector<std::string> parts;
+    std::string current;
+    for (char c : path) {
+        if (c == '/') {
+            parts.push_back(current);
+            current.clear();
+        } else {
+            current.push_back(c);
+        }
+    }
+    parts.push_back(current);
+    return parts;
+}
+
+std::string u64_string(std::uint64_t value) {
+    return std::to_string(value);
+}
+
+std::string digest_chunks(const std::vector<SyncChunkRange>& chunks) {
+    std::string material;
+    for (const auto& chunk : chunks) {
+        material += length_prefixed_security_tuple("anonsync-sync-chunk-v1", {
+            {"offset", u64_string(chunk.offset)},
+            {"length", u64_string(chunk.length)},
+            {"sha256", chunk.sha256}
+        });
+    }
+    return sha256_hex(material);
+}
+
+std::string digest_lineage(const std::vector<SyncVersionLineageEntry>& lineage) {
+    std::string material;
+    for (const auto& entry : lineage) {
+        material += length_prefixed_security_tuple("anonsync-sync-lineage-v1", {
+            {"device_id", entry.device_id},
+            {"counter", u64_string(entry.counter)}
+        });
+    }
+    return sha256_hex(material);
+}
+
+SyncManifestEntry canonical_entry_or_throw(const SyncManifestEntry& entry) {
+    SyncValidationResult validation = validate_sync_manifest_entry(entry);
+    if (!validation.ok) throw std::invalid_argument("invalid sync manifest entry: " + validation.reason);
+    return entry;
+}
+
+}  // namespace
+
+SyncValidationResult normalize_sync_relative_path(const std::string& raw_path, NormalizedSyncPath& out) {
+    out.value.clear();
+    if (raw_path.empty()) return fail_result("sync path is empty");
+    if (raw_path.size() > 4096) return fail_result("sync path exceeds 4096-byte limit");
+    if (!valid_utf8(raw_path)) return fail_result("sync path is not valid UTF-8");
+    if (raw_path.front() == '/') return fail_result("sync path must be relative");
+    if (raw_path.back() == '/') return fail_result("sync path must name an entry, not a directory separator");
+    if (raw_path.size() >= 2 && raw_path[1] == ':') return fail_result("sync path rejects drive-qualified names");
+    for (unsigned char c : raw_path) {
+        if (disallowed_path_byte(c)) return fail_result("sync path contains a disallowed portable filename byte");
+    }
+    std::vector<std::string> parts = split_manifest_path(raw_path);
+    for (const auto& part : parts) {
+        if (part.empty()) return fail_result("sync path contains an empty component");
+        if (part == "." || part == "..") return fail_result("sync path contains a dot segment");
+        if (part.back() == ' ' || part.back() == '.') return fail_result("sync path component has nonportable trailing space or dot");
+        if (reserved_windows_device_name(part)) return fail_result("sync path component is a reserved portable device name");
+    }
+    out.value = raw_path;
+    return ok_result();
+}
+
+SyncValidationResult validate_sync_manifest_entry(const SyncManifestEntry& entry) {
+    if (!valid_sync_id(entry.folder_id)) return fail_result("folder_id must be lowercase portable sync id");
+    if (!valid_sync_id(entry.device_id)) return fail_result("device_id must be lowercase portable sync id");
+
+    NormalizedSyncPath normalized;
+    SyncValidationResult path_result = normalize_sync_relative_path(entry.path.value, normalized);
+    if (!path_result.ok) return path_result;
+    if (normalized.value != entry.path.value) return fail_result("manifest entry path is not canonical");
+
+    if (entry.lineage.empty()) return fail_result("manifest entry requires version lineage");
+    std::string previous_device;
+    for (const auto& lineage : entry.lineage) {
+        if (!valid_sync_id(lineage.device_id)) return fail_result("lineage device_id must be lowercase portable sync id");
+        if (lineage.counter == 0) return fail_result("lineage counter must be positive");
+        if (!previous_device.empty() && lineage.device_id <= previous_device) return fail_result("lineage entries must be unique and sorted by device_id");
+        previous_device = lineage.device_id;
+    }
+
+    if (!entry.conflict_set_id.empty() && !valid_sync_id(entry.conflict_set_id)) {
+        return fail_result("conflict_set_id must be empty or a lowercase portable sync id");
+    }
+
+    if (entry.kind == SyncManifestEntryKind::Tombstone) {
+        if (entry.size_bytes != 0) return fail_result("tombstone size must be zero");
+        if (!entry.content_sha256.empty()) return fail_result("tombstone must not carry content hash");
+        if (!entry.chunks.empty()) return fail_result("tombstone must not carry chunks");
+        return ok_result();
+    }
+
+    if (entry.kind != SyncManifestEntryKind::File) return fail_result("manifest entry has unknown kind");
+    if (!is_lowercase_sha256_hex(entry.content_sha256)) return fail_result("file manifest entry requires lowercase sha256 content hash");
+    if (entry.size_bytes == 0 && !entry.chunks.empty()) return fail_result("zero-byte file must not carry chunks");
+    if (entry.size_bytes > 0 && entry.chunks.empty()) return fail_result("nonempty file requires chunk ranges");
+
+    std::uint64_t expected_offset = 0;
+    for (const auto& chunk : entry.chunks) {
+        if (chunk.offset != expected_offset) return fail_result("chunk ranges must be contiguous from offset zero");
+        if (chunk.length == 0) return fail_result("chunk range length must be positive");
+        if (!is_lowercase_sha256_hex(chunk.sha256)) return fail_result("chunk range requires lowercase sha256 hash");
+        if (chunk.length > std::numeric_limits<std::uint64_t>::max() - expected_offset) return fail_result("chunk ranges overflow uint64");
+        expected_offset += chunk.length;
+    }
+    if (expected_offset != entry.size_bytes) return fail_result("chunk ranges must cover exactly size_bytes");
+    return ok_result();
+}
+
+std::string sync_manifest_entry_digest(const SyncManifestEntry& entry) {
+    SyncManifestEntry canonical = canonical_entry_or_throw(entry);
+    const std::string material = length_prefixed_security_tuple("anonsync-sync-manifest-entry-v1", {
+        {"folder_id", canonical.folder_id},
+        {"device_id", canonical.device_id},
+        {"path", canonical.path.value},
+        {"kind", manifest_kind_text(canonical.kind)},
+        {"size_bytes", u64_string(canonical.size_bytes)},
+        {"content_sha256", canonical.content_sha256},
+        {"chunks_digest", digest_chunks(canonical.chunks)},
+        {"lineage_digest", digest_lineage(canonical.lineage)},
+        {"conflict_set_id", canonical.conflict_set_id}
+    });
+    return sha256_hex(material);
+}
+
+std::string sync_mutation_idempotency_key(const std::string& operation, const SyncManifestEntry& entry) {
+    if (operation != "publish_manifest" &&
+        operation != "reserve_chunk_transfer" &&
+        operation != "commit_file_version" &&
+        operation != "apply_tombstone" &&
+        operation != "record_conflict") {
+        throw std::invalid_argument("unknown sync mutation operation: " + operation);
+    }
+    const std::string entry_digest = sync_manifest_entry_digest(entry);
+    const std::string material = length_prefixed_security_tuple("anonsync-sync-mutation-key-v1", {
+        {"operation", operation},
+        {"manifest_entry_digest", entry_digest}
+    });
+    return "sync:v1:" + sha256_hex(material);
+}
+
