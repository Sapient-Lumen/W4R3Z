+def assert_binary_hash() -> None:
+    sha_log = (ROOT / "audit/logs/rev0696-binary-sha256.txt").read_text().split()[0]
+    if sha_file(ROOT / ACTIVE_BINARY) != sha_log:
+        raise AssertionError("active binary sha256 mismatch")
