+std::vector<SyncChunkRange> select_checkpoint_resume_transfer_chunks_or_throw(const std::vector<SyncChunkRange>& missing_chunks,
+                                                                              std::uint64_t max_chunks,
+                                                                              std::uint64_t max_bytes,
+                                                                              std::uint64_t& selected_bytes_out) {
+    selected_bytes_out = 0;
+    std::vector<SyncChunkRange> selected;
+    for (const auto& chunk : missing_chunks) {
+        if (max_chunks != 0 && selected.size() >= static_cast<size_t>(max_chunks)) break;
+        if (max_bytes != 0) {
+            if (chunk.length > max_bytes && selected.empty()) {
+                throw std::runtime_error("sync session checkpoint resume transfer byte budget is smaller than the first missing chunk");
+            }
+            if (chunk.length > std::numeric_limits<std::uint64_t>::max() - selected_bytes_out) {
+                throw std::runtime_error("sync session checkpoint resume transfer selected byte count overflow");
+            }
+            if (selected_bytes_out + chunk.length > max_bytes) break;
+        } else if (chunk.length > std::numeric_limits<std::uint64_t>::max() - selected_bytes_out) {
+            throw std::runtime_error("sync session checkpoint resume transfer selected byte count overflow");
+        }
+        selected.push_back(chunk);
+        selected_bytes_out += chunk.length;
+    }
+    if (selected.empty() && !missing_chunks.empty()) {
+        throw std::runtime_error("sync session checkpoint resume transfer selector produced no work for a non-empty missing chunk set");
+    }
+    return selected;
+}
