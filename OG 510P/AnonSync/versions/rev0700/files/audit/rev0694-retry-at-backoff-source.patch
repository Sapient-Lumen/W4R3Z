+std::uint64_t compute_resume_transfer_workorder_retry_at_or_throw(std::uint64_t lease_expires_at_epoch,
+                                                                  std::uint64_t claim_attempt,
+                                                                  std::uint64_t retry_backoff_seconds,
+                                                                  const std::string& context) {
+    if (claim_attempt == 0) {
+        throw std::runtime_error(context + " transfer workorder retry schedule requires a positive claim attempt");
+    }
+    if (retry_backoff_seconds != 0 && claim_attempt > std::numeric_limits<std::uint64_t>::max() / retry_backoff_seconds) {
+        throw std::runtime_error(context + " transfer workorder retry schedule backoff would overflow");
+    }
+    const std::uint64_t retry_delay = retry_backoff_seconds * claim_attempt;
+    if (lease_expires_at_epoch > std::numeric_limits<std::uint64_t>::max() - retry_delay) {
+        throw std::runtime_error(context + " transfer workorder retry_at_epoch would overflow");
+    }
+    return lease_expires_at_epoch + retry_delay;
+}
