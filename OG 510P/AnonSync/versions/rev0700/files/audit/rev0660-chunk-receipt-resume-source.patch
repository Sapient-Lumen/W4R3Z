+std::string read_file_range_and_hash_or_throw(const fs::path& path, const SyncChunkRange& chunk) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) throw std::runtime_error("could not open staged sync file chunk for verification: " + path.string());
+    in.seekg(static_cast<std::streamoff>(chunk.offset), std::ios::beg);
+    if (!in) throw std::runtime_error("could not seek staged sync file chunk for verification");
+
+    MdCtxPtr chunk_ctx(EVP_MD_CTX_new());
+    if (!chunk_ctx || EVP_DigestInit_ex(chunk_ctx.get(), EVP_sha256(), nullptr) != 1) {
+        throw std::runtime_error("could not initialize staged sync chunk receipt digest");
+    }
+
+    std::array<char, 64 * 1024> buffer{};
+    std::uint64_t remaining = chunk.length;
+    while (remaining > 0) {
+        const size_t want = static_cast<size_t>(std::min<std::uint64_t>(remaining, buffer.size()));
+        in.read(buffer.data(), static_cast<std::streamsize>(want));
+        const std::streamsize got = in.gcount();
+        if (got <= 0) throw std::runtime_error("staged sync file chunk ended before receipt length");
+        const size_t got_size = static_cast<size_t>(got);
+        if (EVP_DigestUpdate(chunk_ctx.get(), buffer.data(), got_size) != 1) {
+            throw std::runtime_error("could not update staged sync chunk receipt digest");
+        }
+        remaining -= static_cast<std::uint64_t>(got_size);
+    }
+
+    unsigned char chunk_hash[EVP_MAX_MD_SIZE];
+    unsigned int chunk_hash_len = 0;
+    if (EVP_DigestFinal_ex(chunk_ctx.get(), chunk_hash, &chunk_hash_len) != 1) {
+        throw std::runtime_error("could not finalize staged sync chunk receipt digest");
+    }
+    return hex_from_digest(chunk_hash, chunk_hash_len);
+}
+
+void write_staged_chunk_bytes_or_throw(const fs::path& path, const SyncChunkRange& chunk, const std::string& chunk_bytes) {
+    if (chunk.length != static_cast<std::uint64_t>(chunk_bytes.size())) {
+        throw std::runtime_error("staged sync chunk byte length mismatch");
+    }
+    fs::create_directories(path.parent_path());
+    {
+        std::fstream io(path, std::ios::in | std::ios::out | std::ios::binary);
+        if (!io) {
+            std::ofstream create(path, std::ios::binary);
+            if (!create) throw std::runtime_error("could not create staged sync file for chunk write: " + path.string());
+            create.close();
+            io.open(path, std::ios::in | std::ios::out | std::ios::binary);
+        }
+        if (!io) throw std::runtime_error("could not open staged sync file for chunk write: " + path.string());
+        io.seekp(static_cast<std::streamoff>(chunk.offset), std::ios::beg);
+        if (!io) throw std::runtime_error("could not seek staged sync file for chunk write");
+        io.write(chunk_bytes.data(), static_cast<std::streamsize>(chunk_bytes.size()));
+        if (!io) throw std::runtime_error("could not write staged sync chunk bytes");
+        io.flush();
+        if (!io) throw std::runtime_error("could not flush staged sync chunk bytes");
+    }
+    fsync_file_if_supported_or_throw(path, "staged sync chunk write file");
+}
+
+void write_receipt_file_atomically_or_throw(const fs::path& receipt_path, const std::string& receipt_text) {
+    fs::create_directories(receipt_path.parent_path());
+    const fs::path tmp_path = receipt_path.string() + ".tmp-" + sha256_hex(receipt_text).substr(0, 16);
+    {
+        std::ofstream out(tmp_path, std::ios::binary | std::ios::trunc);
+        if (!out) throw std::runtime_error("could not create staged sync chunk receipt temp file: " + tmp_path.string());
+        out.write(receipt_text.data(), static_cast<std::streamsize>(receipt_text.size()));
+        if (!out) throw std::runtime_error("could not write staged sync chunk receipt temp file: " + tmp_path.string());
+        out.flush();
+        if (!out) throw std::runtime_error("could not flush staged sync chunk receipt temp file: " + tmp_path.string());
+    }
+    fsync_file_if_supported_or_throw(tmp_path, "staged sync chunk receipt temp file");
+    std::error_code ec;
+    fs::rename(tmp_path, receipt_path, ec);
+    if (ec) {
+        std::error_code cleanup_ec;
+        fs::remove(tmp_path, cleanup_ec);
+        throw std::runtime_error("could not atomically install staged sync chunk receipt: " + ec.message());
+    }
+    fsync_directory_if_supported_or_throw(receipt_path.parent_path(), "staged sync chunk receipt directory");
+}
