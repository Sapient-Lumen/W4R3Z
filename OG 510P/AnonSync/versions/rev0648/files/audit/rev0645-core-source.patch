+def assert_post_preflight_ledger_failure_visible(tmp: pathlib.Path, sender_key: pathlib.Path, public_jwk: Dict[str, str]) -> None:
+    label = "post-preflight-ledger-failure"
+    ledger_directory = tmp / f"{label}.ledger-directory"
+    ledger_directory.mkdir()
+    profile, profile_sha = make_profile(tmp, ledger=ledger_directory, handle=label)
+    service_id = f"svc-{label}"
+    service, service_sha = make_service(
+        tmp,
+        profile=profile,
+        profile_sha=profile_sha,
+        public_jwk=public_jwk,
+        service_id=service_id,
+    )
+    context_obj = default_context()
+    context = make_context(tmp, label)
+    request = make_signed_request(
+        tmp,
+        label=label,
+        handle=label,
+        sender_key=sender_key,
+        service_id=service_id,
+        service_sha=service_sha,
+        profile_sha=profile_sha,
+        cache_instance_id=f"{service_id}-cache-instance",
+        context=context_obj,
+    )
+    report_path = tmp / f"{label}.report.json"
+    cp = run_service(service, service_sha, context, request, report_path)
+    if cp.returncode == 0:
+        raise AssertionError("actual-ledger failure unexpectedly succeeded")
+    report = json.loads(report_path.read_text())
+    service_report = report.get("service", {})
+    boundary = report.get("service_boundary", {})
+    if service_report.get("sender_possession_verified") is not True or service_report.get("sender_replay_cache_reserved") is not True:
+        raise AssertionError("post-preflight failure report did not expose the consumed sender nonce")
+    if boundary.get("post_preflight_crash_or_ledger_failure_can_consume_sender_nonce") is not True:
+        raise AssertionError("report did not disclose the remaining post-preflight dual-write seam")
+    if boundary.get("sender_replay_cache_and_ledger_share_one_transaction") is not False:
+        raise AssertionError("failure report concealed the dual-write transaction seam")
+    if sender_replay_row_count(service) != 1:
+        raise AssertionError("post-preflight actual-ledger failure did not leave exactly one replay-cache row")
