+        "accumulator_api_is_small_and_explicit",
+        "only zero, add, and subtract are public",
+    )
+    require(
+        "using Words = std::array<std::uint64_t, 4U>;" in acc_c
+        and "parse_words_or_throw" in acc_c
+        and "encode_words" in acc_c
+        and "carry" in acc_c
+        and "borrow" in acc_c,
