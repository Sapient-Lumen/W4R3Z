+[[nodiscard]] std::string hash_exact_regular_file_descriptor_or_throw(
+    int descriptor,
+    const struct stat& expected_observation,
+    const std::string& label) {
+    if (descriptor < 0 || !S_ISREG(expected_observation.st_mode) ||
+        expected_observation.st_size < 0) {
+        throw std::invalid_argument(
+            label + " requires one valid regular-file observation");
+    }
+    const std::uint64_t expected_size =
+        static_cast<std::uint64_t>(expected_observation.st_size);
+    if (expected_size >
+        static_cast<std::uint64_t>(std::numeric_limits<off_t>::max())) {
+        throw std::length_error(
+            label + " file exceeds positional I/O extent");
+    }
+
+    struct stat before {};
+    if (::fstat(descriptor, &before) != 0) {
+        const int error = errno;
+        throw std::runtime_error(
+            label + " initial fstat failed: " + system_error_text(error));
+    }
+    if (!same_regular_file_stat_observation(
+            expected_observation, before)) {
+        throw std::runtime_error(
+            label + " file changed before its exact byte proof");
+    }
+
+    Sha256DigestBuilder digest;
+    std::array<char, 256U * 1024U> buffer{};
+    std::uint64_t position = 0U;
+    while (position < expected_size) {
+        const std::size_t requested = static_cast<std::size_t>(
+            std::min<std::uint64_t>(
+                expected_size - position, buffer.size()));
+        ssize_t read_count;
+        do {
+            read_count = ::pread(
+                descriptor, buffer.data(), requested,
+                static_cast<off_t>(position));
+        } while (read_count < 0 && errno == EINTR);
+        if (read_count < 0) {
+            const int error = errno;
+            throw std::runtime_error(
+                label + " read failed: " + system_error_text(error));
+        }
+        if (read_count == 0) {
+            throw std::runtime_error(
+                label + " file became truncated during exact byte proof");
+        }
+        const std::uint64_t got =
+            static_cast<std::uint64_t>(read_count);
+        if (got > expected_size - position) {
+            throw std::runtime_error(
+                label + " read crossed the exact file extent");
+        }
+        digest.update(std::string_view(
+            buffer.data(), static_cast<std::size_t>(read_count)));
+        position += got;
+    }
+
+    struct stat after {};
+    if (::fstat(descriptor, &after) != 0) {
+        const int error = errno;
+        throw std::runtime_error(
+            label + " final fstat failed: " + system_error_text(error));
+    }
+    if (!same_regular_file_stat_observation(before, after)) {
+        throw std::runtime_error(
+            label + " file changed during its exact byte proof");
+    }
+    return digest.finish_hex();
+}
