+parse_payload_quarantine_request(std::string_view request) {
+    constexpr std::size_t kDigestCharacters = 64U;
+    constexpr std::size_t kExactBytes =
+        kQuarantineRequestPrefix.size() + kDigestCharacters + 1U +
+        kDigestCharacters + 1U;
