+    TerminalCutpointFenceTrace trace{&competing_owner};
+    require(
+        sqlite3_trace_v2(
+            catalog_db.db.get(), SQLITE_TRACE_STMT,
+            probe_terminal_cutpoint_fence, &trace) == SQLITE_OK,
