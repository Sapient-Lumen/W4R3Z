+    for (std::size_t index = 0U; index < 3U; ++index) {
+        const auto staged = stale_owner.
+            stage_payload_prefix_deferring_terminal_verification_or_throw(
+                digests[index], payloads[index].size(), 0U,
+                digests[index], payloads[index]);
+        require(
+            staged.disposition ==
