+    sqlite_bind_u64_or_throw(
+        update.stmt, 7, current.seen_path_bytes, label);
+    sqlite_bind_text_or_throw(
+        update.stmt, 8, current.resume_after_path, label);
+    sqlite_bind_text_or_throw(
