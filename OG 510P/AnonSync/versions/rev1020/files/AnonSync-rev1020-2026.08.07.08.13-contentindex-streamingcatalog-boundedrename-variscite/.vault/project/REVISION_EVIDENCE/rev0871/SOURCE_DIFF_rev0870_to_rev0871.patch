+                       intent.destination_device_id, intent.operation_id} <
+                   candidate;
+        });
+    if (found == outbox.end() ||
+        found->destination_device_id != destination_device_id ||
+        found->operation_id != operation_id) {
+        return outbox.end();
+    }
+    return found;
