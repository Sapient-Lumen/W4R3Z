+        [&](const auto& target_chunk) {
+            return std::any_of(
+                decoy_manifest.chunks.begin(), decoy_manifest.chunks.end(),
+                [&](const auto& decoy_chunk) {
+                    return decoy_chunk.sha256 == target_chunk.sha256 &&
