+#if !defined(_WIN32)
+
+#include "sync_directory_authority.hpp"
+#include "sync_posix_directory_resolution.hpp"
+
+#include <cerrno>
+#include <chrono>
+#include <cstdint>
+#include <filesystem>
+#include <iostream>
+#include <stdexcept>
+#include <string>
