+// Dispatches one already-prepared file-delivery frame over the exact live TLS
+// channel to which it is canonically bound.  The function first freezes and
+// re-encodes the bounded outbound value outside SQLite, then reacquires the
+// exact outbox claim under BEGIN IMMEDIATE.  While that guard excludes every
+// competing outbox writer it re-proves channel liveness and writes only the
+// complete 8-byte encrypted record-length prefix.  The guard commits before
+// the potentially large frame body is written.
+//
+// A failure before the complete prefix is accepted poisons the stream and
+// releases the exact claim into the service-owned retry schedule.  Once the
+// prefix is accepted, any commit or body failure is intentionally ambiguous:
+// the stream is poisoned but the claim remains live until a terminal receipt,
+// explicit exact release, or owned-clock expiry.  Prefix acceptance is
+// transport progress, never proof that the peer received or admitted a frame.
+// This composition requires direct socket TLS read/write BIOs whose kernel
+// descriptors have O_NONBLOCK; filtered, blocking, non-socket, or unobservable
+// BIO readiness fails before stream I/O.
+void dispatch_sync_replica_outbound_file_delivery_over_tls_or_throw(
+    SyncReplicaFileDeliveryService& service,
+    const SyncReplicaTlsAuthenticatedChannel& channel,
+    const SyncReplicaOutboundFileDelivery& outbound,
+    const std::string& label = "sync replica file TLS dispatch");
+
+// Claims, resolves, and canonically prepares at most one File operation through
+// SyncReplicaFileDeliveryService, then immediately enters the dispatch frontier
+// above.  The returned value is the exact frame/claim identity sent or left
+// ambiguous; it is retained by the caller for receipt validation.  No value is
+// returned when no matching outbox intent is ready.
+[[nodiscard]] std::optional<SyncReplicaOutboundFileDelivery>
+claim_and_dispatch_next_file_delivery_over_tls_or_throw(
+    SyncReplicaFileDeliveryService& service,
+    const SyncReplicaTlsAuthenticatedChannel& channel,
+    std::string worker_id,
+    std::uint64_t lease_seconds,
+    const SyncReplicaFilePayloadSource& payload_source,
+    const std::string& label = "sync replica file TLS claim-and-dispatch");
+
+}  // namespace anonsync
