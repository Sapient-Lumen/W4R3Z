+void require_nonblocking_socket_or_throw(
+    SSL* ssl,
+    const std::string& label) {
+#ifdef __unix__
+    BIO* const read_bio = SSL_get_rbio(ssl);
+    BIO* const write_bio = SSL_get_wbio(ssl);
+    if (read_bio == nullptr || write_bio == nullptr ||
+        BIO_method_type(read_bio) != BIO_TYPE_SOCKET ||
+        BIO_method_type(write_bio) != BIO_TYPE_SOCKET) {
+        throw std::invalid_argument(
+            label +
+            " requires direct socket TLS read and write BIOs for bounded readiness");
+    }
+
+    const int read_descriptor = SSL_get_rfd(ssl);
+    const int write_descriptor = SSL_get_wfd(ssl);
+    if (read_descriptor < 0 || write_descriptor < 0) {
+        throw std::invalid_argument(
+            label +
+            " requires observable TLS read and write socket descriptors");
+    }
+    const auto require_descriptor = [&](int descriptor,
+                                        std::string_view direction) {
+        int socket_type = 0;
+        socklen_t socket_type_bytes = sizeof(socket_type);
+        errno = 0;
+        if (::getsockopt(
+                descriptor, SOL_SOCKET, SO_TYPE,
+                &socket_type, &socket_type_bytes) != 0 ||
+            socket_type_bytes != sizeof(socket_type)) {
+            throw std::invalid_argument(
+                label + " requires a socket-backed TLS " +
+                std::string(direction) + " descriptor (errno " +
+                std::to_string(errno) + ")");
+        }
+
+        errno = 0;
+        const int flags = ::fcntl(descriptor, F_GETFL, 0);
+        if (flags < 0) {
+            throw std::runtime_error(
+                label + " could not inspect TLS " + std::string(direction) +
+                " descriptor flags (errno " + std::to_string(errno) + ")");
+        }
+        if ((flags & O_NONBLOCK) == 0) {
+            throw std::invalid_argument(
+                label + " requires a nonblocking TLS " +
+                std::string(direction) + " descriptor");
+        }
+    };
+    require_descriptor(read_descriptor, "read");
+    if (write_descriptor != read_descriptor) {
+        require_descriptor(write_descriptor, "write");
+    }
