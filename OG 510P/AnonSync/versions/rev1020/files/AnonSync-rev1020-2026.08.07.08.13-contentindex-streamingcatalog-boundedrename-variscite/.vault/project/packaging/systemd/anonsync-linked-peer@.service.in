[Unit]
Description=AnonSync linked peer %i

[Service]
Type=notify
NotifyAccess=main
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/anonsync_sync run --config %h/.config/anonsync/linked-peers/%i.json
RuntimeDirectory=anonsync-%i
RuntimeDirectoryMode=0700
KillSignal=SIGTERM
TimeoutStartSec=infinity
TimeoutStopSec=@ANONSYNC_INSTALLED_SERVICE_STOP_TIMEOUT_SECONDS@s
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
