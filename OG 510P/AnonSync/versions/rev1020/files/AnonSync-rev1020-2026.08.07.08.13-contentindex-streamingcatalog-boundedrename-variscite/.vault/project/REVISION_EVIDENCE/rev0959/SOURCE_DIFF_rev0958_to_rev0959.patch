+    require(
+        rebuilt.disposition ==
+                anonsync::SyncReplicaFilePayloadScrubStateDisposition::Idle &&
+            rebuilt.active_content_sha256.empty(),
+        "minimum-reader migration did not bind canonical state to the renamed identity");
