+void test_database_incarnation_and_explicit_recovery_epoch() {
+    TempDatabasePath first_file("anonsync-replica-sqlite-lineage-first");
+    TempDatabasePath second_file("anonsync-replica-sqlite-lineage-second");
+    const std::string folder = "folder-sqlite-database-lineage";
+    const SyncReplicaActor local = actor("device-sqlite-database-lineage", 989U);
+    const SyncReplicaSqliteOwnerLimits owner_limits = limits(16U, 8U, 256U);
+
+    SyncReplicaSqliteSnapshot first;
+    SyncReplicaSqliteSnapshot second;
+    {
+        SyncSqliteDb first_db = open_database(first_file.path);
+        SyncSqliteDb second_db = open_database(second_file.path);
+        SyncReplicaSqliteOwner first_owner(
+            first_db.db, folder, local, owner_limits, "first lineage owner");
+        SyncReplicaSqliteOwner second_owner(
+            second_db.db, folder, local, owner_limits, "second lineage owner");
+        first = first_owner.snapshot_or_throw();
+        second = second_owner.snapshot_or_throw();
+    }
+    require(
+        first.durable == second.durable && first.limits == second.limits &&
+            first.state_generation == second.state_generation &&
+            first.policy_generation == second.policy_generation &&
+            first.operation_set_digest == second.operation_set_digest &&
+            first.evidence_set_digest == second.evidence_set_digest &&
+            first.visible_state_digest == second.visible_state_digest &&
+            first.outbox_digest == second.outbox_digest &&
+            first.historical_version_pin_set_digest ==
+                second.historical_version_pin_set_digest &&
+            first.database_recovery_epoch == 1U &&
+            second.database_recovery_epoch == 1U,
+        "independent empty databases did not begin with identical causal authority");
+    require(
+        anonsync::is_lowercase_sha256_hex(
+            first.database_incarnation_sha256) &&
+            anonsync::is_lowercase_sha256_hex(
+                second.database_incarnation_sha256) &&
+            first.database_incarnation_sha256 !=
+                second.database_incarnation_sha256 &&
+            first.cutpoint_digest != second.cutpoint_digest,
+        "independent identical databases aliased one incarnation or cutpoint");
+
+    SyncReplicaSqliteSnapshot recovered;
+    {
+        SyncSqliteDb db = open_database(first_file.path);
+        SyncReplicaSqliteOwner owner(
+            db.db, folder, local, owner_limits, "database recovery owner");
+        const SyncReplicaSqliteSnapshot baseline = owner.snapshot_or_throw();
+        require_error(
+            [&] {
+                (void)owner.advance_database_recovery_epoch_or_throw(
+                    std::string(64U, '0'), baseline.database_recovery_epoch,
+                    baseline.cutpoint_digest);
+            },
+            "expectation is stale",
+            "foreign database incarnation advanced the recovery epoch");
+        require_error(
+            [&] {
+                (void)owner.advance_database_recovery_epoch_or_throw(
+                    baseline.database_incarnation_sha256,
+                    baseline.database_recovery_epoch + 1U,
+                    baseline.cutpoint_digest);
+            },
+            "expectation is stale",
+            "stale database recovery epoch advanced the recovery epoch");
+        require_error(
+            [&] {
+                (void)owner.advance_database_recovery_epoch_or_throw(
+                    baseline.database_incarnation_sha256,
+                    baseline.database_recovery_epoch,
+                    std::string(64U, '0'));
+            },
+            "expectation is stale",
+            "stale database cutpoint advanced the recovery epoch");
+        require(
+            owner.snapshot_or_throw() == baseline,
+            "rejected database recovery expectation changed durable state");
+
+        const auto result = owner.advance_database_recovery_epoch_or_throw(
+            baseline.database_incarnation_sha256,
+            baseline.database_recovery_epoch,
+            baseline.cutpoint_digest);
+        recovered = owner.snapshot_or_throw();
+        require(
+            result.database_incarnation_sha256 ==
+                    baseline.database_incarnation_sha256 &&
+                result.previous_database_recovery_epoch == 1U &&
+                result.database_recovery_epoch == 2U &&
+                result.state_generation == baseline.state_generation + 1U &&
+                result.cutpoint_digest == recovered.cutpoint_digest,
+            "database recovery transition returned the wrong exact cutpoint");
+        require(
+            recovered.database_incarnation_sha256 ==
+                    baseline.database_incarnation_sha256 &&
+                recovered.database_recovery_epoch == 2U &&
+                recovered.state_generation == baseline.state_generation + 1U &&
+                recovered.policy_generation == baseline.policy_generation &&
+                recovered.durable == baseline.durable &&
+                recovered.limits == baseline.limits &&
+                recovered.outbox == baseline.outbox &&
+                recovered.outbox_clock_state == baseline.outbox_clock_state &&
+                recovered.operation_set_digest == baseline.operation_set_digest &&
+                recovered.evidence_set_digest == baseline.evidence_set_digest &&
+                recovered.visible_state_digest == baseline.visible_state_digest &&
+                recovered.outbox_digest == baseline.outbox_digest &&
+                recovered.historical_version_pins ==
+                    baseline.historical_version_pins &&
+                recovered.historical_version_pin_set_digest ==
+                    baseline.historical_version_pin_set_digest &&
+                recovered.cutpoint_digest != baseline.cutpoint_digest,
+            "database recovery transition changed causal authority or failed to invalidate the cutpoint");
+    }
+
+    {
+        SyncSqliteDb db = open_database(first_file.path);
+        SyncReplicaSqliteOwner restarted(
+            db.db, folder, local, owner_limits, "database recovery restart owner");
+        require(
+            restarted.snapshot_or_throw() == recovered,
+            "restart lost the explicit database recovery epoch");
+    }
 }
 
