+        and "sqlite3_set_authorizer" in text["authorizer"],
+        "sqlite_authorizer_callback_is_typed_as_c_abi_policy_hook",
+        "the database authorizer is distinguished from application std::function seams",
+    )
+
+    runtime_tokens = (
