+    SyncReplicaFileEffectState state) noexcept {
+    switch (state) {
+        case SyncReplicaFileEffectState::Staged:
+            return "staged";
+        case SyncReplicaFileEffectState::Published:
+            return "published";
+    }
+    return "unknown";
+}
