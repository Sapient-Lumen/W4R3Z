+class SyncPreparedImmutableJsonPublication::Impl final {
+public:
+    std::filesystem::path final_path;
+    std::filesystem::path parent;
+    std::string final_basename;
+    std::string payload;
+    std::string label;
+    SyncSqliteProcessId owner_process_incarnation = 0;
