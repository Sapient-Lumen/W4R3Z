+// A move-only, single-use authority for publishing immutable JSON to one exact
+// destination. Construction resolves the path, proves the final name absent,
+// and, on POSIX, retains the verified parent-directory descriptor across any
+// intervening durable transition. The payload bytes and label are owned by the
+// capability, so later publication cannot observe caller mutation.
+//
+// This is deliberately not a cross-resource transaction: another writer may
+// still create the final name, and directory durability may still fail after
+// the no-replace namespace transition. Those effects are reported through
+// SyncAtomicFilePublicationError. A parent-path rebind detected before temp
+// reservation is NotPublished with no possible temp residue. Inherited use
+// after fork is rejected before filesystem mutation.
+class SyncPreparedImmutableJsonPublication final {
+public:
+    SyncPreparedImmutableJsonPublication() noexcept;
+    SyncPreparedImmutableJsonPublication(
+        SyncPreparedImmutableJsonPublication&&) noexcept;
+    SyncPreparedImmutableJsonPublication& operator=(
+        SyncPreparedImmutableJsonPublication&&) noexcept;
+    SyncPreparedImmutableJsonPublication(
+        const SyncPreparedImmutableJsonPublication&) = delete;
+    SyncPreparedImmutableJsonPublication& operator=(
+        const SyncPreparedImmutableJsonPublication&) = delete;
+    ~SyncPreparedImmutableJsonPublication();
+
+    [[nodiscard]] bool valid() const noexcept;
+
+    // Consumes this capability exactly once. A second call is a typed
+    // NotPublished error and never reuses stale parent or pathname evidence.
+    void publish_or_throw();
+
+private:
+    class Impl;
+    explicit SyncPreparedImmutableJsonPublication(
+        std::unique_ptr<Impl> implementation) noexcept;
+
+    std::unique_ptr<Impl> implementation_;
+
+    friend SyncPreparedImmutableJsonPublication
+    prepare_sync_json_file_atomically_create_new_no_symlink_or_throw(
+        const std::filesystem::path& final_path,
+        std::string payload,
+        const std::string& label);
+};
+
+// Prepares immutable JSON publication before an irreversible transition. The
+// returned capability owns the exact payload and, on POSIX, the exact verified
+// destination parent. No temp file or final entry is created until
+// publish_or_throw() is called.
+[[nodiscard]] SyncPreparedImmutableJsonPublication
+prepare_sync_json_file_atomically_create_new_no_symlink_or_throw(
+    const std::filesystem::path& final_path,
+    std::string payload,
+    const std::string& label);
+
 // Publishes one complete payload by creating a writer-owned file in the
 // destination directory, syncing it, atomically replacing the final directory
 // entry, and then syncing the directory. Existing symbolic links and
@@ -110,10 +166,18 @@ void write_sync_cli_report_json_or_throw(
     const std::string& payload,
     const std::string& label);
 
-// CLI wrapper for immutable evidence. Callers should preflight before an
-// irreversible transition, then use this create-new operation afterwards. A
-// race after preflight is reported as NotPublished and never replaces the
-// competing entry.
+// CLI wrapper for the move-only prepared capability. The caller should build
+// this object before an irreversible transition and invoke publish_or_throw()
+// only after the durable outcome is known.
+[[nodiscard]] SyncPreparedImmutableJsonPublication
+prepare_sync_cli_immutable_json_create_new_or_throw(
+    const std::string& output_path,
+    std::string payload,
+    const std::string& label);
