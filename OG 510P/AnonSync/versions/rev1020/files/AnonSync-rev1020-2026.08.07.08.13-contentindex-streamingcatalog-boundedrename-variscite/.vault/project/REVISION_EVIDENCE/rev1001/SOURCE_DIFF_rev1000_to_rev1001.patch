+            if (static_cast<std::uint64_t>(got) > remaining) {
+                throw std::runtime_error(
+                    label +
+                    " bounded content-defined read crossed its exact step extent");
+            }
+            progress.accumulator.consume_or_throw(
+                std::string_view(buffer.data(), got), label);
