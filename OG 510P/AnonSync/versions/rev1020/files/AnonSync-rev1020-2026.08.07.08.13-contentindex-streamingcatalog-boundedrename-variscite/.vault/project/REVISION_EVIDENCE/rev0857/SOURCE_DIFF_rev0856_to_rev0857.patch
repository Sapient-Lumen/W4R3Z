+            "src/sync_manifest_identity.hpp",
+            "src/sync_manifest_identity.cpp",
+            "tests/sync_manifest_identity_test.cpp",
+            "tests/sync_manifest_hash_locale_test.cpp",
+            "tools/audit_sync_manifest_identity.py",
