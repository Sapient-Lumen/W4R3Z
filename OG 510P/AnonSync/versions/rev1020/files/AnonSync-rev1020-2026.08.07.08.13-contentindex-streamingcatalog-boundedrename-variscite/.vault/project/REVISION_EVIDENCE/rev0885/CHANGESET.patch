+
+    anonsync::reprove_sync_nonblocking_socket_identity_or_throw(
+        primary_identity, "unchanged socket");
+    test.require(true, "unchanged socket lifetime reproves");
+
+    SocketPair independent = make_nonblocking_socket_pair();
+    const auto independent_identity =
+        anonsync::observe_sync_nonblocking_socket_identity_or_throw(
+            independent.left.get(), "independent socket");
+    test.require(
+        independent_identity != primary_identity,
+        "independent sockets cannot share readiness identity");
+
+    set_nonblocking(primary.left.get(), false);
+    require_throws_containing(
+        test,
+        [&] {
+            anonsync::reprove_sync_nonblocking_socket_identity_or_throw(
+                primary_identity, "blocking socket");
+        },
+        "is not nonblocking",
+        "reproof rejects loss of O_NONBLOCK");
+    set_nonblocking(primary.left.get(), true);
+    anonsync::reprove_sync_nonblocking_socket_identity_or_throw(
+        primary_identity, "restored socket");
+    test.require(true, "restoring O_NONBLOCK preserves the same socket lifetime");
+
+    SocketPair replacement = make_nonblocking_socket_pair();
+    if (::dup2(replacement.left.get(), primary.left.get()) < 0) {
+        throw std::runtime_error("socket identity test could not perform descriptor ABA");
+    }
+    require_throws_containing(
+        test,
+        [&] {
+            anonsync::reprove_sync_nonblocking_socket_identity_or_throw(
