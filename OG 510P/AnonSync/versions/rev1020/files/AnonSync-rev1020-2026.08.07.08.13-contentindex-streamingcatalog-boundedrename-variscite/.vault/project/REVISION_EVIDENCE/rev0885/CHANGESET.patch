diff --git a/tools/audit_sync_socket_readiness_identity.py b/tools/audit_sync_socket_readiness_identity.py
new file mode 100755
index 0000000000000000000000000000000000000000..8aa74dd404bc72acbcdace741adf137cd1346bd5
--- /dev/null
+++ b/tools/audit_sync_socket_readiness_identity.py
@@ -0,0 +1,537 @@
+#!/usr/bin/env python3
+"""Lexical hygiene audit for exact nonblocking socket-lifetime reproof.
+
+This inventory checks reviewed source shape. It does not prove Linux socket
+cookie uniqueness, absence of descriptor races, OpenSSL retry semantics,
+pointer stability, machine-code behavior, or end-to-end delivery correctness.
+Compiled tests, sanitizers, stress runs, and manual review remain load-bearing.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from dataclasses import asdict, dataclass
+from pathlib import Path
+
+
+REQUIRED = (
+    Path("CMakeLists.txt"),
+    Path("src/sync_socket_readiness_identity.hpp"),
+    Path("src/sync_socket_readiness_identity.cpp"),
+    Path("tests/sync_socket_readiness_identity_test.cpp"),
+    Path("src/sync_replica_tls_transport.hpp"),
+    Path("src/sync_replica_tls_transport.cpp"),
+    Path("tests/sync_replica_tls_transport_test.cpp"),
+    Path("tools/audit_sync_socket_readiness_identity.py"),
+    Path("tools/verify_release_package.py"),
+    Path("TLS_SOCKET_LIFETIME_AUTHORITY_AUDIT_rev0885.md"),
+)
+
+
+@dataclass(frozen=True)
+class Check:
+    check_id: str
+    passed: bool
+    detail: str
+
+
+def ordered(text: str, *tokens: str) -> bool:
+    cursor = -1
+    for token in tokens:
+        cursor = text.find(token, cursor + 1)
+        if cursor < 0:
+            return False
+    return True
+
+
+def delimited_body(text: str, signature: str) -> str:
+    start = text.find(signature)
+    if start < 0:
+        return ""
+    brace = text.find("{", start + len(signature))
+    if brace < 0:
+        return ""
+    depth = 0
+    for index in range(brace, len(text)):
+        if text[index] == "{":
+            depth += 1
+        elif text[index] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[start : index + 1]
+    return ""
+
+
+def target_block(cmake: str, target: str) -> str:
+    starts = [
+        cmake.find(f"add_library({target}"),
+        cmake.find(f"add_executable({target}"),
+    ]
+    start = next((value for value in starts if value >= 0), -1)
+    if start < 0:
+        return ""
+    next_target = cmake.find("\nadd_", start + 1)
+    return cmake[start:] if next_target < 0 else cmake[start:next_target]
+
+
+def emit(root: Path, output: Path | None, checks: list[Check]) -> int:
+    violations = [check.check_id for check in checks if not check.passed]
+    report = {
+        "format": "anonsync-sync-socket-readiness-identity-audit-v2",
+        "scope": "lexical-hygiene-not-semantic-proof",
+        "scope_nonclaim": (
+            "source vocabulary and order do not prove Linux socket identity, "
+            "race freedom, OpenSSL retry semantics, or delivery correctness"
+        ),
+        "root": str(root),
+        "passed": not violations,
+        "passed_checks": len(checks) - len(violations),
+        "total_checks": len(checks),
+        "checks": [asdict(check) for check in checks],
+        "violations": violations,
+    }
+    rendered = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if output is None:
+        sys.stdout.write(rendered)
+    else:
+        output.parent.mkdir(parents=True, exist_ok=True)
+        output.write_text(rendered, encoding="utf-8")
+    return 0 if not violations else 1
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument(
+        "--root", type=Path, default=Path(__file__).resolve().parents[1]
+    )
+    parser.add_argument("--json", type=Path)
+    args = parser.parse_args()
+    root = args.root.resolve()
+    checks: list[Check] = []
+
+    def require(condition: bool, check_id: str, detail: str) -> None:
+        checks.append(Check(check_id, bool(condition), detail))
+
+    missing = [path.as_posix() for path in REQUIRED if not (root / path).is_file()]
+    require(not missing, "required_files_exist", f"missing={missing}")
+    if missing:
+        return emit(root, args.json, checks)
+
+    text = {
+        path.as_posix(): (root / path).read_text(encoding="utf-8")
+        for path in REQUIRED
+    }
+    cmake = text["CMakeLists.txt"]
+    header = text["src/sync_socket_readiness_identity.hpp"]
+    source = text["src/sync_socket_readiness_identity.cpp"]
+    runtime = text["tests/sync_socket_readiness_identity_test.cpp"]
+    tls_header = text["src/sync_replica_tls_transport.hpp"]
+    tls_source = text["src/sync_replica_tls_transport.cpp"]
+    tls_runtime = text["tests/sync_replica_tls_transport_test.cpp"]
+    verifier = text["tools/verify_release_package.py"]
+    design = text["TLS_SOCKET_LIFETIME_AUTHORITY_AUDIT_rev0885.md"]
+    self_text = text["tools/audit_sync_socket_readiness_identity.py"]
+
+    identity_target = target_block(
+        cmake, "anonsync_sync_socket_readiness_identity"
+    )
+    identity_test_target = target_block(
+        cmake, "anonsync_sync_socket_readiness_identity_test"
+    )
+    tls_target = target_block(cmake, "anonsync_sync_replica_tls_transport")
+    require(
+        "ANONSYNC_SYNC_SOCKET_READINESS_IDENTITY_SOURCE" in identity_target
+        and "src/sync_socket_readiness_identity.cpp" in cmake
+        and "STATIC" in identity_target
+        and "-Wall -Wextra -Wpedantic" in identity_target,
+        "generic_identity_is_one_strict_leaf_library",
+        "kernel observation remains separately compiled and transport-independent",
+    )
+    require(
+        "tests/sync_socket_readiness_identity_test.cpp" in identity_test_target
+        and "anonsync_sync_socket_readiness_identity" in identity_test_target,
+        "generic_identity_has_a_dedicated_runtime_target",
+        "the lowest-level lifetime proof is executable without OpenSSL",
+    )
+    require(
+        "anonsync_sync_socket_readiness_identity" in tls_target
+        and "PRIVATE" in tls_target,
+        "tls_consumes_identity_as_a_private_detail",
+        "the Linux observer does not become a public TLS dependency contract",
+    )
+
+    identity = delimited_body(header, "class SyncSocketReadinessIdentity final")
+    public_part, _, private_part = identity.partition("private:")
+    require(
+        bool(identity)
+        and "SyncSocketReadinessIdentity()" not in identity
+        and "friend SyncSocketReadinessIdentity" in private_part
+        and "SyncSocketReadinessIdentity(" in private_part,
+        "identity_construction_is_observer_owned",
+        "ordinary callers cannot default-construct or forge kernel evidence",
+    )
+    require(
+        "descriptor() const noexcept" in public_part
+        and "socket_type()" not in public_part
+        and "device()" not in public_part
+        and "inode()" not in public_part
+        and "socket_cookie" not in public_part
+        and "operator==(const SyncSocketReadinessIdentity&) const noexcept = default"
+        in public_part,
+        "identity_is_opaque_except_for_advisory_descriptor",
+        "consumers cannot partially compare or serialize raw kernel fields",
+    )
+    require(
+        all(
+            token in private_part
+            for token in (
+                "socket_type_",
+                "device_",
+                "inode_",
+                "linux_socket_cookie_",
+            )
+        ),
+        "exact_comparison_retains_all_private_components",
+        "descriptor, socket class, stat identity, and cookie move as one tuple",
+    )
+    require(
+        all(
+            phrase in header
+            for phrase in (
+                "descriptor number alone is not authority",
+                "process-local evidence",
+                "not a serializable identifier",
+                "serialize descriptor mutation",
+                "fail closed",
+                "identity fields deliberately remain opaque",
+            )
+        ),
+        "public_contract_rejects_integer_serialization_and_race_overclaims",
+        "the API states what the observational value cannot authorize",
+    )
+
+    observe = delimited_body(
+        source, "observe_sync_nonblocking_socket_identity_or_throw("
+    )
+    require(
+        ordered(
+            observe,
+            "#ifdef __linux__",
+            "::fstat(descriptor, &before)",
+            "S_ISSOCK(before.st_mode)",
+            "SO_TYPE",
+            "SO_COOKIE",
+            "F_GETFL",
+            "O_NONBLOCK",
+            "::fstat(descriptor, &after)",
+            "same_file_identity(before, after)",
+            "cookie_after",
+            "cookie_after != cookie",
+            "return SyncSocketReadinessIdentity(",
+        ),
+        "linux_observation_orders_type_cookie_flags_and_double_capture",
+        "one returned tuple cannot intentionally combine sequential descriptor occupants",
+    )
+    require(
+        '#error "Linux socket lifetime reproof requires SO_COOKIE"' in observe
+        and "cookie == 0U" in observe
+        and "cookie_after != cookie" in observe,
+        "linux_cookie_is_compile_time_required_nonzero_and_stable",
+        "strict mode does not infer lifetime authority from kernel version or fd class",
+    )
+    require(
+        "unsigned_stat_component_or_throw" in observe
+        and '"device identity"' in observe
+        and '"inode identity"' in observe,
+        "stat_identity_conversion_is_checked",
+        "platform stat fields cannot silently truncate into the retained tuple",
+    )
+    require(
+        "cannot prove an exact nonblocking socket lifetime on this platform"
+        in observe,
+        "unsupported_platforms_fail_closed",
+        "no weaker non-Linux tuple is mislabeled as exact lifetime evidence",
+    )
+
+    reprove = delimited_body(
+        source, "reprove_sync_nonblocking_socket_identity_or_throw("
+    )
+    require(
+        ordered(
+            reprove,
+            "observe_sync_nonblocking_socket_identity_or_throw",
+            "if (observed != expected)",
+            "no longer names the exact observed socket lifetime",
+        ),
+        "reproof_reobserves_and_exactly_compares",
+        "same-number property checks cannot substitute for captured lifetime",
+    )
+    require(
+        "<openssl/" not in header
+        and "<openssl/" not in source
+        and "SSL_" not in source,
+        "generic_identity_remains_transport_independent",
+        "OpenSSL state cannot leak into the kernel descriptor capability leaf",
+    )
+
+    require(
+        all(
+            token in runtime
+            for token in (
+                "observation exposes only the advisory descriptor",
+                "unchanged socket lifetime reproves",
+                "independent sockets cannot share readiness identity",
+                "reproof rejects loss of O_NONBLOCK",
+                "restoring O_NONBLOCK preserves the same socket lifetime",
+                "::dup2(",
+                "reproof rejects close/dup2 descriptor ABA",
+                "nonblocking pipe cannot mint socket readiness identity",
+                "closed descriptor cannot reprove socket lifetime",
+                "unsupported platform fails closed",
+            )
+        ),
+        "generic_runtime_matrix_covers_positive_negative_and_platform_frontiers",
+        "compiled behavior distinguishes a socket class from one exact lifetime",
+    )
+    require(
+        "::pipe(" in runtime
+        and "::pipe2(" not in runtime
+        and "set_close_on_exec" in runtime,
+        "generic_negative_fixture_avoids_pipe2_dependency",
+        "the fixture uses portable Linux primitives within the Linux-only proof lane",
+    )
+
+    proof = delimited_body(
+        tls_source, "struct SyncReplicaTlsSocketReadinessProof final"
+    )
+    capture = delimited_body(
+        tls_source, "capture_nonblocking_tls_socket_proof_or_throw("
+    )
+    require(
+        "SyncSocketReadinessIdentity read" in proof
+        and "SyncSocketReadinessIdentity write" in proof
+        and "operator==" in proof
+        and ordered(
+            capture,
+            "SSL_get_rbio(ssl)",
+            "SSL_get_wbio(ssl)",
+            "BIO_TYPE_SOCKET",
+            "SSL_get_rfd(ssl)",
+            "SSL_get_wfd(ssl)",
+            "observe_sync_nonblocking_socket_identity_or_throw",
+        ),
+        "tls_binds_direct_bios_to_shared_read_write_identity",
+        "direct BIO shape and exact kernel lifetime are captured together",
+    )
+    require(
+        all(
+            token not in tls_source
+            for token in ("::getsockopt", "::fcntl", "::fstat", "SO_COOKIE")
+        ),
+        "tls_has_no_duplicate_raw_socket_identity_syscalls",
+        "one generic owner defines the kernel proof and its diagnostics",
+    )
+
+    begin_write = delimited_body(tls_source, "SSL* begin_record_write_or_throw(")
+    begin_read = delimited_body(tls_source, "void begin_record_read_or_throw(")
+    require(
+        ordered(
+            begin_write,
+            "validate_or_throw(label)",
+            "record_readiness_proof_.emplace",
+            "capture_nonblocking_tls_socket_proof_or_throw",
+            "record_reservation_ = SyncReplicaTlsRecordReservation::Write",
+        )
+        and ordered(
+            begin_read,
+            "validate_or_throw(label)",
+            "record_readiness_proof_.emplace",
+            "capture_nonblocking_tls_socket_proof_or_throw",
+            "record_reservation_ = SyncReplicaTlsRecordReservation::Read",
+        ),
+        "proof_capture_precedes_duplex_reservation",
+        "a throwing observation cannot strand an accepted record reservation",
+    )
+
+    active_write = delimited_body(tls_source, "SSL* active_record_write_or_throw(")
+    active_read = delimited_body(tls_source, "SSL* active_record_read_or_throw(")
+    require(
+        ordered(
+            active_write,
+            "validate_authenticated_session_and_poison_or_throw(label)",
+            "recapture_exact_nonblocking_tls_socket_proof_or_throw",
+            '"between prefix and body"',
+        ),
+        "write_body_frontier_recaptures_exact_bio_lifetime",
+        "an accepted prefix cannot authorize a substituted body socket",
+    )
+    require(
+        ordered(
+            active_read,
+            "require_record_read_owner_or_throw(label)",
+            "if (retry_pending)",
+            "reprove_nonblocking_tls_socket_proof_without_openssl_or_throw",
+            "return ssl_",
+            "validate_authenticated_session_and_poison_or_throw(label)",
+            "recapture_exact_nonblocking_tls_socket_proof_or_throw",
+            '"during the record read"',
+        ),
+        "read_retry_and_fresh_operation_have_distinct_reproofs",
+        "WANT retry avoids unrelated SSL inspection while successful progress opens a fresh frontier",
+    )
+
+    target_method = delimited_body(
+        tls_source,
+        "SyncReplicaTlsRecordReadContinuation::pending_readiness_or_throw() const",
+    )
+    target_owner = delimited_body(
+        tls_source, "int record_readiness_descriptor_or_throw("
+    )
+    require(
+        ordered(
+            target_owner,
+            "require_record_read_owner_or_throw(label)",
+            "reprove_nonblocking_tls_socket_proof_without_openssl_or_throw",
+            "return writable",
+        )
+        and ordered(
+            target_method,
+            "PendingReadiness::None",
+            "record_readiness_descriptor_or_throw",
+            "catch (...)",
+            "state_->abandon_noexcept()",
+        ),
+        "poll_target_is_reproved_and_failure_abandons_pending_operation",
+        "the event loop is not handed an already recycled descriptor integer",
+    )
+    require(
+        all(
+            phrase in tls_header
+            for phrase in (
+                "Advisory event-loop target",
+                "lookup re-proves the captured socket",
+                "advance_or_throw() proves them again",
+                "Raw descriptor mutation still must be serialized",
+            )
+        ),
+        "public_poll_contract_is_advisory_and_double_reproved",
+        "readiness notification is not represented as transport authority",
+    )
+    require(
+        all(
+            phrase in tls_header
+            for phrase in (
+                "direct OpenSSL socket BIOs",
+                "exact Linux socket lifetime immediately before the prefix",
+                "recaptures that exact BIO/socket lifetime before the body",
+                "unsupported exact-lifetime",
+            )
+        ),
+        "public_write_contract_names_exact_lifetime_frontiers",
+        "the strict writer contract no longer describes only O_NONBLOCK class checks",
+    )
+
+    terminal_methods = "\n".join(
+        delimited_body(tls_source, signature)
+        for signature in (
+            "void complete_record_write_noexcept() const noexcept",
+            "void complete_record_read_noexcept() const noexcept",
+            "void abandon_record_read_noexcept(",
+            "void close_record_read_noexcept() const noexcept",
+            "void poison_noexcept() const noexcept",
+        )
+    )
+    require(
+        terminal_methods.count("record_readiness_proof_.reset()") >= 5,
+        "all_terminal_reservation_paths_clear_socket_proof",
