+void selftest_sqlite_hostile_exec(const std::string& database_path,
+                                  const std::string& sql,
+                                  const std::string& context) {
+    sqlite3* database = nullptr;
+    const int open_rc = sqlite3_open_v2(
+        database_path.c_str(), &database, SQLITE_OPEN_READWRITE, nullptr);
+    if (open_rc != SQLITE_OK) {
+        const std::string message = database != nullptr
+            ? sqlite3_errmsg(database)
+            : "sqlite open failed";
+        if (database != nullptr) sqlite3_close(database);
+        throw std::runtime_error(context + " hostile SQLite open failed: " + message);
+    }
+
+    auto close_and_throw = [&](const std::string& message) -> void {
+        sqlite3_close(database);
+        database = nullptr;
+        throw std::runtime_error(context + " hostile SQLite mutation failed: " + message);
+    };
+    auto exec_or_throw = [&](const std::string& statement) {
+        char* error = nullptr;
+        const int rc = sqlite3_exec(
+            database, statement.c_str(), nullptr, nullptr, &error);
+        const std::string message = error != nullptr ? error : sqlite3_errstr(rc);
+        if (error != nullptr) sqlite3_free(error);
+        if (rc != SQLITE_OK) {
+            close_and_throw(message + " sql=" + statement);
+        }
+    };
+
+    // These calls intentionally emulate an offline or hostile writer, not a
+    // cooperating AnonSync connection.  The bundled SQLite build enables
+    // foreign keys by default, so explicitly turn them off on this private
+    // mutation connection and prove that the request took effect before
+    // injecting referentially inconsistent bytes.
+    exec_or_throw("PRAGMA foreign_keys=OFF;");
+
+    sqlite3_stmt* pragma = nullptr;
+    const int prepare_rc = sqlite3_prepare_v2(
+        database, "PRAGMA foreign_keys;", -1, &pragma, nullptr);
+    if (prepare_rc != SQLITE_OK) {
+        close_and_throw("foreign-key mode verification prepare failed: " +
+                        std::string(sqlite3_errmsg(database)));
+    }
+    const int step_rc = sqlite3_step(pragma);
+    bool foreign_keys_disabled = false;
+    std::string verification_error;
+    if (step_rc == SQLITE_ROW) {
+        try {
+            foreign_keys_disabled = selftest_sqlite_i64(pragma, 0) == 0;
+        } catch (const std::exception& error) {
+            verification_error = error.what();
+        }
+    }
+    const int finalize_rc = sqlite3_finalize(pragma);
+    pragma = nullptr;
+    if (!verification_error.empty()) {
+        close_and_throw("foreign-key mode verification failed: " + verification_error);
+    }
+    if (!foreign_keys_disabled || finalize_rc != SQLITE_OK) {
+        close_and_throw("foreign-key enforcement remained enabled on hostile mutation connection");
+    }
+
+    exec_or_throw(sql);
+    const int close_rc = sqlite3_close(database);
+    database = nullptr;
+    if (close_rc != SQLITE_OK) {
+        throw std::runtime_error(context + " hostile SQLite close failed: " +
+                                 std::string(sqlite3_errstr(close_rc)));
+    }
+}
