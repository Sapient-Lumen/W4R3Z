+void print_usage(std::ostream& output) {
+    output <<
+        "AnonSync bounded causal replica product spine\n\n"
+        "Commands:\n"
+        "  anonsync_replica certificate-spki --certificate ABSOLUTE_PEM\n"
+        "  anonsync_replica enqueue-file --replica-db ABSOLUTE_DB "
+        "--payload-root ABSOLUTE_DIR --folder ID --local-device ID "
+        "--local-epoch N --destination-device ID [--destination-device ID...] "
+        "--canonical-path PATH --source-file ABSOLUTE_FILE\n"
+        "  anonsync_replica membership-publish --membership-db ABSOLUTE_DB "
+        "--anchor-db ABSOLUTE_DB --folder ID --local-device ID "
+        "--local-epoch N --policy-epoch N "
+        "[--peer DEVICE:EPOCH:SPKI_SHA256 ...]\n"
+        "  anonsync_replica send-one --replica-db ABSOLUTE_DB "
+        "--payload-root ABSOLUTE_DIR --folder ID --local-device ID "
+        "--local-epoch N --remote-device ID --remote-epoch N "
+        "--remote-spki SHA256 --address NUMERIC_IP --port N "
+        "--certificate ABSOLUTE_PEM --private-key ABSOLUTE_PEM "
+        "--ca-file ABSOLUTE_PEM [--worker ID] [--lease-seconds N] "
+        "[--timeout-seconds N] [--operator-clock-authority-id ID "
+        "--operator-clock-uncertainty-ns N]\n"
+        "  anonsync_replica serve-one --replica-db ABSOLUTE_DB "
+        "--effect-db ABSOLUTE_DB --membership-db ABSOLUTE_DB "
+        "--anchor-db ABSOLUTE_DB --files-root ABSOLUTE_DIR --folder ID "
+        "--local-device ID --local-epoch N --bind-address NUMERIC_IP "
+        "--port N --certificate ABSOLUTE_PEM --private-key ABSOLUTE_PEM "
+        "--ca-file ABSOLUTE_PEM [--timeout-seconds N]\n\n"
+        "All database, directory, and credential paths must be absolute. "
+        "send-one and serve-one own exactly one bounded TLS conversation; "
+        "they are intentionally not a background daemon. send-one defaults "
+        "to the fail-closed kernel clock source. The paired operator-clock "
+        "options are an explicit deployment assertion for environments where "
+        "clock synchronization evidence is externally owned. JSON is written "
+        "to stdout and diagnostics to stderr.\n";
+}
