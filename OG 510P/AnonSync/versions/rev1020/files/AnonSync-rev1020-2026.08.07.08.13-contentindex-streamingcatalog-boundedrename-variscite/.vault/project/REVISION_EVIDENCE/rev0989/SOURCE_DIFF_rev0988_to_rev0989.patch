+void test_targeted_path_cutpoint_is_exact_and_history_bounded() {
+    TempDatabasePath file("anonsync-replica-sqlite-owner-targeted-path");
+    const std::string folder = "folder-sqlite-targeted-path";
+    const SyncReplicaActor local = actor(
+        "device-sqlite-targeted-path-local", 1211U);
+    constexpr std::string_view path = "media/library/movie.mkv";
+
+    SyncSqliteDb db = open_database(file.path);
+    SyncReplicaSqliteOwner owner(
+        db.db, folder, local, limits(96U), "targeted path owner");
+    const SyncReplicaOperation predecessor =
+        owner.publish_local_file_or_throw(
+            std::string(path), 11U, anonsync::sha256_hex("predecessor"));
+    const std::array<std::string, 1U> observed_heads{
+        predecessor.operation_id};
+    const SyncReplicaOperation current =
+        owner.publish_local_file_from_observed_heads_or_throw(
+            std::string(path), observed_heads, 7U,
+            anonsync::sha256_hex("current"));
+
+    // Populate unrelated retained history so the statement-shape assertion is
+    // meaningful. The targeted reader must not traverse these rows merely to
+    // re-prove one exact path.
+    for (std::size_t index = 0U; index < 32U; ++index) {
+        (void)owner.publish_local_file_or_throw(
+            "unrelated/item-" + std::to_string(index) + ".bin",
+            1U, anonsync::sha256_hex(
+                    "unrelated-" + std::to_string(index)));
+    }
+
+    TargetedReplicaReadTrace trace;
+    require(
+        sqlite3_trace_v2(
+            db.db.get(), SQLITE_TRACE_STMT, count_targeted_replica_reads,
+            &trace) == SQLITE_OK,
+        "targeted path fixture could not install its SQLite trace");
+    const anonsync::SyncReplicaSqliteTargetedPathCutpoint cutpoint =
+        owner.targeted_path_cutpoint_or_throw(
+            std::string(path), predecessor.operation_id);
+    require(
+        sqlite3_trace_v2(db.db.get(), 0U, nullptr, nullptr) == SQLITE_OK,
+        "targeted path fixture could not remove its SQLite trace");
+    require(
+        cutpoint.sole_visible_operation == current &&
+            !cutpoint.requested_retained_operation_is_sole_visible &&
+            cutpoint.distinct_retained_operation == predecessor &&
+            cutpoint.requested_retained_operation_or_none() != nullptr &&
+            *cutpoint.requested_retained_operation_or_none() == predecessor,
+        "targeted path cutpoint did not return the exact sole-visible and retained operations");
+    require(
+        trace.exact_visible_path_read_count == 1U &&
+            trace.exact_operation_read_count == 2U &&
+            trace.complete_visible_projection_read_count == 0U &&
+            trace.complete_operation_projection_read_count == 0U &&
+            trace.schema_catalog_read_count == 1U &&
+            trace.foreign_key_pragma_count == 1U,
+        "targeted path cutpoint traversed a complete replica projection");
+
+    (void)owner.publish_local_file_or_throw(
+        "unrelated/later.bin", 5U, anonsync::sha256_hex("later"));
+    const anonsync::SyncReplicaSqliteTargetedPathCutpoint after_unrelated =
+        owner.targeted_path_cutpoint_or_throw(
+            std::string(path), predecessor.operation_id);
+    require(
+        after_unrelated == cutpoint,
+        "unrelated replica progress changed the exact path-local authority");
+
+    const SyncReplicaOperation concurrent = root_operation(
+        folder, actor("device-sqlite-targeted-path-remote", 1212U),
+        std::string(path), "concurrent");
+    require(
+        owner.accept_remote_or_throw(concurrent) ==
+            SyncReplicaAdmission::InsertedActive,
+        "targeted path fixture could not create one visible conflict");
+    const anonsync::SyncReplicaSqliteTargetedPathCutpoint conflicted =
+        owner.targeted_path_cutpoint_or_throw(
+            std::string(path), predecessor.operation_id);
+    require(
+        !conflicted.sole_visible_operation.has_value() &&
+            !conflicted.requested_retained_operation_is_sole_visible &&
+            conflicted.distinct_retained_operation == predecessor,
+        "targeted path cutpoint manufactured sole-visible authority for a conflict");
+
+    require_error(
+        [&] {
+            (void)owner.targeted_path_cutpoint_or_throw(
+                "../escape", predecessor.operation_id);
+        },
+        "targeted path is invalid",
+        "targeted path cutpoint accepted a noncanonical path");
+    require_error(
+        [&] {
+            (void)owner.targeted_path_cutpoint_or_throw(
+                std::string(path), std::string("not-a-digest"));
+        },
+        "targeted retained operation identity is invalid",
+        "targeted path cutpoint accepted a malformed operation identity");
+}
