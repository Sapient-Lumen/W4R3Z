+class TestState final {
+public:
+    void check(bool condition, const std::string& label) {
+        ++total_;
+        if (condition) {
+            ++passed_;
+        } else {
+            std::cerr << "FAIL: " << label << '\n';
+        }
+    }
+
+    int finish() const {
+        std::cout << "sync atomic publication cutpoints: " << passed_ << "/"
+                  << total_ << " checks passed\n";
+        return passed_ == total_ ? 0 : 1;
+    }
