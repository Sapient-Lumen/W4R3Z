+
+bool has_injected_nested_cause(const std::exception& error) {
+    try {
+        std::rethrow_if_nested(error);
+    } catch (const InjectedFrontierFailure&) {
+        return true;
+    } catch (const std::exception& nested) {
+        return has_injected_nested_cause(nested);
+    } catch (...) {
+    }
+    return false;
+}
