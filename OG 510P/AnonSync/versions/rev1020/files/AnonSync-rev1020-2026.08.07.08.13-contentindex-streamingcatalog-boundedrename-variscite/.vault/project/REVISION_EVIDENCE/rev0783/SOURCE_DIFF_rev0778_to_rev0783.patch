+using SyncSqliteDbHandleSlot =
+    detail::ProcessBoundHandleSlot<detail::SyncSqliteDbHandlePolicy>;
+using SyncSqliteStmtHandleSlot =
+    detail::ProcessBoundHandleSlot<detail::SyncSqliteStmtHandlePolicy>;
+}  // namespace anonsync
