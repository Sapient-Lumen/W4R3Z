+}
+
+SyncReplicaDatabaseBackupArtifactObservation
+SyncReplicaDatabaseBackupOwner::inspect_artifact_or_throw(
+    const fs::path& absolute_artifact_path) {
+    validate_artifact_path_or_throw(
+        state_->deployment, absolute_artifact_path,
+        state_->label + " artifact inspection path");
+    persistence::SealedSqliteSnapshot sealed =
+        persistence::SealedSqliteSnapshot::capture(
+            absolute_artifact_path,
+            state_->label + " bounded artifact capture",
+            backup_seal_policy());
+    return inspect_sealed_artifact_or_throw(
+        state_->deployment, sealed, absolute_artifact_path,
+        state_->label + " artifact inspection");
+}
+
+SyncReplicaDatabaseBackupArtifactObservation
+SyncReplicaDatabaseBackupOwner::create_artifact_or_throw(
+    const fs::path& absolute_artifact_path) {
+    validate_artifact_path_or_throw(
+        state_->deployment, absolute_artifact_path,
+        state_->label + " artifact output path");
+
+    // This is an early denial only. The immutable publisher repeats the same
+    // no-symlink parent traversal and owns the final atomic no-replace race.
+    // Performing it before the whole-database copy avoids needless resident
+    // allocation when the destination is already unusable.
+    preflight_sync_file_create_new_no_symlink_or_throw(
+        absolute_artifact_path,
+        state_->label + " artifact output preflight");
+
+    SyncReplicaDatabaseBackupArtifactObservation captured;
+    {
+        SyncReplicaOperationalDatabase source =
+            open_attested_sync_replica_primary_database_read_only_or_throw(
+                state_->deployment,
+                state_->label + " forensic backup source");
+        const SyncReplicaDatabaseBackupCutpoint before =
+            compact_backup_cutpoint(
+                inspect_sync_replica_sqlite_snapshot_read_only_or_throw(
+                    source.handle(), state_->deployment.folder_id,
+                    state_->deployment.local_actor,
+                    state_->label + " source snapshot before capture"));
+
+        persistence::SealedSqliteSnapshot sealed;
+        {
+            auto source_borrow =
+                borrow_sync_sqlite_serialized_db_or_throw(
+                    source.handle(),
+                    state_->label + " serialized source capability");
+            sealed = persistence::SealedSqliteSnapshot::capture_database(
+                source_borrow.get(),
+                state_->label + " bounded canonical live backup",
+                backup_seal_policy());
+        }
+
+        captured = inspect_sealed_artifact_or_throw(
+            state_->deployment, sealed, absolute_artifact_path,
+            state_->label + " captured artifact");
+        const SyncReplicaDatabaseBackupCutpoint after =
+            compact_backup_cutpoint(
+                inspect_sync_replica_sqlite_snapshot_read_only_or_throw(
+                    source.handle(), state_->deployment.folder_id,
+                    state_->deployment.local_actor,
+                    state_->label + " source snapshot after capture"));
+        source.verify_open_database_or_throw(
+            state_->label + " source final rooted reproof");
+        if (before != captured.source_cutpoint ||
+            after != captured.source_cutpoint) {
+            throw std::runtime_error(
+                state_->label +
+                " source changed across the exact backup capture bracket");
+        }
+
+        // Create-new is the final namespace authority. No failure path guesses
+        // that a visible name still denotes this attempt's inode.
+        sealed.publish_exact_copy_atomically_create_new_or_throw(
+            absolute_artifact_path,
+            state_->label + " immutable artifact publication");
+    }
+
+    // The source and first resident seal are gone. Reopen the durable artifact
+    // through its own sidecar-free rooted path, then repeat binding, schema,
+    // geometry, digest, and complete logical-snapshot proof.
+    SyncReplicaDatabaseBackupArtifactObservation published =
+        inspect_artifact_or_throw(absolute_artifact_path);
+    if (published.artifact_sha256 != captured.artifact_sha256 ||
+        published.artifact_bytes != captured.artifact_bytes ||
+        published.sqlite_page_size != captured.sqlite_page_size ||
+        published.sqlite_page_count != captured.sqlite_page_count ||
+        published.source_cutpoint != captured.source_cutpoint) {
+        throw std::runtime_error(
+            state_->label +
+            " published artifact differs from the captured source snapshot");
+    }
+    return published;
+}
+
+}  // namespace anonsync
+
+#endif
