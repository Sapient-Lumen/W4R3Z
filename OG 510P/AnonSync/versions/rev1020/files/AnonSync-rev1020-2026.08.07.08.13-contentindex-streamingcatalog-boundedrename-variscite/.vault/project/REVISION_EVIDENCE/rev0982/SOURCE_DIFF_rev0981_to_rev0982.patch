+        database.get(), outer_transaction_authority,
+        label + " detached read-only write-denial probe");
+    DetachedQueryOnlyRestoreGuard query_only_restore(database.get());
+    sqlite_exec_or_throw(
+        database, "PRAGMA query_only=OFF;",
+        label + " read-only probe setup");
