+
+void validate_remote_apply_progress_path_or_throw(
+    std::string_view canonical_path,
+    const SyncReplicaFolderScanLimits& limits,
+    const std::string& label) {
+    if (canonical_path.empty()) return;
+    validate_scan_progress_path_or_throw(
+        canonical_path, limits, label + " remote-apply cursor");
+}
+
+[[nodiscard]] FolderRemoteApplyProgressHead
+load_remote_apply_progress_head_or_throw(
+    SyncSqliteDbHandleSlot& db,
+    const SyncReplicaFolderScanLimits& limits,
+    const std::string& label) {
+    SyncSqliteStmt progress = sqlite_prepare_or_throw(
+        db,
+        "SELECT resume_after_path FROM "
+        "main.sync_replica_folder_catalog_remote_apply_progress WHERE id=1;",
+        label + " remote-apply progress prepare");
+    if (step_row_or_done_or_throw(
+            progress.stmt,
+            label + " remote-apply progress step") != SQLITE_ROW) {
+        throw std::runtime_error(
+            label + " remote-apply progress singleton is missing");
+    }
+    FolderRemoteApplyProgressHead head;
+    head.resume_after_path = sqlite_column_text_or_throw(
+        progress.stmt, 0, 4096U, label + " remote-apply cursor");
+    if (step_row_or_done_or_throw(
+            progress.stmt,
+            label + " remote-apply progress trailing step") != SQLITE_DONE) {
+        throw std::runtime_error(
+            label + " remote-apply progress singleton is not unique");
+    }
+    validate_remote_apply_progress_path_or_throw(
+        head.resume_after_path, limits, label);
+    return head;
+}
+
+void insert_genesis_remote_apply_progress_or_throw(
+    SyncSqliteDbHandleSlot& db,
+    const std::string& label) {
+    sqlite_exec_or_throw(
+        db,
+        "INSERT INTO "
+        "main.sync_replica_folder_catalog_remote_apply_progress("
+        "id,resume_after_path) VALUES(1,'');",
+        label + " remote-apply progress genesis");
+}
+
+[[nodiscard]] FolderRemoteApplyProgressHead
+advance_remote_apply_progress_or_throw(
+    SyncSqliteDbHandleSlot& db,
+    const SyncReplicaFolderScanLimits& limits,
+    const FolderRemoteApplyProgressHead& expected,
+    std::string next_resume_after_path,
+    const std::string& label) {
+    if (next_resume_after_path.empty()) {
+        throw std::invalid_argument(
+            label + " remote-apply cursor cannot advance to an empty path");
+    }
+    validate_remote_apply_progress_path_or_throw(
+        expected.resume_after_path, limits, label + " expected");
+    validate_remote_apply_progress_path_or_throw(
+        next_resume_after_path, limits, label + " next");
+
+    SyncSqliteTransaction transaction(
+        db, label + " remote-apply cursor publication",
+        SyncSqliteTransactionMode::Immediate);
+    const FolderRemoteApplyProgressHead current =
+        load_remote_apply_progress_head_or_throw(
+            db, limits, label + " current");
+    if (current != expected) {
+        throw std::runtime_error(
+            label + " remote-apply cursor changed before publication");
+    }
+
+    SyncSqliteStmt update = sqlite_prepare_or_throw(
+        db,
+        "UPDATE "
+        "main.sync_replica_folder_catalog_remote_apply_progress SET "
+        "resume_after_path=? WHERE id=1 AND resume_after_path=?;",
+        label + " remote-apply progress update prepare");
+    sqlite_bind_text_or_throw(
+        update.stmt, 1, next_resume_after_path, label);
+    sqlite_bind_text_or_throw(
+        update.stmt, 2, expected.resume_after_path, label);
+    sqlite_step_done_or_throw(
+        update.stmt, label + " remote-apply progress update step");
+
+    const FolderRemoteApplyProgressHead staged =
+        load_remote_apply_progress_head_or_throw(
+            db, limits, label + " staged");
+    const FolderRemoteApplyProgressHead wanted{next_resume_after_path};
+    if (staged != wanted) {
+        throw std::runtime_error(
+            label + " staged remote-apply cursor did not advance exactly");
+    }
+    transaction.commit();
+    return staged;
+}
