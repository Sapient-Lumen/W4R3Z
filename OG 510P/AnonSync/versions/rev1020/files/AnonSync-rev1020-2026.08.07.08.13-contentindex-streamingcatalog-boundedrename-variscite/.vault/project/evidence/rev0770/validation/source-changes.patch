+        sqlite_exec_or_throw(db.get(), "SELECT 1;", "authorized SELECT");
+        require_throws(
+            [&] {
+                sqlite_exec_or_throw(db.get(),
+                                     "CREATE TABLE forbidden(value INTEGER);",
+                                     "forbidden DDL");
