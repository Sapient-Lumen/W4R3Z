+        checks += 1
+        extra.unlink()
+
+        ext_h = vendor / "sqlite3ext.h"
+        ext_h.unlink()
+        ext_h.symlink_to(source_vendor / "sqlite3ext.h")
+        run_gate(cmake, root, expect_success=False, label="native symlink substitution")
+        checks += 1
