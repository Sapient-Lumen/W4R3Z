+struct PayloadStoreLiveCapabilityRecord final {
+    PayloadStoreLiveCapabilityKind kind =
+        PayloadStoreLiveCapabilityKind::Snapshot;
+    std::string content_sha256;
+    std::uint64_t size_bytes = 0U;
+};
