+    for (const char value : source) {
+        if (!((value >= '0' && value <= '9') ||
+              (value >= 'a' && value <= 'f'))) {
+            return false;
+        }
+    }
+    std::memcpy(destination.data(), source.data(), destination.size());
+    return true;
