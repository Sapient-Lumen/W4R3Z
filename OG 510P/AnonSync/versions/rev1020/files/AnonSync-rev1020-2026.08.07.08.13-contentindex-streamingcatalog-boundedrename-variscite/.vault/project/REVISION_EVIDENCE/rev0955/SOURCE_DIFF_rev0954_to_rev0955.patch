+constexpr std::size_t kEncodedU64Bytes = 8U;
+
+[[noreturn]] void invalid(
+    std::string_view label,
+    std::string_view reason) {
+    throw std::invalid_argument(
+        std::string(label) + " " + std::string(reason));
