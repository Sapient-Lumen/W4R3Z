+struct PayloadScrubAttemptSnapshotView final {
+    const std::vector<PayloadIndexEntry>& entries;
+    struct stat directory_status {};
+    std::uint64_t transient_entry_count = 0U;
+    std::uint64_t transient_reserved_bytes = 0U;
