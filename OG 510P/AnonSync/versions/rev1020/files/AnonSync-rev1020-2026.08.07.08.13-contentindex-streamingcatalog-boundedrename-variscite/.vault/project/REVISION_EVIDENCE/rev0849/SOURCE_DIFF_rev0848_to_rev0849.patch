+        (void)sqlite3_finalize(statement);
+        throw std::runtime_error("text query returned invalid bytes");
+    }
+    std::string value(reinterpret_cast<const char*>(bytes),
+                      static_cast<std::size_t>(count));
+    (void)sqlite3_finalize(statement);
+    return value;
+}
