+    // state generation nor rewrites projection rows. The retention policy that
+    // caused CapacityBlocked is itself persisted and survives restart.
+    [[nodiscard]] SyncReplicaAdmission accept_remote_or_throw(
+        const SyncReplicaOperation& operation);
+
+    // Retires one exact unsettled sender intent only. Canonical evidence remains
+    // retained and can be reused by other destinations without payload copies.
+    [[nodiscard]] bool acknowledge_outbox_or_throw(
+        const std::string& destination_device_id,
+        const std::string& operation_id);
+
+    [[nodiscard]] std::optional<SyncReplicaSqliteOutboxDelivery>
+    outbox_delivery_or_throw(
+        const std::string& destination_device_id,
+        const std::string& operation_id);
+
+    // Policy change is explicit durable state. It succeeds only when all
+    // retained evidence and current outbox intents fit the replacement limits.
+    void replace_limits_or_throw(
+        const SyncReplicaSqliteOwnerLimits& replacement);
+
+private:
+    SyncSqliteDbHandleSlot& db_;
+    std::string folder_id_;
+    SyncReplicaActor local_actor_;
+    std::string label_;
+};
