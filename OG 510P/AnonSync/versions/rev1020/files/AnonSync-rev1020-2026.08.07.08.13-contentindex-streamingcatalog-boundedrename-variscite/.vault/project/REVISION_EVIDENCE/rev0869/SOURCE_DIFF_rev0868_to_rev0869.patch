+    const SyncReplicaOperation committed = owner.create_local_file_or_throw(
+        "rollback/one.bin", 3U, anonsync::sha256_hex("one"), destinations);
+    const SyncReplicaSqliteSnapshot baseline = owner.snapshot_or_throw();
