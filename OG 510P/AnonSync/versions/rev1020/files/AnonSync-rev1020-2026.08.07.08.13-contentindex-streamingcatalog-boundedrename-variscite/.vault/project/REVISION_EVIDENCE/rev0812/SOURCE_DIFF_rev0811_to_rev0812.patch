+        context + " sticky owner mode");
+    verify_exact_columns_or_throw(
+        db,
+        kOwnerModeTable,
+        kOwnerModeColumns,
+        context + " sticky owner mode");
+    verify_no_foreign_keys_or_throw(
+        db,
+        kOwnerModeTable,
+        context + " sticky owner mode");
+}
