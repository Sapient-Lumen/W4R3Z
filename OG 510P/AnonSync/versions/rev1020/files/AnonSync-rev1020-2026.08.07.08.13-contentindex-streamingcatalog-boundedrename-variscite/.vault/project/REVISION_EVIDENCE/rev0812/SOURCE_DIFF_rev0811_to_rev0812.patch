+bool attest_optional_owner_lock_table_or_throw(sqlite3* db,
+                                                const std::string& context) {
+    if (!exact_table_object_present_or_throw(
+            db,
+            kOwnerLockTable,
+            kOwnerLockStoredDdl,
+            true,
+            context + " owner lock object")) {
+        return false;
