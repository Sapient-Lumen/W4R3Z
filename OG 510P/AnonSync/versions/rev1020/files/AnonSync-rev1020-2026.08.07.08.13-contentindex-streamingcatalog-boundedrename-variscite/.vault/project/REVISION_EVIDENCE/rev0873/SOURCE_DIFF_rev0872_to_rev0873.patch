diff --git a/src/sync_replica_outbox_time_fence.cpp b/src/sync_replica_outbox_time_fence.cpp
new file mode 100644
index 0000000..8fe4431
--- /dev/null
+++ b/src/sync_replica_outbox_time_fence.cpp
@@ -0,0 +1,21 @@
+#include "sync_replica_outbox_time_fence.hpp"
+
+#include <stdexcept>
+
+namespace anonsync {
+
+std::uint64_t advance_sync_replica_outbox_time_high_water_or_throw(
+    std::uint64_t current_high_water_epoch,
+    std::uint64_t observed_epoch,
+    const std::string& label) {
+    if (observed_epoch == 0U) {
+        throw std::invalid_argument(label + " observed epoch must be positive");
+    }
+    if (observed_epoch < current_high_water_epoch) {
+        throw std::invalid_argument(
+            label + " observed epoch rolls back durable time");
+    }
+    return observed_epoch;
+}
+
+}  // namespace anonsync
diff --git a/src/sync_replica_outbox_time_fence.hpp b/src/sync_replica_outbox_time_fence.hpp
new file mode 100644
index 0000000..cf1fd21
--- /dev/null
+++ b/src/sync_replica_outbox_time_fence.hpp
@@ -0,0 +1,18 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace anonsync {
+
+// Advances one durable observation fence. Equal observations are idempotent;
+// a smaller observation is a rollback and cannot regain authority that a later
+// observation may already have revoked. This is an anti-rollback primitive,
+// not a claim that caller-supplied epoch time is physically trustworthy.
+[[nodiscard]] std::uint64_t
+advance_sync_replica_outbox_time_high_water_or_throw(
+    std::uint64_t current_high_water_epoch,
+    std::uint64_t observed_epoch,
+    const std::string& label);
+
+}  // namespace anonsync
