diff --git a/tests/sync_replica_outbox_time_fence_test.cpp b/tests/sync_replica_outbox_time_fence_test.cpp
new file mode 100644
index 0000000..2d77479
--- /dev/null
+++ b/tests/sync_replica_outbox_time_fence_test.cpp
@@ -0,0 +1,76 @@
+#include "sync_replica_outbox_time_fence.hpp"
+
+#include <cstdint>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <utility>
+
+namespace {
+
+std::size_t checks = 0;
+
+void require(bool condition, const std::string& message) {
+    ++checks;
+    if (!condition) throw std::runtime_error(message);
+}
+
+template <typename Callable>
+void require_error(
+    Callable&& callable,
+    std::string_view expected,
+    const std::string& message) {
+    ++checks;
+    try {
+        std::forward<Callable>(callable)();
+    } catch (const std::exception& error) {
+        if (std::string_view(error.what()).find(expected) !=
+            std::string_view::npos) {
+            return;
+        }
+        throw std::runtime_error(
+            message + ": unexpected error: " + error.what());
+    }
+    throw std::runtime_error(message + ": no error");
+}
+
+}  // namespace
+
+int main() {
+    try {
+        require(
+            anonsync::advance_sync_replica_outbox_time_high_water_or_throw(
+                0U, 1U, "initial observation") == 1U,
+            "initial positive observation did not establish the fence");
+        require(
+            anonsync::advance_sync_replica_outbox_time_high_water_or_throw(
+                100U, 100U, "equal observation") == 100U,
+            "equal observation was not idempotent");
+        require(
+            anonsync::advance_sync_replica_outbox_time_high_water_or_throw(
+                100U, 101U, "forward observation") == 101U,
+            "forward observation did not advance");
+        require_error(
+            [] {
+                (void)anonsync::
+                    advance_sync_replica_outbox_time_high_water_or_throw(
+                        100U, 0U, "zero observation");
+            },
+            "positive", "zero observation was accepted");
+        require_error(
+            [] {
+                (void)anonsync::
+                    advance_sync_replica_outbox_time_high_water_or_throw(
+                        101U, 100U, "rollback observation");
+            },
+            "rolls back", "rollback observation was accepted");
+        std::cout << "sync replica outbox time-fence tests passed: "
+                  << checks << " checks\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << "sync replica outbox time-fence tests failed after "
+                  << checks << " checks: " << error.what() << '\n';
+        return 1;
+    }
+}
