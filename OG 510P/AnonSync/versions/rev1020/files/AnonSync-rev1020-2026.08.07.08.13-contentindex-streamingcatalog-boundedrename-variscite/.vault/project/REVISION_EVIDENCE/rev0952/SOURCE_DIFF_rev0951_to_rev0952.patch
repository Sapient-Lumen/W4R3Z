+
+    scan.reset();
+    scan = fixture.make_scan_owner(catalog_db);
+    require(
+        scan->snapshot_or_throw() == migrated &&
+            scan->scan_progress_snapshot_or_throw() == migrated_progress,
+        "rev0951 migration was not a stable one-time upgrade");
