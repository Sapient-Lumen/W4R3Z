+        "the callback ceiling has an executable off-by-one proof",
+    )
+    require(
+        checks,
+        all(
+            marker in focused
+            for marker in (
+                "row_limit",
+                "decoded_text_byte_limit",
+                "retained_text_byte_limit",
+                "elapsed_time_limit",
