+            verify_profiled_open_sqlite_ledger_snapshot_readonly(
+                db, label, budget);
+        budget.detach();
+        return result;
+    } catch (...) {
+        budget.detach();
+        budget.throw_if_exhausted();
+        throw;
+    }
