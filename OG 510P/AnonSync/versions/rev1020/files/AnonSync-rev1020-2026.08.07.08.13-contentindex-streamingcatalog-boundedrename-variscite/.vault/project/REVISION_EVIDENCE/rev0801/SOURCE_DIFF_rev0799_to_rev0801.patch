+#if defined(__unix__) || defined(__APPLE__)
+
+bool write_exact(int fd, const void* data, std::size_t count) noexcept {
+    const auto* cursor = static_cast<const unsigned char*>(data);
+    while (count != 0U) {
+        const ssize_t rc = ::write(fd, cursor, count);
+        if (rc < 0 && errno == EINTR) continue;
+        if (rc <= 0) return false;
+        const auto amount = static_cast<std::size_t>(rc);
+        cursor += amount;
+        count -= amount;
+    }
+    return true;
+}
+
+bool read_exact(int fd, void* data, std::size_t count) noexcept {
+    auto* cursor = static_cast<unsigned char*>(data);
+    while (count != 0U) {
+        const ssize_t rc = ::read(fd, cursor, count);
+        if (rc < 0 && errno == EINTR) continue;
+        if (rc <= 0) return false;
+        const auto amount = static_cast<std::size_t>(rc);
+        cursor += amount;
+        count -= amount;
+    }
+    return true;
+}
