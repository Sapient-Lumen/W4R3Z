+void test_pure_incarnation_algebra(TestState& test) {
+    constexpr std::uint32_t parent_pid = 101U;
+    constexpr std::uint32_t child_pid = 202U;
+    constexpr std::uint32_t sibling_pid = 303U;
+    constexpr SyncSqliteProcessId parent =
+        compose_sync_sqlite_process_incarnation(1U, parent_pid);
+    constexpr SyncSqliteProcessId child =
+        advance_sync_sqlite_process_incarnation_after_fork(parent, child_pid);
+    constexpr SyncSqliteProcessId sibling =
+        advance_sync_sqlite_process_incarnation_after_fork(parent, sibling_pid);
+    constexpr SyncSqliteProcessId recycled =
+        advance_sync_sqlite_process_incarnation_after_fork(child, parent_pid);
+
+    test.require(parent != 0 &&
+                     sync_sqlite_kernel_pid_from_incarnation(parent) == parent_pid &&
+                     sync_sqlite_lineage_generation_from_incarnation(parent) == 1U,
+                 "composition preserves exact PID and generation");
+    test.require(child != parent &&
+                     sync_sqlite_lineage_generation_from_incarnation(child) == 2U,
+                 "child receives a distinct next-generation token");
+    test.require(
+        advance_sync_sqlite_process_incarnation_after_fork(child, child_pid) ==
+            child,
+        "fork child hook is idempotent after an earlier handler refreshed the PID");
+    test.require(sibling != child &&
+                     sync_sqlite_lineage_generation_from_incarnation(sibling) == 2U,
+                 "siblings differ by PID within one generation");
+    test.require(recycled != parent &&
+                     sync_sqlite_kernel_pid_from_incarnation(recycled) == parent_pid &&
+                     sync_sqlite_lineage_generation_from_incarnation(recycled) == 3U,
+                 "recycled ancestor PID cannot resurrect ancestor authority");
+    test.require(refresh_sync_sqlite_process_incarnation(parent, parent_pid) == parent,
+                 "same PID refresh is stable");
+    test.require(refresh_sync_sqlite_process_incarnation(parent, child_pid) == child,
+                 "unexpected PID change advances as a fallback");
+    test.require(refresh_sync_sqlite_process_incarnation(0, parent_pid) == parent,
+                 "pristine process state mints generation one");
+    test.require(refresh_sync_sqlite_process_incarnation(
+                     kSyncSqlitePoisonedProcessIncarnation, parent_pid) == 0,
+                 "poisoned lineage cannot be reminted");
+    const SyncSqliteProcessId maximum = compose_sync_sqlite_process_incarnation(
+        kSyncSqliteMaximumLineageGeneration, parent_pid);
+    test.require(advance_sync_sqlite_process_incarnation_after_fork(
+                     maximum, child_pid) == 0,
+                 "lineage exhaustion fails closed before wraparound");
+    test.require(compose_sync_sqlite_process_incarnation(0, parent_pid) == 0 &&
+                     compose_sync_sqlite_process_incarnation(1, 0) == 0,
+                 "zero generation or PID cannot compose authority");
+}
