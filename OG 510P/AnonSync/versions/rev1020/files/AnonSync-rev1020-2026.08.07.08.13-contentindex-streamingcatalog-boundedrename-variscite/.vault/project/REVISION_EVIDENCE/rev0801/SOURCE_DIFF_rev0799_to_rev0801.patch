+void test_direct_fork(TestState& test) {
+    const SyncSqliteProcessId parent = current_sync_sqlite_process_id_noexcept();
+    int fds[2]{-1, -1};
+    if (::pipe(fds) != 0) throw std::runtime_error("pipe failed");
+    const pid_t child = ::fork();
+    if (child < 0) throw std::runtime_error("fork failed");
+    if (child == 0) {
+        (void)::close(fds[0]);
+        const SyncSqliteProcessId token = current_sync_sqlite_process_id_noexcept();
+        const bool ok = token != parent &&
+                        sync_sqlite_lineage_generation_from_incarnation(token) ==
+                            sync_sqlite_lineage_generation_from_incarnation(parent) + 1U &&
+                        write_exact(fds[1], &token, sizeof(token));
+        (void)::close(fds[1]);
+        std::_Exit(ok ? 0 : 90);
+    }
+    (void)::close(fds[1]);
+    SyncSqliteProcessId token = 0;
+    const bool received = read_exact(fds[0], &token, sizeof(token));
+    (void)::close(fds[0]);
+    const int status = wait_for_child(child);
+    test.require(received && WIFEXITED(status) && WEXITSTATUS(status) == 0,
+                 "direct child receives and reports a valid token");
+    test.require(sync_sqlite_kernel_pid_from_incarnation(token) ==
+                     static_cast<std::uint32_t>(child),
+                 "direct child token binds child PID");
+    test.require(current_sync_sqlite_process_id_noexcept() == parent,
+                 "child generation cannot mutate parent state");
+}
+
+void test_unobserved_intermediate_fork(TestState& test) {
+    const SyncSqliteProcessId parent = current_sync_sqlite_process_id_noexcept();
+    int fds[2]{-1, -1};
+    if (::pipe(fds) != 0) throw std::runtime_error("deep-fork pipe failed");
+    const pid_t intermediate = ::fork();
+    if (intermediate < 0) throw std::runtime_error("intermediate fork failed");
+    if (intermediate == 0) {
+        (void)::close(fds[0]);
+        // Do not inspect the token here. The atfork hook must preserve this edge.
+        const pid_t grandchild = ::fork();
+        if (grandchild < 0) std::_Exit(91);
+        if (grandchild == 0) {
+            const SyncSqliteProcessId token = current_sync_sqlite_process_id_noexcept();
+            const bool sent = write_exact(fds[1], &token, sizeof(token));
+            (void)::close(fds[1]);
+            std::_Exit(sent ? 0 : 92);
+        }
+        (void)::close(fds[1]);
+        const int status = wait_for_child(grandchild);
+        std::_Exit(WIFEXITED(status) && WEXITSTATUS(status) == 0 ? 0 : 93);
+    }
+    (void)::close(fds[1]);
+    SyncSqliteProcessId token = 0;
+    const bool received = read_exact(fds[0], &token, sizeof(token));
+    (void)::close(fds[0]);
+    const int status = wait_for_child(intermediate);
+    test.require(received && WIFEXITED(status) && WEXITSTATUS(status) == 0,
+                 "grandchild reports through an unobserved intermediate fork");
+    test.require(sync_sqlite_lineage_generation_from_incarnation(token) ==
+                     sync_sqlite_lineage_generation_from_incarnation(parent) + 2U,
+                 "every ordinary fork edge advances lineage before child code");
+}
+
+void test_inherited_token_fail_stop(TestState& test) {
+    const SyncSqliteProcessId parent = current_sync_sqlite_process_id_noexcept();
+    const pid_t child = ::fork();
+    if (child < 0) throw std::runtime_error("hostile fork failed");
+    if (child == 0) {
+        require_sync_sqlite_process_id_or_fail_stop(parent, "inherited token");
+        std::_Exit(94);
+    }
+    const int status = wait_for_child(child);
+    test.require(WIFEXITED(status) &&
+                     WEXITSTATUS(status) == kSyncSqliteCapabilityViolationExitCode,
+                 "inherited parent token takes direct fail-stop path");
+}
+
+#else
+
+void test_direct_fork(TestState& test) {
+    test.require(true, "fork proof unavailable on this platform");
+}
+void test_unobserved_intermediate_fork(TestState& test) {
+    test.require(true, "deep-fork proof unavailable on this platform");
+}
+void test_inherited_token_fail_stop(TestState& test) {
+    test.require(true, "inherited-token proof unavailable on this platform");
+}
+
+#endif
+
+}  // namespace
+
+int main() {
+    TestState test;
+    try {
+        test_pure_incarnation_algebra(test);
+        test_live_process_token(test);
+        test_direct_fork(test);
+        test_unobserved_intermediate_fork(test);
+        test_inherited_token_fail_stop(test);
+    } catch (const std::exception& error) {
+        ++test.failed;
+        std::cerr << "FAIL: unexpected exception: " << error.what() << "\n";
+    }
+    std::cout << "anonsync sqlite process incarnation tests checks="
+              << test.passed << " failed=" << test.failed << "\n";
+    return test.failed == 0U ? EXIT_SUCCESS : EXIT_FAILURE;
+}
