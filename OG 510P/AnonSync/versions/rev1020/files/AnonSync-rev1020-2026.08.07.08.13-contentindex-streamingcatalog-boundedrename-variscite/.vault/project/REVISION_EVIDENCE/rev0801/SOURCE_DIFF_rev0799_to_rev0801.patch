+void create_fixture(const fs::path& path) {
+    sqlite3* database = nullptr;
+    sqlite_or_throw(sqlite3_open_v2(
+                        path.c_str(), &database,
+                        SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE |
+                            SQLITE_OPEN_FULLMUTEX,
+                        nullptr),
