+int wait_for_child(pid_t child) {
+    int status = 0;
+    for (;;) {
+        const pid_t waited = ::waitpid(child, &status, 0);
+        if (waited == child) return status;
+        if (waited < 0 && errno == EINTR) continue;
+        throw std::runtime_error("waitpid failed");
+    }
+}
