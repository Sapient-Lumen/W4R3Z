+void test_live_process_token(TestState& test) {
+    const SyncSqliteProcessId first = current_sync_sqlite_process_id_noexcept();
+    const SyncSqliteProcessId second = current_sync_sqlite_process_id_noexcept();
+    test.require(first != 0 && first == second,
+                 "live token is nonzero and stable");
+#if defined(_WIN32)
+    const auto pid = static_cast<std::uint32_t>(::_getpid());
+#else
+    const auto pid = static_cast<std::uint32_t>(::getpid());
+#endif
+    test.require(sync_sqlite_kernel_pid_from_incarnation(first) == pid,
+                 "live token binds current kernel PID");
+    test.require(sync_sqlite_lineage_generation_from_incarnation(first) != 0,
+                 "live token binds a nonzero lineage generation");
+    test.require(first != static_cast<SyncSqliteProcessId>(pid),
+                 "live token is not a raw recyclable PID");
+    require_sync_sqlite_process_id_or_fail_stop(first, "live process token");
+    test.require(true, "current token authorizes current process");
+}
