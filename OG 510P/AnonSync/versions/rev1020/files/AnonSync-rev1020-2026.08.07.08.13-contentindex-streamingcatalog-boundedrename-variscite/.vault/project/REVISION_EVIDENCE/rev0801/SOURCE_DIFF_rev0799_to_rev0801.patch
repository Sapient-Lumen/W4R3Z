+#pragma once
+
+#include "sync_sqlite_process_incarnation.hpp"
+
+#include <cstdint>
+#include <limits>
+
+namespace anonsync::detail {
+
+// The low half records the currently observed kernel PID. The high half is a
+// fork-lineage generation. A registered child-after-fork hook advances the
+// generation before child code can run. The ordinary refresh path also detects
+// an unexpected PID change as a fail-closed fallback.
+inline constexpr unsigned kSyncSqliteKernelPidBits = 32U;
+inline constexpr SyncSqliteProcessId kSyncSqliteKernelPidMask =
+    (SyncSqliteProcessId{1} << kSyncSqliteKernelPidBits) - 1U;
+inline constexpr SyncSqliteProcessId kSyncSqliteMaximumLineageGeneration =
+    std::numeric_limits<SyncSqliteProcessId>::max() >>
+    kSyncSqliteKernelPidBits;
+// Generation zero is never valid. A nonzero generation-zero marker preserves
+// exhaustion as poisoned state instead of making it look uninitialized.
+inline constexpr SyncSqliteProcessId kSyncSqlitePoisonedProcessIncarnation = 1U;
+
+[[nodiscard]] constexpr std::uint32_t
+sync_sqlite_kernel_pid_from_incarnation(
+    SyncSqliteProcessId incarnation) noexcept {
+    return static_cast<std::uint32_t>(
+        incarnation & kSyncSqliteKernelPidMask);
+}
+
+[[nodiscard]] constexpr std::uint32_t
+sync_sqlite_lineage_generation_from_incarnation(
+    SyncSqliteProcessId incarnation) noexcept {
+    return static_cast<std::uint32_t>(
+        incarnation >> kSyncSqliteKernelPidBits);
+}
+
+[[nodiscard]] constexpr std::uint32_t
+next_sync_sqlite_fork_lineage_generation(
+    SyncSqliteProcessId current_generation) noexcept {
+    if (current_generation == 0U ||
+        current_generation >= kSyncSqliteMaximumLineageGeneration) {
+        return 0U;
+    }
+    return static_cast<std::uint32_t>(current_generation + 1U);
+}
+
+[[nodiscard]] constexpr SyncSqliteProcessId
+compose_sync_sqlite_process_incarnation(
+    SyncSqliteProcessId generation,
+    std::uint32_t kernel_pid) noexcept {
+    if (kernel_pid == 0U || generation == 0U ||
+        generation > kSyncSqliteMaximumLineageGeneration) {
+        return 0;
+    }
+    return (generation << kSyncSqliteKernelPidBits) |
+           static_cast<SyncSqliteProcessId>(kernel_pid);
+}
+
+[[nodiscard]] constexpr SyncSqliteProcessId
+refresh_sync_sqlite_process_incarnation(
+    SyncSqliteProcessId observed,
+    std::uint32_t current_kernel_pid) noexcept {
+    if (current_kernel_pid == 0U) return 0;
+
+    const SyncSqliteProcessId observed_generation =
+        observed >> kSyncSqliteKernelPidBits;
+    const std::uint32_t observed_pid =
+        sync_sqlite_kernel_pid_from_incarnation(observed);
+    if (observed != 0 && observed_generation == 0) return 0;
+    if (observed != 0 && observed_pid == current_kernel_pid) return observed;
+
+    const SyncSqliteProcessId next_generation =
+        observed == 0
+            ? 1U
+            : next_sync_sqlite_fork_lineage_generation(observed_generation);
+    return compose_sync_sqlite_process_incarnation(
+        next_generation, current_kernel_pid);
+}
+
+[[nodiscard]] constexpr SyncSqliteProcessId
+advance_sync_sqlite_process_incarnation_after_fork(
+    SyncSqliteProcessId observed,
+    std::uint32_t child_kernel_pid) noexcept {
+    // A child handler registered earlier may already have asked for the
+    // current token. The PID-mismatch fallback then records this fork edge
+    // before our handler runs. Reusing the same refresh rule makes the child
+    // hook idempotent instead of invalidating authority minted by that earlier
+    // handler with a second generation increment.
+    return refresh_sync_sqlite_process_incarnation(
+        observed, child_kernel_pid);
+}
+
+}  // namespace anonsync::detail
