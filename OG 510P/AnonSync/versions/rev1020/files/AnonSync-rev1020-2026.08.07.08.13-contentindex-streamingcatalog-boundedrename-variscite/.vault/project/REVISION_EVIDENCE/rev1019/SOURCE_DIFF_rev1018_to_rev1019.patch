+[[nodiscard]] std::optional<LocalIdentityPreservingRenameCandidate>
+find_unique_absent_identity_preserving_rename_source_or_none(
+    const SyncReplicaFolderCatalogSnapshot& catalog,
+    const SyncReplicaModel& model,
+    const SyncDirectoryAuthority& root,
+    std::string_view destination_canonical_path,
+    std::uint64_t size_bytes,
+    std::string_view content_sha256,
+    const std::string& label) {
+    std::optional<LocalIdentityPreservingRenameCandidate> selected;
+    for (const SyncReplicaFolderCatalogEntry& entry : catalog.entries) {
+        if (entry.kind != SyncReplicaValueKind::File ||
+            entry.canonical_path == destination_canonical_path ||
+            entry.size_bytes != size_bytes ||
+            entry.content_sha256 != content_sha256) {
+            continue;
+        }
+
+        const auto view = model.visible_path(entry.canonical_path);
+        if (!view.has_value() ||
+            view->visible_operation_ids.size() != 1U ||
+            view->visible_operation_ids.front() != entry.operation_id) {
+            continue;
+        }
+        const auto operation = model.operation_by_id(entry.operation_id);
+        if (!operation.has_value() ||
+            !operation_matches_catalog_entry(*operation, entry)) {
+            continue;
+        }
+
+        // Identity is unambiguous only when the complete retained namespace has
+        // exactly one visible file with this content and that path is both
+        // materialized and rooted-absent. A still-present copy or metadata-only
+        // omission is an equally plausible source, so ordinary create/delete
+        // publication must win. This component lookup reads no file bytes.
+        if (!sync_replica_selective_sync_path_is_materialized(
+                catalog.selective_sync_policy, entry.canonical_path) ||
+            open_optional_regular_file_beneath_root_or_throw(
+                root, entry.canonical_path,
+                label + " candidate-source absence reproof")
+                .has_value() ||
+            selected.has_value()) {
+            return std::nullopt;
+        }
+        selected = LocalIdentityPreservingRenameCandidate{
+            entry, *operation};
+    }
+    if (!selected.has_value() ||
+        !visible_file_content_is_unique_to_operation(
+            model, selected->source_file_operation.operation_id,
+            size_bytes, content_sha256)) {
+        // A still-present duplicate is just as ambiguous as two absent
+        // predecessors. Detect it before payload/database authority so the
+        // caller can use ordinary create/delete semantics instead of failing
+        // after rename planning has begun.
+        return std::nullopt;
+    }
+    return selected;
+}
