+        active_operation_by_id_or_none(source_tombstone_operation_id);
+    if (source_tombstone == nullptr ||
+        source_tombstone->kind != SyncReplicaValueKind::Tombstone ||
+        source_tombstone->predecessor_operation_ids.size() != 1U) {
+        return std::nullopt;
