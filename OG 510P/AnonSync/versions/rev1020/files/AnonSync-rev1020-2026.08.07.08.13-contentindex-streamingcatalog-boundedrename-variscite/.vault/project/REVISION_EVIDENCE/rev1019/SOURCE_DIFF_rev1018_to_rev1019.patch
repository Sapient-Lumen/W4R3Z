+[[nodiscard]] bool visible_file_content_is_unique_to_operation(
+    const SyncReplicaModel& model,
+    std::string_view operation_id,
+    std::uint64_t size_bytes,
+    std::string_view content_sha256) {
+    std::uint64_t matching_file_count = 0U;
+    bool exact_operation_seen = false;
+    model.for_each_active_path(
+        [&](const SyncReplicaPathView& view,
+            std::span<const SyncReplicaOperation* const>) {
+            for (const std::string& visible_operation_id :
+                 view.visible_operation_ids) {
+                const auto operation =
+                    model.operation_by_id(visible_operation_id);
+                if (!operation.has_value() ||
+                    operation->kind != SyncReplicaValueKind::File ||
+                    operation->size_bytes != size_bytes ||
+                    operation->content_sha256 != content_sha256) {
+                    continue;
+                }
+                matching_file_count = increment_or_throw(
+                    matching_file_count,
+                    "sync replica local rename visible-content count");
+                if (operation->operation_id == operation_id) {
+                    exact_operation_seen = true;
+                }
+            }
+        });
+    return matching_file_count == 1U && exact_operation_seen;
+}
