+void test_atomic_identity_preserving_rename_publication() {
+    TempDatabasePath file("anonsync-replica-sqlite-owner-rename");
+    const std::string folder = "folder-sqlite-rename";
+    const SyncReplicaActor local = actor("device-sqlite-rename", 1099U);
+    SyncSqliteDb db = open_database(file.path);
+    SyncReplicaSqliteOwner owner(
+        db.db, folder, local, limits(32U),
+        "identity-preserving rename owner");
+
+    const SyncReplicaSqliteSnapshot empty = owner.snapshot_or_throw();
+    const std::string source_path = "media/source.bin";
+    const std::string destination_path = "media/destination.bin";
+    const std::string content = anonsync::sha256_hex("rename-bytes");
+    const std::vector<std::string> absent_heads;
+    const SyncReplicaOperation source =
+        owner.publish_local_file_from_observed_heads_or_throw(
+            source_path, absent_heads, 12U, content);
+    const SyncReplicaSqliteSnapshot source_published = owner.snapshot_or_throw();
+    require(
+        source_published.state_generation == empty.state_generation + 1U &&
+            source_published.durable.operations.size() == 1U,
+        "rename seed did not publish one source file");
+
+    const SyncReplicaSqliteSnapshot before_mismatch = owner.snapshot_or_throw();
+    require_error(
+        [&] {
+            (void)owner.
+                publish_local_identity_preserving_rename_from_observed_heads_or_throw(
+                    source_path,
+                    std::vector<std::string>{source.operation_id},
+                    destination_path, absent_heads, 13U, content);
+        },
+        "source head does not match",
+        "rename publication accepted mismatched source content metadata");
+    require(
+        owner.snapshot_or_throw() == before_mismatch,
+        "rejected mismatched rename changed durable replica state");
+
+    const auto renamed =
+        owner.publish_local_identity_preserving_rename_from_observed_heads_or_throw(
+            source_path, std::vector<std::string>{source.operation_id},
+            destination_path, absent_heads, 12U, content);
+    const SyncReplicaSqliteSnapshot committed = owner.snapshot_or_throw();
+    anonsync::SyncReplicaModel model =
+        anonsync::SyncReplicaModel::restore_or_throw(
+            committed.durable, committed.limits.model);
+    const auto source_view = model.visible_path(source_path);
+    const auto destination_view = model.visible_path(destination_path);
+    require(
+        renamed.state_generation == source_published.state_generation + 1U &&
+            committed.state_generation == renamed.state_generation &&
+            renamed.cutpoint_digest == committed.cutpoint_digest &&
+            committed.durable.last_local_counter == 3U &&
+            committed.durable.operations.size() == 3U &&
+            committed.outbox.empty(),
+        "atomic rename did not commit two operations under one durable generation");
+    require(
+        renamed.destination_file_operation.kind ==
+                anonsync::SyncReplicaValueKind::File &&
+            renamed.destination_file_operation.canonical_path ==
+                destination_path &&
+            renamed.source_tombstone_operation.kind ==
+                anonsync::SyncReplicaValueKind::Tombstone &&
+            renamed.source_tombstone_operation.canonical_path == source_path &&
+            renamed.source_tombstone_operation.predecessor_operation_ids ==
+                std::vector<std::string>{
+                    renamed.destination_file_operation.operation_id},
+        "atomic rename did not mint the consecutive destination/source shape");
+    require(
+        source_view.has_value() &&
+            source_view->visible_operation_ids ==
+                std::vector<std::string>{
+                    renamed.source_tombstone_operation.operation_id} &&
+            destination_view.has_value() &&
+            destination_view->visible_operation_ids ==
+                std::vector<std::string>{
+                    renamed.destination_file_operation.operation_id},
+        "atomic rename did not publish exact terminal path projections");
