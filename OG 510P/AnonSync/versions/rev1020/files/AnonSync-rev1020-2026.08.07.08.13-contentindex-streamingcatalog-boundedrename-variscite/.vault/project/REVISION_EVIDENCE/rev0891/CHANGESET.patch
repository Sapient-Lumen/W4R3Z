+void attest_durable_backend_profile_or_throw(
+    SyncSqliteDbHandleSlot& db,
+    const std::string& label) {
+    require_connection_profile_or_throw(db, label + " connection profile");
+    sqlite3* const handle = db.get();
+    if (handle == nullptr) {
+        throw std::logic_error(label + " SQLite handle is inactive");
+    }
+    const char* const filename = sqlite3_db_filename(handle, "main");
+    if (filename == nullptr || filename[0] == '\0') {
+        throw std::runtime_error(
+            label + " membership database has no durable main filename");
+    }
+    if (sqlite3_db_readonly(handle, "main") != 0) {
+        throw std::runtime_error(
+            label + " membership database is not writable durable authority");
+    }
+    const std::string journal_mode = pragma_text_or_throw(
+        db, "PRAGMA main.journal_mode;", label + " journal mode");
+    if (journal_mode != "wal" && journal_mode != "delete" &&
+        journal_mode != "truncate" && journal_mode != "persist") {
+        throw std::runtime_error(
+            label + " membership journal mode is not durable");
+    }
+    const std::uint64_t synchronous = pragma_u64_or_throw(
+        db, "PRAGMA main.synchronous;", label + " synchronous mode");
+    // SQLite's durability matrix distinguishes WAL from rollback journals:
+    // FULL syncs the WAL at commit, while rollback-journal FULL can still omit
+    // the extra directory/journal sync needed for a power-loss durability
+    // claim. Require EXTRA for DELETE/TRUNCATE/PERSIST and FULL for WAL. These
+    // are necessary backend policy observations, not proof that a VFS,
+    // filesystem, controller, or storage device honors sync requests.
+    const std::uint64_t required_synchronous =
+        journal_mode == "wal" ? 2U : 3U;
+    if (synchronous < required_synchronous) {
+        throw std::runtime_error(
+            label + (journal_mode == "wal"
+                         ? " membership WAL synchronous mode is below FULL"
+                         : " membership rollback-journal synchronous mode is below EXTRA"));
+    }
+}
