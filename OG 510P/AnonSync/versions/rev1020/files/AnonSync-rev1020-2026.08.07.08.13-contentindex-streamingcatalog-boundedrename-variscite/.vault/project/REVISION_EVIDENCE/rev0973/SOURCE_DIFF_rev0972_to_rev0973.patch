+            "historical-version unpin did not publish the exact successor set");
+        const SyncReplicaSqliteSnapshot one_pin = owner.snapshot_or_throw();
+        const auto absent = owner.unpin_historical_version_or_throw(first.operation_id);
+        require(
+            absent.disposition ==
+                    anonsync::SyncReplicaSqliteHistoricalVersionPinDisposition::
+                        AlreadyUnpinned &&
+                absent.state_generation == one_pin.state_generation &&
+                absent.pin_count == 1U &&
+                absent.pin_set_digest ==
