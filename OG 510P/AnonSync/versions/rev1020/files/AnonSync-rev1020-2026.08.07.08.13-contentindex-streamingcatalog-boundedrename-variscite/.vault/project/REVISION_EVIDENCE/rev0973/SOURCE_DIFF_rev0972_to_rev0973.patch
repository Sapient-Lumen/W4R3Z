+    require(
+        anonsync::sync_replica_sqlite_historical_version_pin_disposition_name(
+            anonsync::SyncReplicaSqliteHistoricalVersionPinDisposition::Pinned) ==
+                "pinned" &&
+            anonsync::sync_replica_sqlite_historical_version_pin_disposition_name(
+                anonsync::SyncReplicaSqliteHistoricalVersionPinDisposition::
+                    AlreadyPinned) == "already_pinned" &&
+            anonsync::sync_replica_sqlite_historical_version_pin_disposition_name(
+                anonsync::SyncReplicaSqliteHistoricalVersionPinDisposition::
+                    Unpinned) == "unpinned" &&
+            anonsync::sync_replica_sqlite_historical_version_pin_disposition_name(
+                anonsync::SyncReplicaSqliteHistoricalVersionPinDisposition::
+                    AlreadyUnpinned) == "already_unpinned",
+        "historical-version pin dispositions are not stable operator words");
