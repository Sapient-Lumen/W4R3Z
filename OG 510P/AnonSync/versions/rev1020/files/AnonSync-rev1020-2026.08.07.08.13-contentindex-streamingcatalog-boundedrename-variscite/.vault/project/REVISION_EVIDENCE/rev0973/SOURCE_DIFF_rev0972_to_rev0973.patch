+        SyncReplicaSqliteOwner owner(
+            db.db, folder, local, fixture_limits,
+            "retention-v5 fixture source owner");
+        const std::vector<std::string> destinations{destination};
+        operation = owner.create_local_file_or_throw(
+            "legacy-v5/file.bin", 9U,
+            anonsync::sha256_hex("legacy-v5"), destinations);
+        source = owner.snapshot_or_throw();
+    }
+    if (!source.historical_version_pins.empty() ||
+        source.historical_version_pin_count != 0U) {
+        fail("retention-v5 fixture source unexpectedly contains pins");
+    }
+
+    LegacyV1Meta meta = legacy_meta_from_snapshot(source);
+    meta.cutpoint_digest = retention_root_v5_cutpoint_digest(meta);
+
+    const std::string v6_meta_sql = scalar_text_query(
+        db,
+        "SELECT sql FROM main.sqlite_schema "
+        "WHERE type='table' AND name='sync_replica_meta';",
+        "retention-v5 source meta SQL");
+    std::string v5_meta_sql = v6_meta_sql;
+    const auto replace_once = [&](std::string_view from, std::string_view to,
+                                  const std::string& label) {
+        const std::size_t at = v5_meta_sql.find(from);
+        if (at == std::string::npos ||
+            v5_meta_sql.find(from, at + from.size()) != std::string::npos) {
+            fail("retention-v5 fixture could not identify one " + label);
+        }
+        v5_meta_sql.replace(at, from.size(), to);
+    };
+    replace_once("schema_version=6", "schema_version=5",
+                 "schema-version check");
+    replace_once(
+        "historical_version_pin_count_be BLOB NOT NULL "
+        "CHECK(length(historical_version_pin_count_be)=8),",
+        "", "pin-count column");
+    replace_once(
+        "historical_version_pin_set_digest TEXT NOT NULL "
+        "CHECK(length(historical_version_pin_set_digest)=64),",
+        "", "pin-digest column");
+
+    exec(db, "BEGIN IMMEDIATE;");
+    exec(db,
+         "CREATE TEMP TABLE sync_replica_retention_v5_meta AS SELECT "
+         "id,5 AS schema_version,folder_id,local_device_id,local_epoch_be,"
+         "last_local_counter_be,state_generation_be,policy_generation_be,"
+         "max_operations_be,max_context_entries_be,max_predecessor_ids_be,"
+         "max_canonical_operation_bytes_be,max_retained_canonical_bytes_be,"
+         "max_retained_context_entries_be,max_retained_predecessor_ids_be,"
+         "max_outbox_intents_be,max_outbox_destination_bytes_be,"
+         "max_outbox_clock_uncertainty_ns_be,"
+         "max_outbox_clock_forward_step_seconds_be,"
+         "max_outbox_clock_realtime_lag_seconds_be,evidence_count_be,"
+         "active_count_be,retained_canonical_bytes_be,"
+         "retained_context_entries_be,retained_predecessor_ids_be,"
+         "outbox_intent_count_be,outbox_destination_bytes_be,"
+         "local_actor_compromised,local_operation_digest,"
+         "operation_set_digest,evidence_set_digest,visible_state_digest,"
+         "outbox_digest,cutpoint_digest FROM main.sync_replica_meta WHERE id=1;");
+    anonsync::SyncSqliteStmt meta_update = anonsync::sqlite_prepare_or_throw(
+        db.db,
+        "UPDATE temp.sync_replica_retention_v5_meta "
+        "SET cutpoint_digest=? WHERE id=1;",
+        "retention-v5 fixture meta prepare");
+    anonsync::sqlite_bind_text_or_throw(
+        meta_update.stmt, 1, meta.cutpoint_digest,
+        "retention-v5 fixture bind cutpoint");
+    anonsync::sqlite_step_done_or_throw(
+        meta_update.stmt, "retention-v5 fixture meta update");
+    exec(db,
+         "DROP TABLE main.sync_replica_history_pins;"
+         "DROP TABLE main.sync_replica_meta;");
+    exec(db, v5_meta_sql + ";");
+    exec(db,
+         "INSERT INTO main.sync_replica_meta SELECT * FROM "
+         "temp.sync_replica_retention_v5_meta;"
+         "DROP TABLE temp.sync_replica_retention_v5_meta;"
+         "COMMIT;");
+    return {operation, source, meta};
