+            restarted.unpin_historical_version_or_throw(second_id);
+        require(
+            removed.disposition ==
+                    anonsync::SyncReplicaSqliteHistoricalVersionPinDisposition::
+                        Unpinned &&
+                removed.pin_count == 0U,
+            "restart could not remove the retained policy root");
+    }
