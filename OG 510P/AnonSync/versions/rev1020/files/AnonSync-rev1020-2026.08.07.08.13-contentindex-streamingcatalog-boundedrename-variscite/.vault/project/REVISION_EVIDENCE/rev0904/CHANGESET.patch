+void test_schema_shadow_and_row_tamper_rejections() {
+    TemporaryDirectory temporary;
+    const fs::path path = temporary.path() / "membership.sqlite";
+    auto database = open_database(path, true);
+    const auto exact = binding(
+        temporary, path,
