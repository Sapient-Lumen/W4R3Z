+    }
+    test.require(
+        wrong_vfs_rejected,
+        "descriptor-rooted attestation rejects a same-path default-VFS connection");
+    sqlite_or_throw(
+        sqlite3_close(wrong_vfs_database), wrong_vfs_database,
