+    const ResourceClock::time_point started_at = ResourceClock::now();
+    const auto aggregate_timeout = std::chrono::milliseconds(
+        static_cast<std::chrono::milliseconds::rep>(timeout_milliseconds));
+    if (started_at > ResourceClock::time_point::max() - aggregate_timeout) {
+        throw std::overflow_error("resources aggregate deadline overflows");
+    }
+    const ResourceClock::time_point aggregate_deadline =
+        started_at + aggregate_timeout;
