+#!/usr/bin/env python3
+"""Real-process proof for owner-only Linux resource sampling and aggregation."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+import socket
+import stat
+import subprocess
+import sys
+import tempfile
+import time
+from typing import Any
+
+
+CHECKS = 0
+
+
+def require(condition: bool, message: str) -> None:
+    global CHECKS
+    CHECKS += 1
+    if not condition:
+        raise RuntimeError(message)
+
+
+def run_json(argv: list[str], *, expect_success: bool = True) -> tuple[subprocess.CompletedProcess[str], dict[str, Any]]:
+    result = subprocess.run(
+        argv,
+        check=False,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=20,
+    )
+    if expect_success and result.returncode != 0:
+        raise RuntimeError(
+            f"command failed ({result.returncode}): {' '.join(argv)}\n"
+            f"stdout={result.stdout}\nstderr={result.stderr}"
+        )
+    document: dict[str, Any] = {}
+    if result.stdout.strip():
+        try:
+            value = json.loads(result.stdout.splitlines()[0])
+        except json.JSONDecodeError as error:
+            raise RuntimeError(
+                f"command did not emit a valid first JSON line: {result.stdout!r}"
+            ) from error
+        if not isinstance(value, dict):
+            raise RuntimeError("command JSON response is not an object")
+        document = value
+    return result, document
+
+
+def wait_for_socket(path: Path, process: subprocess.Popen[str]) -> None:
+    deadline = time.monotonic() + 10.0
+    while time.monotonic() < deadline:
+        if process.poll() is not None:
+            raise RuntimeError(f"fixture exited early with status {process.returncode}")
+        try:
+            mode = path.lstat().st_mode
+        except FileNotFoundError:
+            time.sleep(0.01)
+            continue
+        if stat.S_ISSOCK(mode) and stat.S_IMODE(mode) == 0o600:
+            return
+        time.sleep(0.01)
+    raise RuntimeError(f"timed out waiting for private socket {path}")
+
+
+def terminate_fixture(process: subprocess.Popen[str]) -> None:
+    if process.poll() is not None:
+        return
+    process.terminate()
+    try:
+        process.wait(timeout=3)
+    except subprocess.TimeoutExpired:
+        process.kill()
+        process.wait(timeout=3)
+
+
+def process_start_ticks() -> int:
+    stat_text = Path("/proc/self/stat").read_text(encoding="ascii")
+    command_end = stat_text.rfind(") ")
+    if command_end < 0:
+        raise RuntimeError("delayed server could not parse /proc/self/stat")
+    fields = stat_text[command_end + 2 :].split()
+    if len(fields) < 20:
+        raise RuntimeError("delayed server stat omitted field 22")
+    return int(fields[19])
+
+
+def delayed_server(socket_path: Path, delay_milliseconds: int) -> int:
+    if not socket_path.is_absolute():
+        raise RuntimeError("delayed server socket must be absolute")
+    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    try:
+        listener.bind(str(socket_path))
+        os.chmod(socket_path, 0o600)
+        listener.listen(1)
+        connection, _ = listener.accept()
+        with connection:
+            request = b""
+            while not request.endswith(b"\n") and len(request) < 64:
+                part = connection.recv(64 - len(request))
+                if not part:
+                    break
+                request += part
+            if request != b"resources\n":
+                return 2
+            time.sleep(delay_milliseconds / 1000.0)
+            memory = {
+                "rss_kib": 1,
+                "pss_kib": 1,
+                "pss_dirty_kib": 0,
+                "pss_anon_kib": 1,
+                "pss_file_kib": 0,
+                "pss_shmem_kib": 0,
+                "shared_clean_kib": 0,
+                "shared_dirty_kib": 0,
+                "private_clean_kib": 1,
+                "private_dirty_kib": 0,
+                "private_resident_kib": 1,
+                "shared_resident_kib": 0,
+                "referenced_kib": 1,
+                "anonymous_kib": 1,
+                "anonymous_huge_pages_kib": 0,
+                "shared_hugetlb_kib": 0,
+                "private_hugetlb_kib": 0,
+                "swap_kib": 0,
+                "swap_pss_kib": 0,
+                "locked_kib": 0,
+            }
+            usage = {
+                "peak_rss_kib": 1,
+                "minor_page_faults": 0,
+                "major_page_faults": 0,
+                "filesystem_input_operations": 0,
+                "filesystem_output_operations": 0,
+                "voluntary_context_switches": 0,
+                "involuntary_context_switches": 0,
+            }
+            response = {
+                "schema": "anonsync.local-process-resources.response.v1",
+                "command": "resources",
+                "terminal_class": "completed",
+                "server_pid": os.getpid(),
+                "process_start_time_clock_ticks": process_start_ticks(),
+                "clock_ticks_per_second": os.sysconf("SC_CLK_TCK"),
+                "page_size_bytes": os.sysconf("SC_PAGE_SIZE"),
+                "sample_monotonic_milliseconds": max(1, int(time.monotonic() * 1000)),
+                "memory": memory,
+                "usage": usage,
+                "open_file_descriptors": 4,
+                "threads": 1,
+            }
+            try:
+                connection.sendall(
+                    (json.dumps(response, separators=(",", ":")) + "\n").encode("utf-8")
+                )
+            except BrokenPipeError:
+                pass
+            # Keep the bound name alive through the client's final identity reproof.
+            time.sleep(0.1)
+    finally:
+        listener.close()
+        try:
+            socket_path.unlink()
+        except FileNotFoundError:
+            pass
+    return 0
+
+
+def main() -> int:
+    if "--delayed-server" in sys.argv:
+        delayed = argparse.ArgumentParser()
+        delayed.add_argument("--delayed-server", action="store_true")
+        delayed.add_argument("--socket", required=True, type=Path)
+        delayed.add_argument("--delay-milliseconds", required=True, type=int)
+        args = delayed.parse_args()
+        return delayed_server(args.socket, args.delay_milliseconds)
+
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--sync", required=True, type=Path)
+    parser.add_argument("--fixture", required=True, type=Path)
+    args = parser.parse_args()
+    sync = args.sync.resolve(strict=True)
+    fixture = args.fixture.resolve(strict=True)
+
+    with tempfile.TemporaryDirectory(prefix="anonsync-resources-process-") as raw:
+        root = Path(raw)
+        os.chmod(root, 0o700)
+        socket_a = root / "share-a.sock"
+        socket_a_alias = root / "share-a-alias.sock"
+        socket_b = root / "share-b.sock"
+        out_a = (root / "a.out").open("w", encoding="utf-8")
+        err_a = (root / "a.err").open("w", encoding="utf-8")
+        out_b = (root / "b.out").open("w", encoding="utf-8")
+        err_b = (root / "b.err").open("w", encoding="utf-8")
+        process_a = subprocess.Popen(
+            [
+                str(fixture),
+                "--socket",
+                str(socket_a),
+                "--socket",
+                str(socket_a_alias),
+                "--anonymous-bytes",
+                "0",
+            ],
+            text=True,
+            stdout=out_a,
+            stderr=err_a,
+        )
+        process_b = subprocess.Popen(
+            [
+                str(fixture),
+                "--socket",
+                str(socket_b),
+                "--anonymous-bytes",
+                str(48 * 1024 * 1024),
+            ],
+            text=True,
+            stdout=out_b,
+            stderr=err_b,
+        )
+        try:
+            wait_for_socket(socket_a, process_a)
+            wait_for_socket(socket_a_alias, process_a)
+            wait_for_socket(socket_b, process_b)
+            require(process_a.pid != process_b.pid, "fixtures did not use distinct processes")
+
+            _, aggregate = run_json(
+                [
+                    str(sync),
+                    "resources",
+                    "--socket",
+                    str(socket_a),
+                    "--socket",
+                    str(socket_b),
+                    "--timeout-milliseconds",
+                    "5000",
+                ]
+            )
+            require(
+                aggregate.get("schema") == "anonsync.local-process-resources.aggregate.v1",
+                "aggregate schema mismatch",
+            )
+            require(aggregate.get("command") == "resources", "aggregate command mismatch")
+            require(aggregate.get("terminal_class") == "completed", "aggregate did not complete")
+            require(aggregate.get("process_count") == 2, "aggregate process count mismatch")
+            require(aggregate.get("requested_timeout_milliseconds") == 5000,
+                    "aggregate did not report its requested total timeout")
+            require(aggregate.get("timeout_is_one_aggregate_deadline") is True,
+                    "aggregate did not bind one total deadline")
+            require(isinstance(aggregate.get("sample_span_milliseconds"), int) and
+                    aggregate["sample_span_milliseconds"] >= 0,
+                    "aggregate sample span is not a canonical nonnegative integer")
+            require(aggregate.get("rss_sum_double_counts_shared_pages") is True,
+                    "aggregate omitted RSS shared-page caveat")
+            require(aggregate.get("pss_values_use_kernel_share_adjustment") is True,
+                    "aggregate omitted PSS interpretation")
+            require(aggregate.get("samples_are_sequential_not_atomic") is True,
+                    "aggregate omitted sequential-sample caveat")
+            require(aggregate.get("measurement_is_diagnostic_only") is True,
+                    "aggregate overstated diagnostic evidence as authority")
+            require(aggregate.get("ordinary_status_remains_procfs_cold") is True,
+                    "aggregate omitted the ordinary-status observation boundary")
+            samples = aggregate.get("samples")
+            require(isinstance(samples, list) and len(samples) == 2,
+                    "aggregate sample list mismatch")
+            by_socket = {
+                sample["socket"]: sample["resources"]
+                for sample in samples
+            }
+            require(set(by_socket) == {str(socket_a), str(socket_b)},
+                    "aggregate did not preserve exact socket identities")
+            first = by_socket[str(socket_a)]
+            second = by_socket[str(socket_b)]
+            require(first["server_pid"] == process_a.pid,
+                    "first sample PID was not peer-bound")
+            require(second["server_pid"] == process_b.pid,
+                    "second sample PID was not peer-bound")
+            require(
+                first["process_start_time_clock_ticks"] !=
+                second["process_start_time_clock_ticks"] or
+                first["server_pid"] != second["server_pid"],
+                "two live fixtures produced one process identity",
+            )
+            require(
+                second["memory"]["pss_anon_kib"] >=
+                first["memory"]["pss_anon_kib"] + 40 * 1024,
+                "48 MiB touched anonymous reservation was not visible in PSS_Anon",
+            )
+            require(
+                second["memory"]["private_resident_kib"] >=
+                first["memory"]["private_resident_kib"] + 40 * 1024,
+                "48 MiB touched anonymous reservation was not visible as private resident memory",
+            )
+            require(
+                aggregate["rss_sum_kib"] ==
+                first["memory"]["rss_kib"] + second["memory"]["rss_kib"],
+                "RSS aggregate disagreed with its samples",
+            )
+            require(
+                aggregate["pss_sum_kib"] ==
+                first["memory"]["pss_kib"] + second["memory"]["pss_kib"],
+                "PSS aggregate disagreed with its samples",
+            )
+            require(
+                aggregate["pss_anon_sum_kib"] ==
+                first["memory"]["pss_anon_kib"] + second["memory"]["pss_anon_kib"],
+                "anonymous-PSS aggregate disagreed with its samples",
+            )
+            require(
+                aggregate["pss_file_sum_kib"] ==
+                first["memory"]["pss_file_kib"] + second["memory"]["pss_file_kib"],
+                "file-PSS aggregate disagreed with its samples",
+            )
+            require(
+                aggregate["pss_shmem_sum_kib"] ==
+                first["memory"]["pss_shmem_kib"] + second["memory"]["pss_shmem_kib"],
+                "shared-memory-PSS aggregate disagreed with its samples",
+            )
+            require(
+                aggregate["private_resident_sum_kib"] ==
+                first["memory"]["private_resident_kib"] +
+                second["memory"]["private_resident_kib"],
+                "private-resident aggregate disagreed with its samples",
+            )
+            require(
+                aggregate["open_file_descriptors_sum"] ==
+                first["open_file_descriptors"] + second["open_file_descriptors"],
+                "descriptor aggregate disagreed with its samples",
+            )
+            require(
+                aggregate["threads_sum"] == first["threads"] + second["threads"],
+                "thread aggregate disagreed with its samples",
+            )
+
+            duplicate, duplicate_json = run_json(
+                [
+                    str(sync),
+                    "resources",
+                    "--socket",
+                    str(socket_a),
+                    "--socket",
+                    str(socket_a_alias),
+                ],
+                expect_success=False,
+            )
+            require(duplicate.returncode != 0,
+                    "two sockets served by one process were double-counted")
+            require(duplicate_json.get("terminal_class") == "stopped",
+                    "same-process rejection did not use the structured error surface")
+            require("same live process" in duplicate_json.get("message", ""),
+                    "same-process rejection did not explain the refused double count")
+
+            delayed_a = root / "delayed-a.sock"
+            delayed_b = root / "delayed-b.sock"
+            delayed_processes = [
+                subprocess.Popen(
+                    [
+                        sys.executable, "-B", "-S", str(Path(__file__).resolve()),
+                        "--delayed-server", "--socket", str(path),
+                        "--delay-milliseconds", "250",
+                    ],
+                    text=True,
+                    stdout=subprocess.DEVNULL,
+                    stderr=subprocess.PIPE,
+                )
+                for path in (delayed_a, delayed_b)
+            ]
+            try:
+                for path, process in zip((delayed_a, delayed_b), delayed_processes):
+                    wait_for_socket(path, process)
+                deadline_started = time.monotonic()
+                deadline_result, deadline_json = run_json(
+                    [
+                        str(sync), "resources",
+                        "--socket", str(delayed_a),
+                        "--socket", str(delayed_b),
+                        "--timeout-milliseconds", "400",
+                    ],
+                    expect_success=False,
+                )
+                deadline_elapsed = time.monotonic() - deadline_started
+                require(deadline_result.returncode != 0,
+                        "two delayed sockets each received the full aggregate timeout")
+                require(deadline_json.get("terminal_class") == "stopped",
+                        "aggregate deadline failure did not use the structured error surface")
+                require(
+                    "timed out" in deadline_json.get("message", "") or
+                    "deadline" in deadline_json.get("message", ""),
+                    "aggregate deadline failure did not identify its bounded wait",
+                )
+                require(deadline_elapsed < 0.8,
+                        f"aggregate deadline multiplied across sockets ({deadline_elapsed:.3f}s)")
+            finally:
+                for process in delayed_processes:
+                    try:
+                        process.wait(timeout=3)
+                    except subprocess.TimeoutExpired:
+                        terminate_fixture(process)
+
+            _, status_a = run_json(
+                [str(sync), "status", "--socket", str(socket_a)]
+            )
+            require(status_a.get("schema") == "anonsync.resource-fixture.status.v1",
+                    "resource sampling changed ordinary status publication")
+            require(status_a.get("anonymous_bytes") == 0,
+                    "ordinary status changed after resource sampling")
+
+            _, stop_a = run_json([str(sync), "stop", "--socket", str(socket_a)])
+            _, stop_b = run_json([str(sync), "stop", "--socket", str(socket_b)])
+            require(stop_a.get("terminal_class") == "completed",
+                    "first fixture stop did not complete")
+            require(stop_b.get("terminal_class") == "completed",
+                    "second fixture stop did not complete")
+            require(process_a.wait(timeout=10) == 0, "first fixture did not stop cleanly")
+            require(process_b.wait(timeout=10) == 0, "second fixture did not stop cleanly")
+            require(not socket_a.exists() and not socket_a_alias.exists() and not socket_b.exists(),
+                    "fixture destruction left a socket pathname")
+        finally:
+            terminate_fixture(process_a)
+            terminate_fixture(process_b)
+            out_a.close()
+            err_a.close()
+            out_b.close()
+            err_b.close()
+
+    print(f"process resource aggregation test passed ({CHECKS} checks)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
