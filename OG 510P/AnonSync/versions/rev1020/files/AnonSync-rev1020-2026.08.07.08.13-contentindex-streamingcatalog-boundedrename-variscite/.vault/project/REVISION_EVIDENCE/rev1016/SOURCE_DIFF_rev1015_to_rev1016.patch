+    )
+    require(
+        '"/proc/self/stat"' in source
+        and "fields[19U]" in source
+        and "process_start_time_clock_ticks" in header
+        and "SO_PEERCRED" in socket_c,
+        "sample_identity_binds_peer_pid_and_start_ticks",
+        "socket aliases for one live process can be recognized without PID-only trust",
+    )
+    require(
+        '"/proc/self/fd"' in source
+        and '"/proc/self/task"' in source
+        and "getrusage(RUSAGE_SELF" in source
+        and "CLOCK_MONOTONIC" in source,
+        "snapshot_includes_bounded_process_context",
+        "descriptor, thread, rusage, and sample-time evidence are present",
+    )
+    require(
+        "std::locale::classic()" in source
+        and "is not canonical unsigned decimal" in source,
+        "diagnostic_text_is_locale_independent_and_canonical",
+        "ambient locale and leading-zero decimal forms cannot alter the JSON boundary",
+    )
+    require(
+        "selected.empty() || selected.size() > 256U" in resources_command
+        and "same --socket path more than once" in resources_command
+        and "same live process" in resources_command,
+        "aggregate_has_process_and_identity_frontiers",
+        "one through 256 distinct live processes may be counted once each",
+    )
+    require(
+        "aggregate_deadline" in resources_command
+        and "remaining_milliseconds" in resources_command
+        and "timeout_is_one_aggregate_deadline" in resources_command
+        and "expired while sampling a socket" in resources_command,
+        "aggregate_uses_one_total_deadline",
+        "the timeout is not multiplied by the number of selected sockets",
+    )
+    require(
+        all(token in resources_command for token in (
+            "rss_sum_double_counts_shared_pages",
+            "pss_values_use_kernel_share_adjustment",
+            "samples_are_sequential_not_atomic",
+            "measurement_is_diagnostic_only",
+            "ordinary_status_remains_procfs_cold",
+        )),
+        "aggregate_states_interpretation_and_authority_nonclaims",
+        "operators cannot mistake a sequential memory sample for sync authority",
+    )
+    require(
+        "test_strict_smaps_parser" in unit
+        and "test_live_observation_and_roundtrip" in unit
+        and "missing required smaps field" in unit
