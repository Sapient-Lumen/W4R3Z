+    struct Sample final {
+        fs::path socket;
+        std::string json;
+        anonsync::SyncLinuxProcessResourceSnapshot snapshot;
+    };
+    std::vector<Sample> samples;
+    samples.reserve(selected.size());
+    std::set<std::string> distinct_paths;
+    std::set<std::pair<std::uint64_t, std::uint64_t>> distinct_processes;
