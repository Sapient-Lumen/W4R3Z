+    )
+    require(
+        "anonsync_sync_linux_process_resources" in cmake
+        and "anonsync_sync_process_resources_process_test" in cmake
+        and "anonsync_sync_linux_process_resources_audit" in cmake
+        and "anonsync_product_lane" in cmake,
