+        and '"--delay-milliseconds", "250"' in process_test
+        and "deadline_elapsed < 0.8" in process_test
+        and "ordinary status changed after resource sampling" in process_test,
+        "real_process_runtime_binds_delta_dedup_deadline_and_status_isolation",
+        "two processes and one alias pair exercise the shipping aggregate",
