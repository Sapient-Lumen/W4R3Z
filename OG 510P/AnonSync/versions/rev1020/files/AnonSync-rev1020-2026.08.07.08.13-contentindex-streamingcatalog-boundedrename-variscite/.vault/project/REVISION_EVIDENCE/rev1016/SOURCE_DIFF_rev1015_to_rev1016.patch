+    )
+    prose = "\n".join((design, notes, readme, bootstrap))
+    require(
+        all(token in prose for token in (
+            "Linux", "one total deadline", "256", "smaps_rollup", "Pss_Anon",
+            "Pss_File", "Pss_Shmem", "RSS", "PSS", "48 MiB", "40 MiB",
+            "diagnostic", "page cache", "allocator", "multi-terabyte",
