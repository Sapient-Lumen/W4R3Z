+#!/usr/bin/env python3
+"""Lexical audit for rev0986 fixed-block delta and multi-terabyte capacity.
+
+This is a source-shape audit, not semantic proof. Runtime, sanitizer,
+reconstruction, and package evidence remain load-bearing.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from dataclasses import asdict, dataclass
+from pathlib import Path
+
+
+REQUIRED = (
+    Path("CMakeLists.txt"),
+    Path("README.md"),
+    Path("FIXED_BLOCK_DELTA_AND_MULTI_TERABYTE_CAPACITY_AUDIT_rev0986.md"),
+    Path("REVISION_NOTES_rev0986.md"),
+    Path("src/anonsync_replica.cpp"),
+    Path("src/anonsync_sync.cpp"),
+    Path("src/sync_replica_payload_extent.hpp"),
+    Path("src/sync_replica_deployment_manifest.hpp"),
+    Path("src/sync_replica_file_payload_store.hpp"),
+    Path("src/sync_replica_file_payload_store.cpp"),
+    Path("src/sync_replica_reconciliation_protocol.hpp"),
+    Path("src/sync_replica_reconciliation_protocol.cpp"),
+    Path("src/sync_replica_reconciliation_service.hpp"),
+    Path("src/sync_replica_reconciliation_service.cpp"),
+    Path("src/sync_replica_reconciliation_tls_exchange.hpp"),
+    Path("src/sync_replica_reconciliation_tls_exchange.cpp"),
+    Path("tests/sync_replica_deployment_manifest_test.cpp"),
+    Path("tests/sync_replica_file_payload_store_test.cpp"),
+    Path("tests/sync_replica_reconciliation_protocol_test.cpp"),
+    Path("tests/sync_replica_reconciliation_service_test.cpp"),
+    Path("tests/sync_replica_tls_transport_test.cpp"),
+    Path("tools/audit_sync_replica_fixed_block_delta.py"),
+    Path("tools/verify_release_package.py"),
+)
+
+
+@dataclass(frozen=True)
+class Check:
+    check_id: str
+    passed: bool
+    detail: str
+
+
+def emit(root: Path, output: Path | None, checks: list[Check]) -> int:
+    violations = [check.check_id for check in checks if not check.passed]
+    report = {
+        "format": "anonsync-fixed-block-delta-source-audit-v1",
+        "scope": "lexical-hygiene-not-semantic-proof",
+        "scope_nonclaim": (
+            "source spelling does not prove SHA-256, POSIX identity, durability, "
+            "allocation success, crash behavior, performance, privacy, or Android"
+        ),
+        "root": str(root),
+        "passed": not violations,
+        "passed_checks": len(checks) - len(violations),
+        "total_checks": len(checks),
+        "checks": [asdict(check) for check in checks],
+        "violations": violations,
+    }
+    rendered = json.dumps(report, indent=2, sort_keys=True) + "\n"
+    if output is None:
+        sys.stdout.write(rendered)
+    else:
+        output.parent.mkdir(parents=True, exist_ok=True)
+        output.write_text(rendered, encoding="utf-8")
+    return 0 if not violations else 1
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument(
+        "--root", type=Path, default=Path(__file__).resolve().parents[1]
+    )
+    parser.add_argument("--json", type=Path)
+    args = parser.parse_args()
+    root = args.root.resolve()
+    checks: list[Check] = []
+
+    def require(condition: bool, check_id: str, detail: str) -> None:
+        checks.append(Check(check_id, bool(condition), detail))
+
+    missing = [path.as_posix() for path in REQUIRED if not (root / path).is_file()]
+    require(not missing, "required_files_exist", f"missing={missing}")
+    bootstrap_path = root.parent.parent / "BOOTSTRAPROSE.md"
+    require(
+        bootstrap_path.is_file(),
+        "release_root_bootstrap_exists",
+        str(bootstrap_path),
+    )
+    if missing or not bootstrap_path.is_file():
+        return emit(root, args.json, checks)
+
+    text = {
+        path.as_posix(): (root / path).read_text(encoding="utf-8")
+        for path in REQUIRED
+    }
+    bootstrap = bootstrap_path.read_text(encoding="utf-8")
+    cmake = text["CMakeLists.txt"]
+    readme = text["README.md"]
+    design = text[
+        "FIXED_BLOCK_DELTA_AND_MULTI_TERABYTE_CAPACITY_AUDIT_rev0986.md"
+    ]
+    notes = text["REVISION_NOTES_rev0986.md"]
+    extent = text["src/sync_replica_payload_extent.hpp"]
+    deployment = text["src/sync_replica_deployment_manifest.hpp"]
+    payload_h = text["src/sync_replica_file_payload_store.hpp"]
+    payload_c = text["src/sync_replica_file_payload_store.cpp"]
+    protocol_h = text["src/sync_replica_reconciliation_protocol.hpp"]
+    protocol_c = text["src/sync_replica_reconciliation_protocol.cpp"]
+    service_h = text["src/sync_replica_reconciliation_service.hpp"]
+    service_c = text["src/sync_replica_reconciliation_service.cpp"]
+    tls_h = text["src/sync_replica_reconciliation_tls_exchange.hpp"]
+    tls_c = text["src/sync_replica_reconciliation_tls_exchange.cpp"]
+    replica_cli = text["src/anonsync_replica.cpp"]
+    sync_cli = text["src/anonsync_sync.cpp"]
+    manifest_test = text["tests/sync_replica_deployment_manifest_test.cpp"]
+    payload_test = text["tests/sync_replica_file_payload_store_test.cpp"]
+    protocol_test = text["tests/sync_replica_reconciliation_protocol_test.cpp"]
+    service_test = text["tests/sync_replica_reconciliation_service_test.cpp"]
+    tls_test = text["tests/sync_replica_tls_transport_test.cpp"]
+    verifier = text["tools/verify_release_package.py"]
+
+    require(
+        "anonsync_sync_replica_fixed_block_delta_source_audit" in cmake
+        and "tools/audit_sync_replica_fixed_block_delta.py" in cmake,
+        "focused_source_audit_is_registered",
+        "the rev0986 source-shape audit is part of the ordinary CTest registry",
+    )
+    require(
+        "kSyncReplicaReconciliationProtocolVersion = 3U" in protocol_h
+        and "reconciliation-request-frame-v3" in protocol_c
+        and "reconciliation-response-frame-v3" in protocol_c,
+        "protocol_generation_and_digest_domains_advance_together",
+        "generation 2 frames cannot be accepted under generation 3 digests",
+    )
+    require(
+        "64ULL * 1024ULL * 1024ULL * 1024ULL" in extent
+        and "4ULL * 1024ULL * 1024ULL * 1024ULL * 1024ULL" in extent,
+        "shared_extent_policy_names_64_gib_default_and_4_tib_maximum",
+        "complete-file ceilings are centralized rather than copied by product owners",
+    )
+    require(
+        "kSyncReplicaDeploymentManifestDefaultMaxPayloadBytes =" in deployment
+        and "kSyncReplicaDefaultMaximumPayloadExtentBytes" in deployment
+        and "kSyncReplicaDeploymentManifestMaxPayloadBytes =" in deployment
+        and "kSyncReplicaMaximumPayloadExtentBytes" in deployment,
+        "deployment_manifest_uses_shared_extent_policy",
+        "new deployments and protocol capacity cannot drift independently",
+    )
+    require(
+        "kSyncReplicaReconciliationDefaultMaxPayloadExtentBytes =" in protocol_h
+        and "kSyncReplicaDefaultMaximumPayloadExtentBytes" in protocol_h,
+        "protocol_default_extent_uses_product_default",
+        "the old private 64 MiB complete-file default is removed",
+    )
+    require(
+        "kSyncReplicaReconciliationMinimumFixedBlockBytes" in protocol_h
+        and "4ULL * 1024ULL * 1024ULL" in protocol_h
+        and "kSyncReplicaReconciliationMaximumFixedBlockBytes" in protocol_h
+        and "1024ULL * 1024ULL * 1024ULL" in protocol_h
+        and "kSyncReplicaReconciliationMaximumFixedBlocks = 4096U" in protocol_h,
+        "manifest_has_explicit_4_mib_to_1_gib_4096_digest_frontier",
+        "one active manifest is bounded independently of tree size",
+    )
+    require(
+        "kSyncReplicaReconciliationMaximumFixedBlockBytes *" in protocol_h
+        and "kSyncReplicaReconciliationMaximumFixedBlocks ==" in protocol_h
+        and "kSyncReplicaMaximumPayloadExtentBytes" in protocol_h,
+        "manifest_frontier_equals_product_extent_at_compile_time",
+        "4 TiB cannot drift beyond the 4,096 by 1 GiB representation",
+    )
+    require(
+        "sync_replica_reconciliation_fixed_block_size_or_throw" in protocol_c
+        and "block_size *= 2U" in protocol_c
+        and "(block_size_bytes & (block_size_bytes - 1U)) != 0U" in protocol_c,
+        "canonical_block_size_is_bounded_power_of_two_growth",
+        "noncanonical peer-selected block geometry fails closed",
+    )
+    require(
+        "whole payload carries an unnecessary fixed-block manifest" in protocol_c
+        and "ranged payload lacks its fixed-block manifest" in protocol_c,
+        "whole_and_ranged_manifest_contract_is_explicit",
+        "restart-independent manifests are mandatory only when a range needs them",
+    )
+    require(
+        "fixed-block manifest count does not cover the payload extent" in protocol_c
+        and "fixed-block manifest contains an invalid digest" in protocol_c,
+        "manifest_count_and_each_digest_are_validated",
+        "truncated and malformed block projections cannot become reuse authority",
+    )
+    require(
+        "ranged payload crosses its fixed-block boundary" in protocol_c
+        and "full range digest disagrees with its fixed-block manifest" in protocol_c,
+        "wire_ranges_are_confined_to_one_manifest_block",
+        "a complete transmitted block is independently bound to the manifest",
+    )
+    require(
+        "Validation permits at most one ranged payload" in protocol_c
+        and "Charge one complete bounded fixed-block manifest" in protocol_c,
+        "response_frame_budget_charges_one_bounded_manifest",
+        "manifest overhead is not multiplied by whole-payload count",
+    )
+    require(
+        "SyncReplicaFilePayloadStoreFixedBlockManifest" in payload_h
+        and "copy_range_or_throw" in payload_h
+        and "fixed_block_manifest_or_throw" in payload_h,
+        "payload_store_exports_typed_bounded_range_and_manifest_consumers",
+        "delta transfer reuses the retained descriptor-rooted payload authority",
+    )
+    require(
+        "::pread" in payload_c
+        and "fixed-block projection" in payload_c
+        and "reproof" in payload_c,
+        "payload_manifest_and_range_reads_are_descriptor_rooted_and_reproved",
+        "pathname metadata alone is not trusted after exact-byte streaming",
+    )
+    require(
+        "fixed_block_manifest_" in service_h
+        and "fixed_block_manifest_content_sha256_" in service_h
+        and "fixed_block_manifest_scans_" in service_h
+        and "fixed_block_manifest_reuses_" in service_h,
+        "serve_session_retains_one_source_manifest_cache",
+        "multi-page transfer does not rehash the same source once per range",
+    )
+    require(
+        "delta_predecessor_manifest_" in service_h
+        and "delta_target_operation_id_" in service_h
+        and "delta_predecessor_operation_id_" in service_h
+        and "bounded by 4,096 digests" in service_h,
+        "receiver_retains_one_operation_bound_predecessor_cache",
+        "the cache is process-local acceleration rather than durable admission state",
+    )
+    require(
+        "operation.predecessor_operation_ids" in service_c
+        and "observed->canonical_path != operation.canonical_path" in service_c
+        and "observed->content_sha256 == operation.content_sha256" in service_c,
+        "reuse_is_limited_to_exact_direct_same_path_predecessors",
+        "arbitrary local payloads do not become causal predecessor authority",
+    )
+    require(
+        "begin_targeted_access_or_throw" in service_c
+        and "open_optional_payload_for_operation_or_throw" in service_c
