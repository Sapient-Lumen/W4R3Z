+    const anonsync::SyncReplicaActor source_actor{
+        "device-reconciliation-delta-source", 11901U};
+    const anonsync::SyncReplicaActor receiver_actor{
+        "device-reconciliation-delta-receiver", 11902U};
+    constexpr std::uint64_t block_bytes =
+        anonsync::kSyncReplicaReconciliationMinimumFixedBlockBytes;
+
+    std::string old_bytes(static_cast<std::size_t>(block_bytes), 'A');
+    old_bytes.append(static_cast<std::size_t>(block_bytes), 'B');
+    old_bytes.append(static_cast<std::size_t>(block_bytes), 'C');
+    std::string new_bytes = old_bytes;
+    new_bytes.front() = 'X';
+    new_bytes[static_cast<std::size_t>(block_bytes)] = 'Y';
+    std::string one_byte_edit = new_bytes;
+    one_byte_edit[1U] = 'Z';
+
+    // Choose a deterministic path suffix whose predecessor sorts before the
+    // successor, allowing the request cursor to isolate the changed operation
+    // without first retransmitting the already retained large predecessor.
+    std::optional<std::string> selected_path;
+    for (std::uint64_t suffix = 0U; suffix < 4096U; ++suffix) {
+        const std::string path =
+            "media/delta-" + std::to_string(suffix) + ".bin";
+        anonsync::SyncReplicaModel probe(
+            folder, source_actor, owner_limits(64U).model);
+        const auto predecessor = probe.create_local_file_or_throw(
+            path, old_bytes.size(), anonsync::sha256_hex(old_bytes));
+        const auto successor = probe.create_local_file_or_throw(
+            path, new_bytes.size(), anonsync::sha256_hex(new_bytes));
+        const auto latest = probe.create_local_file_or_throw(
+            path, one_byte_edit.size(), anonsync::sha256_hex(one_byte_edit));
+        if (predecessor.operation_id < successor.operation_id &&
+            successor.operation_id < latest.operation_id) {
+            selected_path = path;
+            break;
+        }
+    }
+    require(
+        selected_path.has_value(),
+        "could not construct a canonical predecessor cursor for delta test");
+
+    auto wire = protocol_limits(1U);
+    wire.model = owner_limits(64U).model;
+    wire.max_single_payload_bytes = block_bytes;
+    wire.max_payload_bytes_per_page = block_bytes;
+    wire.max_payload_extent_bytes = 32U * 1024U * 1024U;
+    wire.max_response_frame_bytes = 8U * 1024U * 1024U;
+
+    auto store = payload_limits();
+    store.max_payload_bytes = 32U * 1024U * 1024U;
+    store.max_indexed_bytes = 128U * 1024U * 1024U;
+    store.max_transient_bytes = 64U * 1024U * 1024U;
