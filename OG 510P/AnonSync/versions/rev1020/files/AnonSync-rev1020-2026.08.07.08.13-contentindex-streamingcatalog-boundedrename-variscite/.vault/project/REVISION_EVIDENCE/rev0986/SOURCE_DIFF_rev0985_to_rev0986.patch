+            anonsync::SyncReplicaReconciliationApplyDisposition::PageApplied) {
+            require(
+                applied.inserted_active == 1U &&
+                    !applied.payload_continuation.has_value(),
+                "delta completion did not admit exactly one successor");
+            break;
+        }
+        require(
+            applied.disposition ==
+                    anonsync::SyncReplicaReconciliationApplyDisposition::
+                        PayloadProgress &&
+                applied.payload_continuation.has_value(),
+            "delta transfer did not return bounded payload progress");
+        cursor = applied.next_after_operation_id;
+        source_digest = applied.source_evidence_set_digest;
+        continuation = applied.payload_continuation;
+    }
+    require(pages == 1U,
+            "two changed blocks plus one reusable block did not settle in two source pages");
+    require(
+        network_bytes == 2U * block_bytes &&
+            staged_bytes == 2U * block_bytes &&
+            reused_bytes == block_bytes && reused_blocks == 1U,
+        "fixed-block delta did not replace one whole network block with exact local reuse");
+    require(
+        predecessor_manifest_scans == 1U &&
+            predecessor_manifest_reuses == 1U &&
+            predecessor_manifest_hashed_bytes == old_bytes.size(),
+        "receiver did not hash its multi-range predecessor exactly once");
+    require(
+        source_session.fixed_block_manifest_scans() == 1U &&
+            source_session.fixed_block_manifest_reuses() == 1U &&
+            source_session.fixed_block_manifest_hashed_bytes() ==
+                new_bytes.size(),
+        "source did not hash its ranged successor exactly once");
+    require_payload_available(
+        receiver.payload_store_, successor, new_bytes,
+        "fixed-block delta did not reconstruct exact successor bytes");
+    require(
+        receiver.owner_.snapshot_or_throw().evidence_set_digest ==
+            source_snapshot.evidence_set_digest,
+        "fixed-block delta did not converge the exact causal evidence set");
+
+    const auto latest = source.publish_file(*selected_path, one_byte_edit);
+    require(
+        latest.predecessor_operation_ids ==
+            std::vector<std::string>{successor.operation_id},
+        "one-byte successor did not name the exact prior version");
+    const auto latest_snapshot = source.owner_.snapshot_or_throw();
+    const auto one_byte_request = receiver.service_.make_request_or_throw(
+        receiver_channel, successor.operation_id,
+        latest_snapshot.evidence_set_digest);
+    const auto one_byte_response = source.service_.serve_request_or_throw(
+        source_channel, one_byte_request.request_frame, source_session);
+    require(
+        one_byte_response.response.operations ==
+                std::vector<anonsync::SyncReplicaOperation>{latest} &&
+            one_byte_response.response.payloads.size() == 1U &&
+            one_byte_response.response.payloads.front().offset_bytes == 0U &&
+            one_byte_response.response.payloads.front().bytes.size() ==
+                block_bytes,
+        "one-byte edit did not produce one bounded first-block transfer");
+    const auto one_byte_applied = receiver.service_.apply_response_or_throw(
+        receiver_channel, one_byte_request.request,
+        one_byte_response.response_frame);
+    require(
+        one_byte_applied.disposition ==
+                anonsync::SyncReplicaReconciliationApplyDisposition::
+                    PageApplied &&
+            one_byte_applied.staged_payload_bytes == block_bytes &&
+            one_byte_applied.reused_payload_blocks == 2U &&
+            one_byte_applied.reused_payload_ranges == 2U &&
+            one_byte_applied.reused_payload_bytes == 2U * block_bytes &&
+            one_byte_applied.delta_predecessor_manifest_scans == 1U &&
+            one_byte_applied.delta_predecessor_manifest_reuses == 0U &&
+            one_byte_applied.delta_predecessor_manifest_hashed_bytes ==
+                new_bytes.size() &&
+            one_byte_applied.inserted_active == 1U &&
+            !one_byte_applied.payload_continuation.has_value(),
+        "one-byte edit did not replace two network blocks with exact predecessor reuse");
+    require(
+        source_session.fixed_block_manifest_scans() == 2U &&
+            source_session.fixed_block_manifest_reuses() == 1U &&
+            source_session.fixed_block_manifest_hashed_bytes() ==
+                new_bytes.size() + one_byte_edit.size(),
+        "source manifest cache did not rotate exactly once for the one-byte successor");
+    require_payload_available(
+        receiver.payload_store_, latest, one_byte_edit,
+        "one-byte fixed-block delta did not reconstruct exact bytes");
+    require(
+        receiver.owner_.snapshot_or_throw().evidence_set_digest ==
+            latest_snapshot.evidence_set_digest,
+        "one-byte fixed-block delta did not converge exact causal evidence");
+}
