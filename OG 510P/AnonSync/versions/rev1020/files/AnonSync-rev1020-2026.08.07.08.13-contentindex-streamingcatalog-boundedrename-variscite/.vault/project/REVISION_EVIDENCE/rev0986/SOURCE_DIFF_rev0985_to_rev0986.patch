+struct FixedBlockDigestProjection final {
+    std::string whole_sha256;
+    std::vector<std::string> block_sha256;
+};
+
+[[nodiscard]] FixedBlockDigestProjection
+hash_regular_file_fixed_blocks_or_throw(
+    int descriptor,
+    const struct stat& expected_status,
+    std::uint64_t block_size_bytes,
+    std::uint64_t maximum_block_count,
+    const std::string& label) {
+    if (expected_status.st_size <= 0) {
+        throw std::invalid_argument(
+            label + " requires one nonempty regular payload");
+    }
+    if (block_size_bytes == 0U || maximum_block_count == 0U) {
+        throw std::invalid_argument(
+            label + " fixed-block limits must be positive");
+    }
+    const std::uint64_t total_size =
+        static_cast<std::uint64_t>(expected_status.st_size);
+    const std::uint64_t block_count =
+        1U + ((total_size - 1U) / block_size_bytes);
+    if (block_count > maximum_block_count) {
+        throw std::length_error(
+            label + " exceeds the fixed-block count limit");
+    }
+
+    FixedBlockDigestProjection out;
+    out.block_sha256.reserve(u64_to_size_or_throw(
+        block_count, label + " fixed-block count"));
+    Sha256DigestBuilder whole_digest;
+    std::array<char, kStreamingBufferBytes> buffer{};
+    std::uint64_t block_offset = 0U;
