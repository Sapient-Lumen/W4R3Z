+                "v8 migrated schema version") == 9U &&
+                scalar_u64_query(
+                    db,
+                    "SELECT count(*) FROM pragma_table_info("
+                    "'sync_replica_visible') WHERE name IN ("
+                    "'value_kind','size_bytes_be','content_sha256');",
+                    "v8 migrated normalized column count") == 3U &&
+                scalar_u64_query(
+                    db,
+                    "SELECT count(*) FROM main.sqlite_schema WHERE "
