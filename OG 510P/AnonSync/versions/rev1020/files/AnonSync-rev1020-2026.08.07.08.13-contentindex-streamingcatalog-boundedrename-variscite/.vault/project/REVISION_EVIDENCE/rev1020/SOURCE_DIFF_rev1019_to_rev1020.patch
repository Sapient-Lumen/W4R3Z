+void test_exact_v8_migration_builds_visible_content_index() {
+    TempDatabasePath file("anonsync-replica-sqlite-owner-v8-migration");
+    const std::string folder = "folder-sqlite-v8-migration";
+    const SyncReplicaActor local = actor("device-sqlite-v8-migration", 986U);
+    const SyncReplicaSqliteOwnerLimits fixture_limits = limits(32U, 8U, 256U);
+    const std::string content = anonsync::sha256_hex("visible-v8-content");
+    SyncReplicaOperation operation;
+    SyncReplicaSqliteSnapshot source;
+
+    {
+        SyncSqliteDb db = open_database(file.path);
+        SyncReplicaSqliteOwner owner(
+            db.db, folder, local, fixture_limits,
+            "visible-path-v8 fixture source owner");
+        operation = owner.publish_local_file_or_throw(
+            "legacy-v8/file.bin", 19U, content);
+        source = owner.snapshot_or_throw();
+    }
+
+    {
+        SyncSqliteDb db = open_database(file.path);
+        const std::string current_meta_sql = scalar_text_query(
+            db,
+            "SELECT sql FROM main.sqlite_schema "
+            "WHERE type='table' AND name='sync_replica_meta';",
+            "visible-path-v8 source meta SQL");
+        std::string v8_meta_sql = current_meta_sql;
+        const std::size_t schema_check = v8_meta_sql.find("schema_version=9");
+        require(
+            schema_check != std::string::npos &&
+                v8_meta_sql.find(
+                    "schema_version=9", schema_check + 1U) ==
+                    std::string::npos,
+            "visible-path-v8 fixture did not identify one schema check");
+        v8_meta_sql.replace(
+            schema_check, std::string_view("schema_version=9").size(),
+            "schema_version=8");
+
+        LegacyV1Meta meta = legacy_meta_from_snapshot(source);
+        // Schema v8 already used the current incremental witnesses. Only the
+        // normalized visible-value columns and their content index are new in
+        // v9, so preserve the exact released v8 metadata rather than the
+        // ordered-stream witnesses required by v1-v7 fixtures.
+        meta.local_operation_digest = source.local_operation_digest;
+        meta.operation_set_digest = source.operation_set_digest;
+        meta.evidence_set_digest = source.evidence_set_digest;
+        meta.visible_state_digest = source.visible_state_digest;
+        meta.outbox_digest = source.outbox_digest;
+        meta.cutpoint_digest = visible_path_v8_cutpoint_digest(
+            meta, source.database_incarnation_sha256,
+            source.database_recovery_epoch, source.visible_path_count,
+            source.historical_version_pin_count,
+            source.historical_version_pin_set_digest);
+
+        exec(db, "BEGIN IMMEDIATE;");
+        downgrade_visible_projection_to_v8_or_throw(
+            db, "create-visible-path-v8-fixture projection");
+        exec(db,
+             "CREATE TEMP TABLE sync_replica_visible_path_v8_meta AS "
+             "SELECT * FROM main.sync_replica_meta;");
+        anonsync::SyncSqliteStmt update = anonsync::sqlite_prepare_or_throw(
+            db.db,
+            "UPDATE temp.sync_replica_visible_path_v8_meta SET "
+            "schema_version=8,cutpoint_digest=? WHERE id=1;",
+            "visible-path-v8 fixture meta update prepare");
+        anonsync::sqlite_bind_text_or_throw(
+            update.stmt, 1, meta.cutpoint_digest,
+            "visible-path-v8 fixture bind cutpoint");
+        anonsync::sqlite_step_done_or_throw(
+            update.stmt, "visible-path-v8 fixture meta update");
+        exec(db, "DROP TABLE main.sync_replica_meta;");
+        exec(db, v8_meta_sql + ";");
+        exec(db,
+             "INSERT INTO main.sync_replica_meta SELECT * FROM "
+             "temp.sync_replica_visible_path_v8_meta;"
+             "DROP TABLE temp.sync_replica_visible_path_v8_meta;"
+             "COMMIT;");
+        require(
+            scalar_u64_query(
+                db,
+                "SELECT schema_version FROM main.sync_replica_meta WHERE id=1;",
+                "visible-path-v8 fixture schema version") == 8U &&
+                scalar_u64_query(
+                    db,
+                    "SELECT count(*) FROM pragma_table_info("
+                    "'sync_replica_visible') WHERE name IN ("
+                    "'value_kind','size_bytes_be','content_sha256');",
+                    "visible-path-v8 fixture normalized column count") == 0U &&
+                scalar_u64_query(
+                    db,
+                    "SELECT count(*) FROM main.sqlite_schema WHERE "
+                    "name='sync_replica_visible_file_content';",
+                    "visible-path-v8 fixture content index count") == 0U,
+            "visible-path-v8 fixture was not the exact rev1019 schema");
+    }
+
+    SyncReplicaSqliteSnapshot migrated;
+    {
+        SyncSqliteDb db = open_database(file.path);
+        SyncReplicaSqliteOwner owner(
+            db.db, folder, local, limits(999U, 999U, 9999U),
+            "exact v8 migration owner");
+        migrated = owner.snapshot_or_throw();
+        require(
+            migrated.state_generation == source.state_generation + 1U &&
+                migrated.policy_generation == source.policy_generation &&
+                migrated.limits == source.limits &&
+                migrated.durable == source.durable &&
+                migrated.outbox == source.outbox &&
+                migrated.outbox_clock_state == source.outbox_clock_state &&
+                migrated.historical_version_pins ==
+                    source.historical_version_pins,
+            "v8 migration changed causal, policy, outbox, clock, or pin authority");
+        require(
+            migrated.database_incarnation_sha256 ==
+                    source.database_incarnation_sha256 &&
+                migrated.database_recovery_epoch ==
+                    source.database_recovery_epoch &&
+                migrated.local_operation_digest ==
+                    source.local_operation_digest &&
+                migrated.operation_set_digest == source.operation_set_digest &&
+                migrated.evidence_set_digest == source.evidence_set_digest &&
+                migrated.visible_path_count == source.visible_path_count &&
+                migrated.visible_state_digest == source.visible_state_digest,
+            "v8 migration changed lineage or current visible authority");
+        const auto content_cutpoint =
+            owner.visible_file_content_cutpoint_or_throw(19U, content);
+        require(
+            content_cutpoint.sole_visible_file_operation == operation &&
+                !content_cutpoint.ambiguous,
+            "v8 migration did not rebuild the exact visible-content index");
+        require(
+            scalar_u64_query(
+                db,
