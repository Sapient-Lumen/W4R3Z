+
+void fail_after_first_replacement_step(
+    const SqliteLiveBackupStepObservation& observation,
+    void*) {
+    if (observation.step_index == 1U) {
+        throw std::runtime_error("injected replacement interruption");
+    }
+}
+
+void reject_observer_call(
+    const SqliteLiveBackupStepObservation&,
+    void* context) {
+    auto* const calls = static_cast<std::uint64_t*>(context);
+    ++(*calls);
+    throw std::runtime_error(
+        "terminal backup step was exposed to the observer");
+}
+
+void test_terminal_step_is_not_a_throwable_observer_cutpoint(
+    const fs::path& root,
+    std::uint64_t& checks) {
+    const fs::path source_path = root / "terminal-source.sqlite";
+    const fs::path destination_path = root / "terminal-destination.sqlite";
+    cleanup_sqlite_family(source_path);
+    cleanup_sqlite_family(destination_path);
+    Database source(
+        source_path, SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE |
+                         SQLITE_OPEN_FULLMUTEX | SQLITE_OPEN_PRIVATECACHE);
+    source.exec(
+        "PRAGMA journal_mode=WAL;"
+        "CREATE TABLE evidence(value INTEGER NOT NULL);"
+        "INSERT INTO evidence VALUES(17);");
+    require(source.integer("PRAGMA main.page_count;") <=
+                kSqliteLiveBackupPagesPerStep,
+            "terminal observer fixture exceeded one backup step", checks);
+    Database destination(
+        destination_path, SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE |
+                              SQLITE_OPEN_FULLMUTEX | SQLITE_OPEN_PRIVATECACHE);
+    destination.exec(
+        "PRAGMA journal_mode=WAL;"
+        "CREATE TABLE displaced(value INTEGER NOT NULL);"
+        "INSERT INTO displaced VALUES(5);");
+
+    std::uint64_t observer_calls = 0U;
+    const SqliteLiveBackupEvidence evidence =
+        replace_sqlite_live_database_bounded_or_throw(
+            destination.get(), source.get(), "terminal named replacement", {},
+            &reject_observer_call, &observer_calls);
+
+    require(evidence.step_calls == 1U && observer_calls == 0U,
+            "terminal SQLITE_DONE step became a throwable observer cutpoint",
+            checks);
+    require(destination.integer("SELECT value FROM evidence;") == 17U,
+            "terminal named replacement did not commit the source image",
+            checks);
+    require(destination.integer(
+                "SELECT count(*) FROM sqlite_schema WHERE name='displaced';") ==
+                0U,
+            "terminal named replacement retained displaced schema", checks);
+}
+
+void test_named_replacement_success(const fs::path& root,
+                                    std::uint64_t& checks) {
+    const fs::path source_path = root / "replacement-source.sqlite";
+    const fs::path destination_path = root / "replacement-destination.sqlite";
+    cleanup_sqlite_family(source_path);
+    cleanup_sqlite_family(destination_path);
+    Database source(
+        source_path, SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE |
+                         SQLITE_OPEN_FULLMUTEX | SQLITE_OPEN_PRIVATECACHE);
+    initialize_wal_source(source, 900000U);
+    Database destination(
+        destination_path, SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE |
+                              SQLITE_OPEN_FULLMUTEX | SQLITE_OPEN_PRIVATECACHE);
+    destination.exec("PRAGMA journal_mode=WAL;");
+    destination.exec(
+        "CREATE TABLE displaced(value INTEGER NOT NULL);"
+        "INSERT INTO displaced VALUES(7);");
+
+    const SqliteLiveBackupEvidence evidence =
+        replace_sqlite_live_database_bounded_or_throw(
+            destination.get(), source.get(), "named replacement");
+
+    require(evidence.step_calls > 1U,
+            "named replacement did not remain bounded across multiple steps",
+            checks);
+    require(destination.integer("SELECT count(*) FROM evidence;") == 1U,
+            "named replacement did not publish the source schema", checks);
+    require(destination.integer(
+                "SELECT count(*) FROM sqlite_schema WHERE name='displaced';") ==
+                0U,
+            "named replacement retained displaced destination schema", checks);
+    require(destination.integer("PRAGMA main.page_size;") ==
+                evidence.source_geometry.page_size &&
+                destination.integer("PRAGMA main.page_count;") ==
+                evidence.source_geometry.page_count,
+            "named replacement destination geometry differs from source evidence",
+            checks);
+    require(source.integer("SELECT count(*) FROM evidence;") == 1U,
+            "named replacement mutated the pinned source", checks);
+}
