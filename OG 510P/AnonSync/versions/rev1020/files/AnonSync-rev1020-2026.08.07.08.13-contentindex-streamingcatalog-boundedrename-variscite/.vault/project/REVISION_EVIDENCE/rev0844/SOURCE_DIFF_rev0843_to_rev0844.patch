@@ -0,0 +1,362 @@
+#include "anonsync_core_internal.hpp"
+#include "sync_process_incarnation.hpp"
+#include "persistence/local_jsonl_replay_publication.hpp"
+#if !defined(_WIN32)
+#include "inherited_test_process.hpp"
+#endif
+
+#include <chrono>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <stdexcept>
