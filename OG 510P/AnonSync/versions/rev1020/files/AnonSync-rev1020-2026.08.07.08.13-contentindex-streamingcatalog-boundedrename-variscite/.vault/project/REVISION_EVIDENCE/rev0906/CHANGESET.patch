+void test_claim_prefers_oldest_ready_generation_over_digest_order() {
+    TempDatabasePath file(
+        "anonsync-replica-sqlite-owner-causal-claim-priority");
+    const std::string folder = "folder-sqlite-causal-claim-priority";
+    const SyncReplicaActor local = actor(
+        "device-sqlite-causal-claim-priority", 1201U);
+    const std::string destination =
+        "device-sqlite-causal-claim-priority-peer";
+    SyncSqliteDb db = open_database(file.path);
+    SyncReplicaSqliteOwner owner(
+        db.db, folder, local, limits(128U, 128U, 64U * 1024U),
+        "causal claim priority owner");
+
+    std::vector<SyncReplicaOperation> operations;
+    operations.reserve(128U);
+    std::size_t lexical_minimum = 0U;
+    for (std::size_t index = 0U; index < 128U; ++index) {
+        const std::string payload =
+            "causal-claim-priority-payload-" + std::to_string(index);
+        operations.push_back(owner.create_local_file_or_throw(
+            "causal-priority/" + std::to_string(index) + ".bin",
+            static_cast<std::uint64_t>(payload.size()),
+            anonsync::sha256_hex(payload),
+            std::vector<std::string>{destination}));
+        if (operations.back().operation_id <
+            operations[lexical_minimum].operation_id) {
+            lexical_minimum = operations.size() - 1U;
+        }
+        if (lexical_minimum != 0U && operations.size() >= 3U) break;
+    }
+    require(lexical_minimum != 0U,
+            "claim-priority fixture did not separate digest order from durable generation");
+
+    const SyncReplicaSqliteSnapshot before = owner.snapshot_or_throw();
+    require(before.outbox.size() == operations.size(),
+            "claim-priority fixture did not retain every destination intent");
+    const auto first_intent = std::find_if(
+        before.outbox.begin(), before.outbox.end(),
+        [&](const anonsync::SyncReplicaSqliteOutboxIntent& intent) {
+            return intent.operation_id == operations.front().operation_id;
+        });
+    const auto lexical_intent = std::find_if(
+        before.outbox.begin(), before.outbox.end(),
+        [&](const anonsync::SyncReplicaSqliteOutboxIntent& intent) {
+            return intent.operation_id ==
+                operations[lexical_minimum].operation_id;
+        });
+    require(first_intent != before.outbox.end() &&
+                lexical_intent != before.outbox.end() &&
+                first_intent->enqueued_generation <
+                    lexical_intent->enqueued_generation,
+            "claim-priority fixture lost its durable enqueue chronology");
+
+    const auto first = owner.claim_next_outbox_or_throw(
+        "worker-causal-priority-1", 100U, 30U, destination);
+    require(first.has_value() &&
+                first->operation == operations.front() &&
+                first->intent.enqueued_generation ==
+                    first_intent->enqueued_generation,
+            "digest order outranked the oldest ready durable generation");
+    require(owner.settle_outbox_or_throw(
+                destination, first->operation.operation_id,
+                first->intent.lease.claim_id, 101U) ==
+                SyncReplicaSqliteOutboxReceiptResult::Applied,
+            "oldest claim-priority intent did not settle exactly");
+
+    const auto second = owner.claim_next_outbox_or_throw(
+        "worker-causal-priority-2", 102U, 30U, destination);
+    require(second.has_value() &&
+                second->operation == operations[1U],
+            "claim priority did not advance to the next durable generation");
 }
 
