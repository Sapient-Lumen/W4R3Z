+
+    {
+        SyncSqliteTransaction transaction(
+            db.db, "retired capability", SyncSqliteTransactionMode::Immediate);
+        test.check(throws_with(
+                       [&] {
+                           anonsync::sync_checkpoint_owner_fence_internal::
+                               require_recipient_write_authority_or_throw(
+                                   db.db,
+                                   "session-a",
+                                   owner_b,
+                                   62,
+                                   "retired capability");
+                       },
+                       "retired"),
+                   "released generation rejects its retired capability");
+        transaction.rollback();
+    }
