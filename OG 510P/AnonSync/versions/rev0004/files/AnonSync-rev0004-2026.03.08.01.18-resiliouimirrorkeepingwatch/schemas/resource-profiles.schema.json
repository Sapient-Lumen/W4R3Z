{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnonSync Resource Profiles",
  "type": "object",
  "required": ["version", "profiles"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9-]+$": {
          "type": "object",
          "required": ["intent", "transport_defaults", "sync_defaults"],
          "properties": {
            "intent": {"type": "string", "minLength": 1},
            "transport_defaults": {
              "type": "object",
              "required": ["tor", "i2pd"],
              "properties": {
                "tor": {
                  "type": "object",
                  "required": [
                    "connection_padding",
                    "circuit_padding",
                    "reduced_connection_padding",
                    "reduced_circuit_padding"
                  ],
                  "properties": {
                    "connection_padding": {"type": "string"},
                    "circuit_padding": {"type": "boolean"},
                    "reduced_connection_padding": {"type": "boolean"},
                    "reduced_circuit_padding": {"type": "boolean"}
                  },
                  "additionalProperties": false
                },
                "i2pd": {
                  "type": "object",
                  "required": ["enabled", "notransit", "share_percent", "streaming_profile"],
                  "properties": {
                    "enabled": {"type": "boolean"},
                    "notransit": {"type": "boolean"},
                    "share_percent": {"type": "integer", "minimum": 0, "maximum": 100},
                    "streaming_profile": {"type": "string"}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "sync_defaults": {
              "type": "object",
              "required": [
                "direct_send_small_files",
                "direct_send_mem_limit_mb",
                "fs_notifications",
                "rescan_interval_seconds",
                "index_backend",
                "hashing",
                "placeholders_default"
              ],
              "properties": {
                "direct_send_small_files": {"type": "boolean"},
                "direct_send_mem_limit_mb": {"type": "integer", "minimum": 0},
                "fs_notifications": {"type": "boolean"},
                "rescan_interval_seconds": {"type": "integer", "minimum": 0},
                "index_backend": {"type": "string", "minLength": 1},
                "hashing": {"type": "string", "minLength": 1},
                "placeholders_default": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
