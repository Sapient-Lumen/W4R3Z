{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnonSync Project State",
  "type": "object",
  "required": [
    "project_name",
    "slug",
    "current_revision",
    "current_revision_label",
    "archive_basename",
    "generated_timestamp_local",
    "stage",
    "status",
    "vision",
    "core_goals",
    "invariants",
    "architecture_choices",
    "top_level_must_reads",
    "next_priorities"
  ],
  "properties": {
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "current_revision": {
      "type": "integer",
      "minimum": 1
    },
    "current_revision_label": {
      "type": "string",
      "pattern": "^rev\\d{4}$"
    },
    "archive_basename": {
      "type": "string",
      "minLength": 1
    },
    "generated_timestamp_local": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "vision": {
      "type": "string",
      "minLength": 1
    },
    "analogy": {
      "type": "string"
    },
    "core_goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "non_goals_yet": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "architecture_choices": {
      "type": "object",
      "required": [
        "i2p_entrypoint",
        "tor_entrypoint",
        "core_transport_coupling",
        "packaging_posture",
        "user_exposure_to_transports",
        "invite_model",
        "sharing_posture",
        "lan_discovery_default",
        "lan_discovery_beacon_semantics",
        "mobile_default_transport",
        "mobile_i2p_policy",
        "mobile_sync_default",
        "change_detection_model",
        "encrypted_peer_staging",
        "permission_model",
        "arti_posture",
        "resource_profile_posture",
        "small_file_transfer_posture",
        "index_database_posture",
        "hashing_posture",
        "i2p_transit_posture",
        "ui_surface_posture",
        "resilio_research_posture"
      ],
      "properties": {
        "i2p_entrypoint": {
          "type": "string"
        },
        "tor_entrypoint": {
          "type": "string"
        },
        "core_transport_coupling": {
          "type": "string"
        },
        "packaging_posture": {
          "type": "string"
        },
        "user_exposure_to_transports": {
          "type": "string"
        },
        "invite_model": {
          "type": "string"
        },
        "sharing_posture": {
          "type": "string"
        },
        "lan_discovery_default": {
          "type": "string"
        },
        "lan_discovery_beacon_semantics": {
          "type": "string"
        },
        "mobile_default_transport": {
          "type": "string"
        },
        "mobile_i2p_policy": {
          "type": "string"
        },
        "mobile_sync_default": {
          "type": "string"
        },
        "change_detection_model": {
          "type": "string"
        },
        "encrypted_peer_staging": {
          "type": "string"
        },
        "permission_model": {
          "type": "string"
        },
        "arti_posture": {
          "type": "string"
        },
        "resource_profile_posture": {
          "type": "string"
        },
        "small_file_transfer_posture": {
          "type": "string"
        },
        "index_database_posture": {
          "type": "string"
        },
        "hashing_posture": {
          "type": "string"
        },
        "i2p_transit_posture": {
          "type": "string"
        },
        "ui_surface_posture": {
          "type": "string"
        },
        "resilio_research_posture": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "top_level_must_reads": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "next_priorities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "additionalProperties": true
}
