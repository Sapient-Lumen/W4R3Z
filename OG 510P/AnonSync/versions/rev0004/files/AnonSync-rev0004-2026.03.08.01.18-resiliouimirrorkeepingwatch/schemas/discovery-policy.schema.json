{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnonSync Discovery Policy",
  "type": "object",
  "required": ["version", "lan_discovery"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "lan_discovery": {
      "type": "object",
      "required": [
        "default_enabled",
        "advertise_stable_share_ids",
        "beacon_semantics",
        "transports_exposed_to_user",
        "cadence_seconds",
        "adaptation_rules",
        "privacy_guardrails"
      ],
      "properties": {
        "default_enabled": {"type": "boolean"},
        "advertise_stable_share_ids": {"type": "boolean"},
        "beacon_semantics": {"type": "string", "minLength": 1},
        "transports_exposed_to_user": {"type": "boolean"},
        "cadence_seconds": {
          "type": "object",
          "required": [
            "startup_burst",
            "network_change_burst",
            "steady_state_base",
            "healthy_peer_backoff_ceiling",
            "mobile_frugal_base"
          ],
          "properties": {
            "startup_burst": {
              "type": "array",
              "items": {"type": "integer", "minimum": 0},
              "minItems": 1
            },
            "network_change_burst": {
              "type": "array",
              "items": {"type": "integer", "minimum": 0},
              "minItems": 1
            },
            "steady_state_base": {"type": "integer", "minimum": 1},
            "healthy_peer_backoff_ceiling": {"type": "integer", "minimum": 1},
            "mobile_frugal_base": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "adaptation_rules": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "privacy_guardrails": {
          "type": "object",
          "required": [
            "local_network_only",
            "include_transport_internal_status",
            "include_router_control_endpoints",
            "include_user_facing_share_ids"
          ],
          "properties": {
            "local_network_only": {"type": "boolean"},
            "include_transport_internal_status": {"type": "boolean"},
            "include_router_control_endpoints": {"type": "boolean"},
            "include_user_facing_share_ids": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
