\
\ core.mx — micromax standard library (boot)

\ NOTE:
\ - keep this file tiny and readable
\ - prefer defining "convenience" words here, not as VM primitives
\ - avoid host-dependent words; those belong in editor-specific runtime

: nip    ( a b -- b )           swap drop ;
: tuck   ( a b -- b a b )       swap over ;
: ?dup   ( x -- 0 | x x )       dup [ dup ] [ ] if ;
: 1+     ( n|u -- n|u )         1 + ;
: 1-     ( n|u -- n|u )         1 - ;
: 2*     ( x1 -- x2 )          2 * ;
: 2/     ( x1 -- x2 )          2 / ;
: 2dup   ( a b -- a b a b )     over over ;
: 2drop  ( a b -- )             drop drop ;
: 2nip   ( a b c d -- c d )     2swap 2drop ;
: 2over  ( a b c d -- a b c d a b )  3 pick 3 pick ;
: 2tuck  ( a b c d -- c d a b c d )  2swap 2over ;
: 2swap  ( a b c d -- c d a b )  rot >r rot r> ;
: 2rot   ( a b c d e f -- c d e f a b )  >r >r 2swap r> r> 2swap ;
: 2>r    ( x1 x2 -- )            swap >r >r ;
: 2r>    ( -- x1 x2 )            r> r> swap ;
: 2r@    ( -- x1 x2 )            r> r> 2dup >r >r swap ;
: 2rdrop ( -- )                  rdrop rdrop ;
: negate ( n -- -n )            0 swap - ;
: 0<     ( n -- flag )          0 < ;
: 0>     ( n -- flag )          0 > ;
: 0<>    ( x -- flag )          0= 0= ;
: <>     ( a b -- flag )        = 0= ;
: abs    ( n -- u )             dup 0< [ negate ] [ ] if ;
: max    ( n1 n2 -- n3 )       2dup > [ drop ] [ nip ] if ;
: min    ( n1 n2 -- n3 )       2dup < [ drop ] [ nip ] if ;

\ return stack helpers (can be done in stdlib)
: rdrop ( -- ) r> drop ;

\ combinators
\ dip: execute q while temporarily removing x from the data stack
: dip    ( x q -- ... x )      swap >r call r> ;

\ keep: execute q with x on stack, but keep a copy of x after execution
: keep   ( x q -- ... x )      over >r call r> ;

\ 2dip / 2keep: like dip/keep, but for two preserved values
: 2dip   ( x y q -- ... x y )  swap >r swap >r call r> r> ;
: 2keep  ( x y q -- ... x y )  >r 2dup r> 2dip ;

\ cleave combinators: apply multiple quotations to the same input
: bi     ( x p q -- ... )      [ keep ] dip call ;
: tri    ( x p q r -- ... )    [ [ keep ] dip keep ] dip call ;

\ assertions (useful for scripts/plugins; portable via `error`)
: assert ( flag "msg" -- ) swap 0= [ error ] [ drop ] if ;

\ exceptions / recovery
\
\ `catch` is the low-level primitive: it runs a quotation, restores the stack on error,
\ and leaves an ior (0 on success, nonzero on failure). `last-error` returns a formatted
\ message for the most recent VM error.
\
\ These combinators are convenience words for the common patterns:
\ - `try?` gives a boolean success flag (and keeps `last-error` for details on failure)
\ - `try` runs a handler quotation on failure, passing (ior msg)

: try?   ( ..a q -- ..a ..b flag )   catch 0= ;

\ try: like Factor's `recover` pattern: run body; if it errors, run handler with (ior msg)
\ body:    ( ..a -- ..b )
\ handler: ( ..a ior msg -- ..b )
: try    ( ..a body handler -- ..b )
    >r            \ save handler
    catch         \ ..a ..b ior   |   ..a ior
    dup 0=
    [ drop r> drop ]          \ success: drop ior; drop handler
    [ last-error r> call ]    \ failure: pass (ior msg) to handler
    if
;


\ alias: some folks prefer `recover` for the same idea
: recover ( ..a body handler -- ..b ) try ;


\ finally/ensure: always run cleanup
\
\ `catch` restores the stack on error and leaves an ior. This word turns that
\ into a small "try/finally" pattern: run body, always run cleanup, then
\ re-throw the original error if body failed.
\
\ On success, cleanup runs with the post-body stack (..b).
\ On failure, cleanup runs with the pre-body stack (..a).
\
\ cleanup errors win (they replace the original body error).
\
\ body:    ( ..a -- ..b )
\ cleanup: ( ..a -- ..a ) on failure, or ( ..b -- ..b ) on success

: ensure ( ..a body cleanup -- ..b )
    >r          \ save cleanup
    catch       \ ..a ..b ior   |   ..a ior
    r>          \ .. ior cleanup
    swap >r     \ .. cleanup   (ior on return stack)
    call        \ run cleanup with stack restored/kept
    r>          \ .. ior
    dup 0= [ drop ] [ throw ] if
;

\ alias: some folks prefer `finally` for the same idea
: finally ( ..a body cleanup -- ..b ) ensure ;
