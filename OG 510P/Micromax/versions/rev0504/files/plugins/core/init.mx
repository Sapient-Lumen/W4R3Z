( core micromax-editor plugin )

: preinit ( -- )
;

: init ( -- )
  ( Basic navigation )
  "LeftArrow" "CursorLeft" "ed.bind" hostcall
  "RightArrow" "CursorRight" "ed.bind" hostcall
  "UpArrow" "PromptHistoryPrev|CursorUp" "ed.bind" hostcall
  "DownArrow" "PromptHistoryNext|CursorDown" "ed.bind" hostcall
  "Home" "StartOfLine" "ed.bind" hostcall
  "End" "EndOfLine" "ed.bind" hostcall

  ( Word navigation )
  "Ctrl-LeftArrow" "WordLeft" "ed.bind" hostcall
  "Ctrl-RightArrow" "WordRight" "ed.bind" hostcall
  "Shift-Ctrl-LeftArrow" "SelectWordLeft" "ed.bind" hostcall
  "Shift-Ctrl-RightArrow" "SelectWordRight" "ed.bind" hostcall

  ( Document + page navigation )
  "PageUp" "PageUp" "ed.bind" hostcall
  "PageDown" "PageDown" "ed.bind" hostcall
  "Ctrl-Home" "DocTop" "ed.bind" hostcall
  "Ctrl-End" "DocBottom" "ed.bind" hostcall

  ( Undo/redo )
  "Ctrl-z" "Undo" "ed.bind" hostcall
  "Ctrl-y" "Redo" "ed.bind" hostcall

  ( Basic editing )
  "Backspace" "Backspace" "ed.bind" hostcall
  "Delete" "Delete" "ed.bind" hostcall
  "Enter" "SubmitPrompt|InsertNewline" "ed.bind" hostcall

  ( Selection + clipboard [micro-esque defaults] )
  "Shift-LeftArrow" "SelectLeft" "ed.bind" hostcall
  "Shift-RightArrow" "SelectRight" "ed.bind" hostcall
  "Shift-UpArrow" "SelectUp" "ed.bind" hostcall
  "Shift-DownArrow" "SelectDown" "ed.bind" hostcall
  "Ctrl-a" "SelectAll" "ed.bind" hostcall

  "Ctrl-c" "Copy" "ed.bind" hostcall
  "Ctrl-x" "Cut" "ed.bind" hostcall
  "Ctrl-v" "Paste" "ed.bind" hostcall
  "Ctrl-k" "CutLine" "ed.bind" hostcall
  "Ctrl-d" "DuplicateLine" "ed.bind" hostcall

  ( Move lines [micro defaults] )
  "Alt-UpArrow" "MoveLinesUp" "ed.bind" hostcall
  "Alt-DownArrow" "MoveLinesDown" "ed.bind" hostcall

  ( Tab behavior [micro: Autocomplete|IndentSelection|InsertTab] )
  "Tab" "Autocomplete|IndentSelection|InsertTab" "ed.bind" hostcall
  "Shift-Tab" "PromptCompletePrev|UnindentSelection" "ed.bind" hostcall

  ( micro-esque command bar + search )
  "Ctrl-e" "CommandMode" "ed.bind" hostcall
  ( Common desktop editor muscle memory )
  "Ctrl-o" "command-edit:open " "ed.bind" hostcall
  ( URLs: open/copy URL under cursor [micro-urlopen style] )
  "Alt-o" "OpenUrlUnderCursor" "ed.bind" hostcall
  "Alt-y" "CopyUrlUnderCursor" "ed.bind" hostcall
  "Ctrl-r" "command-edit:replace " "ed.bind" hostcall
  ( Emacs/micro-adjacent muscle memory: interactive query-replace )
  "Alt-%" "command-edit:qreplace " "ed.bind" hostcall
  ( Micro-style pickers: buffer list + command palette )
  "Ctrl-b" "command:bufferpick" "ed.bind" hostcall
  ( Palettero-inspired default: Ctrl-Space opens command palette )
  "Ctrl-Space" "CommandPalette" "ed.bind" hostcall
  "Ctrl-f" "Find" "ed.bind" hostcall
  "Ctrl-n" "FindNext" "ed.bind" hostcall
  "Ctrl-p" "FindPrevious" "ed.bind" hostcall

  ( Discoverability: show reachable bindings )
  "Alt-g" "BindingPrompt" "ed.bind" hostcall

  ( Escape: close prompt, else clear selection, else clear multicursors )
  "Esc" "Escape|ClearSelection|RemoveAllMultiCursors" "ed.bind" hostcall

  ( command: bindings [micro supports `command:` prefix] )
  "Ctrl-s" "command:save" "ed.bind" hostcall
  "Ctrl-q" "command:quit" "ed.bind" hostcall
  "Alt-Shift-p" "command:pwd" "ed.bind" hostcall

  ( Help menu [micro-style Ctrl-g opens in-editor help] )
  "Ctrl-g" "command:helppick" "ed.bind" hostcall

  ( Macros [micro defaults] )
  "Ctrl-u" "ToggleMacro" "ed.bind" hostcall
  "Ctrl-j" "PlayMacro" "ed.bind" hostcall

  ( Navigation history [Vim/Helix-style jumplist] )
  ( Helix defaults: Ctrl-s save selection, Ctrl-o back, Ctrl-i forward. )
  ( We avoid Ctrl-i [often Tab] and keep Ctrl-s for file save. )
  "Alt-j" "PushJump" "ed.bind" hostcall
  "Alt-LeftArrow" "JumpBack" "ed.bind" hostcall
  "Alt-RightArrow" "JumpForward" "ed.bind" hostcall

  ( Multiple cursors [micro defaults] )
  "Alt-n" "SpawnMultiCursorSelect" "ed.bind" hostcall
  "Alt-Shift-Up" "SpawnMultiCursorUp" "ed.bind" hostcall
  "Alt-Shift-Down" "SpawnMultiCursorDown" "ed.bind" hostcall
  "Alt-p" "RemoveMultiCursor" "ed.bind" hostcall
  "Alt-c" "RemoveAllMultiCursors" "ed.bind" hostcall
  "Alt-x" "SkipMultiCursor" "ed.bind" hostcall
  "Alt-m" "SpawnMultiCursor" "ed.bind" hostcall

  ( Selection direction + primary selection [Helix/Kakoune-inspired] )
  "Alt-;" "FlipSelections" "ed.bind" hostcall
  "Alt-:" "EnsureSelectionsForward" "ed.bind" hostcall
  "Alt-," "CollapseToPrimary" "ed.bind" hostcall


  ( Prompt editing overrides [active when prompt is open] )
  "prompt" "LeftArrow" "PromptLeft" "ed.bind-mode" hostcall
  "prompt" "RightArrow" "PromptRight" "ed.bind-mode" hostcall
  "prompt" "Home" "PromptHome" "ed.bind-mode" hostcall
  "prompt" "End" "PromptEnd" "ed.bind-mode" hostcall
  "prompt" "Backspace" "PromptBackspace" "ed.bind-mode" hostcall
  "prompt" "Delete" "PromptDelete" "ed.bind-mode" hostcall

  ( Prompt picker UX: Up/Down moves selection when a picker list is visible.
    Fall back to history navigation for command/find prompts. )
  "prompt" "UpArrow" "PromptSuggestPrev|PromptHistoryPrev" "ed.bind-mode" hostcall
  "prompt" "DownArrow" "PromptSuggestNext|PromptHistoryNext" "ed.bind-mode" hostcall

  ( Prompt picker UX: PageUp/PageDown jumps selection by a small window. )
  "prompt" "PageUp" "PromptSuggestPageUp|PromptHistoryPrev" "ed.bind-mode" hostcall
  "prompt" "PageDown" "PromptSuggestPageDown|PromptHistoryNext" "ed.bind-mode" hostcall

  ( Jump between section headers in picker suggestion lists. )
  "prompt" "Alt-UpArrow" "PromptSuggestPrevSection" "ed.bind-mode" hostcall
  "prompt" "Alt-DownArrow" "PromptSuggestNextSection" "ed.bind-mode" hostcall

  ( Prompt picker UX: copy selected row or link target )
  "prompt" "Ctrl-y" "PromptCopySelected" "ed.bind-mode" hostcall

  ( Prompt picker UX: jump to first/last selection )
  "prompt" "Ctrl-Home" "PromptSuggestFirst|PromptHome" "ed.bind-mode" hostcall
  "prompt" "Ctrl-End" "PromptSuggestLast|PromptEnd" "ed.bind-mode" hostcall


  ( Query-replace confirmation mode [active during qreplace/queryreplace] )
  "qreplace" "y" "QueryReplaceYes" "ed.bind-mode" hostcall
  "qreplace" "Y" "QueryReplaceYes" "ed.bind-mode" hostcall
  "qreplace" "Enter" "QueryReplaceYes" "ed.bind-mode" hostcall

  "qreplace" "n" "QueryReplaceNo" "ed.bind-mode" hostcall
  "qreplace" "N" "QueryReplaceNo" "ed.bind-mode" hostcall

  "qreplace" "a" "QueryReplaceAll" "ed.bind-mode" hostcall
  "qreplace" "A" "QueryReplaceAll" "ed.bind-mode" hostcall

  "qreplace" "l" "QueryReplaceLast" "ed.bind-mode" hostcall
  "qreplace" "L" "QueryReplaceLast" "ed.bind-mode" hostcall

  "qreplace" "q" "QueryReplaceQuit" "ed.bind-mode" hostcall
  "qreplace" "Q" "QueryReplaceQuit" "ed.bind-mode" hostcall
  "qreplace" "Esc" "QueryReplaceQuit" "ed.bind-mode" hostcall

;

: postinit ( -- )
;
