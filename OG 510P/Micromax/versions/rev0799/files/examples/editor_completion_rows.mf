\ editor_completion_rows.mf
\ Load inside micromax-editor (or a VM with editor hostcalls installed).
\ Demonstrates a custom command plus prompt completion rows.

: greet-cmd ( args -- ok )
  dup len 0 = if
    drop "hello from greet" "ed.msg" hostcall
  else
    0 nth "hello, " swap + "ed.msg" hostcall
  then
  1
;

' greet-cmd "greet" "greet [name] - print a greeting" "ed.cmd-add" hostcall

: greet-row-alice ( -- row )
  list "alice " swap push "person" swap push "friendly default" swap push "example completion row" swap push
;

: greet-row-bob ( -- row )
  list "bob " swap push "person" swap push "friendly default" swap push "second example completion row" swap push
;

: greet-rows ( -- rows )
  list
  greet-row-alice swap push
  greet-row-bob swap push
;

: ed.complete.greet ( cmd tok_i prefix toks -- cands rows mode )
  drop drop drop drop
  "alice " list push "bob " swap push
  greet-rows
  2
;
