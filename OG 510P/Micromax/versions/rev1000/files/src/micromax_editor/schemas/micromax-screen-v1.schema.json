{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:micromax:schema:screen:v1",
  "title": "Micromax compact screen contract v1",
  "description": "A bounded, renderer-neutral snapshot of visible screen text, cursor position, source mapping, and non-empty visual cues.",
  "type": "object",
  "required": [
    "schema",
    "size",
    "cursor",
    "rows",
    "cues"
  ],
  "properties": {
    "schema": {
      "const": "micromax.screen.v1"
    },
    "size": {
      "$ref": "#/$defs/size"
    },
    "cursor": {
      "$ref": "#/$defs/cursor"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "cues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cue"
      },
      "maxItems": 65536
    }
  },
  "additionalProperties": false,
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
    },
    "size": {
      "type": "object",
      "required": [
        "lines",
        "cols"
      ],
      "properties": {
        "lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        }
      },
      "additionalProperties": false
    },
    "cursor": {
      "type": "object",
      "required": [
        "visible",
        "mode"
      ],
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/token"
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "visible": {
                "const": true
              }
            },
            "required": [
              "visible"
            ]
          },
          "then": {
            "required": [
              "y",
              "x"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "y"
                  ]
                },
                {
                  "required": [
                    "x"
                  ]
                }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "line",
        "column",
        "screen_x"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "screen_x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "continuation": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": [
        "y",
        "kind",
        "text"
      ],
      "properties": {
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "kind": {
          "$ref": "#/$defs/token"
        },
        "text": {
          "type": "string",
          "maxLength": 512
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/token"
          },
          "maxItems": 32
        }
      },
      "additionalProperties": false
    },
    "cue": {
      "type": "object",
      "required": [
        "y",
        "x",
        "end",
        "kind"
      ],
      "properties": {
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "kind": {
          "$ref": "#/$defs/token"
        }
      },
      "additionalProperties": false
    }
  }
}
