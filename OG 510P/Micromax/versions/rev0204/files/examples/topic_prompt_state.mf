\ Topic prompt / searchable help prompt demo.
\
\ This is mainly a tiny reference for future humans/LLMs:
\ - open the topic prompt with a query
\ - inspect the active row without recomputing ranking
\ - inspect the current coarse section / preview text

: demo.topic-prompt-state ( -- row )
  "visible micromax" "ed.topic-prompt" hostcall
  "ed.prompt-current-row" hostcall
;

: demo.topic-prompt-preview ( -- section preview )
  "visible micromax" "ed.topic-prompt" hostcall
  "ed.prompt-current-section" hostcall
  "ed.prompt-current-preview" hostcall
;
