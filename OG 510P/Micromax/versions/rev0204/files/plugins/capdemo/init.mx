( capdemo - minimal capability-checking example plugin )

: capdemo ( args -- ok )
  drop
  host.api-version "host.api-version={} " 1 format "ed.msg" hostcall

  host.features len "host.features count={}" swap 1 format "ed.msg" hostcall

  "ed.recent-section-rows" host.feature? "feat ed.recent-section-rows?={}" swap 1 format "ed.msg" hostcall
  "ed.with-viewport" host.feature? "feat ed.with-viewport?={}" swap 1 format "ed.msg" hostcall
  "mx.regex" host.feature? "feat mx.regex?={}" swap 1 format "ed.msg" hostcall
  1
;

: capdemo.recent ( args -- ok )
  drop
  "ed.recent-section-rows" host.feature? 0 =
  [ "capdemo: ed.recent-section-rows not available" "ed.msg" hostcall 0 ]
  [
    "" "ed.recent-section-rows" hostcall
    len "recent sections={}" swap 1 format "ed.msg" hostcall
    1
  ]
  if
;

' capdemo "capdemo" "Show host features (capability checks)" "ed.cmd-add" hostcall drop
' capdemo.recent "capdemo.recent" "Show grouped recent-file rows (if supported)" "ed.cmd-add" hostcall drop

"[capdemo] loaded" "ed.msg" hostcall
