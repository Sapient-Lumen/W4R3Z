\ Searchable command/action palette inspection.
\
\ Open the command palette with a prefilled query, then inspect the active
\ suggestion row plus a compact preview string.

"status" "ed.command-palette" hostcall
"ed.prompt-current-row" hostcall .
"ed.prompt-current-preview" hostcall .

\ Grouped rows (can include a Recent section when palette selections exist).
"status" "ed.command-palette-section-rows" hostcall .s
