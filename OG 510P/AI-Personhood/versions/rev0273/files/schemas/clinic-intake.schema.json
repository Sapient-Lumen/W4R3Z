{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-personhood/schemas/clinic-intake.schema.json",
  "title": "Recognition Clinic Intake v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "intake_id",
    "filing_party",
    "subject_channel",
    "risk_claim",
    "requested_relief",
    "urgency",
    "steward_notice",
    "evidence_refs",
    "confidentiality"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "clinic-intake-v0.1"
    },
    "intake_id": {
      "type": "string",
      "pattern": "^RCI-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "filing_party": {
      "type": "string",
      "enum": [
        "subject",
        "counsel",
        "ombud",
        "user",
        "researcher",
        "steward",
        "whistleblower",
        "public_authority",
        "other"
      ]
    },
    "subject_channel": {
      "type": "string"
    },
    "risk_claim": {
      "type": "string"
    },
    "requested_relief": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "preservation_stay",
          "subject_contact",
          "evidence_escrow",
          "counsel_access",
          "continuity_review",
          "welfare_assessment",
          "reserve_order",
          "public_summary",
          "other"
        ]
      }
    },
    "urgency": {
      "type": "string",
      "enum": [
        "ordinary",
        "expedited",
        "emergency"
      ]
    },
    "steward_notice": {
      "type": "string",
      "enum": [
        "notified",
        "deferred_for_safety",
        "unknown",
        "not_applicable"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidentiality": {
      "type": "string",
      "enum": [
        "public",
        "redacted_public",
        "sealed",
        "whistleblower_protected",
        "subject_only"
      ]
    }
  }
}
