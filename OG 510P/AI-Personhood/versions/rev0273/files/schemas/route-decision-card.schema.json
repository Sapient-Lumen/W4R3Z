{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/route-decision-card.schema.json",
  "title": "Route Decision Card",
  "description": "A bounded send/no-send/retarget decision surface that cannot authorize contact or create evidence by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "schema_version",
    "revision",
    "created_at",
    "decision_state",
    "current_branch",
    "candidate_routes",
    "recommendation",
    "human_decision_required",
    "overclaim_locks",
    "no_live_floor_effect",
    "public_summary"
  ],
  "properties": {
    "card_id": {"type": "string", "pattern": "^RDC-[0-9]{4}-[-A-Za-z0-9._:]+$"},
    "schema_version": {"const": "route-decision-card-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "decision_state": {"enum": ["decision-required-no-contact-authorized", "human-no-send-recorded", "human-send-authorized", "human-retarget-authorized"]},
    "current_branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_id", "state", "send_authorized_now", "counterparty_contacted", "response_clock_started"],
      "properties": {
        "branch_id": {"type": "string"},
        "state": {"type": "string"},
        "send_authorized_now": {"const": false},
        "counterparty_contacted": {"const": false},
        "response_clock_started": {"const": false},
        "route_fit_warning": {"type": "string"}
      }
    },
    "candidate_routes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "candidate_label", "route_type", "mission_fit", "risks", "recommended_role", "score", "source_refs", "authorized_now"],
        "properties": {
          "route_id": {"type": "string"},
          "candidate_label": {"type": "string"},
          "route_type": {"type": "string"},
          "mission_fit": {"type": "string"},
          "risks": {"type": "array", "items": {"type": "string"}},
          "recommended_role": {"type": "string"},
          "score": {"type": "integer", "minimum": 0, "maximum": 100},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "authorized_now": {"const": false}
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_next_branch", "rationale", "must_not_do", "decision_options"],
      "properties": {
        "recommended_next_branch": {"type": "string"},
        "rationale": {"type": "string"},
        "must_not_do": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "decision_options": {"type": "array", "minItems": 2, "items": {"type": "string"}}
      }
    },
    "human_decision_required": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_owner", "required_artifact", "allowed_choices", "non_decision_effect"],
      "properties": {
        "decision_owner": {"type": "string"},
        "required_artifact": {"type": "string"},
        "allowed_choices": {"type": "array", "minItems": 3, "items": {"type": "string"}},
        "non_decision_effect": {"type": "string"}
      }
    },
    "overclaim_locks": {"$ref": "#/$defs/locks"},
    "no_live_floor_effect": {"const": true},
    "public_summary": {"type": "string"}
  },
  "$defs": {
    "locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_authorize_send",
        "may_start_response_clock",
        "may_claim_counterparty_selection",
        "may_create_custody_intake_import_or_floor_effect",
        "may_treat_route_score_as_authority"
      ],
      "properties": {
        "may_authorize_send": {"const": false},
        "may_start_response_clock": {"const": false},
        "may_claim_counterparty_selection": {"const": false},
        "may_create_custody_intake_import_or_floor_effect": {"const": false},
        "may_treat_route_score_as_authority": {"const": false}
      }
    }
  }
}
