{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-send-trace-shell.schema.json",
  "title": "External Contact Send Trace Shell",
  "description": "Public-shell record for an external-contact outbound send trace. It protects raw transport evidence outside the release tree and blocks mail drafts, Message-ID/header presence, provider UI screenshots, or public shells from becoming response clocks, custody, failed-gate shells, authority, intake, import, recognition, waiver, adverse inference, or live-floor effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shell_id",
    "schema_version",
    "revision",
    "created_at",
    "send_trace_state",
    "source_send_proof_record_ref",
    "source_execution_record_ref",
    "source_dispatch_authorization_card_ref",
    "source_mail_ready_draft_ref",
    "trace_capture_tool",
    "candidate_trace",
    "message_header_checks",
    "deadline_binding",
    "public_shell_policy",
    "response_clock_guard",
    "downstream_locks",
    "linked_queue_ids",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "shell_id": {"type": "string", "pattern": "^ECSTS-[0-9]{4}-[A-Za-z0-9._:-]+$"},
    "schema_version": {"const": "external-contact-send-trace-shell-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "send_trace_state": {"type": "string", "enum": ["pre-dispatch-no-transport", "transport-candidate-staged", "superseded"]},
    "source_send_proof_record_ref": {"type": "string", "minLength": 10},
    "source_execution_record_ref": {"type": "string", "minLength": 10},
    "source_dispatch_authorization_card_ref": {"type": "string", "minLength": 10},
    "source_mail_ready_draft_ref": {"type": "string", "minLength": 10},
    "trace_capture_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_path", "raw_input_required_outside_release_tree", "copy_to_private_vault_only", "public_shell_only", "check_output_supported", "tool_is_not_dispatch_or_response"],
      "properties": {
        "tool_path": {"const": "tools/stage_external_contact_send_trace.py"},
        "raw_input_required_outside_release_tree": {"const": true},
        "copy_to_private_vault_only": {"const": true},
        "public_shell_only": {"const": true},
        "check_output_supported": {"const": true},
        "tool_is_not_dispatch_or_response": {"const": true}
      }
    },
    "candidate_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_trace_present_now", "source_locator", "private_trace_locator", "raw_trace_sha256", "size_bytes", "mime_type", "trace_format", "raw_trace_publicly_embedded", "screenshot_only", "provider_ui_only", "message_id_observed", "transport_proof_present_now"],
      "properties": {
        "raw_trace_present_now": {"type": "boolean"},
        "source_locator": {"type": ["string", "null"]},
        "private_trace_locator": {"type": ["string", "null"]},
        "raw_trace_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 1},
        "mime_type": {"type": ["string", "null"]},
        "trace_format": {"type": ["string", "null"], "enum": ["raw-rfc822-sent-message", "provider-sent-export", "smtp-log-export", "signed-provider-receipt", "other", null]},
        "raw_trace_publicly_embedded": {"const": false},
        "screenshot_only": {"const": false},
        "provider_ui_only": {"const": false},
        "message_id_observed": {"type": ["string", "null"]},
        "transport_proof_present_now": {"type": "boolean"}
      }
    },
    "message_header_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rfc5322_parse_attempted", "message_id_present", "date_header_present", "from_header_present", "to_header_present", "subject_present", "received_or_provider_trace_present", "authentication_results_present", "dkim_or_dmarc_result_present", "message_id_may_start_response_clock", "headers_may_create_custody", "auth_results_may_create_authority"],
      "properties": {
        "rfc5322_parse_attempted": {"type": "boolean"},
        "message_id_present": {"type": "boolean"},
        "date_header_present": {"type": "boolean"},
        "from_header_present": {"type": "boolean"},
        "to_header_present": {"type": "boolean"},
        "subject_present": {"type": "boolean"},
        "received_or_provider_trace_present": {"type": "boolean"},
        "authentication_results_present": {"type": "boolean"},
        "dkim_or_dmarc_result_present": {"type": "boolean"},
        "message_id_may_start_response_clock": {"const": false},
        "headers_may_create_custody": {"const": false},
        "auth_results_may_create_authority": {"const": false}
      }
    },
    "deadline_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_deadline_days", "sent_at_present_now", "sent_at_utc", "deadline_at", "deadline_may_start_now", "deadline_requires_actual_sent_at_and_transport_proof", "deadline_may_be_computed_from_draft_date", "silence_may_be_recorded_now"],
      "properties": {
        "response_deadline_days": {"type": "integer", "minimum": 1, "maximum": 90},
        "sent_at_present_now": {"type": "boolean"},
        "sent_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "deadline_at": {"type": ["string", "null"], "format": "date-time"},
        "deadline_may_start_now": {"const": false},
        "deadline_requires_actual_sent_at_and_transport_proof": {"const": true},
        "deadline_may_be_computed_from_draft_date": {"const": false},
        "silence_may_be_recorded_now": {"const": false}
      }
    },
    "public_shell_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shell_created_now", "allowed_public_fields", "forbidden_public_fields", "public_shell_may_satisfy_transport_proof", "private_raw_trace_required_for_sent_state", "public_shell_may_publish_raw_headers", "public_shell_may_start_response_clock"],
      "properties": {
        "shell_created_now": {"type": "boolean"},
        "allowed_public_fields": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 3}},
        "forbidden_public_fields": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 3}},
        "public_shell_may_satisfy_transport_proof": {"const": false},
        "private_raw_trace_required_for_sent_state": {"const": true},
        "public_shell_may_publish_raw_headers": {"const": false},
        "public_shell_may_start_response_clock": {"const": false}
      }
    },
    "response_clock_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock_may_start_now", "requires_signed_authorization", "requires_sent_at", "requires_private_transport_trace", "requires_public_trace_shell", "requires_send_proof_record_update", "auto_ack_routes_to_triage_not_response", "silence_is_not_waiver"],
      "properties": {
        "clock_may_start_now": {"const": false},
        "requires_signed_authorization": {"const": true},
        "requires_sent_at": {"const": true},
        "requires_private_transport_trace": {"const": true},
        "requires_public_trace_shell": {"const": true},
        "requires_send_proof_record_update": {"const": true},
        "auto_ack_routes_to_triage_not_response": {"const": true},
        "silence_is_not_waiver": {"const": true}
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_treat_draft_as_sent", "may_treat_message_id_as_response_clock", "may_treat_header_auth_as_authority", "may_create_failed_gate_shell_now", "may_create_response_record", "may_create_custody_record", "may_create_intake_record", "may_create_import_gate", "may_increment_live_floor", "may_claim_status_or_waiver", "may_publish_raw_trace"],
      "properties": {
        "may_treat_draft_as_sent": {"const": false},
        "may_treat_message_id_as_response_clock": {"const": false},
        "may_treat_header_auth_as_authority": {"const": false},
        "may_create_failed_gate_shell_now": {"const": false},
        "may_create_response_record": {"const": false},
        "may_create_custody_record": {"const": false},
        "may_create_intake_record": {"const": false},
        "may_create_import_gate": {"const": false},
        "may_increment_live_floor": {"const": false},
        "may_claim_status_or_waiver": {"const": false},
        "may_publish_raw_trace": {"const": false}
      }
    },
    "linked_queue_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "related_surfaces": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "public_summary": {"type": "string", "minLength": 120},
    "no_live_floor_effect": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"send_trace_state": {"const": "pre-dispatch-no-transport"}}, "required": ["send_trace_state"]},
      "then": {
        "properties": {
          "candidate_trace": {
            "properties": {
              "raw_trace_present_now": {"const": false},
              "source_locator": {"const": null},
              "private_trace_locator": {"const": null},
              "raw_trace_sha256": {"const": null},
              "size_bytes": {"const": null},
              "mime_type": {"const": null},
              "trace_format": {"const": null},
              "message_id_observed": {"const": null},
              "transport_proof_present_now": {"const": false}
            }
          },
          "message_header_checks": {
            "properties": {
              "rfc5322_parse_attempted": {"const": false},
              "message_id_present": {"const": false},
              "date_header_present": {"const": false},
              "from_header_present": {"const": false},
              "to_header_present": {"const": false},
              "subject_present": {"const": false},
              "received_or_provider_trace_present": {"const": false},
              "authentication_results_present": {"const": false},
              "dkim_or_dmarc_result_present": {"const": false}
            }
          },
          "deadline_binding": {
            "properties": {
              "sent_at_present_now": {"const": false},
              "sent_at_utc": {"const": null},
              "deadline_at": {"const": null}
            }
          },
          "public_shell_policy": {
            "properties": {"shell_created_now": {"const": false}}
          }
        }
      }
    }
  ]
}
