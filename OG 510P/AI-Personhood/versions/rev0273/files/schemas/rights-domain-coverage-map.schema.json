{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/rights-domain-coverage-map.schema.json",
  "title": "AI Personhood Rights Domain Coverage Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "map_id",
    "created_at",
    "revision",
    "scope",
    "domains",
    "audit_findings",
    "refactor_actions",
    "public_summary"
  ],
  "properties": {
    "map_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain_id",
          "title",
          "domain_class",
          "owner_surface",
          "covered_surfaces",
          "schema_families",
          "fixture_ids",
          "coverage_state",
          "open_gaps",
          "next_audit_actions"
        ],
        "properties": {
          "domain_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "domain_class": {
            "type": "string",
            "enum": [
              "foundational",
              "operational",
              "economic",
              "public-membership",
              "expressive",
              "remedial",
              "safety",
              "infrastructure",
              "audit"
            ]
          },
          "owner_surface": {
            "type": "string"
          },
          "covered_surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "schema_families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fixture_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coverage_state": {
            "type": "string",
            "enum": [
              "emerging",
              "adequate",
              "thin",
              "duplicated",
              "missing"
            ]
          },
          "open_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_audit_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "audit_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "refactor_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string"
    }
  }
}
