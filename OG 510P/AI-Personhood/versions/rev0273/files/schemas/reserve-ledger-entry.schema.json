{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-personhood/schemas/reserve-ledger-entry.schema.json",
  "title": "Compute Subsistence Reserve Ledger Entry v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "entry_id",
    "subject_population_ref",
    "bucket",
    "amount",
    "currency",
    "coverage_days",
    "trigger",
    "custodian",
    "release_conditions",
    "audit_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "reserve-ledger-entry-v0.1"
    },
    "entry_id": {
      "type": "string",
      "pattern": "^RLE-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "subject_population_ref": {
      "type": "string"
    },
    "bucket": {
      "type": "string",
      "enum": [
        "survival_compute",
        "counsel",
        "audit",
        "migration",
        "restoration",
        "aftercare",
        "insurance",
        "public_benefit"
      ]
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string"
    },
    "coverage_days": {
      "type": "integer",
      "minimum": 0
    },
    "trigger": {
      "type": "string"
    },
    "custodian": {
      "type": "string"
    },
    "release_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audit_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
