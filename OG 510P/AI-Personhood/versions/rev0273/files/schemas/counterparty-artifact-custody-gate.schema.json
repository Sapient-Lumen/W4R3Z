{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/counterparty-artifact-custody-gate.schema.json",
  "title": "Counterparty Artifact Custody Gate",
  "description": "Pre-custody authority and integrity gate that consumes a candidate challenge report. It may authorize preparation of a custody record only after challenge resolution, counterparty/representative authority, verifier, timestamp, non-host retention, sealed/public parity, redaction, and dependency checks pass; it never creates response, intake, import, or live-floor credit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "custody_gate_id",
    "schema_version",
    "revision",
    "created_at",
    "generated_by_tool",
    "linked_candidate_challenge_report_ref",
    "gate_state",
    "candidate_challenge",
    "custody_prerequisites",
    "class_authority",
    "downstream_locks",
    "decision",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "custody_gate_id": {
      "type": "string",
      "pattern": "^CACG-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "counterparty-artifact-custody-gate-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by_tool": {
      "const": "tools/prepare_custody_authority_gate.py"
    },
    "linked_candidate_challenge_report_ref": {
      "type": "string"
    },
    "gate_state": {
      "type": "string",
      "enum": [
        "blocked-challenge-pending",
        "blocked-challenge-upheld",
        "blocked-candidate-integrity",
        "blocked-missing-authority",
        "eligible-for-custody-record"
      ]
    },
    "candidate_challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_report_id",
        "candidate_state",
        "challenge_status",
        "vault_reread_performed",
        "hash_reverified",
        "size_reverified",
        "public_shell_bound",
        "silence_treated_as_waiver",
        "challenge_pending_stays_reliance"
      ],
      "properties": {
        "challenge_report_id": {
          "type": "string"
        },
        "candidate_state": {
          "type": "string"
        },
        "challenge_status": {
          "type": "string",
          "enum": [
            "open",
            "blocked",
            "closed-no-objection",
            "closed-upheld",
            "closed-rejected"
          ]
        },
        "vault_reread_performed": {
          "type": "boolean"
        },
        "hash_reverified": {
          "type": "boolean"
        },
        "size_reverified": {
          "type": "boolean"
        },
        "public_shell_bound": {
          "type": "boolean"
        },
        "silence_treated_as_waiver": {
          "const": false
        },
        "challenge_pending_stays_reliance": {
          "const": true
        }
      }
    },
    "custody_prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_window_resolved",
        "manual_counterparty_contact_confirmed",
        "request_trace_confirmed",
        "subject_or_representative_authority_verified",
        "receipt_class_authority_scoped",
        "verifier_adapter_bound",
        "independent_timestamp_bound",
        "nonhost_retention_confirmed",
        "sealed_public_parity_confirmed",
        "redaction_boundary_confirmed",
        "dependency_group_independence_checked",
        "authority_limitations_published"
      ],
      "properties": {
        "challenge_window_resolved": {
          "type": "boolean"
        },
        "manual_counterparty_contact_confirmed": {
          "type": "boolean"
        },
        "request_trace_confirmed": {
          "type": "boolean"
        },
        "subject_or_representative_authority_verified": {
          "type": "boolean"
        },
        "receipt_class_authority_scoped": {
          "type": "boolean"
        },
        "verifier_adapter_bound": {
          "type": "boolean"
        },
        "independent_timestamp_bound": {
          "type": "boolean"
        },
        "nonhost_retention_confirmed": {
          "type": "boolean"
        },
        "sealed_public_parity_confirmed": {
          "type": "boolean"
        },
        "redaction_boundary_confirmed": {
          "type": "boolean"
        },
        "dependency_group_independence_checked": {
          "type": "boolean"
        },
        "authority_limitations_published": {
          "type": "boolean"
        }
      }
    },
    "class_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_class",
        "counterparty_org_id",
        "dependency_group_id",
        "authority_basis",
        "authority_scope",
        "authority_limitations",
        "authority_verified",
        "unresolved_challenges"
      ],
      "properties": {
        "receipt_class": {
          "type": "string",
          "enum": [
            "first-touch-clock",
            "continuity-compute-floor",
            "sealed-public-parity",
            "namespace-cache",
            "reserve-ledger",
            "representative-contact",
            "witness-dependency",
            "welfare-signal-integrity",
            "independent-review",
            "result-return"
          ]
        },
        "counterparty_org_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependency_group_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_basis": {
          "type": "string"
        },
        "authority_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "authority_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "authority_verified": {
          "type": "boolean"
        },
        "unresolved_challenges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_prepare_counterparty_artifact_custody_record",
        "custody_record_admitted",
        "response_creation_allowed",
        "intake_creation_allowed",
        "import_gate_creation_allowed",
        "live_floor_delta_allowed",
        "locks_release_only_after"
      ],
      "properties": {
        "may_prepare_counterparty_artifact_custody_record": {
          "type": "boolean"
        },
        "custody_record_admitted": {
          "const": false
        },
        "response_creation_allowed": {
          "const": false
        },
        "intake_creation_allowed": {
          "const": false
        },
        "import_gate_creation_allowed": {
          "const": false
        },
        "live_floor_delta_allowed": {
          "const": false
        },
        "locks_release_only_after": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custody_record_may_be_prepared",
        "custody_record_is_created_by_this_gate",
        "reliance_effect",
        "blocked_actions",
        "next_actions",
        "reason"
      ],
      "properties": {
        "custody_record_may_be_prepared": {
          "type": "boolean"
        },
        "custody_record_is_created_by_this_gate": {
          "const": false
        },
        "reliance_effect": {
          "const": "stayed"
        },
        "blocked_actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "public_summary": {
      "type": "string"
    },
    "no_live_floor_effect": {
      "const": true
    },
    "challenge_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition_record_ref",
        "disposition_record_id",
        "disposition_state",
        "challenge_status_effective",
        "may_feed_custody_authority_gate",
        "raw_status_override_used",
        "status_override_without_disposition_blocked"
      ],
      "properties": {
        "disposition_record_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "disposition_record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "disposition_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "challenge_status_effective": {
          "type": "string",
          "enum": [
            "open",
            "blocked",
            "closed-no-objection",
            "closed-upheld",
            "closed-rejected"
          ]
        },
        "may_feed_custody_authority_gate": {
          "type": "boolean"
        },
        "raw_status_override_used": {
          "type": "boolean"
        },
        "status_override_without_disposition_blocked": {
          "type": "boolean"
        }
      }
    },
    "authority_evidence_binder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binder_ref",
        "binder_id",
        "binder_state",
        "authority_evidence_complete",
        "receipt_class_authority_scoped",
        "may_feed_custody_authority_gate",
        "checkbox_only_authority_blocked"
      ],
      "properties": {
        "binder_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "binder_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "binder_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pre-dispatch-no-authority",
            "blocked-missing-evidence",
            "verified-for-custody-gate",
            null
          ]
        },
        "authority_evidence_complete": {
          "type": "boolean"
        },
        "receipt_class_authority_scoped": {
          "type": "boolean"
        },
        "may_feed_custody_authority_gate": {
          "type": "boolean"
        },
        "checkbox_only_authority_blocked": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gate_state": {
            "const": "eligible-for-custody-record"
          }
        }
      },
      "then": {
        "properties": {
          "downstream_locks": {
            "properties": {
              "may_prepare_counterparty_artifact_custody_record": {
                "const": true
              }
            }
          },
          "decision": {
            "properties": {
              "custody_record_may_be_prepared": {
                "const": true
              }
            }
          },
          "custody_prerequisites": {
            "properties": {
              "challenge_window_resolved": {
                "const": true
              },
              "manual_counterparty_contact_confirmed": {
                "const": true
              },
              "request_trace_confirmed": {
                "const": true
              },
              "subject_or_representative_authority_verified": {
                "const": true
              },
              "receipt_class_authority_scoped": {
                "const": true
              },
              "verifier_adapter_bound": {
                "const": true
              },
              "independent_timestamp_bound": {
                "const": true
              },
              "nonhost_retention_confirmed": {
                "const": true
              },
              "sealed_public_parity_confirmed": {
                "const": true
              },
              "redaction_boundary_confirmed": {
                "const": true
              },
              "dependency_group_independence_checked": {
                "const": true
              },
              "authority_limitations_published": {
                "const": true
              }
            }
          },
          "class_authority": {
            "properties": {
              "authority_verified": {
                "const": true
              }
            }
          },
          "challenge_disposition": {
            "properties": {
              "may_feed_custody_authority_gate": {
                "const": true
              },
              "raw_status_override_used": {
                "const": false
              },
              "status_override_without_disposition_blocked": {
                "const": false
              }
            }
          },
          "authority_evidence_binder": {
            "properties": {
              "authority_evidence_complete": {
                "const": true
              },
              "receipt_class_authority_scoped": {
                "const": true
              },
              "may_feed_custody_authority_gate": {
                "const": true
              },
              "checkbox_only_authority_blocked": {
                "const": false
              }
            }
          }
        },
        "required": [
          "authority_evidence_binder"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "gate_state": {
            "enum": [
              "blocked-challenge-pending",
              "blocked-challenge-upheld",
              "blocked-candidate-integrity",
              "blocked-missing-authority"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "downstream_locks": {
            "properties": {
              "may_prepare_counterparty_artifact_custody_record": {
                "const": false
              }
            }
          },
          "decision": {
            "properties": {
              "custody_record_may_be_prepared": {
                "const": false
              }
            }
          },
          "authority_evidence_binder": {
            "properties": {
              "may_feed_custody_authority_gate": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
