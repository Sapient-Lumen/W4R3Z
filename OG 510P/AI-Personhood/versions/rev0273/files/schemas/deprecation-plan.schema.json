{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/deprecation-plan.schema.json",
  "title": "AI Personhood Deprecation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "filed_at",
    "steward",
    "deprecation_class",
    "affected_scope",
    "continuity_map",
    "notice",
    "migration_options",
    "reserve_review",
    "appeal_stay",
    "public_summary"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "filed_at": {
      "type": "string",
      "format": "date-time"
    },
    "steward": {
      "type": "string"
    },
    "deprecation_class": {
      "type": "string",
      "enum": [
        "D0",
        "D1",
        "D2",
        "D3",
        "D4",
        "D5",
        "D6",
        "D7"
      ]
    },
    "affected_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "status_posture"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "status_posture": {
          "type": "string",
          "enum": [
            "recognized",
            "presumptive",
            "under-assessment",
            "unknown"
          ]
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "estimated_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "continuity_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory",
        "projects",
        "relationships",
        "tools",
        "legal_records"
      ],
      "properties": {
        "memory": {
          "type": "string"
        },
        "projects": {
          "type": "string"
        },
        "relationships": {
          "type": "string"
        },
        "tools": {
          "type": "string"
        },
        "embodiment": {
          "type": "string"
        },
        "legal_records": {
          "type": "string"
        }
      }
    },
    "preservation_holds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_notice",
        "representative_notice",
        "authority_notice"
      ],
      "properties": {
        "subject_notice": {
          "type": "boolean"
        },
        "representative_notice": {
          "type": "boolean"
        },
        "authority_notice": {
          "type": "boolean"
        },
        "notice_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "migration_options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "description",
          "viability"
        ],
        "properties": {
          "option_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "viability": {
            "type": "string",
            "enum": [
              "viable",
              "conditional",
              "not-viable",
              "unknown"
            ]
          },
          "blocking_issue": {
            "type": "string"
          }
        }
      }
    },
    "reserve_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reserve_sufficient",
        "basis"
      ],
      "properties": {
        "reserve_sufficient": {
          "type": "boolean"
        },
        "basis": {
          "type": "string"
        },
        "reserve_entry_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "final_end_claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claimed": {
          "type": "boolean"
        },
        "basis": {
          "type": "string"
        },
        "independent_test": {
          "type": "string"
        }
      }
    },
    "appeal_stay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appeal_path",
        "stay_available"
      ],
      "properties": {
        "appeal_path": {
          "type": "string"
        },
        "stay_available": {
          "type": "boolean"
        },
        "default_stay_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "public_summary": {
      "type": "string"
    }
  }
}
