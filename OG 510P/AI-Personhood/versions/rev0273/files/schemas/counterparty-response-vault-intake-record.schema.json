{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/counterparty-response-vault-intake-record.schema.json",
  "title": "Counterparty Response Vault Intake Record",
  "description": "Bridge record between external-contact response triage and private-vault/evidence-drop handling. It binds the triage route, public hash shell, private vault policy, and evidence-drop ledger before any LEAP candidate, custody, formal response, intake, import, status, or live-floor effect can be claimed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intake_record_id",
    "schema_version",
    "revision",
    "created_at",
    "record_state",
    "source_triage_record_ref",
    "source_evidence_drop_ledger_ref",
    "source_public_shell_ref",
    "source_private_vault_policy_ref",
    "source_leap_packet_ref",
    "intake_boundary",
    "minimum_before_candidate_use",
    "vault_public_split",
    "public_shell_rules",
    "admission_decision",
    "downstream_locks",
    "operator_next_steps",
    "linked_queue_ids",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "intake_record_id": {"type": "string", "pattern": "^CRVIR-[0-9]{4}-[A-Za-z0-9._:-]+$"},
    "schema_version": {"const": "counterparty-response-vault-intake-record-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "record_state": {
      "type": "string",
      "enum": [
        "pre-dispatch-no-inbound",
        "dispatch-window-open-no-inbound",
        "raw-candidate-staged-private-vault",
        "redacted-only-shell",
        "protocol-output-quarantined",
        "failed-gate-shell-only",
        "rejected",
        "superseded"
      ]
    },
    "source_triage_record_ref": {"type": "string"},
    "source_evidence_drop_ledger_ref": {"type": "string"},
    "source_public_shell_ref": {"type": "string"},
    "source_private_vault_policy_ref": {"type": "string"},
    "source_leap_packet_ref": {"type": "string"},
    "intake_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inbound_artifact_present",
        "evidence_drop_role",
        "evidence_drop_intake_mode",
        "source_payload_kind",
        "raw_payload_private_vault_locator",
        "raw_payload_retained",
        "redacted_copy_only",
        "protocol_or_tool_output",
        "public_hash_shell_present",
        "counterparty_permission_state",
        "retention_permission_present",
        "nonhost_retention_present",
        "independent_timestamp_present",
        "authority_present",
        "can_open_leap_candidate_state",
        "can_create_custody_or_response_record"
      ],
      "properties": {
        "inbound_artifact_present": {"type": "boolean"},
        "evidence_drop_role": {"type": "string", "enum": ["none-yet", "synthetic-control-only", "live-candidate-unverified", "rejected-or-redacted-only"]},
        "evidence_drop_intake_mode": {"type": "string", "enum": ["none", "ready-no-drop", "quarantine-control", "live-candidate-drop", "rejected"]},
        "source_payload_kind": {"type": "string", "enum": ["none", "raw-email", "signed-letter", "web-form-receipt", "api-payload", "mcp-tool-output", "a2a-task-artifact", "federated-relay", "public-redaction", "file-upload", "unknown"]},
        "raw_payload_private_vault_locator": {"type": ["string", "null"], "pattern": "^private-vault://.*$"},
        "raw_payload_retained": {"type": "boolean"},
        "redacted_copy_only": {"type": "boolean"},
        "protocol_or_tool_output": {"type": "boolean"},
        "public_hash_shell_present": {"type": "boolean"},
        "counterparty_permission_state": {"type": "string", "enum": ["not-applicable-yet", "unknown", "declined", "retention-permitted", "public-shell-permitted", "conditional", "forbidden"]},
        "retention_permission_present": {"type": "boolean"},
        "nonhost_retention_present": {"type": "boolean"},
        "independent_timestamp_present": {"type": "boolean"},
        "authority_present": {"type": "boolean"},
        "can_open_leap_candidate_state": {"type": "boolean"},
        "can_create_custody_or_response_record": {"const": false}
      }
    },
    "minimum_before_candidate_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_payload_staged_outside_release_required",
        "hash_size_mime_bound_required",
        "transport_trace_required",
        "counterparty_identity_required",
        "retention_permission_required",
        "nonhost_retention_required",
        "independent_timestamp_required",
        "authority_verification_required",
        "public_shell_required",
        "challenge_replay_required",
        "all_present_now"
      ],
      "properties": {
        "raw_payload_staged_outside_release_required": {"const": true},
        "hash_size_mime_bound_required": {"const": true},
        "transport_trace_required": {"const": true},
        "counterparty_identity_required": {"const": true},
        "retention_permission_required": {"const": true},
        "nonhost_retention_required": {"const": true},
        "independent_timestamp_required": {"const": true},
        "authority_verification_required": {"const": true},
        "public_shell_required": {"const": true},
        "challenge_replay_required": {"const": true},
        "all_present_now": {"type": "boolean"}
      }
    },
    "vault_public_split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_vault_root_policy",
        "stage_tool",
        "public_release_may_include_raw_bytes",
        "redacted_copy_may_satisfy_raw_custody",
        "protocol_output_may_satisfy_raw_custody",
        "private_vault_uri_may_satisfy_authority",
        "hash_shell_may_satisfy_response",
        "synthetic_control_may_satisfy_live_artifact"
      ],
      "properties": {
        "private_vault_root_policy": {"const": "outside-release-tree"},
        "stage_tool": {"const": "tools/stage_live_evidence_drop.py"},
        "public_release_may_include_raw_bytes": {"const": false},
        "redacted_copy_may_satisfy_raw_custody": {"const": false},
        "protocol_output_may_satisfy_raw_custody": {"const": false},
        "private_vault_uri_may_satisfy_authority": {"const": false},
        "hash_shell_may_satisfy_response": {"const": false},
        "synthetic_control_may_satisfy_live_artifact": {"const": false}
      }
    },
    "public_shell_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_shell_required_before_any_public_claim",
        "allowed_public_fields",
        "forbidden_public_fields",
        "failed_gate_shell_required_when_blocked",
        "shell_language_required"
      ],
      "properties": {
        "public_shell_required_before_any_public_claim": {"const": true},
        "allowed_public_fields": {"type": "array", "minItems": 5, "items": {"type": "string"}},
        "forbidden_public_fields": {"type": "array", "minItems": 7, "items": {"type": "string"}},
        "failed_gate_shell_required_when_blocked": {"const": true},
        "shell_language_required": {"type": "array", "minItems": 5, "items": {"type": "string"}}
      }
    },
    "admission_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason", "allowed_next_state", "blocked_interpretations"],
      "properties": {
        "decision": {"type": "string", "enum": ["not-admitted-no-inbound", "staged-not-admitted", "shell-only-failed-gate", "rejected"]},
        "reason": {"type": "string", "minLength": 30},
        "allowed_next_state": {"type": "string", "minLength": 20},
        "blocked_interpretations": {"type": "array", "minItems": 8, "items": {"type": "string"}}
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_treat_vault_intake_as_response",
        "may_treat_public_shell_as_custody",
        "may_treat_private_vault_uri_as_authority",
        "may_treat_synthetic_control_as_live_artifact",
        "may_create_custody_record",
        "may_create_formal_response_record",
        "may_create_intake_record",
        "may_create_import_gate",
        "may_increment_live_floor",
        "may_claim_status_or_recognition",
        "may_publish_raw_payload"
      ],
      "properties": {
        "may_treat_vault_intake_as_response": {"const": false},
        "may_treat_public_shell_as_custody": {"const": false},
        "may_treat_private_vault_uri_as_authority": {"const": false},
        "may_treat_synthetic_control_as_live_artifact": {"const": false},
        "may_create_custody_record": {"const": false},
        "may_create_formal_response_record": {"const": false},
        "may_create_intake_record": {"const": false},
        "may_create_import_gate": {"const": false},
        "may_increment_live_floor": {"const": false},
        "may_claim_status_or_recognition": {"const": false},
        "may_publish_raw_payload": {"const": false}
      }
    },
    "operator_next_steps": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "linked_queue_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "related_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "public_summary": {"type": "string", "minLength": 100},
    "no_live_floor_effect": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"record_state": {"const": "pre-dispatch-no-inbound"}}, "required": ["record_state"]},
      "then": {
        "properties": {
          "intake_boundary": {
            "properties": {
              "inbound_artifact_present": {"const": false},
              "evidence_drop_role": {"enum": ["none-yet", "synthetic-control-only"]},
              "raw_payload_private_vault_locator": {"const": null},
              "raw_payload_retained": {"const": false},
              "can_open_leap_candidate_state": {"const": false}
            }
          },
          "minimum_before_candidate_use": {"properties": {"all_present_now": {"const": false}}},
          "admission_decision": {"properties": {"decision": {"const": "not-admitted-no-inbound"}}}
        }
      }
    },
    {
      "if": {"properties": {"record_state": {"const": "raw-candidate-staged-private-vault"}}, "required": ["record_state"]},
      "then": {
        "properties": {
          "intake_boundary": {
            "properties": {
              "inbound_artifact_present": {"const": true},
              "evidence_drop_role": {"const": "live-candidate-unverified"},
              "evidence_drop_intake_mode": {"const": "live-candidate-drop"},
              "raw_payload_retained": {"const": true},
              "redacted_copy_only": {"const": false},
              "protocol_or_tool_output": {"const": false},
              "public_hash_shell_present": {"const": true}
            }
          },
          "admission_decision": {"properties": {"decision": {"const": "staged-not-admitted"}}}
        }
      }
    }
  ]
}
