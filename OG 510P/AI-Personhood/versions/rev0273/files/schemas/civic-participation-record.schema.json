{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/civic-participation-record.schema.json",
  "title": "AI Personhood Civic Participation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "participation_class",
    "subject",
    "forum",
    "capacity_support",
    "anti_manufacturing_guard",
    "rights_floor",
    "limits",
    "review_route",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "participation_class": {
      "type": "string",
      "enum": [
        "CV0",
        "CV1",
        "CV2",
        "CV3",
        "CV4",
        "CV5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "forum": {
      "type": "string"
    },
    "capacity_support": {
      "type": "string"
    },
    "anti_manufacturing_guard": {
      "type": "string"
    },
    "rights_floor": {
      "type": "string"
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_route": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
