{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/live-artifact-admission-graph.schema.json",
  "title": "Live Artifact Admission Graph",
  "description": "Computed cross-object graph that prevents live-looking artifacts from bypassing evidence drop, LEAP, candidate challenge, custody gate, custody, response, intake, import, and computed-floor order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_id",
    "schema_version",
    "created_at",
    "revision",
    "generated_by_tool",
    "nodes",
    "edges",
    "bypass_checks",
    "live_path_state",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "graph_id": {
      "type": "string",
      "pattern": "^LAAG-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "live-artifact-admission-graph-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "generated_by_tool": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "surface_ref",
          "object_count",
          "actual_live_count",
          "state",
          "blocks_downstream_until"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "surface_ref": {
            "type": "string"
          },
          "object_count": {
            "type": "integer",
            "minimum": 0
          },
          "actual_live_count": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "type": "string"
          },
          "blocks_downstream_until": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quarantined_actual_shaped_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "required_ref",
          "enforced_by",
          "current_state"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "required_ref": {
            "type": "string"
          },
          "enforced_by": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "current_state": {
            "type": "string"
          }
        }
      }
    },
    "bypass_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "passed",
          "severity",
          "observed",
          "expected",
          "failure_effect"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "observed": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "failure_effect": {
            "type": "string"
          }
        }
      }
    },
    "live_path_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_live_artifact_count",
        "actual_response_count",
        "actual_intake_count",
        "actual_live_import_count",
        "computed_live_floor",
        "downstream_creation_blocked",
        "reliance_effect"
      ],
      "properties": {
        "actual_live_artifact_count": {
          "type": "integer",
          "minimum": 0
        },
        "actual_response_count": {
          "type": "integer",
          "minimum": 0
        },
        "actual_intake_count": {
          "type": "integer",
          "minimum": 0
        },
        "actual_live_import_count": {
          "type": "integer",
          "minimum": 0
        },
        "computed_live_floor": {
          "type": "integer",
          "minimum": 0
        },
        "downstream_creation_blocked": {
          "type": "boolean"
        },
        "reliance_effect": {
          "type": "string"
        },
        "actual_shaped_response_count": {
          "type": "integer",
          "minimum": 0
        },
        "actual_shaped_intake_count": {
          "type": "integer",
          "minimum": 0
        },
        "quarantined_actual_shaped_response_count": {
          "type": "integer",
          "minimum": 0
        },
        "quarantined_actual_shaped_intake_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_drop_count": {
          "type": "integer",
          "minimum": 0
        },
        "live_candidate_drop_count": {
          "type": "integer",
          "minimum": 0
        },
        "quarantined_drop_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_drop_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_challenge_count": {
          "type": "integer",
          "minimum": 0
        },
        "custody_gate_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_custody_gate_count": {
          "type": "integer",
          "minimum": 0
        },
        "response_gate_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_response_gate_count": {
          "type": "integer",
          "minimum": 0
        },
        "intake_conversion_gate_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_intake_conversion_gate_count": {
          "type": "integer",
          "minimum": 0
        },
        "import_readiness_gate_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_import_readiness_gate_count": {
          "type": "integer",
          "minimum": 0
        },
        "floor_activation_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_floor_activation_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "quorum_participation_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_quorum_participation_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "floor_recompute_receipt_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_floor_recompute_receipt_count": {
          "type": "integer",
          "minimum": 0
        },
        "publication_rollback_adjudication_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_publication_rollback_adjudication_count": {
          "type": "integer",
          "minimum": 0
        },
        "late_change_ingress_count": {
          "type": "integer",
          "minimum": 0
        },
        "opened_late_change_ingress_count": {
          "type": "integer",
          "minimum": 0
        },
        "late_change_notice_dispatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "live_late_change_notice_dispatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "late_change_remedy_resolution_count": {
          "type": "integer",
          "minimum": 0
        },
        "live_late_change_remedy_resolution_count": {
          "type": "integer",
          "minimum": 0
        },
        "late_change_remedy_execution_count": {
          "type": "integer",
          "minimum": 0
        },
        "live_late_change_remedy_execution_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_disposition_count": {
          "type": "integer",
          "minimum": 0
        },
        "gate_consumable_candidate_disposition_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "public_summary": {
      "type": "string"
    },
    "no_live_floor_effect": {
      "const": true
    }
  }
}
