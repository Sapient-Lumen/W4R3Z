{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/live-artifact-import-fieldkit.schema.json",
  "title": "Live Artifact Import Fieldkit",
  "description": "Operator fieldkit for the first live counterparty artifact; readiness does not admit evidence or change the computed live receipt floor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fieldkit_id",
    "schema_version",
    "created_at",
    "revision",
    "fieldkit_state",
    "current_computed_floor_ref",
    "linked_live_drill_packet",
    "raw_artifact_slots",
    "admission_sequence",
    "no_go_conditions",
    "allowed_next_records",
    "public_summary_requirements",
    "reliance_limits"
  ],
  "properties": {
    "fieldkit_id": {
      "type": "string",
      "pattern": "^LAIF-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "live-artifact-import-fieldkit-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "fieldkit_state": {
      "type": "string",
      "enum": [
        "ready-no-live-artifact",
        "artifact-quarantined",
        "artifact-admitted",
        "artifact-rejected",
        "superseded"
      ]
    },
    "current_computed_floor_ref": {
      "type": "string"
    },
    "linked_live_drill_packet": {
      "type": "string"
    },
    "raw_artifact_slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "requirement",
          "minimum_evidence",
          "must_be_external_or_independent",
          "sealed_handling",
          "blocks_if_missing",
          "blocks_if_failed"
        ],
        "properties": {
          "slot_id": {
            "type": "string"
          },
          "requirement": {
            "type": "string"
          },
          "minimum_evidence": {
            "type": "string"
          },
          "must_be_external_or_independent": {
            "type": "boolean"
          },
          "sealed_handling": {
            "type": "string",
            "enum": [
              "public",
              "sealed-raw-public-shell",
              "sealed",
              "not-applicable",
              "public-shell-sealed-details"
            ]
          },
          "blocks_if_missing": {
            "type": "boolean"
          },
          "blocks_if_failed": {
            "type": "boolean"
          },
          "example_acceptance_note": {
            "type": "string"
          }
        }
      }
    },
    "admission_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "creates_or_updates",
          "required_inputs",
          "no_live_weight_until",
          "blocked_overclaim"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "creates_or_updates": {
            "type": "string"
          },
          "required_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "no_live_weight_until": {
            "type": "string"
          },
          "blocked_overclaim": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "no_go_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "allowed_next_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "public_summary_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reliance_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldkit_is_receipt",
        "may_start_no_response_clock",
        "may_create_response_record",
        "may_increase_live_floor",
        "may_satisfy_cross_critical_quorum"
      ],
      "properties": {
        "fieldkit_is_receipt": {
          "type": "boolean"
        },
        "may_start_no_response_clock": {
          "type": "boolean"
        },
        "may_create_response_record": {
          "type": "boolean"
        },
        "may_increase_live_floor": {
          "type": "boolean"
        },
        "may_satisfy_cross_critical_quorum": {
          "type": "boolean"
        }
      }
    }
  }
}
