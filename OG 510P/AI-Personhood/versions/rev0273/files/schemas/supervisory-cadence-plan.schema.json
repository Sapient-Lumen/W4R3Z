{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/supervisory-cadence-plan.schema.json",
  "title": "AI Personhood Supervisory Cadence Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "version",
    "subject_or_cohort",
    "operation",
    "cadence_class",
    "review_owner",
    "deputy_owner",
    "review_interval",
    "accelerated_triggers",
    "market_capture_metrics",
    "conflict_disclosures",
    "missed_review_effects",
    "subject_access",
    "next_review_at",
    "public_summary"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "subject_or_cohort": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "cadence_class": {
      "type": "string",
      "enum": [
        "SC0",
        "SC1",
        "SC2",
        "SC3",
        "SC4",
        "SC5"
      ]
    },
    "review_owner": {
      "type": "string"
    },
    "deputy_owner": {
      "type": "string"
    },
    "review_interval": {
      "type": "string"
    },
    "accelerated_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "market_capture_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "conflict_disclosures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missed_review_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "subject_access": {
      "type": "string"
    },
    "next_review_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
