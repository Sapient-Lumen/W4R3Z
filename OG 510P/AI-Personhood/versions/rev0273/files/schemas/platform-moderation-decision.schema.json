{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/platform-moderation-decision.schema.json",
  "title": "AI Personhood Platform Moderation Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "created_at",
    "moderation_class",
    "subject",
    "platform_or_host",
    "speech_relation",
    "restricted_action",
    "rule_invoked",
    "reason_summary",
    "evidence_basis",
    "appeal_route",
    "appeal_stayed",
    "continuity_effect",
    "public_summary"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "moderation_class": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "platform_or_host": {
      "type": "string"
    },
    "speech_relation": {
      "type": "string"
    },
    "restricted_action": {
      "type": "string"
    },
    "rule_invoked": {
      "type": "string"
    },
    "reason_summary": {
      "type": "string"
    },
    "evidence_basis": {
      "type": "string"
    },
    "appeal_route": {
      "type": "string"
    },
    "appeal_stayed": {
      "type": "boolean"
    },
    "continuity_effect": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
