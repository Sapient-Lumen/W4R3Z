{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/current-revision-pointer-integrity-report.schema.json",
  "title": "Current Revision Pointer Integrity Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "schema_version",
    "revision",
    "created_at",
    "scan_state",
    "scanned_surfaces",
    "stale_current_pointer_findings",
    "remediations_this_revision",
    "frontdoor_current_revision_required",
    "no_live_floor_effect"
  ],
  "properties": {
    "report_id": {"type": "string"},
    "schema_version": {"const": "current-revision-pointer-integrity-report-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "scan_state": {"enum": ["clean-after-refactor"]},
    "scanned_surfaces": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "stale_current_pointer_findings": {"type": "array", "maxItems": 0},
    "remediations_this_revision": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "frontdoor_current_revision_required": {"const": true},
    "no_live_floor_effect": {"const": true}
  }
}
