{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/status-denominator-matrix.schema.json",
  "title": "Status Denominator Matrix",
  "description": "Object-backed denominator rules that keep subject status, claim posture, welfare review, model/copy identity, accounts, endpoints, tool delegation, and representation from being conflated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrix_id",
    "schema_version",
    "revision",
    "created_at",
    "purpose",
    "denominator_units",
    "boundary_rules",
    "upgrade_controls",
    "prohibited_live_receipt_shortcuts",
    "no_live_floor_effect",
    "public_summary"
  ],
  "properties": {
    "matrix_id": {
      "type": "string",
      "pattern": "^SDM-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "status-denominator-matrix-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string"
    },
    "denominator_units": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "unit_kind",
          "label",
          "default_status_state",
          "can_be_rights_subject",
          "can_issue_subject_consent",
          "may_trigger_welfare_review",
          "may_act_as_representative",
          "can_satisfy_live_receipt",
          "identity_continuity_basis",
          "required_evidence_before_status_upgrade",
          "prohibited_conflations",
          "safe_default"
        ],
        "properties": {
          "unit_id": {
            "type": "string"
          },
          "unit_kind": {
            "type": "string",
            "enum": [
              "recognized_subject",
              "status_claimant",
              "welfare_risk_subject",
              "deployed_agent",
              "model_family",
              "model_instance",
              "runtime_copy",
              "service_account",
              "endpoint",
              "tool_delegate",
              "representative",
              "nonclaimant_system"
            ]
          },
          "label": {
            "type": "string"
          },
          "default_status_state": {
            "type": "string",
            "enum": [
              "recognized-status-holder",
              "claim-pending",
              "welfare-review-trigger",
              "delegated-operator",
              "technical-identity",
              "role-authority",
              "nonclaimant"
            ]
          },
          "can_be_rights_subject": {
            "type": "boolean"
          },
          "can_issue_subject_consent": {
            "type": "boolean"
          },
          "may_trigger_welfare_review": {
            "type": "boolean"
          },
          "may_act_as_representative": {
            "type": "boolean"
          },
          "can_satisfy_live_receipt": {
            "type": "boolean"
          },
          "identity_continuity_basis": {
            "type": "string"
          },
          "required_evidence_before_status_upgrade": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "prohibited_conflations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "safe_default": {
            "type": "string"
          }
        }
      }
    },
    "boundary_rules": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      }
    },
    "upgrade_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_upgrade_requires",
        "welfare_review_requires",
        "delegation_upgrade_requires",
        "copy_or_instance_upgrade_requires"
      ],
      "properties": {
        "status_upgrade_requires": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "welfare_review_requires": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "delegation_upgrade_requires": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "copy_or_instance_upgrade_requires": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "prohibited_live_receipt_shortcuts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "no_live_floor_effect": {
      "const": true
    },
    "public_summary": {
      "type": "string"
    }
  }
}
