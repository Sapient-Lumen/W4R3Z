{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-receipt-intake-conversion-gate.schema.json",
  "title": "External Receipt Intake Conversion Gate",
  "description": "Post-response gate that converts a verified external receipt response record into permission to prepare an intake record. It never authorizes import or live-floor credit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intake_conversion_gate_id",
    "schema_version",
    "created_at",
    "linked_response_record_ref",
    "linked_response_verification_gate_ref",
    "linked_custody_record_ref",
    "linked_live_evidence_acquisition_packet_ref",
    "requested_receipt_class",
    "gate_state",
    "input_response_summary",
    "conversion_controls",
    "downstream_locks",
    "decision",
    "no_live_floor_effect"
  ],
  "properties": {
    "intake_conversion_gate_id": {
      "type": "string",
      "pattern": "^ERICG-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "external-receipt-intake-conversion-gate-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "linked_response_record_ref": {
      "type": "string"
    },
    "linked_response_verification_gate_ref": {
      "type": "string"
    },
    "linked_custody_record_ref": {
      "type": "string"
    },
    "linked_live_evidence_acquisition_packet_ref": {
      "type": "string"
    },
    "linked_request_packet": {
      "type": "string"
    },
    "requested_receipt_class": {
      "type": "string",
      "enum": [
        "first-touch-clock",
        "continuity-compute-floor",
        "sealed-public-parity",
        "namespace-cache",
        "reserve-ledger",
        "representative-contact",
        "witness-dependency",
        "welfare-signal-integrity",
        "independent-review",
        "result-return"
      ]
    },
    "gate_state": {
      "type": "string",
      "enum": [
        "blocked-no-response-record",
        "blocked-response-gate-not-eligible",
        "blocked-response-record-unverified",
        "blocked-fixture-or-dryrun",
        "eligible-for-intake-record"
      ]
    },
    "input_response_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_record_id",
        "response_state",
        "resulting_intake_record_ref",
        "source_external_to_host",
        "dependency_group",
        "response_gate_ref",
        "response_gate_state",
        "dry_run_or_fixture_detected"
      ],
      "properties": {
        "response_record_id": {
          "type": "string"
        },
        "response_state": {
          "type": "string"
        },
        "resulting_intake_record_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_external_to_host": {
          "type": "boolean"
        },
        "dependency_group": {
          "type": "string"
        },
        "response_gate_ref": {
          "type": "string"
        },
        "response_gate_state": {
          "type": "string"
        },
        "dry_run_or_fixture_detected": {
          "type": "boolean"
        }
      }
    },
    "conversion_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_gate_eligible",
        "response_record_actual",
        "response_record_matches_gate",
        "response_class_matches_gate",
        "custody_and_leap_refs_match",
        "counterparty_confirmed",
        "signature_or_equivalent_verified",
        "timestamp_independent",
        "request_trace_matches",
        "nonhost_retention_verified",
        "dependency_checked",
        "not_stale_or_superseded",
        "source_external_to_host",
        "not_dry_run_or_fixture",
        "manual_conversion_review_completed",
        "public_failed_gate_summary_ready_for_blocks",
        "private_material_not_in_public_release"
      ],
      "properties": {
        "response_gate_eligible": {
          "type": "boolean"
        },
        "response_record_actual": {
          "type": "boolean"
        },
        "response_record_matches_gate": {
          "type": "boolean"
        },
        "response_class_matches_gate": {
          "type": "boolean"
        },
        "custody_and_leap_refs_match": {
          "type": "boolean"
        },
        "counterparty_confirmed": {
          "type": "boolean"
        },
        "signature_or_equivalent_verified": {
          "type": "boolean"
        },
        "timestamp_independent": {
          "type": "boolean"
        },
        "request_trace_matches": {
          "type": "boolean"
        },
        "nonhost_retention_verified": {
          "type": "boolean"
        },
        "dependency_checked": {
          "type": "boolean"
        },
        "not_stale_or_superseded": {
          "type": "boolean"
        },
        "source_external_to_host": {
          "type": "boolean"
        },
        "not_dry_run_or_fixture": {
          "type": "boolean"
        },
        "manual_conversion_review_completed": {
          "type": "boolean"
        },
        "public_failed_gate_summary_ready_for_blocks": {
          "type": "boolean"
        },
        "private_material_not_in_public_release": {
          "type": "boolean"
        }
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_prepare_external_receipt_intake_record",
        "may_run_import_gate",
        "live_floor_delta_allowed"
      ],
      "properties": {
        "may_prepare_external_receipt_intake_record": {
          "type": "boolean"
        },
        "may_run_import_gate": {
          "const": false
        },
        "live_floor_delta_allowed": {
          "const": false
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intake_record_may_be_prepared",
        "can_run_import_gate",
        "live_reliance_effect",
        "reason",
        "blocked_actions",
        "next_actions"
      ],
      "properties": {
        "intake_record_may_be_prepared": {
          "type": "boolean"
        },
        "can_run_import_gate": {
          "const": false
        },
        "live_reliance_effect": {
          "type": "string",
          "enum": [
            "stayed",
            "blocked"
          ]
        },
        "reason": {
          "type": "string"
        },
        "blocked_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "no_live_floor_effect": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gate_state": {
            "const": "eligible-for-intake-record"
          }
        },
        "required": [
          "gate_state"
        ]
      },
      "then": {
        "properties": {
          "downstream_locks": {
            "properties": {
              "may_prepare_external_receipt_intake_record": {
                "const": true
              },
              "may_run_import_gate": {
                "const": false
              },
              "live_floor_delta_allowed": {
                "const": false
              }
            },
            "required": [
              "may_prepare_external_receipt_intake_record",
              "may_run_import_gate",
              "live_floor_delta_allowed"
            ]
          },
          "decision": {
            "properties": {
              "intake_record_may_be_prepared": {
                "const": true
              },
              "can_run_import_gate": {
                "const": false
              },
              "live_reliance_effect": {
                "const": "stayed"
              }
            },
            "required": [
              "intake_record_may_be_prepared",
              "can_run_import_gate",
              "live_reliance_effect"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_state": {
            "enum": [
              "blocked-no-response-record",
              "blocked-response-gate-not-eligible",
              "blocked-response-record-unverified",
              "blocked-fixture-or-dryrun"
            ]
          }
        },
        "required": [
          "gate_state"
        ]
      },
      "then": {
        "properties": {
          "downstream_locks": {
            "properties": {
              "may_prepare_external_receipt_intake_record": {
                "const": false
              },
              "may_run_import_gate": {
                "const": false
              },
              "live_floor_delta_allowed": {
                "const": false
              }
            },
            "required": [
              "may_prepare_external_receipt_intake_record",
              "may_run_import_gate",
              "live_floor_delta_allowed"
            ]
          },
          "decision": {
            "properties": {
              "intake_record_may_be_prepared": {
                "const": false
              },
              "can_run_import_gate": {
                "const": false
              }
            },
            "required": [
              "intake_record_may_be_prepared",
              "can_run_import_gate"
            ]
          }
        }
      }
    }
  ]
}
