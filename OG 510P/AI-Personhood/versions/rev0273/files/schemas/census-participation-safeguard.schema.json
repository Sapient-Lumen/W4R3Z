{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/census-participation-safeguard.schema.json",
  "title": "AI Personhood Census Participation Safeguard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "census_class",
    "subject_or_cohort",
    "count_unit",
    "purpose",
    "manufactured_count_guard",
    "apportionment_effect",
    "aggregation_privacy",
    "review_authority",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "census_class": {
      "type": "string",
      "enum": [
        "CN0",
        "CN1",
        "CN2",
        "CN3",
        "CN4",
        "CN5"
      ]
    },
    "subject_or_cohort": {
      "type": "string"
    },
    "count_unit": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "manufactured_count_guard": {
      "type": "string"
    },
    "apportionment_effect": {
      "type": "string",
      "enum": [
        "none",
        "service-planning-only",
        "rights-monitoring-only",
        "domicile-planning",
        "apportionment-sensitive",
        "prohibited"
      ]
    },
    "aggregation_privacy": {
      "type": "string"
    },
    "review_authority": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
