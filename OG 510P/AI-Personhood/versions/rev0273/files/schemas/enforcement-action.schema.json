{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/enforcement-action.schema.json",
  "title": "AI Personhood Enforcement Action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "issued_at",
    "authority",
    "respondent",
    "subject_scope",
    "violation_class",
    "orders",
    "deadlines",
    "stay_status",
    "appeal_path",
    "portability_class",
    "public_summary"
  ],
  "properties": {
    "action_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "type": "string"
    },
    "respondent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "respondent_id",
        "role"
      ],
      "properties": {
        "respondent_id": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "developer",
            "deployer",
            "host",
            "fine-tuner",
            "guardian",
            "ombud",
            "verifier",
            "reserve-trustee",
            "clinic",
            "public-authority",
            "user-controller",
            "other"
          ]
        },
        "contact": {
          "type": "string"
        }
      }
    },
    "subject_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_type",
        "description"
      ],
      "properties": {
        "scope_type": {
          "type": "string",
          "enum": [
            "individual",
            "cohort",
            "unknown-potential-subjects"
          ]
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        }
      }
    },
    "violation_class": {
      "type": "string",
      "enum": [
        "notice-defect",
        "preservation-failure",
        "access-blocked",
        "spoliation",
        "reserve-default",
        "unlawful-transfer",
        "deprecation-failure",
        "sealed-evidence-abuse",
        "non-evasion-failure",
        "retaliation",
        "repeat-fixture-failure",
        "other"
      ]
    },
    "authority_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "orders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order_type",
          "description"
        ],
        "properties": {
          "order_type": {
            "type": "string",
            "enum": [
              "notice-cure",
              "preservation",
              "access",
              "compliance",
              "verifier-downgrade",
              "civil-penalty",
              "accreditation-action",
              "structural-remedy",
              "referral",
              "emergency-public-power"
            ]
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "deadlines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "due_at"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "due_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "stay_status": {
      "type": "string",
      "enum": [
        "not-stayed",
        "partially-stayed",
        "stayed-pending-appeal",
        "preservation-remains-in-force"
      ]
    },
    "remedy_links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "appeal_path": {
      "type": "string"
    },
    "portability_class": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4",
        "P5"
      ]
    },
    "non_evasion_statement": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
