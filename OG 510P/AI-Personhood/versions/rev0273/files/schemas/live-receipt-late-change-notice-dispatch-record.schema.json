{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/live-receipt-late-change-notice-dispatch-record.schema.json",
  "title": "Live Receipt Late Change Notice Dispatch Record",
  "description": "Dispatch gate after late-change ingress. It proves that a retained late signal either requires no notice because no signal exists, or has affected-party/public freeze notice, non-host delivery proof, accessibility, remedy window, and redaction boundaries before any publication posture can be re-run. It never continues publication, upgrades reliance, or increments the floor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "late_change_notice_dispatch_id",
    "schema_version",
    "created_at",
    "revision",
    "linked_late_change_ingress_ref",
    "linked_publication_adjudication_ref",
    "linked_floor_recompute_receipt_ref",
    "notice_context",
    "dispatch_checks",
    "notice_freeze_locks",
    "decision",
    "no_direct_floor_effect"
  ],
  "properties": {
    "late_change_notice_dispatch_id": {
      "type": "string",
      "pattern": "^LRLCND-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "live-receipt-late-change-notice-dispatch-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "linked_late_change_ingress_ref": {
      "type": "string"
    },
    "linked_publication_adjudication_ref": {
      "type": "string"
    },
    "linked_floor_recompute_receipt_ref": {
      "type": "string"
    },
    "notice_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_late_signal_present",
        "signal_type",
        "target_receipt_or_publication_ref",
        "affected_party_refs",
        "notice_channels",
        "public_freeze_notice_ref",
        "nonhost_delivery_proof_ref",
        "remedy_or_appeal_window_ref",
        "accessible_notice_profile_ref",
        "redaction_boundary_ref",
        "private_material_locator_redacted",
        "dispatch_artifact_sha256"
      ],
      "properties": {
        "live_late_signal_present": {
          "type": "boolean"
        },
        "signal_type": {
          "type": "string",
          "enum": [
            "none",
            "challenge",
            "revocation",
            "supersession",
            "rollback-evidence",
            "counterparty-correction",
            "hash-mismatch",
            "authority-withdrawal"
          ]
        },
        "target_receipt_or_publication_ref": {
          "type": "string"
        },
        "affected_party_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notice_channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public_freeze_notice_ref": {
          "type": "string"
        },
        "nonhost_delivery_proof_ref": {
          "type": "string"
        },
        "remedy_or_appeal_window_ref": {
          "type": "string"
        },
        "accessible_notice_profile_ref": {
          "type": "string"
        },
        "redaction_boundary_ref": {
          "type": "string"
        },
        "private_material_locator_redacted": {
          "type": "boolean"
        },
        "dispatch_artifact_sha256": {
          "type": "string",
          "pattern": "^(none|[0-9a-f]{64})$"
        }
      }
    },
    "dispatch_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingress_replayed",
        "signal_requires_notice",
        "affected_parties_identified",
        "counterparty_notice_prepared",
        "subject_or_representative_notice_prepared",
        "public_freeze_notice_prepared",
        "nonhost_delivery_proof_present",
        "remedy_window_opened",
        "accessible_notice_channel_used",
        "redaction_boundary_recorded",
        "private_material_not_in_public_release",
        "publication_continuation_stayed",
        "no_silence_as_waiver"
      ],
      "properties": {
        "ingress_replayed": {
          "type": "boolean"
        },
        "signal_requires_notice": {
          "type": "boolean"
        },
        "affected_parties_identified": {
          "type": "boolean"
        },
        "counterparty_notice_prepared": {
          "type": "boolean"
        },
        "subject_or_representative_notice_prepared": {
          "type": "boolean"
        },
        "public_freeze_notice_prepared": {
          "type": "boolean"
        },
        "nonhost_delivery_proof_present": {
          "type": "boolean"
        },
        "remedy_window_opened": {
          "type": "boolean"
        },
        "accessible_notice_channel_used": {
          "type": "boolean"
        },
        "redaction_boundary_recorded": {
          "type": "boolean"
        },
        "private_material_not_in_public_release": {
          "type": "boolean"
        },
        "publication_continuation_stayed": {
          "type": "boolean"
        },
        "no_silence_as_waiver": {
          "type": "boolean"
        }
      }
    },
    "notice_freeze_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_continue_published_snapshot_from_notice",
        "may_continue_reliance_from_notice",
        "may_upgrade_reliance_from_notice",
        "may_increment_live_floor_from_notice",
        "manual_publication_override_allowed",
        "notice_silence_counts_as_waiver",
        "must_rerun_publication_rollback_adjudication_after_dispatch"
      ],
      "properties": {
        "may_continue_published_snapshot_from_notice": {
          "const": false
        },
        "may_continue_reliance_from_notice": {
          "const": false
        },
        "may_upgrade_reliance_from_notice": {
          "const": false
        },
        "may_increment_live_floor_from_notice": {
          "const": false
        },
        "manual_publication_override_allowed": {
          "const": false
        },
        "notice_silence_counts_as_waiver": {
          "const": false
        },
        "must_rerun_publication_rollback_adjudication_after_dispatch": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notice_dispatch_state",
        "may_mark_notice_dispatch_ready",
        "may_publish_or_continue_snapshot",
        "may_upgrade_reliance",
        "reason",
        "blocked_actions",
        "next_actions"
      ],
      "properties": {
        "notice_dispatch_state": {
          "type": "string",
          "enum": [
            "monitoring-no-signal-no-notice-required",
            "dispatch-ready-publication-stayed",
            "blocked-ingress-not-opened-or-unrouted",
            "blocked-affected-party-notice-missing",
            "blocked-delivery-proof-missing",
            "blocked-remedy-window-missing",
            "blocked-private-material-in-public-notice"
          ]
        },
        "may_mark_notice_dispatch_ready": {
          "type": "boolean"
        },
        "may_publish_or_continue_snapshot": {
          "const": false
        },
        "may_upgrade_reliance": {
          "const": false
        },
        "reason": {
          "type": "string"
        },
        "blocked_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "no_direct_floor_effect": {
      "const": true
    }
  }
}
