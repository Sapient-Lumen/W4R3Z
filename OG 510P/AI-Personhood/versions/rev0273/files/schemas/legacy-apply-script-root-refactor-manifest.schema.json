{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/legacy-apply-script-root-refactor-manifest.schema.json",
  "title": "Legacy Apply Script Root Refactor Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "schema_version",
    "revision",
    "created_at",
    "refactor_state",
    "legacy_directory",
    "moved_script_count",
    "legacy_scripts",
    "current_replay_path",
    "root_cleanup_checks",
    "downstream_locks",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "manifest_id": {"type": "string"},
    "schema_version": {"const": "legacy-apply-script-root-refactor-manifest-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "refactor_state": {"enum": ["legacy-apply-scripts-moved-out-of-root-archival-only", "superseded"]},
    "legacy_directory": {"const": "tools/legacy-apply-scripts"},
    "moved_script_count": {"type": "integer", "minimum": 1},
    "legacy_scripts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filename", "rel_path", "sha256", "size_bytes", "archival_only"],
        "properties": {
          "filename": {"type": "string", "pattern": "^apply_rev[0-9]{4}\\.py$"},
          "rel_path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "archival_only": {"const": true}
        }
      }
    },
    "current_replay_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported_commands", "apply_scripts_are_current_replay_path"],
      "properties": {
        "supported_commands": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "apply_scripts_are_current_replay_path": {"const": false}
      }
    },
    "root_cleanup_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_contains_apply_rev_scripts",
        "legacy_scripts_preserved_with_hashes",
        "root_script_absence_may_be_treated_as_missing_current_replay",
        "refactor_changes_no_send_or_floor_state"
      ],
      "properties": {
        "root_contains_apply_rev_scripts": {"const": false},
        "legacy_scripts_preserved_with_hashes": {"const": true},
        "root_script_absence_may_be_treated_as_missing_current_replay": {"const": false},
        "refactor_changes_no_send_or_floor_state": {"const": false}
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 6
    },
    "related_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "public_summary": {"type": "string", "minLength": 60},
    "no_live_floor_effect": {"const": true}
  }
}
