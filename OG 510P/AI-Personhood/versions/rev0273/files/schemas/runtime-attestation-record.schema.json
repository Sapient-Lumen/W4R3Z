{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/runtime-attestation-record.schema.json",
  "title": "AI Personhood Runtime Attestation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_id",
    "measured_at",
    "attestation_class",
    "subject_or_system",
    "claims",
    "evidence_boundary",
    "verifier",
    "freshness_window",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "attestation_id": {
      "type": "string"
    },
    "measured_at": {
      "type": "string",
      "format": "date-time"
    },
    "attestation_class": {
      "type": "string",
      "enum": [
        "RA0",
        "RA1",
        "RA2",
        "RA3",
        "RA4"
      ]
    },
    "subject_or_system": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "status",
          "evidence_ref"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "proved",
              "not-proved",
              "sealed",
              "stale",
              "exception"
            ]
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      }
    },
    "evidence_boundary": {
      "type": "string"
    },
    "verifier": {
      "type": "string"
    },
    "freshness_window": {
      "type": "string"
    },
    "staleness_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "downgraded",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
