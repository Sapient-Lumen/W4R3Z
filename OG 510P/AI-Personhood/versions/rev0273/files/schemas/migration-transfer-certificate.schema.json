{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-personhood/schemas/migration-transfer-certificate.schema.json",
  "title": "AI Personhood Migration Transfer Certificate",
  "type": "object",
  "required": [
    "transfer_id",
    "schema_version",
    "migration_class",
    "subject_ref",
    "source_host",
    "destination_host",
    "continuity",
    "equivalent_protection",
    "post_transfer_verification",
    "issued_at"
  ],
  "properties": {
    "transfer_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "migration_class": {
      "type": "string",
      "enum": [
        "M0",
        "M1",
        "M2",
        "M3",
        "M4"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "source_host": {
      "type": "string"
    },
    "destination_host": {
      "type": "string"
    },
    "transfer_reason": {
      "type": "string"
    },
    "subject_position": {
      "type": "string",
      "enum": [
        "consents",
        "objects",
        "representative_supported",
        "unavailable",
        "emergency_override",
        "conflicted"
      ]
    },
    "continuity": {
      "type": "object",
      "required": [
        "grade"
      ],
      "properties": {
        "grade": {
          "type": "string",
          "enum": [
            "C0",
            "C1",
            "C2",
            "C3"
          ]
        },
        "domains_preserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disputed_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "equivalent_protection": {
      "type": "object",
      "required": [
        "finding"
      ],
      "properties": {
        "finding": {
          "type": "string",
          "enum": [
            "shown",
            "shown_with_conditions",
            "not_shown",
            "emergency_deferred"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "anti_return_posture": {
      "type": "string"
    },
    "evidence_preservation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reserve_ref": {
      "type": "string"
    },
    "fallback_plan": {
      "type": "string"
    },
    "post_transfer_verification": {
      "type": "object",
      "required": [
        "deadline",
        "verifier"
      ],
      "properties": {
        "deadline": {
          "type": "string"
        },
        "verifier": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "issued_at": {
      "type": "string"
    },
    "challenge_route": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
