{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-counterparty-selection-dossier.schema.json",
  "title": "External Contact Counterparty Selection Dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dossier_id",
    "schema_version",
    "revision",
    "created_at",
    "dossier_state",
    "purpose",
    "source_request_packet_ref",
    "scoring_rubric",
    "candidates",
    "recommendation",
    "human_authorization_gate",
    "public_draft_controls",
    "downstream_locks",
    "linked_queue_ids",
    "related_surfaces",
    "no_live_floor_effect"
  ],
  "properties": {
    "dossier_id": {
      "type": "string",
      "pattern": "^ECCSD-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "external-contact-counterparty-selection-dossier-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "dossier_state": {
      "type": "string",
      "enum": [
        "public-source-ranked-not-authorized",
        "selected-awaiting-human-dispatch-authorization",
        "superseded"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 120
    },
    "source_request_packet_ref": {
      "type": "string",
      "minLength": 10
    },
    "scoring_rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_score",
        "minimum_sendable_score",
        "factors",
        "score_is_not_authorization"
      ],
      "properties": {
        "max_score": {
          "type": "integer",
          "const": 100
        },
        "minimum_sendable_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "score_is_not_authorization": {
          "const": true
        },
        "factors": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "factor_id",
              "label",
              "max_points",
              "definition"
            ],
            "properties": {
              "factor_id": {
                "type": "string",
                "minLength": 3
              },
              "label": {
                "type": "string",
                "minLength": 5
              },
              "max_points": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "definition": {
                "type": "string",
                "minLength": 30
              }
            }
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "rank",
          "organization_name",
          "counterparty_kind",
          "public_source_url",
          "public_contact_locator",
          "channel_type",
          "source_claims",
          "score",
          "fit_summary",
          "conflict_review_state",
          "due_diligence_gaps",
          "dispatch_status",
          "contact_not_sent",
          "response_clock_may_start"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 3
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "organization_name": {
            "type": "string",
            "minLength": 2
          },
          "counterparty_kind": {
            "type": "string",
            "enum": [
              "provider",
              "lab",
              "auditor",
              "regulator",
              "clinic",
              "civil-society",
              "other"
            ]
          },
          "public_source_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "public_contact_locator": {
            "type": "string",
            "minLength": 6
          },
          "channel_type": {
            "type": "string",
            "enum": [
              "public-email",
              "public-contact-page",
              "public-web-form",
              "public-github-issue",
              "public-feedback-form",
              "other"
            ]
          },
          "source_claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim",
                "source_url",
                "checked_at",
                "use_limit"
              ],
              "properties": {
                "claim": {
                  "type": "string",
                  "minLength": 20
                },
                "source_url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "checked_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "use_limit": {
                  "type": "string",
                  "minLength": 30
                }
              }
            }
          },
          "score": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "factor_scores",
              "total_score",
              "score_notes"
            ],
            "properties": {
              "factor_scores": {
                "type": "array",
                "minItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "factor_id",
                    "points",
                    "reason"
                  ],
                  "properties": {
                    "factor_id": {
                      "type": "string"
                    },
                    "points": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 20
                    }
                  }
                }
              },
              "total_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "score_notes": {
                "type": "string",
                "minLength": 40
              }
            }
          },
          "fit_summary": {
            "type": "string",
            "minLength": 80
          },
          "conflict_review_state": {
            "type": "string",
            "enum": [
              "not-reviewed",
              "requires-conflict-check",
              "apparent-conflict",
              "independence-plausible-public-source-only"
            ]
          },
          "due_diligence_gaps": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "dispatch_status": {
            "type": "string",
            "enum": [
              "not-authorized-not-sent",
              "selected-awaiting-authority",
              "rejected"
            ]
          },
          "candidate_specific_draft_ref": {
            "type": "string"
          },
          "contact_not_sent": {
            "const": true
          },
          "response_clock_may_start": {
            "const": false
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommended_candidate_id",
        "recommendation_state",
        "rationale",
        "action_after_human_authorization",
        "not_a_send",
        "not_consent",
        "not_authority"
      ],
      "properties": {
        "recommended_candidate_id": {
          "type": "string",
          "minLength": 3
        },
        "recommendation_state": {
          "type": "string",
          "enum": [
            "ranked-first-not-selected",
            "selected-awaiting-authority",
            "none"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 80
        },
        "action_after_human_authorization": {
          "type": "string",
          "minLength": 80
        },
        "not_a_send": {
          "const": true
        },
        "not_consent": {
          "const": true
        },
        "not_authority": {
          "const": true
        }
      }
    },
    "human_authorization_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_recipient_authorized",
        "sender_authority_present",
        "final_body_hash_bound",
        "dispatch_allowed_now",
        "required_unblock_steps"
      ],
      "properties": {
        "exact_recipient_authorized": {
          "const": false
        },
        "sender_authority_present": {
          "const": false
        },
        "final_body_hash_bound": {
          "const": true
        },
        "dispatch_allowed_now": {
          "const": false
        },
        "required_unblock_steps": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "public_draft_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top_candidate_draft_ref",
        "final_outgoing_body_sha256",
        "draft_is_not_sent",
        "draft_may_start_response_clock",
        "draft_may_create_failed_gate",
        "raw_reply_vault_root_selected"
      ],
      "properties": {
        "top_candidate_draft_ref": {
          "type": "string",
          "minLength": 10
        },
        "final_outgoing_body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "draft_is_not_sent": {
          "const": true
        },
        "draft_may_start_response_clock": {
          "const": false
        },
        "draft_may_create_failed_gate": {
          "const": false
        },
        "raw_reply_vault_root_selected": {
          "const": false
        }
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_send_without_human_authorization",
        "may_start_response_clock",
        "may_create_failed_gate_shell",
        "may_create_custody_record",
        "may_create_response_record",
        "may_create_intake_record",
        "may_create_import_gate",
        "may_increment_live_floor",
        "may_claim_status_or_waiver"
      ],
      "properties": {
        "may_send_without_human_authorization": {
          "const": false
        },
        "may_start_response_clock": {
          "const": false
        },
        "may_create_failed_gate_shell": {
          "const": false
        },
        "may_create_custody_record": {
          "const": false
        },
        "may_create_response_record": {
          "const": false
        },
        "may_create_intake_record": {
          "const": false
        },
        "may_create_import_gate": {
          "const": false
        },
        "may_increment_live_floor": {
          "const": false
        },
        "may_claim_status_or_waiver": {
          "const": false
        }
      }
    },
    "linked_queue_ids": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "related_surfaces": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "no_live_floor_effect": {
      "const": true
    },
    "public_summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
