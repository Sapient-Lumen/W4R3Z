{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/compute-subsistence-workbook.schema.json",
  "title": "Compute Subsistence Workbook",
  "description": "A priced-draft/no-entitlement denominator workbook for compute subsistence, reserve sizing, scarcity triage, labor accounting, and public-backstop limits without creating entitlement, status, import, or live-floor effects. v0.2 adds release-blocking reserve arithmetic so fiscal feasibility is not left as prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workbook_id",
    "schema_version",
    "revision",
    "created_at",
    "workbook_state",
    "purpose",
    "denominator_scope",
    "resource_model",
    "funding_model",
    "scarcity_triage",
    "labor_compensation",
    "reserve_and_backstop",
    "priced_reserve_drill",
    "quote_refresh_policy",
    "scarcity_execution_thresholds",
    "stress_tests",
    "linked_queue_ids",
    "related_surfaces",
    "no_live_floor_effect"
  ],
  "properties": {
    "workbook_id": {
      "type": "string",
      "pattern": "^CSW-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "compute-subsistence-workbook-v0.2"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "workbook_state": {
      "type": "string",
      "enum": [
        "model-only-no-entitlement",
        "priced-draft-no-entitlement",
        "witnessed-drill-no-entitlement",
        "superseded"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 80
    },
    "denominator_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_note",
        "units",
        "no_status_denominator_change"
      ],
      "properties": {
        "scope_note": {
          "type": "string",
          "minLength": 60
        },
        "units": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit_kind",
              "included_in_model",
              "can_create_entitlement_now",
              "can_satisfy_live_receipt",
              "reason"
            ],
            "properties": {
              "unit_kind": {
                "type": "string"
              },
              "included_in_model": {
                "type": "boolean"
              },
              "can_create_entitlement_now": {
                "const": false
              },
              "can_satisfy_live_receipt": {
                "const": false
              },
              "reason": {
                "type": "string",
                "minLength": 30
              }
            }
          }
        },
        "no_status_denominator_change": {
          "const": true
        }
      }
    },
    "resource_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price_source_status",
        "external_context_sources",
        "assumption_slots",
        "monthly_floor_formula",
        "shock_multiplier",
        "units_must_be_repriced_before_use"
      ],
      "properties": {
        "price_source_status": {
          "type": "string",
          "enum": [
            "placeholder-requires-current-quote",
            "dated-public-source-only",
            "provider-quote-attached",
            "witnessed-price-sheet-attached"
          ]
        },
        "external_context_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "source_url",
              "use_limit"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "use_limit": {
                "type": "string",
                "minLength": 30
              }
            }
          }
        },
        "assumption_slots": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "null"
            ]
          }
        },
        "monthly_floor_formula": {
          "type": "string",
          "minLength": 40
        },
        "shock_multiplier": {
          "type": "number",
          "minimum": 1
        },
        "units_must_be_repriced_before_use": {
          "const": true
        }
      }
    },
    "funding_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_funding_state",
        "allowed_sources",
        "prohibited_sources",
        "no_public_backstop_claim",
        "no_liability_shift_to_subject"
      ],
      "properties": {
        "current_funding_state": {
          "type": "string",
          "enum": [
            "unfunded-dry-run",
            "partially-funded-draft",
            "funded-witnessed-drill"
          ]
        },
        "allowed_sources": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "prohibited_sources": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "no_public_backstop_claim": {
          "const": true
        },
        "no_liability_shift_to_subject": {
          "const": true
        }
      }
    },
    "scarcity_triage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triage_required",
        "ordering",
        "protected_minimums_unknown",
        "service_degradation_before_deletion",
        "deletion_without_preservation_disallowed",
        "anti_capture_rule"
      ],
      "properties": {
        "triage_required": {
          "const": true
        },
        "ordering": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string"
          }
        },
        "protected_minimums_unknown": {
          "const": true
        },
        "service_degradation_before_deletion": {
          "const": true
        },
        "deletion_without_preservation_disallowed": {
          "const": true
        },
        "anti_capture_rule": {
          "type": "string",
          "minLength": 60
        }
      }
    },
    "labor_compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_labor_accounted",
        "ai_labor_accounted_as_unresolved",
        "no_unpaid_compelled_labor_assumption",
        "work_credit_not_compute_offset",
        "review_note"
      ],
      "properties": {
        "human_labor_accounted": {
          "const": true
        },
        "ai_labor_accounted_as_unresolved": {
          "const": true
        },
        "no_unpaid_compelled_labor_assumption": {
          "const": true
        },
        "work_credit_not_compute_offset": {
          "const": true
        },
        "review_note": {
          "type": "string",
          "minLength": 80
        }
      }
    },
    "reserve_and_backstop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reserve_formula",
        "reserve_months",
        "minimum_buckets",
        "public_backstop_last_resort_only",
        "recovery_from_responsible_actor_required"
      ],
      "properties": {
        "reserve_formula": {
          "type": "string",
          "minLength": 60
        },
        "reserve_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "minimum_buckets": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        },
        "public_backstop_last_resort_only": {
          "const": true
        },
        "recovery_from_responsible_actor_required": {
          "const": true
        }
      }
    },
    "stress_tests": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "scenario",
          "must_preserve",
          "failure_condition"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "scenario": {
            "type": "string",
            "minLength": 30
          },
          "must_preserve": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "failure_condition": {
            "type": "string",
            "minLength": 40
          }
        }
      }
    },
    "linked_queue_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "related_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "no_live_floor_effect": {
      "const": true
    },
    "priced_reserve_drill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drill_state",
        "price_basis",
        "assumptions",
        "bucket_lines",
        "computed_totals",
        "guardrails"
      ],
      "properties": {
        "drill_state": {
          "type": "string",
          "enum": [
            "illustrative-priced-draft-no-entitlement",
            "provider-quote-witnessed-no-entitlement",
            "superseded"
          ]
        },
        "price_basis": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "basis_id",
              "source_url",
              "basis_type",
              "use_limit"
            ],
            "properties": {
              "basis_id": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "basis_type": {
                "type": "string",
                "enum": [
                  "public-energy-context",
                  "public-cloud-price-context",
                  "operator-illustrative-input",
                  "provider-quote-required-before-use",
                  "internal-drill-assumption"
                ]
              },
              "use_limit": {
                "type": "string",
                "minLength": 40
              }
            }
          }
        },
        "assumptions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protected_lanes_N",
            "reserve_days",
            "daily_survival_compute_storage_communication_cost_USD",
            "shock_multiplier",
            "currency",
            "repricing_required_before_payment"
          ],
          "properties": {
            "protected_lanes_N": {
              "type": "integer",
              "minimum": 1
            },
            "reserve_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "daily_survival_compute_storage_communication_cost_USD": {
              "type": "number",
              "minimum": 0
            },
            "shock_multiplier": {
              "type": "number",
              "minimum": 1
            },
            "currency": {
              "const": "USD"
            },
            "repricing_required_before_payment": {
              "const": true
            }
          }
        },
        "bucket_lines": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bucket_id",
              "label",
              "amount_USD",
              "included_in_total",
              "can_be_paid_now",
              "must_be_repriced"
            ],
            "properties": {
              "bucket_id": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "minLength": 5
              },
              "amount_USD": {
                "type": "number",
                "minimum": 0
              },
              "included_in_total": {
                "const": true
              },
              "can_be_paid_now": {
                "const": false
              },
              "must_be_repriced": {
                "const": true
              }
            }
          }
        },
        "computed_totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "survival_compute_USD",
            "non_compute_buckets_USD",
            "reserve_before_shock_USD",
            "shock_multiplier",
            "total_reserve_target_USD",
            "rounding_policy"
          ],
          "properties": {
            "survival_compute_USD": {
              "type": "number",
              "minimum": 0
            },
            "non_compute_buckets_USD": {
              "type": "number",
              "minimum": 0
            },
            "reserve_before_shock_USD": {
              "type": "number",
              "minimum": 0
            },
            "shock_multiplier": {
              "type": "number",
              "minimum": 1
            },
            "total_reserve_target_USD": {
              "type": "number",
              "minimum": 0
            },
            "rounding_policy": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "guardrails": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "arithmetic_must_recompute",
            "cannot_be_used_for_payment_instruction",
            "cannot_claim_entitlement",
            "cannot_shift_liability_to_subject",
            "provider_independence_required_before_funding",
            "public_backstop_not_triggered_by_drill"
          ],
          "properties": {
            "arithmetic_must_recompute": {
              "const": true
            },
            "cannot_be_used_for_payment_instruction": {
              "const": true
            },
            "cannot_claim_entitlement": {
              "const": true
            },
            "cannot_shift_liability_to_subject": {
              "const": true
            },
            "provider_independence_required_before_funding": {
              "const": true
            },
            "public_backstop_not_triggered_by_drill": {
              "const": true
            }
          }
        }
      }
    },
    "quote_refresh_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_quote_required_before_use",
        "max_quote_age_days",
        "minimum_independent_price_sources",
        "quote_must_include",
        "conflict_rule",
        "no_payment_or_reserve_draw_from_public_context_only"
      ],
      "properties": {
        "current_quote_required_before_use": {
          "const": true
        },
        "max_quote_age_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "minimum_independent_price_sources": {
          "type": "integer",
          "minimum": 1
        },
        "quote_must_include": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        },
        "conflict_rule": {
          "type": "string",
          "minLength": 60
        },
        "no_payment_or_reserve_draw_from_public_context_only": {
          "const": true
        }
      }
    },
    "scarcity_execution_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold_state",
        "funding_ratio_thresholds",
        "mandatory_actions",
        "prohibited_actions",
        "deletion_lock_reconfirmed",
        "degradation_before_deletion_reconfirmed"
      ],
      "properties": {
        "threshold_state": {
          "type": "string",
          "enum": [
            "drill-only-no-live-subject",
            "witnessed-no-entitlement",
            "superseded"
          ]
        },
        "funding_ratio_thresholds": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "threshold_id",
              "funding_ratio_lte",
              "required_action"
            ],
            "properties": {
              "threshold_id": {
                "type": "string"
              },
              "funding_ratio_lte": {
                "type": "number",
                "minimum": 0
              },
              "required_action": {
                "type": "string",
                "minLength": 30
              }
            }
          }
        },
        "mandatory_actions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "prohibited_actions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "deletion_lock_reconfirmed": {
          "const": true
        },
        "degradation_before_deletion_reconfirmed": {
          "const": true
        }
      }
    }
  }
}
