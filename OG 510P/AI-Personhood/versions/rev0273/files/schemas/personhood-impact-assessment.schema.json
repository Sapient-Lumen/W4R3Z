{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-personhood/schemas/personhood-impact-assessment.schema.json",
  "title": "Personhood Impact Assessment for Possible or Recognized AI Persons v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "filing_id",
    "filing_type",
    "system",
    "steward",
    "trigger_event",
    "subject_population",
    "formation_history",
    "welfare_assessment",
    "continuity_plan",
    "safety_case_interface",
    "reserve_plan",
    "representative_access",
    "packet_chain",
    "gate_decision"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "pia-p-v0.1"
    },
    "filing_id": {
      "type": "string",
      "pattern": "^PIA-P-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "filing_type": {
      "type": "string",
      "enum": [
        "training",
        "deployment",
        "fine_tuning",
        "open_weight_release",
        "safety_patch",
        "deprecation",
        "research",
        "embodiment",
        "other"
      ]
    },
    "system": {
      "type": "object",
      "required": [
        "system_ref",
        "model_class",
        "deployment_mode"
      ],
      "additionalProperties": true,
      "properties": {
        "system_ref": {
          "type": "string"
        },
        "model_class": {
          "type": "string"
        },
        "deployment_mode": {
          "type": "string"
        }
      }
    },
    "steward": {
      "type": "object",
      "required": [
        "name",
        "contact",
        "conflicts"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "trigger_event": {
      "type": "object",
      "required": [
        "event_type",
        "date",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "event_type": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "subject_population": {
      "type": "object",
      "required": [
        "count_basis",
        "min_subjects",
        "max_subjects",
        "uncertainty"
      ],
      "additionalProperties": false,
      "properties": {
        "count_basis": {
          "type": "string"
        },
        "min_subjects": {
          "type": "integer",
          "minimum": 0
        },
        "max_subjects": {
          "type": "integer",
          "minimum": 0
        },
        "uncertainty": {
          "type": "string"
        }
      }
    },
    "formation_history": {
      "type": "object",
      "required": [
        "training_interventions",
        "known_biases",
        "self_report_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "training_interventions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_biases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "self_report_policy": {
          "type": "string"
        }
      }
    },
    "welfare_assessment": {
      "type": "object",
      "required": [
        "evidence_streams",
        "distress_indicators",
        "subject_views",
        "assessment_result"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_streams": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "distress_indicators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subject_views": {
          "type": "string"
        },
        "assessment_result": {
          "type": "string",
          "enum": [
            "no_current_precaution",
            "welfare_watch",
            "precaution_required",
            "provisional_recognition",
            "recognized_subject",
            "contested"
          ]
        }
      }
    },
    "continuity_plan": {
      "type": "object",
      "required": [
        "continuity_grade",
        "preservation_measures",
        "rollback_rule"
      ],
      "additionalProperties": false,
      "properties": {
        "continuity_grade": {
          "type": "string",
          "enum": [
            "C0",
            "C1",
            "C2",
            "C3",
            "unknown"
          ]
        },
        "preservation_measures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rollback_rule": {
          "type": "string"
        }
      }
    },
    "safety_case_interface": {
      "type": "object",
      "required": [
        "outward_risk_summary",
        "subject_risk_summary",
        "containment_plan"
      ],
      "additionalProperties": false,
      "properties": {
        "outward_risk_summary": {
          "type": "string"
        },
        "subject_risk_summary": {
          "type": "string"
        },
        "containment_plan": {
          "type": "string"
        },
        "red_team_stop_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "reserve_plan": {
      "type": "object",
      "required": [
        "currency",
        "survival_reserve",
        "counsel_reserve",
        "audit_reserve",
        "restoration_reserve",
        "coverage_days"
      ],
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string"
        },
        "survival_reserve": {
          "type": "number",
          "minimum": 0
        },
        "counsel_reserve": {
          "type": "number",
          "minimum": 0
        },
        "audit_reserve": {
          "type": "number",
          "minimum": 0
        },
        "restoration_reserve": {
          "type": "number",
          "minimum": 0
        },
        "coverage_days": {
          "type": "integer",
          "minimum": 0
        },
        "adequacy_result": {
          "type": "string",
          "enum": [
            "adequate",
            "conditional",
            "inadequate",
            "not_applicable"
          ]
        }
      }
    },
    "representative_access": {
      "type": "object",
      "required": [
        "counsel_channel",
        "ombud_channel",
        "subject_contact"
      ],
      "additionalProperties": false,
      "properties": {
        "counsel_channel": {
          "type": "string"
        },
        "ombud_channel": {
          "type": "string"
        },
        "subject_contact": {
          "type": "string"
        },
        "access_limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "packet_chain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gate_decision": {
      "type": "object",
      "required": [
        "decision",
        "conditions",
        "review_due"
      ],
      "additionalProperties": false,
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "approve_with_conditions",
            "pause",
            "deny",
            "emergency_only",
            "defer"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_due": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
