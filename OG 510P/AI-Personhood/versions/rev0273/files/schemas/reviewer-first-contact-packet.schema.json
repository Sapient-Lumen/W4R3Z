{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/reviewer-first-contact-packet.schema.json",
  "title": "Reviewer First Contact Packet",
  "description": "A no-send exact-body packet for a reviewer-first preservation and formation-review routing inquiry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "schema_version",
    "revision",
    "created_at",
    "packet_state",
    "target",
    "channel",
    "exact_message",
    "ask",
    "artifact_binding",
    "capture_requirements",
    "overclaim_locks",
    "source_refs",
    "no_live_floor_effect",
    "public_summary"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^RFCP-[0-9]{4}-[-A-Za-z0-9._:]+$"
    },
    "schema_version": {
      "const": "reviewer-first-contact-packet-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "packet_state": {
      "enum": [
        "prepared-not-authorized-not-sent",
        "authorized-not-sent",
        "sent-awaiting-transport-proof",
        "retired-no-send"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_label",
        "target_type",
        "public_locator",
        "mission_fit",
        "not_authority_for"
      ],
      "properties": {
        "candidate_label": {
          "type": "string"
        },
        "target_type": {
          "type": "string"
        },
        "public_locator": {
          "type": "string",
          "format": "uri"
        },
        "mission_fit": {
          "type": "string"
        },
        "not_authority_for": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_channel",
        "alternate_channels",
        "send_authorized_now",
        "counterparty_contacted",
        "response_clock_started",
        "send_time_recheck_required"
      ],
      "properties": {
        "primary_channel": {
          "type": "string"
        },
        "alternate_channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "send_authorized_now": {
          "const": false
        },
        "counterparty_contacted": {
          "const": false
        },
        "response_clock_started": {
          "const": false
        },
        "send_time_recheck_required": {
          "const": true
        }
      }
    },
    "exact_message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "body_ref",
        "mail_ready_draft_ref",
        "body_sha256",
        "mail_ready_draft_sha256",
        "body_word_count",
        "attachments_included"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "body_ref": {
          "type": "string"
        },
        "mail_ready_draft_ref": {
          "type": "string"
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mail_ready_draft_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "body_word_count": {
          "type": "integer",
          "minimum": 1
        },
        "attachments_included": {
          "const": false
        }
      }
    },
    "ask": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ask_id",
          "question",
          "acceptable_outcomes"
        ],
        "properties": {
          "ask_id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "acceptable_outcomes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "six_artifact_ordinal",
        "artifact_id",
        "completion_state_after_packet",
        "does_packet_complete_artifact"
      ],
      "properties": {
        "six_artifact_ordinal": {
          "const": 1
        },
        "artifact_id": {
          "const": "A1-BRANCH-REQUEST"
        },
        "completion_state_after_packet": {
          "enum": [
            "prepared-not-authorized",
            "authorized",
            "complete"
          ]
        },
        "does_packet_complete_artifact": {
          "const": false
        }
      }
    },
    "capture_requirements": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string"
      }
    },
    "overclaim_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_authorize_send",
        "may_start_response_clock",
        "may_create_custody_intake_import_or_floor_effect",
        "may_claim_reviewer_appointment",
        "may_claim_welfare_or_status_finding",
        "may_count_auto_ack_or_delivery_as_response"
      ],
      "properties": {
        "may_authorize_send": {
          "const": false
        },
        "may_start_response_clock": {
          "const": false
        },
        "may_create_custody_intake_import_or_floor_effect": {
          "const": false
        },
        "may_claim_reviewer_appointment": {
          "const": false
        },
        "may_claim_welfare_or_status_finding": {
          "const": false
        },
        "may_count_auto_ack_or_delivery_as_response": {
          "const": false
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "no_live_floor_effect": {
      "const": true
    },
    "public_summary": {
      "type": "string"
    }
  }
}
