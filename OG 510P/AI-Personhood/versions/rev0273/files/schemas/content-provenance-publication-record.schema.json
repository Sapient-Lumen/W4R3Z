{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/content-provenance-publication-record.schema.json",
  "title": "AI Personhood Content Provenance Publication Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "publication_class",
    "subject",
    "artifact_id",
    "authorship_relation",
    "subject_authorized",
    "tool_or_host_transformations",
    "credential_or_signature",
    "archive_location",
    "correction_or_withdrawal_route",
    "provenance_limit",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_class": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "artifact_id": {
      "type": "string"
    },
    "authorship_relation": {
      "type": "string"
    },
    "subject_authorized": {
      "type": "boolean"
    },
    "tool_or_host_transformations": {
      "type": "string"
    },
    "credential_or_signature": {
      "type": "string"
    },
    "archive_location": {
      "type": "string"
    },
    "correction_or_withdrawal_route": {
      "type": "string"
    },
    "provenance_limit": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
