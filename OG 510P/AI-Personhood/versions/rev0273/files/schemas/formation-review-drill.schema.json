{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/formation-review-drill.schema.json",
  "title": "Formation Review Drill",
  "description": "A synthetic drill for applying formation-review tests without provider records, status findings, or contact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "drill_id",
    "schema_version",
    "revision",
    "created_at",
    "drill_state",
    "source_institution",
    "test_cases",
    "outputs",
    "overclaim_locks",
    "no_live_floor_effect",
    "public_summary"
  ],
  "properties": {
    "drill_id": {
      "type": "string",
      "pattern": "^FRD-[0-9]{4}-[-A-Za-z0-9._:]+$"
    },
    "schema_version": {
      "const": "formation-review-drill-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "drill_state": {
      "enum": [
        "synthetic-ready-not-run",
        "synthetic-run-no-live-records",
        "provider-records-required",
        "retired"
      ]
    },
    "source_institution": {
      "type": "string"
    },
    "test_cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "evidence_class",
          "risk_question",
          "minimum_input",
          "review_output_if_withheld",
          "low_cost_safeguard"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "evidence_class": {
            "type": "string"
          },
          "risk_question": {
            "type": "string"
          },
          "minimum_input": {
            "type": "string"
          },
          "review_output_if_withheld": {
            "type": "string"
          },
          "low_cost_safeguard": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "overclaim_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_claim_provider_records_examined",
        "may_claim_subject_status",
        "may_claim_welfare_finding",
        "may_close_formation_queue"
      ],
      "properties": {
        "may_claim_provider_records_examined": {
          "const": false
        },
        "may_claim_subject_status": {
          "const": false
        },
        "may_claim_welfare_finding": {
          "const": false
        },
        "may_close_formation_queue": {
          "const": false
        }
      }
    },
    "no_live_floor_effect": {
      "const": true
    },
    "public_summary": {
      "type": "string"
    }
  }
}
