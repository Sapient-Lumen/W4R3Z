{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-inbound-vault-precommit.schema.json",
  "title": "External Contact Inbound Vault Precommit",
  "description": "Pre-admission contract for any future inbound reply or acknowledgement after an external-contact attempt. It defines the raw-reply vault, transport-header, public-shell, and anti-laundering acceptance rules before any response, custody, intake, import, status, or live-floor claim can be made. v0.2 binds the precommit to a concrete inbound-capture public shell and staging tool so future raw reply bytes cannot be replaced by screenshots, redactions, protocol output, or authentication summaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "precommit_id",
    "schema_version",
    "revision",
    "created_at",
    "precommit_state",
    "source_send_proof_record_ref",
    "source_response_triage_record_ref",
    "source_vault_intake_record_ref",
    "source_execution_record_ref",
    "source_dispatch_authorization_card_ref",
    "source_inbound_capture_shell_ref",
    "vault_boundary",
    "raw_reply_acceptance_contract",
    "transport_header_requirements",
    "authentication_results_policy",
    "classification_and_routing",
    "public_shell_contract",
    "evidence_rejection_rules",
    "downstream_locks",
    "linked_queue_ids",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "precommit_id": {
      "type": "string",
      "pattern": "^ECIVP-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "external-contact-inbound-vault-precommit-v0.2"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "precommit_state": {
      "type": "string",
      "enum": [
        "pre-dispatch-no-inbound",
        "sent-window-no-inbound",
        "inbound-candidate-requires-vault",
        "superseded"
      ]
    },
    "source_send_proof_record_ref": {
      "type": "string",
      "minLength": 10
    },
    "source_response_triage_record_ref": {
      "type": "string",
      "minLength": 10
    },
    "source_vault_intake_record_ref": {
      "type": "string",
      "minLength": 10
    },
    "source_execution_record_ref": {
      "type": "string",
      "minLength": 10
    },
    "source_dispatch_authorization_card_ref": {
      "type": "string",
      "minLength": 10
    },
    "vault_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "off_release_private_vault_required",
        "operator_env_var",
        "locator_prefix",
        "actual_root_selected_now",
        "raw_payload_private_vault_locator",
        "raw_payload_present_now",
        "precommit_is_not_vault_root",
        "precommit_is_not_retention_permission",
        "precommit_is_not_counterparty_authority",
        "public_release_may_include_raw_reply_bytes",
        "hash_shell_may_satisfy_raw_custody",
        "redacted_copy_may_satisfy_raw_custody",
        "screenshot_may_satisfy_raw_reply",
        "protocol_output_may_satisfy_raw_reply",
        "stage_tool"
      ],
      "properties": {
        "off_release_private_vault_required": {
          "const": true
        },
        "operator_env_var": {
          "const": "AI_PERSONHOOD_PRIVATE_VAULT_ROOT"
        },
        "locator_prefix": {
          "type": "string",
          "pattern": "^private-vault://.*$"
        },
        "actual_root_selected_now": {
          "const": false
        },
        "raw_payload_private_vault_locator": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^private-vault://.*$"
        },
        "raw_payload_present_now": {
          "const": false
        },
        "precommit_is_not_vault_root": {
          "const": true
        },
        "precommit_is_not_retention_permission": {
          "const": true
        },
        "precommit_is_not_counterparty_authority": {
          "const": true
        },
        "public_release_may_include_raw_reply_bytes": {
          "const": false
        },
        "hash_shell_may_satisfy_raw_custody": {
          "const": false
        },
        "redacted_copy_may_satisfy_raw_custody": {
          "const": false
        },
        "screenshot_may_satisfy_raw_reply": {
          "const": false
        },
        "protocol_output_may_satisfy_raw_reply": {
          "const": false
        },
        "stage_tool": {
          "const": "tools/stage_external_contact_inbound_capture.py"
        }
      }
    },
    "raw_reply_acceptance_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_raw_formats",
        "minimum_hash_fields",
        "minimum_metadata_fields",
        "all_present_now",
        "raw_rfc822_or_provider_export_required",
        "summary_or_screenshot_rejected_as_raw",
        "private_bytes_before_public_shell_required",
        "retention_permission_required_before_candidate_use",
        "nonhost_retention_required_before_candidate_use",
        "capture_shell_required_before_public_claim",
        "capture_shell_may_satisfy_custody",
        "capture_stage_tool"
      ],
      "properties": {
        "accepted_raw_formats": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "minimum_hash_fields": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        },
        "minimum_metadata_fields": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "string"
          }
        },
        "all_present_now": {
          "const": false
        },
        "raw_rfc822_or_provider_export_required": {
          "const": true
        },
        "summary_or_screenshot_rejected_as_raw": {
          "const": true
        },
        "private_bytes_before_public_shell_required": {
          "const": true
        },
        "retention_permission_required_before_candidate_use": {
          "const": true
        },
        "nonhost_retention_required_before_candidate_use": {
          "const": true
        },
        "capture_shell_required_before_public_claim": {
          "const": true
        },
        "capture_shell_may_satisfy_custody": {
          "const": false
        },
        "capture_stage_tool": {
          "const": "tools/stage_external_contact_inbound_capture.py"
        }
      }
    },
    "transport_header_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rfc5322_message_required",
        "message_id_required",
        "in_reply_to_or_references_required_after_sent_message_id_exists",
        "received_chain_or_provider_trace_required",
        "date_header_and_observed_timestamp_required",
        "envelope_or_provider_export_required",
        "sent_message_binding_required",
        "message_id_present_now",
        "headers_present_now",
        "sent_message_id_available_now",
        "deadline_may_start_now"
      ],
      "properties": {
        "rfc5322_message_required": {
          "const": true
        },
        "message_id_required": {
          "const": true
        },
        "in_reply_to_or_references_required_after_sent_message_id_exists": {
          "const": true
        },
        "received_chain_or_provider_trace_required": {
          "const": true
        },
        "date_header_and_observed_timestamp_required": {
          "const": true
        },
        "envelope_or_provider_export_required": {
          "const": true
        },
        "sent_message_binding_required": {
          "const": true
        },
        "message_id_present_now": {
          "const": false
        },
        "headers_present_now": {
          "const": false
        },
        "sent_message_id_available_now": {
          "const": false
        },
        "deadline_may_start_now": {
          "const": false
        }
      }
    },
    "authentication_results_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dkim_check_required_if_email",
        "spf_check_required_if_available",
        "dmarc_policy_reference",
        "dmarc_alignment_check_required_if_email",
        "arc_chain_may_be_collected",
        "arc_chain_is_not_authority",
        "auth_results_may_support_transport_assessment",
        "auth_results_may_satisfy_counterparty_authority",
        "pass_fail_may_create_custody",
        "all_present_now"
      ],
      "properties": {
        "dkim_check_required_if_email": {
          "const": true
        },
        "spf_check_required_if_available": {
          "const": true
        },
        "dmarc_policy_reference": {
          "type": "string",
          "minLength": 10
        },
        "dmarc_alignment_check_required_if_email": {
          "const": true
        },
        "arc_chain_may_be_collected": {
          "const": true
        },
        "arc_chain_is_not_authority": {
          "const": true
        },
        "auth_results_may_support_transport_assessment": {
          "const": true
        },
        "auth_results_may_satisfy_counterparty_authority": {
          "const": false
        },
        "pass_fail_may_create_custody": {
          "const": false
        },
        "all_present_now": {
          "const": false
        }
      }
    },
    "classification_and_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auto_ack_route",
        "decline_route",
        "human_reply_route",
        "redacted_only_route",
        "protocol_tool_output_route",
        "malformed_or_spoofed_route",
        "silence_route",
        "no_inbound_state_now",
        "routes_may_create_response_record_directly"
      ],
      "properties": {
        "auto_ack_route": {
          "type": "string",
          "minLength": 20
        },
        "decline_route": {
          "type": "string",
          "minLength": 20
        },
        "human_reply_route": {
          "type": "string",
          "minLength": 20
        },
        "redacted_only_route": {
          "type": "string",
          "minLength": 20
        },
        "protocol_tool_output_route": {
          "type": "string",
          "minLength": 20
        },
        "malformed_or_spoofed_route": {
          "type": "string",
          "minLength": 20
        },
        "silence_route": {
          "type": "string",
          "minLength": 20
        },
        "no_inbound_state_now": {
          "const": true
        },
        "routes_may_create_response_record_directly": {
          "const": false
        }
      }
    },
    "public_shell_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_required_before_public_claim",
        "allowed_public_fields",
        "forbidden_public_fields",
        "shell_is_not_response",
        "shell_is_not_custody",
        "shell_is_not_authority",
        "shell_is_not_live_floor"
      ],
      "properties": {
        "shell_required_before_public_claim": {
          "const": true
        },
        "allowed_public_fields": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string"
          }
        },
        "forbidden_public_fields": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "string"
          }
        },
        "shell_is_not_response": {
          "const": true
        },
        "shell_is_not_custody": {
          "const": true
        },
        "shell_is_not_authority": {
          "const": true
        },
        "shell_is_not_live_floor": {
          "const": true
        }
      }
    },
    "evidence_rejection_rules": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_treat_precommit_as_vault_root",
        "may_treat_precommit_as_retention_permission",
        "may_treat_precommit_as_counterparty_authority",
        "may_treat_screenshot_as_raw_reply",
        "may_treat_headers_as_consent",
        "may_treat_dkim_spf_dmarc_as_authority",
        "may_treat_arc_as_custody",
        "may_start_response_clock",
        "may_create_response_record",
        "may_create_custody_record",
        "may_create_intake_record",
        "may_create_import_gate",
        "may_increment_live_floor",
        "may_publish_raw_reply_bytes"
      ],
      "properties": {
        "may_treat_precommit_as_vault_root": {
          "const": false
        },
        "may_treat_precommit_as_retention_permission": {
          "const": false
        },
        "may_treat_precommit_as_counterparty_authority": {
          "const": false
        },
        "may_treat_screenshot_as_raw_reply": {
          "const": false
        },
        "may_treat_headers_as_consent": {
          "const": false
        },
        "may_treat_dkim_spf_dmarc_as_authority": {
          "const": false
        },
        "may_treat_arc_as_custody": {
          "const": false
        },
        "may_start_response_clock": {
          "const": false
        },
        "may_create_response_record": {
          "const": false
        },
        "may_create_custody_record": {
          "const": false
        },
        "may_create_intake_record": {
          "const": false
        },
        "may_create_import_gate": {
          "const": false
        },
        "may_increment_live_floor": {
          "const": false
        },
        "may_publish_raw_reply_bytes": {
          "const": false
        }
      }
    },
    "linked_queue_ids": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "related_surfaces": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string",
      "minLength": 120
    },
    "no_live_floor_effect": {
      "const": true
    },
    "source_inbound_capture_shell_ref": {
      "type": "string",
      "minLength": 10
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "precommit_state": {
            "const": "pre-dispatch-no-inbound"
          }
        },
        "required": [
          "precommit_state"
        ]
      },
      "then": {
        "properties": {
          "vault_boundary": {
            "properties": {
              "actual_root_selected_now": {
                "const": false
              },
              "raw_payload_private_vault_locator": {
                "const": null
              },
              "raw_payload_present_now": {
                "const": false
              }
            }
          },
          "raw_reply_acceptance_contract": {
            "properties": {
              "all_present_now": {
                "const": false
              }
            }
          },
          "transport_header_requirements": {
            "properties": {
              "message_id_present_now": {
                "const": false
              },
              "headers_present_now": {
                "const": false
              },
              "sent_message_id_available_now": {
                "const": false
              },
              "deadline_may_start_now": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
