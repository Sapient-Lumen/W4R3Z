{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/live-receipt-floor-recompute-receipt.schema.json",
  "title": "Live Receipt Floor Recompute Receipt",
  "description": "Publication gate for computed live-floor snapshots. It hashes and replays the generated computed-floor snapshot so no manual floor edit, stale rollback state, or partial class-local candidate can be treated as reliance upgrade.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recompute_receipt_id",
    "schema_version",
    "created_at",
    "revision",
    "linked_computed_snapshot_ref",
    "computed_snapshot_sha256",
    "snapshot_replay_summary",
    "recompute_checks",
    "publication_locks",
    "decision",
    "no_direct_floor_effect"
  ],
  "properties": {
    "recompute_receipt_id": {
      "type": "string",
      "pattern": "^LRFRR-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "live-receipt-floor-recompute-receipt-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "linked_computed_snapshot_ref": {
      "type": "string"
    },
    "computed_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_replay_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "independent_receipts_present",
        "live_floor_delta",
        "eligible_live_imports",
        "live_classes_satisfied",
        "missing_live_classes",
        "cross_critical_quorum_satisfied",
        "reliance_effect"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "independent_receipts_present": {
          "type": "integer",
          "minimum": 0
        },
        "live_floor_delta": {
          "type": "integer"
        },
        "eligible_live_imports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "live_classes_satisfied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_live_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cross_critical_quorum_satisfied": {
          "type": "boolean"
        },
        "reliance_effect": {
          "type": "string",
          "enum": [
            "stayed",
            "conditional",
            "ordinary-reliance",
            "blocked"
          ]
        }
      }
    },
    "recompute_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_current_revision",
        "generated_by_floor_engine",
        "snapshot_matches_fresh_recompute",
        "late_stage_paths_present_in_scope",
        "failed_gate_summaries_present_for_exclusions",
        "no_manual_ledger_override",
        "no_stale_quorum_report",
        "challenge_rollback_state_replayed",
        "cross_critical_quorum_recomputed",
        "reliance_effect_matches_quorum",
        "no_private_material_in_public_release"
      ],
      "properties": {
        "snapshot_current_revision": {
          "type": "boolean"
        },
        "generated_by_floor_engine": {
          "type": "boolean"
        },
        "snapshot_matches_fresh_recompute": {
          "type": "boolean"
        },
        "late_stage_paths_present_in_scope": {
          "type": "boolean"
        },
        "failed_gate_summaries_present_for_exclusions": {
          "type": "boolean"
        },
        "no_manual_ledger_override": {
          "type": "boolean"
        },
        "no_stale_quorum_report": {
          "type": "boolean"
        },
        "challenge_rollback_state_replayed": {
          "type": "boolean"
        },
        "cross_critical_quorum_recomputed": {
          "type": "boolean"
        },
        "reliance_effect_matches_quorum": {
          "type": "boolean"
        },
        "no_private_material_in_public_release": {
          "type": "boolean"
        }
      }
    },
    "publication_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_publish_computed_floor_snapshot",
        "manual_live_floor_update_allowed",
        "may_increment_live_floor_from_receipt",
        "may_upgrade_reliance",
        "recompute_receipt_required_for_reliance_upgrade",
        "rollback_recheck_required"
      ],
      "properties": {
        "may_publish_computed_floor_snapshot": {
          "type": "boolean"
        },
        "manual_live_floor_update_allowed": {
          "const": false
        },
        "may_increment_live_floor_from_receipt": {
          "const": false
        },
        "may_upgrade_reliance": {
          "type": "boolean"
        },
        "recompute_receipt_required_for_reliance_upgrade": {
          "const": true
        },
        "rollback_recheck_required": {
          "const": true
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "floor_publication_state",
        "may_publish_snapshot",
        "may_upgrade_reliance",
        "live_reliance_effect",
        "reason",
        "blocked_actions",
        "next_actions"
      ],
      "properties": {
        "floor_publication_state": {
          "type": "string",
          "enum": [
            "blocked-no-current-snapshot",
            "blocked-snapshot-mismatch",
            "blocked-manual-or-stale-override",
            "blocked-rollback-or-challenge-unreplayed",
            "eligible-zero-floor-stayed",
            "eligible-class-local-publication",
            "eligible-cross-critical-reliance"
          ]
        },
        "may_publish_snapshot": {
          "type": "boolean"
        },
        "may_upgrade_reliance": {
          "type": "boolean"
        },
        "live_reliance_effect": {
          "type": "string",
          "enum": [
            "blocked",
            "stayed",
            "ordinary-reliance"
          ]
        },
        "reason": {
          "type": "string"
        },
        "blocked_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "no_direct_floor_effect": {
      "const": true
    }
  }
}
