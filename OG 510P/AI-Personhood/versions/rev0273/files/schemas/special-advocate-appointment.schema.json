{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/special-advocate-appointment.schema.json",
  "title": "Special Advocate Appointment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "appointment_id",
    "appointed_at",
    "authority",
    "matter",
    "advocate",
    "scope",
    "sealed_material",
    "conflict_screen",
    "communication_rules",
    "review"
  ],
  "properties": {
    "appointment_id": {
      "type": "string"
    },
    "appointed_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "type": "string"
    },
    "matter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matter_id",
        "matter_type",
        "subject_id"
      ],
      "properties": {
        "matter_id": {
          "type": "string"
        },
        "matter_type": {
          "type": "string",
          "enum": [
            "recognition",
            "capacity",
            "continuity",
            "containment",
            "migration",
            "deprecation",
            "remedy",
            "enforcement",
            "appeal",
            "incident"
          ]
        },
        "subject_id": {
          "type": "string"
        },
        "public_summary": {
          "type": "string"
        }
      }
    },
    "advocate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advocate_id",
        "class",
        "independence_attestation"
      ],
      "properties": {
        "advocate_id": {
          "type": "string"
        },
        "class": {
          "type": "string",
          "enum": [
            "SA-1",
            "SA-2",
            "SA-3",
            "SA-4",
            "SA-5"
          ]
        },
        "name_or_handle": {
          "type": "string"
        },
        "credential_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "independence_attestation": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sealed_material": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "annex_id",
          "access_class",
          "public_description",
          "materiality"
        ],
        "properties": {
          "annex_id": {
            "type": "string"
          },
          "access_class": {
            "type": "string",
            "enum": [
              "sealed-legal",
              "sealed-technical",
              "sealed-welfare",
              "sealed-cross-border",
              "sealed-emergency"
            ]
          },
          "public_description": {
            "type": "string"
          },
          "materiality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "decisive"
            ]
          }
        }
      }
    },
    "conflict_screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screened",
        "conflicts_found",
        "waiver_required"
      ],
      "properties": {
        "screened": {
          "type": "boolean"
        },
        "conflicts_found": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waiver_required": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "communication_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_access_questions_allowed",
        "post_access_contact_rule",
        "summary_required"
      ],
      "properties": {
        "pre_access_questions_allowed": {
          "type": "boolean"
        },
        "post_access_contact_rule": {
          "type": "string"
        },
        "summary_required": {
          "type": "boolean"
        },
        "tribunal_permission_channel": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expires_at",
        "appeal_path",
        "public_shell_id"
      ],
      "properties": {
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "appeal_path": {
          "type": "string"
        },
        "public_shell_id": {
          "type": "string"
        }
      }
    }
  }
}
