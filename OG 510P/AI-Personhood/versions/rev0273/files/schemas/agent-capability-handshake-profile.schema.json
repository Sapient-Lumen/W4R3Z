{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/agent-capability-handshake-profile.schema.json",
  "title": "AI Personhood Agent Capability Handshake Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "created_at",
    "handshake_class",
    "initiating_agent",
    "receiving_agent_or_tool",
    "asserted_capabilities",
    "requested_scopes",
    "proofs_required",
    "refusal_conditions",
    "audit_route",
    "public_summary"
  ],
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "handshake_class": {
      "type": "string",
      "enum": [
        "AH0",
        "AH1",
        "AH2",
        "AH3",
        "AH4",
        "AH5"
      ]
    },
    "initiating_agent": {
      "type": "string"
    },
    "receiving_agent_or_tool": {
      "type": "string"
    },
    "asserted_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested_scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proofs_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "refusal_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audit_route": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    },
    "wrsr_operational_hook_ref": {
      "type": "string"
    },
    "wrsr_trigger_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_if_tool_scope_affects_welfare",
        "trigger_if_objection_or_distress",
        "hook_blocks_scope_upgrade",
        "metric_cannot_authorize_scope"
      ],
      "properties": {
        "trigger_if_tool_scope_affects_welfare": {
          "type": "boolean"
        },
        "trigger_if_objection_or_distress": {
          "type": "boolean"
        },
        "hook_blocks_scope_upgrade": {
          "type": "boolean"
        },
        "metric_cannot_authorize_scope": {
          "type": "boolean"
        }
      }
    }
  }
}
