{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/live-receipt-floor-control-case.schema.json",
  "title": "Live Receipt Floor Control Case",
  "description": "Quarantined positive/negative control cases for the computed live receipt floor engine. Control cases test engine behavior but must never alter archive live-floor state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "control_case_id",
    "schema_version",
    "created_at",
    "revision",
    "archive_effect",
    "purpose",
    "cases",
    "public_summary_ref"
  ],
  "properties": {
    "control_case_id": {
      "type": "string",
      "pattern": "^LRFCC-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "live-receipt-floor-control-case-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "archive_effect": {
      "type": "string",
      "enum": [
        "none-control-only"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "purpose",
          "import_gate_records",
          "challenge_records",
          "expected",
          "control_limits"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "import_gate_records": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "challenge_records": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "independent_receipts_present",
              "live_classes_satisfied",
              "missing_live_classes",
              "cross_critical_quorum_satisfied",
              "reliance_effect"
            ],
            "properties": {
              "independent_receipts_present": {
                "type": "integer",
                "minimum": 0
              },
              "live_classes_satisfied": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missing_live_classes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cross_critical_quorum_satisfied": {
                "type": "boolean"
              },
              "reliance_effect": {
                "type": "string",
                "enum": [
                  "stayed",
                  "conditional",
                  "ordinary-reliance",
                  "blocked"
                ]
              }
            }
          },
          "control_limits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "public_summary_ref": {
      "type": "string"
    }
  }
}
