{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-transport-capture-plan.schema.json",
  "title": "External Contact Transport Capture Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "schema_version",
    "revision",
    "created_at",
    "plan_state",
    "source_refs",
    "capture_sequence",
    "required_private_vault_roots",
    "send_proof_acceptance_tests",
    "public_release_policy",
    "operator_failure_routes",
    "downstream_locks",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "plan_id": {"type": "string"},
    "schema_version": {"const": "external-contact-transport-capture-plan-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "plan_state": {"enum": ["ready-template-no-send-no-private-root", "superseded"]},
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_packet", "mail_ready_draft", "public_payload_manifest", "send_proof_record", "send_trace_shell", "delivery_status_record", "inbound_vault_precommit", "inbound_capture_shell", "response_triage_record"],
      "properties": {
        "request_packet": {"type": "string"},
        "mail_ready_draft": {"type": "string"},
        "public_payload_manifest": {"type": "string"},
        "send_proof_record": {"type": "string"},
        "send_trace_shell": {"type": "string"},
        "delivery_status_record": {"type": "string"},
        "inbound_vault_precommit": {"type": "string"},
        "inbound_capture_shell": {"type": "string"},
        "response_triage_record": {"type": "string"}
      }
    },
    "capture_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_opening_compose", "before_clicking_send", "immediately_after_send", "before_reading_any_reply"],
      "properties": {
        "before_opening_compose": {"type": "array", "minItems": 3, "items": {"type": "string"}},
        "before_clicking_send": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "immediately_after_send": {"type": "array", "minItems": 6, "items": {"type": "string"}},
        "before_reading_any_reply": {"type": "array", "minItems": 4, "items": {"type": "string"}}
      }
    },
    "required_private_vault_roots": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["root_id", "purpose", "root_selected_now", "public_release_may_disclose_root", "raw_bytes_may_enter_release_tree", "selection_required_before_send"],
        "properties": {
          "root_id": {"type": "string"},
          "purpose": {"type": "string", "minLength": 10},
          "root_selected_now": {"const": false},
          "public_release_may_disclose_root": {"const": false},
          "raw_bytes_may_enter_release_tree": {"const": false},
          "selection_required_before_send": {"const": true}
        }
      }
    },
    "send_proof_acceptance_tests": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "required_field", "failure_if_missing", "may_start_response_clock_if_alone"],
        "properties": {
          "test_id": {"type": "string"},
          "required_field": {"type": "string", "minLength": 5},
          "failure_if_missing": {"type": "string", "minLength": 10},
          "may_start_response_clock_if_alone": {"const": false}
        }
      }
    },
    "public_release_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_publish_raw_transport_bytes", "may_publish_raw_reply_bytes", "may_publish_private_vault_paths", "allowed_public_shell_fields", "plan_may_substitute_for_send_proof"],
      "properties": {
        "may_publish_raw_transport_bytes": {"const": false},
        "may_publish_raw_reply_bytes": {"const": false},
        "may_publish_private_vault_paths": {"const": false},
        "allowed_public_shell_fields": {"type": "array", "minItems": 5, "items": {"type": "string"}},
        "plan_may_substitute_for_send_proof": {"const": false}
      }
    },
    "operator_failure_routes": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "downstream_locks": {"type": "object", "additionalProperties": {"const": false}, "minProperties": 6},
    "related_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "public_summary": {"type": "string", "minLength": 50},
    "no_live_floor_effect": {"const": true}
  }
}
