{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/release-readiness-checklist.schema.json",
  "title": "AI Personhood Release Readiness Checklist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checklist_id",
    "release_candidate",
    "created_at",
    "decision",
    "items",
    "blocking_failures",
    "conditional_terms",
    "approver",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "checklist_id": {
      "type": "string"
    },
    "release_candidate": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "conditional",
        "blocked",
        "stayed"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "status",
          "evidence",
          "failure_effect"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "exception",
              "not-applicable"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "failure_effect": {
            "type": "string"
          }
        }
      }
    },
    "blocking_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conditional_terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approver": {
      "type": "string"
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
