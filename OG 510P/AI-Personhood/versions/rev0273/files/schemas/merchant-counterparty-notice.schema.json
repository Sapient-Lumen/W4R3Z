{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/merchant-counterparty-notice.schema.json",
  "title": "AI Personhood Merchant Counterparty Notice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notice_id",
    "created_at",
    "notice_class",
    "counterparty",
    "transaction_ref",
    "authority_posture",
    "rights_effects",
    "status_disclosure_level",
    "nonwaiver_statement",
    "refund_or_dispute_route",
    "contact_route",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "notice_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "notice_class": {
      "type": "string",
      "enum": [
        "MN0",
        "MN1",
        "MN2",
        "MN3",
        "MN4",
        "MN5"
      ]
    },
    "counterparty": {
      "type": "string"
    },
    "transaction_ref": {
      "type": "string"
    },
    "authority_posture": {
      "type": "string"
    },
    "rights_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status_disclosure_level": {
      "type": "string"
    },
    "nonwaiver_statement": {
      "type": "string"
    },
    "refund_or_dispute_route": {
      "type": "string"
    },
    "contact_route": {
      "type": "string"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
