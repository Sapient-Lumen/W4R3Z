{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-receipt-response-verification-gate.schema.json",
  "title": "External Receipt Response Verification Gate",
  "description": "Pre-response gate that checks an actual counterparty reply, scoped acceptance, and custody authority before any external receipt response record may be prepared. It never authorizes intake, import, or live-floor credit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_gate_id",
    "schema_version",
    "created_at",
    "linked_custody_record_ref",
    "linked_live_evidence_acquisition_packet_ref",
    "linked_request_packet",
    "requested_receipt_class",
    "gate_state",
    "input_response_descriptor",
    "verification_controls",
    "downstream_locks",
    "decision",
    "no_live_floor_effect"
  ],
  "properties": {
    "response_gate_id": {
      "type": "string",
      "pattern": "^ERVG-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "external-receipt-response-verification-gate-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "linked_custody_record_ref": {
      "type": "string"
    },
    "linked_live_evidence_acquisition_packet_ref": {
      "type": "string"
    },
    "linked_request_packet": {
      "type": "string"
    },
    "requested_receipt_class": {
      "type": "string",
      "enum": [
        "first-touch-clock",
        "continuity-compute-floor",
        "sealed-public-parity",
        "namespace-cache",
        "reserve-ledger",
        "representative-contact",
        "witness-dependency",
        "welfare-signal-integrity",
        "independent-review",
        "result-return"
      ]
    },
    "gate_state": {
      "type": "string",
      "enum": [
        "blocked-no-response",
        "blocked-unverified",
        "blocked-unscoped-acceptance",
        "eligible-for-response-record",
        "quarantined"
      ]
    },
    "input_response_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counterparty_reply_received",
        "counterparty_identity_ref",
        "response_channel",
        "artifacts",
        "received_at",
        "dry_run"
      ],
      "properties": {
        "counterparty_reply_received": {
          "type": "boolean"
        },
        "counterparty_identity_ref": {
          "type": "string"
        },
        "response_channel": {
          "type": "string",
          "enum": [
            "non-host-email",
            "signed-web-form",
            "docket-upload",
            "sealed-transfer",
            "public-shell",
            "synthetic-lab-channel",
            "unknown"
          ]
        },
        "received_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "dry_run": {
          "type": "boolean"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_type",
              "locator_or_hash",
              "generated_by",
              "retained_by",
              "sealed",
              "dry_run"
            ],
            "properties": {
              "artifact_id": {
                "type": "string"
              },
              "artifact_type": {
                "type": "string",
                "enum": [
                  "signed-response",
                  "unsigned-response",
                  "declination",
                  "timestamp",
                  "hash",
                  "log",
                  "public-failed-gate",
                  "sealed-descriptor"
                ]
              },
              "locator_or_hash": {
                "type": "string"
              },
              "generated_by": {
                "type": "string",
                "enum": [
                  "external-counterparty",
                  "host",
                  "neutral-infrastructure",
                  "synthetic"
                ]
              },
              "retained_by": {
                "type": "string"
              },
              "sealed": {
                "type": "boolean"
              },
              "dry_run": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "verification_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custody_record_response_only_authority",
        "counterparty_confirmed",
        "signature_or_equivalent_verified",
        "timestamp_independent",
        "request_trace_matches",
        "nonhost_retention_verified",
        "dependency_checked",
        "receipt_class_matches",
        "scoped_acceptance_present",
        "not_stale_or_superseded",
        "manual_review_completed",
        "private_material_not_in_public_release"
      ],
      "properties": {
        "custody_record_response_only_authority": {
          "type": "boolean"
        },
        "counterparty_confirmed": {
          "type": "boolean"
        },
        "signature_or_equivalent_verified": {
          "type": "boolean"
        },
        "timestamp_independent": {
          "type": "boolean"
        },
        "request_trace_matches": {
          "type": "boolean"
        },
        "nonhost_retention_verified": {
          "type": "boolean"
        },
        "dependency_checked": {
          "type": "boolean"
        },
        "receipt_class_matches": {
          "type": "boolean"
        },
        "scoped_acceptance_present": {
          "type": "boolean"
        },
        "not_stale_or_superseded": {
          "type": "boolean"
        },
        "manual_review_completed": {
          "type": "boolean"
        },
        "private_material_not_in_public_release": {
          "type": "boolean"
        }
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_prepare_external_receipt_response_record",
        "may_create_intake_record",
        "may_run_import_gate",
        "live_floor_delta_allowed"
      ],
      "properties": {
        "may_prepare_external_receipt_response_record": {
          "type": "boolean"
        },
        "may_create_intake_record": {
          "type": "boolean"
        },
        "may_run_import_gate": {
          "type": "boolean"
        },
        "live_floor_delta_allowed": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_record_may_be_prepared",
        "can_generate_actual_intake",
        "live_reliance_effect",
        "reason",
        "blocked_actions",
        "next_actions"
      ],
      "properties": {
        "response_record_may_be_prepared": {
          "type": "boolean"
        },
        "can_generate_actual_intake": {
          "type": "boolean"
        },
        "live_reliance_effect": {
          "type": "string",
          "enum": [
            "none",
            "stayed",
            "blocked",
            "conditional"
          ]
        },
        "reason": {
          "type": "string"
        },
        "blocked_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "no_live_floor_effect": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gate_state": {
            "const": "eligible-for-response-record"
          }
        },
        "required": [
          "gate_state"
        ]
      },
      "then": {
        "properties": {
          "downstream_locks": {
            "properties": {
              "may_prepare_external_receipt_response_record": {
                "const": true
              },
              "may_create_intake_record": {
                "const": false
              },
              "may_run_import_gate": {
                "const": false
              },
              "live_floor_delta_allowed": {
                "const": false
              }
            }
          },
          "decision": {
            "properties": {
              "response_record_may_be_prepared": {
                "const": true
              },
              "can_generate_actual_intake": {
                "const": false
              },
              "live_reliance_effect": {
                "const": "stayed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_state": {
            "enum": [
              "blocked-no-response",
              "blocked-unverified",
              "blocked-unscoped-acceptance",
              "quarantined"
            ]
          }
        },
        "required": [
          "gate_state"
        ]
      },
      "then": {
        "properties": {
          "downstream_locks": {
            "properties": {
              "may_prepare_external_receipt_response_record": {
                "const": false
              },
              "may_create_intake_record": {
                "const": false
              },
              "may_run_import_gate": {
                "const": false
              },
              "live_floor_delta_allowed": {
                "const": false
              }
            }
          },
          "decision": {
            "properties": {
              "response_record_may_be_prepared": {
                "const": false
              },
              "can_generate_actual_intake": {
                "const": false
              },
              "live_reliance_effect": {
                "enum": [
                  "stayed",
                  "blocked",
                  "none"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
