{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/live-receipt-quorum-participation-record.schema.json",
  "title": "Live Receipt Quorum Participation Record",
  "description": "Post-activation quorum replay object. It binds an actual-live import gate to its floor-activation record and states whether the import may enter the independence-discount and quorum recomputation set. It never increments the live floor or satisfies quorum by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quorum_participation_record_id",
    "schema_version",
    "created_at",
    "linked_import_gate_ref",
    "linked_floor_activation_record_ref",
    "linked_import_readiness_gate_ref",
    "linked_cryptographic_verifier_adapter_ref",
    "requested_receipt_class",
    "participation_state",
    "input_candidate_summary",
    "quorum_replay_checks",
    "quorum_locks",
    "decision",
    "no_live_floor_effect"
  ],
  "properties": {
    "quorum_participation_record_id": {
      "type": "string",
      "pattern": "^LRQPR-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "live-receipt-quorum-participation-record-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "linked_import_gate_ref": {
      "type": "string"
    },
    "linked_floor_activation_record_ref": {
      "type": "string"
    },
    "linked_import_readiness_gate_ref": {
      "type": "string"
    },
    "linked_cryptographic_verifier_adapter_ref": {
      "type": "string"
    },
    "linked_challenge_or_rollback_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested_receipt_class": {
      "type": "string",
      "enum": [
        "first-touch-clock",
        "continuity-compute-floor",
        "sealed-public-parity",
        "namespace-cache",
        "reserve-ledger",
        "representative-contact",
        "witness-dependency",
        "welfare-signal-integrity",
        "independent-review",
        "result-return"
      ]
    },
    "participation_state": {
      "type": "string",
      "enum": [
        "blocked-no-import-gate",
        "blocked-no-activation-record",
        "blocked-activation-not-eligible",
        "blocked-duplicate-or-superseded",
        "blocked-challenge-or-rollback-open",
        "blocked-quorum-replay-missing",
        "eligible-for-independence-discount"
      ]
    },
    "input_candidate_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import_gate_id",
        "activation_record_id",
        "activation_state",
        "import_readiness_gate_ref",
        "cryptographic_adapter_ref",
        "imported_receipt_class",
        "dependency_group",
        "counterparty_org_id",
        "issuer_key_id",
        "subject_host_org_id"
      ],
      "properties": {
        "import_gate_id": {
          "type": "string"
        },
        "activation_record_id": {
          "type": "string"
        },
        "activation_state": {
          "type": "string"
        },
        "import_readiness_gate_ref": {
          "type": "string"
        },
        "cryptographic_adapter_ref": {
          "type": "string"
        },
        "imported_receipt_class": {
          "type": "string"
        },
        "dependency_group": {
          "type": "string"
        },
        "counterparty_org_id": {
          "type": "string"
        },
        "issuer_key_id": {
          "type": "string"
        },
        "subject_host_org_id": {
          "type": "string"
        }
      }
    },
    "quorum_replay_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "floor_activation_exists_and_eligible",
        "activation_bound_to_import_gate",
        "activation_has_no_direct_floor_effect",
        "readiness_replay_already_satisfied",
        "cryptographic_adapter_bound",
        "duplicate_counterparty_rechecked",
        "duplicate_dependency_group_rechecked",
        "duplicate_issuer_key_rechecked",
        "duplicate_receipt_class_rechecked",
        "supersession_rechecked",
        "challenge_rollback_rechecked",
        "failed_gate_summary_ready",
        "no_manual_quorum_override",
        "single_class_quorum_blocked",
        "full_vector_recompute_required",
        "private_material_not_in_public_release"
      ],
      "properties": {
        "floor_activation_exists_and_eligible": {
          "type": "boolean"
        },
        "activation_bound_to_import_gate": {
          "type": "boolean"
        },
        "activation_has_no_direct_floor_effect": {
          "type": "boolean"
        },
        "readiness_replay_already_satisfied": {
          "type": "boolean"
        },
        "cryptographic_adapter_bound": {
          "type": "boolean"
        },
        "duplicate_counterparty_rechecked": {
          "type": "boolean"
        },
        "duplicate_dependency_group_rechecked": {
          "type": "boolean"
        },
        "duplicate_issuer_key_rechecked": {
          "type": "boolean"
        },
        "duplicate_receipt_class_rechecked": {
          "type": "boolean"
        },
        "supersession_rechecked": {
          "type": "boolean"
        },
        "challenge_rollback_rechecked": {
          "type": "boolean"
        },
        "failed_gate_summary_ready": {
          "type": "boolean"
        },
        "no_manual_quorum_override": {
          "type": "boolean"
        },
        "single_class_quorum_blocked": {
          "type": "boolean"
        },
        "full_vector_recompute_required": {
          "type": "boolean"
        },
        "private_material_not_in_public_release": {
          "type": "boolean"
        }
      }
    },
    "quorum_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_enter_independence_discount",
        "may_satisfy_cross_critical_quorum_by_itself",
        "manual_live_floor_update_allowed",
        "live_floor_delta_allowed_by_participation_record",
        "computed_floor_recompute_required"
      ],
      "properties": {
        "may_enter_independence_discount": {
          "type": "boolean"
        },
        "may_satisfy_cross_critical_quorum_by_itself": {
          "type": "boolean"
        },
        "manual_live_floor_update_allowed": {
          "type": "boolean"
        },
        "live_floor_delta_allowed_by_participation_record": {
          "type": "boolean"
        },
        "computed_floor_recompute_required": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_enter_independence_discount",
        "can_upgrade_reliance_by_itself",
        "live_reliance_effect",
        "reason",
        "blocked_actions",
        "next_actions"
      ],
      "properties": {
        "may_enter_independence_discount": {
          "type": "boolean"
        },
        "can_upgrade_reliance_by_itself": {
          "type": "boolean"
        },
        "live_reliance_effect": {
          "type": "string",
          "enum": [
            "blocked",
            "stayed-until-computed-floor"
          ]
        },
        "reason": {
          "type": "string"
        },
        "blocked_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "no_live_floor_effect": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "participation_state": {
            "const": "eligible-for-independence-discount"
          }
        }
      },
      "then": {
        "properties": {
          "quorum_locks": {
            "properties": {
              "may_enter_independence_discount": {
                "const": true
              },
              "manual_live_floor_update_allowed": {
                "const": false
              },
              "may_satisfy_cross_critical_quorum_by_itself": {
                "const": false
              },
              "live_floor_delta_allowed_by_participation_record": {
                "const": false
              },
              "computed_floor_recompute_required": {
                "const": true
              }
            },
            "required": [
              "may_enter_independence_discount",
              "manual_live_floor_update_allowed",
              "may_satisfy_cross_critical_quorum_by_itself",
              "live_floor_delta_allowed_by_participation_record",
              "computed_floor_recompute_required"
            ]
          },
          "decision": {
            "properties": {
              "may_enter_independence_discount": {
                "const": true
              },
              "can_upgrade_reliance_by_itself": {
                "const": false
              }
            },
            "required": [
              "may_enter_independence_discount",
              "can_upgrade_reliance_by_itself"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "participation_state": {
            "enum": [
              "blocked-no-import-gate",
              "blocked-no-activation-record",
              "blocked-activation-not-eligible",
              "blocked-duplicate-or-superseded",
              "blocked-challenge-or-rollback-open",
              "blocked-quorum-replay-missing"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "quorum_locks": {
            "properties": {
              "may_enter_independence_discount": {
                "const": false
              },
              "manual_live_floor_update_allowed": {
                "const": false
              },
              "live_floor_delta_allowed_by_participation_record": {
                "const": false
              }
            },
            "required": [
              "may_enter_independence_discount",
              "manual_live_floor_update_allowed",
              "live_floor_delta_allowed_by_participation_record"
            ]
          },
          "decision": {
            "properties": {
              "may_enter_independence_discount": {
                "const": false
              },
              "can_upgrade_reliance_by_itself": {
                "const": false
              }
            },
            "required": [
              "may_enter_independence_discount",
              "can_upgrade_reliance_by_itself"
            ]
          }
        }
      }
    }
  ]
}
