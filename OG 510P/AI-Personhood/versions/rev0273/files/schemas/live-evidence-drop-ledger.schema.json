{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/live-evidence-drop-ledger.schema.json",
  "title": "Live Evidence Drop Ledger",
  "description": "Quarantine-first staging ledger for raw external artifacts before LEAP, custody, response, intake, import, or live-floor computation may use them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_id",
    "schema_version",
    "created_at",
    "revision",
    "generated_by_tool",
    "intake_mode",
    "source_payload",
    "staged_payload",
    "classification",
    "mandatory_blocks",
    "admission_refs",
    "audit_trace",
    "decision",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "ledger_id": {"type": "string", "pattern": "^LEDL-[0-9]{4}-[A-Za-z0-9._:-]+$"},
    "schema_version": {"const": "live-evidence-drop-ledger-v0.1"},
    "created_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "generated_by_tool": {"type": "string"},
    "intake_mode": {
      "type": "string",
      "enum": ["ready-no-drop", "quarantine-control", "live-candidate-drop", "rejected"]
    },
    "source_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_locator",
        "source_kind",
        "locator_resolved",
        "source_sha256",
        "source_size_bytes",
        "source_mime_type",
        "copy_performed"
      ],
      "properties": {
        "original_locator": {"type": ["string", "null"]},
        "source_kind": {
          "type": "string",
          "enum": ["file-upload", "raw-email", "api-payload", "mcp-tool-output", "a2a-task-artifact", "federated-relay", "public-redaction", "unknown"]
        },
        "locator_resolved": {"type": "boolean"},
        "source_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "source_size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "source_mime_type": {"type": "string"},
        "copy_performed": {"type": "boolean"}
      }
    },
    "staged_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quarantine_locator",
        "quarantine_sha256",
        "quarantine_size_bytes",
        "immutable_copy_present",
        "raw_payload_retained",
        "redacted_copy_only",
        "contains_archive",
        "nested_archive_detected",
        "path_traversal_detected"
      ],
      "properties": {
        "quarantine_locator": {"type": ["string", "null"]},
        "quarantine_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "quarantine_size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "immutable_copy_present": {"type": "boolean"},
        "raw_payload_retained": {"type": "boolean"},
        "redacted_copy_only": {"type": "boolean"},
        "contains_archive": {"type": "boolean"},
        "nested_archive_detected": {"type": "boolean"},
        "path_traversal_detected": {"type": "boolean"}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_context",
        "artifact_state",
        "protocol_or_transport_source",
        "authority_claim_present",
        "subject_authorization_present",
        "nonhost_retention_present",
        "independent_timestamp_present",
        "can_open_leap_candidate_state",
        "can_create_response_record"
      ],
      "properties": {
        "collection_context": {
          "type": "string",
          "enum": ["live-counterparty", "institutional-dry-run", "controlled-fixture", "host-generated", "protocol-output", "unknown"]
        },
        "artifact_state": {
          "type": "string",
          "enum": ["no-drop", "quarantine-control-not-live", "live-candidate-unverified", "rejected"]
        },
        "protocol_or_transport_source": {"type": "boolean"},
        "authority_claim_present": {"type": "boolean"},
        "subject_authorization_present": {"type": "boolean"},
        "nonhost_retention_present": {"type": "boolean"},
        "independent_timestamp_present": {"type": "boolean"},
        "can_open_leap_candidate_state": {"type": "boolean"},
        "can_create_response_record": {"const": false}
      }
    },
    "mandatory_blocks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redacted_only_blocked",
        "tool_output_blocked",
        "protocol_transport_blocked",
        "archive_nested_zip_requires_manual_review",
        "path_traversal_blocked",
        "live_floor_delta_blocked",
        "downstream_objects_blocked"
      ],
      "properties": {
        "redacted_only_blocked": {"const": true},
        "tool_output_blocked": {"const": true},
        "protocol_transport_blocked": {"const": true},
        "archive_nested_zip_requires_manual_review": {"const": true},
        "path_traversal_blocked": {"const": true},
        "live_floor_delta_blocked": {"const": true},
        "downstream_objects_blocked": {"const": true}
      }
    },
    "admission_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linked_leap_packet_ref",
        "linked_custody_record_ref",
        "failed_gate_public_summary_ref"
      ],
      "properties": {
        "linked_leap_packet_ref": {"type": "string"},
        "linked_custody_record_ref": {"type": ["string", "null"]},
        "failed_gate_public_summary_ref": {"type": "string"}
      }
    },
    "audit_trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "event_type", "at", "actor", "evidence_ref", "can_satisfy_live_receipt"],
        "properties": {
          "event_id": {"type": "string"},
          "event_type": {
            "type": "string",
            "enum": ["ready", "source-resolved", "hash-recorded", "quarantine-copy-staged", "archive-scan", "classification", "blocked-before-leap"]
          },
          "at": {"type": "string", "format": "date-time"},
          "actor": {"type": "string"},
          "evidence_ref": {"type": "string"},
          "can_satisfy_live_receipt": {"const": false}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quarantine_admission", "reason", "blocked_actions", "next_actions"],
      "properties": {
        "quarantine_admission": {
          "type": "string",
          "enum": ["ready", "no-live-control-staged", "candidate-staged-not-admitted", "rejected"]
        },
        "reason": {"type": "string"},
        "blocked_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "next_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "public_summary": {"type": "string"},
    "no_live_floor_effect": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"intake_mode": {"const": "live-candidate-drop"}}, "required": ["intake_mode"]},
      "then": {
        "properties": {
          "source_payload": {"properties": {"locator_resolved": {"const": true}, "copy_performed": {"const": true}}},
          "staged_payload": {"properties": {"immutable_copy_present": {"const": true}, "raw_payload_retained": {"const": true}, "redacted_copy_only": {"const": false}}},
          "classification": {"properties": {"collection_context": {"const": "live-counterparty"}, "artifact_state": {"const": "live-candidate-unverified"}, "can_open_leap_candidate_state": {"const": true}}},
          "decision": {"properties": {"quarantine_admission": {"const": "candidate-staged-not-admitted"}}}
        }
      }
    },
    {
      "if": {"properties": {"intake_mode": {"const": "quarantine-control"}}, "required": ["intake_mode"]},
      "then": {
        "properties": {
          "classification": {"properties": {"can_open_leap_candidate_state": {"const": false}, "can_create_response_record": {"const": false}}},
          "decision": {"properties": {"quarantine_admission": {"const": "no-live-control-staged"}}}
        }
      }
    }
  ]
}
