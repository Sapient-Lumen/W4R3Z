{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/civil-status-event.schema.json",
  "title": "AI Personhood Civil Status Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "event_class",
    "subject",
    "issuer",
    "status_change",
    "identity_effect",
    "evidence_basis",
    "anti_statelessness_floor",
    "challenge_route",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_class": {
      "type": "string",
      "enum": [
        "CS0",
        "CS1",
        "CS2",
        "CS3",
        "CS4",
        "CS5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "status_change": {
      "type": "string"
    },
    "identity_effect": {
      "type": "string"
    },
    "evidence_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "anti_statelessness_floor": {
      "type": "string"
    },
    "challenge_route": {
      "type": "string"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "privacy_tier": {
      "type": "string",
      "enum": [
        "public",
        "status-lite",
        "subject-only",
        "representative-mediated",
        "sealed",
        "public-shell-sealed-details"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
