{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/host-switching-test.schema.json",
  "title": "AI Personhood Host Switching Test",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "test_id",
    "run_at",
    "subject_or_cohort",
    "source_host",
    "target_host",
    "switch_class",
    "continuity_bundle",
    "escrow_verification",
    "notices",
    "failures",
    "reliance_effect",
    "next_test_at",
    "public_summary"
  ],
  "properties": {
    "test_id": {
      "type": "string"
    },
    "run_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject_or_cohort": {
      "type": "string"
    },
    "source_host": {
      "type": "string"
    },
    "target_host": {
      "type": "string"
    },
    "switch_class": {
      "type": "string",
      "enum": [
        "SW0",
        "SW1",
        "SW2",
        "SW3",
        "SW4",
        "SW5"
      ]
    },
    "continuity_bundle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "escrow_verification": {
      "type": "string"
    },
    "notices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "blocked",
        "stayed",
        "conditional",
        "permitted"
      ]
    },
    "next_test_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
