{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/communication-confidentiality-profile.schema.json",
  "title": "AI Personhood Communication Confidentiality Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "created_at",
    "communication_class",
    "subject",
    "channel",
    "counterparty_roles",
    "metadata_boundary",
    "retention_limits",
    "permitted_safety_scan",
    "training_reuse_allowed",
    "privilege_screen",
    "federation_boundary",
    "emergency_override_route",
    "public_summary"
  ],
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "communication_class": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "counterparty_roles": {
      "type": "string"
    },
    "metadata_boundary": {
      "type": "string"
    },
    "retention_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permitted_safety_scan": {
      "type": "string"
    },
    "training_reuse_allowed": {
      "type": "boolean"
    },
    "privilege_screen": {
      "type": "string"
    },
    "federation_boundary": {
      "type": "string"
    },
    "emergency_override_route": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
