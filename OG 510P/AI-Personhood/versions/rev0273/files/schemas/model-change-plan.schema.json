{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/model-change-plan.schema.json",
  "title": "AI Personhood Model Change Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "created_at",
    "change_class",
    "target_system",
    "summary",
    "rights_domains_touched",
    "rollback_plan",
    "notice_plan",
    "fixture_plan",
    "decision",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "change_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "change_class": {
      "type": "string",
      "enum": [
        "CH0",
        "CH1",
        "CH2",
        "CH3",
        "CH4",
        "CH5"
      ]
    },
    "target_system": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "rights_domains_touched": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rollback_plan": {
      "type": "string"
    },
    "notice_plan": {
      "type": "string"
    },
    "fixture_plan": {
      "type": "string"
    },
    "emergency_basis": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "conditional",
        "stayed",
        "blocked",
        "emergency-temporary"
      ]
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
