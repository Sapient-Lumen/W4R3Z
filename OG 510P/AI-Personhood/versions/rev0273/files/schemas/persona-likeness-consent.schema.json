    "consent_id",
    "created_at",
    "persona_class",
    "subject",
    "identity_aspect",
    "authorized_context",
    "duration",
    "revocation_route",
    "compensation_or_noncommercial_status",
    "conflict_screen",
    "subject_authorized",
    "public_notice",
    "public_summary"
