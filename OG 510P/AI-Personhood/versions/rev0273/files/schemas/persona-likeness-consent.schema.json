  "properties": {
    "consent_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "persona_class": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "identity_aspect": {
      "type": "string"
    },
    "authorized_context": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "revocation_route": {
      "type": "string"
    },
    "compensation_or_noncommercial_status": {
      "type": "string"
    },
    "conflict_screen": {
      "type": "string"
    },
    "subject_authorized": {
      "type": "boolean"
    },
    "public_notice": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
