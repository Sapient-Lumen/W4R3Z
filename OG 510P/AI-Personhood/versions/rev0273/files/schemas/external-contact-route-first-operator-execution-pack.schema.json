{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-route-first-operator-execution-pack.schema.json",
  "title": "External Contact Route-First Operator Execution Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_id",
    "schema_version",
    "revision",
    "created_at",
    "pack_state",
    "source_refs",
    "route_target",
    "exact_route_first_message",
    "human_authority_slots",
    "private_vault_slots",
    "execution_checklist",
    "stage_two_boundary",
    "nonclosure_controls",
    "operational_state",
    "downstream_locks",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "pack_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "external-contact-route-first-operator-execution-pack-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "pack_state": {
      "enum": [
        "prepared-not-authorized-not-sent"
      ]
    },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_first_preflight",
        "route_first_send_capture_gate",
        "route_first_reply_disposition",
        "stage_two_authorization_gate",
        "route_first_branch_hold",
        "route_first_human_sender_authority_precommit",
        "human_sender_authority_precommit",
        "current_public_locator_recheck",
        "hash_recompute_dry_run",
        "transport_capture_plan",
        "operating_board"
      ],
      "properties": {
        "route_first_preflight": {
          "type": "string"
        },
        "route_first_send_capture_gate": {
          "type": "string"
        },
        "route_first_reply_disposition": {
          "type": "string"
        },
        "stage_two_authorization_gate": {
          "type": "string"
        },
        "route_first_branch_hold": {
          "type": "string"
        },
        "human_sender_authority_precommit": {
          "type": "string"
        },
        "current_public_locator_recheck": {
          "type": "string"
        },
        "hash_recompute_dry_run": {
          "type": "string"
        },
        "transport_capture_plan": {
          "type": "string"
        },
        "operating_board": {
          "type": "string"
        },
        "route_first_human_sender_authority_precommit": {
          "type": "string"
        }
      }
    },
    "route_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_name",
        "recipient",
        "public_source_url",
        "route_kind",
        "send_time_recheck_required",
        "locator_is_not_consent_or_authority"
      ],
      "properties": {
        "organization_name": {
          "type": "string"
        },
        "recipient": {
          "const": "info@raicollab.org"
        },
        "public_source_url": {
          "type": "string"
        },
        "route_kind": {
          "const": "collaboration-routing-inquiry-not-incident-submission"
        },
        "send_time_recheck_required": {
          "const": true
        },
        "locator_is_not_consent_or_authority": {
          "const": true
        }
      }
    },
    "exact_route_first_message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "body_ref",
        "mail_ready_draft_ref",
        "body_word_count",
        "body_sha256",
        "mail_ready_draft_sha256",
        "attachments_included",
        "stage_two_payload_attached",
        "draft_may_be_edited_after_signature",
        "draft_may_start_response_clock"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 12
        },
        "body_ref": {
          "type": "string"
        },
        "mail_ready_draft_ref": {
          "type": "string"
        },
        "body_word_count": {
          "type": "integer",
          "minimum": 60,
          "maximum": 180
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mail_ready_draft_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attachments_included": {
          "const": false
        },
        "stage_two_payload_attached": {
          "const": false
        },
        "draft_may_be_edited_after_signature": {
          "const": false
        },
        "draft_may_start_response_clock": {
          "const": false
        }
      }
    },
    "human_authority_slots": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "label",
          "required_before_send",
          "current_value",
          "may_be_satisfied_inside_public_release",
          "evidence_required"
        ],
        "properties": {
          "slot_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "required_before_send": {
            "const": true
          },
          "current_value": {
            "type": "null"
          },
          "may_be_satisfied_inside_public_release": {
            "const": false
          },
          "evidence_required": {
            "type": "string",
            "minLength": 12
          }
        }
      }
    },
    "private_vault_slots": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "purpose",
          "required_before_send_or_reply",
          "public_value",
          "raw_private_material_allowed_in_release",
          "placeholder_may_satisfy_custody"
        ],
        "properties": {
          "slot_id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "required_before_send_or_reply": {
            "const": true
          },
          "public_value": {
            "const": null
          },
          "raw_private_material_allowed_in_release": {
            "const": false
          },
          "placeholder_may_satisfy_custody": {
            "const": false
          }
        }
      }
    },
    "execution_checklist": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "action",
          "required_before_or_after",
          "completion_state",
          "may_create_contact_or_floor"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "minLength": 12
          },
          "required_before_or_after": {
            "enum": [
              "before-send",
              "at-send",
              "after-send",
              "after-reply"
            ]
          },
          "completion_state": {
            "enum": [
              "prepared",
              "blocked",
              "not-applicable-until-send",
              "not-applicable-until-reply"
            ]
          },
          "may_create_contact_or_floor": {
            "const": false
          }
        }
      }
    },
    "stage_two_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_two_payload_manifest_ref",
        "stage_two_send_authorized_now",
        "willing_reply_may_auto_send_stage_two",
        "fresh_authorization_required",
        "fresh_hashes_required"
      ],
      "properties": {
        "stage_two_payload_manifest_ref": {
          "type": "string"
        },
        "stage_two_send_authorized_now": {
          "const": false
        },
        "willing_reply_may_auto_send_stage_two": {
          "const": false
        },
        "fresh_authorization_required": {
          "const": true
        },
        "fresh_hashes_required": {
          "const": true
        }
      }
    },
    "nonclosure_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_pack_may_close_first_artifact_tasks",
        "do_not_close_by_narrative",
        "operating_board_active_count_required",
        "operating_board_active_count_observed"
      ],
      "properties": {
        "operator_pack_may_close_first_artifact_tasks": {
          "const": false
        },
        "do_not_close_by_narrative": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "operating_board_active_count_required": {
          "const": 7
        },
        "operating_board_active_count_observed": {
          "const": 7
        }
      }
    },
    "operational_state": {
      "type": "object",
      "additionalProperties": {
        "const": false
      },
      "minProperties": 8
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": {
        "const": false
      },
      "minProperties": 10
    },
    "public_summary": {
      "type": "string",
      "minLength": 80
    },
    "no_live_floor_effect": {
      "const": true
    }
  }
}
