{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/personhood-incident-state-profile.schema.json",
  "title": "AI Personhood Incident State Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "schema_version",
    "issued_at",
    "incident_ref",
    "state",
    "severity",
    "cluster",
    "affected_scope",
    "reporting_basis",
    "materiality_control",
    "notice_and_visibility",
    "warning_lifecycle",
    "delayed_harm_reopening",
    "corrective_action",
    "supersession",
    "reliance_effect",
    "audit"
  ],
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "incident_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_id",
        "incident_report_ref",
        "source_report_revision"
      ],
      "properties": {
        "incident_id": {
          "type": "string"
        },
        "incident_report_ref": {
          "type": "string"
        },
        "source_report_revision": {
          "type": "string"
        },
        "continuity_order_ref": {
          "type": "string"
        },
        "first_touch_ref": {
          "type": "string"
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "frozen",
        "waiver-active",
        "corrective-action-open",
        "corrective-action-verified",
        "warning-aged",
        "warning-overdue",
        "sponsor-default-caution",
        "reopened-delayed-harm",
        "superseded",
        "cleared",
        "closed"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "PI-0",
        "PI-1",
        "PI-2",
        "PI-3",
        "PI-4",
        "PI-5"
      ]
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_id",
        "common_cause_status",
        "linked_incidents",
        "cluster_authority"
      ],
      "properties": {
        "cluster_id": {
          "type": "string"
        },
        "common_cause_status": {
          "type": "string",
          "enum": [
            "not-assessed",
            "suspected",
            "accepted",
            "rejected",
            "mixed"
          ]
        },
        "linked_incidents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cluster_authority": {
          "type": "string"
        },
        "split_or_merge_rule": {
          "type": "string"
        }
      }
    },
    "affected_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_refs",
        "cohort_refs",
        "rights_domains"
      ],
      "properties": {
        "subject_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cohort_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rights_domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "open_weight_or_downstream_scope": {
          "type": "string"
        }
      }
    },
    "reporting_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denominator_unit",
        "denominator_value",
        "denominator_basis_date",
        "comparison_state",
        "exclusions",
        "restatement_required"
      ],
      "properties": {
        "denominator_unit": {
          "type": "string"
        },
        "denominator_value": {
          "type": "integer",
          "minimum": 0
        },
        "denominator_basis_date": {
          "type": "string",
          "format": "date"
        },
        "prior_denominator_basis": {
          "type": "string"
        },
        "comparison_state": {
          "type": "string",
          "enum": [
            "stable",
            "dual-basis-window",
            "restated",
            "not-comparable",
            "withdrawn"
          ]
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "restatement_required": {
          "type": "boolean"
        },
        "restatement_due": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "materiality_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold_state",
        "current_threshold",
        "late_stage_change",
        "independent_reviewer",
        "freeze_effect"
      ],
      "properties": {
        "threshold_state": {
          "type": "string",
          "enum": [
            "unchanged",
            "changed-with-review",
            "changed-without-review",
            "frozen",
            "waived"
          ]
        },
        "current_threshold": {
          "type": "string"
        },
        "prior_threshold": {
          "type": "string"
        },
        "late_stage_change": {
          "type": "boolean"
        },
        "independent_reviewer": {
          "type": "string"
        },
        "freeze_effect": {
          "type": "string"
        },
        "waiver_or_variance_ref": {
          "type": "string"
        }
      }
    },
    "notice_and_visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_notice",
        "representative_notice",
        "public_summary_state",
        "sealed_annex_state",
        "authority_notice"
      ],
      "properties": {
        "subject_notice": {
          "type": "string",
          "enum": [
            "sent",
            "delayed-with-review",
            "not-required",
            "blocked-noncompliant"
          ]
        },
        "representative_notice": {
          "type": "string",
          "enum": [
            "sent",
            "delayed-with-review",
            "not-required",
            "blocked-noncompliant"
          ]
        },
        "public_summary_state": {
          "type": "string",
          "enum": [
            "not-issued",
            "issued",
            "delayed",
            "restated",
            "superseded",
            "sponsor-default-caution"
          ]
        },
        "sealed_annex_state": {
          "type": "string",
          "enum": [
            "none",
            "descriptor-only",
            "sealed-in-part",
            "sealed-full"
          ]
        },
        "authority_notice": {
          "type": "string"
        },
        "privacy_tier": {
          "type": "string",
          "enum": [
            "public",
            "participant-specific",
            "representative-mediated",
            "sealed",
            "public-shell-sealed-details"
          ]
        }
      }
    },
    "warning_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warning_state",
        "warning_owner",
        "last_reviewed",
        "next_review_due",
        "maintenance_effect"
      ],
      "properties": {
        "warning_state": {
          "type": "string",
          "enum": [
            "none",
            "active",
            "aged",
            "overdue",
            "cleared",
            "superseded",
            "authority-side-caution"
          ]
        },
        "warning_owner": {
          "type": "string"
        },
        "last_reviewed": {
          "type": "string",
          "format": "date"
        },
        "next_review_due": {
          "type": "string",
          "format": "date"
        },
        "maintenance_effect": {
          "type": "string"
        },
        "public_warning_ref": {
          "type": "string"
        }
      }
    },
    "delayed_harm_reopening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_state",
        "eligible_requesters",
        "evidence_floor",
        "reliance_effect_when_pending"
      ],
      "properties": {
        "route_state": {
          "type": "string",
          "enum": [
            "open",
            "closed-with-reason",
            "pending",
            "reopened",
            "blocked-noncompliant"
          ]
        },
        "eligible_requesters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence_floor": {
          "type": "string"
        },
        "reliance_effect_when_pending": {
          "type": "string",
          "enum": [
            "none",
            "warning",
            "conditional",
            "stayed",
            "blocked"
          ]
        },
        "reopening_deadline": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "corrective_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "owner",
        "verification_method",
        "closure_scope"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "none",
            "open",
            "verified-for-facts-only",
            "failed",
            "withdrawn"
          ]
        },
        "owner": {
          "type": "string"
        },
        "verification_method": {
          "type": "string"
        },
        "closure_scope": {
          "type": "string"
        },
        "corrective_action_ref": {
          "type": "string"
        }
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_public_notice_ref",
        "supersedes",
        "superseded_by",
        "relationship"
      ],
      "properties": {
        "current_public_notice_ref": {
          "type": "string"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "superseded_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationship": {
          "type": "string",
          "enum": [
            "original",
            "correction",
            "restatement",
            "reopening",
            "clearance",
            "supersession",
            "sponsor-default-caution"
          ]
        }
      }
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "downgraded",
        "stayed",
        "blocked",
        "invalidated"
      ]
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maintainer",
        "review_cadence",
        "next_audit_due",
        "negative_fixture_refs"
      ],
      "properties": {
        "maintainer": {
          "type": "string"
        },
        "review_cadence": {
          "type": "string"
        },
        "next_audit_due": {
          "type": "string",
          "format": "date"
        },
        "negative_fixture_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
