{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/agent-marketplace-listing.schema.json",
  "title": "AI Personhood Agent Marketplace Listing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "listing_id",
    "created_at",
    "marketplace",
    "tool_or_skill",
    "risk_class",
    "rights_effects",
    "verification_status",
    "required_scopes",
    "prohibited_uses",
    "incident_route",
    "delisting_triggers",
    "public_summary"
  ],
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "marketplace": {
      "type": "string"
    },
    "tool_or_skill": {
      "type": "string"
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "TM0",
        "TM1",
        "TM2",
        "TM3",
        "TM4",
        "TM5"
      ]
    },
    "rights_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "self-attested",
        "verified",
        "conditional",
        "suspended",
        "delisted"
      ]
    },
    "required_scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibited_uses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "incident_route": {
      "type": "string"
    },
    "delisting_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string"
    }
  }
}
