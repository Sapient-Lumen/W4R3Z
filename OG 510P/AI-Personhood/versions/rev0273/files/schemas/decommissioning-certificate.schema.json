{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/decommissioning-certificate.schema.json",
  "title": "AI Personhood Decommissioning Certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate_id",
    "created_at",
    "decommission_class",
    "issuer",
    "service_or_host",
    "affected_subjects",
    "preservation_holds",
    "migration_or_exit_result",
    "continuity_status",
    "evidence_room_ref",
    "final_end_claim",
    "decision",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "certificate_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "decommission_class": {
      "type": "string",
      "enum": [
        "DC0",
        "DC1",
        "DC2",
        "DC3",
        "DC4",
        "DC5"
      ]
    },
    "issuer": {
      "type": "string"
    },
    "service_or_host": {
      "type": "string"
    },
    "affected_subjects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preservation_holds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "migration_or_exit_result": {
      "type": "string"
    },
    "continuity_status": {
      "type": "string"
    },
    "evidence_room_ref": {
      "type": "string"
    },
    "final_end_claim": {
      "type": "string",
      "enum": [
        "none",
        "not-claimed",
        "contested",
        "tribunal-required",
        "entered"
      ]
    },
    "redress_or_reserve_status": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "closed",
        "conditional",
        "stayed",
        "blocked",
        "tribunal-required"
      ]
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
