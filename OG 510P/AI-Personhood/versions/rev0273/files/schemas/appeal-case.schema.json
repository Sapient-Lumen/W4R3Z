{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/appeal-case.schema.json",
  "title": "AI Personhood Appeal Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "appeal_id",
    "docket_class",
    "filed_at",
    "appellant",
    "subject",
    "challenged_decision",
    "grounds",
    "requested_relief",
    "stay_request",
    "record_access",
    "status"
  ],
  "properties": {
    "appeal_id": {
      "type": "string",
      "minLength": 3
    },
    "docket_class": {
      "type": "string",
      "enum": [
        "AP-INTAKE",
        "AP-STATUS",
        "AP-CAPACITY",
        "AP-CONTINUITY",
        "AP-CONTAIN",
        "AP-MIGRATE",
        "AP-INCIDENT",
        "AP-REMEDY",
        "AP-VERIFY",
        "AP-SEALED"
      ]
    },
    "filed_at": {
      "type": "string",
      "format": "date-time"
    },
    "appellant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "identifier"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "contact_channel": {
          "type": "string"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "status"
      ],
      "properties": {
        "subject_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "representative_id": {
          "type": "string"
        }
      }
    },
    "challenged_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "issuer",
        "issued_at",
        "decision_class",
        "summary"
      ],
      "properties": {
        "decision_id": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision_class": {
          "type": "string",
          "enum": [
            "D0",
            "D1",
            "D2",
            "D3",
            "D4",
            "D5",
            "D6"
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "grounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "requested_relief": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "stay_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "irreparable_harm",
        "scope"
      ],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "irreparable_harm": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duration_requested": {
          "type": "string"
        }
      }
    },
    "record_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_shell_requested",
        "sealed_annex_challenge"
      ],
      "properties": {
        "public_shell_requested": {
          "type": "boolean"
        },
        "sealed_annex_challenge": {
          "type": "boolean"
        },
        "requested_materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "linked_evidence_bundle_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "filed",
        "intake-check",
        "stayed",
        "under-review",
        "decided",
        "remanded",
        "closed",
        "reopened"
      ]
    }
  }
}
