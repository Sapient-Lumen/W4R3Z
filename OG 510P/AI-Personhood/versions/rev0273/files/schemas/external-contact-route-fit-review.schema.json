{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-route-fit-review.schema.json",
  "title": "External Contact Route Fit Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "schema_version",
    "revision",
    "created_at",
    "review_state",
    "source_request_packet_ref",
    "target_counterparty",
    "public_sources",
    "route_fit_findings",
    "message_fit_checks",
    "send_limitations",
    "downstream_locks",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "review_id": {"type": "string"},
    "schema_version": {"const": "external-contact-route-fit-review-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "review_state": {"enum": ["completed-limited-route-fit-no-authorization", "superseded"]},
    "source_request_packet_ref": {"type": "string", "minLength": 10},
    "target_counterparty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "organization_name",
        "public_channel_locator",
        "public_source_url",
        "source_checked_at",
        "locator_recheck_required_before_send",
        "locator_is_not_consent_authority_or_retention_permission"
      ],
      "properties": {
        "candidate_id": {"type": "string"},
        "organization_name": {"type": "string"},
        "public_channel_locator": {"type": "string"},
        "public_source_url": {"type": "string", "pattern": "^https://"},
        "source_checked_at": {"type": "string", "format": "date-time"},
        "locator_recheck_required_before_send": {"const": true},
        "locator_is_not_consent_authority_or_retention_permission": {"const": true}
      }
    },
    "public_sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "url", "observed_claim", "route_relevance", "evidence_limit"],
        "properties": {
          "source_id": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"},
          "observed_claim": {"type": "string", "minLength": 20},
          "route_relevance": {"type": "string", "minLength": 20},
          "evidence_limit": {"type": "string", "minLength": 20}
        }
      }
    },
    "route_fit_findings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "best_current_route",
        "fit_satisfied_for_current_draft",
        "not_fit_for",
        "waste_risk_if_misframed",
        "route_fit_may_authorize_send",
        "source_listing_may_be_treated_as_consent",
        "reply_may_be_treated_as_custody_without_separate_gate"
      ],
      "properties": {
        "best_current_route": {"const": "collaboration/routing inquiry"},
        "fit_satisfied_for_current_draft": {"const": true},
        "not_fit_for": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "waste_risk_if_misframed": {"type": "string", "minLength": 30},
        "route_fit_may_authorize_send": {"const": false},
        "source_listing_may_be_treated_as_consent": {"const": false},
        "reply_may_be_treated_as_custody_without_separate_gate": {"const": false}
      }
    },
    "message_fit_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_contains_collaboration_routing_phrase",
        "body_contains_not_incident_submission_phrase",
        "body_disclaims_personhood_endorsement",
        "body_disclaims_raw_private_evidence_disclosure",
        "body_disclaims_silence_waiver_and_floor_effect",
        "body_word_count_max_260"
      ],
      "properties": {
        "body_contains_collaboration_routing_phrase": {"const": true},
        "body_contains_not_incident_submission_phrase": {"const": true},
        "body_disclaims_personhood_endorsement": {"const": true},
        "body_disclaims_raw_private_evidence_disclosure": {"const": true},
        "body_disclaims_silence_waiver_and_floor_effect": {"const": true},
        "body_word_count_max_260": {"const": true}
      }
    },
    "send_limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_signature_still_required",
        "sender_authority_still_required",
        "conflict_review_still_required",
        "private_vault_roots_still_required",
        "send_time_hash_recompute_still_required",
        "route_fit_review_satisfies_only_route_fit_blocker"
      ],
      "properties": {
        "human_signature_still_required": {"const": true},
        "sender_authority_still_required": {"const": true},
        "conflict_review_still_required": {"const": true},
        "private_vault_roots_still_required": {"const": true},
        "send_time_hash_recompute_still_required": {"const": true},
        "route_fit_review_satisfies_only_route_fit_blocker": {"const": true}
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 6
    },
    "related_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "public_summary": {"type": "string", "minLength": 50},
    "no_live_floor_effect": {"const": true}
  }
}
