{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-execution-record.schema.json",
  "title": "External Contact Execution Record",
  "description": "Dispatch, no-response, decline, response-routing, and candidate-specific authorization record for the first genuine external-contact attempt without creating custody, intake, import, status, waiver, adverse inference, or live-floor effect. v0.8 adds an explicit delivery-status/DSN record binding; v0.7 adds an explicit send-trace-shell binding and keeps v0.6 mail-ready/send-proof bindings: v0.6 adds mail-ready draft and send-proof record bindings so a concrete .eml draft cannot be laundered into dispatch, transport proof, or a response clock.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "schema_version",
    "revision",
    "created_at",
    "execution_state",
    "source_packet_ref",
    "counterparty_selection_dossier_ref",
    "send_proof_acceptance_gate",
    "dispatch_authorization_card_ref",
    "mail_ready_draft_ref",
    "send_proof_record_ref",
    "send_trace_shell_ref",
    "delivery_status_record_ref",
    "counterparty_selection_shortlist",
    "dispatch_plan",
    "dispatch_preflight",
    "sent_evidence",
    "response_window",
    "received_artifact_route",
    "public_failed_gate_shell",
    "downstream_locks",
    "linked_queue_ids",
    "related_surfaces",
    "no_live_floor_effect"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^ECER-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "external-contact-execution-record-v0.8"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_state": {
      "type": "string",
      "enum": [
        "not-sent-ready",
        "no-send-recorded",
        "sent-awaiting-response",
        "declined",
        "no-response-window-open",
        "no-response-failed-gate-shell-ready",
        "response-received-quarantined",
        "superseded"
      ]
    },
    "source_packet_ref": {
      "type": "string"
    },
    "dispatch_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_channel",
        "selected_counterparty_kind",
        "selected_counterparty_contact",
        "earliest_send_date",
        "pre_send_checks",
        "request_trace_to_capture",
        "human_confirmation_required"
      ],
      "properties": {
        "selected_channel": {
          "type": "string",
          "minLength": 3
        },
        "selected_counterparty_kind": {
          "type": "string",
          "enum": [
            "provider",
            "lab",
            "auditor",
            "regulator",
            "clinic",
            "civil-society",
            "other"
          ]
        },
        "selected_counterparty_contact": {
          "type": [
            "string",
            "null"
          ]
        },
        "earliest_send_date": {
          "type": "string",
          "format": "date"
        },
        "pre_send_checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_mentions_no_status_claim",
            "no_trade_secret_request",
            "no_private_raw_bytes_in_release",
            "recipient_can_decline_without_adverse_inference",
            "reply_staged_before_publication",
            "no_live_floor_effect_reconfirmed"
          ],
          "properties": {
            "request_mentions_no_status_claim": {
              "const": true
            },
            "no_trade_secret_request": {
              "const": true
            },
            "no_private_raw_bytes_in_release": {
              "const": true
            },
            "recipient_can_decline_without_adverse_inference": {
              "const": true
            },
            "reply_staged_before_publication": {
              "const": true
            },
            "no_live_floor_effect_reconfirmed": {
              "const": true
            }
          }
        },
        "request_trace_to_capture": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string"
          }
        },
        "human_confirmation_required": {
          "const": true
        }
      }
    },
    "sent_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sent_at",
        "sent_by_role",
        "transport_proof_ref",
        "message_id_or_header_ref",
        "sent_claim_may_create_receipt",
        "sent_claim_may_create_custody",
        "redaction_policy"
      ],
      "properties": {
        "sent_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "sent_by_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "transport_proof_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "message_id_or_header_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "sent_claim_may_create_receipt": {
          "const": false
        },
        "sent_claim_may_create_custody": {
          "const": false
        },
        "redaction_policy": {
          "type": "string",
          "minLength": 40
        }
      }
    },
    "response_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deadline_days",
        "deadline_at",
        "current_state",
        "silence_is_not_waiver",
        "decline_is_not_adverse_inference",
        "no_response_public_shell_allowed"
      ],
      "properties": {
        "deadline_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "deadline_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "current_state": {
          "type": "string",
          "enum": [
            "not-started",
            "open",
            "declined",
            "expired-no-response",
            "response-received"
          ]
        },
        "silence_is_not_waiver": {
          "const": true
        },
        "decline_is_not_adverse_inference": {
          "const": true
        },
        "no_response_public_shell_allowed": {
          "const": true
        }
      }
    },
    "received_artifact_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_payload_must_stay_outside_release",
        "stage_tool",
        "allowed_next_surfaces",
        "redacted_copy_not_custody",
        "protocol_output_not_authority",
        "response_does_not_open_import"
      ],
      "properties": {
        "raw_payload_must_stay_outside_release": {
          "const": true
        },
        "stage_tool": {
          "const": "tools/stage_live_evidence_drop.py"
        },
        "allowed_next_surfaces": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "redacted_copy_not_custody": {
          "const": true
        },
        "protocol_output_not_authority": {
          "const": true
        },
        "response_does_not_open_import": {
          "const": true
        }
      }
    },
    "public_failed_gate_shell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_allowed",
        "shell_required_if_declined_or_silence",
        "required_public_fields",
        "forbidden_public_fields",
        "public_shell_not_adverse_inference"
      ],
      "properties": {
        "shell_allowed": {
          "const": true
        },
        "shell_required_if_declined_or_silence": {
          "const": true
        },
        "required_public_fields": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        },
        "forbidden_public_fields": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "public_shell_not_adverse_inference": {
          "const": true
        }
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_create_custody_record",
        "may_create_response_record",
        "may_create_intake_record",
        "may_create_import_gate",
        "may_increment_live_floor",
        "may_claim_status_or_waiver",
        "may_publish_raw_payload"
      ],
      "properties": {
        "may_create_custody_record": {
          "const": false
        },
        "may_create_response_record": {
          "const": false
        },
        "may_create_intake_record": {
          "const": false
        },
        "may_create_import_gate": {
          "const": false
        },
        "may_increment_live_floor": {
          "const": false
        },
        "may_claim_status_or_waiver": {
          "const": false
        },
        "may_publish_raw_payload": {
          "const": false
        }
      }
    },
    "linked_queue_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "related_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "no_live_floor_effect": {
      "const": true
    },
    "no_send_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_at",
        "decision_by_role",
        "reason_code",
        "reason",
        "blocked_send",
        "no_response_clock_started",
        "counterparty_contacted",
        "reopen_conditions",
        "public_summary"
      ],
      "properties": {
        "decision_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision_by_role": {
          "type": "string",
          "minLength": 3
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "no_selected_counterparty",
            "no_named_counterparty",
            "no_operator_authority",
            "safety_or_privacy_block",
            "counterparty_channel_unavailable",
            "message_not_ready",
            "other"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 40
        },
        "blocked_send": {
          "const": true
        },
        "no_response_clock_started": {
          "const": true
        },
        "counterparty_contacted": {
          "const": false
        },
        "reopen_conditions": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "public_summary": {
          "type": "string",
          "minLength": 40
        }
      }
    },
    "dispatch_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight_state",
        "source_rendered_message_ref",
        "final_outgoing_body_sha256",
        "request_deadline_days",
        "execution_deadline_days",
        "deadline_days_match_request",
        "counterparty_selection_dossier_present",
        "selected_counterparty_contact_present",
        "public_channel_locator_present",
        "sender_authority_present",
        "send_permitted_now",
        "blocker_codes",
        "minimal_unblock_requirements",
        "response_clock_may_start",
        "no_response_shell_may_be_prepared",
        "preflight_may_substitute_for_dispatch",
        "send_trace_shell_present",
        "send_trace_shell_has_transport_proof"
      ],
      "properties": {
        "preflight_state": {
          "type": "string",
          "enum": [
            "blocked-missing-counterparty-and-authority",
            "not-sent-ready",
            "sendable-with-human-confirmation",
            "sent-proof-required",
            "superseded",
            "blocked-missing-human-authorization-and-vault"
          ]
        },
        "source_rendered_message_ref": {
          "type": "string",
          "minLength": 10
        },
        "final_outgoing_body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "request_deadline_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "execution_deadline_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "deadline_days_match_request": {
          "const": true
        },
        "selected_counterparty_contact_present": {
          "type": "boolean"
        },
        "public_channel_locator_present": {
          "type": "boolean"
        },
        "sender_authority_present": {
          "type": "boolean"
        },
        "send_permitted_now": {
          "type": "boolean"
        },
        "blocker_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "no_selected_counterparty",
              "no_named_counterparty",
              "no_verified_channel_locator",
              "no_sender_authority",
              "message_safety_block",
              "privacy_block",
              "packet_stale",
              "other",
              "human_dispatch_authorization_missing",
              "no_raw_reply_vault_root",
              "dispatch_authorization_card_unsigned",
              "no_transport_proof",
              "mail_ready_draft_is_not_transport_proof",
              "send_trace_shell_missing_transport",
              "delivery_status_record_has_no_delivery_event"
            ]
          }
        },
        "minimal_unblock_requirements": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "response_clock_may_start": {
          "const": false
        },
        "no_response_shell_may_be_prepared": {
          "const": false
        },
        "preflight_may_substitute_for_dispatch": {
          "const": false
        },
        "counterparty_selection_dossier_present": {
          "const": true
        },
        "send_trace_shell_present": {
          "const": true
        },
        "send_trace_shell_has_transport_proof": {
          "const": false
        }
      }
    },
    "counterparty_selection_shortlist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shortlist_state",
        "selection_scope",
        "candidates",
        "shortlist_locks",
        "recommended_next_action"
      ],
      "properties": {
        "shortlist_state": {
          "type": "string",
          "enum": [
            "public-candidates-identified-not-selected",
            "selected-for-send-authorization",
            "superseded"
          ]
        },
        "selection_scope": {
          "type": "string",
          "minLength": 80
        },
        "candidates": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "organization_name",
              "counterparty_kind",
              "public_source_url",
              "public_channel_locator",
              "channel_type",
              "fit_reason",
              "independence_basis",
              "due_diligence_status",
              "selection_status",
              "contact_not_sent",
              "response_clock_may_start"
            ],
            "properties": {
              "candidate_id": {
                "type": "string"
              },
              "organization_name": {
                "type": "string",
                "minLength": 2
              },
              "counterparty_kind": {
                "type": "string",
                "enum": [
                  "provider",
                  "lab",
                  "auditor",
                  "regulator",
                  "clinic",
                  "civil-society",
                  "other"
                ]
              },
              "public_source_url": {
                "type": "string",
                "minLength": 10
              },
              "public_channel_locator": {
                "type": "string",
                "minLength": 6
              },
              "channel_type": {
                "type": "string",
                "enum": [
                  "public-contact-page",
                  "public-email",
                  "public-web-form",
                  "public-github-issue",
                  "public-feedback-form",
                  "other"
                ]
              },
              "fit_reason": {
                "type": "string",
                "minLength": 50
              },
              "independence_basis": {
                "type": "string",
                "minLength": 50
              },
              "due_diligence_status": {
                "type": "string",
                "enum": [
                  "public-source-only-not-verified",
                  "requires-conflict-check",
                  "rejected-conflict-known",
                  "verified-independent"
                ]
              },
              "selection_status": {
                "type": "string",
                "enum": [
                  "candidate-not-selected",
                  "selected-awaiting-authority",
                  "rejected"
                ]
              },
              "contact_not_sent": {
                "const": true
              },
              "response_clock_may_start": {
                "const": false
              }
            }
          }
        },
        "shortlist_locks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "listing_is_not_contact",
            "listing_is_not_authority",
            "listing_is_not_consent",
            "no_response_clock_started",
            "no_failed_gate_shell_against_uncontacted_candidate",
            "human_selection_required"
          ],
          "properties": {
            "listing_is_not_contact": {
              "const": true
            },
            "listing_is_not_authority": {
              "const": true
            },
            "listing_is_not_consent": {
              "const": true
            },
            "no_response_clock_started": {
              "const": true
            },
            "no_failed_gate_shell_against_uncontacted_candidate": {
              "const": true
            },
            "human_selection_required": {
              "const": true
            }
          }
        },
        "recommended_next_action": {
          "type": "string",
          "minLength": 60
        }
      }
    },
    "counterparty_selection_dossier_ref": {
      "type": "string",
      "minLength": 10
    },
    "dispatch_authorization_card_ref": {
      "type": "string",
      "minLength": 10
    },
    "send_proof_acceptance_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_card_present",
        "selected_candidate_id",
        "selected_public_channel_locator",
        "final_body_hash_matches_authorization_card",
        "transport_proof_required_before_sent_state",
        "sent_state_rejected_without_transport_proof",
        "response_clock_rejected_without_sent_at",
        "auto_ack_must_route_to_triage",
        "all_send_proof_present_now",
        "may_start_response_clock_now",
        "send_proof_record_present",
        "mail_ready_draft_present",
        "mail_ready_draft_rejected_as_transport_proof",
        "send_trace_shell_present",
        "message_id_alone_rejected_as_response_clock",
        "delivery_status_record_present",
        "dsn_or_bounce_rejected_as_counterparty_response",
        "failed_or_delayed_delivery_blocks_no_response_clock"
      ],
      "properties": {
        "authorization_card_present": {
          "const": true
        },
        "selected_candidate_id": {
          "type": "string",
          "minLength": 3
        },
        "selected_public_channel_locator": {
          "type": "string",
          "minLength": 6
        },
        "final_body_hash_matches_authorization_card": {
          "const": true
        },
        "transport_proof_required_before_sent_state": {
          "const": true
        },
        "sent_state_rejected_without_transport_proof": {
          "const": true
        },
        "response_clock_rejected_without_sent_at": {
          "const": true
        },
        "auto_ack_must_route_to_triage": {
          "const": true
        },
        "all_send_proof_present_now": {
          "const": false
        },
        "may_start_response_clock_now": {
          "const": false
        },
        "send_proof_record_present": {
          "const": true
        },
        "mail_ready_draft_present": {
          "const": true
        },
        "mail_ready_draft_rejected_as_transport_proof": {
          "const": true
        },
        "send_trace_shell_present": {
          "const": true
        },
        "message_id_alone_rejected_as_response_clock": {
          "const": true
        },
        "delivery_status_record_present": {
          "const": true
        },
        "dsn_or_bounce_rejected_as_counterparty_response": {
          "const": true
        },
        "failed_or_delayed_delivery_blocks_no_response_clock": {
          "const": true
        }
      }
    },
    "mail_ready_draft_ref": {
      "type": "string",
      "minLength": 10
    },
    "send_proof_record_ref": {
      "type": "string",
      "minLength": 10
    },
    "send_trace_shell_ref": {
      "type": "string",
      "minLength": 10
    },
    "delivery_status_record_ref": {
      "type": "string",
      "minLength": 10
    }
  }
}
