{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-hash-recompute-dry-run.schema.json",
  "title": "External Contact Hash Recompute Dry Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "schema_version",
    "revision",
    "created_at",
    "dry_run_state",
    "source_refs",
    "computed_bindings",
    "send_time_policy",
    "operational_state",
    "downstream_locks",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "report_id": {"type": "string"},
    "schema_version": {"const": "external-contact-hash-recompute-dry-run-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "dry_run_state": {"enum": ["current-public-tree-hashes-recomputed-no-send", "superseded"]},
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_packet", "mail_ready_draft", "public_payload_manifest", "one_page_ask", "machine_checkable_request_packet"],
      "properties": {
        "request_packet": {"type": "string"},
        "mail_ready_draft": {"type": "string"},
        "public_payload_manifest": {"type": "string"},
        "one_page_ask": {"type": "string"},
        "machine_checkable_request_packet": {"type": "string"}
      }
    },
    "computed_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_word_count",
        "body_sha256",
        "mail_ready_draft_sha256",
        "public_payload_manifest_sha256",
        "one_page_ask_sha256",
        "one_page_ask_size_bytes",
        "machine_checkable_request_packet_sha256",
        "machine_checkable_request_packet_size_bytes",
        "payload_manifest_matches_files_now"
      ],
      "properties": {
        "body_word_count": {"type": "integer", "minimum": 1, "maximum": 260},
        "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mail_ready_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "public_payload_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "one_page_ask_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "one_page_ask_size_bytes": {"type": "integer", "minimum": 1},
        "machine_checkable_request_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "machine_checkable_request_packet_size_bytes": {"type": "integer", "minimum": 1},
        "payload_manifest_matches_files_now": {"const": true}
      }
    },
    "send_time_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dry_run_may_satisfy_send_time_recompute",
        "must_rerun_immediately_before_send",
        "must_rerun_after_any_edit_or_attachment_change",
        "human_signature_must_bind_recomputed_hashes",
        "hashes_may_substitute_for_transport_proof_or_raw_custody"
      ],
      "properties": {
        "dry_run_may_satisfy_send_time_recompute": {"const": false},
        "must_rerun_immediately_before_send": {"const": true},
        "must_rerun_after_any_edit_or_attachment_change": {"const": true},
        "human_signature_must_bind_recomputed_hashes": {"const": true},
        "hashes_may_substitute_for_transport_proof_or_raw_custody": {"const": false}
      }
    },
    "operational_state": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 5
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 8
    },
    "related_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "public_summary": {"type": "string", "minLength": 60},
    "no_live_floor_effect": {"const": true}
  }
}
