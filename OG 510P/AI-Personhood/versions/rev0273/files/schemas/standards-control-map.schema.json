{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/standards-control-map.schema.json",
  "title": "AI Personhood Standards Control Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "map_id",
    "version",
    "created_at",
    "scope",
    "controls",
    "exceptions",
    "owner",
    "review_at",
    "public_summary"
  ],
  "properties": {
    "map_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "string"
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "external_framework",
          "external_control",
          "personhood_control",
          "evidence_object",
          "owner",
          "status",
          "failure_effect"
        ],
        "properties": {
          "external_framework": {
            "type": "string"
          },
          "external_control": {
            "type": "string"
          },
          "personhood_control": {
            "type": "string"
          },
          "evidence_object": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "implemented",
              "partial",
              "exception",
              "not-applicable",
              "failed"
            ]
          },
          "failure_effect": {
            "type": "string"
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string"
    },
    "review_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
