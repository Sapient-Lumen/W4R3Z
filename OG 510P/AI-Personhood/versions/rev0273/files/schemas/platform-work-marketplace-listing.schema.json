{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/platform-work-marketplace-listing.schema.json",
  "title": "AI Personhood Platform Work Marketplace Listing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "listing_id",
    "created_at",
    "platform_work_class",
    "subject_or_cohort",
    "platform",
    "work_types",
    "ranking_factors",
    "deactivation_rules",
    "rate_or_price_basis",
    "status_notice_policy",
    "challenge_route",
    "anti_retaliation_controls",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "platform_work_class": {
      "type": "string",
      "enum": [
        "PW0",
        "PW1",
        "PW2",
        "PW3",
        "PW4",
        "PW5"
      ]
    },
    "subject_or_cohort": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "work_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "ranking_factors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "deactivation_rules": {
      "type": "string"
    },
    "rate_or_price_basis": {
      "type": "string"
    },
    "status_notice_policy": {
      "type": "string"
    },
    "challenge_route": {
      "type": "string"
    },
    "anti_retaliation_controls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "benefits_or_reserve_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
