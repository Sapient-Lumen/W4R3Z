{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-delivery-status-record.schema.json",
  "title": "External Contact Delivery Status Record",
  "description": "Public-shell record for delivery, bounce, delay, DSN, and provider-delivery-status evidence after an external-contact send. It blocks DSNs, bounces, Message-ID correlations, provider UI, and delivery-status shells from being treated as counterparty responses, authority, custody, no-response windows, waiver, adverse inference, status recognition, or live-floor effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "schema_version",
    "revision",
    "created_at",
    "delivery_status_state",
    "source_execution_record_ref",
    "source_send_proof_record_ref",
    "source_send_trace_shell_ref",
    "source_dispatch_authorization_card_ref",
    "source_response_triage_record_ref",
    "status_capture_tool",
    "candidate_delivery_status",
    "dsn_classification_rules",
    "response_clock_policy",
    "delivery_outcome_decision",
    "public_shell_policy",
    "downstream_locks",
    "linked_queue_ids",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^ECDSR-[0-9]{4}-[A-Za-z0-9._:-]+$"},
    "schema_version": {"const": "external-contact-delivery-status-record-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "delivery_status_state": {"type": "string", "enum": ["pre-dispatch-no-delivery-status", "delivery-status-candidate-staged", "delivered-candidate-staged", "failed-or-bounced", "delayed", "superseded"]},
    "source_execution_record_ref": {"type": "string", "minLength": 10},
    "source_send_proof_record_ref": {"type": "string", "minLength": 10},
    "source_send_trace_shell_ref": {"type": "string", "minLength": 10},
    "source_dispatch_authorization_card_ref": {"type": "string", "minLength": 10},
    "source_response_triage_record_ref": {"type": "string", "minLength": 10},
    "status_capture_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_path", "raw_input_required_outside_release_tree", "copy_to_private_vault_only", "public_shell_only", "check_output_supported", "tool_is_not_delivery_or_response"],
      "properties": {
        "tool_path": {"const": "tools/stage_external_contact_delivery_status.py"},
        "raw_input_required_outside_release_tree": {"const": true},
        "copy_to_private_vault_only": {"const": true},
        "public_shell_only": {"const": true},
        "check_output_supported": {"const": true},
        "tool_is_not_delivery_or_response": {"const": true}
      }
    },
    "candidate_delivery_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_status_present_now", "source_locator", "private_status_locator", "raw_status_sha256", "size_bytes", "mime_type", "status_format", "dsn_action", "status_code", "diagnostic_code_present", "final_recipient_matches_selected_candidate", "original_message_id_or_envid_matches_sent_trace", "raw_status_publicly_embedded", "screenshot_only", "provider_ui_only", "counterparty_human_reply_present", "delivery_status_proof_present_now"],
      "properties": {
        "raw_status_present_now": {"type": "boolean"},
        "source_locator": {"type": ["string", "null"]},
        "private_status_locator": {"type": ["string", "null"]},
        "raw_status_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 1},
        "mime_type": {"type": ["string", "null"]},
        "status_format": {"type": ["string", "null"], "enum": ["message/delivery-status", "multipart/report", "provider-delivery-export", "smtp-transcript", "signed-provider-receipt", "other", null]},
        "dsn_action": {"type": ["string", "null"], "enum": ["failed", "delayed", "delivered", "relayed", "expanded", "other", null]},
        "status_code": {"type": ["string", "null"], "pattern": "^[245]\\.[0-9]\\.[0-9]+$"},
        "diagnostic_code_present": {"type": "boolean"},
        "final_recipient_matches_selected_candidate": {"type": "boolean"},
        "original_message_id_or_envid_matches_sent_trace": {"type": "boolean"},
        "raw_status_publicly_embedded": {"const": false},
        "screenshot_only": {"const": false},
        "provider_ui_only": {"const": false},
        "counterparty_human_reply_present": {"const": false},
        "delivery_status_proof_present_now": {"type": "boolean"}
      }
    },
    "dsn_classification_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rfc3461_dsn_extension_is_transport_only", "rfc3464_message_delivery_status_is_transport_only", "failed_dsn_is_not_counterparty_decline", "delayed_dsn_is_not_no_response", "delivered_or_relayed_dsn_is_not_counterparty_response", "auto_generated_dsn_may_create_response_record", "dsn_may_create_custody", "dsn_may_create_authority", "dsn_may_increment_live_floor"],
      "properties": {
        "rfc3461_dsn_extension_is_transport_only": {"const": true},
        "rfc3464_message_delivery_status_is_transport_only": {"const": true},
        "failed_dsn_is_not_counterparty_decline": {"const": true},
        "delayed_dsn_is_not_no_response": {"const": true},
        "delivered_or_relayed_dsn_is_not_counterparty_response": {"const": true},
        "auto_generated_dsn_may_create_response_record": {"const": false},
        "dsn_may_create_custody": {"const": false},
        "dsn_may_create_authority": {"const": false},
        "dsn_may_increment_live_floor": {"const": false}
      }
    },
    "response_clock_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock_may_start_now", "start_requires_signed_authorization", "start_requires_sent_at_utc", "start_requires_send_trace_transport_proof", "start_requires_send_proof_record_sent_state", "start_requires_no_failed_or_delayed_delivery_status", "start_may_use_delivery_status_timestamp_alone", "bounce_or_delay_suspends_no_response_claim", "no_response_may_be_recorded_now", "delivery_status_may_substitute_for_counterparty_reply"],
      "properties": {
        "clock_may_start_now": {"const": false},
        "start_requires_signed_authorization": {"const": true},
        "start_requires_sent_at_utc": {"const": true},
        "start_requires_send_trace_transport_proof": {"const": true},
        "start_requires_send_proof_record_sent_state": {"const": true},
        "start_requires_no_failed_or_delayed_delivery_status": {"const": true},
        "start_may_use_delivery_status_timestamp_alone": {"const": false},
        "bounce_or_delay_suspends_no_response_claim": {"const": true},
        "no_response_may_be_recorded_now": {"const": false},
        "delivery_status_may_substitute_for_counterparty_reply": {"const": false}
      }
    },
    "delivery_outcome_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_outcome", "delivery_status_processed_now", "hard_bounce_requires_counterparty_or_channel_reselection", "delayed_status_requires_watch_not_no_response", "successful_delivery_is_not_human_response", "retry_or_reselection_may_create_failed_gate", "public_status_shell_allowed"],
      "properties": {
        "current_outcome": {"type": "string", "enum": ["not-applicable-pre-dispatch", "pending-transport-review", "accepted-for-delivery-only", "temporary-delay", "hard-bounce-or-failure", "unknown"]},
        "delivery_status_processed_now": {"type": "boolean"},
        "hard_bounce_requires_counterparty_or_channel_reselection": {"const": true},
        "delayed_status_requires_watch_not_no_response": {"const": true},
        "successful_delivery_is_not_human_response": {"const": true},
        "retry_or_reselection_may_create_failed_gate": {"const": false},
        "public_status_shell_allowed": {"const": true}
      }
    },
    "public_shell_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_public_fields", "forbidden_public_fields", "public_shell_may_publish_raw_dsn", "public_shell_may_publish_personal_headers", "public_shell_may_satisfy_delivery_proof", "private_raw_status_required_for_delivery_outcome", "public_shell_may_start_response_clock"],
      "properties": {
        "allowed_public_fields": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 3}},
        "forbidden_public_fields": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 3}},
        "public_shell_may_publish_raw_dsn": {"const": false},
        "public_shell_may_publish_personal_headers": {"const": false},
        "public_shell_may_satisfy_delivery_proof": {"const": false},
        "private_raw_status_required_for_delivery_outcome": {"const": true},
        "public_shell_may_start_response_clock": {"const": false}
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_treat_dsn_as_counterparty_response", "may_treat_bounce_as_decline", "may_treat_delay_as_no_response", "may_treat_delivered_as_human_reply", "may_start_response_clock", "may_create_failed_gate_shell_now", "may_create_response_record", "may_create_custody_record", "may_create_intake_record", "may_create_import_gate", "may_increment_live_floor", "may_claim_status_or_waiver", "may_publish_raw_delivery_status"],
      "properties": {
        "may_treat_dsn_as_counterparty_response": {"const": false},
        "may_treat_bounce_as_decline": {"const": false},
        "may_treat_delay_as_no_response": {"const": false},
        "may_treat_delivered_as_human_reply": {"const": false},
        "may_start_response_clock": {"const": false},
        "may_create_failed_gate_shell_now": {"const": false},
        "may_create_response_record": {"const": false},
        "may_create_custody_record": {"const": false},
        "may_create_intake_record": {"const": false},
        "may_create_import_gate": {"const": false},
        "may_increment_live_floor": {"const": false},
        "may_claim_status_or_waiver": {"const": false},
        "may_publish_raw_delivery_status": {"const": false}
      }
    },
    "linked_queue_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "related_surfaces": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "public_summary": {"type": "string", "minLength": 160},
    "no_live_floor_effect": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"delivery_status_state": {"const": "pre-dispatch-no-delivery-status"}}, "required": ["delivery_status_state"]},
      "then": {
        "properties": {
          "candidate_delivery_status": {
            "properties": {
              "raw_status_present_now": {"const": false},
              "source_locator": {"const": null},
              "private_status_locator": {"const": null},
              "raw_status_sha256": {"const": null},
              "size_bytes": {"const": null},
              "mime_type": {"const": null},
              "status_format": {"const": null},
              "dsn_action": {"const": null},
              "status_code": {"const": null},
              "diagnostic_code_present": {"const": false},
              "final_recipient_matches_selected_candidate": {"const": false},
              "original_message_id_or_envid_matches_sent_trace": {"const": false},
              "delivery_status_proof_present_now": {"const": false}
            }
          },
          "delivery_outcome_decision": {
            "properties": {
              "current_outcome": {"const": "not-applicable-pre-dispatch"},
              "delivery_status_processed_now": {"const": false}
            }
          }
        }
      }
    }
  ]
}
