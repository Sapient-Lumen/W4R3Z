{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/human-branch-decision-record.schema.json",
  "title": "Human Branch Decision Record",
  "description": "Unsigned decision template and future branch-authority record for send/no-send/retarget choices. A template cannot authorize contact or create evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "schema_version",
    "revision",
    "created_at",
    "record_state",
    "decision_scope",
    "authorizer",
    "allowed_choices",
    "selected_choice",
    "bindings",
    "minimum_pre_send_conditions",
    "overclaim_locks",
    "no_live_floor_effect",
    "public_summary"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^HBDR-[0-9]{4}-[-A-Za-z0-9._:]+$"
    },
    "schema_version": {
      "const": "human-branch-decision-record-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_state": {
      "enum": [
        "template-unsigned-no-authority",
        "human-no-send-recorded",
        "human-reviewer-first-authorized",
        "human-aiid-route-authorized",
        "human-two-step-authorized",
        "human-retarget-other-authorized"
      ]
    },
    "decision_scope": {
      "type": "string"
    },
    "authorizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_role",
        "name_or_role",
        "signature_present",
        "timestamp_present",
        "signature_storage_rule"
      ],
      "properties": {
        "required_role": {
          "type": "string"
        },
        "name_or_role": {
          "type": "string"
        },
        "signature_present": {
          "type": "boolean"
        },
        "timestamp_present": {
          "type": "boolean"
        },
        "signature_storage_rule": {
          "type": "string"
        }
      }
    },
    "allowed_choices": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "choice_id",
          "label",
          "effect",
          "requires"
        ],
        "properties": {
          "choice_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "effect": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "selected_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choice_id",
        "selected_now",
        "reason"
      ],
      "properties": {
        "choice_id": {
          "type": "string"
        },
        "selected_now": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_matrix_ref",
        "reviewer_packet_ref",
        "capture_workbook_ref",
        "custody_precommit_ref",
        "six_artifact_pilot_ref"
      ],
      "properties": {
        "route_matrix_ref": {
          "type": "string"
        },
        "reviewer_packet_ref": {
          "type": "string"
        },
        "capture_workbook_ref": {
          "type": "string"
        },
        "custody_precommit_ref": {
          "type": "string"
        },
        "six_artifact_pilot_ref": {
          "type": "string"
        }
      }
    },
    "minimum_pre_send_conditions": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string"
      }
    },
    "overclaim_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_authorize_send_without_signature",
        "may_treat_template_as_authority",
        "may_start_response_clock",
        "may_claim_counterparty_contacted",
        "may_create_custody_intake_import_or_floor_effect"
      ],
      "properties": {
        "may_authorize_send_without_signature": {
          "const": false
        },
        "may_treat_template_as_authority": {
          "const": false
        },
        "may_start_response_clock": {
          "const": false
        },
        "may_claim_counterparty_contacted": {
          "const": false
        },
        "may_create_custody_intake_import_or_floor_effect": {
          "const": false
        }
      }
    },
    "no_live_floor_effect": {
      "const": true
    },
    "public_summary": {
      "type": "string"
    }
  }
}
