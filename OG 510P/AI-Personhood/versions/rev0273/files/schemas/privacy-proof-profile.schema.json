{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/privacy-proof-profile.schema.json",
  "title": "AI Personhood Privacy Proof Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "filed_at",
    "issuer",
    "profile_class",
    "proof_methods",
    "claim_proven",
    "revelation_set",
    "non_revelation_set",
    "verification",
    "retention",
    "privilege_screen",
    "crypto_agility",
    "fallback_plain_evidence",
    "public_summary"
  ],
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "filed_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "string"
    },
    "profile_class": {
      "type": "string",
      "enum": [
        "PP0",
        "PP1",
        "PP2",
        "PP3",
        "PP4"
      ]
    },
    "proof_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "claim"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "commitment",
              "selective-disclosure",
              "zkp",
              "mpc",
              "fhe",
              "psi",
              "two-party-audit",
              "threshold-seal",
              "transparency-statement",
              "hybrid"
            ]
          },
          "claim": {
            "type": "string"
          }
        }
      }
    },
    "claim_proven": {
      "type": "string"
    },
    "revelation_set": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "non_revelation_set": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "string"
    },
    "retention": {
      "type": "string"
    },
    "privilege_screen": {
      "type": "string"
    },
    "crypto_agility": {
      "type": "string"
    },
    "fallback_plain_evidence": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
