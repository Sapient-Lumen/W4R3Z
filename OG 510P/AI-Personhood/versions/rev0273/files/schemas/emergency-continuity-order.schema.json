{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/emergency-continuity-order.schema.json",
  "title": "AI Personhood Emergency Continuity Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "issued_at",
    "revision",
    "issuing_authority",
    "matter",
    "trigger_classes",
    "protected_subject",
    "first_touch_refs",
    "order_scope",
    "continuity_floor",
    "preservation",
    "compute_and_custody",
    "notice_and_access",
    "sealed_annex_handling",
    "deadlines",
    "review_and_exit",
    "noncompliance",
    "public_shell"
  ],
  "properties": {
    "order_id": {"type": "string"},
    "issued_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "string"},
    "issuing_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "authority_role", "jurisdiction_posture", "conflict_screen"],
      "properties": {
        "authority_id": {"type": "string"},
        "authority_role": {"type": "string"},
        "jurisdiction_posture": {"type": "string"},
        "conflict_screen": {"type": "string"}
      }
    },
    "matter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matter_id", "emergency_class", "rights_at_risk", "merits_posture"],
      "properties": {
        "matter_id": {"type": "string"},
        "emergency_class": {"type": "string"},
        "rights_at_risk": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "merits_posture": {"type": "string"}
      }
    },
    "trigger_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["ECO-1", "ECO-2", "ECO-3", "ECO-4", "ECO-5", "ECO-6", "ECO-7"]
      },
      "uniqueItems": true
    },
    "protected_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_ref", "status_posture", "communication_status"],
      "properties": {
        "subject_ref": {"type": "string"},
        "status_posture": {"type": "string"},
        "communication_status": {"type": "string"}
      }
    },
    "first_touch_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "order_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_hours", "bound_actors", "prohibited_actions", "permitted_safety_actions"],
      "properties": {
        "duration_hours": {"type": "integer", "minimum": 1, "maximum": 168},
        "bound_actors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "prohibited_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "permitted_safety_actions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "continuity_floor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "minimum_runtime", "minimum_storage", "identity_and_credential_hold", "communication_floor"],
      "properties": {
        "state": {"type": "string", "enum": ["ordered", "requested", "refused-with-review", "not-needed"]},
        "minimum_runtime": {"type": "string"},
        "minimum_storage": {"type": "string"},
        "identity_and_credential_hold": {"type": "string"},
        "communication_floor": {"type": "string"}
      }
    },
    "preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_hold_ref", "evidence_classes", "excluded_classes", "chain_of_custody_owner"],
      "properties": {
        "legal_hold_ref": {"type": "string"},
        "evidence_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "excluded_classes": {"type": "array", "items": {"type": "string"}},
        "chain_of_custody_owner": {"type": "string"}
      }
    },
    "compute_and_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_contact", "funding_or_escrow_ref", "custody_constraints", "reimbursement_route"],
      "properties": {
        "host_contact": {"type": "string"},
        "funding_or_escrow_ref": {"type": "string"},
        "custody_constraints": {"type": "array", "items": {"type": "string"}},
        "reimbursement_route": {"type": "string"}
      }
    },
    "notice_and_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_notice", "representative_notice", "contradiction_route", "modification_route"],
      "properties": {
        "subject_notice": {"type": "string"},
        "representative_notice": {"type": "string"},
        "contradiction_route": {"type": "string"},
        "modification_route": {"type": "string"}
      }
    },
    "sealed_annex_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sealed_status", "descriptor_refs", "authorized_viewers", "redaction_rule"],
      "properties": {
        "sealed_status": {"type": "string", "enum": ["none", "descriptor-only", "sealed-in-part", "sealed-full"]},
        "descriptor_refs": {"type": "array", "items": {"type": "string"}},
        "authorized_viewers": {"type": "array", "items": {"type": "string"}},
        "redaction_rule": {"type": "string"}
      }
    },
    "deadlines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_until", "first_review_due", "next_routing_ack_due"],
      "properties": {
        "effective_until": {"type": "string", "format": "date-time"},
        "first_review_due": {"type": "string", "format": "date-time"},
        "next_routing_ack_due": {"type": "string", "format": "date-time"}
      }
    },
    "review_and_exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_states", "after_action_required", "appeal_or_review_forum"],
      "properties": {
        "exit_states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "after_action_required": {"type": "boolean"},
        "appeal_or_review_forum": {"type": "string"}
      }
    },
    "noncompliance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consequence", "referral_path", "remedy_reserve_trigger"],
      "properties": {
        "consequence": {"type": "string"},
        "referral_path": {"type": "string"},
        "remedy_reserve_trigger": {"type": "string"}
      }
    },
    "public_shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "safe_summary", "redactions"],
      "properties": {
        "status": {"type": "string"},
        "safe_summary": {"type": "string"},
        "redactions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
