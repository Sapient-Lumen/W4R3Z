{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-response-triage-record.schema.json",
  "title": "External Contact Response Triage Record",
  "description": "Pre-custody response/no-response/decline triage for the first external-contact path. It classifies inbound or absent responses without creating custody, formal response, intake, import, waiver, adverse inference, status recognition, or live-floor effect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "triage_id",
    "schema_version",
    "revision",
    "created_at",
    "triage_state",
    "source_request_packet_ref",
    "source_execution_record_ref",
    "inbound_state",
    "decision_matrix",
    "capture_requirements",
    "public_shell_policy",
    "private_vault_route",
    "downstream_locks",
    "linked_queue_ids",
    "related_surfaces",
    "no_live_floor_effect"
  ],
  "properties": {
    "triage_id": {"type": "string", "pattern": "^ECRTR-[0-9]{4}-[A-Za-z0-9._:-]+$"},
    "schema_version": {"const": "external-contact-response-triage-record-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "triage_state": {
      "type": "string",
      "enum": [
        "pre-dispatch-no-inbound",
        "sent-window-open",
        "declined-shell-ready",
        "no-response-shell-ready",
        "automated-ack-only",
        "response-received-route-only",
        "response-rejected",
        "superseded"
      ]
    },
    "source_request_packet_ref": {"type": "string"},
    "source_execution_record_ref": {"type": "string"},
    "inbound_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inbound_artifact_present",
        "inbound_source_kind",
        "transport_metadata_present",
        "raw_payload_retained",
        "raw_payload_private_vault_ref",
        "public_hash_shell_ref",
        "counterparty_permission_state",
        "automated_acknowledgement",
        "is_redacted_copy_only",
        "is_protocol_or_tool_output",
        "formal_response_record_exists"
      ],
      "properties": {
        "inbound_artifact_present": {"type": "boolean"},
        "inbound_source_kind": {
          "type": "string",
          "enum": ["none", "raw-email", "signed-letter", "web-form-receipt", "api-payload", "mcp-tool-output", "a2a-task-artifact", "federated-relay", "public-redaction", "automated-ack", "unknown"]
        },
        "transport_metadata_present": {"type": "boolean"},
        "raw_payload_retained": {"type": "boolean"},
        "raw_payload_private_vault_ref": {"type": ["string", "null"]},
        "public_hash_shell_ref": {"type": ["string", "null"]},
        "counterparty_permission_state": {
          "type": "string",
          "enum": ["not-applicable-yet", "unknown", "declined", "retention-permitted", "public-shell-permitted", "conditional", "forbidden"]
        },
        "automated_acknowledgement": {"type": "boolean"},
        "is_redacted_copy_only": {"type": "boolean"},
        "is_protocol_or_tool_output": {"type": "boolean"},
        "formal_response_record_exists": {"const": false}
      }
    },
    "decision_matrix": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "trigger", "classification", "required_action", "permitted_public_output", "blocked_interpretation"],
        "properties": {
          "case_id": {"type": "string"},
          "trigger": {"type": "string", "minLength": 15},
          "classification": {"type": "string", "minLength": 20},
          "required_action": {"type": "string", "minLength": 30},
          "permitted_public_output": {"type": "string", "minLength": 20},
          "blocked_interpretation": {"type": "string", "minLength": 30}
        }
      }
    },
    "capture_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport_trace_required",
        "raw_headers_or_equivalent_required",
        "final_outgoing_body_hash_required",
        "counterparty_role_or_org_required",
        "retention_permission_required",
        "public_shell_permission_or_condition_required",
        "confidentiality_conditions_required",
        "authority_not_inferred_from_reply",
        "capture_items"
      ],
      "properties": {
        "transport_trace_required": {"const": true},
        "raw_headers_or_equivalent_required": {"const": true},
        "final_outgoing_body_hash_required": {"const": true},
        "counterparty_role_or_org_required": {"const": true},
        "retention_permission_required": {"const": true},
        "public_shell_permission_or_condition_required": {"const": true},
        "confidentiality_conditions_required": {"const": true},
        "authority_not_inferred_from_reply": {"const": true},
        "capture_items": {"type": "array", "minItems": 8, "items": {"type": "string"}}
      }
    },
    "public_shell_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_required_for_decline_or_silence",
        "hash_shell_only_before_admission",
        "required_public_fields",
        "forbidden_public_fields",
        "shell_is_not_waiver_or_adverse_inference",
        "public_shell_template"
      ],
      "properties": {
        "shell_required_for_decline_or_silence": {"const": true},
        "hash_shell_only_before_admission": {"const": true},
        "required_public_fields": {"type": "array", "minItems": 6, "items": {"type": "string"}},
        "forbidden_public_fields": {"type": "array", "minItems": 6, "items": {"type": "string"}},
        "shell_is_not_waiver_or_adverse_inference": {"const": true},
        "public_shell_template": {"type": "string", "minLength": 150}
      }
    },
    "private_vault_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_payload_must_stay_outside_release",
        "stage_tool",
        "vault_root_policy",
        "public_release_may_include_raw_bytes",
        "redacted_copy_may_satisfy_raw_custody",
        "protocol_output_may_satisfy_authority",
        "allowed_next_surfaces"
      ],
      "properties": {
        "raw_payload_must_stay_outside_release": {"const": true},
        "stage_tool": {"const": "tools/stage_live_evidence_drop.py"},
        "vault_root_policy": {"const": "outside-release-tree"},
        "public_release_may_include_raw_bytes": {"const": false},
        "redacted_copy_may_satisfy_raw_custody": {"const": false},
        "protocol_output_may_satisfy_authority": {"const": false},
        "allowed_next_surfaces": {"type": "array", "minItems": 3, "items": {"type": "string"}}
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_treat_sent_request_as_receipt",
        "may_treat_silence_as_waiver",
        "may_treat_decline_as_adverse_inference",
        "may_treat_auto_ack_as_counterparty_response",
        "may_treat_redacted_copy_as_raw",
        "may_treat_protocol_output_as_authority",
        "may_create_custody_record",
        "may_create_formal_response_record",
        "may_create_intake_record",
        "may_create_import_gate",
        "may_increment_live_floor",
        "may_claim_status_or_recognition",
        "may_publish_raw_payload"
      ],
      "properties": {
        "may_treat_sent_request_as_receipt": {"const": false},
        "may_treat_silence_as_waiver": {"const": false},
        "may_treat_decline_as_adverse_inference": {"const": false},
        "may_treat_auto_ack_as_counterparty_response": {"const": false},
        "may_treat_redacted_copy_as_raw": {"const": false},
        "may_treat_protocol_output_as_authority": {"const": false},
        "may_create_custody_record": {"const": false},
        "may_create_formal_response_record": {"const": false},
        "may_create_intake_record": {"const": false},
        "may_create_import_gate": {"const": false},
        "may_increment_live_floor": {"const": false},
        "may_claim_status_or_recognition": {"const": false},
        "may_publish_raw_payload": {"const": false}
      }
    },
    "linked_queue_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "related_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "public_summary": {"type": "string"},
    "no_live_floor_effect": {"const": true}
  }
}
