{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-dispatch-authorization-card.schema.json",
  "title": "External Contact Dispatch Authorization Card",
  "description": "A signable pre-send authorization and send-proof acceptance card for exactly one external-contact draft. It can name a public-source candidate and final message hash, but it cannot substitute for human authorization, dispatch, transport proof, response, custody, intake, import, recognition, waiver, adverse inference, or live-floor movement. v0.3 adds a send-trace-shell precommit and keeps v0.2 mail-ready binding: v0.2 adds an explicit mail-ready draft binding and send-proof-record reference so a concrete .eml draft cannot be laundered into transport proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_card_id",
    "schema_version",
    "revision",
    "created_at",
    "authorization_state",
    "source_request_packet_ref",
    "source_counterparty_selection_dossier_ref",
    "source_execution_record_ref",
    "source_rendered_message_ref",
    "source_mail_ready_draft_ref",
    "source_send_proof_record_ref",
    "source_send_trace_shell_ref",
    "selected_candidate",
    "message_binding",
    "human_authorization",
    "raw_reply_vault_precommit",
    "transport_proof_acceptance_tests",
    "response_clock_guard",
    "downstream_locks",
    "linked_queue_ids",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "authorization_card_id": {
      "type": "string",
      "pattern": "^ECDAC-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "external-contact-dispatch-authorization-card-v0.3"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorization_state": {
      "type": "string",
      "enum": [
        "blocked-missing-signature-and-vault",
        "signed-ready-to-send",
        "sent-proof-required",
        "superseded"
      ]
    },
    "source_request_packet_ref": {
      "type": "string",
      "minLength": 10
    },
    "source_counterparty_selection_dossier_ref": {
      "type": "string",
      "minLength": 10
    },
    "source_execution_record_ref": {
      "type": "string",
      "minLength": 10
    },
    "source_rendered_message_ref": {
      "type": "string",
      "minLength": 10
    },
    "selected_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "organization_name",
        "counterparty_kind",
        "public_channel_locator",
        "channel_type",
        "public_source_url",
        "selection_basis",
        "selection_is_not_contact",
        "selection_is_not_consent",
        "selection_is_not_authority"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 3
        },
        "organization_name": {
          "type": "string",
          "minLength": 2
        },
        "counterparty_kind": {
          "type": "string",
          "enum": [
            "provider",
            "lab",
            "auditor",
            "regulator",
            "clinic",
            "civil-society",
            "other"
          ]
        },
        "public_channel_locator": {
          "type": "string",
          "minLength": 6
        },
        "channel_type": {
          "type": "string",
          "enum": [
            "public-email",
            "public-contact-page",
            "public-web-form",
            "public-github-issue",
            "public-feedback-form",
            "other"
          ]
        },
        "public_source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "selection_basis": {
          "type": "string",
          "minLength": 80
        },
        "selection_is_not_contact": {
          "const": true
        },
        "selection_is_not_consent": {
          "const": true
        },
        "selection_is_not_authority": {
          "const": true
        }
      }
    },
    "message_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "final_outgoing_body_sha256",
        "rendered_message_sha256",
        "response_deadline_days",
        "body_hash_matches_request_packet",
        "deadline_matches_request_packet",
        "draft_is_not_sent",
        "message_may_be_edited_after_authorization",
        "mail_ready_draft_sha256",
        "mail_ready_draft_matches_body_and_recipient",
        "mail_ready_draft_is_not_transport_proof"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 12
        },
        "final_outgoing_body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rendered_message_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "response_deadline_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "body_hash_matches_request_packet": {
          "const": true
        },
        "deadline_matches_request_packet": {
          "const": true
        },
        "draft_is_not_sent": {
          "const": true
        },
        "message_may_be_edited_after_authorization": {
          "const": false
        },
        "mail_ready_draft_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mail_ready_draft_matches_body_and_recipient": {
          "const": true
        },
        "mail_ready_draft_is_not_transport_proof": {
          "const": true
        }
      }
    },
    "human_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_authorizer_id",
        "authorizer_role",
        "signed_at",
        "exact_recipient_authorized",
        "sender_authority_attested",
        "conflict_review_accepted",
        "send_permitted_now",
        "blocker_codes",
        "required_signature_statement"
      ],
      "properties": {
        "human_authorizer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorizer_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "signed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "exact_recipient_authorized": {
          "type": "boolean"
        },
        "sender_authority_attested": {
          "type": "boolean"
        },
        "conflict_review_accepted": {
          "type": "boolean"
        },
        "send_permitted_now": {
          "type": "boolean"
        },
        "blocker_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "human_signature_missing",
              "sender_authority_missing",
              "raw_reply_vault_root_missing",
              "transport_capture_plan_missing",
              "conflict_review_not_accepted",
              "send_time_locator_recheck_missing",
              "private_vault_root_missing",
              "send_time_hash_recompute_missing",
              "transport_proof_missing",
              "other"
            ]
          }
        },
        "required_signature_statement": {
          "type": "string",
          "minLength": 120
        }
      }
    },
    "raw_reply_vault_precommit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_policy",
        "operator_env_var",
        "locator_prefix",
        "actual_root_path_publicly_recorded",
        "root_selected_now",
        "stage_tool",
        "public_release_may_include_raw_reply_bytes",
        "precommit_may_satisfy_custody_or_authority"
      ],
      "properties": {
        "root_policy": {
          "const": "outside-release-tree"
        },
        "operator_env_var": {
          "type": "string",
          "minLength": 3
        },
        "locator_prefix": {
          "type": "string",
          "pattern": "^private-vault://"
        },
        "actual_root_path_publicly_recorded": {
          "const": false
        },
        "root_selected_now": {
          "type": "boolean"
        },
        "stage_tool": {
          "const": "tools/stage_live_evidence_drop.py"
        },
        "public_release_may_include_raw_reply_bytes": {
          "const": false
        },
        "precommit_may_satisfy_custody_or_authority": {
          "const": false
        }
      }
    },
    "transport_proof_acceptance_tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_before_marking_sent",
        "reject_if_missing_any",
        "auto_ack_triage_required",
        "send_proof_is_not_receipt",
        "send_proof_is_not_custody",
        "all_present_now",
        "send_trace_shell_required",
        "message_id_alone_rejected_as_response_clock"
      ],
      "properties": {
        "required_before_marking_sent": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "reject_if_missing_any": {
          "const": true
        },
        "auto_ack_triage_required": {
          "const": true
        },
        "send_proof_is_not_receipt": {
          "const": true
        },
        "send_proof_is_not_custody": {
          "const": true
        },
        "all_present_now": {
          "type": "boolean"
        },
        "send_trace_shell_required": {
          "const": true
        },
        "message_id_alone_rejected_as_response_clock": {
          "const": true
        }
      }
    },
    "response_clock_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock_may_start_now",
        "clock_starts_only_after_sent_proof",
        "no_response_shell_may_be_prepared_now",
        "silence_is_not_waiver",
        "decline_is_not_adverse_inference",
        "draft_or_authorization_card_may_start_clock"
      ],
      "properties": {
        "clock_may_start_now": {
          "const": false
        },
        "clock_starts_only_after_sent_proof": {
          "const": true
        },
        "no_response_shell_may_be_prepared_now": {
          "const": false
        },
        "silence_is_not_waiver": {
          "const": true
        },
        "decline_is_not_adverse_inference": {
          "const": true
        },
        "draft_or_authorization_card_may_start_clock": {
          "const": false
        }
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_send_without_signed_card",
        "may_treat_card_as_dispatch",
        "may_treat_public_email_as_consent",
        "may_treat_send_proof_as_response",
        "may_create_failed_gate_shell",
        "may_create_custody_record",
        "may_create_response_record",
        "may_create_intake_record",
        "may_create_import_gate",
        "may_increment_live_floor",
        "may_claim_status_or_waiver"
      ],
      "properties": {
        "may_send_without_signed_card": {
          "const": false
        },
        "may_treat_card_as_dispatch": {
          "const": false
        },
        "may_treat_public_email_as_consent": {
          "const": false
        },
        "may_treat_send_proof_as_response": {
          "const": false
        },
        "may_create_failed_gate_shell": {
          "const": false
        },
        "may_create_custody_record": {
          "const": false
        },
        "may_create_response_record": {
          "const": false
        },
        "may_create_intake_record": {
          "const": false
        },
        "may_create_import_gate": {
          "const": false
        },
        "may_increment_live_floor": {
          "const": false
        },
        "may_claim_status_or_waiver": {
          "const": false
        }
      }
    },
    "linked_queue_ids": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "related_surfaces": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string",
      "minLength": 120
    },
    "no_live_floor_effect": {
      "const": true
    },
    "source_mail_ready_draft_ref": {
      "type": "string",
      "minLength": 10
    },
    "source_send_proof_record_ref": {
      "type": "string",
      "minLength": 10
    },
    "source_send_trace_shell_ref": {
      "type": "string",
      "minLength": 10
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "authorization_state": {
            "const": "blocked-missing-signature-and-vault"
          }
        },
        "required": [
          "authorization_state"
        ]
      },
      "then": {
        "properties": {
          "human_authorization": {
            "properties": {
              "human_authorizer_id": {
                "const": null
              },
              "authorizer_role": {
                "const": null
              },
              "signed_at": {
                "const": null
              },
              "exact_recipient_authorized": {
                "const": false
              },
              "sender_authority_attested": {
                "const": false
              },
              "conflict_review_accepted": {
                "const": false
              },
              "send_permitted_now": {
                "const": false
              }
            }
          },
          "raw_reply_vault_precommit": {
            "properties": {
              "root_selected_now": {
                "const": false
              }
            }
          },
          "transport_proof_acceptance_tests": {
            "properties": {
              "all_present_now": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authorization_state": {
            "const": "signed-ready-to-send"
          }
        },
        "required": [
          "authorization_state"
        ]
      },
      "then": {
        "properties": {
          "human_authorization": {
            "properties": {
              "exact_recipient_authorized": {
                "const": true
              },
              "sender_authority_attested": {
                "const": true
              },
              "conflict_review_accepted": {
                "const": true
              },
              "send_permitted_now": {
                "const": true
              }
            }
          },
          "raw_reply_vault_precommit": {
            "properties": {
              "root_selected_now": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
