{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/fixture-run-report.schema.json",
  "title": "AI Personhood Fixture Run Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "run_at",
    "runner",
    "suite_id",
    "target",
    "fixtures_run",
    "observed_failures",
    "reliance_effect",
    "regression_actions",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "run_at": {
      "type": "string",
      "format": "date-time"
    },
    "runner": {
      "type": "string"
    },
    "suite_id": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_id"
      ],
      "properties": {
        "artifact_type": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        }
      }
    },
    "fixtures_run": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "expected_blocking_failures",
          "result"
        ],
        "properties": {
          "fixture_id": {
            "type": "string"
          },
          "expected_blocking_failures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "type": "string",
            "enum": [
              "passed",
              "warning",
              "blocking-failure",
              "not-applicable",
              "could-not-run"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "observed_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "false_positive_concerns": {
      "type": "string"
    },
    "false_negative_concerns": {
      "type": "string"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "downgraded",
        "stayed",
        "blocked",
        "invalidated"
      ]
    },
    "regression_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
