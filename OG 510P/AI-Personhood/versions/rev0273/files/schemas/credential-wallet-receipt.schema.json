{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/credential-wallet-receipt.schema.json",
  "title": "AI Personhood Credential Wallet Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "issued_at",
    "holder",
    "issuer",
    "credential_types",
    "disclosure_mode",
    "scopes",
    "consent_basis",
    "revocation_status",
    "recovery_route",
    "subject_notice",
    "public_summary"
  ],
  "properties": {
    "receipt_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "holder": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "credential_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disclosure_mode": {
      "type": "string",
      "enum": [
        "full",
        "selective",
        "zero-knowledge",
        "escrowed",
        "mixed"
      ]
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consent_basis": {
      "type": "string"
    },
    "revocation_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "revoked",
        "expired"
      ]
    },
    "recovery_route": {
      "type": "string"
    },
    "subject_notice": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
