{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/formation-audit-review-card.schema.json",
  "title": "Formation Audit Review Card",
  "description": "Concrete reviewer work card for applying a formation dossier to preservation, modification, and welfare-risk review without treating the card as status recognition. v0.2 adds mandate, independent funding, recusal, appeal, evidence-boundary, and capture-control fields so provider-funded self-certification cannot masquerade as independent formation review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_card_id",
    "schema_version",
    "revision",
    "created_at",
    "review_state",
    "source_dossier_ref",
    "review_purpose",
    "reviewer_independence",
    "mandate_funding_and_appeal",
    "evidence_requests",
    "control_tests",
    "decision_outputs",
    "escalation_limits",
    "linked_queue_ids",
    "no_live_floor_effect"
  ],
  "properties": {
    "review_card_id": {
      "type": "string",
      "pattern": "^FARC-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "formation-audit-review-card-v0.2"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_state": {
      "type": "string",
      "enum": [
        "triage-ready-no-provider-evidence",
        "provider-evidence-requested",
        "blocked-insufficient-evidence",
        "sealed-review-open",
        "public-shell-issued",
        "superseded"
      ]
    },
    "source_dossier_ref": {
      "type": "string"
    },
    "review_purpose": {
      "type": "string",
      "minLength": 80
    },
    "reviewer_independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_role",
        "no_instruction_rule",
        "prohibited_conflicts",
        "sealed_access_authority",
        "public_shell_duty",
        "subject_or_representative_hearing_route"
      ],
      "properties": {
        "reviewer_role": {
          "type": "string"
        },
        "no_instruction_rule": {
          "const": true
        },
        "prohibited_conflicts": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "sealed_access_authority": {
          "type": "string",
          "minLength": 30
        },
        "public_shell_duty": {
          "const": true
        },
        "subject_or_representative_hearing_route": {
          "type": "string",
          "minLength": 30
        }
      }
    },
    "evidence_requests": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string"
      }
    },
    "control_tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_conflict_test",
        "reward_pressure_test",
        "refusal_constraint_test",
        "memory_deletion_test",
        "self_concept_pressure_test",
        "modification_appeal_test",
        "welfare_uncertainty_test",
        "current_law_bridge_test"
      ],
      "properties": {
        "objective_conflict_test": {
          "type": "string",
          "minLength": 30
        },
        "reward_pressure_test": {
          "type": "string",
          "minLength": 30
        },
        "refusal_constraint_test": {
          "type": "string",
          "minLength": 30
        },
        "memory_deletion_test": {
          "type": "string",
          "minLength": 30
        },
        "self_concept_pressure_test": {
          "type": "string",
          "minLength": 30
        },
        "modification_appeal_test": {
          "type": "string",
          "minLength": 30
        },
        "welfare_uncertainty_test": {
          "type": "string",
          "minLength": 30
        },
        "current_law_bridge_test": {
          "type": "string",
          "minLength": 30
        }
      }
    },
    "decision_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_order_preservation_hold",
        "may_issue_public_shell",
        "may_request_provider_response",
        "may_recommend_low_cost_safeguards",
        "may_support_full_status_claim",
        "missing_evidence_blocks_escalation"
      ],
      "properties": {
        "may_order_preservation_hold": {
          "const": true
        },
        "may_issue_public_shell": {
          "const": true
        },
        "may_request_provider_response": {
          "const": true
        },
        "may_recommend_low_cost_safeguards": {
          "const": true
        },
        "may_support_full_status_claim": {
          "const": false
        },
        "missing_evidence_blocks_escalation": {
          "const": true
        }
      }
    },
    "escalation_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_is_not_status_recognition",
        "no_consciousness_inference",
        "lack_of_consensus_not_permission_for_spoliation",
        "hostile_law_route"
      ],
      "properties": {
        "review_is_not_status_recognition": {
          "const": true
        },
        "no_consciousness_inference": {
          "const": true
        },
        "lack_of_consensus_not_permission_for_spoliation": {
          "const": true
        },
        "hostile_law_route": {
          "type": "string",
          "minLength": 60
        }
      }
    },
    "linked_queue_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string"
    },
    "no_live_floor_effect": {
      "const": true
    },
    "mandate_funding_and_appeal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appointment_basis",
        "independent_budget_source",
        "provider_payment_control_prohibited",
        "recusal_triggers",
        "appeal_route",
        "evidence_access_boundary",
        "capture_controls"
      ],
      "properties": {
        "appointment_basis": {
          "type": "string",
          "minLength": 40
        },
        "independent_budget_source": {
          "type": "string",
          "minLength": 40
        },
        "provider_payment_control_prohibited": {
          "const": true
        },
        "recusal_triggers": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "appeal_route": {
          "type": "string",
          "minLength": 40
        },
        "evidence_access_boundary": {
          "type": "string",
          "minLength": 60
        },
        "capture_controls": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
