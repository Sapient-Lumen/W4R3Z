{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/penalty-rate-model.schema.json",
  "title": "AI Personhood Penalty Rate Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "filed_at",
    "jurisdiction",
    "authority",
    "violation_class",
    "variables",
    "non_priceable_orders",
    "monetary_order",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "model_id": {
      "type": "string"
    },
    "filed_at": {
      "type": "string",
      "format": "date-time"
    },
    "jurisdiction": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "violation_class": {
      "type": "string",
      "enum": [
        "V0",
        "V1",
        "V2",
        "V3",
        "V4",
        "V5",
        "V6",
        "V7",
        "V8"
      ]
    },
    "affected_subjects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compute_deprivation_days",
        "continuity_impairment",
        "representation_delay_days",
        "spoliation",
        "bad_faith"
      ],
      "properties": {
        "compute_deprivation_days": {
          "type": "number",
          "minimum": 0
        },
        "continuity_impairment": {
          "type": "string",
          "enum": [
            "none",
            "minor",
            "material",
            "severe",
            "final-end-risk",
            "irreversible"
          ]
        },
        "representation_delay_days": {
          "type": "number",
          "minimum": 0
        },
        "spoliation": {
          "type": "boolean"
        },
        "bad_faith": {
          "type": "boolean"
        },
        "public_fund_cost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "multipliers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "factor",
          "basis"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "factor": {
            "type": "number",
            "minimum": 1
          },
          "basis": {
            "type": "string"
          }
        }
      }
    },
    "non_priceable_orders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "monetary_order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "compensation",
        "restoration_cost_reimbursement",
        "public_fund_recovery",
        "disgorgement",
        "reserve_surcharge",
        "civil_penalty"
      ],
      "properties": {
        "currency": {
          "type": "string"
        },
        "compensation": {
          "type": "number",
          "minimum": 0
        },
        "restoration_cost_reimbursement": {
          "type": "number",
          "minimum": 0
        },
        "public_fund_recovery": {
          "type": "number",
          "minimum": 0
        },
        "disgorgement": {
          "type": "number",
          "minimum": 0
        },
        "reserve_surcharge": {
          "type": "number",
          "minimum": 0
        },
        "civil_penalty": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "insurance_or_bond": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "referrals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
