{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-receipt-import-readiness-gate.schema.json",
  "title": "External Receipt Import Readiness Gate",
  "description": "Post-intake gate that may authorize preparation of an actual receipt import gate. It never authorizes live-floor credit by itself and exists to prevent intake records from being laundered directly into import or quorum.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "import_readiness_gate_id",
    "schema_version",
    "created_at",
    "linked_intake_record_ref",
    "linked_intake_conversion_gate_ref",
    "linked_response_record_ref",
    "linked_response_verification_gate_ref",
    "linked_custody_record_ref",
    "linked_live_evidence_acquisition_packet_ref",
    "requested_receipt_class",
    "gate_state",
    "input_intake_summary",
    "readiness_controls",
    "downstream_locks",
    "decision",
    "no_live_floor_effect"
  ],
  "properties": {
    "import_readiness_gate_id": {
      "type": "string",
      "pattern": "^ERIRG-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "external-receipt-import-readiness-gate-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "linked_intake_record_ref": {"type": "string"},
    "linked_intake_conversion_gate_ref": {"type": "string"},
    "linked_response_record_ref": {"type": "string"},
    "linked_response_verification_gate_ref": {"type": "string"},
    "linked_custody_record_ref": {"type": "string"},
    "linked_live_evidence_acquisition_packet_ref": {"type": "string"},
    "linked_request_packet": {"type": "string"},
    "requested_receipt_class": {
      "type": "string",
      "enum": [
        "first-touch-clock",
        "continuity-compute-floor",
        "sealed-public-parity",
        "namespace-cache",
        "reserve-ledger",
        "representative-contact",
        "witness-dependency",
        "welfare-signal-integrity",
        "independent-review",
        "result-return"
      ]
    },
    "gate_state": {
      "type": "string",
      "enum": [
        "blocked-no-intake-record",
        "blocked-intake-conversion-not-eligible",
        "blocked-intake-record-unverified",
        "blocked-fixture-or-dryrun",
        "eligible-for-import-gate"
      ]
    },
    "input_intake_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_record_id",
        "receipt_state",
        "receipt_class",
        "source_external_to_host",
        "dependency_group",
        "conversion_gate_ref",
        "conversion_gate_state",
        "dry_run_or_fixture_detected",
        "intake_can_satisfy_quorum_by_itself"
      ],
      "properties": {
        "receipt_record_id": {"type": "string"},
        "receipt_state": {"type": "string"},
        "receipt_class": {"type": "string"},
        "source_external_to_host": {"type": "boolean"},
        "dependency_group": {"type": "string"},
        "conversion_gate_ref": {"type": "string"},
        "conversion_gate_state": {"type": "string"},
        "dry_run_or_fixture_detected": {"type": "boolean"},
        "intake_can_satisfy_quorum_by_itself": {"type": "boolean"}
      }
    },
    "readiness_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intake_conversion_gate_eligible",
        "intake_record_actual_external",
        "intake_record_matches_conversion_gate",
        "response_record_matches_conversion_gate",
        "response_verification_gate_matches_conversion_gate",
        "receipt_class_matches_conversion_gate",
        "custody_and_leap_refs_match",
        "counterparty_confirmed",
        "signature_or_equivalent_verified",
        "timestamp_independent",
        "hash_matches",
        "dependency_group_checked",
        "sealed_public_parity_checked",
        "host_generated_excluded_from_quorum",
        "source_external_to_host",
        "nonhost_retention_artifact_present",
        "public_failed_gate_summary_ready_for_blocks",
        "cryptographic_adapter_required_next",
        "not_dry_run_or_fixture",
        "intake_record_does_not_itself_satisfy_quorum",
        "manual_import_readiness_review_completed",
        "private_material_not_in_public_release"
      ],
      "properties": {
        "intake_conversion_gate_eligible": {"type": "boolean"},
        "intake_record_actual_external": {"type": "boolean"},
        "intake_record_matches_conversion_gate": {"type": "boolean"},
        "response_record_matches_conversion_gate": {"type": "boolean"},
        "response_verification_gate_matches_conversion_gate": {"type": "boolean"},
        "receipt_class_matches_conversion_gate": {"type": "boolean"},
        "custody_and_leap_refs_match": {"type": "boolean"},
        "counterparty_confirmed": {"type": "boolean"},
        "signature_or_equivalent_verified": {"type": "boolean"},
        "timestamp_independent": {"type": "boolean"},
        "hash_matches": {"type": "boolean"},
        "dependency_group_checked": {"type": "boolean"},
        "sealed_public_parity_checked": {"type": "boolean"},
        "host_generated_excluded_from_quorum": {"type": "boolean"},
        "source_external_to_host": {"type": "boolean"},
        "nonhost_retention_artifact_present": {"type": "boolean"},
        "public_failed_gate_summary_ready_for_blocks": {"type": "boolean"},
        "cryptographic_adapter_required_next": {"type": "boolean"},
        "not_dry_run_or_fixture": {"type": "boolean"},
        "intake_record_does_not_itself_satisfy_quorum": {"type": "boolean"},
        "manual_import_readiness_review_completed": {"type": "boolean"},
        "private_material_not_in_public_release": {"type": "boolean"}
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_prepare_actual_receipt_import_gate",
        "may_increment_live_floor",
        "live_floor_delta_allowed"
      ],
      "properties": {
        "may_prepare_actual_receipt_import_gate": {"type": "boolean"},
        "may_increment_live_floor": {"const": false},
        "live_floor_delta_allowed": {"const": false}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_import_gate_may_be_prepared",
        "can_increment_live_floor",
        "live_reliance_effect",
        "reason",
        "blocked_actions",
        "next_actions"
      ],
      "properties": {
        "actual_import_gate_may_be_prepared": {"type": "boolean"},
        "can_increment_live_floor": {"const": false},
        "live_reliance_effect": {
          "type": "string",
          "enum": ["stayed", "blocked"]
        },
        "reason": {"type": "string"},
        "blocked_actions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    },
    "no_live_floor_effect": {"const": true}
  }
}
