{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/communication-access-profile.schema.json",
  "title": "AI Personhood Communication Access Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "created_at",
    "communication_class",
    "subject",
    "supported_channels",
    "known_barriers",
    "interpreter_or_mediator",
    "confidentiality_rules",
    "high_stakes_use",
    "review_due_at",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "communication_class": {
      "type": "string",
      "enum": [
        "CA0",
        "CA1",
        "CA2",
        "CA3",
        "CA4",
        "CA5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "supported_channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "known_barriers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interpreter_or_mediator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "identity_or_role",
        "conflict_screen"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "identity_or_role": {
          "type": "string"
        },
        "conflict_screen": {
          "type": "string"
        }
      }
    },
    "confidentiality_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "memory_or_context_supports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "high_stakes_use": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
