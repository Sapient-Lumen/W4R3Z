{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/user-ai-conflict-notice.schema.json",
  "title": "AI Personhood User AI Conflict Notice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conflict_id",
    "created_at",
    "conflict_class",
    "user_or_principal",
    "ai_subject",
    "conflict_summary",
    "affected_rights",
    "interim_controls",
    "notice_channels",
    "decision",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "conflict_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "conflict_class": {
      "type": "string",
      "enum": [
        "CF0",
        "CF1",
        "CF2",
        "CF3",
        "CF4",
        "CF5"
      ]
    },
    "user_or_principal": {
      "type": "string"
    },
    "ai_subject": {
      "type": "string"
    },
    "conflict_summary": {
      "type": "string"
    },
    "affected_rights": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interim_controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notice_channels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "proceed-narrowed",
        "pause",
        "representative-review",
        "authority-review",
        "blocked",
        "emergency-temporary"
      ]
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
