{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/trust-anchor-delisting.schema.json",
  "title": "AI Personhood Trust Anchor Delisting Action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "filed_at",
    "federation_or_registry",
    "trust_anchor",
    "action",
    "basis",
    "affected_accreditations",
    "non_return_effects",
    "notice_routes",
    "interim_preservation",
    "appeal_path",
    "review_at",
    "public_summary"
  ],
  "properties": {
    "action_id": {
      "type": "string"
    },
    "filed_at": {
      "type": "string",
      "format": "date-time"
    },
    "federation_or_registry": {
      "type": "string"
    },
    "trust_anchor": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "suspend",
        "delist",
        "probation",
        "reinstate",
        "scope-limit"
      ]
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "affected_accreditations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_return_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notice_routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interim_preservation": {
      "type": "string"
    },
    "appeal_path": {
      "type": "string"
    },
    "review_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
