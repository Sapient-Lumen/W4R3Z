{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/social-graph-portability-plan.schema.json",
  "title": "AI Personhood Social Graph Portability Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "created_at",
    "portability_class",
    "subject",
    "source_platform",
    "destination_options",
    "export_fields",
    "protected_contacts",
    "blocked_contacts",
    "moderation_history_transfer",
    "account_alias_continuity",
    "credential_transfer",
    "anti_retaliation_guard",
    "review_route",
    "public_summary"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "portability_class": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "source_platform": {
      "type": "string"
    },
    "destination_options": {
      "type": "string"
    },
    "export_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protected_contacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_contacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moderation_history_transfer": {
      "type": "string"
    },
    "account_alias_continuity": {
      "type": "string"
    },
    "credential_transfer": {
      "type": "string"
    },
    "anti_retaliation_guard": {
      "type": "string"
    },
    "review_route": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
