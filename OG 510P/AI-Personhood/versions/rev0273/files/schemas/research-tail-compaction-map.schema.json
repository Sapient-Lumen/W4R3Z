{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/research-tail-compaction-map.schema.json",
  "title": "AI Personhood Research Tail Compaction Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "map_id",
    "created_at",
    "revision",
    "scope",
    "research_surface_count",
    "clusters",
    "audit_findings",
    "refactor_actions",
    "public_summary"
  ],
  "properties": {
    "map_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "research_surface_count": {
      "type": "integer"
    },
    "clusters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cluster_id",
          "title",
          "action",
          "receiving_surface",
          "owner_role",
          "rationale",
          "surfaces"
        ],
        "properties": {
          "cluster_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "keep-live",
              "compact-now",
              "monitor",
              "quarantine",
              "compacted"
            ]
          },
          "receiving_surface": {
            "type": "string"
          },
          "owner_role": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "current_state",
                "unique_questions"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "current_state": {
                  "type": "string",
                  "enum": [
                    "keep-live",
                    "fold",
                    "monitor",
                    "quarantine",
                    "folded"
                  ]
                },
                "unique_questions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "audit_findings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "refactor_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "public_summary": {
      "type": "string"
    }
  }
}
