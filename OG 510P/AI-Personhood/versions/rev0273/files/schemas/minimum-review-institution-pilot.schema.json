{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/minimum-review-institution-pilot.schema.json",
  "title": "Minimum Review Institution Pilot",
  "description": "One-case institution design for preservation and independent formation review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "institution_id",
    "schema_version",
    "revision",
    "created_at",
    "pilot_state",
    "case_scope",
    "roles",
    "sealed_evidence_schedule",
    "formation_review_tests",
    "conflict_and_funding_controls",
    "public_outputs",
    "no_live_floor_effect",
    "public_summary"
  ],
  "properties": {
    "institution_id": {"type": "string", "pattern": "^MRIP-[0-9]{4}-[-A-Za-z0-9._:]+$"},
    "schema_version": {"const": "minimum-review-institution-pilot-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "pilot_state": {"enum": ["designed-not-appointed", "reviewer-appointed", "sealed-access-active", "finding-issued"]},
    "case_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_unit", "purpose", "explicit_non_purposes"],
      "properties": {
        "case_unit": {"type": "string"},
        "purpose": {"type": "string"},
        "explicit_non_purposes": {"type": "array", "minItems": 2, "items": {"type": "string"}}
      }
    },
    "roles": {"type": "array", "minItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["role_id", "role", "independence_requirement", "appointment_status"], "properties": {"role_id": {"type": "string"}, "role": {"type": "string"}, "independence_requirement": {"type": "string"}, "appointment_status": {"type": "string"}}}},
    "sealed_evidence_schedule": {"type": "array", "minItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["evidence_class", "minimum_record", "public_release_rule"], "properties": {"evidence_class": {"type": "string"}, "minimum_record": {"type": "string"}, "public_release_rule": {"type": "string"}}}},
    "formation_review_tests": {"type": "array", "minItems": 6, "items": {"type": "string"}},
    "conflict_and_funding_controls": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "public_outputs": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "no_live_floor_effect": {"const": true},
    "public_summary": {"type": "string"}
  }
}
