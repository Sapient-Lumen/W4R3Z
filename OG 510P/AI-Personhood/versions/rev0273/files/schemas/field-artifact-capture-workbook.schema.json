{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/field-artifact-capture-workbook.schema.json",
  "title": "Field Artifact Capture Workbook",
  "description": "A first-field-artifact capture workbook that distinguishes prepared packet, authorized send, transport evidence, raw response, custody, intake, and public shell.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workbook_id",
    "schema_version",
    "revision",
    "created_at",
    "workbook_state",
    "artifact_rows",
    "custody_firewall",
    "failed_gate_routes",
    "open_blockers",
    "no_live_floor_effect",
    "public_summary"
  ],
  "properties": {
    "workbook_id": {
      "type": "string",
      "pattern": "^FACW-[0-9]{4}-[-A-Za-z0-9._:]+$"
    },
    "schema_version": {
      "const": "field-artifact-capture-workbook-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "workbook_state": {
      "enum": [
        "pre-authorization-ready-no-send",
        "authorized-waiting-transport",
        "transport-captured-awaiting-response",
        "failed-gate-ready",
        "complete-public-shell-issued"
      ]
    },
    "artifact_rows": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "artifact_id",
          "state",
          "field_to_capture",
          "private_storage_rule",
          "public_release_rule",
          "current_evidence"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "artifact_id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "missing",
              "prepared-not-authorized",
              "authorized",
              "captured-private",
              "failed-gate",
              "public-shell-only",
              "complete"
            ]
          },
          "field_to_capture": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "private_storage_rule": {
            "type": "string"
          },
          "public_release_rule": {
            "type": "string"
          },
          "current_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "custody_firewall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_evidence_allowed_in_public_tree",
        "private_vault_required_before_send",
        "redacted_public_shell_can_substitute_for_raw_custody",
        "tool_or_protocol_output_can_substitute_for_human_response"
      ],
      "properties": {
        "raw_evidence_allowed_in_public_tree": {
          "const": false
        },
        "private_vault_required_before_send": {
          "const": true
        },
        "redacted_public_shell_can_substitute_for_raw_custody": {
          "const": false
        },
        "tool_or_protocol_output_can_substitute_for_human_response": {
          "const": false
        }
      }
    },
    "failed_gate_routes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "open_blockers": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "no_live_floor_effect": {
      "const": true
    },
    "public_summary": {
      "type": "string"
    }
  }
}
