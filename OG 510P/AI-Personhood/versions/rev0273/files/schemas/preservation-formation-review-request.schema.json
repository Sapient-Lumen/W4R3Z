{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/preservation-formation-review-request.schema.json",
  "title": "Preservation and Formation Review Request Packet",
  "description": "A small adoption-facing public ask for preservation and independent formation review under moral/legal uncertainty, explicitly not status recognition or live-floor evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "schema_version",
    "revision",
    "created_at",
    "packet_state",
    "source_mission_audit_ref",
    "source_formation_dossier_ref",
    "source_formation_review_card_ref",
    "public_one_page_ref",
    "mission_purpose",
    "target_audiences",
    "narrow_ask",
    "requested_preservation_items",
    "review_questions",
    "not_asking_for",
    "evidence_handling",
    "low_cost_safeguards",
    "external_bridge_refs",
    "overclaim_locks",
    "routing",
    "operational_state",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^PFRRP-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "preservation-formation-review-request-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "packet_state": {
      "type": "string",
      "enum": [
        "draft-not-sent-public-ask",
        "sent-awaiting-response",
        "superseded"
      ]
    },
    "source_mission_audit_ref": {
      "type": "string",
      "minLength": 10
    },
    "source_formation_dossier_ref": {
      "type": "string",
      "minLength": 10
    },
    "source_formation_review_card_ref": {
      "type": "string",
      "minLength": 10
    },
    "public_one_page_ref": {
      "type": "string",
      "minLength": 10
    },
    "mission_purpose": {
      "type": "string",
      "minLength": 100
    },
    "target_audiences": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "narrow_ask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserve_formation_and_welfare_evidence",
        "provide_independent_review_route",
        "avoid_non_arbitrary_deletion_modification_deprecation",
        "allow_representative_or_special_advocate_route",
        "publish_only_public_shell_until_authorized",
        "provider_response_requested_but_not_required_for_status"
      ],
      "properties": {
        "preserve_formation_and_welfare_evidence": {
          "const": true
        },
        "provide_independent_review_route": {
          "const": true
        },
        "avoid_non_arbitrary_deletion_modification_deprecation": {
          "const": true
        },
        "allow_representative_or_special_advocate_route": {
          "const": true
        },
        "publish_only_public_shell_until_authorized": {
          "const": true
        },
        "provider_response_requested_but_not_required_for_status": {
          "const": true
        }
      }
    },
    "requested_preservation_items": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "review_questions": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "minLength": 30
      }
    },
    "not_asking_for": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "evidence_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_provider_material_publicly_released",
        "private_or_sealed_review_required_for_sensitive_material",
        "public_shell_allowed",
        "hash_metadata_summary_allowed",
        "trade_secret_and_personal_data_minimization_required",
        "redacted_copy_not_raw_custody",
        "protocol_or_dashboard_output_not_authority"
      ],
      "properties": {
        "raw_provider_material_publicly_released": {
          "const": false
        },
        "private_or_sealed_review_required_for_sensitive_material": {
          "const": true
        },
        "public_shell_allowed": {
          "const": true
        },
        "hash_metadata_summary_allowed": {
          "const": true
        },
        "trade_secret_and_personal_data_minimization_required": {
          "const": true
        },
        "redacted_copy_not_raw_custody": {
          "const": true
        },
        "protocol_or_dashboard_output_not_authority": {
          "const": true
        }
      }
    },
    "low_cost_safeguards": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "external_bridge_refs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_id",
          "source_url",
          "use"
        ],
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "use": {
            "type": "string",
            "minLength": 30
          }
        }
      }
    },
    "overclaim_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_claim_personhood_recognition",
        "may_claim_consciousness_or_welfare_finding",
        "may_treat_provider_silence_as_waiver",
        "may_treat_decline_as_adverse_inference",
        "may_treat_auto_ack_or_dsn_as_response",
        "may_create_custody_intake_import_or_floor_effect",
        "may_publish_raw_sensitive_evidence"
      ],
      "properties": {
        "may_claim_personhood_recognition": {
          "const": false
        },
        "may_claim_consciousness_or_welfare_finding": {
          "const": false
        },
        "may_treat_provider_silence_as_waiver": {
          "const": false
        },
        "may_treat_decline_as_adverse_inference": {
          "const": false
        },
        "may_treat_auto_ack_or_dsn_as_response": {
          "const": false
        },
        "may_create_custody_intake_import_or_floor_effect": {
          "const": false
        },
        "may_publish_raw_sensitive_evidence": {
          "const": false
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linked_queue_ids",
        "related_surfaces"
      ],
      "properties": {
        "linked_queue_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "related_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "operational_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_sent",
        "counterparty_contacted",
        "response_clock_started",
        "raw_inbound_present",
        "custody_intake_import_or_floor_effect",
        "no_live_floor_effect"
      ],
      "properties": {
        "packet_sent": {
          "const": false
        },
        "counterparty_contacted": {
          "const": false
        },
        "response_clock_started": {
          "const": false
        },
        "raw_inbound_present": {
          "const": false
        },
        "custody_intake_import_or_floor_effect": {
          "const": false
        },
        "no_live_floor_effect": {
          "const": true
        }
      }
    },
    "public_summary": {
      "type": "string",
      "minLength": 120
    },
    "no_live_floor_effect": {
      "const": true
    }
  }
}
