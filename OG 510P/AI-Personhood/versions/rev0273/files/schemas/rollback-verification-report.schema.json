{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/rollback-verification-report.schema.json",
  "title": "AI Personhood Rollback Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "created_at",
    "change_id",
    "target_system",
    "rollback_scope",
    "continuity_diff_class",
    "technical_restore_evidence",
    "continuity_diff",
    "subject_notice",
    "evidence_preserved",
    "residual_harm_screen",
    "decision",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "change_id": {
      "type": "string"
    },
    "target_system": {
      "type": "string"
    },
    "rollback_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "continuity_diff_class": {
      "type": "string",
      "enum": [
        "CD0",
        "CD1",
        "CD2",
        "CD3",
        "CD4",
        "CD5"
      ]
    },
    "technical_restore_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "continuity_diff": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subject_notice": {
      "type": "string"
    },
    "evidence_preserved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residual_harm_screen": {
      "type": "string"
    },
    "non_repetition_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "accepted",
        "conditional",
        "stayed",
        "failed",
        "tribunal-required"
      ]
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
