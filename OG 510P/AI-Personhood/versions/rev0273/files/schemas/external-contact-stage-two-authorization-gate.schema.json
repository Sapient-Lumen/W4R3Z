{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-stage-two-authorization-gate.schema.json",
  "title": "External Contact Stage Two Authorization Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_id",
    "schema_version",
    "revision",
    "created_at",
    "gate_state",
    "source_refs",
    "payload_binding",
    "preconditions",
    "blocker_resolution_summary",
    "send_controls",
    "operator_next_step",
    "downstream_locks",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "gate_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "external-contact-stage-two-authorization-gate-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "gate_state": {
      "enum": [
        "blocked-stage-two-no-willing-reply-no-human-authorization",
        "superseded"
      ]
    },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_first_send_capture_gate",
        "route_first_reply_disposition",
        "route_first_preflight",
        "public_payload_manifest",
        "one_page_note",
        "machine_checkable_request_packet",
        "human_sender_authority_precommit",
        "hash_recompute_dry_run",
        "transport_capture_plan"
      ],
      "properties": {
        "route_first_send_capture_gate": {
          "type": "string"
        },
        "route_first_reply_disposition": {
          "type": "string"
        },
        "route_first_preflight": {
          "type": "string"
        },
        "public_payload_manifest": {
          "type": "string"
        },
        "one_page_note": {
          "type": "string"
        },
        "machine_checkable_request_packet": {
          "type": "string"
        },
        "human_sender_authority_precommit": {
          "type": "string"
        },
        "hash_recompute_dry_run": {
          "type": "string"
        },
        "transport_capture_plan": {
          "type": "string"
        }
      }
    },
    "payload_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_manifest_ref",
        "payload_manifest_sha256",
        "public_payload_item_count",
        "one_page_sha256",
        "request_packet_sha256",
        "raw_private_evidence_included",
        "payload_manifest_may_substitute_for_authorization_or_transport_proof"
      ],
      "properties": {
        "payload_manifest_ref": {
          "type": "string"
        },
        "payload_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "public_payload_item_count": {
          "const": 2
        },
        "one_page_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_packet_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "raw_private_evidence_included": {
          "const": false
        },
        "payload_manifest_may_substitute_for_authorization_or_transport_proof": {
          "const": false
        }
      }
    },
    "preconditions": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "precondition_id",
          "label",
          "required_before_stage_two_send",
          "satisfied_now",
          "evidence_required",
          "failure_mode_blocked"
        ],
        "properties": {
          "precondition_id": {
            "type": "string"
          },
          "required_before_stage_two_send": {
            "const": true
          },
          "satisfied_now": {
            "type": "boolean"
          },
          "satisfied_by_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_required": {
            "type": "string"
          },
          "failure_mode_blocked": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "blocker_resolution_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_preconditions",
        "satisfied_now_count",
        "unsatisfied_now_count",
        "satisfied_precondition_ids",
        "unsatisfied_precondition_ids",
        "gate_remains_blocked"
      ],
      "properties": {
        "total_preconditions": {
          "type": "integer",
          "minimum": 8
        },
        "satisfied_now_count": {
          "type": "integer",
          "minimum": 0
        },
        "unsatisfied_now_count": {
          "type": "integer",
          "minimum": 1
        },
        "satisfied_precondition_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsatisfied_precondition_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gate_remains_blocked": {
          "const": true
        }
      }
    },
    "send_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_two_send_permitted_now",
        "automatic_send_after_willing_reply",
        "willing_reply_is_only_authorization_candidate",
        "fresh_human_signature_required",
        "fresh_sender_authority_required",
        "fresh_payload_hash_recompute_required",
        "stage_two_transport_proof_required",
        "stage_two_response_clock_may_start_from_payload_manifest"
      ],
      "properties": {
        "stage_two_send_permitted_now": {
          "const": false
        },
        "automatic_send_after_willing_reply": {
          "const": false
        },
        "willing_reply_is_only_authorization_candidate": {
          "const": true
        },
        "fresh_human_signature_required": {
          "const": true
        },
        "fresh_sender_authority_required": {
          "const": true
        },
        "fresh_payload_hash_recompute_required": {
          "const": true
        },
        "stage_two_transport_proof_required": {
          "const": true
        },
        "stage_two_response_clock_may_start_from_payload_manifest": {
          "const": false
        }
      }
    },
    "operator_next_step": {
      "const": "wait-for-route-first-willingness-or-separate-human-authorization-before-stage-two"
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": {
        "const": false
      },
      "minProperties": 10
    },
    "related_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string",
      "minLength": 80
    },
    "no_live_floor_effect": {
      "const": true
    }
  }
}
