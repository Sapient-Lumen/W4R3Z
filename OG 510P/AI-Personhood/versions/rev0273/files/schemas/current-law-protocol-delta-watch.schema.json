{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/current-law-protocol-delta-watch.schema.json",
  "title": "Current Law and Protocol Delta Watch",
  "description": "Dated watch object for external legal, standards, and agent-protocol changes that can stale crosswalks or artifact-admission assumptions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "watch_id",
    "schema_version",
    "revision",
    "updated_at",
    "evidence_status",
    "watch_window",
    "monitored_sources",
    "risk_decisions",
    "no_live_floor_effect"
  ],
  "properties": {
    "watch_id": {
      "type": "string",
      "pattern": "^CLPDW-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "current-law-protocol-delta-watch-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_status": {
      "const": "research-snapshot-not-legal-advice"
    },
    "watch_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of_date",
        "next_refresh_due"
      ],
      "properties": {
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "next_refresh_due": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "monitored_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "name",
          "source_type",
          "source_url",
          "checked_at",
          "status_change_summary",
          "archive_action_required",
          "affected_surfaces"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "law",
              "standard",
              "protocol",
              "security-guidance",
              "welfare-research",
              "resource-economics"
            ]
          },
          "source_url": {
            "type": "string"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "status_change_summary": {
            "type": "string"
          },
          "archive_action_required": {
            "type": "string"
          },
          "affected_surfaces": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "linked_queue_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "risk_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "decision",
          "why",
          "receiving_surface"
        ],
        "properties": {
          "decision_id": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "receiving_surface": {
            "type": "string"
          }
        }
      }
    },
    "no_live_floor_effect": {
      "const": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
