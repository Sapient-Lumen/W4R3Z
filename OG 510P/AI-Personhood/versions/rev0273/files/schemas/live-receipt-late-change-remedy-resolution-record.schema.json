{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/live-receipt-late-change-remedy-resolution-record.schema.json",
  "title": "Live Receipt Late Change Remedy Resolution Record",
  "description": "Resolution gate after late-change notice dispatch. It proves that a notice/remedy window was either not required because no late signal exists, or was closed with retained submissions, scoped reviewer authority, decision record, non-host proof, accessible resolution notice, and redaction boundaries before any recompute/publication rollback rerun. It never continues publication, upgrades reliance, treats silence as waiver, or increments the floor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "late_change_remedy_resolution_id",
    "schema_version",
    "created_at",
    "revision",
    "linked_late_change_notice_dispatch_ref",
    "linked_late_change_ingress_ref",
    "linked_publication_adjudication_ref",
    "linked_floor_recompute_receipt_ref",
    "remedy_context",
    "resolution_checks",
    "resolution_freeze_locks",
    "decision",
    "no_direct_floor_effect"
  ],
  "properties": {
    "late_change_remedy_resolution_id": {
      "type": "string",
      "pattern": "^LRLCRR-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "live-receipt-late-change-remedy-resolution-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "linked_late_change_notice_dispatch_ref": {
      "type": "string"
    },
    "linked_late_change_ingress_ref": {
      "type": "string"
    },
    "linked_publication_adjudication_ref": {
      "type": "string"
    },
    "linked_floor_recompute_receipt_ref": {
      "type": "string"
    },
    "remedy_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_late_signal_present",
        "signal_type",
        "target_receipt_or_publication_ref",
        "remedy_or_appeal_window_ref",
        "remedy_window_status",
        "affected_party_submission_refs",
        "resolution_authority_ref",
        "resolution_decision_ref",
        "resolution_outcome",
        "nonhost_resolution_proof_ref",
        "accessible_resolution_notice_ref",
        "redaction_boundary_ref",
        "private_material_locator_redacted",
        "resolution_artifact_sha256"
      ],
      "properties": {
        "live_late_signal_present": {
          "type": "boolean"
        },
        "signal_type": {
          "type": "string",
          "enum": [
            "none",
            "challenge",
            "revocation",
            "supersession",
            "rollback-evidence",
            "counterparty-correction",
            "hash-mismatch",
            "authority-withdrawal"
          ]
        },
        "target_receipt_or_publication_ref": {
          "type": "string"
        },
        "remedy_or_appeal_window_ref": {
          "type": "string"
        },
        "remedy_window_status": {
          "type": "string",
          "enum": [
            "none",
            "open",
            "closed"
          ]
        },
        "affected_party_submission_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolution_authority_ref": {
          "type": "string"
        },
        "resolution_decision_ref": {
          "type": "string"
        },
        "resolution_outcome": {
          "type": "string",
          "enum": [
            "none-no-signal",
            "upheld-late-change",
            "denied-no-change",
            "supersession-required",
            "rollback-required",
            "correction-required",
            "recompute-required"
          ]
        },
        "nonhost_resolution_proof_ref": {
          "type": "string"
        },
        "accessible_resolution_notice_ref": {
          "type": "string"
        },
        "redaction_boundary_ref": {
          "type": "string"
        },
        "private_material_locator_redacted": {
          "type": "boolean"
        },
        "resolution_artifact_sha256": {
          "type": "string",
          "pattern": "^(none|[0-9a-f]{64})$"
        }
      }
    },
    "resolution_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notice_dispatch_replayed",
        "dispatch_ready_or_no_signal",
        "remedy_window_closed_or_not_required",
        "affected_party_submissions_retained",
        "resolution_authority_scoped",
        "resolution_decision_recorded",
        "resolution_outcome_scoped",
        "rollback_or_recompute_route_bound",
        "nonhost_resolution_proof_present",
        "accessible_resolution_notice_prepared",
        "private_material_not_in_public_release",
        "publication_continuation_stayed",
        "no_silence_as_waiver"
      ],
      "properties": {
        "notice_dispatch_replayed": {
          "type": "boolean"
        },
        "dispatch_ready_or_no_signal": {
          "type": "boolean"
        },
        "remedy_window_closed_or_not_required": {
          "type": "boolean"
        },
        "affected_party_submissions_retained": {
          "type": "boolean"
        },
        "resolution_authority_scoped": {
          "type": "boolean"
        },
        "resolution_decision_recorded": {
          "type": "boolean"
        },
        "resolution_outcome_scoped": {
          "type": "boolean"
        },
        "rollback_or_recompute_route_bound": {
          "type": "boolean"
        },
        "nonhost_resolution_proof_present": {
          "type": "boolean"
        },
        "accessible_resolution_notice_prepared": {
          "type": "boolean"
        },
        "private_material_not_in_public_release": {
          "type": "boolean"
        },
        "publication_continuation_stayed": {
          "type": "boolean"
        },
        "no_silence_as_waiver": {
          "type": "boolean"
        }
      }
    },
    "resolution_freeze_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_continue_published_snapshot_from_resolution",
        "may_continue_reliance_from_resolution",
        "may_upgrade_reliance_from_resolution",
        "may_increment_live_floor_from_resolution",
        "manual_publication_override_allowed",
        "remedy_silence_counts_as_waiver",
        "must_rerun_floor_recompute_and_publication_rollback_after_resolution"
      ],
      "properties": {
        "may_continue_published_snapshot_from_resolution": {
          "const": false
        },
        "may_continue_reliance_from_resolution": {
          "const": false
        },
        "may_upgrade_reliance_from_resolution": {
          "const": false
        },
        "may_increment_live_floor_from_resolution": {
          "const": false
        },
        "manual_publication_override_allowed": {
          "const": false
        },
        "remedy_silence_counts_as_waiver": {
          "const": false
        },
        "must_rerun_floor_recompute_and_publication_rollback_after_resolution": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remedy_resolution_state",
        "may_mark_resolution_ready",
        "may_publish_or_continue_snapshot",
        "may_upgrade_reliance",
        "may_increment_live_floor",
        "reason",
        "blocked_actions",
        "next_actions"
      ],
      "properties": {
        "remedy_resolution_state": {
          "type": "string",
          "enum": [
            "monitoring-no-signal-no-remedy-required",
            "resolution-ready-publication-stayed",
            "blocked-notice-dispatch-not-ready",
            "blocked-remedy-window-still-open",
            "blocked-remedy-submissions-unretained",
            "blocked-resolution-authority-missing",
            "blocked-resolution-decision-missing",
            "blocked-private-material-in-public-resolution"
          ]
        },
        "may_mark_resolution_ready": {
          "type": "boolean"
        },
        "may_publish_or_continue_snapshot": {
          "const": false
        },
        "may_upgrade_reliance": {
          "const": false
        },
        "may_increment_live_floor": {
          "const": false
        },
        "reason": {
          "type": "string"
        },
        "blocked_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "no_direct_floor_effect": {
      "const": true
    }
  }
}
