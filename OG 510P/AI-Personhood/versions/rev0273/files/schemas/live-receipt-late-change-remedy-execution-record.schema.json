{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/live-receipt-late-change-remedy-execution-record.schema.json",
  "title": "Live Receipt Late Change Remedy Execution Record",
  "description": "Execution gate after late-change remedy resolution. It proves that a resolved revocation, supersession, correction, rollback, or recompute remedy was actually carried out or explicitly not required before any recompute/publication rollback rerun. It never continues publication, upgrades reliance, treats silence as completion, or increments the floor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "late_change_remedy_execution_id",
    "schema_version",
    "created_at",
    "revision",
    "linked_late_change_remedy_resolution_ref",
    "linked_late_change_notice_dispatch_ref",
    "linked_late_change_ingress_ref",
    "linked_publication_adjudication_ref",
    "linked_floor_recompute_receipt_ref",
    "execution_context",
    "execution_checks",
    "execution_freeze_locks",
    "decision",
    "no_direct_floor_effect"
  ],
  "properties": {
    "late_change_remedy_execution_id": {
      "type": "string",
      "pattern": "^LRLCRE-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "live-receipt-late-change-remedy-execution-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "linked_late_change_remedy_resolution_ref": {
      "type": "string"
    },
    "linked_late_change_notice_dispatch_ref": {
      "type": "string"
    },
    "linked_late_change_ingress_ref": {
      "type": "string"
    },
    "linked_publication_adjudication_ref": {
      "type": "string"
    },
    "linked_floor_recompute_receipt_ref": {
      "type": "string"
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_late_signal_present",
        "signal_type",
        "target_receipt_or_publication_ref",
        "resolution_outcome",
        "execution_status",
        "corrective_action_refs",
        "rollback_completion_ref",
        "supersession_public_shell_ref",
        "correction_public_shell_ref",
        "nonhost_execution_proof_ref",
        "affected_party_completion_notice_ref",
        "redaction_boundary_ref",
        "private_material_locator_redacted",
        "execution_artifact_sha256"
      ],
      "properties": {
        "live_late_signal_present": {
          "type": "boolean"
        },
        "signal_type": {
          "type": "string",
          "enum": [
            "none",
            "challenge",
            "revocation",
            "supersession",
            "rollback-evidence",
            "counterparty-correction",
            "hash-mismatch",
            "authority-withdrawal"
          ]
        },
        "target_receipt_or_publication_ref": {
          "type": "string"
        },
        "resolution_outcome": {
          "type": "string",
          "enum": [
            "none-no-signal",
            "upheld-late-change",
            "denied-no-change",
            "supersession-required",
            "rollback-required",
            "correction-required",
            "recompute-required"
          ]
        },
        "execution_status": {
          "type": "string",
          "enum": [
            "none-not-required",
            "pending",
            "completed",
            "blocked"
          ]
        },
        "corrective_action_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rollback_completion_ref": {
          "type": "string"
        },
        "supersession_public_shell_ref": {
          "type": "string"
        },
        "correction_public_shell_ref": {
          "type": "string"
        },
        "nonhost_execution_proof_ref": {
          "type": "string"
        },
        "affected_party_completion_notice_ref": {
          "type": "string"
        },
        "redaction_boundary_ref": {
          "type": "string"
        },
        "private_material_locator_redacted": {
          "type": "boolean"
        },
        "execution_artifact_sha256": {
          "type": "string",
          "pattern": "^(none|[0-9a-f]{64})$"
        }
      }
    },
    "execution_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remedy_resolution_replayed",
        "resolution_ready_or_no_signal",
        "execution_status_completed_or_not_required",
        "corrective_actions_recorded_or_not_required",
        "rollback_completion_recorded_if_required",
        "supersession_public_shell_recorded_if_required",
        "correction_public_shell_recorded_if_required",
        "nonhost_execution_proof_present",
        "affected_party_completion_notice_prepared",
        "private_material_not_in_public_release",
        "recompute_and_publication_rollback_rerun_required",
        "no_silence_as_completion"
      ],
      "properties": {
        "remedy_resolution_replayed": {
          "type": "boolean"
        },
        "resolution_ready_or_no_signal": {
          "type": "boolean"
        },
        "execution_status_completed_or_not_required": {
          "type": "boolean"
        },
        "corrective_actions_recorded_or_not_required": {
          "type": "boolean"
        },
        "rollback_completion_recorded_if_required": {
          "type": "boolean"
        },
        "supersession_public_shell_recorded_if_required": {
          "type": "boolean"
        },
        "correction_public_shell_recorded_if_required": {
          "type": "boolean"
        },
        "nonhost_execution_proof_present": {
          "type": "boolean"
        },
        "affected_party_completion_notice_prepared": {
          "type": "boolean"
        },
        "private_material_not_in_public_release": {
          "type": "boolean"
        },
        "recompute_and_publication_rollback_rerun_required": {
          "type": "boolean"
        },
        "no_silence_as_completion": {
          "type": "boolean"
        }
      }
    },
    "execution_freeze_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_continue_published_snapshot_from_execution",
        "may_continue_reliance_from_execution",
        "may_upgrade_reliance_from_execution",
        "may_increment_live_floor_from_execution",
        "manual_publication_override_allowed",
        "execution_silence_counts_as_completion",
        "must_rerun_floor_recompute_and_publication_rollback_after_execution"
      ],
      "properties": {
        "may_continue_published_snapshot_from_execution": {
          "const": false
        },
        "may_continue_reliance_from_execution": {
          "const": false
        },
        "may_upgrade_reliance_from_execution": {
          "const": false
        },
        "may_increment_live_floor_from_execution": {
          "const": false
        },
        "manual_publication_override_allowed": {
          "const": false
        },
        "execution_silence_counts_as_completion": {
          "const": false
        },
        "must_rerun_floor_recompute_and_publication_rollback_after_execution": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remedy_execution_state",
        "may_mark_execution_ready",
        "may_publish_or_continue_snapshot",
        "may_upgrade_reliance",
        "may_increment_live_floor",
        "reason",
        "blocked_actions",
        "next_actions"
      ],
      "properties": {
        "remedy_execution_state": {
          "type": "string",
          "enum": [
            "monitoring-no-signal-no-execution-required",
            "execution-ready-publication-stayed",
            "blocked-remedy-resolution-not-ready",
            "blocked-execution-pending",
            "blocked-corrective-actions-incomplete",
            "blocked-execution-proof-missing",
            "blocked-private-material-in-public-execution"
          ]
        },
        "may_mark_execution_ready": {
          "type": "boolean"
        },
        "may_publish_or_continue_snapshot": {
          "const": false
        },
        "may_upgrade_reliance": {
          "const": false
        },
        "may_increment_live_floor": {
          "const": false
        },
        "reason": {
          "type": "string"
        },
        "blocked_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "no_direct_floor_effect": {
      "const": true
    }
  }
}
