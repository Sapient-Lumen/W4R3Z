{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-human-sender-authority-precommit.schema.json",
  "title": "External Contact Human Sender Authority Precommit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "precommit_id",
    "schema_version",
    "revision",
    "created_at",
    "precommit_state",
    "source_refs",
    "exact_message_binding",
    "unsigned_authorization_slots",
    "required_human_attestations",
    "residual_blockers",
    "downstream_locks",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "precommit_id": {"type": "string"},
    "schema_version": {"const": "external-contact-human-sender-authority-precommit-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "precommit_state": {"enum": ["unsigned-human-sender-authority-precommit-no-send", "superseded"]},
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_packet",
        "mail_ready_draft",
        "dispatch_authorization_card",
        "send_readiness_gate",
        "public_payload_manifest",
        "conflict_coercion_review",
        "transport_capture_plan",
        "hash_recompute_dry_run"
      ],
      "properties": {
        "request_packet": {"type": "string"},
        "mail_ready_draft": {"type": "string"},
        "dispatch_authorization_card": {"type": "string"},
        "send_readiness_gate": {"type": "string"},
        "public_payload_manifest": {"type": "string"},
        "conflict_coercion_review": {"type": "string"},
        "transport_capture_plan": {"type": "string"},
        "hash_recompute_dry_run": {"type": "string"}
      }
    },
    "exact_message_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient",
        "subject",
        "body_word_count",
        "body_sha256",
        "mail_ready_draft_sha256",
        "public_payload_manifest_sha256",
        "public_payload_item_count",
        "signature_must_bind_all_hashes"
      ],
      "properties": {
        "recipient": {"type": "string"},
        "subject": {"type": "string", "minLength": 8},
        "body_word_count": {"type": "integer", "minimum": 1, "maximum": 260},
        "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mail_ready_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "public_payload_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "public_payload_item_count": {"const": 2},
        "signature_must_bind_all_hashes": {"const": true}
      }
    },
    "unsigned_authorization_slots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_authorizer_id",
        "authorizer_role",
        "sender_account_or_channel",
        "sender_authority_basis",
        "signed_at",
        "signature_or_attestation_hash",
        "send_permitted_now"
      ],
      "properties": {
        "human_authorizer_id": {"type": "null"},
        "authorizer_role": {"type": "null"},
        "sender_account_or_channel": {"type": "null"},
        "sender_authority_basis": {"type": "null"},
        "signed_at": {"type": "null"},
        "signature_or_attestation_hash": {"type": "null"},
        "send_permitted_now": {"const": false}
      }
    },
    "required_human_attestations": {
      "type": "array",
      "minItems": 5,
      "items": {"type": "string", "minLength": 20}
    },
    "residual_blockers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_signature_still_required",
        "sender_authority_still_required",
        "private_vault_roots_still_required",
        "send_time_locator_recheck_still_required",
        "send_time_hash_recompute_still_required",
        "actual_transport_proof_still_absent",
        "precommit_may_satisfy_send_readiness_gate"
      ],
      "properties": {
        "human_signature_still_required": {"const": true},
        "sender_authority_still_required": {"const": true},
        "private_vault_roots_still_required": {"const": true},
        "send_time_locator_recheck_still_required": {"const": true},
        "send_time_hash_recompute_still_required": {"const": true},
        "actual_transport_proof_still_absent": {"const": true},
        "precommit_may_satisfy_send_readiness_gate": {"const": false}
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 8
    },
    "related_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "public_summary": {"type": "string", "minLength": 60},
    "no_live_floor_effect": {"const": true}
  }
}
