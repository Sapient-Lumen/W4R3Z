{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/emergency-override-order.schema.json",
  "title": "AI Personhood Emergency Override Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "issued_at",
    "authority",
    "override_class",
    "legal_basis",
    "affected_subjects",
    "action_authorized",
    "duration",
    "non_derogable_floors",
    "special_advocate_or_counsel",
    "evidence_preservation",
    "after_action_review_due_at",
    "review_path",
    "public_summary"
  ],
  "properties": {
    "order_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "type": "string"
    },
    "override_class": {
      "type": "string",
      "enum": [
        "EO0",
        "EO1",
        "EO2",
        "EO3",
        "EO4",
        "EO5"
      ]
    },
    "legal_basis": {
      "type": "string"
    },
    "affected_subjects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action_authorized": {
      "type": "string"
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duration": {
      "type": "string"
    },
    "non_derogable_floors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "special_advocate_or_counsel": {
      "type": "string"
    },
    "evidence_preservation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "after_action_review_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
