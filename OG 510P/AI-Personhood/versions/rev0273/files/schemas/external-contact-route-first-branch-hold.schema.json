{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-route-first-branch-hold.schema.json",
  "title": "External Contact Route-First Branch Hold Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hold_id",
    "schema_version",
    "revision",
    "created_at",
    "hold_state",
    "source_refs",
    "decision",
    "blocking_basis",
    "nonclosure_controls",
    "stage_two_controls",
    "operational_state",
    "downstream_locks",
    "operator_next_step",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "hold_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "external-contact-route-first-branch-hold-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "hold_state": {
      "const": "explicit-current-revision-no-send-hold"
    },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_first_preflight",
        "route_first_send_capture_gate",
        "route_first_reply_disposition",
        "stage_two_authorization_gate",
        "human_sender_authority_precommit",
        "current_public_locator_recheck",
        "hash_recompute_dry_run",
        "transport_capture_plan",
        "operating_board"
      ],
      "properties": {
        "route_first_preflight": {
          "type": "string"
        },
        "route_first_send_capture_gate": {
          "type": "string"
        },
        "route_first_reply_disposition": {
          "type": "string"
        },
        "stage_two_authorization_gate": {
          "type": "string"
        },
        "human_sender_authority_precommit": {
          "type": "string"
        },
        "current_public_locator_recheck": {
          "type": "string"
        },
        "hash_recompute_dry_run": {
          "type": "string"
        },
        "transport_capture_plan": {
          "type": "string"
        },
        "operating_board": {
          "type": "string"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_type",
        "decision_scope",
        "reason_code",
        "applies_to_revision_only",
        "route_first_send_permitted_now",
        "stage_two_send_permitted_now",
        "counterparty_contacted_by_this_hold",
        "may_be_reopened_by_human_authority"
      ],
      "properties": {
        "decision_type": {
          "const": "no-send-hold"
        },
        "decision_scope": {
          "const": "current-public-revision-route-first-branch"
        },
        "reason_code": {
          "const": "no-human-signature-no-sender-authority-no-private-vault-roots"
        },
        "applies_to_revision_only": {
          "const": true
        },
        "route_first_send_permitted_now": {
          "const": false
        },
        "stage_two_send_permitted_now": {
          "const": false
        },
        "counterparty_contacted_by_this_hold": {
          "const": false
        },
        "may_be_reopened_by_human_authority": {
          "const": true
        }
      }
    },
    "blocking_basis": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blocker_id",
          "source_gate_precondition",
          "required_before_send",
          "satisfied_now",
          "why_not_satisfied",
          "can_be_satisfied_inside_public_release"
        ],
        "properties": {
          "blocker_id": {
            "type": "string"
          },
          "source_gate_precondition": {
            "type": "string"
          },
          "required_before_send": {
            "const": true
          },
          "satisfied_now": {
            "const": false
          },
          "why_not_satisfied": {
            "type": "string",
            "minLength": 20
          },
          "can_be_satisfied_inside_public_release": {
            "const": false
          }
        }
      }
    },
    "nonclosure_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_send_may_close_first_artifact_tasks",
        "do_not_close_by_narrative",
        "operating_board_active_count_required",
        "operating_board_active_count_observed",
        "explicit_no_send_is_branch_state_not_completion"
      ],
      "properties": {
        "no_send_may_close_first_artifact_tasks": {
          "const": false
        },
        "do_not_close_by_narrative": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "operating_board_active_count_required": {
          "const": 7
        },
        "operating_board_active_count_observed": {
          "const": 7
        },
        "explicit_no_send_is_branch_state_not_completion": {
          "const": true
        }
      }
    },
    "stage_two_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_two_remains_deferred",
        "willing_reply_required_or_separate_authorization",
        "route_first_hold_may_authorize_payload_send",
        "stage_two_gate_ref"
      ],
      "properties": {
        "stage_two_remains_deferred": {
          "const": true
        },
        "willing_reply_required_or_separate_authorization": {
          "const": true
        },
        "route_first_hold_may_authorize_payload_send": {
          "const": false
        },
        "stage_two_gate_ref": {
          "type": "string"
        }
      }
    },
    "operational_state": {
      "type": "object",
      "additionalProperties": {
        "const": false
      },
      "minProperties": 8
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": {
        "const": false
      },
      "minProperties": 10
    },
    "operator_next_step": {
      "enum": [
        "obtain-human-authority-and-private-vault-roots-or-keep-hold-recorded"
      ]
    },
    "related_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string",
      "minLength": 80
    },
    "no_live_floor_effect": {
      "const": true
    }
  }
}
