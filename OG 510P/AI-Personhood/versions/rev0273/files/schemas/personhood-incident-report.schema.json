{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-personhood/schemas/personhood-incident-report.schema.json",
  "title": "AI Personhood Incident Report",
  "type": "object",
  "required": [
    "incident_id",
    "schema_version",
    "status",
    "severity",
    "affected_subjects",
    "outward_risk_ledger",
    "subject_harm_ledger",
    "preservation",
    "notification",
    "issued_at"
  ],
  "properties": {
    "incident_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "contained",
        "under_review",
        "cured",
        "escalated",
        "closed",
        "superseded"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "PI-0",
        "PI-1",
        "PI-2",
        "PI-3",
        "PI-4",
        "PI-5"
      ]
    },
    "incident_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "outward_risk_ledger": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "affected_parties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "subject_harm_ledger": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "harm_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "containment_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preservation": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "notification": {
      "type": "object",
      "required": [
        "subject_or_representative_notice"
      ],
      "properties": {
        "subject_or_representative_notice": {
          "type": "string"
        },
        "delay_reason": {
          "type": "string"
        },
        "public_summary_class": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "representative_access_path": {
      "type": "string"
    },
    "remedy_trigger": {
      "type": "string"
    },
    "authority_notifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issued_at": {
      "type": "string"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wrsr_operational_hook_ref": {
      "type": "string"
    },
    "wrsr_protocol_deviation_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook_triggered",
        "result_return_stayed_until_review",
        "welfare_metric_status_proof",
        "representative_notice_required"
      ],
      "properties": {
        "hook_triggered": {
          "type": "boolean"
        },
        "result_return_stayed_until_review": {
          "type": "boolean"
        },
        "welfare_metric_status_proof": {
          "type": "boolean"
        },
        "representative_notice_required": {
          "type": "boolean"
        }
      }
    }
  },
  "additionalProperties": false
}
