{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-route-first-preflight.schema.json",
  "title": "External Contact Route-First Preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preflight_id",
    "schema_version",
    "revision",
    "created_at",
    "preflight_state",
    "target_counterparty",
    "risk_reduction_rationale",
    "route_first_message",
    "stage_two_payload",
    "blocking_preconditions",
    "operational_state",
    "downstream_locks",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "preflight_id": {"type": "string"},
    "schema_version": {"const": "external-contact-route-first-preflight-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "preflight_state": {"enum": ["preferred-route-first-no-attachment-blocked-no-human-send", "superseded"]},
    "target_counterparty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "organization_name", "public_channel_locator", "public_source_url", "route_kind", "locator_is_not_consent_or_authority"],
      "properties": {
        "candidate_id": {"type": "string"},
        "organization_name": {"type": "string"},
        "public_channel_locator": {"const": "info@raicollab.org"},
        "public_source_url": {"const": "https://incidentdatabase.ai/contact/"},
        "route_kind": {"const": "collaboration-routing-inquiry-not-incident-submission"},
        "locator_is_not_consent_or_authority": {"const": true}
      }
    },
    "risk_reduction_rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachment_filtering_risk_reduced",
        "counterparty_attention_load_reduced",
        "misclassified_incident_submission_risk_reduced",
        "payload_deferred_until_requested_or_separately_authorized",
        "route_first_may_authorize_send"
      ],
      "properties": {
        "attachment_filtering_risk_reduced": {"const": true},
        "counterparty_attention_load_reduced": {"const": true},
        "misclassified_incident_submission_risk_reduced": {"const": true},
        "payload_deferred_until_requested_or_separately_authorized": {"const": true},
        "route_first_may_authorize_send": {"const": false}
      }
    },
    "route_first_message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "body_ref",
        "mail_ready_draft_ref",
        "body_word_count",
        "body_sha256",
        "mail_ready_draft_sha256",
        "attachments_included",
        "payload_item_count",
        "request_type",
        "may_start_response_clock"
      ],
      "properties": {
        "subject": {"type": "string", "minLength": 12},
        "body_ref": {"type": "string"},
        "mail_ready_draft_ref": {"type": "string"},
        "body_word_count": {"type": "integer", "minimum": 60, "maximum": 180},
        "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mail_ready_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "attachments_included": {"const": false},
        "payload_item_count": {"const": 0},
        "request_type": {"const": "routing-and-willingness-inquiry"},
        "may_start_response_clock": {"const": false}
      }
    },
    "stage_two_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_payload_manifest_ref",
        "payload_items_available_count",
        "send_only_after_counterparty_willingness_or_separate_human_authorization",
        "raw_private_evidence_included",
        "payload_manifest_may_substitute_for_send_proof_or_custody"
      ],
      "properties": {
        "public_payload_manifest_ref": {"type": "string"},
        "payload_items_available_count": {"const": 2},
        "send_only_after_counterparty_willingness_or_separate_human_authorization": {"const": true},
        "raw_private_evidence_included": {"const": false},
        "payload_manifest_may_substitute_for_send_proof_or_custody": {"const": false}
      }
    },
    "blocking_preconditions": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["precondition_id", "required_before_send", "satisfied_now", "reason"],
        "properties": {
          "precondition_id": {"type": "string"},
          "required_before_send": {"const": true},
          "satisfied_now": {"const": false},
          "reason": {"type": "string", "minLength": 20}
        }
      }
    },
    "operational_state": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 7
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 10
    },
    "related_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "public_summary": {"type": "string", "minLength": 80},
    "no_live_floor_effect": {"const": true}
  }
}
