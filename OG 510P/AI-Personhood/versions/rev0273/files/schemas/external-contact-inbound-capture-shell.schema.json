{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-inbound-capture-shell.schema.json",
  "title": "External Contact Inbound Capture Shell",
  "description": "A public-shell control record for staging a future external-contact inbound raw email or provider export. It may record hash, size, MIME, and transport-header assessment, but it cannot itself create response, custody, intake, import, authority, recognition, waiver, adverse inference, or live-floor effect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capture_shell_id",
    "schema_version",
    "revision",
    "created_at",
    "capture_state",
    "source_inbound_vault_precommit_ref",
    "source_send_proof_record_ref",
    "source_response_triage_record_ref",
    "source_execution_record_ref",
    "capture_tool",
    "candidate_payload",
    "transport_parse",
    "public_shell",
    "routing_constraints",
    "downstream_locks",
    "linked_queue_ids",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "capture_shell_id": {"type": "string", "pattern": "^ECICS-[0-9]{4}-[A-Za-z0-9._:-]+$"},
    "schema_version": {"const": "external-contact-inbound-capture-shell-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "capture_state": {"type": "string", "enum": ["pre-dispatch-no-inbound", "candidate-raw-email-staged-public-shell-only", "candidate-provider-export-staged-public-shell-only", "rejected-not-raw", "superseded"]},
    "source_inbound_vault_precommit_ref": {"type": "string", "minLength": 10},
    "source_send_proof_record_ref": {"type": "string", "minLength": 10},
    "source_response_triage_record_ref": {"type": "string", "minLength": 10},
    "source_execution_record_ref": {"type": "string", "minLength": 10},
    "capture_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_path", "raw_input_required_outside_release_tree", "copy_to_private_vault_only", "public_shell_only", "check_output_supported", "tool_is_not_dispatch_or_response"],
      "properties": {
        "tool_path": {"const": "tools/stage_external_contact_inbound_capture.py"},
        "raw_input_required_outside_release_tree": {"const": true},
        "copy_to_private_vault_only": {"const": true},
        "public_shell_only": {"const": true},
        "check_output_supported": {"const": true},
        "tool_is_not_dispatch_or_response": {"const": true}
      }
    },
    "candidate_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_payload_present_now", "source_locator", "private_vault_locator", "raw_sha256", "size_bytes", "mime_type", "message_format", "raw_payload_publicly_embedded", "screenshot_or_redacted_only", "protocol_output_only", "retention_permission_present_now", "nonhost_retention_present_now"],
      "properties": {
        "raw_payload_present_now": {"type": "boolean"},
        "source_locator": {"type": ["string", "null"]},
        "private_vault_locator": {"type": ["string", "null"]},
        "raw_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "mime_type": {"type": ["string", "null"]},
        "message_format": {"type": ["string", "null"], "enum": [null, "rfc5322-rfc6532-message", "provider-export", "unknown"]},
        "raw_payload_publicly_embedded": {"const": false},
        "screenshot_or_redacted_only": {"const": false},
        "protocol_output_only": {"const": false},
        "retention_permission_present_now": {"type": "boolean"},
        "nonhost_retention_present_now": {"type": "boolean"}
      }
    },
    "transport_parse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rfc5322_parse_attempted", "message_id_present", "date_header_present", "from_header_present", "to_or_delivered_to_present", "in_reply_to_or_references_binding_state", "received_or_provider_trace_present", "authentication_results_summary_present", "arc_summary_present", "parse_or_authentication_may_create_authority", "parse_or_authentication_may_start_clock"],
      "properties": {
        "rfc5322_parse_attempted": {"type": "boolean"},
        "message_id_present": {"type": "boolean"},
        "date_header_present": {"type": "boolean"},
        "from_header_present": {"type": "boolean"},
        "to_or_delivered_to_present": {"type": "boolean"},
        "in_reply_to_or_references_binding_state": {"type": "string", "enum": ["not-applicable-no-sent-message", "missing", "present-unverified", "bound-to-sent-message-id"]},
        "received_or_provider_trace_present": {"type": "boolean"},
        "authentication_results_summary_present": {"type": "boolean"},
        "arc_summary_present": {"type": "boolean"},
        "parse_or_authentication_may_create_authority": {"const": false},
        "parse_or_authentication_may_start_clock": {"const": false}
      }
    },
    "public_shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shell_created_now", "allowed_public_fields", "forbidden_public_fields", "shell_may_satisfy_raw_custody", "shell_may_satisfy_counterparty_authority", "shell_may_start_response_clock", "shell_may_publish_raw_bytes"],
      "properties": {
        "shell_created_now": {"type": "boolean"},
        "allowed_public_fields": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "forbidden_public_fields": {"type": "array", "minItems": 8, "items": {"type": "string"}},
        "shell_may_satisfy_raw_custody": {"const": false},
        "shell_may_satisfy_counterparty_authority": {"const": false},
        "shell_may_start_response_clock": {"const": false},
        "shell_may_publish_raw_bytes": {"const": false}
      }
    },
    "routing_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto_ack_route", "decline_route", "human_reply_route", "malformed_or_spoofed_route", "silence_route", "routes_may_create_response_record_directly"],
      "properties": {
        "auto_ack_route": {"type": "string", "minLength": 30},
        "decline_route": {"type": "string", "minLength": 30},
        "human_reply_route": {"type": "string", "minLength": 30},
        "malformed_or_spoofed_route": {"type": "string", "minLength": 30},
        "silence_route": {"type": "string", "minLength": 30},
        "routes_may_create_response_record_directly": {"const": false}
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_treat_capture_shell_as_raw_reply", "may_treat_capture_shell_as_transport_proof", "may_treat_capture_shell_as_authority", "may_start_response_clock", "may_create_response_record", "may_create_custody_record", "may_create_intake_record", "may_create_import_gate", "may_increment_live_floor", "may_claim_status_or_waiver", "may_publish_raw_payload"],
      "properties": {
        "may_treat_capture_shell_as_raw_reply": {"const": false},
        "may_treat_capture_shell_as_transport_proof": {"const": false},
        "may_treat_capture_shell_as_authority": {"const": false},
        "may_start_response_clock": {"const": false},
        "may_create_response_record": {"const": false},
        "may_create_custody_record": {"const": false},
        "may_create_intake_record": {"const": false},
        "may_create_import_gate": {"const": false},
        "may_increment_live_floor": {"const": false},
        "may_claim_status_or_waiver": {"const": false},
        "may_publish_raw_payload": {"const": false}
      }
    },
    "linked_queue_ids": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "related_surfaces": {"type": "array", "minItems": 8, "items": {"type": "string"}},
    "public_summary": {"type": "string", "minLength": 120},
    "no_live_floor_effect": {"const": true}
  }
}
