{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/live-receipt-floor-activation-record.schema.json",
  "title": "Live Receipt Floor Activation Record",
  "description": "Final pre-compute replay gate. It admits an actual receipt import gate into the computed-floor candidate set only after the import readiness gate, cryptographic adapter, duplicate/supersession checks, and challenge/rollback posture are replayed. The activation record itself never increments the floor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activation_record_id",
    "schema_version",
    "created_at",
    "linked_import_gate_ref",
    "linked_import_readiness_gate_ref",
    "linked_cryptographic_verifier_adapter_ref",
    "linked_live_evidence_acquisition_packet_ref",
    "linked_custody_record_ref",
    "requested_receipt_class",
    "activation_state",
    "input_import_summary",
    "replay_checks",
    "floor_recompute_locks",
    "decision",
    "no_live_floor_effect"
  ],
  "properties": {
    "activation_record_id": {
      "type": "string",
      "pattern": "^LRFAR-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "live-receipt-floor-activation-record-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "linked_import_gate_ref": {"type": "string"},
    "linked_import_readiness_gate_ref": {"type": "string"},
    "linked_cryptographic_verifier_adapter_ref": {"type": "string"},
    "linked_live_evidence_acquisition_packet_ref": {"type": "string"},
    "linked_custody_record_ref": {"type": "string"},
    "linked_challenge_or_rollback_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "requested_receipt_class": {
      "type": "string",
      "enum": [
        "first-touch-clock",
        "continuity-compute-floor",
        "sealed-public-parity",
        "namespace-cache",
        "reserve-ledger",
        "representative-contact",
        "witness-dependency",
        "welfare-signal-integrity",
        "independent-review",
        "result-return"
      ]
    },
    "activation_state": {
      "type": "string",
      "enum": [
        "blocked-no-import-gate",
        "blocked-readiness-replay-mismatch",
        "blocked-adapter-replay-missing",
        "blocked-duplicate-or-superseded",
        "blocked-challenge-or-rollback-open",
        "blocked-manual-floor-override",
        "eligible-for-floor-recompute"
      ]
    },
    "input_import_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import_gate_id",
        "import_mode",
        "imported_receipt_class",
        "import_allowed_to_live_floor",
        "live_floor_delta_claimed",
        "collection_context",
        "readiness_gate_ref",
        "cryptographic_adapter_ref",
        "dependency_group",
        "counterparty_org_id",
        "issuer_key_id",
        "subject_host_org_id"
      ],
      "properties": {
        "import_gate_id": {"type": "string"},
        "import_mode": {"type": "string"},
        "imported_receipt_class": {"type": "string"},
        "import_allowed_to_live_floor": {"type": "boolean"},
        "live_floor_delta_claimed": {"type": "integer"},
        "collection_context": {"type": "string"},
        "readiness_gate_ref": {"type": "string"},
        "cryptographic_adapter_ref": {"type": "string"},
        "dependency_group": {"type": "string"},
        "counterparty_org_id": {"type": "string"},
        "issuer_key_id": {"type": "string"},
        "subject_host_org_id": {"type": "string"}
      }
    },
    "replay_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import_gate_actual_live",
        "import_gate_positive_delta_claimed",
        "readiness_gate_exists_and_eligible",
        "readiness_gate_matches_intake_lineage",
        "readiness_gate_authorizes_import_gate_only",
        "readiness_gate_zero_floor_effect",
        "cryptographic_adapter_bound",
        "signature_payload_replayed",
        "request_trace_replayed",
        "nonhost_retention_replayed",
        "sealed_public_parity_replayed",
        "duplicate_counterparty_checked",
        "duplicate_dependency_group_checked",
        "duplicate_receipt_class_checked",
        "supersession_checked",
        "challenge_rollback_checked",
        "failed_gate_summary_ready",
        "no_manual_override",
        "computed_floor_engine_required",
        "private_material_not_in_public_release"
      ],
      "properties": {
        "import_gate_actual_live": {"type": "boolean"},
        "import_gate_positive_delta_claimed": {"type": "boolean"},
        "readiness_gate_exists_and_eligible": {"type": "boolean"},
        "readiness_gate_matches_intake_lineage": {"type": "boolean"},
        "readiness_gate_authorizes_import_gate_only": {"type": "boolean"},
        "readiness_gate_zero_floor_effect": {"type": "boolean"},
        "cryptographic_adapter_bound": {"type": "boolean"},
        "signature_payload_replayed": {"type": "boolean"},
        "request_trace_replayed": {"type": "boolean"},
        "nonhost_retention_replayed": {"type": "boolean"},
        "sealed_public_parity_replayed": {"type": "boolean"},
        "duplicate_counterparty_checked": {"type": "boolean"},
        "duplicate_dependency_group_checked": {"type": "boolean"},
        "duplicate_receipt_class_checked": {"type": "boolean"},
        "supersession_checked": {"type": "boolean"},
        "challenge_rollback_checked": {"type": "boolean"},
        "failed_gate_summary_ready": {"type": "boolean"},
        "no_manual_override": {"type": "boolean"},
        "computed_floor_engine_required": {"type": "boolean"},
        "private_material_not_in_public_release": {"type": "boolean"}
      }
    },
    "floor_recompute_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_enter_computed_floor_candidate_set",
        "manual_floor_increment_allowed",
        "computed_floor_recompute_required",
        "activation_record_can_satisfy_quorum_by_itself",
        "live_floor_delta_allowed_by_activation_record"
      ],
      "properties": {
        "may_enter_computed_floor_candidate_set": {"type": "boolean"},
        "manual_floor_increment_allowed": {"const": false},
        "computed_floor_recompute_required": {"const": true},
        "activation_record_can_satisfy_quorum_by_itself": {"const": false},
        "live_floor_delta_allowed_by_activation_record": {"const": false}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_enter_computed_floor_candidate_set",
        "can_increment_live_floor_by_itself",
        "live_reliance_effect",
        "reason",
        "blocked_actions",
        "next_actions"
      ],
      "properties": {
        "may_enter_computed_floor_candidate_set": {"type": "boolean"},
        "can_increment_live_floor_by_itself": {"const": false},
        "live_reliance_effect": {
          "type": "string",
          "enum": ["blocked", "stayed-until-computed-floor"]
        },
        "reason": {"type": "string"},
        "blocked_actions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    },
    "no_live_floor_effect": {"const": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {"activation_state": {"const": "eligible-for-floor-recompute"}},
        "required": ["activation_state"]
      },
      "then": {
        "properties": {
          "replay_checks": {
            "properties": {
              "import_gate_actual_live": {"const": true},
              "import_gate_positive_delta_claimed": {"const": true},
              "readiness_gate_exists_and_eligible": {"const": true},
              "readiness_gate_matches_intake_lineage": {"const": true},
              "readiness_gate_authorizes_import_gate_only": {"const": true},
              "readiness_gate_zero_floor_effect": {"const": true},
              "cryptographic_adapter_bound": {"const": true},
              "signature_payload_replayed": {"const": true},
              "request_trace_replayed": {"const": true},
              "nonhost_retention_replayed": {"const": true},
              "sealed_public_parity_replayed": {"const": true},
              "duplicate_counterparty_checked": {"const": true},
              "duplicate_dependency_group_checked": {"const": true},
              "duplicate_receipt_class_checked": {"const": true},
              "supersession_checked": {"const": true},
              "challenge_rollback_checked": {"const": true},
              "failed_gate_summary_ready": {"const": true},
              "no_manual_override": {"const": true},
              "computed_floor_engine_required": {"const": true},
              "private_material_not_in_public_release": {"const": true}
            }
          },
          "floor_recompute_locks": {
            "properties": {
              "may_enter_computed_floor_candidate_set": {"const": true}
            }
          },
          "decision": {
            "properties": {
              "may_enter_computed_floor_candidate_set": {"const": true},
              "live_reliance_effect": {"const": "stayed-until-computed-floor"}
            }
          }
        }
      }
    }
  ]
}
