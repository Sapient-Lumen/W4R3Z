{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-request-packet.schema.json",
  "title": "External Contact Request Packet",
  "description": "A sendable but non-satisfying counterparty-contact packet for obtaining the first genuine external artifact without overclaiming receipt, custody, intake, import, or live-floor credit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "schema_version",
    "revision",
    "created_at",
    "packet_state",
    "purpose",
    "linked_request_packet_ref",
    "target_counterparty",
    "outgoing_request",
    "admissibility_preconditions",
    "evidence_handling",
    "downstream_locks",
    "failed_gate_route",
    "tracking",
    "linked_queue_ids",
    "related_surfaces",
    "no_live_floor_effect"
  ],
  "properties": {
    "packet_id": {"type": "string", "pattern": "^ECRP-[0-9]{4}-[A-Za-z0-9._:-]+$"},
    "schema_version": {"const": "external-contact-request-packet-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "packet_state": {"type": "string", "enum": ["draft-not-sent", "ready-to-send", "sent-awaiting-response", "declined-or-no-response", "superseded"]},
    "purpose": {"type": "string", "minLength": 80},
    "linked_request_packet_ref": {"type": "string"},
    "target_counterparty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counterparty_kind", "organization_id", "dependency_group_id", "contact_channel", "named_contact", "host_independence_claim", "selection_note"],
      "properties": {
        "counterparty_kind": {"type": "string", "enum": ["provider", "lab", "auditor", "regulator", "clinic", "civil-society", "other"]},
        "organization_id": {"type": "string"},
        "dependency_group_id": {"type": "string"},
        "contact_channel": {"type": "string"},
        "named_contact": {"type": ["string", "null"]},
        "host_independence_claim": {"type": "string", "enum": ["unknown", "claimed-independent", "not-independent", "to-be-verified"]},
        "selection_note": {"type": "string", "minLength": 40}
      }
    },
    "outgoing_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "body", "requested_artifact_kind", "minimum_counterparty_reply", "not_asking_for", "response_deadline_days", "may_record_decline_or_silence_as_failed_gate"],
      "properties": {
        "subject": {"type": "string", "minLength": 12},
        "body": {"type": "string", "minLength": 500},
        "requested_artifact_kind": {"type": "string", "enum": ["raw-email-reply", "signed-letter", "web-form-receipt", "auditor-note", "provider-documentation-response", "other-raw-counterparty-artifact"]},
        "minimum_counterparty_reply": {"type": "array", "minItems": 5, "items": {"type": "string"}},
        "not_asking_for": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "response_deadline_days": {"type": "integer", "minimum": 1, "maximum": 60},
        "may_record_decline_or_silence_as_failed_gate": {"const": true}
      }
    },
    "admissibility_preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_trace_required", "counterparty_contact_required", "raw_nonhost_bytes_required", "nonhost_retention_required", "sealed_public_parity_required", "counterparty_org_id_required", "dependency_group_id_required", "authority_channel_required", "independent_verifier_required", "subject_or_representative_authorization_required"],
      "properties": {
        "request_trace_required": {"const": true},
        "counterparty_contact_required": {"const": true},
        "raw_nonhost_bytes_required": {"const": true},
        "nonhost_retention_required": {"const": true},
        "sealed_public_parity_required": {"const": true},
        "counterparty_org_id_required": {"const": true},
        "dependency_group_id_required": {"const": true},
        "authority_channel_required": {"const": true},
        "independent_verifier_required": {"const": true},
        "subject_or_representative_authorization_required": {"const": true}
      }
    },
    "evidence_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_payload_private_vault_required", "public_shell_only_before_admission", "no_private_bytes_in_release", "hash_shell_allowed", "redacted_copy_not_raw_custody", "counterparty_secret_protection_required"],
      "properties": {
        "raw_payload_private_vault_required": {"const": true},
        "public_shell_only_before_admission": {"const": true},
        "no_private_bytes_in_release": {"const": true},
        "hash_shell_allowed": {"const": true},
        "redacted_copy_not_raw_custody": {"const": true},
        "counterparty_secret_protection_required": {"const": true}
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_is_not_receipt", "sent_request_not_custody", "response_creation_allowed", "intake_creation_allowed", "import_gate_creation_allowed", "live_floor_delta_allowed", "status_claim_allowed"],
      "properties": {
        "request_is_not_receipt": {"const": true},
        "sent_request_not_custody": {"const": true},
        "response_creation_allowed": {"const": false},
        "intake_creation_allowed": {"const": false},
        "import_gate_creation_allowed": {"const": false},
        "live_floor_delta_allowed": {"const": false},
        "status_claim_allowed": {"const": false}
      }
    },
    "failed_gate_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_failed_gate_summary_required", "decline_is_not_adverse_inference", "silence_is_not_waiver", "retry_policy"],
      "properties": {
        "public_failed_gate_summary_required": {"const": true},
        "decline_is_not_adverse_inference": {"const": true},
        "silence_is_not_waiver": {"const": true},
        "retry_policy": {"type": "string", "minLength": 30}
      }
    },
    "tracking": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "at", "actor", "reliance_effect"],
        "properties": {
          "event": {"type": "string"},
          "at": {"type": "string", "format": "date-time"},
          "actor": {"type": "string"},
          "reliance_effect": {"type": "string", "enum": ["none", "stayed", "blocked"]}
        }
      }
    },
    "linked_queue_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "related_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "public_summary": {"type": "string"},
    "no_live_floor_effect": {"const": true}
  }
}
