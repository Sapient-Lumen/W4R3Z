{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/live-receipt-publication-rollback-adjudication.schema.json",
  "title": "Live Receipt Publication Rollback Adjudication",
  "description": "Post-publication gate for computed-floor posture. It prevents a floor recompute receipt from becoming durable reliance when late challenges, rollback duties, revocations, or supersessions appear after publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publication_adjudication_id",
    "schema_version",
    "created_at",
    "revision",
    "linked_floor_recompute_receipt_ref",
    "linked_computed_snapshot_ref",
    "computed_snapshot_sha256",
    "late_change_refs",
    "observed_publication_summary",
    "adjudication_checks",
    "publication_rollback_locks",
    "decision",
    "no_direct_floor_effect"
  ],
  "properties": {
    "publication_adjudication_id": {
      "type": "string",
      "pattern": "^LRPRA-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "live-receipt-publication-rollback-adjudication-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "linked_floor_recompute_receipt_ref": {
      "type": "string"
    },
    "linked_computed_snapshot_ref": {
      "type": "string"
    },
    "computed_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "late_change_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_publication_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "floor_publication_state",
        "independent_receipts_present",
        "live_floor_delta",
        "cross_critical_quorum_satisfied",
        "reliance_effect",
        "may_publish_snapshot",
        "may_upgrade_reliance"
      ],
      "properties": {
        "floor_publication_state": {
          "type": "string"
        },
        "independent_receipts_present": {
          "type": "integer",
          "minimum": 0
        },
        "live_floor_delta": {
          "type": "integer"
        },
        "cross_critical_quorum_satisfied": {
          "type": "boolean"
        },
        "reliance_effect": {
          "type": "string",
          "enum": [
            "blocked",
            "stayed",
            "conditional",
            "ordinary-reliance"
          ]
        },
        "may_publish_snapshot": {
          "type": "boolean"
        },
        "may_upgrade_reliance": {
          "type": "boolean"
        }
      }
    },
    "adjudication_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recompute_receipt_current_revision",
        "recompute_receipt_publishable",
        "snapshot_hash_matches_recompute_receipt",
        "all_late_challenges_replayed",
        "all_late_signal_ingress_replayed",
        "no_unresolved_late_signal_ingress",
        "all_late_remedy_resolutions_replayed",
        "no_unresolved_late_remedy_resolution",
        "no_open_challenge",
        "no_uncompleted_upheld_rollback",
        "supersession_rechecked",
        "failed_gate_summaries_ready",
        "public_notice_ready",
        "manual_publication_override_absent",
        "recompute_required_after_any_late_change",
        "private_material_not_in_public_release",
        "all_late_remedy_executions_replayed",
        "no_unresolved_late_remedy_execution",
        "all_ready_late_remedies_have_execution_record"
      ],
      "properties": {
        "recompute_receipt_current_revision": {
          "type": "boolean"
        },
        "recompute_receipt_publishable": {
          "type": "boolean"
        },
        "snapshot_hash_matches_recompute_receipt": {
          "type": "boolean"
        },
        "all_late_challenges_replayed": {
          "type": "boolean"
        },
        "no_open_challenge": {
          "type": "boolean"
        },
        "no_uncompleted_upheld_rollback": {
          "type": "boolean"
        },
        "supersession_rechecked": {
          "type": "boolean"
        },
        "failed_gate_summaries_ready": {
          "type": "boolean"
        },
        "public_notice_ready": {
          "type": "boolean"
        },
        "manual_publication_override_absent": {
          "type": "boolean"
        },
        "recompute_required_after_any_late_change": {
          "type": "boolean"
        },
        "private_material_not_in_public_release": {
          "type": "boolean"
        },
        "all_late_signal_ingress_replayed": {
          "type": "boolean"
        },
        "no_unresolved_late_signal_ingress": {
          "type": "boolean"
        },
        "all_late_remedy_resolutions_replayed": {
          "type": "boolean"
        },
        "no_unresolved_late_remedy_resolution": {
          "type": "boolean"
        },
        "all_late_remedy_executions_replayed": {
          "type": "boolean"
        },
        "no_unresolved_late_remedy_execution": {
          "type": "boolean"
        },
        "all_ready_late_remedies_have_execution_record": {
          "type": "boolean"
        }
      }
    },
    "publication_rollback_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_continue_published_snapshot",
        "may_continue_reliance_posture",
        "may_upgrade_reliance",
        "may_increment_live_floor_from_adjudication",
        "manual_publication_override_allowed",
        "recompute_receipt_required_after_late_change",
        "late_challenge_reopens_publication"
      ],
      "properties": {
        "may_continue_published_snapshot": {
          "type": "boolean"
        },
        "may_continue_reliance_posture": {
          "type": "boolean"
        },
        "may_upgrade_reliance": {
          "type": "boolean"
        },
        "may_increment_live_floor_from_adjudication": {
          "const": false
        },
        "manual_publication_override_allowed": {
          "const": false
        },
        "recompute_receipt_required_after_late_change": {
          "const": true
        },
        "late_challenge_reopens_publication": {
          "const": true
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_adjudication_state",
        "may_publish_or_continue_snapshot",
        "may_upgrade_reliance",
        "reliance_effect_after_adjudication",
        "reason",
        "blocked_actions",
        "next_actions"
      ],
      "properties": {
        "publication_adjudication_state": {
          "type": "string",
          "enum": [
            "blocked-recompute-receipt-not-publishable",
            "blocked-snapshot-hash-mismatch",
            "blocked-open-challenge",
            "blocked-rollback-required",
            "blocked-late-change-ingress-open",
            "blocked-late-change-remedy-resolution-open",
            "blocked-remedy-resolution-unexecuted",
            "blocked-late-change-remedy-execution-open",
            "blocked-supersession-unreplayed",
            "eligible-zero-floor-stayed",
            "eligible-class-local-stayed",
            "eligible-reliance-unchanged"
          ]
        },
        "may_publish_or_continue_snapshot": {
          "type": "boolean"
        },
        "may_upgrade_reliance": {
          "type": "boolean"
        },
        "reliance_effect_after_adjudication": {
          "type": "string",
          "enum": [
            "blocked",
            "stayed",
            "ordinary-reliance"
          ]
        },
        "reason": {
          "type": "string"
        },
        "blocked_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "no_direct_floor_effect": {
      "const": true
    }
  }
}
