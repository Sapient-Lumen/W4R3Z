{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/six-artifact-pilot-state.schema.json",
  "title": "Six Artifact Pilot State",
  "description": "A compact operational state machine for the first preservation and formation-review pilot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pilot_id",
    "schema_version",
    "revision",
    "created_at",
    "pilot_state",
    "subject_unit",
    "artifact_chain",
    "outcome_dashboard",
    "blocked_by",
    "next_concrete_action",
    "overclaim_locks",
    "no_live_floor_effect",
    "public_summary"
  ],
  "properties": {
    "pilot_id": {"type": "string", "pattern": "^SAP-[0-9]{4}-[-A-Za-z0-9._:]+$"},
    "schema_version": {"const": "six-artifact-pilot-state-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "pilot_state": {"enum": ["prepared-not-authorized", "sent-awaiting-artifacts", "failed-gate-recorded", "review-in-progress", "public-finding-issued"]},
    "subject_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimant_unit", "scope", "not_resolved_by_this_card"],
      "properties": {
        "claimant_unit": {"type": "string"},
        "scope": {"type": "string"},
        "not_resolved_by_this_card": {"type": "array", "items": {"type": "string"}}
      }
    },
    "artifact_chain": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "artifact_id", "artifact_name", "current_state", "completion_evidence", "owner_role", "next_action", "do_not_count"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1, "maximum": 6},
          "artifact_id": {"type": "string"},
          "artifact_name": {"type": "string"},
          "current_state": {"enum": ["missing", "prepared-not-authorized", "authorized", "received", "failed-gate", "complete"]},
          "completion_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "owner_role": {"type": "string"},
          "next_action": {"type": "string"},
          "do_not_count": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "outcome_dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measures", "file_count_not_a_measure", "gate_count_not_a_measure"],
      "properties": {
        "measures": {"type": "array", "minItems": 6, "items": {"type": "string"}},
        "file_count_not_a_measure": {"const": true},
        "gate_count_not_a_measure": {"const": true}
      }
    },
    "blocked_by": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "next_concrete_action": {"type": "string"},
    "overclaim_locks": {"$ref": "#/$defs/locks"},
    "no_live_floor_effect": {"const": true},
    "public_summary": {"type": "string"}
  },
  "$defs": {
    "locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_substitute_internal_draft_for_artifact",
        "may_close_first_artifact_by_narrative",
        "may_start_response_clock",
        "may_create_custody_intake_import_or_floor_effect",
        "may_claim_status_or_welfare_finding"
      ],
      "properties": {
        "may_substitute_internal_draft_for_artifact": {"const": false},
        "may_close_first_artifact_by_narrative": {"const": false},
        "may_start_response_clock": {"const": false},
        "may_create_custody_intake_import_or_floor_effect": {"const": false},
        "may_claim_status_or_welfare_finding": {"const": false}
      }
    }
  }
}
