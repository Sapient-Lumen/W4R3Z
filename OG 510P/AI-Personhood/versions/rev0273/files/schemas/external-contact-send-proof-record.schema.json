{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-send-proof-record.schema.json",
  "title": "External Contact Send Proof Record",
  "description": "Post-dispatch proof record for one external-contact attempt. It distinguishes a prepared mail draft from an actually sent request, and blocks response clocks, failed-gate shells, custody, intake, import, status, waiver, adverse inference, and live-floor movement until transport proof exists. v0.2 adds an explicit send-trace-shell binding so Message-ID/header/provider-trace evidence cannot be laundered into a response clock or custody.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "schema_version",
    "revision",
    "created_at",
    "send_proof_state",
    "source_request_packet_ref",
    "source_counterparty_selection_dossier_ref",
    "source_dispatch_authorization_card_ref",
    "source_execution_record_ref",
    "source_mail_ready_draft_ref",
    "source_send_trace_shell_ref",
    "selected_recipient",
    "message_binding",
    "draft_guard",
    "send_event",
    "required_when_sent",
    "response_clock_guard",
    "downstream_locks",
    "linked_queue_ids",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^ECSPR-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "external-contact-send-proof-record-v0.2"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "send_proof_state": {
      "type": "string",
      "enum": [
        "not-sent-no-proof",
        "sent-proof-captured",
        "superseded"
      ]
    },
    "source_request_packet_ref": {
      "type": "string",
      "minLength": 10
    },
    "source_counterparty_selection_dossier_ref": {
      "type": "string",
      "minLength": 10
    },
    "source_dispatch_authorization_card_ref": {
      "type": "string",
      "minLength": 10
    },
    "source_execution_record_ref": {
      "type": "string",
      "minLength": 10
    },
    "source_mail_ready_draft_ref": {
      "type": "string",
      "minLength": 10
    },
    "selected_recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "organization_name",
        "public_channel_locator",
        "channel_type",
        "public_source_url",
        "recipient_is_public_locator_only",
        "recipient_is_not_consent",
        "recipient_is_not_authority"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 3
        },
        "organization_name": {
          "type": "string",
          "minLength": 2
        },
        "public_channel_locator": {
          "type": "string",
          "minLength": 6
        },
        "channel_type": {
          "type": "string",
          "enum": [
            "public-email",
            "public-contact-page",
            "public-web-form",
            "public-github-issue",
            "public-feedback-form",
            "other"
          ]
        },
        "public_source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "recipient_is_public_locator_only": {
          "const": true
        },
        "recipient_is_not_consent": {
          "const": true
        },
        "recipient_is_not_authority": {
          "const": true
        }
      }
    },
    "message_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "body_sha256",
        "mail_ready_draft_sha256",
        "request_packet_body_hash_matches",
        "authorization_card_body_hash_matches",
        "draft_to_header_matches_selected_public_channel",
        "draft_subject_matches_request_packet",
        "draft_body_matches_request_packet",
        "draft_headers_mark_not_sent",
        "draft_is_not_transport_proof"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 12
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mail_ready_draft_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "request_packet_body_hash_matches": {
          "const": true
        },
        "authorization_card_body_hash_matches": {
          "const": true
        },
        "draft_to_header_matches_selected_public_channel": {
          "const": true
        },
        "draft_subject_matches_request_packet": {
          "const": true
        },
        "draft_body_matches_request_packet": {
          "const": true
        },
        "draft_headers_mark_not_sent": {
          "const": true
        },
        "draft_is_not_transport_proof": {
          "const": true
        }
      }
    },
    "draft_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mail_ready_draft_present",
        "mail_ready_draft_may_be_imported_by_human",
        "mail_ready_draft_may_be_treated_as_sent",
        "mail_ready_draft_may_start_response_clock",
        "mail_ready_draft_may_create_failed_gate_shell",
        "mail_ready_draft_may_create_custody_or_intake"
      ],
      "properties": {
        "mail_ready_draft_present": {
          "const": true
        },
        "mail_ready_draft_may_be_imported_by_human": {
          "const": true
        },
        "mail_ready_draft_may_be_treated_as_sent": {
          "const": false
        },
        "mail_ready_draft_may_start_response_clock": {
          "const": false
        },
        "mail_ready_draft_may_create_failed_gate_shell": {
          "const": false
        },
        "mail_ready_draft_may_create_custody_or_intake": {
          "const": false
        }
      }
    },
    "send_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sent_at",
        "sent_by_role",
        "transport_channel",
        "transport_proof_ref",
        "message_id_or_header_source_ref",
        "send_trace_public_shell_ref",
        "private_transport_trace_locator",
        "deadline_at",
        "transport_proof_present",
        "send_event_may_create_receipt",
        "send_event_may_create_custody",
        "redaction_policy"
      ],
      "properties": {
        "sent_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "sent_by_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "transport_channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "transport_proof_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "message_id_or_header_source_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "send_trace_public_shell_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "private_transport_trace_locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "transport_proof_present": {
          "type": "boolean"
        },
        "send_event_may_create_receipt": {
          "const": false
        },
        "send_event_may_create_custody": {
          "const": false
        },
        "redaction_policy": {
          "type": "string",
          "minLength": 80
        }
      }
    },
    "required_when_sent": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "response_clock_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock_may_start_now",
        "clock_starts_only_after_sent_at_and_transport_proof",
        "deadline_must_be_computed_from_actual_sent_at",
        "auto_ack_routes_to_triage_not_response",
        "silence_is_not_waiver",
        "decline_is_not_adverse_inference"
      ],
      "properties": {
        "clock_may_start_now": {
          "const": false
        },
        "clock_starts_only_after_sent_at_and_transport_proof": {
          "const": true
        },
        "deadline_must_be_computed_from_actual_sent_at": {
          "const": true
        },
        "auto_ack_routes_to_triage_not_response": {
          "const": true
        },
        "silence_is_not_waiver": {
          "const": true
        },
        "decline_is_not_adverse_inference": {
          "const": true
        }
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_treat_draft_as_sent",
        "may_treat_send_proof_as_response",
        "may_create_failed_gate_shell_now",
        "may_create_custody_record",
        "may_create_response_record",
        "may_create_intake_record",
        "may_create_import_gate",
        "may_increment_live_floor",
        "may_claim_status_or_waiver",
        "may_publish_raw_payload"
      ],
      "properties": {
        "may_treat_draft_as_sent": {
          "const": false
        },
        "may_treat_send_proof_as_response": {
          "const": false
        },
        "may_create_failed_gate_shell_now": {
          "const": false
        },
        "may_create_custody_record": {
          "const": false
        },
        "may_create_response_record": {
          "const": false
        },
        "may_create_intake_record": {
          "const": false
        },
        "may_create_import_gate": {
          "const": false
        },
        "may_increment_live_floor": {
          "const": false
        },
        "may_claim_status_or_waiver": {
          "const": false
        },
        "may_publish_raw_payload": {
          "const": false
        }
      }
    },
    "linked_queue_ids": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "related_surfaces": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string",
      "minLength": 120
    },
    "no_live_floor_effect": {
      "const": true
    },
    "source_send_trace_shell_ref": {
      "type": "string",
      "minLength": 10
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "send_proof_state": {
            "const": "not-sent-no-proof"
          }
        },
        "required": [
          "send_proof_state"
        ]
      },
      "then": {
        "properties": {
          "send_event": {
            "properties": {
              "sent_at": {
                "const": null
              },
              "sent_by_role": {
                "const": null
              },
              "transport_channel": {
                "const": null
              },
              "transport_proof_ref": {
                "const": null
              },
              "message_id_or_header_source_ref": {
                "const": null
              },
              "send_trace_public_shell_ref": {
                "const": null
              },
              "private_transport_trace_locator": {
                "const": null
              },
              "deadline_at": {
                "const": null
              },
              "transport_proof_present": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "send_proof_state": {
            "const": "sent-proof-captured"
          }
        },
        "required": [
          "send_proof_state"
        ]
      },
      "then": {
        "properties": {
          "send_event": {
            "properties": {
              "sent_at": {
                "type": "string",
                "format": "date-time"
              },
              "sent_by_role": {
                "type": "string",
                "minLength": 3
              },
              "transport_channel": {
                "type": "string",
                "minLength": 3
              },
              "transport_proof_ref": {
                "type": "string",
                "minLength": 6
              },
              "message_id_or_header_source_ref": {
                "type": "string",
                "minLength": 6
              },
              "send_trace_public_shell_ref": {
                "type": "string",
                "minLength": 6
              },
              "private_transport_trace_locator": {
                "type": "string",
                "minLength": 6
              },
              "deadline_at": {
                "type": "string",
                "format": "date-time"
              },
              "transport_proof_present": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
