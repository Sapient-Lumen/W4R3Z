{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/live-receipt-late-change-ingress-record.schema.json",
  "title": "Live Receipt Late Change Ingress Record",
  "description": "Ingress gate for post-publication challenge, revocation, supersession, rollback, correction, or hash-mismatch signals. It captures and routes late signals into publication rollback adjudication without allowing the ingress object to continue publication, upgrade reliance, or alter the floor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "late_change_ingress_id",
    "schema_version",
    "created_at",
    "revision",
    "linked_publication_adjudication_ref",
    "linked_floor_recompute_receipt_ref",
    "linked_computed_snapshot_ref",
    "signal_summary",
    "ingress_checks",
    "publication_freeze_locks",
    "decision",
    "no_direct_floor_effect"
  ],
  "properties": {
    "late_change_ingress_id": {
      "type": "string",
      "pattern": "^LRLCI-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "live-receipt-late-change-ingress-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "linked_publication_adjudication_ref": {
      "type": "string"
    },
    "linked_floor_recompute_receipt_ref": {
      "type": "string"
    },
    "linked_computed_snapshot_ref": {
      "type": "string"
    },
    "signal_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_late_signal_present",
        "signal_type",
        "source_actor_class",
        "source_identity_ref",
        "target_receipt_or_publication_ref",
        "received_at",
        "nonhost_retention_ref",
        "public_summary_ref",
        "private_material_locator_redacted"
      ],
      "properties": {
        "live_late_signal_present": {
          "type": "boolean"
        },
        "signal_type": {
          "type": "string",
          "enum": [
            "none",
            "challenge",
            "revocation",
            "supersession",
            "rollback-evidence",
            "counterparty-correction",
            "hash-mismatch",
            "authority-withdrawal"
          ]
        },
        "source_actor_class": {
          "type": "string",
          "enum": [
            "none",
            "counterparty",
            "representative",
            "auditor",
            "subject-advocate",
            "verifier",
            "steward",
            "public-monitor"
          ]
        },
        "source_identity_ref": {
          "type": "string"
        },
        "target_receipt_or_publication_ref": {
          "type": "string"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "nonhost_retention_ref": {
          "type": "string"
        },
        "public_summary_ref": {
          "type": "string"
        },
        "private_material_locator_redacted": {
          "type": "boolean"
        },
        "supersedes_or_revokes_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signal_artifact_sha256": {
          "type": "string",
          "pattern": "^(none|[0-9a-f]{64})$"
        },
        "receipt_class": {
          "type": "string"
        },
        "dependency_group": {
          "type": "string"
        }
      }
    },
    "ingress_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_source_identified",
        "binds_to_existing_publication_or_receipt",
        "nonhost_retention_present",
        "independent_timestamp_present",
        "signature_or_contact_channel_captured",
        "supersession_scope_recorded",
        "rollback_trigger_classified",
        "public_notice_required",
        "public_notice_prepared",
        "recompute_required_after_signal",
        "publication_continuation_stayed",
        "private_material_not_in_public_release"
      ],
      "properties": {
        "signal_source_identified": {
          "type": "boolean"
        },
        "binds_to_existing_publication_or_receipt": {
          "type": "boolean"
        },
        "nonhost_retention_present": {
          "type": "boolean"
        },
        "independent_timestamp_present": {
          "type": "boolean"
        },
        "signature_or_contact_channel_captured": {
          "type": "boolean"
        },
        "supersession_scope_recorded": {
          "type": "boolean"
        },
        "rollback_trigger_classified": {
          "type": "boolean"
        },
        "public_notice_required": {
          "type": "boolean"
        },
        "public_notice_prepared": {
          "type": "boolean"
        },
        "recompute_required_after_signal": {
          "type": "boolean"
        },
        "publication_continuation_stayed": {
          "type": "boolean"
        },
        "private_material_not_in_public_release": {
          "type": "boolean"
        }
      }
    },
    "publication_freeze_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_continue_published_snapshot_from_ingress",
        "may_continue_reliance_from_ingress",
        "may_upgrade_reliance_from_ingress",
        "may_increment_live_floor_from_ingress",
        "manual_publication_override_allowed",
        "must_rerun_publication_rollback_adjudication_if_signal_present",
        "late_signal_reopens_publication"
      ],
      "properties": {
        "may_continue_published_snapshot_from_ingress": {
          "const": false
        },
        "may_continue_reliance_from_ingress": {
          "const": false
        },
        "may_upgrade_reliance_from_ingress": {
          "const": false
        },
        "may_increment_live_floor_from_ingress": {
          "const": false
        },
        "manual_publication_override_allowed": {
          "const": false
        },
        "must_rerun_publication_rollback_adjudication_if_signal_present": {
          "const": true
        },
        "late_signal_reopens_publication": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "late_change_state",
        "may_trigger_publication_rollback_adjudication",
        "may_publish_or_continue_snapshot",
        "may_upgrade_reliance",
        "reason",
        "blocked_actions",
        "next_actions"
      ],
      "properties": {
        "late_change_state": {
          "type": "string",
          "enum": [
            "monitoring-no-signal",
            "opened-publication-rollback-required",
            "blocked-unretained-signal",
            "blocked-private-material-in-public-ingress",
            "blocked-supersession-unrouted",
            "blocked-unknown-source"
          ]
        },
        "may_trigger_publication_rollback_adjudication": {
          "type": "boolean"
        },
        "may_publish_or_continue_snapshot": {
          "const": false
        },
        "may_upgrade_reliance": {
          "const": false
        },
        "reason": {
          "type": "string"
        },
        "blocked_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "no_direct_floor_effect": {
      "const": true
    }
  }
}
