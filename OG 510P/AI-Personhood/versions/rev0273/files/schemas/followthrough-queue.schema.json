{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/followthrough-queue.schema.json",
  "title": "AI Personhood Followthrough Queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "queue_id",
    "revision",
    "updated_at",
    "normalization_policy",
    "active_triage",
    "entries"
  ],
  "properties": {
    "queue_id": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "normalization_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "state_vocabulary",
        "priority_vocabulary",
        "required_entry_fields",
        "closure_rule"
      ],
      "properties": {
        "state_vocabulary": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "priority_vocabulary": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "required_entry_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "closure_rule": {
          "type": "string"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "state",
          "priority",
          "risk_class",
          "workstream",
          "need",
          "why",
          "receiving_surface",
          "next_action",
          "closure_condition",
          "source_state",
          "source_revision",
          "review_by_revision"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "queued",
              "advanced_not_closed",
              "closed",
              "deferred",
              "quarantined"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "risk_class": {
            "type": "string"
          },
          "workstream": {
            "type": "string"
          },
          "need": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "receiving_surface": {
            "type": "string"
          },
          "next_action": {
            "type": "string"
          },
          "closure_condition": {
            "type": "string"
          },
          "source_state": {
            "type": "string"
          },
          "source_revision": {
            "type": "string"
          },
          "review_by_revision": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "active_triage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triage_id",
        "revision",
        "state",
        "max_active_items",
        "items",
        "excluded_backlog_policy"
      ],
      "properties": {
        "triage_id": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^rev[0-9]{4}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "execution-focus",
            "superseded"
          ]
        },
        "max_active_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "queue_id",
              "why_now",
              "completion_test",
              "defer_until"
            ],
            "properties": {
              "queue_id": {
                "type": "string"
              },
              "why_now": {
                "type": "string"
              },
              "completion_test": {
                "type": "string"
              },
              "defer_until": {
                "type": "string"
              }
            }
          }
        },
        "excluded_backlog_policy": {
          "type": "string"
        }
      }
    }
  }
}
