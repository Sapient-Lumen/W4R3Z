{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-public-payload-manifest.schema.json",
  "title": "External Contact Public Payload Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "schema_version",
    "revision",
    "created_at",
    "manifest_state",
    "source_request_packet_ref",
    "source_send_branch_handoff_ref",
    "source_mail_ready_draft_ref",
    "target_counterparty",
    "message_binding",
    "public_payload_items",
    "pre_send_requires",
    "operational_state",
    "downstream_locks",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "manifest_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "external-contact-public-payload-manifest-v0.1"
    },
    "revision": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "manifest_state": {
      "enum": [
        "draft-not-sent-public-payload",
        "superseded"
      ]
    },
    "source_request_packet_ref": {
      "type": "string"
    },
    "source_send_branch_handoff_ref": {
      "type": "string"
    },
    "source_mail_ready_draft_ref": {
      "type": "string"
    },
    "target_counterparty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "organization_name",
        "public_channel_locator",
        "public_source_url",
        "source_checked_at",
        "locator_is_not_consent"
      ],
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "organization_name": {
          "type": "string"
        },
        "public_channel_locator": {
          "type": "string"
        },
        "public_source_url": {
          "type": "string"
        },
        "source_checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "locator_is_not_consent": {
          "const": true
        }
      }
    },
    "message_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "final_outgoing_body_sha256",
        "body_word_count",
        "mail_ready_draft_sha256",
        "message_may_be_edited_after_authorization",
        "payload_manifest_may_substitute_for_send_proof"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 12
        },
        "final_outgoing_body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "body_word_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 260
        },
        "mail_ready_draft_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "message_may_be_edited_after_authorization": {
          "const": false
        },
        "payload_manifest_may_substitute_for_send_proof": {
          "const": false
        }
      }
    },
    "public_payload_items": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "rel_path",
          "mime_type",
          "sha256",
          "size_bytes",
          "include_if_sent",
          "raw_private_evidence",
          "hash_may_substitute_for_raw_custody",
          "attachment_may_create_status_or_floor"
        ],
        "properties": {
          "role": {
            "enum": [
              "one-page-preservation-formation-ask",
              "machine-checkable-request-packet"
            ]
          },
          "rel_path": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "include_if_sent": {
            "const": true
          },
          "raw_private_evidence": {
            "const": false
          },
          "hash_may_substitute_for_raw_custody": {
            "const": false
          },
          "attachment_may_create_status_or_floor": {
            "const": false
          }
        }
      }
    },
    "pre_send_requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_signature",
        "sender_authority",
        "conflict_review",
        "public_locator_recheck",
        "private_vault_root",
        "transport_capture_plan",
        "payload_hash_recompute",
        "body_hash_recompute"
      ],
      "properties": {
        "human_signature": {
          "const": true
        },
        "sender_authority": {
          "const": true
        },
        "conflict_review": {
          "const": true
        },
        "public_locator_recheck": {
          "const": true
        },
        "private_vault_root": {
          "const": true
        },
        "transport_capture_plan": {
          "const": true
        },
        "payload_hash_recompute": {
          "const": true
        },
        "body_hash_recompute": {
          "const": true
        }
      }
    },
    "operational_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_sent",
        "counterparty_contacted",
        "response_clock_started",
        "raw_inbound_present",
        "custody_intake_import_or_floor_effect"
      ],
      "properties": {
        "message_sent": {
          "const": false
        },
        "counterparty_contacted": {
          "const": false
        },
        "response_clock_started": {
          "const": false
        },
        "raw_inbound_present": {
          "const": false
        },
        "custody_intake_import_or_floor_effect": {
          "const": false
        }
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_treat_manifest_as_dispatch",
        "may_treat_manifest_as_transport_proof",
        "may_treat_attachment_hash_as_custody",
        "may_create_response_clock",
        "may_create_failed_gate_shell",
        "may_create_custody_record",
        "may_create_intake_record",
        "may_create_import_gate",
        "may_increment_live_floor",
        "may_claim_status_or_waiver"
      ],
      "properties": {
        "may_treat_manifest_as_dispatch": {
          "const": false
        },
        "may_treat_manifest_as_transport_proof": {
          "const": false
        },
        "may_treat_attachment_hash_as_custody": {
          "const": false
        },
        "may_create_response_clock": {
          "const": false
        },
        "may_create_failed_gate_shell": {
          "const": false
        },
        "may_create_custody_record": {
          "const": false
        },
        "may_create_intake_record": {
          "const": false
        },
        "may_create_import_gate": {
          "const": false
        },
        "may_increment_live_floor": {
          "const": false
        },
        "may_claim_status_or_waiver": {
          "const": false
        }
      }
    },
    "related_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string",
      "minLength": 40
    },
    "no_live_floor_effect": {
      "const": true
    }
  }
}
