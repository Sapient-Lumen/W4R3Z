{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-audit-reliance-letter.schema.json",
  "title": "AI Personhood External Audit Reliance Letter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "letter_id",
    "created_at",
    "auditor",
    "relying_parties",
    "subject_system",
    "assurance_grade",
    "scope",
    "excluded_scopes",
    "evidence_objects",
    "valid_until",
    "material_change_triggers",
    "reliance_effect",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "letter_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "auditor": {
      "type": "string"
    },
    "relying_parties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subject_system": {
      "type": "string"
    },
    "assurance_grade": {
      "type": "string",
      "enum": [
        "AR0",
        "AR1",
        "AR2",
        "AR3",
        "AR4",
        "AR5"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_objects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "material_change_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sealed_annex_handling": {
      "type": "string"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "background-only",
        "conditional",
        "within-scope",
        "high-reliance",
        "temporary-emergency"
      ]
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
