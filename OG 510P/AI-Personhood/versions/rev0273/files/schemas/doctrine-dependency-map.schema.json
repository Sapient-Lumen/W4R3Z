{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/doctrine-dependency-map.schema.json",
  "title": "AI Personhood Doctrine Dependency Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "map_id",
    "created_at",
    "revision",
    "scope",
    "surfaces",
    "audit_findings",
    "refactor_actions",
    "public_summary"
  ],
  "properties": {
    "map_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface_id",
          "path",
          "layer",
          "depends_on",
          "overlaps_with",
          "supersedes",
          "owner_role",
          "review_cadence",
          "refactor_risk"
        ],
        "properties": {
          "surface_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "layer": {
            "type": "string",
            "enum": [
              "meta",
              "foundation",
              "world-design",
              "transition",
              "quarantine"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "overlaps_with": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner_role": {
            "type": "string"
          },
          "review_cadence": {
            "type": "string"
          },
          "refactor_risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    },
    "audit_findings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "refactor_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "public_summary": {
      "type": "string"
    }
  }
}
