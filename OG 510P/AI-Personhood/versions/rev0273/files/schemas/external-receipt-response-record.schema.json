{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-receipt-response-record.schema.json",
  "title": "External Receipt Response Record",
  "description": "Records a counterparty response to an external receipt request without allowing response, intake, class satisfaction, and live quorum to collapse into one step.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_record_id",
    "schema_version",
    "created_at",
    "linked_request_packet",
    "linked_live_drill_packet",
    "requested_receipt_class",
    "response_state",
    "counterparty_role",
    "counterparty_identity_ref",
    "source_external_to_host",
    "dependency_group",
    "response_channel",
    "received_at",
    "response_artifacts",
    "verification_result",
    "resulting_intake_record_ref",
    "quorum_effect",
    "public_summary_ref"
  ],
  "properties": {
    "response_record_id": {
      "type": "string",
      "pattern": "^ERRR-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "external-receipt-response-record-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "linked_request_packet": {
      "type": "string"
    },
    "linked_live_drill_packet": {
      "type": "string"
    },
    "requested_receipt_class": {
      "type": "string",
      "enum": [
        "first-touch-clock",
        "continuity-compute-floor",
        "sealed-public-parity",
        "namespace-cache",
        "reserve-ledger",
        "representative-contact",
        "witness-dependency",
        "welfare-signal-integrity",
        "independent-review",
        "result-return"
      ]
    },
    "response_state": {
      "type": "string",
      "enum": [
        "draft-response-template",
        "high-fidelity-dry-run-response",
        "actual-response-received",
        "declined-response",
        "no-response-expired",
        "defective-response",
        "quarantined",
        "superseded"
      ]
    },
    "counterparty_role": {
      "type": "string"
    },
    "counterparty_identity_ref": {
      "type": "string"
    },
    "source_external_to_host": {
      "type": "boolean"
    },
    "dependency_group": {
      "type": "string"
    },
    "response_channel": {
      "type": "string",
      "enum": [
        "non-host-email",
        "signed-web-form",
        "docket-upload",
        "sealed-transfer",
        "public-shell",
        "synthetic-lab-channel",
        "unknown"
      ]
    },
    "received_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "response_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "locator_or_hash",
          "generated_by",
          "retained_by",
          "sealed",
          "dry_run"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "artifact_type": {
            "type": "string",
            "enum": [
              "signed-response",
              "unsigned-response",
              "declination",
              "timestamp",
              "hash",
              "log",
              "public-failed-gate",
              "sealed-descriptor"
            ]
          },
          "locator_or_hash": {
            "type": "string"
          },
          "generated_by": {
            "type": "string",
            "enum": [
              "external-counterparty",
              "host",
              "neutral-infrastructure",
              "synthetic"
            ]
          },
          "retained_by": {
            "type": "string"
          },
          "sealed": {
            "type": "boolean"
          },
          "dry_run": {
            "type": "boolean"
          }
        }
      }
    },
    "verification_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counterparty_confirmed",
        "signature_or_equivalent_verified",
        "timestamp_independent",
        "request_trace_matches",
        "nonhost_retention_verified",
        "dependency_checked",
        "stale_or_superseded",
        "can_generate_actual_intake"
      ],
      "properties": {
        "counterparty_confirmed": {
          "type": "boolean"
        },
        "signature_or_equivalent_verified": {
          "type": "boolean"
        },
        "timestamp_independent": {
          "type": "boolean"
        },
        "request_trace_matches": {
          "type": "boolean"
        },
        "nonhost_retention_verified": {
          "type": "boolean"
        },
        "dependency_checked": {
          "type": "boolean"
        },
        "stale_or_superseded": {
          "type": "boolean"
        },
        "can_generate_actual_intake": {
          "type": "boolean"
        }
      }
    },
    "resulting_intake_record_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "quorum_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_create_live_intake",
        "can_satisfy_quorum_by_itself",
        "can_increment_independent_receipts_present",
        "live_weight",
        "dry_run_weight",
        "reliance_effect",
        "limit_reasons",
        "public_failed_gate_summary_required"
      ],
      "properties": {
        "can_create_live_intake": {
          "type": "boolean"
        },
        "can_satisfy_quorum_by_itself": {
          "type": "boolean"
        },
        "can_increment_independent_receipts_present": {
          "type": "boolean"
        },
        "live_weight": {
          "type": "number",
          "minimum": 0
        },
        "dry_run_weight": {
          "type": "number",
          "minimum": 0
        },
        "reliance_effect": {
          "type": "string",
          "enum": [
            "none",
            "conditional",
            "stayed",
            "blocked"
          ]
        },
        "limit_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "public_failed_gate_summary_required": {
          "type": "boolean"
        }
      }
    },
    "public_summary_ref": {
      "type": "string"
    },
    "linked_live_evidence_acquisition_packet_ref": {
      "type": "string",
      "description": "Required when response_state is actual-response-received; links response creation to an admitted LEAP rather than a protocol/tool output."
    },
    "linked_custody_record_ref": {
      "type": "string",
      "description": "Required when response_state is actual-response-received; response creation cannot precede raw artifact custody admission."
    },
    "linked_response_verification_gate_ref": {
      "type": "string",
      "description": "Required when an actual response can generate an actual intake candidate; live gates must bind a response verification gate, controlled fixtures must mark the fixture gate explicitly."
    },
    "linked_intake_conversion_gate_ref": {
      "type": "string",
      "description": "Required when resulting_intake_record_ref is populated; binds any intake candidate to a separate intake conversion gate rather than the response record alone."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "response_state": {
            "const": "actual-response-received"
          }
        },
        "required": [
          "response_state"
        ],
        "not": {
          "properties": {
            "quorum_effect": {
              "properties": {
                "can_increment_independent_receipts_present": {
                  "const": false
                },
                "live_weight": {
                  "const": 0
                },
                "dry_run_weight": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "can_increment_independent_receipts_present",
                "live_weight",
                "dry_run_weight"
              ]
            }
          },
          "required": [
            "quorum_effect"
          ]
        }
      },
      "then": {
        "required": [
          "linked_live_evidence_acquisition_packet_ref",
          "linked_custody_record_ref"
        ]
      }
    },
    {
      "description": "actual responses capable of intake require a response verification gate and remain non-quorum by themselves",
      "if": {
        "properties": {
          "response_state": {
            "const": "actual-response-received"
          },
          "verification_result": {
            "properties": {
              "can_generate_actual_intake": {
                "const": true
              }
            },
            "required": [
              "can_generate_actual_intake"
            ]
          }
        },
        "required": [
          "response_state",
          "verification_result"
        ]
      },
      "then": {
        "required": [
          "linked_response_verification_gate_ref"
        ],
        "properties": {
          "quorum_effect": {
            "properties": {
              "can_satisfy_quorum_by_itself": {
                "const": false
              },
              "can_increment_independent_receipts_present": {
                "const": false
              },
              "live_weight": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "description": "response records that name a resulting intake must bind a separate intake conversion gate",
      "if": {
        "properties": {
          "resulting_intake_record_ref": {
            "type": "string"
          }
        },
        "required": [
          "resulting_intake_record_ref"
        ]
      },
      "then": {
        "required": [
          "linked_intake_conversion_gate_ref"
        ]
      }
    }
  ]
}
