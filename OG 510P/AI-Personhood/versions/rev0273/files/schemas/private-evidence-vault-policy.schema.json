{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/private-evidence-vault-policy.schema.json",
  "title": "Private Evidence Vault Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "schema_version", "revision", "created_at", "threat_model", "raw_vault", "public_release_shell", "release_guard", "allowed_public_artifacts", "dry_run_verification", "decision", "public_summary"],
  "properties": {
    "policy_id": {"type": "string"},
    "schema_version": {"const": "private-evidence-vault-policy-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "threat_model": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "raw_vault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_policy", "default_env_var", "locator_scheme", "forbidden_release_prefixes", "raw_payload_may_enter_examples_artifacts", "source_locator_publication"],
      "properties": {
        "root_policy": {"const": "outside-release-tree"},
        "default_env_var": {"type": "string"},
        "locator_scheme": {"const": "private-vault://"},
        "forbidden_release_prefixes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "raw_payload_may_enter_examples_artifacts": {"const": false},
        "source_locator_publication": {"const": "redacted-hash-only"}
      }
    },
    "public_release_shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_for_live_candidate", "schema_path", "allowed_public_fields", "forbidden_public_fields", "failed_gate_required_when_blocked"],
      "properties": {
        "required_for_live_candidate": {"const": true},
        "schema_path": {"type": "string"},
        "allowed_public_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "forbidden_public_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "failed_gate_required_when_blocked": {"const": true}
      }
    },
    "release_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_path", "called_by", "hard_fail_conditions"],
      "properties": {
        "tool_path": {"type": "string"},
        "called_by": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "hard_fail_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "allowed_public_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "classification", "reason"],
        "properties": {
          "path": {"type": "string"},
          "classification": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "dry_run_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "synthetic_live_candidate_externalized", "source_locator_redacted", "raw_private_payload_bytes_packaged", "hash_commitment_publicly_checkable"],
      "properties": {
        "status": {"type": "string"},
        "synthetic_live_candidate_externalized": {"type": "boolean"},
        "source_locator_redacted": {"type": "boolean"},
        "raw_private_payload_bytes_packaged": {"const": false},
        "hash_commitment_publicly_checkable": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_stage_real_artifact", "may_package_raw_live_payload", "may_increment_live_floor"],
      "properties": {
        "may_stage_real_artifact": {"type": "string"},
        "may_package_raw_live_payload": {"const": false},
        "may_increment_live_floor": {"const": false}
      }
    },
    "public_summary": {"type": "string"}
  }
}
