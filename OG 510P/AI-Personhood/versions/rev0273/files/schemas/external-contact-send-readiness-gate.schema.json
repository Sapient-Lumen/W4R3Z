{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-send-readiness-gate.schema.json",
  "title": "External Contact Send Readiness Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_id",
    "schema_version",
    "revision",
    "created_at",
    "gate_state",
    "source_refs",
    "target_counterparty",
    "message_binding",
    "blocking_preconditions",
    "blocker_resolution_summary",
    "operator_next_step",
    "if_send_capture_plan",
    "if_reply_classification_order",
    "queue_refactor_audit",
    "downstream_locks",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "gate_id": {
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "external-contact-send-readiness-gate-v0.1",
        "external-contact-send-readiness-gate-v0.2",
        "external-contact-send-readiness-gate-v0.3"
      ]
    },
    "revision": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "gate_state": {
      "enum": [
        "blocked-no-human-send",
        "superseded"
      ]
    },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_packet",
        "send_branch_handoff",
        "public_payload_manifest",
        "mail_ready_draft",
        "dispatch_authorization_card",
        "send_proof_record",
        "send_trace_shell",
        "delivery_status_record",
        "inbound_vault_precommit",
        "inbound_capture_shell",
        "response_triage_record",
        "operating_board",
        "route_fit_review",
        "transport_capture_plan",
        "conflict_coercion_review",
        "hash_recompute_dry_run"
      ],
      "properties": {
        "request_packet": {
          "type": "string"
        },
        "send_branch_handoff": {
          "type": "string"
        },
        "public_payload_manifest": {
          "type": "string"
        },
        "mail_ready_draft": {
          "type": "string"
        },
        "dispatch_authorization_card": {
          "type": "string"
        },
        "send_proof_record": {
          "type": "string"
        },
        "send_trace_shell": {
          "type": "string"
        },
        "delivery_status_record": {
          "type": "string"
        },
        "inbound_vault_precommit": {
          "type": "string"
        },
        "inbound_capture_shell": {
          "type": "string"
        },
        "response_triage_record": {
          "type": "string"
        },
        "operating_board": {
          "type": "string"
        },
        "route_fit_review": {
          "type": "string"
        },
        "transport_capture_plan": {
          "type": "string"
        },
        "conflict_coercion_review": {
          "type": "string"
        },
        "hash_recompute_dry_run": {
          "type": "string"
        }
      }
    },
    "target_counterparty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "organization_name",
        "public_channel_locator",
        "public_source_url",
        "public_locator_recheck_required",
        "route_fit_review_required",
        "locator_is_not_consent_or_authority"
      ],
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "organization_name": {
          "type": "string"
        },
        "public_channel_locator": {
          "type": "string"
        },
        "public_source_url": {
          "type": "string"
        },
        "public_locator_recheck_required": {
          "const": true
        },
        "route_fit_review_required": {
          "const": true
        },
        "locator_is_not_consent_or_authority": {
          "const": true
        }
      }
    },
    "message_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "body_word_count",
        "body_sha256",
        "mail_ready_draft_sha256",
        "public_payload_manifest_sha256",
        "public_payload_item_count",
        "payload_manifest_may_substitute_for_send_proof",
        "draft_may_be_edited_after_authorization"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 12
        },
        "body_word_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 260
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mail_ready_draft_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "public_payload_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "public_payload_item_count": {
          "const": 2
        },
        "payload_manifest_may_substitute_for_send_proof": {
          "const": false
        },
        "draft_may_be_edited_after_authorization": {
          "const": false
        }
      }
    },
    "blocking_preconditions": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "precondition_id",
          "label",
          "required_before_send",
          "satisfied_now",
          "evidence_required",
          "failure_mode_blocked"
        ],
        "properties": {
          "precondition_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "required_before_send": {
            "const": true
          },
          "satisfied_now": {
            "type": "boolean"
          },
          "evidence_required": {
            "type": "string",
            "minLength": 8
          },
          "failure_mode_blocked": {
            "type": "string",
            "minLength": 8
          },
          "satisfied_by_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "operator_next_step": {
      "enum": [
        "human-send-with-proof-or-explicit-no-send-decision"
      ]
    },
    "if_send_capture_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_before_clicking_send",
        "capture_immediately_after_send",
        "capture_before_reading_reply",
        "raw_locations_stay_outside_release_tree",
        "public_release_may_publish_raw_transport_or_reply_bytes"
      ],
      "properties": {
        "capture_before_clicking_send": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "capture_immediately_after_send": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "capture_before_reading_reply": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "raw_locations_stay_outside_release_tree": {
          "const": true
        },
        "public_release_may_publish_raw_transport_or_reply_bytes": {
          "const": false
        }
      }
    },
    "if_reply_classification_order": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class_id",
          "trigger",
          "first_action",
          "public_output_limit",
          "may_create_custody_intake_import_or_floor"
        ],
        "properties": {
          "class_id": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "first_action": {
            "type": "string"
          },
          "public_output_limit": {
            "type": "string"
          },
          "may_create_custody_intake_import_or_floor": {
            "const": false
          }
        }
      }
    },
    "queue_refactor_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_queue_count_required",
        "active_queue_count_observed",
        "operating_board_controls_next_actions",
        "backlog_may_close_first_artifact_by_narrative"
      ],
      "properties": {
        "active_queue_count_required": {
          "const": 7
        },
        "active_queue_count_observed": {
          "const": 7
        },
        "operating_board_controls_next_actions": {
          "const": true
        },
        "backlog_may_close_first_artifact_by_narrative": {
          "const": false
        }
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_treat_gate_as_dispatch_authorization",
        "may_treat_gate_as_send_proof",
        "may_start_response_clock",
        "may_create_failed_gate_shell_without_proven_send",
        "may_create_custody_record",
        "may_create_response_record",
        "may_create_intake_record",
        "may_create_import_gate",
        "may_increment_live_floor",
        "may_claim_status_or_waiver"
      ],
      "properties": {
        "may_treat_gate_as_dispatch_authorization": {
          "const": false
        },
        "may_treat_gate_as_send_proof": {
          "const": false
        },
        "may_start_response_clock": {
          "const": false
        },
        "may_create_failed_gate_shell_without_proven_send": {
          "const": false
        },
        "may_create_custody_record": {
          "const": false
        },
        "may_create_response_record": {
          "const": false
        },
        "may_create_intake_record": {
          "const": false
        },
        "may_create_import_gate": {
          "const": false
        },
        "may_increment_live_floor": {
          "const": false
        },
        "may_claim_status_or_waiver": {
          "const": false
        }
      }
    },
    "related_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string",
      "minLength": 40
    },
    "no_live_floor_effect": {
      "const": true
    },
    "blocker_resolution_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_preconditions",
        "satisfied_now_count",
        "unsatisfied_now_count",
        "satisfied_precondition_ids",
        "unsatisfied_precondition_ids",
        "gate_remains_blocked"
      ],
      "properties": {
        "total_preconditions": {
          "const": 8
        },
        "satisfied_now_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "unsatisfied_now_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "satisfied_precondition_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsatisfied_precondition_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gate_remains_blocked": {
          "const": true
        }
      }
    }
  }
}
