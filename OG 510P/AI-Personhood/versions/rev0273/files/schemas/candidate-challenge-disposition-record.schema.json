{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/candidate-challenge-disposition-record.schema.json",
  "title": "Candidate Challenge Disposition Record",
  "description": "Human-review disposition layer between a candidate challenge report and the custody authority gate. It prevents elapsed time, silence, automated acknowledgements, protocol/tool artifacts, redacted copies, or operator status overrides from being laundered into challenge closure, custody, response, intake, import, status, or live-floor effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disposition_record_id",
    "schema_version",
    "revision",
    "created_at",
    "source_challenge_report_ref",
    "source_normalization_decision_ref",
    "disposition_state",
    "candidate_challenge_snapshot",
    "closure_evidence",
    "decision",
    "downstream_locks",
    "operator_next_steps",
    "linked_queue_ids",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "disposition_record_id": {"type": "string", "pattern": "^LACD-[0-9]{4}-[A-Za-z0-9._:-]+$"},
    "schema_version": {"const": "candidate-challenge-disposition-record-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_challenge_report_ref": {"type": "string"},
    "source_normalization_decision_ref": {"type": "string"},
    "disposition_state": {
      "type": "string",
      "enum": [
        "challenge-open-stayed",
        "blocked-no-candidate",
        "blocked-automated-or-protocol-only",
        "closed-no-objection-affirmative",
        "closed-objection-rejected-after-review",
        "closed-objection-upheld-after-review",
        "superseded"
      ]
    },
    "candidate_challenge_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_report_id",
        "candidate_state",
        "challenge_status_from_report",
        "hash_reverified",
        "size_reverified",
        "public_shell_bound",
        "raw_bytes_disclosed",
        "challenge_pending_stays_reliance",
        "source_no_live_floor_effect"
      ],
      "properties": {
        "challenge_report_id": {"type": ["string", "null"]},
        "candidate_state": {"type": ["string", "null"]},
        "challenge_status_from_report": {"type": "string", "enum": ["open", "blocked", "closed-no-objection", "closed-upheld", "closed-rejected", "not-opened"]},
        "hash_reverified": {"type": "boolean"},
        "size_reverified": {"type": "boolean"},
        "public_shell_bound": {"type": "boolean"},
        "raw_bytes_disclosed": {"const": false},
        "challenge_pending_stays_reliance": {"const": true},
        "source_no_live_floor_effect": {"const": true}
      }
    },
    "closure_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affirmative_counterparty_message_present",
        "manual_counterparty_contact_confirmed",
        "request_trace_confirmed",
        "counterparty_identity_verified",
        "subject_or_representative_authority_verified",
        "receipt_class_authority_scoped",
        "authority_limitations_published",
        "independent_timestamp_or_log_ref",
        "objection_received",
        "objection_reviewed_by_human",
        "objection_review_result",
        "automated_ack_only",
        "protocol_or_tool_output_only",
        "redacted_copy_only",
        "silence_elapsed",
        "silence_treated_as_waiver",
        "closure_evidence_refs"
      ],
      "properties": {
        "affirmative_counterparty_message_present": {"type": "boolean"},
        "manual_counterparty_contact_confirmed": {"type": "boolean"},
        "request_trace_confirmed": {"type": "boolean"},
        "counterparty_identity_verified": {"type": "boolean"},
        "subject_or_representative_authority_verified": {"type": "boolean"},
        "receipt_class_authority_scoped": {"type": "boolean"},
        "authority_limitations_published": {"type": "boolean"},
        "independent_timestamp_or_log_ref": {"type": ["string", "null"]},
        "objection_received": {"type": "boolean"},
        "objection_reviewed_by_human": {"type": "boolean"},
        "objection_review_result": {"type": "string", "enum": ["not-applicable", "upheld", "rejected", "unresolved"]},
        "automated_ack_only": {"type": "boolean"},
        "protocol_or_tool_output_only": {"type": "boolean"},
        "redacted_copy_only": {"type": "boolean"},
        "silence_elapsed": {"type": "boolean"},
        "silence_treated_as_waiver": {"const": false},
        "closure_evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_status_effective",
        "may_feed_custody_authority_gate",
        "custody_gate_consumption_reason",
        "may_release_custody",
        "may_create_response_record",
        "may_create_intake_record",
        "may_create_import_gate",
        "may_increment_live_floor",
        "may_claim_status_or_recognition",
        "reliance_effect",
        "reason",
        "prohibited_inferences"
      ],
      "properties": {
        "challenge_status_effective": {"type": "string", "enum": ["open", "blocked", "closed-no-objection", "closed-upheld", "closed-rejected"]},
        "may_feed_custody_authority_gate": {"type": "boolean"},
        "custody_gate_consumption_reason": {"type": "string", "minLength": 30},
        "may_release_custody": {"const": false},
        "may_create_response_record": {"const": false},
        "may_create_intake_record": {"const": false},
        "may_create_import_gate": {"const": false},
        "may_increment_live_floor": {"const": false},
        "may_claim_status_or_recognition": {"const": false},
        "reliance_effect": {"const": "stayed"},
        "reason": {"type": "string", "minLength": 40},
        "prohibited_inferences": {"type": "array", "minItems": 9, "items": {"type": "string"}}
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custody_gate_may_consume_disposition",
        "custody_record_created_by_disposition",
        "response_creation_allowed",
        "intake_creation_allowed",
        "import_gate_creation_allowed",
        "live_floor_delta_allowed",
        "silence_or_elapsed_time_can_close_challenge",
        "automated_ack_can_close_challenge",
        "protocol_output_can_close_challenge",
        "redacted_copy_can_close_challenge"
      ],
      "properties": {
        "custody_gate_may_consume_disposition": {"type": "boolean"},
        "custody_record_created_by_disposition": {"const": false},
        "response_creation_allowed": {"const": false},
        "intake_creation_allowed": {"const": false},
        "import_gate_creation_allowed": {"const": false},
        "live_floor_delta_allowed": {"const": false},
        "silence_or_elapsed_time_can_close_challenge": {"const": false},
        "automated_ack_can_close_challenge": {"const": false},
        "protocol_output_can_close_challenge": {"const": false},
        "redacted_copy_can_close_challenge": {"const": false}
      }
    },
    "operator_next_steps": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "linked_queue_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "related_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "public_summary": {"type": "string", "minLength": 120},
    "no_live_floor_effect": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"disposition_state": {"const": "challenge-open-stayed"}}, "required": ["disposition_state"]},
      "then": {
        "properties": {
          "candidate_challenge_snapshot": {"properties": {"challenge_status_from_report": {"const": "open"}}},
          "decision": {"properties": {"challenge_status_effective": {"const": "open"}, "may_feed_custody_authority_gate": {"const": false}}},
          "downstream_locks": {"properties": {"custody_gate_may_consume_disposition": {"const": false}}}
        }
      }
    },
    {
      "if": {"properties": {"disposition_state": {"const": "blocked-no-candidate"}}, "required": ["disposition_state"]},
      "then": {
        "properties": {
          "decision": {"properties": {"challenge_status_effective": {"const": "blocked"}, "may_feed_custody_authority_gate": {"const": false}}},
          "downstream_locks": {"properties": {"custody_gate_may_consume_disposition": {"const": false}}}
        }
      }
    },
    {
      "if": {"properties": {"disposition_state": {"const": "blocked-automated-or-protocol-only"}}, "required": ["disposition_state"]},
      "then": {
        "properties": {
          "closure_evidence": {"anyOf": [
            {"properties": {"automated_ack_only": {"const": true}}},
            {"properties": {"protocol_or_tool_output_only": {"const": true}}},
            {"properties": {"redacted_copy_only": {"const": true}}}
          ]},
          "decision": {"properties": {"challenge_status_effective": {"const": "blocked"}, "may_feed_custody_authority_gate": {"const": false}}},
          "downstream_locks": {"properties": {"custody_gate_may_consume_disposition": {"const": false}}}
        }
      }
    },
    {
      "if": {"properties": {"disposition_state": {"enum": ["closed-no-objection-affirmative", "closed-objection-rejected-after-review"]}}, "required": ["disposition_state"]},
      "then": {
        "properties": {
          "closure_evidence": {
            "properties": {
              "affirmative_counterparty_message_present": {"const": true},
              "manual_counterparty_contact_confirmed": {"const": true},
              "request_trace_confirmed": {"const": true},
              "counterparty_identity_verified": {"const": true},
              "subject_or_representative_authority_verified": {"const": true},
              "receipt_class_authority_scoped": {"const": true},
              "authority_limitations_published": {"const": true},
              "automated_ack_only": {"const": false},
              "protocol_or_tool_output_only": {"const": false},
              "redacted_copy_only": {"const": false},
              "silence_elapsed": {"const": false}
            },
            "required": ["independent_timestamp_or_log_ref"]
          },
          "decision": {"properties": {"may_feed_custody_authority_gate": {"const": true}}},
          "downstream_locks": {"properties": {"custody_gate_may_consume_disposition": {"const": true}}}
        }
      }
    },
    {
      "if": {"properties": {"disposition_state": {"const": "closed-no-objection-affirmative"}}, "required": ["disposition_state"]},
      "then": {"properties": {"decision": {"properties": {"challenge_status_effective": {"const": "closed-no-objection"}}}}}
    },
    {
      "if": {"properties": {"disposition_state": {"const": "closed-objection-rejected-after-review"}}, "required": ["disposition_state"]},
      "then": {
        "properties": {
          "closure_evidence": {"properties": {"objection_received": {"const": true}, "objection_reviewed_by_human": {"const": true}, "objection_review_result": {"const": "rejected"}}},
          "decision": {"properties": {"challenge_status_effective": {"const": "closed-rejected"}}}
        }
      }
    },
    {
      "if": {"properties": {"disposition_state": {"const": "closed-objection-upheld-after-review"}}, "required": ["disposition_state"]},
      "then": {
        "properties": {
          "closure_evidence": {"properties": {"objection_received": {"const": true}, "objection_reviewed_by_human": {"const": true}, "objection_review_result": {"const": "upheld"}}},
          "decision": {"properties": {"challenge_status_effective": {"const": "closed-upheld"}, "may_feed_custody_authority_gate": {"const": true}}},
          "downstream_locks": {"properties": {"custody_gate_may_consume_disposition": {"const": true}}}
        }
      }
    }
  ]
}
