{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/live-artifact-candidate-challenge-report.schema.json",
  "title": "Live Artifact Candidate Challenge Report",
  "description": "Pre-custody challenge/replay report for a first-real-artifact pilot candidate. It proves private-vault reread and keeps custody, response, intake, import, and live-floor effects locked while challenge is pending or failed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "challenge_report_id",
    "schema_version",
    "revision",
    "created_at",
    "generated_by_tool",
    "source_pilot_report_ref",
    "candidate_state",
    "linked_refs",
    "vault_reread",
    "challenge_window",
    "downstream_locks",
    "decision",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "challenge_report_id": {
      "type": "string",
      "pattern": "^LACR-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "live-artifact-candidate-challenge-report-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by_tool": {
      "const": "tools/prepare_candidate_challenge_packet.py"
    },
    "source_pilot_report_ref": {
      "type": "string"
    },
    "candidate_state": {
      "type": "string",
      "enum": [
        "hash-reverified-challenge-pending",
        "blocked-vault-unreadable",
        "blocked-vault-hash-mismatch",
        "blocked-no-leap-candidate"
      ]
    },
    "linked_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_drop_ledger_ref",
        "public_shell_ref",
        "live_evidence_acquisition_packet_ref",
        "source_evidence_drop_ledger_id",
        "public_shell_id",
        "leap_packet_id"
      ],
      "properties": {
        "evidence_drop_ledger_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "public_shell_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "live_evidence_acquisition_packet_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_evidence_drop_ledger_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "public_shell_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "leap_packet_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "vault_reread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_vault_locator",
        "vault_reread_performed",
        "vault_path_disclosed",
        "expected_sha256",
        "recomputed_sha256",
        "expected_size_bytes",
        "recomputed_size_bytes",
        "hash_reverified",
        "size_reverified",
        "public_shell_bound",
        "raw_bytes_disclosed"
      ],
      "properties": {
        "private_vault_locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "vault_reread_performed": {
          "type": "boolean"
        },
        "vault_path_disclosed": {
          "const": false
        },
        "expected_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "recomputed_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "recomputed_size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "hash_reverified": {
          "type": "boolean"
        },
        "size_reverified": {
          "type": "boolean"
        },
        "public_shell_bound": {
          "type": "boolean"
        },
        "raw_bytes_disclosed": {
          "const": false
        }
      }
    },
    "challenge_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "duration_hours",
        "opened_at",
        "manual_counterparty_contact_required",
        "counterparty_silence_is_not_waiver",
        "challenge_pending_stays_reliance",
        "challenge_routes",
        "prohibited_inferences"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "open",
            "blocked",
            "closed-no-objection",
            "closed-upheld",
            "closed-rejected"
          ]
        },
        "duration_hours": {
          "type": "integer",
          "minimum": 1
        },
        "opened_at": {
          "type": "string",
          "format": "date-time"
        },
        "manual_counterparty_contact_required": {
          "const": true
        },
        "counterparty_silence_is_not_waiver": {
          "const": true
        },
        "challenge_pending_stays_reliance": {
          "const": true
        },
        "challenge_routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "prohibited_inferences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custody_creation_allowed",
        "response_creation_allowed",
        "intake_creation_allowed",
        "import_gate_creation_allowed",
        "live_floor_delta_allowed",
        "locks_release_only_after"
      ],
      "properties": {
        "custody_creation_allowed": {
          "const": false
        },
        "response_creation_allowed": {
          "const": false
        },
        "intake_creation_allowed": {
          "const": false
        },
        "import_gate_creation_allowed": {
          "const": false
        },
        "live_floor_delta_allowed": {
          "const": false
        },
        "locks_release_only_after": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custody_review_may_continue",
        "custody_release_allowed",
        "reliance_effect",
        "blocked_actions",
        "next_actions",
        "reason"
      ],
      "properties": {
        "custody_review_may_continue": {
          "type": "boolean"
        },
        "custody_release_allowed": {
          "const": false
        },
        "reliance_effect": {
          "const": "stayed"
        },
        "blocked_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "public_summary": {
      "type": "string"
    },
    "no_live_floor_effect": {
      "const": true
    }
  }
}
