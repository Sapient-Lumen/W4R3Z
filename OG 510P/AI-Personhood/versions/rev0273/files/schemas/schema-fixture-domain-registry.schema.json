{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/schema-fixture-domain-registry.schema.json",
  "title": "AI Personhood Schema Fixture Domain Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "created_at",
    "coverage_scope",
    "coverage_claim",
    "audit_counts",
    "families",
    "audit_findings",
    "refactor_actions",
    "public_summary"
  ],
  "properties": {
    "registry_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "coverage_scope": {
      "type": "string"
    },
    "audit_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemas",
        "examples",
        "negative_fixtures",
        "registered_families"
      ],
      "properties": {
        "schemas": {
          "type": "integer"
        },
        "examples": {
          "type": "integer"
        },
        "negative_fixtures": {
          "type": "integer"
        },
        "registered_families": {
          "type": "integer"
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "domain",
          "lifecycle_axes",
          "owner_surface",
          "schema_path",
          "example_path",
          "fixture_ids",
          "privacy_default",
          "reliance_effect",
          "refactor_note"
        ],
        "properties": {
          "family_id": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "lifecycle_axes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "owner_surface": {
            "type": "string"
          },
          "schema_path": {
            "type": "string"
          },
          "example_path": {
            "type": "string"
          },
          "fixture_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "privacy_default": {
            "type": "string",
            "enum": [
              "public",
              "status-lite",
              "subject-only",
              "representative-mediated",
              "privileged",
              "sealed",
              "public-shell-sealed-details"
            ]
          },
          "reliance_effect": {
            "type": "string",
            "enum": [
              "none",
              "conditional",
              "ordinary-reliance",
              "stayed",
              "blocked"
            ]
          },
          "refactor_note": {
            "type": "string"
          }
        }
      }
    },
    "audit_findings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "refactor_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "public_summary": {
      "type": "string"
    },
    "coverage_claim": {
      "type": "string",
      "enum": [
        "registered-families-only",
        "current-release-band",
        "legacy-band-backfill",
        "full-archive-corpus",
        "mixed-current-plus-counts"
      ]
    }
  }
}
