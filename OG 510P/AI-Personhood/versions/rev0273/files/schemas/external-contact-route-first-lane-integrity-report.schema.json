{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-route-first-lane-integrity-report.schema.json",
  "title": "External Contact Route-First Lane Integrity Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "schema_version",
    "revision",
    "created_at",
    "report_state",
    "source_refs",
    "message_recompute",
    "lane_gate_states",
    "remaining_blockers",
    "finalization_policy",
    "nonclosure_controls",
    "operational_state",
    "downstream_locks",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "external-contact-route-first-lane-integrity-report-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "report_state": {
      "enum": [
        "blocked-current-route-first-lane-integrity-clean-no-send"
      ]
    },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_first_preflight",
        "route_first_body",
        "route_first_mail_ready_draft",
        "route_first_send_capture_gate",
        "route_first_reply_disposition",
        "stage_two_authorization_gate",
        "route_first_branch_hold",
        "route_first_operator_execution_pack",
        "route_first_human_sender_authority_precommit",
        "human_sender_authority_precommit",
        "current_public_locator_recheck",
        "transport_capture_plan",
        "send_trace_shell",
        "send_proof_record",
        "delivery_status_record",
        "inbound_vault_precommit",
        "inbound_capture_shell",
        "operating_board"
      ],
      "properties": {
        "route_first_preflight": {
          "type": "string"
        },
        "route_first_body": {
          "type": "string"
        },
        "route_first_mail_ready_draft": {
          "type": "string"
        },
        "route_first_send_capture_gate": {
          "type": "string"
        },
        "route_first_reply_disposition": {
          "type": "string"
        },
        "stage_two_authorization_gate": {
          "type": "string"
        },
        "route_first_branch_hold": {
          "type": "string"
        },
        "route_first_operator_execution_pack": {
          "type": "string"
        },
        "human_sender_authority_precommit": {
          "type": "string"
        },
        "current_public_locator_recheck": {
          "type": "string"
        },
        "transport_capture_plan": {
          "type": "string"
        },
        "send_trace_shell": {
          "type": "string"
        },
        "send_proof_record": {
          "type": "string"
        },
        "delivery_status_record": {
          "type": "string"
        },
        "inbound_vault_precommit": {
          "type": "string"
        },
        "inbound_capture_shell": {
          "type": "string"
        },
        "operating_board": {
          "type": "string"
        },
        "route_first_human_sender_authority_precommit": {
          "type": "string"
        }
      }
    },
    "message_recompute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient",
        "subject",
        "body_ref",
        "mail_ready_draft_ref",
        "body_word_count",
        "body_sha256",
        "mail_ready_draft_sha256",
        "attachments_included",
        "payload_item_count_attached",
        "stage_two_payload_deferred",
        "hashes_match_preflight",
        "hashes_match_send_gate",
        "hashes_match_reply_disposition",
        "hashes_match_operator_pack",
        "mail_ready_contains_no_attachment_headers"
      ],
      "properties": {
        "recipient": {
          "const": "info@raicollab.org"
        },
        "subject": {
          "type": "string",
          "minLength": 12
        },
        "body_ref": {
          "type": "string"
        },
        "mail_ready_draft_ref": {
          "type": "string"
        },
        "body_word_count": {
          "type": "integer",
          "minimum": 60,
          "maximum": 180
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mail_ready_draft_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attachments_included": {
          "const": false
        },
        "payload_item_count_attached": {
          "const": 0
        },
        "stage_two_payload_deferred": {
          "const": true
        },
        "hashes_match_preflight": {
          "const": true
        },
        "hashes_match_send_gate": {
          "const": true
        },
        "hashes_match_reply_disposition": {
          "const": true
        },
        "hashes_match_operator_pack": {
          "const": true
        },
        "mail_ready_contains_no_attachment_headers": {
          "const": true
        }
      }
    },
    "lane_gate_states": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight_state",
        "send_capture_gate_state",
        "reply_disposition_state",
        "stage_two_gate_state",
        "branch_hold_state",
        "operator_pack_state",
        "route_first_authority_precommit_state",
        "current_public_locator_recheck_state",
        "transport_plan_state",
        "send_trace_state",
        "send_proof_state",
        "delivery_status_state",
        "inbound_precommit_state",
        "inbound_capture_state",
        "operating_board_active_count"
      ],
      "properties": {
        "preflight_state": {
          "const": "preferred-route-first-no-attachment-blocked-no-human-send"
        },
        "send_capture_gate_state": {
          "const": "blocked-route-first-no-human-send-no-transport"
        },
        "reply_disposition_state": {
          "const": "pre-send-no-inbound"
        },
        "stage_two_gate_state": {
          "const": "blocked-stage-two-no-willing-reply-no-human-authorization"
        },
        "branch_hold_state": {
          "const": "explicit-current-revision-no-send-hold"
        },
        "operator_pack_state": {
          "const": "prepared-not-authorized-not-sent"
        },
        "current_public_locator_recheck_state": {
          "const": "current-public-locator-rechecked-no-send"
        },
        "transport_plan_state": {
          "type": "string",
          "minLength": 12
        },
        "send_trace_state": {
          "type": "string",
          "minLength": 8
        },
        "send_proof_state": {
          "type": "string",
          "minLength": 8
        },
        "delivery_status_state": {
          "type": "string",
          "minLength": 8
        },
        "inbound_precommit_state": {
          "type": "string",
          "minLength": 8
        },
        "inbound_capture_state": {
          "type": "string",
          "minLength": 8
        },
        "operating_board_active_count": {
          "const": 7
        },
        "route_first_authority_precommit_state": {
          "const": "unsigned-route-first-human-sender-authority-precommit-no-send"
        }
      }
    },
    "remaining_blockers": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blocker_id",
          "required_before_send",
          "satisfied_now",
          "evidence_required",
          "may_be_satisfied_inside_public_release"
        ],
        "properties": {
          "blocker_id": {
            "type": "string"
          },
          "required_before_send": {
            "const": true
          },
          "satisfied_now": {
            "const": false
          },
          "evidence_required": {
            "type": "string",
            "minLength": 12
          },
          "may_be_satisfied_inside_public_release": {
            "const": false
          }
        }
      }
    },
    "finalization_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_may_authorize_send",
        "operator_pack_may_authorize_send",
        "must_rerun_hashes_after_any_edit",
        "must_recheck_public_locator_at_send_time",
        "must_select_private_vault_roots_before_send",
        "must_capture_transport_proof_if_sent",
        "route_first_must_remain_no_attachment",
        "stage_two_may_auto_send_after_willing_reply"
      ],
      "properties": {
        "report_may_authorize_send": {
          "const": false
        },
        "operator_pack_may_authorize_send": {
          "const": false
        },
        "must_rerun_hashes_after_any_edit": {
          "const": true
        },
        "must_recheck_public_locator_at_send_time": {
          "const": true
        },
        "must_select_private_vault_roots_before_send": {
          "const": true
        },
        "must_capture_transport_proof_if_sent": {
          "const": true
        },
        "route_first_must_remain_no_attachment": {
          "const": true
        },
        "stage_two_may_auto_send_after_willing_reply": {
          "const": false
        }
      }
    },
    "nonclosure_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_report_may_close_first_artifact_tasks",
        "do_not_close_by_narrative",
        "operating_board_active_count_required",
        "operating_board_active_count_observed"
      ],
      "properties": {
        "lane_report_may_close_first_artifact_tasks": {
          "const": false
        },
        "do_not_close_by_narrative": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "operating_board_active_count_required": {
          "const": 7
        },
        "operating_board_active_count_observed": {
          "const": 7
        }
      }
    },
    "operational_state": {
      "type": "object",
      "additionalProperties": {
        "const": false
      },
      "minProperties": 8
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": {
        "const": false
      },
      "minProperties": 10
    },
    "public_summary": {
      "type": "string",
      "minLength": 80
    },
    "no_live_floor_effect": {
      "const": true
    }
  }
}
