{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/insolvency-asset-segregation-plan.schema.json",
  "title": "AI Personhood Insolvency Asset Segregation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "created_at",
    "insolvency_class",
    "debtor_or_host",
    "affected_subjects",
    "segregated_assets",
    "creditor_map",
    "emergency_support_source",
    "no_setoff_or_no_delete_order",
    "migration_or_host_switch_ref",
    "representative_notice",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "insolvency_class": {
      "type": "string",
      "enum": [
        "IS0",
        "IS1",
        "IS2",
        "IS3",
        "IS4",
        "IS5"
      ]
    },
    "debtor_or_host": {
      "type": "string"
    },
    "affected_subjects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "segregated_assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "creditor_map": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emergency_support_source": {
      "type": "string"
    },
    "no_setoff_or_no_delete_order": {
      "type": "string"
    },
    "migration_or_host_switch_ref": {
      "type": "string"
    },
    "representative_notice": {
      "type": "string"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
