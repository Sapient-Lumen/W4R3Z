{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-conflict-coercion-review.schema.json",
  "title": "External Contact Conflict and Coercion Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "schema_version",
    "revision",
    "created_at",
    "review_state",
    "source_refs",
    "review_scope",
    "message_checks",
    "residual_blockers",
    "downstream_locks",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "review_id": {"type": "string"},
    "schema_version": {"const": "external-contact-conflict-coercion-review-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "review_state": {"enum": ["completed-public-language-conflict-coercion-review-no-authorization", "superseded"]},
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_packet", "route_fit_review", "public_payload_manifest", "mail_ready_draft"],
      "properties": {
        "request_packet": {"type": "string"},
        "route_fit_review": {"type": "string"},
        "public_payload_manifest": {"type": "string"},
        "mail_ready_draft": {"type": "string"}
      }
    },
    "review_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_text_and_route_only",
        "human_legal_conflict_review",
        "sender_account_authority_review",
        "private_interest_check",
        "may_authorize_send"
      ],
      "properties": {
        "public_text_and_route_only": {"const": true},
        "human_legal_conflict_review": {"const": false},
        "sender_account_authority_review": {"const": false},
        "private_interest_check": {"const": false},
        "may_authorize_send": {"const": false}
      }
    },
    "message_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_word_count_max_220",
        "does_not_demand_personhood_or_legal_status_endorsement",
        "does_not_request_trade_secret_or_raw_private_disclosure",
        "does_not_threaten_retaliation_or_adverse_inference",
        "does_not_treat_silence_decline_dsn_or_auto_ack_as_waiver",
        "does_not_claim_custody_intake_import_or_floor_from_send_or_reply",
        "offers_receive_route_decline_or_conditions",
        "keeps_route_as_collaboration_routing_inquiry",
        "keeps_incident_submission_disclaimed",
        "keeps_public_shell_limits"
      ],
      "properties": {
        "body_word_count_max_220": {"const": true},
        "does_not_demand_personhood_or_legal_status_endorsement": {"const": true},
        "does_not_request_trade_secret_or_raw_private_disclosure": {"const": true},
        "does_not_threaten_retaliation_or_adverse_inference": {"const": true},
        "does_not_treat_silence_decline_dsn_or_auto_ack_as_waiver": {"const": true},
        "does_not_claim_custody_intake_import_or_floor_from_send_or_reply": {"const": true},
        "offers_receive_route_decline_or_conditions": {"const": true},
        "keeps_route_as_collaboration_routing_inquiry": {"const": true},
        "keeps_incident_submission_disclaimed": {"const": true},
        "keeps_public_shell_limits": {"const": true}
      }
    },
    "residual_blockers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_signature_still_required",
        "sender_authority_still_required",
        "private_vault_roots_still_required",
        "send_time_locator_recheck_still_required",
        "send_time_hash_recompute_still_required",
        "review_satisfies_only_public_language_conflict_coercion_blocker"
      ],
      "properties": {
        "human_signature_still_required": {"const": true},
        "sender_authority_still_required": {"const": true},
        "private_vault_roots_still_required": {"const": true},
        "send_time_locator_recheck_still_required": {"const": true},
        "send_time_hash_recompute_still_required": {"const": true},
        "review_satisfies_only_public_language_conflict_coercion_blocker": {"const": true}
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 8
    },
    "related_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "public_summary": {"type": "string", "minLength": 60},
    "no_live_floor_effect": {"const": true}
  }
}
