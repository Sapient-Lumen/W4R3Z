{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/tool-invocation-audit.schema.json",
  "title": "AI Personhood Tool Invocation Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invocation_id",
    "invoked_at",
    "agent",
    "tool",
    "authority_ref",
    "subject_or_principal",
    "purpose",
    "inputs_boundary",
    "outputs_boundary",
    "side_effect_class",
    "result",
    "review_flags",
    "preservation_refs",
    "public_summary"
  ],
  "properties": {
    "invocation_id": {
      "type": "string"
    },
    "invoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "agent": {
      "type": "string"
    },
    "tool": {
      "type": "string"
    },
    "authority_ref": {
      "type": "string"
    },
    "subject_or_principal": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "inputs_boundary": {
      "type": "string"
    },
    "outputs_boundary": {
      "type": "string"
    },
    "side_effect_class": {
      "type": "string",
      "enum": [
        "TE0",
        "TE1",
        "TE2",
        "TE3",
        "TE4",
        "TE5"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "partial",
        "stayed",
        "blocked",
        "rolled-back"
      ]
    },
    "review_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preservation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string"
    }
  }
}
