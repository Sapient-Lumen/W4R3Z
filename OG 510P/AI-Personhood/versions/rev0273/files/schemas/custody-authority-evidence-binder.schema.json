              "silence_or_elapsed_time_used_as_authority": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "binder_state": {
            "enum": [
              "pre-dispatch-no-authority",
              "blocked-missing-evidence"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "may_feed_custody_authority_gate": {
                "const": false
              }
            }
          },
          "downstream_locks": {
            "properties": {
              "custody_gate_may_consume_binder": {
                "const": false
              }
            }
