    {
      "if": {
        "properties": {
          "binder_state": {
            "const": "verified-for-custody-gate"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "authority_evidence_complete": {
                "const": true
              },
              "receipt_class_authority_scoped": {
                "const": true
              },
              "may_feed_custody_authority_gate": {
                "const": true
              }
            }
          },
          "downstream_locks": {
            "properties": {
              "custody_gate_may_consume_binder": {
                "const": true
              }
            }
          },
          "unsafe_substitutions": {
            "properties": {
