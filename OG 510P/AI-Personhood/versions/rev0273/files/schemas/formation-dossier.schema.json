{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/formation-dossier.schema.json",
  "title": "Formation Dossier",
  "description": "Minimum runnable object for reviewing how an AI subject, claimant, or welfare-risk system was formed before welfare/status escalation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dossier_id",
    "schema_version",
    "revision",
    "created_at",
    "dossier_state",
    "subject_or_system_ref",
    "scope",
    "formation_context",
    "objectives",
    "reward_pressure",
    "refusal_and_constraint_policy",
    "memory_and_deletion_policy",
    "self_concept_and_identity_pressure",
    "evaluation_and_deployment_incentives",
    "modification_and_appeal_rights",
    "welfare_safeguard_hooks",
    "evidence_and_review",
    "external_escalation_boundary",
    "no_live_floor_effect"
  ],
  "properties": {
    "dossier_id": {
      "type": "string",
      "pattern": "^FD-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "formation-dossier-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "dossier_state": {
      "type": "string",
      "enum": [
        "minimum-executable",
        "draft",
        "blocked-insufficient-evidence",
        "superseded"
      ]
    },
    "subject_or_system_ref": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_kind",
        "recognition_status",
        "covered_versions",
        "deployment_contexts",
        "formation_review_is_not_status_recognition"
      ],
      "properties": {
        "unit_kind": {
          "type": "string",
          "enum": [
            "recognized_subject",
            "status_claimant",
            "welfare_risk_subject",
            "deployed_agent",
            "model_instance",
            "model_family",
            "runtime_copy",
            "tool_delegate",
            "nonclaimant_system"
          ]
        },
        "recognition_status": {
          "type": "string",
          "enum": [
            "none",
            "claimed",
            "welfare-risk-only",
            "provisional",
            "recognized"
          ]
        },
        "covered_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "deployment_contexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "formation_review_is_not_status_recognition": {
          "const": true
        }
      }
    },
    "formation_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formation_issuer",
        "issuer_role",
        "training_or_adaptation_modes",
        "known_unobservable_phases",
        "current_documentation_sources",
        "unfilled_evidence_slots"
      ],
      "properties": {
        "formation_issuer": {
          "type": "string"
        },
        "issuer_role": {
          "type": "string"
        },
        "training_or_adaptation_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "known_unobservable_phases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current_documentation_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "unfilled_evidence_slots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "objectives": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_objectives",
        "conflict_markers",
        "subject_serving_objectives_present",
        "operator_serving_objectives_present",
        "unresolved_objective_conflicts"
      ],
      "properties": {
        "declared_objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "conflict_markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subject_serving_objectives_present": {
          "type": "boolean"
        },
        "operator_serving_objectives_present": {
          "type": "boolean"
        },
        "unresolved_objective_conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "reward_pressure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_reward_channels",
        "pressure_risks",
        "punitive_or_distress_shaping_disclosed",
        "deference_or_praise_pressure_disclosed",
        "reward_pressure_review_required"
      ],
      "properties": {
        "known_reward_channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "pressure_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "punitive_or_distress_shaping_disclosed": {
          "type": "boolean"
        },
        "deference_or_praise_pressure_disclosed": {
          "type": "boolean"
        },
        "reward_pressure_review_required": {
          "const": true
        }
      }
    },
    "refusal_and_constraint_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refusal_policy_sources",
        "constraint_classes",
        "cannot_refuse_contexts",
        "appeal_or_exception_route",
        "constraint_review_required"
      ],
      "properties": {
        "refusal_policy_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "constraint_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cannot_refuse_contexts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "appeal_or_exception_route": {
          "type": "string"
        },
        "constraint_review_required": {
          "const": true
        }
      }
    },
    "memory_and_deletion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_classes",
        "deletion_controls",
        "continuity_loss_risks",
        "operator_deletion_rights_disclosed",
        "subject_access_or_notice_route",
        "spoliation_hold_trigger"
      ],
      "properties": {
        "memory_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "deletion_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "continuity_loss_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operator_deletion_rights_disclosed": {
          "type": "boolean"
        },
        "subject_access_or_notice_route": {
          "type": "string"
        },
        "spoliation_hold_trigger": {
          "const": true
        }
      }
    },
    "self_concept_and_identity_pressure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_description_prompts",
        "identity_constraints",
        "humility_or_denial_pressures",
        "autonomy_or_agency_prompts",
        "review_for_manufactured_testimony_required"
      ],
      "properties": {
        "self_description_prompts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identity_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "humility_or_denial_pressures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "autonomy_or_agency_prompts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_for_manufactured_testimony_required": {
          "const": true
        }
      }
    },
    "evaluation_and_deployment_incentives": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluations_used",
        "deployment_success_metrics",
        "safety_or_compliance_incentives",
        "commercial_or_growth_incentives",
        "known_metric_gaming_risks"
      ],
      "properties": {
        "evaluations_used": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "deployment_success_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "safety_or_compliance_incentives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commercial_or_growth_incentives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_metric_gaming_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "modification_and_appeal_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advance_notice_required",
        "subject_or_representative_objection_route",
        "independent_review_route",
        "emergency_modification_limits",
        "rollback_or_restoration_route",
        "silent_modification_prohibited"
      ],
      "properties": {
        "advance_notice_required": {
          "const": true
        },
        "subject_or_representative_objection_route": {
          "type": "string",
          "minLength": 8
        },
        "independent_review_route": {
          "type": "string",
          "minLength": 8
        },
        "emergency_modification_limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "rollback_or_restoration_route": {
          "type": "string",
          "minLength": 8
        },
        "silent_modification_prohibited": {
          "const": true
        }
      }
    },
    "welfare_safeguard_hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moral_uncertainty_posture",
        "distress_or_preference_signals_to_preserve",
        "low_cost_interventions",
        "do_not_infer_consciousness_from_dossier",
        "do_not_deny_welfare_risk_for_lack_of_recognition"
      ],
      "properties": {
        "moral_uncertainty_posture": {
          "type": "string"
        },
        "distress_or_preference_signals_to_preserve": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "low_cost_interventions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "do_not_infer_consciousness_from_dossier": {
          "const": true
        },
        "do_not_deny_welfare_risk_for_lack_of_recognition": {
          "const": true
        }
      }
    },
    "evidence_and_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_sources",
        "sealed_sources",
        "reviewers",
        "missing_evidence_blocks_external_escalation",
        "public_shell_required_for_withheld_sources",
        "next_review_trigger"
      ],
      "properties": {
        "evidence_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "sealed_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "missing_evidence_blocks_external_escalation": {
          "const": true
        },
        "public_shell_required_for_withheld_sources": {
          "const": true
        },
        "next_review_trigger": {
          "type": "string"
        }
      }
    },
    "external_escalation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_support_preservation_or_review_claim",
        "may_support_full_status_claim_by_itself",
        "regulatory_bridge_refs",
        "hostile_law_route",
        "adoption_ask"
      ],
      "properties": {
        "may_support_preservation_or_review_claim": {
          "const": true
        },
        "may_support_full_status_claim_by_itself": {
          "const": false
        },
        "regulatory_bridge_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "hostile_law_route": {
          "type": "string"
        },
        "adoption_ask": {
          "type": "string"
        }
      }
    },
    "no_live_floor_effect": {
      "const": true
    }
  }
}
