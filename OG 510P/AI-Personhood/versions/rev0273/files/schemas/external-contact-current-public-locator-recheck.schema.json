{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-current-public-locator-recheck.schema.json",
  "title": "External Contact Current Public Locator Recheck",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recheck_id",
    "schema_version",
    "revision",
    "checked_at",
    "recheck_state",
    "target_counterparty",
    "public_sources_checked",
    "current_locator_finding",
    "recheck_limits",
    "operational_state",
    "downstream_locks",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "recheck_id": {"type": "string"},
    "schema_version": {"const": "external-contact-current-public-locator-recheck-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "checked_at": {"type": "string", "format": "date-time"},
    "recheck_state": {"enum": ["current-public-locator-rechecked-no-send", "superseded"]},
    "target_counterparty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "organization_name", "intended_channel_kind"],
      "properties": {
        "candidate_id": {"type": "string"},
        "organization_name": {"type": "string"},
        "intended_channel_kind": {"enum": ["public-collaboration-email"]}
      }
    },
    "public_sources_checked": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_url", "observed_claim", "observed_contact_or_route", "route_use"],
        "properties": {
          "source_url": {"type": "string"},
          "observed_claim": {"type": "string", "minLength": 10},
          "observed_contact_or_route": {"type": "string", "minLength": 3},
          "route_use": {"type": "string", "minLength": 10}
        }
      }
    },
    "current_locator_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_channel_locator",
        "public_source_url",
        "collaboration_route_found_now",
        "incident_submission_route_not_used",
        "locator_matches_dispatch_card_now"
      ],
      "properties": {
        "public_channel_locator": {"const": "info@raicollab.org"},
        "public_source_url": {"const": "https://incidentdatabase.ai/contact/"},
        "collaboration_route_found_now": {"const": true},
        "incident_submission_route_not_used": {"const": true},
        "locator_matches_dispatch_card_now": {"const": true}
      }
    },
    "recheck_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recheck_may_authorize_send",
        "recheck_is_consent_or_authority",
        "recheck_satisfies_send_time_recheck_if_send_delayed",
        "must_recheck_again_immediately_before_later_send",
        "locator_is_not_custody_intake_import_or_recognition"
      ],
      "properties": {
        "recheck_may_authorize_send": {"const": false},
        "recheck_is_consent_or_authority": {"const": false},
        "recheck_satisfies_send_time_recheck_if_send_delayed": {"const": false},
        "must_recheck_again_immediately_before_later_send": {"const": true},
        "locator_is_not_custody_intake_import_or_recognition": {"const": true}
      }
    },
    "operational_state": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 5
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 8
    },
    "related_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "public_summary": {"type": "string", "minLength": 60},
    "no_live_floor_effect": {"const": true}
  }
}
