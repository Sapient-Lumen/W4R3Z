{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-route-first-human-sender-authority-precommit.schema.json",
  "title": "External Contact Route-First Human Sender Authority Precommit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "precommit_id",
    "schema_version",
    "revision",
    "created_at",
    "precommit_state",
    "source_refs",
    "exact_route_first_binding",
    "unsigned_authorization_slots",
    "required_human_attestations",
    "scope_controls",
    "residual_blockers",
    "nonclosure_controls",
    "operational_state",
    "downstream_locks",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "precommit_id": {"type": "string"},
    "schema_version": {"const": "external-contact-route-first-human-sender-authority-precommit-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "precommit_state": {"const": "unsigned-route-first-human-sender-authority-precommit-no-send"},
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_first_preflight",
        "route_first_body",
        "route_first_mail_ready_draft",
        "route_first_send_capture_gate",
        "route_first_operator_execution_pack",
        "route_first_lane_integrity_report",
        "route_first_branch_hold",
        "current_public_locator_recheck",
        "hash_recompute_dry_run",
        "transport_capture_plan",
        "operating_board",
        "full_payload_human_sender_precommit_legacy_context"
      ],
      "properties": {
        "route_first_preflight": {"type": "string"},
        "route_first_body": {"type": "string"},
        "route_first_mail_ready_draft": {"type": "string"},
        "route_first_send_capture_gate": {"type": "string"},
        "route_first_operator_execution_pack": {"type": "string"},
        "route_first_lane_integrity_report": {"type": "string"},
        "route_first_branch_hold": {"type": "string"},
        "current_public_locator_recheck": {"type": "string"},
        "hash_recompute_dry_run": {"type": "string"},
        "transport_capture_plan": {"type": "string"},
        "operating_board": {"type": "string"},
        "full_payload_human_sender_precommit_legacy_context": {"type": "string"}
      }
    },
    "exact_route_first_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient",
        "subject",
        "body_ref",
        "mail_ready_draft_ref",
        "body_word_count",
        "body_sha256",
        "mail_ready_draft_sha256",
        "attachments_included",
        "payload_item_count_attached",
        "stage_two_payload_attached",
        "signature_must_bind_recipient_subject_body_and_eml_hashes",
        "signature_must_bind_no_attachment_limit",
        "signature_must_bind_stage_two_deferral"
      ],
      "properties": {
        "recipient": {"const": "info@raicollab.org"},
        "subject": {"type": "string", "minLength": 12},
        "body_ref": {"type": "string"},
        "mail_ready_draft_ref": {"type": "string"},
        "body_word_count": {"type": "integer", "minimum": 60, "maximum": 180},
        "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mail_ready_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "attachments_included": {"const": false},
        "payload_item_count_attached": {"const": 0},
        "stage_two_payload_attached": {"const": false},
        "signature_must_bind_recipient_subject_body_and_eml_hashes": {"const": true},
        "signature_must_bind_no_attachment_limit": {"const": true},
        "signature_must_bind_stage_two_deferral": {"const": true}
      }
    },
    "unsigned_authorization_slots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_authorizer_id",
        "authorizer_role",
        "sender_account_or_channel",
        "sender_authority_basis",
        "signed_at",
        "signature_or_attestation_hash",
        "send_permitted_now"
      ],
      "properties": {
        "human_authorizer_id": {"type": "null"},
        "authorizer_role": {"type": "null"},
        "sender_account_or_channel": {"type": "null"},
        "sender_authority_basis": {"type": "null"},
        "signed_at": {"type": "null"},
        "signature_or_attestation_hash": {"type": "null"},
        "send_permitted_now": {"const": false}
      }
    },
    "required_human_attestations": {
      "type": "array",
      "minItems": 5,
      "items": {"type": "string", "minLength": 20}
    },
    "scope_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "this_precommit_covers_route_first_only",
        "full_payload_precommit_may_substitute_for_route_first_signature",
        "route_first_precommit_may_authorize_stage_two_payload",
        "may_attach_stage_two_payload_to_route_first_message",
        "willing_reply_may_auto_send_stage_two",
        "must_use_stage_two_authorization_gate_after_willing_reply"
      ],
      "properties": {
        "this_precommit_covers_route_first_only": {"const": true},
        "full_payload_precommit_may_substitute_for_route_first_signature": {"const": false},
        "route_first_precommit_may_authorize_stage_two_payload": {"const": false},
        "may_attach_stage_two_payload_to_route_first_message": {"const": false},
        "willing_reply_may_auto_send_stage_two": {"const": false},
        "must_use_stage_two_authorization_gate_after_willing_reply": {"const": true}
      }
    },
    "residual_blockers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_signature_still_required",
        "sender_authority_still_required",
        "private_vault_roots_still_required",
        "send_time_locator_recheck_still_required",
        "send_time_hash_recompute_still_required",
        "actual_transport_proof_still_absent",
        "precommit_may_satisfy_route_first_send_gate"
      ],
      "properties": {
        "human_signature_still_required": {"const": true},
        "sender_authority_still_required": {"const": true},
        "private_vault_roots_still_required": {"const": true},
        "send_time_locator_recheck_still_required": {"const": true},
        "send_time_hash_recompute_still_required": {"const": true},
        "actual_transport_proof_still_absent": {"const": true},
        "precommit_may_satisfy_route_first_send_gate": {"const": false}
      }
    },
    "nonclosure_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precommit_may_close_first_artifact_tasks", "do_not_close_by_narrative", "operating_board_active_count_required", "operating_board_active_count_observed"],
      "properties": {
        "precommit_may_close_first_artifact_tasks": {"const": false},
        "do_not_close_by_narrative": {"type": "array", "minItems": 3, "items": {"type": "string"}},
        "operating_board_active_count_required": {"const": 7},
        "operating_board_active_count_observed": {"const": 7}
      }
    },
    "operational_state": {"type": "object", "additionalProperties": {"const": false}, "minProperties": 8},
    "downstream_locks": {"type": "object", "additionalProperties": {"const": false}, "minProperties": 10},
    "public_summary": {"type": "string", "minLength": 80},
    "no_live_floor_effect": {"const": true}
  }
}
