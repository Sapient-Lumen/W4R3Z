{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/first-real-artifact-pilot-report.schema.json",
  "title": "First Real Artifact Pilot Report",
  "description": "Report emitted by tools/prepare_first_real_artifact_pilot.py; validates that the pilot produced only a public shell and optional LEAP candidate, not custody/response/intake/import/floor credit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pilot_id",
    "schema_version",
    "revision",
    "created_at",
    "generated_by_tool",
    "generated_public_paths",
    "private_vault_locator",
    "public_hash_commitment",
    "leap_candidate_state",
    "blocked_downstream_objects",
    "no_live_floor_effect",
    "public_summary"
  ],
  "properties": {
    "pilot_id": {
      "type": "string",
      "pattern": "^FRAP-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "first-real-artifact-pilot-report-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by_tool": {
      "const": "tools/prepare_first_real_artifact_pilot.py"
    },
    "generated_public_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_drop_ledger",
        "evidence_vault_public_shell",
        "live_evidence_acquisition_packet"
      ],
      "properties": {
        "evidence_drop_ledger": {
          "type": "string"
        },
        "evidence_vault_public_shell": {
          "type": "string"
        },
        "live_evidence_acquisition_packet": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "private_vault_locator": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^private-vault://.+$"
    },
    "public_hash_commitment": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "leap_candidate_state": {
      "type": "string",
      "enum": [
        "not-emitted",
        "candidate-artifact-received-no-downstream-release"
      ]
    },
    "blocked_downstream_objects": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "no_live_floor_effect": {
      "const": true
    },
    "public_summary": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "leap_candidate_state": {
            "const": "candidate-artifact-received-no-downstream-release"
          }
        },
        "required": [
          "leap_candidate_state"
        ]
      },
      "then": {
        "properties": {
          "generated_public_paths": {
            "properties": {
              "live_evidence_acquisition_packet": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "leap_candidate_state": {
            "const": "not-emitted"
          }
        },
        "required": [
          "leap_candidate_state"
        ]
      },
      "then": {
        "properties": {
          "generated_public_paths": {
            "properties": {
              "live_evidence_acquisition_packet": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
