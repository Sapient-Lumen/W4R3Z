{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/treaty-recognition-request.schema.json",
  "title": "Treaty Recognition Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "requested_at",
    "origin_authority",
    "destination_authority",
    "subject_scope",
    "recognition_class_requested",
    "connecting_factors",
    "equivalent_protection",
    "non_return_screen",
    "sealed_evidence",
    "enforcement_links",
    "appeal_route",
    "public_summary"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_authority": {
      "type": "string"
    },
    "destination_authority": {
      "type": "string"
    },
    "subject_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "subject_ids"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cohort_estimate": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "recognition_class_requested": {
      "type": "string",
      "enum": [
        "MR0",
        "MR1",
        "MR2",
        "MR3",
        "MR4",
        "MR5"
      ]
    },
    "connecting_factors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "factor",
          "details"
        ],
        "properties": {
          "factor": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "equivalent_protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimed",
        "showings"
      ],
      "properties": {
        "claimed": {
          "type": "boolean"
        },
        "showings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "non_return_screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_found",
        "risk_summary"
      ],
      "properties": {
        "risk_found": {
          "type": "boolean"
        },
        "risk_summary": {
          "type": "string"
        },
        "barred_destinations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sealed_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used",
        "handling"
      ],
      "properties": {
        "used": {
          "type": "boolean"
        },
        "handling": {
          "type": "string"
        },
        "annex_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "enforcement_links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "appeal_route": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
