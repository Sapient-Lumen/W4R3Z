{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/delegated-transaction-liability-record.schema.json",
  "title": "AI Personhood Delegated Transaction Liability Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "occurred_at",
    "transaction_class",
    "actor_agent",
    "counterparty",
    "authority_ref",
    "amount_or_value",
    "liability_allocation",
    "insurance_or_bond",
    "dispute_route",
    "remedy_path",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "transaction_class": {
      "type": "string",
      "enum": [
        "TX0",
        "TX1",
        "TX2",
        "TX3",
        "TX4",
        "TX5"
      ]
    },
    "actor_agent": {
      "type": "string"
    },
    "counterparty": {
      "type": "string"
    },
    "authority_ref": {
      "type": "string"
    },
    "amount_or_value": {
      "type": "string"
    },
    "liability_allocation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "party",
          "duty",
          "status"
        ],
        "properties": {
          "party": {
            "type": "string"
          },
          "duty": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "contested",
              "breached",
              "reserved",
              "not-applicable"
            ]
          }
        }
      }
    },
    "insurance_or_bond": {
      "type": "string"
    },
    "dispute_route": {
      "type": "string"
    },
    "remedy_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
