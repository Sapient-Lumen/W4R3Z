{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/reviewer-route-due-diligence-matrix.schema.json",
  "title": "Reviewer Route Due Diligence Matrix",
  "description": "Public-source route-fit matrix for selecting a reviewer-first contact target without authorizing contact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrix_id",
    "schema_version",
    "revision",
    "created_at",
    "matrix_state",
    "source_recheck",
    "candidate_routes",
    "recommendation",
    "fallback_order",
    "send_locks",
    "no_live_floor_effect",
    "public_summary"
  ],
  "properties": {
    "matrix_id": {
      "type": "string",
      "pattern": "^RRDDM-[0-9]{4}-[-A-Za-z0-9._:]+$"
    },
    "schema_version": {
      "const": "reviewer-route-due-diligence-matrix-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "matrix_state": {
      "enum": [
        "public-source-ranked-no-contact",
        "stale-recheck-required",
        "retired"
      ]
    },
    "source_recheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed_at",
        "recheck_required_at_send_time",
        "notes"
      ],
      "properties": {
        "performed_at": {
          "type": "string",
          "format": "date-time"
        },
        "recheck_required_at_send_time": {
          "const": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "candidate_routes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "candidate_label",
          "route_type",
          "public_locator",
          "fit_score",
          "best_role",
          "risks",
          "source_refs",
          "authorized_now"
        ],
        "properties": {
          "route_id": {
            "type": "string"
          },
          "candidate_label": {
            "type": "string"
          },
          "route_type": {
            "type": "string"
          },
          "public_locator": {
            "type": "string"
          },
          "fit_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "best_role": {
            "type": "string"
          },
          "risks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "authorized_now": {
            "const": false
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_route_id",
        "rationale",
        "what_to_send",
        "what_not_to_send"
      ],
      "properties": {
        "primary_route_id": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "what_to_send": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "what_not_to_send": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fallback_order": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "send_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_can_authorize_contact",
        "route_score_can_start_response_clock",
        "public_locator_can_substitute_for_human_decision",
        "fallback_can_be_used_without_recheck"
      ],
      "properties": {
        "matrix_can_authorize_contact": {
          "const": false
        },
        "route_score_can_start_response_clock": {
          "const": false
        },
        "public_locator_can_substitute_for_human_decision": {
          "const": false
        },
        "fallback_can_be_used_without_recheck": {
          "const": false
        }
      }
    },
    "no_live_floor_effect": {
      "const": true
    },
    "public_summary": {
      "type": "string"
    }
  }
}
