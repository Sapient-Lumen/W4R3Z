{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-route-first-send-capture-gate.schema.json",
  "title": "External Contact Route-First Send Capture Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_id",
    "schema_version",
    "revision",
    "created_at",
    "gate_state",
    "source_refs",
    "message_binding",
    "blocker_state",
    "blocker_resolution_summary",
    "capture_ladder",
    "reply_ladder",
    "operator_next_step",
    "refactor_audit",
    "operational_state",
    "downstream_locks",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "gate_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "external-contact-route-first-send-capture-gate-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "gate_state": {
      "enum": [
        "blocked-route-first-no-human-send-no-transport",
        "superseded"
      ]
    },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_first_preflight",
        "route_first_body",
        "route_first_mail_ready_draft",
        "stage_two_payload_manifest",
        "route_first_human_sender_authority_precommit",
        "human_sender_authority_precommit",
        "current_public_locator_recheck",
        "route_fit_review",
        "conflict_coercion_review",
        "transport_capture_plan",
        "send_trace_shell",
        "send_proof_record",
        "delivery_status_record",
        "inbound_vault_precommit",
        "inbound_capture_shell",
        "response_triage_record",
        "operating_board"
      ],
      "properties": {
        "route_first_preflight": {
          "type": "string"
        },
        "route_first_body": {
          "type": "string"
        },
        "route_first_mail_ready_draft": {
          "type": "string"
        },
        "stage_two_payload_manifest": {
          "type": "string"
        },
        "human_sender_authority_precommit": {
          "type": "string"
        },
        "current_public_locator_recheck": {
          "type": "string"
        },
        "route_fit_review": {
          "type": "string"
        },
        "conflict_coercion_review": {
          "type": "string"
        },
        "transport_capture_plan": {
          "type": "string"
        },
        "send_trace_shell": {
          "type": "string"
        },
        "send_proof_record": {
          "type": "string"
        },
        "delivery_status_record": {
          "type": "string"
        },
        "inbound_vault_precommit": {
          "type": "string"
        },
        "inbound_capture_shell": {
          "type": "string"
        },
        "response_triage_record": {
          "type": "string"
        },
        "operating_board": {
          "type": "string"
        },
        "route_first_human_sender_authority_precommit": {
          "type": "string"
        }
      }
    },
    "message_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "target_recipient",
        "request_type",
        "body_ref",
        "mail_ready_draft_ref",
        "body_word_count",
        "body_sha256",
        "mail_ready_draft_sha256",
        "attachments_included",
        "payload_item_count_attached",
        "stage_two_payload_sent",
        "draft_may_be_edited_after_authorization",
        "draft_may_start_response_clock"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 12
        },
        "target_recipient": {
          "const": "info@raicollab.org"
        },
        "request_type": {
          "const": "route-first-routing-and-willingness-inquiry"
        },
        "body_ref": {
          "type": "string"
        },
        "mail_ready_draft_ref": {
          "type": "string"
        },
        "body_word_count": {
          "type": "integer",
          "minimum": 60,
          "maximum": 180
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mail_ready_draft_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attachments_included": {
          "const": false
        },
        "payload_item_count_attached": {
          "const": 0
        },
        "stage_two_payload_sent": {
          "const": false
        },
        "draft_may_be_edited_after_authorization": {
          "const": false
        },
        "draft_may_start_response_clock": {
          "const": false
        }
      }
    },
    "blocker_state": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "precondition_id",
          "label",
          "required_before_route_first_send",
          "satisfied_now",
          "evidence_required",
          "failure_mode_blocked"
        ],
        "properties": {
          "precondition_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "required_before_route_first_send": {
            "const": true
          },
          "satisfied_now": {
            "type": "boolean"
          },
          "evidence_required": {
            "type": "string",
            "minLength": 8
          },
          "failure_mode_blocked": {
            "type": "string",
            "minLength": 8
          },
          "satisfied_by_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "blocker_resolution_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_preconditions",
        "satisfied_now_count",
        "unsatisfied_now_count",
        "satisfied_precondition_ids",
        "unsatisfied_precondition_ids",
        "gate_remains_blocked"
      ],
      "properties": {
        "total_preconditions": {
          "type": "integer",
          "minimum": 10
        },
        "satisfied_now_count": {
          "type": "integer",
          "minimum": 0
        },
        "unsatisfied_now_count": {
          "type": "integer",
          "minimum": 1
        },
        "satisfied_precondition_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsatisfied_precondition_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gate_remains_blocked": {
          "const": true
        }
      }
    },
    "capture_ladder": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_id",
          "trigger",
          "required_evidence",
          "public_output_limit",
          "may_start_route_wait_window",
          "may_create_custody_intake_import_or_floor"
        ],
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "required_evidence": {
            "type": "string"
          },
          "public_output_limit": {
            "type": "string"
          },
          "may_start_route_wait_window": {
            "type": "boolean"
          },
          "may_create_custody_intake_import_or_floor": {
            "const": false
          }
        }
      }
    },
    "reply_ladder": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class_id",
          "trigger",
          "first_action",
          "stage_two_next_action",
          "may_send_stage_two_without_new_authorization",
          "may_create_custody_intake_import_or_floor"
        ],
        "properties": {
          "class_id": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "first_action": {
            "type": "string"
          },
          "stage_two_next_action": {
            "type": "string"
          },
          "may_send_stage_two_without_new_authorization": {
            "const": false
          },
          "may_create_custody_intake_import_or_floor": {
            "const": false
          }
        }
      }
    },
    "operator_next_step": {
      "type": "string",
      "minLength": 20
    },
    "refactor_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_first_is_primary_active_path",
        "full_payload_is_stage_two",
        "active_queue_count_required",
        "active_queue_count_observed",
        "non_board_queue_items_may_close_first_artifact_by_narrative",
        "route_first_gate_added_to_lint"
      ],
      "properties": {
        "route_first_is_primary_active_path": {
          "const": true
        },
        "full_payload_is_stage_two": {
          "const": true
        },
        "active_queue_count_required": {
          "const": 7
        },
        "active_queue_count_observed": {
          "const": 7
        },
        "non_board_queue_items_may_close_first_artifact_by_narrative": {
          "const": false
        },
        "route_first_gate_added_to_lint": {
          "const": true
        }
      }
    },
    "operational_state": {
      "type": "object",
      "additionalProperties": {
        "const": false
      },
      "minProperties": 8
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": {
        "const": false
      },
      "minProperties": 10
    },
    "related_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string",
      "minLength": 80
    },
    "no_live_floor_effect": {
      "const": true
    }
  }
}
