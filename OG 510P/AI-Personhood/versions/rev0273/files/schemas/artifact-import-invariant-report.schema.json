{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/artifact-import-invariant-report.schema.json",
  "title": "Artifact Import Invariant Report",
  "description": "Generated invariant report for live-artifact import readiness, computed-floor output, and no-overclaim gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "schema_version",
    "created_at",
    "revision",
    "generated_by_tool",
    "computed_snapshot_ref",
    "fieldkit_ref",
    "archive_floor",
    "invariant_checks",
    "source_scans",
    "decision"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^AIIR-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "artifact-import-invariant-report-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "generated_by_tool": {
      "type": "string"
    },
    "computed_snapshot_ref": {
      "type": "string"
    },
    "fieldkit_ref": {
      "type": "string"
    },
    "archive_floor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_receipts_present",
        "eligible_live_imports",
        "live_classes_satisfied",
        "missing_live_classes",
        "cross_critical_quorum_satisfied",
        "reliance_effect"
      ],
      "properties": {
        "independent_receipts_present": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_live_imports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "live_classes_satisfied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_live_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cross_critical_quorum_satisfied": {
          "type": "boolean"
        },
        "reliance_effect": {
          "type": "string"
        }
      }
    },
    "invariant_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "passed",
          "severity",
          "observed",
          "expected",
          "failure_effect"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "observed": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "failure_effect": {
            "type": "string"
          }
        }
      }
    },
    "source_scans": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import_gate_paths",
        "custody_record_paths",
        "fieldkit_paths",
        "computed_snapshot_paths",
        "cryptographic_adapter_paths",
        "disallowed_positive_archive_paths"
      ],
      "properties": {
        "import_gate_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "custody_record_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fieldkit_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "computed_snapshot_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disallowed_positive_archive_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cryptographic_adapter_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "live_evidence_acquisition_packet_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "live_artifact_admission_graph_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "custody_gate_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "response_gate_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intake_conversion_gate_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "import_readiness_gate_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activation_record_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quorum_participation_record_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "floor_recompute_receipt_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publication_rollback_adjudication_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "late_change_ingress_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "late_change_notice_dispatch_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "late_change_remedy_resolution_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "late_change_remedy_execution_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_import_now",
        "may_upgrade_reliance",
        "next_action",
        "blocked_actions"
      ],
      "properties": {
        "may_import_now": {
          "type": "boolean"
        },
        "may_upgrade_reliance": {
          "type": "boolean"
        },
        "next_action": {
          "type": "string"
        },
        "blocked_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
