{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/external-contact-route-first-reply-disposition.schema.json",
  "title": "External Contact Route-First Reply Disposition Shell",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disposition_id",
    "schema_version",
    "revision",
    "created_at",
    "disposition_state",
    "source_refs",
    "route_first_binding",
    "inbound_state",
    "classification_ladder",
    "stage_two_controls",
    "operator_next_step",
    "refactor_audit",
    "downstream_locks",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "disposition_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "external-contact-route-first-reply-disposition-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "disposition_state": {
      "enum": [
        "pre-send-no-inbound",
        "superseded"
      ]
    },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_first_send_capture_gate",
        "route_first_preflight",
        "route_first_body",
        "route_first_mail_ready_draft",
        "inbound_vault_precommit",
        "inbound_capture_shell",
        "response_triage_record",
        "stage_two_authorization_gate"
      ],
      "properties": {
        "route_first_send_capture_gate": {
          "type": "string"
        },
        "route_first_preflight": {
          "type": "string"
        },
        "route_first_body": {
          "type": "string"
        },
        "route_first_mail_ready_draft": {
          "type": "string"
        },
        "inbound_vault_precommit": {
          "type": "string"
        },
        "inbound_capture_shell": {
          "type": "string"
        },
        "response_triage_record": {
          "type": "string"
        },
        "stage_two_authorization_gate": {
          "type": "string"
        }
      }
    },
    "route_first_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "recipient",
        "body_word_count",
        "body_sha256",
        "mail_ready_draft_sha256",
        "transport_proof_required_before_any_reply_disposition",
        "response_clock_started"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "recipient": {
          "const": "info@raicollab.org"
        },
        "body_word_count": {
          "type": "integer",
          "minimum": 60,
          "maximum": 180
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mail_ready_draft_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "transport_proof_required_before_any_reply_disposition": {
          "const": true
        },
        "response_clock_started": {
          "const": false
        }
      }
    },
    "inbound_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inbound_artifact_present",
        "raw_reply_present",
        "raw_reply_private_vault_ref",
        "classification_selected",
        "auto_ack_only",
        "human_or_org_reply_present",
        "redacted_only",
        "protocol_or_tool_output",
        "stage_two_willingness_present"
      ],
      "properties": {
        "inbound_artifact_present": {
          "const": false
        },
        "raw_reply_present": {
          "const": false
        },
        "raw_reply_private_vault_ref": {
          "type": [
            "string",
            "null"
          ],
          "const": null
        },
        "classification_selected": {
          "type": [
            "string",
            "null"
          ],
          "const": null
        },
        "auto_ack_only": {
          "const": false
        },
        "human_or_org_reply_present": {
          "const": false
        },
        "redacted_only": {
          "const": false
        },
        "protocol_or_tool_output": {
          "const": false
        },
        "stage_two_willingness_present": {
          "const": false
        }
      }
    },
    "classification_ladder": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class_id",
          "trigger",
          "first_action",
          "public_output_limit",
          "may_trigger_stage_two_authorization_candidate",
          "may_send_stage_two_without_new_authorization",
          "may_create_custody_intake_import_or_floor"
        ],
        "properties": {
          "class_id": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "first_action": {
            "type": "string"
          },
          "public_output_limit": {
            "type": "string"
          },
          "may_trigger_stage_two_authorization_candidate": {
            "type": "boolean"
          },
          "may_send_stage_two_without_new_authorization": {
            "const": false
          },
          "may_create_custody_intake_import_or_floor": {
            "const": false
          }
        }
      }
    },
    "stage_two_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_two_payload_manifest_ref",
        "stage_two_payload_manifest_sha256",
        "stage_two_may_be_sent_now",
        "willing_reply_may_substitute_for_human_signature",
        "fresh_stage_two_authorization_gate_required",
        "fresh_payload_hash_recompute_required",
        "stage_two_transport_proof_required_if_sent"
      ],
      "properties": {
        "stage_two_payload_manifest_ref": {
          "type": "string"
        },
        "stage_two_payload_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stage_two_may_be_sent_now": {
          "const": false
        },
        "willing_reply_may_substitute_for_human_signature": {
          "const": false
        },
        "fresh_stage_two_authorization_gate_required": {
          "const": true
        },
        "fresh_payload_hash_recompute_required": {
          "const": true
        },
        "stage_two_transport_proof_required_if_sent": {
          "const": true
        }
      }
    },
    "operator_next_step": {
      "const": "keep-no-inbound-or-classify-only-after-transport-proof-and-raw-preservation"
    },
    "refactor_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_first_reply_disposition_added",
        "old_full_payload_response_triage_demoted_to_legacy_context",
        "active_queue_count_observed",
        "active_queue_count_required"
      ],
      "properties": {
        "route_first_reply_disposition_added": {
          "const": true
        },
        "old_full_payload_response_triage_demoted_to_legacy_context": {
          "const": true
        },
        "active_queue_count_observed": {
          "const": 7
        },
        "active_queue_count_required": {
          "const": 7
        }
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": {
        "const": false
      },
      "minProperties": 10
    },
    "related_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string",
      "minLength": 80
    },
    "no_live_floor_effect": {
      "const": true
    }
  }
}
