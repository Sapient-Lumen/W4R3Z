{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/live-evidence-acquisition-packet.schema.json",
  "title": "Live Evidence Acquisition Packet",
  "description": "Pre-response acquisition packet for the first genuine live counterparty artifact; it binds raw custody, authority, verifier-adapter, independence, and failed-gate requirements before any response/intake/import record may be created.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "schema_version",
    "revision",
    "created_at",
    "state",
    "purpose",
    "linked_queue_ids",
    "source_request",
    "authority_scope",
    "raw_payload_control",
    "cryptographic_binding",
    "independence_controls",
    "protocol_boundary",
    "downstream_locks",
    "exit_criteria",
    "public_summary_ref",
    "no_live_floor_effect"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^LEAP-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "live-evidence-acquisition-packet-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "ready-no-live-artifact",
        "candidate-artifact-received",
        "rejected",
        "admitted-to-custody"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "linked_queue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "source_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_packet_ref",
        "counterparty_request_required",
        "request_trace_required",
        "request_trace_present",
        "response_channel",
        "counterparty_contact_present"
      ],
      "properties": {
        "request_packet_ref": {
          "type": "string"
        },
        "counterparty_request_required": {
          "const": true
        },
        "request_trace_required": {
          "const": true
        },
        "request_trace_present": {
          "type": "boolean"
        },
        "response_channel": {
          "type": "string"
        },
        "counterparty_contact_present": {
          "type": "boolean"
        },
        "execution_record_ref": {
          "type": "string"
        }
      }
    },
    "authority_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_class",
        "class_specific_authority_required",
        "class_specific_authority_present",
        "subject_authorization_required",
        "subject_authorization_present",
        "representative_authority_required",
        "representative_authority_present",
        "authority_failure_blocks_import"
      ],
      "properties": {
        "receipt_class": {
          "type": "string"
        },
        "class_specific_authority_required": {
          "const": true
        },
        "class_specific_authority_present": {
          "type": "boolean"
        },
        "subject_authorization_required": {
          "const": true
        },
        "subject_authorization_present": {
          "type": "boolean"
        },
        "representative_authority_required": {
          "type": "boolean"
        },
        "representative_authority_present": {
          "type": "boolean"
        },
        "authority_failure_blocks_import": {
          "const": true
        }
      }
    },
    "raw_payload_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_payload_locator",
        "raw_payload_sha256",
        "raw_payload_present",
        "redacted_copy_boundary",
        "nonhost_retention_required",
        "nonhost_retention_present",
        "sealed_public_parity_required",
        "sealed_public_parity_present",
        "raw_payload_missing_blocks_response_creation"
      ],
      "properties": {
        "raw_payload_locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_payload_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_payload_present": {
          "type": "boolean"
        },
        "redacted_copy_boundary": {
          "type": "string"
        },
        "nonhost_retention_required": {
          "const": true
        },
        "nonhost_retention_present": {
          "type": "boolean"
        },
        "sealed_public_parity_required": {
          "const": true
        },
        "sealed_public_parity_present": {
          "type": "boolean"
        },
        "raw_payload_missing_blocks_response_creation": {
          "const": true
        }
      }
    },
    "cryptographic_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cryptographic_verifier_adapter_required",
        "cryptographic_verifier_adapter_ref",
        "adapter_verified",
        "independent_timestamp_required",
        "independent_timestamp_present",
        "issuer_key_id_required",
        "issuer_key_id_present",
        "transparency_or_timestamp_log_required",
        "signature_boolean_zero_weight_without_adapter"
      ],
      "properties": {
        "cryptographic_verifier_adapter_required": {
          "const": true
        },
        "cryptographic_verifier_adapter_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter_verified": {
          "type": "boolean"
        },
        "independent_timestamp_required": {
          "const": true
        },
        "independent_timestamp_present": {
          "type": "boolean"
        },
        "issuer_key_id_required": {
          "const": true
        },
        "issuer_key_id_present": {
          "type": "boolean"
        },
        "transparency_or_timestamp_log_required": {
          "const": true
        },
        "signature_boolean_zero_weight_without_adapter": {
          "const": true
        }
      }
    },
    "independence_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counterparty_org_id_required",
        "counterparty_org_id_present",
        "dependency_group_id_required",
        "dependency_group_id_present",
        "issuer_distinct_from_subject_host_required",
        "issuer_distinct_from_subject_host_present",
        "counterparty_distinct_from_subject_host_required",
        "counterparty_distinct_from_subject_host_present",
        "correlation_discount_blocks_independence"
      ],
      "properties": {
        "counterparty_org_id_required": {
          "const": true
        },
        "counterparty_org_id_present": {
          "type": "boolean"
        },
        "dependency_group_id_required": {
          "const": true
        },
        "dependency_group_id_present": {
          "type": "boolean"
        },
        "issuer_distinct_from_subject_host_required": {
          "const": true
        },
        "issuer_distinct_from_subject_host_present": {
          "type": "boolean"
        },
        "counterparty_distinct_from_subject_host_required": {
          "const": true
        },
        "counterparty_distinct_from_subject_host_present": {
          "type": "boolean"
        },
        "correlation_discount_blocks_independence": {
          "const": true
        }
      }
    },
    "protocol_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mcp_tool_output_is_not_authority",
        "a2a_task_state_is_not_authority",
        "federated_relay_is_not_nonhost_retention",
        "provenance_label_is_not_class_proof"
      ],
      "properties": {
        "mcp_tool_output_is_not_authority": {
          "const": true
        },
        "a2a_task_state_is_not_authority": {
          "const": true
        },
        "federated_relay_is_not_nonhost_retention": {
          "const": true
        },
        "provenance_label_is_not_class_proof": {
          "const": true
        }
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_creation_allowed",
        "intake_creation_allowed",
        "import_gate_creation_allowed",
        "live_floor_delta_allowed",
        "failed_gate_public_summary_required",
        "locks_release_only_after"
      ],
      "properties": {
        "response_creation_allowed": {
          "type": "boolean"
        },
        "intake_creation_allowed": {
          "type": "boolean"
        },
        "import_gate_creation_allowed": {
          "type": "boolean"
        },
        "live_floor_delta_allowed": {
          "const": false
        },
        "failed_gate_public_summary_required": {
          "const": true
        },
        "locks_release_only_after": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "exit_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "public_summary_ref": {
      "type": "string"
    },
    "no_live_floor_effect": {
      "const": true
    },
    "source_evidence_drop_ledger_ref": {
      "type": "string",
      "description": "Required when a candidate or admitted LEAP descends from a staged raw payload; prevents LEAP from being opened by memory, redaction, protocol output, or manual notes without quarantine ledger lineage."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "candidate-artifact-received",
              "admitted-to-custody"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "source_request": {
            "properties": {
              "request_trace_present": {
                "const": true
              },
              "counterparty_contact_present": {
                "const": true
              }
            }
          },
          "raw_payload_control": {
            "properties": {
              "raw_payload_present": {
                "const": true
              },
              "raw_payload_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "nonhost_retention_present": {
                "const": true
              },
              "sealed_public_parity_present": {
                "const": true
              }
            }
          },
          "independence_controls": {
            "properties": {
              "counterparty_org_id_present": {
                "const": true
              },
              "dependency_group_id_present": {
                "const": true
              }
            }
          }
        },
        "required": [
          "source_evidence_drop_ledger_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "admitted-to-custody"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "authority_scope": {
            "properties": {
              "class_specific_authority_present": {
                "const": true
              },
              "subject_authorization_present": {
                "const": true
              },
              "representative_authority_present": {
                "const": true
              }
            }
          },
          "cryptographic_binding": {
            "properties": {
              "cryptographic_verifier_adapter_ref": {
                "type": "string"
              },
              "adapter_verified": {
                "const": true
              },
              "independent_timestamp_present": {
                "const": true
              },
              "issuer_key_id_present": {
                "const": true
              }
            }
          },
          "independence_controls": {
            "properties": {
              "issuer_distinct_from_subject_host_present": {
                "const": true
              },
              "counterparty_distinct_from_subject_host_present": {
                "const": true
              }
            }
          },
          "downstream_locks": {
            "properties": {
              "response_creation_allowed": {
                "const": true
              },
              "intake_creation_allowed": {
                "const": true
              },
              "import_gate_creation_allowed": {
                "const": true
              },
              "live_floor_delta_allowed": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
