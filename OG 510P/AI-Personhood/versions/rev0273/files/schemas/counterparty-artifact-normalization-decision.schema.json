{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/counterparty-artifact-normalization-decision.schema.json",
  "title": "Counterparty Artifact Normalization Decision",
  "description": "Pre-candidate decision record for deciding whether inbound counterparty material can be normalized into a candidate-challenge path. It separates raw private-vault staging, public shell disclosure, safety scanning, authority/permission checks, and candidate challenge eligibility while keeping custody, formal response, intake, import, status, and live-floor effects blocked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "normalization_decision_id",
    "schema_version",
    "revision",
    "created_at",
    "decision_state",
    "source_vault_intake_record_ref",
    "source_evidence_drop_ledger_ref",
    "source_public_shell_ref",
    "source_response_triage_record_ref",
    "raw_candidate_state",
    "normalization_pipeline",
    "minimum_candidate_challenge_inputs",
    "decision",
    "public_shell_update_policy",
    "downstream_locks",
    "operator_next_steps",
    "linked_queue_ids",
    "related_surfaces",
    "public_summary",
    "no_live_floor_effect"
  ],
  "properties": {
    "normalization_decision_id": {"type": "string", "pattern": "^CAND-[0-9]{4}-[A-Za-z0-9._:-]+$"},
    "schema_version": {"const": "counterparty-artifact-normalization-decision-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "decision_state": {
      "type": "string",
      "enum": [
        "pre-dispatch-no-inbound",
        "raw-candidate-private-vault-staged",
        "blocked-redacted-only",
        "blocked-protocol-output",
        "blocked-unsafe-archive",
        "rejected",
        "superseded"
      ]
    },
    "source_vault_intake_record_ref": {"type": "string"},
    "source_evidence_drop_ledger_ref": {"type": "string"},
    "source_public_shell_ref": {"type": "string"},
    "source_response_triage_record_ref": {"type": "string"},
    "raw_candidate_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inbound_artifact_present",
        "ledger_intake_mode",
        "source_payload_kind",
        "private_vault_locator",
        "raw_hash_present",
        "raw_size_present",
        "mime_type_present",
        "raw_bytes_in_release_tree",
        "redacted_copy_only",
        "protocol_or_tool_output",
        "contains_archive",
        "nested_archive_detected",
        "path_traversal_detected",
        "malware_scan_state",
        "transport_trace_verified",
        "counterparty_identity_verified",
        "retention_permission_verified",
        "nonhost_retention_verified",
        "independent_timestamp_verified",
        "authority_verified",
        "can_open_candidate_challenge"
      ],
      "properties": {
        "inbound_artifact_present": {"type": "boolean"},
        "ledger_intake_mode": {"type": "string", "enum": ["none", "ready-no-drop", "quarantine-control", "live-candidate-drop", "rejected"]},
        "source_payload_kind": {"type": "string", "enum": ["none", "raw-email", "signed-letter", "web-form-receipt", "api-payload", "mcp-tool-output", "a2a-task-artifact", "federated-relay", "public-redaction", "file-upload", "unknown"]},
        "private_vault_locator": {"type": ["string", "null"], "pattern": "^private-vault://.*$"},
        "raw_hash_present": {"type": "boolean"},
        "raw_size_present": {"type": "boolean"},
        "mime_type_present": {"type": "boolean"},
        "raw_bytes_in_release_tree": {"const": false},
        "redacted_copy_only": {"type": "boolean"},
        "protocol_or_tool_output": {"type": "boolean"},
        "contains_archive": {"type": "boolean"},
        "nested_archive_detected": {"type": "boolean"},
        "path_traversal_detected": {"type": "boolean"},
        "malware_scan_state": {"type": "string", "enum": ["not-applicable-yet", "pending", "passed", "failed", "unavailable"]},
        "transport_trace_verified": {"type": "boolean"},
        "counterparty_identity_verified": {"type": "boolean"},
        "retention_permission_verified": {"type": "boolean"},
        "nonhost_retention_verified": {"type": "boolean"},
        "independent_timestamp_verified": {"type": "boolean"},
        "authority_verified": {"type": "boolean"},
        "can_open_candidate_challenge": {"type": "boolean"}
      }
    },
    "normalization_pipeline": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "purpose", "required_input", "public_output_allowed", "creates_custody_or_response", "blocked_if_missing"],
        "properties": {
          "step_id": {"type": "string"},
          "purpose": {"type": "string", "minLength": 20},
          "required_input": {"type": "string", "minLength": 10},
          "public_output_allowed": {"type": "boolean"},
          "creates_custody_or_response": {"const": false},
          "blocked_if_missing": {"type": "string", "minLength": 20}
        }
      }
    },
    "minimum_candidate_challenge_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_raw_payload_staged_required",
        "sha256_size_mime_required",
        "release_tree_absence_required",
        "safe_archive_scan_required",
        "transport_trace_required",
        "counterparty_identity_required",
        "retention_permission_required",
        "nonhost_retention_required",
        "independent_timestamp_required",
        "authority_verification_required",
        "redaction_protocol_and_synthetic_exclusion_required",
        "public_shell_update_required",
        "candidate_challenge_report_required",
        "all_present_now"
      ],
      "properties": {
        "private_raw_payload_staged_required": {"const": true},
        "sha256_size_mime_required": {"const": true},
        "release_tree_absence_required": {"const": true},
        "safe_archive_scan_required": {"const": true},
        "transport_trace_required": {"const": true},
        "counterparty_identity_required": {"const": true},
        "retention_permission_required": {"const": true},
        "nonhost_retention_required": {"const": true},
        "independent_timestamp_required": {"const": true},
        "authority_verification_required": {"const": true},
        "redaction_protocol_and_synthetic_exclusion_required": {"const": true},
        "public_shell_update_required": {"const": true},
        "candidate_challenge_report_required": {"const": true},
        "all_present_now": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "allowed_next_state", "prohibited_claims"],
      "properties": {
        "status": {"type": "string", "enum": ["not-admitted-no-inbound", "candidate-challenge-stayed", "blocked-shell-only", "rejected"]},
        "reason": {"type": "string", "minLength": 40},
        "allowed_next_state": {"type": "string", "minLength": 20},
        "prohibited_claims": {"type": "array", "minItems": 9, "items": {"type": "string"}}
      }
    },
    "public_shell_update_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_publish_hash_size_mime_only_when_permitted",
        "must_not_publish_raw_bytes",
        "must_not_publish_private_vault_locator_absolute_path",
        "must_disclose_failed_gate_reason",
        "shell_not_custody_or_authority",
        "status_language_forbidden"
      ],
      "properties": {
        "may_publish_hash_size_mime_only_when_permitted": {"const": true},
        "must_not_publish_raw_bytes": {"const": true},
        "must_not_publish_private_vault_locator_absolute_path": {"const": true},
        "must_disclose_failed_gate_reason": {"const": true},
        "shell_not_custody_or_authority": {"const": true},
        "status_language_forbidden": {"const": true}
      }
    },
    "downstream_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_open_candidate_challenge_report",
        "may_create_custody_record",
        "may_create_formal_response_record",
        "may_create_intake_record",
        "may_create_import_gate",
        "may_increment_live_floor",
        "may_claim_status_or_recognition",
        "may_publish_raw_payload",
        "may_treat_normalization_as_authority"
      ],
      "properties": {
        "may_open_candidate_challenge_report": {"type": "boolean"},
        "may_create_custody_record": {"const": false},
        "may_create_formal_response_record": {"const": false},
        "may_create_intake_record": {"const": false},
        "may_create_import_gate": {"const": false},
        "may_increment_live_floor": {"const": false},
        "may_claim_status_or_recognition": {"const": false},
        "may_publish_raw_payload": {"const": false},
        "may_treat_normalization_as_authority": {"const": false}
      }
    },
    "operator_next_steps": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "linked_queue_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "related_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "public_summary": {"type": "string", "minLength": 100},
    "no_live_floor_effect": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"decision_state": {"const": "pre-dispatch-no-inbound"}}, "required": ["decision_state"]},
      "then": {
        "properties": {
          "raw_candidate_state": {
            "properties": {
              "inbound_artifact_present": {"const": false},
              "ledger_intake_mode": {"enum": ["none", "ready-no-drop", "quarantine-control"]},
              "private_vault_locator": {"const": null},
              "can_open_candidate_challenge": {"const": false}
            }
          },
          "minimum_candidate_challenge_inputs": {"properties": {"all_present_now": {"const": false}}},
          "decision": {"properties": {"status": {"const": "not-admitted-no-inbound"}}},
          "downstream_locks": {"properties": {"may_open_candidate_challenge_report": {"const": false}}}
        }
      }
    },
    {
      "if": {"properties": {"decision_state": {"const": "raw-candidate-private-vault-staged"}}, "required": ["decision_state"]},
      "then": {
        "properties": {
          "raw_candidate_state": {
            "properties": {
              "inbound_artifact_present": {"const": true},
              "ledger_intake_mode": {"const": "live-candidate-drop"},
              "private_vault_locator": {"type": "string", "pattern": "^private-vault://.*$"},
              "raw_hash_present": {"const": true},
              "raw_size_present": {"const": true},
              "mime_type_present": {"const": true},
              "redacted_copy_only": {"const": false},
              "protocol_or_tool_output": {"const": false},
              "nested_archive_detected": {"const": false},
              "path_traversal_detected": {"const": false},
              "transport_trace_verified": {"const": true},
              "counterparty_identity_verified": {"const": true},
              "retention_permission_verified": {"const": true},
              "nonhost_retention_verified": {"const": true},
              "independent_timestamp_verified": {"const": true},
              "authority_verified": {"const": true},
              "can_open_candidate_challenge": {"const": true}
            }
          },
          "minimum_candidate_challenge_inputs": {"properties": {"all_present_now": {"const": true}}},
          "decision": {"properties": {"status": {"const": "candidate-challenge-stayed"}}},
          "downstream_locks": {"properties": {"may_open_candidate_challenge_report": {"const": true}}}
        }
      }
    },
    {
      "if": {"properties": {"decision_state": {"const": "blocked-redacted-only"}}, "required": ["decision_state"]},
      "then": {
        "properties": {
          "raw_candidate_state": {"properties": {"redacted_copy_only": {"const": true}, "can_open_candidate_challenge": {"const": false}}},
          "decision": {"properties": {"status": {"const": "blocked-shell-only"}}},
          "downstream_locks": {"properties": {"may_open_candidate_challenge_report": {"const": false}}}
        }
      }
    },
    {
      "if": {"properties": {"decision_state": {"const": "blocked-protocol-output"}}, "required": ["decision_state"]},
      "then": {
        "properties": {
          "raw_candidate_state": {"properties": {"protocol_or_tool_output": {"const": true}, "can_open_candidate_challenge": {"const": false}}},
          "decision": {"properties": {"status": {"const": "blocked-shell-only"}}},
          "downstream_locks": {"properties": {"may_open_candidate_challenge_report": {"const": false}}}
        }
      }
    },
    {
      "if": {"properties": {"decision_state": {"const": "blocked-unsafe-archive"}}, "required": ["decision_state"]},
      "then": {
        "properties": {
          "raw_candidate_state": {"anyOf": [{"properties": {"nested_archive_detected": {"const": true}}}, {"properties": {"path_traversal_detected": {"const": true}}}]},
          "decision": {"properties": {"status": {"enum": ["blocked-shell-only", "rejected"]}}},
          "downstream_locks": {"properties": {"may_open_candidate_challenge_report": {"const": false}}}
        }
      }
    }
  ]
}
