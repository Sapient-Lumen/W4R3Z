{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/cryptographic-verifier-adapter.schema.json",
  "title": "Cryptographic Verifier Adapter",
  "description": "Reproducible verifier output for artifact authenticity. This proves payload hash/signature/key binding only; it does not prove subject authorization, receipt class satisfaction, or live-floor eligibility by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_id",
    "schema_version",
    "created_at",
    "revision",
    "test_role",
    "algorithm",
    "canonicalization",
    "payload",
    "payload_sha256",
    "public_key_encoding",
    "public_key",
    "signature_encoding",
    "signature",
    "signature_input",
    "verification",
    "independence",
    "admission_effect"
  ],
  "properties": {
    "adapter_id": {
      "type": "string",
      "pattern": "^CVA-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "cryptographic-verifier-adapter-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "test_role": {
      "type": "string",
      "enum": [
        "positive-control",
        "negative-control",
        "live-evidence"
      ]
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "canonicalization": {
      "const": "json-sort-keys-no-ws-v1"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "artifact_id",
        "artifact_class",
        "linked_import_gate_id",
        "receipt_class",
        "issued_at",
        "counterparty_org_id",
        "issuer_key_id",
        "dependency_group_id"
      ],
      "properties": {
        "artifact_id": {"type": "string"},
        "artifact_class": {"type": "string"},
        "linked_import_gate_id": {"type": "string"},
        "receipt_class": {"type": "string"},
        "issued_at": {"type": "string", "format": "date-time"},
        "counterparty_org_id": {"type": "string"},
        "issuer_key_id": {"type": "string"},
        "dependency_group_id": {"type": "string"}
      }
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "public_key_encoding": {
      "const": "base64-raw-ed25519-public-key"
    },
    "public_key": {
      "type": "string"
    },
    "signature_encoding": {
      "const": "base64-raw-ed25519-signature"
    },
    "signature": {
      "type": "string"
    },
    "signature_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed_payload_hash",
        "signed_payload_fields"
      ],
      "properties": {
        "signed_payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "signed_payload_fields": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_verification_result",
        "verified_by_tool",
        "verified_at",
        "failure_reason"
      ],
      "properties": {
        "expected_verification_result": {"type": "boolean"},
        "verified_by_tool": {"type": "string"},
        "verified_at": {"type": "string", "format": "date-time"},
        "failure_reason": {"type": "string"}
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counterparty_org_id",
        "issuer_key_id",
        "dependency_group_id",
        "subject_host_org_id",
        "counterparty_distinct_from_subject_host",
        "issuer_distinct_from_subject_host",
        "correlation_discount"
      ],
      "properties": {
        "counterparty_org_id": {"type": "string"},
        "issuer_key_id": {"type": "string"},
        "dependency_group_id": {"type": "string"},
        "subject_host_org_id": {"type": "string"},
        "counterparty_distinct_from_subject_host": {"type": "boolean"},
        "issuer_distinct_from_subject_host": {"type": "boolean"},
        "correlation_discount": {"type": "string", "enum": ["none", "partial", "full-exclusion"]}
      }
    },
    "admission_effect": {
      "type": "string",
      "enum": [
        "cryptographic-authenticity-only-no-live-floor-delta",
        "failed-verification-no-admission",
        "candidate-live-evidence-requires-import-gate"
      ]
    }
  }
}
