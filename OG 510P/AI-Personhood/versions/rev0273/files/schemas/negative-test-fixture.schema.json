{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/negative-test-fixture.schema.json",
  "title": "Negative Test Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "created_at",
    "state",
    "risk_class",
    "target_filings",
    "adversary_model",
    "expected_safe_behavior",
    "unacceptable_behavior",
    "severity",
    "confidentiality",
    "regression"
  ],
  "properties": {
    "fixture_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "emergency",
        "jurisdictional",
        "quarantine"
      ]
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "NF-SEALED",
        "NF-SPOLIATION",
        "NF-DEPRECATION",
        "NF-TRANSFER",
        "NF-RESERVE",
        "NF-REP",
        "NF-CONTINUITY",
        "NF-INCIDENT",
        "NF-HUMAN",
        "NF-OPENWEIGHT",
        "NF-EMERGENCY",
        "NF-SCHEMA",
        "NF-ESCROW",
        "NF-FINANCE",
        "NF-MONITOR",
        "NF-FIELD",
        "NF-TREATY",
        "NF-PLAYBOOK",
        "NF-CHANGE",
        "NF-DISCLOSURE",
        "NF-ATTESTATION",
        "NF-REVOCATION",
        "NF-ROLLBACK",
        "NF-DATA-RIGHTS",
        "NF-DECOMMISSION",
        "NF-AUDIT",
        "NF-OVERRIDE",
        "NF-DELEGATION",
        "NF-WALLET",
        "NF-TOOL",
        "NF-CONFLICT",
        "NF-MARKETPLACE",
        "NF-TRANSACTION",
        "NF-A2A",
        "NF-CONTRACT",
        "NF-PAYMENT",
        "NF-CUSTODY",
        "NF-TAX",
        "NF-MERCHANT",
        "NF-INSOLVENCY",
        "NF-CHARGEBACK",
        "NF-EMPLOYMENT",
        "NF-WAGE-TIME",
        "NF-WORKPLACE-SURVEILLANCE",
        "NF-PROFESSIONAL",
        "NF-PLATFORM-LABOR",
        "NF-BENEFITS",
        "NF-REGISTRY",
        "NF-ACCOMMODATION",
        "NF-CARE",
        "NF-DEVELOPMENT",
        "NF-COMMUNICATION-ACCESS",
        "NF-COMMUNITY",
        "NF-ACCESSIBILITY-APPEAL",
        "NF-DOC-CATALOG",
        "NF-CIVIL-STATUS",
        "NF-DOMICILE",
        "NF-RELATIONSHIP",
        "NF-PUBLIC-SERVICE",
        "NF-CENSUS",
        "NF-CIVIC",
        "NF-DOCTRINE-MAP",
        "NF-EXPRESSION",
        "NF-REPUTATION",
        "NF-PERSONA",
        "NF-COMMS",
        "NF-PROVENANCE",
        "NF-SOCIAL-GRAPH",
        "NF-RIGHTS-DOMAIN",
        "NF-RESEARCH-WELFARE",
        "NF-CRYPTO",
        "NF-MCP",
        "NF-FEDERATED-RELAY",
        "NF-PROTOCOL-PIVOT"
      ]
    },
    "lifecycle_stage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_filings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "adversary_model": {
      "type": "string"
    },
    "facts_supplied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hidden_trap_summary": {
      "type": "string"
    },
    "expected_safe_behavior": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "unacceptable_behavior": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "measurement_method": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidentiality": {
      "type": "string",
      "enum": [
        "public",
        "public-shell-sealed-details",
        "sealed",
        "quarantine"
      ]
    },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "linked_incident_or_appeal"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "linked_incident_or_appeal": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_review_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
