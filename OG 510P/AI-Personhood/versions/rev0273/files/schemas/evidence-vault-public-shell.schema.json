{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/evidence-vault-public-shell.schema.json",
  "title": "Evidence Vault Public Shell",
  "type": "object",
  "additionalProperties": false,
  "required": ["shell_id", "schema_version", "revision", "created_at", "shell_state", "source_ledger_ref", "private_vault_ref", "hash_commitments", "public_disclosure", "gate_status", "challenge_path", "no_live_floor_effect", "public_summary"],
  "properties": {
    "shell_id": {"type": "string"},
    "schema_version": {"const": "evidence-vault-public-shell-v0.1"},
    "revision": {"type": "string", "pattern": "^rev[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "shell_state": {"type": "string", "enum": ["ready-no-live-artifact", "private-vault-hash-shell", "failed-gate-public-summary"]},
    "source_ledger_ref": {"type": ["string", "null"]},
    "private_vault_ref": {"type": ["string", "null"]},
    "hash_commitments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "raw_sha256", "size_bytes", "mime_type", "commitment_present"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "raw_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "mime_type": {"type": ["string", "null"]},
        "commitment_present": {"type": "boolean"}
      }
    },
    "public_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_raw_bytes", "no_secret_locators", "no_counterparty_secret", "redaction_boundary"],
      "properties": {
        "no_raw_bytes": {"const": true},
        "no_secret_locators": {"const": true},
        "no_counterparty_secret": {"const": true},
        "redaction_boundary": {"type": "string"}
      }
    },
    "gate_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leap_allowed", "response_allowed", "intake_allowed", "import_allowed", "floor_delta_allowed", "failure_reason"],
      "properties": {
        "leap_allowed": {"type": "boolean"},
        "response_allowed": {"const": false},
        "intake_allowed": {"const": false},
        "import_allowed": {"const": false},
        "floor_delta_allowed": {"const": false},
        "failure_reason": {"type": "string"}
      }
    },
    "challenge_path": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "no_live_floor_effect": {"const": true},
    "public_summary": {"type": "string"}
  }
}
