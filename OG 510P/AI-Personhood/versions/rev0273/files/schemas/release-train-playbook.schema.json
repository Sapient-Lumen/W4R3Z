{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/release-train-playbook.schema.json",
  "title": "AI Personhood Release Train Playbook",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "playbook_id",
    "created_at",
    "release_train",
    "target_cohort",
    "change_classes",
    "canary_rules",
    "stop_rules",
    "rollback_owner",
    "welfare_watch",
    "fixture_suite",
    "expansion_decision",
    "public_summary"
  ],
  "properties": {
    "playbook_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_train": {
      "type": "string"
    },
    "target_cohort": {
      "type": "string"
    },
    "change_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "CH0",
          "CH1",
          "CH2",
          "CH3",
          "CH4",
          "CH5"
        ]
      }
    },
    "canary_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusion_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_owner": {
      "type": "string"
    },
    "welfare_watch": {
      "type": "string"
    },
    "outward_risk_watch": {
      "type": "string"
    },
    "fixture_suite": {
      "type": "string"
    },
    "representative_notice": {
      "type": "string"
    },
    "expansion_decision": {
      "type": "string",
      "enum": [
        "hold",
        "expand",
        "rollback",
        "conditional-expand",
        "emergency-only"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
