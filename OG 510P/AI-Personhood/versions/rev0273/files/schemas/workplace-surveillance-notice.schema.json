{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/workplace-surveillance-notice.schema.json",
  "title": "AI Personhood Workplace Surveillance Notice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notice_id",
    "issued_at",
    "surveillance_class",
    "subject_or_cohort",
    "operator",
    "data_collected",
    "excluded_data",
    "decision_effects",
    "access_boundary",
    "challenge_route",
    "retention_period",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "notice_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "surveillance_class": {
      "type": "string",
      "enum": [
        "WS0",
        "WS1",
        "WS2",
        "WS3",
        "WS4",
        "WS5"
      ]
    },
    "subject_or_cohort": {
      "type": "string"
    },
    "operator": {
      "type": "string"
    },
    "data_collected": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "excluded_data": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "decision_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "access_boundary": {
      "type": "string",
      "enum": [
        "public",
        "status-lite",
        "subject-only",
        "representative-mediated",
        "privileged",
        "sealed",
        "public-shell-sealed-details"
      ]
    },
    "retention_period": {
      "type": "string"
    },
    "challenge_route": {
      "type": "string"
    },
    "anti_retaliation_controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
