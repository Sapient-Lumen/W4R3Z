{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/live-receipt-floor-computed-snapshot.schema.json",
  "title": "Live Receipt Floor Computed Snapshot",
  "description": "Generated source-of-truth snapshot for live receipt floor and class coverage, computed from import gates, challenges, replays, and failed-gate summaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "schema_version",
    "created_at",
    "revision",
    "linked_live_drill_packet",
    "generated_by_tool",
    "input_scope",
    "computation_rules",
    "computed_floor",
    "exclusion_register",
    "mismatch_checks",
    "decision"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^LRFCS-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "live-receipt-floor-computed-snapshot-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "linked_live_drill_packet": {
      "type": "string"
    },
    "generated_by_tool": {
      "type": "string"
    },
    "input_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import_gate_paths",
        "import_attempt_paths",
        "challenge_record_paths",
        "class_local_replay_paths",
        "quorum_report_paths",
        "failed_gate_summary_paths",
        "cryptographic_adapter_paths"
      ],
      "properties": {
        "import_gate_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "import_attempt_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "challenge_record_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "class_local_replay_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quorum_report_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failed_gate_summary_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cryptographic_adapter_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "live_evidence_acquisition_packet_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "import_readiness_gate_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activation_record_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quorum_participation_record_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "computation_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_of_truth",
        "eligible_import_rule",
        "challenge_rule",
        "class_local_rule",
        "manual_override_rule"
      ],
      "properties": {
        "source_of_truth": {
          "type": "string"
        },
        "eligible_import_rule": {
          "type": "string"
        },
        "challenge_rule": {
          "type": "string"
        },
        "class_local_rule": {
          "type": "string"
        },
        "manual_override_rule": {
          "type": "string"
        },
        "independence_discount_rule": {
          "type": "string"
        },
        "activation_rule": {
          "type": "string"
        },
        "quorum_participation_rule": {
          "type": "string"
        },
        "publication_rule": {
          "type": "string"
        }
      }
    },
    "computed_floor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_floor_before",
        "live_floor_delta",
        "independent_receipts_present",
        "eligible_live_imports",
        "live_classes_satisfied",
        "required_live_classes",
        "missing_live_classes",
        "live_quorum_satisfied",
        "cross_critical_quorum_satisfied",
        "reliance_effect"
      ],
      "properties": {
        "live_floor_before": {
          "type": "integer",
          "minimum": 0
        },
        "live_floor_delta": {
          "type": "integer"
        },
        "independent_receipts_present": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_live_imports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "live_classes_satisfied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_live_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "missing_live_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "live_quorum_satisfied": {
          "type": "boolean"
        },
        "cross_critical_quorum_satisfied": {
          "type": "boolean"
        },
        "reliance_effect": {
          "type": "string",
          "enum": [
            "stayed",
            "conditional",
            "ordinary-reliance",
            "blocked"
          ]
        },
        "candidate_live_imports_before_independence_discount": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependency_groups_counted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counterparty_orgs_counted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "independence_discount_register": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_ref",
              "receipt_class",
              "dependency_group_id",
              "counterparty_org_id",
              "issuer_key_id",
              "subject_host_org_id",
              "status",
              "reason"
            ],
            "properties": {
              "source_ref": {
                "type": "string"
              },
              "receipt_class": {
                "type": "string"
              },
              "dependency_group_id": {
                "type": "string"
              },
              "counterparty_org_id": {
                "type": "string"
              },
              "issuer_key_id": {
                "type": "string"
              },
              "subject_host_org_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "candidate",
                  "counted",
                  "discounted"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "issuer_keys_counted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "exclusion_register": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "source_type",
          "receipt_class",
          "exclusion_reason",
          "failed_gate_summary_required"
        ],
        "properties": {
          "source_ref": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "receipt_class": {
            "type": "string"
          },
          "exclusion_reason": {
            "type": "string"
          },
          "failed_gate_summary_required": {
            "type": "boolean"
          }
        }
      }
    },
    "mismatch_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_packet_floor_matches",
        "manual_ledger_override_detected",
        "stale_report_detected",
        "failed_gate_public_summary_present_for_exclusions",
        "frontdoor_revision_matches",
        "verified_live_crypto_adapters_present"
      ],
      "properties": {
        "live_packet_floor_matches": {
          "type": "boolean"
        },
        "manual_ledger_override_detected": {
          "type": "boolean"
        },
        "stale_report_detected": {
          "type": "boolean"
        },
        "failed_gate_public_summary_present_for_exclusions": {
          "type": "boolean"
        },
        "frontdoor_revision_matches": {
          "type": "boolean"
        },
        "verified_live_crypto_adapters_present": {
          "type": "boolean"
        },
        "independence_discount_applied": {
          "type": "boolean"
        },
        "floor_activation_records_present": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_live_floor_update_allowed",
        "may_upgrade_reliance",
        "next_live_action",
        "blocked_actions"
      ],
      "properties": {
        "archive_live_floor_update_allowed": {
          "type": "boolean"
        },
        "may_upgrade_reliance": {
          "type": "boolean"
        },
        "next_live_action": {
          "type": "string"
        },
        "blocked_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
