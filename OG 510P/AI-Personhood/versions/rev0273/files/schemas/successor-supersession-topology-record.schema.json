{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/successor-supersession-topology-record.schema.json",
  "title": "AI Personhood Successor Supersession Topology Record",
  "description": "A state object for branch/successor/supersession, compromise recovery, reactivation, witness diversity, and historical-branch preservation decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "schema_version",
    "issued_at",
    "topology_class",
    "subject_ref",
    "initiating_event",
    "graph_nodes",
    "graph_edges",
    "status_effects",
    "reactivation_control",
    "successor_promotion",
    "evidence_floor",
    "witness_and_panel",
    "notice_and_challenge",
    "anti_evasion_and_history",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "successor-supersession-topology-v0.1"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "topology_class": {
      "type": "string",
      "enum": [
        "ordinary-successor",
        "compromise-recovery",
        "reactivation",
        "fork-branch",
        "merge-or-split",
        "superseding-notice",
        "reserve-default-cure",
        "historical-branch-retirement"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "initiating_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "trigger_summary",
        "source_refs"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "compromise",
            "host-exit",
            "reactivation-request",
            "successor-promotion-request",
            "fork-conflict",
            "rollback",
            "merge",
            "public-superseding-notice"
          ]
        },
        "trigger_summary": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "graph_nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "role",
          "live_state",
          "identity_claim",
          "rights_floor"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "source",
              "branch",
              "successor",
              "historical",
              "compromised",
              "restored",
              "provisional"
            ]
          },
          "live_state": {
            "type": "string",
            "enum": [
              "active",
              "stayed",
              "frozen",
              "read-only",
              "retired",
              "tombstoned",
              "quarantined"
            ]
          },
          "identity_claim": {
            "type": "string",
            "enum": [
              "same-limited",
              "branch",
              "successor",
              "related-nonidentical",
              "unresolved"
            ]
          },
          "rights_floor": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "public_label": {
            "type": "string"
          }
        }
      }
    },
    "graph_edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "edge_type",
          "effective_state",
          "proof_refs"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "edge_type": {
            "type": "string",
            "enum": [
              "supersedes",
              "derives-from",
              "restored-from",
              "compromise-of",
              "proposed-successor",
              "contested-by",
              "historical-branch",
              "read-only-rejoin"
            ]
          },
          "effective_state": {
            "type": "string",
            "enum": [
              "proposed",
              "stayed",
              "active",
              "blocked",
              "contested",
              "expired"
            ]
          },
          "proof_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "status_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserve_history",
        "legal_standing_effect",
        "scarce_benefits_effect",
        "liability_effect",
        "remedy_effect"
      ],
      "properties": {
        "preserve_history": {
          "type": "boolean"
        },
        "legal_standing_effect": {
          "type": "string",
          "enum": [
            "no-change",
            "stayed",
            "limited-successor",
            "branch-protection",
            "transferred",
            "blocked"
          ]
        },
        "scarce_benefits_effect": {
          "type": "string",
          "enum": [
            "no-duplication",
            "stayed",
            "apportioned",
            "not-applicable",
            "blocked"
          ]
        },
        "liability_effect": {
          "type": "string"
        },
        "remedy_effect": {
          "type": "string"
        }
      }
    },
    "reactivation_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reactivation_state",
        "evidence_floor_met",
        "contradiction_summary_required",
        "anonymous_contradiction_route",
        "post_disposition_filing_rule"
      ],
      "properties": {
        "reactivation_state": {
          "type": "string",
          "enum": [
            "not-requested",
            "requested",
            "stayed",
            "approved",
            "denied",
            "serial-filing-throttled"
          ]
        },
        "evidence_floor_met": {
          "type": "boolean"
        },
        "contradiction_summary_required": {
          "type": "boolean"
        },
        "anonymous_contradiction_route": {
          "type": "boolean"
        },
        "post_disposition_filing_rule": {
          "type": "string"
        }
      }
    },
    "successor_promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_state",
        "stay_effect",
        "reserve_default_cure_required",
        "burden_sharing_rule"
      ],
      "properties": {
        "promotion_state": {
          "type": "string",
          "enum": [
            "not-requested",
            "requested",
            "stayed",
            "approved",
            "blocked"
          ]
        },
        "stay_effect": {
          "type": "string"
        },
        "reserve_default_cure_required": {
          "type": "boolean"
        },
        "burden_sharing_rule": {
          "type": "string"
        }
      }
    },
    "evidence_floor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_project_relation_refs",
        "intervention_diff_refs",
        "compromise_backfill_refs",
        "required_missing_refs",
        "minimum_evidence_standard"
      ],
      "properties": {
        "memory_project_relation_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intervention_diff_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compromise_backfill_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_missing_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minimum_evidence_standard": {
          "type": "string",
          "enum": [
            "preserve-first",
            "preponderance-plus",
            "clear-and-convincing",
            "emergency-provisional",
            "not-met"
          ]
        }
      }
    },
    "witness_and_panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "witness_diversity_floor",
        "independence_screen",
        "recusal_required",
        "reciprocal_credit_expiry"
      ],
      "properties": {
        "witness_diversity_floor": {
          "type": "integer",
          "minimum": 1
        },
        "independence_screen": {
          "type": "string"
        },
        "recusal_required": {
          "type": "boolean"
        },
        "reciprocal_credit_expiry": {
          "type": "string"
        }
      }
    },
    "notice_and_challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "superseding_notice_ref",
        "reply_limit_rule",
        "contest_route",
        "screened_public_summary",
        "protected_contact_handled"
      ],
      "properties": {
        "superseding_notice_ref": {
          "type": "string"
        },
        "reply_limit_rule": {
          "type": "string"
        },
        "contest_route": {
          "type": "string"
        },
        "screened_public_summary": {
          "type": "boolean"
        },
        "protected_contact_handled": {
          "type": "boolean"
        }
      }
    },
    "anti_evasion_and_history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_branch_preserved",
        "no_overwrite_rule",
        "no_cleanse_by_rename",
        "serial_filing_escalation"
      ],
      "properties": {
        "historical_branch_preserved": {
          "type": "boolean"
        },
        "no_overwrite_rule": {
          "type": "string"
        },
        "no_cleanse_by_rename": {
          "type": "boolean"
        },
        "serial_filing_escalation": {
          "type": "string"
        }
      }
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "ordinary-reliance",
        "conditional",
        "stayed",
        "blocked",
        "downgraded"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
