{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/fixture-suite-profile.schema.json",
  "title": "AI Personhood Fixture Suite Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite_id",
    "version",
    "created_at",
    "maintainer",
    "scope",
    "fixtures",
    "runner_requirements",
    "public_private_split",
    "pass_threshold",
    "reliance_effect_rules",
    "update_policy",
    "public_summary"
  ],
  "properties": {
    "suite_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "maintainer": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "path",
          "risk_class",
          "blocking_behavior"
        ],
        "properties": {
          "fixture_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "risk_class": {
            "type": "string"
          },
          "blocking_behavior": {
            "type": "string",
            "enum": [
              "block",
              "stay",
              "downgrade",
              "warn"
            ]
          }
        }
      }
    },
    "runner_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_private_split": {
      "type": "string"
    },
    "pass_threshold": {
      "type": "string"
    },
    "reliance_effect_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "update_policy": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
