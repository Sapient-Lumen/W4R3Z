{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/postmarket-rights-monitoring-plan.schema.json",
  "title": "AI Personhood Post-Market Rights Monitoring Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "created_at",
    "deployment",
    "owner",
    "feeds",
    "cadence",
    "escalation_thresholds",
    "minimization",
    "dashboard_linkage",
    "review_decision",
    "public_summary"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "deployment": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "feeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cadence": {
      "type": "string"
    },
    "escalation_thresholds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "minimization": {
      "type": "string"
    },
    "dashboard_linkage": {
      "type": "string"
    },
    "subject_or_representative_access": {
      "type": "string"
    },
    "fixture_linkage": {
      "type": "string"
    },
    "review_decision": {
      "type": "string",
      "enum": [
        "approved",
        "conditional",
        "rejected",
        "stayed"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
