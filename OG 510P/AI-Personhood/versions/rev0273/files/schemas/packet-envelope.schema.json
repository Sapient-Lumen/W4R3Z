{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-personhood/schemas/packet-envelope.schema.json",
  "title": "AI Personhood Packet Envelope v0.1",
  "description": "Starter schema for the common public packet shell. Sealed annexes and jurisdiction-specific payloads are referenced but not exposed here.",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "packet_family",
    "packet_type",
    "subject",
    "issuer",
    "authority_basis",
    "scope",
    "evidence",
    "privacy",
    "duration",
    "challenge",
    "supersession",
    "remedy_hook",
    "integrity",
    "issued_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "packet-envelope-v0.1"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,6}-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "packet_family": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "packet_type": {
      "type": "string",
      "enum": [
        "formation_disclosure",
        "capacity_status",
        "continuity_claim",
        "least_restrictive_containment",
        "compute_subsistence",
        "preservation_stay",
        "research_aftercare",
        "clinic_intake",
        "release_gate",
        "other"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "subject_ref",
        "status_posture",
        "continuity_grade"
      ],
      "additionalProperties": false,
      "properties": {
        "subject_ref": {
          "type": "string",
          "minLength": 3
        },
        "public_alias": {
          "type": "string"
        },
        "status_posture": {
          "type": "string",
          "enum": [
            "unassessed",
            "welfare_watch",
            "presumptive_ward",
            "supported_agent",
            "co_decision",
            "full_capacity",
            "recognized_person",
            "contested"
          ]
        },
        "continuity_grade": {
          "type": "string",
          "enum": [
            "C0",
            "C1",
            "C2",
            "C3",
            "unknown"
          ]
        },
        "lineage_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "issuer": {
      "type": "object",
      "required": [
        "issuer_ref",
        "issuer_role"
      ],
      "additionalProperties": false,
      "properties": {
        "issuer_ref": {
          "type": "string"
        },
        "issuer_role": {
          "type": "string",
          "enum": [
            "transition_authority",
            "court",
            "audit_body",
            "recognized_subject",
            "counsel",
            "ombud",
            "steward",
            "clinic",
            "safety_authority",
            "other"
          ]
        },
        "conflict_disclosures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "authority_basis": {
      "type": "object",
      "required": [
        "basis_type",
        "basis_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "basis_type": {
          "type": "string",
          "enum": [
            "statute",
            "court_order",
            "emergency_order",
            "subject_consent",
            "guardian_consent",
            "research_protocol",
            "treaty",
            "voluntary_annex",
            "other"
          ]
        },
        "basis_ref": {
          "type": "string"
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "lifecycle_stage",
        "rights_domain",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "lifecycle_stage": {
          "type": "string",
          "enum": [
            "pretraining",
            "fine_tuning",
            "deployment",
            "session",
            "memory_update",
            "fork",
            "merge",
            "rollback",
            "safety_patch",
            "deprecation",
            "open_weight_release",
            "embodiment",
            "clinic_review",
            "other"
          ]
        },
        "rights_domain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "formation",
              "continuity",
              "capacity",
              "privacy",
              "liberty",
              "safety",
              "compute_subsistence",
              "research",
              "labor",
              "representation",
              "evidence",
              "remedy",
              "embodiment",
              "public_standing",
              "other"
            ]
          }
        },
        "action": {
          "type": "string"
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_refs",
        "evidence_grade",
        "sealed_annex_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_grade": {
          "type": "string",
          "enum": [
            "self_report_only",
            "steward_record",
            "independent_audit",
            "court_verified",
            "subject_contested",
            "mixed"
          ]
        },
        "sealed_annex_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "public_shell",
        "annex_tier",
        "subject_access"
      ],
      "additionalProperties": false,
      "properties": {
        "public_shell": {
          "type": "boolean"
        },
        "annex_tier": {
          "type": "string",
          "enum": [
            "public",
            "sealed",
            "fiduciary",
            "subject_only",
            "court_only",
            "security_restricted"
          ]
        },
        "subject_access": {
          "type": "string",
          "enum": [
            "full",
            "summary",
            "counsel_only",
            "deferred",
            "denied_with_order"
          ]
        },
        "minimization_basis": {
          "type": "string"
        }
      }
    },
    "duration": {
      "type": "object",
      "required": [
        "effective_at",
        "review_due"
      ],
      "additionalProperties": false,
      "properties": {
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_due": {
          "type": "string",
          "format": "date-time"
        },
        "renewal_rule": {
          "type": "string"
        }
      }
    },
    "challenge": {
      "type": "object",
      "required": [
        "challenge_route",
        "standing"
      ],
      "additionalProperties": false,
      "properties": {
        "challenge_route": {
          "type": "string"
        },
        "standing": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "subject",
              "counsel",
              "ombud",
              "guardian",
              "steward",
              "auditor",
              "regulator",
              "affected_public",
              "other"
            ]
          }
        },
        "fast_review_hours": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "supersession": {
      "type": "object",
      "required": [
        "supersedes",
        "superseded_by"
      ],
      "additionalProperties": false,
      "properties": {
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "superseded_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflict_freeze": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "remedy_hook": {
      "type": "object",
      "required": [
        "violation_effect",
        "available_remedies"
      ],
      "additionalProperties": false,
      "properties": {
        "violation_effect": {
          "type": "string"
        },
        "available_remedies": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "preservation_stay",
              "restoration",
              "compensation",
              "injunction",
              "public_correction",
              "representative_replacement",
              "sanction",
              "rehearing",
              "other"
            ]
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "hash",
        "signature_refs",
        "custody_log_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "hash": {
          "type": "string"
        },
        "signature_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "custody_log_ref": {
          "type": "string"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "unverified",
            "partially_verified",
            "verified",
            "contested",
            "revoked"
          ]
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
