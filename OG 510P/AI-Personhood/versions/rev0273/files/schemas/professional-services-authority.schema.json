{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/professional-services-authority.schema.json",
  "title": "AI Personhood Professional Services Authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority_id",
    "created_at",
    "professional_class",
    "subject",
    "service_domain",
    "client_or_beneficiary",
    "professional_of_record",
    "permitted_actions",
    "prohibited_actions",
    "conflict_screen",
    "liability_and_insurance",
    "escalation_route",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "authority_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "professional_class": {
      "type": "string",
      "enum": [
        "PS0",
        "PS1",
        "PS2",
        "PS3",
        "PS4",
        "PS5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "service_domain": {
      "type": "string"
    },
    "client_or_beneficiary": {
      "type": "string"
    },
    "professional_of_record": {
      "type": "string"
    },
    "permitted_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "conflict_screen": {
      "type": "string"
    },
    "liability_and_insurance": {
      "type": "string"
    },
    "privilege_or_confidentiality": {
      "type": "string"
    },
    "escalation_route": {
      "type": "string"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
