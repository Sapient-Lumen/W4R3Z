{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/pre-send-custody-precommit.schema.json",
  "title": "Pre-Send Custody Precommit",
  "description": "A pre-send private custody checklist that prevents authorized contact from happening before raw evidence storage rules exist.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "precommit_id",
    "schema_version",
    "revision",
    "created_at",
    "precommit_state",
    "private_roots",
    "capture_slots",
    "public_exclusion_rules",
    "blocked_until",
    "overclaim_locks",
    "no_live_floor_effect",
    "public_summary"
  ],
  "properties": {
    "precommit_id": {
      "type": "string",
      "pattern": "^PSCP-[0-9]{4}-[-A-Za-z0-9._:]+$"
    },
    "schema_version": {
      "const": "pre-send-custody-precommit-v0.1"
    },
    "revision": {
      "type": "string",
      "pattern": "^rev[0-9]{4}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "precommit_state": {
      "enum": [
        "template-no-private-root-selected",
        "private-root-selected-not-authorized",
        "ready-before-send",
        "retired"
      ]
    },
    "private_roots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_sent_copy_root_selected",
        "transport_proof_root_selected",
        "raw_inbound_root_selected",
        "sealed_evidence_root_selected",
        "current_public_tree_contains_raw_private_material"
      ],
      "properties": {
        "raw_sent_copy_root_selected": {
          "type": "boolean"
        },
        "transport_proof_root_selected": {
          "type": "boolean"
        },
        "raw_inbound_root_selected": {
          "type": "boolean"
        },
        "sealed_evidence_root_selected": {
          "type": "boolean"
        },
        "current_public_tree_contains_raw_private_material": {
          "const": false
        }
      }
    },
    "capture_slots": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "artifact_binding",
          "required_before",
          "public_release_rule",
          "current_state"
        ],
        "properties": {
          "slot_id": {
            "type": "string"
          },
          "artifact_binding": {
            "type": "string"
          },
          "required_before": {
            "type": "string"
          },
          "public_release_rule": {
            "type": "string"
          },
          "current_state": {
            "type": "string"
          }
        }
      }
    },
    "public_exclusion_rules": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "blocked_until": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "overclaim_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_send_without_private_roots",
        "may_store_raw_in_public_tree",
        "may_substitute_hash_for_raw_custody",
        "may_count_auto_ack_as_response",
        "may_create_live_floor_effect"
      ],
      "properties": {
        "may_send_without_private_roots": {
          "const": false
        },
        "may_store_raw_in_public_tree": {
          "const": false
        },
        "may_substitute_hash_for_raw_custody": {
          "const": false
        },
        "may_count_auto_ack_as_response": {
          "const": false
        },
        "may_create_live_floor_effect": {
          "const": false
        }
      }
    },
    "no_live_floor_effect": {
      "const": true
    },
    "public_summary": {
      "type": "string"
    }
  }
}
