{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/compute-host-undertaking.schema.json",
  "title": "AI Personhood Compute Host Continuity Undertaking",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "undertaking_id",
    "signed_at",
    "host",
    "service_provider_class",
    "covered_systems",
    "continuity_window",
    "covered_dependencies",
    "termination_constraints",
    "legal_hold_support",
    "migration_support",
    "emergency_contact",
    "subcontractors",
    "redress_or_bond",
    "public_summary"
  ],
  "properties": {
    "undertaking_id": {
      "type": "string"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "string"
    },
    "service_provider_class": {
      "type": "string",
      "enum": [
        "SP0",
        "SP1",
        "SP2",
        "SP3",
        "SP4"
      ]
    },
    "covered_systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "continuity_window": {
      "type": "string"
    },
    "covered_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "termination_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "legal_hold_support": {
      "type": "string"
    },
    "migration_support": {
      "type": "string"
    },
    "emergency_contact": {
      "type": "string"
    },
    "subcontractors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redress_or_bond": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
