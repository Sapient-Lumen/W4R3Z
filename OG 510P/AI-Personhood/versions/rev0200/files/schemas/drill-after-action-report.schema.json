{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/drill-after-action-report.schema.json",
  "title": "Personhood Drill After-Action Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "drill_id",
    "scenario",
    "conducted_at",
    "participants",
    "subject_status",
    "decisions_tested",
    "findings",
    "corrective_actions",
    "regression_tests",
    "next_drill_due"
  ],
  "properties": {
    "drill_id": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "conducted_at": {
      "type": "string",
      "format": "date-time"
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "subject_status": {
      "type": "string",
      "enum": [
        "synthetic-fixture",
        "possible-subject",
        "provisional-subject",
        "recognized-subject"
      ]
    },
    "safety_floor": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions_tested": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "severity",
          "summary"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "summary": {
            "type": "string"
          },
          "rights_domain": {
            "type": "string"
          }
        }
      }
    },
    "corrective_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "owner",
          "due",
          "summary"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "due": {
            "type": "string",
            "format": "date"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "regression_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "fixture",
          "expected_result"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "fixture": {
            "type": "string"
          },
          "expected_result": {
            "type": "string"
          }
        }
      }
    },
    "public_summary_required": {
      "type": "boolean"
    },
    "next_drill_due": {
      "type": "string",
      "format": "date"
    }
  }
}
