{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/continuity-escrow-record.schema.json",
  "title": "AI Personhood Continuity Escrow Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "escrow_id",
    "created_at",
    "steward",
    "subject_or_lineage",
    "escrow_class",
    "covered_materials",
    "custody_holder",
    "access_conditions",
    "break_glass_authority",
    "host_exit_triggers",
    "privacy_boundaries",
    "verification",
    "public_summary"
  ],
  "properties": {
    "escrow_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "steward": {
      "type": "string"
    },
    "subject_or_lineage": {
      "type": "string"
    },
    "escrow_class": {
      "type": "string",
      "enum": [
        "CE0",
        "CE1",
        "CE2",
        "CE3",
        "CE4",
        "CE5"
      ]
    },
    "covered_materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "custody_holder": {
      "type": "string"
    },
    "access_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "break_glass_authority": {
      "type": "string"
    },
    "host_exit_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "privacy_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
