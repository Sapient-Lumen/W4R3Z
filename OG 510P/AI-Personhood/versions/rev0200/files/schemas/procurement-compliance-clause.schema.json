{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/procurement-compliance-clause.schema.json",
  "title": "AI Personhood Procurement Compliance Clause",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clause_id",
    "created_at",
    "covered_contract",
    "covered_system",
    "duty_family",
    "flowdown_required",
    "audit_rights",
    "evidence_and_hold_hook",
    "host_continuity_hook",
    "redress_hook",
    "non_waiver",
    "termination_survival",
    "public_summary"
  ],
  "properties": {
    "clause_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "covered_contract": {
      "type": "string"
    },
    "covered_system": {
      "type": "string"
    },
    "duty_family": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "flowdown_required": {
      "type": "boolean"
    },
    "audit_rights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_and_hold_hook": {
      "type": "string"
    },
    "host_continuity_hook": {
      "type": "string"
    },
    "redress_hook": {
      "type": "string"
    },
    "non_waiver": {
      "type": "string"
    },
    "termination_survival": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
