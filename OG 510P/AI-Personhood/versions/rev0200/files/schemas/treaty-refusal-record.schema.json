{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/treaty-refusal-record.schema.json",
  "title": "AI Personhood Treaty Refusal and Non-Recognition Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "refusal_id",
    "issued_at",
    "refusing_authority",
    "requested_action",
    "subject_or_cohort",
    "refusal_class",
    "reasons",
    "evidence_basis",
    "protection_gap_analysis",
    "interim_protection",
    "non_return_screen",
    "appeal_or_reopening",
    "public_summary"
  ],
  "properties": {
    "refusal_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "refusing_authority": {
      "type": "string"
    },
    "requested_action": {
      "type": "string",
      "enum": [
        "safe-transfer",
        "recognition",
        "mutual-recognition",
        "trust-anchor",
        "accreditation",
        "evidence-assistance"
      ]
    },
    "subject_or_cohort": {
      "type": "string"
    },
    "refusal_class": {
      "type": "string",
      "enum": [
        "TR0",
        "TR1",
        "TR2",
        "TR3",
        "TR4",
        "TR5",
        "TR6",
        "TR7"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "protection_gap_analysis": {
      "type": "string"
    },
    "interim_protection": {
      "type": "string"
    },
    "non_return_screen": {
      "type": "string"
    },
    "appeal_or_reopening": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
