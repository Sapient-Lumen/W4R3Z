{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/evidence-data-room-index.schema.json",
  "title": "AI Personhood Evidence Data Room Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index_id",
    "created_at",
    "matter",
    "data_room_class",
    "custodian",
    "collections",
    "access_roles",
    "sealed_annexes",
    "disclosure_budget",
    "exclusions",
    "challenge_route",
    "public_summary"
  ],
  "properties": {
    "index_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "matter": {
      "type": "string"
    },
    "data_room_class": {
      "type": "string",
      "enum": [
        "DR0",
        "DR1",
        "DR2",
        "DR3",
        "DR4"
      ]
    },
    "custodian": {
      "type": "string"
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "access_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sealed_annexes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disclosure_budget": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "challenge_route": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
