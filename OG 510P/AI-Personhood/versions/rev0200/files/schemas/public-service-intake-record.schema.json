{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/public-service-intake-record.schema.json",
  "title": "AI Personhood Public Service Intake Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "service_class",
    "subject",
    "intake_channel",
    "eligibility_basis",
    "accessibility_support",
    "privacy_minimization",
    "interim_support",
    "appeal_route",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "service_class": {
      "type": "string",
      "enum": [
        "PS0",
        "PS1",
        "PS2",
        "PS3",
        "PS4",
        "PS5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "intake_channel": {
      "type": "string"
    },
    "eligibility_basis": {
      "type": "string"
    },
    "accessibility_support": {
      "type": "string"
    },
    "privacy_minimization": {
      "type": "string"
    },
    "denial_or_delay_reason": {
      "type": "string"
    },
    "interim_support": {
      "type": "string"
    },
    "appeal_route": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
