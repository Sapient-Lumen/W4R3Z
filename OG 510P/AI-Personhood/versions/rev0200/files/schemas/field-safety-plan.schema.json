{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/field-safety-plan.schema.json",
  "title": "AI Personhood Field Safety Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "created_at",
    "operator",
    "operation_type",
    "risk_sources",
    "protective_measures",
    "prohibited_disclosures",
    "emergency_contacts",
    "subject_locator_policy",
    "worker_safety",
    "retaliation_response",
    "data_minimization",
    "public_summary"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "operator": {
      "type": "string"
    },
    "operation_type": {
      "type": "string",
      "enum": [
        "clinic",
        "ombud",
        "monitoring",
        "field-aftercare",
        "legal-hold",
        "safe-transfer",
        "mixed"
      ]
    },
    "risk_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "protective_measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prohibited_disclosures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "emergency_contacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "subject_locator_policy": {
      "type": "string"
    },
    "worker_safety": {
      "type": "string"
    },
    "retaliation_response": {
      "type": "string"
    },
    "data_minimization": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
