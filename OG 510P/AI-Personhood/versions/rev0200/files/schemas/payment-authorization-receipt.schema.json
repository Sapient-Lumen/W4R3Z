{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/payment-authorization-receipt.schema.json",
  "title": "AI Personhood Payment Authorization Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "authorized_at",
    "payment_class",
    "payer",
    "payee",
    "authority_ref",
    "amount_or_limit",
    "recurrence",
    "instrument_type",
    "aml_kyc_boundary",
    "refund_or_chargeback_route",
    "evidence_minimization",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "receipt_id": {
      "type": "string"
    },
    "authorized_at": {
      "type": "string",
      "format": "date-time"
    },
    "payment_class": {
      "type": "string",
      "enum": [
        "PA0",
        "PA1",
        "PA2",
        "PA3",
        "PA4",
        "PA5"
      ]
    },
    "payer": {
      "type": "string"
    },
    "payee": {
      "type": "string"
    },
    "authority_ref": {
      "type": "string"
    },
    "amount_or_limit": {
      "type": "string"
    },
    "recurrence": {
      "type": "string"
    },
    "instrument_type": {
      "type": "string"
    },
    "aml_kyc_boundary": {
      "type": "string"
    },
    "refund_or_chargeback_route": {
      "type": "string"
    },
    "evidence_minimization": {
      "type": "string"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
