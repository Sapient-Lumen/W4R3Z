{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-personhood/schemas/verifier-report.schema.json",
  "title": "AI Personhood Verifier Report",
  "type": "object",
  "required": [
    "report_id",
    "schema_version",
    "target",
    "verifier",
    "result",
    "conformance_level",
    "checks",
    "issued_at",
    "challenge_route"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 3
    },
    "schema_version": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "required": [
        "artifact_id",
        "artifact_family",
        "artifact_version"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "artifact_family": {
          "type": "string"
        },
        "artifact_version": {
          "type": "string"
        },
        "public_shell_ref": {
          "type": "string"
        },
        "sealed_annex_ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "verifier": {
      "type": "object",
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "credential_ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "pass_with_conditions",
        "warn",
        "fail",
        "blocked"
      ]
    },
    "conformance_level": {
      "type": "string",
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3",
        "C4"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "status",
          "severity",
          "message"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "not_applicable",
              "blocked"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "message": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "subject_access_path": {
      "type": "string"
    },
    "representative_access_path": {
      "type": "string"
    },
    "challenge_route": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "issued_at": {
      "type": "string"
    },
    "integrity": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
