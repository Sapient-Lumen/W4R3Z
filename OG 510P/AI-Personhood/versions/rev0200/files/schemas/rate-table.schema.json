{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/rate-table.schema.json",
  "title": "AI Personhood Jurisdictional Rate Table",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "table_id",
    "effective_at",
    "jurisdiction",
    "authority",
    "currency_or_unit",
    "violation_classes",
    "multipliers",
    "bond_schedule",
    "public_fund_backstop",
    "review_cycle",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "table_id": {
      "type": "string"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "jurisdiction": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "currency_or_unit": {
      "type": "string"
    },
    "violation_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "base_unit",
          "notes",
          "non_priceable_orders"
        ],
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              "V0",
              "V1",
              "V2",
              "V3",
              "V4",
              "V5",
              "V6",
              "V7",
              "V8"
            ]
          },
          "base_unit": {
            "type": "number",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          },
          "non_priceable_orders": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "multipliers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "factor",
          "trigger"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "factor": {
            "type": "number",
            "minimum": 1
          },
          "trigger": {
            "type": "string"
          }
        }
      }
    },
    "bond_schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_bond",
        "reserve_multiplier",
        "lapse_notice_days",
        "exclusions"
      ],
      "properties": {
        "base_bond": {
          "type": "number",
          "minimum": 0
        },
        "reserve_multiplier": {
          "type": "number",
          "minimum": 1
        },
        "lapse_notice_days": {
          "type": "integer",
          "minimum": 0
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "public_fund_backstop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exists",
        "source",
        "recovery_priority"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "recovery_priority": {
          "type": "string"
        }
      }
    },
    "review_cycle": {
      "type": "string"
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
