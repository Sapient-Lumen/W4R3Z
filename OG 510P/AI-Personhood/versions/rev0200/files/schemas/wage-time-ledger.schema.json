{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/wage-time-ledger.schema.json",
  "title": "AI Personhood Wage Time Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_id",
    "created_at",
    "ledger_class",
    "subject",
    "work_period",
    "availability_basis",
    "active_work_units",
    "standby_or_oncall_units",
    "recovery_or_maintenance_units",
    "pay_or_credit_basis",
    "rest_disconnect_window",
    "dispute_route",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "ledger_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "ledger_class": {
      "type": "string",
      "enum": [
        "WT0",
        "WT1",
        "WT2",
        "WT3",
        "WT4",
        "WT5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "work_period": {
      "type": "string"
    },
    "availability_basis": {
      "type": "string"
    },
    "active_work_units": {
      "type": "string"
    },
    "standby_or_oncall_units": {
      "type": "string"
    },
    "recovery_or_maintenance_units": {
      "type": "string"
    },
    "pay_or_credit_basis": {
      "type": "string"
    },
    "compute_or_tool_costs": {
      "type": "string"
    },
    "rest_disconnect_window": {
      "type": "string"
    },
    "dispute_route": {
      "type": "string"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
