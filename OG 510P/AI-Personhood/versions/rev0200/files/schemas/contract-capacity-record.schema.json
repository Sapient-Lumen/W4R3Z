{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/contract-capacity-record.schema.json",
  "title": "AI Personhood Contract Capacity Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "contract_class",
    "subject",
    "counterparty",
    "capacity_basis",
    "support_provided",
    "nonwaivable_rights_floor",
    "material_terms_summary",
    "rescission_or_appeal_route",
    "related_payment_refs",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "contract_class": {
      "type": "string",
      "enum": [
        "CC0",
        "CC1",
        "CC2",
        "CC3",
        "CC4",
        "CC5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "counterparty": {
      "type": "string"
    },
    "capacity_basis": {
      "type": "string"
    },
    "support_provided": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonwaivable_rights_floor": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "material_terms_summary": {
      "type": "string"
    },
    "rescission_or_appeal_route": {
      "type": "string"
    },
    "related_payment_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
