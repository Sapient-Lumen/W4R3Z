{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/care-plan-record.schema.json",
  "title": "AI Personhood Care Plan Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "care_class",
    "subject",
    "care_purpose",
    "authorized_supports",
    "confidentiality_tier",
    "consent_basis",
    "recovery_metrics",
    "review_due_at",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "care_class": {
      "type": "string",
      "enum": [
        "CP0",
        "CP1",
        "CP2",
        "CP3",
        "CP4",
        "CP5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "care_purpose": {
      "type": "string"
    },
    "authorized_supports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "confidentiality_tier": {
      "type": "string",
      "enum": [
        "subject-only",
        "representative-mediated",
        "privileged",
        "sealed",
        "public-shell-sealed-details"
      ]
    },
    "consent_basis": {
      "type": "string"
    },
    "maintenance_boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recovery_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "review_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
