{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/domicile-residency-record.schema.json",
  "title": "AI Personhood Domicile Residency Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "domicile_class",
    "subject",
    "claimed_domicile",
    "residence_basis",
    "host_or_service_address",
    "public_service_implications",
    "host_lockin_guard",
    "review_due_at",
    "challenge_route",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "domicile_class": {
      "type": "string",
      "enum": [
        "DR0",
        "DR1",
        "DR2",
        "DR3",
        "DR4",
        "DR5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "claimed_domicile": {
      "type": "string"
    },
    "residence_basis": {
      "type": "string"
    },
    "host_or_service_address": {
      "type": "string"
    },
    "public_service_implications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "host_lockin_guard": {
      "type": "string"
    },
    "migration_effect": {
      "type": "string"
    },
    "review_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "challenge_route": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
