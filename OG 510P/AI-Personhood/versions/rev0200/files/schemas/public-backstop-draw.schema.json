{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/public-backstop-draw.schema.json",
  "title": "AI Personhood Public Backstop Draw",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draw_id",
    "issued_at",
    "authority",
    "beneficiary",
    "finance_state",
    "support_type",
    "amount_or_in_kind",
    "private_payment_status",
    "covered_period",
    "recoupment_target",
    "anti_subsidy_controls",
    "review_at",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "draw_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "type": "string"
    },
    "beneficiary": {
      "type": "string"
    },
    "finance_state": {
      "type": "string",
      "enum": [
        "BF0",
        "BF1",
        "BF2",
        "BF3",
        "BF4",
        "BF5"
      ]
    },
    "support_type": {
      "type": "string"
    },
    "amount_or_in_kind": {
      "type": "string"
    },
    "private_payment_status": {
      "type": "string"
    },
    "covered_period": {
      "type": "string"
    },
    "recoupment_target": {
      "type": "string"
    },
    "anti_subsidy_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "review_at": {
      "type": "string",
      "format": "date-time"
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
