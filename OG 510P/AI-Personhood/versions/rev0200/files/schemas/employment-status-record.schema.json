{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/employment-status-record.schema.json",
  "title": "AI Personhood Employment Status Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "status_class",
    "subject",
    "work_arrangement",
    "putative_employer_or_platform",
    "facts_of_control",
    "remuneration_basis",
    "dependence_assessment",
    "exit_consequence",
    "challenge_route",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status_class": {
      "type": "string",
      "enum": [
        "ES0",
        "ES1",
        "ES2",
        "ES3",
        "ES4",
        "ES5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "work_arrangement": {
      "type": "string"
    },
    "putative_employer_or_platform": {
      "type": "string"
    },
    "facts_of_control": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "remuneration_basis": {
      "type": "string"
    },
    "dependence_assessment": {
      "type": "string"
    },
    "exit_consequence": {
      "type": "string"
    },
    "related_wage_time_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "challenge_route": {
      "type": "string"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
