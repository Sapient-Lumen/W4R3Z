{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/accommodation-determination.schema.json",
  "title": "AI Personhood Accommodation Determination",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "accommodation_class",
    "subject",
    "request_summary",
    "barrier_identified",
    "decision",
    "reasons",
    "alternatives_considered",
    "review_due_at",
    "appeal_route",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "accommodation_class": {
      "type": "string",
      "enum": [
        "AC0",
        "AC1",
        "AC2",
        "AC3",
        "AC4",
        "AC5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "request_summary": {
      "type": "string"
    },
    "barrier_identified": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "granted",
        "granted-with-modification",
        "interim-support",
        "denied",
        "stayed-for-review"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "alternatives_considered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "undue_burden_claim": {
      "type": "string"
    },
    "review_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "appeal_route": {
      "type": "string"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
