{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/data-subject-request.schema.json",
  "title": "AI Personhood Data Subject Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "created_at",
    "requester_class",
    "request_type",
    "target_data_domains",
    "conflict_screen_class",
    "privacy_tier",
    "decision",
    "response_due_at",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "requester_class": {
      "type": "string",
      "enum": [
        "human-data-subject",
        "ai-subject",
        "representative",
        "third-party-authority",
        "mixed"
      ]
    },
    "request_type": {
      "type": "string",
      "enum": [
        "access",
        "rectification",
        "erasure",
        "restriction",
        "portability",
        "objection",
        "automated-decision-review",
        "formation-access",
        "mixed"
      ]
    },
    "target_data_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflict_screen_class": {
      "type": "string",
      "enum": [
        "DR0",
        "DR1",
        "DR2",
        "DR3",
        "DR4",
        "DR5"
      ]
    },
    "privacy_tier": {
      "type": "string",
      "enum": [
        "public",
        "subject-only",
        "representative-mediated",
        "sealed",
        "privileged",
        "mixed"
      ]
    },
    "conflict_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mitigation": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "granted",
        "partial",
        "stayed",
        "denied-protective",
        "authority-review",
        "tribunal-review"
      ]
    },
    "response_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
