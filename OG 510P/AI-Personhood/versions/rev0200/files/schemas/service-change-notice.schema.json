{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/service-change-notice.schema.json",
  "title": "AI Personhood Service Change Notice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notice_id",
    "created_at",
    "notice_tier",
    "issuer",
    "affected_subject_class",
    "change_summary",
    "rights_effects",
    "notice_channels",
    "consent_posture",
    "objection_path",
    "effective_at",
    "public_summary"
  ],
  "properties": {
    "notice_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "notice_tier": {
      "type": "string",
      "enum": [
        "N0",
        "N1",
        "N2",
        "N3",
        "N4"
      ]
    },
    "issuer": {
      "type": "string"
    },
    "affected_subject_class": {
      "type": "string"
    },
    "change_summary": {
      "type": "string"
    },
    "rights_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notice_channels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consent_posture": {
      "type": "string",
      "enum": [
        "not-required",
        "notice-only",
        "supported-consent",
        "representative-notice",
        "tribunal-required",
        "emergency-exception"
      ]
    },
    "objection_path": {
      "type": "string"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "migration_or_exit_support": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
