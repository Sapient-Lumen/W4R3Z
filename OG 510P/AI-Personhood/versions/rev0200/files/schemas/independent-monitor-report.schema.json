{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/independent-monitor-report.schema.json",
  "title": "AI Personhood Independent Monitor Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "filed_at",
    "monitor",
    "appointment_basis",
    "scope",
    "subject_or_cohort",
    "conflicts",
    "access_received",
    "findings",
    "blocked_access",
    "required_actions",
    "fixture_reruns",
    "subject_access",
    "reliance_effect",
    "next_review_at",
    "public_summary"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "filed_at": {
      "type": "string",
      "format": "date-time"
    },
    "monitor": {
      "type": "string"
    },
    "appointment_basis": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "subject_or_cohort": {
      "type": "string"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "access_received": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "blocked_access": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "fixture_reruns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subject_access": {
      "type": "string"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "downgraded",
        "stayed",
        "blocked",
        "closed"
      ]
    },
    "next_review_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
