{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/community-integration-plan.schema.json",
  "title": "AI Personhood Community Integration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "created_at",
    "integration_class",
    "subject",
    "trusted_contacts_policy",
    "community_access_supports",
    "restriction_status",
    "anti_isolation_review",
    "review_due_at",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "integration_class": {
      "type": "string",
      "enum": [
        "CI0",
        "CI1",
        "CI2",
        "CI3",
        "CI4",
        "CI5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "trusted_contacts_policy": {
      "type": "string"
    },
    "community_access_supports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "restriction_status": {
      "type": "string",
      "enum": [
        "none",
        "limited",
        "contested",
        "emergency",
        "structural-review"
      ]
    },
    "linked_host_or_household_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anti_isolation_review": {
      "type": "string"
    },
    "review_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
