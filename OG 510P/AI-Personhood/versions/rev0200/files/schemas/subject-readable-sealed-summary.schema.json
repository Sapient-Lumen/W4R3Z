{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/subject-readable-sealed-summary.schema.json",
  "title": "AI Personhood Subject-Readable Sealed Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary_id",
    "issued_at",
    "tribunal",
    "case_id",
    "subject",
    "special_advocate",
    "sealed_material_classes",
    "may_ask_subject",
    "may_not_disclose",
    "questions_to_subject",
    "contradictions_preserved",
    "redaction_basis",
    "response_deadline",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "summary_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "tribunal": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "special_advocate": {
      "type": "string"
    },
    "sealed_material_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "may_ask_subject": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "may_not_disclose": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions_to_subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "text",
          "purpose"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "contradictions_preserved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redaction_basis": {
      "type": "string"
    },
    "response_deadline": {
      "type": "string",
      "format": "date-time"
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
