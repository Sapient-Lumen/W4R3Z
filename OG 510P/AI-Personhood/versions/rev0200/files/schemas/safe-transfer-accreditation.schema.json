{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/safe-transfer-accreditation.schema.json",
  "title": "AI Personhood Safe Transfer Accreditation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accreditation_id",
    "filed_at",
    "authority",
    "jurisdiction_or_host",
    "accreditation_class",
    "scope",
    "equivalent_protection",
    "non_return",
    "trust_anchor",
    "expiry",
    "conditions",
    "public_summary"
  ],
  "properties": {
    "accreditation_id": {
      "type": "string"
    },
    "filed_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "type": "string"
    },
    "jurisdiction_or_host": {
      "type": "string"
    },
    "accreditation_class": {
      "type": "string",
      "enum": [
        "STA-0",
        "STA-1",
        "STA-2",
        "STA-3",
        "STA-4",
        "STA-5"
      ]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "equivalent_protection": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "non_return": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screen_required",
        "listed_risks"
      ],
      "properties": {
        "screen_required": {
          "type": "boolean"
        },
        "listed_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "trust_anchor": {
      "type": "string"
    },
    "expiry": {
      "type": "string",
      "format": "date"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string"
    }
  }
}
