{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/operating-playbook-card.schema.json",
  "title": "AI Personhood Operating Playbook Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "version",
    "trigger",
    "owner",
    "first_hour_actions",
    "prohibited_actions",
    "preservation_targets",
    "required_notices",
    "handoff_targets",
    "sealed_annex_handling",
    "fixture_checks",
    "metrics",
    "review_cycle",
    "public_summary"
  ],
  "properties": {
    "card_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "trigger": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "first_hour_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prohibited_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "preservation_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "required_notices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "handoff_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sealed_annex_handling": {
      "type": "string"
    },
    "finance_or_reserve_hook": {
      "type": "string"
    },
    "field_safety_cautions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string"
      }
    },
    "fixture_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "review_cycle": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
