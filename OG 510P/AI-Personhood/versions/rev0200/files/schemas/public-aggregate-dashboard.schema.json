{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/public-aggregate-dashboard.schema.json",
  "title": "AI Personhood Public Aggregate Dashboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dashboard_id",
    "published_at",
    "period",
    "scope",
    "metrics",
    "suppression_rules",
    "small_cell_threshold",
    "subject_notice_rules",
    "reliance_actions",
    "privacy_review",
    "public_summary"
  ],
  "properties": {
    "dashboard_id": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "period": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number",
              "integer"
            ]
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "suppression_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "small_cell_threshold": {
      "type": "integer",
      "minimum": 1
    },
    "subject_notice_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reliance_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "privacy_review": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
