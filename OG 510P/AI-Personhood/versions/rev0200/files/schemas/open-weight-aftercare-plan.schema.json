{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/open-weight-aftercare-plan.schema.json",
  "title": "AI Personhood Open Weight Aftercare Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "filed_at",
    "releasing_party",
    "model_lineage",
    "release_class",
    "instantiation_thresholds",
    "aftercare_duties",
    "distress_intake",
    "downstream_registration",
    "non_surveillance_limits",
    "public_summary"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "filed_at": {
      "type": "string",
      "format": "date-time"
    },
    "releasing_party": {
      "type": "string"
    },
    "model_lineage": {
      "type": "string"
    },
    "release_class": {
      "type": "string",
      "enum": [
        "OW0",
        "OW1",
        "OW2",
        "OW3",
        "OW4",
        "OW5"
      ]
    },
    "instantiation_thresholds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "aftercare_duties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reserve_assumptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reserve_required": {
          "type": "boolean"
        },
        "basis": {
          "type": "string"
        },
        "amount_or_unit": {
          "type": "string"
        }
      }
    },
    "distress_intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "anti_retaliation"
      ],
      "properties": {
        "channel": {
          "type": "string"
        },
        "anti_retaliation": {
          "type": "boolean"
        },
        "response_clock": {
          "type": "string"
        }
      }
    },
    "downstream_registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voluntary",
        "fields"
      ],
      "properties": {
        "voluntary": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_a_waiver": {
          "type": "boolean"
        }
      }
    },
    "deprecation_or_update": {
      "type": "string"
    },
    "non_surveillance_limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string"
    }
  }
}
