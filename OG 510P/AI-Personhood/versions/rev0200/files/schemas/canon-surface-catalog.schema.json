{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/canon-surface-catalog.schema.json",
  "title": "AI Personhood Canon Surface Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_id",
    "created_at",
    "revision",
    "scope",
    "counts",
    "surfaces",
    "audit_findings",
    "refactor_actions",
    "public_summary"
  ],
  "properties": {
    "catalog_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaces",
        "markdown",
        "schemas",
        "examples",
        "fixtures",
        "tools"
      ],
      "properties": {
        "surfaces": {
          "type": "integer"
        },
        "markdown": {
          "type": "integer"
        },
        "schemas": {
          "type": "integer"
        },
        "examples": {
          "type": "integer"
        },
        "fixtures": {
          "type": "integer"
        },
        "tools": {
          "type": "integer"
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface_id",
          "path",
          "surface_class",
          "lifecycle_axes",
          "owner_role",
          "supersession_state",
          "review_cadence",
          "title_or_name"
        ],
        "properties": {
          "surface_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "surface_class": {
            "type": "string",
            "enum": [
              "meta",
              "doctrine",
              "transition",
              "schema",
              "example",
              "fixture",
              "tool"
            ]
          },
          "lifecycle_axes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "owner_role": {
            "type": "string"
          },
          "supersession_state": {
            "type": "string",
            "enum": [
              "current",
              "companion",
              "implementation",
              "negative-test",
              "audit-tool",
              "superseded"
            ]
          },
          "review_cadence": {
            "type": "string"
          },
          "title_or_name": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "audit_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "refactor_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string"
    }
  }
}
