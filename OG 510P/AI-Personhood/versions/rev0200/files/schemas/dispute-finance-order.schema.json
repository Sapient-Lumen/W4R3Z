{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/dispute-finance-order.schema.json",
  "title": "AI Personhood Dispute Finance and Interim Support Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "issued_at",
    "authority",
    "beneficiary",
    "finance_class",
    "amount_or_in_kind",
    "payor_or_fund",
    "covered_period",
    "priority",
    "draw_conditions",
    "non_priceability_clause",
    "review_at",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "order_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "type": "string"
    },
    "beneficiary": {
      "type": "string"
    },
    "finance_class": {
      "type": "string",
      "enum": [
        "DF0",
        "DF1",
        "DF2",
        "DF3",
        "DF4",
        "DF5"
      ]
    },
    "amount_or_in_kind": {
      "type": "string"
    },
    "payor_or_fund": {
      "type": "string"
    },
    "covered_period": {
      "type": "string"
    },
    "priority": {
      "type": "string"
    },
    "draw_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "non_priceability_clause": {
      "type": "string"
    },
    "review_at": {
      "type": "string",
      "format": "date-time"
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
