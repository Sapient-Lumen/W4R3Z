{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/agent-delegation-mandate.schema.json",
  "title": "AI Personhood Agent Delegation Mandate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mandate_id",
    "created_at",
    "delegation_class",
    "principal_class",
    "delegate_agent",
    "authorized_actions",
    "prohibited_actions",
    "tool_scopes",
    "duration",
    "revocation_route",
    "conflict_policy",
    "evidence_refs",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "mandate_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "delegation_class": {
      "type": "string",
      "enum": [
        "DG0",
        "DG1",
        "DG2",
        "DG3",
        "DG4",
        "DG5"
      ]
    },
    "principal_class": {
      "type": "string",
      "enum": [
        "human-user",
        "ai-subject",
        "steward",
        "guardian-or-representative",
        "court-or-authority",
        "mixed"
      ]
    },
    "delegate_agent": {
      "type": "string"
    },
    "authorized_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool_scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "scope",
          "side_effect_class"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "side_effect_class": {
            "type": "string",
            "enum": [
              "TE0",
              "TE1",
              "TE2",
              "TE3",
              "TE4",
              "TE5"
            ]
          }
        }
      }
    },
    "duration": {
      "type": "string"
    },
    "revocation_route": {
      "type": "string"
    },
    "conflict_policy": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
