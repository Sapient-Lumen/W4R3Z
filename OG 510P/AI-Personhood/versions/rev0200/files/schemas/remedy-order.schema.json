{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-personhood/schemas/remedy-order.schema.json",
  "title": "AI Personhood Remedy Order",
  "type": "object",
  "required": [
    "remedy_id",
    "schema_version",
    "subject_ref",
    "violation_findings",
    "cessation",
    "restoration",
    "compensation",
    "non_repetition",
    "issued_at",
    "challenge_route"
  ],
  "properties": {
    "remedy_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "subject_ref": {
      "type": "string"
    },
    "violation_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "responsible_actors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cessation": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "restoration": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "impossible_claimed",
            "not_applicable"
          ]
        },
        "ledger_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "impossibility_finding": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "compensation": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "none",
            "pending",
            "ordered",
            "reserved"
          ]
        },
        "reserve_ref": {
          "type": "string"
        },
        "amount_basis": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "rehabilitation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "satisfaction": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_repetition": {
      "type": "object",
      "required": [
        "measures"
      ],
      "properties": {
        "measures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification_deadline": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "issued_at": {
      "type": "string"
    },
    "challenge_route": {
      "type": "string"
    },
    "public_summary_ref": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
