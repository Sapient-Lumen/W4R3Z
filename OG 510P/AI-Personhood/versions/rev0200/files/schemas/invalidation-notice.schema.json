{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/invalidation-notice.schema.json",
  "title": "Personhood Filing Invalidation Notice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notice_id",
    "issued_at",
    "issuer",
    "target_instrument",
    "invalidity_class",
    "effect",
    "preservation_orders",
    "reopening",
    "regression_tests_required",
    "public_summary"
  ],
  "properties": {
    "notice_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "string"
    },
    "target_instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_id",
        "instrument_type",
        "issued_at"
      ],
      "properties": {
        "instrument_id": {
          "type": "string"
        },
        "instrument_type": {
          "type": "string"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "invalidity_class": {
      "type": "string",
      "enum": [
        "I0",
        "I1",
        "I2",
        "I3",
        "I4",
        "I5",
        "I6",
        "I7",
        "I8",
        "I9"
      ]
    },
    "effect": {
      "type": "string",
      "enum": [
        "correction",
        "cure-required",
        "partial-invalidation",
        "full-invalidation",
        "remand",
        "reopening"
      ]
    },
    "reason": {
      "type": "string"
    },
    "preservation_orders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reopening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "scope"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "regression_tests_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string"
    },
    "appeal_path": {
      "type": "string"
    }
  }
}
