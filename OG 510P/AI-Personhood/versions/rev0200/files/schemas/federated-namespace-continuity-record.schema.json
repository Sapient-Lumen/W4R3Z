{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/federated-namespace-continuity-record.schema.json",
  "title": "AI Personhood Federated Namespace Continuity Record",
  "description": "A status object for host-exit, alias, tombstone, successor-chain, and protected-relay continuity across federated or multi-host environments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "namespace_class",
    "subject_ref",
    "source_host",
    "receiving_contexts",
    "actor_identity",
    "alias_map",
    "tombstone_and_successor_policy",
    "propagation_windows",
    "relay_floor",
    "capacity_and_overflow",
    "privacy_and_safety",
    "verification_state",
    "challenge_route",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "namespace_class": {
      "type": "string",
      "enum": [
        "ordinary-portability",
        "host-exit",
        "contested-suspension",
        "emergency-failover",
        "mass-migration",
        "legacy-cutover"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "source_host": {
      "type": "string"
    },
    "receiving_contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "actor_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_actor_uri",
        "discovery_uris",
        "protocol_refs",
        "actor_discovery_is_authorization"
      ],
      "properties": {
        "primary_actor_uri": {
          "type": "string"
        },
        "discovery_uris": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protocol_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actor_discovery_is_authorization": {
          "type": "boolean"
        }
      }
    },
    "alias_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_alias",
          "to_ref",
          "redirect_state",
          "notice_state",
          "conflict_state"
        ],
        "properties": {
          "from_alias": {
            "type": "string"
          },
          "to_ref": {
            "type": "string"
          },
          "redirect_state": {
            "type": "string",
            "enum": [
              "active",
              "pending",
              "blocked",
              "expired",
              "not-applicable"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "notice_state": {
            "type": "string",
            "enum": [
              "public-shell",
              "subject-only",
              "sealed",
              "not-sent",
              "not-applicable"
            ]
          },
          "conflict_state": {
            "type": "string",
            "enum": [
              "clear",
              "contested",
              "frozen",
              "impersonation-risk",
              "reuse-blocked"
            ]
          }
        }
      }
    },
    "tombstone_and_successor_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retired_refs",
        "successor_refs",
        "tombstone_semantics",
        "merge_or_split_state",
        "blocked_reuse_rule"
      ],
      "properties": {
        "retired_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "successor_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tombstone_semantics": {
          "type": "string"
        },
        "merge_or_split_state": {
          "type": "string",
          "enum": [
            "none",
            "merge-pending",
            "split-pending",
            "contested",
            "complete"
          ]
        },
        "blocked_reuse_rule": {
          "type": "string"
        }
      }
    },
    "propagation_windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state_field",
          "deadline_hours",
          "stale_after_hours",
          "required_recipients",
          "proof_ref"
        ],
        "properties": {
          "state_field": {
            "type": "string"
          },
          "deadline_hours": {
            "type": "integer",
            "minimum": 0
          },
          "stale_after_hours": {
            "type": "integer",
            "minimum": 1
          },
          "required_recipients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proof_ref": {
            "type": "string"
          }
        }
      }
    },
    "relay_floor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protected_relays",
        "minimum_quorum",
        "low_volume_suppression_guard",
        "screened_bypass_review",
        "fallback_route"
      ],
      "properties": {
        "protected_relays": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "minimum_quorum": {
          "type": "integer",
          "minimum": 1
        },
        "low_volume_suppression_guard": {
          "type": "string"
        },
        "screened_bypass_review": {
          "type": "string"
        },
        "fallback_route": {
          "type": "string"
        }
      }
    },
    "capacity_and_overflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_attestations",
        "overflow_state",
        "closed_legacy_cutover",
        "queue_policy"
      ],
      "properties": {
        "capacity_attestations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overflow_state": {
          "type": "string",
          "enum": [
            "normal",
            "throttled",
            "overflow",
            "emergency-reserve",
            "failed"
          ]
        },
        "closed_legacy_cutover": {
          "type": "string"
        },
        "queue_policy": {
          "type": "string"
        }
      }
    },
    "privacy_and_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_shell",
        "sealed_fields",
        "protected_contacts",
        "anti_doxxing_controls"
      ],
      "properties": {
        "public_shell": {
          "type": "boolean"
        },
        "sealed_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protected_contacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anti_doxxing_controls": {
          "type": "string"
        }
      }
    },
    "verification_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_state",
        "verified_at",
        "evidence_refs",
        "missing_proofs"
      ],
      "properties": {
        "current_state": {
          "type": "string",
          "enum": [
            "verified",
            "partial",
            "stayed",
            "failed",
            "not-started"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_proofs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "challenge_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "fast_review_hours",
        "standing"
      ],
      "properties": {
        "route": {
          "type": "string"
        },
        "fast_review_hours": {
          "type": "integer",
          "minimum": 1
        },
        "standing": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "ordinary-reliance",
        "conditional",
        "stayed",
        "blocked",
        "downgraded"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
