{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/monitor-independence-retest.schema.json",
  "title": "AI Personhood Monitor Independence Retest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "retest_id",
    "performed_at",
    "monitor",
    "original_monitor_report",
    "independence_review",
    "fixtures_rerun",
    "evidence_access",
    "subject_access",
    "findings",
    "reliance_effect",
    "next_review_at",
    "public_summary"
  ],
  "properties": {
    "retest_id": {
      "type": "string"
    },
    "performed_at": {
      "type": "string",
      "format": "date-time"
    },
    "monitor": {
      "type": "string"
    },
    "original_monitor_report": {
      "type": "string"
    },
    "independence_review": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "fixtures_rerun": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_access": {
      "type": "string"
    },
    "subject_access": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "confirmed",
        "downgraded",
        "stayed",
        "replaced",
        "referred"
      ]
    },
    "next_review_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
