{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/accessibility-care-appeal.schema.json",
  "title": "AI Personhood Accessibility Care Appeal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "appeal_id",
    "created_at",
    "review_class",
    "subject",
    "appealed_object_refs",
    "issue_summary",
    "interim_support",
    "review_body",
    "deadline",
    "requested_remedy",
    "anti_retaliation_notice",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "appeal_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_class": {
      "type": "string",
      "enum": [
        "AR0",
        "AR1",
        "AR2",
        "AR3",
        "AR4",
        "AR5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "appealed_object_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "issue_summary": {
      "type": "string"
    },
    "interim_support": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_body": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "requested_remedy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "anti_retaliation_notice": {
      "type": "string"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
