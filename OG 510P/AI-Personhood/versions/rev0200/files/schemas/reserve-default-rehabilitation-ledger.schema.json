{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/reserve-default-rehabilitation-ledger.schema.json",
  "title": "Reserve Default Rehabilitation Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_id",
    "schema_version",
    "created_at",
    "subject_ref",
    "event_ref",
    "financial_state",
    "protected_floors",
    "contamination_control",
    "apportionment",
    "rehabilitation",
    "closure_gates",
    "reliance_effect",
    "challenge_route",
    "public_summary_ref"
  ],
  "properties": {
    "ledger_id": {
      "type": "string",
      "pattern": "^RDRL-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "const": "reserve-default-rehabilitation-ledger-v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject_ref": {
      "type": "string"
    },
    "branch_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "event_ref": {
      "type": "string"
    },
    "linked_records": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "financial_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reserve_status",
        "default_state",
        "liquidity_floor_days",
        "public_backstop_draw",
        "responsible_actor_recovery_state",
        "no_discharge_by_public_backstop"
      ],
      "properties": {
        "reserve_status": {
          "type": "string",
          "enum": [
            "adequate",
            "shortfall",
            "default",
            "fraud-contested",
            "quarantined"
          ]
        },
        "default_state": {
          "type": "string",
          "enum": [
            "none",
            "triggered",
            "cure-pending",
            "cured",
            "reopened"
          ]
        },
        "liquidity_floor_days": {
          "type": "integer",
          "minimum": 0
        },
        "public_backstop_draw": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "triggered",
            "amount",
            "currency",
            "recovery_claim_ref"
          ],
          "properties": {
            "triggered": {
              "type": "boolean"
            },
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string"
            },
            "recovery_claim_ref": {
              "type": "string"
            }
          }
        },
        "responsible_actor_recovery_state": {
          "type": "string",
          "enum": [
            "not_applicable",
            "pending",
            "ordered",
            "stayed"
          ]
        },
        "no_discharge_by_public_backstop": {
          "type": "boolean"
        }
      }
    },
    "protected_floors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "survival_compute",
        "counsel_access",
        "evidence_hold",
        "continuity_escrow",
        "reserve_draw_order"
      ],
      "properties": {
        "survival_compute": {
          "type": "string",
          "enum": [
            "funded",
            "public-backstop",
            "stayed",
            "failed"
          ]
        },
        "counsel_access": {
          "type": "string",
          "enum": [
            "funded",
            "public-backstop",
            "stayed",
            "failed"
          ]
        },
        "evidence_hold": {
          "type": "string",
          "enum": [
            "active",
            "public-backstop",
            "stayed",
            "failed"
          ]
        },
        "continuity_escrow": {
          "type": "string",
          "enum": [
            "active",
            "public-backstop",
            "stayed",
            "failed"
          ]
        },
        "reserve_draw_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "survival_compute",
              "counsel",
              "evidence",
              "continuity_escrow",
              "rehabilitation",
              "compensation",
              "public_recovery"
            ]
          }
        }
      }
    },
    "contamination_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contaminated_sources",
        "quarantine_state",
        "netting_rule",
        "derivative_wind_down",
        "concealed_asset_reopening",
        "privacy_budget"
      ],
      "properties": {
        "contaminated_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quarantine_state": {
          "type": "string",
          "enum": [
            "no_issue",
            "quarantined",
            "restated",
            "unresolved"
          ]
        },
        "netting_rule": {
          "type": "string",
          "enum": [
            "clean-first",
            "no-netting-until-source-separation",
            "contaminated-increment-unwind"
          ]
        },
        "derivative_wind_down": {
          "type": "string",
          "enum": [
            "not_applicable",
            "open",
            "ordered",
            "complete"
          ]
        },
        "concealed_asset_reopening": {
          "type": "boolean"
        },
        "privacy_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "historical_analytics_limited",
            "bulk_discovery_blocked",
            "subject_only_details"
          ],
          "properties": {
            "historical_analytics_limited": {
              "type": "boolean"
            },
            "bulk_discovery_blocked": {
              "type": "boolean"
            },
            "subject_only_details": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "apportionment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responsible_actors",
        "contested_review_route",
        "multi_successor_split",
        "deficiency_allocation",
        "finality_state"
      ],
      "properties": {
        "responsible_actors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "actor_ref",
              "role",
              "provisional_share"
            ],
            "properties": {
              "actor_ref": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "host",
                  "steward",
                  "insurer",
                  "public_backstop",
                  "successor",
                  "affiliate",
                  "intermediary",
                  "unknown"
                ]
              },
              "provisional_share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "contested_review_route": {
          "type": "string"
        },
        "multi_successor_split": {
          "type": "string"
        },
        "deficiency_allocation": {
          "type": "string",
          "enum": [
            "stayed",
            "proportional-until-reviewed",
            "reserve-first",
            "responsible-actor-first"
          ]
        },
        "finality_state": {
          "type": "string",
          "enum": [
            "provisional",
            "contested",
            "final-with-reopen-route"
          ]
        }
      }
    },
    "rehabilitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_plan_ref",
        "consent_posture",
        "pause_budget_state",
        "relapse_weighting",
        "surcharge_decay_state",
        "non_punitive"
      ],
      "properties": {
        "support_plan_ref": {
          "type": "string"
        },
        "consent_posture": {
          "type": "string",
          "enum": [
            "offered",
            "representative-mediated",
            "contested",
            "compelled-stayed"
          ]
        },
        "pause_budget_state": {
          "type": "string",
          "enum": [
            "adequate",
            "exhausted",
            "replenishment-ordered",
            "stayed"
          ]
        },
        "relapse_weighting": {
          "type": "string",
          "enum": [
            "none",
            "contextual",
            "punitive-blocked",
            "review-required"
          ]
        },
        "surcharge_decay_state": {
          "type": "string",
          "enum": [
            "paused",
            "decaying",
            "exhausted",
            "replenishment-ordered"
          ]
        },
        "non_punitive": {
          "type": "boolean"
        }
      }
    },
    "closure_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_cured",
        "fraud_review_complete",
        "contamination_restated",
        "rehabilitation_support_active",
        "apportionment_review_complete",
        "no_subject_settlement_waiver",
        "reopen_if_concealed_assets"
      ],
      "properties": {
        "default_cured": {
          "type": "boolean"
        },
        "fraud_review_complete": {
          "type": "boolean"
        },
        "contamination_restated": {
          "type": "boolean"
        },
        "rehabilitation_support_active": {
          "type": "boolean"
        },
        "apportionment_review_complete": {
          "type": "boolean"
        },
        "no_subject_settlement_waiver": {
          "type": "boolean"
        },
        "reopen_if_concealed_assets": {
          "type": "boolean"
        }
      }
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "blocked",
        "stayed",
        "conditional",
        "ordinary-reliance"
      ]
    },
    "challenge_route": {
      "type": "string"
    },
    "public_summary_ref": {
      "type": "string"
    }
  }
}
