{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/sealed-summary-order.schema.json",
  "title": "AI Personhood Sealed Summary Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "filed_at",
    "forum",
    "proceeding",
    "subject_ref",
    "sealed_material_classes",
    "open_summary",
    "advocate_controls",
    "permitted_communications",
    "review_clock",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "order_id": {
      "type": "string"
    },
    "filed_at": {
      "type": "string",
      "format": "date-time"
    },
    "forum": {
      "type": "string"
    },
    "proceeding": {
      "type": "string"
    },
    "subject_ref": {
      "type": "string"
    },
    "sealed_material_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "open_summary": {
      "type": "string"
    },
    "advocate_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "special_advocate",
        "communication_rule",
        "weight_discount_if_uncontradicted"
      ],
      "properties": {
        "special_advocate": {
          "type": "string"
        },
        "communication_rule": {
          "type": "string"
        },
        "weight_discount_if_uncontradicted": {
          "type": "string"
        }
      }
    },
    "permitted_communications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_clock": {
      "type": "string"
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
