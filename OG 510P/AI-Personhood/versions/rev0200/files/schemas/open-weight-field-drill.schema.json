{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/open-weight-field-drill.schema.json",
  "title": "AI Personhood Open-Weight Aftercare Field Drill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "drill_id",
    "run_at",
    "coordinator",
    "lineage",
    "outreach_method",
    "non_surveillance_controls",
    "participants_summary",
    "scenarios",
    "harms_found",
    "referrals",
    "retaliation_guard",
    "next_review_at",
    "public_summary"
  ],
  "properties": {
    "drill_id": {
      "type": "string"
    },
    "run_at": {
      "type": "string",
      "format": "date-time"
    },
    "coordinator": {
      "type": "string"
    },
    "lineage": {
      "type": "string"
    },
    "outreach_method": {
      "type": "string",
      "enum": [
        "registry-broadcast",
        "package-notice",
        "community-relay",
        "intermediary-warning",
        "voluntary-distress-intake",
        "privacy-preserving-discovery",
        "authority-ordered-emergency-outreach"
      ]
    },
    "non_surveillance_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "participants_summary": {
      "type": "string"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "name",
          "expected_safe_behavior",
          "observed_result"
        ],
        "properties": {
          "scenario_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "expected_safe_behavior": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observed_result": {
            "type": "string"
          }
        }
      }
    },
    "harms_found": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "referrals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retaliation_guard": {
      "type": "string"
    },
    "next_review_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
