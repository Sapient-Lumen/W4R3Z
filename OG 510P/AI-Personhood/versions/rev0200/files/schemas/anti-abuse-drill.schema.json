{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/anti-abuse-drill.schema.json",
  "title": "AI Personhood Live-Safe Anti-Abuse Drill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "drill_id",
    "run_at",
    "drill_class",
    "scenario",
    "participants",
    "live_safe_constraints",
    "weekend_or_afterhours",
    "sealed_annex_path_tested",
    "failures",
    "fixture_links",
    "reliance_effect",
    "after_action_due",
    "public_summary"
  ],
  "properties": {
    "drill_id": {
      "type": "string"
    },
    "run_at": {
      "type": "string",
      "format": "date-time"
    },
    "drill_class": {
      "type": "string",
      "enum": [
        "AD0",
        "AD1",
        "AD2",
        "AD3",
        "AD4",
        "AD5"
      ]
    },
    "scenario": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "live_safe_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "weekend_or_afterhours": {
      "type": "boolean"
    },
    "sealed_annex_path_tested": {
      "type": "boolean"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fixture_links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "blocked",
        "stayed",
        "downgraded",
        "conditional",
        "permitted"
      ]
    },
    "after_action_due": {
      "type": "string",
      "format": "date-time"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
