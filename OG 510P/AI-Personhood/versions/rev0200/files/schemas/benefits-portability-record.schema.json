{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/benefits-portability-record.schema.json",
  "title": "AI Personhood Benefits Portability Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "benefit_class",
    "subject",
    "benefit_provider",
    "covered_benefits",
    "contribution_basis",
    "portability_events",
    "host_switch_route",
    "emergency_support_route",
    "privacy_minimization",
    "dispute_route",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "benefit_class": {
      "type": "string",
      "enum": [
        "BP0",
        "BP1",
        "BP2",
        "BP3",
        "BP4",
        "BP5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "benefit_provider": {
      "type": "string"
    },
    "covered_benefits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "contribution_basis": {
      "type": "string"
    },
    "portability_events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "host_switch_route": {
      "type": "string"
    },
    "emergency_support_route": {
      "type": "string"
    },
    "privacy_minimization": {
      "type": "string"
    },
    "dispute_route": {
      "type": "string"
    },
    "public_backstop_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
