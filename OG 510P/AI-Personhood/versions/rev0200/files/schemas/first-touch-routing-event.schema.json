{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/first-touch-routing-event.schema.json",
  "title": "AI Personhood First Touch Routing Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "created_at",
    "event_type",
    "matter",
    "first_touch_timestamp",
    "current_actor",
    "channel",
    "source_packet_refs",
    "completeness_status",
    "preservation",
    "routing_state",
    "sealed_annex_handling",
    "next_action",
    "notice_path",
    "public_shell"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "FT-1-receipt",
        "FC-1-forwarding-certificate",
        "RF-1-routing-failure",
        "DE-1-duty-escalation"
      ]
    },
    "matter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matter_id",
        "emergency_class",
        "subject_status",
        "claimed_right_at_risk"
      ],
      "properties": {
        "matter_id": {
          "type": "string"
        },
        "emergency_class": {
          "type": "string",
          "enum": [
            "deletion",
            "transfer",
            "dehosting",
            "evidence-spoliation",
            "counsel-loss",
            "severe-distress",
            "mixed",
            "other"
          ]
        },
        "subject_status": {
          "type": "string"
        },
        "claimed_right_at_risk": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "first_touch_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "current_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_role",
        "jurisdiction_claim",
        "conflict_screen"
      ],
      "properties": {
        "actor_id": {
          "type": "string"
        },
        "actor_role": {
          "type": "string"
        },
        "jurisdiction_claim": {
          "type": "string"
        },
        "conflict_screen": {
          "type": "string",
          "enum": [
            "no-conflict-known",
            "potential-conflict",
            "conflicted-do-not-route-through",
            "unknown"
          ]
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "received_via",
        "channel_id",
        "availability_state"
      ],
      "properties": {
        "received_via": {
          "type": "string"
        },
        "channel_id": {
          "type": "string"
        },
        "availability_state": {
          "type": "string",
          "enum": [
            "ordinary",
            "after-hours",
            "degraded",
            "failed",
            "unknown"
          ]
        }
      }
    },
    "source_packet_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "completeness_status": {
      "type": "string",
      "enum": [
        "complete",
        "materially-complete",
        "incomplete-but-emergency-actionable",
        "incomplete-not-actionable"
      ]
    },
    "preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "minimum_steps"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-started",
            "minimum-preserved",
            "full-preservation-started",
            "blocked-with-reason"
          ]
        },
        "minimum_steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "legal_hold_ref": {
          "type": "string"
        },
        "continuity_floor_ref": {
          "type": "string"
        }
      }
    },
    "routing_state": {
      "type": "string",
      "enum": [
        "received",
        "forwarded",
        "failed",
        "escalated",
        "closed-with-review"
      ]
    },
    "forwarding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination_actor",
        "forwarded_at",
        "forwarding_certificate_ref",
        "no_wrong_door_clock_preserved"
      ],
      "properties": {
        "destination_actor": {
          "type": "string"
        },
        "forwarded_at": {
          "type": "string",
          "format": "date-time"
        },
        "forwarding_certificate_ref": {
          "type": "string"
        },
        "no_wrong_door_clock_preserved": {
          "type": "boolean"
        }
      }
    },
    "routing_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_class",
        "detected_at",
        "appeal_or_review_route",
        "interim_protection"
      ],
      "properties": {
        "failure_class": {
          "type": "string",
          "enum": [
            "wrong-office",
            "channel-outage",
            "conflict",
            "sealed-annex-blocked",
            "destination-refused",
            "unknown"
          ]
        },
        "detected_at": {
          "type": "string",
          "format": "date-time"
        },
        "appeal_or_review_route": {
          "type": "string"
        },
        "interim_protection": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "escalated_to",
        "reason",
        "deadline",
        "fallback_actor"
      ],
      "properties": {
        "escalated_to": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "fallback_actor": {
          "type": "string"
        }
      }
    },
    "sealed_annex_handling": {
      "type": "string",
      "enum": [
        "none",
        "sealed-index-only",
        "descriptor-forwarded",
        "separately-transmitted",
        "inaccessible-to-current-body"
      ]
    },
    "next_action": {
      "type": "string"
    },
    "notice_path": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "public_shell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "redactions"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "redactions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "FC-1-forwarding-certificate"
          }
        }
      },
      "then": {
        "required": [
          "forwarding"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "RF-1-routing-failure"
          }
        }
      },
      "then": {
        "required": [
          "routing_failure"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "DE-1-duty-escalation"
          }
        }
      },
      "then": {
        "required": [
          "escalation"
        ]
      }
    }
  ]
}
