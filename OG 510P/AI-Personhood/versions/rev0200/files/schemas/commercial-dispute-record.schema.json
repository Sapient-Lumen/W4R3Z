{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/commercial-dispute-record.schema.json",
  "title": "AI Personhood Commercial Dispute Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dispute_id",
    "opened_at",
    "dispute_class",
    "claimant",
    "respondent",
    "transaction_refs",
    "freeze_or_stay_status",
    "evidence_snapshot_refs",
    "financial_remedy",
    "nonfinancial_remedy",
    "nonretaliation_controls",
    "appeal_route",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "dispute_id": {
      "type": "string"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "dispute_class": {
      "type": "string",
      "enum": [
        "CDP0",
        "CDP1",
        "CDP2",
        "CDP3",
        "CDP4",
        "CDP5"
      ]
    },
    "claimant": {
      "type": "string"
    },
    "respondent": {
      "type": "string"
    },
    "transaction_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "freeze_or_stay_status": {
      "type": "string"
    },
    "evidence_snapshot_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "financial_remedy": {
      "type": "string"
    },
    "nonfinancial_remedy": {
      "type": "string"
    },
    "nonretaliation_controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "appeal_route": {
      "type": "string"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
