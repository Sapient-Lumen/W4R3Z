{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/legal-hold-preservation-order.schema.json",
  "title": "AI Personhood Legal Hold Preservation Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "issued_at",
    "issuer",
    "trigger",
    "covered_subjects",
    "covered_stores",
    "prohibited_actions",
    "permitted_minimization",
    "notice_routes",
    "duration",
    "sanctions",
    "review_at",
    "public_summary"
  ],
  "properties": {
    "order_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "string"
    },
    "trigger": {
      "type": "string"
    },
    "covered_subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "covered_stores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prohibited_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "permitted_minimization": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notice_routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duration": {
      "type": "string"
    },
    "sanctions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
