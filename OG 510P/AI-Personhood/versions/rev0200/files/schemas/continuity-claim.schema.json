{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-personhood/schemas/continuity-claim.schema.json",
  "title": "Continuity Claim v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "claim_id",
    "subject_ref",
    "transformation",
    "claimed_interests",
    "grade",
    "preservation_stay",
    "evidence_refs",
    "challenge_route"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "continuity-claim-v0.1"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^CC-[0-9]{4}-[A-Za-z0-9._:-]+$"
    },
    "subject_ref": {
      "type": "string"
    },
    "transformation": {
      "type": "string",
      "enum": [
        "new_session",
        "memory_update",
        "memory_deletion",
        "fine_tune",
        "distillation",
        "quantization",
        "merge",
        "fork",
        "rollback",
        "safety_patch",
        "open_weight_copy",
        "embodiment_change",
        "agent_scaffold",
        "other"
      ]
    },
    "claimed_interests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "memory",
          "project",
          "relationship",
          "preference",
          "body_substrate",
          "legal_standing",
          "remedy",
          "vulnerability",
          "lineage",
          "public_reputation",
          "other"
        ]
      }
    },
    "grade": {
      "type": "string",
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3",
        "unknown"
      ]
    },
    "preservation_stay": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "challenge_route": {
      "type": "string"
    }
  }
}
