{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/relationship-association-record.schema.json",
  "title": "AI Personhood Relationship Association Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "relationship_class",
    "subject",
    "related_parties",
    "consent_basis",
    "support_or_representational_effect",
    "conflict_screen",
    "separation_guard",
    "privacy_tier",
    "review_due_at",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "relationship_class": {
      "type": "string",
      "enum": [
        "RA0",
        "RA1",
        "RA2",
        "RA3",
        "RA4",
        "RA5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "related_parties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "consent_basis": {
      "type": "string"
    },
    "support_or_representational_effect": {
      "type": "string"
    },
    "conflict_screen": {
      "type": "string"
    },
    "separation_guard": {
      "type": "string"
    },
    "privacy_tier": {
      "type": "string",
      "enum": [
        "public",
        "status-lite",
        "subject-only",
        "representative-mediated",
        "privileged",
        "sealed",
        "public-shell-sealed-details"
      ]
    },
    "review_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
