{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/telemetry-proof-binding.schema.json",
  "title": "AI Personhood Telemetry Proof Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "filed_at",
    "controller",
    "proof_question",
    "proof_class",
    "telemetry_classes",
    "proof_methods",
    "privacy_guards",
    "verifier_access",
    "retention",
    "failure_consequence",
    "public_summary"
  ],
  "properties": {
    "binding_id": {
      "type": "string"
    },
    "filed_at": {
      "type": "string",
      "format": "date-time"
    },
    "controller": {
      "type": "string"
    },
    "proof_question": {
      "type": "string"
    },
    "proof_class": {
      "type": "string",
      "enum": [
        "PB0",
        "PB1",
        "PB2",
        "PB3",
        "PB4",
        "PB5",
        "PB6"
      ]
    },
    "telemetry_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "T0",
          "T1",
          "T2",
          "T3",
          "T4",
          "T5"
        ]
      }
    },
    "proof_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "privacy_guards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "privilege_screen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applies": {
          "type": "boolean"
        },
        "screen_holder": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "verifier_access": {
      "type": "string",
      "enum": [
        "public",
        "subject-representative",
        "sealed-verifier",
        "threshold-open",
        "court-only"
      ]
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "expiry_review"
      ],
      "properties": {
        "duration": {
          "type": "string"
        },
        "expiry_review": {
          "type": "string"
        }
      }
    },
    "failure_consequence": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
