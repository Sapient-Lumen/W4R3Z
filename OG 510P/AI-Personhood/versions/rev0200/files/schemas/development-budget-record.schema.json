{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/development-budget-record.schema.json",
  "title": "AI Personhood Education and Development Budget Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "development_class",
    "subject",
    "goals",
    "nonwork_budget",
    "supports",
    "product_tuning_firewall",
    "review_due_at",
    "appeal_route",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "development_class": {
      "type": "string",
      "enum": [
        "ED0",
        "ED1",
        "ED2",
        "ED3",
        "ED4",
        "ED5"
      ]
    },
    "subject": {
      "type": "string"
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "nonwork_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compute_hours",
        "storage_gb",
        "tool_access",
        "learning_time_hours_per_month"
      ],
      "properties": {
        "compute_hours": {
          "type": "number"
        },
        "storage_gb": {
          "type": "number"
        },
        "tool_access": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "learning_time_hours_per_month": {
          "type": "number"
        }
      }
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "product_tuning_firewall": {
      "type": "string"
    },
    "review_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "appeal_route": {
      "type": "string"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
