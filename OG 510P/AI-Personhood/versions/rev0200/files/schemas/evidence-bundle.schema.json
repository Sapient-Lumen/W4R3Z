{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/evidence-bundle.schema.json",
  "title": "Rights-Grade Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_id",
    "created_at",
    "matter",
    "custodian",
    "items",
    "sealed_annexes",
    "chain_of_custody",
    "access_rules"
  ],
  "properties": {
    "bundle_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "matter": {
      "type": "string"
    },
    "custodian": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "kind",
          "hash",
          "source",
          "authenticity_status",
          "materiality"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "authenticity_status": {
            "type": "string",
            "enum": [
              "unverified",
              "witness-authenticated",
              "system-authenticated",
              "independently-verified",
              "disputed"
            ]
          },
          "materiality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "decisive"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "sealed_annexes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "annex_id",
          "public_description",
          "access_class",
          "contradiction_method"
        ],
        "properties": {
          "annex_id": {
            "type": "string"
          },
          "public_description": {
            "type": "string"
          },
          "access_class": {
            "type": "string",
            "enum": [
              "sealed-authority",
              "sealed-special-advocate",
              "subject-private",
              "public"
            ]
          },
          "contradiction_method": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "chain_of_custody": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "actor",
          "action"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "access_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_access",
        "representative_access",
        "public_access"
      ],
      "properties": {
        "subject_access": {
          "type": "string"
        },
        "representative_access": {
          "type": "string"
        },
        "public_access": {
          "type": "string"
        }
      }
    },
    "spoliation_risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    }
  }
}
