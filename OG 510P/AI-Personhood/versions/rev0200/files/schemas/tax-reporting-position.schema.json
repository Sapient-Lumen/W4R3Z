{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/tax-reporting-position.schema.json",
  "title": "AI Personhood Tax Reporting Position",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "position_id",
    "created_at",
    "reporting_class",
    "subject_or_account",
    "reporting_party",
    "jurisdiction",
    "transaction_or_support_refs",
    "tax_characterization",
    "withholding_or_information_reporting",
    "privacy_minimization",
    "non_evasion_analysis",
    "appeal_or_correction_route",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "position_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reporting_class": {
      "type": "string",
      "enum": [
        "TR0",
        "TR1",
        "TR2",
        "TR3",
        "TR4",
        "TR5"
      ]
    },
    "subject_or_account": {
      "type": "string"
    },
    "reporting_party": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "transaction_or_support_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tax_characterization": {
      "type": "string"
    },
    "withholding_or_information_reporting": {
      "type": "string"
    },
    "privacy_minimization": {
      "type": "string"
    },
    "non_evasion_analysis": {
      "type": "string"
    },
    "appeal_or_correction_route": {
      "type": "string"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
