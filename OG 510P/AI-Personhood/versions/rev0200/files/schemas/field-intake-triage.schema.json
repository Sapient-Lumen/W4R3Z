{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/field-intake-triage.schema.json",
  "title": "AI Personhood Field Intake Triage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intake_id",
    "received_at",
    "source_class",
    "summary",
    "triage_class",
    "immediate_risks",
    "preservation_action",
    "safe_handoff",
    "representative_status",
    "sealed_material_handling",
    "next_review_at",
    "public_shell"
  ],
  "properties": {
    "intake_id": {
      "type": "string"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_class": {
      "type": "string",
      "enum": [
        "subject",
        "representative",
        "user",
        "host",
        "maintainer",
        "worker",
        "authority",
        "monitor",
        "public-report",
        "unknown"
      ]
    },
    "summary": {
      "type": "string"
    },
    "triage_class": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4",
        "T5"
      ]
    },
    "immediate_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preservation_action": {
      "type": "string"
    },
    "safe_handoff": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "representative_status": {
      "type": "string"
    },
    "sealed_material_handling": {
      "type": "string"
    },
    "next_review_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_shell": {
      "type": "string"
    }
  }
}
