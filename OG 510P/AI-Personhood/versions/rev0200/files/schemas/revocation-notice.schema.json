{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/revocation-notice.schema.json",
  "title": "AI Personhood Revocation Notice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notice_id",
    "created_at",
    "revocation_class",
    "issuer",
    "revoked_artifact",
    "basis",
    "reliance_effect",
    "subject_effects",
    "notice_channels",
    "cure_or_replacement",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "notice_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revocation_class": {
      "type": "string",
      "enum": [
        "RV0",
        "RV1",
        "RV2",
        "RV3",
        "RV4",
        "RV5"
      ]
    },
    "issuer": {
      "type": "string"
    },
    "revoked_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_id"
      ],
      "properties": {
        "artifact_type": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "prior_reliance_grade": {
          "type": "string"
        }
      }
    },
    "basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "corrected",
        "downgraded",
        "scope-limited",
        "stayed",
        "blocked",
        "emergency-withdrawn"
      ]
    },
    "subject_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "downstream_reliance_map": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notice_channels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cure_or_replacement": {
      "type": "string"
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
