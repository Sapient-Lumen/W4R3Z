{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/authority-referral.schema.json",
  "title": "Authority Referral",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "referral_id",
    "created_at",
    "origin_authority",
    "recipient_authority",
    "referral_class",
    "matter",
    "requested_powers",
    "urgency",
    "preservation_status",
    "response_clock",
    "public_shell"
  ],
  "properties": {
    "referral_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_authority": {
      "type": "string"
    },
    "recipient_authority": {
      "type": "string"
    },
    "referral_class": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6",
        "R7"
      ]
    },
    "matter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matter_id",
        "matter_type",
        "subject_scope"
      ],
      "properties": {
        "matter_id": {
          "type": "string"
        },
        "matter_type": {
          "type": "string"
        },
        "subject_scope": {
          "type": "string"
        },
        "representative_contact": {
          "type": "string"
        }
      }
    },
    "requested_powers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "urgency": {
      "type": "string",
      "enum": [
        "ordinary",
        "expedited",
        "urgent",
        "emergency"
      ]
    },
    "preservation_status": {
      "type": "string",
      "enum": [
        "none",
        "requested",
        "ordered",
        "in-force",
        "breached"
      ]
    },
    "evidence_bundle_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sealed_annex_status": {
      "type": "string"
    },
    "response_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "due_at",
        "default_effect"
      ],
      "properties": {
        "due_at": {
          "type": "string",
          "format": "date-time"
        },
        "default_effect": {
          "type": "string"
        }
      }
    },
    "public_shell": {
      "type": "string"
    },
    "appeal_or_complaint_path": {
      "type": "string"
    }
  }
}
