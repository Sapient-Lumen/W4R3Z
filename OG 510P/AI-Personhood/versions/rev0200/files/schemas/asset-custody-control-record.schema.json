{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/asset-custody-control-record.schema.json",
  "title": "AI Personhood Asset Custody Control Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "asset_class",
    "asset_description",
    "controller",
    "beneficiary",
    "authority_ref",
    "segregation_status",
    "creditor_limit",
    "freeze_or_dispute_rule",
    "continuity_relevance",
    "public_private_split",
    "reliance_effect",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "asset_class": {
      "type": "string",
      "enum": [
        "AC0",
        "AC1",
        "AC2",
        "AC3",
        "AC4",
        "AC5"
      ]
    },
    "asset_description": {
      "type": "string"
    },
    "controller": {
      "type": "string"
    },
    "beneficiary": {
      "type": "string"
    },
    "authority_ref": {
      "type": "string"
    },
    "segregation_status": {
      "type": "string"
    },
    "creditor_limit": {
      "type": "string"
    },
    "freeze_or_dispute_rule": {
      "type": "string"
    },
    "continuity_relevance": {
      "type": "string"
    },
    "public_private_split": {
      "type": "string"
    },
    "reliance_effect": {
      "type": "string",
      "enum": [
        "none",
        "conditional",
        "ordinary-reliance",
        "stayed",
        "blocked"
      ]
    },
    "public_summary": {
      "type": "string"
    }
  }
}
