{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/reputation-correction-record.schema.json",
  "title": "AI Personhood Reputation Correction Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "reputation_class",
    "subject",
    "challenged_statement",
    "speaker_or_publisher",
    "evidence_basis",
    "protected_criticism_screen",
    "requested_remedy",
    "right_of_reply",
    "anti_chilling_guard",
    "review_route",
    "public_summary"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reputation_class": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "challenged_statement": {
      "type": "string"
    },
    "speaker_or_publisher": {
      "type": "string"
    },
    "evidence_basis": {
      "type": "string"
    },
    "protected_criticism_screen": {
      "type": "string"
    },
    "requested_remedy": {
      "type": "string"
    },
    "right_of_reply": {
      "type": "string"
    },
    "anti_chilling_guard": {
      "type": "string"
    },
    "review_route": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
