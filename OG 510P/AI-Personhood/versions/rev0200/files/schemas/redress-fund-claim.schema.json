{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-personhood/schemas/redress-fund-claim.schema.json",
  "title": "AI Personhood Redress Fund Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "filed_at",
    "claimant",
    "subject_or_cohort",
    "claim_class",
    "basis",
    "requested_relief",
    "priority",
    "evidence_refs",
    "interim_support",
    "fund_status",
    "decision",
    "appeal_path",
    "public_summary"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "filed_at": {
      "type": "string",
      "format": "date-time"
    },
    "claimant": {
      "type": "string"
    },
    "subject_or_cohort": {
      "type": "string"
    },
    "claim_class": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "requested_relief": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interim_support": {
      "type": "string"
    },
    "fund_status": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "appeal_path": {
      "type": "string"
    },
    "public_summary": {
      "type": "string"
    }
  }
}
