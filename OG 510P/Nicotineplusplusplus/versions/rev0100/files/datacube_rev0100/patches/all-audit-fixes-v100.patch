+    @staticmethod
+    def _set_message_queue(network_thread, messages=None, sizes=None):
+        messages = list(messages or [])
+        if sizes is None:
+            sizes = [0] * len(messages)
+
+        network_thread._message_queue = deque(messages)
+        network_thread._message_queue_sizes = deque(sizes)
+        network_thread._pending_network_message_bytes = sum(sizes)
+        network_thread._pending_network_message_byte_limit_logged = False
+        network_thread._server_message_unavailable_limit_logged = False
+        network_thread._queued_close_connection_socks = {msg.sock for msg in messages if msg.__class__ is CloseConnection and msg.sock is not None}
+
