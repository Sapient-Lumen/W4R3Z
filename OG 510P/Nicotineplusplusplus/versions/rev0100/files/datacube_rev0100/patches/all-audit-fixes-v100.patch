+    @staticmethod
+    def _pack_peer_init_message(username="peer", conn_type=ConnectionType.PEER):
+        init = PeerInit(init_user=username, conn_type=conn_type)
+        msg_content = init.make_network_message()
+        return bytearray(
+            init.pack_uint32(len(msg_content) + 1)
