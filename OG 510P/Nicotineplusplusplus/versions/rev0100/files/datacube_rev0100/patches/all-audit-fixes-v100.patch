+    def test_server_disconnect_emits_single_batched_abort_parent_update(self):
+        downloads = core.downloads
+        downloads.transfers.clear()
+        downloads.queued_transfers.clear()
+        downloads.queued_users.clear()
+        downloads.active_users.clear()
+        downloads.failed_users.clear()
+
+        transfer1 = Transfer("peer", "one.mp3", size=1)
+        transfer2 = Transfer("peer", "two.mp3", size=2)
+        downloads._append_transfer(transfer1)
+        downloads._append_transfer(transfer2)
+        downloads._enqueue_transfer(transfer1)
+        downloads._enqueue_transfer(transfer2)
+
+        single_updates = []
+        batch_updates = []
+
+        def on_abort_download(transfer, status, update_parent):
+            single_updates.append((transfer, status, update_parent))
+
+        def on_abort_downloads(transfers, status):
+            batch_updates.append((list(transfers), status))
+
+        events.connect("abort-download", on_abort_download)
+        events.connect("abort-downloads", on_abort_downloads)
+
+        try:
+            downloads._server_disconnect(SimpleNamespace())
+
+        finally:
+            events.disconnect("abort-download", on_abort_download)
+            events.disconnect("abort-downloads", on_abort_downloads)
+
+        # Already-inactive failed transfers are updated through the batched
+        # event only, avoiding per-transfer GUI fanout during disconnect.
+        self.assertEqual([], single_updates)
+        self.assertEqual(1, len(batch_updates))
+        self.assertEqual([transfer1, transfer2], batch_updates[0][0])
+        self.assertEqual(TransferStatus.USER_LOGGED_OFF, batch_updates[0][1])
