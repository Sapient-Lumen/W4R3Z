+    @staticmethod
+    def _pack_room_list_segment(rooms, has_count=True):
+        message = bytearray()
+        message += SlskMessage.pack_uint32(len(rooms))
+
+        for room in rooms:
+            message += SlskMessage.pack_string(room[0] if has_count else room)
+
+        if has_count:
+            message += SlskMessage.pack_uint32(len(rooms))
+
+            for _room, user_count in rooms:
+                message += SlskMessage.pack_uint32(user_count)
+
+        return message
