+    for key, value in kwargs.items():
+        if len(parts) >= MAX_STRACE_ARGUMENTS:
+            break
+
+        parts.append(f"{key}={_bounded_debug_repr(value)}")
+
+    num_omitted = max(0, len(args) + len(kwargs) - len(parts))
+
+    if num_omitted:
+        parts.append(f"... {num_omitted} argument(s) omitted")
+
+    line = f"{name}({', '.join(parts)})"
+
+    if len(line.encode("utf-8", "replace")) <= MAX_STRACE_LINE_BYTES:
+        return line
+
+    return truncate_string_byte(line, MAX_STRACE_LINE_BYTES, ellipsize=True)
