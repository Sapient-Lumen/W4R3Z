+        eof = False
+        chunk_size = 64 * 1024
+
+        def read_more():
+            nonlocal buffer, eof
+
+            if eof:
+                return
+
+            chunk = handle.read(chunk_size)
+
+            if chunk == "":
+                eof = True
+                return
+
+            buffer += chunk
+
+            if len(buffer.encode("utf-8", "surrogatepass")) > cls.MAX_TRANSFER_LIST_JSON_ROW_BYTES:
+                raise ValueError("transfer row exceeds gross JSON row size limit")
+
+        def compact_buffer():
+            nonlocal buffer, pos
+
+            if pos < chunk_size:
+                return
+
+            buffer = buffer[pos:]
+            pos = 0
+
+        def skip_whitespace():
+            nonlocal pos
+
