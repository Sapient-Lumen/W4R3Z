+def _format_log_attr_value(value, depth=0):
+    """Return a bounded representation of a protocol/debug-log value."""
+
+    if isinstance(value, memoryview):
+        return f"<memoryview len={len(value)}>"
+
+    if isinstance(value, (bytes, bytearray)):
+        return f"<{value.__class__.__name__} len={len(value)}>"
+
+    if depth >= 2:
+        try:
+            value_len = len(value)
+        except TypeError:
+            value_len = None
+
+        if value_len is not None:
+            return f"<{value.__class__.__name__} len={value_len}>"
+
+    elif isinstance(value, dict):
+        sample = [
+            (_format_log_attr_value(key, depth + 1), _format_log_attr_value(item, depth + 1))
+            for key, item in islice(value.items(), MAX_LOG_ATTR_COLLECTION_ITEMS)
+        ]
+        return f"<dict len={len(value)} sample={sample!r}>"
+
+    elif isinstance(value, (list, tuple, set, frozenset)):
+        value_type = value.__class__.__name__
+        sample = [_format_log_attr_value(item, depth + 1)
+                  for item in islice(value, MAX_LOG_ATTR_COLLECTION_ITEMS)]
+        return f"<{value_type} len={len(value)} sample={sample!r}>"
+
+    if isinstance(value, str):
+        if len(value) > MAX_LOG_ATTR_REPR_LENGTH:
+            omitted_chars = len(value) - MAX_LOG_ATTR_REPR_LENGTH
+            return f"{value[:MAX_LOG_ATTR_REPR_LENGTH]!r}... <truncated {omitted_chars} chars>"
+
+        return repr(value)
+
+    value_repr = repr(value)
+
+    if len(value_repr) > MAX_LOG_ATTR_REPR_LENGTH:
+        omitted_chars = len(value_repr) - MAX_LOG_ATTR_REPR_LENGTH
+        value_repr = f"{value_repr[:MAX_LOG_ATTR_REPR_LENGTH]}... <truncated {omitted_chars} chars>"
+
+    return value_repr
+
+
+def _format_log_attrs(message):
