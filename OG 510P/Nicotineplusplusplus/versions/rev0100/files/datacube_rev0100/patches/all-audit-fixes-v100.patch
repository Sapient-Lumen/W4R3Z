+    @staticmethod
+    def _estimate_pending_peer_message_size(msg, limit=None):
+        """Estimate retained memory for a queued pre-connection peer message.
+
+        Count caps alone are weak for heavyweight messages whose Python objects
+        can already contain many strings, paths, and result rows before a peer
+        socket exists. This is a conservative budget heuristic, not an exact
+        object-size profiler, and stops walking once *limit* is exceeded.
+        """
+
+        total = 256
+        seen = set()
+
+        def add(value):
+            nonlocal total
+
+            if value is None:
+                return
+
+            if limit is not None and total > limit:
+                return
+
+            value_id = id(value)
+
+            if value_id in seen:
+                return
+
+            seen.add(value_id)
+
+            if isinstance(value, (bytes, bytearray, memoryview)):
+                total += len(value)
+                return
+
+            if isinstance(value, str):
+                total += len(value.encode("utf-8", "replace"))
+                return
+
+            if isinstance(value, dict):
+                total += len(value) * 64
+
+                for key, item in value.items():
+                    add(key)
+                    add(item)
+
+                    if limit is not None and total > limit:
+                        break
+
+                return
+
+            if isinstance(value, (list, tuple, set, frozenset)):
+                total += len(value) * 32
+
+                for item in value:
+                    add(item)
+
+                    if limit is not None and total > limit:
+                        break
+
+                return
+
+            for attr in getattr(value, "__slots__", ()):  # slskmessages are slot-based
+                if attr == "sock":
+                    continue
+
+                try:
+                    add(getattr(value, attr))
+
+                except AttributeError:
+                    continue
+
+                if limit is not None and total > limit:
+                    break
+
+        add(msg)
+        return total
