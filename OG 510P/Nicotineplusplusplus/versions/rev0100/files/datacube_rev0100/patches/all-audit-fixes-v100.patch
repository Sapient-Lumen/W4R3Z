+    def test_process_scanner_drains_queue_after_process_exit(self):
+        """Scanner can exit before the queue reader has consumed final items."""
+
+        from collections import deque
+
+        class FinishedProcess:
+            @staticmethod
+            def is_alive():
+                return False
+
+        class QueueWithPendingItem:
+            def __init__(self, *items):
+                self.items = deque(items)
+
+            def get_nowait(self):
+                if not self.items:
+                    raise Empty
+
+                return self.items.popleft()
+
+            def get(self, timeout=None):  # pylint: disable=unused-argument
+                return self.get_nowait()
+
+        shares = object.__new__(Shares)
+        shares._scanner_process = FinishedProcess()
+        shares.file_path_index = ()
+        shares.compressed_shares = {}
+        shares.initialized = False
+
+        file_path_index = ("/shared/file.flac",)
+        successful = shares._process_scanner(QueueWithPendingItem(file_path_index))
+
+        self.assertTrue(successful)
+        self.assertEqual(file_path_index, shares.file_path_index)
