[
  {
    "field": "path_audit_id",
    "required": "yes",
    "allowed_values_or_pattern": "^unicode_path_[0-9]{3}$",
    "meaning": "Stable audit row identifier."
  },
  {
    "field": "check",
    "required": "yes",
    "allowed_values_or_pattern": "controlled check name",
    "meaning": "Name of the path-safety check."
  },
  {
    "field": "severity",
    "required": "yes",
    "allowed_values_or_pattern": "info|medium|high",
    "meaning": "Finding severity."
  },
  {
    "field": "status",
    "required": "yes",
    "allowed_values_or_pattern": "pass|review|fail",
    "meaning": "Check result."
  },
  {
    "field": "observed_count",
    "required": "yes",
    "allowed_values_or_pattern": "integer",
    "meaning": "Count of affected paths or observations."
  },
  {
    "field": "affected_paths",
    "required": "no",
    "allowed_values_or_pattern": "pipe-delimited package-relative paths",
    "meaning": "Representative affected paths for non-pass or inventory rows."
  },
  {
    "field": "detail",
    "required": "yes",
    "allowed_values_or_pattern": "free text",
    "meaning": "Explanation of the check and result."
  }
