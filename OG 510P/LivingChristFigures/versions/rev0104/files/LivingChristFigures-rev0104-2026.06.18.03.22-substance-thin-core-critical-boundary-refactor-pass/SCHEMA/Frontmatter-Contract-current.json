{
  "contract_id": "living_christ_figures_frontmatter_contract_current",
  "revision_added": "rev0031",
  "purpose": "Machine-readable contract for the three front-matter schema families used in the cube.",
  "global_notes": [
    "This is a lightweight package contract, not a complete JSON Schema implementation.",
    "Tools validate required fields, simple types, id patterns, date strings, and schema names.",
    "live_referral_safe is false by default for candidates in this working cube."
  ],
  "schemas": {
    "living_christ_figures_candidate_v1": {
      "applies_to": "CANDIDATES/*.txt excluding _REFRESH*.txt",
      "required_fields": {
        "schema": "string",
        "candidate_id": "string",
        "name": "string",
        "location": "string",
        "status_current": "string",
        "verification_state": "string",
        "capacity_state": "string",
        "live_referral_safe": "boolean",
        "source_use_scope": "string",
        "sensitivity": "list[string]",
        "office_ids": "list[string]",
        "last_metadata_reviewed": "date-string"
      },
      "patterns": {
        "candidate_id": "^cand_[a-z0-9_]+$",
        "office_ids[]": "^office_[a-z0-9_]+$",
        "last_metadata_reviewed": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
      },
      "package_invariants": {
        "schema": "living_christ_figures_candidate_v1",
        "live_referral_safe": false,
        "source_use_scope": "working_research_not_live_referral_directory"
      }
    },
    "living_christ_figures_office_card_v1": {
      "applies_to": "OFFICE-CARDS/*.txt",
      "required_fields": {
        "schema": "string",
        "office_id": "string",
        "title": "string",
        "maturity": "string",
        "candidate_count_estimate": "integer",
        "risk_flags": "list[string]",
        "last_metadata_reviewed": "date-string"
      },
      "patterns": {
        "office_id": "^office_[a-z0-9_]+$",
        "last_metadata_reviewed": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
      },
      "package_invariants": {
        "schema": "living_christ_figures_office_card_v1"
      }
    },
    "living_christ_figures_refresh_note_v1": {
      "applies_to": "CANDIDATES/_REFRESH*.txt",
      "required_fields": {
        "schema": "string",
        "refresh_id": "string",
        "revision_added": "string",
        "related_candidate_ids": "list[string]",
        "indexed_at_revision": "string"
      },
      "recommended_fields": {
        "last_metadata_reviewed": "date-string"
      },
      "patterns": {
        "refresh_id": "^refresh_[a-z0-9_]+$",
        "related_candidate_ids[]": "^cand_[a-z0-9_]+$",
        "indexed_at_revision": "^rev[0-9]{4}$"
      },
      "package_invariants": {
        "schema": "living_christ_figures_refresh_note_v1"
      }
    }
  }
}
