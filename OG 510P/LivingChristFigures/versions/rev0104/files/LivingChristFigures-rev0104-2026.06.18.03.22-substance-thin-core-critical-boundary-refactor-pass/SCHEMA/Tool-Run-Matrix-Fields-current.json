[
  {
    "field": "tool_path",
    "required": "true",
    "allowed_values_or_pattern": "tools/*.py",
    "meaning": "Package-relative tool path."
  },
  {
    "field": "tool_role",
    "required": "true",
    "allowed_values_or_pattern": "generated_report_builder|package_qa_runner|schema_validator|checker|checker_or_helper",
    "meaning": "Tool role."
  },
  {
    "field": "declared_outputs",
    "required": "false",
    "allowed_values_or_pattern": "pipe-separated package-relative paths",
    "meaning": "Generated outputs declared by provenance for this tool."
  },
  {
    "field": "included_in_provenance",
    "required": "true",
    "allowed_values_or_pattern": "yes|no",
    "meaning": "Whether tool declares generated outputs in provenance."
  },
  {
    "field": "included_in_dependency_graph",
    "required": "true",
    "allowed_values_or_pattern": "yes|no",
    "meaning": "Whether tool appears in the package dependency graph."
  },
  {
    "field": "included_in_release_gate",
    "required": "true",
    "allowed_values_or_pattern": "yes|no",
    "meaning": "Whether tool participates directly or indirectly in release gates."
  },
  {
    "field": "qa_direct_check",
    "required": "true",
    "allowed_values_or_pattern": "yes|no",
    "meaning": "Whether qa_cube.py directly names/checks the tool or its report."
  },
  {
    "field": "status",
    "required": "true",
    "allowed_values_or_pattern": "pass|missing_provenance|missing_dependency_inventory",
    "meaning": "Machine-readable status."
  },
  {
    "field": "note",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Tool inventory note."
  }
]
