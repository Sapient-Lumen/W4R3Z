[
  {
    "field": "scope_check_id",
    "required": "true",
    "allowed_values_or_pattern": "checksum_scope_[0-9]{3}",
    "meaning": "Stable checksum-scope audit row identifier."
  },
  {
    "field": "check",
    "required": "true",
    "allowed_values_or_pattern": "nonempty string",
    "meaning": "Checksum-scope invariant being checked."
  },
  {
    "field": "severity",
    "required": "true",
    "allowed_values_or_pattern": "info|low|medium|high",
    "meaning": "Severity of the finding if the invariant is not fully satisfied."
  },
  {
    "field": "status",
    "required": "true",
    "allowed_values_or_pattern": "pass|review|fail",
    "meaning": "Pass when the scope check is satisfied; fail when it blocks handoff; review for non-blocking order issues."
  },
  {
    "field": "expected_count",
    "required": "true",
    "allowed_values_or_pattern": "integer string",
    "meaning": "Expected count for the scope check."
  },
  {
    "field": "observed_count",
    "required": "true",
    "allowed_values_or_pattern": "integer string",
    "meaning": "Observed count for the scope check."
  },
  {
    "field": "detail",
    "required": "false",
    "allowed_values_or_pattern": "free text",
    "meaning": "Human-readable scope finding or pass note."
  }
]
