[
  {
    "field": "rule_number",
    "required": "true",
    "allowed_values_or_pattern": "integer >= 15",
    "meaning": "Boundary/gate rule number."
  },
  {
    "field": "rule_name",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Rule name from Boundary-Rule-Coverage-current.csv."
  },
  {
    "field": "boundary_coverage_status",
    "required": "true",
    "allowed_values_or_pattern": "present|missing",
    "meaning": "Whether the rule appears in Boundary-Rule-Coverage-current.csv."
  },
  {
    "field": "mapped_release_gates",
    "required": "false",
    "allowed_values_or_pattern": "pipe-separated gate ids",
    "meaning": "Release gate ids or bundle labels mapped to the rule."
  },
  {
    "field": "mapped_tools",
    "required": "false",
    "allowed_values_or_pattern": "pipe-separated package-relative tool paths",
    "meaning": "Tools mapped to the rule."
  },
  {
    "field": "mapped_reports",
    "required": "false",
    "allowed_values_or_pattern": "pipe-separated package-relative report paths",
    "meaning": "Reports mapped to the rule."
  },
  {
    "field": "qa_enforced",
    "required": "true",
    "allowed_values_or_pattern": "automated|automated_or_ledger_gate|policy_or_legacy",
    "meaning": "How strongly the rule is enforced in the current package."
  },
  {
    "field": "trace_status",
    "required": "true",
    "allowed_values_or_pattern": "pass|policy_only|missing_boundary_coverage|missing_trace_file",
    "meaning": "Machine-readable trace status."
  },
  {
    "field": "note",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Traceability note."
  }
]
