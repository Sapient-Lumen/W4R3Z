[
  {
    "field": "finding_id",
    "required": "true",
    "allowed_values_or_pattern": "^pisa_[0-9]{4}$",
    "meaning": "Finding id emitted by public_index_semantic_audit.py."
  },
  {
    "field": "severity",
    "required": "true",
    "allowed_values_or_pattern": "info|medium|high",
    "meaning": "Finding severity; high blocks handoff."
  },
  {
    "field": "status",
    "required": "true",
    "allowed_values_or_pattern": "pass|warn|fail",
    "meaning": "Machine status for the semantic check."
  },
  {
    "field": "check",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Name of semantic public-index check."
  },
  {
    "field": "candidate_id",
    "required": "true",
    "allowed_values_or_pattern": "candidate id or .",
    "meaning": "Candidate row under semantic review, or . for package-level checks."
  },
  {
    "field": "expected",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Expected template, location, or note invariant."
  },
  {
    "field": "observed",
    "required": "true",
    "allowed_values_or_pattern": "string",
    "meaning": "Observed value or summary."
  },
  {
    "field": "detail",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Finding detail or pass statement."
  },
  {
    "field": "remediation",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Action required to resolve the finding."
  }
]
