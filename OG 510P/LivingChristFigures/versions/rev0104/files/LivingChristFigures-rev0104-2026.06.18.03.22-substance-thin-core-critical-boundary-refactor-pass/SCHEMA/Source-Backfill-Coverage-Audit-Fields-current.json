[
  {
    "field": "coverage_id",
    "required": "yes",
    "allowed_values_or_pattern": "sbc_[0-9]{4}",
    "meaning": "Stable row identifier for one Source Registry source_id coverage check."
  },
  {
    "field": "source_id",
    "required": "yes",
    "allowed_values_or_pattern": "source registry id",
    "meaning": "Source Registry source identifier."
  },
  {
    "field": "domain",
    "required": "yes",
    "allowed_values_or_pattern": "string",
    "meaning": "Source domain from Source Registry."
  },
  {
    "field": "candidate_ids",
    "required": "no",
    "allowed_values_or_pattern": "pipe-separated candidate ids",
    "meaning": "Candidate ids from Source Registry."
  },
  {
    "field": "source_registry_row_present",
    "required": "yes",
    "allowed_values_or_pattern": "true|false",
    "meaning": "Whether the source exists in Source Registry."
  },
  {
    "field": "backfill_action_count",
    "required": "yes",
    "allowed_values_or_pattern": "integer",
    "meaning": "Number of Source-Metadata-Backfill rows for this source_id."
  },
  {
    "field": "latest_backfill_revision",
    "required": "no",
    "allowed_values_or_pattern": "revision id",
    "meaning": "Latest batch revision observed for this source_id."
  },
  {
    "field": "latest_backfill_status",
    "required": "no",
    "allowed_values_or_pattern": "string",
    "meaning": "Latest backfill status observed for this source_id."
  },
  {
    "field": "duplicate_action_count",
    "required": "yes",
    "allowed_values_or_pattern": "integer",
    "meaning": "Backfill action count beyond the first row."
  },
  {
    "field": "coverage_status",
    "required": "yes",
    "allowed_values_or_pattern": "covered|missing_backfill_coverage",
    "meaning": "Coverage result for this source_id."
  },
  {
    "field": "severity",
    "required": "yes",
    "allowed_values_or_pattern": "info|high",
    "meaning": "High if coverage is missing."
  },
  {
    "field": "status",
    "required": "yes",
    "allowed_values_or_pattern": "pass|fail",
    "meaning": "Pass/fail state for release gate."
  },
  {
    "field": "action_needed",
    "required": "yes",
    "allowed_values_or_pattern": "string",
    "meaning": "Recommended action if missing or duplicated."
  }
