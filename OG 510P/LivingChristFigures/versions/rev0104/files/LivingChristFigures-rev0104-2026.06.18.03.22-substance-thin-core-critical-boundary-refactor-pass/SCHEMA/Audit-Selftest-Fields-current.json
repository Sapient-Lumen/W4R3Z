[
  {
    "field": "selftest_id",
    "required": "true",
    "allowed_values_or_pattern": "nonempty string",
    "meaning": "stable self-test case identifier"
  },
  {
    "field": "target_tool",
    "required": "true",
    "allowed_values_or_pattern": "nonempty string",
    "meaning": "tool expected to detect the controlled mutation"
  },
  {
    "field": "mutation",
    "required": "true",
    "allowed_values_or_pattern": "nonempty string",
    "meaning": "temporary mutation injected into a copied package"
  },
  {
    "field": "expected_failure_signal",
    "required": "true",
    "allowed_values_or_pattern": "nonempty string",
    "meaning": "finding/exit signal that should appear if the auditor works"
  },
  {
    "field": "observed_failure_signal",
    "required": "true",
    "allowed_values_or_pattern": "nonempty string",
    "meaning": "actual return code or finding count observed during the self-test"
  },
  {
    "field": "status",
    "required": "true",
    "allowed_values_or_pattern": "pass|fail",
    "meaning": "pass if expected failure signal appeared; fail if the auditor did not catch the mutation"
  },
  {
    "field": "detail",
    "required": "false",
    "allowed_values_or_pattern": "string",
    "meaning": "human-readable purpose of the self-test"
  }
]
