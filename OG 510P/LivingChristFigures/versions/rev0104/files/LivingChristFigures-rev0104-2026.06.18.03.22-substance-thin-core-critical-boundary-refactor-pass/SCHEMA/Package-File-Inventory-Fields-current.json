[
  {
    "field": "file_path",
    "required": "true",
    "allowed_values_or_pattern": "package-relative path",
    "meaning": "Inventoried package file path."
  },
  {
    "field": "size_bytes",
    "required": "true",
    "allowed_values_or_pattern": "integer",
    "meaning": "File size in bytes."
  },
  {
    "field": "sha256",
    "required": "true",
    "allowed_values_or_pattern": "64 lowercase hex characters",
    "meaning": "SHA-256 digest recorded by the file inventory."
  },
  {
    "field": "package_zone",
    "required": "true",
    "allowed_values_or_pattern": "root_handoff_layer|candidate_layer|office_card_layer|longform_layer|public_layer|governance_layer|meta_audit_layer|schema_contract_layer|tooling_layer",
    "meaning": "Primary package zone for the file."
  },
  {
    "field": "file_role",
    "required": "true",
    "allowed_values_or_pattern": "controlled role label",
    "meaning": "Coarse file role used to identify accidental or unclassified package surfaces."
  },
  {
    "field": "currentness",
    "required": "true",
    "allowed_values_or_pattern": "current_surface|recent_revision_record|historical_revision_record|current_or_static",
    "meaning": "Whether the file is current, recent revision history, historical revision history, or static."
  },
  {
    "field": "generated_by",
    "required": "false",
    "allowed_values_or_pattern": "tool path or empty",
    "meaning": "Generator path when known from generated-artifact provenance."
  },
  {
    "field": "public_release_scope",
    "required": "true",
    "allowed_values_or_pattern": "public_layer_file_allowlist_required|not_public_layer",
    "meaning": "Whether the file is inside the public-release layer."
  },
  {
    "field": "notes",
    "required": "false",
    "allowed_values_or_pattern": "free text",
    "meaning": "Inventory note, including self-recursion exclusions."
  }
