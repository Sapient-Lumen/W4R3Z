[
  {
    "field": "decision_id",
    "required": "true",
    "allowed_values_or_pattern": "^govdec_[0-9]{4}$",
    "meaning": "Governance decision id."
  },
  {
    "field": "date",
    "required": "true",
    "allowed_values_or_pattern": "YYYY-MM-DD",
    "meaning": "Date the decision was recorded."
  },
  {
    "field": "decision_class",
    "required": "true",
    "allowed_values_or_pattern": "policy_gate_added|public_release_blocked|boundary_shape_allowed|source_link_restricted|manual_review_required",
    "meaning": "Decision class."
  },
  {
    "field": "scope",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Package area, candidate, or public surface governed."
  },
  {
    "field": "decision",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Decision made."
  },
  {
    "field": "what_changed",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Concrete package behavior changed by the decision."
  },
  {
    "field": "what_remains_blocked",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Surfaces still blocked."
  },
  {
    "field": "review_required_before_change",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Review needed before loosening or changing decision."
  },
  {
    "field": "related_files",
    "required": "true",
    "allowed_values_or_pattern": "pipe-separated paths",
    "meaning": "Files carrying the decision."
  },
  {
    "field": "status",
    "required": "true",
    "allowed_values_or_pattern": "active|superseded|closed",
    "meaning": "Current decision status."
  }
]
