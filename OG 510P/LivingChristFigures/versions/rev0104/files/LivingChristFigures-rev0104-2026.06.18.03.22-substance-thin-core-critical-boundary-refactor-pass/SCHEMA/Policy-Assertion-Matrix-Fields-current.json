[
  {
    "field": "assertion_id",
    "required": "true",
    "allowed_values_or_pattern": "assertion_[0-9]{3}",
    "meaning": "Stable policy assertion identifier."
  },
  {
    "field": "policy_assertion",
    "required": "true",
    "allowed_values_or_pattern": "nonempty string",
    "meaning": "High-level release or governance claim being backed by executable evidence."
  },
  {
    "field": "policy_surface",
    "required": "true",
    "allowed_values_or_pattern": "pipe-separated package paths",
    "meaning": "Policy/handoff surfaces where the assertion appears."
  },
  {
    "field": "enforced_by_gates",
    "required": "true",
    "allowed_values_or_pattern": "pipe-separated gate IDs",
    "meaning": "Release gates that enforce or summarize the assertion."
  },
  {
    "field": "enforced_by_tools",
    "required": "true",
    "allowed_values_or_pattern": "pipe-separated tool paths",
    "meaning": "Tools that produce the evidence reports."
  },
  {
    "field": "evidence_reports",
    "required": "true",
    "allowed_values_or_pattern": "pipe-separated package paths",
    "meaning": "Reports that must exist and be pass/zero-high compatible."
  },
  {
    "field": "status",
    "required": "true",
    "allowed_values_or_pattern": "pass|fail",
    "meaning": "Pass when surfaces/tools/reports exist and evidence reports are not failing/high."
  },
  {
    "field": "note",
    "required": "false",
    "allowed_values_or_pattern": "free text",
    "meaning": "Human-readable evidence or failure note."
  }
]
