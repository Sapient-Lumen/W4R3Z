[
  {
    "field": "finding_id",
    "required": "true",
    "allowed_values_or_pattern": "^rdc_[0-9]{4}$",
    "meaning": "Stable finding identifier emitted by required_document_coverage.py."
  },
  {
    "field": "severity",
    "required": "true",
    "allowed_values_or_pattern": "info|medium|high",
    "meaning": "Finding severity; high blocks handoff."
  },
  {
    "field": "check",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Name of required-document check."
  },
  {
    "field": "file",
    "required": "true",
    "allowed_values_or_pattern": "package-relative path or directory",
    "meaning": "File/path being checked."
  },
  {
    "field": "row",
    "required": "true",
    "allowed_values_or_pattern": "integer or 0",
    "meaning": "CSV row number where applicable; 0 for file-level checks."
  },
  {
    "field": "status",
    "required": "true",
    "allowed_values_or_pattern": "pass|missing|missing_current_revision|drift|missing_companion",
    "meaning": "Machine-readable coverage status."
  },
  {
    "field": "detail",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Finding detail."
  },
  {
    "field": "remediation",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Expected correction if status is not pass."
  }
]
