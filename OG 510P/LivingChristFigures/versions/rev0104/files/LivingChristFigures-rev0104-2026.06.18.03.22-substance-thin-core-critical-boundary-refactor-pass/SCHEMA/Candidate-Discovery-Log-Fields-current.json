[
  {
    "field": "discovery_id",
    "required": "yes",
    "allowed_values_or_pattern": "discovery_[0-9]{4}",
    "meaning": "stable discovery-log row id"
  },
  {
    "field": "revision",
    "required": "yes",
    "allowed_values_or_pattern": "rev[0-9]{4}",
    "meaning": "revision in which the discovery decision was recorded"
  },
  {
    "field": "date",
    "required": "yes",
    "allowed_values_or_pattern": "YYYY-MM-DD",
    "meaning": "research/decision date"
  },
  {
    "field": "candidate_name",
    "required": "yes",
    "allowed_values_or_pattern": "text",
    "meaning": "human candidate/scout label"
  },
  {
    "field": "proposed_candidate_id",
    "required": "yes",
    "allowed_values_or_pattern": "cand_[a-z0-9_]+ or proposed placeholder",
    "meaning": "candidate id if promoted or proposed id if parked"
  },
  {
    "field": "discovery_status",
    "required": "yes",
    "allowed_values_or_pattern": "promoted_to_candidate|parked_related_candidate|not_promoted_context_source|rejected_duplicate|rejected_boundary_risk",
    "meaning": "intake disposition"
  },
  {
    "field": "decision",
    "required": "yes",
    "allowed_values_or_pattern": "controlled/free-text decision token",
    "meaning": "decision made in this pass"
  },
  {
    "field": "decision_rationale",
    "required": "yes",
    "allowed_values_or_pattern": "text",
    "meaning": "why the decision was made"
  },
  {
    "field": "source_ids",
    "required": "no",
    "allowed_values_or_pattern": "pipe-delimited source ids",
    "meaning": "source ids used for promoted/context rows"
  },
  {
    "field": "source_urls",
    "required": "no",
    "allowed_values_or_pattern": "pipe-delimited URLs",
    "meaning": "research trail URLs; internal only"
  },
  {
    "field": "office_ids",
    "required": "no",
    "allowed_values_or_pattern": "pipe-delimited office ids",
    "meaning": "candidate office ids or proposed office"
  },
  {
    "field": "boundary_flags",
    "required": "yes",
    "allowed_values_or_pattern": "pipe-delimited tokens",
    "meaning": "public safety boundaries identified during discovery"
  },
  {
    "field": "public_layer_action",
    "required": "yes",
    "allowed_values_or_pattern": "no_public_expansion|no_public_expansion_boundary_index_only|boundary_index_shape_only",
    "meaning": "public-layer action for the row"
  },
  {
    "field": "research_mode",
    "required": "yes",
    "allowed_values_or_pattern": "text token",
    "meaning": "how research was conducted/safened"
  },
  {
    "field": "next_action",
    "required": "yes",
    "allowed_values_or_pattern": "text",
    "meaning": "next research/audit action"
  },
  {
    "field": "status",
    "required": "yes",
    "allowed_values_or_pattern": "pass|fail",
    "meaning": "row status"
  },
  {
    "field": "last_reviewed",
    "required": "yes",
    "allowed_values_or_pattern": "YYYY-MM-DD",
    "meaning": "last review date"
  }
]
