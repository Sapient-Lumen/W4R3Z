[
  {
    "field": "test_id",
    "required": "true",
    "allowed_values_or_pattern": "neg_[0-9]{3}",
    "meaning": "Stable controlled-fixture test identifier."
  },
  {
    "field": "fixture_name",
    "required": "true",
    "allowed_values_or_pattern": "nonempty string",
    "meaning": "Short name of the public-release lint fixture."
  },
  {
    "field": "expected_risk_type",
    "required": "true",
    "allowed_values_or_pattern": "configured public_release_lint risk_type",
    "meaning": "Risk type the fixture must trigger."
  },
  {
    "field": "expected_min_severity",
    "required": "true",
    "allowed_values_or_pattern": "medium|high",
    "meaning": "Minimum severity expected from the linter for this fixture."
  },
  {
    "field": "observed_severities",
    "required": "false",
    "allowed_values_or_pattern": "pipe-separated severities",
    "meaning": "Severities observed for the expected risk type."
  },
  {
    "field": "observed_risk_types",
    "required": "false",
    "allowed_values_or_pattern": "pipe-separated risk types",
    "meaning": "All configured risk types observed in the fixture output."
  },
  {
    "field": "status",
    "required": "true",
    "allowed_values_or_pattern": "pass|fail",
    "meaning": "Pass when the fixture is caught at or above the expected severity."
  },
  {
    "field": "note",
    "required": "false",
    "allowed_values_or_pattern": "free text",
    "meaning": "Human-readable fixture result note."
  }
