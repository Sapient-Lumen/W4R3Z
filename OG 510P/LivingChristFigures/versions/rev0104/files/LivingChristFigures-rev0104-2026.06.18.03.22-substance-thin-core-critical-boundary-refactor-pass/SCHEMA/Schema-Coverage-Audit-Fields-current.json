[
  {
    "field": "finding_id",
    "required": "true",
    "allowed_values_or_pattern": "^sca_[0-9]{4}$",
    "meaning": "Audit finding identifier emitted by schema_coverage_audit.py."
  },
  {
    "field": "severity",
    "required": "true",
    "allowed_values_or_pattern": "info|medium|high",
    "meaning": "Finding severity; high blocks release handoff; medium records backlog."
  },
  {
    "field": "check",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Name of schema-coverage check."
  },
  {
    "field": "file",
    "required": "true",
    "allowed_values_or_pattern": "package-relative path",
    "meaning": "File or table being checked."
  },
  {
    "field": "row",
    "required": "true",
    "allowed_values_or_pattern": "integer or 0",
    "meaning": "Row number when applicable."
  },
  {
    "field": "detail",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Finding detail or pass statement."
  },
  {
    "field": "coverage_status",
    "required": "true",
    "allowed_values_or_pattern": "pass|pass_with_backlog|missing_json_mirror|missing_markdown_companion|missing_field_schema_companion|schema_backlog",
    "meaning": "Machine-readable coverage classification."
  }
]
