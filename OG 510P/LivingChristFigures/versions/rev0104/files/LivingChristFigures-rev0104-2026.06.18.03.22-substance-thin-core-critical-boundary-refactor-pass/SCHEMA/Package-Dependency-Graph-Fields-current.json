[
  {
    "field": "edge_id",
    "required": "true",
    "allowed_values_or_pattern": "^dep_[0-9]{5}$",
    "meaning": "Dependency edge id."
  },
  {
    "field": "edge_type",
    "required": "true",
    "allowed_values_or_pattern": "controlled edge type",
    "meaning": "Dependency type, such as input_feeds_generated_artifact or ledger_mirrors_json."
  },
  {
    "field": "source_path",
    "required": "true",
    "allowed_values_or_pattern": "package-relative path",
    "meaning": "Source side of the dependency edge."
  },
  {
    "field": "target_path",
    "required": "true",
    "allowed_values_or_pattern": "package-relative path",
    "meaning": "Target side of the dependency edge."
  },
  {
    "field": "generator",
    "required": "false",
    "allowed_values_or_pattern": "tools/*.py path",
    "meaning": "Generator script when applicable."
  },
  {
    "field": "status",
    "required": "true",
    "allowed_values_or_pattern": "pass|missing_dependency|info",
    "meaning": "Whether edge paths exist under configured checks."
  },
  {
    "field": "note",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Interpretive note for the edge."
  }
]
