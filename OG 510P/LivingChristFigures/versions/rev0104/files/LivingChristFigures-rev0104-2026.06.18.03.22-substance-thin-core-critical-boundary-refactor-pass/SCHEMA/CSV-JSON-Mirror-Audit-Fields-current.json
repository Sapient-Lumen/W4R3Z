[
  {
    "field": "finding_id",
    "required": "true",
    "allowed_values_or_pattern": "^cjma_[0-9]{4}$",
    "meaning": "Audit finding identifier emitted by csv_json_mirror_audit.py."
  },
  {
    "field": "severity",
    "required": "true",
    "allowed_values_or_pattern": "info|medium|high",
    "meaning": "Finding severity; high blocks release handoff."
  },
  {
    "field": "check",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Name of mirror-audit check."
  },
  {
    "field": "file",
    "required": "true",
    "allowed_values_or_pattern": "package-relative path or paired path",
    "meaning": "CSV/JSON file or pair being checked."
  },
  {
    "field": "row",
    "required": "true",
    "allowed_values_or_pattern": "integer or 0",
    "meaning": "CSV/JSON row number when applicable."
  },
  {
    "field": "detail",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Finding detail or pass statement."
  }
]
