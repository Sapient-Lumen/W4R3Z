[
  {
    "field": "candidate_id",
    "required": "true",
    "allowed_values_or_pattern": "^cand_[a-z0-9_]+$",
    "meaning": "Candidate identifier; must cover every Candidate-Ledger row exactly once."
  },
  {
    "field": "candidate_name",
    "required": "true",
