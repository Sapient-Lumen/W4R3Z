[
  {
    "field": "finding_id",
    "required": "true",
    "allowed_values_or_pattern": "^pra_[0-9]{4}$",
    "meaning": "Stable finding identifier emitted by path_reference_audit.py."
  },
  {
    "field": "severity",
    "required": "true",
    "allowed_values_or_pattern": "info|medium|high",
    "meaning": "Finding severity; high blocks handoff."
  },
  {
    "field": "check",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Name of path-reference check."
  },
  {
    "field": "file",
    "required": "true",
    "allowed_values_or_pattern": "package-relative path",
    "meaning": "File containing the reference or package-level pass row."
  },
  {
    "field": "row",
    "required": "true",
    "allowed_values_or_pattern": "integer or 0",
    "meaning": "Line number where the reference was found; 0 for package-level rows."
  },
  {
    "field": "reference",
    "required": "false",
    "allowed_values_or_pattern": "package-relative path or glob",
    "meaning": "Original referenced path-like string."
  },
  {
    "field": "target_path",
    "required": "false",
    "allowed_values_or_pattern": "package-relative path or glob",
    "meaning": "Normalized target path or glob checked."
  },
  {
    "field": "status",
    "required": "true",
    "allowed_values_or_pattern": "pass|glob_matched|missing_reference|read_error",
    "meaning": "Machine-readable resolution status."
  },
  {
    "field": "detail",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Human-readable detail."
  }
]
