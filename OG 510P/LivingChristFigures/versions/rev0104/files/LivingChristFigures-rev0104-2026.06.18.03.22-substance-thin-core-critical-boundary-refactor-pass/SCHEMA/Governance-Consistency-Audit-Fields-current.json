[
  {
    "field": "finding_id",
    "required": "true",
    "allowed_values_or_pattern": "^gca_[0-9]{4}$",
    "meaning": "Finding id emitted by governance_consistency_audit.py."
  },
  {
    "field": "severity",
    "required": "true",
    "allowed_values_or_pattern": "info|medium|high",
    "meaning": "Finding severity; high blocks handoff."
  },
  {
    "field": "check",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Consistency check name."
  },
  {
    "field": "scope",
    "required": "true",
    "allowed_values_or_pattern": "candidate|source|governance|package",
    "meaning": "Scope of the finding."
  },
  {
    "field": "subject_id",
    "required": "true",
    "allowed_values_or_pattern": "candidate/source/package id",
    "meaning": "Specific subject of the finding."
  },
  {
    "field": "detail",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Finding detail or pass statement."
  },
  {
    "field": "required_action",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Action required to resolve or maintain the gate."
  }
]
