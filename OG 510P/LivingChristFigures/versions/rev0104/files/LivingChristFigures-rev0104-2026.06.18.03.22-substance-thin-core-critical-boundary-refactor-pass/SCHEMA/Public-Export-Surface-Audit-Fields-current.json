[
  {
    "field": "audit_id",
    "required": "yes",
    "allowed_values_or_pattern": "^public_export_surface_[0-9]{4}$",
    "meaning": "stable row identifier for the public export surface audit"
  },
  {
    "field": "surface_path",
    "required": "yes",
    "allowed_values_or_pattern": "package-relative path or .",
    "meaning": "surface being evaluated"
  },
  {
    "field": "check",
    "required": "yes",
    "allowed_values_or_pattern": "snake_case",
    "meaning": "specific public/export boundary check"
  },
  {
    "field": "export_surface_class",
    "required": "yes",
    "allowed_values_or_pattern": "public_payload_manifest|legacy_export_manifest|public_index|public_file|summary",
    "meaning": "class of public/export surface under review"
  },
  {
    "field": "severity",
    "required": "yes",
    "allowed_values_or_pattern": "info|medium|high",
    "meaning": "release severity"
  },
  {
    "field": "status",
    "required": "yes",
    "allowed_values_or_pattern": "pass|fail|review",
