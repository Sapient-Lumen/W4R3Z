  },
  {
    "field": "expected_value",
    "required": "yes",
    "allowed_values_or_pattern": "string",
    "meaning": "expected contract value"
  },
  {
    "field": "observed_value",
    "required": "yes",
    "allowed_values_or_pattern": "string",
    "meaning": "observed value or summary"
  },
  {
    "field": "note",
    "required": "yes",
    "allowed_values_or_pattern": "string",
    "meaning": "human-readable interpretation and remediation guidance"
  }
