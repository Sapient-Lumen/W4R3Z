[
  {
    "field": "finding_id",
    "required": "true",
    "allowed_values_or_pattern": "^pip_[0-9]{4}$",
    "meaning": "Finding id emitted by public_index_parity.py."
  },
  {
    "field": "severity",
    "required": "true",
    "allowed_values_or_pattern": "info|medium|high",
    "meaning": "Finding severity; high blocks handoff."
  },
  {
    "field": "check",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Name of parity check."
  },
  {
    "field": "file",
    "required": "true",
    "allowed_values_or_pattern": "package-relative path",
    "meaning": "File or file-set checked."
  },
  {
    "field": "row",
    "required": "true",
    "allowed_values_or_pattern": "integer or 0",
    "meaning": "CSV row number where applicable."
  },
  {
    "field": "field",
    "required": "false",
    "allowed_values_or_pattern": "field name",
    "meaning": "Field where the finding applies."
  },
  {
    "field": "detail",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Finding detail or pass statement."
  },
  {
    "field": "remediation",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Action required to resolve the finding."
  }
]
