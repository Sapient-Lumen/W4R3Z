[
  {
    "field": "step_id",
    "required": "true",
    "allowed_values_or_pattern": "regen_[0-9]{3}",
    "meaning": "Stable deterministic regeneration-plan step identifier."
  },
  {
    "field": "phase",
    "required": "true",
    "allowed_values_or_pattern": "ordered phase label",
    "meaning": "Coarse phase for deterministic ordering."
  },
  {
    "field": "tool_path",
    "required": "true",
    "allowed_values_or_pattern": "tools/*.py",
    "meaning": "Generator tool path."
  },
  {
    "field": "command",
    "required": "true",
    "allowed_values_or_pattern": "shell command string",
    "meaning": "Reviewable command for regenerating the declared outputs."
  },
  {
    "field": "declared_outputs",
    "required": "true",
    "allowed_values_or_pattern": "pipe-separated package paths",
    "meaning": "Tracked output artifacts declared for the tool."
  },
  {
    "field": "declared_inputs",
    "required": "false",
    "allowed_values_or_pattern": "pipe-separated package paths",
    "meaning": "Named input paths declared in generated-artifact provenance."
  },
  {
    "field": "dependency_status",
    "required": "true",
    "allowed_values_or_pattern": "pass|missing_dependency",
    "meaning": "Pass when all declared tool/output/input paths exist."
  },
  {
    "field": "execution_mode",
    "required": "true",
    "allowed_values_or_pattern": "plan_only_deterministic_order",
    "meaning": "Indicates this report is a plan, not an asynchronous runner."
  },
  {
    "field": "note",
    "required": "false",
    "allowed_values_or_pattern": "free text",
    "meaning": "Human-readable path dependency note."
  }
