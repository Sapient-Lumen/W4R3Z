[
  {
    "field": "identity_check_id",
    "required": "yes",
    "allowed_values_or_pattern": "^package_identity_[0-9]{3}$",
    "meaning": "Stable identity audit row identifier."
  },
  {
    "field": "check",
    "required": "yes",
    "allowed_values_or_pattern": "controlled check name",
    "meaning": "Name of the package identity check."
  },
  {
    "field": "severity",
    "required": "yes",
    "allowed_values_or_pattern": "info|medium|high",
    "meaning": "Severity if the row fails; passing rows are info."
  },
  {
    "field": "status",
    "required": "yes",
    "allowed_values_or_pattern": "pass|fail",
    "meaning": "Check result."
  },
  {
    "field": "expected_value",
    "required": "yes",
    "allowed_values_or_pattern": "free text",
    "meaning": "Expected package identity value."
  },
  {
    "field": "observed_value",
    "required": "yes",
    "allowed_values_or_pattern": "free text",
    "meaning": "Observed package identity value."
  },
  {
    "field": "detail",
    "required": "yes",
    "allowed_values_or_pattern": "free text",
    "meaning": "Explanation of the identity check."
  }
]
