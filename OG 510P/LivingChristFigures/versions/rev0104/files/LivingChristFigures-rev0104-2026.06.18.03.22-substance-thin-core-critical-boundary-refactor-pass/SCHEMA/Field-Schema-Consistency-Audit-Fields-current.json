[
  {
    "field": "finding_id",
    "required": "true",
    "allowed_values_or_pattern": "^fsca_[0-9]{4}$",
    "meaning": "Stable finding identifier emitted by field_schema_consistency.py."
  },
  {
    "field": "severity",
    "required": "true",
    "allowed_values_or_pattern": "info|medium|high",
    "meaning": "Finding severity; high blocks release handoff."
  },
  {
    "field": "check",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Name of field-schema consistency check."
  },
  {
    "field": "file",
    "required": "true",
    "allowed_values_or_pattern": "package-relative path",
    "meaning": "Field schema file or target table being checked."
  },
  {
    "field": "row",
    "required": "true",
    "allowed_values_or_pattern": "integer or 0",
    "meaning": "Row number when applicable; 0 for file-level checks."
  },
  {
    "field": "detail",
    "required": "true",
    "allowed_values_or_pattern": "non-empty string",
    "meaning": "Explanation of the finding or pass row."
  },
  {
    "field": "field_schema_status",
    "required": "true",
    "allowed_values_or_pattern": "pass|schema_only_no_exact_table|missing_companion|header_mismatch|duplicate_field|missing_field|extra_field|invalid_schema",
    "meaning": "Machine-readable status for the field-schema coverage/consistency check."
  }
]
