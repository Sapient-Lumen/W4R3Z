{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cargo-report-pack/v0",
  "required": [
    "pack_id",
    "source_lanes",
    "claim_class",
    "share_posture",
    "authority_basis_ref",
    "authority_path",
    "currentness_ref"
  ],
  "properties": {
    "pack_id": {
      "type": "string"
    },
    "source_lanes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "future-incompat",
          "build-analysis-session",
          "timings-replay",
          "rebuilds-replay",
          "derived-summary",
          "mixed-pack"
        ]
      }
    },
    "claim_class": {
      "type": "string",
      "enum": [
        "single-report",
        "selected-package-slice",
        "selected-target-slice",
        "selected-feature-slice",
        "workspace-default-members",
        "workspace-all-members",
        "all-targets",
        "manual-summary-only"
      ]
    },
    "share_posture": {
      "type": "string",
      "enum": [
        "local-review",
        "support-bundle",
        "issue-attachment",
        "public-example",
        "frozen-public-head"
      ]
    },
    "authority_basis_ref": {
      "type": "string"
    },
    "authority_path": {
      "type": "string",
      "enum": [
        "native-replay-command",
        "direct-native-bytes",
        "copied-native-bytes",
        "copied-rendering",
        "summary-only"
      ]
    },
    "projection_receipt_ref": {
      "type": "string"
    },
    "quarantine_receipt_ref": {
      "type": "string"
    },
    "currentness_ref": {
      "type": "string"
    },
    "import_compat_ref": {
      "type": "string"
    },
    "coverage_summary": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "historical-only-until-rechecked",
          "no-workspace-wide-claim",
          "unstable-lane",
          "projection-present",
          "not-current-active",
          "unstable-build-analysis",
          "projection-receipt-required",
          "not-a-frozen-public-example",
          "basis-lost-demotion",
          "frozen-head-blocked",
          "derived-artifact-only",
          "source-remains-quarantined",
          "non-inference-for-omitted-fields",
          "temporary-waiver-present",
          "waiver-expired-demotion",
          "waiver-required-for-stronger-reuse",
          "execution-receipt-required",
          "lineage-link-required",
          "contradiction-held",
          "competing-heads",
          "manual-arbitration-required",
          "review-request-open",
          "decision-witness-required"
        ]
      }
    },
    "waiver_ledger_ref": {
      "type": "string"
    },
    "execution_receipt_ref": {
      "type": "string"
    },
    "lineage_register_ref": {
      "type": "string"
    },
    "contradiction_packet_ref": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
