{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cargo-report-waiver-ledger/v0",
  "required": [
    "ledger_id",
    "entries"
  ],
  "properties": {
    "ledger_id": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "waiver_id",
          "scope_class",
          "stronger_requested_use",
          "weaker_safe_sentence",
          "owner",
          "reviewer",
          "status"
        ],
        "properties": {
          "waiver_id": {
            "type": "string"
          },
          "scope_class": {
            "type": "string",
            "enum": [
              "coverage-overclaim",
              "projection-share",
              "currentness-carry",
              "compatibility-carry",
              "frozen-head-exception"
            ]
          },
          "stronger_requested_use": {
            "type": "string"
          },
          "weaker_safe_sentence": {
            "type": "string"
          },
          "pack_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "superseded",
              "revoked"
            ]
          },
          "issued_at": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          },
          "superseded_by": {
            "type": "string"
          },
          "demotes_to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
