{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cargo-report-lineage-register/v0",
  "required": [
    "lineage_id",
    "artifacts"
  ],
  "properties": {
    "lineage_id": {
      "type": "string"
    },
    "operational_head_ref": {
      "type": "string"
    },
    "frozen_head_ref": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_ref",
          "artifact_role"
        ],
        "properties": {
          "artifact_ref": {
            "type": "string"
          },
          "artifact_role": {
            "type": "string",
            "enum": [
              "native-import-root",
              "projected-child",
              "quarantined-source",
              "derived-child",
              "promotion-surface",
              "superseded-head",
              "competing-head"
            ]
          },
          "parent_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "child_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "produced_by_receipt_ref": {
            "type": "string"
          },
          "supersedes_ref": {
            "type": "string"
          },
          "superseded_by_ref": {
            "type": "string"
          },
          "no_semantic_backwrite": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "contradiction_packet_ref": {
      "type": "string"
    },
    "head_warning_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "contradiction-held",
          "competing-heads",
          "manual-arbitration-required",
          "expected-head-mismatch",
          "rereview-required"
        ]
      }
    }
  },
  "additionalProperties": false
}
