{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cargo-report-import-compat/v0",
  "required": [
    "compat_id",
    "compatibility_class"
  ],
  "properties": {
    "compat_id": {
      "type": "string"
    },
    "compatibility_class": {
      "type": "string",
      "enum": [
        "reviewed-compatible",
        "schema-drift-review-needed",
        "toolchain-drift-review-needed",
        "decoder-drift-review-needed",
        "basis-missing",
        "incompatible-hold"
      ]
    },
    "decoder_id": {
      "type": "string"
    },
    "reviewed_cargo_family": {
      "type": "string"
    },
    "reviewed_schema_family": {
      "type": "string"
    },
    "allowed_reuse": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "historical-only",
          "bounded-share-with-warning",
          "local-review-only",
          "reimport-required"
        ]
      }
    }
  },
  "additionalProperties": true
}
