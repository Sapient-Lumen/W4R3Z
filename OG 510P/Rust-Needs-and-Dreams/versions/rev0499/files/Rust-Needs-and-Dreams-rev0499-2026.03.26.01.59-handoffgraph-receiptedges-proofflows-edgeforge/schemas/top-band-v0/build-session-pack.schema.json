{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archive:schemas/top-band-v0/build-session-pack",
  "title": "build-session-pack/v0",
  "type": "object",
  "required": [
    "schema_family",
    "specimen_status",
    "contract_codename",
    "capture",
    "stable_imports",
    "experimental_imports",
    "artifact_path_observations",
    "warnings_and_caveats"
  ],
  "properties": {
    "schema_family": {
      "const": "build-session-pack/v0"
    },
    "specimen_status": {
      "type": "string"
    },
    "contract_codename": {
      "type": "string"
    },
    "capture": {
      "type": "object",
      "required": [
        "workspace_root",
        "manifest_path",
        "captured_at_utc",
        "toolchain",
        "cargo_metadata_format_version",
        "command",
        "profile",
        "target_triple"
      ],
      "properties": {
        "workspace_root": {
          "type": "string"
        },
        "manifest_path": {
          "type": "string"
        },
        "captured_at_utc": {
          "type": "string"
        },
        "toolchain": {
          "type": "string"
        },
        "cargo_metadata_format_version": {
          "type": "integer"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "profile": {
          "type": "string"
        },
        "target_triple": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "stable_imports": {
      "type": "object"
    },
    "experimental_imports": {
      "type": "object"
    },
    "artifact_path_observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings_and_caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
