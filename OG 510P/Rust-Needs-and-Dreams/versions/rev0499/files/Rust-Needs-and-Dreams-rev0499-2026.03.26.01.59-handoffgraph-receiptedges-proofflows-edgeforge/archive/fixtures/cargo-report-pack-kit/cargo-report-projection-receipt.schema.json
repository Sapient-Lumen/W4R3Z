{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cargo-report-projection-receipt/v0",
  "required": [
    "projection_id",
    "projection_class",
    "projection_reason",
    "basis_preserved"
  ],
  "properties": {
    "projection_id": {
      "type": "string"
    },
    "projection_class": {
      "type": "string",
      "enum": [
        "verbatim-copy",
        "hashed",
        "coarsened",
        "omitted-fields",
        "summary-derived"
      ]
    },
    "projection_reason": {
      "type": "string",
      "enum": [
        "privacy",
        "portability",
        "share-budget",
        "review-focus"
      ]
    },
    "basis_preserved": {
      "type": "boolean"
    },
    "stronger_reuse_blocked": {
      "type": "boolean"
    },
    "field_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
