{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cargo-report-contradiction-packet/v0",
  "required": [
    "packet_id",
    "contender_refs",
    "conflict_scope_class",
    "precedence_rule",
    "review_queue_status",
    "blocked_stronger_uses"
  ],
  "properties": {
    "packet_id": {
      "type": "string"
    },
    "contender_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2
    },
    "conflict_scope_class": {
      "type": "string",
      "enum": [
        "same-basis-interpretation",
        "same-scope-different-lane",
        "summary-vs-source",
        "competing-operational-heads",
        "currentness-disagreement"
      ]
    },
    "precedence_rule": {
      "type": "string",
      "enum": [
        "native-basis-first",
        "same-scope-native-over-derived",
        "newer-rechecked-over-historical",
        "manual-review-required",
        "no-automatic-winner"
      ]
    },
    "review_queue_status": {
      "type": "string",
      "enum": [
        "pending-review",
        "reviewed-hold",
        "resolved"
      ]
    },
    "winner_ref": {
      "type": "string"
    },
    "unresolved_residue": {
      "type": "string"
    },
    "blocked_stronger_uses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "contradiction-held",
          "competing-heads",
          "manual-arbitration-required"
        ]
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
