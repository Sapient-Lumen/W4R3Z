{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "cargo-report-promotion-receipt/v0",
  "required": [
    "promotion_id",
    "target_posture",
    "claim_class",
    "decision"
  ],
  "properties": {
    "promotion_id": {
      "type": "string"
    },
    "target_posture": {
      "type": "string",
      "enum": [
        "hold",
        "local-review",
        "support-bundle",
        "issue-attachment",
        "public-example",
        "frozen-public-head"
      ]
    },
    "claim_class": {
      "type": "string",
      "enum": [
        "single-report",
        "selected-package-slice",
        "selected-target-slice",
        "selected-feature-slice",
        "workspace-default-members",
        "workspace-all-members",
        "all-targets",
        "manual-summary-only"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "approved-with-warning",
        "hold",
        "rejected"
      ]
    },
    "warning_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "historical-only-until-rechecked",
          "no-workspace-wide-claim",
          "unstable-lane",
          "projection-present",
          "not-current-active",
          "unstable-build-analysis",
          "projection-receipt-required",
          "not-a-frozen-public-example",
          "basis-lost-demotion",
          "frozen-head-blocked",
          "derived-artifact-only",
          "source-remains-quarantined",
          "non-inference-for-omitted-fields",
          "temporary-waiver-present",
          "waiver-expired-demotion",
          "waiver-required-for-stronger-reuse",
          "execution-receipt-required",
          "lineage-link-required",
          "contradiction-held",
          "competing-heads",
          "manual-arbitration-required",
          "review-request-open",
          "decision-witness-required"
        ]
      }
    },
    "frozen_head_allowed": {
      "type": "boolean"
    },
    "waiver_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
