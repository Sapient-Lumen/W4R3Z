{
  "project": "DeathVocab",
  "revision": "rev0012",
  "schema": "deathvocab.witness_role_access_matrix.v2",
  "updated_at": "2026-05-25T06:12:00-04:00",
  "purpose": "Preserve whose record is possible, whose record is structurally excluded, and what each role can and cannot authorize.",
  "roles": [
    {
      "role": "dying_person",
      "records": [
        "DV-REC-000158",
        "DV-REC-000160"
      ],
      "can_often_witness": [
        "felt experience",
        "wish",
        "fear",
        "refusal",
        "meaning",
        "pain or comfort",
        "private desire"
      ],
      "cannot_authorize": [
        "universal dying meaning",
        "what others felt",
        "exact prognosis",
        "legal capacity without context"
      ],
      "needed_protocol": "first-person consent; communication access; no proxy interiority without label"
    },
    {
      "role": "recovered_survivor",
      "records": [
        "DV-REC-000159"
      ],
      "can_often_witness": [
        "recollection",
        "dream/perception",
        "meaning after survival"
      ],
      "cannot_authorize": [
        "what all dying people experience",
        "spiritual proof",
        "experience of non-survivors"
      ],
      "needed_protocol": "self-report framing, nonprophecy gate, trauma-informed consent"
    },
    {
      "role": "family_or_chosen_family",
      "records": [
        "DV-REC-000161",
        "DV-REC-000162",
        "DV-REC-000163",
        "DV-REC-000164",
        "DV-REC-000165"
      ],
      "can_often_witness": [
        "baseline change",
        "household texture",
        "ordinary language",
        "small signs",
        "afterward"
      ],
      "cannot_authorize": [
        "clinical mechanism",
        "official cause/manner",
        "all family meaning"
      ],
      "needed_protocol": "consent, anonymization, hidden relationship and conflict review"
    },
    {
      "role": "hospice_or_palliative_team",
      "records": [
        "DV-REC-000166",
        "DV-REC-000167",
        "DV-REC-000168",
        "DV-REC-000170",
        "DV-REC-000171",
        "DV-REC-000172",
        "DV-REC-000173"
      ],
      "can_often_witness": [
        "pattern recognition",
        "hands-on care",
        "team language",
        "goals",
        "spiritual/psychosocial distress",
        "vigil practice"
      ],
      "cannot_authorize": [
        "private family truth",
        "spiritual meaning",
        "legal advice",
        "exact timing"
      ],
      "needed_protocol": "professional consent, scope labels, employment-safety review"
    },
    {
      "role": "institutional_emergency_official",
      "records": [
        "DV-REC-000169",
        "DV-REC-000178",
        "DV-REC-000179",
        "DV-REC-000180",
        "DV-REC-000181",
        "DV-REC-000182"
      ],
      "can_often_witness": [
        "resuscitation",
        "machines",
        "scene control",
        "official categories",
        "calls",
        "documents"
      ],
      "cannot_authorize": [
        "bedside texture",
        "family truth",
        "political legitimacy",
        "what should have happened"
      ],
      "needed_protocol": "jurisdiction, legal, trauma, and anti-spectacle review"
    },
    {
      "role": "deathcare_afterdeath_worker",
      "records": [
        "DV-REC-000175",
        "DV-REC-000176",
        "DV-REC-000177"
      ],
      "can_often_witness": [
        "body transfer",
        "preparation",
        "viewing",
        "disposition",
        "family logistics"
      ],
      "cannot_authorize": [
        "dying experience",
        "clinical cause",
        "ritual authority"
      ],
      "needed_protocol": "worker dignity, technical-spectacle ban, funeral/legal boundary"
    },
    {
      "role": "child_or_vulnerable_witness",
      "records": [
        "DV-REC-000174"
      ],
      "can_often_witness": [
        "absence",
        "adult emotion",
        "funeral experience",
        "sibling grief",
        "fragmented memory"
      ],
      "cannot_authorize": [
        "adult narrative needs",
        "public sentimental artifact"
      ],
      "needed_protocol": "highest privacy gate and safeguarding review"
    },
    {
      "role": "bystander_finder_or_no_witness",
      "records": [
        "DV-REC-000183",
        "DV-REC-000186"
      ],
      "can_often_witness": [
        "scene discovery",
        "absence",
        "public/private threshold",
        "documents",
        "unknown exact moment"
      ],
      "cannot_authorize": [
        "last words",
        "intention",
        "interior experience"
      ],
      "needed_protocol": "trauma-informed consent and no invented scene"
    }
  ],
  "rule": "Every record should state the witness position it has, the positions it lacks, and the authority boundary for that account."
}
