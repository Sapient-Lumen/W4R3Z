{
  "project": "DeathVocab",
  "revision": "rev0021",
  "schema": "deathvocab.stigma_blame_lexicon.v1",
  "updated_at": "2026-05-26T01:06:00+00:00",
  "purpose": "Track language that can harm suicide-loss and overdose-loss survivors and preserve safer neutral alternatives without enforcing one universal script.",
  "entries": [
    {
      "term_family": "suicide wording",
      "prefer": [
        "died by suicide",
        "took their life when context requires and review allows"
      ],
      "avoid": [
        "criminalizing, sensational, successful/failed, or blame-loaded wording"
      ],
      "record_ids": [
        "DV-REC-000308",
        "DV-REC-000309"
      ]
    },
    {
      "term_family": "single cause",
      "prefer": [
        "complex public-health framing",
        "unknown remains unknown",
        "no single cause"
      ],
      "avoid": [
        "one event caused it",
        "family caused it",
        "one person could have stopped it"
      ],
      "record_ids": [
        "DV-REC-000306"
      ]
    },
    {
      "term_family": "overdose personhood",
      "prefer": [
        "person who died",
        "substance-related death when accurate",
        "overdose death when accurate and non-stigmatizing"
      ],
      "avoid": [
        "reducing the person to drugs, criminality, or toxicology"
      ],
      "record_ids": [
        "DV-REC-000318",
        "DV-REC-000319",
        "DV-REC-000325"
      ]
    },
    {
      "term_family": "official uncertainty",
      "prefer": [
        "pending",
        "undetermined",
        "not yet known",
        "official trace is partial"
      ],
      "avoid": [
        "treating official delay as family failure or moral fact"
      ],
      "record_ids": [
        "DV-REC-000304",
        "DV-REC-000320",
        "DV-REC-000321"
      ]
    }
  ],
  "public_status": "not_enabled"
}
