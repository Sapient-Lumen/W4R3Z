{
  "project": "DeathVocab",
  "revision": "rev0012",
  "schema": "deathvocab.first_person_testimony_gate.v1",
  "updated_at": "2026-05-25T06:12:00-04:00",
  "purpose": "Set the intake boundary for dying-person, survivor, recovered, communication-impaired, child, and high-risk first-person accounts.",
  "gates": [
    {
      "gate": "dying_person_currently_living",
      "requirements": [
        "capacity and consent assessment appropriate to context",
        "right to pause, revise, withdraw",
        "privacy from family pressure",
        "communication support if needed",
        "clinical-risk escalation plan if distress emerges"
      ],
      "public_allowed": false
    },
    {
      "gate": "recovered_survivor_near_death_or_resuscitation",
      "requirements": [
        "self-report label",
        "no spiritual proof framing",
        "trauma-informed consent",
        "distinguish memory, dream, perception, and interpretation",
        "no universalization"
      ],
      "public_allowed": false
    },
    {
      "gate": "communication_impairment",
      "requirements": [
        "do not equate speech loss with absence",
        "document communication method",
        "avoid proxy interiority",
        "verify consent as far as possible",
        "accessibility review"
      ],
      "public_allowed": false
    },
    {
      "gate": "child_or_dependent_person",
      "requirements": [
        "highest privacy gate",
        "guardian consent is not enough by itself",
        "child assent/developmental review where possible",
        "no sensational words/drawings",
        "safeguarding review"
      ],
      "public_allowed": false
    },
    {
      "gate": "suicide_overdose_custody_violence_or_political_death",
      "requirements": [
        "safe-messaging review",
        "legal and trauma review",
        "anti-stigma review",
        "no method detail",
        "no spectacle",
        "no identifying scene detail"
      ],
      "public_allowed": false
    }
  ],
  "global_rule": "First-person material is precious because it is close to experience; that closeness increases rather than decreases the duty of consent and restraint."
}
