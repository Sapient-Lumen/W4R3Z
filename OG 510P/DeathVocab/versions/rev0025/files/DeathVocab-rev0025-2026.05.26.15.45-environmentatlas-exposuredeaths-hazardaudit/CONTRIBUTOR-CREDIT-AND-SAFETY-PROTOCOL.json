{
  "project": "DeathVocab",
  "revision": "rev0012",
  "schema": "deathvocab.contributor_credit_safety_protocol.v1",
  "updated_at": "2026-05-25T06:12:00-04:00",
  "purpose": "Protect contributors whose witness-role knowledge is valuable but professionally, legally, culturally, or relationally sensitive.",
  "credit_modes": [
    "named_credit_after_review",
    "role_only_credit",
    "anonymous_contributor",
    "community_review_only",
    "restricted_internal_use",
    "withdrawn_or_sealed"
  ],
  "risk_checks": [
    "employment retaliation",
    "licensing or regulatory exposure",
    "HIPAA/privacy or local confidentiality limits",
    "family identifiability",
    "child or dependent material",
    "cultural/tradition restriction",
    "suicide/overdose/custody/legal risk",
    "worker trauma and support needs"
  ],
  "contributor_rights": [
    "edit rights",
    "context addition",
    "credit-mode change",
    "withdrawal request",
    "sensitivity escalation",
    "right not to provide a quote",
    "right to submit only role vocabulary"
  ],
  "rule": "The archive should preserve worker and family knowledge without requiring self-exposure as the price of contribution."
}
