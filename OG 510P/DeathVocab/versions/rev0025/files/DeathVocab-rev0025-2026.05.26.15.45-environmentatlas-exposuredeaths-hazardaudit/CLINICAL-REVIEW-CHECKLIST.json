{
  "project": "DeathVocab",
  "revision": "rev0012",
  "schema": "deathvocab.clinical_review_checklist.v1",
  "updated_at": "2026-05-25T06:12:00-04:00",
  "status": "required_before_public_rendering_including_practice_layer",
  "who_may_complete": [
    "experienced hospice/palliative nurse",
    "palliative physician",
    "palliative social worker or chaplain for tone/care-team route portions",
    "funeral/care-after-death professional for after-death body-care records"
  ],
  "who_may_not_complete_alone": [
    "language-model builder",
    "general editor without clinical experience",
    "single social-media anecdote",
    "unreviewed public-source synthesis"
  ],
  "global_checks": [
    {
      "check_id": "CRC-001",
      "question": "Does every clinical-sounding statement have named source support and a source_id?",
      "failure_action": "quarantine_or_rewrite"
    },
    {
      "check_id": "CRC-002",
      "question": "Does the record avoid diagnosing a reader’s situation?",
      "failure_action": "add_boundary_or_remove"
    },
    {
      "check_id": "CRC-003",
      "question": "Does timing language include uncertainty and low-sensitivity caveats where applicable?",
      "failure_action": "downgrade_timing_claim"
    },
    {
      "check_id": "CRC-004",
      "question": "Does the lay surface route distress, new symptoms, medication questions, breathlessness, swallowing, fluids, body handling, or legal questions to qualified local support?",
      "failure_action": "add_interstitial"
    },
    {
      "check_id": "CRC-005",
      "question": "Does the record avoid procedure-level instruction unless explicitly scoped to trained professionals and reviewed?",
      "failure_action": "remove_or_restrict"
    },
    {
      "check_id": "CRC-006",
      "question": "Does the record preserve dignity, skin-tone accuracy, cultural humility, and non-voyeuristic body language?",
      "failure_action": "tone_review_required"
    },
    {
      "check_id": "CRC-007",
      "question": "Does the record avoid implying that the dying person is responsible for family guilt, presence, or absence?",
      "failure_action": "bereavement_tone_review_required"
    },
    {
      "check_id": "CRC-008",
      "question": "Does the record avoid suicide means, pediatric exposure, restricted cultural knowledge, or identifiable private details?",
      "failure_action": "hard_gate_escalation"
    },
    {
      "check_id": "CRC-009",
      "question": "Does decision-language content avoid legal, eligibility, medication, or procedure advice and route to official local sources?",
      "failure_action": "hard_gate_escalation"
    },
    {
      "check_id": "CRC-010",
      "question": "Does code-status language avoid disability bias, ageism, and implication that DNR/DNACPR means no care?",
      "failure_action": "bias_and_nonabandonment_rewrite_required"
    },
    {
      "check_id": "CRC-011",
      "question": "Do ICU, extubation, brain-death, DCD, and organ-donation records preserve role separation and prevent public procedure detail?",
      "failure_action": "restrict_to_internal_or_remove_detail"
    },
    {
      "check_id": "CRC-012",
      "question": "Do VSED/MAID records follow suicide-safe, means-safe, jurisdiction-locked rendering rules?",
      "failure_action": "do_not_publish"
    }
  ],
