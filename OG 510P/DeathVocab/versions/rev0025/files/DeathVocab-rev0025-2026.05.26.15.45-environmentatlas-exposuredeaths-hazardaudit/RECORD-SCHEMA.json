{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deathvocab.record.schema.v2",
  "title": "DeathVocab witnessed-moment record schema",
  "description": "Schema for provenance-bearing witnessed moments. The record preserves the scene before the label, separates observation from interpretation, and makes publication state and safety gates explicit. Rev0006 adds utterance-pattern records as a governed subtype without changing the primary unit. Rev0007 adds decision-language records as a governed subtype without changing the primary unit. Rev0008 adds aftermath/bereavement records for first-days and first-year surfaces, with legal/funeral/grief/child safeguards. Rev0014 audits actual record usage, requires review/links integrity, and replaces the obsolete record_classes enum with a lower_snake_case tag contract so the schema does not overconstrain future ontology work.",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "primary_unit",
    "publication_state",
    "record_classes",
    "title",
    "created_at",
    "source_packet",
    "moment",
    "axes",
    "content_layers",
    "provenance",
    "safety",
    "review",
    "links"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "deathvocab.record.schema.v2"
    },
    "record_id": {
      "type": "string",
      "pattern": "^DV-REC-[0-9]{6}$"
    },
    "primary_unit": {
      "const": "witnessed_moment"
    },
    "publication_state": {
      "type": "string",
      "enum": [
        "seed_prompt",
        "private_intake",
        "quarantined_public_source_pilot",
        "quarantined_contributor_draft",
        "reviewed_internal",
        "consented_public",
        "public_low_risk_source",
        "restricted_room",
        "withdrawn",
        "retracted"
      ]
    },
    "record_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "uniqueItems": true
    },
    "title": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "source_packet": {
      "type": "object",
      "required": [
        "source_ids",
        "source_basis",
        "collection_method",
        "consent_state",
        "source_ladder_level",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "source_basis": {
          "type": "string"
        },
        "collection_method": {
          "type": "string"
        },
        "consent_state": {
          "type": "string",
          "minLength": 1,
          "description": "Consent/provenance state. Specific values are governed by CONSENT-WORKFLOW.json; exploratory records may use precise compound states."
        },
        "source_ladder_level": {
          "type": "string",
          "minLength": 1,
          "description": "Source ladder or compound ladder descriptor. Canonical ladder is in SOURCE-LADDER.json; mixed public/professional/tradition records may use compound descriptors while quarantined."
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "moment": {
      "type": "object",
      "required": [
        "plain_scene",
        "bounded_time",
        "witness_position",
        "sensory_channels",
        "ordinary_language_queries",
        "professional_terms"
      ],
      "additionalProperties": false,
      "properties": {
        "plain_scene": {
          "type": "string"
        },
        "bounded_time": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "witness_position": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sensory_channels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "ordinary_language_queries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "professional_terms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "cultural_or_institutional_frame": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "axes": {
      "type": "object"
    },
    "content_layers": {
      "type": "object",
      "required": [
        "observation_text",
        "source_synthesis",
        "interpretation",
        "what_this_is_not",
        "uncertainties",
        "lay_orientation",
        "practitioner_notes"
      ],
      "additionalProperties": false,
      "properties": {
        "observation_text": {
          "type": "string"
        },
        "source_synthesis": {
          "type": "string"
        },
        "interpretation": {
          "type": "object"
        },
        "what_this_is_not": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lay_orientation": {
          "type": "string"
        },
        "practitioner_notes": {
          "type": "string"
        },
        "language_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "safety": {
      "type": "object"
    },
    "review": {
      "type": "object",
      "description": "Review gate state. The exact keys may vary by record family, but every record must carry a review object before public rendering."
    },
    "links": {
      "type": "object",
      "description": "Crosswalk links for glossary, search aliases, seed cues, and related records. Generated links are scaffolds, not final semantic edges."
    }
  },
  "revision": "rev0014",
  "updated_at": "2026-05-25T14:59:00-04:00",
  "class_taxonomy": "CLASS-TAXONOMY.json",
  "rev0014_schema_validation_note": "Rev0014 relaxed source_packet enum fields because actual quarantined records already use precise mixed ladder/consent descriptors. Integrity is checked by lint and source cards; ontology remains provisional.",
  "rev0014_language_notes_normalization": "Twenty tradition records had language_notes as a string; rev0014 normalized them to one-item arrays rather than broadening the schema."
}
