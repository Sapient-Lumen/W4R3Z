{
  "project": "DeathVocab",
  "revision": "rev0012",
  "schema": "deathvocab.body_access_and_control_ledger.v1",
  "updated_at": "2026-05-25T06:12:00-04:00",
  "purpose": "Track who may see, touch, move, certify, investigate, prepare, bury, cremate, or withhold access to the body across settings.",
  "access_states": [
    {
      "state": "family_present_and_may_touch",
      "settings": [
        "home",
        "hospice_facility",
        "some_hospital_rooms",
        "some_funeral_home_viewings"
      ],
      "risks": [
        "overgeneralizing to jurisdictions/facilities where rules differ"
      ]
    },
    {
      "state": "family_present_but_touch_or_movement_restricted",
      "settings": [
        "icu",
        "ed",
        "isolation",
        "some cultural/legal contexts"
      ],
      "risks": [
        "rendering restriction as cruelty without context or rendering restriction as unquestionable"
      ]
    },
    {
      "state": "family_absent_or_late",
      "settings": [
        "unwitnessed_home",
        "custody",
        "street",
        "disaster",
        "war",
        "pandemic_restriction"
      ],
      "risks": [
        "assuming no love, no community, or no grief"
      ]
    },
    {
      "state": "official_or_medicolegal_control",
      "settings": [
        "coroner",
        "medical_examiner",
        "morgue",
        "custody",
        "suspicious_or_unexpected_death"
      ],
      "risks": [
        "legal advice, official-account laundering, family exclusion"
      ]
    },
    {
      "state": "funeral_or_disposition_worker_control",
      "settings": [
        "funeral_home",
        "crematory",
        "cemetery",
        "green_burial_site"
      ],
      "risks": [
        "technical spectacle, worker invisibility, consumer advice"
      ]
    },
    {
      "state": "body_absent_or_unrecovered",
      "settings": [
        "sea",
        "fire",
        "wilderness",
        "war",
        "disaster",
        "missing_person"
      ],
      "risks": [
        "forced closure, speculation, legal status confused with grief status"
      ]
    }
  ],
  "review_rule": "Body-access language is always setting- and jurisdiction-bound."
}
