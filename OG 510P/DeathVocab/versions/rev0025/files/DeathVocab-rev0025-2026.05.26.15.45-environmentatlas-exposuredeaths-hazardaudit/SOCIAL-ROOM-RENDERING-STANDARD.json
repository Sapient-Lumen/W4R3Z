{
  "project": "DeathVocab",
  "revision": "rev0018",
  "schema": "deathvocab.social_room_rendering_standard.v1",
  "updated_at": "2026-05-25T17:24:00-04:00",
  "style": "precise, kind, unsentimental, specific, non-voyeuristic",
  "required_separations": [
    "what was witnessed",
    "who reported it",
    "which role/perspective it came from",
    "what the source can support",
    "what cannot be concluded",
    "what review is still needed"
  ],
  "forbidden_moves": [
    "turning family conflict into entertainment",
    "assigning blame from insufficient context",
    "publishing identifiable living-family details",
    "claiming legal/facility authority",
    "using the cube as mediation, therapy, or safeguarding advice",
    "using conflict to aestheticize “good” hospice families versus “bad” families"
  ]
}
