{
  "project": "DeathVocab",
  "revision": "rev0015",
  "schema": "deathvocab.source_acquisition_triage_matrix.v1",
  "updated_at": "2026-05-25T15:22:00-04:00",
  "purpose": "Decide what kinds of sources may enter, be held, or be rejected before future operators mine vulnerable material.",
  "rules": [
    {
      "source_class": "official_public_family_facing_or_professional_source",
      "default_action": "admit_as_public_source_card_or_pilot_support",
      "conditions": [
        "source identified",
        "scope stated",
        "not treated as bedside testimony"
      ]
    },
    {
      "source_class": "consented_adult_practitioner_interview",
      "default_action": "eligible_after_fieldwork_phase_03",
      "conditions": [
        "no patient identifiers",
        "role/employer risk review",
        "transcript review",
        "consent state sufficient"
      ]
    },
    {
      "source_class": "consented_adult_family_witness_interview",
      "default_action": "hold_until_advisory_review",
      "conditions": [
        "not fresh grief",
        "distress protocol",
        "family-identification review",
        "contributor review"
      ]
    },
    {
      "source_class": "public_social_media_post",
      "default_action": "hold_or_reject",
      "conditions": [
        "public visibility is not consent",
        "may be used only as search cue unless explicit permission obtained"
      ]
    },
    {
      "source_class": "reddit_or_forum_grief_post",
      "default_action": "reject_as_testimony_without_direct_permission",
      "conditions": [
        "do not quote or paraphrase vulnerable posts into corpus records"
      ]
    },
    {
      "source_class": "memorial_site_guestbook_or_obituary",
      "default_action": "source_literary_genre_only_not_private_testimony",
      "conditions": [
        "use for genre vocabulary only with public-source caution; avoid extracting private grief"
      ]
    },
    {
      "source_class": "caregiver_diary_or_caringbridge",
      "default_action": "reject_or_hold_for_direct_permission",
      "conditions": [
        "public link is not consent; third-party identifiers likely"
      ]
    },
    {
      "source_class": "children_words_drawings_or_pediatric_family_story",
      "default_action": "block_highest_gate",
      "conditions": [
        "specialist review",
        "family protection",
        "likely nonpublication"
      ]
    },
    {
      "source_class": "suicide_loss_account",
      "default_action": "block_high_gate_for_story_collection",
      "conditions": [
        "safe messaging review",
        "no means/method",
        "postvention expertise",
        "no fresh grief cold contact"
      ]
    },
    {
      "source_class": "custody_death_or_active_inquest_material",
      "default_action": "block_or_official_public_only",
      "conditions": [
        "legal/investigative risk",
        "family safety",
        "institutional opacity"
      ]
    },
    {
      "source_class": "restricted_cultural_or_indigenous_material",
      "default_action": "community_controlled_or_reject",
      "conditions": [
        "authorized holder terms",
        "refusal respected"
      ]
    },
    {
      "source_class": "body_images_audio_911_calls_or_video",
      "default_action": "reject_for_archive_zip",
      "conditions": [
        "extreme dignity/privacy risk",
        "possible official/legal custody",
        "spectacle risk"
      ]
    }
  ]
}
