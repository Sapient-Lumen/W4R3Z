{
  "project": "DeathVocab",
  "revision": "rev0012",
  "schema": "deathvocab.surface_rendering_rules.v1",
  "updated_at": "2026-05-25T06:12:00-04:00",
  "surfaces": [
    {
      "surface_id": "lay_witness",
      "reader_state": "often frightened, bereaved, searching from ordinary language",
      "must_show": [
        "plain scene",
        "what records connect",
        "what this does not mean",
        "when to contact local care team",
        "source/review state"
      ],
      "must_not_show": [
        "medication instructions",
        "prediction claims",
        "graphic detail beyond purpose",
        "false reassurance"
      ]
    },
    {
      "surface_id": "practitioner_apprenticeship",
      "reader_state": "learning role-specific craft and language",
      "must_show": [
        "role perspective",
        "practice questions",
        "terms",
        "uncertainty",
        "what experienced workers monitor or explain"
      ],
      "must_not_show": [
        "replace local protocols",
        "patient-identifying anecdote",
        "unreviewed advice"
      ]
    },
    {
      "surface_id": "provenance_research",
      "reader_state": "checking source, stability, limitations, contradictions",
      "must_show": [
        "source packet",
        "review state",
        "evidence debts",
        "related/contrasting records",
        "rollback dependencies"
      ],
      "must_not_show": [
        "private consent details",
        "restricted cultural detail",
        "identifying contributor metadata"
      ]
    },
    {
      "surface_id": "tradition_governed_room",
      "reader_state": "permissioned or scoped by community authority",
      "must_show": [
        "scope of permission",
        "authorized voice",
        "what is intentionally withheld"
      ],
      "must_not_show": [
        "outsider reconstruction",
        "restricted procedures",
        "pan-cultural flattening"
      ]
    }
  ]
}
