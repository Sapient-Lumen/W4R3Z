  "purpose": "Specify the review needed before any tradition-axis material can leave quarantine.",
  "reviewer_profiles_needed": [
    {
      "profile": "tradition or community holder",
      "reviews": [
        "accuracy",
        "non-disclosure boundaries",
        "offense or flattening risk",
        "variant names and spellings"
      ]
    },
    {
      "profile": "pastoral/spiritual care practitioner where relevant",
      "reviews": [
        "bedside fit",
        "institutional coordination",
        "family preference language"
      ]
    },
    {
      "profile": "funeral/disposition professional",
      "reviews": [
        "body release, transport, cremation, burial, cemetery, and local-law boundaries"
      ]
    },
    {
      "profile": "cultural safety or anti-appropriation reviewer",
      "reviews": [
        "extraction risk",
        "outsider gaze",
        "commercialization risk"
      ]
    },
    {
      "profile": "plain-language reviewer",
      "reviews": [
        "panic-search readability without turning into instructions"
      ]
    }
  ],
  "minimum_publication_bar": [
    "named review complete",
    "variant practice noted",
    "no how-to steps",
    "no restricted material",
    "family/local-law authority surfaced",
    "source cards complete"
