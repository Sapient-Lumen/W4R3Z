{
  "project": "DeathVocab",
  "revision": "rev0012",
  "schema": "deathvocab.publication_gate_matrix.v1",
  "updated_at": "2026-05-25T06:12:00-04:00",
  "rules": [
    {
      "domain": "low_risk_public_source",
      "default_state": "quarantined_public_source_pilot",
      "required_before_public": [
        "source review",
        "copyright/quotation check",
        "clinical safety review if medical",
        "plain-language non-advice boundary"
      ]
    },
    {
      "domain": "family_witness",
      "default_state": "private_intake",
      "required_before_public": [
        "explicit consent",
        "de-identification review",
        "family-impact review",
        "edit/withdrawal path",
        "ethics review"
      ]
    },
    {
      "domain": "professional_witness",
      "default_state": "private_intake",
      "required_before_public": [
        "explicit consent",
        "patient de-identification",
        "institutional risk screen",
        "role/context review",
        "ethics review"
      ]
    },
    {
      "domain": "dying_person_words",
      "default_state": "private_intake",
      "required_before_public": [
        "voluntariness/capacity context",
        "quotation permission",
        "posthumous stewardship choice",
        "family-impact review"
      ]
    },
    {
      "domain": "pediatric_or_perinatal",
      "default_state": "private_or_restricted",
      "required_before_public": [
        "highest gate",
        "reason-to-publish memo",
        "guardian/family permission where appropriate",
        "child/sibling harm review",
        "usually no public quotation"
      ]
    },
    {
      "domain": "suicide_or_self_harm",
      "default_state": "private_or_restricted",
      "required_before_public": [
        "safe-messaging review",
        "no means details",
        "no romanticization",
        "survivor-support framing",
        "crisis-safety boundary"
      ]
    },
    {
      "domain": "tradition_governed",
      "default_state": "restricted_room",
      "required_before_public": [
        "authorized holder permission",
        "scope-of-detail agreement",
        "cultural review",
        "right to remove"
      ]
    },
    {
      "domain": "custody_institutional_or_political",
      "default_state": "restricted_or_reviewed_internal",
      "required_before_public": [
        "retaliation risk review",
        "legal/context review",
        "witness protection",
        "do not launder institutional opacity"
      ]
    },
    {
      "domain": "graphic_or_voyeurism_risk",
      "default_state": "quarantined",
      "required_before_public": [
        "reason-to-include memo",
        "reader-benefit test",
        "detail minimization",
        "ethics review"
      ]
    },
    {
      "domain": "utterance_or_last_words",
      "default_state": "quarantined_public_source_pilot_or_private_intake",
      "required_before_public": [
        "exactness label: verbatim/paraphrase/translation/search phrase",
        "quotation permission if private",
        "last-words myth review",
        "clinical/delirium boundary if relevant",
        "cultural/spiritual interpretation boundary",
        "bereavement tone review",
        "noncoercion review for scripts"
      ]
    }
  ]
}
