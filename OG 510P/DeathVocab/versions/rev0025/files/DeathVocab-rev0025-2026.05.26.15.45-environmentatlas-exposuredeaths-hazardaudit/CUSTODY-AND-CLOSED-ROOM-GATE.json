{
  "project": "DeathVocab",
  "revision": "rev0023",
  "schema": "deathvocab.custody_closed_room_gate.v1",
  "updated_at": "2026-05-26T04:21:00+00:00",
  "hard_rule": "The cube may document that a closed institution controls witness access, body access, notification, records, review, and vocabulary; it may not infer culpability or completeness from that fact.",
  "blocked_public_moves": [
    "facility ranking",
    "case accusation",
    "investigation advice",
    "complaint route advice",
    "legal standard explanation as advice",
    "public names or dates",
    "video/log quotation",
    "medical causation claim",
    "negligence or exoneration claim"
  ],
  "required_reviews": [
    "institutional_opacity_review",
    "official_trace_review",
    "legal_or_jurisdiction_review",
    "privacy_review",
    "ethics_review",
    "equity_review",
    "clinical_review_if_medical_or_psychiatric_language",
    "postvention_review_if_suicide_or_overdose_language",
    "publication_language_review"
  ],
  "allowed_internal_moves": [
    "name vocabulary",
    "route to review packets",
    "separate source classes",
    "mark evidence limits",
    "ledger absence and access gaps",
    "preserve personhood against data flattening"
  ]
}
