{
  "project": "DeathVocab",
  "revision": "rev0012",
  "schema": "deathvocab.account_authority_matrix.v1",
  "updated_at": "2026-05-25T06:12:00-04:00",
  "purpose": "Prevent witness-role overclaim by recording what each account type is strong for, weak for, and forbidden to settle.",
  "rows": [
    {
      "account_type": "first_person_dying_person",
      "strong_for": [
        "stated wishes",
        "felt experience",
        "fear",
        "refusal",
        "meaning in their own words"
      ],
      "weak_for": [
        "exact prognosis",
        "clinical diagnosis",
        "how others felt"
      ],
      "must_not_settle": [
        "legal capacity without review",
        "family disputes",
        "universal dying experience"
      ]
    },
    {
      "account_type": "recovered_survivor",
      "strong_for": [
        "retrospective first-person recollection",
        "survivor meaning-making"
      ],
      "weak_for": [
        "what non-survivors experienced",
        "afterlife proof",
        "clinical universality"
      ],
      "must_not_settle": [
        "spiritual proof",
        "what another dying person experienced"
      ]
    },
    {
      "account_type": "family_or_chosen_family",
      "strong_for": [
        "baseline body knowledge",
        "room texture",
        "language",
        "small changes",
        "aftermath"
      ],
      "weak_for": [
        "clinical mechanism",
        "official cause/manner",
        "another person’s interior experience"
      ],
      "must_not_settle": [
        "blame",
        "eligibility",
        "timing",
        "legal authority"
      ]
    },
    {
      "account_type": "professional_care_team",
      "strong_for": [
        "pattern recognition",
        "care language",
        "setting-specific practice",
        "team handoffs"
      ],
      "weak_for": [
        "private family history",
        "interior meaning",
        "unwitnessed home details"
      ],
      "must_not_settle": [
        "the whole story",
        "spiritual meaning",
        "family moral judgment"
      ]
    },
    {
      "account_type": "official_investigative_record",
      "strong_for": [
        "cause/manner categories",
        "jurisdictional process",
        "scene documentation",
        "identity chain"
      ],
      "weak_for": [
        "bedside feel",
        "relationship truth",
        "grief texture"
      ],
      "must_not_settle": [
        "family meaning",
        "political legitimacy",
        "personhood"
      ]
    },
    {
      "account_type": "deathcare_worker",
      "strong_for": [
        "after-death body care",
        "preparation",
        "disposition labor",
        "family logistics"
      ],
      "weak_for": [
        "dying phase",
        "clinical cause",
        "family interiority"
      ],
      "must_not_settle": [
        "funeral purchasing advice",
        "technical spectacle",
        "ritual authority"
      ]
    },
    {
      "account_type": "absence_or_document_trace",
      "strong_for": [
        "what cannot be known",
        "official chain",
        "body or scene facts",
        "documentation gaps"
      ],
      "weak_for": [
        "last words",
        "felt experience",
        "exact moment"
      ],
      "must_not_settle": [
        "imagined scene",
        "unwitnessed intention",
        "blame without evidence"
      ]
    }
  ],
  "global_rule": "An account may be valuable because it is partial. The archive should preserve the partiality rather than repair it with inference."
}
