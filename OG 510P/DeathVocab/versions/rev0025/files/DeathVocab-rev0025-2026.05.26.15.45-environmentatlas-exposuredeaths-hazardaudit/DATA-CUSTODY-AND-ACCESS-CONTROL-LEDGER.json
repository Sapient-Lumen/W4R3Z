{
  "project": "DeathVocab",
  "revision": "rev0015",
  "schema": "deathvocab.data_custody_and_access_control_ledger.v1",
  "updated_at": "2026-05-25T15:22:00-04:00",
  "purpose": "Separate public revision artifacts from protected testimony materials.",
  "hard_rule": "Public zip revisions do not contain raw private audio, raw private transcripts, contact details, consent signatures, or identifying testimony casefiles.",
  "material_classes": [
    {
      "class": "public_source_cards",
      "may_enter_zip": true,
      "conditions": "public URL/source metadata only"
    },
    {
      "class": "fieldwork_protocols",
      "may_enter_zip": true,
      "conditions": "no private story content"
    },
    {
      "class": "consent_receipts",
      "may_enter_zip": false,
      "conditions": "store in protected administrative system"
    },
    {
      "class": "raw_audio_video",
      "may_enter_zip": false,
      "conditions": "protected custody only; avoid collecting unless needed"
    },
    {
      "class": "raw_transcript",
      "may_enter_zip": false,
      "conditions": "protected custody; contributor review required"
    },
    {
      "class": "deidentified_excerpt_candidate",
      "may_enter_zip": "only_after_review",
      "conditions": "quote/paraphrase gate, contributor release, deidentification"
    },
    {
      "class": "testimony_backed_public_record",
      "may_enter_zip": "only_after_publication_gate",
      "conditions": "all review and rollback paths complete"
    }
  ],
  "access_roles": [
    {
      "role": "interviewer",
      "access": "only assigned casefiles"
    },
    {
      "role": "fieldwork_editor",
      "access": "casefiles after consent and need-to-know"
    },
    {
      "role": "ethics_reviewer",
      "access": "risk summaries first; raw material only if needed"
    },
    {
      "role": "clinical_or_role_reviewer",
      "access": "deidentified excerpts by default"
    },
    {
      "role": "tradition_holder_reviewer",
      "access": "community-controlled according to agreed terms"
    },
    {
      "role": "public_reader",
      "access": "only released surfaces"
    }
  ],
  "retention_questions_not_yet_answered": [
    "How long should raw recordings be held after deidentified records are created?",
    "Can contributors request destruction while allowing a paraphrased record to remain?",
    "Who has authority after contributor death?",
    "What repository, if any, can enforce restrictions over decades?"
  ]
}
