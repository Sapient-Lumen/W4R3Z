{
  "project": "DeathVocab",
  "revision": "rev0012",
  "schema": "deathvocab.political_opaque_death_gate.v2",
  "updated_at": "2026-05-25T06:12:00-04:00",
  "purpose": "Prevent the cube from flattening deaths that are hidden, contested, stigmatized, investigated, institutional, or politically produced.",
  "domains": [
    {
      "domain": "suicide",
      "record_ids": [
        "DV-REC-000144"
      ],
      "hard_rules": [
        "no method detail",
        "no romanticization",
        "no speculation about why",
        "include support/crisis routing where public-facing"
      ],
      "minimum_review": [
        "suicide safe-messaging",
        "postvention",
        "bereavement",
        "trauma"
      ]
    },
    {
      "domain": "overdose",
      "record_ids": [
        "DV-REC-000143"
      ],
      "hard_rules": [
        "no dose/substance/paraphernalia detail",
        "stigma-sensitive language",
        "do not collapse into suicide without evidence",
        "do not moralize"
      ],
      "minimum_review": [
        "harm reduction",
        "substance-use",
        "safe-messaging",
        "bereavement"
      ]
    },
    {
      "domain": "custody or detention",
      "record_ids": [
        "DV-REC-000141"
      ],
      "hard_rules": [
        "do not launder official accounts as complete",
        "do not provide legal advice",
        "do not identify families/institutions without consent and review"
      ],
      "minimum_review": [
        "legal",
        "carceral-health",
        "racial-justice",
        "family-consent"
      ]
    },
    {
      "domain": "unhoused or unclaimed",
      "record_ids": [
        "DV-REC-000142"
      ],
      "hard_rules": [
        "no poverty spectacle",
        "do not imply no kin or no community",
        "treat naming and memorialization as dignity issues"
      ],
      "minimum_review": [
        "homeless-health",
        "outreach/peer review",
        "medical examiner/funeral boundary"
      ]
    },
    {
      "domain": "mass fatality/disaster/war",
      "record_ids": [
        "DV-REC-000146",
        "DV-REC-000147"
      ],
      "hard_rules": [
        "no image spectacle",
        "no operational instructions",
        "no public-health myth amplification"
      ],
      "minimum_review": [
        "humanitarian",
        "public health",
        "disaster victim identification",
        "trauma"
      ]
    },
    {
      "domain": "unrecovered body or missing person",
      "record_ids": [
        "DV-REC-000148"
      ],
      "hard_rules": [
        "do not force closure",
        "separate legal status from grief status",
        "do not speculate"
      ],
      "minimum_review": [
        "ambiguous loss",
        "legal-boundary",
        "missing-person/family assistance"
      ]
    },
    {
      "domain": "pediatric, stillbirth, neonatal, and maternal death",
      "record_ids": [
        "DV-REC-000149",
        "DV-REC-000150",
        "DV-REC-000151"
      ],
      "hard_rules": [
        "highest child/family privacy",
        "no images/footprints/quotes without explicit consent and review",
        "family relationship words are not overwritten"
      ],
      "minimum_review": [
        "perinatal",
        "pediatric palliative",
        "obstetric",
        "child-life",
        "consent"
      ]
    }
  ],
  "nonclaims": [
    "not an investigative body",
    "not a legal-advocacy substitute",
    "not a clinical guideline",
    "not a trauma-content anthology",
    "not a public database of cases"
  ]
}
