{
  "project": "DeathVocab",
  "revision": "rev0012",
  "schema": "deathvocab.mortality_data_boundary_matrix.v1",
  "updated_at": "2026-05-25T06:12:00-04:00",
  "purpose": "Define what mortality, public-health, justice, and disaster data can and cannot do inside an observational bedside corpus.",
  "can_do": [
    "identify neglected trajectory and setting lanes",
    "anchor vocabulary used by institutions and public systems",
    "show that a death category is publicly recognized or counted",
    "help select specialist reviewers",
    "guard against claiming novelty where a category is already named"
  ],
  "cannot_do": [
    "supply sensory, phenomenological, or family-language texture",
    "prove what happened in a specific death",
    "replace consented witness testimony",
    "resolve contested official accounts",
    "authorize public publication of private grief or child material"
  ],
  "source_type_rules": [
    {
      "source_type": "public_health_statistics",
      "usable_for": [
        "coverage gaps",
        "terminology",
        "scale context"
      ],
      "not_usable_for": [
        "bedside scenes",
        "cause-specific advice"
      ]
    },
    {
      "source_type": "professional_guidance",
      "usable_for": [
        "review gates",
        "clinical boundary language",
        "terms clinicians use"
      ],
      "not_usable_for": [
        "public how-to instructions"
      ]
    },
    {
      "source_type": "family_support_page",
      "usable_for": [
        "lay phrasing",
        "common questions",
        "nonclaims"
      ],
      "not_usable_for": [
        "universal practice or outcomes"
      ]
    },
    {
      "source_type": "humanitarian/disaster guidance",
      "usable_for": [
        "dignity, identification, family assistance terms"
      ],
      "not_usable_for": [
        "operational instructions or graphic details"
      ]
    },
    {
      "source_type": "legal/regulatory/jurisdiction page",
      "usable_for": [
        "jurisdiction-specific vocabulary"
      ],
      "not_usable_for": [
        "legal advice or universal procedure"
      ]
    }
  ]
}
