{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rubygem-native-shipkit/release.receipt.schema.json",
  "title": "RubyGem Native ShipKit Release Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "gem_name",
    "ruby_engines",
    "platform_artifacts",
    "support_verdict"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "gem_name": {"type": "string"},
    "ruby_engines": {
      "type": "array",
      "items": {"type": "string"}
    },
    "platform_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "artifact_name"],
        "properties": {
          "platform": {"type": "string"},
          "artifact_name": {"type": "string"},
          "ruby_version_floor": {"type": "string"},
          "digest": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "support_verdict": {
      "type": "string",
      "enum": [
        "platform_contract_ok",
        "fat_gem_gap",
        "gemspec_platform_mismatch",
        "bundler_story_exceeds_artifacts",
        "source_build_only",
        "publish_identity_review_required",
        "manual_review_required"
      ]
    }
  },
  "additionalProperties": true
}
