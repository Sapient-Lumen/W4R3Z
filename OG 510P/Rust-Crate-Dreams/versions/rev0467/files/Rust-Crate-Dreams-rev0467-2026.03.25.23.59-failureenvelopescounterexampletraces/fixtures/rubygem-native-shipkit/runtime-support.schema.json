{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/rubygem-native-shipkit/runtime-support.schema.json",
  "title": "RubygemNativeSupportBundle",
  "type": "object",
  "required": ["gem_name", "support_class", "artifacts"],
  "properties": {
    "gem_name": {"type": "string"},
    "support_class": {
      "type": "string",
      "enum": [
        "platform_contract_ok",
        "fat_gem_gap",
        "source_build_only",
        "ruby_engine_claim_exceeds_artifacts",
        "gemspec_platform_mismatch",
        "publish_identity_review_required",
        "manual_review_required"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "platform"],
        "properties": {
          "name": {"type": "string"},
          "platform": {"type": "string"},
          "ruby_implementation": {"type": "string"},
          "target": {"type": "string"}
        }
      }
    }
  }
}
