{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rubygem-native-shipkit/resolver-route.report.schema.json",
  "title": "RubyGem Resolver Route Report",
  "type": "object",
  "required": [
    "schema_version",
    "gem_name",
    "route_class",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "gem_name": {
      "type": "string"
    },
    "route_class": {
      "type": "string",
      "enum": [
        "resolver_route_ok",
        "resolver_route_review_required",
        "ruby_engine_claim_exceeds_route",
        "manual_review_required"
      ]
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "consumer",
          "expected_route"
        ],
        "properties": {
          "consumer": {
            "type": "string"
          },
          "expected_route": {
            "type": "string",
            "enum": [
              "binary_gem",
              "source_build",
              "pure_ruby_fallback",
              "manual_review"
            ]
          },
          "gemfile_platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lockfile_platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
