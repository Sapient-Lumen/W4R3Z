{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rubygem-native-shipkit/platform-coverage.report.schema.json",
  "title": "RubyGem Platform Coverage Report",
  "type": "object",
  "required": [
    "schema_version",
    "gem_name",
    "coverage_class",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "gem_name": {
      "type": "string"
    },
    "coverage_class": {
      "type": "string",
      "enum": [
        "platform_contract_ok",
        "fat_gem_gap",
        "source_build_only",
        "manual_review_required"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gem_platform",
          "artifact_name",
          "delivery_mode"
        ],
        "properties": {
          "gem_platform": {
            "type": "string"
          },
          "artifact_name": {
            "type": "string"
          },
          "delivery_mode": {
            "type": "string",
            "enum": [
              "binary_gem",
              "source_build",
              "hybrid"
            ]
          },
          "target_triple": {
            "type": "string"
          },
          "ruby_family": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
