{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "health-source.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "startup_readiness_basis",
    "health_basis",
    "unresponsive_action"
  ],
  "properties": {
    "artifact": {"const": "health-source.receipt"},
    "subject": {"type": "string"},
    "startup_readiness_basis": {
      "enum": ["startup_fn_returns_stable_state", "child_signals_ready", "first_successful_iteration", "none", "manual_review_required"]
    },
    "health_basis": {
      "enum": ["panic_exit_only", "heartbeat_deadline", "external_probe", "mixed", "manual_review_required"]
    },
    "probe_scope": {
      "enum": ["child_loop", "dependency_resource", "external_endpoint", "mixed", "none", "manual_review_required"]
    },
    "unresponsive_action": {
      "enum": ["restart_child", "restart_group", "mark_unhealthy_only", "escalate_supervisor", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
