{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "state-reset.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "restart_state_source",
    "mutation_retention",
    "reset_visibility"
  ],
  "properties": {
    "artifact": {"const": "state-reset.receipt"},
    "subject": {"type": "string"},
    "restart_state_source": {
      "enum": ["clone_from_template", "fresh_factory", "external_shared_state", "persisted_rehydrate", "mixed", "manual_review_required"]
    },
    "mutation_retention": {
      "enum": ["never", "shared_arc_only", "selected_fields", "persisted_only", "mixed", "manual_review_required"]
    },
    "reset_visibility": {
      "enum": ["explicit_receipt", "implicit_by_clone", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
