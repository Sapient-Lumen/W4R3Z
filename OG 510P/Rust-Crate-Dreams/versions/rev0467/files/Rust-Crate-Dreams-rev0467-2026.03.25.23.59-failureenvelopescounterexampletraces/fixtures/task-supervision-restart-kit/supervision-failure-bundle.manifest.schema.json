{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "supervision-failure-bundle.manifest",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "bundle_kind",
    "attached_receipts",
    "redaction_posture"
  ],
  "properties": {
    "artifact": {"const": "supervision-failure-bundle.manifest"},
    "subject": {"type": "string"},
    "bundle_kind": {
      "enum": ["restart_storm", "hung_task", "startup_failure", "abnormal_exit", "mixed", "manual_review_required"]
    },
    "attached_receipts": {"type": "array", "items": {"type": "string"}},
    "attachments": {"type": "array", "items": {"type": "string"}},
    "redaction_posture": {
      "enum": ["none", "safe_support_share", "internal_only", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
