{
  "package_name": "@acme/vectorize",
  "route_class": "node_addons_with_default_wasm_fallback",
  "routes": [
    {
      "condition": "node-addons",
      "action": "load_native_prebuild",
      "artifact_pattern": "vectorize.{platform}-{arch}.node",
      "notes": "Preferred route for Node.js with native addons enabled"
    },
    {
      "condition": "default",
      "action": "load_wasm_bundle",
      "artifact_pattern": "vectorize_bg.wasm",
      "notes": "Universal fallback when addons are disabled or unavailable"
    }
  ],
  "loader_name_alignment": "aligned"
}
