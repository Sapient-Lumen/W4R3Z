{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/node-api-package-prebuild-contract-kit/prebuild-coverage.report.schema.json",
  "title": "NodeApiPrebuildCoverageReport",
  "type": "object",
  "required": ["package_name", "coverage_class", "declared_tuples", "shipped_prebuilds"],
  "properties": {
    "package_name": {"type": "string"},
    "coverage_class": {
      "type": "string",
      "enum": [
        "fully_prebuilt",
        "partial_prebuild_matrix",
        "native_gap_hidden_by_local_build",
        "wasm_only_fallback_for_named_tuple",
        "manual_review_required"
      ]
    },
    "declared_tuples": {
      "type": "array",
      "items": {"type": "string"}
    },
    "shipped_prebuilds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["runtime", "target", "artifact_name"],
        "properties": {
          "runtime": {"type": "string"},
          "target": {"type": "string"},
          "artifact_name": {"type": "string"},
          "libc": {"type": "string", "enum": ["gnu", "musl", "msvc", "darwin", "unknown"]}
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "reason"],
        "properties": {
          "target": {"type": "string"},
          "reason": {"type": "string"},
          "fallback": {"type": "string", "enum": ["none", "local_build", "wasm", "manual_review"]}
        }
      }
    }
  }
}
