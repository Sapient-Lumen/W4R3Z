{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/test-run-artifact-standard-kit/run-identity.receipt.schema.json",
  "title": "run-identity.receipt",
  "type": "object",
  "required": ["artifact", "subject", "run_id", "runner_family", "harness_class", "import_route", "exactness"],
  "properties": {
    "artifact": {"const": "run-identity.receipt"},
    "subject": {"type": "string"},
    "run_id": {"type": "string"},
    "runner_family": {"enum": ["cargo_test", "cargo_nextest", "custom_harness", "manual_import"]},
    "harness_class": {"enum": ["libtest_builtin", "libtest_mimic", "custom_protocol", "manual_review_required"]},
    "import_route": {"enum": ["native_capture", "native_recording_import", "lossy_import", "manual_reconstruction"]},
    "exactness": {"enum": ["exact", "approximate", "manual_review_required"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
