{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/test-run-artifact-standard-kit/selection-basis.receipt.schema.json",
  "title": "selection-basis.receipt",
  "type": "object",
  "required": ["artifact", "subject", "package_scope", "target_scope", "selection_source", "replay_exactness"],
  "properties": {
    "artifact": {"const": "selection-basis.receipt"},
    "subject": {"type": "string"},
    "package_scope": {"type": "array", "items": {"type": "string"}},
    "target_scope": {"type": "array", "items": {"type": "string"}},
    "filter_expression": {"type": ["string", "null"]},
    "selection_source": {"enum": ["native_test_list", "imported_test_list", "console_reconstruction", "manual_review_required"]},
    "profile": {"type": ["string", "null"]},
    "platform": {"type": ["string", "null"]},
    "replay_exactness": {"enum": ["exact", "approximate", "manual_review_required"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
