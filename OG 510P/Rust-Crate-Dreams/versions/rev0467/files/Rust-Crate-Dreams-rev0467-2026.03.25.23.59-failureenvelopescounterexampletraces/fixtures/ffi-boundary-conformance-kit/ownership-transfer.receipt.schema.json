{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ownership-transfer.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "surface",
    "transfer_class",
    "allocation_domain",
    "release_mechanism",
    "lifetime_bound",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "surface": {"type": "string"},
    "transfer_class": {
      "type": "string",
      "enum": [
        "borrowed_ephemeral",
        "copied_value",
        "opaque_handle",
        "foreign_owned_buffer",
        "rust_owned_buffer",
        "shared_refcounted_handle",
        "manual_review_required"
      ]
    },
    "allocation_domain": {
      "type": "string",
      "enum": [
        "no_heap_transfer",
        "rust_allocator_hidden",
        "foreign_allocator",
        "shared_runtime_handle_table",
        "manual_review_required"
      ]
    },
    "release_mechanism": {
      "type": "string",
      "enum": [
        "none_needed",
        "foreign_calls_explicit_free",
        "rust_calls_foreign_destructor",
        "drop_releases_handle",
        "callback_completion",
        "manual_review_required"
      ]
    },
    "lifetime_bound": {
      "type": "string",
      "enum": [
        "call_only",
        "until_explicit_free",
        "until_handle_drop",
        "until_callback_completion",
        "runtime_managed",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
