{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "error-channel.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "surface",
    "error_transport",
    "payload_fidelity",
    "panic_mapping",
    "unexpected_failure_policy",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "surface": {"type": "string"},
    "error_transport": {
      "type": "string",
      "enum": [
        "none_declared",
        "status_code_or_outparam",
        "flat_error_enum",
        "structured_result",
        "foreign_exception",
        "canonical_result",
        "callback_result",
        "manual_review_required"
      ]
    },
    "payload_fidelity": {
      "type": "string",
      "enum": [
        "none",
        "code_only",
        "message_only",
        "flat_enum_no_associated_data",
        "structured_fields",
        "opaque_foreign_error_object",
        "manual_review_required"
      ]
    },
    "panic_mapping": {
      "type": "string",
      "enum": [
        "caught_and_translated",
        "panic_becomes_generated_exception",
        "process_abort_or_trap",
        "allowed_to_unwind",
        "undocumented_or_implicit",
        "manual_review_required"
      ]
    },
    "unexpected_failure_policy": {
      "type": "string",
      "enum": [
        "converted_to_declared_error",
        "wrapped_as_generic_exception",
        "callback_unexpected_failure_panics",
        "foreign_exception_caught_to_rust_err",
        "manual_review_only",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
