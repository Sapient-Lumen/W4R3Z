  "required": [
    "subject",
    "registration_mode",
    "ownership_model",
    "teardown_policy",
    "verdict"
  ],
  "properties": {
    "subject": { "type": "string" },
    "registration_mode": { "type": "string" },
    "ownership_model": { "type": "string" },
    "clone_route": { "type": ["string", "null"] },
    "free_route": { "type": ["string", "null"] },
    "teardown_policy": { "type": "string" },
    "late_callback_posture": { "type": "string" },
    "cancellation_posture": { "type": "string" },
    "evidence_class": { "type": "string" },
    "verdict": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
