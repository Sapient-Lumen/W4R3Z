{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "projection-drift.report",
  "type": "object",
  "required": [
    "subject",
    "from_release",
    "to_release",
    "projection_artifact",
    "drift_class",
    "verdict"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "from_release": {
      "type": "string"
    },
    "to_release": {
      "type": "string"
    },
    "projection_artifact": {
      "type": "string"
    },
    "drift_class": {
      "type": "string"
    },
    "drift_causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "receiver_visible_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "re_review_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "type": "string"
    }
  }
}
