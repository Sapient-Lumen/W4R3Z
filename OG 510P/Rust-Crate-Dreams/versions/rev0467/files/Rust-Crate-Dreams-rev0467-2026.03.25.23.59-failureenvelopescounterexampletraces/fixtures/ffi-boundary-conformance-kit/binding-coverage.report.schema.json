{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "binding-coverage.report",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "binding_surfaces",
    "coverage_posture",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "binding_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "surface_id",
          "binding_family",
          "target_language_or_runtime",
          "generation_mode",
          "check_status"
        ],
        "properties": {
          "surface_id": {"type": "string"},
          "binding_family": {
            "type": "string",
            "enum": [
              "c_header",
              "cxx_bridge",
              "uniffi",
              "diplomat",
              "wit_component",
              "wasm_bindgen",
              "manual_review_required"
            ]
          },
          "target_language_or_runtime": {"type": "string"},
          "generation_mode": {
            "type": "string",
            "enum": [
              "checked_in_generated",
              "generated_in_ci",
              "manual_adapter",
              "imported_external",
              "manual_review_required"
            ]
          },
          "check_status": {
            "type": "string",
            "enum": [
              "directly_checked",
              "generated_only",
              "packaging_only",
              "docs_only",
              "not_checked",
              "manual_review_required"
            ]
          },
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "coverage_posture": {
      "type": "string",
      "enum": [
        "uniformly_checked",
        "mixed_strength",
        "generation_heavier_than_verification",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
