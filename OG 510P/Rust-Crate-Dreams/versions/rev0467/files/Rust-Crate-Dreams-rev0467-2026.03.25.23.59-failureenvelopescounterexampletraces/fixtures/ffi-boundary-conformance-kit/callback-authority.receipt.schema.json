{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "callback-authority.receipt",
  "type": "object",
  "required": [
    "artifact",
    "callback_surface",
    "boundary_family",
    "authority_source",
    "directionality",
    "support_class",
    "manual_review_required"
  ],
  "properties": {
    "artifact": {
      "const": "callback-authority.receipt"
    },
    "callback_surface": {
      "type": "string"
    },
    "boundary_family": {
      "type": "string",
      "enum": [
        "uniffi_foreign_trait",
        "uniffi_callback_interface",
        "diplomat_callback_param",
        "cxx_callback",
        "cxx_async_adapter",
        "wit_import_export",
        "mixed"
      ]
    },
    "authority_source": {
      "type": "object",
      "required": [
        "kind",
        "location"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "rust_trait",
            "udl_interface",
            "bridge_module",
            "diplomat_bridge",
            "wit_world",
            "generated_adapter",
            "mixed"
          ]
        },
        "location": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "directionality": {
      "type": "string",
      "enum": [
        "rust_calls_foreign",
        "foreign_calls_rust",
        "adapter_mediated",
        "bidirectional",
        "manual_review_required"
      ]
    },
    "native_surface": {
      "type": "boolean"
    },
    "support_class": {
      "type": "string",
      "enum": [
        "declared",
        "limited",
        "adapter_only",
        "manual_review_required"
      ]
    },
    "runtime_attachment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
