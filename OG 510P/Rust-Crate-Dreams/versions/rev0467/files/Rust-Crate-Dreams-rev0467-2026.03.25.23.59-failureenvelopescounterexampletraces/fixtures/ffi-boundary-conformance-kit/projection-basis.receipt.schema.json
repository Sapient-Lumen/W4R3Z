{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "projection-basis.receipt",
  "type": "object",
  "required": [
    "subject",
    "artifact_kind",
    "projects_from",
    "generator_family",
    "projection_class",
    "verdict"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "artifact_kind": {
      "type": "string"
    },
    "projects_from": {
      "type": "string"
    },
    "generator_family": {
      "type": "string"
    },
    "backend_or_language": {
      "type": [
        "string",
        "null"
      ]
    },
    "configuration_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "projection_class": {
      "type": "string"
    },
    "build_or_package_proof": {
      "type": "string"
    },
    "manual_review_zones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
