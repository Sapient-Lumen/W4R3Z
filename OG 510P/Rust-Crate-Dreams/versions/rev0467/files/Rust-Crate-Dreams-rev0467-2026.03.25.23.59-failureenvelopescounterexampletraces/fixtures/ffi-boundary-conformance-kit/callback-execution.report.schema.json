{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "callback-execution.report",
  "type": "object",
  "required": [
    "schema_version",
    "callback_surface",
    "callback_kind",
    "execution_origin",
    "thread_posture",
    "teardown_requirement",
    "async_contract",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "callback_surface": {"type": "string"},
    "callback_kind": {
      "type": "string",
      "enum": [
        "sync_function_pointer",
        "event_listener",
        "foreign_trait_callback",
        "foreign_future_callback",
        "continuation",
        "none",
        "manual_review_required"
      ]
    },
    "execution_origin": {
      "type": "string",
      "enum": [
        "same_call_stack",
        "foreign_main_thread",
        "foreign_worker_thread",
        "rust_executor",
        "mixed_or_unknown",
        "manual_review_required"
      ]
    },
    "thread_posture": {
      "type": "string",
      "enum": [
        "single_thread_affine",
        "may_arrive_from_multiple_threads",
        "runtime_polled",
        "manual_review_required"
      ]
    },
    "teardown_requirement": {
      "type": "string",
      "enum": [
        "no_callback_path",
        "must_unregister_before_drop",
        "handle_drop_signals_cancel_only",
        "runtime_owns_until_completion",
        "manual_review_required"
      ]
    },
    "async_contract": {
      "type": "string",
      "enum": [
        "none",
        "callback_completes_inline",
        "callback_may_arrive_after_return",
        "future_poll_cancel_free_cycle",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
