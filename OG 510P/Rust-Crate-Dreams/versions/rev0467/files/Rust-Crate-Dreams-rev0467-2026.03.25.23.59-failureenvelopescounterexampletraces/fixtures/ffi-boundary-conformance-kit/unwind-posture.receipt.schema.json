{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unwind-posture.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "symbol_or_surface",
    "abi_family",
    "rust_panic_posture",
    "foreign_unwind_posture",
    "containment_strategy",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "symbol_or_surface": {"type": "string"},
    "abi_family": {
      "type": "string",
      "enum": [
        "extern_c",
        "extern_c_unwind",
        "extern_cpp_bridge",
        "uniffi_scaffolding",
        "diplomat_c_abi",
        "wit_component",
        "manual_review_required"
      ]
    },
    "rust_panic_posture": {
      "type": "string",
      "enum": [
        "caught_and_translated",
        "abort_process",
        "allowed_to_cross_boundary",
        "no_panic_expected",
        "manual_review_required"
      ]
    },
    "foreign_unwind_posture": {
      "type": "string",
      "enum": [
        "forbidden",
        "allowed_via_unwind_abi",
        "not_applicable",
        "manual_review_required"
      ]
    },
    "containment_strategy": {
      "type": "string",
      "enum": [
        "catch_unwind_wrapper",
        "panic_abort_profile",
        "generated_runtime_handler",
        "none_declared",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
