{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "idempotency-basis.receipt",
  "type": "object",
  "required": ["artifact", "subject", "replay_safety", "request_cloneability", "classifier_scope"],
  "properties": {
    "artifact": {"const": "idempotency-basis.receipt"},
    "subject": {"type": "string"},
    "replay_safety": {"enum": ["safe_by_protocol", "safe_by_idempotency_key", "safe_by_app_contract", "not_safe_without_manual_review", "manual_review_required"]},
    "request_cloneability": {"enum": ["cloneable", "rebuildable", "not_cloneable", "manual_review_required"]},
    "classifier_scope": {"enum": ["global", "same_host", "same_route", "same_operation", "manual_review_required"]},
    "idempotency_key_posture": {"enum": ["none", "caller_supplied", "generated_stable_across_retries", "manual_review_required"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
