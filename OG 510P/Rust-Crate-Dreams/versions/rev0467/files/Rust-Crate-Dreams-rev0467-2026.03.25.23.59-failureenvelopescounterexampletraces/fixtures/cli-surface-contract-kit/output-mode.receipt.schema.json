{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "output-mode.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "mode_name",
    "audience",
    "encoding",
    "record_framing",
    "stdout_role",
    "stderr_role"
  ],
  "properties": {
    "artifact": {"const": "output-mode.receipt"},
    "subject": {"type": "string"},
    "mode_name": {"type": "string"},
    "audience": {
      "enum": ["human", "machine", "mixed", "manual_review_required"]
    },
    "encoding": {
      "enum": ["text", "json", "jsonl", "csv", "table", "binary", "manual_review_required"]
    },
    "record_framing": {
      "enum": ["whole_document", "newline_delimited_records", "streaming_chunks", "not_applicable", "manual_review_required"]
    },
    "stdout_role": {
      "enum": ["primary_records", "human_summary", "mixed_unstable", "manual_review_required"]
    },
    "stderr_role": {
      "enum": ["diagnostics_only", "diagnostics_and_progress", "mixed_unstable", "unused", "manual_review_required"]
    },
    "schema_reference": {"type": ["string", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
