{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/rustdoc-json-support-bundle.manifest.schema.json",
  "title": "rustdoc-json-support-bundle.manifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_name",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "bundle_name": {"type": "string"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "properties": {
          "kind": {"type": "string"},
          "path": {"type": "string"},
          "required": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
