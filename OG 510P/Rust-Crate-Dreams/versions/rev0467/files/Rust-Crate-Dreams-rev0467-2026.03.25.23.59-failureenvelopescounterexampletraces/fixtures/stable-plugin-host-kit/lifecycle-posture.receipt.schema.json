{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stable-plugin-host-kit/lifecycle-posture.receipt.schema.json",
  "title": "lifecycle-posture.receipt",
  "type": "object",
  "required": [
    "scenario",
    "load_mode",
    "unload_posture",
    "reload_posture",
    "state_posture"
  ],
  "properties": {
    "scenario": {
      "type": "string"
    },
    "load_mode": {
      "type": "string",
      "enum": [
        "startup_scan",
        "explicit_on_demand",
        "per_request_subprocess",
        "manual_review_required"
      ]
    },
    "unload_posture": {
      "type": "string",
      "enum": [
        "unsupported",
        "host_drop_only",
        "process_restart_only",
        "unsafe_or_manual",
        "manual_review_required"
      ]
    },
    "reload_posture": {
      "type": "string",
      "enum": [
        "unsupported",
        "replace_on_restart",
        "side_by_side_slot",
        "manual_review_required"
      ]
    },
    "state_posture": {
      "type": "string",
      "enum": [
        "stateless",
        "plugin_internal_state",
        "host_managed_state",
        "mixed",
        "manual_review_required"
      ]
    },
    "init_termination_basis": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
