{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-build-dir-consumer-transition/layout.snapshot.schema.json",
  "title": "Cargo layout snapshot",
  "type": "object",
  "required": ["schema_version", "roots", "build_dir_mode"],
  "properties": {
    "schema_version": {"type": "string"},
    "build_dir_mode": {"type": "string", "enum": ["legacy_default", "stable_build_dir", "nightly_new_layout", "unknown"]},
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["root_kind", "path_policy", "observed_from"],
        "properties": {
          "root_kind": {"type": "string", "enum": ["target_dir", "build_dir", "doc_dir", "package_dir", "unknown_root"]},
          "path_policy": {"type": "string", "enum": ["literal", "redacted", "relative", "omitted"]},
          "path_hint": {"type": "string"},
          "observed_from": {"type": "array", "items": {"type": "string", "enum": ["cargo_config", "env", "command_line", "path_scan", "manual_annotation"]}}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
