{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-build-dir-consumer-transition/windowed-viability.matrix.schema.json",
  "title": "Cargo build-dir windowed viability matrix",
  "type": "object",
  "required": ["schema_version", "consumer_ref", "rows"],
  "properties": {
    "schema_version": {"type": "string"},
    "consumer_ref": {"type": "string"},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "window_label",
          "cargo_channel",
          "layout_mode",
          "verdict",
          "fallback_posture"
        ],
        "properties": {
          "window_label": {"type": "string"},
          "cargo_channel": {
            "type": "string",
            "enum": ["stable", "nightly"]
          },
          "cargo_version_floor": {"type": "string"},
          "layout_mode": {
            "type": "string",
            "enum": ["legacy_layout", "custom_build_dir", "new_layout_rehearsal"]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "works_as_documented",
              "works_with_fallback",
              "nightly_only",
              "blocked_on_upstream",
              "manual_review_required"
            ]
          },
          "fallback_posture": {
            "type": "string",
            "enum": [
              "none",
              "older_cargo_fallback_required",
              "legacy_layout_fallback_required",
              "both_fallbacks_required",
              "manual_review_required"
            ]
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
