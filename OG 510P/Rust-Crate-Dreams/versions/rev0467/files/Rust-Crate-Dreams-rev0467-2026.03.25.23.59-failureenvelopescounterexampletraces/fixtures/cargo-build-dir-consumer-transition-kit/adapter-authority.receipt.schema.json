{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-build-dir-consumer-transition/adapter-authority.receipt.schema.json",
  "title": "Cargo build-dir adapter authority receipt",
  "type": "object",
  "required": [
    "schema_version",
    "consumer_ref",
    "recommended_adapter",
    "source_class",
    "claim_scope"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "consumer_ref": {"type": "string"},
    "recommended_adapter": {"type": "string"},
    "source_class": {
      "type": "string",
      "enum": [
        "cargo_book",
        "release_notes",
        "official_call_for_testing",
        "unstable_docs",
        "project_goal",
        "issue_thread_only",
        "local_heuristic",
        "manual_review_required"
      ]
    },
    "authority_basis": {"type": "array", "items": {"type": "string"}},
    "claim_scope": {
      "type": "string",
      "enum": [
        "documented_for_need",
        "documented_with_version_window",
        "documented_but_different_need",
        "partial_workaround",
        "manual_review_required"
      ]
    },
    "applies_from_cargo": {"type": "string"},
    "applies_on_channel": {
      "type": "string",
      "enum": ["stable", "nightly", "either", "manual_review_required"]
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
