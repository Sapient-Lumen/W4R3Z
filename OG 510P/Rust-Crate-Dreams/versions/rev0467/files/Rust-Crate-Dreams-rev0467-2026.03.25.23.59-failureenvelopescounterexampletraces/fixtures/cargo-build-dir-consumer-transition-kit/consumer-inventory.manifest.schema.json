{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-build-dir-consumer-transition/consumer-inventory.manifest.schema.json",
  "title": "Cargo build-dir consumer inventory",
  "type": "object",
  "required": ["schema_version", "consumers"],
  "properties": {
    "schema_version": {"type": "string"},
    "consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["consumer_id", "role", "need", "observed_from"],
        "properties": {
          "consumer_id": {"type": "string"},
          "role": {"type": "string", "enum": ["ci_script", "packaging_helper", "support_tool", "local_wrapper", "editor_helper", "manual_script", "unknown"]},
          "need": {"type": "string", "enum": ["final_artifact", "dep_info", "build_script_output", "intermediate_rlib", "artifact_enumeration", "unknown"]},
          "observed_from": {"type": "array", "items": {"type": "string", "enum": ["path_scan", "config_scan", "script_scan", "json_messages", "manual_annotation"]}},
          "path_policy": {"type": "string", "enum": ["literal", "redacted", "relative", "omitted"]},
          "path_hint": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
