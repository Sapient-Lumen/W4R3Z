{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-build-dir-consumer-transition/rehearsal-support-bundle.manifest.schema.json",
  "title": "Cargo build-dir rehearsal support bundle manifest",
  "type": "object",
  "required": ["schema_version", "bundle_kind", "subject", "receipts"],
  "properties": {
    "schema_version": {"type": "string"},
    "bundle_kind": {"type": "string"},
    "subject": {"type": "string"},
    "compared_modes": {"type": "array", "items": {"type": "string"}},
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "purpose"],
        "properties": {
          "kind": {"type": "string"},
          "path": {"type": "string"},
          "purpose": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "share_safe": {"type": "boolean"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
