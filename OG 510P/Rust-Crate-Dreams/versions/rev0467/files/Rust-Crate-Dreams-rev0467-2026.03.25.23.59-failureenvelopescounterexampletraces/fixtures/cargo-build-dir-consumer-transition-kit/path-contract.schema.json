{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-build-dir-consumer-transition/path-contract.schema.json",
  "title": "Cargo path contract",
  "type": "object",
  "required": ["schema_version", "contracts"],
  "properties": {
    "schema_version": {"type": "string"},
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["consumer_ref", "contract_kind", "stability"],
        "properties": {
          "consumer_ref": {"type": "string"},
          "contract_kind": {"type": "string", "enum": ["final_artifact", "dep_info", "build_script_out", "integration_test_binary", "manual_review_required", "no_safe_contract"]},
          "stability": {"type": "string", "enum": ["documented_surface", "conservative_mapping", "unknown"]},
          "backed_by": {"type": "array", "items": {"type": "string", "enum": ["cargo_build_docs", "build_cache_docs", "build_script_docs", "env_vars_docs", "external_tools_json", "artifact_handoff", "manual_annotation"]}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
