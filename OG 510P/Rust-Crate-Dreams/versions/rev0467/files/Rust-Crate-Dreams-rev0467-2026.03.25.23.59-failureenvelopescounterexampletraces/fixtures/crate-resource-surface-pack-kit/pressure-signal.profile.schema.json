{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PressureSignalProfile",
  "type": "object",
  "required": ["schema_version", "crate", "profile", "signals"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "profile": {"type": "string"},
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource", "signal_kind"],
        "properties": {
          "resource": {"type": "string"},
          "signal_kind": {
            "enum": [
              "queue_depth",
              "blocking_queue_depth",
              "num_workers",
              "num_blocking_threads",
              "global_runtime_queue_depth",
              "idle_connection_count",
              "cache_entry_count",
              "cache_weight",
              "rate_budget_remaining",
              "manual_review_required"
            ]
          },
          "source": {"type": "string"},
          "recommended_for": {"type": "array", "items": {"type": "string"}},
          "threshold_hint": {"type": ["string", "number", "null"]}
        }
      }
    }
  }
}
