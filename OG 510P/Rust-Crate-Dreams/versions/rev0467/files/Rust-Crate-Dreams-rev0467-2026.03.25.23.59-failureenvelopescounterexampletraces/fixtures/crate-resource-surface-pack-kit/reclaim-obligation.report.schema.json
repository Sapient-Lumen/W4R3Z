{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReclaimObligationReport",
  "type": "object",
  "required": ["schema_version", "crate", "resources"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "reclaimed_by"],
        "properties": {
          "name": {"type": "string"},
          "reclaimed_by": {"type": "array", "items": {"type": "string"}},
          "automatic": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}