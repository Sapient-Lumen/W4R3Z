{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoundednessClassPolicy",
  "type": "object",
  "required": ["schema_version", "classes"],
  "properties": {
    "schema_version": {"type": "string"},
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class_name", "meaning"],
        "properties": {
          "class_name": {
            "enum": [
              "bounded",
              "configurable",
              "burst_bounded",
              "externally_bounded",
              "effectively_unbounded",
              "manual_review_required"
            ]
          },
          "meaning": {"type": "string"},
          "guarantees": {"type": "array", "items": {"type": "string"}},
          "non_guarantees": {"type": "array", "items": {"type": "string"}},
          "example_evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
