{
  "schema_version": "0.1",
  "scenario": "servicebuilder_buffer_before_concurrency_limit",
  "resources": [
    {
      "name": "service_buffer",
      "kind": "queue",
      "default_bound": 100
    },
    {
      "name": "wrapped_service_inflight",
      "kind": "inflight_limit",
      "default_bound": 10
    }
