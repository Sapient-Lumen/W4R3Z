{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceSurfaceReceipt",
  "type": "object",
  "required": ["schema_version", "crate", "observations"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource", "source", "value"],
        "properties": {
          "resource": {"type": "string"},
          "source": {"type": "string"},
          "value": {"type": ["integer", "string", "boolean", "null"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}