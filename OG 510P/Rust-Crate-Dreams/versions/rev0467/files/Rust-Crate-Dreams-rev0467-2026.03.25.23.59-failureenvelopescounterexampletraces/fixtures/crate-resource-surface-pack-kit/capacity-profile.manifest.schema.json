{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapacityProfileManifest",
  "type": "object",
  "required": ["schema_version", "crate", "profiles"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "intent"],
        "properties": {
          "name": {"type": "string"},
          "intent": {"type": "string"},
          "overrides": {"type": "array", "items": {"type": "string"}},
          "manual_review_boundary": {"type": ["string", "null"]}
        }
      }
    }
  }
}