{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourcePack",
  "type": "object",
  "required": ["schema_version", "crate", "resources"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "boundedness", "saturation"],
        "properties": {
          "name": {"type": "string"},
          "kind": {
            "enum": ["queue", "buffer", "cache", "connection_pool", "worker_pool", "task_set", "permit_pool", "rate_bucket", "manual_review_required"]
          },
          "boundedness": {
            "enum": ["bounded", "configurable", "burst_bounded", "externally_bounded", "effectively_unbounded", "manual_review_required"]
          },
          "default_bound": {"type": ["integer", "string", "null"]},
          "saturation": {
            "enum": ["backpressure_wait", "reject_with_error", "drop_newest", "drop_oldest", "evict", "queue_until_limit", "spill_or_degrade", "unbounded_growth_risk", "panic_or_abort", "manual_review_required"]
          },
          "profile": {"type": "string"},
          "knobs": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}