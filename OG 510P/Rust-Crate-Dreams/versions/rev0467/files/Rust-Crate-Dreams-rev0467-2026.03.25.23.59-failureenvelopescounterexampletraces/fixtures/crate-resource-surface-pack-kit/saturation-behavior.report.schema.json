{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SaturationBehaviorReport",
  "type": "object",
  "required": ["schema_version", "crate", "resources"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "boundedness", "saturation"],
        "properties": {
          "name": {"type": "string"},
          "boundedness": {"type": "string"},
          "saturation": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "manual_review_boundary": {"type": ["string", "null"]}
        }
      }
    }
  }
}