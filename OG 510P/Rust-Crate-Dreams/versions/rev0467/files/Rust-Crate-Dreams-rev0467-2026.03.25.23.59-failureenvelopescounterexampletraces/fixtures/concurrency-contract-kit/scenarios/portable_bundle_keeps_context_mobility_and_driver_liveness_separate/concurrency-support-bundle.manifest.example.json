{
  "schema_version": "0.1.0",
  "bundle_name": "tokio-locality-and-driver-bundle",
  "artifacts": [
    {
      "kind": "execution-context-boundary.report",
      "path": "execution-context-boundary.report.json",
      "required": true
    },
    {
      "kind": "mobility-affinity.report",
      "path": "mobility-affinity.report.json",
      "required": false
    },
    {
      "kind": "driver-liveness.report",
      "path": "driver-liveness.report.json",
      "required": false
    },
    {
      "kind": "wait-cancellation.report",
      "path": "wait-cancellation.report.json",
      "required": false
    }
  ],
  "artifact_policy": "keep_context_locality_and_liveness_separate",
  "notes": [
    "Local spawn support does not by itself prove background progress.",
    "A bundle may need all three layers to explain an async-support issue honestly."
  ]
}
