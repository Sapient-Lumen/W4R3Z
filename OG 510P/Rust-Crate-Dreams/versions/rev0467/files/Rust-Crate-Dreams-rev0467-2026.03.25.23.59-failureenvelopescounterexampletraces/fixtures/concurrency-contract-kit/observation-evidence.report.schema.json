{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/observation-evidence.report.schema.json",
  "title": "observation-evidence.report",
  "type": "object",
  "required": [
    "schema_version",
    "surface",
    "evidence_class",
    "claim_basis",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "surface": {"type": "string"},
    "evidence_class": {"type": "string"},
    "positive_evidence": {"type": "string"},
    "negative_evidence": {"type": "string"},
    "producer_visible_signals": {"type": "string"},
    "externalization_route": {"type": "string"},
    "separate_ack_required": {"type": ["boolean", "string"]},
    "claim_basis": {"type": "string"},
    "claim_ceiling": {"type": "string"},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
