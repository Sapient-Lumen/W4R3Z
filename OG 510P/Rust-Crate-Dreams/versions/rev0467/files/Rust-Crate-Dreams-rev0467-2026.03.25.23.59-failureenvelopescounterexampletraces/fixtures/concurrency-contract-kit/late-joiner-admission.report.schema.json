{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/late-joiner-admission.report.schema.json",
  "title": "late-joiner-admission.report",
  "type": "object",
  "required": [
    "schema_version",
    "surface",
    "admission_class",
    "claim_basis",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "surface": {"type": "string"},
    "admission_class": {"type": "string"},
    "join_mechanism": {"type": "string"},
    "observer_role": {"type": "string"},
    "admission_preconditions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "history_window": {"type": "string"},
    "claim_basis": {"type": "string"},
    "claim_ceiling": {"type": "string"},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
