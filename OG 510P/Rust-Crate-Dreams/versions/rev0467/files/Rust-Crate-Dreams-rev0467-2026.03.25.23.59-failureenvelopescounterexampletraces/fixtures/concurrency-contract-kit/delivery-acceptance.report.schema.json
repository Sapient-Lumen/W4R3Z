{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/delivery-acceptance.report.schema.json",
  "title": "delivery-acceptance.report",
  "type": "object",
  "required": [
    "schema_version",
    "surface",
    "acceptance_class",
    "success_meaning",
    "claim_basis",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "surface": {"type": "string"},
    "acceptance_class": {"type": "string"},
    "accepted_unit": {"type": "string"},
    "success_meaning": {"type": "string"},
    "receiver_liveness_requirement": {"type": "string"},
    "storage_or_visibility_effect": {"type": "string"},
    "future_joiner_posture": {"type": "string"},
    "observation_guarantee": {"type": "string"},
    "claim_basis": {"type": "string"},
    "claim_ceiling": {"type": "string"},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
