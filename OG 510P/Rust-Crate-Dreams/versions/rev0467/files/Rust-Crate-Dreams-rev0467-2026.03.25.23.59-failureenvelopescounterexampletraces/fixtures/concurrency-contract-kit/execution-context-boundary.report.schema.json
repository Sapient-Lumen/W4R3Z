{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/execution-context-boundary.report.schema.json",
  "title": "execution-context-boundary.report",
  "type": "object",
  "required": [
    "schema_version",
    "surface",
    "allowed_contexts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "surface": {
      "type": "string"
    },
    "allowed_contexts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_contexts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_basis": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
