{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/mobility-affinity.report.schema.json",
  "title": "mobility-affinity.report",
  "type": "object",
  "required": [
    "schema_version",
    "surface",
    "mobility_class"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "surface": {"type": "string"},
    "mobility_class": {"type": "string"},
    "locality_scope": {"type": "string"},
    "spawn_context_requirements": {
      "type": "array",
      "items": {"type": "string"}
    },
    "cross_thread_posture": {"type": "string"},
    "runtime_affinity": {"type": "string"},
    "claim_basis": {"type": "string"},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
