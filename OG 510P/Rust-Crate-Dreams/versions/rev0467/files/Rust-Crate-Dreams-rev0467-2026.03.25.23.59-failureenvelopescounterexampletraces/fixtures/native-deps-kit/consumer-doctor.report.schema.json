{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/consumer-doctor.report.schema.json",
  "title": "consumer-doctor.report",
  "type": "object",
  "required": ["schema_version", "result", "actions"],
  "properties": {
    "schema_version": {"type": "string"},
    "result": {"enum": ["resolved", "action_required", "manual_review_required"]},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "message"],
        "properties": {
          "kind": {"enum": ["install_package", "set_env", "use_override", "enable_feature", "manual_review_required"]},
          "message": {"type": "string"},
          "platform_scope": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
