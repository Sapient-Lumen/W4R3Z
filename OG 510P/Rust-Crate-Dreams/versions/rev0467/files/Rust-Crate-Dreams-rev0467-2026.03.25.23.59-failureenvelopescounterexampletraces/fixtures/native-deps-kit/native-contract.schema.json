{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/native-contract.schema.json",
  "title": "native-contract",
  "type": "object",
  "required": ["schema_version", "libraries"],
  "properties": {
    "schema_version": {"type": "string"},
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "version_requirement": {"type": ["string", "null"]},
          "features": {"type": "array", "items": {"type": "string"}},
          "preferred_backends": {"type": "array", "items": {"enum": ["pkg-config", "vcpkg", "vendored", "override"]}},
          "link_mode": {"enum": ["dynamic", "static", "either", "manual_review_required"]},
          "offline_policy": {"enum": ["allow_network", "no_network", "manual_review_required"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
