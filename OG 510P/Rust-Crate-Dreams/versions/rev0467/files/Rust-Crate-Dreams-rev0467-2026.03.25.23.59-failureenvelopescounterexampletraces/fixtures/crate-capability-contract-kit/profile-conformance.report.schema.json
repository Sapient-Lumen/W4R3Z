{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "profile conformance report",
  "type": "object",
  "required": [
    "schema_version",
    "profile_results"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "profile_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "verdict",
          "manual_review_required"
        ],
        "properties": {
          "profile_id": {
            "type": "string"
          },
          "verdict": {
            "type": "string"
          },
          "manual_review_required": {
            "type": "boolean"
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mismatches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
