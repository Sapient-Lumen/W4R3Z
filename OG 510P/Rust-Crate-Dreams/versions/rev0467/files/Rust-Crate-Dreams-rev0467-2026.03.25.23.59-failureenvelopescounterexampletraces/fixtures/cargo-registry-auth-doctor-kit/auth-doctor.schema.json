          "stage": {"type": "string", "enum": ["login", "index_access", "download", "search", "publish"]},
          "verdict": {"type": "string", "enum": ["ok", "provider_not_found", "provider_protocol_error", "unauthorized", "identity_mismatch", "manual_review_required"]}
        }
      }
    }
  }
