{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/cargo-registry-auth-doctor-kit/auth-doctor.schema.json",
  "title": "CargoRegistryAuthDoctorReceipt",
  "type": "object",
  "required": ["registry", "protocol", "stage_verdicts"],
  "properties": {
    "registry": {"type": "string"},
    "protocol": {"type": "string", "enum": ["sparse", "git", "manual_review_required"]},
