{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docs.rs Hosted Build Import Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "source_kind",
    "source_ref"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "releases_summary",
        "build_log",
        "copied_text",
        "manual_note"
      ]
    },
    "source_ref": {
      "type": "string"
    },
    "build_status": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "unknown"
      ]
    },
    "log_truncated": {
      "type": "boolean"
    },
    "toolchain_hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
