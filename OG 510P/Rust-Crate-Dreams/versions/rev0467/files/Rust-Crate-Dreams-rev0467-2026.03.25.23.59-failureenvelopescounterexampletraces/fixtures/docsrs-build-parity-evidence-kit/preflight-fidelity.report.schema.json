{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docs.rs Preflight Fidelity Report",
  "type": "object",
  "required": [
    "schema_version",
    "fidelity_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "fidelity_class": {
      "type": "string",
      "enum": [
        "metadata_only",
        "cargo_docs_rs_preflight",
        "builder_local_reproduction",
        "hosted_import_only",
        "joined_local_hosted",
        "manual_review_required"
      ]
    },
    "local_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hosted_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
