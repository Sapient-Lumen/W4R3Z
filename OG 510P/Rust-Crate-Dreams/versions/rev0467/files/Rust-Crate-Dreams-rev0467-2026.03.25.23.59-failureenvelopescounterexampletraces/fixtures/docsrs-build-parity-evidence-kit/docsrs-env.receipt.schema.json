{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docs.rs Environment Receipt",
  "type": "object",
  "required": ["schema_version", "hosted_nightly", "local_toolchain"],
  "properties": {
    "schema_version": {"type": "string"},
    "hosted_nightly": {"type": "string"},
    "local_toolchain": {"type": "string"},
    "docsrs_cfg_scope": {"type": "string"},
    "docs_rs_env_available_in_build_rs": {"type": "boolean"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
