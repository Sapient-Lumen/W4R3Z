{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docs.rs Drift Cause Report",
  "type": "object",
  "required": [
    "schema_version",
    "causes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "causes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "confidence"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "default_target_shift",
              "docsrs_cfg_scope",
              "readonly_fs",
              "network_blocked",
              "missing_native_dependency",
              "target_limit",
              "nightly_or_builder_drift",
              "log_truncation",
              "unknown"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
