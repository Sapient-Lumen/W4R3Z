{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "replayability.report",
  "type": "object",
  "required": ["replayability", "public_shareability", "blocking_facts", "required_local_inputs"],
  "properties": {
    "replayability": {"enum": ["replayable", "inspectable_only", "local_only", "redaction_broken", "unknown"]},
    "public_shareability": {"enum": ["public_safe", "team_internal", "local_only"]},
    "blocking_facts": {
      "type": "array",
      "items": {"enum": ["missing_env_value", "redacted_token", "redacted_provider_args", "private_path_anchor", "cwd_sensitive_path", "optional_include_presence", "unknown_cli_override", "credentials_file_dependency"]}
    },
    "required_local_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "reason"],
        "properties": {
          "kind": {"enum": ["env", "config_file", "credentials", "provider_binary", "private_path", "cwd", "network"]},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
