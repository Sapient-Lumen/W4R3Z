{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/async-replay-debugger-kit/replay-fidelity.report.schema.json",
  "title": "replay-fidelity.report",
  "type": "object",
  "required": [
    "scenario",
    "strongest_honest_claim",
    "strictness"
  ],
  "properties": {
    "scenario": {
      "type": "string"
    },
    "strongest_honest_claim": {
      "type": "string",
      "enum": [
        "live_inspection_only",
        "timeline_reconstruction",
        "narrow_effect_replay",
        "local_deterministic_replay",
        "minimized_schedule_repro",
        "manual_review_required"
      ]
    },
    "strictness": {
      "type": "string",
      "enum": [
        "exact_within_declared_bounds",
        "best_effort",
        "analysis_only",
        "manual_review_required"
      ]
    },
    "requires_same_runtime": {
      "type": "boolean"
    },
    "requires_same_platform": {
      "type": "boolean"
    },
    "minimized": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
