{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/async-replay-debugger-kit/instrumentation-coverage.report.schema.json",
  "title": "instrumentation-coverage.report",
  "type": "object",
  "required": [
    "scenario",
    "telemetry_source",
    "task_coverage",
    "span_propagation_posture"
  ],
  "properties": {
    "scenario": {
      "type": "string"
    },
    "telemetry_source": {
      "type": "string",
      "enum": [
        "tokio_console",
        "tracing_spans_events",
        "runtime_internal_hooks",
        "mixed",
        "manual_review_required"
      ]
    },
    "task_coverage": {
      "type": "string",
      "enum": [
        "complete_for_instrumented_tasks",
        "spawn_lineage_partial",
        "resource_only",
        "manual_review_required"
      ]
    },
    "span_propagation_posture": {
      "type": "string",
      "enum": [
        "explicit_instrument",
        "in_current_span_propagated",
        "partial",
        "missing",
        "manual_review_required"
      ]
    },
    "effect_hook_coverage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
