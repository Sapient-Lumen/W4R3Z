{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/cpu-baseline-runtime-dispatch-contract-kit/cpu-support.schema.json",
  "title": "CpuSupportBundle",
  "type": "object",
  "required": ["target_triple", "baseline_class", "dispatch_paths"],
  "properties": {
    "target_triple": {"type": "string"},
    "baseline_class": {"type": "string", "enum": ["portable_baseline_ok", "runtime_dispatch_guarded", "baseline_too_aggressive", "feature_requires_fallback", "host_tuned_release_risk", "artifact_target_unknown", "manual_review_required"]},
    "dispatch_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "guarded"],
        "properties": {
          "name": {"type": "string"},
          "guarded": {"type": "boolean"},
          "fallback": {"type": "string"}
        }
      }
    }
  }
}
