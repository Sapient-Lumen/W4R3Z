{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recovery Obligation Report",
  "type": "object",
  "properties": {
    "surface": {
      "type": "string",
      "enum": [
        "cargo_home_global_cache",
        "target_dir_final_artifacts",
        "build_dir_intermediate_artifacts",
        "future_user_wide_build_cache",
        "mixed_or_unknown"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class": {"type": "string"},
          "recovery_class": {
            "type": "string",
            "enum": [
              "locally_recreatable",
              "redownload_required",
              "plugin_or_remote_fetch",
              "unknown_or_manual_review"
            ]
          },
          "cost_bearer": {
            "type": "string",
            "enum": ["developer", "ci", "shared_runner", "remote_cache", "unknown"]
          },
          "offline_risk": {
            "type": "string",
            "enum": ["low", "medium", "high", "manual_review_required"]
          },
          "notes": {"type": "string"}
        },
        "required": ["class", "recovery_class", "cost_bearer", "offline_risk"]
      }
    },
    "manual_review_required": {"type": "boolean"}
  },
  "required": ["surface", "entries", "manual_review_required"]
}
