{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/scope-diagnosis.report.schema.json",
  "title": "ScopeDiagnosisReport",
  "type": "object",
  "required": ["schema_version", "verdict"],
  "properties": {
    "schema_version": {"type": "string"},
    "verdict": {
      "type": "string",
      "enum": [
        "ok",
        "flags_leak_to_host",
        "host_flags_missing",
        "host_config_ignored",
        "rustdoc_buildscript_scope_split",
        "same_triple_scope_ambiguous",
        "nightly_host_config_required",
        "manual_review_required"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["observed-fact", "conservative-inference", "manual-review-required"]
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "suggested_next_steps": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
