{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "error-identity.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "public_identity",
    "stability_class",
    "mapping_basis",
    "docs_route"
  ],
  "properties": {
    "artifact": {"const": "error-identity.receipt"},
    "subject": {"type": "string"},
    "public_identity": {"type": ["string", "null"]},
    "stability_class": {
      "enum": ["public_contract", "best_effort", "internal_only", "manual_review_required"]
    },
    "mapping_basis": {
      "enum": ["explicit_code", "enum_variant", "http_status_plus_code", "opaque_report", "manual_policy", "manual_review_required"]
    },
    "docs_route": {"type": ["string", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
