{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "remediation-surface.report",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "hint_posture",
    "retry_guidance",
    "docs_link_posture",
    "authority_class"
  ],
  "properties": {
    "artifact": {"const": "remediation-surface.report"},
    "subject": {"type": "string"},
    "hint_posture": {
      "enum": ["none", "static_help", "dynamic_help", "manual_review_required"]
    },
    "retry_guidance": {
      "enum": ["no_retry", "retryable_with_receipt", "retryability_unknown", "manual_review_required"]
    },
    "docs_link_posture": {
      "enum": ["none", "stable_docs_route", "best_effort_docs_route", "manual_review_required"]
    },
    "authority_class": {
      "enum": ["authoritative_next_step", "helpful_but_non_binding", "ornamental_only", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
