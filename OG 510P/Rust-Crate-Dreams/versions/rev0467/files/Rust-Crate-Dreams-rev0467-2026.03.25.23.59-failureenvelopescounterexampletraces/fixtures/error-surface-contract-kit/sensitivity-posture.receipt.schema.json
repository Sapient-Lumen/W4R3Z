{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sensitivity-posture.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "backtrace_posture",
    "attachment_posture",
    "data_exposure",
    "export_posture"
  ],
  "properties": {
    "artifact": {"const": "sensitivity-posture.receipt"},
    "subject": {"type": "string"},
    "backtrace_posture": {
      "enum": ["absent", "optional_debug", "always_present", "manual_review_required"]
    },
    "attachment_posture": {
      "enum": ["none", "opaque_internal", "user_visible", "manual_review_required"]
    },
    "data_exposure": {
      "enum": ["minimal", "paths_only", "snippets_or_user_data", "attachments_or_context_objects", "manual_review_required"]
    },
    "export_posture": {
      "enum": ["user_safe", "operator_only", "debug_only", "redaction_required", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
