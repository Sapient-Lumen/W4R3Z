{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted Publishing Claim Basis Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "provider",
    "issuer",
    "claim_route",
    "observed_fields",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "claim_route": {
      "enum": [
        "github_direct_workflow",
        "github_reusable_workflow",
        "gitlab_id_token",
        "manual_review_required"
      ]
    },
    "observed_fields": {
      "type": "object",
      "properties": {
        "aud": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "job_workflow_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sub": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "verdict": {
      "enum": [
        "ok",
        "partial",
        "manual_review_required",
        "mismatch"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
