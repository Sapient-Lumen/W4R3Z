{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted Publishing Release Trigger Report",
  "type": "object",
  "required": [
    "schema_version",
    "provider",
    "trigger",
    "verdict",
    "reasons"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "trigger": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "eligible",
        "blocked",
        "unsupported",
        "manual_review_required"
      ]
    },
    "policy_source": {
      "enum": [
        "provider_docs",
        "crates_io_policy",
        "local_policy",
        "mixed",
        "manual_review_required"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
