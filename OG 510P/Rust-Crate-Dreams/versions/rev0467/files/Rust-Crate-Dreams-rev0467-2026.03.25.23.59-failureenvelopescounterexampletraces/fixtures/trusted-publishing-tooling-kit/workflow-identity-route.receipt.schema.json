{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted Publishing Workflow Identity Route Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "provider_family",
    "route_kind",
    "id_token_posture",
    "issuer",
    "audience",
    "caller_route",
    "receipt_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "provider_family": {
      "enum": [
        "github_actions",
        "gitlab_ci_cd"
      ]
    },
    "route_kind": {
      "enum": [
        "direct_workflow",
        "reusable_workflow",
        "gitlab_config_route",
        "delegated",
        "ambiguous"
      ]
    },
    "id_token_posture": {
      "enum": [
        "explicitly_enabled",
        "missing",
        "inherited_or_unclear",
        "manual_review_required"
      ]
    },
    "issuer": {
      "type": "string"
    },
    "audience": {
      "type": [
        "string",
        "array"
      ]
    },
    "caller_route": {
      "type": "string"
    },
    "called_route": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "ref_context": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "receipt_class": {
      "enum": [
        "observed",
        "imported",
        "reconstructed",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
