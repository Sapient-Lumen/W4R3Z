{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted Publishing Publish Plan",
  "type": "object",
  "required": [
    "schema_version",
    "packages",
    "provider",
    "trigger",
    "workflow",
    "mode"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "provider": {
      "type": "string"
    },
    "host_scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "trigger": {
      "type": "string"
    },
    "tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "workflow": {
      "type": "string"
    },
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "enum": [
        "rehearsal",
        "publish"
      ]
    }
  }
}
