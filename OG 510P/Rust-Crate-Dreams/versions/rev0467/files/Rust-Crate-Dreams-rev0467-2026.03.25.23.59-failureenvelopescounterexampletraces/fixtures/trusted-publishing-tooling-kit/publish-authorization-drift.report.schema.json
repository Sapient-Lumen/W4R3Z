{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted Publishing Authorization Drift Report",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_bundle",
    "candidate_bundle",
    "changes",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "baseline_bundle": {
      "type": "string"
    },
    "candidate_bundle": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "subject"
        ],
        "properties": {
          "kind": {
            "enum": [
              "registry_state_changed",
              "provider_host_scope_changed",
              "workflow_route_changed",
              "issuer_changed",
              "audience_changed",
              "trigger_class_changed",
              "environment_guard_changed",
              "tp_only_posture_changed",
              "manual_review_required"
            ]
          },
          "subject": {
            "type": "string"
          },
          "impact": {
            "enum": [
              "compatible",
              "review_needed",
              "blocked",
              "manual_review_required"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "compatible",
        "review_needed",
        "blocked",
        "manual_review_required"
      ]
    },
    "manual_review_zones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
