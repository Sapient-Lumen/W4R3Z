{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/crate-diagnosis-surface-pack-kit/triage-origin.receipt.schema.json",
  "title": "Triage origin receipt",
  "type": "object",
  "required": ["symptom", "step", "origin_class", "source", "authority"],
  "properties": {
    "symptom": {"type": "string"},
    "step": {"type": "string"},
    "origin_class": {"type": "string", "enum": ["docs", "code", "self_check", "signal_surface", "runtime_warning", "manual_review"]},
    "source": {"type": "string"},
    "authority": {"type": "string", "enum": ["maintainer_declared", "fixture_observed", "imported", "manual_review_required"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
