{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemediationPlaybookManifest",
  "type": "object",
  "required": [
    "symptom",
    "remediations"
  ],
  "properties": {
    "symptom": {"type": "string"},
    "remediations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["remediation_kind", "confidence"],
        "properties": {
          "remediation_kind": {
            "enum": [
              "adjust_config",
              "enable_signal",
              "capture_bundle",
              "reduce_concurrency",
              "switch_topology",
              "manual_review_required"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "manual_review_required"
            ]
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
