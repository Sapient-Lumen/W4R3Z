{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SelfCheckManifest",
  "type": "object",
  "required": [
    "crate",
    "checks"
  ],
  "properties": {
    "crate": {"type": "string"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "check_kind", "automation_level"],
        "properties": {
          "name": {"type": "string"},
          "check_kind": {
            "enum": [
              "pure_local_check",
              "config_sanity_check",
              "loopback_probe",
              "runtime_snapshot",
              "feature_matrix_review",
              "doctor_subcommand",
              "manual_review_required"
            ]
          },
          "automation_level": {
            "enum": [
              "fully_automated",
              "guided",
              "manual_review_required"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "enum": [
                "no_network",
                "loopback_only",
                "credentials",
                "board_or_device",
                "elevated_privileges"
              ]
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "enum": [
                "boolean_pass_fail",
                "structured_report",
                "human_summary",
                "runtime_snapshot",
                "manual_review_required"
              ]
            }
          }
        }
      }
    }
  }
}
