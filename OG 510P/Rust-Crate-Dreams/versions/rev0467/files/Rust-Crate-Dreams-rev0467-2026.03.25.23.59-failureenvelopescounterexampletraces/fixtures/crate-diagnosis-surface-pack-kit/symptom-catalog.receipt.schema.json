{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SymptomCatalogReceipt",
  "type": "object",
  "required": [
    "crate",
    "symptoms"
  ],
  "properties": {
    "crate": {"type": "string"},
    "symptoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "symptom_class", "support_level"],
        "properties": {
          "name": {"type": "string"},
          "symptom_class": {"type": "string"},
          "support_level": {"type": "string"},
          "aliases": {
            "type": "array",
            "items": {"type": "string"}
          },
          "diagnostic_codes": {
            "type": "array",
            "items": {"type": "string"}
          },
          "docs_url": {"type": "string"}
        }
      }
    }
  }
}
