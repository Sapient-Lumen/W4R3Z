{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosisSurfacePack",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "symptoms"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "symptom_taxonomy_profile": {"type": "string"},
    "capture_policy_profile": {"type": "string"},
    "symptoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "symptom_class", "support_level", "automation_level"],
        "properties": {
          "name": {"type": "string"},
          "symptom_class": {
            "enum": [
              "startup_stall",
              "request_hang",
              "retry_storm",
              "queue_growth",
              "idle_but_busy",
              "high_cpu",
              "auth_drift",
              "config_mismatch",
              "resource_exhaustion",
              "manual_review_required"
            ]
          },
          "support_level": {
            "enum": [
              "official_triage",
              "official_self_check",
              "official_signal_map",
              "official_capture_bundle",
              "partial_support",
              "manual_review_required"
            ]
          },
          "automation_level": {
            "enum": [
              "fully_automated",
              "guided",
              "manual_review_required"
            ]
          },
          "environment_class": {
            "enum": [
              "pure_local",
              "local_runtime",
              "loopback_only",
              "external_service",
              "credentialed_service",
              "board_or_device",
              "manual_review_required"
            ]
          },
          "primary_triage": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
