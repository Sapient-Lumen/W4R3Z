{
  "schema_version": "1",
  "subject": "demo-sys 0.4.0",
  "actor_scope": "demo-sys build.rs",
  "mode": "whitelist",
  "default_posture": "deny",
  "allowed_keys": ["HOST", "TARGET", "OUT_DIR", "OPT_LEVEL", "CC", "CFLAGS", "PKG_CONFIG_PATH"],
  "stripped_keys": ["AWS_SECRET_ACCESS_KEY", "CI_JOB_TOKEN", "SSH_AUTH_SOCK"],
  "allowed_path_roots": ["$CARGO_MANIFEST_DIR", "$OUT_DIR", "/usr/bin", "/opt/homebrew/bin", "/opt/homebrew/lib"],
  "project_local_override_posture": "rejected",
  "toolchain_auto_install_posture": "disabled",
  "notes": "deny-by-default for unspecified env channels; explicit whitelist required for compiler and pkg-config ingress"
}
