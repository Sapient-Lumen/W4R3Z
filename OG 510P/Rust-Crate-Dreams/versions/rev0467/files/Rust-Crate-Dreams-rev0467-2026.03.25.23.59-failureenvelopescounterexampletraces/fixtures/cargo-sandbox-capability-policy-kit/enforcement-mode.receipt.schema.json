{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/cargo-sandbox-capability-policy-kit/enforcement-mode.receipt.schema.json",
  "title": "Enforcement Mode Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "mode",
    "denial_behavior",
    "backend_family",
    "granularity_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "observe",
        "audit",
        "enforce"
      ]
    },
    "denial_behavior": {
      "enum": [
        "record_only",
        "warn",
        "block"
      ]
    },
    "backend_family": {
      "type": "string"
    },
    "granularity_class": {
      "enum": [
        "per_build_script",
        "shared_proc_macro_wrapper",
        "whole_rustc_lane",
        "mixed",
        "manual_review_required"
      ]
    },
    "known_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
