{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/cargo-sandbox-capability-policy-kit/actor-capability.matrix.schema.json",
  "title": "Actor Capability Matrix",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "actors"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "actor_name",
          "actor_class",
          "granularity",
          "network",
          "process_spawn"
        ],
        "properties": {
          "actor_name": {
            "type": "string"
          },
          "actor_class": {
            "enum": [
              "build_script",
              "proc_macro_lane",
              "rustc_host_lane",
              "compile_time_deps_workflow",
              "manual_review"
            ]
          },
          "granularity": {
            "enum": [
              "separate_actor",
              "shared_lane",
              "manual_review_required"
            ]
          },
          "fs_read_roots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fs_write_roots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env_read": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "network": {
            "enum": [
              "deny",
              "allow",
              "allowlist",
              "manual_review_required"
            ]
          },
          "process_spawn": {
            "enum": [
              "deny",
              "allow",
              "allowlist",
              "manual_review_required"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
