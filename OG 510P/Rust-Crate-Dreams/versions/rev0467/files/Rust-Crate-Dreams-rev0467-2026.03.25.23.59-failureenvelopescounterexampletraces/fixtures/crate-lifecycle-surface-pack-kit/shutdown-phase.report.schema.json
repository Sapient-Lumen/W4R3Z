{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/crate-lifecycle-surface-pack-kit/shutdown-phase.report.schema.json",
  "title": "shutdown-phase.report",
  "type": "object",
  "required": ["schema_version", "scenario", "subject", "phase_reached", "phase_order", "budget_basis", "evidence_basis"],
  "properties": {
    "schema_version": {"type": "string"},
    "scenario": {"type": "string"},
    "subject": {"type": "string"},
    "phase_reached": {
      "type": "string",
      "enum": [
        "signal_sent",
        "accepting_stopped",
        "tracked_tasks_drained",
        "protocol_close_attempted",
        "protocol_drains_finished",
        "runtime_wait_abandoned",
        "manual_review_required"
      ]
    },
    "phase_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "budget_basis": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"type": "string", "enum": ["none", "graceful_only", "timeout_budget", "external_policy", "manual_review_required"]},
        "budget_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "surviving_classes": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "evidence_basis": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  },
  "additionalProperties": false
}
