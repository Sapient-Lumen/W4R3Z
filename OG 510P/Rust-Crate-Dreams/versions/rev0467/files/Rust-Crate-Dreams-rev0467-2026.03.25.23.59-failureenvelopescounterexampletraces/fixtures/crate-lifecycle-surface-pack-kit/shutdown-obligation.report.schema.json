{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShutdownObligationReport",
  "type": "object",
  "required": [
    "crate",
    "obligations"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "importance"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "importance": {
            "enum": [
              "mandatory",
              "advisory",
              "automatic",
              "manual_review_required"
            ]
          },
          "action": {
            "enum": [
              "flush",
              "shutdown",
              "close",
              "join",
              "drain",
              "cancel",
              "await",
              "manual_review_required"
            ]
          },
          "loss_if_skipped": {
            "type": "string"
          }
        }
      }
    }
  }
}
