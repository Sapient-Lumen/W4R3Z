{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle Stop Semantics Receipt",
  "type": "object",
  "required": ["schema_version", "crate", "component", "stop_class"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "component": {"type": "string"},
    "stop_class": {
      "type": "string",
      "enum": [
        "drop_detaches",
        "drop_aborts",
        "cancel_then_wait",
        "close_then_join",
        "abort_best_effort",
        "blocking_work_not_abortable",
        "manual_review_required"
      ]
    },
    "evidence_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "drop_observed",
          "abort_called",
          "close_called",
          "shutdown_called",
          "join_completed",
          "tracker_closed",
          "tracker_wait_completed",
          "cancellation_requested",
          "blocking_task_returned",
          "manual_review_required"
        ]
      }
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
