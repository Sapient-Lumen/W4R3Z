{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/crate-lifecycle-surface-pack-kit/timeout-aftermath.receipt.schema.json",
  "title": "timeout-aftermath.receipt",
  "type": "object",
  "required": ["schema_version", "scenario", "subject", "after_timeout", "still_running_classes", "required_followup", "evidence_basis"],
  "properties": {
    "schema_version": {"type": "string"},
    "scenario": {"type": "string"},
    "subject": {"type": "string"},
    "after_timeout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "wait_stopped_only",
          "task_still_running",
          "blocking_thread_survives",
          "resource_handles_invalidated",
          "manual_abort_still_required",
          "manual_review_required"
        ]
      }
    },
    "still_running_classes": {"type": "array", "items": {"type": "string"}},
    "required_followup": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "evidence_basis": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  },
  "additionalProperties": false
}
