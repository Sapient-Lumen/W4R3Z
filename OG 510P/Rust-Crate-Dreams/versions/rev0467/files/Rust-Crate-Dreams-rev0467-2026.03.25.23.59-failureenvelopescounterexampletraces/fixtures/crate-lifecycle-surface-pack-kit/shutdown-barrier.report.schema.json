{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle Shutdown Barrier Report",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "barrier_name",
    "barrier_class",
    "observed_outcome"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "barrier_name": {
      "type": "string"
    },
    "barrier_class": {
      "type": "string",
      "enum": [
        "signal_sent_only",
        "listener_stopped",
        "tracked_tasks_closed_and_empty",
        "protocol_drains_finished",
        "manual_review_required"
      ]
    },
    "covered_components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_escape_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "detached_task",
          "upgraded_connection_task",
          "pending_stream_dependency",
          "blocking_worker",
          "external_worker",
          "manual_review_required"
        ]
      }
    },
    "observed_outcome": {
      "type": "string",
      "enum": [
        "completed_all_covered_components",
        "completed_with_known_escape_paths",
        "blocked_by_pending_component",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
