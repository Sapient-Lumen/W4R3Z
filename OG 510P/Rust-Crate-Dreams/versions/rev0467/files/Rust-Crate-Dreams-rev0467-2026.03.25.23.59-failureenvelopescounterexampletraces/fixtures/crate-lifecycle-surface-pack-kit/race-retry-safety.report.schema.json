{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RaceRetrySafetyReport",
  "type": "object",
  "required": [
    "crate",
    "operations"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "retry"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "retry": {
            "enum": [
              "idempotent",
              "safe_to_recreate",
              "at_most_once",
              "manual_review_required"
            ]
          },
          "close_race": {
            "enum": [
              "no",
              "yes",
              "manual_review_required"
            ]
          }
        }
      }
    }
  }
}
