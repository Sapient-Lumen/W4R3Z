{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle Escape Path Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "component",
    "escape_class",
    "stop_route"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "component": {
      "type": "string"
    },
    "escape_class": {
      "type": "string",
      "enum": [
        "detached_task",
        "upgraded_connection_task",
        "pending_stream_dependency",
        "blocking_worker",
        "external_worker",
        "manual_review_required"
      ]
    },
    "joined_to_barrier": {
      "type": "boolean"
    },
    "stop_route": {
      "type": "string",
      "enum": [
        "inherits_parent_barrier",
        "requires_shared_cancellation_token",
        "requires_explicit_close",
        "requires_upstream_wakeup",
        "requires_manual_fencing",
        "not_connected",
        "manual_review_required"
      ]
    },
    "evidence_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "server_shutdown_future_completed",
          "component_still_running",
          "join_handle_dropped",
          "joinset_detached",
          "upgrade_spawned",
          "pending_stream_waiting",
          "explicit_abort_required",
          "tracker_wait_completed",
          "manual_review_required"
        ]
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
