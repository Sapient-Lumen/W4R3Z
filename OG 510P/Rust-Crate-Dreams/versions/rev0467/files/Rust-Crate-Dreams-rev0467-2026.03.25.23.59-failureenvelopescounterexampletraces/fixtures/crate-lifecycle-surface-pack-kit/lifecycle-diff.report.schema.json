{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LifecycleDiffReport",
  "type": "object",
  "required": [
    "crate",
    "changes"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "subject"
        ],
        "properties": {
          "kind": {
            "enum": [
              "background_work_added",
              "background_work_removed",
              "cancel_semantics_changed",
              "shutdown_obligation_changed",
              "abort_behavior_changed",
              "drain_recipe_changed",
              "manual_review_required"
            ]
          },
          "subject": {
            "type": "string"
          }
        }
      }
    }
  }
}
