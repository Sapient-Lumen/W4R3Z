{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/cargo-vendor-source-parity-kit/source-coverage.report.schema.json",
  "title": "SourceCoverageReport",
  "type": "object",
  "required": ["schema_version", "declared_policy", "coverage_class", "blockers"],
  "properties": {
    "schema_version": {"type": "string"},
    "declared_policy": {"type": "string", "enum": ["registry_equivalent", "vendored_offline", "airgap_candidate", "mixed"]},
    "coverage_class": {"type": "string", "enum": ["complete", "complete_with_aliases", "incomplete", "manual_review_required"]},
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "summary"],
        "properties": {
          "kind": {"type": "string", "enum": ["source_alias_split", "git_history_required", "path_dependency_external", "checksum_or_content_drift", "missing_vendored_member", "offline_resolution_may_differ", "manual_review_required"]},
          "summary": {"type": "string"},
          "packages": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "recommended_actions": {"type": "array", "items": {"type": "string"}}
  }
}
