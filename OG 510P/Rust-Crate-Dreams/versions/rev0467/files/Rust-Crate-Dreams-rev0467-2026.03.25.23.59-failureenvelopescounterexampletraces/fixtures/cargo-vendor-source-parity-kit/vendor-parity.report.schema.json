{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-vendor-source-parity/vendor-parity.report.schema.json",
  "title": "Cargo vendor parity report",
  "type": "object",
  "required": ["schema_version", "verdict"],
  "properties": {
    "schema_version": {"type": "string"},
    "verdict": {
      "type": "string",
      "enum": [
        "registry_equivalent",
        "mirror_verified_but_mixed_sources",
        "source_alias_split",
        "patch_overlay_present",
        "git_history_required",
        "path_dependency_external",
        "checksum_or_content_drift",
        "missing_vendored_member",
        "offline_resolution_may_differ",
        "manual_review_required"
      ]
    },
    "summary": {"type": "string"}
  },
  "additionalProperties": false
}
