{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/reprobuildbundle/build-recipe.schema.json",
  "title": "Reprobuild Build Recipe",
  "type": "object",
  "required": [
    "schema_version",
    "package",
    "source",
    "toolchain",
    "build",
    "environment",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "build-recipe@1"},
    "package": {
      "type": "object",
      "required": ["name", "version", "target"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "target": {"type": "string"}
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["kind", "digest"],
      "properties": {
        "kind": {"enum": ["git", "registry-tarball", "local-tree"]},
        "digest": {"type": "string"},
        "cargo_lock_sha256": {"type": "string"}
      },
      "additionalProperties": true
    },
    "toolchain": {
      "type": "object",
      "required": ["rustc", "cargo"],
      "properties": {
        "rustc": {"type": "string"},
        "cargo": {"type": "string"},
        "linker": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "build": {
      "type": "object",
      "required": ["profile", "locked", "features"],
      "properties": {
        "profile": {"type": "string"},
        "locked": {"type": "boolean"},
        "offline": {"type": "boolean"},
        "features": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "properties": {
        "source_date_epoch": {"type": ["integer", "null"]},
        "trim_paths": {"type": ["string", "boolean", "null"]},
        "remap_cwd_prefix": {"type": ["string", "null"]},
        "locale": {"type": ["string", "null"]},
        "timezone": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
