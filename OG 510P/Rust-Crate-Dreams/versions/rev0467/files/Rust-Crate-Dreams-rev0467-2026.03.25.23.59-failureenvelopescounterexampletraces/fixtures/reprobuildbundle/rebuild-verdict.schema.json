{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/reprobuildbundle/rebuild-verdict.schema.json",
  "title": "Reprobuild Rebuild Verdict",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "comparison_mode",
    "result"
  ],
  "properties": {
    "schema_version": {"const": "rebuild-verdict@1"},
    "subject": {
      "type": "object",
      "required": ["package", "version"],
      "properties": {
        "package": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "comparison_mode": {
      "type": "object",
      "properties": {
        "bitwise": {"type": "boolean"},
        "semantic_normalization": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "result": {
      "enum": [
        "reproduced",
        "semantically-reproduced",
        "mismatch",
        "not-comparable",
        "manual-review-required"
      ]
    },
    "normalizations_applied": {
      "type": "array",
      "items": {"type": "string"}
    },
    "caveats": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommended_next_action": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
