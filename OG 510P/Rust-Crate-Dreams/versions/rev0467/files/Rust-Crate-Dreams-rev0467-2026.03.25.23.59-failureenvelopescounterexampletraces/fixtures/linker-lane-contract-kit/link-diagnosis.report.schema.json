{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/link-diagnosis.report.schema.json",
  "title": "LinkDiagnosisReport",
  "type": "object",
  "required": ["schema_version", "target", "verdict"],
  "properties": {
    "schema_version": {"type": "string"},
    "target": {"type": "string"},
    "verdict": {
      "type": "string",
      "enum": [
        "ok",
        "linker_not_found",
        "sdk_missing",
        "sysroot_missing",
        "driver_flag_scope_mismatch",
        "host_flag_leakage",
        "search_path_mismatch",
        "crt_or_runtime_mismatch",
        "lane_unsupported_here",
        "manual_review_required"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["observed-fact", "conservative-inference", "manual-review-required"]
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "suggested_next_steps": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
