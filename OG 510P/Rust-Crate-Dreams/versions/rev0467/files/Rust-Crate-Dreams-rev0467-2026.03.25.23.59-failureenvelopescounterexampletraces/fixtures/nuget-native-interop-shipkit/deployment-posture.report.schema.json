{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/nuget-native-interop-shipkit/deployment-posture.report.schema.json",
  "title": "NugetDeploymentPostureReport",
  "type": "object",
  "required": [
    "package_name",
    "posture_class",
    "declared_modes",
    "supported_modes"
  ],
  "properties": {
    "package_name": {
      "type": "string"
    },
    "posture_class": {
      "type": "string",
      "enum": [
        "jit_default_supported",
        "single_file_sensitive",
        "native_aot_sensitive",
        "deployment_claim_exceeds_evidence",
        "manual_review_required"
      ]
    },
    "declared_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mode",
          "reason"
        ],
        "properties": {
          "mode": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "error",
              "manual_review"
            ]
          }
        }
      }
    }
  }
}
