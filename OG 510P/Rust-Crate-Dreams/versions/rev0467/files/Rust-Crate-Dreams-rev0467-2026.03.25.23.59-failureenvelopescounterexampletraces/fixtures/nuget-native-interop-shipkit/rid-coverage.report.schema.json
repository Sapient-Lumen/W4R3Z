{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/nuget-native-interop-shipkit/rid-coverage.report.schema.json",
  "title": "NugetRidCoverageReport",
  "type": "object",
  "required": [
    "package_name",
    "coverage_class",
    "declared_rids",
    "shipped_assets"
  ],
  "properties": {
    "package_name": {
      "type": "string"
    },
    "coverage_class": {
      "type": "string",
      "enum": [
        "portable_rid_matrix_complete",
        "rid_asset_gap",
        "legacy_rid_graph_assumption",
        "managed_wrapper_claim_exceeds_assets",
        "manual_review_required"
      ]
    },
    "declared_rids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shipped_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rid",
          "artifact_name"
        ],
        "properties": {
          "rid": {
            "type": "string"
          },
          "artifact_name": {
            "type": "string"
          },
          "native_library_name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "cdylib",
              "staticlib",
              "unknown"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rid",
          "reason"
        ],
        "properties": {
          "rid": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "error",
              "manual_review"
            ]
          }
        }
      }
    }
  }
}
