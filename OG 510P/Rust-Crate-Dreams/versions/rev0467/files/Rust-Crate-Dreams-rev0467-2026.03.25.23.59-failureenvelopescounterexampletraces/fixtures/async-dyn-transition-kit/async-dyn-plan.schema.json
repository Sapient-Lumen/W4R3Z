{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Async Dyn Plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "workspace",
    "trait_family",
    "current_recipe",
    "migration_goal"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "trait_family": {
      "type": "string"
    },
    "current_recipe": {
      "type": "string"
    },
    "candidate_recipe": {
      "type": "string"
    },
    "toolchain_window": {
      "type": "string"
    },
    "allocation_policy": {
      "type": "string"
    },
    "migration_goal": {
      "type": "string"
    },
    "redaction": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
