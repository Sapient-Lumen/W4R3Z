{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Object Surface Diff",
  "type": "object",
  "required": [
    "schema_version",
    "trait_family",
    "from_recipe",
    "to_recipe",
    "public_promise_changed",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "trait_family": {
      "type": "string"
    },
    "from_recipe": {
      "type": "string"
    },
    "to_recipe": {
      "type": "string"
    },
    "public_promise_changed": {
      "type": "boolean"
    },
    "allocation_changed": {
      "type": "boolean"
    },
    "sendability_changed": {
      "type": "boolean"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "same-public-promise",
        "recipe-only-drift",
        "manual-review-required",
        "breaking-surface-change",
        "unknown"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
