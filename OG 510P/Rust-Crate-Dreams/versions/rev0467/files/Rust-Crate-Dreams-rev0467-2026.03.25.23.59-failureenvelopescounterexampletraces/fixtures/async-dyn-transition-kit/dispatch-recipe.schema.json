{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dispatch Recipe",
  "type": "object",
  "required": [
    "schema_version",
    "trait_family",
    "recipe_kind",
    "dynamic_dispatch_supported",
    "allocation_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "trait_family": {
      "type": "string"
    },
    "recipe_kind": {
      "type": "string",
      "enum": [
        "async-trait",
        "trait-variant",
        "dynosaur",
        "dynify",
        "local-adapter",
        "native-only",
        "unknown"
      ]
    },
    "dynamic_dispatch_supported": {
      "type": "boolean"
    },
    "send_variant": {
      "type": "string",
      "enum": [
        "none",
        "generated",
        "manual",
        "unknown"
      ]
    },
    "object_surface": {
      "type": "string",
      "enum": [
        "boxed-future",
        "generated-wrapper",
        "static-only",
        "mixed",
        "unknown"
      ]
    },
    "allocation_class": {
      "type": "string",
      "enum": [
        "boxed",
        "caller-owned",
        "arena-or-buffer",
        "none-observed",
        "unknown"
      ]
    },
    "public_promise": {
      "type": "string"
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
