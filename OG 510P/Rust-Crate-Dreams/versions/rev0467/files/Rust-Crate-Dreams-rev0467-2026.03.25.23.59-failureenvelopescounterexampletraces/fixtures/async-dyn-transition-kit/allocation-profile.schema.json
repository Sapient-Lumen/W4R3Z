{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Allocation Profile",
  "type": "object",
  "required": [
    "schema_version",
    "trait_family",
    "allocation_class",
    "sendability"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "trait_family": {
      "type": "string"
    },
    "allocation_class": {
      "type": "string"
    },
    "sendability": {
      "type": "string",
      "enum": [
        "send",
        "local-only",
        "mixed",
        "unknown"
      ]
    },
    "future_storage": {
      "type": "string"
    },
    "heap_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
