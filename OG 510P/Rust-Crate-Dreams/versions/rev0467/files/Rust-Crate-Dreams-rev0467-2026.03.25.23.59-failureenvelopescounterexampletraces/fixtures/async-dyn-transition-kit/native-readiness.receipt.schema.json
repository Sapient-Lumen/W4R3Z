{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Readiness Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "trait_family",
    "current_recipe",
    "native_dependency",
    "retirement_posture",
    "public_surface_expectation"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "trait_family": {
      "type": "string"
    },
    "current_recipe": {
      "type": "string"
    },
    "native_dependency": {
      "type": "string",
      "enum": [
        "not-needed",
        "would-simplify",
        "planned-migration",
        "blocked-by-surface",
        "manual-review-required"
      ]
    },
    "retirement_posture": {
      "type": "string",
      "enum": [
        "bridge-is-stopgap",
        "dual-support-window-expected",
        "bridge-is-part-of-public-contract",
        "unknown"
      ]
    },
    "public_surface_expectation": {
      "type": "string",
      "enum": [
        "same-surface-expected",
        "surface-may-change",
        "allocation-may-change",
        "manual-review-required"
      ]
    },
    "blocking_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
