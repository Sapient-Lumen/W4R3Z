{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/littlefs-native-adoption-kit/powercut-run.report.schema.json",
  "title": "PowercutRunReport",
  "type": "object",
  "required": [
    "campaign_identity",
    "injection_points",
    "remount_verdict",
    "recovery_class",
    "manual_review_required"
  ],
  "properties": {
    "campaign_identity": {"type": "string"},
    "injection_points": {"type": "array", "items": {"type": "string"}},
    "remount_verdict": {"type": "string", "enum": ["passed", "failed", "manual_review_required"]},
    "recovery_class": {
      "type": "string",
      "enum": ["last_known_good_recovered", "fs_consistent_but_latest_write_lost", "corruption_detected", "unknown"]
    },
    "surviving_assertions": {"type": "array", "items": {"type": "string"}},
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": true
}
