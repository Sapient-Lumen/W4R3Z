{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/littlefs-native-adoption-kit/compatibility-witness.receipt.schema.json",
  "title": "CompatibilityWitnessReceipt",
  "type": "object",
  "required": [
    "backend_identity",
    "fixture_identity",
    "mount_verdict",
    "ops_exercised",
    "manual_review_required"
  ],
  "properties": {
    "backend_identity": {"type": "string"},
    "fixture_identity": {"type": "string"},
    "mount_verdict": {"type": "string", "enum": ["passed", "failed", "manual_review_required"]},
    "ops_exercised": {"type": "array", "items": {"type": "string"}},
    "upstream_crosscheck": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": true
}
