{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/evidencebundle-core-kit/share-safety.receipt.schema.json",
  "title": "share-safety.receipt",
  "type": "object",
  "required": [
    "audience",
    "posture",
    "residual_risks"
  ],
  "properties": {
    "audience": {
      "type": "string"
    },
    "posture": {
      "type": "string",
      "enum": [
        "private_only",
        "redacted_shareable",
        "encrypted_shareable",
        "manual_review_required"
      ]
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redaction_dependency": {
      "type": "string"
    },
    "allowed_channels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
