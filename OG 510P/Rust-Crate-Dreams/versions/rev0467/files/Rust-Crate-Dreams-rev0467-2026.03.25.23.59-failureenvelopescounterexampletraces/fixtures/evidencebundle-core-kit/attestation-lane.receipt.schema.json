{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/evidencebundle-core-kit/attestation-lane.receipt.schema.json",
  "title": "attestation-lane.receipt",
  "type": "object",
  "required": [
    "lane_kind",
    "generation_posture",
    "subject_binding",
    "verification_dependencies"
  ],
  "properties": {
    "lane_kind": {
      "type": "string",
      "enum": [
        "none",
        "dsse",
        "cose",
        "sigstore_bundle",
        "mixed",
        "other"
      ]
    },
    "generation_posture": {
      "type": "string",
      "enum": [
        "generated_here",
        "imported",
        "mixed",
        "none"
      ]
    },
    "subject_binding": {
      "type": "string"
    },
    "envelope_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_trust_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
