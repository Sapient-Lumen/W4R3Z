{
  "entries": [
    {
      "path": "artifacts/raw/runner.log",
      "kind": "text_log",
      "lineage_class": "raw",
      "comparison_posture": "bytewise",
      "share_sensitivity": "contains hostnames"
    },
    {
      "path": "projections/runner.normalized.json",
      "kind": "normalized_log_projection",
      "lineage_class": "projection",
      "derived_from": [
        "artifacts/raw/runner.log"
      ],
      "comparison_posture": "semantic",
      "share_sensitivity": "redaction reviewed"
    },
    {
      "path": "attestations/release.sigstore.json",
      "kind": "sigstore_bundle",
      "lineage_class": "imported",
      "comparison_posture": "semantic",
      "share_sensitivity": "public_verification_material"
    },
    {
      "path": "review/README.md",
      "kind": "generated_summary",
      "lineage_class": "generated",
      "derived_from": [
        "artifacts/raw/runner.log",
        "projections/runner.normalized.json",
        "attestations/release.sigstore.json"
      ],
      "comparison_posture": "manual_review",
      "share_sensitivity": "manual_review_required"
    }
  ]
}
