{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/evidencebundle-core-kit/container-basis.receipt.schema.json",
  "title": "container-basis.receipt",
  "type": "object",
  "required": [
    "bundle_profile",
    "archive_format",
    "entry_order",
    "timestamp_policy",
    "path_policy",
    "digest_algorithms",
    "reproducibility_posture"
  ],
  "properties": {
    "bundle_profile": {
      "type": "string"
    },
    "archive_format": {
      "type": "string",
      "enum": [
        "zip",
        "tar",
        "dir",
        "other"
      ]
    },
    "entry_order": {
      "type": "string"
    },
    "timestamp_policy": {
      "type": "string"
    },
    "path_policy": {
      "type": "string"
    },
    "compression_policy": {
      "type": "string"
    },
    "digest_algorithms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "canonicalization": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reproducibility_posture": {
      "type": "string",
      "enum": [
        "byte_reproducible",
        "semantically_reproducible",
        "profile_defined",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
