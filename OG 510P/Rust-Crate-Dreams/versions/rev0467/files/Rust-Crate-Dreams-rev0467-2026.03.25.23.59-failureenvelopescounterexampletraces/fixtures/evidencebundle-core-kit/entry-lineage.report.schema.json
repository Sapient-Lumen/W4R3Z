{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/evidencebundle-core-kit/entry-lineage.report.schema.json",
  "title": "entry-lineage.report",
  "type": "object",
  "required": [
    "entries"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "lineage_class"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "lineage_class": {
            "type": "string",
            "enum": [
              "raw",
              "projection",
              "generated",
              "imported",
              "copied",
              "redacted"
            ]
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "comparison_posture": {
            "type": "string",
            "enum": [
              "bytewise",
              "semantic",
              "manual_review"
            ]
          },
          "share_sensitivity": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
