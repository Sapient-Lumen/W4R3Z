{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/evidencebundle-core-kit/diff-report.schema.json",
  "title": "Evidence Bundle Diff Report",
  "type": "object",
  "required": ["schema_version", "left_bundle_id", "right_bundle_id", "changes"],
  "properties": {
    "schema_version": {"const": "evidencebundle-diff@1"},
    "left_bundle_id": {"type": "string"},
    "right_bundle_id": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "change_class"],
        "properties": {
          "path": {"type": "string"},
          "change_class": {
            "enum": ["added", "removed", "content-changed", "policy-changed", "signature-changed", "redaction-only"]
          },
          "manual_review": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
