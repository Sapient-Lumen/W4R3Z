{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doctest Manifest",
  "type": "object",
  "properties": {
    "crate": {
      "type": "string"
    },
    "rustdoc": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "item_path": {
            "type": "string"
          },
          "source_span": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "language": {
            "type": "string"
          },
          "edition": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "item_path",
          "source_span"
        ]
      }
    }
  },
  "required": [
    "crate",
    "cases"
  ]
}
