{
  "bundle_id": "mycrate-0.9.0-docs-support-bundle",
  "crate": "mycrate",
  "version": "0.9.0",
  "artifacts": [
    {
      "kind": "doctest.manifest",
      "path": "artifacts/doctest.manifest.json",
      "required_for_review": true,
      "redaction": "none"
    },
    {
      "kind": "extraction-basis.receipt",
      "path": "artifacts/extraction-basis.receipt.json",
      "required_for_review": true,
      "redaction": "none"
    },
    {
      "kind": "rewrite-lineage.receipt",
      "path": "artifacts/rewrite-lineage.receipt.json",
      "required_for_review": true,
      "redaction": "none"
    },
    {
      "kind": "execution-mode.receipt",
      "path": "artifacts/execution-mode.receipt.json",
      "required_for_review": true,
      "redaction": "none"
    },
    {
      "kind": "docs-example-support.report",
      "path": "artifacts/docs-example-support.report.json",
      "required_for_review": true,
      "redaction": "none"
    },
    {
      "kind": "grouping-comparison.report",
      "path": "artifacts/grouping-comparison.report.json",
      "required_for_review": false,
      "redaction": "none"
    },
    {
      "kind": "docs-example-drift.diff",
      "path": "artifacts/docs-example-drift.diff.json",
      "required_for_review": false,
      "redaction": "none"
    },
    {
      "kind": "runner-profile.import",
      "path": "imports/doctest-runtool-profile.receipt.json",
      "required_for_review": false,
      "redaction": "none"
    },
    {
      "kind": "docsrs-parity.import",
      "path": "imports/docsrs-parity.report.json",
      "required_for_review": false,
      "redaction": "summary_only"
    }
  ],
  "import_refs": [
    "P-0481 doctest runtool profile for target/emulator route truth",
    "P-0472 docs.rs parity for hosted build and sandbox behavior"
  ],
  "summary": "Portable bundle for docs-example support review that keeps basis, rewrite, execution, support, and adjacent imports separate.",
  "manual_review": [
    "Markdown-only examples outside rustdoc collection remain out of scope unless imported separately.",
    "Hosted docs.rs rendering should not be read as execution success without support-report evidence."
  ]
}
