{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docs Example Support Report",
  "type": "object",
  "properties": {
    "crate": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "surface": {
            "type": "string",
            "enum": [
              "host-run",
              "target-run",
              "compile-only",
              "ignored",
              "docsrs-render",
              "manual-review"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "conditional",
              "unsupported",
              "not-claimed"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "surface",
          "status"
        ]
      }
    }
  },
  "required": [
    "crate",
    "entries"
  ]
}
