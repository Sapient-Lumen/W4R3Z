{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution Mode Receipt",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "standalone",
        "merged",
        "compile-only",
        "ignored",
        "wrapper-executed",
        "render-only"
      ]
    },
    "runner": {
      "type": "string"
    },
    "grouping_basis": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "case_id",
    "mode"
  ]
}
