{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/assurance-case-workbench-kit/assurance-profile.schema.json",
  "title": "Assurance Profile",
  "type": "object",
  "required": ["version", "profile_id", "subject", "imports"],
  "properties": {
    "version": { "type": "string" },
    "profile_id": { "type": "string" },
    "subject": {
      "type": "object",
      "required": ["name", "release"],
      "properties": {
        "name": { "type": "string" },
        "release": { "type": "string" },
        "component_path": { "type": "string" }
      },
      "additionalProperties": true
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "path"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "path": { "type": "string" },
          "required_for_green": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "redaction_policy": { "type": "object", "additionalProperties": true },
    "freshness_policy": { "type": "object", "additionalProperties": true },
    "export": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
