{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/assurance-case-workbench-kit/assumption-ledger.report.schema.json",
  "title": "Assumption Ledger Report",
  "type": "object",
  "required": ["version", "top_level_effect", "assumptions"],
  "properties": {
    "version": { "type": "string" },
    "top_level_effect": { "type": "string", "enum": ["none", "manual-review", "partial", "blocked"] },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assumption_id", "status", "supports_claim_ids"],
        "properties": {
          "assumption_id": { "type": "string" },
          "status": { "type": "string", "enum": ["resolved", "open", "waived", "manual-review", "blocked"] },
          "owner": { "type": "string" },
          "supports_claim_ids": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
