{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/assurance-case-workbench-kit/claim-graph.schema.json",
  "title": "Assurance Case Workbench Claim Graph",
  "type": "object",
  "required": ["version", "graph_id", "claims", "root_claim_ids"],
  "properties": {
    "version": { "type": "string" },
    "graph_id": { "type": "string" },
    "root_claim_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "text", "status"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["claim", "strategy", "context", "assumption", "justification"]
          },
          "text": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["satisfied", "partial", "assumed", "manual-review", "stale", "unsupported", "waived", "blocked"]
          },
          "supports": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
