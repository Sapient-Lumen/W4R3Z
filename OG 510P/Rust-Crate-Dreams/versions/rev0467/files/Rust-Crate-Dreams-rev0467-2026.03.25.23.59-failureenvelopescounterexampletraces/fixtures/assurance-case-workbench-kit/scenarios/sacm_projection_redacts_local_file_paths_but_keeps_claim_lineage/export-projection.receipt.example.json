{
  "version": "1",
  "format": "sacm-xmi",
  "projection_class": "standards-shaped-lossy",
  "status_mapping": {
    "preserves_status_class": true,
    "manual_review_exported_as": "AssertedContext",
    "blocked_exported_as": "AssertedInferenceWithFailureAnnotation"
  },
  "losses": [
    "local_bundle_paths",
    "review_dashboard_links"
  ],
  "redactions": [
    "workspace_absolute_paths",
    "internal_ticket_urls"
  ]
}
