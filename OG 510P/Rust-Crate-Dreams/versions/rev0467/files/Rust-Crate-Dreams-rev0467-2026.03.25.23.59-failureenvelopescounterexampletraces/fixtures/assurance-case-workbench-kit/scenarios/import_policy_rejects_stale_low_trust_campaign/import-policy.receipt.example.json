{
  "version": "1",
  "accepted_evidence_classes": [
    "verification-campaign",
    "conformance-bundle",
    "manual-review-note"
  ],
  "freshness_policy": {
    "max_age_days": 30,
    "stale_effect": "block"
  },
  "trust_policy": {
    "minimum_default_trust": "medium",
    "manual_review_if_below": true
  },
  "fallback_behavior": "manual-review"
}
