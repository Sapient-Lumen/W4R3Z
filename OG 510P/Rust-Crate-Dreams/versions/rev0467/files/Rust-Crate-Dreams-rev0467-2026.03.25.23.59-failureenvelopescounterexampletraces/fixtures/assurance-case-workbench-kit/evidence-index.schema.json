{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/assurance-case-workbench-kit/evidence-index.schema.json",
  "title": "Evidence Index",
  "type": "object",
  "required": ["version", "artifacts"],
  "properties": {
    "version": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "evidence_class", "source_path", "freshness_status", "supports_claim_ids"],
        "properties": {
          "id": { "type": "string" },
          "evidence_class": {
            "type": "string",
            "enum": ["verification-campaign", "conformance-bundle", "coverage-receipt", "lint-profile", "unsafe-audit", "spec-reference", "manual-review-note", "waiver-note"]
          },
          "source_path": { "type": "string" },
          "profile": { "type": "string" },
          "freshness_status": { "type": "string", "enum": ["fresh", "stale", "unknown"] },
          "provenance": { "type": "object", "additionalProperties": true },
          "automation_kind": { "type": "string", "enum": ["automated", "manual", "assumed"] },
          "trust_level": { "type": "string", "enum": ["high", "medium", "low", "manual-review"] },
          "supports_claim_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
