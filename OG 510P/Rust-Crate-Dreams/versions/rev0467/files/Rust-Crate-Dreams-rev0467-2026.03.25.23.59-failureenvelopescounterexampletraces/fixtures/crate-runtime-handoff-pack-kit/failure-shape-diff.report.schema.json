{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "failure shape diff report",
  "type": "object",
  "required": ["schema_version", "changes"],
  "properties": {
    "schema_version": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "classification"],
        "properties": {
          "case_id": {"type": "string"},
          "classification": {"type": "string"},
          "summary": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": true
}