{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShareSafetyReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field_path",
          "share_class",
          "origin_class"
        ],
        "properties": {
          "field_path": {
            "type": "string"
          },
          "share_class": {
            "enum": [
              "safe_by_default",
              "safe_if_local_only",
              "hashed_for_support",
              "truncated_for_support",
              "omitted_by_default",
              "manual_review_required"
            ]
          },
          "origin_class": {
            "enum": [
              "error_attachment_observed",
              "panic_hook_observed",
              "span_context_observed",
              "report_file_observed",
              "redaction_policy_declared",
              "maintainer_declared",
              "manual_review_required"
            ]
          },
          "transformation": {
            "enum": [
              "none",
              "hash",
              "truncate",
              "omit",
              "summarize",
              "manual_review_required"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
