{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "redaction profile",
  "type": "object",
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": {"type": "string"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["selector", "class"],
        "properties": {
          "selector": {"type": "string"},
          "class": {"type": "string"},
          "action": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": true
}