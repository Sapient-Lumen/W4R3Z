{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "panic handoff receipt",
  "type": "object",
  "required": ["schema_version", "hook_mode", "panic_payload_class"],
  "properties": {
    "schema_version": {"type": "string"},
    "hook_mode": {"type": "string"},
    "panic_payload_class": {"type": "string"},
    "location": {
      "type": "object",
      "properties": {
        "file": {"type": "string"},
        "line": {"type": "integer"},
        "column": {"type": "integer"}
      }
    },
    "report_artifact": {"type": "string"},
    "redaction_notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}