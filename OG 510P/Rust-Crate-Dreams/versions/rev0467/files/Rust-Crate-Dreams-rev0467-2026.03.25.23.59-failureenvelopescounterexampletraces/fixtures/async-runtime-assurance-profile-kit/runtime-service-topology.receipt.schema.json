{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/async-runtime-assurance-profile/runtime-service-topology.receipt.schema.json",
  "title": "async runtime service topology receipt",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "lane_id",
    "runtime_family",
    "scope",
    "services"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "lane_id": {
      "type": "string"
    },
    "runtime_family": {
      "type": "string",
      "enum": [
        "tokio",
        "embassy_executor",
        "rtic",
        "smol",
        "futures_executor",
        "custom",
        "manual_review_required"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "host_only",
        "board_or_rtos_specific",
        "mixed_host_and_target",
        "manual_review_required"
      ]
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "service",
          "provider_kind",
          "availability"
        ],
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "task_spawn",
              "local_task_spawn",
              "time",
              "io",
              "network_resource_construction",
              "signal",
              "process",
              "blocking",
              "manual_review_required"
            ]
          },
          "provider_kind": {
            "type": "string",
            "enum": [
              "runtime_core",
              "resource_driver",
              "runtime_context",
              "hal_time_driver",
              "integrated_timer_queue",
              "priority_dispatcher",
              "compatibility_adapter",
              "application_specific",
              "not_provided",
              "manual_review_required"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "available_with_activation",
              "not_provided",
              "manual_review_required"
            ]
          },
          "activation_route": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "manual_review_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}