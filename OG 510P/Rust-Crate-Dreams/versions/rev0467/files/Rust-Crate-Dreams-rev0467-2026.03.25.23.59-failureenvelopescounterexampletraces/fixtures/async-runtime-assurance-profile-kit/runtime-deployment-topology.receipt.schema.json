{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/async-runtime-assurance-profile/runtime-deployment-topology.receipt.schema.json",
  "title": "async runtime deployment topology receipt",
  "type": "object",
  "required": ["schema_version", "subject", "lanes"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lane_id", "role", "environment_class", "runtime_family", "support_level"],
        "properties": {
          "lane_id": {"type": "string"},
          "role": {"type": "string"},
          "environment_class": {"type": "string"},
          "target_class": {"type": "string"},
          "runtime_family": {"type": "string"},
          "support_level": {"type": "string"},
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "manual_review_gaps": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
