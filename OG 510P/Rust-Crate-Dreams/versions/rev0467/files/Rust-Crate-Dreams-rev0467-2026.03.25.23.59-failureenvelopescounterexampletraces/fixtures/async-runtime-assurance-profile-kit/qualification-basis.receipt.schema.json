{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/async-runtime-assurance-profile/qualification-basis.receipt.schema.json",
  "title": "async runtime qualification basis receipt",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "runtime_family",
    "claim_basis",
    "target_scope"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "runtime_family": {
      "type": "string",
      "enum": [
        "tokio",
        "embassy_executor",
        "rtic",
        "custom",
        "mixed",
        "manual_review_required"
      ]
    },
    "claim_basis": {
      "type": "string",
      "enum": [
        "documentation_only",
        "documentation_plus_metrics",
        "documentation_plus_on_target_measurement",
        "imported_assurance_artifact",
        "mixed",
        "manual_review_required"
      ]
    },
    "target_scope": {
      "type": "string",
      "enum": [
        "host_only",
        "board_or_rtos_specific",
        "mixed_host_and_target",
        "manual_review_required"
      ]
    },
    "imported_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "reference"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "strength": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "open_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_zones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
