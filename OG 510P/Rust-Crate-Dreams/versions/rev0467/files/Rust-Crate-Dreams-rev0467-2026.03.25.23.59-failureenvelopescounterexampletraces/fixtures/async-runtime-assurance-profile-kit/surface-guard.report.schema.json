{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/async-runtime-assurance-profile/surface-guard.report.schema.json",
  "title": "async runtime surface guard report",
  "type": "object",
  "required": ["schema_version", "subject", "guards"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "guards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surface_name", "guard_kind", "guard_expression", "consequence", "basis"],
        "properties": {
          "surface_name": {"type": "string"},
          "lane_id": {"type": "string"},
          "guard_kind": {"type": "string"},
          "guard_expression": {"type": "string"},
          "consequence": {"type": "string"},
          "basis": {"type": "string"},
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
