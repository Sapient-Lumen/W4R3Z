{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "finding-strength.report",
  "type": "object",
  "required": [
    "schema_version",
    "surface",
    "findings",
    "overall_strength_posture",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "surface": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "strength",
          "summary"
        ],
        "properties": {
          "finding_id": {"type": "string"},
          "strength": {
            "type": "string",
            "enum": [
              "definite_breaking",
              "potential_breaking",
              "validation_only",
              "witness_backed",
              "not_evaluated",
              "manual_review_required"
            ]
          },
          "summary": {"type": "string"},
          "witness_available": {"type": "boolean"},
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "overall_strength_posture": {
      "type": "string",
      "enum": [
        "mechanically_strong",
        "mixed_strength",
        "warning_heavy",
        "validation_only_surface",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
