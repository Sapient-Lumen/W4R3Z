{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignalCostReport",
  "type": "object",
  "required": ["schema_version", "crate", "signals"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "cost_class"],
        "properties": {
          "name": {"type": "string"},
          "cost_class": {"enum": ["always_on_low_cost", "conditional_low_cost", "debug_only", "runtime_sensitive", "allocator_sensitive", "high_cardinality_risk", "manual_review_required"]},
          "cardinality_risk": {"enum": ["low", "medium", "high", "manual_review_required"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
