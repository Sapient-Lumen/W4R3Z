{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObservabilityDiffReport",
  "type": "object",
  "required": ["schema_version", "changes"],
  "properties": {
    "schema_version": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "subject"],
        "properties": {
          "kind": {"enum": ["signal_added", "signal_removed", "field_renamed", "stability_changed", "cost_changed", "redaction_changed", "recipe_changed", "manual_review_boundary_changed"]},
          "subject": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
