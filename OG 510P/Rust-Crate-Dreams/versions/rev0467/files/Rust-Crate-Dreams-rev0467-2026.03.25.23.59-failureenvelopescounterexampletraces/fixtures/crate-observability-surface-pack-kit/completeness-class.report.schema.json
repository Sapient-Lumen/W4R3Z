{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "completeness-class.report",
  "type": "object",
  "required": ["schema_version", "crate", "signal_families"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "signal_families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signal_family", "completeness_class"],
        "properties": {
          "signal_family": {"type": "string"},
          "completeness_class": {
            "type": "string",
            "enum": [
              "attempted_all_events",
              "best_effort_buffered",
              "representative_sample",
              "aggregated_window",
              "exit_sensitive",
              "manual_review_required"
            ]
          },
          "reason_refs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
