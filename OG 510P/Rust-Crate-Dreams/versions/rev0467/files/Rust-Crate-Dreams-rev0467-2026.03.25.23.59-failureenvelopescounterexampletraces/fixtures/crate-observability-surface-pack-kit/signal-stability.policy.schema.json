{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signal Stability Policy",
  "type": "object",
  "required": [
    "schema_version",
    "stability_classes"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "stability_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "summary"],
        "properties": {
          "name": {
            "enum": [
              "stable_query_surface",
              "supported_but_evolving",
              "debug_only",
              "internal_only",
              "manual_review_required",
              "unknown"
            ]
          },
          "summary": {"type": "string"},
          "minimum_evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "query_safe": {"type": "boolean"},
          "release_note_required_on_change": {"type": "boolean"}
        }
      }
    }
  },
  "additionalProperties": false
}
