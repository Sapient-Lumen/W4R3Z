{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/schemas/bridge-route.receipt.schema.json",
  "title": "bridge-route.receipt",
  "type": "object",
  "required": ["schema_version", "crate", "signal_family", "routes"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "signal_family": {"type": "string"},
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["route", "status"],
        "properties": {
          "route": {
            "type": "string",
            "enum": [
              "fmt_stdout",
              "fmt_stderr",
              "console",
              "otel_trace",
              "otel_metric",
              "otel_log",
              "collector_side_transform",
              "manual_review_required"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["supported", "supported_with_extra_glue", "unsupported", "manual_review_required"]
          },
          "activation_ref": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
