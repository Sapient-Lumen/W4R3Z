{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schema Convention Profile",
  "type": "object",
  "required": [
    "schema_version",
    "signal_family",
    "naming_posture"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "signal_family": {"type": "string"},
    "semconv_domain": {"type": "string"},
    "schema_url": {"type": "string"},
    "naming_posture": {
      "type": "string",
      "enum": [
        "semconv_aligned",
        "semconv_aligned_with_custom_extensions",
        "custom_names_only",
        "mixed",
        "manual_review_required"
      ]
    },
    "query_compatibility_expectation": {
      "type": "string",
      "enum": [
        "same_schema_url_only",
        "cross_schema_with_migration",
        "best_effort_only",
        "manual_review_required"
      ]
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
