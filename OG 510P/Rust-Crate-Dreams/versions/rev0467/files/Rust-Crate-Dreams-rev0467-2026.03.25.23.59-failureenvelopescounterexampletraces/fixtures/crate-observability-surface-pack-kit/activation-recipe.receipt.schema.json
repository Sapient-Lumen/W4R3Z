{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Activation Recipe Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "recipe_name",
    "requirements"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "recipe_name": {"type": "string"},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "value"],
        "properties": {
          "kind": {
            "enum": [
              "crate_feature",
              "env_var",
              "env_filter_directive",
              "subscriber_layer",
              "per_layer_filter",
              "runtime_flavor",
              "cfg_flag",
              "exporter_bridge",
              "manual_review_required"
            ]
          },
          "value": {"type": "string"},
          "observed": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    },
    "default_visibility": {
      "type": "string",
      "enum": [
        "visible_by_default",
        "hidden_by_default_filter",
        "hidden_without_feature",
        "hidden_without_runtime_support",
        "manual_review_required"
      ]
    }
  },
  "additionalProperties": false
}
