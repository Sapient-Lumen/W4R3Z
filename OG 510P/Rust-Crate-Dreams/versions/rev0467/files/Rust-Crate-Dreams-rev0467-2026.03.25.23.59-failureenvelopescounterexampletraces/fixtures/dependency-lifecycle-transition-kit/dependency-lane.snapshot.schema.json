{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/dependency-lifecycle-transition-kit/dependency-lane.snapshot.schema.json",
  "title": "DependencyLaneSnapshot",
  "type": "object",
  "required": ["workspace", "restricted_packages", "dependencies"],
  "properties": {
    "workspace": {"type": "string"},
    "restricted_packages": {"type": "array", "items": {"type": "string"}},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package", "version", "lane", "consumers"],
        "properties": {
          "package": {"type": "string"},
          "version": {"type": "string"},
          "lane": {"type": "string"},
          "consumers": {"type": "array", "items": {"type": "string"}},
          "source_posture": {"type": "string"}
        }
      }
    }
  }
}
