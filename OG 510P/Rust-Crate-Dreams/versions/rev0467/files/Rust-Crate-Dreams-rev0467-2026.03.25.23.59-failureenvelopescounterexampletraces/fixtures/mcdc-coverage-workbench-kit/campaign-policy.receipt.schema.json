{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "campaign-policy.receipt",
  "type": "object",
  "required": [
    "policy_id",
    "required_support_class",
    "gate_posture"
  ],
  "properties": {
    "policy_id": {"type": "string"},
    "owner": {"type": "string"},
    "required_support_class": {
      "enum": [
        "branch_only",
        "mcdc_preview",
        "manual_review_required"
      ]
    },
    "gate_posture": {
      "enum": [
        "advisory",
        "review_gate",
        "release_gate"
      ]
    },
    "execution_requirement": {
      "enum": [
        "host_ok_for_exploration",
        "target_required_for_gate",
        "mixed_host_target_with_review"
      ]
    },
    "construct_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["construct_family", "policy"],
        "properties": {
          "construct_family": {"type": "string"},
          "policy": {
            "enum": [
              "required",
              "allowed_with_caveats",
              "excluded_until_supported",
              "manual_review_route"
            ]
          },
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
