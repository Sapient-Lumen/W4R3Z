{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "comparison-basis.receipt",
  "type": "object",
  "required": [
    "left_bundle",
    "right_bundle",
    "comparability_verdict",
    "reasons"
  ],
  "properties": {
    "left_bundle": {
      "type": "string"
    },
    "right_bundle": {
      "type": "string"
    },
    "comparability_verdict": {
      "enum": [
        "like_for_like",
        "scope_drift",
        "toolchain_drift",
        "support_drift",
        "not_comparable",
        "manual_review_required"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocking_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
