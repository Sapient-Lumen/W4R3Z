{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "independence-pair.report",
  "type": "object",
  "required": [
    "decision_id",
    "conditions"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "condition_id",
          "verdict",
          "expected_pairs",
          "witnessed_pairs"
        ],
        "properties": {
          "condition_id": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "demonstrated",
              "partial",
              "not_demonstrated",
              "not_applicable",
              "blocked_by_support_gap"
            ]
          },
          "expected_pairs": {
            "type": "integer"
          },
          "witnessed_pairs": {
            "type": "integer"
          },
          "witness_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
