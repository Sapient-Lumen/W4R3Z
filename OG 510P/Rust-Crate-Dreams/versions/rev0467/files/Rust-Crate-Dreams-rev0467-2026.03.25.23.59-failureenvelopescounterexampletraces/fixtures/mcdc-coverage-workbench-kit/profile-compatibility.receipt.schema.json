{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "profile-compatibility.receipt",
  "type": "object",
  "required": [
    "input_profile_class",
    "intended_use",
    "compatibility_verdict"
  ],
  "properties": {
    "input_profile_class": {
      "enum": [
        "raw_profraw",
        "indexed_profdata",
        "mixed",
        "unknown"
      ]
    },
    "intended_use": {
      "enum": [
        "single_campaign_merge",
        "cross_run_compare",
        "long_lived_retention",
        "unknown"
      ]
    },
    "compatibility_verdict": {
      "enum": [
        "same_producer_only",
        "indexed_backward_only",
        "not_forward_compatible",
        "not_durable_for_trend",
        "manual_review_required",
        "unknown"
      ]
    },
    "producers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {"type": "string"},
          "version": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
