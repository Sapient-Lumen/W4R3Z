{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "caveat-basis.receipt",
  "type": "object",
  "required": [
    "support_class",
    "toolchain",
    "known_limitations"
  ],
  "properties": {
    "support_class": {
      "enum": [
        "branch_only",
        "condition_only",
        "mcdc_preview",
        "manual_review_required"
      ]
    },
    "toolchain": {
      "type": "object"
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unstable_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runner": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
