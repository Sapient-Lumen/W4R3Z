{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision-authority.receipt",
  "type": "object",
  "required": [
    "crate",
    "decision_inventory_source",
    "authority_class",
    "support_class",
    "generated_at"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "decision_inventory_source": {
      "enum": [
        "compiler_export",
        "source_normalization",
        "manual_augmented"
      ]
    },
    "authority_class": {
      "enum": [
        "exact",
        "conservative",
        "manual_review_required"
      ]
    },
    "support_class": {
      "enum": [
        "branch_only",
        "condition_only",
        "mcdc_preview",
        "manual_review_required"
      ]
    },
    "construct_policy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
