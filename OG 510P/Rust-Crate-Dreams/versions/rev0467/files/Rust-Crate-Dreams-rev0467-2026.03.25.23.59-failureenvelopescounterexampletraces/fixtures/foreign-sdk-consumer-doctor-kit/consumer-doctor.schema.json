{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/foreign-sdk-consumer-doctor-kit/consumer-doctor.schema.json",
  "title": "SdkDoctorBundle",
  "type": "object",
  "required": ["environment", "artifact", "verdict"],
  "properties": {
    "environment": {
      "type": "object",
      "properties": {
        "ecosystem": {"type": "string", "enum": ["python", "apple"]},
        "platform": {"type": "string"},
        "abi": {"type": "string"}
      }
    },
    "artifact": {
      "type": "object",
      "properties": {
        "kind": {"type": "string", "enum": ["wheel", "xcframework"]},
        "declared_tags": {"type": "array", "items": {"type": "string"}},
        "slices": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verdict": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["compatible", "tag_mismatch", "slice_missing", "checksum_mismatch", "privacy_review_required", "manual_review_required"]
        },
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
