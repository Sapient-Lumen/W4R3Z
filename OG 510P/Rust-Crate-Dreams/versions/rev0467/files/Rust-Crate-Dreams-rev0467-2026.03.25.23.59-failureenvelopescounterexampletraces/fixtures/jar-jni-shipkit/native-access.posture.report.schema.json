{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NativeAccessPostureReport",
  "type": "object",
  "required": [
    "schema_version",
    "native_access_posture",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "native_access_posture": {
      "enum": [
        "named_module_native_access_declared",
        "all_unnamed_required",
        "native_access_missing",
        "manual_review_required"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
