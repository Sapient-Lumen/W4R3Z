{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoaderResidencyReport",
  "type": "object",
  "required": [
    "schema_version",
    "loader_residency",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "loader_residency": {
      "enum": [
        "java_library_path",
        "absolute_path_load",
        "extract_then_load",
        "manual_install",
        "manual_review_required"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
