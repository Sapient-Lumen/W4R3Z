{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClassifierDialectReport",
  "type": "object",
  "required": [
    "schema_version",
    "classifier_dialect",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "classifier_dialect": {
      "enum": [
        "os_detector_aligned",
        "custom_classifier_scheme",
        "classifier_mapping_required",
        "manual_review_required"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
