{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docs Coverage Bundle",
  "type": "object",
  "properties": {
    "toolchain": {"type": "string"},
    "public_items": {"type": "integer", "minimum": 0},
    "missing_docs": {"type": "integer", "minimum": 0},
    "missing_examples": {"type": "integer", "minimum": 0},
    "hotspots": {"type": "array", "items": {"type": "object"}}
  },
  "required": ["toolchain", "public_items", "hotspots"]
}
