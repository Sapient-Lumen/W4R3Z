{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "remediation-candidates.report",
  "type": "object",
  "required": ["schema_version", "candidates"],
  "properties": {
    "schema_version": {"type": "string"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_key", "strategy", "confidence"],
        "properties": {
          "finding_key": {"type": "string"},
          "strategy": {"type": "string"},
          "suggested_dependency": {"type": "string"},
          "suggested_version": {"type": "string"},
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "notes": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": true
}
