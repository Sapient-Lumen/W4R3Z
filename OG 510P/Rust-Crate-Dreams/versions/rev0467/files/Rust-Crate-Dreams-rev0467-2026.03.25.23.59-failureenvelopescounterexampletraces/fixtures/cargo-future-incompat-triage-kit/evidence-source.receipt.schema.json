{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence-source.receipt",
  "type": "object",
  "required": ["schema_version", "source_kind", "exactness"],
  "properties": {
    "schema_version": {"type": "string"},
    "source_kind": {
      "type": "string",
      "enum": ["live_build_capture", "cargo_report_recall", "latest_cached_report"]
    },
    "exactness": {
      "type": "string",
      "enum": ["exact", "conservative", "stale", "manual_review_required"]
    },
    "cargo_report_id": {"type": ["string", "null"]},
    "package_filter_applied": {"type": "boolean"},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
