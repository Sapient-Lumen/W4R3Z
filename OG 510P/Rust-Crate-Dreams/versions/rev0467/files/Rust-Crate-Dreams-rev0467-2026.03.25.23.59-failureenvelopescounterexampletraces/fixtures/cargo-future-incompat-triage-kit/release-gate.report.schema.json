{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release-gate.report",
  "type": "object",
  "required": ["schema_version", "gate_status"],
  "properties": {
    "schema_version": {"type": "string"},
    "gate_status": {
      "type": "string",
      "enum": ["pass", "fail", "needs_review"]
    },
    "ship_blockers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "needs_review": {
      "type": "array",
      "items": {"type": "string"}
    },
    "advisory_only": {
      "type": "array",
      "items": {"type": "string"}
    },
    "summary": {"type": "string"}
  },
  "additionalProperties": true
}
