{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "future-incompat.capture-lock",
  "type": "object",
  "required": [
    "schema_version",
    "workspace_root",
    "command_family",
    "acquisition_mode",
    "policy_mode"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "workspace_root": {"type": "string"},
    "command_family": {
      "type": "string",
      "enum": ["build", "check", "rustc", "report"]
    },
    "acquisition_mode": {
      "type": "string",
      "enum": ["live_build_flag", "report_by_id", "latest_cached", "package_filtered_recall"]
    },
    "cargo_report_id": {"type": ["string", "null"]},
    "package_scope": {
      "type": "array",
      "items": {"type": "string"}
    },
    "target_scope": {
      "type": "array",
      "items": {"type": "string"}
    },
    "profile": {"type": "string"},
    "toolchain": {"type": "string"},
    "policy_mode": {
      "type": "string",
      "enum": ["advisory", "blocking", "mixed"]
    }
  },
  "additionalProperties": true
}
