{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "triage-ledger.report",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"type": "string"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_key", "triage_state", "release_window_state"],
        "properties": {
          "finding_key": {"type": "string"},
          "owner": {"type": ["string", "null"]},
          "triage_state": {
            "type": "string",
            "enum": ["new", "persisting", "waived", "expired_waiver", "resolved", "unknown_owner", "needs_review"]
          },
          "release_window_state": {
            "type": "string",
            "enum": ["advisory_only", "ship_blocker", "watchlist", "needs_review"]
          },
          "first_seen": {"type": "string"},
          "last_seen": {"type": "string"},
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  },
  "additionalProperties": true
}
