{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "suppression-basis.receipt",
  "type": "object",
  "required": ["schema_version", "finding_key", "suppression_kind", "classification"],
  "properties": {
    "schema_version": {"type": "string"},
    "finding_key": {"type": "string"},
    "suppression_kind": {
      "type": "string",
      "enum": [
        "allow_attribute",
        "cap_lints",
        "report_frequency_never",
        "package_filtered_recall",
        "summary_only_without_live_flag",
        "manual_review_required"
      ]
    },
    "evidence_surface": {
      "type": "string",
      "enum": ["rustc_json", "cargo_report", "cargo_config", "manual_note", "unknown"]
    },
    "classification": {
      "type": "string",
      "enum": ["latent_debt", "display_suppressed", "recall_narrowed", "manual_review_required"]
    },
    "next_review_surface": {"type": ["string", "null"]},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
