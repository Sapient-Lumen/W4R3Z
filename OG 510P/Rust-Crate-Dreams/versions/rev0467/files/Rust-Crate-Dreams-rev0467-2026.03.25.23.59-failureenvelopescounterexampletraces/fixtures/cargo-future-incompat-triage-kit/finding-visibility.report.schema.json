{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "finding-visibility.report",
  "type": "object",
  "required": ["schema_version", "findings"],
  "properties": {
    "schema_version": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_key", "visibility_posture", "gate_posture"],
        "properties": {
          "finding_key": {"type": "string"},
          "capture_ref": {"type": ["string", "null"]},
          "visibility_posture": {
            "type": "string",
            "enum": [
              "terminal_visible",
              "report_visible_only",
              "suppressed_but_recorded",
              "package_filtered_hidden",
              "notification_hidden",
              "manual_review_required"
            ]
          },
          "gate_posture": {
            "type": "string",
            "enum": ["active_blocker", "latent_debt", "advisory_only", "manual_review_required"]
          },
          "summary": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
