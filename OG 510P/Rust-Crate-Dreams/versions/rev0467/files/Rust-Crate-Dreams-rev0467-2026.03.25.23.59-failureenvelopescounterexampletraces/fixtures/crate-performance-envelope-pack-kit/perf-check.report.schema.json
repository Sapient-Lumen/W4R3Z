{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PerfCheckReport",
  "type": "object",
  "required": ["crate", "checked_scenarios"],
  "properties": {
    "crate": {"type": "string"},
    "checked_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["passed", "failed", "manual_review_required"]}
        }
      }
    }
  }
}
