{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PerfBudgetReport",
  "type": "object",
  "required": ["crate", "scenarios"],
  "properties": {
    "crate": {"type": "string"},
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "metric", "baseline", "confidence"],
        "properties": {
          "name": {"type": "string"},
          "metric": {"type": "string"},
          "baseline": {"type": ["number", "integer"]},
          "tolerance_percent": {"type": "number"},
          "confidence": {"type": "string"}
        }
      }
    }
  }
}
