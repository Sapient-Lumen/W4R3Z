{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/a11ylab/semantic-diff.report.schema.json",
  "title": "Accessibility semantic diff report",
  "type": "object",
  "required": ["report_version", "comparison_mode", "comparability", "deltas"],
  "properties": {
    "report_version": {"type": "string"},
    "comparison_mode": {"type": "string", "enum": ["platform-vs-platform", "build-vs-build", "expected-vs-observed"]},
    "comparability": {"type": "string", "enum": ["full", "partial", "not-comparable", "manual-review-required"]},
    "deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["classification", "summary"],
        "properties": {
          "classification": {"type": "string", "enum": ["portable-semantic-change", "platform-specific-change", "unsupported-capture", "identity-instability", "event-order-drift"]},
          "node_ref": {"type": "string"},
          "summary": {"type": "string"},
          "likely_next_actions": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

