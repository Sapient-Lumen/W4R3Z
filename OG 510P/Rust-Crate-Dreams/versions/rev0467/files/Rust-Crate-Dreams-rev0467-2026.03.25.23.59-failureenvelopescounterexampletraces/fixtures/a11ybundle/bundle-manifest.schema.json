{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/a11ylab/bundle-manifest.schema.json",
  "title": "Accessibility bundle manifest",
  "type": "object",
  "required": ["format", "version", "capture", "environment", "artifacts", "redaction"],
  "properties": {
    "format": {"const": "a11ybundle"},
    "version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "capture": {
      "type": "object",
      "required": ["backend", "mode"],
      "properties": {
        "backend": {"type": "string"},
        "mode": {"type": "string", "enum": ["platform-capture", "expected-vs-observed", "replay"]},
        "scenario_id": {"type": "string"},
        "capability_profile": {"type": "string"}
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "required": ["os", "app"],
      "properties": {
        "os": {"type": "string"},
        "app": {"type": "string"},
        "toolkit": {"type": "string"},
        "backend_version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "tree_snapshot": {"type": "string"},
        "event_stream": {"type": "string"},
        "semantic_diff": {"type": "string"},
        "expected_snapshot": {"type": "string"}
      },
      "additionalProperties": true
    },
    "redaction": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
