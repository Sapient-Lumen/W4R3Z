{
  "crate": "clientx",
  "profile": "support_triage",
  "allowed_source_kinds": [
    "rustdoc_json",
    "docsrs_html",
    "readme",
    "example_source"
  ],
  "excluded_source_kinds": [
    "internal_playbook",
    "incident_note",
    "private_workspace_doc"
  ],
  "redaction_rules": [
    "strip_internal_paths",
    "drop_secret_shaped_env_examples"
  ],
  "pinning_policy": "resolve_floating_docsrs_urls_before_export",
  "hosted_vs_local_precedence": "prefer_hosted_release_materials_over_unpublished_local_notes",
  "manual_review_gates": [
    "inferred_excerpt_without_authoritative_source",
    "floating_url_left_unresolved"
  ],
  "public_export_posture": "reviewable_public_slice",
  "notes": [
    "Internal playbooks stay out of the pack even when they informed local support practice."
  ]
}
