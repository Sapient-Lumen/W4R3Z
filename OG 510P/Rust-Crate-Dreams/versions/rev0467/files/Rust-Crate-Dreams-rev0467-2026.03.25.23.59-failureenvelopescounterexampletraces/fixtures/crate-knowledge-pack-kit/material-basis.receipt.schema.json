{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "material-basis.receipt",
  "type": "object",
  "required": [
    "crate",
    "profile",
    "materials"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "authority",
          "location",
          "version_selector"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "version_selector": {
            "type": "string"
          },
          "resolved_version": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "format_version": {
            "type": [
              "integer",
              "string"
            ]
          },
          "compression": {
            "type": "string"
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
