{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "item-witness.manifest",
  "type": "object",
  "required": [
    "crate",
    "profile",
    "witnesses"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "witnesses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "resolved_version",
          "target",
          "item_path",
          "kind",
          "identity_basis",
          "rustdoc_json_scope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_material_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excerpt_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resolved_version": {
            "type": "string"
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "item_path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "identity_basis": {
            "type": "string",
            "enum": [
              "path_kind_target_span",
              "path_kind_target",
              "path_kind",
              "manual_review_required"
            ]
          },
          "rustdoc_json_item_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "rustdoc_json_scope": {
            "type": "string",
            "enum": [
              "blob_local_opaque_id"
            ]
          },
          "source_span": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "filename": {
                "type": "string"
              },
              "begin_line": {
                "type": "integer"
              },
              "begin_col": {
                "type": "integer"
              },
              "end_line": {
                "type": "integer"
              },
              "end_col": {
                "type": "integer"
              }
            }
          },
          "citation_locator_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fallback_locator_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}