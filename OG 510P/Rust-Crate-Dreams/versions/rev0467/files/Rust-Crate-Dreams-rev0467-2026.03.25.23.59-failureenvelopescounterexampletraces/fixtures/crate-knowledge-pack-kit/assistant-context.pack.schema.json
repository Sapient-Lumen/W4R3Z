{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "assistant-context.pack",
  "type": "object",
  "required": [
    "crate",
    "profile",
    "sections"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "purpose",
          "excerpt_ids",
          "authority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "excerpt_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authority": {
            "type": "string"
          }
        }
      }
    },
    "supported_query_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_query_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "refused_query_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
