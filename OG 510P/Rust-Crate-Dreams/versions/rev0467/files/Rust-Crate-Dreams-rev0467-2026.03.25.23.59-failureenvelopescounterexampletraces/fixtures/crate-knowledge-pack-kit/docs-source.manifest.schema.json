{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "docs-source.manifest",
  "type": "object",
  "required": [
    "crate",
    "sources"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "authority",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}