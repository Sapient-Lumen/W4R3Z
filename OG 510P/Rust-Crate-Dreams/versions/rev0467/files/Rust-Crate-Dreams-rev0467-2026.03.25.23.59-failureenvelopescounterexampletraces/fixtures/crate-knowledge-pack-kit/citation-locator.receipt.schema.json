{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "citation-locator.receipt",
  "type": "object",
  "required": ["crate", "profile", "locators"],
  "properties": {
    "crate": {"type": "string"},
    "profile": {"type": "string"},
    "locators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_material_id",
          "locator_class",
          "canonical_locator",
          "version_selector",
          "pin_status",
          "citation_ready"
        ],
        "properties": {
          "id": {"type": "string"},
          "source_material_id": {"type": "string"},
          "excerpt_ids": {"type": "array", "items": {"type": "string"}},
          "locator_class": {
            "type": "string",
            "enum": [
              "docsrs_item_page",
              "docsrs_readme_section",
              "docsrs_target_page",
              "docsrs_download_archive_path",
              "local_unpublished",
              "manual_review_required"
            ]
          },
          "canonical_locator": {"type": "string"},
          "fetched_locator": {"type": "string"},
          "version_selector": {
            "type": "string",
            "enum": ["exact", "semver_range", "latest", "workspace_head"]
          },
          "resolved_version": {"type": ["string", "null"]},
          "target": {"type": ["string", "null"]},
          "anchor_kind": {
            "type": "string",
            "enum": ["item_path", "html_fragment", "readme_heading", "archive_path", "none"]
          },
          "pin_status": {
            "type": "string",
            "enum": ["pinned", "resolved_from_floating", "floating", "local_only"]
          },
          "citation_ready": {"type": "boolean"},
          "fallback_locators": {"type": "array", "items": {"type": "string"}},
          "caveats": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
