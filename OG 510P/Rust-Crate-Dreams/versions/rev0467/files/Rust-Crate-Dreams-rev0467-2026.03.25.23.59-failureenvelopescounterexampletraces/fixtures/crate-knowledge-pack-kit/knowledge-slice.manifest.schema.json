{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-slice.manifest",
  "type": "object",
  "required": [
    "crate",
    "profile",
    "includes",
    "excludes"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excludes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance_policy": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}