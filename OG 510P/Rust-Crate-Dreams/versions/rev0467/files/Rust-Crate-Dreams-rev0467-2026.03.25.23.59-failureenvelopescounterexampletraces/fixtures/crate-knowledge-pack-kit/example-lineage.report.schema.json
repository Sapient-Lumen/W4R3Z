{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "example-lineage.report",
  "type": "object",
  "required": [
    "crate",
    "examples"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "origin",
          "status",
          "support_class"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "support_class": {
            "type": "string"
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}