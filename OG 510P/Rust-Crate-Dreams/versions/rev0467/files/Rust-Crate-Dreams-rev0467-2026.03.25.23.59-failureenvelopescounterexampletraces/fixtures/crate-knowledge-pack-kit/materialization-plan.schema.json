{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "materialization-plan",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "subject",
    "materials",
    "manual_review_zones"
  ],
  "properties": {
    "schema_name": {
      "const": "materialization-plan"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "subject": {
      "type": "object",
      "required": ["crate", "version"],
      "properties": {
        "crate": { "type": "string" },
        "version": { "type": "string" },
        "target": { "type": "string" }
      },
      "additionalProperties": true
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "material_id",
          "input_ref",
          "intended_use",
          "materialization_mode"
        ],
        "properties": {
          "material_id": { "type": "string" },
          "input_ref": { "type": "string" },
          "intended_use": {
            "type": "string",
            "enum": [
              "citation",
              "search",
              "review",
              "offline_reading",
              "diff",
              "task_fit"
            ]
          },
          "materialization_mode": {
            "type": "string",
            "enum": [
              "live_remote",
              "pinned_remote",
              "downloaded_archive",
              "extracted_archive",
              "hybrid_local_remote",
              "manual_only"
            ]
          },
          "caveats": {
            "type": "array",
            "items": { "type": "string" }
          },
          "outputs": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "manual_review_zones": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
