{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/a11ydoctor/rule-authority.policy.schema.json",
  "title": "UI accessibility rule authority policy",
  "type": "object",
  "required": ["policy_version", "ruleset_id", "rules"],
  "properties": {
    "policy_version": {"type": "string"},
    "ruleset_id": {"type": "string"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "authority_class", "automation_class", "default_severity"],
        "properties": {
          "rule_id": {"type": "string"},
          "authority_class": {"type": "string", "enum": ["accesskit_structural", "standards_inspired", "toolkit_specific", "manual_review_required"]},
          "automation_class": {"type": "string", "enum": ["automatic", "semi_automatic", "manual"]},
          "default_severity": {"type": "string", "enum": ["blocking", "warning", "info", "manual-review-required"]},
          "normative_refs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
