{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/a11ydoctor/a11ygate.result.schema.json",
  "title": "UI accessibility gate result",
  "type": "object",
  "required": ["result_version", "verdict", "policy_ref", "doctor_report_ref"],
  "properties": {
    "result_version": {"type": "string"},
    "verdict": {"type": "string", "enum": ["pass", "warn", "fail", "manual-review-required"]},
    "policy_ref": {"type": "string"},
    "doctor_report_ref": {"type": "string"},
    "diff_summary": {
      "type": "object",
      "properties": {
        "changed_nodes": {"type": "integer", "minimum": 0},
        "focus_order_changed": {"type": "boolean"},
        "role_name_state_changed": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "waivers_applied": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
