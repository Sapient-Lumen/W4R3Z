{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/a11ydoctor/semantic-contract.report.schema.json",
  "title": "UI accessibility semantic contract report",
  "type": "object",
  "required": ["report_version", "subject", "node_identity_mode", "nodes"],
  "properties": {
    "report_version": {"type": "string"},
    "subject": {"type": "string"},
    "node_identity_mode": {"type": "string", "enum": ["stable-id", "derived-id", "mixed", "manual-review-required"]},
    "summary": {
      "type": "object",
      "properties": {
        "node_count": {"type": "integer", "minimum": 0},
        "focusable_count": {"type": "integer", "minimum": 0},
        "named_actionable_count": {"type": "integer", "minimum": 0},
        "manual_review_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "role", "focusable", "hidden", "disabled"],
        "properties": {
          "node_id": {"type": "string"},
          "parent_id": {"type": "string"},
          "role": {"type": "string"},
          "accessible_name": {"type": ["string", "null"]},
          "name_source": {"type": "string", "enum": ["explicit", "derived", "tooltip", "unknown", "not-applicable"]},
          "focusable": {"type": "boolean"},
          "hidden": {"type": "boolean"},
          "disabled": {"type": "boolean"},
          "value_semantics": {"type": "string", "enum": ["present", "missing", "not-applicable", "manual-review-required"]},
          "selection_semantics": {"type": "string", "enum": ["present", "missing", "not-applicable", "manual-review-required"]},
          "identity_stability": {"type": "string", "enum": ["stable", "unstable", "unknown", "manual-review-required"]},
          "source_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
