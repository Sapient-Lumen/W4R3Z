{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/a11ydoctor/a11ydoctor.report.schema.json",
  "title": "UI accessibility doctor report",
  "type": "object",
  "required": ["report_version", "subject", "summary", "findings"],
  "properties": {
    "report_version": {"type": "string"},
    "subject": {"type": "string"},
    "summary": {
      "type": "object",
      "properties": {
        "blocking": {"type": "integer", "minimum": 0},
        "warning": {"type": "integer", "minimum": 0},
        "info": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "rule_id", "node_ref", "summary"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["blocking", "warning", "info", "manual-review-required"]},
          "rule_id": {"type": "string"},
          "node_ref": {"type": "string"},
          "summary": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "suggested_next_actions": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
