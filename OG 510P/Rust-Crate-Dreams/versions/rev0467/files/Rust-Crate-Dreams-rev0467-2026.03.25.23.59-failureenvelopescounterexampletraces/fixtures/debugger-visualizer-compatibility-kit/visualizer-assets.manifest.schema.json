{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/debugger-visualizer-compatibility-kit/visualizer-assets.manifest.schema.json",
  "title": "VisualizerAssetManifest",
  "type": "object",
  "required": ["assets"],
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "backend", "embedding_mode", "attachment_scope", "provenance"],
        "properties": {
          "asset_id": {"type": "string"},
          "backend": {"type": "string", "enum": ["natvis", "gdb_pretty_printer"]},
          "embedding_mode": {"type": "string", "enum": ["embedded", "external_companion", "manual_review_required"]},
          "attachment_scope": {"type": "string", "enum": ["crate_root", "module", "manual_review_required"]},
          "provenance": {"type": "array", "items": {"type": "string", "enum": ["rust_attribute_scan", "filesystem_scan", "manual_import"]}},
          "target_constraints": {"type": "array", "items": {"type": "string"}},
          "path": {"type": "string"},
          "sha256": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
