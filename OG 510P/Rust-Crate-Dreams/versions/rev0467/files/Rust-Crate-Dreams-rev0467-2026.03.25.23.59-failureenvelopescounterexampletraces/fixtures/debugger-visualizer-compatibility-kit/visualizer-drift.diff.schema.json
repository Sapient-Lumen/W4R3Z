{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/debugger-visualizer-compatibility-kit/visualizer-drift.diff.schema.json",
  "title": "VisualizerDriftDiff",
  "type": "object",
  "required": ["changes"],
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "severity"],
        "properties": {
          "kind": {"type": "string", "enum": ["new_backend_supported", "backend_regressed", "safe_path_requirement_changed", "asset_changed", "golden_changed", "route_changed", "manual_review_required"]},
          "severity": {"type": "string", "enum": ["info", "warning", "error"]},
          "backend": {"type": "string"},
          "summary": {"type": "string"}
        }
      }
    }
  }
}
