{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/debugger-visualizer-compatibility-kit/formatter-origin.receipt.schema.json",
  "title": "FormatterOriginReceipt",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["backend", "origin_kind", "authority"],
        "properties": {
          "backend": {"type": "string"},
          "origin_kind": {
            "type": "string",
            "enum": [
              "repo_embedded_asset",
              "repo_external_asset",
              "toolchain_support_script",
              "debugger_builtin_formatter",
              "user_local_config",
              "manual_review_required"
            ]
          },
          "authority": {
            "type": "string",
            "enum": ["primary_for_lane", "supporting_only", "derived_projection", "manual_review_required"]
          },
          "asset_refs": {"type": "array", "items": {"type": "string"}},
          "script_refs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
