{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Rebuild Why Kit \u2014 rebuild support bundle manifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "subject",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "bundle_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "path"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "rebuild_receipt",
              "unit_rebuilds",
              "comparison_scope",
              "artifact_route_drift",
              "baseline_authority",
              "reverse_impact",
              "evidence_source",
              "exactness",
              "timings_pointer",
              "cache_conflict",
              "notes"
            ]
          },
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "adjacent_lane_imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lane",
          "path"
        ],
        "properties": {
          "lane": {
            "type": "string",
            "enum": [
              "P-0494",
              "P-0490",
              "P-0035"
            ]
          },
          "path": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "manual_review_zones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
