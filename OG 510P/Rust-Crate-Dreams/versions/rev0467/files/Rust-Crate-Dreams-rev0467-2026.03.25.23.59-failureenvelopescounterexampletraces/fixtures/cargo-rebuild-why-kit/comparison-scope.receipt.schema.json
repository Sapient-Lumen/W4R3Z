{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Rebuild Why Kit \u2014 comparison scope receipt",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_session",
    "baseline_session",
    "dimensions",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "candidate_session": {
      "type": "string"
    },
    "baseline_session": {
      "type": "string"
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "status"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "command_family",
              "profile",
              "targets",
              "features",
              "workspace_selection",
              "wrapper_stack",
              "build_dir_route",
              "target_dir_route"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "match",
              "compatible_with_caveat",
              "mismatch"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "adjacent_lane_imports": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "compile_time_deps_workflow",
          "lock_contention_witness",
          "historical_build_warehouse"
        ]
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "comparison_authorized",
        "comparison_authorized_with_caveats",
        "manual_review_required"
      ]
    }
  },
  "additionalProperties": true
}
