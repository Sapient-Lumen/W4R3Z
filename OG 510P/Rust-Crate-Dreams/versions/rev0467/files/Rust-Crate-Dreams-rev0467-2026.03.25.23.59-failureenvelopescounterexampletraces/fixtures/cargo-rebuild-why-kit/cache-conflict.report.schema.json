{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Rebuild Why Kit — cache conflict report",
  "type": "object",
  "required": ["schema_version", "workspace", "verdict", "signals"],
  "properties": {
    "schema_version": { "type": "string" },
    "workspace": { "type": "string" },
    "verdict": {
      "type": "string",
      "enum": ["no_conflict_visible", "cache_conflict_possible", "manual_review_required"]
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "observed"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "shared_target_dir",
              "shared_build_dir",
              "concurrent_tool_detected",
              "lock_wait_visible",
              "wrapper_cache_root_mismatch",
              "imported_contention_bundle"
            ]
          },
          "observed": { "type": "boolean" },
          "detail": { "type": "string" },
          "evidence_lane": {
            "type": "string",
            "enum": ["cargo_report_import", "live_capture", "fingerprint_overlay"]
          }
        },
        "additionalProperties": true
      }
    },
    "mitigation_hints": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
