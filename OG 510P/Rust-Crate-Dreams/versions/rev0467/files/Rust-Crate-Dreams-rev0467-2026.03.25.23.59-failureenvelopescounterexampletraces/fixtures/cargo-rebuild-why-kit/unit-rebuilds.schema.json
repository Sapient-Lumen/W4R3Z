{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-rebuild-why/unit-rebuilds.schema.json",
  "title": "Cargo rebuild why — unit rebuilds",
  "type": "object",
  "required": ["schema_version", "units"],
  "properties": {
    "schema_version": {"type": "string"},
    "baseline": {"type": "string"},
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "status", "causes"],
        "properties": {
          "unit": {"type": "string"},
          "package": {"type": "string"},
          "target_kind": {
            "type": "string",
            "enum": ["lib", "bin", "example", "test", "bench", "build-script", "proc-macro", "custom"]
          },
          "status": {
            "type": "string",
            "enum": ["rebuilt", "reused", "unknown"]
          },
          "causes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "source_changed",
                "tool_invocation_drift_possible",
                "target_profile_split",
                "wrapper_or_flags_changed",
                "lockfile_or_resolution_changed",
                "cache_contention_possible",
                "public_interface_change_possible",
                "manual_review_required"
              ]
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "summary"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["observed_fact", "conservative_inference", "user_supplied", "imported_log"]
                },
                "summary": {"type": "string"},
                "source": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
