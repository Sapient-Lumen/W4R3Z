{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Rebuild Why Kit \u2014 artifact route drift report",
  "type": "object",
  "required": [
    "schema_version",
    "before",
    "after",
    "route_changes",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "before": {
      "type": "object",
      "additionalProperties": true
    },
    "after": {
      "type": "object",
      "additionalProperties": true
    },
    "route_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "impact_class"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "build_dir_root",
              "target_dir_root",
              "rust_analyzer_target_dir",
              "wrapper_hash_lane",
              "final_artifact_surface",
              "intermediate_cache_surface"
            ]
          },
          "impact_class": {
            "type": "string",
            "enum": [
              "context_only",
              "reuse_context_changed",
              "comparison_scope_changed",
              "manual_review_required"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "route_drift_observed",
        "route_drift_with_caveats",
        "manual_review_required"
      ]
    }
  },
  "additionalProperties": true
}
