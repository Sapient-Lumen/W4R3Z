{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Rebuild Why Kit — evidence source receipt",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "consumption_mode"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "cargo_report_sessions",
              "cargo_report_rebuilds",
              "cargo_report_timings",
              "build_analysis_jsonl",
              "cargo_message_stream",
              "fingerprint_overlay",
              "manual_annotation"
            ]
          },
          "consumption_mode": {
            "type": "string",
            "enum": ["verbatim_import", "normalized_extract", "summarized", "manual_note"]
          },
          "session_id": { "type": "string" },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
