{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Rebuild Why Kit — fingerprint delta",
  "type": "object",
  "required": ["schema_version", "comparison", "units", "summary"],
  "properties": {
    "schema_version": { "type": "string" },
    "comparison": {
      "type": "object",
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": { "type": "string" },
        "candidate": { "type": "string" }
      },
      "additionalProperties": true
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "changes", "verdict"],
        "properties": {
          "unit": { "type": "string" },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "change"],
              "properties": {
                "field": { "type": "string" },
                "change": { "type": "string" },
                "observed": { "type": "boolean" },
                "evidence_lane": {
                  "type": "string",
                  "enum": ["cargo_report_import", "live_capture", "fingerprint_overlay"]
                }
              },
              "additionalProperties": true
            }
          },
          "verdict": {
            "type": "string",
            "enum": [
              "fingerprint_changed",
              "wrapper_or_flags_changed",
              "tool_invocation_drift_possible",
              "manual_review_required"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": ["changed_units", "manual_review_units"],
      "properties": {
        "changed_units": { "type": "integer", "minimum": 0 },
        "manual_review_units": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
