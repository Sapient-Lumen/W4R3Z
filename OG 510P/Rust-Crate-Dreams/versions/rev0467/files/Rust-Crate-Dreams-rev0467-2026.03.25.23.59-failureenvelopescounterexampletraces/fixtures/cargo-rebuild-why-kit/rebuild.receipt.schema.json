{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-rebuild-why/rebuild.receipt.schema.json",
  "title": "Cargo rebuild why — receipt",
  "type": "object",
  "required": ["schema_version", "command", "capture_mode", "assumptions"],
  "properties": {
    "schema_version": {"type": "string"},
    "command": {
      "type": "object",
      "required": ["argv"],
      "properties": {
        "argv": {"type": "array", "items": {"type": "string"}},
        "toolchain": {"type": "string"},
        "working_directory": {"type": "string"}
      },
      "additionalProperties": false
    },
    "capture_mode": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["timings", "cargo_output", "fingerprint_logs", "imported_artifacts", "build_analysis_import", "cargo_report_sessions", "cargo_report_rebuilds", "cargo_report_timings", "manual_annotation"]
      }
    },
    "assumptions": {
      "type": "object",
      "required": ["profile", "targets"],
      "properties": {
        "profile": {"type": "string"},
        "targets": {"type": "array", "items": {"type": "string"}},
        "target_dir": {"type": "string"},
        "wrapper": {"type": "string"},
        "compile_time_deps_mode": {"type": "boolean"},
        "session_id": {"type": "string"},
        "baseline_session_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "redaction_policy": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
