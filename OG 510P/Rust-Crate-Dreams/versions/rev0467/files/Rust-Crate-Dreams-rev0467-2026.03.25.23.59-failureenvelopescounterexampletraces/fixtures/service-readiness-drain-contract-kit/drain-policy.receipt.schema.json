{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "drain-policy.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "accept_new_connections",
    "accept_new_requests",
    "keepalive_policy",
    "timeout_aftermath"
  ],
  "properties": {
    "artifact": {
      "const": "drain-policy.receipt"
    },
    "subject": {
      "type": "string"
    },
    "accept_new_connections": {
      "enum": [
        "stop_immediately",
        "continue_until_signal_processed",
        "manual_review_required"
      ]
    },
    "accept_new_requests": {
      "enum": [
        "stop_immediately",
        "stop_per_connection",
        "mixed",
        "manual_review_required"
      ]
    },
    "grace_period_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "keepalive_policy": {
      "enum": [
        "disable_new_keepalive",
        "allow_existing_only",
        "drop_immediately",
        "manual_review_required"
      ]
    },
    "timeout_aftermath": {
      "enum": [
        "abort_remaining",
        "stop_waiting_only",
        "close_transport_but_tasks_may_continue",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
