{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inflight-fate.report",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "during_drain",
    "on_timeout",
    "client_signal",
    "retry_safety"
  ],
  "properties": {
    "artifact": {
      "const": "inflight-fate.report"
    },
    "subject": {
      "type": "string"
    },
    "during_drain": {
      "enum": [
        "complete_if_started",
        "may_be_rejected",
        "mixed",
        "manual_review_required"
      ]
    },
    "on_timeout": {
      "enum": [
        "cancel",
        "best_effort_complete",
        "unknown",
        "mixed",
        "manual_review_required"
      ]
    },
    "client_signal": {
      "enum": [
        "connection_close",
        "grpc_unavailable",
        "http_503",
        "timeout",
        "mixed",
        "manual_review_required"
      ]
    },
    "retry_safety": {
      "enum": [
        "safe_if_idempotent",
        "caller_defined",
        "unknown",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
