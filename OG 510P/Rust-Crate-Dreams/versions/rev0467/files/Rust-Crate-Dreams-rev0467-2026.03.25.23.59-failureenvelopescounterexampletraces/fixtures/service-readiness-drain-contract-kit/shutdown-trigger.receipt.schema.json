{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shutdown-trigger.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "trigger_sources",
    "escalation_route"
  ],
  "properties": {
    "artifact": {
      "const": "shutdown-trigger.receipt"
    },
    "subject": {
      "type": "string"
    },
    "trigger_sources": {
      "type": "array",
      "items": {
        "enum": [
          "os_signal",
          "admin_request",
          "subsystem_failure",
          "panic",
          "deployment_hook",
          "idle_timeout",
          "manual_review_required"
        ]
      }
    },
    "escalation_route": {
      "enum": [
        "begin_drain",
        "begin_shutdown_tree",
        "immediate_abort",
        "mixed",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
