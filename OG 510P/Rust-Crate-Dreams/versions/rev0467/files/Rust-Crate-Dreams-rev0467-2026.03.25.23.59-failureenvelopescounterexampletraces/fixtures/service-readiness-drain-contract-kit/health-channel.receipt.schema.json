{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "health-channel.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "channel_class",
    "exposure",
    "update_basis"
  ],
  "properties": {
    "artifact": {
      "const": "health-channel.receipt"
    },
    "subject": {
      "type": "string"
    },
    "channel_class": {
      "enum": [
        "http_live",
        "http_ready",
        "grpc_health",
        "admin_only",
        "internal_only",
        "mixed",
        "none",
        "manual_review_required"
      ]
    },
    "exposure": {
      "enum": [
        "public",
        "mesh_only",
        "private_network",
        "local_only",
        "internal_only",
        "manual_review_required"
      ]
    },
    "update_basis": {
      "enum": [
        "manual_setter",
        "derived_from_state",
        "delegated_dependency",
        "mixed",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
