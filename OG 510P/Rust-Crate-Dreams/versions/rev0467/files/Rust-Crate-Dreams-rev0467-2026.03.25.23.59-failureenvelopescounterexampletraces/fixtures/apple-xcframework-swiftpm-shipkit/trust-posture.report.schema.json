{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/apple-xcframework-swiftpm-shipkit/trust-posture.report.schema.json",
  "title": "AppleTrustPostureReport",
  "type": "object",
  "required": ["bundle_name", "trust_class", "signature_route", "privacy_manifest_status"],
  "properties": {
    "bundle_name": {"type": "string"},
    "trust_class": {
      "type": "string",
      "enum": [
        "signed_with_privacy_manifest_present",
        "signed_but_privacy_gap",
        "unsigned_local_only",
        "manual_review_required"
      ]
    },
    "signature_route": {"type": "string", "enum": ["signed", "unsigned", "changed_signer", "unknown"]},
    "privacy_manifest_status": {"type": "string", "enum": ["present_for_supported_slices", "missing_for_named_slice", "not_checked", "unknown"]},
    "origin_expectation": {"type": "string", "enum": ["xcode_origin_verification_expected", "local_only", "manual_review_required"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
