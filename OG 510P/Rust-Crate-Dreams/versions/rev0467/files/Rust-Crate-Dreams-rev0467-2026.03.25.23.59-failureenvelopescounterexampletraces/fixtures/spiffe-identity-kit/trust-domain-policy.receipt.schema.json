{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spiffe-identity-kit trust-domain-policy receipt",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "policy_mode",
    "federation_posture"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "policy_mode": {
      "type": "string",
      "enum": [
        "any_in_bundle_set",
        "allow_list",
        "local_only",
        "application_narrowed",
        "manual_review_required"
      ]
    },
    "federation_posture": {"type": "string", "enum": ["same_domain_only", "federated_narrowed", "federated_wide", "unknown"]},
    "allowed_trust_domains": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
