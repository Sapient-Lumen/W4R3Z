{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spiffe-identity-kit rotation-state report",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "freshness_mode",
    "new_handshake_posture",
    "source_loss_posture"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "freshness_mode": {
      "type": "string",
      "enum": [
        "watch_driven_live_rotation",
        "manual_refresh",
        "static_until_restart",
        "manual_review_required"
      ]
    },
    "new_handshake_posture": {"type": "string", "enum": ["uses_updated_material", "may_use_stale_material", "restart_required", "unknown"]},
    "source_loss_posture": {"type": "string", "enum": ["current_material_cached_new_handshakes_continue", "new_material_unavailable_new_handshakes_fail", "service_fallbacks_to_static_identity", "manual_review_required"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
