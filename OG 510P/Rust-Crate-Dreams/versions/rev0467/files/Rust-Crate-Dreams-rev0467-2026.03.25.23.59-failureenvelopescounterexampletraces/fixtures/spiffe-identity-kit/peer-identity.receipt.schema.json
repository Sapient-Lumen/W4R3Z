{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spiffe-identity-kit peer-identity receipt",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "handoff_mode",
    "authorization_stage"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "handoff_mode": {
      "type": "string",
      "enum": [
        "peer_identity_returned_to_app",
        "peer_identity_available_in_middleware",
        "verified_but_not_exposed",
        "authorization_only",
        "manual_review_required"
      ]
    },
    "authorization_stage": {"type": "string", "enum": ["post_verification_authorizer", "verifier_only", "application_middleware", "unknown"]},
    "peer_id_shape": {"type": "string", "enum": ["spiffe_id", "trust_domain_only", "not_exposed", "unknown"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
