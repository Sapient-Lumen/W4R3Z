{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "overflow-policy.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "when_full"
  ],
  "properties": {
    "artifact": {
      "const": "overflow-policy.receipt"
    },
    "subject": {
      "type": "string"
    },
    "when_full": {
      "enum": [
        "wait_backpressure",
        "reject_immediately",
        "drop_oldest",
        "drop_newest",
        "retain_latest_only",
        "lag_error",
        "manual_review_required"
      ]
    },
    "sender_signal": {
      "type": [
        "string",
        "null"
      ]
    },
    "receiver_signal": {
      "type": [
        "string",
        "null"
      ]
    },
    "skipped_count_available": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
