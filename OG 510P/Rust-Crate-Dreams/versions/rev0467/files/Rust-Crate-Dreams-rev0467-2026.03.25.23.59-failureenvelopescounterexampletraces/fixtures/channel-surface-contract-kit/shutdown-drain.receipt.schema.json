{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shutdown-drain.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "receiver_close_supported",
    "buffered_messages_after_receiver_drop"
  ],
  "properties": {
    "artifact": {
      "const": "shutdown-drain.receipt"
    },
    "subject": {
      "type": "string"
    },
    "receiver_close_supported": {
      "type": "boolean"
    },
    "clean_shutdown_recipe": {
      "type": [
        "string",
        "null"
      ]
    },
    "buffered_messages_after_receiver_drop": {
      "enum": [
        "dropped",
        "drained_to_completion",
        "manual_review_required"
      ]
    },
    "sender_closed_signal": {
      "type": [
        "string",
        "null"
      ]
    },
    "reserved_capacity_after_close": {
      "enum": [
        "may_still_send",
        "rejected",
        "not_applicable",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
