{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/crate-health-contract-kit/health-support-bundle.manifest.schema.json",
  "title": "HealthSupportBundleManifest",
  "type": "object",
  "required": [
    "crate_id",
    "declared_artifacts",
    "imported_artifacts",
    "manual_review_gaps"
  ],
  "properties": {
    "crate_id": {
      "type": "string"
    },
    "declared_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "imported_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "share_safety": {
      "type": "string",
      "enum": [
        "public_safe",
        "internal_only",
        "mixed"
      ]
    },
    "snapshot_ref": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
