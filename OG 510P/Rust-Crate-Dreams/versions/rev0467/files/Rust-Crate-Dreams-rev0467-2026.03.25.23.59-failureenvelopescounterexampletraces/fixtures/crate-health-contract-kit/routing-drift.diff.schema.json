{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/crate-health-contract-kit/routing-drift.diff.schema.json",
  "title": "RoutingDriftDiff",
  "type": "object",
  "required": [
    "crate_id",
    "from_snapshot",
    "to_snapshot",
    "changes"
  ],
  "properties": {
    "crate_id": {
      "type": "string"
    },
    "from_snapshot": {
      "type": "string"
    },
    "to_snapshot": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "change_kind",
          "impact_class",
          "summary"
        ],
        "properties": {
          "change_kind": {
            "type": "string",
            "enum": [
              "route_changed",
              "channel_added",
              "channel_removed",
              "backstop_changed",
              "owner_class_changed",
              "repo_transfer",
              "import_only_change",
              "manual_review_required"
            ]
          },
          "impact_class": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "work_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "declared_change": {
            "type": "boolean"
          },
          "import_only": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
