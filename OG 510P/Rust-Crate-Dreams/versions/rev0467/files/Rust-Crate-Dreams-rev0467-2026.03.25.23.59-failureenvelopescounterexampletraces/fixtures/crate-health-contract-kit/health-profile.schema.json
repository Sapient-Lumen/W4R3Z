{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/schemas/crate-health-contract-kit/health-profile.schema.json",
  "title": "Crate Health Profile",
  "type": "object",
  "required": ["crate", "profile_class", "evidence_basis"],
  "properties": {
    "crate": {"type": "string"},
    "version_range": {"type": "string"},
    "profile_class": {
      "type": "string",
      "enum": [
        "active_development",
        "reactive_maintenance",
        "critical_fixes_only",
        "frozen_but_supported",
        "seeking_co_maintainer",
        "sunset_in_progress",
        "manual_review_required"
      ]
    },
    "summary": {"type": "string"},
    "evidence_basis": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
