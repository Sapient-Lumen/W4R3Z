{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/crate-health-contract-kit/registry-signal.import.schema.json",
  "title": "RegistrySignalImport",
  "type": "object",
  "required": [
    "crate_id",
    "signals"
  ],
  "properties": {
    "crate_id": {
      "type": "string"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "signal_kind",
          "evidence_class"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "signal_kind": {
            "type": "string"
          },
          "imported_at": {
            "type": "string"
          },
          "evidence_class": {
            "type": "string",
            "enum": [
              "host_fact",
              "registry_fact",
              "derived_context",
              "manual_import"
            ]
          },
          "supports_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "does_not_prove": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mutable_without_release": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
