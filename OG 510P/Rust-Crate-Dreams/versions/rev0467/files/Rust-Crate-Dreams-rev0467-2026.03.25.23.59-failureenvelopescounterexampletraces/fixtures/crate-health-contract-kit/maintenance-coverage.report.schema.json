{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/crate-health-contract-kit/maintenance-coverage.report.schema.json",
  "title": "MaintenanceCoverageReport",
  "type": "object",
  "required": ["crate", "coverage_profile", "lights_on", "enable_evolution", "gap_posture"],
  "properties": {
    "crate": {"type": "string"},
    "coverage_profile": {
      "type": "string",
      "enum": [
        "lights_on_only",
        "lights_on_with_partial_enablement",
        "broad_coverage_declared",
        "active_feature_work_but_hidden_maintenance_gaps",
        "critical_fixes_only",
        "manual_review_required"
      ]
    },
    "lights_on": {
      "type": "array",
      "items": {"$ref": "#/$defs/workClass"}
    },
    "enable_evolution": {
      "type": "array",
      "items": {"$ref": "#/$defs/workClass"}
    },
    "gap_posture": {
      "type": "string",
      "enum": [
        "no_material_gaps_declared",
        "visible_partial_coverage",
        "important_gaps_present",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "workClass": {
      "type": "object",
      "required": ["class", "coverage_state", "evidence_basis"],
      "properties": {
        "class": {"type": "string"},
        "coverage_state": {
          "type": "string",
          "enum": [
            "covered",
            "best_effort",
            "named_owner_no_backup",
            "imported_signal_only",
            "unowned",
            "manual_review_required"
          ]
        },
        "evidence_basis": {
          "type": "string",
          "enum": [
            "maintainer_declared",
            "registry_import",
            "repo_import",
            "inferred",
            "manual_review_required"
          ]
        },
        "owner_ref": {"type": ["string", "null"]},
        "backup_ref": {"type": ["string", "null"]},
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
