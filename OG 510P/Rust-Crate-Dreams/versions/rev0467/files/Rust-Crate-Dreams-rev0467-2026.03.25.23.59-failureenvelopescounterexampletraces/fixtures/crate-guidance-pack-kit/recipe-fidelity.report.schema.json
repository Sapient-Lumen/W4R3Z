{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecipeFidelityReport",
  "type": "object",
  "required": [
    "schema_version",
    "recipe_name",
    "fidelity_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "recipe_name": {
      "type": "string"
    },
    "fidelity_class": {
      "enum": [
        "checked_full_lane",
        "checked_default_lane_only",
        "checked_failure_only",
        "docs_only",
        "manual_review_required"
      ]
    },
    "coverage": {
      "type": "object",
      "properties": {
        "features": {"type": "array", "items": {"type": "string"}},
        "editions": {"type": "array", "items": {"type": "string"}},
        "targets": {"type": "array", "items": {"type": "string"}},
        "proc_macro_shapes": {"type": "array", "items": {"type": "string"}},
        "docs_parity_checked": {"type": "boolean"}
      }
    },
    "unchecked_dimensions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {
      "type": "string"
    }
  }
}
