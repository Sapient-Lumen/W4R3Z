{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "compile guidance receipt",
  "type": "object",
  "required": [
    "schema_version",
    "toolchain",
    "observed_guidance"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "toolchain": {
      "type": "string"
    },
    "observed_guidance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "evidence_class"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "evidence_class": {
            "type": "string"
          },
          "compiler_hook": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
