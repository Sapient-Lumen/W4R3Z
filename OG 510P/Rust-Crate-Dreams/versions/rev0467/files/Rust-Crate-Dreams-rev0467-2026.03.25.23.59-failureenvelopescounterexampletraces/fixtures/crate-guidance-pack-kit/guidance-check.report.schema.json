{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "guidance check report",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "result"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
