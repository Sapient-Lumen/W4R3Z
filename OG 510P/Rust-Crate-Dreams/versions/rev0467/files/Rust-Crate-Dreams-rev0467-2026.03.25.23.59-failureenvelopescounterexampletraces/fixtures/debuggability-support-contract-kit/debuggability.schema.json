{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/debuggability-support-contract-kit/debuggability.schema.json",
  "title": "DebuggabilityReceipt",
  "type": "object",
  "required": ["profile", "target", "support_posture", "artifacts", "capture_sources", "observed_settings"],
  "properties": {
    "profile": {"type": "string"},
    "target": {"type": "string"},
    "support_posture": {
      "type": "string",
      "enum": ["interactive_debugger", "backtrace_only", "crash_symbolication_only", "manual_review_required"]
    },
    "capture_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["cargo_profile", "rustc_codegen", "filesystem_scan", "manual_import"]
      }
    },
    "observed_settings": {
      "type": "object",
      "required": ["debug", "split_debuginfo", "strip"],
      "properties": {
        "debug": {"type": "string"},
        "split_debuginfo": {"type": "string"},
        "strip": {"type": "string"},
        "panic": {"type": "string"},
        "trim_paths": {"type": ["string", "array"]}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "artifact_kind", "debug_info_mode"],
        "properties": {
          "path": {"type": "string"},
          "artifact_kind": {"type": "string"},
          "debug_info_mode": {"type": "string", "enum": ["embedded", "split_sidecar", "limited_embedded", "absent", "manual_review_required"]},
          "sidecars": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "policy_reference": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
