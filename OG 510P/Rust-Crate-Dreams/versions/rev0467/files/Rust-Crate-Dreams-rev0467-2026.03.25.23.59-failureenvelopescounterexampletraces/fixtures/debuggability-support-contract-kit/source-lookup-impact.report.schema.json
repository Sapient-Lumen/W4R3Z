{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/debuggability-support-contract-kit/source-lookup-impact.report.schema.json",
  "title": "Debuggability source-lookup impact report",
  "type": "object",
  "required": ["version", "source_lookup_expectation", "evidence"],
  "properties": {
    "version": {"type": "string"},
    "source_lookup_expectation": {
      "type": "string",
      "enum": ["likely_preserved", "weakened", "obscured", "manual_review_required", "unknown"]
    },
    "observed_controls": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["remap_path_prefix", "trim_paths", "embedded_absolute_paths", "virtual_rustc_paths", "manual_note"]
      }
    },
    "required_components_or_notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
