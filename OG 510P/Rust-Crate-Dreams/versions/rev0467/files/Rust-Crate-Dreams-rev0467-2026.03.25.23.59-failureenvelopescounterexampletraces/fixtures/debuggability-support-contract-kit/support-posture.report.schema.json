{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/debuggability-support-contract-kit/support-posture.report.schema.json",
  "title": "SupportPostureReport",
  "type": "object",
  "required": ["verdict", "reasons", "confidence"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["interactive_debugger", "backtrace_only", "crash_symbolication_only", "manual_review_required"]
    },
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "policy_match": {
      "type": "string",
      "enum": ["matches_policy", "weaker_than_policy", "stronger_than_policy", "policy_missing", "manual_review_required"]
    },
    "artifact_gaps": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
