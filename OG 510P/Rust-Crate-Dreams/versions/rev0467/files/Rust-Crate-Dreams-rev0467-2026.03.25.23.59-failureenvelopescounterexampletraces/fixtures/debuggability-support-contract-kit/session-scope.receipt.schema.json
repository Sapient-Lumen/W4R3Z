{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/fixtures/debuggability-support-contract-kit/session-scope.receipt.schema.json",
  "title": "Session Scope Receipt",
  "type": "object",
  "required": ["schema_version", "subject", "session_scope", "host", "debugger", "confidence"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {
      "type": "object",
      "required": ["artifact_name", "artifact_kind"],
      "properties": {
        "artifact_name": {"type": "string"},
        "artifact_kind": {"type": "string"},
        "build_profile": {"type": "string"}
      },
      "additionalProperties": true
    },
    "session_scope": {
      "type": "object",
      "required": ["kind", "launch_route"],
      "properties": {
        "kind": {"type": "string"},
        "launch_route": {"type": "string"},
        "artifact_basis": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "host": {
      "type": "object",
      "required": ["os"],
      "properties": {
        "os": {"type": "string"},
        "arch": {"type": "string"}
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "properties": {
        "triple": {"type": "string"},
        "os": {"type": "string"},
        "arch": {"type": "string"}
      },
      "additionalProperties": true
    },
    "debugger": {
      "type": "object",
      "required": ["family", "version"],
      "properties": {
        "family": {"type": "string"},
        "frontend": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "confidence": {"type": "string"},
    "provenance": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
