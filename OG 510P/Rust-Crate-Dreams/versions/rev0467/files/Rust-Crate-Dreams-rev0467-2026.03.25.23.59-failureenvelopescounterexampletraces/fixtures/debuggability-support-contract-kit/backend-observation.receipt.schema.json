{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/debuggability-support-contract-kit/backend-observation.receipt.schema.json",
  "title": "Debuggability backend observation receipt",
  "type": "object",
  "required": ["version", "observations"],
  "properties": {
    "version": {"type": "string"},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "backend_family",
          "os",
          "evidence_kind",
          "checked_capabilities",
          "verdict"
        ],
        "properties": {
          "backend_family": {
            "type": "string",
            "enum": [
              "gdb",
              "lldb",
              "cdb",
              "visual_studio_windows",
              "manual_other"
            ]
          },
          "backend_version": {"type": "string"},
          "os": {"type": "string"},
          "target": {"type": "string"},
          "evidence_kind": {
            "type": "string",
            "enum": [
              "interactive_session",
              "artifact_inference_only",
              "imported_report",
              "manual_review_required"
            ]
          },
          "checked_capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "symbol_loading",
                "visualizer_loading",
                "stack_navigation",
                "breakpoints",
                "async_inspection",
                "rust_expression_evaluation"
              ]
            }
          },
          "unchecked_capabilities": {
            "type": "array",
            "items": {"type": "string"}
          },
          "verdict": {
            "type": "string",
            "enum": [
              "observed_working",
              "observed_partial",
              "artifact_inference_only",
              "manual_review_required"
            ]
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
