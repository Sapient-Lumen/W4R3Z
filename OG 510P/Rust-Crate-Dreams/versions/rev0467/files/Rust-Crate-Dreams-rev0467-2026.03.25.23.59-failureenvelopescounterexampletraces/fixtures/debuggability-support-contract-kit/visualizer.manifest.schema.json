{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/debuggability-support-contract-kit/visualizer.manifest.schema.json",
  "title": "VisualizerManifest",
  "type": "object",
  "required": ["assets"],
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["backend", "embedding_mode", "status"],
        "properties": {
          "backend": {"type": "string", "enum": ["natvis", "gdb"]},
          "embedding_mode": {"type": "string", "enum": ["embedded", "external_expected", "manual_review_required"]},
          "status": {"type": "string", "enum": ["present", "missing", "manual_review_required"]},
          "path": {"type": "string"},
          "target_family": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
