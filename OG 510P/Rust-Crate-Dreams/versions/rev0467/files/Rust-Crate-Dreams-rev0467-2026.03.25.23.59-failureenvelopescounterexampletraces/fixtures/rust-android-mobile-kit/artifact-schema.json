{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "spec_version",
    "kind",
    "created_at",
    "report"
  ],
  "properties": {
    "spec_version": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "rust-android-mobile-kit"
    },
    "created_at": {
      "type": "string"
    },
    "report": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "array"
        },
        "ndk": {
          "type": "object"
        },
        "artifacts": {
          "type": "array"
        },
        "doctor": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}