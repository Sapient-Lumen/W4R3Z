{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rust Android Mobile Kit load doctor report",
  "type": "object",
  "required": [
    "status",
    "findings"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "error",
        "manual_review_required"
      ]
    },
    "package_mode": {
      "type": "string",
      "enum": [
        "jnilibs",
        "aar",
        "unknown",
        "manual_review_required"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "summary"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manual_review_required": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
