{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "text-input-kit web-edit-path receipt",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "adapter",
    "path_class",
    "focus_route",
    "ime_event_surface",
    "candidate_anchor_precision",
    "selection_bounds_sync",
    "character_bounds_sync",
    "accessibility_mirror",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "adapter": {
      "type": "string"
    },
    "path_class": {
      "enum": [
        "native_winit",
        "web_hidden_input_fallback",
        "web_editcontext_experimental",
        "dom_editable_delegate",
        "toolkit_native_bridge",
        "manual_review_required"
      ]
    },
    "focus_route": {
      "enum": [
        "native_widget",
        "canvas_direct",
        "hidden_input_proxy",
        "editcontext_attached",
        "dom_editable",
        "toolkit_bridge",
        "manual_review_required"
      ]
    },
    "ime_event_surface": {
      "enum": [
        "native_ime_events",
        "dom_beforeinput_composition",
        "editcontext",
        "emulated",
        "unsupported",
        "manual_review_required"
      ]
    },
    "candidate_anchor_precision": {
      "enum": [
        "precise",
        "approximate",
        "detached_corner_fallback",
        "unsupported",
        "manual_review_required"
      ]
    },
    "selection_bounds_sync": {
      "enum": [
        "full",
        "partial",
        "none",
        "manual_review_required"
      ]
    },
    "character_bounds_sync": {
      "enum": [
        "full",
        "partial",
        "none",
        "manual_review_required"
      ]
    },
    "accessibility_mirror": {
      "enum": [
        "native_accessible_text",
        "offscreen_dom_mirror",
        "toolkit_export",
        "none",
        "manual_review_required"
      ]
    },
    "fullscreen_behavior": {
      "enum": [
        "normal",
        "fragile",
        "unsupported",
        "manual_review_required"
      ]
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
