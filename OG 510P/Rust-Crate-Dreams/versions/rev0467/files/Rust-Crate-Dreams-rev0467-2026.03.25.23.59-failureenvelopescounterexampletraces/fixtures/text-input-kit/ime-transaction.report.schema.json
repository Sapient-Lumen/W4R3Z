{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/textinput/ime-transaction.report.schema.json",
  "title": "Text input IME transaction report",
  "type": "object",
  "required": ["report_version", "subject", "backend", "transactions"],
  "properties": {
    "report_version": {"type": "string"},
    "subject": {"type": "string"},
    "backend": {"type": "string"},
    "summary": {
      "type": "object",
      "properties": {
        "transaction_count": {"type": "integer", "minimum": 0},
        "overlap_detected": {"type": "boolean"},
        "manual_review_required": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["transaction_id", "class", "engine_verdict"],
        "properties": {
          "transaction_id": {"type": "string"},
          "class": {
            "type": "string",
            "enum": [
              "preedit_started",
              "preedit_updated",
              "commit_applied",
              "commit_replaces_range",
              "preedit_cancelled",
              "keyboardinput_overlap_detected",
              "manual_review_required"
            ]
          },
          "preedit": {"type": ["string", "null"]},
          "commit_text": {"type": ["string", "null"]},
          "replacement_range": {
            "type": ["object", "null"],
            "properties": {
              "start_utf8": {"type": "integer", "minimum": 0},
              "end_utf8": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "engine_verdict": {"type": "string", "enum": ["applied", "deduplicated", "ignored", "manual-review-required"]},
          "source_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
