{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/textinput/backend-capability.receipt.schema.json",
  "title": "Text input backend capability receipt",
  "type": "object",
  "required": ["receipt_version", "backend_id", "platform", "capabilities"],
  "properties": {
    "receipt_version": {"type": "string"},
    "backend_id": {"type": "string"},
    "platform": {"type": "string"},
    "adapter_strategy": {"type": "string", "enum": ["native_winit", "web_hidden_input", "toolkit_owned", "manual-review-required"]},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "status"],
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "ime_events",
              "candidate_anchor",
              "replacement_range",
              "dead_keys",
              "fullscreen_behavior",
              "accessibility_export"
            ]
          },
          "status": {"type": "string", "enum": ["supported", "unsupported", "approximate", "manual-review-required"]},
          "notes": {"type": "array", "items": {"type": "string"}},
          "upstream_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
