{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/textinput/selection-contract.report.schema.json",
  "title": "Text input selection contract report",
  "type": "object",
  "required": ["report_version", "subject", "selection_policy", "checks"],
  "properties": {
    "report_version": {"type": "string"},
    "subject": {"type": "string"},
    "selection_policy": {
      "type": "object",
      "required": ["grapheme_delete", "word_nav", "line_nav", "visual_logical_policy"],
      "properties": {
        "grapheme_delete": {"type": "string", "enum": ["cluster_safe", "scalar_only", "unknown"]},
        "word_nav": {"type": "string", "enum": ["defined", "toolkit_owned", "unknown"]},
        "line_nav": {"type": "string", "enum": ["defined", "layout_owned", "unknown"]},
        "visual_logical_policy": {"type": "string", "enum": ["logical", "visual", "mixed", "manual-review-required"]}
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "class", "status"],
        "properties": {
          "check_id": {"type": "string"},
          "class": {
            "type": "string",
            "enum": [
              "grapheme_delete_safe",
              "word_nav_defined",
              "line_nav_defined",
              "replacement_range_honored",
              "selection_anchor_stable",
              "visual_logical_policy_declared",
              "manual_review_required"
            ]
          },
          "status": {"type": "string", "enum": ["pass", "warning", "fail", "manual-review-required"]},
          "summary": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
