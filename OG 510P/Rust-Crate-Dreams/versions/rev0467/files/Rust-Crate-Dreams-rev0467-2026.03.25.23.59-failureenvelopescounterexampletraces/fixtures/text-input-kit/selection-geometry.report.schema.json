{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "text-input-kit selection-geometry report",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "ime_window_anchor",
    "caret_rect_updates",
    "selection_bounds_updates",
    "character_bounds_updates",
    "preedit_render",
    "geometry_consistency",
    "accessibility_reflection",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "ime_window_anchor": {
      "enum": [
        "inline_precise",
        "caret_rect_precise",
        "approximate",
        "detached_corner",
        "unsupported",
        "manual_review_required"
      ]
    },
    "caret_rect_updates": {
      "enum": [
        "full",
        "partial",
        "none",
        "manual_review_required"
      ]
    },
    "selection_bounds_updates": {
      "enum": [
        "full",
        "partial",
        "none",
        "manual_review_required"
      ]
    },
    "character_bounds_updates": {
      "enum": [
        "full",
        "partial",
        "none",
        "manual_review_required"
      ]
    },
    "preedit_render": {
      "enum": [
        "inline",
        "overlay",
        "hidden_until_commit",
        "detached",
        "manual_review_required"
      ]
    },
    "geometry_consistency": {
      "enum": [
        "stable",
        "drift_detected",
        "fullscreen_breakage",
        "missing_bounds",
        "manual_review_required"
      ]
    },
    "accessibility_reflection": {
      "enum": [
        "value_and_selection",
        "value_only",
        "offscreen_mirror_required",
        "missing",
        "manual_review_required"
      ]
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
