{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rendering-policy.receipt",
  "type": "object",
  "required": ["diagnostic_rendering_mode", "message_format_flags", "evidence_sources"],
  "properties": {
    "diagnostic_rendering_mode": {
      "type": "string",
      "enum": ["embedded_rendered_field", "embedded_rendered_field_ansi", "cargo_rendered", "mixed", "unknown"]
    },
    "message_format_flags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_sources": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
