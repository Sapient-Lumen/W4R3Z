{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "event-stream-session.manifest",
  "type": "object",
  "required": ["session_id", "command_lane", "workspace_root", "profile", "toolchain_basis"],
  "properties": {
    "session_id": {"type": "string"},
    "command_lane": {"type": "string"},
    "workspace_root": {"type": "string"},
    "profile": {"type": "string"},
    "target_posture": {"type": "string", "enum": ["host_only", "single_target", "multi_target", "custom_target"]},
    "toolchain_basis": {"type": "string", "enum": ["rustup_override", "toolchain_file", "system_cargo", "manual_review_required"]},
    "source_inputs": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
