{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "foreign-output.record",
  "type": "object",
  "required": ["source_kind", "capture_mode", "raw_text"],
  "properties": {
    "source_kind": {
      "type": "string",
      "enum": [
        "proc_macro_stdout",
        "proc_macro_stderr",
        "build_script_stdout",
        "build_script_stderr",
        "runner_stdout",
        "runner_stderr",
        "other"
      ]
    },
    "capture_mode": {
      "type": "string",
      "enum": ["line_exact", "chunk_exact", "lossy_excerpt"]
    },
    "package_id": {"type": "string"},
    "target_name": {"type": "string"},
    "raw_text": {"type": "string"},
    "parse_status": {
      "type": "string",
      "enum": ["not_json", "broken_json", "mixed_stream", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
