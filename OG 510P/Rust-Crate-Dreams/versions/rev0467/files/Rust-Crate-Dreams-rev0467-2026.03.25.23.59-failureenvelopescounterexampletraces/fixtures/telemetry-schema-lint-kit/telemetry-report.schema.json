{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "summary": {
      "properties": {
        "events_seen": {
          "type": "integer"
        },
        "spans_seen": {
          "type": "integer"
        },
        "violations": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "violations": {
      "items": {
        "properties": {
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warn",
              "error"
            ],
            "type": "string"
          }
        },
        "required": [
          "severity",
          "message"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "summary",
    "violations"
  ],
  "title": "telemetry-report.json",
  "type": "object"
}