{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/candidate-basis.receipt.schema.json",
  "title": "Crate pathfinder candidate basis receipt",
  "type": "object",
  "required": ["schema_version", "task", "candidate", "source_inputs", "manual_review_required"],
  "properties": {
    "schema_version": {"type": "string"},
    "task": {"type": "string"},
    "candidate": {"type": "string"},
    "source_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_kind", "source_ref", "fact_classes"],
        "properties": {
          "source_kind": {"type": "string"},
          "source_ref": {"type": "string"},
          "fact_classes": {
            "type": "array",
            "items": {"type": "string"}
          },
          "authority_class": {
            "type": ["string", "null"],
            "enum": ["crate_authored", "official_tooling", "registry_surface", "hosted_docs", "imported_receipt", "manual_observation", "inference", null]
          },
          "freshness_class": {
            "type": ["string", "null"],
            "enum": ["fresh", "stale", "unknown", null]
          },
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "inference_notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "unresolved_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
