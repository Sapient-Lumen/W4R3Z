{
  "$schema": "../../decision-program.runbook.schema.json",
  "schema_version": "0.1.0",
  "program_id": "service-stack-adoption-program-0.1",
  "program_version": "0.1.0",
  "stages": [
    {
      "stage_id": "explore",
      "profile_refs": [
        "policy-profile.pack.json#/explore-default-0.1"
      ],
      "required_inputs": [
        "task-profile.json",
        "decision-pack.report.json",
        "candidate-basis.receipt.json",
        "profile-satisfaction.report.json"
      ],
      "approval_roles": [
        "developer",
        "reviewer"
      ],
      "allowed_exit_statuses": [
        "keep",
        "conditional_keep",
        "hold"
      ],
      "reopen_trigger_refs": [
        "recheck-ticket.manifest.json#/docs_or_advisory_or_pubtime"
      ],
      "notes": "Exploratory posture may keep visible runner-ups and bounded uncertainty."
    },
    {
      "stage_id": "enterprise_offline_gate",
      "profile_refs": [
        "policy-profile.pack.json#/enterprise-offline-0.1"
      ],
      "required_inputs": [
        "basis-lock.manifest.json",
        "review-packet.manifest.json",
        "materialization-plan.json",
        "profile-satisfaction.report.json"
      ],
      "approval_roles": [
        "platform-reviewer",
        "release-owner"
      ],
      "allowed_exit_statuses": [
        "keep",
        "conditional_keep",
        "hold",
        "split_boundary",
        "replace_later"
      ],
      "reopen_trigger_refs": [
        "recheck-ticket.manifest.json#/mirror_or_source_parity_shift",
        "policy-exception.receipt.json#/expiry"
      ],
      "notes": "Enterprise-offline progression requires offline/materialization posture without rewriting the exploratory basis."
    }
  ],
  "progression_rules": [
    {
      "from_stage": "explore",
      "to_stage": "enterprise_offline_gate",
      "must_inherit": [
        "basis-lock.manifest.json",
        "decision-pack.report.json",
        "profile-satisfaction.report.json"
      ],
      "must_add": [
        "materialization-plan.json",
        "source-parity.report.json",
        "policy-profile.pack.json#/enterprise-offline-0.1"
      ],
      "may_remain_open": [
        "one-bounded-parity-exception"
      ],
      "disallowed_shortcuts": [
        "replace-old-basis-lock",
        "treat-docsrs-visibility-as-offline-proof"
      ]
    }
  ],
  "allowed_exit_statuses": [
    "keep",
    "conditional_keep",
    "hold",
    "split_boundary",
    "replace_later",
    "stop_and_reopen_compare"
  ]
}