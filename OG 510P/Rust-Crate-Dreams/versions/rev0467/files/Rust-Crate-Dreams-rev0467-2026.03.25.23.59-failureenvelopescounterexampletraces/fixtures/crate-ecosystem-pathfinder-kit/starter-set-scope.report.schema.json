{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/starter-set-scope.report.schema.json",
  "title": "Crate pathfinder starter-set scope report",
  "type": "object",
  "required": ["schema_version", "task", "scope_class"],
  "properties": {
    "schema_version": {"type": "string"},
    "task": {"type": "string"},
    "scope_class": {
      "type": "string",
      "enum": [
        "teaching_baseline",
        "production_baseline",
        "org_policy_baseline",
        "target_specific_baseline",
        "manual_review_required"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "non_goals": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
