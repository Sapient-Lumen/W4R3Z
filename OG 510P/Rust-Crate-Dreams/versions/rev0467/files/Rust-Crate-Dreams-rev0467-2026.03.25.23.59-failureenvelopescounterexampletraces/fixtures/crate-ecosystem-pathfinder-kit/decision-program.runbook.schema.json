{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/crate-ecosystem-pathfinder-kit/decision-program.runbook.schema.json",
  "title": "decision-program.runbook",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "program_version",
    "stages",
    "progression_rules",
    "allowed_exit_statuses"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "program_id": {
      "type": "string"
    },
    "program_version": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_id",
          "profile_refs",
          "required_inputs",
          "approval_roles",
          "allowed_exit_statuses"
        ],
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "profile_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "required_inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "approval_roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "allowed_exit_statuses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "reopen_trigger_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "progression_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_stage",
          "to_stage",
          "must_inherit",
          "must_add"
        ],
        "properties": {
          "from_stage": {
            "type": "string"
          },
          "to_stage": {
            "type": "string"
          },
          "must_inherit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "must_add": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "may_remain_open": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "disallowed_shortcuts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "allowed_exit_statuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "keep",
          "conditional_keep",
          "hold",
          "split_boundary",
          "replace_later",
          "stop_and_reopen_compare"
        ]
      }
    }
  }
}