{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/crate-ecosystem-pathfinder-kit/decision-watch.report.schema.json",
  "title": "decision-watch.report",
  "type": "object",
  "required": [
    "task_lane",
    "starter_set",
    "watch_state",
    "last_reviewed_at",
    "trigger_events",
    "manual_review_required"
  ],
  "properties": {
    "task_lane": {"type": "string"},
    "starter_set": {"type": "string"},
    "watch_state": {
      "enum": ["steady", "review_due", "invalidated", "superseded", "manual_review_required"]
    },
    "last_reviewed_at": {"type": "string"},
    "next_review_due_at": {"type": "string"},
    "trigger_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_class", "effect"],
        "properties": {
          "event_class": {"type": "string"},
          "effect": {"type": "string"},
          "evidence_ref": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "manual_review_required": {"type": "boolean"},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
