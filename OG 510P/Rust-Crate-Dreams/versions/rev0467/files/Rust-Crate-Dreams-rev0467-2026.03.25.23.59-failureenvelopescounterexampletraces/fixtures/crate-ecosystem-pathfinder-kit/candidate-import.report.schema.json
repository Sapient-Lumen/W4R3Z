{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/candidate-import.report.schema.json",
  "title": "Crate pathfinder candidate import report",
  "type": "object",
  "required": ["schema_version", "task", "sources", "candidates"],
  "properties": {
    "schema_version": {"type": "string"},
    "task": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "version": {"type": ["string", "null"]},
          "roles": {
            "type": "array",
            "items": {"type": "string"}
          },
          "source_kinds": {
            "type": "array",
            "items": {"type": "string"}
          },
          "freshness_class": {
            "type": ["string", "null"],
            "enum": ["fresh", "stale", "unknown", null]
          },
          "health_import": {"type": ["string", "null"]},
          "trust_import": {"type": ["string", "null"]},
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
