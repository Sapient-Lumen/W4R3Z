{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pathfinder Decision Carryforward Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "carryforward_id",
    "previous_decision_ref",
    "adjudication_session_ref",
    "resulting_decision_ref",
    "carryforward_mode"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "carryforward_id": {
      "type": "string"
    },
    "previous_decision_ref": {
      "type": "string"
    },
    "adjudication_session_ref": {
      "type": "string"
    },
    "resulting_decision_ref": {
      "type": "string"
    },
    "carryforward_mode": {
      "type": "string",
      "enum": [
        "full_inherit",
        "partial_inherit",
        "split_scope",
        "temporary_keep",
        "transition_opened"
      ]
    },
    "inherited_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_revisit_trigger": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
