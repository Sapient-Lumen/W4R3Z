{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/crate-ecosystem-pathfinder-kit/policy-exception.receipt.schema.json",
  "title": "policy-exception.receipt",
  "type": "object",
  "required": [
    "artifact_kind",
    "exception_id",
    "decision_refs",
    "subject",
    "scope",
    "owner",
    "authority",
    "rationale",
    "evidence_refs",
    "support_ceiling",
    "exit_path",
    "status"
  ],
  "properties": {
    "artifact_kind": {"const": "policy-exception.receipt"},
    "exception_id": {"type": "string"},
    "decision_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "subject": {
      "type": "object",
      "required": ["crate", "reason_class"],
      "properties": {
        "crate": {"type": "string"},
        "version": {"type": "string"},
        "reason_class": {
          "type": "string",
          "enum": [
            "audit_gap",
            "advisory_ignore",
            "docs_support_gap",
            "semver_override",
            "target_gap",
            "interop_gap",
            "other"
          ]
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["task_profile", "deployment_scope"],
      "properties": {
        "task_profile": {"type": "string"},
        "deployment_scope": {"type": "string"},
        "targets": {"type": "array", "items": {"type": "string"}},
        "profiles": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "required": ["team", "contact"],
      "properties": {
        "team": {"type": "string"},
        "contact": {"type": "string"}
      },
      "additionalProperties": false
    },
    "authority": {"type": "string"},
    "rationale": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "support_ceiling": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "exit_path": {
      "type": "object",
      "required": ["review_by", "remove_when"],
      "properties": {
        "review_by": {"type": "string", "format": "date"},
        "remove_when": {"type": "string"},
        "next_action": {
          "type": "string",
          "enum": ["renew", "remove", "revalidate", "transition"]
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["open", "renewed", "removed", "transitioned", "manual_review_required"]
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
