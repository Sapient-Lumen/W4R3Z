{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/task-profile.schema.json",
  "title": "Crate pathfinder task profile",
  "type": "object",
  "required": [
    "schema_version",
    "task",
    "roles"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "constraints": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": [
            "string",
            "null"
          ]
        },
        "msrv_floor": {
          "type": [
            "string",
            "null"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no_std": {
          "type": "boolean"
        },
        "license_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "preferences": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
