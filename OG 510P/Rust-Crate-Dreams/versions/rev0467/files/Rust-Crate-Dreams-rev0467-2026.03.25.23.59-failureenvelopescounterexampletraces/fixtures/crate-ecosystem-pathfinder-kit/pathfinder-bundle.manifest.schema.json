{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/pathfinder-bundle.manifest.schema.json",
  "title": "Crate pathfinder bundle manifest",
  "type": "object",
  "required": [
    "schema_version",
    "task_profile",
    "decision_pack",
    "bundle_members"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "task_profile": {
      "type": "string"
    },
    "decision_pack": {
      "type": "string"
    },
    "starter_set_lock": {
      "type": [
        "string",
        "null"
      ]
    },
    "bundle_members": {
      "type": "object",
      "required": [
        "candidate_basis_receipts",
        "support_visibility_reports",
        "evidence_origin_reports"
      ],
      "properties": {
        "candidate_basis_receipts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "support_visibility_reports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_origin_reports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "watch_policies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_timebox_receipts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replay_reports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_elimination_receipts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_reentry_policies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "manual_review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
