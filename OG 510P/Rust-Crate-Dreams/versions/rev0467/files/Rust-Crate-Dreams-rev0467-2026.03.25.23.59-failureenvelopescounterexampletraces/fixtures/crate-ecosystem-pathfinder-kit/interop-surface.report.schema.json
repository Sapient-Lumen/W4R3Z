{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/interop-surface.report.schema.json",
  "title": "Crate pathfinder interop surface report",
  "type": "object",
  "required": ["schema_version", "task", "surfaces"],
  "properties": {
    "schema_version": {"type": "string"},
    "task": {"type": "string"},
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["crate", "coupling"],
        "properties": {
          "crate": {"type": "string"},
          "coupling": {
            "type": "string",
            "enum": ["low", "medium", "high", "manual_review_required"]
          },
          "runtime": {"type": ["string", "null"]},
          "no_std": {"type": ["boolean", "null"]},
          "proc_macro": {"type": ["boolean", "null"]},
          "build_script": {"type": ["boolean", "null"]},
          "targets": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
