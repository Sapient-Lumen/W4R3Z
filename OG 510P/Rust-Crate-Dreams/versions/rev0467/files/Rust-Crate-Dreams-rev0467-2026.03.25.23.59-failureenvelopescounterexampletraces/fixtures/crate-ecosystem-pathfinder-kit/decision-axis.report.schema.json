{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/decision-axis.report.schema.json",
  "title": "Crate pathfinder decision axis report",
  "type": "object",
  "required": ["schema_version", "task", "candidates"],
  "properties": {
    "schema_version": {"type": "string"},
    "task": {"type": "string"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["crate", "axes"],
        "properties": {
          "crate": {"type": "string"},
          "axes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "value"],
              "properties": {
                "name": {
                  "type": "string",
                  "enum": [
                    "task_fit",
                    "role_coverage",
                    "interop_fit",
                    "teaching_fit",
                    "adoption_signal",
                    "health_import",
                    "trust_import",
                    "migration_friction",
                    "uncertainty"
                  ]
                },
                "value": {
                  "type": "string",
                  "enum": ["strong", "good", "mixed", "weak", "manual_review_required"]
                },
                "notes": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
