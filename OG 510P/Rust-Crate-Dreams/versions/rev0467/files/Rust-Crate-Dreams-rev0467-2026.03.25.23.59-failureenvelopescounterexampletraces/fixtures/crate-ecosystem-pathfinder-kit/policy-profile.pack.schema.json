{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/crate-ecosystem-pathfinder-kit/policy-profile.pack.schema.json",
  "title": "policy-profile.pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_kind",
    "profile_version",
    "intended_receivers",
    "required_evidence_floors",
    "allowed_exception_budget",
    "non_claims"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "profile_id": { "type": "string" },
    "profile_kind": {
      "type": "string",
      "enum": [
        "explore_default",
        "team_default",
        "enterprise_offline",
        "safety_onramp",
        "custom"
      ]
    },
    "profile_version": { "type": "string" },
    "intended_receivers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "required_evidence_floors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["floor_id", "requirement", "severity_if_missing"],
        "properties": {
          "floor_id": { "type": "string" },
          "requirement": { "type": "string" },
          "severity_if_missing": {
            "type": "string",
            "enum": ["conditional", "manual_review_required", "fail"]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "allowed_exception_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_open_exceptions", "owner_required", "expiry_required"],
      "properties": {
        "max_open_exceptions": { "type": "integer", "minimum": 0 },
        "owner_required": { "type": "boolean" },
        "expiry_required": { "type": "boolean" },
        "renewal_policy": { "type": "string" }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "task_profile_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "basis_expectations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
