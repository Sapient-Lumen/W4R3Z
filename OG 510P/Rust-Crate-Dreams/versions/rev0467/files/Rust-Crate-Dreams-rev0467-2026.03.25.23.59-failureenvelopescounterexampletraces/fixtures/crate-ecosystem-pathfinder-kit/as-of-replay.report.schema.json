{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-ecosystem-pathfinder/as-of-replay.report.schema.json",
  "title": "Crate pathfinder as-of replay report",
  "type": "object",
  "required": ["schema_version", "task_lane", "starter_set", "replay_mode", "baseline_timebox", "current_view_at", "drift_events", "replay_verdict", "manual_review_required"],
  "properties": {
    "schema_version": {"type": "string"},
    "task_lane": {"type": "string"},
    "starter_set": {"type": "string"},
    "replay_mode": {
      "type": "string",
      "enum": ["as_frozen", "current_view", "compare"]
    },
    "baseline_timebox": {"type": "string"},
    "current_view_at": {"type": "string"},
    "candidate_deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate", "freeze_basis_status", "current_view_status"],
        "properties": {
          "candidate": {"type": "string"},
          "freeze_basis_status": {"type": "string"},
          "current_view_status": {"type": "string"},
          "visibility_drift": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "drift_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["drift_class", "effect", "evidence_ref"],
        "properties": {
          "drift_class": {"type": "string"},
          "effect": {
            "type": "string",
            "enum": ["inform_only", "review_due", "invalidate_until_reviewed"]
          },
          "evidence_ref": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "replay_verdict": {
      "type": "string",
      "enum": ["steady_under_replay", "review_due", "invalidated", "manual_review_required"]
    },
    "manual_review_required": {"type": "boolean"},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
