{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/crate-ecosystem-pathfinder-kit/starter-set-readiness.report.schema.json",
  "title": "starter-set-readiness.report",
  "type": "object",
  "required": [
    "task_lane",
    "candidate_set",
    "readiness_class",
    "freeze_allowed",
    "blocking_reasons",
    "manual_review_required"
  ],
  "properties": {
    "task_lane": {
      "type": "string"
    },
    "candidate_set": {
      "type": "string"
    },
    "readiness_class": {
      "enum": [
        "freeze_ready",
        "companion_gap_blocks_freeze",
        "freshness_cooldown",
        "scope_split_required",
        "manual_review_required"
      ]
    },
    "freeze_allowed": {
      "type": "boolean"
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
