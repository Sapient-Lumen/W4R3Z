{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/crate-ecosystem-pathfinder-kit/evidence-campaign.plan.schema.json",
  "title": "evidence-campaign.plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "report_ref",
    "stage_id",
    "subject_ref",
    "campaign_items",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "report_ref": {
      "type": "string"
    },
    "stage_id": {
      "type": "string"
    },
    "subject_ref": {
      "type": "string"
    },
    "campaign_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "gap_id",
          "artifact_to_produce",
          "authority_route",
          "automation_class",
          "owner_role",
          "success_condition"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "gap_id": {
            "type": "string"
          },
          "artifact_to_produce": {
            "type": "string"
          },
          "authority_route": {
            "type": "string"
          },
          "automation_class": {
            "type": "string",
            "enum": [
              "local_command",
              "hosted_import",
              "manual_review",
              "upstream_request"
            ]
          },
          "owner_role": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "success_condition": {
            "type": "string"
          },
          "failure_condition": {
            "type": "string"
          },
          "partial_success_condition": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "stage_can_progress",
          "remaining_gaps_need_adjudication",
          "gap_moved_to_exception",
          "blocked_upstream",
          "new_compare_required"
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}