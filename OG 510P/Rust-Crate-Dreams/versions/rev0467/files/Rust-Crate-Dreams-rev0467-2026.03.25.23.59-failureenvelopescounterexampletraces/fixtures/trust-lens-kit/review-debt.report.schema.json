{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/schemas/trust-lens-kit/review-debt.report.schema.json",
  "title": "Trust Lens Review Debt Report",
  "type": "object",
  "required": ["subject", "review_debt_class", "items"],
  "properties": {
    "subject": {"type": "string"},
    "review_debt_class": {
      "type": "string",
      "enum": [
        "no_open_review_debt",
        "dangerous_effect_review_pending",
        "context_sensitive_audit_pending",
        "identity_review_pending",
        "policy_exception_pending",
        "manual_review_required"
      ]
    },
    "items": {
      "type": "array",
      "items": {"type": "string"}
    },
    "summary": {"type": "string"}
  },
  "additionalProperties": true
}
