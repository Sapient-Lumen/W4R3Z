{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/schemas/trust-lens-kit/identity-risk.report.schema.json",
  "title": "Trust Lens Identity Risk Report",
  "type": "object",
  "required": ["subject", "identity_risk_class", "evidence_basis"],
  "properties": {
    "subject": {"type": "string"},
    "identity_risk_class": {
      "type": "string",
      "enum": [
        "no_confusable_signal",
        "name_confusable_detected",
        "campaign_adjacent_identity",
        "owner_or_origin_manual_review_required",
        "manual_review_required"
      ]
    },
    "confusable_with": {
      "type": "array",
      "items": {"type": "string"}
    },
    "summary": {"type": "string"},
    "evidence_basis": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
