{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/schemas/trust-lens-kit/policy-decision.report.schema.json",
  "title": "Trust Lens Policy Decision Report",
  "type": "object",
  "required": ["subject", "decision", "reasons"],
  "properties": {
    "subject": {"type": "string"},
    "decision": {
      "type": "string",
      "enum": ["allow", "warn", "manual_review_required", "deny"]
    },
    "reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "summary": {"type": "string"}
  },
  "additionalProperties": true
}
