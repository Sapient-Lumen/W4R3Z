{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/schemas/trust-lens-kit/notification-channel.report.schema.json",
  "title": "Trust Lens Notification Channel Report",
  "type": "object",
  "required": ["subject", "channels"],
  "properties": {
    "subject": {"type": "string"},
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel", "status", "coverage_classes", "summary"],
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "rustsec_database",
              "rustsec_rss_feed",
              "cratesio_security_tab",
              "cratesio_trusted_publishing_setting",
              "rust_blog",
              "audit_import",
              "local_policy_import"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "consulted",
              "not_configured",
              "derived_only",
              "manual_review_required"
            ]
          },
          "coverage_classes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "known_vulnerability",
                "routine_malware_removal",
                "high_signal_malware_incident",
                "publish_identity_posture",
                "audit_import_change",
                "manual_review_only"
              ]
            }
          },
          "summary": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
