{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/schemas/trust-lens-kit/assumption-register.report.schema.json",
  "title": "Trust Lens Assumption Register",
  "type": "object",
  "required": ["subject", "assumptions"],
  "properties": {
    "subject": {"type": "string"},
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assumption_class", "strength", "summary"],
        "properties": {
          "assumption_class": {
            "type": "string",
            "enum": [
              "no_known_advisory_at_capture_time",
              "trusted_publishing_enabled",
              "audit_importer_trusted",
              "effect_scan_context_review_pending",
              "download_or_popularity_signal_weak_only",
              "manual_review_required"
            ]
          },
          "strength": {
            "type": "string",
            "enum": ["weak", "moderate", "strong", "blocking"]
          },
          "summary": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
