{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "script-support-bundle.manifest",
  "type": "object",
  "required": ["script", "artifacts"],
  "properties": {
    "script": {"type": "string"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "properties": {
          "kind": {"type": "string"},
          "path": {"type": "string"}
        }
      }
    },
    "manual_review": {"type": "array", "items": {"type": "string"}}
  }
}
