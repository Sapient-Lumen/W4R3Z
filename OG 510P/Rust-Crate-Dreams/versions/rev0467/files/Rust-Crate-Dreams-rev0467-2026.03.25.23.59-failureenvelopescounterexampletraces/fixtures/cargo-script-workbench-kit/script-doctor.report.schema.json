{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-script-workbench/script-doctor.report.schema.json",
  "title": "Cargo script doctor report",
  "type": "object",
  "required": ["schema_version", "verdicts"],
  "properties": {
    "schema_version": {"type": "string"},
    "verdicts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ok",
          "edition_defaulted",
          "frontmatter_parse_risk",
          "disallowed_field_present",
          "workspace_auto_discovery_disabled",
          "parent_config_influence_present",
          "tempdir_portability_risk",
          "export_requires_layout_decision",
          "manual_review_required"
        ]
      }
    },
    "summary": {"type": "string"}
  },
  "additionalProperties": false
}
