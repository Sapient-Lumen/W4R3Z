{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-script-workbench/script-lock.schema.json",
  "title": "Cargo script lock",
  "type": "object",
  "required": ["schema_version", "lock_path", "target_dir", "toolchain", "dependencies"],
  "properties": {
    "schema_version": {"type": "string"},
    "lock_path": {"type": "string"},
    "target_dir": {"type": "string"},
    "toolchain": {"type": "string"},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string"},
          "version": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
