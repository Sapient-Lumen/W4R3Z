{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-script-workbench/script.receipt.schema.json",
  "title": "Cargo script receipt",
  "type": "object",
  "required": [
    "schema_version",
    "script_path",
    "cwd",
    "workspace_auto_discovery",
    "target_dir",
    "lock_path",
    "config_roots"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "script_path": {"type": "string"},
    "cwd": {"type": "string"},
    "workspace_auto_discovery": {"type": "string", "enum": ["disabled", "enabled", "unknown"]},
    "target_dir": {"type": "string"},
    "lock_path": {"type": "string"},
    "config_roots": {"type": "array", "items": {"type": "string"}},
    "manifest_command_style": {"type": "string", "enum": ["direct_path", "manifest_path", "shebang", "unknown"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
