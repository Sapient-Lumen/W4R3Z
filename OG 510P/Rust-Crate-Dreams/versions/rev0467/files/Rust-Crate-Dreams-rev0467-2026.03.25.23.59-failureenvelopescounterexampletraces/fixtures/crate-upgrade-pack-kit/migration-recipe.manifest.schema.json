{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "migration recipe manifest",
  "type": "object",
  "required": ["schema_version", "recipes"],
  "properties": {
    "schema_version": {"type": "string"},
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "lane_id", "before_summary", "after_summary"],
        "properties": {
          "id": {"type": "string"},
          "lane_id": {"type": "string"},
          "before_summary": {"type": "string"},
          "after_summary": {"type": "string"},
          "required_features": {"type": "array", "items": {"type": "string"}},
          "required_targets": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "additionalProperties": true
}