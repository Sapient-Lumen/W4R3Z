{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "upgrade diff report",
  "type": "object",
  "required": ["schema_version", "changes"],
  "properties": {
    "schema_version": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "summary"],
        "properties": {
          "class": {"type": "string"},
          "summary": {"type": "string"},
          "lane_id": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": true
}