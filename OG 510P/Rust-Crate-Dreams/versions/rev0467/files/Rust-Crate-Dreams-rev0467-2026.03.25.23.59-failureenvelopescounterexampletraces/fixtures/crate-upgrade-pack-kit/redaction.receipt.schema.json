{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeRedactionReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "source_surface_refs",
    "target_surface_refs",
    "status",
    "operations",
    "verification_posture",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "source_surface_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_surface_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "applied",
        "verified",
        "not_needed"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "basis",
          "action",
          "subject_ref",
          "public_effect"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "basis": {
            "type": "string",
            "enum": [
              "local_paths",
              "internal_package_aliases",
              "private_registry_locator",
              "private_example_context",
              "unreviewed_internal_notes",
              "other_sensitive_context"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "drop",
              "rewrite",
              "generalize",
              "split_private_appendix",
              "hash_or_tokenize"
            ]
          },
          "subject_ref": {
            "type": "string"
          },
          "public_effect": {
            "type": "string",
            "enum": [
              "removed_from_public_surface",
              "replaced_with_generalized_text",
              "moved_to_private_context",
              "preserved_as_safe_summary"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "verification_posture": {
      "type": "string",
      "enum": [
        "manual_reviewed",
        "dual_reviewed",
        "schema_checked_only",
        "not_rechecked"
      ]
    },
    "private_context_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
