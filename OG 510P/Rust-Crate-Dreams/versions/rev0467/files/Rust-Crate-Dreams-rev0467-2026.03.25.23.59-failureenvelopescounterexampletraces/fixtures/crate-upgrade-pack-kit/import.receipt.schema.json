{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeImportReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "sources",
    "normalization_steps"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "source_ref",
          "consumption_mode",
          "stability_posture"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "cargo_semver_checks",
              "cargo_fix",
              "rustfix",
              "clippy_fix",
              "cargo_report_future_incompat",
              "cargo_report_sessions",
              "cargo_report_timings",
              "cargo_report_rebuilds",
              "cargo_metadata",
              "manual_annotation"
            ]
          },
          "source_ref": {
            "type": "string"
          },
          "consumption_mode": {
            "type": "string",
            "enum": [
              "verbatim_import",
              "normalized_extract",
              "summarized",
              "manual_note"
            ]
          },
          "stability_posture": {
            "type": "string",
            "enum": [
              "stable",
              "unstable",
              "external",
              "mixed",
              "unknown"
            ]
          },
          "native_identity": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "report_id": {
                "type": "string"
              },
              "session_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "metadata_format": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capture_context_ref": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "normalization_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lossiness_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
