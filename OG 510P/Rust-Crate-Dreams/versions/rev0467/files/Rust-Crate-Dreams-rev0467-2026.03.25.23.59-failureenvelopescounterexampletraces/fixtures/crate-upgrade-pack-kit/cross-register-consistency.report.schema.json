{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeCrossRegisterConsistencyReport",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "inputs",
    "checks",
    "overall_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "required": [
        "source_heads_ref",
        "pack_readiness_ref"
      ],
      "properties": {
        "source_heads_ref": {
          "type": "string"
        },
        "revalidation_window_ref": {
          "type": "string"
        },
        "freshness_state_ref": {
          "type": "string"
        },
        "pack_readiness_ref": {
          "type": "string"
        },
        "package_scope_ref": {
          "type": "string"
        },
        "followthrough_state_ref": {
          "type": "string"
        },
        "fixup_posture_ref": {
          "type": "string"
        },
        "export_posture_ref": {
          "type": "string"
        },
        "redaction_receipt_ref": {
          "type": "string"
        },
        "publication_surface_ref": {
          "type": "string"
        },
        "summary_claim_register_ref": {
          "type": "string"
        },
        "public_trace_path_ref": {
          "type": "string"
        },
        "durable_cue_ref": {
          "type": "string"
        },
        "deviation_ledger_ref": {
          "type": "string"
        },
        "warning_register_ref": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "capture_context_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "session_honesty_ref": {
          "type": "string"
        },
        "coverage_matrix_ref": {
          "type": "string"
        },
        "lane_selection_ref": {
          "type": "string"
        },
        "baseline_state_ref": {
          "type": "string"
        },
        "review_provenance_ref": {
          "type": "string"
        },
        "replay_bridge_ref": {
          "type": "string"
        },
        "surface_authorship_ref": {
          "type": "string"
        },
        "omission_register_ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "rule",
          "status",
          "reason"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "reason": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "unknown"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
