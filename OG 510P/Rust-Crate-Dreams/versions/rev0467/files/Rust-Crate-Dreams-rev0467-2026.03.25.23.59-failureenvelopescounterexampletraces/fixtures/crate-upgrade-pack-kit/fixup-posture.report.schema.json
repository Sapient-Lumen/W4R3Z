{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FixupPostureReport",
  "type": "object",
  "required": ["schema_version", "lane", "fixes"],
  "properties": {
    "schema_version": {"type": "string"},
    "lane": {"type": "string"},
    "fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["origin", "posture", "status"],
        "properties": {
          "origin": {
            "enum": [
              "cargo_fix",
              "rustfix",
              "clippy_fix",
              "maintainer_codemod",
              "manual_recipe_only",
              "no_fix_available"
            ]
          },
          "posture": {
            "enum": [
              "manual_only",
              "assisted_suggestion",
              "approval_required_single_action",
              "approval_required_sequence",
              "bounded_autorun"
            ]
          },
          "status": {"enum": ["observed", "declared", "blocked", "missing"]},
          "scope": {
            "type": "array",
            "items": {
              "enum": ["rust_source", "cargo_manifest", "config_file", "docs_snippet", "workspace_metadata"]
            }
          },
          "stop_conditions": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
