{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeWarningRegisterReport",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "warnings",
    "overall_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "warning_id",
          "label",
          "class",
          "severity",
          "audience",
          "status",
          "summary",
          "source_refs"
        ],
        "properties": {
          "warning_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "class": {
            "type": "string",
            "enum": [
              "source_head",
              "readiness",
              "scope",
              "followthrough",
              "fixup_posture",
              "freshness",
              "consistency",
              "export_posture",
              "publication_surface",
              "deviation",
              "session_posture"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "advisory",
              "blocking"
            ]
          },
          "audience": {
            "type": "string",
            "enum": [
              "maintainer_only",
              "public_contract"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "resolved",
              "suppressed_by_deviation"
            ]
          },
          "summary": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "surfaced_on_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deviation_ref": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "clean",
        "warnings_present",
        "blocking_warnings_present"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
