{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeSourceHeadsReport",
  "type": "object",
  "required": ["schema_version", "lane", "source_families"],
  "properties": {
    "schema_version": {"type": "string"},
    "lane": {"type": "string"},
    "source_families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_family_id", "import_refs", "operational_head_status", "citation_head_status"],
        "properties": {
          "source_family_id": {"type": "string"},
          "subject": {"type": "string"},
          "import_refs": {"type": "array", "items": {"type": "string"}},
          "tip_refs": {"type": "array", "items": {"type": "string"}},
          "operational_head_ref": {"type": "string"},
          "operational_head_status": {
            "type": "string",
            "enum": ["unique", "ambiguous", "missing", "advisory_only"]
          },
          "citation_head_ref": {"type": "string"},
          "citation_head_status": {
            "type": "string",
            "enum": ["unique_frozen", "missing", "ambiguous", "blocked"]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "operational_head_not_reviewed",
                "citation_head_missing",
                "citation_head_not_exact_pinned",
                "branch_ambiguous",
                "floating_alias_tip",
                "manual_review_required"
              ]
            }
          },
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
