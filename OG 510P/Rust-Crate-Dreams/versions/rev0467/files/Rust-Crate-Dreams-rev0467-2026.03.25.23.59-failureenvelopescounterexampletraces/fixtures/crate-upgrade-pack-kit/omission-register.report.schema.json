{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeOmissionRegisterReport",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "surface_state",
    "omissions",
    "overall_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "surface_state": {
      "type": "string",
      "enum": [
        "candidate_public",
        "frozen_public",
        "superseded_public"
      ]
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "omission_id",
          "target_surface",
          "subject_kind",
          "omission_reason",
          "disclosure_posture",
          "status"
        ],
        "properties": {
          "omission_id": {
            "type": "string"
          },
          "target_surface": {
            "type": "string",
            "enum": [
              "entry_summary",
              "publication_bundle",
              "public_contract",
              "trace_route",
              "supporting_context"
            ]
          },
          "subject_kind": {
            "type": "string",
            "enum": [
              "claim",
              "hazard",
              "receipt",
              "warning",
              "review_queue_item",
              "lane_cell",
              "source_head",
              "artifact",
              "local_context"
            ]
          },
          "ref": {
            "type": "string"
          },
          "omission_reason": {
            "type": "string",
            "enum": [
              "internal_working_only",
              "redaction_pending",
              "private_workspace_evidence",
              "local_only_nonportable",
              "floating_source",
              "not_citation_ready",
              "low_confidence_unresolved",
              "summary_compression",
              "out_of_scope_for_entry_surface",
              "unsupported_replay",
              "superseded"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "intentional",
              "temporary",
              "blocking",
              "unknown"
            ]
          },
          "disclosure_posture": {
            "type": "string",
            "enum": [
              "explicitly_disclosed",
              "warning_only",
              "trace_only",
              "missing_disclosure"
            ]
          },
          "related_warning_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_deviation_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fallback_public_ref": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "unknown"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
