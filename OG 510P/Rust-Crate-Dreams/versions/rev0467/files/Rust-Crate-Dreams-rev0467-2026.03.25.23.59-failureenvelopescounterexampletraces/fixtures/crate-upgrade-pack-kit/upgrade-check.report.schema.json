{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "upgrade check report",
  "type": "object",
  "required": ["schema_version", "lane_results"],
  "properties": {
    "schema_version": {"type": "string"},
    "lane_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lane_id", "status"],
        "properties": {
          "lane_id": {"type": "string"},
          "status": {"type": "string"},
          "checked_matrix": {"type": "array", "items": {"type": "string"}},
          "findings": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "additionalProperties": true
}