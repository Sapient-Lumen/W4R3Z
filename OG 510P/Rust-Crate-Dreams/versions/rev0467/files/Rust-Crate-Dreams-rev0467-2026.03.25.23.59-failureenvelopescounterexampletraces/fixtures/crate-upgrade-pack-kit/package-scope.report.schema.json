{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PackageScopeReport",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "scope_class",
    "packages"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "lane": { "type": "string" },
    "scope_class": {
      "enum": [
        "single_package",
        "published_subset",
        "workspace_subset",
        "whole_workspace"
      ]
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package_name",
          "role",
          "coverage"
        ],
        "properties": {
          "package_name": { "type": "string" },
          "role": {
            "enum": [
              "subject",
              "companion",
              "example_only",
              "binary_only",
              "internal_only"
            ]
          },
          "published": { "type": "boolean" },
          "coverage": {
            "enum": [
              "witnessed",
              "recipe_only",
              "declared_only",
              "excluded",
              "unknown"
            ]
          },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "excluded_scenarios": {
      "type": "array",
      "items": { "type": "string" }
    },
    "manual_review_remaining": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
