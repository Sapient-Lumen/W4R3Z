{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fixup hints receipt",
  "type": "object",
  "required": ["schema_version", "lane_id", "hints"],
  "properties": {
    "schema_version": {"type": "string"},
    "lane_id": {"type": "string"},
    "hints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "applicability"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string"},
          "applicability": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": true
}