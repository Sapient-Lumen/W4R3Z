{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HazardClassPolicy",
  "type": "object",
  "required": [
    "schema_version",
    "classes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class_name",
          "meaning"
        ],
        "properties": {
          "class_name": {
            "enum": [
              "machine_fix_available",
              "source_edit_required",
              "manifest_edit_required",
              "config_edit_required",
              "behavior_check_required",
              "manual_review_required",
              "unsupported_lane"
            ]
          },
          "meaning": {
            "type": "string"
          },
          "minimum_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "non_goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "example_hazards": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
