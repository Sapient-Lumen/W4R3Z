{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceLineageReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "imports"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "lane": { "type": "string" },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "import_id",
          "surface_kind",
          "authority_scope",
          "canonical_locator",
          "fetched_locator",
          "pin_status",
          "review_status",
          "promotion_status"
        ],
        "properties": {
          "import_id": { "type": "string" },
          "surface_kind": {
            "enum": [
              "github_release",
              "changelog_file",
              "migration_guide",
              "docs_page",
              "issue_thread",
              "release_pr",
              "blog_post",
              "other"
            ]
          },
          "authority_scope": {
            "enum": [
              "canonical_release_surface",
              "project_docs_surface",
              "advisory_discussion_surface",
              "unknown"
            ]
          },
          "canonical_locator": { "type": "string" },
          "fetched_locator": { "type": "string" },
          "pin_status": {
            "enum": [
              "exact_content_pinned",
              "tag_or_version_pinned",
              "path_only",
              "host_only",
              "floating_alias_only",
              "unresolved"
            ]
          },
          "review_status": {
            "enum": [
              "reviewed",
              "imported_unreviewed",
              "declared_only",
              "blocked"
            ]
          },
          "promotion_status": {
            "enum": [
              "may_back_hazard_authority",
              "advisory_only",
              "manual_review_only",
              "blocked_fail_closed"
            ]
          },
          "content_digest": { "type": "string" },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
