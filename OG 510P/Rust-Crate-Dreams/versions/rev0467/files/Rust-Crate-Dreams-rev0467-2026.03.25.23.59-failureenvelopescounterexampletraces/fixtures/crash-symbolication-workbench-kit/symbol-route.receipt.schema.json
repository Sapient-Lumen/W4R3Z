{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "symbol-route.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "source_order",
    "network_required",
    "timeout_posture"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "mode": {
      "enum": [
        "offline_only",
        "offline_preferred",
        "network_allowed",
        "network_required",
        "manual_review_required"
      ]
    },
    "source_order": {
      "type": "array",
      "items": {
        "enum": [
          "bundled_breakpad",
          "local_breakpad",
          "native_local_debuginfo",
          "native_server_debuginfo",
          "symbol_server",
          "fallback_export_symbols",
          "manual_review_required"
        ]
      }
    },
    "network_required": {
      "type": "boolean"
    },
    "timeout_posture": {
      "enum": [
        "none",
        "bounded_http_timeout",
        "backend_defined",
        "manual_review_required"
      ]
    },
    "cache_basis": {
      "enum": [
        "frozen_bundle",
        "local_cache",
        "system_state",
        "mixed",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
