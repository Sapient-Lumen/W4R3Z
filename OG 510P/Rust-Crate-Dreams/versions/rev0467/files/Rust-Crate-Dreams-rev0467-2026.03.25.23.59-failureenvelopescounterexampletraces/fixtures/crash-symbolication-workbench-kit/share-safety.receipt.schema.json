{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "share-safety.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "share_class",
    "memory_posture",
    "path_posture",
    "symbol_payload_posture"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "share_class": {
      "enum": [
        "safe_share_ready",
        "internal_only",
        "redacted_with_manual_review_zones",
        "manual_review_required"
      ]
    },
    "memory_posture": {
      "enum": [
        "not_included",
        "sanitized_stack_only",
        "raw_memory_present",
        "manual_review_required"
      ]
    },
    "path_posture": {
      "enum": [
        "redacted",
        "filename_only",
        "full_paths_present",
        "manual_review_required"
      ]
    },
    "symbol_payload_posture": {
      "enum": [
        "not_included",
        "included_breakpad_subset",
        "included_native_symbols",
        "external_reference_only",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
