{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capture-basis.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "capture_class",
    "writer_process",
    "origin",
    "sanitization_posture"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "capture_class": {
      "enum": [
        "in_process",
        "external_monitor",
        "imported_artifact",
        "synthetic_fixture",
        "manual_review_required"
      ]
    },
    "writer_process": {
      "enum": [
        "same_process",
        "external_monitor",
        "os_service",
        "test_harness",
        "unknown"
      ]
    },
    "origin": {
      "type": "string"
    },
    "sanitization_posture": {
      "enum": [
        "none",
        "stack_sanitized",
        "memory_blocks_redacted",
        "safe_share_profile",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
