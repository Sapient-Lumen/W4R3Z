{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crash-bundle.manifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_name",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "bundle_name": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
