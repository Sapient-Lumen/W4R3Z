{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "module-identity.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "module_name",
    "code_file",
    "identity_basis",
    "identifier_route"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "module_name": {
      "type": "string"
    },
    "code_file": {
      "type": "string"
    },
    "base_address": {
      "type": "string"
    },
    "module_size": {
      "type": "integer"
    },
    "identity_basis": {
      "enum": [
        "debug_id",
        "code_id",
        "build_id",
        "mixed",
        "manual_review_required"
      ]
    },
    "identifier_route": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "mixed",
        "low",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
