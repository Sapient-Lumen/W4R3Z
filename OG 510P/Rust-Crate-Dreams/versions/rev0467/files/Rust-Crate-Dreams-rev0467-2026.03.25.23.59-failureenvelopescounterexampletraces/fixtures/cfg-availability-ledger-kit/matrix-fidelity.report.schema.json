{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matrix Fidelity Report",
  "type": "object",
  "required": ["schema_version", "cells"],
  "properties": {
    "schema_version": {"type": "string"},
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_path", "slice", "fidelity"],
        "properties": {
          "item_path": {"type": "string"},
          "slice": {"type": "string"},
          "fidelity": {
            "enum": [
              "direct_observation",
              "docs_only_observation",
              "hosted_import",
              "rule_inference",
              "mixed",
              "manual_review_required"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": false
}
