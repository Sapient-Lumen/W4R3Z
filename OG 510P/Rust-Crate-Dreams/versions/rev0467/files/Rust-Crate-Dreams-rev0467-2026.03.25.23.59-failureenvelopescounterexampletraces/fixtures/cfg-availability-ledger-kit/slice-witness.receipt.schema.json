{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slice Witness Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "slice_id",
    "observation_kind"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "slice_id": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "selected_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "docs_profile": {
      "type": "string",
      "enum": [
        "normal",
        "cfg_doc",
        "docsrs",
        "manual_review_required"
      ]
    },
    "custom_cfgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observation_kind": {
      "enum": [
        "direct_rustdoc_json",
        "docs_only_rustdoc",
        "docsrs_hosted_import",
        "rule_inference",
        "manual_review_required"
      ]
    },
    "rustdoc_json_format_version": {
      "type": "integer"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
