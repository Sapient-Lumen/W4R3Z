{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/toolchain-target-support-contract-kit/artifact-route.receipt.schema.json",
  "title": "ArtifactRouteReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_kind",
          "producer_phase",
          "discovery_basis",
          "stability_posture"
        ],
        "properties": {
          "artifact_kind": {
            "type": "string"
          },
          "producer_phase": {
            "type": "string",
            "enum": [
              "cargo_build",
              "cargo_test",
              "cargo_doc",
              "docsrs",
              "ci_upload",
              "manual_review_required"
            ]
          },
          "discovery_basis": {
            "type": "string",
            "enum": [
              "cargo_json_messages",
              "cargo_metadata",
              "docsrs_metadata",
              "target_dir_convention",
              "build_dir_internal_layout",
              "ci_named_artifact",
              "manual_note",
              "manual_review_required"
            ]
          },
          "stability_posture": {
            "type": "string",
            "enum": [
              "stable_interface",
              "workspace_convention",
              "cargo_internal_layout",
              "hosted_service_behavior",
              "manual_review_required"
            ]
          },
          "host_target_relation": {
            "type": "string",
            "enum": [
              "host_artifact",
              "target_artifact",
              "docs_artifact",
              "mixed",
              "manual_review_required"
            ]
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
