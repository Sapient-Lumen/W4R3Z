{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toolchain & Target Support Class Policy",
  "type": "object",
  "required": ["schema_version", "support_classes"],
  "properties": {
    "schema_version": {"type": "string"},
    "support_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "minimum_evidence"],
        "properties": {
          "name": {"type": "string"},
          "minimum_evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
