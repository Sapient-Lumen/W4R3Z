{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toolchain & Target External Prerequisite Manifest",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"type": "string"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "kind", "required"],
        "properties": {
          "scope": {"type": "string"},
          "kind": {"type": "string"},
          "required": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
