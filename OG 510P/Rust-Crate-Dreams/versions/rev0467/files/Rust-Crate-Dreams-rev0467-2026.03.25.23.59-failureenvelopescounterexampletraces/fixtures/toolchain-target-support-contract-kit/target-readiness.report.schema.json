{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/toolchain-target-support-contract-kit/target-readiness.report.schema.json",
  "title": "TargetReadinessReport",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "target",
    "rust_project_target_tier",
    "project_support_class",
    "std_posture",
    "exercise_scope",
    "known_blockers",
    "required_external_prerequisites",
    "review_status"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "project": {"type": "string"},
    "target": {"type": "string"},
    "rust_project_target_tier": {
      "type": "string",
      "enum": ["tier1", "tier2_with_host_tools", "tier2", "tier3", "manual_review_required"]
    },
    "project_support_class": {
      "type": "string",
      "enum": [
        "fully_supported",
        "ci_verified",
        "docs_only",
        "compile_only",
        "manual_setup_required",
        "nightly_only",
        "unknown",
        "manual_review_required"
      ]
    },
    "std_posture": {
      "type": "string",
      "enum": ["std_available", "no_std_only", "mixed", "manual_review_required"]
    },
    "last_known_tested_environment": {
      "type": ["object", "null"],
      "properties": {
        "os_or_runtime": {"type": "string"},
        "board_or_device": {"type": ["string", "null"]},
        "date": {"type": "string"},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "known_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "summary"],
        "properties": {
          "class": {"type": "string"},
          "summary": {"type": "string"},
          "status": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "required_external_prerequisites": {
      "type": "array",
      "items": {"type": "string"}
    },
    "exercise_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["compile", "docs", "run", "test", "bench", "host_build_script", "host_proc_macro"]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "source"],
        "properties": {
          "kind": {"type": "string"},
          "source": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "review_status": {
      "type": "string",
      "enum": ["ready_for_experiment", "needs_platform_owner_review", "manual_review_required"]
    }
  },
  "additionalProperties": false
}
