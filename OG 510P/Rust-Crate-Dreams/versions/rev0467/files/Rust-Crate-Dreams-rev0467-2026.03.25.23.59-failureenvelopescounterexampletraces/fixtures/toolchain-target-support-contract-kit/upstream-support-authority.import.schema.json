{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/toolchain-target-support-contract-kit/upstream-support-authority.import.schema.json",
  "title": "UpstreamSupportAuthorityImport",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "imports",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "authority_kind",
          "source",
          "evidence_class",
          "supports_questions"
        ],
        "properties": {
          "authority_kind": {
            "type": "string",
            "enum": [
              "rust_project_target_tier",
              "rustup_supported_host",
              "docsrs_default_targets",
              "docsrs_metadata_rule",
              "cargo_path_rule",
              "cargo_build_layout_rule",
              "manual_note",
              "unknown"
            ]
          },
          "scope": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "imported_at": {
            "type": "string"
          },
          "evidence_class": {
            "type": "string",
            "enum": [
              "official_policy",
              "official_service_behavior",
              "official_tooling_fact",
              "translated_context",
              "manual_import"
            ]
          },
          "supports_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "does_not_prove": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mutable_without_project_release": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
