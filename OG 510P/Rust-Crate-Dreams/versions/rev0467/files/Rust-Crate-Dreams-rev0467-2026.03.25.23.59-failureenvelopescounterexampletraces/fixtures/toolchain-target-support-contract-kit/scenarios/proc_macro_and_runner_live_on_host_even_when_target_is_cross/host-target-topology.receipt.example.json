{
  "schema_version": "0.1.0",
  "lane": "linux-host-to-aarch64-linux-target",
  "host_triple": "x86_64-unknown-linux-gnu",
  "target_triple": "aarch64-unknown-linux-gnu",
  "phases": [
    {
      "phase": "resolve",
      "executor_lane": "host",
      "artifact_platform": "n_a",
      "runner_requirement": "none",
      "notes": "Cargo dependency resolution is host-side orchestration."
    },
    {
      "phase": "build_script_compile",
      "executor_lane": "host",
      "artifact_platform": "host",
      "runner_requirement": "host_shell",
      "notes": "build.rs compiles for the host toolchain."
    },
    {
      "phase": "build_script_run",
      "executor_lane": "host",
      "artifact_platform": "n_a",
      "runner_requirement": "host_shell",
      "notes": "Generated bindings/config are produced on the host."
    },
    {
      "phase": "proc_macro_compile",
      "executor_lane": "host",
      "artifact_platform": "host",
      "runner_requirement": "host_shell",
      "notes": "Proc macros are host artifacts."
    },
    {
      "phase": "proc_macro_run",
      "executor_lane": "host",
      "artifact_platform": "n_a",
      "runner_requirement": "host_shell",
      "notes": "Macro expansion occurs on the host compiler."
    },
    {
      "phase": "target_compile",
      "executor_lane": "host",
      "artifact_platform": "target",
      "runner_requirement": "none",
      "notes": "Cross-compilation emits AArch64 objects."
    },
    {
      "phase": "target_link",
      "executor_lane": "host",
      "artifact_platform": "target",
      "runner_requirement": "none",
      "notes": "Requires external cross linker / sysroot."
    },
    {
      "phase": "target_test",
      "executor_lane": "runner_device",
      "artifact_platform": "target",
      "runner_requirement": "custom_runner",
      "notes": "Test execution requires qemu-aarch64 or device-lab runner."
    },
    {
      "phase": "ci_upload",
      "executor_lane": "ci_service",
      "artifact_platform": "target",
      "runner_requirement": "none",
      "notes": "CI uploads test logs separately from the built artifact."
    }
  ],
  "notes": "Host helper success must not be flattened into full target-runtime support."
}
