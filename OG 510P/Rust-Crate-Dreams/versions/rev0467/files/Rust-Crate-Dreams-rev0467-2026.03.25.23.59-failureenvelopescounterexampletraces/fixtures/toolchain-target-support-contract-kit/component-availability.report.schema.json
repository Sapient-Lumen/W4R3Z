{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Component Availability Report",
  "type": "object",
  "required": [
    "schema_version",
    "requested_toolchain",
    "effective_toolchain",
    "components"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "requested_toolchain": {"type": "string"},
    "effective_toolchain": {"type": "string"},
    "requested_profile": {"type": "string"},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string"},
          "status": {
            "type": "string",
            "enum": [
              "installed",
              "unavailable_on_requested_toolchain",
              "triggered_effective_toolchain_fallback",
              "not_requested",
              "manual_review_required"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "profile",
              "explicit_component_request",
              "previously_installed",
              "manual_review_required"
            ]
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
