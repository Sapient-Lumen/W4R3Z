{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exercise Scope Report",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "scopes"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "lane": {"type": "string"},
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "support_class"],
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "compile",
              "docs",
              "run",
              "test",
              "bench",
              "host_build_script",
              "host_proc_macro",
              "manual_review_required"
            ]
          },
          "support_class": {
            "type": "string",
            "enum": [
              "supported",
              "manual_setup_required",
              "compile_only",
              "not_exercised",
              "manual_review_required"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
