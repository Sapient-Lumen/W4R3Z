{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Support Drift Diff",
  "type": "object",
  "required": ["schema_version", "changes"],
  "properties": {
    "schema_version": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "kind"],
        "properties": {
          "subject": {"type": "string"},
          "kind": {"type": "string", "enum": ["widened", "tightened", "clarified", "ambiguous"]},
          "summary": {"type": "string"}
        }
      }
    }
  }
}
