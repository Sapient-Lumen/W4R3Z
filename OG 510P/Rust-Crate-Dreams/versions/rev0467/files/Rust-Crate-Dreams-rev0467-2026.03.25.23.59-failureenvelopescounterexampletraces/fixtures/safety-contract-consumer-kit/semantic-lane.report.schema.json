{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/safety-contract-consumer/semantic-lane.report.schema.json",
  "title": "safety contract semantic lane report",
  "type": "object",
  "required": ["schema_version", "subject", "lanes"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["consumer_id", "lane_kind", "claim_class", "scope"],
        "properties": {
          "consumer_id": {"type": "string"},
          "lane_kind": {"type": "string"},
          "claim_class": {"type": "string"},
          "scope": {"type": "string"},
          "boundedness_notes": {
            "type": "array",
            "items": {"type": "string"}
          },
          "soundness_caveats": {
            "type": "array",
            "items": {"type": "string"}
          },
          "bridge_notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
