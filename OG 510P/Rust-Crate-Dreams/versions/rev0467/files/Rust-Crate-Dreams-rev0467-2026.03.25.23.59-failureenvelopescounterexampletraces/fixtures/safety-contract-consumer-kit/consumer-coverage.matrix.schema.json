{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/safety-contract-consumer/consumer-coverage.matrix.schema.json",
  "title": "safety contract consumer coverage matrix",
  "type": "object",
  "required": ["schema_version", "subject", "consumers"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["consumer_id", "semantic_lane", "coverage"],
        "properties": {
          "consumer_id": {"type": "string"},
          "semantic_lane": {"type": "string"},
          "coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["clause_id", "status", "import_route"],
              "properties": {
                "clause_id": {"type": "string"},
                "status": {"type": "string"},
                "import_route": {"type": "string"},
                "notes": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
