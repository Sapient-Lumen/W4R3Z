{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local-first Repo Manifest",
  "type": "object",
  "required": ["schema_version", "repo_id", "profile_id", "engine", "store", "transport"],
  "properties": {
    "schema_version": {"type": "string"},
    "repo_id": {"type": "string"},
    "profile_id": {"type": "string"},
    "document_family": {"type": "string"},
    "engine": {
      "type": "object",
      "required": ["family", "version"],
      "properties": {
        "family": {"type": "string"},
        "version": {"type": "string"},
        "sync_assumption": {"type": "string"}
      }
    },
    "store": {
      "type": "object",
      "required": ["family"],
      "properties": {
        "family": {"type": "string"},
        "snapshot_mode": {"type": "string"},
        "compaction_policy": {"type": "string"}
      }
    },
    "transport": {
      "type": "object",
      "required": ["family", "bootstrap_method"],
      "properties": {
        "family": {"type": "string"},
        "protocol_id": {"type": "string"},
        "bootstrap_method": {"type": "string"},
        "relay_policy": {"type": "string"}
      }
    },
    "membership": {
      "type": "object",
      "properties": {
        "mode": {"type": "string"},
        "epoch_required": {"type": "boolean"}
      }
    },
    "redaction_mode": {"type": "string"}
  }
}
