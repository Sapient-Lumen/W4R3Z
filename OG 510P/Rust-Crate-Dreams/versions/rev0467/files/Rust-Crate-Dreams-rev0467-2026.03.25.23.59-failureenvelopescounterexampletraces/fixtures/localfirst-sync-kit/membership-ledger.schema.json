{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Membership Ledger",
  "type": "object",
  "required": ["schema_version", "group_id", "current_epoch", "events"],
  "properties": {
    "schema_version": {"type": "string"},
    "group_id": {"type": "string"},
    "current_epoch": {"type": "integer"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "kind", "epoch"],
        "properties": {
          "event_id": {"type": "string"},
          "kind": {"type": "string", "enum": ["add_device", "remove_device", "self_update", "key_rotation", "role_change", "manual_review"]},
          "epoch": {"type": "integer"},
          "subject_id": {"type": "string"},
          "actor_id": {"type": "string"},
          "reason": {"type": "string"},
          "visibility": {"type": "string"}
        }
      }
    },
    "redaction_notes": {"type": "array", "items": {"type": "string"}}
  }
}
