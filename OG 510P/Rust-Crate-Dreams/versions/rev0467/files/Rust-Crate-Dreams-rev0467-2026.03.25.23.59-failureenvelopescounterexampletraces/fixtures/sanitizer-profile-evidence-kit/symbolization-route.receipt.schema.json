{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/sanitizer-profile-evidence-kit/symbolization-route.receipt.schema.json",
  "title": "Symbolization Route Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "symbolizer_presence",
    "route_class",
    "handoff_quality",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "symbolizer_presence": {
      "type": "string",
      "enum": ["present_in_path", "present_out_of_band", "missing", "unknown"]
    },
    "route_class": {
      "type": "string",
      "enum": ["fully_symbolized", "partially_symbolized", "raw_pc_only", "unknown"]
    },
    "handoff_quality": {
      "type": "string",
      "enum": ["portable", "local_only", "partial", "poor"]
    },
    "manual_review_required": { "type": "boolean" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
