{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/sanitizer-profile-evidence-kit/suppression-policy.receipt.schema.json",
  "title": "Suppression Policy Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "active",
    "policy_class",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "active": { "type": "boolean" },
    "policy_class": {
      "type": "string",
      "enum": [
        "no_suppressions",
        "owned_temporary_suppressions",
        "third_party_imported_suppressions",
        "stale_or_unowned_suppressions",
        "unknown"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern", "reason", "owner", "review_date"],
        "properties": {
          "pattern": { "type": "string" },
          "reason": { "type": "string" },
          "owner": { "type": "string" },
          "review_date": { "type": "string" }
        }
      }
    },
    "manual_review_required": { "type": "boolean" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
