{
  "schema_version": "0.1.0",
  "sanitizer": "memory",
  "target_triple": "x86_64-unknown-linux-gnu",
  "workspace_targets": {
    "instrumented": true,
    "notes": [
      "root crate compiled with -Zsanitizer=memory"
    ]
  },
  "dependencies": {
    "coverage_class": "partial",
    "notes": [
      "transitive dependencies built without full instrumentation receipts"
    ]
  },
  "std_instrumentation": {
    "status": "not_instrumented",
    "requiredness": "required"
  },
  "host_helpers": {
    "build_scripts": "excluded",
    "proc_macros": "excluded"
  },
  "evidence_strength": "manual_review_required",
  "manual_review_required": true,
  "notes": [
    "MemorySanitizer requires fully instrumented program code to avoid false positives"
  ]
}
