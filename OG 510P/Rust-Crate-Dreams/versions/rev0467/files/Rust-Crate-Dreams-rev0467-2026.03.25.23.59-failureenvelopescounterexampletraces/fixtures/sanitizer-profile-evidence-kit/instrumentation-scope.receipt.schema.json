{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/sanitizer-profile-evidence-kit/instrumentation-scope.receipt.schema.json",
  "title": "Instrumentation Scope Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "sanitizer",
    "target_triple",
    "workspace_targets",
    "dependencies",
    "std_instrumentation",
    "host_helpers",
    "evidence_strength",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "sanitizer": { "type": "string" },
    "target_triple": { "type": "string" },
    "workspace_targets": {
      "type": "object",
      "required": ["instrumented", "notes"],
      "properties": {
        "instrumented": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dependencies": {
      "type": "object",
      "required": ["coverage_class", "notes"],
      "properties": {
        "coverage_class": {
          "type": "string",
          "enum": ["full", "partial", "minimal", "unknown"]
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "std_instrumentation": {
      "type": "object",
      "required": ["status", "requiredness"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["instrumented", "not_instrumented", "unknown"]
        },
        "requiredness": {
          "type": "string",
          "enum": ["required", "recommended", "not_required", "unknown"]
        }
      }
    },
    "host_helpers": {
      "type": "object",
      "required": ["build_scripts", "proc_macros"],
      "properties": {
        "build_scripts": { "type": "string", "enum": ["excluded", "instrumented", "unknown"] },
        "proc_macros": { "type": "string", "enum": ["excluded", "instrumented", "unknown"] }
      }
    },
    "evidence_strength": {
      "type": "string",
      "enum": ["strong", "advisory", "weak", "manual_review_required"]
    },
    "manual_review_required": { "type": "boolean" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
