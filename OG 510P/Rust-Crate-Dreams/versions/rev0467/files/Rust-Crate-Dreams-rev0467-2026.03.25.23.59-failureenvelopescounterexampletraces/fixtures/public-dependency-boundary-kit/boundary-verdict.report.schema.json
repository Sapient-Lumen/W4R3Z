{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "boundary-verdict.report",
  "type": "object",
  "required": [
    "crate",
    "verdicts"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dependency",
          "verdict"
        ],
        "properties": {
          "dependency": {
            "type": "string"
          },
          "verdict": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
