{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/public-dependency-boundary/public-surface.snapshot.schema.json",
  "title": "Public surface snapshot",
  "type": "object",
  "required": ["schema_version", "crate", "items"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "dependency", "reason"],
        "properties": {
          "path": {"type": "string"},
          "dependency": {"type": "string"},
          "reason": {"type": "string", "enum": ["explicit_reexport", "public_type_reference", "trait_bound", "macro_export", "prelude"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
