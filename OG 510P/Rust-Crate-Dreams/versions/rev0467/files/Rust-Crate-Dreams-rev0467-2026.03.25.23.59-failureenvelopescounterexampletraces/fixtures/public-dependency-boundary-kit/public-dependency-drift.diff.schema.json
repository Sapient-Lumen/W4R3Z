{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "public-dependency-drift.diff",
  "type": "object",
  "required": [
    "from",
    "to",
    "changes"
  ],
  "properties": {
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class",
          "dependency"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "dependency": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
