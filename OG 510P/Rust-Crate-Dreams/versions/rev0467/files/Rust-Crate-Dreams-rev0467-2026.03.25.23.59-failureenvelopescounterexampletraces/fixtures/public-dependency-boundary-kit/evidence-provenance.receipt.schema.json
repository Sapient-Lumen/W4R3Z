{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence-provenance.receipt",
  "type": "object",
  "required": [
    "crate",
    "sources"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "role"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "exactness": {
            "type": "string"
          }
        }
      }
    },
    "scope_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
