{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/fixtures/determinism-sim-kit/backend-capability.receipt.schema.json",
  "title": "backend-capability.receipt",
  "type": "object",
  "required": ["backend", "controlled_lanes", "unsupported_surfaces", "comparability_class"],
  "properties": {
    "backend": {"type": "string"},
    "controlled_lanes": {
      "type": "array",
      "items": {"type": "string", "enum": ["scheduler", "time", "randomness", "faults", "network", "filesystem", "external_io"]}
    },
    "unsupported_surfaces": {"type": "array", "items": {"type": "string"}},
    "required_code_shape": {"type": "array", "items": {"type": "string"}},
    "comparability_class": {"type": "string", "enum": ["same-backend-only", "profile-compatible", "manual-review-required"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
