{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/fixtures/determinism-sim-kit/sim-profile.schema.json",
  "title": "sim-profile",
  "type": "object",
  "required": ["profile_id", "subject", "backend", "lanes", "replay_strictness"],
  "properties": {
    "profile_id": {"type": "string"},
    "subject": {"type": "string"},
    "backend": {"type": "string", "enum": ["tokio-paused", "turmoil", "madsim", "shuttle", "loom", "custom"]},
    "lanes": {
      "type": "object",
      "required": ["scheduler", "time", "randomness", "faults", "external_io"],
      "properties": {
        "scheduler": {"type": "string"},
        "time": {"type": "string"},
        "randomness": {"type": "string"},
        "faults": {"type": "string"},
        "external_io": {"type": "string"}
      },
      "additionalProperties": false
    },
    "replay_strictness": {"type": "string", "enum": ["exact", "backend-equivalent", "manual-review-only"]},
    "redaction_policy": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
