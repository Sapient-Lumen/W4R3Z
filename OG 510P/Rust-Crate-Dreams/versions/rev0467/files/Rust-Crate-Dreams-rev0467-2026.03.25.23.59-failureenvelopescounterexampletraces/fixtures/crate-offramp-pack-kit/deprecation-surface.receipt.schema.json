{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeprecationSurfaceReceipt",
  "type": "object",
  "required": [
    "crate",
    "observed"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "observed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "kind"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "deprecated_attr",
              "docs_note",
              "advisory",
              "yank",
              "feature_deprecation",
              "maintainer_note"
            ]
          }
        }
      }
    }
  }
}
