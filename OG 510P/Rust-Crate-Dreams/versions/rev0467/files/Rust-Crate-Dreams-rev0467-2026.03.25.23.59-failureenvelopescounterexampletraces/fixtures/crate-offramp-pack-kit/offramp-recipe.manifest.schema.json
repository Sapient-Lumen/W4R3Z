{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OffRampRecipeManifest",
  "type": "object",
  "required": [
    "recipes"
  ],
  "properties": {
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "before",
          "after"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "status": {
            "enum": [
              "checked",
              "manual_review_required"
            ]
          }
        }
      }
    }
  }
}
