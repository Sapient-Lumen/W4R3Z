{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuccessorMapReport",
  "type": "object",
  "required": [
    "crate",
    "mappings"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "relation"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "drop_in",
              "adapter_needed",
              "partial_replacement",
              "security_only_stopgap",
              "no_successor"
            ]
          }
        }
      }
    }
  }
}
