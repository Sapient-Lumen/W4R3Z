{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuccessorCompatReport",
  "type": "object",
  "required": [
    "crate",
    "results"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "successor",
          "classification"
        ],
        "properties": {
          "successor": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "drop_in",
              "adapter_needed",
              "behavior_review_required",
              "security_only_stopgap",
              "unsupported_exit_lane"
            ]
          }
        }
      }
    }
  }
}
