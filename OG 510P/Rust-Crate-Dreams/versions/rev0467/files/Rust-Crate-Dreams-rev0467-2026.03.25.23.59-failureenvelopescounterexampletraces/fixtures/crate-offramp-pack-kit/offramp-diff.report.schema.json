{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OffRampDiffReport",
  "type": "object",
  "required": [
    "from",
    "to",
    "changes"
  ],
  "properties": {
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "successor_changed",
              "sunset_phase_changed",
              "recipe_changed",
              "replacement_regressed",
              "replacement_improved",
              "manual_review_boundary_changed"
            ]
          }
        }
      }
    }
  }
}
