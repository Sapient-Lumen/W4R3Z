{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StopgapHorizonReport",
  "type": "object",
  "required": ["crate", "entries"],
  "properties": {
    "crate": {"type": "string"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "stopgap_class", "horizon_verdict"],
        "properties": {
          "subject": {"type": "string"},
          "stopgap_class": {
            "enum": [
              "temporary_shim_window",
              "last_safe_pin",
              "migrate_now",
              "successor_maturity_pending"
            ]
          },
          "recommended_until": {"type": "string"},
          "review_due": {"type": "string"},
          "successor_target": {"type": "string"},
          "horizon_verdict": {
            "enum": [
              "deadline_known",
              "deadline_unknown",
              "review_due",
              "expired",
              "manual_review_required"
            ]
          }
        }
      }
    }
  }
}
