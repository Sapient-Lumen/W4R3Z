{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioRecipeManifest",
  "type": "object",
  "required": ["crate", "recipes"],
  "properties": {
    "crate": {"type": "string"},
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "dependency_snippet", "commands"],
        "properties": {
          "name": {"type": "string"},
          "dependency_snippet": {"type": "string"},
          "commands": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}