{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioDiffReport",
  "type": "object",
  "required": ["from", "to", "changes"],
  "properties": {
    "from": {"type": "string"},
    "to": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "subject"],
        "properties": {
          "kind": {"enum": ["scenario_added", "scenario_removed", "default_changed", "feature_bundle_changed", "env_contract_changed", "required_features_changed", "manual_review_boundary_changed"]},
          "subject": {"type": "string"}
        }
      }
    }
  }
}