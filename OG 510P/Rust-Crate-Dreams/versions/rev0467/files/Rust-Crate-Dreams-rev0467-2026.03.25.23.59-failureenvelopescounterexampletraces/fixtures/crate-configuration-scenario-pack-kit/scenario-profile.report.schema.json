{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioProfileReport",
  "type": "object",
  "required": ["crate", "profiles"],
  "properties": {
    "crate": {"type": "string"},
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "feature_bundle"],
        "properties": {
          "name": {"type": "string"},
          "feature_bundle": {"type": "array", "items": {"type": "string"}},
          "env_bundle": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}