{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfigOriginReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "scenario",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_kind",
          "origin"
        ],
        "properties": {
          "fact_kind": {
            "enum": [
              "feature_bundle",
              "required_features_target",
              "docsrs_metadata",
              "target_assumption",
              "runtime_or_backend_choice",
              "environment_variable",
              "recipe_command",
              "manual_review_boundary"
            ]
          },
          "origin": {
            "enum": [
              "manifest_import",
              "docsrs_metadata_import",
              "observed_build",
              "observed_test",
              "observed_doc_build",
              "maintainer_declared",
              "external_doc_reference",
              "manual_review_required"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": "string"
          },
          "observed_with": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
