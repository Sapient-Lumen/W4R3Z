{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Python Wheel ABI target report",
  "type": "object",
  "required": [
    "target_class",
    "status"
  ],
  "properties": {
    "target_class": {
      "type": "string",
      "enum": [
        "version_specific",
        "abi3",
        "split_free_threaded",
        "abi3t_horizon",
        "manual_review_required"
      ]
    },
    "non_free_threaded_strategy": {
      "type": ["string", "null"],
      "enum": [
        "version_specific",
        "abi3",
        "abi3t",
        null
      ]
    },
    "free_threaded_strategy": {
      "type": ["string", "null"],
      "enum": [
        "version_specific_t_wheels",
        "abi3t",
        "abi3_abi3t_combined",
        "not_supported",
        null
      ]
    },
    "built_tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "failed", "manual_review_required"]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
