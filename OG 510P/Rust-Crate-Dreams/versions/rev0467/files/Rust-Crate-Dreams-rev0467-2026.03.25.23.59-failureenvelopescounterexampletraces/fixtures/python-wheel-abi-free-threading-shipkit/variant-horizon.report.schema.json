{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Python Wheel variant horizon report",
  "type": "object",
  "required": [
    "current_scope",
    "status"
  ],
  "properties": {
    "current_scope": {
      "type": "string",
      "enum": [
        "classic_wheel_tags_only",
        "classic_plus_abi3t_planned",
        "variant_aware",
        "manual_review_required"
      ]
    },
    "abi3t_posture": {
      "type": "string",
      "enum": [
        "out_of_scope",
        "planned_when_tooling_ready",
        "implemented",
        "manual_review_required"
      ]
    },
    "wheel_variant_posture": {
      "type": "string",
      "enum": [
        "out_of_scope",
        "monitoring",
        "planned",
        "implemented",
        "manual_review_required"
      ]
    },
    "blocking_facts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "failed", "manual_review_required"]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
