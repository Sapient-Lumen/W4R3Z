{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-compile-time-deps-workflow-kit/root-lane.receipt.schema.json",
  "title": "RootLaneReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "target_dir_lane",
    "build_dir_lane",
    "exactness"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "target_dir_lane": {
      "type": "object",
      "required": [
        "configured_mode",
        "sharing"
      ],
      "properties": {
        "configured_mode": {
          "type": "string",
          "enum": [
            "workspace_default",
            "rust_analyzer_subdir",
            "explicit_path",
            "env_override",
            "unknown"
          ]
        },
        "sharing": {
          "type": "string",
          "enum": [
            "shared_with_terminal",
            "isolated_for_tool",
            "mixed",
            "unknown"
          ]
        },
        "duplication_tradeoff": {
          "type": "string",
          "enum": [
            "none",
            "duplicate_artifacts",
            "unknown"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "build_dir_lane": {
      "type": "object",
      "required": [
        "configured_mode",
        "sharing"
      ],
      "properties": {
        "configured_mode": {
          "type": "string",
          "enum": [
            "workspace_default",
            "explicit_path",
            "env_override",
            "unknown"
          ]
        },
        "sharing": {
          "type": "string",
          "enum": [
            "shared_with_terminal",
            "isolated_for_tool",
            "mixed",
            "unknown"
          ]
        },
        "layout_compatibility": {
          "type": "string",
          "enum": [
            "legacy_only",
            "supports_separate_build_dir",
            "supports_new_layout",
            "manual_review_required",
            "unknown"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "final_artifact_root_relation": {
      "type": "string",
      "enum": [
        "target_dir",
        "outside_scope",
        "manual_review_required",
        "unknown"
      ]
    },
    "exactness": {
      "type": "string",
      "enum": [
        "exact",
        "conservative",
        "manual_review_required"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
