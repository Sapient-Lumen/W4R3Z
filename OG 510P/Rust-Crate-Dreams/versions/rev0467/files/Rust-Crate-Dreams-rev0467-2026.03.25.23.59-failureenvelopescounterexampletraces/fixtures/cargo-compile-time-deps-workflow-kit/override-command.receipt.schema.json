{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-compile-time-deps-workflow-kit/override-command.receipt.schema.json",
  "title": "OverrideCommandReceipt",
  "type": "object",
  "required": ["schema_version", "command_roles"],
  "properties": {
    "schema_version": {"type": "string"},
    "command_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "command_origin", "argv", "emits_json", "pairing_status", "command_path_mode"],
        "properties": {
          "role": {"type": "string", "enum": ["check", "build_scripts", "proc_macro_discovery", "manual_wrapper", "unknown"]},
          "command_origin": {"type": "string", "enum": ["rust_analyzer_default", "rust_analyzer_override", "workspace_config", "editor_config", "manual"]},
          "argv": {"type": "array", "items": {"type": "string"}},
          "emits_json": {"type": "boolean"},
          "placeholder_usage": {
            "type": "array",
            "items": {"type": "string", "enum": ["label", "saved_file", "none", "other"]}
          },
          "pairing_status": {"type": "string", "enum": ["paired_with_build_scripts", "check_only_override", "buildscripts_only_override", "none", "manual_review_required"]},
          "command_path_mode": {"type": "string", "enum": ["plain_name", "absolute_path", "relative_path", "wrapper_entrypoint", "manual_review_required"]},
          "wrapper_mode": {"type": "string", "enum": ["none", "rust_analyzer_wrapper", "rustc_wrapper", "custom_wrapper", "unknown"]},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
