{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-compile-time-deps-workflow-kit/selection-coverage.report.schema.json",
  "title": "SelectionCoverageReport",
  "type": "object",
  "required": ["schema_version", "package_scope", "target_class_coverage", "exactness"],
  "properties": {
    "schema_version": {"type": "string"},
    "package_scope": {
      "type": "object",
      "required": ["configured", "observed", "exactness"],
      "properties": {
        "configured": {"type": "string", "enum": ["workspace", "package", "label_scoped", "saved_file_scoped", "unknown"]},
        "observed": {"type": "string", "enum": ["workspace", "package", "label_scoped", "saved_file_scoped", "mixed", "unknown"]},
        "exactness": {"type": "string", "enum": ["exact", "conservative", "manual_review_required"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "target_class_coverage": {
      "type": "object",
      "required": ["all_targets_enabled", "included_classes"],
      "properties": {
        "all_targets_enabled": {"type": "boolean"},
        "included_classes": {"type": "array", "items": {"type": "string", "enum": ["lib", "bins", "tests", "benches", "examples", "build_scripts", "proc_macros"]}},
        "omitted_classes": {"type": "array", "items": {"type": "string", "enum": ["lib", "bins", "tests", "benches", "examples", "build_scripts", "proc_macros", "dev_dependency_lanes"]}},
        "dev_dependency_visibility": {"type": "string", "enum": ["fully_visible", "partially_visible", "not_visible", "unknown"]}
      },
      "additionalProperties": false
    },
    "proc_macro_availability": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["available", "missing_due_to_selection", "missing_other", "unknown"]},
        "affected_packages": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "exactness": {"type": "string", "enum": ["exact", "conservative", "manual_review_required"]},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
