{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-compile-time-deps-workflow-kit/tool-session.link.schema.json",
  "title": "ToolSessionLink",
  "type": "object",
  "required": [
    "schema_version",
    "link_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "link_status": {
      "type": "string",
      "enum": [
        "linked",
        "candidate_only",
        "not_available",
        "manual_review_required"
      ]
    },
    "session_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comparison_scope": {
      "type": "string",
      "enum": [
        "same_run",
        "same_workspace_recent",
        "unknown"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
