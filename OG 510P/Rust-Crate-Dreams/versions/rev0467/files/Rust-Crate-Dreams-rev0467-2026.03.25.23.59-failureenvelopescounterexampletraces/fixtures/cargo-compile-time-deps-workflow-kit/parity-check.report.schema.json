{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-compile-time-deps-workflow-kit/parity-check.report.schema.json",
  "title": "Cargo tool parity report",
  "type": "object",
  "required": ["schema_version", "verdict", "evidence"],
  "properties": {
    "schema_version": {"type": "string"},
    "verdict": {
      "type": "string",
      "enum": ["acceptable_tool_surface", "missing_runtime_surface", "target_mismatch", "sysroot_source_missing", "build_script_cfg_risk", "full_build_required", "manual_review_required"]
    },
    "risk_level": {"type": "string", "enum": ["low", "medium", "high"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "summary"],
        "properties": {
          "kind": {"type": "string", "enum": ["observed_fact", "conservative_inference", "policy_rule"]},
          "summary": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
