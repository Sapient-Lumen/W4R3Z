{
  "schema_version": "0.1",
  "command_roles": [
    {
      "role": "check",
      "command_origin": "rust_analyzer_override",
      "argv": ["./miri", "check", "--message-format=json"],
      "emits_json": true,
      "placeholder_usage": ["none"],
      "pairing_status": "manual_review_required",
      "command_path_mode": "relative_path",
      "wrapper_mode": "custom_wrapper",
      "notes": ["Relative entrypoints are more support-fragile than plain cargo invocations and should stay visible in the receipt."]
    }
  ]
}
