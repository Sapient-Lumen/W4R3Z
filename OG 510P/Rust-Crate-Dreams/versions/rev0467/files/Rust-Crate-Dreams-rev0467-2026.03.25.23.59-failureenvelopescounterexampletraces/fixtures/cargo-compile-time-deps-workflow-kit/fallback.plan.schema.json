{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-compile-time-deps-workflow-kit/fallback.plan.schema.json",
  "title": "Cargo tool fallback plan",
  "type": "object",
  "required": ["schema_version", "recommended_actions"],
  "properties": {
    "schema_version": {"type": "string"},
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["run_full_build", "align_target_dir_policy", "install_rust_src", "pin_override_command", "align_targets", "narrow_workspace_scope", "accept_tool_only_mode", "manual_review"]
      }
    },
    "rationale": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
