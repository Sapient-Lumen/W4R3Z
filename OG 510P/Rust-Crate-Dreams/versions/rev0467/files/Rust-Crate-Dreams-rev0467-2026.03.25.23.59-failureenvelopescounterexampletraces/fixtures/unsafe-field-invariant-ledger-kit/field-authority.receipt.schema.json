{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/unsafe-field-invariant-ledger-kit/field-authority.receipt.schema.json",
  "title": "Field Authority Receipt",
  "type": "object",
  "required": ["schema_version", "crate", "type_path", "field_path", "authority_source", "invariant_class", "invariant_summary", "owner", "confidence"],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "type_path": {"type": "string"},
    "field_path": {"type": "string"},
    "authority_source": {"enum": ["doc_comment", "manual_manifest", "contract_import", "unsafe_field_syntax", "review_note", "unknown"]},
    "invariant_class": {"enum": ["length", "initialization", "discriminant", "aliasing", "layout", "state_machine", "other"]},
    "invariant_summary": {"type": "string"},
    "owner": {"type": "string"},
    "confidence": {"enum": ["high", "medium", "low", "manual_review_required"]},
    "unresolved_notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
