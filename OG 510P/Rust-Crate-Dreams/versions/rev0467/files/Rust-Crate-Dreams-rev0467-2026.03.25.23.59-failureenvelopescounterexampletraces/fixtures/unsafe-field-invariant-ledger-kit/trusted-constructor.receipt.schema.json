{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/unsafe-field-invariant-ledger-kit/trusted-constructor.receipt.schema.json",
  "title": "Trusted Constructor Receipt",
  "type": "object",
  "required": ["schema_version", "field_path", "constructor", "completeness", "validation_steps", "postconditions"],
  "properties": {
    "schema_version": {"type": "string"},
    "field_path": {"type": "string"},
    "constructor": {"type": "string"},
    "completeness": {"enum": ["fully_establishes", "partially_establishes", "manual_review_required"]},
    "validation_steps": {"type": "array", "items": {"type": "string"}},
    "postconditions": {"type": "array", "items": {"type": "string"}},
    "linked_witness_ids": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
