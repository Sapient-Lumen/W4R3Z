{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/unsafe-field-invariant-ledger-kit/invariant-witness.report.schema.json",
  "title": "Invariant Witness Report",
  "type": "object",
  "required": ["schema_version", "field_path", "witnesses"],
  "properties": {
    "schema_version": {"type": "string"},
    "field_path": {"type": "string"},
    "witnesses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "scope", "verdict", "evidence_strength", "non_claims"],
        "properties": {
          "kind": {"enum": ["tests", "miri", "loom", "contracts", "fuzz", "manual_review", "other"]},
          "scope": {"type": "string"},
          "verdict": {"enum": ["passed", "failed", "partial", "not_run"]},
          "evidence_strength": {"enum": ["strong_for_claimed_scope", "advisory", "weak", "manual_review_required"]},
          "non_claims": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
