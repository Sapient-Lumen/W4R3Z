{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "open-table-format-kit table-surface receipt",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "subject",
    "format_family",
    "identity_route",
    "freshness_mode",
    "provider_surface",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "scenario": {"type": "string"},
    "subject": {"type": "string"},
    "format_family": {
      "enum": ["iceberg", "delta", "hudi", "manual_review_required"]
    },
    "identity_route": {
      "enum": [
        "catalog_identifier",
        "metadata_location",
        "table_base_uri",
        "warehouse_relative",
        "manual_review_required"
      ]
    },
    "freshness_mode": {
      "enum": [
        "catalog_live_refresh",
        "static_snapshot_pin",
        "time_travel_pin",
        "incremental_window",
        "mutable_latest",
        "manual_review_required"
      ]
    },
    "provider_surface": {
      "enum": [
        "native_table_api",
        "datafusion_table_provider",
        "ffi_table_provider",
        "python_binding_wrapper",
        "manual_review_required"
      ]
    },
    "storage_schemes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
