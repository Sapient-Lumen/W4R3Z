{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-workspace-boundary-doctor/invocation-mode.report.schema.json",
  "title": "Cargo invocation mode report",
  "type": "object",
  "required": [
    "schema_version",
    "invocation_mode",
    "subject_kind",
    "config_root_basis",
    "workspace_autodiscovery"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "invocation_mode": {
      "type": "string",
      "enum": [
        "cwd_auto_discovery",
        "manifest_path",
        "manifest_command",
        "single_file_manifest_path",
        "single_file_manifest_command"
      ]
    },
    "subject_kind": { "type": "string", "enum": ["cargo_toml", "single_file_package"] },
    "config_root_basis": { "type": "string", "enum": ["cwd", "subject_path", "mixed", "manual_review_required"] },
    "workspace_autodiscovery": { "type": "string", "enum": ["enabled", "disabled", "manual_review_required"] },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
