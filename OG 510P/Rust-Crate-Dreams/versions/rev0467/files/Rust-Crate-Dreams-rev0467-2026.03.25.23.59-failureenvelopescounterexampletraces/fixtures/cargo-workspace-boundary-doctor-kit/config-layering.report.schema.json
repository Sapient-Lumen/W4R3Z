{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-workspace-boundary-doctor/config-layering.report.schema.json",
  "title": "Cargo config layering report",
  "type": "object",
  "required": [
    "schema_version",
    "layers"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "route", "precedence", "path_basis"],
        "properties": {
          "source": { "type": "string" },
          "route": { "type": "string", "enum": ["config_file", "config_include", "env", "cli_key_value", "cli_config_file"] },
          "precedence": { "type": "integer" },
          "path_basis": { "type": "string", "enum": ["cwd", "config_parent", "cargo_home", "literal", "manual_review_required"] },
          "includes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
