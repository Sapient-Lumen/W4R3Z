{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-workspace-boundary-doctor/boundary-diagnosis.report.schema.json",
  "title": "Cargo boundary diagnosis report",
  "type": "object",
  "required": [
    "schema_version",
    "diagnoses"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "diagnoses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "diagnosis",
          "confidence"
        ],
        "properties": {
          "diagnosis": {
            "type": "string",
            "enum": [
              "parent_manifest_poisoning",
              "cwd_config_split",
              "auto_member_surprise",
              "package_workspace_optout_candidate",
              "project_specific_config_missing_manifest_home",
              "manual_review_required"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "observed_fact",
              "conservative_inference",
              "manual_review_required"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
