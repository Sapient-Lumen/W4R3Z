{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-workspace-boundary-doctor/boundary-context.schema.json",
  "title": "Cargo boundary context",
  "type": "object",
  "required": [
    "schema_version",
    "cwd"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "manifest_path": {
      "type": "string"
    },
    "expected_workspace_mode": {
      "type": "string",
      "enum": [
        "standalone_package",
        "workspace_member",
        "workspace_root",
        "unknown"
      ]
    },
    "local_config_expected": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
