{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rust-conformance-harness-toolkit/comparison.report.schema.json",
  "title": "Conformance Comparison Report",
  "type": "object",
  "required": ["case_id", "finding"],
  "properties": {
    "case_id": {"type": "string"},
    "finding": {
      "type": "string",
      "enum": ["same-pass", "same-fail", "verdict-divergence", "output-divergence", "environment-mismatch", "manual-review-required"]
    },
    "left_result_ref": {"type": "string"},
    "right_result_ref": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
