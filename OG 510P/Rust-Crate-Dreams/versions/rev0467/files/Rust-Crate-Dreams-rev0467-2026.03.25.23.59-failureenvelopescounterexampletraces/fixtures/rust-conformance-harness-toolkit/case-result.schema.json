{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rust-conformance-harness-toolkit/case-result.schema.json",
  "title": "Conformance Case Result",
  "type": "object",
  "required": ["case_id", "verdict", "run_lane"],
  "properties": {
    "case_id": {"type": "string"},
    "run_lane": {"type": "string"},
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "unsupported", "environment-missing", "inconclusive", "xfail", "skip"]
    },
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "observed_summary": {"type": "string"},
    "comparison_needed": {"type": "boolean"},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": true
}
