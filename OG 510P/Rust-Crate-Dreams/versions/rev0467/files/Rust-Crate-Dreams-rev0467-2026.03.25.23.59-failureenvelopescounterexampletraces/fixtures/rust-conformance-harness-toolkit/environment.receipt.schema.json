{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rust-conformance-harness-toolkit/environment.receipt.schema.json",
  "title": "Conformance Environment Receipt",
  "type": "object",
  "required": ["suite_id", "suite_version", "implementation", "runner"],
  "properties": {
    "suite_id": {"type": "string"},
    "suite_version": {"type": "string"},
    "implementation": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "claimed_capabilities": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "runner": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "lane": {"type": "string"}
      },
      "additionalProperties": true
    },
    "target": {"type": "string"},
    "missing_preconditions": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
