{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rustcrate.dreams/fixtures/openapi31-jsonschema-toolchain-kit/oas-bundle.manifest.schema.json",
  "title": "oas-bundle.manifest",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "entries"
  ],
  "properties": {
    "artifact": {
      "const": "oas-bundle.manifest"
    },
    "subject": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "share_safety": {
      "type": "string",
      "enum": [
        "shareable",
        "redacted-shareable",
        "private-only",
        "manual-review"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
