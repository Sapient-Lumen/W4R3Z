{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rustcrate.dreams/fixtures/openapi31-jsonschema-toolchain-kit/ref-resolution.receipt.schema.json",
  "title": "ref-resolution.receipt",
  "type": "object",
  "required": [
    "artifact",
    "entry_document",
    "base_uri",
    "mode",
    "fetched",
    "ref_summary"
  ],
  "properties": {
    "artifact": {
      "const": "ref-resolution.receipt"
    },
    "entry_document": {
      "type": "string"
    },
    "base_uri": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "embedded-only",
        "offline-only",
        "mirror-only",
        "network-allowed"
      ]
    },
    "fetched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ref_summary": {
      "type": "object",
      "required": [
        "relative_refs",
        "remote_refs",
        "refused_refs"
      ],
      "properties": {
        "relative_refs": {
          "type": "integer",
          "minimum": 0
        },
        "remote_refs": {
          "type": "integer",
          "minimum": 0
        },
        "refused_refs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "cache_route": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
