{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ebpfbundle manifest",
  "type": "object",
  "required": [
    "schema_version",
    "created_utc",
    "programs",
    "host_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "created_utc": {
      "type": "string"
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "xdp",
              "tc",
              "tracepoint",
              "kprobe",
              "uproble",
              "other"
            ]
          }
        }
      }
    },
    "host_fingerprint": {
      "type": "object",
      "required": [
        "kernel_release"
      ],
      "properties": {
        "kernel_release": {
          "type": "string"
        },
        "btf": {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "source": {
              "type": "string"
            }
          }
        }
      }
    },
    "verifier": {
      "type": "object",
      "properties": {
        "normalized_log_path": {
          "type": "string"
        }
      }
    }
  }
}
