{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspacePackageSetReport",
  "type": "object",
  "required": [
    "members"
  ],
  "properties": {
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "selection_state"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "selection_state": {
            "type": "string"
          },
          "depends_on_members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "publish_candidate": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "order_basis": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
