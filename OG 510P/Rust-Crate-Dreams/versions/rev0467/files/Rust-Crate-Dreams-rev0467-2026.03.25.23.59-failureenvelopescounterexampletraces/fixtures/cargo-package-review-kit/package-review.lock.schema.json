{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PackageReviewLock",
  "type": "object",
  "required": [
    "cargo_version",
    "capture_mode",
    "selection_basis"
  ],
  "properties": {
    "cargo_version": {
      "type": "string"
    },
    "capture_mode": {
      "type": "string",
      "enum": [
        "single_package",
        "workspace_package_set"
      ]
    },
    "selection_basis": {
      "type": "string"
    },
    "package_workspace_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "redaction_mode": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
