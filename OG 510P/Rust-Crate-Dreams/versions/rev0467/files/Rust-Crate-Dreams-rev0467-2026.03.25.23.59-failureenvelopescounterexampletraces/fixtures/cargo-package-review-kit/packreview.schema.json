{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PackageReviewBundle",
  "type": "object",
  "required": [
    "bundle_files"
  ],
  "properties": {
    "bundle_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capture_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "package_count": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
