{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.local/hex-nif-shipkit/fallback-trigger.report.schema.json",
  "title": "Hex NIF fallback trigger report",
  "type": "object",
  "required": ["package", "class", "target", "precompiled_available", "local_build_forced", "manual_review_required"],
  "properties": {
    "package": {"type": "string"},
    "class": {"enum": ["fallback_contract_honest", "unsupported_target_forces_local_build", "manual_review_required"]},
    "target": {"type": "string"},
    "precompiled_available": {"type": "boolean"},
    "local_build_forced": {"type": "boolean"},
    "force_build_sources": {"type": "array", "items": {"type": "string"}},
    "required_tooling": {"type": "array", "items": {"type": "string"}},
    "manual_review_required": {"type": "boolean"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
