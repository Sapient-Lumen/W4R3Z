{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/hex-nif-shipkit/runtime-support.schema.json",
  "title": "HexNifRuntimeSupportBundle",
  "type": "object",
  "required": ["package_name", "support_class", "artifacts"],
  "properties": {
    "package_name": {"type": "string"},
    "support_class": {
      "type": "string",
      "enum": [
        "precompiled_matrix_ok",
        "checksum_gap",
        "nif_loader_mismatch",
        "source_build_fallback_only",
        "support_claim_exceeds_artifacts",
        "hex_package_size_risk",
        "manual_review_required"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "target"],
        "properties": {
          "name": {"type": "string"},
          "target": {"type": "string"},
          "otp": {"type": "string"},
          "elixir": {"type": "string"},
          "libc": {"type": "string"}
        }
      }
    }
  }
}
