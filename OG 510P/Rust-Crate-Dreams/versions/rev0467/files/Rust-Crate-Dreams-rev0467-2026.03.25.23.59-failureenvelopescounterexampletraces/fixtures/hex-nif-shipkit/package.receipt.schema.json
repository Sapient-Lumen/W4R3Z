{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/hex-nif-shipkit/package.receipt.schema.json",
  "title": "HexNifPackageReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "package_name",
    "version",
    "outer_checksum",
    "support_verdict"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "package_name": {"type": "string"},
    "version": {"type": "string"},
    "outer_checksum": {"type": "string"},
    "compressed_size_bytes": {"type": "integer", "minimum": 0},
    "uncompressed_size_bytes": {"type": "integer", "minimum": 0},
    "support_verdict": {
      "type": "string",
      "enum": [
        "precompiled_matrix_ok",
        "checksum_gap",
        "nif_loader_mismatch",
        "source_build_fallback_only",
        "support_claim_exceeds_artifacts",
        "hex_package_size_risk",
        "manual_review_required"
      ]
    }
  },
  "additionalProperties": true
}
