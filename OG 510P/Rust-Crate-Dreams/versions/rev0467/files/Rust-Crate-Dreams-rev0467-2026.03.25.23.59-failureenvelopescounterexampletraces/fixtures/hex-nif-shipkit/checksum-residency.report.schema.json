{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.local/hex-nif-shipkit/checksum-residency.report.schema.json",
  "title": "Hex NIF checksum residency report",
  "type": "object",
  "required": ["package", "class", "checksum_file", "hex_tarball", "remote_assets", "manual_review_required"],
  "properties": {
    "package": {"type": "string"},
    "class": {"enum": ["checksum_residency_ok", "checksum_file_missing_from_tarball", "checksum_asset_mismatch", "manual_review_required"]},
    "checksum_file": {
      "type": "object",
      "required": ["path", "present_in_repo", "present_in_tarball"],
      "properties": {
        "path": {"type": "string"},
        "present_in_repo": {"type": "boolean"},
        "present_in_tarball": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "hex_tarball": {"type": "object", "additionalProperties": true},
    "remote_assets": {"type": "array", "items": {"type": "object"}},
    "manual_review_required": {"type": "boolean"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
