{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/msrv-workspace-lab/msrv-policy.schema.json",
  "title": "MSRV workspace policy",
  "type": "object",
  "required": [
    "schema_version",
    "packages"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package",
          "declared_msrv",
          "support_tier"
        ],
        "properties": {
          "package": {
            "type": "string"
          },
          "declared_msrv": {
            "type": "string"
          },
          "support_tier": {
            "type": "string",
            "enum": [
              "library_promise",
              "product_lane",
              "example_lane",
              "internal_only",
              "unknown"
            ]
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "build",
                "test",
                "metadata",
                "doc",
                "clippy"
              ]
            }
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
