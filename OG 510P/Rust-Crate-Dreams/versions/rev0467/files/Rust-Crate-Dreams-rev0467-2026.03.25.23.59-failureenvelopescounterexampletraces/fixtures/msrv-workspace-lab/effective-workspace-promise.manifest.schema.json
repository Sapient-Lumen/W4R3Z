{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/fixtures/msrv-workspace-lab/effective-workspace-promise.manifest.schema.json",
  "title": "EffectiveWorkspacePromiseManifest",
  "type": "object",
  "required": [
    "schema_version",
    "workspace_id",
    "member_promises"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "default_promise_class": {
      "type": "string"
    },
    "member_promises": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "member_id",
          "promise_class",
          "declared_floor",
          "command_families",
          "lockfile_support_class"
        ],
        "properties": {
          "member_id": {
            "type": "string"
          },
          "promise_class": {
            "type": "string"
          },
          "declared_floor": {
            "type": "string"
          },
          "effective_floor": {
            "type": "string"
          },
          "command_families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lockfile_support_class": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "activation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
