{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/msrv-workspace-lab/toolchain-matrix.plan.schema.json",
  "title": "MSRV toolchain matrix plan",
  "type": "object",
  "required": [
    "schema_version",
    "lanes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lane_id",
          "package",
          "toolchain",
          "command_family"
        ],
        "properties": {
          "lane_id": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "toolchain": {
            "type": "string"
          },
          "command_family": {
            "type": "string",
            "enum": [
              "build",
              "test",
              "metadata",
              "doc",
              "clippy"
            ]
          },
          "target": {
            "type": "string"
          },
          "feature_profile": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
