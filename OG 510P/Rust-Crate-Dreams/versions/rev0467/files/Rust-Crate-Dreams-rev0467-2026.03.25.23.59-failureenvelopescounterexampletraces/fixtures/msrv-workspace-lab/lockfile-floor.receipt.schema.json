{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/msrv-workspace-lab/lockfile-floor.receipt.schema.json",
  "title": "MSRV lockfile floor receipt",
  "type": "object",
  "required": [
    "schema_version",
    "package",
    "action",
    "build_floor",
    "lockfile_version",
    "floor_state"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "package": {"type": "string"},
    "action": {
      "type": "string",
      "enum": ["read_existing_lockfile", "generate_lockfile", "update_lockfile"]
    },
    "claimed_package_rust_version": {"type": "string"},
    "build_floor": {"type": "string"},
    "authoring_floor": {"type": "string"},
    "cargo_version": {"type": "string"},
    "lockfile_version": {
      "type": "string",
      "enum": ["v3", "v4", "unknown"]
    },
    "floor_state": {
      "type": "string",
      "enum": [
        "matches_build_floor",
        "authoring_floor_higher_than_build_floor",
        "read_floor_higher_than_build_floor",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
