      "sensitivity": "public_safe"
    },
    {
      "kind": "command_family_floor",
      "path": "command-family-floor.report.json",
      "required_for_review": true,
      "sensitivity": "public_safe"
    },
    {
      "kind": "lockfile_floor",
      "path": "lockfile-floor.receipt.json",
      "required_for_review": true,
      "sensitivity": "public_safe"
    },
    {
      "kind": "policy_split_diff",
      "path": "policy-split-diff.report.json",
