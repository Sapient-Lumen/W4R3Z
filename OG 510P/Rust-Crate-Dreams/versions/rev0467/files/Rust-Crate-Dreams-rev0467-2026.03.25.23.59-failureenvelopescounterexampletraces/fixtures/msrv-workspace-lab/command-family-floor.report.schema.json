{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/msrv-workspace-lab/command-family-floor.report.schema.json",
  "title": "MSRV command-family floor report",
  "type": "object",
  "required": [
    "schema_version",
    "package",
    "policy_floor",
    "command_results"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "package": {"type": "string"},
    "policy_floor": {"type": "string"},
    "command_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command_family",
          "status"
        ],
        "properties": {
          "command_family": {
            "type": "string",
            "enum": ["build", "test", "metadata", "doc", "clippy", "update", "generate_lockfile", "package"]
          },
          "status": {
            "type": "string",
            "enum": ["supported_at_policy_floor", "requires_newer_toolchain", "not_checked", "manual_review_required"]
          },
          "effective_floor": {"type": "string"},
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
