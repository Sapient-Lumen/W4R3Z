{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileClassPolicy",
  "type": "object",
  "required": [
    "schema_version",
    "classes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class_name",
          "meaning"
        ],
        "properties": {
          "class_name": {
            "enum": [
              "shared_baseline",
              "ecosystem_boundary",
              "adapter_bridge",
              "behavior_probe_required",
              "deprecated_profile",
              "manual_review_required"
            ]
          },
          "meaning": {
            "type": "string"
          },
          "minimum_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "non_goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "example_profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
