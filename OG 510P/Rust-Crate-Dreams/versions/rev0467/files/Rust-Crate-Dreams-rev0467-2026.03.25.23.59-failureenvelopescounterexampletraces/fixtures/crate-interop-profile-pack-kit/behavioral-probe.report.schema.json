{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "behavioral probe report",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "probe_results"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "probe_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "probe_id",
          "result"
        ],
        "properties": {
          "probe_id": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
