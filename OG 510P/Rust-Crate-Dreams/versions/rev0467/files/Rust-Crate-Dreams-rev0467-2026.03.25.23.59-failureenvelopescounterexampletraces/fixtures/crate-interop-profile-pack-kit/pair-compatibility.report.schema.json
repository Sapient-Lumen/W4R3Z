{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pair compatibility report",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "provider",
    "consumer",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "consumer": {
      "type": "string"
    },
    "verdict": {
      "type": "string"
    },
    "matched_edges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_edges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
