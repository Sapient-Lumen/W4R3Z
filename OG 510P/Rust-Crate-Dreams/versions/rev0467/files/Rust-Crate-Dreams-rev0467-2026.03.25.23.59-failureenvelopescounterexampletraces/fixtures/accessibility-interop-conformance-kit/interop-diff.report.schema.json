{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "accessibility interop diff report",
  "type": "object",
  "required": [
    "format",
    "version",
    "left_capture_id",
    "right_capture_id",
    "comparability",
    "changes"
  ],
  "properties": {
    "format": {
      "const": "a11y-interop-diff"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "left_capture_id": {
      "type": "string"
    },
    "right_capture_id": {
      "type": "string"
    },
    "comparability": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "comparable",
            "partially-comparable",
            "not-comparable"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "status",
          "message"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "role",
              "name",
              "state",
              "relation",
              "focus-order",
              "event-order",
              "extension-only"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "material",
              "equivalent",
              "expected-platform-drift",
              "manual-review"
            ]
          },
          "left_node": {
            "type": [
              "string",
              "null"
            ]
          },
          "right_node": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
