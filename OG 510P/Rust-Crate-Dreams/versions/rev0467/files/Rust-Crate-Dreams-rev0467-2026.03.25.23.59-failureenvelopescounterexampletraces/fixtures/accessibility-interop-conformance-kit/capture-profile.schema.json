{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a11ylab capture profile",
  "type": "object",
  "required": [
    "format",
    "version",
    "scenario_id",
    "lane",
    "redaction"
  ],
  "properties": {
    "format": {
      "const": "a11y-capture-profile"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "scenario_id": {
      "type": "string"
    },
    "lane": {
      "type": "string",
      "enum": [
        "authoring",
        "atspi",
        "uia",
        "nsaccessibility"
      ]
    },
    "toolkit": {
      "type": "string"
    },
    "app": {
      "type": "string"
    },
    "tree_scope": {
      "type": "string",
      "enum": [
        "window",
        "subtree",
        "focused-path",
        "all"
      ]
    },
    "event_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "screenshot_mode": {
      "type": "string",
      "enum": [
        "none",
        "mapped",
        "raw"
      ]
    },
    "redaction": {
      "type": "object",
      "required": [
        "text_mode"
      ],
      "properties": {
        "text_mode": {
          "type": "string",
          "enum": [
            "structural",
            "hashed",
            "truncated",
            "raw"
          ]
        },
        "include_screenshots": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "baseline_capture_id": {
      "type": "string"
    }
  }
}
