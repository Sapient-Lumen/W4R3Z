{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/projection-reborrow/projection-authority.receipt.schema.json",
  "title": "Projection authority receipt",
  "type": "object",
  "required": ["schema_version", "subject", "authority_kind", "support_scope", "manual_review_required"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "authority_kind": {
      "type": "string",
      "enum": ["macro_generated", "manual_impl", "trait_family", "wrapper_api", "future_language_experiment", "unknown"]
    },
    "authority_sources": {
      "type": "array",
      "items": {"type": "string"}
    },
    "support_scope": {
      "type": "object",
      "required": ["field_paths"],
      "properties": {
        "field_paths": {"type": "array", "items": {"type": "string"}},
        "structurally_pinned_fields": {"type": "array", "items": {"type": "string"}},
        "wrapper_views": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "caveats": {"type": "array", "items": {"type": "string"}},
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
