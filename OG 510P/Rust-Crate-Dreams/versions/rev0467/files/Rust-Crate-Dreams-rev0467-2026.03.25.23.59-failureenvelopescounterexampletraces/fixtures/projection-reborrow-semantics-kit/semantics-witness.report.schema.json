{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/projection-reborrow/semantics-witness.report.schema.json",
  "title": "Semantics witness report",
  "type": "object",
  "required": ["schema_version", "subject", "ordinary_test_verdict", "miri_verdict", "uncovered_paths"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "ordinary_test_verdict": {"type": "string", "enum": ["pass", "fail", "not_run", "manual_review_required"]},
    "miri_verdict": {"type": "string", "enum": ["pass", "fail", "not_run", "partial", "manual_review_required"]},
    "execution_basis": {
      "type": "object",
      "properties": {
        "toolchain": {"type": "string"},
        "target": {"type": "string"},
        "fixture_families": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "uncovered_paths": {"type": "array", "items": {"type": "string"}},
    "false_confidence_risks": {"type": "array", "items": {"type": "string"}},
    "manual_review_notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
