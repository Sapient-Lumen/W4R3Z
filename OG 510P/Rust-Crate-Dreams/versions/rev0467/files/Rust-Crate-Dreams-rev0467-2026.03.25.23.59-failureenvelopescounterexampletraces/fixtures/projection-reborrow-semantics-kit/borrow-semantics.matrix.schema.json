{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/projection-reborrow/borrow-semantics.matrix.schema.json",
  "title": "Borrow semantics matrix",
  "type": "object",
  "required": ["schema_version", "subject", "rows"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mode_class", "verdict"],
        "properties": {
          "mode_class": {
            "type": "string",
            "enum": ["shared_projection", "mutable_projection", "pinned_projection", "nested_projection", "generalized_reborrow", "raw_escape_hatch", "out_ptr_init_bridge", "unknown"]
          },
          "verdict": {
            "type": "string",
            "enum": ["supported", "caveated", "unsupported", "manual_review_required"]
          },
          "prerequisites": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
