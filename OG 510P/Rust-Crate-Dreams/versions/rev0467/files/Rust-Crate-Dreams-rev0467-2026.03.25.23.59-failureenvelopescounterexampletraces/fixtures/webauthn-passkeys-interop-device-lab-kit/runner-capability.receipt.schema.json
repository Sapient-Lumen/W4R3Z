{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/fixtures/webauthn-passkeys-interop-device-lab-kit/runner-capability.receipt.schema.json",
  "title": "runner-capability.receipt",
  "type": "object",
  "required": ["lane_id", "runner_family", "automation_class", "stability_class", "comparability_class"],
  "properties": {
    "lane_id": {"type": "string"},
    "runner_family": {"type": "string", "enum": ["rust-only", "webdriver-virtual", "real-browser", "manual-device-import", "certification-import"]},
    "runner_name": {"type": "string"},
    "automation_class": {"type": "string", "enum": ["full", "partial", "manual", "imported"]},
    "stability_class": {"type": "string", "enum": ["stable", "experimental", "unreliable"]},
    "comparability_class": {"type": "string", "enum": ["cross-lane-eligible", "same-runner-family-only", "manual-review-required", "not-comparable"]},
    "supported_commands": {"type": "array", "items": {"type": "string"}},
    "unsupported_commands": {"type": "array", "items": {"type": "string"}},
    "supported_overlays": {"type": "array", "items": {"type": "string"}},
    "warning_sources": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
