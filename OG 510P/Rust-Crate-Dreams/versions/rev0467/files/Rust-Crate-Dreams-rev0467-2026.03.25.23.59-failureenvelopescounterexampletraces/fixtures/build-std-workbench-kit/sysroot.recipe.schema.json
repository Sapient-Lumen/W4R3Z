{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build-Std Workbench recipe snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "target",
    "crates",
    "profile",
    "stage_hint"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "target_source": {
      "type": "string",
      "enum": [
        "triple",
        "custom_json"
      ]
    },
    "crates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profile": {
      "type": "string"
    },
    "build_std_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rustflags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stage_hint": {
      "type": "string",
      "enum": [
        "manual_build_std",
        "explicit_std_dependency_transition",
        "target_modifier_profile",
        "automatic_rebuild_policy"
      ]
    }
  }
}
