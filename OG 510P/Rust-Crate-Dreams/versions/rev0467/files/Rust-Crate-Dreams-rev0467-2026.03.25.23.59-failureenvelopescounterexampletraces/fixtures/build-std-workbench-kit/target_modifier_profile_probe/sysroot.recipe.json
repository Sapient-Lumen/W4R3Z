{
  "schema_version": "1",
  "target": "x86_64-unknown-linux-gnu",
  "target_source": "triple",
  "crates": [
    "core",
    "alloc",
    "std"
  ],
  "profile": "release",
  "build_std_features": [
    "panic-unwind"
  ],
  "rustflags": [
    "-Zno-jump-tables",
    "-Zharden-sls=all"
  ],
  "stage_hint": "target_modifier_profile"
}
