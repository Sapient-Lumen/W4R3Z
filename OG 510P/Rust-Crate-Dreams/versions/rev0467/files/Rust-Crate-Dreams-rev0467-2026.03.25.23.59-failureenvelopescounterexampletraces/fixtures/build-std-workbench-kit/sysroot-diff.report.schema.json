{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build-Std sysroot diff report",
  "type": "object",
  "required": [
    "schema_version",
    "verdict",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "same_recipe_new_toolchain",
        "same_toolchain_changed_std_source",
        "target_modifier_drift",
        "stage_posture_changed",
        "build_std_feature_set_changed",
        "manual_review_required"
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_needed": {
      "type": "boolean"
    }
  }
}
