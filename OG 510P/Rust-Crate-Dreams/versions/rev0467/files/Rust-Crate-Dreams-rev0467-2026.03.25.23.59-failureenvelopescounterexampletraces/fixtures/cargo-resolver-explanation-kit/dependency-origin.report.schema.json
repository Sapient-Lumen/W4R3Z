{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dependency-origin.report",
  "type": "object",
  "required": [
    "schema_version",
    "dependency_key",
    "origin"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "dependency_key": {
      "type": "string"
    },
    "origin": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "workspace_dependencies",
          "member_manifest",
          "target_specific_inherited_edge",
          "conservative_merge"
        ]
      }
    },
    "default_feature_state": {
      "type": "string",
      "enum": [
        "disabled",
        "enabled",
        "neutralized",
        "re_enabled",
        "conservative"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
