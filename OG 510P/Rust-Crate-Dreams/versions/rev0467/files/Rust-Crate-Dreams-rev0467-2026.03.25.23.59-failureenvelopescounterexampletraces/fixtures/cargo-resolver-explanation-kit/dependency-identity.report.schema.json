{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dependency-identity.report",
  "type": "object",
  "required": [
    "schema_version",
    "local_dependency_key",
    "package_name"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "local_dependency_key": {
      "type": "string"
    },
    "package_name": {
      "type": "string"
    },
    "feature_reference_token": {
      "type": "string"
    },
    "rename_state": {
      "type": "string",
      "enum": [
        "not_renamed",
        "renamed_locally",
        "rename_intent_ignored",
        "conservative"
      ]
    },
    "metadata_name": {
      "type": "string"
    },
    "metadata_rename": {
      "type": "string"
    },
    "index_name": {
      "type": "string"
    },
    "index_package": {
      "type": "string"
    },
    "exactness": {
      "type": "string",
      "enum": [
        "exact",
        "conservative",
        "manual_review_required"
      ]
    }
  },
  "additionalProperties": true
}
