{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature-origin.report",
  "type": "object",
  "required": [
    "schema_version",
    "feature_token",
    "kind"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "feature_token": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "explicit",
        "implicit_optional_dependency",
        "dep_hidden",
        "strong_forward",
        "weak_forward",
        "manual_review_required"
      ]
    },
    "activates_dependency_directly": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
