{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "version-choices",
  "type": "object",
  "required": [
    "schema_version",
    "choices"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package",
          "selected_version",
          "reason_kinds"
        ],
        "properties": {
          "package": {
            "type": "string"
          },
          "selected_version": {
            "type": "string"
          },
          "reason_kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "lockfile_carry_forward",
                "msrv_fallback",
                "workspace_heuristic",
                "feature_requirement",
                "version_unification",
                "range_constraint"
              ]
            }
          },
          "candidate_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exactness": {
            "type": "string",
            "enum": [
              "exact",
              "conservative",
              "manual_review_required"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
