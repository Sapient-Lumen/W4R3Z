{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature-causes",
  "type": "object",
  "required": [
    "schema_version",
    "package",
    "features"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "package": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "feature",
          "causes"
        ],
        "properties": {
          "feature": {
            "type": "string"
          },
          "causes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "via"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "direct-request",
                    "workspace-pressure",
                    "implicit-optional-dependency",
                    "strong-forward",
                    "weak-forward",
                    "default-feature"
                  ]
                },
                "via": {
                  "type": "string"
                },
                "exactness": {
                  "type": "string",
                  "enum": [
                    "exact",
                    "conservative",
                    "manual_review_required"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
