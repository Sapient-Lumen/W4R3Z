{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lane-partition.report",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "lanes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lane",
          "status"
        ],
        "properties": {
          "lane": {
            "type": "string",
            "enum": [
              "normal",
              "build",
              "proc-macro",
              "dev"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "observed_separately",
              "merged_in_surface",
              "out_of_scope"
            ]
          }
        }
      }
    },
    "exactness": {
      "type": "string",
      "enum": [
        "exact",
        "conservative",
        "manual_review_required"
      ]
    }
  },
  "additionalProperties": true
}
