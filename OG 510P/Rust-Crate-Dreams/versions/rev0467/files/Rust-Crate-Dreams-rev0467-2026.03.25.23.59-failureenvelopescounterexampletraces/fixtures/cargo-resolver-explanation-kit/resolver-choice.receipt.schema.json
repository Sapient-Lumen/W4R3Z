{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "resolver-choice.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "commands",
    "evidence_sources",
    "exactness"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "cargo_metadata",
              "cargo_tree",
              "unit_graph",
              "manual_manifest_scan",
              "lockfile"
            ]
          },
          "used": {
            "type": "boolean"
          }
        }
      }
    },
    "exactness": {
      "type": "string",
      "enum": [
        "exact",
        "conservative",
        "manual_review_required"
      ]
    },
    "manual_review_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
