{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "resolve-why.lock",
  "type": "object",
  "required": [
    "schema_version",
    "cargo",
    "workspace",
    "selection",
    "resolver"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "cargo": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        }
      }
    },
    "workspace": {
      "type": "object",
      "required": [
        "root_manifest"
      ],
      "properties": {
        "root_manifest": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "packages",
        "targets"
      ],
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "all_targets": {
          "type": "boolean"
        }
      }
    },
    "resolver": {
      "type": "object",
      "required": [
        "version",
        "feature_unification",
        "incompatible_rust_versions"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "feature_unification": {
          "type": "string",
          "enum": [
            "selected",
            "workspace",
            "package"
          ]
        },
        "incompatible_rust_versions": {
          "type": "string",
          "enum": [
            "allow",
            "fallback"
          ]
        },
        "lockfile_pass_shape": {
          "type": "string",
          "enum": [
            "all-workspace-features",
            "selected-compile-features",
            "mixed-import"
          ]
        }
      }
    },
    "capture_scope": {
      "type": "string"
    },
    "evidence_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
