{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResetCapabilityReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_or_resource",
    "reset_class",
    "cleanup_mode",
    "cleanup_trigger"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "fixture_or_resource": {
      "type": "string"
    },
    "reset_class": {
      "type": "string",
      "enum": [
        "os_cleanup",
        "drop_cleanup",
        "explicit_reset",
        "best_effort_external_cleanup",
        "no_reset_support",
        "manual_review_required"
      ]
    },
    "cleanup_mode": {
      "type": "string",
      "enum": [
        "automatic",
        "scope_bound",
        "explicit",
        "best_effort",
        "none",
        "manual_review_required"
      ]
    },
    "cleanup_trigger": {
      "type": "string"
    },
    "contamination_window": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
