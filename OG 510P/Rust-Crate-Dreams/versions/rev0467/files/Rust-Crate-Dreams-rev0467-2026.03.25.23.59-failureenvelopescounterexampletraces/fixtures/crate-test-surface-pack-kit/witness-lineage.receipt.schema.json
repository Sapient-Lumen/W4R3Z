{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WitnessLineageReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "origin",
    "runner",
    "portability",
    "replay_support",
    "notes"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "scenario": {"type": "string"},
    "origin": {
      "type": "string",
      "enum": [
        "direct_local_run",
        "ci_run_import",
        "portable_recording_import",
        "compile_fail_harness",
        "snapshot_review",
        "manual_review_required"
      ]
    },
    "runner": {"type": "string"},
    "portability": {
      "type": "string",
      "enum": [
        "local_only",
        "same_machine_cache",
        "portable_bundle",
        "manual_review_required"
      ]
    },
    "replay_support": {
      "type": "string",
      "enum": [
        "supported",
        "partial",
        "not_supported",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
