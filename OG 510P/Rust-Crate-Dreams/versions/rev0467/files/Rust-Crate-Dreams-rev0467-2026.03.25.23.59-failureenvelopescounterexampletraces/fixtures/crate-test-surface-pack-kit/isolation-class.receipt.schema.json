{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IsolationClassReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_or_scenario",
    "isolation_class",
    "runner_assumption",
    "parallel_posture"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "fixture_or_scenario": {
      "type": "string"
    },
    "isolation_class": {
      "type": "string",
      "enum": [
        "per_call_fresh",
        "per_test_fresh",
        "process_shared",
        "externally_shared",
        "runner_isolated_only",
        "manual_review_required"
      ]
    },
    "runner_assumption": {
      "type": "string",
      "enum": [
        "cargo_test_shared_process",
        "cargo_test_serial",
        "nextest_process_per_test",
        "manual_review_required"
      ]
    },
    "parallel_posture": {
      "type": "string",
      "enum": [
        "parallel_safe",
        "serial_only",
        "runner_isolated_only",
        "parallel_safe_with_unique_resources",
        "manual_review_required"
      ]
    },
    "hazard_kinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
