{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestSurfacePack",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "fixture_families"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "fixture_families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "stability",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "stability": {
            "enum": [
              "officially_supported",
              "best_effort_example",
              "internal_only"
            ]
          },
          "kind": {
            "enum": [
              "in_memory",
              "ephemeral_fs",
              "protocol_mock",
              "record_replay",
              "temp_builder",
              "containerized_peer",
              "manual_review_required"
            ]
          }
        }
      }
    }
  }
}