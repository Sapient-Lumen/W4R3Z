{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/doctest-runtool-profile-kit/runner-route.receipt.schema.json",
  "title": "RunnerRouteReceipt",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "route_kind"],
        "properties": {
          "target": {"type": "string"},
          "route_kind": {
            "type": "string",
            "enum": [
              "explicit_rustdoc_runtool",
              "cargo_target_triple_runner",
              "cargo_target_cfg_runner",
              "environment_runner_override",
              "direct_no_runner",
              "manual_review_required"
            ]
          },
          "wrapper_program": {"type": ["string", "null"]},
          "wrapper_args": {"type": "array", "items": {"type": "string"}},
          "declaration_sources": {"type": "array", "items": {"type": "string"}},
          "precedence_notes": {"type": "array", "items": {"type": "string"}},
          "manual_review_required": {"type": "boolean"},
          "summary": {"type": "string"}
        }
      }
    }
  }
}
