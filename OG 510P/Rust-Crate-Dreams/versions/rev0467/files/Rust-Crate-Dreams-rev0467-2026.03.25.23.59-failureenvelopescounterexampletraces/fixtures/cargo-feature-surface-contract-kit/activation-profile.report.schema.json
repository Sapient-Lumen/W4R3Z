{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "activation-profile.report",
  "type": "object",
  "required": ["crate", "profiles"],
  "properties": {
    "crate": {"type": "string"},
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "features", "status"],
        "properties": {
          "name": {"type": "string"},
          "features": {"type": "array", "items": {"type": "string"}},
          "status": {
            "enum": ["observed", "sampled", "recipe_only", "manual_review_required", "unsupported"]
          },
          "witness": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
