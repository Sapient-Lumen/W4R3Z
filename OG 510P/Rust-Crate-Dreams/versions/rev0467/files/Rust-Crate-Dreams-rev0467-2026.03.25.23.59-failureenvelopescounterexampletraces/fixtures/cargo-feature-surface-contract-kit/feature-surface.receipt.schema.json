{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature-surface.receipt",
  "type": "object",
  "required": ["crate", "features"],
  "properties": {
    "crate": {"type": "string"},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "class", "public_contract"],
        "properties": {
          "name": {"type": "string"},
          "class": {
            "enum": [
              "public_feature",
              "group_toggle",
              "internal_dep_toggle",
              "default_member",
              "hidden_optional_dependency",
              "manual_review_required"
            ]
          },
          "public_contract": {"type": "boolean"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
