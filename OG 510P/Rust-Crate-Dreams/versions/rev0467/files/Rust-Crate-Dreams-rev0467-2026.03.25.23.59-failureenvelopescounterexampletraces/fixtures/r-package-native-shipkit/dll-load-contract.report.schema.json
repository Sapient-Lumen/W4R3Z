{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.local/r-package-native-shipkit/dll-load-contract.report.schema.json",
  "title": "DllLoadContractReport",
  "type": "object",
  "required": ["package", "class", "summary"],
  "properties": {
    "package": {"type": "string"},
    "class": {
      "type": "string",
      "enum": [
        "dll_load_contract_ok",
        "dll_load_name_mismatch",
        "dll_load_contract_review_required",
        "manual_review_required"
      ]
    },
    "summary": {"type": "string"},
    "load_mode": {"type": "string"},
    "package_name": {"type": "string"},
    "library_name": {"type": "string"},
    "observed_artifact_name": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
