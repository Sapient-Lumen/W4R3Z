{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sidecar-attachment.receipt",
  "type": "object",
  "required": ["schema_version", "decisions"],
  "properties": {
    "schema_version": {"type": "string"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_path", "sidecar_path", "attachment_policy", "reason"],
        "properties": {
          "artifact_path": {"type": "string"},
          "sidecar_path": {"type": "string"},
          "attachment_policy": {"type": "string", "enum": ["ship_with_artifact", "analysis_only", "manual_review"]},
          "reason": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "additionalProperties": true
}
