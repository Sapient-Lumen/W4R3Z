{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sidecar-schema.report",
  "type": "object",
  "required": ["schema_version", "sidecar_families"],
  "properties": {
    "schema_version": {"type": "string"},
    "sidecar_families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sidecar_kind", "schema_id", "schema_version", "stability"],
        "properties": {
          "sidecar_kind": {"type": "string"},
          "schema_id": {"type": "string"},
          "schema_version": {"type": "string"},
          "stability": {"type": "string", "enum": ["stable_consumer_safe", "moving_target", "consumer_specific"]},
          "consumer_hints": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "additionalProperties": true
}
