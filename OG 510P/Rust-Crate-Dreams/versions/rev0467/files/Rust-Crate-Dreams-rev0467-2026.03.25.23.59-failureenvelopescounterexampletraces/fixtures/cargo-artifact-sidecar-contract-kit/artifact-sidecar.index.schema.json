{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "artifact-sidecar.index",
  "type": "object",
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": {"type": "string"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_path", "artifact_kind", "package_id", "sidecars"],
        "properties": {
          "artifact_path": {"type": "string"},
          "artifact_kind": {"type": "string"},
          "package_id": {"type": "string"},
          "target_name": {"type": "string"},
          "sidecars": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sidecar_kind", "association_basis", "attachment_policy"],
              "properties": {
                "path": {"type": "string"},
                "sidecar_kind": {"type": "string"},
                "association_basis": {
                  "type": "string",
                  "enum": ["compiler_artifact_message", "artifact_dir_layout", "cargo_sbom_path_env", "filename_match", "manual_mapping"]
                },
                "attachment_policy": {
                  "type": "string",
                  "enum": ["ship_with_artifact", "analysis_only", "manual_review"]
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
