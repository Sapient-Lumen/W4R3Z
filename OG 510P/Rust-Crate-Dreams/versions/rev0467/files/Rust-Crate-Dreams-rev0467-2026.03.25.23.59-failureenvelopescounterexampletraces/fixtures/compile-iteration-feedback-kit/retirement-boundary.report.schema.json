{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/retirement-boundary.report.schema.json",
  "title": "RetirementBoundaryReport",
  "type": "object",
  "required": [
    "subject",
    "retirement_scope",
    "retirement_boundary",
    "witness_basis",
    "confidence"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "retirement_scope": {
      "type": "string",
      "enum": [
        "call_stack",
        "entrypoint_family",
        "request_class",
        "task_family",
        "callback_registry",
        "dynamic_library",
        "whole_process"
      ]
    },
    "retirement_boundary": {
      "type": "object",
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "after_unwind_to_anchor",
            "after_next_entrypoint_return",
            "manual_drain_required",
            "unbounded_or_unknown",
            "immediate_library_swap_only"
          ]
        },
        "anchor": {
          "type": "string"
        },
        "applies_to_routes": {
          "type": "string",
          "enum": [
            "single_stack",
            "anchor_scoped",
            "route_family_scoped",
            "library_scoped",
            "process_scoped",
            "unknown"
          ]
        },
        "applies_from": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "witness_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "manual_review_required"
      ]
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
