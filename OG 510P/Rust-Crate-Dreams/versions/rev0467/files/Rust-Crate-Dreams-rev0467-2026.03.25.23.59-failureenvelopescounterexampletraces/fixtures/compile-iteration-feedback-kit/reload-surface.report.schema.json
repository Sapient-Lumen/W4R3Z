{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/reload-surface.report.schema.json",
  "title": "ReloadSurfaceReport",
  "type": "object",
  "required": [
    "surface_class",
    "change_route",
    "rust_recompile_avoided",
    "state_touch_class",
    "confidence_class"
  ],
  "properties": {
    "surface_class": {
      "type": "string",
      "enum": [
        "rsx_markup",
        "css_asset",
        "static_asset",
        "frontend_hmr",
        "rust_logic",
        "mixed_frontend_and_rust",
        "unknown"
      ]
    },
    "change_route": {
      "type": "string",
      "enum": [
        "framework_markup_reload",
        "asset_watcher_reload",
        "frontend_devserver_hmr",
        "rust_hotpatch",
        "separate_frontend_devserver_and_rust_reload",
        "full_rebuild_restart",
        "manual_review"
      ]
    },
    "rust_recompile_avoided": {
      "type": "boolean"
    },
    "state_touch_class": {
      "type": "string",
      "enum": [
        "presentation_only",
        "asset_only",
        "frontend_only",
        "function_logic",
        "mixed",
        "global_or_layout",
        "unknown"
      ]
    },
    "confidence_class": {
      "type": "string",
      "enum": [
        "direct_observation",
        "imported_substrate",
        "conservative_inference",
        "manual_review"
      ]
    },
    "evidence_sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
