{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/old-generation-drain.report.schema.json",
  "title": "OldGenerationDrainReport",
  "type": "object",
  "required": [
    "subject",
    "drain_scope",
    "drain_state",
    "witness_basis",
    "confidence"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "drain_scope": {
      "type": "string",
      "enum": [
        "call_stack",
        "request",
        "callback_queue",
        "task_set",
        "dynamic_library",
        "whole_process"
      ]
    },
    "drain_state": {
      "type": "object",
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "drained_observed",
            "anchor_scoped_rewind_observed",
            "reload_only_no_drain_proof",
            "mixed_inflight_possible",
            "unknown"
          ]
        },
        "witness_source": {
          "type": "string",
          "enum": [
            "stack_unwind",
            "reload_observer",
            "entrypoint_reinvocation",
            "framework_adapter",
            "manual_inference"
          ]
        },
        "old_generation_work_may_remain": {
          "type": "boolean"
        },
        "bounded_by": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "witness_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "manual_review_required"
      ]
    },
    "fallback_action": {
      "type": "string",
      "enum": [
        "none",
        "observe_more",
        "manual_review",
        "restart"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
