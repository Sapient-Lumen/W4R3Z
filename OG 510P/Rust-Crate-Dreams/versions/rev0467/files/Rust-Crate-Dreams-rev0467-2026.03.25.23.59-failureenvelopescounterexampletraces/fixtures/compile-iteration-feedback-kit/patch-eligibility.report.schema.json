{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/patch-eligibility.report.schema.json",
  "title": "PatchEligibilityReport",
  "type": "object",
  "required": [
    "edit_classification",
    "reload_lane",
    "requires_restart",
    "state_continuity",
    "confidence_class"
  ],
  "properties": {
    "edit_classification": {
      "type": "string",
      "enum": [
        "markup_only",
        "asset_only",
        "function_body",
        "public_api",
        "layout_or_global",
        "generated_code",
        "manual_review"
      ]
    },
    "reload_lane": {
      "type": "string",
      "enum": [
        "ui_only_reload",
        "asset_reload",
        "function_hotpatch",
        "relink_only",
        "full_rebuild_restart",
        "manual_review_required"
      ]
    },
    "requires_restart": {
      "type": "boolean"
    },
    "state_continuity": {
      "type": "string",
      "enum": [
        "preserved",
        "partially_preserved",
        "reset_required",
        "unknown"
      ]
    },
    "confidence_class": {
      "type": "string",
      "enum": [
        "direct_observation",
        "imported_substrate",
        "conservative_inference",
        "manual_review"
      ]
    },
    "manual_review_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
