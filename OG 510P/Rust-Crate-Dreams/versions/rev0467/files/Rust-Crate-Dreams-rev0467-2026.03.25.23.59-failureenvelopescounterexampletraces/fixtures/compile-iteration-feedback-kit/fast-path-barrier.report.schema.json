{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/fast-path-barrier.report.schema.json",
  "title": "FastPathBarrierReport",
  "type": "object",
  "required": [
    "strongest_available_route",
    "barrier_class",
    "fallback_class",
    "readiness_class",
    "confidence_class"
  ],
  "properties": {
    "strongest_available_route": {
      "type": "string",
      "enum": [
        "visual_reload",
        "frontend_hmr",
        "rust_hotpatch",
        "relink_only",
        "full_rebuild_restart",
        "manual_review"
      ]
    },
    "barrier_class": {
      "type": "string",
      "enum": [
        "frontend_only_surface",
        "outside_tip_crate",
        "public_interface_change",
        "layout_or_alignment_change",
        "global_initializer_change",
        "thread_local_reset_risk",
        "workspace_cascade_rebuild",
        "build_config_or_module_route_change",
        "state_reinstancing_required",
        "unknown"
      ]
    },
    "fallback_class": {
      "type": "string",
      "enum": [
        "keep_fast_path",
        "downgrade_to_visual_only",
        "relink_but_do_not_patch",
        "restart_with_state_reset",
        "restart_with_reinstancing",
        "manual_review"
      ]
    },
    "readiness_class": {
      "type": "string",
      "enum": [
        "visual_update_visible",
        "logic_ready_without_restart",
        "restart_complete",
        "not_achieved",
        "manual_review"
      ]
    },
    "confidence_class": {
      "type": "string",
      "enum": [
        "direct_observation",
        "imported_substrate",
        "conservative_inference",
        "manual_review"
      ]
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
