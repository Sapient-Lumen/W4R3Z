{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/coverage-scope.receipt.schema.json",
  "title": "CoverageScopeReceipt",
  "type": "object",
  "required": [
    "subject",
    "coverage_classes",
    "covered_surfaces",
    "route_basis",
    "confidence"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "coverage_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "markup_only",
          "asset_only",
          "tip_crate_only",
          "annotated_functions_only",
          "wrapped_exports_only",
          "preexisting_routes_only",
          "mixed_framework_specific",
          "manual_review_required"
        ]
      }
    },
    "covered_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "route_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activation_prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "manual_review_required"
      ]
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
