{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/mixed-generation-risk.report.schema.json",
  "title": "MixedGenerationRiskReport",
  "type": "object",
  "required": [
    "mixed_generation_possible",
    "risk_class",
    "route_classes",
    "fallback_action"
  ],
  "properties": {
    "mixed_generation_possible": {
      "type": "boolean"
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "none_observed",
        "bounded",
        "material",
        "unknown",
        "manual_review_required"
      ]
    },
    "route_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "switching_routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retained_old_routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bounded_by": {
      "type": "string",
      "enum": [
        "reload_event",
        "call_boundary",
        "entrypoint_reinvocation",
        "framework_pass",
        "restart_only",
        "unknown"
      ]
    },
    "fallback_action": {
      "type": "string",
      "enum": [
        "accept_mixed_generation",
        "manual_review",
        "reinstance_state",
        "full_restart"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}