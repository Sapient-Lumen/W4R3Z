{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/coverage-ceiling.report.schema.json",
  "title": "CoverageCeilingReport",
  "type": "object",
  "required": [
    "subject",
    "ceiling_class",
    "unsupported_claims",
    "trigger_basis",
    "fallback_truth",
    "confidence"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "ceiling_class": {
      "type": "string",
      "enum": [
        "workspace_gap",
        "annotation_gap",
        "wrapper_gap",
        "launch_time_gap",
        "feature_disabled_gap",
        "target_or_runtime_gap",
        "generic_api_gap",
        "manual_review_required"
      ]
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trigger_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallback_truth": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "manual_review_required"
      ]
    },
    "manual_review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
