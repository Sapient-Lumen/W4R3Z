{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/fallback-restart.plan.schema.json",
  "title": "FallbackRestartPlan",
  "type": "object",
  "required": [
    "restart_class",
    "trigger_conditions",
    "state_reset_scope",
    "operator_steps"
  ],
  "properties": {
    "restart_class": {
      "type": "string",
      "enum": [
        "no_restart_contract",
        "process_restart",
        "full_rebuild_restart",
        "device_or_host_restart",
        "manual_review"
      ]
    },
    "trigger_conditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "state_reset_scope": {
      "type": "string",
      "enum": [
        "none",
        "ui_state_only",
        "process_state",
        "frontend_session_only",
        "process_and_frontend_session",
        "unknown"
      ]
    },
    "operator_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "manual_review_gates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
