{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/degraded-iteration-mode.report.schema.json",
  "title": "DegradedIterationModeReport",
  "type": "object",
  "required": [
    "subject",
    "mode_class",
    "trigger_basis",
    "operator_guidance"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "mode_class": {
      "type": "string",
      "enum": [
        "healthy_live_update",
        "degraded_live_update",
        "observe_only",
        "relink_only",
        "restart_only",
        "disabled_due_to_error",
        "crashed_or_unknown"
      ]
    },
    "trigger_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operator_guidance": {
      "type": "object",
      "required": [
        "recommendation",
        "visibility"
      ],
      "properties": {
        "recommendation": {
          "type": "string",
          "enum": [
            "continue_with_caution",
            "continue_without_live_update",
            "restart_before_proceeding",
            "disable_hot_reload",
            "manual_review_required"
          ]
        },
        "visibility": {
          "type": "string",
          "enum": [
            "explicit_error",
            "warning_only",
            "inferred_from_docs",
            "manual_inference"
          ]
        }
      },
      "additionalProperties": false
    },
    "manual_review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
