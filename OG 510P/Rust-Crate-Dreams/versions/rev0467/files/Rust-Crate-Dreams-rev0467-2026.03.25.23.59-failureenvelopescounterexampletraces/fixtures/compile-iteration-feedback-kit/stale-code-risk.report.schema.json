{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixtures/compile-iteration-feedback-kit/stale-code-risk.report.schema.json",
  "title": "StaleCodeRiskReport",
  "type": "object",
  "required": [
    "residency_class",
    "risk_routes",
    "requires_explicit_rebinding",
    "explicit_handoff_available",
    "mitigation_routes",
    "manual_review_reasons"
  ],
  "properties": {
    "residency_class": {
      "type": "string",
      "enum": [
        "none_observed",
        "bounded_until_return",
        "rebind_required",
        "indefinite_possible",
        "restart_required",
        "unknown"
      ]
    },
    "risk_routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_explicit_rebinding": {
      "type": "boolean"
    },
    "explicit_handoff_available": {
      "type": "boolean"
    },
    "mitigation_routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
