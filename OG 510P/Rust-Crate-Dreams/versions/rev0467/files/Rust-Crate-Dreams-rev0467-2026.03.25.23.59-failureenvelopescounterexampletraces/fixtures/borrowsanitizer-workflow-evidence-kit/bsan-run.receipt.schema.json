{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BorrowSanitizer Run Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "profile_id",
    "toolchain",
    "result",
    "finding_count"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "toolchain": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "clean",
        "findings",
        "tool-error",
        "partial",
        "manual-review-required"
      ]
    },
    "finding_count": {
      "type": "integer"
    },
    "boundary_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
