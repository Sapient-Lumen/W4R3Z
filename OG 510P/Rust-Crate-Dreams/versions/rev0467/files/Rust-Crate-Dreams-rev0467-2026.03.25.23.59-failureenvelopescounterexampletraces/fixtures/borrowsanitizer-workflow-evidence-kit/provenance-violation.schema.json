{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provenance Violation",
  "type": "object",
  "required": [
    "schema_version",
    "violation_id",
    "class",
    "severity",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "violation_id": {
      "type": "string"
    },
    "class": {
      "type": "string",
      "enum": [
        "aliasing",
        "reborrow",
        "use-after-invalidate",
        "ffi-contract-drift",
        "unknown"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ]
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_boundary_id": {
      "type": "string"
    },
    "manual_review": {
      "type": "boolean"
    }
  }
}
