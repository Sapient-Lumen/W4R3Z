{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BorrowSanitizer Profile",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "toolchain",
    "target",
    "workload"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "toolchain": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "workload": {
      "type": "string"
    },
    "ffi_policy": {
      "type": "string"
    },
    "redaction": {
      "type": "string"
    },
    "miri_compare": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
