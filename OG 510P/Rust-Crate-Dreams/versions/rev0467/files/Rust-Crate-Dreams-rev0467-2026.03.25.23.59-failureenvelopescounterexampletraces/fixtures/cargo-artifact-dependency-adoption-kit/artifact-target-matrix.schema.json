{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactTargetMatrix",
  "type": "object",
  "required": ["rows"],
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dependency", "target", "artifact_kind"],
        "properties": {
          "dependency": {"type": "string"},
          "target": {"type": "string"},
          "artifact_kind": {"type": "string"},
          "mode": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
