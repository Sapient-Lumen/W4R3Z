{
  "schema_version": "0.1.0",
  "command": ["cargo", "resolve-why", "diff", "before.resolvewhybundle.zip", "after.resolvewhybundle.zip"],
  "cargo": {
    "version": "1.85.0",
    "resolver_version": "3",
    "feature_unification_mode": "selected"
  },
  "data_sources": ["cargo_metadata", "lockfile_diff", "cargo_tree_duplicates"],
  "assumptions": [
    "version-choice explanation reports lockfile movement directly when the diff is visible",
    "rejected alternatives remain unknown unless Cargo or the operator supplied them explicitly"
  ],
  "manual_review_required": false,
  "redactions": {
    "private_paths": true,
    "private_package_names": false
  }
}
