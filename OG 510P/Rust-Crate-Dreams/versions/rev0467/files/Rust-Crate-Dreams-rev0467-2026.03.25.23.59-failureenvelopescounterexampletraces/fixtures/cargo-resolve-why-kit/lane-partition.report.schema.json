{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-resolve-why/lane-partition.report.schema.json",
  "title": "Cargo resolve why — dependency-kind lane partition report",
  "type": "object",
  "required": ["schema_version", "subject_package", "lanes", "overall_exactness"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject_package": {"type": "string"},
    "selection_scope": {
      "type": "object",
      "properties": {
        "command_kind": {"type": "string"},
        "workspace_members": {"type": "array", "items": {"type": "string"}},
        "targets": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lane_kind", "selected_for_command", "feature_state", "exactness"],
        "properties": {
          "lane_kind": {
            "type": "string",
            "enum": ["normal", "build", "proc_macro", "dev", "artifact", "unknown"]
          },
          "selected_for_command": {"type": "boolean"},
          "feature_state": {
            "type": "string",
            "enum": ["active", "inactive", "merged_in_surface", "unknown"]
          },
          "observed_features": {"type": "array", "items": {"type": "string"}},
          "relationship_to_other_lanes": {
            "type": "string",
            "enum": ["independent", "merged_in_surface", "shared_build", "unknown"]
          },
          "evidence_basis": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["cargo_metadata", "cargo_tree_features", "unit_graph", "manual_manifest_scan", "conservative_inference", "issue_repro"]
            }
          },
          "exactness": {"type": "string", "enum": ["exact", "conservative", "manual_review_required"]},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "overall_exactness": {"type": "string", "enum": ["exact", "conservative", "manual_review_required"]},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
