{
  "schema_version": "0.1.0",
  "capture_id": "selection-mask-01",
  "workspace_root": "/workspace",
  "cargo": {
    "version": "1.90.0",
    "resolver_version": "2"
  },
  "selection": {
    "command_kind": "check",
    "workspace_members": ["user1", "user2"],
    "targets": ["host"],
    "features": [],
    "all_features": false,
    "no_default_features": false
  },
  "inputs": {
    "lockfile_present": true,
    "manifest_paths": ["/workspace/Cargo.toml", "/workspace/user1/Cargo.toml", "/workspace/user2/Cargo.toml"]
  }
}
