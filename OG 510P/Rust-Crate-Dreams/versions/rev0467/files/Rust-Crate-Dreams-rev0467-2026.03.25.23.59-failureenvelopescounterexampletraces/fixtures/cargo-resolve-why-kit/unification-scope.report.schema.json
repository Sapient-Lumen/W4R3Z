{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-resolve-why/unification-scope.report.schema.json",
  "title": "Cargo resolve why \u2014 unification scope report",
  "type": "object",
  "required": [
    "schema_version",
    "unification_mode",
    "selected_packages",
    "participating_packages",
    "effects",
    "overall_exactness"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "unification_mode": {
      "type": "string",
      "enum": [
        "selected",
        "workspace",
        "package",
        "manual_review_required"
      ]
    },
    "selected_packages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "participating_packages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "effect_kind",
          "subject_package",
          "summary",
          "exactness"
        ],
        "properties": {
          "effect_kind": {
            "type": "string",
            "enum": [
              "workspace_wide_pressure",
              "out_of_selection_influence",
              "duplicate_build_preference",
              "manual_review_required"
            ]
          },
          "subject_package": {
            "type": "string"
          },
          "source_members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "evidence_basis": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cargo_metadata",
                "cargo_tree_features",
                "unit_graph",
                "manual_manifest_scan",
                "issue_repro",
                "conservative_inference"
              ]
            }
          },
          "exactness": {
            "type": "string",
            "enum": [
              "exact",
              "conservative",
              "manual_review_required"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "overall_exactness": {
      "type": "string",
      "enum": [
        "exact",
        "conservative",
        "manual_review_required"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
