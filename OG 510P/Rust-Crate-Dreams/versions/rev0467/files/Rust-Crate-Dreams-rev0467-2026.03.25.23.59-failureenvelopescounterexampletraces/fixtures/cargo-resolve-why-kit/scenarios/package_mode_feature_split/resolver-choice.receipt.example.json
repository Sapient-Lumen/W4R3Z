{
  "schema_version": "0.1.0",
  "command": ["cargo", "+nightly", "resolve-why", "capture", "-Z", "feature-unification"],
  "cargo": {
    "version": "1.86.0-nightly",
    "resolver_version": "3",
    "feature_unification_mode": "package"
  },
  "data_sources": ["cargo_metadata", "cargo_tree_duplicates", "unit_graph", "conservative_inference"],
  "assumptions": [
    "duplicate build grouping reused host/target classification from the unit graph",
    "feature split attribution is conservative when Cargo does not expose every solver branch"
  ],
  "manual_review_required": false,
  "redactions": {
    "private_paths": true,
    "private_package_names": false
  }
}
