{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-resolve-why/feature-intent.report.schema.json",
  "title": "Cargo resolve why \u2014 feature intent report",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "observations",
    "overall_exactness"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "subject_kind",
        "subject_name"
      ],
      "properties": {
        "subject_kind": {
          "type": "string",
          "enum": [
            "workspace",
            "package",
            "bin",
            "example",
            "test",
            "custom"
          ]
        },
        "subject_name": {
          "type": "string"
        },
        "selected_packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dependency_package",
          "intent_kind",
          "effective_state",
          "exactness"
        ],
        "properties": {
          "dependency_package": {
            "type": "string"
          },
          "feature_name": {
            "type": "string"
          },
          "intent_kind": {
            "type": "string",
            "enum": [
              "request_enable_feature",
              "request_disable_default_features",
              "request_disable_named_feature",
              "request_no_default_features_for_subject",
              "no_explicit_intent"
            ]
          },
          "intent_source": {
            "type": "string",
            "enum": [
              "manifest_dependency",
              "workspace_command_flag",
              "selected_package_flag",
              "inferred_subject_scope"
            ]
          },
          "effective_state": {
            "type": "string",
            "enum": [
              "honored",
              "active_due_to_other_request",
              "inactive",
              "manual_review_required"
            ]
          },
          "influencing_packages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "evidence_basis": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cargo_metadata",
                "cargo_tree_features",
                "unit_graph",
                "manual_manifest_scan",
                "issue_repro",
                "conservative_inference"
              ]
            }
          },
          "exactness": {
            "type": "string",
            "enum": [
              "exact",
              "conservative",
              "manual_review_required"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "overall_exactness": {
      "type": "string",
      "enum": [
        "exact",
        "conservative",
        "manual_review_required"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
