{
  "schema_version": "0.1.0",
  "command": ["cargo", "check", "--workspace"],
  "cargo": {
    "version": "1.90.0",
    "resolver_version": "3",
    "incompatible_rust_versions": "fallback"
  },
  "data_sources": [
    "cargo_metadata",
    "lockfile_diff",
    "manual_manifest_scan",
    "conservative_inference"
  ],
  "build_equivalence": "not_claimed",
  "selection_scope": {
    "command_kind": "check",
    "workspace_members": ["a", "b"],
    "targets": ["host"]
  },
  "assumptions": [
    "the receipt is summarizing Cargo-documented MSRV heuristics, not replaying every rejected solver branch"
  ],
  "unknowns": [
    "Cargo did not emit an exact list of all alternative versions considered and rejected"
  ],
  "manual_review_required": false,
  "redactions": {
    "private_paths": true,
    "private_package_names": false
  }
}
