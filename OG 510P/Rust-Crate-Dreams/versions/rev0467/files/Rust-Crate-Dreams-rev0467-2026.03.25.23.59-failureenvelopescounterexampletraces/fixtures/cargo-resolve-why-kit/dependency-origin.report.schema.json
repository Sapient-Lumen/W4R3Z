{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-resolve-why/dependency-origin.report.schema.json",
  "title": "Cargo resolve why \u2014 dependency origin report",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "dependency_package",
    "manifest_origins",
    "effective_policy",
    "overall_exactness"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "subject_kind",
        "subject_name"
      ],
      "properties": {
        "subject_kind": {
          "type": "string",
          "enum": [
            "workspace",
            "package",
            "bin",
            "example",
            "test",
            "custom"
          ]
        },
        "subject_name": {
          "type": "string"
        },
        "selected_packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "dependency_package": {
      "type": "string"
    },
    "manifest_origins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "origin_kind",
          "manifest_path",
          "table_kind"
        ],
        "properties": {
          "origin_kind": {
            "type": "string",
            "enum": [
              "workspace_dependency",
              "member_dependency",
              "target_specific_member_dependency",
              "conservative_merge"
            ]
          },
          "manifest_path": {
            "type": "string"
          },
          "table_kind": {
            "type": "string",
            "enum": [
              "dependencies",
              "build-dependencies",
              "dev-dependencies",
              "target.dependencies",
              "target.build-dependencies",
              "target.dev-dependencies",
              "workspace.dependencies"
            ]
          },
          "declared_features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default_features_setting": {
            "type": "string",
            "enum": [
              "true",
              "false",
              "unspecified",
              "ignored",
              "manual_review_required"
            ]
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "effective_policy": {
      "type": "object",
      "required": [
        "default_features_effect",
        "feature_merge_mode",
        "summary",
        "exactness"
      ],
      "properties": {
        "default_features_effect": {
          "type": "string",
          "enum": [
            "enabled",
            "disabled",
            "neutralized_by_workspace",
            "reenabled_by_member",
            "manual_review_required"
          ]
        },
        "feature_merge_mode": {
          "type": "string",
          "enum": [
            "additive",
            "target_selected",
            "target_ambiguous",
            "manual_review_required"
          ]
        },
        "summary": {
          "type": "string"
        },
        "evidence_basis": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cargo_metadata",
              "cargo_tree_features",
              "manual_manifest_scan",
              "release_notes",
              "issue_repro",
              "conservative_inference"
            ]
          }
        },
        "exactness": {
          "type": "string",
          "enum": [
            "exact",
            "conservative",
            "manual_review_required"
          ]
        }
      },
      "additionalProperties": false
    },
    "overall_exactness": {
      "type": "string",
      "enum": [
        "exact",
        "conservative",
        "manual_review_required"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
