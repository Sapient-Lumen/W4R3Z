{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-resolve-why/resolver-choice.receipt.schema.json",
  "title": "Cargo resolve why — resolver choice receipt",
  "type": "object",
  "required": ["schema_version", "command", "cargo", "data_sources", "assumptions"],
  "properties": {
    "schema_version": {"type": "string"},
    "command": {
      "type": "array",
      "items": {"type": "string"}
    },
    "cargo": {
      "type": "object",
      "required": ["resolver_version"],
      "properties": {
        "version": {"type": "string"},
        "resolver_version": {"type": "string"},
        "feature_unification_mode": {"type": "string"},
        "incompatible_rust_versions": {"type": "string"}
      },
      "additionalProperties": false
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cargo_metadata",
          "cargo_tree_features",
          "cargo_tree_duplicates",
          "unit_graph",
          "lockfile_diff",
          "manual_manifest_scan",
          "guppy_simulation",
          "conservative_inference"
        ]
      }
    },
    "build_equivalence": {
      "type": "string",
      "enum": [
        "not_claimed",
        "close_approximation",
        "exact_for_selected_command",
        "manual_review_required"
      ]
    },
    "selection_scope": {
      "type": "object",
      "properties": {
        "command_kind": {"type": "string"},
        "workspace_members": {
          "type": "array",
          "items": {"type": "string"}
        },
        "targets": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "unknowns": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"},
    "redactions": {
      "type": "object",
      "properties": {
        "private_paths": {"type": "boolean"},
        "private_package_names": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
