{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/trait-solver-drift-witness-kit/solver-drift.diff.schema.json",
  "title": "Solver Drift Diff",
  "type": "object",
  "required": [
    "schema_version",
    "comparison_id",
    "case_results"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "comparison_id": {
      "type": "string"
    },
    "case_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "drift_class"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "drift_class": {
            "enum": [
              "accepted_to_rejected",
              "rejected_to_accepted",
              "overflow_behavior_changed",
              "diagnostic_only",
              "scope_changed",
              "manual_review_required"
            ]
          },
          "primary_class": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
