{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/trait-solver-drift-witness-kit/comparison-lane.receipt.schema.json",
  "title": "Comparison Lane Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "toolchain",
    "solver_lane",
    "target",
    "release_gate_posture"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "toolchain": {
      "type": "string"
    },
    "channel": {
      "enum": [
        "stable",
        "beta",
        "nightly"
      ]
    },
    "solver_lane": {
      "enum": [
        "legacy_only",
        "coherence_default_only",
        "global_preview",
        "mixed_unknown"
      ]
    },
    "cargo_scope": {
      "enum": [
        "rustc_only",
        "cargo_check",
        "cargo_test",
        "rustdoc",
        "lint",
        "mixed"
      ]
    },
    "target": {
      "type": "string"
    },
    "release_gate_posture": {
      "enum": [
        "authoritative",
        "preview_only",
        "manual_review_required"
      ]
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
