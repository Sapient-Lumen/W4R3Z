{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Build Insights — session series index",
  "type": "object",
  "required": ["schema_version", "series"],
  "properties": {
    "schema_version": {"type": "string"},
    "warehouse_id": {"type": "string"},
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["series_id", "selection_kind", "session_ids"],
        "properties": {
          "series_id": {"type": "string"},
          "selection_kind": {"type": "string", "enum": ["baseline", "head", "range", "branch", "candidate_split"]},
          "session_ids": {"type": "array", "items": {"type": "string"}},
          "branch": {"type": "string"},
          "toolchain_channel": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "comparison_plan": {
      "type": "object",
      "properties": {
        "baseline_series_id": {"type": "string"},
        "head_series_id": {"type": "string"},
        "split_required": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
