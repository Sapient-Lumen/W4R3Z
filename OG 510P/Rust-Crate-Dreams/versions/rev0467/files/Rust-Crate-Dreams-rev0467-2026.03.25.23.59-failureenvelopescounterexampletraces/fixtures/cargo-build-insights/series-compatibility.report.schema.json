{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo Build Insights — series compatibility report",
  "type": "object",
  "required": ["schema_version", "baseline_series_id", "head_series_id", "status", "signals"],
  "properties": {
    "schema_version": {"type": "string"},
    "baseline_series_id": {"type": "string"},
    "head_series_id": {"type": "string"},
    "status": {"type": "string", "enum": ["comparable", "comparable_with_caveats", "split_required", "manual_review_required"]},
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "observed"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["toolchain_changed", "profile_changed", "workspace_scope_changed", "target_triple_changed", "command_shape_changed", "selection_size_shift", "manual_annotation_only"]
          },
          "observed": {"type": "boolean"},
          "detail": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "recommended_action": {"type": "string"}
  },
  "additionalProperties": true
}
