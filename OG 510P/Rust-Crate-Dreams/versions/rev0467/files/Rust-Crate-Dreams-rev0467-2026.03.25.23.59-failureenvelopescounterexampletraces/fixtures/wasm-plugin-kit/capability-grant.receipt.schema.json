{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capability-grant.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "execution_environment",
    "wasi_enabled",
    "filesystem_grant",
    "network_grant",
    "host_function_grant",
    "config_mutability"
  ],
  "properties": {
    "artifact": {"const": "capability-grant.receipt"},
    "subject": {"type": "string"},
    "execution_environment": {
      "enum": ["wasmtime_component", "extism_plugin", "manual_review_required"]
    },
    "wasi_enabled": {
      "enum": ["none", "limited", "full", "manual_review_required"]
    },
    "filesystem_grant": {
      "enum": ["none", "mapped_paths", "unrestricted", "manual_review_required"]
    },
    "network_grant": {
      "enum": ["none", "allowlist", "unrestricted", "manual_review_required"]
    },
    "host_function_grant": {
      "enum": ["none", "narrow_interface", "broad_host_api", "manual_review_required"]
    },
    "config_mutability": {
      "enum": ["host_defined_immutable", "runtime_mutable", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
