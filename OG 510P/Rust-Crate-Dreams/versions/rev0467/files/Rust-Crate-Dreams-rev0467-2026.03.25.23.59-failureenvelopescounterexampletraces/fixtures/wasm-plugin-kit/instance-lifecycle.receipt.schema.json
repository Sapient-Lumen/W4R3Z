{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "instance-lifecycle.receipt",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "instantiation_mode",
    "state_persistence",
    "teardown_basis",
    "concurrency_posture"
  ],
  "properties": {
    "artifact": {"const": "instance-lifecycle.receipt"},
    "subject": {"type": "string"},
    "instantiation_mode": {
      "enum": ["fresh_per_call", "fresh_per_request", "pooled_reuse", "long_lived_instance", "manual_review_required"]
    },
    "state_persistence": {
      "enum": ["none", "per_instance_ephemeral", "reused_between_calls", "externalized_host_state", "manual_review_required"]
    },
    "teardown_basis": {
      "enum": ["drop_instance", "pool_return", "process_reset", "manual_review_required"]
    },
    "concurrency_posture": {
      "enum": ["single_threaded_plugin", "host_pool_serialized", "host_parallel_multi_instance", "manual_review_required"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
