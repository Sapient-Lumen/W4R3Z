{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/clippy-safety-profile-waiver-kit/checked-scope.matrix.schema.json",
  "title": "Checked Scope Matrix",
  "type": "object",
  "required": [
    "schema_version",
    "workspace",
    "toolchain",
    "cells"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "toolchain": {
      "type": "string"
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package",
          "target",
          "feature_mode",
          "tests",
          "private_items",
          "executed"
        ],
        "properties": {
          "package": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "feature_mode": {
            "enum": [
              "default",
              "all_features",
              "no_default_features",
              "named_set"
            ]
          },
          "named_features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "boolean"
          },
          "private_items": {
            "type": "boolean"
          },
          "executed": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
