{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/clippy-safety-profile-waiver-kit/policy-authority.receipt.schema.json",
  "title": "Policy Authority Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "workspace",
    "tool",
    "lint",
    "effective_level",
    "authority_source"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "package": {
      "type": "string"
    },
    "tool": {
      "enum": [
        "rust",
        "clippy",
        "cargo"
      ]
    },
    "lint": {
      "type": "string"
    },
    "effective_level": {
      "enum": [
        "forbid",
        "deny",
        "warn",
        "allow",
        "advisory"
      ]
    },
    "priority": {
      "type": "integer"
    },
    "authority_source": {
      "enum": [
        "workspace_lints",
        "package_lints",
        "clippy_toml",
        "inline_attribute",
        "imported_policy",
        "nightly_cargo_lints",
        "unknown"
      ]
    },
    "override_chain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
