{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persistence Compatibility Authority Policy",
  "type": "object",
  "required": [
    "schema_version",
    "authority_classes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "authority_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "minimum_evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "stable_external_spec",
              "schema_snapshot_guarded",
              "revision_history_guarded",
              "engine_documented_contract",
              "serde_shape_best_effort",
              "manual_review_required",
              "unknown"
            ]
          },
          "minimum_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
