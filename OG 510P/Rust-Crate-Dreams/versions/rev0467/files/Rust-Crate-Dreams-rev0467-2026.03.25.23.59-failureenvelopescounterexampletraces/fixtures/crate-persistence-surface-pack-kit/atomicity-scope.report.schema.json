{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persistence Atomicity Scope Report",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "surface",
    "scope_class"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "surface": {
      "type": "string"
    },
    "scope_class": {
      "type": "string",
      "enum": [
        "no_intermediate_state_only",
        "destination_replace_same_mount",
        "data_synced_without_directory_entry",
        "fully_synced_local_publish",
        "transactionally_committed",
        "remote_ack_only",
        "manual_review_required"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "rename_used",
          "same_mount_required",
          "sync_data_called",
          "sync_all_called",
          "directory_sync_observed",
          "transaction_commit_observed",
          "remote_ack_observed",
          "manual_review_required"
        ]
      }
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
