{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FormatCompatReport",
  "type": "object",
  "required": [
    "surface",
    "format_class",
    "compatibility_window",
    "verdict"
  ],
  "properties": {
    "surface": {
      "type": "string"
    },
    "format_class": {
      "type": "string"
    },
    "compatibility_window": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "compatible_as_declared",
        "migration_required",
        "internal_only",
        "manual_review_required"
      ]
    }
  }
}