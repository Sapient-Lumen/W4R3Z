{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persistence Failure Model Profile",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "surface",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "surface": {
      "type": "string"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "clean_shutdown_only",
          "process_crash",
          "os_crash",
          "power_loss",
          "partial_write",
          "external_modification",
          "manual_review_required"
        ]
      }
    },
    "recovery_expectation": {
      "type": "string",
      "enum": [
        "automatic_recovery",
        "repair_tool_available",
        "restore_from_backup",
        "discard_and_rebuild",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
