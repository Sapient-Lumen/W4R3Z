{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersistenceCheckReport",
  "type": "object",
  "required": [
    "crate",
    "status",
    "checks"
  ],
  "properties": {
    "crate": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "manual_review_required"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}