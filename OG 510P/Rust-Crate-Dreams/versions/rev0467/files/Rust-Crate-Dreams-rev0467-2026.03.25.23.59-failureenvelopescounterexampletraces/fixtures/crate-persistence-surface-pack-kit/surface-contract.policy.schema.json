{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persistence Surface Contract Policy",
  "type": "object",
  "required": [
    "schema_version",
    "contract_levels"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "minimum_evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "public_contract",
              "soft_contract",
              "rebuildable_cache",
              "internal_only",
              "manual_review_required",
              "unknown"
            ]
          },
          "minimum_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
