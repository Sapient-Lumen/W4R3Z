{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersistencePack",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "surfaces"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "surface_kind",
          "contract_level",
          "format_class",
          "durability_boundary",
          "recovery_posture",
          "compatibility_window"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "surface_kind": {
            "enum": [
              "config_file",
              "snapshot",
              "wal_or_journal",
              "embedded_db",
              "cache",
              "wire_message",
              "export_file",
              "manual_review_required"
            ]
          },
          "contract_level": {
            "enum": [
              "public_contract",
              "soft_contract",
              "internal_only"
            ]
          },
          "format_class": {
            "enum": [
              "schema_described",
              "version_tagged",
              "stable_wire_spec",
              "opaque_binary",
              "best_effort_serde_shape",
              "manual_review_required"
            ]
          },
          "durability_boundary": {
            "enum": [
              "memory_only",
              "userspace_buffer_only",
              "os_visible",
              "data_synced",
              "metadata_synced",
              "transaction_committed",
              "remote_acked",
              "manual_review_required"
            ]
          },
          "recovery_posture": {
            "enum": [
              "stateless_retry",
              "replay_journal",
              "copy_on_write_recover",
              "restore_from_backup",
              "discard_and_rebuild",
              "manual_repair",
              "manual_review_required"
            ]
          },
          "compatibility_window": {
            "enum": [
              "same_patch",
              "same_minor",
              "same_major",
              "explicit_revision_window",
              "best_effort",
              "internal_only",
              "manual_review_required"
            ]
          }
        }
      }
    }
  }
}