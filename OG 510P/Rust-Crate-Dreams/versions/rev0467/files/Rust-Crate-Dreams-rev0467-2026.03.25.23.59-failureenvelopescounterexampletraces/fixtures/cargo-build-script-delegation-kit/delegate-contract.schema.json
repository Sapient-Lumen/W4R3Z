{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DelegateContract",
  "type": "object",
  "required": [
    "workspace_root",
    "delegate_units",
    "parameter_sources",
    "fallback_mode"
  ],
  "properties": {
    "workspace_root": {"type": "string"},
    "delegate_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "phase", "execution_mode"],
        "properties": {
          "name": {"type": "string"},
          "phase": {"type": "string"},
          "execution_mode": {"type": "string"},
          "package": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "parameter_sources": {
      "type": "array",
      "items": {"type": "string"}
    },
    "fallback_mode": {"type": "string"},
    "nightly_required": {"type": "boolean"}
  },
  "additionalProperties": true
}
