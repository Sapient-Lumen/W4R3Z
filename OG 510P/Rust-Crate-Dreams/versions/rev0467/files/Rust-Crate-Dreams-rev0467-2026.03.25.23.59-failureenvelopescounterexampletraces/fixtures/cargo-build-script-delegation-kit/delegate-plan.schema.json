{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DelegatePlan",
  "type": "object",
  "required": ["ordered_units", "parameter_bindings"],
  "properties": {
    "ordered_units": {
      "type": "array",
      "items": {"type": "string"}
    },
    "parameter_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "parameter", "source"],
        "properties": {
          "unit": {"type": "string"},
          "parameter": {"type": "string"},
          "source": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "artifact_bridge_mode": {"type": "string"}
  },
  "additionalProperties": true
}
