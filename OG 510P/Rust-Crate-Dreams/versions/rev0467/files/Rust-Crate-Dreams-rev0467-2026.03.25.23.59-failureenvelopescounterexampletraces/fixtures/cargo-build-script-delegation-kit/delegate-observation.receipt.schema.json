{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DelegateObservationReceipt",
  "type": "object",
  "required": ["observation_origin", "units_observed"],
  "properties": {
    "observation_origin": {"type": "string"},
    "units_observed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string"},
          "status": {"type": "string"},
          "out_dir": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "metadata_env": {
      "type": "array",
      "items": {"type": "string"}
    },
    "artifact_handoff": {"type": "string"}
  },
  "additionalProperties": true
}
