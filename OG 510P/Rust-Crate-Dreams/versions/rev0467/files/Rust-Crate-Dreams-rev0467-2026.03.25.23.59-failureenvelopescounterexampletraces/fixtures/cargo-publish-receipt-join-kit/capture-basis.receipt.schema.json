{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo publish receipt capture-basis receipt",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "package",
    "version",
    "artifact_basis",
    "artifact_residency",
    "digest_basis",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "scenario": {"type": "string"},
    "package": {"type": "string"},
    "version": {"type": "string"},
    "artifact_basis": {
      "enum": [
        "cargo_package_output",
        "cargo_publish_dry_run_output",
        "cargo_publish_intermediate_artifact",
        "imported_ci_artifact",
        "registry_download_reacquired",
        "manual_review_required"
      ]
    },
    "artifact_residency": {
      "enum": [
        "final_artifact_present",
        "intermediate_only",
        "missing_after_publish",
        "rehydrated_from_registry",
        "manual_review_required"
      ]
    },
    "digest_basis": {
      "enum": [
        "local_tarball_digest",
        "downloaded_tarball_digest",
        "registry_checksum_only",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
