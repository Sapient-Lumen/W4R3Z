{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo publish receipt publication-visibility report",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "package",
    "version",
    "index_state",
    "docsrs_state",
    "consumer_readiness",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "scenario": {"type": "string"},
    "package": {"type": "string"},
    "version": {"type": "string"},
    "index_state": {
      "enum": [
        "upload_ack_only",
        "poll_timed_out",
        "index_visible",
        "index_missing",
        "manual_review_required"
      ]
    },
    "docsrs_state": {
      "enum": [
        "queued_or_pending",
        "built",
        "failed",
        "not_checked",
        "manual_review_required"
      ]
    },
    "consumer_readiness": {
      "enum": [
        "cargo_resolution_ready",
        "cargo_ready_docs_pending",
        "public_docs_ready",
        "visibility_partial_manual_review_required",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
