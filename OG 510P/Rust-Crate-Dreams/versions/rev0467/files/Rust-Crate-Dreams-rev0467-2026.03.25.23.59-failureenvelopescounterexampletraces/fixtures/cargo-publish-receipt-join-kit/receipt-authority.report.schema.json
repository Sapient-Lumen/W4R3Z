{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cargo publish receipt authority report",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "package",
    "version",
    "artifact_authority",
    "index_authority",
    "identity_authority",
    "visibility_authority",
    "receipt_completeness",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "scenario": {"type": "string"},
    "package": {"type": "string"},
    "version": {"type": "string"},
    "artifact_authority": {
      "enum": [
        "direct_local_artifact",
        "imported_ci_artifact",
        "registry_download_reacquired",
        "missing",
        "manual_review_required"
      ]
    },
    "index_authority": {
      "enum": [
        "checksum_and_pubtime_authoritative",
        "checksum_only_authoritative",
        "not_observed",
        "manual_review_required"
      ]
    },
    "identity_authority": {
      "enum": [
        "explicit_trusted_publisher_receipt",
        "coarse_ci_inference",
        "manual_or_token_claim_only",
        "unknown",
        "manual_review_required"
      ]
    },
    "visibility_authority": {
      "enum": [
        "index_authoritative_docs_nonblocking",
        "docs_visible_after_index",
        "upload_ack_only_no_authoritative_visibility",
        "manual_review_required"
      ]
    },
    "receipt_completeness": {
      "enum": [
        "local_and_index_authoritative",
        "index_authoritative_local_missing",
        "local_only_pending_index",
        "partial_authority_only",
        "manual_review_required"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
