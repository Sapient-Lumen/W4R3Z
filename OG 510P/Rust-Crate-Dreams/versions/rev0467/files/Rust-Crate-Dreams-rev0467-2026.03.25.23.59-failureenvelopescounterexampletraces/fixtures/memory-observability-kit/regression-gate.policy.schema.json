{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "regression-gate.policy",
  "type": "object",
  "required": ["scenario", "gate_class", "metrics"],
  "properties": {
    "scenario": { "type": "string" },
    "gate_class": {
      "type": "string",
      "enum": [
        "ci_blocking",
        "release_review",
        "comparative_only",
        "manual_review_required"
      ]
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "peak_rss_bytes",
          "live_bytes_after_phase",
          "alloc_count",
          "bytes_allocated_total",
          "heap_dump_growth_factor"
        ]
      },
      "minItems": 1
    },
    "thresholds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "backend_requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
