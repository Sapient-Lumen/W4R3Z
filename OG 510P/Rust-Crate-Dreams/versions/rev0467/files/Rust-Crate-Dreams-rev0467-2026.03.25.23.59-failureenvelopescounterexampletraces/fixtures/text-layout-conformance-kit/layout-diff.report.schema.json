{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "layout diff report",
  "type": "object",
  "required": ["base", "candidate", "differences", "summary"],
  "properties": {
    "base": {"type": "string"},
    "candidate": {"type": "string"},
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "severity"],
        "properties": {
          "kind": {"type": "string", "enum": ["line_count", "break_selection", "glyph_run_family", "cluster_map", "advance_delta", "fallback_decision", "bidi_order", "non_comparable"]},
          "severity": {"type": "string", "enum": ["info", "warn", "error"]},
          "details": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["same", "different", "manual_review"]},
        "suspected_family": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
