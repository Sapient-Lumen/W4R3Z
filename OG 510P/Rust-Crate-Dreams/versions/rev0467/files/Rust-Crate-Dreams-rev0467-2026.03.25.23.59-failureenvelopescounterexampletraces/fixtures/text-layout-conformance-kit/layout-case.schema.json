{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "layout case",
  "type": "object",
  "required": [
    "id",
    "text",
    "locale",
    "script",
    "paragraph_direction",
    "constraints"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "script": {
      "type": "string"
    },
    "paragraph_direction": {
      "type": "string",
      "enum": [
        "ltr",
        "rtl",
        "auto"
      ]
    },
    "unicode_profile": {
      "type": "string"
    },
    "constraints": {
      "type": "object",
      "required": [
        "max_inline_advance_px"
      ],
      "properties": {
        "max_inline_advance_px": {
          "type": "number"
        },
        "line_height_px": {
          "type": "number"
        },
        "soft_wrap": {
          "type": "boolean"
        },
        "emergency_break": {
          "type": "string",
          "enum": [
            "never",
            "overflow_only",
            "always"
          ]
        }
      },
      "additionalProperties": false
    },
    "font_request": {
      "type": "object",
      "properties": {
        "families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallback_mode": {
          "type": "string",
          "enum": [
            "strict",
            "browser_like",
            "backend_default"
          ]
        }
      },
      "additionalProperties": false
    },
    "style_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "range",
          "font_size_px"
        ],
        "properties": {
          "range": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "font_size_px": {
            "type": "number"
          },
          "weight": {
            "type": "integer"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "comparison_goal": {
      "type": "string",
      "enum": [
        "unicode_default",
        "backend_compare",
        "manual_review"
      ]
    },
    "profile_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
