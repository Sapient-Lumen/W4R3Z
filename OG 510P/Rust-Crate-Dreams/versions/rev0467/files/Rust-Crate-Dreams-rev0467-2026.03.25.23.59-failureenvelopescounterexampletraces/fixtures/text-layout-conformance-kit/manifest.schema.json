{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "textlayoutbundle manifest",
  "type": "object",
  "required": ["format", "version", "case", "runner", "artifacts", "verdict"],
  "properties": {
    "format": {"const": "textlayoutbundle"},
    "version": {"type": "string", "pattern": "^0\\.[0-9]+$"},
    "case": {
      "type": "object",
      "required": ["id", "locale", "script"],
      "properties": {
        "id": {"type": "string"},
        "locale": {"type": "string"},
        "script": {"type": "string"},
        "comparison_goal": {"type": "string", "enum": ["unicode_default", "backend_compare", "manual_review"]}
      }
    },
    "runner": {
      "type": "object",
      "required": ["lane", "backend", "exactness_lane"],
      "properties": {
        "lane": {"type": "string"},
        "backend": {"type": "string"},
        "backend_version": {"type": "string"},
        "exactness_lane": {"type": "string", "enum": ["unicode_default", "backend_tailored", "font_universe_variant", "manual_review_only", "render_overlay_only"]}
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "layout_case": {"type": "string"},
        "layout_profile": {"type": "string"},
        "fontset_lock": {"type": "string"},
        "corpus_import": {"type": "string"},
        "backend_capability": {"type": "string"},
        "font_resolution": {"type": "string"},
        "decision_origin": {"type": "string"},
        "layout_output": {"type": "string"},
        "layout_diff": {"type": "string"},
        "diagnosis": {"type": "string"}
      },
      "additionalProperties": false
    },
    "verdict": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["pass", "fail", "manual_review"]},
        "family": {"type": "string"},
        "comparable": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
