{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "corpus import receipt",
  "type": "object",
  "required": ["source_family", "source_url", "source_version", "imported_at", "normalization_steps"],
  "properties": {
    "source_family": {"type": "string", "enum": ["unicode", "harfbuzz", "wpt", "rust_regression"]},
    "source_url": {"type": "string", "format": "uri"},
    "source_version": {"type": "string"},
    "imported_at": {"type": "string"},
    "normalization_steps": {"type": "array", "items": {"type": "string"}},
    "loss_notes": {"type": "array", "items": {"type": "string"}},
    "derived_case_ids": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
