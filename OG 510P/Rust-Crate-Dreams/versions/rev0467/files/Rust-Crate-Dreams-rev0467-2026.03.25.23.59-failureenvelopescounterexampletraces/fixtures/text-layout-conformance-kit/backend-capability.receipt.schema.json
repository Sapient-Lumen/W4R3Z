{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "backend capability receipt",
  "type": "object",
  "required": [
    "backend",
    "version",
    "shaping",
    "segmentation",
    "fallback",
    "exactness_lane"
  ],
  "properties": {
    "backend": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "shaping": {
      "type": "string"
    },
    "segmentation": {
      "type": "string"
    },
    "fallback": {
      "type": "string"
    },
    "bidi": {
      "type": "string"
    },
    "metrics_source": {
      "type": "string"
    },
    "exactness_lane": {
      "type": "string",
      "enum": [
        "unicode_default",
        "backend_tailored",
        "font_universe_variant",
        "manual_review_only",
        "render_overlay_only"
      ]
    },
    "advisory_only": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported_profile_axes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_discretion_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
