{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "layout profile",
  "type": "object",
  "required": [
    "id",
    "unicode_version",
    "uax14_revision",
    "uax29_revision",
    "wrap_policy_lane",
    "line_break_mode",
    "word_break_mode",
    "overflow_wrap_mode",
    "emoji_presentation",
    "fallback_policy"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "unicode_version": {
      "type": "string"
    },
    "uax14_revision": {
      "type": "string"
    },
    "uax29_revision": {
      "type": "string"
    },
    "wrap_policy_lane": {
      "type": "string",
      "enum": [
        "unicode_default",
        "css_text_like",
        "toolkit_tailored",
        "editor_tailored"
      ]
    },
    "line_break_mode": {
      "type": "string",
      "enum": [
        "auto",
        "loose",
        "normal",
        "strict",
        "anywhere"
      ]
    },
    "word_break_mode": {
      "type": "string",
      "enum": [
        "normal",
        "break_all",
        "keep_all"
      ]
    },
    "overflow_wrap_mode": {
      "type": "string",
      "enum": [
        "normal",
        "anywhere"
      ]
    },
    "grapheme_safe_breaks": {
      "type": "boolean"
    },
    "emoji_presentation": {
      "type": "string",
      "enum": [
        "text_preferred",
        "emoji_preferred",
        "text_stream_selects",
        "backend_default"
      ]
    },
    "fallback_policy": {
      "type": "string",
      "enum": [
        "strict",
        "browser_like",
        "backend_default",
        "platform_default"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
