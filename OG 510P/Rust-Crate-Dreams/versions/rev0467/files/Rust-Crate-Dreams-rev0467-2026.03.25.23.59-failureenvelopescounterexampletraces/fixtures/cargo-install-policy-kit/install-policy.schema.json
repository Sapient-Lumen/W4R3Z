{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstallPolicy",
  "type": "object",
  "required": ["lockfile_mode", "allowed_sources"],
  "properties": {
    "lockfile_mode": {"type": "string"},
    "allowed_sources": {
      "type": "array",
      "items": {"type": "string"}
    },
    "minimum_publish_age_hours": {"type": ["integer", "null"], "minimum": 0},
    "require_tracking": {"type": "boolean"}
  },
  "additionalProperties": true
}
