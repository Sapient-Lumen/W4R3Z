{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cargo-lock-contention/process-role.snapshot.schema.json",
  "title": "Cargo lock contention — process role snapshot",
  "type": "object",
  "required": ["schema_version", "observed_roles"],
  "properties": {
    "schema_version": {"type": "string"},
    "observed_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "confidence"],
        "properties": {
          "role": {"type": "string", "enum": ["editor_check", "manual_build", "test_runner", "doc_build", "proc_macro_bootstrap", "ci_job", "dependency_fetch", "unknown_process"]},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "path_policy": {"type": "string", "enum": ["literal", "redacted", "omitted"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
