{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mitigation-cost.report",
  "type": "object",
  "required": [
    "recommendation",
    "costs"
  ],
  "properties": {
    "recommendation": {
      "type": "string"
    },
    "costs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class",
          "summary"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "severity": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_review_required": {
      "type": "boolean"
    }
  }
}
