{
  "actor": "editor_check",
  "command_family": "rust_analyzer_override_command",
  "argv": [
    "cargo",
    "check",
    "--workspace",
    "--message-format=json",
    "--all-targets"
  ],
  "scope": "workspace_all_targets",
  "invocation_strategy": "per_workspace",
  "compile_time_only": false,
  "wrapper_mode": "default_or_unknown",
  "notes": [
    "broader than single-package manual build"
  ]
}
