{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "residual-contention.report",
  "type": "object",
  "required": [
    "baseline_bundle",
    "current_bundle",
    "residual_classes"
  ],
  "properties": {
    "baseline_bundle": { "type": "string" },
    "current_bundle": { "type": "string" },
    "residual_classes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "original_wait_outcome": { "type": ["string", "null"] },
    "supporting_facts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "manual_review_required": { "type": "boolean" }
  }
}
