{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification Campaign Diff Report",
  "type": "object",
  "required": [
    "left_campaign_id",
    "right_campaign_id",
    "comparability",
    "changes"
  ],
  "properties": {
    "left_campaign_id": {
      "type": "string"
    },
    "right_campaign_id": {
      "type": "string"
    },
    "comparability": {
      "type": "object",
      "required": [
        "verdict"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "full",
            "partial",
            "not-comparable"
          ]
        },
        "blocking_dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "summary"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "obligation_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
