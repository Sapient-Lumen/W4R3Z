{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification Campaign Bundle",
  "type": "object",
  "required": [
    "manifest",
    "obligations",
    "lane_results",
    "trust_ledger",
    "policy_evaluation"
  ],
  "properties": {
    "manifest": {
      "type": "string"
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lane_results": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trust_ledger": {
      "type": "string"
    },
    "policy_evaluation": {
      "type": "string"
    },
    "campaign_diff": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  }
}
