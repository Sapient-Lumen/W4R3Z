{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification Campaign Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "subject",
    "policy_id",
    "lanes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "policy_id": {
      "type": "string"
    },
    "toolchain": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "obligation_inventory": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trust_ledger": {
      "type": "string"
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lane_id",
          "tool_family",
          "evidence_kind"
        ],
        "properties": {
          "lane_id": {
            "type": "string"
          },
          "tool_family": {
            "type": "string"
          },
          "tool_version": {
            "type": "string"
          },
          "evidence_kind": {
            "type": "string"
          },
          "soundness_scope": {
            "type": "string"
          }
        }
      }
    },
    "comparability_context": {
      "type": "object"
    }
  }
}
