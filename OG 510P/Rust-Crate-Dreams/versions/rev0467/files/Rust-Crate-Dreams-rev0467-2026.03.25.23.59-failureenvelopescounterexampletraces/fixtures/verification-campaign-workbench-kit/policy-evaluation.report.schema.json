{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification Campaign Policy Evaluation Report",
  "type": "object",
  "required": [
    "policy_id",
    "decision",
    "reasons"
  ],
  "properties": {
    "policy_id": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "green",
        "yellow",
        "red"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocking_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_evidence_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "new_trust_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comparability_note": {
      "type": "string"
    }
  }
}
