{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/tool-route.receipt.schema.json",
  "title": "tool-route.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "requested_command",
    "resolved_executable",
    "route_class",
    "selection_basis",
    "rustup_context",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "requested_command": {
      "type": "string"
    },
    "resolved_executable": {
      "type": "string"
    },
    "route_class": {
      "type": "string",
      "enum": [
        "workspace_root_bin",
        "cargo_home_bin",
        "other_path_entry",
        "explicit_wrapper",
        "manual_binary",
        "unknown"
      ]
    },
    "selection_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_identity": {
      "type": "object"
    },
    "install_root_class": {
      "type": "string"
    },
    "shadowing_candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rustup_context": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "default",
            "directory_override",
            "toolchain_file",
            "cli_plus",
            "unknown"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "manual_review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
