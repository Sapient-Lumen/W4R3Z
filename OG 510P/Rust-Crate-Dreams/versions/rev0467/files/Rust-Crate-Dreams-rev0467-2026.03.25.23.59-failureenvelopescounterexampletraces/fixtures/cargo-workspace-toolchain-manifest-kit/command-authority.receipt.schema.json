{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/command-authority.receipt.schema.json",
  "title": "command-authority.receipt",
  "type": "object",
  "required": [
    "schema_version",
    "requested_command",
    "authority_class",
    "resolution_route",
    "support_class",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "requested_command": {"type": "string"},
    "authority_class": {
      "type": "string",
      "enum": [
        "rustup_component_proxy",
        "cargo_external_subcommand",
        "workspace_managed_bin",
        "path_fallback",
        "system_package",
        "manual_wrapper",
        "unknown"
      ]
    },
    "resolution_route": {
      "type": "array",
      "items": {"type": "string"}
    },
    "authoritative_source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "rustup_proxy_table",
            "cargo_external_tool_resolution",
            "workspace_manifest_lock",
            "path_observation",
            "manual_configuration",
            "unknown"
          ]
        },
        "ref": {"type": "string"}
      },
      "additionalProperties": true
    },
    "component_claim": {
      "type": "object",
      "properties": {
        "component_name": {"type": "string"},
        "toolchain_selector": {"type": "string"},
        "installed_state": {
          "type": "string",
          "enum": ["installed", "missing", "not_applicable", "unknown"]
        },
        "provenance": {
          "type": "string",
          "enum": ["rustup_show", "rustup_component_list", "path_only", "mixed", "unknown"]
        }
      },
      "additionalProperties": true
    },
    "support_class": {
      "type": "string",
      "enum": [
        "component_backed",
        "subcommand_backed",
        "workspace_backed",
        "path_fallback_only",
        "mixed_manual_review",
        "unknown"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": true
}
