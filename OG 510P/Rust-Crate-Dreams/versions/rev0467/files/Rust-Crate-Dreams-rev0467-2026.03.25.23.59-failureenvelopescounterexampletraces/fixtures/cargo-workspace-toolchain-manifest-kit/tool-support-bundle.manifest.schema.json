{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/tool-support-bundle.manifest.schema.json",
  "title": "tool-support-bundle.manifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "artifacts",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "bundle_id": {"type": "string"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "properties": {
          "kind": {"type": "string"},
          "path": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "summary": {"type": "string"},
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": true
}
