{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/fallback-ceiling.report.schema.json",
  "title": "fallback-ceiling.report",
  "type": "object",
  "required": [
    "schema_version",
    "requested_command",
    "strongest_honest_claim",
    "ceiling_reasons",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "requested_command": {"type": "string"},
    "strongest_honest_claim": {
      "type": "string",
      "enum": [
        "tool_available_as_requested",
        "workspace_declares_tool_but_route_not_proven",
        "component_missing_path_fallback_observed",
        "command_ran_but_component_parity_unproven",
        "manual_review_required"
      ]
    },
    "route_observed": {"type": "string"},
    "component_parity": {
      "type": "string",
      "enum": [
        "same_toolchain_component",
        "different_toolchain_or_unknown",
        "not_component_backed",
        "unknown"
      ]
    },
    "ceiling_reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "confidence_class": {
      "type": "string",
      "enum": ["high", "medium", "low", "manual_review_required"]
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": true
}
