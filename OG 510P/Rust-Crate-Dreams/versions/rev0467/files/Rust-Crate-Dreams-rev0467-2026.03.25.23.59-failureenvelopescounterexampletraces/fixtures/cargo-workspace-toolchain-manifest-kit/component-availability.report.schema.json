{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/schemas/component-availability.report.schema.json",
  "title": "component-availability.report",
  "type": "object",
  "required": [
    "schema_version",
    "requested_command",
    "toolchain_context",
    "availability_state",
    "fallback_policy",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "requested_command": {"type": "string"},
    "expected_component": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "required_by_policy": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "toolchain_context": {
      "type": "object",
      "required": ["selection_kind", "value"],
      "properties": {
        "selection_kind": {
          "type": "string",
          "enum": [
            "default",
            "directory_override",
            "toolchain_file",
            "cli_plus",
            "env_override",
            "unknown"
          ]
        },
        "value": {"type": "string"}
      },
      "additionalProperties": true
    },
    "availability_state": {
      "type": "string",
      "enum": [
        "installed",
        "available_but_not_installed",
        "missing_for_toolchain",
        "not_a_component_command",
        "unknown"
      ]
    },
    "check_basis": {
      "type": "array",
      "items": {"type": "string"}
    },
    "host_platform": {"type": "string"},
    "fallback_policy": {
      "type": "string",
      "enum": [
        "forbid_fallback",
        "allow_path_fallback",
        "allow_workspace_override",
        "not_applicable",
        "manual_review_required"
      ]
    },
    "observed_fallback_route": {
      "type": "string",
      "enum": [
        "none",
        "path_binary",
        "cargo_home_bin",
        "workspace_root_bin",
        "system_package",
        "unknown"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manual_review_required": {"type": "boolean"}
  },
  "additionalProperties": true
}
