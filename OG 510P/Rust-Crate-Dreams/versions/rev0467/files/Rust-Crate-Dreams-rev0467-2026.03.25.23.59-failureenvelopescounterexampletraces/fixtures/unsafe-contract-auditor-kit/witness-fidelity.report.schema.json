{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/unsafe-contract-auditor-kit/witness-fidelity.report.schema.json",
  "title": "Witness Fidelity Report",
  "type": "object",
  "required": [
    "schema_version",
    "witness_kind",
    "verdict",
    "evidence_strength",
    "non_claims"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "witness_kind": {
      "type": "string",
      "enum": [
        "miri",
        "loom",
        "other"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "partial",
        "not_run"
      ]
    },
    "evidence_strength": {
      "type": "string",
      "enum": [
        "strong_for_claimed_scope",
        "advisory",
        "weak",
        "manual_review_required"
      ]
    },
    "non_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comparison_eligible": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
