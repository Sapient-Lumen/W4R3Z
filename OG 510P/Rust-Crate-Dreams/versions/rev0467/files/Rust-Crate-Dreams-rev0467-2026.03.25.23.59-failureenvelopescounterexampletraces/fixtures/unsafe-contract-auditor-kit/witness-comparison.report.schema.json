{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/unsafe-contract-auditor-kit/witness-comparison.report.schema.json",
  "title": "Witness Comparison Report",
  "type": "object",
  "required": [
    "schema_version",
    "obligation_id",
    "compared_witnesses",
    "comparability",
    "change_summary",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "obligation_id": {
      "type": "string"
    },
    "compared_witnesses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "witness_kind",
          "tool_version",
          "verdict",
          "evidence_strength"
        ],
        "properties": {
          "witness_kind": {
            "type": "string",
            "enum": [
              "miri",
              "loom",
              "other"
            ]
          },
          "tool_version": {
            "type": "string"
          },
          "target_triple": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "partial",
              "not_run"
            ]
          },
          "evidence_strength": {
            "type": "string",
            "enum": [
              "strong_for_claimed_scope",
              "advisory",
              "weak",
              "manual_review_required"
            ]
          }
        }
      }
    },
    "comparability": {
      "type": "string",
      "enum": [
        "comparable_same_claim_scope",
        "scope_shifted",
        "tool_semantics_shifted",
        "not_comparable"
      ]
    },
    "change_summary": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "verdict_changed",
          "evidence_strength_changed",
          "non_claims_changed",
          "boundary_changed",
          "toolchain_changed",
          "target_changed"
        ]
      }
    },
    "recommended_action": {
      "type": "string"
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
