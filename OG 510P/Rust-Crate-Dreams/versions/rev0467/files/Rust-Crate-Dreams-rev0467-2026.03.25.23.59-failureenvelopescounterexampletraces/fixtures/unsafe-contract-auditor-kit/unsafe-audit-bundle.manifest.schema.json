{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/unsafe-contract-auditor-kit/unsafe-audit-bundle.manifest.schema.json",
  "title": "Unsafe Audit Bundle Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "artifacts",
    "toolchain",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "bundle_id": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "toolchain": {
      "type": "string"
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
