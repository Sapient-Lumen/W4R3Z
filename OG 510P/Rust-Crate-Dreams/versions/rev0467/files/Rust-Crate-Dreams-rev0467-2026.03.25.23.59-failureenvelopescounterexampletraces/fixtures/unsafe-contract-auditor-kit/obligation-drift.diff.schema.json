{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.example/unsafe-contract-auditor-kit/obligation-drift.diff.schema.json",
  "title": "Obligation Drift Diff",
  "type": "object",
  "required": [
    "schema_version",
    "crate_id",
    "comparison_basis",
    "added_obligations",
    "removed_obligations",
    "changed_obligations",
    "manual_review_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate_id": {
      "type": "string"
    },
    "comparison_basis": {
      "type": "string"
    },
    "added_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "removed_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "obligation_id",
          "change_class",
          "semantic_equivalence"
        ],
        "properties": {
          "obligation_id": {
            "type": "string"
          },
          "change_class": {
            "type": "string",
            "enum": [
              "authority_changed",
              "site_moved",
              "site_count_changed",
              "obligation_class_changed",
              "witness_linkage_changed",
              "unresolved_gap_changed",
              "owner_changed"
            ]
          },
          "semantic_equivalence": {
            "type": "string",
            "enum": [
              "proven",
              "plausible_but_manual_review_required",
              "unknown"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
