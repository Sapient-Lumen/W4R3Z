{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coverage-scope.report",
  "type": "object",
  "required": [
    "artifact",
    "subject",
    "generic_coverage",
    "metadata_classes",
    "value_surface"
  ],
  "properties": {
    "artifact": {"const": "coverage-scope.report"},
    "subject": {"type": "string"},
    "generic_coverage": {
      "enum": [
        "declared_type_families",
        "registered_concrete_instantiations_only",
        "serialization_format_projection_only",
        "mixed",
        "manual_review_required"
      ]
    },
    "metadata_classes": {
      "type": "object",
      "required": ["field_names", "docs", "attributes", "generic_parameters", "generic_bounds"],
      "properties": {
        "field_names": {"$ref": "#/$defs/coverage"},
        "docs": {"$ref": "#/$defs/coverage"},
        "attributes": {"$ref": "#/$defs/coverage"},
        "generic_parameters": {"$ref": "#/$defs/coverage"},
        "generic_bounds": {"$ref": "#/$defs/coverage"}
      },
      "additionalProperties": false
    },
    "value_surface": {
      "enum": [
        "type_shape_only",
        "construct_and_peek",
        "runtime_mutation",
        "format_description_only",
        "manual_review_required"
      ]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "coverage": {
      "enum": ["full", "partial", "none", "synthesized", "manual_review_required"]
    }
  },
  "additionalProperties": false
}
