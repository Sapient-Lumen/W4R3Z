{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/crate-example-surface-pack-kit/scenario-coverage.report.schema.json",
  "title": "Scenario coverage report",
  "type": "object",
  "required": ["crate", "scenarios"],
  "properties": {
    "crate": {"type": "string"},
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario", "coverage_class"],
        "properties": {
          "scenario": {"type": "string"},
          "coverage_class": {
            "type": "string",
            "enum": [
              "official_quickstart_present",
              "reference_examples_only",
              "docs_only",
              "manual_review_required",
              "no_honest_path_yet"
            ]
          },
          "official_quickstart": {"type": "string"},
          "blocking_gaps": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
