{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExampleNormalizationProfile",
  "type": "object",
  "required": [
    "crate",
    "rules"
  ],
  "properties": {
    "crate": {"type": "string"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["match_class", "replacement"],
        "properties": {
          "match_class": {
            "enum": [
              "abs_path",
              "temp_dir",
              "home_dir",
              "tcp_port",
              "uuid",
              "timestamp",
              "api_token",
              "manual_review_required"
            ]
          },
          "scope": {
            "enum": [
              "stdout",
              "stderr",
              "generated_file",
              "docs_render",
              "manual_review_required"
            ]
          },
          "replacement": {"type": "string"}
        }
      }
    }
  }
}
