{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-crate-dreams.invalid/crate-example-surface-pack-kit/prerequisite-origin.receipt.schema.json",
  "title": "Prerequisite origin receipt",
  "type": "object",
  "required": ["quickstart", "prerequisites"],
  "properties": {
    "quickstart": {"type": "string"},
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "origin_class", "review_status"],
        "properties": {
          "name": {"type": "string"},
          "origin_class": {
            "type": "string",
            "enum": [
              "cargo_manifest",
              "package_metadata_docsrs",
              "readme_text",
              "rustdoc_text",
              "guide_text",
              "example_target_metadata",
              "adapter_fixture",
              "ci_observation",
              "maintainer_assertion",
              "manual_review_required"
            ]
          },
          "source_hint": {"type": "string"},
          "review_status": {
            "type": "string",
            "enum": ["checked", "imported", "manual_review_required"]
          },
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
