{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-example-surface/quickstart-authority.receipt.schema.json",
  "title": "crate example surface quickstart authority receipt",
  "type": "object",
  "required": ["schema_version", "subject", "quickstarts"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "quickstarts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quickstart_id", "authority_kind", "source_ref", "confidence"],
        "properties": {
          "quickstart_id": {"type": "string"},
          "authority_kind": {"type": "string"},
          "source_ref": {"type": "string"},
          "confidence": {"type": "string"},
          "conflicts": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "manual_review_gaps": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
