{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExampleSurfacePack",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "examples"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "crate": {"type": "string"},
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "support_level", "example_kind"],
        "properties": {
          "name": {"type": "string"},
          "support_level": {
            "enum": [
              "official_quickstart",
              "official_reference_example",
              "best_effort_demo",
              "docs_only",
              "manual_review_required"
            ]
          },
          "example_kind": {
            "enum": [
              "readme_snippet",
              "rustdoc_example",
              "cargo_example",
              "guide_walkthrough",
              "ui_example",
              "integration_recipe",
              "manual_review_required"
            ]
          }
        }
      }
    }
  }
}
