{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/crate-example-surface/entrypoint-viability.matrix.schema.json",
  "title": "crate example surface entrypoint viability matrix",
  "type": "object",
  "required": ["schema_version", "subject", "entrypoints"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject": {"type": "string"},
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entrypoint_id", "entrypoint_kind", "lanes"],
        "properties": {
          "entrypoint_id": {"type": "string"},
          "entrypoint_kind": {"type": "string"},
          "lanes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["lane_id", "command_family", "result", "basis"],
              "properties": {
                "lane_id": {"type": "string"},
                "command_family": {"type": "string"},
                "result": {"type": "string"},
                "basis": {"type": "string"},
                "notes": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
