{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExampleOutputReport",
  "type": "object",
  "required": [
    "example",
    "success_signal"
  ],
  "properties": {
    "example": {"type": "string"},
    "success_signal": {
      "enum": [
        "stdout_snapshot",
        "stderr_snapshot",
        "returned_value",
        "generated_file",
        "http_exchange",
        "rendered_doc_example",
        "manual_review_required"
      ]
    }
  }
}
