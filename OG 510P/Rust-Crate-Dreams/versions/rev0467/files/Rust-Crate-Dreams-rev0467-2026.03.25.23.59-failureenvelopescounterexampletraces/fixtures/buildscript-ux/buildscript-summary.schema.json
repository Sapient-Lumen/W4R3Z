{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/buildscript-summary.schema.json",
  "title": "buildscript-summary",
  "type": "object",
  "required": ["schema_version", "headline", "status"],
  "properties": {
    "schema_version": {"type": "string"},
    "headline": {"type": "string"},
    "status": {"enum": ["success", "failure", "warning_only", "manual_review_required"]},
    "capture_origin": {"enum": ["live_capture", "cargo_json_cached", "imported_log", "mixed"]},
    "suggested_fix": {"type": ["string", "null"]},
    "highlights": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
