{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fallback chain report",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "scenario",
    "profile",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "order",
          "route",
          "authority_effect",
          "status"
        ],
        "properties": {
          "order": {
            "type": "integer"
          },
          "route": {
            "type": "string"
          },
          "authority_effect": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
