{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthorityPack",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "profiles",
    "touchpoints"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "determinism"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "determinism": {
            "enum": [
              "pure",
              "seed_injectable",
              "clock_injectable",
              "env_sensitive",
              "filesystem_sensitive",
              "network_sensitive",
              "host_probe",
              "manual_review_required"
            ]
          },
          "authority": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "touchpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "profile_refs",
          "injectable"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fs_read",
              "fs_write",
              "temp_dir",
              "home_dir",
              "env_read",
              "env_write",
              "network_egress",
              "network_ingress",
              "time_now",
              "sleep_timer",
              "randomness",
              "process_spawn",
              "stdio",
              "thread_spawn",
              "host_probe",
              "manual_review_required"
            ]
          },
          "profile_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "injectable": {
            "type": "boolean"
          },
          "recipe_ref": {
            "type": "string"
          }
        }
      }
    }
  }
}
