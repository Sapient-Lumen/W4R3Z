{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Refusal posture report",
  "type": "object",
  "required": [
    "schema_version",
    "crate",
    "operation",
    "denied_authority",
    "declared_posture",
    "witness_outcome"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "crate": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "denied_authority": {
      "type": "string"
    },
    "declared_posture": {
      "type": "string"
    },
    "witness_outcome": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
