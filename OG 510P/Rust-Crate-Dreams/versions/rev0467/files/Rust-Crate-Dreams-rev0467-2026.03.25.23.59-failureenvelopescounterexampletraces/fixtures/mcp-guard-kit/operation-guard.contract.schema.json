{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "operation-guard.contract",
  "type": "object",
  "required": [
    "server_id",
    "tools_policy",
    "sampling_policy",
    "audit_posture",
    "classification"
  ],
  "properties": {
    "server_id": {"type": "string"},
    "tools_policy": {"enum": ["allowlist-with-approval", "allowlist-no-approval", "dynamic-open", "manual-review-required"]},
    "resources_policy": {"enum": ["bounded-roots-and-size-limits", "bounded-roots-no-size-limits", "manual-review-required"]},
    "prompts_policy": {"enum": ["validated-and-bounded", "manual-review-required"]},
    "sampling_policy": {"enum": ["user-approval-and-loop-limits", "user-approval-no-loop-limits", "enabled-without-approval", "disabled", "manual-review-required"]},
    "redaction_default": {"enum": ["structural-redaction", "partial-redaction", "none", "manual-review-required"]},
    "audit_posture": {"enum": ["structured-redacted", "structured-unredacted", "minimal", "manual-review-required"]},
    "high_risk_categories": {"type": "array", "items": {"type": "string"}},
    "classification": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
