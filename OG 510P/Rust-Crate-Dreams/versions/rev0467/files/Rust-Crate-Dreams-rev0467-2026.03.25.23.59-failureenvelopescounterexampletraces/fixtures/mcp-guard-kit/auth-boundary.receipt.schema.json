{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "auth-boundary.receipt",
  "type": "object",
  "required": [
    "server_id",
    "oauth_mode",
    "resource_indicator_required",
    "audience_validation",
    "token_passthrough",
    "classification"
  ],
  "properties": {
    "server_id": {"type": "string"},
    "oauth_mode": {"enum": ["none", "oauth-http", "custom-http", "local-credentials", "manual-review-required"]},
    "resource_indicator_required": {"type": "boolean"},
    "audience_validation": {"enum": ["present", "missing", "manual-review-required"]},
    "token_passthrough": {"enum": ["forbidden-and-enforced", "possible", "manual-review-required"]},
    "scope_model": {"enum": ["progressive-least-privilege", "static-broad-scope", "manual-review-required"]},
    "consent_model": {"enum": ["per-client-per-user", "shared-or-implicit", "not-applicable", "manual-review-required"]},
    "credential_logging_posture": {"enum": ["redacted", "unknown", "unsafe", "manual-review-required"]},
    "classification": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
