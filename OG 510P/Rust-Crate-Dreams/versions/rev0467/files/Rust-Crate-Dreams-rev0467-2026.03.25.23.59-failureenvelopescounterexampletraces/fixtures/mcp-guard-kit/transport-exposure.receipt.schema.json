{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "transport-exposure.receipt",
  "type": "object",
  "required": [
    "server_id",
    "transport_mode",
    "bind_posture",
    "origin_validation",
    "authentication_required",
    "classification"
  ],
  "properties": {
    "server_id": {"type": "string"},
    "transport_mode": {"enum": ["stdio", "http-local", "http-remote", "mixed"]},
    "bind_posture": {"enum": ["localhost-only", "specific-private-interface", "wildcard-interface", "manual-review-required"]},
    "origin_validation": {"enum": ["not-applicable", "present", "missing", "manual-review-required"]},
    "tls_posture": {"enum": ["not-applicable", "expected", "missing", "terminated-upstream", "manual-review-required"]},
    "authentication_required": {"type": "boolean"},
    "session_mode": {"enum": ["stdio-process-lifetime", "http-session-id", "stateless-http", "manual-review-required"]},
    "local_startup_consent": {"enum": ["not-applicable", "required", "missing", "manual-review-required"]},
    "classification": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
