{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/in-place-initialization-adoption-kit/address-commit.receipt.schema.json",
  "title": "Address Commit Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "commit_event",
    "move_forbidden_after",
    "evidence_source"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "commit_event": {
      "type": "string"
    },
    "pin_begins_at": {
      "type": "string"
    },
    "move_forbidden_after": {
      "type": "string"
    },
    "inner_commit_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outer_commit_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_source": {
      "enum": [
        "declared",
        "inferred_from_api",
        "fixture_witness",
        "manual_review"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
