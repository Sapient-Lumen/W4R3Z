{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactOriginReceipt",
  "type": "object",
  "required": ["artifacts"],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "origin_basis", "exactness"],
        "properties": {
          "path": {"type": "string"},
          "origin_basis": {"type": "string"},
          "exactness": {"type": "string"},
          "source_events": {
            "type": "array",
            "items": {"type": "string"}
          },
          "manual_review_reason": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
