{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HandoffReceipt",
  "type": "object",
  "required": ["command", "message_format", "build_finished_observed"],
  "properties": {
    "command": {"type": "array", "items": {"type": "string"}},
    "message_format": {"type": "string"},
    "build_finished_observed": {"type": "boolean"},
    "session_id": {"type": ["string", "null"]},
    "imported_session": {"type": ["boolean", "null"]},
    "stdout_caveats": {"type": "array", "items": {"type": "string"}},
    "redactions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
