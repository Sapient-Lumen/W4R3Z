    {
      "tier": "replayed",
      "meaning": "locally rerun under a reproducible recipe"
    },
    {
      "tier": "exercised",
      "meaning": "tests, witness programs, or probes ran on a named matrix"
    },
    {
      "tier": "observed",
      "meaning": "field or downstream integration evidence imported"
    },
    {
      "tier": "qualified",
      "meaning": "extra assurance or domain process artifacts supplied"
    },
    {
      "tier": "refused",
      "meaning": "the crate intentionally declines to make the claim"
