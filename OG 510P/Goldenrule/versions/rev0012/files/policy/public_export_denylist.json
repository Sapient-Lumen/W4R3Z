{
  "schema_version": 1,
  "id": "public_export_denylist_v2",
  "description": "Denylist for artifacts/definitions that must not be exported with `--public` by default.",
  "deny": {
    "strategy_id_regex": [
      "(?i)\\badversary\\b",
      "(?i)\\bvampire\\b",
      "(?i)\\bexploit\\b"
    ],
    "task_id_regex": [
      "(?i)adversary",
      "(?i)vampire",
      "(?i)exploit"
    ]
  }
}
