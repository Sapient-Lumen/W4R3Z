} 2>/dev/null || true
        # Write env doc only once to avoid per-run overhead.
        # Avoid heredocs here: terminators can break if indentation changes.
        # NOTE: entry_script is single-quoted, so avoid single quotes in this block.
        if [[ "${SW_WRITE_ENV_MD:-1}" == "1" && ! -s "$envdoc" ]]; then
            echo "[sandworm-entry] writing env doc to $envdoc" >&2
            {
                printf "%s\n" "Sandworm context: **${SANDWORM_CONTEXT:-safe}**"
