                printf "%s\n" "Quick status:"
                printf "%s\n" "- STRICT: ${SANDWORM_STRICT:-0}"
                printf "%s\n" "- Network: ${SANDWORM_NETWORK_MODE:-default}"
                printf "%s\n" "- Host integrations: ${SANDWORM_HOST_INTEGRATIONS:-1}"
                printf "%s\n" "- Seccomp unconfined: ${SANDWORM_SECCOMP_UNCONFINED:-0}"
                printf "%s\n" "- GPU: ${SANDWORM_GPU_MODE:-none}"
                printf "\n"
                printf "%s\n" "## Security Notes"
                printf "\n"
                printf "%s\n" "**Seccomp**: ${SANDWORM_SECCOMP_UNCONFINED:-0}"
                if [[ "${SANDWORM_SECCOMP_UNCONFINED:-0}" == "1" ]]; then
                    printf "%s\n" "  - Currently UNCONFINED for compatibility with proot/JuNest/nix-portable"
                    printf "%s\n" "  - This enables broader syscall access for development tools"
                    printf "%s\n" "  - For maximum security, use --strict mode (enables seccomp)"
                    printf "%s\n" "  - Note: --strict may break some tools (proot, JuNest)"
                else
