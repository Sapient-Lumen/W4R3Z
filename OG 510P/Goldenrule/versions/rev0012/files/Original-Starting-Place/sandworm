create_toolroot_staging() {
    local rev_id
    rev_id=$(generate_rev_id)
    local staging_dir="$CONTROL/toolroots/${rev_id}.staging"
    
    mkdir -p "$staging_dir"/{bin,lib/node_modules,node,rustup,cargo}
