                    printf "%s\n" "  - This provides stronger isolation"
                    printf "%s\n" "  - Some tools (proot, JuNest, nix-portable) may not work"
                    printf "%s\n" "  - Network tools (ip, ss, netstat) are blocked (AF_NETLINK denied)"
                    printf "%s\n" "  - Network access itself is unaffected, only diagnostics are blocked"
                fi
                printf "\n"
                printf "%s\n" "**Network namespace**: ${SANDWORM_NETWORK_MODE:-default}"
                if [[ "${SANDWORM_NETWORK_MODE:-default}" == "host" ]]; then
                    printf "%s\n" "  - Shared with host for OAuth localhost callbacks"
                    printf "%s\n" "  - Required for reliable browser-based auth flows"
                    printf "%s\n" "  - Can connect to host services; cannot bind privileged ports"
                fi
                printf "\n"
                printf "%s\n" "**Known limitations** (intentional ergonomic tradeoffs):"
                printf "%s\n" "  - /proc/self/mountinfo exposes host paths (inherent to overlayfs)"
                printf "%s\n" "  - XAUTHORITY and .gitconfig expose host home path and git identity"
                printf "%s\n" "  - Host network services are reachable (required for OAuth flows)"
                printf "%s\n" "  - Desktop sockets (D-Bus, audio) accessible when SW_HOST_INTEGRATIONS=1"
                printf "%s\n" "  - These are info disclosure only, not escape vectors"
                printf "\n"
                printf "%s\n" "- **SAFE**: sandboxed container. Host mutation: **NO**. The control plane at /workspace/.sandworm is **masked**."
                printf "%s\n" "- **UNSAFE**: sandboxed container with **host root mounted at ${SANDWORM_HOST_ROOT:-/host}** (rw). Host mutation: **YES**. Sandworm control plane visible at **/control** (rw). The repo view at /workspace/.sandworm remains **masked**."
                printf "\n"
                printf "%s\n" "In **UNSAFE**, to run a command *on the host* (not just edit files under /host):"
                printf "%s\n" "- \`host <cmd>\`  (recommended; wrapper around nsenter)"
                printf "%s\n" "- \`chroot ${SANDWORM_HOST_ROOT:-/host} /bin/bash\`  (host filesystem)"
                printf "%s\n" "- \`nsenter -t 1 -m -u -i -n -p -- <cmd>\`"
                printf "\n"
                printf "%s\n" "First step (LLMs): \`cat \"$caps\"\`."
                printf "\n"
                printf "%s\n" "Install for yourself (works in both modes): use HOME-based installs:"
                printf "%s\n" "- Python: \`python -m pip install --user <pkg>\`"
                printf "%s\n" "- Node: \`npm install -g <pkg>\` (prefix set to \$HOME/.npm-global)"
                printf "%s\n" "- Rust: \`cargo install <crate>\`"
                printf "\n"
                printf "%s\n" "## 💡 For AI Agents"
                printf "\n"
                printf "%s\n" "Consider creating an **AGENTS.md** file in your project root to help AI agents"
                printf "%s\n" "understand your project structure, commands, and conventions."
                printf "\n"
                printf "%s\n" "Standard sections:"
                printf "%s\n" "- **Commands**: How to run, test, build (with flags and options)"
                printf "%s\n" "- **Project Structure**: Directory layout and file organization"
                printf "%s\n" "- **Code Style**: Conventions, patterns, and preferences"
                printf "%s\n" "- **Git Workflow**: Branch naming, commit message format"
                printf "%s\n" "- **Boundaries**: Files/directories agents should not modify"
                printf "\n"
                printf "%s\n" "AGENTS.md is an open standard supported by Codex, Claude Code, Gemini CLI,"
                printf "%s\n" "Jules, Cursor, Zed, and many other AI coding tools."
                printf "\n"
                printf "%s\n" "Learn more: https://agents.md/"
            } >"$envdoc" 2>/dev/null || true
        fi
        if [[ "${SANDWORM_CONTEXT:-safe}" == "unsafe" ]]; then
            mkdir -p "$HOME/.local/bin"
            cat > "$HOME/.local/bin/host" <<'SH'
#!/bin/sh
set -e
NSENTER="$(command -v nsenter 2>/dev/null || true)"
if [ -z "$NSENTER" ] && [ -x "${SANDWORM_HOST_ROOT:-/host}/usr/bin/nsenter" ]; then
  NSENTER="${SANDWORM_HOST_ROOT:-/host}/usr/bin/nsenter"
fi
if [ -z "$NSENTER" ]; then
  echo "host: nsenter not found (install util-linux on the image or host)" >&2
  exit 127
fi
exec "$NSENTER" -t 1 -m -u -i -n -p -- "$@"
SH
            chmod +x "$HOME/.local/bin/host" || true
        fi

        # Always ensure the repo view does not expose the control plane.
        if [[ -f /workspace/.sandworm/state.json ]]; then
            echo "ERROR: Masking failed - /workspace/.sandworm is the real control plane!" >&2
            ls -la /workspace/.sandworm/ >&2 || true
            exit 30
        fi

        if [[ "${SANDWORM_CONTEXT:-safe}" == "unsafe" ]]; then
            if [[ ! -f /control/state.json ]]; then
                echo "ERROR: UNSAFE expected /control to expose the control plane, but it is missing." >&2
                ls -la /control/ >&2 || true
                exit 31
            fi
            [[ -d "${SANDWORM_HOST_ROOT:-/host}" ]] || { echo "ERROR: UNSAFE expected host root at ${SANDWORM_HOST_ROOT:-/host}." >&2; exit 33; }
        else
            if [[ -e /control/state.json ]]; then
                echo "ERROR: SAFE expected /control to be absent, but it is present." >&2
                ls -la /control/ >&2 || true
                exit 32
            fi
        fi

        echo "[sandworm-entry] exec: $*" >&2
        exec "$@"
    '

    podman_cmd+=(/bin/bash -c "$entry_script" -- "${cmd[@]}")

    log_debug "Running: ${podman_cmd[*]}"

    local rc=0
    mkdir -p "$CONTROL/podman" 2>/dev/null || true
    local errfile
    errfile="$(mktemp "$CONTROL/podman/podman.err.XXXXXX")"

    # Control command prefix (podman or sudo ... podman). Used for rm/diff/commit.
    local -a podman_ctl=()
    for w in "${podman_cmd[@]}"; do
        if [[ "$w" == "run" ]]; then break; fi
        podman_ctl+=("$w")
    done

    "${podman_cmd[@]}" 2> >(tee "$errfile" >&2) || rc=$?

    # STRICT auth publishing: if IPv6 loopback publish is unsupported on this Podman setup,
    # retry once without the [::1] bindings (fall back to IPv4-only).
    if [[ "$rc" -ne 0 && "${SW_STRICT:-0}" == "1" ]]; then
        if grep -Eqi 'invalid (publish|port)|invalid ip|cannot assign requested address|address family not supported|unknown host|invalid argument' "$errfile" 2>/dev/null; then
            local has_v6_pub="0"
            for ((i=0; i<${#podman_cmd[@]}; i++)); do
                if [[ "${podman_cmd[$i]}" == "-p" && "${podman_cmd[$((i+1))]:-}" == \\[::1\\]:* ]]; then
                    has_v6_pub="1"
                    break
                fi
            done
            if [[ "$has_v6_pub" == "1" ]]; then
                log_warn "Retrying without IPv6 loopback port publish ([::1])"
                local new_cmd=()
                local skip=0
                for ((i=0; i<${#podman_cmd[@]}; i++)); do
                    if [[ "$skip" == "1" ]]; then skip=0; continue; fi
                    if [[ "${podman_cmd[$i]}" == "-p" && "${podman_cmd[$((i+1))]:-}" == \\[::1\\]:* ]]; then
                        skip=1
                        continue
                    fi
                    new_cmd+=("${podman_cmd[$i]}")
                done
                podman_cmd=("${new_cmd[@]}")
                rc=0
                "${podman_cmd[@]}" 2> >(tee "$errfile" >&2) || rc=$?
            fi
        fi
    fi
    
    # Network fallback: if host networking fails (common rootless edge), retry with a "just works" mode.
    # Default: SW_NETWORK_FALLBACK=auto -> slirp4netns, then pasta:--map-gw, then default.
    if [[ "$rc" -ne 0 && "${SW_OFFLINE:-0}" != "1" ]]; then
        local mode="${SW_NETWORK_MODE:-host}"
        local fb="${SW_NETWORK_FALLBACK:-auto}"
        if [[ "$mode" == "host" && "$fb" != "0" ]]; then
            # Common failure strings for rootless host networking (varies by backend: slirp4netns/pasta/netavark).
            if grep -Eiq "host network|--network host|network namespace|cannot set up.*network|error joining network|rootless netns|setns:|pasta|slirp4netns|operation not permitted" "$errfile" 2>/dev/null; then
                local -a candidates=()
                case "$fb" in
                    ""|auto) candidates=("slirp4netns" "pasta:--map-gw" "default") ;;
                    default|bridge) candidates=("default") ;;
                    *) candidates=("$fb") ;;
                esac

                for cand in "${candidates[@]}"; do
                    log_warn "Host networking failed; retrying with network=$cand"

                    # Rewrite podman_cmd in-place (swap --network host and SANDWORM_NETWORK_MODE).
                    if [[ "$cand" == "default" || "$cand" == "bridge" ]]; then
                        local new_cmd=()
                        local skip=0
                        for ((i=0; i<${#podman_cmd[@]}; i++)); do
                            if [[ "$skip" -eq 1 ]]; then skip=0; continue; fi
                            if [[ "${podman_cmd[$i]}" == "--network" && "${podman_cmd[$((i+1))]:-}" == "host" ]]; then
                                skip=1
                                continue
                            fi
                            if [[ "${podman_cmd[$i]}" == SANDWORM_NETWORK_MODE=* ]]; then
                                new_cmd+=("SANDWORM_NETWORK_MODE=default")
                            else
                                new_cmd+=("${podman_cmd[$i]}")
                            fi
                        done
                        podman_cmd=("${new_cmd[@]}")
                    else
                        for ((i=0; i<${#podman_cmd[@]}; i++)); do
                            if [[ "${podman_cmd[$i]}" == "--network" && "${podman_cmd[$((i+1))]:-}" == "host" ]]; then
                                podman_cmd[$((i+1))]="$cand"
                            fi
                            if [[ "${podman_cmd[$i]}" == SANDWORM_NETWORK_MODE=* ]]; then
                                podman_cmd[$i]="SANDWORM_NETWORK_MODE=$cand"
                            fi
                        done
                    fi

                    # Remove any previous container attempt (name is fixed for this run)
                    "${podman_ctl[@]}" rm -f "$container_name" >/dev/null 2>&1 || true
                    rc=0
                    "${podman_cmd[@]}" 2> >(tee "$errfile" >&2) || rc=$?

                    if [[ "$rc" -eq 0 ]]; then break; fi

                    # If it didn't look like networking anymore, stop trying.
                    if ! grep -Eiq "network namespace|cannot set up.*network|error joining network|rootless netns|setns:|pasta|slirp4netns|operation not permitted" "$errfile" 2>/dev/null; then
                        break
                    fi
                done
            fi
        fi
    fi

    # GPU fallback: if auto-selected NVIDIA CDI fails, retry once with direct devices + OCI hook.
    if [[ "$rc" -ne 0 && "${SW_GPU:-auto}" == "auto" ]]; then
        local used_cdi="0"
        for ((i=0; i<${#podman_cmd[@]}; i++)); do
            if [[ "${podman_cmd[$i]}" == "--device" && "${podman_cmd[$((i+1))]:-}" == nvidia.com/gpu=* ]]; then
                used_cdi="1"; break
            fi
        done

        if [[ "$used_cdi" == "1" ]]; then
            if grep -Eiq "unresolvable CDI devices|setting up CDI devices|CDI" "$errfile" 2>/dev/null; then
                log_warn "NVIDIA CDI failed; retrying with direct devices + OCI hook (if available)"

                # Remove CDI device args
                local new_cmd=()
                local skip=0
                for ((i=0; i<${#podman_cmd[@]}; i++)); do
                    if [[ "$skip" -eq 1 ]]; then skip=0; continue; fi
                    if [[ "${podman_cmd[$i]}" == "--device" && "${podman_cmd[$((i+1))]:-}" == nvidia.com/gpu=* ]]; then
                        skip=1
                        continue
                    fi
                    new_cmd+=("${podman_cmd[$i]}")
                done
                podman_cmd=("${new_cmd[@]}")

                # Update reported GPU mode inside the sandbox (LLM-facing).
                for ((i=0; i<${#podman_cmd[@]}; i++)); do
                    if [[ "${podman_cmd[$i]}" == SANDWORM_GPU_MODE=* ]]; then
                        podman_cmd[$i]="SANDWORM_GPU_MODE=nvidia-hook"
                    fi
                done


                # Append direct NVIDIA devices when present
                if [[ -e /dev/nvidia0 ]]; then podman_cmd+=(--device /dev/nvidia0); fi
                if [[ -e /dev/nvidiactl ]]; then podman_cmd+=(--device /dev/nvidiactl); fi
                if [[ -e /dev/nvidia-uvm ]]; then podman_cmd+=(--device /dev/nvidia-uvm); fi
                if [[ -e /dev/nvidia-uvm-tools ]]; then podman_cmd+=(--device /dev/nvidia-uvm-tools); fi

                # Append NVIDIA OCI hook (copy into sandworm-owned dir) if available
                if command -v nvidia-container-cli >/dev/null 2>&1 || command -v nvidia-container-runtime-hook >/dev/null 2>&1; then
                    if prepare_nvidia_oci_hook_dir; then
                        podman_cmd+=(--hooks-dir "$CONTROL/hooks-nvidia")
                        podman_cmd+=(--annotation sandbox=1)
                        # Helpful defaults for the hook; user can override.
                        podman_cmd+=(-e NVIDIA_VISIBLE_DEVICES=all -e NVIDIA_DRIVER_CAPABILITIES=all)
                    fi
                fi

                # Remove any previous container attempt (name is fixed for this run)
                "${podman_ctl[@]}" rm -f "$container_name" >/dev/null 2>&1 || true
                rc=0
                "${podman_cmd[@]}" 2> >(tee "$errfile" >&2) || rc=$?
            fi
        fi
    fi

    # Persist rootfs changes (SAFE only) so apt-get installs survive across runs.
    # We commit only when the container filesystem changed in "system-ish" paths.
    local cid=""
    if [[ -f "$cidfile" ]]; then
        cid="$(cat "$cidfile" 2>/dev/null || true)"
    fi
    if [[ -n "$cid" && "${SW_PERSIST_ROOTFS:-1}" == "1" && "$posture" == "safe" ]]; then
        local diff_out commit_needed
        diff_out="$("${podman_ctl[@]}" diff "$cid" 2>/dev/null || true)"
        commit_needed=0
        if printf "%s\n" "$diff_out" | grep -Eq '^[ACD] /(usr|lib|lib64|bin|sbin|opt|var/lib/dpkg|var/lib/apt|etc/)\b'; then
            commit_needed=1
        fi
        # Ignore the common /etc/hosts + /etc/resolv.conf churn.
        if [[ "$commit_needed" == "1" ]]; then
            if printf "%s\n" "$diff_out" | grep -Eq '^[ACD] /etc/(hosts|resolv\.conf)\b' && ! printf "%s\n" "$diff_out" | grep -Ev '^[ACD] /etc/(hosts|resolv\.conf)\b' | grep -q .; then
                commit_needed=0
            fi
        fi
        if [[ "$commit_needed" == "1" ]]; then
            local old_tag="$rootfs_tag"
            local new_tag="sandworm-rootfs:${SCRIPT_HASH:0:12}-$(generate_rev_id)"
            log_info "Persisting sandbox system changes -> $new_tag"
            if "${podman_ctl[@]}" commit "$cid" "$new_tag" >/dev/null 2>&1; then
                set_state "SW_ROOTFS_TAG" "$new_tag"
                write_state_json "$CONTROL/state.json"
                if [[ "$old_tag" != "$SEED_TAG" && "$old_tag" != "$new_tag" ]]; then
                    "${podman_ctl[@]}" image rm "$old_tag" >/dev/null 2>&1 || true
                fi
                rootfs_tag="$new_tag"
            else
                log_warn "podman commit failed; sandbox system changes will not persist (run: ${container_name})"
            fi
        fi
    fi

    # Always remove the container; the image (if committed) persists under .sandworm.
    if [[ -n "$cid" ]]; then
        "${podman_ctl[@]}" rm -f "$cid" >/dev/null 2>&1 || true
    else
        "${podman_ctl[@]}" rm -f "$container_name" >/dev/null 2>&1 || true
    fi
    rm -f "$cidfile" 2>/dev/null || true

    rm -f "$errfile" 2>/dev/null || true
    rm -rf "$mask_dir" 2>/dev/null || true

    # Keep ".sandworm = kill everything" ergonomic: if unsafe ran rootful podman,
    # best-effort chown the control plane back to the invoking user (only if needed).
    if [[ "$posture" == "unsafe" ]]; then
        local owner_uid owner_gid
        owner_uid="${SUDO_UID:-$(id -u)}"
        owner_gid="${SUDO_GID:-$(id -g)}"

        local needs_chown="0"
        if find "$CONTROL" -xdev -uid 0 -print -quit 2>/dev/null | grep -q .; then
            needs_chown="1"
        fi

        if [[ "$needs_chown" == "1" ]]; then
            if [[ "$(id -u)" -eq 0 ]]; then
                if chown --help 2>/dev/null | grep -q -- "--from"; then
                    chown -R --from=0:0 "$owner_uid:$owner_gid" "$CONTROL" 2>/dev/null || true
                else
                    find "$CONTROL" -xdev -uid 0 -print0 2>/dev/null | xargs -0 chown -h "$owner_uid:$owner_gid" 2>/dev/null || true
                fi
            elif command -v sudo >/dev/null 2>&1; then
                if sudo -n true 2>/dev/null; then
                    if chown --help 2>/dev/null | grep -q -- "--from"; then
                        sudo -n chown -R --from=0:0 "$owner_uid:$owner_gid" "$CONTROL" 2>/dev/null || true
                    else
                        sudo -n bash -lc 'find "$0" -xdev -uid 0 -print0 2>/dev/null | xargs -0 chown -h "$1:$2" 2>/dev/null || true' "$CONTROL" "$owner_uid" "$owner_gid"
                    fi
                elif [[ -t 0 ]]; then
                    if chown --help 2>/dev/null | grep -q -- "--from"; then
                        sudo chown -R --from=0:0 "$owner_uid:$owner_gid" "$CONTROL" 2>/dev/null || true
                    else
                        sudo bash -lc 'find "$0" -xdev -uid 0 -print0 2>/dev/null | xargs -0 chown -h "$1:$2" 2>/dev/null || true' "$CONTROL" "$owner_uid" "$owner_gid"
                    fi
                fi
            fi
        fi

        # If UNSAFE created root-owned files in the workspace (common when editing as root),
        # best-effort chown them back so the repo remains pleasant to use.
        local ws_needs_chown="0"
        if find "$workspace_realpath" -xdev -uid 0 -print -quit 2>/dev/null | grep -q .; then
            ws_needs_chown="1"
        fi
        if [[ "$ws_needs_chown" == "1" ]]; then
            if [[ "$(id -u)" -eq 0 ]]; then
                if chown --help 2>/dev/null | grep -q -- "--from"; then
                    chown -R --from=0:0 "$owner_uid:$owner_gid" "$workspace_realpath" 2>/dev/null || true
                else
                    find "$workspace_realpath" -xdev -uid 0 -print0 2>/dev/null | xargs -0 chown -h "$owner_uid:$owner_gid" 2>/dev/null || true
                fi
            elif command -v sudo >/dev/null 2>&1; then
                if sudo -n true 2>/dev/null; then
                    if chown --help 2>/dev/null | grep -q -- "--from"; then
                        sudo -n chown -R --from=0:0 "$owner_uid:$owner_gid" "$workspace_realpath" 2>/dev/null || true
                    else
                        sudo -n bash -lc 'find "$0" -xdev -uid 0 -print0 2>/dev/null | xargs -0 chown -h "$1:$2" 2>/dev/null || true' "$workspace_realpath" "$owner_uid" "$owner_gid"
                    fi
                elif [[ -t 0 ]]; then
                    if chown --help 2>/dev/null | grep -q -- "--from"; then
                        sudo chown -R --from=0:0 "$owner_uid:$owner_gid" "$workspace_realpath" 2>/dev/null || true
                    else
                        sudo bash -lc 'find "$0" -xdev -uid 0 -print0 2>/dev/null | xargs -0 chown -h "$1:$2" 2>/dev/null || true' "$workspace_realpath" "$owner_uid" "$owner_gid"
                    fi
                fi
            fi
        fi
    fi

    return "$rc"
}

verify_masking() {
    run_in_container_check_only
}

run_in_container_check_only() {
    # Non-interactive masking check (SAFE posture).
    log_trace "Running container masking check..."
    
    local current_rev
    current_rev=$(get_state "SW_REV_CURRENT" "")
    if [[ -z "$current_rev" ]]; then
        log_trace "No current revision set"
        return 1
    fi

    local toolroot_dir="$CONTROL/toolroots/$current_rev"
    if [[ ! -d "$toolroot_dir" ]]; then
        log_trace "Toolroot directory not found: $toolroot_dir"
        return 1
    fi

    if ! ensure_podman_storage --try 2>/dev/null; then
        log_trace "Podman storage not available for masking check"
        return 1
    fi

    local workspace_realpath home_realpath toolroot_realpath mask_realpath
    workspace_realpath=$(realpath "$WORKSPACE")
    home_realpath=$(realpath "$CONTROL/home")
    toolroot_realpath=$(realpath "$toolroot_dir")
    local mask_dir
    mask_dir="$(mktemp -d /tmp/sandworm-mask.XXXXXX)"
    chmod 755 "$mask_dir" 2>/dev/null || true
    mask_realpath=$(realpath "$mask_dir")
    
    log_trace "Masking check: running container..."

    # Use the active rootfs tag (not the script-derived seed tag). This avoids
    # false failures when the sandworm script changes but the current toolroot
    # is still valid.
    local image_tag
    image_tag="$(get_state "SW_ROOTFS_TAG" "$SEED_TAG")"
    # Normalize/qualify older stored tags to avoid Podman short-name prompts.
    if [[ -n "${SEED_TAG_SHORT:-}" && "$image_tag" == "$SEED_TAG_SHORT" ]]; then
        image_tag="$SEED_TAG"
    elif [[ "$image_tag" == sandworm-seed:* ]] && "$PODMAN_BIN" image exists "localhost/$image_tag" >/dev/null 2>&1; then
        image_tag="localhost/$image_tag"
    fi
    if ! "$PODMAN_BIN" image exists "$image_tag" >/dev/null 2>&1; then
        log_trace "Masking check: rootfs image missing: $image_tag"
        image_tag="$SEED_TAG"
    fi
    
    local check_stderr
    check_stderr=$(mktemp 2>/dev/null || mktemp -t swcheck)
    
    local rc=0
    $PODMAN_BIN run --rm \
        --pull=never \
        --hooks-dir "$CONTROL/hooks-empty" \
        --security-opt label=disable \
        -v "$workspace_realpath:/workspace:rw,rbind" \
        -v "$home_realpath:/home/sandworm:rw,rbind" \
        -v "$toolroot_realpath:/opt/llm:ro" \
        -v "$mask_realpath:/workspace/.sandworm:ro" \
        -w /workspace \
        "$image_tag" \
        /bin/bash -c '
            # Masking expectations:
            # - /workspace/.sandworm does not expose control plane
            # - /workspace/.sandworm is not writable
            # - control plane state file is not visible via repo path
            [[ ! -f /workspace/.sandworm/state.json ]] || exit 30
            touch /workspace/.sandworm/.MASKED >/dev/null 2>&1 && exit 29
            [[ ! -f /workspace/.sandworm/state.json ]] || exit 30
            exit 0
        ' 2>"$check_stderr" || rc=$?
    rm -rf "$mask_dir" 2>/dev/null || true
    if [[ "$rc" -ne 0 ]]; then
        log_trace "Masking check failed (exit $rc)"
        if [[ -s "$check_stderr" ]]; then
            log_trace "Masking check stderr: $(cat "$check_stderr")"
        fi
        rm -f "$check_stderr"
        return $rc
    fi
    
    rm -f "$check_stderr"
    log_trace "Masking check passed"
    return 0
}

run_in_container_masking_probe() {
    # Extended masking probe that prints a short report from inside the sandbox.
    local current_rev
    current_rev=$(get_state "SW_REV_CURRENT" "")
    [[ -n "$current_rev" ]] || return 1

    local toolroot_dir="$CONTROL/toolroots/$current_rev"
    [[ -d "$toolroot_dir" ]] || return 1

    if ! ensure_podman_storage --try 2>/dev/null; then
        return 1
    fi

    local workspace_realpath home_realpath toolroot_realpath mask_realpath
    workspace_realpath=$(realpath "$WORKSPACE")
    home_realpath=$(realpath "$CONTROL/home")
    toolroot_realpath=$(realpath "$toolroot_dir")
    local mask_dir
    mask_dir="$(mktemp -d /tmp/sandworm-mask.XXXXXX)"
    chmod 755 "$mask_dir" 2>/dev/null || true
    mask_realpath=$(realpath "$mask_dir")

    # Use the active rootfs tag (not the script-derived seed tag).
    local image_tag
    image_tag="$(get_state "SW_ROOTFS_TAG" "$SEED_TAG")"
    if [[ -n "${SEED_TAG_SHORT:-}" && "$image_tag" == "$SEED_TAG_SHORT" ]]; then
        image_tag="$SEED_TAG"
    elif [[ "$image_tag" == sandworm-seed:* ]] && "$PODMAN_BIN" image exists "localhost/$image_tag" >/dev/null 2>&1; then
        image_tag="localhost/$image_tag"
    fi
    if ! "$PODMAN_BIN" image exists "$image_tag" >/dev/null 2>&1; then
        image_tag="$SEED_TAG"
    fi

    $PODMAN_BIN run --rm \
        --pull=never \
        --hooks-dir "$CONTROL/hooks-empty" \
        --security-opt label=disable \
        -v "$workspace_realpath:/workspace:rw,rbind" \
        -v "$home_realpath:/home/sandworm:rw,rbind" \
        -v "$toolroot_realpath:/opt/llm:ro" \
        -v "$mask_realpath:/workspace/.sandworm:ro" \
        -w /workspace \
        "$image_tag" \
        /bin/bash -lc '
          set -euo pipefail
          echo "sandbox: $(id -u):$(id -g) whoami=$(whoami 2>/dev/null || true)"
          echo "probe: /workspace/.sandworm perms=$(stat -c %a /workspace/.sandworm 2>/dev/null || echo "<stat-failed>")"
          # NOTE: avoid backslash-escaped quotes inside this single-quoted script.
          echo "probe: contents: $(ls -A /workspace/.sandworm 2>/dev/null | wc -l | xargs) entries"
          echo "probe: can_write=$( (touch /workspace/.sandworm/.MASKED >/dev/null 2>&1 && echo YES) || echo no )"
          echo "probe: state.json visible? $(test -f /workspace/.sandworm/state.json && echo YES || echo no)"
        '
    rm -rf "$mask_dir" 2>/dev/null || true
}

