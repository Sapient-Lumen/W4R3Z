# Compute SHA256 hash of a file
compute_hash() {
    local file="$1"
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$file" | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$file" | cut -d' ' -f1
    else
        die "No SHA256 tool available (sha256sum or shasum)"
    fi
}

# Generate a revision ID
generate_rev_id() {
    local timestamp
    timestamp=$(date -u +%Y%m%d-%H%M%S)
    local random_hex
    random_hex=$(head -c2 /dev/urandom | od -An -tx1 | tr -d ' \n')
    printf '%s-%s\n' "$timestamp" "$random_hex"
}

# Atomic file write
atomic_write() {
    local dest="$1"
    local content="$2"
    local tmp="${dest}.tmp.$$"
    
    printf '%s' "$content" > "$tmp"
    sync "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$dest"
}

# Check if a CLI is disabled
is_cli_disabled() {
    local cli="$1"
    [[ ",$SW_DISABLED_CLIS," == *",$cli,"* ]]
}

# =============================================================================
# State management (state.json)
# =============================================================================

_validate_state_kv() {
    local key="$1"
    local value="$2"

    # Disallow control chars/newlines universally
    if printf '%s' "$value" | LC_ALL=C grep -q '[[:cntrl:]]'; then
        return 1
    fi

    case "$key" in
        SW_STATE_SCHEMA)
            [[ "$value" =~ ^[0-9]+$ ]]
            ;;
        SW_STATE)
            [[ "$value" =~ ^(UNINITIALIZED|NEEDS_BUILD|BUILDING|HEALTHY|DEGRADED|BROKEN)$ ]]
            ;;
        SW_SCRIPT_HASH)
            [[ "$value" =~ ^[a-f0-9]{64}$ ]]
            ;;
        SW_SCRIPT_DRIFT)
            [[ "$value" =~ ^[01]$ ]]
            ;;
        SW_LAST_REFRESH_UTC)
            [[ "$value" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$|^never$ ]]
            ;;
        SW_REV_CURRENT)
            # Must match generate_rev_id format; never allow path separators.
            [[ "$value" =~ ^[0-9]{8}-[0-9]{6}-[a-f0-9]{4}$ ]]
            ;;
        SW_ROOTFS_TAG)
            # image:tag (allow local registry prefix like localhost/; no digests)
            [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*:[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
            ;;
        SW_SEED_TAG)
            # image:tag used for the seed/rootfs base (allow localhost/ prefix; no digests)
            [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*:[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
            ;;
        SW_NODE_OK|SW_RUST_OK|SW_NIX_OK|SW_CODEX_OK|SW_CLAUDE_OK|SW_GEMINI_OK)
            [[ "$value" =~ ^[01]$ ]]
            ;;
        *)
            # Default: keep it boring (prevents path steering / argument injection).
            # Allow common punctuation and spaces but reject path separators.
            local re='^[A-Za-z0-9._,:@+= -]{0,200}$'
            [[ "$value" =~ $re ]]
            ;;
    esac
}

parse_state_json() {
    local state_file="$1"
    STATE=()

    if [[ ! -f "$state_file" ]]; then
        return 0
    fi

    local json_backend="jq"
    if ! command -v jq >/dev/null 2>&1; then
        if command -v python3 >/dev/null 2>&1; then
            json_backend="python3"
            log_warn "jq not found; using python3 fallback to parse state.json"
        else
            die "jq is required to parse $state_file (install jq) (or install python3 for fallback)"
        fi
    fi

    local tsv=""
    if [[ "$json_backend" == "jq" ]]; then
        if ! jq -e 'type == "object"' "$state_file" >/dev/null 2>&1; then
            log_warn "state.json is not valid JSON object: $state_file"
            return 1
        fi
        tsv="$(jq -r 'to_entries[] | [.key, (.value|tostring)] | @tsv' "$state_file")" || return 1
    else
        tsv="$(python3 - "$state_file" <<'PY'
import json,sys
path=sys.argv[1]
with open(path,'r',encoding='utf-8') as f:
    obj=json.load(f)
if not isinstance(obj,dict):
    raise SystemExit(1)
for k,v in obj.items():
    if isinstance(v,(dict,list)):
        s=json.dumps(v,separators=(',',':'))
    elif v is None:
        s=""
    else:
        s=str(v)
    sys.stdout.write(f"{k}\t{s}\n")
PY
        )" || {
            log_warn "state.json parse failed (python3 fallback): $state_file"
            return 1
        }
    fi

    local key value
    while IFS=$'\t' read -r key value; do
        [[ -n "$key" ]] || continue
        # Enforce key naming
        if [[ ! "$key" =~ ^[A-Z0-9_]+$ ]]; then
            log_warn "state.json: rejected invalid key: $key"
            continue
        fi
        # Safety check: reject shell metacharacters that could enable injection later
        if [[ "$value" =~ [\`\$\(\)\{\}\;\|] ]]; then
            log_warn "state.json: rejected unsafe value for $key"
            continue
        fi
        if ! _validate_state_kv "$key" "$value"; then
            log_warn "state.json: rejected invalid value for $key"
            continue
        fi
        STATE["$key"]="$value"
    done <<<"$tsv"
    return 0
}

write_state_json() {
    local state_file="$1"
    local json_backend="jq"
    if ! command -v jq >/dev/null 2>&1; then
        if command -v python3 >/dev/null 2>&1; then
            json_backend="python3"
            log_warn "jq not found; using python3 fallback to write state.json"
        else
            die "jq is required to write $state_file (install jq) (or install python3 for fallback)"
        fi
    fi

    # Build TSV of key/value pairs (values are stored as strings).
    local kv_tsv=""
    for key in $(printf '%s\n' "${!STATE[@]}" | sort); do
        kv_tsv+="${key}\t${STATE[$key]}\n"
    done

    local json
    if [[ "$json_backend" == "jq" ]]; then
        json=$(
            printf '%b' "$kv_tsv" | jq -Rn --argjson schema "$SW_STATE_SCHEMA" '
              reduce inputs as $line
                ({SW_STATE_SCHEMA: $schema};
                  ($line | split("\t")) as $kv |
                    if ($kv|length)==2 then . + {($kv[0]): $kv[1]} else . end)
            '
        )
    else
        json="$(
            python3 - "$SW_STATE_SCHEMA" <<'PY' <<<"$(printf '%b' "$kv_tsv")"
import json,sys
schema=int(sys.argv[1])
out={"SW_STATE_SCHEMA":schema}
for line in sys.stdin.read().splitlines():
    if not line.strip():
        continue
    if "\t" not in line:
        continue
    k,v=line.split("\t",1)
    out[k]=v
sys.stdout.write(json.dumps(out,sort_keys=True,indent=2))
PY
        )"
    fi

    atomic_write "$state_file" "$json"
}

# Get state value with default
get_state() {
    local key="$1"
    local default="${2:-}"
    printf '%s' "${STATE[$key]:-$default}"
}

# Set state value
set_state() {
    local key="$1"
    local value="$2"
    STATE["$key"]="$value"
}

# =============================================================================
# Workspace resolution
# =============================================================================

resolve_workspace() {
    # 1. If SW_WORKSPACE_ROOT is set, use it
    if [[ -n "$SW_WORKSPACE_ROOT" ]]; then
        if [[ "$SW_WORKSPACE_ROOT" = /* ]]; then
            WORKSPACE="$SW_WORKSPACE_ROOT"
        else
            WORKSPACE="$(cd "$SW_WORKSPACE_ROOT" && pwd)"
        fi
        log_debug "Workspace from SW_WORKSPACE_ROOT: $WORKSPACE"
        return 0
    fi
    
    # 2. Try git rev-parse --show-toplevel
    if command -v git >/dev/null 2>&1; then
        local git_root
        if git_root=$(git rev-parse --show-toplevel 2>/dev/null) && [[ -n "$git_root" ]]; then
            WORKSPACE="$git_root"
            log_debug "Workspace from git: $WORKSPACE"
            return 0
        fi
    fi
    
    # 3. Fallback to PWD
    WORKSPACE="$PWD"
    log_debug "Workspace from PWD: $WORKSPACE"
}

# =============================================================================
# Git hygiene (.git/info/exclude)
# =============================================================================

setup_git_exclude() {
    if [[ "$SW_NO_GIT_EXCLUDE" == "1" ]]; then return 0; fi
    
    if ! command -v git >/dev/null 2>&1; then
        return 0
    fi
    
    # Use git rev-parse --git-path for worktree/submodule support
    local exclude_path
    exclude_path=$(git rev-parse --git-path info/exclude 2>/dev/null) || return 0
    
    if [[ -z "$exclude_path" ]]; then
        return 0
    fi
    
    # Make path absolute if needed
    if [[ "$exclude_path" != /* ]]; then
        exclude_path="$WORKSPACE/$exclude_path"
    fi
    
    # Create parent directory if needed
    local exclude_dir
    exclude_dir=$(dirname "$exclude_path")
    if [[ ! -d "$exclude_dir" ]]; then
        mkdir -p "$exclude_dir" 2>/dev/null || return 0
    fi
    
    # Check if .sandworm/ is already excluded
    if [[ -f "$exclude_path" ]]; then
        if grep -qxF '.sandworm/' "$exclude_path" 2>/dev/null; then
            log_debug ".sandworm/ already in git exclude"
            return 0
        fi
        # Ensure file ends with newline
        if [[ -s "$exclude_path" ]] && [[ "$(tail -c1 "$exclude_path" | wc -l)" -eq 0 ]]; then
            printf '\n' >> "$exclude_path"
        fi
    fi
    
    # Add .sandworm/ to exclude
    printf '.sandworm/\n' >> "$exclude_path"
    log_info "Added .sandworm/ to $exclude_path"
}

# =============================================================================
# Locking
# =============================================================================

acquire_lock() {
    local lock_file="$1"
    local timeout="${2:-0}"
    
    mkdir -p "$(dirname "$lock_file")"
    
    exec 9>"$lock_file"
    if [[ "$timeout" -gt 0 ]]; then
        local deadline=$((SECONDS + timeout))
        while ! flock -n 9 2>/dev/null; do
            if [[ $SECONDS -ge $deadline ]]; then
                return 1
            fi
            sleep 0.5
        done
    else
        flock -n 9 || return 1
    fi
    return 0
}

release_lock() {
    exec 9>&-
}

# =============================================================================
# Podman detection and installation
# =============================================================================

check_podman() {
    if ! command -v podman >/dev/null 2>&1; then
        return 1
    fi
    
    # Verify podman works
    if ! podman --version >/dev/null 2>&1; then
        return 1
    fi
    
    return 0
}

check_podman_rootless() {
    if ! podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null | grep -q true; then
        return 1
    fi
    return 0
}

detect_distro() {
    if [[ -f /etc/os-release ]]; then
        # shellcheck source=/dev/null
        . /etc/os-release
        printf '%s' "${ID:-unknown}"
    else
        printf 'unknown'
    fi
}

get_install_commands() {
    local distro="$1"
    case "$distro" in
        debian|ubuntu|linuxmint|pop)
            printf 'apt-get update && apt-get install -y podman fuse-overlayfs slirp4netns uidmap'
            ;;
        fedora|rhel|centos|rocky|almalinux)
            printf 'dnf install -y podman fuse-overlayfs slirp4netns'
            ;;
        arch|manjaro|endeavouros)
            printf 'pacman -S --noconfirm podman fuse-overlayfs slirp4netns'
            ;;
        opensuse*|sles)
            printf 'zypper install -y podman fuse-overlayfs slirp4netns'
            ;;
        alpine)
            printf 'apk add podman fuse-overlayfs slirp4netns'
            ;;
        nixos)
            # NixOS: prefer profile installs for quick setup; system config is also common.
            printf 'nix profile install nixpkgs#podman nixpkgs#fuse-overlayfs nixpkgs#slirp4netns nixpkgs#uidmap'
            ;;
        *)
            printf ''
            ;;
    esac
}

prompt_install_podman() {
    local distro
    distro=$(detect_distro)
    
    local install_cmd
    install_cmd=$(get_install_commands "$distro")
    local need_sudo=1
    if [[ "$distro" == "nixos" ]]; then
        need_sudo=0
    fi
    
    if [[ -z "$install_cmd" ]]; then
        log_error "Podman not found and automatic installation not supported for: $distro"
        log_error "Please install Podman (and fuse-overlayfs, slirp4netns, uidmap) manually: https://podman.io/docs/installation"
        return 10
    fi
    
    printf '\n'
    log_warn "Podman is not installed. sandworm requires Podman for containerization."
    log_warn "Fallback: If Podman is unavailable but bubblewrap (bwrap) is installed, sandworm can sometimes run in bwrap fallback (less isolated)."
    log_warn "Note: STRICT mode disables bwrap fallback."
    printf '\n'
    printf 'Detected distribution: %s\n' "$distro"
    printf 'Proposed installation command:\n'
    if [[ "$need_sudo" -eq 1 ]]; then
        printf '  sudo %s\n' "$install_cmd"
    else
        printf '  %s\n' "$install_cmd"
    fi
    printf '\n'
    if [[ "$distro" == "nixos" ]]; then
        printf 'NixOS note: you may prefer enabling Podman system-wide:\n'
        printf '  virtualisation.podman.enable = true;\n'
        printf '  environment.systemPackages = [ pkgs.podman pkgs.fuse-overlayfs pkgs.slirp4netns pkgs.uidmap ];\n'
        printf '\n'
    fi
    printf 'Rootless note: ensure /etc/subuid and /etc/subgid contain an entry for your user.\n'
    printf '\n'
    # Noninteractive safety: never block waiting for input.
    local response=""
    if [[ "${SW_ASSUME_YES:-0}" == "1" ]]; then
        log_info "SW_ASSUME_YES=1: proceeding with installation"
        response="y"
    elif [[ ! -t 0 ]]; then
        log_error "No TTY available to prompt for installation. Re-run with SW_ASSUME_YES=1 or install podman manually."
        return 10
    else
        if [[ "$need_sudo" -eq 1 ]]; then
            printf 'Run this command with sudo? [y/N] '
        else
            printf 'Run this command now? [y/N] '
        fi
        read -r response
    fi

    
    if [[ "${response,,}" != "y" && "${response,,}" != "yes" ]]; then
        log_info "Installation declined. Please install podman manually."
        return 10
    fi
    
    if [[ "$need_sudo" -eq 1 ]]; then
        log_info "Running: sudo $install_cmd"
        if ! sudo sh -c "$install_cmd"; then
            log_error "Installation failed"
            return 11
        fi
    else
        log_info "Running: $install_cmd"
        if ! sh -c "$install_cmd"; then
            log_error "Installation failed"
            return 11
        fi
    fi
    
    # Re-check
    if ! check_podman; then
        log_error "Podman still not working after installation"
        return 11
    fi

    log_success "Podman installed successfully"
    return 0
}

