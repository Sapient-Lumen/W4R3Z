        shift
    fi
    export SANDWORM_POSTURE="$posture"

    ensure_runnable

    # Run before-run hook
    run_hook "before-run" "$@" || true

    print_banner "Running command in sandworm (mode: $posture)" "$posture"
    run_in_container_posture "$posture" "$@"

    local exit_code=$?

    # Run after-run hook
    run_hook "after-run" "$exit_code" || true

    return $exit_code
}


cmd_develop() {
    local posture="safe"
    if [[ "${1:-}" == "--unsafe" ]]; then
        posture="unsafe"
        shift
    fi
    ensure_runnable "nix"
    run_in_container_posture "$posture" nix develop
}

cmd_logs() {
    local list_mode=0
    if [[ "${1:-}" == "--list" ]]; then list_mode=1; fi
    
    local logs_dir="$CONTROL/logs"
    
    if [[ ! -d "$logs_dir" ]]; then
        log_info "No logs found"
        return 0
    fi
    
    if [[ $list_mode -eq 1 ]]; then
        printf 'Available logs:\n'
        ls -lt "$logs_dir"/*.log 2>/dev/null | head -20
    else
        local latest
        latest=$(ls -t "$logs_dir"/*.log 2>/dev/null | head -1)
        if [[ -n "$latest" ]]; then
            if command -v less >/dev/null 2>&1 && [[ -t 1 ]]; then
                less "$latest"
            else
                cat "$latest"
            fi
        else
            log_info "No logs found"
        fi
    fi
}

cmd_gc() {
    gc_toolroots
    
    # Also prune old logs
    local logs_dir="$CONTROL/logs"
    if [[ -d "$logs_dir" ]]; then
        find "$logs_dir" -name "*.log" -mtime +7 -delete 2>/dev/null || true
        log_info "Pruned logs older than 7 days"
    fi
}

cmd_nuke() {
    if [[ ! -d "$CONTROL" ]]; then
        log_info "Nothing to remove - .sandworm/ does not exist"
        return 0
    fi
    
    printf 'This will delete %s and all sandworm state.\n' "$CONTROL"
    printf 'Your project files will NOT be affected.\n'
    
    if [[ "${SW_ASSUME_YES:-0}" == "1" ]]; then
        log_info "SW_ASSUME_YES=1: proceeding with deletion"
    elif [[ ! -t 0 ]]; then
        log_error "No TTY available to confirm. Re-run with SW_ASSUME_YES=1 to skip prompt."
        return 1
    else
        printf 'Continue? [y/N] '
        local response
        read -r response
        if [[ "${response,,}" != "y" && "${response,,}" != "yes" ]]; then
            log_info "Cancelled"
            return 0
        fi
    fi
    
    log_info "Removing $CONTROL..."
    
    # Also clean up the tmpfs runroot (ephemeral, but let's be thorough)
    local workspace_hash
    if command -v sha256sum >/dev/null 2>&1; then
        workspace_hash=$(printf '%s' "$WORKSPACE" | sha256sum | cut -c1-12)
    elif command -v shasum >/dev/null 2>&1; then
        workspace_hash=$(printf '%s' "$WORKSPACE" | shasum -a 256 | cut -c1-12)
    else
        workspace_hash=$(printf '%s' "$WORKSPACE" | cksum | cut -d' ' -f1)
    fi
    local runtime_base="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    local tmpfs_runroot="$runtime_base/sandworm-$workspace_hash"
    if [[ -d "$tmpfs_runroot" ]]; then
        rm -rf "$tmpfs_runroot" 2>/dev/null || true
        log_debug "Removed tmpfs runroot: $tmpfs_runroot"
    fi
    
    # Try method 1: simple rm (works if no permission issues)
    rm -rf "$CONTROL" 2>/dev/null || true
    if [[ ! -d "$CONTROL" ]]; then
        log_success "Removed $CONTROL"
        return 0
    fi
    
    # Try method 2: podman unshare (for rootless podman UID mapped files)
    if command -v podman >/dev/null 2>&1; then
        log_debug "Simple rm failed, trying podman unshare..."
        podman unshare rm -rf "$CONTROL" 2>/dev/null || true
        if [[ ! -d "$CONTROL" ]]; then
            log_success "Removed $CONTROL (via podman unshare)"
            return 0
        fi
    fi
    
    # Try method 3: rm inside a container (for files created by container root)
    if command -v podman >/dev/null 2>&1; then
        log_debug "podman unshare failed, trying rm inside container..."
        local control_parent control_name
        control_parent=$(dirname "$CONTROL")
        control_name=$(basename "$CONTROL")
        
        # Use a minimal image that's likely to be available
        for img in "debian:bookworm-slim" "alpine:latest" "busybox:latest"; do
            if podman run --rm \
                --security-opt label=disable \
                -v "$control_parent:/mnt/parent:rw" \
                "$img" \
                rm -rf "/mnt/parent/$control_name" 2>/dev/null; then
                if [[ ! -d "$CONTROL" ]]; then
                    log_success "Removed $CONTROL (via container)"
                    return 0
                fi
            fi
        done
    fi
    
    # Try method 4: sudo (last resort)
    log_debug "Container methods failed, trying sudo..."
    if command -v sudo >/dev/null 2>&1; then
        if sudo -n true 2>/dev/null; then
            sudo -n rm -rf "$CONTROL"
        elif [[ -t 0 ]]; then
            log_warn "Attempting sudo rm (may prompt for password)..."
            sudo rm -rf "$CONTROL"
        else
            die "Failed to delete $CONTROL (permission denied) and no TTY for sudo."
        fi
        
        if [[ ! -d "$CONTROL" ]]; then
            log_success "Removed $CONTROL (via sudo)"
            return 0
        fi
    fi
    
    die "Failed to delete $CONTROL. You may need to manually remove it with: sudo rm -rf '$CONTROL'"
}

cmd_version() {
