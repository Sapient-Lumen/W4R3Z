cmd_refresh() {
    export SANDWORM_CURRENT_COMMAND="refresh"

    log_info "Starting refresh..."
    _STEP_COUNT=0  # Reset step counter

    # Check for debug flags
    local force_rebuild=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --debug|-d) SW_DEBUG_LEVEL=2; shift ;;
            --trace) SW_DEBUG_LEVEL=3; shift ;;
            --force|-f) force_rebuild=1; shift ;;
            *) shift ;;
        esac
    done

    # Run before-refresh hook
    run_hook "before-refresh" || true
    
    # Check if this is a forced rebuild when toolroot already exists
    local current_rev
    current_rev=$(get_state "SW_REV_CURRENT" "")
    local current_state
    current_state=$(get_state "SW_STATE" "UNINITIALIZED")
    
    if [[ "$force_rebuild" -eq 0 && "$current_state" == "HEALTHY" && -n "$current_rev" && -d "$CONTROL/toolroots/$current_rev" ]]; then
        log_info "Toolroot already exists and is healthy: $current_rev"
        log_info "Use 'sandworm refresh --force' to rebuild anyway"
        
        # Show current toolroot info
        printf '\n'
        printf '  Current toolroot: %s\n' "$current_rev"
        printf '  Seed image:       %s\n' "$SEED_TAG"
        printf '\n'
        print_available_commands
        printf '\n'
        return 0
    fi
    
    dump_debug_state "refresh-start"
    
    # Acquire lock
    step_start "Acquiring refresh lock"
    local lock_file="$CONTROL/locks/refresh.lock"
    if ! acquire_lock "$lock_file" 0; then
        step_fail "Refresh already in progress (locked)"
        log_error "Another sandworm refresh is running. If this is wrong, remove: $lock_file"
        exit 40
    fi
    step_done
    
    # Clean up any stale staging directories from interrupted refreshes (§19.3)
    local stale_staging
    while IFS= read -r -d '' stale_staging; do
        log_warn "Removing stale staging directory: $(basename "$stale_staging")"
        cleanup_staging_dir "$stale_staging"
    done < <(find "$CONTROL/toolroots" -maxdepth 1 -type d -name "*.staging" -print0 2>/dev/null)
    
    # Check podman
    step_start "Checking Podman availability"
    if ! check_podman; then
        step_fail "Podman not found"
        if ! prompt_install_podman; then
            release_lock
            exit 10
        fi
    fi
    step_done
    log_debug "Podman: $(podman --version 2>&1 || echo 'unknown')"
    
    # Check offline mode
    if [[ "$SW_OFFLINE" == "1" ]]; then
        log_warn "Offline mode: skipping downloads, validating existing toolroot"
        local current_rev
        current_rev=$(get_state "SW_REV_CURRENT" "")
        if [[ -z "$current_rev" ]]; then
            release_lock
            die "No toolroot available and offline mode is enabled"
        fi
        
        local toolroot_dir="$CONTROL/toolroots/$current_rev"
        if ! validate_toolroot "$toolroot_dir"; then
            release_lock
            die "Toolroot validation failed in offline mode"
        fi
        
        write_state_json "$CONTROL/state.json"
        release_lock
        log_success "Offline validation complete"
        return 0
    fi
    
    # Ensure seed image
    step_start "Ensuring seed image exists"
    if ! ensure_seed_image; then
        step_fail "Could not build/find seed image"
        release_lock
        exit 20
    fi
    step_done
    
    # Create and hydrate toolroot
    step_start "Creating toolroot staging directory"
    local rev_id
    rev_id=$(create_toolroot_staging)
    log_debug "Toolroot revision: $rev_id"
    step_done
    
    step_start "Running hydration (installing tools)"
    log_info "  This may take several minutes on first run..."
    if ! run_hydration "$rev_id"; then
        step_fail "Hydration failed"
        # run_hydration already cleaned up, but try again just in case
        cleanup_staging_dir "$CONTROL/toolroots/${rev_id}.staging"
        set_state "SW_STATE" "NEEDS_BUILD"
        set_state "SW_LAST_ERROR" "Hydration failed"
        write_state_json "$CONTROL/state.json"
        release_lock
        log_error ""
        log_error "Hydration failed. Common causes and solutions:"
        log_error "  • Network issues: Try SW_NETWORK_MODE=none sandworm refresh --force"
        log_error "  • DNS problems: Check /etc/resolv.conf or try SW_REFRESH_NETWORK=bridge"
        log_error "  • Disk full: Check df -h $CONTROL"
        log_error "  • Timeout: Try SW_PODMAN_TIMEOUT=600 sandworm refresh --force"
        log_error ""
        log_error "For more details, check the log: $LOG_FILE"
        exit 21
    fi
    step_done

    # Validate
    local staging_dir="$CONTROL/toolroots/${rev_id}.staging"
    if ! validate_toolroot "$staging_dir"; then
        cleanup_staging_dir "$staging_dir"
        set_state "SW_STATE" "NEEDS_BUILD"
        set_state "SW_LAST_ERROR" "Validation failed"
        write_state_json "$CONTROL/state.json"
        release_lock
        log_error ""
        log_error "Validation failed. Common causes and solutions:"
        log_error "  • Container runtime issues: Try 'podman system reset' (WARNING: destroys images)"
        log_error "  • Storage driver problems: Check 'podman info' output"
        log_error "  • Permission issues: Try 'sandworm nuke' then refresh"
        log_error ""
        log_error "For more details, check the log: $LOG_FILE"
        log_error "For verbose output: SW_DEBUG_LEVEL=3 sandworm refresh --force"
        exit 22
    fi
    
    # Activate
    step_start "Activating toolroot"
    activate_toolroot "$rev_id"
    step_done
    
    # Update state
    step_start "Updating state"
    local prev_seed prev_rootfs
    prev_seed="$(get_state "SW_SEED_TAG" "")"
    prev_rootfs="$(get_state "SW_ROOTFS_TAG" "")"
    set_state "SW_SCRIPT_HASH" "$SCRIPT_HASH"
    set_state "SW_SEED_TAG" "$SEED_TAG"
    set_state "SW_SCRIPT_DRIFT" "0"  # Clear any drift flag
    set_state "SW_LAST_ERROR" ""    # Clear any previous error
    # Rootfs image tag (persists apt installs, etc.). Reset when seed tag changes.
    if [[ -z "$prev_rootfs" || -z "$prev_seed" || "$prev_seed" != "$SEED_TAG" ]]; then
        set_state "SW_ROOTFS_TAG" "$SEED_TAG"
    fi
    set_state "SW_BACKEND" "podman"
    write_state_json "$CONTROL/state.json"
    step_done
    
    # GC
    step_start "Garbage collecting old toolroots"
    gc_toolroots
    step_done
    
    release_lock
    
    dump_debug_state "refresh-complete"

    # Run after-refresh hook
    run_hook "after-refresh" "$rev_id" || true

    # Show completion message with available commands
    log_success "Refresh complete!"
    printf '\n'
    printf '  Toolroot:    %s\n' "$rev_id"
    printf '  Seed image:  %s\n' "$SEED_TAG"
    printf '\n'
    print_available_commands
    printf '\n'
}

ensure_runnable() {
    local required_cli="${1:-}"
    
    local state
    state=$(get_state "SW_STATE" "UNINITIALIZED")
    
    local current_rev
    current_rev=$(get_state "SW_REV_CURRENT" "")
    
    # Check for script drift (script was updated but toolroot still works)
    local script_drift
    script_drift=$(get_state "SW_SCRIPT_DRIFT" "")
    if [[ "$script_drift" == "1" && -n "$current_rev" && -d "$CONTROL/toolroots/$current_rev" ]]; then
        log_debug "Script changed since last refresh, but existing toolroot is still valid"
        log_debug "Run 'sandworm refresh --force' to rebuild with the new script"
    fi
    
    # Check if refresh needed
    if [[ "$state" == "UNINITIALIZED" || "$state" == "NEEDS_BUILD" ]]; then
        if [[ "$state" == "UNINITIALIZED" ]]; then
            log_info "First run detected - building sandworm environment..."
            log_info ""
            log_info "  Estimated time breakdown:"
            log_info "    Base image pull:     ~1-2 min (depends on connection)"
            log_info "    Node.js install:     ~30 sec"
            log_info "    Agent CLIs:          ~1-2 min"
            log_info "    Rust toolchain:      ~2-3 min"
            log_info "    Nix portable:        ~1 min"
            log_info "    ─────────────────────────────"
            log_info "    Total:               ~5-10 min"
            log_info ""
        else
            log_info "Environment marked for rebuild, running refresh..."
        fi
        if ! command -v podman >/dev/null 2>&1; then
            if [[ "${SW_STRICT:-0}" == "1" ]]; then
                die "STRICT mode requires Podman for refresh/build"
            fi
            if ensure_bwrap_available; then
                log_warn "Podman is not available, so refresh cannot run. Will try bubblewrap fallback if a toolroot already exists."
            else
                die "Podman is required for refresh/build, and bubblewrap is not available."
            fi
        else
            cmd_refresh --force
        fi
    fi
    
    # Re-read state after potential refresh
    parse_state_json "$CONTROL/state.json"
    
    # Check required CLI
    if [[ -n "$required_cli" ]]; then
        local cli_ok
        cli_ok=$(get_state "SW_${required_cli^^}_OK" "0")
        if [[ "$cli_ok" -ne 1 ]]; then
            die "$required_cli is not available. Run 'sandworm refresh' to install."
        fi
    fi
}


