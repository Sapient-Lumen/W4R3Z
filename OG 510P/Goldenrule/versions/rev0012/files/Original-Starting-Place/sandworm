# Debug level: 0=off, 1=basic, 2=verbose, 3=trace (shows commands)
SW_DEBUG_LEVEL="${SW_DEBUG_LEVEL:-0}"

# Timeout for podman operations (seconds). 0 = no timeout.
SW_PODMAN_TIMEOUT="${SW_PODMAN_TIMEOUT:-300}"

log_trace() {
    local msg="[TRACE] $*"
    if [[ "${SW_DEBUG_LEVEL:-0}" -ge 3 ]]; then
        _print_stderr "90" "$msg"
    fi
    _log_raw "$msg"
}

# Show a command before running it (for debugging)
debug_cmd() {
    if [[ "${SW_DEBUG_LEVEL:-0}" -ge 3 ]]; then
        _print_stderr "90" "[CMD] $*"
    fi
    _log_raw "[CMD] $*"
}

# Run a command with optional timeout and capture output
# Usage: run_with_timeout <timeout_secs> <output_var> <error_var> <cmd...>
# Returns: exit code of command, or 124 on timeout
run_with_timeout() {
    local timeout_secs="$1"; shift
    local -n _stdout_var="$1"; shift
    local -n _stderr_var="$1"; shift
    local cmd=("$@")
    
    local stdout_file stderr_file
    stdout_file=$(mktemp)
    stderr_file=$(mktemp)
    
    local rc=0
    debug_cmd "${cmd[*]}"
    
    if [[ "$timeout_secs" -gt 0 ]] && command -v timeout >/dev/null 2>&1; then
        timeout "$timeout_secs" "${cmd[@]}" >"$stdout_file" 2>"$stderr_file" || rc=$?
    else
        "${cmd[@]}" >"$stdout_file" 2>"$stderr_file" || rc=$?
    fi
    
    _stdout_var=$(cat "$stdout_file")
    _stderr_var=$(cat "$stderr_file")
    rm -f "$stdout_file" "$stderr_file"
    
    if [[ $rc -eq 124 ]]; then
        log_error "Command timed out after ${timeout_secs}s: ${cmd[*]}"
    fi
    
    return $rc
}

# Dump system state for debugging
dump_debug_state() {
    local label="${1:-debug-state}"
    
    if [[ "${SW_DEBUG_LEVEL:-0}" -lt 2 ]]; then
        return 0
    fi
    
    log_debug "=== DEBUG STATE DUMP: $label ==="
    
    # Podman info
    if [[ -n "${PODMAN_BIN:-}" ]] && command -v "$PODMAN_BIN" >/dev/null 2>&1; then
        log_debug "Podman version: $("$PODMAN_BIN" --version 2>&1 || echo 'error')"
        log_debug "Podman info (brief):"
        "$PODMAN_BIN" info --format '{{.Host.OS}} {{.Host.Arch}} {{.Host.CgroupsVersion}} rootless={{.Host.Security.Rootless}}' 2>&1 | sed 's/^/  /' | while read -r line; do log_debug "  $line"; done
    fi
    
    # Storage config
    if [[ -n "${CONTAINERS_STORAGE_CONF:-}" ]]; then
        log_debug "Storage conf: $CONTAINERS_STORAGE_CONF"
        if [[ -f "$CONTAINERS_STORAGE_CONF" ]]; then
            log_debug "Storage config contents:"
            cat "$CONTAINERS_STORAGE_CONF" 2>&1 | sed 's/^/  /' | while read -r line; do log_debug "  $line"; done
        fi
    fi
    
    # Environment
    log_debug "Key env vars:"
    log_debug "  XDG_DATA_HOME=${XDG_DATA_HOME:-<unset>}"
    log_debug "  XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-<unset>}"
    log_debug "  XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-<unset>}"
    log_debug "  TMPDIR=${TMPDIR:-<unset>}"
    log_debug "  HOME=${HOME:-<unset>}"
    
    # Disk space
    log_debug "Disk space (control plane):"
    df -h "$CONTROL" 2>&1 | sed 's/^/  /' | while read -r line; do log_debug "  $line"; done
    
    log_debug "=== END DEBUG STATE DUMP ==="
}

# Step progress helper for long operations
declare -g _STEP_COUNT=0
declare -g _STEP_START_TIME=0

step_start() {
    local name="$1"
    _STEP_COUNT=$((_STEP_COUNT + 1))
    _STEP_START_TIME=$(date +%s)
    log_info "[$_STEP_COUNT] $name..."
}

step_done() {
    local elapsed=$(($(date +%s) - _STEP_START_TIME))
    log_debug "  └─ completed in ${elapsed}s"
    if [[ "${SW_PROFILE:-0}" == "1" ]]; then
        log_info "  └─ completed in ${elapsed}s"
    fi
}

step_fail() {
    local msg="${1:-failed}"
    local elapsed=$(($(date +%s) - _STEP_START_TIME))
    log_error "  └─ $msg (after ${elapsed}s)"
}

# Progress bar for long operations (hydration, etc.)
declare -g _PROGRESS_TOTAL=0
declare -g _PROGRESS_CURRENT=0
declare -g _PROGRESS_LABEL=""
declare -g _PROGRESS_START_TIME=0

progress_init() {
    local total="$1"
    local label="$2"
    _PROGRESS_TOTAL="$total"
    _PROGRESS_CURRENT=0
    _PROGRESS_LABEL="$label"
    _PROGRESS_START_TIME=$(date +%s)
    _progress_draw ""
}

progress_tick() {
    local sublabel="${1:-}"
    _PROGRESS_CURRENT=$((_PROGRESS_CURRENT + 1))
    _progress_draw "$sublabel"
}

progress_set() {
    local current="$1"
    local sublabel="${2:-}"
    _PROGRESS_CURRENT="$current"
    _progress_draw "$sublabel"
}

_progress_draw() {
    local sublabel="${1:-}"
    [[ "${SW_VERBOSE:-1}" -ge 1 ]] || return 0

    local pct=0
    if [[ $_PROGRESS_TOTAL -gt 0 ]]; then
        pct=$(( (_PROGRESS_CURRENT * 100) / _PROGRESS_TOTAL ))
    fi

    # Simple bar: [████████░░░░░░░░░░░░] 40% Installing Node.js
    local filled=$(( pct / 5 ))
    local empty=$(( 20 - filled ))
    local bar=""
    for ((i=0; i<filled; i++)); do bar+="█"; done
    for ((i=0; i<empty; i++)); do bar+="░"; done

    local msg="  [$bar] ${pct}%"
    [[ -n "$_PROGRESS_LABEL" ]] && msg+=" $_PROGRESS_LABEL"
    [[ -n "$sublabel" ]] && msg+=": $sublabel"

    # Overwrite line (only if TTY and not in debug mode)
    if [[ -t 2 && "${SW_DEBUG_LEVEL:-0}" -lt 2 ]]; then
        printf '\r\033[K%s' "$msg" >&2
    else
        printf '%s\n' "$msg" >&2
    fi
}

progress_done() {
    local elapsed=$(( $(date +%s) - _PROGRESS_START_TIME ))
    if [[ -t 2 && "${SW_DEBUG_LEVEL:-0}" -lt 2 ]]; then
        printf '\r\033[K' >&2
    fi
    log_debug "Progress complete: $_PROGRESS_LABEL (${elapsed}s)"
    _PROGRESS_TOTAL=0
    _PROGRESS_CURRENT=0
    _PROGRESS_LABEL=""
}

# =============================================================================
# Error handling
# =============================================================================

_cleanup() {
    local exit_code=$?
    if [[ $exit_code -ne 0 ]]; then
        log_error "Command failed with exit code $exit_code"
        if [[ -n "${LOG_FILE:-}" ]]; then
            log_error "See log at: $LOG_FILE"
        fi
    fi
}

trap _cleanup EXIT

_error_handler() {
    local line_no=$1
    log_error "Failed at line $line_no"
}

trap '_error_handler $LINENO' ERR

