# =============================================================================
# Control plane initialization
# =============================================================================

init_ephemeral_log() {
    # Minimal host-side log for commands that must work without a writable workspace
    # (e.g. `sandworm help` / `sandworm version`).
    local timestamp
    timestamp=$(date -u +%Y%m%d-%H%M%S)
    local log_dir="${TMPDIR:-/tmp}/sandworm-logs"
    mkdir -p "$log_dir" 2>/dev/null || true
    LOG_FILE="$log_dir/${timestamp}-${COMMAND:-init}.log"
    : >"$LOG_FILE" 2>/dev/null || true
}

init_control_plane() {
    CONTROL="$WORKSPACE/.sandworm"
    
    # Check workspace is writable
    if [[ ! -w "$WORKSPACE" ]]; then
        log_error "Workspace is not writable: $WORKSPACE"
        exit 12
    fi
    
    # Create directory structure with secure permissions
    local dirs=(
        "$CONTROL"
        "$CONTROL/logs"
        "$CONTROL/locks"
        "$CONTROL/home"
        "$CONTROL/home/.cache"
        "$CONTROL/home/.config"
        "$CONTROL/toolroots"
        "$CONTROL/podman/storage"
        "$CONTROL/podman/tmp"
        "$CONTROL/podman/xdg"
        "$CONTROL/hooks"
        "$CONTROL/hooks-empty"
        "$CONTROL/hooks-nvidia"
        "$CONTROL/mask-empty"
    )
    
    for dir in "${dirs[@]}"; do
        if [[ ! -d "$dir" ]]; then
            if ! mkdir -p "$dir" 2>/dev/null; then
                # Check if this is because .sandworm is masked (running nested)
                if [[ "$dir" == "$CONTROL"* ]] && mount | grep -q "$CONTROL.*tmpfs.*ro"; then
                    cat >&2 <<MASKED

╔══════════════════════════════════════════════════════════════════╗
║  ⚠ Cannot write to .sandworm directory (control plane masked)   ║
╚══════════════════════════════════════════════════════════════════╝

ERROR: Failed to create directory: $dir

The .sandworm control plane is currently masked (read-only tmpfs overlay).
This usually means you're trying to run sandworm from inside an existing
sandworm container, where the control plane is intentionally hidden.

Solutions:
  • Run sandworm commands from the HOST, not from inside a container
  • If you need a different workspace, set SW_WORKSPACE_ROOT:
    SW_WORKSPACE_ROOT=/other/path ./sandworm <command>
  • If this is unexpected, check: mount | grep sandworm

MASKED
                    exit 12
                fi

                echo "ERROR: Failed to create directory: $dir" >&2
                echo "" >&2
                echo "Possible causes:" >&2
                echo "  • Workspace '$WORKSPACE' is read-only" >&2
                echo "  • Insufficient permissions on parent directory" >&2
                echo "  • Disk is full" >&2
                echo "" >&2
                echo "Solutions:" >&2
                echo "  • Set SW_WORKSPACE_ROOT to a writable directory" >&2
                echo "  • Check permissions: ls -la '$WORKSPACE'" >&2
                echo "  • Check disk space: df -h '$WORKSPACE'" >&2
                exit 12
            fi
            chmod 700 "$dir"
        fi
    done

    # mask-empty needs to be writable by container user
    chmod 755 "$CONTROL/mask-empty"

    # Initialize log file
    local timestamp
    timestamp=$(date -u +%Y%m%d-%H%M%S)
    LOG_FILE="$CONTROL/logs/${timestamp}-${COMMAND:-init}.log"
    if ! touch "$LOG_FILE" 2>/dev/null; then
        echo "ERROR: Failed to create log file: $LOG_FILE" >&2
        echo "  Check write permissions on: $CONTROL/logs/" >&2
        exit 12
    fi
    chmod 600 "$LOG_FILE"

    log_info "Log: $LOG_FILE"
    
    # Load state
    local state_file="$CONTROL/state.json"
    if [[ -f "$state_file" ]]; then
        if ! parse_state_json "$state_file"; then
            log_warn "Failed to parse state.json, treating as uninitialized"
            local bad_file="$state_file.bad.$(date -u +%s)"
            mv "$state_file" "$bad_file"
            STATE=()
        fi
    fi
    
    # Compute script hash for drift detection
    SCRIPT_HASH=$(compute_hash "$SCRIPT_PATH")
    
    # Check for script drift (sandworm script was updated)
    local stored_hash
    stored_hash=$(get_state "SW_SCRIPT_HASH" "")
    local current_state
    current_state=$(get_state "SW_STATE" "UNINITIALIZED")
    local current_rev
    current_rev=$(get_state "SW_REV_CURRENT" "")
    
    if [[ -n "$stored_hash" && "$stored_hash" != "$SCRIPT_HASH" ]]; then
        # Script changed. Check if we have a working toolroot.
        if [[ -n "$current_rev" && -d "$CONTROL/toolroots/$current_rev" ]]; then
            # We have a toolroot. Don't force rebuild, just warn.
            # The toolroot is probably still fine; only the sandworm script changed.
            log_debug "Script hash changed but existing toolroot found: $current_rev"
            log_debug "  Old hash: $stored_hash"
            log_debug "  New hash: $SCRIPT_HASH"
            # Mark as SCRIPT_DRIFT but don't force rebuild
            set_state "SW_SCRIPT_DRIFT" "1"
            # Keep the existing state (HEALTHY/DEGRADED) - don't mark NEEDS_BUILD
        else
            # No toolroot exists, so we need to build anyway
            log_info "Script changed and no toolroot found, marking for rebuild"
            set_state "SW_STATE" "NEEDS_BUILD"
        fi
    fi
    
    # Set computed values.
    # Use a fully qualified localhost tag to avoid Podman short-name prompts and accidental pulls.
    local seed_hash
    seed_hash="$(printf '%s' "$SCRIPT_HASH" | cut -c1-12)"
    SEED_TAG_SHORT="sandworm-seed:${seed_hash}"
    SEED_TAG="localhost/${SEED_TAG_SHORT}"
    
    log_debug "Control plane initialized at: $CONTROL"
}

# =============================================================================
# Seed image management
# =============================================================================

build_seed_image() {
    log_info "Building seed image: $SEED_TAG"
    log_debug "Base image: $SW_SEED_BASE_IMAGE"
    
    local dockerfile
    dockerfile=$(cat <<'DOCKERFILE_EOF'
FROM __BASE_IMAGE__

# Install packages in a single layer (faster than multiple apt-get update runs).
RUN set -eu; \
    echo "[seed] apt-get update..." && apt-get update; \
    echo "[seed] Installing tier 0 (must-have) packages..." && \
    apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      curl \
      wget \
      git \
      git-lfs \
      locales \
      python3 \
      python3-pip \
      python3-venv \
      build-essential \
      jq \
      xz-utils \
      tar \
      gzip \
      && echo "[seed] Tier 0 complete"; \
    echo "[seed] Installing tier 1 (should-have) packages..." && \
    (apt-get install -y --no-install-recommends \
      vim-tiny \
      nano \
      ripgrep \
      fd-find \
      fzf \
      tree \
      strace \
      lsof \
      procps \
      util-linux \
      bubblewrap \
      proot \
      fakeroot \
      htop \
      dnsutils \
      netcat-openbsd \
      socat \
      iproute2 \
      zip \
      unzip \
      zstd \
      sqlite3 \
      file \
      bc \
      less \
      || echo "[seed] Some tier 1 packages failed (non-fatal)") \
      && echo "[seed] Tier 1 complete"; \
    echo "[seed] Installing tier 2 (nice-to-have) packages..." && \
    (apt-get install -y --no-install-recommends \
      tmux \
      tig \
      man-db \
      openssh-client \
      || echo "[seed] Some tier 2 packages failed (non-fatal)") \
      && echo "[seed] Tier 2 complete"; \
    rm -rf /var/lib/apt/lists/*

# Set up locale
RUN echo "[seed] Configuring locale..." && \
    sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen && \
    echo "[seed] Locale configured"
ENV LANG=en_US.UTF-8 LANGUAGE=en_US:en LC_ALL=en_US.UTF-8

# Create sandworm user (will be overridden by keep-id)
RUN echo "[seed] Creating sandworm user..." && \
    useradd -m -s /bin/bash -u 1000 sandworm || true && \
    echo "[seed] User created"

# Set up directory structure
RUN echo "[seed] Creating directory structure..." && \
    mkdir -p /workspace /opt/llm/bin /home/sandworm \
    && chmod 755 /workspace /opt/llm && \
    echo "[seed] Directories created"

# Ensure login shells keep Sandworm tool PATH (bash -l/-lc resets PATH via /etc/profile).
# Dockerfile RUN cannot safely embed a multiline shell heredoc without tripping the Dockerfile parser,
# so emit the file using printf.
RUN echo "[seed] Installing Sandworm PATH profile..." && \
    mkdir -p /etc/profile.d && \
    printf '%s\n' \
      '#!/bin/sh' \
      '# Keep Sandworm toolroot on PATH even for login shells.' \
      'SW_HOME="${HOME:-/home/sandworm}"' \
      '# Ensure /usr/games is in PATH (Debian puts some packages there like sl, cowsay)' \
      'case ":${PATH}:" in' \
      '  *:/usr/games:*) ;;' \
      '  *) export PATH="${PATH}:/usr/games" ;;' \
      'esac' \
      'case ":${PATH}:" in' \
      '  *:/opt/llm/bin:*) ;;' \
      '  *) export PATH="${SW_HOME}/.nix-profile/bin:${SW_HOME}/.npm-global/bin:${SW_HOME}/.local/bin:${SW_HOME}/.cargo/bin:/opt/llm/bin:${PATH}" ;;' \
      'esac' \
      'export USER="${USER:-sandworm}"' \
      > /etc/profile.d/sandworm-path.sh && \
    chmod 0644 /etc/profile.d/sandworm-path.sh && \
    echo "[seed] Sandworm PATH profile installed"

WORKDIR /workspace
DOCKERFILE_EOF
)
    
    # Ensure podman storage is configured
    ensure_podman_storage
    
    # Build the image
    local build_dir="$CONTROL/podman/tmp/build.$$"
    mkdir -p "$build_dir"
    # Replace placeholder with actual base image
    dockerfile="${dockerfile/__BASE_IMAGE__/$SW_SEED_BASE_IMAGE}"
    
    printf '%s\n' "$dockerfile" > "$build_dir/Dockerfile"
    
    # Podman build defaults can be surprisingly slow depending on the host network stack.
    # Default to host networking for "just works" speed; override with SW_REFRESH_NETWORK.
    local build_net="${SW_REFRESH_NETWORK:-host}"
    if ! $PODMAN_BIN build --network "$build_net" -t "$SEED_TAG" -f "$build_dir/Dockerfile" "$build_dir" 2>&1 | sed 's/^/  /' | {
        if [[ -n "${LOG_FILE:-}" ]]; then
            tee -a "$LOG_FILE"
        else
            cat
        fi
    }; then
        rm -rf "$build_dir"
        return 20
    fi
    
    rm -rf "$build_dir"
    log_success "Seed image built: $SEED_TAG"
    return 0
}

ensure_seed_image() {
    # Ensure storage is configured first
    ensure_podman_storage
    
    # Check if image exists
    if $PODMAN_BIN image exists "$SEED_TAG" 2>/dev/null; then
        log_debug "Seed image exists: $SEED_TAG"
        return 0
    fi

    # Back-compat: older sandworm versions may have created an unqualified short tag.
    # Retag to localhost to prevent ambiguous resolution / remote pulls.
    if [[ -n "${SEED_TAG_SHORT:-}" ]] && $PODMAN_BIN image exists "$SEED_TAG_SHORT" 2>/dev/null; then
        log_debug "Seed image exists under short tag; retagging: $SEED_TAG_SHORT -> $SEED_TAG"
        $PODMAN_BIN tag "$SEED_TAG_SHORT" "$SEED_TAG" 2>/dev/null || true
        if $PODMAN_BIN image exists "$SEED_TAG" 2>/dev/null; then
            return 0
        fi
    fi
    
    build_seed_image
}

# Configure podman storage for project-local use
ensure_podman_storage() {
    local try_mode="${1:-}"
    local storage_conf="$CONTROL/podman/xdg/containers/storage.conf"

    # Memoize successful initialization within this sandworm process to avoid
    # repeatedly calling `podman info` (can be slow on some systems).
    if [[ "${SW_PODMAN_STORAGE_READY:-0}" == "1" ]]; then
        export CONTAINERS_STORAGE_CONF="$storage_conf"
        export XDG_DATA_HOME="$CONTROL/podman/xdg"
        export XDG_CONFIG_HOME="$CONTROL/podman/xdg"
        export TMPDIR="$CONTROL/podman/tmp"
        return 0
    fi


    if [[ -z "${PODMAN_BIN:-}" ]]; then
        PODMAN_BIN="$(command -v podman 2>/dev/null || true)"
    fi
    if [[ -z "${PODMAN_BIN:-}" ]]; then
        if [[ "$try_mode" == "--try" ]]; then
            log_warn "podman not found; falling back if possible"
            return 1
        fi
        die "podman not found in PATH"
    fi
    
    # Export podman config paths
    export CONTAINERS_STORAGE_CONF="$storage_conf"
    export XDG_DATA_HOME="$CONTROL/podman/xdg"
    export XDG_CONFIG_HOME="$CONTROL/podman/xdg"
    export TMPDIR="$CONTROL/podman/tmp"
    
    # If config exists, reuse it, but repair if it is broken.
    if [[ -f "$storage_conf" ]]; then
        log_debug "Using existing storage config: $storage_conf"
        if "$PODMAN_BIN" info >/dev/null 2>&1; then
            export SW_PODMAN_STORAGE_READY=1
            return 0
        fi
        log_warn "Existing podman storage config looks unhealthy; rebuilding ($storage_conf)"
        rm -f "$storage_conf" 2>/dev/null || true
    fi
    
    mkdir -p "$(dirname "$storage_conf")"
    
    # Detect storage driver and fuse-overlayfs location
    local storage_driver="${SW_STORAGE_DRIVER:-auto}"
    local fuse_overlayfs_path=""
    if [[ "$storage_driver" == "auto" ]]; then
        storage_driver="overlay"
    fi
    
    # Find fuse-overlayfs dynamically (works on NixOS, FHS systems, etc.)
    if command -v fuse-overlayfs >/dev/null 2>&1; then
        fuse_overlayfs_path=$(command -v fuse-overlayfs)
        log_debug "Found fuse-overlayfs at: $fuse_overlayfs_path"
    else
        log_debug "fuse-overlayfs not found"
    fi

    # Check kernel version for native overlay support (5.11+)
    local kmaj kmin native_overlay_ok=0
    IFS=. read -r kmaj kmin _rest < <(uname -r)
    kmaj="${kmaj:-0}"; kmin="${kmin:-0}"
    if [[ "$kmaj" -gt 5 || ( "$kmaj" -eq 5 && "$kmin" -ge 11 ) ]]; then
        native_overlay_ok=1
        log_debug "Kernel $(uname -r) supports native rootless overlay"
    fi

    # Decide whether to use fuse-overlayfs:
    # - On kernel 5.11+: prefer native overlay (faster, avoids btrfs/mqueue bugs with fuse-overlayfs)
    # - On older kernels: require fuse-overlayfs for overlay driver, else fall back to vfs
    # - SW_FORCE_FUSE_OVERLAYFS=1: override to use fuse-overlayfs even on modern kernels
    local use_fuse_overlayfs=0
    if [[ "$storage_driver" == "overlay" ]]; then
        if [[ "${SW_FORCE_FUSE_OVERLAYFS:-0}" == "1" && -n "$fuse_overlayfs_path" ]]; then
            # User explicitly requested fuse-overlayfs
            use_fuse_overlayfs=1
            log_debug "Using fuse-overlayfs (SW_FORCE_FUSE_OVERLAYFS=1)"
        elif [[ $native_overlay_ok -eq 1 ]]; then
            # Prefer native overlay on modern kernels - it's faster and avoids
            # fuse-overlayfs + btrfs issues (mkdir /dev/mqueue: invalid argument)
            log_debug "Using native kernel overlay (kernel 5.11+)"
            fuse_overlayfs_path=""
        elif [[ -n "$fuse_overlayfs_path" ]]; then
            # Older kernel: need fuse-overlayfs for overlay to work
            use_fuse_overlayfs=1
            log_debug "Using fuse-overlayfs (kernel < 5.11)"
        else
            # Older kernel without fuse-overlayfs: fall back to vfs
            storage_driver="vfs"
            log_warn "Kernel $(uname -r) lacks native rootless overlayfs and fuse-overlayfs not found; using vfs storage (slower)."
        fi
    fi

    
    # Compute a stable hash of the workspace path for unique tmpfs runroot.
    # runroot MUST be on tmpfs - btrfs/ext4/etc cause "mkdir /dev/mqueue: invalid argument"
    # during container builds due to kernel namespace limitations.
    local workspace_hash
    if command -v sha256sum >/dev/null 2>&1; then
        workspace_hash=$(printf '%s' "$WORKSPACE" | sha256sum | cut -c1-12)
    elif command -v shasum >/dev/null 2>&1; then
        workspace_hash=$(printf '%s' "$WORKSPACE" | shasum -a 256 | cut -c1-12)
    else
        # Fallback: use a simpler hash based on path (less collision-resistant but functional)
        workspace_hash=$(printf '%s' "$WORKSPACE" | cksum | cut -d' ' -f1)
    fi
    local runtime_base="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    local tmpfs_runroot="$runtime_base/sandworm-$workspace_hash"
    mkdir -p "$tmpfs_runroot" 2>/dev/null || true
    
    # Build storage.conf
    cat > "$storage_conf" <<EOF
[storage]
driver = "$storage_driver"
graphroot = "$CONTROL/podman/storage"
runroot = "$tmpfs_runroot"

[storage.options]
EOF
    
    # Add fuse-overlayfs mount_program if we found it
    if [[ "$storage_driver" == "overlay" && -n "$fuse_overlayfs_path" ]]; then
        printf 'mount_program = "%s"\n' "$fuse_overlayfs_path" >> "$storage_conf"
        log_debug "Configured overlay with fuse-overlayfs"
    else
        # Try without mount_program - modern kernels support native overlay
        log_debug "Configured overlay with native kernel support (no fuse-overlayfs)"
    fi
    
    log_debug "Created storage config: $storage_conf"

    # Handle database mismatch (occurs when upgrading from btrfs runroot to tmpfs runroot).
    # Podman stores runroot path in graphroot database; if they don't match, it fails.
    # We detect this and auto-reset storage to recover gracefully.
    local podman_err
    if ! podman_err=$("$PODMAN_BIN" info 2>&1); then
        if [[ "$podman_err" == *"database"*"mismatch"* ]] || [[ "$podman_err" == *"run root"*"does not match"* ]]; then
            log_warn "Podman storage database has stale runroot path (likely from pre-tmpfs config)."
            log_warn "Resetting podman storage to fix mismatch..."
            # Remove the graphroot to clear the database
            if [[ -d "$CONTROL/podman/storage" ]]; then
                "$PODMAN_BIN" system reset --force 2>/dev/null || true
                rm -rf "$CONTROL/podman/storage" 2>/dev/null || true
                podman unshare rm -rf "$CONTROL/podman/storage" 2>/dev/null || true
            fi
            mkdir -p "$CONTROL/podman/storage"
            # Regenerate storage.conf (same content, just ensuring it exists)
            cat > "$storage_conf" <<EOF
[storage]
driver = "$storage_driver"
graphroot = "$CONTROL/podman/storage"
runroot = "$tmpfs_runroot"

[storage.options]
EOF
            if [[ "$storage_driver" == "overlay" && -n "$fuse_overlayfs_path" ]]; then
                printf 'mount_program = "%s"\n' "$fuse_overlayfs_path" >> "$storage_conf"
            fi
        fi
    fi

    # Validate (some filesystems reject overlay/fuse-overlayfs). Fall back to vfs if needed.
    if ! "$PODMAN_BIN" info >/dev/null 2>&1; then
        if [[ "$storage_driver" == "overlay" ]]; then
            log_warn "Podman overlay storage failed (often due to FS limitations). Falling back to vfs (slower)."
            cat > "$storage_conf" <<EOF
[storage]
driver = "vfs"
graphroot = "$CONTROL/podman/storage"
runroot = "$tmpfs_runroot"

[storage.options]
EOF
            if ! "$PODMAN_BIN" info >/dev/null 2>&1; then
                if [[ "$try_mode" == "--try" ]]; then
                    log_warn "Podman storage initialization failed even with vfs."
                    return 1
                fi
                die "Podman storage initialization failed even with vfs. Check permissions under $CONTROL/podman and your podman installation."
            fi
        else
            if [[ "$try_mode" == "--try" ]]; then
                log_warn "Podman storage initialization failed."
                return 1
            fi
            die "Podman storage initialization failed. Check permissions under $CONTROL/podman and your podman installation."
        fi
    fi

    export SW_PODMAN_STORAGE_READY=1
}


