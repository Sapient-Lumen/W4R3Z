# =============================================================================
# Logging utilities
# =============================================================================

SW_COLOR="${SW_COLOR:-auto}" # auto|1|0 ; also respects NO_COLOR
SW_USE_COLOR="0"
if [[ -z "${NO_COLOR:-}" ]]; then
    case "${SW_COLOR}" in
        0|false|no) SW_USE_COLOR="0" ;;
        1|true|yes) SW_USE_COLOR="1" ;;
        auto|*) if [[ -t 2 ]]; then SW_USE_COLOR="1"; fi ;;
    esac
fi

_print_stderr() {
    local ansi="$1"; shift
    local msg="$1"
    if [[ "${SW_USE_COLOR}" == "1" && -n "${ansi:-}" ]]; then
        printf '\033[%sm%s\033[0m\n' "$ansi" "$msg" >&2
    else
        printf '%s\n' "$msg" >&2
    fi
}

_log_raw() {
    local msg="$1"
    if [[ -n "${LOG_FILE:-}" && -d "$(dirname "$LOG_FILE")" ]]; then
        printf '%s\n' "$msg" >> "$LOG_FILE"
    fi
}

log_info() {
    local msg="[INFO] $*"
    if [[ "${SW_VERBOSE:-1}" -ge 1 ]]; then printf '%s\n' "$msg" >&2; fi
    _log_raw "$msg"
}

log_debug() {
    local msg="[DEBUG] $*"
    if [[ "${SW_VERBOSE:-1}" -ge 2 ]]; then printf '%s\n' "$msg" >&2; fi
    _log_raw "$msg"
}

log_warn() {
    local msg="[WARN] $*"
    _print_stderr "33" "$msg"
    _log_raw "$msg"
}

log_error() {
    local msg="[ERROR] $*"
    _print_stderr "31" "$msg"
    _log_raw "$msg"
}

log_success() {
    local msg="[OK] $*"
    _print_stderr "32" "$msg"
    _log_raw "$msg"
}

print_banner() {
    local title="$1"
    local mode="${2:-safe}"

    if [[ "${SW_USE_COLOR}" == "1" ]]; then
        local color="36"  # cyan for safe
        if [[ "$mode" == "unsafe" ]]; then
            color="33"  # yellow for unsafe
        elif [[ "$mode" == "strict" ]]; then
            color="35"  # magenta for strict
        fi

        printf '\033[%sm' "$color" >&2
        printf '\n╔══════════════════════════════════════════════════════════════════╗\n' >&2
        printf '║  %-62s  ║\n' "$title" >&2
        printf '╚══════════════════════════════════════════════════════════════════╝\033[0m\n' >&2
    else
        printf '\n════════════════════════════════════════════════════════════════════\n' >&2
        printf '  %s\n' "$title" >&2
        printf '════════════════════════════════════════════════════════════════════\n' >&2
    fi
}

die() {
    log_error "$@"
    exit 1
}

# =============================================================================
# Hooks system
# =============================================================================

# Run a user-defined hook script if it exists and is executable
# Usage: run_hook <hook-name> [args...]
# Environment variables passed to hooks:
#   SANDWORM_HOOK - Hook name being executed
#   SANDWORM_WORKSPACE - Current workspace path
#   SANDWORM_CONTROL - Control plane path
#   SANDWORM_MODE - Execution mode (safe/unsafe/strict)
#   SANDWORM_COMMAND - Command being executed (codex/claude/shell/run/etc)
run_hook() {
    local hook_name="$1"; shift
    local hook_script="$CONTROL/hooks/$hook_name.sh"

    # Skip if hook doesn't exist or isn't executable
    if [[ ! -x "$hook_script" ]]; then
        log_debug "Hook $hook_name not found or not executable, skipping"
        return 0
    fi

    log_info "Running hook: $hook_name"

    # Pass context to hook via environment variables
    local hook_exit=0
    (
        export SANDWORM_HOOK="$hook_name"
        export SANDWORM_WORKSPACE="$WORKSPACE"
        export SANDWORM_CONTROL="$CONTROL"
        export SANDWORM_MODE="${SANDWORM_POSTURE:-safe}"
        export SANDWORM_COMMAND="${SANDWORM_CURRENT_COMMAND:-unknown}"

        # Run hook script with any additional arguments
        "$hook_script" "$@"
    ) || hook_exit=$?

    if [[ $hook_exit -ne 0 ]]; then
        log_warn "Hook $hook_name exited with code $hook_exit"
        return $hook_exit
    fi

    log_debug "Hook $hook_name completed successfully"
    return 0
}

# =============================================================================
# Debugging utilities
