# Generate the phase 2 hydration script
generate_hydration_script() {
    # Using single-quoted heredoc to prevent host interpolation
    cat <<'HYDRATION_EOF'
#!/bin/bash
set -euo pipefail

# Configuration from environment
NODE_MAJOR="${SW_NODE_MAJOR:-22}"
RUST_TOOLCHAIN="${SW_RUST_TOOLCHAIN:-stable}"
TOOLROOT="/opt/llm"
HOME_DIR="/home/sandworm"

log() { printf '[hydrate] %s\n' "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }
ts() { date +%s; }
timed() {
    local label="$1"; shift
    local start end
    start="$(ts)"
    log "BEGIN $label"
    "$@"
    end="$(ts)"
    log "END   $label (${end}s since epoch; +$((end-start))s)"
}

# =============================================================================
# Caching helpers
# =============================================================================

CACHE_DIR="${HOME_DIR}/.cache/sandworm"
CACHE_TTL="${SW_CACHE_TTL:-3600}"  # Default: 1 hour

# Fetch URL with caching. Returns cached content if fresh, otherwise fetches and caches.
# Usage: cached_fetch <url> <cache_key>
cached_fetch() {
    local url="$1"
    local cache_key="$2"
    local cache_file="$CACHE_DIR/$cache_key"
    local cache_meta="$CACHE_DIR/${cache_key}.meta"

    mkdir -p "$CACHE_DIR"

    # Check if cache exists and is fresh
    if [[ -f "$cache_file" && -f "$cache_meta" ]]; then
        local cached_time now age
        cached_time=$(cat "$cache_meta" 2>/dev/null || echo 0)
        now=$(date +%s)
        age=$((now - cached_time))

        if [[ $age -lt $CACHE_TTL ]]; then
            log "Using cached $cache_key (age: ${age}s)"
            cat "$cache_file"
            return 0
        fi
        log "Cache expired for $cache_key (age: ${age}s > TTL: ${CACHE_TTL}s)"
    fi

    # Fetch from network
    log "Fetching $url..."
    local content
    if content=$(curl -fsSL "$url"); then
        # Save to cache
        printf '%s' "$content" > "$cache_file"
        date +%s > "$cache_meta"
        log "Cached $cache_key"
        printf '%s' "$content"
        return 0
    else
        # On network failure, try stale cache
        if [[ -f "$cache_file" ]]; then
            log "Network failed, using stale cache for $cache_key"
            cat "$cache_file"
            return 0
        fi
        return 1
    fi
}

# =============================================================================
# Node.js installation
# =============================================================================

install_node() {
    log "Installing Node.js (major: $NODE_MAJOR)..."

    local arch
    case "$(uname -m)" in
        x86_64) arch="x64" ;;
        aarch64|arm64) arch="arm64" ;;
        armv7l) arch="armv7l" ;;
        *) die "Unsupported architecture: $(uname -m)" ;;
    esac

    # Fetch version index (with caching)
    local index_url="https://nodejs.org/dist/index.json"
    local versions_json
    versions_json=$(cached_fetch "$index_url" "nodejs-index.json") || die "Failed to fetch Node version index"

    # Find latest version for major
    local version
    version=$(printf '%s' "$versions_json" | jq -r --arg major "v${NODE_MAJOR}." \
        '[.[] | select(.version | startswith($major))] | .[0].version // empty')

    if [[ -z "$version" ]]; then
        die "No Node.js version found for major $NODE_MAJOR"
    fi

    log "Selected Node.js version: $version"

    # Check if we have a cached tarball for this exact version
    local tarball="node-${version}-linux-${arch}.tar.xz"
    local cached_tarball="$CACHE_DIR/$tarball"
    local cached_shasums="$CACHE_DIR/nodejs-${version}-SHASUMS256.txt"
    local url="https://nodejs.org/dist/${version}/${tarball}"
    local shasums_url="https://nodejs.org/dist/${version}/SHASUMS256.txt"

    cd "$TOOLROOT"

    # Try to use cached tarball
    local use_cache=0
    if [[ -f "$cached_tarball" && -f "$cached_shasums" ]]; then
        log "Found cached Node.js tarball: $cached_tarball"
        local expected_sum actual_sum
        expected_sum=$(grep "$tarball" "$cached_shasums" 2>/dev/null | cut -d' ' -f1)
        actual_sum=$(sha256sum "$cached_tarball" 2>/dev/null | cut -d' ' -f1)
        if [[ -n "$expected_sum" && "$expected_sum" == "$actual_sum" ]]; then
            log "Cached tarball checksum valid"
            cp "$cached_tarball" "$tarball"
            use_cache=1
        else
            log "Cached tarball checksum invalid, re-downloading"
        fi
    fi

    if [[ "$use_cache" -eq 0 ]]; then
        # Download tarball and checksums
        curl -fsSL -o "$tarball" "$url" || die "Failed to download Node.js"
        curl -fsSL -o SHASUMS256.txt "$shasums_url" || die "Failed to download checksums"

        # Verify checksum
        local expected_sum actual_sum
        expected_sum=$(grep "$tarball" SHASUMS256.txt | cut -d' ' -f1)
        actual_sum=$(sha256sum "$tarball" | cut -d' ' -f1)

        if [[ "$expected_sum" != "$actual_sum" ]]; then
            die "Checksum mismatch for Node.js tarball"
        fi

        log "Checksum verified"

        # Cache the tarball and checksums for future use
        mkdir -p "$CACHE_DIR"
        cp "$tarball" "$cached_tarball" 2>/dev/null || true
        cp SHASUMS256.txt "$cached_shasums" 2>/dev/null || true
    fi

    # Extract
    rm -rf "$TOOLROOT/node"
    mkdir -p "$TOOLROOT/node"
    tar -xJf "$tarball" -C "$TOOLROOT/node" --strip-components=1
    rm -f "$tarball" SHASUMS256.txt

    # Create shims
    for cmd in node npm npx; do
        cat > "$TOOLROOT/bin/$cmd" <<SHIM
#!/bin/bash
exec "$TOOLROOT/node/bin/$cmd" "\$@"
SHIM
        chmod +x "$TOOLROOT/bin/$cmd"
    done

    # Configure npm prefix
    export PATH="$TOOLROOT/bin:$TOOLROOT/node/bin:$PATH"

    log "Node.js installed: $("$TOOLROOT/bin/node" --version)"
}

# =============================================================================
# Agent CLI installation
# =============================================================================

install_agent_clis() {
    log "Installing agent CLIs..."
    
    export PATH="$TOOLROOT/bin:$TOOLROOT/node/bin:$PATH"
    export NPM_CONFIG_PREFIX="$TOOLROOT"

    ensure_npm_wrapper() {
        # Create/repair a $TOOLROOT/bin/<bin_name> wrapper for an npm global package.
        # This handles cases where npm installed the package but did not create an
        # executable shim (or created it under a different bin name).
        local pkg="$1"
        local bin_name="$2"

        local pkg_dir="$TOOLROOT/lib/node_modules/$pkg"
        local pkg_json="$pkg_dir/package.json"
        [[ -f "$pkg_json" ]] || return 1

        # Determine entrypoint. `bin` can be a string or object.
        local entry=""
        if command -v jq >/dev/null 2>&1; then
            entry="$(jq -r --arg name "$bin_name" '
                if (.bin|type) == "string" then .bin
                elif (.bin|type) == "object" then
                    if .bin[$name] then .bin[$name]
                    else ( .bin | to_entries | .[0].value // empty )
                    end
                else empty end
            ' "$pkg_json" 2>/dev/null || true)"
        fi
        if [[ -z "${entry:-}" ]]; then
            # Best-effort fallback without jq: find first "bin" string entry.
            entry="$(grep -m1 -E '"bin"\s*:\s*"[^"]+"' "$pkg_json" | sed -E 's/.*"bin"\s*:\s*"([^"]+)".*/\1/' || true)"
        fi
        [[ -n "${entry:-}" ]] || return 1

        local target="$pkg_dir/$entry"
        [[ -f "$target" ]] || return 1

        # npm may have created $TOOLROOT/bin/$bin_name as a symlink into the package
        # (e.g. ../lib/node_modules/<pkg>/...); writing to it would overwrite the
        # target file. Always remove first so we create a real wrapper file.
        rm -f "$TOOLROOT/bin/$bin_name" 2>/dev/null || true

        cat > "$TOOLROOT/bin/$bin_name" <<SHIM
#!/bin/bash
exec "$TOOLROOT/bin/node" "$target" "\$@"
SHIM
        chmod +x "$TOOLROOT/bin/$bin_name" 2>/dev/null || true
        return 0
    }
    
    local -A cli_packages=(
        ["codex"]="" # handled separately (multiple possible package names)
        ["claude"]="@anthropic-ai/claude-code"
        ["gemini"]="@google/gemini-cli"
    )

    # Codex may be renamed; try a shortlist. SW_CODEX_PACKAGE can override/augment.
    local codex_packages=()
    if [[ -n "${SW_CODEX_PACKAGE:-}" ]]; then codex_packages+=("$SW_CODEX_PACKAGE"); fi
    codex_packages+=("@openai/codex" "@openai/openai-codex" "openai-codex" "@openai/codex-cli" "codex")

    local any_cli_installed=0

    # Install codex (best-effort).
    if [[ ",${SW_DISABLED_CLIS:-}," == *",codex,"* ]]; then
        log "Skipping codex (disabled)"
    else
        log "Installing codex CLI..."
        local codex_installed=0
        for codex_pkg in "${codex_packages[@]}"; do
            [[ -n "$codex_pkg" ]] || continue
            log "  Trying $codex_pkg..."

            local npm_output
            local npm_rc=0
            npm_output=$(npm install -g "$codex_pkg" 2>&1) || npm_rc=$?

            if [[ $npm_rc -eq 0 ]] && ! echo "$npm_output" | grep -qiE '(ERR!|404 Not Found|ENOTFOUND|ENOENT)'; then
                ensure_npm_wrapper "$codex_pkg" "codex" 2>/dev/null || true
                if [[ -x "$TOOLROOT/bin/codex" ]]; then
                    log "codex installed from $codex_pkg"
                    codex_installed=1
                    any_cli_installed=1
                    break
                fi
            fi

            if [[ -n "$npm_output" ]]; then
                echo "$npm_output" | head -20 >&2
            fi
            npm uninstall -g "$codex_pkg" 2>/dev/null || true
        done
        if [[ $codex_installed -eq 0 ]]; then
            log "WARNING: Could not install codex CLI (tried: ${codex_packages[*]})"
        fi
    fi

    # Install other CLIs (best-effort)
    for name in claude gemini; do
        local pkg="${cli_packages[$name]}"

        if [[ ",${SW_DISABLED_CLIS:-}," == *",$name,"* ]]; then
            log "Skipping $name (disabled)"
            continue
        fi

        log "Installing $pkg..."

        local install_ok=0
        local attempt=0
        local max_attempts=2

        while [[ $attempt -lt $max_attempts ]]; do
            local npm_output
            local npm_rc=0
            npm_output=$(npm install -g "$pkg" 2>&1) || npm_rc=$?

            if [[ $npm_rc -eq 0 ]] && ! echo "$npm_output" | grep -qiE '(ERR!|404 Not Found|ENOTFOUND|ENOENT)'; then
                if [[ -x "$TOOLROOT/bin/$name" ]] || [[ -x "$TOOLROOT/lib/node_modules/$pkg/bin/$name" ]]; then
                    log "$name installed successfully"
                    install_ok=1
                    any_cli_installed=1
                    break
                fi
                if [[ -d "$TOOLROOT/lib/node_modules/$pkg" ]] || [[ -d "$TOOLROOT/lib/node_modules/$(echo "$pkg" | sed 's/@.*\///')" ]]; then
                    log "$name installed (package present)"
                    install_ok=1
                    any_cli_installed=1
                    break
                fi
            fi

            if [[ -n "$npm_output" ]]; then
                echo "$npm_output" | head -20 >&2
            fi

            ((attempt++))
            if [[ $attempt -lt $max_attempts ]]; then
                log "Retrying $pkg installation (attempt $((attempt+1))/$max_attempts)..."
                npm cache clean --force 2>/dev/null || true
                npm uninstall -g "$pkg" 2>/dev/null || true
                sleep 2
            fi
        done

        if [[ $install_ok -eq 0 ]]; then
            log "WARNING: Failed to install $pkg after $max_attempts attempts"
        fi
    done

    if [[ $any_cli_installed -eq 0 ]]; then
        log "WARNING: No agent CLIs were installed"
    fi
    
    log "Agent CLI installation complete"
    return 0
}

# =============================================================================
# Rust installation
# =============================================================================

install_rust() {
    log "Installing Rust toolchain ($RUST_TOOLCHAIN)..."
    
    export RUSTUP_HOME="$TOOLROOT/rustup"
    export CARGO_HOME="$TOOLROOT/cargo"
    export PATH="$CARGO_HOME/bin:$PATH"
    
    # Download and run rustup
    # rustup complains if HOME doesn't match the euid-derived home directory (common in containers).
    # We install into $RUSTUP_HOME/$CARGO_HOME, so using HOME=/root here is safe and avoids noisy output.
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        HOME=/root sh -s -- -y --default-toolchain "$RUST_TOOLCHAIN" --no-modify-path
    
    # Create shims
    for cmd in cargo rustc rustup rustfmt cargo-fmt; do
        if [[ -x "$CARGO_HOME/bin/$cmd" ]]; then
            cat > "$TOOLROOT/bin/$cmd" <<SHIM
#!/bin/bash
# Toolchain lives in the (immutable) toolroot, but cargo installs/caches must be writable.
export RUSTUP_HOME="\${RUSTUP_HOME:-$TOOLROOT/rustup}"
export CARGO_HOME="\${CARGO_HOME:-\${HOME:-/home/sandworm}/.cargo}"
export PATH="\$CARGO_HOME/bin:\$PATH"
exec "$TOOLROOT/cargo/bin/$cmd" "\$@"
SHIM
            chmod +x "$TOOLROOT/bin/$cmd"
        fi
    done
    
    log "Rust installed: $("$TOOLROOT/bin/rustc" --version)"
}

# =============================================================================
# Nix (best-effort)
# =============================================================================

install_nix_portable() {
    log "Installing nix-portable (best-effort)..."
    
    local nix_store="$HOME_DIR/.nix-portable"
    mkdir -p "$nix_store"
    
    # Download nix-portable
    local arch
    case "$(uname -m)" in
        x86_64) arch="x86_64" ;;
        aarch64|arm64) arch="aarch64" ;;
        *) log "Nix: unsupported architecture"; return 1 ;;
    esac
    
    local url="https://github.com/DavHau/nix-portable/releases/latest/download/nix-portable-${arch}"
    
    if ! curl -fsSL -o "$TOOLROOT/bin/nix-portable" "$url"; then
        log "Failed to download nix-portable"
        return 1
    fi
    chmod +x "$TOOLROOT/bin/nix-portable"
    
    # Create wrapper
    cat > "$TOOLROOT/bin/nix" <<'NIX_WRAPPER'
#!/bin/bash
set -euo pipefail

# nix-portable caches and virtualizes /nix/store under NP_LOCATION.
HOME_DIR="${HOME:-/home/sandworm}"

# IMPORTANT:
# Avoid deriving NP_LOCATION from $HOME inside sandworm. Some nix-portable/proot
# runtimes may rewrite HOME, which can cause NP_LOCATION to become nested
# (e.g. .../.nix-portable/.../.nix-portable) and explode into millions of files.
if [[ -z "${NP_LOCATION:-}" ]]; then
  if [[ -n "${SANDWORM_BACKEND:-}" ]]; then
    NP_LOCATION="/home/sandworm/.nix-portable"
  else
    NP_LOCATION="$HOME_DIR/.nix-portable"
  fi
fi
export NP_LOCATION

if [[ "$NP_LOCATION" != /* ]]; then
  echo "nix: NP_LOCATION must be an absolute path (got: $NP_LOCATION)" >&2
  exit 2
fi

# Auto-detect system git to avoid nix-portable's slow git bootstrap.
# nix-portable will download and build git if NP_GIT is unset, which hangs.
if [[ -z "${NP_GIT:-}" ]]; then
  for git_path in /usr/bin/git /bin/git /usr/local/bin/git; do
    if [[ -x "$git_path" ]]; then
      export NP_GIT="$git_path"
      break
    fi
  done
fi

# Pre-create tmpbin/git symlink to avoid race condition when multiple nix
# processes run concurrently. nix-portable uses `ln -s` which fails if the
# symlink already exists. We use flock to serialize the setup across processes.
if [[ -n "${NP_GIT:-}" ]]; then
  tmpbin_dir="$NP_LOCATION/tmpbin"
  tmpbin_git="$tmpbin_dir/git"
  lockfile="$NP_LOCATION/.tmpbin.lock"
  mkdir -p "$tmpbin_dir" 2>/dev/null || true
  # Use flock to serialize symlink creation across parallel nix invocations
  (
    flock -x -w 2 9 || true
    if [[ ! -L "$tmpbin_git" ]] || [[ "$(readlink "$tmpbin_git" 2>/dev/null)" != "$NP_GIT" ]]; then
      ln -sf "$NP_GIT" "$tmpbin_git" 2>/dev/null || true
    fi
  ) 9>"$lockfile"
fi

# Enable nix-command/flakes by default when no user config is present.
# This reduces "experimental feature disabled" failures for LLM-driven setup.
if [[ "${NIX_CONFIG:-}" != *experimental-features* ]] && [[ ! -f "$HOME_DIR/.config/nix/nix.conf" ]]; then
  if [[ -n "${NIX_CONFIG:-}" ]]; then
    export NIX_CONFIG="${NIX_CONFIG}"$'\n'"experimental-features = nix-command flakes"
  else
    export NIX_CONFIG="experimental-features = nix-command flakes"
  fi
fi

# Resolve nix-portable next to this wrapper (toolroot bin dir).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NP_BIN="$SCRIPT_DIR/nix-portable"

# First-run notice: nix-portable setup can take several minutes on first use.
# Use a marker file to reliably track whether first-run message has been shown.
_nix_first_run_marker="$NP_LOCATION/.sandworm_nix_initialized"
_show_first_run_msg=0
if [[ ! -f "$_nix_first_run_marker" ]]; then
  # Check if store has real content (not just the directory existing)
  if [[ ! -d "$NP_LOCATION/store" ]] || ! ls "$NP_LOCATION/store/" 2>/dev/null | grep -q .; then
    _show_first_run_msg=1
    echo "[nix] First run: initializing nix-portable. This may take 2-5 minutes - please wait..." >&2
  else
    # Store exists with content, create marker for future runs
    touch "$_nix_first_run_marker" 2>/dev/null || true
  fi
fi

# Run nix via nix-portable. If the auto-selected runtime fails due to
# namespace/seccomp restrictions, retry once with NP_RUNTIME=proot.
#
# Avoid bash process-substitution + tee here: nix-portable may spawn helpers that
# inherit stderr, which can keep the pipe open and make `bash -lc` appear "hung"
# even after `nix` prints its output.
errfile="$(mktemp -t nix-portable.XXXXXX 2>/dev/null || mktemp)"
tail_pid=""
cleanup() {
  if [[ -n "${tail_pid:-}" ]]; then
    kill "$tail_pid" 2>/dev/null || true
    wait "$tail_pid" 2>/dev/null || true
  fi
  rm -f "$errfile" 2>/dev/null || true
}
trap cleanup EXIT

: >"$errfile" 2>/dev/null || true
if command -v tail >/dev/null 2>&1; then
  if tail --help 2>&1 | grep -q -- '--pid'; then
    tail --pid=$$ -n +1 -f "$errfile" >&2 &
  else
    tail -n +1 -f "$errfile" >&2 &
  fi
  tail_pid=$!
fi

set +e
"$NP_BIN" nix "$@" 2>>"$errfile"
rc=$?
set -e

if [ "$rc" -ne 0 ] && [ -z "${NP_RUNTIME:-}" ]; then
  if grep -Eiq 'private mount namespace|Operation not permitted|bwrap:|Failed to mount tmpfs|seccomp' "$errfile" 2>/dev/null; then
    echo "nix: nix-portable runtime failed; retrying with NP_RUNTIME=proot" >&2
    export NP_RUNTIME=proot
    exec "$NP_BIN" nix "$@"
  fi
fi

# Some systems fail initializing the *Nix build sandbox* mount namespace even
# with sandbox-fallback enabled. Explicitly disabling sandboxing fixes the
# "getting sandbox mount namespace" error on affected systems.
if [ "$rc" -ne 0 ] && [ -z "${SW_NIX_WRAPPER_RETRY_SANDBOX:-}" ]; then
  if grep -Eiq 'getting sandbox mount namespace|sandbox mount namespace|setting up a private mount namespace' "$errfile" 2>/dev/null; then
    echo "nix: build sandbox setup failed; retrying with --option sandbox false" >&2
    export SW_NIX_WRAPPER_RETRY_SANDBOX=1
    exec "$NP_BIN" nix --option sandbox false "$@"
  fi
fi

# Helpful guidance for nix profile install: with nix-portable, installed packages
# are in the nix store which is only accessible via nix commands (run/shell).
if [ "$rc" -eq 0 ] && [[ "${1:-}" == "profile" && "${2:-}" == "install" ]]; then
  cat >&2 <<'HINT'

[sandworm] Note: With nix-portable, installed packages are only accessible via nix commands.
  To use this package:
    nix run nixpkgs#<package>                     # run the package directly
    nix shell nixpkgs#<package> --command <cmd>   # shell with package available

  (nix profile install is useful for caching; the package will load faster on next nix run)
HINT
fi

# Mark first-run as complete if we showed the message and nix succeeded
if [[ "$_show_first_run_msg" -eq 1 && "$rc" -eq 0 ]]; then
  touch "$_nix_first_run_marker" 2>/dev/null || true
fi

exit "$rc"
NIX_WRAPPER
    chmod +x "$TOOLROOT/bin/nix"
    # Verify download without executing nix-portable: executing can unpack a large
    # store under NP_LOCATION, which we want to remain lazy until first real use.
    #
    # nix-portable upstream may ship either an ELF binary or a bash script depending
    # on release packaging, so accept both. Still reject obvious HTML error pages.
    local magic2 magic4 hdr
    magic2="$(dd if="$TOOLROOT/bin/nix-portable" bs=1 count=2 2>/dev/null || true)"
    magic4="$(dd if="$TOOLROOT/bin/nix-portable" bs=1 count=4 2>/dev/null || true)"
    hdr="$(dd if="$TOOLROOT/bin/nix-portable" bs=1 count=64 2>/dev/null | tr -d '\r' || true)"
    if [[ "$hdr" == \<\!* || "$hdr" == \<html* || "$hdr" == HTTP/* ]]; then
        log "nix-portable verification failed (download looks like HTML/HTTP error)"
        rm -f "$TOOLROOT/bin/nix" "$TOOLROOT/bin/nix-portable"
        return 1
    fi
    if [[ "$magic4" != $'\x7fELF' && "$magic2" != "#!" ]]; then
        log "nix-portable verification failed (unexpected file type; want ELF or shebang script)"
        rm -f "$TOOLROOT/bin/nix" "$TOOLROOT/bin/nix-portable"
        return 1
    fi

    log "nix-portable installed successfully (lazy init)"
    return 0
}


# =============================================================================
# JuNest (best-effort)
# =============================================================================

install_junest_wrapper() {
    log "Installing JuNest wrapper (best-effort)..."

    cat > "$TOOLROOT/bin/junest" <<'JUNEST_WRAPPER'
#!/bin/bash
set -euo pipefail

HOME_DIR="${HOME:-/home/sandworm}"
JUNEST_HOME="${JUNEST_HOME:-$HOME_DIR/.junest}"
JUNEST_REPO="${JUNEST_REPO:-$HOME_DIR/.local/share/junest}"
JUNEST_USER="${SW_JUNEST_USER:-sandworm}"

print_wrapper_help() {
  cat >&2 <<'H'
junest (Sandworm wrapper)

Notes:
- First real use may auto-bootstrap an Arch userland under $HOME/.junest, which can take a while.
- For a predictable, explicit bootstrap: junest setup

Usage (recommended):
- Run a command: junest -- bash -lc '...'
- Force a backend: junest proot -- <cmd>   (or set SW_JUNEST_BACKEND=proot|ns|groot)

Env toggles:
- Disable auto-setup: SW_JUNEST_AUTO_SETUP=0
- Limit setup time (seconds): SW_JUNEST_SETUP_TIMEOUT=...
- Force backend: SW_JUNEST_BACKEND=ns|proot|auto
- Run as non-root user (recommended in sandboxes that run as uid 0): SW_JUNEST_DROP_ROOT=0 to disable
H
}

if [[ "$JUNEST_HOME" != /* ]]; then
  echo "junest: JUNEST_HOME must be an absolute path (got: $JUNEST_HOME)" >&2
  exit 2
fi

mkdir -p "$(dirname "$JUNEST_REPO")"

# JuNest (upstream) refuses some modes when invoked as uid 0. In Sandworm SAFE,
# uid 0 is not host-root, but it still trips JuNest checks. Default: drop to a
# normal user if possible.
drop_prefix=()
if [[ "$(id -u)" == "0" && "${SW_JUNEST_DROP_ROOT:-1}" == "1" ]]; then
  if id "$JUNEST_USER" >/dev/null 2>&1; then
    uid="$(id -u "$JUNEST_USER" 2>/dev/null || echo 1000)"
    gid="$(id -g "$JUNEST_USER" 2>/dev/null || echo 1000)"
    # Only drop if the target user can actually traverse HOME; otherwise we'll fail with EPERM.
    can_drop=0
    if command -v runuser >/dev/null 2>&1; then
      if runuser -u "$JUNEST_USER" -- test -x "$HOME_DIR" >/dev/null 2>&1; then can_drop=1; fi
    elif command -v su >/dev/null 2>&1; then
      if su -s /bin/sh "$JUNEST_USER" -c "test -x \"$HOME_DIR\"" >/dev/null 2>&1; then can_drop=1; fi
    else
      can_drop=1
    fi
    if [[ "$can_drop" == "1" ]]; then
      if command -v setpriv >/dev/null 2>&1; then
        drop_prefix=(setpriv --reuid="$uid" --regid="$gid" --init-groups)
      elif command -v runuser >/dev/null 2>&1; then
        drop_prefix=(runuser -u "$JUNEST_USER" --)
      fi
    fi
  fi
fi

run_junest() {
  "${drop_prefix[@]}" "$JUNEST_REPO/bin/junest" "$@"
}

# If called with no args or help/version, do NOT auto-bootstrap (people often probe availability with these).
if [[ $# -eq 0 ]]; then
  print_wrapper_help
  exit 0
fi
case "${1:-}" in
  -h|--help|help|--version|version)
    print_wrapper_help
    exit 0
    ;;
esac

# Fetch JuNest repo on first use (small; rootfs downloads happen at setup time).
if [[ ! -x "$JUNEST_REPO/bin/junest" ]]; then
  if command -v git >/dev/null 2>&1; then
    git clone --depth=1 https://github.com/fsquillace/junest.git "$JUNEST_REPO" >/dev/null 2>&1 || true
  fi
fi

if [[ ! -x "$JUNEST_REPO/bin/junest" ]]; then
  echo "junest: unable to fetch https://github.com/fsquillace/junest.git (need git+network)" >&2
  exit 127
fi

export JUNEST_HOME
export PATH="$JUNEST_REPO/bin:$PATH"

# Setup is a management action (not a runtime/backend). Run it directly.
case "${1:-}" in
  s|setup)
    # If a previous bootstrap was interrupted, JuNest can refuse to continue due to a non-empty dir.
    if [[ -d "$JUNEST_HOME" && ! -x "$JUNEST_HOME/usr/bin/pacman" ]]; then
      if ls -A "$JUNEST_HOME" >/dev/null 2>&1; then
        mv "$JUNEST_HOME" "${JUNEST_HOME}.bad.$(date +%s)" 2>/dev/null || true
      fi
    fi
    exec "${drop_prefix[@]}" "$JUNEST_REPO/bin/junest" setup "${@:2}"
    ;;
esac

# Auto-bootstrap on first use (idempotent); allow opt-out.
if [[ "${SW_JUNEST_AUTO_SETUP:-1}" == "1" && ! -x "$JUNEST_HOME/usr/bin/pacman" && "${1:-}" != "setup" ]]; then
  export JUNEST_REPO
  # JuNest bootstrap can block (pacman-key entropy, mirror issues, prompts). Keep it non-interactive + bounded.
  if command -v timeout >/dev/null 2>&1; then
    # Run setup via this wrapper so we inherit drop-to-user behavior and auto-repair.
    export SW_JUNEST_AUTO_SETUP=0
    export SW_JUNEST_DROP_ROOT="${SW_JUNEST_DROP_ROOT:-1}"
    export SW_JUNEST_USER="${SW_JUNEST_USER:-sandworm}"
    WRAPPER_BIN="$0"
    export WRAPPER_BIN
    if ! timeout "${SW_JUNEST_SETUP_TIMEOUT:-900}" bash -lc 'yes "" | "$WRAPPER_BIN" setup'; then
      echo "[junest] setup did not complete (timeout or error). You can retry later: junest setup" >&2
      exit 51
    fi
  else
    export SW_JUNEST_AUTO_SETUP=0
    if ! yes "" | "$0" setup; then
      echo "[junest] setup failed. You can retry later: junest setup" >&2
      exit 51
    fi
  fi
fi

# Compatibility: allow `junest proot -- <cmd>` style invocations by treating the
# first argument as a backend selector (rather than passing it through as a
# command). This matches upstream JuNest usage while still applying Sandworm
# safety logic (drop-to-user, proot->groot when running as uid 0).
case "${1:-}" in
  ns|n)
    export SW_JUNEST_BACKEND=ns
    shift
    ;;
  proot|p)
    export SW_JUNEST_BACKEND=proot
    shift
    ;;
  groot|g)
    export SW_JUNEST_BACKEND=groot
    shift
    ;;
  root|r|chroot)
    export SW_JUNEST_BACKEND=chroot
    shift
    ;;
esac
if [[ "${1:-}" == "--" ]]; then shift; fi

# Prefer namespace mode when it is actually available; otherwise use proot.
# Ubuntu and some hardened systems restrict unprivileged namespaces; proot is the robust fallback.
user_backend="${SW_JUNEST_BACKEND:-auto}"
backend="$user_backend"
if [[ "$backend" == "auto" ]]; then
  if command -v bwrap >/dev/null 2>&1 && command -v unshare >/dev/null 2>&1 && unshare -Ur -m true >/dev/null 2>&1; then
    backend="ns"
  else
    backend="proot"
  fi
fi
# If we're still uid 0 (couldn't drop), JuNest may refuse proot; use groot instead.
if [[ "$(id -u)" == "0" && "${#drop_prefix[@]}" -eq 0 ]]; then
  if [[ "$backend" == "proot" ]]; then
    backend="groot"
  fi
fi

run_backend() {
  local b="$1"; shift
  run_junest "$b" "$@"
}

case "$backend" in
  ns)
    if [[ "$user_backend" == "auto" ]]; then
      errfile="$(mktemp -t junest.XXXXXX 2>/dev/null || mktemp)"
      cleanup() { rm -f "$errfile" 2>/dev/null || true; }
      trap cleanup EXIT

      set +e
      run_backend ns "$@" 2>"$errfile"
      rc=$?
      set -e

      # If namespace failed due to permissions, silently retry with proot
      if [[ $rc -ne 0 ]] && grep -Eiq 'Operation not permitted|mount namespace|unshare|bwrap:|Failed to mount' "$errfile" 2>/dev/null; then
        cleanup
        trap - EXIT
        export SW_JUNEST_BACKEND=proot
        exec "$0" "$@"
      fi

      # Show any errors if we're not retrying
      if [[ -s "$errfile" ]]; then
        cat "$errfile" >&2
      fi
      exit $rc
    else
      exec "${drop_prefix[@]}" "$JUNEST_REPO/bin/junest" ns "$@"
    fi
    ;;
  proot|groot|chroot)
    # Run junest and filter known-harmless mount/umount warnings from stderr.
    #
    # IMPORTANT: groot/proot in sandboxed environments often have mount/umount
    # failures that pollute the exit code (always returns 1) even when the
    # command succeeds. We capture the real command exit code by wrapping it
    # in sh -c with proper escaping.
    #
    # ALSO: Inside proot, /etc/mtab is a symlink to ../proc/self/mounts, but
    # /proc may not be properly bound (especially in containers). We fix this
    # by creating a real /etc/mtab file if the symlink is broken.
    errfile="$(mktemp -t junest-err.XXXXXX 2>/dev/null || mktemp)"
    # Use /tmp for exit marker - it's often shared between host and groot
    exit_marker="/tmp/.junest_exit_$$_$RANDOM"

    # Fix for broken /etc/mtab symlink - required for pacman and other tools
    # Note: avoid double quotes inside mtab_fix since it gets embedded in sh -c "..."
    mtab_fix='if [ -L /etc/mtab ] && [ ! -e /etc/mtab ]; then rm -f /etc/mtab 2>/dev/null; cat /proc/mounts > /etc/mtab 2>/dev/null || echo rootfs / rootfs rw 0 0 > /etc/mtab 2>/dev/null || true; fi'

    if [[ $# -gt 0 ]]; then
      # Escape arguments for sh -c and capture exit code to marker file
      cmd_escaped=$(printf '%q ' "$@")
      set +e
      run_backend "$backend" sh -c "$mtab_fix; $cmd_escaped; echo \$? > '$exit_marker'" 2>"$errfile"
      wrapper_rc=$?
      set -e
      # Read the real exit code from the marker file
      if [[ -f "$exit_marker" ]]; then
        rc=$(cat "$exit_marker" 2>/dev/null) || rc="$wrapper_rc"
        rm -f "$exit_marker" 2>/dev/null || true
      else
        # Marker file not found - fall back to heuristic: if stderr only has
        # mount warnings and exit is 1, assume command succeeded
        rc="$wrapper_rc"
        if [[ $rc -eq 1 ]]; then
          real_errors=$(grep -v -E -i 'mount:.*(permission denied|already a mountpoint|not mounted|Invalid argument)' "$errfile" 2>/dev/null | \
            grep -v -E -i 'Failed mount of directories' | \
            grep -v -E -i 'Skipping it\.\.\.' | \
            grep -v -E -i 'umount:.*(not mounted|Invalid argument|no mount point)' | \
            grep -v -E 'dmesg\(1\) may have more information' | \
            grep -v -E '^sh: line.*No such file' || true)
          if [[ -z "$real_errors" ]]; then
            rc=0
          fi
        fi
      fi
    else
      # No command - interactive shell. Fix mtab first, then spawn shell.
      set +e
      run_backend "$backend" sh -c "$mtab_fix; exec bash -l" 2>"$errfile"
      rc=$?
      set -e
    fi

    # Filter stderr, keeping only non-mount-related errors
    if [[ -s "$errfile" ]]; then
      grep -v -E -i 'mount:.*(permission denied|already a mountpoint|not mounted|Invalid argument)' "$errfile" | \
        grep -v -E -i 'Failed mount of directories' | \
        grep -v -E -i 'umount:.*(not mounted|Invalid argument|no mount point)' | \
        grep -v -E -i 'Skipping it\.\.\.' | \
        grep -v -E 'dmesg\(1\) may have more information' >&2 || true
    fi
    rm -f "$errfile" 2>/dev/null || true
    exit $rc
    ;;
  *)
    exec "${drop_prefix[@]}" "$JUNEST_REPO/bin/junest" "$@"
    ;;
esac
JUNEST_WRAPPER

    chmod +x "$TOOLROOT/bin/junest" || true
    return 0
}

# =============================================================================
# Version manifest
# =============================================================================

write_versions() {
    local manifest="$TOOLROOT/tool_versions.json"
    log "Writing version manifest..."

    with_timeout() {
        local dur="$1"; shift
        if command -v timeout >/dev/null 2>&1; then
            timeout "$dur" "$@" 2>/dev/null || true
        else
            "$@" 2>/dev/null || true
        fi
    }

    npm_pkg_version() {
        local pkg="$1"
        local p="$TOOLROOT/lib/node_modules/$pkg/package.json"
        if [[ -f "$p" ]]; then
            if command -v jq >/dev/null 2>&1; then
                jq -r '.version // empty' "$p" 2>/dev/null || true
            else
                grep -m1 -E '"version"\s*:' "$p" | sed -E 's/.*"version"\s*:\s*"([^"]+)".*/\1/' || true
            fi
        fi
    }

    json_val() {
        local v="$1"
        if [[ -z "$v" ]]; then
            echo "null"
        else
            if command -v jq >/dev/null 2>&1; then
                jq -Rn --arg v "$v" '$v'
            else
                # Best-effort fallback. (No embedded quotes expected in versions.)
                printf '"%s"' "${v//"/\\"}"
            fi
        fi
    }

    local generated_at
    generated_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    local node_ver=""
    if [[ -x "$TOOLROOT/bin/node" ]]; then
        node_ver="$(with_timeout 2s "$TOOLROOT/bin/node" --version | tr -d '\r' | head -n1)"
    fi

    local rustc_ver=""
    if [[ -x "$TOOLROOT/bin/rustc" ]]; then
        rustc_ver="$(with_timeout 2s "$TOOLROOT/bin/rustc" --version | tr -d '\r' | head -n1)"
    fi

    local nix_ver=""
    if [[ -x "$TOOLROOT/bin/nix" ]]; then
        nix_ver="$(with_timeout 5s "$TOOLROOT/bin/nix" --version | tr -d '\r' | head -n1)"
    fi

    local codex_ver="" claude_ver="" gemini_ver=""
    codex_ver="$(npm_pkg_version "@openai/codex")"
    claude_ver="$(npm_pkg_version "@anthropic-ai/claude-code")"
    gemini_ver="$(npm_pkg_version "@google/gemini-cli")"

    cat > "$manifest" <<JSON
{
  "generated_at": $(json_val "$generated_at"),
  "node": $(json_val "$node_ver"),
  "rustc": $(json_val "$rustc_ver"),
  "nix": $(json_val "$nix_ver"),
  "codex": $(json_val "$codex_ver"),
  "claude": $(json_val "$claude_ver"),
  "gemini": $(json_val "$gemini_ver")
}
JSON

    log "Version manifest written to $manifest"
}


# =============================================================================
# Parallel execution helpers
# =============================================================================

# Run a function in background, capturing output to a temp file
run_bg() {
    local name="$1"
    local func="$2"
    local logfile="/tmp/hydrate-${name}.log"

    (
        set +e
        "$func" >"$logfile" 2>&1
        echo $? > "/tmp/hydrate-${name}.rc"
    ) &
    echo $!
}

# Wait for a background job and check its result
wait_bg() {
    local name="$1"
    local pid="$2"
    local required="${3:-1}"
    local logfile="/tmp/hydrate-${name}.log"
    local rcfile="/tmp/hydrate-${name}.rc"

    wait "$pid" 2>/dev/null || true

    local rc=1
    if [[ -f "$rcfile" ]]; then
        rc=$(cat "$rcfile")
    fi

    # Show log output
    if [[ -f "$logfile" ]]; then
        cat "$logfile"
        rm -f "$logfile"
    fi
    rm -f "$rcfile"

    if [[ "$rc" -ne 0 ]]; then
        if [[ "$required" == "1" ]]; then
            log "FATAL: $name failed (exit $rc)"
            return 1
        else
            log "WARNING: $name failed (exit $rc) - continuing"
            return 0
        fi
    fi
    return 0
}

# =============================================================================
# Main
# =============================================================================

main() {
    log "Starting hydration..."
    log "  NODE_MAJOR=$NODE_MAJOR"
    log "  RUST_TOOLCHAIN=$RUST_TOOLCHAIN"
    log "  TOOLROOT=$TOOLROOT"
    log "  Parallel mode: ${SW_PARALLEL_HYDRATE:-1}"

    local parallel="${SW_PARALLEL_HYDRATE:-1}"

    if [[ "$parallel" == "1" ]]; then
        # Parallel strategy:
        # Phase 1: Node.js + Rust in parallel (both are network-bound)
        # Phase 2: Agent CLIs (needs Node.js)
        # Phase 3: Nix + JuNest in parallel (optional)

        log "Phase 1: Installing Node.js and Rust in parallel..."
        local node_start rust_start
        node_start=$(ts)
        rust_start=$(ts)

        local node_pid rust_pid
        node_pid=$(run_bg "node" install_node)
        rust_pid=$(run_bg "rust" install_rust)

        log "  Started Node.js (PID $node_pid) and Rust (PID $rust_pid)"

        # Wait for Node.js first (required for CLIs)
        log "Waiting for Node.js..."
        if ! wait_bg "node" "$node_pid" 1; then
            log "FATAL: Node.js installation failed"
            # Kill Rust job if still running
            kill "$rust_pid" 2>/dev/null || true
            exit 1
        fi
        log "END   install_node (+$(($(ts) - node_start))s)"

        # Install agent CLIs while Rust may still be installing
        log "Phase 2: Installing agent CLIs..."
        local cli_start
        cli_start=$(ts)
        if ! install_agent_clis; then
            log "FATAL: Agent CLI installation failed"
            kill "$rust_pid" 2>/dev/null || true
            exit 1
        fi
        log "END   install_agent_clis (+$(($(ts) - cli_start))s)"

        # Wait for Rust
        log "Waiting for Rust..."
        if ! wait_bg "rust" "$rust_pid" 0; then
            log "WARNING: Rust installation failed (continuing)"
        else
            log "END   install_rust (+$(($(ts) - rust_start))s)"
        fi

        # Phase 3: Optional components in parallel
        log "Phase 3: Installing optional components..."
        local nix_pid junest_pid
        nix_pid=$(run_bg "nix" install_nix_portable)
        junest_pid=$(run_bg "junest" install_junest_wrapper)

        wait_bg "nix" "$nix_pid" 0 || true
        wait_bg "junest" "$junest_pid" 0 || true
    else
        # Sequential mode (original behavior)
        log "Running in sequential mode..."

        # Install Node.js (required)
        if ! timed "install_node" install_node; then
            log "FATAL: Node.js installation failed"
            exit 1
        fi

        # Install agent CLIs (at least one required)
        if ! timed "install_agent_clis" install_agent_clis; then
            log "FATAL: Agent CLI installation failed"
            exit 1
        fi

        # Install Rust (optional but important)
        if ! timed "install_rust" install_rust; then
            log "WARNING: Rust installation failed (continuing)"
        fi

        # Optional components
        timed "install_nix_portable" install_nix_portable || log "Nix installation failed (optional, continuing)"
        timed "install_junest_wrapper" install_junest_wrapper || log "JuNest wrapper install failed (optional, continuing)"
    fi

    # Write version manifest
    timed "write_versions" write_versions

    # Write README
    cat > "$TOOLROOT/README.txt" <<README
sandworm toolroot
Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)

This directory contains:
- Node.js and npm
- Agent CLIs (codex, claude, gemini)
- Rust toolchain
- nix-portable (if available)

This toolroot is immutable during agent runs.
README

    log "Hydration complete!"
}

main "$@"
HYDRATION_EOF
}

run_hydration() {
    local rev_id="$1"
    local staging_dir="$CONTROL/toolroots/${rev_id}.staging"
    
    log_info "Running hydration for toolroot: $rev_id"
    log_debug "Staging directory: $staging_dir"
    
    # Generate hydration script
    local hydration_script="$CONTROL/podman/tmp/hydrate-${rev_id}.sh"
    log_debug "Generating hydration script: $hydration_script"
    generate_hydration_script > "$hydration_script"
    chmod +x "$hydration_script"

    # Preflight: ensure the generated script is valid bash (internal invariant).
    # If this ever fails, it's a sandworm bug; print the parser error with context.
    log_trace "Checking hydration script syntax..."
    local _hs_err
    # Use 'bash' instead of '/bin/bash' for NixOS compatibility (bash is in PATH on all systems)
    _hs_err=$(bash -n "$hydration_script" 2>&1) || {
        log_error "Internal error: generated hydration script is invalid bash"
        log_error "bash -n reported: ${_hs_err}"
        # Best-effort context (keep it small)
        nl -ba "$hydration_script" | sed -n '1,120p' | sed 's/^/[HYDRATE] /' >&2 || true
        cleanup_staging_dir "$staging_dir"
        rm -f "$hydration_script"
        return 21
    }
    log_trace "Hydration script syntax OK"
    
    # Configure podman environment
    ensure_podman_storage
    
    local staging_realpath
    staging_realpath=$(realpath "$staging_dir")
    
    local home_realpath
    home_realpath=$(realpath "$CONTROL/home")
    
    log_debug "Hydration mounts:"
    log_debug "  staging: $staging_realpath -> /opt/llm (rw)"
    log_debug "  home: $home_realpath -> /home/sandworm (rw)"
    log_debug "  script: $hydration_script -> /hydrate.sh (ro)"
    
    # Build the hydration command
    local hydrate_net="${SW_REFRESH_NETWORK:-host}"
    local -a hydrate_cmd=(
        "$PODMAN_BIN" run --rm
        --hooks-dir "$CONTROL/hooks-empty"
        --security-opt label=disable
        --network "$hydrate_net"
        -v "$staging_realpath:/opt/llm:rw"
        -v "$home_realpath:/home/sandworm:rw,rbind"
        -v "$hydration_script:/hydrate.sh:ro"
        -e HOME=/home/sandworm
        -e SW_NODE_MAJOR="$SW_NODE_MAJOR"
        -e SW_RUST_TOOLCHAIN="$SW_RUST_TOOLCHAIN"
        -e SW_DISABLED_CLIS="$SW_DISABLED_CLIS"
        -w /opt/llm
        "$SEED_TAG"
        /bin/bash /hydrate.sh
    )
    
    log_trace "Hydration command: ${hydrate_cmd[*]}"
    
    # Run hydration with output capture
    local hydrate_start_time
    hydrate_start_time=$(date +%s)
    
    log_debug "Starting hydration container..."
    local hydrate_log
    hydrate_log=$(mktemp "$CONTROL/podman/hydrate-log.XXXXXX")
    
    # Run hydration - capture exit code properly (not via pipeline)
    local rc=0
    "${hydrate_cmd[@]}" 2>&1 | tee "$hydrate_log" | {
        if [[ -n "${LOG_FILE:-}" ]]; then
            tee -a "$LOG_FILE"
        else
            cat
        fi
    } >&2 || true
    # Get the exit code from PIPESTATUS (first element is the podman command)
    rc=${PIPESTATUS[0]}
    
    local hydrate_elapsed=$(($(date +%s) - hydrate_start_time))
    
    if [[ $rc -ne 0 ]]; then
        log_error "Hydration failed after ${hydrate_elapsed}s (exit code: $rc)"
        
        # Show last part of log for context
        if [[ -s "$hydrate_log" ]]; then
            log_error "Last 50 lines of hydration output:"
            tail -50 "$hydrate_log" | while IFS= read -r line; do
                log_error "  $line"
            done
        fi
        
        dump_debug_state "hydration-failed"
        cleanup_staging_dir "$staging_dir"
        rm -f "$hydration_script" "$hydrate_log"
        return 21
    fi
    
    log_debug "Hydration completed in ${hydrate_elapsed}s"
    
    rm -f "$hydration_script" "$hydrate_log"
    return 0
}

# Clean up staging directory, handling rootless podman UID mapping
cleanup_staging_dir() {
    local staging_dir="$1"
    
    if [[ ! -d "$staging_dir" ]]; then
        return 0
    fi
    
    log_debug "Cleaning up staging directory: $staging_dir"
    
    # First try normal rm
    if rm -rf "$staging_dir" 2>/dev/null; then
        log_trace "Staging directory removed with rm"
        return 0
    fi
    
    # If that fails (permission issues from rootless podman UID mapping),
    # try using podman unshare to run rm in the user namespace
    if [[ -n "${PODMAN_BIN:-}" ]] && command -v "$PODMAN_BIN" >/dev/null 2>&1; then
        log_debug "Normal rm failed, trying podman unshare..."
        if "$PODMAN_BIN" unshare rm -rf "$staging_dir" 2>/dev/null; then
            log_trace "Staging directory removed with podman unshare"
            return 0
        fi
    fi
    
    # If that also fails, try running rm inside a container
    if [[ -n "${PODMAN_BIN:-}" && -n "${SEED_TAG:-}" ]]; then
        log_debug "podman unshare failed, trying rm inside container..."
        local staging_realpath
        staging_realpath=$(realpath "$staging_dir" 2>/dev/null || echo "$staging_dir")
        local staging_parent
        staging_parent=$(dirname "$staging_realpath")
        local staging_name
        staging_name=$(basename "$staging_realpath")
        
        if "$PODMAN_BIN" run --rm \
            --security-opt label=disable \
            -v "$staging_parent:/mnt/parent:rw" \
            "$SEED_TAG" \
            rm -rf "/mnt/parent/$staging_name" 2>/dev/null; then
            log_trace "Staging directory removed via container"
            return 0
        fi
    fi
    
    log_warn "Could not remove staging directory: $staging_dir"
    log_warn "You may need to manually remove it with: sudo rm -rf '$staging_dir'"
    return 1
}

validate_toolroot() {
    local toolroot_dir="$1"
    local is_staging="${2:-0}"
    
    step_start "Validating toolroot"
    log_debug "Toolroot path: $toolroot_dir"
    
    # Validation must run INSIDE the container because:
    # 1. Binaries are compiled for container's glibc
    # 2. On NixOS and other non-FHS systems, host can't run container binaries
    
    ensure_podman_storage
    
    local toolroot_realpath
    toolroot_realpath=$(realpath "$toolroot_dir")
    
    local home_realpath
    home_realpath=$(realpath "$CONTROL/home")
    
    # Debug: show what we're about to mount
    log_debug "Mount paths:"
    log_debug "  toolroot: $toolroot_realpath -> /opt/llm (ro)"
    log_debug "  home: $home_realpath -> /home/sandworm (rw)"
    log_debug "  seed image: $SEED_TAG"
    
    # Verify paths exist
    if [[ ! -d "$toolroot_realpath" ]]; then
        step_fail "toolroot directory does not exist: $toolroot_realpath"
        return 22
    fi
    if [[ ! -d "$home_realpath" ]]; then
        step_fail "home directory does not exist: $home_realpath"
        return 22
    fi
    
    # Check seed image exists
    log_trace "Checking seed image exists..."
    if ! $PODMAN_BIN image exists "$SEED_TAG" 2>&1; then
        step_fail "seed image not found: $SEED_TAG"
        log_error "Run 'sandworm refresh' to build the seed image"
        return 22
    fi
    log_trace "Seed image exists"
    
    # Build the validation command
    local -a validate_cmd=(
        "$PODMAN_BIN" run --rm
        --hooks-dir "$CONTROL/hooks-empty"
        --security-opt label=disable
        -v "$toolroot_realpath:/opt/llm:ro"
        -v "$home_realpath:/home/sandworm:rw,rbind"
        -e HOME=/home/sandworm
        -e PATH=/opt/llm/bin:/usr/local/bin:/usr/bin:/bin
        -e RUSTUP_HOME=/opt/llm/rustup
        -e CARGO_HOME=/opt/llm/cargo
        -e NP_LOCATION=/home/sandworm/.nix-portable
        "$SEED_TAG"
        /bin/bash -c '
            echo "[validate] Starting validation inside container" >&2
            echo "[validate] PWD=$(pwd)" >&2
            echo "[validate] ls /opt/llm/bin:" >&2
            ls -la /opt/llm/bin/ >&2 2>&1 || echo "[validate] ERROR: cannot list /opt/llm/bin" >&2
            
            node_ok=0
            rust_ok=0
            nix_ok=0
            codex_ok=0
            claude_ok=0
            gemini_ok=0
            
            # Check Node
            echo "[validate] Checking Node.js..." >&2
            if [[ -x /opt/llm/bin/node ]]; then
                node_ver=$(/opt/llm/bin/node --version 2>&1) && node_ok=1
                echo "[validate]   node: $node_ver (ok=$node_ok)" >&2
            else
                echo "[validate]   node: not executable at /opt/llm/bin/node" >&2
            fi
            
            # Check Rust
            echo "[validate] Checking Rust..." >&2
            if [[ -x /opt/llm/bin/rustc ]]; then
                rust_ver=$(/opt/llm/bin/rustc --version 2>&1) && rust_ok=1
                echo "[validate]   rustc: $rust_ver (ok=$rust_ok)" >&2
            else
                echo "[validate]   rustc: not executable at /opt/llm/bin/rustc" >&2
            fi
            
            # Check Nix (optional, can be slow)
            echo "[validate] Checking Nix (optional, may be slow)..." >&2
            if [[ -x /opt/llm/bin/nix && -x /opt/llm/bin/nix-portable ]]; then
                # Mark present even if initialization is slow; it is optional.
                nix_ok=1
                # Avoid executing nix by default: first run can unpack a very large
                # runtime/store under NP_LOCATION. Opt in with SW_VALIDATE_NIX_RUN=1.
                if [[ "${SW_VALIDATE_NIX_RUN:-0}" == "1" ]]; then
                    # Use a short timeout to avoid wedging validation on first-time unpack/init.
                    if command -v timeout >/dev/null 2>&1; then
                        nix_ver=$(timeout 5 /opt/llm/bin/nix --version 2>&1 || true)
                    else
                        nix_ver=$(/opt/llm/bin/nix --version 2>&1 || true)
                    fi
                    if [[ -n "${nix_ver:-}" ]]; then
                        echo "[validate]   nix: $nix_ver (ran ok=$nix_ok)" >&2
                    else
                        echo "[validate]   nix: present but slow/unverified (ok=$nix_ok)" >&2
                    fi
                else
                    echo "[validate]   nix: present (skipped execution; set SW_VALIDATE_NIX_RUN=1 to run nix --version)" >&2
                fi
            else
                echo "[validate]   nix: not found (optional)" >&2
            fi
            
            # Check CLIs (just check if executable exists)
            echo "[validate] Checking agent CLIs..." >&2
            if [[ -x /opt/llm/bin/codex ]]; then
                # Codex is required; ensure it at least starts (help is fast and offline).
                if command -v timeout >/dev/null 2>&1; then
                    timeout 10 /opt/llm/bin/codex --help >/dev/null 2>&1 && codex_ok=1 || true
                else
                    /opt/llm/bin/codex --help >/dev/null 2>&1 && codex_ok=1 || true
                fi
            fi
            if [[ -x /opt/llm/bin/claude ]]; then claude_ok=1; fi
            if [[ -x /opt/llm/bin/gemini ]]; then gemini_ok=1; fi
            echo "[validate]   codex=$codex_ok claude=$claude_ok gemini=$gemini_ok" >&2
            
            echo "[validate] Validation complete" >&2
            
            # Output results on stdout (parsed by host)
            echo "NODE_OK=$node_ok"
            echo "RUST_OK=$rust_ok"
            echo "NIX_OK=$nix_ok"
            echo "CODEX_OK=$codex_ok"
            echo "CLAUDE_OK=$claude_ok"
            echo "GEMINI_OK=$gemini_ok"
        '
    )
    
    # Show the command we're about to run
    log_trace "Validation command: ${validate_cmd[*]}"
    
    # Run with timeout and capture both stdout and stderr
    local validation_stdout validation_stderr
    local timeout_secs="${SW_PODMAN_TIMEOUT:-300}"
    local rc=0
    
    log_debug "Running validation container (timeout: ${timeout_secs}s)..."
    
    # Create temp files for output
    local stdout_file stderr_file
    stdout_file=$(mktemp "$CONTROL/podman/validate-stdout.XXXXXX")
    stderr_file=$(mktemp "$CONTROL/podman/validate-stderr.XXXXXX")
    
    if [[ "$timeout_secs" -gt 0 ]] && command -v timeout >/dev/null 2>&1; then
        timeout "$timeout_secs" "${validate_cmd[@]}" >"$stdout_file" 2>"$stderr_file" || rc=$?
    else
        "${validate_cmd[@]}" >"$stdout_file" 2>"$stderr_file" || rc=$?
    fi
    
    validation_stdout=$(cat "$stdout_file")
    validation_stderr=$(cat "$stderr_file")
    
    # Always show stderr in debug mode (it contains our validation progress)
    if [[ -n "$validation_stderr" ]]; then
        log_debug "Validation container output:"
        while IFS= read -r line; do
            log_debug "  $line"
        done <<< "$validation_stderr"
    fi
    
    # Clean up temp files
    rm -f "$stdout_file" "$stderr_file"
    
    # Handle timeout
    if [[ $rc -eq 124 ]]; then
        step_fail "validation container timed out after ${timeout_secs}s"
        log_error "This usually indicates:"
        log_error "  - Podman networking issues (try SW_NETWORK_MODE=none)"
        log_error "  - Storage driver problems (check podman info)"
        log_error "  - Resource exhaustion (check disk space, memory)"
        dump_debug_state "validate-timeout"
        return 22
    fi
    
    # Handle container failure
    if [[ $rc -ne 0 ]]; then
        step_fail "validation container exited with code $rc"
        log_error "Container stderr:"
        while IFS= read -r line; do
            log_error "  $line"
        done <<< "$validation_stderr"
        dump_debug_state "validate-failed"
        return 22
    fi
    
    # Check we got output
    if [[ -z "$validation_stdout" ]]; then
        step_fail "validation container produced no output"
        log_error "Container ran but produced no results. Stderr was:"
        while IFS= read -r line; do
            log_error "  $line"
        done <<< "$validation_stderr"
        dump_debug_state "validate-no-output"
        return 22
    fi
    
    # Parse results
    local node_ok=0 rust_ok=0 nix_ok=0 codex_ok=0 claude_ok=0 gemini_ok=0
    
    while IFS='=' read -r key value; do
        case "$key" in
            NODE_OK) node_ok="$value" ;;
            RUST_OK) rust_ok="$value" ;;
            NIX_OK) nix_ok="$value" ;;
            CODEX_OK) codex_ok="$value" ;;
            CLAUDE_OK) claude_ok="$value" ;;
            GEMINI_OK) gemini_ok="$value" ;;
        esac
    done <<< "$validation_stdout"
    
    log_debug "Validation results: node=$node_ok rust=$rust_ok nix=$nix_ok codex=$codex_ok claude=$claude_ok gemini=$gemini_ok"
    
    # Apply CLI disabled settings
    if is_cli_disabled "codex"; then codex_ok=0; fi
    if is_cli_disabled "claude"; then claude_ok=0; fi
    if is_cli_disabled "gemini"; then gemini_ok=0; fi
    # Store results
    set_state "SW_NODE_OK" "$node_ok"
    set_state "SW_RUST_OK" "$rust_ok"
    set_state "SW_NIX_OK" "$nix_ok"
    set_state "SW_CODEX_OK" "$codex_ok"
    set_state "SW_CLAUDE_OK" "$claude_ok"
    set_state "SW_GEMINI_OK" "$gemini_ok"
    
    # Required: node must work
    if [[ "$node_ok" -eq 0 ]]; then
        step_fail "Node.js not working"
        log_error "Node.js is required but validation failed"
        return 22
    fi

    step_done
    log_success "Toolroot validated: node=$node_ok rust=$rust_ok nix=$nix_ok codex=$codex_ok claude=$claude_ok gemini=$gemini_ok"
    return 0
}

activate_toolroot() {
    local rev_id="$1"
    local staging_dir="$CONTROL/toolroots/${rev_id}.staging"
    local final_dir="$CONTROL/toolroots/${rev_id}"

    log_debug "Activating toolroot: $rev_id"

    # Atomic rename
    mv "$staging_dir" "$final_dir"

    # Update state
    set_state "SW_REV_CURRENT" "$rev_id"
    set_state "SW_LAST_REFRESH_UTC" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    # Determine state
    local node_ok rust_ok codex_ok claude_ok gemini_ok
    node_ok=$(get_state "SW_NODE_OK" "0")
    rust_ok=$(get_state "SW_RUST_OK" "0")
    codex_ok=$(get_state "SW_CODEX_OK" "0")
    claude_ok=$(get_state "SW_CLAUDE_OK" "0")
    gemini_ok=$(get_state "SW_GEMINI_OK" "0")

    if [[ "$node_ok" -eq 1 && "$rust_ok" -eq 1 && ("$codex_ok" -eq 1 || "$claude_ok" -eq 1 || "$gemini_ok" -eq 1) ]]; then
        set_state "SW_STATE" "HEALTHY"
    elif [[ "$node_ok" -eq 1 && ("$codex_ok" -eq 1 || "$claude_ok" -eq 1 || "$gemini_ok" -eq 1) ]]; then
        set_state "SW_STATE" "DEGRADED"
    elif [[ "$node_ok" -eq 1 ]]; then
        set_state "SW_STATE" "DEGRADED"
    else
        set_state "SW_STATE" "BROKEN"
    fi

    # Update symlink for human convenience
    ln -sfn "$rev_id" "$CONTROL/toolroots/current"

    log_debug "Toolroot activated: $rev_id (state=$(get_state SW_STATE))"
}

gc_toolroots() {
    log_info "Running garbage collection..."
    
    local current_rev
    current_rev=$(get_state "SW_REV_CURRENT" "")
    
    local keep=$SW_TOOLROOT_KEEP
    local toolroots_dir="$CONTROL/toolroots"
    
    # List toolroots sorted by name (which includes timestamp)
    local all_revs=()
    while IFS= read -r -d '' dir; do
        local name
        name=$(basename "$dir")
        # Skip staging dirs, current symlink
        if [[ "$name" == *.staging || "$name" == "current" ]]; then continue; fi
        all_revs+=("$name")
    done < <(find "$toolroots_dir" -maxdepth 1 -mindepth 1 -type d -print0 2>/dev/null | sort -z -r)
    
    local count=0
    local gc_failed=0
    for rev in "${all_revs[@]}"; do
        count=$((count + 1))
        
        # Never delete current
        if [[ "$rev" == "$current_rev" ]]; then continue; fi
        
        # Keep the most recent N
        if [[ $count -gt $keep ]]; then
            log_info "Removing old toolroot: $rev"
            if ! cleanup_staging_dir "${toolroots_dir:?}/${rev:?}"; then
                gc_failed=1
            fi
        fi
    done
    
    if [[ $gc_failed -eq 1 ]]; then
        log_warn "Some old toolroots could not be removed (permission denied)"
        log_warn "You can clean them up manually with: podman unshare rm -rf $toolroots_dir/<rev>"
    else
        log_success "GC complete"
    fi
}

# =============================================================================
# Container execution
# =============================================================================

run_in_container() {
    # Backwards-compatible: default SAFE posture.
    run_in_container_posture "safe" "$@"
}


podman_add_network_mode() {
    # Networking mode.
    # Default is host networking (wide open, enables localhost callbacks).
    # Override with SW_NETWORK_MODE=default|host|none|<podman network spec>.
    local -n _podman_cmd="$1"
    local posture="${2:-safe}"

    if [[ "${SW_OFFLINE:-0}" == "1" ]]; then
        _podman_cmd+=(--network none)
        return 0
    fi

    local mode="${SW_NETWORK_MODE:-host}"

    case "$mode" in
        ""|default|bridge)
            # Podman's default; do nothing
            ;;
        slirp4netns)
            if ! command -v slirp4netns >/dev/null 2>&1; then
                log_warn "slirp4netns requested but not found; falling back to default networking (install slirp4netns or set SW_NETWORK_MODE=host)"
            else
                _podman_cmd+=(--network slirp4netns)
            fi
            ;;
        pasta:*)
            if ! command -v pasta >/dev/null 2>&1; then
                log_warn "pasta requested but not found; falling back to default networking (install pasta or set SW_NETWORK_MODE=host)"
            else
                _podman_cmd+=(--network "$mode")
            fi
            ;;
        host)
            _podman_cmd+=(--network host)
            ;;
        none)
            _podman_cmd+=(--network none)
            ;;
        *)
            _podman_cmd+=(--network "$mode")
            ;;
    esac
}

podman_add_resource_limits() {
    # Optional resource limits. Empty means "no limit" (wide open).
    local -n _podman_cmd="$1"

    local cpu="${SW_CPU_LIMIT:-}"
    local mem="${SW_MEM_LIMIT:-}"
    local pids="${SW_PIDS_LIMIT:-}"

    if [[ -n "$cpu" ]]; then _podman_cmd+=(--cpus "$cpu"); fi
    if [[ -n "$mem" ]]; then _podman_cmd+=(--memory "$mem"); fi
    if [[ -n "$pids" ]]; then _podman_cmd+=(--pids-limit "$pids"); fi
}

podman_add_auth_ports() {
    # STRICT mode: publish a bounded localhost port range for OAuth/web auth callbacks.
    # Only affects SAFE posture and only publishes TCP on loopback (127.0.0.1 and ::1 when enabled).
    local -n _podman_cmd="$1"
    local posture="${2:-safe}"

    if [[ "${SW_STRICT:-0}" != "1" || "$posture" != "safe" ]]; then
        return 0
    fi
    if [[ "${SW_OFFLINE:-0}" == "1" ]]; then
        # Offline implies no web auth.
        return 0
    fi
    if [[ "${SW_NETWORK_MODE:-}" == "host" ]]; then
        # Host networking makes localhost callbacks work without port publishing.
        return 0
    fi

    local spec="${SW_AUTH_PORT_RANGE:-}"
    [[ -n "$spec" ]] || return 0

    local ipv6_enabled="0"
    # If the host resolves localhost to ::1, publish IPv6 loopback too so browser redirects work.
    if [[ -r /etc/hosts ]] && grep -Eq '^[[:space:]]*::1[[:space:]].*localhost' /etc/hosts 2>/dev/null; then
        ipv6_enabled="1"
    fi

    local token
    IFS=',' read -r -a _tokens <<<"$spec"
    for token in "${_tokens[@]}"; do
        # trim spaces
        token="${token#"${token%%[![:space:]]*}"}"
        token="${token%"${token##*[![:space:]]}"}"
        [[ -n "$token" ]] || continue

        if [[ "$token" =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]]; then
            local a="${BASH_REMATCH[1]}"
            local b="${BASH_REMATCH[2]}"
            if (( a < 1 || a > 65535 || b < 1 || b > 65535 || a > b )); then
                die "SW_AUTH_PORT_RANGE invalid: $token"
            fi
            _podman_cmd+=(-p "127.0.0.1:${a}-${b}:${a}-${b}/tcp")
            if [[ "$ipv6_enabled" == "1" ]]; then
                _podman_cmd+=(-p "[::1]:${a}-${b}:${a}-${b}/tcp")
            fi
            continue
        fi
        if [[ "$token" =~ ^([0-9]{1,5})$ ]]; then
            local p="${BASH_REMATCH[1]}"
            if (( p < 1 || p > 65535 )); then
                die "SW_AUTH_PORT_RANGE invalid: $token"
            fi
            _podman_cmd+=(-p "127.0.0.1:${p}:${p}/tcp")
            if [[ "$ipv6_enabled" == "1" ]]; then
                _podman_cmd+=(-p "[::1]:${p}:${p}/tcp")
            fi
            continue
        fi
        die "SW_AUTH_PORT_RANGE must be PORT, PORT-PORT, or comma-separated list (got: $token)"
    done
}


# =============================================================================
# Bubblewrap fallback (when Podman is missing/broken)
# =============================================================================

ensure_bwrap_available() {
    if [[ -z "${BWRAP_BIN:-}" ]]; then
        BWRAP_BIN="$(command -v bwrap 2>/dev/null || true)"
    fi
    [[ -n "${BWRAP_BIN:-}" ]] || return 1
    "$BWRAP_BIN" --version >/dev/null 2>&1 || return 1
    return 0
}

warn_bwrap_fallback() {
    # Bright + loud: bubblewrap is not a container runtime and does not use images.
    log_warn "================================================================"
    log_warn "BUBBLEWRAP FALLBACK ACTIVE (Podman unavailable/broken)"
    log_warn "This is NOT a container image. It runs with the HOST KERNEL and HOST /usr."
    log_warn "Sandboxing is mount/pid/ipc/uts namespaces only; process isolation is weaker than Podman."
    log_warn "NETWORK: shared with host (wide open) because we use --share-net."
    log_warn "FILESYSTEM: only bind-mounted paths are visible. In --unsafe we bind host / at /host (RW)."
    log_warn "If you need full container semantics, fix/install Podman and rerun."
    log_warn "================================================================"
}

run_in_bwrap_posture() {
    local posture="$1"; shift
    local toolroot_realpath="$1"; shift
    local cmd=("$@")

    ensure_bwrap_available || die "Podman unavailable and bubblewrap (bwrap) not found."
    warn_bwrap_fallback

    local workspace_realpath home_realpath control_realpath
    workspace_realpath=$(realpath "$WORKSPACE")
    home_realpath=$(realpath "$CONTROL/home")
    control_realpath=$(realpath "$CONTROL")

    # Desktop integrations: keep them out-of-the-box by binding user runtime dir and common sockets.
    local xdg_runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    local has_runtime="0"
    if [[ "${SW_HOST_INTEGRATIONS:-1}" != "0" && -d "$xdg_runtime" ]]; then has_runtime="1"; fi

    local -a bwrap_cmd=()
    bwrap_cmd+=("$BWRAP_BIN" --die-with-parent --new-session --unshare-all --share-net)

    # Minimal kernel interfaces. Some environments block mounting proc; we'll retry with a bind if needed.
    bwrap_cmd+=(--proc /proc)
    # For robustness (GPU/audio/etc.), reuse host /dev.
    bwrap_cmd+=(--dev-bind /dev /dev)

    # Construct filesystem: empty root by default; bind in what we need.
    bwrap_cmd+=(--ro-bind /usr /usr)
    bwrap_cmd+=(--ro-bind-try /lib /lib)
    bwrap_cmd+=(--ro-bind-try /lib64 /lib64)
    # On merged-usr systems (Fedora, Arch, etc.), /bin and /sbin are symlinks to /usr/bin
    # and /usr/sbin. Bind only if they're real directories, otherwise create symlinks.
    if [[ -d /bin && ! -L /bin ]]; then
        bwrap_cmd+=(--ro-bind-try /bin /bin)
    else
        bwrap_cmd+=(--symlink /usr/bin /bin)
    fi
    if [[ -d /sbin && ! -L /sbin ]]; then
        bwrap_cmd+=(--ro-bind-try /sbin /sbin)
    else
        bwrap_cmd+=(--symlink /usr/sbin /sbin)
    fi
    # Same for /lib and /lib64 if they're symlinks
    if [[ -L /lib && ! -d /lib ]]; then
        local lib_target
        lib_target=$(readlink /lib 2>/dev/null || echo "usr/lib")
        bwrap_cmd+=(--symlink "$lib_target" /lib)
    fi
    if [[ -L /lib64 && ! -d /lib64 ]]; then
        local lib64_target
        lib64_target=$(readlink /lib64 2>/dev/null || echo "usr/lib64")
        bwrap_cmd+=(--symlink "$lib64_target" /lib64)
    fi
    bwrap_cmd+=(--ro-bind-try /nix /nix)
    # DNS + TLS + NSS, etc. Keep /etc read-only for "just works".
    bwrap_cmd+=(--ro-bind /etc /etc)

    # Workspace + home + toolroot
    bwrap_cmd+=(--dir /workspace)
    bwrap_cmd+=(--bind "$workspace_realpath" /workspace)
    bwrap_cmd+=(--dir /home)
    bwrap_cmd+=(--dir /home/sandworm)
    bwrap_cmd+=(--bind "$home_realpath" /home/sandworm)
    bwrap_cmd+=(--dir /opt)
    bwrap_cmd+=(--dir /opt/llm)
    bwrap_cmd+=(--ro-bind "$toolroot_realpath" /opt/llm)

    # Always mask /workspace/.sandworm by binding an empty directory from /tmp.
    # Avoid binding a path from inside /workspace onto /workspace/.sandworm, which can
    # be slow or problematic on some Podman/bwrap setups due to nested mount paths.
    local mask_dir
    mask_dir="$(mktemp -d /tmp/sandworm-mask.XXXXXX)"
    chmod 755 "$mask_dir" 2>/dev/null || true
    bwrap_cmd+=(--dir /workspace/.sandworm)
    bwrap_cmd+=(--ro-bind "$mask_dir" /workspace/.sandworm)

    if [[ "$posture" == "unsafe" ]]; then
        bwrap_cmd+=(--dir /control)
        bwrap_cmd+=(--bind "$control_realpath" /control)
        bwrap_cmd+=(--dir /host)
        bwrap_cmd+=(--bind / /host)
    fi

    # Scratch tmp
    bwrap_cmd+=(--dir /run)
    bwrap_cmd+=(--perms 01777 --tmpfs /run/sandworm-tmp)
    bwrap_cmd+=(--perms 01777 --tmpfs /tmp)
    # Preserve X11 socket directory if present
    if [[ "${SW_HOST_INTEGRATIONS:-1}" != "0" && -d /tmp/.X11-unix ]]; then
        bwrap_cmd+=(--dir /tmp/.X11-unix)
        bwrap_cmd+=(--bind /tmp/.X11-unix /tmp/.X11-unix)
    fi

    # Runtime dir (Wayland/Pipewire/DBus). Bind it RW if present.
    if [[ "$has_runtime" == "1" ]]; then
        # Ensure parents exist inside the sandbox
        local parent
        parent="$(dirname "$xdg_runtime")"
        bwrap_cmd+=(--dir "$parent")
        bwrap_cmd+=(--dir "$xdg_runtime")
        bwrap_cmd+=(--bind "$xdg_runtime" "$xdg_runtime")
    fi

    # Environment (mirror container ergonomics)
    bwrap_cmd+=(--clearenv)
    bwrap_cmd+=(--setenv HOME /home/sandworm)
    bwrap_cmd+=(--setenv DEBIAN_FRONTEND noninteractive)
    bwrap_cmd+=(--setenv XDG_CACHE_HOME /home/sandworm/.cache)
    bwrap_cmd+=(--setenv CARGO_HOME /home/sandworm/.cargo)
    bwrap_cmd+=(--setenv NP_LOCATION /home/sandworm/.nix-portable)
    # Ensure rustc/cargo work out-of-the-box: toolroot ships a preinstalled toolchain
    # under /opt/llm/rustup. If we instead point RUSTUP_HOME at $HOME, rustup's proxy
    # binaries will fail unless a default toolchain has been initialized there.
    bwrap_cmd+=(--setenv RUSTUP_HOME /opt/llm/rustup)
    bwrap_cmd+=(--setenv NPM_CONFIG_PREFIX /home/sandworm/.npm-global)
    bwrap_cmd+=(--setenv TMPDIR /run/sandworm-tmp)
    bwrap_cmd+=(--setenv TMP /run/sandworm-tmp)
    bwrap_cmd+=(--setenv TEMP /run/sandworm-tmp)
    bwrap_cmd+=(--setenv PATH "/home/sandworm/.nix-profile/bin:/home/sandworm/.npm-global/bin:/home/sandworm/.local/bin:/home/sandworm/.cargo/bin:/opt/llm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/usr/games:/sbin:/bin")
    bwrap_cmd+=(--setenv USER sandworm)
    bwrap_cmd+=(--setenv SANDWORM_CONTEXT "$posture")
    bwrap_cmd+=(--setenv SANDWORM_BACKEND "bwrap")
    bwrap_cmd+=(--setenv SANDWORM_NETWORK_MODE "host")
    bwrap_cmd+=(--setenv SANDWORM_HOST_INTEGRATIONS "${SW_HOST_INTEGRATIONS:-1}")
    bwrap_cmd+=(--setenv SANDWORM_SECCOMP_UNCONFINED "1")
    bwrap_cmd+=(--setenv SANDWORM_STRICT "${SW_STRICT:-0}")
    bwrap_cmd+=(--setenv SANDWORM_AUTH_PORT_RANGE "${SW_AUTH_PORT_RANGE:-}")
    bwrap_cmd+=(--setenv SANDWORM_GPU_MODE "host")
    bwrap_cmd+=(--setenv PS1 "[sw:${posture}:bwrap] \u@\h:\w\$ ")

    # Pass through common host integration env vars (display/audio/etc.) if set.
    if [[ "${SW_HOST_INTEGRATIONS:-1}" != "0" ]]; then
        for v in DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS PULSE_SERVER SSH_AUTH_SOCK; do
            if [[ -n "${!v:-}" ]]; then bwrap_cmd+=(--setenv "$v" "${!v}"); fi
        done
    fi
    for v in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy SSL_CERT_FILE SSL_CERT_DIR REQUESTS_CA_BUNDLE CURL_CA_BUNDLE NODE_EXTRA_CA_CERTS; do
        if [[ -n "${!v:-}" ]]; then bwrap_cmd+=(--setenv "$v" "${!v}"); fi
    done
    # Debian Python uses PEP 668; allow `pip install --user` for ergonomics.
    bwrap_cmd+=(--setenv PIP_BREAK_SYSTEM_PACKAGES 1)
    # LLM/human legibility: generate caps + env docs in $HOME, and print a small banner.
    local control_visible_json="false"
    local host_visible_json="false"
    if [[ "$posture" == "unsafe" ]]; then
        control_visible_json="true"
        host_visible_json="true"
    fi

    local caps_script
    caps_script=$(cat <<SH
    set -euo pipefail

    echo "[sandworm-entry] starting (backend=bwrap)" >&2
    if [[ "\${SANDWORM_CONTEXT:-safe}" == "unsafe" ]]; then
      echo "=== SANDWORM CONTEXT: UNSAFE (HOST BRIDGE) ===" >&2
      echo "Host access: /host (rw) | Control plane: /control (rw) | .sandworm masked | Host mutation: YES" >&2
    else
      echo "=== SANDWORM CONTEXT: SAFE SANDBOX ===" >&2
      echo "Host access: none | Control plane: masked | Host mutation: NO" >&2
    fi
    echo "Network: \${SANDWORM_NETWORK_MODE:-host} | STRICT: \${SANDWORM_STRICT:-0} | HostIntegrations: \${SANDWORM_HOST_INTEGRATIONS:-1} | SeccompUnconfined: \${SANDWORM_SECCOMP_UNCONFINED:-1} | GPU: \${SANDWORM_GPU_MODE:-host}" >&2

    export STRICT="\${SANDWORM_STRICT:-0}"
    export NETWORK="\${SANDWORM_NETWORK_MODE:-host}"
    export HOST_INTEG="\${SANDWORM_HOST_INTEGRATIONS:-1}"
    export SECCOMP_UNCONFINED="\${SANDWORM_SECCOMP_UNCONFINED:-1}"
    export GPU="\${SANDWORM_GPU_MODE:-host}"

    # Ensure home directory structure exists
    mkdir -p "\$HOME"
    mkdir -p "\$HOME/.npm-global"
    mkdir -p "\$HOME/.local/bin"
    export HOME="\$HOME"

    cat > "\$HOME/SANDWORM_CAPS.json" <<JSON
    {
      "backend": "bwrap",
      "context": "$posture",
      "strict": {
        "enabled": $( [[ "\${SANDWORM_STRICT:-0}" == "1" ]] && echo true || echo false ),
        "auth_port_range": "\${SANDWORM_AUTH_PORT_RANGE:-}"
      },
      "identity": {
        "uid": \$(id -u 2>/dev/null || echo 0),
        "gid": \$(id -g 2>/dev/null || echo 0),
        "user": "\$(id -un 2>/dev/null || echo root)"
      },
      "host_mutation": $( [[ "$posture" == "unsafe" ]] && echo true || echo false ),
      "host_root": $( [[ "$posture" == "unsafe" ]] && echo "\"/host\"" || echo "\"\"" ),
      "host_root_rw": $( [[ "$posture" == "unsafe" ]] && echo true || echo false ),
      "root_maps_to_host_user": true,
      "selinux_label": "n/a",
      "network_mode": "\${SANDWORM_NETWORK_MODE:-host}",
      "host_integrations": $( [[ "\${SANDWORM_HOST_INTEGRATIONS:-1}" == "0" ]] && echo false || echo true ),
      "seccomp_unconfined": true,
      "sandbox_rootfs_persistent": true,

      "gpu": { "requested": "auto", "mode": "\${SANDWORM_GPU_MODE:-host}" },

      "tools": {
        "nix": $( [[ -x /opt/llm/bin/nix ]] && echo true || echo false ),
        "junest": $( [[ -x /opt/llm/bin/junest ]] && echo true || echo false )
      },
      "system": {
        "unprivileged_userns": $( command -v unshare >/dev/null 2>&1 && unshare -Ur true >/dev/null 2>&1 && echo true || echo false ),
        "bwrap": true,
        "proot": $( command -v proot >/dev/null 2>&1 && echo true || echo false )
      },

      "workspace": { "path": "/workspace", "writable": true },
      "workspace_control_plane_masked": true,
      "workspace_control_plane_path": "/workspace/.sandworm",

      "control_plane": { "visible": $control_visible_json, "path": "/control" },

      "notes": [
        "bubblewrap fallback: host kernel + host /usr; less isolated than Podman"
      ]
    }
    JSON

    cat > "\$HOME/SANDWORM_ENV.md" <<MD
    # Sandworm runtime

    You are running under **bubblewrap fallback** (not Podman).

    Quick status:
    - STRICT: \${SANDWORM_STRICT:-0}
    - Network: \${SANDWORM_NETWORK_MODE:-host}
    - Host integrations: \${SANDWORM_HOST_INTEGRATIONS:-1}
    - Seccomp unconfined: \${SANDWORM_SECCOMP_UNCONFINED:-1}
    - GPU: \${SANDWORM_GPU_MODE:-host}

    - Read: \`/home/sandworm/SANDWORM_CAPS.json\` to understand capabilities.
    - Network is shared with the host (wide open).
    - SAFE: /control is absent; /workspace/.sandworm is masked.
    - UNSAFE: /control exposes sandworm state; /host is the host root (RW).
    MD

exec "\$@"
SH
)
    # Use 'bash' instead of '/bin/bash' for NixOS compatibility (bubblewrap sees host filesystem)
    bwrap_cmd+=(bash -lc "$caps_script" -- "${cmd[@]}")

    log_debug "Running (bwrap): ${bwrap_cmd[*]}"
    if "${bwrap_cmd[@]}"; then
        rm -rf "$mask_dir" 2>/dev/null || true
        return 0
    fi

    # If mounting proc is blocked, retry with a bind mount of host /proc (less isolated but more robust).
    local rc=$?
    log_warn "bwrap failed; retrying with host /proc bind (less isolated)"
    local -a bwrap_cmd2=()
    local skip=0
    for ((i=0; i<${#bwrap_cmd[@]}; i++)); do
        if [[ "$skip" == "1" ]]; then skip=0; continue; fi
        if [[ "${bwrap_cmd[$i]}" == "--proc" && "${bwrap_cmd[$((i+1))]:-}" == "/proc" ]]; then
            skip=1
            continue
        fi
        bwrap_cmd2+=("${bwrap_cmd[$i]}")
    done
    bwrap_cmd2+=(--bind /proc /proc)
    log_debug "Running (bwrap retry): ${bwrap_cmd2[*]}"
    if "${bwrap_cmd2[@]}"; then
        rm -rf "$mask_dir" 2>/dev/null || true
        return 0
    fi
    rm -rf "$mask_dir" 2>/dev/null || true
    return "$rc"
}

podman_supports_cdi_spec_dir() {
    # Returns 0 if this podman supports --cdi-spec-dir, else 1.
    # Cached for speed.
    if [[ -n "${PODMAN_HAS_CDI_SPEC_DIR:-}" ]]; then
        [[ "$PODMAN_HAS_CDI_SPEC_DIR" == "1" ]]
        return $?
    fi
    if [[ -z "${PODMAN_BIN:-}" ]]; then
        PODMAN_HAS_CDI_SPEC_DIR="0"
        return 1
    fi
    if "$PODMAN_BIN" --help 2>/dev/null | grep -q -- "--cdi-spec-dir"; then
        PODMAN_HAS_CDI_SPEC_DIR="1"
        return 0
    fi
    PODMAN_HAS_CDI_SPEC_DIR="0"
    return 1
}



prepare_nvidia_oci_hook_dir() {
    # Copy ONLY the NVIDIA OCI hook JSON into a sandworm-owned directory so we
    # don't accidentally enable unrelated host hooks (e.g. systemd hooks).
    # Returns 0 if hook prepared, 1 if not available.
    local dest="${CONTROL}/hooks-nvidia"
    mkdir -p "$dest"

    local src=""
    for p in \
        /etc/containers/oci/hooks.d/oci-nvidia-hook.json \
        /usr/share/containers/oci/hooks.d/oci-nvidia-hook.json \
        /usr/libexec/oci/hooks.d/oci-nvidia-hook.json \
        /usr/share/containers/oci/hooks.d/nvidia-container-toolkit.json \
        /etc/containers/oci/hooks.d/nvidia-container-toolkit.json \
        ; do
        if [[ -f "$p" ]]; then
            src="$p"
            break
        fi
    done

    [[ -n "$src" ]] || return 1

    cp -f "$src" "$dest/oci-nvidia-hook.json"
    chmod 644 "$dest/oci-nvidia-hook.json" 2>/dev/null || true
    return 0
}

podman_add_desktop_integrations() {
    if [[ "${SW_HOST_INTEGRATIONS:-1}" == "0" ]]; then
        return 0
    fi
    # Best-effort desktop integrations (X11/Wayland/DBus/audio/SSH agent/GPU).
    # Missing sockets/devices are skipped.
    # shellcheck disable=SC2178
    local -n _podman_cmd=$1

    # Avoid binding the entire XDG_RUNTIME_DIR as rw,rbind (can be very slow if it contains many submounts).
    # Instead, create an empty runtime dir inside the container and bind only the sockets we need.
    local runtime_uid runtime_dir
    runtime_uid="$(id -u)"
    runtime_dir="${XDG_RUNTIME_DIR:-/run/user/${runtime_uid}}"

    # DISPLAY / X11
    if [[ -n "${DISPLAY:-}" ]]; then
        _podman_cmd+=(-e "DISPLAY=$DISPLAY")
        if [[ -d /tmp/.X11-unix ]]; then _podman_cmd+=(-v "/tmp/.X11-unix:/tmp/.X11-unix:ro"); fi
        if [[ -n "${XAUTHORITY:-}" && -f "${XAUTHORITY:-}" ]]; then
            # Note: Exposes host home path (e.g., /home/user/.Xauthority) for X11 debugging
            # ergonomics. Intentional tradeoff - mountinfo already leaks host paths anyway.
            _podman_cmd+=(-v "$XAUTHORITY:$XAUTHORITY:ro")
            _podman_cmd+=(-e "XAUTHORITY=$XAUTHORITY")
        fi
    fi

    # Wayland
    if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
        _podman_cmd+=(-e "WAYLAND_DISPLAY=$WAYLAND_DISPLAY")
        local wayland_socket="${runtime_dir}/${WAYLAND_DISPLAY}"
        if [[ -S "$wayland_socket" ]]; then _podman_cmd+=(-v "$wayland_socket:$wayland_socket:ro"); fi
    fi

    # XDG runtime dir (PipeWire, Wayland, portals, etc.) - container-local stub.
    # Keep the env var so tools that expect it don't break, but don't bind the whole host dir.
    _podman_cmd+=(-e "XDG_RUNTIME_DIR=$runtime_dir")
    _podman_cmd+=(--tmpfs "${runtime_dir}:rw,mode=700")

    # DBUS session bus
    if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        _podman_cmd+=(-e "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS")
        local dbus_socket="${DBUS_SESSION_BUS_ADDRESS#unix:path=}"
        dbus_socket="${dbus_socket%%,*}"
        if [[ -S "$dbus_socket" ]]; then _podman_cmd+=(-v "$dbus_socket:$dbus_socket:ro"); fi
    fi

    # SSH agent
    if [[ -n "${SSH_AUTH_SOCK:-}" && -S "${SSH_AUTH_SOCK:-}" ]]; then
        _podman_cmd+=(-v "$SSH_AUTH_SOCK:/tmp/ssh-agent:ro")
        _podman_cmd+=(-e "SSH_AUTH_SOCK=/tmp/ssh-agent")
    fi

    # Git config (read-only) - handle both traditional and XDG locations
    if [[ -f "$HOME/.gitconfig" ]]; then
        _podman_cmd+=(-v "$HOME/.gitconfig:/home/sandworm/.gitconfig:ro")
    fi
    # XDG_CONFIG_HOME for git (defaults to ~/.config if not set)
    local git_xdg_config="${XDG_CONFIG_HOME:-$HOME/.config}/git"
    if [[ -d "$git_xdg_config" ]]; then
        _podman_cmd+=(-v "$git_xdg_config:/home/sandworm/.config/git:ro")
    fi

    # Audio (Pulse/ PipeWire)
    if [[ -n "${PULSE_SERVER:-}" ]]; then
        _podman_cmd+=(-e "PULSE_SERVER=$PULSE_SERVER")
    elif [[ -S "${runtime_dir}/pulse/native" ]]; then
        _podman_cmd+=(-e "PULSE_SERVER=unix:${runtime_dir}/pulse/native")
    fi
    if [[ -f "$HOME/.config/pulse/cookie" ]]; then _podman_cmd+=(-v "$HOME/.config/pulse/cookie:/home/sandworm/.config/pulse/cookie:ro"); fi
    # Pulse socket lives under a subdir; mount just the socket, not the entire runtime dir.
    if [[ -S "${runtime_dir}/pulse/native" ]]; then
        _podman_cmd+=(--tmpfs "${runtime_dir}/pulse:rw,mode=700")
        _podman_cmd+=(-v "${runtime_dir}/pulse/native:${runtime_dir}/pulse/native:ro")
    fi
    if [[ -S "${runtime_dir}/pipewire-0" ]]; then _podman_cmd+=(-v "${runtime_dir}/pipewire-0:${runtime_dir}/pipewire-0:ro"); fi
    if [[ -d /dev/snd ]]; then _podman_cmd+=(--device /dev/snd); fi

    # GPU (auto by default; disable with SW_GPU=0)
    # Modes: auto|cdi|hook|direct|0
    # - auto: prefer NVIDIA CDI if present; otherwise use direct /dev mounts + OCI hook (if available)
    # - cdi: force CDI (requires /etc/cdi or /var/run/cdi spec). If CDI is broken, set SW_GPU=hook.
    # - hook: force direct /dev mounts + OCI hook
    # - direct: force direct /dev mounts only (no OCI hook)
    local gpu_requested="${SW_GPU:-auto}"
    local gpu_effective="none"
    local gpu_mode="$gpu_requested"

    log_debug "GPU: requested=$gpu_requested"

    if [[ "$gpu_mode" != "0" ]]; then
        local nvidia_present="0"
        if [[ -e /dev/nvidia0 || -e /dev/nvidiactl ]]; then nvidia_present="1"; fi

        local nvidia_cdi_present="0"
        local nvidia_cdi_etc="0"
        local nvidia_cdi_run="0"
        if [[ -f /etc/cdi/nvidia.yaml ]] || ls /etc/cdi/nvidia*.yaml >/dev/null 2>&1; then
            nvidia_cdi_etc="1"
        fi
        if [[ -f /var/run/cdi/nvidia.yaml || -f /run/cdi/nvidia.yaml ]] || ls /var/run/cdi/nvidia*.yaml >/dev/null 2>&1 || ls /run/cdi/nvidia*.yaml >/dev/null 2>&1; then
            nvidia_cdi_run="1"
        fi
        if [[ "$nvidia_cdi_etc" == "1" || "$nvidia_cdi_run" == "1" ]]; then nvidia_cdi_present="1"; fi

        if [[ "$nvidia_present" == "1" ]]; then
            case "$gpu_mode" in
                cdi)
                    if [[ "$nvidia_cdi_present" == "1" ]]; then
                        # Some podman versions only search /etc/cdi by default. If the
                        # spec lives in /var/run/cdi or /run/cdi, opt-in explicitly.
                        if [[ "$nvidia_cdi_run" == "1" && "$nvidia_cdi_etc" == "0" ]] && podman_supports_cdi_spec_dir; then
                            _podman_cmd+=(--cdi-spec-dir=/etc/cdi --cdi-spec-dir=/var/run/cdi --cdi-spec-dir=/run/cdi)
                        fi
                        _podman_cmd+=(--device nvidia.com/gpu=all)
                        gpu_effective="nvidia-cdi"
                    else
                        log_warn "SW_GPU=cdi requested, but no NVIDIA CDI spec found. Falling back to direct devices."
                        gpu_mode="direct"
                    fi
                    ;;
                auto)
                    if [[ "$nvidia_cdi_present" == "1" ]]; then
                        # Prefer CDI when available. Avoid OCI hooks in this path.
                        if [[ "$nvidia_cdi_run" == "1" && "$nvidia_cdi_etc" == "0" ]] && podman_supports_cdi_spec_dir; then
                            _podman_cmd+=(--cdi-spec-dir=/etc/cdi --cdi-spec-dir=/var/run/cdi --cdi-spec-dir=/run/cdi)
                        fi
                        _podman_cmd+=(--device nvidia.com/gpu=all)
                        gpu_effective="nvidia-cdi"
                    else
                        gpu_mode="hook"
                    fi
                    ;;
            esac

            if [[ "$gpu_mode" == "hook" || "$gpu_mode" == "direct" ]]; then
                if [[ "$gpu_mode" == "hook" ]]; then
                    gpu_effective="nvidia-hook"
                else
                    gpu_effective="nvidia-direct"
                fi
                _podman_cmd+=(--device /dev/nvidia0 --device /dev/nvidiactl --device /dev/nvidia-uvm)
                if [[ -e /dev/nvidia-uvm-tools ]]; then _podman_cmd+=(--device /dev/nvidia-uvm-tools); fi

                if [[ "$gpu_mode" == "hook" ]]; then
                    if command -v nvidia-container-cli >/dev/null 2>&1 || command -v nvidia-container-runtime-hook >/dev/null 2>&1; then
                        if prepare_nvidia_oci_hook_dir; then
                            _podman_cmd+=(--hooks-dir "$CONTROL/hooks-nvidia")
                            _podman_cmd+=(--annotation sandbox=1)
                            _podman_cmd+=(-e NVIDIA_VISIBLE_DEVICES=all -e NVIDIA_DRIVER_CAPABILITIES=all)
                        fi
                    fi
                fi
            fi
        fi

        # AMD ROCm
        if [[ -e /dev/kfd ]]; then
            _podman_cmd+=(--device /dev/kfd)
            if [[ -d /dev/dri ]]; then _podman_cmd+=(--device /dev/dri); fi
            if [[ "$gpu_effective" == "none" ]]; then gpu_effective="amd"; fi
        elif [[ -d /dev/dri ]]; then
            _podman_cmd+=(--device /dev/dri)
            if [[ "$gpu_effective" == "none" ]]; then gpu_effective="dri"; fi
        fi
    fi

    _podman_cmd+=(-e "SANDWORM_GPU_REQUESTED=$gpu_requested" -e "SANDWORM_GPU_MODE=$gpu_effective")

    # Log GPU detection results for debugging
    log_info "GPU: requested=$gpu_requested, detected=$gpu_effective"

}

run_in_container_posture() {
    local posture="$1"; shift


    # If anything fails under set -e, log the failing command/line to make debugging possible
    if [[ "${SW_DEBUG_LEVEL:-0}" -ge 2 ]]; then
        trap 'log_error "run_in_container_posture failed at line ${LINENO}: ${BASH_COMMAND}"' ERR
    fi
    local cmd=("$@")

    if [[ "${SW_STRICT:-0}" == "1" && "$posture" == "unsafe" ]]; then
        die "STRICT mode forbids --unsafe"
    fi

    # Get current toolroot
    local current_rev
    current_rev=$(get_state "SW_REV_CURRENT" "")
    [[ -n "$current_rev" ]] || die "No active toolroot. Run 'sandworm refresh' first."

    local toolroot_dir="$CONTROL/toolroots/$current_rev"
    [[ -d "$toolroot_dir" ]] || die "Toolroot not found: $toolroot_dir"

    # Prefer Podman. If it is missing/broken, fall back to bubblewrap (bwrap).
    if ! ensure_podman_storage --try; then
        if [[ "${SW_STRICT:-0}" == "1" ]]; then
            die "STRICT mode requires Podman (bwrap fallback disabled)"
        fi
        local toolroot_realpath_fallback
        toolroot_realpath_fallback=$(realpath "$toolroot_dir")
        run_in_bwrap_posture "$posture" "$toolroot_realpath_fallback" "${cmd[@]}"
        return 0
    fi

    unset PODMAN_USERNS  # ignore user overrides; we rely on rootless default userns mapping


    local workspace_realpath home_realpath toolroot_realpath control_realpath
    workspace_realpath=$(realpath "$WORKSPACE")
    home_realpath=$(realpath "$CONTROL/home")
    toolroot_realpath=$(realpath "$toolroot_dir")
    control_realpath=$(realpath "$CONTROL")

    local host_mutation="0"
    local host_root=""
    local control_visible="0"
    local root_maps_to_host_user="0"

    # Build command array element by element for clarity
    local podman_cmd=()

    if [[ "$posture" == "unsafe" ]]; then
        host_mutation="1"
        host_root="/host"
        control_visible="1"

        # Unsafe requires rootful podman to mutate the host.
        # If we are not root, require passwordless sudo (or the user runs via sudo).
        if [[ "$(id -u)" -ne 0 ]]; then
            if command -v sudo >/dev/null 2>&1; then
                local sudo_flags=()
                if sudo -n true 2>/dev/null; then
                    sudo_flags=(-n)
                elif [[ -t 0 ]]; then
                    sudo_flags=()
                else
                    die "--unsafe requires rootful podman. No TTY for sudo and passwordless sudo is not enabled."
                fi
                podman_cmd+=(sudo "${sudo_flags[@]}" env
                    "CONTAINERS_STORAGE_CONF=$CONTAINERS_STORAGE_CONF"
                    "XDG_DATA_HOME=$XDG_DATA_HOME"
                    "XDG_CONFIG_HOME=$XDG_CONFIG_HOME"
                    "TMPDIR=$TMPDIR"
                    "$PODMAN_BIN")
            else
                die "--unsafe requires rootful podman (sudo not found). Re-run as root."
            fi
        else
            podman_cmd+=("$PODMAN_BIN")
        fi
    else
        podman_cmd+=("$PODMAN_BIN")
    fi


    if [[ "$posture" == "unsafe" ]]; then
        root_maps_to_host_user="0"
    else
        # Rootless default: container uid 0 maps to the invoking host uid.
        root_maps_to_host_user="1"
    fi

    # Rootfs image tag (may be advanced by prior runs when SW_PERSIST_ROOTFS=1)
    local rootfs_tag
    rootfs_tag="$(get_state "SW_ROOTFS_TAG" "$SEED_TAG")"
    # Avoid Podman short-name prompts/pulls when older state stored an unqualified tag.
    if [[ -n "${SEED_TAG_SHORT:-}" && "$rootfs_tag" == "$SEED_TAG_SHORT" ]]; then
        rootfs_tag="$SEED_TAG"
    elif [[ "$rootfs_tag" == sandworm-seed:* ]] && "$PODMAN_BIN" image exists "localhost/$rootfs_tag" >/dev/null 2>&1; then
        rootfs_tag="localhost/$rootfs_tag"
    fi
    # If the stored tag is missing (e.g., manual podman cleanup), fall back to seed.
    if ! "$PODMAN_BIN" image exists "$rootfs_tag" >/dev/null 2>&1; then
        rootfs_tag="$SEED_TAG"
        set_state "SW_ROOTFS_TAG" "$rootfs_tag"
        write_state_json "$CONTROL/state.json"
    fi

    mkdir -p "$CONTROL/podman" 2>/dev/null || true
    local container_name cidfile
    container_name="sw-${posture}-$(generate_rev_id)"
    cidfile="$CONTROL/podman/${container_name}.cid"

    podman_cmd+=(run --pull=never -i --name "$container_name" --cidfile "$cidfile")
    if [[ -t 0 ]]; then podman_cmd+=(-t); fi
    podman_cmd+=(--hooks-dir "$CONTROL/hooks-empty")
    podman_cmd+=(--hostname "sandworm-$posture")
    # Use init process (tini) to properly reap zombie processes
    podman_cmd+=(--init)

    # Resource limits (optional; default wide open)
    podman_add_resource_limits podman_cmd

    
    # SELinux labeling: robust-by-default on enforcing systems.
# In --unsafe, we mount the host root; relabeling that is not viable, so we force label=disable.
local selinux_label="n/a"
local selinux_opts=()
local selinux_volume_opt=""
local selinux_mode="${SW_SELINUX_MODE:-auto}"

if [[ "$posture" == "unsafe" ]]; then
    if [[ "${SW_SELINUX_MODE:-auto}" == "z" || "${SW_SELINUX_MODE:-auto}" == "Z" ]]; then
        log_warn "SW_SELINUX_MODE=${SW_SELINUX_MODE} not supported with --unsafe host mount; forcing label=disable."
    fi
    selinux_mode="disable"
fi

case "$selinux_mode" in
    disable)
        selinux_label="disabled"
        selinux_opts=(--security-opt label=disable)
        ;;
    enforce)
        selinux_label="enabled"
        selinux_opts=()
        ;;
    z|Z)
        # Relabel only the sandworm-managed bind mounts (SAFE only).
        selinux_label="relabel-$selinux_mode"
        selinux_volume_opt=",$selinux_mode"
        selinux_opts=()
        ;;
    auto|*)
    # If SELinux is enabled (Enforcing or Permissive), volume relabeling can be a sharp edge.
    # Default to label=disable for robustness; users can opt into z/Z or enforce explicitly.
    local active="0"
    if command -v getenforce >/dev/null 2>&1; then
        local ge
        ge="$(getenforce 2>/dev/null || true)"
        if [[ "$ge" != "Disabled" && "$ge" != "" ]]; then
            active="1"
        fi
    elif [[ -r /sys/fs/selinux/enforce ]]; then
        # Presence of /sys/fs/selinux/enforce generally implies SELinux is enabled.
        active="1"
    elif command -v selinuxenabled >/dev/null 2>&1; then
        if selinuxenabled 2>/dev/null; then
            active="1"
        fi
    fi

    if [[ "$active" == "1" ]]; then
        selinux_label="disabled"
        selinux_opts=(--security-opt label=disable)
    else
        selinux_label="n/a"
        selinux_opts=()
    fi
    ;;
esac
podman_cmd+=("${selinux_opts[@]}")

    # Some userland virtualization tools (notably proot) require ptrace. Many container
    # seccomp profiles deny it, which breaks JuNest/nix-portable at runtime.
    # In SAFE (no host mutation), default to unconfined for better ergonomics.
    if [[ "$posture" == "safe" && "${SW_SAFE_UNCONFINED:-1}" == "1" ]]; then
        podman_cmd+=(--security-opt seccomp=unconfined)
    fi

    if [[ "$posture" == "unsafe" ]]; then
        podman_cmd+=(--privileged --pid=host --ipc=host --uts=host)
    else
        # SAFE: run as root inside the rootless user namespace (enables apt-get installs without host privileges)
        :
    fi

    # Mounts
    podman_cmd+=(-v "$workspace_realpath:/workspace:rw,rbind${selinux_volume_opt}")
    if [[ "${SW_VOLUME_CHOWN:-1}" == "1" ]]; then
        podman_cmd+=(-v "$home_realpath:/home/sandworm:rw,rbind,U${selinux_volume_opt}")
    else
        podman_cmd+=(-v "$home_realpath:/home/sandworm:rw,rbind${selinux_volume_opt}")
    fi
    podman_cmd+=(-v "$toolroot_realpath:/opt/llm:ro")

    # Persistent apt caches (speed up apt-get across runs)
    local apt_lists_dir="$CONTROL/cache/apt/lists"
    local apt_archives_dir="$CONTROL/cache/apt/archives"
    mkdir -p "$apt_lists_dir/partial" "$apt_archives_dir/partial"
    local apt_lists_realpath apt_archives_realpath
    apt_lists_realpath=$(realpath "$apt_lists_dir")
    apt_archives_realpath=$(realpath "$apt_archives_dir")
    local apt_lists_opts="rw${selinux_volume_opt}"
    local apt_archives_opts="rw${selinux_volume_opt}"
    if [[ "${SW_VOLUME_CHOWN:-1}" == "1" ]]; then
        apt_lists_opts="rw,U${selinux_volume_opt}"
        apt_archives_opts="rw,U${selinux_volume_opt}"
    fi
    podman_cmd+=(-v "$apt_lists_realpath:/var/lib/apt/lists:${apt_lists_opts}")
    podman_cmd+=(-v "$apt_archives_realpath:/var/cache/apt/archives:${apt_archives_opts}")


    # Always mask /workspace/.sandworm to avoid accidental self-modification loops.
    # Use a temp dir outside /workspace to avoid nested bind mounts (can be slow/hang).
    local mask_dir mask_realpath
    mask_dir="$(mktemp -d /tmp/sandworm-mask.XXXXXX)"
    chmod 755 "$mask_dir" 2>/dev/null || true
    mask_realpath="$(realpath "$mask_dir")"
    podman_cmd+=(-v "$mask_realpath:/workspace/.sandworm:ro${selinux_volume_opt}")

    if [[ "$posture" == "unsafe" ]]; then
        # Expose control plane and host root explicitly.
        podman_cmd+=(-v "$control_realpath:/control:rw${selinux_volume_opt}")
        # Use rbind so submounts (e.g. /nix, /var, /boot) are visible under /host.
        podman_cmd+=(--mount "type=bind,src=/,dst=/host,rw,bind-propagation=rslave")
    fi

    # Scratch tmpfs and tmp semantics.
    podman_cmd+=(--tmpfs "/run/sandworm-tmp:rw,mode=1777")
    if [[ "${SW_TMPFS_TMP:-0}" == "1" ]]; then
        podman_cmd+=(--tmpfs "/tmp:rw,mode=1777")
    fi

    # Environment (make installs ergonomic for LLMs)
    podman_cmd+=(-e HOME=/home/sandworm)
    podman_cmd+=(-e USER=sandworm)
    podman_cmd+=(-e "TMPDIR=/run/sandworm-tmp")
    podman_cmd+=(-e "TMP=/run/sandworm-tmp")
    podman_cmd+=(-e "TEMP=/run/sandworm-tmp")
    podman_cmd+=(-e "DEBIAN_FRONTEND=noninteractive")
    podman_cmd+=(-e "XDG_CACHE_HOME=/home/sandworm/.cache")
    podman_cmd+=(-e "CARGO_HOME=/home/sandworm/.cargo")
    # Pin NP_LOCATION to a stable absolute path to prevent accidental nesting.
    podman_cmd+=(-e "NP_LOCATION=/home/sandworm/.nix-portable")
    # Ensure rustc/cargo work out-of-the-box: toolroot ships a preinstalled toolchain
    # under /opt/llm/rustup. If we instead point RUSTUP_HOME at $HOME, rustup's proxy
    # binaries will fail unless a default toolchain has been initialized there.
    podman_cmd+=(-e "RUSTUP_HOME=/opt/llm/rustup")
    podman_cmd+=(-e "NPM_CONFIG_PREFIX=/home/sandworm/.npm-global")
    podman_cmd+=(-e "PATH=/home/sandworm/.nix-profile/bin:/home/sandworm/.npm-global/bin:/home/sandworm/.local/bin:/home/sandworm/.cargo/bin:/opt/llm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/usr/games:/sbin:/bin")
    # Reduce common tool noise and make git usable in both rootless/rootful contexts.
    podman_cmd+=(-e "PIP_ROOT_USER_ACTION=ignore")
    podman_cmd+=(-e "PIP_DISABLE_PIP_VERSION_CHECK=1")
    podman_cmd+=(-e "PIP_BREAK_SYSTEM_PACKAGES=1")
    # Add safe.directory for /workspace. Append to existing GIT_CONFIG_* if present.
    local git_cfg_idx="${GIT_CONFIG_COUNT:-0}"
    podman_cmd+=(-e "GIT_CONFIG_COUNT=$((git_cfg_idx + 1))")
    podman_cmd+=(-e "GIT_CONFIG_KEY_${git_cfg_idx}=safe.directory")
    podman_cmd+=(-e "GIT_CONFIG_VALUE_${git_cfg_idx}=/workspace")
    # Pass through any existing GIT_CONFIG_* entries from the host
    if [[ "$git_cfg_idx" -gt 0 ]]; then
        for ((i=0; i<git_cfg_idx; i++)); do
            local key_var="GIT_CONFIG_KEY_$i"
            local val_var="GIT_CONFIG_VALUE_$i"
            if [[ -n "${!key_var:-}" ]]; then
                podman_cmd+=(-e "$key_var=${!key_var}")
                podman_cmd+=(-e "$val_var=${!val_var:-}")
            fi
        done
    fi

    # Pass through proxy/CA environment if set (corporate networks).
    for v in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy SSL_CERT_FILE SSL_CERT_DIR REQUESTS_CA_BUNDLE CURL_CA_BUNDLE NODE_EXTRA_CA_CERTS; do
        if [[ -n "${!v:-}" ]]; then podman_cmd+=(-e "$v=${!v}"); fi
    done

    # Prompt (interactive shells)
    podman_cmd+=(-e "PS1=[sw:${posture}] \u@\h:\w\$ ")
    podman_cmd+=(-e "SANDWORM_SELINUX_LABEL=$selinux_label")
    podman_cmd+=(-e "SW_DEBUG_LEVEL=${SW_DEBUG_LEVEL:-0}")

    podman_cmd+=(-e "SANDWORM_CONTEXT=$posture")
    podman_cmd+=(-e "SANDWORM_BACKEND=podman")
    podman_cmd+=(-e "SANDWORM_HOST_MUTATION=$host_mutation")
    podman_cmd+=(-e "SANDWORM_HOST_ROOT=$host_root")
    podman_cmd+=(-e "SANDWORM_CONTROL_VISIBLE=$control_visible")
    podman_cmd+=(-e "SANDWORM_ROOT_MAPS_TO_HOST_USER=$root_maps_to_host_user")
    local network_mode_effective="${SW_NETWORK_MODE:-host}"
    if [[ "${SW_OFFLINE:-0}" == "1" ]]; then
        network_mode_effective="none"
    fi
    podman_cmd+=(-e "SANDWORM_NETWORK_MODE=$network_mode_effective")
    podman_cmd+=(-e "SANDWORM_ROOTFS_PERSISTENT=${SW_PERSIST_ROOTFS:-1}")
    podman_cmd+=(-e "SANDWORM_STRICT=${SW_STRICT:-0}")
    if [[ "${SW_STRICT:-0}" == "1" ]]; then
        podman_cmd+=(-e "SANDWORM_AUTH_PORT_RANGE=${SW_AUTH_PORT_RANGE:-}")
    fi
    podman_cmd+=(-e "SANDWORM_HOST_INTEGRATIONS=${SW_HOST_INTEGRATIONS:-1}")
    local seccomp_unconfined="0"
    if [[ "$posture" == "safe" && "${SW_SAFE_UNCONFINED:-1}" == "1" ]]; then
        seccomp_unconfined="1"
    fi
    podman_cmd+=(-e "SANDWORM_SECCOMP_UNCONFINED=$seccomp_unconfined")
    podman_cmd+=(-w /workspace)
    # Network mode
    podman_add_auth_ports podman_cmd "$posture"
    podman_add_network_mode podman_cmd "$posture"

    # Desktop integrations
    podman_add_desktop_integrations podman_cmd

    # Rootfs image
    podman_cmd+=("$rootfs_tag")

    # Entry script: write env/caps, print banner, verify masking if safe, then exec.
    local entry_script='
        set -euo pipefail

        echo "[sandworm-entry] starting (backend=${SANDWORM_BACKEND:-podman} debug=${SW_DEBUG_LEVEL:-0})" >&2
            if [[ "${SANDWORM_CONTEXT:-safe}" == "unsafe" ]]; then
                echo "=== SANDWORM CONTEXT: UNSAFE (HOST BRIDGE) ===" >&2
                echo "Host access: ${SANDWORM_HOST_ROOT:-/host} (rw) | Control plane: /control (rw) | .sandworm masked | Host mutation: YES" >&2
            else
                echo "=== SANDWORM CONTEXT: SAFE SANDBOX ===" >&2
                echo "Host access: none | Control plane: masked | Host mutation: NO" >&2
            fi
            echo "Network: ${SANDWORM_NETWORK_MODE:-default} | STRICT: ${SANDWORM_STRICT:-0} | HostIntegrations: ${SANDWORM_HOST_INTEGRATIONS:-1} | SeccompUnconfined: ${SANDWORM_SECCOMP_UNCONFINED:-0} | GPU: ${SANDWORM_GPU_MODE:-none}" >&2

            # Convenience env vars for quick copy/paste probes and LLM prompts.
            export STRICT="${SANDWORM_STRICT:-0}"
            export NETWORK="${SANDWORM_NETWORK_MODE:-default}"
            export HOST_INTEG="${SANDWORM_HOST_INTEGRATIONS:-1}"
            export SECCOMP_UNCONFINED="${SANDWORM_SECCOMP_UNCONFINED:-0}"
            export GPU="${SANDWORM_GPU_MODE:-none}"

            if [[ "${SW_DEBUG_LEVEL:-0}" -ge 3 ]]; then
                set -x
            fi

            # Ensure home directory structure exists
            mkdir -p "$HOME"
            mkdir -p "$HOME/.npm-global"
            mkdir -p "$HOME/.local/bin"

            caps="$HOME/SANDWORM_CAPS.json"
if ! : >"$caps" 2>/dev/null; then
  caps="${TMPDIR:-/tmp}/SANDWORM_CAPS.json"
fi
        envdoc="$HOME/SANDWORM_ENV.md"
if ! : >"$envdoc" 2>/dev/null; then
  envdoc="${TMPDIR:-/tmp}/SANDWORM_ENV.md"
fi
            echo "[sandworm-entry] writing caps to $caps" >&2
            echo "[sandworm-entry] tip: cat \"$caps\" (capabilities) or \"$envdoc\" (human/LLM notes)" >&2
            host_mutation_bool=false
            if [[ "${SANDWORM_HOST_MUTATION:-0}" == "1" ]]; then host_mutation_bool=true; fi
        control_visible_bool=false
        if [[ "${SANDWORM_CONTROL_VISIBLE:-0}" == "1" ]]; then control_visible_bool=true; fi
        root_maps_bool=false
        if [[ "${SANDWORM_ROOT_MAPS_TO_HOST_USER:-0}" == "1" ]]; then root_maps_bool=true; fi
        host_root_rw_bool=false
        if [[ -n "${SANDWORM_HOST_ROOT:-}" ]]; then host_root_rw_bool=true; fi
        rootfs_persistent_bool=false
        if [[ "${SANDWORM_ROOTFS_PERSISTENT:-1}" == "1" ]]; then rootfs_persistent_bool=true; fi
            selinux_label="${SANDWORM_SELINUX_LABEL:-disabled}"

            strict_enabled_bool=false
            if [[ "${SANDWORM_STRICT:-0}" == "1" ]]; then strict_enabled_bool=true; fi
            host_integrations_bool=true
            if [[ "${SANDWORM_HOST_INTEGRATIONS:-1}" == "0" ]]; then host_integrations_bool=false; fi
            seccomp_unconfined_bool=false
            if [[ "${SANDWORM_SECCOMP_UNCONFINED:-0}" == "1" ]]; then seccomp_unconfined_bool=true; fi

            # Capability probes for LLM ergonomics
            nix_bool=false
            if [[ -x /opt/llm/bin/nix ]]; then nix_bool=true; fi
        junest_bool=false
        if [[ -x /opt/llm/bin/junest ]]; then junest_bool=true; fi

        unpriv_userns=false
        if command -v unshare >/dev/null 2>&1 && unshare -Ur true >/dev/null 2>&1; then
          unpriv_userns=true
        fi
        bwrap_bool=false
        if command -v bwrap >/dev/null 2>&1; then bwrap_bool=true; fi
            proot_bool=false
            if command -v proot >/dev/null 2>&1; then proot_bool=true; fi
{ cat > "$caps" <<JSON
{
  "backend": "${SANDWORM_BACKEND:-podman}",
  "context": "${SANDWORM_CONTEXT:-safe}",
  "strict": {
    "enabled": ${strict_enabled_bool},
    "auth_port_range": "${SANDWORM_AUTH_PORT_RANGE:-}"
  },
  "identity": {
    "uid": $(id -u 2>/dev/null || echo 0),
    "gid": $(id -g 2>/dev/null || echo 0),
    "user": "$(id -un 2>/dev/null || echo root)"
  },
  "host_mutation": ${host_mutation_bool},
  "host_root": "${SANDWORM_HOST_ROOT:-}",
  "host_root_rw": ${host_root_rw_bool},
  "root_maps_to_host_user": ${root_maps_bool},
  "selinux_label": "${selinux_label}",
  "network_mode": "${SANDWORM_NETWORK_MODE:-default}",
  "host_integrations": ${host_integrations_bool},
  "seccomp_unconfined": ${seccomp_unconfined_bool},
  "sandbox_rootfs_persistent": ${rootfs_persistent_bool},

  "gpu": { "requested": "${SANDWORM_GPU_REQUESTED:-auto}", "mode": "${SANDWORM_GPU_MODE:-none}" },

  "tools": {
    "nix": ${nix_bool},
    "junest": ${junest_bool}
  },
  "system": {
    "unprivileged_userns": ${unpriv_userns},
    "bwrap": ${bwrap_bool},
    "proot": ${proot_bool}
  },

  "workspace": { "path": "/workspace", "writable": true },
  "workspace_control_plane_masked": true,
  "workspace_control_plane_path": "/workspace/.sandworm",

  "control_plane": { "visible": ${control_visible_bool}, "path": "/control" },

  "host_exec_hints": [
    "host <cmd>  # wrapper around nsenter",
    "chroot ${SANDWORM_HOST_ROOT:-/host} /bin/bash",
    "nsenter -t 1 -m -u -i -n -p -- <cmd>"
  ],

  "installs": {
    "user_space": true,
    "home": "/home/sandworm",
    "note": "Prefer HOME-based installs (pip --user, npm prefix, cargo). System packages installed in SAFE persist across sandworm runs (stored under .sandworm). Host-installed packages do not automatically exist in sandbox runs."
  }
