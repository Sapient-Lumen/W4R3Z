cmd_doctor() {
    local json_mode=0
    local diag_mode=0
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json_mode=1; shift ;;
            --diag|--debug) diag_mode=1; SW_DEBUG_LEVEL=2; shift ;;
            *) shift ;;
        esac
    done
    
    log_info "Running diagnostics..."

    # Ensure podman storage env is initialized so `podman info` works
    ensure_podman_storage --try >/dev/null 2>&1 || true
    
    if [[ $diag_mode -eq 1 ]]; then
        log_info "=== EXTENDED DIAGNOSTICS MODE ==="
        dump_debug_state "doctor-diag"
    fi
    
    local issues=()
    
    # Workspace info
    local workspace_source="pwd"
    if [[ -n "${SW_WORKSPACE_ROOT:-}" ]]; then
        workspace_source="env"
    elif git rev-parse --show-toplevel >/dev/null 2>&1; then
        workspace_source="git"
    fi
    
    # Podman status
    local podman_version="not found"
    local podman_rootless="unknown"
    local podman_storage_driver="unknown"
    local podman_graphroot="unknown"
    
    if check_podman; then
        podman_version=$(podman --version 2>/dev/null | head -1)
        if check_podman_rootless; then
            podman_rootless="yes"
        else
            podman_rootless="no"
            issues+=("Podman rootless mode not configured")
        fi

        # Rootless networking helpers (best-effort). Only warn if the user is not on host networking.
        local network_mode_effective="${SW_NETWORK_MODE:-host}"
        if [[ "${SW_OFFLINE:-0}" == "1" ]]; then
            network_mode_effective="none"
        fi
        if [[ "$network_mode_effective" != "host" && "$network_mode_effective" != "none" ]]; then
            if ! command -v slirp4netns >/dev/null 2>&1; then
                issues+=("slirp4netns not found (rootless networking may fail)")
            fi
            # Optional hint: pasta is used by some newer Podman setups.
            if ! command -v pasta >/dev/null 2>&1; then
                issues+=("pasta not found (some rootless networking modes may be unavailable)")
            fi
        fi
        
        # Get storage info if available
        if [[ $diag_mode -eq 1 ]]; then
            podman_storage_driver=$(podman info --format '{{.Store.GraphDriverName}}' 2>/dev/null || echo "unknown")
            podman_graphroot=$(podman info --format '{{.Store.GraphRoot}}' 2>/dev/null || echo "unknown")
        fi
    else
        issues+=("Podman not found or not working")
    fi
    
    # State
    local state
    state=$(get_state "SW_STATE" "UNINITIALIZED")
    
    local current_rev
    current_rev=$(get_state "SW_REV_CURRENT" "none")
    
    local last_refresh
    last_refresh=$(get_state "SW_LAST_REFRESH_UTC" "never")

    local last_seed_tag rootfs_tag
    last_seed_tag=$(get_state "SW_SEED_TAG" "unknown")
    rootfs_tag=$(get_state "SW_ROOTFS_TAG" "unknown")
    
    local last_error
    last_error=$(get_state "SW_LAST_ERROR" "")
    
    # Component status
    local node_ok rust_ok nix_ok codex_ok claude_ok gemini_ok
    node_ok=$(get_state "SW_NODE_OK" "0")
    rust_ok=$(get_state "SW_RUST_OK" "0")
    nix_ok=$(get_state "SW_NIX_OK" "0")
    codex_ok=$(get_state "SW_CODEX_OK" "0")
    claude_ok=$(get_state "SW_CLAUDE_OK" "0")
    gemini_ok=$(get_state "SW_GEMINI_OK" "0")
    
    # Masking status
    local masking_status="unknown"
    if [[ "$state" != "UNINITIALIZED" ]] && [[ "$current_rev" != "none" ]]; then
        if run_in_container_check_only; then
            masking_status="verified"
        else
            masking_status="FAILED"
            issues+=("Masking verification failed!")
        fi
    fi
    
    # Disk usage (best-effort; rootless storage may contain unreadable dirs)
    local disk_usage="unknown"
    if [[ -d "$CONTROL" ]]; then
        disk_usage="$(du -sh "$CONTROL" 2>/dev/null | cut -f1 2>/dev/null || true)"
        [[ -n "${disk_usage:-}" ]] || disk_usage="unknown"
    fi
    if [[ $json_mode -eq 1 ]]; then
            # JSON output
            cat <<JSON
{
  "version": "$SW_VERSION",
  "log_file": "$LOG_FILE",
  "config": {
    "strict": ${SW_STRICT:-0},
    "offline": ${SW_OFFLINE:-0},
    "network_mode": "${SW_NETWORK_MODE:-host}",
    "host_integrations": ${SW_HOST_INTEGRATIONS:-1},
    "safe_seccomp_unconfined": ${SW_SAFE_UNCONFINED:-1},
    "gpu": "${SW_GPU:-auto}"
  },
  "workspace": "$WORKSPACE",
  "workspace_source": "$workspace_source",
  "control_plane": "$CONTROL",
  "state": "$state",
      "podman_version": "$podman_version",
      "podman_rootless": "$podman_rootless",
      "seed_tag": "$SEED_TAG",
      "seed_tag_last_refresh": "$last_seed_tag",
      "rootfs_tag": "$rootfs_tag",
      "toolroot_revision": "$current_rev",
      "last_refresh": "$last_refresh",
      "masking": "$masking_status",
  "components": {
    "node": $node_ok,
    "rust": $rust_ok,
    "nix": $nix_ok,
    "codex": $codex_ok,
    "claude": $claude_ok,
    "gemini": $gemini_ok
  },
  "disk_usage": "$disk_usage",
  "issues": $(printf '%s\n' "${issues[@]:-}" | jq -R . | jq -s .)
}
JSON
    else
        # Human output
        printf '\n'
        printf '╔══════════════════════════════════════════════════════════════╗\n'
        printf '║                    sandworm diagnostics                      ║\n'
        printf '╚══════════════════════════════════════════════════════════════╝\n'
        printf '\n'
        printf '  Version:          %s\n' "$SW_VERSION"
        printf '  Workspace:        %s (%s)\n' "$WORKSPACE" "$workspace_source"
            printf '  Control plane:    %s\n' "$CONTROL"
            printf '  State:            %s\n' "$state"
            printf '  Log file:         %s\n' "$LOG_FILE"
            printf '\n'
            printf '  Config:\n'
            printf '    STRICT:         %s\n' "${SW_STRICT:-0}"
            printf '    Offline:        %s\n' "${SW_OFFLINE:-0}"
            printf '    Network:        %s\n' "${SW_NETWORK_MODE:-host}"
            printf '    Host integ:     %s\n' "${SW_HOST_INTEGRATIONS:-1}"
            printf '    Seccomp uncl:   %s\n' "${SW_SAFE_UNCONFINED:-1}"
            printf '    GPU:            %s\n' "${SW_GPU:-auto}"
            printf '\n'
            printf '  Podman:           %s\n' "$podman_version"
            printf '  Rootless:         %s\n' "$podman_rootless"
            printf '  Seed image:       %s\n' "$SEED_TAG"
            printf '  Seed (refreshed): %s\n' "$last_seed_tag"
            printf '  Rootfs image:     %s\n' "$rootfs_tag"
            printf '  Toolroot:         %s\n' "$current_rev"
            printf '  Last refresh:     %s\n' "$last_refresh"
            printf '  Masking:          %s\n' "$masking_status"
        printf '\n'
        printf '  Components:\n'
        printf '    Node.js:        %s\n' "$( [[ $node_ok -eq 1 ]] && echo "✓" || echo "✗" )"
        printf '    Rust:           %s\n' "$( [[ $rust_ok -eq 1 ]] && echo "✓" || echo "✗" )"
        printf '    Nix:            %s\n' "$( [[ $nix_ok -eq 1 ]] && echo "✓" || echo "○ (optional)" )"
        printf '    Codex:          %s\n' "$( [[ $codex_ok -eq 1 ]] && echo "✓" || echo "✗" )"
        printf '    Claude:         %s\n' "$( [[ $claude_ok -eq 1 ]] && echo "✓" || echo "✗" )"
        printf '    Gemini:         %s\n' "$( [[ $gemini_ok -eq 1 ]] && echo "✓" || echo "✗" )"
        printf '\n'
        printf '  Disk usage:       %s\n' "$disk_usage"
        printf '\n'
        
        if [[ ${#issues[@]} -gt 0 ]]; then
            printf '  ⚠ Issues:\n'
            for issue in "${issues[@]}"; do
                printf '    - %s\n' "$issue"
            done
            printf '\n'
        fi
        
        # Show last error if set
        if [[ -n "$last_error" ]]; then
            printf '  Last error:       %s\n' "$last_error"
            printf '\n'
        fi
        
        # Extended diagnostics mode
            if [[ $diag_mode -eq 1 ]]; then
                printf '  ─────────────────────────────────────────────────────────────\n'
                printf '  EXTENDED DIAGNOSTICS\n'
                printf '  ─────────────────────────────────────────────────────────────\n'
                printf '\n'
            printf '  Podman storage:\n'
            printf '    Driver:         %s\n' "$podman_storage_driver"
            printf '    GraphRoot:      %s\n' "$podman_graphroot"
            printf '\n'

                if [[ "$state" != "UNINITIALIZED" ]] && [[ "$current_rev" != "none" ]]; then
