}

cmd_help() {
    cat <<HELP
sandworm v$SW_VERSION - A disposable, self-healing, directory-local "OS" for LLM agents

USAGE:
    sandworm [COMMAND] [OPTIONS]

COMMANDS:
    (none), doctor      Run diagnostics (add --diag for extended info)
    refresh [OPTIONS]   Build/rebuild the environment
                        --force   Force rebuild even if toolroot exists
                        --debug   Enable debug output
                        --trace   Enable trace output (shows commands)
    codex [--unsafe] [args]    Run OpenAI Codex CLI
    claude [--unsafe] [args]   Run Anthropic Claude CLI
    gemini [--unsafe] [args]   Run Google Gemini CLI
    shell [--unsafe]           Interactive shell in agent environment
    run [--unsafe] -- <cmd>    Run arbitrary command in guest
    develop         Enter nix devshell (requires Nix)
    logs [--list]   View logs
    gc              Garbage collect old toolroots/logs
    nuke            Remove .sandworm/ completely
    version         Show version
    help            Show this help
    self-test       Run internal tests (for development)

CONTEXTS:
    SAFE (default): Sandboxed container. /workspace/.sandworm is masked.
                    Host mutation: NO. Runs as uid 0 inside rootless namespace
                    (maps to your host uid).

    --unsafe:       Rootful container with host root at /host (rw) and control
                    plane at /control (rw). /workspace/.sandworm masked.
                    Host mutation: YES. Requires sudo.

    --strict:       Tighten SAFE posture:
                    • No host integrations (X11/Wayland/audio/SSH agent)
                    • Seccomp confined (may break nix/junest/proot)
                    • No bwrap fallback
                    • Networking remains open for OAuth flows
                    • GPU passthrough disabled

    Inside SAFE/UNSAFE, sandworm writes:
      • \$HOME/SANDWORM_CAPS.json  Machine-readable capability summary
      • \$HOME/SANDWORM_ENV.md     Human/LLM quick reference

    Fallback: If Podman unavailable, sandworm uses bubblewrap (bwrap).
              bwrap uses host kernel + /usr (not an image); less isolated.

REFRESH BEHAVIOR:
    - First run: Downloads base image, installs Node.js, Rust, CLIs (~5-10 min)
    - After first run: Reuses existing toolroot (instant)
    - With --force: Rebuilds everything from scratch
    - If sandworm script changes: Warns but reuses existing toolroot

    The toolroot is independent of the sandworm script version. If you update
    sandworm, your existing toolroot continues to work. Use --force to rebuild
    if you need newer tool versions.

ENVIRONMENT VARIABLES:

  Workspace & State:
    SW_WORKSPACE_ROOT       Override workspace resolution (default: git root or PWD)
    SW_NO_GIT_EXCLUDE=1     Don't add .sandworm/ to .git/info/exclude
    SW_TOOLROOT_KEEP=N      Number of toolroots to keep (default: 2)
    SW_ASSUME_YES=1         Non-interactive: assume yes to prompts

  Networking:
    SW_OFFLINE=1            Disable networking in containers (--network none)
    SW_NETWORK_MODE=MODE    Container network mode (default: host)
                            Values: host, bridge, none, slirp4netns, pasta:...
    SW_NETWORK_FALLBACK=X   Retry mode if host networking fails (default: auto)
                            Values: auto, slirp4netns, pasta:--map-gw, default, 0

  Security & Isolation:
    SW_STRICT=1             Enable STRICT mode (see above)
    SW_AUTH_PORT_RANGE=X    STRICT: loopback TCP ports for OAuth callbacks
                            Format: "1455,43800-43850" (port or port-range, comma-sep)
    SW_SELINUX_MODE=MODE    SELinux handling (default: auto)
                            Values: auto, disable, enforce, z, Z
    SW_SAFE_UNCONFINED=0    Keep SAFE seccomp confined (default: 1 = unconfined)
                            When confined: proot/JuNest/nix-portable may break;
                            ip/ss/netstat blocked (AF_NETLINK denied by seccomp)
    SW_HOST_INTEGRATIONS=0  Disable desktop socket passthrough (default: 1)

  Build & Refresh:
    SW_NODE_MAJOR=N         Node.js major version (default: 22)
    SW_RUST_TOOLCHAIN=X     Rust toolchain (default: stable)
    SW_NIX_PORTABLE_VERSION Nix-portable version (default: latest)
    SW_CODEX_PACKAGE=X      Override codex npm package name(s) to try first
    SW_DISABLED_CLIS=X      Comma-separated CLIs to skip (e.g. "codex,gemini")
    SW_REFRESH_NETWORK=X    Network mode for seed build/hydration (default: host)
    SW_PERSIST_ROOTFS=0|1   Persist SAFE rootfs changes (apt installs) (default: 1)
    SW_PARALLEL_HYDRATE=0|1 Parallel tool installation (default: 1)
    SW_CACHE_TTL=N          Cache TTL in seconds for version indexes (default: 3600)

  Resource Limits:
    SW_CPU_LIMIT=N          Limit CPUs (e.g. 2, 1.5). Default: unlimited
    SW_MEM_LIMIT=N          Limit memory (e.g. 8g, 512m). Default: unlimited
    SW_PIDS_LIMIT=N         Limit processes. Default: unlimited

  GPU:
    SW_GPU=MODE             GPU passthrough (default: auto)
                            Values: auto, cdi, hook, direct, 0

  Debugging:
    SW_VERBOSE=0|1|2        Logging verbosity (default: 1)
    SW_DEBUG_LEVEL=0-3      Debug level: 0=off, 1=basic, 2=verbose, 3=trace
    SW_PODMAN_TIMEOUT=N     Podman operation timeout in seconds (default: 300)
    SW_PROFILE=1            Print per-step timing at INFO level

  Miscellaneous:
    SW_COLOR=auto|0|1       Color output (default: auto, respects NO_COLOR)
    SW_WRITE_ENV_MD=0       Skip writing \$HOME/SANDWORM_ENV.md in sandbox
    SW_TMPFS_TMP=1          Mount /tmp as tmpfs inside container
    SW_VOLUME_CHOWN=0       Disable :U volume option for bind mounts (default: 1)

TROUBLESHOOTING:

  Refresh hangs or times out:
    SW_NETWORK_MODE=none sandworm refresh --force   # Disable networking
    SW_PODMAN_TIMEOUT=60 sandworm refresh --force   # Fail faster
    SW_DEBUG_LEVEL=3 sandworm refresh --force       # Maximum verbosity

  Permission denied errors:
    sandworm nuke                      # Clean removal (handles UID mapping)
    podman unshare rm -rf .sandworm/   # Manual if nuke fails

  Storage/image errors:
    podman system reset                # Nuclear option: destroys all images

  GPU not detected:
    SW_GPU=hook sandworm shell         # Force OCI hook instead of CDI
    SW_GPU=direct sandworm shell       # Force direct /dev mounts only
    SW_GPU=0 sandworm shell            # Disable GPU entirely

HOOKS:

  Sandworm supports user-defined hook scripts that run at key lifecycle points.
  Hooks are executable bash scripts placed in .sandworm/hooks/ directory.

  Available hooks:
    before-refresh.sh      Run before toolroot build starts
    after-refresh.sh       Run after toolroot build completes (receives toolroot ID)
    before-codex.sh        Run before launching Codex CLI
    after-codex.sh         Run after Codex exits (receives exit code)
    before-claude.sh       Run before launching Claude Code CLI
    after-claude.sh        Run after Claude Code exits (receives exit code)
    before-gemini.sh       Run before launching Gemini CLI
    after-gemini.sh        Run after Gemini exits (receives exit code)
    before-shell.sh        Run before entering interactive shell
    after-shell.sh         Run after exiting shell (receives exit code)
    before-run.sh          Run before executing arbitrary command
    after-run.sh           Run after command completes (receives exit code)

  Environment variables passed to hooks:
    SANDWORM_HOOK          Hook name being executed
    SANDWORM_WORKSPACE     Current workspace path
    SANDWORM_CONTROL       Control plane path (.sandworm/)
    SANDWORM_MODE          Execution mode (safe/unsafe)
    SANDWORM_COMMAND       Command being executed (codex/claude/shell/run/etc)

  Example hook (.sandworm/hooks/before-codex.sh):
    #!/bin/bash
    echo "Starting Codex in mode: \$SANDWORM_MODE"
    # Start dev services
    docker-compose up -d redis postgres
    # Export additional environment variables
    export MY_API_KEY="..."

  Make hooks executable:
    chmod +x .sandworm/hooks/*.sh

  Hook failures (non-zero exit) are logged but don't stop execution.

FILES:
    .sandworm/                  Control plane directory (git-ignored)
    .sandworm/state.json        Persistent state
    .sandworm/logs/             Session logs
    .sandworm/toolroots/        Installed tool versions
    .sandworm/home/             Persistent \$HOME for sandbox
    .sandworm/cache/            Cached data (apt lists, etc.)
    .sandworm/hooks/            User-defined hook scripts (optional)
    \$HOME/SANDWORM_CAPS.json   (inside sandbox) Machine-readable capabilities
    \$HOME/SANDWORM_ENV.md      (inside sandbox) Human/LLM quick reference

For more information: https://h0p3.nekoweb.org/#sandworm
HELP
}

# =============================================================================
# Self-test command
# =============================================================================

cmd_self_test() {
    local tests_passed=0
    local tests_failed=0
    # Use a global-ish temp directory pattern that cleanup can reference
    local test_workspace="/tmp/sandworm-test-$$"
    export _SW_TEST_WORKSPACE="$test_workspace"
    
    _test_pass() {
        tests_passed=$((tests_passed + 1))
        printf '  \033[32m✓\033[0m %s\n' "$1"
    }
    
    _test_fail() {
        tests_failed=$((tests_failed + 1))
        printf '  \033[31m✗\033[0m %s: %s\n' "$1" "$2"
    }
    
    _test_section() {
        printf '\n\033[1m%s\033[0m\n' "$1"
    }
    
    _test_cleanup() {
        rm -rf "${_SW_TEST_WORKSPACE:-}" 2>/dev/null || true
        unset _SW_TEST_WORKSPACE
    }
    trap _test_cleanup EXIT
    
    printf '\n╔══════════════════════════════════════════════════════════════╗\n'
    printf '║                   sandworm self-test suite                   ║\n'
    printf '╚══════════════════════════════════════════════════════════════╝\n'
    
    # =========================================================================
    _test_section "Utility functions"
    # =========================================================================
    
    # Test compute_hash
    local test_file="$test_workspace/hashtest"
    mkdir -p "$test_workspace"
    printf 'test content\n' > "$test_file"
    local hash
    hash=$(compute_hash "$test_file")
    if [[ "$hash" =~ ^[a-f0-9]{64}$ ]]; then
        _test_pass "compute_hash produces valid SHA256"
    else
        _test_fail "compute_hash" "invalid hash format: $hash"
    fi
    
    # Test generate_rev_id
    local rev_id
    rev_id=$(generate_rev_id)
    if [[ "$rev_id" =~ ^[0-9]{8}-[0-9]{6}-[a-f0-9]{4}$ ]]; then
        _test_pass "generate_rev_id produces valid format"
    else
        _test_fail "generate_rev_id" "invalid format: $rev_id"
    fi
    
    # Test atomic_write
    local atomic_test="$test_workspace/atomic"
    atomic_write "$atomic_test" "test content"
    if [[ -f "$atomic_test" && "$(cat "$atomic_test")" == "test content" ]]; then
        _test_pass "atomic_write creates file correctly"
    else
        _test_fail "atomic_write" "file not created or wrong content"
    fi
    
    # Test is_cli_disabled
    SW_DISABLED_CLIS="codex,claude"
    if is_cli_disabled "codex"; then
        _test_pass "is_cli_disabled detects disabled CLI"
    else
        _test_fail "is_cli_disabled" "failed to detect disabled CLI"
    fi
    
    if ! is_cli_disabled "gemini"; then
        _test_pass "is_cli_disabled allows enabled CLI"
    else
        _test_fail "is_cli_disabled" "incorrectly disabled gemini"
    fi
    SW_DISABLED_CLIS=""
    
    # =========================================================================
    _test_section "State management"
    # =========================================================================
    
    # Test state.json parsing
    local state_file="$test_workspace/state.json"
    cat > "$state_file" <<'EOF'
{
  "SW_STATE_SCHEMA": 1,
  "SW_STATE": "HEALTHY",
  "SW_REV_CURRENT": "20241215-120000-a1b2",
  "SW_NODE_OK": "1",
  "SW_VALUE_WITH_SPACES": "hello world test"
}
EOF
    
    STATE=()
    parse_state_json "$state_file"
    
    if [[ "${STATE[SW_STATE_SCHEMA]:-}" == "1" ]]; then
        _test_pass "parse_state_json reads schema version"
    else
        _test_fail "parse_state_json" "failed to read SW_STATE_SCHEMA"
    fi
    
    if [[ "${STATE[SW_STATE]:-}" == "HEALTHY" ]]; then
        _test_pass "parse_state_json reads state"
    else
        _test_fail "parse_state_json" "failed to read SW_STATE"
    fi
    
    if [[ "${STATE[SW_VALUE_WITH_SPACES]:-}" == "hello world test" ]]; then
        _test_pass "parse_state_json handles spaces in values"
    else
        _test_fail "parse_state_json" "failed to handle spaces"
    fi
    
    # Test injection rejection
    cat > "$state_file" <<'EOF'
{"SW_BAD":"$(whoami)","SW_GOOD":"safe"}
EOF
    STATE=()
    parse_state_json "$state_file"
    
    if [[ -z "${STATE[SW_BAD]:-}" && "${STATE[SW_GOOD]:-}" == "safe" ]]; then
        _test_pass "parse_state_json rejects shell injection"
    else
        _test_fail "parse_state_json" "failed to reject injection"
    fi

    # Test path-steering rejection
    cat > "$state_file" <<'EOF'
{"SW_REV_CURRENT":"../../../../..","SW_GOOD":"safe"}
EOF
    STATE=()
    parse_state_json "$state_file"

    if [[ -z "${STATE[SW_REV_CURRENT]:-}" && "${STATE[SW_GOOD]:-}" == "safe" ]]; then
        _test_pass "parse_state_json rejects path traversal"
    else
        _test_fail "parse_state_json" "failed to reject path traversal"
    fi
    
    # Test write_state_json
    STATE=()
    STATE[SW_STATE]="HEALTHY"
    STATE[SW_REV_CURRENT]="test-rev"
    local write_test="$test_workspace/state_out.json"
    write_state_json "$write_test"
    
    if jq -e '.SW_STATE=="HEALTHY" and .SW_REV_CURRENT=="test-rev"' "$write_test" >/dev/null 2>&1; then
        _test_pass "write_state_json writes correctly"
    else
        _test_fail "write_state_json" "incorrect output"
    fi
    
    # Test get_state/set_state
    STATE=()
    set_state "TEST_KEY" "test_value"
    if [[ "$(get_state TEST_KEY)" == "test_value" ]]; then
        _test_pass "get_state/set_state work correctly"
    else
        _test_fail "get_state/set_state" "value mismatch"
    fi
    
    if [[ "$(get_state NONEXISTENT default)" == "default" ]]; then
        _test_pass "get_state returns default for missing key"
    else
        _test_fail "get_state" "failed to return default"
    fi
    
    # =========================================================================
    _test_section "Workspace resolution"
    # =========================================================================
    
    # Test git workspace resolution
    local git_workspace="$test_workspace/git-project"
    mkdir -p "$git_workspace/src/nested"
    (cd "$git_workspace" && git init --quiet)
    
    local saved_pwd="$PWD"
    cd "$git_workspace/src/nested"
    WORKSPACE=""
    SW_WORKSPACE_ROOT=""
    resolve_workspace
    
    if [[ "$WORKSPACE" == "$git_workspace" ]]; then
        _test_pass "resolve_workspace finds git root from nested dir"
    else
        _test_fail "resolve_workspace" "expected $git_workspace, got $WORKSPACE"
    fi
    cd "$saved_pwd"
    
    # Test SW_WORKSPACE_ROOT override
    SW_WORKSPACE_ROOT="$test_workspace"
    resolve_workspace
    if [[ "$WORKSPACE" == "$test_workspace" ]]; then
        _test_pass "SW_WORKSPACE_ROOT override works"
    else
        _test_fail "SW_WORKSPACE_ROOT" "override failed"
    fi
    SW_WORKSPACE_ROOT=""
    
    # Test non-git fallback
    local nongit="$test_workspace/nongit"
    mkdir -p "$nongit"
    cd "$nongit"
    WORKSPACE=""
    resolve_workspace
    if [[ "$WORKSPACE" == "$nongit" ]]; then
        _test_pass "resolve_workspace falls back to PWD for non-git"
    else
        _test_fail "resolve_workspace" "fallback failed"
    fi
    cd "$saved_pwd"
    
    # =========================================================================
    _test_section "Git exclude handling"
    # =========================================================================
    
    local git_test="$test_workspace/git-exclude-test"
    mkdir -p "$git_test"
    cd "$git_test"
    git init --quiet
    
    # Clear any existing .sandworm/ entry
    : > .git/info/exclude
    
    WORKSPACE="$git_test"
    SW_NO_GIT_EXCLUDE=0
    setup_git_exclude
    
    if grep -qxF '.sandworm/' .git/info/exclude; then
        _test_pass "setup_git_exclude adds .sandworm/"
    else
        _test_fail "setup_git_exclude" "entry not added"
    fi
    
    # Test idempotence
    setup_git_exclude
    local count
    count=$(grep -cxF '.sandworm/' .git/info/exclude)
    if [[ "$count" -eq 1 ]]; then
        _test_pass "setup_git_exclude is idempotent"
    else
        _test_fail "setup_git_exclude" "duplicate entries: $count"
    fi
    
    cd "$saved_pwd"
    
    # =========================================================================
    _test_section "Locking"
    # =========================================================================
    
    local lock_file="$test_workspace/test.lock"
    
    # Test basic acquire/release
    if acquire_lock "$lock_file" 0; then
        _test_pass "acquire_lock succeeds initially"
        release_lock
    else
        _test_fail "acquire_lock" "failed to acquire initial lock"
    fi
    
    # Test lock contention (via subshell)
    if acquire_lock "$lock_file" 0; then
        # Try to acquire same lock in subshell
        if ! (acquire_lock "$lock_file" 0 2>/dev/null); then
            _test_pass "acquire_lock blocks concurrent access"
        else
            _test_fail "acquire_lock" "allowed concurrent lock"
        fi
        release_lock
    fi
    
    # =========================================================================
    _test_section "Control plane initialization"
    # =========================================================================
    
    local cp_test="$test_workspace/cp-test"
    mkdir -p "$cp_test"
    cd "$cp_test"
    git init --quiet
    
    WORKSPACE="$cp_test"
    # SCRIPT_PATH is already set globally
    init_control_plane
    
    local expected_dirs=(
        "$CONTROL/logs"
        "$CONTROL/locks"
        "$CONTROL/home"
        "$CONTROL/toolroots"
        "$CONTROL/podman/storage"
        "$CONTROL/hooks-empty"
    )
    
    local all_dirs_ok=1
    for dir in "${expected_dirs[@]}"; do
        if [[ ! -d "$dir" ]]; then
            all_dirs_ok=0
            break
        fi
    done
    
    if [[ $all_dirs_ok -eq 1 ]]; then
        _test_pass "init_control_plane creates directory structure"
    else
        _test_fail "init_control_plane" "missing directories"
    fi
    
    if [[ -n "$LOG_FILE" && -f "$LOG_FILE" ]]; then
        _test_pass "init_control_plane creates log file"
    else
        _test_fail "init_control_plane" "log file not created"
    fi
    
    if [[ -n "$SCRIPT_HASH" && "$SCRIPT_HASH" =~ ^[a-f0-9]{64}$ ]]; then
        _test_pass "init_control_plane computes script hash"
    else
        _test_fail "init_control_plane" "invalid script hash"
    fi
    
    cd "$saved_pwd"
    
    # =========================================================================
    _test_section "Hydration script generation"
    # =========================================================================
    
    local hydration_output
    hydration_output=$(generate_hydration_script)

    # Must be syntactically valid bash
    local hydrate_test_file="$test_workspace/hydrate-test.sh"
    printf '%s\n' "$hydration_output" > "$hydrate_test_file"
    local _hn_err
    local _hn_ok=1
    # Use 'bash' instead of '/bin/bash' for NixOS compatibility (test runs on host)
    if ! _hn_err=$(bash -n "$hydrate_test_file" 2>&1); then
        _hn_ok=0
        _test_fail "generate_hydration_script" "bash -n failed: ${_hn_err}"
    fi
    if [[ $_hn_ok -eq 1 ]]; then
        _test_pass "generate_hydration_script passes bash -n"
    fi
    
    if [[ "$hydration_output" == *'#!/bin/bash'* ]]; then
        _test_pass "generate_hydration_script produces bash script"
    else
        _test_fail "generate_hydration_script" "not a bash script"
    fi
    
    if [[ "$hydration_output" == *'install_node'* ]]; then
        _test_pass "generate_hydration_script includes node installation"
    else
        _test_fail "generate_hydration_script" "missing node installation"
    fi
    
    if [[ "$hydration_output" == *'install_rust'* ]]; then
        _test_pass "generate_hydration_script includes rust installation"
    else
        _test_fail "generate_hydration_script" "missing rust installation"
    fi
    
    # Check for proper quoting (no accidental host interpolation)
    # The script should contain ${SW_NODE_MAJOR:-22} as a literal string
    if [[ "$hydration_output" == *'${SW_NODE_MAJOR:-'* ]]; then
        _test_pass "generate_hydration_script uses quoted heredoc"
    else
        _test_fail "generate_hydration_script" "may have interpolation issues"
    fi
    
    # =========================================================================
    _test_section "Distro detection"
    # =========================================================================

    local distro
    distro=$(detect_distro)
    if [[ -n "$distro" && "$distro" != "unknown" ]]; then
        _test_pass "detect_distro returns: $distro"
    else
        _test_pass "detect_distro returns unknown (expected in container)"
    fi

    # =========================================================================
    _test_section "Runtime integration tests"
    # =========================================================================

    # Check runtime availability
    local has_podman=0
    local has_bwrap=0
    if command -v podman >/dev/null 2>&1 && podman info >/dev/null 2>&1; then
        has_podman=1
        _test_pass "Podman available and working"
    else
        printf '  ○ Podman not available (skipping podman-specific tests)\n'
    fi

    if command -v bwrap >/dev/null 2>&1; then
        has_bwrap=1
        _test_pass "Bubblewrap (bwrap) available"
    else
        printf '  ○ Bubblewrap not available (skipping bwrap-specific tests)\n'
    fi

    # Test SELinux mode parsing
    local selinux_modes=("auto" "disable" "enforce" "z" "Z")
    local selinux_ok=1
    for mode in "${selinux_modes[@]}"; do
        case "$mode" in
            disable|enforce|z|Z|auto) : ;;
            *) selinux_ok=0 ;;
        esac
    done
    if [[ $selinux_ok -eq 1 ]]; then
        _test_pass "SELinux mode parsing accepts valid modes"
    else
        _test_fail "SELinux mode" "parsing failed"
    fi

    # Test auth port range parsing (STRICT mode)
    local valid_specs=("1455" "1455,43800-43850" "8080-8090" "80,443,8080")
    local port_parse_ok=1
    for spec in "${valid_specs[@]}"; do
        IFS=',' read -r -a _tokens <<<"$spec"
        for token in "${_tokens[@]}"; do
            token="${token#"${token%%[![:space:]]*}"}"
            if [[ "$token" =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]]; then
                :
            elif [[ "$token" =~ ^([0-9]{1,5})$ ]]; then
                :
            else
                port_parse_ok=0
            fi
        done
    done
    if [[ $port_parse_ok -eq 1 ]]; then
        _test_pass "Auth port range parsing works for valid specs"
    else
        _test_fail "Auth port range" "parsing failed"
    fi

    # Test network fallback candidate computation
    local test_fallback_candidates=()
    local test_fallback="auto"
    case "$test_fallback" in
        ""|auto) test_fallback_candidates=("slirp4netns" "pasta:--map-gw" "default") ;;
    esac
    if [[ ${#test_fallback_candidates[@]} -eq 3 ]]; then
        _test_pass "Network fallback candidates computed correctly"
    else
        _test_fail "Network fallback" "wrong candidate count: ${#test_fallback_candidates[@]}"
    fi

    # Test GPU detection logic (unit test, no actual GPU required)
    local gpu_mode="auto"
    local nvidia_present=0
    [[ -e /dev/nvidia0 ]] && nvidia_present=1
    if [[ $nvidia_present -eq 0 ]]; then
        _test_pass "GPU detection: no NVIDIA device (expected in most test envs)"
    else
        _test_pass "GPU detection: NVIDIA device present"
    fi

    # Test progress bar functions
    progress_init 10 "Test progress"
    progress_tick "Step 1"
    progress_set 5 "Halfway"
    progress_done
    _test_pass "Progress bar functions execute without error"

    # Test cached_fetch simulation (within hydration script context)
    local hydration_script
    hydration_script=$(generate_hydration_script)
    if [[ "$hydration_script" == *"cached_fetch"* ]]; then
        _test_pass "Hydration script includes caching functions"
    else
        _test_fail "Hydration caching" "cached_fetch function missing"
    fi

    if [[ "$hydration_script" == *"run_bg"* ]]; then
        _test_pass "Hydration script includes parallel execution helpers"
    else
        _test_fail "Hydration parallel" "run_bg function missing"
    fi

    # =========================================================================
    # Summary
    # =========================================================================
    
    printf '\n'
    printf '══════════════════════════════════════════════════════════════════\n'
    printf '  Tests passed: \033[32m%d\033[0m\n' "$tests_passed"
    printf '  Tests failed: \033[31m%d\033[0m\n' "$tests_failed"
    printf '══════════════════════════════════════════════════════════════════\n'
    
    if [[ $tests_failed -gt 0 ]]; then
        return 1
    fi
    return 0
}

# =============================================================================
# Main entry point
# =============================================================================

main() {
    # Determine script path and hash
    SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"

    # Detect if we're already inside a sandworm container (prevent nesting)
    if [[ -n "${SANDWORM_CONTEXT:-}" ]]; then
        cat >&2 <<NESTED

╔══════════════════════════════════════════════════════════════════╗
║  ⚠ Already inside sandworm environment                           ║
╚══════════════════════════════════════════════════════════════════╝

You're currently running inside a sandworm container (mode: ${SANDWORM_CONTEXT:-unknown}).
Nesting sandworm containers is not supported and will likely fail.

If you want to run commands in this environment, just execute them directly:
  \$ whoami
  \$ python script.py
  \$ npm install

If you need a different sandworm mode, exit this container first.

NESTED
        exit 14
    fi

    # Global options (must appear before COMMAND)
    while [[ "${1:-}" == "--strict" ]]; do
        SW_STRICT=1
        shift || true
    done

    # Parse command
    local COMMAND="${1:-doctor}"
    shift 2>/dev/null || true

    # Apply STRICT defaults early.
    if [[ "${SW_STRICT:-0}" == "1" ]]; then
        SW_HOST_INTEGRATIONS=0
        SW_SAFE_UNCONFINED=0
        SW_GPU=0
        if [[ "${SW_OFFLINE:-0}" != "1" ]]; then
            # STRICT is network-open for auth flows (browser login + localhost callbacks).
            # Use host networking to make localhost OAuth callbacks work reliably.
            SW_NETWORK_MODE=host
        fi
        if [[ -z "${SW_AUTH_PORT_RANGE:-}" ]]; then
            # Codex currently uses localhost:1455 for OAuth callback; also leave a small
            # high-port range for tools that pick ephemeral ports.
            SW_AUTH_PORT_RANGE="1455,43800-43850"
        fi
    fi

    # Allow disabling individual CLIs via SW_DISABLED_CLIS.

    # Help/version should not require a writable workspace or control plane.
    case "$COMMAND" in
        help|--help|-h)
            init_ephemeral_log
            log_info "Log: $LOG_FILE"
            cmd_help
            return 0
            ;;
        version|--version|-v)
            init_ephemeral_log
            log_info "Log: $LOG_FILE"
            cmd_version
            return 0
            ;;
    esac

    # Resolve workspace first
    resolve_workspace
    
    # Initialize control plane (creates dirs, loads state)
    init_control_plane
    
    # Setup git exclude
    setup_git_exclude
    
    # Dispatch command
    case "$COMMAND" in
        doctor)     cmd_doctor "$@" ;;
        refresh)    cmd_refresh "$@" ;;
        codex)      cmd_codex "$@" ;;
        claude)     cmd_claude "$@" ;;
        gemini)     cmd_gemini "$@" ;;
        shell)      cmd_shell "$@" ;;
        run)        cmd_run "$@" ;;
        develop)    cmd_develop "$@" ;;
        logs)       cmd_logs "$@" ;;
        gc)         cmd_gc "$@" ;;
        nuke)       cmd_nuke "$@" ;;
        self-test)  cmd_self_test "$@" ;;
        version|--version|-v)
                    cmd_version ;;
        help|--help|-h)
                    cmd_help ;;
        *)
            log_error "Unknown command: $COMMAND"
            cmd_help
            exit 2
            ;;
    esac
}

# Run main if not sourced
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
