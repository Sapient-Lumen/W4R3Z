#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
VER="${VERSION:-dev}"
OUT_DIR="$ROOT/artifacts/release/$VER"
OUT_FILE="$OUT_DIR/sbom.json"
mkdir -p "$OUT_DIR"

python3 - <<'PY' "$ROOT" "$OUT_FILE"
import json
import subprocess
import sys
from pathlib import Path

root = Path(sys.argv[1])
out_file = Path(sys.argv[2])

packages = []

def run(cmd):
    try:
        proc = subprocess.run(
            cmd,
            cwd=root,
            check=True,
            capture_output=True,
            text=True,
        )
        return proc.stdout
    except Exception:
        return None

cargo_data = run(["./tools/rust_exec.sh", "cargo", "metadata", "--format-version", "1", "--no-deps"])
if cargo_data:
    try:
        obj = json.loads(cargo_data)
        for p in obj.get("packages", []):
            packages.append(
                {
                    "ecosystem": "cargo",
                    "name": p.get("name"),
                    "version": p.get("version"),
                    "id": p.get("id"),
                }
            )
    except json.JSONDecodeError:
        pass

pip_data = run(["python3", "-m", "pip", "list", "--format", "json"])
if pip_data:
    try:
        obj = json.loads(pip_data)
        for p in obj:
            packages.append(
                {
                    "ecosystem": "pip",
                    "name": p.get("name"),
                    "version": p.get("version"),
                }
            )
    except json.JSONDecodeError:
        pass

sbom = {
    "format": "concord-sbom-v1",
    "generated_at": subprocess.check_output(["date", "-u", "+%Y-%m-%dT%H:%M:%SZ"], text=True).strip(),
    "environment": {
        "os": subprocess.check_output(["uname", "-s"], text=True).strip(),
        "arch": subprocess.check_output(["uname", "-m"], text=True).strip(),
    },
    "package_count": len(packages),
    "packages": packages,
}

out_file.write_text(json.dumps(sbom, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY

echo "sbom_generate: wrote $OUT_FILE"
