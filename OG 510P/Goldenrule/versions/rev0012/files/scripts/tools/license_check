#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
OUT_DIR="$ROOT/artifacts/security"
OUT_FILE="$OUT_DIR/licenses.json"
STRICT="${STRICT:-0}"
mkdir -p "$OUT_DIR"

timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
os="$(uname -s)"
arch="$(uname -m)"

if command -v cargo-deny >/dev/null 2>&1; then
  status="ok"
  if ! cargo-deny check licenses >/dev/null 2>&1; then
    status="error"
  fi
  python3 - <<'PY' "$OUT_FILE" "$timestamp" "$status" "$os" "$arch" "$STRICT"
import json,sys
path,timestamp,status,os_name,arch,strict=sys.argv[1:]
obj={
  "timestamp": timestamp,
  "strict": strict == "1",
  "environment": {"os": os_name, "arch": arch},
  "tool": "cargo-deny",
  "status": status,
}
with open(path,"w",encoding="utf-8") as f:
  json.dump(obj,f,indent=2,sort_keys=True)
  f.write("\n")
PY
  if [[ "$status" != "ok" ]]; then
    echo "license_check: cargo-deny failed"
    [[ "$STRICT" == "1" ]] && exit 1
  fi
else
  python3 - <<'PY' "$OUT_FILE" "$timestamp" "$os" "$arch" "$STRICT"
import json,sys
path,timestamp,os_name,arch,strict=sys.argv[1:]
obj={
  "timestamp": timestamp,
  "strict": strict == "1",
  "environment": {"os": os_name, "arch": arch},
  "tool": None,
  "status": "skipped",
  "reason": "cargo-deny not installed",
}
with open(path,"w",encoding="utf-8") as f:
  json.dump(obj,f,indent=2,sort_keys=True)
  f.write("\n")
PY
  echo "license_check: skipped (cargo-deny missing)"
  if [[ "$STRICT" == "1" ]]; then
    echo "license_check: strict mode requires cargo-deny"
    exit 1
  fi
fi

echo "license_check: wrote $OUT_FILE"
