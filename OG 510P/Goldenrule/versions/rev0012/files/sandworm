_sw_root_from_argv() {
  local -a argv=("$@")
  local i=0
  while [[ "$i" -lt "${#argv[@]}" ]]; do
    local a="${argv[$i]}"
    if [[ "$a" == "--root" ]]; then
      local v="${argv[$((i + 1))]:-}"
      if [[ -z "$v" ]]; then
        _sw_err "--root requires a path"
        exit 2
      fi
      printf '%s' "$v"
      return 0
    fi
    if [[ "$a" == "--root="* ]]; then
      printf '%s' "${a#--root=}"
      return 0
    fi
    if [[ "$a" == "--" ]]; then
      break
    fi
    i=$((i + 1))
  done
  return 0
}

_sw_abs_path() {
  local p="$1"
  local cwd
  if [[ "$p" != /* ]]; then
    cwd="$(pwd -P)"
    case "$cwd" in
      //*) cwd="/${cwd##//}" ;;
    esac
    if [[ "$cwd" == "/" ]]; then
      p="/$p"
    else
      p="$cwd/$p"
    fi
  fi
  if ! p="$(cd "$p" 2>/dev/null && pwd -P)"; then
    _sw_err "invalid --root path: $1"
    return 1
  fi
  case "$p" in
    //*) p="/${p##//}" ;;
  esac
  printf '%s' "$p"
}

_sw_can_write_dir() {
  local d="${1:-}"
  [[ -n "$d" && "$d" == /* ]] || return 1
  local probe=""
  if probe="$(mktemp "$d/.sw-write-test.XXXXXX" 2>/dev/null)"; then
    rm -f "$probe" >/dev/null 2>&1 || true
    return 0
  fi
  return 1
}

# SAFE defaults: avoid writing to a shared inherited HOME by default.
# Preserve /run/sandworm/home only when nested runtime is active AND the selected root
# control plane is not writable. Otherwise prefer per-root HOME isolation.
if [[ "${SW_USE_HOST_HOME:-0}" != "1" && "${SANDWORM_USE_HOST_HOME:-0}" != "1" ]]; then
  _sw_root_for_home="$(_sw_root_from_argv "$@")"
  if [[ -z "${_sw_root_for_home:-}" ]]; then
    _sw_root_for_home="."
  fi
  _sw_root_for_home="$(_sw_abs_path "$_sw_root_for_home" 2>/dev/null || true)"
  if [[ -z "${_sw_root_for_home:-}" ]]; then
    _sw_root_for_home="$(pwd -P)"
  fi

  need_sw_home=1
  in_nested_runtime=0
  if [[ -n "${SANDWORM_BACKEND:-}" ]]; then
    in_nested_runtime=1
  fi
  if [[ "$in_nested_runtime" == "1" && ( "${SANDWORM_HOME:-}" == "/run/sandworm/home" || "${HOME:-}" == "/run/sandworm/home" ) ]]; then
    if _sw_can_write_dir "/run/sandworm/home" && ! _sw_can_write_dir "$_sw_root_for_home"; then
      need_sw_home=0
    fi
  fi

  if [[ "$need_sw_home" == "1" ]]; then
    if [[ "$_sw_root_for_home" == "/" ]]; then
      sw_home="/.sandworm/home"
    else
      sw_home="$_sw_root_for_home/.sandworm/home"
    fi
    if ! mkdir -p "$sw_home/.cache" "$sw_home/.config" "$sw_home/.local/share" "$sw_home/.local/state" "$sw_home/tmp" 2>/dev/null; then
      sw_uid="${UID:-$(id -u 2>/dev/null || printf '0')}"
      sw_tmp_base="${TMPDIR:-/tmp}"
      sw_home="$sw_tmp_base/sandworm-home-$sw_uid"
      mkdir -p "$sw_home/.cache" "$sw_home/.config" "$sw_home/.local/share" "$sw_home/.local/state" "$sw_home/tmp" 2>/dev/null || true
    fi
    if _sw_can_write_dir "$sw_home"; then
      export SANDWORM_HOME="$sw_home"
      export HOME="$sw_home"
      export XDG_CACHE_HOME="$sw_home/.cache"
      export XDG_CONFIG_HOME="$sw_home/.config"
      export XDG_DATA_HOME="$sw_home/.local/share"
      export XDG_STATE_HOME="$sw_home/.local/state"
      if [[ -z "${TMPDIR:-}" ]]; then
        export TMPDIR="$sw_home/tmp"
      fi
    fi
  fi
fi

_sw_mkdir() {
  # Prefer coreutils mkdir when available. Some busybox-static builds can report
  # success on bind-mounted paths without actually creating directories.
  if [[ -x /usr/bin/mkdir ]]; then
    /usr/bin/mkdir "$@"
    return $?
  fi
  if [[ -x /bin/mkdir ]]; then
    /bin/mkdir "$@"
    return $?
  fi
  command mkdir "$@"
}

_sw_cache_dir() {
  if [[ -n "${SANDWORM_SINGLEFILE_CACHE_DIR:-}" ]]; then
    echo "${SANDWORM_SINGLEFILE_CACHE_DIR}"
    return 0
  fi
  # Prefer a cache under SANDWORM_HOME when available. This keeps the embedded core accessible
  # in SAFE sandboxes where /workspace/.sandworm is intentionally masked.
  if [[ -n "${SANDWORM_HOME:-}" && "${SANDWORM_HOME:-}" == /* ]]; then
    local use_sw_home_cache=1
    # /run/sandworm/home can be a bind mount with quirky mkdir semantics in some runtimes.
    # Prefer /tmp for singlefile extraction there unless explicitly opted in.
    if [[ "${SANDWORM_HOME}" == "/run/sandworm/home" ]]; then
      local allow_run_home
      allow_run_home="${SW_SINGLEFILE_CACHE_ALLOW_RUN_HOME:-${SANDWORM_SINGLEFILE_CACHE_ALLOW_RUN_HOME:-0}}"
      case "${allow_run_home,,}" in
        1|true|yes|on|y) use_sw_home_cache=1 ;;
        *) use_sw_home_cache=0 ;;
      esac
    fi
    if [[ "$use_sw_home_cache" == "1" ]]; then
      local d="${SANDWORM_HOME}/singlefile-cache"
      if _sw_mkdir -p "$d" >/dev/null 2>&1 && [[ -d "$d" && -w "$d" ]]; then
        # Some container runtimes can present a path that *looks* writable (mode bits) but refuses
        # create/unlink operations. Probe by creating a tiny file.
        local probe="$d/.sw-write-test.$$"
        if ( : >"$probe" ) 2>/dev/null; then
          rm -f "$probe" >/dev/null 2>&1 || true
          echo "$d"
          return 0
        fi
      fi
    fi
  fi
  local root="$(_sw_root_from_argv "$@")"
  if [[ -z "$root" ]]; then
    root="."
  fi
  if ! root="$(_sw_abs_path "$root")"; then
    exit 2
  fi
  if _sw_mkdir -p "$root/.sandworm" >/dev/null 2>&1 && [[ -d "$root/.sandworm" && -w "$root/.sandworm" ]]; then
    local d2="$root/.sandworm/singlefile-cache"
    if _sw_mkdir -p "$d2" >/dev/null 2>&1 && [[ -d "$d2" && -w "$d2" ]]; then
      local probe="$d2/.sw-write-test.$$"
      if ( : >"$probe" ) 2>/dev/null; then
        rm -f "$probe" >/dev/null 2>&1 || true
        echo "$d2"
        return 0
      fi
    fi
  fi
  # Fallback for read-only /masked .sandworm (e.g. inside a sandbox)
  local tmp_base="${TMPDIR:-/tmp}"
  if [[ "$tmp_base" == "/run/sandworm/home/"* || "$tmp_base" == "/run/sandworm/home" ]]; then
    tmp_base="/tmp"
  fi
  local cache_user="${USER:-${LOGNAME:-}}"
  if [[ -z "${cache_user:-}" ]]; then
    cache_user="$(id -u 2>/dev/null || printf 'unknown')"
  fi
  echo "$tmp_base/sandworm-cache-$cache_user"
}

_sw_b64_decode() {
  if base64 -d >/dev/null 2>&1 </dev/null; then
    base64 -d
    return 0
  fi
  base64 --decode
}

_sw_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}' | tr -d '\r\n'
    return 0
  fi
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}' | tr -d '\r\n'
    return 0
  fi
  return 1
}

_sw_proc_starttime() {
  local pid="$1"
  # Linux-only best-effort: detect PID reuse by comparing /proc starttime.
  # If /proc is unavailable (non-Linux), we fall back to kill -0 only.
  if [[ -r "/proc/$pid/stat" ]]; then
    # /proc/<pid>/stat: "pid (comm) state ... starttime ..."
    # Strip the leading "pid (comm) " (including any spaces inside comm) so starttime becomes field 20.
    awk '{ sub(/^.*\) /, ""); print $20; exit }' "/proc/$pid/stat" 2>/dev/null || true
  fi
}

_sw_proc_pidns() {
  local pid="$1"
  if [[ -L "/proc/$pid/ns/pid" ]]; then
    readlink "/proc/$pid/ns/pid" 2>/dev/null || true
  fi
}

_sw_write_singlefile_lock_pid() {
  local lockdir="$1"
  local st pns
  st="$(_sw_proc_starttime "$$")"
  pns="$(_sw_proc_pidns "$$")"
  if ! printf '%s %s %s\n' "$$" "$st" "$pns" > "$lockdir/pid" 2>/dev/null; then
    # If the lockdir vanished between mkdir() and write (cross-namespace stale reclaim race),
    # recreate once and continue best-effort without crashing extraction.
    _sw_mkdir -p "$lockdir" >/dev/null 2>&1 || true
    printf '%s %s %s\n' "$$" "$st" "$pns" > "$lockdir/pid" 2>/dev/null || true
  fi
}

_sw_singlefile_lock_wait_seconds() {
  local v="${SANDWORM_SINGLEFILE_LOCK_WAIT_SECONDS:-${SW_SINGLEFILE_LOCK_WAIT_SECONDS:-60}}"
  if [[ -n "${v:-}" && "${v:-}" =~ ^[0-9]+$ ]] && [[ "$v" -gt 0 ]]; then
    printf '%s' "$v"
    return 0
  fi
  printf '60'
}

_sw_extract_payload() {
  local dst="$1"
  if ! _sw_mkdir -p "$dst" >/dev/null 2>&1 || [[ ! -d "$dst" ]]; then
    _sw_err "failed to create extraction directory: $dst"
    return 2
  fi
  local t0="$SECONDS"
  if _sw_progress_enabled; then
    _sw_note "extracting embedded core bundle to $dst (format=${PAYLOAD_FORMAT:-} files=${PAYLOAD_FILE_COUNT:-?} bytes=${PAYLOAD_BYTES:-?})"
  fi
  if [[ "${PAYLOAD_FORMAT:-b64tar}" == "files" ]]; then
    _sw_write_payload_files "$dst"
    if ! _sw_verify_payload_files "$dst"; then
      rm -rf "$dst" >/dev/null 2>&1 || true
      return 2
    fi
    echo "ok" > "$dst/.extracted"
    if _sw_progress_enabled; then
      _sw_note "extract complete (elapsed $((SECONDS - t0))s)"
    fi
    return 0
  fi
  local tarball="$dst/payload.$PAYLOAD_EXT"
  awk -v m="__SW_PAYLOAD_B64_BELOW__" 'found{print} $0==m{found=1; next}' "$0" | _sw_b64_decode > "$tarball"
  if [[ -n "${PAYLOAD_SHA256:-}" ]]; then
    if got="$(_sw_sha256 "$tarball" 2>/dev/null || true)" && [[ -n "$got" && "$got" != "$PAYLOAD_SHA256" ]]; then
      _sw_err "singlefile payload sha256 mismatch (got=$got expected=$PAYLOAD_SHA256)"
      rm -f "$tarball" >/dev/null 2>&1 || true
      return 2
    fi
  fi
  tar -C "$dst" -xf "$tarball" >/dev/null
  rm -f "$tarball" >/dev/null 2>&1 || true
  echo "ok" > "$dst/.extracted"
  if _sw_progress_enabled; then
    _sw_note "extract complete (elapsed $((SECONDS - t0))s)"
  fi
}

_sw_write_payload_files() {
  local dst="$1"
  _sw_mkdir -p "$dst" >/dev/null 2>&1 || true
  local total=62
  if _sw_progress_enabled; then _sw_note "extract: 1/$total sandworm (112 KiB)"; fi
  # sandworm
  cat > "$dst/sandworm" <<'__SW_FILE_000_2a08bbfd2b__'
#!/bin/sh
# Sandworm scripts are bash, but some sandboxes break /usr/bin/env.
# This prelude re-execs the script under a real bash and ensures `bash` is in PATH.
# Do not trust BASH_VERSION env alone; it can be spoofed under /bin/sh.
_sw_is_real_bash_bin() {
  [ -n "${1:-}" ] || return 1
  [ -x "$1" ] || return 1
  "$1" -lc 'test -n "${BASH:-}" && test -n "${BASH_VERSION:-}" && type shopt >/dev/null 2>&1 && a=(ok) && [[ "${a[0]}" == "ok" ]]' >/dev/null 2>&1
}
if [ -z "${BASH-}" ] || [ -z "${BASH_VERSION-}" ] || ! (eval 'type shopt >/dev/null 2>&1; __sw_probe=(ok); [[ "${__sw_probe[0]}" == "ok" ]]' >/dev/null 2>&1); then
  if [ -n "${SANDWORM_BASH-}" ] && _sw_is_real_bash_bin "${SANDWORM_BASH}"; then
    _sw_bash="${SANDWORM_BASH}"
    _sw_bash_dir="${_sw_bash%/*}"
    PATH="$_sw_bash_dir${PATH:+:$PATH}"; export PATH
    exec "$_sw_bash" "$0" "$@"
  fi
  _sw_path_bash="$(command -v bash 2>/dev/null || true)"
  if [ -n "${_sw_path_bash:-}" ] && _sw_is_real_bash_bin "${_sw_path_bash}"; then
    case "$_sw_path_bash" in
      /run/sandworm/clients/bin/bash|*/.sandworm/clients/bin/bash)
        ;;
      *)
        exec "$_sw_path_bash" "$0" "$@"
        ;;
    esac
  fi
  for _sw_bash in /run/current-system/sw/bin/bash /usr/bin/bash /bin/bash /usr/local/bin/bash; do
    if _sw_is_real_bash_bin "$_sw_bash"; then
      _sw_bash_dir="${_sw_bash%/*}"
      PATH="$_sw_bash_dir${PATH:+:$PATH}"; export PATH
      exec "$_sw_bash" "$0" "$@"
    fi
  done
  for _sw_bash in /nix/store/*bash*/bin/bash; do
    if _sw_is_real_bash_bin "$_sw_bash"; then
      _sw_bash_dir="${_sw_bash%/*}"
      PATH="$_sw_bash_dir${PATH:+:$PATH}"; export PATH
      exec "$_sw_bash" "$0" "$@"
    fi
  done
  echo "ERROR: bash not found (set SANDWORM_BASH=/path/to/bash)" >&2
  exit 127
fi
set -euo pipefail


if [[ -z "${BASH_VERSION:-}" ]]; then
  _sw_path_bash="$(command -v bash 2>/dev/null || true)"
  if [[ -n "${_sw_path_bash:-}" ]]; then
    case "$_sw_path_bash" in
      # /run/sandworm/clients/bin/bash is a compatibility shim that can
      # recurse when used as a re-exec target for full sandworm wrappers.
      /run/sandworm/clients/bin/bash|*/.sandworm/clients/bin/bash)
        ;;
      *)
        exec "$_sw_path_bash" "$0" "$@"
        ;;
    esac
  fi
  echo "ERROR: sandworm requires bash" >&2
  exit 2
fi

start_dir="$(pwd -P)"

_sw_resolve_self_path() {
  local p="${BASH_SOURCE[0]:-$0}"
  local cd_pwd
  if [[ -z "$p" ]]; then
    return 1
  fi
  if [[ "$p" != *"/"* ]]; then
    p="$(command -v "$p" 2>/dev/null || true)"
  fi
  if [[ -z "$p" ]]; then
    return 1
  fi
  if [[ "$p" != /* ]]; then
    if [[ "$start_dir" == "/" ]]; then
      p="/$p"
    else
      p="$start_dir/$p"
    fi
  fi
  local d="${p%/*}"
  local b="${p##*/}"
  if [[ -z "$d" || "$d" == "$p" ]]; then
    d="."
  fi
  if cd -P -- "$d" 2>/dev/null; then
    cd_pwd="$(pwd -P)"
    if [[ "$cd_pwd" == "/" ]]; then
      printf '/%s' "$b"
    else
      printf '%s/%s' "$cd_pwd" "$b"
    fi
    return 0
  fi
  printf '%s' "$p"
  return 0
}

# Used by `sandworm build singlefile` so a singlefile run can embed the correct inner wrapper.
export SANDWORM_WRAPPER_PATH="$(_sw_resolve_self_path 2>/dev/null || true)"

_sw_first_cmd() {
  # Return the first non-global-option token so wrapper heuristics work with `--root <path> <cmd> ...`.
  # Keep this in sync with top-level global flags.
  local -a argv=("$@")
  local i=0
  while [[ "$i" -lt "${#argv[@]}" ]]; do
    local a="${argv[$i]}"
    if [[ "$a" == "-h" || "$a" == "--help" || "$a" == "--version" || "$a" == "--yes" ]]; then
      i=$((i + 1))
      continue
    fi
    if [[ "$a" == "--root" ]]; then
      i=$((i + 2))
      continue
    fi
    if [[ "$a" == "--root="* ]]; then
      i=$((i + 1))
      continue
    fi
    if [[ "$a" == "--" ]]; then
      i=$((i + 1))
      continue
    fi
    printf '%s' "$a"
    return 0
  done
  return 0
}

_sw_help_requested() {
  # Help should be available without bootstrapping optional Python deps (PyYAML/tomlkit).
  # Only scan before `--` so `sandworm run -- <cmd> --help` doesn't trigger this path.
  local a
  for a in "$@"; do
    [[ "$a" == "--" ]] && break
    [[ "$a" == "-h" || "$a" == "--help" ]] && return 0
  done
  return 1
}

_sw_root_from_argv() {
  # Best-effort parse of global `--root <path>` / `--root=<path>` without consuming argv.
  local -a argv=("$@")
  local i=0
  while [[ "$i" -lt "${#argv[@]}" ]]; do
    local a="${argv[$i]}"
    if [[ "$a" == "--" ]]; then
      break
    fi
    if [[ "$a" == "--root" ]]; then
      local v="${argv[$((i + 1))]:-}"
      if [[ -z "$v" ]]; then
        echo "ERROR: --root requires a path" >&2
        exit 2
      fi
      printf '%s' "$v"
      return 0
    fi
    if [[ "$a" == "--root="* ]]; then
      printf '%s' "${a#--root=}"
      return 0
    fi
    i=$((i + 1))
  done
  return 0
}

_sw_build_forward_argv() {
  # Strip global `--root` flags so the wrapper can forward argv cleanly.
  # We stop stripping at `--` (everything after is subcommand argv).
  forward_argv=()
  local -a argv=("$@")
  local i=0
  while [[ "$i" -lt "${#argv[@]}" ]]; do
    local a="${argv[$i]}"
    if [[ "$a" == "--" ]]; then
      forward_argv+=("${argv[@]:$i}")
      break
    fi
    if [[ "$a" == "--root" ]]; then
      i=$((i + 2))
      continue
    fi
    if [[ "$a" == "--root="* ]]; then
      i=$((i + 1))
      continue
    fi
    forward_argv+=("$a")
    i=$((i + 1))
  done
}

# Determine workspace root.
root_override=""
root_override_raw=""
root_override_source=""
root_selection=""
root_selection_reason=""
root_override="$(_sw_root_from_argv "$@")"
if [[ -n "$root_override" ]]; then
  root_override_raw="$root_override"
  root_override_source="arg"
elif [[ -n "${SANDWORM_ROOT:-}" ]]; then
  # Env fallback only; explicit --root always wins (important for nested sandworm inside sandboxes).
  root_override="${SANDWORM_ROOT}"
  root_override_raw="${SANDWORM_ROOT}"
  root_override_source="env"
fi

if [[ -n "$root_override" ]]; then
  if [[ "$root_override" != /* ]]; then
    root_override="$start_dir/$root_override"
  fi
  root=""
  if root_candidate="$(cd "$root_override" 2>/dev/null && pwd -P)"; then
    root="$root_candidate"
    root_selection="explicit_${root_override_source}"
    root_selection_reason="explicit_root_exists"
  elif [[ "$root_override" == "/workspace" ]]; then
    # Some bare-metal hosts don't provide /workspace. Fall back to the wrapper checkout root
    # so /workspace and /home/... can resolve to the same repo when possible.
    workspace_fallback_source=""
    if [[ -f "$start_dir/sandworm.lock" ]]; then
      root="$start_dir"
      workspace_fallback_source="start_dir_lock"
    else
      # In singlefile mode, outer launcher provides the original wrapper directory.
      self_dir="${SANDWORM_LAUNCH_WRAPPER_DIR:-}"
      if [[ -z "$self_dir" ]]; then
        self_path="${SANDWORM_WRAPPER_PATH:-}"
        # Wrapper-path env can be missing in some resume/host-launch paths.
        # Fall back to the currently executing script location so `--root /workspace`
        # behaves consistently no matter the caller cwd.
        if [[ -z "$self_path" ]]; then
          self_path="${BASH_SOURCE[0]:-$0}"
        fi
        if [[ -n "$self_path" ]]; then
          if [[ "$self_path" != /* ]]; then
            self_path="$start_dir/$self_path"
          fi
          self_dir_candidate="${self_path%/*}"
          if [[ -n "$self_dir_candidate" ]] && self_dir_real="$(cd "$self_dir_candidate" 2>/dev/null && pwd -P)"; then
            self_dir="$self_dir_real"
          fi
        fi
      fi
      if [[ -n "$self_dir" && -d "$self_dir" && -f "$self_dir/sandworm.lock" ]]; then
        root="$self_dir"
        workspace_fallback_source="wrapper_dir_lock"
      fi
    fi
    if [[ -z "$root" ]]; then
      env_root="${SANDWORM_ROOT:-}"
      if [[ -n "$env_root" && "$env_root" == /* ]]; then
        if env_root_real="$(cd "$env_root" 2>/dev/null && pwd -P)" && [[ -f "$env_root_real/sandworm.lock" ]]; then
          root="$env_root_real"
          workspace_fallback_source="env_root_lock"
        fi
      fi
    fi
    if [[ -n "$root" ]]; then
      root_selection="explicit_${root_override_source}"
      root_selection_reason="workspace_unavailable_fallback:${workspace_fallback_source:-unknown}"
      echo "WARNING: --root /workspace is unavailable; using wrapper root: $root" >&2
    fi
  fi
  if [[ -z "$root" ]]; then
    echo "ERROR: --root path is invalid: $root_override" >&2
    exit 2
  fi
  if ! mkdir -p "$root/.sandworm" 2>/dev/null; then
    echo "ERROR: unable to initialize control plane under '$root'" >&2
    exit 2
  fi
else
  # Find workspace root by locating an existing .sandworm directory.
  found_existing_control_plane=0
  found_writable_control_plane=0
  root="$start_dir"
  while [[ "$root" != "/" && ! -d "$root/.sandworm" ]]; do
    root="$(dirname "$root")"
  done
  if [[ -d "$root/.sandworm" ]]; then
    found_existing_control_plane=1
    _sw_probe="$root/.sandworm/.sw-root-write.$$"
    if ( : >"$_sw_probe" ) 2>/dev/null; then
      if command -v rm >/dev/null 2>&1; then
        rm -f "$_sw_probe" >/dev/null 2>&1 || true
      fi
      found_writable_control_plane=1
    fi
  fi
  if [[ "$found_existing_control_plane" != "1" ]]; then
    root="$start_dir"
    if mkdir -p "$root/.sandworm" 2>/dev/null; then
      root_selection="auto_start_dir_initialized"
      root_selection_reason="no_existing_control_plane_found"
    else
      sw_uid="${UID:-$(id -u 2>/dev/null || printf '0')}"
      fallback_root="/tmp/sandworm-root-$sw_uid"
      if mkdir -p "$fallback_root/.sandworm" 2>/dev/null; then
        root="$fallback_root"
        root_selection="auto_tmp_fallback_initialized"
        root_selection_reason="start_dir_not_writable"
        echo "WARNING: wrapper start_dir is not writable; using fallback root: $root" >&2
      else
        echo "ERROR: unable to initialize control plane under '$start_dir' or fallback '$fallback_root'" >&2
        exit 2
      fi
    fi
  elif [[ "$found_writable_control_plane" != "1" && ( -n "${SANDWORM_BACKEND:-}" || "$root" == "/workspace" || "$root" == /workspace/* ) ]]; then
    # Nested Sandworm inside SAFE sandboxes often sees /workspace/.sandworm as masked/read-only.
    # Fall back to a writable root under Sandworm-managed HOME so nested `sandworm run ...` works.
    nested_home="${SANDWORM_HOME:-${HOME:-}}"
    if [[ -n "$nested_home" && "$nested_home" == /* ]]; then
      nested_root="$nested_home/workspace-root"
      if mkdir -p "$nested_root/.sandworm" 2>/dev/null; then
        root="$nested_root"
        root_selection="auto_nested_home_fallback"
        root_selection_reason="existing_control_plane_not_writable"
        echo "[sandworm] nested root fallback: using $nested_root (workspace control plane is not writable)" >&2
      else
        root_selection="auto_existing_control_plane"
        root_selection_reason="found_existing_control_plane_readonly"
      fi
    else
      root_selection="auto_existing_control_plane"
      root_selection_reason="found_existing_control_plane_readonly"
    fi
  else
    root_selection="auto_existing_control_plane"
    root_selection_reason="found_existing_control_plane"
  fi
fi

export SANDWORM_ROOT="$root"
export SANDWORM_ROOT_REQUESTED="$root_override_raw"
export SANDWORM_ROOT_SELECTION="$root_selection"
export SANDWORM_ROOT_SELECTION_REASON="$root_selection_reason"

_sw_can_write_dir() {
  # Some sandbox substrates present paths that *look* writable (mode bits) but refuse create/unlink
  # operations due to userns/idmap/LSM constraints. Probe with a tiny file.
  local d="${1:-}"
  [[ -n "$d" && "$d" == /* ]] || return 1
  local probe="$d/.sw-write-test.$$"
  if ( : >"$probe" ) 2>/dev/null; then
    if command -v rm >/dev/null 2>&1; then
      rm -f "$probe" >/dev/null 2>&1 || true
    fi
    return 0
  fi
  return 1
}

_sw_toolroot_dirname_shim_needs_rewrite() {
  # Must be defined before early PATH/NIX sanity checks call it.
  local dirname_bin="$1"
  local shebang interp
  if [[ ! -f "$dirname_bin" ]]; then
    return 0
  fi
  shebang="$(head -n 1 "$dirname_bin" 2>/dev/null || true)"
  if [[ "$shebang" != "#!/bin/sh" ]]; then
    return 0
  fi
  if [[ "$shebang" == "#!/usr/bin/env bash" ]]; then
    return 0
  fi
  if [[ "$shebang" != '#!'* ]]; then
    return 0
  fi
  interp="${shebang#\#!}"
  interp="${interp%%[[:space:]]*}"
  if [[ -z "$interp" || ! -x "$interp" ]]; then
    return 0
  fi
  return 1
}

# SAFE defaults: avoid writing to the host user's HOME/XDG_* during wrapper bootstrap.
# The Python core also applies this policy, but stage0 may need to run nix first.
if [[ "${SW_USE_HOST_HOME:-0}" != "1" && "${SANDWORM_USE_HOST_HOME:-0}" != "1" ]]; then
  need_sw_home=1
  in_nested_runtime=0
  if [[ -n "${SANDWORM_BACKEND:-}" ]]; then
    in_nested_runtime=1
  fi
  if [[ "$in_nested_runtime" == "1" && ( "${SANDWORM_HOME:-}" == "/run/sandworm/home" || "${HOME:-}" == "/run/sandworm/home" ) ]]; then
    if _sw_can_write_dir "/run/sandworm/home" && ! _sw_can_write_dir "$root/.sandworm"; then
      need_sw_home=0
    fi
  fi
  if [[ "$need_sw_home" == "1" ]]; then
    if [[ "$root" == "/" ]]; then
      sw_home="/.sandworm/home"
    else
      sw_home="$root/.sandworm/home"
    fi
    if ! mkdir -p "$sw_home/.cache" "$sw_home/.config" "$sw_home/.local/share" "$sw_home/.local/state" "$sw_home/tmp" 2>/dev/null; then
      sw_uid="${UID:-$(id -u 2>/dev/null || printf '0')}"
      sw_tmp_base="${TMPDIR:-/tmp}"
      sw_home="$sw_tmp_base/sandworm-home-$sw_uid"
      mkdir -p "$sw_home/.cache" "$sw_home/.config" "$sw_home/.local/share" "$sw_home/.local/state" "$sw_home/tmp" 2>/dev/null || true
    fi
    if _sw_can_write_dir "$sw_home"; then
      export SANDWORM_HOME="$sw_home"
      export HOME="$sw_home"
      export XDG_CACHE_HOME="$sw_home/.cache"
      export XDG_CONFIG_HOME="$sw_home/.config"
      export XDG_DATA_HOME="$sw_home/.local/share"
      export XDG_STATE_HOME="$sw_home/.local/state"
      # Avoid spraying /tmp on the host during stage0 bootstrap unless the user explicitly overrides.
      if [[ -z "${TMPDIR:-}" ]]; then
        export TMPDIR="$sw_home/tmp"
      fi
    fi
  fi
fi

# If a prior sandbox layer pinned nix-portable under `/run/sandworm/home` but this wrapper decided
# that `/run/sandworm/home` is not writable (and switched $SANDWORM_HOME/$HOME to a workspace path),
# clear NP_LOCATION so nix-portable re-roots under the writable Sandworm HOME.
if [[ -n "${NP_LOCATION:-}" ]]; then
  if [[ "${SANDWORM_HOME:-${HOME:-}}" != "/run/sandworm/home" && "${NP_LOCATION:-}" == "/run/sandworm/home/"* ]]; then
    unset NP_LOCATION
  fi
fi

# When users force stage0 in `bootstrap verify`, preserve their constrained PATH and avoid
# auto-healing from inherited runtime mounts. This keeps forced-stage0 diagnostics truthful.
_sw_skip_inherited_runtime_path=0
if [[ "${SW_FORCE_STAGE0:-0}" == "1" ]]; then
  _sw_prev_arg=""
  for _sw_arg in "$@"; do
    if [[ "$_sw_prev_arg" == "bootstrap" && "$_sw_arg" == "verify" ]]; then
      _sw_skip_inherited_runtime_path=1
      break
    fi
    _sw_prev_arg="$_sw_arg"
  done
fi

# If we're already inside a Sandworm-managed environment, ensure common Sandworm tool
# directories are on PATH. This avoids stage0 network bootstrapping when the sandbox
# has an existing toolroot/providers dir mounted at /run/sandworm.
if [[ "${_sw_skip_inherited_runtime_path}" != "1" && ( -n "${SANDWORM_BACKEND:-}" || "${SANDWORM_HOME:-}" == "/run/sandworm/home" || "${HOME:-}" == "/run/sandworm/home" ) ]]; then
  if [[ -d "$root/.sandworm/toolroot/bin" ]]; then
    # Prefer root-local wrappers first: they are refreshed by this root and
    # avoid stale read-only runtime mounts under /run/sandworm/toolroot/bin.
    export PATH="$root/.sandworm/toolroot/bin${PATH:+:$PATH}"
  fi
  if [[ -d "/run/sandworm/bin" ]]; then
    export PATH="/run/sandworm/bin:${PATH:-}"
    if [[ -x "/run/sandworm/bin/sandworm" ]]; then
      export SANDWORM_BIN="/run/sandworm/bin/sandworm"
    fi
  fi
  if [[ -d "/run/sandworm/toolroot/bin" ]] && ! _sw_toolroot_dirname_shim_needs_rewrite "/run/sandworm/toolroot/bin/dirname"; then
    export PATH="${PATH:+$PATH:}/run/sandworm/toolroot/bin"
  fi
  if [[ -n "${SANDWORM_CLIENTS_BIN:-}" && -d "${SANDWORM_CLIENTS_BIN:-}" ]]; then
    export PATH="${SANDWORM_CLIENTS_BIN}:${PATH:-}"
  elif [[ -d "/run/sandworm/clients/bin" ]]; then
    export PATH="/run/sandworm/clients/bin:${PATH:-}"
  fi
fi

# If the environment provides an explicit Python path (common in Sandworm-managed cockpits),
# ensure it is on PATH so stage0 can run without nix-portable.
if [[ -n "${SANDWORM_PYTHON:-}" && "${SANDWORM_PYTHON:-}" == /* && -x "${SANDWORM_PYTHON:-}" ]]; then
  _sw_py_dir="${SANDWORM_PYTHON%/*}"
  case ":${PATH:-}:" in
    *":${_sw_py_dir}:"*) : ;;
    *) export PATH="${_sw_py_dir}${PATH:+:$PATH}" ;;
  esac
fi

# If an outer layer exported a broken /run toolroot nix path, do not force the Python core to use it.
if [[ "${SANDWORM_NIX:-}" == "/run/sandworm/toolroot/bin/nix" || "${SW_NIX:-}" == "/run/sandworm/toolroot/bin/nix" ]]; then
  if _sw_toolroot_dirname_shim_needs_rewrite "/run/sandworm/toolroot/bin/dirname"; then
    unset SANDWORM_NIX
    unset SW_NIX
  fi
fi

core_dir="${SANDWORM_EMBEDDED_CORE_DIR:-$root}"
export PYTHONPATH="$core_dir${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONSAFEPATH=1
_sw_build_forward_argv "$@"

_sw_bootstrap_log_file=""
_sw_bootstrap_log_enabled=0

_sw_bootstrap_is_tty() {
  [[ -t 2 ]]
}

_sw_bootstrap_log() {
  local level="${1:-info}"
  shift || true
  if [[ "${_sw_bootstrap_log_enabled:-0}" != "1" ]]; then
    return 0
  fi
  local ts
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
  if [[ -z "${ts:-}" ]]; then
    ts="$(date +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "unknown-time")"
  fi
  printf '%s level=%s pid=%s %s\n' "$ts" "$level" "$$" "$*" >>"${_sw_bootstrap_log_file}" 2>/dev/null || true
}

_sw_bootstrap_log_init() {
  local raw="${SW_BOOTSTRAP_LOG:-${SANDWORM_BOOTSTRAP_LOG:-}}"
  case "${raw,,}" in
    0|off|false|no)
      _sw_bootstrap_log_enabled=0
      return 0
      ;;
  esac

  if [[ -z "${raw:-}" ]]; then
    # Default: prefer the workspace control plane log, but if it's unwritable (common in SAFE
    # sandboxes where /workspace/.sandworm is masked), fall back to a location under SANDWORM_HOME.
    raw="$root/.sandworm/logs/bootstrap/latest.log"
  elif [[ "${raw}" != /* ]]; then
    raw="$root/$raw"
  fi

  local d="${raw%/*}"
  if [[ -n "${d:-}" ]]; then
    mkdir -p "$d" 2>/dev/null || true
  fi
  # Append-only: do not truncate. The trace viewer (`bootstrap trace`) must never clobber history.
  if ! : >>"$raw" 2>/dev/null; then
    if [[ -z "${SW_BOOTSTRAP_LOG:-${SANDWORM_BOOTSTRAP_LOG:-}}" ]]; then
      if [[ -n "${SANDWORM_HOME:-}" && "${SANDWORM_HOME:-}" == /* ]]; then
        raw2="$SANDWORM_HOME/logs/bootstrap/latest.log"
        d2="${raw2%/*}"
        if [[ -n "${d2:-}" ]]; then
          mkdir -p "$d2" 2>/dev/null || true
        fi
        if : >>"$raw2" 2>/dev/null; then
          raw="$raw2"
        else
          _sw_bootstrap_log_enabled=0
          return 0
        fi
      else
        _sw_bootstrap_log_enabled=0
        return 0
      fi
    else
      _sw_bootstrap_log_enabled=0
      return 0
    fi
  fi
  _sw_bootstrap_log_file="$raw"
  _sw_bootstrap_log_enabled=1
  export SW_BOOTSTRAP_LOG_EFFECTIVE="$raw"
  export SANDWORM_BOOTSTRAP_LOG="$raw"
  _sw_bootstrap_log info "bootstrap-trace start"
}

_sw_err() {
  echo "ERROR: $*" >&2
  _sw_bootstrap_log error "$*"
  if [[ -n "${SW_BOOTSTRAP_LOG_EFFECTIVE:-}" ]]; then
    # Keep this short; users can inspect the file for full detail.
    echo "[sandworm] hint: bootstrap trace log: ${SW_BOOTSTRAP_LOG_EFFECTIVE}" >&2
    echo "[sandworm] hint: view it with: sandworm bootstrap trace" >&2
  fi
}

_sw_note() {
  echo "[sandworm] $*" >&2
  _sw_bootstrap_log info "$*"
}
_sw_progress_enabled() {
  if [[ -n "${SW_BOOTSTRAP_PROGRESS:-}" ]]; then
    case "${SW_BOOTSTRAP_PROGRESS:-}" in
      1|true|yes|on) return 0 ;;
      *) return 1 ;;
    esac
  fi
  [[ -t 2 ]]
}

_sw_bootstrap_log_init
_sw_bootstrap_log info "bootstrap: root=$root selection=${root_selection:-unknown} reason=${root_selection_reason:-unknown} requested=${root_override_raw:-}"
_sw_bootstrap_log info "bootstrap: first_cmd=$(_sw_first_cmd "${forward_argv[@]}") strict_sc=${SW_STRICT_SUPPLYCHAIN:-${SANDWORM_STRICT_SUPPLYCHAIN:-0}} offline=${SW_OFFLINE:-${SANDWORM_OFFLINE:-0}}"
_sw_bootstrap_log info "bootstrap: home=${HOME:-} sandworm_home=${SANDWORM_HOME:-} pythonpath_head=${core_dir}"

# Human-friendly, terminal-facing bootstrap hints (stderr only; stdout stays clean for JSON).
if _sw_bootstrap_is_tty; then
  if _sw_progress_enabled; then
    echo "[sandworm] bootstrap:" >&2
    echo "[sandworm]   root=$root (${root_selection:-unknown}; ${root_selection_reason:-unknown})" >&2
    if [[ -n "${SW_BOOTSTRAP_LOG_EFFECTIVE:-}" ]]; then
      echo "[sandworm]   trace=${SW_BOOTSTRAP_LOG_EFFECTIVE}" >&2
      echo "[sandworm]   trace_viewer: sandworm bootstrap trace" >&2
    fi
  fi
fi

_sw_json_escape() {
  # Minimal JSON string escape for diagnostic output.
  # Usage: _sw_json_escape "raw"
  local s="${1:-}"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

_sw_sha256_cmd() {
  if command -v sha256sum >/dev/null 2>&1; then
    echo "sha256sum"
    return 0
  fi
  if command -v shasum >/dev/null 2>&1; then
    echo "shasum -a 256"
    return 0
  fi
  if command -v openssl >/dev/null 2>&1; then
    echo "openssl dgst -sha256"
    return 0
  fi
  return 1
}

_sw_compute_sha256() {
  local f="$1"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$f" 2>/dev/null | awk '{print $1}' | tr -d '\r\n'
    return 0
  fi
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$f" 2>/dev/null | awk '{print $1}' | tr -d '\r\n'
    return 0
  fi
  if command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 "$f" 2>/dev/null | awk '{print $NF}' | tr -d '\r\n'
    return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$f" <<'PY' 2>/dev/null || return 1
import hashlib
import sys
from pathlib import Path

p = Path(sys.argv[1])
h = hashlib.sha256()
with p.open("rb") as f:
    for chunk in iter(lambda: f.read(1024 * 1024), b""):
        h.update(chunk)
sys.stdout.write(h.hexdigest())
PY
    return 0
  fi
  return 1
}

_sw_mktemp_in_dir() {
  local dir="$1"
  local tmpl="$2"
  local p=""
  p="$(mktemp "$dir/$tmpl" 2>/dev/null || true)"
  if [[ -n "$p" ]]; then
    echo "$p"
    return 0
  fi
  p="$(mktemp -p "$dir" "$tmpl" 2>/dev/null || true)"
  if [[ -n "$p" ]]; then
    echo "$p"
    return 0
  fi
  # Fail closed: callers expect a concrete path, so never silently succeed with empty output.
  _sw_err "mktemp failed for dir='$dir' template='$tmpl'"
  return 1
}

_sw_write_shim_realpath() {
  local dst="$1"
  cat >"$dst" <<'SHIM'
#!/bin/sh
set -eu
if [ $# -lt 1 ]; then
  echo "realpath: missing operand" >&2
  exit 2
fi
p="$1"
case "$p" in
  /*) ;;
  *) p="$(pwd -P)/$p" ;;
esac
d="${p%/*}"
b="${p##*/}"
if [ -z "$d" ] || [ "$d" = "$p" ]; then
  d="/"
fi
if cd -P -- "$d" 2>/dev/null; then
  printf '%s/%s\n' "$(pwd -P)" "$b"
  exit 0
fi
exit 1
SHIM
  chmod +x "$dst" 2>/dev/null || true
}

_sw_write_shim_readlink() {
  local dst="$1"
  cat >"$dst" <<'SHIM'
#!/bin/sh
set -eu
if [ "${1:-}" = "-f" ]; then
  shift
  if [ $# -lt 1 ]; then
    echo "readlink: missing operand" >&2
    exit 2
  fi
  p="$1"
  case "$p" in
    /*) ;;
    *) p="$(pwd -P)/$p" ;;
  esac
  if [ -d "$p" ]; then
    cd -P -- "$p" 2>/dev/null || exit 1
    pwd -P
    exit 0
  fi
  d="${p%/*}"
  b="${p##*/}"
  if [ -z "$d" ] || [ "$d" = "$p" ]; then
    d="/"
  fi
  cd -P -- "$d" 2>/dev/null || exit 1
  printf '%s/%s\n' "$(pwd -P)" "$b"
  exit 0
fi
echo "readlink shim only supports: readlink -f <path>" >&2
exit 2
SHIM
  chmod +x "$dst" 2>/dev/null || true
}

_sw_parse_lock_kv() {
  # Parse a simple TOML key from sandworm.lock without requiring tomlkit/tomllib.
  # Usage: _sw_parse_lock_kv keyname
  local key="$1"
  local lf="$root/sandworm.lock"
  [[ -f "$lf" ]] || return 1
  # Match: key = "value" or key = 'value' (we only emit inside double quotes if present).
  awk -v k="$key" '
    $0 ~ "^[[:space:]]*"k"[[:space:]]*=" {
      line=$0
      sub(/^[[:space:]]*[^=]+=[[:space:]]*/, "", line)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
      if (line ~ /^"/) { sub(/^"/, "", line); sub(/".*$/, "", line); print line; exit }
      if (line ~ /^'\''/) { sub(/^'\''/, "", line); sub(/'\''.*$/, "", line); print line; exit }
      print line; exit
    }
  ' "$lf" 2>/dev/null | head -n1
}

_sw_nixpkgs_flake_primary() {
  local v="${SW_NIXPKGS_FLAKE:-${SANDWORM_NIXPKGS_FLAKE:-}}"
  if [[ -z "$v" ]]; then
    v="$(_sw_parse_lock_kv nixpkgs_flake 2>/dev/null || true)"
  fi
  if [[ -z "$v" || "$v" == "..." ]]; then
    # Avoid GitHub API branch resolution by using a tarball flake URL by default.
    v="tarball+https://github.com/NixOS/nixpkgs/archive/refs/heads/nixpkgs-unstable.tar.gz"
  fi
  printf '%s' "$v"
}

_sw_nixpkgs_flake_fallback() {
  local v="${SW_NIXPKGS_FLAKE_FALLBACK:-${SANDWORM_NIXPKGS_FLAKE_FALLBACK:-}}"
  if [[ -z "$v" ]]; then
    v="$(_sw_parse_lock_kv nixpkgs_flake_fallback 2>/dev/null || true)"
  fi
  if [[ -z "$v" || "$v" == "..." ]]; then
    # Avoid GitHub API branch resolution by using a tarball flake URL.
    v="tarball+https://github.com/NixOS/nixpkgs/archive/refs/heads/nixpkgs-unstable.tar.gz"
  fi
  printf '%s' "$v"
}

_sw_nixpkgs_ref_is_pinned_enough() {
  # Heuristic: strict mode should not rely on floating registry entries or branch tarballs.
  local ref="${1:-}"
  [[ -n "$ref" ]] || return 1
  if [[ "$ref" == "nixpkgs" ]]; then
    return 1
  fi
  # Local refs are under user control.
  if [[ "$ref" == /* || "$ref" == ./* || "$ref" == ../* || "$ref" == path:* ]]; then
    return 0
  fi
  # github:NixOS/nixpkgs/<rev> is pinned if the tail looks like a commit-ish.
  if [[ "$ref" == github:NixOS/nixpkgs/* ]]; then
    local tail="${ref#github:NixOS/nixpkgs/}"
    tail="${tail%%\?*}"
    # Commit-ish heuristic: hex >= 7 chars.
    if [[ "$tail" =~ ^[0-9a-fA-F]{7,}$ ]]; then
      return 0
    fi
  fi
  # github:... with an explicit rev pin.
  if [[ "$ref" == *"?rev="* ]]; then
    return 0
  fi
  # tarball+.../archive/<rev>.tar.gz is pinned; refs/heads is not.
  if [[ "$ref" == tarball+*"/archive/"*".tar.gz" ]] && [[ "$ref" != *"/archive/refs/heads/"* ]]; then
    return 0
  fi
  return 1
}

_sw_require_pinned_nixpkgs_if_strict() {
  local primary="$1"
  local fallback="$2"
  if [[ "${SW_STRICT_SUPPLYCHAIN:-0}" != "1" ]]; then
    return 0
  fi
  if _sw_nixpkgs_ref_is_pinned_enough "$primary"; then
    return 0
  fi
  # If primary is unpinned, allow a pinned fallback.
  if _sw_nixpkgs_ref_is_pinned_enough "$fallback"; then
    return 0
  fi
  _sw_err "strict supply chain mode: nixpkgs flake ref must be pinned (set SW_NIXPKGS_FLAKE or sandworm.lock [nix].nixpkgs_flake to a pinned ref)"
  _sw_err "got primary=$primary"
  _sw_err "got fallback=$fallback"
  return 1
}

_sw_strip_tarball_prefix() {
  local ref="${1:-}"
  if [[ "$ref" == tarball+* ]]; then
    echo "${ref#tarball+}"
  else
    echo "$ref"
  fi
}

_sw_sh_quote() {
  # POSIX-ish single-quote escaping (safe for `sh -lc` and nix-shell --run).
  local s="${1-}"
  s=${s//\'/\'\"\'\"\'}
  printf "'%s'" "$s"
}

_sw_nix_looks_like_github_api_flake_failure() {
  local f="$1"
  grep -qiE 'api\\.github\\.com/repos/NixOS/nixpkgs/commits|rate limit exceeded|HTTP error (403|429|5(00|02|03|04))|504 Gateway' "$f" 2>/dev/null
}

_sw_verify_nix_portable_file() {
  local f="$1"
  local magic2 magic4 hdr
  hdr="$(dd if="$f" bs=1 count=64 2>/dev/null | tr -d '\r' || true)"
  if [[ "$hdr" == \<\!* || "$hdr" == \<html* || "$hdr" == HTTP/* ]]; then
    return 1
  fi
  magic2="$(dd if="$f" bs=1 count=2 2>/dev/null || true)"
  magic4="$(dd if="$f" bs=1 count=4 2>/dev/null || true)"
  if [[ "$magic4" != $'\x7fELF' && "$magic2" != "#!" ]]; then
    return 1
  fi
  return 0
}

_sw_have_cmd() { command -v "$1" >/dev/null 2>&1; }

_sw_require_cmds() {
  local -a missing=()
  local c
  for c in "$@"; do
    if ! _sw_have_cmd "$c"; then
      missing+=("$c")
    fi
  done
  if [[ "${#missing[@]}" -gt 0 ]]; then
    _sw_err "stage0 bootstrap missing required host tools: ${missing[*]}"
    return 1
  fi
  return 0
}

_sw_can_compute_sha256() {
  _sw_have_cmd sha256sum || _sw_have_cmd shasum || _sw_have_cmd openssl || _sw_have_cmd python3
}

_sw_wget_supports_ca_certificate() {
  if ! _sw_have_cmd wget; then
    return 1
  fi
  wget --help 2>&1 | grep -q -- '--ca-certificate'
}

_sw_nix_class_for_root() {
  # Output format:
  #   system:<path>
  #   toolroot:<path>
  #   <empty> (no usable nix for selected root)
  local nx=""
  if command -v nix >/dev/null 2>&1; then
    nx="$(command -v nix)"
  fi
  if [[ -n "$nx" && "$nx" == *"/.sandworm/toolroot/bin/nix" && "$nx" != "$root/.sandworm/toolroot/bin/nix" ]]; then
    nx=""
  fi
  if [[ -n "$nx" && -x "$nx" ]]; then
    if [[ "$nx" == "$root/.sandworm/toolroot/bin/nix" || "$nx" == "/run/sandworm/toolroot/bin/nix" || "$nx" == *"/.sandworm/toolroot/bin/nix" ]]; then
      echo "toolroot:$nx"
    else
      echo "system:$nx"
    fi
    return 0
  fi
  if [[ -x "$root/.sandworm/toolroot/bin/nix" ]]; then
    echo "toolroot:$root/.sandworm/toolroot/bin/nix"
    return 0
  fi
  for cand in /run/current-system/sw/bin/nix /usr/bin/nix /bin/nix /nix/var/nix/profiles/default/bin/nix /nix/profile/bin/nix; do
    if [[ -x "$cand" ]]; then
      echo "system:$cand"
      return 0
    fi
  done
  return 1
}

_sw_write_toolroot_nix_wrapper() {
  local toolbin="$root/.sandworm/toolroot/bin"
  local np_bin="$toolbin/nix-portable"
  local nix_bin="$toolbin/nix"
  local nix_shell_bin="$toolbin/nix-shell"
  mkdir -p "$toolbin"
  # IMPORTANT: toolroot wrappers are bind-mounted into sandboxes. Using a host-only
  # shebang (e.g. /run/current-system/sw/bin/bash) will fail inside containers that
  # don't have that path. Start from /bin/sh and re-exec into bash.
  printf '%s\n' '#!/bin/sh' >"$nix_bin"
  cat >>"$nix_bin" <<'NIX_WRAPPER'
# Ensure a real bash (some environments may invoke this via ash/dash).
if [ -z "${BASH_VERSION-}" ]; then
  if [ -n "${SANDWORM_BASH-}" ] && [ -x "${SANDWORM_BASH}" ]; then
    exec "${SANDWORM_BASH}" "$0" "$@"
  fi
  for _sw_bash in /run/current-system/sw/bin/bash /usr/bin/bash /bin/bash /usr/local/bin/bash; do
    if [ -x "$_sw_bash" ]; then
      exec "$_sw_bash" "$0" "$@"
    fi
  done
  if command -v bash >/dev/null 2>&1; then
    exec bash "$0" "$@"
  fi
  echo "nix: bash not found (set SANDWORM_BASH=/path/to/bash)" >&2
  exit 2
fi
set -euo pipefail

SW_NIX_WRAPPER_BASH="${BASH:-}"
if [[ -z "${SW_NIX_WRAPPER_BASH}" || ! -x "${SW_NIX_WRAPPER_BASH}" ]]; then
  for _sw_bash in /run/current-system/sw/bin/bash /usr/bin/bash /bin/bash /usr/local/bin/bash; do
    if [[ -x "$_sw_bash" ]]; then
      SW_NIX_WRAPPER_BASH="$_sw_bash"
      break
    fi
  done
fi
if [[ -z "${SW_NIX_WRAPPER_BASH}" || ! -x "${SW_NIX_WRAPPER_BASH}" ]]; then
  SW_NIX_WRAPPER_BASH="$(command -v bash 2>/dev/null || true)"
fi
if [[ -z "${SW_NIX_WRAPPER_BASH}" || ! -x "${SW_NIX_WRAPPER_BASH}" ]]; then
  for _sw_bash in /nix/store/*bash*/bin/bash; do
    if [[ -x "$_sw_bash" ]]; then
      SW_NIX_WRAPPER_BASH="$_sw_bash"
      break
    fi
  done
fi
if [[ -z "${SW_NIX_WRAPPER_BASH}" || ! -x "${SW_NIX_WRAPPER_BASH}" ]]; then
  echo "nix: bash not found (set SANDWORM_BASH=/path/to/bash)" >&2
  exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
NP_BIN="$SCRIPT_DIR/nix-portable"
if [[ ! -x "$NP_BIN" ]]; then
  echo "nix: nix-portable missing at $NP_BIN (run: sandworm refresh --force)" >&2
  exit 2
fi

# SSL: nix-portable runs in a wrapped environment where host cert paths (often in /nix/store)
# may not be readable. Prefer a CA bundle copied next to nix-portable under --root.
unset NIX_SSL_CERT_FILE CURL_CA_BUNDLE
ca_local="$SCRIPT_DIR/../nix-portable/ca-certificates.crt"
if [[ ! -r "$ca_local" ]]; then
  ca_src=""
  if [[ -n "${SW_NIX_SSL_CERT_FILE:-}" ]] && [[ -r "${SW_NIX_SSL_CERT_FILE:-}" ]]; then
    ca_src="$SW_NIX_SSL_CERT_FILE"
  elif [[ -r "/etc/ssl/certs/ca-certificates.crt" ]]; then
    ca_src="/etc/ssl/certs/ca-certificates.crt"
  elif [[ -r "/etc/pki/tls/certs/ca-bundle.crt" ]]; then
    ca_src="/etc/pki/tls/certs/ca-bundle.crt"
  elif [[ -r "/etc/ssl/certs/ca-bundle.crt" ]]; then
    ca_src="/etc/ssl/certs/ca-bundle.crt"
  fi
  if [[ -n "$ca_src" ]] && command -v cp >/dev/null 2>&1; then
    mkdir -p "$(dirname "$ca_local")" 2>/dev/null || true
    cp "$ca_src" "$ca_local" 2>/dev/null || true
  fi
fi
if [[ -r "$ca_local" ]]; then
  export SSL_CERT_FILE="$ca_local"
elif [[ -n "${SW_NIX_SSL_CERT_FILE:-}" ]] && [[ -r "${SW_NIX_SSL_CERT_FILE:-}" ]]; then
  export SSL_CERT_FILE="$SW_NIX_SSL_CERT_FILE"
fi

# Let stage0 place tiny shims next to nix-portable (for minimal hosts).
export PATH="$SCRIPT_DIR${PATH:+:$PATH}"

# nix-portable caches and virtualizes /nix/store under NP_LOCATION.
# IMPORTANT: keep NP_LOCATION stable and absolute to avoid nested explosions.
if [[ -z "${NP_LOCATION:-}" ]]; then
  if [[ -n "${SANDWORM_BACKEND:-}" ]]; then
    # In sandboxes, prefer a location under the Sandworm-managed HOME so the cache is shared and writable.
    if [[ -n "${SANDWORM_HOME:-}" ]]; then
      NP_LOCATION="${SANDWORM_HOME}/.nix-portable"
    elif [[ -n "${HOME:-}" ]]; then
      NP_LOCATION="${HOME}/.nix-portable"
    else
      NP_LOCATION="/tmp/.nix-portable"
    fi
  else
    NP_LOCATION="$(cd "$SCRIPT_DIR/../.." && pwd -P)/nix-portable"
  fi
fi
export NP_LOCATION

if [[ "$NP_LOCATION" != /* ]]; then
  echo "nix: NP_LOCATION must be an absolute path (got: $NP_LOCATION)" >&2
  exit 2
fi

# In podman sandboxes, nix-portable's default runtime frequently fails first and may emit errors on stdout.
# Prefer proot by default (unless explicitly disabled) to keep behavior stable for noob flows and JSON callers.
SW_NP_RUNTIME_USER_SET=0
if [[ -n "${NP_RUNTIME:-}" ]]; then
  SW_NP_RUNTIME_USER_SET=1
fi
if [[ -z "${NP_RUNTIME:-}" ]] && [[ "${SANDWORM_BACKEND:-}" == "podman" ]]; then
  if [ "${SW_NIX_PORTABLE_DISABLE_PROOT:-0}" != "1" ] && [ "${SANDWORM_NIX_PORTABLE_DISABLE_PROOT:-0}" != "1" ]; then
    export NP_RUNTIME=proot
    if [[ -z "${PROOT_NO_SECCOMP:-}" ]]; then
      export PROOT_NO_SECCOMP=1
    fi
  fi
fi

# nix-portable initializes by extracting embedded files using `unzip`. On some hosts, the BusyBox
# unzip applet cannot extract nix-portable's embedded nix binary with nix-portable's flags, which
# breaks first-run bootstrap. If a host unzip is available, prefer it by placing it in the
# nix-portable init PATH (which is later set to busybox/bin).
np_root="$NP_LOCATION/.nix-portable"
unzip_host=""
if command -v unzip >/dev/null 2>&1; then
  unzip_host="$(command -v unzip)"
else
  for cand in /run/current-system/sw/bin/unzip /usr/bin/unzip /bin/unzip; do
    if [[ -x "$cand" ]]; then
      unzip_host="$cand"
      break
    fi
  done
fi
if [[ -n "$unzip_host" ]]; then
  mkdir -p "$np_root/busybox/bin" >/dev/null 2>&1 || true
  if [[ ! -e "$np_root/busybox/bin/unzip" ]]; then
    ln -s "$unzip_host" "$np_root/busybox/bin/unzip" >/dev/null 2>&1 || true
  fi
fi

	# Enable nix-command/flakes by default when no user config is present.
	if [[ "${NIX_CONFIG:-}" != *experimental-features* ]] && [[ -z "${HOME:-}" || ! -f "${HOME}/.config/nix/nix.conf" ]]; then
	  if [[ -n "${NIX_CONFIG:-}" ]]; then
	    export NIX_CONFIG="${NIX_CONFIG}"$'\n'"experimental-features = nix-command flakes"
	  else
	    export NIX_CONFIG="experimental-features = nix-command flakes"
	  fi
	fi

	# Some kernels/distros restrict unprivileged mount namespaces in ways that make Nix error with:
	#   "setting up a private mount namespace: Operation not permitted"
	# Sandworm sets `NP_CONF_SANDBOX=false` in sandboxes/stage0 to opt out of Nix's sandbox.
	# Respect that signal here so `nix shell` works reliably under nix-portable.
	case "${NP_CONF_SANDBOX:-}" in
	  0|false|False|FALSE|no|NO|off|OFF)
	    if [[ -n "${NIX_CONFIG:-}" ]]; then
	      export NIX_CONFIG="${NIX_CONFIG}"$'\n'"sandbox = false"
	    else
	      export NIX_CONFIG="sandbox = false"
	    fi
	    ;;
	esac

	  tmp_err="$(mktemp "${TMPDIR:-/tmp}/sandworm-nix-portable.XXXXXX" 2>/dev/null || mktemp "/tmp/sandworm-nix-portable.XXXXXX")"
	  # Avoid process-substitution `tee` here: some container PID1s don't reap, leading to zombie buildup.
	  set +e
	  "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@" 2>"$tmp_err"
	  rc="$?"
  set -e
  if [[ "$rc" != "0" ]]; then
    cat "$tmp_err" >&2 || true
  fi
if [[ "$rc" != "0" ]]; then
  if [[ "${SW_NP_RUNTIME_USER_SET:-0}" != "1" ]]; then
  err_txt="$(cat "$tmp_err" 2>/dev/null || true)"
  allow_proot=1
  if [ "${SW_NIX_PORTABLE_DISABLE_PROOT:-0}" = "1" ] || [ "${SANDWORM_NIX_PORTABLE_DISABLE_PROOT:-0}" = "1" ]; then
    allow_proot=0
  fi
  runtime_now="${NP_RUNTIME:-}"
  if [[ -z "$err_txt" ]]; then
    if [[ "$runtime_now" == "proot" ]]; then
      echo "nix: nix-portable failed without stderr detail in runtime=proot; retrying with NP_RUNTIME=nix" >&2
      set +e
      NP_RUNTIME=nix "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
      rc2="$?"
      set -e
      if [[ "$rc2" == "0" ]]; then
        rm -f "$tmp_err" >/dev/null 2>&1 || true
        exit 0
      fi
      rm -f "$tmp_err" >/dev/null 2>&1 || true
      exit "$rc2"
    fi
    if [[ "$allow_proot" == "1" ]]; then
      echo "nix: nix-portable failed without stderr detail; retrying with NP_RUNTIME=proot" >&2
      # Some nix-portable failures are emitted on stdout only; prefer a resilient runtime fallback.
      NP_RUNTIME=proot PROOT_NO_SECCOMP=1 exec "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
    fi
    echo "nix: nix-portable failed without stderr detail; retrying with NP_RUNTIME=nix" >&2
    set +e
    NP_RUNTIME=nix "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
    rc2="$?"
    set -e
    if [[ "$rc2" == "0" ]]; then
      rm -f "$tmp_err" >/dev/null 2>&1 || true
      exit 0
    fi
    rm -f "$tmp_err" >/dev/null 2>&1 || true
    exit "$rc2"
  fi
  if [[ "$err_txt" == *"private mount namespace"* && "$err_txt" == *"Operation not permitted"* ]] || [[ "$err_txt" == *"/proc/self/setgroups"* && "$err_txt" == *"Operation not permitted"* ]] || [[ "$err_txt" == *"bwrap: setting up uid map: Permission denied"* ]] || [[ "$err_txt" == *"No permissions to create new namespace"* ]] || [[ "$err_txt" == *"bwrap: Creating new namespace failed"* && "$err_txt" == *"Operation not permitted"* ]]; then
    echo "nix: nix-portable failed with namespace restrictions; retrying with NP_RUNTIME=nix" >&2
    set +e
    NP_RUNTIME=nix "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
    rc2="$?"
    set -e
    if [[ "$rc2" == "0" ]]; then
      rm -f "$tmp_err" >/dev/null 2>&1 || true
      exit 0
    fi
    if [ "${SW_NIX_PORTABLE_DISABLE_PROOT:-0}" != "1" ] && [ "${SANDWORM_NIX_PORTABLE_DISABLE_PROOT:-0}" != "1" ]; then
      echo "nix: nix-portable runtime=nix failed; retrying with NP_RUNTIME=proot" >&2
      # PRoot seccomp support can be missing on some kernels; disable PRoot seccomp to reduce false negatives.
      NP_RUNTIME=proot PROOT_NO_SECCOMP=1 exec "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
    fi
