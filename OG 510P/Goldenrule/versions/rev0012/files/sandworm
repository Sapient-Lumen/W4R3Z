from __future__ import annotations

import argparse
import json
import os
import socket
import sys


def _parse(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="sandworm-host-client", add_help=True)
    p.add_argument(
        "--socket",
        dest="sock",
        default=os.environ.get("SANDWORM_HOSTD_SOCK") or "/run/sandworm/hostd.sock",
        help="Path to mounted hostd unix socket (default: $SANDWORM_HOSTD_SOCK or /run/sandworm/hostd.sock)",
    )
    p.add_argument("--cwd", default=os.environ.get("SANDWORM_HOST_CWD"), help="Host working directory (optional)")
    p.add_argument("--timeout", dest="timeout_s", type=int, default=None, help="Timeout in seconds")
    p.add_argument("--capture", choices=["always", "onfail", "never"], default="onfail")
    p.add_argument("--env", action="append", default=[], help="Env var to set on host (KEY=VALUE); repeatable")
    p.add_argument("--tag", default=None)
    p.add_argument("--trace-id", default=os.environ.get("SANDWORM_TRACE_ID"))
    p.add_argument("command", nargs=argparse.REMAINDER)
    return p.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = _parse(sys.argv[1:] if argv is None else argv)
    cmd = list(args.command)
    if cmd[:1] == ["--"]:
        cmd = cmd[1:]
    if not cmd:
        print("ERROR: missing command (use `--` before argv)", file=sys.stderr)
        return 2

    env: dict[str, str] = {}
    for raw in getattr(args, "env", []) or []:
        if not isinstance(raw, str):
            continue
        if "=" not in raw:
            print(f"ERROR: invalid --env (expected KEY=VALUE): {raw!r}", file=sys.stderr)
            return 2
        k, v = raw.split("=", 1)
        k = k.strip()
        if not k:
            print(f"ERROR: invalid --env key: {raw!r}", file=sys.stderr)
            return 2
        env[k] = v

    req = {
        "argv": cmd,
        "cwd": args.cwd,
        "env": env,
        "timeout_s": args.timeout_s,
        "capture": args.capture,
        "tag": args.tag,
        "trace_id": args.trace_id,
    }
    tok = os.environ.get("SANDWORM_HOSTD_TOKEN")
    if tok:
        req["token"] = tok
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(args.sock)
        s.sendall((json.dumps(req) + "\n").encode("utf-8"))
        resp_raw = b""
        while not resp_raw.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            resp_raw += chunk
    finally:
        s.close()

    resp = json.loads(resp_raw.decode("utf-8", errors="replace").strip() or "{}")
    rc = int(resp.get("exit_code", 1))
    if rc != 0:
        err = resp.get("error")
        if err:
            print(f"hostd error: {err}", file=sys.stderr)
    return rc


