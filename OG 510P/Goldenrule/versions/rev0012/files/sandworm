MASK_SENTINEL = "/workspace/.sandworm/CONTROL_PLANE_DO_NOT_TOUCH"
EXIT_MASKING_FAILED = 42


def inject_mask_check(argv: list[str]) -> list[str]:
    """
    Best-effort masking invariant enforcement.

    For shell-style invocations, prepend a check that the host control plane is
    not visible at /workspace/.sandworm inside the sandbox.
    """
    if len(argv) < 3:
        return argv
    prog, flag, script = argv[0], argv[1], argv[2]
    if prog not in ("sh", "bash"):
        return argv
    if flag not in ("-c", "-lc"):
        return argv
    if not isinstance(script, str):
        return argv
    prefix = (
        f"test ! -e {MASK_SENTINEL} || "
        f"{{ echo 'ERROR: control plane is visible at /workspace/.sandworm' >&2; exit {EXIT_MASKING_FAILED}; }}; "
    )
    out = list(argv)
    out[2] = prefix + script
    return out

