def hooks_install(*, root: Path, template: str, force: bool, quiet: bool) -> None:
    """
    Install a template bundle into `.sandworm/hooks*` and enable it (chmod +x).
    """
    root = root.resolve()
    template = (template or "").strip()
    if "/" not in template:
        raise ValueError("template must look like 'sandbox/<bundle>' or 'host/<bundle>'")
    cls, bundle = template.split("/", 1)
    cls = cls.strip()
    bundle = bundle.strip()
    if cls not in ("sandbox", "host") or not bundle:
        raise ValueError("invalid template id")

    td = hooks_templates_dir(root) / cls / bundle
    builtin = _builtin_templates().get(cls, {}).get(bundle, {})

    files: dict[str, str] = {}
    if td.is_dir():
        for p in sorted(td.glob("*.sh")):
            if p.is_file():
                files[p.name] = p.read_text(encoding="utf-8")
    if not files:
        files = dict(builtin)

    if not files:
        raise ValueError(f"unknown template: {template}")

    if cls == "sandbox":
        dst = hooks_dir(root)
    else:
        dst = host_hooks_dir(root)
        if not quiet:
            print(
                "NOTE: host hooks are dangerous; they only run with SANDWORM_ALLOW_HOST_HOOKS=1 "
                "and posture in unsafe|take-the-wheel|bare-metal."
            )
    dst.mkdir(parents=True, exist_ok=True)

    for name, content in files.items():
        _write_file(root=root, path=dst / name, content=content, mode=0o755, force=force, quiet=quiet)

