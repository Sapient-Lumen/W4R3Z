        "if [ -n \"${NIX_CONFIG:-}\" ]; then export NIX_CONFIG=\"${NIX_CONFIG}\"$'\\n''experimental-features = nix-command flakes'; "
        "else export NIX_CONFIG='experimental-features = nix-command flakes'; fi; "
