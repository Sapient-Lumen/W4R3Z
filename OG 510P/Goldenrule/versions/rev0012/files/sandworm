def _write_minimal_identity_files(
    control: Path,
    *,
    uid: int,
    gid: int,
    username: str,
    home_in_sandbox: str,
    shell_in_sandbox: str = "/bin/sh",
) -> tuple[Path | None, Path | None]:
    """
    Write minimal passwd/group files for bwrap sandboxes.

    Why:
    - SAFE mode intentionally does not mount host /etc wholesale.
    - Some Node-based CLIs call os.userInfo()/getpwuid(), which fails with ENOENT
      when /etc/passwd is missing in the sandbox.
    """
    try:
        d = (control / "tmp").resolve()
        d.mkdir(parents=True, exist_ok=True)
        user = (username or "sandworm").strip() or "sandworm"
        home = home_in_sandbox.strip() or "/run/sandworm/home"
        shell = shell_in_sandbox.strip() or "/bin/sh"

        passwd_lines: list[str] = ["root:x:0:0:root:/root:/bin/sh"]
        if uid != 0:
            passwd_lines.append(f"{user}:x:{int(uid)}:{int(gid)}:{user}:{home}:{shell}")
        else:
            passwd_lines[0] = f"root:x:0:{int(gid)}:root:{home}:{shell}"

        group_lines: list[str] = ["root:x:0:"]
        if gid != 0:
            group_lines.append(f"{user}:x:{int(gid)}:")

        passwd_path = (d / "passwd.bwrap").resolve()
        group_path = (d / "group.bwrap").resolve()
        passwd_path.write_text("\n".join(passwd_lines) + "\n", encoding="utf-8")
        group_path.write_text("\n".join(group_lines) + "\n", encoding="utf-8")
