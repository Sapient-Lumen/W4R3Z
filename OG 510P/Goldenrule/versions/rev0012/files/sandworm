def _load_queue(root: Path, path: Path) -> dict[str, Any]:
    p = (root / path).resolve()
    doc = yaml.safe_load(p.read_text(encoding="utf-8"))
    if not isinstance(doc, dict):
        raise ValueError("queue file must be a YAML mapping")
    _require(doc.get("version") == 0, "queue version must be 0")
    steps = doc.get("steps")
    _require(isinstance(steps, list) and len(steps) > 0, "queue must have non-empty steps[]")
    seen: set[str] = set()
    for st in steps:
        _require(isinstance(st, dict), "each step must be a mapping")
        sid = st.get("id")
        _require(isinstance(sid, str) and sid.strip(), "each step must have string id")
        _require(sid not in seen, f"duplicate step id: {sid}")
        seen.add(sid)
        _require(("prompt" in st) ^ ("prompt_file" in st), f"step {sid}: must have exactly one of prompt|prompt_file")
    return doc


