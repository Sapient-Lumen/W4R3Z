  # prefer them only when readable (some environments point these at non-existent /nix/store paths).
  if [[ -n "${SW_NIX_SSL_CERT_FILE:-}" && -r "${SW_NIX_SSL_CERT_FILE:-}" ]]; then
    ca_file="${SW_NIX_SSL_CERT_FILE}"
  elif [[ -n "${SSL_CERT_FILE:-}" && -r "${SSL_CERT_FILE:-}" ]]; then
    ca_file="${SSL_CERT_FILE}"
  elif [[ -n "${CURL_CA_BUNDLE:-}" && -r "${CURL_CA_BUNDLE:-}" ]]; then
    ca_file="${CURL_CA_BUNDLE}"
  elif [[ -r "/etc/ssl/certs/ca-certificates.crt" ]]; then
    ca_file="/etc/ssl/certs/ca-certificates.crt"
  elif [[ -r "/etc/pki/tls/certs/ca-bundle.crt" ]]; then
    ca_file="/etc/pki/tls/certs/ca-bundle.crt"
  elif [[ -r "/etc/ssl/certs/ca-bundle.crt" ]]; then
    ca_file="/etc/ssl/certs/ca-bundle.crt"
  fi
