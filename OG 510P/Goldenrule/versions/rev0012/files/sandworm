from __future__ import annotations

import json
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Iterator

from .jsonutil import json_get


@dataclass(frozen=True)
class EventsValidationResult:
    ok: bool
    errors: list[str]
    warnings: list[str]
    count: int


def iter_events_jsonl(path: Path) -> Iterator[dict[str, Any]]:
    text = path.read_text(encoding="utf-8")
    for i, line in enumerate(text.splitlines(), start=1):
        if not line.strip():
            continue
        try:
            rec = json.loads(line)
        except Exception as e:
            raise ValueError(f"invalid JSON at {path}:{i}: {e}") from e
        if not isinstance(rec, dict):
            raise ValueError(f"non-object JSON at {path}:{i} (expected object)")
        yield rec


def validate_events_jsonl(path: Path) -> EventsValidationResult:
    errors: list[str] = []
    warnings: list[str] = []
    count = 0
    try:
        for rec in iter_events_jsonl(path):
            count += 1
            ts = rec.get("ts")
            if not isinstance(ts, str) or not ts.strip():
                errors.append("event.ts missing/invalid")

            typ = rec.get("type")
            if not isinstance(typ, str) or not typ.strip():
                errors.append("event.type missing/invalid")

            data = rec.get("data")
            if not isinstance(data, dict):
                errors.append("event.data missing/invalid (expected object)")

            # Backcompat: accept either runid or run_id.
            runid = rec.get("run_id")
            if not isinstance(runid, str) or not runid.strip():
                runid = rec.get("runid")
            if not isinstance(runid, str) or not runid.strip():
                errors.append("event.run_id/runid missing/invalid")

            seq = rec.get("seq")
            if not isinstance(seq, int) or seq < 1:
                errors.append("event.seq missing/invalid (expected int >= 1)")

            trace_id = rec.get("trace_id")
            if not isinstance(trace_id, str) or not trace_id.strip():
                warnings.append("event.trace_id missing/invalid")

            level = rec.get("level")
            if level is not None and (not isinstance(level, str) or not level.strip()):
                warnings.append("event.level invalid (expected string)")
    except Exception as e:
        return EventsValidationResult(ok=False, errors=[str(e)], warnings=warnings, count=count)

    return EventsValidationResult(ok=(len(errors) == 0), errors=errors, warnings=warnings, count=count)


@dataclass(frozen=True)
class EventsHasResult:
    ok: bool
    matched: bool
    count: int
    error: str | None


def events_has(
    path: Path,
    *,
    typ: str | None = None,
    key: str | None = None,
    expect: str | None = None,
    contains: str | None = None,
) -> EventsHasResult:
    """
    Return whether any event matches the provided criteria.

    Criteria:
    - typ: event["type"] equals typ
    - key+expect: json_get(event, key) equals expect (best-effort scalar comparison)
    - key+contains: json_get(event, key) contains substring (string-only)
    """
    typ = (typ or "").strip() or None
    key = (key or "").strip() or None
    expect = (expect if expect is None else str(expect))
    contains = (contains if contains is None else str(contains))

    if expect is not None and contains is not None:
        return EventsHasResult(ok=False, matched=False, count=0, error="use either --expect or --contains (not both)")

    count = 0
    try:
        for rec in iter_events_jsonl(path):
            count += 1
            if typ and rec.get("type") != typ:
                continue
            if key:
                got = json_get(rec, key)
                if not got.ok:
                    continue
                v = got.value
                if contains is not None:
                    if isinstance(v, str) and contains in v:
                        return EventsHasResult(ok=True, matched=True, count=count, error=None)
                    continue
                if expect is not None:
                    exp = (expect or "")
                    if isinstance(v, bool) and exp.lower() in ("true", "false"):
                        if v is (exp.lower() == "true"):
                            return EventsHasResult(ok=True, matched=True, count=count, error=None)
                        continue
                    if v is None and exp.lower() in ("null", "none", ""):
