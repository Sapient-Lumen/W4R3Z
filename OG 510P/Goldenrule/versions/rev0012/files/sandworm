        if args.dev_cmd == "diag":
            ensure_control_plane(root)
            strict_sc = _truthy_env("SW_STRICT_SUPPLYCHAIN") or _truthy_env("SANDWORM_STRICT_SUPPLYCHAIN")
            flake_arg = getattr(args, "flake", None)
            flake_ref = resolve_flake_ref(root, (flake_arg.strip() if isinstance(flake_arg, str) and flake_arg.strip() else None))

            installables: list[str] = []
            if not bool(getattr(args, "no_default_packages", False)):
                installables.extend(default_installables())
            extra = getattr(args, "packages", None)
            if isinstance(extra, list):
                for raw in extra:
                    s = str(raw or "").strip()
                    if not s:
                        continue
                    if not attr_path_is_safe(s):
                        raise SystemExit(
                            f"dev diag: refusing unsafe --pkg value: {s!r} (expected an attribute path like git or python311Packages.tomlkit)"
                        )
                    installables.append(s)
            if not installables:
                installables.append("bashInteractive")

            timeout_s = int(getattr(args, "timeout_s", 30) or 30)
            if timeout_s < 1:
                timeout_s = 1
            if timeout_s > 300:
                timeout_s = 300
            diag = collect_dev_shell_diagnostics(
                root,
                flake_ref=flake_ref,
                installables=installables,
                strict_supply_chain=bool(strict_sc),
                preflight_timeout_s=timeout_s,
            )
            out_path = _dev_diag_artifact_path()
            out_path.write_text(json.dumps(diag, indent=2, sort_keys=True) + "\n", encoding="utf-8")
            append_dev_shell_event(root, {"event": "dev_diag", "artifact": str(out_path), **diag})
            out = {"ok": bool(diag.get("preflight", {}).get("ok")), "artifact": str(out_path), "diag": diag}
            if bool(getattr(args, "json", False)):
                print(json.dumps(out, indent=2, sort_keys=True))
            else:
                mode = str(diag.get("mode") or "unknown")
                reason = str(diag.get("reason_code") or "unknown")
                print(f"dev diag: mode={mode} reason={reason}")
                print(f"artifact: {out_path}")
            return 0 if bool(diag.get("preflight", {}).get("ok")) else 1

        if args.dev_cmd == "shell":
            from .nixutils import find_nix, nix_flags
            from .toolroot import ToolrootError, refresh_toolroot, refresh_toolroot_wrappers

            # Dev shell is a host-side "kitchen sink" used to work on Sandworm itself.
            #
            # It should be usable on hosts without Nix: if a nix executable is not available,
            # bootstrap Sandworm's toolroot (nix-portable + wrappers) under --root/.sandworm/.
            ensure_control_plane(root)
            # Keep wrapper behavior current even when toolroot artifacts are already present.
            refresh_toolroot_wrappers(root)
            toolroot_degraded_note: str | None = None

            toolroot_nix = control_dir(root) / "toolroot" / "bin" / "nix"
            toolroot_junest = control_dir(root) / "toolroot" / "bin" / "junest"
            # Stage0 can bootstrap a minimal toolroot (nix-portable + nix wrapper) without installing
            # the rest of the toolroot artifacts (notably junest). `dev shell` is a "kitchen sink"
            # environment and should ensure the full toolroot is present when online.
            if (not toolroot_nix.exists() or not toolroot_junest.exists()) and not _offline_enabled():
                try:
                    # Best-effort: keep this quiet; `refresh` already has explicit flags for verbosity/update.
                    refresh_toolroot(root, update=False, force=False)
                except ToolrootError as e:
                    # If the toolroot remains incomplete, dev shell can't satisfy its guarantees.
                    if not toolroot_nix.exists() or not toolroot_junest.exists():
                        toolroot_degraded_note = (
                            f"dev shell: continuing without full toolroot (bootstrap incomplete): {e}"
                        )

            nix = find_nix(root)

            flake_arg = getattr(args, "flake", None)
            flake_ref = resolve_flake_ref(root, (flake_arg.strip() if isinstance(flake_arg, str) and flake_arg.strip() else None))
            strict_sc = _truthy_env("SW_STRICT_SUPPLYCHAIN") or _truthy_env("SANDWORM_STRICT_SUPPLYCHAIN")
            if strict_sc and not nixpkgs_ref_is_pinned_enough(flake_ref):
                append_dev_shell_event(
                    root,
                    {
                        "event": "dev_shell",
                        "mode": "error",
                        "reason_code": "strict_supplychain_unpinned_flake",
                        "flake_ref": flake_ref,
                        "strict_supply_chain": True,
                    },
                )
                raise SystemExit(
                    "strict supply chain mode: dev shell requires a pinned nixpkgs flake ref "
                    "(run: `sandworm lock pin-nixpkgs` or `sandworm refresh --update`, or pass --flake tarball+... )"
                )

            cmd = list(getattr(args, "command", []) or [])
            if cmd and cmd[0] == "--":
                cmd = cmd[1:]
            if not cmd:
                cmd = ["bash"]

            expr_base = expr_base_for_flake(flake_ref)
            default_devshell_installables = default_installables()
            installables: list[str] = []
            if not bool(getattr(args, "no_default_packages", False)):
                installables.extend(default_devshell_installables)
            extra = getattr(args, "packages", None)
            if isinstance(extra, list):
                for raw in extra:
                    s = str(raw or "").strip()
                    if not s:
                        continue
                    if not attr_path_is_safe(s):
                        append_dev_shell_event(
                            root,
                            {
                                "event": "dev_shell",
                                "mode": "error",
                                "reason_code": "invalid_pkg_attr_path",
                                "flake_ref": flake_ref,
                                "pkg": s,
                            },
                        )
                        raise SystemExit(
                            f"dev shell: refusing unsafe --pkg value: {s!r} (expected an attribute path like git or python311Packages.tomlkit)"
                        )
                    installables.append(s)
            if not installables:
                # Ensure at least one package is present; nix shell without installables expects a flake.
                installables.append("bashInteractive")
            # Keep `swPython` first so `python3` resolves to the env variant with required modules
            # (tomlkit/pyyaml), not a transitive plain-python dependency from other installables.
            if "swPython" in installables:
                installables = ["swPython", *[x for x in installables if x != "swPython"]]

            argv2 = [nix, *nix_flags(), "shell", "--impure", "--expr", expr_base, *installables, "--command", *cmd]

            # Prefer a "Sandworm-ish" PATH inside the dev shell: include toolroot + client wrappers
            # so humans/LLMs can reach `junest`, provider CLIs, etc, without relying on host packages.
            env2 = build_shell_env(root)
            debug_enabled = _dev_shell_debug_enabled()

            fallback_allowed = bool(dev_shell_fallback_allowed(strict_supply_chain=bool(strict_sc)))

            base_event: dict[str, object] = {
                "event": "dev_shell",
                "flake_ref": flake_ref,
                "strict_supply_chain": bool(strict_sc),
                "installables": list(installables),
                "fallback_allowed": bool(fallback_allowed),
                "toolroot": {
                    "nix_exists": toolroot_nix.exists(),
                    "junest_exists": toolroot_junest.exists(),
                    "complete": bool(toolroot_nix.exists() and toolroot_junest.exists()),
                },
                "env": {
                    "SANDWORM_BACKEND": os.environ.get("SANDWORM_BACKEND") or "",
                    "SANDWORM_DEV_COCKPIT": os.environ.get("SANDWORM_DEV_COCKPIT") or "",
                    "SANDWORM_POSTURE": os.environ.get("SANDWORM_POSTURE") or "",
                },
            }

            if debug_enabled:
                dbg = dict(base_event)
                dbg["nix_path"] = nix
                dbg["cmd"] = list(cmd)
                dbg["toolroot_degraded_note"] = toolroot_degraded_note
                print(f"dev shell debug: {json.dumps(dbg, sort_keys=True)}", file=sys.stderr)

            def _ensure_login_profile(env_for_shell: dict[str, str]) -> None:
                """
                Keep PATH stable across nested login shells (`sh -lc`/`bash -lc`) by writing
                a minimal profile under the dev-shell HOME.
                """
                try:
                    home_s = str(env_for_shell.get("HOME") or "").strip()
                    if not home_s:
                        return
                    home_p = Path(home_s)
                    home_p.mkdir(parents=True, exist_ok=True)
                    profile_p = home_p / ".profile"
                    profile_body = (
                        "# sandworm dev-shell generated profile (path stability)\n"
                        'export PATH="${SANDWORM_DEV_SHELL_NIX_PATH:-$PATH}${SANDWORM_DEV_SHELL_PATH:+:${SANDWORM_DEV_SHELL_PATH}}"\n'
                    )
                    old = ""
                    if profile_p.exists():
                        try:
                            old = profile_p.read_text(encoding="utf-8")
                        except Exception:
                            old = ""
                    if old != profile_body:
                        profile_p.write_text(profile_body, encoding="utf-8")
                except Exception:
                    # Profile materialization is best-effort; never block dev-shell execution.
                    pass

            def _run_dev_shell_direct(reason: str, *, reason_code: str) -> int:
                fallback_cmd = list(cmd)
                if fallback_cmd and shutil.which(fallback_cmd[0], path=env2.get("PATH")) is None and fallback_cmd[0] == "bash":
                    fallback_cmd = ["sh", *fallback_cmd[1:]]
                fallback_path = str(env2.get("PATH") or "")
                if (
                    len(fallback_cmd) >= 3
                    and fallback_cmd[0] in ("sh", "bash")
                    and fallback_cmd[1] in ("-c", "-lc")
                ):
                    # Login shells (-lc) may reset PATH from profile scripts; force Sandworm's
                    # toolroot/clients PATH back in so fallback mode remains usable.
                    fallback_cmd[2] = 'PATH="${SANDWORM_DEV_SHELL_PATH:-$PATH}"; export PATH; ' + str(fallback_cmd[2])
                if (
                    len(fallback_cmd) >= 3
                    and fallback_cmd[0] == "sh"
                    and fallback_cmd[1] in ("-c", "-lc")
                    and "pipefail" in str(fallback_cmd[2])
                ):
                    bash_bin = shutil.which("bash", path=env2.get("PATH"))
                    if bash_bin:
                        fallback_cmd = [bash_bin, *fallback_cmd[1:]]
                env3 = dict(env2)
                env3["SANDWORM_DEV_SHELL_MODE"] = "fallback"
                env3["SANDWORM_DEV_SHELL_REASON_CODE"] = reason_code
                if fallback_path:
                    env3["SANDWORM_DEV_SHELL_PATH"] = fallback_path
                _ensure_login_profile(env3)
                print(reason, file=sys.stderr)
                print(
                    "dev shell: nix shell unavailable in this constrained DEV environment; falling back to direct command execution",
                    file=sys.stderr,
                )
                try:
                    rc = int(subprocess.run(fallback_cmd, env=env3).returncode)
                except FileNotFoundError as e:
                    missing = str(getattr(e, "filename", "") or "").strip() or "<unknown>"
                    print(
                        f"dev shell: fallback command not found on PATH: {missing} (set PATH or run inside a configured dev toolchain)",
                        file=sys.stderr,
                    )
                    ev = dict(base_event)
                    ev.update(
                        {
                            "mode": "fallback",
                            "reason_code": "fallback_command_missing",
                            "reason_text": reason,
                            "result_rc": 127,
                            "missing_tools": collect_missing_tools(env3, include_tomlkit=True),
                        }
                    )
                    append_dev_shell_event(root, ev)
                    return 127
                ev = dict(base_event)
                ev.update(
                    {
                        "mode": "fallback",
                        "reason_code": reason_code,
                        "reason_text": reason,
                        "result_rc": int(rc),
                        "missing_tools": collect_missing_tools(env3, include_tomlkit=True),
                    }
                )
                append_dev_shell_event(root, ev)
                return rc

            if not nix:
                if fallback_allowed:
                    return _run_dev_shell_direct(
                        toolroot_degraded_note or "dev shell: nix not found; using direct execution fallback",
                        reason_code="nix_missing",
                    )
                if _offline_enabled():
                    ev = dict(base_event)
                    ev.update({"mode": "error", "reason_code": "nix_missing_offline", "result_rc": 1})
                    append_dev_shell_event(root, ev)
                    raise SystemExit("dev: nix not found (offline mode enabled; run online or preinstall toolroot via `sandworm refresh`)")
                ev = dict(base_event)
                ev.update({"mode": "error", "reason_code": "nix_missing", "result_rc": 1})
                append_dev_shell_event(root, ev)
                raise SystemExit("dev: nix not found (run: sandworm refresh, or install nix)")

            preflight = [nix, *nix_flags(), "shell", "--impure", "--expr", expr_base, *installables, "--command", "sh", "-c", "true"]
            pre_err = ""
            pre_rc = 1
            preflight_timeout_s = 120
            preflight_timeout_raw = str(
                os.environ.get("SW_DEV_SHELL_PREFLIGHT_TIMEOUT_S")
                or os.environ.get("SANDWORM_DEV_SHELL_PREFLIGHT_TIMEOUT_S")
                or "120"
            ).strip()
            try:
                parsed_timeout = int(preflight_timeout_raw)
                if parsed_timeout > 0:
                    preflight_timeout_s = parsed_timeout
            except Exception:
                preflight_timeout_s = 120

            preflight_retry_timeout_s = max(180, int(preflight_timeout_s) * 2)
            preflight_retry_timeout_raw = str(
                os.environ.get("SW_DEV_SHELL_PREFLIGHT_RETRY_TIMEOUT_S")
                or os.environ.get("SANDWORM_DEV_SHELL_PREFLIGHT_RETRY_TIMEOUT_S")
                or str(preflight_retry_timeout_s)
            ).strip()
            try:
                parsed_retry_timeout = int(preflight_retry_timeout_raw)
                if parsed_retry_timeout > 0:
                    preflight_retry_timeout_s = parsed_retry_timeout
            except Exception:
                preflight_retry_timeout_s = max(180, int(preflight_timeout_s) * 2)

            def _run_preflight(timeout_s: int) -> tuple[int, str]:
                rc, pre_out, pre_stderr, _timed_out = run_with_timeout_killpg(
                    preflight,
                    env=env2,
                    timeout_s=max(1, int(timeout_s)),
                )
                err = (pre_stderr or "").strip()
                out = (pre_out or "").strip()
                if err and out:
                    msg = f"{err}\n{out}"
                else:
                    msg = err or out
                return int(rc), str(msg)
            try:
                pre_rc, pre_err = _run_preflight(preflight_timeout_s)
                if pre_rc == 124 and not _offline_enabled():
                    # First-run DEV bootstraps can exceed the initial preflight timeout.
                    # Try one bounded repair + re-probe pass before falling back.
                    try:
                        refresh_toolroot(root, update=False, force=False)
                    except ToolrootError:
                        pass
                    pre_rc2, pre_err2 = _run_preflight(preflight_retry_timeout_s)
                    if pre_rc2 == 0:
                        pre_rc = 0
                        pre_err = ""
                        preflight_timeout_s = preflight_retry_timeout_s
                    elif pre_err2:
                        pre_err = pre_err2
                if pre_rc == 0:
                    run_argv = list(argv2)
                    fallback_path = str(env2.get("PATH") or "")
                    nix_shell_path = ""
                    # `bash -lc` / `sh -lc` can reset PATH and drop nix-provided package bins.
                    # Capture the nix-shell PATH and re-export it explicitly for deterministic tool resolution.
                    try:
                        path_probe = [
                            nix,
                            *nix_flags(),
                            "shell",
                            "--impure",
                            "--expr",
                            expr_base,
                            *installables,
                            "--command",
                            "sh",
                            "-c",
                            'printf "%s" "$PATH"',
                        ]
                        path_rc, path_out, _path_err, _path_timed_out = run_with_timeout_killpg(
                            path_probe,
                            env=env2,
                            timeout_s=preflight_timeout_s,
                        )
                        if int(path_rc) == 0:
                            nix_shell_path = str(path_out or "").strip()
                    except Exception:
                        nix_shell_path = ""
                    # `nix shell --command sh -lc ...` can inherit a login-shell PATH that
                    # drops Sandworm toolroot/client bins in some environments. Keep the
                    # dev-shell contract stable by forcing the computed PATH back in.
                    if fallback_path:
                        try:
                            cmd_idx = run_argv.index("--command")
                        except ValueError:
                            cmd_idx = -1
                        if (
                            cmd_idx >= 0
                            and len(run_argv) >= (cmd_idx + 4)
                            and run_argv[cmd_idx + 1] in ("sh", "bash")
                            and run_argv[cmd_idx + 2] in ("-c", "-lc")
                        ):
                            run_argv[cmd_idx + 3] = (
                                'PATH="${SANDWORM_DEV_SHELL_NIX_PATH:-$PATH}${SANDWORM_DEV_SHELL_PATH:+:${SANDWORM_DEV_SHELL_PATH}}"; export PATH; '
                                + str(run_argv[cmd_idx + 3])
                            )
                    env_ok = dict(env2)
                    env_ok["SANDWORM_DEV_SHELL_MODE"] = "nix"
                    env_ok["SANDWORM_DEV_SHELL_REASON_CODE"] = "ok"
                    if fallback_path:
                        env_ok["SANDWORM_DEV_SHELL_PATH"] = fallback_path
                    if nix_shell_path:
                        env_ok["SANDWORM_DEV_SHELL_NIX_PATH"] = nix_shell_path
                    _ensure_login_profile(env_ok)
                    try:
                        rc = int(subprocess.run(run_argv, env=env_ok).returncode)
                    except FileNotFoundError as e:
                        missing = str(getattr(e, "filename", "") or "").strip() or "<unknown>"
                        print(
                            f"dev shell: nix command runner missing on PATH: {missing} (check shell/tooling availability)",
                            file=sys.stderr,
                        )
                        ev = dict(base_event)
                        ev.update(
                            {
                                "mode": "nix",
                                "reason_code": "nix_command_missing",
                                "preflight": {"rc": 0, "ok": True, "stderr": "", "timeout_s": int(preflight_timeout_s)},
                                "result_rc": 127,
                                "missing_tools": collect_missing_tools(env_ok, include_tomlkit=True),
                            }
                        )
                        append_dev_shell_event(root, ev)
                        return 127
                    ev = dict(base_event)
                    ev.update(
                        {
                            "mode": "nix",
                            "reason_code": "ok",
                            "preflight": {"rc": 0, "ok": True, "stderr": "", "timeout_s": int(preflight_timeout_s)},
                            "result_rc": int(rc),
                            "missing_tools": [],
                        }
                    )
                    append_dev_shell_event(root, ev)
                    return rc
            except Exception as e:
                pre_err = str(e)

            if pre_rc == 124 and not pre_err:
                pre_err = f"dev shell: nix shell preflight timed out after {int(preflight_timeout_s)}s"

            can_fallback = bool(fallback_allowed)
            reason_code = preflight_reason_code(rc=pre_rc, message=pre_err)
            runtime_likely_constrained = (
                looks_like_runtime_constraint(pre_err)
                or (not pre_err.strip())
                or reason_code in ("nix_preflight_timeout", "nix_preflight_runtime_constraint")
            )
            if not can_fallback or not runtime_likely_constrained:
                pre_err_text = (pre_err or "").strip()
                if pre_err_text:
                    print(pre_err_text, file=sys.stderr)
                else:
                    print(f"dev shell: nix shell preflight failed ({reason_code})", file=sys.stderr)
                posture_now = (os.environ.get("SANDWORM_POSTURE") or "").strip().lower()
                allow_in_dev = _dev_truthy_env("SW_DEV_SHELL_ALLOW_FALLBACK_IN_DEV") or _dev_truthy_env(
                    "SANDWORM_DEV_SHELL_ALLOW_FALLBACK_IN_DEV"
                )
                if posture_now == "dev" and reason_code == "nix_preflight_runtime_constraint" and not allow_in_dev:
                    print(
                        "dev shell: DEV posture requires online-capable runtime; fallback is disabled by policy",
                        file=sys.stderr,
                    )
                ev = dict(base_event)
                ev.update(
                    {
                        "mode": "error",
                        "reason_code": reason_code,
                        "preflight": {
                            "rc": int(pre_rc),
                            "ok": False,
                            "stderr": pre_err[:2000],
                            "timeout_s": int(preflight_timeout_s),
                        },
                        "result_rc": 1,
                        "missing_tools": collect_missing_tools(env2, include_tomlkit=True),
                    }
                )
                append_dev_shell_event(root, ev)
                return 1

            reason_parts: list[str] = []
            if toolroot_degraded_note:
                reason_parts.append(toolroot_degraded_note)
            if pre_err:
                reason_parts.append(pre_err)
            elif pre_rc != 0:
                reason_parts.append(f"dev shell: nix shell preflight failed (exit={pre_rc})")
            return _run_dev_shell_direct(
                "\n".join(reason_parts) or "dev shell: nix shell preflight failed",
                reason_code=reason_code,
            )

        if args.dev_cmd == "cockpit":
            from .toolroot import ToolrootError, refresh_toolroot, refresh_toolroot_wrappers

            ensure_control_plane(root)
            # Keep wrapper behavior current even when toolroot artifacts are already present.
            refresh_toolroot_wrappers(root)
            backend = str(getattr(args, "backend", "bwrap") or "bwrap").strip().lower()
            if backend not in ("bwrap", "kvm"):
                raise SystemExit(f"dev cockpit: invalid --backend: {backend!r} (expected bwrap|kvm)")

            # bwrap cockpit relies on host-side toolroot bootstrapping (nix-portable + wrappers).
            if backend == "bwrap":
                toolroot_nix = control_dir(root) / "toolroot" / "bin" / "nix"
                if not toolroot_nix.exists() and not _offline_enabled():
                    try:
                        refresh_toolroot(root, update=False, force=False)
                    except ToolrootError as e:
                        raise SystemExit(f"dev cockpit: toolroot bootstrap failed: {e}")

            shares: list[tuple[str, str, str]] = []
            if not bool(getattr(args, "no_shares", False)):
                try:
                    from .shares import load_shares_checked

                    loaded, share_errors = load_shares_checked(root)
                    for s in loaded:
                        shares.append((s.name, s.src, s.mode))
                    for msg in share_errors:
                        print(f"WARNING: share ignored: {msg} (see: sandworm share list)", file=sys.stderr)
                except Exception as e:
                    raise SystemExit(f"invalid shares configuration: {e}")

            cmd_argv = list(getattr(args, "command", []) or [])
            if cmd_argv[:1] == ["--"]:
                cmd_argv = cmd_argv[1:]
            if not cmd_argv:
                cmd_argv = ["sh"]

            posture = str(getattr(args, "posture", "safe") or "safe")

            # Interactive if no explicit command was provided (same convention as `sandworm shell`).
            interactive = (getattr(args, "command", None) == [] or getattr(args, "command", None) == ["--"])
            if backend == "kvm":
                if posture != "safe":
                    raise SystemExit("dev cockpit --backend kvm only supports --posture safe")
                from .creds import ensure_sandworm_home
                from .kvm import kvm_shell_in_dir, kvm_up

                # Ensure the guest is up (best-effort). We do not fetch/build images here.
                timeout_s = int(getattr(args, "kvm_timeout_s", 240) or 240)
                if timeout_s < 1:
                    timeout_s = 1
                if timeout_s > 600:
                    timeout_s = 600
                inst = getattr(args, "kvm_instance", None)
                kvm_up(
                    root,
                    instance=inst,
                    build_image=False,
                    timeout_s=timeout_s,
                    expose_private=False,
                    shares=(shares if shares else None),
                    reconfigure=True,
                )

                # KVM DEV (Option B): keep /workspace/.sandworm masked; use a dedicated state root under /run/sandworm/home.
                home_dir = ensure_sandworm_home(root)
                dev_root_host = (home_dir / "devroot").resolve()
                try:
                    dev_root_host.mkdir(parents=True, exist_ok=True)
                except Exception:
                    pass
                ensure_control_plane(dev_root_host)

                env2 = {
                    "SANDWORM_DEV_COCKPIT": "1",
                    "SANDWORM_DEV_ROOT": "/run/sandworm/home/devroot",
                    "SANDWORM_STATE_ROOT": "/run/sandworm/home/devroot/.sandworm",
                }
                # Start the host-side DEV runner and make it reachable from inside the guest.
                try:
                    from .dev_runner import runner_start_daemon

                    runner_cfg = runner_start_daemon(root, host="127.0.0.1", port=None, kvm_instance_for_token=inst)
                    env2["SANDWORM_DEV_RUNNER_ADDR"] = f"10.0.2.2:{int(runner_cfg.port)}"
                    env2["SANDWORM_DEV_RUNNER_TOKEN_FILE"] = "/run/sandworm/keys/dev-runner.token"
                except Exception as e:
                    # Keep cockpit usable even if the runner couldn't start.
                    env2["SANDWORM_DEV_RUNNER_ERROR"] = repr(e)
                return int(
                    kvm_shell_in_dir(
                        root,
                        cmd_argv,
                        instance=inst,
                        workdir=str(getattr(args, "cwd", "/workspace")),
                        env=env2,
                    )
                )

            from .bwrap_backend import run_bwrap, run_bwrap_attached

