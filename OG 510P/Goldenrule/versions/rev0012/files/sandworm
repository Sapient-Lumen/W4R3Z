    if _truthy_env("SW_BWRAP_PROBE_VIA_NIX", "SANDWORM_BWRAP_PROBE_VIA_NIX"):
        b = _ensure_bwrap_via_nix(root)
        if b and _bwrap_usable(b):
            return BwrapCaps(path=b, sourced_from="nix")
    return None



