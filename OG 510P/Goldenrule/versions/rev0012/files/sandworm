      if _sw_writable_dir "$ROOT/.sandworm/home"; then
        printf '%s' "$ROOT/.sandworm/home"
        return 0
      fi
      ;;
  esac

  if [ -n "${HOME:-}" ] && _sw_writable_dir "${HOME}"; then
    printf '%s' "${HOME}"
    return 0
  fi

  if _sw_writable_dir "/run/sandworm/home"; then
    printf '%s' "/run/sandworm/home"
    return 0
  fi

  if _sw_writable_dir "/tmp/.sandworm-home"; then
    printf '%s' "/tmp/.sandworm-home"
    return 0
  fi

  printf '%s' "/tmp"
}

HOME="$(_sw_pick_home)"
export HOME
"""


def _claude_wrapper_script(*, nix: str, node_attr: str, bin_name: str) -> str:
    return f"""#!/bin/sh
set -eu

SCRIPT="$0"
case "$SCRIPT" in
  */*) SCRIPT_DIR="${{SCRIPT%/*}}" ;;
  *) SCRIPT_DIR="." ;;
esac
CLIENTS_DIR="$(cd "$SCRIPT_DIR/.." && pwd -P)"

{_wrapper_home_selection_snippet()}
export XDG_CONFIG_HOME="${{XDG_CONFIG_HOME:-$HOME/.config}}"
export XDG_DATA_HOME="${{XDG_DATA_HOME:-$HOME/.local/share}}"
export XDG_CACHE_HOME="${{XDG_CACHE_HOME:-$HOME/.cache}}"

# Prefer the official installer/binary inside the default podman sandbox lane.
# - The installer writes into $HOME (Sandworm-managed), so it's disposable under --root.
# - Outside podman, keep the npm fallback for maximum portability across hosts.
if [ "${{SANDWORM_BACKEND:-}}" = "podman" ]; then
  OFFICIAL_BIN="$HOME/.local/bin/claude"
  OFFICIAL_META_DIR="$HOME/.sandworm/claude-official"
  OFFICIAL_TARGET_FILE="$OFFICIAL_META_DIR/target"
  OFFICIAL_REFRESH_FILE="$OFFICIAL_META_DIR/last_refresh_epoch"
  target="${{SANDWORM_CLAUDE_INSTALL_TARGET:-latest}}"
  refresh_s="${{SANDWORM_CLAUDE_INSTALL_REFRESH_S:-86400}}"
  autoupdate="${{SW_CLAUDE_AUTOUPDATE:-${{SANDWORM_CLAUDE_AUTOUPDATE:-1}}}}"
  installer_url="${{SANDWORM_CLAUDE_INSTALLER_URL:-https://claude.ai/install.sh}}"
  require_official="${{SANDWORM_CLAUDE_REQUIRE_OFFICIAL:-0}}"
  need_install=0
  autoupdate_enabled=1

  case "$refresh_s" in
    ''|*[!0-9]*) refresh_s=86400 ;;
  esac
  case "${{autoupdate}}" in
    0|false|FALSE|False|off|OFF|Off|no|NO|No|n|N)
      autoupdate_enabled=0
      ;;
  esac

  if [ ! -x "$OFFICIAL_BIN" ]; then
    need_install=1
  fi

  prev_target=""
  if [ -r "$OFFICIAL_TARGET_FILE" ]; then
    prev_target="$(cat "$OFFICIAL_TARGET_FILE" 2>/dev/null || true)"
  fi
  if [ "$prev_target" != "$target" ]; then
    need_install=1
  fi

  # Keep `latest` actually current by re-running installer on a cadence.
  if [ "$target" = "latest" ] && [ "$need_install" -eq 0 ] && [ "$autoupdate_enabled" -eq 1 ]; then
    if [ "$refresh_s" -eq 0 ]; then
      need_install=1
    else
      now_epoch="$(date +%s 2>/dev/null || true)"
      last_epoch=""
      if [ -r "$OFFICIAL_REFRESH_FILE" ]; then
        last_epoch="$(cat "$OFFICIAL_REFRESH_FILE" 2>/dev/null || true)"
      fi
      case "$now_epoch:$last_epoch" in
        ''|:*|*:|*[!0-9:]*)
          ;;
        *)
          age=$((now_epoch-last_epoch))
          if [ "$age" -lt 0 ] || [ "$age" -ge "$refresh_s" ]; then
            need_install=1
          fi
          ;;
      esac
    fi
  fi

  if [ "$need_install" -eq 1 ]; then
    mkdir -p "$(dirname "$OFFICIAL_BIN")" "$OFFICIAL_META_DIR" >/dev/null 2>&1 || true
    # Avoid `curl|bash` / `wget|bash`: download to a temp file first, then run it.
    tmp_inst=""
    if command -v mktemp >/dev/null 2>&1; then
      tmp_inst="$(mktemp "${{TMPDIR:-/tmp}}/sandworm-claude-install.XXXXXX" 2>/dev/null || mktemp "/tmp/sandworm-claude-install.XXXXXX" 2>/dev/null || true)"
    fi
    if [ -z "$tmp_inst" ]; then
      tmp_inst="${{TMPDIR:-/tmp}}/sandworm-claude-install.$$"
      : >"$tmp_inst" 2>/dev/null || tmp_inst="/tmp/sandworm-claude-install.$$"
    fi
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL "$installer_url" -o "$tmp_inst" >/dev/null 2>&1 || true
    elif command -v wget >/dev/null 2>&1; then
      wget -q -O "$tmp_inst" "$installer_url" >/dev/null 2>&1 || true
    fi
    if [ -s "$tmp_inst" ]; then
      if bash -s "$target" <"$tmp_inst" >/dev/null 2>&1; then
        printf '%s\n' "$target" >"$OFFICIAL_TARGET_FILE" 2>/dev/null || true
        now_epoch="$(date +%s 2>/dev/null || true)"
        case "$now_epoch" in
          ''|*[!0-9]*) ;;
          *) printf '%s\n' "$now_epoch" >"$OFFICIAL_REFRESH_FILE" 2>/dev/null || true ;;
        esac
      fi
    fi
    rm -f "$tmp_inst" >/dev/null 2>&1 || true
    # The upstream installer runs with HOME=/run/sandworm/home in sandboxes, which can create
    # an absolute symlink target that is invalid on the host path (<root>/.sandworm/home).
    # Rewrite it to a relative link so the installed launcher is portable across backends.
    if [ -L "$OFFICIAL_BIN" ] && command -v readlink >/dev/null 2>&1; then
      t="$(readlink "$OFFICIAL_BIN" 2>/dev/null || true)"
      case "$t" in
        "$HOME/.local/share/"*)
          prefix="$HOME/.local/share/"
          rel="../share/${{t#$prefix}}"
          ln -sf "$rel" "$OFFICIAL_BIN" >/dev/null 2>&1 || true
          ;;
        "/run/sandworm/home/.local/share/"*)
          prefix="/run/sandworm/home/.local/share/"
          rel="../share/${{t#$prefix}}"
          ln -sf "$rel" "$OFFICIAL_BIN" >/dev/null 2>&1 || true
          ;;
      esac
    fi
  fi

  if [ -x "$OFFICIAL_BIN" ]; then
    exec "$OFFICIAL_BIN" "$@"
  fi
  if [ "$require_official" = "1" ]; then
    echo "ERROR: claude official installer lane required but launcher is missing: $OFFICIAL_BIN" >&2
    exit 86
  fi
fi

# Fallback: run the npm-provided claude CLI under node (via nix when needed).
BIN="$CLIENTS_DIR/npm/node_modules/.bin/{bin_name}"
[ -x "$BIN" ] || {{ echo "ERROR: missing installed client bin: $BIN" >&2; exit 127; }}

# Prefer a direct node exec when available (common in podman sandboxes).
if [ -x /usr/local/bin/node ]; then
  exec /usr/local/bin/node "$BIN" "$@"
fi
if [ -x /usr/bin/node ]; then
  exec /usr/bin/node "$BIN" "$@"
fi
if command -v node >/dev/null 2>&1; then
  exec node "$BIN" "$@"
fi
if [ -n "${{SANDWORM_TOOLROOT_BIN:-}}" ] && [ -x "${{SANDWORM_TOOLROOT_BIN}}/node" ]; then
  PATH="${{SANDWORM_TOOLROOT_BIN}}:$PATH"
  exec node "$BIN" "$@"
fi
if [ -x /run/sandworm/toolroot/bin/node ]; then
  PATH="/run/sandworm/toolroot/bin:$PATH"
  exec node "$BIN" "$@"
fi

NIX_DEFAULT={str(nix)!r}
if [ -n "${{SANDWORM_NIX:-}}" ] && [ -x "${{SANDWORM_NIX}}" ]; then
  NIX="${{SANDWORM_NIX}}"
elif [ -x "$NIX_DEFAULT" ]; then
  NIX="$NIX_DEFAULT"
elif command -v nix >/dev/null 2>&1; then
  NIX="$(command -v nix)"
else
  echo "ERROR: nix not found (needed to run {bin_name})" >&2
  exit 127
fi

exec "$NIX" --extra-experimental-features 'nix-command flakes' shell {node_attr} --command node "$BIN" "$@"
"""




