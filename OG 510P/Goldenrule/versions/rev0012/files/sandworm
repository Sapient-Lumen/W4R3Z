def _run_host_exec(
    ctx: RunContext,
    step_id: str,
    argv: list[str],
    *,
    cwd: Path,
    timeout_s: int | None,
    capture: str,
    posture: str,
) -> int:
    # Best-effort: in host-capable postures, try to ensure hostd is available so host actions are auditable.
    if posture in ("unsafe", "take-the-wheel"):
        try:
            from .hostd_ctl import hostd_start

            hostd_start(ctx.root)
        except Exception as e:
            ctx.warn(f"hostd start failed; host actions may fall back to direct exec: {e!r}")
    rc, meta = host_exec(
        ctx.root,
        argv,
        cwd=cwd,
        timeout_s=timeout_s,
        capture=capture,
        run_dir=ctx.run_dir,
        tag=f"queue:{step_id}",
        trace_id=ctx.trace_id,
    )
    # If hostd captured stdout/stderr into control-plane paths, also mirror into the run dir for portability.
    if meta.get("transport") == "hostd":
        stdout_path = meta.get("stdout_path")
        stderr_path = meta.get("stderr_path")
        if isinstance(stdout_path, str) and isinstance(stderr_path, str):
            try:
                stdout = (ctx.root / stdout_path).read_text(encoding="utf-8")
                stderr = (ctx.root / stderr_path).read_text(encoding="utf-8")
                outp, errp = _write_exec_logs(ctx, step_id, "host.exec", stdout, stderr)
                meta["stdout_path"] = outp
                meta["stderr_path"] = errp
            except Exception:
                pass
    warn = meta.get("warning")
    if isinstance(warn, str) and warn.strip():
        ctx.warn(warn.strip())
    ctx.event("host_exec", meta, step=step_id)
    return rc


