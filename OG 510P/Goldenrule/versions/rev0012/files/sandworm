from __future__ import annotations

import hashlib
import os
from pathlib import Path
from typing import Any


def describe_root(root: Path) -> dict[str, Any]:
    """
    Return a stable root identity descriptor for diagnostics and resume guards.

    Identity prefers device/inode when available so alias paths resolve to one
    workspace identity. If stat metadata is unavailable, fall back to canonical path.
    """
    root = root.resolve()
    canonical = str(root)

    requested = os.environ.get("SANDWORM_ROOT_REQUESTED") or None
    selection = os.environ.get("SANDWORM_ROOT_SELECTION") or None
    selection_reason = os.environ.get("SANDWORM_ROOT_SELECTION_REASON") or None

    dev: int | None = None
    ino: int | None = None
    identity_source = "canonical_path"
    identity_material = canonical

    try:
        st = root.stat()
        dev = int(st.st_dev)
        ino = int(st.st_ino)
        identity_source = "dev_inode"
        identity_material = f"{dev}:{ino}"
    except Exception:
        pass

    identity = hashlib.sha256(identity_material.encode("utf-8", errors="replace")).hexdigest()

    requested_resolved: str | None = None
    requested_matches = None
    if isinstance(requested, str) and requested.strip():
        try:
            rp = Path(requested.strip())
            if not rp.is_absolute():
                rp = (Path.cwd() / rp).resolve()
            else:
                rp = rp.resolve()
            requested_resolved = str(rp)
            requested_matches = bool(requested_resolved == canonical)
        except Exception:
            requested_resolved = None
            requested_matches = None

    return {
        "canonical_path": canonical,
        "identity": identity,
        "identity_source": identity_source,
        "device": dev,
        "inode": ino,
        "requested_path": requested,
        "requested_path_resolved": requested_resolved,
        "requested_matches_canonical": requested_matches,
        "selection": selection,
        "selection_reason": selection_reason,
    }

