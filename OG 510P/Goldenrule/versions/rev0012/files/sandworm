def runbook_md() -> str:
    lines: list[str] = []
    lines.append("# Sandworm runbook (built-in)")
    lines.append("")
    for s in runbook_sections():
        lines.append(f"## {s.title}")
        lines.append("")
        lines.append(s.md.rstrip())
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"

def _filter_sections(topic: str) -> tuple[str, list[RunbookSection]]:
    t = (topic or "").strip().lower()
    if not t:
        return "", list(runbook_sections())

    aliases = {
        "provider": "providers",
        "providers-real": "real providers",
        "real-providers": "real providers",
        "real": "real providers",
        "hook": "hooks",
        "recipe": "recipes",
    }
    t = aliases.get(t, t)

    # Split on punctuation/whitespace and require every token to appear.
    # This makes topics like "real-providers" match "Real provider tests".
    tokens = [x for x in re.split(r"[^a-z0-9]+", t) if x]
    out: list[RunbookSection] = []
    for s in runbook_sections():
        blob = (s.title + "\n" + s.md).lower()
        if tokens and not all(tok in blob for tok in tokens):
            continue
        out.append(s)
    return t, out


def runbook_md_filtered(topic: str) -> str:
    """
    Render the runbook, but include only sections whose title/content matches the topic.

    This keeps the singlefile as the source of truth while giving humans/LLMs smaller chunks.
    """
    _t, secs = _filter_sections(topic)
    parts: list[str] = []
    parts.append("# Sandworm runbook (built-in)")
    parts.append("")
    parts.append(f"## Topic: {topic}")
    parts.append("")

    matched = False
    for s in secs:
        matched = True
        parts.append(f"## {s.title}")
        parts.append("")
        parts.append(s.md.rstrip())
        parts.append("")

    if not matched:
        parts.append(f"(No matching sections for topic: {topic!r})")
        parts.append("")
        parts.append("Try: queue, queuer, recipes, hooks, real providers, posture, kvm, shares, strict, hostdeps")
        parts.append("")

    return "\n".join(parts).rstrip() + "\n"

