def _sha256_file(path: Path) -> str | None:
    try:
        h = hashlib.sha256()
        with path.open("rb") as f:
            while True:
                chunk = f.read(65536)
                if not chunk:
                    break
                h.update(chunk)
        return h.hexdigest()
    except Exception:
        return None


def _toolroot_wrapper_drift(root: Path) -> dict[str, object]:
    """
    Compare runtime wrapper files (`/run/sandworm/toolroot/bin`) with the
    control-plane wrappers (`<root>/.sandworm/toolroot/bin`).
    """
    runtime_bin = Path("/run/sandworm/toolroot/bin")
    control_bin = control_dir(root) / "toolroot" / "bin"
    names = ("rg", "jq", "nix", "nix-shell", "apt", "junest")
    drifted: list[str] = []
    compared = 0
    for name in names:
        rp = runtime_bin / name
        cp = control_bin / name
        if not (rp.exists() and cp.exists() and rp.is_file() and cp.is_file()):
            continue
        compared += 1
        rh = _sha256_file(rp)
        ch = _sha256_file(cp)
        if not rh or not ch:
            continue
        if rh != ch:
            drifted.append(name)
    return {
        "runtime_bin": str(runtime_bin),
        "control_bin": str(control_bin),
        "compared": compared,
        "drifted": drifted,
        "ok": (len(drifted) == 0),
    }


def _observe_control_plane() -> dict[str, object]:
    cp = Path("/workspace/.sandworm")
    mount_masked_local = False
    try:
        mi = Path("/proc/self/mountinfo")
        if mi.exists():
            for line in mi.read_text(encoding="utf-8", errors="replace").splitlines():
                if " - " not in line:
                    continue
                pre, _post = line.split(" - ", 1)
                fields = pre.split()
                if len(fields) < 5:
                    continue
                if fields[4] != "/workspace/.sandworm":
                    continue
                mount_root = fields[3]
                if "/.sandworm/tmp/podman-mask/" in mount_root or "/.sandworm/mask-empty" in mount_root:
                    mount_masked_local = True
                break
    except Exception:
        mount_masked_local = False
    try:
        if not cp.exists():
            return {"observed": "absent", "entries": []}
        if not cp.is_dir():
            return {"observed": "non-directory", "entries": []}
        entries = sorted({p.name for p in cp.iterdir() if p.name not in (".", "..")})
        non_private = [n for n in entries if n != "private"]
        if not entries:
            observed = "empty"
        elif not non_private:
            observed = "private-only"
        else:
            observed = "populated"
        if observed == "populated" and mount_masked_local:
            observed = "masked-local"
        return {"observed": observed, "entries": entries}
    except Exception:
        return {"observed": "unknown", "entries": []}


