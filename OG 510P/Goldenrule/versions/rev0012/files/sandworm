def _parse_kvm_env(args: argparse.Namespace, *, command_name: str) -> dict[str, str]:
    env: dict[str, str] = {}
    for raw in getattr(args, "env", []) or []:
        if not isinstance(raw, str):
            continue
        if "=" not in raw:
            raise SystemExit(f"sandworm kvm {command_name}: invalid --env (expected KEY=VALUE): {raw!r}")
        k, v = raw.split("=", 1)
        k = k.strip()
        if not k:
            raise SystemExit(f"sandworm kvm {command_name}: invalid --env key: {raw!r}")
        env[k] = v
    return env


