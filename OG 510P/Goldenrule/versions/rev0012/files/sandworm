    files: list[_PayloadFile] = []
    total_bytes = 0

    files.append(_PayloadFile(rel="sandworm", mode=0o755, text=sw_text))
    total_bytes += len(sw_text.encode("utf-8"))

    for p in sorted(core_pkg.rglob("*")):
        rel = p.relative_to(core_dir).as_posix()
        if _should_skip_payload_path(rel):
            continue
        if p.is_symlink():
            raise SinglefileError(f"refusing to embed symlink in singlefile payload: {rel}")
        if p.is_dir():
