def format_doctor_human(report: dict) -> str:
    caps = report.get("caps", {})
    lines = []
    lines.append(f"workspace: {report.get('workspace_root')}")
    rt = report.get("runtime") if isinstance(report.get("runtime"), dict) else {}
    if isinstance(rt, dict) and rt:
        lines.append("runtime:")
        lines.append(f"  - singlefile: {'yes' if rt.get('singlefile') else 'no'}")
        if rt.get("payload_sha256"):
            lines.append(f"  - payload_sha256: {rt.get('payload_sha256')}")
        if rt.get("payload_format"):
            lines.append(f"  - payload_format: {rt.get('payload_format')}")
        if rt.get("payload_file_count") is not None:
            lines.append(f"  - payload_file_count: {rt.get('payload_file_count')}")
        if rt.get("workspace_core_requested"):
            lines.append("  - workspace_core_requested: yes")
    st = report.get("state_root") or {}
    if isinstance(st, dict):
        sel = st.get("selected")
        if sel:
            lines.append(f"state_root: {sel}")
        if st.get("readonly"):
            lines.append("state_root: readonly")
    session = report.get("session")
    tty = session.get("tty") if isinstance(session, dict) and isinstance(session.get("tty"), dict) else {}
    if isinstance(tty, dict) and tty:
        lines.append("tty:")
        lines.append(f"  - stdin_tty: {'yes' if tty.get('stdin_tty') else 'no'}")
        lines.append(f"  - stdout_tty: {'yes' if tty.get('stdout_tty') else 'no'}")
        lines.append(f"  - provider_tty_mode: {tty.get('provider_tty_mode')}")
        if tty.get("script_bin"):
            lines.append(f"  - script_bin: {tty.get('script_bin')}")
    cp = report.get("control_plane")
    if isinstance(cp, dict) and cp:
        lines.append("control_plane:")
        lines.append(f"  - observed: {cp.get('observed')}")
        lines.append(f"  - nested_runtime: {'yes' if cp.get('nested_runtime') else 'no'}")
    versions = report.get("versions") or {}
    if isinstance(versions, dict):
        pv = versions.get("podman")
        nv = versions.get("nix")
        if pv or nv:
            lines.append("versions:")
            if pv:
                lines.append(f"  - podman: {pv}")
            if nv:
                lines.append(f"  - nix: {nv}")
    lines.append("caps:")
    for k in sorted(caps.keys()):
        lines.append(f"  - {k}: {'yes' if caps[k] else 'no'}")
    checks = report.get("checks") or []
    if isinstance(checks, list) and checks:
        bad = [c for c in checks if isinstance(c, dict) and not c.get("ok")]
        if bad:
            lines.append("checks:")
            for c in bad[:5]:
                lines.append(f"  - {c.get('name')}: {c.get('severity')} ({c.get('hint')})")
    dev_shell = report.get("dev_shell")
    if isinstance(dev_shell, dict):
        lines.append("dev shell:")
        lines.append(f"  - mode: {dev_shell.get('mode')}")
        lines.append(f"  - reason_code: {dev_shell.get('reason_code')}")
        pre = dev_shell.get("preflight")
        if isinstance(pre, dict):
            lines.append(f"  - preflight_ok: {'yes' if pre.get('ok') else 'no'}")
            lines.append(f"  - preflight_rc: {pre.get('rc')}")
        miss = dev_shell.get("missing_tools")
        if isinstance(miss, list) and miss:
            lines.append(f"  - missing_tools: {', '.join(str(x) for x in miss)}")
    clients = report.get("clients")
    if isinstance(clients, dict):
        pins = clients.get("pins")
        missing = pins.get("missing") if isinstance(pins, dict) else None
        mismatches = pins.get("mismatches") if isinstance(pins, dict) else None
        missing = missing if isinstance(missing, list) else []
        mismatches = mismatches if isinstance(mismatches, list) else []
        if missing or mismatches:
            lines.append("clients:")
            if missing:
                lines.append(f"  - pinned missing: {', '.join(sorted(set(map(str, missing))))}")
            if mismatches:
                lines.append(f"  - pinned mismatched: {', '.join(sorted(set(map(str, mismatches))))}")
            lines.append("  - tip: sandworm clients install --locked --all")
    hd = report.get("host_deps")
    if isinstance(hd, dict):
        miss = hd.get("missing")
        if isinstance(miss, list):
            if miss:
                lines.append(f"host deps: missing {', '.join(str(x) for x in miss)}")
                lines.append("  - tip: sandworm hostdeps plan")
            else:
                lines.append("host deps: all required tools detected")
    sc = report.get("supply_chain")
    if isinstance(sc, dict):
        lines.append("supply chain:")
        lines.append(f"  - strict_supply_chain: {'yes' if sc.get('strict_supply_chain') else 'no'}")
        lines.append(f"  - strict_hostd: {'yes' if sc.get('strict_hostd') else 'no'}")
        lines.append(f"  - allow_oci_pull: {'yes' if sc.get('allow_oci_pull') else 'no'}")
        lock = sc.get("lockfile")
        if isinstance(lock, dict):
            lines.append(f"  - lockfile: {lock.get('path')} ({'present' if lock.get('present') else 'missing'})")
        imgs = sc.get("images")
        if isinstance(imgs, dict) and imgs:
            lines.append(f"  - images.podman_default: {imgs.get('podman_default')}")
            lines.append(f"  - images.providers_sandbox_default: {imgs.get('providers_sandbox_default')}")
        nix = sc.get("nix")
        if isinstance(nix, dict) and nix:
            lines.append(f"  - nix.nixpkgs_flake: {nix.get('nixpkgs_flake')}")
            lines.append(f"  - nix.nixpkgs_flake_fallback: {nix.get('nixpkgs_flake_fallback')}")
    for n in report.get("notes", []):
        lines.append(f"note: {n}")
    return "\n".join(lines)
