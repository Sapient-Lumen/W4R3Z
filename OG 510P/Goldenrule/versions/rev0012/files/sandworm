    """
    Return a best-effort argv prefix that can invoke "this sandworm".

    In some executions (notably `python -m sandworm_core`), sys.argv[0] is a non-executable
    module path. In that case, fall back to `sys.executable -m sandworm_core` while preserving
    the current PYTHONPATH / embedded-core hints via env.
    """
    argv0 = str(sys.argv[0] or "").strip()
    if argv0:
        try:
