# Sandworm scripts are bash, but some sandboxes break /usr/bin/env.
# Re-exec this script under a real bash and ensure `bash` is on PATH.
_sw_is_bash=0
if [ -n "${{BASH-}}" ] && [ -n "${{BASH_VERSION-}}" ] &&    (eval 'type shopt >/dev/null 2>&1; __sw_probe=(ok); [[ "$__sw_probe" == "ok" ]]') >/dev/null 2>&1; then
  _sw_is_bash=1
fi
if [ "$_sw_is_bash" != "1" ]; then
  _sw_is_real_bash_bin() {{
    [ -n "$1" ] || return 1
    [ -x "$1" ] || return 1
    "$1" -lc 'test -n "$BASH" && test -n "$BASH_VERSION" && type shopt >/dev/null 2>&1 && a=(ok) && [[ "$a" == "ok" ]]' >/dev/null 2>&1
  }}
  # If `bash` is already on PATH, do not widen PATH. This preserves "stage0" scenarios
  # where callers intentionally constrain PATH to prove Sandworm can bootstrap without host tools.
  _sw_path_bash="$(command -v bash 2>/dev/null || true)"
  if [ -n "${{_sw_path_bash:-}}" ] && _sw_is_real_bash_bin "${{_sw_path_bash}}"; then
    case "$_sw_path_bash" in
      # /run/sandworm/clients/bin/bash is a lightweight compatibility shim that may
      # fall back to /bin/sh. Using it as the "real bash" re-exec target can recurse.
      /run/sandworm/clients/bin/bash|*/.sandworm/clients/bin/bash)
        ;;
      *)
        exec "$_sw_path_bash" "$0" "$@"
        ;;
    esac
  fi
  if [ -n "${{SANDWORM_BASH-}}" ] && _sw_is_real_bash_bin "${{SANDWORM_BASH}}"; then
    _sw_bash="${{SANDWORM_BASH}}"
    _sw_bash_dir="${{_sw_bash%/*}}"
    PATH="$_sw_bash_dir${{PATH:+:$PATH}}"; export PATH
    exec "$_sw_bash" "$0" "$@"
  fi
  for _sw_bash in /run/current-system/sw/bin/bash /usr/bin/bash /bin/bash /usr/local/bin/bash; do
    if _sw_is_real_bash_bin "$_sw_bash"; then
      _sw_bash_dir="${{_sw_bash%/*}}"
      PATH="$_sw_bash_dir${{PATH:+:$PATH}}"; export PATH
      exec "$_sw_bash" "$0" "$@"
    fi
  done
  for _sw_bash in /nix/store/*bash*/bin/bash; do
    if _sw_is_real_bash_bin "$_sw_bash"; then
      _sw_bash_dir="${{_sw_bash%/*}}"
      PATH="$_sw_bash_dir${{PATH:+:$PATH}}"; export PATH
      exec "$_sw_bash" "$0" "$@"
    fi
  done
  echo "ERROR: bash not found (set SANDWORM_BASH=/path/to/bash)" >&2
  exit 127
fi
set -euo pipefail

# Prefer host/core image userland over toolroot busybox applets for loader-critical IO.
# Some busybox-static builds have false-success behavior on bind-mounted paths.
# Preserve intentionally constrained PATH in forced stage0 verification mode (and when explicitly requested).
_sw_skip_loader_path_normalize=0
if [[ "${{SW_SINGLEFILE_PRESERVE_PATH:-${{SANDWORM_SINGLEFILE_PRESERVE_PATH:-0}}}}" == "1" ]]; then
  _sw_skip_loader_path_normalize=1
elif [[ "${{SW_FORCE_STAGE0:-0}}" == "1" ]]; then
  _sw_prev_arg=""
  for _sw_arg in "$@"; do
    if [[ "$_sw_prev_arg" == "bootstrap" && "$_sw_arg" == "verify" ]]; then
      _sw_skip_loader_path_normalize=1
      break
    fi
    _sw_prev_arg="$_sw_arg"
  done
fi
if [[ "${{_sw_skip_loader_path_normalize}}" != "1" ]]; then
  # On NixOS, /run/current-system/sw/bin avoids envfs-backed /usr/bin and /bin.
  if [[ -d /run/current-system/sw/bin ]]; then
    PATH="/run/current-system/sw/bin${{PATH:+:$PATH}}"
    export PATH
  elif [[ -d /usr/bin ]]; then
    PATH="/usr/bin:/bin${{PATH:+:$PATH}}"
    export PATH
  fi
fi


PAYLOAD_SHA256="{payload_sha256}"
PAYLOAD_BYTES="{int(payload_bytes)}"
PAYLOAD_FILE_COUNT="{int(payload_file_count)}"
PAYLOAD_EXT="tar"
PAYLOAD_FORMAT="{payload_format}"
export SANDWORM_SINGLEFILE_PAYLOAD_SHA256="$PAYLOAD_SHA256"
export SANDWORM_SINGLEFILE_PAYLOAD_BYTES="$PAYLOAD_BYTES"
export SANDWORM_SINGLEFILE_PAYLOAD_FILE_COUNT="$PAYLOAD_FILE_COUNT"
export SANDWORM_SINGLEFILE_PAYLOAD_FORMAT="$PAYLOAD_FORMAT"

_sw_err() {{ echo "ERROR: $*" >&2; }}
_sw_note() {{ echo "[sandworm] $*" >&2; }}
_sw_progress_enabled() {{
  if [[ -n "${{SW_BOOTSTRAP_PROGRESS:-}}" ]]; then
    case "${{SW_BOOTSTRAP_PROGRESS:-}}" in
      1|true|yes|on) return 0 ;;
      *) return 1 ;;
    esac
  fi
  [[ -t 2 ]]
}}
_sw_wants_help() {{
  # Global help is instant (no python/nix bootstrap). Only treat -h/--help as "global"
  # when no subcommand is present. If a subcommand is present (e.g. `sandworm codex --help`),
  # let the real CLI handle it so subcommand help is discoverable.
  local -a argv=("$@")
  local i=0
  local saw_help=0
  while [[ "$i" -lt "${{#argv[@]}}" ]]; do
    local a="${{argv[$i]}}"
    if [[ "$a" == "--" ]]; then
      break
    fi
    if [[ "$a" == "--root" ]]; then
      i=$((i + 2))
      continue
    fi
    if [[ "$a" == "--root="* ]]; then
      i=$((i + 1))
      continue
    fi
    if [[ "$a" == "--help" || "$a" == "-h" ]]; then
      saw_help=1
      i=$((i + 1))
      continue
    fi
    # First non-global-option token (subcommand) means this is not global help.
    if [[ "$a" != -* ]]; then
      return 1
    fi
    i=$((i + 1))
  done
  [[ "$saw_help" == "1" ]]
}}

_sw_print_help() {{
  cat <<'__SANDWORM_HELP__'
Sandworm (singlefile)

If this host does not have Python/Nix available, use:
  sandworm bootstrap doctor [--json]     # explain what bootstrap plan would be used
  sandworm bootstrap verify [--json]     # fail-closed checks for strict/offline readiness

{help_text.rstrip()}

Quick tips:
  sandworm docs
  sandworm status                               # LLM-friendly status summary
  sandworm report                               # locate latest run report.md
  sandworm events validate                      # validate latest events.jsonl
  sandworm codex --dry-run                        # show Codex plan as JSON
  sandworm gemini --dry-run                       # show Gemini plan as JSON
  sandworm claude --dry-run                       # show Claude plan as JSON
  sandworm codex --help                           # codex subcommand help
  sandworm gemini --help                          # gemini subcommand help
  sandworm claude --help                          # claude subcommand help
  sandworm codex -- resume --last                 # resume last Codex session
  sandworm codex --UNSAFE                         # host actions via hostd (no /host)
  sandworm codex --TAKE-THE-WHEEL                 # mounts /host rw (dangerous)
  sandworm codex --DEV                            # development lane (SAFE-like boundaries)
  sandworm codex --BARE-METAL                     # runs provider on host (no sandbox; dangerous)
  sandworm codex --TAKE-THE-WHEEL -y              # skip confirmation prompt
  sandworm share list                             # inspect/mend share mounts
  sandworm codex --verbose                        # show bootstrap progress
__SANDWORM_HELP__
}}

	if [[ "$#" -eq 0 ]] || _sw_wants_help "$@"; then
	  _sw_print_help
	  exit 0
	fi

	_sw_enable_verbose() {{
	  # Noob ergonomics: make bootstrap progress visible without needing to know env vars.
	  if [[ -z "${{SW_BOOTSTRAP_PROGRESS:-}}" ]]; then
	    export SW_BOOTSTRAP_PROGRESS=1
	  fi
	}}

	_sw_saw_flag_before_double_dash() {{
	  local want="$1"
	  shift
	  local a
	  for a in "$@"; do
	    [[ "$a" == "--" ]] && break
	    [[ "$a" == "$want" ]] && return 0
	  done
	  return 1
	}}

	_sw_flag_value_before_double_dash() {{
	  # Best-effort long-option parser before the first `--`.
	  # Supports `--name value` and `--name=value`.
	  local name="$1"
	  shift
	  local -a argv=("$@")
	  local i=0
	  while [[ "$i" -lt "${{#argv[@]}}" ]]; do
	    local a="${{argv[$i]}}"
	    [[ "$a" == "--" ]] && break
	    if [[ "$a" == "--${{name}}" ]]; then
	      printf '%s' "${{argv[$((i + 1))]:-}}"
	      return 0
	    fi
	    if [[ "$a" == "--${{name}}="* ]]; then
	      printf '%s' "${{a#--${{name}}=}}"
	      return 0
	    fi
	    i=$((i + 1))
	  done
	  return 0
	}}

		_sw_first_cmd() {{
		  # First non-global-option token (subcommand). Used for posture confirmation UX.
		  local -a argv=("$@")
		  local i=0
		  while [[ "$i" -lt "${{#argv[@]}}" ]]; do
		    local a="${{argv[$i]}}"
		    if [[ "$a" == "--" ]]; then
		      break
		    fi
		    if [[ "$a" == "--root" ]]; then
		      i=$((i + 2))
		      continue
		    fi
		    if [[ "$a" == "--root="* ]]; then
		      i=$((i + 1))
		      continue
		    fi
		    if [[ "$a" != -* ]]; then
		      printf '%s' "$a"
		      return 0
		    fi
		    i=$((i + 1))
		  done
		  return 0
		}}

		_sw_detect_provider() {{
		  # Provider is only used for nicer UX in the confirmation prompt.
		  local provider=""
		  local -a argv=("$@")
		  local i=0
		  while [[ "$i" -lt "${{#argv[@]}}" ]]; do
		    local a="${{argv[$i]}}"
		    if [[ "$a" == "--" ]]; then
		      break
		    fi
		    if [[ "$a" == "--root" ]]; then
		      i=$((i + 2))
		      continue
		    fi
		    if [[ "$a" == "--root="* ]]; then
		      i=$((i + 1))
		      continue
		    fi
		    if [[ -z "$provider" && ( "$a" == "codex" || "$a" == "claude" || "$a" == "gemini" ) ]]; then
		      provider="$a"
		      break
		    fi
		    i=$((i + 1))
		  done
		  printf '%s\n' "$provider"
		}}

		_sw_posture_rank() {{
		  # Higher number = more dangerous.
		  case "${{1:-}}" in
		    unsafe) echo 10 ;;
		    take-the-wheel) echo 20 ;;
		    dev) echo 30 ;;
		    bare-metal) echo 40 ;;
		    *) echo 0 ;;
		  esac
		}}

		_sw_detect_requested_posture() {{
		  # Return one token: ""|unsafe|take-the-wheel|dev|bare-metal.
		  # Only scans argv before the first `--`.
		  local posture=""
		  local posture_rank=0
		  local -a argv=("$@")
		  local i=0
		  while [[ "$i" -lt "${{#argv[@]}}" ]]; do
		    local a="${{argv[$i]}}"
		    if [[ "$a" == "--" ]]; then
		      break
		    fi
		    if [[ "$a" == "--root" ]]; then
		      i=$((i + 2))
		      continue
		    fi
		    if [[ "$a" == "--root="* ]]; then
		      i=$((i + 1))
		      continue
		    fi

		    local cand=""
		    case "$a" in
		      --UNSAFE) cand="unsafe"; i=$((i + 1)) ;;
		      --TAKE-THE-WHEEL) cand="take-the-wheel"; i=$((i + 1)) ;;
		      --DEV) cand="dev"; i=$((i + 1)) ;;
		      --BARE-METAL) cand="bare-metal"; i=$((i + 1)) ;;
		      --posture)
		        cand="${{argv[$((i + 1))]:-}}"
		        i=$((i + 2))
		        ;;
		      --posture=*)
		        cand="${{a#--posture=}}"
		        i=$((i + 1))
		        ;;
		      *)
		        i=$((i + 1))
		        continue
		        ;;
		    esac

		    case "$cand" in
		      unsafe|take-the-wheel|dev|bare-metal)
		        local r
		        r="$(_sw_posture_rank "$cand")"
		        if [[ "$r" -gt "$posture_rank" ]]; then
		          posture="$cand"
		          posture_rank="$r"
		        fi
		        ;;
		    esac
		  done
		  printf '%s\n' "$posture"
		}}

		_sw_confirm_dangerous_posture_if_needed() {{
		  local target="$1"
		  local posture="$2"
		  local backend=""
		  local mode=""
		  shift 2
		  if [[ -z "$posture" ]]; then
		    return 0
		  fi
		  # Never prompt in dry-run/help-ish paths.
		  if _sw_saw_flag_before_double_dash "--dry-run" "$@" || _sw_saw_flag_before_double_dash "--help" "$@" || _sw_saw_flag_before_double_dash "-h" "$@"; then
		    return 0
	  fi
	  if _sw_saw_flag_before_double_dash "-y" "$@" || _sw_saw_flag_before_double_dash "--yes" "$@"; then
	    export SANDWORM_DANGEROUS_POSTURE_CONFIRMED=1
	    return 0
		  fi
		  if [[ "$posture" != "unsafe" && "$posture" != "take-the-wheel" && "$posture" != "bare-metal" ]]; then
		    return 0
		  fi
		  # If the caller explicitly selected KVM with a non-safe posture, let Python emit the
		  # fail-closed KVM posture diagnostic instead of stopping here on confirmation.
		  if [[ "$posture" == "unsafe" || "$posture" == "take-the-wheel" || "$posture" == "bare-metal" ]]; then
		    if [[ "$target" == "run" || "$target" == "shell" ]]; then
		      backend="$(_sw_flag_value_before_double_dash "backend" "$@")"
		      [[ -z "${{backend:-}}" ]] && backend="podman"
		      if [[ "$backend" == "kvm" ]]; then
		        export SANDWORM_DANGEROUS_POSTURE_CONFIRMED=1
		        return 0
		      fi
		    elif [[ "$target" == "codex" || "$target" == "claude" || "$target" == "gemini" ]]; then
		      mode="$(_sw_flag_value_before_double_dash "mode" "$@")"
		      [[ -z "${{mode:-}}" ]] && mode="auto"
		      if [[ "$mode" == "kvm" ]]; then
		        export SANDWORM_DANGEROUS_POSTURE_CONFIRMED=1
		        return 0
		      fi
		    fi
		  fi
		  if [[ ! -t 0 ]]; then
		    echo "ERROR: dangerous posture requested (${{posture}}) but stdin is not a TTY; pass -y/--yes to proceed." >&2
		    exit 2
		  fi

		  if [[ "$posture" == "unsafe" ]]; then
		    cat >&2 <<'EOF'
======================================================================
  DANGEROUS: UNSAFE posture requested.

  - Enables host actions via hostd (audited gateway).
  - Does NOT mount host root at /host.
  - Provider still runs in a sandbox (host execution remains disabled).

  This disables Sandworm's SAFE contract and can allow host mutation.
  If you do not fully understand the consequences, press Ctrl-C now.
======================================================================
EOF
		  elif [[ "$posture" == "take-the-wheel" ]]; then
		    cat >&2 <<'EOF'
======================================================================
  DANGEROUS: TAKE-THE-WHEEL posture requested.

  - Mounts host root read-write at /host (explicitly dangerous).
  - Also enables host actions via hostd when available.
  - Provider still runs in a sandbox (host execution remains disabled).

  This disables Sandworm's SAFE contract and can allow host mutation.
  If you do not fully understand the consequences, press Ctrl-C now.
======================================================================
EOF
		  else
		    cat >&2 <<'EOF'
======================================================================
  DANGEROUS: BARE-METAL posture requested.

  - Provider runs directly on the host (no sandbox).
  - Full host filesystem + process access applies.
  - Host actions are no longer mediated by hostd.

  This disables Sandworm's SAFE contract and can allow host mutation.
  If you do not fully understand the consequences, press Ctrl-C now.
======================================================================
EOF
		  fi

		  if [[ -n "${{target:-}}" ]]; then
		    echo "Target: $target" >&2
		  fi
		  echo "Tip: re-run with -y/--yes to skip this prompt." >&2
		  printf 'Continue? [y/N] ' >&2
		  local ans=""
		  read -r ans
	  local ans_l
	  ans_l="$(printf '%s' "$ans" | tr '[:upper:]' '[:lower:]')"
	  case "$ans_l" in
	    y|yes) ;;
	    *) echo "aborted" >&2; exit 2 ;;
	  esac
	  export SANDWORM_DANGEROUS_POSTURE_CONFIRMED=1
	  _sw_enable_verbose
	}}

		if _sw_saw_flag_before_double_dash "--verbose" "$@"; then
		  _sw_enable_verbose
		fi
		_sw_provider="$(_sw_detect_provider "$@")"
		_sw_posture="$(_sw_detect_requested_posture "$@")"
		if [[ -n "${{_sw_posture:-}}" ]]; then
		  _sw_target="${{_sw_provider:-$(_sw_first_cmd "$@")}}"
		  _sw_confirm_dangerous_posture_if_needed "$_sw_target" "$_sw_posture" "$@"
		fi

_sw_need() {{ command -v "$1" >/dev/null 2>&1 || {{ _sw_err "missing required tool: $1"; exit 2; }}; }}

_sw_need bash
_sw_need sleep
if [[ "${{PAYLOAD_FORMAT:-b64tar}}" == "b64tar" ]]; then
  _sw_need tar
  _sw_need base64
  _sw_need awk
fi

_sw_root_from_argv() {{
  local -a argv=("$@")
  local i=0
  while [[ "$i" -lt "${{#argv[@]}}" ]]; do
    local a="${{argv[$i]}}"
    if [[ "$a" == "--root" ]]; then
      local v="${{argv[$((i + 1))]:-}}"
      if [[ -z "$v" ]]; then
        _sw_err "--root requires a path"
        exit 2
      fi
      printf '%s' "$v"
      return 0
    fi
    if [[ "$a" == "--root="* ]]; then
      printf '%s' "${{a#--root=}}"
      return 0
    fi
    if [[ "$a" == "--" ]]; then
      break
    fi
    i=$((i + 1))
  done
  return 0
}}

_sw_abs_path() {{
  local p="$1"
  local cwd
  if [[ "$p" != /* ]]; then
    cwd="$(pwd -P)"
    case "$cwd" in
      //*) cwd="/${{cwd##//}}" ;;
    esac
    if [[ "$cwd" == "/" ]]; then
      p="/$p"
    else
      p="$cwd/$p"
    fi
  fi
  if ! p="$(cd "$p" 2>/dev/null && pwd -P)"; then
    _sw_err "invalid --root path: $1"
    return 1
  fi
  case "$p" in
    //*) p="/${{p##//}}" ;;
  esac
  printf '%s' "$p"
}}

_sw_can_write_dir() {{
  local d="${{1:-}}"
  [[ -n "$d" && "$d" == /* ]] || return 1
  local probe=""
  if probe="$(mktemp "$d/.sw-write-test.XXXXXX" 2>/dev/null)"; then
    rm -f "$probe" >/dev/null 2>&1 || true
    return 0
  fi
  return 1
}}

# SAFE defaults: avoid writing to a shared inherited HOME by default.
# Preserve /run/sandworm/home only when nested runtime is active AND the selected root
# control plane is not writable. Otherwise prefer per-root HOME isolation.
if [[ "${{SW_USE_HOST_HOME:-0}}" != "1" && "${{SANDWORM_USE_HOST_HOME:-0}}" != "1" ]]; then
  _sw_root_for_home="$(_sw_root_from_argv "$@")"
  if [[ -z "${{_sw_root_for_home:-}}" ]]; then
    _sw_root_for_home="."
  fi
  _sw_root_for_home="$(_sw_abs_path "$_sw_root_for_home" 2>/dev/null || true)"
  if [[ -z "${{_sw_root_for_home:-}}" ]]; then
    _sw_root_for_home="$(pwd -P)"
  fi

  need_sw_home=1
  in_nested_runtime=0
  if [[ -n "${{SANDWORM_BACKEND:-}}" ]]; then
    in_nested_runtime=1
  fi
  if [[ "$in_nested_runtime" == "1" && ( "${{SANDWORM_HOME:-}}" == "/run/sandworm/home" || "${{HOME:-}}" == "/run/sandworm/home" ) ]]; then
    if _sw_can_write_dir "/run/sandworm/home" && ! _sw_can_write_dir "$_sw_root_for_home"; then
      need_sw_home=0
    fi
  fi

  if [[ "$need_sw_home" == "1" ]]; then
    if [[ "$_sw_root_for_home" == "/" ]]; then
      sw_home="/.sandworm/home"
    else
      sw_home="$_sw_root_for_home/.sandworm/home"
    fi
    if ! mkdir -p "$sw_home/.cache" "$sw_home/.config" "$sw_home/.local/share" "$sw_home/.local/state" "$sw_home/tmp" 2>/dev/null; then
      sw_uid="${{UID:-$(id -u 2>/dev/null || printf '0')}}"
      sw_tmp_base="${{TMPDIR:-/tmp}}"
      sw_home="$sw_tmp_base/sandworm-home-$sw_uid"
      mkdir -p "$sw_home/.cache" "$sw_home/.config" "$sw_home/.local/share" "$sw_home/.local/state" "$sw_home/tmp" 2>/dev/null || true
    fi
    if _sw_can_write_dir "$sw_home"; then
      export SANDWORM_HOME="$sw_home"
      export HOME="$sw_home"
      export XDG_CACHE_HOME="$sw_home/.cache"
      export XDG_CONFIG_HOME="$sw_home/.config"
      export XDG_DATA_HOME="$sw_home/.local/share"
      export XDG_STATE_HOME="$sw_home/.local/state"
