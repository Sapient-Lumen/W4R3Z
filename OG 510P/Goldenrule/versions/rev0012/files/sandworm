import re
from pathlib import Path
from typing import Any

ALLOWED_RESUME_POLICIES = {"never", "always", "resume", "resume-last"}
ALLOWED_NETWORKS = {"host", "none", "auto", "default", "bridge", "slirp4netns", "pasta"}
CUSTOM_NETWORK_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$")
