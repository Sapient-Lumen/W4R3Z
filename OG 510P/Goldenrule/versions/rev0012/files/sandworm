        str(socket_path),
        "--shared-dir",
        str(shared_dir),
        "--cache=auto",
        "--sandbox=none",
    ]


def _now_rfc3339() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%S%z", time.gmtime())


def _kvm_writable() -> bool:
    try:
        return os.path.exists("/dev/kvm") and os.access("/dev/kvm", os.R_OK | os.W_OK)
    except Exception:
        return False


def _free_tcp_port() -> int:
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.bind(("127.0.0.1", 0))
    _host, port = s.getsockname()
    s.close()
    return int(port)


def _atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + f".tmp.{secrets.token_hex(4)}")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(path)


def _read_int(path: Path) -> int | None:
    try:
        return int(path.read_text(encoding="utf-8").strip())
    except Exception:
        return None


def _tail_text(s: str, n_lines: int) -> str:
    lines = s.splitlines()
    if n_lines <= 0:
        return ""
    if len(lines) <= n_lines:
        return s
    return "\n".join(lines[-n_lines:]) + "\n"


def _tail_file(path: Path, n_lines: int) -> str:
    try:
        return _tail_text(path.read_text(encoding="utf-8", errors="ignore"), n_lines)
    except Exception:
        return ""


def _sha256_text(s: str) -> str:
    return hashlib.sha256(s.encode("utf-8")).hexdigest()

def _sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def _now_rfc3339_utc() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _virtiofs_socket_path(base: Path) -> Path:
    sock = base / "virtiofsd.sock"
    try:
        if len(str(sock)) < 100:
            return sock
    except Exception:
        return sock
    # UNIX socket paths must be <108 bytes; use a short /tmp fallback when base is long.
    short = _sha256_text(str(base))[:12]
    return Path("/tmp") / f"sandworm-virtiofsd-{short}.sock"


def _pid_alive(pid: int) -> bool:
    try:
        try:
            st = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8", errors="ignore")
            # /proc/<pid>/stat: pid (comm) state ...
            if ") " in st:
                rest = st.split(") ", 1)[1]
                state = rest.split()[0] if rest.split() else ""
                if state == "Z":
                    return False
        except Exception:
            pass
        os.kill(pid, 0)
        return True
    except Exception:
        return False


def _run(argv: list[str], *, cwd: Path, timeout_s: int | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, cwd=cwd, text=True, capture_output=True, timeout=timeout_s)


def _ensure_ssh_keypair(root: Path, *, instance: str | None = None) -> tuple[Path, Path]:
    keys_dir = _kvm_state_dir(root, instance=instance) / "keys"
    keys_dir.mkdir(parents=True, exist_ok=True)
    priv = keys_dir / "id_ed25519"
    pub = keys_dir / "id_ed25519.pub"
    if priv.exists() and pub.exists():
        return priv, pub

    ssh_keygen = shutil.which("ssh-keygen")
    nix = find_nix(root)
    if not ssh_keygen and not nix:
        raise RuntimeError("ssh-keygen not found (install openssh-client or nix)")

    args: list[str]
    if ssh_keygen:
        args = [
            ssh_keygen,
            "-t",
            "ed25519",
            "-N",
            "",
            "-f",
            str(priv),
            "-C",
            "sandworm-kvm",
        ]
    else:
        args = [
            nix,
            *nix_flags(),
            "shell",
            "nixpkgs#openssh",
            "--command",
            "ssh-keygen",
            "-t",
            "ed25519",
            "-N",
            "",
            "-f",
            str(priv),
            "-C",
            "sandworm-kvm",
        ]
    out = _run(args, cwd=root, timeout_s=60)
    if out.returncode != 0:
        raise RuntimeError(f"ssh-keygen failed: {out.stderr.strip() or out.stdout.strip()}")
    return priv, pub


def _write_guest_config(root: Path) -> Path:
    cfg = _kvm_base(root) / "guest-config.nix"
    base_cfg_txt = f"""{{ config, pkgs, lib, ... }}:
{{
  networking.hostName = "sandworm";
  networking.useDHCP = true;
  networking.firewall.enable = false;
  services.openssh.enable = true;
  services.openssh.settings.PasswordAuthentication = false;
  services.openssh.settings.KbdInteractiveAuthentication = false;
  services.openssh.settings.PermitRootLogin = "no";

  # Make `nixos-rebuild test` usable in the guest by providing a bootable baseline.
  # Even though `test` doesn't reboot, NixOS still asserts these are configured.
  fileSystems."/" = {{
    device = "/dev/disk/by-label/nixos";
    fsType = "ext4";
    options = [ "x-systemd.growfs" "x-initrd.mount" ];
  }};
  boot.loader.grub.enable = true;
  # nixos-generators may also set grub.devices; force a single device to avoid
  # duplicated entries which can trip NixOS assertions (mirroredBoots).
  boot.loader.grub.devices = lib.mkForce [ "/dev/vda" ];
  boot.loader.efi.canTouchEfiVariables = false;

  # The workspace mount and control-plane masking are product safety invariants.
  #
  # Important detail for the KVM agent-control proof: `nixos-rebuild test` can stop mount units
  # that are not declared in the new config. Keep `/workspace` and `/workspace/.sandworm`
  # declared as proper mount units so a test activation does not unmask the host control plane.
  systemd.tmpfiles.rules = [
    "d /workspace 0777 root root -"
    "d /workspace/shared 0777 root root -"
    "d /workspace/.sandworm 0777 root root -"
    "d /srv 0777 root root -"
    "d /srv/shared 0777 root root -"
    "d /run/sandworm 0777 root root -"
  ];

  fileSystems."/workspace" = {{
    device = "workspace";
    fsType = "9p";
    options = [ "trans=virtio" "msize=262144" "cache=mmap" "rw" "nosuid" "nodev" ];
  }};

  fileSystems."/workspace/.sandworm" = {{
    device = "tmpfs";
    fsType = "tmpfs";
    options = [ "mode=0777" "size=1024M" ];
  }};

  users.users.sand = {{
    isNormalUser = true;
    createHome = true;
    home = "/home/sand";
    extraGroups = [ "wheel" ];
    subUidRanges = [ {{ startUid = 100000; count = 65536; }} ];
    subGidRanges = [ {{ startGid = 100000; count = 65536; }} ];
  }};
  security.sudo.wheelNeedsPassword = false;
  security.unprivilegedUsernsClone = true;

  # GUI/clipboard best-effort support (SPICE). Sandworm will still work headless.
  services.spice-vdagentd.enable = true;

  environment.sessionVariables.SANDWORM_BIN = "/run/sandworm/bin/sandworm";
  environment.sessionVariables.SANDWORM_CLIENTS_BIN = "/run/sandworm/clients/bin";
  environment.sessionVariables.SANDWORM_QUEUER_BIN = "/run/sandworm/queuer/bin";
  environment.sessionVariables.SANDWORM_HOME = "/run/sandworm/home";
  environment.sessionVariables.SANDWORM_TOOLROOT_BIN = "/run/sandworm/toolroot/bin";
  environment.sessionVariables.PATH = "/run/sandworm/bin:/run/sandworm/queuer/bin:/run/sandworm/clients/bin:/run/sandworm/toolroot/bin:$PATH";

  # Keep `/run` usable: Sandworm may place bootstrap caches under `/run/sandworm/*` during
  # stage0/tooling checks. If `/run/sandworm` lives on the small `/run` tmpfs, `nixos-rebuild test`
  # can fail because systemd cannot reload when `/run` is full.
  fileSystems."/run/sandworm" = {{
    device = "tmpfs";
    fsType = "tmpfs";
    options = [ "mode=0777" "size=4096M" ];
  }};

  # Host-injected SSH key (via 9p export "keys" to /run/sandworm/keys).
  # This makes prebuilt qcow2 images portable across hosts.
  fileSystems."/run/sandworm/keys" = {{
    device = "keys";
    fsType = "9p";
    options = [ "trans=virtio" "msize=262144" "cache=mmap" "ro" "nofail" ];
  }};

  fileSystems."/run/sandworm/bin" = {{
    device = "bin";
    fsType = "9p";
    options = [ "trans=virtio" "msize=262144" "cache=mmap" "ro" "nofail" ];
  }};

  # Sandworm-managed provider CLIs (exported read-only from the host control plane).
  fileSystems."/run/sandworm/clients" = {{
    device = "clients";
    fsType = "9p";
    options = [ "trans=virtio" "msize=262144" "cache=mmap" "ro" "nofail" ];
  }};

  # Sandworm-managed queue provider wrappers (exported read-only from the host control plane).
  fileSystems."/run/sandworm/queuer" = {{
    device = "queuer";
    fsType = "9p";
    options = [ "trans=virtio" "msize=262144" "cache=mmap" "ro" "nofail" ];
  }};

  # Sandworm-managed toolroot (host-mounted; best-effort).
  fileSystems."/run/sandworm/toolroot" = {{
    device = "toolroot";
    fsType = "9p";
    options = [ "trans=virtio" "msize=262144" "cache=mmap" "ro" "nofail" ];
  }};

  # Sandworm-managed provider state (project-local HOME on the host; exported outside /workspace).
  # This enables credential reuse across host/podman/bwrap/kvm without exposing /workspace/.sandworm.
  fileSystems."/run/sandworm/home" = {{
    device = "sw_home";
    fsType = "9p";
    options = [ "trans=virtio" "msize=262144" "cache=mmap" "rw" "nofail" ];
  }};

  # Persistent data disk (host-created qcow2 attached as virtio-blk; first boot formats it).
  # This is where we keep the user's home directory and tool caches across guest image upgrades.
  systemd.services.sandworm-data = {{
    description = "Sandworm: init and mount persistent data disk";
    wantedBy = [ "multi-user.target" ];
    before = [ "sshd.service" "sandworm-authorize-keys.service" ];
    serviceConfig.Type = "oneshot";
    path = with pkgs; [ coreutils util-linux e2fsprogs ];
    script = ''
      set -euo pipefail
      dev="/dev/vdb"
      mp="/home/sand"
      for i in $(seq 1 40); do
        [ -b "$dev" ] && break
        sleep 0.25
      done
      [ -b "$dev" ] || exit 0
      install -d -m 0700 -o sand -g users "$mp"
      if ! blkid "$dev" >/dev/null 2>&1; then
        mkfs.ext4 -F -L SANDWORM_DATA "$dev"
      fi
      if ! mountpoint -q "$mp"; then
        mount -t ext4 -o noatime "$dev" "$mp"
      fi
      chown sand:users "$mp" || true
      chmod 0700 "$mp" || true
    '';
  }};

  systemd.services.sandworm-authorize-keys = {{
    description = "Sandworm: install host-injected SSH public key for user sand";
    wantedBy = [ "multi-user.target" ];
    before = [ "sshd.service" ];
    after = [ "sandworm-data.service" ];
    serviceConfig.Type = "oneshot";
    script = ''
      set -euo pipefail
      key="/run/sandworm/keys/id_ed25519.pub"
      if [ ! -r "$key" ]; then
        exit 0
      fi
      install -d -m 0700 -o sand -g users /home/sand/.ssh
      install -m 0600 -o sand -g users "$key" /home/sand/.ssh/authorized_keys
    '';
  }};

  # Tools for nested sandboxing experiments inside the guest.
  virtualisation.podman.enable = true;
  environment.systemPackages = lib.mkOverride 2000 (with pkgs; [
    bash
    binutils
    cacert
    coreutils
    curl
    diffutils
    e2fsprogs
    findutils
    git
    gnumake
    gnused
    gawk
    gcc
    gzip
    jq
    openssl
    patch
    pkg-config
    ripgrep
    rsync
    unzip
    wget
    xz
    zip
    nodejs_22
    podman
    slirp4netns
    fuse-overlayfs
    bubblewrap
    spice-vdagent
    util-linux
    (python311.withPackages (ps: [ ps.pyyaml ]))
  ]);

	  # Improve reliability of 9p mounts and support virtiofs for workspace sharing.
	  boot.kernelModules = [ "9pnet" "9pnet_virtio" "virtiofs" ];
	
	  systemd.services.sandworm-workspace = {{
	    description = "Sandworm: mount /workspace (virtiofs preferred, 9p fallback) and mask control plane";
	    wantedBy = [ "multi-user.target" ];
	    before = [ "sshd.service" ];
	    serviceConfig.Type = "oneshot";
	    script = ''
	      set -euo pipefail
	
      install -d -m 0777 /workspace
      install -d -m 0777 /workspace/shared
      install -d -m 0777 /srv
      install -d -m 0777 /srv/shared
      install -d -m 0777 /run/sandworm
	
	      # Prefer virtiofs when available (host runs virtiofsd + QEMU provides vhost-user-fs device).
	      modprobe virtiofs >/dev/null 2>&1 || true
	      if mount -t virtiofs -o rw,nosuid,nodev workspace /workspace >/dev/null 2>&1; then
	        echo virtiofs > /run/sandworm/workspace.fstype || true
	      fi
	
	      # Fallback: 9p (always exported by Sandworm for portability).
	      if ! mountpoint -q /workspace; then
	        modprobe 9pnet_virtio >/dev/null 2>&1 || true
	        if mount -t 9p -o trans=virtio,msize=262144,cache=mmap,rw,nosuid,nodev workspace /workspace >/dev/null 2>&1; then
	          echo 9p > /run/sandworm/workspace.fstype || true
	        fi
	      fi
	
      if ! mountpoint -q /workspace; then
        echo none > /run/sandworm/workspace.fstype || true
        exit 0
      fi

      # Bind shared folder into /srv/shared (UX contract).
      if mount --bind /workspace/shared /srv/shared >/dev/null 2>&1; then
        mount -o remount,bind,exec,nosuid,nodev /srv/shared >/dev/null 2>&1 || true
      fi

      # Safety invariant: mask the control plane inside the guest.
	      # Must be writable by the normal user so Sandworm can run inside the guest.
	      install -d -m 0777 /workspace/.sandworm
	      mount -t tmpfs -o mode=0777,size=1024M tmpfs /workspace/.sandworm >/dev/null 2>&1 || true
	    '';
	  }};

  system.stateVersion = "24.05";
}}
"""

    # NixOS images produced by nixos-generators may not include /etc/nixos/configuration.nix,
    # which breaks `nixos-rebuild` inside the guest. Provide a baseline config as a *real file*
    # so automated tests (and agents) can prove system-level mutation and rollback.
    #
    # Hard choice: embed the config as base64 to avoid fragile Nix-string escaping.
    b64 = base64.b64encode(base_cfg_txt.encode("utf-8")).decode("ascii")
    b64_lines = "\n".join(b64[i : i + 76] for i in range(0, len(b64), 76))
    nixos_cfg_writer = f"""

  systemd.services.sandworm-nixos-config = {{
    description = "Sandworm: ensure /etc/nixos/configuration.nix exists for nixos-rebuild";
    wantedBy = [ "multi-user.target" ];
    before = [ "sshd.service" ];
    serviceConfig.Type = "oneshot";
    script = ''
      set -euo pipefail
      if [ -f /etc/nixos/configuration.nix ]; then
        exit 0
      fi
      install -d -m 0755 /etc/nixos
      cat > /etc/nixos/configuration.nix.b64 <<'EOF'
{b64_lines}
EOF
      base64 -d /etc/nixos/configuration.nix.b64 > /etc/nixos/configuration.nix
      rm -f /etc/nixos/configuration.nix.b64
      chmod 0644 /etc/nixos/configuration.nix
    '';
  }};
"""

    cfg_txt = base_cfg_txt.replace('\n  system.stateVersion = "24.05";', nixos_cfg_writer + '\n  system.stateVersion = "24.05";', 1)
    _atomic_write(cfg, cfg_txt)
    _atomic_write(_kvm_base(root) / "guest-config-only.sig", _sha256_text(cfg_txt) + "\n")
    return cfg


def _guest_disk_size_mb() -> int:
    """
    Desired NixOS guest root disk size (in MiB) when building a qcow2 image.

    Sandworm runs substantial Nix workloads inside the guest for DEV/testing.
    A too-small root filesystem can cause ENOSPC in /nix/store/tmp-* during flake fetches/builds.
    """
    raw = os.environ.get("SW_KVM_GUEST_DISK_SIZE_MB") or os.environ.get("SANDWORM_KVM_GUEST_DISK_SIZE_MB") or ""
    try:
        n = int(str(raw).strip())
        if n >= 8192:
            return n
    except Exception:
        pass
    # Default: 32 GiB (qcow2 is sparse; virtual size doesn't imply immediate host disk usage).
    return 32768


def _kvm_vm_mem_mb() -> int:
    """
    VM RAM (in MiB) for Sandworm-managed KVM guests.

    DEV/facility runs do substantial Nix workloads in-guest; 2GiB is frequently too small and can
    lead to OOM-killed subprocesses (e.g., nix-portable running `nix`).
    """
    raw = os.environ.get("SW_KVM_MEM_MB") or os.environ.get("SANDWORM_KVM_MEM_MB") or ""
    try:
        n = int(str(raw).strip())
        if n >= 1024:
            return n
    except Exception:
        pass
    return 4096


def _write_guest_format(root: Path) -> Path:
    """
    Write a nixos-generators format file for qcow2 with a larger disk size.

    This is generated under --root/.sandworm so the singlefile artifact can build the guest image
    without relying on workspace-only files.
    """
    base = _kvm_base(root)
    fmt = base / "guest-format-qcow.nix"
    disk_mb = _guest_disk_size_mb()
    fmt_txt = (
        "{ config, lib, pkgs, modulesPath, ... }:\n"
        "{\n"
        '  imports = [ "${toString modulesPath}/profiles/qemu-guest.nix" ];\n'
        '  fileSystems.\"/\" = { device = \"/dev/disk/by-label/nixos\"; autoResize = true; fsType = \"ext4\"; };\n'
        "  boot.growPartition = true;\n"
        '  boot.kernelParams = [ "console=ttyS0" ];\n'
        "  boot.loader.grub.device =\n"
        '    if (pkgs.stdenv.system == "x86_64-linux") then (lib.mkDefault "/dev/vda") else (lib.mkDefault "nodev");\n'
        "  boot.loader.grub.efiSupport = lib.mkIf (pkgs.stdenv.system != \"x86_64-linux\") (lib.mkDefault true);\n"
        "  boot.loader.grub.efiInstallAsRemovable = lib.mkIf (pkgs.stdenv.system != \"x86_64-linux\") (lib.mkDefault true);\n"
        "  boot.loader.timeout = 0;\n"
        "\n"
        '  system.build.qcow = import "${toString modulesPath}/../lib/make-disk-image.nix" {\n'
        "    inherit lib config pkgs;\n"
        f"    diskSize = {int(disk_mb)};\n"
        '    format = "qcow2";\n'
        '    partitionTableType = "hybrid";\n'
        "  };\n"
        "\n"
        '  formatAttr = "qcow";\n'
        '  fileExtension = ".qcow2";\n'
        "}\n"
    )
    _atomic_write(fmt, fmt_txt)
    _atomic_write(base / "guest-format.sig", _sha256_text(fmt_txt) + "\n")
    return fmt


def _write_guest_image_inputs(root: Path) -> dict[str, Any]:
    cfg = _write_guest_config(root)
    fmt = _write_guest_format(root)
    try:
        cfg_txt = cfg.read_text(encoding="utf-8", errors="ignore")
    except Exception:
        cfg_txt = ""
    try:
        fmt_txt = fmt.read_text(encoding="utf-8", errors="ignore")
    except Exception:
        fmt_txt = ""
    desired_sig = _sha256_text(cfg_txt + "\n--\n" + fmt_txt)
    _atomic_write(_kvm_base(root) / "guest-config.sig", desired_sig + "\n")
    return {"config": cfg, "format": fmt, "desired_sig": desired_sig}


def _ensure_guest_image(root: Path, *, force: bool) -> Path:
    kvm_dir = _kvm_base(root)
    img_link = kvm_dir / "guest.qcow2"
    _ = _write_guest_image_inputs(root)
    if img_link.exists() and not force:
        # If config/format changed since last build, treat as a rebuild request even without --force.
        desired_sig = ""
        image_sig = ""
        try:
            desired_sig = (_kvm_base(root) / "guest-config.sig").read_text(encoding="utf-8").strip()
        except Exception:
            desired_sig = ""
        try:
            image_sig = (_kvm_base(root) / "guest-image.sig").read_text(encoding="utf-8").strip()
        except Exception:
            image_sig = ""
        stale = bool(desired_sig and image_sig and desired_sig != image_sig)
        if not stale:
            # Even when the image already exists, keep the link layout normalized (relative symlinks)
            # so the workspace remains portable when bind-mounted (e.g., inside bwrap).
            try:
                _ensure_kvm_image_layout(root)
            except Exception:
                pass
            return img_link

    _priv, _pub = _ensure_ssh_keypair(root)
    cfg = _kvm_base(root) / "guest-config.nix"
    fmt = _kvm_base(root) / "guest-format-qcow.nix"

    nix = find_nix(root)
    if not nix:
        raise RuntimeError("nix not found (needed to build NixOS guest image)")

    # Build via nixos-generators (qcow format). This can take a while.
    out_link = kvm_dir / "build-out"
    if out_link.exists() or out_link.is_symlink():
        try:
            out_link.unlink()
        except Exception:
            pass

    if force and img_link.exists() and not img_link.is_symlink():
        try:
            img_link.unlink()
        except Exception:
            pass

    out_link = kvm_dir / "nixos-generate-result"
    try:
        if out_link.exists() or out_link.is_symlink():
            out_link.unlink()
    except Exception:
        pass

    cmd = [
        nix,
        *nix_flags(),
        "shell",
        "nixpkgs#nixos-generators",
        "--command",
        "nixos-generate",
        "--format-path",
        str(fmt),
        "-c",
        str(cfg),
        "-o",
        str(out_link),
    ]
    proc = subprocess.run(cmd, cwd=root, text=True, capture_output=True)
    if proc.returncode != 0:
        raise RuntimeError(f"failed to build guest image: {proc.stderr.strip() or proc.stdout.strip()}")
    if not out_link.exists():
        raise RuntimeError("nixos-generate did not produce an out-link")

    # Find the qcow2 image within the out-link.
    qcows = sorted(out_link.rglob("*.qcow2"))
    if not qcows:
        qcows = sorted(out_link.rglob("*.qcow"))
    if not qcows:
        raise RuntimeError("nixos-generate output did not contain a qcow2 image")
    src = qcows[0]
    _ensure_kvm_image_layout(root)
    images = _kvm_images_dir(root)
    tmp = images / f"build.{secrets.token_hex(4)}.qcow2"
    shutil.copy2(src, tmp)
    try:
        tmp.chmod(0o644)
    except Exception:
        pass
    got = _sha256_file(tmp)
    final = images / f"{got[:12]}.qcow2"
    if not final.exists():
        tmp.replace(final)
    else:
        try:
            tmp.unlink(missing_ok=True)
        except Exception:
            pass
    cur, prev, guest = _kvm_image_links(root)
    if cur.exists():
        try:
            _atomic_symlink(cur.resolve(), prev)
        except Exception:
            pass
    _atomic_symlink(final, cur)
    _atomic_symlink(cur, guest)
    try:
        desired = (_kvm_base(root) / "guest-config.sig").read_text(encoding="utf-8").strip()
        if desired:
            _atomic_write(_kvm_base(root) / "guest-image.sig", desired + "\n")
            _atomic_write(_kvm_base(root) / "guest-image.built_at", _now_rfc3339() + "\n")
    except Exception:
        pass
    return img_link


def _kvm_base(root: Path) -> Path:
    return control_dir(root) / "kvm"


def _virtiofs_broken_marker(root: Path) -> Path:
    # Global marker: if virtiofs consistently fails on this host/QEMU/kernel combo, skip it by default.
    return _kvm_base(root) / "virtiofs.broken"


def _virtiofs_allow(root: Path, *, requested: str) -> tuple[bool, str]:
    """
    Decide whether to attempt virtiofs for the KVM workspace share.

    Precedence:
      1) requested=on/off (CLI) overrides everything
      2) SW_KVM_VIRTIOFS=0 disables
      3) cached broken marker disables unless SW_KVM_VIRTIOFS_FORCE=1
      4) otherwise enabled (best-effort)
    """
    mode = (requested or "auto").strip().lower()
    if mode not in ("auto", "on", "off"):
        mode = "auto"

    if mode == "on":
        return True, "forced_on"
    if mode == "off":
        return False, "forced_off"

    if os.environ.get("SW_KVM_VIRTIOFS", "1") == "0":
        return False, "env_off"

    if _virtiofs_broken_marker(root).exists() and os.environ.get("SW_KVM_VIRTIOFS_FORCE", "0") != "1":
        return False, "cached_broken"

    return True, "auto"


def _kvm_instance_name(instance: str | None) -> str:
    s = (instance or "default").strip()
    if not s or s == "default":
        return "default"
    # Keep instance names filesystem-safe and boring.
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", s or ""):
        raise ValueError(f"invalid kvm instance name: {instance!r}")
    if s in (".", ".."):
        raise ValueError(f"invalid kvm instance name: {instance!r}")
    return s


def _kvm_state_dir(root: Path, *, instance: str | None) -> Path:
    """
    Runtime state dir (pid/ports/logs/keys/data disk).
    Default instance uses the legacy `.sandworm/kvm`.
    Additional instances live under `.sandworm/kvm/instances/<name>`.
    """
    base = _kvm_base(root)
    inst = _kvm_instance_name(instance)
    if inst == "default":
        return base
    return base / "instances" / inst


def _kvm_images_dir(root: Path) -> Path:
    return _kvm_base(root) / "images"


def _kvm_image_links(root: Path) -> tuple[Path, Path, Path]:
    images = _kvm_images_dir(root)
    return images / "current.qcow2", images / "previous.qcow2", _kvm_base(root) / "guest.qcow2"


def _kvm_data_disk_path(root: Path, *, instance: str | None) -> Path:
    return _kvm_state_dir(root, instance=instance) / "data.qcow2"


_QEMU_IMG_BIN: str | None = None


def _qemu_img_binary(root: Path) -> str | None:
    global _QEMU_IMG_BIN
    if _QEMU_IMG_BIN:
        return _QEMU_IMG_BIN
    p = shutil.which("qemu-img")
    if p:
        _QEMU_IMG_BIN = p
        return p
    nix = find_nix(root)
    if not nix:
        return None
    try:
        store = subprocess.check_output(
            [
                nix,
                *nix_flags(),
                "build",
                "--no-link",
                "--print-out-paths",
                "nixpkgs#qemu",
            ],
            cwd=root,
            text=True,
        ).strip()
        out_paths = [ln.strip() for ln in store.splitlines() if ln.strip()]
        out_path = out_paths[-1] if out_paths else store.strip()
        cand = str(Path(out_path) / "bin" / "qemu-img")
        if os.path.exists(cand) and os.access(cand, os.X_OK):
            _QEMU_IMG_BIN = cand
            return cand
    except Exception:
        return None
    return None


def _kvm_default_data_size() -> str:
    # Typical default: large enough for tool caches but not enormous.
    return str(os.environ.get("SW_KVM_DATA_SIZE") or os.environ.get("SANDWORM_KVM_DATA_SIZE") or "20G")


def _ensure_kvm_data_disk(root: Path, *, instance: str | None, size: str | None = None) -> Path:
    state_dir = _kvm_state_dir(root, instance=instance)
    state_dir.mkdir(parents=True, exist_ok=True)
    disk = _kvm_data_disk_path(root, instance=instance)
    if disk.exists():
        return disk
    qemu_img = _qemu_img_binary(root)
    if not qemu_img:
        raise RuntimeError("qemu-img not available (install qemu or nix)")
    size_s = (size or _kvm_default_data_size()).strip() or "20G"
    cmd = [qemu_img, "create", "-f", "qcow2", "-o", "lazy_refcounts=on,preallocation=off", str(disk), size_s]
    proc = subprocess.run(cmd, cwd=root, text=True, capture_output=True)
    if proc.returncode != 0 or not disk.exists():
        raise RuntimeError(f"failed to create data.qcow2: {proc.stderr.strip() or proc.stdout.strip()}")
    try:
        disk.chmod(0o644)
    except Exception:
        pass
    return disk


def _atomic_symlink(target: Path, link_path: Path) -> None:
    link_path.parent.mkdir(parents=True, exist_ok=True)
    tmp = link_path.with_suffix(link_path.suffix + f".tmp.{secrets.token_hex(4)}")
    try:
        tmp.unlink(missing_ok=True)
    except Exception:
        pass
    # Prefer relative symlinks when the target lives under the link directory tree.
    # This improves portability when the workspace is bind-mounted at a different path
    # (e.g., /workspace inside bwrap/KVM).
    try:
        base = Path(os.path.abspath(str(link_path.parent)))
        tgt_abs = (
            Path(os.path.abspath(str(target)))
            if target.is_absolute()
            else Path(os.path.abspath(str(base / str(target))))
        )
        if tgt_abs.is_relative_to(base):
            rel = os.path.relpath(str(tgt_abs), start=str(base))
            tmp.symlink_to(rel)
        else:
            tmp.symlink_to(target)
    except Exception:
        tmp.symlink_to(target)
    tmp.replace(link_path)


def _kvm_find_qemu_pids(root: Path, *, instance: str | None) -> list[int]:
    """
    Best-effort: locate running qemu processes that belong to this workspace.

    We match by presence of unique workspace paths (data.qcow2 / serial.log) in /proc/<pid>/cmdline.
    """
    base = _kvm_state_dir(root, instance=instance).resolve()
    needle1 = str((_kvm_data_disk_path(root, instance=instance)).resolve())
    needle2 = str((base / "serial.log").resolve())
    pids: list[int] = []
    proc = Path("/proc")
    if not proc.exists():
        return []
    for ent in proc.iterdir():
        if not ent.name.isdigit():
            continue
        pid = int(ent.name)
        try:
            cmdline = (ent / "cmdline").read_bytes()
        except Exception:
            continue
        if not cmdline:
            continue
        # /proc/<pid>/cmdline is NUL-separated.
        try:
            args = cmdline.replace(b"\x00", b" ").decode("utf-8", errors="ignore")
        except Exception:
            continue
        if "qemu-system" not in args:
            continue
        if (needle1 in args) or (needle2 in args):
            pids.append(pid)
    return sorted(set(pids))


def _ensure_kvm_image_layout(root: Path) -> None:
    base = _kvm_base(root)
    images = _kvm_images_dir(root)
    images.mkdir(parents=True, exist_ok=True)
    cur, _prev, guest = _kvm_image_links(root)
    # If we have a legacy guest.qcow2 file, adopt it as the current image.
    if guest.exists() and not guest.is_symlink() and not cur.exists():
        adopted = images / f"local-{_now_rfc3339_utc().replace(':', '').replace('-', '')}.qcow2"
        try:
            guest.replace(adopted)
        except Exception:
            shutil.copy2(guest, adopted)
            try:
                guest.unlink()
            except Exception:
                pass
        _atomic_symlink(adopted, cur)
    # Ensure guest.qcow2 is a stable link to current (if current exists).
    if cur.exists():
        try:
            # If links already exist, still normalize them to relative symlinks for sandbox portability.
            if cur.is_symlink():
                try:
                    _atomic_symlink(cur.resolve(), cur)
                except Exception:
                    pass
            if guest.exists() and guest.is_symlink():
                try:
                    _atomic_symlink(cur, guest)
                except Exception:
                    pass
                return
            if guest.exists() and not guest.is_symlink():
                # Don't overwrite a real file unexpectedly.
                return
            _atomic_symlink(cur, guest)
        except Exception:
            return


def _kvm_image_url_configured(root: Path) -> bool:
    url, _sha = _kvm_lockfile_kvm_nixos(root)
    env_url = os.environ.get("SW_KVM_QCOW2_URL") or os.environ.get("SANDWORM_KVM_QCOW2_URL")
    return bool((env_url and env_url.strip()) or url)


def _kvm_lockfile_kvm_nixos(root: Path) -> tuple[str | None, str | None]:
    """
    Read qcow2_url/qcow2_sha256 from sandworm.lock (best-effort).
    """
    lf = lockfile_path(root)
    if not lf.exists():
        return None, None
    try:
        d = load_lockfile_dict(lf)
    except LockfileError:
        return None, None
    kvm = d.get("kvm") if isinstance(d, dict) else None
    nixos = kvm.get("nixos") if isinstance(kvm, dict) else None
    if not isinstance(nixos, dict):
        return None, None
    url = nixos.get("qcow2_url")
    sha = nixos.get("qcow2_sha256")
    url_s = url.strip() if isinstance(url, str) else ""
    sha_s = sha.strip() if isinstance(sha, str) else ""
    if not url_s or url_s == "...":
        url_s = ""
    if not sha_s or sha_s == "...":
        sha_s = ""
    return (url_s or None), (sha_s or None)


def _download_file_with_sha256(url: str, *, dst: Path, expected_sha256: str | None) -> str:
    dst.parent.mkdir(parents=True, exist_ok=True)
    tmp = dst.with_suffix(dst.suffix + f".tmp.{secrets.token_hex(4)}")
    h = hashlib.sha256()
    try:
        # Support URL fetches (https://, file://) and local filesystem paths.
        #
        # Lockfile docs allow qcow2_url to be a local path so users can keep the image on disk
        # (or airgap via USB) without requiring network access.
        local_path: Path | None = None
        u = (url or "").strip()
        if not u:
            raise RuntimeError("missing qcow2 url")

        parsed = urllib.parse.urlparse(u)
        if parsed.scheme:
            local_path = None
        else:
            try:
                local_path = Path(u).expanduser().resolve()
            except Exception:
                local_path = None

        if local_path is not None and local_path.exists() and local_path.is_file():
            with local_path.open("rb") as r, tmp.open("wb") as w:
                while True:
                    chunk = r.read(1024 * 1024)
                    if not chunk:
                        break
                    w.write(chunk)
                    h.update(chunk)
        else:
            with urllib.request.urlopen(u, timeout=_download_timeout_s()) as r, tmp.open("wb") as w:  # nosec - URL is user/lockfile controlled
                while True:
                    chunk = r.read(1024 * 1024)
                    if not chunk:
                        break
                    w.write(chunk)
                    h.update(chunk)
    except Exception as e:
        try:
            tmp.unlink(missing_ok=True)
        except Exception:
            pass
        raise RuntimeError(f"failed to download qcow2: {url}") from e

    got = h.hexdigest()
    if expected_sha256 and expected_sha256 != got:
        try:
            tmp.unlink(missing_ok=True)
        except Exception:
            pass
        raise RuntimeError(f"qcow2 sha256 mismatch (got {got}, want {expected_sha256})")

    # qcow2 magic bytes: "QFI\\xfb"
    try:
        head = tmp.open("rb").read(4)
        if head != b"QFI\xfb":
            raise RuntimeError("downloaded qcow2 does not look like qcow2 (bad magic)")
    except Exception as e:
        try:
            tmp.unlink(missing_ok=True)
        except Exception:
            pass
        raise RuntimeError("downloaded qcow2 verification failed") from e

    tmp.replace(dst)
    try:
        dst.chmod(0o644)
    except Exception:
        pass
    return got


def _kvm_write_installed_manifest(root: Path, *, url: str, sha256: str, path: Path, mode: str) -> None:
    base = _kvm_base(root)
    out = {
        "updated_at": _now_rfc3339_utc(),
        "mode": mode,
        "qcow2": {"url": url, "sha256": sha256, "path": str(path)},
    }
    _atomic_write(base / "installed.json", json.dumps(out, indent=2, sort_keys=True) + "\n")


def _kvm_update_lockfile_qcow2(root: Path, *, url: str, sha256: str) -> None:
    lf = lockfile_path(root)
    doc = load_lockfile_doc(lf) if lf.exists() else None
    if doc is None:
        raise RuntimeError("cannot update lockfile: sandworm.lock missing (run `sandworm lock init`)")
    try:
        doc["kvm"]["nixos"]["qcow2_url"] = url
        doc["kvm"]["nixos"]["qcow2_sha256"] = sha256
    except Exception as e:
        raise RuntimeError("failed to update sandworm.lock (missing [kvm.nixos]?)") from e
    lf.write_text(dump_lockfile_doc(doc), encoding="utf-8")


def kvm_fetch_guest_image(
    root: Path,
    *,
    url: str | None,
    sha256: str | None,
    known_good_url: str | None = None,
    known_good_sha256: str | None = None,
    force: bool = False,
    update_lock: bool = False,
) -> Path:
    """
    Fetch a qcow2 image into the KVM images dir with staging + rollback.

    Default (url None): uses sandworm.lock/env if present; otherwise falls back to nix build (if available).
    """
    _ensure_kvm_image_layout(root)
    base = _kvm_base(root)
    images = _kvm_images_dir(root)
    cur, prev, guest = _kvm_image_links(root)

    strict_supply_chain = _env_truthy("SW_STRICT_SUPPLYCHAIN") or _env_truthy("SANDWORM_STRICT_SUPPLYCHAIN")
    allow_floating_in_strict = (
        bool(update_lock) or _env_truthy("SW_ALLOW_KVM_QCOW2_FLOATING") or _env_truthy("SW_KVM_ALLOW_FLOATING_QCOW2")
    )

    lock_url, lock_sha = _kvm_lockfile_kvm_nixos(root)
    primary_url = (url or os.environ.get("SW_KVM_QCOW2_URL") or lock_url)
    primary_sha = (sha256 or os.environ.get("SW_KVM_QCOW2_SHA256") or lock_sha)
    if primary_url:
        primary_url = primary_url.strip()
    if primary_sha:
        primary_sha = primary_sha.strip()

    kg_url = (known_good_url or os.environ.get("SW_KVM_QCOW2_KNOWN_GOOD_URL"))
    kg_sha = (known_good_sha256 or os.environ.get("SW_KVM_QCOW2_KNOWN_GOOD_SHA256"))
    if kg_url:
        kg_url = kg_url.strip()
    if kg_sha:
        kg_sha = kg_sha.strip()

    if not primary_url:
        if not find_nix(root):
            raise RuntimeError("no qcow2_url configured and nix is not available (run `sandworm refresh` or provide SW_KVM_QCOW2_URL)")
        _ensure_guest_image(root, force=bool(force))
        return guest

    if (not force) and cur.exists() and guest.exists():
        return base / "guest.qcow2"

    candidates: list[tuple[str, str, str | None, str]] = []
    candidates.append(
        ("primary", str(primary_url), (str(primary_sha) if primary_sha else None), ("pinned" if primary_sha else "floating"))
    )
    if kg_url:
        candidates.append(("known_good", str(kg_url), (str(kg_sha) if kg_sha else None), "known-good"))

    if strict_supply_chain:
        pinned = [c for c in candidates if c[2] and str(c[2]).strip()]
        if pinned:
            skipped = [c for c in candidates if not (c[2] and str(c[2]).strip())]
            for _label, u, _s, _mode in skipped:
                print(
                    f"WARN: strict supply chain mode: skipping unpinned KVM qcow2 URL (missing sha256): {u}",
                    file=sys.stderr,
                )
            candidates = pinned
        else:
            if not allow_floating_in_strict:
                raise SystemExit(
                    "strict supply chain mode: KVM qcow2 fetch requires a pinned sha256 "
                    "(provide --sha256 / SW_KVM_QCOW2_SHA256 / sandworm.lock [kvm.nixos].qcow2_sha256, "
                    "or run with --update-lock to pin it)"
                )
            print(
                "WARN: strict supply chain mode: allowing unpinned KVM qcow2 fetch "
                "(explicit override via --update-lock or SW_ALLOW_KVM_QCOW2_FLOATING=1)",
                file=sys.stderr,
            )

    def attempt(u: str, s: str | None, mode: str) -> tuple[Path, str]:
        sha = (s.strip() if isinstance(s, str) and s.strip() else None)
        if sha and not re.fullmatch(r"[0-9a-fA-F]{64}", sha):
            raise SystemExit(f"kvm qcow2 sha256 must be 64 hex chars (got: {sha})")
        dst = images / f"{secrets.token_hex(4)}.qcow2"
        got = _download_file_with_sha256(u, dst=dst, expected_sha256=sha)
        img_id = got[:12]
        final = images / f"{img_id}.qcow2"
        if final.exists():
            try:
                dst.unlink(missing_ok=True)
            except Exception:
                pass
        else:
            dst.replace(final)
        _kvm_write_installed_manifest(root, url=u, sha256=got, path=final, mode=mode)
        if update_lock:
            _kvm_update_lockfile_qcow2(root, url=u, sha256=got)
        return final, got

    last_err: Exception | None = None
    for _label, u, s, mode in candidates:
        try:
            final, _got = attempt(u, s, mode)
            # Rotate links.
            if cur.exists():
                try:
                    _atomic_symlink(cur.resolve(), prev)
                except Exception:
                    pass
            _atomic_symlink(final, cur)
            _atomic_symlink(cur, guest)
            return guest
        except Exception as e:
            last_err = e
            continue

    raise RuntimeError(f"failed to fetch qcow2 image ({last_err})")


@dataclass(frozen=True)
class KvmStatus:
    running: bool
    pid: int | None
    port: int | None
    spice_port: int | None
    accel: str | None
    qemu: str | None


def kvm_status(root: Path, *, instance: str | None = None) -> KvmStatus:
    base = _kvm_state_dir(root, instance=instance)
    pid = _read_int(base / "qemu.pid")
    port = _read_int(base / "ssh.port")
    spice_port = _read_int(base / "spice.port")
    accel = None
    if (not pid) or (pid and not _pid_alive(pid)):
        # Best-effort recovery: detect orphan qemu processes for this workspace (pidfile mismatch).
        pids = _kvm_find_qemu_pids(root, instance=instance)
        if pids:
            pid = int(pids[0])
            try:
                _atomic_write(base / "qemu.pid", str(pid) + "\n")
            except Exception:
                pass
    if pid and _pid_alive(pid):
        accel_flag = (base / "accel.flag").read_text(encoding="utf-8").strip() if (base / "accel.flag").exists() else ""
        if accel_flag in ("kvm", "tcg"):
            accel = accel_flag
        else:
            accel = "kvm" if _kvm_writable() else "tcg"
        return KvmStatus(running=True, pid=pid, port=port, spice_port=spice_port, accel=accel, qemu=_qemu_system_binary())
    return KvmStatus(running=False, pid=pid, port=port, spice_port=spice_port, accel=None, qemu=_qemu_system_binary())


def kvm_doctor(root: Path) -> dict[str, object]:
    qemu_bin = _qemu_system_binary()
    have_qemu = shutil.which(qemu_bin) is not None
    have_qemu_img = shutil.which("qemu-img") is not None
    have_ssh = shutil.which("ssh") is not None
    have_ssh_keygen = shutil.which("ssh-keygen") is not None
    nix = find_nix(root)

    desired_sig = (_kvm_base(root) / "guest-config.sig").read_text(encoding="utf-8").strip() if (_kvm_base(root) / "guest-config.sig").exists() else ""
    image_sig = (_kvm_base(root) / "guest-image.sig").read_text(encoding="utf-8").strip() if (_kvm_base(root) / "guest-image.sig").exists() else ""
    stale = bool(desired_sig and image_sig and desired_sig != image_sig)
    url, sha = _kvm_lockfile_kvm_nixos(root)
    env_url = os.environ.get("SW_KVM_QCOW2_URL") or os.environ.get("SANDWORM_KVM_QCOW2_URL")
    have_url = bool((env_url and env_url.strip()) or url)
    vfs_broken = _virtiofs_broken_marker(root).exists()
    return {
        "ts": _now_rfc3339(),
        "qemu_bin": qemu_bin,
        "caps": {
            "kvm": _kvm_writable(),
            "qemu": have_qemu,
            "qemu_img": have_qemu_img,
            "nix": bool(nix),
            "ssh": have_ssh,
            "ssh_keygen": have_ssh_keygen,
            "virtiofsd": shutil.which("virtiofsd") is not None,
            "virtiofs_broken_marker": bool(vfs_broken),
        },
        "hints": {
            "qemu": (f"{Path(nix).name} shell nixpkgs#qemu --command {qemu_bin} --version" if nix and not have_qemu else None),
            "virtiofsd": (
                "install virtiofsd for faster KVM workspace mounts (virtiofs preferred; 9p fallback)"
                if not shutil.which("virtiofsd")
                else None
            ),
            "virtiofs_broken": (
                "virtiofs was previously detected as broken; Sandworm will skip it by default "
                "(run `sandworm kvm virtiofs reset` to clear the marker; retry once with `sandworm kvm up --virtiofs on`; "
                "or set SW_KVM_VIRTIOFS_FORCE=1 to retry in auto mode)"
                if vfs_broken
                else None
            ),
            "ssh": ("install openssh-client (ssh, ssh-keygen)" if not have_ssh_keygen else None),
            "image": (
                "sandworm kvm init --fetch  # or: sandworm kvm init --build"
                if have_url
                else "sandworm kvm init --build  # or set SW_KVM_QCOW2_URL and use --fetch"
            ),
            "stale_image": ("sandworm kvm init --build --force  # guest-config changed" if stale else None),
            "data_disk": ("sandworm kvm init  # creates .sandworm/kvm/data.qcow2 (persistent)" if not (_kvm_base(root) / "data.qcow2").exists() else None),
        },
        "guest": {"desired_sig": desired_sig or None, "image_sig": image_sig or None, "stale_image": stale},
        "image_source": {"qcow2_url": (env_url or url), "qcow2_sha256": sha},
        "paths": {
            "kvm_dir": str((_kvm_base(root)).resolve()),
            "guest_image": str((_kvm_base(root) / "guest.qcow2").resolve()),
            "data_disk": str((_kvm_base(root) / "data.qcow2").resolve()),
        },
    }


def _qemu_cmd(
    root: Path,
    *,
    qemu_bin: str,
    state_dir: Path,
    image: Path,
    data_disk: Path,
    ssh_port: int,
    spice_port: int | None,
    accel: str,
    log_path: Path,
    expose_private: bool,
    shares: list[tuple[str, str, str]] | None,
    gui: str,
    clipboard: bool,
    virtiofs_sock: Path | None,
    home_export: Path | None,
) -> list[str]:
    qemu_prog = _qemu_system_binary()
    if not qemu_bin:
        raise RuntimeError(f"qemu not available: {qemu_prog}")

    # 9p workspace share.
    fsdev = f"local,id=fsdev0,path={root},security_model=none,readonly=off"
    keys_dir = state_dir / "keys"
    fsdev_keys = f"local,id=fsdev_keys,path={keys_dir},security_model=none,readonly=on"
    sandbox_bin_dir = ensure_sandbox_bin_dir(root)
    fsdev_bin = f"local,id=fsdev_bin,path={sandbox_bin_dir},security_model=none,readonly=on"
    clients_dir = control_dir(root) / "clients"
    fsdev_clients = f"local,id=fsdev_clients,path={clients_dir},security_model=none,readonly=on"
    queuer_dir = control_dir(root) / "queuer"
    queuer_dir.mkdir(parents=True, exist_ok=True)
    fsdev_queuer = f"local,id=fsdev_queuer,path={queuer_dir},security_model=none,readonly=on"
    toolroot_dir = control_dir(root) / "toolroot"
    toolroot_dir.mkdir(parents=True, exist_ok=True)
    fsdev_toolroot = f"local,id=fsdev_toolroot,path={toolroot_dir},security_model=none,readonly=on"
    # Provider state lives under .sandworm/home on the host, but we do not expose the control plane at /workspace/.sandworm.
    # Export just the home subtree for cross-backend credential reuse (plaintext per current repo decision).
    #
    # DEV runner note: for host-driven test VMs, we may intentionally override the exported HOME to a
    # fresh per-run directory to avoid leaking host workspace creds into a networked guest.
    from .creds import ensure_sandworm_home

    sw_home_dir = home_export.resolve() if isinstance(home_export, Path) else ensure_sandworm_home(root)
    fsdev_sw_home = f"local,id=fsdev_sw_home,path={sw_home_dir},security_model=none,readonly=off"
    netdev = f"user,id=net0,hostfwd=tcp:127.0.0.1:{ssh_port}-:22"
    machine = "virt" if qemu_prog.endswith("aarch64") else "q35"
    cmd = [
        qemu_bin,
        "-machine",
        machine,
        "-m",
        str(_kvm_vm_mem_mb()),
        "-smp",
        "2",
        "-serial",
        f"file:{log_path}",
        "-drive",
        f"file={image},if=virtio,format=qcow2,snapshot=on",
        "-drive",
        f"file={data_disk},if=virtio,format=qcow2,cache=writeback,aio=threads,discard=unmap",
        "-fsdev",
        fsdev,
        "-device",
        "virtio-9p-pci,fsdev=fsdev0,mount_tag=workspace",
        "-fsdev",
        fsdev_keys,
        "-device",
        "virtio-9p-pci,fsdev=fsdev_keys,mount_tag=keys",
        "-fsdev",
        fsdev_bin,
        "-device",
        "virtio-9p-pci,fsdev=fsdev_bin,mount_tag=bin",
        "-fsdev",
        fsdev_clients,
        "-device",
        "virtio-9p-pci,fsdev=fsdev_clients,mount_tag=clients",
        "-fsdev",
        fsdev_queuer,
        "-device",
        "virtio-9p-pci,fsdev=fsdev_queuer,mount_tag=queuer",
        "-fsdev",
        fsdev_toolroot,
        "-device",
        "virtio-9p-pci,fsdev=fsdev_toolroot,mount_tag=toolroot",
        "-fsdev",
        fsdev_sw_home,
        "-device",
        "virtio-9p-pci,fsdev=fsdev_sw_home,mount_tag=sw_home",
        "-netdev",
        netdev,
        "-device",
        "virtio-net-pci,netdev=net0",
    ]
    if virtiofs_sock is not None:
        # Prefer virtiofs when available; guest mounts it first and falls back to 9p.
        cmd += [
            "-chardev",
            f"socket,id=chr0,path={virtiofs_sock}",
            "-device",
            "vhost-user-fs-pci,chardev=chr0,tag=workspace",
        ]
    if gui in ("on", "auto") and spice_port:
        # Headless QEMU + SPICE server; a viewer can connect separately.
        cmd += [
            "-display",
            "none",
            "-vga",
            "virtio",
            "-spice",
            f"port={int(spice_port)},addr=127.0.0.1,disable-ticketing=on",
        ]
        if clipboard:
            cmd += [
                "-device",
                "virtio-serial",
                "-chardev",
                "spicevmc,id=vdagent,name=vdagent",
                "-device",
                "virtserialport,chardev=vdagent,name=com.redhat.spice.0",
            ]
    else:
        cmd += ["-nographic"]
    if expose_private:
        priv_dir = control_dir(root) / "private"
        fsdev_priv = f"local,id=fsdev1,path={priv_dir},security_model=none,readonly=on"
        cmd += [
            "-fsdev",
            fsdev_priv,
            "-device",
            "virtio-9p-pci,fsdev=fsdev1,mount_tag=private",
        ]
    if shares:
        for i, (name, src, mode) in enumerate(shares, start=2):
            readonly = "on" if mode == "ro" else "off"
            fsdev_sh = f"local,id=fsdev{i},path={src},security_model=none,readonly={readonly}"
            cmd += [
                "-fsdev",
                fsdev_sh,
                "-device",
                f"virtio-9p-pci,fsdev=fsdev{i},mount_tag={_share_tag(name)}",
            ]
    hooks_dir = control_dir(root) / "hooks"
    if hooks_dir.exists():
        fsdev_hooks = f"local,id=fsdev_hooks,path={hooks_dir},security_model=none,readonly=on"
        cmd += [
            "-fsdev",
            fsdev_hooks,
            "-device",
            "virtio-9p-pci,fsdev=fsdev_hooks,mount_tag=hooks",
        ]
    if accel == "kvm":
        cmd += ["-accel", "kvm"]
    else:
        cmd += ["-accel", "tcg"]
    return cmd


def kvm_init(
    root: Path,
    *,
    instance: str | None = None,
    build: bool,
    force: bool,
    fetch: bool = False,
    url: str | None = None,
    sha256: str | None = None,
    known_good_url: str | None = None,
    known_good_sha256: str | None = None,
    update_lock: bool = False,
) -> dict[str, str]:
    priv, pub = _ensure_ssh_keypair(root, instance=instance)
    inputs = _write_guest_image_inputs(root)
    cfg = inputs["config"]
    data_disk = str(_ensure_kvm_data_disk(root, instance=instance, size=None))
    img = ""
    if fetch and build:
        raise RuntimeError("kvm init: choose one of --fetch or --build")
    if fetch:
        p = kvm_fetch_guest_image(
            root,
            url=url,
            sha256=sha256,
            known_good_url=known_good_url,
            known_good_sha256=known_good_sha256,
            force=bool(force),
            update_lock=bool(update_lock),
        )
        img = str(p)
    elif build:
        img = str(_ensure_guest_image(root, force=force))
    return {"ssh_private_key": str(priv), "ssh_public_key": str(pub), "config": str(cfg), "image": img, "data_disk": data_disk}

def _ssh_run(
    root: Path,
    *,
    port: int,
    privkey: Path,
    argv: list[str],
    timeout_s: int | None,
    batch: bool,
    stdin: str | None,
) -> subprocess.CompletedProcess[str]:
    ssh = shutil.which("ssh")
    if not ssh:
        raise RuntimeError("ssh not found (install openssh-client)")
    if not argv:
        raise RuntimeError("empty ssh argv")
    remote_cmd = " ".join(shlex.quote(a) for a in argv)
    cmd = [
        ssh,
        "-p",
        str(port),
        "-i",
        str(privkey),
        "-o",
        "StrictHostKeyChecking=no",
        "-o",
        "UserKnownHostsFile=/dev/null",
        "-o",
        "LogLevel=ERROR",
        "-o",
        ("BatchMode=yes" if batch else "BatchMode=no"),
        "-o",
        "ConnectTimeout=3",
        "sand@127.0.0.1",
        remote_cmd,
    ]
    return subprocess.run(cmd, cwd=root, text=True, capture_output=True, timeout=timeout_s, input=stdin)

def _ssh_call(
    root: Path,
    *,
    port: int,
    privkey: Path,
    argv: list[str],
) -> int:
    ssh = shutil.which("ssh")
    if not ssh:
        raise RuntimeError("ssh not found (install openssh-client)")
    if not argv:
        raise RuntimeError("empty ssh argv")
    remote_cmd = " ".join(shlex.quote(a) for a in argv)
    tty_args: list[str] = []
    if sys.stdin.isatty() and sys.stdout.isatty():
        tty_args = ["-tt"]
    cmd = [
        ssh,
        *tty_args,
        "-p",
        str(port),
        "-i",
        str(privkey),
        "-o",
        "StrictHostKeyChecking=no",
        "-o",
        "UserKnownHostsFile=/dev/null",
        "-o",
        "LogLevel=ERROR",
        "-o",
        "BatchMode=no",
        "sand@127.0.0.1",
        remote_cmd,
    ]
    return int(subprocess.call(cmd, cwd=root))


def _share_tag(name: str) -> str:
    safe = "".join((c if c.isalnum() else "_") for c in name)
    if not safe:
        safe = "share"
    return f"share_{safe}"


def _render_mounts_sh(
    *,
    shares: list[tuple[str, str, str]] | None,
    expose_private: bool,
    nixos_config_b64: str | None,
    nixos_config_sha256: str | None,
) -> str:
    lines: list[str] = ["#!/usr/bin/env bash", "set -euo pipefail"]
    # Always mask the host control plane inside the guest: /workspace is the shared workspace root,
    # and the host's `.sandworm/` must never be visible there.
    #
    # We implement this by mounting a tmpfs over /workspace/.sandworm and exposing only the optional
    # `/workspace/.sandworm/private` subdir (when requested) as a separate 9p mount.
    lines.append("sudo -n mkdir -p /workspace/.sandworm")
    lines.append(
        "for i in $(seq 1 40); do "
        "fstype=$(findmnt -n -o FSTYPE --target /workspace 2>/dev/null || true); "
        "case \"$fstype\" in *virtiofs*|9p*) break ;; esac; "
        "sleep 0.25; "
        "done; true"
    )
    lines.append(
        "if ! grep -q ' /workspace/.sandworm tmpfs ' /proc/mounts 2>/dev/null; then "
        "  sudo -n mount -t tmpfs -o rw,nosuid,nodev tmpfs /workspace/.sandworm >/dev/null 2>&1 || true; "
        "fi"
    )
    lines.append("sudo -n mkdir -p /workspace/.sandworm/private")
    if shares:
        lines.append("sudo -n mkdir -p /workspace/shared")
        for name, _src, mode in shares:
            opt = "ro" if mode == "ro" else "rw"
            mp = f"/workspace/shared/{name}"
            tag = _share_tag(name)
            lines.append(f"sudo -n mkdir -p {shlex.quote(mp)}")
            lines.append(
                "for i in $(seq 1 40); do "
                f"grep -q ' {shlex.quote(mp)} 9p ' /proc/mounts && break; "
                f"sudo -n mount -t 9p -o trans=virtio,msize=262144,cache=mmap,{opt} {shlex.quote(tag)} {shlex.quote(mp)} && break; "
                "sleep 0.25; "
                "done; true"
            )
    if expose_private:
        lines.append(
            "for i in $(seq 1 40); do "
            "grep -q ' /workspace/.sandworm/private 9p ' /proc/mounts && break; "
            "sudo -n mount -t 9p -o trans=virtio,msize=262144,cache=mmap,ro private /workspace/.sandworm/private && break; "
            "sleep 0.25; "
            "done; true"
        )
    # Hooks are always exported read-only (empty is fine).
    lines.append("sudo -n mkdir -p /run/sandworm/hooks")
    lines.append(
        "for i in $(seq 1 40); do "
        "grep -q ' /run/sandworm/hooks 9p ' /proc/mounts && break; "
        "sudo -n mount -t 9p -o trans=virtio,msize=262144,cache=mmap,ro hooks /run/sandworm/hooks && break; "
        "sleep 0.25; "
        "done; true"
    )
    # Provider state: cross-backend project-local HOME (host .sandworm/home), exported outside /workspace.
    lines.append("sudo -n mkdir -p /run/sandworm/home")
    lines.append(
        "for i in $(seq 1 40); do "
        "grep -q ' /run/sandworm/home 9p ' /proc/mounts && break; "
        "sudo -n mount -t 9p -o trans=virtio,msize=262144,cache=mmap,rw,nosuid,nodev sw_home /run/sandworm/home && break; "
        "sleep 0.25; "
        "done; true"
    )
    lines.append("sudo -n mkdir -p /run/sandworm/bin")
    lines.append(
        "for i in $(seq 1 40); do "
        "grep -q ' /run/sandworm/bin 9p ' /proc/mounts && break; "
        "sudo -n mount -t 9p -o trans=virtio,msize=262144,cache=mmap,ro,nosuid,nodev bin /run/sandworm/bin && break; "
        "sleep 0.25; "
        "done; true"
    )
    lines.append("sudo -n mkdir -p /run/sandworm/toolroot")
    lines.append(
        "for i in $(seq 1 40); do "
        "grep -q ' /run/sandworm/toolroot 9p ' /proc/mounts && break; "
        "sudo -n mount -t 9p -o trans=virtio,msize=262144,cache=mmap,ro,nosuid,nodev toolroot /run/sandworm/toolroot && break; "
        "sleep 0.25; "
        "done; true"
    )

    # Queue provider wrappers (read-only; prevents agents from mutating wrapper scripts).
    lines.append("sudo -n mkdir -p /run/sandworm/queuer")
    lines.append(
        "for i in $(seq 1 40); do "
        "grep -q ' /run/sandworm/queuer 9p ' /proc/mounts && break; "
        "sudo -n mount -t 9p -o trans=virtio,msize=262144,cache=mmap,ro,nosuid,nodev queuer /run/sandworm/queuer && break; "
        "sleep 0.25; "
        "done; true"
    )
    lines.append("sudo -n mkdir -p /srv/shared")
    lines.append(
        "if mount --bind /workspace/shared /srv/shared >/dev/null 2>&1; then "
        "  mount -o remount,bind,exec,nosuid,nodev /srv/shared >/dev/null 2>&1 || true; "
        "fi"
    )

    # Ensure /etc/nixos/configuration.nix exists (and is current) so agents can run nixos-rebuild inside the guest.
    # Do this as a plain file (not a Nix-managed /etc symlink) so it survives across test activations.
    if nixos_config_b64 and nixos_config_sha256:
        lines.append("sudo -n install -d -m 0755 /etc/nixos || true")
        lines.append(f'expected_sha="{nixos_config_sha256}"')
        lines.append('sig_path="/etc/nixos/.sandworm_guest_config.sha256"')
        lines.append("need_write=0")
        lines.append('if [ ! -s /etc/nixos/configuration.nix ]; then need_write=1; fi')
        lines.append('cur_sha="$(cat "$sig_path" 2>/dev/null || true)"')
        lines.append('if [ "$cur_sha" != "$expected_sha" ]; then need_write=1; fi')
        lines.append('if [ "$need_write" = 1 ]; then')
        lines.append("  cat > /tmp/sandworm-nixos-config.b64 <<'SW_NIXOS_CFG_B64_EOF'")
        lines.extend(str(nixos_config_b64).splitlines())
        lines.append("SW_NIXOS_CFG_B64_EOF")
        lines.append("  /run/current-system/sw/bin/base64 -d /tmp/sandworm-nixos-config.b64 > /tmp/sandworm-nixos-config.decoded || true")
        lines.append("  sudo -n install -m 0644 /tmp/sandworm-nixos-config.decoded /etc/nixos/configuration.nix || true")
        lines.append('  sudo -n sh -lc "printf %s \\"$expected_sha\\" > \\"$sig_path\\"" || true')
        lines.append("  rm -f /tmp/sandworm-nixos-config.b64 /tmp/sandworm-nixos-config.decoded || true")
        lines.append("fi")

    lines.append("true")
    return "\n".join(lines) + "\n"

def kvm_up(
    root: Path,
    *,
    instance: str | None = None,
    force_reboot: bool = False,
    timeout_s: int = 240,
    build_image: bool = False,
    expose_private: bool = False,
    shares: list[tuple[str, str, str]] | None = None,
    reconfigure: bool = False,
    gui: str = "off",  # off|auto|on
    clipboard: bool = True,
    accel: str = "auto",  # auto|kvm|tcg
    virtiofs: str = "auto",  # auto|on|off
    home_export: Path | None = None,
) -> KvmStatus:
    base = _kvm_state_dir(root, instance=instance)
    base.mkdir(parents=True, exist_ok=True)
    global_base = _kvm_base(root)
    try:
        from .creds import ensure_sandworm_home

        ensure_sandworm_home(root)
    except Exception:
        pass

    # Keep the on-disk guest config in sync with the current code + SSH key so we can
    # detect staleness and (when requested) rebuild the guest image.
    try:
        _priv, _pub = _ensure_ssh_keypair(root, instance=instance)
        _write_guest_config(root)
    except Exception:
        pass

    def _mount_exports(*, port: int) -> None:
        priv_key = base / "keys" / "id_ed25519"
        if not priv_key.exists():
            return
        try:
            b64_lines = None
            cfg_sha = None
            try:
                cfg_path = (_kvm_base(root) / "guest-config.nix").resolve()
                cfg_text = cfg_path.read_text(encoding="utf-8")
                b64 = base64.b64encode(cfg_text.encode("utf-8")).decode("ascii")
                b64_lines = "\n".join(b64[i : i + 76] for i in range(0, len(b64), 76))
                cfg_sha = _sha256_text(cfg_text)
            except Exception:
                b64_lines = None
                cfg_sha = None
            mounts_sh = _render_mounts_sh(
                shares=shares,
                expose_private=expose_private,
                nixos_config_b64=b64_lines,
                nixos_config_sha256=cfg_sha,
            )
            cmd = (
                "cat > /home/sand/.sandworm_mounts.sh <<'SANDWORM_EOF'\n"
                + mounts_sh
                + "SANDWORM_EOF\n"
                + "chmod +x /home/sand/.sandworm_mounts.sh\n"
                + "/home/sand/.sandworm_mounts.sh >/dev/null 2>&1 || true\n"
                + "true\n"
            )
            _ssh_run(root, port=int(port), privkey=priv_key, argv=["bash", "-lc", cmd], timeout_s=45, batch=True, stdin=None)
        except Exception:
            return

    st = kvm_status(root, instance=instance)
    if st.running and not force_reboot:
        accel_flag = (base / "accel.flag").read_text(encoding="utf-8").strip() if (base / "accel.flag").exists() else ""
        want_accel = (accel or "auto").strip().lower()
        if want_accel not in ("auto", "kvm", "tcg"):
            want_accel = "auto"
        if want_accel in ("kvm", "tcg") and accel_flag and accel_flag != want_accel:
            if reconfigure:
                force_reboot = True
            else:
                raise RuntimeError(f"kvm is already running with accel={accel_flag} (rerun with --force-reboot)")
        flag = (base / "expose_private.flag").read_text(encoding="utf-8").strip() if (base / "expose_private.flag").exists() else "0"
        if expose_private and flag != "1":
            if reconfigure:
                force_reboot = True
            else:
                raise RuntimeError("kvm is already running without private export (rerun with --force-reboot --expose-private)")
        gui_flag = (base / "gui.flag").read_text(encoding="utf-8").strip() if (base / "gui.flag").exists() else "off"
        want_gui = "off" if gui in ("off", "0", "false", "no") else "on"
        if want_gui == "on" and gui_flag != "on":
            if reconfigure:
                force_reboot = True
            else:
                raise RuntimeError("kvm is already running without GUI (rerun with --force-reboot --gui on)")
        if want_gui == "off" and gui_flag == "on":
            if reconfigure:
                force_reboot = True
            else:
                raise RuntimeError("kvm is already running with GUI enabled (rerun with --force-reboot --gui off)")
        desired = shares or []
        sig_wanted = _sha256_text(json.dumps(desired, sort_keys=True))
        sig_have = (base / "shares.sig").read_text(encoding="utf-8").strip() if (base / "shares.sig").exists() else ""
        if (sig_have != sig_wanted) and (sig_have or sig_wanted):
            if reconfigure:
                force_reboot = True
            else:
                raise RuntimeError("kvm is already running with different shares configuration (rerun with --force-reboot)")

        vfs_req = (virtiofs or "auto").strip().lower()
        if vfs_req not in ("auto", "on", "off"):
            vfs_req = "auto"
        if vfs_req in ("on", "off"):
            have_vfs = (base / "virtiofs.flag").read_text(encoding="utf-8").strip() == "1" if (base / "virtiofs.flag").exists() else False
            want_vfs = vfs_req == "on"
            if have_vfs != want_vfs:
                if reconfigure:
                    force_reboot = True
                else:
                    raise RuntimeError(
                        f"kvm is already running with virtiofs={'on' if have_vfs else 'off'} (rerun with --force-reboot --virtiofs {vfs_req})"
                    )
        if not force_reboot:
            if st.port:
                _mount_exports(port=int(st.port))
            return st
    if st.running and force_reboot and st.pid:
        try:
            os.kill(st.pid, signal.SIGTERM)
        except Exception:
            pass
        time.sleep(0.2)

    img = global_base / "guest.qcow2"
    fetch_err: Exception | None = None
    if not img.exists():
        # Best-effort: try fetch if configured, otherwise fall back to build (noob path).
        if _kvm_image_url_configured(root):
            try:
                _ = kvm_fetch_guest_image(root, url=None, sha256=None, force=False, update_lock=False)
            except Exception as e:
                fetch_err = e
        if not img.exists():
            if build_image or (not _kvm_image_url_configured(root)):
                if not _kvm_image_url_configured(root):
                    print("INFO: no qcow2 URL configured; building guest image via nix (this may take a while).", file=sys.stderr)
                _ensure_guest_image(root, force=False)
            else:
                # Fetch was expected to work. For noob UX, optionally fall back to build if nix is available.
                if os.environ.get("SW_KVM_FALLBACK_BUILD", "1") != "0" and find_nix(root):
                    print(f"WARN: qcow2 fetch failed ({fetch_err}); falling back to nix build (may take a while).", file=sys.stderr)
                    _ensure_guest_image(root, force=False)
                else:
                    extra = f" (fetch failed: {fetch_err})" if fetch_err else ""
                    raise RuntimeError(f"guest image missing: {img}{extra} (run `sandworm kvm init --fetch` or `sandworm kvm init --build`)")
    else:
        desired_sig = (global_base / "guest-config.sig").read_text(encoding="utf-8").strip() if (global_base / "guest-config.sig").exists() else ""
        image_sig = (global_base / "guest-image.sig").read_text(encoding="utf-8").strip() if (global_base / "guest-image.sig").exists() else ""
        stale = bool(desired_sig and image_sig and desired_sig != image_sig)
        if stale:
            if build_image:
                # The user explicitly asked to build; treat a stale/missing signature as "needs rebuild".
                _ensure_guest_image(root, force=True)
            else:
                print(
                    "WARN: KVM guest image may be stale (guest-config changed); rebuild with `sandworm kvm init --build --force` or `sandworm kvm up --build`.",
                    file=sys.stderr,
                )
    if not os.access(img, os.W_OK):
        try:
            img.chmod(img.stat().st_mode | 0o200)
        except Exception:
            raise RuntimeError(f"guest image is not writable: {img}")

    priv, pub = _ensure_ssh_keypair(root, instance=instance)
    _ = pub

    port_path = base / "ssh.port"
    port = _read_int(port_path) or _free_tcp_port()
    _atomic_write(port_path, str(port) + "\n")

    spice_port_path = base / "spice.port"
    spice_port: int | None = None
    if gui not in ("off", "0", "false", "no"):
        spice_port = _read_int(spice_port_path) or _free_tcp_port()
        _atomic_write(spice_port_path, str(spice_port) + "\n")
        (base / "gui.flag").write_text("on\n", encoding="utf-8")
        (base / "clipboard.flag").write_text(("1\n" if clipboard else "0\n"), encoding="utf-8")
    else:
        try:
            spice_port_path.unlink(missing_ok=True)
        except Exception:
            pass
        (base / "gui.flag").write_text("off\n", encoding="utf-8")
        (base / "clipboard.flag").write_text("0\n", encoding="utf-8")

    want_accel2 = (accel or "auto").strip().lower()
    if want_accel2 not in ("auto", "kvm", "tcg"):
        want_accel2 = "auto"
    if want_accel2 == "kvm" and not _kvm_writable():
        raise RuntimeError("/dev/kvm is not writable; cannot start with accel=kvm")
    accel = ("kvm" if _kvm_writable() else "tcg") if want_accel2 == "auto" else want_accel2

    # Resolve qemu once per boot attempt (may use nix).
    qemu_bin = _resolve_qemu_bin(root)

    log_path = base / "serial.log"
    pidfile = base / "qemu.pid"
    (base / "accel.flag").write_text(f"{accel}\n", encoding="utf-8")
    (base / "expose_private.flag").write_text(("1\n" if expose_private else "0\n"), encoding="utf-8")
    (base / "shares.sig").write_text(_sha256_text(json.dumps(shares or [], sort_keys=True)) + "\n", encoding="utf-8")
    if shares:
        try:
            (base / "shares.json").write_text(json.dumps(shares, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        except Exception:
            pass

    stdout_log = base / "qemu.stdout.log"
    stderr_log = base / "qemu.stderr.log"
    virtiofs_log = base / "virtiofsd.log"
    virtiofs_pidfile = base / "virtiofsd.pid"
    virtiofs_sock = _virtiofs_socket_path(base)
    virtiofs_sock_path = base / "virtiofsd.sock.path"
    virtiofs_flag = base / "virtiofs.flag"

    try:
        log_path.write_text("", encoding="utf-8")
        stdout_log.write_text("", encoding="utf-8")
        stderr_log.write_text("", encoding="utf-8")
        virtiofs_log.write_text("", encoding="utf-8")
    except Exception:
        pass
    try:
        _atomic_write(virtiofs_sock_path, str(virtiofs_sock))
    except Exception:
        pass

    data_disk = _ensure_kvm_data_disk(root, instance=instance, size=None)

    virtiofs_enabled = False
    virtiofs_proc: subprocess.Popen[bytes] | None = None

    def _mark_virtiofs_broken(reason: str) -> None:
        try:
            marker = _virtiofs_broken_marker(root)
            detail = (
                f"ts={_now_rfc3339()}\n"
                f"reason={reason}\n"
                f"qemu={qemu_bin}\n"
                f"virtiofsd={shutil.which('virtiofsd') or ''}\n"
                f"qemu.stderr.tail=\n{_tail_file(stderr_log, 60)}\n"
                f"virtiofsd.log.tail=\n{_tail_file(virtiofs_log, 60)}\n"
            )
            _atomic_write(marker, detail)
        except Exception:
            pass

    try:
        allow_vfs, _why = _virtiofs_allow(root, requested=str(virtiofs))
        argv_vfs = _virtiofsd_argv(qemu_bin=qemu_bin, root=root, socket_path=virtiofs_sock, shared_dir=root) if allow_vfs else None
        if argv_vfs:
            try:
                virtiofs_sock.unlink(missing_ok=True)
            except Exception:
                pass
            with virtiofs_log.open("ab") as vfslog:
                virtiofs_proc = subprocess.Popen(argv_vfs, cwd=root, stdout=vfslog, stderr=vfslog, start_new_session=True)
            _atomic_write(virtiofs_pidfile, str(int(virtiofs_proc.pid)) + "\n")
            virtiofs_enabled = True
            # Avoid a race: ensure the socket appears before starting QEMU.
            for _i in range(40):
                if virtiofs_sock.exists():
                    break
                time.sleep(0.05)
    except Exception:
        virtiofs_enabled = False
        virtiofs_proc = None
    try:
        virtiofs_flag.write_text(("1\n" if virtiofs_enabled else "0\n"), encoding="utf-8")
    except Exception:
        pass

    def _stop_virtiofsd() -> None:
        nonlocal virtiofs_enabled, virtiofs_proc
        pid = _read_int(virtiofs_pidfile)
        if virtiofs_proc is not None:
            try:
                virtiofs_proc.terminate()
            except Exception:
                pass
        if pid and _pid_alive(int(pid)):
            try:
                os.kill(int(pid), signal.SIGTERM)
            except Exception:
                pass
            deadline = time.time() + 2.0
            while time.time() < deadline and _pid_alive(int(pid)):
                time.sleep(0.05)
            if _pid_alive(int(pid)):
                try:
                    os.kill(int(pid), signal.SIGKILL)
                except Exception:
                    pass
        try:
            virtiofs_pidfile.unlink(missing_ok=True)
        except Exception:
            pass
        try:
            virtiofs_sock.unlink(missing_ok=True)
        except Exception:
            pass
        virtiofs_enabled = False
        virtiofs_proc = None
        try:
            virtiofs_flag.write_text("0\n", encoding="utf-8")
        except Exception:
            pass

    def _virtiofs_looks_broken() -> bool:
        # Some virtiofsd/QEMU/kernel combinations fail in a way that can hang guest mount attempts.
        # If we see these signatures during boot, fall back to 9p by restarting without virtiofs.
        err = (_tail_file(stderr_log, 120) + "\n" + _tail_file(virtiofs_log, 120)).lower()
        sigs = [
            "handlerequest(invalidparam)",
            "invalidparam",
            "vhost vq",
            "error starting vhost",
            "vhost_set_vring_call failed",
            "failed to set msg fds",
            "failed to read msg header",
            "unexpected end-of-file",
        ]
        return virtiofs_enabled and any(s in err for s in sigs)

    def start_once() -> subprocess.Popen[str]:
        cmd = _qemu_cmd(
            root,
            qemu_bin=qemu_bin,
            state_dir=base,
            image=img,
            data_disk=data_disk,
            ssh_port=port,
            spice_port=spice_port,
            accel=accel,
            log_path=log_path,
            expose_private=expose_private,
            shares=shares,
            gui=gui,
            clipboard=bool(clipboard),
            virtiofs_sock=(virtiofs_sock if virtiofs_enabled else None),
            home_export=home_export,
        )
        with stdout_log.open("ab") as out, stderr_log.open("ab") as err:
            return subprocess.Popen(cmd, cwd=root, stdout=out, stderr=err, start_new_session=True)

    def boot_once() -> KvmStatus:
        deadline = time.time() + float(timeout_s)
        last_err_tail2 = ""
        for attempt in range(1, 3):
            proc = start_once()
            _atomic_write(pidfile, str(proc.pid) + "\n")

            while time.time() < deadline:
                if not _pid_alive(proc.pid):
                    last_err_tail2 = _tail_file(stderr_log, 80)
                    serial_tail2 = _tail_file(log_path, 80)
                    if virtiofs_enabled and (
                        "vhost-user-fs" in last_err_tail2.lower()
                        or "unknown device" in last_err_tail2.lower()
                        or "invalid device" in last_err_tail2.lower()
                    ):
                        # Virtiofs is best-effort; if QEMU rejects the device, retry without it.
                        _mark_virtiofs_broken("qemu_rejected_vhost_user_fs")
                        _stop_virtiofsd()
                        if attempt < 2:
                            break
                    if _virtiofs_looks_broken():
                        _mark_virtiofs_broken("virtiofs_runtime_error")
                        _stop_virtiofsd()
                        if attempt < 2:
                            break
                    if "hostfwd" in last_err_tail2.lower() or "address already in use" in last_err_tail2.lower():
                        if attempt < 2:
                            port2 = _free_tcp_port()
                            nonlocal port
                            port = port2
                            _atomic_write(port_path, str(port) + "\n")
                            break
                    raise RuntimeError(
                        "qemu exited while waiting for ssh\n"
                        f"qemu.stderr.log tail:\n{last_err_tail2}\n"
                        f"serial.log tail:\n{serial_tail2}"
                    )
                try:
                    if _virtiofs_looks_broken():
                        # Proactively restart without virtiofs to avoid hanging guest operations.
                        _mark_virtiofs_broken("virtiofs_runtime_error")
                        _stop_virtiofsd()
                        kvm_down(root, instance=instance)
                        if attempt < 2:
                            break
                    out = _ssh_run(
                        root,
                        port=int(port),
                        privkey=priv,
                        argv=[
                            "bash",
                            "-lc",
                            "set -e; "
                            "mountpoint -q /workspace; "
                            "fstype=$(findmnt -n -o FSTYPE --target /workspace 2>/dev/null || true); "
                            "case \"$fstype\" in *virtiofs*|9p*) exit 0 ;; *) echo \"fstype=$fstype\" >&2; exit 1 ;; esac",
                        ],
                        timeout_s=5,
                        batch=True,
                        stdin=None,
                    )
                    if out.returncode == 0:
                        _mount_exports(port=int(port))
                        try:
                            fs = _ssh_run(root, port=int(port), privkey=priv, argv=["bash", "-lc", "findmnt -n -o FSTYPE --target /workspace 2>/dev/null || true"], timeout_s=5, batch=True, stdin=None)
                            if fs.returncode == 0:
                                got = (fs.stdout or "").strip()
                                if got:
                                    (base / "workspace.fstype").write_text(got + "\n", encoding="utf-8")
                                    if "virtiofs" in got.lower():
                                        try:
                                            _virtiofs_broken_marker(root).unlink(missing_ok=True)
                                        except Exception:
                                            pass
                        except Exception:
                            pass
                        return kvm_status(root, instance=instance)
                except Exception:
                    pass
                time.sleep(0.25)

        serial_tail2 = _tail_file(log_path, 120)
        last_err_tail2 = last_err_tail2 or _tail_file(stderr_log, 120)
        raise RuntimeError(
            "ssh readiness timeout\n"
            f"qemu.stderr.log tail:\n{last_err_tail2}\n"
            f"serial.log tail:\n{serial_tail2}"
        )

    try:
        return boot_once()
    except Exception as e:
        # Best-effort rollback to previous image if present.
        if os.environ.get("SW_KVM_AUTO_ROLLBACK", "1") != "0":
            try:
                _ensure_kvm_image_layout(root)
                cur_link, prev_link, guest_link = _kvm_image_links(root)
                if cur_link.exists() and prev_link.exists() and guest_link.exists():
                    cur_target = cur_link.resolve() if cur_link.is_symlink() else cur_link
                    prev_target = prev_link.resolve() if prev_link.is_symlink() else prev_link
                    if cur_target != prev_target:
                        # Rollback is an error path; keep it conservative and disable virtiofs retries.
                        _stop_virtiofsd()
                        kvm_down(root, instance=instance)
                        _atomic_symlink(prev_target, cur_link)
                        _atomic_symlink(cur_link, guest_link)
                        stderr_log.write_text(stderr_log.read_text(encoding="utf-8", errors="ignore") + "\n[sandworm] auto-rollback: retrying with previous qcow2\n", encoding="utf-8")
                        return boot_once()
            except Exception:
                pass
        try:
            _stop_virtiofsd()
        except Exception:
            pass
        raise


def kvm_down(root: Path, *, instance: str | None = None, purge: bool = False) -> bool:
    base = _kvm_state_dir(root, instance=instance)
    killed_any = False

    # Best-effort: stop virtiofsd for this instance (if present).
    try:
        vpid = _read_int(base / "virtiofsd.pid")
        if vpid and _pid_alive(int(vpid)):
            try:
                os.kill(int(vpid), signal.SIGTERM)
                killed_any = True
            except Exception:
                pass
            deadline = time.time() + 2.0
            while time.time() < deadline and _pid_alive(int(vpid)):
                time.sleep(0.05)
            if _pid_alive(int(vpid)):
                try:
                    os.kill(int(vpid), signal.SIGKILL)
                    killed_any = True
                except Exception:
                    pass
        (base / "virtiofsd.pid").unlink(missing_ok=True)
        sock_path = base / "virtiofsd.sock"
        try:
            spath = (base / "virtiofsd.sock.path").read_text(encoding="utf-8").strip()
            if spath:
                sock_path = Path(spath)
        except Exception:
            pass
        try:
            sock_path.unlink(missing_ok=True)
        except Exception:
            pass
        (base / "virtiofsd.sock.path").unlink(missing_ok=True)
        (base / "virtiofs.flag").unlink(missing_ok=True)
    except Exception:
        pass

    pids: list[int] = []
    pid_file = _read_int(base / "qemu.pid")
    if pid_file:
        pids.append(int(pid_file))
    pids.extend(_kvm_find_qemu_pids(root, instance=instance))
    pids = sorted({p for p in pids if p > 1})
    if not pids:
        return killed_any

    for pid in pids:
        if not _pid_alive(pid):
            continue
        try:
            os.kill(pid, signal.SIGTERM)
            killed_any = True
        except Exception:
            continue

    deadline = time.time() + 5.0
    while time.time() < deadline:
        if not any(_pid_alive(p) for p in pids):
            break
        time.sleep(0.1)

    for pid in pids:
        if _pid_alive(pid):
            try:
                os.kill(pid, signal.SIGKILL)
                killed_any = True
            except Exception:
                pass

    try:
        (base / "qemu.pid").unlink()
    except Exception:
        pass
    if purge:
        # Never purge the default instance (it's the user-facing one).
        try:
            if _kvm_instance_name(instance) != "default":
                shutil.rmtree(base, ignore_errors=True)
        except Exception:
            pass
    return killed_any


def kvm_exec(
    root: Path, argv: list[str], *, instance: str | None = None, timeout_s: int | None, stdin: str | None = None
) -> subprocess.CompletedProcess[str]:
    st = kvm_status(root, instance=instance)
    if not st.running or not st.port:
        raise RuntimeError("kvm is not running (use `sandworm kvm up`)")
    priv = _kvm_state_dir(root, instance=instance) / "keys" / "id_ed25519"
    if not priv.exists():
        raise RuntimeError("missing ssh key (run `sandworm kvm init`)")
    return _ssh_run(root, port=int(st.port), privkey=priv, argv=argv, timeout_s=timeout_s, batch=True, stdin=stdin)


def kvm_exec_in_dir(
    root: Path,
    argv: list[str],
    *,
    instance: str | None = None,
    workdir: str,
    timeout_s: int | None,
    env: dict[str, str] | None = None,
    stdin: str | None = None,
) -> subprocess.CompletedProcess[str]:
    if not argv:
        raise RuntimeError("empty argv")
    try:
        from .selfdocs import write_self_docs

        write_self_docs(
            root,
            backend="kvm",
            posture="safe",
            network_requested="user",
            network_selected="user",
            network_attempts=[{"network": "user"}],
            offline=False,
            strict=None,
            provider=None,
            provider_mode=None,
            image=None,
            shares=None,
            expose_private=None,
        )
    except Exception:
        pass
    wd = shlex.quote(workdir or "/workspace")
    cmd = " ".join(shlex.quote(a) for a in argv)
    exports: list[str] = []
    if env:
        for k, v in env.items():
            if not isinstance(k, str) or not k:
                continue
            if not isinstance(v, str):
                v = str(v)
            if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", k):
                continue
            exports.append(f"{k}={shlex.quote(v)}")
    export_prefix = (f"export {' '.join(exports)}; " if exports else "")
    pre = export_prefix + (
        # Prefer the guest's native NixOS tooling when present (more stable and typically lower overhead
        # than nix-portable). Keep /run/sandworm/* on PATH for Sandworm-provided wrappers.
        "export PATH=/run/wrappers/bin:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/usr/sbin:/sbin:/run/sandworm/bin:/run/sandworm/queuer/bin:/run/sandworm/clients/bin:/run/sandworm/toolroot/bin:/home/sand/.nix-profile/bin:${PATH:-}; "
        "export SANDWORM_BIN=/run/sandworm/bin/sandworm; "
        "if [ -x /run/current-system/sw/bin/nix ]; then export SW_NIX=/run/current-system/sw/bin/nix; export SANDWORM_NIX=/run/current-system/sw/bin/nix; fi; "
        "if [ -z \"${SW_PODMAN_BIN:-}\" ] && [ -z \"${SANDWORM_PODMAN_BIN:-}\" ]; then "
        "  for p in /run/current-system/sw/bin/podman /run/wrappers/bin/podman /nix/var/nix/profiles/default/bin/podman /usr/bin/podman /usr/sbin/podman /bin/podman /sbin/podman; do "
        "    if [ -x \"$p\" ]; then export SW_PODMAN_BIN=\"$p\"; break; fi; "
        "  done; "
        "  if [ -z \"${SW_PODMAN_BIN:-}\" ] && command -v podman >/dev/null 2>&1; then export SW_PODMAN_BIN=\"$(command -v podman)\"; fi; "
        "fi; "
        "for d in /home/sand/.nix-profile/lib/python*/site-packages; do if [ -d \"$d\" ]; then export PYTHONPATH=\"$d${PYTHONPATH:+:$PYTHONPATH}\"; break; fi; done; "
        "if [ -x /home/sand/.sandworm_mounts.sh ]; then /home/sand/.sandworm_mounts.sh >/dev/null 2>&1 || true; fi; "
        # HOME policy:
        # - default ("sw_home"): use /run/sandworm/home (a host-exported .sandworm/home subtree) for
        #   convenient cross-backend credential reuse in interactive sessions.
        # - "ssh": preserve the SSH user's HOME (/home/sand) and *do not* set SANDWORM_HOME, which is
        #   an explicit Sandworm override and can break SAFE-default behavior in tests that create temp roots.
        "home_mode=${SW_KVM_EXEC_HOME_MODE:-${SANDWORM_KVM_EXEC_HOME_MODE:-sw_home}}; "
        "case \"$home_mode\" in "
        "  ''|sw_home) "
        "    export SANDWORM_HOME=/run/sandworm/home; export HOME=/run/sandworm/home; "
        "    export XDG_CONFIG_HOME=/run/sandworm/home/.config; export XDG_DATA_HOME=/run/sandworm/home/.local/share; export XDG_CACHE_HOME=/run/sandworm/home/.cache; "
        "  ;; "
        "  *) "
        "    if [ \"${SANDWORM_HOME:-}\" = \"/run/sandworm/home\" ]; then unset SANDWORM_HOME; fi; "
        "    if [ -z \"${HOME:-}\" ]; then export HOME=/home/sand; fi; "
        "    export XDG_CONFIG_HOME=\"${XDG_CONFIG_HOME:-${HOME}/.config}\"; "
        "    export XDG_DATA_HOME=\"${XDG_DATA_HOME:-${HOME}/.local/share}\"; "
        "    export XDG_CACHE_HOME=\"${XDG_CACHE_HOME:-${HOME}/.cache}\"; "
        "  ;; "
        "esac; "
        # Podman persists absolute paths in its rootless sqlite DBConfig under $XDG_DATA_HOME.
        # If that DB is created from a different context (e.g., host-side path), podman in-guest
        # can fail with "database static dir \"\" does not match our static dir ...".
        # Self-heal by clearing the broken store before handing control to the user command.
        "if command -v podman >/dev/null 2>&1 && [ -f \"${XDG_DATA_HOME:-$HOME/.local/share}/containers/storage/db.sql\" ]; then "
        "  out=$(podman info 2>&1); rc=$?; "
        "  if [ \"$rc\" -ne 0 ] && printf '%s' \"$out\" | grep -q 'database static dir'; then "
        "    rm -rf \"${XDG_DATA_HOME:-$HOME/.local/share}/containers\" >/dev/null 2>&1 || true; "
        "    mkdir -p \"${XDG_DATA_HOME:-$HOME/.local/share}\" >/dev/null 2>&1 || true; "
        "  fi; "
        "fi; "
        "case \"${NIX_CONFIG:-}\" in *experimental-features*) true ;; *) "
        "if [ ! -f \"${XDG_CONFIG_HOME:-$HOME/.config}/nix/nix.conf\" ]; then "
        "if [ -n \"${NIX_CONFIG:-}\" ]; then export NIX_CONFIG=\"${NIX_CONFIG}\"$'\\n''experimental-features = nix-command flakes'; "
        "else export NIX_CONFIG='experimental-features = nix-command flakes'; fi; "
        "fi; "
        "esac; "
        "export SANDWORM_BACKEND=kvm; "
        "fstype=$(findmnt -n -o FSTYPE --target /workspace 2>/dev/null || true); "
        "case \"$fstype\" in *virtiofs*|9p*) true ;; *) echo \"ERROR: /workspace not mounted (fstype=$fstype)\" >&2; exit 43 ;; esac; "
        "cpfs=$(findmnt -n -o FSTYPE --target /workspace/.sandworm 2>/dev/null || true); "
        "test \"$cpfs\" = tmpfs || { echo 'ERROR: control plane is visible at /workspace/.sandworm' >&2; exit 42; };"
    )
    return kvm_exec(root, ["bash", "-lc", f"{pre} cd {wd} && exec {cmd}"], instance=instance, timeout_s=timeout_s, stdin=stdin)


