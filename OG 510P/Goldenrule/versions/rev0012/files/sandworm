def _normalize_before_commands(raw: object) -> tuple[str, ...]:
    if not isinstance(raw, list):
        raise StateBackupError("rollback policy: before_commands must be an array")
    out: list[str] = []
    seen: set[str] = set()
    for it in raw:
        if not isinstance(it, str):
            raise StateBackupError("rollback policy: before_commands must contain strings")
        name = it.strip().lower()
        if not name:
            continue
        if name not in _ROLLBACK_POLICY_COMMANDS:
            raise StateBackupError(
                "rollback policy: unsupported command family in before_commands: "
                f"{name!r} (supported: {', '.join(_ROLLBACK_POLICY_COMMANDS)})"
            )
        if name in seen:
            continue
        seen.add(name)
        out.append(name)
    return tuple(out)


def _policy_to_doc(policy: RollbackPolicy) -> dict[str, object]:
    return {
        "schema": policy.schema,
        "enabled": bool(policy.enabled),
        "before_commands": list(policy.before_commands),
        "pointer": bool(policy.pointer),
        "include_volatile": bool(policy.include_volatile),
        "include_entrypoint": bool(policy.include_entrypoint),
        "keep": int(policy.keep),
        "older_than_days": (None if policy.older_than_days is None else float(policy.older_than_days)),
    }


def _policy_from_doc(doc: object) -> RollbackPolicy:
    if not isinstance(doc, dict):
        raise StateBackupError("rollback policy: expected a JSON object")
    schema = str(doc.get("schema") or "").strip()
    if schema and schema != _ROLLBACK_POLICY_SCHEMA:
        raise StateBackupError(f"rollback policy: unsupported schema: {schema!r}")
    defaults = default_rollback_policy()
    before = _normalize_before_commands(doc.get("before_commands", list(defaults.before_commands)))
    enabled_raw = doc.get("enabled", bool(before))
    if not isinstance(enabled_raw, bool):
        raise StateBackupError("rollback policy: enabled must be a boolean")
    enabled = bool(enabled_raw and before)
    pointer_raw = doc.get("pointer", defaults.pointer)
    if not isinstance(pointer_raw, bool):
        raise StateBackupError("rollback policy: pointer must be a boolean")
    include_volatile_raw = doc.get("include_volatile", defaults.include_volatile)
    if not isinstance(include_volatile_raw, bool):
        raise StateBackupError("rollback policy: include_volatile must be a boolean")
    include_entrypoint_raw = doc.get("include_entrypoint", defaults.include_entrypoint)
    if not isinstance(include_entrypoint_raw, bool):
        raise StateBackupError("rollback policy: include_entrypoint must be a boolean")

    keep_raw = doc.get("keep", defaults.keep)
    if not isinstance(keep_raw, int):
        raise StateBackupError("rollback policy: keep must be an integer")
    if keep_raw < 0:
        raise StateBackupError("rollback policy: keep must be >= 0")

    older_raw = doc.get("older_than_days", defaults.older_than_days)
    older: float | None
    if older_raw is None:
        older = None
    elif isinstance(older_raw, (int, float)):
        older = float(older_raw)
        if older < 0:
            raise StateBackupError("rollback policy: older_than_days must be >= 0")
    else:
        raise StateBackupError("rollback policy: older_than_days must be a number or null")

    return RollbackPolicy(
        schema=_ROLLBACK_POLICY_SCHEMA,
        enabled=enabled,
        before_commands=before,
        pointer=bool(pointer_raw),
        include_volatile=bool(include_volatile_raw),
        include_entrypoint=bool(include_entrypoint_raw),
        keep=int(keep_raw),
        older_than_days=older,
    )


def load_rollback_policy(*, root: Path) -> RollbackPolicy:
    p = rollback_policy_path(root)
    if not p.exists():
        return default_rollback_policy()
    try:
        doc = json.loads(p.read_text(encoding="utf-8", errors="replace"))
    except Exception as e:
        raise StateBackupError(f"rollback policy: failed to parse {p}: {e}") from e
    return _policy_from_doc(doc)


