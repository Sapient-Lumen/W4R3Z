def _ignore_unreadable_names(dirpath: str, names: list[str]) -> set[str]:
    ignored: set[str] = set()
    for name in names:
        p = Path(dirpath) / name
        try:
            if not os.access(str(p), os.R_OK):
                ignored.add(name)
        except Exception:
            ignored.add(name)
    return ignored


def _copy_control_plane(src: Path, dst: Path, *, include_volatile: bool) -> tuple[list[str], list[str]]:
    copied: list[str] = []
    skipped: list[str] = []
    skip_names = {"state-backups"}
    if not include_volatile:
        skip_names.update({"locks", "tmp", "cache"})
    dst.mkdir(parents=True, exist_ok=True)
    for entry in sorted(src.iterdir(), key=lambda p: p.name):
        name = entry.name
        if name in skip_names:
            continue
        target = dst / name
        try:
            if entry.is_dir():
                shutil.copytree(
                    entry,
                    target,
                    symlinks=True,
                    ignore=lambda d, ns: _ignore_unreadable_names(d, list(ns)),
                )
            else:
                shutil.copy2(entry, target, follow_symlinks=False)
            copied.append(name)
        except Exception as e:
            skipped.append(f"{name}: {e}")
    return copied, skipped


def create_state_backup(
    *,
    root: Path,
    label: str | None,
    include_volatile: bool,
    include_entrypoint: bool,
    pointer_only: bool,
    trigger_command: str | None = None,
    trigger_run_id: str | None = None,
    trigger_source: str | None = None,
) -> StateBackupCreateResult:
    root = root.resolve()
    selected = control_dir(root).resolve()
    require_control_plane_marker(selected)

    out_root = state_backups_dir(root)
    out_root.mkdir(parents=True, exist_ok=True)
    snapshot_id, out_dir = _next_snapshot_dir(out_root, label=label)
    out_dir.mkdir(parents=True, exist_ok=False)

    copied: list[str] = []
    skipped: list[str] = []
    snapshot_mode = ("pointer" if pointer_only else "copy")
    if not pointer_only:
        control_dst = (out_dir / "control-plane").resolve()
        try:
            copied, skipped = _copy_control_plane(selected, control_dst, include_volatile=include_volatile)
        except Exception as e:
            try:
                shutil.rmtree(out_dir, ignore_errors=True)
            except Exception:
                pass
            raise StateBackupError(f"failed to create state snapshot at {out_dir}: {e}") from e

    entrypoint_meta: dict[str, object] = {}
    if include_entrypoint:
        ep_dir = (out_dir / "entrypoint").resolve()
        ep_dir.mkdir(parents=True, exist_ok=True)
        for rel in ("sandworm", "dist/sandworm"):
            src = (root / rel).resolve()
            if not src.exists() or not src.is_file():
                continue
            dst_name = rel.replace("/", "__")
            dst = (ep_dir / dst_name).resolve()
            shutil.copy2(src, dst)
            try:
                dst.chmod(0o755)
            except Exception:
                pass
            entrypoint_meta[rel] = {
                "snapshot_path": str(dst),
                "sha256": _sha256_file(dst),
                "looks_like_singlefile": _looks_like_singlefile(dst),
            }

    meta = {
        "schema": "sandworm.state_backup.v1",
        "snapshot_id": snapshot_id,
        "created_at": _now_rfc3339_utc(),
        "root": str(root),
        "state_root_selected": str(selected),
        "snapshot_mode": snapshot_mode,
        "state_root_pointer": (str(selected) if pointer_only else None),
        "include_volatile": bool(include_volatile),
        "copied_top_level": copied,
        "skipped": skipped,
        "entrypoints": entrypoint_meta,
        "label": (label or None),
    }
    trigger: dict[str, object] = {}
    if isinstance(trigger_command, str) and trigger_command.strip():
        trigger["command"] = trigger_command.strip()
    if isinstance(trigger_run_id, str) and trigger_run_id.strip():
        trigger["run_id"] = trigger_run_id.strip()
    if isinstance(trigger_source, str) and trigger_source.strip():
        trigger["source"] = trigger_source.strip()
    if trigger:
        meta["trigger"] = trigger
    meta_path = (out_dir / "meta.json").resolve()
    meta_path.write_text(json.dumps(meta, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return StateBackupCreateResult(
        ok=True,
        snapshot_id=snapshot_id,
        path=str(out_dir),
        state_root_selected=str(selected),
        metadata_path=str(meta_path),
        skipped=skipped,
        snapshot_mode=snapshot_mode,
    )


def _read_meta(path: Path) -> dict[str, object]:
    p = (path / "meta.json").resolve()
    if not p.exists():
        return {}
    try:
        obj = json.loads(p.read_text(encoding="utf-8", errors="replace"))
    except Exception:
        return {}
    return obj if isinstance(obj, dict) else {}


def list_state_backups(*, root: Path) -> list[dict[str, object]]:
    out: list[dict[str, object]] = []
    d = state_backups_dir(root)
    if not d.exists():
        return out
    for p in sorted([x for x in d.iterdir() if x.is_dir()], key=lambda x: x.name, reverse=True):
        meta = _read_meta(p)
        out.append(
            {
                "snapshot_id": str(meta.get("snapshot_id") or p.name),
                "path": str(p.resolve()),
                "created_at": meta.get("created_at"),
                "snapshot_mode": (meta.get("snapshot_mode") or "copy"),
                "state_root_selected": meta.get("state_root_selected"),
                "label": meta.get("label"),
                "has_entrypoints": bool(isinstance(meta.get("entrypoints"), dict) and (meta.get("entrypoints") or {})),
                "trigger_command": (
                    str((meta.get("trigger") or {}).get("command"))
                    if isinstance(meta.get("trigger"), dict) and isinstance((meta.get("trigger") or {}).get("command"), str)
                    else None
                ),
                "trigger_run_id": (
                    str((meta.get("trigger") or {}).get("run_id"))
                    if isinstance(meta.get("trigger"), dict) and isinstance((meta.get("trigger") or {}).get("run_id"), str)
                    else None
                ),
                "trigger_source": (
                    str((meta.get("trigger") or {}).get("source"))
                    if isinstance(meta.get("trigger"), dict) and isinstance((meta.get("trigger") or {}).get("source"), str)
                    else None
                ),
            }
        )
    return out


def _snapshot_dirs(root: Path) -> list[Path]:
    d = state_backups_dir(root)
    if not d.exists():
        return []
    return sorted([x for x in d.iterdir() if x.is_dir()], key=lambda x: x.name, reverse=True)


def _verify_snapshot_dir(path: Path) -> StateBackupVerifyResult:
    meta = _read_meta(path)
    errors: list[str] = []
    warnings: list[str] = []
    details: dict[str, object] = {}

    snapshot_id = str(meta.get("snapshot_id") or path.name)
    if snapshot_id != path.name:
        warnings.append(f"snapshot_id mismatch: meta={snapshot_id} dir={path.name}")
    schema = meta.get("schema")
    if schema != "sandworm.state_backup.v1":
        errors.append(f"unsupported schema: {schema!r}")
    mode = str(meta.get("snapshot_mode") or "copy").strip().lower() or "copy"
    if mode not in ("copy", "pointer"):
        errors.append(f"unsupported snapshot_mode: {mode!r}")
    details["created_at"] = meta.get("created_at")
    details["label"] = meta.get("label")
    details["state_root_selected"] = meta.get("state_root_selected")

    if mode == "copy":
        src_state = (path / "control-plane").resolve()
        if not src_state.exists() or not src_state.is_dir():
            errors.append(f"missing control-plane snapshot directory: {src_state}")
        else:
            try:
                require_control_plane_marker(src_state)
            except Exception as e:
                errors.append(str(e))
    elif mode == "pointer":
        ptr_raw = meta.get("state_root_pointer")
        if not isinstance(ptr_raw, str) or not ptr_raw.strip():
            errors.append("pointer snapshot missing `state_root_pointer`")
        else:
            ptr = Path(ptr_raw).resolve()
            details["state_root_pointer"] = str(ptr)
            if not ptr.exists():
                errors.append(f"pointer target does not exist: {ptr}")
            else:
                try:
                    require_control_plane_marker(ptr)
                except Exception as e:
                    errors.append(str(e))

    ep_dir = (path / "entrypoint").resolve()
    raw_entrypoints = meta.get("entrypoints")
    entrypoints_checked = 0
    if raw_entrypoints is None:
        raw_entrypoints = {}
    if not isinstance(raw_entrypoints, dict):
        errors.append("invalid entrypoints metadata (expected object)")
        raw_entrypoints = {}
    for rel, info in sorted(raw_entrypoints.items(), key=lambda kv: str(kv[0])):
        if not isinstance(rel, str):
            warnings.append(f"ignoring non-string entrypoint key: {rel!r}")
            continue
        src = ep_dir / rel.replace("/", "__")
        if not src.exists():
            errors.append(f"missing snapshot entrypoint file for {rel}: {src}")
            continue
        if not src.is_file():
            errors.append(f"snapshot entrypoint is not a file for {rel}: {src}")
            continue
        if isinstance(info, dict):
            want_sha = info.get("sha256")
            if isinstance(want_sha, str) and want_sha.strip():
                got = _sha256_file(src)
                if got != want_sha.strip():
                    errors.append(f"entrypoint sha256 mismatch for {rel}: expected={want_sha.strip()} got={got}")
            marker = info.get("looks_like_singlefile")
            if isinstance(marker, bool) and marker and not _looks_like_singlefile(src):
                errors.append(f"snapshot entrypoint does not look like sandworm singlefile: {src}")
        else:
            warnings.append(f"entrypoint metadata for {rel} is not an object")
        entrypoints_checked += 1
    details["entrypoints_checked"] = entrypoints_checked

    return StateBackupVerifyResult(
        snapshot_id=snapshot_id,
        path=str(path),
        snapshot_mode=mode,
        valid=(not errors),
        errors=errors,
        warnings=warnings,
        details=details,
    )


def verify_state_backup(
    *,
    root: Path,
    snapshot_id: str | None,
    last: bool,
) -> StateBackupVerifyResult:
    sid, snap = _resolve_snapshot(root=root, snapshot_id=snapshot_id, last=last)
    res = _verify_snapshot_dir(snap)
    if res.snapshot_id != sid:
        return StateBackupVerifyResult(
            snapshot_id=sid,
            path=res.path,
            snapshot_mode=res.snapshot_mode,
            valid=res.valid,
            errors=res.errors,
            warnings=(res.warnings + [f"resolved snapshot id ({sid}) differs from metadata id ({res.snapshot_id})"]),
            details=res.details,
        )
    return res


def verify_all_state_backups(*, root: Path) -> list[StateBackupVerifyResult]:
    dirs = _snapshot_dirs(root)
    if not dirs:
        d = state_backups_dir(root)
        create_hint = "create one with `sandworm rollback save --name <label>` (or `sandworm state snapshot --name <label>`)"
        raise StateBackupError(f"no state backups found: {d}; {create_hint}")
    return [_verify_snapshot_dir(p) for p in dirs]


def recommend_state_backups(
    *,
    root: Path,
    restore_state: bool,
    restore_entrypoint: bool,
    limit: int,
) -> StateBackupRecommendResult:
    if limit <= 0:
        raise StateBackupError(f"invalid limit (must be >= 1): {limit}")
    listing = list_state_backups(root=root)
    listed_by_id = {str(it.get("snapshot_id") or ""): it for it in listing if isinstance(it, dict)}
    verified = verify_all_state_backups(root=root)

    ranked: list[StateBackupRecommendation] = []
    for idx, row in enumerate(verified):
        meta = listed_by_id.get(row.snapshot_id, {})
        created_at = meta.get("created_at") if isinstance(meta.get("created_at"), str) else None
        label = meta.get("label") if isinstance(meta.get("label"), str) else None
        has_entrypoints = bool(meta.get("has_entrypoints"))
        score = 0
        reasons: list[str] = []

        if row.valid:
            score += 100
            reasons.append("integrity checks passed")
        else:
            score -= 200
            reasons.append(f"integrity errors: {len(row.errors)}")

        if restore_state:
            if row.snapshot_mode == "copy":
                score += 20
                reasons.append("copy snapshot restores control-plane contents")
            elif row.snapshot_mode == "pointer":
                score += 5
                reasons.append("pointer snapshot restores state-root pointer")

        if restore_entrypoint:
            if has_entrypoints:
                score += 60
                reasons.append("contains entrypoint artifacts")
            else:
                score -= 120
                reasons.append("missing entrypoint artifacts")
        else:
            if has_entrypoints:
                score += 5

        recency_bonus = max(0, 30 - idx)
        score += recency_bonus
        if idx == 0:
            reasons.append("most recent snapshot")
        elif idx <= 2:
            reasons.append("recent snapshot")

        usable = bool(row.valid and ((not restore_entrypoint) or has_entrypoints))
        ranked.append(
            StateBackupRecommendation(
                snapshot_id=row.snapshot_id,
                path=row.path,
                created_at=created_at,
                label=label,
                snapshot_mode=row.snapshot_mode,
                valid=bool(row.valid),
                usable=usable,
                has_entrypoints=has_entrypoints,
                score=int(score),
                reasons=reasons,
                warnings=list(row.warnings),
                errors=list(row.errors),
            )
        )

    ranked.sort(key=lambda c: (c.score, 1 if c.usable else 0, 1 if c.valid else 0), reverse=True)
    recommended: StateBackupRecommendation | None = None
    for c in ranked:
        if c.usable:
            recommended = c
            break
    if recommended is None and ranked:
        for c in ranked:
            if c.valid:
                recommended = c
                break
    if recommended is None and ranked:
        recommended = ranked[0]

    recommended_id = (recommended.snapshot_id if recommended is not None else None)
    recommended_usable = bool(recommended.usable) if recommended is not None else False
    reason = "no snapshots available"
    command: str | None = None
    if recommended is not None:
        if recommended.usable:
            reason = "best usable snapshot for requested restore scope"
        elif recommended.valid:
            reason = "best valid snapshot (does not fully match requested restore scope)"
        else:
            reason = "no valid snapshots; best-effort candidate only"
        cmd = f"sandworm --yes rollback to {recommended.snapshot_id}"
        if restore_state and (not restore_entrypoint):
            cmd += " --state-only"
        elif restore_entrypoint and (not restore_state):
            cmd += " --entrypoint-only"
        command = cmd

    return StateBackupRecommendResult(
        restore_state=restore_state,
        restore_entrypoint=restore_entrypoint,
        total_candidates=len(ranked),
        recommended_snapshot_id=recommended_id,
        recommended_usable=recommended_usable,
        recommendation_reason=reason,
        recommended_command=command,
        candidates=ranked[:limit],
    )


def _resolve_snapshot(*, root: Path, snapshot_id: str | None, last: bool) -> tuple[str, Path]:
    d = state_backups_dir(root)
    create_hint = "create one with `sandworm rollback save --name <label>` (or `sandworm state snapshot --name <label>`)"
    if not d.exists():
        raise StateBackupError(f"no state backups found: {d}; {create_hint}")
    if snapshot_id:
        p = (d / snapshot_id).resolve()
        if not p.exists() or not p.is_dir():
            raise StateBackupError(
                f"snapshot not found: {snapshot_id}; use `sandworm rollback list` (or `sandworm state snapshots`) to inspect available ids"
            )
        return snapshot_id, p
    if not last:
        raise StateBackupError("choose a snapshot with --snapshot, or use --last")
    items = sorted([x for x in d.iterdir() if x.is_dir()], key=lambda x: x.name)
    if not items:
        raise StateBackupError(f"no state backups found: {d}; {create_hint}")
    p = items[-1].resolve()
    return p.name, p


def _restore_file_with_backup(*, src: Path, dest: Path, suffix: str) -> str | None:
    backup: str | None = None
    if dest.exists():
        bak = _next_unique_path(Path(str(dest) + f".pre-rollback.{suffix}").resolve())
        shutil.move(str(dest), str(bak))
        backup = str(bak)
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dest)
    try:
        dest.chmod(0o755)
    except Exception:
        pass
    return backup


def restore_state_backup(
    *,
    root: Path,
    snapshot_id: str | None,
    last: bool,
    restore_state: bool,
    restore_entrypoint: bool,
    activate: bool,
    activate_readonly: bool,
) -> StateBackupRestoreResult:
    root = root.resolve()
    sid, snap = _resolve_snapshot(root=root, snapshot_id=snapshot_id, last=last)
    snapshot_path = str(snap)
    if not restore_state and not restore_entrypoint:
        raise StateBackupError("rollback requested with nothing to restore")

    marker_suffix = _now_compact_utc()
    state_backup_path: str | None = None
    entrypoint_backups: dict[str, str] = {}
    restored_state = False
    restored_entrypoint = False
    staged_snap: Path | None = None
    meta = _read_meta(snap)
    snapshot_mode = str(meta.get("snapshot_mode") or "copy").strip().lower()
    pointer_path_raw = meta.get("state_root_pointer")
    pointer_path = Path(pointer_path_raw).resolve() if isinstance(pointer_path_raw, str) and pointer_path_raw.strip() else None

    dest_state = (root / ".sandworm").resolve()
    if restore_state:
        if snapshot_mode == "pointer":
            if pointer_path is None:
                raise StateBackupError(f"pointer snapshot is missing state_root_pointer: {snap}")
            if not pointer_path.exists():
                raise StateBackupError(f"pointer snapshot target does not exist: {pointer_path}")
            require_control_plane_marker(pointer_path)
            if activate:
                write_state_root_file(root, pointer_path, readonly=bool(activate_readonly))
            restored_state = True
            restore_state = False
    if restore_state:
        try:
            snap.relative_to(dest_state)
            needs_stage = True
        except Exception:
            needs_stage = False
        if needs_stage:
            staged_snap = (root / f".sandworm-state-rollback-stage.{os.getpid()}").resolve()
            if staged_snap.exists():
                shutil.rmtree(staged_snap, ignore_errors=True)
            shutil.copytree(snap, staged_snap, symlinks=True)
            snap = staged_snap

    try:
        if restore_state:
            src_state = (snap / "control-plane").resolve()
            require_control_plane_marker(src_state)
            moved_backup: Path | None = None
            if dest_state.exists():
                moved_backup = _next_unique_path(Path(str(dest_state) + f".pre-rollback.{marker_suffix}").resolve())
                shutil.move(str(dest_state), str(moved_backup))
                state_backup_path = str(moved_backup)
            try:
                shutil.copytree(src_state, dest_state, symlinks=True)
                # Preserve existing rollback snapshots across state restores.
                # Snapshot copies intentionally omit `state-backups` to avoid recursive growth.
                if moved_backup is not None:
                    prev_backups = (moved_backup / "state-backups").resolve()
                    dest_backups = (dest_state / "state-backups").resolve()
                    if prev_backups.exists() and (not dest_backups.exists()):
                        try:
                            shutil.move(str(prev_backups), str(dest_backups))
                        except Exception:
                            shutil.copytree(prev_backups, dest_backups, symlinks=True)
            except Exception:
                try:
                    if dest_state.exists():
                        shutil.rmtree(dest_state)
                except Exception:
                    pass
                if moved_backup is not None and moved_backup.exists():
                    shutil.move(str(moved_backup), str(dest_state))
                raise
            restored_state = True
            if activate:
                write_state_root_file(root, dest_state, readonly=bool(activate_readonly))

        if restore_entrypoint:
            ep = (snap / "entrypoint").resolve()
            entrypoints = meta.get("entrypoints")
            if ep.exists() and isinstance(entrypoints, dict):
                for rel, info in sorted(entrypoints.items(), key=lambda kv: str(kv[0])):
                    if not isinstance(rel, str):
                        continue
                    src = ep / rel.replace("/", "__")
                    if not src.exists():
                        continue
                    if isinstance(info, dict):
                        want_sha = info.get("sha256")
                        if isinstance(want_sha, str) and want_sha.strip():
                            got = _sha256_file(src)
                            if got != want_sha.strip():
                                raise StateBackupError(f"snapshot entrypoint sha256 mismatch for {rel}: {src}")
                    if not _looks_like_singlefile(src):
                        raise StateBackupError(f"snapshot entrypoint is not a recognizable sandworm singlefile: {src}")
                    dest = (root / rel).resolve()
                    bak = _restore_file_with_backup(src=src, dest=dest, suffix=marker_suffix)
                    if bak:
                        entrypoint_backups[rel] = bak
                    restored_entrypoint = True
    finally:
        if staged_snap is not None:
            try:
                shutil.rmtree(staged_snap, ignore_errors=True)
            except Exception:
                pass

    return StateBackupRestoreResult(
        ok=True,
        snapshot_id=sid,
        path=snapshot_path,
        snapshot_mode=snapshot_mode,
        restored_state=restored_state,
        restored_entrypoint=restored_entrypoint,
        state_backup_path=state_backup_path,
        entrypoint_backup_paths=entrypoint_backups,
    )


def delete_state_backup(*, root: Path, snapshot_id: str) -> tuple[str, str]:
    sid, snap = _resolve_snapshot(root=root, snapshot_id=snapshot_id, last=False)
    if snap.is_symlink():
        raise StateBackupError(f"refusing to delete symlink snapshot directory: {snap}")
    try:
        _force_rmtree(snap)
    except Exception as e:
        raise StateBackupError(f"failed to delete snapshot {sid}: {e}") from e
    return sid, str(snap)


def _snapshot_epoch_utc(path: Path) -> float:
    # Prefer timestamp from the snapshot id prefix (UTC), then fallback to mtime.
    name = path.name
    if len(name) >= 15 and name[8] == "-":
        prefix = name[:15]
        try:
            tm = time.strptime(prefix, "%Y%m%d-%H%M%S")
            return float(calendar.timegm(tm))
        except Exception:
            pass
    try:
        return float(path.stat().st_mtime)
    except Exception:
        return 0.0


def _force_rmtree(path: Path) -> None:
    p = path.resolve()
    if not p.exists():
        return

    # Snapshot payloads can contain read-only directories/files. Make the tree
    # owner-writable first so deletion is deterministic.
    try:
        for dirpath, dirnames, filenames in os.walk(p, topdown=False):
            d = Path(dirpath)
            for name in filenames:
                fp = d / name
                try:
                    if not fp.is_symlink():
                        fp.chmod(0o600)
                except Exception:
                    pass
            for name in dirnames:
                dp = d / name
                try:
                    if not dp.is_symlink():
                        dp.chmod(0o700)
                except Exception:
                    pass
            try:
                d.chmod(0o700)
            except Exception:
                pass
        try:
            p.chmod(0o700)
        except Exception:
            pass
    except Exception:
        pass

    def _onerror(func, failing_path, _exc_info):
        try:
            fp = Path(str(failing_path))
            try:
                fp.parent.chmod(0o700)
            except Exception:
                pass
            if fp.exists() and fp.is_dir():
                os.chmod(fp, 0o700)
            elif fp.exists() and not fp.is_symlink():
                os.chmod(fp, 0o600)
            func(str(fp))
            return
        except Exception:
            pass
        # Preserve the original failure signal from shutil for actionable diagnostics.
        raise

    shutil.rmtree(p, onerror=_onerror)


def prune_state_backups(
    *,
    root: Path,
    keep: int,
    older_than_days: float | None,
    dry_run: bool,
) -> StateBackupPruneResult:
    if keep < 0:
        raise StateBackupError(f"invalid --keep value (must be >= 0): {keep}")
    if older_than_days is not None and older_than_days < 0:
        raise StateBackupError(f"invalid --older-than-days value (must be >= 0): {older_than_days}")

    dirs = _snapshot_dirs(root)
    keep_dirs = dirs[:keep]
    candidates = dirs[keep:]
    now = time.time()
    age_threshold = (now - (older_than_days * 86400.0)) if older_than_days is not None else None

    removed: list[str] = []
    retained: list[str] = [p.name for p in keep_dirs]
    skipped_recent: list[str] = []
    for p in candidates:
        if age_threshold is not None:
            snap_ts = _snapshot_epoch_utc(p)
            if snap_ts > age_threshold:
                skipped_recent.append(p.name)
                retained.append(p.name)
                continue
        if dry_run:
            removed.append(p.name)
            continue
        try:
            _force_rmtree(p)
        except Exception as e:
            raise StateBackupError(f"failed to prune snapshot {p.name}: {e}") from e
        removed.append(p.name)

    return StateBackupPruneResult(
        backups_dir=str(state_backups_dir(root)),
        total=len(dirs),
        keep=keep,
        older_than_days=older_than_days,
        dry_run=dry_run,
        removed=removed,
        retained=retained,
        skipped_recent=skipped_recent,
    )
