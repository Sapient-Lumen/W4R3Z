def _resolve_sandworm_entrypoint(root: Path) -> Path | None:
    """
    Best-effort resolve of the host Sandworm entrypoint binary.

    Priority:
    - workspace defaults (`<root>/sandworm`, `<root>/dist/sandworm`)
    - singlefile outer launcher dir (`$SANDWORM_LAUNCH_WRAPPER_DIR/sandworm`)
    - explicit stable host path env (`SANDWORM_BIN_HOST`)
    - current argv0 (or PATH lookup of argv0)
    - wrapper-path hint (`SANDWORM_WRAPPER_PATH`) as last-resort fallback
    """
    candidates: list[Path] = []

    # Prefer root-local wrapper paths first: these are stable inside bwrap sandboxes where
    # host /home may be remapped (e.g. /home -> /home/sandworm only).
    for rel in ("sandworm", "dist/sandworm"):
        try:
            candidates.append((root / rel).resolve())
        except Exception:
            pass

    launch_dir = os.environ.get("SANDWORM_LAUNCH_WRAPPER_DIR")
    if isinstance(launch_dir, str) and launch_dir.strip():
        try:
            candidates.append((Path(launch_dir.strip()).expanduser().resolve() / "sandworm").resolve())
        except Exception:
            pass

    v = os.environ.get("SANDWORM_BIN_HOST")
    if isinstance(v, str) and v.strip():
        try:
            candidates.append(Path(v.strip()).expanduser().resolve())
        except Exception:
            pass

    argv0 = str(sys.argv[0] or "").strip()
    if argv0:
        try:
            p = Path(argv0)
            if p.exists():
                candidates.append(p.resolve())
        except Exception:
            pass

    # Last resort only: `SANDWORM_WRAPPER_PATH` often points at an extracted inner wrapper
    # (not the self-contained outer singlefile). In isolated roots that can fail with
    # `No module named sandworm_core`, so keep it at the very end.
    if not (os.environ.get("SANDWORM_SINGLEFILE") or "").strip():
        v = os.environ.get("SANDWORM_WRAPPER_PATH")
        if isinstance(v, str) and v.strip():
            try:
                candidates.append(Path(v.strip()).expanduser().resolve())
            except Exception:
                pass
        try:
            w = shutil.which(argv0)
            if w:
                candidates.append(Path(w).resolve())
        except Exception:
            pass

    seen: set[str] = set()
    for c in candidates:
        key = str(c)
        if key in seen:
            continue
        seen.add(key)
        if _is_exec_file(c):
            return c
    return None


