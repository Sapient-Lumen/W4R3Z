def resolve_flake_ref(root: Path, explicit_flake: str | None) -> str:
    def _clean_ref(v: object) -> str:
        if not isinstance(v, str):
            return ""
        s = v.strip()
        return s if s else ""

    if isinstance(explicit_flake, str) and explicit_flake.strip():
        return explicit_flake.strip()
    env_primary = _clean_ref(os.environ.get("SW_NIXPKGS_FLAKE") or os.environ.get("SANDWORM_NIXPKGS_FLAKE"))
    env_fb = _clean_ref(os.environ.get("SW_NIXPKGS_FLAKE_FALLBACK") or os.environ.get("SANDWORM_NIXPKGS_FLAKE_FALLBACK"))
    if nixpkgs_ref_is_pinned_enough(env_primary):
        return env_primary
    if nixpkgs_ref_is_pinned_enough(env_fb):
        return env_fb
    if env_primary:
        return env_primary
    if env_fb:
        return env_fb
    lf = lockfile_path(root)
