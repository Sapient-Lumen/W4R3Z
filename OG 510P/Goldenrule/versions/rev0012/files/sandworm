def run_selftest_kvm(
    ctx: RunContext,
    *,
    timeout_s: int = 240,
    nested_containers: bool = False,
    sandworm_in_guest: bool = False,
    providers_in_guest: bool = False,
    providers_api_in_guest: bool = False,
    accel: str = "auto",
    reboot_if_needed: bool = False,
    isolated: bool = False,
) -> int:
    ctx.event("selftest_start", {"mode": "kvm"})

    try:
        from .kvm import kvm_doctor, kvm_down, kvm_exec_in_dir, kvm_status, kvm_up
    except Exception as e:
        ctx.event("error", {"where": "import.kvm", "error": repr(e)})
        return 50

    rep = kvm_doctor(ctx.root)
    ctx.event("kvm_doctor", rep, step="selftest-kvm")

    instance = f"selftest-{ctx.runid}" if isolated else None
    if isolated:
        # Non-disruptive default: don't touch the default VM; use a separate instance and ensure it's stopped.
        try:
            kvm_down(ctx.root, instance=instance, purge=True)
        except Exception:
            pass

    st0 = kvm_status(ctx.root, instance=instance)
    started_here = False
    if isolated:
        ctx.warn(f"kvm selftest: using isolated instance {instance!r} (won't touch the default VM)")
    elif st0.running:
        ctx.warn("kvm selftest: using an already-running VM (non-disruptive; use --kvm-isolated for a separate VM)")
    try:
        want_accel = (accel or "auto").strip().lower()
        if want_accel not in ("auto", "kvm", "tcg"):
            want_accel = "auto"

        if st0.running:
            # Non-disruptive default: do not reboot a VM that the user might be attached to.
            if want_accel in ("kvm", "tcg") and st0.accel and st0.accel != want_accel:
                if not reboot_if_needed:
                    msg = (
                        f"SKIP: kvm selftest requested accel={want_accel} but VM is already running with accel={st0.accel}.\n"
                        "If you want sandworm to stop/reboot the VM to force the requested accel, re-run with --kvm-reboot-if-needed."
                    )
                    ctx.event(
                        "selftest_skip",
                        {"mode": "kvm", "reason": "running_vm_accel_mismatch", "requested_accel": want_accel, "running_accel": st0.accel},
                        step="selftest-kvm",
                    )
                    ctx.event("selftest_end", {"status": "skipped", "mode": "kvm"}, step="selftest-kvm")
                    ctx.warn(msg)
                    return 55

                # Disruptive: reboot to satisfy requested accel.
                try:
                    kvm_down(ctx.root, instance=instance)
                except Exception:
                    pass
                started_here = True
                st = kvm_up(
                    ctx.root,
                    instance=instance,
                    build_image=True,
                    timeout_s=int(timeout_s),
                    accel=want_accel,
                    force_reboot=True,
                    reconfigure=True,
                )
            else:
                st = st0
        else:
            started_here = True
            st = kvm_up(ctx.root, instance=instance, build_image=True, timeout_s=int(timeout_s), accel=want_accel)

        ctx.event(
            "kvm_up",
            {"running": st.running, "pid": st.pid, "port": st.port, "accel": st.accel, "requested_accel": want_accel, "reboot_if_needed": bool(reboot_if_needed)},
            step="selftest-kvm",
        )

        # Record the effective workspace mount fstype (virtiofs preferred; 9p fallback).
        try:
            fs_probe = kvm_exec_in_dir(
                ctx.root,
                ["bash", "-lc", "set -e; findmnt -n -o FSTYPE --target /workspace 2>/dev/null || true"],
                instance=instance,
                workdir="/workspace",
                timeout_s=10,
            )
            fstype = (fs_probe.stdout or "").strip().splitlines()[:1]
            if fstype:
                ctx.event("kvm_workspace", {"fstype": fstype[0].strip()}, step="selftest-kvm")
        except Exception:
            pass

        t0 = time.time()
        env_exec_timeout = os.environ.get("SW_SELFTEST_KVM_EXEC_TIMEOUT_S")
        if isinstance(env_exec_timeout, str) and env_exec_timeout.strip():
            exec_timeout_s = int(env_exec_timeout.strip())
        else:
            # TCG can be extremely slow, and the first isolated boot may need to hydrate missing tools.
            exec_timeout_s = 1800 if (st.accel == "tcg" and isolated) else (900 if st.accel == "tcg" else 120)

        # Best-effort: ensure the guest has a usable dev toolchain. Some images may be intentionally minimal and rely
        # on nix profile installs on first boot. In isolated mode, this can be the first time the instance runs, so
        # give it a chance to self-heal before we assert required tools.
        t_boot = time.time()
        boot_cmd = r"""
set -euo pipefail
export PATH="/run/current-system/sw/bin:${PATH:-}"
export HOME="/home/sand"
 stamp="/home/sand/.sandworm-tools.stamp"
 need=0
 missing=""
 py_site=""
 for d in /home/sand/.nix-profile/lib/python*/site-packages; do
   if [ -d "$d" ]; then py_site="$d"; break; fi
 done
 for c in git gcc make curl jq rg node podman bwrap python3; do
   if ! command -v "$c" >/dev/null 2>&1; then
     need=1
     missing="$missing $c"
   fi
 done
 if command -v python3 >/dev/null 2>&1; then
   if [ -n "$py_site" ]; then
     if ! PYTHONPATH="$py_site${PYTHONPATH:+:$PYTHONPATH}" python3 -c 'import yaml' >/dev/null 2>&1; then
       need=1
       missing="$missing pyyaml"
     fi
   elif ! python3 -c 'import yaml' >/dev/null 2>&1; then
     need=1
     missing="$missing pyyaml"
   fi
 fi
