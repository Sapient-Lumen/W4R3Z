from __future__ import annotations

import os
import sys

from .cli import main

try:
    raise SystemExit(main())
except BrokenPipeError:
    # Downstream consumer closed the pipe early (e.g. `sandworm ... | head -n1`).
    # Exit quietly without traceback noise.
    try:
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
    except Exception:
        pass
    raise SystemExit(0)
except SystemExit as e:
    # Sandworm uses `raise SystemExit("message")` for some user-facing preflight failures.
    # When running via the bash wrapper's `runpy.run_module(...)`, the interpreter may not
    # print the message reliably. Emit it explicitly so users (and smoke tests) see it.
    code = getattr(e, "code", None)
    if isinstance(code, str) and code.strip():
        print(code.strip(), file=sys.stderr)
        raise SystemExit(2)
    raise
