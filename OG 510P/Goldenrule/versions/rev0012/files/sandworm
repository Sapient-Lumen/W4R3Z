    exit "$rc2"
  elif [[ "$err_txt" == *"Fatal error: nix is unable to build packages"* ]] || [[ "$err_txt" == *"fatal error: nix is unable to build packages"* ]]; then
    if [[ "$runtime_now" == "proot" ]]; then
      echo "nix: nix-portable failed to build packages in runtime=proot; retrying with NP_RUNTIME=nix" >&2
      set +e
      NP_RUNTIME=nix "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
      rc2="$?"
      set -e
      if [[ "$rc2" == "0" ]]; then
        rm -f "$tmp_err" >/dev/null 2>&1 || true
        exit 0
      fi
      rm -f "$tmp_err" >/dev/null 2>&1 || true
      exit "$rc2"
    fi
    if [[ "$allow_proot" == "1" ]]; then
      echo "nix: nix-portable failed to build packages in default runtime; retrying with NP_RUNTIME=proot" >&2
      # PRoot seccomp support can be missing on some kernels; disable PRoot seccomp to reduce false negatives.
      NP_RUNTIME=proot PROOT_NO_SECCOMP=1 exec "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
    fi
    echo "nix: proot retry disabled; retrying with NP_RUNTIME=nix" >&2
    set +e
    NP_RUNTIME=nix "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
    rc2="$?"
    set -e
    if [[ "$rc2" == "0" ]]; then
      rm -f "$tmp_err" >/dev/null 2>&1 || true
      exit 0
    fi
    rm -f "$tmp_err" >/dev/null 2>&1 || true
    exit "$rc2"
  fi
  fi
fi
rm -f "$tmp_err" >/dev/null 2>&1 || true
exit "$rc"
NIX_WRAPPER
  chmod +x "$nix_bin" 2>/dev/null || true

  cat >"$nix_shell_bin" <<'NIX_SHELL_WRAPPER'
