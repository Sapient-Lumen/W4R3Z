def _ensure_home_login_path_profile(home_dir: Path) -> None:
    """
    Keep login-shell PATH usable for provider command sandboxes that invoke `sh -lc`.

    In some environments, login shells reset PATH and drop `/run/sandworm/*` entries.
    Writing a managed block in `$HOME/.profile` keeps Sandworm wrappers discoverable.
    """
    begin = "# >>> sandworm managed PATH >>>"
    end = "# <<< sandworm managed PATH <<<"
    block = (
        f"{begin}\n"
        "export PATH=\"/run/sandworm/bin:/run/sandworm/clients/bin:/run/sandworm/toolroot/bin:${PATH}\"\n"
        "sw_workspace=\"${SANDWORM_WORKSPACE:-}\"\n"
        "if [ -z \"${sw_workspace}\" ] && [ -n \"${SANDWORM_WORKSPACE_ENV_MD:-}\" ]; then\n"
        "  case \"${SANDWORM_WORKSPACE_ENV_MD}\" in\n"
        "    */.SANDWORM_ENV.md) sw_workspace=\"${SANDWORM_WORKSPACE_ENV_MD%/.SANDWORM_ENV.md}\" ;;\n"
        "  esac\n"
        "fi\n"
        "if [ -z \"${sw_workspace}\" ] && [ -d /workspace ]; then\n"
        "  sw_workspace=/workspace\n"
        "fi\n"
        "if [ -n \"${sw_workspace}\" ]; then\n"
        "  if [ -d \"${sw_workspace}/.sandworm/toolroot/bin\" ]; then\n"
        "    export PATH=\"${sw_workspace}/.sandworm/toolroot/bin:${PATH}\"\n"
        "    export SANDWORM_TOOLROOT_BIN=\"${sw_workspace}/.sandworm/toolroot/bin\"\n"
        "  fi\n"
        "  if [ -d \"${sw_workspace}/.sandworm/clients/bin\" ]; then\n"
        "    export PATH=\"${sw_workspace}/.sandworm/clients/bin:${PATH}\"\n"
        "  fi\n"
        "fi\n"
        f"{end}\n"
    )
    try:
        home_dir.mkdir(parents=True, exist_ok=True)
        profile = home_dir / ".profile"
        old = profile.read_text(encoding="utf-8", errors="replace") if profile.exists() else ""
        if begin in old and end in old:
            pre, rest = old.split(begin, 1)
            _, post = rest.split(end, 1)
            parts: list[str] = []
            pre_s = pre.rstrip("\n")
            post_s = post.lstrip("\n").rstrip("\n")
            if pre_s:
                parts.append(pre_s)
            parts.append(block.rstrip("\n"))
            if post_s:
                parts.append(post_s)
            new = ("\n\n".join(parts) + "\n") if parts else block
        elif old.strip():
            new = old.rstrip("\n") + "\n\n" + block
        else:
            new = block
        if new != old:
            profile.write_text(new, encoding="utf-8")
            try:
                profile.chmod(0o644)
            except Exception:
                pass
    except Exception:
        return


def _is_valid_busybox_binary(path: Path) -> bool:
    try:
        if not (path.exists() and os.access(path, os.X_OK)):
            return False
        st = path.stat()
        if int(getattr(st, "st_size", 0)) <= 0:
            return False
        with path.open("rb") as f:
            return f.read(4) == b"\x7fELF"
    except Exception:
        return False


def _nested_runtime_markers_present(env: dict[str, str] | None = None) -> bool:
    e = env or os.environ
    backend = str(e.get("SANDWORM_BACKEND") or "").strip().lower()
    if backend not in ("podman", "bwrap", "kvm"):
        return False
    home = str(e.get("SANDWORM_HOME") or e.get("HOME") or "").strip()
    if home != "/run/sandworm/home":
        return False
    swbin = Path("/run/sandworm/bin/sandworm")
    try:
        return Path("/run/sandworm/home").is_dir() and swbin.exists() and os.access(str(swbin), os.X_OK)
    except Exception:
