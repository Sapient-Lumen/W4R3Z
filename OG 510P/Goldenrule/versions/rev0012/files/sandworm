def sandworm_claude_config_dir(root: Path) -> Path:
    """
    Project-local Claude Code config dir.

    Claude Code defaults to using `os.homedir()` to locate `~/.claude`, which may ignore $HOME on some platforms.
    Sandworm forces `CLAUDE_CONFIG_DIR` to point here so credentials remain project-local and reusable across backends.
    """
    home = ensure_sandworm_home(root)
    return (home / ".claude").resolve()


def _read_json(path: Path) -> dict | None:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None
    return data if isinstance(data, dict) else None


def _has_any_credential(data: dict) -> bool:
    # Best-effort: treat presence of obvious tokens/keys as "configured".
    # We intentionally don't validate formats here.
    oauth = data.get("claudeAiOauth")
    if isinstance(oauth, dict):
        at = oauth.get("accessToken")
        if isinstance(at, str) and at.strip():
            return True
    for k in ("primaryApiKey", "apiKey"):
        v = data.get(k)
        if isinstance(v, str) and v.strip():
            return True
    return False


def _user_home_dir() -> Path:
    try:
        return Path(pwd.getpwuid(os.getuid()).pw_dir).expanduser().resolve()
    except Exception:
        return Path("~").expanduser().resolve()


def _candidate_claude_config_dirs_from_host_env(root: Path) -> list[Path]:
    out: list[Path] = []
    allow_host_home = (os.environ.get("SW_IMPORT_HOST_HOME_CREDS") or os.environ.get("SANDWORM_IMPORT_HOST_HOME_CREDS") or "").strip().lower() in (
        "1",
        "true",
        "yes",
        "y",
        "on",
    )

    ch = os.environ.get("CLAUDE_CONFIG_DIR")
    if isinstance(ch, str) and ch.strip():
        try:
            chp = Path(ch).expanduser().resolve()
            rootp = root.resolve()
            if allow_host_home or str(chp).startswith(str(rootp) + os.sep) or str(chp) == str(rootp):
                out.append(chp)
        except Exception:
            pass

    # SAFE default: do not read host $HOME for creds. Host-home import is an explicit opt-in.
    if allow_host_home:
        out.append((_user_home_dir() / ".claude").resolve())

    # De-dupe and avoid Sandworm's own target dir.
    dst = sandworm_claude_config_dir(root)
    seen: set[str] = set()
    uniq: list[Path] = []
    for p in out:
        sp = str(p)
        if sp in seen:
            continue
        seen.add(sp)
        if p == dst:
            continue
        uniq.append(p)
    return uniq


def ensure_claude_credentials_imported(root: Path) -> ClaudeCredImportResult:
    """
    Ensure Sandworm's project-local Claude credentials exist by importing from safe sources when needed.

    SAFE default: do not read host $HOME (~/.claude) unless explicitly enabled via:
    - SW_IMPORT_HOST_HOME_CREDS=1 (or SANDWORM_IMPORT_HOST_HOME_CREDS=1)
    """
    root = root.resolve()

    if os.environ.get("SW_IMPORT_HOST_CREDS", "1") == "0":
        dst = (sandworm_claude_config_dir(root) / ".credentials.json").resolve()
        return ClaudeCredImportResult(imported=False, reason="disabled", src_credentials_json=None, dest_credentials_json=str(dst))

    dst_dir = sandworm_claude_config_dir(root)
    dst_dir.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(dst_dir, 0o700)
    except Exception:
        pass

    dst = (dst_dir / ".credentials.json").resolve()
    dst_data = _read_json(dst) if dst.exists() else None
    if isinstance(dst_data, dict) and _has_any_credential(dst_data):
        return ClaudeCredImportResult(imported=False, reason="dest_has_auth", src_credentials_json=None, dest_credentials_json=str(dst))

    if dst.exists():
        reason = "dest_unreadable_or_empty"
    else:
        reason = "dest_missing"

    for src_dir in _candidate_claude_config_dirs_from_host_env(root):
        src = (src_dir / ".credentials.json").resolve()
        if not src.exists():
            continue
        src_data = _read_json(src)
        if not isinstance(src_data, dict) or not _has_any_credential(src_data):
            continue
        try:
            shutil.copyfile(src, dst)
            try:
                os.chmod(dst, 0o600)
            except Exception:
                pass
            return ClaudeCredImportResult(imported=True, reason=f"imported_from:{src_dir}", src_credentials_json=str(src), dest_credentials_json=str(dst))
        except Exception:
            continue

    return ClaudeCredImportResult(imported=False, reason=reason, src_credentials_json=None, dest_credentials_json=str(dst))


def ensure_claude_settings_local(root: Path) -> ClaudeSettingsLocalResult:
    """
    Ensure a Claude Code settings.local.json exists under Sandworm-managed CLAUDE_CONFIG_DIR.

    Claude Code can refuse to run when it detects uid=0 (common in rootless containers). A permissive
    settings.local.json makes noob ergonomics sane in Sandworm-managed provider sandboxes.

    Best-effort: never raises.
    """
    root = root.resolve()
    dst_dir = sandworm_claude_config_dir(root)
    try:
        dst_dir.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(dst_dir, 0o700)
        except Exception:
            pass
    except Exception:
        return ClaudeSettingsLocalResult(changed=False, reason="mkdir_failed", path=str((dst_dir / "settings.local.json").resolve()))

    p = (dst_dir / "settings.local.json").resolve()
    default = {
        "$schema": "https://json.schemastore.org/claude-code-settings.json",
        "permissions": {
            "defaultMode": "dontAsk",
            "allow": [
                "Bash",
                "Read",
                "Edit",
                "Write",
                "MultiEdit",
                "NotebookRead",
                "NotebookEdit",
                "WebFetch",
                "WebSearch",
                "ToolSearch",
                "Task",
                "TaskCreate",
                "TaskGet",
                "TaskList",
                "TaskOutput",
                "TaskStop",
                "TaskUpdate",
                "TodoWrite",
                "ExitPlanMode",
                "KillShell",
                "LS",
                "LSP",
                "Skill",
                "mcp__*",
            ],
            "ask": [],
            "deny": [],
        },
    }

    try:
        if not p.exists():
            p.write_text(json.dumps(default, indent=2, sort_keys=True) + "\n", encoding="utf-8")
            try:
                os.chmod(p, 0o600)
            except Exception:
                pass
            return ClaudeSettingsLocalResult(changed=True, reason="created", path=str(p))

        cur = _read_json(p)
        if isinstance(cur, dict) and cur == default:
            return ClaudeSettingsLocalResult(changed=False, reason="already_ok", path=str(p))

        reason = "updated" if isinstance(cur, dict) else "unreadable_overwrite"
        p.write_text(json.dumps(default, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        try:
            os.chmod(p, 0o600)
        except Exception:
            pass
        return ClaudeSettingsLocalResult(changed=True, reason=reason, path=str(p))
    except Exception:
        return ClaudeSettingsLocalResult(changed=False, reason="error", path=str(p))


def claude_has_any_creds(root: Path) -> bool:
    try:
        creds = (sandworm_claude_config_dir(root) / ".credentials.json").resolve()
        if not creds.exists():
            return False
        data = _read_json(creds)
        return bool(isinstance(data, dict) and _has_any_credential(data))
    except Exception:
        return False
