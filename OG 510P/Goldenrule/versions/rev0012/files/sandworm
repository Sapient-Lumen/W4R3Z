def _normalize_request_cwd(requested_cwd: str, *, root: Path) -> tuple[str, str | None]:
    """
    Convert sandbox-facing cwd paths into host-resolvable cwd paths for hostd exec.

    Sandworm sandboxes mount the workspace at `/workspace`, while hostd executes on the host.
    Requests may therefore contain cwd values such as `/workspace/foo`, which must map to
    `<root>/foo` on the host to remain usable.
    """
    cwd_req = (requested_cwd or "").strip() or str(root)
    if cwd_req == "/workspace" or cwd_req.startswith("/workspace/"):
        suffix = cwd_req[len("/workspace") :].lstrip("/")
        candidate = (root / suffix).resolve(strict=False) if suffix else root.resolve(strict=False)
