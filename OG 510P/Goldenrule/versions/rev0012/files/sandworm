        ]
    )
    if parsed is not None:
        return (None if parsed <= 0 else int(parsed))
    return 45 if name == "gemini" else 20


def _terminate_proc_group(proc: subprocess.Popen[object], *, grace_s: int) -> None:
    try:
        pgid = os.getpgid(proc.pid)
    except Exception:
        pgid = None
    if pgid is not None:
        try:
            os.killpg(pgid, signal.SIGTERM)
        except Exception:
            pass
        deadline = time.time() + float(max(1, grace_s))
        while time.time() < deadline:
            if proc.poll() is not None:
                return
            time.sleep(0.05)
        try:
            os.killpg(pgid, signal.SIGKILL)
        except Exception:
            pass
        return
    try:
        proc.terminate()
    except Exception:
        pass
    deadline = time.time() + float(max(1, grace_s))
    while time.time() < deadline:
        if proc.poll() is not None:
            return
        time.sleep(0.05)
    try:
        proc.kill()
    except Exception:
        pass


def _run_with_capture_timeout(
    *, cmd: list[str], cwd: Path, env: dict[str, str], timeout_s: int | None
) -> subprocess.CompletedProcess[str]:
    """
    Run a subprocess capturing stdout/stderr, enforcing timeout with process-group teardown.
    """
    proc = subprocess.Popen(
        cmd,
        cwd=str(cwd),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
        start_new_session=True,
    )
    # Some smoke tests monkeypatch subprocess.Popen with lightweight fakes that do not
    # implement communicate(); keep the timeout/teardown contract in that case too.
    if not hasattr(proc, "communicate"):
        start = time.time()
        deadline = (start + float(timeout_s)) if (timeout_s is not None and int(timeout_s) > 0) else None
        try:
            while True:
                rc = proc.poll()
                if rc is not None:
                    return subprocess.CompletedProcess(
                        args=cmd,
                        returncode=int(rc),
                        stdout="",
                        stderr="",
                    )
                if deadline is not None and time.time() >= deadline:
                    _terminate_proc_group(proc, grace_s=_provider_timeout_grace_s())
                    raise subprocess.TimeoutExpired(cmd=cmd, timeout=float(timeout_s), output="", stderr="")
                time.sleep(0.1)
        except KeyboardInterrupt:
            _terminate_proc_group(proc, grace_s=_provider_timeout_grace_s())
            raise
    try:
        if timeout_s is not None and int(timeout_s) > 0:
            out, err = proc.communicate(timeout=float(timeout_s))
        else:
            out, err = proc.communicate()
        return subprocess.CompletedProcess(
            args=cmd,
            returncode=int(proc.returncode if proc.returncode is not None else 1),
            stdout=(out or ""),
            stderr=(err or ""),
        )
    except subprocess.TimeoutExpired as e:
        _terminate_proc_group(proc, grace_s=_provider_timeout_grace_s())
        out = ""
        err = ""
        try:
            out2, err2 = proc.communicate(timeout=0.2)
            out = out2 or ""
            err = err2 or ""
        except Exception:
            pass
        raise subprocess.TimeoutExpired(cmd=e.cmd, timeout=e.timeout, output=(out or e.output), stderr=(err or e.stderr))
    except KeyboardInterrupt:
        _terminate_proc_group(proc, grace_s=_provider_timeout_grace_s())
        raise


def _run_provider_attached(
    *, cmd: list[str], cwd: Path, env: dict[str, str], label: str, timeout_s: int | None, force_tty: bool
) -> int:
    hb_s = _provider_heartbeat_s()
    grace_s = _provider_timeout_grace_s()
    start = time.time()
    deadline = (start + float(timeout_s)) if (timeout_s is not None and int(timeout_s) > 0) else None
    try:
        cmd2 = wrap_with_pty_if_needed(cmd=cmd, force=force_tty, label=label)
    except PtyWrapError as e:
        raise ClientsError(str(e)) from e
    proc = subprocess.Popen(cmd2, cwd=str(cwd), env=env, start_new_session=True)
    if _progress_enabled():
        _note(f"starting {label}")
    next_tick = (start + float(hb_s)) if hb_s > 0 else float("inf")
    try:
        while True:
            rc = proc.poll()
            now = time.time()
            if rc is not None:
                if _progress_enabled():
                    elapsed = int(now - start)
                    _note(f"done {label} (exit={int(rc)}; elapsed {elapsed // 60:02d}:{elapsed % 60:02d})")
                return int(rc)
            if deadline is not None and now >= deadline:
                elapsed = int(now - start)
                _note(f"timeout {label} after {elapsed // 60:02d}:{elapsed % 60:02d}; terminating provider process group")
                _terminate_proc_group(proc, grace_s=grace_s)
                return 124
            if hb_s > 0 and _progress_enabled() and now >= next_tick:
                elapsed = int(now - start)
                _note(f"still {label} (elapsed {elapsed // 60:02d}:{elapsed % 60:02d})")
                next_tick = now + float(hb_s)
            time.sleep(0.2)
    except KeyboardInterrupt:
        _note(f"interrupt {label}; terminating provider process group")
        _terminate_proc_group(proc, grace_s=grace_s)
        return 130


def _nixpkgs_ref_is_pinned_enough(ref: object) -> bool:
    if not isinstance(ref, str) or not ref.strip():
        return False
    s = ref.strip()
    if s == "nixpkgs":
        return False
    if "refs/heads/" in s or s.endswith("/nixpkgs"):
        return False
    return True


def _pinned_nixpkgs_ref(root: Path) -> str | None:
    env_primary = os.environ.get("SW_NIXPKGS_FLAKE") or os.environ.get("SANDWORM_NIXPKGS_FLAKE")
    env_fb = os.environ.get("SW_NIXPKGS_FLAKE_FALLBACK") or os.environ.get("SANDWORM_NIXPKGS_FLAKE_FALLBACK")
    if _nixpkgs_ref_is_pinned_enough(env_primary):
        return str(env_primary).strip()
    if _nixpkgs_ref_is_pinned_enough(env_fb):
        return str(env_fb).strip()

    lf = lockfile_path(root)
    if not lf.exists():
        return None
    try:
        d = load_lockfile_dict(lf)
    except Exception:
        return None
    nix = d.get("nix") if isinstance(d, dict) else None
    if not isinstance(nix, dict):
        return None
    primary = nix.get("nixpkgs_flake")
    fb = nix.get("nixpkgs_flake_fallback")
    if _nixpkgs_ref_is_pinned_enough(primary):
        return str(primary).strip()
    if _nixpkgs_ref_is_pinned_enough(fb):
        return str(fb).strip()
    return None


def _pin_node_attr_if_needed(root: Path, node_attr: str, *, strict_supply_chain: bool) -> str:
    if not isinstance(node_attr, str) or "#" not in node_attr:
        return node_attr
    flake_ref, attr = node_attr.split("#", 1)
    if flake_ref != "nixpkgs":
        return node_attr
    pinned = _pinned_nixpkgs_ref(root)
    if pinned:
        return f"{pinned}#{attr}"
    if strict_supply_chain:
        raise ClientsError(
            "strict supply chain mode requires a pinned nixpkgs flake ref for Node execution "
            "(run: `sandworm lock pin-nixpkgs` or `sandworm refresh --update`)"
        )
    return node_attr


