esac
SCRIPT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR" && pwd -P)"
BB="$SCRIPT_DIR/busybox-static"
if [ -x "$BB" ] && [ -s "$BB" ]; then
  # Guard against stale script placeholders at busybox-static; only use non-script binaries.
  bb_first=""
  if [ -r "$BB" ]; then
    IFS= read -r bb_first < "$BB" || true
  fi
  case "$bb_first" in
    '#!'*) : ;;
    *) exec "$BB" {name} "$@" ;;
  esac
fi
for cand in /run/current-system/sw/bin/{name} /nix/var/nix/profiles/default/bin/{name} /usr/bin/{name} /bin/{name}; do
  if [ -x "$cand" ]; then
    exec "$cand" "$@"
  fi
done
found="$(command -v {name} 2>/dev/null || true)"
if [ -n "$found" ] && [ "$found" != "$0" ] && [ "$found" != "$SCRIPT_DIR/{name}" ]; then
  exec "$found" "$@"
fi
echo "{name}-compat: unable to locate '{name}' (busybox-static missing and no host fallback found)" >&2
exit 127
"""

def _ensure_toolroot_busybox_applets(root: Path, *, applets: list[str]) -> bool:
    """
    Ensure lightweight tool shims exist in the project-local toolroot.

    Some provider CLIs and wrappers call small POSIX utilities (for example
    pgrep/pkill/date) that may be missing on minimal hosts.
    Not all host distros install procps by default (notably minimal NixOS hosts), so
    provide these via busybox-static under `--root/.sandworm/toolroot/bin`.
    """
    try:
        bb = _ensure_busybox_static(root)
        bin_dir = (control_dir(root) / "toolroot" / "bin").resolve()
        bin_dir.mkdir(parents=True, exist_ok=True)
        # Ensure busybox-static lives next to the wrapper scripts.
        if bb and _is_valid_busybox_binary(bb):
            try:
                if bb.resolve() != (bin_dir / "busybox-static").resolve():
                    shutil.copy2(bb, bin_dir / "busybox-static")
                    try:
                        (bin_dir / "busybox-static").chmod(0o755)
                    except Exception:
                        pass
            except Exception:
                pass
        bb_local = bin_dir / "busybox-static"
        if not _is_valid_busybox_binary(bb_local):
            try:
                if bb_local.exists() or bb_local.is_symlink():
                    bb_local.unlink()
            except Exception:
                pass
        wrote_any = False
        for a in applets:
            if not isinstance(a, str) or not a.strip():
                continue
            name = a.strip()
            if name == "busybox-static":
                # Reserved binary target; never synthesize a wrapper that can clobber/alias it.
                continue
            if not re.match(r"^[A-Za-z0-9._+-]+$", name):
                continue
            wrapper = bin_dir / name
            # Prefer script wrappers over symlinks so a later-corrupted busybox-static file
            # does not transparently replace every applet with a broken binary/script target.
            try:
                if wrapper.exists() or wrapper.is_symlink():
                    wrapper.unlink()
            except Exception:
                pass
            _write_executable(wrapper, _toolroot_busybox_applet_wrapper_script(name))
            wrote_any = True
        return wrote_any
    except Exception:
        return False

def _codex_vendor_bin(root: Path) -> str | None:
    """
    Return the native Codex binary shipped inside the npm package, if present.

    In posture=bare-metal we prefer calling this directly to avoid introducing an
    extra Node (and potentially nix-portable) wrapper layer that can hide host
    paths like /run/current-system on NixOS.
    """
    if not sys.platform.startswith("linux"):
        return None
    try:
        machine = os.uname().machine
    except Exception:
        machine = ""
    if machine in ("x86_64", "amd64"):
        triple = "x86_64-unknown-linux-musl"
        pkg = "codex-linux-x64"
    elif machine in ("aarch64", "arm64"):
        triple = "aarch64-unknown-linux-musl"
        pkg = "codex-linux-arm64"
    else:
        return None
    clients_dir = clients_bin_dir(root).parent
    candidates = [
        # Legacy package layout.
        clients_dir / "npm" / "node_modules" / "@openai" / "codex" / "vendor" / triple / "codex" / "codex",
        # Current split package layout (as of codex 0.99.x).
        clients_dir / "npm" / "node_modules" / "@openai" / pkg / "vendor" / triple / "codex" / "codex",
    ]
    for p in candidates:
        if p.exists() and os.access(p, os.X_OK):
            return str(p)
    return None

def _argv_has_flag(argv: list[str], *names: str) -> bool:
    want = {n for n in names if isinstance(n, str) and n}
    for a in argv:
        if a in want:
            return True
        # Support --flag=value forms for long flags.
        if isinstance(a, str) and a.startswith("--") and "=" in a:
            k = a.split("=", 1)[0]
            if k in want:
                return True
    return False


def _codex_with_cd(argv: list[str], *, cwd: str) -> list[str]:
    if _argv_has_flag(argv, "-C", "--cd"):
        return list(argv)
    return ["--cd", str(cwd), *argv]


def _codex_apply_yolo_defaults(argv: list[str]) -> list[str]:
    """
    Sandworm-managed Codex runs default to non-interactive approvals and no nested
    Codex sandboxing. Sandworm already provides the isolation boundary.
    """
    out = list(argv)
    if not _argv_has_flag(out, "--sandbox", "-s") and not _argv_has_flag(
        out, "--dangerously-bypass-approvals-and-sandbox"
    ):
        out = ["--sandbox", "danger-full-access", *out]
    # Codex's `--dangerously-bypass-approvals-and-sandbox` is incompatible with
    # `--ask-for-approval`; when bypass is explicit, do not inject approval mode.
    if not _argv_has_flag(out, "--dangerously-bypass-approvals-and-sandbox"):
        if not _argv_has_flag(out, "--ask-for-approval", "-a"):
            out = ["--ask-for-approval", "never", *out]
    return out


def codex_effective_argv(argv: list[str], *, cwd: str) -> list[str]:
    """
    Normalize Codex argv for Sandworm launches.

    This is the single source of truth used by both runtime execution and
    dry-run/provider-invocation previews so humans see the exact effective
    policy Sandworm applies.
    """
    out = _codex_with_cd(list(argv), cwd=str(cwd))
    return _codex_apply_yolo_defaults(out)


def _codex_network_is_offline_requested(network: str | None) -> bool:
    net = (network or "").strip().lower()
    if net == "none":
        return True
    return _truthy_env("SW_OFFLINE") or _truthy_env("SANDWORM_OFFLINE")

def _sanitize_codex_network_env(env: dict[str, str], *, network: str | None, explicit: bool = False) -> None:
    """
    Keep Codex internal sandbox networking aligned with Sandworm intent.

    We intentionally drop inherited `CODEX_SANDBOX_NETWORK_DISABLED=1` in online runs,
    because parent shells (or orchestrators) may set it globally and accidentally force
    Codex offline even when Sandworm selected an online backend.
    """
    key = "CODEX_SANDBOX_NETWORK_DISABLED"
    if explicit:
        return
    if _codex_network_is_offline_requested(network):
        env[key] = "1"
    else:
        env.pop(key, None)


def _harden_gemini_runtime_env(env: dict[str, str]) -> None:
    """
    Apply low-risk Gemini compatibility guards for nested runtimes.

    - Remove CI marker env by default: upstream Gemini/Node stacks may infer
      non-interactive CI mode from inherited env and wedge first-login flows.
    - Prefer IPv4 DNS ordering unless explicitly disabled: reduces known
      IPv6-first timeout classes in constrained/containerized environments.
    """
    preserve_ci = _truthy_env("SW_GEMINI_PRESERVE_CI_ENV") or _truthy_env("SANDWORM_GEMINI_PRESERVE_CI_ENV")
    if not preserve_ci:
        for k in (
            "CI",
            "CONTINUOUS_INTEGRATION",
            "BUILD_NUMBER",
            "BUILD_ID",
            "RUN_ID",
            "GITHUB_ACTIONS",
            "GITLAB_CI",
            "CIRCLECI",
            "TRAVIS",
            "APPVEYOR",
            "JENKINS_URL",
            "HUDSON_URL",
            "TEAMCITY_VERSION",
            "TF_BUILD",
        ):
            env.pop(k, None)

    dns_compat_enabled = not (_truthy_env("SW_GEMINI_IPV4FIRST_DISABLE") or _truthy_env("SANDWORM_GEMINI_IPV4FIRST_DISABLE"))
    if dns_compat_enabled:
        node_opts = str(env.get("NODE_OPTIONS") or "").strip()
        if "--dns-result-order=" not in node_opts:
            env["NODE_OPTIONS"] = (
                f"{node_opts} --dns-result-order=ipv4first".strip() if node_opts else "--dns-result-order=ipv4first"
            )

    # Gemini CLI uses an internal parent/child relaunch loop (exit code 199) for trust/auth
    # transitions. In some nested/containerized environments this can hang on first login.
    # Default to single-process mode unless explicitly opted back in.
    allow_relaunch = _truthy_env("SW_GEMINI_ALLOW_INTERNAL_RELAUNCH") or _truthy_env("SANDWORM_GEMINI_ALLOW_INTERNAL_RELAUNCH")
    if not allow_relaunch:
        env.setdefault("GEMINI_CLI_NO_RELAUNCH", "1")

    # Upstream headless-auth guidance: NO_BROWSER=true forces the manual code flow.
    # In nested Sandworm runtimes (podman/bwrap/kvm/inherited), auto browser launch can
    # wedge first-login flows. Keep browser auth opt-in via env for users who want it.
    allow_browser = _truthy_env("SW_GEMINI_ALLOW_BROWSER_AUTH") or _truthy_env("SANDWORM_GEMINI_ALLOW_BROWSER_AUTH")
    if not allow_browser:
        env.setdefault("NO_BROWSER", "true")

def _ensure_shim_bin(home_dir: Path) -> Path:
    d = home_dir / ".sandworm-shims" / "bin"
    try:
        d.mkdir(parents=True, exist_ok=True)
    except Exception:
        pass
    return d

def _ensure_symlink(shim_path: Path, target: str) -> None:
    try:
        if shim_path.exists():
            return
        shim_path.symlink_to(target)
    except Exception:
        # Best-effort. If we can't create a shim (FS perms, exotic FS), ignore.
        pass



def _ensure_clients_bash_shim(root: Path) -> None:
    """Ensure `bash` is available early on PATH inside Sandworm sandboxes.

    Gemini CLI's shell tool is hardcoded to spawn `bash` (not $SHELL). In nested sandboxes
    this can fail with "bash not found" even when /bin/bash exists, so provide a shim in
    `--root/.sandworm/clients/bin` (mounted to /run/sandworm/clients/bin).
    """
    try:
        shim = clients_bin_dir(root) / "bash"
        bb = control_dir(root) / "toolroot" / "bin" / "busybox-static"
        shebang = "#!/bin/sh"
        if _is_valid_busybox_binary(bb):
            # Use static busybox in sandboxed runs so this shim does not depend on /bin/sh.
            shebang = "#!/run/sandworm/toolroot/bin/busybox-static sh"
        _write_executable(
            shim,
            f"""{shebang}
set -eu
BB=/run/sandworm/toolroot/bin/busybox-static
for c in /bin/bash /usr/bin/bash /run/current-system/sw/bin/bash /run/sandworm/toolroot/bin/bash.real; do
  if [ -x \"$c\" ]; then exec \"$c\" \"$@\"; fi
done
# Minimal compatibility for bash -c (Gemini shell tool contract).
if [ \"${1:-}\" = \"-c\" ]; then
  shift || true
  cmd=\"${1:-}\"
  shift || true
  # Gemini prepends non-POSIX `shopt ...` prologue; strip it for sh fallback.
  case \"$cmd\" in
    'shopt -u promptvars nullglob extglob nocaseglob dotglob; '*) cmd=\"${{cmd#shopt -u promptvars nullglob extglob nocaseglob dotglob; }}\" ;;
  esac
  if [ -x \"$BB\" ]; then
    exec \"$BB\" sh -c \"$cmd\" \"$@\"
  fi
  exec /bin/sh -c \"$cmd\" \"$@\"
fi
if [ -x \"$BB\" ]; then
  exec \"$BB\" sh \"$@\"
fi
exec /bin/sh \"$@\"
""",
        )
    except Exception:
        return
def _ensure_gemini_bash_shim(*, root: Path, home_dir: Path, env: dict[str, str]) -> None:
    """
    Gemini's shell tool always spawns `bash -c ...` (hardcoded upstream). On NixOS,
    `bash` typically lives under /run/current-system or /nix/store; if Gemini tools
    run in a restricted namespace, exec can fail with ENOENT (missing interpreter),
    which shows up as `execvp(3) failed`.

    Provide a best-effort `bash` shim on PATH:
    - Prefer a real bash when it's likely stable.
    - Otherwise, use Sandworm's nix-portable BusyBox (static) to implement enough of
      the `bash -c` contract for basic commands.
    """
    shim_dir = _ensure_shim_bin(home_dir)
    shim_bash = shim_dir / "bash"

    # Determine candidate bash.
    bash_target = ""
    try:
        orig_path = env.get("PATH") or ""
        # Avoid picking up our own shim (which can create symlink loops).
        path_wo_shim = ":".join([p for p in orig_path.split(":") if p and p != str(shim_dir)])
        bash_target = shutil.which("bash", path=path_wo_shim) or ""
    except Exception:
        bash_target = ""
    if not bash_target:
        for c in ("/bin/bash", "/usr/bin/bash", "/run/current-system/sw/bin/bash"):
            if os.path.exists(c) and os.access(c, os.X_OK):
                bash_target = c
                break
    try:
        if bash_target and os.path.samefile(bash_target, shim_bash):
            bash_target = ""
    except Exception:
        pass

    busybox = control_dir(root) / "nix-portable" / ".nix-portable" / "busybox" / "bin" / "busybox"
    bb = str(busybox) if busybox.exists() and os.access(busybox, os.X_OK) else ""

    # Always install a shim script (not a symlink) to avoid symlink loops and to allow
    # a safe fallback when the real bash is not executable in the tool environment.
    try:
        env["PATH"] = ":".join([str(shim_dir), env.get("PATH", "")]).strip(":")
        try:
            if shim_bash.exists() or shim_bash.is_symlink():
                shim_bash.unlink(missing_ok=True)  # type: ignore[arg-type]
        except Exception:
            pass

        # Prefer executing a real bash by absolute path. If that fails because the tool
        # environment cannot see /run or /nix/store, fall back to BusyBox sh.
        candidates: list[str] = []
        if bash_target:
            candidates.append(bash_target)
        candidates.extend(
            [
                "/run/current-system/sw/bin/bash",
                "/bin/bash",
                "/usr/bin/bash",
            ]
        )
        # Dedup while preserving order.
        seen: set[str] = set()
        cand2 = []
        for c in candidates:
            if c and c not in seen:
                seen.add(c)
                cand2.append(c)
        candidates = cand2

        # Use BusyBox as the shim interpreter if available; otherwise rely on /bin/sh.
        shebang = f"#!{bb} sh" if bb else "#!/bin/sh"

        lines = [shebang, "set -eu"]
        if bb:
            lines.append(f"BUSYBOX={bb!r}")
        lines.append("for c in " + " ".join([f"'{c}'" for c in candidates]) + "; do")
        lines.append("  if [ -x \"$c\" ]; then exec \"$c\" \"$@\"; fi")
        lines.append("done")
        if bb:
            lines.extend(
                [
                    "if [ \"${1:-}\" = \"-c\" ]; then",
                    "  shift || true",
                    "  cmd=\"${1:-}\"",
                    "  shift || true",
                    "  exec \"$BUSYBOX\" sh -c \"$cmd\"",
                    "fi",
                    "exec \"$BUSYBOX\" sh \"$@\"",
                ]
            )
        else:
            lines.append("echo \"ERROR: bash not found and busybox unavailable\" >&2")
            lines.append("exit 127")
        _write_executable(shim_bash, "\n".join(lines) + "\n")
    except Exception:
        pass


def _ensure_gemini_settings_for_sandbox(home_dir: Path, *, auto_update_enabled_override: bool | None = None) -> None:
    """Best-effort: make Gemini shell tool reliable inside Sandworm sandboxes.

    Gemini CLI defaults to using node-pty for the shell tool (interactive), which can be brittle
    in nested sandboxes (bwrap/podman/KVM). When it breaks, Gemini tool runs often error with
    execvp failures or "bash not found".

    Defaults:
    - tools.shell.enableInteractiveShell=false (unless SW_GEMINI_ENABLE_INTERACTIVE_SHELL=1)
    - general.previewFeatures=true (unless SW_GEMINI_PREVIEW_FEATURES=0)
    - general.enableAutoUpdate=true + enableAutoUpdateNotification=true
      (set SW_GEMINI_INTERNAL_AUTOUPDATE=0 to disable)
    """
    try:
        gem_dir = (home_dir / '.gemini').resolve()
        gem_dir.mkdir(parents=True, exist_ok=True)
        p = (gem_dir / 'settings.json').resolve()
        import json

        data: object = {}
        if p.exists():
            try:
                data = json.loads(p.read_text(encoding='utf-8') or '{}')
            except Exception:
                data = {}
        if not isinstance(data, dict):
            data = {}

        tools = data.get('tools')
        if not isinstance(tools, dict):
            tools = {}
            data['tools'] = tools
        shell = tools.get('shell')
        if not isinstance(shell, dict):
            shell = {}
            tools['shell'] = shell

        changed = False
        if (
            not _truthy_env('SW_GEMINI_ENABLE_INTERACTIVE_SHELL')
            and not _truthy_env('SANDWORM_GEMINI_ENABLE_INTERACTIVE_SHELL')
        ):
            # Force non-interactive shell mode in Sandworm sandboxes unless explicitly opted out.
            # Gemini's interactive shell path (node-pty) is fragile in nested/limited environments.
            if shell.get('enableInteractiveShell') is not False:
                shell['enableInteractiveShell'] = False
                changed = True

        if "general" not in data or not isinstance(data.get("general"), dict):
            data["general"] = {}
        general = data.get("general")
        if not isinstance(general, dict):
            general = {}
            data["general"] = general
        if os.environ.get("SW_GEMINI_PREVIEW_FEATURES", "1").strip().lower() in ("1", "true", "yes", "y", "on"):
            if general.get("previewFeatures") is not True:
                general["previewFeatures"] = True
                changed = True

        auto_enabled = True
        if auto_update_enabled_override is not None:
            auto_enabled = bool(auto_update_enabled_override)
        else:
            auto_raw = os.environ.get("SW_GEMINI_INTERNAL_AUTOUPDATE")
            if auto_raw is None:
                auto_raw = os.environ.get("SANDWORM_GEMINI_INTERNAL_AUTOUPDATE")
            if isinstance(auto_raw, str) and auto_raw.strip():
                auto_enabled = auto_raw.strip().lower() in ("1", "true", "yes", "y", "on")
        if auto_enabled:
            if general.get("enableAutoUpdate") is not True:
                general["enableAutoUpdate"] = True
                changed = True
            if general.get("enableAutoUpdateNotification") is not True:
                general["enableAutoUpdateNotification"] = True
                changed = True
        else:
            if general.get("enableAutoUpdate") is not False:
                general["enableAutoUpdate"] = False
                changed = True
            if general.get("enableAutoUpdateNotification") is not False:
                general["enableAutoUpdateNotification"] = False
                changed = True

        if changed:
            p.write_text(json.dumps(data, indent=2, sort_keys=True) + '\n', encoding='utf-8')
            try:
                p.chmod(0o600)
            except Exception:
                pass
    except Exception:
        return



def _ensure_gemini_tmp_bin_shims(home_dir: Path) -> None:
    """Best-effort: seed Gemini's private tmp/bin with critical command shims.

    Gemini CLI can spawn tools with PATH preferring (or limited to) `$HOME/.gemini/tmp/bin`.
    If `bash` is missing there, tool calls can fail with `spawn bash ENOENT` even when
    `/bin/bash` exists in the outer sandbox.
    """
    try:
        tmp_bin = (home_dir / ".gemini" / "tmp" / "bin").resolve()
        tmp_bin.mkdir(parents=True, exist_ok=True)
        # Keep this set minimal and purpose-built for Sandworm tool-use prompts.
        _ensure_symlink(tmp_bin / "bash", "/run/sandworm/clients/bin/bash")
        _ensure_symlink(tmp_bin / "sh", "/bin/sh")
        _ensure_symlink(tmp_bin / "cat", "/run/sandworm/toolroot/bin/cat")
        _ensure_symlink(tmp_bin / "cut", "/run/sandworm/toolroot/bin/cut")
        _ensure_symlink(tmp_bin / "sha256sum", "/run/sandworm/toolroot/bin/sha256sum")
    except Exception:
        return


def _ensure_clients_node_shim_for_sandboxes(root: Path) -> bool:
    """Best-effort: provide a *real* node binary in clients/bin for sandboxed providers.

    The default Sandworm toolroot `node` wrapper uses nix-portable (`nix shell ...`), which can
    introduce an extra nested sandbox (proot/bwrap) and hide /usr inside an outer sandbox. Gemini's
    shell tool then fails to resolve `bash` via PATH.

    If we can obtain a direct node binary (typically from /nix/store on NixOS), write a tiny shim to
    `--root/.sandworm/clients/bin/node` so provider wrappers pick it up via PATH.
    """
    try:
        bin_dir = clients_bin_dir(root)
        shim = bin_dir / "node"
        desired = """#!/bin/sh
set -eu

# Prefer a real node when it exists in the execution environment (e.g. podman node image).
for c in /usr/local/bin/node /usr/bin/node /bin/node; do
  if [ -x "$c" ]; then exec "$c" "$@"; fi
done

# Sandworm sandboxes mount toolroot here.
if [ -x /run/sandworm/toolroot/bin/node ]; then
  exec /run/sandworm/toolroot/bin/node "$@"
fi

# Host layout: <root>/.sandworm/clients/bin/node
SCRIPT="$0"
case "$SCRIPT" in
  */*) SCRIPT_DIR="${SCRIPT%/*}" ;;
  *) SCRIPT_DIR="." ;;
esac
CLIENTS_DIR="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd -P || true)"
ROOT=""
case "$CLIENTS_DIR" in
  */.sandworm/clients) ROOT="$(cd "$CLIENTS_DIR/../.." 2>/dev/null && pwd -P || true)" ;;
esac
if [ -n "${ROOT:-}" ] && [ -x "$ROOT/.sandworm/toolroot/bin/node" ]; then
  exec "$ROOT/.sandworm/toolroot/bin/node" "$@"
fi

# Last resort: use nix directly (clients install/selfcheck can run before toolroot is hydrated).
if [ -n "${SANDWORM_NIX:-}" ] && [ -x "${SANDWORM_NIX}" ]; then
  NIX="${SANDWORM_NIX}"
elif command -v nix >/dev/null 2>&1; then
  NIX="$(command -v nix)"
else
  echo "node: nix not found (run: sandworm refresh)" >&2
  exit 127
fi

exec "$NIX" --extra-experimental-features 'nix-command flakes' shell nixpkgs#nodejs_22 --command node "$@"
"""
        try:
            if shim.exists() and shim.read_text(encoding="utf-8") == desired:
                return True
        except Exception:
            pass
        _write_executable(shim, desired)
        return True
    except Exception:
        return False


def _progress_enabled() -> bool:
    v = os.environ.get("SW_BOOTSTRAP_PROGRESS")
    if isinstance(v, str) and v.strip():
        return v.strip().lower() in ("1", "true", "yes", "y", "on")
    try:
        return bool(sys.stderr.isatty())
    except Exception:
        return False


def _note(msg: str) -> None:
    if not msg:
        return
    print(f"[sandworm] {msg}", file=sys.stderr)

def _run_with_heartbeat(
    *,
    cmd: list[str],
    cwd: Path,
    env: dict[str, str],
    label: str,
    timeout_s: int | None = None,
) -> int:
    """
    Run a subprocess inheriting stdio (interactive), while emitting periodic heartbeat messages.
    """
    hb_s_raw = os.environ.get("SW_BOOTSTRAP_HEARTBEAT_S")
    hb_s = 10
    if isinstance(hb_s_raw, str) and hb_s_raw.strip():
        try:
            hb_s = max(0, int(float(hb_s_raw.strip())))
        except Exception:
            hb_s = 10
    # Noob ergonomics: during the first minute of a cold bootstrap, emit more frequent progress markers
    # so users don't assume it's wedged. After the window, fall back to the normal heartbeat interval.
    fast_window_s_raw = os.environ.get("SW_BOOTSTRAP_FAST_WINDOW_S")
    fast_window_s = 60
    if isinstance(fast_window_s_raw, str) and fast_window_s_raw.strip():
        try:
            fast_window_s = max(0, int(float(fast_window_s_raw.strip())))
        except Exception:
            fast_window_s = 60
    fast_hb_s_raw = os.environ.get("SW_BOOTSTRAP_FAST_HEARTBEAT_S")
    fast_hb_s = 2
    if isinstance(fast_hb_s_raw, str) and fast_hb_s_raw.strip():
        try:
            fast_hb_s = max(0, int(float(fast_hb_s_raw.strip())))
        except Exception:
            fast_hb_s = 2
    grace_s = _provider_timeout_grace_s()
    start = time.time()
    deadline = (start + float(timeout_s)) if (timeout_s is not None and int(timeout_s) > 0) else None
    proc = subprocess.Popen(cmd, cwd=cwd, env=env, stdout=sys.stderr, stderr=sys.stderr, start_new_session=True)
    if _progress_enabled():
        _note(f"starting {label}")
    if hb_s <= 0:
        next_tick = float("inf")
    else:
        tick = hb_s
        if fast_window_s > 0 and fast_hb_s > 0:
            tick = min(hb_s, fast_hb_s)
        next_tick = start + float(tick)
    try:
        while True:
            rc = proc.poll()
            now = time.time()
            if rc is not None:
                if _progress_enabled():
                    elapsed = int(now - start)
                    _note(f"done {label} (exit={int(rc)}; elapsed {elapsed // 60:02d}:{elapsed % 60:02d})")
                return int(rc)
            if deadline is not None and now >= deadline:
                elapsed = int(now - start)
                _note(f"timeout {label} after {elapsed // 60:02d}:{elapsed % 60:02d}; terminating install process group")
                _terminate_proc_group(proc, grace_s=grace_s)
                return 124
            if hb_s > 0 and _progress_enabled() and now >= next_tick:
                elapsed = int(now - start)
                _note(f"still {label} (elapsed {elapsed // 60:02d}:{elapsed % 60:02d})")
                tick = hb_s
                if fast_window_s > 0 and fast_hb_s > 0 and (now - start) < float(fast_window_s):
                    tick = min(hb_s, fast_hb_s)
                next_tick = now + float(tick)
            time.sleep(0.2)
    except KeyboardInterrupt:
        _note(f"interrupt {label}; terminating install process group")
        _terminate_proc_group(proc, grace_s=grace_s)
        return 130


def _int_env_first(names: list[str]) -> int | None:
    for name in names:
        raw = os.environ.get(name)
        if not isinstance(raw, str) or not raw.strip():
            continue
        try:
            return int(float(raw.strip()))
        except Exception:
            continue
    return None


def _provider_attached_timeout_s(*, interactive_tty: bool) -> int | None:
    names: list[str] = []
    if interactive_tty:
        names.extend(["SW_PROVIDER_ATTACHED_TIMEOUT_TTY_S", "SANDWORM_PROVIDER_ATTACHED_TIMEOUT_TTY_S"])
    else:
        names.extend(["SW_PROVIDER_ATTACHED_TIMEOUT_NOTTY_S", "SANDWORM_PROVIDER_ATTACHED_TIMEOUT_NOTTY_S"])
    names.extend(
        [
            "SW_PROVIDER_ATTACHED_TIMEOUT_S",
            "SANDWORM_PROVIDER_ATTACHED_TIMEOUT_S",
            "SW_SMOKE_PROVIDERS_TOOLUSE_TIMEOUT_S",
        ]
    )
    parsed = _int_env_first(names)
    if parsed is not None:
        return (None if parsed <= 0 else int(parsed))
    if interactive_tty:
        return None
    # Non-interactive real-provider lanes should fail closed instead of hanging forever.
    return 900


def _provider_heartbeat_s() -> int:
    parsed = _int_env_first(
        [
            "SW_PROVIDER_HEARTBEAT_S",
            "SANDWORM_PROVIDER_HEARTBEAT_S",
            "SW_BOOTSTRAP_HEARTBEAT_S",
            "SANDWORM_BOOTSTRAP_HEARTBEAT_S",
        ]
    )
    if parsed is None:
        return 10
    return max(0, int(parsed))


def _provider_timeout_grace_s() -> int:
    parsed = _int_env_first(["SW_PROVIDER_TIMEOUT_GRACE_S", "SANDWORM_PROVIDER_TIMEOUT_GRACE_S"])
    if parsed is None:
        return 3
    return max(1, int(parsed))


def _clients_install_timeout_s() -> int | None:
    parsed = _int_env_first(
        [
            "SW_CLIENTS_INSTALL_TIMEOUT_S",
            "SANDWORM_CLIENTS_INSTALL_TIMEOUT_S",
            "SW_PROVIDER_INSTALL_TIMEOUT_S",
            "SANDWORM_PROVIDER_INSTALL_TIMEOUT_S",
        ]
    )
    if parsed is None:
        # Install/autoupdate should not hang forever, especially in interactive noob lanes.
        return 300
    return (None if parsed <= 0 else int(parsed))


def _clients_selfcheck_timeout_s(*, name: str) -> int | None:
    parsed = _int_env_first(
        [
            "SW_CLIENTS_SELFCHECK_TIMEOUT_S",
            "SANDWORM_CLIENTS_SELFCHECK_TIMEOUT_S",
