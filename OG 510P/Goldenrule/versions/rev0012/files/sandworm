    if p["socket"] != p["legacy_socket"]:
        try:
            p["legacy_socket"].unlink(missing_ok=True)
        except Exception:
            pass
        try:
            p["legacy_socket"].symlink_to(p["socket"])
        except Exception:
            pass
        try:
            p["socket_ref"].write_text(str(p["socket"]) + "\n", encoding="utf-8")
        except Exception:
            pass
    else:
        try:
            p["socket_ref"].unlink(missing_ok=True)
        except Exception:
            pass


