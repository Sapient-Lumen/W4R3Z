def archive_run(root: Path, runid: str, *, note: str | None, turn: str | None) -> Path:
    run_dir = control_dir(root) / "runs" / runid
    if not run_dir.exists():
        raise FileNotFoundError(f"run not found: {run_dir}")

    archives = control_dir(root) / "archives"
    archives.mkdir(parents=True, exist_ok=True)

    label = f"run-{runid}"
    if turn:
        label = f"turn-{turn}-{label}"
    out = archives / f"{label}.tar.gz"

    with tarfile.open(out, "w:gz") as tf:
        tf.add(run_dir, arcname=f"runs/{runid}")
        # Always include the current v2 spec and open-questions docs (best-effort).
        spec = root / "SPEC" / "SANDWORM-v2-draft-spec.md"
        oq = root / "SPEC" / "SANDWORM-v2-open-questions.md"
        if spec.exists():
            tf.add(spec, arcname="SPEC/SANDWORM-v2-draft-spec.md")
        if oq.exists():
            tf.add(oq, arcname="SPEC/SANDWORM-v2-open-questions.md")

        meta_lines = [f"created_at={dt.datetime.now(dt.timezone.utc).isoformat()}"]
        if turn:
            meta_lines.append(f"turn={turn}")
        meta_lines.append(f"runid={runid}")
        if note:
            meta_lines.append("")
            meta_lines.append(note.rstrip())
        _add_text(tf, arcname=f"runs/{runid}/ARCHIVE_NOTE.txt", text="\n".join(meta_lines).rstrip() + "\n")

        git_status = _best_effort_git_status(root)
        if git_status is not None:
            _add_text(tf, arcname=f"runs/{runid}/git-status.txt", text=git_status)

        diff = _best_effort_git_diff(root)
        if diff is not None:
            _add_text(tf, arcname=f"runs/{runid}/git-diff.patch", text=diff)

        diff_staged = _best_effort_git_diff_staged(root)
        if diff_staged is not None:
            _add_text(tf, arcname=f"runs/{runid}/git-diff-staged.patch", text=diff_staged)

        if not (run_dir / "doctor.json").exists():
            doctor = _best_effort_doctor_report(root)
            if doctor is not None:
                _add_text(tf, arcname=f"runs/{runid}/doctor.json", text=doctor)

    return out
