def _truthy(v: object) -> bool:
    if isinstance(v, bool):
        return v
    if isinstance(v, (int, float)):
        return bool(v)
    if isinstance(v, str):
        return v.strip().lower() in ("1", "true", "yes", "y", "on")
    return False


def _hostd_override_forced() -> bool:
    return _truthy(os.environ.get("SW_HOSTD_OVERRIDE_FORCE")) or _truthy(os.environ.get("SANDWORM_HOSTD_OVERRIDE_FORCE"))


def _nested_runtime_markers_present() -> bool:
    backend = str(os.environ.get("SANDWORM_BACKEND") or "").strip().lower()
    if backend not in ("podman", "bwrap", "kvm"):
        return False
    home = str(os.environ.get("SANDWORM_HOME") or os.environ.get("HOME") or "").strip()
    return home == "/run/sandworm/home"


def _root_control_plane_visible(root: Path) -> bool:
    try:
        return (control_dir(root) / "CONTROL_PLANE_DO_NOT_TOUCH").exists()
    except Exception:
        return False


def _socket_path(root: Path) -> Path:
    override = os.environ.get("SANDWORM_HOSTD_SOCK")
    root_sock = hostd_socket(root)
    root_visible = _root_control_plane_visible(root)
    if root_visible and root_sock.exists() and not _hostd_override_forced():
        return root_sock
    if override:
        return Path(override)
    if root_visible:
        return root_sock
    # In nested Sandworm sessions, hostd is typically mounted here even when --root
    # points at a masked control plane path.
    nested_default = Path("/run/sandworm/hostd.sock")
    if _nested_runtime_markers_present() and nested_default.exists():
        return nested_default
    return root_sock

