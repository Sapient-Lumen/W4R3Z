from __future__ import annotations

import json
import os
from pathlib import Path
from datetime import datetime

from .stateroot import control_dir

def load_latest_runid(root: Path) -> str | None:
    runs = control_dir(root) / "runs"
    if not runs.exists():
        return None
    dirs = [p for p in runs.iterdir() if p.is_dir()]
    if not dirs:
        return None
    # Prefer filesystem mtime for "latest" semantics; runid lexicographic order
    # is not guaranteed when multiple runs occur within the same second.
    dirs.sort(key=lambda p: p.stat().st_mtime)
    return dirs[-1].name


def _read_events(run_dir: Path) -> list[dict]:
    p = run_dir / "events.jsonl"
    if not p.exists():
        return []
    out: list[dict] = []
    for line in p.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        out.append(json.loads(line))
    return out


def report_json_for_run(root: Path, runid: str) -> dict:
    run_dir = control_dir(root) / "runs" / runid
    events = _read_events(run_dir)

    warnings = [e for e in events if e.get("type") == "warning"]
    errors = [e for e in events if e.get("type") == "error"]
    run_end = next((e for e in reversed(events) if e.get("type") == "run_end"), None)

    providers: dict[str, dict] = {}

    def _prov(name: str) -> dict:
        if name not in providers:
            providers[name] = {
                "provider": name,
                "invocation": None,
                "plan": None,
                "attempts": [],
                "selected": None,
                "warnings": [],
            }
        return providers[name]

    # Stitch attempt records by (provider, attempt_no).
    idx: dict[tuple[str, int], dict] = {}

    for e in events:
        typ = e.get("type")
        data = e.get("data") or {}
        if not isinstance(data, dict):
            continue

        if typ == "provider_backend_plan":
            p = data.get("provider")
            if isinstance(p, str) and p:
                _prov(p)["plan"] = data
            continue

        if typ == "provider_invocation":
            p = data.get("provider")
            if isinstance(p, str) and p:
                _prov(p)["invocation"] = data
            continue

        if typ == "provider_warning":
            p = data.get("provider")
            if isinstance(p, str) and p:
                _prov(p)["warnings"].append(data)
            continue

        if typ in (
            "provider_backend_attempt",
            "provider_backend_result",
            "provider_backend_error",
            "provider_backend_probe",
            "provider_backend_selected",
        ):
            p = data.get("provider")
            if not isinstance(p, str) or not p:
                continue
            attempt = data.get("attempt")
            if not isinstance(attempt, int):
                # best-effort: accept numeric strings
                try:
                    attempt = int(str(attempt))
                except Exception:
                    continue
            key = (p, int(attempt))
            rec = idx.get(key)
            if rec is None:
                rec = {
                    "attempt": int(attempt),
                    "backend": None,
                    "exit_code": None,
                    "error": None,
                    "probe": None,
                    "selected": False,
                }
                idx[key] = rec
                _prov(p)["attempts"].append(rec)

            if typ == "provider_backend_attempt":
                b = data.get("backend")
                if isinstance(b, str) and b:
                    rec["backend"] = b
            elif typ == "provider_backend_result":
                rec["backend"] = rec.get("backend") or data.get("backend")
                if "exit_code" in data:
                    rec["exit_code"] = data.get("exit_code")
            elif typ == "provider_backend_error":
                rec["backend"] = rec.get("backend") or data.get("backend")
                if "error" in data:
                    rec["error"] = data.get("error")
            elif typ == "provider_backend_probe":
                rec["backend"] = rec.get("backend") or data.get("backend")
                rec["probe"] = {
                    "result": data.get("result"),
                    "detail": data.get("detail"),
                    "network": data.get("network"),
                }
            elif typ == "provider_backend_selected":
                rec["backend"] = rec.get("backend") or data.get("backend")
                rec["selected"] = True
                _prov(p)["selected"] = {"backend": rec.get("backend"), "attempt": int(attempt)}

    # Sort attempts for stability.
    for p in providers.values():
        try:
            p["attempts"].sort(key=lambda r: int(r.get("attempt") or 0))
        except Exception:
            pass

    return {
        "runid": runid,
        "run_dir": str(run_dir),
        "counts": {"events": len(events), "warnings": len(warnings), "errors": len(errors)},
        "run_end": (run_end.get("data") if isinstance(run_end, dict) else None),
        "providers": providers,
    }


def render_minimal_transcript(root: Path, runid: str) -> Path:
    run_dir = control_dir(root) / "runs" / runid
    run_dir.mkdir(parents=True, exist_ok=True)
    events = _read_events(run_dir)
    lines: list[str] = [f"# Sandworm transcript: {runid}", ""]

    by_step: dict[str, list[dict]] = {}
    for e in events:
        step = e.get("step")
        if isinstance(step, str):
            by_step.setdefault(step, []).append(e)

    # If there were no step events, fall back to a simple event stream.
    if not by_step:
        for e in events:
            typ = e.get("type")
            ts = e.get("ts")
            step = e.get("step") or "-"
            lines.append(f"- `{ts}` `{step}` `{typ}`")
        p = run_dir / "transcript.md"
        p.write_text("\n".join(lines) + "\n", encoding="utf-8")
        return p

    lines.append("## Steps")
    lines.append("")
    for step_id in sorted(by_step.keys()):
        lines.append(f"### {step_id}")
        lines.append("")
        for e in by_step[step_id]:
            typ = e.get("type")
            data = e.get("data") or {}
            if typ == "prompt":
                stored = data.get("stored_path")
                lines.append(f"- prompt: `{stored}`")
            elif typ == "hook_host":
                hook = data.get("hook")
                code = data.get("exit_code")
                sp = data.get("stdout_path")
                ep = data.get("stderr_path")
                status = data.get("status")
                lines.append(f"- hook_host: hook={hook} status={status} exit={code} logs={sp or '-'} {ep or '-'}")
            elif typ == "provider_exec":
                provider = data.get("provider")
                code = data.get("exit_code")
                sp = data.get("stdout_path")
                ep = data.get("stderr_path")
                lines.append(f"- provider_exec: provider={provider} exit={code} logs={sp or '-'} {ep or '-'}")
            elif typ in ("sandbox_exec", "sandbox_shell", "host_exec"):
                argv = data.get("argv")
                code = data.get("exit_code")
                lines.append(f"- {typ}: exit={code} argv={argv}")
        lines.append("")
    p = run_dir / "transcript.md"
    p.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return p


def generate_report_for_run(root: Path, runid: str) -> Path:
