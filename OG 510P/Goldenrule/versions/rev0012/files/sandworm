def control_dir(root: Path) -> Path:
    """
    Return the control-plane directory (normally `<root>/.sandworm`).

    DEV/KVM (Option B) needs a way to keep `/workspace/.sandworm` masked while still allowing
    Sandworm to self-host. This is done by setting:

      SANDWORM_STATE_ROOT=/run/sandworm/home/devroot/.sandworm

    Safety notes:
    - By default, overrides are only honored when they point under:
      - `<root>/.sandworm`, or
      - `$SANDWORM_HOME` (when set, e.g. inside sandboxes/guests).
    - To allow an override elsewhere, set `SW_ALLOW_STATE_ROOT_OUTSIDE_ROOT=1`.
    """
    root = root.resolve()
