        if args.cmd == "auth":
            from .auth import AuthError, auth_login, claude_cli_clear_credentials, claude_cli_login_status, codex_login_status
            from .creds import (
                CredsError,
                claude_api_key_sha256,
                clear_provider_creds,
                codex_api_key_sha256,
                creds_path,
                get_claude_api_key,
                get_codex_api_key,
                get_gemini_api_key,
                gemini_api_key_sha256,
                inject_provider_creds_env,
                redact_known_secrets,
                set_claude_api_key,
                set_codex_api_key,
                set_gemini_api_key,
            )
            from .geminihome import gemini_cli_login_status, gemini_has_any_creds

            ctx.write_manifest(collect_doctor_report(root))
            if args.auth_cmd == "login":
                strict_supply_chain = _truthy_env("SW_STRICT_SUPPLYCHAIN")
                lock_images = _lock_images_best_effort(root)
                mode_requested = str(getattr(args, "mode", "auto"))
                auto_plan: dict[str, object] | None = None
                mode_selected = mode_requested
                if mode_requested == "auto":
                    auto_plan = _auto_provider_backend_plan(root)
                    mode_selected = str((auto_plan.get("selected_mode") or "")).strip() or "none"
                want_image = str(getattr(args, "image", DEFAULT_PROVIDERS_IMAGE))
                if mode_selected == "sandbox":
                    want_image = _maybe_default_image_from_lock(
                        image=want_image,
                        lock_images=lock_images,
                        lock_key="providers_sandbox_default",
                        builtin_default=DEFAULT_PROVIDERS_IMAGE,
                    )
                    if strict_supply_chain:
                        _enforce_strict_images(strict_supply_chain=True, image=want_image, kind="providers sandbox")
                try:
                    rc, meta = auth_login(
                        root,
                        provider=str(getattr(args, "provider")),
                        mode=mode_selected,
                        posture="safe",
                        open_mode=str(getattr(args, "open", "auto")),
                        open_policy=str(getattr(args, "open_policy", "allowlist")),
                        image=want_image,
                        network=str(getattr(args, "network", "host")),
                        kvm_instance=(str(getattr(args, "kvm_instance")) if getattr(args, "kvm_instance", None) else None),
                        dry_run=bool(getattr(args, "dry_run", False)),
                    )
                except AuthError as e:
                    ctx.event("auth", {"action": "login", "provider": getattr(args, "provider", None), "error": str(e)})
                    print(f"ERROR: {e}", file=sys.stderr)
                    ctx.finish_error(exit_code=2)
                    return 2

                ctx.event("auth", {"action": "login", "provider": getattr(args, "provider", None), **meta})
                if bool(getattr(args, "dry_run", False)):
                    argv = meta.get("argv")
                    if isinstance(argv, list):
                        print(" ".join(map(str, argv)))
                    else:
                        print(json.dumps(meta, indent=2, sort_keys=True))
                    ctx.finish_ok()
                    return 0

                if str(getattr(args, "provider", "")) == "gemini" and rc == 0 and not gemini_has_any_creds(root):
                    ctx.warn(
                        "gemini: no credentials detected yet. Recommended: rerun `sandworm auth login gemini` and choose 'Login with Google'. "
                        "Optional: set an API key via `printf '%s\\n' \"$GEMINI_API_KEY\" | sandworm auth set gemini --from-stdin`."
                    )

                if rc == 0:
                    ctx.finish_ok()
                else:
                    ctx.finish_error(exit_code=int(rc))
                return int(rc)

            if args.auth_cmd == "verify":
                from .clients import ClientsError, clients_install

                provider = str(getattr(args, "provider"))
                mode_requested = str(getattr(args, "mode", "auto"))
                auto_plan: dict[str, object] | None = None
                mode_selected = mode_requested
                if mode_requested == "auto":
                    auto_plan = _auto_provider_backend_plan(root)
                    mode_selected = str((auto_plan.get("selected_mode") or "")).strip() or "none"
                want_mode = mode_selected
                want_tag = str(getattr(args, "tag", "latest"))
                want_login = str(getattr(args, "login", "auto"))
                want_open = str(getattr(args, "open", "auto"))
                strict_supply_chain = _truthy_env("SW_STRICT_SUPPLYCHAIN")
                lock_images = _lock_images_best_effort(root)
                want_image = str(getattr(args, "image", DEFAULT_PROVIDERS_IMAGE))
                if want_mode == "sandbox":
                    want_image = _maybe_default_image_from_lock(
                        image=want_image,
                        lock_images=lock_images,
                        lock_key="providers_sandbox_default",
                        builtin_default=DEFAULT_PROVIDERS_IMAGE,
                    )
                    if strict_supply_chain:
                        _enforce_strict_images(strict_supply_chain=True, image=want_image, kind="providers sandbox")
                want_network = str(getattr(args, "network", "host"))
                timeout_s = int(getattr(args, "timeout_s", 60))

                bin_path = (control_dir(root) / "clients" / "bin" / provider).resolve()
                installed = bin_path.exists() and os.access(bin_path, os.X_OK)
                if not installed:
                    try:
                        if strict_supply_chain:
                            try:
                                clients_install(
                                    root,
                                    which=[provider],
                                    force=False,
                                    npm_tag=want_tag,
                                    node_attr="nixpkgs#nodejs_22",
                                    locked=True,
                                    update_lock=False,
                                )
                            except ClientsError:
                                clients_install(
                                    root,
                                    which=[provider],
                                    force=False,
                                    npm_tag=want_tag,
                                    node_attr="nixpkgs#nodejs_22",
                                    locked=False,
                                    update_lock=True,
                                )
                        else:
                            clients_install(
                                root,
                                which=[provider],
                                force=False,
                                npm_tag=want_tag,
                                node_attr="nixpkgs#nodejs_22",
                                locked=False,
                                update_lock=False,
                            )
                    except ClientsError as e:
                        msg = f"failed to install {provider} client: {e}"
                        ctx.event("auth", {"action": "verify", "provider": provider, "error": msg})
                        _emit_json_error(args, f"ERROR: {msg}")
                        ctx.finish_error(exit_code=2)
                        return 2
                    installed = True

                # Best-effort: keep the floating client reasonably fresh before we inspect login status.
                should_update, update_meta = _clients_autoupdate_decision(
                    root,
                    provider=provider,
                    installed=installed,
                    npm_tag=want_tag,
                    strict_supply_chain=strict_supply_chain,
                )
                if should_update:
                    try:
                        clients_install(
                            root,
                            which=[provider],
                            force=True,
                            npm_tag=want_tag,
                            node_attr="nixpkgs#nodejs_22",
                            locked=False,
                            update_lock=False,
                        )
                        ctx.event("clients", {"action": "autoupdate", **update_meta, "result": "ok"})
                    except ClientsError as e:
                        ctx.warn(f"best-effort {provider} client update failed (continuing with installed version): {e}")
                        ctx.event("clients", {"action": "autoupdate", **update_meta, "result": "error", "error": str(e)})

                # Decide whether to run login first.
                logged_in_before: bool | None = None
                login_status_raw: str | None = None
                need_login = False

                if want_login == "on":
                    need_login = True
                elif want_login == "off":
                    need_login = False
                else:
                    if provider == "codex":
                        if get_codex_api_key(root):
                            need_login = False
                        else:
                            try:
                                logged, raw = codex_login_status(root)
                                logged_in_before, login_status_raw = bool(logged), str(raw)
                                need_login = not bool(logged)
                            except AuthError:
                                need_login = True
                    elif provider == "claude":
                        if get_claude_api_key(root):
                            need_login = False
                        else:
                            st = claude_cli_login_status(root)
                            has_any = bool(st.get("has_oauth") or st.get("has_api_key"))
                            logged_in_before = has_any
                            need_login = not has_any
                    elif provider == "gemini":
                        need_login = not bool(gemini_has_any_creds(root))
                    else:
                        need_login = True

                # Run login/help flow if needed.
                login_rc: int | None = None
                login_meta: dict[str, object] | None = None
                if need_login:
                    try:
                        login_rc, login_meta = auth_login(
                            root,
                            provider=provider,
                            mode=want_mode,
                            posture="safe",
                            open_mode=want_open,
                            open_policy=str(getattr(args, "open_policy", "allowlist")),
                            image=want_image,
                            network=want_network,
                            kvm_instance=(str(getattr(args, "kvm_instance")) if getattr(args, "kvm_instance", None) else None),
                            dry_run=False,
                        )
                    except AuthError as e:
                        msg = str(e)
                        ctx.event("auth", {"action": "verify", "provider": provider, "error": msg})
                        _emit_json_error(args, f"ERROR: {msg}")
                        ctx.finish_error(exit_code=2)
                        return 2

                    if provider == "gemini" and login_rc == 0 and not gemini_has_any_creds(root):
                        ctx.warn(
                            "gemini: no credentials detected yet. Recommended: rerun `sandworm auth login gemini` and choose 'Login with Google'. "
                            "Optional: set an API key via `printf '%s\\n' \"$GEMINI_API_KEY\" | sandworm auth set gemini --from-stdin`."
                        )

                    if int(login_rc or 0) != 0:
                        out = {
                            "provider": provider,
                            "mode": want_mode,
                            "installed": bool(installed),
                            "login_ran": True,
                            "login_exit_code": int(login_rc),
                            "status": "fail",
                        }
                        ctx.event("auth", {"action": "verify", **out})
                        if bool(getattr(args, "json", False)):
                            print(json.dumps(out, indent=2, sort_keys=True))
                        else:
                            print(f"{provider}: login failed (exit_code={int(login_rc)})", file=sys.stderr)
                        ctx.finish_error(exit_code=int(login_rc))
                        return int(login_rc)

                # Execute a tiny, non-interactive API call and validate output contains an exact 'OK'.
                call_rc = -1
                stdout = ""
                stderr = ""
                argv: list[str]
                if provider == "codex":
                    argv = [
                        str(bin_path),
                        "-a",
                        "never",
                        "exec",
                        "--skip-git-repo-check",
                        "-s",
                        "read-only",
                        "Respond with exactly: OK",
                    ]
                elif provider == "claude":
                    argv = [str(bin_path), "--print", "--output-format", "json", "Respond with exactly: OK"]
                else:
                    argv = [str(bin_path), "--output-format", "json", "Respond with exactly: OK"]

                try:
                    from .creds import ensure_sandworm_home

                    home_dir = ensure_sandworm_home(root)
                    if want_mode == "host":
                        env = dict(os.environ)
                        env["SANDWORM_HOME"] = str(home_dir)
                        env["HOME"] = str(home_dir)
                        env.setdefault("XDG_CONFIG_HOME", str(home_dir / ".config"))
                        env.setdefault("XDG_DATA_HOME", str(home_dir / ".local" / "share"))
                        env.setdefault("XDG_CACHE_HOME", str(home_dir / ".cache"))
                        env["SANDWORM_CLIENTS_BIN"] = str((control_dir(root) / "clients" / "bin").resolve())
                        if provider == "codex":
                            try:
                                from .codexhome import ensure_codex_auth_imported, sandworm_codex_home

                                ensure_codex_auth_imported(root)
                                env["CODEX_HOME"] = str(sandworm_codex_home(root))
                            except Exception:
                                pass
                        inject_provider_creds_env(root, provider, env)
                        proc = subprocess.run(argv, cwd=str(root), env=env, text=True, capture_output=True, timeout=max(5, timeout_s))
                        call_rc = int(proc.returncode)
                        stdout = proc.stdout or ""
                        stderr = proc.stderr or ""
                    elif want_mode == "sandbox":
                        podman_env = ensure_storage(root)
                        mounts = [f"{home_dir}:/run/sandworm/home:rw"]
                        env2: dict[str, str] = {
                            "SANDWORM_HOME": "/run/sandworm/home",
                            "HOME": "/run/sandworm/home",
                            "XDG_CONFIG_HOME": "/run/sandworm/home/.config",
                            "XDG_DATA_HOME": "/run/sandworm/home/.local/share",
                            "XDG_CACHE_HOME": "/run/sandworm/home/.cache",
                            "SANDWORM_CLIENTS_USE_NODE": "1",
                        }
                        if provider == "codex":
                            env2["CODEX_HOME"] = "/run/sandworm/home/.codex"
                        inject_provider_creds_env(root, provider, env2)
                        argv2 = [f"/run/sandworm/clients/bin/{provider}", *argv[1:]]
                        proc2 = podman_run(
                            root,
                            argv2,
                            image=want_image,
                            podman_env=podman_env,
                            network=want_network,
                            workdir="/workspace",
                            timeout_s=max(5, timeout_s),
                            mounts=mounts,
                            env=env2,
                            user=f"{os.getuid()}:{os.getgid()}",
                            userns="keep-id",
                        )
                        call_rc = int(proc2.returncode)
                        stdout = proc2.stdout or ""
                        stderr = proc2.stderr or ""
                    elif want_mode == "bwrap":
                        from .bwrap_backend import run_bwrap

                        env2 = {
                            "SANDWORM_HOME": "/run/sandworm/home",
                            "HOME": "/run/sandworm/home",
                            "XDG_CONFIG_HOME": "/run/sandworm/home/.config",
                            "XDG_DATA_HOME": "/run/sandworm/home/.local/share",
                            "XDG_CACHE_HOME": "/run/sandworm/home/.cache",
                            "SANDWORM_CLIENTS_BIN": "/run/sandworm/clients/bin",
                            "SANDWORM_CLIENTS_USE_NODE": "1",
                        }
                        if provider == "codex":
                            env2["CODEX_HOME"] = "/run/sandworm/home/.codex"
                        if provider == "claude":
                            env2["CLAUDE_CONFIG_DIR"] = "/run/sandworm/home/.claude"
                        inject_provider_creds_env(root, provider, env2)
                        argv2 = [f"/run/sandworm/clients/bin/{provider}", *argv[1:]]
                        proc2 = run_bwrap(
                            root,
                            argv2,
                            workdir="/workspace",
                            offline=bool(want_network == "none"),
                            timeout_s=max(5, timeout_s),
                            env=env2,
                            posture="safe",
                        )
                        call_rc = int(proc2.returncode)
                        stdout = proc2.stdout or ""
                        stderr = proc2.stderr or ""
                    elif want_mode == "kvm":
                        from .kvm import kvm_exec_in_dir, kvm_status, kvm_up

                        img = control_dir(root) / "kvm" / "guest.qcow2"
                        if not img.exists():
                            raise RuntimeError("kvm guest image missing (run `sandworm kvm init --fetch` or `sandworm kvm init --build`)")
                        instance = getattr(args, "kvm_instance", None)
                        st0 = kvm_status(root, instance=instance)
                        if not st0.running:
                            _ = kvm_up(
                                root,
                                instance=instance,
                                build_image=False,
                                timeout_s=240,
                                expose_private=False,
                                shares=None,
                                reconfigure=True,
                            )

                        env2 = {
                            "SANDWORM_HOME": "/run/sandworm/home",
                            "HOME": "/run/sandworm/home",
                            "XDG_CONFIG_HOME": "/run/sandworm/home/.config",
                            "XDG_DATA_HOME": "/run/sandworm/home/.local/share",
                            "XDG_CACHE_HOME": "/run/sandworm/home/.cache",
                            "SANDWORM_CLIENTS_BIN": "/run/sandworm/clients/bin",
                            "SANDWORM_CLIENTS_USE_NODE": "1",
                        }
                        if provider == "codex":
                            env2["CODEX_HOME"] = "/run/sandworm/home/.codex"
                        if provider == "claude":
                            env2["CLAUDE_CONFIG_DIR"] = "/run/sandworm/home/.claude"
                        inject_provider_creds_env(root, provider, env2)
                        argv2 = [f"/run/sandworm/clients/bin/{provider}", *argv[1:]]
                        proc2 = kvm_exec_in_dir(
                            root,
                            argv2,
                            instance=instance,
                            workdir="/workspace",
                            timeout_s=max(5, timeout_s),
                            env=env2,
                        )
                        call_rc = int(proc2.returncode)
                        stdout = proc2.stdout or ""
                        stderr = proc2.stderr or ""
                except Exception as e:
                    call_rc = 2
                    stderr = f"{stderr}\nerror: {e!r}".strip() + "\n"

                def _last_nonempty_line(s: str) -> str:
                    for line in reversed((s or "").splitlines()):
                        t = line.strip()
                        if t:
                            return t
                    return ""

                combined = (stdout or "") + ("\n" if stdout and stderr else "") + (stderr or "")
                combined_redacted = redact_known_secrets(root, combined)
                ok_line = _last_nonempty_line(combined_redacted)

                def _json_has_ok(v: object) -> bool:
                    if isinstance(v, str):
                        return v.strip() == "OK"
                    if isinstance(v, list):
                        return any(_json_has_ok(x) for x in v)
                    if isinstance(v, dict):
                        return any(_json_has_ok(x) for x in v.values())
                    return False

                def _contains_ok(text: str) -> bool:
                    for line in (text or "").splitlines():
                        if line.strip() == "OK":
                            return True
                    return False

                ok = False
                if int(call_rc) == 0:
                    if _contains_ok(combined_redacted):
                        ok = True
                    else:
                        # Best-effort for CLIs with --output-format json (claude/gemini).
                        try:
                            j = json.loads((stdout or "").strip())
                            ok = _json_has_ok(j)
                        except Exception:
                            ok = False
                status = "ok" if ok else "fail"
                out = {
                    "provider": provider,
                    "mode": want_mode,
                    "installed": bool(installed),
                    "login_ran": bool(need_login),
                    "login_exit_code": (int(login_rc) if login_rc is not None else None),
                    "login_meta": login_meta,
                    "logged_in_before": logged_in_before,
                    "login_status_raw": login_status_raw,
                    "call_exit_code": int(call_rc),
                    "call_ok": bool(ok),
                    "call_last_line": ok_line,
                    "status": status,
                }

                # Optional: write a proof bundle so real provider auth can be audited/replayed without greps.
                proof_out = getattr(args, "proof_out", None)
                if isinstance(proof_out, str) and proof_out.strip():
                    try:
                        proof_base = Path(proof_out)
                        if not proof_base.is_absolute():
                            proof_base = root / proof_base
                        proof_base = proof_base.resolve()

                        combined_path = ctx.write_file("steps/auth-verify/logs/combined.redacted.txt", combined_redacted)

                        from .proofbundle import write_proof_bundle

                        suite = str(getattr(args, "suite", "") or "").strip()
                        if not suite:
                            suite = f"auth-verify-{provider}-{want_mode}"

                        suite_dir = write_proof_bundle(
                            root=root,
                            suite=suite,
                            out_dir=proof_base,
                            run_dir=ctx.run_dir,
                            command=f"auth verify {provider} --mode {want_mode}",
                            ok=bool(ok),
                            files={"combined_redacted": str(combined_path)},
                        )
                        out["proof_dir"] = str(suite_dir)
                    except Exception as e:
                        out["proof_error"] = str(e)

                ctx.event("auth", {"action": "verify", **out})
                if bool(getattr(args, "json", False)):
                    print(json.dumps(out, indent=2, sort_keys=True))
                else:
                    if ok:
                        print(f"{provider}: OK ({want_mode})")
                    else:
                        print(f"{provider}: FAIL ({want_mode}) exit_code={int(call_rc)} last_line={ok_line!r}", file=sys.stderr)
                        # Keep failure output short but useful.
                        tail = "\n".join(combined_redacted.splitlines()[-25:])
                        if tail.strip():
                            print(tail, file=sys.stderr)
                if ok:
                    ctx.finish_ok()
                    return 0
                ctx.finish_error(exit_code=int(call_rc or 2))
                return int(call_rc or 2)

            if args.auth_cmd == "set":
                provider = str(getattr(args, "provider"))
                raw_value = getattr(args, "value", None)
                from_stdin = bool(getattr(args, "from_stdin", False))

                secret = ""
                if isinstance(raw_value, str) and raw_value.strip():
                    secret = raw_value.strip()
                elif from_stdin:
                    secret = (sys.stdin.read() or "").strip()
                else:
                    # Interactive prompt (best-effort, hidden input).
                    import getpass

                    secret = (getpass.getpass(f"Paste {provider} credential: ") or "").strip()

                try:
                    if provider == "gemini":
                        doc = set_gemini_api_key(root, secret)
                        sha = gemini_api_key_sha256(root)
                        kind = "api_key"
                    elif provider == "codex":
                        doc = set_codex_api_key(root, secret)
                        sha = codex_api_key_sha256(root)
                        kind = "api_key"
                    elif provider == "claude":
                        # Claude Code supports both API key auth and a long-lived OAuth token.
                        # The upstream `claude setup-token` prints a token that starts with "sk-ant-oat".
                        from .creds import claude_oauth_token_sha256, set_claude_oauth_token

                        if secret.startswith("sk-ant-oat"):
                            doc = set_claude_oauth_token(root, secret)
                            sha = claude_oauth_token_sha256(root)
                            kind = "oauth_token"
                        else:
                            doc = set_claude_api_key(root, secret)
                            sha = claude_api_key_sha256(root)
                            kind = "api_key"
                    else:
                        raise SystemExit(f"Unknown auth provider: {provider}")
                except CredsError as e:
                    ctx.event("auth", {"action": "set", "provider": provider, "error": str(e)})
                    print(f"ERROR: {e}", file=sys.stderr)
                    ctx.finish_error(exit_code=2)
                    return 2

                meta = {
                    "provider": provider,
                    "path": str(creds_path(root)),
                    "kind": kind,
                    "sha256": sha,
                    "updated_at": doc.get("updated_at") if isinstance(doc, dict) else None,
                }
                ctx.event("auth", {"action": "set", **meta})
                if bool(getattr(args, "json", False)):
                    print(json.dumps(meta, indent=2, sort_keys=True))
                else:
                    print(f"{provider}: credential stored in {meta['path']} (sha256={sha})")
                ctx.finish_ok()
                return 0

            if args.auth_cmd == "status":
                codex_sha = codex_api_key_sha256(root)
                gemini_sha = gemini_api_key_sha256(root)
                claude_sha = claude_api_key_sha256(root)
                from .creds import claude_oauth_token_sha256, ensure_sandworm_home

                claude_oauth_sha = claude_oauth_token_sha256(root)
                claude_cli = claude_cli_login_status(root)
                gemini_cli = gemini_cli_login_status(root)
                codex_cli: dict[str, object] = {"logged_in": None, "raw": None, "error": None, "method": "file"}
                try:
                    logged_in, raw = codex_login_status(root)
                    codex_cli["logged_in"] = bool(logged_in)
                    codex_cli["raw"] = raw
                except Exception as e:
                    codex_cli["error"] = str(e)

                sw_home_host = ensure_sandworm_home(root)
                codex_home_auth: dict[str, object] = {
                    "path": str((sw_home_host / ".codex" / "auth.json").resolve()),
                    "present": False,
                    "looks_like_placeholder": None,
                }
                try:
                    p = Path(str(codex_home_auth["path"]))
                    codex_home_auth["present"] = bool(p.exists())
                    if p.exists():
                        data = json.loads(p.read_text(encoding="utf-8"))
                        if isinstance(data, dict):
                            v = data.get("OPENAI_API_KEY")
                            if isinstance(v, str) and v:
                                codex_home_auth["looks_like_placeholder"] = bool(v.startswith("sw-test-"))
                except Exception:
                    pass

                out = {
                    "path": str(creds_path(root)),
                    "sandworm_home_host": str(sw_home_host),
