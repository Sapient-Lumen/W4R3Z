    """
    Normalize common OCI image references for caching/matching purposes.

    This does not change the actual image string passed to Podman; it is only used to:
    - share cache keys across equivalent refs (e.g. `busybox:1.36.1` vs `docker.io/library/busybox:1.36.1`)
    - make allowlist matching robust to short-form references.
    """
    r = (ref or "").strip()
    if not r:
        return r
    if "/" not in r:
        return f"docker.io/library/{r}"
    first = r.split("/", 1)[0]
    if "." in first or ":" in first or first == "localhost":
        return r
    return f"docker.io/{r}"

def _matches_any(image: str, patterns: list[str]) -> bool:
    for pat in patterns:
        if fnmatch.fnmatch(image, pat):
            return True
    return False

def _should_cache_image(image: str) -> bool:
    if os.environ.get("SW_OCI_CACHE", "1") == "0":
        return False
    raw = (image or "").strip()
    img = _normalize_oci_ref(raw)
    allow = _split_patterns(
        os.environ.get(
            "SW_OCI_CACHE_ALLOWLIST",
            "docker.io/library/busybox* docker.io/library/debian* docker.io/library/node*",
        )
    )
    return _matches_any(raw, allow) or _matches_any(img, allow)

def _should_refresh_image(image: str) -> bool:
    if os.environ.get("SW_OCI_REFRESH", "0") == "1":
        return True
    raw = (image or "").strip()
    img = _normalize_oci_ref(raw)
    allow = _split_patterns(
        os.environ.get(
            "SW_OCI_REFRESH_ALLOWLIST",
            "docker.io/library/busybox* docker.io/library/debian* docker.io/library/node*",
        )
    )
    return _matches_any(raw, allow) or _matches_any(img, allow)

def _oci_cache_dir(root: Path) -> Path:
    override = os.environ.get("SW_OCI_CACHE_DIR") or os.environ.get("SANDWORM_OCI_CACHE_DIR")
    if override:
        try:
            return Path(override).expanduser()
        except Exception:
            pass
    # Prefer SANDWORM_HOME when available (e.g., inside bwrap/KVM guest) so cache persists even when
    # /workspace/.sandworm is masked.
    sw_home = os.environ.get("SANDWORM_HOME")
    if sw_home:
        try:
            return (Path(sw_home).expanduser() / ".sandworm" / "cache" / "oci")
        except Exception:
            pass
    return control_dir(root) / "cache" / "oci"

def _oci_cache_paths(root: Path, image: str) -> tuple[Path, Path]:
    key_img = _normalize_oci_ref(image or "")
    key = hashlib.sha256(key_img.encode("utf-8")).hexdigest()
    base = _oci_cache_dir(root)
    return base / f"{key}.tar", base / f"{key}.stamp"

