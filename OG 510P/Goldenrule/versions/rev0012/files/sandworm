set -eu

SCRIPT="$0"
case "$SCRIPT" in
  */*) SCRIPT_DIR="${SCRIPT%/*}" ;;
  *) SCRIPT_DIR="." ;;
esac
SCRIPT_DIR="$(cd "$SCRIPT_DIR" && pwd -P)"

NP_BIN="$SCRIPT_DIR/nix-portable"
if [ ! -x "$NP_BIN" ]; then
  echo "nix-shell: nix-portable missing at $NP_BIN (run: sandworm refresh --force)" >&2
  exit 2
fi

if [ -z "${NP_LOCATION:-}" ]; then
  if [ -n "${SANDWORM_BACKEND:-}" ]; then
    if [ -n "${SANDWORM_HOME:-}" ]; then
      NP_LOCATION="${SANDWORM_HOME}/.nix-portable"
    elif [ -n "${HOME:-}" ]; then
      NP_LOCATION="${HOME}/.nix-portable"
    else
      NP_LOCATION="/tmp/.nix-portable"
    fi
  else
    NP_LOCATION="$(cd "$SCRIPT_DIR/../.." && pwd -P)/nix-portable"
  fi
fi
export NP_LOCATION

if [ -z "${NP_RUNTIME:-}" ] && [ "${SANDWORM_BACKEND:-}" = "podman" ]; then
  if [ "${SW_NIX_PORTABLE_DISABLE_PROOT:-0}" != "1" ] && [ "${SANDWORM_NIX_PORTABLE_DISABLE_PROOT:-0}" != "1" ]; then
    export NP_RUNTIME=proot
    if [ -z "${PROOT_NO_SECCOMP:-}" ]; then
      export PROOT_NO_SECCOMP=1
    fi
  fi
fi

exec "$NP_BIN" nix-shell "$@"
NIX_SHELL_WRAPPER
  chmod +x "$nix_shell_bin" 2>/dev/null || true
}

_sw_toolroot_nix_wrapper_needs_rewrite() {
  local nix_bin="$1"
  local shebang interp
  if [[ ! -f "$nix_bin" ]]; then
    return 0
  fi
  shebang="$(head -n 1 "$nix_bin" 2>/dev/null || true)"
  # Cross-posture portability: toolroot wrappers are bind-mounted into sandboxes. Enforce a
  # /bin/sh entrypoint so the wrapper does not depend on host-specific paths like
  # /run/current-system/sw/bin/bash.
  if [[ "$shebang" != "#!/bin/sh" ]]; then
    return 0
  fi
  # Legacy wrappers used env+bash and can fail in restricted runtimes that hide /usr.
  if [[ "$shebang" == "#!/usr/bin/env bash" ]]; then
    return 0
  fi
  if [[ "$shebang" != '#!'* ]]; then
    return 0
  fi
  interp="${shebang#\#!}"
  interp="${interp%%[[:space:]]*}"
  if [[ -z "$interp" || ! -x "$interp" ]]; then
    return 0
  fi
  return 1
}

_sw_write_toolroot_dirname_shim() {
  local dirname_bin="$1"
  cat >"$dirname_bin" <<'DIRNAME_SHIM'
#!/bin/sh
set -eu

if [ "${1:-}" = "--" ]; then
  shift || true
fi
p="${1:-.}"
while [ "$p" != "/" ] && [ "${p%/}" != "$p" ]; do
  p="${p%/}"
done
if [ "$p" = "/" ]; then
  echo "/"
  exit 0
fi
case "$p" in
  */*) echo "${p%/*}" ;;
  *) echo "." ;;
esac
DIRNAME_SHIM
  chmod +x "$dirname_bin" 2>/dev/null || true
}

_sw_stage0_ensure_nix_portable() {
